      464   DEFINE QUERY br-shift FOR
      465         X_shift-obj SCROLLING.
      466   DEFINE BROWSE br-shift
      467     QUERY br-shift DISPLAY
      468         mark-string(recid(X_shift-obj)) column-label "*" format "X(1)":U
      469         X_shift-obj.obj-type + " " + string (X_shift-obj.obj-code, ">>>>9") COLUMN-LABEL "Объект" FORMAT "x(9)":U
      470         X_shift-obj.shift-date COLUMN-LABEL "Дата смены" FORMAT "99/99/9999":U
      471         X_shift-obj.shift-name COLUMN-LABEL "№" FORMAT "X(2)":U WIDTH 3
      472         X_shift-obj.shift-num COLUMN-LABEL "Пр" FORMAT ">9":U
      473         X_shift-obj.status_ COLUMN-LABEL "Статус" FORMAT "X(3)":U
      474         X_shift-obj.open-date COLUMN-LABEL "Открыта" FORMAT "99/99/9999":U
      475         STRING (X_shift-obj.open-time, "HH:MM") COLUMN-LABEL "Время" FORMAT "x(5)":U
      476         usrfulnf(X_shift-obj.open-id) COLUMN-LABEL "Открыл" FORMAT "X(14)":U
      477         X_shift-obj.close-date COLUMN-LABEL "Закрыта" FORMAT "99/99/9999":U
      478         string (X_shift-obj.close-time, "HH:MM") COLUMN-LABEL "Время" FORMAT "x(5)":U
      479         usrfulnf(X_shift-obj.close-id) COLUMN-LABEL "Закрыл" FORMAT "X(14)":U
      480       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 19.08.
      481   DEFINE FRAME d-shifts
      482        b-quit AT ROW 1 COL 1
      483        B-sel AT ROW 1 COL 11
      484        b-add AT ROW 1 COL 21
      485        b-chg AT ROW 1 COL 31
      486        b-del AT ROW 1 COL 41
      487        B-staff AT ROW 1 COL 51
      488        B-rep AT ROW 1 COL 61
      489        B-param AT ROW 1 COL 71 WIDGET-ID 2
      490        B-hist AT ROW 1 COL 92
      491        b-help AT ROW 1 COL 95
      492        b-mark AT ROW 2 COL 1
      493        br-shift AT ROW 3 COL 1
      494        SPACE(0.00) SKIP(0.04)
      495       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      496            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      497            TITLE "Смены на объекте"
      498            DEFAULT-BUTTON b-quit.
      499   ASSIGN
      500          FRAME d-shifts:SCROLLABLE       = FALSE
      501          FRAME d-shifts:HIDDEN           = TRUE.
      502   ASSIGN
      503          B-rep:POPUP-MENU IN FRAME d-shifts       = MENU MENU-B-rep:HANDLE.
      504   ON WINDOW-CLOSE OF FRAME d-shifts
      505   DO:
      506     APPLY "END-ERROR":U TO SELF.
      507   END.
      508   ON CHOOSE OF b-add IN FRAME d-shifts
      509   DO:
      510   RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
      511   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      512   END.
      513   ON CHOOSE OF b-chg IN FRAME d-shifts
      514   DO:
      515       if not available X_shift-obj
      516       then do:
      517         message
      518           "Не выбрана смена."
      519           view-as alert-box error.
      520         return no-apply.
      521       end.
      522       if X_shift-obj.status_ <> 'ожд':U
      523         and X_shift-obj.status_ <> 'зкр':U
      524         then do:
      525             message "Можно редактировать только ожидаемую или закрытую смену"
      526             view-as alert-box.
      527             return no-apply.
      528         end.
      529       assign
      530         v-doc-rec = recid(X_shift-obj)
      531       .
      532       if X_shift-obj.status_ = 'ожд':U then do:
      533       run change-planned-shift in this-procedure
      534         ( input X_shift-obj.shift-date
      535          ,input X_shift-obj.shift-num
      536          ,input X_shift-obj.shift-name
      537          ,INPUT v-doc-rec
      538         ) no-error .
      539       if error-status :error then do:
      540         message
      541           vss-workfile vss-revision vss-description
      542           skip "Ошибка изменения запланированной смены."
      543           skip return-value
      544           skip trim(error-status :get-message(1))
      545               trim(error-status :get-message(2))
      546               trim(error-status :get-message(3))
      547               trim(error-status :get-message(4))
      548               trim(error-status :get-message(5))
      549           view-as alert-box error.
      550         undo, return no-apply .
      551       end.
      552       END.
      553       else do:
      554           run change-close-shift-time(input v-doc-rec) no-error.
      555           if error-status:error then do:
      556             message
      557               vss-workfile vss-revision vss-description
      558               skip "Ошибка изменения запланированной смены."
      559               skip return-value
      560               skip trim(error-status :get-message(1))
      561                   trim(error-status :get-message(2))
      562                   trim(error-status :get-message(3))
      563                   trim(error-status :get-message(4))
      564                   trim(error-status :get-message(5))
      565               view-as alert-box error.
      566             undo, return no-apply .
      567           end.
      568       end.
      569   END.
      570   ON CHOOSE OF b-del IN FRAME d-shifts
      571   DO:
      572   if not available X_shift-obj or
      573      X_shift-obj.status_ <> 'ожд':U then do:
      574     message
      575       "Можно удалить только ожидаемую смену."
      576       view-as alert-box error.
      577     return no-apply.
      578   end.
      579   run gbl/shtwaidl.p ( INPUT NO
      580                       ,INPUT recid(X_shift-obj)
      581                      ) NO-ERROR.
      582   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      583   v-doc-rec = ?.
      584   run UI-on IN THIS-PROCEDURE NO-ERROR.
      585   END.
      586   ON CHOOSE OF B-hist IN FRAME d-shifts
      587   DO:
      588     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      589     IF NOT AVAILABLE X_shift-obj THEN RETURN NO-APPLY.
      590       run ref/cshthist.w (
      591                     INPUT parParentProc
      592                    ,input p-curr-obj-type
      593                    ,input p-curr-obj-code
      594                    ,input '':U
      595                    ,input 'one':U
      596                    ,INPUT X_shift-obj.obj-type
      597                    ,INPUT X_shift-obj.obj-code
      598                    ,INPUT X_shift-obj.shift-date
      599                    ,INPUT X_shift-obj.shift-num
      600                    ,INPUT '':U
      601                    ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      602   END.
      603   ON CHOOSE OF b-mark IN FRAME d-shifts
      604   DO:
      605       define variable varlog as logical no-undo .
      606       run local-mark in this-procedure .
      607       assign
      608           varlog = br-shift:select-next-row ()
      609           .
      610       apply "entry" to br-shift in frame d-shifts.
      611   END.
      612   ON CHOOSE OF B-param IN FRAME d-shifts
      613   DO:
      614    run str/shift-params.w(
      615    input X_shift-obj.obj-type,
      616    input X_shift-obj.obj-code,
      617    input X_shift-obj.shift-date,
      618    input X_shift-obj.shift-num,
      619    input X_shift-obj.shift-name)  .
      620   END.
      621   ON CHOOSE OF B-rep IN FRAME d-shifts
      622   DO:
      623    if rep-name = "" then do:
      624       run gbl/pop-up.p (self:handle, no) no-error.
      625       if error-status:error then return no-apply.
      626     end.
      627    if rep-name = "" then return no-apply.
      628    run proc-b-rep(input-output rep-name) no-error.
      629    if error-status:error then return no-apply.
      630   END.
      631   ON CHOOSE OF B-sel IN FRAME d-shifts
      632   DO:
      633       if ( available X_shift-obj AND p-rid-list = "" ) then
      634           p-rid-list = string( recid( X_shift-obj) ) .
      635   END.
      636   ON CHOOSE OF B-staff IN FRAME d-shifts
      637   DO:
      638     def buffer buf_shift-obj for ub.shift-obj.
      639     if avail X_shift-obj then do:
      640       find first buf_shift-obj where
      641                  recid(buf_shift-obj) = recid(X_shift-obj) no-error.
      642       if buf_shift-obj.status_ = 'ожд':U then do:
      643           run ref/shftpers.w (
      644                           input parparentproc
      645                          ,input buf_shift-obj.obj-type
      646                          ,input buf_shift-obj.obj-code
      647                          ,input buf_shift-obj.shift-date
      648                          ,input buf_shift-obj.shift-num
      649                          ,input (if v-curr-db-num = obj-db-num
      650                                  and lookup("b-add", bttns) > 0
      651                                  then "b-add,b-add-next":U else "")
      652                          ,input 'смена-объект-откр':U) no-error.
      653       end.
      654       else if buf_shift-obj.status_ <> 'зкр':U then do:
      655         if sht-mode = "obj" and
      656         is-super then
      657           run ref/shftpers.w (
      658                           input parparentproc
      659                          ,input buf_shift-obj.obj-type
      660                          ,input buf_shift-obj.obj-code
      661                          ,input buf_shift-obj.shift-date
      662                          ,input buf_shift-obj.shift-num
      663                          ,input (if v-curr-db-num = obj-db-num
      664                                  and lookup("b-add", bttns) > 0
      665                                  then  "b-add,b-add-next":U else "")
      666                          ,input "") no-error.
      667         else
      668           run ref/shftpers.w (
      669                           input parparentproc
      670                          ,input buf_shift-obj.obj-type
      671                          ,input buf_shift-obj.obj-code
      672                          ,input buf_shift-obj.shift-date
      673                          ,input buf_shift-obj.shift-num
      674                          ,input ""
      675                          ,input "") no-error.
      676       end.
      677       else do:
      678           if sht-mode = "obj" and
      679           is-super then
      680           run ref/shftpers.w (
      681                           input parparentproc
      682                          ,input buf_shift-obj.obj-type
      683                          ,input buf_shift-obj.obj-code
      684                          ,input buf_shift-obj.shift-date
      685                          ,input buf_shift-obj.shift-num
      686                          ,input (if v-curr-db-num = obj-db-num
      687                                 and lookup("b-add", bttns) > 0
      688                                 then "b-add-next" else "")
      689                          ,input "") no-error.
      690           else
      691           run ref/shftpers.w (
      692                           input parparentproc
      693                          ,input buf_shift-obj.obj-type
      694                          ,input buf_shift-obj.obj-code
      695                          ,input buf_shift-obj.shift-date
      696                          ,input buf_shift-obj.shift-num
      697                          ,input ""
      698                          ,input "") no-error.
      699       end.
      700     end.
      701   END.
      702   ON MOUSE-SELECT-DBLCLICK OF br-shift IN FRAME d-shifts
      703   DO:
      704     IF      b-sel :SENSITIVE IN FRAME d-shifts THEN DO:
      705       APPLY "CHOOSE":U to b-sel IN FRAME d-shifts.
      706     END.
      707     ELSE IF b-chg :SENSITIVE IN FRAME d-shifts THEN DO:
      708        APPLY "CHOOSE":U to b-chg IN FRAME d-shifts.
      709     END.
      710     ELSE IF b-rep :SENSITIVE IN FRAME d-shifts THEN DO:
      711       APPLY "CHOOSE":U to b-rep IN FRAME d-shifts.
      712     END.
      713     ELSE DO:
      714       RETURN NO-APPLY.
      715     END.
      716   END.
      717   ON CHOOSE OF MENU-ITEM mi-petrol
      718   DO:
      719     rep-name = "g-shift":U.
      720     run proc-b-rep in this-procedure ( input-output rep-name) no-error.
      721     if error-status:error then return no-apply.
      722   END.
      723   ON CHOOSE OF MENU-ITEM mi-closeShift
      724   DO:
      725     rep-name = "g-shiftClose":U.
      726     run proc-b-rep in this-procedure ( input-output rep-name) no-error.
      727     if error-status:error then return no-apply.
      728   END.
      729   ON CHOOSE OF MENU-ITEM mi-ptrlch
      730   DO:
      731     rep-name = "g-ptrlch":U.
      732     run proc-b-rep in this-procedure ( input-output rep-name) no-error.
      733     if error-status:error then return no-apply.
      734   END.
      735   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-shifts:PARENT eq ?
      736   THEN FRAME d-shifts:PARENT = ACTIVE-WINDOW.
      737   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      738   on f5 of frame d-shifts anywhere
      739   do:
      740      if available X_shift-obj then v-doc-rec = recid(X_shift-obj).  RUn OpenBr in this-procedure.  REPOSITION br-shift to recid v-doc-rec No-ERROR.
      741       apply "VALUE-CHANGED" to br-shift.
      742   end.
      743   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      744   do:
      745     br-shift :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
      746   end.
      747   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      748   on help of frame d-shifts
      749   do:
      750     run gbl/app_help.p
      751       (input this-procedure :file-name
      752       ,input ''
      753       ,input ?
      754       ) no-error.
      755     if error-status :error then do:
      756       message
      757         "Ошибка при вызове помощи"
      758         error-status :get-message(1)
      759         view-as alert-box .
      760     end.
      761   end.
      762   run minbtn-set in this-procedure .
      763   on choose of b-help in frame d-shifts
      764   do:
      765     apply "help":u to frame d-shifts .
      766   end.
      767   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      768   procedure minbtn-set :
      769       do
      770           on error undo, return error return-value
      771           :
      772           define variable ii              as integer       no-undo .
      773           define variable fh              as widget-handle no-undo .
      774           define variable hh              as widget-handle no-undo .
      775           define variable v-h             as handle        extent 4 no-undo .
      776           define variable v-name-button   as character     no-undo .
      777           define variable v-help-old-x    as decimal       no-undo .
      778           define variable v-help-old-y    as decimal       no-undo .
      779           define variable v-help-old-size as decimal       no-undo .
      780           define variable v-frame-width   as decimal       no-undo .
      781           define variable jj              as integer       no-undo .
      782           do
      783               on error undo, return error
      784               :
      785               assign
      786                   v-frame-width = frame d-shifts:width - 0.3
      787                   fh            = frame d-shifts:first-child
      788                   hh            = fh:first-child
      789                   ii            = 1
      790                   .
      791               do while valid-handle(hh):
      792                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      793                   do:
      794                       case lc(hh:name) :
      795                           when "b-help" then
      796                               do:
      797                                   hh:load-image-up("cmp/b-help.bmp":u) .
      798                                   hh:load-image-down("cmp/b-help.bmp":u) .
      799                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      800                                   hh:TOOLTIP = "Помощь" .
      801                                   v-help-old-x = hh:column .
      802                                   v-help-old-y = hh:row    .
      803                                   v-help-old-size = hh:width .
      804                                   hh:width-chars = 2.5 .
      805                               end.
      806                           when "b-print" then
      807                               do:
      808                                   hh:load-image("cmp/b-print.bmp":u) .
      809                                   hh:TOOLTIP = "Печать" .
      810                                   v-h[ii] = hh:handle .
      811                                   ii = ii + 1 .
      812                                   hh:width-chars = 3 .
      813                               end.
      814                           when "b-history" or
      815                           when "b-hist" then
      816                               do:
      817                                   hh:load-image("cmp/b-hist.bmp":u) .
      818                                   hh:TOOLTIP = "История" .
      819                                   v-h[ii] = hh:handle .
      820                                   ii = ii + 1 .
      821                                   hh:width-chars = 3 .
      822                               end.
      823                           when "b-sch" then
      824                               do:
      825                                   hh:load-image("cmp/b-sch.bmp":u) .
      826                                   hh:TOOLTIP = "Установка Фильтра" .
      827                                   v-h[ii] = hh:handle .
      828                                   ii = ii + 1 .
      829                                   hh:width-chars = 3 .
      830                               end.
      831                           when "b-hist-user" then
      832                               do:
      833                                   hh:load-image("cmp/b-hist.bmp":u) .
      834                                   hh:TOOLTIP = "История пользователя" .
      835                                   ii = ii + 1 .
      836                               end.
      837                       end case.
      838                   end.
      839                   hh = hh:next-sibling.
      840               end.
      841               b-help:column = v-frame-width - b-help:width-chars.
      842               jj = 0.
      843               repeat ii = 4 to 1 by -1 :
      844                   if valid-handle (v-h[ii] ) then
      845                   do:
      846                       jj  = jj + 1 .
      847                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      848                       v-h[ii]:row    = v-help-old-y .
      849                   end.
      850               end.
      851           end.
      852       end.
      853   end procedure.
      854   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      855   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      856   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      857   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      858   define variable v-diasize-current-frame-width  as decimal   no-undo .
      859   define variable v-diasize-current-frame-height as decimal   no-undo .
      860   define variable v-diasize-change-size          as logical   no-undo .
      861   define variable v-diasize-resize-button        as handle    no-undo .
      862   define variable v-diasize-wndmax               as logical   no-undo .
      863   define variable v-diasize-wndstore             as logical   no-undo .
      864   define variable v-diasize-proc-name            as character no-undo .
      865   define variable v-diasize-browse-handle        as handle    no-undo .
      866   define variable v-diasize-browse-number        as integer   no-undo .
      867   define variable v-diasize-need-full-display    as logical   no-undo init false .
      868   define temp-table temp-diasize-handle no-undo
      869     field handle-value  as handle
      870     field save-position as decimal
      871     index xpk is primary unique handle-value
      872     .
      873   define temp-table temp-browse-handle no-undo
      874     field browse-type   as character
      875     field browse-number as integer
      876     field browse-handle as handle
      877     field original-size as decimal
      878     index xpk is primary unique browse-type browse-number
      879     index xie browse-type browse-handle
      880   .
      881   procedure diasize_change-height :
      882     define input  parameter p-change-value  as decimal   no-undo .
      883     define input  parameter p-move-resize   as logical   no-undo .
      884     define variable v-field-group-handle    as handle    no-undo .
      885     define variable v-object-handle         as handle    no-undo .
      886     define variable v-frame-height          as decimal   no-undo .
      887     define variable v-frame-virtual-height  as decimal   no-undo .
      888     define variable v-browse-height         as decimal   no-undo .
      889     define variable v-window-height         as decimal   no-undo .
      890     define variable v-window-virtual-height as decimal   no-undo .
      891     define variable v-change-sign           as integer   no-undo .
      892     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      893     define buffer buf_temp-browse-handle  for temp-browse-handle .
      894     if p-change-value > 0
      895     then do:
      896       if frame d-shifts :height + p-change-value
      897           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      898       then do:
      899         assign
      900           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      901                           - (frame d-shifts :height-chars)
      902         .
      903         if p-change-value <= 0
      904         then do:
      905           run diasize_position-resize-button in this-procedure .
      906           return .
      907         end.
      908       end.
      909     end.
      910     if p-change-value < 0
      911     then do:
      912       if frame d-shifts :height + p-change-value < v-diasize-orig-frame-height
      913       then do:
      914         assign
      915           p-change-value = v-diasize-orig-frame-height
      916                          - (frame d-shifts :height-chars)
      917         .
      918         if p-change-value >= 0
      919         then do:
      920           run diasize_position-resize-button in this-procedure .
      921           return .
      922         end.
      923       end.
      924     end.
      925     if p-change-value >= 0
      926     then do:
      927       assign
      928         v-change-sign = 1
      929       .
      930     end.
      931     else do:
      932       assign
      933         v-change-sign = -1
      934       .
      935     end.
      936     assign
      937       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      938     .
      939     if p-change-value = 0
      940     then do:
      941       run diasize_position-resize-button in this-procedure .
      942       return .
      943     end.
      944     move_block:
      945     do
      946     on error undo move_block, retry move_block
      947     :
      948       if retry
      949       then do:
      950         do
      951         on error undo move_block, leave move_block
      952         :
      953           if p-change-value > 0
      954           then do:
      955             for each buf_temp-diasize-handle
      956             on error undo, next
      957             :
      958               assign
      959                 v-object-handle = buf_temp-diasize-handle.handle-value
      960               .
      961               if v-object-handle <> v-diasize-resize-button
      962               then do:
      963                 assign
      964                   v-object-handle :row = buf_temp-diasize-handle.save-position
      965                 .
      966               end.
      967             end.
      968             assign
      969               v-diasize-browse-handle :height = v-browse-height
      970             .
      971             for each buf_temp-browse-handle
      972               where buf_temp-browse-handle.browse-type = 'height':u
      973             on error undo, next
      974             :
      975               assign
      976                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      977               .
      978             end.
      979             assign
      980               frame d-shifts :height = v-frame-height
      981             .
      982             if frame d-shifts :scrollable = true
      983             then do:
      984               assign
      985                 frame d-shifts :virtual-height = v-frame-virtual-height
      986               .
      987             end.
      988             run diasize_position-resize-button in this-procedure .
      989           end.
      990           else do:
      991             if frame d-shifts :scrollable = true
      992             then do:
      993               assign
      994                 frame d-shifts :virtual-height = v-frame-virtual-height
      995               .
      996             end.
      997             assign
      998               frame d-shifts :height = v-frame-height
      999             .
     1000             assign
     1001               v-diasize-browse-handle :height = v-browse-height
     1002             .
     1003             for each buf_temp-browse-handle
     1004               where buf_temp-browse-handle.browse-type = 'height':u
     1005             on error undo, next
     1006             :
     1007               assign
     1008                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1009               .
     1010             end.
     1011             for each buf_temp-diasize-handle
     1012             on error undo, next
     1013             :
     1014               assign
     1015                 v-object-handle = buf_temp-diasize-handle.handle-value
     1016               .
     1017               if v-object-handle <> v-diasize-resize-button
     1018               then do:
     1019                 assign
     1020                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1021                 .
     1022               end.
     1023             end.
     1024             run diasize_position-resize-button in this-procedure .
     1025           end.
     1026           assign
     1027             v-diasize-change-size = false
     1028           .
     1029           leave move_block .
     1030         end.
     1031       end.
     1032       assign
     1033         v-diasize-need-full-display = true
     1034       .
     1035       if v-diasize-change-size = false
     1036       then do:
     1037         assign
     1038           v-diasize-change-size = true
     1039         .
     1040       end.
     1041       else do:
     1042         return .
     1043       end.
     1044       assign
     1045         v-frame-height = frame d-shifts :height
     1046         v-frame-virtual-height = frame d-shifts :virtual-height
     1047         v-browse-height = v-diasize-browse-handle :height
     1048       .
     1049       for each buf_temp-browse-handle
     1050         where buf_temp-browse-handle.browse-type = 'height':u
     1051       :
     1052         assign
     1053           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1054         .
     1055       end.
     1056       for each buf_temp-diasize-handle
     1057       :
     1058         delete buf_temp-diasize-handle .
     1059       end.
     1060       assign
     1061         v-field-group-handle = frame d-shifts :first-child
     1062       .
     1063       do while valid-handle(v-field-group-handle)
     1064       :
     1065         assign
     1066           v-object-handle = v-field-group-handle :first-child
     1067         .
     1068         do while valid-handle(v-object-handle)
     1069         :
     1070           if  v-object-handle <> v-diasize-browse-handle :handle
     1071           and can-query(v-object-handle, "row")
     1072           and can-query(v-object-handle, "height")
     1073           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1074           then do:
     1075             find first buf_temp-browse-handle
     1076               where buf_temp-browse-handle.browse-type   = 'height':u
     1077                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1078               no-error .
     1079             if available buf_temp-browse-handle
     1080             then do:
     1081             end.
     1082             else do:
     1083               create buf_temp-diasize-handle .
     1084               assign
     1085                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1086                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1087               .
     1088             end.
     1089           end.
     1090           assign
     1091             v-object-handle = v-object-handle :next-sibling
     1092           .
     1093         end.
     1094         assign
     1095           v-field-group-handle = v-field-group-handle :next-sibling
     1096         .
     1097       end.
     1098       do with frame d-shifts
     1099       :
     1100         hide v-diasize-resize-button .
     1101         assign
     1102           v-diasize-resize-button :row    = 1
     1103           v-diasize-resize-button :column = 1
     1104         .
     1105       end.
     1106       if p-change-value > 0
     1107       then do:
     1108         if frame d-shifts :scrollable = true
     1109         then do:
     1110           assign
     1111             frame d-shifts :virtual-height = frame d-shifts :virtual-height + p-change-value
     1112             no-error .
     1113           if error-status :error
     1114           or error-status :get-message(1) <> ""
     1115           then do:
     1116             undo move_block, retry move_block .
     1117           end.
     1118         end.
     1119         assign
     1120           frame d-shifts :height = frame d-shifts :height + p-change-value
     1121           no-error .
     1122         if error-status :error
     1123         or error-status :get-message(1) <> ""
     1124         then do:
     1125           undo move_block, retry move_block .
     1126         end.
     1127         assign
     1128           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1129           no-error .
     1130         if error-status :error
     1131         or error-status :get-message(1) <> ""
     1132         then do:
     1133           undo move_block, retry move_block .
     1134         end.
     1135         for each buf_temp-browse-handle
     1136           where buf_temp-browse-handle.browse-type = 'height':u
     1137         on error undo move_block, retry move_block
     1138         :
     1139           assign
     1140             buf_temp-browse-handle.browse-handle :height
     1141               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1142             no-error .
     1143           if error-status :error
     1144           or error-status :get-message(1) <> ""
     1145           then do:
     1146             undo move_block, retry move_block .
     1147           end.
     1148         end.
     1149         for each buf_temp-diasize-handle
     1150         on error undo move_block, retry move_block
     1151         :
     1152           assign
     1153             v-object-handle = buf_temp-diasize-handle.handle-value
     1154           .
     1155           if v-object-handle <> v-diasize-resize-button
     1156           then do:
     1157             assign
     1158               v-object-handle :row = v-object-handle :row + p-change-value
     1159               no-error .
     1160             if error-status :error
     1161             or error-status :get-message(1) <> ""
     1162             then do:
     1163               undo move_block, retry move_block .
     1164             end.
     1165           end.
     1166         end.
     1167       end.
     1168       else do:
     1169         for each buf_temp-diasize-handle
     1170         on error undo move_block, retry move_block
     1171         :
     1172           assign
     1173             v-object-handle = buf_temp-diasize-handle.handle-value
     1174           .
     1175           if v-object-handle <> v-diasize-resize-button
     1176           then do:
     1177             assign
     1178               v-object-handle :row = v-object-handle :row + p-change-value
     1179               no-error .
     1180             if error-status :error
     1181             or error-status :get-message(1) <> ""
     1182             then do:
     1183               undo move_block, retry move_block .
     1184             end.
     1185           end.
     1186         end.
     1187         assign
     1188           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1189           no-error .
     1190         if error-status :error
     1191         or error-status :get-message(1) <> ""
     1192         then do:
     1193           undo move_block, retry move_block .
     1194         end.
     1195         for each buf_temp-browse-handle
     1196           where buf_temp-browse-handle.browse-type = 'height':u
     1197         on error undo move_block, retry move_block
     1198         :
     1199           assign
     1200             buf_temp-browse-handle.browse-handle :height
     1201               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1202             no-error .
     1203           if error-status :error
     1204           or error-status :get-message(1) <> ""
     1205           then do:
     1206             undo move_block, retry move_block .
     1207           end.
     1208         end.
     1209         assign
     1210           frame d-shifts :height = frame d-shifts :height + p-change-value
     1211           no-error .
     1212         if error-status :error
     1213         or error-status :get-message(1) <> ""
     1214         then do:
     1215           undo move_block, retry move_block .
     1216         end.
     1217         if frame d-shifts :scrollable = true
     1218         then do:
     1219           assign
     1220             frame d-shifts :virtual-height = frame d-shifts :virtual-height + p-change-value
     1221             no-error .
     1222           if error-status :error
     1223           or error-status :get-message(1) <> ""
     1224           then do:
     1225             undo move_block, retry move_block .
     1226           end.
     1227         end.
     1228       end.
     1229       if p-move-resize = true
     1230       then do:
     1231         run diasize_position-resize-button in this-procedure .
     1232       end.
     1233       if v-diasize-wndstore = true
     1234       then do:
     1235         if connected("ub") = true
     1236         then do:
     1237           define variable v-cntxt-db-num        as integer   no-undo .
     1238           define variable v-cntxt-userid        as character no-undo .
     1239           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1240                                             , OUTPUT v-cntxt-userid
     1241                                             ) .
     1242           run gbl/wndsizew.p
     1243             (input  v-cntxt-db-num
     1244             ,input  v-cntxt-userid
     1245             ,input  v-diasize-proc-name
     1246             ,input  'height':u
     1247             ,input  string(frame d-shifts :height - v-diasize-orig-frame-height)
     1248             ) .
     1249         end.
     1250       end.
     1251     end.
     1252     assign
     1253       v-diasize-change-size = false
     1254     .
     1255   end procedure.
     1256   procedure diasize_set-height :
     1257     define input  parameter p-new-height  as decimal   no-undo .
     1258     define input  parameter p-move-resize as logical   no-undo .
     1259     do
     1260     on error undo, return error return-value
     1261     :
     1262       run diasize_change-height in this-procedure
     1263         (input  (p-new-height - frame d-shifts :height)
     1264         ,input  p-move-resize
     1265         ) .
     1266     end.
     1267   end procedure.
     1268   procedure diasize_change-width :
     1269     define input  parameter p-change-value as decimal   no-undo .
     1270     define input  parameter p-move-resize  as logical   no-undo .
     1271     define variable v-field-group-handle   as handle    no-undo .
     1272     define variable v-object-handle        as handle    no-undo .
     1273     define variable v-frame-width          as decimal   no-undo .
     1274     define variable v-frame-virtual-width  as decimal   no-undo .
     1275     define variable v-browse-width         as decimal   no-undo .
     1276     define variable v-window-width         as decimal   no-undo .
     1277     define variable v-window-virtual-width as decimal   no-undo .
     1278     define variable v-change-sign          as integer   no-undo .
     1279     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1280     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1281     if p-change-value > 0
     1282     then do:
     1283       if frame d-shifts :width + p-change-value >
     1284           session :width-chars
     1285       then do:
     1286         assign
     1287           p-change-value = session :width-chars - frame d-shifts :width
     1288         .
     1289         if p-change-value <= 0
     1290         then do:
     1291           run diasize_position-resize-button in this-procedure .
     1292           return .
     1293         end.
     1294       end.
     1295     end.
     1296     if p-change-value < 0
     1297     then do:
     1298       if frame d-shifts :width + p-change-value < v-diasize-orig-frame-width
     1299       then do:
     1300         assign
     1301           p-change-value = v-diasize-orig-frame-width
     1302                          - frame d-shifts :width
     1303         .
     1304         if p-change-value >= 0
     1305         then do:
     1306           run diasize_position-resize-button in this-procedure .
     1307           return .
     1308         end.
     1309       end.
     1310     end.
     1311     if p-change-value >= 0
     1312     then do:
     1313       assign
     1314         v-change-sign = 1
     1315       .
     1316     end.
     1317     else do:
     1318       assign
     1319         v-change-sign = -1
     1320       .
     1321     end.
     1322     assign
     1323       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1324     .
     1325     if p-change-value = 0
     1326     then do:
     1327       run diasize_position-resize-button in this-procedure .
     1328       return .
     1329     end.
     1330     move_block:
     1331     do
     1332     on error undo move_block, leave move_block
     1333     :
     1334       if retry
     1335       then do:
     1336         do
     1337         on error undo move_block, leave move_block
     1338         :
     1339           if p-change-value > 0
     1340           then do:
     1341             for each buf_temp-diasize-handle
     1342             on error undo, next
     1343             :
     1344               assign
     1345                 v-object-handle = buf_temp-diasize-handle.handle-value
     1346               .
     1347               if v-object-handle <> v-diasize-resize-button
     1348               then do:
     1349                 assign
     1350                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1351                 .
     1352               end.
     1353             end.
     1354             assign
     1355               v-diasize-browse-handle :width = v-browse-width
     1356             .
     1357             for each buf_temp-browse-handle
     1358               where buf_temp-browse-handle.browse-type = 'width':u
     1359             on error undo, next
     1360             :
     1361               assign
     1362                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1363               .
     1364             end.
     1365             assign
     1366               frame d-shifts :width = v-frame-width
     1367             .
     1368             if frame d-shifts :scrollable = true
     1369             then do:
     1370               assign
     1371                 frame d-shifts :virtual-width = v-frame-virtual-width
     1372               .
     1373             end.
     1374             run diasize_position-resize-button in this-procedure .
     1375           end.
     1376           else do:
     1377             if frame d-shifts :scrollable = true
     1378             then do:
     1379               assign
     1380                 frame d-shifts :virtual-width = v-frame-virtual-width
     1381               .
     1382             end.
     1383             assign
     1384               frame d-shifts :width = v-frame-width
     1385             .
     1386             for each buf_temp-browse-handle
     1387               where buf_temp-browse-handle.browse-type = 'width':u
     1388             on error undo, next
     1389             :
     1390               assign
     1391                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1392               .
     1393             end.
     1394             assign
     1395               v-diasize-browse-handle :width = v-browse-width
     1396             .
     1397             for each buf_temp-diasize-handle
     1398             on error undo, next
     1399             :
     1400               assign
     1401                 v-object-handle = buf_temp-diasize-handle.handle-value
     1402               .
     1403               if v-object-handle <> v-diasize-resize-button
     1404               then do:
     1405                 assign
     1406                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1407                 .
     1408               end.
     1409             end.
     1410             run diasize_position-resize-button in this-procedure .
     1411           end.
     1412           assign
     1413             v-diasize-change-size = false
     1414           .
     1415           leave move_block .
     1416         end.
     1417       end.
     1418       assign
     1419         v-diasize-need-full-display = true
     1420       .
     1421       if v-diasize-change-size = false
     1422       then do:
     1423         assign
     1424           v-diasize-change-size = true
     1425         .
     1426       end.
     1427       else do:
     1428         return .
     1429       end.
     1430       assign
     1431         v-frame-width = frame d-shifts :width
     1432         v-frame-virtual-width = frame d-shifts :virtual-width
     1433         v-browse-width = v-diasize-browse-handle :width
     1434       .
     1435       for each buf_temp-browse-handle
     1436         where buf_temp-browse-handle.browse-type = 'width':u
     1437       :
     1438         assign
     1439           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1440         .
     1441       end.
     1442       for each buf_temp-diasize-handle
     1443       :
     1444         delete buf_temp-diasize-handle .
     1445       end.
     1446       assign
     1447         v-field-group-handle = frame d-shifts :first-child
     1448       .
     1449       do while valid-handle(v-field-group-handle)
     1450       :
     1451         assign
     1452           v-object-handle = v-field-group-handle :first-child
     1453         .
     1454         do while valid-handle(v-object-handle)
     1455         :
     1456           if  v-object-handle <> v-diasize-browse-handle :handle
     1457           and v-object-handle <> v-diasize-resize-button
     1458           and can-query(v-object-handle, "row")
     1459           and can-query(v-object-handle, "height")
     1460           and ( v-object-handle :col + v-object-handle :width
     1461                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1462               )
     1463           then do:
     1464             find first buf_temp-browse-handle
     1465               where buf_temp-browse-handle.browse-type   = 'width':u
     1466                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1467               no-error .
     1468             if available buf_temp-browse-handle
     1469             then do:
     1470             end.
     1471             else do:
     1472               create buf_temp-diasize-handle .
     1473               assign
     1474                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1475                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1476               .
     1477             end.
     1478           end.
     1479           assign
     1480             v-object-handle = v-object-handle :next-sibling
     1481           .
     1482         end.
     1483         assign
     1484           v-field-group-handle = v-field-group-handle :next-sibling
     1485         .
     1486       end.
     1487       do with frame d-shifts
     1488       :
     1489         hide v-diasize-resize-button .
     1490         v-diasize-resize-button :row = 1.
     1491         v-diasize-resize-button :column = 1.
     1492       end.
     1493       if p-change-value > 0
     1494       then do:
     1495         if frame d-shifts :scrollable = true
     1496         then do:
     1497           assign
     1498             frame d-shifts :virtual-width = frame d-shifts :virtual-width + p-change-value
     1499             no-error .
     1500           if error-status :error
     1501           or error-status :get-message(1) <> ""
     1502           then do:
     1503             undo move_block, retry move_block.
     1504           end.
     1505         end.
     1506         assign
     1507           frame d-shifts :width = v-frame-width + p-change-value
     1508           no-error .
     1509         if error-status :error
     1510         or error-status :get-message(1) <> ""
     1511         then do:
     1512           undo move_block, retry move_block.
     1513         end.
     1514         assign
     1515           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1516         no-error .
     1517         if error-status :error
     1518         or error-status :get-message(1) <> ""
     1519         then do:
     1520           undo move_block, retry move_block.
     1521         end.
     1522         for each buf_temp-browse-handle
     1523           where buf_temp-browse-handle.browse-type = 'width':u
     1524         on error undo move_block, retry move_block
     1525         :
     1526           assign
     1527             buf_temp-browse-handle.browse-handle :width
     1528               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1529             no-error .
     1530           if error-status :error
     1531           or error-status :get-message(1) <> ""
     1532           then do:
     1533             undo move_block, retry move_block .
     1534           end.
     1535         end.
     1536         for each buf_temp-diasize-handle
     1537         on error undo move_block, retry move_block
     1538         :
     1539           assign
     1540             v-object-handle = buf_temp-diasize-handle.handle-value
     1541           .
     1542           if v-object-handle <> v-diasize-resize-button
     1543           then do:
     1544             assign
     1545               v-object-handle :col = v-object-handle :col + p-change-value
     1546               no-error .
     1547             if error-status :error
     1548             or error-status :get-message(1) <> ""
     1549             then do:
     1550               undo move_block, retry move_block .
     1551             end.
     1552           end.
     1553         end.
     1554       end.
     1555       else do:
     1556         for each buf_temp-diasize-handle
     1557         on error undo move_block, retry move_block
     1558         :
     1559           assign
     1560             v-object-handle = buf_temp-diasize-handle.handle-value
     1561           .
     1562           if v-object-handle <> v-diasize-resize-button
     1563           then do:
     1564             assign
     1565               v-object-handle :col = v-object-handle :col + p-change-value
     1566               no-error .
     1567             if error-status :error
     1568             or error-status :get-message(1) <> ""
     1569             then do:
     1570               undo move_block, retry move_block .
     1571             end.
     1572           end.
     1573         end.
     1574         for each buf_temp-browse-handle
     1575           where buf_temp-browse-handle.browse-type = 'width':u
     1576         on error undo move_block, retry move_block
     1577         :
     1578           assign
     1579             buf_temp-browse-handle.browse-handle :width
     1580               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1581             no-error .
     1582           if error-status :error
     1583           or error-status :get-message(1) <> ""
     1584           then do:
     1585             undo move_block, retry move_block .
     1586           end.
     1587         end.
     1588         assign
     1589           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1590           no-error .
     1591         if error-status :error
     1592         or error-status :get-message(1) <> ""
     1593         then do:
     1594           undo move_block, retry move_block.
     1595         end.
     1596         assign
     1597           frame d-shifts :width = frame d-shifts :width + p-change-value
     1598         no-error .
     1599         if error-status :error
     1600         or error-status :get-message(1) <> ""
     1601         then do:
     1602           undo move_block, retry move_block.
     1603         end.
     1604         if frame d-shifts :scrollable = true
     1605         then do:
     1606           assign
     1607             frame d-shifts :virtual-width = frame d-shifts :virtual-width + p-change-value
     1608           no-error .
     1609           if error-status :error
     1610           or error-status :get-message(1) <> ""
     1611           then do:
     1612             undo move_block, retry move_block.
     1613           end.
     1614         end.
     1615       end.
     1616       if p-move-resize
     1617       then do:
     1618         run diasize_position-resize-button in this-procedure .
     1619       end.
     1620       if v-diasize-wndstore = true
     1621       then do:
     1622         if connected("ub") = true
     1623         then do:
     1624           define variable v-cntxt-db-num        as integer   no-undo .
     1625           define variable v-cntxt-userid        as character no-undo .
     1626           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1627                                             , OUTPUT v-cntxt-userid
     1628                                             ) .
     1629           run gbl/wndsizew.p
     1630             (input  v-cntxt-db-num
     1631             ,input  v-cntxt-userid
     1632             ,input  v-diasize-proc-name
     1633             ,input  'width':u
     1634             ,input  string(frame d-shifts :width - v-diasize-orig-frame-width)
     1635             ) .
     1636         end.
     1637       end.
     1638     end.
     1639     assign
     1640       v-diasize-change-size = false
     1641     .
     1642   end procedure.
     1643   procedure diasize_set-width :
     1644     define input  parameter p-new-width  as decimal   no-undo .
     1645     define input  parameter p-move-resize as logical   no-undo .
     1646     do
     1647     on error undo, return error return-value
     1648     :
     1649       run diasize_change-width in this-procedure
     1650         (input  (p-new-width - frame d-shifts :width)
     1651         ,input  p-move-resize
     1652         ) .
     1653     end.
     1654   end procedure.
     1655   procedure diasize_position-resize-button :
     1656     do with frame d-shifts
     1657     :
     1658       hide v-diasize-resize-button .
     1659       assign
     1660         v-diasize-resize-button :row = frame d-shifts :height - v-diasize-resize-button :height
     1661                     - 1
     1662                     - (frame d-shifts :border-bottom-pixels / session :pixels-per-row)
     1663         v-diasize-resize-button :col = frame d-shifts :width - v-diasize-resize-button :width
     1664                     - 1
     1665                     - (frame d-shifts :border-right-pixels / session :pixels-per-column)
     1666       .
     1667       view v-diasize-resize-button .
     1668     end.
     1669   end procedure.
     1670   on alt-right anywhere
     1671   do:
     1672     run diasize_change-width in this-procedure
     1673       (input 1
     1674       ,input true
     1675       ) .
     1676     return no-apply .
     1677   end.
     1678   on alt-left anywhere
     1679   do:
     1680     run diasize_change-width in this-procedure
     1681       (input -1
     1682       ,input true
     1683       ) .
     1684     return no-apply .
     1685   end.
     1686   on alt-down anywhere
     1687   do:
     1688     run diasize_change-height in this-procedure
     1689       (input 1
     1690       ,input true
     1691       ) .
     1692     return no-apply .
     1693   end.
     1694   on alt-up anywhere
     1695   do:
     1696     run diasize_change-height in this-procedure
     1697       (input -1
     1698       ,input true
     1699       ) .
     1700     return no-apply .
     1701   end.
     1702   on alt-enter of frame d-shifts
     1703   do:
     1704     run diasize_maximize in this-procedure
     1705       (input  ?
     1706       ).
     1707     return no-apply .
     1708   end.
     1709   procedure diasize_end-move :
     1710     do
     1711     on error undo, return error return-value
     1712     :
     1713       define variable v-row-delta as decimal   no-undo .
     1714       define variable v-col-delta as decimal   no-undo .
     1715       define variable v-new-row as decimal   no-undo .
     1716       define variable v-new-col as decimal   no-undo .
     1717       assign
     1718         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1719         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1720       .
     1721       assign
     1722         v-row-delta = v-new-row - frame d-shifts :height
     1723         v-col-delta = v-new-col - frame d-shifts :width
     1724       .
     1725       run diasize_change-height in this-procedure
     1726         (input v-row-delta
     1727         ,input true
     1728         ) .
     1729       run diasize_change-width in this-procedure
     1730         (input v-col-delta
     1731         ,input true
     1732         ) .
     1733     end.
     1734   end procedure.
     1735   procedure diasize_maximize :
     1736     define input  parameter p-action as logical   no-undo .
     1737     do
     1738     on error undo, return error return-value
     1739     :
     1740       if p-action = ?
     1741       then do:
     1742         if v-diasize-need-maximize = true
     1743         then do:
     1744           assign
     1745             p-action = true
     1746           .
     1747         end.
     1748         else do:
     1749           assign
     1750             p-action = false
     1751           .
     1752         end.
     1753       end.
     1754       if p-action = true
     1755       then do:
     1756         run diasize_change-height in this-procedure
     1757           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1758               - frame d-shifts :height-chars
     1759           ,input true
     1760           ) .
     1761         run diasize_change-width in this-procedure
     1762           (input session :width-chars
     1763               - frame d-shifts :width-chars
     1764           ,input true
     1765           ) .
     1766         assign
     1767           v-diasize-need-maximize = false
     1768         .
     1769       end.
     1770       else do:
     1771         run diasize_change-width in this-procedure
     1772           (input v-diasize-orig-frame-width
     1773               - frame d-shifts :width-chars
     1774           ,input true
     1775           ) .
     1776         run diasize_change-height in this-procedure
     1777           (input v-diasize-orig-frame-height
     1778               - frame d-shifts :height-chars
     1779           ,input true
     1780           ) .
     1781         assign
     1782           v-diasize-need-maximize = true
     1783         .
     1784       end.
     1785     end.
     1786   end procedure.
     1787   procedure diasize_restore-orig-size :
     1788     do
     1789     on error undo, return error return-value
     1790     :
     1791       assign
     1792         v-diasize-current-frame-width  = frame d-shifts :width
     1793         v-diasize-current-frame-height = frame d-shifts :height
     1794       .
     1795       run diasize_set-height in this-procedure
     1796         (input  v-diasize-orig-frame-height
     1797         ,input  true
     1798         ) .
     1799       run diasize_set-width in this-procedure
     1800         (input  v-diasize-orig-frame-width
     1801         ,input  true
     1802         ) .
     1803     end.
     1804   end procedure.
     1805   procedure diasize_restore-current-size :
     1806     do
     1807     on error undo, return error return-value
     1808     :
     1809       run diasize_set-height in this-procedure
     1810         (input  v-diasize-current-frame-height
     1811         ,input  true
     1812         ) .
     1813       run diasize_set-width in this-procedure
     1814         (input  v-diasize-current-frame-width
     1815         ,input  true
     1816         ) .
     1817     end.
     1818   end procedure.
     1819   procedure diasize_set-browse-handle :
     1820     define input  parameter p-browse-handle as handle   no-undo .
     1821     define buffer buf_temp-browse-handle for temp-browse-handle .
     1822     do
     1823     on error undo, return error return-value
     1824     :
     1825       assign
     1826         v-diasize-browse-handle = p-browse-handle
     1827       .
     1828       for each buf_temp-browse-handle
     1829       on error undo, return error return-value
     1830       :
     1831         delete buf_temp-browse-handle .
     1832       end.
     1833     end.
     1834   end procedure.
     1835   procedure diasize_add_browse :
     1836     define input  parameter p-browse-type   as character no-undo .
     1837     define input  parameter p-browse-handle as handle    no-undo .
     1838     define buffer buf_temp-browse-handle for temp-browse-handle .
     1839     do
     1840     on error undo, return error return-value
     1841     :
     1842       assign
     1843         v-diasize-browse-number = v-diasize-browse-number + 1
     1844       .
     1845       create buf_temp-browse-handle .
     1846       assign
     1847         buf_temp-browse-handle.browse-type   = p-browse-type
     1848         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1849         buf_temp-browse-handle.browse-handle = p-browse-handle
     1850       .
     1851     end.
     1852   end procedure.
     1853   procedure diasize_init :
     1854     define variable v-default-value    as logical   no-undo .
     1855     define variable v-restore-saved    as logical   no-undo .
     1856     define variable v-resize-value-str as character no-undo .
     1857     do
     1858     on error undo, return error return-value
     1859     :
     1860       do with frame d-shifts
     1861       :
     1862         assign
     1863           v-diasize-orig-frame-height = frame d-shifts :height
     1864           v-diasize-orig-frame-width  = frame d-shifts :width
     1865           v-diasize-browse-handle     = browse br-shift :handle
     1866         .
     1867         create button v-diasize-resize-button
     1868         assign
     1869           parent        = frame d-shifts :first-child
     1870           label         = "s"
     1871           height-pixels = 16
     1872           width-pixels  = 16
     1873           visible       = true
     1874           sensitive     = true
     1875           movable       = true
     1876           triggers:
     1877             on end-move persistent run diasize_end-move in this-procedure .
     1878           end triggers.
     1879         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1880         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1881         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1882         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1883         assign
     1884           v-diasize-wndmax = false
     1885         .
     1886         if connected("ub") = true
     1887         then do:
     1888           define variable v-cntxt-db-num        as integer   no-undo .
     1889           define variable v-cntxt-userid        as character no-undo .
     1890           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1891                                             , OUTPUT v-cntxt-userid
     1892                                             ) .
     1893           run gbl/wndpar_r.p
     1894             (input  v-cntxt-db-num
     1895             ,input  v-cntxt-userid
     1896             ,input  'wndmax':U
     1897             ,output v-diasize-wndmax
     1898             ,output v-default-value
     1899             ) .
     1900         end.
     1901         assign
     1902           v-diasize-wndstore = false
     1903         .
     1904         if connected("ub") = true
     1905         then do:
     1906           run gbl/wndpar_r.p
     1907             (input  v-cntxt-db-num
     1908             ,input  v-cntxt-userid
     1909             ,input  'wndstore':U
     1910             ,output v-diasize-wndstore
     1911             ,output v-default-value
     1912             ) .
     1913         end.
     1914         assign
     1915           v-diasize-proc-name = entry(1, program-name(2), '.')
     1916         .
     1917         if v-diasize-wndstore = true
     1918         then do:
     1919           assign
     1920             v-restore-saved = false
     1921           .
     1922           if connected("ub") = true
     1923           then do:
     1924             run gbl/wndsizer.p
     1925               (input  v-cntxt-db-num
     1926               ,input  v-cntxt-userid
     1927               ,input  v-diasize-proc-name
     1928               ,input  'height':u
     1929               ,output v-resize-value-str
     1930               ) .
     1931             if v-resize-value-str <> '':U
     1932             then do:
     1933               run diasize_change-height in this-procedure
     1934                 (input  integer(v-resize-value-str)
     1935                 ,input  true
     1936                 ) .
     1937               assign
     1938                 v-restore-saved = true
     1939               .
     1940             end.
     1941           end.
     1942           if connected("ub") = true
     1943           then do:
     1944             run gbl/wndsizer.p
     1945               (input  v-cntxt-db-num
     1946               ,input  v-cntxt-userid
     1947               ,input  v-diasize-proc-name
     1948               ,input  'width':u
     1949               ,output v-resize-value-str
     1950               ) .
     1951             if v-resize-value-str <> '':U
     1952             then do:
     1953               run diasize_change-width in this-procedure
     1954                 (input  integer(v-resize-value-str)
     1955                 ,input  true
     1956                 ) .
     1957               assign
     1958                 v-restore-saved = true
     1959               .
     1960             end.
     1961           end.
     1962           if v-restore-saved <> true
     1963           then do:
     1964             if v-diasize-wndmax = true
     1965             then do:
     1966               run diasize_maximize in this-procedure
     1967                 (input  true
     1968                 ) .
     1969             end.
     1970           end.
     1971         end.
     1972         else do:
     1973           if v-diasize-wndmax = true
     1974           then do:
     1975             run diasize_maximize in this-procedure
     1976               (input  true
     1977               ) .
     1978           end.
     1979         end.
     1980       end.
     1981     end.
     1982   end procedure.
     1983   procedure diasize_need-full-display :
     1984     define output parameter p-need-full-display as logical   no-undo .
     1985     do
     1986     on error undo, return error return-value
     1987     :
     1988       assign
     1989         p-need-full-display = v-diasize-need-full-display
     1990       .
     1991       assign
     1992         v-diasize-need-full-display = false
     1993       .
     1994     end.
     1995   end procedure.
     1996   procedure get-context :
     1997      define output parameter p-db-num as integer          no-undo.
     1998      define output parameter p-user-id as character        no-undo.
     1999      define variable v-login               as character    no-undo.
     2000      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2001      define buffer buf_user-login  for ub.user-login .
     2002      do
     2003      on error undo, return error
     2004      :
     2005            FIND FIRST buf_sys-ctrl no-lock.
     2006            ASSIGN
     2007               v-login = USERID("ub")
     2008               p-db-num = buf_sys-ctrl.db-num
     2009            .
     2010            FIND FIRST buf_user-login
     2011                 WHERE buf_user-login.db-num = p-db-num
     2012                   AND buf_user-login.user-login = v-login
     2013                 no-lock
     2014                 no-error
     2015                 .
     2016            IF AVAILABLE buf_user-login
     2017            THEN DO:
     2018               assign
     2019                  p-user-id = buf_user-login.user-id
     2020               .
     2021            END.
     2022      end.
     2023   end procedure.
     2024       run diasize_init in this-procedure .
