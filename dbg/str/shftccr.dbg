        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER p-obj-type   like ub.shift-cash.obj-type no-undo.
        3   DEFINE INPUT PARAMETER p-obj-code   like ub.shift-cash.obj-code no-undo.
        4   DEFINE INPUT PARAMETER p-cash-num   like ub.cash-desk.cash-num no-undo.
        5   DEFINE INPUT PARAMETER p-shift-date like ub.shift-cash.shift-date no-undo.
        6   DEFINE INPUT PARAMETER p-shift-num  like ub.shift-cash.shift-num no-undo.
        7   DEFINE INPUT PARAMETER p-src-shift-name like ub.shift-cash.z-status no-undo.
        8   DEFINE INPUT PARAMETER p-shift-name like ub.shift-cash.z-status no-undo.
        9   define input parameter p-shift-open-time as integer no-undo .
       10   DEFINE INPUT PARAMETER v-z-num      like ub.shift-cash.z-num no-undo.
       11   DEFINE INPUT PARAMETER act-mess     as character no-undo.
       12   DEFINE OUTPUT PARAMETER v-recid     as recid no-undo.
       13   define variable vss-revision    as character no-undo init "$Revision: 82660c506036, 2990, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
       15   define variable vss-date        as character no-undo init "$Date: Ср апр 06 16:23:43 2022 +0300 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: shftccr.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: str/shftccr.p $":U .
       18   define variable vss-description as character no-undo init "Создание записи кассовой смены".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   FUNCTION get-ranged-shift-num returns integer (input p-shift-num-list as character
       81                                                 ,input p-status-list as character):
       82    if num-entries(p-shift-num-list) = 1 then return integer(p-shift-num-list).
       83    if index(p-status-list, '3') > 0 then return integer(entry(lookup('3', p-status-list) ,p-shift-num-list )).
       84    if index(p-status-list, '2') > 0 then return integer(entry(lookup('2', p-status-list) ,p-shift-num-list )).
       85    if index(p-status-list, '1') > 0 then return integer(entry(lookup('1', p-status-list) ,p-shift-num-list )).
       86    if index(p-status-list, '0') > 0 then return integer(entry(lookup('0', p-status-list) ,p-shift-num-list )).
       87   END FUNCTION.
       88   procedure get-shift-num :
       89   define input parameter p-obj-type like ub.chk-doc.obj-type no-undo .
       90   define input parameter p-obj-code like ub.chk-doc.obj-code no-undo .
       91   define input parameter p-shift-date like ub.chk-doc.shift-date no-undo .
       92   define input parameter p-shift-name as character no-undo .
       93   define output parameter p-shift-num as integer no-undo .
       94   define variable v-shift-num-list as character no-undo .
       95   define variable v-status-list as character no-undo .
       96   define buffer buf_shift-obj for ub.shift-obj .
       97     do
       98     on error undo, return error
       99     :
      100       for each  buf_shift-obj no-lock  where
      101               buf_shift-obj.obj-type    = p-obj-type
      102           AND  buf_shift-obj.obj-code   = p-obj-code
      103           AND  buf_shift-obj.shift-date = p-shift-date
      104           and  buf_shift-obj.shift-name = p-shift-name
      105           on error undo, return error return-value :
      106         assign
      107         v-shift-num-list = string(buf_shift-obj.shift-num) +
      108                           (if v-shift-num-list = '':U then '':U else chr(44)) + v-shift-num-list
      109         v-status-list    = entry(lookup(buf_shift-obj.status_, 'ожд,тек,зкр,отм':U), '2,3,1,0':U) +
      110                           (if v-status-list = '':U then '':U else chr(44)) + v-status-list
      111         .
      112       end.
      113       if v-shift-num-list = '':U then do:
      114         p-shift-num = 0.
      115       end.
      116       else do:
      117         assign
      118         p-shift-num = get-ranged-shift-num(v-shift-num-list, v-status-list).
      119       end.
      120     end.
      121   end procedure.
      122   define variable v-src-shift-name as character no-undo .
      123   define variable v-shift-name as character no-undo .
      124   define buffer buf_shift-cash for ub.shift-cash.
      125   do
      126   on error undo, return error
      127   :
      128     if p-shift-num = ? THEN DO:
      129       IF P-SHIFT-NAME <> ? then do:
      130         run get-shift-num  in this-procedure (
      131                                               input  p-obj-type
      132                                               ,input  p-obj-code
      133                                               ,input  p-shift-date
      134                                               ,input  p-shift-name
      135                                               ,output p-shift-num ) no-error .
      136         if p-shift-num = 0 then return error substitute("Не удалось определить порядок смены:&1&2&3 смена от &4 № смены &5"
      137                                                   , p-obj-type
      138                                                   , p-obj-code
      139                                                   , chr(10)
      140                                                   , p-shift-date
      141                                                   , p-shift-name) .
      142       end.
      143     END.
      144     FIND FIRST buf_shift-cash No-LOCK WHERE
      145               buf_shift-cash.obj-type = p-obj-type
      146           AND buf_shift-cash.obj-code = p-obj-code
      147           AND buf_shift-cash.cash-num = p-cash-num
      148           AND buf_shift-cash.shift-date = p-shift-date
      149           AND buf_shift-cash.shift-num = p-shift-num  No-ERROR.
      150     if not available buf_shift-cash
      151     and p-shift-name <> ?
      152     and p-src-shift-name = ?
      153     then do:
      154       _shift-cash:
      155       for each buf_shift-cash no-lock where
      156               buf_shift-cash.obj-type = p-obj-type
      157           and buf_shift-cash.obj-code = p-obj-code
      158           AND buf_shift-cash.cash-num = p-cash-num
      159           AND buf_shift-cash.shift-date = p-shift-date
      160           AND buf_shift-cash.shift-num = 0:
      161         if buf_shift-cash.status_ =  'зкр':U then NEXT _shift-cash.
      162         if buf_shift-cash.src-shift-name = p-shift-name
      163         and v-shift-name = '':U
      164         then do:
      165           LEAVE _shift-cash.
      166         end.
      167       end.
      168       if available buf_shift-cash then do:
      169         find current buf_shift-cash exclusive-lock .
      170         assign
      171         buf_shift-cash.shift-name = p-shift-name
      172         buf_shift-cash.shift-num = p-shift-num
      173         v-recid = recid(buf_shift-cash).
      174         .
      175         run process-all-check in this-procedure ( input p-shift-date
      176                                                 , input p-shift-name
      177                                                 , input p-shift-num) no-error.
      178         return.
      179       end.
      180     end.
      181     if act-mess                   ne 'прием-чек':U
      182     then
      183        run process-all-check in this-procedure ( input p-shift-date
      184                                                , input p-shift-name
      185                                                , input p-shift-num) no-error.
      186     if avail buf_shift-cash then do:
      187       if buf_shift-cash.status_ = 'зкр':U
      188       AND not act-mess = 'касса-вкл':U
      189       and (p-src-shift-name = ?
      190           or p-src-shift-name = buf_shift-cash.src-shift-name)
      191       then do:
      192           v-recid = recid(buf_shift-cash).
      193             return.
      194       end.
      195       else do:
      196         assign
      197         v-src-shift-name = buf_shift-cash.src-shift-name
      198         v-shift-name = buf_shift-cash.shift-name
      199         v-recid = recid(buf_shift-cash).
      200         if (p-shift-name <> ?
      201         and p-shift-name <> v-shift-name ) then do:
      202           find current buf_shift-cash exclusive-lock .
      203           assign
      204           v-shift-name      = (if p-shift-name <> ?
      205                                 then p-shift-name
      206                                 else v-shift-name)
      207           .
      208           assign
      209           buf_shift-cash.shift-name = v-shift-name
      210           buf_shift-cash.src-shift-name = v-src-shift-name
      211           .
      212           return.
      213         end.
      214       end.
      215     end.
      216     find first buf_shift-cash no-lock where
      217             buf_shift-cash.obj-type = p-obj-type
      218        and buf_shift-cash.obj-code = p-obj-code
      219        and buf_shift-cash.cash-num = p-cash-num
      220        and buf_shift-cash.z-num = v-z-num
      221        and buf_shift-cash.shift-date = p-shift-date
      222        and buf_shift-cash.shift-num = p-shift-num
      223        and buf_shift-cash.src-shift-name = (if p-src-shift-name <> ? then p-src-shift-name else '')
      224        no-error .
      225     if available buf_shift-cash then do:
      226        if p-src-shift-name <> ?
      227        and buf_shift-cash.opened = 'прием-чек':U
      228        and buf_shift-cash.shift-open-time > p-shift-open-time then do:
      229          assign
      230          v-recid = recid(buf_shift-cash).
      231          find current buf_shift-cash exclusive-lock .
      232          assign
      233          buf_shift-cash.shift-open-time = p-shift-open-time
      234          .
      235        end.
      236        return.
      237     end.
      238     return-value = '':U.
      239     find first buf_shift-cash no-lock where
      240             buf_shift-cash.obj-type = p-obj-type
      241         and buf_shift-cash.obj-code = p-obj-code
      242         and buf_shift-cash.cash-num = p-cash-num
      243         and buf_shift-cash.shift-date = p-shift-date
      244         and buf_shift-cash.shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      245         and buf_shift-cash.src-shift-name = (if p-src-shift-name <> ? then p-src-shift-name else '') no-error .
      246    if not available buf_shift-cash then do:
      247       create buf_shift-cash.
      248       assign
      249       buf_shift-cash.obj-type = p-obj-type
      250       buf_shift-cash.obj-code = p-obj-code
      251       buf_shift-cash.cash-num = p-cash-num
      252       buf_shift-cash.z-num = v-z-num
      253       buf_shift-cash.shift-date = p-shift-date
      254       buf_shift-cash.shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      255       buf_shift-cash.src-shift-name = (if p-src-shift-name <> ? then p-src-shift-name else '')
      256       buf_shift-cash.shift-name = (if p-shift-name <> ? then p-shift-name else '')
      257       buf_shift-cash.shift-open-time = (if p-shift-open-time <> ? then p-shift-open-time else buf_shift-cash.shift-open-time)
      258       buf_shift-cash.sale-date = buf_shift-cash.shift-date
      259       buf_shift-cash.status_ = 'тек':U
      260       buf_shift-cash.opened = act-mess
      261       v-recid = recid(buf_shift-cash)
      262       no-error
      263       .
      264       if error-status:error then do:
      265         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
      266       end.
      267       release buf_shift-cash no-error.
      268       if error-status:error then do:
      269       v-recid = ?.
      270       undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
      271       end.
      272     end.
      273     else do:
      274       if      buf_shift-cash.opened     ne 'прием-чек':U
      275          and act-mess                   eq 'прием-чек':U
      276       then do:
      277          find current buf_shift-cash exclusive-lock.
      278          assign
      279             buf_shift-cash.opened = act-mess
      280             buf_shift-cash.shift-open-time = (if p-shift-open-time <> ? then p-shift-open-time else buf_shift-cash.shift-open-time)
      281          .
      282       end.
      283       v-recid = recid(buf_shift-cash).
      284     end.
      285   end.
      286   procedure process-all-check :
      287   define input parameter p-shift-date like ub.chk-doc.shift-date no-undo .
      288   define input parameter p-shift-name as character no-undo .
      289   define input parameter p-shift-num like ub.chk-doc.shift-num no-undo .
      290   define buffer buf_chk-doc for ub.chk-doc.
      291     do
      292     on error undo, return error
      293     :
      294     _chk-doc:
      295     for each buf_chk-doc Exclusive-lock where
      296             buf_chk-doc.obj-type = p-obj-type
      297         and buf_chk-doc.obj-code = p-obj-code
      298         and buf_chk-doc.shift-date = p-shift-date
      299         and buf_chk-doc.shift-num = 0
      300         and (buf_chk-doc.out-code = ? or buf_chk-doc.out-code = '':U)
      301      on error undo, next _chk-doc
      302      on stop undo, next _chk-doc:
      303         if buf_chk-doc.src-shift-name = p-shift-name then do:
      304           assign
      305           buf_chk-doc.shift-num = p-shift-num
      306           buf_chk-doc.shift-name = p-shift-name
      307           buf_chk-doc.office = replace(buf_chk-doc.office, 'смн-ош':U, '':U)
      308           buf_chk-doc.office = replace(buf_chk-doc.office, chr(44) + chr(44), chr(44))
      309           buf_chk-doc.office = trim(buf_chk-doc.office, chr(44))
      310           buf_chk-doc.correct = (if buf_chk-doc.office = 'т':U
      311                                  or buf_chk-doc.office = 'у':U
      312                                  then yes
      313                                  else no)
      314           .
      315         end.
      316       end.
      317     end.
      318   end procedure.
