        1   define shared temp-table tt-sug-struct no-undo
        2     field ii as integer
        3     field key_ as character
        4     field val_ as decimal format ">>>>9.<<<<"
        5     index pi
        6       as primary unique
        7       ii
        8   .
        9   define input  parameter p-obj-type as character no-undo .
       10   define input  parameter p-obj-code as integer no-undo .
       11   define input  parameter p-pl-code as integer no-undo .
       12   define input  parameter p-gds-code as integer no-undo .
       13   define input  parameter p-rvs-code as character no-undo .
       14   define input  parameter p-temp    as decimal no-undo .
       15   define input  parameter p-press   as decimal no-undo .
       16   define output parameter p-dens    as decimal no-undo .
       17   define output parameter p-dens-pf as decimal no-undo .
       18   define output parameter p-ok      as logical no-undo .
       19   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       20   define new global shared variable g#language as character no-undo .
       21   if g#language <> '' and g#language <> 'rus':U then do:
       22     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       23   end.
       24   procedure cur-time :
       25      define output parameter p-today as date      no-undo .
       26      define output parameter p-time  as integer   no-undo .
       27     do
       28     on error undo, return error
       29     :
       30       define variable v-date1 as date      no-undo .
       31       define variable v-date2 as date      no-undo .
       32       define variable v-time  as integer   no-undo .
       33       assign
       34         v-date1 = today
       35         v-time  = time
       36         v-date2 = today
       37       .
       38       if v-date1 <> v-date2
       39       then do:
       40         assign
       41           v-date1 = today
       42           v-time  = v-time
       43         .
       44       end.
       45       assign
       46         p-today = v-date1
       47         p-time  = v-time
       48       .
       49     end.
       50   end.
       51   function cur-time-date returns character
       52   :
       53     return string(today, '99/99/9999':U) .
       54   end.
       55   function cur-time-mjd returns decimal
       56   :
       57     define variable v-date as date      no-undo .
       58     define variable v-time as integer   no-undo .
       59     run cur-time in this-procedure
       60       (output v-date
       61       ,output v-time
       62       ) .
       63     return integer(v-date) - 2400002 + (v-time / 86400) .
       64   end.
       65   function cur-time-get-ending-index returns integer
       66   (input p-number as integer
       67   )
       68   :
       69     if p-number < 0
       70     or p-number = ?
       71     then do:
       72       return 1 .
       73     end.
       74     define variable v-rest as integer   no-undo .
       75     assign
       76       p-number = p-number modulo 100
       77     .
       78     if p-number < 20
       79     then do:
       80       assign
       81         v-rest = p-number
       82       .
       83     end.
       84     else do:
       85       assign
       86         v-rest = p-number modulo 10
       87       .
       88     end.
       89     case v-rest :
       90       when 1
       91       then do:
       92         return 2 .
       93       end.
       94       when 2 or
       95       when 3 or
       96       when 4
       97       then do:
       98         return 3 .
       99       end.
      100       otherwise do:
      101         return 1 .
      102       end.
      103     end case .
      104   end.
      105   procedure cur-time-mjd-to-date :
      106      define input  parameter i-mjd-diff as decimal no-undo.
      107      define output parameter o-Date     as date    no-undo.
      108      define output parameter o-Time     as integer no-undo.
      109      define variable v-day-number as integer   no-undo .
      110      if    i-mjd-diff < 0
      111         or i-mjd-diff = ?
      112      then do:
      113         return "?" .
      114      end.
      115      assign
      116         v-day-number = truncate(i-mjd-diff,0).
      117         o-Date = date(v-day-number + 2400002).
      118         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      119     .
      120   end.
      121   function cur-time-mjd-to-string returns character
      122   (input p-mjd-diff as decimal
      123   )
      124   :
      125     define variable v-day-number as integer   no-undo .
      126     define variable v-seconds    as integer   no-undo .
      127     define variable v-hour       as integer   no-undo .
      128     define variable v-min        as integer   no-undo .
      129     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      130     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      131     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      132     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      133     if p-mjd-diff < 0
      134     or p-mjd-diff = ?
      135     then do:
      136       return "?" .
      137     end.
      138     assign
      139       v-day-number = integer(truncate(p-mjd-diff,0))
      140       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      141     .
      142     if v-seconds > 86400
      143     then do:
      144       assign
      145         v-seconds = 86400 - 1
      146       .
      147     end.
      148     if v-seconds < 0
      149     then do:
      150       assign
      151         v-seconds = 0
      152       .
      153     end.
      154     assign
      155       v-hour = truncate(v-seconds / 3600, 0)
      156     .
      157     assign
      158       v-seconds = v-seconds modulo 3600
      159     .
      160     assign
      161       v-min = truncate(v-seconds / 60, 0)
      162     .
      163     assign
      164       v-seconds = v-seconds modulo 60
      165     .
      166     return
      167         (if v-day-number <> 0
      168           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      169           else ""
      170         )
      171       + (if v-day-number <> 0 or v-hour <> 0
      172           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      173           else ""
      174         )
      175       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      176           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      177           else ""
      178         )
      179       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      180       .
      181   end.
      182   function cur-time-string returns character
      183   :
      184     define variable v-date as date      no-undo .
      185     define variable v-time as integer   no-undo .
      186     run cur-time in this-procedure
      187       (output v-date
      188       ,output v-time
      189       ) .
      190     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      191   end.
      192   function cur-time-string-sec returns character
      193   :
      194     define variable v-date as date      no-undo .
      195     define variable v-time as integer   no-undo .
      196     run cur-time in this-procedure
      197       (output v-date
      198       ,output v-time
      199       ) .
      200     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      201   end.
      202   function cur-time-custom  returns character
      203   (input p-prefix as character
      204   ,input p-date-format as character
      205   ,input p-delimiter as character
      206   ,input p-time-format as character
      207   ,input p-suffix as character
      208   )
      209   :
      210     define variable v-date as date      no-undo .
      211     define variable v-time as integer   no-undo .
      212     run cur-time in this-procedure
      213       (output v-date
      214       ,output v-time
      215       ) .
      216     return
      217       p-prefix
      218       + string(v-date, p-date-format)
      219       + p-delimiter
      220       + string(v-time, p-time-format)
      221       + p-suffix
      222       .
      223   end.
      224   function cur-time-print  returns character
      225   :
      226     define variable v-date as date      no-undo .
      227     define variable v-time as integer   no-undo .
      228     run cur-time in this-procedure
      229       (output v-date
      230       ,output v-time
      231       ) .
      232     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      233   end.
      234   function cur-time-datetime returns datetime
      235   :
      236     define variable v-char as character no-undo .
      237     define variable v-datetime as datetime no-undo .
      238     v-char = cur-time-string().
      239     v-datetime = datetime(v-char).
      240     return  v-datetime.
      241   end.
      242   function cur-time-string-msec returns character
      243   :
      244     define variable v-date as datetime  no-undo .
      245     v-date = now.
      246     return string(v-date) .
      247   end.
