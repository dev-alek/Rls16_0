     1000     input Round_M as integer,
     1001     input Round_T as integer,
     1002     input Round_R as integer,
     1003     output C_HN as decimal,
     1004     output C_HN_delta as decimal,
     1005     output C_full as decimal,
     1006     output V_liquid as decimal,
     1007     output V_gas as decimal,
     1008     output M_liquid as decimal,
     1009     output M_gas as decimal,
     1010     output M as decimal,
     1011     output Kf as decimal,
     1012     output DeltaOtn_H as decimal,
     1013     output DeltaOtn_R_liquid as decimal,
     1014     output DeltaOtn_R_gas as decimal,
     1015     output DeltaOtn_M_liquid as decimal,
     1016     output DeltaOtn_M_gas as decimal,
     1017     output DeltaOtn_M as decimal,
     1018     output H_min_liquid as decimal,
     1019     output H_min as decimal,
     1020     output A as decimal,
     1021     output B as decimal,
     1022     output Err as character,
     1023     output Wrn as character,
     1024     output DllVersion as character
     1025     )
     1026   :
     1027     define variable libName as character no-undo .
     1028     define variable hCall   AS handle    no-undo .
     1029     define variable mErr as memptr no-undo .
     1030     define variable mWrn as memptr no-undo .
     1031     define variable mDllVersion as memptr no-undo .
     1032     SET-SIZE(mErr) = 1024 .
     1033     SET-SIZE(mWrn) = 1024 .
     1034     SET-SIZE(mDllVersion) = 20 .
     1035     libName = search("exe/MM.dll") .
     1036     create call hCall.
     1037     assign
     1038       hCall:CALL-NAME      = "MethodCt53"
     1039       hCall:LIBRARY        = libName
     1040       hCall:CALL-TYPE      = DLL-CALL-TYPE
     1041       hCall:NUM-PARAMETERS = 41
     1042     .
     1043     if DeltaOtn_R_liquid_IN = 0.42
     1044     then
     1045       DeltaOtn_R_liquid_IN = DeltaOtn_R_liquid_IN - 0.0000000001
     1046     .
     1047     hCall:SET-PARAMETER(1, "Memptr", "OUTPUT", mErr).
     1048     hCall:SET-PARAMETER(2, "Memptr", "OUTPUT", mWrn).
     1049     hCall:SET-PARAMETER(3, "Memptr", "OUTPUT", mDllVersion).
