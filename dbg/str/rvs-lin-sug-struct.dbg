     1543     release rvs-line-attr no-error .
     1544     v-proc = "CMethodOfMetering55" .
     1545     MM55
     1546       (
     1547       input f-dens15 * 1000,
     1548       input p-temp,
     1549       input 2,
     1550       input 2,
     1551       output R,
     1552       output CTL,
     1553       output vErr,
     1554       output vWrn,
     1555       output vDllVersion
     1556       )
     1557     .
     1558     OUTPUT stream outstream to value ("pomi.log") append.
     1559     PUT STREAM outstream unformatted
     1560         "    " SKIP
     1561         "    " SKIP
     1562         cur-time-string()           FORMAT "x(16)"    SKIP
     1563         'Процедура             '    v-proc   SKIP
     1564         'CODE_PL                = ' p-pl-code                           SKIP
     1565         'R15                    = ' f-dens15 * 1000                 SKIP
     1566         'T                      = ' p-temp                                  SKIP
     1567         'Round_R                = ' 2                                   SKIP
     1568         'Round_T                = ' 2                                   SKIP
     1569             SKIP SKIP
     1570     .
     1571     output stream outstream close.
     1572     if trim(vErr) > "" then do :
     1573       error-string = vErr .
     1574       output stream outstream to value ("pomi.log")  append.
     1575       put stream outstream error-string format "X(1024)" skip.
     1576       output stream outstream close.
     1577       message substitute('Ошибка работы библиотеки ПОкМИ &1',error-string) view-as alert-box .
     1578       return .
     1579     end.
     1580     else do :
     1581       p-dens = round(R / 1000, 4) .
     1582       OUTPUT stream outstream to value ("pomi.log")  append.
     1583       PUT STREAM outstream unformatted
     1584           "R   = " R  SKIP
     1585           "CTL = " CTL  SKIP
     1586           "Warnings = " vWrn SKIP
     1587           'Версия dll: '   vDllVersion  SKIP
     1588       .
     1589       OUTPUT stream outstream close.
     1590     end .
     1591     if p-dens = ?
     1592     or p-dens <= 0
     1593     then do :
     1594       message substitute( "Ошибка расчета. Метод 55 ПОкМИ вернул отрицательное значение (&1) плотности ЖФ при рабочих условиях!", trim(string(p-dens, "->>>>>>9.99<<<<<"))) view-as alert-box .
     1595       return .
     1596     end .
     1597     v-proc = "CMethodOfMetering56" .
     1598     for each buf_sug-struct no-lock by buf_sug-struct.ii :
     1599       M[buf_sug-struct.ii + 1] = buf_sug-struct.val_ .
     1600       mmM = mmM + ";" + string(buf_sug-struct.val_, ">>>>9.99<<") .
     1601     end .
     1602     mmM = trim(mmM, ";") .
     1603     MM56
     1604       (
     1605       input if r-struct-type = 1 then 0 else 1,
     1606       input M,
     1607       input p-temp,
     1608       input cb-p_type,
     1609       input p-press,
     1610       input f-atm-pressure,
     1611       input f-mmass-pseudo,
     1612       input f-dens-pseudo,
     1613       input 2,
     1614       input 2,
     1615       output R,
     1616       output P_vapor,
     1617       output vErr,
     1618       output vWrn,
     1619       output vDllVersion
     1620       )
     1621     .
     1622     OUTPUT stream outstream to value ("pomi.log") append.
     1623     PUT STREAM outstream unformatted
     1624                 "    " SKIP
     1625                 "    " SKIP
     1626                 cur-time-string()           FORMAT "x(16)"    SKIP
     1627                 'Процедура             '    v-proc   SKIP
     1628                 'CODE_PL                = ' p-pl-code                           SKIP
     1629                 'M_type                 = ' if r-struct-type = 1 then 0 else 1                  SKIP
     1630                 'M                      = ' mmM                  SKIP
     1631                 'T                      = ' p-temp                       SKIP
     1632                 'P_type                 = ' cb-p_type                       SKIP
     1633                 'P_extra                = ' p-press                       SKIP
     1634                 'P_atmosphere           = ' f-atm-pressure                       SKIP
     1635                 'M_pseudo               = ' f-mmass-pseudo                      SKIP
     1636                 'R_pseudo               = ' f-dens-pseudo                      SKIP
     1637                 'Round_T                = ' 2                                   SKIP
     1638                 'Round_R                = ' 2                                   SKIP
     1639                     SKIP SKIP
     1640     .
     1641     output stream outstream close.
     1642     if trim(vErr) > "" then do :
     1643       error-string = vErr .
     1644       output stream outstream to value ("pomi.log")  append.
     1645       put stream outstream error-string format "X(1024)" skip.
     1646       output stream outstream close.
     1647       message substitute('Ошибка работы библиотеки ПОкМИ &1',error-string) view-as alert-box .
     1648       return .
     1649     end.
     1650     else do :
     1651       p-dens-pf = round(R / 1000, 4) .
     1652       OUTPUT stream outstream to value ("pomi.log")  append.
     1653       PUT STREAM outstream unformatted
     1654           "R   = " R  SKIP
     1655           "P_Vapor = " P_Vapor  SKIP
     1656           "Warnings = " vWrn SKIP
     1657           'Версия dll: '              vDllVersion  SKIP
     1658       .
     1659       OUTPUT stream outstream close.
     1660       if p-dens-pf < 0
     1661       then do :
     1662         find first buf_place no-lock where buf_place.obj-type = p-obj-type
     1663                                        and buf_place.obj-code = p-obj-code
     1664                                        and buf_place.pl-code = p-pl-code
     1665                                        no-error .
     1666         find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     1667         if available buf_place
     1668         and available buf_goods
     1669         then do :
     1670           message
     1671             "Ошибка при заполнении данных!" skip
     1672             "Для резервуара " string(buf_place.pl-code) " (" buf_place.loc1 "  " buf_goods.gds-name ") не определено значение плотности ПГФ. Сохранение результатов расчёта невозможно." skip
     1673             "Проверьте внесённый компонентный состав СУГ."
     1674           view-as alert-box .
     1675           return .
     1676         end .
     1677         else do :
     1678           message "Ошибка при заполнении данных! Проверьте внесённый компонентный состав СУГ." view-as alert-box .
     1679           return .
     1680         end .
     1681       end .
     1682     end .
     1683     p-ok = true .
     1684   end .
     1685   on value-changed of cb-p_type in frame dialog-frame
     1686   do:
     1687     assign cb-p_type .
     1688     if cb-p_type = 0
     1689     then do :
     1690       assign f-atm-pressure = 0.101325 .
     1691       display f-atm-pressure with frame dialog-frame .
     1692       disable f-atm-pressure with frame dialog-frame .
     1693     end .
     1694     else do :
     1695       assign f-atm-pressure = 0.0 .
     1696       display f-atm-pressure with frame dialog-frame .
     1697       enable f-atm-pressure with frame dialog-frame .
     1698     end .
     1699   end .
     1700   on value-changed of r-struct-type in frame dialog-frame
     1701   do:
     1702     define variable vOk as logical no-undo .
     1703     define variable v-old-val as integer no-undo .
     1704     define buffer buf_tt-sug-struct for tt-sug-struct .
     1705     v-old-val = r-struct-type .
     1706     if enter-error
     1707     then do :
     1708       r-struct-type:screen-value in frame dialog-frame = string(v-old-val) .
     1709       display r-struct-type with frame dialog-frame .
     1710       enter-error = false .
     1711       return .
     1712     end .
     1713     for first buf_tt-sug-struct no-lock where buf_tt-sug-struct.val_ > 0 :
     1714       message "Изменения типа приведет к сбросу введенных данных." skip "Продолжить?"
     1715       view-as alert-box question buttons yes-no update vOk .
     1716       if not vOk
     1717       then do :
     1718         r-struct-type:screen-value in frame dialog-frame = string(v-old-val) .
     1719         display r-struct-type with frame dialog-frame .
     1720         return no-apply .
     1721       end .
     1722     end .
     1723     assign r-struct-type.
     1724     for each tt-sug-struct :
     1725       tt-sug-struct.val_ = 0.0 .
     1726     end .
     1727     br-sug-struct:refresh() .
     1728     if r-struct-type = 1
     1729     then do :
     1730       br-sug-struct:SELECT-ROW (1).
     1731       do while available tt-sug-struct :
     1732         tt-sug-struct.val_:format in browse br-sug-struct = "9.9999" .
     1733         if tt-sug-struct.ii = 15 then leave .
     1734         br-sug-struct:SELECT-NEXT-ROW ( ).
     1735       end .
     1736     end .
     1737     else
     1738     if r-struct-type = 2
     1739     then do :
     1740       br-sug-struct:SELECT-ROW (1).
     1741       do while available tt-sug-struct :
     1742         tt-sug-struct.val_:format in browse br-sug-struct = ">>9.99" .
     1743         if tt-sug-struct.ii = 15 then leave .
     1744         br-sug-struct:SELECT-NEXT-ROW ( ).
     1745       end .
     1746     end .
     1747   end.
     1748   on return of tt-sug-struct.val_ in browse br-sug-struct
     1749   do :
     1750     apply "leave" to self .
     1751   end .
     1752   on leave of tt-sug-struct.val_ in browse br-sug-struct
     1753   do :
     1754     define buffer buf_sug-struct for tt-sug-struct .
     1755     define variable val-sum   as decimal no-undo .
     1756     define variable v-msg     as character no-undo .
     1757     define variable v-max-val as decimal no-undo .
     1758     enter-error = false .
     1759     if r-struct-type = 1
     1760     then
     1761       v-max-val = 1
     1762     .
     1763     else
     1764     if r-struct-type = 2
     1765     then
     1766       v-max-val = 100
     1767     .
     1768     if decimal(tt-sug-struct.val_:screen-value in browse br-sug-struct) > v-max-val
     1769     then do :
     1770       enter-error = true .
     1771       message "Неверное значение!" view-as alert-box .
     1772       tt-sug-struct.val_ = 0 .
     1773       display tt-sug-struct.val_ with browse br-sug-struct .
     1774       return .
     1775     end .
     1776     for each buf_sug-struct no-lock where buf_sug-struct.ii <> tt-sug-struct.ii :
     1777       val-sum = val-sum + buf_sug-struct.val_ .
     1778     end .
     1779     val-sum = val-sum + decimal(tt-sug-struct.val_:screen-value in browse br-sug-struct) .
     1780     if val-sum > v-max-val
     1781     then do :
     1782       if r-struct-type = 1
     1783       then
     1784         v-msg = substitute('Сумма значений полей "молярная доля" не должно превышать 1. Текущее значение - &1. Исправьте введенное значение.', string(val-sum) )
     1785       .
     1786       else
     1787       if r-struct-type = 2
     1788       then
     1789         v-msg = substitute('Сумма значений полей "массовая доля" не должно превышать 100%. Текущее значение - &1. Исправьте введенное значение.', string(val-sum) )
     1790       .
     1791       message v-msg view-as alert-box .
     1792       return no-apply .
     1793     end .
     1794   end .
     1795   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1796   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1797   MAIN-BLOCK:
     1798   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1799      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1800     p-ok = false .
     1801     for first rvs-line-attr no-lock
     1802          where rvs-line-attr.obj-code  = p-obj-code
     1803            and rvs-line-attr.obj-type  = p-obj-type
     1804            and rvs-line-attr.gds-code  = p-gds-code
     1805            and rvs-line-attr.pl-code   = p-pl-code
     1806            and rvs-line-attr.rvs-code  = p-rvs-code
     1807            and rvs-line-attr.attr-code = "atm-pressure"
     1808            :
     1809       f-atm-pressure = decimal(rvs-line-attr.attr-value) .
     1810     end .
     1811     for first rvs-line-attr no-lock
     1812          where rvs-line-attr.obj-code  = p-obj-code
     1813            and rvs-line-attr.obj-type  = p-obj-type
     1814            and rvs-line-attr.gds-code  = p-gds-code
     1815            and rvs-line-attr.pl-code   = p-pl-code
     1816            and rvs-line-attr.rvs-code  = p-rvs-code
     1817            and rvs-line-attr.attr-code = "dens-pseudo"
     1818            :
     1819       f-dens-pseudo = decimal(rvs-line-attr.attr-value) .
     1820     end .
     1821     for first rvs-line-attr no-lock
     1822          where rvs-line-attr.obj-code  = p-obj-code
     1823            and rvs-line-attr.obj-type  = p-obj-type
     1824            and rvs-line-attr.gds-code  = p-gds-code
     1825            and rvs-line-attr.pl-code   = p-pl-code
     1826            and rvs-line-attr.rvs-code  = p-rvs-code
     1827            and rvs-line-attr.attr-code = "dens15"
     1828            :
     1829       f-dens15 = decimal(rvs-line-attr.attr-value) .
     1830     end .
     1831     for first rvs-line-attr no-lock
     1832          where rvs-line-attr.obj-code  = p-obj-code
     1833            and rvs-line-attr.obj-type  = p-obj-type
     1834            and rvs-line-attr.gds-code  = p-gds-code
     1835            and rvs-line-attr.pl-code   = p-pl-code
     1836            and rvs-line-attr.rvs-code  = p-rvs-code
     1837            and rvs-line-attr.attr-code = "mmass-pseudo"
     1838            :
     1839       f-mmass-pseudo = decimal(rvs-line-attr.attr-value) .
     1840     end .
     1841     for first rvs-line-attr no-lock
     1842          where rvs-line-attr.obj-code  = p-obj-code
     1843            and rvs-line-attr.obj-type  = p-obj-type
     1844            and rvs-line-attr.gds-code  = p-gds-code
     1845            and rvs-line-attr.pl-code   = p-pl-code
     1846            and rvs-line-attr.rvs-code  = p-rvs-code
     1847            and rvs-line-attr.attr-code = "struct-type"
     1848            :
     1849       r-struct-type = integer(rvs-line-attr.attr-value) .
     1850     end .
     1851     for first rvs-line-attr no-lock
     1852          where rvs-line-attr.obj-code  = p-obj-code
     1853            and rvs-line-attr.obj-type  = p-obj-type
     1854            and rvs-line-attr.gds-code  = p-gds-code
     1855            and rvs-line-attr.pl-code   = p-pl-code
     1856            and rvs-line-attr.rvs-code  = p-rvs-code
     1857            and rvs-line-attr.attr-code = "p_type"
     1858            :
     1859       cb-p_type = integer(rvs-line-attr.attr-value) .
     1860     end .
     1861     run fill-tt .
     1862     RUN enable_UI.
     1863     if cb-p_type = 0
     1864     then do :
     1865       assign f-atm-pressure = 0.101325 .
     1866       display f-atm-pressure with frame dialog-frame .
     1867       disable f-atm-pressure with frame dialog-frame .
     1868     end .
     1869     assign r-struct-type .
     1870     if r-struct-type = 1
     1871     then do :
     1872       br-sug-struct:SELECT-ROW (1).
     1873       do while available tt-sug-struct :
     1874         tt-sug-struct.val_:format in browse br-sug-struct = "9.9999" .
     1875         if tt-sug-struct.ii = 15 then leave .
     1876         br-sug-struct:SELECT-NEXT-ROW ( ).
     1877       end .
     1878     end .
     1879     else
     1880     if r-struct-type = 2
     1881     then do :
     1882       br-sug-struct:SELECT-ROW (1).
     1883       do while available tt-sug-struct :
     1884         tt-sug-struct.val_:format in browse br-sug-struct = ">>9.99" .
     1885         if tt-sug-struct.ii = 15 then leave .
     1886         br-sug-struct:SELECT-NEXT-ROW ( ).
     1887       end .
     1888     end .
     1889     get first br-sug-struct .
     1890     WAIT-FOR GO OF FRAME Dialog-Frame.
     1891   END.
     1892   RUN disable_UI.
     1893   procedure fill-tt :
     1894     find first tt-sug-struct no-error .
     1895     if available tt-sug-struct
     1896     then return .
     1897     create tt-sug-struct .
     1898     assign
     1899       tt-sug-struct.ii      = 0
     1900       tt-sug-struct.key_    = "метан"
     1901     .
     1902     create tt-sug-struct .
     1903     assign
     1904       tt-sug-struct.ii      = 1
     1905       tt-sug-struct.key_    = "этан"
     1906     .
     1907     create tt-sug-struct .
     1908     assign
     1909       tt-sug-struct.ii      = 2
     1910       tt-sug-struct.key_    = "пропан"
     1911     .
     1912     create tt-sug-struct .
     1913     assign
     1914       tt-sug-struct.ii      = 3
     1915       tt-sug-struct.key_    = "н-бутан"
     1916     .
     1917     create tt-sug-struct .
     1918     assign
     1919       tt-sug-struct.ii      = 4
     1920       tt-sug-struct.key_    = "и-бутан"
     1921     .
     1922     create tt-sug-struct .
     1923     assign
     1924       tt-sug-struct.ii      = 5
     1925       tt-sug-struct.key_    = "н-пентан"
     1926     .
     1927     create tt-sug-struct .
     1928     assign
     1929       tt-sug-struct.ii      = 6
     1930       tt-sug-struct.key_    = "и-пентан"
     1931     .
     1932     create tt-sug-struct .
     1933     assign
     1934       tt-sug-struct.ii      = 7
     1935       tt-sug-struct.key_    = "н-гексан"
     1936     .
     1937     create tt-sug-struct .
     1938     assign
     1939       tt-sug-struct.ii      = 8
     1940       tt-sug-struct.key_    = "н-гептан"
     1941     .
     1942     create tt-sug-struct .
     1943     assign
     1944       tt-sug-struct.ii      = 9
     1945       tt-sug-struct.key_    = "н-октан"
     1946     .
     1947     create tt-sug-struct .
     1948     assign
     1949       tt-sug-struct.ii      = 10
     1950       tt-sug-struct.key_    = "н-нонан"
     1951     .
     1952     create tt-sug-struct .
     1953     assign
     1954       tt-sug-struct.ii      = 11
     1955       tt-sug-struct.key_    = "н-декан"
     1956     .
     1957     create tt-sug-struct .
     1958     assign
     1959       tt-sug-struct.ii      = 12
     1960       tt-sug-struct.key_    = "азот"
     1961     .
     1962     create tt-sug-struct .
     1963     assign
     1964       tt-sug-struct.ii      = 13
     1965       tt-sug-struct.key_    = "диоксид углерода"
     1966     .
     1967     create tt-sug-struct .
     1968     assign
     1969       tt-sug-struct.ii      = 14
     1970       tt-sug-struct.key_    = "Сероводород"
     1971     .
     1972     create tt-sug-struct .
     1973     assign
     1974       tt-sug-struct.ii      = 15
     1975       tt-sug-struct.key_    = "Псевдокомпонент"
     1976     .
     1977   end procedure .
     1978   PROCEDURE disable_UI :
     1979     HIDE FRAME Dialog-Frame.
     1980   END PROCEDURE.
     1981   PROCEDURE enable_UI :
     1982     DISPLAY f-dens15 f-atm-pressure r-struct-type f-mmass-pseudo f-dens-pseudo cb-p_type
     1983         WITH FRAME Dialog-Frame.
     1984     ENABLE b-cancel b-save f-dens15 f-atm-pressure r-struct-type f-mmass-pseudo cb-p_type
     1985            f-dens-pseudo br-sug-struct
     1986         WITH FRAME Dialog-Frame.
     1987     VIEW FRAME Dialog-Frame.
     1988     open query br-sug-struct for each tt-sug-struct .
     1989   END PROCEDURE.
