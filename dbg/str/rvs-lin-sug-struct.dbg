     1237   end .
     1238   define stream outstream.
     1239   define variable error-string as character no-undo .
     1240   define variable enter-error as logical no-undo .
     1241   define buffer buf_place for ub.place .
     1242   define buffer buf_goods for ub.goods .
     1243   DEFINE BUTTON b-cancel AUTO-END-KEY
     1244        LABEL "Выход"
     1245        SIZE 15 BY 1.14
     1246        BGCOLOR 8 .
     1247   DEFINE BUTTON b-save AUTO-GO
     1248        LABEL "Сохранить"
     1249        SIZE 15 BY 1.14
     1250        BGCOLOR 8 .
     1251   DEFINE VARIABLE f-atm-pressure AS DECIMAL FORMAT ">>>>>9.999999":U INITIAL 0
     1252        LABEL "Атмосферное давление, МПа"
     1253        VIEW-AS FILL-IN
     1254        SIZE 14 BY 1 NO-UNDO.
     1255   DEFINE VARIABLE f-dens-pseudo AS DECIMAL FORMAT ">>>>>9.9999":U INITIAL 0
     1256        LABEL "Плотность, кг/м3"
     1257        VIEW-AS FILL-IN
     1258        SIZE 14 BY 1 NO-UNDO.
     1259   DEFINE VARIABLE f-dens15 AS DECIMAL FORMAT "9.9999":U INITIAL 0
     1260        LABEL "Плотность ЖФ при 15°C, г/см3"
     1261        VIEW-AS FILL-IN
     1262        SIZE 14 BY 1 NO-UNDO.
     1263   DEFINE VARIABLE f-mmass-pseudo AS DECIMAL FORMAT ">>>>>9.9999":U INITIAL 0
     1264        LABEL "Молярная масса, кг/кмоль"
     1265        VIEW-AS FILL-IN
     1266        SIZE 14 BY 1 NO-UNDO.
     1267   DEFINE VARIABLE r-struct-type AS INTEGER
     1268        VIEW-AS RADIO-SET HORIZONTAL
     1269        RADIO-BUTTONS
     1270             "Молярные доли", 1,
     1271   "Массовые доли", 2
     1272        SIZE 43 BY .86 NO-UNDO.
     1273   define variable cb-p_type as integer init 0
     1274      LABEL "Измеряемое давление"
     1275      VIEW-AS COMBO-BOX INNER-LINES 2
     1276      LIST-ITEM-PAIRS "избыточное",0,
     1277      "абсолютное",1
     1278      DROP-DOWN-LIST
     1279      SIZE 14 BY 1 NO-UNDO.
     1280   define query br-sug-struct for tt-sug-struct .
     1281   define browse br-sug-struct query br-sug-struct exclusive-lock
     1282     display
     1283       tt-sug-struct.ii           label "ID " format ">>9"
     1284       tt-sug-struct.key_         label "Компонент" format "X(20)"
     1285       tt-sug-struct.val_         label "Доля" width 15
     1286     enable
     1287       tt-sug-struct.val_
     1288     with size 45 by 16 separators
     1289   .
     1290   DEFINE FRAME Dialog-Frame
     1291        b-cancel AT ROW 1.24 COL 2
     1292        b-save AT ROW 1.24 COL 17
     1293        cb-p_type AT ROW 3 COL 33 COLON-ALIGNED WIDGET-ID 16
     1294        f-dens15 AT ROW 4 COL 33 COLON-ALIGNED WIDGET-ID 2
     1295        f-atm-pressure AT ROW 5 COL 33 COLON-ALIGNED WIDGET-ID 4
     1296        r-struct-type AT ROW 6 COL 2 NO-LABEL WIDGET-ID 6
     1297        br-sug-struct AT ROW 7 COL 2
     1298        f-mmass-pseudo AT ROW 24 COL 29.2 COLON-ALIGNED WIDGET-ID 12
     1299        f-dens-pseudo AT ROW 25 COL 29.2 COLON-ALIGNED WIDGET-ID 10
     1300        "Псевдокомпонент:" VIEW-AS TEXT
     1301             SIZE 23.4 BY .75 AT ROW 23.2 COL 8 WIDGET-ID 14
     1302             FONT 6
     1303        SPACE(1) SKIP(1)
     1304       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1305            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1306            TITLE "Параметры для расчета плотности СУГ по РВД"
     1307            DEFAULT-BUTTON b-save CANCEL-BUTTON b-cancel WIDGET-ID 100.
     1308   ASSIGN
     1309          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1310          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1311   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1312   DO:
     1313     APPLY "END-ERROR":U TO SELF.
     1314   END.
     1315   on choose of b-save in frame Dialog-Frame
     1316   do :
     1317     define buffer buf_sug-struct for tt-sug-struct .
     1318     define variable val-sum   as decimal no-undo .
     1319     define variable v-msg     as character no-undo .
     1320     define variable v-max-val as decimal no-undo .
     1321     define variable v-mm55 as component-handle no-undo .
     1322     define variable v-mm56 as component-handle no-undo .
     1323     define variable mmM    as character no-undo .
     1324     define variable v-sug-struct-val as character no-undo .
     1325     define variable v-proc as character no-undo .
     1326     define variable M as decimal extent 16 .
     1327     define variable R as decimal no-undo .
     1328     define variable CTL as decimal no-undo .
     1329     define variable P_vapor as decimal no-undo .
     1330     define variable vErr as character no-undo .
     1331     define variable vWrn as character no-undo .
     1332     define variable vDllVersion as character no-undo .
     1333     assign
     1334       r-struct-type
     1335       f-dens15
     1336       f-atm-pressure
     1337       f-dens-pseudo
     1338       f-mmass-pseudo
     1339       cb-p_type
     1340     .
     1341     if f-dens15 = ?
     1342     or f-dens15 = 0
     1343     then do :
     1344       message "Не указано значение для плотности ЖФ при 15°С. Сохранение невозможно." view-as alert-box .
     1345       return no-apply .
     1346     end .
     1347     if f-dens15 < 0.5
     1348     or f-dens15 > 0.8
     1349     then do :
     1350       message "Внесённое значение плотности ЖФ при 15°С выходит за рамки допустимого диапазона (0,500 - 0,800). Сохранение невозможно. Проверьте внесённое значение плотности ЖФ при 15°С." view-as alert-box .
     1351       return no-apply .
     1352     end .
     1353     if f-atm-pressure = ?
     1354     or f-atm-pressure = 0
     1355     then do :
     1356       message "Не указано значение для атмосферного давления. Сохранение невозможно." view-as alert-box .
     1357       return no-apply .
     1358     end .
     1359     if r-struct-type = 1
     1360     then
     1361       v-max-val = 1
     1362     .
     1363     else
     1364     if r-struct-type = 2
     1365     then
     1366       v-max-val = 100
     1367     .
     1368     for each buf_sug-struct no-lock :
     1369       val-sum = val-sum + buf_sug-struct.val_ .
     1370     end .
     1371     if val-sum <> v-max-val
