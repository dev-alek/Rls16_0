      376     hCall:SET-PARAMETER(55, "DOUBLE", "OUTPUT", DeltaOtn_M).
      377     hCall:SET-PARAMETER(56, "DOUBLE", "OUTPUT", VolumetricExpansion).
      378     hCall:INVOKE( ).
      379     Err = get-string(mErr, 1, 1024) .
      380     Wrn = get-string(mWrn, 1, 1024) .
      381     DllVersion = get-string(mDllVersion, 1, 20) .
      382     delete object hCall.
