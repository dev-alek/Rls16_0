     1052     hCall:SET-PARAMETER(6, "DOUBLE", "INPUT", T).
     1053     hCall:SET-PARAMETER(7, "DOUBLE", "INPUT", R_liquid).
     1054     hCall:SET-PARAMETER(8, "DOUBLE", "INPUT", R_gas).
     1055     hCall:SET-PARAMETER(9, "DOUBLE", "INPUT", A_Reservoir).
     1056     hCall:SET-PARAMETER(10, "DOUBLE", "INPUT", DeltaOtn_K).
     1057     hCall:SET-PARAMETER(11, "DOUBLE", "INPUT", DeltaOtn_K_full).
     1058     hCall:SET-PARAMETER(12, "DOUBLE", "INPUT", DeltaAbs_H).
     1059     hCall:SET-PARAMETER(13, "DOUBLE", "INPUT", DeltaAbs_R_liquid).
     1060     hCall:SET-PARAMETER(14, "DOUBLE", "INPUT", DeltaAbs_R_gas).
     1061     hCall:SET-PARAMETER(15, "SHORT", "INPUT", Use_DeltaOtn_R_liquid_IN).
     1062     hCall:SET-PARAMETER(16, "DOUBLE", "INPUT", DeltaOtn_R_liquid_IN).
     1063     hCall:SET-PARAMETER(17, "DOUBLE", "INPUT", DeltaOtn_N).
     1064     hCall:SET-PARAMETER(18, "LONG", "INPUT", Round_M).
     1065     hCall:SET-PARAMETER(19, "LONG", "INPUT", Round_T).
     1066     hCall:SET-PARAMETER(20, "LONG", "INPUT", Round_R).
     1067     hCall:SET-PARAMETER(21, "LONG", "INPUT", 1024).
     1068     hCall:SET-PARAMETER(22, "LONG", "INPUT", 1024).
     1069     hCall:SET-PARAMETER(23, "DOUBLE", "OUTPUT", C_HN).
     1070     hCall:SET-PARAMETER(24, "DOUBLE", "OUTPUT", C_HN_delta).
     1071     hCall:SET-PARAMETER(25, "DOUBLE", "OUTPUT", C_full).
     1072     hCall:SET-PARAMETER(26, "DOUBLE", "OUTPUT", V_liquid).
     1073     hCall:SET-PARAMETER(27, "DOUBLE", "OUTPUT", V_gas).
     1074     hCall:SET-PARAMETER(28, "DOUBLE", "OUTPUT", M_liquid).
     1075     hCall:SET-PARAMETER(29, "DOUBLE", "OUTPUT", M_gas).
     1076     hCall:SET-PARAMETER(30, "DOUBLE", "OUTPUT", M).
     1077     hCall:SET-PARAMETER(31, "DOUBLE", "OUTPUT", Kf).
     1078     hCall:SET-PARAMETER(32, "DOUBLE", "OUTPUT", DeltaOtn_H).
     1079     hCall:SET-PARAMETER(33, "DOUBLE", "OUTPUT", DeltaOtn_R_liquid).
     1080     hCall:SET-PARAMETER(34, "DOUBLE", "OUTPUT", DeltaOtn_R_gas).
     1081     hCall:SET-PARAMETER(35, "DOUBLE", "OUTPUT", DeltaOtn_M_liquid).
     1082     hCall:SET-PARAMETER(36, "DOUBLE", "OUTPUT", DeltaOtn_M_gas).
     1083     hCall:SET-PARAMETER(37, "DOUBLE", "OUTPUT", DeltaOtn_M).
     1084     hCall:SET-PARAMETER(38, "DOUBLE", "OUTPUT", H_min_liquid).
     1085     hCall:SET-PARAMETER(39, "DOUBLE", "OUTPUT", H_min).
     1086     hCall:SET-PARAMETER(40, "DOUBLE", "OUTPUT", A).
     1087     hCall:SET-PARAMETER(41, "DOUBLE", "OUTPUT", B).
     1088     hCall:INVOKE( ).
     1089     Err = get-string(mErr, 1, 1024) .
     1090     Wrn = get-string(mWrn, 1, 1024) .
     1091     DllVersion = get-string(mDllVersion, 1, 20) .
     1092     delete object hCall.
     1093   end .
