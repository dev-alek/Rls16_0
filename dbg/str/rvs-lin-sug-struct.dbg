     1198   function MM57 returns logical
     1199     (
     1200     input H as decimal,
     1201     input ToolType as integer,
     1202     output DeltaAbs_H as decimal,
     1203     output Err as character,
     1204     output Wrn as character,
     1205     output DllVersion as character
     1206     )
     1207   :
     1208     define variable libName as character no-undo .
