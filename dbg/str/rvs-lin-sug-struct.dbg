     1225     hCall:SET-PARAMETER(2, "Memptr", "OUTPUT", mWrn).
     1226     hCall:SET-PARAMETER(3, "Memptr", "OUTPUT", mDllVersion).
     1227     hCall:SET-PARAMETER(4, "DOUBLE", "INPUT", H).
     1228     hCall:SET-PARAMETER(5, "LONG", "INPUT", ToolType).
     1229     hCall:SET-PARAMETER(6, "LONG", "INPUT", 1024).
     1230     hCall:SET-PARAMETER(7, "LONG", "INPUT", 1024).
