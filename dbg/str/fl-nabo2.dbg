        1   DEFINE TEMP-TABLE tt-doc-line-attr NO-UNDO LIKE ub.doc-line-attr
        2          field node-code as int
        3          field bk-gds-code as int.
        4   define input  parameter   parParentProc  as widget-handle no-undo.
        5   define input  parameter   p-doc-mode  as character no-undo .
        6   define input  parameter   p-doc-code  as character no-undo .
        7   define input  parameter   p-gds-code  as integer   no-undo .
        8   define input  parameter   p-prt-code  as integer   no-undo .
        9   define output parameter   p-make      as logical   no-undo .
       10   define variable g#mainmenu-handle as widget-handle no-undo.
       11   g#mainmenu-handle = parParentProc .
       12   define new shared variable prt-rec   as recid no-undo .
       13   define new shared variable line-mode as character no-undo .
       14   define new shared variable line-rec  as recid no-undo .
       15   define new shared variable gds-rec   as recid no-undo .
       16   define variable vss-revision    as character no-undo init "$Revision$":U .
       17   define variable vss-author      as character no-undo init "$Author$":U .
       18   define variable vss-date        as character no-undo init "$Date$":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       20   define variable vss-archive     as character no-undo init "$Archive$":U .
       21   define variable vss-description as character no-undo init "В какие наборы входит товар".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define new global shared variable g#lib-trn  as handle no-undo .
       83   define new global shared variable g#lib-trn2 as handle no-undo .
       84   define new global shared variable g#lib-trn3 as handle no-undo .
       85   define new global shared variable g#lib-trn4 as handle no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure lineattr-value :
       88     do
       89     on error undo, return error return-value
       90     :
       91       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
       92       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
       93       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
       94       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
       95       define output parameter p-type     as character no-undo .
       96       define buffer buf_doc-line-attr for ub.doc-line-attr .
       97       def var v-format         as character no-undo .
       98       def var v-fillin_width   as integer   no-undo .
       99       def var v-fillin_height  as integer   no-undo .
      100       def var v-label          as character no-undo .
      101       def var v-user-can-edit  as logical   no-undo .
      102       def var v-output-display as logical   no-undo .
      103       def var v-other          as character no-undo .
      104       run lineattr-code in this-procedure
      105         (input  p-code
      106         ,output p-type
      107         ,output v-format
      108         ,output v-fillin_width
      109         ,output v-fillin_height
      110         ,output v-label
      111         ,output v-user-can-edit
      112         ,output v-output-display
      113         ,output v-other
      114         ) no-error .
      115       if error-status :error then do:
      116         undo, return error return-value .
      117       end.
      118       find first buf_doc-line-attr no-lock
      119         where buf_doc-line-attr.doc-code  = p-doc-code
      120           and buf_doc-line-attr.gds-code  = p-gds-code
      121           and buf_doc-line-attr.attr-code = p-code
      122         no-error .
      123       if avail buf_doc-line-attr then do:
      124         assign
      125           p-value =  buf_doc-line-attr.attr-value
      126         .
      127       end.
      128       else do:
      129         assign
      130           p-value = if p-type = 'L':U then "no":U else ""
      131         .
      132       end.
      133     end.
      134   end procedure.
      135   procedure lineattr-write :
      136     do
      137     on error undo, return error return-value
      138     :
      139       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      140       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      141       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      142       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      143       define buffer buf_doc-line-attr for ub.doc-line-attr .
      144       def var v-type           as character no-undo .
      145       def var v-format         as character no-undo .
      146       def var v-fillin_width   as integer   no-undo .
      147       def var v-fillin_height  as integer   no-undo .
      148       def var v-label          as character no-undo .
      149       def var v-user-can-edit  as logical   no-undo .
      150       def var v-output-display as logical   no-undo .
      151       def var v-other          as character no-undo .
      152       run lineattr-code in this-procedure
      153         (input  p-code
      154         ,output v-type
      155         ,output v-format
      156         ,output v-fillin_width
      157         ,output v-fillin_height
      158         ,output v-label
      159         ,output v-user-can-edit
      160         ,output v-output-display
      161         ,output v-other
      162         ) no-error .
      163       if error-status :error then do:
      164         undo, return error return-value .
      165       end.
      166       find first buf_doc-line-attr exclusive-lock
      167         where buf_doc-line-attr.doc-code  = p-doc-code
      168           and buf_doc-line-attr.gds-code  = p-gds-code
      169           and buf_doc-line-attr.attr-code = p-code
      170         no-error .
      171       if not available buf_doc-line-attr then do:
      172         create buf_doc-line-attr .
      173         assign
      174           buf_doc-line-attr.doc-code  = p-doc-code
      175           buf_doc-line-attr.gds-code = p-gds-code
      176           buf_doc-line-attr.attr-code = p-code
      177         .
      178       end.
      179       assign
      180         buf_doc-line-attr.attr-value = p-value
      181       .
      182        release buf_doc-line-attr.
      183     end.
      184   end procedure.
      185   procedure lineattr-exist :
      186     do
      187     on error undo, return error return-value
      188     :
      189       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      190       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      191       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      192       define output parameter p-exist   as logical  no-undo .
      193       define buffer buf_doc-line-attr for ub.doc-line-attr .
      194       def var v-type           as character no-undo .
      195       def var v-format         as character no-undo .
      196       def var v-fillin_width   as integer   no-undo .
      197       def var v-fillin_height  as integer   no-undo .
      198       def var v-label          as character no-undo .
      199       def var v-user-can-edit  as logical   no-undo .
      200       def var v-output-display as logical   no-undo .
      201       def var v-other          as character no-undo .
      202       run lineattr-code in this-procedure
      203         (input  p-code
      204         ,output v-type
      205         ,output v-format
      206         ,output v-fillin_width
      207         ,output v-fillin_height
      208         ,output v-label
      209         ,output v-user-can-edit
      210         ,output v-output-display
      211         ,output v-other
      212         ) no-error .
      213       if error-status :error then do:
      214         undo, return error return-value .
      215       end.
      216       find first buf_doc-line-attr no-lock
      217         where buf_doc-line-attr.doc-code  = p-doc-code
      218           and buf_doc-line-attr.gds-code = p-gds-code
      219           and buf_doc-line-attr.attr-code = p-code
      220         no-error .
      221       if  available buf_doc-line-attr then do:
      222         p-exist = yes.
      223       end.
      224     end.
      225   end procedure.
      226   procedure lineattr-delete :
      227     do
      228     on error undo, return error return-value
      229     :
      230       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      231       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      232       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      233       define output parameter p-deleted  as logical no-undo.
      234       define buffer buf_doc-line-attr for ub.doc-line-attr .
      235       def var v-type           as character no-undo .
      236       def var v-format         as character no-undo .
      237       def var v-fillin_width   as integer   no-undo .
      238       def var v-fillin_height  as integer   no-undo .
      239       def var v-label          as character no-undo .
      240       def var v-user-can-edit  as logical   no-undo .
      241       def var v-output-display as logical   no-undo .
      242       def var v-other          as character no-undo .
      243       run lineattr-code in this-procedure
      244         (input  p-code
      245         ,output v-type
      246         ,output v-format
      247         ,output v-fillin_width
      248         ,output v-fillin_height
      249         ,output v-label
      250         ,output v-user-can-edit
      251         ,output v-output-display
      252         ,output v-other
      253         ) no-error .
      254       if error-status :error then do:
      255         undo, return error return-value .
      256       end.
      257       find first buf_doc-line-attr exclusive-lock
      258         where buf_doc-line-attr.doc-code  = p-doc-code
      259           and buf_doc-line-attr.gds-code  = p-gds-code
      260           and buf_doc-line-attr.attr-code = p-code
      261         no-error NO-WAIT.
      262       if not available buf_doc-line-attr then do:
      263         p-deleted = no.
      264       end.
      265       else do:
      266         delete buf_doc-line-attr.
      267         p-deleted = yes.
      268       end.
      269     end.
      270   end procedure.
      271   procedure lineattr-code :
      272     do on error undo, return error return-value
      273     :
      274       define input  parameter p-code           as character no-undo .
      275       define output parameter p-type           as character no-undo .
      276       define output parameter p-format         as character no-undo .
      277       define output parameter p-fillin_width   as integer   no-undo .
      278       define output parameter p-fillin_height  as integer   no-undo .
      279       define output parameter p-label          as character no-undo .
      280       define output parameter p-user-can-edit  as logical   no-undo .
      281       define output parameter p-output-display as logical   no-undo .
      282       define output parameter p-other          as character no-undo .
      283       case p-code :
      284               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      285               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      286               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      287               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      288               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      289               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      290               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      291               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      292               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      293               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      294               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      295         otherwise do:
      296           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      297         end.
      298       end.
      299     end.
      300   end procedure.
      301   procedure lineattr-value-flora-gds :
      302     do
      303     on error undo, return error return-value
      304     :
      305       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      306       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      307       define input  parameter p-prt-code    as integer   no-undo .
      308       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      309       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      310       define output parameter p-value       as    decimal   no-undo .
      311       define buffer buf_doc-line-attr for ub.doc-line-attr .
      312       find first buf_doc-line-attr no-lock
      313         where buf_doc-line-attr.doc-code  = p-doc-code
      314           and buf_doc-line-attr.gds-code  = p-gds-code
      315           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      316         no-error .
      317       if avail buf_doc-line-attr then do:
      318         assign
      319           p-value = decimal( buf_doc-line-attr.attr-value)
      320         .
      321       end.
      322       else do:
      323         assign
      324           p-value = 0
      325         .
      326       end.
      327     end.
      328   end procedure.
      329   procedure lineattr-write-flora-gds :
      330     do
      331     on error undo, return error return-value
      332     :
      333       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      334       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      335       define input parameter p-prt-code    as integer   no-undo .
      336       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      337       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      338       define input parameter p-value    as decimal   no-undo .
      339       define buffer buf_doc-line-attr for ub.doc-line-attr .
      340       find first buf_doc-line-attr exclusive-lock
      341         where buf_doc-line-attr.doc-code  = p-doc-code
      342           and buf_doc-line-attr.gds-code  = p-gds-code
      343           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      344         no-error .
      345       if not available buf_doc-line-attr then do:
      346         create buf_doc-line-attr .
      347         assign
      348           buf_doc-line-attr.doc-code  = p-doc-code
      349           buf_doc-line-attr.gds-code  = p-gds-code
      350           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      351         .
      352       end.
      353       assign
      354         buf_doc-line-attr.attr-value = string( p-value )
      355       .
      356     end.
      357   end procedure.
      358   procedure lineattr-delete-flora-gds :
      359     do
      360     on error undo, return error return-value
      361     :
      362       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      363       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      364       define input  parameter p-prt-code    as integer   no-undo .
      365       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      366       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      367       define output parameter p-deleted  as logical no-undo.
      368       define buffer buf_doc-line-attr for ub.doc-line-attr .
      369       find first buf_doc-line-attr exclusive-lock
      370         where buf_doc-line-attr.doc-code  = p-doc-code
      371           and buf_doc-line-attr.gds-code  = p-gds-code
      372           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      373         no-error NO-WAIT.
      374       if not available buf_doc-line-attr then do:
      375         p-deleted = no.
      376       end.
      377       else do:
      378         delete buf_doc-line-attr.
      379         p-deleted = yes.
      380       end.
      381     end.
      382   end procedure.
      383   procedure lineattr-delete-flora-all :
      384     do
      385     on error undo, return error return-value
      386     :
      387       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      388       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      389       define input  parameter p-prt-code    as integer   no-undo .
      390       define buffer buf_doc-line-attr for ub.doc-line-attr .
      391       for each buf_doc-line-attr exclusive-lock
      392         where buf_doc-line-attr.doc-code  = p-doc-code
      393           and buf_doc-line-attr.gds-code  = p-gds-code
      394           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      395        :
      396         delete buf_doc-line-attr.
      397       end.
      398    end.
      399   end procedure.
      400   procedure lineattr-exist-flora-gds :
      401     do
      402     on error undo, return error return-value
      403     :
      404       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      405       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      406       define input  parameter p-prt-code    as integer   no-undo .
      407       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      408       define output parameter p-exist as logical   no-undo .
      409       define buffer buf_doc-line-attr for ub.doc-line-attr .
      410       p-exist = false .
      411       find first buf_doc-line-attr no-lock
      412         where buf_doc-line-attr.doc-code  = p-doc-code
      413           and buf_doc-line-attr.gds-code  = p-gds-code
      414           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      415         no-error .
      416       if avail buf_doc-line-attr then do:
      417         assign
      418          p-exist = true
      419         .
      420       end.
      421     end.
      422   end procedure.
      423   procedure lineattr-write-add-line-cli :
      424   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      425   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      426   define input  parameter p-cli-type      as character no-undo .
      427   define input  parameter p-cli-code      as integer   no-undo .
      428   define input  parameter p-contract-code as integer   no-undo .
      429   define input  parameter p-host-code     as integer   no-undo .
      430   define input  parameter p-exch-code     as integer   no-undo .
      431   define input  parameter p-exch-rate     as decimal   no-undo .
      432   define input  parameter p-exch-scale    as integer   no-undo .
      433   define input  parameter p-sum-cli       as decimal   no-undo .
      434   define input  parameter p-sum-vat       as decimal   no-undo .
      435   define buffer buf_doc-line-attr for ub.doc-line-attr .
      436     do
      437     on error undo, return error return-value
      438     :
      439       find first buf_doc-line-attr exclusive-lock
      440         where buf_doc-line-attr.doc-code  = p-doc-code
      441           and buf_doc-line-attr.gds-code  = p-gds-code
      442           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      443                                             chr(4) + p-cli-type +
      444                                             chr(4) + string(p-cli-code) +
      445                                             chr(4) + string(p-contract-code) +
      446                                             chr(4) + string(p-host-code)
      447         no-error .
      448       if not available buf_doc-line-attr then do:
      449         create buf_doc-line-attr .
      450         assign
      451           buf_doc-line-attr.doc-code  = p-doc-code
      452           buf_doc-line-attr.gds-code  = p-gds-code
      453           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      454                                         chr(4) + p-cli-type +
      455                                         chr(4) + string(p-cli-code) +
      456                                         chr(4) + string(p-contract-code) +
      457                                         chr(4) + string(p-host-code)
      458         .
      459       end.
      460       assign
      461         buf_doc-line-attr.attr-value =
      462         string(p-exch-code)  + chr(4) +
      463         string(p-exch-rate)  + chr(4) +
      464         string(p-exch-scale) + chr(4) +
      465         string(p-sum-cli)    + chr(4) +
      466         string(p-sum-vat)
      467         .
      468     end.
      469   end procedure.
      470   procedure lineattr-value-add-line-cli :
      471   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      472   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      473   define input   parameter p-cli-type      as character no-undo .
      474   define input   parameter p-cli-code      as integer   no-undo .
      475   define input   parameter p-contract-code as integer   no-undo .
      476   define input   parameter p-host-code     as integer   no-undo .
      477   define output  parameter p-exch-code     as integer   no-undo .
      478   define output  parameter p-exch-rate     as decimal   no-undo .
      479   define output  parameter p-exch-scale    as integer   no-undo .
      480   define output  parameter p-sum-cli       as decimal   no-undo .
      481   define output  parameter p-sum-vat       as decimal   no-undo .
      482   define buffer buf_doc-line-attr for ub.doc-line-attr .
      483     do
      484     on error undo, return error return-value
      485     :
      486       find first buf_doc-line-attr exclusive-lock
      487         where buf_doc-line-attr.doc-code  = p-doc-code
      488           and buf_doc-line-attr.gds-code  = p-gds-code
      489           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      490                                             chr(4) + p-cli-type +
      491                                             chr(4) + string(p-cli-code) +
      492                                             chr(4) + string(p-contract-code) +
      493                                             chr(4) + string(p-host-code)
      494         no-error .
      495       if available buf_doc-line-attr then do:
      496        assign
      497           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      498           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      499           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      500           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      501           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      502          .
      503        end.
      504     end.
      505   end procedure.
      506   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      507     define variable v-code as character no-undo .
      508     define variable v-type as character no-undo .
      509     define variable v-gds-code as integer   no-undo .
      510   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      511   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      512     (input  local-doc-line.artic
      513     ,input  local-doc-line.prod-type
      514     ,input  local-doc-line.prod-code
      515     ,output v-gds-code
      516     )  .
      517     run lineattr-value (
      518         input   local-doc-line.doc-code ,
      519         input   v-gds-code              ,
      520         input   'reason-code':U ,
      521         output  v-code                  ,
      522         output  v-type ) .
      523     find first ub.trn-reason no-lock where
      524                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      525     if not available ub.trn-reason then do:
      526        return "" .
      527     end.
      528     else do:
      529        return ub.trn-reason.reason-name .
      530     end.
      531   end function.
      532   procedure lineattr-value-parts :
      533     do
      534     on error undo, return error return-value
      535     :
      536       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      537       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      538       define input  parameter p-part-code   as character no-undo .
      539       define input  parameter p_in-code     as character no-undo .
      540       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      541       define output parameter p-value       as    decimal   no-undo .
      542       define buffer buf_doc-line-attr for ub.doc-line-attr .
      543       find first buf_doc-line-attr no-lock
      544         where buf_doc-line-attr.doc-code  = p-doc-code
      545           and buf_doc-line-attr.gds-code  = p-gds-code
      546           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      547         no-error .
      548       if avail buf_doc-line-attr then do:
      549         assign
      550           p-value = decimal( buf_doc-line-attr.attr-value)
      551         .
      552       end.
      553       else do:
      554         assign
      555           p-value = 0
      556         .
      557       end.
      558     end.
      559   end procedure.
      560   procedure lineattr-write-parts :
      561     do
      562     on error undo, return error return-value
      563     :
      564       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      565       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      566       define input parameter p-part-code  as character no-undo .
      567       define input parameter p_in-code    as character no-undo .
      568       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      569       define input parameter p-value      as decimal   no-undo .
      570       define buffer buf_doc-line-attr for ub.doc-line-attr .
      571       find first buf_doc-line-attr exclusive-lock
      572         where buf_doc-line-attr.doc-code  = p-doc-code
      573           and buf_doc-line-attr.gds-code  = p-gds-code
      574           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      575         no-error .
      576       if not available buf_doc-line-attr then do:
      577         create buf_doc-line-attr .
      578         assign
      579           buf_doc-line-attr.doc-code  = p-doc-code
      580           buf_doc-line-attr.gds-code  = p-gds-code
      581           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      582         .
      583       end.
      584       assign
      585         buf_doc-line-attr.attr-value = string( p-value )
      586       .
      587     end.
      588   end procedure.
      589   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      590   define new global shared variable g#lib-calc as handle no-undo .
      591   procedure proc-alt-shift-f2:
      592     if not ibs.th.gbl.gbl-var:rcode
      593   then
      594     run gbl\inidebug.p .
      595   end.
      596   procedure proc-alt-shift-f3:
      597     run gbl/prvssinf.p
      598       ( input this-procedure
      599       ) .
      600   end.
      601   define variable v-inform-launched as logical no-undo initial false .
      602   procedure proc-alt-shift-f4:
      603     define variable v-action as character no-undo .
      604     if v-inform-launched = false then do:
      605       assign
      606         v-inform-launched = true
      607       .
      608       run gbl/d-inform.w
      609         (  input self
      610         ,  input this-procedure
      611         , output v-action
      612         ) no-error .
      613       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      614       assign
      615         v-inform-launched = false
      616       .
      617     end.
      618   end.
      619   procedure proc-alt-f1:
      620     run gbl/corrhelp.p
      621       (input this-procedure
      622       ) .
      623   end .
