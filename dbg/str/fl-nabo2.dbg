      628     run proc-alt-shift-f3 in this-procedure .
      629   end.
      630   on alt-shift-f4 anywhere do:
      631     run proc-alt-shift-f4 in this-procedure.
      632   end.
      633   on alt-f1 anywhere do:
      634     run proc-alt-f1 in this-procedure .
      635   end.
      636   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      637     define variable v-cntxt-db-num        as integer   no-undo .
      638     define variable v-cntxt-userid        as character no-undo .
      639     define variable v-cntxt-level         as character no-undo .
      640     define variable v-cntxt-host-code-obj as integer   no-undo .
      641     define variable v-cntxt-obj-type      as character no-undo .
      642     define variable v-cntxt-obj-code      as integer   no-undo .
      643     define variable v-cntxt-db-num-obj    as integer   no-undo .
      644     define variable v-cntxt-is-admin      as logical   no-undo .
      645   define variable g#host-name  as character no-undo .
      646   define variable g#host-code    as integer   no-undo .
      647   define variable store-type   as character no-undo .
      648   define variable store-code   as integer   no-undo .
      649   define variable g#log      as logical   no-undo .
      650   define variable g#report-num as integer   no-undo .
      651   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      652     run mainmenu_getcntxt in parparentproc
      653       (output v-cntxt-db-num
      654       ,output v-cntxt-userid
      655       ,output v-cntxt-level
      656       ,output v-cntxt-host-code-obj
      657       ,output v-cntxt-obj-type
      658       ,output v-cntxt-obj-code
      659       ,output v-cntxt-db-num-obj
      660       ,output v-cntxt-is-admin
      661       ) .
      662   assign
      663     store-type    = v-cntxt-obj-type
      664     store-code    = v-cntxt-obj-code
      665   .
      666   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      668     (input  store-type
      669     ,input  store-code
      670     ,output g#host-code
      671     ,output g#host-name
      672     )  .
      673   run get-report-num in parParentProc ( output g#report-num ).
      674   define temp-table temp-gds-dtl no-undo
      675   field node-code as integer
      676   field artic     as char
      677   field prod-type     as char
      678   field prod-code     as int
      679   field gds-code  as integer
      680   field rel-bk    as logical
      681   index pi node-code
      682   .
      683   def var chg-qnty like gds-dtl.doc-qnty init ? no-undo.
      684   def shared buffer t-doc for trn-doc.
      685   DEFINE BUTTON B-add
      686        LABEL "Добавить"
      687        SIZE 10 BY 1
      688        BGCOLOR 8 .
      689   DEFINE BUTTON B-chg
      690        LABEL "Изменить"
      691        SIZE 10 BY 1
      692        BGCOLOR 8 .
      693   DEFINE BUTTON B-del
      694        LABEL "Удалить"
      695        SIZE 10 BY 1
      696        BGCOLOR 8 .
      697   DEFINE BUTTON B-exit AUTO-END-KEY
      698        LABEL "Выход"
      699        SIZE 10 BY 1
      700        BGCOLOR 8 .
      701   DEFINE BUTTON B-Help
      702        LABEL "Помощь"
      703        SIZE 10 BY 1
      704        BGCOLOR 8 .
      705   DEFINE VARIABLE v-str AS CHARACTER FORMAT "X(256)":U
      706         VIEW-AS TEXT
      707        SIZE 75.5 BY 1.25
      708        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      709   DEFINE QUERY BROWSE-1 FOR
      710         tt-doc-line-attr,
      711         ub.goods SCROLLING.
      712   DEFINE BROWSE BROWSE-1
      713     QUERY BROWSE-1 NO-LOCK DISPLAY
      714         ub.goods.artic FORMAT "X(16)":U
      715         ub.goods.gds-name COLUMN-LABEL "Название набора" FORMAT "X(48)":U
      716         tt-doc-line-attr.attr-value COLUMN-LABEL "Количество" FORMAT "x(10)":U
      717     ENABLE
      718         tt-doc-line-attr.attr-value
      719       WITH NO-ROW-MARKERS SEPARATORS SIZE 79 BY 9.25 ROW-HEIGHT-CHARS .75 EXPANDABLE.
      720   DEFINE FRAME Dialog-Frame
      721        B-exit AT ROW 1 COL 1
      722        B-add AT ROW 1 COL 11
      723        B-chg AT ROW 1 COL 21
      724        B-del AT ROW 1 COL 31
      725        B-Help AT ROW 1 COL 70
      726        BROWSE-1 AT ROW 4 COL 1
      727        v-str AT ROW 2.25 COL 1.5 NO-LABEL
      728        SPACE(3.37) SKIP(9.87)
      729       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      730            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      731            TITLE "Товар входит в наборы"
      732            CANCEL-BUTTON B-exit.
      733   ASSIGN
      734          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      735          FRAME Dialog-Frame:HIDDEN           = TRUE.
      736   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      737   DO:
      738     APPLY "END-ERROR":U TO SELF.
      739   END.
      740   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      741   DO:
      742   define variable  v-qnty     as character no-undo .
      743   define variable  v-qnty-old as character no-undo .
      744   define variable v-exist as logical   no-undo .
      745   define variable v-buket-gds-code as integer   no-undo .
      746   run str/flornakl.p
      747     ( input parParentProc , input "all", input p-doc-code , output v-exist , output v-buket-gds-code ) .
      748   if v-exist then do:
      749   find first tt-doc-line-attr where
      750         tt-doc-line-attr.doc-code    = p-doc-code and
      751         tt-doc-line-attr.gds-code    = p-gds-code and
      752         tt-doc-line-attr.attr-code  = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(v-buket-gds-code ) no-error .
      753   if available tt-doc-line-attr then do:
      754       message "В таком наборе товар " v-str " уже присутствует!" view-as alert-box information .
      755       return .
      756   end.
      757   if v-buket-gds-code = 0 or v-buket-gds-code = ? then return .
      758         CREATE tt-doc-line-attr.
      759         assign
      760         tt-doc-line-attr.doc-code    = p-doc-code
      761         tt-doc-line-attr.gds-code    = p-gds-code
      762         tt-doc-line-attr.node-code   = p-prt-code
      763         tt-doc-line-attr.attr-value  = "1"
      764         tt-doc-line-attr.bk-gds-code = v-buket-gds-code
      765         tt-doc-line-attr.attr-code  = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(v-buket-gds-code )
      766         .
      767        OPEN QUERY BROWSE-1 FOR EACH tt-doc-line-attr NO-LOCK,       EACH ub.goods WHERE ub.goods.gds-code = tt-doc-line-attr.bk-gds-code NO-LOCK INDEXED-REPOSITION.
      768   end.
      769   END.
      770   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      771   DO:
      772   if not available tt-doc-line-attr    then return .
      773   define variable  v-qnty     as character no-undo .
      774   define variable  v-qnty-old as character no-undo .
      775    v-qnty     =  tt-doc-line-attr.attr-value .
      776    v-qnty-old =  tt-doc-line-attr.attr-value .
      777   run gbl/d-prompt.w (
      778           'title=':u + "Изменение количества товара" + '\':u
      779         + 'text1=':u + "Количество" + ( goods.gds-name ) + '\':u
      780         + 'format=' + ">>>>>>>9.99" + '\':u
      781         + 'type=' + "decimal" + '\':u
      782         + 'fillin_row=2\':u
      783         + 'fillin_col=4\':u
      784         + 'fillin_width=10\':u
      785         + 'fillin_height=1\':u
      786         + 'max-chars=10\':u
      787         + 'readonly=' + (if p-doc-mode <> 'ПРОСМОТР':U then 'no':u else 'yes':u) + '\':u
      788         , input-output v-qnty
      789         ) no-error.
      790      if caps(return-value) = "TRUE" and p-doc-mode <> 'ПРОСМОТР':U  then do:
      791         tt-doc-line-attr.attr-value  = v-qnty  .
      792        BROWSE-1:refresh() in frame Dialog-Frame .
      793      end.
      794   END.
      795   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      796   DO:
      797   if not available tt-doc-line-attr then return .
      798      message
      799      "Удалять товар : " v-str
      800      " из набора : " goods.gds-name  "?"
      801      view-as alert-box question
      802      buttons yes-no
      803      update v-d as log
      804      .
      805      if v-d = true then do:
      806         delete tt-doc-line-attr.
      807         OPEN QUERY BROWSE-1 FOR EACH tt-doc-line-attr NO-LOCK,       EACH ub.goods WHERE ub.goods.gds-code = tt-doc-line-attr.bk-gds-code NO-LOCK INDEXED-REPOSITION.
      808      end.
      809   END.
      810   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      811   DO:
      812     run save-proc in this-procedure .
      813   END.
      814   ON ROW-LEAVE OF BROWSE-1 IN FRAME Dialog-Frame
      815   DO:
      816   define variable ll as decimal   no-undo .
      817    ll = DEC(tt-doc-line-attr.attr-value:screen-value in browse BROWSE-1 ) no-error .
      818    IF error-status :error  THEN  RETURN NO-APPLY.
      819   END.
      820   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      821   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      822   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   on help of frame Dialog-Frame
      824   do:
      825     run gbl/app_help.p
      826       (input this-procedure :file-name
      827       ,input ''
      828       ,input ?
      829       ) no-error.
      830     if error-status :error then do:
      831       message
      832         "Ошибка при вызове помощи"
      833         error-status :get-message(1)
      834         view-as alert-box .
      835     end.
      836   end.
      837   run minbtn-set in this-procedure .
      838   on choose of b-help in frame Dialog-Frame
      839   do:
      840     apply "help":u to frame Dialog-Frame .
      841   end.
      842   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843   procedure minbtn-set :
      844       do
      845           on error undo, return error return-value
      846           :
      847           define variable ii              as integer       no-undo .
      848           define variable fh              as widget-handle no-undo .
      849           define variable hh              as widget-handle no-undo .
      850           define variable v-h             as handle        extent 4 no-undo .
      851           define variable v-name-button   as character     no-undo .
      852           define variable v-help-old-x    as decimal       no-undo .
      853           define variable v-help-old-y    as decimal       no-undo .
      854           define variable v-help-old-size as decimal       no-undo .
      855           define variable v-frame-width   as decimal       no-undo .
      856           define variable jj              as integer       no-undo .
      857           do
      858               on error undo, return error
      859               :
      860               assign
      861                   v-frame-width = frame Dialog-Frame:width - 0.3
      862                   fh            = frame Dialog-Frame:first-child
      863                   hh            = fh:first-child
      864                   ii            = 1
      865                   .
      866               do while valid-handle(hh):
      867                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      868                   do:
      869                       case lc(hh:name) :
      870                           when "b-help" then
      871                               do:
      872                                   hh:load-image-up("cmp/b-help.bmp":u) .
      873                                   hh:load-image-down("cmp/b-help.bmp":u) .
      874                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      875                                   hh:TOOLTIP = "Помощь" .
      876                                   v-help-old-x = hh:column .
      877                                   v-help-old-y = hh:row    .
      878                                   v-help-old-size = hh:width .
      879                                   hh:width-chars = 2.5 .
      880                               end.
      881                           when "b-print" then
      882                               do:
      883                                   hh:load-image("cmp/b-print.bmp":u) .
      884                                   hh:TOOLTIP = "Печать" .
      885                                   v-h[ii] = hh:handle .
      886                                   ii = ii + 1 .
      887                                   hh:width-chars = 3 .
      888                               end.
      889                           when "b-history" or
      890                           when "b-hist" then
      891                               do:
      892                                   hh:load-image("cmp/b-hist.bmp":u) .
      893                                   hh:TOOLTIP = "История" .
      894                                   v-h[ii] = hh:handle .
      895                                   ii = ii + 1 .
      896                                   hh:width-chars = 3 .
      897                               end.
      898                           when "b-sch" then
      899                               do:
      900                                   hh:load-image("cmp/b-sch.bmp":u) .
      901                                   hh:TOOLTIP = "Установка Фильтра" .
      902                                   v-h[ii] = hh:handle .
      903                                   ii = ii + 1 .
      904                                   hh:width-chars = 3 .
      905                               end.
      906                           when "b-hist-user" then
      907                               do:
      908                                   hh:load-image("cmp/b-hist.bmp":u) .
      909                                   hh:TOOLTIP = "История пользователя" .
      910                                   ii = ii + 1 .
      911                               end.
      912                       end case.
      913                   end.
      914                   hh = hh:next-sibling.
      915               end.
      916               b-help:column = v-frame-width - b-help:width-chars.
      917               jj = 0.
      918               repeat ii = 4 to 1 by -1 :
      919                   if valid-handle (v-h[ii] ) then
      920                   do:
      921                       jj  = jj + 1 .
      922                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      923                       v-h[ii]:row    = v-help-old-y .
      924                   end.
      925               end.
      926           end.
      927       end.
      928   end procedure.
      929   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      930   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      931   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      932   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      933   define variable v-diasize-current-frame-width  as decimal   no-undo .
      934   define variable v-diasize-current-frame-height as decimal   no-undo .
      935   define variable v-diasize-change-size          as logical   no-undo .
      936   define variable v-diasize-resize-button        as handle    no-undo .
      937   define variable v-diasize-wndmax               as logical   no-undo .
      938   define variable v-diasize-wndstore             as logical   no-undo .
      939   define variable v-diasize-proc-name            as character no-undo .
      940   define variable v-diasize-browse-handle        as handle    no-undo .
      941   define variable v-diasize-browse-number        as integer   no-undo .
      942   define variable v-diasize-need-full-display    as logical   no-undo init false .
      943   define temp-table temp-diasize-handle no-undo
      944     field handle-value  as handle
      945     field save-position as decimal
      946     index xpk is primary unique handle-value
      947     .
      948   define temp-table temp-browse-handle no-undo
      949     field browse-type   as character
      950     field browse-number as integer
      951     field browse-handle as handle
      952     field original-size as decimal
      953     index xpk is primary unique browse-type browse-number
      954     index xie browse-type browse-handle
      955   .
      956   procedure diasize_change-height :
      957     define input  parameter p-change-value  as decimal   no-undo .
      958     define input  parameter p-move-resize   as logical   no-undo .
      959     define variable v-field-group-handle    as handle    no-undo .
      960     define variable v-object-handle         as handle    no-undo .
      961     define variable v-frame-height          as decimal   no-undo .
      962     define variable v-frame-virtual-height  as decimal   no-undo .
      963     define variable v-browse-height         as decimal   no-undo .
      964     define variable v-window-height         as decimal   no-undo .
      965     define variable v-window-virtual-height as decimal   no-undo .
      966     define variable v-change-sign           as integer   no-undo .
      967     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      968     define buffer buf_temp-browse-handle  for temp-browse-handle .
      969     if p-change-value > 0
      970     then do:
      971       if frame Dialog-Frame :height + p-change-value
      972           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      973       then do:
      974         assign
      975           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      976                           - (frame Dialog-Frame :height-chars)
      977         .
      978         if p-change-value <= 0
      979         then do:
      980           run diasize_position-resize-button in this-procedure .
      981           return .
      982         end.
      983       end.
      984     end.
      985     if p-change-value < 0
      986     then do:
      987       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      988       then do:
      989         assign
      990           p-change-value = v-diasize-orig-frame-height
      991                          - (frame Dialog-Frame :height-chars)
      992         .
      993         if p-change-value >= 0
      994         then do:
      995           run diasize_position-resize-button in this-procedure .
      996           return .
      997         end.
      998       end.
      999     end.
     1000     if p-change-value >= 0
     1001     then do:
     1002       assign
     1003         v-change-sign = 1
     1004       .
     1005     end.
     1006     else do:
     1007       assign
     1008         v-change-sign = -1
     1009       .
     1010     end.
     1011     assign
     1012       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1013     .
     1014     if p-change-value = 0
     1015     then do:
     1016       run diasize_position-resize-button in this-procedure .
     1017       return .
     1018     end.
     1019     move_block:
     1020     do
     1021     on error undo move_block, retry move_block
     1022     :
     1023       if retry
     1024       then do:
     1025         do
     1026         on error undo move_block, leave move_block
     1027         :
     1028           if p-change-value > 0
     1029           then do:
     1030             for each buf_temp-diasize-handle
     1031             on error undo, next
     1032             :
     1033               assign
     1034                 v-object-handle = buf_temp-diasize-handle.handle-value
     1035               .
     1036               if v-object-handle <> v-diasize-resize-button
     1037               then do:
     1038                 assign
     1039                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1040                 .
     1041               end.
     1042             end.
     1043             assign
     1044               v-diasize-browse-handle :height = v-browse-height
     1045             .
     1046             for each buf_temp-browse-handle
     1047               where buf_temp-browse-handle.browse-type = 'height':u
     1048             on error undo, next
     1049             :
     1050               assign
     1051                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1052               .
     1053             end.
     1054             assign
     1055               frame Dialog-Frame :height = v-frame-height
     1056             .
     1057             if frame Dialog-Frame :scrollable = true
     1058             then do:
     1059               assign
     1060                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1061               .
     1062             end.
     1063             run diasize_position-resize-button in this-procedure .
     1064           end.
     1065           else do:
     1066             if frame Dialog-Frame :scrollable = true
     1067             then do:
     1068               assign
     1069                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1070               .
     1071             end.
     1072             assign
     1073               frame Dialog-Frame :height = v-frame-height
     1074             .
     1075             assign
     1076               v-diasize-browse-handle :height = v-browse-height
     1077             .
     1078             for each buf_temp-browse-handle
     1079               where buf_temp-browse-handle.browse-type = 'height':u
     1080             on error undo, next
     1081             :
     1082               assign
     1083                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1084               .
     1085             end.
     1086             for each buf_temp-diasize-handle
     1087             on error undo, next
     1088             :
     1089               assign
     1090                 v-object-handle = buf_temp-diasize-handle.handle-value
     1091               .
     1092               if v-object-handle <> v-diasize-resize-button
     1093               then do:
     1094                 assign
     1095                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1096                 .
     1097               end.
     1098             end.
     1099             run diasize_position-resize-button in this-procedure .
     1100           end.
     1101           assign
     1102             v-diasize-change-size = false
     1103           .
     1104           leave move_block .
     1105         end.
     1106       end.
     1107       assign
     1108         v-diasize-need-full-display = true
     1109       .
     1110       if v-diasize-change-size = false
     1111       then do:
     1112         assign
     1113           v-diasize-change-size = true
     1114         .
     1115       end.
     1116       else do:
     1117         return .
     1118       end.
     1119       assign
     1120         v-frame-height = frame Dialog-Frame :height
     1121         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1122         v-browse-height = v-diasize-browse-handle :height
     1123       .
     1124       for each buf_temp-browse-handle
     1125         where buf_temp-browse-handle.browse-type = 'height':u
     1126       :
     1127         assign
     1128           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1129         .
     1130       end.
     1131       for each buf_temp-diasize-handle
     1132       :
     1133         delete buf_temp-diasize-handle .
     1134       end.
     1135       assign
     1136         v-field-group-handle = frame Dialog-Frame :first-child
     1137       .
     1138       do while valid-handle(v-field-group-handle)
     1139       :
     1140         assign
     1141           v-object-handle = v-field-group-handle :first-child
     1142         .
     1143         do while valid-handle(v-object-handle)
     1144         :
     1145           if  v-object-handle <> v-diasize-browse-handle :handle
     1146           and can-query(v-object-handle, "row")
     1147           and can-query(v-object-handle, "height")
     1148           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1149           then do:
     1150             find first buf_temp-browse-handle
     1151               where buf_temp-browse-handle.browse-type   = 'height':u
     1152                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1153               no-error .
     1154             if available buf_temp-browse-handle
     1155             then do:
     1156             end.
     1157             else do:
     1158               create buf_temp-diasize-handle .
     1159               assign
     1160                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1161                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1162               .
     1163             end.
     1164           end.
     1165           assign
     1166             v-object-handle = v-object-handle :next-sibling
     1167           .
     1168         end.
     1169         assign
     1170           v-field-group-handle = v-field-group-handle :next-sibling
     1171         .
     1172       end.
     1173       do with frame Dialog-Frame
     1174       :
     1175         hide v-diasize-resize-button .
     1176         assign
     1177           v-diasize-resize-button :row    = 1
     1178           v-diasize-resize-button :column = 1
     1179         .
     1180       end.
     1181       if p-change-value > 0
     1182       then do:
     1183         if frame Dialog-Frame :scrollable = true
     1184         then do:
     1185           assign
     1186             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1187             no-error .
     1188           if error-status :error
     1189           or error-status :get-message(1) <> ""
     1190           then do:
     1191             undo move_block, retry move_block .
     1192           end.
     1193         end.
     1194         assign
     1195           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1196           no-error .
     1197         if error-status :error
     1198         or error-status :get-message(1) <> ""
     1199         then do:
     1200           undo move_block, retry move_block .
     1201         end.
     1202         assign
     1203           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1204           no-error .
     1205         if error-status :error
     1206         or error-status :get-message(1) <> ""
     1207         then do:
     1208           undo move_block, retry move_block .
     1209         end.
     1210         for each buf_temp-browse-handle
     1211           where buf_temp-browse-handle.browse-type = 'height':u
     1212         on error undo move_block, retry move_block
     1213         :
     1214           assign
     1215             buf_temp-browse-handle.browse-handle :height
     1216               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1217             no-error .
     1218           if error-status :error
     1219           or error-status :get-message(1) <> ""
     1220           then do:
     1221             undo move_block, retry move_block .
     1222           end.
     1223         end.
     1224         for each buf_temp-diasize-handle
     1225         on error undo move_block, retry move_block
     1226         :
     1227           assign
     1228             v-object-handle = buf_temp-diasize-handle.handle-value
     1229           .
     1230           if v-object-handle <> v-diasize-resize-button
     1231           then do:
     1232             assign
     1233               v-object-handle :row = v-object-handle :row + p-change-value
     1234               no-error .
     1235             if error-status :error
     1236             or error-status :get-message(1) <> ""
     1237             then do:
     1238               undo move_block, retry move_block .
     1239             end.
     1240           end.
     1241         end.
     1242       end.
     1243       else do:
     1244         for each buf_temp-diasize-handle
     1245         on error undo move_block, retry move_block
     1246         :
     1247           assign
     1248             v-object-handle = buf_temp-diasize-handle.handle-value
     1249           .
     1250           if v-object-handle <> v-diasize-resize-button
     1251           then do:
     1252             assign
     1253               v-object-handle :row = v-object-handle :row + p-change-value
     1254               no-error .
     1255             if error-status :error
     1256             or error-status :get-message(1) <> ""
     1257             then do:
     1258               undo move_block, retry move_block .
     1259             end.
     1260           end.
     1261         end.
     1262         assign
     1263           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1264           no-error .
     1265         if error-status :error
     1266         or error-status :get-message(1) <> ""
     1267         then do:
     1268           undo move_block, retry move_block .
     1269         end.
     1270         for each buf_temp-browse-handle
     1271           where buf_temp-browse-handle.browse-type = 'height':u
     1272         on error undo move_block, retry move_block
     1273         :
     1274           assign
     1275             buf_temp-browse-handle.browse-handle :height
     1276               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1277             no-error .
     1278           if error-status :error
     1279           or error-status :get-message(1) <> ""
     1280           then do:
     1281             undo move_block, retry move_block .
     1282           end.
     1283         end.
     1284         assign
     1285           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1286           no-error .
     1287         if error-status :error
     1288         or error-status :get-message(1) <> ""
     1289         then do:
     1290           undo move_block, retry move_block .
     1291         end.
     1292         if frame Dialog-Frame :scrollable = true
     1293         then do:
     1294           assign
     1295             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1296             no-error .
     1297           if error-status :error
     1298           or error-status :get-message(1) <> ""
     1299           then do:
     1300             undo move_block, retry move_block .
     1301           end.
     1302         end.
     1303       end.
     1304       if p-move-resize = true
     1305       then do:
     1306         run diasize_position-resize-button in this-procedure .
     1307       end.
     1308       if v-diasize-wndstore = true
     1309       then do:
     1310         if connected("ub") = true
     1311         then do:
     1312           define variable v-cntxt-db-num        as integer   no-undo .
     1313           define variable v-cntxt-userid        as character no-undo .
     1314           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1315                                             , OUTPUT v-cntxt-userid
     1316                                             ) .
     1317           run gbl/wndsizew.p
     1318             (input  v-cntxt-db-num
     1319             ,input  v-cntxt-userid
     1320             ,input  v-diasize-proc-name
     1321             ,input  'height':u
     1322             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1323             ) .
     1324         end.
     1325       end.
     1326     end.
     1327     assign
     1328       v-diasize-change-size = false
     1329     .
     1330   end procedure.
     1331   procedure diasize_set-height :
     1332     define input  parameter p-new-height  as decimal   no-undo .
     1333     define input  parameter p-move-resize as logical   no-undo .
     1334     do
     1335     on error undo, return error return-value
     1336     :
     1337       run diasize_change-height in this-procedure
     1338         (input  (p-new-height - frame Dialog-Frame :height)
     1339         ,input  p-move-resize
     1340         ) .
     1341     end.
     1342   end procedure.
     1343   procedure diasize_change-width :
     1344     define input  parameter p-change-value as decimal   no-undo .
     1345     define input  parameter p-move-resize  as logical   no-undo .
     1346     define variable v-field-group-handle   as handle    no-undo .
     1347     define variable v-object-handle        as handle    no-undo .
     1348     define variable v-frame-width          as decimal   no-undo .
     1349     define variable v-frame-virtual-width  as decimal   no-undo .
     1350     define variable v-browse-width         as decimal   no-undo .
     1351     define variable v-window-width         as decimal   no-undo .
     1352     define variable v-window-virtual-width as decimal   no-undo .
     1353     define variable v-change-sign          as integer   no-undo .
     1354     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1355     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1356     if p-change-value > 0
     1357     then do:
     1358       if frame Dialog-Frame :width + p-change-value >
     1359           session :width-chars
     1360       then do:
     1361         assign
     1362           p-change-value = session :width-chars - frame Dialog-Frame :width
     1363         .
     1364         if p-change-value <= 0
     1365         then do:
     1366           run diasize_position-resize-button in this-procedure .
     1367           return .
     1368         end.
     1369       end.
     1370     end.
     1371     if p-change-value < 0
     1372     then do:
     1373       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1374       then do:
     1375         assign
     1376           p-change-value = v-diasize-orig-frame-width
     1377                          - frame Dialog-Frame :width
     1378         .
     1379         if p-change-value >= 0
     1380         then do:
     1381           run diasize_position-resize-button in this-procedure .
     1382           return .
     1383         end.
     1384       end.
     1385     end.
     1386     if p-change-value >= 0
     1387     then do:
     1388       assign
     1389         v-change-sign = 1
     1390       .
     1391     end.
     1392     else do:
     1393       assign
     1394         v-change-sign = -1
     1395       .
     1396     end.
     1397     assign
     1398       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1399     .
     1400     if p-change-value = 0
     1401     then do:
     1402       run diasize_position-resize-button in this-procedure .
     1403       return .
     1404     end.
     1405     move_block:
     1406     do
     1407     on error undo move_block, leave move_block
     1408     :
     1409       if retry
     1410       then do:
     1411         do
     1412         on error undo move_block, leave move_block
     1413         :
     1414           if p-change-value > 0
     1415           then do:
     1416             for each buf_temp-diasize-handle
     1417             on error undo, next
     1418             :
     1419               assign
     1420                 v-object-handle = buf_temp-diasize-handle.handle-value
     1421               .
     1422               if v-object-handle <> v-diasize-resize-button
     1423               then do:
     1424                 assign
     1425                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1426                 .
     1427               end.
     1428             end.
     1429             assign
     1430               v-diasize-browse-handle :width = v-browse-width
     1431             .
     1432             for each buf_temp-browse-handle
     1433               where buf_temp-browse-handle.browse-type = 'width':u
     1434             on error undo, next
     1435             :
     1436               assign
     1437                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1438               .
     1439             end.
     1440             assign
     1441               frame Dialog-Frame :width = v-frame-width
     1442             .
     1443             if frame Dialog-Frame :scrollable = true
     1444             then do:
     1445               assign
     1446                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1447               .
     1448             end.
     1449             run diasize_position-resize-button in this-procedure .
     1450           end.
     1451           else do:
     1452             if frame Dialog-Frame :scrollable = true
     1453             then do:
     1454               assign
     1455                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1456               .
     1457             end.
     1458             assign
     1459               frame Dialog-Frame :width = v-frame-width
     1460             .
     1461             for each buf_temp-browse-handle
     1462               where buf_temp-browse-handle.browse-type = 'width':u
     1463             on error undo, next
     1464             :
     1465               assign
     1466                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1467               .
     1468             end.
     1469             assign
     1470               v-diasize-browse-handle :width = v-browse-width
     1471             .
     1472             for each buf_temp-diasize-handle
     1473             on error undo, next
     1474             :
     1475               assign
     1476                 v-object-handle = buf_temp-diasize-handle.handle-value
     1477               .
     1478               if v-object-handle <> v-diasize-resize-button
     1479               then do:
     1480                 assign
     1481                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1482                 .
     1483               end.
     1484             end.
     1485             run diasize_position-resize-button in this-procedure .
     1486           end.
     1487           assign
     1488             v-diasize-change-size = false
     1489           .
     1490           leave move_block .
     1491         end.
     1492       end.
     1493       assign
     1494         v-diasize-need-full-display = true
     1495       .
     1496       if v-diasize-change-size = false
     1497       then do:
     1498         assign
     1499           v-diasize-change-size = true
     1500         .
     1501       end.
     1502       else do:
     1503         return .
     1504       end.
     1505       assign
     1506         v-frame-width = frame Dialog-Frame :width
     1507         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1508         v-browse-width = v-diasize-browse-handle :width
     1509       .
     1510       for each buf_temp-browse-handle
     1511         where buf_temp-browse-handle.browse-type = 'width':u
     1512       :
     1513         assign
     1514           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1515         .
     1516       end.
     1517       for each buf_temp-diasize-handle
     1518       :
     1519         delete buf_temp-diasize-handle .
     1520       end.
     1521       assign
     1522         v-field-group-handle = frame Dialog-Frame :first-child
     1523       .
     1524       do while valid-handle(v-field-group-handle)
     1525       :
     1526         assign
     1527           v-object-handle = v-field-group-handle :first-child
     1528         .
     1529         do while valid-handle(v-object-handle)
     1530         :
     1531           if  v-object-handle <> v-diasize-browse-handle :handle
     1532           and v-object-handle <> v-diasize-resize-button
     1533           and can-query(v-object-handle, "row")
     1534           and can-query(v-object-handle, "height")
     1535           and ( v-object-handle :col + v-object-handle :width
     1536                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1537               )
     1538           then do:
     1539             find first buf_temp-browse-handle
     1540               where buf_temp-browse-handle.browse-type   = 'width':u
     1541                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1542               no-error .
     1543             if available buf_temp-browse-handle
     1544             then do:
     1545             end.
     1546             else do:
     1547               create buf_temp-diasize-handle .
     1548               assign
     1549                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1550                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1551               .
     1552             end.
     1553           end.
     1554           assign
     1555             v-object-handle = v-object-handle :next-sibling
     1556           .
     1557         end.
     1558         assign
     1559           v-field-group-handle = v-field-group-handle :next-sibling
     1560         .
     1561       end.
     1562       do with frame Dialog-Frame
     1563       :
     1564         hide v-diasize-resize-button .
     1565         v-diasize-resize-button :row = 1.
     1566         v-diasize-resize-button :column = 1.
     1567       end.
     1568       if p-change-value > 0
     1569       then do:
     1570         if frame Dialog-Frame :scrollable = true
     1571         then do:
     1572           assign
     1573             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1574             no-error .
     1575           if error-status :error
     1576           or error-status :get-message(1) <> ""
     1577           then do:
     1578             undo move_block, retry move_block.
     1579           end.
     1580         end.
     1581         assign
     1582           frame Dialog-Frame :width = v-frame-width + p-change-value
     1583           no-error .
     1584         if error-status :error
     1585         or error-status :get-message(1) <> ""
     1586         then do:
     1587           undo move_block, retry move_block.
     1588         end.
     1589         assign
     1590           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1591         no-error .
     1592         if error-status :error
     1593         or error-status :get-message(1) <> ""
     1594         then do:
     1595           undo move_block, retry move_block.
     1596         end.
     1597         for each buf_temp-browse-handle
     1598           where buf_temp-browse-handle.browse-type = 'width':u
     1599         on error undo move_block, retry move_block
     1600         :
     1601           assign
     1602             buf_temp-browse-handle.browse-handle :width
     1603               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1604             no-error .
     1605           if error-status :error
     1606           or error-status :get-message(1) <> ""
     1607           then do:
     1608             undo move_block, retry move_block .
     1609           end.
     1610         end.
     1611         for each buf_temp-diasize-handle
     1612         on error undo move_block, retry move_block
     1613         :
     1614           assign
     1615             v-object-handle = buf_temp-diasize-handle.handle-value
     1616           .
     1617           if v-object-handle <> v-diasize-resize-button
     1618           then do:
     1619             assign
     1620               v-object-handle :col = v-object-handle :col + p-change-value
     1621               no-error .
     1622             if error-status :error
     1623             or error-status :get-message(1) <> ""
     1624             then do:
     1625               undo move_block, retry move_block .
     1626             end.
     1627           end.
     1628         end.
     1629       end.
     1630       else do:
     1631         for each buf_temp-diasize-handle
     1632         on error undo move_block, retry move_block
     1633         :
     1634           assign
     1635             v-object-handle = buf_temp-diasize-handle.handle-value
     1636           .
     1637           if v-object-handle <> v-diasize-resize-button
     1638           then do:
     1639             assign
     1640               v-object-handle :col = v-object-handle :col + p-change-value
     1641               no-error .
     1642             if error-status :error
     1643             or error-status :get-message(1) <> ""
     1644             then do:
     1645               undo move_block, retry move_block .
     1646             end.
     1647           end.
     1648         end.
     1649         for each buf_temp-browse-handle
     1650           where buf_temp-browse-handle.browse-type = 'width':u
     1651         on error undo move_block, retry move_block
     1652         :
     1653           assign
     1654             buf_temp-browse-handle.browse-handle :width
     1655               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1656             no-error .
     1657           if error-status :error
     1658           or error-status :get-message(1) <> ""
     1659           then do:
     1660             undo move_block, retry move_block .
     1661           end.
     1662         end.
     1663         assign
     1664           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1665           no-error .
     1666         if error-status :error
     1667         or error-status :get-message(1) <> ""
     1668         then do:
     1669           undo move_block, retry move_block.
     1670         end.
     1671         assign
     1672           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1673         no-error .
     1674         if error-status :error
     1675         or error-status :get-message(1) <> ""
     1676         then do:
     1677           undo move_block, retry move_block.
     1678         end.
     1679         if frame Dialog-Frame :scrollable = true
     1680         then do:
     1681           assign
     1682             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1683           no-error .
     1684           if error-status :error
     1685           or error-status :get-message(1) <> ""
     1686           then do:
     1687             undo move_block, retry move_block.
     1688           end.
     1689         end.
     1690       end.
     1691       if p-move-resize
     1692       then do:
     1693         run diasize_position-resize-button in this-procedure .
     1694       end.
     1695       if v-diasize-wndstore = true
     1696       then do:
     1697         if connected("ub") = true
     1698         then do:
     1699           define variable v-cntxt-db-num        as integer   no-undo .
     1700           define variable v-cntxt-userid        as character no-undo .
     1701           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1702                                             , OUTPUT v-cntxt-userid
     1703                                             ) .
     1704           run gbl/wndsizew.p
     1705             (input  v-cntxt-db-num
     1706             ,input  v-cntxt-userid
     1707             ,input  v-diasize-proc-name
     1708             ,input  'width':u
     1709             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1710             ) .
     1711         end.
     1712       end.
     1713     end.
     1714     assign
     1715       v-diasize-change-size = false
     1716     .
     1717   end procedure.
     1718   procedure diasize_set-width :
     1719     define input  parameter p-new-width  as decimal   no-undo .
     1720     define input  parameter p-move-resize as logical   no-undo .
     1721     do
     1722     on error undo, return error return-value
     1723     :
     1724       run diasize_change-width in this-procedure
     1725         (input  (p-new-width - frame Dialog-Frame :width)
     1726         ,input  p-move-resize
     1727         ) .
     1728     end.
     1729   end procedure.
     1730   procedure diasize_position-resize-button :
     1731     do with frame Dialog-Frame
     1732     :
     1733       hide v-diasize-resize-button .
     1734       assign
     1735         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1736                     - 1
     1737                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1738         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1739                     - 1
     1740                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1741       .
     1742       view v-diasize-resize-button .
     1743     end.
     1744   end procedure.
     1745   on alt-right anywhere
     1746   do:
     1747     run diasize_change-width in this-procedure
     1748       (input 1
     1749       ,input true
     1750       ) .
     1751     return no-apply .
     1752   end.
     1753   on alt-left anywhere
     1754   do:
     1755     run diasize_change-width in this-procedure
     1756       (input -1
     1757       ,input true
     1758       ) .
     1759     return no-apply .
     1760   end.
     1761   on alt-down anywhere
     1762   do:
     1763     run diasize_change-height in this-procedure
     1764       (input 1
     1765       ,input true
     1766       ) .
     1767     return no-apply .
     1768   end.
     1769   on alt-up anywhere
     1770   do:
     1771     run diasize_change-height in this-procedure
     1772       (input -1
     1773       ,input true
     1774       ) .
     1775     return no-apply .
     1776   end.
     1777   on alt-enter of frame Dialog-Frame
     1778   do:
     1779     run diasize_maximize in this-procedure
     1780       (input  ?
     1781       ).
     1782     return no-apply .
     1783   end.
     1784   procedure diasize_end-move :
     1785     do
     1786     on error undo, return error return-value
     1787     :
     1788       define variable v-row-delta as decimal   no-undo .
     1789       define variable v-col-delta as decimal   no-undo .
     1790       define variable v-new-row as decimal   no-undo .
     1791       define variable v-new-col as decimal   no-undo .
     1792       assign
     1793         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1794         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1795       .
     1796       assign
     1797         v-row-delta = v-new-row - frame Dialog-Frame :height
     1798         v-col-delta = v-new-col - frame Dialog-Frame :width
     1799       .
     1800       run diasize_change-height in this-procedure
     1801         (input v-row-delta
     1802         ,input true
     1803         ) .
     1804       run diasize_change-width in this-procedure
     1805         (input v-col-delta
     1806         ,input true
     1807         ) .
     1808     end.
     1809   end procedure.
     1810   procedure diasize_maximize :
     1811     define input  parameter p-action as logical   no-undo .
     1812     do
     1813     on error undo, return error return-value
     1814     :
     1815       if p-action = ?
     1816       then do:
     1817         if v-diasize-need-maximize = true
     1818         then do:
     1819           assign
     1820             p-action = true
     1821           .
     1822         end.
     1823         else do:
     1824           assign
     1825             p-action = false
     1826           .
     1827         end.
     1828       end.
     1829       if p-action = true
     1830       then do:
     1831         run diasize_change-height in this-procedure
     1832           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1833               - frame Dialog-Frame :height-chars
     1834           ,input true
     1835           ) .
     1836         run diasize_change-width in this-procedure
     1837           (input session :width-chars
     1838               - frame Dialog-Frame :width-chars
     1839           ,input true
     1840           ) .
     1841         assign
     1842           v-diasize-need-maximize = false
     1843         .
     1844       end.
     1845       else do:
     1846         run diasize_change-width in this-procedure
     1847           (input v-diasize-orig-frame-width
     1848               - frame Dialog-Frame :width-chars
     1849           ,input true
     1850           ) .
     1851         run diasize_change-height in this-procedure
     1852           (input v-diasize-orig-frame-height
     1853               - frame Dialog-Frame :height-chars
     1854           ,input true
     1855           ) .
     1856         assign
     1857           v-diasize-need-maximize = true
     1858         .
     1859       end.
     1860     end.
     1861   end procedure.
     1862   procedure diasize_restore-orig-size :
     1863     do
     1864     on error undo, return error return-value
     1865     :
     1866       assign
     1867         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1868         v-diasize-current-frame-height = frame Dialog-Frame :height
     1869       .
     1870       run diasize_set-height in this-procedure
     1871         (input  v-diasize-orig-frame-height
     1872         ,input  true
     1873         ) .
     1874       run diasize_set-width in this-procedure
     1875         (input  v-diasize-orig-frame-width
     1876         ,input  true
     1877         ) .
     1878     end.
     1879   end procedure.
     1880   procedure diasize_restore-current-size :
     1881     do
     1882     on error undo, return error return-value
     1883     :
     1884       run diasize_set-height in this-procedure
     1885         (input  v-diasize-current-frame-height
     1886         ,input  true
     1887         ) .
     1888       run diasize_set-width in this-procedure
     1889         (input  v-diasize-current-frame-width
     1890         ,input  true
     1891         ) .
     1892     end.
     1893   end procedure.
     1894   procedure diasize_set-browse-handle :
     1895     define input  parameter p-browse-handle as handle   no-undo .
     1896     define buffer buf_temp-browse-handle for temp-browse-handle .
     1897     do
     1898     on error undo, return error return-value
     1899     :
     1900       assign
     1901         v-diasize-browse-handle = p-browse-handle
     1902       .
     1903       for each buf_temp-browse-handle
     1904       on error undo, return error return-value
     1905       :
     1906         delete buf_temp-browse-handle .
     1907       end.
     1908     end.
     1909   end procedure.
     1910   procedure diasize_add_browse :
     1911     define input  parameter p-browse-type   as character no-undo .
     1912     define input  parameter p-browse-handle as handle    no-undo .
     1913     define buffer buf_temp-browse-handle for temp-browse-handle .
     1914     do
     1915     on error undo, return error return-value
     1916     :
     1917       assign
     1918         v-diasize-browse-number = v-diasize-browse-number + 1
     1919       .
     1920       create buf_temp-browse-handle .
     1921       assign
     1922         buf_temp-browse-handle.browse-type   = p-browse-type
     1923         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1924         buf_temp-browse-handle.browse-handle = p-browse-handle
     1925       .
     1926     end.
     1927   end procedure.
     1928   procedure diasize_init :
     1929     define variable v-default-value    as logical   no-undo .
     1930     define variable v-restore-saved    as logical   no-undo .
     1931     define variable v-resize-value-str as character no-undo .
     1932     do
     1933     on error undo, return error return-value
     1934     :
     1935       do with frame Dialog-Frame
     1936       :
     1937         assign
     1938           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1939           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1940           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1941         .
     1942         create button v-diasize-resize-button
     1943         assign
     1944           parent        = frame Dialog-Frame :first-child
     1945           label         = "s"
     1946           height-pixels = 16
     1947           width-pixels  = 16
     1948           visible       = true
     1949           sensitive     = true
     1950           movable       = true
     1951           triggers:
     1952             on end-move persistent run diasize_end-move in this-procedure .
     1953           end triggers.
     1954         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1955         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1956         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1957         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1958         assign
     1959           v-diasize-wndmax = false
     1960         .
     1961         if connected("ub") = true
     1962         then do:
     1963           define variable v-cntxt-db-num        as integer   no-undo .
     1964           define variable v-cntxt-userid        as character no-undo .
     1965           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1966                                             , OUTPUT v-cntxt-userid
     1967                                             ) .
     1968           run gbl/wndpar_r.p
     1969             (input  v-cntxt-db-num
     1970             ,input  v-cntxt-userid
     1971             ,input  'wndmax':U
     1972             ,output v-diasize-wndmax
     1973             ,output v-default-value
     1974             ) .
     1975         end.
     1976         assign
     1977           v-diasize-wndstore = false
     1978         .
     1979         if connected("ub") = true
     1980         then do:
     1981           run gbl/wndpar_r.p
     1982             (input  v-cntxt-db-num
     1983             ,input  v-cntxt-userid
     1984             ,input  'wndstore':U
     1985             ,output v-diasize-wndstore
     1986             ,output v-default-value
     1987             ) .
     1988         end.
     1989         assign
     1990           v-diasize-proc-name = entry(1, program-name(2), '.')
     1991         .
     1992         if v-diasize-wndstore = true
     1993         then do:
     1994           assign
     1995             v-restore-saved = false
     1996           .
     1997           if connected("ub") = true
     1998           then do:
     1999             run gbl/wndsizer.p
     2000               (input  v-cntxt-db-num
     2001               ,input  v-cntxt-userid
     2002               ,input  v-diasize-proc-name
     2003               ,input  'height':u
     2004               ,output v-resize-value-str
     2005               ) .
     2006             if v-resize-value-str <> '':U
     2007             then do:
     2008               run diasize_change-height in this-procedure
     2009                 (input  integer(v-resize-value-str)
     2010                 ,input  true
     2011                 ) .
     2012               assign
     2013                 v-restore-saved = true
     2014               .
     2015             end.
     2016           end.
     2017           if connected("ub") = true
     2018           then do:
     2019             run gbl/wndsizer.p
     2020               (input  v-cntxt-db-num
     2021               ,input  v-cntxt-userid
     2022               ,input  v-diasize-proc-name
     2023               ,input  'width':u
     2024               ,output v-resize-value-str
     2025               ) .
     2026             if v-resize-value-str <> '':U
     2027             then do:
     2028               run diasize_change-width in this-procedure
     2029                 (input  integer(v-resize-value-str)
     2030                 ,input  true
     2031                 ) .
     2032               assign
     2033                 v-restore-saved = true
     2034               .
     2035             end.
     2036           end.
     2037           if v-restore-saved <> true
     2038           then do:
     2039             if v-diasize-wndmax = true
     2040             then do:
     2041               run diasize_maximize in this-procedure
     2042                 (input  true
     2043                 ) .
     2044             end.
     2045           end.
     2046         end.
     2047         else do:
     2048           if v-diasize-wndmax = true
     2049           then do:
     2050             run diasize_maximize in this-procedure
     2051               (input  true
     2052               ) .
     2053           end.
     2054         end.
     2055       end.
     2056     end.
     2057   end procedure.
     2058   procedure diasize_need-full-display :
     2059     define output parameter p-need-full-display as logical   no-undo .
     2060     do
     2061     on error undo, return error return-value
     2062     :
     2063       assign
     2064         p-need-full-display = v-diasize-need-full-display
     2065       .
     2066       assign
     2067         v-diasize-need-full-display = false
     2068       .
     2069     end.
     2070   end procedure.
     2071   procedure get-context :
     2072      define output parameter p-db-num as integer          no-undo.
     2073      define output parameter p-user-id as character        no-undo.
     2074      define variable v-login               as character    no-undo.
     2075      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2076      define buffer buf_user-login  for ub.user-login .
     2077      do
     2078      on error undo, return error
     2079      :
     2080            FIND FIRST buf_sys-ctrl no-lock.
     2081            ASSIGN
     2082               v-login = USERID("ub")
     2083               p-db-num = buf_sys-ctrl.db-num
     2084            .
     2085            FIND FIRST buf_user-login
     2086                 WHERE buf_user-login.db-num = p-db-num
     2087                   AND buf_user-login.user-login = v-login
     2088                 no-lock
     2089                 no-error
     2090                 .
     2091            IF AVAILABLE buf_user-login
     2092            THEN DO:
     2093               assign
     2094                  p-user-id = buf_user-login.user-id
     2095               .
     2096            END.
     2097      end.
     2098   end procedure.
     2099       run diasize_init in this-procedure .
     2100   MAIN-BLOCK:
     2101   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2102      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2103     run init-proc no-error .
     2104     if error-status :error then return .
     2105     run enable_ui in this-procedure .
     2106     if p-doc-mode =  'ПРОСМОТР':U then
     2107        disable b-add b-chg b-del with frame Dialog-Frame .
     2108     wait-for go of frame Dialog-Frame.
     2109   end.
     2110   run disable_ui in this-procedure .
     2111   PROCEDURE disable_UI :
     2112     HIDE FRAME Dialog-Frame.
     2113   END PROCEDURE.
     2114   PROCEDURE enable_UI :
     2115     DISPLAY v-str
     2116         WITH FRAME Dialog-Frame.
     2117     ENABLE B-exit B-add B-chg B-del B-Help BROWSE-1 v-str
     2118         WITH FRAME Dialog-Frame.
     2119     VIEW FRAME Dialog-Frame.
     2120     OPEN QUERY BROWSE-1 FOR EACH tt-doc-line-attr NO-LOCK,       EACH ub.goods WHERE ub.goods.gds-code = tt-doc-line-attr.bk-gds-code NO-LOCK INDEXED-REPOSITION.
     2121   END PROCEDURE.
     2122   PROCEDURE init-proc :
     2123   define buffer bk_goods for goods.
     2124   find first bk_goods where bk_goods.gds-code  = p-gds-code   no-error .
     2125   if error-status :error then return error .
     2126   define variable v-ok as logical   no-undo .
     2127   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2128   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_grp-nabor in g#lib-trn3
     2129   ( input  p-gds-code ,
     2130     output v-ok
     2131   )
     2132   .
     2133    if v-ok then  do:
     2134    message "Выбранная позиция является нетоварной и в наборы не входит !".
     2135    return error .
     2136    end.
     2137   v-str = bk_goods.artic + " " + bk_goods.gds-name .
     2138   define buffer buf_doc-line-attr for doc-line-attr.
     2139           for each buf_doc-line-attr no-lock
     2140             where buf_doc-line-attr.doc-code  = p-doc-code
     2141               and buf_doc-line-attr.gds-code  = p-gds-code
     2142               and lookup ( string  (p-prt-code) , buf_doc-line-attr.attr-code ) > 0
     2143               and lookup ('fl_gds-code':U , buf_doc-line-attr.attr-code ) > 0
     2144               :
     2145               if integer (entry( 2 , buf_doc-line-attr.attr-code)) <> p-prt-code then next.
     2146                 create tt-doc-line-attr.
     2147                 BUFFER-COPY buf_doc-line-attr TO tt-doc-line-attr.
     2148                 assign
     2149                   tt-doc-line-attr.node-code   = integer ( entry ( 2 , buf_doc-line-attr.attr-code ))
     2150                   tt-doc-line-attr.bk-gds-code = integer ( entry ( 3 , buf_doc-line-attr.attr-code ))
     2151                 .
     2152           end.
     2153   END PROCEDURE.
     2154   PROCEDURE save-proc :
     2155   do
     2156     on error undo, return error return-value
     2157     :
     2158   define variable v-ok as logical   no-undo .
     2159   define buffer buf_doc-line-attr for doc-line-attr.
     2160   if p-doc-mode = 'ПРОСМОТР':U then return .
     2161   for each tt-doc-line-attr :
     2162           find first  buf_doc-line-attr where
     2163                       tt-doc-line-attr.doc-code  = buf_doc-line-attr.doc-code
     2164                   and tt-doc-line-attr.gds-code  = buf_doc-line-attr.gds-code
     2165                   and tt-doc-line-attr.attr-code = buf_doc-line-attr.attr-code no-error .
     2166           if available buf_doc-line-attr then do:
     2167             if buf_doc-line-attr.attr-value <> tt-doc-line-attr.attr-value then
     2168             assign
     2169               buf_doc-line-attr.attr-value = tt-doc-line-attr.attr-value
     2170             .
     2171           end.
     2172           else do:
     2173             create buf_doc-line-attr.
     2174             BUFFER-COPY tt-doc-line-attr TO buf_doc-line-attr.
     2175           end.
     2176   end.
     2177     for each buf_doc-line-attr exclusive-lock
     2178       where buf_doc-line-attr.doc-code  = p-doc-code
     2179         and buf_doc-line-attr.gds-code  = p-gds-code
     2180         and lookup ('fl_gds-code':U , buf_doc-line-attr.attr-code ) > 0
     2181         and lookup ( string(p-prt-code) , buf_doc-line-attr.attr-code ) > 0
     2182         :
     2183           find first  tt-doc-line-attr where
     2184                       tt-doc-line-attr.doc-code  = buf_doc-line-attr.doc-code
     2185                   and tt-doc-line-attr.gds-code  = buf_doc-line-attr.gds-code
     2186                   and tt-doc-line-attr.attr-code = buf_doc-line-attr.attr-code no-error .
     2187           if available tt-doc-line-attr then do:
     2188             if buf_doc-line-attr.attr-value <> tt-doc-line-attr.attr-value then
     2189             assign
     2190               buf_doc-line-attr.attr-value = tt-doc-line-attr.attr-value
     2191             .
     2192           end.
     2193           else do:
     2194             delete buf_doc-line-attr.
     2195           end.
     2196     end.
     2197   define variable v-qnty as decimal   no-undo .
     2198   define variable v-qnty-prt as decimal   no-undo .
     2199   define buffer buf_goods for goods.
     2200   define buffer buf2_goods for goods.
     2201   define buffer buf2_doc-line for doc-line.
     2202   find  first buf_goods no-lock where
     2203              buf_goods.gds-code  = p-gds-code no-error .
     2204   define buffer ready_trn-doc for trn-doc.
     2205   define buffer nakl_trn-doc for trn-doc.
     2206   find first nakl_trn-doc  no-lock where nakl_trn-doc.doc-code  = p-doc-code no-error .
     2207   if error-status :error then return .
     2208   find first ready_trn-doc no-lock where ready_trn-doc.doc-code = nakl_trn-doc.out-code no-error .
     2209     if error-status :error
     2210     then do:
     2211       message
     2212           vss-workfile vss-revision vss-description skip
     2213           "Не найден документ-щепка в статусе ГОТОВ" skip
     2214           error-status :get-message(1)
     2215           return-value
     2216           view-as alert-box error .
     2217       return error.
     2218     end.
     2219   for each gds-dtl exclusive-lock where gds-dtl.doc-code  = p-doc-code and
     2220                                         gds-dtl.artic     = buf_goods.artic       and
     2221                                         gds-dtl.prod-type = buf_goods.prod-type   and
     2222                                         gds-dtl.prod-code = buf_goods.prod-code   and
     2223                                         gds-dtl.prt-code  = p-prt-code
     2224     :
     2225       v-qnty = 0 .
     2226       v-qnty-prt = 0 .
     2227       for each buf2_doc-line no-lock where buf2_doc-line.doc-code  = ready_trn-doc.doc-code :
     2228         find first buf2_goods no-lock where
     2229                   buf2_goods.artic     = buf2_doc-line.artic       and
     2230                   buf2_goods.prod-type = buf2_doc-line.prod-type   and
     2231                   buf2_goods.prod-code = buf2_doc-line.prod-code   no-error .
     2232   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2233   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_grp-nabor in g#lib-trn3
     2234   ( input  buf2_goods.gds-code ,
     2235     output v-ok
     2236   )
     2237   .
     2238           if v-ok then do:
     2239               run lineattr-value-flora-gds (
     2240                   input   p-doc-code       ,
     2241                   input   buf_goods.gds-code   ,
     2242                   input   gds-dtl.prt-code  ,
     2243                   input   buf2_goods.gds-code    ,
     2244                   input   'fl_gds-code':U        ,
     2245                   output  v-qnty       ).
     2246               v-qnty-prt = v-qnty-prt + v-qnty .
     2247            end.
     2248       end.
     2249       if v-qnty-prt <> gds-dtl.fact-qnty then do:
     2250          p-make = true .
     2251           find first doc-line exclusive-lock where
     2252                    doc-line.doc-code   = gds-dtl.doc-code  and
     2253                    doc-line.artic      = gds-dtl.artic     and
     2254                    doc-line.prod-type  = gds-dtl.prod-type and
     2255                    doc-line.prod-code  = gds-dtl.prod-code no-error .
     2256         if not t-doc.flag_ and t-doc.status_ <> 'разрешен':U then do:
     2257   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2258   assign
     2259     chg-qnty = v-qnty-prt - ub.gds-dtl.doc-qnty
     2260   .
     2261     run trg/rsrv-dtl.p
     2262       ( input        ParParentProc
     2263       , input        'reserv':U
     2264       , buffer       ub.gds-dtl
     2265       , input-output chg-qnty
     2266       , input-output ub.doc-line.price-base
     2267       , input-output ub.doc-line.price-rubl
     2268       , input        -1
     2269       , input         "" ) no-error .
     2270     if error-status :error
     2271     then do:
     2272       message
     2273         vss-workfile vss-revision vss-description skip
     2274         error-status :get-message(1) skip
     2275         return-value skip
     2276         "rsrv-dtl.p doc"
     2277         view-as alert-box error
     2278   .
     2279       undo, return error return-value .
     2280     end.
     2281     if lookup( t-doc.doc-type, 'рас,спи,возврат':U ) > 0 or
     2282        ( t-doc.doc-type = 'при':U and
     2283          t-doc.internal = yes )
     2284     then do:
     2285       assign
     2286         ub.doc-line.doc-qnty  = ub.doc-line.doc-qnty + chg-qnty
     2287         ub.doc-line.fact-qnty = ub.doc-line.doc-qnty
     2288       .
     2289       if ub.doc-line.doc-density <> ? and ub.doc-line.doc-density <> 0 then do:
     2290         assign
     2291           ub.doc-line.cli-qnty = ub.doc-line.doc-qnty * ub.doc-line.doc-density
     2292         .
     2293       end.
     2294       else do:
     2295         assign
     2296           ub.doc-line.cli-qnty = ub.doc-line.doc-qnty / ub.doc-line.cli-base-rate
     2297         .
     2298       end.
     2299     end.
     2300     assign
     2301       ub.gds-dtl.doc-qnty  = ub.gds-dtl.doc-qnty + chg-qnty
     2302       ub.gds-dtl.fact-qnty = ub.gds-dtl.doc-qnty
     2303     .
     2304            end.
     2305         else do:
     2306   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2307   assign
     2308     chg-qnty = v-qnty-prt - ub.gds-dtl.fact-qnty
     2309   .
     2310     run trg/rsrv-dtl.p
     2311       ( input        ParParentProc
     2312       , input        'reserv':U
     2313       , buffer       ub.gds-dtl
     2314       , input-output chg-qnty
     2315       , input-output ub.doc-line.price-base
     2316       , input-output ub.doc-line.price-rubl
     2317       , input        -1
     2318       , input         "" ) no-error .
     2319     if error-status :error
     2320     then do:
     2321       message
     2322         vss-workfile vss-revision vss-description skip
     2323         error-status :get-message(1) skip
     2324         return-value skip
     2325         "rsrv-dtl.p fact"
     2326         view-as alert-box error
     2327   .
     2328       undo, return error return-value .
     2329     end.
     2330     if lookup( t-doc.doc-type, 'рас,спи,возврат':U ) > 0 or
     2331        ( t-doc.doc-type = 'при':U and
     2332          t-doc.internal = yes )
     2333     then do:
     2334       assign
     2335         ub.doc-line.fact-qnty = ub.doc-line.fact-qnty + chg-qnty
     2336       .
     2337     end.
     2338     assign
     2339       ub.gds-dtl.fact-qnty = ub.gds-dtl.fact-qnty + chg-qnty
     2340     .
     2341         end.
     2342         find first buf2_goods no-lock where
     2343                   buf2_goods.artic     = doc-line.artic       and
     2344                   buf2_goods.prod-type = doc-line.prod-type   and
     2345                   buf2_goods.prod-code = doc-line.prod-code   no-error .
     2346         if gds-dtl.doc-qnty = 0 then do:
     2347               run str/out-add.p
     2348                             (parparentproc,
     2349                              recid(nakl_trn-doc),
     2350                              recid(doc-line),
     2351                              recid(gds-dtl),
     2352                              recid(buf2_goods),
     2353                              "delete",
     2354                              ?) no-error.
     2355         end.
     2356       end.
     2357   end.
     2358   end.
     2359   end procedure.
