        1   DEFINE TEMP-TABLE tt-rvs-line-pump NO-UNDO LIKE ub.c-rvs-line-pump.
        2   define input parameter parparentproc    as widget-handle no-undo.
        3   define input parameter p-rec-line-pump as recid     no-undo.
        4   define input parameter p-mode          as character no-undo.
        5   define input parameter p-title         as character no-undo.
        6   define variable vss-revision    as character no-undo initial "$Revision$":U.
        7   define variable vss-author      as character no-undo initial "$Author$":U.
        8   define variable vss-date        as character no-undo initial "$Date$":U.
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       10   define variable vss-archive     as character no-undo initial "$Archive$":U.
       11   define variable vss-description as character no-undo initial "Дынне с ТРК":U.
       12   define new global shared variable g#language as character no-undo .
       13   if g#language <> '' and g#language <> 'rus':U then do:
       14     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       15   end.
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define new global shared variable g#library  as handle no-undo .
      116   define new global shared variable g#library2 as handle no-undo .
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118     define variable v-cntxt-db-num        as integer   no-undo .
      119     define variable v-cntxt-userid        as character no-undo .
      120     define variable v-cntxt-level         as character no-undo .
      121     define variable v-cntxt-host-code-obj as integer   no-undo .
      122     define variable v-cntxt-obj-type      as character no-undo .
      123     define variable v-cntxt-obj-code      as integer   no-undo .
      124     define variable v-cntxt-db-num-obj    as integer   no-undo .
      125     define variable v-cntxt-is-admin      as logical   no-undo .
      126   define variable g-log as logical no-undo.
      127   define buffer bf_rvs-doc          for c-rvs-doc.
      128   define buffer prev_icnt-line      for icnt-line.
      129   define buffer prev_rvs-line-pump  for c-rvs-line-pump.
      130   define buffer bf_goods            for goods.
      131   DEFINE BUTTON b-cancel AUTO-END-KEY
      132        LABEL "&Отменить"
      133        SIZE 10 BY 1
      134        BGCOLOR 8 .
      135   DEFINE BUTTON b-help
      136        LABEL "&Помощь"
      137        SIZE 10 BY 1
      138        BGCOLOR 8 .
      139   DEFINE BUTTON b-save AUTO-GO
      140        LABEL "&Сохранить"
      141        SIZE 10 BY 1
      142        BGCOLOR 8 .
      143   DEFINE QUERY Dialog-Frame FOR
      144         tt-rvs-line-pump SCROLLING.
      145   DEFINE FRAME Dialog-Frame
      146        b-save AT ROW 1.13 COL 1.5
      147        b-cancel AT ROW 1.13 COL 11.75
      148        b-help AT ROW 1.13 COL 22.13
      149        tt-rvs-line-pump.meas-el-cnt AT ROW 2.46 COL 25 COLON-ALIGNED
      150             LABEL "Измер. электр. счетчика"
      151             VIEW-AS FILL-IN
      152             SIZE 23 BY 1
      153        tt-rvs-line-pump.state-el-cnt AT ROW 2.46 COL 73.75 COLON-ALIGNED
      154             LABEL "Показ. электр. счетчика"
      155             VIEW-AS FILL-IN
      156             SIZE 23 BY 1
      157        tt-rvs-line-pump.meas-am-cnt AT ROW 3.67 COL 25 COLON-ALIGNED
      158             LABEL "Сумма по измер."
      159             VIEW-AS FILL-IN
      160             SIZE 23 BY 1
      161        tt-rvs-line-pump.state-am-cnt AT ROW 3.67 COL 73.75 COLON-ALIGNED
      162             LABEL "Сумма по показ."
      163             VIEW-AS FILL-IN
      164             SIZE 23 BY 1
      165        tt-rvs-line-pump.meas-cf-cnt AT ROW 4.88 COL 25 COLON-ALIGNED
      166             LABEL "Кол-во наливов по измер."
      167             VIEW-AS FILL-IN
      168             SIZE 19 BY 1
      169        tt-rvs-line-pump.state-cf-cnt AT ROW 4.88 COL 73.75 COLON-ALIGNED
      170             LABEL "Кол-во наливов по показ."
      171             VIEW-AS FILL-IN
      172             SIZE 19 BY 1
      173        tt-rvs-line-pump.meas-mh-cnt AT ROW 6.08 COL 25 COLON-ALIGNED
      174             LABEL "Измер. мех. счетчика"
      175             VIEW-AS FILL-IN
      176             SIZE 23 BY 1
      177        tt-rvs-line-pump.state-mh-cnt AT ROW 6.08 COL 73.75 COLON-ALIGNED
      178             LABEL "Показ. мех. счетчика"
      179             VIEW-AS FILL-IN
      180             SIZE 23 BY 1
      181        tt-rvs-line-pump.meas-mh-qnty AT ROW 7.29 COL 25 COLON-ALIGNED
      182             LABEL "Измер. оборот"
      183             VIEW-AS FILL-IN
      184             SIZE 17 BY 1
      185        tt-rvs-line-pump.state-mh-qnty AT ROW 7.29 COL 73.75 COLON-ALIGNED
      186             VIEW-AS FILL-IN
      187             SIZE 17 BY 1
      188        tt-rvs-line-pump.meas-am-qnty AT ROW 8.5 COL 25 COLON-ALIGNED
      189             LABEL "Измер. сумма оборота"
      190             VIEW-AS FILL-IN
      191             SIZE 16 BY 1
      192        tt-rvs-line-pump.state-am-qnty AT ROW 8.5 COL 73.75 COLON-ALIGNED
      193             VIEW-AS FILL-IN
      194             SIZE 16 BY 1
      195        tt-rvs-line-pump.meas-cf-qnty AT ROW 9.71 COL 25 COLON-ALIGNED
      196             LABEL "Измер. кол-во наливов"
      197             VIEW-AS FILL-IN
      198             SIZE 11 BY 1
      199        tt-rvs-line-pump.state-cf-qnty AT ROW 9.71 COL 73.75 COLON-ALIGNED
      200             LABEL "Факт кол-во наливов"
      201             VIEW-AS FILL-IN
      202             SIZE 11 BY 1
      203        SPACE(12.74) SKIP(0.11)
      204       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      205            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      206            TITLE "Данные с ТРК"
      207            CANCEL-BUTTON b-cancel.
      208   ASSIGN
      209          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      210          FRAME Dialog-Frame:HIDDEN           = TRUE.
      211   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      212   DO:
      213     APPLY "END-ERROR":U TO SELF.
      214   END.
      215   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      216   DO:
      217     define buffer other-line-pump for ub.rvs-line-pump.
      218         if input frame Dialog-Frame tt-rvs-line-pump.state-el-cnt <> tt-rvs-line-pump.state-el-cnt      then run us-state-el-cnt.   if tt-rvs-line-pump.state-el-cnt < 0 then do:      message "Показания электронного счетчика отрицательные."              "Будем сохранять?"      view-as alert-box question buttons yes-no update g-log.      if not g-log then do:         apply "entry" to state-el-cnt in frame Dialog-Frame.          return no-apply.      end.   end.
      219         if input frame Dialog-Frame tt-rvs-line-pump.state-mh-cnt <> tt-rvs-line-pump.state-mh-cnt      then run us-state-mh-cnt.   if tt-rvs-line-pump.state-mh-cnt < 0 then do:      message "Показания механического счетчика отрицательные."              "Будем сохранять?"      view-as alert-box question buttons yes-no update g-log.      if not g-log then do:         apply "entry" to state-mh-cnt in frame Dialog-Frame.          return no-apply.      end.   end.
      220         if input frame Dialog-Frame tt-rvs-line-pump.state-mh-qnty <> tt-rvs-line-pump.state-mh-qnty      then run us-state-mh-qnty.   if tt-rvs-line-pump.state-mh-qnty < 0 then do:      message "Факт оборот отрицательный."              "Будем сохранять?"      view-as alert-box question buttons yes-no update g-log.      if not g-log then do:         apply "entry" to state-mh-qnty in frame Dialog-Frame.          return no-apply.      end.   end.
      221         if input frame Dialog-Frame tt-rvs-line-pump.state-cf-cnt <> tt-rvs-line-pump.state-cf-cnt      then run us-state-cf-cnt.   if tt-rvs-line-pump.state-cf-cnt < 0 then do:      message "Кол-во наливов по показаниям отрицательное."              "Будем сохранять?"      view-as alert-box question buttons yes-no update g-log.      if not g-log then do:         apply "entry" to state-cf-cnt in frame Dialog-Frame.          return no-apply.      end.   end.
      222         if input frame Dialog-Frame tt-rvs-line-pump.state-cf-qnty <> tt-rvs-line-pump.state-cf-qnty      then run us-state-cf-qnty.   if tt-rvs-line-pump.state-cf-qnty < 0 then do:      message "Факт кол-во наливов отрицательное."              "Будем сохранять?"      view-as alert-box question buttons yes-no update g-log.      if not g-log then do:         apply "entry" to state-cf-qnty in frame Dialog-Frame.          return no-apply.      end.   end.
      223         if input frame Dialog-Frame tt-rvs-line-pump.state-am-cnt <> tt-rvs-line-pump.state-am-cnt      then run us-state-am-cnt.   if tt-rvs-line-pump.state-am-cnt < 0 then do:      message "Сумма по показаниям отрицательная."              "Будем сохранять?"      view-as alert-box question buttons yes-no update g-log.      if not g-log then do:         apply "entry" to state-am-cnt in frame Dialog-Frame.          return no-apply.      end.   end.
      224         if input frame Dialog-Frame tt-rvs-line-pump.state-am-qnty <> tt-rvs-line-pump.state-am-qnty      then run us-state-am-qnty.   if tt-rvs-line-pump.state-am-qnty < 0 then do:      message "Факт сумма оборота за смену отрицательная."              "Будем сохранять?"      view-as alert-box question buttons yes-no update g-log.      if not g-log then do:         apply "entry" to state-am-qnty in frame Dialog-Frame.          return no-apply.      end.   end.
      225     find first c-rvs-line-pump where  recid(c-rvs-line-pump) =  p-rec-line-pump no-error.
      226     buffer-copy tt-rvs-line-pump to c-rvs-line-pump.
      227     for each other-line-pump where
      228              other-line-pump.rvs-code    = c-rvs-line-pump.rvs-code    and
      229              other-line-pump.obj-type    = c-rvs-line-pump.obj-type    and
      230              other-line-pump.obj-code    = c-rvs-line-pump.obj-code    and
      231              other-line-pump.gds-code    = c-rvs-line-pump.gds-code    and
      232              other-line-pump.pump-code   = c-rvs-line-pump.pump-code   and
      233              other-line-pump.nozzle-code = c-rvs-line-pump.nozzle-code :
      234       if  recid(other-line-pump) = p-rec-line-pump then do: next. end.
      235       assign other-line-pump.state-am-cnt  = c-rvs-line-pump.state-am-cnt
      236              other-line-pump.state-am-qnty = c-rvs-line-pump.state-am-qnty
      237              other-line-pump.state-cf-cnt  = c-rvs-line-pump.state-cf-cnt
      238              other-line-pump.state-cf-qnty = c-rvs-line-pump.state-cf-qnty
      239              other-line-pump.state-el-cnt  = c-rvs-line-pump.state-el-cnt
      240              other-line-pump.state-mh-cnt  = c-rvs-line-pump.state-mh-cnt
      241              other-line-pump.state-mh-qnty = c-rvs-line-pump.state-mh-qnty.
      242     end.
      243   END.
      244   ON LEAVE OF tt-rvs-line-pump.state-am-cnt IN FRAME Dialog-Frame
      245   DO:
      246   if input frame Dialog-Frame tt-rvs-line-pump.state-am-cnt <> tt-rvs-line-pump.state-am-cnt then do:
      247     run us-state-am-cnt no-error.
      248     if error-status:error then return no-apply.
      249   end.
      250   END.
      251   ON return OF tt-rvs-line-pump.state-am-cnt IN FRAME Dialog-Frame
      252   DO:
      253      apply "entry" to tt-rvs-line-pump.state-cf-cnt in frame Dialog-Frame.
      254    return no-apply.
      255   END.
      256   ON LEAVE OF tt-rvs-line-pump.state-am-qnty IN FRAME Dialog-Frame
      257   DO:
      258   if input frame Dialog-Frame tt-rvs-line-pump.state-am-qnty <> tt-rvs-line-pump.state-am-qnty then do:
      259     run us-state-am-qnty no-error.
      260     if error-status:error then return no-apply.
      261   end.
      262   END.
      263   ON return OF tt-rvs-line-pump.state-am-qnty IN FRAME Dialog-Frame
      264   DO:
      265      apply "entry" to tt-rvs-line-pump.state-cf-qnty in frame Dialog-Frame.
      266    return no-apply.
      267   END.
      268   ON LEAVE OF tt-rvs-line-pump.state-cf-cnt IN FRAME Dialog-Frame
      269   DO:
      270   if input frame Dialog-Frame tt-rvs-line-pump.state-cf-cnt <> tt-rvs-line-pump.state-cf-cnt then do:
      271     run us-state-cf-cnt no-error.
      272     if error-status:error then return no-apply.
      273   end.
      274   END.
      275   ON return OF tt-rvs-line-pump.state-cf-cnt IN FRAME Dialog-Frame
      276   DO:
      277      apply "entry" to tt-rvs-line-pump.state-mh-cnt in frame Dialog-Frame.
      278    return no-apply.
      279   END.
      280   ON LEAVE OF tt-rvs-line-pump.state-cf-qnty IN FRAME Dialog-Frame
      281   DO:
      282   if input frame Dialog-Frame tt-rvs-line-pump.state-cf-qnty <> tt-rvs-line-pump.state-cf-qnty then do:
      283     run us-state-cf-qnty no-error.
      284     if error-status:error then return no-apply.
      285   end.
      286   END.
      287   ON return OF tt-rvs-line-pump.state-cf-qnty IN FRAME Dialog-Frame
      288   DO:
      289      apply "entry" to b-save in frame Dialog-Frame.
      290    return no-apply.
      291   END.
      292   ON LEAVE OF tt-rvs-line-pump.state-el-cnt IN FRAME Dialog-Frame
      293   DO:
      294   if input frame Dialog-Frame tt-rvs-line-pump.state-el-cnt <> tt-rvs-line-pump.state-el-cnt then do:
      295     run us-state-el-cnt no-error.
      296     if error-status:error then return no-apply.
      297   end.
      298   END.
      299   ON return OF tt-rvs-line-pump.state-el-cnt IN FRAME Dialog-Frame
      300   DO:
      301    apply "entry" to tt-rvs-line-pump.state-am-cnt in frame Dialog-Frame.
      302    return no-apply.
      303   END.
      304   ON LEAVE OF tt-rvs-line-pump.state-mh-cnt IN FRAME Dialog-Frame
      305   DO:
      306   if input frame Dialog-Frame tt-rvs-line-pump.state-mh-cnt <> tt-rvs-line-pump.state-mh-cnt then do:
      307     run us-state-mh-cnt no-error.
      308     if error-status:error then return no-apply.
      309   end.
      310   END.
      311   ON return OF tt-rvs-line-pump.state-mh-cnt IN FRAME Dialog-Frame
      312   DO:
      313      apply "entry" to tt-rvs-line-pump.state-mh-qnty in frame Dialog-Frame.
      314    return no-apply.
      315   END.
      316   ON LEAVE OF tt-rvs-line-pump.state-mh-qnty IN FRAME Dialog-Frame
      317   DO:
      318   if input frame Dialog-Frame tt-rvs-line-pump.state-mh-qnty <> tt-rvs-line-pump.state-mh-qnty then do:
      319     run us-state-mh-qnty no-error.
      320     if error-status:error then return no-apply.
      321   end.
      322   END.
      323   ON return OF tt-rvs-line-pump.state-mh-qnty IN FRAME Dialog-Frame
      324   DO:
      325      apply "entry" to tt-rvs-line-pump.state-am-qnty in frame Dialog-Frame.
      326    return no-apply.
      327   END.
      328   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      329   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      330   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   on help of frame Dialog-Frame
      332   do:
      333     run gbl/app_help.p
      334       (input this-procedure :file-name
      335       ,input ''
      336       ,input ?
      337       ) no-error.
      338     if error-status :error then do:
      339       message
      340         "Ошибка при вызове помощи"
      341         error-status :get-message(1)
      342         view-as alert-box .
      343     end.
      344   end.
      345   run minbtn-set in this-procedure .
      346   on choose of b-help in frame Dialog-Frame
      347   do:
      348     apply "help":u to frame Dialog-Frame .
      349   end.
      350   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      351   procedure minbtn-set :
      352       do
      353           on error undo, return error return-value
      354           :
      355           define variable ii              as integer       no-undo .
      356           define variable fh              as widget-handle no-undo .
      357           define variable hh              as widget-handle no-undo .
      358           define variable v-h             as handle        extent 4 no-undo .
      359           define variable v-name-button   as character     no-undo .
      360           define variable v-help-old-x    as decimal       no-undo .
      361           define variable v-help-old-y    as decimal       no-undo .
      362           define variable v-help-old-size as decimal       no-undo .
      363           define variable v-frame-width   as decimal       no-undo .
      364           define variable jj              as integer       no-undo .
      365           do
      366               on error undo, return error
      367               :
      368               assign
      369                   v-frame-width = frame Dialog-Frame:width - 0.3
      370                   fh            = frame Dialog-Frame:first-child
      371                   hh            = fh:first-child
      372                   ii            = 1
      373                   .
      374               do while valid-handle(hh):
      375                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      376                   do:
      377                       case lc(hh:name) :
      378                           when "b-help" then
      379                               do:
      380                                   hh:load-image-up("cmp/b-help.bmp":u) .
      381                                   hh:load-image-down("cmp/b-help.bmp":u) .
      382                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      383                                   hh:TOOLTIP = "Помощь" .
      384                                   v-help-old-x = hh:column .
      385                                   v-help-old-y = hh:row    .
      386                                   v-help-old-size = hh:width .
      387                                   hh:width-chars = 2.5 .
      388                               end.
      389                           when "b-print" then
      390                               do:
      391                                   hh:load-image("cmp/b-print.bmp":u) .
      392                                   hh:TOOLTIP = "Печать" .
      393                                   v-h[ii] = hh:handle .
      394                                   ii = ii + 1 .
      395                                   hh:width-chars = 3 .
      396                               end.
      397                           when "b-history" or
      398                           when "b-hist" then
      399                               do:
      400                                   hh:load-image("cmp/b-hist.bmp":u) .
      401                                   hh:TOOLTIP = "История" .
      402                                   v-h[ii] = hh:handle .
      403                                   ii = ii + 1 .
      404                                   hh:width-chars = 3 .
      405                               end.
      406                           when "b-sch" then
      407                               do:
      408                                   hh:load-image("cmp/b-sch.bmp":u) .
      409                                   hh:TOOLTIP = "Установка Фильтра" .
      410                                   v-h[ii] = hh:handle .
      411                                   ii = ii + 1 .
      412                                   hh:width-chars = 3 .
      413                               end.
      414                           when "b-hist-user" then
      415                               do:
      416                                   hh:load-image("cmp/b-hist.bmp":u) .
      417                                   hh:TOOLTIP = "История пользователя" .
      418                                   ii = ii + 1 .
      419                               end.
      420                       end case.
      421                   end.
      422                   hh = hh:next-sibling.
      423               end.
      424               b-help:column = v-frame-width - b-help:width-chars.
      425               jj = 0.
      426               repeat ii = 4 to 1 by -1 :
      427                   if valid-handle (v-h[ii] ) then
      428                   do:
      429                       jj  = jj + 1 .
      430                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      431                       v-h[ii]:row    = v-help-old-y .
      432                   end.
      433               end.
      434           end.
      435       end.
      436   end procedure.
      437   MAIN-BLOCK:
      438   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      439      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      440   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      441     run mainmenu_getcntxt in parparentproc
      442       (output v-cntxt-db-num
      443       ,output v-cntxt-userid
      444       ,output v-cntxt-level
      445       ,output v-cntxt-host-code-obj
      446       ,output v-cntxt-obj-type
      447       ,output v-cntxt-obj-code
      448       ,output v-cntxt-db-num-obj
      449       ,output v-cntxt-is-admin
      450       ) .
      451     if p-mode = 'ИЗМЕНЕНИЕ':U then
      452        find first c-rvs-line-pump where recid(c-rvs-line-pump) =  p-rec-line-pump no-error.
      453     else
      454        find first c-rvs-line-pump where recid(c-rvs-line-pump) =  p-rec-line-pump no-lock no-error.
      455     if not available c-rvs-line-pump then do:
      456        message "Неверно переданы параметры."
      457                "Не найдена строка данных с ТРК с recid " p-rec-line-pump " ."
      458        view-as alert-box error.
      459        return error.
      460     end.
      461     create tt-rvs-line-pump.
      462     buffer-copy c-rvs-line-pump to tt-rvs-line-pump.
      463     release c-rvs-line-pump.
      464     find first bf_rvs-doc where bf_rvs-doc.rvs-code = tt-rvs-line-pump.rvs-code.
      465     RUN enable_UI.
      466     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      467        disable tt-rvs-line-pump.state-el-cnt tt-rvs-line-pump.state-am-cnt tt-rvs-line-pump.state-cf-cnt tt-rvs-line-pump.state-mh-cnt tt-rvs-line-pump.state-mh-qnty tt-rvs-line-pump.state-am-qnty tt-rvs-line-pump.state-cf-qnty with frame Dialog-Frame.
      468     end.
      469     if p-mode <> 'ИЗМЕНЕНИЕ':U then
      470       disable b-save with frame Dialog-Frame.
      471      if tt-rvs-line-pump.icnt-code <> ? then do:
      472         find prev_icnt-line where prev_icnt-line.doc-code    = tt-rvs-line-pump.icnt-code   and
      473                                   prev_icnt-line.obj-type    = tt-rvs-line-pump.obj-type    and
      474                                   prev_icnt-line.obj-code    = tt-rvs-line-pump.obj-code    and
      475                                   prev_icnt-line.pump-code   = tt-rvs-line-pump.pump-code   and
      476                                   prev_icnt-line.nozzle-code = tt-rvs-line-pump.nozzle-code no-lock no-error.
      477         if not available prev_icnt-line then do:
      478            message "Фатальная ошибка. Нет инвентаризации счетчика № " tt-rvs-line-pump.icnt-code " !" skip
      479                 "Объект: " tt-rvs-line-pump.obj-type " " tt-rvs-line-pump.obj-code skip
      480                 "ТРК: " tt-rvs-line-pump.pump-code skip
      481                 "Пистолет: " tt-rvs-line-pump.nozzle-code
      482            view-as alert-box error.
      483         end.
      484      end.
      485      if tt-rvs-line-pump.rvs-prev-code <> ? then do:
      486         find first prev_rvs-line-pump where prev_rvs-line-pump.rvs-code    = tt-rvs-line-pump.rvs-prev-code and
      487                                             prev_rvs-line-pump.obj-type    = tt-rvs-line-pump.obj-type      and
      488                                             prev_rvs-line-pump.obj-code    = tt-rvs-line-pump.obj-code      and
      489                                             prev_rvs-line-pump.pl-code     = tt-rvs-line-pump.pl-code       and
      490                                             prev_rvs-line-pump.gds-code    = tt-rvs-line-pump.gds-code      and
      491                                             prev_rvs-line-pump.pump-code   = tt-rvs-line-pump.pump-code     and
      492                                             prev_rvs-line-pump.nozzle-code = tt-rvs-line-pump.nozzle-code   no-lock no-error.
      493         if not available prev_rvs-line-pump then do:
      494            find first bf_goods where bf_goods.gds-code = tt-rvs-line-pump.gds-code no-lock.
      495            message "Фатальная ошибка. Нет сверки № " tt-rvs-line-pump.rvs-prev-code " !" skip
      496                 "Объект: " tt-rvs-line-pump.obj-type " " tt-rvs-line-pump.obj-code skip
      497                 "Складское место: " tt-rvs-line-pump.pl-code skip
      498                 "Товар: " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name skip
      499                 "ТРК: " tt-rvs-line-pump.pump-code skip
      500                 "Пистолет: " tt-rvs-line-pump.nozzle-code
      501            view-as alert-box error.
      502         end.
      503      end.
      504     assign frame Dialog-Frame:title = frame Dialog-Frame:title + " - " + p-mode
      505     + " - " +  p-title.
      506     WAIT-FOR GO OF FRAME Dialog-Frame.
      507   END.
      508   RUN disable_UI.
      509   PROCEDURE disable_UI :
      510     HIDE FRAME Dialog-Frame.
      511   END PROCEDURE.
      512   PROCEDURE enable_UI :
      513     OPEN QUERY Dialog-Frame FOR EACH tt-rvs-line-pump SHARE-LOCK.
      514     GET FIRST Dialog-Frame.
      515     IF AVAILABLE tt-rvs-line-pump THEN
      516       DISPLAY tt-rvs-line-pump.meas-el-cnt tt-rvs-line-pump.state-el-cnt
      517             tt-rvs-line-pump.meas-am-cnt tt-rvs-line-pump.state-am-cnt
      518             tt-rvs-line-pump.meas-cf-cnt tt-rvs-line-pump.state-cf-cnt
      519             tt-rvs-line-pump.meas-mh-cnt tt-rvs-line-pump.state-mh-cnt
      520             tt-rvs-line-pump.meas-mh-qnty tt-rvs-line-pump.state-mh-qnty
      521             tt-rvs-line-pump.meas-am-qnty tt-rvs-line-pump.state-am-qnty
      522             tt-rvs-line-pump.meas-cf-qnty tt-rvs-line-pump.state-cf-qnty
      523         WITH FRAME Dialog-Frame.
      524     ENABLE b-save b-cancel b-help tt-rvs-line-pump.state-el-cnt
      525            tt-rvs-line-pump.state-am-cnt tt-rvs-line-pump.state-cf-cnt
      526            tt-rvs-line-pump.state-mh-cnt tt-rvs-line-pump.state-mh-qnty
      527            tt-rvs-line-pump.state-am-qnty tt-rvs-line-pump.state-cf-qnty
      528         WITH FRAME Dialog-Frame.
      529     VIEW FRAME Dialog-Frame.
      530   END PROCEDURE.
      531   PROCEDURE us-state-am-cnt :
      532   assign frame Dialog-Frame tt-rvs-line-pump.state-am-cnt.
      533   assign tt-rvs-line-pump.state-am-qnty = tt-rvs-line-pump.state-am-cnt -
      534                                           (if tt-rvs-line-pump.rvs-prev-code <> ? then
      535                                            prev_rvs-line-pump.state-am-cnt else ?).
      536   display tt-rvs-line-pump.state-am-qnty with frame Dialog-Frame.
      537   END PROCEDURE.
      538   PROCEDURE us-state-am-qnty :
      539   assign frame Dialog-Frame tt-rvs-line-pump.state-am-qnty.
      540   assign tt-rvs-line-pump.state-am-cnt = tt-rvs-line-pump.state-am-qnty +
      541                                           (if tt-rvs-line-pump.rvs-prev-code <> ? then
      542                                            prev_rvs-line-pump.state-am-cnt else ?).
      543   display tt-rvs-line-pump.state-am-cnt with frame Dialog-Frame.
      544   END PROCEDURE.
      545   PROCEDURE us-state-cf-cnt :
      546   assign frame Dialog-Frame tt-rvs-line-pump.state-cf-cnt.
      547   assign tt-rvs-line-pump.state-cf-qnty = tt-rvs-line-pump.state-cf-cnt -
      548                                           (if tt-rvs-line-pump.rvs-prev-code <> ? then
      549                                            prev_rvs-line-pump.state-cf-cnt else ?).
      550   display tt-rvs-line-pump.state-cf-qnty with frame Dialog-Frame.
      551   END PROCEDURE.
      552   PROCEDURE us-state-cf-qnty :
      553   assign frame Dialog-Frame tt-rvs-line-pump.state-cf-qnty.
      554   assign tt-rvs-line-pump.state-cf-cnt = tt-rvs-line-pump.state-cf-qnty +
      555                                           (if tt-rvs-line-pump.rvs-prev-code <> ? then
      556                                            prev_rvs-line-pump.state-cf-cnt else ?).
      557   display tt-rvs-line-pump.state-cf-cnt with frame Dialog-Frame.
      558   END PROCEDURE.
      559   PROCEDURE us-state-el-cnt :
      560   assign frame Dialog-Frame tt-rvs-line-pump.state-el-cnt.
      561   assign tt-rvs-line-pump.state-mh-cnt = tt-rvs-line-pump.state-el-cnt -
      562                                          (if tt-rvs-line-pump.icnt-code <> ? then (prev_icnt-line.state-el-cnt - prev_icnt-line.state-mh-cnt) else 0)
      563          tt-rvs-line-pump.state-mh-qnty = tt-rvs-line-pump.state-mh-cnt -
      564                                          (if tt-rvs-line-pump.rvs-prev-code <> ? then prev_rvs-line-pump.state-mh-cnt else ?).
      565   display tt-rvs-line-pump.state-mh-cnt tt-rvs-line-pump.state-mh-qnty with frame Dialog-Frame.
      566   END PROCEDURE.
      567   PROCEDURE us-state-mh-cnt :
      568   assign frame Dialog-Frame tt-rvs-line-pump.state-mh-cnt.
      569   assign tt-rvs-line-pump.state-el-cnt = tt-rvs-line-pump.state-mh-cnt +
      570                                          (if tt-rvs-line-pump.icnt-code <> ? then (prev_icnt-line.state-el-cnt - prev_icnt-line.state-mh-cnt) else 0)
      571          tt-rvs-line-pump.state-mh-qnty = tt-rvs-line-pump.state-mh-cnt -
      572                                           (if tt-rvs-line-pump.rvs-prev-code <> ? then prev_rvs-line-pump.state-mh-cnt else ?).
      573   display tt-rvs-line-pump.state-el-cnt tt-rvs-line-pump.state-mh-qnty with frame Dialog-Frame.
      574   END PROCEDURE.
      575   PROCEDURE us-state-mh-qnty :
      576   assign frame Dialog-Frame tt-rvs-line-pump.state-mh-qnty.
      577   assign  tt-rvs-line-pump.state-mh-cnt = tt-rvs-line-pump.state-mh-qnty +
      578                                          (if available prev_rvs-line-pump then prev_rvs-line-pump.state-mh-cnt else ?).
      579           tt-rvs-line-pump.state-el-cnt = tt-rvs-line-pump.state-mh-cnt +
      580                                          (if tt-rvs-line-pump.icnt-code <> ? then (prev_icnt-line.state-el-cnt - prev_icnt-line.state-mh-cnt) else ?).
      581   display tt-rvs-line-pump.state-el-cnt tt-rvs-line-pump.state-mh-cnt with frame Dialog-Frame.
      582   END PROCEDURE.
