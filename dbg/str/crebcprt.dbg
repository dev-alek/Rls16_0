        1   define input  parameter parparentproc as widget-handle no-undo.
        2   define input  parameter p-gds-code      as integer   no-undo .
        3   define input  parameter p-message-on    as logical   no-undo .
        4   define output parameter p-create-b-code as integer   no-undo .
        5   define output parameter p-is-new        as logical   no-undo .
        6   define variable vss-revision    as character no-undo initial "$Revision$":U .
        7   define variable vss-author      as character no-undo initial "$Author$":U .
        8   define variable vss-date        as character no-undo initial "$Date$":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       10   define variable vss-archive     as character no-undo initial "$Archive$":U .
       11   define variable vss-description as character no-undo initial "Создать бар-код для товара с признаками".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1':u,p-gds-code)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   procedure proc-alt-shift-f2:
       85     if not ibs.th.gbl.gbl-var:rcode
       86   then
       87     run gbl\inidebug.p .
       88   end.
       89   procedure proc-alt-shift-f3:
       90     run gbl/prvssinf.p
       91       ( input this-procedure
       92       ) .
       93   end.
       94   define variable v-inform-launched as logical no-undo initial false .
       95   procedure proc-alt-shift-f4:
       96     define variable v-action as character no-undo .
       97     if v-inform-launched = false then do:
       98       assign
       99         v-inform-launched = true
      100       .
      101       run gbl/d-inform.w
      102         (  input self
      103         ,  input this-procedure
      104         , output v-action
      105         ) no-error .
      106       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      107       assign
      108         v-inform-launched = false
      109       .
      110     end.
      111   end.
      112   procedure proc-alt-f1:
      113     run gbl/corrhelp.p
      114       (input this-procedure
      115       ) .
      116   end .
      117   on alt-shift-f2 anywhere do:
      118     run proc-alt-shift-f2.
      119   end.
      120   on alt-shift-f3 anywhere do:
      121     run proc-alt-shift-f3 in this-procedure .
      122   end.
      123   on alt-shift-f4 anywhere do:
      124     run proc-alt-shift-f4 in this-procedure.
      125   end.
      126   on alt-f1 anywhere do:
      127     run proc-alt-f1 in this-procedure .
      128   end.
      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130     define variable v-cntxt-db-num        as integer   no-undo .
      131     define variable v-cntxt-userid        as character no-undo .
      132     define variable v-cntxt-level         as character no-undo .
      133     define variable v-cntxt-host-code-obj as integer   no-undo .
      134     define variable v-cntxt-obj-type      as character no-undo .
      135     define variable v-cntxt-obj-code      as integer   no-undo .
      136     define variable v-cntxt-db-num-obj    as integer   no-undo .
      137     define variable v-cntxt-is-admin      as logical   no-undo .
      138   define variable v-upper-code        as integer   no-undo .
      139   define variable v-root-node         as integer   no-undo .
      140   define temp-table temp-prt no-undo
      141     field prt-level as integer
      142     field prt-name  as character format "x(16)" label "Уровень"
      143     field prt-value as character format "x(16)" label "Признак"
      144     index xpk is primary unique  prt-level
      145   .
      146   DEFINE BUTTON b-exit AUTO-GO
      147        LABEL "&Ввод"
      148        SIZE 10 BY 1
      149        BGCOLOR 8 .
      150   DEFINE BUTTON b-help
      151        LABEL "Помо&щь"
      152        SIZE 10 BY 1
      153        BGCOLOR 8 .
      154   DEFINE BUTTON b-quit AUTO-END-KEY
      155        LABEL "&Отмена"
      156        SIZE 10 BY 1
      157        BGCOLOR 8 .
      158   DEFINE VARIABLE fi-goods AS CHARACTER FORMAT "X(256)":U
      159        LABEL "Товар"
      160         VIEW-AS TEXT
      161        SIZE 53 BY .67 NO-UNDO.
      162   DEFINE VARIABLE fi-scale AS CHARACTER FORMAT "X(256)":U
      163        LABEL "Шкала"
      164         VIEW-AS TEXT
      165        SIZE 53.13 BY .67 NO-UNDO.
      166   DEFINE QUERY BROWSE-level FOR
      167         temp-prt SCROLLING.
      168   DEFINE QUERY BROWSE-prt FOR
      169         gds-prt SCROLLING.
      170   DEFINE BROWSE BROWSE-level
      171     QUERY BROWSE-level DISPLAY
      172         prt-name
      173         prt-value
      174       WITH NO-ROW-MARKERS SEPARATORS SIZE 36.88 BY 10.08.
      175   DEFINE BROWSE BROWSE-prt
      176     QUERY BROWSE-prt DISPLAY
      177         node-name format "x(16)"
      178       WITH NO-ROW-MARKERS SEPARATORS SIZE 19.13 BY 9.96.
      179   DEFINE FRAME Dialog-Frame
      180        b-exit AT ROW 1 COL 1
      181        b-quit AT ROW 1 COL 11
      182        b-help AT ROW 1 COL 21
      183        BROWSE-level AT ROW 4.83 COL 4
      184        BROWSE-prt AT ROW 4.88 COL 42.75
      185        fi-goods AT ROW 2.46 COL 8.63 COLON-ALIGNED
      186        fi-scale AT ROW 3.58 COL 8.63 COLON-ALIGNED
      187        SPACE(10.86) SKIP(11.07)
      188       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      189            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      190            TITLE "Создать бар-код"
      191            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      192   ASSIGN
      193          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      194          FRAME Dialog-Frame:HIDDEN           = TRUE.
      195   ON GO OF FRAME Dialog-Frame
      196   DO:
      197     run create-bar-code in this-procedure no-error .
      198     if error-status :error
      199     then do:
      200       return no-apply .
      201     end.
      202   END.
      203   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      204   DO:
      205     APPLY "END-ERROR":U TO SELF.
      206   END.
      207   ON DEFAULT-ACTION OF BROWSE-level IN FRAME Dialog-Frame
      208   DO:
      209   END.
      210   ON VALUE-CHANGED OF BROWSE-level IN FRAME Dialog-Frame
      211   DO:
      212     run open-query-prt in this-procedure .
      213   END.
      214   ON DEFAULT-ACTION OF BROWSE-prt IN FRAME Dialog-Frame
      215   DO:
      216   END.
      217   ON ENTRY OF BROWSE-prt IN FRAME Dialog-Frame
      218   DO:
      219     run value-changed-prt in this-procedure .
      220   END.
      221   ON VALUE-CHANGED OF BROWSE-prt IN FRAME Dialog-Frame
      222   DO:
      223     run value-changed-prt in this-procedure .
      224   END.
      225   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      226   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      227   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      228   on help of frame Dialog-Frame
      229   do:
      230     run gbl/app_help.p
      231       (input this-procedure :file-name
      232       ,input ''
      233       ,input ?
      234       ) no-error.
      235     if error-status :error then do:
      236       message
      237         "Ошибка при вызове помощи"
      238         error-status :get-message(1)
      239         view-as alert-box .
      240     end.
      241   end.
      242   run minbtn-set in this-procedure .
      243   on choose of b-help in frame Dialog-Frame
      244   do:
      245     apply "help":u to frame Dialog-Frame .
      246   end.
      247   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      248   procedure minbtn-set :
      249       do
      250           on error undo, return error return-value
      251           :
      252           define variable ii              as integer       no-undo .
      253           define variable fh              as widget-handle no-undo .
      254           define variable hh              as widget-handle no-undo .
      255           define variable v-h             as handle        extent 4 no-undo .
      256           define variable v-name-button   as character     no-undo .
      257           define variable v-help-old-x    as decimal       no-undo .
      258           define variable v-help-old-y    as decimal       no-undo .
      259           define variable v-help-old-size as decimal       no-undo .
      260           define variable v-frame-width   as decimal       no-undo .
      261           define variable jj              as integer       no-undo .
      262           do
      263               on error undo, return error
      264               :
      265               assign
      266                   v-frame-width = frame Dialog-Frame:width - 0.3
      267                   fh            = frame Dialog-Frame:first-child
      268                   hh            = fh:first-child
      269                   ii            = 1
      270                   .
      271               do while valid-handle(hh):
      272                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      273                   do:
      274                       case lc(hh:name) :
      275                           when "b-help" then
      276                               do:
      277                                   hh:load-image-up("cmp/b-help.bmp":u) .
      278                                   hh:load-image-down("cmp/b-help.bmp":u) .
      279                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      280                                   hh:TOOLTIP = "Помощь" .
      281                                   v-help-old-x = hh:column .
      282                                   v-help-old-y = hh:row    .
      283                                   v-help-old-size = hh:width .
      284                                   hh:width-chars = 2.5 .
      285                               end.
      286                           when "b-print" then
      287                               do:
      288                                   hh:load-image("cmp/b-print.bmp":u) .
      289                                   hh:TOOLTIP = "Печать" .
      290                                   v-h[ii] = hh:handle .
      291                                   ii = ii + 1 .
      292                                   hh:width-chars = 3 .
      293                               end.
      294                           when "b-history" or
      295                           when "b-hist" then
      296                               do:
      297                                   hh:load-image("cmp/b-hist.bmp":u) .
      298                                   hh:TOOLTIP = "История" .
      299                                   v-h[ii] = hh:handle .
      300                                   ii = ii + 1 .
      301                                   hh:width-chars = 3 .
      302                               end.
      303                           when "b-sch" then
      304                               do:
      305                                   hh:load-image("cmp/b-sch.bmp":u) .
      306                                   hh:TOOLTIP = "Установка Фильтра" .
      307                                   v-h[ii] = hh:handle .
      308                                   ii = ii + 1 .
      309                                   hh:width-chars = 3 .
      310                               end.
      311                           when "b-hist-user" then
      312                               do:
      313                                   hh:load-image("cmp/b-hist.bmp":u) .
      314                                   hh:TOOLTIP = "История пользователя" .
      315                                   ii = ii + 1 .
      316                               end.
      317                       end case.
      318                   end.
      319                   hh = hh:next-sibling.
      320               end.
      321               b-help:column = v-frame-width - b-help:width-chars.
      322               jj = 0.
      323               repeat ii = 4 to 1 by -1 :
      324                   if valid-handle (v-h[ii] ) then
      325                   do:
      326                       jj  = jj + 1 .
      327                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      328                       v-h[ii]:row    = v-help-old-y .
      329                   end.
      330               end.
      331           end.
      332       end.
      333   end procedure.
      334   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      335   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      336   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      337   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      338   define variable v-diasize-current-frame-width  as decimal   no-undo .
      339   define variable v-diasize-current-frame-height as decimal   no-undo .
      340   define variable v-diasize-change-size          as logical   no-undo .
      341   define variable v-diasize-resize-button        as handle    no-undo .
      342   define variable v-diasize-wndmax               as logical   no-undo .
      343   define variable v-diasize-wndstore             as logical   no-undo .
      344   define variable v-diasize-proc-name            as character no-undo .
      345   define variable v-diasize-browse-handle        as handle    no-undo .
      346   define variable v-diasize-browse-number        as integer   no-undo .
      347   define variable v-diasize-need-full-display    as logical   no-undo init false .
      348   define temp-table temp-diasize-handle no-undo
      349     field handle-value  as handle
      350     field save-position as decimal
      351     index xpk is primary unique handle-value
      352     .
      353   define temp-table temp-browse-handle no-undo
      354     field browse-type   as character
      355     field browse-number as integer
      356     field browse-handle as handle
      357     field original-size as decimal
      358     index xpk is primary unique browse-type browse-number
      359     index xie browse-type browse-handle
      360   .
      361   procedure diasize_change-height :
      362     define input  parameter p-change-value  as decimal   no-undo .
      363     define input  parameter p-move-resize   as logical   no-undo .
      364     define variable v-field-group-handle    as handle    no-undo .
      365     define variable v-object-handle         as handle    no-undo .
      366     define variable v-frame-height          as decimal   no-undo .
      367     define variable v-frame-virtual-height  as decimal   no-undo .
      368     define variable v-browse-height         as decimal   no-undo .
      369     define variable v-window-height         as decimal   no-undo .
      370     define variable v-window-virtual-height as decimal   no-undo .
      371     define variable v-change-sign           as integer   no-undo .
      372     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      373     define buffer buf_temp-browse-handle  for temp-browse-handle .
      374     if p-change-value > 0
      375     then do:
      376       if frame Dialog-Frame :height + p-change-value
      377           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      378       then do:
      379         assign
      380           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      381                           - (frame Dialog-Frame :height-chars)
      382         .
      383         if p-change-value <= 0
      384         then do:
      385           run diasize_position-resize-button in this-procedure .
      386           return .
      387         end.
      388       end.
      389     end.
      390     if p-change-value < 0
      391     then do:
      392       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      393       then do:
      394         assign
      395           p-change-value = v-diasize-orig-frame-height
      396                          - (frame Dialog-Frame :height-chars)
      397         .
      398         if p-change-value >= 0
      399         then do:
      400           run diasize_position-resize-button in this-procedure .
      401           return .
      402         end.
      403       end.
      404     end.
      405     if p-change-value >= 0
      406     then do:
      407       assign
      408         v-change-sign = 1
      409       .
      410     end.
      411     else do:
      412       assign
      413         v-change-sign = -1
      414       .
      415     end.
      416     assign
      417       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      418     .
      419     if p-change-value = 0
      420     then do:
      421       run diasize_position-resize-button in this-procedure .
      422       return .
      423     end.
      424     move_block:
      425     do
      426     on error undo move_block, retry move_block
      427     :
      428       if retry
      429       then do:
      430         do
      431         on error undo move_block, leave move_block
      432         :
      433           if p-change-value > 0
      434           then do:
      435             for each buf_temp-diasize-handle
      436             on error undo, next
      437             :
      438               assign
      439                 v-object-handle = buf_temp-diasize-handle.handle-value
      440               .
      441               if v-object-handle <> v-diasize-resize-button
      442               then do:
      443                 assign
      444                   v-object-handle :row = buf_temp-diasize-handle.save-position
      445                 .
      446               end.
      447             end.
      448             assign
      449               v-diasize-browse-handle :height = v-browse-height
      450             .
      451             for each buf_temp-browse-handle
      452               where buf_temp-browse-handle.browse-type = 'height':u
      453             on error undo, next
      454             :
      455               assign
      456                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      457               .
      458             end.
      459             assign
      460               frame Dialog-Frame :height = v-frame-height
      461             .
      462             if frame Dialog-Frame :scrollable = true
      463             then do:
      464               assign
      465                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      466               .
      467             end.
      468             run diasize_position-resize-button in this-procedure .
      469           end.
      470           else do:
      471             if frame Dialog-Frame :scrollable = true
      472             then do:
      473               assign
      474                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      475               .
      476             end.
      477             assign
      478               frame Dialog-Frame :height = v-frame-height
      479             .
      480             assign
      481               v-diasize-browse-handle :height = v-browse-height
      482             .
      483             for each buf_temp-browse-handle
      484               where buf_temp-browse-handle.browse-type = 'height':u
      485             on error undo, next
      486             :
      487               assign
      488                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      489               .
      490             end.
      491             for each buf_temp-diasize-handle
      492             on error undo, next
      493             :
      494               assign
      495                 v-object-handle = buf_temp-diasize-handle.handle-value
      496               .
      497               if v-object-handle <> v-diasize-resize-button
      498               then do:
      499                 assign
      500                   v-object-handle :row = buf_temp-diasize-handle.save-position
      501                 .
      502               end.
      503             end.
      504             run diasize_position-resize-button in this-procedure .
      505           end.
      506           assign
      507             v-diasize-change-size = false
      508           .
      509           leave move_block .
      510         end.
      511       end.
      512       assign
      513         v-diasize-need-full-display = true
      514       .
      515       if v-diasize-change-size = false
      516       then do:
      517         assign
      518           v-diasize-change-size = true
      519         .
      520       end.
      521       else do:
      522         return .
      523       end.
      524       assign
      525         v-frame-height = frame Dialog-Frame :height
      526         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      527         v-browse-height = v-diasize-browse-handle :height
      528       .
      529       for each buf_temp-browse-handle
      530         where buf_temp-browse-handle.browse-type = 'height':u
      531       :
      532         assign
      533           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      534         .
      535       end.
      536       for each buf_temp-diasize-handle
      537       :
      538         delete buf_temp-diasize-handle .
      539       end.
      540       assign
      541         v-field-group-handle = frame Dialog-Frame :first-child
      542       .
      543       do while valid-handle(v-field-group-handle)
      544       :
      545         assign
      546           v-object-handle = v-field-group-handle :first-child
      547         .
      548         do while valid-handle(v-object-handle)
      549         :
      550           if  v-object-handle <> v-diasize-browse-handle :handle
      551           and can-query(v-object-handle, "row")
      552           and can-query(v-object-handle, "height")
      553           and ( v-object-handle :row > v-diasize-browse-handle :row )
      554           then do:
      555             find first buf_temp-browse-handle
      556               where buf_temp-browse-handle.browse-type   = 'height':u
      557                 and buf_temp-browse-handle.browse-handle = v-object-handle
      558               no-error .
      559             if available buf_temp-browse-handle
      560             then do:
      561             end.
      562             else do:
      563               create buf_temp-diasize-handle .
      564               assign
      565                 buf_temp-diasize-handle.handle-value  = v-object-handle
      566                 buf_temp-diasize-handle.save-position = v-object-handle :row
      567               .
      568             end.
      569           end.
      570           assign
      571             v-object-handle = v-object-handle :next-sibling
      572           .
      573         end.
      574         assign
      575           v-field-group-handle = v-field-group-handle :next-sibling
      576         .
      577       end.
      578       do with frame Dialog-Frame
      579       :
      580         hide v-diasize-resize-button .
      581         assign
      582           v-diasize-resize-button :row    = 1
      583           v-diasize-resize-button :column = 1
      584         .
      585       end.
      586       if p-change-value > 0
      587       then do:
      588         if frame Dialog-Frame :scrollable = true
      589         then do:
      590           assign
      591             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      592             no-error .
      593           if error-status :error
      594           or error-status :get-message(1) <> ""
      595           then do:
      596             undo move_block, retry move_block .
      597           end.
      598         end.
      599         assign
      600           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      601           no-error .
      602         if error-status :error
      603         or error-status :get-message(1) <> ""
      604         then do:
      605           undo move_block, retry move_block .
      606         end.
      607         assign
      608           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      609           no-error .
      610         if error-status :error
      611         or error-status :get-message(1) <> ""
      612         then do:
      613           undo move_block, retry move_block .
      614         end.
      615         for each buf_temp-browse-handle
      616           where buf_temp-browse-handle.browse-type = 'height':u
      617         on error undo move_block, retry move_block
      618         :
      619           assign
      620             buf_temp-browse-handle.browse-handle :height
      621               = buf_temp-browse-handle.browse-handle :height + p-change-value
      622             no-error .
      623           if error-status :error
      624           or error-status :get-message(1) <> ""
      625           then do:
      626             undo move_block, retry move_block .
      627           end.
      628         end.
      629         for each buf_temp-diasize-handle
      630         on error undo move_block, retry move_block
      631         :
      632           assign
      633             v-object-handle = buf_temp-diasize-handle.handle-value
      634           .
      635           if v-object-handle <> v-diasize-resize-button
      636           then do:
      637             assign
      638               v-object-handle :row = v-object-handle :row + p-change-value
      639               no-error .
      640             if error-status :error
      641             or error-status :get-message(1) <> ""
      642             then do:
      643               undo move_block, retry move_block .
      644             end.
      645           end.
      646         end.
      647       end.
      648       else do:
      649         for each buf_temp-diasize-handle
      650         on error undo move_block, retry move_block
      651         :
      652           assign
      653             v-object-handle = buf_temp-diasize-handle.handle-value
      654           .
      655           if v-object-handle <> v-diasize-resize-button
      656           then do:
      657             assign
      658               v-object-handle :row = v-object-handle :row + p-change-value
      659               no-error .
      660             if error-status :error
      661             or error-status :get-message(1) <> ""
      662             then do:
      663               undo move_block, retry move_block .
      664             end.
      665           end.
      666         end.
      667         assign
      668           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      669           no-error .
      670         if error-status :error
      671         or error-status :get-message(1) <> ""
      672         then do:
      673           undo move_block, retry move_block .
      674         end.
      675         for each buf_temp-browse-handle
      676           where buf_temp-browse-handle.browse-type = 'height':u
      677         on error undo move_block, retry move_block
      678         :
      679           assign
      680             buf_temp-browse-handle.browse-handle :height
      681               = buf_temp-browse-handle.browse-handle :height + p-change-value
      682             no-error .
      683           if error-status :error
      684           or error-status :get-message(1) <> ""
      685           then do:
      686             undo move_block, retry move_block .
      687           end.
      688         end.
      689         assign
      690           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      691           no-error .
      692         if error-status :error
      693         or error-status :get-message(1) <> ""
      694         then do:
      695           undo move_block, retry move_block .
      696         end.
      697         if frame Dialog-Frame :scrollable = true
      698         then do:
      699           assign
      700             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      701             no-error .
      702           if error-status :error
      703           or error-status :get-message(1) <> ""
      704           then do:
      705             undo move_block, retry move_block .
      706           end.
      707         end.
      708       end.
      709       if p-move-resize = true
      710       then do:
      711         run diasize_position-resize-button in this-procedure .
      712       end.
      713       if v-diasize-wndstore = true
      714       then do:
      715         if connected("ub") = true
      716         then do:
      717           define variable v-cntxt-db-num        as integer   no-undo .
      718           define variable v-cntxt-userid        as character no-undo .
      719           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      720                                             , OUTPUT v-cntxt-userid
      721                                             ) .
      722           run gbl/wndsizew.p
      723             (input  v-cntxt-db-num
      724             ,input  v-cntxt-userid
      725             ,input  v-diasize-proc-name
      726             ,input  'height':u
      727             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      728             ) .
      729         end.
      730       end.
      731     end.
      732     assign
      733       v-diasize-change-size = false
      734     .
      735   end procedure.
      736   procedure diasize_set-height :
      737     define input  parameter p-new-height  as decimal   no-undo .
      738     define input  parameter p-move-resize as logical   no-undo .
      739     do
      740     on error undo, return error return-value
      741     :
      742       run diasize_change-height in this-procedure
      743         (input  (p-new-height - frame Dialog-Frame :height)
      744         ,input  p-move-resize
      745         ) .
      746     end.
      747   end procedure.
      748   procedure diasize_change-width :
      749     define input  parameter p-change-value as decimal   no-undo .
      750     define input  parameter p-move-resize  as logical   no-undo .
      751     define variable v-field-group-handle   as handle    no-undo .
      752     define variable v-object-handle        as handle    no-undo .
      753     define variable v-frame-width          as decimal   no-undo .
      754     define variable v-frame-virtual-width  as decimal   no-undo .
      755     define variable v-browse-width         as decimal   no-undo .
      756     define variable v-window-width         as decimal   no-undo .
      757     define variable v-window-virtual-width as decimal   no-undo .
      758     define variable v-change-sign          as integer   no-undo .
      759     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      760     define buffer buf_temp-browse-handle  for temp-browse-handle .
      761     if p-change-value > 0
      762     then do:
      763       if frame Dialog-Frame :width + p-change-value >
      764           session :width-chars
      765       then do:
      766         assign
      767           p-change-value = session :width-chars - frame Dialog-Frame :width
      768         .
      769         if p-change-value <= 0
      770         then do:
      771           run diasize_position-resize-button in this-procedure .
      772           return .
      773         end.
      774       end.
      775     end.
      776     if p-change-value < 0
      777     then do:
      778       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      779       then do:
      780         assign
      781           p-change-value = v-diasize-orig-frame-width
      782                          - frame Dialog-Frame :width
      783         .
      784         if p-change-value >= 0
      785         then do:
      786           run diasize_position-resize-button in this-procedure .
      787           return .
      788         end.
      789       end.
      790     end.
      791     if p-change-value >= 0
      792     then do:
      793       assign
      794         v-change-sign = 1
      795       .
      796     end.
      797     else do:
      798       assign
      799         v-change-sign = -1
      800       .
      801     end.
      802     assign
      803       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      804     .
      805     if p-change-value = 0
      806     then do:
      807       run diasize_position-resize-button in this-procedure .
      808       return .
      809     end.
      810     move_block:
      811     do
      812     on error undo move_block, leave move_block
      813     :
      814       if retry
      815       then do:
      816         do
      817         on error undo move_block, leave move_block
      818         :
      819           if p-change-value > 0
      820           then do:
      821             for each buf_temp-diasize-handle
      822             on error undo, next
      823             :
      824               assign
      825                 v-object-handle = buf_temp-diasize-handle.handle-value
      826               .
      827               if v-object-handle <> v-diasize-resize-button
      828               then do:
      829                 assign
      830                   v-object-handle :col = buf_temp-diasize-handle.save-position
      831                 .
      832               end.
      833             end.
      834             assign
      835               v-diasize-browse-handle :width = v-browse-width
      836             .
      837             for each buf_temp-browse-handle
      838               where buf_temp-browse-handle.browse-type = 'width':u
      839             on error undo, next
      840             :
      841               assign
      842                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      843               .
      844             end.
      845             assign
      846               frame Dialog-Frame :width = v-frame-width
      847             .
      848             if frame Dialog-Frame :scrollable = true
      849             then do:
      850               assign
      851                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      852               .
      853             end.
      854             run diasize_position-resize-button in this-procedure .
      855           end.
      856           else do:
      857             if frame Dialog-Frame :scrollable = true
      858             then do:
      859               assign
      860                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      861               .
      862             end.
      863             assign
      864               frame Dialog-Frame :width = v-frame-width
      865             .
      866             for each buf_temp-browse-handle
      867               where buf_temp-browse-handle.browse-type = 'width':u
      868             on error undo, next
      869             :
      870               assign
      871                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      872               .
      873             end.
      874             assign
      875               v-diasize-browse-handle :width = v-browse-width
      876             .
      877             for each buf_temp-diasize-handle
      878             on error undo, next
      879             :
      880               assign
      881                 v-object-handle = buf_temp-diasize-handle.handle-value
      882               .
      883               if v-object-handle <> v-diasize-resize-button
      884               then do:
      885                 assign
      886                   v-object-handle :col = buf_temp-diasize-handle.save-position
      887                 .
      888               end.
      889             end.
      890             run diasize_position-resize-button in this-procedure .
      891           end.
      892           assign
      893             v-diasize-change-size = false
      894           .
      895           leave move_block .
      896         end.
      897       end.
      898       assign
      899         v-diasize-need-full-display = true
      900       .
      901       if v-diasize-change-size = false
      902       then do:
      903         assign
      904           v-diasize-change-size = true
      905         .
      906       end.
      907       else do:
      908         return .
      909       end.
      910       assign
      911         v-frame-width = frame Dialog-Frame :width
      912         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      913         v-browse-width = v-diasize-browse-handle :width
      914       .
      915       for each buf_temp-browse-handle
      916         where buf_temp-browse-handle.browse-type = 'width':u
      917       :
      918         assign
      919           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      920         .
      921       end.
      922       for each buf_temp-diasize-handle
      923       :
      924         delete buf_temp-diasize-handle .
      925       end.
      926       assign
      927         v-field-group-handle = frame Dialog-Frame :first-child
      928       .
      929       do while valid-handle(v-field-group-handle)
      930       :
      931         assign
      932           v-object-handle = v-field-group-handle :first-child
      933         .
      934         do while valid-handle(v-object-handle)
      935         :
      936           if  v-object-handle <> v-diasize-browse-handle :handle
      937           and v-object-handle <> v-diasize-resize-button
      938           and can-query(v-object-handle, "row")
      939           and can-query(v-object-handle, "height")
      940           and ( v-object-handle :col + v-object-handle :width
      941                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      942               )
      943           then do:
      944             find first buf_temp-browse-handle
      945               where buf_temp-browse-handle.browse-type   = 'width':u
      946                 and buf_temp-browse-handle.browse-handle = v-object-handle
      947               no-error .
      948             if available buf_temp-browse-handle
      949             then do:
      950             end.
      951             else do:
      952               create buf_temp-diasize-handle .
      953               assign
      954                 buf_temp-diasize-handle.handle-value  = v-object-handle
      955                 buf_temp-diasize-handle.save-position = v-object-handle :col
      956               .
      957             end.
      958           end.
      959           assign
      960             v-object-handle = v-object-handle :next-sibling
      961           .
      962         end.
      963         assign
      964           v-field-group-handle = v-field-group-handle :next-sibling
      965         .
      966       end.
      967       do with frame Dialog-Frame
      968       :
      969         hide v-diasize-resize-button .
      970         v-diasize-resize-button :row = 1.
      971         v-diasize-resize-button :column = 1.
      972       end.
      973       if p-change-value > 0
      974       then do:
      975         if frame Dialog-Frame :scrollable = true
      976         then do:
      977           assign
      978             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      979             no-error .
      980           if error-status :error
      981           or error-status :get-message(1) <> ""
      982           then do:
      983             undo move_block, retry move_block.
      984           end.
      985         end.
      986         assign
      987           frame Dialog-Frame :width = v-frame-width + p-change-value
      988           no-error .
      989         if error-status :error
      990         or error-status :get-message(1) <> ""
      991         then do:
      992           undo move_block, retry move_block.
      993         end.
      994         assign
      995           v-diasize-browse-handle :width = v-browse-width + p-change-value
      996         no-error .
      997         if error-status :error
      998         or error-status :get-message(1) <> ""
      999         then do:
     1000           undo move_block, retry move_block.
     1001         end.
     1002         for each buf_temp-browse-handle
     1003           where buf_temp-browse-handle.browse-type = 'width':u
     1004         on error undo move_block, retry move_block
     1005         :
     1006           assign
     1007             buf_temp-browse-handle.browse-handle :width
     1008               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1009             no-error .
     1010           if error-status :error
     1011           or error-status :get-message(1) <> ""
     1012           then do:
     1013             undo move_block, retry move_block .
     1014           end.
     1015         end.
     1016         for each buf_temp-diasize-handle
     1017         on error undo move_block, retry move_block
     1018         :
     1019           assign
     1020             v-object-handle = buf_temp-diasize-handle.handle-value
     1021           .
     1022           if v-object-handle <> v-diasize-resize-button
     1023           then do:
     1024             assign
     1025               v-object-handle :col = v-object-handle :col + p-change-value
     1026               no-error .
     1027             if error-status :error
     1028             or error-status :get-message(1) <> ""
     1029             then do:
     1030               undo move_block, retry move_block .
     1031             end.
     1032           end.
     1033         end.
     1034       end.
     1035       else do:
     1036         for each buf_temp-diasize-handle
     1037         on error undo move_block, retry move_block
     1038         :
     1039           assign
     1040             v-object-handle = buf_temp-diasize-handle.handle-value
     1041           .
     1042           if v-object-handle <> v-diasize-resize-button
     1043           then do:
     1044             assign
     1045               v-object-handle :col = v-object-handle :col + p-change-value
     1046               no-error .
     1047             if error-status :error
     1048             or error-status :get-message(1) <> ""
     1049             then do:
     1050               undo move_block, retry move_block .
     1051             end.
     1052           end.
     1053         end.
     1054         for each buf_temp-browse-handle
     1055           where buf_temp-browse-handle.browse-type = 'width':u
     1056         on error undo move_block, retry move_block
     1057         :
     1058           assign
     1059             buf_temp-browse-handle.browse-handle :width
     1060               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1061             no-error .
     1062           if error-status :error
     1063           or error-status :get-message(1) <> ""
     1064           then do:
     1065             undo move_block, retry move_block .
     1066           end.
     1067         end.
     1068         assign
     1069           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1070           no-error .
     1071         if error-status :error
     1072         or error-status :get-message(1) <> ""
     1073         then do:
     1074           undo move_block, retry move_block.
     1075         end.
     1076         assign
     1077           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1078         no-error .
     1079         if error-status :error
     1080         or error-status :get-message(1) <> ""
     1081         then do:
     1082           undo move_block, retry move_block.
     1083         end.
     1084         if frame Dialog-Frame :scrollable = true
     1085         then do:
     1086           assign
     1087             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1088           no-error .
     1089           if error-status :error
     1090           or error-status :get-message(1) <> ""
     1091           then do:
     1092             undo move_block, retry move_block.
     1093           end.
     1094         end.
     1095       end.
     1096       if p-move-resize
     1097       then do:
     1098         run diasize_position-resize-button in this-procedure .
     1099       end.
     1100       if v-diasize-wndstore = true
     1101       then do:
     1102         if connected("ub") = true
     1103         then do:
     1104           define variable v-cntxt-db-num        as integer   no-undo .
     1105           define variable v-cntxt-userid        as character no-undo .
     1106           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1107                                             , OUTPUT v-cntxt-userid
     1108                                             ) .
     1109           run gbl/wndsizew.p
     1110             (input  v-cntxt-db-num
     1111             ,input  v-cntxt-userid
     1112             ,input  v-diasize-proc-name
     1113             ,input  'width':u
     1114             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1115             ) .
     1116         end.
     1117       end.
     1118     end.
     1119     assign
     1120       v-diasize-change-size = false
     1121     .
     1122   end procedure.
     1123   procedure diasize_set-width :
     1124     define input  parameter p-new-width  as decimal   no-undo .
     1125     define input  parameter p-move-resize as logical   no-undo .
     1126     do
     1127     on error undo, return error return-value
     1128     :
     1129       run diasize_change-width in this-procedure
     1130         (input  (p-new-width - frame Dialog-Frame :width)
     1131         ,input  p-move-resize
     1132         ) .
     1133     end.
     1134   end procedure.
     1135   procedure diasize_position-resize-button :
     1136     do with frame Dialog-Frame
     1137     :
     1138       hide v-diasize-resize-button .
     1139       assign
     1140         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1141                     - 1
     1142                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1143         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1144                     - 1
     1145                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1146       .
     1147       view v-diasize-resize-button .
     1148     end.
     1149   end procedure.
     1150   on alt-right anywhere
     1151   do:
     1152     run diasize_change-width in this-procedure
     1153       (input 1
     1154       ,input true
     1155       ) .
     1156     return no-apply .
     1157   end.
     1158   on alt-left anywhere
     1159   do:
     1160     run diasize_change-width in this-procedure
     1161       (input -1
     1162       ,input true
     1163       ) .
     1164     return no-apply .
     1165   end.
     1166   on alt-down anywhere
     1167   do:
     1168     run diasize_change-height in this-procedure
     1169       (input 1
     1170       ,input true
     1171       ) .
     1172     return no-apply .
     1173   end.
     1174   on alt-up anywhere
     1175   do:
     1176     run diasize_change-height in this-procedure
     1177       (input -1
     1178       ,input true
     1179       ) .
     1180     return no-apply .
     1181   end.
     1182   on alt-enter of frame Dialog-Frame
     1183   do:
     1184     run diasize_maximize in this-procedure
     1185       (input  ?
     1186       ).
     1187     return no-apply .
     1188   end.
     1189   procedure diasize_end-move :
     1190     do
     1191     on error undo, return error return-value
     1192     :
     1193       define variable v-row-delta as decimal   no-undo .
     1194       define variable v-col-delta as decimal   no-undo .
     1195       define variable v-new-row as decimal   no-undo .
     1196       define variable v-new-col as decimal   no-undo .
     1197       assign
     1198         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1199         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1200       .
     1201       assign
     1202         v-row-delta = v-new-row - frame Dialog-Frame :height
     1203         v-col-delta = v-new-col - frame Dialog-Frame :width
     1204       .
     1205       run diasize_change-height in this-procedure
     1206         (input v-row-delta
     1207         ,input true
     1208         ) .
     1209       run diasize_change-width in this-procedure
     1210         (input v-col-delta
     1211         ,input true
     1212         ) .
     1213     end.
     1214   end procedure.
     1215   procedure diasize_maximize :
     1216     define input  parameter p-action as logical   no-undo .
     1217     do
     1218     on error undo, return error return-value
     1219     :
     1220       if p-action = ?
     1221       then do:
     1222         if v-diasize-need-maximize = true
     1223         then do:
     1224           assign
     1225             p-action = true
     1226           .
     1227         end.
     1228         else do:
     1229           assign
     1230             p-action = false
     1231           .
     1232         end.
     1233       end.
     1234       if p-action = true
     1235       then do:
     1236         run diasize_change-height in this-procedure
     1237           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1238               - frame Dialog-Frame :height-chars
     1239           ,input true
     1240           ) .
     1241         run diasize_change-width in this-procedure
     1242           (input session :width-chars
     1243               - frame Dialog-Frame :width-chars
     1244           ,input true
     1245           ) .
     1246         assign
     1247           v-diasize-need-maximize = false
     1248         .
     1249       end.
     1250       else do:
     1251         run diasize_change-width in this-procedure
     1252           (input v-diasize-orig-frame-width
     1253               - frame Dialog-Frame :width-chars
     1254           ,input true
     1255           ) .
     1256         run diasize_change-height in this-procedure
     1257           (input v-diasize-orig-frame-height
     1258               - frame Dialog-Frame :height-chars
     1259           ,input true
     1260           ) .
     1261         assign
     1262           v-diasize-need-maximize = true
     1263         .
     1264       end.
     1265     end.
     1266   end procedure.
     1267   procedure diasize_restore-orig-size :
     1268     do
     1269     on error undo, return error return-value
     1270     :
     1271       assign
     1272         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1273         v-diasize-current-frame-height = frame Dialog-Frame :height
     1274       .
     1275       run diasize_set-height in this-procedure
     1276         (input  v-diasize-orig-frame-height
     1277         ,input  true
     1278         ) .
     1279       run diasize_set-width in this-procedure
     1280         (input  v-diasize-orig-frame-width
     1281         ,input  true
     1282         ) .
     1283     end.
     1284   end procedure.
     1285   procedure diasize_restore-current-size :
     1286     do
     1287     on error undo, return error return-value
     1288     :
     1289       run diasize_set-height in this-procedure
     1290         (input  v-diasize-current-frame-height
     1291         ,input  true
     1292         ) .
     1293       run diasize_set-width in this-procedure
     1294         (input  v-diasize-current-frame-width
     1295         ,input  true
     1296         ) .
     1297     end.
     1298   end procedure.
     1299   procedure diasize_set-browse-handle :
     1300     define input  parameter p-browse-handle as handle   no-undo .
     1301     define buffer buf_temp-browse-handle for temp-browse-handle .
     1302     do
     1303     on error undo, return error return-value
     1304     :
     1305       assign
     1306         v-diasize-browse-handle = p-browse-handle
     1307       .
     1308       for each buf_temp-browse-handle
     1309       on error undo, return error return-value
     1310       :
     1311         delete buf_temp-browse-handle .
     1312       end.
     1313     end.
     1314   end procedure.
     1315   procedure diasize_add_browse :
     1316     define input  parameter p-browse-type   as character no-undo .
     1317     define input  parameter p-browse-handle as handle    no-undo .
     1318     define buffer buf_temp-browse-handle for temp-browse-handle .
     1319     do
     1320     on error undo, return error return-value
     1321     :
     1322       assign
     1323         v-diasize-browse-number = v-diasize-browse-number + 1
     1324       .
     1325       create buf_temp-browse-handle .
     1326       assign
     1327         buf_temp-browse-handle.browse-type   = p-browse-type
     1328         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1329         buf_temp-browse-handle.browse-handle = p-browse-handle
     1330       .
     1331     end.
     1332   end procedure.
     1333   procedure diasize_init :
     1334     define variable v-default-value    as logical   no-undo .
     1335     define variable v-restore-saved    as logical   no-undo .
     1336     define variable v-resize-value-str as character no-undo .
     1337     do
     1338     on error undo, return error return-value
     1339     :
     1340       do with frame Dialog-Frame
     1341       :
     1342         assign
     1343           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1344           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1345           v-diasize-browse-handle     = browse BROWSE-level :handle
     1346         .
     1347         create button v-diasize-resize-button
     1348         assign
     1349           parent        = frame Dialog-Frame :first-child
     1350           label         = "s"
     1351           height-pixels = 16
     1352           width-pixels  = 16
     1353           visible       = true
     1354           sensitive     = true
     1355           movable       = true
     1356           triggers:
     1357             on end-move persistent run diasize_end-move in this-procedure .
     1358           end triggers.
     1359         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1360         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1361         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1362         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1363         assign
     1364           v-diasize-wndmax = false
     1365         .
     1366         if connected("ub") = true
     1367         then do:
     1368           define variable v-cntxt-db-num        as integer   no-undo .
     1369           define variable v-cntxt-userid        as character no-undo .
     1370           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1371                                             , OUTPUT v-cntxt-userid
     1372                                             ) .
     1373           run gbl/wndpar_r.p
     1374             (input  v-cntxt-db-num
     1375             ,input  v-cntxt-userid
     1376             ,input  'wndmax':U
     1377             ,output v-diasize-wndmax
     1378             ,output v-default-value
     1379             ) .
     1380         end.
     1381         assign
     1382           v-diasize-wndstore = false
     1383         .
     1384         if connected("ub") = true
     1385         then do:
     1386           run gbl/wndpar_r.p
     1387             (input  v-cntxt-db-num
     1388             ,input  v-cntxt-userid
     1389             ,input  'wndstore':U
     1390             ,output v-diasize-wndstore
     1391             ,output v-default-value
     1392             ) .
     1393         end.
     1394         assign
     1395           v-diasize-proc-name = entry(1, program-name(2), '.')
     1396         .
     1397         if v-diasize-wndstore = true
     1398         then do:
     1399           assign
     1400             v-restore-saved = false
     1401           .
     1402           if connected("ub") = true
     1403           then do:
     1404             run gbl/wndsizer.p
     1405               (input  v-cntxt-db-num
     1406               ,input  v-cntxt-userid
     1407               ,input  v-diasize-proc-name
     1408               ,input  'height':u
     1409               ,output v-resize-value-str
     1410               ) .
     1411             if v-resize-value-str <> '':U
     1412             then do:
     1413               run diasize_change-height in this-procedure
     1414                 (input  integer(v-resize-value-str)
     1415                 ,input  true
     1416                 ) .
     1417               assign
     1418                 v-restore-saved = true
     1419               .
     1420             end.
     1421           end.
     1422           if connected("ub") = true
     1423           then do:
     1424             run gbl/wndsizer.p
     1425               (input  v-cntxt-db-num
     1426               ,input  v-cntxt-userid
     1427               ,input  v-diasize-proc-name
     1428               ,input  'width':u
     1429               ,output v-resize-value-str
     1430               ) .
     1431             if v-resize-value-str <> '':U
     1432             then do:
     1433               run diasize_change-width in this-procedure
     1434                 (input  integer(v-resize-value-str)
     1435                 ,input  true
     1436                 ) .
     1437               assign
     1438                 v-restore-saved = true
     1439               .
     1440             end.
     1441           end.
     1442           if v-restore-saved <> true
     1443           then do:
     1444             if v-diasize-wndmax = true
     1445             then do:
     1446               run diasize_maximize in this-procedure
     1447                 (input  true
     1448                 ) .
     1449             end.
     1450           end.
     1451         end.
     1452         else do:
     1453           if v-diasize-wndmax = true
     1454           then do:
     1455             run diasize_maximize in this-procedure
     1456               (input  true
     1457               ) .
     1458           end.
     1459         end.
     1460       end.
     1461     end.
     1462   end procedure.
     1463   procedure diasize_need-full-display :
     1464     define output parameter p-need-full-display as logical   no-undo .
     1465     do
     1466     on error undo, return error return-value
     1467     :
     1468       assign
     1469         p-need-full-display = v-diasize-need-full-display
     1470       .
     1471       assign
     1472         v-diasize-need-full-display = false
     1473       .
     1474     end.
     1475   end procedure.
     1476   procedure get-context :
     1477      define output parameter p-db-num as integer          no-undo.
     1478      define output parameter p-user-id as character        no-undo.
     1479      define variable v-login               as character    no-undo.
     1480      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1481      define buffer buf_user-login  for ub.user-login .
     1482      do
     1483      on error undo, return error
     1484      :
     1485            FIND FIRST buf_sys-ctrl no-lock.
     1486            ASSIGN
     1487               v-login = USERID("ub")
     1488               p-db-num = buf_sys-ctrl.db-num
     1489            .
     1490            FIND FIRST buf_user-login
     1491                 WHERE buf_user-login.db-num = p-db-num
     1492                   AND buf_user-login.user-login = v-login
     1493                 no-lock
     1494                 no-error
     1495                 .
     1496            IF AVAILABLE buf_user-login
     1497            THEN DO:
     1498               assign
     1499                  p-user-id = buf_user-login.user-id
     1500               .
     1501            END.
     1502      end.
     1503   end procedure.
     1504       run diasize_init in this-procedure .
     1505   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1506   do:
     1507     browse-level :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1508   end.
     1509   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1510   do:
     1511     browse-prt :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1512   end.
     1513   MAIN-BLOCK:
     1514   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1515      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1516   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1517     run mainmenu_getcntxt in parparentproc
     1518       (output v-cntxt-db-num
     1519       ,output v-cntxt-userid
     1520       ,output v-cntxt-level
     1521       ,output v-cntxt-host-code-obj
     1522       ,output v-cntxt-obj-type
     1523       ,output v-cntxt-obj-code
     1524       ,output v-cntxt-db-num-obj
     1525       ,output v-cntxt-is-admin
     1526       ) .
     1527     define variable v-ok as logical   no-undo .
     1528   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1529   do:
     1530     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1531       (input  v-cntxt-db-num
     1532       ,input  v-cntxt-userid
     1533       ,input  0
     1534       ,input  'actn_main-barcode_preparation':U
     1535       ,input  'global':U
     1536       ,input  0
     1537       ,input  '':U
     1538       ,input  0
     1539       ,input  0
     1540       ,input  0
     1541       ,input  0
     1542       ,input  true
     1543       ,output v-ok
     1544       )  .
     1545   end.
     1546     if v-ok <> true
     1547     then do:
     1548       undo, return error return-value .
     1549     end.
     1550     run init-dialog in this-procedure no-error .
     1551     if error-status :error
     1552     then do:
     1553       if error-status :get-message(1) <> ""
     1554       then do:
     1555         message
     1556           vss-workfile vss-revision vss-description skip
     1557           "Ошибка при вызове init-dialog" skip
     1558           error-status :get-message(1) skip
     1559           return-value skip
     1560           view-as alert-box error .
     1561       end.
     1562       undo, return error return-value .
     1563     end.
     1564     run fill-temp-table in this-procedure .
     1565     run open-query-level in this-procedure .
     1566     run open-query-prt in this-procedure .
     1567     RUN enable_UI.
     1568     apply 'entry':u to browse BROWSE-level .
     1569     apply 'entry':u to temp-prt.prt-value in browse BROWSE-level .
     1570     WAIT-FOR GO OF FRAME Dialog-Frame.
     1571   END.
     1572   RUN disable_UI.
     1573   PROCEDURE create-bar-code :
     1574     do
     1575     on error undo, return error return-value
     1576     :
     1577       define buffer buf_temp-prt for temp-prt .
     1578       define buffer buf_goods for ub.goods .
     1579       define variable v-node-code as integer   no-undo .
     1580       assign
     1581         v-node-code = v-root-node
     1582       .
     1583       find first buf_goods no-lock
     1584         where buf_goods.gds-code = p-gds-code
     1585         .
     1586       for each buf_temp-prt
     1587         by buf_temp-prt.prt-level
     1588       :
     1589         if buf_temp-prt.prt-value = ""
     1590         or buf_temp-prt.prt-value = ?
     1591         then do:
     1592           message
     1593             "Не задано значение признака" skip
     1594             "Уровень" buf_temp-prt.prt-name skip
     1595             view-as alert-box error .
     1596           undo, return error return-value .
     1597         end.
     1598         define buffer buf_gds-prt for ub.gds-prt .
     1599         find first buf_gds-prt no-lock
     1600           where buf_gds-prt.upper-code = v-node-code
     1601             and buf_gds-prt.node-name  = buf_temp-prt.prt-value
     1602           no-error .
     1603         if not available buf_gds-prt
     1604         then do:
     1605           message
     1606             "Не найден признак" skip
     1607             "Уровень" buf_temp-prt.prt-name skip
     1608             "Признак" buf_temp-prt.prt-value skip
     1609             view-as alert-box error .
     1610           undo, return error return-value .
     1611         end.
     1612         assign
     1613           v-node-code = buf_gds-prt.node-code
     1614         .
     1615       end.
     1616       define variable v-is-new as logical   no-undo .
     1617       define buffer buf_bar-code for ub.bar-code .
     1618   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1619   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1620     (input  p-gds-code
     1621     ,input  v-node-code
     1622     ,input  '':u
     1623     ,input  '':u
     1624     ,input  buf_goods.unit-base
     1625     ,input  1
     1626     ,output v-is-new
     1627     ,buffer buf_bar-code
     1628     )  .
     1629       assign
     1630         p-create-b-code = buf_bar-code.b-code
     1631         p-is-new        = v-is-new
     1632       .
     1633       if p-message-on = true
     1634       then do:
     1635         if v-is-new = true
     1636         then do:
     1637           message
     1638             "Создан бар-код" skip
     1639             "Бар-код" buf_bar-code.b-code skip
     1640             view-as alert-box information .
     1641         end.
     1642         else do:
     1643           message
     1644             "Бар-код для данного признака уже существует" skip
     1645             "Бар-код" buf_bar-code.b-code skip
     1646             view-as alert-box information .
     1647         end.
     1648       end.
     1649     end.
     1650   END PROCEDURE.
     1651   PROCEDURE disable_UI :
     1652     HIDE FRAME Dialog-Frame.
     1653   END PROCEDURE.
     1654   PROCEDURE enable_UI :
     1655     DISPLAY fi-goods fi-scale
     1656         WITH FRAME Dialog-Frame.
     1657     ENABLE b-exit b-quit b-help BROWSE-level BROWSE-prt fi-goods fi-scale
     1658         WITH FRAME Dialog-Frame.
     1659     VIEW FRAME Dialog-Frame.
     1660     OPEN QUERY BROWSE-level FOR EACH temp-prt .    run open-query-prt in this-procedure .
     1661   END PROCEDURE.
     1662   PROCEDURE fill-temp-table :
     1663     define buffer buf_temp-prt for temp-prt .
     1664     define buffer buf_gds-prt for ub.gds-prt .
     1665     define buffer buf_lvl-name for ub.lvl-name .
     1666     for each buf_temp-prt
     1667     :
     1668       delete buf_temp-prt .
     1669     end.
     1670     for each buf_lvl-name no-lock
     1671       where buf_lvl-name.upper-code = v-upper-code
     1672     by buf_lvl-name.level
     1673     :
     1674       create buf_temp-prt .
     1675       assign
     1676         buf_temp-prt.prt-level = buf_lvl-name.level
     1677         buf_temp-prt.prt-name  = buf_lvl-name.lvl-name
     1678       .
     1679     end.
     1680   END PROCEDURE.
     1681   PROCEDURE init-dialog :
     1682     define buffer buf_goods for ub.goods .
     1683     define buffer buf_gds-prt for ub.gds-prt .
     1684     find first buf_goods no-lock
     1685       where buf_goods.gds-code = p-gds-code
     1686       no-error .
     1687     if error-status :error
     1688     then do:
     1689       message
     1690         vss-workfile vss-revision vss-description skip
     1691         "Ошибка задания входных параметров" skip
     1692         "Не найден товар" skip
     1693         "Код товара" p-gds-code skip
     1694         view-as alert-box error .
     1695       undo, return error return-value .
     1696     end.
     1697   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1698   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1699     (input  buf_goods.artic
     1700     ,input  buf_goods.prod-type
     1701     ,input  buf_goods.prod-code
     1702     ,output v-root-node
     1703     )  .
     1704     find first buf_gds-prt no-lock
     1705       where buf_gds-prt.node-code = v-root-node
     1706       .
     1707     do with frame Dialog-Frame:
     1708       assign
     1709         fi-goods = substitute('&1 &2 &3 &4'
     1710                              ,buf_goods.artic
     1711                              ,buf_goods.prod-type
     1712                              ,buf_goods.prod-code
     1713                              ,buf_goods.gds-name
     1714                              )
     1715       .
     1716       assign
     1717         v-upper-code = buf_gds-prt.upper-code
     1718         fi-scale     = buf_gds-prt.node-name
     1719       .
     1720     end.
     1721   END PROCEDURE.
     1722   PROCEDURE open-query-level :
     1723     define buffer buf_temp-prt for temp-prt .
     1724     define variable v-prt-level as integer   no-undo .
     1725     if available temp-prt
     1726     then do:
     1727       assign
     1728         v-prt-level = temp-prt.prt-level
     1729       .
     1730     end.
     1731     else do:
     1732       assign
     1733         v-prt-level = ?
     1734       .
     1735     end.
     1736     open query BROWSE-level for each temp-prt by temp-prt.prt-level .
     1737     if v-prt-level <> ?
     1738     then do:
     1739       find first buf_temp-prt
     1740         where buf_temp-prt.prt-level = v-prt-level
     1741         no-error .
     1742       if available buf_temp-prt
     1743       then do:
     1744         reposition BROWSE-level to rowid rowid(buf_temp-prt) no-error .
     1745       end.
     1746     end.
     1747   END PROCEDURE.
     1748   PROCEDURE open-query-prt :
     1749     if available temp-prt
     1750     then do:
     1751       define buffer buf_gds-prt for ub.gds-prt .
     1752       define variable v-node-code as integer   no-undo .
     1753       define variable v-ind as integer   no-undo .
     1754       assign
     1755         v-node-code = v-root-node
     1756       .
     1757       do v-ind = 1 to temp-prt.prt-level
     1758       :
     1759         find first buf_gds-prt no-lock
     1760           where buf_gds-prt.upper-code = v-node-code
     1761           .
     1762         assign
     1763           v-node-code = buf_gds-prt.node-code
     1764         .
     1765       end.
     1766       OPEN QUERY browse-prt FOR EACH gds-prt no-lock
     1767         where gds-prt.upper-code = v-node-code
     1768         by gds-prt.prt-num .
     1769       if temp-prt.prt-value <> ''
     1770       then do:
     1771         find first buf_gds-prt no-lock
     1772           where buf_gds-prt.upper-code = v-node-code
     1773             and buf_gds-prt.node-name  = temp-prt.prt-value
     1774           no-error .
     1775         if available buf_gds-prt
     1776         then do:
     1777           reposition browse-prt to rowid rowid(buf_gds-prt) no-error .
     1778         end.
     1779       end.
     1780     end.
     1781   END PROCEDURE.
     1782   PROCEDURE value-changed-prt :
     1783     if  available temp-prt
     1784     and available gds-prt
     1785     then do:
     1786       assign
     1787         temp-prt.prt-value = gds-prt.node-name
     1788       .
     1789       do with frame Dialog-Frame:
     1790         display temp-prt.prt-value with browse browse-level .
     1791       end.
     1792     end.
     1793   END PROCEDURE.
