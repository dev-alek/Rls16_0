     4715   procedure get-context :
     4716      define output parameter p-db-num as integer          no-undo.
     4717      define output parameter p-user-id as character        no-undo.
     4718      define variable v-login               as character    no-undo.
     4719      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4720      define buffer buf_user-login  for ub.user-login .
     4721      do
     4722      on error undo, return error
     4723      :
     4724            FIND FIRST buf_sys-ctrl no-lock.
     4725            ASSIGN
     4726               v-login = USERID("ub")
     4727               p-db-num = buf_sys-ctrl.db-num
     4728            .
     4729            FIND FIRST buf_user-login
     4730                 WHERE buf_user-login.db-num = p-db-num
     4731                   AND buf_user-login.user-login = v-login
     4732                 no-lock
     4733                 no-error
     4734                 .
     4735            IF AVAILABLE buf_user-login
     4736            THEN DO:
     4737               assign
     4738                  p-user-id = buf_user-login.user-id
     4739               .
     4740            END.
     4741      end.
     4742   end procedure.
     4743   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4744   def var vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4745   define variable v-no-context as logical no-undo .
     4746   define variable v-user-obj-type as character no-undo .
     4747   define variable v-user-obj-code as integer no-undo .
     4748   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     4749                                            , input p-no-context as logical ):
     4750   define variable v-uniq-key-rec as character no-undo .
     4751   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     4752     v-uniq-key-rec = 'clients':U + chr(3) +
     4753                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     4754                     entry(5, p-uniq-key-rec, chr(3)).
     4755   end.
     4756   else do:
     4757     v-uniq-key-rec = p-uniq-key-rec.
     4758     case entry(1, p-uniq-key-rec, chr(3)):
     4759        when 'user-obj':U then do:
     4760          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     4761          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     4762        end.
     4763     end case.
     4764   end.
     4765   return v-uniq-key-rec.
     4766   end function.
     4767   procedure find-user-obj-rowid :
     4768   define input parameter p-rowid as rowid no-undo .
     4769   define input parameter p-no-context as logical no-undo .
     4770   define output parameter p-user-obj-type as character no-undo .
     4771   define output parameter p-user-obj-code as integer no-undo .
     4772   define buffer user-obj_clients for ub.clients.
     4773   define buffer user-obj_user-obj for ub.user-obj .
     4774   if p-no-context then do:
     4775     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     4776     assign
     4777     p-user-obj-type = user-obj_clients.obj-type
     4778     p-user-obj-code = user-obj_clients.obj-code.
     4779   end.
     4780   else do:
     4781     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     4782     if not available user-obj_user-obj then do:
     4783       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     4784     end.
     4785     assign
     4786     p-user-obj-type = user-obj_user-obj.obj-type
     4787     p-user-obj-code = user-obj_user-obj.obj-code.
     4788   end.
     4789   end procedure.
     4790   define variable an-listp-start-macro-id as integer no-undo init ?.
     4791   define variable an-listp-end-macro-id as integer no-undo  init ?.
     4792   define variable an-listp-macros-label-id as integer   no-undo .
     4793   define variable v-macro-is-running as logical no-undo .
     4794   define variable v-current-step as integer no-undo .
     4795   define variable v-expand as logical no-undo .
     4796   define variable v-downed as character no-undo .
     4797   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4798   define     temp-table keep-macro-list-hist no-undo
     4799   field list-table as character
     4800   field id as integer
     4801   field line as integer
     4802   field hist-mode as character
     4803   field des as character
     4804   field num-recs as integer
     4805   field option_ as character
     4806   field item_ as character
     4807   field status_ as character
     4808   field num-add as integer
     4809   field num-ignored as integer
     4810   field done as logical
     4811   field err_ as logical
     4812   field err-mes as character
     4813   index pi is primary
     4814   id
     4815   line
     4816   index isdone
     4817   done
     4818   .
     4819   procedure assign-nums :
     4820   define input-output parameter p-num-add as integer no-undo .
     4821   define input-output parameter p-num-rec as integer no-undo .
     4822   define input-output parameter p-num-ignored as integer no-undo .
     4823   define input parameter p-line-mode as character no-undo .
     4824   assign
     4825   p-num-add  = lns-cnt - v-num-add
     4826   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     4827                             then (tot-lns + p-num-add)
     4828                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     4829   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     4830   p-num-ignored = lns-ignore  - v-num-ignored
     4831   v-num-add             = lns-cnt
     4832   v-num-ignored         = lns-ignore
     4833   .
     4834   END PROCEDURE.
     4835   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     4836   or INSERT-MODE of br-list
     4837   DO:
     4838   define variable glog as logical no-undo .
     4839   define buffer buf-cli-list-hist for cli-list-hist.
     4840   define buffer buf_macro-list-hist for macro-list-hist.
     4841   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     4842    if p-keep-query then do:
     4843       glog = no.
     4844       message "Реинициализация списка. Вы уверены ?"
     4845               view-as alert-box question buttons OK-Cancel update glog.
     4846       if not glog then return no-apply.
     4847       if session:set-wait-state( "COMPILER" )  then .
     4848       for each cli-list:
     4849         delete cli-list.
     4850       end.
     4851       if session:set-wait-state( "" )  then .
     4852       tot-lns = 0.
     4853       v-seq = 1.
     4854       for each buf-cli-list-hist:
     4855         delete buf-cli-list-hist.
     4856       end.
     4857      for each buf_keep-macro-list-hist:
     4858        create buf_macro-list-hist.
     4859      end.
     4860      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     4861      run create-cli-list-hist in this-procedure (
     4862                                             input 'ДОБАВЛЕНИЕ':U
     4863                                           , input-output v-seq
     4864                                           , input 0
     4865                                           , input '0':U
     4866                                           , input "# Реинициализация списка."
     4867                                           , input 0
     4868                                           , input "init"
     4869                                           , input '':U
     4870                                           , input '':U
     4871                                           , input '':U
     4872                                           , input ?
     4873                                           ).
     4874       display
     4875       tot-lns @ f-tot-lns
     4876       with frame Dialog-Frame.
     4877       run MyEnable in this-procedure .
     4878    end.
     4879    else do:
     4880      assign rs-list-method = "single".
     4881      run proc-b-add in this-procedure(input no
     4882                                     ,input ?
     4883                                     ,input rs-list-method
     4884                                     ,input rs-status)  no-error .
     4885     if error-status:error then return no-apply.
     4886   end.
     4887   END.
     4888   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     4889   or DELETE-CHARACTER of br-list
     4890   DO:
     4891     if not available cli-list then return no-apply.
     4892     assign rs-list-method = "single".
     4893       run proc-b-del in this-procedure(
     4894                                                  input no
     4895                                                 ,input ?
     4896                                                 ,input rs-list-method
     4897                                                 ,input rs-status) no-error .
     4898     if error-status:error then return no-apply.
     4899   END.
     4900   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     4901   DO:
     4902   if not available cli-list then return no-apply.
     4903     assign rs-list-method = "single".
     4904    run proc-b-rest in this-procedure(
     4905                                                   input no
     4906                                                  ,input ?
     4907                                                  ,input rs-list-method
     4908                                                  ,input rs-status) no-error .
     4909     if error-status:error then return no-apply.
     4910   END.
     4911   on choose of MENU-ITEM m-macro-file in menu m-play DO:
     4912     assign
     4913     macro-play-option = 'file':U.
     4914     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
