     4935   view-as alert-box QUESTION buttons yes-no update glog.
     4936   if not glog then return no-apply.
     4937   assign
     4938   an-listp-start-macro-id = v-seq
     4939   an-listp-end-macro-id = ?
     4940   .
     4941     menu-item m-macro-file:label in menu m-play = "Ранее записанный макрос формирования списка товаров".
     4942     menu-item m-macro-lob:sensitive in menu m-play = no.
     4943   disable
     4944   b-record with frame Dialog-Frame .
     4945   hide
     4946   b-record
     4947   b-macro
     4948   in frame Dialog-Frame .
     4949   enable
     4950   b-stop with frame Dialog-Frame .
     4951   run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     4952                                       , input-output v-seq
     4953                                       , input 0
     4954                                       , input 'o':U
     4955                                       , input "Начата запись макроса формирования списка"
     4956                                       , input tot-lns
     4957                                       , input 'macro':U
     4958                                       , input '':U
     4959                                       , input '':U
     4960                                       , input '':U
     4961                                       , input ?
     4962                                       ).
     4963   END.
     4964   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     4965   DO:
     4966   define variable glog as logical no-undo .
     4967   define variable v-id as integer no-undo .
     4968   define buffer buf_cli-list-hist for cli-list-hist.
     4969   message
     4970   "Закончить запись макроса формирования списка?"
     4971   view-as alert-box QUESTION buttons yes-no update glog.
     4972   if not glog then return no-apply.
     4973   assign
     4974   an-listp-end-macro-id = v-seq.
     4975   disable
     4976   b-stop with frame Dialog-Frame .
     4977   hide
     4978   b-stop in frame Dialog-Frame .
     4979   enable
     4980   b-record
     4981   b-macro
     4982   with frame Dialog-Frame .
     4983   run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     4984                                       , input-output v-seq
     4985                                       , input 0
     4986                                       , input '[]':U
     4987                                       , input "Закончена запись макроса формирования списка"
     4988                                       , input tot-lns
     4989                                       , input 'macro':U
     4990                                       , input '':U
     4991                                       , input '':U
     4992                                       , input '':U
     4993                                       , input ?
     4994                                       ).
     4995   for each macro-list-hist:
     4996     delete macro-list-hist.
     4997   end.
     4998   for each buf_cli-list-hist where
     4999           buf_cli-list-hist.id >=  an-listp-start-macro-id
     5000     and  buf_cli-list-hist.id <=  an-listp-end-macro-id:
     5001     create macro-list-hist.
     5002     buffer-copy buf_cli-list-hist
     5003     except id num-recs num-add num-ignored
     5004     to macro-list-hist
     5005     assign
     5006     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5007     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5008     .
     5009   end.
     5010   END.
     5011   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     5012   DO:
     5013   disable
     5014   b-clear-macro with frame Dialog-Frame .
     5015   assign
     5016   an-listp-start-macro-id = ?
     5017   an-listp-end-macro-id = ?
     5018   an-listp-macros-label-id = 0
     5019   .
     5020   menu-item m-macro-lob:sensitive in menu m-play = yes.
     5021   for each macro-list-hist:
     5022     delete macro-list-hist.
     5023   end.
     5024   hide
     5025   b-clear-macro in frame Dialog-Frame .
     5026   enable
     5027   b-record
     5028   b-macro
     5029   with frame Dialog-Frame .
     5030   END.
     5031   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     5032   DO:
