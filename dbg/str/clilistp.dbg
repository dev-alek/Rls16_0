     1605   def
     1606   new shared
     1607   temp-table  obj-list no-undo
     1608     field obj-type like ub.clients.obj-type
     1609     field obj-code like ub.clients.obj-code
     1610     field obj-name like ub.clients.obj-name
     1611     field obj-id   as integer
