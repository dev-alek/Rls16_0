     5869   PROCEDURE MyEnable :
     5870   define variable v-start as logical no-undo .
     5871   define variable v-recid0 as recid no-undo .
     5872   define buffer buf_temp-list for temp-list.
     5873   define buffer buf_cli-list-hist for cli-list-hist.
     5874   find first buf_cli-list-hist where buf_cli-list-hist.id = 0 no-error.
     5875   if available buf_cli-list-hist then
     5876   assign
     5877   frame Dialog-Frame:title = substitute("СПИСОК  КАРТ &1",  string(buf_cli-list-hist.des, "X(60)"))
     5878   .
     5879   br-option:column-scrolling in frame Dialog-Frame  = no.
     5880   assign
     5881   frame Dialog-Frame:title = p-title
     5882   .
     5883   if tot-lns = ? then do:
     5884     v-start = yes.
     5885     for each l-cli-list :
     5886       accumulate l-cli-list.obj-code (count).
     5887     end.
     5888     tot-lns = (accum count l-cli-list.obj-code).
     5889     if tot-lns > 0 then do:
     5890       find last  buf_cli-list-hist no-error .
     5891       v-seq = (if available buf_cli-list-hist then buf_cli-list-hist.id else 0)  + 1.
     5892       run create-cli-list-hist in this-procedure (
     5893                                               input 'ДОБАВЛЕНИЕ':U
     5894                                             , input-output v-seq
     5895                                             , input 0
     5896                                             , input 'S':U
     5897                                             , input substitute("# Исходный список: &1 строк", tot-lns)
     5898                                             , input tot-lns
     5899                                             , input "start":U
     5900                                             , input '':U
     5901                                             , input '':U
     5902                                             , input '':U
     5903                                             , input ?
     5904                                             ).
     5905     end.
     5906     else do:
     5907       line-mode = 'ДОБАВЛЕНИЕ':U.
     5908       for each buf_cli-list-hist:
     5909         delete buf_cli-list-hist.
     5910       end.
     5911       v-seq = 1.
     5912       run create-cli-list-hist in this-procedure ( input 'ДОБАВЛЕНИЕ':U
     5913                                             , input-output v-seq
     5914                                             , input 0
     5915                                             , input '':U
     5916                                             , input "# Исходный список клиентов пуст."
     5917                                             , input tot-lns
     5918                                             , input 'start':U
     5919                                             , input '':U
     5920                                             , input '':U
     5921                                             , input '':U
     5922                                             , input ?
     5923                                             ).
     5924     end.
     5925   end.
     5926   assign
     5927   nameorcode = ""
     5928   RS-list-method = "single".
     5929   find first buf_temp-list no-lock where
     5930               buf_temp-list.fvalue = "single".
     5931   assign
     5932   v-recid0 = recid(buf_temp-list).
     5933   open query br-option for each temp-list no-lock .
     5934   if v-seq > 1 then
     5935   find last buf_cli-list-hist no-lock where
     5936             buf_cli-list-hist.id = (v-seq - 1)
     5937         and  buf_cli-list-hist.line = 0 no-error .
     5938   DISPLAY br-option
     5939   (if available buf_cli-list-hist
     5940   then buf_cli-list-hist.des
     5941   else '') @ dsp-rs
     5942   RS-Status WITH FRAME Dialog-Frame.
     5943   ENABLE
     5944   b-macro  when v-start
     5945   b-record when v-start
     5946   b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     5947   if v-start then do:
     5948     hide
     5949     b-stop
     5950     b-clear-macro
     5951     in frame Dialog-Frame.
     5952   end.
     5953   v-start = no.
     5954   hide nameorcode in frame Dialog-Frame .
     5955   if lookup('list':U, bttns) > 0 then do:
     5956       menu-item m_cli-save-db:sensitive  in menu menu-b-save = no.
     5957   end.
     5958   if lookup('list-macro':U, bttns) > 0 then do:
     5959       menu-item m-macros-save-db:sensitive  in menu menu-b-save = no.
     5960   end.
     5961   reposition br-option to recid v-recid0.
     5962   if tot-lns > 0 then
     5963     ENABLE
     5964     b-print
     5965     b-rest
     5966     b-save
     5967     b-del
     5968     b-lkp
     5969     b-clr
     5970     n-c
     5971     nameorcode
     5972     WITH FRAME Dialog-Frame.
     5973   else do:
     5974     DISABLE b-print b-rest b-save b-del b-lkp b-clr n-c nameorcode WITH FRAME Dialog-Frame.
     5975   end.
     5976   if tot-lns = ? or tot-lns = 0 then do:
     5977     hide nameorcode in frame Dialog-Frame .
     5978   end.
     5979   VIEW FRAME Dialog-Frame.
     5980   run openbr in this-procedure .
     5981       if line-rec <> ? then
     5982     reposition br-list to recid line-rec no-error.
     5983   if avail cli-list then do:     assign ed-notes = cli-list.ps.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.   else do:     assign ed-notes = ''.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.
     5984   END PROCEDURE.
     5985   PROCEDURE Openbr :
     5986   Open query br-list
     5987   for each cli-list No-LOCK indexed-reposition.
     5988   APPLY "ENTRY" to br-list in frame Dialog-Frame.
     5989   END PROCEDURE.
     5990   PROCEDURE proc-b-add :
     5991   define input parameter p-from-macro as logical no-undo .
     5992   define input parameter p-rowid as rowid no-undo .
     5993   define input parameter rs-list-method as character no-undo .
     5994   define input parameter rs-status as character no-undo .
     5995   line-mode = 'ДОБАВЛЕНИЕ':U.
     5996   if rs-list-method = "single" then do:
     5997     v-no-hist = - 1.
     5998     if p-from-macro then do:
     5999       find ub.clients where rowid(ub.clients) = p-rowid no-lock no-error .
     6000     end.
     6001     else do:
     6002     run ref/cli-all.w (
     6003                         input parparentproc
     6004                       , input "b-sel,b-add"
     6005                       , input ?
     6006                       , input ?
     6007                       , input ?
     6008                       , input ?
     6009                       , input ?
     6010                       , input ?
     6011                       , output ref-list).
     6012       apply "entry" to br-list in frame Dialog-Frame.
     6013       if ref-list = "" then return error.
     6014       find ub.clients where recid (ub.clients) = integer (ref-list) no-lock.
     6015     end.
     6016     if available ub.clients then do:
     6017       run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     6018       tot-lns = tot-lns + 1.
     6019       run write-hist in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode).
     6020     end.
     6021     else do:
     6022       return error "Нет в БД такого клиента".
     6023     end.
     6024     run Myenable in this-procedure .
     6025   end.
     6026   else do:
     6027       run rs-do in this-procedure ( input no, input no, input rs-list-method, input rs-status, input line-mode, input (v-seq - 1)).
     6028   end.
     6029   END PROCEDURE.
     6030   PROCEDURE proc-b-del :
     6031   define input parameter p-from-macro as logical no-undo .
     6032   define input parameter p-rowid as rowid no-undo .
     6033   define input parameter rs-list-method as character no-undo .
     6034   define input parameter rs-status as character no-undo .
     6035   define variable rep-rec as recid no-undo .
     6036   define variable glog as logical no-undo .
     6037   line-mode = 'удаление':U.
     6038   if rs-list-method = "single" then do:
     6039     v-no-hist = - 1.
     6040     if p-from-macro then do:
     6041       find first ub.clients where rowid(ub.clients) = p-rowid no-error.
     6042       if not available ub.clients then return error "Нет в БД такой клиента".
     6043       find first cli-list where
     6044                cli-list.obj-type = ub.clients.obj-type
     6045            AND cli-list.obj-code = ub.clients.obj-code no-error.
     6046     end.
     6047     if available cli-list then do:
     6048       line-rec = recid (cli-list).
     6049       get next br-list.
     6050       if available cli-list then rep-rec = recid (cli-list).
     6051       else do:
     6052         reposition br-list to recid line-rec no-error.
     6053         get prev br-list.
     6054         if available cli-list then rep-rec = recid (cli-list).
     6055       end.
     6056       reposition br-list to recid line-rec no-error.
     6057       tot-lns = tot-lns - 1.
     6058       run write-hist in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode).
     6059       delete cli-list.
     6060       line-rec = rep-rec.
     6061       run Myenable in this-procedure .
     6062     end.
     6063   end.
     6064   else do:
     6065     glog = no.
     6066     message "Удалить клиентов из списка ПО заданному УСЛОВИЮ ?   Вы уверены ?"
     6067             view-as alert-box question buttons OK-Cancel update glog.
     6068     if not glog then
     6069       return error.
     6070     run rs-do in this-procedure ( input no, input no, input rs-list-method, input rs-status, input line-mode, input (v-seq - 1)).
     6071   end.
     6072   END PROCEDURE.
     6073   PROCEDURE proc-b-rest :
     6074   define input parameter p-from-macro as logical no-undo .
     6075   define input parameter p-rowid as rowid no-undo .
     6076   define input parameter rs-list-method as character no-undo .
     6077   define input parameter rs-status as character no-undo .
     6078   define variable glog as logical no-undo .
     6079   define buffer buf_cli-list-hist for cli-list-hist.
     6080   line-mode = 'ОСТАВИТЬ':U.
     6081   if rs-list-method = "single" then do:
     6082     v-no-hist = - 1.
     6083     if p-from-macro then do:
     6084       find first ub.clients where rowid(ub.clients) = p-rowid no-error.
     6085       if not available ub.clients then return error substitute("Нет в БД такого клиента").
     6086       find first cli-list where
     6087                 cli-list.obj-type = ub.clients.obj-type
     6088             AND cli-list.obj-code = ub.clients.obj-code no-error.
     6089     end.
     6090     if available cli-list then do:
     6091       if p-from-macro then do:
     6092          glog = yes.
     6093       end.
     6094       else do:
     6095         glog = no.
     6096         message
     6097         "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     6098         view-as alert-box question buttons OK-Cancel update glog.
     6099         if not glog then return no-apply.
     6100       end.
     6101       line-rec = recid (cli-list).
     6102       v-seq = 1.
     6103       for each buf_cli-list-hist:
     6104         delete buf_cli-list-hist.
     6105       end.
     6106       run write-hist in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode).
     6107       for each cli-list:
     6108         if line-rec <> recid (cli-list) then delete cli-list.
     6109       end.
     6110       tot-lns = 1.
     6111       run Myenable in this-procedure .
     6112     end.
     6113     else do:
     6114       return error substitute("Нет в списке такой клиента").
     6115     end.
     6116   end.
     6117   else do:
     6118     if not p-from-macro then do:
     6119       glog = no.
     6120       message
     6121       "Оставить клиентов в списке ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕХ ОСТАЛЬНЫХ ?   Вы уверены ?"
     6122       view-as alert-box question buttons OK-Cancel update glog.
     6123       if not glog then
     6124         return no-apply.
     6125     end.
     6126     assign
     6127     lns-cnt = 0
     6128     lns-ignore = 0
     6129     .
     6130     run rs-do in this-procedure ( input no, input no, input rs-list-method, input rs-status, input line-mode, input (v-seq - 1)).
     6131     for each cli-list:
     6132       if cli-list.to-del = ? then do:
     6133         assign
     6134         cli-list.to-del = no
     6135         .
     6136       end.
     6137       else do:
     6138         delete cli-list.
     6139       end.
     6140     end.
     6141     tot-lns = lns-cnt.
     6142     run Myenable in this-procedure .
     6143     message
     6144     "Оставлено строк :" lns-cnt skip(0)
     6145     string(if lns-ignore <> 0
     6146     then ("Проигнорировано строк :" + string(lns-ignore))
     6147     else "":U)
     6148     .
     6149   end.
     6150   END PROCEDURE.
     6151   procedure proc-file-list-methods :
     6152   define input parameter p-from-macro as logical no-undo .
     6153   define input parameter rs-list-method as character no-undo .
     6154   define input parameter rs-status as character no-undo .
     6155   define input parameter line-mode as character no-undo .
     6156   define input parameter p-id      as integer no-undo .
     6157   define variable ss as character no-undo .
     6158   define variable imp-type like ub.goods.prod-type no-undo.
     6159   define variable imp-code like ub.goods.prod-code no-undo.
     6160   define variable imp-art like ub.goods.artic no-undo.
     6161   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
     6162   define variable imp-doc-type as character no-undo.
     6163   define variable v-full-path        as character no-undo .
     6164   define variable v-path             as character no-undo .
     6165   define variable v-file-name        as character no-undo .
     6166   define variable v-file-name-no-ext as character no-undo .
     6167   define variable v-file-name-ext    as character no-undo .
     6168   define variable v-tbl-row          as rowid no-undo .
     6169   define variable v-tbl-name         as character no-undo .
     6170   define buffer buf_cli-list-hist for cli-list-hist.
     6171   define buffer buf_clob-data for ub.clob-data.
     6172   define buffer buf_clob-bind for ub.clob-bind.
     6173   do
     6174   on error undo, return error
     6175   :
     6176     find first buf_cli-list-hist where
     6177             buf_cli-list-hist.id = p-id
     6178         AND buf_cli-list-hist.item_ <> '':U .
     6179   if rs-list-method = "clob-data" then do:
     6180     run gen-row-keyr in this-procedure (
     6181      input  buf_cli-list-hist.item_
     6182     ,input  ?
     6183     ,input  "ub"
     6184     ,input  ?
     6185     ,input NO-LOCK
     6186     ,output v-tbl-row
     6187     ,output v-tbl-name  ) no-error.
     6188     if error-status :error then do:
     6189       message
     6190       "Ошибка при поиске хранимого файла"
     6191       view-as alert-box error.
     6192       return error.
     6193     end.
     6194     find first buf_clob-bind no-lock where
     6195               rowid(buf_clob-bind) = v-tbl-row .
     6196     find first buf_clob-data no-lock where
     6197               buf_clob-data.db-num = buf_clob-bind.db-num
     6198           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     6199     if error-status :error then do:
     6200       message
     6201       "Ошибка при пополучении хранимого файла"
     6202       view-as alert-box error.
     6203       return error.
     6204     end.
     6205     run gbl/_tmpfile.p ( input ""
     6206                   ,input "tmp"
     6207                   ,output v-file-name) .
     6208     copy-lob from object buf_clob-data.cdata
     6209     to file v-file-name.
     6210   end.
     6211     run gbl/filename.p (
     6212      input  (if rs-list-method = "clob-data" then v-file-name else buf_cli-list-hist.item_  )
     6213     ,output v-full-path
     6214     ,output v-path
     6215     ,output v-file-name
     6216     ,output v-file-name-no-ext
     6217     ,output v-file-name-ext
     6218     ) no-error .
     6219     if error-status:error then do:
     6220     end.
     6221     else do:
     6222       input stream sout from value (v-full-path).
     6223       CASE rs-list-method:
     6224         when "doc-list" then do:
     6225           repeat:
     6226             import stream sout imp-doc-code imp-doc-type no-error.
     6227             if imp-doc-type <>  'переоценка':U then do:
     6228               find first ub.trn-doc no-lock where
     6229                         ub.trn-doc.doc-code = imp-doc-code No-error.
     6230               if available ub.trn-doc  then do:
     6231                 find first ub.clients no-lock where
     6232                           ub.clients.obj-type = ub.trn-doc.cli-type
     6233                       AND ub.clients.obj-code = ub.trn-doc.cli-code no-error.
     6234                  if available ub.clients then
     6235                  run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     6236               end.
     6237             end.
     6238           end.
     6239         end.
     6240         when "file"
     6241         or
     6242         when "clob-data"
     6243         then do:
     6244           repeat:
     6245             import stream sout imp-type imp-code no-error.
     6246             find clients where
     6247                 clients.obj-type = imp-type and
     6248                 CLIENTS.OBJ-code = imp-code
     6249                 no-lock no-error.
     6250             if available CLIENTS then do:
     6251               run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     6252             end.
     6253           end.
     6254           if rs-list-method = "clob-data" then do:
     6255             os-delete value(v-full-path) .
     6256           end.
     6257         end.
     6258         when "gds-list" then do:
     6259           repeat:
     6260             import stream sout imp-type imp-code imp-art no-error.
     6261             find ub.goods where ub.goods.prod-type = imp-type
     6262                       and ub.goods.prod-code = imp-code
     6263                       and ub.goods.artic     = imp-art no-lock no-error.
     6264             if available ub.goods then do:
     6265               find first ub.clients no-lock where
     6266                         ub.clients.obj-type = ub.goods.prod-type
     6267                     AND ub.clients.obj-code = ub.goods.prod-code no-error.
     6268               if available ub.clients then do:
     6269                 run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     6270               end.
     6271             end.
     6272           end.
     6273         end.
     6274       end CASE.
     6275     end.
     6276     input stream sout close.
     6277     assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     6278   end.
     6279   end procedure.
     6280   PROCEDURE proc-b-save :
     6281   define input parameter loc-save-option as character no-undo.
     6282   define variable v-frame-width as integer no-undo.
     6283   define variable glog as logical no-undo .
     6284   define variable v-rid-list as character no-undo .
     6285   case loc-save-option:
     6286     when "cli-list":U then do:
     6287       assign
     6288       f-name = "default.cli"
     6289       glog = yes
     6290       .
     6291       system-dialog get-file f-name
     6292       filters "Списки клиентов *.cli" "*.cli"
     6293       ask-overwrite
     6294       save-as
     6295       use-filename
     6296       update glog
     6297       default-extension "cli".
     6298       if not glog then do:
     6299         apply "entry" to br-list in frame Dialog-Frame.
     6300         return no-apply.
     6301       end.
     6302       output to value (f-name).
     6303       for each cli-list:
     6304         export
     6305         cli-list.obj-type
     6306         cli-list.obj-code
     6307         .
     6308       end.
     6309       output close.
     6310     end.
     6311     when "cli-list-macros-db" then do:
     6312       run m-macros-save-db-proc in this-procedure .
     6313     END.
     6314     when "cli-list-db" then do:
     6315       run m_cli-save-db-proc in this-procedure .
     6316     end.
     6317     when "excel":U then do:
     6318       do on stop  undo, return no-apply
     6319           on error undo, return no-apply
     6320           on quit  undo, return no-apply
     6321       :
     6322         run str/clil-prn.p (
     6323                          input parparentproc
     6324                         ,input "excel":U
     6325                         ,output v-Frame-Width) no-error.
     6326         run waitfram-hide in this-procedure .
     6327       end.
     6328     end.
     6329   end case.
     6330   END PROCEDURE.
     6331   PROCEDURE proc-find-nameorcode :
     6332   case n-c:
     6333     when 'название':U then do:
     6334       if last-event:label = "Ctrl-J" then
     6335           find next l-cli-list no-lock where
     6336                      l-cli-list.obj-name begins nameorcode no-error.
     6337       else
     6338           find first l-cli-list no-lock where
     6339                      l-cli-list.obj-name begins nameorcode no-error.
     6340     end.
     6341     when 'код':U then do:
     6342       if last-event:label = "Ctrl-J" then
     6343           find next l-cli-list no-lock where
     6344                      l-cli-list.obj-code = integer(nameorcode) no-error.
     6345       else
     6346           find first l-cli-list no-lock where
     6347                      l-cli-list.obj-code = integer(nameorcode) no-error.
     6348     end.
     6349   end case.
     6350   if available l-cli-list then do:
     6351     line-rec = recid (l-cli-list).
     6352     reposition br-list to recid line-rec no-error.
     6353     apply "value-changed" to br-list in frame Dialog-Frame.
     6354   end.
     6355   else do:
     6356     message
     6357     "Строка не найдена."
     6358     view-as alert-box error.
     6359   end.
     6360   END PROCEDURE.
     6361   procedure proc-macros :
     6362   define variable glog as logical no-undo .
     6363   define variable v-option as integer no-undo .
     6364   define buffer buf_cli-list-hist for cli-list-hist.
     6365   define buffer buf_macro-list-hist for macro-list-hist.
     6366   if can-find(first macro-list-hist) then do:
     6367     run gbl/d-askw.w ( input "Сохранение макроса"
     6368                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
     6369                   ,input "|"
     6370                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
     6371                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
     6372                   ,input 1
     6373                   ,input 3
     6374                   ,output v-option).
     6375     if v-option = 3 then return no-apply.
     6376     v-option = 1.
     6377   end.
     6378   else do:
     6379     message
     6380     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
     6381     view-as alert-box question buttons yes-no update glog.
     6382     v-option = 2.
     6383     if not glog then do:
     6384       return no-apply.
     6385     end.
     6386   end.
     6387     do
     6388     on error undo, return error
     6389     :
     6390     assign
     6391       f-name = "default.clm"
     6392       glog = yes
     6393       .
     6394     system-dialog get-file f-name
     6395       filters "Макрос создания списка клиентов *.clm" "*.clm"
     6396       ask-overwrite
     6397       save-as
     6398       use-filename
     6399       update glog
     6400       default-extension "clm".
     6401     if not glog then do:
     6402       apply "entry" to br-list in frame Dialog-Frame.
     6403       return no-apply.
     6404     end.
     6405     run waitfram-show in this-procedure ( input "Сохранение макроса формирования списка клиентов.    ЖДИТЕ...").
     6406     output stream PrnLibStream to value (f-name).
     6407     case v-option:
     6408       when 1 then do:
     6409         for each buf_macro-list-hist:
     6410           export stream PrnLibStream
     6411           buf_macro-list-hist.
     6412         end.
     6413       end.
     6414       when 2 then do:
     6415     for each buf_cli-list-hist:
     6416         export stream PrnLibStream
     6417         buf_cli-list-hist.
     6418     end.
     6419       end.
     6420     end case.
     6421     output stream PrnLibStream close.
     6422     run waitfram-hide in this-procedure .
     6423     end.
     6424   end procedure.
     6425   PROCEDURE proc-vc-rs-list-method :
     6426   define variable v-operation as integer no-undo .
     6427   define variable ii as integer no-undo.
     6428   define variable glog as logical no-undo .
     6429   define variable v-recs as integer no-undo .
     6430   define variable v-line as integer no-undo .
     6431   define variable v-item as character no-undo .
     6432   define variable v-tbl-name as character no-undo .
     6433   define variable v-bh as handle no-undo .
     6434   define variable v-tot-lns as integer no-undo .
     6435   define variable v-temp-seq as integer no-undo .
     6436   define variable v-message as character no-undo .
     6437   define variable grp-path as character no-undo .
     6438   define variable v-input-output as character no-undo .
     6439   define variable v-ref-rec as recid no-undo .
     6440   define variable v-grp-rec as recid no-undo .
     6441   define variable v-rid-list as character no-undo .
     6442   define variable v-uniq-key-rec as character no-undo .
     6443   define variable f-name as char init "default.cli" no-undo.
     6444   define buffer buf_clob-bind for ub.clob-bind.
     6445   define buffer buf_cli-list-hist for cli-list-hist.
     6446   v-no-hist = - 1.
     6447   if  rs-list-method = "single" then
     6448   run Myenable in this-procedure .
     6449   else do:
     6450      v-no-hist = 0.
     6451     case rs-list-method:
     6452       when "all" then do:
     6453         glog = yes.
     6454         message "Все клиенты из справочника клиентов"
     6455         skip stat-line(rs-status)
     6456         view-as alert-box question buttons OK-Cancel update glog.
     6457         if not glog then do:
     6458           run MyEnable in this-procedure .
     6459           return error.
     6460         end.
     6461         v-no-hist = 1.
     6462         run create-cli-list-hist in this-procedure (
     6463                                               input 'ДОБАВЛЕНИЕ':U
     6464                                             , input-output v-seq
     6465                                             , input 0
     6466                                             , input '':U
     6467                                             , input substitute('Все клиенты &1', stat-line(rs-status))
     6468                                             , input tot-lns
     6469                                             , input rs-list-method
     6470                                             , input rs-status
     6471                                             , input 'all':U
     6472                                             , input '':U
     6473                                             , input ?
     6474                                             ).
     6475       end.
     6476       when "cli"
     6477       or
     6478       WHEN "cli-grp" then do:
     6479         if rs-list-method = "cli-grp" then do:
     6480           glog = yes.
     6481           message "1 или несколько групп клиентов"
     6482           skip stat-line(rs-status)
     6483           view-as alert-box question buttons OK-Cancel update glog.
     6484           if not glog then do:
     6485             run MyEnable in this-procedure .
     6486             return error.
     6487           end.
     6488           GRP-list = "".
     6489           ref-list = "".
     6490           run ref/cli-grps.w ( input parparentproc
     6491                              , input "b-sel,b-mark"
     6492                              , input-output grp-list).
     6493         end.
     6494         else do:
     6495           glog = yes.
     6496           message "1 или несколько произвольных клиентов из справочника."
     6497           skip stat-line(rs-status)
     6498           view-as alert-box question buttons OK-Cancel update glog.
     6499           if not glog then do:
     6500             run MyEnable in this-procedure .
     6501             return error.
     6502           end.
     6503           run ref/cli-all.w ( input parparentproc
     6504                           , input "b-sel,b-mark,b-add"
     6505                           , input ?
     6506                           , input ?
     6507                           , input ?
     6508                           , input ?
     6509                           , input ?
     6510                           , input ?
     6511                           , output ref-list).
     6512           grp-list = ?.
     6513         end.
     6514         if grp-list <> ? and
     6515         grp-list <> "" then do:
     6516           v-recs = num-entries (grp-list).
     6517           do num-rec = 0 to v-recs:
     6518             if v-recs = 1 then do:
     6519               num-rec = 1 .
     6520             end.
     6521             if num-rec > 0 then do:
     6522               v-grp-rec = integer (entry (num-rec, grp-list)).
     6523               find ub.cli-grp where recid (ub.cli-grp) = v-grp-rec no-lock.
     6524               run cli-grplib-get-full-name in this-procedure ( input ub.cli-grp.node-code, output grp-path).
     6525             end.
     6526             if v-recs = 1 then do:
     6527               assign
     6528               v-temp-seq = v-seq
     6529               v-line     = 0
     6530               dsp-rs = substitute("Группа клиентов &1 &2", grp-path, stat-line(rs-status))
     6531               v-item     = '':U
     6532               v-tbl-name = 'cli-grp':U
     6533               v-bh       = buffer cli-grp:handle
     6534               v-tot-lns = tot-lns
     6535               .
     6536             end.
     6537             else do:
     6538               if num-rec = 0 then do:
     6539                 assign
     6540                 v-temp-seq = v-seq
     6541                 v-line     = 0
     6542                 dsp-rs = substitute("Группы клиентов: &1", stat-line(rs-status))
     6543                 v-item     = '':U
     6544                 v-tbl-name = '':U
     6545                 v-bh       = ?
     6546                 v-tot-lns = tot-lns
     6547                 .
     6548               end.
     6549               else do:
     6550                 assign
     6551                 v-temp-seq = v-seq - 1
     6552                 v-line     = num-rec
     6553                 dsp-rs = substitute("&1", grp-path)
     6554                 v-item     = '':U
     6555                 v-tbl-name = 'cli-grp':U
     6556                 v-bh       = buffer cli-grp:handle
     6557                 v-tot-lns = tot-lns + num-rec
     6558                 .
     6559               end.
     6560             end.
     6561             v-no-hist = (if num-rec = 1 then 0 else num-rec).
     6562             run create-cli-list-hist in this-procedure (
     6563                                                   input 'ДОБАВЛЕНИЕ':U
     6564                                                 , input-output v-temp-seq
     6565                                                 , input v-line
     6566                                                 , input '':U
     6567                                                 , input dsp-rs
     6568                                                 , input v-tot-lns
     6569                                                 , input rs-list-method
     6570                                                 , input rs-status
     6571                                                 , input v-item
     6572                                                 , input v-tbl-name
     6573                                                 , input v-bh
     6574                                                 ).
     6575             if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     6576           end.
     6577         end.
     6578         else if ref-list <> "" and  ref-list <> ? then do:
     6579           v-recs = num-entries (ref-list) .
     6580           do num-rec = 0 to v-recs:
     6581             if v-recs = 1 then do:
     6582               num-rec = 1 .
     6583             end.
     6584             if num-rec > 0 then do:
     6585               v-ref-rec = integer (entry (num-rec, ref-list)).
