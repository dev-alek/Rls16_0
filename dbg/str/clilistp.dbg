     5647   PROCEDURE ex-cli :
     5648   define input parameter rs-list-method as character no-undo .
     5649   define input parameter rs-status as character no-undo .
     5650   define input parameter line-mode as character no-undo .
     5651   if rs-list-method = "single":U or
     5652     (ub.clients.stts = 0  and rs-status <> 'удаленные':U) or
     5653     (ub.clients.stts <> 0 and rs-status <> 'текущие':U) then do:
     5654     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
     5655       find first cli-list where
     5656                  cli-list.obj-type = ub.clients.obj-type AND
     5657                  cli-list.obj-code = ub.clients.obj-code no-error.
     5658       if available cli-list then do:
     5659         if line-mode = 'удаление':U then do:
     5660           lns-cnt = lns-cnt + 1.
     5661           delete cli-list.
     5662         end.
     5663         else do:
     5664           if cli-list.to-del = ? then .
     5665           else do:
     5666              lns-cnt = lns-cnt + 1.
     5667              cli-list.to-del = ?.
     5668           end.
     5669         end.
     5670       end.
     5671     end.
     5672     else
     5673       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
     5674   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5675   find cli-list
     5676     where cli-list.obj-type = clients.obj-type
     5677       and cli-list.obj-code = clients.obj-code
     5678     no-error .
     5679   if available cli-list then do:
     5680     assign
     5681       cli-list.to-del = no
     5682     .
     5683   end.
     5684   else do:
     5685     create cli-list .
     5686     buffer-copy clients to cli-list
     5687     assign
     5688       cli-list.to-del = no
     5689     .
     5690     assign
     5691       lns-cnt = lns-cnt + 1
     5692       line-rec = recid (cli-list)
     5693     .
     5694   end.
     5695       end.
     5696     if lns-cnt modulo 25 = 0 then
     5697     disp "Ждите..." + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     5698   end.
     5699   else
     5700   assign
     5701   lns-ignore = lns-ignore + 1
     5702   .
     5703   end.
     5704   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5705   do:
     5706     br-list :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     5707   end.
     5708   MAIN-BLOCK:
