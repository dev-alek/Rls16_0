     7147                                             , input '':U
     7148                                             , input substitute("Производители товаров из списка: &1 &2", f-name, stat-line(rs-status))
     7149                                             , input tot-lns
     7150                                             , input rs-list-method
     7151                                             , input rs-status
     7152                                             , input f-name
     7153                                             , input '':U
     7154                                             , input ?
     7155                                             ).
     7156       end.
     7157       when "deleted" then do:
     7158         if RS-status = 'текущие':U then do:
     7159           message
     7160           "Переключатель <СТАТУС> стоит в положениии <Текущие>" skip
     7161           "Вы не cможете выбрать ни одного клиента"
     7162           view-as alert-box error .
     7163           run MyENable in this-procedure .
     7164           return error.
     7165         end.
     7166         glog = yes.
     7167         message "Все удаленные клиенты."
     7168         skip stat-line(rs-status)
     7169         view-as alert-box question buttons OK-Cancel update glog.
     7170         if not glog then do:
     7171           run MyEnable in this-procedure .
     7172           return error.
     7173         end.
     7174         run create-cli-list-hist in this-procedure (
     7175                                               input 'ДОБАВЛЕНИЕ':U
     7176                                             , input-output v-seq
     7177                                             , input 0
     7178                                             , input '':U
     7179                                             , input substitute('Все удаленные клиенты. &1', stat-line(rs-status))
     7180                                             , input tot-lns
     7181                                             , input rs-list-method
     7182                                             , input rs-status
     7183                                             , input 'deleted':U
     7184                                             , input '':U
     7185                                             , input ?
     7186                                             ).
     7187       end.
     7188       when "file" then do:
     7189         glog = yes.
     7190         message "Все клиенты из ранее сохраненного в файле списка"
     7191         skip stat-line(rs-status)
     7192         view-as alert-box question buttons OK-Cancel update glog.
     7193         if not glog then do:
     7194           run Myenable in this-procedure .
     7195           return error.
     7196         end.
     7197         system-dialog get-file f-name
     7198         filters "Списки клиентов *.cli" "*.cli"
     7199         title "Выберите файл списка"
     7200         INITIAL-DIR "."
     7201         return-to-start-dir
     7202         must-exist
     7203         update glog
     7204         default-extension "cli".
     7205         if not glog then do:
     7206           run MyEnable in this-procedure .
     7207           return error.
     7208         end.
     7209         run create-cli-list-hist in this-procedure (
     7210                                               input 'ДОБАВЛЕНИЕ':U
     7211                                             , input-output v-seq
     7212                                             , input 0
     7213                                             , input '':U
     7214                                             , input substitute("Все клиенты из сохраненного в файле списка клиентов &1 &2", f-name, stat-line(rs-status))
     7215                                             , input tot-lns
     7216                                             , input rs-list-method
     7217                                             , input rs-status
     7218                                             , input f-name
     7219                                             , input '':U
     7220                                             , input ?
     7221                                             ).
     7222       end.
     7223       when "clob-data" then do:
     7224         glog = yes.
     7225         message "Все клиенты из ранее сохраненного в БД списка"
     7226         skip stat-line(rs-status)
     7227         view-as alert-box question buttons OK-Cancel update glog.
     7228         if not glog then do:
     7229           run Myenable in this-procedure.
     7230           return error.
     7231         end.
     7232         run ref/clobbnds.w ( input parparentproc
     7233                             ,input this-procedure:handle
     7234                             ,input 'b-sel'
     7235                             ,input "uniq-key-rec"
     7236                             ,input ""
     7237                             ,input 'list':U
     7238                             ,input 'cli-list'
     7239                             ,input -1
     7240                             ,input-output v-rid-list) no-error.
     7241         if v-rid-list = '' then do:
     7242           run Myenable in this-procedure.
     7243           return error.
     7244         end.
     7245         find first buf_clob-bind no-lock where
     7246                   recid(buf_clob-bind) = integer(v-rid-list) .
     7247         run gen-key-rec in this-procedure ( input 'clob-bind':U
     7248                                             ,input (buffer buf_clob-bind:handle)
     7249                                             ,output v-uniq-key-rec).
     7250         run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7251                                             , input-output v-seq
     7252                                             , input 0
     7253                                             , input '':U
     7254                                             , input substitute("Хранимый Файл списка : &1 &2", buf_clob-bind.field-name, stat-line(rs-status))
     7255                                             , input tot-lns
     7256                                             , input rs-list-method
     7257                                             , input rs-status
     7258                                             , input v-uniq-key-rec
     7259                                             , input '':U
     7260                                             , input ?
     7261                                             ).
     7262       end.
     7263       WHEN "FILTER" THEN DO:
     7264         run trig-filter in this-procedure no-error.
     7265         if error-status:error then do:
     7266           run MyEnable in this-procedure .
     7267           return error.
     7268         end.
     7269       END.
     7270     end case.
     7271     if tot-lns <> 0 then do:
     7272       run get-operation in this-procedure ( input dsp-rs, output v-operation).
     7273       CASE v-operation:
     7274         when 1 then do:
     7275           run proc-b-add in this-procedure ( input no, input ?, input rs-list-method, input rs-status) no-error  .
     7276         end.
     7277         when 2 then do:
     7278           run proc-b-del in this-procedure ( input no, input ?, input rs-list-method, input rs-status ) no-error  .
     7279         end.
     7280         when 3 then do:
     7281           run proc-b-rest in this-procedure ( input no, input ?, input rs-list-method, input rs-status) no-error  .
     7282         end.
     7283         otherwise do:
     7284           assign
     7285           dsp-rs = "":U.
     7286           run MyEnable in this-procedure .
     7287           return error.
     7288         end.
     7289       END CASE.
     7290     end.
     7291     assign
     7292     rs-list-method =  temp-list.fvalue
     7293       .
     7294     find last buf_cli-list-hist no-lock where
     7295               buf_cli-list-hist.id = (v-seq - 1)
     7296         and  buf_cli-list-hist.line = 0 no-error .
     7297     DISPLAY
     7298     (if available buf_cli-list-hist
     7299     then buf_cli-list-hist.des
     7300     else '') @ dsp-rs
     7301     with frame Dialog-Frame.
     7302     if tot-lns = 0
     7303     then do:
     7304       run proc-b-add in this-procedure ( input no, input ?, input rs-list-method, input rs-status)  .
     7305     end.
     7306   end.
     7307   END PROCEDURE.
     7308   PROCEDURE rs-do :
     7309   define input parameter p-from-macro as logical no-undo .
     7310   define input parameter p-step as logical no-undo .
     7311   define input parameter rs-list-method as character no-undo .
     7312   define input parameter rs-status as character no-undo .
     7313   define input parameter line-mode as character no-undo .
     7314   define input parameter p-id      as integer no-undo .
     7315   define variable grp-path like ub.goods.grp-name no-undo.
     7316   define variable imp-ART like ub.goods.ARTIC no-undo.
     7317   define variable scan-qnty as dec no-undo.
     7318   define variable imp-type like ub.goods.prod-type no-undo.
     7319   define variable imp-code like ub.goods.prod-code no-undo.
     7320   define variable v-report-num as integer no-undo .
     7321   define variable glog as logical no-undo .
     7322   define variable v-rowid   as rowid no-undo .
     7323   define variable v-tbl-name as character no-undo .
     7324   define variable v-obj-type as character  no-undo.
     7325   define variable v-obj-code as integer    no-undo.
     7326   DEFINE VARIABLE v-attr-code          as character           no-undo .
     7327   define variable v-sum-1 as decimal no-undo .
     7328   define variable v-sum-2 as decimal no-undo .
     7329   define variable v-cashier-role-string as character no-undo .
     7330   define variable v-seller-role-string as character no-undo .
     7331   DEFINE VARIABLE v-today as date no-undo .
     7332   DEFINE VARIABLE v-time as integer no-undo .
     7333   define buffer buf_cli-list-hist for cli-list-hist.
     7334   do
     7335   on error undo, return error return-value
     7336   :
     7337   assign
     7338   lns-cnt = 0
     7339   lns-ignore = 0
     7340   v-num-add  = 0
     7341   v-num-ignored = 0
     7342   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     7343   .
     7344   run write-hist in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode).
     7345   if session:set-wait-state( "COMPILER" )  then .
     7346   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     7347   case rs-list-method:
     7348     when "cli-grp" then do:
     7349       for each buf_cli-list-hist where
     7350                buf_cli-list-hist.id = p-id
     7351           and  buf_cli-list-hist.item_ <> '':U:
     7352         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_cli-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7353         grp-path = "".
     7354         find first ub.cli-grp no-lock where rowid(ub.cli-grp) = v-rowid.
     7355         grp-path = ''.
     7356         run cli-grplib-get-full-name in this-procedure ( input ub.cli-grp.node-code, output grp-path).
     7357         for each ub.clients no-lock where ub.clients.grp-name begins grp-path:
     7358           run ex-CLI in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7359         end.
     7360         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7361       end.
     7362     end.
     7363     when "cli"  then do:
     7364       for each buf_cli-list-hist where
     7365                buf_cli-list-hist.id = p-id
     7366           and  buf_cli-list-hist.item_ <> '':U:
     7367         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_cli-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7368         find first ub.clients no-lock where rowid(ub.clients) = v-rowid.
     7369         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7370         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7371       end.
     7372     end.
     7373     when "prod" then do:
     7374       find first buf_cli-list-hist where
     7375                  buf_cli-list-hist.id = p-id .
     7376       for each ub.clients where ub.clients.is-prod = yes no-lock:
     7377         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7378       end.
     7379       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7380     end.
     7381     when "sup-gds" then do:
     7382       find first buf_cli-list-hist where
     7383                  buf_cli-list-hist.id = p-id .
     7384         for each ub.clients where ub.clients.sup-gds = yes no-lock:
     7385         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7386       end.
     7387       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7388     end.
     7389     when "sup-cons" then do:
     7390       find first buf_cli-list-hist where
     7391                  buf_cli-list-hist.id = p-id .
     7392       for each ub.clients where ub.clients.sup-cons = yes no-lock:
     7393         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7394       end.
     7395       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7396     end.
     7397     when "buy-gds" then do:
     7398       find first buf_cli-list-hist where
     7399                  buf_cli-list-hist.id = p-id .
     7400       for each ub.clients where ub.clients.buy-gds = yes no-lock:
     7401         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7402       end.
     7403       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7404     end.
     7405     when "buy-cons" then do:
     7406       find first buf_cli-list-hist where
     7407                  buf_cli-list-hist.id = p-id .
     7408       for each ub.clients where ub.clients.buy-cons = yes no-lock:
     7409         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7410       end.
     7411       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7412     end.
     7413     when "buy-serv" then do:
     7414       find first buf_cli-list-hist where
     7415                  buf_cli-list-hist.id = p-id .
     7416       for each ub.clients where ub.clients.buy-serv = yes no-lock:
     7417         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7418       end.
     7419       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7420     end.
     7421     when "dis-card" then do:
     7422       find first buf_cli-list-hist where
     7423                  buf_cli-list-hist.id = p-id .
     7424       for each ub.clients no-lock,
     7425           first ub.dis-card no-lock where
     7426                 ub.dis-card.cli-type = ub.clients.obj-type AND
     7427                 ub.dis-card.cli-code = ub.clients.obj-code:
     7428         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7429       end.
     7430       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7431     end.
     7432     when "cashiers" then do:
     7433       if v-cntxt-db-num <> 0 then do:
     7434         v-cashier-role-string = gbclcode-get-work-place  (
     7435                                                     input 'C':U
     7436                                                   ,input 'db':U
     7437                                                   ,input v-cntxt-db-num
     7438                                                   ,input 0
     7439                                                   ,input '':U
     7440                                                   ,input 0  ).
     7441       end.
     7442       run cur-time in this-procedure ( output v-today, output v-time).
     7443       find first buf_cli-list-hist where
     7444                  buf_cli-list-hist.id = p-id .
     7445       for each ub.staff no-lock where
     7446               ub.staff.role = 'C':U
     7447           and ub.staff.role-leve = 'db':U
     7448           and (v-cntxt-db-num = 0 or ub.staff.work-place = v-cashier-role-string)
     7449           and ub.staff.date-end >= v-today,
     7450          first ub.clients no-lock where
     7451                 ub.clients.obj-type = 'чел':U AND
     7452                 ub.clients.obj-code = staff.psn-code:
     7453         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7454       end.
     7455       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7456     end.
     7457     when "sellers" then do:
     7458       if v-cntxt-db-num <> 0  then do:
     7459         v-cashier-role-string = gbclcode-get-work-place  (
     7460                                                     input 'C':U
     7461                                                   ,input 'db':U
     7462                                                   ,input v-cntxt-db-num
     7463                                                   ,input 0
     7464                                                   ,input '':U
     7465                                                   ,input 0  ).
     7466       end.
     7467       run cur-time in this-procedure ( output v-today, output v-time).
     7468       find first buf_cli-list-hist where
     7469                  buf_cli-list-hist.id = p-id .
     7470       for each ub.staff no-lock where
     7471               ub.staff.role =  'S':U
     7472           and ub.staff.role-leve = 'db':U
     7473           and (v-cntxt-db-num = 0 or ub.staff.work-place = v-cashier-role-string)
     7474           and ub.staff.date-end >= v-today,
     7475               first ub.clients no-lock where
     7476                 ub.clients.obj-type = 'чел':U AND
     7477                 ub.clients.obj-code = ub.staff.psn-code:
     7478         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7479       end.
     7480       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7481     end.
     7482     when "firm" then do:
     7483       find first buf_cli-list-hist where
     7484                  buf_cli-list-hist.id = p-id .
     7485       for each ub.clients where ub.clients.obj-type = 'орг':U no-lock:
     7486         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7487       end.
     7488       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7489     end.
     7490     when "person" then do:
     7491       find first buf_cli-list-hist where
     7492                  buf_cli-list-hist.id = p-id .
     7493       for each ub.clients where ub.clients.obj-type = 'чел':U no-lock:
     7494         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7495       end.
     7496       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7497     end.
     7498     when "shop" then do:
     7499       find first buf_cli-list-hist where
     7500                  buf_cli-list-hist.id = p-id .
     7501       for each ub.clients where ub.clients.obj-type = 'маг':U no-lock:
     7502         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7503       end.
     7504       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7505     end.
     7506     when "store" then do:
     7507       find first buf_cli-list-hist where
     7508                  buf_cli-list-hist.id = p-id .
     7509       for each ub.clients where ub.clients.obj-type = 'скл':U no-lock:
     7510         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7511       end.
     7512       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7513     end.
     7514    when "waybill" then do:
     7515      for each buf_cli-list-hist where
     7516               buf_cli-list-hist.id = p-id
     7517         and  buf_cli-list-hist.item_ <> '':U:
     7518         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_cli-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7519         find first ub.trn-doc no-lock where
     7520                   rowid(ub.trn-doc) = v-rowid no-error.
     7521         if available ub.trn-doc then do:
     7522           FIND FIRST ub.clients No-LOCK WHERE
     7523                     ub.clients.obj-type = ub.trn-doc.cli-type AND
     7524                     ub.clients.obj-code = ub.trn-doc.cli-code No-ERROR.
     7525           if avail ub.clients then
     7526           run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7527         end.
     7528         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7529       end.
     7530    end.
     7531    when "attr" or when "attr-val" then do:
     7532       find first buf_cli-list-hist where
     7533                buf_cli-list-hist.id = p-id
     7534            AND buf_cli-list-hist.item_ <> '':U no-error .
     7535       assign
     7536       v-obj-type = entry(1, buf_cli-list-hist.item_, chr(3))
     7537       v-obj-code = integer(entry(2, buf_cli-list-hist.item_, chr(3)))
     7538       v-attr-code = entry(3, buf_cli-list-hist.item_, chr(3))
     7539       vvalue = (if rs-list-method = "attr" then '':U else entry(4, buf_cli-list-hist.item_, chr(3)))
     7540       no-error
     7541       .
     7542       if error-status:error then do:
     7543       end.
     7544       else do:
     7545         for each ub.clients no-lock,
     7546           first ub.clients-attr No-LOCK WHERE
     7547                 ub.clients-attr.obj-type = ub.clients.obj-type AND
     7548                 ub.clients-attr.obj-code = ub.clients.obj-code AND
     7549                ub.clients-attr.attr-code = v-attr-code
     7550           :
     7551           if rs-list-method = "attr-val" then do:
     7552             run clntattr-value in this-procedure (
     7553                               input ub.clients.obj-type
     7554                              ,input ub.clients.obj-code
     7555                              ,input v-attr-code
     7556                              ,output vvalue1
     7557                              ,output vtype1).
     7558             if vvalue1 <> vvalue then NEXT.
     7559           end.
     7560           run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7561         end.
     7562         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7563       end.
     7564     end.
     7565     when "grp-buy"  then do:
     7566       for each buf_cli-list-hist where
     7567                buf_cli-list-hist.id = p-id
     7568           and  buf_cli-list-hist.item_ <> '':U:
     7569         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_cli-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7570         grp-path = "".
     7571         find first ub.buyer-group no-lock where rowid(ub.buyer-group) = v-rowid.
     7572         for each ub.clients no-lock,
     7573             first ub.buyer-in-buyer-group No-LOCK WHERE
     7574                   ub.buyer-in-buyer-group.stts         = 0
     7575               and ub.buyer-in-buyer-group.bbg-obj-type = ub.clients.obj-type
     7576               and ub.buyer-in-buyer-group.bbg-obj-code = ub.clients.obj-code
     7577               and ub.buyer-in-buyer-group.bgr-id       = ub.buyer-group.bgr-id
     7578               and ub.buyer-in-buyer-group.bgr-db-num   = ub.buyer-group.bgr-db-num:
     7579           run ex-CLI in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7580         end.
     7581         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7582       end.
     7583     end.
     7584     when "turnov-buy"  then do:
     7585       find first buf_cli-list-hist where
     7586                  buf_cli-list-hist.id = p-id
     7587           and    buf_cli-list-hist.item_ <> '':U.
     7588       assign
     7589       v-sum-1 = decimal(entry(1, buf_cli-list-hist.item_, chr(3)))
     7590       v-sum-2 = decimal(entry(2, buf_cli-list-hist.item_, chr(3)))
     7591       no-error
     7592       .
     7593       if error-status:error then do:
     7594       end.
     7595       else do:
     7596         run str/two-sum.w (  input  'calc'
     7597                         ,input-output v-sum-1
     7598                         ,input-output v-sum-2
     7599                         ,output table temp-list-buyer
     7600                     ) .
     7601         if not can-find(first temp-list-buyer) then return.
     7602         for each temp-list-buyer,
     7603             first clients no-lock where
     7604                 clients.obj-type = temp-list-buyer.obj-type
     7605             and clients.obj-code = temp-list-buyer.obj-code:
     7606           run ex-CLI in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7607         end.
     7608         empty temp-table temp-list-buyer.
     7609         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7610       end.
     7611     end.
     7612     when "doc-list"
     7613     or
     7614     when "gds-list"
     7615     or
     7616     when "file"
     7617     or
     7618     when "clob-data"
     7619     then do:
     7620       run proc-file-list-methods in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode, input p-id).
     7621     end.
     7622     when "deleted" then do:
     7623       find first buf_cli-list-hist where
     7624                  buf_cli-list-hist.id = p-id .
     7625       for each clients where clients.stts <> 0 no-lock:
     7626         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7627       end.
     7628       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7629     end.
     7630     when "filter" then do:
     7631       define variable v-filter-var as character no-undo .
     7632       find first buf_cli-list-hist where
     7633                buf_cli-list-hist.id = p-id
     7634            AND buf_cli-list-hist.item_ <> '':U .
     7635       run proc-write-filter-expression-var in this-procedure ( input buf_cli-list-hist.item_, output v-filter-var ).
     7636       run gbl/cli-fill.p (
     7637                        input "Формирование списка по фильтру (без учета сортировки)"
     7638                      , input rs-list-method
     7639                      , input rs-status
     7640                      , input line-mode
     7641                      , input v-filter-var
     7642                      , output lns-cnt
     7643                      , output line-rec
     7644                      )  .
     7645        assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7646     end.
     7647     when "all" then do:
     7648       find first buf_cli-list-hist where
     7649                  buf_cli-list-hist.id = p-id .
     7650       for each clients no-lock:
     7651         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7652       end.
     7653       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7654     end.
     7655   END CASE.
     7656   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     7657   if session:set-wait-state( "" )  then .
     7658   case line-mode :
     7659     when 'ДОБАВЛЕНИЕ':U then do:
     7660       tot-lns = tot-lns + lns-cnt.
     7661       if not p-from-macro or p-step then
     7662       message
     7663       "Добавлено строк :" lns-cnt skip(0)
     7664       string(if lns-ignore <> 0
     7665       then ("Проигнорировано строк :" + string(lns-ignore))
     7666       else "":U)
     7667       .
     7668     end.
     7669     when 'удаление':U then do:
     7670       tot-lns = tot-lns - lns-cnt.
     7671       if not p-from-macro or p-step then
     7672       message
     7673       "Удалено строк :" lns-cnt skip(0)
     7674       string(if lns-ignore <> 0
     7675       then ("Проигнорировано строк :" + string(lns-ignore))
     7676       else "":U)
     7677       .
     7678     end.
     7679   end.
     7680   if line-mode <> 'ОСТАВИТЬ':U then
     7681     run Myenable in this-procedure .
     7682   end.
     7683   END PROCEDURE.
     7684   PROCEDURE trig-attr :
     7685   define input parameter rs-list-method as character no-undo .
     7686   define variable ii as integer no-undo.
     7687   define variable glog as logical no-undo .
     7688   DEFINE VARIABLE vattr-codes          as character           no-undo.
     7689   DEFINE VARIABLE vattr-labels         as character           no-undo.
     7690   DEFINE VARIABLE vtooltip             as character           no-undo.
     7691   DEFINE VARIABLE vlabel               as character           no-undo .
     7692   DEFINE VARIABLE vtype                as character           no-undo .
     7693   DEFINE VARIABLE vformat              as character           no-undo .
     7694   DEFINE VARIABLE vuser-can-edit       as logical             no-undo .
     7695   DEFINE VARIABLE voutput-display      as logical             no-undo .
     7696   DEFINE VARIABLE vother               as character           no-undo .
     7697   DEFINE VARIABLE v-ref-list           as character           no-undo .
     7698   DEFINE VARIABLE jj                   as integer             no-undo .
     7699   DEFINE VARIABLE v-spr                as character           no-undo .
     7700   DEFINE VARIABLE v-spr-param          as character           no-undo .
     7701   DEFINE VARIABLE v-setted             as logical             no-undo .
     7702   define variable v-init               as character           no-undo .
     7703   define variable v-item               as character           no-undo .
     7704   DEFINE VARIABLE v-attr-code          as character           no-undo .
     7705   assign
     7706   ref-list = ""
     7707   vattr-codes = ""
     7708   vattr-labels = ""
     7709   vvalue = ""
     7710   .
     7711   DO ii = 1 to num-entries('doc-start,arh-detail,arh-start,ahsp-detail,ahsp-start,aht-detail,aht-start,arh-del,ahsp-del,aht-del,arh-calc,ahsp-calc,aht-calc,arh-recalc,ahsp-recalc,aht-recalc,is-inkassator,shftrep2,db,is-superviser,purch-code,als-gds,alien,envd,kpp,pharm,upd-date-time,holdfirm-code,vat-register,bge-incr-last-shift-date,bge-incr-last-shift-num,bge-sap-sng-last-shift,egrip-date,egrip-num,cli-local,cli-alc-producer,region-code,foreign-producer,main-accholder,not-corr-op,veto-man-doc,requisite-alc-decl,division-code,supp-np,own-supp,supp-lgas,tank-farm-for,NPZ,auto-tank-for,code-KSK,code-AIS,owner-code,cli-for-close-fo,cli-clim-grp,cli-decommissioned,exp-isPM-last-date':U):
     7712       run clntattr-code in this-procedure (
     7713                                            input entry(ii, 'doc-start,arh-detail,arh-start,ahsp-detail,ahsp-start,aht-detail,aht-start,arh-del,ahsp-del,aht-del,arh-calc,ahsp-calc,aht-calc,arh-recalc,ahsp-recalc,aht-recalc,is-inkassator,shftrep2,db,is-superviser,purch-code,als-gds,alien,envd,kpp,pharm,upd-date-time,holdfirm-code,vat-register,bge-incr-last-shift-date,bge-incr-last-shift-num,bge-sap-sng-last-shift,egrip-date,egrip-num,cli-local,cli-alc-producer,region-code,foreign-producer,main-accholder,not-corr-op,veto-man-doc,requisite-alc-decl,division-code,supp-np,own-supp,supp-lgas,tank-farm-for,NPZ,auto-tank-for,code-KSK,code-AIS,owner-code,cli-for-close-fo,cli-clim-grp,cli-decommissioned,exp-isPM-last-date':U)
     7714                                           ,output vtype
     7715                                           ,output vformat
     7716                                           ,output vlabel
     7717                                           ,output vuser-can-edit
     7718                                           ,output voutput-display
     7719                                           ,output vother) no-error.
     7720       if NOT error-status:error anD VOUTPUT-DISPLAY = yes then do:
     7721           assign
     7722           vattr-codes = vattr-codes + chr(4) + entry(ii, 'doc-start,arh-detail,arh-start,ahsp-detail,ahsp-start,aht-detail,aht-start,arh-del,ahsp-del,aht-del,arh-calc,ahsp-calc,aht-calc,arh-recalc,ahsp-recalc,aht-recalc,is-inkassator,shftrep2,db,is-superviser,purch-code,als-gds,alien,envd,kpp,pharm,upd-date-time,holdfirm-code,vat-register,bge-incr-last-shift-date,bge-incr-last-shift-num,bge-sap-sng-last-shift,egrip-date,egrip-num,cli-local,cli-alc-producer,region-code,foreign-producer,main-accholder,not-corr-op,veto-man-doc,requisite-alc-decl,division-code,supp-np,own-supp,supp-lgas,tank-farm-for,NPZ,auto-tank-for,code-KSK,code-AIS,owner-code,cli-for-close-fo,cli-clim-grp,cli-decommissioned,exp-isPM-last-date':U)
     7723           vattr-labels = vattr-labels + chr(4) + vlabel
     7724           .
     7725       end.
     7726   end.
     7727   run gbl/d-list.w (
     7728                      input "b-sel":U
     7729                     ,input "Выберите атрибут"
     7730                     ,input vattr-codes
     7731                     ,input vattr-labels
     7732                     ,input chr(4)
     7733                     ,input "":U
     7734                     ,output v-attr-code).
     7735   if v-attr-code = "" then do:
     7736     return error.
     7737   end.
     7738   glog = yes.
     7739   if rs-list-method = "attr" then do:
     7740       run clntattr-tooltip in this-procedure ( input v-attr-code,
     7741                            output vtooltip,
     7742                            output vlabel).
     7743       message "Все клиенты с установленным атрибутом " + vlabel
     7744               view-as alert-box question buttons OK-Cancel update glog.
     7745       if not glog then do:
     7746         return error.
     7747       end.
     7748       assign
     7749       dsp-rs = substitute("ВСЕ клиенты с установленным атрибутом &1: &2", vlabel, stat-line(rs-status))
     7750       v-item = '':U + chr(3) + '':U + chr(3) + v-attr-code
     7751       .
     7752   end.
     7753   else do:
     7754       run clntattr-code in this-procedure (
     7755                                             input v-attr-code
     7756                                           ,output vtype
     7757                                           ,output vformat
     7758                                           ,output vlabel
     7759                                           ,output vuser-can-edit
     7760                                           ,output voutput-display
     7761                                           ,output vother).
     7762       run gbl/d-prompt.w (
     7763         'title=':u + "Значение атрибута клиента" + '\':u
     7764       + 'text1=':u + vlabel + '\':u
     7765       + 'format=' + (if vtype = 'L':U then "yes/no" else vformat) + '\':u
     7766       + 'type=' + vtype + '\':u
     7767       + 'fillin_row=2\':u
     7768       + 'fillin_col=4\':u
     7769       + 'fillin_width=20\':u
     7770       + 'fillin_height=1\':u
     7771       + 'max-chars=70\':u
     7772       + 'readonly=no\':u
     7773       , input-output vvalue
     7774       ).
     7775       if return-value = 'false':U then do:
     7776         return error.
     7777       end.
     7778       message ("Все клиенты с атрибутом " + vlabel + " = ":U + vvalue)
     7779               view-as alert-box question buttons OK-Cancel update glog.
     7780       if not glog then do:
     7781         return error.
     7782       end.
     7783       assign
     7784       dsp-rs = substitute("Все клиенты с атрибутом &1 =&2 &3", vlabel, vvalue, stat-line(rs-status))
     7785       v-item = '':U + chr(3) + '':U + chr(3) + v-attr-code + chr(3) + vvalue
     7786       .
     7787   end.
     7788   v-no-hist = 0.
     7789   run create-cli-list-hist in this-procedure ( input 'ДОБАВЛЕНИЕ':U
     7790                                       , input-output v-seq
     7791                                       , input 0
     7792                                       , input '':U
     7793                                       , input dsp-rs
     7794                                       , input tot-lns
     7795                                       , input rs-list-method
     7796                                       , input rs-status
     7797                                       , input v-item
     7798                                       , input '':U
     7799                                       , input ?
     7800                                       ).
     7801   END PROCEDURE.
     7802   PROCEDURE trig-filter :
     7803   define variable glog as logical no-undo .
     7804   define variable v-flt-rec as recid no-undo .
     7805   define variable v-filter-name as character no-undo .
     7806   define variable where-phrase as character no-undo .
     7807   define variable sort-phrase as character no-undo .
     7808   define variable where-phrase-rus as character no-undo .
     7809   define variable sort-phrase-rus as character no-undo .
     7810   glog = yes.
     7811   message
     7812   "Все клиенты, выбранные в соответствии с заданным фильтром  (без учета сортировки)."
     7813    view-as alert-box question buttons OK-Cancel update glog.
     7814   if not glog then do:
     7815     return error.
     7816   end.
     7817   assign
     7818   c-point = "cli-list" + chr(4) + "Список клиентов" + chr(4) + "no"
     7819   .
     7820    assign
     7821       tbl = 'clients'
     7822       join-tbl = ''
     7823       fld = ""
     7824       lab = ""
     7825       spr = ""
     7826       dim = '0'
     7827       .
     7828       run fltfield-add in this-procedure('obj-type*obj-code', 'Клиент', 'cli',
     7829                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7830       run fltfield-add in this-procedure('obj-type', 'Тип', '',
     7831                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7832       run fltfield-add in this-procedure('obj-code', 'Код', '',
     7833                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7834       run fltfield-add in this-procedure ('obj-name', 'Название', '',
     7835                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7836       run fltfield-add in this-procedure('stts', 'Статус', '',
     7837                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7838       run fltfield-add in this-procedure('is-prod', 'Производитель', '',
     7839                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7840       run fltfield-add in this-procedure('grp-name', 'Название группы', 'cligrp',
     7841                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7842       run fltfield-add in this-procedure('sup-gds', 'Поставщик товаров', '',
     7843                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7844       run fltfield-add in this-procedure('sup-cons', 'Консигнант', '',
     7845                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7846       run fltfield-add in this-procedure('buy-gds', 'Покупатель товаров', '',
     7847                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7848       run fltfield-add in this-procedure('buy-cons', 'Покупатель консигнационных товаров', '',
     7849                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7850       run fltfield-add in this-procedure('buy-serv', 'Покупатель услуг', '',
     7851                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7852       run fltfield-add in this-procedure('lim-kr', 'Лимит кредита', '',
     7853                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7854       run fltfield-add in this-procedure('PS', 'Примечание', '',
     7855                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7856       run fltfield-add in this-procedure('db-num', 'Номер БД', '',
     7857                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7858   run gbl/filter.w ( input parparentproc
     7859                    , input c-point
     7860                    , input tbl
     7861                    , input join-tbl
     7862                    , input fld
     7863                    , input lab
     7864                    , input spr
     7865                    , input dim).
     7866   run gbl/flt-get.p (
     7867                    input  c-point
     7868                   ,output v-flt-rec
     7869                   ,output v-filter-name
     7870                   ,output where-phrase
     7871                   ,output sort-phrase
     7872                   ,output where-phrase-rus
     7873                   ,output sort-phrase-rus  ).
     7874   if v-flt-rec = ? then do:
     7875     run MyENable in this-procedure .
     7876     return error.
     7877   end.
     7878   else do:
     7879     find ubflt.filter where recid (ubflt.filter) = v-flt-rec no-lock.
     7880     run create-cli-list-hist in this-procedure (
     7881                                           input 'ДОБАВЛЕНИЕ':U
     7882                                         , input-output v-seq
     7883                                         , input 0
     7884                                         , input '':U
     7885                                         , input substitute("Фильтр : &1 &2 &3", ubflt.filter.naim, ubflt.filter.where-ysl-rus, stat-line(rs-status))
     7886                                         , input tot-lns
     7887                                         , input rs-list-method
     7888                                         , input rs-status
     7889                                         , input ubflt.filter.where-ysl
     7890                                         , input '':U
     7891                                         , input ?
     7892                                         ).
     7893   end.
     7894   END PROCEDURE.
     7895   PROCEDURE trig-grp-buy :
     7896   define variable glog as logical no-undo .
     7897   define variable ii as integer no-undo.
     7898   define variable v-ref-list as character no-undo .
     7899   define variable v-recs as integer no-undo.
     7900   define variable v-ref-rec as recid no-undo .
     7901   define variable v-temp-seq as integer no-undo .
     7902   define variable v-line as integer no-undo .
     7903   define variable v-item as character no-undo .
     7904   define variable v-tbl-name as character no-undo .
     7905   define variable v-bh as handle no-undo .
     7906   define variable v-tot-lns as integer no-undo .
     7907   define buffer buf_buyer-group for ub.buyer-group.
     7908   glog = yes.
     7909   message "Все покупатели по группе."
     7910   skip stat-line(rs-status)
     7911   view-as alert-box question buttons OK-Cancel update glog.
     7912   if not glog then do:
     7913     return error.
     7914   end.
     7915   run ref/gr-bupr.w (
     7916        input parparentproc
     7917       ,input "b-sel":U
     7918       ,input-output v-ref-list )
     7919       .
     7920   if v-ref-list = "" then do:
     7921     return error.
     7922   end.
     7923   v-recs = num-entries (v-ref-list) .
     7924   do num-rec = 0 to v-recs:
     7925     if v-recs = 1 then do:
     7926       num-rec = 1 .
     7927     end.
     7928     if num-rec > 0 then do:
     7929       v-ref-rec = integer (entry (num-rec, v-ref-list)).
     7930       find first buf_buyer-group no-lock where recid (buf_buyer-group) = v-ref-rec no-error .
     7931     end.
     7932     if v-recs = 1 then do:
     7933       assign
     7934       v-temp-seq = v-seq
     7935       v-line     = 0
     7936       dsp-rs = substitute("Из группы покупателей :&1 &2", buf_buyer-group.name, stat-line(rs-status))
     7937       v-item     = '':U
     7938       v-tbl-name = 'buyer-group':U
     7939       v-bh       = buffer buf_buyer-group:handle
     7940       v-tot-lns = tot-lns
     7941       .
     7942     end.
     7943     else do:
     7944       if num-rec = 0 then do:
     7945         assign
     7946         v-temp-seq = v-seq
     7947         v-line     = 0
     7948         dsp-rs = substitute("Из групп покупателей : &1", stat-line(rs-status))
     7949         v-item     = '':U
     7950         v-tbl-name = '':U
     7951         v-bh       = ?
     7952         v-tot-lns = tot-lns
     7953         .
     7954       end.
     7955       else do:
     7956         assign
     7957         v-temp-seq = v-seq - 1
     7958         v-line     = num-rec
     7959         dsp-rs = substitute("&1", buf_buyer-group.name)
     7960         v-item     = '':U
     7961         v-tbl-name = 'buyer-group':U
     7962         v-bh       = buffer buf_buyer-group:handle
     7963         v-tot-lns = tot-lns + num-rec
     7964         .
     7965       end.
     7966     end.
     7967     v-no-hist = (if num-rec = 1 then 0 else num-rec).
     7968     run create-cli-list-hist in this-procedure (
     7969                                           input 'ДОБАВЛЕНИЕ':U
     7970                                         , input-output v-temp-seq
     7971                                         , input v-line
     7972                                         , input '':U
     7973                                         , input dsp-rs
     7974                                         , input v-tot-lns
     7975                                         , input rs-list-method
     7976                                         , input rs-status
     7977                                         , input v-item
     7978                                         , input v-tbl-name
     7979                                         , input v-bh
     7980                                         ).
     7981     if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     7982   end.
     7983   END PROCEDURE.
     7984   PROCEDURE trig-turnov-buy :
     7985   define variable glog as logical no-undo .
     7986   define variable ii as integer no-undo.
     7987   define variable v-ref-list as character no-undo .
     7988   define variable v-sum-1 as decimal   no-undo .
     7989   define variable v-sum-2 as decimal   no-undo .
     7990   for each temp-list-buyer :
     7991     delete temp-list-buyer.
     7992   end.
     7993   run str/two-sum.w (  input 'sums'
     7994                   ,input-output v-sum-1
     7995                   ,input-output v-sum-2
     7996                   ,output table temp-list-buyer
     7997                   ) .
     7998   if v-sum-2 = ?  then do:
     7999     return error.
     8000   end.
     8001   glog = yes.
     8002   message
     8003   "Все покупатели c оборотом в интервале " skip
     8004   v-sum-1 " " v-sum-2 skip
     8005   view-as alert-box question buttons OK-Cancel update glog.
     8006   if not glog then do:
     8007     return error.
     8008   end.
     8009   run create-cli-list-hist in this-procedure (
     8010                   input 'ДОБАВЛЕНИЕ':U
     8011                 , input-output v-seq
     8012                 , input 0
     8013                 , input '':U
     8014                 , input substitute ('Все покупатели c оборотом в интервале с &1 по &2: &3'
     8015                                     , v-sum-1
     8016                                     , v-sum-2
     8017                                     , stat-line(rs-status))
     8018                 , input tot-lns
     8019                 , input rs-list-method
     8020                 , input rs-status
     8021                 , input (string(v-sum-1) + chr(3) + string(v-sum-2))
     8022                 , input ""
     8023                 , input ?
     8024                 ).
     8025   END PROCEDURE.
     8026   PROCEDURE write-hist :
     8027   define input parameter p-from-macro as logical no-undo .
     8028   define input parameter rs-list-method as character no-undo .
     8029   define input parameter rs-status as character no-undo .
     8030   define input parameter line-mode as character no-undo .
     8031   define variable v-ii as integer no-undo .
     8032   define variable v-temp-seq as integer no-undo .
     8033   if rs-list-method = "single" then do:
     8034     if v-no-hist < 0 then do:
     8035       run create-cli-list-hist in this-procedure (
     8036                                             input 'ДОБАВЛЕНИЕ':U
     8037                                           , input-output v-seq
     8038                                           , input 0
     8039                                           , input get-hist-mode(line-mode)
     8040                                           , input substitute("КЛИЕНТ &1&2 ", cli-list.obj-type, cli-list.obj-code)
     8041                                           , input tot-lns
     8042                                           , input rs-list-method
     8043                                           , input rs-status
     8044                                           , input ('clients':U + chr(3) + cli-list.obj-type + chr(3) + string(cli-list.obj-code))
     8045                                           , input '':U
     8046                                           , input ?
     8047                                           ).
     8048     end.
     8049     else do:
     8050       v-temp-seq = v-seq - 1.
     8051       do v-ii = 0 to v-no-hist:
     8052         run create-cli-list-hist in this-procedure ( input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8053                                             , input-output v-temp-seq
     8054                                             , input v-ii
     8055                                             , input get-hist-mode(line-mode)
     8056                                             , input substitute("КЛИЕНТ &12", cli-list.obj-type, cli-list.obj-code)
     8057                                             , input tot-lns
     8058                                             , input '':U
     8059                                             , input '':U
     8060                                             , input ('clients':U + chr(3) + cli-list.obj-type + chr(3) + string(cli-list.obj-code))
     8061                                             , input '':U
     8062                                             , input ?
     8063                                             ).
     8064       end.
     8065     end.
     8066   end.
     8067   else do:
     8068     v-temp-seq = v-seq - 1.
     8069     do v-ii = 0 to v-no-hist:
     8070       run create-cli-list-hist in this-procedure (
     8071                                             input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8072                                           , input-output  v-temp-seq
     8073                                           , input v-ii
     8074                                           , input get-hist-mode(line-mode)
     8075                                           , input '':U
     8076                                           , input tot-lns
     8077                                           , input rs-list-method
     8078                                           , input '':U
     8079                                           , input '':U
     8080                                           , input '':U
     8081                                           , input ?
     8082                                           ).
     8083     end.
     8084   end.
     8085   END PROCEDURE.
     8086   FUNCTION is-cashierc RETURNS CHARACTER
     8087   ( input loc-type as character, input loc-code as integer ) :
     8088     if loc-type <> 'чел':U
     8089     then return "".
     8090     return string( gbclcode-is-psn-role ( input 'C':U, input loc-code, input ?)).
     8091   END FUNCTION.
     8092   FUNCTION is-dis-cardc RETURNS CHARACTER
     8093   ( input loc-type as character, input loc-code as integer ) :
     8094     FIND ub.dis-card No-LOCK WHERE
     8095          ub.dis-card.cli-type = loc-type AND
     8096          ub.dis-card.cli-code = loc-code No-ERROR.
     8097     if avail ub.dis-card then return ub.dis-card.d-card.
     8098     else do:
     8099       if AMBIGUOUS dis-card then do:
     8100           return "............":U.
     8101       end.
     8102       else return "".
     8103     end.
     8104   END FUNCTION.
     8105   FUNCTION is-sellerc RETURNS CHARACTER
     8106   ( input loc-type as character, input loc-code as integer ) :
     8107     if loc-type <> 'чел':U
     8108     then return "".
     8109     return string( gbclcode-is-psn-role ( input 'S':U, input loc-code, input ?)).
     8110   END FUNCTION.
     8111   FUNCTION stat-line RETURNS CHARACTER
     8112     ( input p-status-chr as character ) :
     8113   DEFINE VARIABLE var-stat-line as character no-undo .
     8114   CASE p-status-chr:
     8115     when 'все':U then do:
     8116       assign
     8117       var-stat-line = "(текущие и удаленные клиенты)"
     8118       .
     8119     end.
     8120     when 'текущие':U then do:
     8121       assign
     8122       var-stat-line = "(текущие клиенты)"
     8123       .
     8124     end.
     8125     when 'удаленные':U then do:
     8126       assign
     8127       var-stat-line = "(удаленные клиенты)"
     8128       .
     8129     end.
     8130   END CASE.
     8131   return var-stat-line .
     8132   END FUNCTION.
