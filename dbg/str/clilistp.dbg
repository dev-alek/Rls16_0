     5743       )  .
     5744   end.
     5745   define variable vss-include-info42 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5746   do:
     5747     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5748       (input  v-cntxt-db-num
     5749       ,input  v-cntxt-userid
     5750       ,input  0
     5751       ,input  'actn_documents_company':U
     5752       ,input  'firm':U
     5753       ,input  v-cntxt-host-code-obj
     5754       ,input  '':U
     5755       ,input  0
     5756       ,input  0
     5757       ,input  0
