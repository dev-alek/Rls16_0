     5840     run clobbnds_add in p-parent-handle
     5841                     ( input this-procedure:handle
     5842                      ,input 'list':U
     5843                      ,input "cli-list"
     5844                      ).
     5845   end.
     5846   if lookup("clobbnds_chg", bttns) > 0 then do:
     5847     run clobbnds_chg in p-parent-handle
     5848                     ( input this-procedure:handle
     5849                      ).
