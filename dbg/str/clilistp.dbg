     1617   procedure create_obj-list :
     1618      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1619      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1620      do
     1621      on error undo, return error return-value
     1622      :
     1623         define buffer cli-obj for ub.clients .
     1624         define variable p-var as integer no-undo .
     1625         define buffer buf_obj-list for obj-list .
     1626         find last buf_obj-list  use-index pi no-error .
     1627         if available buf_obj-list
     1628         then
     1629            p-var = buf_obj-list.obj-id + 1.
     1630         else
     1631            p-var = 1.
     1632         find first cli-obj where
     1633                   cli-obj.obj-type = p-obj-type
     1634               and cli-obj.obj-code = p-obj-code
     1635         no-lock no-error.
     1636         if available cli-obj
     1637         then do:
     1638            create buf_obj-list.
     1639            assign
     1640               buf_obj-list.obj-id   = p-var
     1641               buf_obj-list.obj-code = cli-obj.obj-code
     1642               buf_obj-list.obj-type = cli-obj.obj-type
     1643               buf_obj-list.obj-name = cli-obj.obj-name
     1644               buf_obj-list.db-num   = cli-obj.db-num
     1645            .
     1646         end.
     1647      end.
     1648   end.
