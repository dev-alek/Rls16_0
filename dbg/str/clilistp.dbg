     5039   PROCEDURE get-operation :
     5040   define input parameter p-message as character no-undo .
     5041   define output parameter p-operation as integer no-undo .
     5042     do
     5043     on error undo, return error
     5044     :
     5045       run gbl/d-askw.w (
     5046                     input "Выбор операции над заданным списком"
     5047                    ,input (p-message + chr(10) +
     5048                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     5049                    ,input "|"
     5050                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     5051                            "Удалить" + "|" +
     5052                            "Оставить" + "|" +
     5053                            "Отказ")
     5054                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     5055                           "Удалить полученный список из уже имеющегося" + "|" +
     5056                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     5057                           "Ничего не делать")
     5058                    ,input  (if p-keep-query then 2 else 1)
     5059                    ,input  4
     5060                    ,output p-operation).
     5061      if p-operation = 4 then do:
     5062         return error .
     5063      end.
     5064     end.
     5065   END PROCEDURE.
     5066   PROCEDURE proc-fill-temp-list :
     5067     define variable v-index               as integer   no-undo .
     5068     define variable v-num-entries-options as integer   no-undo .
     5069     do
     5070     on error undo, return error
     5071     :
     5072       assign
     5073         v-num-entries-options = num-entries("Текущая строка,single,                              Клиент,cli,                                          Группа клиентов,cli-grp,                             Группа покупателей,grp-buy,                          Оборот покупателя с - по,turnov-buy,                 Все производители,prod,                              Все поставщики товаров,sup-gds,                      Все консигнанты,sup-cons,                            Все покупатели товаров,buy-gds,                      Все покупатели конс. товаров,buy-cons,               Все покупатели услуг,buy-serv,                       Все влад-цы диск.карт,dis-card,                      Все кассиры,cashiers,                                Все продавцы,sellers,                                Все  организации,firm,                               Все физ.лица,person,                                 Все магазины,shop,                                   Все склады,store,                                    Контрагенты по док-там,waybill,                      С установл. атрибутом,attr,                          С атрибутом = ,attr-val,                             Произ-ли товаров списка,gds-list,                    Контрагенты док-тов списка,doc-list,                 Удаленные,deleted,                                   Файл,file,                                           Хранимый в БД список,clob-data,                        Фильтр,filter,                                       Все клиенты,all")
     5074       .
     5075       do v-index = 1 to v-num-entries-options by 2
     5076       :
     5077         create temp-list.
     5078         assign
     5079           temp-list.fname  = trim(entry(v-index
     5080                                        ,"Текущая строка,single,                              Клиент,cli,                                          Группа клиентов,cli-grp,                             Группа покупателей,grp-buy,                          Оборот покупателя с - по,turnov-buy,                 Все производители,prod,                              Все поставщики товаров,sup-gds,                      Все консигнанты,sup-cons,                            Все покупатели товаров,buy-gds,                      Все покупатели конс. товаров,buy-cons,               Все покупатели услуг,buy-serv,                       Все влад-цы диск.карт,dis-card,                      Все кассиры,cashiers,                                Все продавцы,sellers,                                Все  организации,firm,                               Все физ.лица,person,                                 Все магазины,shop,                                   Все склады,store,                                    Контрагенты по док-там,waybill,                      С установл. атрибутом,attr,                          С атрибутом = ,attr-val,                             Произ-ли товаров списка,gds-list,                    Контрагенты док-тов списка,doc-list,                 Удаленные,deleted,                                   Файл,file,                                           Хранимый в БД список,clob-data,                        Фильтр,filter,                                       Все клиенты,all"
     5081                                        )
     5082                                  ,chr(32)
     5083                                  )
     5084           temp-list.fvalue = trim(entry(v-index + 1
     5085                                        ,"Текущая строка,single,                              Клиент,cli,                                          Группа клиентов,cli-grp,                             Группа покупателей,grp-buy,                          Оборот покупателя с - по,turnov-buy,                 Все производители,prod,                              Все поставщики товаров,sup-gds,                      Все консигнанты,sup-cons,                            Все покупатели товаров,buy-gds,                      Все покупатели конс. товаров,buy-cons,               Все покупатели услуг,buy-serv,                       Все влад-цы диск.карт,dis-card,                      Все кассиры,cashiers,                                Все продавцы,sellers,                                Все  организации,firm,                               Все физ.лица,person,                                 Все магазины,shop,                                   Все склады,store,                                    Контрагенты по док-там,waybill,                      С установл. атрибутом,attr,                          С атрибутом = ,attr-val,                             Произ-ли товаров списка,gds-list,                    Контрагенты док-тов списка,doc-list,                 Удаленные,deleted,                                   Файл,file,                                           Хранимый в БД список,clob-data,                        Фильтр,filter,                                       Все клиенты,all"
     5086                                        )
     5087                                  ,chr(32)
     5088                                  )
     5089           temp-list.id     = v-index
     5090         .
     5091       end.
     5092     end.
     5093   END PROCEDURE.
     5094   procedure proc-b-macro :
     5095   define input parameter p-option as character no-undo .
     5096   define variable glog as logical no-undo .
     5097   define variable v-id as integer no-undo .
     5098   define variable v-result as character no-undo .
     5099   define variable v-des as character no-undo .
     5100   define variable v-hist-mode as character no-undo .
     5101   define variable v-file as logical no-undo .
     5102   define variable v-full-path        as character no-undo .
     5103   define variable v-path             as character no-undo .
     5104   define variable v-file-name        as character no-undo .
     5105   define variable v-file-name-no-ext as character no-undo .
     5106   define variable v-file-name-ext    as character no-undo .
     5107   define variable v-rid-list as character no-undo .
     5108   define variable v-ok as logical no-undo .
     5109   define buffer buf_cli-list-hist for cli-list-hist.
     5110   define buffer buf_clob-bind for ub.clob-bind.
     5111   define buffer buf_clob-data for ub.clob-data.
     5112   do
     5113   on error undo, return error
     5114   :
     5115     if v-macro-is-running then do:
     5116     end.
     5117     else do:
     5118       glog = yes.
     5119       if an-listp-start-macro-id >= 1 then do:
     5120         case p-option:
     5121           when "file" then do:
     5122         message
     5123         "Согласно командам формирования списка из записанного макроса"
     5124         view-as alert-box question buttons OK-Cancel update glog.
     5125           end.
     5126           when "lob" then do:
     5127             message
     5128             "Нелья!"
     5129             view-as alert-box question buttons OK-Cancel update glog.
     5130             run MyEnable in this-procedure .
     5131             return error.
     5132           end.
     5133         end case.
     5134         if not glog then do:
     5135           run MyEnable in this-procedure .
     5136           return error.
     5137         end.
     5138         if an-listp-end-macro-id = ? then do:
     5139           assign
     5140           an-listp-end-macro-id  = v-seq.
     5141           for each macro-list-hist:
     5142             delete macro-list-hist.
     5143           end.
     5144           for each buf_cli-list-hist where
     5145                   buf_cli-list-hist.id >=  an-listp-start-macro-id
     5146             and  buf_cli-list-hist.id <=  an-listp-end-macro-id:
     5147             create macro-list-hist.
     5148             buffer-copy buf_cli-list-hist
     5149             except id num-recs num-add num-ignored
     5150             to macro-list-hist
     5151             assign
     5152             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5153             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5154             macro-list-hist.done = no
     5155             .
     5156           end.
     5157         end.
     5158         else do:
     5159           find last macro-list-hist no-error.
     5160           if available macro-list-hist then do:
     5161             v-id = macro-list-hist.id.
     5162           end.
     5163         end.
     5164       end.
     5165       else do:
     5166         case p-option:
     5167           when "file" then do:
     5168         message
     5169         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     5170         view-as alert-box question buttons OK-Cancel update glog.
     5171         if not glog then do:
     5172           run MyEnable in this-procedure .
     5173           return error.
     5174         end.
     5175         system-dialog get-file f-name
     5176           filters "Макрос формирования списка *.clm" "*.clm"
     5177           title "Выберите файл макроса"
     5178           INITIAL-DIR "."
     5179           return-to-start-dir
     5180           must-exist
     5181           update glog
     5182           default-extension "clm".
     5183         if not glog then do:
     5184           run MyEnable in this-procedure .
     5185           return error.
     5186         end.
     5187           end.
     5188           when "lob" then do:
     5189             message
     5190             "Согласно командам формирования списка из макроса, сохраненного в БД"
     5191             view-as alert-box question buttons OK-Cancel update glog.
     5192             if not glog then do:
     5193               run MyEnable in this-procedure .
     5194               return error.
     5195             end.
     5196             run ref/clobbnds.w ( input parparentproc
     5197                                 ,input this-procedure:handle
     5198                                 ,input 'b-sel'
     5199                                 ,input "uniq-key-rec"
     5200                                 ,input ""
     5201                                 ,input 'list-macro':U
     5202                                 ,input 'cli-list'
     5203                                 ,input -1
     5204                                 ,input-output v-rid-list) no-error.
     5205             if v-rid-list = '' then do:
     5206               run MyEnable in this-procedure.
     5207               return error.
     5208             end.
     5209             find first buf_clob-bind no-lock where
     5210                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     5211             if not available buf_clob-bind then do:
     5212               message
     5213               "Не найдена ссылка на макрос, сохраненный в БД!"
     5214               view-as alert-box error .
     5215               run MyEnable in this-procedure .
     5216               return error.
     5217             end.
     5218             find first buf_clob-data no-lock where
     5219                       buf_clob-data.db-num = buf_clob-bind.db-num
     5220                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     5221             if not available buf_clob-data then do:
     5222               message
     5223               "Не найдена ссылка на макрос, сохраненный в БД!"
     5224               view-as alert-box error .
     5225               run MyEnable in this-procedure .
     5226               return error.
     5227             end.
     5228             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     5229               message
     5230               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     5231                         , buf_clob-data.db-num
     5232                         , chr(10))
     5233              view-as alert-box question buttons yes-no update v-ok.
     5234              if not v-ok then do:
     5235                 run MyEnable in this-procedure .
     5236                 return error.
     5237              end.
     5238             end.
     5239             run gbl/_tmpfile.p ( input ""
     5240                           ,input "tmp"
     5241                           ,output v-file-name) .
     5242             copy-lob from object buf_clob-data.cdata
     5243             to file f-name.
     5244             run gbl/filename.p
     5245               (input  v-file-name
     5246               ,output f-name
     5247               ,output v-path
     5248               ,output v-file-name
     5249               ,output v-file-name-no-ext
     5250               ,output v-file-name-ext
     5251               ) no-error .
     5252             if error-status:error then do:
     5253             end.
     5254           end.
     5255         end case.
     5256         for each macro-list-hist:
     5257           delete macro-list-hist.
     5258         end.
     5259         input stream sout from value (f-name).
     5260         _macro:
     5261         repeat:
     5262           create macro-list-hist.
     5263           import stream sout macro-list-hist no-error.
     5264           if error-status:error then do:
     5265               undo _macro, next _macro.
     5266           end.
     5267           assign
     5268           macro-list-hist.num-rec = 0
     5269           macro-list-hist.num-add = 0
     5270           macro-list-hist.num-ignored = 0
     5271           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5272           macro-list-hist.done = no
     5273           .
     5274         end.
     5275         find first macro-list-hist where
     5276                 macro-list-hist.id = 0.
     5277         delete macro-list-hist.
     5278         input stream sout close.
     5279         If p-option = "lob" then do:
     5280          os-delete value(f-name).
     5281         end.
     5282         v-file = yes.
     5283       end.
     5284       an-listp-macros-label-id = v-seq.
     5285       run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5286                                           , input-output v-seq
     5287                                           , input 0
     5288                                           , input '>':U
     5289                                           , input (if v-file
     5290                                                   then substitute("Файл макроса : &1", f-name)
     5291                                                   else substitute("Записанный макрос")
     5292                                                   )
     5293                                           , input tot-lns
     5294                                           , input 'macro':U
     5295                                           , input '':U
     5296                                           , input (if v-file then f-name else '':U)
     5297                                           , input '':U
     5298                                           , input ?
     5299                                           ).
     5300     end.
     5301     disable
     5302     b-record
     5303     b-macro
     5304     with frame Dialog-Frame .
     5305     hide
     5306     b-record in frame Dialog-Frame .
     5307     enable
     5308     b-clear-macro with frame Dialog-Frame .
     5309     v-macro-is-running = yes.
     5310     run str/listmcro.w (input parparentproc
     5311                   ,input this-procedure:handle
     5312                  ,input "Макрос формирования списка клиентов" + chr(4) + "clm"
     5313                   ,input "b-play,b-step"
     5314                   ,input-output v-current-step
     5315                   ,input v-id
     5316                   ,output v-result) no-error .
     5317     if error-status:error
     5318     or v-result = "b-stop"
     5319     or v-result = 'end':U
     5320     then do:
     5321       for each macro-list-hist:
     5322         delete macro-list-hist.
     5323       end.
     5324       assign
     5325       an-listp-start-macro-id = ?
     5326       an-listp-end-macro-id = ?
     5327       an-listp-macros-label-id = 0
     5328       .
     5329       menu-item m-macro-file:label in menu m-play = "Сохраненный в файле макрос формирования списка товаров".
     5330       menu-item m-macro-lob:sensitive in menu m-play = yes.
     5331       if v-result = 'b-stop' then do:
     5332         assign
     5333         v-hist-mode = '[]':U
     5334         v-des = "Выполнение макроса прекращено пользователем"
     5335         .
     5336         hide
     5337         b-clear-macro
     5338         b-stop
     5339         in frame Dialog-Frame .
     5340         enable
     5341         b-record
     5342         with frame Dialog-Frame .
     5343       end.
     5344       if v-result = 'end' then do:
     5345         assign
     5346         v-hist-mode = '<':U
     5347         v-des = "Выполнение макроса завершено"
     5348         .
     5349         hide
     5350         b-clear-macro
     5351         b-stop
     5352         in frame Dialog-Frame .
     5353         enable
     5354         b-record
     5355         with frame Dialog-Frame .
     5356       end.
     5357       if error-status:error then do:
     5358         assign
     5359         v-hist-mode = 'E':U
     5360         v-des = "Выполнение макроса прекращено из-за ошибки"
     5361         .
     5362       end.
     5363       run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5364                                           , input-output v-seq
     5365                                           , input 0
     5366                                           , input v-hist-mode
     5367                                           , input v-des
     5368                                           , input tot-lns
     5369                                           , input 'macro':U
     5370                                           , input '':U
     5371                                           , input f-name
     5372                                           , input '':U
     5373                                           , input ?
     5374                                           ) no-error .
     5375       assign
     5376       v-macro-is-running = no
     5377       v-current-step = 0
     5378       .
     5379     end.
     5380     enable
     5381     b-macro
     5382     with frame Dialog-Frame .
     5383   end.
     5384   end procedure.
     5385   procedure proc-create-macro-list-hist :
     5386   define input parameter p-list-table as character no-undo .
     5387   define input parameter p-id as integer           no-undo .
     5388   define input parameter p-line as integer         no-undo .
     5389   define input parameter p-hist-mode as character  no-undo .
     5390   define input parameter p-des as character        no-undo .
     5391   define input parameter p-option_ as character    no-undo .
     5392   define input parameter p-item_ as character      no-undo .
     5393   define input parameter p-status_ as character    no-undo .
     5394   define buffer buf_macro-list-hist for macro-list-hist.
     5395   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5396     do
     5397     on error undo, return error return-value
     5398     :
     5399       create buf_macro-list-hist.
     5400       assign
     5401       buf_macro-list-hist.list-table = p-list-table
     5402       buf_macro-list-hist.id         = p-id
     5403       buf_macro-list-hist.line       = p-line
     5404       buf_macro-list-hist.hist-mode  = p-hist-mode
     5405       buf_macro-list-hist.des        = p-des
     5406       buf_macro-list-hist.option_    = p-option_
     5407       buf_macro-list-hist.item_      = p-item_
     5408       buf_macro-list-hist.status_    = p-status_
     5409       .
     5410       if p-keep-query then do:
     5411         create buf_keep-macro-list-hist.
     5412         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     5413       end.
     5414     end.
     5415   end procedure.
     5416   procedure proc-macro-play :
     5417   define input parameter p-id as integer no-undo .
     5418   define input parameter p-step as logical no-undo .
     5419   define input parameter p-max-id as integer no-undo .
     5420   define variable v-id as integer no-undo .
     5421   define variable v-rowid   as rowid no-undo .
     5422   define variable v-tbl-name as character no-undo .
     5423   define variable v-old-seq as integer no-undo .
     5424   define variable v-current-id as integer no-undo .
     5425   define variable v-temp-seq as integer no-undo .
     5426   define variable v-rs-do-error as logical no-undo .
     5427   define  buffer buf_macro-list-hist for macro-list-hist.
     5428   define  buffer buf_cli-list-hist for cli-list-hist.
     5429   do
     5430   on error undo, return error return-value
     5431   :
     5432     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     5433       assign
     5434       v-current-id = v-current-id + 1
     5435       v-id = macro-list-hist.id.
     5436       CASE entry(1, macro-list-hist.option_, chr(4)):
     5437         when 'macro':U
     5438         or
     5439         when 'title':U
     5440         or
     5441         when 'start':U
     5442         then do:
     5443         end.
     5444         when 'clear':U then do:
     5445           for each cli-list:
     5446             delete cli-list.
     5447           end.
     5448           for each cli-list-hist where cli-list-hist.id > an-listp-macros-label-id:
     5449             delete cli-list-hist.
     5450           end.
     5451           tot-lns = 0.
     5452           v-seq = an-listp-macros-label-id + 1.
     5453           v-no-hist = 0.
     5454           create buf_cli-list-hist.
     5455           buffer-copy macro-list-hist
     5456           to buf_cli-list-hist
     5457           assign buf_cli-list-hist.id = v-seq
     5458           v-temp-seq = v-seq
     5459           v-seq = v-seq + 1
     5460           v-no-hist = v-no-hist + 1
     5461           .
     5462           run MyEnable in this-procedure .
     5463         end.
     5464         when 'single' then do:
     5465            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     5466                                                 ,input ?
     5467                                                 ,input 'ub'
     5468                                                 ,input ?
     5469                                                 ,input no-lock
     5470                                                 ,output v-rowid
     5471                                                 ,output v-tbl-name) no-error .
     5472           if not error-status:error then do:
     5473             CASE macro-list-hist.hist-mode:
     5474               when '+':U then do:
     5475                 run proc-b-add in this-procedure(input yes
     5476                                                 ,input v-rowid
     5477                                                 ,input macro-list-hist.option_
     5478                                                 ,input macro-list-hist.status_) no-error .
     5479               end.
     5480               when '-':U then do:
     5481                 run proc-b-del in this-procedure(input yes
     5482                                                 ,input v-rowid
     5483                                                 ,input macro-list-hist.option_
     5484                                                 ,input macro-list-hist.status_) no-error .
     5485               end.
     5486               when '*':U then do:
     5487                 run proc-b-rest in this-procedure(input yes
     5488                                                  ,input v-rowid
     5489                                                  ,input macro-list-hist.option_
     5490                                                  ,input macro-list-hist.status_) no-error .
     5491               end.
     5492             END.
     5493             if error-status:error then do:
     5494                 return ("error" + chr(4) + return-value) .
     5495             end.
     5496             find first  buf_cli-list-hist where
     5497                     buf_cli-list-hist.id = v-seq - 1 no-error .
     5498             if available buf_cli-list-hist then
     5499             assign
     5500             macro-list-hist.num-recs = buf_cli-list-hist.num-recs
     5501             macro-list-hist.num-add = buf_cli-list-hist.num-add
     5502             macro-list-hist.num-ignored = buf_cli-list-hist.num-ignored
     5503             .
     5504           end.
     5505           else do:
     5506             return ("error" + chr(4) + return-value).
     5507           end.
     5508         end.
     5509         otherwise do:
     5510           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     5511           or lookup(macro-list-hist.option_, '':U) > 0
     5512           then do:
     5513             if macro-list-hist.line = 0 then do:
     5514               v-no-hist = 0.
     5515               for each buf_macro-list-hist where
     5516                       buf_macro-list-hist.id = v-id:
     5517                 create buf_cli-list-hist.
     5518                 buffer-copy buf_macro-list-hist
     5519                 except id  num-recs num-add num-ignored done
     5520                 to buf_cli-list-hist
     5521                 assign
     5522                 buf_cli-list-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     5523                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     5524                 v-seq = (if buf_macro-list-hist.line = 0
     5525                         then (v-seq + 1)
     5526                         else v-seq)
     5527                 v-no-hist = v-no-hist + 1
     5528                 .
     5529               end.
     5530               if v-no-hist = 1 then v-no-hist = 0.
     5531               run rs-do in this-procedure (input yes
     5532                                         , input p-step
     5533                                         , input macro-list-hist.option_
     5534                                         , input macro-list-hist.status_
     5535                                         , input get-line-mode(macro-list-hist.hist-mode)
     5536                                         , input v-temp-seq
     5537                                         ) no-error .
     5538               if error-status:error then do:
     5539                 assign
     5540                 v-rs-do-error = yes.
     5541               end.
     5542               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     5543                 run proc-b-rest-2 in this-procedure .
     5544                 run MyEnable in this-procedure .
     5545               end.
     5546               for each buf_cli-list-hist where
     5547                       buf_cli-list-hist.id = v-temp-seq,
     5548                  first buf_macro-list-hist where
     5549                       buf_macro-list-hist.id = v-id
     5550                   AND buf_macro-list-hist.line = buf_cli-list-hist.line:
     5551                  assign
     5552                  buf_macro-list-hist.num-recs = buf_cli-list-hist.num-recs
     5553                  buf_macro-list-hist.num-add = buf_cli-list-hist.num-add
     5554                  buf_macro-list-hist.num-ignored = buf_cli-list-hist.num-ignored
     5555                  .
     5556               end.
     5557               if v-rs-do-error then do:
     5558                 run MyEnable in this-procedure .
     5559                 return ("error" + chr(4) + return-value).
     5560               end.
     5561               v-id = macro-list-hist.id.
     5562             end.
     5563           end.
     5564         end.
     5565       END CASE.
     5566     end.
     5567   end.
     5568   end procedure.
     5569   procedure proc-b-rest-2 :
     5570     do
     5571     on error undo, return error
     5572     :
     5573       for each cli-list:
     5574         if cli-list.to-del = ? then do:
     5575           assign
     5576           cli-list.to-del = no
     5577           .
     5578         end.
     5579         else do:
     5580           delete cli-list.
     5581         end.
     5582       end.
     5583       tot-lns = lns-cnt.
     5584     end.
     5585   end procedure.
     5586   PROCEDURE proc-expand :
     5587   define input parameter p-shift as integer no-undo .
     5588   define input parameter p-from as integer no-undo .
     5589   define input parameter p-to as integer no-undo .
     5590   define input parameter p-forcer-name as character no-undo .
     5591   define variable fh as widget-handle no-undo .
     5592   define variable hh as widget-handle no-undo .
     5593   define variable lh as widget-handle no-undo .
     5594   define variable ii as INTEGER no-undo .
     5595   ASSIGN
     5596   fh = frame Dialog-Frame:first-child
     5597   hh = fh:first-child
     5598   .
     5599   CASE v-expand:
     5600     WHEN YES THEN DO:
     5601       ASSIGN
     5602       v-expand = NO.
     5603       DO ii = 1 TO NUM-ENTRIES(v-downed):
     5604         ASSIGN
     5605         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     5606         hh:ROW          = (hh:ROW - p-shift).
     5607         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     5608       END.
     5609     END.
     5610     WHEN NO THEN DO:
     5611       v-expand = YES.
     5612       v-downed = ''.
     5613       _do:
     5614       do while valid-handle(hh):
     5615         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     5616          AND hh:ROW >= p-from
     5617          AND hh:ROW <= p-to
     5618          and lookup(hh:name, p-forcer-name) = 0
     5619          THEN DO:
     5620           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     5621           hh:ROW          = (hh:ROW + p-shift).
     5622           ASSIGN
     5623           v-downed = v-downed + chr(44) + STRING(hh).
     5624           IF hh:TYPE = "fill-in"
     5625           AND valid-handle(hh:side-label-handle) THEN dO:
     5626             assign
     5627             lh = hh:SIDE-LABEL-HANDLE
     5628             lh:ROW = lh:ROW + p-shift
     5629             v-downed = v-downed + chr(44) + STRING(lh)
     5630             .
     5631            END.
     5632          END.
     5633          hh = hh:next-sibling.
     5634       END.
     5635       v-downed = trim(v-downed, chr(44)).
     5636     END.
     5637   END CASE.
     5638   END PROCEDURE.
     5639   if lookup(bttns, "hide") = 0 then do:
     5640   run diasize_add_browse in this-procedure
     5641     (input  'height':u
     5642     ,input  browse BR-option :handle
     5643     ) .
     5644   run diasize_init in this-procedure .
     5645   end.
