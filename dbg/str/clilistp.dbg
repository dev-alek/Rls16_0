     2057   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2058   procedure cli-grplib-get-full-name :
     2059      define input parameter  p-node-code  as integer      no-undo.
     2060      define output parameter p-full-name as character    no-undo.
     2061   do
     2062   on error undo, return error
     2063   :
     2064       define variable v-upper-code    as integer           no-undo.
     2065       define buffer buf_cli-grp       for ub.cli-grp.
     2066       define buffer buf_upper_cli-grp for ub.cli-grp.
     2067       find first buf_cli-grp no-lock
     2068            where buf_cli-grp.node-code = p-node-code
     2069       no-error.
     2070       if not available buf_cli-grp
     2071       then do:
     2072           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     2073       end.
     2074       assign
     2075           p-full-name  = ""
     2076           v-upper-code = 1
     2077       .
     2078       do while buf_cli-grp.upper-code <> 0
     2079       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2080       :
     2081           assign
     2082               p-full-name  = buf_cli-grp.node-name
     2083                            + (if p-full-name <> "" then chr(47) else "")
     2084                            + p-full-name
     2085               v-upper-code = buf_cli-grp.upper-code
     2086           .
     2087           find first buf_cli-grp no-lock
     2088                where buf_cli-grp.node-code = v-upper-code
     2089           no-error.
     2090           if not available buf_cli-grp
     2091           then do:
     2092               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     2093                                   + string( v-upper-code )
     2094                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2095           end.
     2096       end.
     2097       assign
     2098       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2099       .
     2100   end.
     2101   end .
     2102   procedure cgrplib-get-node-from-full-name :
     2103   define input parameter p-full-name as character no-undo .
     2104   define output parameter p-node-code as integer no-undo .
     2105   define variable v-ii as integer no-undo .
     2106   define variable v-upper-code as integer no-undo .
     2107   define variable v-root-code as integer no-undo .
     2108   define variable v-entry as character no-undo .
     2109   define buffer buf_cli-grp       for ub.cli-grp.
     2110   do
     2111   on error undo, return error
     2112   :
     2113     find first buf_cli-grp no-lock
     2114         where buf_cli-grp.upper-code = 0
     2115     no-error .
     2116     if not available buf_cli-grp
     2117     then do:
     2118         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     2119     end.
     2120     else do:
     2121       assign
     2122       v-root-code = buf_cli-grp.node-code
     2123       .
     2124     end.
     2125     v-upper-code = v-root-code.
     2126     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2127       assign
     2128       v-entry = entry(v-ii, p-full-name, chr(47)).
     2129       if v-entry = '' then leave.
     2130       find first buf_cli-grp no-lock where
     2131                 buf_cli-grp.node-name = v-entry
     2132             and buf_cli-grp.upper-code = v-upper-code
     2133             no-error.
     2134       if not available buf_cli-grp then do:
     2135         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2136       end.
     2137       else do:
     2138         p-node-code = buf_cli-grp.node-code.
     2139         v-upper-code = buf_cli-grp.node-code.
     2140       end.
     2141     end.
     2142   end.
     2143   end .
     2144   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2145   procedure cur-time :
     2146      define output parameter p-today as date      no-undo .
     2147      define output parameter p-time  as integer   no-undo .
     2148     do
     2149     on error undo, return error
     2150     :
     2151       define variable v-date1 as date      no-undo .
     2152       define variable v-date2 as date      no-undo .
     2153       define variable v-time  as integer   no-undo .
     2154       assign
     2155         v-date1 = today
     2156         v-time  = time
     2157         v-date2 = today
     2158       .
     2159       if v-date1 <> v-date2
     2160       then do:
     2161         assign
     2162           v-date1 = today
     2163           v-time  = v-time
     2164         .
     2165       end.
     2166       assign
     2167         p-today = v-date1
     2168         p-time  = v-time
     2169       .
     2170     end.
     2171   end.
     2172   function cur-time-date returns character
     2173   :
     2174     return string(today, '99/99/9999':U) .
     2175   end.
     2176   function cur-time-mjd returns decimal
     2177   :
     2178     define variable v-date as date      no-undo .
     2179     define variable v-time as integer   no-undo .
     2180     run cur-time in this-procedure
     2181       (output v-date
     2182       ,output v-time
     2183       ) .
     2184     return integer(v-date) - 2400002 + (v-time / 86400) .
     2185   end.
     2186   function cur-time-get-ending-index returns integer
     2187   (input p-number as integer
     2188   )
     2189   :
     2190     if p-number < 0
     2191     or p-number = ?
     2192     then do:
     2193       return 1 .
     2194     end.
     2195     define variable v-rest as integer   no-undo .
     2196     assign
     2197       p-number = p-number modulo 100
     2198     .
     2199     if p-number < 20
     2200     then do:
     2201       assign
     2202         v-rest = p-number
     2203       .
     2204     end.
     2205     else do:
     2206       assign
     2207         v-rest = p-number modulo 10
     2208       .
     2209     end.
     2210     case v-rest :
     2211       when 1
     2212       then do:
     2213         return 2 .
     2214       end.
     2215       when 2 or
     2216       when 3 or
     2217       when 4
     2218       then do:
     2219         return 3 .
     2220       end.
     2221       otherwise do:
     2222         return 1 .
     2223       end.
     2224     end case .
     2225   end.
     2226   procedure cur-time-mjd-to-date :
     2227      define input  parameter i-mjd-diff as decimal no-undo.
     2228      define output parameter o-Date     as date    no-undo.
     2229      define output parameter o-Time     as integer no-undo.
     2230      define variable v-day-number as integer   no-undo .
     2231      if    i-mjd-diff < 0
     2232         or i-mjd-diff = ?
     2233      then do:
     2234         return "?" .
     2235      end.
     2236      assign
     2237         v-day-number = truncate(i-mjd-diff,0).
     2238         o-Date = date(v-day-number + 2400002).
     2239         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2240     .
     2241   end.
     2242   function cur-time-mjd-to-string returns character
     2243   (input p-mjd-diff as decimal
     2244   )
     2245   :
     2246     define variable v-day-number as integer   no-undo .
     2247     define variable v-seconds    as integer   no-undo .
     2248     define variable v-hour       as integer   no-undo .
     2249     define variable v-min        as integer   no-undo .
     2250     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2251     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2252     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2253     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2254     if p-mjd-diff < 0
     2255     or p-mjd-diff = ?
     2256     then do:
     2257       return "?" .
     2258     end.
     2259     assign
     2260       v-day-number = integer(truncate(p-mjd-diff,0))
     2261       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2262     .
     2263     if v-seconds > 86400
     2264     then do:
     2265       assign
     2266         v-seconds = 86400 - 1
     2267       .
     2268     end.
     2269     if v-seconds < 0
     2270     then do:
     2271       assign
     2272         v-seconds = 0
     2273       .
     2274     end.
     2275     assign
     2276       v-hour = truncate(v-seconds / 3600, 0)
     2277     .
     2278     assign
     2279       v-seconds = v-seconds modulo 3600
     2280     .
     2281     assign
     2282       v-min = truncate(v-seconds / 60, 0)
     2283     .
     2284     assign
     2285       v-seconds = v-seconds modulo 60
     2286     .
     2287     return
     2288         (if v-day-number <> 0
     2289           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2290           else ""
     2291         )
     2292       + (if v-day-number <> 0 or v-hour <> 0
     2293           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2294           else ""
     2295         )
     2296       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2297           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2298           else ""
     2299         )
     2300       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2301       .
     2302   end.
     2303   function cur-time-string returns character
     2304   :
     2305     define variable v-date as date      no-undo .
     2306     define variable v-time as integer   no-undo .
     2307     run cur-time in this-procedure
     2308       (output v-date
     2309       ,output v-time
     2310       ) .
     2311     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2312   end.
     2313   function cur-time-string-sec returns character
     2314   :
     2315     define variable v-date as date      no-undo .
     2316     define variable v-time as integer   no-undo .
     2317     run cur-time in this-procedure
     2318       (output v-date
     2319       ,output v-time
     2320       ) .
     2321     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2322   end.
     2323   function cur-time-custom  returns character
     2324   (input p-prefix as character
     2325   ,input p-date-format as character
     2326   ,input p-delimiter as character
     2327   ,input p-time-format as character
     2328   ,input p-suffix as character
     2329   )
     2330   :
     2331     define variable v-date as date      no-undo .
     2332     define variable v-time as integer   no-undo .
     2333     run cur-time in this-procedure
     2334       (output v-date
     2335       ,output v-time
     2336       ) .
     2337     return
     2338       p-prefix
     2339       + string(v-date, p-date-format)
     2340       + p-delimiter
     2341       + string(v-time, p-time-format)
     2342       + p-suffix
     2343       .
     2344   end.
     2345   function cur-time-print  returns character
     2346   :
     2347     define variable v-date as date      no-undo .
     2348     define variable v-time as integer   no-undo .
     2349     run cur-time in this-procedure
     2350       (output v-date
     2351       ,output v-time
     2352       ) .
     2353     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2354   end.
     2355   function cur-time-datetime returns datetime
     2356   :
     2357     define variable v-char as character no-undo .
     2358     define variable v-datetime as datetime no-undo .
     2359     v-char = cur-time-string().
     2360     v-datetime = datetime(v-char).
     2361     return  v-datetime.
     2362   end.
     2363   function cur-time-string-msec returns character
     2364   :
     2365     define variable v-date as datetime  no-undo .
     2366     v-date = now.
     2367     return string(v-date) .
     2368   end.
     2369   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2370   define variable v-waitfram-action01         as character   no-undo .
     2371   define variable v-waitfram-action02         as character   no-undo .
     2372   define variable v-waitfram-action03         as character   no-undo .
     2373   define variable mWaitFramTextBeg            as character   no-undo.
     2374   define variable mWaitFramTextEnd            as character   no-undo.
     2375   define variable mWaitFramView               as logical     no-undo.
     2376   define variable mWaitProcEvent              as logical     no-undo init yes.
     2377   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2378   define variable mWaitFramStop               as logical     no-undo.
     2379   define variable mWaitFramStopUser           as logical     no-undo.
     2380   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2381   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2382   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2383   define button B-WaitFramStop auto-end-key
     2384        label "Стоп"
     2385        size 10 by 1 tooltip "Остоновить процесс".
     2386   define button B-viewProcInfo
     2387        label "Информация"
     2388        size 15 by 1 tooltip "Информация о процесс".
     2389   define frame waitfram
     2390     v-waitfram-action01 format "x(72)" no-label skip
     2391     v-waitfram-action02 format "x(72)" no-label skip
     2392     v-waitfram-action03 format "x(72)" no-label skip
     2393     B-viewProcInfo
     2394     B-WaitFramStop at row 4 col 30
     2395     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2396     .
     2397   define new global shared variable mBatchMode as logical no-undo init ?.
     2398   define variable mFramBachModHandle as handle no-undo.
     2399   mFramBachModHandle = frame waitfram:handle.
     2400   define variable mFameOldVis as logical no-undo.
     2401   define variable mVisCUrentVin as logical no-undo.
     2402   if session:batch-mode
     2403   then
     2404      mBatchMode = yes.
     2405   if mBatchMode = ? then do:
     2406     mVisCUrentVin = current-window:visible.
     2407     mFameOldVis = mFramBachModHandle:visible.
     2408     mFramBachModHandle:visible  = yes.
     2409     mBatchMode = mFramBachModHandle:visible ne yes.
     2410     mFramBachModHandle:visible = mFameOldVis.
     2411     current-window:visible = mVisCUrentVin.
     2412   end.
     2413    if  log-manager:logfile-name ne ?
     2414     then DO:
     2415         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2416         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2417         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2418     end.
     2419   on choose of B-WaitFramStop in frame waitfram
     2420   do:
     2421     mWaitFramStop = yes.
     2422     mWaitFramStopUser = yes.
     2423   end.
     2424   function waitfram-check-timeout returns logical():
     2425      define variable vtime as int64 no-undo.
     2426      if mWaitFramStopTimeOut
     2427      then
     2428         return yes.
     2429      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2430      if     mWaitFramTimeOut ne ?
     2431         and mWaitFramTimeOut ne 0
     2432         and mWaitFramTimeOut lt vtime
     2433      then do:
     2434         mWaitFramStopTimeOut = yes.
     2435      end.
     2436      return mWaitFramStopTimeOut.
     2437   end.
     2438   procedure waitfram-hide :
     2439     if not session:batch-mode
     2440     then do
     2441     on error undo, return error return-value
     2442     :
     2443       pause 0 before-hide .
     2444       if not mBatchMode then
     2445         hide frame waitfram .
     2446     if     not mWaitFramView
     2447        and mWaitProcEvent
     2448     then
     2449       process events .
     2450     end.
     2451   end procedure.
     2452   procedure waitfram-show :
     2453     define input  parameter p-message as character no-undo .
     2454     define variable v-left-margin as integer   no-undo .
     2455     if not session:batch-mode
     2456     then do
     2457     on error undo, return error return-value
     2458     :
     2459       if length(p-message) <= 70 then do:
     2460         assign
     2461           v-left-margin = integer((70 - length(p-message)) / 2)
     2462         .
     2463         assign
     2464           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2465         .
     2466         assign
     2467           v-waitfram-action01 = " "
     2468           v-waitfram-action02 = " "
     2469                                    + fill(" ", v-left-margin)
     2470                                    + p-message
     2471           v-waitfram-action03 = " "
     2472         .
     2473       end.
     2474       else do:
     2475         define variable vRindex1 as integer no-undo.
     2476         define variable vRindex2 as integer no-undo.
     2477         vRindex1 = r-index(p-message," ",70).
     2478         if vRindex1 = 0
     2479         then
     2480            vRindex1 = 70.
     2481         if length(p-message)  <= vRindex1 + 70 then do:
     2482           assign
     2483             v-waitfram-action01 = " "
     2484             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2485             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2486           .
     2487         end.
     2488         else do:
     2489           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2490           if vRindex2 <= vRindex1
     2491           then
     2492              vRindex2 = vRindex1 + 70.
     2493           assign
     2494             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2495             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2496             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2497           .
     2498         end.
     2499       end.
     2500       B-viewProcInfo:visible   in frame waitfram = no.
     2501       B-viewProcInfo:sensitive in frame waitfram = no.
     2502       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2503       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2504       if  (   mWaitFramView
     2505          or  mWaitProcEvent)
     2506          and not mBatchMode
     2507       then
     2508          display
     2509             v-waitfram-action01 skip
     2510             v-waitfram-action02 skip
     2511             v-waitfram-action03 skip
     2512          with frame waitfram .
     2513       if     mWaitFramView
     2514          then do:
     2515             if     mWaitFramInterval ne ?
     2516                and not mBatchMode
     2517             then
     2518                wait-for go of frame waitfram pause mWaitFramInterval.
     2519          end.
     2520          else
     2521             if     mWaitProcEvent
     2522                and not mBatchMode
     2523             then
     2524                process events .
     2525     end.
     2526   end procedure.
     2527      procedure waitfram-show-this:
     2528         define input  parameter iInterval as int64 no-undo.
     2529         define variable vtime as int64 no-undo.
     2530         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2531         mWaitFramInterval = iInterval.
     2532         run waitfram-show (substitute("&1&2 &3&4" ,
     2533                                       mWaitFramTextBeg ,
     2534                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2535                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2536                                       mWaitFramTextEnd
     2537                                      )
     2538                           ).
     2539      end.
     2540      procedure WaitFramRunPause:
     2541         define input  parameter iInterval as dec no-undo.
     2542         define variable vStart  as datetime-tz no-undo.
     2543         define variable vend    as datetime-tz no-undo.
     2544         define variable vint as int64 no-undo.
     2545         define variable vOk as logical no-undo.
     2546         vStart = now.
     2547         vend   = vStart.
     2548         publish "WaitFramPause" (iInterval,output vOk).
     2549         vend   =  now.
     2550         vint = vend - vStart.
     2551         vint = iInterval - vint / 1000.
     2552         if     not mWaitFramStop
     2553            and (   vint > 0
     2554                 or (    not vOk
     2555                     and iInterval eq ?
     2556                     )
     2557                 )
     2558         then
     2559            run waitfram-show-this (iInterval).
     2560         vend   =  now.
     2561         vint = vend - vStart.
     2562         vint = iInterval - vint / 1000.
     2563         if     not mWaitFramStop
     2564            and vint > 0
     2565         then do:
     2566            run gbl/pause.p (vint * 1000).
     2567         end.
     2568         if iInterval ne ?
     2569         then
     2570            publish "WaitFramStop".
     2571         waitfram-check-timeout().
     2572      end.
     2573      procedure WaitFramWaitFor:
     2574         define input  parameter iInterval as dec no-undo.
     2575         assign
     2576            mWaitFramStartProc   = now
     2577            mWaitFramStopUser    = no
     2578            mWaitFramStopTimeOut = no
     2579         .
     2580         block-wait:
     2581         do while not mWaitFramStop:
     2582            run WaitFramRunPause (iInterval).
     2583            if  waitfram-check-timeout()
     2584            then do:
     2585               leave block-wait.
     2586            end.
     2587         end.
     2588         run waitfram-hide.
     2589      end.
     2590   procedure waitfram-join :
     2591     define input  parameter p-line-1  as character no-undo .
     2592     define input  parameter p-line-2  as character no-undo .
     2593     define input  parameter p-line-3  as character no-undo .
     2594     define output parameter p-message as character no-undo .
     2595     do
     2596     on error undo, return error return-value
     2597     :
     2598       assign
     2599         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2600                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2601                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2602       .
     2603     end.
     2604   end procedure.
     2605   function waitfram-join-function returns character
     2606     (input p-line-1 as character
     2607     ,input p-line-2 as character
     2608     ,input p-line-3 as character
     2609     ).
     2610     define variable v-message as character no-undo .
     2611     run waitfram-join in this-procedure
     2612       (input  p-line-1
     2613       ,input  p-line-2
     2614       ,input  p-line-3
     2615       ,output v-message
     2616       ) .
     2617     return v-message .
     2618   end function .
     2619   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2620   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
     2621                                                       ,input p-range-type as character
     2622                                                       ,input p-code as integer):
     2623   define variable v-seq-val as integer no-undo .
     2624   define buffer buf_code-range for ub.code-range.
     2625   find first buf_code-range no-lock where
     2626             buf_code-range.db-num = p-db-num
     2627       and  buf_code-range.range-type = p-range-type
     2628       and  buf_code-range.stts = 'u'
     2629       and buf_code-range.first-code <= p-code
     2630       and buf_code-range.last-code >= p-code no-error .
     2631   if available buf_code-range then return yes.
     2632   CASE p-range-type:
     2633     when 'pngb':U then do:
     2634       v-seq-val = current-value(s-pngb-code, ub).
     2635     end.
     2636     when 'fmgb':U then do:
     2637       v-seq-val = current-value(s-fmgb-code, ub).
     2638     end.
     2639   END CASE.
     2640   if p-code <= v-seq-val then do:
     2641     find first buf_code-range no-lock where
     2642               buf_code-range.db-num = p-db-num
     2643         and  buf_code-range.range-type = p-range-type
     2644         and  buf_code-range.stts = 'a'
     2645         and buf_code-range.first-code <= p-code
     2646         no-error .
     2647    if available buf_code-range then return yes.
     2648   end.
     2649   find first buf_code-range no-lock where
     2650             buf_code-range.db-num = p-db-num
     2651       and  buf_code-range.range-type = p-range-type
     2652       and  buf_code-range.stts = 'f'
     2653       and buf_code-range.first-code <= p-code
     2654       and buf_code-range.last-code >= p-code
     2655       no-error .
     2656   if available buf_code-range then return yes.
     2657   return no.
     2658   END FUNCTION.
     2659   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
     2660                                                       ,input p-range-type as character
     2661                                                       ,input p-code as integer):
     2662   define variable v-seq-val as integer no-undo .
     2663   define buffer buf_code-range for ub.code-range.
     2664   CASE p-range-type:
     2665     when 'pngb':U then do:
     2666       v-seq-val = current-value(s-pngb-code, ub).
     2667     end.
     2668     when 'fmgb':U then do:
     2669       v-seq-val = current-value(s-fmgb-code, ub).
     2670     end.
     2671   END CASE.
     2672   if p-code <= v-seq-val then do:
     2673     find first buf_code-range no-lock where
     2674               buf_code-range.db-num = p-db-num
     2675         and  buf_code-range.range-type = p-range-type
     2676         and buf_code-range.first-code <= p-code
     2677         and buf_code-range.last-code >= p-code no-error .
     2678     if available buf_code-range then return yes.
     2679   end.
     2680   return no.
     2681   END FUNCTION.
     2682   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
     2683                                                       ,input p-db-num as integer
     2684                                                       ,input p-staff-code as integer
     2685                                                       ,input p-date as date
     2686                                                        ):
     2687   define buffer buf_staff for ub.staff.
     2688   if p-date = ? then do:
     2689     p-date = today .
     2690   end.
     2691   find first buf_staff no-lock where
     2692             buf_staff.role = p-role
     2693         and buf_staff.role-level = 'db':U
     2694         and buf_staff.db-num = p-db-num
     2695         and buf_staff.staff-code = p-staff-code
     2696         and buf_staff.date-end >= p-date use-index pi  no-error .
     2697   if available buf_staff then do:
     2698     return buf_staff.psn-code.
     2699   end.
     2700   return 0.
     2701   end FUNCTION.
     2702   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
     2703                                                             ,input p-db-num as integer
     2704                                                             ,input p-date as date
     2705                                                                 ):
     2706   define buffer buf_staff for ub.staff.
     2707   define buffer buf2_staff for ub.staff.
     2708   if p-date = ? then do:
     2709     p-date = today .
     2710   end.
     2711   for each  buf_staff no-lock where
     2712             buf_staff.role = p-role
     2713         and buf_staff.db-num = p-db-num,
     2714   first buf2_staff no-lock where
     2715         buf2_staff.role = p-role
     2716     and buf2_staff.role-level = 'db':U
     2717     and buf2_staff.staff-code = buf_staff.staff-code
     2718     and buf2_staff.date-start <= p-date
     2719     and buf2_staff.date-end >= p-date
     2720   by buf_staff.staff-code
     2721   by date-start descending:
     2722     return buf_staff.staff-code.
     2723   end.
     2724   end FUNCTION.
     2725   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
     2726                                                  ,input p-db-num as integer
     2727                                                  ,input p-psn-code as integer
     2728                                                  ,input p-date as date
     2729                                                  ,output p-c-password as character
     2730                                                        ):
     2731   define buffer buf_staff for ub.staff.
     2732   if p-date = ? then do:
     2733     p-date = today .
     2734   end.
     2735   find first buf_staff no-lock where
     2736             buf_staff.role = p-role
     2737         and buf_staff.role-level = 'db':U
     2738         and buf_staff.db-num = p-db-num
     2739        and buf_staff.date-end >= p-date
     2740        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
     2741   if available buf_staff
     2742   then do:
     2743     assign
     2744     p-c-password = buf_staff.password.
     2745     return buf_staff.staff-code.
     2746   end.
     2747   p-c-password = ''.
     2748   return 0.
     2749   end FUNCTION.
     2750   FUNCTION gbclcode-is-psn-role returns integer (
     2751                                                 input p-role as character
     2752                                                 ,input p-psn-code as integer
     2753                                                 ,input p-date as date
     2754                                                     ):
     2755   define buffer buf_staff for ub.staff.
     2756   if p-date = ? then do:
     2757     p-date = today .
     2758   end.
     2759   for each buf_staff no-lock where
     2760             buf_staff.psn-code = p-psn-code
     2761        and  buf_staff.role = p-role
     2762   by buf_staff.role-level
     2763   by buf_staff.date-start
     2764        :
     2765     if  buf_staff.date-start <= p-date and
     2766     buf_staff.date-end >= p-date  then do:
     2767       return buf_staff.staff-code.
     2768     end.
     2769   end.
     2770   return 0.
     2771   end FUNCTION.
     2772   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
     2773   define variable v-role-name as character no-undo .
     2774   assign
     2775   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     2776   no-error .
     2777   return v-role-name.
     2778   END.
     2779   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2780   FUNCTION gbclcode-get-position returns character ( input p-role as character
     2781                                                     ,input p-role-level as character
     2782                                                     ,input p-work-place as character
     2783                                                     ,input p-staff-code as integer
     2784                                                                ):
     2785   define variable v-role-name as character no-undo .
     2786   define variable v-role-level as character no-undo .
     2787   define variable v-staff-code as integer no-undo .
     2788   assign
     2789   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     2790   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
     2791   v-staff-code = p-staff-code
     2792   no-error .
     2793   return substitute("&1, &2, Код &3"
     2794                   ,v-role-name
     2795                   ,v-role-level
     2796                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
     2797   END.
     2798   FUNCTION gbclcode-get-work-place returns character (
     2799                                                   input p-role as character
     2800                                                  ,input p-role-level as character
     2801                                                  ,input p-db-num as integer
     2802                                                  ,input p-host-code as integer
     2803                                                  ,input p-obj-type as character
     2804                                                  ,input p-obj-code as integer
     2805                                                  ) :
     2806   define variable v-work-place as character no-undo .
     2807   define variable v-obj-type as character no-undo .
     2808     case p-role-level:
     2809       when 'db':U then do:
     2810         v-work-place = string(p-db-num, "99999").
     2811       end.
     2812       when 'firm':U then do:
     2813         v-work-place = string(p-host-code, "99999").
     2814       end.
     2815       when 'object':U then do:
     2816         assign
     2817         v-work-place = p-obj-type + string(p-obj-code, "999999999")
     2818         .
     2819       end.
     2820     END CASE.
     2821     return v-work-place.
     2822   END FUNCTION.
     2823   FUNCTION gbclcode-get-level-last-code returns integer (
     2824                                                           input p-role as character
     2825                                                         , input p-role-level as character
     2826                                                         , input p-work-place as character
     2827                                                         , input p-date-start as date
     2828                                                         ):
     2829   DEFINE VARIABLE v-today as date no-undo .
     2830   define buffer buf_staff for ub.staff.
     2831   if p-work-place = chr(63) then return ?.
     2832   if p-date-start = ? then do:
     2833     v-today = today .
     2834   end.
     2835   else do:
     2836     v-today = p-date-start.
     2837   end.
     2838   find last buf_staff no-lock where
     2839             buf_staff.role = p-role
     2840        and  buf_staff.role-level = p-role-level
     2841        and  buf_staff.work-place = p-work-place
     2842        and  buf_staff.date-start <= v-today + 1
     2843        and  buf_staff.date-end >= v-today + 1
     2844        use-index pi  no-error .
     2845   if available buf_staff
     2846   then return buf_staff.staff-code.
     2847   return 0.
     2848   end FUNCTION.
