     4614             ,input  v-cntxt-userid
     4615             ,input  'wndmax':U
     4616             ,output v-diasize-wndmax
     4617             ,output v-default-value
     4618             ) .
     4619         end.
     4620         assign
     4621           v-diasize-wndstore = false
     4622         .
     4623         if connected("ub") = true
     4624         then do:
     4625           run gbl/wndpar_r.p
     4626             (input  v-cntxt-db-num
     4627             ,input  v-cntxt-userid
     4628             ,input  'wndstore':U
     4629             ,output v-diasize-wndstore
     4630             ,output v-default-value
     4631             ) .
     4632         end.
     4633         assign
     4634           v-diasize-proc-name = entry(1, program-name(2), '.')
     4635         .
     4636         if v-diasize-wndstore = true
     4637         then do:
     4638           assign
     4639             v-restore-saved = false
     4640           .
     4641           if connected("ub") = true
     4642           then do:
     4643             run gbl/wndsizer.p
     4644               (input  v-cntxt-db-num
     4645               ,input  v-cntxt-userid
     4646               ,input  v-diasize-proc-name
     4647               ,input  'height':u
     4648               ,output v-resize-value-str
     4649               ) .
     4650             if v-resize-value-str <> '':U
     4651             then do:
     4652               run diasize_change-height in this-procedure
     4653                 (input  integer(v-resize-value-str)
     4654                 ,input  true
     4655                 ) .
     4656               assign
     4657                 v-restore-saved = true
     4658               .
     4659             end.
     4660           end.
     4661           if connected("ub") = true
     4662           then do:
     4663             run gbl/wndsizer.p
     4664               (input  v-cntxt-db-num
     4665               ,input  v-cntxt-userid
     4666               ,input  v-diasize-proc-name
     4667               ,input  'width':u
     4668               ,output v-resize-value-str
     4669               ) .
     4670             if v-resize-value-str <> '':U
     4671             then do:
     4672               run diasize_change-width in this-procedure
     4673                 (input  integer(v-resize-value-str)
     4674                 ,input  true
     4675                 ) .
     4676               assign
     4677                 v-restore-saved = true
     4678               .
     4679             end.
     4680           end.
     4681           if v-restore-saved <> true
     4682           then do:
     4683             if v-diasize-wndmax = true
     4684             then do:
     4685               run diasize_maximize in this-procedure
     4686                 (input  true
     4687                 ) .
     4688             end.
     4689           end.
     4690         end.
     4691         else do:
     4692           if v-diasize-wndmax = true
     4693           then do:
     4694             run diasize_maximize in this-procedure
     4695               (input  true
     4696               ) .
     4697           end.
     4698         end.
     4699       end.
     4700     end.
     4701   end procedure.
     4702   procedure diasize_need-full-display :
     4703     define output parameter p-need-full-display as logical   no-undo .
     4704     do
     4705     on error undo, return error return-value
     4706     :
