     1316   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1317   procedure fltfield-clear :
     1318     define output parameter loc-fld as character no-undo.
     1319     define output parameter loc-lab as character no-undo .
     1320     define output parameter loc-spr as character no-undo .
     1321     define output parameter loc-dim as character no-undo .
     1322     assign
     1323       loc-fld = ""
     1324       loc-lab = ""
     1325       loc-spr = ""
     1326       loc-dim = "0"
     1327     .
     1328   end procedure .
     1329   procedure fltfield-add :
     1330     define input        parameter par-fld as character no-undo.
     1331     define input        parameter par-lab as character no-undo .
     1332     define input        parameter par-spr as character no-undo .
     1333     define input-output parameter loc-fld as character no-undo.
     1334     define input-output parameter loc-lab as character no-undo .
     1335     define input-output parameter loc-spr as character no-undo .
     1336     define input-output parameter loc-dim as character no-undo .
     1337     do
     1338     on error undo, return error
     1339     :
     1340       assign
     1341       loc-fld = if loc-dim = '0'
     1342                 then par-fld
     1343                 else (loc-fld + chr(44) + par-fld)
     1344       loc-lab = if loc-dim = '0'
     1345                 then par-lab
     1346                 else (loc-lab + chr(44) + par-lab)
     1347       loc-spr = if loc-dim = '0'
     1348                 then par-spr
     1349                 else (loc-spr + chr(44) + par-spr)
     1350       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1351                 string(integer(if num-entries(loc-dim) > 1
     1352                               then entry(2, loc-dim)
     1353                               else entry(1, loc-dim)
     1354                               ) + 1)
     1355       no-error
     1356       .
     1357     end.
     1358   end procedure.
     1359   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1360   define  stream PrnLibStream.
     1361   procedure prn-lib-prn-file :
     1362     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1363     define input parameter p-DIsabledoptions as integer no-undo .
     1364     define variable v-report-name as character no-undo .
     1365     define variable v-user-action as character no-undo .
     1366     define variable v-printed     as logical   no-undo .
     1367     define variable v-exist       as logical   no-undo .
     1368     do
     1369       on error undo, return error
     1370       :
     1371       run prn-lib-get-report-name  in this-procedure (
     1372         input parParentProc
     1373         ,output v-report-name
     1374         ).
     1375   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1376   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1377     (input  v-report-name
     1378     ,input  2
     1379     ,output v-exist
     1380     )  .
     1381       if NOT v-exist then
     1382       DO:
     1383         Message
     1384           "Нет заданий на печать ! "
     1385           view-as alert-box .
     1386         Return  .
     1387       End.
     1388       run gbl/prnfilen.w
     1389         (input  ""
     1390         ,input  p-DisabledOptions
     1391         ,input  string(v-report-name )
     1392         ,input  7
     1393         ,output v-user-action
     1394         ,output v-printed
     1395         ) .
     1396       if v-printed then
     1397       do:
     1398         return "YES" .
     1399       end.
     1400       else
     1401       do:
     1402         return "NO" .
     1403       end.
     1404     end.
     1405   end procedure.
     1406   procedure prn-lib-open-stream :
     1407     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1408     define input parameter p-page-size    as integer no-undo .
     1409     define input parameter p-is-stream    as logical no-undo .
     1410     define input parameter p-append       as logical no-undo .
     1411     define variable v-report-name as character no-undo .
     1412     do
     1413       on error undo, return error
     1414       :
     1415       run prn-lib-get-report-name  in this-procedure (
     1416         input parParentProc
     1417         ,output v-report-name
     1418         ).
     1419       if p-is-stream then
     1420       do:
     1421         if p-append then
     1422         do:
     1423           output stream PrnLibStream to value( v-report-name )
     1424             page-size value(p-page-size) append .
     1425         end.
     1426         if not p-append then
     1427         do:
     1428           output stream PrnLibStream to value( v-report-name )
     1429             page-size value(p-page-size) .
     1430         end.
     1431       end.
     1432       if not p-is-stream then
     1433       do:
     1434         if p-append then
     1435         do:
     1436           output to value( v-report-name )
     1437             page-size value(p-page-size) append .
     1438         end.
     1439         if not p-append then
     1440         do:
     1441           output to value( v-report-name )
     1442             page-size value(p-page-size) .
     1443         end.
     1444       end.
     1445     end.
     1446   end procedure.
     1447   procedure prn-lib-open-exp :
     1448     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1449     define input parameter p-is-stream    as logical no-undo .
     1450     define input parameter p-is-append    as logical no-undo .
     1451     define output parameter p-ReportFileName as char init "report" no-undo.
     1452     define output parameter p-process as logical no-undo .
     1453     define variable glog as logical no-undo .
     1454     do
     1455       on error undo, return error
     1456       :
     1457       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1458         TITLE      "Укажите путь"
     1459         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1460         ASK-OVERWRITE
     1461         CREATE-TEST-FILE
     1462         SAVE-AS
     1463         USE-FILENAME
     1464         DEFAULT-EXTENSION "txt"
     1465         UPDATE glog
     1466         .
     1467       if not glog then  return.
     1468       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1469       if p-is-stream then
     1470       do:
     1471         if p-is-append then
     1472         do:
     1473           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1474         end.
     1475         else
     1476         do:
     1477           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1478         end.
     1479       end.
     1480       else
     1481       do:
     1482         if p-is-append then
     1483         do:
     1484           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1485         end.
     1486         else
     1487         do:
     1488           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1489         end.
     1490       end.
     1491       p-process = yes.
     1492     end.
     1493   end procedure.
     1494   procedure prn-lib-get-report-name :
     1495     define input parameter parParentProc  as widget-handle no-undo.
     1496     define output parameter p-report-name as character no-undo .
     1497     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1498   end procedure.
     1499   procedure prn-lib-reportviewer-report-name :
     1500     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1501     define input parameter p-report-name-html as character no-undo .
     1502     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1503   end procedure.
     1504   procedure prn-lib-reportviewer :
     1505     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1506     define input parameter p-report-name-html as character no-undo .
     1507     define input parameter p-param        as character no-undo .
     1508     define variable v-excel           as character no-undo init 'TRUE' .
     1509     define variable v-value-character as character no-undo .
     1510     define variable v-value-integer   as character no-undo .
     1511     define variable v-value-date      as date      no-undo .
     1512     define variable v-value-decimal   as decimal   no-undo .
     1513     define variable rep-excel         as logical   no-undo .
     1514     define variable excel-string      as character no-undo .
     1515     define variable v-param-type      as character no-undo .
     1516     define variable v-tth             as handle    no-undo .
     1517     run adm/shattri.p (
     1518       input "get":U
     1519       ,input  ""
     1520       ,input  0
     1521       ,input  'report-glob':U
     1522       ,input  'rep-excel':U
     1523       ,output v-value-character
     1524       ,output v-value-date
     1525       ,output v-value-decimal
     1526       ,output v-value-integer
     1527       ,output rep-excel
     1528       ,output v-param-type
     1529       ,INPUT-OUTPUT table-handle v-tth
     1530       )  .
     1531     if rep-excel then v-excel = "TRUE" .
     1532     else v-excel = "FALSE" .
     1533     if p-param eq ""
     1534     then
     1535        p-param = "EXCEL:" + v-excel.
     1536     else
     1537        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1538     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1539   end procedure.
