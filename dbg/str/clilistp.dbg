     5760       ,output v-docs-cmp
     5761       )  .
     5762   end.
     5763     run get-report-num in parparentproc ( output g#report-num ).
     5764       assign
     5765       line-rec = ?
     5766       .
     5767       assign
     5768       n-c:radio-buttons in frame Dialog-Frame =
     5769       "Название" + chr(44) + 'название':U + chr(44) +
     5770                       "Код" + chr(44) + 'код':U
     5771       RS-status:radio-buttons = "Текущие&+" + chr(44) + 'текущие':U + chr(44) +
     5772                                 "Все!" + chr(44) + 'все':U + chr(44) +
     5773                                 "Удаленные-" + chr(44) + 'удаленные':U
     5774       RS-status = 'текущие':U
     5775       .
     5776     ASSIGN b-save:MENU-MOUSE = 1.
     5777     ASSIGN b-print:MENU-MOUSE = 1.
     5778     assign b-macro:menu-mouse = 1.
     5779     run proc-fill-temp-list in this-procedure .
     5780     if lookup(bttns, "hide") > 0 then do:
     5781       return.
     5782     end.
