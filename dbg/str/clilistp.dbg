        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-parent-handle as handle no-undo .
        3   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        4   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
        5   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
        6   define input parameter bttns            as character no-undo .
        7   define input parameter p-title          as character no-undo .
        8   define input parameter p-keep-query     as logical no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Автоматизированное формирование списка клиентов".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   procedure proc-alt-shift-f2:
       76     if not ibs.th.gbl.gbl-var:rcode
       77   then
       78     run gbl\inidebug.p .
       79   end.
       80   procedure proc-alt-shift-f3:
       81     run gbl/prvssinf.p
       82       ( input this-procedure
       83       ) .
       84   end.
       85   define variable v-inform-launched as logical no-undo initial false .
       86   procedure proc-alt-shift-f4:
       87     define variable v-action as character no-undo .
       88     if v-inform-launched = false then do:
       89       assign
       90         v-inform-launched = true
       91       .
       92       run gbl/d-inform.w
       93         (  input self
       94         ,  input this-procedure
       95         , output v-action
       96         ) no-error .
       97       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       98       assign
       99         v-inform-launched = false
      100       .
      101     end.
      102   end.
      103   procedure proc-alt-f1:
      104     run gbl/corrhelp.p
      105       (input this-procedure
      106       ) .
      107   end .
      108   on alt-shift-f2 anywhere do:
      109     run proc-alt-shift-f2.
      110   end.
      111   on alt-shift-f3 anywhere do:
      112     run proc-alt-shift-f3 in this-procedure .
      113   end.
      114   on alt-shift-f4 anywhere do:
      115     run proc-alt-shift-f4 in this-procedure.
      116   end.
      117   on alt-f1 anywhere do:
      118     run proc-alt-f1 in this-procedure .
      119   end.
      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   def SHARED temp-table cli-list no-undo like ub.clients
      122     field to-del as logical
      123     index obj  is primary unique obj-type obj-code
      124     index cli-name      obj-name
      125     .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define  SHARED  temp-table cli-list-hist no-undo
      128   field list-table as character
      129   field id as integer
      130   field line as integer
      131   field hist-mode as character
      132   field des as character
      133   field num-recs as integer
      134   field option_ as character
      135   field item_ as character
      136   field status_ as character
      137   field num-add as integer
      138   field num-ignored as integer
      139   field done as logical
      140   field err_ as logical
      141   field err-mes as character
      142   index pi is primary
      143   id
      144   line
      145   index isdone
      146   done
      147   .
      148   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      149     define variable v-cntxt-db-num        as integer   no-undo .
      150     define variable v-cntxt-userid        as character no-undo .
      151     define variable v-cntxt-level         as character no-undo .
      152     define variable v-cntxt-host-code-obj as integer   no-undo .
      153     define variable v-cntxt-obj-type      as character no-undo .
      154     define variable v-cntxt-obj-code      as integer   no-undo .
      155     define variable v-cntxt-db-num-obj    as integer   no-undo .
      156     define variable v-cntxt-is-admin      as logical   no-undo .
      157   define variable g#report-num as integer no-undo .
      158   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      159   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      160   procedure gen-key-rec :
      161     define input  parameter p-tbl-name    as character no-undo.
      162     define input  parameter p-bh_tbl-name as handle    no-undo.
      163     define output parameter p-key-rec     as character no-undo.
      164     do
      165     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      166     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      167     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      168     :
      169       define variable fh               as handle    no-undo .
      170       define variable v-ok             as logical   no-undo .
      171       define variable v-inform         as character no-undo .
      172       define variable v-ind            as integer   no-undo .
      173       define variable v-idx-field-qnty as integer   no-undo .
      174       if p-tbl-name = ?
      175         or p-tbl-name = "":U
      176       then do:
      177         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      178       end.
      179       if not p-bh_tbl-name:available then do:
      180         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      181       end.
      182       assign
      183         p-key-rec = p-tbl-name
      184         v-inform  = p-bh_tbl-name:index-information(1)
      185         v-ind     = 2
      186       .
      187       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      188       on error undo, return error
      189       :
      190         assign
      191           v-inform = p-bh_tbl-name:index-information( v-ind )
      192           v-ind    = v-ind + 1
      193         .
      194       end.
      195       if v-inform = ?
      196         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      197         or entry( 3, v-inform, ",":U ) <> "1":U
      198       then do:
      199         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      200       end.
      201       else do:
      202         assign
      203           v-idx-field-qnty = num-entries( v-inform ) - 4
      204         .
      205         if v-idx-field-qnty < 2 then do:
      206           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      207         end.
      208         do v-ind = 1 to v-idx-field-qnty by 2
      209         on error undo, return error
      210         :
      211           assign
      212             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      213             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      214           .
      215         end.
      216       end.
      217       if p-key-rec = ? then do:
      218         assign
      219           p-key-rec = "":U
      220         .
      221         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      222       end.
      223     end.
      224     return.
      225   end procedure.
      226   procedure gen-where-keyr-tab :
      227     define input  parameter i-tableSerach as character no-undo.
      228     define input  parameter i-tablekey   as character  no-undo.
      229     define input  parameter p-key-rec    as character  no-undo.
      230     define input  parameter p-key-handle as handle     no-undo .
      231     define input  parameter p-db-name    as character  no-undo .
      232     define input  parameter p-tt-handle  as handle     no-undo .
      233     define output parameter o-Where      as character  no-undo.
      234     do
      235     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      236     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      237     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      238     :
      239       define variable v-full-tbl-name  as character no-undo .
      240       define variable bh_tbl-name      as handle    no-undo .
      241       define variable fh_key           as handle    no-undo .
      242       define variable fh_search        as handle    no-undo .
      243       define variable v-field-num      as integer   no-undo .
      244       define variable v-count-fld      as integer   no-undo .
      245       define variable v-inform         as character no-undo .
      246       define variable v-ind            as integer   no-undo .
      247       define variable v-idx-field-qnty as integer   no-undo .
      248       define variable v-field-name     as character no-undo .
      249       define variable v-field-val      as character no-undo .
      250       define variable v-word-link      as character no-undo .
      251       define variable vTable           as character no-undo.
      252       define variable bh_tbl-key       as handle    no-undo .
      253       assign
      254         p-key-rec = trim( p-key-rec )
      255       .
      256       if p-key-handle <> ? then do:
      257         if not valid-handle(p-key-handle)
      258            or p-key-handle:type <> "buffer"
      259         then do:
      260           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      261         end.
      262         if num-entries( p-key-rec, chr(3) ) > 1
      263           or p-key-rec = ?
      264           or p-key-rec = "":U
      265         then do:
      266           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      267         end.
      268       end.
      269       else do:
      270         if p-key-rec = ?
      271           or p-key-rec = "":U
      272         then do:
      273           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      274         end.
      275       end.
      276       assign
      277         vTable = entry( 1 , p-key-rec, chr(3) )
      278       .
      279       if p-tt-handle <> ?
      280         and ( not valid-handle(p-tt-handle)
      281               or p-tt-handle:type <> "buffer"
      282             )
      283       then do:
      284         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      285       end.
      286       if p-tt-handle = ? then do:
      287         assign
      288           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      289         .
      290         create buffer bh_tbl-name for table v-full-tbl-name .
      291       end.
      292       else do:
      293         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      294       end.
      295       assign
      296         v-inform = bh_tbl-name:index-information(1)
      297         v-ind    = 2
      298       .
      299       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      300       on error undo, return error
      301       :
      302         assign
      303           v-inform = bh_tbl-name:index-information( v-ind )
      304           v-ind    = v-ind + 1
      305         .
      306       end.
      307       if v-inform = ?
      308         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      309         or entry( 3, v-inform, ",":U ) <> "1":U
      310       then do:
      311         delete object bh_tbl-name no-error.
      312         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      313       end.
      314       assign
      315         v-idx-field-qnty = num-entries( v-inform ) - 4
      316       .
      317       if v-idx-field-qnty < 2 then do:
      318         delete object bh_tbl-name no-error.
      319         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      320       end.
      321       assign
      322         o-where     = "where":U
      323         v-word-link = "":U
      324         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      325         v-count-fld = 0
      326       .
      327       if i-tablekey ne "" and i-tablekey ne ?
      328       then do:
      329         assign
      330           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      331         .
      332         create buffer bh_tbl-key for table v-full-tbl-name .
      333       end.
      334       if i-tableSerach ne "" and i-tableSerach ne ?
      335       then do:
      336         delete object bh_tbl-name no-error.
      337         assign
      338           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      339         .
      340         create buffer bh_tbl-name for table v-full-tbl-name .
      341       end.
      342       block_where:
      343       do v-ind = 1 to v-idx-field-qnty by 2
      344       on error undo, return error
      345       :
      346         assign
      347           v-count-fld = v-count-fld + 1
      348         .
      349         if p-key-handle = ?
      350           and v-count-fld > v-field-num
      351         then do:
      352           leave block_where.
      353         end.
      354         define variable VfieldKeyTable as handle no-undo.
      355         assign
      356           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      357           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      358         .
      359         if     bh_tbl-key ne ?
      360         then do:
      361            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      362            if VfieldKeyTable eq ?
      363            then next block_where.
      364         end.
      365         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      366         then
      367            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      368         else
      369            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      370         if p-key-handle = ? then do:
      371           assign
      372             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      373           .
      374         end.
      375         else do:
      376           assign
      377             fh_key = p-key-handle:buffer-field( v-field-name )
      378           .
      379           if fh_key = ?
      380             or not valid-handle( fh_key )
      381           then do:
      382             delete object bh_tbl-name.
      383             if     bh_tbl-key ne ?
      384             then
      385                delete object bh_tbl-key.
      386             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      387           end.
      388           assign
      389             v-field-val = fh_key:buffer-value
      390           .
      391         end.
      392         if fh_search:data-type ="character":U then do:
      393           assign
      394             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      395             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      396             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      397             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      398             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      399             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      400             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      401             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      402             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      403             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      404             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      405             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      406             v-field-val = substitute( '"&1"', v-field-val )
      407           .
      408         end.
      409         assign
      410           o-where = substitute( "&1 &2", o-where, v-field-val )
      411         .
      412         if v-word-link = "":U then do:
      413           assign
      414             v-word-link = "and":U
      415           .
      416         end.
      417       end.
      418       delete object bh_tbl-name.
      419       if     bh_tbl-key ne ?
      420       then
      421          delete object bh_tbl-key.
      422       if p-key-handle = ?
      423         and v-count-fld <> v-field-num
      424       then do:
      425         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      426       end.
      427     end.
      428   end procedure.
      429   procedure gen-hn-keyr-tab :
      430     define input  parameter i-tableSerach as character no-undo.
      431     define input  parameter i-tablekey   as character no-undo.
      432     define input  parameter p-key-rec    as character no-undo.
      433     define input  parameter p-key-handle as handle    no-undo .
      434     define input  parameter p-db-name    as character no-undo .
      435     define input  parameter p-tt-handle  as handle    no-undo .
      436     define input  parameter p-stts-lock  as integer   no-undo .
      437     define output parameter o-hn         as handle    no-undo.
      438     define variable v-full-tbl-name as character no-undo.
      439     define variable v-where         as character no-undo.
      440     define variable bh_tbl-name     as handle    no-undo.
      441     define variable vTable          as character no-undo.
      442     do
      443     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      444     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      445     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      446         run gen-where-keyr-tab(i-tableSerach,
      447                                i-tablekey,
      448                                p-key-rec,
      449                                p-key-handle,
      450                                p-db-name,
      451                                p-tt-handle,
      452                                output v-where).
      453         if i-tableSerach ne "" and i-tableSerach ne ?
      454         then do:
      455            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      456            create buffer bh_tbl-name for table v-full-tbl-name .
      457         end.
      458         else do:
      459            if p-tt-handle = ? then do:
      460               assign
      461                  vTable = entry( 1 , p-key-rec, chr(3) )
      462               .
      463               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      464               create buffer bh_tbl-name for table v-full-tbl-name .
      465            end.
      466            else do:
      467               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      468            end.
      469         end.
      470         if p-tt-handle = ? then do:
      471            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      472         end.
      473         else do:
      474            bh_tbl-name:find-first( v-where ) no-error .
      475         end.
      476         o-hn = bh_tbl-name.
      477      end.
      478   end procedure.
      479   procedure gen-hn-keyr :
      480     define input  parameter p-key-rec    as character no-undo.
      481     define input  parameter p-key-handle as handle    no-undo .
      482     define input  parameter p-db-name    as character no-undo .
      483     define input  parameter p-tt-handle  as handle    no-undo .
      484     define input  parameter p-stts-lock  as integer   no-undo .
      485     define output parameter o-hn         as handle    no-undo.
      486     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      487   end.
      488   procedure gen-row-keyr :
      489     define input  parameter p-key-rec    as character no-undo.
      490     define input  parameter p-key-handle as handle    no-undo .
      491     define input  parameter p-db-name    as character no-undo .
      492     define input  parameter p-tt-handle  as handle    no-undo .
      493     define input  parameter p-stts-lock  as integer   no-undo .
      494     define output parameter p-tbl-row    as rowid     no-undo.
      495     define output parameter p-tbl-name   as character no-undo.
      496     define variable vHn as handle no-undo.
      497       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      498       p-tbl-row = if vHn:available then vHn:rowid else ?.
      499       p-tbl-name =  vHn:table.
      500       delete object vHn no-error.
      501     if p-tbl-row = ? then do:
      502       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      503     end.
      504     else do:
      505       return.
      506     end.
      507   end procedure.
      508   procedure gen-key-fv :
      509     define input  parameter p-key-rec    as character no-undo .
      510     define output parameter p-field-list as character no-undo .
      511     define output parameter p-value-list as character no-undo.
      512     do
      513     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      514     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      515     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      516     :
      517       define variable v-full-tbl-name  as character no-undo .
      518       define variable bh_tbl-name      as handle    no-undo .
      519       define variable v-tbl-name       as character no-undo .
      520       define variable v-field-num      as integer   no-undo .
      521       define variable v-count-fld      as integer   no-undo .
      522       define variable v-inform         as character no-undo .
      523       define variable v-ind            as integer   no-undo .
      524       define variable v-idx-field-qnty as integer   no-undo .
      525       define variable v-delim-key      as character no-undo .
      526       if p-key-rec = ?
      527         or p-key-rec = "":U
      528       then do:
      529         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      530       end.
      531       assign
      532         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      533         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      534       .
      535       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      536       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      537       assign
      538         v-inform = bh_tbl-name:index-information(1)
      539         v-ind    = 2
      540       .
      541       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      542       on error undo, return error
      543       :
      544         assign
      545           v-inform = bh_tbl-name:index-information( v-ind )
      546           v-ind    = v-ind + 1
      547         .
      548       end.
      549       if v-inform = ?
      550         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      551         or entry( 3, v-inform, ",":U ) <> "1":U
      552       then do:
      553         delete object bh_tbl-name no-error.
      554         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      555       end.
      556       assign
      557         v-idx-field-qnty = num-entries( v-inform ) - 4
      558       .
      559       if v-idx-field-qnty < 2 then do:
      560         delete object bh_tbl-name no-error.
      561         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      562       end.
      563       assign
      564         p-field-list = "":U
      565         p-value-list = "":U
      566         v-delim-key  = "":U
      567         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      568         v-count-fld  = 0
      569       .
      570       block_where:
      571       do v-ind = 1 to v-idx-field-qnty by 2
      572       on error undo, return error
      573       :
      574         assign
      575           v-count-fld = v-count-fld + 1
      576         .
      577         if v-count-fld > v-field-num then do:
      578           leave block_where.
      579         end.
      580         assign
      581           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      582           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      583         .
      584         if v-ind = 1 then do:
      585           assign
      586             v-delim-key = chr(3)
      587           .
      588         end.
      589       end.
      590       delete object bh_tbl-name.
      591       if v-count-fld <> v-field-num then do:
      592         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      593       end.
      594     end.
      595   end procedure.
      596   procedure gen-key-field :
      597     define input  parameter p-table      as character no-undo .
      598     define output parameter p-field-list as character no-undo .
      599     do
      600     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      601     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      602     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      603     :
      604       define variable v-full-tbl-name  as character no-undo .
      605       define variable bh_tbl-name      as handle    no-undo .
      606       define variable v-tbl-name       as character no-undo .
      607       define variable v-field-num      as integer   no-undo .
      608       define variable v-count-fld      as integer   no-undo .
      609       define variable v-inform         as character no-undo .
      610       define variable v-ind            as integer   no-undo .
      611       define variable v-idx-field-qnty as integer   no-undo .
      612       define variable v-delim-key      as character no-undo .
      613       if p-table = ?
      614         or p-table = "":U
      615       then do:
      616         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      617       end.
      618       assign
      619         v-tbl-name      = p-table
      620         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      621       .
      622       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      623       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      624       assign
      625         v-inform = bh_tbl-name:index-information(1)
      626         v-ind    = 2
      627       .
      628       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      629       on error undo, return error
      630       :
      631         assign
      632           v-inform = bh_tbl-name:index-information( v-ind )
      633           v-ind    = v-ind + 1
      634         .
      635       end.
      636       if v-inform = ?
      637         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      638         or entry( 3, v-inform, ",":U ) <> "1":U
      639       then do:
      640         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      641       end.
      642       assign
      643         v-idx-field-qnty = num-entries( v-inform ) - 4
      644       .
      645       if v-idx-field-qnty < 2 then do:
      646         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      647       end.
      648       assign
      649         p-field-list = "":U
      650         v-delim-key  = "":U
      651         v-count-fld  = 0
      652       .
      653       block_where:
      654       do v-ind = 1 to v-idx-field-qnty by 2
      655       on error undo, return error
      656       :
      657         assign
      658           v-count-fld = v-count-fld + 1
      659         .
      660         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      661         if v-ind = 1 then do:
      662           assign
      663             v-delim-key = chr(3)
      664           .
      665         end.
      666       end.
      667       delete object bh_tbl-name.
      668     end.
      669   end procedure.
      670   procedure create-cli-list-hist :
      671   define input parameter p-mode as character no-undo .
      672   define input-output parameter p-seq as integer no-undo .
      673   define input parameter p-line as integer no-undo .
      674   define variable p-list-table as character no-undo .
      675   define input parameter p-hist-mode as character no-undo .
      676   define input parameter p-des as character no-undo .
      677   define input parameter p-num-recs as integer no-undo .
      678   define input parameter p-option as character no-undo .
      679   define input parameter p-status_ as character no-undo .
      680   define input parameter p-item as character no-undo .
      681   define input parameter p-tbl-name as character no-undo .
      682   define input parameter p-bh_tbl-name as handle no-undo .
      683   define variable v-num-add as integer no-undo .
      684   define variable v-num-ignored as integer no-undo .
      685   define buffer buf_cli-list-hist for cli-list-hist.
      686     do
      687     on error undo, return error
      688     :
      689       CASE p-mode:
      690         when 'title' then do:
      691           find first buf_cli-list-hist where
      692                      buf_cli-list-hist.id = 0   no-error.
      693           if not available buf_cli-list-hist then do:
      694             create buf_cli-list-hist.
      695             assign
      696             buf_cli-list-hist.id = 0
      697             buf_cli-list-hist.line = 0
      698             buf_cli-list-hist.list-table = '':U
      699             .
      700           end.
      701           assign
      702           buf_cli-list-hist.des =  p-des
      703           buf_cli-list-hist.num-recs = p-num-recs
      704           buf_cli-list-hist.option_  = p-option
      705           buf_cli-list-hist.item_ = p-item
      706           .
      707         end.
      708         when 'ДОБАВЛЕНИЕ':U then do:
      709           if p-option begins 'single' then do:
      710             CASE p-hist-mode:
      711               when '+':U then do:
      712                 assign
      713                 v-num-add = 1
      714                 v-num-ignored  = 0
      715                 .
      716               end.
      717               when '-':U then do:
      718                 assign
      719                 v-num-add = 1
      720                 v-num-ignored  = 0
      721                 .
      722               end.
      723               when '*':U then do:
      724                 assign
      725                 v-num-add = p-num-recs - 1
      726                 p-num-recs = 1
      727                 v-num-ignored  = 0
      728                 .
      729               end.
      730             END CASE.
      731           end.
      732           create buf_cli-list-hist.
      733           assign
      734           buf_cli-list-hist.id = p-seq
      735           buf_cli-list-hist.list-table = p-list-table
      736            p-seq = (if p-line = 0 then (p-seq + 1) else p-seq)
      737           buf_cli-list-hist.des =  p-des
      738           buf_cli-list-hist.line = p-line
      739           buf_cli-list-hist.num-recs = p-num-recs
      740           buf_cli-list-hist.option_  = p-option
      741           buf_cli-list-hist.item_ = p-item
      742           buf_cli-list-hist.hist-mode =  p-hist-mode
      743           buf_cli-list-hist.status_ =  p-status_
      744           buf_cli-list-hist.num-add = v-num-add
      745           buf_cli-list-hist.num-ignored = v-num-ignored
      746           .
      747         end.
      748         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'des' then do:
      749           find first buf_cli-list-hist where
      750                     buf_cli-list-hist.id = p-seq
      751                 and buf_cli-list-hist.line = p-line no-error .
      752           if  available buf_cli-list-hist then do:
      753             assign
      754             buf_cli-list-hist.des =  p-des
      755             buf_cli-list-hist.num-recs = p-num-recs
      756             buf_cli-list-hist.option_  = p-option
      757             buf_cli-list-hist.item_ = p-item
      758             buf_cli-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      759                                        then p-list-table
      760                                        else buf_cli-list-hist.list-table)
      761             .
      762           end.
      763         end.
      764         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'mode' then do:
      765           find first buf_cli-list-hist where
      766                     buf_cli-list-hist.id = p-seq
      767                 and buf_cli-list-hist.line = p-line  no-error .
      768           if available buf_cli-list-hist then do:
      769             assign
      770             buf_cli-list-hist.hist-mode =  p-hist-mode
      771             buf_cli-list-hist.num-recs  = (if buf_cli-list-hist.line = 0 then p-num-recs else buf_cli-list-hist.num-recs)
      772             buf_cli-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      773                                        then p-list-table
      774                                        else buf_cli-list-hist.list-table)
      775             .
      776           end.
      777         end.
      778       END CASE.
      779       if p-tbl-name <> "":U
      780       and valid-handle(p-bh_tbl-name)
      781       then do:
      782         run gen-key-rec  in this-procedure (
      783                                               input  p-tbl-name
      784                                              ,input  p-bh_tbl-name
      785                                              ,output p-item) no-error .
      786         if not error-status:error then do:
      787           assign
      788           buf_cli-list-hist.item_ = p-item
      789           .
      790         end.
      791         else do:
      792           assign
      793           buf_cli-list-hist.item_ = "!ERROR"
      794           .
      795         end.
      796       end.
      797     end.
      798   end procedure.
      799   FUNCTION get-line-mode returns character(input p-hist-mode as character):
      800   case p-hist-mode:
      801     when '+':U then
      802       return  'ДОБАВЛЕНИЕ':U.
      803     when '-':U then
      804       return  'удаление':U.
      805     when '*':U then
      806       return  'ОСТАВИТЬ':U.
      807   end CASE.
      808   END FUNCTION.
      809   FUNCTION get-hist-mode returns character(input p-line-mode as character):
      810   case p-line-mode:
      811     when 'ДОБАВЛЕНИЕ':U then
      812       return  "+".
      813     when 'удаление':U then
      814       return  "-".
      815     when 'ОСТАВИТЬ':U then
      816       return  "*".
      817   end CASE.
      818   END FUNCTION.
      819   procedure proc-write-filter-expression :
      820   define input parameter p-filter-expression as character no-undo .
      821   define variable v-ii as integer no-undo .
      822   output to value(string(g#report-num) + ".whr").
      823   put .
      824   if num-entries(p-filter-expression) > 0 then do:
      825      put unformatted 'and ('.
      826      do v-ii = 1 to num-entries(p-filter-expression):
      827        put unformatted entry(v-ii, p-filter-expression) skip.
      828      end.
      829      put unformatted ')'.
      830   end.
      831   output close.
      832   end procedure.
      833   procedure proc-write-filter-expression-var :
      834   define input parameter p-filter-expression as character no-undo .
      835   define output parameter p-string as character no-undo .
      836   define variable v-ii as integer no-undo .
      837   if num-entries(p-filter-expression) > 0 then do:
      838      p-string = 'and ('.
      839      do v-ii = 1 to num-entries(p-filter-expression):
      840        p-string = p-string + entry(v-ii, p-filter-expression) + chr(10).
      841      end.
      842      p-string = p-string + ')'.
      843   end.
      844   end procedure.
      845   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      846   define variable c-point  as character no-undo .
      847   define variable tbl      as character no-undo .
      848   define variable join-tbl as character no-undo .
      849   define variable fld      as character no-undo .
      850   define variable lab      as character no-undo .
      851   define variable spr      as character no-undo .
      852   define variable dim      as character no-undo .
      853   function diff-list returns character (
      854     input parfirst-list  as character,
      855     input parsecond-list as character,
      856     input pardelim       as character).
      857     if pardelim = ""
      858     or pardelim = ?
      859     then do:
      860       assign
      861         pardelim = ","
      862       .
      863     end.
      864     def var ind as integer no-undo .
      865     def var v-elem as character no-undo .
      866     def var v-result-list as character no-undo init "".
      867     def var v-num-parfirst-list as integer no-undo .
      868     assign
      869       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      870     .
      871     do ind = 1 to v-num-parfirst-list
      872     :
      873       assign
      874         v-elem = entry(ind, parfirst-list, pardelim)
      875       .
      876       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      877         assign
      878           v-result-list = v-result-list
      879                         + (if v-result-list > "" then pardelim else "")
      880                         + v-elem
      881         .
      882       end.
      883     end.
      884     return v-result-list .
      885   end function.
      886   function add-list returns character (
      887    input parfirst-list  as character,
      888    input parsecond-list as character,
      889    input pardelim       as character).
      890     if pardelim = ""
      891     or pardelim = ?
      892     then do:
      893       assign
      894         pardelim = ","
      895       .
      896     end.
      897     def var ind as integer no-undo .
      898     def var v-elem as character no-undo .
      899     def var v-result-list as character no-undo init "".
      900     def var v-num-parfirst-list as integer no-undo .
      901     assign
      902       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      903     .
      904     do ind = 1 to v-num-parfirst-list
      905     :
      906       assign
      907         v-elem = entry(ind, parfirst-list, pardelim)
      908       .
      909       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      910         assign
      911           v-result-list = v-result-list
      912                         + (if v-result-list > "" then pardelim else "")
      913                         + v-elem
      914         .
      915       end.
      916     end.
      917     def var v-num-parsecond-list as integer no-undo .
      918     assign
      919       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      920     .
      921     do ind = 1 to v-num-parsecond-list
      922     :
      923       assign
      924         v-elem = entry(ind, parsecond-list, pardelim)
      925       .
      926       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      927         assign
      928           v-result-list = v-result-list
      929                         + (if v-result-list > "" then pardelim else "")
      930                         + v-elem
      931         .
      932       end.
      933     end.
      934     return v-result-list .
      935   end function.
      936   function cross-list returns character (
      937    input parfirst-list  as character,
      938    input parsecond-list as character,
      939    input pardelim       as character).
      940     if pardelim = ""
      941     or pardelim = ?
      942     then do:
      943       assign
      944         pardelim = ","
      945       .
      946     end.
      947     def var ind as integer no-undo .
      948     def var v-elem as character no-undo .
      949     def var v-result-list as character no-undo init "".
      950     def var v-num-parfirst-list as integer no-undo .
      951     assign
      952       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      953     .
      954     do ind = 1 to v-num-parfirst-list
      955     :
      956       assign
      957         v-elem = entry(ind, parfirst-list, pardelim)
      958       .
      959       if lookup(v-elem, v-result-list, pardelim) = 0
      960       and lookup(v-elem, parsecond-list, pardelim) > 0
      961       then do:
      962         assign
      963           v-result-list = v-result-list
      964                         + (if v-result-list > "" then pardelim else "")
      965                         + v-elem
      966         .
      967       end.
      968     end.
      969     return v-result-list .
      970   end function.
      971   function radio-label returns character (
      972    input par-rs-value  as character,
      973    input par-rs-radio-buttons as character)
      974    .
      975    DEFINE variable v-result-label as character no-undo.
      976    assign
      977    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      978                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      979                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      980                             ), par-rs-radio-buttons
      981                           )
      982    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      983    .
      984   return v-result-label.
      985   end function.
      986   function m-radio-label returns character (
      987    input par-rs-value  as character,
      988    input par-rs-radio-buttons as character,
      989    input par-delim as character
      990    )
      991    .
      992    DEFINE variable v-result-label as character no-undo.
      993    assign
      994    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      995                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      996                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      997                             ), par-rs-radio-buttons, par-delim
      998                           )
      999    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1000    .
     1001   return v-result-label.
     1002   end function.
     1003   FUNCTION mixlist returns character
     1004   (
     1005    input parfirst-list  as character
     1006    ,input parsecond-list as character
     1007    ,input pardelim       as character
     1008    ,input pardelim-result as character ) :
     1009     if pardelim = ""
     1010     or pardelim = ?
     1011     then do:
     1012       assign
     1013         pardelim = ","
     1014       .
     1015     end.
     1016     def var ind as integer no-undo .
     1017     def var v-elem1 as character no-undo .
     1018     def var v-elem2 as character no-undo .
     1019     def var v-result-list as character no-undo init "".
     1020     do ind = 1 to num-entries(parfirst-list, pardelim)
     1021     :
     1022       assign
     1023         v-elem1 = entry(ind, parfirst-list, pardelim)
     1024         v-elem2 = entry(ind, parsecond-list, pardelim)
     1025       .
     1026         assign
     1027           v-result-list = v-result-list
     1028                         + (if v-result-list > "" then pardelim-result else "")
     1029                         + v-elem1 + pardelim-result + v-elem2
     1030         .
     1031     end.
     1032     return v-result-list .
     1033   END FUNCTION.
