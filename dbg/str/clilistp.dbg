     5710      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     5711     if lookup("automain", parparentproc:file-name, ".") > 0 then do:
     5712       v-no-context = yes.
     5713     end.
     5714     else do:
     5715   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5716     run mainmenu_getcntxt in parparentproc
     5717       (output v-cntxt-db-num
     5718       ,output v-cntxt-userid
     5719       ,output v-cntxt-level
