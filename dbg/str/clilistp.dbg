     5787   RUN disable_UI in this-procedure .
     5788   procedure cb_fill-lob-res-list :
     5789   define input  parameter p-full-path as character no-undo .
     5790   output to value (p-full-path).
     5791   for each cli-list:
     5792     export
     5793     cli-list.obj-type
     5794     cli-list.obj-code.
     5795   end.
     5796   output close.
     5797   end procedure.
     5798   procedure cb_fill-lob-res-list-macro :
     5799   define input  parameter p-full-path as character no-undo .
     5800   define buffer buf_cli-list-hist for cli-list-hist.
     5801   output to value (p-full-path).
     5802   for each buf_cli-list-hist:
     5803       export
     5804       buf_cli-list-hist.
     5805   end.
     5806   output close.
     5807   end procedure.
     5808   procedure cb_get-next-cli-by-obj-type-code :
     5809   define input parameter p-obj-type as character no-undo .
     5810   define input parameter p-obj-code as integer no-undo .
     5811   define input parameter p-bh as handle no-undo .
     5812   define buffer buf_cli-list for cli-list.
     5813   find first buf_cli-list no-lock where
     5814             (buf_cli-list.obj-type = p-obj-type
     5815        and  buf_cli-list.obj-code = p-obj-code) no-error.
     5816   find next buf_cli-list use-index obj no-error.
     5817   if available buf_cli-list then do:
     5818     p-bh:buffer-create().
     5819     p-bh:buffer-copy(buffer buf_cli-list:handle).
     5820   end.
     5821   else do:
     5822   end.
     5823   end procedure.
     5824   PROCEDURE disable_UI :
     5825     HIDE FRAME Dialog-Frame.
     5826   END PROCEDURE.
     5827   PROCEDURE enable_UI :
     5828     DISPLAY dsp-rs NameOrCode n-c RS-Status ed-notes f-tot-lns
     5829         WITH FRAME Dialog-Frame.
     5830     ENABLE dsp-rs B-exit B-save B-print B-hist B-lkp B-clr B-Help B-add
     5831            B-del B-rest B-macro B-stop B-clear-macro B-record NameOrCode
     5832            n-c RS-Status BR-list ed-notes f-tot-lns
     5833         WITH FRAME Dialog-Frame.
     5834     VIEW FRAME Dialog-Frame.
     5835     OPEN QUERY BR-list FOR EACH cli-list NO-LOCK INDEXED-REPOSITION.     open query br-option for each temp-list no-lock .
     5836   END PROCEDURE.
     5837   procedure m_cli-save-db-proc :
     5838   define variable v-rid-list as character no-undo .
