     2941        SIZE 20 BY 1 TOOLTIP "Добавить в список клиентов 1 строку".
     2942   DEFINE BUTTON B-clear-macro
     2943        IMAGE-UP FILE "cmp/fstop.bmp":U
     2944        IMAGE-DOWN FILE "cmp/fstopi.bmp":U
     2945        IMAGE-INSENSITIVE FILE "cmp/fstopi.bmp":U
     2946        LABEL "&[ ]"
     2947        SIZE 4 BY 1.25 TOOLTIP "Удаление макроса формирования истории из памяти".
     2948   DEFINE BUTTON B-clr
     2949        LABEL "Очи&стить"
     2950        SIZE 10 BY 1 TOOLTIP "Удалить из списка всех клиентов".
     2951   DEFINE BUTTON B-del
     2952        LABEL "&-Удал. строку"
     2953        SIZE 20 BY 1 TOOLTIP "Удаленить из списка клиентов текукую строку".
     2954   DEFINE BUTTON B-exit AUTO-GO
     2955        LABEL "&Выход"
     2956        SIZE 10 BY 1 TOOLTIP "Выход из списка клиентов (передача списка другой программе)"
     2957        BGCOLOR 8 .
     2958   DEFINE BUTTON B-Help
     2959        LABEL "Помо&щь"
     2960        SIZE 10 BY 1
     2961        BGCOLOR 8 .
     2962   DEFINE BUTTON B-hist
     2963        LABEL "Ис&тория"
     2964        SIZE 10 BY 1 TOOLTIP "Последовательность шагов, приведшая к заполнению данного списка".
     2965   DEFINE BUTTON B-lkp
     2966        LABEL "&Просмотр"
     2967        SIZE 10 BY 1 TOOLTIP "Просмотр описания текущего клиента".
     2968   DEFINE BUTTON B-macro
     2969        IMAGE-UP FILE "cmp/run.bmp":U
     2970        IMAGE-DOWN FILE "cmp/runi.bmp":U
     2971        IMAGE-INSENSITIVE FILE "cmp/runi.bmp":U
     2972        LABEL "&>"
     2973        SIZE 4 BY 1.25 TOOLTIP "Выполнение макроса формирования истории".
     2974   DEFINE BUTTON B-print
     2975        LABEL "Пе&чать"
     2976        SIZE 10 BY 1.
     2977   DEFINE BUTTON B-record
     2978        IMAGE-UP FILE "cmp/record.bmp":U
     2979        IMAGE-DOWN FILE "cmp/recordi.bmp":U
     2980        IMAGE-INSENSITIVE FILE "cmp/recordi.bmp":U
     2981        LABEL "&o"
     2982        SIZE 4 BY 1.25 TOOLTIP "Запись макроса формирования истории".
     2983   DEFINE BUTTON B-rest
     2984        LABEL "&Оставить"
     2985        SIZE 20 BY 1 TOOLTIP "Оставить в списке только текущую строку".
     2986   DEFINE BUTTON B-save
     2987        LABEL "Со&хр/Вып."
     2988        SIZE 10 BY 1 TOOLTIP "Сохр. список клиентов в текст.файле, EXCEL; операции над списком".
     2989   DEFINE BUTTON B-stop
     2990        IMAGE-UP FILE "cmp/stop.bmp":U
     2991        IMAGE-DOWN FILE "cmp/stopi.bmp":U
     2992        IMAGE-INSENSITIVE FILE "cmp/stopi.bmp":U
     2993        LABEL "&[ ]"
     2994        SIZE 4 BY 1.25 TOOLTIP "Конец записи макроса формирования истории".
     2995   DEFINE VARIABLE ed-notes AS CHARACTER
     2996        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2997        SIZE 75.63 BY 1.54 NO-UNDO.
     2998   DEFINE VARIABLE dsp-rs AS CHARACTER FORMAT "X(256)":U
     2999         VIEW-AS TEXT
     3000        SIZE 75.5 BY 1 TOOLTIP "Строка текущего состояния списка"
     3001        FGCOLOR 4  NO-UNDO.
     3002   DEFINE VARIABLE f-tot-lns AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     3003         VIEW-AS TEXT
     3004        SIZE 10 BY .71 TOOLTIP "Кол. строк"
     3005        FGCOLOR 4  NO-UNDO.
     3006   DEFINE VARIABLE NameOrCode AS CHARACTER FORMAT "X(256)":U
     3007        VIEW-AS FILL-IN
     3008        SIZE 40.13 BY 1 NO-UNDO.
     3009   DEFINE VARIABLE n-c AS CHARACTER INITIAL "1"
     3010        VIEW-AS RADIO-SET HORIZONTAL
     3011        RADIO-BUTTONS
     3012             "Название", "1",
     3013   "Код", "2"
     3014        SIZE 23 BY .79 NO-UNDO.
     3015   DEFINE VARIABLE RS-Status AS CHARACTER
     3016        VIEW-AS RADIO-SET HORIZONTAL
     3017        RADIO-BUTTONS
     3018             "Item 1", "1",
     3019   "Item 2", "2",
     3020   "Item 3", "3"
     3021        SIZE 36.13 BY .75 NO-UNDO.
     3022   DEFINE QUERY BR-list FOR
     3023         cli-list SCROLLING.
     3024   DEFINE QUERY br-option FOR
     3025         temp-list SCROLLING.
     3026   DEFINE BROWSE BR-list
     3027     QUERY BR-list NO-LOCK DISPLAY
     3028         cli-list.obj-type
     3029         cli-list.obj-code
     3030         IF (cli-list.stts = 0) THEN (cli-list.obj-name)
     3031   ELSE (substring (cli-list.obj-name, 1, 25) +
     3032         FILL(chr(32), 25 -
     3033         LENGTH(substring (cli-list.obj-name, 1, 25)) ) +       '---  УДАЛЕН  ---':U) COLUMN-LABEL "Название" FORMAT "x(40)"
     3034         cli-list.grp-name FORMAT "X(60)"
     3035         cli-list.is-prod COLUMN-LABEL "Пр-ль" FORMAT "+/"
     3036         cli-list.sup-gds COLUMN-LABEL "Пост-к/т" FORMAT "+/"
     3037         cli-list.sup-cons COLUMN-LABEL "Пост-к/к" FORMAT "+/"
     3038         cli-list.buy-gds COLUMN-LABEL "Пок-ль/т" FORMAT "+/"
     3039         cli-list.buy-cons COLUMN-LABEL "Пок-ль/к" FORMAT "+/"
     3040         cli-list.buy-serv COLUMN-LABEL "Пок-ль/у" FORMAT "+/"
     3041         is-dis-cardc(cli-list.obj-type, cli-list.obj-code) COLUMN-LABEL "Дисконтная карта" FORMAT "X(16)"
     3042         is-cashierc(cli-list.obj-type, cli-list.obj-code) COLUMN-LABEL "Кассир" FORMAT "X(6)"
     3043         cli-list.db-num
     3044         is-sellerc(cli-list.obj-type, cli-list.obj-code) COLUMN-LABEL "Прод-ц" FORMAT "X(6)"
     3045       WITH NO-ROW-MARKERS SEPARATORS SIZE 79 BY 15.13.
     3046   DEFINE BROWSE BR-option
     3047     QUERY br-option DISPLAY
     3048         temp-list.fname format "X(40)"
     3049       WITH NO-LABELS NO-ROW-MARKERS SEPARATORS SIZE 29 BY 21 TOOLTIP "Условие для выбора клиентов, которые будут добавлены/удалены/оставле".
     3050   DEFINE FRAME Dialog-Frame
     3051        dsp-rs AT ROW 1 COL 1 NO-LABEL
     3052        br-option AT ROW 2 COL 80
     3053        B-exit AT ROW 2 COL 1
     3054        B-save AT ROW 2 COL 11
     3055        B-print AT ROW 2 COL 21
     3056        B-hist AT ROW 2 COL 31
     3057        B-lkp AT ROW 2 COL 41
     3058        B-clr AT ROW 2 COL 51
     3059        B-Help AT ROW 1 COL 61
     3060        B-add AT ROW 3 COL 11
     3061        B-del AT ROW 3 COL 31
     3062        B-rest AT ROW 3 COL 51
     3063        B-macro AT ROW 3 COL 71
     3064        B-stop AT ROW 3 COL 75
     3065        B-clear-macro AT ROW 3 COL 75
     3066        B-record AT ROW 3 COL 75
     3067        NameOrCode AT ROW 4.04 COL 34 COLON-ALIGNED NO-LABEL
     3068        n-c AT ROW 4.08 COL 2.38 NO-LABEL
     3069        RS-Status AT ROW 5 COL 3.25 NO-LABEL
     3070        f-tot-lns AT ROW 5 COL 66 COLON-ALIGNED NO-LABEL
     3071        BR-list AT ROW 6 COL 1.13
     3072        ed-notes AT ROW 21.38 COL 1 NO-LABEL
     3073        SPACE(23.00) SKIP(0.15)
     3074       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3075            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3076            TITLE "Список клиентов"
     3077            DEFAULT-BUTTON B-exit.
     3078   ASSIGN
     3079          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3080          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3081   ASSIGN
     3082          B-save:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-save:HANDLE.
     3083   ASSIGN
     3084          B-macro:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-play:HANDLE.
     3085   ASSIGN
     3086          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     3087   ASSIGN
     3088          ed-notes:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3089   on GO of frame Dialog-Frame do:
     3090     define variable glog as logical no-undo .
     3091     if lookup('list':U, bttns) > 0 then do:
     3092       message
     3093       "Хотите добавить/изменить хранимый список клиентов?"
     3094       view-as alert-box question
     3095       buttons yes-no update glog
     3096       .
     3097       if glog then do:
     3098         run m_cli-save-db-proc in this-procedure no-error.
     3099       end.
     3100     end.
     3101     if lookup('list-macro':U, bttns) > 0 then do:
     3102       message
     3103       "Хотите добавить/изменить хранимый макрос формирования списка клиентов?"
     3104       view-as alert-box question
     3105       buttons yes-no update glog
     3106       .
     3107       if glog then do:
     3108         run m-macros-save-db-proc in this-procedure no-error .
     3109       end.
     3110     end.
     3111   end.
     3112   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3113   DO:
     3114     APPLY "END-ERROR":U TO SELF.
     3115   END.
     3116   ON CHOOSE OF B-clr IN FRAME Dialog-Frame
     3117   DO:
     3118   define variable glog as logical no-undo .
     3119   define buffer buf-cli-list-hist for cli-list-hist.
     3120   glog = no.
     3121   message
     3122   "Удаление всех строк списка. Вы уверены ?"
     3123   view-as alert-box question buttons OK-Cancel update glog.
     3124   if not glog then return no-apply.
     3125   if session:set-wait-state( "COMPILER" )  then .
     3126   for each cli-list:
     3127     delete cli-list.
     3128   end.
     3129   if session:set-wait-state( "" )  then .
     3130   tot-lns = 0.
     3131   v-seq = 1.
     3132   for each buf-cli-list-hist:
     3133     delete buf-cli-list-hist.
     3134   end.
     3135   run create-cli-list-hist in this-procedure (
     3136                                          input 'ДОБАВЛЕНИЕ':U
     3137                                        , input-output v-seq
     3138                                        , input 0
     3139                                        , input '0':U
     3140                                        , input "# Список карт очищен."
     3141                                        , input 0
     3142                                        , input "clear"
     3143                                        , input '':U
     3144                                        , input '':U
     3145                                        , input '':U
     3146                                        , input ?
     3147                                        ).
     3148   ed-notes:screen-value = ''.
     3149   display
     3150   tot-lns @ f-tot-lns
     3151   with frame Dialog-Frame.
     3152   run MyEnable in this-procedure .
     3153   END.
     3154   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     3155   DO:
     3156   define buffer buf_cli-list-hist for cli-list-hist.
     3157   run prn-lib-open-stream  in this-procedure (
     3158                                                input parParentProc
     3159                                               ,input 43
     3160                                               ,input yes
     3161                                               ,input no
     3162                                               ).
     3163   find first buf_cli-list-hist no-lock where buf_cli-list-hist.id = 0 no-error .
     3164   PUT  STREAM PrnLibStream unformatted
     3165   SPACE(25) "История создания списка клиентов "
     3166   (if available buf_cli-list-hist
     3167   then buf_cli-list-hist.des
     3168   else "БЕЗЫМЯННЫЙ") skip(0)
     3169   space(25) cur-time-print() skip(1)
     3170   .
     3171   put stream PrnLibStream unformatted
     3172   string("№", "X(9)") chr(32)
     3173   string("Действие", "X(9)") chr(32)
     3174   string("записей", "X(9)") chr(32)
     3175   string(" = итого", "X(12)") chr(32)
     3176   string("Множество", "X(155)")
     3177   skip(0)
     3178   fill('-':U, 9) chr(32)
     3179   fill('-':U, 9) chr(32)
     3180   fill('-':U, 9) chr(32)
     3181   fill('-':U, 12) chr(32)
     3182   fill('-':U, 155)
     3183   skip(0)
     3184   .
     3185   for each buf_cli-list-hist where buf_cli-list-hist.id > 0
     3186   by buf_cli-list-hist.id
     3187   :
     3188     put stream PrnLibStream unformatted
     3189     (if buf_cli-list-hist.line = 0
     3190      then string(buf_cli-list-hist.id, ">>>>>>>>9")
     3191      else fill(chr(32) , 9)
     3192     )  chr(32)
     3193     (if buf_cli-list-hist.item_ <> '':U
     3194      then string(buf_cli-list-hist.hist-mode, "X(8)")
     3195      else fill( chr(32), 8)) chr(32)
     3196     string(buf_cli-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     3197     string(buf_cli-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     3198     string(buf_cli-list-hist.des, "X(155)") skip.
     3199   end.
     3200   output stream prnlibstream close.
     3201   run prn-lib-prn-file in this-procedure (
     3202                                             input parParentProc
     3203                                             ,input 8
     3204                                             ).
     3205   apply "entry" to br-list in frame Dialog-Frame.
     3206   END.
     3207   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     3208   DO:
     3209     if not available cli-list then do:
     3210     message "Неправильно выбран клиент."
     3211             view-as alert-box error.
     3212     return no-apply.
     3213   end.
     3214    run ref/showcli.p (
     3215                input parparentproc
     3216               ,input cli-list.obj-type
     3217               ,input cli-list.obj-code
     3218               ).
     3219    apply "entry" to br-list in frame Dialog-Frame.
     3220   END.
     3221   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     3222   DO:
     3223   define variable v-frame-width as integer no-undo.
     3224   if print-option = "" then do:
     3225       run gbl/pop-up.p ( input self:handle, input no) no-error.
     3226   end.
     3227   if print-option = "artic":U then do:
     3228     run str/cliartpr.p ( input parparentproc
     3229                    ,output v-frame-width ) no-error.
     3230   end.
     3231   else do:
     3232     run str/clil-prn.p ( input parparentproc
     3233                    ,input print-option
     3234                    ,output v-Frame-Width) no-error.
     3235   end.
     3236   print-option = "".
     3237   if v-frame-width <= 198 then do:
     3238     run prn-lib-prn-file in this-procedure (
     3239                                               input parParentProc
     3240                                               ,input (if v-frame-width <= 136 then 0 else 8)
     3241                                               ).
     3242   end.
     3243   else do:
     3244     run prn-lib-prn-file in this-procedure (
     3245                                               input parParentProc
     3246                                               ,input (if v-frame-width <= 255 then 1 else 20)
     3247                                               ).
     3248   end.
     3249   make-excel = no.
     3250   apply "entry" to br-list in frame Dialog-Frame.
     3251   END.
     3252   ON CHOOSE OF B-save IN FRAME Dialog-Frame
     3253   DO:
     3254     if save-option = "" then do:
     3255          run gbl/pop-up.p ( input self:handle, input no) no-error.
     3256      end.
     3257      run proc-b-save in this-procedure ( input save-option) no-error.
     3258      if error-status:error then return no-apply.
     3259   END.
     3260   ON VALUE-CHANGED OF BR-list IN FRAME Dialog-Frame
     3261   DO:
     3262       if avail cli-list then do:     assign ed-notes = cli-list.ps.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.   else do:     assign ed-notes = ''.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.
     3263   END.
     3264   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     3265   DO:
     3266     assign
     3267     Rs-list-method = temp-list.fvalue
     3268     .
     3269     run proc-vc-rs-list-method in this-procedure no-error .
     3270     if error-status:error then return no-apply.
     3271   END.
     3272   ON CHOOSE OF MENU-ITEM m_art-print
     3273   DO:
     3274     assign
     3275     print-option = "artic":U.
     3276     apply "choose" to b-print in frame Dialog-Frame.
     3277   END.
     3278   ON CHOOSE OF MENU-ITEM m_cli-save
     3279   DO:
     3280     assign
     3281     save-option = "cli-list":U.
     3282     apply "choose" to b-save in frame Dialog-Frame.
     3283   END.
     3284   ON CHOOSE OF MENU-ITEM m_cli-save-db
     3285   DO:
     3286     assign
     3287     save-option = "cli-list-db":U.
     3288     apply "choose" to b-save in frame Dialog-Frame.
     3289   END.
     3290   ON CHOOSE OF MENU-ITEM m-macros-save  DO:
     3291   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3292   if lookup(b-save :type in frame Dialog-Frame
     3293            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3294            ) = 0
     3295   then do:
     3296     message
     3297       "$Workfile$"
     3298       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3299       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3300       "Тип" self :type in frame Dialog-Frame skip
     3301       "Процедура" this-procedure :file-name skip
     3302       view-as alert-box .
     3303   end.
     3304   else do:
     3305     apply "entry":u to b-save in frame Dialog-Frame .
     3306     if focus :handle <> b-save :handle in frame Dialog-Frame then do:
     3307       return no-apply .
     3308     end.
     3309   end.
     3310   run proc-macros in this-procedure no-error .
     3311   if error-status:error then return no-apply.
     3312   END.
     3313   ON CHOOSE OF MENU-ITEM m-macros-save-db
     3314   DO:
     3315     assign
     3316     save-option = "cli-list-macros-db":U.
     3317     apply "choose" to b-save in frame Dialog-Frame.
     3318   END.
     3319   ON CHOOSE OF MENU-ITEM m_main-print
     3320   DO:
     3321     assign
     3322     print-option = "main":U.
     3323     apply "choose" to b-print in frame Dialog-Frame.
     3324   END.
     3325   ON CHOOSE OF MENU-ITEM m-rum  DO:
     3326   define variable glog as logical no-undo .
     3327   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3328   if lookup(b-save :type in frame Dialog-Frame
     3329            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3330            ) = 0
     3331   then do:
     3332     message
     3333       "$Workfile$"
     3334       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3335       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3336       "Тип" self :type in frame Dialog-Frame skip
     3337       "Процедура" this-procedure :file-name skip
     3338       view-as alert-box .
     3339   end.
     3340   else do:
     3341     apply "entry":u to b-save in frame Dialog-Frame .
     3342     if focus :handle <> b-save :handle in frame Dialog-Frame then do:
     3343       return no-apply .
     3344     end.
     3345   end.
     3346   run str/diallog.w (
     3347         input parParentProc
     3348       , input this-procedure
     3349       , input "utl/thbjrumr.w":U
     3350       , input 'clients':U + chr(4) +
     3351               ('batchwork-export':U + chr(44) + 'batchwork-routing':U)
     3352       , input no
     3353       , input "&Стоп"
     3354       , input substitute("Операции над списком клиентов") ) .
     3355   END.
     3356   ON CHOOSE OF MENU-ITEM m_sel-print
     3357   DO:
     3358     assign
     3359     print-option = "extended":U.
     3360     apply "choose" to b-print in frame Dialog-Frame.
     3361   END.
     3362   ON CHOOSE OF MENU-ITEM m-title-save
     3363   DO:
     3364   define variable v-value as character no-undo .
     3365     run gbl/d-prompt.w (
     3366         'title=':u + "Введите ИМЯ СПИСКА КАРТ" + '\':u
     3367       + 'format=' + "X(60)" + '\':u
     3368       + 'type=' + 'C':U + '\':u
     3369       + 'fillin_row=2\':u
     3370       + 'fillin_col=4\':u
     3371       + 'fillin_width=60\':u
     3372       + 'fillin_height=1\':u
     3373       + 'max-chars=60\':u
     3374       + 'readonly=no\':u
     3375       , input-output v-value
     3376       ).
     3377   if return-value = 'false':u then return NO-apply.
     3378   run create-cli-list-hist in this-procedure (
     3379                                          input 'title'
     3380                                        , input-output v-seq
     3381                                        , input 0
     3382                                        , input 'N':U
     3383                                        , input v-value
     3384                                        , input tot-lns
     3385                                        , input "title"
     3386                                        , input '':U
     3387                                        , input '':U
     3388                                        , input '':U
     3389                                        , input ?
     3390                                        ).
     3391   assign
     3392   frame Dialog-Frame:title = substitute("СПИСОК  КАРТ &1", v-value).
     3393   END.
     3394   ON CHOOSE OF MENU-ITEM m_xls-save
     3395   DO:
     3396     assign
     3397     save-option = "excel":U.
     3398     apply "choose" to b-save in frame Dialog-Frame.
     3399   END.
     3400   ON VALUE-CHANGED OF n-c IN FRAME Dialog-Frame
     3401   DO:
     3402       define variable loc#log as logical no-undo.
     3403       if can-do( 'код':U, n-c ) then do:
     3404           assign
     3405               NameOrCode:width-chars = 10
     3406               NameOrCode:format = "x(9)" .
     3407       end.
     3408       else do:
     3409           assign
     3410               NameOrCode:width-chars = 34.63
     3411               NameOrCode:format = "X(40)" .
     3412       end.
     3413       if nameorcode:visible in frame Dialog-Frame then
     3414       apply "entry" to NameOrCode in frame Dialog-Frame .
     3415   END.
     3416   ON CTRL-J OF NameOrCode IN FRAME Dialog-Frame
     3417   DO:
     3418     assign
     3419     n-c
     3420     nameorcode.
     3421     run proc-find-nameorcode in this-procedure no-error.
     3422     if error-status:error then do:
     3423       return no-apply.
     3424     end.
     3425   END.
     3426   ON RETURN OF NameOrCode IN FRAME Dialog-Frame
     3427   DO:
     3428     assign
     3429     n-c
     3430     nameorcode.
     3431     run proc-find-nameorcode in this-procedure no-error.
     3432     if error-status:error then do:
     3433       return no-apply.
     3434     end.
     3435   END.
     3436   ON VALUE-CHANGED OF RS-Status IN FRAME Dialog-Frame
     3437   DO:
     3438     assign
     3439     RS-status.
     3440   END.
     3441   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3442   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     3443     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     3444     return no-apply.
     3445   end.
     3446   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3447   on F3 of frame Dialog-Frame anywhere do:
     3448     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     3449     return no-apply.
     3450   end.
     3451   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3452   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     3453     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     3454     return no-apply.
     3455   end.
     3456   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3457   on F8 of frame Dialog-Frame anywhere do:
     3458     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     3459     return no-apply.
     3460   end.
     3461   ON RETURN, MOUSE-SELECT-DBLCLICK OF br-list IN FRAME Dialog-Frame DO:
     3462       apply "choose" to b-lkp in frame Dialog-Frame.
     3463   END.
     3464   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3465   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3466   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3467   on help of frame Dialog-Frame
     3468   do:
     3469     run gbl/app_help.p
     3470       (input this-procedure :file-name
     3471       ,input ''
     3472       ,input ?
     3473       ) no-error.
     3474     if error-status :error then do:
     3475       message
     3476         "Ошибка при вызове помощи"
     3477         error-status :get-message(1)
     3478         view-as alert-box .
     3479     end.
     3480   end.
     3481   run minbtn-set in this-procedure .
     3482   on choose of b-help in frame Dialog-Frame
     3483   do:
     3484     apply "help":u to frame Dialog-Frame .
     3485   end.
     3486   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3487   procedure minbtn-set :
     3488       do
     3489           on error undo, return error return-value
     3490           :
     3491           define variable ii              as integer       no-undo .
     3492           define variable fh              as widget-handle no-undo .
     3493           define variable hh              as widget-handle no-undo .
     3494           define variable v-h             as handle        extent 4 no-undo .
     3495           define variable v-name-button   as character     no-undo .
     3496           define variable v-help-old-x    as decimal       no-undo .
     3497           define variable v-help-old-y    as decimal       no-undo .
     3498           define variable v-help-old-size as decimal       no-undo .
     3499           define variable v-frame-width   as decimal       no-undo .
     3500           define variable jj              as integer       no-undo .
     3501           do
     3502               on error undo, return error
     3503               :
     3504               assign
     3505                   v-frame-width = frame Dialog-Frame:width - 0.3
     3506                   fh            = frame Dialog-Frame:first-child
     3507                   hh            = fh:first-child
     3508                   ii            = 1
     3509                   .
     3510               do while valid-handle(hh):
     3511                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3512                   do:
     3513                       case lc(hh:name) :
     3514                           when "b-help" then
     3515                               do:
     3516                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3517                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3518                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3519                                   hh:TOOLTIP = "Помощь" .
     3520                                   v-help-old-x = hh:column .
     3521                                   v-help-old-y = hh:row    .
     3522                                   v-help-old-size = hh:width .
     3523                                   hh:width-chars = 2.5 .
     3524                               end.
     3525                           when "b-print" then
     3526                               do:
     3527                                   hh:load-image("cmp/b-print.bmp":u) .
     3528                                   hh:TOOLTIP = "Печать" .
     3529                                   v-h[ii] = hh:handle .
     3530                                   ii = ii + 1 .
     3531                                   hh:width-chars = 3 .
     3532                               end.
     3533                           when "b-history" or
     3534                           when "b-hist" then
     3535                               do:
     3536                                   hh:load-image("cmp/b-hist.bmp":u) .
     3537                                   hh:TOOLTIP = "История" .
     3538                                   v-h[ii] = hh:handle .
     3539                                   ii = ii + 1 .
     3540                                   hh:width-chars = 3 .
     3541                               end.
     3542                           when "b-sch" then
     3543                               do:
     3544                                   hh:load-image("cmp/b-sch.bmp":u) .
     3545                                   hh:TOOLTIP = "Установка Фильтра" .
     3546                                   v-h[ii] = hh:handle .
     3547                                   ii = ii + 1 .
     3548                                   hh:width-chars = 3 .
     3549                               end.
     3550                           when "b-hist-user" then
     3551                               do:
     3552                                   hh:load-image("cmp/b-hist.bmp":u) .
     3553                                   hh:TOOLTIP = "История пользователя" .
     3554                                   ii = ii + 1 .
     3555                               end.
     3556                       end case.
     3557                   end.
     3558                   hh = hh:next-sibling.
     3559               end.
     3560               b-help:column = v-frame-width - b-help:width-chars.
     3561               jj = 0.
     3562               repeat ii = 4 to 1 by -1 :
     3563                   if valid-handle (v-h[ii] ) then
     3564                   do:
     3565                       jj  = jj + 1 .
     3566                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3567                       v-h[ii]:row    = v-help-old-y .
     3568                   end.
     3569               end.
     3570           end.
     3571       end.
     3572   end procedure.
     3573   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3574   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3575   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3576   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3577   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3578   define variable v-diasize-current-frame-height as decimal   no-undo .
     3579   define variable v-diasize-change-size          as logical   no-undo .
     3580   define variable v-diasize-resize-button        as handle    no-undo .
     3581   define variable v-diasize-wndmax               as logical   no-undo .
     3582   define variable v-diasize-wndstore             as logical   no-undo .
     3583   define variable v-diasize-proc-name            as character no-undo .
     3584   define variable v-diasize-browse-handle        as handle    no-undo .
     3585   define variable v-diasize-browse-number        as integer   no-undo .
     3586   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3587   define temp-table temp-diasize-handle no-undo
     3588     field handle-value  as handle
     3589     field save-position as decimal
     3590     index xpk is primary unique handle-value
     3591     .
     3592   define temp-table temp-browse-handle no-undo
     3593     field browse-type   as character
     3594     field browse-number as integer
     3595     field browse-handle as handle
     3596     field original-size as decimal
     3597     index xpk is primary unique browse-type browse-number
     3598     index xie browse-type browse-handle
     3599   .
     3600   procedure diasize_change-height :
     3601     define input  parameter p-change-value  as decimal   no-undo .
     3602     define input  parameter p-move-resize   as logical   no-undo .
     3603     define variable v-field-group-handle    as handle    no-undo .
     3604     define variable v-object-handle         as handle    no-undo .
     3605     define variable v-frame-height          as decimal   no-undo .
     3606     define variable v-frame-virtual-height  as decimal   no-undo .
     3607     define variable v-browse-height         as decimal   no-undo .
     3608     define variable v-window-height         as decimal   no-undo .
     3609     define variable v-window-virtual-height as decimal   no-undo .
     3610     define variable v-change-sign           as integer   no-undo .
     3611     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3612     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3613     if p-change-value > 0
     3614     then do:
     3615       if frame Dialog-Frame :height + p-change-value
     3616           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3617       then do:
     3618         assign
     3619           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3620                           - (frame Dialog-Frame :height-chars)
     3621         .
     3622         if p-change-value <= 0
     3623         then do:
     3624           run diasize_position-resize-button in this-procedure .
     3625           return .
     3626         end.
     3627       end.
     3628     end.
     3629     if p-change-value < 0
     3630     then do:
     3631       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3632       then do:
     3633         assign
     3634           p-change-value = v-diasize-orig-frame-height
     3635                          - (frame Dialog-Frame :height-chars)
     3636         .
     3637         if p-change-value >= 0
     3638         then do:
     3639           run diasize_position-resize-button in this-procedure .
     3640           return .
     3641         end.
     3642       end.
     3643     end.
     3644     if p-change-value >= 0
     3645     then do:
     3646       assign
     3647         v-change-sign = 1
     3648       .
     3649     end.
     3650     else do:
     3651       assign
     3652         v-change-sign = -1
     3653       .
     3654     end.
     3655     assign
     3656       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3657     .
     3658     if p-change-value = 0
     3659     then do:
     3660       run diasize_position-resize-button in this-procedure .
     3661       return .
     3662     end.
     3663     move_block:
     3664     do
     3665     on error undo move_block, retry move_block
     3666     :
     3667       if retry
     3668       then do:
     3669         do
     3670         on error undo move_block, leave move_block
     3671         :
     3672           if p-change-value > 0
     3673           then do:
     3674             for each buf_temp-diasize-handle
     3675             on error undo, next
     3676             :
     3677               assign
     3678                 v-object-handle = buf_temp-diasize-handle.handle-value
     3679               .
     3680               if v-object-handle <> v-diasize-resize-button
     3681               then do:
     3682                 assign
     3683                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3684                 .
     3685               end.
     3686             end.
     3687             assign
     3688               v-diasize-browse-handle :height = v-browse-height
     3689             .
     3690             for each buf_temp-browse-handle
     3691               where buf_temp-browse-handle.browse-type = 'height':u
     3692             on error undo, next
     3693             :
     3694               assign
     3695                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3696               .
     3697             end.
     3698             assign
     3699               frame Dialog-Frame :height = v-frame-height
     3700             .
     3701             if frame Dialog-Frame :scrollable = true
     3702             then do:
     3703               assign
     3704                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3705               .
     3706             end.
     3707             run diasize_position-resize-button in this-procedure .
     3708           end.
     3709           else do:
     3710             if frame Dialog-Frame :scrollable = true
     3711             then do:
     3712               assign
     3713                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3714               .
     3715             end.
     3716             assign
     3717               frame Dialog-Frame :height = v-frame-height
     3718             .
     3719             assign
     3720               v-diasize-browse-handle :height = v-browse-height
     3721             .
     3722             for each buf_temp-browse-handle
     3723               where buf_temp-browse-handle.browse-type = 'height':u
     3724             on error undo, next
     3725             :
     3726               assign
     3727                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3728               .
     3729             end.
     3730             for each buf_temp-diasize-handle
     3731             on error undo, next
     3732             :
     3733               assign
     3734                 v-object-handle = buf_temp-diasize-handle.handle-value
     3735               .
     3736               if v-object-handle <> v-diasize-resize-button
     3737               then do:
     3738                 assign
     3739                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3740                 .
     3741               end.
     3742             end.
     3743             run diasize_position-resize-button in this-procedure .
     3744           end.
     3745           assign
     3746             v-diasize-change-size = false
     3747           .
     3748           leave move_block .
     3749         end.
     3750       end.
     3751       assign
     3752         v-diasize-need-full-display = true
     3753       .
     3754       if v-diasize-change-size = false
     3755       then do:
     3756         assign
     3757           v-diasize-change-size = true
     3758         .
     3759       end.
     3760       else do:
     3761         return .
     3762       end.
     3763       assign
     3764         v-frame-height = frame Dialog-Frame :height
     3765         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3766         v-browse-height = v-diasize-browse-handle :height
     3767       .
     3768       for each buf_temp-browse-handle
     3769         where buf_temp-browse-handle.browse-type = 'height':u
     3770       :
     3771         assign
     3772           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3773         .
     3774       end.
     3775       for each buf_temp-diasize-handle
     3776       :
     3777         delete buf_temp-diasize-handle .
     3778       end.
     3779       assign
     3780         v-field-group-handle = frame Dialog-Frame :first-child
     3781       .
     3782       do while valid-handle(v-field-group-handle)
     3783       :
     3784         assign
     3785           v-object-handle = v-field-group-handle :first-child
     3786         .
     3787         do while valid-handle(v-object-handle)
     3788         :
     3789           if  v-object-handle <> v-diasize-browse-handle :handle
     3790           and can-query(v-object-handle, "row")
     3791           and can-query(v-object-handle, "height")
     3792           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3793           then do:
     3794             find first buf_temp-browse-handle
     3795               where buf_temp-browse-handle.browse-type   = 'height':u
     3796                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3797               no-error .
     3798             if available buf_temp-browse-handle
     3799             then do:
     3800             end.
     3801             else do:
     3802               create buf_temp-diasize-handle .
     3803               assign
     3804                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3805                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3806               .
     3807             end.
     3808           end.
     3809           assign
     3810             v-object-handle = v-object-handle :next-sibling
     3811           .
     3812         end.
     3813         assign
     3814           v-field-group-handle = v-field-group-handle :next-sibling
     3815         .
     3816       end.
     3817       do with frame Dialog-Frame
     3818       :
     3819         hide v-diasize-resize-button .
     3820         assign
     3821           v-diasize-resize-button :row    = 1
     3822           v-diasize-resize-button :column = 1
     3823         .
     3824       end.
     3825       if p-change-value > 0
     3826       then do:
     3827         if frame Dialog-Frame :scrollable = true
     3828         then do:
     3829           assign
     3830             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3831             no-error .
     3832           if error-status :error
     3833           or error-status :get-message(1) <> ""
     3834           then do:
     3835             undo move_block, retry move_block .
     3836           end.
     3837         end.
     3838         assign
     3839           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3840           no-error .
     3841         if error-status :error
     3842         or error-status :get-message(1) <> ""
     3843         then do:
     3844           undo move_block, retry move_block .
     3845         end.
     3846         assign
     3847           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3848           no-error .
     3849         if error-status :error
     3850         or error-status :get-message(1) <> ""
     3851         then do:
     3852           undo move_block, retry move_block .
     3853         end.
     3854         for each buf_temp-browse-handle
     3855           where buf_temp-browse-handle.browse-type = 'height':u
     3856         on error undo move_block, retry move_block
     3857         :
     3858           assign
     3859             buf_temp-browse-handle.browse-handle :height
     3860               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3861             no-error .
     3862           if error-status :error
     3863           or error-status :get-message(1) <> ""
     3864           then do:
     3865             undo move_block, retry move_block .
     3866           end.
     3867         end.
     3868         for each buf_temp-diasize-handle
     3869         on error undo move_block, retry move_block
     3870         :
     3871           assign
     3872             v-object-handle = buf_temp-diasize-handle.handle-value
     3873           .
     3874           if v-object-handle <> v-diasize-resize-button
     3875           then do:
     3876             assign
     3877               v-object-handle :row = v-object-handle :row + p-change-value
     3878               no-error .
     3879             if error-status :error
     3880             or error-status :get-message(1) <> ""
     3881             then do:
     3882               undo move_block, retry move_block .
     3883             end.
     3884           end.
     3885         end.
     3886       end.
     3887       else do:
     3888         for each buf_temp-diasize-handle
     3889         on error undo move_block, retry move_block
     3890         :
     3891           assign
     3892             v-object-handle = buf_temp-diasize-handle.handle-value
     3893           .
     3894           if v-object-handle <> v-diasize-resize-button
     3895           then do:
     3896             assign
     3897               v-object-handle :row = v-object-handle :row + p-change-value
     3898               no-error .
     3899             if error-status :error
     3900             or error-status :get-message(1) <> ""
     3901             then do:
     3902               undo move_block, retry move_block .
     3903             end.
     3904           end.
     3905         end.
     3906         assign
     3907           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3908           no-error .
     3909         if error-status :error
     3910         or error-status :get-message(1) <> ""
     3911         then do:
     3912           undo move_block, retry move_block .
     3913         end.
     3914         for each buf_temp-browse-handle
     3915           where buf_temp-browse-handle.browse-type = 'height':u
     3916         on error undo move_block, retry move_block
     3917         :
     3918           assign
     3919             buf_temp-browse-handle.browse-handle :height
     3920               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3921             no-error .
     3922           if error-status :error
     3923           or error-status :get-message(1) <> ""
     3924           then do:
     3925             undo move_block, retry move_block .
     3926           end.
     3927         end.
     3928         assign
     3929           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3930           no-error .
     3931         if error-status :error
     3932         or error-status :get-message(1) <> ""
     3933         then do:
     3934           undo move_block, retry move_block .
     3935         end.
     3936         if frame Dialog-Frame :scrollable = true
     3937         then do:
     3938           assign
     3939             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3940             no-error .
     3941           if error-status :error
     3942           or error-status :get-message(1) <> ""
     3943           then do:
     3944             undo move_block, retry move_block .
     3945           end.
     3946         end.
     3947       end.
     3948       if p-move-resize = true
     3949       then do:
     3950         run diasize_position-resize-button in this-procedure .
     3951       end.
     3952       if v-diasize-wndstore = true
     3953       then do:
     3954         if connected("ub") = true
     3955         then do:
     3956           define variable v-cntxt-db-num        as integer   no-undo .
     3957           define variable v-cntxt-userid        as character no-undo .
     3958           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3959                                             , OUTPUT v-cntxt-userid
     3960                                             ) .
     3961           run gbl/wndsizew.p
     3962             (input  v-cntxt-db-num
     3963             ,input  v-cntxt-userid
     3964             ,input  v-diasize-proc-name
     3965             ,input  'height':u
     3966             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3967             ) .
     3968         end.
     3969       end.
     3970     end.
     3971     assign
     3972       v-diasize-change-size = false
     3973     .
     3974   end procedure.
     3975   procedure diasize_set-height :
     3976     define input  parameter p-new-height  as decimal   no-undo .
     3977     define input  parameter p-move-resize as logical   no-undo .
     3978     do
     3979     on error undo, return error return-value
     3980     :
     3981       run diasize_change-height in this-procedure
     3982         (input  (p-new-height - frame Dialog-Frame :height)
     3983         ,input  p-move-resize
     3984         ) .
     3985     end.
     3986   end procedure.
     3987   procedure diasize_change-width :
     3988     define input  parameter p-change-value as decimal   no-undo .
     3989     define input  parameter p-move-resize  as logical   no-undo .
     3990     define variable v-field-group-handle   as handle    no-undo .
     3991     define variable v-object-handle        as handle    no-undo .
     3992     define variable v-frame-width          as decimal   no-undo .
     3993     define variable v-frame-virtual-width  as decimal   no-undo .
     3994     define variable v-browse-width         as decimal   no-undo .
     3995     define variable v-window-width         as decimal   no-undo .
     3996     define variable v-window-virtual-width as decimal   no-undo .
     3997     define variable v-change-sign          as integer   no-undo .
     3998     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3999     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4000     if p-change-value > 0
     4001     then do:
     4002       if frame Dialog-Frame :width + p-change-value >
     4003           session :width-chars
     4004       then do:
     4005         assign
     4006           p-change-value = session :width-chars - frame Dialog-Frame :width
     4007         .
     4008         if p-change-value <= 0
     4009         then do:
     4010           run diasize_position-resize-button in this-procedure .
     4011           return .
     4012         end.
     4013       end.
     4014     end.
     4015     if p-change-value < 0
     4016     then do:
     4017       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     4018       then do:
     4019         assign
     4020           p-change-value = v-diasize-orig-frame-width
     4021                          - frame Dialog-Frame :width
     4022         .
     4023         if p-change-value >= 0
     4024         then do:
     4025           run diasize_position-resize-button in this-procedure .
     4026           return .
     4027         end.
     4028       end.
     4029     end.
     4030     if p-change-value >= 0
     4031     then do:
     4032       assign
     4033         v-change-sign = 1
     4034       .
     4035     end.
     4036     else do:
     4037       assign
     4038         v-change-sign = -1
     4039       .
     4040     end.
     4041     assign
     4042       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4043     .
     4044     if p-change-value = 0
     4045     then do:
     4046       run diasize_position-resize-button in this-procedure .
     4047       return .
     4048     end.
     4049     move_block:
     4050     do
     4051     on error undo move_block, leave move_block
     4052     :
     4053       if retry
     4054       then do:
     4055         do
     4056         on error undo move_block, leave move_block
     4057         :
     4058           if p-change-value > 0
     4059           then do:
     4060             for each buf_temp-diasize-handle
     4061             on error undo, next
     4062             :
     4063               assign
     4064                 v-object-handle = buf_temp-diasize-handle.handle-value
     4065               .
     4066               if v-object-handle <> v-diasize-resize-button
     4067               then do:
     4068                 assign
     4069                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4070                 .
     4071               end.
     4072             end.
     4073             assign
     4074               v-diasize-browse-handle :width = v-browse-width
     4075             .
     4076             for each buf_temp-browse-handle
     4077               where buf_temp-browse-handle.browse-type = 'width':u
     4078             on error undo, next
     4079             :
     4080               assign
     4081                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4082               .
     4083             end.
     4084             assign
     4085               frame Dialog-Frame :width = v-frame-width
     4086             .
     4087             if frame Dialog-Frame :scrollable = true
     4088             then do:
     4089               assign
     4090                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4091               .
     4092             end.
     4093             run diasize_position-resize-button in this-procedure .
     4094           end.
     4095           else do:
     4096             if frame Dialog-Frame :scrollable = true
     4097             then do:
     4098               assign
     4099                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4100               .
     4101             end.
     4102             assign
     4103               frame Dialog-Frame :width = v-frame-width
     4104             .
     4105             for each buf_temp-browse-handle
     4106               where buf_temp-browse-handle.browse-type = 'width':u
     4107             on error undo, next
     4108             :
     4109               assign
     4110                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4111               .
     4112             end.
     4113             assign
     4114               v-diasize-browse-handle :width = v-browse-width
     4115             .
     4116             for each buf_temp-diasize-handle
     4117             on error undo, next
     4118             :
     4119               assign
     4120                 v-object-handle = buf_temp-diasize-handle.handle-value
     4121               .
     4122               if v-object-handle <> v-diasize-resize-button
     4123               then do:
     4124                 assign
     4125                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4126                 .
     4127               end.
     4128             end.
     4129             run diasize_position-resize-button in this-procedure .
     4130           end.
     4131           assign
     4132             v-diasize-change-size = false
     4133           .
     4134           leave move_block .
     4135         end.
     4136       end.
     4137       assign
     4138         v-diasize-need-full-display = true
     4139       .
     4140       if v-diasize-change-size = false
     4141       then do:
     4142         assign
     4143           v-diasize-change-size = true
     4144         .
     4145       end.
     4146       else do:
     4147         return .
     4148       end.
     4149       assign
     4150         v-frame-width = frame Dialog-Frame :width
     4151         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     4152         v-browse-width = v-diasize-browse-handle :width
     4153       .
     4154       for each buf_temp-browse-handle
     4155         where buf_temp-browse-handle.browse-type = 'width':u
     4156       :
     4157         assign
     4158           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     4159         .
     4160       end.
     4161       for each buf_temp-diasize-handle
     4162       :
     4163         delete buf_temp-diasize-handle .
     4164       end.
     4165       assign
     4166         v-field-group-handle = frame Dialog-Frame :first-child
     4167       .
     4168       do while valid-handle(v-field-group-handle)
     4169       :
     4170         assign
     4171           v-object-handle = v-field-group-handle :first-child
     4172         .
     4173         do while valid-handle(v-object-handle)
     4174         :
     4175           if  v-object-handle <> v-diasize-browse-handle :handle
     4176           and v-object-handle <> v-diasize-resize-button
     4177           and can-query(v-object-handle, "row")
     4178           and can-query(v-object-handle, "height")
     4179           and ( v-object-handle :col + v-object-handle :width
     4180                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     4181               )
     4182           then do:
     4183             find first buf_temp-browse-handle
     4184               where buf_temp-browse-handle.browse-type   = 'width':u
     4185                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4186               no-error .
     4187             if available buf_temp-browse-handle
     4188             then do:
     4189             end.
     4190             else do:
     4191               create buf_temp-diasize-handle .
     4192               assign
     4193                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4194                 buf_temp-diasize-handle.save-position = v-object-handle :col
     4195               .
     4196             end.
     4197           end.
     4198           assign
     4199             v-object-handle = v-object-handle :next-sibling
     4200           .
     4201         end.
     4202         assign
     4203           v-field-group-handle = v-field-group-handle :next-sibling
     4204         .
     4205       end.
     4206       do with frame Dialog-Frame
     4207       :
     4208         hide v-diasize-resize-button .
     4209         v-diasize-resize-button :row = 1.
     4210         v-diasize-resize-button :column = 1.
     4211       end.
     4212       if p-change-value > 0
     4213       then do:
     4214         if frame Dialog-Frame :scrollable = true
     4215         then do:
     4216           assign
     4217             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4218             no-error .
     4219           if error-status :error
     4220           or error-status :get-message(1) <> ""
     4221           then do:
     4222             undo move_block, retry move_block.
     4223           end.
     4224         end.
     4225         assign
     4226           frame Dialog-Frame :width = v-frame-width + p-change-value
     4227           no-error .
     4228         if error-status :error
     4229         or error-status :get-message(1) <> ""
     4230         then do:
     4231           undo move_block, retry move_block.
     4232         end.
     4233         assign
     4234           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4235         no-error .
     4236         if error-status :error
     4237         or error-status :get-message(1) <> ""
     4238         then do:
     4239           undo move_block, retry move_block.
     4240         end.
     4241         for each buf_temp-browse-handle
     4242           where buf_temp-browse-handle.browse-type = 'width':u
     4243         on error undo move_block, retry move_block
     4244         :
     4245           assign
     4246             buf_temp-browse-handle.browse-handle :width
     4247               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4248             no-error .
     4249           if error-status :error
     4250           or error-status :get-message(1) <> ""
     4251           then do:
     4252             undo move_block, retry move_block .
     4253           end.
     4254         end.
     4255         for each buf_temp-diasize-handle
     4256         on error undo move_block, retry move_block
     4257         :
     4258           assign
     4259             v-object-handle = buf_temp-diasize-handle.handle-value
     4260           .
     4261           if v-object-handle <> v-diasize-resize-button
     4262           then do:
     4263             assign
     4264               v-object-handle :col = v-object-handle :col + p-change-value
     4265               no-error .
     4266             if error-status :error
     4267             or error-status :get-message(1) <> ""
     4268             then do:
     4269               undo move_block, retry move_block .
     4270             end.
     4271           end.
     4272         end.
     4273       end.
     4274       else do:
     4275         for each buf_temp-diasize-handle
     4276         on error undo move_block, retry move_block
     4277         :
     4278           assign
     4279             v-object-handle = buf_temp-diasize-handle.handle-value
     4280           .
     4281           if v-object-handle <> v-diasize-resize-button
     4282           then do:
     4283             assign
     4284               v-object-handle :col = v-object-handle :col + p-change-value
     4285               no-error .
     4286             if error-status :error
     4287             or error-status :get-message(1) <> ""
     4288             then do:
     4289               undo move_block, retry move_block .
     4290             end.
     4291           end.
     4292         end.
     4293         for each buf_temp-browse-handle
     4294           where buf_temp-browse-handle.browse-type = 'width':u
     4295         on error undo move_block, retry move_block
     4296         :
     4297           assign
     4298             buf_temp-browse-handle.browse-handle :width
     4299               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4300             no-error .
     4301           if error-status :error
     4302           or error-status :get-message(1) <> ""
     4303           then do:
     4304             undo move_block, retry move_block .
     4305           end.
     4306         end.
     4307         assign
     4308           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4309           no-error .
     4310         if error-status :error
     4311         or error-status :get-message(1) <> ""
     4312         then do:
     4313           undo move_block, retry move_block.
     4314         end.
     4315         assign
     4316           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4317         no-error .
     4318         if error-status :error
     4319         or error-status :get-message(1) <> ""
     4320         then do:
     4321           undo move_block, retry move_block.
     4322         end.
     4323         if frame Dialog-Frame :scrollable = true
     4324         then do:
     4325           assign
     4326             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4327           no-error .
     4328           if error-status :error
     4329           or error-status :get-message(1) <> ""
     4330           then do:
     4331             undo move_block, retry move_block.
     4332           end.
     4333         end.
     4334       end.
     4335       if p-move-resize
     4336       then do:
     4337         run diasize_position-resize-button in this-procedure .
     4338       end.
     4339       if v-diasize-wndstore = true
     4340       then do:
     4341         if connected("ub") = true
     4342         then do:
     4343           define variable v-cntxt-db-num        as integer   no-undo .
     4344           define variable v-cntxt-userid        as character no-undo .
     4345           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4346                                             , OUTPUT v-cntxt-userid
     4347                                             ) .
     4348           run gbl/wndsizew.p
     4349             (input  v-cntxt-db-num
     4350             ,input  v-cntxt-userid
     4351             ,input  v-diasize-proc-name
     4352             ,input  'width':u
     4353             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4354             ) .
     4355         end.
     4356       end.
     4357     end.
     4358     assign
     4359       v-diasize-change-size = false
     4360     .
     4361   end procedure.
     4362   procedure diasize_set-width :
     4363     define input  parameter p-new-width  as decimal   no-undo .
     4364     define input  parameter p-move-resize as logical   no-undo .
     4365     do
     4366     on error undo, return error return-value
     4367     :
     4368       run diasize_change-width in this-procedure
     4369         (input  (p-new-width - frame Dialog-Frame :width)
     4370         ,input  p-move-resize
     4371         ) .
     4372     end.
     4373   end procedure.
     4374   procedure diasize_position-resize-button :
     4375     do with frame Dialog-Frame
     4376     :
     4377       hide v-diasize-resize-button .
     4378       assign
     4379         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4380                     - 1
     4381                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4382         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4383                     - 1
     4384                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4385       .
     4386       view v-diasize-resize-button .
     4387     end.
     4388   end procedure.
     4389   on alt-right anywhere
     4390   do:
     4391     run diasize_change-width in this-procedure
     4392       (input 1
     4393       ,input true
     4394       ) .
     4395     return no-apply .
     4396   end.
     4397   on alt-left anywhere
     4398   do:
     4399     run diasize_change-width in this-procedure
     4400       (input -1
     4401       ,input true
     4402       ) .
     4403     return no-apply .
     4404   end.
     4405   on alt-down anywhere
     4406   do:
     4407     run diasize_change-height in this-procedure
     4408       (input 1
     4409       ,input true
     4410       ) .
     4411     return no-apply .
     4412   end.
     4413   on alt-up anywhere
     4414   do:
     4415     run diasize_change-height in this-procedure
     4416       (input -1
     4417       ,input true
     4418       ) .
     4419     return no-apply .
     4420   end.
     4421   on alt-enter of frame Dialog-Frame
     4422   do:
     4423     run diasize_maximize in this-procedure
     4424       (input  ?
     4425       ).
     4426     return no-apply .
     4427   end.
     4428   procedure diasize_end-move :
     4429     do
     4430     on error undo, return error return-value
     4431     :
     4432       define variable v-row-delta as decimal   no-undo .
     4433       define variable v-col-delta as decimal   no-undo .
     4434       define variable v-new-row as decimal   no-undo .
     4435       define variable v-new-col as decimal   no-undo .
     4436       assign
     4437         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4438         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4439       .
     4440       assign
     4441         v-row-delta = v-new-row - frame Dialog-Frame :height
     4442         v-col-delta = v-new-col - frame Dialog-Frame :width
     4443       .
     4444       run diasize_change-height in this-procedure
     4445         (input v-row-delta
     4446         ,input true
     4447         ) .
     4448       run diasize_change-width in this-procedure
     4449         (input v-col-delta
     4450         ,input true
     4451         ) .
     4452     end.
     4453   end procedure.
     4454   procedure diasize_maximize :
     4455     define input  parameter p-action as logical   no-undo .
     4456     do
     4457     on error undo, return error return-value
     4458     :
     4459       if p-action = ?
     4460       then do:
     4461         if v-diasize-need-maximize = true
     4462         then do:
     4463           assign
     4464             p-action = true
     4465           .
     4466         end.
     4467         else do:
     4468           assign
     4469             p-action = false
     4470           .
     4471         end.
     4472       end.
     4473       if p-action = true
     4474       then do:
     4475         run diasize_change-height in this-procedure
     4476           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4477               - frame Dialog-Frame :height-chars
     4478           ,input true
     4479           ) .
     4480         run diasize_change-width in this-procedure
     4481           (input session :width-chars
     4482               - frame Dialog-Frame :width-chars
     4483           ,input true
     4484           ) .
     4485         assign
     4486           v-diasize-need-maximize = false
     4487         .
     4488       end.
     4489       else do:
     4490         run diasize_change-width in this-procedure
     4491           (input v-diasize-orig-frame-width
     4492               - frame Dialog-Frame :width-chars
     4493           ,input true
     4494           ) .
     4495         run diasize_change-height in this-procedure
     4496           (input v-diasize-orig-frame-height
     4497               - frame Dialog-Frame :height-chars
     4498           ,input true
     4499           ) .
     4500         assign
     4501           v-diasize-need-maximize = true
     4502         .
     4503       end.
     4504     end.
     4505   end procedure.
     4506   procedure diasize_restore-orig-size :
     4507     do
     4508     on error undo, return error return-value
     4509     :
     4510       assign
     4511         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4512         v-diasize-current-frame-height = frame Dialog-Frame :height
     4513       .
     4514       run diasize_set-height in this-procedure
     4515         (input  v-diasize-orig-frame-height
     4516         ,input  true
     4517         ) .
     4518       run diasize_set-width in this-procedure
     4519         (input  v-diasize-orig-frame-width
     4520         ,input  true
     4521         ) .
     4522     end.
     4523   end procedure.
     4524   procedure diasize_restore-current-size :
     4525     do
     4526     on error undo, return error return-value
     4527     :
     4528       run diasize_set-height in this-procedure
     4529         (input  v-diasize-current-frame-height
     4530         ,input  true
     4531         ) .
     4532       run diasize_set-width in this-procedure
     4533         (input  v-diasize-current-frame-width
     4534         ,input  true
     4535         ) .
     4536     end.
     4537   end procedure.
     4538   procedure diasize_set-browse-handle :
     4539     define input  parameter p-browse-handle as handle   no-undo .
     4540     define buffer buf_temp-browse-handle for temp-browse-handle .
     4541     do
     4542     on error undo, return error return-value
     4543     :
     4544       assign
     4545         v-diasize-browse-handle = p-browse-handle
     4546       .
     4547       for each buf_temp-browse-handle
     4548       on error undo, return error return-value
     4549       :
     4550         delete buf_temp-browse-handle .
     4551       end.
     4552     end.
     4553   end procedure.
     4554   procedure diasize_add_browse :
     4555     define input  parameter p-browse-type   as character no-undo .
     4556     define input  parameter p-browse-handle as handle    no-undo .
     4557     define buffer buf_temp-browse-handle for temp-browse-handle .
     4558     do
     4559     on error undo, return error return-value
     4560     :
     4561       assign
     4562         v-diasize-browse-number = v-diasize-browse-number + 1
     4563       .
     4564       create buf_temp-browse-handle .
     4565       assign
     4566         buf_temp-browse-handle.browse-type   = p-browse-type
     4567         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4568         buf_temp-browse-handle.browse-handle = p-browse-handle
     4569       .
     4570     end.
     4571   end procedure.
     4572   procedure diasize_init :
     4573     define variable v-default-value    as logical   no-undo .
     4574     define variable v-restore-saved    as logical   no-undo .
     4575     define variable v-resize-value-str as character no-undo .
     4576     do
     4577     on error undo, return error return-value
     4578     :
     4579       do with frame Dialog-Frame
     4580       :
     4581         assign
     4582           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4583           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4584           v-diasize-browse-handle     = browse br-list :handle
     4585         .
     4586         create button v-diasize-resize-button
     4587         assign
     4588           parent        = frame Dialog-Frame :first-child
     4589           label         = "s"
     4590           height-pixels = 16
     4591           width-pixels  = 16
     4592           visible       = true
