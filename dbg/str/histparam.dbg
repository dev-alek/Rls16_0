        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Ввод уникального идентификатора записи".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      112   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      113   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      114   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      115   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      116   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      117   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      118   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      119   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      120   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      121   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      122   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      123   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      124   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      125   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      126   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      127   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      128   define input  parameter iLabel as character no-undo.
      129   define input  parameter iTypes as character no-undo.
      130   define output parameter oIdent as character no-undo.
      131   define temp-table ttFill no-undo
      132     field fLabel  as handle
      133     field fFill   as handle
      134     field fType   as character
      135     field fFormat as character
      136   .
      137   DEFINE BUTTON b-exit
      138        LABEL "Выход"
      139        SIZE 15 BY 1.14.
      140   DEFINE BUTTON b-input
      141        LABEL "Ввод"
      142        SIZE 15 BY 1.14.
      143   DEFINE RECTANGLE RECT-1
      144        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      145        SIZE 72 BY 2.38.
      146   DEFINE FRAME Dialog-Frame
      147        b-exit AT ROW 1.48 COL 3 WIDGET-ID 2
      148        b-input AT ROW 1.48 COL 19 WIDGET-ID 8
      149        RECT-1 AT ROW 2.91 COL 2 WIDGET-ID 10
      150        SPACE(1.79) SKIP(0.99)
      151       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      152            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      153            TITLE "Введите значения для идентификации записи" WIDGET-ID 100.
      154   ASSIGN
      155          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      156          FRAME Dialog-Frame:HIDDEN           = TRUE.
      157   ON RETURN OF FRAME Dialog-Frame
      158   anywhere DO:
      159     if focus:type = "FILL-IN" then
      160     do:
      161       find first ttFill where ttFill.fFill = focus:handle.
      162       find next ttFill no-error.
      163       if avail ttFill then
      164         apply "ENTRY":U to ttFill.fFill.
      165       else
      166         apply "CHOOSE":U to b-input.
      167     end.
      168   END.
      169   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      170   DO:
      171     APPLY "END-ERROR":U TO SELF.
      172   END.
      173   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      174   DO:
      175     APPLY "END-ERROR":U TO SELF.
      176   END.
      177   ON CHOOSE OF b-input IN FRAME Dialog-Frame
      178   DO:
      179     oIdent = "".
      180     for each ttFill:
      181       if (ttFill.fType = "CHARACTER" and ttFill.fFill:screen-value = "") then
      182       do:
      183         message "Не все поля заполнены." view-as alert-box.
      184         apply "entry":U to ttFill.fFill.
      185         return no-apply.
      186       end.
      187       oIdent = oIdent + "," + ttFill.fFill:screen-value.
      188     end.
      189     oIdent = substring(oIdent,2).
      190     APPLY "END-ERROR":U TO SELF.
      191   END.
      192   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      193   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      194   MAIN-BLOCK:
      195   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      196      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      197     run buildFill in this-procedure.
      198     RUN enable_UI.
      199     WAIT-FOR GO OF FRAME Dialog-Frame.
      200   END.
      201   RUN disable_UI.
      202   PROCEDURE buildFill :
      203   define variable vCount as integer no-undo.
      204   define variable vFillIn as handle no-undo.
      205   define variable vStep   as decimal no-undo.
      206   do with frame Dialog-Frame:
      207     do vCount = 1 to num-entries(iLabel):
      208       vStep = (vCount - 1) * 1.1.
      209       create ttFill.
      210       ttFill.fType = entry(vCount,iTypes).
      211       ttFill.fFormat = if entry(vCount,iTypes) = "integer" or entry(vCount,iTypes) = "int64" then ">>>>>>>>9" else
      212                        if entry(vCount,iTypes) = "decimal" then ">>>>>>>>9.9<<<<<" else "X(100)".
      213       CREATE TEXT ttFill.fLabel
      214       ASSIGN
      215         FRAME = FRAME Dialog-Frame:HANDLE
      216         DATA-TYPE = "CHARACTER"
      217         FORMAT = "x(" + string(length(entry(vCount,iLabel)) + 2) + ")"
      218         SCREEN-VALUE = entry(vCount,iLabel) + ":"
      219         ROW = 3.3 + vStep
      220         COLUMN = 25 - 2 - length(entry(vCount,iLabel))
      221       .
      222       CREATE FILL-IN ttFill.fFill
      223       ASSIGN
      224         ROW = 3.3 + vStep
      225         COLUMN = 25
      226         DATA-TYPE = ttFill.fType
      227         FORMAT = ttFill.fFormat
      228         WIDTH = 45
      229         FRAME = frame Dialog-Frame:HANDLE
      230         SENSITIVE = yes
      231         VISIBLE = TRUE
      232         SIDE-LABEL-HANDLE = ttFill.fLabel
      233       .
      234       frame Dialog-Frame:height = frame Dialog-Frame:height + vStep.
      235       rect-1:height = rect-1:height + vStep.
      236     end.
      237     find first ttFill.
      238     apply "ENTRY":U to ttFill.fFill.
      239   end.
      240   END PROCEDURE.
      241   PROCEDURE disable_UI :
      242     HIDE FRAME Dialog-Frame.
      243   END PROCEDURE.
      244   PROCEDURE enable_UI :
      245     ENABLE RECT-1 b-exit b-input
      246         WITH FRAME Dialog-Frame.
      247     VIEW FRAME Dialog-Frame.
      248   END PROCEDURE.
