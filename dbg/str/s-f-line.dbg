        1   define input         parameter parparentproc as handle no-undo .
        2   define input-output  parameter gds-name   as character no-undo .
        3   define input-output  parameter unit-base  as character no-undo .
        4   define input-output  parameter fact-qnty  as decimal   no-undo .
        5   define input-output  parameter price-rubl as decimal   no-undo .
        6   define input-output  parameter sum-rubl   as decimal   no-undo .
        7   define input-output  parameter excise     as decimal   no-undo .
        8   define input-output  parameter VAT-pc     as decimal   no-undo .
        9   define input-output  parameter VAT-rubl   as decimal   no-undo .
       10   define input-output  parameter sum-rubl-VAT as decimal   no-undo .
       11   define input-output  parameter country    as character no-undo .
       12   define input-output  parameter gtd        as character no-undo .
       13   define input-output  parameter res        as logical   no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Изменение строки счета-фактуры".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   DEFINE BUTTON b-calc
      120        LABEL "&Расчет":L
      121        SIZE 10 BY 1 TOOLTIP "Пересчитать суммы по цене , количеству и НДС".
      122   DEFINE BUTTON b-exit AUTO-END-KEY
      123        LABEL "&Отмена":L
      124        SIZE 10 BY 1.
      125   DEFINE BUTTON B-Help
      126        LABEL "Помо&щь"
      127        SIZE 10 BY 1
      128        BGCOLOR 8 .
      129   DEFINE BUTTON b-OK AUTO-GO
      130        LABEL "&Ввод ":L
      131        SIZE 10 BY 1.
      132   DEFINE BUTTON r-contry
      133        IMAGE-UP FILE "btn-down-arrow":U
      134        IMAGE-DOWN FILE "btn-down-arrow":U
      135        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      136        LABEL ""
      137        SIZE 3 BY .88.
      138   DEFINE BUTTON r-units
      139        IMAGE-UP FILE "btn-down-arrow":U
      140        IMAGE-DOWN FILE "btn-down-arrow":U
      141        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      142        LABEL "r-units"
      143        SIZE 3 BY .88.
      144   DEFINE VARIABLE FILL-IN_country AS CHARACTER FORMAT "X(25)"
      145        LABEL "Страна"
      146        VIEW-AS FILL-IN
      147        SIZE 22.5 BY 1.
      148   DEFINE VARIABLE FILL-IN_excise AS DECIMAL FORMAT "->,>>>,>>>,>>>,>>9.99" INITIAL 0
      149        LABEL "Акциз"
      150        VIEW-AS FILL-IN
      151        SIZE 16 BY 1.
      152   DEFINE VARIABLE FILL-IN_fact-qnty AS DECIMAL FORMAT ">>,>>>,>>9.<<<" INITIAL 0
      153        LABEL "Кол-во"
      154        VIEW-AS FILL-IN
      155        SIZE 23.5 BY 1.
      156   DEFINE VARIABLE FILL-IN_gds-name AS CHARACTER FORMAT "X(48)"
      157        LABEL "Название"
      158        VIEW-AS FILL-IN
      159        SIZE 50 BY 1.
      160   DEFINE VARIABLE FILL-IN_gtd AS CHARACTER FORMAT "X(25)"
      161        LABEL "ГТД"
      162        VIEW-AS FILL-IN
      163        SIZE 22.5 BY 1.
      164   DEFINE VARIABLE FILL-IN_price-rubl AS DECIMAL FORMAT ">,>>>,>>>,>>>,>>9.99" INITIAL 0
      165        LABEL "Цена"
      166        VIEW-AS FILL-IN
      167        SIZE 15.5 BY 1
      168        FGCOLOR 4 .
      169   DEFINE VARIABLE FILL-IN_sum-rubl AS DECIMAL FORMAT "->,>>>,>>>,>>>,>>9.99" INITIAL 0
      170        LABEL "Сумма"
      171        VIEW-AS FILL-IN
      172        SIZE 21.5 BY 1
      173        FGCOLOR 4 .
      174   DEFINE VARIABLE FILL-IN_sum-rubl-VAT AS DECIMAL FORMAT ">,>>>,>>>,>>>,>>9.99" INITIAL 0
      175        LABEL "Сумма с налогами"
      176        VIEW-AS FILL-IN
      177        SIZE 41.38 BY 1.
      178   DEFINE VARIABLE FILL-IN_unit-base AS CHARACTER FORMAT "X(3)"
      179        LABEL "Ед.изм."
      180        VIEW-AS FILL-IN
      181        SIZE 5.13 BY 1.
      182   DEFINE VARIABLE FILL-IN_VAT-pc AS DECIMAL FORMAT ">9.9<%" INITIAL 0
      183        LABEL "НДС"
      184        VIEW-AS FILL-IN
      185        SIZE 6 BY 1.
      186   DEFINE VARIABLE FILL-IN_VAT-rubl AS DECIMAL FORMAT "->,>>>,>>>,>>>,>>9.99" INITIAL 0
      187        LABEL "Сумма НДС"
      188        VIEW-AS FILL-IN
      189        SIZE 16 BY 1.
      190   DEFINE RECTANGLE RECT-1
      191        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      192        SIZE 69 BY 1.75.
      193   DEFINE QUERY Dialog-Frame FOR
      194         ub.schet-fact-line SCROLLING.
      195   DEFINE FRAME Dialog-Frame
      196        b-OK AT ROW 1 COL 1
      197        b-exit AT ROW 1 COL 11
      198        b-calc AT ROW 1 COL 21
      199        B-Help AT ROW 1 COL 60.5
      200        FILL-IN_gds-name AT ROW 2.08 COL 2
      201        FILL-IN_unit-base AT ROW 3.21 COL 54.88 COLON-ALIGNED
      202        FILL-IN_fact-qnty AT ROW 3.25 COL 10 COLON-ALIGNED
      203        r-units AT ROW 3.25 COL 62.5 WIDGET-ID 4
      204        FILL-IN_price-rubl AT ROW 5.38 COL 18.5 COLON-ALIGNED
      205        FILL-IN_sum-rubl AT ROW 5.38 COL 42.5 COLON-ALIGNED
      206        FILL-IN_VAT-pc AT ROW 6.75 COL 18.5 COLON-ALIGNED
      207        FILL-IN_VAT-rubl AT ROW 8 COL 18.5 COLON-ALIGNED
      208        FILL-IN_excise AT ROW 9.5 COL 18.5 COLON-ALIGNED
      209        FILL-IN_sum-rubl-VAT AT ROW 10.75 COL 2.5
      210        FILL-IN_country AT ROW 12 COL 18.5 COLON-ALIGNED
      211        r-contry AT ROW 12 COL 43.5 WIDGET-ID 6
      212        FILL-IN_gtd AT ROW 13.17 COL 18.5 COLON-ALIGNED
      213        " Без НДС" VIEW-AS TEXT
      214             SIZE 9 BY 1 AT ROW 4.75 COL 2.5
      215             FGCOLOR 4
      216        RECT-1 AT ROW 5 COL 1 WIDGET-ID 2
      217        SPACE(0.62) SKIP(8.91)
      218       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      219            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      220            TITLE "Строка счета-фактуры".
      221   ASSIGN
      222          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      223          FRAME Dialog-Frame:HIDDEN           = TRUE.
      224   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      225   DO:
      226     APPLY "END-ERROR":U TO SELF.
      227   END.
      228   ON CHOOSE OF b-calc IN FRAME Dialog-Frame
      229   DO:
      230     assign FILL-IN_fact-qnty FILL-IN_price-rubl  FILL-IN_sum-rubl FILL-IN_excise  FILL-IN_VAT-pc  FILL-IN_VAT-rubl FILL-IN_sum-rubl-VAT .
      231     IF FILL-IN_fact-qnty = 0 then do:
      232       message  "Кол-во 0 - расчет невозможен!"  view-as alert-box.
      233       return.
      234     end.
      235     IF FILL-IN_price-rubl = 0 and FILL-IN_sum-rubl-VAT = 0 then do:
      236       message  "Цена без НДС 0 и общая сумма 0 - оба варианта расчета невозможны расчет невозможен!"  view-as alert-box.
      237       return.
      238     end.
      239     if FILL-IN_price-rubl > 0 then do:
      240       assign
      241         FILL-IN_sum-rubl = FILL-IN_price-rubl * FILL-IN_fact-qnty
      242         FILL-IN_VAT-rubl = FILL-IN_sum-rubl * FILL-IN_VAT-pc / 100
      243         FILL-IN_sum-rubl-VAT = FILL-IN_sum-rubl + FILL-IN_VAT-rubl
      244       .
      245     end.
      246     else do:
      247       assign
      248         FILL-IN_VAT-rubl = FILL-IN_sum-rubl-VAT * FILL-IN_VAT-pc / ( 100 + FILL-IN_VAT-pc )
      249         FILL-IN_sum-rubl = FILL-IN_sum-rubl-VAT - FILL-IN_VAT-rubl
      250         FILL-IN_price-rubl = FILL-IN_sum-rubl / FILL-IN_fact-qnty
      251       .
      252     end.
      253     DISPLAY FILL-IN_price-rubl FILL-IN_sum-rubl  FILL-IN_VAT-rubl FILL-IN_sum-rubl-VAT   WITH FRAME Dialog-Frame.
      254   END.
      255   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      256   DO:
      257   END.
      258   ON CHOOSE OF b-OK IN FRAME Dialog-Frame
      259   DO:
      260     assign FILL-IN_gds-name   FILL-IN_unit-base  FILL-IN_fact-qnty  FILL-IN_price-rubl    FILL-IN_sum-rubl
      261            FILL-IN_excise     FILL-IN_VAT-pc     FILL-IN_VAT-rubl   FILL-IN_sum-rubl-VAT  FILL-IN_country   FILL-IN_gtd .
      262     if FILL-IN_gds-name = "" then do:
      263        message "Не заполнено наименование!" view-as alert-box.
      264        return no-apply.
      265     end.
      266     IF FILL-IN_fact-qnty = 0 then do:
      267       message  "Кол-во 0!"  view-as alert-box.
      268       return no-apply.
      269     end.
      270     IF FILL-IN_price-rubl = 0 and FILL-IN_sum-rubl-VAT = 0 then do:
      271       message  "Цена без НДС 0 и/или общая сумма 0!"  view-as alert-box.
      272       return no-apply.
      273     end.
      274     assign
      275       gds-name     = FILL-IN_gds-name
      276       unit-base    = FILL-IN_unit-base
      277       fact-qnty    = FILL-IN_fact-qnty
      278       price-rubl   = FILL-IN_price-rubl
      279       sum-rubl     = FILL-IN_sum-rubl
      280       excise       = FILL-IN_excise
      281       VAT-pc       = FILL-IN_VAT-pc
      282       VAT-rubl     = FILL-IN_VAT-rubl
      283       sum-rubl-VAT = FILL-IN_sum-rubl-VAT
      284       country      = FILL-IN_country
      285       gtd          = FILL-IN_gtd
      286       res          = yes
      287     .
      288   END.
      289   ON CHOOSE OF r-contry IN FRAME Dialog-Frame
      290   DO:
      291   define variable varrid-list as character no-undo.
      292   define variable varrecid    as recid     no-undo.
      293   define buffer bf_country for ub.country.
      294   run ref/countris.w
      295       (  input parparentproc
      296         , input "b-sel"
      297         , input-output varrid-list ) no-error.
      298     if error-status :error then do:
      299        message vss-workfile vss-revision vss-description skip
      300                error-status :get-message( 1 )
      301        view-as alert-box.
      302        return no-apply .
      303        end.
      304   if varrid-list = '' then return no-apply.
      305   assign
      306     varrecid = integer(entry(1, varrid-list)).
      307   find first bf_country no-lock where recid(bf_country) = varrecid no-error.
      308   if available bf_country then do:
      309     assign
      310         FILL-IN_country   = bf_country.short-name
      311         .
      312     display
      313        FILL-IN_country
      314        with frame Dialog-Frame.
      315   end.
      316   END.
      317   ON CHOOSE OF r-units IN FRAME Dialog-Frame
      318   DO:
      319   define buffer bf-r-units for ub.units.
      320   define variable ref-rec as recid no-undo.
      321   run ref/units.w (input parparentproc, input yes, output ref-rec).
      322   if ref-rec = ? then return no-apply.
      323   find bf-r-units where recid (bf-r-units) = ref-rec no-lock.
      324   assign FILL-IN_unit-base  = bf-r-units.unit-name.
      325   release bf-r-units.
      326   display FILL-IN_unit-base with frame Dialog-Frame.
      327   END.
      328   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      329   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      330   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   on help of frame Dialog-Frame
      332   do:
      333     run gbl/app_help.p
      334       (input this-procedure :file-name
      335       ,input ''
      336       ,input ?
      337       ) no-error.
      338     if error-status :error then do:
      339       message
      340         "Ошибка при вызове помощи"
      341         error-status :get-message(1)
      342         view-as alert-box .
      343     end.
      344   end.
      345   run minbtn-set in this-procedure .
      346   on choose of b-help in frame Dialog-Frame
      347   do:
      348     apply "help":u to frame Dialog-Frame .
      349   end.
      350   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      351   procedure minbtn-set :
      352       do
      353           on error undo, return error return-value
      354           :
      355           define variable ii              as integer       no-undo .
      356           define variable fh              as widget-handle no-undo .
      357           define variable hh              as widget-handle no-undo .
      358           define variable v-h             as handle        extent 4 no-undo .
      359           define variable v-name-button   as character     no-undo .
      360           define variable v-help-old-x    as decimal       no-undo .
      361           define variable v-help-old-y    as decimal       no-undo .
      362           define variable v-help-old-size as decimal       no-undo .
      363           define variable v-frame-width   as decimal       no-undo .
      364           define variable jj              as integer       no-undo .
      365           do
      366               on error undo, return error
      367               :
      368               assign
      369                   v-frame-width = frame Dialog-Frame:width - 0.3
      370                   fh            = frame Dialog-Frame:first-child
      371                   hh            = fh:first-child
      372                   ii            = 1
      373                   .
      374               do while valid-handle(hh):
      375                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      376                   do:
      377                       case lc(hh:name) :
      378                           when "b-help" then
      379                               do:
      380                                   hh:load-image-up("cmp/b-help.bmp":u) .
      381                                   hh:load-image-down("cmp/b-help.bmp":u) .
      382                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      383                                   hh:TOOLTIP = "Помощь" .
      384                                   v-help-old-x = hh:column .
      385                                   v-help-old-y = hh:row    .
      386                                   v-help-old-size = hh:width .
      387                                   hh:width-chars = 2.5 .
      388                               end.
      389                           when "b-print" then
      390                               do:
      391                                   hh:load-image("cmp/b-print.bmp":u) .
      392                                   hh:TOOLTIP = "Печать" .
      393                                   v-h[ii] = hh:handle .
      394                                   ii = ii + 1 .
      395                                   hh:width-chars = 3 .
      396                               end.
      397                           when "b-history" or
      398                           when "b-hist" then
      399                               do:
      400                                   hh:load-image("cmp/b-hist.bmp":u) .
      401                                   hh:TOOLTIP = "История" .
      402                                   v-h[ii] = hh:handle .
      403                                   ii = ii + 1 .
      404                                   hh:width-chars = 3 .
      405                               end.
      406                           when "b-sch" then
      407                               do:
      408                                   hh:load-image("cmp/b-sch.bmp":u) .
      409                                   hh:TOOLTIP = "Установка Фильтра" .
      410                                   v-h[ii] = hh:handle .
      411                                   ii = ii + 1 .
      412                                   hh:width-chars = 3 .
      413                               end.
      414                           when "b-hist-user" then
      415                               do:
      416                                   hh:load-image("cmp/b-hist.bmp":u) .
      417                                   hh:TOOLTIP = "История пользователя" .
      418                                   ii = ii + 1 .
      419                               end.
      420                       end case.
      421                   end.
      422                   hh = hh:next-sibling.
      423               end.
      424               b-help:column = v-frame-width - b-help:width-chars.
      425               jj = 0.
      426               repeat ii = 4 to 1 by -1 :
      427                   if valid-handle (v-h[ii] ) then
      428                   do:
      429                       jj  = jj + 1 .
      430                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      431                       v-h[ii]:row    = v-help-old-y .
      432                   end.
      433               end.
      434           end.
      435       end.
      436   end procedure.
      437   MAIN-BLOCK:
      438   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      439      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      440     assign
      441       FILL-IN_gds-name     = gds-name
      442       FILL-IN_unit-base    = unit-base
      443       FILL-IN_fact-qnty    = fact-qnty
      444       FILL-IN_price-rubl   = price-rubl
      445       FILL-IN_sum-rubl     = sum-rubl
      446       FILL-IN_excise       = excise
      447       FILL-IN_VAT-pc       = VAT-pc
      448       FILL-IN_VAT-rubl     = VAT-rubl
      449       FILL-IN_sum-rubl-VAT = sum-rubl-VAT
      450       FILL-IN_country      = country
      451       FILL-IN_gtd          = gtd
      452     .
      453     RUN enable_UI.
      454     WAIT-FOR GO OF FRAME Dialog-Frame.
      455   END.
      456   RUN disable_UI.
      457   PROCEDURE disable_UI :
      458     HIDE FRAME Dialog-Frame.
      459   END PROCEDURE.
      460   PROCEDURE enable_UI :
      461     OPEN QUERY Dialog-Frame FOR EACH ub.schet-fact-line SHARE-LOCK.
      462     GET FIRST Dialog-Frame.
      463     DISPLAY FILL-IN_gds-name FILL-IN_unit-base FILL-IN_fact-qnty
      464             FILL-IN_price-rubl FILL-IN_sum-rubl FILL-IN_VAT-pc FILL-IN_VAT-rubl
      465             FILL-IN_excise FILL-IN_sum-rubl-VAT FILL-IN_country FILL-IN_gtd
      466         WITH FRAME Dialog-Frame.
      467     ENABLE b-OK RECT-1 b-exit b-calc B-Help FILL-IN_gds-name FILL-IN_unit-base
      468            FILL-IN_fact-qnty r-units FILL-IN_price-rubl FILL-IN_sum-rubl
      469            FILL-IN_VAT-pc FILL-IN_VAT-rubl FILL-IN_excise FILL-IN_sum-rubl-VAT
      470            FILL-IN_country r-contry FILL-IN_gtd
      471         WITH FRAME Dialog-Frame.
      472     VIEW FRAME Dialog-Frame.
      473   END PROCEDURE.
