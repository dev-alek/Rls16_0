     2180   index isdone
     2181   done
     2182   .
     2183   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2184   define variable vss-include-info23 as character format "X(65)" no-undo
     2185   initial "@(#)$Workfile$ $Revision$".
     2186   procedure xmlchar-test :
     2187   define input parameter p-in-string          as character        no-undo.
     2188   define output parameter p-out-string-enc    as character        no-undo.
     2189   define output parameter p-out-string-dec    as character        no-undo.
     2190   do
     2191   on error undo, return error
     2192   :
     2193          run xmlchar-encode in this-procedure
     2194       (
     2195             input p-in-string
     2196           , output p-out-string-enc
     2197       ).
     2198          run xmlchar-decode in this-procedure
     2199       (
     2200             input p-out-string-enc
     2201           , output p-out-string-dec
     2202       ).
     2203   end.
     2204   end .
     2205   procedure xmlchar-encode :
     2206   define input parameter p-in-string      as character        no-undo.
     2207   define output parameter p-out-string    as character        no-undo.
     2208       define variable v-position      as integer      no-undo.
     2209       define variable v-current-char  as character    no-undo.
     2210   do
     2211   on error undo, return error
     2212   :
     2213       assign
     2214           p-out-string = "":U
     2215       .
     2216       case p-in-string
     2217       :
     2218           when ?
     2219           then do:
     2220               assign
     2221                   p-out-string = "?":U
     2222               .
     2223           end.
     2224           when "?":U
     2225           then do:
     2226               assign
     2227                   p-out-string = "&#63;":U
     2228               .
     2229           end.
     2230           otherwise do:
     2231               do v-position = 1 to length( p-in-string )
     2232               :
     2233                   assign
     2234                       v-current-char = substring( p-in-string, v-position, 1 )
     2235                   .
     2236                   case v-current-char
     2237                   :
     2238                       when "&":U
     2239                       then do:
     2240                           assign
     2241                               p-out-string = p-out-string + "&amp;":U
     2242                           .
     2243                       end.
     2244                       when ">":U
     2245                       then do:
     2246                           assign
     2247                               p-out-string = p-out-string + "&gt;":U
     2248                           .
     2249                       end.
     2250                       when "<":U
     2251                       then do:
     2252                           assign
     2253                               p-out-string = p-out-string + "&lt;":U
     2254                           .
     2255                       end.
     2256                       when "'":U
     2257                       then do:
     2258                           assign
     2259                               p-out-string = p-out-string + "&apos;":U
     2260                           .
     2261                       end.
     2262                       when '"':U
     2263                       then do:
     2264                           assign
     2265                               p-out-string = p-out-string + "&quot;":U
     2266                           .
     2267                       end.
     2268                       when chr(1)
     2269                       then do:
     2270                           assign
     2271                               p-out-string = p-out-string + "":U
     2272                           .
     2273                       end.
     2274                       when chr(2)
     2275                       then do:
     2276                           assign
     2277                               p-out-string = p-out-string + "":U
     2278                           .
     2279                       end.
     2280                       when chr(3)
     2281                       then do:
     2282                           assign
     2283                               p-out-string = p-out-string + "":U
     2284                           .
     2285                       end.
     2286                       when chr(4)
     2287                       then do:
     2288                           assign
     2289                               p-out-string = p-out-string + "":U
     2290                           .
     2291                       end.
     2292                       when chr(5)
     2293                       then do:
     2294                           assign
     2295                               p-out-string = p-out-string + "":U
     2296                           .
     2297                       end.
     2298                       when chr(6)
     2299                       then do:
     2300                           assign
     2301                               p-out-string = p-out-string + "":U
     2302                           .
     2303                       end.
     2304                       when chr(7)
     2305                       then do:
     2306                           assign
     2307                               p-out-string = p-out-string + "":U
     2308                           .
     2309                       end.
     2310                       when chr(8)
     2311                       then do:
     2312                           assign
     2313                               p-out-string = p-out-string + "":U
     2314                           .
     2315                       end.
     2316                       when chr(9)
     2317                       then do:
     2318                           assign
     2319                               p-out-string = p-out-string + "":U
     2320                           .
     2321                       end.
     2322                       when chr(29)
     2323                       then do:
     2324                           assign
     2325                               p-out-string = p-out-string + "":U
     2326                           .
     2327                       end.
     2328                       when chr(10)
     2329                       then do:
     2330                           assign
     2331                               p-out-string = p-out-string + "&#10;":U
     2332                           .
     2333                       end.
     2334                       when chr(13)
     2335                       then do:
     2336                           assign
     2337                               p-out-string = p-out-string + "&#13;":U
     2338                           .
     2339                       end.
     2340                       otherwise do:
     2341                           assign
     2342                               p-out-string = p-out-string + v-current-char
     2343                           .
     2344                       end.
     2345                   end case.
     2346               end.
     2347           end.
     2348       end case.
     2349   end.
     2350   end .
     2351   procedure xmlchar-encode-1c :
     2352   define input parameter p-in-string      as character        no-undo.
     2353   define output parameter p-out-string    as character        no-undo.
     2354       define variable v-position      as integer      no-undo.
     2355       define variable v-current-char  as character    no-undo.
     2356   do
     2357   on error undo, return error
     2358   :
     2359       assign
     2360           p-out-string = "":U
     2361       .
     2362       case p-in-string
     2363       :
     2364           when ?
     2365           then do:
     2366               assign
     2367                   p-out-string = "?":U
     2368               .
     2369           end.
     2370           otherwise do:
     2371               do v-position = 1 to length( p-in-string )
     2372               :
     2373                   assign
     2374                       v-current-char = substring( p-in-string, v-position, 1 )
     2375                   .
     2376                   case v-current-char
     2377                   :
     2378                       when chr(1)
     2379                       then do:
     2380                           assign
     2381                               p-out-string = p-out-string + " ":U
     2382                           .
     2383                       end.
     2384                       when chr(2)
     2385                       then do:
     2386                           assign
     2387                               p-out-string = p-out-string + " ":U
     2388                           .
     2389                       end.
     2390                       when chr(3)
     2391                       then do:
     2392                           assign
     2393                               p-out-string = p-out-string + " ":U
     2394                           .
     2395                       end.
     2396                       when chr(4)
     2397                       then do:
     2398                           assign
     2399                               p-out-string = p-out-string + " ":U
     2400                           .
     2401                       end.
     2402                       when chr(5)
     2403                       then do:
     2404                           assign
     2405                               p-out-string = p-out-string + " ":U
     2406                           .
     2407                       end.
     2408                       when chr(6)
     2409                       then do:
     2410                           assign
     2411                               p-out-string = p-out-string + " ":U
     2412                           .
     2413                       end.
     2414                       when chr(7)
     2415                       then do:
     2416                           assign
     2417                               p-out-string = p-out-string + " ":U
     2418                           .
     2419                       end.
     2420                       when chr(8)
     2421                       then do:
     2422                           assign
     2423                               p-out-string = p-out-string + " ":U
     2424                           .
     2425                       end.
     2426                       when chr(9)
     2427                       then do:
     2428                           assign
     2429                               p-out-string = p-out-string + " ":U
     2430                           .
     2431                       end.
     2432                       when chr(29)
     2433                       then do:
     2434                           assign
     2435                               p-out-string = p-out-string + " ":U
     2436                           .
     2437                       end.
     2438                       when chr(10)
     2439                       then do:
     2440                           assign
     2441                               p-out-string = p-out-string + " ":U
     2442                           .
     2443                       end.
     2444                       when chr(13)
     2445                       then do:
     2446                           assign
     2447                               p-out-string = p-out-string + " ":U
     2448                           .
     2449                       end.
     2450                       otherwise do:
     2451                           assign
     2452                               p-out-string = p-out-string + v-current-char
     2453                           .
     2454                       end.
     2455                   end case.
     2456               end.
     2457           end.
     2458       end case.
     2459   end.
     2460   end .
     2461   procedure xmlchar-decode :
     2462   define input parameter p-in-string      as character        no-undo.
     2463   define output parameter p-out-string    as character        no-undo.
     2464       define variable v-position      as integer      no-undo.
     2465       define variable v-last-position as integer      no-undo.
     2466       define variable v-temp-integer  as integer      no-undo.
     2467       define variable v-current-char  as character    no-undo.
     2468       define variable v-next-char     as character    no-undo.
     2469       define variable v-success       as logical      no-undo.
     2470   do
     2471   on error undo, return error
     2472   :
     2473       assign
     2474           p-out-string = "":U
     2475           v-position   = 0
     2476       .
     2477       replace-cycle:
     2478       do while yes
     2479       on error undo, return error
     2480       :
     2481           assign
     2482               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2483           .
     2484           if v-last-position <= v-position
     2485           then do:
     2486               if v-position = 0
     2487               then do:
     2488                   assign
     2489                       p-out-string = p-in-string
     2490                   .
     2491               end.
     2492               else do:
     2493                   assign
     2494                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2495                   .
     2496               end.
     2497               leave replace-cycle.
     2498           end.
     2499           else do:
     2500               assign
     2501                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2502                   v-position      = v-last-position
     2503                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2504               .
     2505               if v-current-char = "#":U
     2506               then do:
     2507                   assign
     2508                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2509                   .
     2510                   if v-last-position > 0
     2511                   then do:
     2512                       run xmlchar-read-integer in this-procedure
     2513                        (
     2514                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2515                           , output v-temp-integer
     2516                           , output v-success
     2517                       ).
     2518                       if v-success = yes
     2519                       and v-temp-integer >= 1
     2520                       and v-temp-integer <= 255
     2521                       then do:
     2522                           assign
     2523                               p-out-string = p-out-string + chr( v-temp-integer )
     2524                               v-position   = v-last-position + 1
     2525                           .
     2526                       end.
     2527                       else do:
     2528                           assign
     2529                               p-out-string = p-out-string + "&":U
     2530                               v-position   = v-position   + 1
     2531                           .
     2532                       end.
     2533                   end.
     2534                   else do:
     2535                       assign
     2536                           p-out-string = p-out-string + "&":U
     2537                           v-position   = v-position   + 1
     2538                       .
     2539                   end.
     2540               end.
     2541               else do:
     2542                   case substring( p-in-string, v-position + 1, 3 )
     2543                   :
     2544                       when "lt;":U
     2545                       then do:
     2546                           assign
     2547                               p-out-string = p-out-string + "<":U
     2548                               v-position   = v-position   + 3
     2549                           .
     2550                       end.
     2551                       when "gt;":U
     2552                       then do:
     2553                           assign
     2554                               p-out-string = p-out-string + ">":U
     2555                               v-position   = v-position   + 3
     2556                           .
     2557                       end.
     2558                       otherwise do:
     2559                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2560                           then do:
     2561                               assign
     2562                                   p-out-string = p-out-string + "&":U
     2563                                   v-position   = v-position   + 4
     2564                               .
     2565                           end.
     2566                           else do:
     2567                               case substring( p-in-string, v-position + 1, 5 )
     2568                               :
     2569                                   when "quot;":U
     2570                                   then do:
     2571                                       assign
     2572                                           p-out-string = p-out-string + '"':U
     2573                                           v-position   = v-position   + 5
     2574                                       .
     2575                                   end.
     2576                                   when "apos;":U
     2577                                   then do:
     2578                                       assign
     2579                                           p-out-string = p-out-string + "'":U
     2580                                           v-position   = v-position   + 5
     2581                                       .
     2582                                   end.
     2583                                   otherwise do:
     2584                                       assign
     2585                                           p-out-string = p-out-string + "&":U
     2586                                       .
     2587                                   end.
     2588                               end case.
     2589                           end.
     2590                       end.
     2591                   end case.
     2592               end.
     2593           end.
     2594       end.
     2595   end.
     2596   end .
     2597   procedure xmlchar-read-integer :
     2598   define input parameter p-input-string      as character        no-undo.
     2599   define output parameter p-output-integer   as integer          no-undo.
     2600   define output parameter p-success       as logical          no-undo.
     2601   do
     2602   on error undo, return error
     2603   :
     2604       assign
     2605           p-output-integer = integer( p-input-string )
     2606       no-error.
     2607       if error-status :error
     2608       then do:
     2609           assign
     2610               p-success           = no
     2611               p-output-integer    = 0
     2612           .
     2613       end.
     2614       else do:
     2615           assign
     2616               p-success           = yes
     2617           .
     2618       end.
     2619   end.
     2620   end.
     2621   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     2622   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2623   define new global shared variable g#attr-lib  as handle no-undo .
     2624   define variable v-attr-lib-variable as handle no-undo .
     2625   define variable mMRCCode  as logical    no-undo.
     2626   define variable mTypeMark as character  no-undo.
     2627   function IS-NeedMark returns logical
     2628   ( input ib-code as integer  ,
     2629     input ib-str as character ):
     2630      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     2631      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     2632                                    and buf_prod-bc-attr.b-str  eq ib-str
     2633                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     2634        no-lock no-error.
     2635      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     2636   end.
     2637   function repTegforDm return char
     2638   (iDM as char ):
     2639       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     2640       define variable vteg as character no-undo.
     2641       define variable oDM as character no-undo.
     2642       define variable vi as integer no-undo.
     2643       oDM = iDm.
     2644       do vi = 1 to num-entries(vTeglist):
     2645          vTeg = entry(vi,vTeglist).
     2646          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     2647       end.
     2648       return oDM.
     2649   end.
     2650   function repSpecSimbforDm return char
     2651   (iDM as char ):
     2652       define variable oDM as character no-undo.
     2653     run
     2654       xmlchar-decode(iDM, output oDM).
     2655     return repTegforDm (oDM).
     2656   end.
     2657   function CheckGtin return logical
     2658   (iGtin as char):
     2659      define variable bar_code as character no-undo.
     2660      define variable vGtin as logical no-undo init "yes".
     2661      if length(iGtin) eq 14
     2662      then do:
     2663         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     2664         run str/chk-sum.p
     2665          (input-output bar_code ) no-error .
     2666         if iGtin ne  bar_code
     2667         then
     2668            vGtin = no.
     2669      end.
     2670      else
     2671         vGtin = no.
     2672      return vgtin.
     2673   end.
     2674   function repSpecSimbforXlm return char
     2675   (iDM as char ):
     2676       iDM = replace(iDM,chr(29),"").
     2677       return iDM.
     2678   end.
     2679   function getGtinByDM return char
     2680   (IDM as char):
     2681      define variable VTXT as char no-undo.
     2682      define variable vGtin as char no-undo.
     2683      vTXt = IdM.
     2684      vGtin = IDM.
     2685      if    length(vtxt) > 14
     2686      then do:
     2687         if   vtxt begins "(01)"
     2688                or vtxt begins "(02)"
     2689         then
     2690            vGtin = substring(vtxt,5,14).
     2691         else if   (vtxt begins "01"
     2692                or vtxt begins "02" )
     2693                and (   (    substring(iDm,17,2) eq "21"
     2694                         and length(vtxt) >= 21)
     2695                     or substring(iDm,17,2) eq "37"
     2696                     or substring(iDm,17,4) eq "(37)" )
     2697         then do:
     2698            vGtin = substring(vtxt,3,14).
     2699            if not checkGtin(vGtin)
     2700            then
     2701               vGtin = substring(vtxt,1,14).
     2702         end.
     2703         else if     length(vtxt) eq 14 + 7 + 4 + 4
     2704             or length(vtxt) eq 14 + 7 + 4
     2705             or length(vtxt) eq 14 + 7
     2706         then
     2707            vGtin = substring(vtxt,1,14).
     2708      end.
     2709      if not checkGtin(vGtin)
     2710      then
     2711         vGtin = "".
     2712      return vgtin.
     2713   end.
     2714   function getGdsCodeByGtin return int
     2715   (iGtin as char):
     2716      define buffer prod-bc  for ub.prod-bc.
     2717      define buffer bar-code for ub.bar-code.
     2718      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     2719      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2720      return if avail bar-code then bar-code.gds-code else ?.
     2721   end.
     2722   function getQntyCodeByGtin return decimal
     2723   (iGtin as char):
     2724      define buffer prod-bc  for ub.prod-bc.
     2725      define buffer bar-code for ub.bar-code.
     2726      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     2727      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2728      return if avail bar-code then bar-code.cli-base-rate else ?.
     2729   end.
     2730   function getGdsCodeByDM return int
     2731   (iDm as char):
     2732      define variable vGtin as char no-undo.
     2733      define buffer prod-bc for ub.prod-bc.
     2734      vGtin  = getGtinByDM (IDM ).
     2735      return getGdsCodeByGtin (vGtin).
     2736   end.
     2737   function ChekTypeMarkByGds return logical
     2738   (iGds-code as integer ):
     2739      define buffer goods-attr for ub.goods-attr.
     2740      find first goods-attr where goods-attr.gds-code   = iGds-code
     2741                              and goods-attr.attr-code  = 'mark-type':U
     2742      no-lock no-error.
     2743      if available goods-attr
     2744      then do:
     2745         mTypeMark = goods-attr.attr-value.
     2746         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     2747           .
     2748      end.
     2749      else
     2750         return no.
     2751   end.
     2752   function ChekTypeMarkByDm return logical
     2753   (iDM as char ):
     2754      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     2755   end.
     2756   function ChekTypeMarkByGtin return logical
     2757   (iGtin as char ):
     2758      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     2759   end.
     2760   function GetNextElement return character
     2761     (input iAllTeg        as logical
     2762     ,output oteg          as character
     2763     ,output otegval       as character
     2764     ,input-output pstr    as character
     2765      ):
     2766        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     2767        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     2768        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     2769        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     2770        define variable vTeg as character no-undo.
     2771        define variable vLength as integer no-undo.
     2772        define variable vi as integer no-undo.
     2773        define variable vj as integer no-undo.
     2774        define buffer code for ub.code.
     2775        find first code where Code.parent eq "MarkType"
     2776                          and Code.CodeValue   eq mTypeMark
     2777                          no-lock no-error.
     2778        if     available code
     2779           and Code.misc1 ne ""
     2780           and Code.misc1 ne ?
     2781        then do:
     2782           integer (Code.misc1) no-error.
     2783           if not error-status:error
     2784           then
     2785             entry (4,vlistleng) = Code.misc1.
     2786        end.
     2787        if iAllTeg
     2788        then
     2789           assign
     2790              vlistElem     = vlistElem    + vlistElemDop
     2791              vlistleng     = vlistleng    + vlistlengDop
     2792           .
     2793        else if mMRCCode
     2794        then
     2795           assign
     2796              vlistElem     = vlistElem    + ",(8005),8005"
     2797              vlistleng     = vlistleng    + ",000006,0006"
     2798           .
     2799       block-elem:
     2800       do vi = 1 to num-entries(vlistElem):
     2801          vTeg = entry(vi,vlistElem).
     2802          if pstr begins vTeg
     2803          then do:
     2804             if    vTeg eq "21"
     2805             then
     2806                vLength = index(pstr,chr(29)) - 2 no-error.
     2807             if vLength  <= 0
     2808             then
     2809                vLength = int(entry(vi,vlistleng)).
     2810             otegval = substring (pstr,length(vteg) + 1, vLength).
     2811             oteg = replace(replace(vteg,")",""),"(","").
     2812             vTeg = vteg + otegval.
     2813             otegval = replace(otegval,chr(29),"").
     2814             oteg = replace(replace(oteg,")",""),"(","").
     2815             pstr = substring (pstr,length(vTeg)+ 1).
     2816             vTeg = replace(vTeg,chr(29),"").
     2817             leave block-elem.
     2818          end.
     2819          else
     2820             vTeg = "".
     2821       end.
     2822       return vteg.
     2823   end.
     2824   function GetCodeIdent return character
     2825   (iDm as char):
     2826      define variable Velement   as character no-undo init "first".
     2827      define variable oCodeIdent as character no-undo.
     2828      define variable vteg as character no-undo.
     2829      define variable vtegval as character no-undo.
     2830      define variable vGtin as character no-undo.
     2831      define buffer marking for ub.marking.
     2832      for first marking no-lock where
     2833                marking.mark eq iDm
     2834            and marking.unit-ext = "LEVEL2"
     2835      :
     2836        return iDm.
     2837      end.
     2838      vGtin  = getGtinByDM (iDm ).
     2839      ChekTypeMarkByDm(idm).
     2840      if iDm begins 'tech_':U
     2841      then
     2842         oCodeIdent = iDm.
     2843      else if length(iDm) < 21
     2844      then do:
     2845         find first marking where marking.mark eq idm
     2846         no-lock no-error.
     2847         oCodeIdent = if available marking then marking.mark else  ?.
     2848      end.
     2849      else if     length(iDm) eq 29
     2850         and not iDm begins "01"
     2851         and not iDm begins "02"
     2852      then
     2853         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     2854      else  if     length(iDm) >= 24
     2855               and (  iDm begins "01"
     2856                   or iDm begins "02")
     2857               and  substring(iDm,17,2) ne "21"
     2858      then do:
     2859         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     2860                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     2861         then
     2862            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     2863         else
     2864            oCodeIdent = iDM.
     2865      end.
     2866      else  if     (   length(iDm) eq 25
     2867                    or length(iDm) eq 21)
     2868               and (not iDm begins "01"
     2869               and  not iDm begins "02")
     2870      then
     2871         oCodeIdent = substring(iDm,1,21).
     2872      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     2873      then
     2874         oCodeIdent = substring(iDm,1,21).
     2875      else do while Velement ne "" and idm ne "":
     2876         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     2877         oCodeIdent = oCodeIdent + Velement.
     2878      end.
     2879      return oCodeIdent.
     2880   end.
     2881   function GetTegCod return character
     2882   (icodeIdent as char, iTeg as char):
     2883      define variable Velement   as character no-undo init "first".
     2884      define variable oTeg as character no-undo init ?.
     2885      define variable vteg as character no-undo.
     2886      define variable vtegval as character no-undo.
     2887      if     ((length(icodeIdent) eq 21
     2888         and not icodeIdent begins "01"
     2889         and not icodeIdent begins "02")
     2890         or
     2891             ( length(icodeIdent) eq 25
     2892               and not icodeIdent begins "01"
     2893               and not icodeIdent begins "02"))
     2894      then do:
     2895         if iTeg eq "01" or iTeg eq "02"
     2896         then
     2897            oTeg = substring(icodeIdent,1,21).
     2898         else  if  iTeg eq "21"
     2899         then
     2900            oTeg = substring(icodeIdent,15,7).
     2901      end.
     2902      else do:
     2903         ChekTypeMarkByDm(icodeIdent).
     2904         block-teg:
     2905            do while Velement ne "" and icodeIdent ne "":
     2906            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     2907            if    Velement begins iTeg
     2908               or Velement begins "(" + iTeg + ")"
     2909            then do:
     2910               oTeg = vtegval.
     2911               leave block-teg.
     2912            end.
     2913         end.
     2914      end.
     2915      return oTeg.
     2916   end.
     2917   function isOAD return logical
     2918   (icodeIdent as character):
     2919      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     2920   end.
     2921   function isMark return logical
     2922   (icodeIdent as character):
     2923      define buffer buf_marking for ub.marking.
     2924      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     2925             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     2926   end.
     2927   function addBracketForCode return character
     2928   (icodeIdent as char):
     2929      define variable Velement   as character no-undo init "first".
     2930      define variable oTeg as character no-undo.
     2931      define variable vteg as character no-undo.
     2932      define variable vtegval as character no-undo.
     2933      define buffer marking for ub.marking.
     2934      find first marking no-lock where
     2935                 marking.mark begins icodeIdent no-error.
     2936      if    not ChekTypeMarkByDm(icodeIdent)
     2937         or length(icodeIdent) le 24
     2938         or (avail marking and marking.unit-ext = "LEVEL2")
     2939      then
     2940         oTeg = icodeIdent.
     2941      else do:
     2942         if (  icodeIdent begins "01"
     2943            or icodeIdent begins "02"
     2944            ) and CheckGtin(substring (icodeIdent,3,14))
     2945            and substring (icodeIdent,17,2) eq "21"
     2946         then do:
     2947            mMRCCode = yes.
     2948            ChekTypeMarkByDm(icodeIdent).
     2949            block-teg:
     2950            do while Velement ne "" and icodeIdent ne "":
     2951               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2952               if vteg ne ""
     2953               then
     2954                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2955            end.
     2956            mMRCCode = no.
     2957         end.
     2958         else do:
     2959            oTeg = icodeIdent.
     2960         end.
     2961      end.
     2962      return oTeg.
     2963   end.
     2964   function getlevelByCodId return int
     2965   (iCode as char):
     2966      define variable vLength as int no-undo.
     2967      define variable vLevel  as int no-undo.
     2968      if not ChekTypeMarkByDM (icode) then return ?.
     2969      vLength = length(iCode).
     2970      if    vLength eq 18
     2971         or vLength eq 20
     2972      then
     2973         Vlevel = 4.
     2974      else if vLength eq 21
     2975      then
     2976         Vlevel = 1.
     2977      else if vLength eq 25
     2978      then do:
     2979         if  iCode begins "01"
     2980         then
     2981            Vlevel = 3.
     2982         else
     2983            Vlevel = 1.
     2984      end.
     2985      else if     vLength >= 26
     2986              and vLength <= 46
     2987      then do:
     2988         if    substring(iCode,17,2) eq "11"
     2989            or substring(iCode,17,2) eq "13"
     2990            or (    substring(iCode,17,2) eq "21"
     2991                and vLength >= 33
     2992                and substring(iCode,26,4) ne "8005")
     2993         then
     2994            Vlevel = 4.
     2995         else if    vLength eq 31
     2996                 or vLength eq 38
     2997                 or vLength eq 39
     2998                 or vLength eq 45
     2999         then
     3000            Vlevel = 1.
     3001         else if    vLength eq 35
     3002                 or vLength eq 43
     3003         then
     3004            Vlevel = 3.
     3005         else
     3006            Vlevel = ?.
     3007      end.
     3008      else
     3009         Vlevel = ?.
     3010      return Vlevel.
     3011   end.
     3012   function getLevelMotpBycodid return character
     3013   (iDm as char):
     3014      define variable vLevel as integer no-undo.
     3015      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3016      vLevel = getlevelByCodId(iDm).
     3017      if    vLevel eq ?
     3018         or vLevel < 1
     3019         or vLevel > 6
     3020      then
     3021         return ?.
     3022      else
     3023         return entry(vlevel,vList).
     3024   end.
     3025   function getLevelUTDByLevelMotp return character
     3026   (iUnit as char):
     3027      define variable vLevel as integer no-undo.
     3028      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3029      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3030      vLevel = lookup(iUnit,vListMOTP).
     3031      if    vLevel eq ?
     3032         or vLevel < 1
     3033         or vLevel > 4
     3034      then
     3035         return ?.
     3036      else
     3037         return entry(vlevel,vListutd).
     3038   end.
     3039   function getLevelMotpByDM return character
     3040   (iDm as char):
     3041      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     3042   end.
     3043   function getLevelUTDByCodId return character
     3044   (iDm as char):
     3045      define variable vLevel as integer no-undo.
     3046      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3047      vLevel = getlevelByCodId(iDm).
     3048      if    vLevel eq ?
     3049         or vLevel < 1
     3050         or vLevel > 4
     3051      then
     3052         return ?.
     3053      else
     3054         return entry(vlevel,vList).
     3055   end.
     3056   function getLevelUTDByDM return character
     3057   (iDm as char):
     3058      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     3059   end.
     3060   define variable mNotMarkQnty as logical no-undo.
     3061   function getQntyUTDByCodId return decimal
     3062   (iDM as char):
     3063      define variable vLevel as integer no-undo.
     3064      define variable vList as character no-undo init "1,5,10,500".
     3065      define variable vGtin as character no-undo.
     3066      define variable vqnty as decimal no-undo init ?.
     3067      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     3068      if vqnty eq ?
     3069      then do:
     3070         if not mNotMarkQnty
     3071         then do:
     3072            define buffer marking for ub.marking.
     3073            define variable vCodident as character no-undo.
     3074            vCodident = GetCodeIdent(idm).
     3075            find first marking where marking.mark begins vCodident no-lock no-error.
     3076            if     available marking
     3077               and marking.box-qnty ne ?
     3078            then
     3079               return marking.box-qnty.
     3080         end.
     3081         vGtin = getGtinByDm(iDM).
     3082         if ChekTypeMarkByGtin (vGtin)
     3083         then do:
     3084            vLevel = getlevelByCodId(iDM).
     3085            if     vLevel >= 1
     3086               and vLevel <= 4
     3087            then
     3088               vqnty = int(entry(vlevel,vList)).
     3089         end.
     3090         else
     3091            vqnty = getQntyCodeByGtin(vgtin).
     3092      end.
     3093      return vqnty.
     3094   end.
     3095   function getQntyUTDByDM return decimal
     3096   (iDm as char):
     3097      define variable vDM as character no-undo.
     3098      if     length (iDm) ne 25
     3099         and length (iDm) ne 29
     3100         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     3101      then
     3102         vDM = substring (iDm,1,length (iDm) - 6 ).
     3103      else
     3104         vDM = substring (iDm,1,length (iDm) - 4 ).
     3105      return getQntyUTDByCodId(vDM).
     3106   end.
     3107   function getMRC4 return decimal
     3108   (iMRC as char):
     3109      define variable oMrc     as decimal no-undo init ?.
     3110      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     3111      define variable vi       as integer no-undo.
     3112      define variable vfound   as integer no-undo.
     3113      define variable vposStart   as integer no-undo.
     3114      do:
     3115      OMRc = 0.
     3116      do vi = 1 to 4:
     3117         define variable vsimb as character no-undo.
     3118         vsimb = substring(iMRC,vi,1).
     3119         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     3120         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     3121         if vfound > 0
     3122         then
     3123            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     3124         end.
     3125         OMRc = OMRc / 100.
     3126      end.
     3127      return OMRc.
     3128   end.
     3129   function getMRCByDM return decimal
     3130   (iDm as char):
     3131      define variable vMRC     as character no-undo.
     3132      define variable oMrc     as decimal no-undo init ?.
     3133      define variable Velement as character no-undo init "empty".
     3134      define variable vteg as character no-undo.
     3135      define variable vtegval as character no-undo.
     3136      if    length(idm) eq 14 + 7 + 4 + 4
     3137         or length(idm) eq 14 + 7 + 4
     3138      then do:
     3139         vMRC = substring(idm,22,4).
     3140         omrc = getMRC4(vMRC).
     3141      end.
     3142      else do:
     3143          ChekTypeMarkByDm(iDm).
     3144          block-mrc:
     3145          do while Velement ne "" and idm ne "":
     3146             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     3147             if Velement begins "8005"
     3148             then do:
     3149                vMRC = substring(Velement,5,6).
     3150                leave block-mrc.
     3151             end.
     3152             else if Velement begins "(8005)"
     3153             then do:
     3154                vMRC = substring(Velement,7,6).
     3155                leave block-mrc.
     3156             end.
     3157          end.
     3158          if vMRC ne ""
     3159          then
     3160             OMRc = dec(vmrc) / 100 no-error.
     3161      end.
     3162      return OMRc.
     3163   end.
     3164   function MoveDate return Date
     3165   (idate as date,
     3166    iMonth as int64):
     3167      define variable vMonth   as int64 no-undo.
     3168      define variable vYear    as int64 no-undo.
     3169      define variable vDateNew as date  no-undo.
     3170       define variable vDay     as int64 no-undo.
     3171       vMonth = month(iDate) + iMonth.
     3172       vYear =  year(iDate).
     3173       if vMonth <= 0
     3174       then assign
     3175          vMonth = vMonth + 12
     3176           vYear  = vYear - 1
     3177       .
     3178       else if vMonth > 12
     3179       then assign
     3180          vMonth = vMonth - 12
     3181           vYear  = vYear + 1
     3182       .
     3183       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     3184       do while error-status:error eq yes:
     3185          VDay = vDay + 1.
     3186          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     3187       end.
     3188       if VDay > 0
     3189       then
     3190          vDateNew + 1.
     3191       return vDateNew.
     3192   end.
     3193   procedure checkEMRC:
     3194   define input  parameter iDm as character no-undo.
     3195   define output parameter vok as logical   no-undo init yes.
     3196      define variable v-value-emrc as character no-undo.
     3197      define variable v-type-emrc  as character no-undo.
     3198      define variable vDateIso     as character no-undo.
     3199      define variable vMRC         as decimal no-undo.
     3200      define variable vqnty        as decimal no-undo.
     3201      define variable vPrice       as decimal no-undo.
     3202      define variable vparent      as character no-undo.
     3203      define variable vgds-code    as integer no-undo.
     3204      define buffer code for ub.code.
     3205      vMRC = getMRCByDM(iDm).
     3206      if vMRC > 0
     3207      then do:
     3208         vgds-code = getGdsCodeByDM(iDm).
     3209         vqnty     = getQntyUTDByDM(iDm).
     3210               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3211            (
     3212             input   vgds-code
     3213            ,input   'emrc-type':U
     3214            ,output   v-value-emrc
     3215            ,output   v-type-emrc
     3216          ) no-error.
     3217          if     v-value-emrc ne ""
     3218             and v-value-emrc ne ?
     3219          then do:
     3220             vDateIso = iso-date(today).
     3221             vPrice = vMRC / vqnty.
     3222             vparent ="emc" + chr(4) + v-value-emrc.
     3223             find last code where Code.parent      eq vparent
     3224                              and Code.code        le vDateIso
     3225                              and code.status_  eq 0
     3226             no-lock no-error.
     3227             if not available code or ( vPrice  >= dec(Code.CodeValue))
     3228             then
     3229                vOk = true .
     3230             else do:
     3231                 define variable vText      as character no-undo.
     3232                 define variable vDate      as date no-undo.
     3233                 define variable vDateLast  as character no-undo.
     3234                 define variable vDateFirst as character no-undo.
     3235                 define variable vDate3     as date no-undo.
     3236                 vdate = date(code.misc1).
     3237                 vDateLast = code.misc1.
     3238                 vDate3 = MoveDate(today, - 3 ).
     3239                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     3240                                      string(vDate3  , "99/99/9999"),
     3241                                      string(vDate   , "99/99/9999")
     3242                                      ).
     3243                 vdateIso = iso-date(vdate3).
     3244                 find last code  where Code.parent      eq vparent
     3245                                   and Code.code        le vDateIso
     3246                                   and code.status_  eq 0 no-lock no-error.
     3247                 if available code
     3248                 then
     3249                    vDateIso = code.code.
     3250                 vDateFirst = vDateIso.
     3251                 vDateLast = iso-date(vdate).
     3252                 define variable vGood as logical no-undo.
     3253                 define variable vDateSale as date no-undo.
     3254                 define buffer bcode for code.
     3255                 for last code where Code.parent   eq vparent
     3256                                 and code.status_  eq 0
     3257                                 and code.code     < vDateLast
     3258                                 and code.code     >= vDateFirst
     3259                 no-lock:
     3260                    find first bcode where bCode.parent   eq vparent
     3261                                       and bcode.status_  eq 0
     3262                                       and bcode.code     > code.code no-lock no-error.
     3263                    if available bcode
     3264                    then do:
     3265                       if vPrice < dec(Code.CodeValue)
     3266                       then
     3267                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     3268                                                     chr(10),
     3269                                                     string(    date( code.misc1)       ,"99/99/9999"),
     3270                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     3271                                                     ).
     3272                       else do:
     3273                          vGood = yes.
     3274                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     3275                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     3276                                                     chr(10),
     3277                                                     string(    date( code.misc1)         ,"99/99/9999"),
     3278                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     3279                                                     string(         vDateSale            ,"99/99/9999"),
     3280                                                     string(vDateSale - today)
     3281                                                     ).
     3282                       end.
     3283                    end.
     3284                 end.
     3285                 if vgood
     3286                 then do:
     3287                    define variable choice as integer no-undo .
     3288                    run gbl/d-askw.w (input "Уточнение"
     3289                           ,input  vText
     3290                           ,input "|"
     3291                           ,input "Принять|Вернуть"
     3292                           ,input "Принять данный товар|Вернуть товар постащику"
     3293                           ,input 1
     3294                           ,input 2
     3295                           ,output choice) no-error.
     3296                    vok = choice eq 1.
     3297                 end.
     3298                 else
     3299                    vok =false.
     3300             end.
     3301          end.
     3302      end.
     3303   end.
     3304   function addGs2Mark return character
     3305   (iMark as char):
     3306      define variable vDM   as character no-undo.
     3307      define variable vIdx  as integer   no-undo.
     3308      if index(iMark,chr(29),1) > 0
     3309      then return iMark.
     3310      if substring(iMark,26,4) = "8005" then
     3311      do:
     3312        vIdx = index(iMark,"93",26 + 4 + 5).
     3313        if vIdx > 1 then do:
     3314          vDM = substitute("&1&4&2&4&3",
     3315                           substring(iMark,1,25),
     3316                           substring(iMark,26,vIdx - 25 - 1),
     3317                           substring(iMark,vIdx),
     3318                           chr(29)) no-error.
     3319          vIdx = index(vDm,"240",vIdx + 4).
     3320          if vIdx > 0 then
     3321          do:
     3322            vDM = substitute("&1&3&2",
     3323                             substring(vDm,1,vIdx - 1),
     3324                             substring(vDm,vIdx),
     3325                             chr(29)) no-error.
     3326          end.
     3327        end.
     3328        else
     3329          vDM = substitute("&1&3&2",
     3330                           substring(iMark,1,25),
     3331                           substring(iMark,26),
     3332                           chr(29)) no-error.
     3333      end.
     3334      else if substring(iMark,32,2) = "91" then
     3335      do:
     3336        vIdx = index(iMark,"92",32).
     3337        if vIdx > 1 then
     3338          vDM = substitute("&1&4&2&4&3",
     3339                           substring(iMark,1,31),
     3340                           substring(iMark,32,vIdx - 31 - 1),
     3341                           substring(iMark,vIdx),
     3342                           chr(29)) no-error.
     3343        else
     3344          vDM = substitute("&1&3&2",
     3345                           substring(iMark,1,31),
     3346                           substring(iMark,32),
     3347                           chr(29)) no-error.
     3348      end.
     3349      else if substring(iMark,39,2) = "91" then
     3350      do:
     3351        vIdx = index(iMark,"92",38).
     3352        if vIdx > 1 then
     3353          vDM = substitute("&1&4&2&4&3",
     3354                           substring(iMark,1,38),
     3355                           substring(iMark,39,vIdx - 38 - 1),
     3356                           substring(iMark,vIdx),
     3357                           chr(29)) no-error.
     3358        else
     3359          vDM = substitute("&1&3&2",
     3360                           substring(iMark,1,38),
     3361                           substring(iMark,39),
     3362                           chr(29)) no-error.
     3363      end.
     3364      else if substring(iMark,25,2) = "93" then
     3365      do:
     3366        vIdx = index(iMark,"92",25).
     3367        if vIdx > 1 then
     3368          vDM = substitute("&1&4&2&4&3",
     3369                           substring(iMark,1,24),
     3370                           substring(iMark,25,vIdx - 24 - 1),
     3371                           substring(iMark,vIdx),
     3372                           chr(29)) no-error.
     3373        else
     3374          vIdx = index(iMark,"3103",25).
     3375          if vIdx > 0 then
     3376          vDM = substitute("&1&4&2&4&3",
     3377                           substring(iMark,1,24),
     3378                           substring(iMark,25,vIdx - 24 - 1),
     3379                           substring(iMark,vIdx),
     3380                           chr(29)) no-error.
     3381          else
     3382            vDM = substitute("&1&3&2",
     3383                             substring(iMark,1,24),
     3384                             substring(iMark,25),
     3385                             chr(29)) no-error.
     3386      end.
     3387      else if substring(iMark,32,2) = "93" then
     3388      do:
     3389        vDM = substitute("&1&3&2",
     3390              substring(iMark,1,31),
     3391              substring(iMark,32),
     3392              chr(29)) no-error.
     3393      end.
     3394      return if vDM <> "" then vDm else iMark.
     3395   end.
     3396   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3397   procedure partcopy :
     3398     define input parameter  p-free-output-copy as logical   no-undo .
     3399     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     3400     define parameter buffer buf_orig_parts     for ub.parts .
     3401     define parameter buffer buf_parts          for ub.parts .
     3402     define input parameter  p-mark             as character no-undo .
     3403     define variable vss-description as character no-undo init "partcopy-01: процедура копирования партии".
     3404     define variable v-value-character as character no-undo .
     3405     define variable v-value-date      as date no-undo .
     3406     define variable v-value-decimal   as decimal no-undo .
     3407     define variable v-value-integer   as integer no-undo .
     3408     define variable v-izlcstpr        as logical no-undo .
     3409     define variable v-tth             as handle no-undo .
     3410     define variable v-type            as character no-undo .
     3411     define variable part-key-rec      as character no-undo .
     3412     define variable orig-part-key-rec as character no-undo .
     3413     define variable del-part-key-rec  as character no-undo .
     3414     define variable objMarks as class excisemarks  no-undo .
     3415     define variable v-parent-mark-sts as integer   no-undo .
     3416     define variable v-mark-sts-list   as character no-undo .
     3417     define variable oMarkSts as class ibs.th.str.marking.sts.mark .
     3418     oMarkSts = objSrv:Env:Marking:Sts:Mark.
     3419     define buffer buf_gen-attr for ub.gen-attr .
     3420     define buffer buf1_gen-attr for ub.gen-attr .
     3421     define buffer buf_doc-line  for ub.doc-line .
     3422     define buffer buf_marking for ub.marking .
     3423     define buffer buf_marking-childs for ub.marking .
     3424     define buffer orig_marking-lines for ub.marking-lines .
     3425     define buffer orig_marking-lines-childs for ub.marking-lines .
     3426     define buffer buf_marking-lines for ub.marking-lines .
     3427     define buffer buf_marking-lines-childs for ub.marking-lines .
     3428     define buffer buf_marking-pack for ub.marking .
     3429     define buffer buf_marking-chk for ub.marking-chk .
     3430     define buffer buf_goods for ub.goods .
     3431     define buffer buf_trn-doc for ub.trn-doc .
     3432     define buffer pri_trn-doc for ub.trn-doc .
     3433     define buffer buf_chk-doc for ub.chk-doc .
     3434     do
     3435     on error undo, return error return-value
     3436     :
     3437       if p-free-output-copy = true
     3438       then do:
     3439         if  p-out-code <> 'free-zone':U
     3440         and p-out-code <> 'out-zone':U
     3441         then do:
     3442           message
     3443             vss-workfile vss-revision vss-description skip
     3444             vss-include-info24 skip
     3445             "Ошибка задания входных параметров процедуры partcopy" skip
     3446             "p-free-output-copy" p-free-output-copy skip
     3447             "p-out-code" p-out-code skip
     3448             view-as alert-box error .
     3449           undo, return error .
     3450         end.
     3451       end.
     3452       if buf_orig_parts.out-code <> p-out-code
     3453       then do:
     3454         find first buf_parts exclusive-lock
     3455           where buf_parts.obj-type  = buf_orig_parts.obj-type
     3456             and buf_parts.obj-code  = buf_orig_parts.obj-code
     3457             and buf_parts.artic     = buf_orig_parts.artic
     3458             and buf_parts.prod-type = buf_orig_parts.prod-type
     3459             and buf_parts.prod-code = buf_orig_parts.prod-code
     3460             and buf_parts.in-code   = buf_orig_parts.in-code
     3461             and buf_parts.out-code  = p-out-code
     3462             and buf_parts.part-code = buf_orig_parts.part-code
     3463           no-error.
     3464         if not available buf_parts
     3465         then do:
     3466           define variable v-rsrv-free as logical   no-undo .
     3467           if p-out-code = 'free-zone':U
     3468           or p-out-code = 'out-zone':U
     3469           then do:
     3470             assign
     3471               v-rsrv-free =
     3472          (if p-out-code = 'free-zone':U then yes else no)
     3473             .
     3474           end.
     3475           else do:
     3476             assign
     3477               v-rsrv-free = ?
     3478             .
     3479           end.
     3480           create buf_parts .
     3481           buffer-copy buf_orig_parts to buf_parts
     3482           assign
     3483             buf_parts.out-code  = p-out-code
     3484             buf_parts.status_   = no
     3485             buf_parts.rsrv-free = v-rsrv-free
     3486             buf_parts.qnty      = 0
     3487             buf_parts.fact-qnty = 0
     3488             buf_parts.real-qnty = 0
     3489             buf_parts.cli-qnty  = 0
     3490           .
     3491           validate buf_parts .
     3492         end.
     3493         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     3494                                           ,input (buffer buf_orig_parts:handle)
     3495                                           ,output orig-part-key-rec).
     3496         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     3497                                           ,input (buffer buf_parts:handle)
     3498                                           ,output part-key-rec).
     3499         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     3500               and ub.gen-attr.p-key =  orig-part-key-rec:
     3501             if not valid-object (objMarks)
     3502               then objMarks = new excisemarks (buf_parts.obj-type, buf_parts.obj-code).
     3503               if p-out-code = 'free-zone':U
     3504               and (entry(7,orig-part-key-rec,chr(3)) = entry(8,orig-part-key-rec,chr(3)) )
     3505                then
     3506               do:
     3507                   objMarks:CrFreeMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     3508                   if objMarks:StatusErr
     3509                       then
     3510                   do:
     3511                       message objMarks:ReturnMsg view-as alert-box error.
     3512                       delete object objMarks no-error.
     3513                       undo, return error.
     3514                   end.
     3515               end.
     3516             if (entry(7,orig-part-key-rec,chr(3)) <> entry(8,orig-part-key-rec,chr(3)) ) then
     3517             do:
     3518                 if p-mark <> "" then do:
     3519                 if p-out-code = 'free-zone':U then do:
     3520                   objMarks:RezervMarkForParts(buffer buf_parts, buffer buf_orig_parts, p-mark) .
     3521                 end.
     3522                 else do:
     3523                   objMarks:RezervMarkForParts(buffer buf_orig_parts, buffer buf_parts, p-mark) .
     3524                 end.
     3525                 if objMarks:StatusErr
     3526                   then
     3527                 do:
     3528                   message objMarks:ReturnMsg view-as alert-box error.
     3529                   delete object objMarks no-error.
     3530                   undo, return error.
     3531                 end.
     3532               end.
     3533             end.
     3534             if p-out-code = 'out-zone':U then
     3535             do:
     3536                 objMarks:CrOutMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     3537                 if objMarks:StatusErr
     3538                     then
     3539                 do:
     3540                     message objMarks:ReturnMsg view-as alert-box error.
     3541                     delete object objMarks no-error.
     3542                     undo, return error.
     3543                 end.
     3544             end.
     3545         end.
     3546         delete object objMarks no-error.
     3547         if p-mark = "news" then return .
     3548         find first pri_trn-doc no-lock where pri_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     3549         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-out-code no-error.
     3550         if not available buf_trn-doc
     3551         then
     3552            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     3553         if (
     3554             p-out-code = 'free-zone':U
     3555             and buf_orig_parts.in-code = buf_orig_parts.out-code
     3556            )
     3557         or
     3558            (
     3559             p-out-code = 'free-zone':U
     3560             and available pri_trn-doc
     3561             and (pri_trn-doc.ext-doc-type = 'iv':U or pri_trn-doc.ext-doc-type = 'rv':U)
     3562            )
     3563         or
     3564            (
     3565             available buf_trn-doc
     3566             and p-out-code = buf_trn-doc.doc-code
     3567             and buf_trn-doc.ext-doc-type = 'vt':U
     3568            )
     3569         or
     3570            (
     3571             p-mark = ""
     3572             and available buf_trn-doc
     3573             and p-out-code = 'free-zone':U
     3574             and buf_trn-doc.ext-doc-type = 'vt':U
     3575            )
     3576         or
     3577            (
     3578             p-mark = ""
     3579             and available buf_trn-doc
     3580             and p-out-code = 'free-zone':U
     3581             and buf_trn-doc.ext-doc-type = 'rs':U
     3582            )
     3583         then do :
     3584           find first ub.goods no-lock where ub.goods.artic = buf_parts.artic
     3585             and ub.goods.prod-type = buf_parts.prod-type
     3586             and ub.goods.prod-code = buf_parts.prod-code.
     3587           def buffer buf_orig_ml for ub.marking-lines.
