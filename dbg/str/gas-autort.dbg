       15   define parameter buffer buf-new_trn-doc for ub.trn-doc.
       16   define variable chg-qnty      as   decimal no-undo .
       17   define variable vss-revision as character no-undo init "$Revision: 220955104cd9, 2417, rls $":U .
       18   define variable vss-author as character no-undo init "$Author: SSlivenko $":U .
