        1   block-level on error undo, throw.
        2   using ibs.th.str.alcohol.*.
        3   define input parameter parparentproc as widget-handle no-undo.
        4   define input parameter p-log-handle as handle no-undo.
        5   define input parameter log-file-name as character no-undo.
        6   define input parameter p-auto as integer no-undo.
        7   define input parameter p-inkas-code as character no-undo.
        8   define input parameter v-curr-r-b as character no-undo.
        9   define input parameter p-cli-type as character no-undo.
       10   define input parameter p-cli-code as integer no-undo.
