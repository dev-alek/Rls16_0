     4471                 undo, return error .
     4472               end.
     4473               assign
     4474                 v-rsrv-code = 'out-zone':U
     4475               .
     4476               if buf_trn-doc.ext-doc-type  = 'ep':U
     4477               or (buf_trn-doc.ext-doc-type = 'ap':U )
     4478               or (buf_trn-doc.ext-doc-type = 'pc':U )
     4479               then do:
     4480                 assign
     4481                   v-rsrv-code = ""
     4482                 .
     4483                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4484                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     4485                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     4486                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     4487                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     4488                                                       and orig_marking-lines.part-code  = archive_parts.part-code,
     4489                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4490                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB .
     4491                 end .
     4492               end.
     4493             end.
     4494             else do:
     4495               assign
     4496                 v-rsrv-code = 'free-zone':U
     4497               .
     4498             end.
     4499             if v-rsrv-code <> ""
     4500             then do:
     4501               run partcopy in this-procedure
     4502                 (input  true
     4503                 ,input  v-rsrv-code
     4504                 ,buffer archive_parts
     4505                 ,buffer buf_parts
     4506                 ,input  ""
     4507                 ) no-error .
