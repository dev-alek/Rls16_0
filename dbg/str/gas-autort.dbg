     5233   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     5234     (input  p-artic
     5235     ,input  p-prod-type
     5236     ,input  p-prod-code
     5237     ,output v-gds-code
     5238     ) no-error .
     5239               if error-status :error
     5240               then do:
     5241                 message
     5242                   vss-workfile vss-revision vss-description skip
     5243                   vss-include-info24 skip
     5244                   "Ошибка при определении кода товара" skip
     5245                   "Документ" p-doc-code skip
     5246                   "Объект" p-obj-type p-obj-code skip
     5247                   "Артикул" p-artic p-prod-type p-prod-code skip
     5248                   "Партия" archive_parts.in-code archive_parts.part-code skip
     5249                   "Необходимо резервировать" v-need-rsrv skip
     5250                   "Резерв" v-rsrv-code skip
     5251                   "Необходимо снятие резервов" v-need-unrv skip
     5252                   "Снятие резервов" v-unrv-code skip
     5253                   error-status :get-message(1) skip
     5254                   return-value skip
     5255                   view-as alert-box error .
     5256                 undo, return error .
     5257               end.
     5258               find first buf_parts-attr no-lock
     5259                 where buf_parts-attr.in-code   = buf_parts.in-code
     5260                   and buf_parts-attr.gds-code  = v-gds-code
     5261                   and buf_parts-attr.part-code = buf_parts.part-code
     5262                 no-error .
     5263               if not available buf_parts-attr
     5264               then do:
     5265                 message
     5266                   vss-workfile vss-revision vss-description skip
     5267                   vss-include-info24 skip
     5268                   "Не найден атрибут партии" skip
     5269                   "Документ" p-doc-code skip
     5270                   "Объект" p-obj-type p-obj-code skip
     5271                   "Артикул" p-artic p-prod-type p-prod-code skip
     5272                   "Код товара" v-gds-code skip
     5273                   "Партия" archive_parts.in-code archive_parts.part-code skip
     5274                   "Необходимо резервировать" v-need-rsrv skip
     5275                   "Резерв" v-rsrv-code skip
     5276                   "Необходимо снятие резервов" v-need-unrv skip
     5277                   "Снятие резервов" v-unrv-code skip
     5278                   error-status :get-message(1) skip
     5279                   return-value skip
     5280                   view-as alert-box error .
     5281                 undo, return error .
     5282               end.
     5283               run factord-to-fact-num in this-procedure
     5284                 (input  buf_parts-attr.fact-order
     5285                 ,output v-fact-num
     5286                 ) no-error .
     5287               if error-status :error
     5288               then do:
     5289                 message
     5290                   vss-workfile vss-revision vss-description skip
     5291                   vss-include-info24 skip
     5292                   "Ошибка при определении порядкового номера партии" skip
     5293                   "Документ" p-doc-code skip
     5294                   "Объект" p-obj-type p-obj-code skip
     5295                   "Артикул" p-artic p-prod-type p-prod-code skip
     5296                   "Код товара" v-gds-code skip
     5297                   "Партия" archive_parts.in-code archive_parts.part-code skip
     5298                   "Необходимо резервировать" v-need-rsrv skip
     5299                   "Резерв" v-rsrv-code skip
     5300                   "Необходимо снятие резервов" v-need-unrv skip
     5301                   "Снятие резервов" v-unrv-code skip
     5302                   error-status :get-message(1) skip
     5303                   return-value skip
     5304                   view-as alert-box error .
     5305                 undo, return error .
     5306               end.
     5307   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run trnextdt in g#library
     5308     (input  buf_parts-attr.ext-doc-type
     5309     ,output v-doc-type
     5310     ) no-error .
     5311               if error-status :error
     5312               then do:
     5313                 message
     5314                   vss-workfile vss-revision vss-description skip
     5315                   vss-include-info24 skip
     5316                   "Ошибка при определении типа документа" skip
     5317                   "Документ" p-doc-code skip
     5318                   "Объект" p-obj-type p-obj-code skip
     5319                   "Артикул" p-artic p-prod-type p-prod-code skip
     5320                   "Код товара" v-gds-code skip
     5321                   "Партия" archive_parts.in-code archive_parts.part-code skip
     5322                   "Необходимо резервировать" v-need-rsrv skip
     5323                   "Резерв" v-rsrv-code skip
     5324                   "Необходимо снятие резервов" v-need-unrv skip
     5325                   "Снятие резервов" v-unrv-code skip
     5326                   error-status :get-message(1) skip
     5327                   return-value skip
     5328                   view-as alert-box error .
     5329                 undo, return error .
     5330               end.
     5331               assign
     5332                 buf_parts.fact-date = buf_parts-attr.fact-date
     5333                 buf_parts.fact-num  = v-fact-num
     5334                 buf_parts.doc-type  = v-doc-type
     5335               .
     5336             end.
     5337             assign
     5338               buf_parts.qnty      = buf_parts.qnty  + v-unrv-sign * archive_parts.fact-qnty
     5339               buf_parts.fact-qnty = buf_parts.qnty
     5340             .
     5341   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5342   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     5343     (input  buf_parts.artic
     5344     ,input  buf_parts.prod-type
     5345     ,input  buf_parts.prod-code
     5346     ,output v-gds-code
     5347     ) no-error .
     5348             if buf_parts.out-code = 'free-zone':U
     5349             then
     5350             for each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = v-gds-code
     5351                                                         and buf_marking-lines.obj-type = archive_parts.obj-type
     5352                                                         and buf_marking-lines.obj-code = archive_parts.obj-code
     5353                                                         and buf_marking-lines.in-code  = archive_parts.in-code
     5354                                                         and buf_marking-lines.out-code = archive_parts.out-code
     5355                                                         and buf_marking-lines.part-code = archive_parts.part-code
     5356                                                         and buf_marking-lines.prt-code = archive_parts.prt-code:
     5357               for first buf_marking exclusive-lock where buf_marking.mark = buf_marking-lines.mark :
     5358                 find first free_marking-lines no-lock where free_marking-lines.mark       = buf_marking-lines.mark
     5359                                                         and free_marking-lines.gds-code   = buf_marking-lines.gds-code
     5360                                                         and free_marking-lines.obj-type   = buf_parts.obj-type
     5361                                                         and free_marking-lines.obj-code   = buf_parts.obj-code
     5362                                                         and free_marking-lines.in-code    = buf_parts.in-code
     5363                                                         and free_marking-lines.out-code   = buf_parts.out-code
     5364                                                         and free_marking-lines.part-code  = buf_parts.part-code
     5365                                                         and free_marking-lines.prt-code   = buf_parts.prt-code
     5366                                                         no-error .
     5367                 if not available free_marking-lines
     5368                 then do :
     5369                   create free_marking-lines .
     5370                   assign
     5371                     free_marking-lines.mark       = buf_marking-lines.mark
     5372                     free_marking-lines.doc-level  = buf_marking-lines.doc-level
     5373                     free_marking-lines.gds-code   = buf_marking-lines.gds-code
     5374                     free_marking-lines.obj-type   = buf_parts.obj-type
     5375                     free_marking-lines.obj-code   = buf_parts.obj-code
     5376                     free_marking-lines.in-code    = buf_parts.in-code
     5377                     free_marking-lines.out-code   = buf_parts.out-code
     5378                     free_marking-lines.part-code  = buf_parts.part-code
     5379                     free_marking-lines.prt-code   = buf_parts.prt-code
     5380                   .
     5381                 end .
     5382                 if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_trn-doc.doc-type <> 'спи':U and
     5383                    not (buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U)
     5384                   then assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     5385                 if buf_trn-doc.ext-doc-type = 'es':U
     5386                 then do :
     5387                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB .
     5388                 end .
     5389                 for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     5390                   assign buf_marking-chk.sts = 0 .
     5391                 end .
     5392               end .
     5393               delete buf_marking-lines .
     5394             end.
     5395             if v-goods-twounit = true
     5396             then do:
     5397               assign
     5398                 buf_parts.cli-qnty = buf_parts.cli-qnty + v-unrv-sign * archive_parts.cli-qnty
     5399               .
     5400             end.
     5401             else do:
     5402               if buf_parts.cli-base-rate <> 0
     5403               then do:
     5404                 assign
     5405                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     5406                 .
     5407               end.
     5408               else do:
     5409                 assign
     5410                   buf_parts.cli-qnty = 0
     5411                 .
     5412               end.
     5413             end.
     5414             if  buf_parts.qnty      = 0
     5415             and buf_parts.fact-qnty = 0
     5416             then do:
     5417               if v-goods-twounit = true
     5418               then do:
     5419                 if buf_parts.cli-qnty <> 0
     5420                 then do:
     5421                   message
     5422                     vss-workfile vss-revision vss-description skip
     5423                     vss-include-info24 skip
     5424                     "Ошибка при удалении партии" skip
     5425                     "Документ" p-doc-code skip
     5426                     "Объект" p-obj-type p-obj-code skip
     5427                     "Артикул" p-artic p-prod-type p-prod-code skip
     5428                     "Партия" buf_parts.in-code buf_parts.part-code skip
     5429                     "Резерв" buf_parts.out-code skip
     5430                     "qnty" buf_parts.qnty skip
     5431                     "fact-qnty" buf_parts.fact-qnty skip
     5432                     "cli-qnty" buf_parts.cli-qnty skip
     5433                     view-as alert-box error .
     5434                   undo, return error .
     5435                 end.
     5436               end.
     5437               for each del_marking-lines exclusive-lock where del_marking-lines.gds-code = v-gds-code
     5438                                                           and del_marking-lines.obj-type = buf_parts.obj-type
     5439                                                           and del_marking-lines.obj-code = buf_parts.obj-code
     5440                                                           and del_marking-lines.in-code = buf_parts.in-code
     5441                                                           and del_marking-lines.out-code = buf_parts.out-code
     5442                                                           and del_marking-lines.part-code = buf_parts.part-code
     5443                                                           and del_marking-lines.prt-code = buf_parts.prt-code:
     5444                 delete del_marking-lines .
     5445               end.
     5446               run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     5447                                           ,input (buffer buf_parts:handle)
     5448                                           ,output part-key-rec).
     5449               for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     5450                                        and ub.gen-attr.p-key =  part-key-rec
     5451               :
     5452                 find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     5453                 find current buf1_gen-attr exclusive-lock.
     5454                 delete buf1_gen-attr .
     5455               end.
     5456               delete buf_parts .
     5457             end.
     5458           end.
     5459         end.
     5460       end.
     5461     end.
     5462   end procedure.
     5463   procedure partcopy-rsrv-parts :
     5464     define input  parameter p-doc-code-rowid as rowid no-undo .
     5465     define input  parameter p-parts-rowid    as rowid no-undo .
     5466     define input  parameter p-rsrv-direction as logical   no-undo .
     5467     define input  parameter p-goods-twounit  as logical   no-undo .
     5468     define input  parameter p-is-hold        as logical   no-undo .
     5469     define variable vss-description as character no-undo init "partcopy-rsrv-parts-01: процедура обработки партий при удалении документа".
     5470     define buffer buf_trn-doc for ub.trn-doc .
     5471     define buffer archive_parts for ub.parts .
     5472     define buffer buf_parts   for ub.parts .
     5473     define buffer orig_marking-lines for ub.marking-lines .
     5474     define buffer buf_marking-lines for ub.marking-lines .
     5475     define buffer buf_marking   for ub.marking .
     5476     define buffer buf_goods for ub.goods .
     5477     define variable v-rsrv-code as character no-undo .
     5478     do
     5479     on error undo, return error return-value
     5480     :
     5481       find first buf_trn-doc no-lock
     5482         where rowid(buf_trn-doc) = p-doc-code-rowid
     5483         no-error .
     5484       if not available buf_trn-doc
     5485       then do:
     5486         message
     5487           vss-workfile vss-revision vss-description skip
     5488           vss-include-info24 skip
     5489           "Ошибка задания входных параметров" skip
     5490           "Не найден документ" skip
     5491           "Документ" string(p-doc-code-rowid) skip
     5492           "Партия" string(p-parts-rowid) skip
     5493           error-status :get-message(1) skip
     5494           return-value skip
     5495           view-as alert-box error .
     5496         undo, return error .
     5497       end.
     5498       find first archive_parts
     5499         where rowid(archive_parts) = p-parts-rowid
     5500         no-error .
     5501       if not available archive_parts
     5502       then do:
     5503         message
     5504           vss-workfile vss-revision vss-description skip
     5505           vss-include-info24 skip
     5506           "Ошибка задания входных параметров" skip
     5507           "Не найдена партия" skip
     5508           "Документ" string(p-doc-code-rowid) skip
     5509           "Партия" string(p-parts-rowid) skip
     5510           error-status :get-message(1) skip
     5511           return-value skip
     5512           view-as alert-box error .
     5513         undo, return error .
     5514       end.
     5515       if  archive_parts.out-code <> archive_parts.in-code
     5516       and archive_parts.qnty <> 0
     5517       and (buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = yes ) = false
     5518       and (buf_trn-doc.doc-type = 'возврат':U and p-is-hold = true  ) = false
     5519       then do:
     5520         assign
     5521           v-rsrv-code =
     5522           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     5523         or (buf_trn-doc.doc-type = 'инв':U and archive_parts.qnty < 0)
     5524         then 'free-zone':U
     5525         else 'out-zone':U )
     5526         .
     5527         run partcopy in this-procedure
     5528           (input  true
     5529           ,input  v-rsrv-code
     5530           ,buffer archive_parts
     5531           ,buffer buf_parts
     5532           ,input  "news"
     5533           ) no-error .
     5534         if error-status :error
     5535         then do:
     5536           message
     5537             vss-workfile vss-revision vss-description skip
     5538             vss-include-info24 skip
     5539             "Ошибка при создании партии" skip
     5540             "Документ" buf_trn-doc.doc-code skip
     5541             "Объект" archive_parts.obj-type archive_parts.obj-code skip
     5542             "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     5543             "Партия" archive_parts.in-code archive_parts.part-code skip
     5544             "Количество" archive_parts.qnty skip
     5545             "Резерв" v-rsrv-code skip
     5546             error-status :get-message(1) skip
     5547             return-value skip
     5548             view-as alert-box error .
     5549           undo, return error .
     5550         end.
     5551         assign
     5552           buf_parts.qnty      = buf_parts.qnty     - abs(archive_parts.qnty)
     5553                                                     * (if p-rsrv-direction = true
     5554                                                       then 1
     5555                                                       else -1
     5556                                                       )
     5557           buf_parts.fact-qnty = buf_parts.qnty
     5558         .
     5559         find first buf_goods no-lock where buf_goods.artic = archive_parts.artic
     5560                                        and buf_goods.prod-type = archive_parts.prod-type
     5561                                        and buf_goods.prod-code = archive_parts.prod-code
     5562                                        .
     5563         for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     5564                                               and orig_marking-lines.obj-type   = archive_parts.obj-type
     5565                                               and orig_marking-lines.obj-code   = archive_parts.obj-code
     5566                                               and orig_marking-lines.in-code    = archive_parts.in-code
     5567                                               and orig_marking-lines.out-code   = archive_parts.out-code
     5568                                               and orig_marking-lines.part-code  = archive_parts.part-code
     5569                                               and orig_marking-lines.prt-code   = archive_parts.prt-code
     5570                                               :
     5571           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     5572                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
     5573                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
     5574                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
     5575                                                   and buf_marking-lines.in-code    = buf_parts.in-code
     5576                                                   and buf_marking-lines.out-code   = buf_parts.out-code
     5577                                                   and buf_marking-lines.part-code  = buf_parts.part-code
     5578                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
     5579                                                   no-error .
     5580           if available buf_marking-lines
     5581           then do :
     5582             find current buf_marking-lines exclusive-lock .
     5583             delete buf_marking-lines .
     5584             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     5585               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     5586             end .
     5587           end .
     5588           else do :
     5589             create buf_marking-lines .
     5590             assign
     5591               buf_marking-lines.mark       = orig_marking-lines.mark
     5592               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     5593               buf_marking-lines.gds-code   = buf_goods.gds-code
     5594               buf_marking-lines.obj-type   = buf_parts.obj-type
     5595               buf_marking-lines.obj-code   = buf_parts.obj-code
     5596               buf_marking-lines.in-code    = buf_parts.in-code
     5597               buf_marking-lines.out-code   = buf_parts.out-code
     5598               buf_marking-lines.part-code  = buf_parts.part-code
     5599               buf_marking-lines.prt-code   = buf_parts.prt-code
     5600             .
     5601             if buf_parts.out-code <> buf_parts.in-code
     5602             and buf_parts.out-code <> 'free-zone':U
     5603             and buf_parts.out-code <> 'out-zone':U
     5604             then do :
     5605               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     5606               if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     5607             end .
     5608             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     5609               assign
     5610                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_parts.out-code = 'free-zone':U
     5611                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB when buf_parts.out-code = 'out-zone':U
     5612               .
     5613             end .
     5614           end .
     5615           release buf_marking-lines no-error .
     5616         end.
     5617         if p-goods-twounit = true
     5618         then do:
     5619           assign
     5620             buf_parts.cli-qnty = buf_parts.cli-qnty - abs(archive_parts.cli-qnty)
     5621                                                     * (if p-rsrv-direction = true
     5622                                                       then 1
     5623                                                       else -1
     5624                                                       )
     5625           .
     5626         end.
     5627         if  buf_parts.qnty      = 0
     5628         and buf_parts.fact-qnty = 0
     5629         then do:
     5630           if p-goods-twounit = true
     5631           then do:
     5632             if buf_parts.cli-qnty <> 0
     5633             then do:
     5634               message
     5635                 vss-workfile vss-revision vss-description skip
     5636                 vss-include-info24 skip
     5637                 "Ошибка при удалении партии" skip
     5638                 "Документ" buf_trn-doc.doc-code skip
     5639                 "Объект" buf_parts.obj-type buf_parts.obj-code skip
     5640                 "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     5641                 "Партия" buf_parts.in-code buf_parts.part-code skip
     5642                 "Резерв" buf_parts.out-code skip
     5643                 "qnty" buf_parts.qnty skip
     5644                 "fact-qnty" buf_parts.fact-qnty skip
     5645                 "cli-qnty" buf_parts.cli-qnty skip
     5646                 view-as alert-box error .
     5647               undo, return error .
     5648             end.
     5649           end.
     5650           delete buf_parts .
     5651         end.
     5652       end.
     5653     end.
     5654   end procedure.
     5655   procedure partcopy-update-doc-line-tot-fact :
     5656     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     5657     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     5658     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     5659     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     5660     define variable vss-description as character no-undo init "partcopy-update-doc-line-tot-fact-01: процедура обновления средней учетной цены в строке документа".
     5661       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
     5662     define buffer buf_doc-line for ub.doc-line .
     5663     do
     5664     on error undo, return error return-value
     5665     :
     5666       find first buf_doc-line exclusive-lock
     5667         where buf_doc-line.doc-code  = p-doc-code
     5668           and buf_doc-line.artic     = p-artic
     5669           and buf_doc-line.prod-type = p-prod-type
     5670           and buf_doc-line.prod-code = p-prod-code
     5671         no-error .
     5672       if error-status :error
     5673       then do:
     5674         message
     5675           vss-workfile vss-revision vss-description skip
     5676           vss-include-info24 skip
     5677           "Ошибка задания входных параметров" skip
     5678           "Не найдена строка документа" skip
     5679           "Документ" p-doc-code skip
     5680           "Артикул" p-artic p-prod-type p-prod-code skip
     5681           error-status :get-message(1) skip
     5682           return-value skip
     5683           view-as alert-box error .
     5684         undo, return error .
     5685       end.
     5686       run partrqst in this-procedure
     5687         (input buf_doc-line.doc-code
     5688         ,input buf_doc-line.obj-type
     5689         ,input buf_doc-line.obj-code
     5690         ,input buf_doc-line.artic
     5691         ,input buf_doc-line.prod-type
     5692         ,input buf_doc-line.prod-code
     5693               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
     5694         ) no-error .
     5695       if error-status :error
     5696       then do:
     5697         message
     5698           vss-workfile vss-revision vss-description skip
     5699           vss-include-info24 skip
     5700           "Ошибка при сборе информации по партиям" skip
     5701           "Документ" p-doc-code skip
     5702           "Артикул" p-artic p-prod-type p-prod-code skip
     5703           view-as alert-box error .
     5704         undo, return error .
     5705       end.
     5706       if v-total-parts-fact-qnty <> 0
     5707       then do:
     5708         assign
     5709           buf_doc-line.price-base      = v-total-parts-price-base
     5710                                        / v-total-parts-fact-qnty
     5711           buf_doc-line.price-rubl      = v-total-parts-price-rubl
     5712                                        / v-total-parts-fact-qnty
     5713           buf_doc-line.transport-base  = v-total-parts-transport-base
     5714                                        / v-total-parts-fact-qnty
     5715           buf_doc-line.transport-rubl  = v-total-parts-transport-rubl
     5716                                        / v-total-parts-fact-qnty
     5717           buf_doc-line.other-base      = v-total-parts-other-base
     5718                                        / v-total-parts-fact-qnty
     5719           buf_doc-line.other-rubl      = v-total-parts-other-rubl
     5720                                        / v-total-parts-fact-qnty
     5721         .
     5722       end.
     5723       else do:
     5724       end.
     5725     end.
     5726   end procedure.
     5727   procedure partcopy-change-purch-code :
     5728     define input parameter  p-in-code          like ub.parts.in-code no-undo .
     5729     define input parameter  p-dest-purch-code  like ub.parts.purch-code no-undo .
     5730     define parameter buffer buf_orig_parts     for ub.parts .
     5731     define parameter buffer buf1_parts         for ub.parts .
     5732     define parameter buffer buf2_parts         for ub.parts .
     5733     define variable vss-description as character no-undo init "partcopy-change-purch-code01: процедура копирования партии при смене purch-code".
     5734     define variable var-out-code  like ub.parts.out-code no-undo .
     5735     define variable var-part-code like ub.parts.part-code no-undo .
     5736     define buffer buf_goods        for ub.goods .
     5737     define buffer buf_parts-root   for ub.parts-root.
     5738     define buffer buf_trn-doc      for ub.trn-doc.
     5739     define buffer buf-orig_trn-doc for ub.trn-doc.
     5740     define buffer buf_units        for ub.units .
     5741     do
     5742     on error undo, return error return-value
     5743     :
     5744       if buf_orig_parts.out-code = p-in-code
     5745       then do:
     5746         message
     5747           vss-workfile vss-revision vss-description skip
     5748           vss-include-info24 skip
     5749           "Ошибка задания входных параметров процедуры partcopy" skip
     5750           "buf_orig_parts.out-code" buf_orig_parts.out-code skip
     5751           "p-in-code" p-in-code skip
     5752           view-as alert-box error .
     5753         undo, return error .
     5754       end.
     5755       find first buf_trn-doc no-lock
     5756         where buf_trn-doc.doc-code = p-in-code
     5757         .
     5758       find first buf-orig_trn-doc where buf-orig_trn-doc.doc-code = buf_orig_parts.out-code.
     5759       find first buf_goods no-lock
     5760         where buf_goods.artic = buf_orig_parts.artic
     5761           and buf_goods.prod-type = buf_orig_parts.prod-type
     5762           and buf_goods.prod-code = buf_orig_parts.prod-code
     5763         .
     5764       find first buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
     5765       find first buf1_parts exclusive-lock
     5766         where buf1_parts.obj-type  = buf_orig_parts.obj-type
     5767           and buf1_parts.obj-code  = buf_orig_parts.obj-code
     5768           and buf1_parts.artic     = buf_orig_parts.artic
     5769           and buf1_parts.prod-type = buf_orig_parts.prod-type
     5770           and buf1_parts.prod-code = buf_orig_parts.prod-code
     5771           and buf1_parts.in-code   = buf_orig_parts.in-code
     5772           and buf1_parts.out-code  = p-in-code
     5773           and buf1_parts.part-code = buf_orig_parts.part-code
     5774         no-error.
     5775       if not available buf1_parts
     5776       then do:
     5777         create buf1_parts .
     5778         buffer-copy buf_orig_parts to buf1_parts
     5779         assign
     5780           buf1_parts.in-code    = buf_orig_parts.in-code
     5781           buf1_parts.out-code   = p-in-code
     5782           buf1_parts.status_    = no
     5783           buf1_parts.qnty       = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     5784           buf1_parts.fact-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     5785           buf1_parts.cli-qnty   = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.cli-qnty  else - buf_orig_parts.cli-qnty  )
     5786           buf1_parts.purch-code = buf_orig_parts.purch-code
     5787           buf1_parts.rsrv-free  = ?
     5788           buf1_parts.status_    = yes
     5789         .
     5790         validate buf1_parts .
     5791       end.
     5792       if  lookup('сер':U, buf_units.type) > 0
     5793       then do:
     5794          var-part-code = buf_orig_parts.part-code.
     5795       end.
     5796       else do:
     5797           run holdprts-get-part-code in this-procedure
     5798             (input  p-in-code
     5799             ,output var-part-code
     5800             ) no-error .
     5801           if error-status :error
     5802           then dO:
     5803             undo, return error return-value.
     5804           end.
     5805       end.
     5806       find first buf2_parts exclusive-lock
     5807         where buf2_parts.obj-type  = buf_orig_parts.obj-type
     5808           and buf2_parts.obj-code  = buf_orig_parts.obj-code
     5809           and buf2_parts.artic     = buf_orig_parts.artic
     5810           and buf2_parts.prod-type = buf_orig_parts.prod-type
     5811           and buf2_parts.prod-code = buf_orig_parts.prod-code
     5812           and buf2_parts.in-code   = p-in-code
     5813           and buf2_parts.out-code  = p-in-code
     5814           and buf2_parts.part-code = var-part-code
     5815         no-error.
     5816       if not available buf2_parts
     5817       then do:
     5818         create buf2_parts .
     5819         buffer-copy buf_orig_parts to buf2_parts
     5820         assign
     5821           buf2_parts.in-code   = p-in-code
     5822           buf2_parts.out-code  = p-in-code
     5823           buf2_parts.qnty      = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     5824           buf2_parts.fact-qnty = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     5825           buf2_parts.cli-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.cli-qnty  else buf_orig_parts.cli-qnty  )
     5826           buf2_parts.purch-code = p-dest-purch-code
     5827           buf2_parts.part-code  = var-part-code
     5828           buf2_parts.rsrv-free  = ?
     5829           buf2_parts.status_    = yes
     5830         .
     5831         validate buf2_parts .
     5832       end.
     5833       assign
     5834         buf_orig_parts.in-code    = p-in-code
     5835         buf_orig_parts.part-code  = buf2_parts.part-code
     5836         buf_orig_parts.purch-code = buf2_parts.purch-code
     5837       .
     5838       find first buf_parts-root
     5839         where buf_parts-root.doc-code       = p-in-code
     5840           and buf_parts-root.in-code        = p-in-code
     5841           and buf_parts-root.gds-code       = buf_goods.gds-code
     5842           and buf_parts-root.part-code      = buf2_parts.part-code
     5843           and buf_parts-root.orig-in-code   = buf1_parts.in-code
     5844           and buf_parts-root.orig-gds-code  = buf_goods.gds-code
     5845           and buf_parts-root.orig-part-code = buf1_parts.part-code
     5846         no-error .
     5847       if not available buf_parts-root
     5848       then do:
     5849         create buf_parts-root.
     5850         assign
     5851         buf_parts-root.doc-code       = p-in-code
     5852         buf_parts-root.in-code        = p-in-code
     5853         buf_parts-root.gds-code       = buf_goods.gds-code
     5854         buf_parts-root.part-code      = buf2_parts.part-code
     5855         buf_parts-root.orig-in-code   = buf1_parts.in-code
     5856         buf_parts-root.orig-gds-code  = buf_goods.gds-code
     5857         buf_parts-root.orig-part-code = buf1_parts.part-code
     5858         .
     5859       end.
     5860     end.
     5861   end procedure.
     5862   procedure addChildMarkingLines:
     5863     define input parameter iMark as character no-undo.
     5864     define input parameter iSts  as integer   no-undo.
     5865     define parameter buffer buf_marking-lines  for ub.marking-lines.
     5866     define parameter buffer buf_parts          for ub.parts.
     5867     define parameter buffer orig_marking-lines for ub.marking-lines.
     5868     define parameter buffer buf_orig_parts     for ub.parts.
     5869     define parameter buffer buf_goods          for ub.goods.
     5870     define buffer buf_marking-childs        for ub.marking.
     5871     define buffer buf_marking-lines-childs  for ub.marking-lines.
     5872     define buffer buf_marking-chk           for ub.marking-chk.
     5873     define buffer buf_chk-doc               for ub.chk-doc.
     5874     define buffer orig_marking-lines-childs for ub.marking-lines.
     5875     for each buf_marking-childs exclusive-lock where
     5876              buf_marking-childs.mark-parent = iMark :
     5877         find first buf_marking-lines-childs no-lock where
     5878                    buf_marking-lines-childs.mark       = buf_marking-childs.mark
     5879                and buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     5880                and buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     5881                and buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     5882                and buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     5883                and buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     5884                and buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     5885                and buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     5886         no-error .
     5887         if not available buf_marking-lines-childs then
     5888         do:
     5889           create buf_marking-lines-childs .
     5890           assign
     5891             buf_marking-lines-childs.mark       = buf_marking-childs.mark
     5892             buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     5893             buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     5894             buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     5895             buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     5896             buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     5897             buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     5898             buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     5899             buf_marking-lines-childs.fact-order = buf_marking-lines.fact-order
     5900             buf_marking-lines-childs.doc-level  = buf_marking-lines.doc-level + 1
     5901           .
     5902           validate buf_marking-childs.
     5903         end .
     5904         buf_marking-childs.sts = iSts .
     5905         for each buf_marking-chk exclusive-lock where
     5906                  buf_marking-chk.mark begins buf_marking-childs.mark
     5907         :
     5908           for first buf_chk-doc no-lock where
     5909                     buf_chk-doc.doc-code = buf_marking-chk.doc-code
     5910                 and buf_chk-doc.out-code = buf_parts.out-code
     5911           :
     5912             buf_marking-chk.sts = 0 .
     5913             validate buf_marking-chk.
     5914           end .
     5915         end .
     5916         if available orig_marking-lines
     5917         then do :
     5918           find first orig_marking-lines-childs exclusive-lock where
     5919                      orig_marking-lines-childs.mark       = buf_marking-childs.mark
     5920                  and orig_marking-lines-childs.gds-code   = buf_goods.gds-code
     5921                  and orig_marking-lines-childs.obj-type   = buf_orig_parts.obj-type
     5922                  and orig_marking-lines-childs.obj-code   = buf_orig_parts.obj-code
     5923                  and orig_marking-lines-childs.in-code    = buf_orig_parts.in-code
     5924                  and orig_marking-lines-childs.out-code   = buf_orig_parts.out-code
     5925                  and orig_marking-lines-childs.part-code  = buf_orig_parts.part-code
     5926                  and orig_marking-lines-childs.prt-code   = buf_orig_parts.prt-code
     5927           no-error .
     5928           if available orig_marking-lines-childs then
     5929             delete orig_marking-lines-childs .
     5930         end.
     5931         run addChildMarkingLines in this-procedure (
     5932           buf_marking-childs.mark,
     5933           iSts,
     5934           buffer buf_marking-lines,
     5935           buffer buf_parts,
     5936           buffer orig_marking-lines,
     5937           buffer buf_orig_parts,
     5938           buffer buf_goods
     5939         ).
     5940     end .
     5941   end.
     5942   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5943   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5944   function stsMarkWhenDeleteGoods returns integer
     5945       (input iDocCode as character,
     5946        input iMark as character):
     5947     define variable vValue as character no-undo.
     5948     define variable vType as character no-undo.
     5949     define buffer buf_trn-doc for ub.trn-doc.
     5950     define buffer buf_c-marking for ub.c-marking.
     5951     if iDocCode <> ? then
     5952     do:
     5953         find first buf_trn-doc no-lock where
     5954                    buf_trn-doc.doc-code = iDocCode no-error.
     5955         if avail buf_trn-doc then
     5956         do:
     5957   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     5958                           input 'is-return':U ,
     5959                          output vValue ,
     5960                          output vType ) no-error .
     5961            if buf_trn-doc.ext-doc-type = 'we':U or
     5962               buf_trn-doc.ext-doc-type = 'ev':U or
     5963               vValue = "yes" then
     5964            do:
     5965              find last buf_c-marking no-lock where
     5966                        buf_c-marking.mark = iMark
     5967                   use-index pi-2 no-error.
     5968              if avail buf_c-marking and
     5969                      (buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:ReturnLock:KeyIntDB or
     5970                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB or
     5971                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB or
     5972                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:Moved:KeyIntDB or
     5973                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutOfInventory:KeyIntDB) then
     5974                return buf_c-marking.sts .
     5975            end.
     5976         end.
     5977     end.
     5978     return objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     5979   end function.
     5980   procedure partrsrv :
     5981     define input parameter  p-chg-qnty      as decimal   no-undo .
     5982     define input parameter  p-goods-serial  as logical   no-undo .
     5983     define input parameter  p-goods-twounit as logical   no-undo .
     5984     define input parameter  p-unreserv-only as logical   no-undo .
     5985     define parameter buffer buf_orig_parts  for ub.parts .
     5986     define parameter buffer buf_trn-doc     for ub.trn-doc .
     5987     define output parameter p-real-chg-qnty as decimal   no-undo .
     5988     define output parameter p-parts-recid   as recid     no-undo .
     5989     define input  parameter p-mark          as character  no-undo .
     5990     define variable vss-description as character no-undo init "$Workfile$ Резервирование и снятие резервов по одной партии".
     5991     define buffer buf_parts  for ub.parts .
     5992     define buffer rsrv-parts for ub.parts .
     5993     define buffer unrsrv-parts for ub.parts .
     5994     define buffer buf_parts-attr for ub.parts-attr .
     5995     define buffer free_marking-lines for ub.marking-lines .
     5996     define variable lok                as logical   no-undo .
     5997     define variable v-sign-chg-qnty    as integer   no-undo .
     5998     define variable v-sign-rsrv-qnty   as integer   no-undo .
     5999     define variable v-rsrv-qnty        as decimal   no-undo .
     6000     define variable v-orig-unrsrv-code as character no-undo .
     6001     define variable v-new-rsrv-code    as character no-undo .
     6002     define variable v-new-unrsrv-code  as character no-undo .
     6003     define variable v-unrsrv-qnty      as decimal   no-undo .
     6004     define variable v-value-character as character no-undo .
     6005     define variable v-value-date      as date no-undo .
     6006     define variable v-value-decimal   as decimal no-undo .
     6007     define variable v-value-integer   as integer no-undo .
     6008     define variable v-izlcstpr        as logical no-undo .
     6009     define variable v-tth             as handle no-undo .
     6010     define variable v-type            as character no-undo .
     6011     define variable part-key-rec      as character no-undo .
     6012     define variable v-part-code-int   as integer no-undo .
     6013     define variable v-old-part-code   as character no-undo .
     6014     define variable v-part-gds-code   as integer   no-undo .
     6015     do transaction
     6016     on error undo, return error
     6017     :
     6018       if buf_trn-doc.ext-doc-type = 'vt':U
     6019       then do :
     6020           delete object v-tth no-error.
     6021           run adm/shattri.p (
     6022              input "get":U
     6023             ,input buf_orig_parts.obj-type
     6024             ,input buf_orig_parts.obj-code
     6025             ,input 'inv-obj':U
     6026             ,input  "izlcstpr"
     6027             ,output v-value-character
     6028             ,output v-value-date
     6029             ,output v-value-decimal
     6030             ,output v-value-integer
     6031             ,output v-izlcstpr
     6032             ,output v-type
     6033             ,INPUT-OUTPUT table-handle v-tth
     6034             ) no-error .
     6035             delete object v-tth no-error.
     6036           if error-status:error then do:
     6037             v-izlcstpr = false .
     6038           end.
     6039       end.
     6040       else do :
     6041           v-izlcstpr = false .
     6042       end.
     6043       assign
     6044         p-parts-recid = ?
     6045       .
     6046       if p-chg-qnty = 0 then do:
     6047         assign
     6048           p-parts-recid = recid(buf_orig_parts)
     6049         .
     6050         return .
     6051       end.
     6052       assign
