     1820                 buf_parts.road-tax-rubl = 0
     1821                 buf_parts.cli-base-rate = buf_doc-line.cli-base-rate
     1822                 buf_parts.exch-code     = 0
     1823                 buf_parts.price-cli     = buf_parts.price-rubl
     1824               .
     1825             end.
     1826             validate buf_parts .
     1827           end.
     1828           when "quit":u
     1829           then do:
     1830           end.
     1831         end case .
     1832       end.
     1833       if available buf_parts
     1834       then do:
     1835         if l-fact-qnty
     1836         then do:
     1837           assign
     1838             buf_parts.fact-qnty = buf_parts.fact-qnty + p-change-qnty
     1839           .
     1840         end.
     1841         else do:
     1842           assign
     1843             buf_parts.qnty      = buf_parts.qnty + p-change-qnty
     1844             buf_parts.fact-qnty = buf_parts.qnty
     1845           .
     1846           if buf_trn-doc.doc-type = 'инв':U
     1847           then do:
     1848             assign
     1849               buf_parts.rsrv-free     = ( if buf_parts.qnty < 0
     1850                                           then true
     1851                                           else false
     1852                                         )
     1853             .
     1854           end.
     1855         end.
     1856         if l-goods-twounit = true
     1857         then do:
     1858           if p-cli-qnty <> 0
     1859           then do:
     1860             assign
     1861               buf_parts.cli-qnty = p-cli-qnty
     1862             .
     1863             assign
     1864               buf_parts.cli-base-rate = buf_parts.qnty / buf_parts.cli-qnty
     1865             .
     1866           end.
     1867         end.
     1868         else do:
     1869           if buf_parts.cli-base-rate <> 0
     1870           then do:
     1871             assign
     1872               buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     1873             .
     1874           end.
     1875           else do:
     1876             assign
     1877               buf_parts.cli-qnty = 0
     1878             .
     1879           end.
     1880           if abs(buf_parts.cli-qnty - p-cli-qnty) < 0.0011
     1881           then do :
     1882             assign
     1883               buf_parts.cli-qnty = p-cli-qnty
     1884             .
     1885           end .
     1886         end.
     1887         if l-goods-twounit = false
     1888         then do:
     1889   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run qntycalc in g#library
     1890     (input  'cli-qnty'
     1891     ,input  buf_parts.cli-base-rate
     1892     ,input  buf_parts.cli-qnty
     1893     ,input  buf_parts.qnty
     1894     ,output buf_parts.cli-qnty
     1895     ,output buf_parts.qnty
     1896     ) no-error .
     1897           if error-status :error
     1898           then do:
     1899             message
     1900               "Невозможно пересчитать количество по ТТН" skip
     1901               "Документ" buf_parts.out-code skip
     1902               'Артикул':U buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     1903               "Партия" + string(buf_parts.part-code) skip
     1904               return-value skip
     1905               view-as alert-box .
     1906             undo, return error .
     1907           end.
     1908         end.
     1909         if l-goods-serial
     1910         then do:
     1911           if  buf_parts.qnty <> 0
     1912           and buf_parts.qnty <> 1
     1913           then do:
     1914             message
     1915               "Товар серийный." skip
     1916               "Невозможно порождение партии с количеством, отличным от 1."
     1917               view-as alert-box .
     1918             undo, return error .
     1919           end.
     1920         end.
     1921       end.
     1922       return .
     1923     end.
     1924   end procedure.
     1925   procedure partscr_check-valid-supp :
     1926     define input parameter  p-supp-type         like ub.parts.supp-type no-undo .
     1927     define input parameter  p-supp-code         like ub.parts.supp-code no-undo .
     1928     define input parameter  p-trn-doc-supp-type like ub.parts.supp-type no-undo .
     1929     define input parameter  p-trn-doc-supp-code like ub.parts.supp-code no-undo .
     1930     define input parameter  p-extended-doc-type as character no-undo .
     1931     define output parameter p-old-return        as logical no-undo .
     1932     define output parameter p-reason            as character no-undo .
     1933     assign
     1934       p-old-return = false
     1935       p-reason     = ""
     1936     .
     1937     if p-supp-type <> p-trn-doc-supp-type
     1938     or p-supp-code <> p-trn-doc-supp-code
     1939     then do:
     1940       if p-extended-doc-type = 're':U
     1941       or p-extended-doc-type = 'rs':U
     1942       or p-extended-doc-type = 'vt':U
     1943       or p-extended-doc-type = 'vp':U
     1944       then do:
     1945         if p-supp-type = 'чел':U
     1946         or p-supp-type = 'орг':U
     1947         then do:
     1948           assign
     1949             p-old-return = true
     1950           .
     1951         end.
     1952         else do:
     1953           assign
     1954             p-reason = "Поставщиком партии старого возврата может быть только человек или организация"
     1955           .
     1956           return .
     1957         end.
     1958       end.
     1959       else do:
     1960         assign
     1961           p-reason = "Поставщиком порожденной партии может быть только объект документа"
     1962         .
     1963         return .
     1964       end.
     1965     end.
     1966     return .
     1967   end procedure.
     1968   procedure partscr_get-default-values :
     1969     define parameter buffer buf_doc-line for ub.doc-line .
     1970     define output parameter p-vat-type   as character no-undo .
     1971     define output parameter p-vat-pc     as decimal   no-undo .
     1972     define output parameter p-slt-type   as character no-undo .
     1973     define output parameter p-slt-pc     as decimal   no-undo .
     1974     define buffer buf_trn-doc for ub.trn-doc .
     1975     define buffer buf_goods for ub.goods .
     1976     define variable v-vat-pc as decimal   no-undo .
     1977     define variable v-host-code as integer   no-undo .
     1978     do
     1979     on error undo, return error return-value
     1980     :
     1981       if not available buf_doc-line
     1982       then do:
     1983         message
     1984           vss-workfile vss-revision vss-description skip
     1985           "Ошибка задания входных параметров" skip
     1986           "Не задана строка документа" skip
     1987           view-as alert-box error .
     1988         undo, return error return-value .
     1989       end.
     1990       find first buf_trn-doc no-lock
     1991         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1992         no-error .
     1993       if not available buf_trn-doc
     1994       then do:
     1995         message
     1996           vss-workfile vss-revision vss-description skip
     1997           "Не найден документ" skip
     1998           "Код документа" buf_doc-line.doc-code skip
     1999           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     2000           view-as alert-box error .
     2001         undo, return error return-value .
     2002       end.
     2003       find first buf_goods no-lock
     2004         where buf_goods.artic     = buf_doc-line.artic
     2005           and buf_goods.prod-type = buf_doc-line.prod-type
     2006           and buf_goods.prod-code = buf_doc-line.prod-code
     2007         no-error .
     2008       if not available buf_goods
     2009       then do:
     2010         message
     2011           vss-workfile vss-revision vss-description skip
     2012           "Ошибка поиска товара" skip
     2013           "Товар" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     2014           view-as alert-box error .
     2015         undo, return error return-value .
     2016       end.
     2017       if buf_trn-doc.ext-doc-type = 'ie':U
     2018       or buf_trn-doc.ext-doc-type = 'im':U
     2019       then do:
     2020         assign
     2021           p-vat-type = buf_trn-doc.vat-type
     2022           p-vat-pc   = buf_doc-line.vat-pc
     2023           p-slt-type = buf_trn-doc.slt-type
     2024           p-slt-pc   = buf_doc-line.slt-pc
     2025         .
     2026       end.
     2027       else do:
     2028   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2029   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2030     (input  buf_doc-line.obj-type
     2031     ,input  buf_doc-line.obj-code
     2032     ,output v-host-code
     2033     )  .
     2034   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2035   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2036     (input  buf_goods.gds-code
     2037     ,input  '1':U
     2038     ,input  ?
     2039     ,input  v-host-code
     2040     ,input  buf_trn-doc.obj-type
     2041     ,input  buf_trn-doc.obj-code
     2042     ,output v-vat-pc
     2043     ) no-error .
     2044         assign
     2045           p-vat-type = 'в т. ч.':U
     2046           p-vat-pc   = v-vat-pc
     2047           p-slt-type = 'без':U
     2048           p-slt-pc   = 0
     2049         .
     2050       end.
     2051     end.
     2052   end procedure.
     2053   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2054   procedure partrqst :
     2055     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
     2056     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
     2057     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
     2058     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
     2059     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
     2060     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
     2061     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
     2062     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
     2063     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
     2064     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
     2065     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
     2066     define output parameter p-total-parts-price-base     as decimal                 no-undo .
     2067     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
     2068     define output parameter p-total-parts-transport-base as decimal                 no-undo .
     2069     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
     2070     define output parameter p-total-parts-other-base     as decimal                 no-undo .
     2071     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
     2072     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
     2073     do
     2074     on error undo, return error return-value
     2075     :
     2076       assign
     2077         p-total-parts-qnty           = 0
     2078         p-total-parts-fact-qnty      = 0
     2079         p-total-parts-cli-qnty       = 0
     2080         p-total-parts-fact-cli-qnty  = 0
     2081         p-total-parts-price-cli      = 0
     2082         p-total-parts-price-base     = 0
     2083         p-total-parts-price-rubl     = 0
     2084         p-total-parts-transport-base = 0
     2085         p-total-parts-transport-rubl = 0
     2086         p-total-parts-other-base     = 0
     2087         p-total-parts-other-rubl     = 0
     2088       .
     2089       define buffer buf_parts for ub.parts .
     2090       for each buf_parts no-lock
     2091         where buf_parts.out-code  = p-doc-code
     2092           and buf_parts.obj-type  = p-obj-type
     2093           and buf_parts.obj-code  = p-obj-code
     2094           and buf_parts.artic     = p-artic
     2095           and buf_parts.prod-type = p-prod-type
     2096           and buf_parts.prod-code = p-prod-code
     2097       on error undo, return error return-value
     2098       :
     2099         define variable v-parts-fact-multiplier as decimal   no-undo .
     2100         assign
     2101           v-parts-fact-multiplier = 1
     2102         .
     2103         if buf_parts.qnty <> 0 then do:
     2104           assign
     2105             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
     2106           .
     2107         end.
     2108         assign
     2109           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
     2110           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
     2111           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
     2112           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
     2113                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
     2114           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
     2115           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
     2116           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
     2117           p-total-parts-transport-base  = p-total-parts-transport-base
     2118                                         + buf_parts.fact-qnty
     2119                                           * (if   buf_parts.transport-base <> ?
     2120                                             then buf_parts.transport-base
     2121                                             else 0
     2122                                             )
     2123           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
     2124                                         + buf_parts.fact-qnty
     2125                                           * (if   buf_parts.transport-rubl <> ?
     2126                                             then buf_parts.transport-rubl
     2127                                             else 0
     2128                                             )
     2129           p-total-parts-other-base      = p-total-parts-other-base
     2130                                         + buf_parts.fact-qnty
     2131                                           * (if   buf_parts.other-base <> ?
     2132                                             then buf_parts.other-base
     2133                                             else 0
     2134                                             )
     2135           p-total-parts-other-rubl      = p-total-parts-other-rubl
     2136                                         + buf_parts.fact-qnty
     2137                                           * (if   buf_parts.other-rubl <> ?
     2138                                             then buf_parts.other-rubl
     2139                                             else 0
     2140                                             )
     2141         .
     2142       end.
     2143     end.
     2144   end procedure.
     2145   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2146   define new global shared variable g#trdcalib as handle no-undo.
     2147   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2148   define new shared temp-table gds-list no-undo like ub.goods
     2149     field qnty   as decimal
     2150     field to-del as logical
