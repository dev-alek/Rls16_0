     3589             and buf_orig_ml.obj-type = buf_orig_parts.obj-type
     3590             and buf_orig_ml.obj-code = buf_orig_parts.obj-code
     3591             and buf_orig_ml.in-code = buf_orig_parts.in-code
     3592             and buf_orig_ml.out-code = buf_orig_parts.out-code
     3593             and buf_orig_ml.part-code = buf_orig_parts.part-code
     3594             and buf_orig_ml.prt-code = buf_orig_parts.prt-code:
     3595             if available pri_trn-doc
     3596             and pri_trn-doc.ext-doc-type = 'iv':U
     3597             and buf_orig_ml.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     3598             then do :
     3599               for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark :
     3600                 assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     3601               end .
     3602               next .
     3603             end .
     3604             find first ub.marking-lines no-lock where ub.marking-lines.mark     = buf_orig_ml.mark
     3605                                                   and ub.marking-lines.gds-code = buf_orig_ml.gds-code
     3606                                                   and ub.marking-lines.obj-type = buf_orig_ml.obj-type
     3607                                                   and ub.marking-lines.obj-code = buf_orig_ml.obj-code
     3608                                                   and ub.marking-lines.in-code  = buf_orig_ml.in-code
     3609                                                   and ub.marking-lines.out-code = p-out-code
     3610                                                   and ub.marking-lines.part-code = buf_orig_ml.part-code
     3611                                                   and ub.marking-lines.prt-code = buf_orig_ml.prt-code
     3612                                                   no-error .
