     4638               .
     4639             end.
     4640             else do:
     4641               assign
     4642                 v-rsrv-code = 'out-zone':U
     4643               .
     4644             end.
     4645             if not v-izlcstpr
     4646             then do :
     4647                 run partcopy in this-procedure
     4648                   (input  true
     4649                   ,input  v-rsrv-code
     4650                   ,buffer archive_parts
     4651                   ,buffer buf_parts
     4652                   ,input  ""
     4653                   ) no-error .
     4654                 if error-status :error
     4655                 then do:
     4656                   message
     4657                     vss-workfile vss-revision vss-description skip
     4658                     vss-include-info24 skip
     4659                     "Ошибка при создании партии" skip
     4660                     "Документ" p-doc-code skip
     4661                     "Объект" p-obj-type p-obj-code skip
     4662                     "Артикул" p-artic p-prod-type p-prod-code skip
     4663                     "Партия" archive_parts.in-code archive_parts.part-code skip
     4664                     "Резерв" v-rsrv-code skip
     4665                     error-status :get-message(1) skip
     4666                     return-value skip
     4667                     view-as alert-box error .
     4668                   undo, return error .
     4669                 end.
     4670                 assign
     4671                   buf_parts.qnty      = buf_parts.qnty - abs(archive_parts.fact-qnty)
     4672                   buf_parts.fact-qnty = buf_parts.qnty
     4673                 .
     4674                 if buf_trn-doc.ext-doc-type = 'rv':U
     4675                 then
     4676                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4677                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     4678                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     4679                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     4680                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     4681                                                       and orig_marking-lines.part-code  = archive_parts.part-code
     4682                                                       and orig_marking-lines.prt-code   = archive_parts.prt-code,
     4683                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4684                   if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     4685                   then
