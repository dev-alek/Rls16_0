     4687                 end .
     4688                 if v-goods-twounit = true
     4689                 then do:
     4690                   message
     4691                     vss-workfile vss-revision vss-description skip
     4692                     vss-include-info24 skip
     4693                     "Запрещено порождение партий," skip
