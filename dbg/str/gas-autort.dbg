     4394                     view-as alert-box error .
     4395                   undo, return error .
     4396                 end.
     4397               end.
     4398               else do:
     4399                 if buf_parts.cli-base-rate <> 0
     4400                 then do:
     4401                   assign
     4402                     buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     4403                   .
     4404                 end.
     4405                 else do:
     4406                   assign
     4407                     buf_parts.cli-qnty = 0
     4408                   .
     4409                 end.
     4410               end.
     4411             end.
     4412             if  available buf_parts
     4413             and buf_parts.qnty      = 0
     4414             and buf_parts.fact-qnty = 0
     4415             then do:
     4416               if v-goods-twounit = true
     4417               then do:
     4418                 if buf_parts.cli-qnty <> 0
     4419                 then do:
