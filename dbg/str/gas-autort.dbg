     4695                     "Документ" p-doc-code skip
     4696                     "Объект" p-obj-type p-obj-code skip
     4697                     "Артикул" p-artic p-prod-type p-prod-code skip
     4698                     "Партия" archive_parts.in-code archive_parts.part-code skip
     4699                     "Количество по документу" archive_parts.qnty skip
     4700                     "Фактическое количество" archive_parts.fact-qnty skip
     4701                     "Клиентское количество" archive_parts.cli-qnty skip
     4702                     view-as alert-box error .
     4703                   undo, return error .
     4704                 end.
     4705                 else do:
     4706                   if buf_parts.cli-base-rate <> 0
     4707                   then do:
     4708                     assign
     4709                       buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     4710                     .
     4711                   end.
     4712                   else do:
     4713                     assign
     4714                       buf_parts.cli-qnty = 0
     4715                     .
     4716                   end.
     4717                 end.
     4718             end.
     4719           end.
     4720           get next partcopy-select-parts .
     4721         end.
     4722       end.
     4723     end.
     4724   end procedure.
     4725   procedure partcopy-update-parts-delete :
     4726     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     4727     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     4728     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     4729     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     4730     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     4731     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     4732     define variable objMarks as class excisemarks no-undo.
     4733     define variable vss-description as character no-undo init "partcopy-update-parts-delete-01: процедура обработки партий при удалении документа".
     4734     define buffer buf_trn-doc    for ub.trn-doc .
     4735     define buffer archive_parts  for ub.parts .
     4736     define buffer buf_parts      for ub.parts .
     4737     define buffer buf_parts-attr for ub.parts-attr .
     4738     define variable v-rsrv-code as character no-undo .
     4739     define variable v-unrv-code as character no-undo .
     4740     define variable v-need-rsrv as logical   no-undo .
     4741     define variable v-need-unrv as logical   no-undo .
     4742     define variable v-rsrv-sign as integer   no-undo .
     4743     define variable v-unrv-sign as integer   no-undo .
     4744     define variable v-goods-twounit as logical   no-undo .
     4745     define variable v-value-character as character no-undo .
     4746     define variable v-value-date      as date no-undo .
     4747     define variable v-value-decimal   as decimal no-undo .
     4748     define variable v-value-integer   as integer no-undo .
     4749     define variable v-izlcstpr        as logical no-undo .
     4750     define variable v-tth             as handle no-undo .
     4751     define variable v-type            as character no-undo .
     4752     define buffer buf_marking-lines for ub.marking-lines .
     4753     define buffer del_marking-lines for ub.marking-lines .
     4754     define buffer free_marking-lines for ub.marking-lines .
     4755     define buffer buf_marking for ub.marking .
     4756     define buffer buf_marking-chk for ub.marking-chk .
     4757     define buffer buf_chk-doc for ub.chk-doc .
     4758     define variable part-key-rec as character no-undo .
     4759     define variable part-key-rec_arhive   as character no-undo .
     4760     define buffer buf1_gen-attr for ub.gen-attr .
     4761     do
     4762     on error undo, return error return-value
     4763     :
     4764       find first buf_trn-doc no-lock
     4765         where buf_trn-doc.doc-code = p-doc-code
     4766         no-error .
     4767       if not available buf_trn-doc
     4768       then do:
     4769         message
     4770           vss-workfile vss-revision vss-description skip
     4771           vss-include-info24 skip
     4772           "Ошибка задания входных параметров" skip
     4773           "Не найден документ" skip
     4774           "Документ" p-doc-code skip
     4775           "Объект" p-obj-type p-obj-code skip
     4776           "Артикул" p-artic p-prod-type p-prod-code skip
     4777           error-status :get-message(1) skip
     4778           return-value skip
     4779           view-as alert-box error .
     4780         undo, return error .
     4781       end.
     4782       if buf_trn-doc.ext-doc-type = 'vt':U
     4783       then do :
     4784           delete object v-tth no-error.
     4785           run adm/shattri.p (
     4786              input "get":U
     4787             ,input buf_trn-doc.obj-type
     4788             ,input buf_trn-doc.obj-code
     4789             ,input 'inv-obj':U
     4790             ,input  "izlcstpr"
     4791             ,output v-value-character
     4792             ,output v-value-date
     4793             ,output v-value-decimal
     4794             ,output v-value-integer
     4795             ,output v-izlcstpr
     4796             ,output v-type
     4797             ,INPUT-OUTPUT table-handle v-tth
     4798             ) no-error .
     4799             delete object v-tth no-error.
     4800           if error-status:error then do:
     4801             v-izlcstpr = false .
     4802           end.
     4803       end.
     4804       else do :
     4805           v-izlcstpr = false .
