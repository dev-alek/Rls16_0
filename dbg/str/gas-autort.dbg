     6528       else do:
     6529         assign
     6530           p-parts-recid = recid(rsrv-parts)
     6531         .
     6532       end.
     6533       if  buf_parts.qnty      = 0
     6534       and buf_parts.fact-qnty = 0 then do:
     6535         if p-goods-twounit = true then do:
     6536           if buf_parts.cli-qnty <> 0 then do:
     6537             message
     6538               vss-workfile vss-revision vss-description skip
     6539               "Ошибка при удалении партии" skip
     6540               "Объект" buf_parts.obj-type buf_parts.obj-code skip
     6541               "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     6542               "Партия" buf_parts.in-code buf_parts.part-code skip
     6543               "Резерв" buf_parts.out-code skip
     6544               "qnty" buf_parts.qnty skip
     6545               "fact-qnty" buf_parts.fact-qnty skip
     6546               "cli-qnty" buf_parts.cli-qnty skip
     6547               view-as alert-box error .
     6548             undo, return error .
     6549           end.
     6550         end.
     6551         define variable part-key-rec_free as character no-undo .
     6552         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     6553                                           ,input (buffer buf_parts:handle)
     6554                                           ,output part-key-rec).
     6555         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     6556                                               and ub.gen-attr.p-key =  part-key-rec :
     6557           if (entry (8,part-key-rec,chr(3)) <> 'free-zone':U) and (entry (8,part-key-rec,chr(3)) <> entry (7,part-key-rec,chr(3))) then do:
     6558           part-key-rec_free = part-key-rec .
     6559           entry (8,part-key-rec_free,chr(3)) = 'free-zone':U .
     6560           find first buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
     6561                       and buf_gen-attr.attr-code = ub.gen-attr.attr-code
     6562                       and num-entries (buf_gen-attr.p-key, chr(3)) >= 8
     6563                       and entry(8, buf_gen-attr.p-key, chr(3)) = 'free-zone':U
     6564                       no-error .
     6565                   if not available (buf_gen-attr) then
     6566                   do:
     6567                       create buf_gen-attr.
     6568                       buffer-copy ub.gen-attr except ub.gen-attr.p-key to buf_gen-attr .
     6569                       assign
     6570                           buf_gen-attr.p-key = part-key-rec_free
     6571                           .
     6572                   end.
     6573           end.
     6574           find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     6575           find current buf1_gen-attr exclusive-lock.
     6576           delete buf1_gen-attr .
     6577         end.
     6578         release buf_gen-attr.
