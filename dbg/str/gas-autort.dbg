     6850     ( input buf-new_trn-doc.obj-code
     6851      ,input buf-new_trn-doc.obj-type
     6852      ,input buf-new_trn-doc.doc-code
     6853      ,input buf-new_doc-line.artic
     6854      ,input buf-new_doc-line.prod-code
     6855      ,input buf-new_doc-line.prod-type
     6856      ,input p-root-node
     6857      ,input false
     6858     )  .
     6859   find first buf-new_sale-gds-dtl where buf-new_sale-gds-dtl.doc-code = p-doc-code exclusive-lock.
     6860   assign
     6861   buf-new_sale-gds-dtl.price-base = buf-new_doc-line.price-base
     6862   buf-new_sale-gds-dtl.price-rubl = buf-new_doc-line.price-rubl
     6863   buf-new_sale-gds-dtl.doc-qnty = buf-new_doc-line.doc-qnty
     6864   buf-new_sale-gds-dtl.fact-qnty = buf-new_doc-line.fact-qnty.
     6865   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6866   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     6867   define variable v-ps as character no-undo .
     6868   if available buf_sale-doc then
     6869   assign
     6870   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     6871                       , chr(4)
     6872                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
     6873                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     6874                       , buf_sale-doc.chk-amount
     6875                       , buf_sale-doc.gds-amount
     6876                       , buf_sale-doc.tot-lines
     6877                       , buf_sale-doc.tot-dtl
     6878                       ).
     6879   else  do:
     6880   assign
     6881   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     6882                       , chr(4)
     6883                       , '':U
     6884                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     6885                       , 0
     6886                       , 0
     6887                       , 0
     6888                       , 0
     6889                       ).
     6890   end.
     6891   return v-ps.
     6892   END FUNCTION.
     6893   FUNCTION get-sale-doc-kind returns character (
     6894                                                input p-doc-kind as character
     6895                                              , input p-ext-doc-type as character
     6896                                              , output p-order as integer
     6897                                              , output p-msign as integer
     6898                                              , output p-main as logical
     6899                                              , output p-in-inkas as logical
     6900                                              , output p-dir_ as integer
     6901                                              ):
     6902   define variable v-doc-kind as character no-undo.
     6903   define variable v-type as character no-undo .
     6904   define variable v-value as character no-undo .
     6905   CASE p-doc-kind:
     6906     when 'es':U then do:
     6907       assign
     6908       p-order = 100
     6909       p-msign = 1
     6910       p-main = yes
     6911       p-in-inkas = yes
     6912       p-dir_ = 1
     6913       .
     6914       return p-ext-doc-type.
     6915     end.
     6916     when  'rs':U then do:
     6917       assign
     6918       p-order = 200
     6919       p-msign = - 1
     6920       p-main = no
     6921       p-in-inkas = yes
     6922       p-dir_ = - 1
     6923       .
     6924       return p-ext-doc-type.
     6925     end.
     6926     when 'rwo':U then do:
     6927       assign
     6928       p-msign = - 1
     6929       p-main = no
     6930       p-in-inkas = no
     6931       p-order = 300
     6932       p-dir_ = 1
     6933       .
     6934       return 'rwo':U.
     6935     end.
     6936     when 'trf':U then do:
     6937       assign
     6938       p-msign = 1
     6939       p-main = no
     6940       p-in-inkas = no
     6941       p-order = 400
     6942       p-dir_ = 1
     6943       .
     6944       return 'trf':U.
     6945     end.
     6946     when 'swo':U then do:
     6947      assign
     6948      p-msign = 1
     6949      p-main = no
     6950      p-in-inkas = no
     6951      p-order =  500
     6952      p-dir_ = 1
     6953      .
     6954      return 'swo':U.
     6955    end.
     6956    when 'vir':U then do:
     6957      assign
     6958      p-msign = 1
     6959      p-main = no
     6960      p-in-inkas = no
     6961      p-order = 600
     6962      p-dir_ = 1
     6963      .
     6964      return 'vir':U.
     6965    end.
     6966    when 'itr':U then do:
     6967      assign
     6968      p-msign = 1
     6969      p-main = no
     6970      p-in-inkas = no
     6971      p-order = -1
     6972      p-dir_ = -1
     6973      .
     6974     return 'itr':U.
     6975    end.
     6976    when 'ngs':U then do:
     6977      assign
     6978      p-msign = 1
     6979      p-main = no
     6980      p-in-inkas = no
     6981      p-order = 700
     6982      p-dir_ = 1
     6983      .
     6984      return 'ngs':U.
     6985    end.
     6986    when 'rgs':U then do:
     6987      assign
     6988      p-msign = -1
     6989      p-main = no
     6990      p-in-inkas = no
     6991      p-order = 701
     6992      p-dir_ = -1
     6993      .
     6994      return 'rgs':U.
     6995    end.
     6996    otherwise do:
     6997       assign
     6998       p-msign = 1
     6999       p-main = no
     7000       p-in-inkas = no
     7001       p-order = -1.
     7002       return p-ext-doc-type.
     7003     end.
     7004   END CASE.
     7005   END FUNCTION.
     7006   procedure saledoc-create :
     7007   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     7008   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     7009   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     7010   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     7011   define input parameter p-doc-kind as character no-undo .
     7012   define input parameter p-office as character no-undo .
     7013   define input parameter p-tpsidoc as logical no-undo .
     7014   define input parameter p-alias-type-price as character no-undo .
     7015   define input parameter p-price-obj-type as character no-undo .
     7016   define input parameter p-price-obj-code as integer no-undo .
     7017   define parameter buffer buf_trn-doc for ub.trn-doc.
     7018   define variable v-order as integer no-undo.
     7019   define variable v-main as logical no-undo .
     7020   define variable v-in-inkas as logical no-undo .
     7021   define variable v-msign as integer no-undo .
     7022   define variable v-dir_ as integer no-undo .
     7023   define variable v-trn-doc-code as character no-undo .
     7024   define buffer buf_sale-doc for ub.sale-doc.
     7025   main-block:
     7026   do
     7027   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     7028   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     7029   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     7030   :
     7031      if available buf_trn-doc then do:
     7032        v-trn-doc-code = buf_trn-doc.doc-code.
     7033      end.
     7034      find first buf_sale-doc where
     7035               buf_sale-doc.inkas-code = p-inkas-code
     7036           and buf_sale-doc.doc-kind = p-doc-kind
     7037           and buf_sale-doc.chr-office = p-office
     7038           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
     7039           no-error .
     7040      if not available buf_sale-doc  then do:
     7041         create buf_sale-doc.
     7042         assign
     7043         buf_sale-doc.inkas-code = p-inkas-code
     7044         buf_sale-doc.storage =  'trn-doc':U
     7045         buf_sale-doc.host-code = p-host-code
     7046         buf_sale-doc.obj-type = p-obj-type
     7047         buf_sale-doc.obj-code = p-obj-code
     7048         buf_sale-doc.doc-kind  = p-doc-kind
     7049         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
     7050         buf_sale-doc.chr-office = p-office
     7051         buf_sale-doc.doc-code = v-trn-doc-code
     7052         .
     7053      end.
     7054      if available buf_trn-doc then
     7055      buffer-copy buf_trn-doc
     7056      to buf_sale-doc
     7057      .
     7058     assign
     7059     buf_sale-doc.doc-kind = get-sale-doc-kind (
     7060                                                input p-doc-kind
     7061                                               ,input buf_sale-doc.ext-doc-type
     7062                                               ,output v-order
     7063                                               ,output v-msign
     7064                                               ,output v-main
     7065                                               ,output v-in-inkas
     7066                                               ,output v-dir_).
     7067     assign
     7068     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
     7069     buf_sale-doc.main-doc = v-main
     7070     buf_sale-doc.in-inkas = v-in-inkas
     7071     buf_sale-doc.msign = v-msign
     7072     buf_sale-doc.dir = v-dir_
     7073     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
     7074     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
     7075     buf_sale-doc.poss-wro-codes = '':U
     7076     buf_sale-doc.chr-office = p-office
     7077     buf_sale-doc.tpsidoc = p-tpsidoc
     7078     buf_sale-doc.alias-type-price = p-alias-type-price
     7079     buf_sale-doc.price-obj-type = (if p-tpsidoc
     7080                                    then p-price-obj-type
     7081                                    else '':U)
     7082     buf_sale-doc.price-obj-code = (if p-tpsidoc
     7083                                    then p-price-obj-code
     7084                                    else 0)
     7085     .
     7086     assign
     7087     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
     7088     no-error.
     7089   end.
     7090   END.
     7091   procedure fbr-saledoc-create :
     7092   define input parameter p-inkas-code as character no-undo .
     7093   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
     7094   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
     7095   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
     7096   define buffer buf_fbr-doc for ub.fbr-doc.
     7097   define buffer buf_trn-doc for ub.trn-doc.
     7098   define buffer buf_sale-doc for ub.sale-doc.
     7099   define buffer buf2_sale-doc for ub.sale-doc.
     7100   define buffer buf2_trn-doc for ub.trn-doc.
     7101   define buffer buf_doc-line for ub.doc-line.
     7102   define buffer buf_gds-dtl for ub.gds-dtl.
     7103   define buffer buf_chk-gds for ub.chk-gds.
     7104   define buffer buf_chk-doc for ub.chk-doc.
     7105   do
     7106   on error undo, return error
     7107   :
     7108     for each buf_fbr-doc no-lock where
     7109           buf_fbr-doc.out-code = p-inkas-code:
     7110       for each buf_trn-doc no-lock where
     7111             buf_trn-doc.out-code = buf_fbr-doc.doc-code
     7112       by buf_trn-doc.fact-order
     7113       on error undo, return error:
     7114         if buf_trn-doc.ext-doc-type = 'em':U
     7115         or buf_trn-doc.ext-doc-type = 'im':U
     7116         or buf_trn-doc.ext-doc-type = 'wm':U
     7117         or buf_trn-doc.ext-doc-type = 'ev':U
     7118         or buf_trn-doc.ext-doc-type = 'iv':U
     7119         then do:
     7120           find first buf_sale-doc where
     7121                   buf_sale-doc.inkas-code = p-inkas-code
     7122               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
     7123               AND buf_sale-doc.storage  = 'trn-doc':U
     7124                   no-error .
     7125           if not available buf_sale-doc then do:
     7126           create buf_sale-doc.                                                                                             buffer-copy buf_trn-doc                                                                                             to buf_sale-doc.                                                                                                assign                                                                                                                  buf_sale-doc.storage  =  'trn-doc':U                                                                          buf_sale-doc.doc-kind = buf_trn-doc.ext-doc-type                                                                buf_sale-doc.order =  - 1                                                                                          buf_sale-doc.main-doc = no                                                                                             buf_sale-doc.in-inkas = no                                                                                         buf_sale-doc.fbrsale = yes                                                                                         buf_sale-doc.msign = 1                                                                                             buf_sale-doc.filled   = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0                       buf_sale-doc.doc-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf_sale-doc.doc-qnty)                                                          buf_sale-doc.fact-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf_sale-doc.fact-qnty)                                                        buf_sale-doc.inkas-code = p-inkas-code.
     7127           end.
     7128           if buf_trn-doc.ext-doc-type = 'im':U then do:
     7129             assign
     7130             v-pri-prvo-doc-qnty = buf_trn-doc.doc-qnty
     7131             v-pri-prvo-fact-qnty = buf_trn-doc.fact-qnty
     7132             v-pri-prvo-tot-lines = buf_trn-doc.tot-lines
     7133             .
     7134           end.
     7135           for each buf2_trn-doc no-lock where
     7136                   buf2_trn-doc.out-code = buf_sale-doc.doc-code:
     7137             find first buf2_sale-doc where
     7138                     buf2_sale-doc.inkas-code = p-inkas-code
     7139                 and buf2_sale-doc.doc-code = buf2_trn-doc.doc-code
     7140                 AND buf2_sale-doc.storage = 'trn-doc':U no-error .
     7141             if not available buf2_sale-doc then do:
     7142               create buf2_sale-doc.                                                                                             buffer-copy buf2_trn-doc                                                                                             to buf2_sale-doc.                                                                                                assign                                                                                                                  buf2_sale-doc.storage  =  'trn-doc':U                                                                          buf2_sale-doc.doc-kind = buf2_trn-doc.ext-doc-type                                                                buf2_sale-doc.order =  - 1                                                                                          buf2_sale-doc.main-doc = no                                                                                             buf2_sale-doc.in-inkas = no                                                                                         buf2_sale-doc.fbrsale = yes                                                                                         buf2_sale-doc.msign = 1                                                                                             buf2_sale-doc.filled   = buf2_sale-doc.fact-qnty <> 0 or buf2_sale-doc.tot-lines <> 0                       buf2_sale-doc.doc-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf2_sale-doc.doc-qnty)                                                          buf2_sale-doc.fact-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf2_sale-doc.fact-qnty)                                                        buf2_sale-doc.inkas-code = p-inkas-code.
     7143             end.
     7144           end.
     7145         end.
     7146       end.
     7147       find first buf_sale-doc where
     7148                 buf_sale-doc.inkas-code = p-inkas-code
     7149             AND buf_sale-doc.storage = 'fbr-doc':U
     7150             AND buf_sale-doc.doc-code = buf_fbr-doc.doc-code no-error .
     7151       if not available buf_sale-doc then do:
     7152         create buf_sale-doc.
     7153         assign
     7154         buf_sale-doc.storage       =  'fbr-doc':U
     7155         buf_sale-doc.doc-type      = 'производство':U
     7156         buf_sale-doc.doc-code      = buf_fbr-doc.doc-code
     7157         buf_sale-doc.ext-doc-type  = 'производство':U
     7158         buf_sale-doc.doc-kind      = 'производство':U
     7159         buf_sale-doc.obj-type      = buf_fbr-doc.obj-type
     7160         buf_sale-doc.obj-code      = buf_fbr-doc.obj-code
     7161         buf_sale-doc.cli-type      = buf_fbr-doc.obj-type
     7162         buf_sale-doc.cli-code      = buf_fbr-doc.obj-code
     7163         buf_sale-doc.doc-qnty      = v-pri-prvo-doc-qnty
     7164         buf_sale-doc.fact-qnty     = v-pri-prvo-fact-qnty
     7165         buf_sale-doc.tot-lines     = v-pri-prvo-tot-lines
     7166         buf_sale-doc.tot-dtl       = v-pri-prvo-tot-lines
     7167         buf_sale-doc.fbrsale       = yes
     7168         buf_sale-doc.inkas-code    = p-inkas-code
     7169         .
     7170       end.
     7171     end.
     7172   end.
     7173   end procedure.
     7174   run saledoc-create in this-procedure (
     7175       input p-inkas-code,
     7176       input buf-sale_trn-doc.host-code,
     7177       input buf-sale_trn-doc.obj-type,
     7178       input buf-sale_trn-doc.obj-code,
     7179       input 'rgs':U,
     7180       input 'т':U,
     7181       input no,
     7182       input '':U,
     7183       input '':U,
     7184       input 0,
     7185       buffer buf-new_trn-doc) no-error.
     7186   find first buf_sysconf where buf_sysconf.host-code = buf-new_trn-doc.host-code no-lock.
     7187   assign
     7188   v-cntxt-rsrv-time = buf_sysconf.rsrv-time
     7189   v-cntxt-load-time = buf_sysconf.load-time
     7190   v-cntxt-holidays = buf_sysconf.holidays.
     7191   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     7192     (input  buf_goods.gds-code
     7193     ,input  'serial=request':u
     7194     ,output v-goods-serial
     7195     ) no-error .
     7196   if error-status :error
     7197   then do:
     7198     undo, return error .
     7199   end.
     7200   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     7201     (input  buf_goods.gds-code
     7202     ,input  'twounit=request':u
     7203     ,output v-goods-twounit
     7204     ) no-error .
     7205   if error-status :error
     7206   then do:
     7207     undo, return error .
     7208   end.
     7209   define variable v-real-chg-qnty like ub.parts.qnty no-undo .
     7210   run partrsrv in this-procedure
     7211     (input  v-chg-qnty
     7212     ,input  v-goods-serial
     7213     ,input  v-goods-twounit
     7214     ,input  false
     7215     ,buffer buf_parts
     7216     ,buffer buf-new_trn-doc
     7217     ,output v-real-chg-qnty
     7218     ,output v-parts-recid
     7219     ,input  ""
     7220     ) no-error .
     7221   if error-status :error
     7222   then do:
     7223     message
     7224       vss-workfile vss-revision vss-description skip
     7225       "Ошибка при резервировании партии" skip
     7226       error-status :get-message(1) skip
     7227       return-value skip
     7228       view-as alert-box error .
     7229     undo, return error .
     7230   end.
     7231   find current buf_pl-gds exclusive-lock .
     7232   assign
     7233     buf_pl-gds.free-qnty     = buf_pl-gds.free-qnty     - abs(v-real-chg-qnty)
     7234     buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty - abs(v-real-chg-qnty) * buf-new_doc-line.fact-density
     7235   .
     7236   if buf_pl-gds.free-qnty = buf_pl-gds.fact-qnty
     7237     and absolute( buf_pl-gds.cli-free-qnty - buf_pl-gds.cli-fact-qnty ) <= 0.01
     7238   then do:
     7239     assign
     7240       buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-fact-qnty
     7241     .
     7242   end.
     7243   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     7244     (input  buf-new_sale-gds-dtl.prt-code
     7245     ,output v-node-code
     7246     ) no-error .
     7247   if error-status :error then do:
     7248     message
     7249       "Ошибка при определении первого терминального признака" skip
     7250       "prt-code " buf-new_sale-gds-dtl.prt-code skip
     7251       view-as alert-box error .
     7252     undo, return error return-value .
     7253   end.
     7254   find first buf_gds-prt no-lock
