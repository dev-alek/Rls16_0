     2157     index code is         unique gds-code
     2158     index oi order-num
     2159     index isel to-sel
     2160     .
     2161   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2162   define  new shared  temp-table gds-list-hist no-undo
     2163   field list-table as character
     2164   field id as integer
     2165   field line as integer
     2166   field hist-mode as character
     2167   field des as character
     2168   field num-recs as integer
     2169   field option_ as character
     2170   field item_ as character
     2171   field status_ as character
     2172   field num-add as integer
     2173   field num-ignored as integer
     2174   field done as logical
     2175   field err_ as logical
     2176   field err-mes as character
     2177   index pi is primary
     2178   id
