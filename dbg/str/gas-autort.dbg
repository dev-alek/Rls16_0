       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define   shared variable g#auto as logical no-undo.
       84   define   shared variable g#news as logical no-undo.
       85   define   shared variable g#oxml as logical no-undo.
       86   define   shared variable g#esys as logical no-undo.
       87   define   shared variable g#news-source-db as integer no-undo.
       88   define   shared variable g#esys-source-esys as integer no-undo.
       89   define   shared variable g#db-num as integer   no-undo .
       90   define   shared variable g#userid as character no-undo .
       91   define   shared variable g#passwd as character no-undo .
       92   define new global shared variable g#lib-trn  as handle no-undo .
       93   define new global shared variable g#lib-trn2 as handle no-undo .
       94   define new global shared variable g#lib-trn3 as handle no-undo .
       95   define new global shared variable g#lib-trn4 as handle no-undo .
       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       99   define variable par-type          as character no-undo.
      100   define variable v-value-character as character no-undo .
      101   define variable v-value-date      as date      no-undo .
      102   define variable v-value-decimal   as decimal   no-undo .
      103   define variable v-value-integer   as integer   no-undo .
      104   define variable v-value-logical   as logical   no-undo .
      105   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   procedure doc-code:
      107   define input  parameter parmode          as   character           no-undo.
      108   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      109   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      110   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      111   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      112   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      113   define variable vardb-remote     as   logical             no-undo.
      114   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      115   define variable v-delimiter as character no-undo .
      116   do
      117   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      118   :
      119   find first buf_sys-ctrl no-lock .
      120   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      121     CASE parmode:
      122       when "main":u then do:
      123         if vardb-remote then do:
      124           assign
      125             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      126         end.
      127         else do:
      128           assign
      129             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      130         end.
      131       end.
      132       when "trio" then do:
      133         assign
      134           pardoc-code = replace (parroot-doc-code, "=", "*").
      135       end.
      136       otherwise do:
      137         assign
      138         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      139         no-error
      140         .
      141         if error-status:error  then do:
      142           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      143                                         ,chr(10)
      144                                         ,parmode
      145                                         ).
      146         end.
      147         if num-entries(parmode) = 1
      148         and parmode <> "chip":U
      149         and parmode <> "chip_s":U
      150         then do:
      151           assign
      152           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      153         end.
      154         else if (lookup("chip":U, parmode) > 0
      155                  or
      156                  lookup("chip_s":U, parmode) > 0) then do:
      157           assign
      158             vartemp-doc-code = parroot-doc-code.
      159           do while true:
      160             if index (vartemp-doc-code , ".") = 0 then
      161               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      162             else
      163               vartemp-doc-code  =
      164               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      165               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      166               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      167             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      168           end.
      169           assign
      170             pardoc-code = vartemp-doc-code.
      171         end.
      172       end.
      173     end CASE.
      174     if pardoc-code = '':U
      175     or (parroot-doc-code <> '':U
      176     and pardoc-code = parroot-doc-code) then do:
      177       undo, return error substitute("Ошибка при генерации номера документа&1"
      178                                     ,chr(10)).
      179     end.
      180   end.
      181   end. // procedure/method
      182   function get-doc-code-int64 returns int64
      183     ( input p-doc-code as character ) :
      184     define variable v-ind              as integer   no-undo .
      185     define variable v-num-entries      as integer   no-undo .
      186     define variable v-doc-code-int64   as int64     no-undo .
      187     define variable v-canonic-doc-code as character no-undo .
      188     assign
      189       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      190       v-canonic-doc-code = p-doc-code
      191     .
      192     do v-ind = 1 to v-num-entries
      193     :
      194       assign
      195         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      196       .
      197     end.
      198     assign
      199       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      200     .
      201     return v-doc-code-int64 .
      202   end. // function/method
      203   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      204   procedure gen-key-rec :
      205     define input  parameter p-tbl-name    as character no-undo.
      206     define input  parameter p-bh_tbl-name as handle    no-undo.
      207     define output parameter p-key-rec     as character no-undo.
      208     do
      209     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      210     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      211     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      212     :
      213       define variable fh               as handle    no-undo .
      214       define variable v-ok             as logical   no-undo .
      215       define variable v-inform         as character no-undo .
      216       define variable v-ind            as integer   no-undo .
      217       define variable v-idx-field-qnty as integer   no-undo .
      218       if p-tbl-name = ?
      219         or p-tbl-name = "":U
      220       then do:
      221         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      222       end.
      223       if not p-bh_tbl-name:available then do:
      224         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      225       end.
      226       assign
      227         p-key-rec = p-tbl-name
      228         v-inform  = p-bh_tbl-name:index-information(1)
      229         v-ind     = 2
      230       .
      231       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      232       on error undo, return error
      233       :
      234         assign
      235           v-inform = p-bh_tbl-name:index-information( v-ind )
      236           v-ind    = v-ind + 1
      237         .
      238       end.
      239       if v-inform = ?
      240         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      241         or entry( 3, v-inform, ",":U ) <> "1":U
      242       then do:
      243         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      244       end.
      245       else do:
      246         assign
      247           v-idx-field-qnty = num-entries( v-inform ) - 4
      248         .
      249         if v-idx-field-qnty < 2 then do:
      250           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      251         end.
      252         do v-ind = 1 to v-idx-field-qnty by 2
      253         on error undo, return error
      254         :
      255           assign
      256             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      257             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      258           .
      259         end.
      260       end.
      261       if p-key-rec = ? then do:
      262         assign
      263           p-key-rec = "":U
      264         .
      265         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      266       end.
      267     end.
      268     return.
      269   end procedure.
      270   procedure gen-where-keyr-tab :
      271     define input  parameter i-tableSerach as character no-undo.
      272     define input  parameter i-tablekey   as character  no-undo.
      273     define input  parameter p-key-rec    as character  no-undo.
      274     define input  parameter p-key-handle as handle     no-undo .
      275     define input  parameter p-db-name    as character  no-undo .
      276     define input  parameter p-tt-handle  as handle     no-undo .
      277     define output parameter o-Where      as character  no-undo.
      278     do
      279     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      280     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      281     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      282     :
      283       define variable v-full-tbl-name  as character no-undo .
      284       define variable bh_tbl-name      as handle    no-undo .
      285       define variable fh_key           as handle    no-undo .
      286       define variable fh_search        as handle    no-undo .
      287       define variable v-field-num      as integer   no-undo .
      288       define variable v-count-fld      as integer   no-undo .
      289       define variable v-inform         as character no-undo .
      290       define variable v-ind            as integer   no-undo .
      291       define variable v-idx-field-qnty as integer   no-undo .
      292       define variable v-field-name     as character no-undo .
      293       define variable v-field-val      as character no-undo .
      294       define variable v-word-link      as character no-undo .
      295       define variable vTable           as character no-undo.
      296       define variable bh_tbl-key       as handle    no-undo .
      297       assign
      298         p-key-rec = trim( p-key-rec )
      299       .
      300       if p-key-handle <> ? then do:
      301         if not valid-handle(p-key-handle)
      302            or p-key-handle:type <> "buffer"
      303         then do:
      304           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      305         end.
      306         if num-entries( p-key-rec, chr(3) ) > 1
      307           or p-key-rec = ?
      308           or p-key-rec = "":U
      309         then do:
      310           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      311         end.
      312       end.
      313       else do:
      314         if p-key-rec = ?
      315           or p-key-rec = "":U
      316         then do:
      317           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      318         end.
      319       end.
      320       assign
      321         vTable = entry( 1 , p-key-rec, chr(3) )
      322       .
      323       if p-tt-handle <> ?
      324         and ( not valid-handle(p-tt-handle)
      325               or p-tt-handle:type <> "buffer"
      326             )
      327       then do:
      328         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      329       end.
      330       if p-tt-handle = ? then do:
      331         assign
      332           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      333         .
      334         create buffer bh_tbl-name for table v-full-tbl-name .
      335       end.
      336       else do:
      337         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      338       end.
      339       assign
      340         v-inform = bh_tbl-name:index-information(1)
      341         v-ind    = 2
      342       .
      343       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      344       on error undo, return error
      345       :
      346         assign
      347           v-inform = bh_tbl-name:index-information( v-ind )
      348           v-ind    = v-ind + 1
      349         .
      350       end.
      351       if v-inform = ?
      352         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      353         or entry( 3, v-inform, ",":U ) <> "1":U
      354       then do:
      355         delete object bh_tbl-name no-error.
      356         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      357       end.
      358       assign
      359         v-idx-field-qnty = num-entries( v-inform ) - 4
      360       .
      361       if v-idx-field-qnty < 2 then do:
      362         delete object bh_tbl-name no-error.
      363         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      364       end.
      365       assign
      366         o-where     = "where":U
      367         v-word-link = "":U
      368         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      369         v-count-fld = 0
      370       .
      371       if i-tablekey ne "" and i-tablekey ne ?
      372       then do:
      373         assign
      374           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      375         .
      376         create buffer bh_tbl-key for table v-full-tbl-name .
      377       end.
      378       if i-tableSerach ne "" and i-tableSerach ne ?
      379       then do:
      380         delete object bh_tbl-name no-error.
      381         assign
      382           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      383         .
      384         create buffer bh_tbl-name for table v-full-tbl-name .
      385       end.
      386       block_where:
      387       do v-ind = 1 to v-idx-field-qnty by 2
      388       on error undo, return error
      389       :
      390         assign
      391           v-count-fld = v-count-fld + 1
      392         .
      393         if p-key-handle = ?
      394           and v-count-fld > v-field-num
      395         then do:
      396           leave block_where.
      397         end.
      398         define variable VfieldKeyTable as handle no-undo.
      399         assign
      400           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      401           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      402         .
      403         if     bh_tbl-key ne ?
      404         then do:
      405            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      406            if VfieldKeyTable eq ?
      407            then next block_where.
      408         end.
      409         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      410         then
      411            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      412         else
      413            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      414         if p-key-handle = ? then do:
      415           assign
      416             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      417           .
      418         end.
      419         else do:
      420           assign
      421             fh_key = p-key-handle:buffer-field( v-field-name )
      422           .
      423           if fh_key = ?
      424             or not valid-handle( fh_key )
      425           then do:
      426             delete object bh_tbl-name.
      427             if     bh_tbl-key ne ?
      428             then
      429                delete object bh_tbl-key.
      430             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      431           end.
      432           assign
      433             v-field-val = fh_key:buffer-value
      434           .
      435         end.
      436         if fh_search:data-type ="character":U then do:
      437           assign
      438             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      439             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      440             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      441             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      442             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      443             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      444             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      445             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      446             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      447             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      448             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      449             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      450             v-field-val = substitute( '"&1"', v-field-val )
      451           .
      452         end.
      453         assign
      454           o-where = substitute( "&1 &2", o-where, v-field-val )
      455         .
      456         if v-word-link = "":U then do:
      457           assign
      458             v-word-link = "and":U
      459           .
      460         end.
      461       end.
      462       delete object bh_tbl-name.
      463       if     bh_tbl-key ne ?
      464       then
      465          delete object bh_tbl-key.
      466       if p-key-handle = ?
      467         and v-count-fld <> v-field-num
      468       then do:
      469         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      470       end.
      471     end.
      472   end procedure.
      473   procedure gen-hn-keyr-tab :
      474     define input  parameter i-tableSerach as character no-undo.
      475     define input  parameter i-tablekey   as character no-undo.
      476     define input  parameter p-key-rec    as character no-undo.
      477     define input  parameter p-key-handle as handle    no-undo .
      478     define input  parameter p-db-name    as character no-undo .
      479     define input  parameter p-tt-handle  as handle    no-undo .
      480     define input  parameter p-stts-lock  as integer   no-undo .
      481     define output parameter o-hn         as handle    no-undo.
      482     define variable v-full-tbl-name as character no-undo.
      483     define variable v-where         as character no-undo.
      484     define variable bh_tbl-name     as handle    no-undo.
      485     define variable vTable          as character no-undo.
      486     do
      487     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      488     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      489     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      490         run gen-where-keyr-tab(i-tableSerach,
      491                                i-tablekey,
      492                                p-key-rec,
      493                                p-key-handle,
      494                                p-db-name,
      495                                p-tt-handle,
      496                                output v-where).
      497         if i-tableSerach ne "" and i-tableSerach ne ?
      498         then do:
      499            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      500            create buffer bh_tbl-name for table v-full-tbl-name .
      501         end.
      502         else do:
      503            if p-tt-handle = ? then do:
      504               assign
      505                  vTable = entry( 1 , p-key-rec, chr(3) )
      506               .
      507               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      508               create buffer bh_tbl-name for table v-full-tbl-name .
      509            end.
      510            else do:
      511               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      512            end.
      513         end.
      514         if p-tt-handle = ? then do:
      515            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      516         end.
      517         else do:
      518            bh_tbl-name:find-first( v-where ) no-error .
      519         end.
      520         o-hn = bh_tbl-name.
      521      end.
      522   end procedure.
      523   procedure gen-hn-keyr :
      524     define input  parameter p-key-rec    as character no-undo.
      525     define input  parameter p-key-handle as handle    no-undo .
      526     define input  parameter p-db-name    as character no-undo .
      527     define input  parameter p-tt-handle  as handle    no-undo .
      528     define input  parameter p-stts-lock  as integer   no-undo .
      529     define output parameter o-hn         as handle    no-undo.
      530     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      531   end.
      532   procedure gen-row-keyr :
      533     define input  parameter p-key-rec    as character no-undo.
      534     define input  parameter p-key-handle as handle    no-undo .
      535     define input  parameter p-db-name    as character no-undo .
      536     define input  parameter p-tt-handle  as handle    no-undo .
      537     define input  parameter p-stts-lock  as integer   no-undo .
      538     define output parameter p-tbl-row    as rowid     no-undo.
      539     define output parameter p-tbl-name   as character no-undo.
      540     define variable vHn as handle no-undo.
      541       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      542       p-tbl-row = if vHn:available then vHn:rowid else ?.
      543       p-tbl-name =  vHn:table.
      544       delete object vHn no-error.
      545     if p-tbl-row = ? then do:
      546       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      547     end.
      548     else do:
      549       return.
      550     end.
      551   end procedure.
      552   procedure gen-key-fv :
      553     define input  parameter p-key-rec    as character no-undo .
      554     define output parameter p-field-list as character no-undo .
      555     define output parameter p-value-list as character no-undo.
      556     do
      557     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      558     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      559     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      560     :
      561       define variable v-full-tbl-name  as character no-undo .
      562       define variable bh_tbl-name      as handle    no-undo .
      563       define variable v-tbl-name       as character no-undo .
      564       define variable v-field-num      as integer   no-undo .
      565       define variable v-count-fld      as integer   no-undo .
      566       define variable v-inform         as character no-undo .
      567       define variable v-ind            as integer   no-undo .
      568       define variable v-idx-field-qnty as integer   no-undo .
      569       define variable v-delim-key      as character no-undo .
      570       if p-key-rec = ?
      571         or p-key-rec = "":U
      572       then do:
      573         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      574       end.
      575       assign
      576         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      577         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      578       .
      579       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      580       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      581       assign
      582         v-inform = bh_tbl-name:index-information(1)
      583         v-ind    = 2
      584       .
      585       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      586       on error undo, return error
      587       :
      588         assign
      589           v-inform = bh_tbl-name:index-information( v-ind )
      590           v-ind    = v-ind + 1
      591         .
      592       end.
      593       if v-inform = ?
      594         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      595         or entry( 3, v-inform, ",":U ) <> "1":U
      596       then do:
      597         delete object bh_tbl-name no-error.
      598         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      599       end.
      600       assign
      601         v-idx-field-qnty = num-entries( v-inform ) - 4
      602       .
      603       if v-idx-field-qnty < 2 then do:
      604         delete object bh_tbl-name no-error.
      605         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      606       end.
      607       assign
      608         p-field-list = "":U
      609         p-value-list = "":U
      610         v-delim-key  = "":U
      611         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      612         v-count-fld  = 0
      613       .
      614       block_where:
      615       do v-ind = 1 to v-idx-field-qnty by 2
      616       on error undo, return error
      617       :
      618         assign
      619           v-count-fld = v-count-fld + 1
      620         .
      621         if v-count-fld > v-field-num then do:
      622           leave block_where.
      623         end.
      624         assign
      625           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      626           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      627         .
      628         if v-ind = 1 then do:
      629           assign
      630             v-delim-key = chr(3)
      631           .
      632         end.
      633       end.
      634       delete object bh_tbl-name.
      635       if v-count-fld <> v-field-num then do:
      636         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      637       end.
      638     end.
      639   end procedure.
      640   procedure gen-key-field :
      641     define input  parameter p-table      as character no-undo .
      642     define output parameter p-field-list as character no-undo .
      643     do
      644     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      645     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      646     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      647     :
      648       define variable v-full-tbl-name  as character no-undo .
      649       define variable bh_tbl-name      as handle    no-undo .
      650       define variable v-tbl-name       as character no-undo .
      651       define variable v-field-num      as integer   no-undo .
      652       define variable v-count-fld      as integer   no-undo .
      653       define variable v-inform         as character no-undo .
      654       define variable v-ind            as integer   no-undo .
      655       define variable v-idx-field-qnty as integer   no-undo .
      656       define variable v-delim-key      as character no-undo .
      657       if p-table = ?
      658         or p-table = "":U
      659       then do:
      660         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      661       end.
      662       assign
      663         v-tbl-name      = p-table
      664         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      665       .
      666       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      667       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      668       assign
      669         v-inform = bh_tbl-name:index-information(1)
      670         v-ind    = 2
      671       .
      672       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      673       on error undo, return error
      674       :
      675         assign
      676           v-inform = bh_tbl-name:index-information( v-ind )
      677           v-ind    = v-ind + 1
      678         .
      679       end.
      680       if v-inform = ?
      681         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      682         or entry( 3, v-inform, ",":U ) <> "1":U
      683       then do:
      684         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      685       end.
      686       assign
      687         v-idx-field-qnty = num-entries( v-inform ) - 4
      688       .
      689       if v-idx-field-qnty < 2 then do:
      690         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      691       end.
      692       assign
      693         p-field-list = "":U
      694         v-delim-key  = "":U
      695         v-count-fld  = 0
      696       .
      697       block_where:
      698       do v-ind = 1 to v-idx-field-qnty by 2
      699       on error undo, return error
      700       :
      701         assign
      702           v-count-fld = v-count-fld + 1
      703         .
      704         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      705         if v-ind = 1 then do:
      706           assign
      707             v-delim-key = chr(3)
      708           .
      709         end.
      710       end.
      711       delete object bh_tbl-name.
      712     end.
      713   end procedure.
      714   define variable vss-include-info4 as character format "x(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      715   procedure partscr :
      716     define input  parameter parparentproc      as widget-handle no-undo.
      717     define input  parameter p-db-num           as integer   no-undo .
      718     define input  parameter p-user-id          as character no-undo .
      719     define input  parameter p-supp-type        as character no-undo .
      720     define input  parameter p-supp-code        as integer   no-undo .
      721     define input  parameter p-part-code        as character no-undo .
      722     define input  parameter p-cst-code         as character no-undo .
      723     define input  parameter p-ps               as character no-undo .
      724     define input  parameter p-dop              as character no-undo .
      725     define input  parameter p-part-reserv-base as decimal   no-undo .
      726     define input  parameter p-part-reserv-rubl as decimal   no-undo .
      727     define input  parameter p-vat-type         as character no-undo .
      728     define input  parameter p-vat-pc           as decimal   no-undo .
      729     define input  parameter p-slt-type         as character no-undo .
      730     define input  parameter p-slt-pc           as decimal   no-undo .
      731     define input  parameter p-change-qnty      as decimal   no-undo .
      732     define input  parameter p-action           as character no-undo .
      733     define input  parameter p-cli-qnty         as decimal   no-undo .
      734     define input  parameter p-last-date        as date      no-undo .
      735     define input  parameter p-hold-date        as date      no-undo .
      736     define input  parameter p-pl-code          as integer   no-undo .
      737     define parameter buffer buf_doc-line       for ub.doc-line .
      738     define parameter buffer buf_parts          for ub.parts .
      739     define variable vss-description as character no-undo initial "$Workfile$ $Revision$ Процедура создания партии".
      740     define variable v-price-cli                like ub.doc-line.price-rubl no-undo.
      741     define variable v-price-cli-unit-base      like ub.doc-line.price-rubl no-undo.
      742     define variable v-price-road-tax           like ub.doc-line.price-rubl no-undo.
      743     define variable v-price-other-exp          like ub.doc-line.price-rubl no-undo.
      744     define variable v-price-transport-exp      like ub.doc-line.price-rubl no-undo.
      745     define variable v-price-without-abs        like ub.doc-line.price-rubl no-undo.
      746     define variable v-price-slt                like ub.doc-line.price-rubl no-undo.
      747     define variable v-price-no-slt             like ub.doc-line.price-rubl no-undo.
      748     define variable v-price-vat                like ub.doc-line.price-rubl no-undo.
      749     define variable v-price-no-vat-slt         like ub.doc-line.price-rubl no-undo.
      750     define variable v-price-rubl               like ub.doc-line.price-rubl no-undo.
      751     define variable v-price-road-tax-rubl      like ub.doc-line.price-rubl no-undo.
      752     define variable v-price-other-exp-rubl     like ub.doc-line.price-rubl no-undo.
      753     define variable v-price-transport-exp-rubl like ub.doc-line.price-rubl no-undo.
      754     define variable v-price-without-abs-rubl   like ub.doc-line.price-rubl no-undo.
      755     define variable v-price-slt-rubl           like ub.doc-line.price-rubl no-undo.
      756     define variable v-price-no-slt-rubl        like ub.doc-line.price-rubl no-undo.
      757     define variable v-price-vat-rubl           like ub.doc-line.price-rubl no-undo.
      758     define variable v-price-no-vat-slt-rubl    like ub.doc-line.price-rubl no-undo.
      759     define variable v-price-base               like ub.doc-line.price-base no-undo.
      760     define variable v-price-road-tax-base      like ub.doc-line.price-base no-undo.
      761     define variable v-price-other-exp-base     like ub.doc-line.price-base no-undo.
      762     define variable v-price-transport-exp-base like ub.doc-line.price-base no-undo.
      763     define variable v-price-without-abs-base   like ub.doc-line.price-base no-undo.
      764     define variable v-price-slt-base           like ub.doc-line.price-base no-undo.
      765     define variable v-price-no-slt-base        like ub.doc-line.price-base no-undo.
      766     define variable v-price-vat-base           like ub.doc-line.price-base no-undo.
      767     define variable v-price-no-vat-slt-base    like ub.doc-line.price-base no-undo.
      768     define variable l-fact-qnty              as logical   no-undo .
      769     define variable v-action                 as character no-undo .
      770     define variable l-need-create-old-return as logical   no-undo init false .
      771     define variable l-create-old-return      as logical   no-undo init false .
      772     define variable v-izlcstpr        as character no-undo .
      773     define variable l-goods-serial           as logical   no-undo .
      774     define variable l-goods-twounit          as logical   no-undo .
      775     define variable l-reserv-pl-code         as logical   no-undo .
      776     define variable l-goods-bottle           as logical   no-undo .
      777     define buffer buf_trn-doc  for ub.trn-doc .
      778     define buffer buf_goods    for ub.goods .
      779     define variable v-prompt-price       as character no-undo .
      780     define variable v-check-right        as logical   no-undo .
      781     define variable v-ind                as integer   no-undo .
      782     define variable v-num-entries-action as integer   no-undo .
      783     define variable v-option             as character no-undo .
      784     define variable v-type as character no-undo .
      785     do
      786     on error undo, return error return-value
      787     :
      788       assign
      789         v-check-right = true
      790       .
      791       if not available buf_doc-line
      792       then do:
      793         message
      794           vss-workfile vss-revision vss-description skip
      795           "Ошибка задания входных параметров" skip
      796           "Не задана строка документа" skip
      797           view-as alert-box error .
      798         undo, return error return-value .
      799       end.
      800       if p-supp-type = ?
      801       or p-supp-type = ''
      802       then do:
      803         message
      804           vss-workfile vss-revision vss-description skip
      805           "Ошибка задания входных параметров" skip
      806           "Параметр p-supp-type имеет неопределенное значение" skip
      807           "Документ" buf_doc-line.doc-code skip
      808           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      809           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      810           view-as alert-box error .
      811         undo, return error return-value .
      812       end.
      813       if p-supp-code = ?
      814       or p-supp-code = 0
      815       then do:
      816         message
      817           vss-workfile vss-revision vss-description skip
      818           "Ошибка задания входных параметров" skip
      819           "Параметр p-supp-code имеет неопределенное значение" skip
      820           "Документ" buf_doc-line.doc-code skip
      821           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      822           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      823           view-as alert-box error .
      824         undo, return error return-value .
      825       end.
      826       if p-part-code = ?
      827       then do:
      828         message
      829           vss-workfile vss-revision vss-description skip
      830           "Ошибка задания входных параметров" skip
      831           "Параметр p-part-code имеет неопределенное значение" skip
      832           "Документ" buf_doc-line.doc-code skip
      833           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      834           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      835           view-as alert-box error .
      836         undo, return error return-value .
      837       end.
      838       if p-cst-code = ?
      839       then do:
      840         message
      841           vss-workfile vss-revision vss-description skip
      842           "Ошибка задания входных параметров" skip
      843           "Параметр p-cst-code имеет неопределенное значение" skip
      844           "Документ" buf_doc-line.doc-code skip
      845           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      846           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      847           view-as alert-box error .
      848         undo, return error return-value .
      849       end.
      850       if p-ps = ?
      851       then do:
      852         message
      853           vss-workfile vss-revision vss-description skip
      854           "Ошибка задания входных параметров" skip
      855           "Параметр p-ps имеет неопределенное значение" skip
      856           "Документ" buf_doc-line.doc-code skip
      857           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      858           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      859           view-as alert-box error .
      860         undo, return error return-value .
      861       end.
      862       if p-part-reserv-base = ?
      863       then do:
      864         message
      865           vss-workfile vss-revision vss-description skip
      866           "Ошибка задания входных параметров" skip
      867           "Параметр p-part-reserv-base имеет неопределенное значение" skip
      868           "Документ" buf_doc-line.doc-code skip
      869           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      870           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      871           view-as alert-box error .
