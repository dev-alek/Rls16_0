     3773                   for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     3774                     for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     3775                                                     and buf_chk-doc.out-code = buf_parts.out-code
     3776                                                     :
     3777                       if buf_marking-chk.sts <> 2 then
