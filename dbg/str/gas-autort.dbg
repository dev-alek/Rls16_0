     3876                                                    and buf_marking-lines.part-code  = buf_parts.part-code
     3877                                                    no-error .
     3878             for each ub.marking where ub.marking.mark = buf_marking-lines.mark:
     3879               if p-out-code = 'free-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     3880                 then assign ub.marking.sts = oMarkSts:FreeZone:KeyIntDB.
     3881               if p-out-code = 'out-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     3882                 then assign ub.marking.sts = oMarkSts:OutZone:KeyIntDB.
     3883               validate ub.marking.
     3884             end.
     3885             run partcopy-to-childs-mark (buffer buf_marking-lines, buffer orig_marking-lines, input buf_parts.out-code, oMarkSts).
     3886             if available (buf_marking-lines)
     3887             then do:
     3888               assign
     3889                 buf_marking-lines.mark       = p-mark
     3890                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     3891                 buf_marking-lines.gds-code   = buf_goods.gds-code
     3892                 buf_marking-lines.obj-type   = buf_parts.obj-type
     3893                 buf_marking-lines.obj-code   = buf_parts.obj-code
     3894                 buf_marking-lines.in-code    = buf_parts.in-code
     3895                 buf_marking-lines.out-code   = buf_parts.out-code
     3896                 buf_marking-lines.part-code  = buf_parts.part-code
     3897               .
     3898               validate buf_marking-lines.
     3899             end.
     3900           end.
     3901         end.
     3902       end.
     3903       else do:
     3904         find first buf_parts exclusive-lock
     3905           where recid(buf_parts) = recid(buf_orig_parts)
     3906           .
     3907       end.
     3908       if p-out-code = 'free-zone':U
     3909       or p-out-code = 'out-zone':U
     3910       then do:
     3911         if buf_parts.rsrv-free <>
     3912          (if buf_parts.out-code = 'free-zone':U then yes else no)
     3913         then do:
     3914           message
     3915             vss-workfile vss-revision vss-description skip
     3916             vss-include-info24 skip
     3917             "Ошибка типа резерва партии" skip
     3918             "Объект" buf_parts.obj-type buf_parts.obj-code  skip
     3919             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     3920             "Партия" buf_parts.in-code buf_parts.part-code skip
     3921             "Резерв" buf_parts.out-code skip
     3922             "Статус" buf_parts.status_ skip
     3923             "Тип резерва" buf_parts.rsrv-free skip
     3924             view-as alert-box error .
     3925           undo, return error .
     3926         end.
     3927       end.
     3928     end.
     3929   end procedure.
     3930   procedure partcopy-to-childs-mark :
     3931     define parameter buffer buf_ml for ub.marking-lines .
     3932     define parameter buffer buf_orig-ml for ub.marking-lines .
     3933     define input parameter p-out-code as character no-undo .
     3934     define input parameter THMarkSts as class ibs.th.str.marking.sts.mark no-undo .
     3935     define buffer buf_ml-childs for ub.marking-lines .
     3936     for each ub.marking where ub.marking.mark-parent = buf_ml.mark:
     3937       if p-out-code = 'free-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     3938         then assign ub.marking.sts = THMarkSts:FreeZone:KeyIntDB.
     3939       if p-out-code = 'out-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     3940         then assign ub.marking.sts = THMarkSts:OutZone:KeyIntDB.
     3941       for each buf_ml-childs exclusive-lock where buf_ml-childs.mark = ub.marking.mark
     3942         and buf_ml-childs.obj-type  = buf_orig-ml.obj-type
     3943         and buf_ml-childs.obj-code  = buf_orig-ml.obj-code
     3944         and buf_ml-childs.in-code   = buf_orig-ml.in-code
     3945         and buf_ml-childs.out-code  = buf_orig-ml.out-code
     3946         and buf_ml-childs.part-code = buf_orig-ml.part-code
     3947         and buf_ml-childs.prt-code  = buf_orig-ml.prt-code
     3948         :
     3949         assign
     3950           buf_ml-childs.out-code  = p-out-code
     3951         .
     3952         run partcopy-to-childs-mark (buffer buf_ml-childs, buffer buf_orig-ml, input p-out-code, input THMarkSts).
     3953       end.
     3954     end.
     3955   end.
     3956   procedure partcopy-update-parts :
     3957     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     3958     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     3959     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     3960     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     3961     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     3962     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     3963     define variable vss-description as character no-undo init "partcopy-update-parts-01: процедура обработки партий при закрытии документа".
     3964     define buffer buf_trn-doc for ub.trn-doc .
     3965     define buffer archive_parts for ub.parts .
     3966     define buffer buf_parts   for ub.parts .
     3967     define buffer orig_marking-lines for ub.marking-lines .
     3968     define buffer buf_marking for ub.marking .
     3969     define buffer buf_goods for ub.goods .
     3970     define variable v-rsrv-code     as character no-undo .
     3971     define variable v-goods-twounit as logical   no-undo .
     3972     define variable v-value-character as character no-undo .
     3973     define variable v-value-date      as date no-undo .
     3974     define variable v-value-decimal   as decimal no-undo .
     3975     define variable v-value-integer   as integer no-undo .
     3976     define variable v-izlcstpr        as logical no-undo .
     3977     define variable v-tth             as handle no-undo .
     3978     define variable v-type            as character no-undo .
     3979     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
     3980     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     3981     do
     3982     on error undo, return error return-value
     3983     :
     3984       find first buf_trn-doc no-lock
     3985         where buf_trn-doc.doc-code = p-doc-code
     3986         no-error .
     3987       if not available buf_trn-doc
     3988       then do:
     3989         message
     3990           vss-workfile vss-revision vss-description skip
     3991           vss-include-info24 skip
     3992           "Ошибка задания входных параметров" skip
     3993           "Не найден документ" skip
     3994           "Документ" p-doc-code skip
     3995           "Объект" p-obj-type p-obj-code skip
     3996           "Артикул" p-artic p-prod-type p-prod-code skip
     3997           error-status :get-message(1) skip
     3998           return-value skip
     3999           view-as alert-box error .
     4000         undo, return error .
     4001       end.
     4002       find first buf_goods no-lock where buf_goods.artic = p-artic
     4003                                      and buf_goods.prod-type = p-prod-type
     4004                                      and buf_goods.prod-code = p-prod-code
     4005                                      no-error .
     4006       if not available buf_goods
     4007       then do:
     4008         message
     4009           vss-workfile vss-revision vss-description skip
     4010           vss-include-info24 skip
     4011           "Ошибка задания входных параметров" skip
     4012           "Не найден товар" skip
     4013           "Документ" p-doc-code skip
     4014           "Объект" p-obj-type p-obj-code skip
     4015           "Артикул" p-artic p-prod-type p-prod-code skip
     4016           error-status :get-message(1) skip
     4017           return-value skip
     4018           view-as alert-box error .
     4019         undo, return error .
     4020       end.
     4021       if buf_trn-doc.ext-doc-type = 'vt':U
     4022       then do :
     4023           delete object v-tth no-error.
     4024           run adm/shattri.p (
     4025              input "get":U
     4026             ,input buf_trn-doc.obj-type
     4027             ,input buf_trn-doc.obj-code
     4028             ,input 'inv-obj':U
     4029             ,input  "izlcstpr"
     4030             ,output v-value-character
     4031             ,output v-value-date
     4032             ,output v-value-decimal
     4033             ,output v-value-integer
     4034             ,output v-izlcstpr
     4035             ,output v-type
     4036             ,INPUT-OUTPUT table-handle v-tth
     4037             ) no-error .
     4038             delete object v-tth no-error.
     4039           if error-status:error then do:
     4040             v-izlcstpr = false .
     4041           end.
     4042       end.
     4043       else do :
     4044           v-izlcstpr = false .
     4045       end.
     4046   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4047   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4048     (input  p-artic
     4049     ,input  p-prod-type
     4050     ,input  p-prod-code
     4051     ,input  'twounit=request':u
     4052     ,output v-goods-twounit
     4053     ) no-error .
     4054       if error-status :error
     4055       then do:
     4056         message
     4057           vss-workfile vss-revision vss-description skip
     4058           vss-include-info24 skip
     4059           "Ошибка при определении атрибута товара" skip
     4060           "Артикул" p-artic p-prod-type p-prod-code skip
     4061           error-status :get-message(1) skip
     4062           return-value skip
     4063           view-as alert-box error .
     4064         undo, return error .
     4065       end.
     4066       define query partcopy-select-parts for archive_parts .
     4067       open query partcopy-select-parts preselect each archive_parts
     4068         where archive_parts.obj-type  = p-obj-type
     4069           and archive_parts.obj-code  = p-obj-code
     4070           and archive_parts.artic     = p-artic
     4071           and archive_parts.prod-type = p-prod-type
     4072           and archive_parts.prod-code = p-prod-code
     4073           and archive_parts.out-code  = p-doc-code
     4074         .
     4075       get first partcopy-select-parts .
     4076       if buf_trn-doc.doc-type = 'при':U
     4077       then do:
     4078         do while available archive_parts
     4079         on error undo, return error return-value
     4080         :
     4081           if can-do('рас,спи':U, buf_trn-doc.doc-type)
     4082           or (buf_trn-doc.doc-type = 'инв':U
     4083               and archive_parts.fact-qnty < 0)
     4084           then do:
     4085             assign
     4086               v-rsrv-code = 'out-zone':U
     4087             .
     4088           end.
     4089           else do:
     4090             assign
     4091               v-rsrv-code = 'free-zone':U
     4092             .
     4093           end.
     4094           assign
     4095             archive_parts.status_   = yes
     4096             archive_parts.rsrv-free = ?
     4097           .
     4098           if archive_parts.in-code = p-doc-code
     4099           then do:
     4100             assign
     4101               archive_parts.fact-num  = buf_trn-doc.fact-num
     4102               archive_parts.fact-date = buf_trn-doc.fact-date
     4103               archive_parts.doc-type  = buf_trn-doc.doc-type
     4104             .
     4105           end.
     4106           if archive_parts.fact-qnty <> 0
     4107           then do:
     4108             run partcopy in this-procedure
     4109               (input  true
     4110               ,input  v-rsrv-code
     4111               ,buffer archive_parts
     4112               ,buffer buf_parts
     4113               ,input  ""
     4114               ) no-error .
     4115             if error-status :error
     4116             then do:
     4117               message
     4118                 vss-workfile vss-revision vss-description skip
     4119                 vss-include-info24 skip
     4120                 "Ошибка при создании партии" skip
     4121                 "Документ" p-doc-code skip
     4122                 "Объект" p-obj-type p-obj-code skip
     4123                 "Артикул" p-artic p-prod-type p-prod-code skip
     4124                 "Партия" archive_parts.in-code archive_parts.part-code skip
     4125                 "Резерв" v-rsrv-code skip
     4126                 error-status :get-message(1) skip
     4127                 return-value skip
     4128                 view-as alert-box error .
     4129               undo, return error .
     4130             end.
     4131             assign
     4132               buf_parts.qnty      = buf_parts.qnty     + archive_parts.fact-qnty
     4133               buf_parts.fact-qnty = buf_parts.qnty
     4134             .
     4135             if v-goods-twounit = true
     4136             then do:
     4137               assign
     4138                 buf_parts.cli-qnty = buf_parts.cli-qnty + archive_parts.cli-qnty
     4139               .
     4140               case buf_trn-doc.ext-doc-type :
     4141                 when 'ie':U
     4142                 then do:
     4143                   if archive_parts.cli-qnty <> truncate(archive_parts.cli-qnty, 0 )
     4144                   then do:
     4145                     message
     4146                       vss-workfile vss-revision vss-description skip
     4147                       vss-include-info24 skip
     4148                       "Клиентское количество для товара," skip
     4149                       "который учитывается по двум единицам измерения" skip
     4150                       "должно равняться единице" skip
     4151                       "Документ" p-doc-code skip
     4152                       "Объект" p-obj-type p-obj-code skip
     4153                       "Артикул" p-artic p-prod-type p-prod-code skip
     4154                       "Партия" archive_parts.in-code archive_parts.part-code skip
     4155                       "Количество по документу" archive_parts.qnty skip
     4156                       "Фактическое количество" archive_parts.fact-qnty skip
     4157                       "Клиентское количество" archive_parts.cli-qnty skip
     4158                       view-as alert-box error .
     4159                     undo, return error .
     4160                   end.
     4161                 end.
     4162                 when 'iv':U
     4163                 then do:
     4164                   if archive_parts.cli-qnty <> 1
     4165                   then do:
     4166                     message
     4167                       vss-workfile vss-revision vss-description skip
     4168                       vss-include-info24 skip
     4169                       "Клиентское количество для товара," skip
     4170                       "который учитывается по двум единицам измерения" skip
     4171                       "должно равняться единице" skip
     4172                       "Документ" p-doc-code skip
     4173                       "Объект" p-obj-type p-obj-code skip
     4174                       "Артикул" p-artic p-prod-type p-prod-code skip
     4175                       "Партия" archive_parts.in-code archive_parts.part-code skip
     4176                       "Количество по документу" archive_parts.qnty skip
     4177                       "Фактическое количество" archive_parts.fact-qnty skip
     4178                       "Клиентское количество" archive_parts.cli-qnty skip
     4179                       view-as alert-box error .
     4180                     undo, return error .
     4181                   end.
     4182                 end.
     4183                 otherwise do:
     4184                   message
     4185                     vss-workfile vss-revision vss-description skip
     4186                     vss-include-info24 skip
     4187                     "Товар учитывается по двум единицам измерения" skip
     4188                     "Для приходов разрешен только внешний приход или приход перемещение" skip
     4189                     "Документ" p-doc-code skip
     4190                     "Объект" p-obj-type p-obj-code skip
     4191                     "Артикул" p-artic p-prod-type archive_parts.prod-code skip
     4192                     "Партия" archive_parts.in-code archive_parts.part-code skip
     4193                     "Количество по документу" archive_parts.qnty skip
     4194                     "Фактическое количество" archive_parts.fact-qnty skip
     4195                     "Клиентское количество" archive_parts.cli-qnty skip
     4196                     view-as alert-box error .
     4197                   undo, return error .
     4198                 end.
     4199               end.
     4200             end.
     4201             else do:
     4202               if buf_parts.cli-base-rate <> 0
     4203               then do:
     4204                 assign
     4205                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     4206                 .
     4207               end.
     4208               else do:
     4209                 assign
     4210                   buf_parts.cli-qnty = 0
     4211                 .
     4212               end.
     4213             end.
     4214             if  buf_parts.qnty      = 0
     4215             and buf_parts.fact-qnty = 0
     4216             then do:
     4217               if v-goods-twounit = true
     4218               then do:
     4219                 if buf_parts.cli-qnty <> 0
     4220                 then do:
     4221                   message
     4222                     vss-workfile vss-revision vss-description skip
     4223                     vss-include-info24 skip
     4224                     "Ошибка при удалении партии" skip
     4225                     "Документ" p-doc-code skip
     4226                     "Объект" p-obj-type p-obj-code skip
     4227                     "Артикул" p-artic p-prod-type p-prod-code skip
     4228                     "Партия" buf_parts.in-code buf_parts.part-code skip
     4229                     "Резерв" buf_parts.out-code skip
     4230                     "qnty" buf_parts.qnty skip
     4231                     "fact-qnty" buf_parts.fact-qnty skip
     4232                     "cli-qnty" buf_parts.cli-qnty skip
     4233                     view-as alert-box error .
     4234                   undo, return error .
     4235                 end.
     4236               end.
     4237               delete buf_parts .
     4238             end.
     4239           end.
     4240           else do :
     4241             if buf_trn-doc.ext-doc-type = 'iv':U
     4242             then
     4243             for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4244                                                   and orig_marking-lines.obj-type   = archive_parts.obj-type
     4245                                                   and orig_marking-lines.obj-code   = archive_parts.obj-code
     4246                                                   and orig_marking-lines.in-code    = archive_parts.in-code
     4247                                                   and orig_marking-lines.out-code   = archive_parts.out-code
     4248                                                   and orig_marking-lines.part-code  = archive_parts.part-code,
     4249             first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4250               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     4251             end .
     4252           end .
     4253           get next partcopy-select-parts .
     4254         end.
     4255       end.
     4256       if buf_trn-doc.doc-type = 'рас':U
     4257       or buf_trn-doc.doc-type = 'спи':U
     4258       or buf_trn-doc.doc-type = 'возврат':U
     4259       or buf_trn-doc.doc-type = 'инв':U
     4260       then do:
     4261         do while available archive_parts
     4262         on error undo, return error return-value
     4263         :
     4264           assign
     4265             archive_parts.status_   = yes
     4266             archive_parts.rsrv-free = ?
     4267           .
     4268           if archive_parts.fact-qnty <> archive_parts.qnty
     4269           then do:
     4270             define variable v-is-hold as logical   no-undo .
     4271   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4272   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     4273     (input  buf_trn-doc.doc-code
     4274     ,output v-is-hold
     4275     ) no-error .
     4276             if error-status :error
     4277             then do:
     4278               message
     4279                 vss-workfile vss-revision vss-description skip
     4280                 vss-include-info24
     4281                 "Ошибка при определении типа документа hold-doc.i" skip
     4282                 "Документ" p-doc-code skip
     4283                 "Объект" p-obj-type p-obj-code skip
     4284                 "Артикул" p-artic p-prod-type p-prod-code skip
     4285                 error-status :get-message(1) skip
     4286                 return-value skip
     4287                 view-as alert-box error .
     4288               undo, return error .
     4289             end.
     4290             if buf_trn-doc.ext-doc-type = 'vt':U
     4291             or (buf_trn-doc.ext-doc-type = 're':U and v-is-hold = true)
     4292             or buf_trn-doc.ext-doc-type = 'ap':U
     4293             or buf_trn-doc.ext-doc-type = 'pc':U
     4294             or buf_trn-doc.ext-doc-type = 'mp':U
     4295             or  buf_trn-doc.ext-doc-type = 'vp':U
     4296             then do:
     4297               message
     4298                 vss-workfile vss-revision vss-description skip
     4299                 vss-include-info24 skip
     4300                 "Фактическое количество не может отличаться от количества по документу" skip
     4301                 "для документов инвентаризации, внутреннего возврата и автоматического возврата между фирмами" skip
     4302                 "Документ" p-doc-code skip
     4303                 "Объект" p-obj-type p-obj-code skip
     4304                 "Артикул" p-artic p-prod-type p-prod-code skip
     4305                 "Партия" archive_parts.in-code archive_parts.part-code skip
     4306                 "Количество по документу" archive_parts.qnty skip
     4307                 "Фактическое количество" archive_parts.fact-qnty skip
     4308                 "Клиентское количество" archive_parts.cli-qnty skip
     4309                 view-as alert-box error .
     4310               undo, return error .
     4311             end.
     4312             if archive_parts.in-code <> archive_parts.out-code
     4313             then do:
     4314               if can-do('рас,спи':U,buf_trn-doc.doc-type)
     4315               or (buf_trn-doc.doc-type = 'инв':U
     4316                   and archive_parts.fact-qnty < 0)
     4317               then do:
     4318                 assign
     4319                   v-rsrv-code = 'free-zone':U
     4320                 .
     4321               end.
     4322               else do:
     4323                 assign
     4324                   v-rsrv-code = 'out-zone':U
     4325                 .
     4326               end.
     4327               run partcopy in this-procedure
     4328                 (input  true
     4329                 ,input  v-rsrv-code
     4330                 ,buffer archive_parts
     4331                 ,buffer buf_parts
     4332                 ,input  ""
     4333                 ) no-error .
     4334               if error-status :error
