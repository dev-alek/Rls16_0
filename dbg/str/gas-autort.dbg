     4523               end.
     4524               assign
     4525                 buf_parts.qnty      = buf_parts.qnty + abs(archive_parts.fact-qnty)
     4526                 buf_parts.fact-qnty = buf_parts.qnty
     4527               .
     4528               if v-goods-twounit = true
