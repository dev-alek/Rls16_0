     3617               assign
     3618                 ub.marking-lines.out-code  = p-out-code
     3619                 ub.marking-lines.fact-order = pri_trn-doc.fact-order when available pri_trn-doc
     3620               .
     3621               validate ub.marking-lines.
     3622             end .
     3623             if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U then do:
     3624             for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark
     3625               and not (buf_marking.sts = oMarkSts:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U):
     3626               if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB and
     3627                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB and
     3628                  not can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) and
     3629                  not can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) and
     3630                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     3631               then do:
     3632                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     3633                 validate buf_marking.
     3634               end.
     3635             end .
     3636           end .
     3637           end.
     3638         end .
     3639         define variable v-doc-type  as character no-undo .
     3640         define variable   v-status    as character no-undo .
     3641         define variable v-fact-qnty   as  decimal no-undo .
     3642         define variable ii    as integer no-undo .
     3643         find first buf_goods no-lock where buf_goods.artic = buf_orig_parts.artic
     3644                                        and buf_goods.prod-type = buf_orig_parts.prod-type
     3645                                        and buf_goods.prod-code = buf_orig_parts.prod-code
     3646                                        .
     3647         if available pri_trn-doc
     3648         and pri_trn-doc.ext-doc-type = 'rs':U
     3649         then do :
     3650           if p-mark <> ""
     3651           then do :
     3652           end .
     3653           else do :
     3654           end .
     3655         end .
     3656         else do :
     3657           if buf_orig_parts.in-code <> buf_orig_parts.out-code
     3658           and p-mark <> ""
     3659           then do :
     3660             if p-out-code = 'free-zone':U
     3661             then do:
     3662                 if chg-qnty < 0
     3663                 then do :
     3664                   find first orig_marking-lines no-lock where orig_marking-lines.mark       = p-mark
     3665                                                           and orig_marking-lines.gds-code   = buf_goods.gds-code
     3666                                                           and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     3667                                                           and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     3668                                                           and orig_marking-lines.in-code    = buf_orig_parts.in-code
     3669                                                           and orig_marking-lines.out-code   = buf_orig_parts.out-code
     3670                                                           and orig_marking-lines.part-code  = buf_orig_parts.part-code
     3671                                                           and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     3672                                                           no-error .
     3673                   if available orig_marking-lines
     3674                   then do :
     3675                     find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     3676                                                            and buf_marking-lines.gds-code   = buf_goods.gds-code
     3677                                                            and buf_marking-lines.obj-type   = buf_parts.obj-type
     3678                                                            and buf_marking-lines.obj-code   = buf_parts.obj-code
     3679                                                            and buf_marking-lines.in-code    = buf_parts.in-code
     3680                                                            and buf_marking-lines.out-code   = buf_parts.out-code
     3681                                                            and buf_marking-lines.part-code  = buf_parts.part-code
     3682                                                            and buf_marking-lines.prt-code   = buf_parts.prt-code
     3683                                                            no-error .
     3684                     if not available buf_marking-lines
     3685                     then do :
     3686                       create buf_marking-lines .
     3687                       assign
     3688                         buf_marking-lines.mark       = p-mark
     3689                         buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     3690                         buf_marking-lines.gds-code   = buf_goods.gds-code
     3691                         buf_marking-lines.obj-type   = buf_parts.obj-type
     3692                         buf_marking-lines.obj-code   = buf_parts.obj-code
     3693                         buf_marking-lines.in-code    = buf_parts.in-code
     3694                         buf_marking-lines.out-code   = buf_parts.out-code
     3695                         buf_marking-lines.part-code  = buf_parts.part-code
     3696                         buf_marking-lines.prt-code   = buf_parts.prt-code
     3697                       .
     3698                       validate buf_marking-lines.
     3699                     end .
     3700                     for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     3701                       assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     3702                       for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     3703                         for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     3704                                                         and buf_chk-doc.out-code = buf_orig_parts.out-code
     3705                                                         :
     3706                           assign buf_marking-chk.sts = 0 .
     3707                           validate buf_marking-chk.
     3708                         end .
