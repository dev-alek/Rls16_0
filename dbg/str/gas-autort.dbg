     4386                     "должно равняться нулю или количеству по документу" skip
     4387                     "Документ" p-doc-code skip
     4388                     "Объект" p-obj-type p-obj-code skip
     4389                     "Артикул" p-artic p-prod-type p-prod-code skip
     4390                     "Партия" archive_parts.in-code archive_parts.part-code skip
     4391                     "Количество по документу" archive_parts.qnty skip
