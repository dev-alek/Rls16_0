     4510                 message
     4511                   vss-workfile vss-revision vss-description skip
     4512                   vss-include-info24 skip
     4513                   "Ошибка при создании партии" skip
     4514                   "Документ" buf_trn-doc.doc-code skip
     4515                   "Объект" archive_parts.obj-type archive_parts.obj-code skip
     4516                   "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     4517                   "Партия" archive_parts.in-code archive_parts.part-code skip
     4518                   "Резерв" v-rsrv-code skip
     4519                   error-status :get-message(1) skip
