     3781                       end.
     3782                     end .
     3783                   end .
     3784                   if buf_marking.unit-ext <> "UNIT" or
     3785                      (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     3786                   then do :
     3787                     run addChildMarkingLines in this-procedure (
     3788                       buf_marking.mark,
     3789                       buf_marking.sts,
     3790                       buffer buf_marking-lines,
     3791                       buffer buf_parts,
     3792                       buffer orig_marking-lines,
     3793                       buffer buf_orig_parts,
     3794                       buffer buf_goods
     3795                     ).
     3796                   end .
     3797                 end.
     3798                 if available orig_marking-lines then
