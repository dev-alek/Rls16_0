     3853               end .
     3854               end.
     3855             end .
     3856             release buf_marking-lines no-error .
     3857           end.
     3858         end .
     3859         if p-mark <> "" and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U
     3860         then do:
     3861           for each orig_marking-lines no-lock where orig_marking-lines.mark         = p-mark
     3862                                                   and orig_marking-lines.gds-code   = buf_goods.gds-code
     3863                                                   and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     3864                                                   and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     3865                                                   and orig_marking-lines.in-code    = buf_orig_parts.in-code
     3866                                                   and orig_marking-lines.out-code   = buf_orig_parts.out-code
     3867                                                   and orig_marking-lines.part-code  = buf_orig_parts.part-code
     3868                                                   and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     3869                                                   .
     3870             find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     3871                                                    and buf_marking-lines.gds-code   = buf_goods.gds-code
     3872                                                    and buf_marking-lines.obj-type   = buf_parts.obj-type
     3873                                                    and buf_marking-lines.obj-code   = buf_parts.obj-code
     3874                                                    and buf_marking-lines.in-code    = buf_parts.in-code
