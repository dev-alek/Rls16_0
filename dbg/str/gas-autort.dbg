     3815                                                     and buf_marking-lines.gds-code   = buf_goods.gds-code
     3816                                                     and buf_marking-lines.obj-type   = buf_parts.obj-type
     3817                                                     and buf_marking-lines.obj-code   = buf_parts.obj-code
     3818                                                     and buf_marking-lines.out-code   = p-out-code
     3819                                                     no-error .
