     3821             then do :
     3822               find current buf_marking-lines exclusive-lock .
     3823               delete buf_marking-lines .
     3824               for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     3825                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     3826                 then do :
