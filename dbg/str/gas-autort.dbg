     4431                     "cli-qnty" buf_parts.cli-qnty skip
     4432                     view-as alert-box error .
     4433                   undo, return error .
     4434                 end.
     4435               end.
     4436               delete buf_parts .
     4437             end.
     4438           end.
     4439           if archive_parts.in-code = buf_trn-doc.doc-code
     4440           then do:
     4441             assign
     4442               archive_parts.fact-num  = buf_trn-doc.fact-num
     4443               archive_parts.fact-date = buf_trn-doc.fact-date
     4444               archive_parts.doc-type  = buf_trn-doc.doc-type
     4445             .
     4446           end.
     4447           if archive_parts.fact-qnty <> 0
     4448           then do:
     4449             if can-do('рас,спи':U, buf_trn-doc.doc-type)
     4450             or (buf_trn-doc.doc-type = 'инв':U
     4451                 and archive_parts.fact-qnty < 0
     4452               )
     4453             then do:
     4454   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4455   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     4456     (input  buf_trn-doc.doc-code
     4457     ,output v-is-hold
     4458     ) no-error .
     4459               if error-status :error
     4460               then do:
     4461                 message
     4462                   vss-workfile vss-revision vss-description skip
     4463                   vss-include-info24
     4464                   "Ошибка при определении типа документа hold-doc.i" skip
