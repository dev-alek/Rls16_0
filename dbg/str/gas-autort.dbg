     4543                   message
     4544                     vss-workfile vss-revision vss-description skip
     4545                     vss-include-info24 skip
     4546                     "Клиентское количество для товара," skip
     4547                     "который учитывается по двум единицам измерения" skip
     4548                     "должно равняться" v-qnty-sign skip
     4549                     "Документ" p-doc-code skip
     4550                     "Объект" p-obj-type p-obj-code skip
     4551                     "Артикул" p-artic p-prod-type p-prod-code skip
     4552                     "Партия" archive_parts.in-code archive_parts.part-code skip
     4553                     "Количество по документу" archive_parts.qnty skip
     4554                     "Фактическое количество" archive_parts.fact-qnty skip
     4555                     "Клиентское количество" archive_parts.cli-qnty skip
     4556                     view-as alert-box error .
     4557                   undo, return error .
     4558                 end.
     4559                 if archive_parts.fact-qnty = archive_parts.qnty
     4560                 then do:
     4561                   assign
     4562                     buf_parts.cli-qnty = buf_parts.cli-qnty + abs(archive_parts.cli-qnty)
     4563                   .
     4564                 end.
     4565                 else do:
     4566                   message
     4567                     vss-workfile vss-revision vss-description skip
     4568                     vss-include-info24 skip
     4569                     "Фактическое количество для товара," skip
     4570                     "который учитывается по двум единицам измерения" skip
     4571                     "должно равняться нулю или количеству по документу" skip
     4572                     "Документ" p-doc-code skip
     4573                     "Объект" p-obj-type p-obj-code skip
     4574                     "Артикул" p-artic p-prod-type p-prod-code skip
     4575                     "Партия" archive_parts.in-code archive_parts.part-code skip
     4576                     "Количество по документу" archive_parts.qnty skip
     4577                     "Фактическое количество" archive_parts.fact-qnty skip
     4578                     "Клиентское количество" archive_parts.cli-qnty skip
     4579                     view-as alert-box error .
     4580                   undo, return error .
     4581                 end.
     4582               end.
     4583               else do:
     4584                 if buf_parts.cli-base-rate <> 0
     4585                 then do:
     4586                   assign
     4587                     buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     4588                   .
     4589                 end.
     4590                 else do:
     4591                   assign
     4592                     buf_parts.cli-qnty = 0
     4593                   .
     4594                 end.
     4595               end.
     4596               if  buf_parts.qnty      = 0
     4597               and buf_parts.fact-qnty = 0
     4598               then do:
     4599                 if v-goods-twounit = true
     4600                 then do:
     4601                   if buf_parts.cli-qnty <> 0
     4602                   then do:
     4603                     message
     4604                       vss-workfile vss-revision vss-description skip
     4605                       vss-include-info24 skip
     4606                       "Ошибка при удалении партии" skip
     4607                       "Документ" p-doc-code skip
     4608                       "Объект" p-obj-type p-obj-code skip
     4609                       "Артикул" p-artic p-prod-type p-prod-code skip
     4610                       "Партия" buf_parts.in-code buf_parts.part-code skip
     4611                       "Резерв" buf_parts.out-code skip
     4612                       "qnty" buf_parts.qnty skip
     4613                       "fact-qnty" buf_parts.fact-qnty skip
     4614                       "cli-qnty" buf_parts.cli-qnty skip
     4615                       view-as alert-box error .
     4616                     undo, return error .
     4617                   end.
     4618                 end.
     4619                 delete buf_parts .
     4620               end.
     4621             end.
     4622           end.
     4623           if  ( archive_parts.in-code = buf_trn-doc.doc-code
     4624           and archive_parts.supp-type =
     4625           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
     4626           and archive_parts.supp-code =
     4627           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
     4628           )
     4629           or buf_trn-doc.ext-doc-type = 'rv':U
     4630           then do:
     4631             if can-do('рас,спи':U,buf_trn-doc.doc-type)
     4632             or (buf_trn-doc.doc-type = 'инв':U
     4633                 and archive_parts.fact-qnty < 0
     4634               )
     4635             then do:
