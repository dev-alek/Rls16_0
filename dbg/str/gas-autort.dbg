     3800             end.
     3801           end.
     3802         end .
     3803         if p-out-code = 'out-zone':U
     3804         and trim(p-mark) = ""
     3805         then do :
     3806           for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     3807                                                 and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     3808                                                 and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     3809                                                 and orig_marking-lines.in-code    = buf_orig_parts.in-code
     3810                                                 and orig_marking-lines.out-code   = buf_orig_parts.out-code
     3811                                                 and orig_marking-lines.part-code  = buf_orig_parts.part-code
     3812                                                 and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     3813                                                 :
