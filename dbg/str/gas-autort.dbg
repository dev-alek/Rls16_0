     3834               create buf_marking-lines .
     3835               assign
     3836                 buf_marking-lines.mark       = orig_marking-lines.mark
     3837                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     3838                 buf_marking-lines.gds-code   = buf_goods.gds-code
     3839                 buf_marking-lines.obj-type   = buf_parts.obj-type
     3840                 buf_marking-lines.obj-code   = buf_parts.obj-code
     3841                 buf_marking-lines.in-code    = buf_parts.in-code
     3842                 buf_marking-lines.out-code   = buf_parts.out-code
