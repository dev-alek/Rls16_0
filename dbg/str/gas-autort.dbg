     6658   procedure partrsrv-need-rsrv :
     6659     define input  parameter p-parts-in-code   as character no-undo .
     6660     define input  parameter p-parts-out-code  as character no-undo .
     6661     define output parameter p-need-rsrv-parts as logical   no-undo .
