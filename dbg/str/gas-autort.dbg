     6520           and ub.marking-lines.in-code = rsrv-parts.in-code
     6521           and ub.marking-lines.out-code = rsrv-parts.out-code
     6522           and ub.marking-lines.part-code = rsrv-parts.part-code
     6523           and ub.marking-lines.prt-code = rsrv-parts.prt-code:
     6524             delete ub.marking-lines.
     6525         end.
     6526         delete rsrv-parts .
