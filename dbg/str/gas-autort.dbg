     3711                          (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     3712                       then do :
     3713                         run addChildMarkingLines in this-procedure (
     3714                           buf_marking.mark,
     3715                           objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB,
     3716                           buffer buf_marking-lines,
     3717                           buffer buf_parts,
     3718                           buffer orig_marking-lines,
     3719                           buffer buf_orig_parts,
     3720                           buffer buf_goods
     3721                         ).
     3722                       end .
     3723                     end.
     3724                     find current orig_marking-lines exclusive-lock .
     3725                     delete orig_marking-lines .
     3726                   end .
     3727                 end .
     3728             end.
     3729             else do:
     3730               find first orig_marking-lines exclusive-lock where orig_marking-lines.mark       = p-mark
     3731                                                              and orig_marking-lines.gds-code   = buf_goods.gds-code
     3732                                                              and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     3733                                                              and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     3734                                                              and orig_marking-lines.in-code    = buf_orig_parts.in-code
     3735                                                              and orig_marking-lines.out-code   = buf_orig_parts.out-code
     3736                                                              and orig_marking-lines.part-code  = buf_orig_parts.part-code
     3737                                                              and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     3738                                                              no-error .
     3739                 find first buf_marking-lines no-lock where  buf_marking-lines.mark       = p-mark
     3740                                                         and buf_marking-lines.gds-code   = buf_goods.gds-code
     3741                                                         and buf_marking-lines.obj-type   = buf_parts.obj-type
     3742                                                         and buf_marking-lines.obj-code   = buf_parts.obj-code
     3743                                                         and buf_marking-lines.in-code    = buf_parts.in-code
     3744                                                         and buf_marking-lines.out-code   = buf_parts.out-code
     3745                                                         and buf_marking-lines.part-code  = buf_parts.part-code
     3746                                                         and buf_marking-lines.prt-code   = buf_parts.prt-code
     3747                                                         no-error .
     3748                 if not available buf_marking-lines
     3749                 then do :
     3750                   create buf_marking-lines .
     3751                   assign
     3752                     buf_marking-lines.mark       = p-mark
     3753                     buf_marking-lines.doc-level  = 1
     3754                     buf_marking-lines.gds-code   = buf_goods.gds-code
     3755                     buf_marking-lines.obj-type   = buf_parts.obj-type
     3756                     buf_marking-lines.obj-code   = buf_parts.obj-code
     3757                     buf_marking-lines.in-code    = buf_parts.in-code
     3758                     buf_marking-lines.out-code   = buf_parts.out-code
     3759                     buf_marking-lines.part-code  = buf_parts.part-code
     3760                     buf_marking-lines.prt-code   = buf_parts.prt-code
     3761                     buf_marking-lines.sts        = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     3762                   .
     3763                   validate buf_marking-lines.
     3764                 end .
     3765                 for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     3766                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     3767                   validate buf_marking.
     3768                   for first buf_marking-childs exclusive-lock where
     3769                             buf_marking-childs.mark = buf_marking.mark-parent:
     3770                     buf_marking-childs.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
