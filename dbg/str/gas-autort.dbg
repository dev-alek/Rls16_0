     4533                 .
     4534                 if  buf_trn-doc.doc-type = 'инв':U
     4535                 and archive_parts.fact-qnty < 0
     4536                 then do:
     4537                   assign
     4538                     v-qnty-sign = - 1
     4539                   .
     4540                 end.
     4541                 if archive_parts.cli-qnty <> v-qnty-sign
