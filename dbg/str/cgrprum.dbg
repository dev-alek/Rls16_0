     1275   procedure cli-grplib-get-sort-name :
     1276   do
     1277   on error undo, return error
     1278   :
     1279   define input parameter p-node-code  as integer      no-undo.
     1280   define output parameter p-sort-name as character    no-undo.
     1281       define variable v-upper-code    as integer           no-undo.
     1282       define buffer buf_cli-grp       for ub.cli-grp.
     1283       define buffer buf_upper_cli-grp for ub.cli-grp.
     1284       find first buf_cli-grp no-lock
     1285            where buf_cli-grp.node-code = p-node-code
     1286       no-error.
     1287       if not available buf_cli-grp
     1288       then do:
     1289           undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1290       end.
     1291       assign
     1292           p-sort-name  = ""
     1293           v-upper-code = 1
     1294       .
     1295       do while buf_cli-grp.upper-code <> 0
     1296       on error undo, return error "cli-grplib-get-sort-name: Ошибка составления полного имени группы"
     1297       :
     1298           assign
     1299               p-sort-name  = buf_cli-grp.node-name
     1300                            + (if p-sort-name <> "" then chr(2) else "")
     1301                            + p-sort-name
     1302               v-upper-code = buf_cli-grp.upper-code
     1303           .
     1304           find first buf_cli-grp no-lock
     1305                where buf_cli-grp.node-code = v-upper-code
     1306           no-error.
     1307           if not available buf_cli-grp
     1308           then do:
     1309               undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом "
     1310                                   + string( v-upper-code )
     1311                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1312           end.
     1313       end.
     1314   end.
     1315   end procedure.
     1316   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1317   procedure cli-grplib-get-full-name :
     1318      define input parameter  p-node-code  as integer      no-undo.
     1319      define output parameter p-full-name as character    no-undo.
     1320   do
     1321   on error undo, return error
     1322   :
     1323       define variable v-upper-code    as integer           no-undo.
     1324       define buffer buf_cli-grp       for ub.cli-grp.
     1325       define buffer buf_upper_cli-grp for ub.cli-grp.
     1326       find first buf_cli-grp no-lock
     1327            where buf_cli-grp.node-code = p-node-code
     1328       no-error.
     1329       if not available buf_cli-grp
     1330       then do:
     1331           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1332       end.
     1333       assign
     1334           p-full-name  = ""
     1335           v-upper-code = 1
     1336       .
     1337       do while buf_cli-grp.upper-code <> 0
     1338       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1339       :
     1340           assign
     1341               p-full-name  = buf_cli-grp.node-name
     1342                            + (if p-full-name <> "" then chr(47) else "")
     1343                            + p-full-name
     1344               v-upper-code = buf_cli-grp.upper-code
     1345           .
     1346           find first buf_cli-grp no-lock
     1347                where buf_cli-grp.node-code = v-upper-code
     1348           no-error.
     1349           if not available buf_cli-grp
     1350           then do:
     1351               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     1352                                   + string( v-upper-code )
     1353                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1354           end.
     1355       end.
     1356       assign
     1357       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1358       .
     1359   end.
     1360   end .
     1361   procedure cgrplib-get-node-from-full-name :
     1362   define input parameter p-full-name as character no-undo .
     1363   define output parameter p-node-code as integer no-undo .
     1364   define variable v-ii as integer no-undo .
     1365   define variable v-upper-code as integer no-undo .
     1366   define variable v-root-code as integer no-undo .
     1367   define variable v-entry as character no-undo .
     1368   define buffer buf_cli-grp       for ub.cli-grp.
     1369   do
     1370   on error undo, return error
     1371   :
     1372     find first buf_cli-grp no-lock
     1373         where buf_cli-grp.upper-code = 0
     1374     no-error .
     1375     if not available buf_cli-grp
     1376     then do:
     1377         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     1378     end.
     1379     else do:
     1380       assign
     1381       v-root-code = buf_cli-grp.node-code
     1382       .
     1383     end.
     1384     v-upper-code = v-root-code.
     1385     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1386       assign
     1387       v-entry = entry(v-ii, p-full-name, chr(47)).
     1388       if v-entry = '' then leave.
     1389       find first buf_cli-grp no-lock where
     1390                 buf_cli-grp.node-name = v-entry
     1391             and buf_cli-grp.upper-code = v-upper-code
     1392             no-error.
     1393       if not available buf_cli-grp then do:
     1394         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1395       end.
     1396       else do:
     1397         p-node-code = buf_cli-grp.node-code.
     1398         v-upper-code = buf_cli-grp.node-code.
     1399       end.
     1400     end.
     1401   end.
     1402   end .
     1403   procedure cgrplib-get-root-code :
     1404   do
     1405   on error undo, return error
     1406   :
     1407   define output parameter p-root-code as integer      no-undo.
     1408       define buffer buf_cli-grp       for ub.cli-grp.
     1409       find first buf_cli-grp no-lock
     1410           where buf_cli-grp.upper-code = 0
     1411       no-error .
     1412       if not available buf_cli-grp
     1413       then do:
     1414           undo, return error .
     1415       end.
     1416       else do:
     1417           assign
     1418               p-root-code = buf_cli-grp.node-code
     1419           .
     1420       end.
     1421   end.
     1422   end procedure.
     1423   procedure cgrplib-find-grp-by-full-name :
     1424   do
     1425   on error undo, return error
     1426   :
     1427   define input parameter p-search-name  as character    no-undo.
     1428   define input parameter p-fill-path    as logical      no-undo.
     1429       define variable v-upper-code    as integer          no-undo.
     1430       define variable v-not-found     as logical init yes no-undo.
     1431       define variable v-counter       as integer           no-undo.
     1432       define variable v-level         as integer           no-undo.
     1433       define variable v-full-name     as character         no-undo.
     1434       define variable v-sort-name     as character         no-undo.
     1435       define buffer buf_cli-grp       for ub.cli-grp.
     1436       assign
     1437           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1438       .
     1439       run cgrplib-get-root-code ( output v-upper-code ) no-error .
     1440       if error-status :error
     1441       then do:
     1442           undo, return error "cgrplib-expand-name: Ошибка при поиске корневого узла".
     1443       end.
     1444       assign
     1445           v-full-name  = ""
     1446           v-level      = num-entries( p-search-name, chr(2) )
     1447       .
     1448       for each temp_cgrplib_found-grp
     1449       :
     1450           delete temp_cgrplib_found-grp.
     1451       end.
     1452       start-name-analyze:
     1453       do v-counter = 1 to v-level
     1454       :
     1455           if v-counter < v-level
     1456           then do:
     1457               find first buf_cli-grp no-lock
     1458                    where buf_cli-grp.upper-code = v-upper-code
     1459                      and buf_cli-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1460               no-error .
     1461               if not available buf_cli-grp
     1462               then do:
     1463                   assign
     1464                       v-full-name  = p-search-name
     1465                       v-sort-name  = p-search-name
     1466                   .
     1467                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1468               end.
     1469               else do:
     1470                   assign
     1471                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47) )         + buf_cli-grp.node-name
     1472                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_cli-grp.node-name
     1473                       v-upper-code = buf_cli-grp.node-code
     1474                   .
     1475                   if p-fill-path = yes
     1476                   then do:
     1477                       create temp_cgrplib_found-grp.
     1478                       assign
     1479                           temp_cgrplib_found-grp.full-name = v-full-name + chr(47)
     1480                           temp_cgrplib_found-grp.sort-name = v-sort-name
     1481                           temp_cgrplib_found-grp.node-code = v-upper-code
     1482                           temp_cgrplib_found-grp.level     = v-counter
     1483                       .
     1484                   end.
     1485               end.
     1486           end.
     1487           else do:
     1488               for each buf_cli-grp no-lock
     1489                  where buf_cli-grp.upper-code = v-upper-code
     1490                    and buf_cli-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1491               :
     1492                   assign
     1493                       v-not-found = no
     1494                   .
     1495                   create temp_cgrplib_found-grp.
     1496                   assign
     1497                       temp_cgrplib_found-grp.full-name = v-full-name
     1498                                                           + ( if v-full-name = "" then "" else chr(47) )
     1499                                                           + buf_cli-grp.node-name + chr(47)
     1500                       temp_cgrplib_found-grp.sort-name = v-sort-name
     1501                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1502                                                           + buf_cli-grp.node-name
     1503                       temp_cgrplib_found-grp.node-code = buf_cli-grp.node-code
     1504                       temp_cgrplib_found-grp.level     = v-level
     1505                   .
     1506               end.
     1507               if v-not-found = yes
     1508               then do:
     1509                   assign
     1510                       v-full-name  = p-search-name
     1511                       v-sort-name  = p-search-name
     1512                   .
     1513                   for each temp_cgrplib_found-grp
     1514                   :
     1515                       delete temp_cgrplib_found-grp.
     1516                   end.
     1517                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1518               end.
     1519           end.
     1520       end.
     1521   end.
     1522   end procedure.
     1523   procedure cgrplib-find-all-subgroup :
     1524   do
     1525   on error undo, return error
     1526   :
     1527   define input parameter p-start-node-code    as integer      no-undo.
     1528   define input parameter p-terminal-only      as logical      no-undo.
     1529       define variable v-start-full-name   as character     no-undo.
     1530       define variable v-start-sort-name   as character     no-undo.
     1531       define variable v-not-found         as logical       no-undo.
     1532       define variable v-is-terminal       as logical       no-undo.
     1533       define variable v-d-pcnt            as decimal       no-undo.
     1534       define buffer buf_cli-grp           for ub.cli-grp.
     1535       create temp_cfound-result-nodelist.
     1536       assign
     1537           temp_cfound-result-nodelist.node-code = p-start-node-code
     1538           temp_cfound-result-nodelist.processed = no
     1539       .
     1540       run cli-grplib-get-full-name in this-procedure (
     1541             input p-start-node-code
     1542           , output v-start-full-name
     1543       ).
     1544       run cli-grplib-get-sort-name in this-procedure (
     1545             input p-start-node-code
     1546           , output v-start-sort-name
     1547       ).
     1548       process-nodes:
     1549       do while yes
     1550       :
     1551           find first temp_cfound-result-nodelist
     1552                where temp_cfound-result-nodelist.node-code = p-start-node-code
     1553           .
     1554           assign
     1555               temp_cfound-result-nodelist.processed = yes
     1556           .
     1557           for each buf_cli-grp no-lock
     1558              where buf_cli-grp.upper-code = p-start-node-code
     1559           on error undo, return error
     1560           :
     1561               run cgrplib-is-terminal in this-procedure (
     1562                     input buf_cli-grp.node-code
     1563                   , output v-is-terminal
     1564               ).
     1565               if v-is-terminal = yes
     1566               then do:
     1567                   create temp_cgrplib_found-grp.
     1568                   assign
     1569                       temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1570                                                           chr(47) + buf_cli-grp.node-name + chr(47)
     1571                       temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1572                                                           chr(2) + buf_cli-grp.node-name + chr(2)
     1573                       temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
     1574                       temp_cgrplib_found-grp.is-terminal = yes
     1575                   .
     1576                  run cgrplib-get-pcnt-value in this-procedure ( input temp_cgrplib_found-grp.node-code , output v-d-pcnt) no-error .
     1577                  if not error-status:error then do:
     1578                    temp_cgrplib_found-grp.d-pcnt = v-d-pcnt.
     1579                  end.
     1580                  else do:
     1581                    temp_cgrplib_found-grp.d-pcnt = ?.
     1582                  end.
     1583               end.
     1584               else do:
     1585                   create temp_cfound-result-nodelist.
     1586                   assign
     1587                       temp_cfound-result-nodelist.node-code = buf_cli-grp.node-code
     1588                       temp_cfound-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1589                                                              chr(47) + buf_cli-grp.node-name + chr(47)
     1590                       temp_cfound-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1591                                                              chr(2) + buf_cli-grp.node-name + chr(2)
     1592                       temp_cfound-result-nodelist.processed = no
     1593                   .
     1594                   if p-terminal-only = no
     1595                   then do:
     1596                       create temp_cgrplib_found-grp.
     1597                       assign
     1598                           temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1599                                                               chr(47) + buf_cli-grp.node-name + chr(47)
     1600                           temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1601                                                               chr(2) + buf_cli-grp.node-name + chr(2)
     1602                           temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
     1603                           temp_cgrplib_found-grp.is-terminal = no
     1604                       .
     1605                   end.
     1606               end.
     1607           end.
     1608           find first temp_cfound-result-nodelist
     1609                where temp_cfound-result-nodelist.processed = no
     1610           no-error.
     1611           if not available temp_cfound-result-nodelist
     1612           then do:
     1613               leave process-nodes.
     1614           end.
     1615           else do:
     1616               assign
     1617                   p-start-node-code = temp_cfound-result-nodelist.node-code
     1618                   v-start-full-name = temp_cfound-result-nodelist.full-name
     1619                   v-start-sort-name = temp_cfound-result-nodelist.sort-name
     1620               .
     1621           end.
     1622       end.
     1623   end.
     1624   end procedure.
     1625   procedure cgrplib-expand-name :
     1626   do
     1627   on error undo, return error
     1628   :
     1629   define input parameter p-start-name as character        no-undo.
     1630   define output parameter p-end-name  as character        no-undo.
     1631       define variable v-is-terminal     as logical           no-undo.
     1632       define buffer buf_temp_cgrplib_found-grp     for temp_cgrplib_found-grp.
     1633       run cgrplib-find-grp-by-full-name in this-procedure (
     1634             input p-start-name
     1635           , input no
     1636       ) no-error.
     1637       run cgrplib-get-max-substring in this-procedure (
     1638                   input length( p-start-name )
     1639                 , output p-end-name
     1640       ) no-error .
     1641       if error-status :error
     1642       then do:
     1643           assign
     1644               p-end-name = ""
     1645           .
     1646       end.
     1647       else do:
     1648           find first temp_cgrplib_found-grp
     1649               where temp_cgrplib_found-grp.full-name = p-end-name
     1650           no-error.
     1651           if available temp_cgrplib_found-grp
     1652           then do:
     1653               find first buf_temp_cgrplib_found-grp
     1654                   where buf_temp_cgrplib_found-grp.full-name begins p-end-name
     1655                   and recid( buf_temp_cgrplib_found-grp ) <> recid( temp_cgrplib_found-grp )
     1656               no-error.
     1657               if not available buf_temp_cgrplib_found-grp
     1658               then do:
     1659                   run cgrplib-is-terminal in this-procedure (
     1660                       input temp_cgrplib_found-grp.node-code
     1661                       , output v-is-terminal
     1662                   ).
     1663               end.
     1664           end.
     1665       end.
     1666   end.
     1667   end procedure.
     1668   procedure cgrplib-get-max-substring :
     1669   do
     1670   on error undo, return error
     1671   :
     1672   define input parameter p-min-substring-length   as integer      no-undo.
     1673   define output parameter p-substring             as character    no-undo.
     1674           define variable v-char-counter  as integer           no-undo.
     1675           define variable v-current-char  as character         no-undo.
     1676           define variable v-names-counter  as integer           no-undo.
     1677           define variable v-base-string   as character         no-undo.
     1678           assign
     1679               v-char-counter  = p-min-substring-length
     1680           .
     1681           find first temp_cgrplib_found-grp no-error.
     1682           if not available temp_cgrplib_found-grp
     1683           then do:
     1684               undo, return error "cgrplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1685           end.
     1686           else do:
     1687               assign
     1688                   v-base-string = temp_cgrplib_found-grp.full-name
     1689               .
     1690               counter-block:
     1691               do while yes
     1692               on error undo, return error "cgrplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1693               :
     1694                   assign
     1695                       v-char-counter  = v-char-counter + 1
     1696                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1697                       v-names-counter = 0
     1698                   .
     1699                   compare-block:
     1700                   for each temp_cgrplib_found-grp
     1701                   :
     1702                       assign
     1703                           v-names-counter = v-names-counter + 1
     1704                       .
     1705                       if v-names-counter = 1
     1706                       then do:
     1707                           next compare-block.
     1708                       end.
     1709                       if substring( temp_cgrplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1710                       then do:
     1711                           leave counter-block.
     1712                       end.
     1713                   end.
     1714                   if v-names-counter = 1
     1715                   then do:
     1716                       assign
     1717                           p-substring = v-base-string
     1718                       .
     1719                       return.
     1720                   end.
     1721               end.
     1722               assign
     1723                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1724               .
     1725           end.
     1726   end.
     1727   end procedure.
     1728   procedure cgrplib-is-terminal :
     1729   do
     1730   on error undo, return error "Ошибка процедуры cgrplib-is-terminal"
     1731   :
     1732   define input parameter p-node-code      as integer      no-undo.
     1733   define output parameter p-is-terminal   as logical      no-undo.
     1734       define buffer buf_cli-grp       for ub.cli-grp.
     1735       find first buf_cli-grp no-lock
     1736           where buf_cli-grp.upper-code = p-node-code
     1737       no-error .
     1738       if not available buf_cli-grp
     1739       then do:
     1740           assign
     1741               p-is-terminal = yes
     1742           .
     1743       end.
     1744       else do:
     1745           assign
     1746               p-is-terminal = no
     1747           .
     1748       end.
     1749   end.
     1750   end procedure.
     1751   procedure cgrplib-have-clients :
     1752   do
     1753   on error undo, return error
     1754   :
     1755   define input parameter p-node-code      as integer      no-undo.
     1756   define output parameter p-have-clients   as logical      no-undo.
     1757       define buffer buf_clients         for ub.clients.
     1758       find first buf_clients no-lock
     1759            where buf_clients.grp-code = p-node-code
     1760       no-error .
     1761       if available buf_clients
     1762       then do:
     1763           assign
     1764               p-have-clients = yes
     1765           .
     1766       end.
     1767       else do:
     1768           assign
     1769               p-have-clients = no
     1770           .
     1771       end.
     1772   end.
     1773   end procedure.
     1774   procedure cgrplib-find-by-substring :
     1775   do
     1776   on error undo, return error
     1777   :
     1778   define input parameter p-start-code         as integer      no-undo.
     1779   define input parameter p-full-search-string as character    no-undo.
     1780   define output parameter p-found-code        as integer      no-undo.
     1781   define output parameter p-full-name         as character    no-undo.
     1782       define variable v-start-code     as integer           no-undo.
     1783       define variable v-found          as logical  init no  no-undo.
     1784       define buffer buf_cli-grp       for ub.cli-grp.
     1785       search-grp:
     1786       for each buf_cli-grp no-lock
     1787           where buf_cli-grp.node-code > p-start-code
     1788       :
     1789           if index( buf_cli-grp.node-name, p-full-search-string ) <> 0
     1790           then do:
     1791               assign
     1792                   p-found-code = buf_cli-grp.node-code
     1793                   v-found      = yes
     1794               .
     1795               run cli-grplib-get-full-name in this-procedure (
     1796                     input p-found-code
     1797                   , output p-full-name
     1798               ) no-error .
     1799               if error-status :error
     1800               then do:
     1801                   undo, return error "cgrplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1802               end.
     1803               leave search-grp.
     1804           end.
     1805       end.
     1806       if v-found = yes
     1807       then do:
     1808       end.
     1809       else do:
     1810           assign
     1811               p-full-name  = ""
     1812               p-found-code = 0
     1813           .
     1814       end.
     1815   end.
     1816   end procedure.
     1817   procedure cgrplib-analyze-grp-name :
     1818   do
     1819   on error undo, return error
     1820   :
     1821   define input parameter p-grp-name       as character            no-undo.
     1822   define input parameter p-upper-code     as integer              no-undo.
     1823   define output parameter p-error-message as character init ""    no-undo.
     1824       define variable v-char-list     as character    no-undo.
     1825       define variable v-char-counter  as integer      no-undo.
     1826       define variable v-full-name     as character    no-undo.
     1827       if p-grp-name = "" then do:
     1828           assign
     1829               p-error-message = "Название группы не может быть пустым.".
     1830           .
     1831       end.
     1832       else do:
     1833           assign
     1834               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1835           .
     1836           do v-char-counter = 1 to num-entries( v-char-list )
     1837           :
     1838               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1839               then do:
     1840                   assign
     1841                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1842                   .
     1843                   return.
     1844               end.
     1845           end.
     1846           run cli-grplib-get-full-name in this-procedure (
     1847                 input p-upper-code
     1848               , output v-full-name
     1849           ) no-error .
     1850           if error-status :error
     1851           then do:
     1852               undo, return error "cgrplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1853           end.
     1854           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     1855           then do:
     1856               assign
     1857                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     1858               .
     1859           end.
     1860       end.
     1861   end.
     1862   end procedure.
     1863   procedure cgrplib-get-lvl-num :
     1864   define input parameter p-node-code  as integer      no-undo.
     1865   define output parameter p-lvl-num   as integer      no-undo.
     1866       define variable v-full-name    as character    no-undo.
     1867   do
     1868   on error undo, return error
     1869   :
     1870       run cli-grplib-get-full-name in this-procedure (
     1871             input p-node-code
     1872           , output v-full-name
     1873       ).
     1874       assign
     1875           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1876       .
     1877       if p-lvl-num = -1
     1878       then do:
     1879           assign
     1880               p-lvl-num = 0
     1881           .
     1882       end.
     1883   end.
     1884   end procedure.
     1885   PROCEDURE cgrplib-get-pcnt-value :
     1886   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
     1887   DEFINE output PARAMETER p-pcnt-value AS DECIMAL NO-UNDO.
     1888   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     1889   define buffer buf_dis-rule for ub.dis-rule.
     1890   find first buf_dis-grp-rule no-lock where
     1891             buf_dis-grp-rule.classif-type = 'cli-grp':U
     1892         and buf_dis-grp-rule.node-code = p-node-code
     1893         and buf_dis-grp-rule.host-code = 0
     1894         and buf_dis-grp-rule.obj-type = '':U
     1895         and buf_dis-grp-rule.obj-code = 0
     1896         and buf_dis-grp-rule.pos-type = '-':U
     1897         and buf_dis-grp-rule.discnt-role = 'cli-grp-pcnt':U no-error.
     1898   if available buf_dis-grp-rule then do:
     1899     find first buf_dis-rule no-lock where
     1900               buf_dis-rule.rule-num = buf_dis-grp-rule.rule-num no-error.
     1901     if available buf_dis-rule then do:
     1902       assign
     1903       p-pcnt-value        = buf_dis-rule.discnt-value.
     1904       .
     1905     end.
     1906   end.
     1907   END PROCEDURE.
     1908   define variable v-stop-leave-status as character no-undo .
     1909   define variable v-cmd-code as integer no-undo .
     1910   define variable v-cmd-proc-handle as handle no-undo .
     1911   define variable v-command  as character no-undo .
     1912   define variable v-obj-type as character no-undo .
     1913   define variable v-obj-code as integer no-undo .
     1914   define variable v-host-code as integer   no-undo .
     1915   define variable v-base-code as integer   no-undo .
     1916   define variable v-doc-date as date no-undo .
     1917   define variable v-fact-date as date no-undo .
     1918   define variable v-curr-r-b as character no-undo .
     1919   define variable v-id as integer no-undo .
     1920   define variable v-proc-handle as handle no-undo .
     1921   define variable v-proc-name as character no-undo .
     1922   define variable v-ruleset-id as integer no-undo .
     1923   define variable v-ruleset-id-list as character no-undo extent 3.
     1924   define variable v-codex-id as integer no-undo .
     1925   define variable v-codex-in-db as integer no-undo .
     1926   define variable v-ii as integer no-undo .
     1927   define variable v-jj as integer no-undo .
     1928   define variable sign as integer no-undo .
     1929   define variable v-codex-id-list as character no-undo .
     1930   DEFINE VARIABLE v-today as date no-undo .
     1931   DEFINE VARIABLE v-time as integer no-undo .
     1932   define variable v-calc-chr as character no-undo .
     1933   define variable v-can-run as logical no-undo .
     1934   define variable v-doc-code as character no-undo .
     1935   define variable v-doc-type as character no-undo .
     1936   define variable v-process-file-name as character no-undo .
     1937   define variable v-profile-id as integer no-undo .
     1938   define variable log-file-name                as character      no-undo init "process-cli-grp.txt".
     1939   define variable v-save-int as integer no-undo .
     1940   define variable v-charkey_one as character no-undo .
     1941   define variable v-charkey_one-2 as character no-undo .
     1942   define variable v-num-dc as integer no-undo .
     1943   define variable v-is-empty as logical no-undo .
     1944   define variable v-rec-ord_ as integer no-undo .
     1945   define variable v-param-name as character no-undo .
     1946   define variable v-xsd-file as character no-undo .
     1947   define variable v-cont-handle as handle no-undo .
     1948   define buffer buf_rule-by-call for ub.rule-by-call.
     1949   define buffer buf_temp-pers-proc  for temp-pers-proc.
     1950   define buffer buf_db for ub.db.
     1951   define buffer buf_sysconf for ub.sysconf.
     1952   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1953   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1954   define NEW SHARED temp-table temp-cmd no-undo
     1955   field cmd-code as integer
     1956   field db-list as character
     1957   index pi is unique primary
     1958   db-list
     1959   index icmd
     1960   cmd-code
     1961   .
     1962   define NEW SHARED temp-table temp-smart-route no-undo
     1963   field key-field as character
     1964   field db-num as integer
     1965   index pi is unique primary
     1966   key-field
     1967   db-num
     1968   .
     1969   define NEW SHARED temp-table temp-no-route no-undo
     1970   field rec-ord as integer
     1971   field db-num as integer
     1972   index pi is unique primary
     1973   db-num
     1974   rec-ord
     1975   index iro
     1976   rec-ord
     1977   .
     1978   define NEW SHARED temp-table temp-smart-link no-undo
     1979   field uniq-key-rec as character
     1980   field key-field as character
     1981   field rec-ord as integer
     1982   field is-smart as logical
     1983   index pi is unique primary
     1984   key-field
     1985   uniq-key-rec
     1986   rec-ord
     1987   index iu
     1988   uniq-key-rec
     1989   index iro
     1990   rec-ord
     1991   .
     1992   define NEW SHARED temp-table temp-nws-outline no-undo
     1993   like ub.nws-outline.
     1994   procedure create-smart-route :
     1995   define input parameter p-key-field as character no-undo .
     1996   define input parameter p-db-num as integer no-undo .
     1997   define buffer buf_temp-smart-route for temp-smart-route.
     1998     do
     1999     on error undo, return error
     2000     :
     2001       find first buf_temp-smart-route where
     2002                 buf_temp-smart-route.key-field = p-key-field
     2003             and buf_temp-smart-route.db-num = p-db-num no-error.
     2004       if not available buf_temp-smart-route then do:
     2005         create buf_temp-smart-route.
     2006         assign
     2007         buf_temp-smart-route.key-field = p-key-field
     2008         buf_temp-smart-route.db-num = p-db-num
     2009         .
     2010       end.
     2011     end.
     2012   end procedure.
     2013   procedure create-smart-route-link :
     2014   define input parameter p-tbl-name as character no-undo .
     2015   define input parameter p-bh_tbl-name as handle no-undo .
     2016   define input parameter p-key-field as character no-undo .
     2017   define input parameter p-rec-ord as integer no-undo .
     2018   define input parameter p-is-smart as logical no-undo .
     2019   define variable v-key-rec as character no-undo .
     2020   define buffer buf_temp-smart-link for temp-smart-link.
     2021     do
     2022     on error undo, return error
     2023     :
     2024       run gen-key-rec in this-procedure ( input p-tbl-name
     2025                                          ,input p-bh_tbl-name
     2026                                          ,output v-key-rec     ).
     2027      find first buf_temp-smart-link where
     2028                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     2029              and buf_temp-smart-link.key-field = p-key-field
     2030              and buf_temp-smart-link.rec-ord = p-rec-ord
     2031              no-error .
     2032      if not available buf_temp-smart-link then do:
     2033        create buf_temp-smart-link.
     2034        assign
     2035        buf_temp-smart-link.uniq-key-rec = v-key-rec
     2036        buf_temp-smart-link.key-field = p-key-field
     2037        buf_temp-smart-link.rec-ord = p-rec-ord
     2038        buf_temp-smart-link.is-smart = p-is-smart
     2039        .
     2040      end.
     2041     end.
     2042   end procedure.
     2043   procedure create-nws-outline :
     2044   define input parameter p-cmd-proc-handle as handle no-undo .
     2045   define input parameter p-cmd-code as integer no-undo .
     2046   define input parameter p-outline-type as character no-undo .
     2047   define input parameter p-charkey_one as character no-undo .
     2048   define input parameter p-charkey_two as character no-undo .
     2049   define input parameter p-charkey_three as character no-undo .
     2050   define input parameter p-key#_one as integer no-undo .
     2051   define input parameter p-key#_two as integer no-undo .
     2052   define input parameter p-key#_three as integer no-undo .
     2053   define variable v-no-id as integer no-undo .
     2054   define variable v-rec-ord as integer no-undo .
     2055     do
     2056     on error undo, return error return-value
     2057     :
     2058       find last temp-nws-outline use-index pi no-error .
     2059       v-no-id = (if available temp-nws-outline
     2060                  then (temp-nws-outline.no-id  + 1)
     2061                  else 1).
     2062       create temp-nws-outline.
     2063       assign
     2064       temp-nws-outline.charkeY_one = p-charkey_one
     2065       temp-nws-outline.charkeY_two = p-charkey_two
     2066       temp-nws-outline.charkeY_three = p-charkey_three
     2067       temp-nws-outline.key#_one = p-key#_one
     2068       temp-nws-outline.key#_two = p-key#_two
     2069       temp-nws-outline.key#_three = p-key#_three
     2070       temp-nws-outline.no-id = v-no-id
     2071       temp-nws-outline.outline-type = p-outline-type
     2072       .
     2073                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     2074       run  create-smart-route in this-procedure (
     2075                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     2076                                                  ,input -1).
     2077       run create-smart-route-link in this-procedure (
     2078                                                      input 'nws-outline':U
     2079                                                     ,input (buffer temp-nws-outline:handle)
     2080                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     2081                                                     ,input v-rec-ord
     2082                                                     ,input no
     2083                                                     ).
     2084     end.
     2085   end procedure.
     2086   procedure create-no-route :
     2087   define input parameter p-rec-ord as integer no-undo .
     2088   define input parameter p-db-num as integer no-undo .
     2089   define buffer buf_temp-no-route for temp-no-route.
     2090   do
     2091   on error undo, return error
     2092   :
     2093      find first buf_temp-no-route where
     2094                 buf_temp-no-route.rec-ord = p-rec-ord
     2095              and buf_temp-no-route.db-num = p-db-num no-error .
     2096      if not available buf_temp-no-route then do:
     2097        create buf_temp-no-route.
     2098        assign
     2099        buf_temp-no-route.rec-ord = p-rec-ord
     2100        buf_temp-no-route.db-num = p-db-num
     2101        .
     2102      end.
     2103   end.
     2104   end procedure.
     2105   procedure clear-from-rec-ord :
     2106   define input parameter p-rec-ord as integer no-undo .
     2107   define buffer buf_temp-no-route for temp-no-route.
     2108   define buffer buf_temp-smart-link for temp-smart-link.
     2109   do
     2110   on error undo, return error
     2111   :
     2112   for each buf_temp-no-route where
     2113           buf_temp-no-route.rec-ord > p-rec-ord:
     2114     delete buf_temp-no-route.
     2115   end.
     2116   for each buf_temp-smart-link where
     2117           buf_temp-smart-link.rec-ord > p-rec-ord:
     2118      delete buf_temp-smart-link.
     2119   end.
     2120   end.
     2121   end procedure.
     2122   define buffer buf_temp-cmd  for temp-cmd.
     2123   define buffer buf1_temp-cmd  for temp-cmd.
     2124   define buffer buf_temp-smart-route  for temp-smart-route.
     2125   define buffer buf_temp-smart-link  for temp-smart-link.
     2126   define buffer buf_temp-nws-outline for temp-nws-outline.
     2127   define buffer buf_temp-no-route for temp-no-route.
     2128   _main:
     2129   do
     2130   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2131   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2132   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2133   :
     2134   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2135   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2136     (output v-curr-r-b
     2137     )  .
     2138     if not p-save
     2139           then do:
     2140       message
     2141       substitute("Неверное значение параметра p-save = &1,&2" +
     2142                  "в ситуации когда p-process = &3"
     2143                  , p-save
     2144                  , chr(10)
     2145                  , p-process)
     2146       view-as alert-box error .
     2147       undo _main, return error .
     2148     end.
     2149     v-save-int = (if p-save
     2150                   then 0
     2151                   else -1).
     2152     CASE p-process:
     2153       when 'batchwork-export':U
     2154       or
     2155       when 'batchwork-routing':U
     2156       then do:
     2157         if not g#auto then do:
     2158   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2159     run mainmenu_getcntxt in parparentproc
     2160       (output v-cntxt-db-num
     2161       ,output v-cntxt-userid
     2162       ,output v-cntxt-level
     2163       ,output v-cntxt-host-code-obj
     2164       ,output v-cntxt-obj-type
     2165       ,output v-cntxt-obj-code
     2166       ,output v-cntxt-db-num-obj
     2167       ,output v-cntxt-is-admin
     2168       ) .
     2169         end.
     2170         for each cgrp-list:
     2171           delete cgrp-list.
     2172         end.
     2173         if p-parent-handle:get-signature ( "cli-grps_rum-fill_cb") <> ? then do:
     2174           run cli-grps_rum-fill_cb in p-parent-handle ( input (buffer cgrp-list:handle), input (buffer temp_cfound-result-nodelist:handle)).
     2175         end.
     2176         run cur-time in this-procedure ( output v-today, output v-time).
     2177         assign
     2178         v-obj-type = v-cntxt-obj-type
     2179         v-obj-code = v-cntxt-obj-code
     2180         v-host-code = v-cntxt-host-code-obj
     2181         v-doc-date = v-today
     2182         v-fact-date = v-today
     2183         v-doc-code = entry(1, p-doc-code, chr(4))
     2184         v-process-file-name =  entry(2, p-doc-code, chr(4))
     2185         v-profile-id = p-profile-id
     2186         .
     2187         assign
     2188         v-codex-id-list = string(p-codex-id)
     2189         v-ruleset-id-list[1] = string(p-ruleset-id)
     2190         v-ruleset-id-list[2] = ''
     2191         .
     2192       end.
     2193       when 'xml-file-import':U then do:
     2194         run cur-time in this-procedure ( output v-today, output v-time).
     2195         assign
     2196         v-obj-type = v-cntxt-obj-type
     2197         v-obj-code = v-cntxt-obj-code
     2198         v-host-code = v-cntxt-host-code-obj
     2199         v-doc-date = v-today
     2200         v-fact-date = v-today
     2201         v-doc-code = entry(1, p-doc-code, chr(4))
     2202         v-process-file-name =  entry(2, p-doc-code, chr(4))
     2203         v-profile-id = p-profile-id
     2204         .
     2205         for each cgrp-list:
     2206           delete cgrp-list.
     2207         end.
     2208         assign
     2209         v-codex-id-list = string(p-codex-id)
     2210         v-ruleset-id-list[1] = string(p-ruleset-id)
     2211         v-ruleset-id-list[2] = ''
     2212         .
     2213       end.
     2214       when 'xml-esys-import':U then do:
     2215         run cur-time in this-procedure ( output v-today, output v-time).
     2216         assign
     2217         v-obj-type = v-cntxt-obj-type
     2218         v-obj-code = v-cntxt-obj-code
     2219         v-host-code = v-cntxt-host-code-obj
     2220         v-doc-date = v-today
     2221         v-fact-date = v-today
     2222         v-doc-code = entry(1, p-doc-code, chr(4))
     2223         v-process-file-name =  entry(2, p-doc-code, chr(4)) +
     2224                                 chr(4) + entry(3, p-doc-code, chr(4))
     2225                                 + chr(4) + entry(4, p-doc-code, chr(4))
     2226                                 + chr(4) + entry(5, p-doc-code, chr(4))
     2227         v-profile-id = p-profile-id
     2228         v-cont-handle = p-parent-handle
     2229         v-param-name = entry(6, p-doc-code, chr(4))
     2230         v-xsd-file = entry(7, p-doc-code, chr(4))
     2231         .
     2232         assign
     2233         v-codex-id-list = string(p-codex-id)
     2234         v-ruleset-id-list[1] = string(p-ruleset-id)
     2235         v-ruleset-id-list[2] = ''
     2236         .
     2237       end.
     2238       otherwise do:
     2239         undo _main, return error substitute("&1 &2 &3&4Ошибка входных параметров процедуры cgrprum.p&4Невернoе значение p-process = &5"
     2240                                             ,vss-workfile
     2241                                             ,vss-revision
     2242                                             ,vss-description
     2243                                             ,chr(10)
     2244                                             ,p-process
     2245                                              ).
     2246       end.
     2247     END CASE.
     2248     _codex:
     2249     do v-jj = 1 to num-entries(v-codex-id-list):
     2250       if entry(v-jj, v-codex-id-list) = '':U then next _codex.
     2251       v-codex-id = integer(entry(v-jj, v-codex-id-list)).
     2252       do v-ii = 1 to num-entries(v-ruleset-id-list[v-jj]):
     2253           if entry(v-ii, v-ruleset-id-list[v-jj]) = '':U then next.
     2254           v-ruleset-id = integer(entry(v-ii, v-ruleset-id-list[v-jj])).
     2255         _rule-by-call:
     2256         for each buf_rule-by-call no-lock where
     2257                   buf_rule-by-call.call_id = p-uniq-key-rec
     2258             and buf_rule-by-call.can-calc = yes
     2259             and buf_rule-by-call.codex_id = v-codex-id
     2260             and buf_rule-by-call.ruleset_id = v-ruleset-id
     2261         by buf_rule-by-call.call_Id
     2262         by buf_rule-by-call.codex_id
     2263         by buf_rule-by-call.ruleset_id
     2264         by buf_rule-by-call.order_id
     2265         on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2266         on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2267         on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ) :
     2268           if p-process = 'batchwork-export':U
     2269           or p-process = 'batchwork-routing':U
     2270           or p-process = 'xml-file-import':U
     2271           then do:
     2272             if buf_rule-by-call.profile_id <> v-profile-id then next _rule-by-call.
     2273           end.
     2274           v-proc-name = "rul/" + string(buf_rule-by-call.rule_id, '999999999') + '.p'.
     2275           run value(v-proc-name)  (
     2276                                                                 input parparentproc
     2277                                                               ,input this-procedure:handle
     2278                                                               ,input p-log-handle
     2279                                                               ,input v-cont-handle
     2280                                                               ,input v-codex-id
     2281                                                               ,input v-ruleset-id
     2282                                                               ,input buf_rule-by-call.call_id
     2283                                                               ,input buf_rule-by-call.order_id
     2284                                                               ,input buf_rule-by-call.rule_id
     2285                                                               ,input buf_rule-by-call.profile
     2286                                                               ,input buf_rule-by-call.is_dynamic
     2287                                                               ,input v-doc-type
     2288                                                               ,input v-host-code
     2289                                                               ,input v-obj-type
     2290                                                               ,input v-obj-code
     2291                                                               ,input v-doc-code
     2292                                                               ,input v-process-file-name
     2293                                                               ,input v-save-int
     2294                                                               ,input v-curr-r-b
     2295                                                               ,input v-cmd-proc-handle
     2296                                                               ,input 0
     2297                                                               ) no-error .
     2298           if error-status:error
     2299           then do:
     2300             undo _main, return error substitute("&1&2Ошибка при обработке групп клиентов&2" +
     2301                                                 "&3&2&4"
     2302                                                 ,vss-workfile
     2303                                                 ,chr(10)
     2304                                                 , error-status:get-message(1)
     2305                                                 , return-value
     2306                                                   ).
     2307           end.
     2308           if v-stop-leave-status > '' then do:
     2309             undo _main, return error substitute("&1&2Процесс обработки групп клиентов прерван&2" +
     2310                                                 "&3&2&4"
     2311                                                 ,vss-workfile
     2312                                                 ,chr(10)
     2313                                                 , error-status:get-message(1)
     2314                                                 , return-value
     2315                                                   ).
     2316           end.
     2317         end.
     2318       end.
     2319     end.
     2320   end.
     2321   procedure set-num-rec :
     2322   define input parameter p-num-rec as integer no-undo .
     2323   define input parameter p-num-rec-calc-err as integer no-undo .
     2324   define input parameter p-num-rec-value-err as integer no-undo .
     2325   define input parameter p-num-rec-ok as integer no-undo .
     2326   define input parameter p-display as logical no-undo .
     2327   define variable v-ok as logical no-undo .
     2328   do
     2329   on error undo, return error
     2330   :
     2331     if not (p-process = 'batch-card-recalc':U) then do:
     2332       return.
     2333     end.
     2334     run set-num-rec in p-parent-handle ( input p-num-rec
     2335                                         ,input p-num-rec-calc-err
     2336                                         ,input p-num-rec-value-err
     2337                                         ,input p-num-rec-ok
     2338                                         ,buffer buf_rule-by-call
     2339                                         ,input p-display
     2340                                         ).
     2341   end.
     2342   end procedure.
     2343   procedure set-stop-leave-status :
     2344   define input parameter p-stop-leave-status as character no-undo .
     2345   do
     2346   on error undo, return error
     2347   :
     2348     assign
     2349     v-stop-leave-status = p-stop-leave-status.
     2350   end.
     2351   end procedure.
