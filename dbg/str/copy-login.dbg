        1   block-level on error undo, throw.
        2   define input parameter p-user-id        as character        no-undo .
        3   define input parameter p-user-login     as character        no-undo .
        4   define input parameter p-db-num         as integer          no-undo .
        5   define input parameter p-db-list        as character        no-undo .
        6   define output parameter p-ok            as logical          no-undo .
        7   define variable vss-revision    as character no-undo initial "$Revision: 4886e87b5a2b, 3169, rls $":U .
        8   define variable vss-author      as character no-undo initial "$Author: DRuban $":U .
        9   define variable vss-date        as character no-undo initial "$Date: 2022/12/27 12:54:23 $":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile: copy-login.p $":U .
       11   define variable vss-archive     as character no-undo initial "$Archive: str/copy-login.p $":U .
       12   define variable vss-description as character no-undo initial "Копирование логинов".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable v-counter   as integer   no-undo.
       83   define variable v-ini-login as character no-undo.
       84   define variable v-ini-name  as character no-undo.
       85   define variable v-ini-nick  as character no-undo.
       86   define variable ii          as integer   no-undo .
       87   define buffer buf_sys-ctrl               for ub.sys-ctrl .
       88   define buffer buf_user-login             for ub.user-login .
       89   define buffer buf_user-obj               for user-obj .
       90   define buffer buf_user-host              for user-host .
       91   define buffer buf_user-menu-group        for user-menu-group .
       92   define buffer buf_user-login-action-role for user-login-action-role .
       93   define buffer new_user-login             for user-login .
       94   define buffer new_user-obj               for user-obj .
       95   define buffer new_user-host              for user-host .
       96   define buffer new_user-menu-group        for user-menu-group .
       97   define buffer new_user-login-action-role for user-login-action-role .
       98   define buffer buf_user-account           for ub.user-account .
       99   define buffer buf_db                     for ub.db .
      100   define buffer buf_clients                for ub.clients .
      101   do
      102      on error undo, return error return-value
      103      :
      104      define variable v-new-name             as character no-undo.
      105      define variable v-new-nick             as character no-undo.
      106      define variable v-new-login            as character no-undo.
      107      define variable v-success              as logical   no-undo.
      108      define variable v-user-rowid           as rowid     no-undo.
      109      define variable v-next-user-id         as character no-undo .
      110      define variable v-user-menu-group-code as integer   no-undo.
      111      define variable v-user-login-role-code as integer   no-undo.
      112      find first buf_user-login no-lock
      113         where buf_user-login.user-id = p-user-id
      114         and buf_user-login.db-num  = p-db-num
      115         no-error
      116         .
      117      if not available buf_user-login
      118         then
      119      do:
      120         message
      121            "Логин пользователя редактируется администратором."
      122            skip (1)
      123            skip substitute( "БД:           &1", p-db-num             )
      124            skip (1)
      125            skip
      126            "Повторите операцию через некоторое время."
      127            view-as alert-box warning.
      128         undo, return error .
      129      end.
      130      if p-db-list = "Все" then
      131      do:
      132         p-db-list = "" .
      133         For each buf_db no-LOCK:
      134            if buf_db.db-num <> 0 and buf_db.db-num <> p-db-num then
      135            do:
      136               assign
      137                  p-db-list = substitute( "&1&2&3", p-db-list, chr(44), buf_db.db-num )
      138                  .
      139            end.
      140         end.
      141         p-db-list = trim (p-db-list,chr(44)) .
      142      end.
      143      _next :
      144      do ii = 1 to num-entries (p-db-list, chr(44)):
      145         find first new_user-login exclusive-lock where new_user-login.user-login = p-user-login
      146            and new_user-login.db-num = integer (entry(ii,p-db-list,chr(44))) no-error .
      147         if available (new_user-login) then
      148         do:
      149            output to value (ibs.th.gbl.gbl-inipar:logDir + "login-error.log") append .
      150            put unformatted                "Логин =" + new_user-login.user-login + " уже есть в БД " + string (new_user-login.db-num) skip .
      151            output close .
      152            next _next .
      153         end.
      154         find first new_user-login exclusive-lock where new_user-login.user-id = p-user-id
      155            and new_user-login.db-num = integer (entry(ii,p-db-list,chr(44))) no-error .
      156         if not available (new_user-login) then
      157         do:
      158            create new_user-login.
      159            buffer-copy buf_user-login
      160               except db-num user-login user-administrator to new_user-login
      161               assign
      162               new_user-login.db-num     = integer (entry(ii,p-db-list,chr(44)))
      163               new_user-login.user-login = p-user-login .
      164         end.
      165         FOR EACH buf_user-host
      166            where buf_user-host.db-num  = integer (entry(ii,p-db-list,chr(44)))
      167            and buf_user-host.user-id = p-user-id
      168            exclusive-lock
      169            :
      170            delete buf_user-host .
      171         end.
      172       FOR EACH buf_user-host
      173         where buf_user-host.db-num  = p-db-num
      174         and buf_user-host.user-id = p-user-id
      175         no-lock
      176         :
      177         create new_user-host.
      178         buffer-copy buf_user-host
      179           except db-num
      180           to new_user-host
      181           .
      182         new_user-host.db-num = integer (entry(ii,p-db-list,chr(44))) .
      183       end.
      184       FOR EACH  buf_user-obj exclusive-lock
      185         where buf_user-obj.db-num  = integer (entry(ii,p-db-list,chr(44)))
      186         and buf_user-obj.user-id = p-user-id
      187         :
      188         delete buf_user-obj .
      189       end.
      190       for each ub.clients no-lock where ub.clients.db-num = integer (entry(ii,p-db-list,chr(44))) and (ub.clients.obj-type = 'маг':U or ub.clients.obj-type = 'скл':U):
      191         create new_user-obj.
      192         assign
      193           new_user-obj.db-num    = integer (entry(ii,p-db-list,chr(44)))
      194           new_user-obj.host-code = new_user-host.host-code
      195           new_user-obj.obj-code  = ub.clients.obj-code
      196           new_user-obj.obj-type  = ub.clients.obj-type
      197           new_user-obj.user-id   = p-user-id
      198           .
      199       end.
      200       FOR EACH  buf_user-menu-group
      201         where buf_user-menu-group.db-num  = integer (entry(ii,p-db-list,chr(44)))
      202         and buf_user-menu-group.user-id = p-user-id
      203         exclusive-lock
      204         :
      205         delete buf_user-menu-group .
      206       end.
      207       FOR EACH  buf_user-menu-group
      208         where buf_user-menu-group.db-num  = p-db-num
      209         and buf_user-menu-group.user-id = p-user-id
      210         no-lock
      211         :
      212         assign
      213           v-user-menu-group-code = next-value(s-user-menu-group)
      214           .
      215         create new_user-menu-group.
      216         buffer-copy buf_user-menu-group
      217           except db-num user-menu-group-code host-code obj-code obj-type
      218           to new_user-menu-group
      219           .
      220         assign
      221           new_user-menu-group.db-num               = integer (entry(ii,p-db-list,chr(44)))
      222           new_user-menu-group.user-menu-group-code = v-user-menu-group-code
      223           new_user-menu-group.host-code            = new_user-host.host-code
      224           new_user-menu-group.obj-code             = new_user-obj.obj-code
      225           new_user-menu-group.obj-type             = new_user-obj.obj-type
      226           .
      227       end.
      228       FOR EACH  buf_user-login-action-role
      229         where buf_user-login-action-role.db-num  = integer (entry(ii,p-db-list,chr(44)))
      230         and buf_user-login-action-role.user-id = p-user-id
      231         exclusive-lock
      232         :
      233         delete buf_user-login-action-role .
      234       end.
      235       FOR EACH  buf_user-login-action-role
      236         where buf_user-login-action-role.db-num  = p-db-num
      237         and buf_user-login-action-role.user-id = p-user-id
      238         and buf_user-login-action-role.action-role-context = "global"
      239         no-lock
      240         :
      241         assign
      242           v-user-login-role-code = next-value(s-user-login-action-role)
      243           .
      244         create new_user-login-action-role.
      245         buffer-copy buf_user-login-action-role
      246           except db-num user-login-role-code user-id
      247           to new_user-login-action-role
      248           .
      249         assign
      250           new_user-login-action-role.db-num               = integer (entry(ii,p-db-list,chr(44)))
      251           new_user-login-action-role.user-login-role-code = v-user-login-role-code
      252           new_user-login-action-role.user-id              = p-user-id
      253           .
      254       end.
      255       FOR EACH  buf_user-login-action-role
      256         where buf_user-login-action-role.db-num  = p-db-num
      257         and buf_user-login-action-role.user-id = p-user-id
      258         and buf_user-login-action-role.action-role-context = "firm"
      259         no-lock
      260         :
      261         assign
      262           v-user-login-role-code = next-value(s-user-login-action-role)
      263           .
      264         create new_user-login-action-role.
      265         buffer-copy buf_user-login-action-role
      266           except db-num user-login-role-code host-code user-id
      267           to new_user-login-action-role
      268           .
      269         assign
      270           new_user-login-action-role.db-num               = integer (entry(ii,p-db-list,chr(44)))
      271           new_user-login-action-role.user-login-role-code = v-user-login-role-code
      272           new_user-login-action-role.host-code            = new_user-host.host-code
      273           new_user-login-action-role.user-id              = p-user-id
      274           .
      275       end.
      276       FOR EACH  buf_user-login-action-role
      277         where buf_user-login-action-role.db-num  = p-db-num
      278         and buf_user-login-action-role.user-id = p-user-id
      279         and buf_user-login-action-role.action-role-context = "object"
      280         no-lock
      281         :
      282         assign
      283           v-user-login-role-code = next-value(s-user-login-action-role)
      284           .
      285         create new_user-login-action-role.
      286         buffer-copy buf_user-login-action-role
      287           except db-num user-login-role-code obj-code obj-type user-id
      288           to new_user-login-action-role
      289           .
      290         assign
      291           new_user-login-action-role.db-num               = integer (entry(ii,p-db-list,chr(44)))
      292           new_user-login-action-role.user-login-role-code = v-user-login-role-code
      293           new_user-login-action-role.obj-code             = new_user-obj.obj-code
      294           new_user-login-action-role.obj-type             = new_user-obj.obj-type
      295           new_user-login-action-role.user-id              = p-user-id
      296           .
      297       end.
      298     end.
      299   end.
