      769   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
      770   define variable v-ps as character no-undo .
      771   assign
      772   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
      773                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
      774                     , buf_sale-doc.out-code
      775                     , buf_sale-doc.obj-type
      776                     , buf_sale-doc.obj-code
      777                     , chr(4)
      778                     , buf_sale-doc.tot-lines
      779                     , buf_sale-doc.tot-dtl
      780                     ).
      781   return v-Ps.
      782   END FUNCTION.
      783   procedure create-tt0-doc-line-gds-dtl :
      784   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
      785   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
      786   define input parameter p-ext-doc-type        as character no-undo .
      787   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
      788   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
      789   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
      790   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
      791   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
      792   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
      793   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
      794   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
      795   define parameter buffer b-doc-line           for ub.doc-line.
      796   define parameter buffer b-gds-dtl            for ub.gds-dtl.
      797   define parameter buffer buf_sale-doc for ub.sale-doc.
      798   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
      799   define buffer other_doc-line for ub.doc-line.
      800   define buffer other_gds-dtl for ub.gds-dtl.
      801     do
      802     on error undo, return error return-value
      803     :
      804       find first tt0-doc-line where
      805                 tt0-doc-line.obj-type = p-proprietor-obj-type
      806             AND tt0-doc-line.obj-code = p-proprietor-obj-code
      807             AND tt0-doc-line.prod-type = p-prod-type
      808             AND tt0-doc-line.prod-code = p-prod-code
      809             AND tt0-doc-line.artic     = p-artic
      810             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
      811             AND tt0-doc-line.status_      = 'нередакт':U no-error .
      812       if not available tt0-doc-line then do:
      813         create tt0-doc-line.
      814         buffer-copy b-doc-line
      815         except
      816         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
      817         to tt0-doc-line
      818         assign
      819         tt0-doc-line.status_ = 'нередакт':U
      820         tt0-doc-line.ext-doc-type = p-ext-doc-type
      821         tt0-doc-line.obj-type = p-proprietor-obj-type
      822         tt0-doc-line.obj-code = p-proprietor-obj-code
      823         tt0-doc-line.doc-code = p-doc-code
      824         .
      825       end.
      826       if p-doc-code <> "":U then do:
      827         find first other_doc-line no-lock where
      828                 other_doc-line.doc-code = p-doc-code
      829             AND  other_doc-line.artic    = p-artic
      830             AND  other_doc-line.prod-type = p-prod-type
      831             AND  other_doc-line.prod-code = p-prod-code no-error .
      832         if available other_doc-line then do:
      833           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
      834           assign
      835           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
      836           .
      837         end.
      838         else do:
      839           assign
      840           tt0-doc-line.doc-code = '':U
      841           .
      842         end.
      843       end.
      844       find first tt0-gds-dtl where
      845               tt0-gds-dtl.obj-type = p-proprietor-obj-type
      846           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
      847           AND tt0-gds-dtl.prod-type = p-prod-type
      848           AND tt0-gds-dtl.prod-code = p-prod-code
      849           AND tt0-gds-dtl.artic     = p-artic
      850           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
      851       if not available tt0-gds-dtl then do:
      852         create tt0-gds-dtl.
      853         buffer-copy b-gds-dtl
      854         except
      855         obj-type obj-code doc-code doc-qnty fact-qnty
      856         to tt0-gds-dtl
      857         assign
      858         tt0-gds-dtl.obj-type = p-proprietor-obj-type
      859         tt0-gds-dtl.obj-code = p-proprietor-obj-code
      860         tt0-gds-dtl.doc-code = p-doc-code
      861         .
      862       end.
      863       if p-doc-code <> "":U then do:
      864           find first other_gds-dtl no-lock where
      865                   other_gds-dtl.doc-code = p-doc-code
      866               AND  other_gds-dtl.artic    = p-artic
      867               AND  other_gds-dtl.prod-type    = p-prod-type
      868               AND  other_gds-dtl.prod-code    = p-prod-code
      869               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
      870           if available other_gds-dtl then do:
      871             assign
      872             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
      873             .
      874           end.
      875           else do:
      876             assign
      877             tt0-gds-dtl.doc-code = '':U
      878             .
      879           end.
      880       end.
      881       assign
      882       old-qnty = tt0-gds-dtl.doc-qnty
      883       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
      884       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
      885       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
      886       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
      887       .
      888     end.
      889   end procedure.
      890   procedure fill-tt-tpsi-table :
      891   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
      892   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
      893   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
      894   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
      895   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
      896   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
      897   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
      898   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
      899   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
      900   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
      901   define buffer buf_goods for ub.goods.
      902   define buffer buf_doc-line for ub.doc-line.
      903   define buffer buf_gds-dtl for ub.gds-dtl.
      904   define buffer buf_sale-doc for ub.sale-doc.
      905     do
      906     on error undo, return error
      907     :
      908       _doc-line:
      909       for each buf_Doc-line no-lock where
      910             buf_doc-line.doc-code = p-doc-code,
      911         first buf_goods no-lock where
      912             buf_goods.artic = buf_doc-line.artic
      913        AND  buf_goods.prod-type  = buf_doc-line.prod-type
      914        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
      915           each buf_gds-dtl no-lock where
      916             buf_gds-dtl.doc-code = buf_doc-line.doc-code
      917         AND  buf_gds-dtl.artic    = buf_doc-line.artic
      918         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
      919         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
      920         assign
      921         v-ext-doc-type = "":U.
      922         run tpsi-preselect-gds-proprietor in this-procedure (
      923                                                     input buf_goods.gds-code
      924                                                   ,input g#db-num
      925                                                   ,output v-proprietor-host-code
      926                                                   ,output v-proprietor-obj-type
      927                                                   ,output v-proprietor-obj-code ) no-error .
      928         if v-proprietor-host-code = p-host-code then do:
      929           assign
      930           v-ext-doc-type = 'ev':U .
      931         end.
      932         else do:
      933           assign
      934           v-ext-doc-type =  'ee':U .
      935         end.
      936         if  (v-proprietor-obj-type = p-obj-type
      937         AND v-proprietor-obj-code = p-obj-code)
      938         OR (v-proprietor-obj-type = "":U
      939         AND v-proprietor-obj-code = 0)
      940         OR v-proprietor-obj-code = ?
      941         then next _doc-line.
      942         find first buf_sale-doc no-lock where
      943                   buf_sale-doc.inkas-code = p-doc-code
      944              AND buf_sale-doc.obj-type = v-proprietor-obj-type
      945              AND buf_sale-doc.obj-code = v-proprietor-obj-code
      946              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
      947              no-error .
      948         run create-tt0-doc-line-gds-dtl  in this-procedure (
      949                                                              input v-proprietor-obj-type
      950                                                             ,input v-proprietor-obj-code
      951                                                             ,input v-ext-doc-type
      952                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
      953                                                             ,input buf_doc-line.artic
      954                                                             ,input buf_Doc-line.prod-type
      955                                                             ,input buf_doc-line.prod-code
      956                                                             ,input buf_gds-dtl.prt-code
      957                                                             ,input 0
      958                                                             ,output v-was-gds-dtl-fact-qnty
      959                                                             ,output v-gds-dtl-fact-qnty
      960                                                             ,buffer buf_doc-line
      961                                                             ,buffer buf_gds-dtl
      962                                                             ,buffer buf_sale-doc
      963                                                           ).
      964       end.
      965     end.
      966   end procedure.
      967   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      968   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      969   procedure get-alias-type-price-obj :
      970   define input parameter p-host-code like ub.sysconf.host-code no-undo .
      971   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
      972   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
      973   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
      974   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
      975   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
      976   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
      977   define output parameter p-alias-type-price as character no-undo .
      978   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
      979   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
      980   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
      981   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
      982   define variable v-mediat-objf               as character no-undo .
      983   define variable v-param-type as character no-undo .
      984   define variable v-value-character as character no-undo .
      985   define variable v-value-date as date no-undo .
      986   define variable v-value-decimal as decimal no-undo .
      987   define variable v-value-integer as INTEGER no-undo .
      988   define variable v-value-logical AS LOGICAL no-undo .
      989   define variable v-tth as handle no-undo .
      990   assign
      991   v-tth = buffer thbjattr_thbj-attr:table-handle .
      992   define buffer buf_trn-doc for ub.trn-doc.
      993     _main:
      994     do
      995     on error undo, return error return-value
      996     :
      997       run adm/shattri.p (
      998         input "get":U
      999         ,input  p-prop-obj-type
     1000         ,input  p-prop-obj-code
     1001         ,input  'alias-tpsi':U
     1002         ,input  '':U
     1003         ,output v-value-character
     1004         ,output v-value-date
     1005         ,output v-value-decimal
     1006         ,output v-value-integer
     1007         ,output v-value-logical
     1008         ,output v-param-type
     1009         ,INPUT-OUTPUT table-handle v-tth
     1010         ) no-error .
     1011       if error-status:error
     1012       then do:
     1013         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1014                                 , p-prop-obj-type
     1015                                 , p-prop-obj-code).
     1016       end.
     1017       find first thbjattr_thbj-attr where
     1018                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1019             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1020             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1021             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
     1022       if not available thbjattr_thbj-attr
     1023       or thbjattr_thbj-attr.property-value-integer = 0 then do:
     1024         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1025                                 , p-prop-obj-type
     1026                                 , p-prop-obj-code).
     1027       end.
     1028       assign
     1029       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
     1030       if p-prop-host-code = p-host-code
     1031       and (p-alias-type-price = '':U
     1032       or   p-alias-type-price <> '5':U)
     1033       then  do:
     1034         assign
     1035         p-ext-doc-type = 'ev':U
     1036         p-price-obj-type = p-obj-type
     1037         p-price-obj-code = p-obj-code
     1038         p-alias-type-price = '3':U
     1039         .
     1040       end.
     1041       else do:
     1042         if p-prop-host-code = p-host-code  then do:
     1043           assign
     1044           p-ext-doc-type = 'ev':U
     1045           p-price-obj-type = p-obj-type
     1046           p-price-obj-code = p-obj-code
     1047           .
     1048         end.
     1049         else do:
     1050           assign
     1051           p-ext-doc-type = 'ee':U.
     1052           assign
     1053           v-mediat-obj-type = "":U
     1054           v-mediat-obj-code = 0
     1055           v-mediat-objf = "":U
     1056           .
     1057           if p-alias-type-price = '4':U then do:
     1058             find first thbjattr_thbj-attr where
     1059                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1060                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1061                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1062                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
     1063             if not available thbjattr_thbj-attr
     1064             or thbjattr_thbj-attr.property-value-character = "":U then do:
     1065               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
     1066                                       , p-prop-obj-type
     1067                                       , p-prop-obj-code).
     1068             end.
     1069             assign
     1070             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
     1071             v-mediat-obj-type = entry(1, v-mediat-objf)
     1072             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
     1073             no-error
     1074             .
     1075             if error-status:error then do:
     1076               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
     1077                                       , p-prop-obj-type
     1078                                       , p-prop-obj-code).
     1079             end.
     1080           end.
     1081           CASE p-alias-type-price:
     1082             when '1':U then do:
     1083               assign
     1084               p-price-obj-type = p-prop-obj-type
     1085               p-price-obj-code = p-prop-obj-code
     1086               .
     1087             end.
     1088             when '2':U then do:
     1089               assign
     1090               p-price-obj-type = p-prop-obj-type
     1091               p-price-obj-code = p-prop-obj-code
     1092               .
     1093             end.
     1094             when '3':U
     1095             or
     1096             when '5':U
     1097             then do:
     1098               assign
     1099               p-price-obj-type = p-obj-type
     1100               p-price-obj-code = p-obj-code
     1101               .
     1102             end.
     1103             when '4':U then do:
     1104               assign
     1105               p-price-obj-type = v-mediat-obj-type
     1106               p-price-obj-code = v-mediat-obj-code
     1107               .
     1108             end.
     1109           END CASE.
     1110         end.
     1111       end.
     1112     end.
     1113   end procedure.
     1114   procedure write-tt0-info:
     1115   define input parameter p-artic as character no-undo .
     1116   define input parameter p-prod-type as character no-undo .
     1117   define input parameter p-prod-code as integer no-undo .
     1118   define input parameter p-prt-code as integer no-undo .
     1119   define input parameter p-obj-type as character no-undo .
     1120   define input parameter p-obj-code as integer no-undo .
     1121   define input parameter p-doc-code as character no-undo .
     1122   define input parameter p-from-tpsi as logical no-undo .
     1123   define input parameter p-all-qnty as decimal no-undo .
     1124   define input parameter p-was-res as decimal no-undo .
     1125   define input parameter p-to-res as decimal no-undo .
     1126   define input parameter p-is-res as decimal no-undo .
     1127   define input parameter p-o-was-res as decimal no-undo .
     1128   define input parameter p-o-to-res as decimal no-undo .
     1129   define input parameter p-o-is-res as decimal no-undo .
     1130   define input parameter p-mess   as character no-undo .
     1131   define buffer buf_tt0-info for tt0-info.
     1132     do
     1133     on error undo, return error return-value
     1134     :
     1135       find first buf_tt0-info where
     1136                buf_tt0-info.artic = p-artic
     1137            and buf_tt0-info.prod-type = p-prod-type
     1138            and buf_tt0-info.prod-code = p-prod-code
     1139            and buf_tt0-info.prt-code = p-prt-code
     1140            no-error .
     1141       if not available buf_tt0-info then do:
     1142         create buf_tt0-info.
     1143         assign
     1144         buf_tt0-info.artic = p-artic
     1145         buf_tt0-info.prod-type = p-prod-type
     1146         buf_tt0-info.prod-code = p-prod-code
     1147         buf_tt0-info.prt-code  = p-prt-code
     1148         buf_tt0-info.obj-type  = p-obj-type
     1149         buf_tt0-info.obj-code  = p-obj-code
     1150         buf_tt0-info.a-to-res  = ?
     1151         buf_tt0-info.to-res    = ?
     1152         buf_tt0-info.was-res   = ?
     1153         buf_tt0-info.o-was-res = ?
     1154         buf_tt0-info.o-to-res  = ?
     1155         buf_tt0-info.o-is-res  = ?
     1156         buf_tt0-info.is-res    = ?
     1157         .
     1158       end.
     1159       assign
     1160       buf_tt0-info.a-to-res  =
     1161                                 (if buf_tt0-info.a-to-res <> ?
     1162                                 and p-all-qnty = ?
     1163                                 then buf_tt0-info.a-to-res
     1164                                 else p-all-qnty)
     1165       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
     1166                                 and p-was-res = ?
     1167                                 then buf_tt0-info.was-res
     1168                                 else p-was-res)
     1169       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
     1170                                 and p-to-res = ?
     1171                                 then buf_tt0-info.to-res
     1172                                 else p-to-res)
     1173       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
     1174                                 and p-is-res = ?
     1175                                 then buf_tt0-info.is-res
     1176                                 else p-is-res)
     1177       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
     1178                                 and p-o-was-res = ?
     1179                                 then buf_tt0-info.o-was-res
     1180                                 else p-o-was-res)
     1181       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
     1182                                 and p-o-to-res = ?
     1183                                 then buf_tt0-info.o-to-res
     1184                                 else p-o-to-res)
     1185       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
     1186                                 and p-o-is-res = ?
     1187                                 then buf_tt0-info.o-is-res
     1188                                 else p-o-is-res)
     1189       .
     1190       assign
     1191       buf_tt0-info.doc-code  = p-doc-code
     1192       buf_tt0-info.error-message   = p-mess
     1193       .
     1194     end.
     1195   end procedure.
     1196   define new global shared variable g#lib-trn  as handle no-undo .
     1197   define new global shared variable g#lib-trn2 as handle no-undo .
     1198   define new global shared variable g#lib-trn3 as handle no-undo .
     1199   define new global shared variable g#lib-trn4 as handle no-undo .
     1200   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1201   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     1202   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     1203   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     1204   define variable gp-excise     like ub.price-list.excise     no-undo.
     1205   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     1206   define variable gp-fact-order as decimal   no-undo .
     1207   define variable gp-price-sale-parts as decimal   no-undo .
     1208   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1209   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     1210   define variable v-ps as character no-undo .
     1211   if available buf_sale-doc then
     1212   assign
     1213   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     1214                       , chr(4)
     1215                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
     1216                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     1217                       , buf_sale-doc.chk-amount
     1218                       , buf_sale-doc.gds-amount
     1219                       , buf_sale-doc.tot-lines
     1220                       , buf_sale-doc.tot-dtl
     1221                       ).
     1222   else  do:
     1223   assign
     1224   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     1225                       , chr(4)
     1226                       , '':U
     1227                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     1228                       , 0
     1229                       , 0
     1230                       , 0
     1231                       , 0
     1232                       ).
     1233   end.
     1234   return v-ps.
     1235   END FUNCTION.
     1236   FUNCTION get-sale-doc-kind returns character (
     1237                                                input p-doc-kind as character
     1238                                              , input p-ext-doc-type as character
     1239                                              , output p-order as integer
     1240                                              , output p-msign as integer
     1241                                              , output p-main as logical
     1242                                              , output p-in-inkas as logical
     1243                                              , output p-dir_ as integer
     1244                                              ):
     1245   define variable v-doc-kind as character no-undo.
     1246   define variable v-type as character no-undo .
     1247   define variable v-value as character no-undo .
     1248   CASE p-doc-kind:
     1249     when 'es':U then do:
     1250       assign
     1251       p-order = 100
     1252       p-msign = 1
     1253       p-main = yes
     1254       p-in-inkas = yes
     1255       p-dir_ = 1
     1256       .
     1257       return p-ext-doc-type.
     1258     end.
     1259     when  'rs':U then do:
     1260       assign
     1261       p-order = 200
     1262       p-msign = - 1
     1263       p-main = no
     1264       p-in-inkas = yes
     1265       p-dir_ = - 1
     1266       .
     1267       return p-ext-doc-type.
     1268     end.
     1269     when 'rwo':U then do:
     1270       assign
     1271       p-msign = - 1
     1272       p-main = no
     1273       p-in-inkas = no
     1274       p-order = 300
     1275       p-dir_ = 1
     1276       .
     1277       return 'rwo':U.
     1278     end.
     1279     when 'trf':U then do:
     1280       assign
     1281       p-msign = 1
     1282       p-main = no
     1283       p-in-inkas = no
     1284       p-order = 400
     1285       p-dir_ = 1
     1286       .
     1287       return 'trf':U.
     1288     end.
     1289     when 'swo':U then do:
     1290      assign
     1291      p-msign = 1
     1292      p-main = no
     1293      p-in-inkas = no
     1294      p-order =  500
     1295      p-dir_ = 1
     1296      .
     1297      return 'swo':U.
     1298    end.
     1299    when 'vir':U then do:
     1300      assign
     1301      p-msign = 1
     1302      p-main = no
     1303      p-in-inkas = no
     1304      p-order = 600
     1305      p-dir_ = 1
     1306      .
     1307      return 'vir':U.
     1308    end.
     1309    when 'itr':U then do:
     1310      assign
     1311      p-msign = 1
     1312      p-main = no
     1313      p-in-inkas = no
     1314      p-order = -1
     1315      p-dir_ = -1
     1316      .
     1317     return 'itr':U.
     1318    end.
     1319    when 'ngs':U then do:
     1320      assign
     1321      p-msign = 1
     1322      p-main = no
     1323      p-in-inkas = no
     1324      p-order = 700
     1325      p-dir_ = 1
     1326      .
     1327      return 'ngs':U.
     1328    end.
     1329    when 'rgs':U then do:
     1330      assign
     1331      p-msign = -1
     1332      p-main = no
     1333      p-in-inkas = no
     1334      p-order = 701
     1335      p-dir_ = -1
     1336      .
     1337      return 'rgs':U.
     1338    end.
     1339    otherwise do:
     1340       assign
     1341       p-msign = 1
     1342       p-main = no
     1343       p-in-inkas = no
     1344       p-order = -1.
     1345       return p-ext-doc-type.
     1346     end.
     1347   END CASE.
     1348   END FUNCTION.
     1349   procedure saledoc-create :
     1350   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     1351   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1352   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1353   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1354   define input parameter p-doc-kind as character no-undo .
     1355   define input parameter p-office as character no-undo .
     1356   define input parameter p-tpsidoc as logical no-undo .
     1357   define input parameter p-alias-type-price as character no-undo .
     1358   define input parameter p-price-obj-type as character no-undo .
     1359   define input parameter p-price-obj-code as integer no-undo .
     1360   define parameter buffer buf_trn-doc for ub.trn-doc.
     1361   define variable v-order as integer no-undo.
     1362   define variable v-main as logical no-undo .
     1363   define variable v-in-inkas as logical no-undo .
     1364   define variable v-msign as integer no-undo .
     1365   define variable v-dir_ as integer no-undo .
     1366   define variable v-trn-doc-code as character no-undo .
     1367   define buffer buf_sale-doc for ub.sale-doc.
     1368   main-block:
     1369   do
     1370   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1371   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1372   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1373   :
     1374      if available buf_trn-doc then do:
     1375        v-trn-doc-code = buf_trn-doc.doc-code.
     1376      end.
     1377      find first buf_sale-doc where
     1378               buf_sale-doc.inkas-code = p-inkas-code
     1379           and buf_sale-doc.doc-kind = p-doc-kind
     1380           and buf_sale-doc.chr-office = p-office
     1381           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
     1382           no-error .
     1383      if not available buf_sale-doc  then do:
     1384         create buf_sale-doc.
     1385         assign
     1386         buf_sale-doc.inkas-code = p-inkas-code
     1387         buf_sale-doc.storage =  'trn-doc':U
     1388         buf_sale-doc.host-code = p-host-code
     1389         buf_sale-doc.obj-type = p-obj-type
     1390         buf_sale-doc.obj-code = p-obj-code
     1391         buf_sale-doc.doc-kind  = p-doc-kind
     1392         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
     1393         buf_sale-doc.chr-office = p-office
     1394         buf_sale-doc.doc-code = v-trn-doc-code
     1395         .
     1396      end.
     1397      if available buf_trn-doc then
     1398      buffer-copy buf_trn-doc
     1399      to buf_sale-doc
     1400      .
     1401     assign
     1402     buf_sale-doc.doc-kind = get-sale-doc-kind (
     1403                                                input p-doc-kind
     1404                                               ,input buf_sale-doc.ext-doc-type
     1405                                               ,output v-order
     1406                                               ,output v-msign
     1407                                               ,output v-main
     1408                                               ,output v-in-inkas
     1409                                               ,output v-dir_).
     1410     assign
     1411     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
     1412     buf_sale-doc.main-doc = v-main
     1413     buf_sale-doc.in-inkas = v-in-inkas
     1414     buf_sale-doc.msign = v-msign
     1415     buf_sale-doc.dir = v-dir_
     1416     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
     1417     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
     1418     buf_sale-doc.poss-wro-codes = '':U
     1419     buf_sale-doc.chr-office = p-office
     1420     buf_sale-doc.tpsidoc = p-tpsidoc
     1421     buf_sale-doc.alias-type-price = p-alias-type-price
     1422     buf_sale-doc.price-obj-type = (if p-tpsidoc
     1423                                    then p-price-obj-type
     1424                                    else '':U)
     1425     buf_sale-doc.price-obj-code = (if p-tpsidoc
     1426                                    then p-price-obj-code
     1427                                    else 0)
     1428     .
     1429     assign
     1430     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
     1431     no-error.
     1432   end.
     1433   END.
     1434   procedure fbr-saledoc-create :
     1435   define input parameter p-inkas-code as character no-undo .
     1436   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
     1437   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
     1438   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
     1439   define buffer buf_fbr-doc for ub.fbr-doc.
     1440   define buffer buf_trn-doc for ub.trn-doc.
     1441   define buffer buf_sale-doc for ub.sale-doc.
     1442   define buffer buf2_sale-doc for ub.sale-doc.
     1443   define buffer buf2_trn-doc for ub.trn-doc.
     1444   define buffer buf_doc-line for ub.doc-line.
     1445   define buffer buf_gds-dtl for ub.gds-dtl.
     1446   define buffer buf_chk-gds for ub.chk-gds.
     1447   define buffer buf_chk-doc for ub.chk-doc.
     1448   do
     1449   on error undo, return error
     1450   :
     1451     for each buf_fbr-doc no-lock where
     1452           buf_fbr-doc.out-code = p-inkas-code:
     1453       for each buf_trn-doc no-lock where
     1454             buf_trn-doc.out-code = buf_fbr-doc.doc-code
     1455       by buf_trn-doc.fact-order
     1456       on error undo, return error:
     1457         if buf_trn-doc.ext-doc-type = 'em':U
     1458         or buf_trn-doc.ext-doc-type = 'im':U
     1459         or buf_trn-doc.ext-doc-type = 'wm':U
     1460         or buf_trn-doc.ext-doc-type = 'ev':U
     1461         or buf_trn-doc.ext-doc-type = 'iv':U
     1462         then do:
     1463           find first buf_sale-doc where
     1464                   buf_sale-doc.inkas-code = p-inkas-code
     1465               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
     1466               AND buf_sale-doc.storage  = 'trn-doc':U
     1467                   no-error .
     1468           if not available buf_sale-doc then do:
     1469           create buf_sale-doc.                                                                                             buffer-copy buf_trn-doc                                                                                             to buf_sale-doc.                                                                                                assign                                                                                                                  buf_sale-doc.storage  =  'trn-doc':U                                                                          buf_sale-doc.doc-kind = buf_trn-doc.ext-doc-type                                                                buf_sale-doc.order =  - 1                                                                                          buf_sale-doc.main-doc = no                                                                                             buf_sale-doc.in-inkas = no                                                                                         buf_sale-doc.fbrsale = yes                                                                                         buf_sale-doc.msign = 1                                                                                             buf_sale-doc.filled   = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0                       buf_sale-doc.doc-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf_sale-doc.doc-qnty)                                                          buf_sale-doc.fact-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf_sale-doc.fact-qnty)                                                        buf_sale-doc.inkas-code = p-inkas-code.
     1470           end.
     1471           if buf_trn-doc.ext-doc-type = 'im':U then do:
     1472             assign
     1473             v-pri-prvo-doc-qnty = buf_trn-doc.doc-qnty
     1474             v-pri-prvo-fact-qnty = buf_trn-doc.fact-qnty
     1475             v-pri-prvo-tot-lines = buf_trn-doc.tot-lines
     1476             .
     1477           end.
     1478           for each buf2_trn-doc no-lock where
     1479                   buf2_trn-doc.out-code = buf_sale-doc.doc-code:
     1480             find first buf2_sale-doc where
     1481                     buf2_sale-doc.inkas-code = p-inkas-code
     1482                 and buf2_sale-doc.doc-code = buf2_trn-doc.doc-code
     1483                 AND buf2_sale-doc.storage = 'trn-doc':U no-error .
     1484             if not available buf2_sale-doc then do:
     1485               create buf2_sale-doc.                                                                                             buffer-copy buf2_trn-doc                                                                                             to buf2_sale-doc.                                                                                                assign                                                                                                                  buf2_sale-doc.storage  =  'trn-doc':U                                                                          buf2_sale-doc.doc-kind = buf2_trn-doc.ext-doc-type                                                                buf2_sale-doc.order =  - 1                                                                                          buf2_sale-doc.main-doc = no                                                                                             buf2_sale-doc.in-inkas = no                                                                                         buf2_sale-doc.fbrsale = yes                                                                                         buf2_sale-doc.msign = 1                                                                                             buf2_sale-doc.filled   = buf2_sale-doc.fact-qnty <> 0 or buf2_sale-doc.tot-lines <> 0                       buf2_sale-doc.doc-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf2_sale-doc.doc-qnty)                                                          buf2_sale-doc.fact-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf2_sale-doc.fact-qnty)                                                        buf2_sale-doc.inkas-code = p-inkas-code.
     1486             end.
     1487           end.
     1488         end.
     1489       end.
     1490       find first buf_sale-doc where
     1491                 buf_sale-doc.inkas-code = p-inkas-code
     1492             AND buf_sale-doc.storage = 'fbr-doc':U
     1493             AND buf_sale-doc.doc-code = buf_fbr-doc.doc-code no-error .
     1494       if not available buf_sale-doc then do:
     1495         create buf_sale-doc.
     1496         assign
     1497         buf_sale-doc.storage       =  'fbr-doc':U
     1498         buf_sale-doc.doc-type      = 'производство':U
     1499         buf_sale-doc.doc-code      = buf_fbr-doc.doc-code
     1500         buf_sale-doc.ext-doc-type  = 'производство':U
     1501         buf_sale-doc.doc-kind      = 'производство':U
     1502         buf_sale-doc.obj-type      = buf_fbr-doc.obj-type
     1503         buf_sale-doc.obj-code      = buf_fbr-doc.obj-code
     1504         buf_sale-doc.cli-type      = buf_fbr-doc.obj-type
     1505         buf_sale-doc.cli-code      = buf_fbr-doc.obj-code
     1506         buf_sale-doc.doc-qnty      = v-pri-prvo-doc-qnty
     1507         buf_sale-doc.fact-qnty     = v-pri-prvo-fact-qnty
     1508         buf_sale-doc.tot-lines     = v-pri-prvo-tot-lines
     1509         buf_sale-doc.tot-dtl       = v-pri-prvo-tot-lines
     1510         buf_sale-doc.fbrsale       = yes
     1511         buf_sale-doc.inkas-code    = p-inkas-code
     1512         .
     1513       end.
     1514     end.
     1515   end.
     1516   end procedure.
     1517   define variable v-base-code                 like ub.sysconf.base-code no-undo .
     1518   define variable v-alias-type-price          as character no-undo .
     1519   define variable v-doc-code                  like ub.trn-doc.doc-code no-undo .
     1520   define variable v-prop-host-code            like ub.sysconf.host-code no-undo .
     1521   define variable v-prop-base-code            like ub.sysconf.base-code no-undo .
     1522   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
     1523   define variable v-price-obj-type            like ub.trn-doc.obj-type no-undo .
     1524   define variable v-price-obj-code            like ub.trn-doc.obj-code no-undo .
     1525   define variable v-sys-today                 as date no-undo .
     1526   define variable v-base-rate                 like ub.curr-accnt.exch-rate no-undo .
     1527   define variable v-base-scale                like ub.curr-accnt.exch-scale no-undo .
     1528   define variable v-exch-rate                 like ub.curr-accnt.exch-rate no-undo .
     1529   define variable v-exch-scale                like ub.curr-accnt.exch-scale no-undo .
     1530   define variable v-curr-abbr                 as character no-undo .
     1531   define variable v-attr-value                as character no-undo .
     1532   define variable v-attr-type                 as character no-undo .
     1533   define variable l-shift-on                  as logical no-undo init no.
     1534   define variable v-shift-date                like ub.shift-obj.shift-date no-undo.
     1535   define variable v-shift-num                 like ub.shift-obj.shift-num no-undo.
     1536   define variable v-shift-name                as   character no-undo.
     1537   define variable v-out-pay                   like ub.shop.out-pay no-undo .
     1538   define variable v-purch-code                like ub.trn-doc.purch-code no-undo .
     1539   define variable v-purch-name                as character no-undo .
     1540   define variable v-curr-code                 like ub.contract.curr-code no-undo .
     1541   define variable v-contract-code             like ub.trn-doc.contract-code no-undo .
     1542   define variable v-gds-code                  like ub.goods.gds-code  no-undo .
     1543   define variable v-mes                       as character no-undo .
     1544   define variable v-ps                        as character no-undo .
     1545   define variable v-discnt-type               as character no-undo .
     1546   define variable prev-doc-code               like ub.trn-doc.doc-code no-undo .
     1547   define variable v-num_rec-res-exist         as integer no-undo .
     1548   define variable v-current-doc-code          as character no-undo .
     1549   define buffer buf_bar-code for ub.bar-code.
     1550   define buffer buf_Clients for ub.clients.
     1551   define buffer buf_shop    for ub.shop.
     1552   define buffer buf_store for ub.store.
     1553   define buffer buf_contract for ub.contract.
     1554   define buffer buf_prop_trn-doc for ub.trn-doc.
     1555   define buffer buf_doc-line for ub.doc-line.
     1556   define buffer buf_gds-dtl  for ub.gds-dtl.
     1557   define buffer bufi_gds-dtl  for ub.gds-dtl.
     1558   define buffer buf_tt0-gds-dtl for tt0-gds-dtl.
     1559   define buffer buf_sysconf for ub.sysconf.
     1560   define buffer buf_tt0-doc-line for tt0-doc-line.
     1561   define buffer prev_sale-doc for ub.sale-doc.
     1562   define buffer buf_sale-doc for ub.sale-doc.
     1563   define temp-table tt0-one-doc-line no-undo like lib-trn_ret-line.
     1564   define temp-table tt0-one-gds-dtl  no-undo like ub.gds-dtl.
     1565   define temp-table tt0-one-parts    no-undo like ub.parts.
     1566   _main:
     1567   do
     1568   on error undo, return error return-value :
     1569     find first buf_clients no-lock where
     1570               buf_clients.obj-type = p-obj-type
     1571           AND buf_clients.obj-code = p-obj-code.
     1572   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1573   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1574     (input  p-host-code
     1575     ,output v-base-code
     1576     )  .
     1577     _doc-line:
     1578     for each tt0-doc-line where
     1579             tt0-doc-line.doc-code = "":U,
     1580         each tt0-gds-dtl where
     1581             tt0-gds-dtl.obj-type = tt0-doc-line.obj-type
     1582         AND tt0-gds-dtl.obj-code = tt0-doc-line.obj-code
     1583         AND tt0-gds-dtl.prod-type = tt0-doc-line.prod-type
     1584         AND tt0-gds-dtl.prod-code = tt0-doc-line.prod-code
     1585         AND tt0-gds-dtl.artic     = tt0-doc-line.artic
     1586         break
     1587         by tt0-doc-line.obj-type
     1588         by tt0-doc-line.obj-code
     1589         :
     1590       if p-artic = '':U
     1591       or (tt0-doc-line.artic = p-artic
     1592             and tt0-doc-line.prod-type = p-prod-type
     1593             and tt0-doc-line.prod-code = p-prod-code)
     1594             then do:
     1595         run write-tt0-info in this-procedure (
     1596                                               input tt0-doc-line.artic
     1597                                             ,input tt0-doc-line.prod-type
     1598                                             ,input tt0-doc-line.prod-code
     1599                                             ,input tt0-gds-dtl.prt-code
     1600                                             ,input tt0-doc-line.obj-type
     1601                                             ,input tt0-doc-line.obj-code
     1602                                             ,input tt0-doc-line.doc-code
     1603                                             ,input yes
     1604                                             ,input ?
     1605                                             ,input ?
     1606                                             ,input ?
     1607                                             ,input ?
     1608                                             ,input tt0-gds-dtl.doc-qnty
     1609                                             ,input (if p-rz then (tt0-gds-dtl.doc-qnty - tt0-gds-dtl.fact-qnty)
     1610                                                     else ( - tt0-gds-dtl.doc-qnty)
     1611                                                     )
     1612                                             ,input tt0-gds-dtl.doc-qnty
     1613                                             ,input '':u).
     1614         if p-num_rec_other modulo  10 = 0 then do:
     1615           assign
     1616           v-mes = substitute("&1 ЧУЖИХ товаров - обработано строк &2 успешно &3"
     1617                                                                 , p-title
     1618                                                                 , p-num_rec_other
     1619                                                                 , p-num_rec_other_res
     1620                                                                 ).
     1621           if p-auto = 0 then
     1622           run waitfram-show in this-procedure (input v-mes).
     1623           else
     1624           run write-counter in p-log-handle (input v-mes).
     1625         end.
     1626         assign
     1627         p-num_rec_other = p-num_rec_other + 1 .
     1628       end.
     1629       if first-of(tt0-doc-line.obj-code) then do:
     1630   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1631   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1632     (input  tt0-doc-line.obj-type
     1633     ,input  tt0-doc-line.obj-code
     1634     ,output v-prop-host-code
     1635     )  .
     1636   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1637   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1638     (input  v-prop-host-code
     1639     ,output v-prop-base-code
     1640     )  .
     1641         run get-alias-type-price-obj  in this-procedure (
     1642                                                             input p-host-code
     1643                                                             ,input p-obj-type
     1644                                                             ,input p-obj-code
     1645                                                             ,input v-prop-host-code
     1646                                                             ,input tt0-doc-line.obj-type
     1647                                                             ,input tt0-doc-line.obj-code
     1648                                                             ,output v-ext-doc-type
     1649                                                             ,output v-alias-type-price
     1650                                                             ,output v-price-obj-type
     1651                                                             ,output v-price-obj-code) no-error .
     1652         if error-status:error then do:
     1653           undo _main, return error substitute("Ошибка при получении типа цены и объекта цены для перемещения с &1&2 на &3&4:&5&6 &7"
     1654                                   , p-obj-type
     1655                                   , p-obj-code
     1656                                   , tt0-doc-line.obj-type
     1657                                   , tt0-doc-line.obj-code
     1658                                   , chr(10)
     1659                                   , error-status:get-message(1)
     1660                                   , return-value ).
     1661         end.
     1662         CASE tt0-doc-line.obj-type:
     1663           when 'маг':U then do:
     1664             find first buf_shop no-lock where
     1665                       buf_shop.obj-code = tt0-doc-line.obj-code no-error .
     1666             if not available buf_shop then
     1667             undo _main, return error substitute("Не найден &1&2 (ОБЪЕКТ для перемещения ЧУЖИХ товаров для &2&3)"
     1668                                       , tt0-doc-line.obj-type
     1669                                       , tt0-doc-line.obj-code
     1670                                       , p-obj-type
     1671                                       , p-obj-code
     1672                                       ).
     1673             assign
     1674             v-out-pay = buf_shop.out-pay.
     1675           end.
     1676           when 'скл':U then do:
     1677             find first buf_store no-lock where
     1678                       buf_store.obj-code = tt0-doc-line.obj-code no-error .
     1679             if not available buf_store then
     1680             undo _main, return error substitute("Не найден &1&2 (ОБЪЕКТ для перемещения ЧУЖИХ товаров для &2&3)"
     1681                                       , tt0-doc-line.obj-type
     1682                                       , tt0-doc-line.obj-code
     1683                                       , p-obj-type
     1684                                       , p-obj-code
     1685                                       ).
     1686             assign
     1687             v-out-pay = buf_store.out-pay.
     1688           end.
     1689         END CASE.
     1690         if p-host-code <> v-prop-host-code then do:
     1691           find first buf_contract no-lock where
     1692                     buf_contract.host-code = p-host-code
     1693                 AND buf_contract.cli-type = 'орг':U
     1694                 AND buf_contract.cli-code = v-prop-host-code
     1695                 AND buf_contract.status_ = 'тек':U
     1696                 AND buf_contract.contract-type = 'Продажи через ТПСИ':U no-error .
     1697           if available buf_contract then do:
     1698             run get-purch-contract in this-procedure (
     1699                                                         input buf_contract.host-code
     1700                                                        ,input buf_contract.contract-code
     1701                                                        ,output v-purch-code
     1702                                                        ,output v-purch-name) no-error .
     1703             if error-status:error then do:
     1704               undo _main, return error substitute("Ошибка при определении типа приобретения для документа межфирменного перемещения ЧУЖИХ товаров с &1&2:&3&4&5"
     1705                                             , tt0-doc-line.obj-type
