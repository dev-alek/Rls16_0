      378   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   procedure doc-code:
      380   define input  parameter parmode          as   character           no-undo.
      381   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      382   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      383   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      384   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      385   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      386   define variable vardb-remote     as   logical             no-undo.
      387   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      388   define variable v-delimiter as character no-undo .
      389   do
      390   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      391   :
      392   find first buf_sys-ctrl no-lock .
      393   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      394     CASE parmode:
      395       when "main":u then do:
      396         if vardb-remote then do:
      397           assign
      398             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      399         end.
      400         else do:
      401           assign
      402             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      403         end.
      404       end.
      405       when "trio" then do:
      406         assign
      407           pardoc-code = replace (parroot-doc-code, "=", "*").
      408       end.
      409       otherwise do:
      410         assign
      411         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      412         no-error
      413         .
      414         if error-status:error  then do:
      415           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      416                                         ,chr(10)
      417                                         ,parmode
      418                                         ).
      419         end.
      420         if num-entries(parmode) = 1
      421         and parmode <> "chip":U
      422         and parmode <> "chip_s":U
      423         then do:
      424           assign
      425           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      426         end.
      427         else if (lookup("chip":U, parmode) > 0
      428                  or
      429                  lookup("chip_s":U, parmode) > 0) then do:
      430           assign
      431             vartemp-doc-code = parroot-doc-code.
      432           do while true:
      433             if index (vartemp-doc-code , ".") = 0 then
      434               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      435             else
      436               vartemp-doc-code  =
      437               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      438               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      439               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      440             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      441           end.
      442           assign
      443             pardoc-code = vartemp-doc-code.
      444         end.
      445       end.
      446     end CASE.
      447     if pardoc-code = '':U
      448     or (parroot-doc-code <> '':U
      449     and pardoc-code = parroot-doc-code) then do:
      450       undo, return error substitute("Ошибка при генерации номера документа&1"
      451                                     ,chr(10)).
      452     end.
      453   end.
      454   end. // procedure/method
      455   function get-doc-code-int64 returns int64
      456     ( input p-doc-code as character ) :
      457     define variable v-ind              as integer   no-undo .
      458     define variable v-num-entries      as integer   no-undo .
      459     define variable v-doc-code-int64   as int64     no-undo .
      460     define variable v-canonic-doc-code as character no-undo .
      461     assign
      462       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      463       v-canonic-doc-code = p-doc-code
      464     .
      465     do v-ind = 1 to v-num-entries
      466     :
      467       assign
      468         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      469       .
      470     end.
      471     assign
      472       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      473     .
      474     return v-doc-code-int64 .
      475   end. // function/method
      476   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      477   define variable v-waitfram-action01         as character   no-undo .
      478   define variable v-waitfram-action02         as character   no-undo .
      479   define variable v-waitfram-action03         as character   no-undo .
      480   define variable mWaitFramTextBeg            as character   no-undo.
      481   define variable mWaitFramTextEnd            as character   no-undo.
      482   define variable mWaitFramView               as logical     no-undo.
      483   define variable mWaitProcEvent              as logical     no-undo init yes.
      484   define variable mWaitFramInterval           as integer     no-undo init 1 .
      485   define variable mWaitFramStop               as logical     no-undo.
      486   define variable mWaitFramStopUser           as logical     no-undo.
      487   define variable mWaitFramStopTimeOut        as logical     no-undo.
      488   define variable mWaitFramStartProc          as datetime-tz no-undo.
      489   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      490   define button B-WaitFramStop auto-end-key
      491        label "Стоп"
      492        size 10 by 1 tooltip "Остоновить процесс".
      493   define button B-viewProcInfo
      494        label "Информация"
      495        size 15 by 1 tooltip "Информация о процесс".
      496   define frame waitfram
      497     v-waitfram-action01 format "x(72)" no-label skip
      498     v-waitfram-action02 format "x(72)" no-label skip
      499     v-waitfram-action03 format "x(72)" no-label skip
      500     B-viewProcInfo
      501     B-WaitFramStop at row 4 col 30
      502     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      503     .
      504   define new global shared variable mBatchMode as logical no-undo init ?.
      505   define variable mFramBachModHandle as handle no-undo.
      506   mFramBachModHandle = frame waitfram:handle.
      507   define variable mFameOldVis as logical no-undo.
      508   define variable mVisCUrentVin as logical no-undo.
      509   if session:batch-mode
      510   then
      511      mBatchMode = yes.
      512   if mBatchMode = ? then do:
      513     mVisCUrentVin = current-window:visible.
      514     mFameOldVis = mFramBachModHandle:visible.
      515     mFramBachModHandle:visible  = yes.
      516     mBatchMode = mFramBachModHandle:visible ne yes.
      517     mFramBachModHandle:visible = mFameOldVis.
      518     current-window:visible = mVisCUrentVin.
      519   end.
      520    if  log-manager:logfile-name ne ?
      521     then DO:
      522         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      523         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      524         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      525     end.
      526   on choose of B-WaitFramStop in frame waitfram
      527   do:
      528     mWaitFramStop = yes.
      529     mWaitFramStopUser = yes.
      530   end.
      531   function waitfram-check-timeout returns logical():
      532      define variable vtime as int64 no-undo.
      533      if mWaitFramStopTimeOut
      534      then
      535         return yes.
      536      vtime = ( now - mWaitFramStartProc ) / 1000 .
      537      if     mWaitFramTimeOut ne ?
      538         and mWaitFramTimeOut ne 0
      539         and mWaitFramTimeOut lt vtime
      540      then do:
      541         mWaitFramStopTimeOut = yes.
      542      end.
      543      return mWaitFramStopTimeOut.
      544   end.
      545   procedure waitfram-hide :
      546     if not session:batch-mode
      547     then do
      548     on error undo, return error return-value
      549     :
      550       pause 0 before-hide .
      551       if not mBatchMode then
      552         hide frame waitfram .
      553     if     not mWaitFramView
      554        and mWaitProcEvent
      555     then
      556       process events .
      557     end.
      558   end procedure.
      559   procedure waitfram-show :
      560     define input  parameter p-message as character no-undo .
      561     define variable v-left-margin as integer   no-undo .
      562     if not session:batch-mode
      563     then do
      564     on error undo, return error return-value
      565     :
      566       if length(p-message) <= 70 then do:
      567         assign
      568           v-left-margin = integer((70 - length(p-message)) / 2)
      569         .
      570         assign
      571           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      572         .
      573         assign
      574           v-waitfram-action01 = " "
      575           v-waitfram-action02 = " "
      576                                    + fill(" ", v-left-margin)
      577                                    + p-message
      578           v-waitfram-action03 = " "
      579         .
      580       end.
      581       else do:
      582         define variable vRindex1 as integer no-undo.
      583         define variable vRindex2 as integer no-undo.
      584         vRindex1 = r-index(p-message," ",70).
      585         if vRindex1 = 0
      586         then
      587            vRindex1 = 70.
      588         if length(p-message)  <= vRindex1 + 70 then do:
      589           assign
      590             v-waitfram-action01 = " "
      591             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      592             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      593           .
      594         end.
      595         else do:
      596           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      597           if vRindex2 <= vRindex1
      598           then
      599              vRindex2 = vRindex1 + 70.
      600           assign
      601             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      602             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      603             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      604           .
      605         end.
      606       end.
      607       B-viewProcInfo:visible   in frame waitfram = no.
      608       B-viewProcInfo:sensitive in frame waitfram = no.
      609       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      610       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      611       if  (   mWaitFramView
      612          or  mWaitProcEvent)
      613          and not mBatchMode
      614       then
      615          display
      616             v-waitfram-action01 skip
      617             v-waitfram-action02 skip
      618             v-waitfram-action03 skip
      619          with frame waitfram .
      620       if     mWaitFramView
      621          then do:
      622             if     mWaitFramInterval ne ?
      623                and not mBatchMode
      624             then
      625                wait-for go of frame waitfram pause mWaitFramInterval.
      626          end.
      627          else
      628             if     mWaitProcEvent
      629                and not mBatchMode
      630             then
      631                process events .
      632     end.
      633   end procedure.
      634      procedure waitfram-show-this:
      635         define input  parameter iInterval as int64 no-undo.
      636         define variable vtime as int64 no-undo.
      637         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      638         mWaitFramInterval = iInterval.
      639         run waitfram-show (substitute("&1&2 &3&4" ,
      640                                       mWaitFramTextBeg ,
      641                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      642                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      643                                       mWaitFramTextEnd
      644                                      )
      645                           ).
      646      end.
      647      procedure WaitFramRunPause:
      648         define input  parameter iInterval as dec no-undo.
      649         define variable vStart  as datetime-tz no-undo.
      650         define variable vend    as datetime-tz no-undo.
      651         define variable vint as int64 no-undo.
      652         define variable vOk as logical no-undo.
      653         vStart = now.
      654         vend   = vStart.
      655         publish "WaitFramPause" (iInterval,output vOk).
      656         vend   =  now.
      657         vint = vend - vStart.
      658         vint = iInterval - vint / 1000.
      659         if     not mWaitFramStop
      660            and (   vint > 0
      661                 or (    not vOk
      662                     and iInterval eq ?
      663                     )
      664                 )
      665         then
      666            run waitfram-show-this (iInterval).
      667         vend   =  now.
      668         vint = vend - vStart.
      669         vint = iInterval - vint / 1000.
      670         if     not mWaitFramStop
      671            and vint > 0
      672         then do:
      673            run gbl/pause.p (vint * 1000).
      674         end.
      675         if iInterval ne ?
      676         then
      677            publish "WaitFramStop".
      678         waitfram-check-timeout().
      679      end.
      680      procedure WaitFramWaitFor:
      681         define input  parameter iInterval as dec no-undo.
      682         assign
      683            mWaitFramStartProc   = now
      684            mWaitFramStopUser    = no
      685            mWaitFramStopTimeOut = no
      686         .
      687         block-wait:
      688         do while not mWaitFramStop:
      689            run WaitFramRunPause (iInterval).
      690            if  waitfram-check-timeout()
      691            then do:
      692               leave block-wait.
      693            end.
      694         end.
      695         run waitfram-hide.
      696      end.
      697   procedure waitfram-join :
      698     define input  parameter p-line-1  as character no-undo .
      699     define input  parameter p-line-2  as character no-undo .
      700     define input  parameter p-line-3  as character no-undo .
      701     define output parameter p-message as character no-undo .
      702     do
      703     on error undo, return error return-value
      704     :
      705       assign
      706         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      707                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      708                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      709       .
      710     end.
      711   end procedure.
      712   function waitfram-join-function returns character
      713     (input p-line-1 as character
      714     ,input p-line-2 as character
      715     ,input p-line-3 as character
      716     ).
      717     define variable v-message as character no-undo .
      718     run waitfram-join in this-procedure
      719       (input  p-line-1
      720       ,input  p-line-2
      721       ,input  p-line-3
      722       ,output v-message
      723       ) .
      724     return v-message .
      725   end function .
      726   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      727   define new global shared variable g#trdcalib as handle no-undo.
      728   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      729   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      730   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      731     field cst-code                like ub.trn-doc.cst-code
      732     field part-code               like ub.parts.part-code
      733     .
      734   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      735   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      736   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      737   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      738   define SHARED temp-table tt0-info no-undo
      739   field doc-code   like ub.trn-doc.doc-code
      740   field artic      like ub.doc-line.artic
