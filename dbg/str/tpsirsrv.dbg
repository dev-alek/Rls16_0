     2046             tt0-gds-dtl.price-base = (if v-curr-r-b = 'base':U
     2047                                       then gp-price-sale
     2048                                       else gp-price-sale / (v-base-rate / v-base-scale))
     2049             tt0-doc-line.road-tax    = gp-road-tax
     2050             tt0-doc-line.excise      = gp-excise
     2051             tt0-gds-dtl.doc-code   = v-current-doc-code
     2052             tt0-doc-line.doc-code  = v-current-doc-code
     2053             tt0-gds-dtl.ov         = yes
     2054             .
     2055           end.
     2056         END CASE.
     2057       end.
     2058     end.
     2059     define variable v-rsrv-fact-qnty                      as logical no-undo init yes.
     2060     define variable v-all-qnty                            as logical no-undo .
     2061     define variable v-fix-price                           as logical no-undo init yes .
     2062     define variable v-use-parts                           as logical no-undo .
     2063     _tpsi-doc:
     2064     for each ub.sale-doc no-lock where
     2065              ub.sale-doc.inkas-code = p-inkas-code
     2066          and ub.sale-doc.tpsidoc = yes,
     2067         first buf_prop_trn-doc where
     2068               buf_prop_trn-doc.doc-code = ub.sale-doc.doc-code,
     2069         first buf_sysconf no-lock where
     2070              buf_sysconf.host-code = ub.sale-doc.host-code :
     2071       if p-artic <> "":U then do:
     2072         find first buf_tt0-doc-line no-lock where
     2073                   (buf_tt0-doc-line.doc-code = sale-doc.doc-code
     2074              AND  buf_tt0-doc-line.artic = p-artic
     2075              AND  buf_tt0-doc-line.prod-type = p-prod-type
     2076              AND  buf_tt0-doc-line.prod-code = p-prod-code)
     2077           or     (buf_tt0-doc-line.obj-type = sale-doc.obj-type
     2078              and  buf_tt0-doc-line.obj-code = sale-doc.obj-code
     2079              AND  buf_tt0-doc-line.artic = p-artic
     2080              AND  buf_tt0-doc-line.prod-type = p-prod-type
     2081              AND  buf_tt0-doc-line.prod-code = p-prod-code)
     2082                 no-error .
     2083         if not available buf_tt0-doc-line then NEXT _tpsi-doc.
     2084       end.
     2085       assign
     2086       buf_prop_trn-doc.status_ = 'накл':U
     2087       buf_prop_trn-doc.flag_  = no
     2088       .
     2089       if p-artic = '':U then do:
     2090   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_copy-ret in g#lib-trn
     2091     (
     2092       input parparentproc
     2093     , input sale-doc.doc-code
     2094     , input buf_trn-doc.doc-type
     2095     , input buf_trn-doc.status_
     2096     , input buf_trn-doc.internal
     2097     , input buf_trn-doc.cli-type
     2098     , input buf_trn-doc.cli-code
     2099     , input buf_trn-doc.discnt-type
     2100     , input buf_trn-doc.tot-calc
     2101     , input buf_trn-doc.discnt-pc
     2102     , input buf_trn-doc.agnt
     2103     , input buf_trn-doc.boss
     2104     , input buf_trn-doc.wrkr
     2105     , input buf_trn-doc.base-rate
     2106     , input buf_trn-doc.base-scale
     2107     , input buf_trn-doc.exch-code
     2108     , input buf_trn-doc.vat-type
     2109     , input buf_prop_trn-doc.doc-code
     2110     , input no
     2111     , input buf_prop_trn-doc.discnt-pc
     2112     , input buf_prop_trn-doc.agnt
     2113     , input buf_prop_trn-doc.boss
     2114     , input buf_prop_trn-doc.wrkr
     2115     , input buf_prop_trn-doc.base-rate
     2116     , input buf_prop_trn-doc.base-scale
     2117     , input buf_sysconf.cash-pay
     2118     , input buf_sysconf.base-code
     2119     , input-output table tt0-doc-line
     2120     , input-output table tt0-gds-dtl
     2121     , input-output table tt0-parts
     2122     , input v-use-parts
     2123     , input v-all-qnty
     2124     , input v-fix-price
     2125     , input v-rsrv-fact-qnty
     2126     ) no-error.
     2127       end.
     2128       else do:
     2129         for each tt0-one-doc-line:
     2130           delete tt0-one-doc-line.
     2131         end.
     2132         for each tt0-one-gds-dtl:
     2133           delete tt0-one-gds-dtl.
     2134         end.
     2135         for each tt0-one-parts:
     2136           delete tt0-one-parts.
     2137         end.
     2138         for each tt0-gds-dtl where
     2139                tt0-gds-dtl.artic = p-artic
     2140            and tt0-gds-dtl.prod-type = tt0-gds-dtl.prod-type
     2141            and tt0-gds-dtl.prod-code = tt0-gds-dtl.prod-code
     2142            and tt0-gds-dtl.prt-code = tt0-gds-dtl.prt-code:
     2143            create tt0-one-gds-dtl.
     2144            buffer-copy tt0-gds-dtl to tt0-one-gds-dtl.
     2145            leave.
     2146         end.
     2147         for each tt0-doc-line where
     2148                tt0-doc-line.artic = p-artic
     2149            and tt0-doc-line.prod-type = tt0-doc-line.prod-type
     2150            and tt0-doc-line.prod-code = tt0-doc-line.prod-code:
     2151            create tt0-one-doc-line.
     2152            buffer-copy tt0-doc-line
     2153            except doc-qnty fact-qnty cli-qnty
     2154            to tt0-one-doc-line.
     2155            buffer-copy tt0-gds-dtl using  doc-qnty fact-qnty
     2156            to tt0-one-doc-line.
     2157         end.
     2158   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_copy-ret in g#lib-trn
     2159     (
     2160       input parparentproc
     2161     , input sale-doc.doc-code
     2162     , input buf_trn-doc.doc-type
     2163     , input buf_trn-doc.status_
     2164     , input buf_trn-doc.internal
     2165     , input buf_trn-doc.cli-type
     2166     , input buf_trn-doc.cli-code
     2167     , input buf_trn-doc.discnt-type
     2168     , input buf_trn-doc.tot-calc
     2169     , input buf_trn-doc.discnt-pc
     2170     , input buf_trn-doc.agnt
     2171     , input buf_trn-doc.boss
     2172     , input buf_trn-doc.wrkr
     2173     , input buf_trn-doc.base-rate
     2174     , input buf_trn-doc.base-scale
     2175     , input buf_trn-doc.exch-code
     2176     , input buf_trn-doc.vat-type
     2177     , input buf_prop_trn-doc.doc-code
     2178     , input no
     2179     , input buf_prop_trn-doc.discnt-pc
     2180     , input buf_prop_trn-doc.agnt
     2181     , input buf_prop_trn-doc.boss
     2182     , input buf_prop_trn-doc.wrkr
     2183     , input buf_prop_trn-doc.base-rate
     2184     , input buf_prop_trn-doc.base-scale
     2185     , input buf_sysconf.cash-pay
     2186     , input buf_sysconf.base-code
     2187     , input-output table tt0-one-doc-line
     2188     , input-output table tt0-one-gds-dtl
     2189     , input-output table tt0-one-parts
     2190     , input v-use-parts
     2191     , input v-all-qnty
     2192     , input v-fix-price
     2193     , input v-rsrv-fact-qnty
     2194     ) no-error.
     2195         for each tt0-one-doc-line,
     2196            first tt0-doc-line where
     2197                 tt0-doc-line.artic = tt0-one-doc-line.artic
     2198             and tt0-doc-line.prod-type = tt0-one-doc-line.prod-type
     2199             and tt0-doc-line.prod-code = tt0-one-doc-line.prod-code:
     2200            buffer-copy tt0-one-doc-line
     2201            except doc-qnty fact-qnty cli-qnty
     2202            to tt0-doc-line.
     2203            assign
     2204            tt0-doc-line.doc-qnty = tt0-doc-line.doc-qnty - tt0-gds-dtl.doc-qnty + tt0-one-doc-line.doc-qnty
     2205            tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty - tt0-gds-dtl.fact-qnty + tt0-one-doc-line.doc-qnty
     2206            .
     2207         end.
     2208         for each tt0-one-gds-dtl,
     2209            first tt0-gds-dtl where
     2210                 tt0-gds-dtl.artic = tt0-one-gds-dtl.artic
     2211             and tt0-gds-dtl.prod-type = tt0-one-gds-dtl.prod-type
     2212             and tt0-gds-dtl.prt-code = tt0-one-gds-dtl.prt-code:
     2213           buffer-copy
     2214           tt0-one-gds-dtl using doc-qnty fact-qnty
     2215           to tt0-gds-dtl.
     2216         end.
     2217       end.
     2218       if error-status:error then do:
     2219         for each tt0-info no-lock where
     2220                 tt0-info.doc-code = '':U,
     2221             first buf_tt0-doc-line  where
     2222                   buf_tt0-doc-line.doc-code = sale-doc.doc-code
     2223               and buf_tt0-doc-line.artic = tt0-info.artic
     2224               and buf_tt0-doc-line.prod-type = tt0-info.prod-type
     2225               and buf_tt0-doc-line.prod-code = tt0-info.prod-code
     2226         break
     2227         by tt0-info.artic
     2228         by tt0-info.prod-type
     2229         by tt0-info.prod-code:
     2230           if first-of (tt0-info.prod-code) then do:
     2231             if p-artic <> ""
     2232             and not (tt0-info.artic = p-artic
     2233                 and tt0-info.prod-type = p-prod-type
     2234                 and tt0-info.prod-code = p-prod-code )
     2235             then next.
     2236             assign
     2237             buf_tt0-doc-line.doc-code = ''.
     2238           end.
     2239         end.
     2240         for each tt0-info where
     2241                 tt0-info.doc-code = '':U,
     2242             first tt0-gds-dtl  where
     2243                   tt0-gds-dtl.doc-code = sale-doc.doc-code
     2244               and tt0-gds-dtl.artic = tt0-info.artic
     2245               and tt0-gds-dtl.prod-type = tt0-info.prod-type
     2246               and tt0-gds-dtl.prod-code = tt0-info.prod-code
     2247               and tt0-gds-dtl.prt-code  = tt0-info.prt-code
     2248         break
     2249         by tt0-info.artic
     2250         by tt0-info.prod-type
     2251         by tt0-info.prod-code:
     2252           if p-artic = ""
     2253           or (tt0-gds-dtl.artic = p-artic
     2254               and tt0-gds-dtl.prod-type = p-prod-type
     2255               and tt0-gds-dtl.prod-code = p-prod-code
     2256               and tt0-gds-dtl.prt-code = p-prt-code ) then do:
     2257             assign
     2258             tt0-gds-dtl.doc-code = ''
     2259             tt0-info.error-message =  substitute("Ошибка при копировании линий в документ перемещения ЧУЖИХ товаров с &1&2:&3&4&5"
     2260                                         , sale-doc.obj-type
     2261                                         , sale-doc.obj-code
     2262                                         , chr(10)
     2263                                         , error-status:get-message(1)
     2264                                         , return-value)
     2265             .
     2266           end.
     2267         end.
     2268         if p-artic <> "":U then
     2269         undo _tpsi-doc, return error substitute("Ошибка при копировании линий в документ перемещения ЧУЖИХ товаров с &1&2:&3&4&5"
     2270                                       , sale-doc.obj-type
     2271                                       , sale-doc.obj-code
     2272                                       , chr(10)
     2273                                       , error-status:get-message(1)
     2274                                       , return-value
     2275                                       ).
     2276         else do:
     2277           undo _tpsi-doc, NEXT _tpsi-doc.
     2278         end.
     2279       end.
     2280       assign
     2281       buf_prop_trn-doc.status_ = 'нередакт':U
     2282       buf_prop_trn-doc.flag_  = no
     2283       .
     2284       case sale-doc.alias-type-price :
     2285         when '1':U  then do:
     2286           for each buf_doc-line no-lock where
     2287                   buf_doc-line.doc-code = buf_prop_trn-doc.doc-code,
     2288               each buf_gds-dtl WHERE
     2289                   buf_gds-dtl.doc-code = buf_prop_trn-doc.doc-code
     2290               AND buf_gds-dtl.doc-code = buf_prop_trn-doc.doc-code:
     2291           if p-artic <> '':u
     2292           and not (buf_gds-dtl.artic = p-artic
     2293               and buf_gds-dtl.prod-type = p-prod-type
     2294               and buf_gds-dtl.prod-code = p-prod-code
     2295               and buf_gds-dtl.prt-code = p-prt-code )
     2296           then next.
     2297           assign
     2298           buf_gds-dtl.price-base       = buf_doc-line.price-base
     2299           buf_gds-dtl.price-rubl       = buf_doc-line.price-rubl
     2300           .
     2301           END.
     2302         end.
     2303         when '5':U then do:
     2304           for each buf_gds-dtl where
     2305                   buf_gds-dtl.doc-code = buf_prop_trn-doc.doc-code,
     2306               first bufi_gds-dtl WHERE
     2307                   bufi_gds-dtl.doc-code = buf_trn-doc.doc-code
     2308               AND bufi_gds-dtl.artic = buf_gds-dtl.artic
     2309               AND bufi_gds-dtl.prod-type = buf_gds-dtl.prod-type
     2310               AND bufi_gds-dtl.prod-code = buf_gds-dtl.prod-code
     2311               AND bufi_gds-dtl.prt-code = buf_gds-dtl.prt-code :
     2312             if p-artic <> '':u
     2313             and not (buf_gds-dtl.artic = p-artic
     2314                 and buf_gds-dtl.prod-type = p-prod-type
     2315                 and buf_gds-dtl.prod-code = p-prod-code
     2316                 and buf_gds-dtl.prt-code = p-prt-code )
     2317             then next.
     2318             assign
     2319             buf_gds-dtl.price-base  = bufi_gds-dtl.price-base
     2320             buf_gds-dtl.price-rubl  = bufi_gds-dtl.price-rubl
     2321             buf_gds-dtl.discnt-base = bufi_gds-dtl.discnt-base
     2322             buf_gds-dtl.discnt-rubl = bufi_gds-dtl.discnt-rubl
     2323             buf_gds-dtl.discnt-type = no
     2324             buf_gds-dtl.discnt-pc   = buf_gds-dtl.discnt-rubl * 100 / buf_gds-dtl.price-rubl
     2325             .
     2326           END.
     2327         end.
     2328       END CASE.
     2329       run gbl/calc-trn.p (input parparentproc, input recid(buf_prop_trn-doc)) no-error .
     2330       if error-status:error then do:
     2331         undo _tpsi-doc, return error substitute("Ошибка при расчете шапки документа перемещения ЧУЖИХ товаров с &1&2:&3&4&5"
     2332                                       , sale-doc.obj-type
     2333                                       , sale-doc.obj-code
     2334                                       , chr(10)
     2335                                       , error-status:get-message(1)
     2336                                       , return-value
     2337                                       ).
     2338       end.
     2339     end.
     2340     prev-doc-code = '':U.
     2341     for each  sale-doc where
     2342             sale-doc.inkas-code = p-inkas-code:
     2343       assign
     2344       sale-doc.tot-dtl = 0
     2345       .
     2346       for each tt0-gds-dtl no-lock where
     2347           tt0-gds-dtl.doc-code = sale-doc.doc-code:
     2348         sale-doc.tot-dtl = sale-doc.tot-dtl + 1.
     2349         if tt0-gds-dtl.fact-qnty = 0 then do:
     2350           find first tt0-info where
     2351               tt0-info.artic = tt0-gds-dtl.artic
     2352           and tt0-info.prod-type = tt0-gds-dtl.prod-type
     2353           and tt0-info.prod-code = tt0-gds-dtl.prod-code
     2354           and tt0-info.prt-code = tt0-gds-dtl.prt-code no-error .
     2355         end.
     2356         else do:
     2357           if available tt0-info then release tt0-info.
     2358         end.
     2359         if tt0-gds-dtl.fact-qnty = 0
     2360         and (available tt0-info and tt0-info.o-was-res <> tt0-gds-dtl.doc-qnty)
     2361         then do:
     2362           if p-artic = "":U
     2363           or (tt0-gds-dtl.artic = p-artic
     2364             and
     2365             tt0-gds-dtl.prod-type = p-prod-type
     2366             AND
     2367             tt0-gds-dtl.prod-code = p-prod-code
     2368             AND
     2369             tt0-gds-dtl.prt-code = p-prt-code
     2370             )
     2371           then
     2372           assign
     2373           p-num_rec_other_res = p-num_rec_other_res + 1
     2374           p-num_rec_res = p-num_rec_res + 1
     2375           .
     2376         end.
     2377       end.
     2378       find first buf_prop_trn-doc where
     2379              buf_prop_trn-doc.doc-code = sale-doc.doc-code.
     2380       find first prev_sale-doc where prev_sale-doc.doc-code = sale-doc.doc-code.
     2381       assign
     2382       buf_prop_trn-doc.ps = set-tpsi-doc-ps(buffer prev_sale-doc)
     2383       prev_sale-doc.ps = buf_prop_trn-doc.ps
     2384       .
     2385     end.
     2386     if p-auto = 0 then
     2387     run waitfram-hide in this-procedure .
     2388     else
     2389     run hide-counter in p-log-handle.
     2390   end.
     2391   procedure get-purch-contract :
     2392   define input parameter p-host-code              like ub.sysconf.host-code no-undo .
     2393   define input parameter p-contract-code          like ub.contract.contract-code no-undo .
     2394   define output parameter p-purch-code            like ub.trn-doc.purch-code no-undo .
     2395   define output parameter p-purch-name            as character no-undo .
     2396   define buffer bf_contract for ub.contract.
     2397   do on error undo, return error return-value :
     2398     find first bf_contract where bf_contract.host-code     = p-host-code     and
     2399                                  bf_contract.contract-code = p-contract-code no-lock.
     2400     if lookup (bf_contract.contract-type, 'Купли-продажи,Агентский договор,Давальческого сырья,Продажи через ТПСИ':U) > 0 then do:
     2401           assign
     2402         p-purch-name = entry (lookup ('1':U, '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U).
     2403     end.
     2404     else do:
     2405       if lookup (bf_contract.contract-type, 'Консигнации':U) > 0 then do:
     2406               assign
     2407           p-purch-name = entry (lookup ('2':U, '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U).
     2408       end.
     2409       else do:
     2410         if lookup (bf_contract.contract-type, 'Ответственного хранения':U) > 0 then do:
     2411                   assign
     2412             p-purch-name = entry (lookup ('3':U, '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U).
     2413         end.
     2414         else do:
     2415           return error substitute("Нельзя определить по договору &1 (фирма &2) с типом &3 тип приобретения"
     2416                                   , bf_contract.contract-prn-code
     2417                                   , p-host-code
     2418                                   , bf_contract.contract-type ).
     2419         end.
     2420       end.
     2421     end.
     2422     assign
     2423     p-purch-code = lookup (p-purch-name, 'выкуп,консигнация,ответственное хранение,старая консигнация':U).
     2424   end.
     2425   end procedure.
