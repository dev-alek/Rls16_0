        1   block-level on error undo, throw.
        2   define input parameter parparentproc as   handle              no-undo.
        3   define input parameter parrvs-code   like ub.rvs-doc.rvs-code no-undo.
        4   define new global shared variable g#language as character no-undo .
        5   if g#language <> '' and g#language <> 'rus':U then do:
        6     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        7   end.
        8   define variable rvs-rec as recid no-undo.
        9   define buffer bf_rvs-doc for ub.rvs-doc.
       10   do on error undo, return error substitute( "&1 &2", return-value, error-status :get-message( 1 ) ) :
       11     find first bf_rvs-doc no-lock where
       12                bf_rvs-doc.rvs-code = parrvs-code no-error.
       13     if not available bf_rvs-doc then do:
       14       return error substitute( 'Не найдена сверка с номером "&1".', bf_rvs-doc.rvs-code ).
       15     end.
       16     run str/rvs-doc.w ( input        parparentproc
       17                   , input        'ПРОСМОТР':U
       18                   , input        bf_rvs-doc.rvs-type
       19                   , input        yes
       20                   , input-output rvs-rec ).
       21   end.
