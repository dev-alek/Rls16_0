      664   procedure get-last-check-date-time :
      665       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      666       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      667       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      668       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      669       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      670       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      671       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      672       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      673       define variable v-character as character no-undo .
      674       define variable v-date      as date      no-undo .
      675       define variable v-decimal   as decimal   no-undo .
      676       define variable v-integer   as integer   no-undo .
      677       define variable v-logical   as logical   no-undo .
      678       define variable v-attr-type as character no-undo .
      679       define buffer buf_chk-doc     for ub.chk-doc.
      680       define buffer buf_c-cash-desk for ub.c-cash-desk.
      681       do
      682           on error undo, return error
      683           :
      684           run cd-attr-value in this-procedure (
      685               input g#db-num
      686               ,input p-obj-code
      687               ,input p-pos-type
      688               ,input p-cash-num
      689               ,input 'MAGIA-XML_operative':U
      690               ,input 'last-check-date-time':U
      691               ,output v-character
      692               ,output v-date
      693               ,output v-decimal
      694               ,output v-integer
      695               ,output v-logical
      696               ,output v-attr-type     ) no-error.
      697           if v-character = "":U
      698               or v-character = ?
      699               then
      700           do:
      701               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      702                   buf_c-cash-desk.db-num = g#db-num
      703                   AND buf_c-cash-desk.pos-type = p-pos-type
      704                   AND buf_c-cash-desk.cash-num = p-cash-num
      705                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      706                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      707               if available buf_c-cash-desk then
      708               do:
      709                   assign
      710                       p-date = buf_c-cash-desk.corr-date
      711                       p-time = buf_c-cash-desk.corr-time
      712                       .
      713               end.
      714               else
      715               do:
      716                   find first buf_chk-doc no-lock where
      717                       buf_chk-doc.obj-type = 'маг':U
      718                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      719                   if not available buf_chk-doc then
      720                   do:
      721                       return error.
      722                   end.
      723                   assign
      724                       p-date = buf_chk-doc.chk-date - 1
      725                       p-time = buf_chk-doc.chk-time
      726                       .
      727               end.
      728           end.
      729           else
      730           do:
      731               assign
      732                   p-date = cd-attr-parse-date-time( v-character, output p-time )
      733           no-error .
      734               if error-status:error then return error .
      735           end.
      736       end.
      737   end procedure.
      738   procedure get-last-check-params :
      739       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      740       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      741       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      742       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      743       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      744       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      745       define output parameter p-shift-num like ub.chk-doc.shift-num no-undo init 0.
      746       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      747       define output parameter p-chk-num like ub.chk-doc.chk-num no-undo init 0.
      748       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      749       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      750       define variable v-character as character no-undo .
      751       define variable v-date      as date      no-undo .
      752       define variable v-decimal   as decimal   no-undo .
      753       define variable v-integer   as integer   no-undo .
      754       define variable v-logical   as logical   no-undo .
      755       define variable v-attr-type as character no-undo .
      756       define buffer buf_chk-doc     for ub.chk-doc.
      757       define buffer buf_c-cash-desk for ub.c-cash-desk.
      758       do
      759           on error undo, return error
      760           :
      761           run cd-attr-value in this-procedure (
      762               input g#db-num
      763               ,input p-obj-code
      764               ,input p-pos-type
      765               ,input p-cash-num
      766               ,input if p-pos-type eq 'IBM-XML':U
      767               then 'IBM-XML_operative':U
      768               else 'AUTOTANK_operative':U
      769               ,input if p-pos-type = 'IBM-XML':U
      770               then 'last-check-params':U
      771               else 'last-check-params':U
      772               ,output v-character
      773               ,output v-date
      774               ,output v-decimal
      775               ,output v-integer
      776               ,output v-logical
      777               ,output v-attr-type     ) no-error.
      778           if v-character = "":U
      779               or v-character = ?
      780               then
      781           do:
      782               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      783                   buf_c-cash-desk.db-num = g#db-num
      784                   AND buf_c-cash-desk.pos-type = p-pos-type
      785                   AND buf_c-cash-desk.cash-num = p-cash-num
      786                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      787                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      788               if available buf_c-cash-desk then
      789               do:
      790                   assign
      791                       p-date = buf_c-cash-desk.corr-date
      792                       p-time = buf_c-cash-desk.corr-time
      793                       .
      794               end.
      795               else
      796               do:
      797                   find first buf_chk-doc no-lock where
      798                       buf_chk-doc.obj-type = 'маг':U
      799                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      800                   if not available buf_chk-doc then
      801                   do:
      802                       return error.
      803                   end.
      804                   assign
      805                       p-date      = buf_chk-doc.chk-date - 1
      806                       p-time      = buf_chk-doc.chk-time
      807                       p-shift-num = buf_chk-doc.shift-num
      808                       p-z-count   = buf_chk-doc.z-number
      809                       p-chk-num   = buf_chk-doc.chk-num
      810                       .
      811               end.
      812           end.
      813           else
      814           do:
      815               assign
      816                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      817                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      818                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      819                   p-z-count   = integer(entry(4, v-character, chr(32) ))
      820                   p-z-count   = (if p-z-count = ? then 0 else p-z-count)
      821                   p-chk-num   = integer(entry(5, v-character, chr(32) ))
      822           no-error .
      823               if error-status:error then return error .
      824           end.
      825       end.
      826   end procedure.
      827   procedure get-last-report-params :
      828       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      829       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      830       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      831       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      832       define output parameter p-date like ub.chk-slip-head.slip-dt no-undo .
      833       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      834       define output parameter p-shift-num like ub.chk-slip-head.CashShiftNum no-undo init 0.
      835       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      836       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      837       define variable v-character as character no-undo .
      838       define variable v-date      as date      no-undo .
      839       define variable v-decimal   as decimal   no-undo .
      840       define variable v-integer   as integer   no-undo .
      841       define variable v-logical   as logical   no-undo .
      842       define variable v-date1     as character no-undo .
      843       define variable v-date2     as character no-undo .
      844       define variable v-attr-type as character no-undo .
      845       define buffer buf_chk-slip-head for ub.chk-slip-head.
      846       define buffer buf_c-cash-desk   for ub.c-cash-desk.
      847       do
      848           on error undo, return error
      849           :
      850           run cd-attr-value in this-procedure (
      851               input g#db-num
      852               ,input p-obj-code
      853               ,input p-pos-type
      854               ,input p-cash-num
      855               ,input if p-pos-type eq 'IBM-XML':U
      856               then 'IBM-XML_operative':U
      857               else 'AUTOTANK_operative':U
      858               ,input if p-pos-type = 'IBM-XML':U
      859               then 'last-report-params':U
      860               else 'last-report-params':U
      861               ,output v-character
      862               ,output v-date
      863               ,output v-decimal
      864               ,output v-integer
      865               ,output v-logical
      866               ,output v-attr-type     ) no-error.
      867           if v-character = "":U
      868               or v-character = ?
      869               then
      870           do:
      871               find last buf_chk-slip-head no-lock where
      872                   buf_chk-slip-head.obj-code = p-obj-code
      873                   and buf_chk-slip-head.cash-num = p-cash-num
      874                   and buf_chk-slip-head.db-num = p-db-num
      875                   and buf_chk-slip-head.is-report = 1 no-error.
      876               if not available buf_chk-slip-head then
      877               do:
      878                   return error.
      879               end.
      880               v-date2 = entry(2,string(buf_chk-slip-head.slip-dt)," ") .
      881               v-date1 = string(substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 7, 4 )) + "-" +
      882                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 4, 2 ) ) + "-" +
      883                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 1, 2 ) )
      884                   + " " + entry(1,v-date2,".") .
      885               assign
      886                   p-date      = cd-attr-parse-date-time( string(v-date1), output p-time )
      887                   p-shift-num = buf_chk-slip-head.CashShiftNum
      888                   .
      889           end.
      890           else
      891           do:
      892               assign
      893                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      894                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      895                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      896           no-error .
      897               if error-status:error then return error .
      898           end.
      899       end.
      900   end procedure.
      901   procedure get-last-check-maria :
      902       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      903       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      904       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      905       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      906       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      907       define output parameter p-num-recs as integer no-undo .
      908       define output parameter p-p-date like ub.chk-doc.chk-date no-undo .
      909       define output parameter p-p-z-count like ub.chk-doc.z-number no-undo init 0.
      910       define output parameter p-p-num-recs as integer no-undo .
      911       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      912       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      913       define variable v-character as character no-undo .
      914       define variable v-date      as date      no-undo .
      915       define variable v-decimal   as decimal   no-undo .
      916       define variable v-integer   as integer   no-undo .
      917       define variable v-logical   as logical   no-undo .
      918       define variable v-attr-type as character no-undo .
      919       define buffer buf_chk-doc     for ub.chk-doc.
      920       define buffer buf_c-cash-desk for ub.c-cash-desk.
      921       do
      922           on error undo, return error
      923           :
      924           run cd-attr-value in this-procedure (
      925               input p-db-num
      926               ,input p-obj-code
      927               ,input 'MARIA':U
      928               ,input p-cash-num
      929               ,input 'MARIA_operative':U
      930               ,input 'last-check-maria':U
      931               ,output v-character
      932               ,output v-date
      933               ,output v-decimal
      934               ,output v-integer
      935               ,output v-logical
      936               ,output v-attr-type     ) no-error.
      937           if v-character = "":U
      938               or v-character = ?
      939               then
      940           do:
      941               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      942                   buf_c-cash-desk.db-num = p-db-num
      943                   AND buf_c-cash-desk.pos-type = 'MARIA':U
      944                   AND buf_c-cash-desk.cash-num = p-cash-num
      945                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      946                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      947               if available buf_c-cash-desk then
      948               do:
      949                   assign
      950                       p-date   = buf_c-cash-desk.corr-date
      951                       p-p-date = buf_c-cash-desk.corr-date
      952                       .
      953               end.
      954               else
      955               do:
      956                   find first buf_chk-doc no-lock where
      957                       buf_chk-doc.obj-type = 'маг':U
      958                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      959                   if not available buf_chk-doc then
      960                   do:
      961                       assign
      962                           p-date       = 01/01/1990
      963                           p-z-count    = 1
      964                           p-num-recs   = 0
      965                           p-p-date     = 01/01/1990
      966                           p-p-z-count  = 1
      967                           p-p-num-recs = 0
      968                           .
      969                   end.
      970                   assign
      971                       p-date       = buf_chk-doc.chk-date - 1
      972                       p-z-count    = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      973                       p-num-recs   = 0
      974                       p-p-date     = buf_chk-doc.chk-date - 1
      975                       p-p-z-count  = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      976                       p-p-num-recs = 0
      977                       .
      978               end.
      979           end.
      980           else
      981           do:
      982               assign
      983                   p-date       = date( integer(entry(2, entry(1, v-character, chr(32)), '-':U))
      984                         ,integer(entry(3, entry(1, v-character, chr(32)), '-':U))
      985                         ,integer(entry(1, entry(1, v-character, chr(32)), '-':U))
      986                         )
      987                   p-z-count    = integer(entry(2, v-character, chr(32) ))
      988                   p-z-count    = (if p-z-count = ? then 0 else p-z-count)
      989                   p-num-recs   = integer(entry(3, v-character, chr(32) ))
      990                   p-num-recs   = (if p-num-recs = ? then 0 else p-num-recs)
      991                   p-p-date     = date( integer(entry(2, entry(4, v-character, chr(32)), '-':U))
      992                         ,integer(entry(3, entry(4, v-character, chr(32)), '-':U))
      993                         ,integer(entry(1, entry(4, v-character, chr(32)), '-':U))
      994                         )
      995                   p-p-z-count  = integer(entry(5, v-character, chr(32) ))
      996                   p-p-z-count  = (if p-z-count = ? then 0 else p-z-count)
      997                   p-p-num-recs = integer(entry(6, v-character, chr(32) ))
      998                   p-p-num-recs = (if p-p-num-recs = ? then 0 else p-p-num-recs)
      999           no-error .
     1000               if error-status:error then return error .
     1001           end.
     1002       end.
     1003   end procedure.
     1004   define variable vss-revision3    as character no-undo init "$Revision:$":U .
     1005   define variable vss-author3      as character no-undo init "$Author:$":U .
     1006   define variable vss-date3        as character no-undo init "$Date:$":U .
     1007   define variable vss-workfile3    as character no-undo init "$Workfile:$":U .
     1008   define variable vss-archive3     as character no-undo init "$Archive:$":U .
     1009   define variable vss-description3 as character no-undo init "Работа С сокетом".
     1010   procedure PutMesAsunc:
     1011       define input  parameter Itext as character no-undo.
     1012       define variable vflag as logical no-undo.
     1013       Publish "WriteLogAsunc" (Itext, yes)  .
