        1   block-level on error undo, throw.
        2   define input  parameter parparentproc   as widget-handle         no-undo.
        3   define input  parameter p-parent-handle as widget-handle         no-undo.
        4   define input  parameter p-log-handle    as handle                no-undo.
        5   define input  parameter p-log-file-name as character             no-undo.
        6   define input  parameter p-obj-type      like ub.clients.obj-type no-undo.
        7   define input  parameter p-obj-code      like ub.clients.obj-code no-undo.
        8   define output parameter p-ok            as logical               no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision: 1eba0946c2d7, 3078, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
       11   define variable vss-date        as character no-undo init "$Date: Пт авг 05 19:16:25 2022 +0300 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: get-tran-fuel.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: str/get-tran-fuel.p $":U .
       14   define variable vss-description as character no-undo init "Обмен данными с кассой по топливным транзакциям".
       15   define new global shared variable g#language as character no-undo .
       16   if g#language <> '' and g#language <> 'rus':U then do:
       17     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       18   end.
       19   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       20   PROCEDURE verify-ini-entry:
       21   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
       22   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
       23   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
       24   DEFINE INPUT  PARAMETER silence          as logical no-undo.
       25   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
       26   define variable v-mess as character no-undo .
       27   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
       28   if ini-entry-value = ? and ini-key-name begins "spl"
       29   then
       30   get-key-value section ini-section-name key "splall" value ini-entry-value.
       31   if ini-entry-value = ? and ini-key-name begins "sav"
       32   then
       33   get-key-value section ini-section-name key "savall" value ini-entry-value.
       34   if ini-entry-value = ? then do:
       35     assign
       36     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
       37                       , chr(10)
       38                       , ini-section-name
       39                       , ini-key-name
       40                       , error-msg-text).
       41       if not silence then do:
       42         message
       43         v-mess
       44         view-as alert-box ERROR  .
       45         return error.
       46       end.
       47       else do:
       48         return error v-mess.
       49       end.
       50   end.
       51   END PROCEDURE.
       52   PROCEDURE verify-file:
       53   DEFINE INPUT  PARAMETER filename       as character no-undo.
       54   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
       55   DEFINE INPUT  PARAMETER silence        as logical no-undo.
       56   DEFINE OUTPUT PARAMETER found          as logical no-undo.
       57   file-info:file-name = filename.
       58   found = NOT (file-info:full-pathname = ?).
       59   if NOT found  then do:
       60     if not silence then do:
       61       message error-msg-text
       62       view-as alert-box ERROR.
       63       return error.
       64     end.
       65     else return error error-msg-text.
       66   end.
       67   END PROCEDURE.
