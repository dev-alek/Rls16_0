        1   DEFINE TEMP-TABLE tt-fin-doc NO-UNDO LIKE ub.fin-doc.
        2   DEFINE TEMP-TABLE tt0-fin-doc-attr NO-UNDO LIKE ub.fin-doc-attr.
        3   DEFINE TEMP-TABLE tt0-fin-doc-tax NO-UNDO LIKE ub.fin-doc-tax
        4          INDEX pi1 vat-pc slt-pc with-vat with-slt
        5          .
        6   DEFINE TEMP-TABLE tt0-payment NO-UNDO LIKE ub.payment.
        7     DEFINE temp-table temp-fin-ob no-undo
        8       field   ri             as  recid
        9       field   ind            as integer
       10       field   del            as logical
       11       INDEX pi  IS PRIMARY   ind
       12       INDEX pi1  ri
       13       INDEX pi2  del
       14     .
       15     define input  parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       16     define input  parameter p-host-code    as integer   no-undo .
       17     define input  parameter table for temp-fin-ob.
       18     define output parameter p-ri as recid no-undo .
       19   define variable vss-revision    as character no-undo init "$Revision$":u .
       20   define variable vss-author      as character no-undo init "$Author$":u .
       21   define variable vss-date        as character no-undo init "$Date$":u .
       22   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       23   define variable vss-archive     as character no-undo init "$Archive$":u .
       24   define variable vss-description as character no-undo init "Автомат. оплата фин. обязательств" .
       25   procedure vss-get-info :
       26     define output parameter p-vss-revision    like vss-revision    no-undo .
       27     define output parameter p-vss-author      like vss-author      no-undo .
       28     define output parameter p-vss-date        like vss-date        no-undo .
       29     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       30     define output parameter p-vss-archive     like vss-archive     no-undo .
       31     define output parameter p-vss-description like vss-description no-undo .
       32     assign
       33       p-vss-revision    = vss-revision
       34       p-vss-author      = vss-author
       35       p-vss-date        = vss-date
       36       p-vss-workfile    = vss-workfile
       37       p-vss-archive     = vss-archive
       38       p-vss-description = vss-description
       39     .
       40   end procedure.
       41   procedure vss-get-parameters :
       42     define output parameter p-vss-parameters as character no-undo .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define new global shared variable g#language as character no-undo .
      125   if g#language <> '' and g#language <> 'rus':U then do:
      126     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      127   end.
      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   define new global shared variable g#library  as handle no-undo .
      130   define new global shared variable g#library2 as handle no-undo .
      131   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   procedure gen-b-code :
      133     define input  parameter type-code like ub.code-range.range-type no-undo .
      134     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      135     do
      136     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      137     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      138     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      139     :
      140       define buffer buf_thbj-attr     for ub.thbj-attr .
      141       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      142       define buffer buf_code-range for ub.code-range .
      143       define variable l-code         as   integer              no-undo .
      144       define variable v-db-num       like ub.db.db-num         no-undo .
      145       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      146       if type-code = 'sslc':U
      147       or type-code = 'ssgb':U
      148       then do:
      149         message
      150           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      151           "Обратитесь к администратору системы."
      152           view-as alert-box error .
      153         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      154       end.
      155       run trg/getpcode.p ( input  type-code
      156                      ,output cfg-param-code
      157                     ).
      158       run get-next-seq( input  type-code,
      159                         output l-code
      160                       ).
      161       find first buf_sys-ctrl no-lock.
      162       if type-code = 'sclc':U
      163       or type-code = 'pglc':U
      164       then do:
      165         assign
      166           v-db-num = 0
      167         .
      168       end.
      169       else do:
      170         assign
      171           v-db-num = buf_sys-ctrl.db-num
      172         .
      173       end.
      174       find first buf_code-range no-lock
      175         where buf_code-range.db-num     = v-db-num
      176           and buf_code-range.range-type = type-code
      177           and buf_code-range.stts       = "a"
      178         use-index stts
      179         no-error .
      180       if available buf_code-range
      181          and l-code <= buf_code-range.last-code
      182          and l-code >= buf_code-range.first-code then do:
      183         assign
      184           p-b-code = l-code
      185         .
      186       end.
      187       else do:
      188         if available buf_code-range
      189            and l-code < buf_code-range.last-code then do:
      190           message
      191             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      192             "Обратитесь к администратору системы."
      193             view-as alert-box error .
      194           undo, return error "sequence":U .
      195         end.
      196         do transaction
      197         on error undo, return error
      198         :
      199           find first buf_thbj-attr exclusive-lock
      200             where buf_thbj-attr.upper-prop-code = 'code-range':U
      201               and buf_thbj-attr.prop-code = cfg-param-code
      202               and buf_thbj-attr.obj-type   = 'БД':U
      203               and buf_thbj-attr.obj-code   = v-db-num
      204             no-error .
      205           if not available buf_thbj-attr then do:
      206             find first buf_thbj-attr exclusive-lock
      207               where buf_thbj-attr.upper-prop-code = 'code-range':U
      208                 and buf_thbj-attr.prop-code = cfg-param-code
      209                 and buf_thbj-attr.obj-type   = ''
      210                 and buf_thbj-attr.obj-code   = 0
      211               no-error .
      212             if not available buf_thbj-attr then do:
      213               if not locked buf_thbj-attr then do:
      214                 message
      215                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      216                   "Обратитесь к администратору системы."
      217                   view-as alert-box error .
      218               end.
      219               undo, return error "config":U .
      220             end.
      221           end.
      222           run get-next-seq( input type-code,
      223                             output l-code
      224                           ).
      225           find first buf_code-range
      226             where buf_code-range.db-num     = v-db-num
      227               and buf_code-range.range-type = type-code
      228               and buf_code-range.stts       = "a"
      229             use-index stts
      230             no-error .
      231           if available buf_code-range
      232           and l-code <= buf_code-range.last-code
      233           and l-code >= buf_code-range.first-code
      234           then do:
      235             assign
      236               p-b-code = l-code
      237             .
      238           end.
      239           else do:
      240             if available buf_code-range then do:
      241               assign
      242                 buf_code-range.stts = "u"
      243               .
      244             end.
      245             find first buf_code-range
      246               where buf_code-range.db-num     = v-db-num
      247                 and buf_code-range.range-type = type-code
      248                 and buf_code-range.stts       = "f"
      249               use-index stts
      250               no-error .
      251             if not available buf_code-range then do:
      252               message
      253                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      254                 "Обратитесь к администратору системы"
      255                 view-as alert-box error .
      256               undo, return error "code-range":U .
      257             end.
      258             assign
      259               buf_code-range.stts           = "a"
      260             .
      261             if buf_code-range.first-code = 1 then do:
      262               run set-seq-cr( input type-code,
      263                               input buf_code-range.first-code
      264                             ).
      265               assign
      266                 p-b-code = 1
      267               .
      268             end.
      269             else do:
      270               run set-seq-cr( input type-code,
      271                               input ( buf_code-range.first-code - 1 )
      272                             ).
      273               run get-next-seq( input type-code,
      274                                 output p-b-code
      275                               ).
      276             end.
      277           end.
      278         end.
      279       end.
      280     end.
      281   end procedure.
      282   procedure get-next-seq :
      283     define input  parameter type-code like ub.code-range.range-type no-undo .
      284     define output parameter next-seq  as   integer                  no-undo .
      285     do
      286     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      287     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      288     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      289     :
      290       case type-code:
      291         when 'bcgb':U then do:
      292           assign
      293             next-seq = next-value(s-bcgb-code, ub)
      294           .
      295         end.
      296         when 'scgb':U then do:
      297           assign
      298             next-seq = next-value(s-scgb-code, ub)
      299           .
      300         end.
      301         when 'sclc':U then do:
      302           assign
      303             next-seq = next-value(s-sclc-code, ub)
      304           .
      305         end.
      306         when 'pglc':U then do:
      307           assign
      308             next-seq = next-value(s-pglc-code, ub)
      309           .
      310         end.
      311         when 'dcgb':U then do:
      312           assign
      313             next-seq = next-value(s-dcgb-code, ub)
      314           .
      315         end.
      316         when 'ctgb':U then do:
      317           assign
      318             next-seq = next-value(s-ctgb-code, ub)
      319           .
      320         end.
      321         when 'drgb':U then do:
      322           assign
      323             next-seq = next-value(s-drgb-code, ub)
      324           .
      325         end.
      326         when 'fmgb':U then do:
      327           assign
      328             next-seq = next-value(s-fmgb-code, ub)
      329           .
      330         end.
      331         when 'pngb':U then do:
      332           assign
      333             next-seq = next-value(s-pngb-code, ub)
      334           .
      335         end.
      336         when 'cagb':U then do:
      337           assign
      338             next-seq = next-value(s-cagb-code, ub)
      339           .
      340         end.
      341         when 'fdgb':U then do:
      342           assign
      343             next-seq = next-value(s-fin-doc, ub)
      344           .
      345         end.
      346       end case.
      347     end.
      348   end procedure.
      349   procedure set-seq-cr :
      350     define input parameter type-code like ub.code-range.range-type no-undo .
      351     define input parameter set-val   like ub.code-range.first-code no-undo .
      352     do
      353     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      354     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      355     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      356     :
      357       case type-code:
      358         when 'bcgb':U then do:
      359           assign
      360             current-value(s-bcgb-code, ub) = set-val
      361           .
      362         end.
      363         when 'scgb':U then do:
      364           assign
      365             current-value(s-scgb-code, ub) = set-val
      366           .
      367         end.
      368         when 'sclc':U then do:
      369           assign
      370             current-value(s-sclc-code, ub) = set-val
      371           .
      372         end.
      373         when 'pglc':U then do:
      374           assign
      375             current-value(s-pglc-code, ub) = set-val
      376           .
      377         end.
      378         when 'dcgb':U then do:
      379           assign
      380             current-value(s-dcgb-code, ub) = set-val
      381           .
      382         end.
      383         when 'ctgb':U then do:
      384           assign
      385             current-value(s-ctgb-code, ub) = set-val
      386           .
      387         end.
      388         when 'drgb':U then do:
      389           assign
      390             current-value(s-drgb-code, ub) = set-val
      391           .
      392         end.
      393         when 'fmgb':U then do:
      394           assign
      395             current-value(s-fmgb-code, ub) = set-val
      396           .
      397         end.
      398         when 'pngb':U then do:
      399           assign
      400             current-value(s-pngb-code, ub) = set-val
      401           .
      402         end.
      403         when 'cagb':U then do:
      404           assign
      405             current-value(s-cagb-code, ub) = set-val
      406           .
      407         end.
      408         when 'fdgb':U then do:
      409           assign
      410             current-value(s-fin-doc, ub) = set-val
      411           .
      412         end.
      413       end case.
      414     end.
      415   end procedure.
      416   procedure new-bcod-gen-code-range :
      417     do
      418     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      419     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      420     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      421     :
      422       define input parameter p-db-num  like ub.db.db-num             no-undo .
      423       define input parameter type-code like ub.code-range.range-type no-undo .
      424       define buffer buf_code-range      for ub.code-range .
      425       define buffer last_code-range     for ub.code-range .
      426       define buffer last-1_code-range   for ub.code-range .
      427       define buffer last-2_code-range   for ub.code-range .
      428       define buffer last-3_code-range   for ub.code-range .
      429       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      430       define variable conf-par       as character no-undo .
      431       define variable par-type       as character no-undo .
      432       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      433       define variable v-cre-cdrg as logical   no-undo .
      434       define variable v-cre-str  as character no-undo .
      435       define variable v-cr1      as integer no-undo .
      436       define variable v-cr2      as integer no-undo .
      437       define variable v-cr3      as integer no-undo .
      438       define variable v-cmax     as integer no-undo .
      439       find first buf_sys-ctrl no-lock .
      440       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      441         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      442                                       ,vss-workfile
      443                                       ,vss-revision
      444                                       ,vss-description
      445                                       ,chr(10)
      446                                       , p-db-num
      447                                      ).
      448       end.
      449       run trg/getpcode.p ( input  type-code
      450                      ,output cfg-param-code
      451                     ).
      452       for each buf_code-range
      453         where buf_code-range.db-num     = -1
      454           and buf_code-range.range-type = type-code
      455           and buf_code-range.stts       = "f"
      456       by buf_code-range.first-code
      457       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      458       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      459       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      460       :
      461         assign
      462           buf_code-range.db-num = p-db-num
      463         .
      464         return .
      465       end.
      466       assign
      467         v-cre-cdrg = TRUE
      468       .
      469       case type-code:
      470         when 'sclc':U
      471         or when 'scgb':U
      472         or when 'pglc':U
      473         then do:
      474           find last last-1_code-range no-lock
      475             where last-1_code-range.range-type = 'sclc':U
      476             no-error .
      477           if available last-1_code-range then do:
      478             v-cr1 = last-1_code-range.last-code.
      479           end.
      480           find last last-2_code-range no-lock
      481             where last-2_code-range.range-type = 'scgb':U
      482             no-error .
      483           if available last-2_code-range then do:
      484             v-cr2 = last-2_code-range.last-code.
      485             end.
      486           find last last-3_code-range no-lock
      487             where last-3_code-range.range-type = 'pglc':U
      488             no-error .
      489           if available last-3_code-range then do:
      490             v-cr3 = last-3_code-range.last-code.
      491           end.
      492           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      493           .
      494           if v-cmax = v-cr1  then do:
      495               find last last_code-range no-lock
      496                 where recid( last_code-range ) = recid( last-1_code-range )
      497                 .
      498             end.
      499           if v-cmax = v-cr2  then do:
      500               find last last_code-range no-lock
      501                 where recid( last_code-range ) = recid( last-2_code-range )
      502                 .
      503             end.
      504           if v-cmax = v-cr3  then do:
      505             find last last_code-range no-lock
      506               where recid( last_code-range ) = recid( last-3_code-range )
      507               .
      508           end.
      509           if last_code-range.last-code + 1 > 99999 then do:
      510             assign
      511               v-cre-cdrg = FALSE
      512             .
      513           end.
      514         end.
      515         when 'bcgb':U
      516         or when 'sslc':U
      517         or when 'ssgb':U
      518         then do:
      519           find last last-1_code-range no-lock
      520             where last-1_code-range.range-type = 'sslc':U
      521             no-error .
      522           if available last-1_code-range then do:
      523             v-cr1 = last-1_code-range.last-code.
      524           end.
      525           find last last-2_code-range no-lock
      526             where last-2_code-range.range-type = 'bcgb':U
      527             no-error .
      528           if available last-2_code-range then do:
      529             v-cr2 = last-2_code-range.last-code.
      530             end.
      531           find last last-3_code-range no-lock
      532             where last-3_code-range.range-type = 'ssgb':U
      533             no-error .
      534           if available last-3_code-range then do:
      535             v-cr3 = last-3_code-range.last-code.
      536           end.
      537           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      538           .
      539           if v-cmax = v-cr1  then do:
      540               find last last_code-range no-lock
      541                 where recid( last_code-range ) = recid( last-1_code-range )
      542                 .
      543             end.
      544           if v-cmax = v-cr2  then do:
      545               find last last_code-range no-lock
      546                 where recid( last_code-range ) = recid( last-2_code-range )
      547                 .
      548             end.
      549           if v-cmax = v-cr3  then do:
      550             find last last_code-range no-lock
      551               where recid( last_code-range ) = recid( last-3_code-range )
      552               .
      553           end.
      554         end.
      555         otherwise do:
      556           find last last_code-range no-lock
      557             where last_code-range.range-type = type-code
      558             no-error .
      559         end.
      560       end case.
      561       if not available last_code-range then do:
      562         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      563                                       ,vss-workfile
      564                                       ,vss-revision
      565                                       ,vss-description
      566                                       , chr(10)
      567                                       , type-code
      568                                      ) .
      569       end.
      570       define variable v-mes1 as character no-undo .
      571       define variable v-param-type1 as character no-undo .
      572       define variable v-value-character1 as INTEGER no-undo .
      573       define variable v-value-date1 as date no-undo .
      574       define variable v-value-decimal1 as decimal no-undo .
      575       define variable v-value-integer1 AS integer no-undo .
      576       define variable v-value-logical1 AS LOGICAL no-undo .
      577       define variable v-tth1 as handle no-undo .
      578       run adm/shattri.p (
      579           input "get":U
      580           ,input  'БД':U
      581           ,input  p-db-num
      582           ,input  'code-range':U
      583           ,input  cfg-param-code
      584           ,output v-value-character1
      585           ,output v-value-date1
      586           ,output v-value-decimal1
      587           ,output v-value-integer1
      588           ,output v-value-logical1
      589           ,output v-param-type1
      590           ,INPUT-OUTPUT table-handle v-tth1
      591           ) no-error .
      592       if error-status :error then do:
      593         delete object v-tth1.
      594         v-mes1 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      595                            , error-status:get-message(1)
      596                            , chr(10)
      597                            , return-value ).
      598         undo, return error v-mes1.
      599       end.
      600       delete object v-tth1.
      601       if v-cre-cdrg = TRUE then do:
      602         create buf_code-range .
      603         assign
      604           buf_code-range.db-num     = p-db-num
      605           buf_code-range.range-type = type-code
      606           buf_code-range.stts       = "f"
      607           buf_code-range.first-code = last_code-range.last-code + 1
      608           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer1)
      609           v-cre-str = "Свободный диапазон успешно создан"
      610         .
      611       end.
      612       else do:
      613         assign
      614           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      615                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      616         .
      617       end.
      618     end.
      619     return v-cre-str .
      620   end procedure.
      621   procedure gen-new-code-range-if-neces :
      622     define input parameter v-db-num           like ub.db.db-num             no-undo .
      623     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      624     define input parameter v-cur-code         as   integer                  no-undo .
      625     define input parameter v-g#news           as   logical                  no-undo .
      626     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      627     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      628     do
      629     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      630     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      631     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      632     :
      633       define variable l-code-range-exist as logical   no-undo init false .
      634       define variable v-db-for-send      as character no-undo .
      635       define buffer buf_code-range  for ub.code-range .
      636       define buffer buf1_code-range for ub.code-range .
      637       define buffer buf_db          for ub.db .
      638       find first buf_code-range
      639         where buf_code-range.range-type = v-range-type
      640           and buf_code-range.last-code >= v-cur-code
      641         use-index last-codei
      642         no-error .
      643       if
      644       (
      645          available buf_code-range
      646          and
      647         (buf_code-range.db-num = v-db-num
      648           and
      649         buf_code-range.first-code <= v-cur-code
      650         )
      651       or
      652         (
      653           v-range-type = 'drgb':U
      654           AND
      655           v-cur-code = 0
      656         )
      657      )
      658      then do:
      659         assign
      660           l-code-range-exist = true
      661         .
      662         if v-g#news
      663         and buf_code-range.stts = "f" then do:
      664           assign
      665             buf_code-range.stts = "u"
      666           .
      667         end.
      668       end.
      669       if not l-code-range-exist
      670          and v-g#news-source-db <> 0
      671       then do:
      672         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      673                                       ,vss-workfile
      674                                       ,vss-revision
      675                                       ,vss-description
      676                                       ,chr(10)
      677                                       ,v-db-num
      678                                       ,v-range-type
      679                                       ,v-cur-code
      680                                      ).
      681       end.
      682       if (not l-code-range-exist
      683           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      684          )
      685       and ( not can-find (first buf1_code-range no-lock
      686                           where buf1_code-range.db-num = v-db-num
      687                             and buf1_code-range.range-type = v-range-type
      688                             and buf1_code-range.stts = "f"
      689                          )
      690           )
      691       then do:
      692         if v-g#db-num = 0 then do:
      693           run new-bcod-gen-code-range in this-procedure
      694             (input v-db-num,
      695              input v-range-type
      696             ) no-error .
      697           if error-status :error then do:
      698             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      699                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      700                                           ,v-db-num
      701                                           ,v-range-type
      702                                           ,v-cur-code
      703                                           ,chr(10)
      704                                           ,error-status:get-message(1)
      705                                           ,return-value
      706                                          ).
      707           end.
      708         end.
      709         else do:
      710           if v-range-type = 'sclc':U
      711           or v-range-type = 'pglc':U
      712           then do:
      713             assign
      714               v-db-for-send = "":U
      715             .
      716             if v-g#db-num = 0 then do:
      717               for each buf_db no-lock
      718                 where buf_db.db-num > 0
      719                   and buf_db.db-num <> v-g#news-source-db
      720               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      721               :
      722                 assign
      723                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      724                 .
      725               end.
      726               assign
      727                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      728               .
      729             end.
      730             else do:
      731               if not v-g#news then do:
      732                 assign
      733                   v-db-for-send = "0":U
      734                 .
      735               end.
      736             end.
      737             run nws/cr-route.p ( input 'send-cmd':U
      738                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      739                                  "code-range":U + chr(1) +
      740                                  (if v-range-type = 'sclc':U
      741                                   then string( current-value(s-sclc-code, ub))
      742                                   else string( current-value(s-pglc-code, ub))
      743                                   ) + chr(1) +
      744                                   v-range-type)
      745                           ,input ?
      746                           ,input v-db-for-send
      747                           ) no-error .
      748             if error-status :error then do:
      749               undo, return error return-value.
      750             end.
      751           end.
      752         end.
      753       end.
      754     end.
      755   end procedure.
      756   procedure cre-loc-sc-code-range :
      757     define input parameter v-cur-code as integer no-undo .
      758   define input parameter p-cdrg-type as character no-undo .
      759     do
      760     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      761     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      762     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      763     :
      764       define buffer buf_code-range for ub.code-range .
      765       find first buf_code-range
      766            where buf_code-range.range-type = p-cdrg-type
      767              and buf_code-range.first-code >= v-cur-code
      768            no-error .
      769       if not available buf_code-range then do:
      770         run new-bcod-gen-code-range in this-procedure
      771           ( input 0,
      772             input p-cdrg-type
      773           ) no-error .
      774         if error-status :error then do:
      775           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      776                                          + "Код &2&1&3 &4"
      777                                         , chr(10)
      778                                         , v-cur-code
      779                                         , error-status:get-message(1)
      780                                         , return-value
      781                                        ) .
      782         end.
      783       end.
      784     end.
      785   end procedure.
      786   procedure mark-used-if-need :
      787   define input parameter p-cur-code as integer no-undo .
      788   define input parameter p-range-type like ub.code-range.range-type no-undo .
      789   define input parameter p-db-num like ub.code-range.db-num no-undo .
      790     do
      791     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      792     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      793     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      794     :
      795       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      796       define buffer buf_code-range for ub.code-range .
      797       assign
      798       v-db-num = if p-range-type = 'sclc':U
      799                  then 0
      800                  else p-db-num
      801       .
      802   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      803   define buffer locK-batchprocess2 for ub.batchprocess.
      804   run gbl/lock-prc.p
      805       (input 'lscc':U
      806       ,input 0
      807       ,input 0
      808       ,input 0
      809       ,input ""
      810       ,input ""
      811       ,input ""
      812       ,input (
      813               ",,,Вкл/выкл лок. вес. кодов"
      814              )
      815       ,input true
      816       ,buffer lock-batchprocess2
      817       ) no-error .
      818     if error-status :error then do:
      819       message
      820         vss-workfile vss-revision vss-description skip
      821         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      822         view-as alert-box error .
      823       undo, return error .
      824     end.
      825       find first buf_code-range
      826            where buf_code-range.range-type = p-range-type
      827              and buf_code-range.first-code >= p-cur-code
      828              and buf_code-range.last-code <= p-cur-code
      829              and buf_code-range.db-num = v-db-num
      830            no-error .
      831       if not available buf_code-range then do:
      832         message
      833           vss-workfile vss-revision vss-description skip
      834           "Ошибка при создании поиске диапазона" skip
      835           "База данных" p-db-num skip
      836           "Код" p-cur-code skip
      837           "Тип" p-range-type
      838           error-status :get-message(1) skip
      839           return-value skip
      840           view-as alert-box error .
      841         undo, return error .
      842       end.
      843       if buf_code-range.stts = "f":U then do:
      844         assign
      845         buf_code-range.stts = "u":U
      846         .
      847       end.
      848     end.
      849   end procedure.
      850     define variable g-log as logical   no-undo .
      851     define variable is-expense  as logical   no-undo .
      852     define buffer buf_contract for ub.contract .
      853     define buffer b1_fin-schet for ub.fin-schet .
      854     define buffer b2_fin-schet for ub.fin-schet .
      855     define variable curr-rc as character no-undo .
      856     define variable v-curr-r-b as integer   no-undo .
      857     define variable num-fo as integer initial 0  no-undo .
      858     define variable sss as character no-undo .
      859   DEFINE BUTTON B-calc
      860        LABEL "Расчет сумм и курсов"
      861        SIZE 22 BY 1.
      862   DEFINE BUTTON b-exit AUTO-GO
      863        LABEL "&Ввод"
      864        SIZE 10 BY 1
      865        BGCOLOR 8 .
      866   DEFINE BUTTON b-help
      867        LABEL "Помо&щь"
      868        SIZE 10 BY 1
      869        BGCOLOR 8 .
      870   DEFINE BUTTON b-quit AUTO-END-KEY
      871        LABEL "&Отмена"
      872        SIZE 10 BY 1
      873        BGCOLOR 8 .
      874   DEFINE BUTTON B-tax
      875        LABEL "&Налоги"
      876        SIZE 10 BY 1.
      877   DEFINE VARIABLE naznach-plat AS CHARACTER
      878        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      879        SIZE 51.5 BY 5.5 NO-UNDO.
      880   DEFINE VARIABLE curr AS CHARACTER FORMAT "X(256)":U
      881         VIEW-AS TEXT
      882        SIZE 6 BY .67 NO-UNDO.
      883   DEFINE VARIABLE FILL-code AS CHARACTER FORMAT "X(16)":U
      884        LABEL "Номер"
      885        VIEW-AS FILL-IN
      886        SIZE 17.5 BY 1 NO-UNDO.
      887   DEFINE VARIABLE FILL-sum AS DECIMAL FORMAT ">,>>>,>>>,>>>,>>9.99":U INITIAL 0
      888        LABEL "Сумма"
      889        VIEW-AS FILL-IN
      890        SIZE 24.5 BY 1 NO-UNDO.
      891   DEFINE VARIABLE b-nal AS INTEGER INITIAL 1
      892        VIEW-AS RADIO-SET HORIZONTAL
      893        RADIO-BUTTONS
      894             "б/н", 1,
      895   "нал.", 2,
      896   "АПЗ", 3
      897        SIZE 18 BY 1 NO-UNDO.
      898   DEFINE VARIABLE b-val AS INTEGER INITIAL 1
      899        VIEW-AS RADIO-SET VERTICAL
      900        RADIO-BUTTONS
      901             "abbr_rub_firstshift.", 1,
      902   "Б.вал.", 2,
      903   "Вал.дог.", 3
      904        SIZE 11 BY 2.5 NO-UNDO.
      905   DEFINE RECTANGLE RECT-7
      906        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      907        SIZE 25.5 BY 1.5.
      908   DEFINE RECTANGLE RECT-8
      909        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      910        SIZE 51.5 BY 3.75.
      911   DEFINE FRAME Dialog-Frame
      912        b-exit AT ROW 1 COL 1
      913        b-quit AT ROW 1 COL 11
      914        B-tax AT ROW 1 COL 33
      915        b-help AT ROW 1 COL 43
      916        FILL-code AT ROW 2.25 COL 7 COLON-ALIGNED
      917        b-nal AT ROW 2.25 COL 34.5 NO-LABEL
      918        FILL-sum AT ROW 4 COL 26 COLON-ALIGNED
      919        b-val AT ROW 4.58 COL 3.13 NO-LABEL
      920        B-calc AT ROW 5.25 COL 30
      921        naznach-plat AT ROW 9.5 COL 1.5 NO-LABEL
      922        curr AT ROW 3.75 COL 10 COLON-ALIGNED NO-LABEL
      923        RECT-7 AT ROW 2 COL 27.5
      924        RECT-8 AT ROW 3.5 COL 1.5
      925        "Основание платежа" VIEW-AS TEXT
      926             SIZE 19.38 BY 1 AT ROW 8.25 COL 2
      927             FGCOLOR 4
      928        "Тип:" VIEW-AS TEXT
      929             SIZE 5 BY .83 AT ROW 2.25 COL 28.5
      930             FGCOLOR 4
      931        "Валюта:" VIEW-AS TEXT
      932             SIZE 9 BY .83 AT ROW 3.67 COL 3
      933             FGCOLOR 4
      934        SPACE(41.49) SKIP(10.57)
      935       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      936            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      937            TITLE "Новый платеж"
      938            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      939   ASSIGN
      940          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      941          FRAME Dialog-Frame:HIDDEN           = TRUE.
      942   ASSIGN
      943          FILL-sum:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      944   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      945   DO:
      946     APPLY "END-ERROR":U TO SELF.
      947   END.
      948   ON CHOOSE OF B-calc IN FRAME Dialog-Frame
      949   DO:
      950     define variable old-sum as decimal   no-undo .
      951     assign old-sum = tt-fin-doc.sum-doc .
      952     run ref/findclci.w (
      953      INPUT          parParentProc
      954     ,input          "":U
      955     ,INPUT          tt-fin-doc.doc-date
      956     ,INPUT          tt-fin-doc.curr-code
      957     ,INPUT          v-curr-r-b
      958     ,INPUT          tt-fin-doc.contract-curr
      959     ,INPUT-OUTPUT   tt-fin-doc.sum-doc
      960     ,INPUT-OUTPUT   tt-fin-doc.exch-rate
      961     ,INPUT-OUTPUT   tt-fin-doc.exch-scale
      962     ,INPUT-OUTPUT   tt-fin-doc.sum-rubl
      963     ,INPUT-OUTPUT   tt-fin-doc.sum-base
      964     ,INPUT-OUTPUT   tt-fin-doc.base-rate
      965     ,INPUT-OUTPUT   tt-fin-doc.base-scale
      966     ,INPUT-OUTPUT   tt-fin-doc.sum-contr
      967     ,INPUT-OUTPUT   tt-fin-doc.contract-rate
      968     ,INPUT-OUTPUT   tt-fin-doc.contract-scale ) no-error.
      969     if error-status:error then return no-apply.
      970     assign FILL-sum = tt-fin-doc.sum-doc .
      971     DISPLAY FILL-sum WITH FRAME Dialog-Frame.
      972     if tt-fin-doc.sum-doc <> tt-fin-doc.sum-doc then run CorrectNalog in this-procedure .
      973   END.
      974   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      975   DO:
      976     assign naznach-plat FILL-code .
      977     run CreateDoc no-error.
      978     if error-status:error then return no-apply.
      979   END.
      980   ON VALUE-CHANGED OF b-nal IN FRAME Dialog-Frame
      981   DO:
      982    if b-nal:screen-value = "1" then do:
      983      if not available b1_fin-schet or not available b2_fin-schet then do:
      984         message  "Не найден счет плательщика или получателя."   view-as alert-box.
      985         assign b-nal:screen-value = string(b-nal) .
      986         return .
      987       end.
      988     end.
      989     assign b-nal .
      990     if b-nal = 1 then do:
      991       DISABLE b-val WITH FRAME Dialog-Frame .
      992       case b2_fin-schet.curr-code :
      993         when 0 then assign tt-fin-doc.sum-doc = tt-fin-doc.sum-rubl .
      994         when v-curr-r-b then assign tt-fin-doc.sum-doc = tt-fin-doc.sum-base .
      995         when buf_contract.curr-code then assign tt-fin-doc.sum-doc = tt-fin-doc.sum-contr .
      996         otherwise do:
      997   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      998   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      999     (input  b2_fin-schet.curr-code
     1000     ,input  today
     1001     ,output tt-fin-doc.exch-rate
     1002     ,output tt-fin-doc.exch-scale
     1003     ,output curr-rc
     1004     )  .
     1005           assign tt-fin-doc.sum-doc = tt-fin-doc.sum-rubl * tt-fin-doc.exch-scale / tt-fin-doc.exch-rate  .
     1006           assign  FILL-sum = tt-fin-doc.sum-doc .
     1007         end.
     1008       end.
     1009       assign
     1010         curr = curr-rc
     1011         tt-fin-doc.curr-code = b1_fin-schet.curr-code
     1012       .
     1013       assign naznach-plat .
     1014       define variable si as character no-undo .
     1015       si = entry(2,naznach-plat,'@') no-error .
     1016       if si = "" then assign
     1017         tt-fin-doc.naznach-plat = tt-fin-doc.naznach-plat + "@" + tt-fin-doc.including
     1018         naznach-plat = tt-fin-doc.naznach-plat
     1019       .
     1020       DISPLAY curr FILL-sum naznach-plat WITH FRAME Dialog-Frame.
     1021     end.
     1022     else do:
     1023       ENABLE  b-val WITH FRAME Dialog-Frame .
     1024       apply "VALUE-CHANGED"  to b-val in frame Dialog-Frame.
     1025     end.
     1026   END.
     1027   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1028   DO:
     1029     message "Вы действительно хотите отменить создание платежа?" view-as alert-box QUESTION BUTTONS YES-NO UPDATE g-log .
     1030     if g-log = no then return no-apply.
     1031   END.
     1032   ON CHOOSE OF B-tax IN FRAME Dialog-Frame
     1033   DO:
     1034     run ref/fndocti.w (
     1035                     INPUT parParentProc
     1036                     ,input p-host-code
     1037                     ,input 'ДОБАВЛЕНИЕ':U
     1038                     ,input tt-fin-doc.host-code
     1039                     ,input tt-fin-doc.fin-doc-code
     1040                     ,input tt-fin-doc.fin-doc-type
     1041                     ,input tt-fin-doc.fin-ext-doc-type
     1042                     ,input tt-fin-doc.trn-doc-code
     1043                     ,input tt-fin-doc.contract-code
     1044                     ,input tt-fin-doc.sum-doc
     1045                     ,input tt-fin-doc.curr-code
     1046                     ,input tt-fin-doc.base-rate
     1047                     ,input tt-fin-doc.base-scale
     1048                     ,input tt-fin-doc.exch-rate
     1049                     ,input tt-fin-doc.exch-scale
     1050                     ,input tt-fin-doc.obj-type
     1051                     ,input tt-fin-doc.obj-code
     1052                     ,input-output table tt0-fin-doc-tax
     1053                     ,input 0
     1054                     ).
     1055     assign naznach-plat .
     1056     if num-entries(naznach-plat, "@":U) > 1 then do:
     1057       assign sss = ""  .
     1058       run StrTax (input-output sss) .
     1059       assign  entry(2, naznach-plat, "@":U) = sss.
     1060       DISPLAY naznach-plat WITH FRAME Dialog-Frame.
     1061     end.
     1062   END.
     1063   ON VALUE-CHANGED OF b-val IN FRAME Dialog-Frame
     1064   DO:
     1065     assign b-val .
     1066     case b-val :
     1067       when 1 then do:
     1068         find first ub.currency no-lock where ub.currency.curr-code = 0 .
     1069         assign
     1070           FILL-sum = tt-fin-doc.sum-rubl
     1071           tt-fin-doc.curr-code = 0
     1072         .
     1073       end.
     1074       when 2 then do:
     1075         find first ub.currency no-lock where ub.currency.curr-code = v-curr-r-b .
     1076         assign
     1077           FILL-sum = tt-fin-doc.sum-base
     1078           tt-fin-doc.curr-code = v-curr-r-b
     1079         .
     1080       end.
     1081       when 3 then do:
     1082         find first ub.currency no-lock where ub.currency.curr-code = buf_contract.curr-code .
     1083         assign
     1084           FILL-sum = tt-fin-doc.sum-contr
     1085           tt-fin-doc.curr-code = buf_contract.curr-code
     1086         .
     1087       end.
     1088     end.
     1089     assign curr = ub.currency.curr-abbr .
     1090     DISPLAY curr WITH FRAME Dialog-Frame.
     1091   END.
     1092   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1093   on help of frame Dialog-Frame
     1094   do:
     1095     run gbl/app_help.p
     1096       (input this-procedure :file-name
     1097       ,input ''
     1098       ,input ?
     1099       ) no-error.
     1100     if error-status :error then do:
     1101       message
     1102         "Ошибка при вызове помощи"
     1103         error-status :get-message(1)
     1104         view-as alert-box .
     1105     end.
     1106   end.
     1107   run minbtn-set in this-procedure .
     1108   on choose of b-help in frame Dialog-Frame
     1109   do:
     1110     apply "help":u to frame Dialog-Frame .
     1111   end.
     1112   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1113   procedure minbtn-set :
     1114       do
     1115           on error undo, return error return-value
     1116           :
     1117           define variable ii              as integer       no-undo .
     1118           define variable fh              as widget-handle no-undo .
     1119           define variable hh              as widget-handle no-undo .
     1120           define variable v-h             as handle        extent 4 no-undo .
     1121           define variable v-name-button   as character     no-undo .
     1122           define variable v-help-old-x    as decimal       no-undo .
     1123           define variable v-help-old-y    as decimal       no-undo .
     1124           define variable v-help-old-size as decimal       no-undo .
     1125           define variable v-frame-width   as decimal       no-undo .
     1126           define variable jj              as integer       no-undo .
     1127           do
     1128               on error undo, return error
     1129               :
     1130               assign
     1131                   v-frame-width = frame Dialog-Frame:width - 0.3
     1132                   fh            = frame Dialog-Frame:first-child
     1133                   hh            = fh:first-child
     1134                   ii            = 1
     1135                   .
     1136               do while valid-handle(hh):
     1137                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1138                   do:
     1139                       case lc(hh:name) :
     1140                           when "b-help" then
     1141                               do:
     1142                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1143                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1144                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1145                                   hh:TOOLTIP = "Помощь" .
     1146                                   v-help-old-x = hh:column .
     1147                                   v-help-old-y = hh:row    .
     1148                                   v-help-old-size = hh:width .
     1149                                   hh:width-chars = 2.5 .
     1150                               end.
     1151                           when "b-print" then
     1152                               do:
     1153                                   hh:load-image("cmp/b-print.bmp":u) .
     1154                                   hh:TOOLTIP = "Печать" .
     1155                                   v-h[ii] = hh:handle .
     1156                                   ii = ii + 1 .
     1157                                   hh:width-chars = 3 .
     1158                               end.
     1159                           when "b-history" or
     1160                           when "b-hist" then
     1161                               do:
     1162                                   hh:load-image("cmp/b-hist.bmp":u) .
     1163                                   hh:TOOLTIP = "История" .
     1164                                   v-h[ii] = hh:handle .
     1165                                   ii = ii + 1 .
     1166                                   hh:width-chars = 3 .
     1167                               end.
     1168                           when "b-sch" then
     1169                               do:
     1170                                   hh:load-image("cmp/b-sch.bmp":u) .
     1171                                   hh:TOOLTIP = "Установка Фильтра" .
     1172                                   v-h[ii] = hh:handle .
     1173                                   ii = ii + 1 .
     1174                                   hh:width-chars = 3 .
     1175                               end.
     1176                           when "b-hist-user" then
     1177                               do:
     1178                                   hh:load-image("cmp/b-hist.bmp":u) .
     1179                                   hh:TOOLTIP = "История пользователя" .
     1180                                   ii = ii + 1 .
     1181                               end.
     1182                       end case.
     1183                   end.
     1184                   hh = hh:next-sibling.
     1185               end.
     1186               b-help:column = v-frame-width - b-help:width-chars.
     1187               jj = 0.
     1188               repeat ii = 4 to 1 by -1 :
     1189                   if valid-handle (v-h[ii] ) then
     1190                   do:
     1191                       jj  = jj + 1 .
     1192                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1193                       v-h[ii]:row    = v-help-old-y .
     1194                   end.
     1195               end.
     1196           end.
     1197       end.
     1198   end procedure.
     1199   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1200   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1201   MAIN-BLOCK:
     1202   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1203      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1204   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1205   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1206     (input  p-host-code
     1207     ,output v-curr-r-b
     1208     )  .
     1209   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1210   ON ANY-PRINTABLE OF naznach-plat IN FRAME Dialog-Frame
     1211   DO:
     1212     RUN proc-uho-check IN THIS-PROCEDURE(1) NO-ERROR.
     1213     IF ERROR-STATUS :ERROR THEN DO: RETURN NO-APPLY. END.
     1214   END.
     1215   ON BACKSPACE OF naznach-plat IN FRAME Dialog-Frame
     1216   DO:
     1217   define variable v-offset as integer no-undo .
     1218     RUN proc-uho-check IN THIS-PROCEDURE(1) NO-ERROR.
     1219     IF ERROR-STATUS :ERROR THEN DO: RETURN NO-APPLY. END.
     1220     if naznach-plat :CURSOR-OFFSET > 1 then do :
     1221       assign
     1222       v-offset = naznach-plat:CURSOR-OFFSET
     1223       naznach-plat:screen-value = substring(naznach-plat:screen-value, 1, naznach-plat:CURSOR-OFFSET - 2) +
     1224                         substring(naznach-plat:screen-value, naznach-plat:CURSOR-OFFSET , length(naznach-plat:screen-value)  -  naznach-plat:CURSOR-OFFSET + 1)
     1225       naznach-plat:CURSOR-OFFSET = v-offset - 1
     1226       .
     1227     end.
     1228   END.
     1229   ON DELETE-CHARACTER OF naznach-plat IN FRAME Dialog-Frame
     1230   DO:
     1231   define variable v-offset as integer no-undo .
     1232     if naznach-plat:selection-start = ? then do:
     1233       RUN proc-uho-check IN THIS-PROCEDURE(0) NO-ERROR.
     1234       IF ERROR-STATUS :ERROR THEN DO: RETURN NO-APPLY. END.
     1235       assign
     1236       v-offset = naznach-plat:CURSOR-OFFSET
     1237       naznach-plat:screen-value = substring(naznach-plat:screen-value, 1, naznach-plat:CURSOR-OFFSET - 1) +
     1238                         substring(naznach-plat:screen-value, naznach-plat:CURSOR-OFFSET + 1, length(naznach-plat:screen-value)  -  naznach-plat:CURSOR-OFFSET + 1)
     1239       naznach-plat:CURSOR-OFFSET = v-offset
     1240       .
     1241     end.
     1242     else do:
     1243       IF  index(naznach-plat:SCREEN-VALUE IN FRAME Dialog-Frame, "@") > 0 then do:
     1244         IF naznach-plat:Selection-start >= index(naznach-plat:SCREEN-VALUE, "@") + 1 THEN   do:
     1245           RETURN no-apply.
     1246         end.
     1247       END.
     1248       naznach-plat:edit-clear().
     1249     end.
     1250   END.
     1251   ON CTRL-X OF naznach-plat IN FRAME Dialog-Frame
     1252   DO:
     1253     IF  index(naznach-plat:SCREEN-VALUE IN FRAME Dialog-Frame, "@") > 0 then do:
     1254       IF naznach-plat:Selection-start >= index(naznach-plat:SCREEN-VALUE, "@") + 1 THEN   do:
     1255         RETURN no-apply.
     1256       end.
     1257     END.
     1258     naznach-plat:edit-cut().
     1259   END.
     1260   ON CTRL-V OF naznach-plat IN FRAME Dialog-Frame
     1261   DO:
     1262     IF  index(naznach-plat:SCREEN-VALUE IN FRAME Dialog-Frame, "@") > 0 then do:
     1263       IF naznach-plat:Selection-start >= index(naznach-plat:SCREEN-VALUE, "@") + 1 THEN   do:
     1264         RETURN no-apply.
     1265       end.
     1266     END.
     1267     naznach-plat:edit-paste().
     1268   END.
     1269         procedure proc-uho-check :
     1270   DEFINE INPUT PARAMETER p-offset AS INTEGER NO-UNDO.
     1271     do
     1272     on error undo, return error
     1273     :
     1274       IF  index(naznach-plat:SCREEN-VALUE IN FRAME Dialog-Frame, "@") > 0 then do:
     1275         IF (naznach-plat:CURSOR-OFFSET >= index(naznach-plat:SCREEN-VALUE, "@") + 1
     1276         AND p-offset = 0)
     1277         OR (naznach-plat:CURSOR-OFFSET > index(naznach-plat:SCREEN-VALUE, "@") + 1
     1278         AND p-offset = 1)  THEN   do:
     1279           RETURN ERROR.
     1280         end.
     1281       END.
     1282     end.
     1283   end procedure.
     1284     find first ub.sysconf no-lock where ub.sysconf.host-code = p-host-code .
     1285     find first ub.firm no-lock where ub.firm.firm-code = p-host-code .
     1286     run StartProc in this-procedure .
     1287     assign
     1288       tt-fin-doc.prn-doc-code = string(tt-fin-doc.fin-doc-code)
     1289       FILL-sum     = tt-fin-doc.sum-doc
     1290       naznach-plat = tt-fin-doc.naznach-plat
     1291       FILL-code    = tt-fin-doc.prn-doc-code
     1292     .
     1293     case buf_contract.pay-nal :
     1294       when no  then assign b-nal = 1 .
     1295       when yes then assign b-nal = 2 .
     1296       when ?   then assign b-nal = 3 .
     1297     end.
     1298     case tt-fin-doc.contract-curr :
     1299       when 0          then             assign b-val = 1 .
     1300       when v-curr-r-b then             assign b-val = 2 .
     1301       when buf_contract.curr-code then assign b-val = 3 .
     1302       otherwise                        assign b-val = 1 .
     1303     end.
     1304     assign
     1305     b-val:radio-buttons in frame Dialog-Frame =
     1306     "Руб." + chr(44) + "1" + chr(44) +
     1307     "Б.вал." + chr(44) + "2" + chr(44) +
     1308     "Вал.дог." + chr(44) + "3"
     1309     .
     1310     RUN enable_UI.
     1311     apply "VALUE-CHANGED"  to b-nal in frame Dialog-Frame.
     1312     WAIT-FOR GO OF FRAME Dialog-Frame.
     1313   END.
     1314   RUN disable_UI.
     1315   PROCEDURE CorrectNalog :
     1316     do
     1317     on error undo, return error return-value
     1318     :
     1319       for each tt0-fin-doc-tax : delete tt0-fin-doc-tax . end.
     1320       create tt0-fin-doc-tax .
     1321       assign
     1322         tt0-fin-doc-tax.fin-doc-code       = tt-fin-doc.fin-doc-code
     1323         tt0-fin-doc-tax.host-code          = p-host-code
     1324         tt0-fin-doc-tax.line-num           = 1
     1325         tt0-fin-doc-tax.VAT-pc             = buf_contract.fin-VAT-pc
     1326         tt0-fin-doc-tax.sum-line-doc       =  tt-fin-doc.sum-doc
     1327         tt0-fin-doc-tax.sum-vat-line-doc   =  tt-fin-doc.sum-doc * buf_contract.fin-VAT-pc / (100 + buf_contract.fin-VAT-pc)
     1328         tt0-fin-doc-tax.sum-line-rubl      =  tt-fin-doc.sum-rubl
     1329         tt0-fin-doc-tax.sum-vat-line-rubl  =  tt-fin-doc.sum-rubl * buf_contract.fin-VAT-pc / (100 + buf_contract.fin-VAT-pc)
     1330         tt0-fin-doc-tax.sum-line-base      =  tt-fin-doc.sum-base
     1331         tt0-fin-doc-tax.sum-vat-line-base  =  tt-fin-doc.sum-base * buf_contract.fin-VAT-pc / (100 + buf_contract.fin-VAT-pc)
     1332         tt0-fin-doc-tax.sum-line-contr     =  tt-fin-doc.sum-contr
     1333         tt0-fin-doc-tax.sum-vat-line-contr =  tt-fin-doc.sum-contr * buf_contract.fin-VAT-pc / (100 + buf_contract.fin-VAT-pc)
     1334       .
     1335     end.
     1336   END PROCEDURE.
     1337   PROCEDURE CreateDoc :
     1338     do on error undo, return error return-value :
     1339       assign
     1340         tt-fin-doc.naznach-plat = naznach-plat
     1341         tt-fin-doc.prn-doc-code = FILL-code
     1342       .
     1343       if b-nal > 1 then do:
     1344         case b-val:
     1345           when 1 then assign tt-fin-doc.curr-code = 0 .
     1346           when 2 then assign tt-fin-doc.curr-code = v-curr-r-b .
     1347           when 3 then assign tt-fin-doc.curr-code = buf_contract.curr-code .
     1348         end.
     1349         assign
     1350           tt-fin-doc.receiver-code-schet = 0
     1351           tt-fin-doc.receiver-bank-name  = ""
     1352           tt-fin-doc.receiver-c-schet    = ""
     1353           tt-fin-doc.receiver-r-schet    = ""
     1354           tt-fin-doc.payer-code-schet = 0
     1355           tt-fin-doc.payer-bank-name  = ""
     1356           tt-fin-doc.payer-c-schet    = ""
     1357           tt-fin-doc.payer-r-schet    = ""
     1358         .
     1359       end.
     1360       else do:
     1361         if not available b1_fin-schet or not available b2_fin-schet then do:
     1362           message  "Не найден счет плательщика или получателя."   view-as alert-box.
     1363           return error .
     1364         end.
     1365         assign tt-fin-doc.curr-code    = b1_fin-schet.curr-code .
     1366       end.
     1367      if is-expense then
     1368        assign
     1369          tt-fin-doc.payer-sign1        = ub.firm.director
     1370          tt-fin-doc.payer-sign2        = ub.sysconf.snr-accnt
     1371          tt-fin-doc.payer-sign3        = ub.sysconf.cashier
     1372        .
     1373      else
     1374        assign
     1375          tt-fin-doc.receiver-sign1        = ub.firm.director
     1376          tt-fin-doc.receiver-sign2        = ub.sysconf.snr-accnt
     1377          tt-fin-doc.receiver-sign3        = ub.sysconf.cashier
     1378        .
     1379       case b-nal :
     1380         when 1 then do:
     1381           if b1_fin-schet.curr-code <> b2_fin-schet.curr-code then do:
     1382             message "Валюта счета плательщика отличается от валюты счета получателя." view-as alert-box.
     1383             return error .
     1384           end.
     1385           if buf_contract.doc-type = 'при':U then do:
     1386             if is-expense then do:
     1387               assign
     1388               tt-fin-doc.fin-doc-type = 'рпп':U
     1389               tt-fin-doc.fin-ext-doc-type = 'рпп':U
     1390               .
     1391             end.
     1392             else do:
     1393               assign
     1394               tt-fin-doc.fin-doc-type = 'ппп':U
     1395               tt-fin-doc.fin-ext-doc-type = 'ппп':U
     1396               .
     1397             end.
     1398           end.
     1399           else do:
     1400             if is-expense then do:
     1401               assign
     1402               tt-fin-doc.fin-doc-type = 'ппп':U
     1403               tt-fin-doc.fin-ext-doc-type = 'ппп':U
     1404               .
     1405             end.
     1406             else do:
     1407               assign
     1408               tt-fin-doc.fin-doc-type = 'рпп':U
     1409               tt-fin-doc.fin-ext-doc-type = 'рпп':U
     1410               .
     1411             end.
     1412           end.
     1413         end.
     1414         when 2 then do:
     1415           run StrTax (input-output tt-fin-doc.including) .
     1416           if buf_contract.doc-type = 'при':U then do:
     1417             if is-expense then do:
     1418               assign
     1419               tt-fin-doc.fin-doc-type = 'рко':U
     1420               tt-fin-doc.fin-ext-doc-type = 'рко':U
     1421               .
     1422           end.
     1423           else do:
     1424               assign
     1425               tt-fin-doc.fin-doc-type = 'пко':U
     1426               tt-fin-doc.fin-ext-doc-type = 'пко':U
     1427               .
     1428             end.
     1429           end.
     1430           else do:
     1431             if is-expense then do:
     1432               assign
     1433               tt-fin-doc.fin-doc-type = 'пко':U
     1434               tt-fin-doc.fin-ext-doc-type = 'пко':U
     1435               .
     1436             end.
     1437             else do:
     1438               assign
     1439               tt-fin-doc.fin-doc-type = 'рко':U
     1440               tt-fin-doc.fin-ext-doc-type = 'рко':U
     1441               .
     1442             end.
     1443           end.
     1444         end.
     1445         when 3 then do:
     1446           if buf_contract.doc-type = 'при':U then do:
     1447             if is-expense then do:
     1448               assign
     1449               tt-fin-doc.fin-doc-type = 'апр':U
     1450               tt-fin-doc.fin-ext-doc-type = 'апр':U
     1451               .
     1452             end.
     1453             else do:
     1454               assign
     1455               tt-fin-doc.fin-doc-type = 'апп':U
     1456               tt-fin-doc.fin-ext-doc-type = 'апп':U
     1457               .
     1458             end.
     1459           end.
     1460           else do:
     1461             if is-expense then do:
     1462               assign
     1463               tt-fin-doc.fin-doc-type = 'апп':U
     1464               tt-fin-doc.fin-ext-doc-type = 'апп':U
     1465               .
     1466           end.
     1467           else do:
     1468               assign
     1469               tt-fin-doc.fin-doc-type = 'апр':U
     1470               tt-fin-doc.fin-ext-doc-type = 'апр':U
     1471               .
     1472             end.
     1473           end.
     1474         end.
     1475       end.
     1476       define variable p-doc-rec as recid no-undo.
     1477       run UchetCode in this-procedure .
     1478       run RoundTax in this-procedure .
     1479       tt-fin-doc.doc-author = "fin-ob".
     1480       run ref/findoc0.p (
     1481           input-output p-doc-rec
     1482          ,input 'ДОБАВЛЕНИЕ':U
     1483          ,input no
     1484          ,input tt-fin-doc.host-code            ,input tt-fin-doc.fin-doc-code         ,input tt-fin-doc.an-uchet-code        ,input tt-fin-doc.an-uchet-value       ,input tt-fin-doc.base-rate            ,input tt-fin-doc.base-scale           ,input tt-fin-doc.cel-nazn-code        ,input tt-fin-doc.cel-nazn-value       ,input tt-fin-doc.contract-code        ,input tt-fin-doc.contract-curr        ,input tt-fin-doc.contract-rate        ,input tt-fin-doc.contract-scale       ,input tt-fin-doc.cor-acc              ,input tt-fin-doc.cor-acc-value        ,input tt-fin-doc.cor-acc1             ,input tt-fin-doc.cor-acc1-value       ,input tt-fin-doc.curr-code            ,input tt-fin-doc.doc-date             ,input tt-fin-doc.shift-date           ,input tt-fin-doc.shift-num            ,input tt-fin-doc.shift-name           ,input tt-fin-doc.enclosure            ,input tt-fin-doc.exch-rate            ,input tt-fin-doc.exch-scale           ,input tt-fin-doc.f104                 ,input tt-fin-doc.f105                 ,input tt-fin-doc.f106                 ,input tt-fin-doc.f107                 ,input tt-fin-doc.f108                 ,input tt-fin-doc.f109                 ,input tt-fin-doc.f110                 ,input tt-fin-doc.f22                  ,input tt-fin-doc.f23                  ,input tt-fin-doc.fact-date            ,input tt-fin-doc.fin-doc-type         ,input tt-fin-doc.fin-ext-doc-type     ,input tt-fin-doc.in-doc-code          ,input tt-fin-doc.in-host-code         ,input tt-fin-doc.including            ,input tt-fin-doc.nazn-pl              ,input tt-fin-doc.naznach-plat         ,input tt-fin-doc.ocher-pl             ,input tt-fin-doc.out-doc-code         ,input tt-fin-doc.out-host-code        ,input tt-fin-doc.pay-date             ,input tt-fin-doc.payer-bank-name      ,input tt-fin-doc.payer-bank-city      ,input tt-fin-doc.payer-bik            ,input tt-fin-doc.payer-c-schet        ,input tt-fin-doc.payer-code           ,input tt-fin-doc.payer-code-schet     ,input tt-fin-doc.payer-dop1           ,input tt-fin-doc.payer-dop2           ,input tt-fin-doc.payer-inn            ,input tt-fin-doc.payer-kpp            ,input tt-fin-doc.payer-name           ,input tt-fin-doc.payer-okpo           ,input tt-fin-doc.payer-passport      ,input tt-fin-doc.payer-r-schet        ,input tt-fin-doc.payer-type           ,input tt-fin-doc.perm-date            ,input tt-fin-doc.prn-doc-code         ,input tt-fin-doc.PS                   ,input tt-fin-doc.receiver-bank-name   ,input tt-fin-doc.receiver-bank-city   ,input tt-fin-doc.receiver-bik         ,input tt-fin-doc.receiver-c-schet     ,input tt-fin-doc.receiver-code        ,input tt-fin-doc.receiver-code-schet  ,input tt-fin-doc.receiver-dop1        ,input tt-fin-doc.receiver-dop2        ,input tt-fin-doc.receiver-inn         ,input tt-fin-doc.receiver-kpp         ,input tt-fin-doc.receiver-name        ,input tt-fin-doc.receiver-okpo        ,input tt-fin-doc.receiver-passport    ,input tt-fin-doc.receiver-r-schet     ,input tt-fin-doc.receiver-type        ,input tt-fin-doc.srok-pl              ,input tt-fin-doc.stat-pl              ,input tt-fin-doc.str-podr-code        ,input tt-fin-doc.str-podr-type        ,input tt-fin-doc.str-podr-name        ,input tt-fin-doc.sum-base             ,input tt-fin-doc.sum-doc              ,input tt-fin-doc.sum-rubl             ,input tt-fin-doc.sum-contr            ,input tt-fin-doc.trn-doc-code         ,input tt-fin-doc.vid-opl              ,input tt-fin-doc.vid-plat
     1485          ,input tt-fin-doc.con-sum-rubl         ,input tt-fin-doc.con-sum-base         ,input tt-fin-doc.con-sum-doc          ,input tt-fin-doc.con-sum-contr        ,input tt-fin-doc.con-stat             ,input tt-fin-doc.payer-sign1                ,input tt-fin-doc.payer-sign2                ,input tt-fin-doc.payer-sign3                ,input tt-fin-doc.payer-sign4                ,input tt-fin-doc.receiver-sign1                ,input tt-fin-doc.receiver-sign2                ,input tt-fin-doc.receiver-sign3                ,input tt-fin-doc.receiver-sign4                ,input tt-fin-doc.obj-type                   ,input tt-fin-doc.obj-code                   ,input tt-fin-doc.doc-author                 ,input tt-fin-doc.fact-author                ,input tt-fin-doc.CashBookId
     1486          ,input table tt0-fin-doc-tax
     1487          ,input table tt0-fin-doc-attr
     1488          ,input no
     1489          ,input table tt0-payment
     1490        ) no-error .
     1491       if error-status:error then do:
     1492         undo, return error.
     1493       end.
     1494       assign p-ri = p-doc-rec .
     1495     end.
     1496   END PROCEDURE.
     1497   PROCEDURE disable_UI :
     1498     HIDE FRAME Dialog-Frame.
     1499   END PROCEDURE.
     1500   PROCEDURE enable_UI :
     1501     DISPLAY FILL-code b-nal FILL-sum b-val naznach-plat curr
     1502         WITH FRAME Dialog-Frame.
     1503     ENABLE b-exit b-quit B-tax b-help FILL-code b-nal FILL-sum b-val B-calc
     1504            naznach-plat curr RECT-7 RECT-8
     1505         WITH FRAME Dialog-Frame.
     1506     VIEW FRAME Dialog-Frame.
     1507   END PROCEDURE.
     1508   PROCEDURE RoundTax :
     1509     do
     1510     on error undo, return error return-value
     1511     :
     1512       for each tt0-fin-doc-tax :
     1513         assign
     1514           tt0-fin-doc-tax.sum-line-doc       =  ROUND( tt0-fin-doc-tax.sum-line-doc      , 2)
     1515           tt0-fin-doc-tax.sum-vat-line-doc   =  ROUND( tt0-fin-doc-tax.sum-vat-line-doc  , 2)
     1516           tt0-fin-doc-tax.sum-line-rubl      =  ROUND( tt0-fin-doc-tax.sum-line-rubl     , 2)
     1517           tt0-fin-doc-tax.sum-vat-line-rubl  =  ROUND( tt0-fin-doc-tax.sum-vat-line-rubl , 2)
     1518           tt0-fin-doc-tax.sum-line-base      =  ROUND( tt0-fin-doc-tax.sum-line-base     , 2)
     1519           tt0-fin-doc-tax.sum-vat-line-base  =  ROUND( tt0-fin-doc-tax.sum-vat-line-base , 2)
     1520         .
     1521       end.
     1522     end.
     1523   END PROCEDURE.
     1524   PROCEDURE StartProc :
     1525     do
     1526     on error undo, return error return-value
     1527     :
     1528       define variable line as integer   no-undo .
     1529       define buffer b_fin-ob for ub.fin-ob .
     1530       define variable num-cont as integer  no-undo .
     1531       define variable pay-type as character no-undo .
     1532       define variable rec-type as character no-undo .
     1533       define variable obj-type as character no-undo .
     1534       define variable pay-code as integer no-undo .
     1535       define variable rec-code as integer no-undo .
     1536       define variable obj-code as integer no-undo .
     1537       define variable is-full-sum as logical   no-undo .
     1538       define variable p-koef-rubl as decimal   no-undo .
     1539       define variable p-koef-base as decimal   no-undo .
     1540       define variable p-koef-cont as decimal   no-undo .
     1541       define variable p-koef-doc  as decimal   no-undo .
     1542       define variable v-fd-code as integer no-undo .
     1543       assign
     1544         num-cont = - 1
     1545         line = 1
     1546         is-full-sum = yes .
     1547       .
     1548       for each temp-fin-ob :
     1549         find first b_fin-ob no-lock where recid(b_fin-ob) = temp-fin-ob.ri .
     1550         if b_fin-ob.con-stat = 2 then do:
     1551           message
     1552             "Фин. обязательство № " b_fin-ob.prn-doc-code " (дата платежа " b_fin-ob.pay-date ") уже полностью связано с платежем!"
     1553           view-as alert-box.
     1554           return error .
     1555         end.
     1556         if b_fin-ob.contract-code < 1 then do:
     1557           message "Автоматическая оплата фин. обязательств без договора невозможна! Фин. обязательство № " b_fin-ob.prn-doc-code " (дата платежа " b_fin-ob.pay-date "). " view-as alert-box.
     1558           return error .
     1559         end.
     1560         assign num-fo = num-fo + 1 .
     1561         if num-cont = - 1 then do:
     1562           find first buf_contract no-lock where buf_contract.host-code = p-host-code and buf_contract.contract-code = b_fin-ob.contract-code no-error .
     1563           assign
     1564             num-cont = b_fin-ob.contract-code
     1565             pay-type = b_fin-ob.payer-type
     1566             pay-code = b_fin-ob.payer-code
     1567             rec-type = b_fin-ob.receiver-type
     1568             rec-code = b_fin-ob.receiver-code
     1569             obj-type = b_fin-ob.obj-type
     1570             obj-code = b_fin-ob.obj-code
     1571           .
     1572           run gen-b-code in this-procedure ( input 'fdgb':U
     1573                                           , output v-fd-code) no-error .
     1574           if error-status:error then do:
     1575             define variable v-mess as character no-undo .
     1576             v-mess = substitute("Ошибка при генерации внутреннего номера фин. док-та:&1&2&1&3"
     1577                                         , chr(10)
     1578                                         , error-status:get-message(1)
     1579                                         , return-value ).
     1580             message
     1581             v-mess
     1582             view-as alert-box error .
     1583             undo, return error .
     1584           end.
     1585           create tt-fin-doc .
     1586           assign
     1587             tt-fin-doc.host-code       = p-host-code
     1588             tt-fin-doc.fin-doc-code    = v-fd-code
     1589             tt-fin-doc.contract-code   = b_fin-ob.contract-code
     1590             tt-fin-doc.contract-curr   = b_fin-ob.contract-curr
     1591             tt-fin-doc.curr-code       = b_fin-ob.curr-code
     1592             tt-fin-doc.doc-date        = today
     1593             tt-fin-doc.prn-doc-code    = ""
     1594             tt-fin-doc.PS              = ""
     1595             tt-fin-doc.ocher-pl        = "6"
     1596             tt-fin-doc.stat-pl         = ""
     1597             tt-fin-doc.naznach-plat    = "Оплата по договору № " + buf_contract.contract-prn-code + " от " + string( buf_contract.contract-date,"99/99/9999")
     1598             tt-fin-doc.payer-name      = b_fin-ob.payer-name
     1599             tt-fin-doc.payer-code      = b_fin-ob.payer-code
     1600             tt-fin-doc.payer-type      = b_fin-ob.payer-type
     1601             tt-fin-doc.receiver-code   = b_fin-ob.receiver-code
     1602             tt-fin-doc.receiver-name   = b_fin-ob.receiver-name
     1603             tt-fin-doc.receiver-type   = b_fin-ob.receiver-type
     1604             tt-fin-doc.sum-base        = b_fin-ob.sum-base     - b_fin-ob.con-sum-base
     1605             tt-fin-doc.sum-rubl        = b_fin-ob.sum-rubl     - b_fin-ob.con-sum-rubl
     1606             tt-fin-doc.sum-contr       = b_fin-ob.sum-contract - b_fin-ob.con-sum-contr
     1607             tt-fin-doc.sum-doc         = b_fin-ob.sum-doc      - b_fin-ob.con-sum-doc
     1608             tt-fin-doc.base-scale      = b_fin-ob.base-scale
     1609             tt-fin-doc.contract-scale  = b_fin-ob.contract-scale
     1610             tt-fin-doc.exch-scale      = b_fin-ob.exch-scale
     1611             p-koef-rubl                = ( b_fin-ob.sum-rubl     - b_fin-ob.con-sum-rubl ) / b_fin-ob.sum-rubl
     1612             p-koef-base                = ( b_fin-ob.sum-rubl     - b_fin-ob.con-sum-base ) / b_fin-ob.sum-rubl
     1613             p-koef-cont                = ( b_fin-ob.sum-contract - b_fin-ob.con-sum-contr) / b_fin-ob.sum-contract
     1614             p-koef-doc                 = ( b_fin-ob.sum-doc      - b_fin-ob.con-sum-doc  ) / b_fin-ob.sum-doc
     1615           .
     1616           run CheckCli no-error .
     1617           if error-status:error then do:
     1618             message "Несоответствие плательщика или получателя договору!" view-as alert-box.
     1619             return error .
     1620           end.
     1621           run FindBank .
     1622         end.
     1623         else do:
     1624           if num-cont <> b_fin-ob.contract-code then do:
     1625             message "Фин. обязательство № " b_fin-ob.prn-doc-code " (дата платежа " b_fin-ob.pay-date ") относится к другому договору, чем предыдущие док-ты!"
     1626             view-as alert-box.
     1627             return error .
     1628           end.
     1629           if pay-type <> b_fin-ob.payer-type or pay-code <> b_fin-ob.payer-code then do:
     1630             message "Плательщик в фин. обяз. № " b_fin-ob.prn-doc-code " (дата платежа " b_fin-ob.pay-date ") иной, чем в предыдущих док-тах! Продолжить? (В платеж будет прописан плательщик 1-го фин.обяз.)"
     1631             view-as alert-box QUESTION BUTTONS YES-NO UPDATE g-log .
     1632             if g-log = no then return error.
     1633           end.
     1634           if rec-type <> b_fin-ob.receiver-type or rec-code <> b_fin-ob.receiver-code then do:
     1635             message "Получатель в фин. обяз. № " b_fin-ob.prn-doc-code " (дата платежа " b_fin-ob.pay-date ") иной, чем в предыдущих док-тах! Продолжить? (В платеж будет прописан получатель 1-го фин.обяз.)"
     1636             view-as alert-box QUESTION BUTTONS YES-NO UPDATE g-log .
     1637             if g-log = no then return error.
     1638           end.
     1639           if obj-code <> 0 then do:
     1640             if obj-type <> b_fin-ob.obj-type or obj-code <> b_fin-ob.obj-code then assign obj-code = 0 .
     1641           end.
     1642           assign
     1643             tt-fin-doc.sum-base  = tt-fin-doc.sum-base  + b_fin-ob.sum-base     - b_fin-ob.con-sum-base
     1644             tt-fin-doc.sum-rubl  = tt-fin-doc.sum-rubl  + b_fin-ob.sum-rubl     - b_fin-ob.con-sum-rubl
     1645             tt-fin-doc.sum-contr = tt-fin-doc.sum-contr + b_fin-ob.sum-contract - b_fin-ob.con-sum-contr
     1646             tt-fin-doc.sum-doc   = tt-fin-doc.sum-doc   + b_fin-ob.sum-doc      - b_fin-ob.con-sum-doc
     1647             p-koef-rubl          = ( b_fin-ob.sum-rubl     - b_fin-ob.con-sum-rubl ) / b_fin-ob.sum-rubl
     1648             p-koef-base          = ( b_fin-ob.sum-rubl     - b_fin-ob.con-sum-base ) / b_fin-ob.sum-rubl
     1649             p-koef-cont          = ( b_fin-ob.sum-contract - b_fin-ob.con-sum-contr) / b_fin-ob.sum-contract
     1650             p-koef-doc           = ( b_fin-ob.sum-doc      - b_fin-ob.con-sum-doc  ) / b_fin-ob.sum-doc
     1651           .
     1652         end.
     1653         for each ub.fin-ob-tax no-lock where ub.fin-ob-tax.host-code = p-host-code and ub.fin-ob-tax.doc-code = b_fin-ob.doc-code :
     1654           find first tt0-fin-doc-tax
     1655             where tt0-fin-doc-tax.vat-pc   = ub.fin-ob-tax.vat-pc
     1656               and tt0-fin-doc-tax.slt-pc   = ub.fin-ob-tax.slt-pc
     1657               and tt0-fin-doc-tax.with-vat = ub.fin-ob-tax.with-vat
     1658               and tt0-fin-doc-tax.with-slt = ub.fin-ob-tax.with-slt
     1659           no-error .
     1660           if not available tt0-fin-doc-tax then do:
     1661             create tt0-fin-doc-tax .
     1662             BUFFER-COPY ub.fin-ob-tax TO tt0-fin-doc-tax .
     1663             assign
     1664               tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     1665               tt0-fin-doc-tax.host-code    = p-host-code
     1666               tt0-fin-doc-tax.line-num     = line
     1667               line = line + 1
     1668               tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-doc       * p-koef-doc
     1669               tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-doc   * p-koef-doc
     1670               tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-doc   * p-koef-doc
     1671               tt0-fin-doc-tax.sum-line-rubl      = tt0-fin-doc-tax.sum-line-rubl      * p-koef-rubl
     1672               tt0-fin-doc-tax.sum-vat-line-rubl  = tt0-fin-doc-tax.sum-vat-line-rubl  * p-koef-rubl
     1673               tt0-fin-doc-tax.sum-slt-line-rubl  = tt0-fin-doc-tax.sum-slt-line-rubl  * p-koef-rubl
     1674               tt0-fin-doc-tax.sum-line-base      = tt0-fin-doc-tax.sum-line-base      * p-koef-base
     1675               tt0-fin-doc-tax.sum-vat-line-base  = tt0-fin-doc-tax.sum-vat-line-base  * p-koef-base
     1676               tt0-fin-doc-tax.sum-slt-line-base  = tt0-fin-doc-tax.sum-slt-line-base  * p-koef-base
     1677               tt0-fin-doc-tax.sum-line-contr     = tt0-fin-doc-tax.sum-line-contr     * p-koef-cont
     1678               tt0-fin-doc-tax.sum-vat-line-contr = tt0-fin-doc-tax.sum-vat-line-contr * p-koef-cont
     1679               tt0-fin-doc-tax.sum-slt-line-contr = tt0-fin-doc-tax.sum-slt-line-contr * p-koef-cont
     1680             .
     1681           end.
     1682           else do:
     1683             assign
     1684               tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-doc       + ub.fin-ob-tax.sum-line-doc       * p-koef-doc
     1685               tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-doc   + ub.fin-ob-tax.sum-vat-line-doc   * p-koef-doc
     1686               tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-doc   + ub.fin-ob-tax.sum-slt-line-doc   * p-koef-doc
     1687               tt0-fin-doc-tax.sum-line-rubl      = tt0-fin-doc-tax.sum-line-rubl      + ub.fin-ob-tax.sum-line-rubl      * p-koef-rubl
     1688               tt0-fin-doc-tax.sum-vat-line-rubl  = tt0-fin-doc-tax.sum-vat-line-rubl  + ub.fin-ob-tax.sum-vat-line-rubl  * p-koef-rubl
     1689               tt0-fin-doc-tax.sum-slt-line-rubl  = tt0-fin-doc-tax.sum-slt-line-rubl  + ub.fin-ob-tax.sum-slt-line-rubl  * p-koef-rubl
     1690               tt0-fin-doc-tax.sum-line-base      = tt0-fin-doc-tax.sum-line-base      + ub.fin-ob-tax.sum-line-base      * p-koef-base
     1691               tt0-fin-doc-tax.sum-vat-line-base  = tt0-fin-doc-tax.sum-vat-line-base  + ub.fin-ob-tax.sum-vat-line-base  * p-koef-base
     1692               tt0-fin-doc-tax.sum-slt-line-base  = tt0-fin-doc-tax.sum-slt-line-base  + ub.fin-ob-tax.sum-slt-line-base  * p-koef-base
     1693               tt0-fin-doc-tax.sum-line-contr     = tt0-fin-doc-tax.sum-line-contr     + ub.fin-ob-tax.sum-line-contr     * p-koef-cont
     1694               tt0-fin-doc-tax.sum-vat-line-contr = tt0-fin-doc-tax.sum-vat-line-contr + ub.fin-ob-tax.sum-vat-line-contr * p-koef-cont
     1695               tt0-fin-doc-tax.sum-slt-line-contr = tt0-fin-doc-tax.sum-slt-line-contr + ub.fin-ob-tax.sum-slt-line-contr * p-koef-cont
     1696             .
     1697           end.
     1698         end.
     1699       end.
     1700       if obj-code <> 0 then do:
     1701         assign
     1702           tt-fin-doc.obj-type = obj-type
     1703           tt-fin-doc.obj-code = obj-code
     1704         .
     1705       end.
     1706       else do:
     1707         if ub.sysconf.fin-calc = 1 then do:
     1708           message
     1709             substitute ("По фирме &1 ведется раздельный учет по объектам с поставщиками. Нельзя создать платеж по ФО с разных объектов.",sysconf.host-code)
     1710           view-as alert-box.
     1711           return error .
     1712         end.
     1713       end.
     1714       assign
     1715         tt-fin-doc.base-rate       = if tt-fin-doc.sum-base  <> 0 then tt-fin-doc.sum-rubl * tt-fin-doc.base-scale / tt-fin-doc.sum-base      else 0
     1716         tt-fin-doc.contract-rate   = if tt-fin-doc.sum-contr <> 0 then tt-fin-doc.sum-rubl * tt-fin-doc.contract-scale / tt-fin-doc.sum-contr else 0
     1717         tt-fin-doc.exch-rate       = if tt-fin-doc.sum-doc   <> 0 then tt-fin-doc.sum-rubl * tt-fin-doc.exch-scale / tt-fin-doc.sum-doc       else 0
     1718       .
     1719       if not available b1_fin-schet or not available b2_fin-schet then do:
     1720         if buf_contract.pay-nal = no then do:
     1721           message  "Не найден счет плательщика или получателя."   view-as alert-box.
     1722           return error .
     1723         end.
     1724       end.
     1725       else do:
     1726         find first ub.currency no-lock where ub.currency.curr-code = b2_fin-schet.curr-code .
     1727         assign  curr-rc = ub.currency.curr-abbr  .
     1728         if buf_contract.pay-nal = no then do:
     1729           assign
     1730             curr = ub.currency.curr-abbr
     1731             tt-fin-doc.curr-code = b2_fin-schet.curr-code
     1732           .
     1733           case b2_fin-schet.curr-code :
     1734             when 0 then do:
     1735               assign tt-fin-doc.sum-doc = tt-fin-doc.sum-rubl .
     1736               for each tt0-fin-doc-tax no-lock :
     1737                 assign
     1738                   tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-rubl
     1739                   tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-rubl
     1740                   tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-rubl
     1741                 .
     1742               end.
     1743             end.
     1744             when v-curr-r-b then do:
     1745               assign tt-fin-doc.sum-doc = tt-fin-doc.sum-base .
     1746               for each tt0-fin-doc-tax no-lock :
     1747                 assign
     1748                   tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-base
     1749                   tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-base
     1750                   tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-base
     1751                 .
     1752               end.
     1753             end.
     1754             when buf_contract.curr-code then do:
     1755               assign tt-fin-doc.sum-doc = tt-fin-doc.sum-contr .
     1756               for each tt0-fin-doc-tax no-lock :
     1757                 assign
     1758                   tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-contr
     1759                   tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-contr
     1760                   tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-contr
     1761                 .
     1762               end.
     1763             end.
     1764             otherwise do:
     1765   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1766   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1767     (input  b2_fin-schet.curr-code
     1768     ,input  today
     1769     ,output tt-fin-doc.exch-rate
     1770     ,output tt-fin-doc.exch-scale
     1771     ,output curr-rc
     1772     )  .
     1773               assign
     1774                 is-full-sum = no
     1775                 tt-fin-doc.sum-doc = tt-fin-doc.sum-rubl * tt-fin-doc.exch-scale / tt-fin-doc.exch-rate
     1776               .
     1777             end.
     1778           end.
     1779         end.
     1780       end.
     1781       assign is-expense = yes .
     1782       if tt-fin-doc.sum-rubl < 0 then do:
     1783         assign is-expense = no .
     1784         run InvertCli .
     1785       end.
     1786       for each tt0-fin-doc-tax :   if tt0-fin-doc-tax.sum-line-doc < 0 then assign is-full-sum = no .   end.
     1787       if is-full-sum = no then do:
     1788         run CorrectNalog in this-procedure .
     1789       end.
     1790       run RoundTax in this-procedure .
     1791       if buf_contract.pay-nal = no then do:
     1792         run StrTax (input-output sss) .
     1793         assign tt-fin-doc.naznach-plat = tt-fin-doc.naznach-plat + "@" + sss .
     1794       end.
     1795       else if buf_contract.pay-nal = yes then do:
     1796         run StrTax (input-output tt-fin-doc.including) .
     1797       end.
     1798     end.
     1799   END PROCEDURE.
     1800   define variable vss-include-info9 as character format "X(65)" no-undo
     1801   initial "@(#)$Workfile$ $Revision$".
     1802   PROCEDURE StrTax :
     1803     do
     1804     on error undo, return error return-value
     1805     :
     1806       define input-output parameter str as character no-undo .
     1807       assign str = " В т.ч.: "  .
     1808       for each tt0-fin-doc-tax :
     1809         if tt0-fin-doc-tax.with-vat = no then next.
     1810         if str <> " В т.ч.: " then str = str + "," .
     1811         if tt-fin-doc.curr-code = 0 then
     1812           assign str = str + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " руб. (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     1813         else
     1814           assign str = str + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     1815       end.
     1816       if str = " В т.ч.: " then assign str = "" .
     1817     end.
     1818   END PROCEDURE.
     1819   PROCEDURE InvertCli :
     1820     do
     1821     on error undo, return error return-value
     1822     :
     1823         define variable payer-bank-name    like ub.fin-doc.payer-bank-name  .
     1824         define variable payer-bank-city    like ub.fin-doc.payer-bank-city  .
     1825         define variable payer-bik          like ub.fin-doc.payer-bik        .
     1826         define variable payer-c-schet      like ub.fin-doc.payer-c-schet    .
     1827         define variable payer-code         like ub.fin-doc.payer-code       .
     1828         define variable payer-code-schet   like ub.fin-doc.payer-code-schet .
     1829         define variable payer-inn          like ub.fin-doc.payer-inn        .
     1830         define variable payer-kpp          like ub.fin-doc.payer-kpp        .
     1831         define variable payer-name         like ub.fin-doc.payer-name       .
     1832         define variable payer-okpo         like ub.fin-doc.payer-okpo       .
     1833         define variable payer-passport     like ub.fin-doc.payer-passport   .
     1834         define variable payer-r-schet      like ub.fin-doc.payer-r-schet    .
     1835         define variable payer-type         like ub.fin-doc.payer-type       .
     1836         assign
     1837           tt-fin-doc.sum-rubl  = - tt-fin-doc.sum-rubl
     1838           tt-fin-doc.sum-base  = - tt-fin-doc.sum-base
     1839           tt-fin-doc.sum-doc   = - tt-fin-doc.sum-doc
     1840           tt-fin-doc.sum-contr = - tt-fin-doc.sum-contr
     1841           payer-bank-name      = tt-fin-doc.payer-bank-name
     1842           payer-bank-city      = tt-fin-doc.payer-bank-city
     1843           payer-bik            = tt-fin-doc.payer-bik
     1844           payer-c-schet        = tt-fin-doc.payer-c-schet
     1845           payer-code           = tt-fin-doc.payer-code
     1846           payer-code-schet     = tt-fin-doc.payer-code-schet
     1847           payer-inn            = tt-fin-doc.payer-inn
     1848           payer-kpp            = tt-fin-doc.payer-kpp
     1849           payer-name           = tt-fin-doc.payer-name
     1850           payer-okpo           = tt-fin-doc.payer-okpo
     1851           payer-passport       = tt-fin-doc.payer-passport
     1852           payer-r-schet        = tt-fin-doc.payer-r-schet
     1853           payer-type           = tt-fin-doc.payer-type
     1854           tt-fin-doc.payer-bank-name    = tt-fin-doc.receiver-bank-name
     1855           tt-fin-doc.payer-bank-city    = tt-fin-doc.receiver-bank-city
     1856           tt-fin-doc.payer-bik          = tt-fin-doc.receiver-bik
     1857           tt-fin-doc.payer-c-schet      = tt-fin-doc.receiver-c-schet
     1858           tt-fin-doc.payer-code         = tt-fin-doc.receiver-code
     1859           tt-fin-doc.payer-code-schet   = tt-fin-doc.receiver-code-schet
     1860           tt-fin-doc.payer-inn          = tt-fin-doc.receiver-inn
     1861           tt-fin-doc.payer-kpp          = tt-fin-doc.receiver-kpp
     1862           tt-fin-doc.payer-name         = tt-fin-doc.receiver-name
     1863           tt-fin-doc.payer-okpo         = tt-fin-doc.receiver-okpo
     1864           tt-fin-doc.payer-passport     = tt-fin-doc.receiver-passport
     1865           tt-fin-doc.payer-r-schet      = tt-fin-doc.receiver-r-schet
     1866           tt-fin-doc.payer-type         = tt-fin-doc.receiver-type
     1867           tt-fin-doc.receiver-bank-name =  payer-bank-name
     1868           tt-fin-doc.receiver-bank-city =  payer-bank-city
     1869           tt-fin-doc.receiver-bik       =  payer-bik
     1870           tt-fin-doc.receiver-c-schet   =  payer-c-schet
     1871           tt-fin-doc.receiver-code      =  payer-code
     1872           tt-fin-doc.receiver-code-schet = payer-code-schet
     1873           tt-fin-doc.receiver-inn       =  payer-inn
     1874           tt-fin-doc.receiver-kpp       =  payer-kpp
     1875           tt-fin-doc.receiver-name      =  payer-name
     1876           tt-fin-doc.receiver-okpo      =  payer-okpo
     1877           tt-fin-doc.receiver-passport  =  payer-passport
     1878           tt-fin-doc.receiver-r-schet   =  payer-r-schet
     1879           tt-fin-doc.receiver-type      =  payer-type
     1880         .
     1881         for each  tt0-fin-doc-tax no-lock :
     1882           assign
     1883             tt0-fin-doc-tax.sum-line-doc       = - tt0-fin-doc-tax.sum-line-doc
     1884             tt0-fin-doc-tax.sum-vat-line-doc   = - tt0-fin-doc-tax.sum-vat-line-doc
     1885             tt0-fin-doc-tax.sum-slt-line-doc   = - tt0-fin-doc-tax.sum-slt-line-doc
     1886             tt0-fin-doc-tax.sum-line-rubl      = - tt0-fin-doc-tax.sum-line-rubl
     1887             tt0-fin-doc-tax.sum-vat-line-rubl  = - tt0-fin-doc-tax.sum-vat-line-rubl
     1888             tt0-fin-doc-tax.sum-slt-line-rubl  = - tt0-fin-doc-tax.sum-slt-line-rubl
     1889             tt0-fin-doc-tax.sum-line-base      = - tt0-fin-doc-tax.sum-line-base
     1890             tt0-fin-doc-tax.sum-vat-line-base  = - tt0-fin-doc-tax.sum-vat-line-base
     1891             tt0-fin-doc-tax.sum-slt-line-base  = - tt0-fin-doc-tax.sum-slt-line-base
     1892             tt0-fin-doc-tax.sum-line-contr     = - tt0-fin-doc-tax.sum-line-contr
     1893             tt0-fin-doc-tax.sum-vat-line-contr = - tt0-fin-doc-tax.sum-vat-line-contr
     1894             tt0-fin-doc-tax.sum-slt-line-contr = - tt0-fin-doc-tax.sum-slt-line-contr
     1895           .
     1896         end.
     1897     end.
     1898   END PROCEDURE.
     1899   PROCEDURE CheckCli :
     1900     do
     1901     on error undo, return error return-value
     1902     :
     1903       if tt-fin-doc.payer-code = p-host-code and tt-fin-doc.payer-type = 'орг':U then do:
     1904         assign
     1905           tt-fin-doc.payer-bik        = buf_contract.own-bik
     1906           tt-fin-doc.payer-code-schet = buf_contract.own-code-schet
     1907           tt-fin-doc.payer-inn        = buf_contract.own-inn
     1908           tt-fin-doc.payer-kpp        = buf_contract.own-kpp
     1909         .
     1910         if tt-fin-doc.receiver-code = buf_contract.cli-code and tt-fin-doc.receiver-type = buf_contract.cli-type then do:
     1911           assign
     1912             tt-fin-doc.receiver-bik        = buf_contract.cli-bik
     1913             tt-fin-doc.receiver-code-schet = buf_contract.cli-code-schet
     1914             tt-fin-doc.receiver-inn        = buf_contract.cli-inn
     1915             tt-fin-doc.receiver-kpp        = buf_contract.cli-kpp
     1916           .
     1917         end.
     1918         else do:
     1919           if tt-fin-doc.receiver-code = buf_contract.posr-code and tt-fin-doc.receiver-type = buf_contract.posr-type then do:
     1920             assign
     1921               tt-fin-doc.receiver-bik        = buf_contract.posr-bik
     1922               tt-fin-doc.receiver-code-schet = buf_contract.posr-code-schet
     1923               tt-fin-doc.receiver-inn        = buf_contract.posr-inn
     1924               tt-fin-doc.receiver-kpp        = buf_contract.posr-kpp
     1925             .
     1926           end.
     1927           else do:
     1928             assign
     1929               tt-fin-doc.receiver-bik        = buf_contract.agnt-bik
     1930               tt-fin-doc.receiver-code-schet = buf_contract.agnt-code-schet
     1931               tt-fin-doc.receiver-inn        = buf_contract.agnt-inn
     1932               tt-fin-doc.receiver-kpp        = buf_contract.agnt-kpp
     1933             .
     1934           end.
     1935         end.
     1936       end.
     1937       else do:
     1938         if tt-fin-doc.receiver-code = p-host-code and tt-fin-doc.receiver-type = 'орг':U then do:
     1939           assign
     1940             tt-fin-doc.receiver-bik        = buf_contract.own-bik
     1941             tt-fin-doc.receiver-code-schet = buf_contract.own-code-schet
     1942             tt-fin-doc.receiver-inn        = buf_contract.own-inn
     1943             tt-fin-doc.receiver-kpp        = buf_contract.own-kpp
     1944           .
     1945           if tt-fin-doc.payer-code = buf_contract.cli-code and tt-fin-doc.payer-type = buf_contract.cli-type then do:
     1946             assign
     1947               tt-fin-doc.payer-bik        = buf_contract.cli-bik
     1948               tt-fin-doc.payer-code-schet = buf_contract.cli-code-schet
     1949               tt-fin-doc.payer-inn        = buf_contract.cli-inn
     1950               tt-fin-doc.payer-kpp        = buf_contract.cli-kpp
     1951             .
     1952           end.
     1953           else do:
     1954             if tt-fin-doc.payer-code = buf_contract.posr-code and tt-fin-doc.payer-type = buf_contract.posr-type then do:
     1955               assign
     1956                 tt-fin-doc.payer-bik        = buf_contract.posr-bik
     1957                 tt-fin-doc.payer-code-schet = buf_contract.posr-code-schet
     1958                 tt-fin-doc.payer-inn        = buf_contract.posr-inn
     1959                 tt-fin-doc.payer-kpp        = buf_contract.posr-kpp
     1960               .
     1961             end.
     1962             else do:
     1963               assign
     1964                 tt-fin-doc.payer-bik        = buf_contract.agnt-bik
     1965                 tt-fin-doc.payer-code-schet = buf_contract.agnt-code-schet
     1966                 tt-fin-doc.payer-inn        = buf_contract.agnt-inn
     1967                 tt-fin-doc.payer-kpp        = buf_contract.agnt-kpp
     1968               .
     1969             end.
     1970           end.
     1971         end.
     1972         else return error .
     1973       end.
     1974     end.
     1975   END PROCEDURE.
     1976   PROCEDURE UchetCode :
     1977     do
     1978     on error undo, return error return-value
     1979     :
     1980       case tt-fin-doc.fin-doc-type :
     1981         when 'пко':U then do:
     1982           assign
     1983             tt-fin-doc.cor-acc       = buf_contract.cor-acc-in-cash
     1984             tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-in-cash
     1985             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-in-cash
     1986             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-in-cash
     1987           .
     1988         end.
     1989         when 'рко':U then do:
     1990           assign
     1991             tt-fin-doc.cor-acc       = buf_contract.cor-acc-out-cash
     1992             tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-out-cash
     1993             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-out-cash
     1994             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-out-cash
     1995           .
     1996         end.
     1997         when 'ппп':U then do:
     1998           assign
     1999             tt-fin-doc.cor-acc       = buf_contract.cor-acc-in
     2000             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-in
     2001             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-in
     2002           .
     2003         end.
     2004         when 'рпп':U then do:
     2005           assign
     2006             tt-fin-doc.cor-acc       = buf_contract.cor-acc-out
     2007             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-out
     2008             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-out
     2009           .
     2010         end.
     2011         when 'апп':U then do:
     2012           assign
     2013             tt-fin-doc.cor-acc       = buf_contract.cor-acc-in-payoff
     2014             tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-in-payoff
     2015             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-in-payoff
     2016             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-in-payoff
     2017           .
     2018         end.
     2019         when 'апр':U then do:
     2020           assign
     2021             tt-fin-doc.cor-acc       = buf_contract.cor-acc-out-payoff
     2022             tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-out-payoff
     2023             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-out-payoff
     2024             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-out-payoff
     2025           .
     2026         end.
     2027       end.
     2028       find first ub.fin-code-cel-nazn no-lock where ub.fin-code-cel-nazn.host-code = p-host-code and ub.fin-code-cel-nazn.fin-code = tt-fin-doc.cel-nazn-code no-error .
     2029       if available ub.fin-code-cel-nazn then assign tt-fin-doc.cel-nazn-value = ub.fin-code-cel-nazn.code-value .
     2030       find first ub.fin-code-an-uchet no-lock where ub.fin-code-an-uchet.host-code = p-host-code and ub.fin-code-an-uchet.fin-code = tt-fin-doc.an-uchet-code no-error .
     2031       if available ub.fin-code-an-uchet then assign tt-fin-doc.an-uchet-value = ub.fin-code-an-uchet.code-value .
     2032       find first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.host-code = p-host-code and ub.fin-code-cor-acc.fin-code = tt-fin-doc.cor-acc no-error .
     2033       if available ub.fin-code-cor-acc then assign tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     2034       find first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.host-code = p-host-code and ub.fin-code-cor-acc.fin-code = tt-fin-doc.cor-acc1 no-error .
     2035       if available ub.fin-code-cor-acc then assign tt-fin-doc.cor-acc1-value = ub.fin-code-cor-acc.code-value .
     2036     end.
     2037   END PROCEDURE.
     2038   PROCEDURE FindBank :
     2039     do
     2040     on error undo, return error return-value
     2041     :
     2042     find first b1_fin-schet no-lock where b1_fin-schet.host-code = p-host-code and b1_fin-schet.code-schet = tt-fin-doc.receiver-code-schet no-error .
     2043     find first ub.fin-bank no-lock where ub.fin-bank.host-code = p-host-code and ub.fin-bank.code-bank = b1_fin-schet.code-bank no-error .
     2044     if available b1_fin-schet then
     2045     assign
     2046       tt-fin-doc.receiver-bank-name  = ub.fin-bank.bank-name
     2047       tt-fin-doc.receiver-bank-city  = ub.fin-bank.bank-city
     2048       tt-fin-doc.receiver-c-schet    = b1_fin-schet.c-schet
     2049       tt-fin-doc.receiver-r-schet    = b1_fin-schet.r-schet
     2050     .
     2051     find first b2_fin-schet no-lock where b2_fin-schet.host-code = p-host-code and b2_fin-schet.code-schet = tt-fin-doc.payer-code-schet no-error .
     2052     find first ub.fin-bank no-lock where ub.fin-bank.host-code = p-host-code and ub.fin-bank.code-bank = b2_fin-schet.code-bank no-error .
     2053     if available b2_fin-schet then
     2054     assign
     2055       tt-fin-doc.payer-bank-name  = ub.fin-bank.bank-name
     2056       tt-fin-doc.payer-bank-city  = ub.fin-bank.bank-city
     2057       tt-fin-doc.payer-c-schet    = b2_fin-schet.c-schet
     2058       tt-fin-doc.payer-r-schet    = b2_fin-schet.r-schet
     2059     .
     2060     end.
     2061   END PROCEDURE.
