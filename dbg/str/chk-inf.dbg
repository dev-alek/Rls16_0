        8   define input parameter p-doc-rec as recid no-undo .
        9   define output parameter v-notes as character no-undo .
       10   define output parameter not-all-saled-chk as logical init no.
       11   define output parameter not-all-normal-chk as logical init no.
       12   define output parameter not-all-inkas-closed as logical no-undo init no.
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: chk-inf.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: str/chk-inf.p $":U .
       18   define variable vss-description as character no-undo init "Информация по чекам и продажам".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define new global shared variable g#lib-trn  as handle no-undo .
       81   define new global shared variable g#lib-trn2 as handle no-undo .
       82   define new global shared variable g#lib-trn3 as handle no-undo .
       83   define new global shared variable g#lib-trn4 as handle no-undo .
       84   function shift-name-no-err return char (
       85                                           buffer loc-inkas for ub.inkas
       86    ).
       87   define variable varshift-name as character no-undo.
       88   define variable varshift-name-num as character no-undo.
       89     varshift-name = loc-inkas.shift-name.
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnme in g#lib-trn3 ( input  loc-inkas.obj-type,
       92                          input  loc-inkas.obj-code,
       93                          input  loc-inkas.shift-date,
       94                          input  loc-inkas.shift-num,
       95                          input-output varshift-name,
       96                          output varshift-name-num
       97                          ) no-error .
       98     if error-status:error then do:
       99       return "":u.
      100     end.
      101     return varshift-name-num.
      102   end function.
      103   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104     define variable v-cntxt-db-num        as integer   no-undo .
      105     define variable v-cntxt-userid        as character no-undo .
      106     define variable v-cntxt-level         as character no-undo .
      107     define variable v-cntxt-host-code-obj as integer   no-undo .
      108     define variable v-cntxt-obj-type      as character no-undo .
      109     define variable v-cntxt-obj-code      as integer   no-undo .
      110     define variable v-cntxt-db-num-obj    as integer   no-undo .
      111     define variable v-cntxt-is-admin      as logical   no-undo .
      112   define variable not-saled as char no-undo.
      113   define variable not-saled-err as char no-undo.
      114   define variable inkas-ch as char no-undo.
      115   define variable current-store-type like ub.inkas.obj-type no-undo.
      116   define variable current-store-code like ub.inkas.obj-code no-undo.
      117   define variable cas-shft as logical no-undo init no.
      118   define variable l-shift-on as logical no-undo init no.
      119   define variable conf-attr as char no-undo.
      120   define variable conf-par as char no-undo.
      121   define variable par-type as char no-undo.
      122   define variable chk-inf as logical no-undo init yes.
      123   define variable v-shift-str as character no-undo .
      124   define variable v-param-type as character no-undo .
      125   define variable v-value-character as character no-undo .
      126   define variable v-value-date as date no-undo .
      127   define variable v-value-decimal as decimal no-undo .
      128   define variable v-value-integer as INTEGER no-undo .
      129   define variable v-value-logical AS LOGICAL no-undo .
      130   define variable v-tth as handle no-undo .
      131   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   define variable v-waitfram-action01         as character   no-undo .
      133   define variable v-waitfram-action02         as character   no-undo .
      134   define variable v-waitfram-action03         as character   no-undo .
      135   define variable mWaitFramTextBeg            as character   no-undo.
      136   define variable mWaitFramTextEnd            as character   no-undo.
      137   define variable mWaitFramView               as logical     no-undo.
      138   define variable mWaitProcEvent              as logical     no-undo init yes.
      139   define variable mWaitFramInterval           as integer     no-undo init 1 .
      140   define variable mWaitFramStop               as logical     no-undo.
      141   define variable mWaitFramStopUser           as logical     no-undo.
      142   define variable mWaitFramStopTimeOut        as logical     no-undo.
      143   define variable mWaitFramStartProc          as datetime-tz no-undo.
      144   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      145   define button B-WaitFramStop auto-end-key
      146        label "Стоп"
      147        size 10 by 1 tooltip "Остоновить процесс".
      148   define button B-viewProcInfo
      149        label "Информация"
      150        size 15 by 1 tooltip "Информация о процесс".
      151   define frame waitfram
      152     v-waitfram-action01 format "x(72)" no-label skip
      153     v-waitfram-action02 format "x(72)" no-label skip
      154     v-waitfram-action03 format "x(72)" no-label skip
      155     B-viewProcInfo
      156     B-WaitFramStop at row 4 col 30
      157     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      158     .
      159   define new global shared variable mBatchMode as logical no-undo init ?.
      160   define variable mFramBachModHandle as handle no-undo.
      161   mFramBachModHandle = frame waitfram:handle.
      162   define variable mFameOldVis as logical no-undo.
      163   define variable mVisCUrentVin as logical no-undo.
      164   if session:batch-mode
      165   then
      166      mBatchMode = yes.
      167   if mBatchMode = ? then do:
      168     mVisCUrentVin = current-window:visible.
      169     mFameOldVis = mFramBachModHandle:visible.
      170     mFramBachModHandle:visible  = yes.
      171     mBatchMode = mFramBachModHandle:visible ne yes.
      172     mFramBachModHandle:visible = mFameOldVis.
      173     current-window:visible = mVisCUrentVin.
      174   end.
      175    if  log-manager:logfile-name ne ?
      176     then DO:
      177         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      178         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      179         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      180     end.
      181   on choose of B-WaitFramStop in frame waitfram
      182   do:
      183     mWaitFramStop = yes.
      184     mWaitFramStopUser = yes.
      185   end.
      186   function waitfram-check-timeout returns logical():
      187      define variable vtime as int64 no-undo.
      188      if mWaitFramStopTimeOut
      189      then
      190         return yes.
      191      vtime = ( now - mWaitFramStartProc ) / 1000 .
      192      if     mWaitFramTimeOut ne ?
      193         and mWaitFramTimeOut ne 0
      194         and mWaitFramTimeOut lt vtime
      195      then do:
      196         mWaitFramStopTimeOut = yes.
      197      end.
      198      return mWaitFramStopTimeOut.
      199   end.
      200   procedure waitfram-hide :
      201     if not session:batch-mode
      202     then do
      203     on error undo, return error return-value
      204     :
      205       pause 0 before-hide .
      206       if not mBatchMode then
      207         hide frame waitfram .
      208     if     not mWaitFramView
      209        and mWaitProcEvent
      210     then
      211       process events .
      212     end.
      213   end procedure.
      214   procedure waitfram-show :
      215     define input  parameter p-message as character no-undo .
      216     define variable v-left-margin as integer   no-undo .
      217     if not session:batch-mode
      218     then do
      219     on error undo, return error return-value
      220     :
      221       if length(p-message) <= 70 then do:
      222         assign
      223           v-left-margin = integer((70 - length(p-message)) / 2)
      224         .
      225         assign
      226           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      227         .
      228         assign
      229           v-waitfram-action01 = " "
      230           v-waitfram-action02 = " "
      231                                    + fill(" ", v-left-margin)
      232                                    + p-message
      233           v-waitfram-action03 = " "
      234         .
      235       end.
      236       else do:
      237         define variable vRindex1 as integer no-undo.
      238         define variable vRindex2 as integer no-undo.
      239         vRindex1 = r-index(p-message," ",70).
      240         if vRindex1 = 0
      241         then
      242            vRindex1 = 70.
      243         if length(p-message)  <= vRindex1 + 70 then do:
      244           assign
      245             v-waitfram-action01 = " "
      246             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      247             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      248           .
      249         end.
      250         else do:
      251           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      252           if vRindex2 <= vRindex1
      253           then
      254              vRindex2 = vRindex1 + 70.
      255           assign
      256             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      257             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      258             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      259           .
      260         end.
      261       end.
      262       B-viewProcInfo:visible   in frame waitfram = no.
      263       B-viewProcInfo:sensitive in frame waitfram = no.
      264       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      265       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      266       if  (   mWaitFramView
      267          or  mWaitProcEvent)
      268          and not mBatchMode
      269       then
      270          display
      271             v-waitfram-action01 skip
      272             v-waitfram-action02 skip
      273             v-waitfram-action03 skip
      274          with frame waitfram .
      275       if     mWaitFramView
      276          then do:
      277             if     mWaitFramInterval ne ?
      278                and not mBatchMode
      279             then
      280                wait-for go of frame waitfram pause mWaitFramInterval.
      281          end.
      282          else
      283             if     mWaitProcEvent
      284                and not mBatchMode
      285             then
      286                process events .
      287     end.
      288   end procedure.
      289      procedure waitfram-show-this:
      290         define input  parameter iInterval as int64 no-undo.
      291         define variable vtime as int64 no-undo.
      292         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      293         mWaitFramInterval = iInterval.
      294         run waitfram-show (substitute("&1&2 &3&4" ,
      295                                       mWaitFramTextBeg ,
      296                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      297                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      298                                       mWaitFramTextEnd
      299                                      )
      300                           ).
      301      end.
      302      procedure WaitFramRunPause:
      303         define input  parameter iInterval as dec no-undo.
      304         define variable vStart  as datetime-tz no-undo.
      305         define variable vend    as datetime-tz no-undo.
      306         define variable vint as int64 no-undo.
      307         define variable vOk as logical no-undo.
      308         vStart = now.
      309         vend   = vStart.
      310         publish "WaitFramPause" (iInterval,output vOk).
      311         vend   =  now.
      312         vint = vend - vStart.
      313         vint = iInterval - vint / 1000.
      314         if     not mWaitFramStop
      315            and (   vint > 0
      316                 or (    not vOk
      317                     and iInterval eq ?
      318                     )
      319                 )
      320         then
      321            run waitfram-show-this (iInterval).
      322         vend   =  now.
      323         vint = vend - vStart.
      324         vint = iInterval - vint / 1000.
      325         if     not mWaitFramStop
      326            and vint > 0
      327         then do:
      328            run gbl/pause.p (vint * 1000).
      329         end.
      330         if iInterval ne ?
      331         then
      332            publish "WaitFramStop".
      333         waitfram-check-timeout().
      334      end.
      335      procedure WaitFramWaitFor:
      336         define input  parameter iInterval as dec no-undo.
      337         assign
      338            mWaitFramStartProc   = now
      339            mWaitFramStopUser    = no
      340            mWaitFramStopTimeOut = no
      341         .
      342         block-wait:
      343         do while not mWaitFramStop:
      344            run WaitFramRunPause (iInterval).
      345            if  waitfram-check-timeout()
      346            then do:
      347               leave block-wait.
      348            end.
      349         end.
      350         run waitfram-hide.
      351      end.
      352   procedure waitfram-join :
      353     define input  parameter p-line-1  as character no-undo .
      354     define input  parameter p-line-2  as character no-undo .
      355     define input  parameter p-line-3  as character no-undo .
      356     define output parameter p-message as character no-undo .
      357     do
      358     on error undo, return error return-value
      359     :
      360       assign
      361         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      362                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      363                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      364       .
      365     end.
      366   end procedure.
      367   function waitfram-join-function returns character
      368     (input p-line-1 as character
      369     ,input p-line-2 as character
      370     ,input p-line-3 as character
      371     ).
      372     define variable v-message as character no-undo .
      373     run waitfram-join in this-procedure
      374       (input  p-line-1
      375       ,input  p-line-2
      376       ,input  p-line-3
      377       ,output v-message
      378       ) .
      379     return v-message .
      380   end function .
      381   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382     run mainmenu_getcntxt in parparentproc
      383       (output v-cntxt-db-num
      384       ,output v-cntxt-userid
      385       ,output v-cntxt-level
      386       ,output v-cntxt-host-code-obj
      387       ,output v-cntxt-obj-type
      388       ,output v-cntxt-obj-code
      389       ,output v-cntxt-db-num-obj
      390       ,output v-cntxt-is-admin
      391       ) .
      392   if v-cntxt-db-num-obj <> v-cntxt-db-num then do:
      393     message
      394     substitute("Нельзя получить информацию по чекам в чужой БД&1" +
      395                 "№ БД объекта &2, № текущей БД &3"
      396                 , chr(10)
      397                 , v-cntxt-db-num-obj
      398                 , v-cntxt-db-num)
      399     view-as alert-box error .
      400     return.
      401   end.
      402   run adm/shattri.p (
      403       input "get":U
      404       ,input  p-curr-obj-type
      405       ,input  p-curr-obj-code
      406       ,input  'chk-view':U
      407       ,input  'chk-inf':U
      408       ,output v-value-character
      409       ,output v-value-date
      410       ,output v-value-decimal
      411       ,output v-value-integer
      412       ,output v-value-logical
      413       ,output v-param-type
      414       ,INPUT-OUTPUT table-handle v-tth
      415       ) no-error .
      416   IF not error-status:error then
      417   assign
      418   chk-inf = v-value-logical.
      419   delete object v-tth.
      420   if not chk-inf and not interface and not from-ink then return.
      421   run waitfram-show in this-procedure ( input "Поиск ошибочных и неучтенных чеков. ЖДИТЕ...").
      422   v-notes = "".
      423   if from-ink then do:
      424       FIND FIRST ub.inkas No-LOCK WHERE recid(ub.inkas) = p-doc-rec No-ERROR.
      425       if not avail ub.inkas then do:
      426         message vss-workfile vss-revision vss-description skip
      427         "Не найдена запись inkas"
      428         view-as alert-box error .
      429         return error.
      430       end.
      431       assign
      432       current-store-type = ub.inkas.obj-type
      433       current-store-code = ub.inkas.obj-code
      434       .
      435       FIND FIRST ub.shop NO-LOCK WHERE
      436                  ub.shop.obj-code = ub.inkas.obj-code NO-ERROR.
      437   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   define variable v-param-type5 as character no-undo .
      439   define variable v-value-character5 as character no-undo .
      440   define variable v-value-date5 as date no-undo .
      441   define variable v-value-decimal5 as decimal no-undo .
      442   define variable v-value-integer5 as INTEGER no-undo .
      443   define variable v-tth5 as handle no-undo .
      444   run adm/shattri.p (
      445       input "get":U
      446       ,input  ub.inkas.obj-type
      447       ,input  ub.inkas.obj-code
      448       ,input  'get-chk':U
      449       ,input  'cas-shft':U
      450       ,output v-value-character5
      451       ,output v-value-date5
      452       ,output v-value-decimal5
      453       ,output v-value-integer5
      454       ,output cas-shft
      455       ,output v-param-type5
      456       ,INPUT-OUTPUT table-handle v-tth5
      457       )  .
      458   delete object v-tth5.
      459   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      460   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      461     (input  ub.inkas.obj-type
      462     ,input  ub.inkas.obj-code
      463     ,input  'shift-on=request'
      464     ,output l-shift-on
      465     )  .
      466   end.
      467   cas-shft = cas-shft OR l-shift-on.
      468   if from-ink then do:
      469     assign
      470     v-shift-str = substitute("&1 &2"
      471                             ,string(inkas.shift-date, "99/99/9999")
      472                             ,(if cas-shft
      473                               then (" СМЕНА " + shift-name-no-err(buffer inkas))
      474                               else "")).
      475     assign
      476     not-saled = substitute("НЕУЧТЕННЫХ ЧЕКОВ ЗА &1 НЕТ&2"
      477                            , v-shift-str
      478                            , chr(10))
      479     not-saled-err = substitute("ОШИБОЧНЫX чеков ЗА &1 НЕТ&2"
      480                                 ,v-shift-str
      481                                 ,chr(10))
      482     inkas-ch = "Нет НЕЗАКРЫТЫХ продаж" + CHr(10)
      483     .
      484     if chk-inf then do:
      485       For each  ub.chk-doc where
      486                 ub.chk-doc.obj-type = current-store-type and
      487                 ub.chk-doc.obj-code = current-store-code and
      488                 ub.chk-doc.out-code = ?
      489       by ub.chk-doc.chk-date descending
      490       by ub.chk-doc.chk-time descending:
      491       if ((NOT cas-shft)  AND ub.shop.day-only AND ub.chk-doc.shift-date = ub.inkas.shift-date) OR
      492         (( cas-shft and ub.shop.day-only) AND
      493           ub.chk-doc.shift-date = ub.inkas.shift-date AND
      494           ub.chk-doc.shift-num = ub.inkas.shift-num) OR
      495         (NOT ub.shop.day-only AND NOT cas-shft)
      496       then do:
      497         assign
      498         not-saled =  substitute("Есть НЕУЧТЕННЫЙ чек за &1&2"
      499                                       ,string (chk-doc.shift-date, "99/99/9999")
      500                                       ,chr(10))
      501         not-all-saled-chk = yes.
      502       end.
      503       if NOT ub.chk-doc.correct then do:
      504         assign
      505         not-saled-err =   substitute("Есть ОШИБОЧНЫЙ чек за &1&2"
      506                                     ,string (chk-doc.shift-date, "99/99/9999")
      507                                     ,chr(10))
      508         not-all-normal-chk = yes
      509         .
      510       end.
      511       not-saled = substitute("Есть НЕУЧТЕННЫЙ чек за &1&2&2"
      512                             ,string (chk-doc.shift-date, "99/99/9999")
      513                             ,chr(10))
      514       .
      515       end.
      516     end.
      517   end.
      518   else do:
      519   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      520   define variable v-param-type7 as character no-undo .
      521   define variable v-value-character7 as character no-undo .
      522   define variable v-value-date7 as date no-undo .
      523   define variable v-value-decimal7 as decimal no-undo .
      524   define variable v-value-integer7 as INTEGER no-undo .
      525   define variable v-tth7 as handle no-undo .
      526   run adm/shattri.p (
      527       input "get":U
      528       ,input  p-curr-obj-type
      529       ,input  p-curr-obj-code
      530       ,input  'get-chk':U
      531       ,input  'cas-shft':U
      532       ,output v-value-character7
      533       ,output v-value-date7
      534       ,output v-value-decimal7
      535       ,output v-value-integer7
      536       ,output cas-shft
      537       ,output v-param-type7
      538       ,INPUT-OUTPUT table-handle v-tth7
      539       ) no-error .
      540   delete object v-tth7.
      541     IF not error-status:error then
      542     assign
      543     cas-shft = (conf-par = "yes").
      544   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      546     (input  p-curr-obj-type
      547     ,input  p-curr-obj-code
      548     ,input  'shift-on=request'
      549     ,output l-shift-on
      550     )  .
      551   cas-shft = cas-shft OR l-shift-on.
      552     find first ub.inkas no-lock where
      553             ub.inkas.obj-type = p-curr-obj-type AND
      554             ub.inkas.obj-code = p-curr-obj-code AND
      555             ub.inkas.status_ = 'новый':U use-index obj-stat no-error.
      556     if available ub.inkas then do:
      557           not-all-inkas-closed = yes.
      558         end.
      559     assign
      560     not-saled = "НЕУЧТЕННЫХ ЧЕКОВ НЕТ" + chr(10)
      561     not-saled-err =   "ОШИБОЧНЫX чеков НЕТ " + chr (10)
      562     inkas-ch = "Нет НЕЗАКРЫТЫХ продаж" + CHr(10)
      563     .
      564     FIND FIRST ub.shop NO-LOCK WHERE
      565                ub.shop.obj-code = p-curr-obj-code NO-ERROR.
      566     For each  ub.chk-doc no-lock  where
      567               ub.chk-doc.obj-type = p-curr-obj-type AND
      568               ub.chk-doc.obj-code = p-curr-obj-code AND
      569               ub.chk-doc.out-code = ?
      570         by ub.chk-doc.chk-date
      571         by ub.chk-doc.chk-time :
      572       if NOT not-all-saled-chk  AND
      573         (
      574           NOT not-all-inkas-closed OR
      575           (NOT cas-shft AND
      576             (  (not-all-inkas-closed AND shop.day-only AND chk-doc.shift-date = inkas.shift-date) OR
      577                 (not-all-inkas-closed AND (NOT shop.day-only)  )
      578             )
      579           )  OR
      580           (cas-shft AND (not-all-inkas-closed AND inkas.shift-date = chk-doc.shift-date)
      581           )
      582         ) then do:
      583         assign
      584         not-all-saled-chk = yes
      585         not-saled = substitute("Самый старый НЕУЧТЕННЫЙ чек за : &1&2"
      586                                   ,string (chk-doc.shift-date, "99/99/9999")
      587                                   ,chr(10))
      588         .
      589       end.
      590       if NOT not-all-normal-chk
      591       AND chk-doc.correct <> yes then do:
      592         assign
      593         not-all-normal-chk = yes
      594         not-saled-err = substitute("Самый старый ОШИБОЧНЫЙ чек за : &1&2&2"
      595                                   ,string (chk-doc.shift-date, "99/99/9999")
      596                                   ,chr(10))
      597        .
      598       end.
      599       not-saled = substitute("Самый старый НЕУЧТЕННЫЙ чек за : &1&2&2"
      600                             ,string (chk-doc.shift-date, "99/99/9999")
      601                             ,chr(10))
      602       .
      603     end.
      604   end.
      605   for each inkas No-LOCK WHERE
      606            inkas.obj-type = p-curr-obj-type AND
      607            inkas.obj-code = p-curr-obj-code AND
      608            inkas.status_ = 'факт':U
      609   by inkas.doc-date descending:
      610     if inkas.status_ = 'факт':U then do:
      611       inkas-ch = substitute("Дата последней закрытой продажи : &1&2&2"
      612                               ,string (inkas.fact-date, "99/99/9999")
      613                              , chr(10)).
      614       leave.
      615     end.
      616   end.
      617   v-notes = v-notes + not-saled +
      618           (if not-all-normal-chk then not-saled-err else "") +
      619           (if not-all-saled-chk then not-saled else "") + inkas-ch.
      620   run waitfram-hide in this-procedure .
      621   if interface then
      622   run gbl/showtext.p (
      623                    input "Неучтенные и ошибочные чеки, последние закрытые продажи"
      624                   ,input 60
      625                   ,input 15
      626                   ,input v-notes
      627                   ).
