     1756   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1757                                             INPUT iFlagEmpty AS INTEGER).
     1758       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1759       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1760           DO:
     1761               IF iFlagEmpty = 0                           THEN RETURN "".
     1762               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1763               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1764               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1765               ELSE RETURN "".
     1766           END.
     1767       ELSE DO:
     1768           run xmlchar-encode in this-procedure (
     1769                 input sToPlace
     1770               , output sToPlace
     1771           ).
     1772           ASSIGN
     1773               sToPlace = sParName + '="' + sToPlace + '"'
     1774           .
     1775           RETURN sToPlace.
     1776       END.
     1777   END FUNCTION.
     1778   function bge-xml-date returns character
     1779   ( input p-date as date )
     1780   :
     1781     define variable v-date-str as character no-undo .
     1782     run bge-xml-date-to-str in this-procedure ( input   p-date
     1783                                               , output  v-date-str
     1784                                               ) .
     1785     return v-date-str.
     1786   end function.
     1787   function bge-xml-str-date returns character
     1788   ( input p-date-str as character )
     1789   :
     1790     define variable v-date-str as character no-undo .
     1791     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1792                                                   , output  v-date-str
     1793                                                   ) .
     1794     return v-date-str.
     1795   end function.
     1796   function bge-xml-normalize-dec returns decimal
     1797   ( input p-val as decimal )
     1798   :
     1799     return (if p-val = ? then 0 else p-val) .
     1800   end function.
     1801   PROCEDURE wp-XMLTagOpen:
     1802   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1803   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1804   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1805       define variable v-out-string    as character    no-undo.
     1806   do
     1807   on error undo, return error
     1808   :
     1809       if v-bge-xml-bgefmt = "dbf":U
     1810       then do:
     1811       end.
     1812       else do:
     1813           assign
     1814               v-out-string = substitute( "&1&2<&3&4>"
     1815                                       , chr(10)
     1816                                       , fill( " ":U, 4 * iTagLevel)
     1817                                       , sTagName
     1818                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1819                               )
     1820           .
     1821           put stream stmXMLOut unformatted
     1822               v-out-string
     1823           .
     1824       end.
     1825   end.
     1826   END PROCEDURE.
     1827   PROCEDURE wp-XMLTagPut:
     1828     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1829     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1830     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1831     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1832       define variable v-out-string    as character    no-undo.
     1833   do
     1834   on error undo, return error
     1835   :
     1836       if v-bge-xml-bgefmt = "dbf":U
     1837       then do:
     1838           if v-bge-xml-dbf-file-name <> "":U
     1839           then do:
     1840               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1841               export stream stmXMLOut
     1842                   sTagName
     1843                   sParValue
     1844               .
     1845               output stream stmXMLOut close.
     1846           end.
     1847       end.
     1848       else do:
     1849           IF  iFlagEmpty = 1
     1850           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1851           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1852           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1853           THEN DO:
     1854               run xmlchar-encode in this-procedure (
     1855                   input sParValue
     1856                   , output sParValue
     1857               ).
     1858               assign
     1859                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1860                                               , chr(10)
     1861                                               , FILL(" ", 4 * iTagLevel)
     1862                                               , sTagName
     1863                                               , sParValue
     1864                               )
     1865               .
     1866               PUT STREAM stmXMLOut UNFORMATTED
     1867                   v-out-string
     1868               .
     1869           END.
     1870       end.
     1871   end.
     1872   END PROCEDURE.
     1873   PROCEDURE wp-XMLTagClose:
     1874   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1875   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1876       define variable v-out-string    as character    no-undo.
     1877   do
     1878   on error undo, return error
     1879   :
     1880       if v-bge-xml-bgefmt = "dbf":U
     1881       then do:
     1882       end.
     1883       else do:
     1884           assign
     1885               v-out-string = substitute( "&1&2</&3>"
     1886                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1887                                   , fill( " ", 4 * iTagLevel )
     1888                                   , sTagName
     1889                           )
     1890           .
     1891           PUT STREAM stmXMLOut UNFORMATTED
     1892               v-out-string
     1893           .
     1894       end.
     1895   end.
     1896   END PROCEDURE.
     1897   PROCEDURE wp-XMLWriteLog:
     1898     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1899     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1900     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1901   define variable v-str              as character no-undo .
     1902   define variable v-error-append     as logical   no-undo .
     1903   define variable v-error-append-msg as character no-undo .
     1904   assign
     1905     v-str = chr(10)
     1906             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1907             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1908     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1909     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1910     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1911   .
     1912   run bge/bge-log.p (input v-str) no-error .
     1913   if error-status:error then do:
     1914     assign
     1915       v-error-append     = yes
     1916       v-error-append-msg = return-value
     1917     .
     1918   end.
     1919   run gbl/fileapnd.p
     1920     ( input sFileName
     1921     , input v-str
     1922     , input 10
     1923     ) no-error .
     1924   if error-status:error then do:
     1925     assign
     1926       v-error-append     = yes
     1927       v-error-append-msg = substitute( "&1&2&3"
     1928                                       , v-error-append-msg
     1929                                       , chr(10)
     1930                                       , return-value
     1931                                       )
     1932     .
     1933   end.
     1934   if v-error-append
     1935   then do:
     1936     return error substitute( "&1" , v-error-append-msg ) .
     1937   end.
     1938   END PROCEDURE.
     1939   PROCEDURE wp-XMLWriteEDT:
     1940     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1941     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1942     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1943       if valid-handle ( hEDT )
     1944       then do:
     1945           hEDT :move-to-eof().
     1946           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1947                                           OR sToWrite = "&Line") THEN "" ELSE
     1948                                           cur-time-string-sec() + " ").
     1949           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1950                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1951                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1952           hEDT :insert-string(chr(10)).
     1953       end.
     1954       process events.
     1955       output to 'bgescn.txt' append.
     1956           put unformatted
     1957               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1958                                           OR sToWrite = "&Line") THEN "" ELSE
     1959                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1960               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1961                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1962                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1963           .
     1964       output close.
     1965   END PROCEDURE.
     1966   PROCEDURE wp-XMLShowCNT:
     1967     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1968       if valid-handle( hCNT )
     1969       then do:
     1970           ASSIGN hCNT :VISIBLE = TRUE.
     1971       end.
     1972   END PROCEDURE.
     1973   PROCEDURE wp-XMLHideCNT:
     1974     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1975       if valid-handle( hCNT )
     1976       then do:
     1977           ASSIGN hCNT :VISIBLE = FALSE.
     1978       end.
     1979   END PROCEDURE.
     1980   PROCEDURE wp-XMLWriteCNT:
     1981     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1982     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1983       if valid-handle( hCNT )
     1984       then do:
     1985           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1986       end.
     1987   END PROCEDURE.
     1988   procedure bge-xml-write-header:
     1989   do
     1990   on error undo, return error
     1991   :
     1992   define input parameter p-xml-file-name  as character        no-undo.
     1993   define input parameter p-doc-name       as character        no-undo.
     1994   define input parameter p-version        as character        no-undo.
     1995   define input parameter p-db-num         as integer          no-undo.
     1996   define input parameter p-date-from      as date             no-undo.
     1997   define input parameter p-shift-num-from as integer          no-undo.
     1998   define input parameter p-date-to        as date             no-undo.
     1999   define input parameter p-shift-num-to   as integer          no-undo.
     2000   define input parameter p-obj-list       as character        no-undo.
     2001   define input parameter p-doc-type-list  as character        no-undo.
     2002   define input parameter p-pay-code       as logical          no-undo.
     2003   define input parameter p-cst            as logical          no-undo.
     2004   define input parameter p-parts          as logical          no-undo.
     2005   define input parameter p-chk-pay-code   as logical          no-undo.
     2006   define input parameter p-pay-desk       as logical          no-undo.
     2007   define input parameter p-pay-desk-cards as logical          no-undo.
     2008   define input parameter p-deleted        as logical          no-undo.
     2009   define input parameter p-opened-docs    as logical          no-undo.
     2010   define variable v-out-string    as character    no-undo.
     2011   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     2012   assign
     2013       v-out-string = substitute( "&1&2&3"
     2014                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     2015                           , chr(10)
     2016                           , "<IBS_Trade_House>":U )
     2017   .
     2018   put stream stmXMLOut unformatted
     2019       v-out-string
     2020   .
     2021   run wp-XMLTagOpen(1, "header","").
     2022   if v-bge-xml-bgeflold = "oracle":u
     2023   then do:
     2024     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2025     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2026     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2027     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2028     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2029   end.
     2030   run wp-XMLTagOpen( 2, "manifest", "").
     2031   run wp-XMLTagOpen( 3, "document", "").
     2032   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     2033   run wp-XMLTagput( 4, "description", "", 0).
     2034   run wp-XMLTagput( 4, "version", p-version, 0).
     2035   run wp-XMLTagclose( 3, "document" ).
     2036   run wp-XMLTagclose( 2, "manifest" ).
     2037   run wp-XMLTagclose( 1, "header" ).
     2038   run wp-XMLTagOpen(1, "options","").
     2039   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     2040   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     2041   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     2042   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     2043   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     2044   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     2045   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     2046   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     2047   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     2048   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     2049   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     2050   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     2051   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     2052   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     2053   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     2054   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     2055   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     2056   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     2057   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     2058   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     2059   run wp-XMLTagClose(1, "options").
     2060   run wp-XMLTagOpen( 1, "body", "" ).
     2061   output stream stmXMLOut close.
     2062   end.
     2063   end procedure.
     2064   procedure xml-bge-write-footer:
     2065   do
     2066   on error undo, return error return-value
     2067   :
     2068   define input parameter p-xml-file-name as character    no-undo.
     2069   define variable v-error-num     as integer           no-undo.
     2070   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2071   run wp-XMLTagClose( 1, "body" ).
     2072   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     2073   output stream stmXMLOut close.
     2074   if v-bge-xml-bgeflold = "oracle":u
     2075   then do:
     2076     define variable v-tmp-file-name         as character no-undo .
     2077     define variable v-zip-file-name         as character no-undo .
     2078     define variable v-exch-file-name        as character no-undo .
     2079     define variable v-heap-file-name        as character no-undo .
     2080     define variable v-i                     as integer   no-undo .
     2081     define variable v-file-name             as character no-undo .
     2082     define variable v-arc                   as character no-undo .
     2083     define variable v-str                   as character no-undo .
     2084     define variable v-exch-tmp-file-name    as character no-undo .
     2085     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     2086     define variable v-bge-xml-exch-dir      as character no-undo .
     2087     define variable v-bge-xml-heap-dir      as character no-undo .
     2088     define variable v-bge-xml-compress-heap as logical   no-undo .
     2089     define variable v-home-dir              as character no-undo .
     2090     define variable v-os-command            as character no-undo .
     2091     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2092     if v-home-dir = ?
     2093     then do:
     2094       undo, return error substitute( "&1&2&3"
     2095                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     2096                                     , chr(10)
     2097                                     , "Обратитесь к администратору.":u
     2098                                     ).
     2099     end.
     2100     assign
     2101       v-home-dir = v-home-dir
     2102     .
     2103     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2104     if error-status :error
     2105     then do:
     2106       undo, return error substitute( "&1&2&3"
     2107                                     , "Неверно задан каталог экспорта.":u
     2108                                     , chr(10)
     2109                                     , "Обратитесь к администратору.":u
     2110                                     ).
     2111     end.
     2112     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     2113     if v-bge-xml-exch-dir = ?
     2114     then do:
     2115       undo, return error substitute( "&1&2&3"
     2116                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     2117                                     , chr(10)
     2118                                     , "Обратитесь к администратору.":u
     2119                                     ).
     2120     end.
     2121     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     2122     if error-status :error
     2123     then do:
     2124       undo, return error substitute( "&1&2&3"
     2125                                     , "Неверно задан каталог экспорта (exch).":u
     2126                                     , chr(10)
     2127                                     , "Обратитесь к администратору.":u
     2128                                     ).
     2129     end.
     2130     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     2131     if v-bge-xml-heap-dir = ?
     2132     then do:
     2133       undo, return error substitute( "&1&2&3"
     2134                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     2135                                     , chr(10)
     2136                                     , "Обратитесь к администратору.":u
     2137                                     ).
     2138     end.
     2139     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     2140     if error-status :error
     2141     then do:
     2142       undo, return error substitute( "&1&2&3"
     2143                                     , "Неверно задан каталог экспорта (heap).":u
     2144                                     , chr(10)
     2145                                     , "Обратитесь к администратору.":u
     2146                                     ).
     2147     end.
     2148     get-key-value section "BGE" key "heap-compress" value v-str.
     2149     assign
     2150       v-i = int(v-str)
     2151     no-error .
     2152     if v-i = ? or v-i = 0
     2153     then do:
     2154       assign
     2155         v-bge-xml-compress-heap = no
     2156       .
     2157     end.
     2158     else do:
     2159       assign
     2160         v-bge-xml-compress-heap = yes
     2161       .
     2162     end.
     2163     assign
     2164       v-arc = search( "exe/7za.exe":u )
     2165     .
     2166     if v-arc = ? or v-arc = ""
     2167     then do:
     2168       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     2169     end.
     2170     assign
     2171       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     2172       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     2173       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     2174       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     2175       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     2176       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     2177       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     2178     .
     2179     run gbl/del-file.p (input v-tmp-file-name) .
     2180     run gbl/del-file.p (input v-zip-file-name) .
     2181     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     2182     if v-error-num > 0
     2183     then do:
     2184         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     2185                                      , p-xml-file-name + "xm1":u
     2186                                      , v-tmp-file-name
     2187                                      , v-error-num
     2188                                      ).
     2189     end.
     2190     assign
     2191       v-os-command     = substitute( "&1 a -tzip &2 &3"
     2192                                    , v-arc
     2193                                    , v-zip-file-name
     2194                                    , v-tmp-file-name
     2195                                    )
     2196     .
     2197     os-command silent value ( v-os-command ) .
     2198     run gbl/del-file.p (input v-heap-file-name) .
     2199     if v-bge-xml-compress-heap = no
     2200     then do:
     2201       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     2202       if v-error-num > 0
     2203       then do:
     2204           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2205                                        , v-tmp-file-name
     2206                                        , v-heap-file-name
     2207                                        , v-error-num
     2208                                        ) .
     2209       end.
     2210     end.
     2211     else do:
     2212       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     2213       if v-error-num > 0
     2214       then do:
     2215           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2216                                        , v-zip-file-name
     2217                                        , v-heap-file-name
     2218                                        , v-error-num
     2219                                        ) .
     2220       end.
     2221     end.
     2222     run gbl/del-file.p (input v-tmp-file-name) .
     2223     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     2224     if error-status :error then do:
     2225       undo, return error substitute( "&1&2&3"
     2226                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     2227                                     , chr(10)
     2228                                     , "Обратитесь к администратору."
     2229                                     ).
     2230     end.
     2231     run gbl/del-file.p (input v-exch-file-name) .
     2232     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     2233     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     2234     if v-error-num > 0
     2235     then do:
     2236       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2237                                     , v-zip-file-name
     2238                                     , v-exch-tmp-file-name
     2239                                     , v-error-num
     2240                                     ) .
     2241     end.
     2242     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     2243     if v-error-num > 0
     2244     then do:
     2245       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2246                                     , v-exch-tmp-file-name
     2247                                     , v-exch-file-name
     2248                                     , v-error-num
     2249                                     ) .
     2250     end.
     2251     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     2252   end.
     2253   else do:
     2254     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2255     if v-error-num > 0
     2256     then do:
     2257       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2258                                     , p-xml-file-name + "xm1"
     2259                                     , p-xml-file-name + "xml"
     2260                                     , v-error-num
     2261                                     ) .
     2262     end.
     2263   end.
     2264   if opsys = "unix"
     2265   then do:
     2266       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2267   end.
     2268   end.
     2269   end procedure.
     2270   procedure xml-bge-filename0:
     2271   define input parameter p-prefix   as character no-undo .
     2272   define input parameter p-name     as character no-undo .
     2273   define input parameter p-shared-process as logical no-undo .
     2274   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     2275   define output parameter p-xml-file-name  as character no-undo .
     2276   // define output parameter p-fullfnamenoext as character no-undo .
     2277   define output parameter p-locked         as logical      no-undo.
     2278   define variable v-fullfnamenoext as character no-undo .
     2279   define variable v-fileext        as character no-undo .
     2280   define variable v-fullfname      as character no-undo .
     2281   define variable v-error-num      as integer   no-undo .
     2282   do
     2283   on error undo, return error
     2284   :
     2285     case v-bge-xml-bgeflold :
     2286       when "old" then do:
     2287         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     2288         v-fileext       = ".xml":U .
     2289         v-fullfname     = v-fullfnamenoext + v-fileext .
     2290         p-xml-file-name = v-fullfname .
     2291         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     2292         if v-error-num > 0 then do:
     2293           return error.
     2294         end.
     2295       end.
     2296       when "var" then do:
     2297         case p-prefix :
     2298           when "doc" then do:
     2299             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     2300             v-fileext       = ".xml":U .
     2301             v-fullfname     = v-fullfnamenoext + v-fileext .
     2302             p-xml-file-name = v-fullfname .
     2303           end.
     2304           when "day" then do:
     2305             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     2306             v-fileext       = ".xml":U .
     2307             v-fullfname     = v-fullfnamenoext + v-fileext .
     2308             p-xml-file-name = v-fullfname .
     2309           end.
     2310           otherwise do:
     2311             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     2312             v-fileext       = ".xml":U .
     2313             v-fullfname     = v-fullfnamenoext + v-fileext .
     2314             p-xml-file-name = v-fullfname .
     2315           end.
     2316         end case.
     2317         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     2318         if v-error-num > 0 then do:
     2319           return error.
     2320         end.
     2321       end.
     2322       when "new" then do:
     2323                   run bge/genfname.p (
     2324                       input p-home-dir
     2325                       , input p-prefix
     2326                       , input ""
     2327                       , input "xml"
     2328                       , input ""
     2329                       , output p-xml-file-name
     2330                   ).
     2331       end.
     2332       when "no-parameter" then do:
     2333         if p-shared-process then do:
     2334                       run bge/genfname.p (
     2335                           input p-home-dir
     2336                           , input "d"
     2337                           , input ""
     2338                           , input "xml"
     2339                           , input ""
     2340                           , output p-xml-file-name
     2341                       ).
     2342         end.
     2343         else do:
     2344           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     2345           v-fileext       = ".xml":U .
     2346           v-fullfname     = v-fullfnamenoext + v-fileext .
     2347           p-xml-file-name = v-fullfname .
     2348           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     2349           if v-error-num > 0 then do:
     2350             return error.
     2351           end.
     2352         end.
     2353       end.
     2354     end case.
     2355     assign
     2356       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2357       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     2358     .
     2359   end .
     2360   end procedure .
     2361   procedure xml-bge-filename :
     2362   do
     2363   on error undo, return error
     2364   :
     2365   define input parameter p-prefix             as character    no-undo.
     2366   define input parameter p-name               as character    no-undo.
     2367   define input parameter p-shared-process     as logical      no-undo.
     2368   define output parameter p-xml-file-name     as character    no-undo.
     2369   define output parameter p-log-file-name     as character    no-undo.
     2370   define output parameter p-locked            as logical      no-undo.
     2371   define variable v-home-dir          as character no-undo .
     2372   define variable v-error-num         as integer   no-undo .
     2373   define variable v-bge-xml-heap-dir  as character no-undo .
     2374       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2375       if v-home-dir = ?
     2376       then do:
     2377           message
     2378             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2379             skip(1)
     2380             skip "Обратитесь к администратору."
     2381           view-as alert-box error.
     2382           undo, return error .
     2383       end.
     2384       if v-bge-xml-bgeflold <> "oracle"
     2385       then do:
     2386         assign
     2387             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     2388         .
     2389       end.
     2390       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2391       if error-status :error
     2392       then do:
     2393           message
     2394             skip "Неверно задан каталог экспорта."
     2395             skip(1)
     2396             skip "Обратитесь к администратору."
     2397           view-as alert-box error.
     2398           undo, return error .
     2399       end.
     2400       if v-bge-xml-bgefmt = "dbf":U
     2401       then do:
     2402           assign
     2403               p-xml-file-name = v-home-dir
     2404               p-locked        = no
     2405           .
     2406       end.
     2407       else do:
     2408           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     2409             output p-xml-file-name, output p-locked) .
     2410       end.
     2411       if v-bge-xml-bgeflold = "oracle"
     2412       then do:
     2413         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     2414         if v-bge-xml-heap-dir = ?
     2415         then do:
     2416           undo, return error substitute( "&1&2&3"
     2417                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     2418                                         , chr(10)
     2419                                         , "Обратитесь к администратору.":u
     2420                                         ).
     2421         end.
     2422         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     2423         if error-status :error
     2424         then do:
     2425           undo, return error substitute( "&1&2&3"
     2426                                         , "Неверно задан каталог экспорта (heap).":u
     2427                                         , chr(10)
     2428                                         , "Обратитесь к администратору.":u
     2429                                         ).
     2430         end.
     2431         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     2432           assign
     2433             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     2434           .
     2435         end.
     2436         else do:
     2437           assign
     2438             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     2439           .
     2440         end.
     2441       end.
     2442       else do:
     2443         assign
     2444             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     2445         .
     2446       end.
     2447       assign
     2448          v-bge-xml-static-log-file-name = p-log-file-name
     2449       .
     2450   end.
     2451   end procedure.
     2452   procedure bge-xml-read-config :
     2453   do
     2454   on error undo, return error return-value
     2455   :
     2456   define input  parameter p-last-date as date      no-undo .
     2457   define input  parameter p-db-num    as integer   no-undo .
     2458       define variable v-bgeclall      as character     no-undo.
     2459       define variable v-bgedict       as character     no-undo.
     2460       define variable v-bgeshift      as character     no-undo.
     2461       define variable v-par-type      as character     no-undo.
     2462       define variable v-bgeflnm       as character     no-undo.
     2463       define variable v-bgecliiv      as character     no-undo .
     2464       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     2465       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     2466       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     2467       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     2468       define variable v-db-num-str    as character     no-undo .
     2469       define variable v-param-type      as character  no-undo .
     2470       define variable v-value-character as character  no-undo .
     2471       define variable v-value-date      as date       no-undo .
     2472       define variable v-value-decimal   as decimal    no-undo .
     2473       define variable v-value-integer   as integer    no-undo .
     2474       define variable v-value-logical   as logical    no-undo .
     2475       define variable v-tth             as handle      no-undo .
     2476       run adm/shattri.p ( input "get":U
     2477                         , input  '':u
     2478                         , input  0
     2479                         , input  'bge-export':U
     2480                         , input  'bgeclall':U
     2481                         , output v-bgecliiv
     2482                         , output v-value-date
     2483                         , output v-value-decimal
     2484                         , output v-value-integer
     2485                         , output v-value-logical
     2486                         , output v-param-type
     2487                         , input-output table-handle v-tth
     2488                         ) no-error .
     2489       if error-status :error
     2490       then do:
     2491         assign
     2492           v-bge-xml-bgecliiv = no
     2493         .
     2494       end.
     2495       else do:
     2496         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     2497       end.
     2498       delete object v-tth.
     2499       assign
     2500           v-bge-xml-bgeclall = no
     2501           v-bge-xml-bgedict  = no
     2502       .
     2503       run adm/shattri.p ( input "get":U
     2504                         , input  '':u
     2505                         , input  0
     2506                         , input  'bge-export':U
     2507                         , input  'bgeclall':U
     2508                         , output v-value-character
     2509                         , output v-value-date
     2510                         , output v-value-decimal
     2511                         , output v-value-integer
     2512                         , output v-value-logical
     2513                         , output v-param-type
     2514                         , input-output table-handle v-tth
     2515                         ) no-error .
     2516       if error-status :error
     2517       then do:
     2518         assign
     2519           v-bge-xml-bgeclall = no
     2520         .
     2521       end.
     2522       else do:
     2523         assign
     2524           v-bge-xml-bgeclall = v-value-logical
     2525         .
     2526       end.
     2527       delete object v-tth.
     2528       run adm/shattri.p ( input "get":U
     2529                         , input  '':u
     2530                         , input  0
     2531                         , input  'bge-export':U
     2532                         , input  'bgedict':U
     2533                         , output v-value-character
     2534                         , output v-value-date
     2535                         , output v-value-decimal
     2536                         , output v-value-integer
     2537                         , output v-value-logical
     2538                         , output v-param-type
     2539                         , input-output table-handle v-tth
     2540                         ) no-error .
     2541       if error-status :error
     2542       then do:
     2543         assign
     2544           v-bge-xml-bgedict = no
     2545         .
     2546       end.
     2547       else do:
     2548         assign
     2549           v-bge-xml-bgedict = v-value-logical
     2550         .
     2551       end.
     2552       delete object v-tth.
     2553       run adm/shattri.p ( input "get":U
     2554                         , input  '':u
     2555                         , input  0
     2556                         , input  'bge-export':U
     2557                         , input  'bgefmt':U
     2558                         , output v-value-character
     2559                         , output v-value-date
     2560                         , output v-value-decimal
     2561                         , output v-value-integer
     2562                         , output v-value-logical
     2563                         , output v-param-type
     2564                         , input-output table-handle v-tth
     2565                         ) no-error .
     2566       if error-status :error
     2567       then do:
     2568         assign
     2569           v-bge-xml-bgefmt  = "xml":U
     2570         .
     2571       end.
     2572       else do:
     2573         assign
     2574           v-bge-xml-bgefmt  = v-value-character
     2575         .
     2576       end.
     2577       delete object v-tth.
     2578       run adm/shattri.p ( input "get":U
     2579                         , input  '':u
     2580                         , input  0
     2581                         , input  'bge-export':U
     2582                         , input  'bgeshift':U
     2583                         , output v-value-character
     2584                         , output v-value-date
     2585                         , output v-value-decimal
     2586                         , output v-value-integer
     2587                         , output v-value-logical
     2588                         , output v-param-type
     2589                         , input-output table-handle v-tth
     2590                         ) no-error .
     2591       if error-status :error
     2592       then do:
     2593         assign
     2594             v-bge-xml-shift-mode = no
     2595         .
     2596       end.
     2597       else do:
     2598         assign
     2599             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     2600         .
     2601       end.
     2602       delete object v-tth.
     2603       run adm/shattri.p ( input "get":U
     2604                         , input  '':u
     2605                         , input  0
     2606                         , input  'bge-export':U
     2607                         , input  'bgeflold':U
     2608                         , output v-value-character
     2609                         , output v-value-date
     2610                         , output v-value-decimal
     2611                         , output v-value-integer
     2612                         , output v-value-logical
     2613                         , output v-param-type
     2614                         , input-output table-handle v-tth
     2615                         ) no-error .
     2616       if error-status :error
     2617       then do:
     2618         assign
     2619           v-bge-xml-bgeflold = "no-parameter":U
     2620         .
     2621       end.
     2622       else do:
     2623         assign
     2624           v-bge-xml-bgeflold  = v-value-character
     2625         .
     2626       end.
     2627       delete object v-tth.
     2628       assign
     2629         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     2630         v-bge-xml-db-num-str  = v-db-num-str
     2631       .
     2632       if p-last-date <> ?
     2633       then do:
     2634           run adm/shattri.p ( input "get":U
     2635                             , input  '':u
     2636                             , input  0
     2637                             , input  'bge-export':U
     2638                             , input  'bgeflnm':U
     2639                             , output v-value-character
     2640                             , output v-value-date
     2641                             , output v-value-decimal
     2642                             , output v-value-integer
     2643                             , output v-value-logical
     2644                             , output v-param-type
     2645                             , input-output table-handle v-tth
     2646                             ) no-error .
     2647           if error-status :error
     2648           then do:
     2649             assign
     2650               v-bgeflnm = '':U
     2651             .
     2652           end.
     2653           else do:
     2654             assign
     2655               v-bgeflnm = v-value-character
     2656             .
     2657           end.
     2658           delete object v-tth.
     2659           if v-bge-xml-bgeflold = "var"
     2660           then do:
     2661               if v-bgeflnm = ?
     2662               or num-entries( v-bgeflnm ) < 2
     2663               then do:
     2664                   assign
     2665                       v-bge-xml-bgeflold = "new"
     2666                   .
     2667               end.
     2668               else do:
     2669                   assign
     2670                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     2671                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     2672                   .
     2673                   assign
     2674                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     2675                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     2676                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2677                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     2678                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2679                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2680                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2681                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2682                   .
     2683               end.
     2684           end.
     2685       end.
     2686   end.
     2687   end procedure.
     2688   procedure bge-xml-get-ref-filename :
     2689   define input parameter p-in-file-name       as character        no-undo.
     2690   define output parameter p-home-dir          as character        no-undo.
     2691   define output parameter p-out-file-name     as character        no-undo.
     2692   define output parameter p-locked            as logical          no-undo.
     2693       define variable v-counter       as integer      no-undo.
     2694       define variable v-error-level   as integer      no-undo.
     2695   do
     2696   on error undo, return error
     2697   :
     2698       run bge/bge-ini.p (
     2699             input "bge"
     2700           , output p-home-dir
     2701       ).
     2702       if return-value <> "OK"
     2703       then do:
     2704           undo, return error.
     2705       end.
     2706       assign
     2707           p-home-dir = p-home-dir + "\dict":U
     2708       .
     2709       run bge/dir_cd.p (
     2710           input p-home-dir
     2711           , input "CA"
     2712       ).
     2713       if return-value = "ERROR"
     2714       then do:
     2715           undo, return error.
     2716       end.
     2717       assign
     2718           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2719       .
     2720       assign
     2721           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2722       .
     2723       wait-lock:
     2724       do v-counter = 1 TO 3
     2725       :
     2726           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2727           if p-locked = no
     2728           then do:
     2729               leave wait-lock.
     2730           end.
     2731           else do:
     2732               readkey pause 1.
     2733           end.
     2734       END.
     2735       if p-locked = yes
     2736       then do:
     2737           undo, return error.
     2738       end.
     2739       run bge/os_copy.p (
     2740             input "D":U
     2741           , input p-out-file-name + "xml":U
     2742           , input "":U
     2743           , output v-error-level
     2744       ).
     2745       if v-error-level > 0
     2746       then do:
     2747           undo, return error.
     2748       end.
     2749   end.
     2750   end procedure.
     2751   procedure bge-xml-write-ref-header :
     2752   define input parameter p-bge-name as character        no-undo.
     2753   define input parameter p-file-name as character        no-undo.
     2754       define variable v-out-string    as character    no-undo.
     2755   do
     2756   on error undo, return error
     2757   :
     2758       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2759       put stream stmXMLOut unformatted
     2760           "<?xml version='1.0' encoding='windows-1251'?>":U
     2761       .
     2762       assign
     2763           v-out-string = substitute( "&1&2"
     2764                               , chr(10)
     2765                               , "<IBS_Trade_House>":U )
     2766       .
     2767       put stream stmXMLOut unformatted
     2768           v-out-string
     2769       .
     2770       run wp-XMLTagOpen( 1, "header", "" ).
     2771       if v-bge-xml-bgeflold = "oracle":u
     2772       then do:
     2773         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2774         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2775         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2776         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2777         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2778       end.
     2779       else do:
     2780         run wp-XMLTagOpen( 2, "delivery", "" ).
     2781         run wp-XMLTagOpen( 3, "to", "" ).
     2782         run wp-XMLTagClose( 3, "to" ).
     2783         run wp-XMLTagOpen( 3, "from", "" ).
     2784         run wp-XMLTagClose( 3, "from" ).
     2785         run wp-XMLTagClose( 2, "delivery" ).
     2786       end.
     2787       run wp-XMLTagOpen( 2, "manifest", "" ).
     2788       run wp-XMLTagOpen( 3, "document", "" ).
     2789       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2790       run wp-XMLTagPut( 4, "description", "", 0 ).
     2791       run wp-XMLTagClose( 3, "document" ).
     2792       run wp-XMLTagClose( 2, "manifest" ).
     2793       run wp-XMLTagClose( 1, "header" ).
     2794       run wp-XMLTagOpen( 1, "body", "" ).
     2795   end.
     2796   end procedure.
     2797   procedure bge-xml-write-ref-footer :
     2798   define input parameter p-file-name as character        no-undo.
     2799       define variable v-error-level   as integer      no-undo.
     2800   do
     2801   on error undo, return error
     2802   :
     2803       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2804       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2805       output stream stmXMLOut close.
     2806       run bge/os_copy.p (
     2807             input "M":U
     2808           , input p-file-name + "xm1":U
     2809           , input p-file-name + "xml":U
     2810           , output v-error-level
     2811       ).
     2812       if v-error-level > 0
     2813       then do:
     2814           undo, return error.
     2815       end.
     2816   end.
     2817   end procedure.
     2818   procedure bge-xml-out-dir :
     2819   define output parameter p-out-dir       as character    no-undo.
     2820   define output parameter p-log-file-name as character    no-undo.
     2821   do
     2822   on error undo, return error
     2823   :
     2824       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2825       if p-out-dir = ?
     2826       then do:
     2827           message
     2828             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2829                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2830             skip(1)
     2831             skip "Обратитесь к администратору."
     2832           view-as alert-box error.
     2833           undo, return error .
     2834       end.
     2835       if v-bge-xml-bgeflold <> "oracle" then assign
     2836         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2837       .
     2838       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2839       if error-status :error  then do:
     2840           run wp-XMLWriteLog in this-procedure (
     2841                 input p-log-file-name
     2842               , input 0
     2843               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2844                                   , p-out-dir
     2845                                   , return-value
     2846                                   , trim( error-status :get-message( 1 ) )
     2847                                   )
     2848           ).
     2849           undo, return error.
     2850       end.
     2851       assign
     2852           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2853           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2854       .
     2855   end.
     2856   end procedure.
     2857   procedure bge-xml-out-dir2 :
     2858   define output parameter p-out-dir       as character    no-undo.
     2859   define output parameter p-out-dirR      as character    no-undo.
     2860   define output parameter p-log-file-name as character    no-undo.
     2861   do
     2862   on error undo, return error
     2863   :
     2864       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2865       if p-out-dir = ?
     2866       then do:
     2867           message
     2868             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2869                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2870             skip(1)
     2871             skip "Обратитесь к администратору."
     2872           view-as alert-box error.
     2873           undo, return error .
     2874       end.
     2875       if v-bge-xml-bgeflold <> "oracle" then assign
     2876             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2877             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2878         .
     2879       else p-out-dirR = p-out-dir .
     2880       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2881       if error-status :error  then do:
     2882           run wp-XMLWriteLog in this-procedure (
     2883                 input p-log-file-name
     2884               , input 0
     2885               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2886                                   , p-out-dir
     2887                                   , return-value
     2888                                   , error-status :get-message( 1 )
     2889                                   )
     2890           ).
     2891           undo, return error.
     2892       end.
     2893       if p-out-dirR <> p-out-dir then do:
     2894         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2895         if error-status :error then do:
     2896           run wp-XMLWriteLog in this-procedure (
     2897                 input p-log-file-name
     2898               , input 0
     2899               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2900                                   , p-out-dirR
     2901                                   , return-value
     2902                                   , error-status :get-message( 1 )
     2903                                   )
     2904           ).
     2905           p-out-dirR = p-out-dir .
     2906         end.
     2907       end .
     2908       assign
     2909         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2910         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2911       .
     2912   end.
     2913   end procedure.
     2914   procedure bge-xml-out-file :
     2915   do
     2916   on error undo, return error
     2917   :
     2918   define input parameter p-out-dir            as character        no-undo.
     2919   define input parameter p-prefix             as character        no-undo.
     2920   define input parameter p-sheduled           as logical          no-undo.
     2921   define output parameter p-xml-file-name     as character        no-undo.
     2922   define output parameter p-locked            as logical          no-undo.
     2923   define variable v-home-dir      as character     no-undo.
     2924   define variable v-error-num     as integer       no-undo.
     2925   define variable v-today             as date         no-undo.
     2926   define variable v-time              as integer      no-undo.
     2927       if v-bge-xml-bgefmt = "dbf":U
     2928       then do:
     2929           assign
     2930               p-xml-file-name = p-out-dir
     2931               p-locked        = no
     2932           .
     2933       end.
     2934       else do:
     2935           if v-bge-xml-bgeflold = "firm":U
     2936           then do:
     2937               run bge/genfname.p (
     2938                     input p-out-dir
     2939                   , input p-prefix
     2940                   , input "":U
     2941                   , input "arj":U
     2942                   , input "":U
     2943                   , output p-xml-file-name
     2944               ).
     2945           end.
     2946           else do:
     2947               run bge/genfname.p (
     2948                     input p-out-dir
     2949                   , input p-prefix
     2950                   , input "":U
     2951                   , input "xml":U
     2952                   , input "":U
     2953                   , output p-xml-file-name
     2954               ).
     2955           end.
     2956           assign
     2957               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2958               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2959           .
     2960       end.
     2961   end.
     2962   end procedure.
     2963   procedure bge-xml-init-ext-doc-type :
     2964       define variable v-counter    as integer      no-undo.
     2965       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2966   do
     2967   for buf_temp_ext-doc-type
     2968   on error undo, return error
     2969   :
     2970       empty temp-table buf_temp_ext-doc-type.
     2971       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2972       :
     2973           create buf_temp_ext-doc-type.
     2974           assign
     2975               buf_temp_ext-doc-type.edt-key               = v-counter
     2976               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2977               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2978           .
     2979       end.
     2980   end.
     2981   end procedure.
     2982   procedure bge-xml-get-decimal-shift-num :
     2983   define input parameter p-shift-date     as date             no-undo.
     2984   define input parameter p-shift-num      as integer          no-undo.
     2985   define output parameter p-shift-decimal as decimal          no-undo.
     2986   do
     2987   on error undo, return error
     2988   :
     2989       assign
     2990           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2991       .
     2992   end.
     2993   end procedure.
     2994   procedure bge-xml-ora-exp-filename :
     2995     define input  parameter p-table-name  as character no-undo .
     2996     define input  parameter p-doc-code    as character no-undo .
     2997     define input  parameter p-obj-code    as integer   no-undo .
     2998     define output parameter p-filename    as character no-undo .
     2999     define output parameter p-seq-num     as integer   no-undo .
     3000     define variable v-ora-exp-seq     as integer   no-undo .
     3001     define variable v-ora-exp-seq-str as character no-undo .
     3002     define variable v-home-dir        as character no-undo.
     3003   do
     3004   on error undo, return error return-value
     3005   :
     3006     if v-bge-xml-bgeflold = "oracle":u
     3007     then do:
     3008       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     3009       if v-home-dir = ?
     3010       then do:
     3011         undo, return error substitute( "&1&2&3":U
     3012                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     3013                                       , chr(10)
     3014                                       , "Обратитесь к администратору.":U
     3015                                       ).
     3016       end.
     3017       assign
     3018           v-home-dir = v-home-dir
     3019       .
     3020       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     3021       if error-status :error
     3022       then do:
     3023         undo, return error substitute( "&1&2&3":U
     3024                                       , "Неверно задан каталог экспорта.":U
     3025                                       , chr(10)
     3026                                       , "Обратитесь к администратору.":U
     3027                                       ).
     3028       end.
     3029       assign
     3030         v-ora-exp-seq = ?
     3031       .
     3032       if  p-table-name <> ? and
     3033           p-doc-code <> ?
     3034       then do:
     3035         run bge/get-oesq.p ( input p-table-name
     3036                            , input p-doc-code
     3037                            , output v-ora-exp-seq
     3038                            ) no-error .
     3039         if error-status :error = yes
     3040         then do:
     3041           undo, return error return-value .
     3042         end.
     3043       end.
     3044       if v-ora-exp-seq = ?
     3045       then do:
     3046         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     3047         if error-status :error
     3048         then do:
     3049           undo, return error return-value .
     3050         end.
     3051       end.
     3052       if p-table-name <> ? and
     3053          p-doc-code   <> ?
     3054       then do:
     3055         run bge/oesqdoc.p ( input p-table-name
     3056                           , input p-doc-code
     3057                           , input v-ora-exp-seq
     3058                           ) no-error .
     3059         if error-status :error = yes
     3060         then do:
     3061           undo, return error return-value .
     3062         end.
     3063       end.
     3064       assign
     3065         p-seq-num  = v-ora-exp-seq
     3066         p-filename = substitute("&1/&2-000_&3."
     3067                                , v-home-dir
     3068                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     3069                                , string(v-ora-exp-seq , "999999999")
     3070                                )
     3071       .
     3072     end.
     3073   end.
     3074   end procedure.
     3075   procedure bge-xml-date-to-str :
     3076     define input  parameter p-date  as date      no-undo .
     3077     define output parameter p-str   as character no-undo .
     3078   do
     3079   on error undo, return error return-value
     3080   :
     3081     if p-date <> ?
     3082     then do:
     3083       assign
     3084         p-str = substitute( "&1-&2-&3"
     3085                           , string( year(p-date)  , "9999")
     3086                           , string( month(p-date) , "99"  )
     3087                           , string( day(p-date)   , "99"  )
     3088                           )
     3089       .
     3090     end.
     3091     else do:
     3092       assign
     3093         p-str = ?
     3094       .
     3095     end.
     3096   end.
     3097   end procedure.
     3098   procedure bge-xml-date-str-to-str :
     3099     define input  parameter p-date-str  as character no-undo .
     3100     define output parameter p-str       as character no-undo .
     3101     define variable v-date          as date      no-undo .
     3102     define variable v-date-valid    as logical   no-undo .
     3103     define variable v-error-message as character no-undo .
     3104   do
     3105   on error undo, return error return-value
     3106   :
     3107     assign
     3108       p-str = ?
     3109     .
     3110     if p-date-str = ? or p-date-str = ""
     3111     then do:
     3112       return .
     3113     end.
     3114     run strtdate in this-procedure ( input  p-date-str
     3115                                    , output v-date
     3116                                    , output v-date-valid
     3117                                    , output v-error-message
     3118                                    ).
     3119     if v-date-valid <> true
     3120     then do:
     3121       return .
     3122     end.
     3123     assign
     3124       p-str = substitute( "&1-&2-&3"
     3125                         , string( year(v-date)  , "9999")
     3126                         , string( month(v-date) , "99"  )
     3127                         , string( day(v-date)   , "99"  )
     3128                         )
     3129     .
     3130   end.
     3131   end procedure.
     3132   procedure bge-xml-fill-tt-bgecliiv :
     3133     define input  parameter p-str as character no-undo .
     3134     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     3135     define buffer buf_clients             for ub.clients.
     3136     define variable v-i         as integer   no-undo .
     3137     define variable v-count     as integer   no-undo .
     3138     define variable v-cli-count as integer   no-undo .
     3139     define variable v-client    as character no-undo .
     3140     define variable v-obj-type  as character no-undo .
     3141     define variable v-obj-code  as integer   no-undo .
     3142   do
     3143   on error undo, return error return-value
     3144   :
     3145     empty temp-table buf_tt-bge-xml-bgecliiv.
     3146     assign
     3147       v-bge-xml-bgecliiv = no
     3148       v-cli-count        = num-entries(p-str,';')
     3149     .
     3150     if v-cli-count > 0
     3151     then do:
     3152       _cli-cycle:
     3153       do v-i = 1 to v-cli-count
     3154       :
     3155         assign
     3156           v-client = entry(v-i , p-str, ';')
     3157         .
     3158         if num-entries(v-client) <> 2
     3159         then do:
     3160           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     3161         end.
     3162         assign
     3163           v-obj-type = entry(1, v-client)
     3164         .
     3165         assign
     3166           v-obj-code = integer(entry(2, v-client))
     3167         no-error .
     3168         if error-status :error
     3169         then do:
     3170           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     3171         end.
     3172         find first buf_clients no-lock
     3173           where buf_clients.obj-type = v-obj-type
     3174             and buf_clients.obj-code = v-obj-code
     3175         no-error.
     3176         if not available buf_clients
     3177         then do:
     3178           next _cli-cycle.
     3179         end.
     3180         find first buf_tt-bge-xml-bgecliiv no-lock
     3181           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     3182             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     3183         no-error .
     3184         if available buf_tt-bge-xml-bgecliiv
     3185         then do:
     3186           next _cli-cycle.
     3187         end.
     3188         create buf_tt-bge-xml-bgecliiv.
     3189         assign
     3190           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     3191           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     3192         .
     3193       end.
     3194     end.
     3195     else do:
     3196       assign
     3197         v-bge-xml-bgecliiv = no
     3198       .
     3199       return .
     3200     end.
     3201     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     3202     if available buf_tt-bge-xml-bgecliiv
     3203     then do:
     3204       assign
     3205         v-bge-xml-bgecliiv = yes
     3206       .
     3207     end.
     3208   end.
     3209   end procedure.
     3210   procedure bge-xml-resolve-ext-doc-type :
     3211     define input  parameter p-ext-doc-type      as character no-undo .
     3212     define input  parameter p-obj-type          as character no-undo .
     3213     define input  parameter p-obj-code          as integer   no-undo .
     3214     define output parameter p-out-ext-doc-type  as character no-undo .
     3215     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     3216   do
     3217   on error undo, return error return-value
     3218   :
     3219     assign
     3220       p-out-ext-doc-type = p-ext-doc-type
     3221     .
     3222     if p-ext-doc-type <> 'ie':U
     3223     then do:
     3224       return .
     3225     end.
     3226     if v-bge-xml-bgecliiv = yes
     3227     then do:
     3228       find first buf_tt-bge-xml-bgecliiv no-lock
     3229         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     3230           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     3231       no-error .
     3232       if available buf_tt-bge-xml-bgecliiv
     3233       then do:
     3234         assign
     3235           p-out-ext-doc-type = 'iv':U
     3236         .
     3237       end.
     3238     end.
     3239   end.
     3240   end procedure.
     3241   procedure safe-wp-xmltagput :
     3242     define input  parameter pTagLevel   as integer   no-undo .
     3243     define input  parameter pTagName    as character no-undo .
     3244     define input  parameter pParValue   as character no-undo .
     3245     define input  parameter pFlagEmpty  as integer   no-undo .
     3246   do
     3247   on error undo, return error return-value
     3248   :
     3249     if v-bge-xml-bgeflold = "oracle":u
     3250     then do:
     3251       return .
     3252     end.
     3253     run wp-xmltagput in this-procedure ( input pTagLevel
     3254                                        , input pTagName
     3255                                        , input pParValue
     3256                                        , input pFlagEmpty
     3257                                        ).
     3258   end.
     3259   end procedure.
     3260   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3261   define variable v-loc-counter as integer no-undo .
     3262   define variable v-counter-visible as logical no-undo .
     3263   define variable v-view-log as logical no-undo .
     3264   define stream auto2dia.
     3265   PROCEDURE write-log-and-file :
     3266   do
     3267   on error undo, return error
     3268   :
     3269     define input parameter p-tab-position   as integer   no-undo.
     3270     define input parameter p-file-name      as character no-undo .
     3271     define input parameter p-log-level      as integer   no-undo .
     3272     define input parameter p-log-string     AS CHARacter NO-UNDO.
     3273     define variable v-jj as integer   no-undo .
     3274     run write-to-screen in this-procedure( input ( fill( chr(32), p-tab-position) + p-log-string)) .
     3275     if p-file-name <> '':U then do:
     3276       do v-jj = 1 to num-entries(p-file-name, chr(1)):
     3277         run  auto2dia-writefile in this-procedure (
     3278                                         input entry(v-jj, p-file-name, chr(1))
     3279                                         ,input p-log-level
     3280                                         ,input (p-log-string + chr(10))
     3281                                       ) no-error .
     3282       end.
     3283     end.
     3284     if writelogvalue eq "AsyncProc"
     3285     then
     3286        run write-to-log in this-procedure( p-log-string) .
     3287   end.
     3288   END PROCEDURE.
     3289   PROCEDURE get-title :
     3290   do
     3291   on error undo, return error
     3292   :
     3293   define output parameter p-title     as character    no-undo.
     3294   end.
     3295   END PROCEDURE.
     3296   PROCEDURE set-title :
     3297   do
     3298   on error undo, return error
     3299   :
     3300   define input parameter p-title     as character    no-undo.
     3301   run write-to-log in this-procedure( input ( fill( chr(32), 15) + p-title)) .
     3302   end.
     3303   END PROCEDURE.
     3304   PROCEDURE get-counter-value :
     3305   do
     3306   on error undo, return error
     3307   :
     3308   define output parameter p-counter     as integer    no-undo.
     3309       assign
     3310       p-counter  = v-loc-counter
     3311       .
     3312   end.
     3313   END PROCEDURE.
     3314   PROCEDURE set-counter-value :
     3315   do
     3316   on error undo, return error
     3317   :
     3318   define input parameter p-counter     as integer    no-undo.
     3319       assign
     3320       v-loc-counter = p-counter
     3321       .
     3322   end.
     3323   END PROCEDURE.
     3324   PROCEDURE show-counter :
     3325   do
     3326   on error undo, return error
     3327   :
     3328       assign
     3329       v-counter-visible = true
     3330       .
     3331       process events.
     3332   end.
     3333   END PROCEDURE.
     3334   PROCEDURE hide-counter :
     3335   do
     3336   on error undo, return error
     3337   :
     3338       assign
     3339       v-counter-visible = false
     3340       .
     3341       run hide-message in parparentproc .
     3342       process events.
     3343   end.
     3344   END PROCEDURE.
     3345   PROCEDURE write-counter :
     3346   do
     3347   on error undo, return error
     3348   :
     3349   define input parameter p-counter-string     as character    no-undo.
     3350   if v-counter-visible then
     3351   run write-message in parparentproc ( input p-counter-string) .
     3352   process events.
     3353   end.
     3354   END PROCEDURE.
     3355   PROCEDURE get-stop-state :
     3356   do
     3357   on error undo, return error
     3358   :
     3359   define output parameter p-stop-state    as logical      no-undo.
     3360   end.
     3361   END PROCEDURE.
     3362   PROCEDURE set-view-log :
     3363   do
     3364   on error undo, return error
     3365   :
     3366   define input parameter p-view-log     as logical    no-undo.
     3367       assign
     3368       v-view-log = p-view-log
     3369       .
     3370   end.
     3371   END PROCEDURE.
     3372   PROCEDURE get-view-log :
     3373   do
     3374   on error undo, return error
     3375   :
     3376   define output parameter p-view-log     as logical    no-undo.
     3377       assign
     3378       p-view-log = v-view-log
     3379       .
     3380   end.
     3381   END PROCEDURE.
     3382   PROCEDURE write-log :
     3383   do
     3384   on error undo, return error
     3385   :
     3386   define input parameter p-tab-position   as integer      no-undo.
     3387   define input parameter p-log-string     as character    no-undo.
     3388   run write-to-log in this-procedure( input ( fill( chr(32), 1  * p-tab-position)  +
     3389                                       (IF p-log-string = "&Line" THEN FILL("-", 80)
     3390                                       ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     3391                                       ELSE p-log-string))).
     3392   end.
     3393   END PROCEDURE.
     3394   procedure writelog :
     3395   do
     3396   on error undo, return error
     3397   :
     3398   define input parameter p-file-name AS CHAR     NO-UNDO.
     3399   define input parameter p-log-level AS INTEGER  NO-UNDO.
     3400   define input parameter p-log-string  AS CHAR     NO-UNDO.
     3401     if p-file-name <> "" then
     3402     run  auto2dia-Writefile in this-procedure (
     3403                                       input p-file-name
     3404                                     ,input p-log-level
     3405                                     ,input p-log-string
     3406                                   ) no-error .
     3407      process events.
     3408   end.
     3409   end procedure.
     3410   PROCEDURE auto2dia-writefile:
     3411     define input parameter sFileName AS CHAR     NO-UNDO.
     3412     define input parameter iLogLevel AS INTEGER  NO-UNDO.
     3413     define input parameter sToWrite  AS CHAR     NO-UNDO.
     3414     define variable v-SlashPos  as integer no-undo .
     3415     define variable v-lDirName  as character no-undo .
     3416     define variable v-lDirName2 as character no-undo .
     3417     v-SlashPos  = maximum (  r-index(sFileName, "\"),  r-index(sFileName, "/")  ) .
     3418     v-lDirName  = if v-SlashPos > 0 then substring (sFileName, 1, v-SlashPos - 1) else "".
     3419     FILE-INFO:FILE-NAME = v-lDirName .
     3420     v-lDirName2 = FILE-INFO:FULL-PATHNAME .
     3421     if v-lDirName2 <> ? then do :
     3422   OUTPUT STREAM auto2dia TO VALUE(sFileName) APPEND.
     3423       PUT STREAM auto2dia UNFORMATTED chr(10).
     3424       PUT STREAM auto2dia UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     3425                                         OR sToWrite = "&Line") THEN "" ELSE
     3426                                         cur-time-string-sec() + " ").
     3427       PUT STREAM auto2dia UNFORMATTED
     3428               (IF sToWrite = "&Line" THEN FILL("-", 80)
     3429                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     3430                ELSE sToWrite).
     3431   OUTPUT STREAM auto2dia CLOSE.
     3432     end .
     3433   END PROCEDURE.
     3434   do
     3435   on error undo, return error
     3436   :
     3437       define variable v-ind                       as integer      no-undo.
     3438       define variable v-param-list                as character    no-undo.
     3439       define variable v-temp-obj-list             as character    no-undo.
     3440       define variable v-obj-list                  as character    no-undo.
     3441       define variable v-param-type                as character    no-undo.
     3442       define variable v-obj-counter               as integer      no-undo.
     3443       define variable v-range                     as integer      no-undo.
     3444       define variable v-host-code                 as integer      no-undo.
     3445       define variable v-remote                    as integer      no-undo .
     3446       define variable v-parameter                 as character    no-undo .
     3447       define buffer buf_clients   for ub.clients .
     3448       define buffer buf_temp-obj  for temp-obj.
     3449       assign
     3450       log-file-name = "extgetcd.log".
     3451       run gbl/set-gbl.p
     3452         (input  true
     3453         ,input  g#auto-user-id
     3454         ,input  g#auto-user-password
     3455         ) no-error .
     3456       if error-status :error
     3457       then do:
     3458           run write-to-log( vss-workfile + chr(32)
     3459                           + "Ошибка при инициализации переменных g#..." + chr(10)
     3460                           + error-status:get-message(error-status:num-messages)
     3461                           + return-value
     3462                           ) .
     3463           return error.
     3464       end.
     3465       run schedule-attr-value in this-procedure (
     3466             input p-cre-db-num
     3467           , input p-task-type
     3468           , input p-task-num
     3469           , input 'schedule-param-list':U
     3470           , output v-param-list
     3471           , output v-param-type
     3472       ).
     3473       if v-param-list = '' then do:
     3474          assign
     3475          v-range = 1
     3476          v-remote = 0
     3477          .
     3478       end.
     3479       else do:
     3480       assign
     3481           v-range = integer( entry( 1,  v-param-list ) )
     3482           v-remote = (if num-entries(v-param-list) > 2 then integer(entry(3, v-param-list)) else 0)
     3483       .
     3484       end.
     3485       if v-range = 2
     3486       then do:
     3487           if num-entries( v-param-list ) > 2
     3488           then do:
     3489               assign
     3490                   v-host-code = integer( entry( 2,  v-param-list ) )
     3491               .
     3492           end.
     3493           else do:
     3494               assign
     3495                   v-host-code = -1
     3496               .
     3497               run write-to-log in this-procedure (
     3498                   input vss-workfile + chr(32) + " Не удалось определить код фирмы для приема информации с касс объектов фирмы."
     3499               ).
     3500           end.
     3501       end.
     3502       if v-range = 2
     3503       and v-host-code = -1
     3504       then do:
     3505           assign
     3506               v-range = 1
     3507           .
     3508       end.
     3509       if v-range <> 3 then run init-temphost.
     3510       case v-range
     3511       :
     3512           when 1
     3513           then do:
     3514               for each temp-obj
     3515               :
     3516                   if temp-obj.db-num = p-db-num
     3517                   then do:
     3518                       assign
     3519                           v-obj-list = v-obj-list
     3520                                           + ( if v-obj-list = "" then "" else "," )
     3521                                           + temp-obj.obj-type
     3522                                           + "," + string( temp-obj.obj-code )
     3523                       .
     3524                   end.
     3525               end.
     3526           end.
     3527           when 2
     3528           then do:
     3529               for each temp-obj
     3530               :
     3531                   if temp-obj.db-num = p-db-num
     3532                   and temp-obj.host-code = v-host-code
     3533                   then do:
     3534                       assign
     3535                           v-obj-list = v-obj-list
     3536                                           + ( if v-obj-list = "" then "" else "," )
     3537                                           + temp-obj.obj-type
     3538                                           + "," + string( temp-obj.obj-code )
     3539                       .
     3540                   end.
     3541               end.
     3542           end.
     3543           when 3
     3544           then do:
     3545               run schedule-attr-value in this-procedure (
     3546                     input p-cre-db-num
     3547                   , input p-task-type
     3548                   , input p-task-num
     3549                   , input 'schedule-obj-list':U
     3550                   , output v-temp-obj-list
     3551                   , output v-param-type
     3552               ).
     3553               do v-obj-counter = 1 to num-entries ( v-temp-obj-list ) / 2
     3554               :
     3555                   find first buf_clients no-lock
     3556                         where buf_clients.obj-type  = entry( v-obj-counter * 2 - 1, v-temp-obj-list )
     3557                           and buf_clients.obj-code = integer( entry( v-obj-counter * 2, v-temp-obj-list ) )
     3558                   no-error.
     3559                   if not available buf_clients
     3560                   then do:
     3561                       run write-to-log( vss-workfile + chr(32)
     3562                                       + substitute( " Ошибка приема информации с касс по расписанию: Не найден заданный объект &1 &2" + chr(10)
     3563                                                       , buf_clients.obj-type
     3564                                                       , buf_clients.obj-code
     3565                                                   )
     3566                                       ) .
     3567                       undo, return error .
     3568                   end.
     3569                   else do:
     3570                       if buf_clients.db-num = p-db-num
     3571                       then do:
     3572                           assign
     3573                               v-obj-list = v-obj-list
     3574                                               + ( if v-obj-list = "" then "" else "," )
     3575                                               + buf_clients.obj-type
     3576                                               + "," + string( buf_clients.obj-code )
     3577                           .
     3578                           create buf_temp-obj .
     3579                           assign
     3580                             buf_temp-obj.obj-type  = buf_clients.obj-type
     3581                             buf_temp-obj.obj-code  = buf_clients.obj-code
     3582                             buf_temp-obj.host-code = buf_clients.host-code
     3583                             buf_temp-obj.db-num    = buf_clients.db-num
     3584                           .
     3585                       end.
     3586                   end.
     3587               end.
     3588           end.
     3589       end case.
     3590       if v-obj-list = ""
     3591       then do:
     3592           run write-to-log( vss-workfile + chr(32)
     3593                           + substitute( " Нет объектов для приема информации с касс."
     3594                                           + chr(10) + "    Номер базы данных:                   &1"
     3595                                           + chr(10) + "    Задан список объектов:               &2"
     3596                                           + chr(10) + "    Тип выгрузки         :               &3"
     3597                                           , p-db-num
     3598                                           , v-obj-list
     3599                                           , v-range
     3600                                       )
     3601                           ) .
     3602           undo, return error .
     3603       end.
     3604       for each temp-obj no-lock where
     3605                temp-obj.obj-type = 'маг':U
     3606           and temp-obj.db-num = g#db-num
     3607                :
     3608          if v-range = 2 and temp-obj.host-code <> v-host-code then next.
     3609         assign
     3610         v-parameter =
     3611                        temp-obj.obj-type         + chr(4) +
     3612                        string(temp-obj.obj-code) + chr(4) +
     3613                        string(v-remote)          + chr(4) +
     3614                        string(1).
     3615         run str/get-chkf.p (
     3616                        input this-procedure
     3617                       ,input this-procedure
     3618                       ,input this-procedure
     3619                       ,input v-parameter ) no-error .
     3620         if error-status:error then do:
     3621         run write-to-log in this-procedure (
     3622               input substitute( "!!!Ошибка при приеме информации с касс &1&2&3" +
     3623                                  "&4 &5"
     3624                                , temp-obj.obj-type
     3625                                , temp-obj.obj-code
     3626                                , chr(10)
     3627                                , error-status:get-message(1)
     3628                                , return-value
     3629                                )            ).
     3630         end.
     3631         process events.
     3632         run write-to-log in this-procedure (
     3633               input substitute( "Обработка спул-файлов по &1&2 завершена"
     3634                                , temp-obj.obj-type
     3635                                , temp-obj.obj-code
     3636                                )
     3637                                           ).
     3638       end.
     3639   end.
