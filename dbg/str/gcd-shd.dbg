     1712           host-code
     1713           fin-doc-code
     1714   .
     1715   define temp-table temp_del-fin-doc-code no-undo
     1716       field host-code as integer
     1717       field fin-doc-code as integer
     1718       field corr-user-db-num as integer
     1719       field chip-num as integer
     1720       index pi is primary unique
     1721           host-code
     1722           fin-doc-code
     1723           corr-user-db-num
     1724           chip-num
