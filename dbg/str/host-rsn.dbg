      251       "$Workfile$"
      252       "Указанному интерфейсному элементу фокус не может быть передан" skip
      253       "Интерфейсный элемент" self :name  skip
      254       "Тип" self :type  skip
      255       "Процедура" this-procedure :file-name skip
      256       view-as alert-box .
      257   end.
      258   else do:
      259     apply "entry":u to self  .
      260     if focus :handle <> self :handle  then do:
      261       return no-apply .
      262     end.
      263   end.
