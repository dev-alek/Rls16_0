      759   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      760   on F1 of frame fr-D-host-rsn anywhere do:
      761     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-host-rsn. END.
      762     return no-apply.
      763   end.
      764   if valid-handle( active-window ) and frame fr-D-host-rsn :parent = ? then frame fr-D-host-rsn :parent = active-window.
      765   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      766   on window-close of frame fr-D-host-rsn do: apply "END-ERROR":U to self. end.
      767   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      768   on help of frame fr-D-host-rsn
      769   do:
      770     run gbl/app_help.p
      771       (input this-procedure :file-name
      772       ,input ''
      773       ,input ?
      774       ) no-error.
      775     if error-status :error then do:
      776       message
      777         "Ошибка при вызове помощи"
      778         error-status :get-message(1)
      779         view-as alert-box .
      780     end.
      781   end.
      782   run minbtn-set in this-procedure .
      783   on choose of b-help in frame fr-D-host-rsn
      784   do:
      785     apply "help":u to frame fr-D-host-rsn .
      786   end.
      787   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   procedure minbtn-set :
      789       do
      790           on error undo, return error return-value
      791           :
      792           define variable ii              as integer       no-undo .
      793           define variable fh              as widget-handle no-undo .
      794           define variable hh              as widget-handle no-undo .
      795           define variable v-h             as handle        extent 4 no-undo .
      796           define variable v-name-button   as character     no-undo .
      797           define variable v-help-old-x    as decimal       no-undo .
      798           define variable v-help-old-y    as decimal       no-undo .
      799           define variable v-help-old-size as decimal       no-undo .
      800           define variable v-frame-width   as decimal       no-undo .
      801           define variable jj              as integer       no-undo .
      802           do
      803               on error undo, return error
      804               :
      805               assign
      806                   v-frame-width = frame fr-D-host-rsn:width - 0.3
      807                   fh            = frame fr-D-host-rsn:first-child
      808                   hh            = fh:first-child
      809                   ii            = 1
      810                   .
      811               do while valid-handle(hh):
      812                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      813                   do:
      814                       case lc(hh:name) :
      815                           when "b-help" then
      816                               do:
      817                                   hh:load-image-up("cmp/b-help.bmp":u) .
      818                                   hh:load-image-down("cmp/b-help.bmp":u) .
      819                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      820                                   hh:TOOLTIP = "Помощь" .
      821                                   v-help-old-x = hh:column .
      822                                   v-help-old-y = hh:row    .
      823                                   v-help-old-size = hh:width .
      824                                   hh:width-chars = 2.5 .
      825                               end.
      826                           when "b-print" then
      827                               do:
      828                                   hh:load-image("cmp/b-print.bmp":u) .
      829                                   hh:TOOLTIP = "Печать" .
      830                                   v-h[ii] = hh:handle .
      831                                   ii = ii + 1 .
      832                                   hh:width-chars = 3 .
      833                               end.
      834                           when "b-history" or
      835                           when "b-hist" then
      836                               do:
      837                                   hh:load-image("cmp/b-hist.bmp":u) .
      838                                   hh:TOOLTIP = "История" .
      839                                   v-h[ii] = hh:handle .
      840                                   ii = ii + 1 .
      841                                   hh:width-chars = 3 .
      842                               end.
      843                           when "b-sch" then
      844                               do:
      845                                   hh:load-image("cmp/b-sch.bmp":u) .
      846                                   hh:TOOLTIP = "Установка Фильтра" .
      847                                   v-h[ii] = hh:handle .
      848                                   ii = ii + 1 .
      849                                   hh:width-chars = 3 .
      850                               end.
      851                           when "b-hist-user" then
      852                               do:
      853                                   hh:load-image("cmp/b-hist.bmp":u) .
      854                                   hh:TOOLTIP = "История пользователя" .
      855                                   ii = ii + 1 .
      856                               end.
      857                       end case.
      858                   end.
      859                   hh = hh:next-sibling.
      860               end.
      861               b-help:column = v-frame-width - b-help:width-chars.
      862               jj = 0.
      863               repeat ii = 4 to 1 by -1 :
      864                   if valid-handle (v-h[ii] ) then
      865                   do:
      866                       jj  = jj + 1 .
      867                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      868                       v-h[ii]:row    = v-help-old-y .
      869                   end.
      870               end.
      871           end.
      872       end.
      873   end procedure.
      874   Main-Block:
      875   do on error   undo Main-Block, leave Main-Block
      876      on end-key undo Main-Block, leave Main-Block :
      877      if v-cntxt-host-code-obj = 0  then do :
      878         message "Не назначена текущая фирма !" view-as alert-box information .
      879         return .
      880      end.
