     1720     procedure Apply-Next :
     1721       define input parameter p-name as character no-undo.
     1722       case p-name :
     1723         when      'ie':U          then do: apply "ENTRY":U  to rsn-ee          in frame fr-D-host-rsn. end.
     1724         when      'ee':U          then do: apply "ENTRY":U  to rsn-ep       in frame fr-D-host-rsn. end.
     1725         when      'ep':U       then do: apply "ENTRY":U  to rsn-es     in frame fr-D-host-rsn. end.
     1726         when      'es':U     then do: apply "ENTRY":U  to rsn-re      in frame fr-D-host-rsn. end.
     1727         when      're':U      then do: apply "ENTRY":U  to rsn-rs in frame fr-D-host-rsn. end.
     1728         when      'rs':U then do: apply "ENTRY":U  to rsn-we          in frame fr-D-host-rsn. end.
     1729         when      'we':U          then do: apply "ENTRY":U  to rsn-vt                in frame fr-D-host-rsn. end.
     1730         when      'vt':U                then do: apply "ENTRY":U  to rsn-vp           in frame fr-D-host-rsn. end.
     1731         when      'vp':U           then do: apply "ENTRY":U  to rsn-iv          in frame fr-D-host-rsn. end.
     1732         when      'iv':U          then do: apply "ENTRY":U  to rsn-ev          in frame fr-D-host-rsn. end.
     1733         when      'ev':U          then do: apply "ENTRY":U  to rsn-rv      in frame fr-D-host-rsn. end.
     1734         when      'rv':U      then do: apply "ENTRY":U  to rsn-em           in frame fr-D-host-rsn. end.
     1735         when      'em':U           then do: apply "ENTRY":U  to rsn-wm           in frame fr-D-host-rsn. end.
     1736         when      'wm':U           then do: apply "ENTRY":U  to rsn-im           in frame fr-D-host-rsn. end.
     1737         when      'im':U           then do: apply "ENTRY":U  to rsn-ap           in frame fr-D-host-rsn. end.
     1738         when      'ap':U     then do: apply "ENTRY":U  to rsn-pc     in frame fr-D-host-rsn. end.
     1739         when      'pc':U     then do: apply "ENTRY":U  to rsn-mp   in frame fr-D-host-rsn. end.
     1740         when      'mp':U   then do: apply "ENTRY":U  to rsn-ieh         in frame fr-D-host-rsn. end.
     1741         when 'ieh':U      then do: apply "ENTRY":U  to rsn-eeh         in frame fr-D-host-rsn. end.
     1742         when 'eeh':U      then do: apply "ENTRY":U  to rsn-eph      in frame fr-D-host-rsn. end.
     1743         when 'eph':U   then do: apply "ENTRY":U  to rsn-reh     in frame fr-D-host-rsn. end.
     1744         when 'reh':U  then do: apply "CHOOSE":U to b-OK                              in frame fr-D-host-rsn. end.
     1745       end case.
     1746     end procedure.
