        1   block-level on error undo, throw.
        2   define input parameter parobj-type like ub.wth-doc.obj-type no-undo .
        3   define input parameter parobj-code like ub.wth-doc.obj-code no-undo .
        4   define input parameter pardelfact-order as decimal no-undo .
        5   define input parameter p-wth-code       like ub.wealth.wth-code      no-undo .
        6   define input parameter p-wth-doc-close as logical no-undo .
        7   define input parameter p-hist-action as character no-undo .
        8   define input parameter p-doc-code       like ub.wth-doc.doc-code no-undo .
        9   define input parameter p-fact-date      like ub.wth-doc.fact-date    no-undo .
       10   define input parameter p-user-db-num    like ub.wth-doc.user-db-num  no-undo .
       11   define input parameter p-user-name      like ub.wth-doc.user-name    no-undo .
       12   define input parameter p-sys-date       like ub.wth-doc.sys-date     no-undo .
       13   define input parameter p-sys-time-int   like ub.wth-doc.sys-time-int no-undo .
       14   define input parameter p-sys-time       like ub.wth-doc.sys-time     no-undo .
       15   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       16   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       17   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile: reclcwtl.p $":U .
       19   define variable vss-archive     as character no-undo init "$Archive: str/reclcwtl.p $":U .
       20   define variable vss-description as character no-undo init "Пересчет остатков мат ценностей начиная с fact-order предшествующего данному по одной МЦ".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define   shared variable g#auto as logical no-undo.
       82   define   shared variable g#news as logical no-undo.
       83   define   shared variable g#oxml as logical no-undo.
       84   define   shared variable g#esys as logical no-undo.
       85   define   shared variable g#news-source-db as integer no-undo.
       86   define   shared variable g#esys-source-esys as integer no-undo.
       87   define   shared variable g#db-num as integer   no-undo .
       88   define   shared variable g#userid as character no-undo .
       89   define   shared variable g#passwd as character no-undo .
       90   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure wth-obj-hist :
       92   define parameter buffer buf_wth-obj for ub.wth-obj.
       93   define input parameter p-obj-type like ub.wth-obj.obj-type no-undo .
       94   define input parameter p-obj-code like ub.wth-obj.obj-code no-undo .
       95   define input parameter p-wth-code like ub.wth-obj.wth-code no-undo .
       96   define input parameter p-action-type as character no-undo .
       97   define input  parameter p-source-type        as character no-undo .
       98   define input  parameter p-source-ref         as character no-undo .
       99   define input  parameter p-source-date        as date      no-undo .
      100   define input  parameter p-corr-user-db-num   as integer   no-undo .
      101   define input  parameter p-corr-user-name     as character no-undo .
      102   define input  parameter p-corr-date          as date      no-undo .
      103   define input  parameter p-corr-time          as integer   no-undo .
      104   define input  parameter p-corr-time-str      as character no-undo .
      105   define variable v-new-chip-num as integer   no-undo .
      106   define buffer buf_c-wth-obj for ub.c-wth-obj .
      107     do
      108     for buf_c-wth-obj
      109     transaction
      110     on error undo, return error return-value
      111     :
      112       find last buf_c-wth-obj exclusive-lock
      113         where buf_c-wth-obj.obj-type = buf_wth-obj.obj-type
      114           and buf_c-wth-obj.obj-code = buf_wth-obj.obj-code
      115           and buf_c-wth-obj.wth-code = buf_wth-obj.wth-code
      116           and buf_c-wth-obj.corr-user-db-num = p-corr-user-db-num
      117         use-index pi
      118         no-error .
      119       if available buf_c-wth-obj
      120       then do:
      121         assign
      122           v-new-chip-num = buf_c-wth-obj.chip-num + 1
      123         .
      124       end.
      125       else do:
      126         assign
      127           v-new-chip-num = 1
      128         .
      129       end.
      130       create buf_c-wth-obj .
      131       if p-action-type = 'delete':U
      132       and
      133       not available buf_wth-obj then do:
      134         assign
      135         buf_c-wth-obj.obj-type = p-obj-type
      136         buf_c-wth-obj.obj-code = p-obj-code
      137         buf_c-wth-obj.wth-code = p-wth-code
      138         .
      139       end.
      140       else do:
      141         buffer-copy buf_wth-obj to
      142         buf_c-wth-obj.
      143       end.
      144       assign
      145         buf_c-wth-obj.chip-num          = v-new-chip-num
      146         buf_c-wth-obj.action-type       = p-action-type
      147         buf_c-wth-obj.source-type       = p-source-type
      148         buf_c-wth-obj.source-ref        = p-source-ref
      149         buf_c-wth-obj.source-date       = p-source-date
      150         buf_c-wth-obj.corr-user-db-num  = p-corr-user-db-num
      151         buf_c-wth-obj.corr-user-name    = p-corr-user-name
      152         buf_c-wth-obj.corr-date         = p-corr-date
      153         buf_c-wth-obj.corr-time         = p-corr-time
      154         buf_c-wth-obj.corr-time-str     = p-corr-time-str
      155       .
      156     end.
      157   end procedure.
      158   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      159   procedure wth-pobj-hist :
      160   define parameter buffer buf_wth-pobj for ub.wth-pobj.
      161   define input parameter p-obj-type like ub.wth-pobj.obj-type no-undo .
      162   define input parameter p-obj-code like ub.wth-pobj.obj-code no-undo .
      163   define input parameter p-wth-code like ub.wth-pobj.wth-code no-undo .
      164   define input parameter p-w-p-code like ub.wth-pobj.w-p-code no-undo .
      165   define input parameter p-action-type as character no-undo .
      166   define input  parameter p-source-type        as character no-undo .
      167   define input  parameter p-source-ref         as character no-undo .
      168   define input  parameter p-source-date        as date      no-undo .
      169   define input  parameter p-corr-user-db-num   as integer   no-undo .
      170   define input  parameter p-corr-user-name     as character no-undo .
      171   define input  parameter p-corr-date          as date      no-undo .
      172   define input  parameter p-corr-time          as integer   no-undo .
      173   define input  parameter p-corr-time-str      as character no-undo .
      174   define variable v-new-chip-num as integer   no-undo .
      175   define buffer buf_c-wth-pobj for ub.c-wth-pobj .
      176     do
      177     for buf_c-wth-pobj
      178     transaction
      179     on error undo, return error return-value
      180     :
      181       find first buf_c-wth-pobj exclusive-lock
      182         where buf_c-wth-pobj.obj-type = buf_wth-pobj.obj-type
      183           and buf_c-wth-pobj.obj-code = buf_wth-pobj.obj-code
      184           and buf_c-wth-pobj.wth-code = buf_wth-pobj.wth-code
      185           and buf_c-wth-pobj.w-p-code = buf_wth-pobj.w-p-code
      186         use-index ishow
      187         no-error .
      188       if available buf_c-wth-pobj
      189       then do:
      190          assign
      191           v-new-chip-num = buf_c-wth-pobj.chip-num + 1
      192         .
      193       end.
      194       else do:
      195         assign
      196           v-new-chip-num = 1
      197         .
      198       end.
      199       create buf_c-wth-pobj .
      200       if p-action-type = 'delete':U
      201       and
      202       not available buf_wth-pobj then do:
      203         assign
      204         buf_c-wth-pobj.obj-type = p-obj-type
      205         buf_c-wth-pobj.obj-code = p-obj-code
      206         buf_c-wth-pobj.wth-code = p-wth-code
      207         buf_c-wth-pobj.w-p-code = p-w-p-code
      208         buf_c-wth-pobj.corr-user-db-num  = p-corr-user-db-num
      209         .
      210       end.
      211       else do:
      212         buffer-copy buf_wth-pobj to buf_c-wth-pobj
      213         assign buf_c-wth-pobj.corr-user-db-num  = p-corr-user-db-num
      214         .
      215       end.
      216       assign
      217         buf_c-wth-pobj.chip-num          = v-new-chip-num
      218         buf_c-wth-pobj.action-type       = p-action-type
      219         buf_c-wth-pobj.source-type       = p-source-type
      220         buf_c-wth-pobj.source-ref        = p-source-ref
      221         buf_c-wth-pobj.source-date       = p-source-date
      222         buf_c-wth-pobj.corr-user-name    = p-corr-user-name
      223         buf_c-wth-pobj.corr-date         = p-corr-date
      224         buf_c-wth-pobj.corr-time         = p-corr-time
      225         buf_c-wth-pobj.corr-time-str     = p-corr-time-str
      226       .
      227     end.
      228   end procedure.
      229   define buffer start_wth-line for ub.wth-line.
      230   define buffer start_wth-obj  for ub.wth-obj.
      231   define buffer start_wth-pobj for ub.wth-pobj.
      232   define buffer buf_wth-line   for ub.wth-line.
      233   define buffer buf_wth-doc    for ub.wth-doc.
      234   define variable v-host-code as integer   no-undo .
      235   do transaction
      236   on error undo, return error
      237   :
      238   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      239   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      240     (input  parobj-type
      241     ,input  parobj-code
      242     ,output v-host-code
      243     )  .
      244     for each start_wth-pobj exclusive-lock
      245       where start_wth-pobj.obj-type = parobj-type
      246         and start_wth-pobj.obj-code = parobj-code
      247         and start_wth-pobj.wth-code = p-wth-code
      248     on error undo, return error
      249     :
      250       find last start_wth-line no-lock
      251         where start_wth-line.obj-type = parobj-type
      252           and start_wth-line.obj-code = parobj-code
      253           and start_wth-line.status_ = 'факт':U
      254           and start_wth-line.fact-order <= pardelfact-order
      255           and start_wth-line.wth-code = start_wth-pobj.wth-code
      256           and start_wth-line.w-p-code = start_wth-pobj.w-p-code
      257         no-error .
      258       run wth-pobj-hist in this-procedure (
      259                                             buffer start_wth-pobj
      260                                           ,input start_wth-pobj.obj-type
      261                                           ,input start_wth-pobj.obj-code
      262                                           ,input start_wth-pobj.wth-code
      263                                           ,input start_wth-pobj.w-p-code
      264                                           ,input p-hist-action
      265                                           ,input 'wth-doc':U
      266                                           ,input p-doc-code
      267                                           ,input p-fact-date
      268                                           ,input p-user-db-num
      269                                           ,input p-user-name
      270                                           ,input p-sys-date
      271                                           ,input p-sys-time-int
      272                                           ,input p-sys-time
      273                                           ).
      274       if available start_wth-line
      275       then do:
      276         assign
      277           start_wth-pobj.incass-pl       = start_wth-line.incass-pl
      278           start_wth-pobj.income-pl       = start_wth-line.income-pl
      279           start_wth-pobj.incass-bank-pl  = start_wth-line.incass-bank-pl
      280           start_wth-pobj.incass-other-pl = start_wth-line.incass-other-pl
      281           start_wth-pobj.incass-cassa-pl = start_wth-line.incass-cassa-pl
      282           start_wth-pobj.income-cassa-pl = start_wth-line.income-cassa-pl
      283           start_wth-pobj.income-other-pl = start_wth-line.income-other-pl
      284         .
      285       end.
      286       else do:
      287         assign
      288           start_wth-pobj.incass-pl       = 0
      289           start_wth-pobj.income-pl       = 0
      290           start_wth-pobj.incass-bank-pl  = 0
      291           start_wth-pobj.incass-other-pl = 0
      292           start_wth-pobj.incass-cassa-pl = 0
      293           start_wth-pobj.income-cassa-pl = 0
      294           start_wth-pobj.income-other-pl = 0
      295         .
      296       end.
      297     end.
      298     for each start_wth-obj exclusive-lock
      299       where start_wth-obj.obj-type = parobj-type
      300         and start_wth-obj.obj-code = parobj-code
      301         and start_wth-obj.wth-code = p-wth-code
      302     on error undo, return error
      303     :
      304       find last start_wth-line no-lock
      305         where start_wth-line.obj-type = parobj-type
      306           and start_wth-line.obj-code = parobj-code
      307           and start_wth-line.status_ = 'факт':U
      308           and start_wth-line.fact-order <= pardelfact-order
      309           and start_wth-line.wth-code = start_wth-obj.wth-code
      310         no-error .
      311       run wth-obj-hist in this-procedure (
      312                                            buffer start_wth-obj
      313                                           ,input start_wth-obj.obj-type
      314                                           ,input start_wth-obj.obj-code
      315                                           ,input start_wth-obj.wth-code
      316                                           ,input 'delete':U
      317                                           ,input 'wth-doc':U
      318                                           ,input p-doc-code
      319                                           ,input p-fact-date
      320                                           ,input p-user-db-num
      321                                           ,input p-user-name
      322                                           ,input p-sys-date
      323                                           ,input p-sys-time-int
      324                                           ,input p-sys-time
      325                                           ).
      326       if avail start_wth-line then do:
      327         assign
      328           start_wth-obj.incass           = start_wth-line.incass
      329           start_wth-obj.income           = start_wth-line.income
      330           start_wth-obj.incass-bank      = start_wth-line.incass-bank
      331           start_wth-obj.incass-other     = start_wth-line.incass-other
      332           start_wth-obj.incass-cassa     = start_wth-line.incass-cassa
      333           start_wth-obj.income-cassa     = start_wth-line.income-cassa
      334           start_wth-obj.income-other     = start_wth-line.income-other
      335         .
      336       end.
      337       else do:
      338         assign
      339           start_wth-obj.incass           = 0
      340           start_wth-obj.income           = 0
      341           start_wth-obj.incass-bank      = 0
      342           start_wth-obj.incass-other     = 0
      343           start_wth-obj.incass-cassa     = 0
      344           start_wth-obj.income-cassa     = 0
      345           start_wth-obj.income-other     = 0
      346         .
      347       end.
      348     end.
      349     for each buf_wth-line no-lock where buf_wth-line.obj-type = parobj-type
      350                             and buf_wth-line.obj-code = parobj-code
      351                             and buf_wth-line.wth-code = p-wth-code
      352                             and buf_wth-line.status_   = 'факт':U
      353                             AND buf_wth-line.fact-order > pardelfact-order
      354                             use-index stat-fact
      355         , first buf_wth-doc no-lock where buf_wth-doc.doc-code = buf_wth-line.doc-code
      356     on error undo, return error
      357     :
      358        define variable v-wth-code as integer no-undo .
      359        define variable v-doc-code as character no-undo .
      360        if v-wth-code = buf_wth-line.wth-code
      361        and v-doc-code = buf_wth-line.doc-code then next.
      362         run str/stkotwth.p
      363           (input recid(buf_wth-doc)
      364           ,input yes
      365           ,input p-wth-doc-close
      366           ,input p-wth-code) no-error.
      367         if error-status :error then do:
      368           undo, return error return-value.
      369         end.
      370         assign
      371         v-wth-code = buf_wth-line.wth-code
      372         v-doc-code = buf_wth-line.doc-code
      373         .
      374     end.
      375   end.
