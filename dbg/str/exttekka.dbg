      445   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
      446   define variable v-is-closed-shift-journal as integer no-undo .
      447   assign
      448   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
      449                               +
      450                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
      451                               +
      452                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
      453   .
      454   return v-is-closed-shift-journal.
      455   END FUNCTION.
      456   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
      457   define variable v-is-first-journal as logical no-undo .
      458   assign
      459   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
      460                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
      461                     or (p-journal-num =  integer(entry(1, '17':U)))
      462                     or (p-journal-num = integer(entry(1, '16':U)))
      463   .
      464   return v-is-first-journal.
      465   END FUNCTION.
      466   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
      467   define variable v-is-petrol-journal as logical no-undo .
      468   assign
      469   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
      470   return v-is-petrol-journal.
      471   END FUNCTION.
      472   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
      473   define variable v-max-record-num as integer no-undo .
      474   assign
      475   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      476                       then 1489
      477                       else 2340).
      478   return v-max-record-num.
      479   END FUNCTION.
      480   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
      481   define variable v-max-record-num as integer no-undo .
      482   assign
      483   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      484                       then 1489 * num-entries('30,31,32,33':U)
      485                       else 2340 * num-entries('17':U)).
      486   return v-max-record-num.
      487   END FUNCTION.
      488   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
      489                                           ,input p-rec-no as integer):
      490   define variable v-num-recs as integer no-undo .
      491   if tekka-is-petrol-journal (p-journal-num) then do:
      492     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
      493       assign
      494       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
      495       .
      496     end.
      497     else do:
      498       assign
      499       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
      500       .
      501     end.
      502   end.
      503   else do:
      504     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
      505       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      506         assign
      507         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
      508         .
      509       end.
      510       else do:
      511         assign
      512         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
      513         .
      514       end.
      515     end.
      516     else do:
      517       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      518         assign
      519         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
      520         .
      521       end.
      522       else do:
      523         assign
      524         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
      525         .
      526       end.
      527     end.
      528   end.
      529   return v-num-recs.
      530   END FUNCTION.
      531   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
      532                                              ,input p-is-petrol as logical
      533                                              ,input p-is-current as logical
      534                                              ,output p-rec-no as decimal
      535                                              ):
      536   define variable v-obj-num0 as integer no-undo .
      537   define variable v-obj-num as integer no-undo .
      538   define variable v-obj-num2 as integer no-undo .
      539   define variable p-num-recs2 as integer no-undo .
      540   define variable p-rec-no2 as integer no-undo .
      541   if p-is-petrol then do:
      542     assign
      543     v-obj-num0 = trunc(p-num-recs / 1489, 0)
      544     .
      545     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
      546     then
      547     assign
      548     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
      549     p-rec-no = p-num-recs modulo 1489
      550     .
      551     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
      552     then
      553     assign
      554     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
      555     p-rec-no = p-num-recs modulo 1489
      556     .
      557   end.
      558   else do:
      559     assign
      560     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
      561     p-num-recs = trunc(p-num-recs, 0)
      562     v-obj-num0 = trunc(p-num-recs / 2340, 0)
      563     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
      564     .
      565     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
      566     then
      567     assign
      568     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
      569     p-rec-no = p-num-recs modulo 2340
      570     .
      571     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
      572     then
      573     assign
      574     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
      575     p-rec-no = p-num-recs modulo 2340
      576     .
      577     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
      578     then
      579     assign
      580     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
      581     p-rec-no2 = p-num-recs2 modulo 2978
      582     .
      583     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
      584     then
      585     assign
      586     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
      587     p-rec-no2 = p-num-recs2 modulo 2978
      588     .
      589     assign
      590     p-rec-no = p-rec-no + p-rec-no2 / 10000
      591     .
      592   end.
      593   if v-obj-num = 0 then v-obj-num = 100.
      594   return v-obj-num.
      595   END FUNCTION.
      596   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
      597   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
      598   if lookup (string(p-obj-num), '17':U) > 0 then do:
      599      if p-is-ptrl then
      600      return integer(entry(1, '26,27,28,29':U)).
      601      if not p-is-ptrl then
      602      return integer(entry(1, '16':U)).
      603   end.
      604   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      605   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      606   return 0.
      607   END FUNCTION.
      608   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
      609   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
      610   if lookup (string(p-obj-num), '17':U) > 0 then do:
      611     if p-is-ptrl then
      612     return integer(entry(1, '26,27,28,29':U)).
      613     if not p-is-ptrl then
      614     return integer(entry(1, '16':U)).
      615   end.
      616   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      617   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      618   return 0.
      619   END FUNCTION.
      620   procedure tekkatsk-verify-schema :
      621   define input parameter p-obj-list as character no-undo .
      622   define input parameter p-dir-path as character no-undo .
      623   define variable v-obj-num as integer no-undo .
      624   define variable v-obj-name as character no-undo .
      625   define variable v-num-records as integer no-undo .
      626   define variable v-size_ as integer no-undo .
      627   define variable v-value as character no-undo .
      628   define variable ii as integer no-undo .
      629   define variable jj as integer no-undo .
      630   define variable ii-ibs as integer no-undo .
      631   define variable ii-tekka as integer no-undo .
      632   define variable v-result as character no-undo .
      633   define buffer buf_temp-tekka-schema for temp-tekka-schema.
      634   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
      635     do
      636     on error undo, return error
      637     :
      638        for each buf_temp-tekka-schema:
      639          delete buf_temp-tekka-schema.
      640        end.
      641        input from value('tekkasch.d').
      642        repeat :
      643          create buf_temp-tekka-schema.
      644          import buf_temp-tekka-schema.
      645          assign
      646          buf_temp-tekka-schema.host = 'IBS'
      647          ii = ii + 1.
      648          .
      649        end.
      650        input close.
      651        ii-ibs = ii.
      652         _ii:
      653         do ii = 1 to 256:
      654           if p-obj-list = "ALL"
      655           or lookup(string(ii), p-obj-list) > 0 then do:
      656             assign
      657             v-obj-num = 0
      658             v-obj-name = ''
      659             v-num-records = 0
      660             v-size_ = 0
      661             .
      662             run alienini-getkey in this-procedure (
      663                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      664                                                     ,input ('obj' + string(ii, '999'))
      665                                                     ,input 'oname'
      666                                                     ,output v-value) no-error .
      667             if v-value = ? then next _ii.
      668             assign
      669             v-obj-num = ii
      670             v-obj-name = v-value
      671             .
      672             run alienini-getkey in this-procedure (
      673                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      674                                                     ,input ('obj' + string(ii, '999'))
      675                                                     ,input 'size'
      676                                                     ,output v-value) no-error .
      677             assign
      678             v-num-records = integer(v-value) no-error  .
      679             if error-status:error
      680             or v-num-records = 0 then next _ii.
      681             run alienini-getkey in this-procedure (
      682                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      683                                                     ,input 'obj' + string(ii, '999')
      684                                                     ,input 'f000'
      685                                                     ,output v-value) no-error .
      686             assign
      687             v-size_ = integer(v-value) no-error  .
      688             if error-status:error
      689             or v-size_ = 0 then next _ii.
      690             _jj:
      691             do jj = 1 to 256:
      692               run alienini-getkey in this-procedure (
      693                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      694                                                       ,input 'obj' + string(ii, '999')
      695                                                       ,input 'f' + string(jj, '999')
      696                                                       ,output v-value) no-error .
      697               if v-value = ? then next _ii.
      698               create buf_temp-tekka-schema.
      699               assign
      700               buf_temp-tekka-schema.host = 'tekka'
      701               buf_temp-tekka-schema.obj-num = v-obj-num
      702               buf_temp-tekka-schema.obj-name = v-obj-name
      703               buf_temp-tekka-schema.num-records = v-num-records
      704               buf_temp-tekka-schema.size_ = v-size_
      705               buf_temp-tekka-schema.field-num = jj
      706               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
      707               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
      708                                                  then entry(2, entry(2, v-value, '#'), ':')
      709                                                  else '':U)
      710               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
      711               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
      712               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
      713                                                           , 'C,I,I,I,D,D,D,D,D':U)
      714               no-error
      715               .
      716               if error-status:error then do:
      717                 delete buf_temp-tekka-schema.
      718                 next _jj.
      719               end.
      720               run alienini-getkey in this-procedure (
      721                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      722                                                       ,input 'obj' + string(ii, '999') + 'name'
      723                                                       ,input 'n' + string(jj, '999')
      724                                                       ,output v-value) no-error .
      725               if v-value <> ? then
      726               buf_temp-tekka-schema.field-name = v-value.
      727             end.
      728           end.
      729         end.
      730         ii-tekka = ii - 1.
      731        if p-obj-list <> 'ALL' then do:
      732         if ii-tekka <> ii-ibs then do:
      733           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
      734                                   , ii-ibs
      735                                   , ii-tekka).
      736         end.
      737        end.
      738        for each buf_temp-tekka-schema where
      739               buf_temp-tekka-schema.host = 'tekka':
      740          find first buf2_temp-tekka-schema where
      741                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
      742                AND buf2_temp-tekka-schema.host = 'ibs'
      743                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
      744          if not available buf2_temp-tekka-schema then do:
      745           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
      746                                   , buf_temp-tekka-schema.field-num
      747                                   , buf_temp-tekka-schema.obj-num).
      748          end.
      749          buffer-compare buf_temp-tekka-schema
      750          to buf2_temp-tekka-schema
      751          save result in v-result.
      752          if v-result <> '':U then do:
      753           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
      754                                   , buf_temp-tekka-schema.field-num
      755                                   , buf_temp-tekka-schema.obj-num).
      756          end.
      757        end.
      758     end.
      759   end procedure.
      760   FUNCTION set-Sx returns character (input p-string as character):
      761   return p-string.
      762   END FUNCTION.
      763   FUNCTION get-Sx returns character (input p-string  as character):
      764   return p-string.
      765   END FUNCTION.
      766   FUNCTION set-B returns character (input p-string  as character):
      767   return chr(integer(p-string)).
      768   END FUNCTION.
      769   FUNCTION get-B returns character (input p-string  as character):
      770   return string(asc(p-string)).
      771   END FUNCTION.
      772   FUNCTION set-BF returns character (input p-string  as character):
      773   define variable v-dopi as integer no-undo .
      774   define variable ii as integer no-undo .
      775   do ii = 1 to 8:
      776     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      777   end.
      778   return chr(v-dopi).
      779   END FUNCTION.
      780   FUNCTION get-BF returns character (input p-string  as character):
      781   define variable v-dopi as integer no-undo .
      782   define variable v-dops as character no-undo .
      783   define variable ii as integer no-undo .
      784   v-dopi = asc(p-string).
      785   do ii = 8 to 1 BY -1:
      786     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      787   end.
      788   return v-dops.
      789   END FUNCTION.
      790   FUNCTION set-BN returns character (input p-string  as character
      791                                     ,input p-bin-group as character):
      792   define variable v-dopi as integer no-undo .
      793   define variable ii as integer no-undo .
      794   define variable jj as integer no-undo .
      795   define variable v-grp-nums as integer no-undo .
      796   define variable v-dopi2 as integer no-undo .
      797   v-grp-nums = num-entries(p-bin-group).
      798   do jj = 0 to v-grp-nums - 1:
      799     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
      800     do ii = 1 to 8:
      801       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      802     end.
      803   end.
      804   return chr(v-dopi).
      805   END FUNCTION.
      806   FUNCTION get-BN returns character (input p-string  as character
      807                                     ,input p-bin-group as character):
      808   define variable v-dopi as integer no-undo .
      809   define variable v-dops as character no-undo .
      810   define variable v-grp-nums as integer no-undo .
      811   define variable ii as integer no-undo .
      812   define variable jj as integer no-undo .
      813   v-dopi = asc(p-string).
      814   v-grp-nums = num-entries(p-bin-group).
      815   do jj = 1 to v-grp-nums:
      816   do ii = 8 to 1 BY -1:
      817     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      818   end.
      819   end.
      820   return v-dops.
      821   END FUNCTION.
      822   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   procedure cur-time :
      824      define output parameter p-today as date      no-undo .
      825      define output parameter p-time  as integer   no-undo .
      826     do
      827     on error undo, return error
      828     :
      829       define variable v-date1 as date      no-undo .
      830       define variable v-date2 as date      no-undo .
      831       define variable v-time  as integer   no-undo .
      832       assign
      833         v-date1 = today
      834         v-time  = time
      835         v-date2 = today
      836       .
      837       if v-date1 <> v-date2
      838       then do:
      839         assign
      840           v-date1 = today
      841           v-time  = v-time
      842         .
      843       end.
      844       assign
      845         p-today = v-date1
      846         p-time  = v-time
      847       .
      848     end.
      849   end.
      850   function cur-time-date returns character
      851   :
      852     return string(today, '99/99/9999':U) .
      853   end.
      854   function cur-time-mjd returns decimal
      855   :
      856     define variable v-date as date      no-undo .
      857     define variable v-time as integer   no-undo .
      858     run cur-time in this-procedure
      859       (output v-date
      860       ,output v-time
      861       ) .
      862     return integer(v-date) - 2400002 + (v-time / 86400) .
      863   end.
      864   function cur-time-get-ending-index returns integer
      865   (input p-number as integer
      866   )
      867   :
      868     if p-number < 0
      869     or p-number = ?
      870     then do:
      871       return 1 .
      872     end.
      873     define variable v-rest as integer   no-undo .
      874     assign
      875       p-number = p-number modulo 100
      876     .
      877     if p-number < 20
      878     then do:
      879       assign
      880         v-rest = p-number
      881       .
      882     end.
      883     else do:
      884       assign
      885         v-rest = p-number modulo 10
      886       .
      887     end.
      888     case v-rest :
      889       when 1
      890       then do:
      891         return 2 .
      892       end.
      893       when 2 or
      894       when 3 or
      895       when 4
      896       then do:
      897         return 3 .
      898       end.
      899       otherwise do:
      900         return 1 .
      901       end.
      902     end case .
      903   end.
      904   procedure cur-time-mjd-to-date :
      905      define input  parameter i-mjd-diff as decimal no-undo.
      906      define output parameter o-Date     as date    no-undo.
      907      define output parameter o-Time     as integer no-undo.
      908      define variable v-day-number as integer   no-undo .
      909      if    i-mjd-diff < 0
      910         or i-mjd-diff = ?
      911      then do:
      912         return "?" .
      913      end.
      914      assign
      915         v-day-number = truncate(i-mjd-diff,0).
      916         o-Date = date(v-day-number + 2400002).
      917         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      918     .
      919   end.
      920   function cur-time-mjd-to-string returns character
      921   (input p-mjd-diff as decimal
      922   )
      923   :
      924     define variable v-day-number as integer   no-undo .
      925     define variable v-seconds    as integer   no-undo .
      926     define variable v-hour       as integer   no-undo .
      927     define variable v-min        as integer   no-undo .
      928     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      929     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      930     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      931     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      932     if p-mjd-diff < 0
      933     or p-mjd-diff = ?
      934     then do:
      935       return "?" .
      936     end.
      937     assign
      938       v-day-number = integer(truncate(p-mjd-diff,0))
      939       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      940     .
      941     if v-seconds > 86400
      942     then do:
      943       assign
      944         v-seconds = 86400 - 1
      945       .
      946     end.
      947     if v-seconds < 0
      948     then do:
      949       assign
      950         v-seconds = 0
      951       .
      952     end.
      953     assign
      954       v-hour = truncate(v-seconds / 3600, 0)
      955     .
      956     assign
      957       v-seconds = v-seconds modulo 3600
      958     .
      959     assign
      960       v-min = truncate(v-seconds / 60, 0)
      961     .
      962     assign
      963       v-seconds = v-seconds modulo 60
      964     .
      965     return
      966         (if v-day-number <> 0
      967           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      968           else ""
      969         )
      970       + (if v-day-number <> 0 or v-hour <> 0
      971           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      972           else ""
      973         )
      974       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      975           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      976           else ""
      977         )
      978       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      979       .
      980   end.
      981   function cur-time-string returns character
      982   :
      983     define variable v-date as date      no-undo .
      984     define variable v-time as integer   no-undo .
      985     run cur-time in this-procedure
      986       (output v-date
      987       ,output v-time
      988       ) .
      989     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      990   end.
      991   function cur-time-string-sec returns character
      992   :
      993     define variable v-date as date      no-undo .
      994     define variable v-time as integer   no-undo .
      995     run cur-time in this-procedure
      996       (output v-date
      997       ,output v-time
      998       ) .
      999     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1000   end.
     1001   function cur-time-custom  returns character
     1002   (input p-prefix as character
     1003   ,input p-date-format as character
     1004   ,input p-delimiter as character
     1005   ,input p-time-format as character
     1006   ,input p-suffix as character
     1007   )
     1008   :
     1009     define variable v-date as date      no-undo .
     1010     define variable v-time as integer   no-undo .
     1011     run cur-time in this-procedure
     1012       (output v-date
     1013       ,output v-time
     1014       ) .
     1015     return
     1016       p-prefix
     1017       + string(v-date, p-date-format)
     1018       + p-delimiter
     1019       + string(v-time, p-time-format)
     1020       + p-suffix
     1021       .
     1022   end.
     1023   function cur-time-print  returns character
     1024   :
     1025     define variable v-date as date      no-undo .
     1026     define variable v-time as integer   no-undo .
     1027     run cur-time in this-procedure
     1028       (output v-date
     1029       ,output v-time
     1030       ) .
     1031     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1032   end.
     1033   function cur-time-datetime returns datetime
     1034   :
     1035     define variable v-char as character no-undo .
     1036     define variable v-datetime as datetime no-undo .
     1037     v-char = cur-time-string().
     1038     v-datetime = datetime(v-char).
     1039     return  v-datetime.
     1040   end.
     1041   function cur-time-string-msec returns character
     1042   :
     1043     define variable v-date as datetime  no-undo .
     1044     v-date = now.
     1045     return string(v-date) .
     1046   end.
     1047   define temp-table tt-shift-info no-undo
     1048   field is-current as logical
     1049   field is-petrol as logical
     1050   field num-recs-petrol as decimal
     1051   field num-recs-petrol-prev as decimal
     1052   field num-recs as decimal
     1053   field num-recs-prev as decimal
     1054   field jour-no as decimal
     1055   field rec-no as decimal
     1056   field z-count as integer
     1057   field chk-date as date
     1058   field info-from as character
     1059   field order as integer
     1060   field was-open as logical
     1061   field is-close as logical
     1062   field is-last-closed as logical
     1063   field tekka-date-chr as character
     1064   field tekka-time-chr as character
     1065   field shift-open-date-chr as character
     1066   field shift-open-time-chr as character
     1067   field shift-close-date-chr as character
     1068   field shift-close-time-chr as character
     1069   index pi is primary
     1070   info-from
     1071   is-petrol
     1072   z-count
     1073   chk-date
     1074   index pi2
     1075   info-from
     1076   is-petrol
     1077   z-count
     1078   is-current
     1079   index iorder
     1080   order
     1081   .
     1082   define variable ii               as integer   no-undo .
     1083   define variable jj               as integer   no-undo .
     1084   define variable tempfile-tsk     as character no-undo .
     1085   define variable loc#log          as logical   no-undo .
     1086   define variable res              as character no-undo .
     1087   define variable p-param          as character no-undo .
     1088   define variable v-dir-path       as character no-undo .
     1089   define variable v-temp-dir       as character no-undo .
     1090   define variable err-file         as character no-undo .
     1091   define variable ss               as character no-undo .
     1092   define variable v-field-value    as character no-undo .
     1093   define variable v-field-value-ibm866  as character no-undo .
     1094   define variable v-obj-list       as character no-undo .
     1095   define variable ch#TekkaApplication as com-handle no-undo .
     1096   define variable v-dopi as integer no-undo .
     1097   define variable v-error          as character no-undo .
     1098   define variable v-next-obj-num as integer no-undo .
     1099   define variable v-if-next-obj-num as integer no-undo .
     1100   define variable rv as integer no-undo .
     1101   define variable v-return-value as character no-undo .
     1102   define variable v-is-spool-request as logical no-undo .
     1103   define variable v-closed-shift-num as integer no-undo .
     1104   define variable v-closed-shift-info as character no-undo .
     1105   define variable v-date-time-info as character no-undo .
     1106   define variable v-num-recs-info as character no-undo .
     1107   define variable v-petrol-exist as logical no-undo .
     1108   define variable v-record-shift as integer no-undo .
     1109   define variable v-string as character no-undo .
     1110   define stream for-task .
     1111   define stream TekkaStream .
     1112   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1113   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1114   define buffer sec_temp-tekka-tsk for temp-tekka-tsk.
     1115   do
     1116   on error undo, return error return-value
     1117   :
     1118     assign
     1119       p-param = session :parameter
     1120     .
     1121     if num-entries(p-param) <> 4 then do:
     1122       message
     1123         vss-workfile vss-revision vss-description skip
     1124         "Неправильный вызов процедуры обмена информацией с ЭККА МАРИЯ в дополнительной сессии PROGRESS" skip
     1125         "Неверное количество параметров" num-entries(p-param) skip
     1126         "Параметры" p-param skip
     1127         view-as alert-box error.
     1128       run write-err in this-procedure ( input "Ошибка параметров") .
     1129        quit .
     1130     end.
     1131     assign
     1132     v-dir-path     = trim(entry(1, p-param), chr(34))
     1133     err-file       = entry(2, p-param)
     1134     tempfile-tsk   = entry(3, p-param)
     1135     v-temp-dir     = trim(entry(4, p-param), chr(34))
     1136     .
     1137     define variable v-full-path        as character no-undo .
     1138     define variable v-path             as character no-undo .
     1139     define variable v-file-name        as character no-undo .
     1140     define variable v-file-name-no-ext as character no-undo .
     1141     define variable v-file-name-ext    as character no-undo .
     1142     assign
     1143       file-info:file-name = v-temp-dir
     1144     .
     1145     if not (file-info:file-type <> ?
     1146       and index( file-info:file-type, "D":U ) <> 0)
     1147     then do:
     1148       run Write-err in this-procedure ( input "Неизвестное имя директории обмена") .
     1149       quit.
     1150     end.
     1151     run make-temp-tekka-tsk in this-procedure ( output v-obj-list) no-error .
     1152     if error-status :error then do:
     1153       message
     1154         vss-workfile vss-revision vss-description skip
     1155         "Ошибка при чтении параметров коммуникации из файла" skip
     1156         "Файл параметров коммуникации" tempfile-tsk skip
     1157         error-status :get-message(1) skip
     1158         return-value skip
     1159         view-as alert-box error .
     1160       run Write-err in this-procedure ( input "Неверные данные в файле параметров коммуникации") .
     1161       quit.
     1162     end.
     1163     run waitfram-show in this-procedure ( input "Ждите! Идет обмен информацией...").
     1164   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1165   if valid-handle(ch#TekkaApplication) then
     1166   RELEASE OBJECT ch#TekkaApplication no-error.
     1167     CREATE "AddIn.TAddIn" ch#TekkaApplication no-error.
     1168     if error-status:error then DO:
     1169       run  ClearTekka in this-procedure .
     1170       run  write-err in this-procedure ( input "Ошибка при вызове OLE-сервера") .
     1171       quit.
     1172     End.
     1173     res = ch#TekkaApplication:SetDataPath(v-dir-path).
     1174     if res <> '0' then do:
     1175       run  ClearTekka in this-procedure .
     1176       run  write-err in this-procedure (input substitute("Неверная директория OLE-сервера &1 или другая ошибка(код ошибки &2)"
     1177                                               , v-dir-path
     1178                                               , res)) .
     1179       quit.
     1180     end.
     1181         _tasks:
     1182     for each temp-tekka-tsk
     1183     break
     1184     by temp-tekka-tsk.order-num
     1185     by temp-tekka-tsk.range
     1186     by temp-tekka-tsk.obj-num
     1187     :
     1188       if temp-tekka-tsk.filename = '':u
     1189       and temp-tekka-tsk.send-get <> 'task':U then next.
     1190       case temp-tekka-tsk.send-get:
     1191         when 'send':U then do:
     1192           if temp-tekka-tsk.by-record then do:
     1193             v-record-shift = temp-tekka-tsk.min-plu - 1.
     1194           end.
     1195           else do:
     1196             v-record-shift = 0.
     1197           end.
     1198           if not temp-tekka-tsk.filename begins '-' then do:
     1199             if v-full-path <> '':U
     1200             and last-of( temp-tekka-tsk.range)
     1201             then do:
     1202               OS-delete value(v-full-path).
     1203             end.
     1204             run gbl/filename.p (
     1205                input  temp-tekka-tsk.filename
     1206               ,output v-full-path
     1207               ,output v-path
     1208               ,output v-file-name
     1209               ,output v-file-name-no-ext
     1210               ,output v-file-name-ext
     1211               ) .
     1212             v-dopi = ch#TekkaApplication:hook().
     1213             if not temp-tekka-tsk.by-record then do:
     1214               res = ch#TekkaApplication:CreateObj(temp-tekka-tsk.obj-num, 0).
     1215               if res <> '1' then do:
     1216                 run write-err in this-procedure ( input substitute("Ошибка при попытке создать объект &1 в памяти", temp-tekka-tsk.obj-num)) .
     1217                 quit.
     1218               end.
     1219             end.
     1220             input stream TekkaStream from value(temp-tekka-tsk.filename) .
     1221             repeat :
     1222               create temp-tekka-record.
     1223               assign
     1224               temp-tekka-record.obj-num = temp-tekka-tsk.obj-num
     1225               temp-tekka-record.plu = ?
     1226               .
     1227               import stream TekkaStream unformatted ss .
     1228               if temp-tekka-tsk.num-fields <> num-entries(ss, chr(4) ) then do:
     1229               end.
     1230               ii = integer(entry(1, ss, chr(3))).
     1231               assign
     1232               temp-tekka-record.plu = ii
     1233               temp-tekka-record.body = (if num-entries(ss, chr(3)) > 1
     1234                                         then entry(2, ss, chr(3)) else '':U)
     1235               .
     1236             end.
     1237             input stream TekkaStream close.
     1238             for each buf_temp-tekka-tsk where
     1239                     buf_temp-tekka-tsk.obj-num = temp-tekka-tsk.obj-num:
     1240               buf_temp-tekka-tsk.filename = '-' + buf_temp-tekka-tsk.filename.
     1241             end.
     1242           end.
     1243           if temp-tekka-tsk.by-record then do:
     1244             res = ch#TekkaApplication:CreateObjN(temp-tekka-tsk.obj-num
     1245                                           ,(temp-tekka-tsk.max-plu - temp-tekka-tsk.min-plu + 1 )
     1246                                           ,temp-tekka-tsk.min-plu - 1 ).
     1247             if res <> '1' then do:
     1248               run write-err in this-procedure ( input substitute("Ошибка при попытке создать объект &1 в памяти", temp-tekka-tsk.obj-num)) .
     1249               quit.
     1250             end.
     1251           end.
     1252           if temp-tekka-tsk.binary then do:
     1253             if temp-tekka-tsk.shift-fields <> 0 then do:
     1254               v-dopi = ch#TekkaApplication:StartGetObj(string(temp-tekka-tsk.obj-num)
     1255                                               ,temp-tekka-tsk.cash-num-char
     1256                                               ,temp-tekka-tsk.port-num
     1257                                               ,temp-tekka-tsk.way
     1258                                               ,temp-tekka-tsk.pswd  ).
     1259               run waiting in this-procedure ( input temp-tekka-tsk.obj-name, input temp-tekka-tsk.waiting-sek) no-error.
     1260               if error-status:error then do:
     1261                 run write-err in this-procedure ( input error-status:get-message(1) ) .
     1262                 quit.
     1263               end.
     1264               if return-value <> '':u then do:
     1265                 run write-err in this-procedure ( input return-value  ) .
     1266                 quit.
     1267               end.
     1268                 if temp-tekka-tsk.shift-fields < 0 then
     1269                 temp-tekka-tsk.shift-fields = 0.
     1270               end.
     1271             end.
     1272           _record:
     1273           for each temp-tekka-record where
     1274                    temp-tekka-record.obj-num = temp-tekka-tsk.obj-num
     1275                and temp-tekka-record.plu >= temp-tekka-tsk.min-plu
     1276                and temp-tekka-record.plu <= temp-tekka-tsk.max-plu
     1277           by
     1278           temp-tekka-record.plu:
     1279             if temp-tekka-record.plu = ? then do:
     1280               delete temp-tekka-record.
     1281               next _record.
     1282             end.
     1283             if temp-tekka-record.body = '':U then do:
     1284               v-error = ch#TekkaApplication:SetFIeld(temp-tekka-record.plu , 1, '':U).
     1285               if v-error <> '1' then do:
     1286                 run write-err in this-procedure ( input substitute("Устанавливаемое поле в объекте не существует: " +
     1287                                                                     "очищаемое поле 1 запись &2 объект &3&4"
     1288                                                                     , chr(10)
     1289                                                                     , temp-tekka-record.plu
     1290                                                                     , temp-tekka-tsk.obj-num
     1291                                                                     , ("|" + v-error + "|")
     1292                                                                     )
     1293                                               ) .
     1294                 quit.
     1295               end.
     1296             end.
     1297             else do:
     1298               _jj:
     1299               do jj = 1 to temp-tekka-tsk.num-fields:
     1300                   .
     1301                 v-field-value = entry(jj, temp-tekka-record.body, chr(4)) .
     1302                 if v-field-value = chr(63) then do:
     1303                   next _jj.
     1304                 end.
     1305                 v-error = ch#TekkaApplication:SetFIeld(temp-tekka-record.plu, jj  +  temp-tekka-tsk.shift-fields, v-field-value).
     1306                 if v-error <> '1' then do:
     1307                   run write-err in this-procedure ( input substitute("Устанавливаемое поле в объекте не существует: " +
     1308                                                                       "поле &2 запись &3 объект &4: &5"
     1309                                                                       , chr(10)
     1310                                                                       , jj + temp-tekka-tsk.shift-fields
     1311                                                                       , temp-tekka-record.plu
     1312                                                                       , temp-tekka-tsk.obj-num
     1313                                                                       , v-error
     1314                                                                       )
     1315                                                 ) .
     1316                   quit.
     1317                 end.
     1318               END.
     1319             end.
     1320             delete temp-tekka-record.
     1321           end.
     1322           if temp-tekka-tsk.by-record then do:
     1323             res = ch#TekkaApplication:StartPutObj(temp-tekka-tsk.cash-num-char
     1324                                             ,temp-tekka-tsk.port-num
     1325                                             ,temp-tekka-tsk.way
     1326                                             ,temp-tekka-tsk.pswd  ).
     1327           end.
     1328           else do:
     1329             res = ch#TekkaApplication:StartPutObj(temp-tekka-tsk.cash-num-char
     1330                                             ,temp-tekka-tsk.port-num
     1331                                             ,temp-tekka-tsk.way
     1332                                             ,temp-tekka-tsk.pswd  ).
     1333           end.
     1334           run waiting in this-procedure ( input temp-tekka-tsk.obj-name, input temp-tekka-tsk.waiting-sek) no-error.
     1335           if error-status:error then do:
     1336             run write-err in this-procedure ( input error-status:get-message(1) ) .
     1337             quit.
     1338           end.
     1339           if return-value <> '':u then do:
     1340             run write-err in this-procedure ( input return-value  ) .
     1341             quit.
     1342           end.
     1343         end.
     1344         when 'get':U then do:
     1345           for each temp-tekka-record:
     1346             delete temp-tekka-record.
     1347           end.
     1348           v-dopi = ch#TekkaApplication:hook().
     1349           if not temp-tekka-tsk.by-record then do:
     1350             ch#TekkaApplication:CreateObj(temp-tekka-tsk.obj-num, 0).
     1351             res = ch#TekkaApplication:CreateObj(temp-tekka-tsk.obj-num, 0).
     1352             if res <> '1' then do:
     1353               run write-err in this-procedure ( input substitute("Ошибка при попытке создать объект &1 в памяти", temp-tekka-tsk.obj-num)) .
     1354               quit.
     1355             end.
     1356           end.
     1357           else do:
     1358             if not v-is-spool-request
     1359             and lookup(string(temp-tekka-tsk.obj-num), '26,27,28,29,30,31,32,33,16,17,42,43':U) > 0 then do:
     1360               assign
     1361               v-is-spool-request = yes
     1362               .
     1363               v-petrol-exist = tekka-is-petrol-journal (input temp-tekka-tsk.obj-num).
     1364             end.
     1365             if v-is-spool-request
     1366             and v-next-obj-num = 0
     1367             and tekka-is-first-journal(temp-tekka-tsk.obj-num)
     1368             and tekka-is-closed-shift-journal(temp-tekka-tsk.obj-num) > 0 then do:
     1369               v-next-obj-num = 0.
     1370               v-if-next-obj-num = 0.
     1371             end.
     1372             if v-next-obj-num > 0
     1373             and temp-tekka-tsk.obj-num <> v-next-obj-num then do:
     1374               next _tasks.
     1375             end.
     1376             v-next-obj-num = 0.
     1377             if v-is-spool-request = yes
     1378             and temp-tekka-tsk.other-info <> '':U
     1379             and tekka-is-first-journal(temp-tekka-tsk.obj-num) = yes
     1380             then do:
     1381               v-return-value = ''.
     1382               run get-spool-optimize in this-procedure ( buffer temp-tekka-tsk, v-petrol-exist ) no-error .
     1383               if not error-status:error then do:
     1384                 v-return-value = return-value.
     1385                 if v-date-time-info <> '':U then do:
     1386                   output stream TekkaStream to value(temp-tekka-tsk.filename).
     1387                   put stream TekkaStream unformatted
     1388                   temp-tekka-tsk.obj-num chr(3)
     1389                   -1 chr(3)
     1390                   "tekka-date-time=" v-date-time-info '=' temp-tekka-tsk.cash-num
     1391                   skip.
     1392                   output stream TekkaStream  close.
     1393                 end.
     1394                 do rv = 1 to num-entries(v-return-value):
     1395                   if entry(rv, v-return-value) begins 'next-object=' then do:
     1396                     assign
     1397                     v-next-obj-num = integer(entry(2, entry(rv, v-return-value), '=')).
     1398                     next _tasks.
     1399                   end.
     1400                   if entry(rv, v-return-value) begins 'if-read-0-then-next-object=' then do:
     1401                     assign
     1402                     v-if-next-obj-num = integer(entry(2, entry(rv, v-return-value), '=')).
     1403                   end.
     1404                   if entry(rv, v-return-value) begins 'close-shift=' then do:
     1405                     output stream TekkaStream to value(temp-tekka-tsk.filename) append.
     1406                     put stream TekkaStream unformatted
     1407                     temp-tekka-tsk.obj-num chr(3)
     1408                     0 chr(3)
     1409                     entry(rv, v-return-value)
     1410                     (if integer(left-trim(entry(rv, v-return-value), 'close-shift=')) = v-closed-shift-num
     1411                      then (chr(4) + v-closed-shift-info)
     1412                      else '':U)
     1413                     skip.
     1414                     output stream TekkaStream  close.
     1415                   end.
     1416                   if entry(rv, v-return-value) = 'next' then do:
     1417                     next _tasks.
     1418                   end.
     1419                   if entry(rv, v-return-value) begins "min-plu=" then do:
     1420                     temp-tekka-tsk.min-plu = integer(entry(2, entry(rv, v-return-value), '=':U)).
     1421                     if temp-tekka-tsk.secondary > 0 then do:
     1422                       find first sec_temp-tekka-tsk where
     1423                                 sec_temp-tekka-tsk.obj-num = temp-tekka-tsk.secondary no-error .
     1424                       if available sec_temp-tekka-tsk then do:
     1425                         assign
     1426                         sec_temp-tekka-tsk.min-plu =  10000 * (decimal(entry(2, entry(rv, v-return-value), '=':U)) -
     1427                                                       temp-tekka-tsk.min-plu)
     1428                         .
     1429                       end.
     1430                     end.
     1431                   end.
     1432                 end.
     1433               end.
     1434             end.
     1435           end.
     1436           v-dopi = ch#TekkaApplication:StartGetObj(string(temp-tekka-tsk.obj-num)
     1437                                           ,temp-tekka-tsk.cash-num-char
     1438                                           ,temp-tekka-tsk.port-num
     1439                                           ,temp-tekka-tsk.way
     1440                                           ,temp-tekka-tsk.pswd  ).
     1441           run waiting in this-procedure ( input temp-tekka-tsk.obj-name, input temp-tekka-tsk.waiting-sek) no-error.
     1442           if error-status:error then do:
     1443             run write-err in this-procedure ( input error-status:get-message(1) ) .
     1444             quit.
     1445           end.
     1446           if return-value <> '':u then do:
     1447             run write-err in this-procedure ( input return-value  ) .
     1448             quit.
     1449           end.
     1450           if temp-tekka-tsk.by-record then do:
     1451             if temp-tekka-tsk.num-records = 0
     1452             or temp-tekka-tsk.num-records = ? then  do:
     1453               temp-tekka-tsk.num-records = ch#TekkaApplication:GetRecordsCount().
     1454             end.
     1455             if temp-tekka-tsk.max-plu = ? then do:
     1456               assign
     1457               temp-tekka-tsk.max-plu = temp-tekka-tsk.num-records.
     1458             end.
     1459             if temp-tekka-tsk.min-plu = ? then do:
     1460               assign
     1461               temp-tekka-tsk.min-plu = 0.
     1462             end.
     1463             if temp-tekka-tsk.num-records = 0 then do:
     1464               if v-if-next-obj-num > 0 then do:
     1465                 assign
     1466                 v-next-obj-num = v-if-next-obj-num
     1467                 v-if-next-obj-num  = 0
     1468                 .
     1469               end.
     1470               v-next-obj-num = tekka-get-next-obj-num ( input temp-tekka-tsk.obj-num, input v-petrol-exist).
     1471               NEXT _tasks.
     1472             end.
     1473             if temp-tekka-tsk.min-plu > temp-tekka-tsk.num-records
     1474             and v-is-spool-request = yes
     1475             and temp-tekka-tsk.num-records < tekka-get-max-journal-record-num  ( input temp-tekka-tsk.obj-num)
     1476             then do:
     1477               v-next-obj-num = tekka-get-next-obj-num ( input temp-tekka-tsk.obj-num, input v-petrol-exist).
     1478               NEXT _tasks.
     1479             end.
     1480             output stream TekkaStream to value(temp-tekka-tsk.filename) append.
     1481             if temp-tekka-tsk.num-fields = 0
     1482             or temp-tekka-tsk.num-fields = ? then do:
     1483               temp-tekka-tsk.num-fields = ch#TekkaApplication:GetFieldsCount().
     1484             end.
     1485             do ii = max(1, temp-tekka-tsk.min-plu) to minimum(temp-tekka-tsk.num-records, temp-tekka-tsk.max-plu):
     1486               do jj = 1 to temp-tekka-tsk.num-fields:
     1487                 v-field-value = ch#TekkaApplication:GetField(ii, jj).
     1488                 if jj = 1 then
     1489                 put stream TekkaStream unformatted
     1490                 temp-tekka-tsk.obj-num chr(3)
     1491                 ii chr(3).
     1492                 put stream TekkaStream unformatted
     1493                 v-field-value chr(4) .
     1494               end.
     1495               put stream TekkaStream unformatted skip.
     1496             END.
     1497             output stream TekkaStream  close.
     1498             if temp-tekka-tsk.num-records < tekka-get-max-journal-record-num  ( input temp-tekka-tsk.obj-num)
     1499             and temp-tekka-tsk.secondary = 0
     1500             then do:
     1501               assign
     1502               v-next-obj-num = tekka-get-next-obj-num ( input temp-tekka-tsk.obj-num, input v-petrol-exist).
     1503             end.
     1504           end.
     1505           else do:
     1506             v-error = ch#TekkaApplication:SaveXml(temp-tekka-tsk.filename).
     1507             if v-error <> '0' then do:
     1508               run write-err in this-procedure ( input v-error ).
     1509               quit.
     1510             end.
     1511           end.
     1512         end.
     1513         when 'task':U then do:
     1514           v-string = substitute("select &1 from &2 where &3"
     1515                                 ,temp-tekka-tsk.obj-name
     1516                                 ,temp-tekka-tsk.cash-num-char
     1517                                 ,temp-tekka-tsk.other-info).
     1518           v-error = ch#TekkaApplication:AddTask( v-string).
     1519           if v-error <> "Ошибок нет." then do:
     1520             run write-err in this-procedure ( input v-error ).
     1521             quit.
     1522           end.
     1523         end.
     1524       END CASE.
     1525     END.
     1526     if v-full-path <> '':U
     1527     then do:
     1528       OS-delete value(v-full-path).
     1529     end.
     1530     run ClearTekka in this-procedure .
     1531     PROCESS EVENTS.
     1532     run waitfram-hide in this-procedure .
     1533     run write-err in this-procedure ( input chr(10)) .
     1534     quit.
     1535     procedure ClearTekka :
     1536       do
     1537       on error undo, return error
     1538       :
     1539         run waitfram-hide in this-procedure .
     1540   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1541   if valid-handle(ch#TekkaApplication) then
     1542   RELEASE OBJECT ch#TekkaApplication no-error.
     1543         PROCESS EVENTS.
     1544       end.
     1545     end procedure.
     1546     procedure write-err :
     1547       do
     1548       on error undo, return error
     1549       :
     1550         define input parameter p-is-err as character no-undo .
     1551         run gbl/bat-err.p (
     1552            input err-file
     1553           ,input (if p-is-err <> "":U then p-is-err else "")
     1554           ).
     1555       end.
     1556     end.
     1557   end.
     1558   procedure make-temp-tekka-tsk :
     1559   define output parameter p-obj-list as character no-undo .
     1560     do
     1561     on error undo, return error return-value
     1562     :
     1563       define buffer buf_temp-tekka-tsk for temp-tekka-tsk .
     1564       for each buf_temp-tekka-tsk
     1565       on error undo, return error
     1566       :
     1567         delete buf_temp-tekka-tsk .
     1568       end.
     1569       input stream for-task from value( tempfile-tsk ) .
     1570       repeat
     1571       :
     1572         create buf_temp-tekka-tsk .
     1573         import stream for-task buf_temp-tekka-tsk .
     1574         assign
     1575         p-obj-list = p-obj-list + chr(44) + string(buf_temp-tekka-tsk.obj-num).
     1576       end.
     1577       input stream for-task close.
     1578       OS-delete value( tempfile-tsk ).
     1579       p-obj-list = trim(p-obj-list, chr(44)).
     1580     end.
     1581   end procedure.
     1582   procedure waiting :
     1583   define input parameter p-mess as character no-undo .
     1584   define input parameter p-waiting as integer no-undo .
     1585   define variable v-exec-time as integer no-undo .
     1586   define variable v-answer as character no-undo .
     1587   define variable v-start-time as int64     no-undo .
     1588   assign
     1589   v-start-time = etime
     1590   .
     1591   _do:
     1592   do while true:
     1593     assign
     1594     v-exec-time = (etime - v-start-time) / 1000
     1595     .
     1596     run waitfram-show in this-procedure ( input substitute("&1 Время ожидания &2"
     1597                                         , p-mess
     1598                                         , string(v-exec-time, "HH:MM:SS")))
     1599     .
     1600     v-answer = ch#TekkaApplication:GetStatus().
     1601     if v-answer = 'work' then next _do.
     1602     else leave _do.
     1603     if v-exec-time >= p-waiting then do:
     1604       return substitute("Превышено время ожидания: &1 ЭККА не ответила").
     1605     end.
     1606   end.
     1607   if v-answer = 'done' then return '':U.
     1608   v-error = ch#TekkaApplication:GetError().
     1609   if v-error = "Ошибок нет." then do:
     1610     return "Ошибок нет." .
     1611   end.
     1612   else do:
     1613   return v-error.
     1614   end.
     1615   end procedure.
     1616   procedure get-spool-optimize:
     1617   define parameter buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1618   define input parameter p-petrol-exist as logical no-undo .
     1619   define variable vvv as character no-undo .
     1620   define variable v-date as date no-undo .
     1621   define variable v-date-p as date no-undo .
     1622   define variable v-z-count as integer no-undo init 0.
     1623   define variable v-z-count-p as integer no-undo init 0.
     1624   define variable v-num-recs as decimal no-undo .
     1625   define variable v-num-recs-p as decimal no-undo .
     1626   DEFINE VARIABLE v-today as date no-undo .
     1627   DEFINE VARIABLE v-time as integer no-undo .
     1628   define variable v-is-petrol-journal as logical no-undo .
     1629   define variable v-is-closed-journal as integer no-undo .
     1630   define variable ii as integer no-undo .
     1631   define variable kk as integer no-undo .
     1632   define variable v-page-len as integer no-undo .
     1633   define variable v-page-len-p as integer no-undo .
     1634   define variable v-jour-no as integer no-undo .
     1635   define variable v-jour-no-p as integer no-undo .
     1636   define variable v-line-num as decimal no-undo .
     1637   define variable v-line-num-p as decimal no-undo .
     1638   define variable v-field-z-count as integer no-undo .
     1639   define variable v-field-z-count-p as integer no-undo .
     1640   define variable v-field-date as integer no-undo .
     1641   define variable v-field-date-p as integer no-undo .
     1642   define variable v-cd-num-recs as integer no-undo .
     1643   define variable v-prev-cd-num-recs as integer no-undo .
     1644   define variable v-cd-date as date no-undo .
     1645   define variable v-cd-date-chr as character no-undo .
     1646   define variable v-dopi as character no-undo .
     1647   define variable v-num-records as integer no-undo .
     1648   define variable v-year as integer no-undo .
     1649   define variable v-cd-z-count-orig as integer no-undo .
     1650   define variable v-cd-z-count as integer no-undo .
     1651   define variable v-cd-z-close as logical no-undo .
     1652   define variable v-prev-cd-z-count-orig as integer no-undo .
     1653   define variable v-prev-cd-z-count as integer no-undo .
     1654   define variable v-prev-cd-z-close as logical no-undo .
     1655   define variable v-obj-num as integer no-undo .
     1656   define variable v-to-read-obj-num as integer no-undo .
     1657   define variable v-to-read-num-recs as decimal no-undo .
     1658   define variable v-return-value as character no-undo .
     1659   define variable v-get-closed-shift-info as logical no-undo .
     1660   define buffer buf_tt-shift-info for tt-shift-info.
     1661   define buffer bufm_tt-shift-info for tt-shift-info.
     1662     do
     1663     on error undo, return error return-value
     1664     :
     1665       if p-petrol-exist then do:
     1666         assign
     1667         v-is-petrol-journal = tekka-is-petrol-journal(buf_temp-tekka-tsk.obj-num)
     1668         .
     1669         assign
     1670         v-is-closed-journal = tekka-is-closed-shift-journal(buf_temp-tekka-tsk.obj-num)
     1671         .
     1672         assign
     1673         v-date-p =  date( integer(entry(2, entry(4, buf_temp-tekka-tsk.other-info, chr(32)), '-':U))
     1674                       ,integer(entry(3, entry(4, buf_temp-tekka-tsk.other-info, chr(32)), '-':U))
     1675                       ,integer(entry(1, entry(4, buf_temp-tekka-tsk.other-info, chr(32)), '-':U))
     1676                       )
     1677         v-z-count-p = integer(entry(5, buf_temp-tekka-tsk.other-info, chr(32) ))
     1678         v-z-count-p = (if v-z-count-p = ? then 0 else v-z-count-p)
     1679         v-num-recs-p = integer(entry(6, buf_temp-tekka-tsk.other-info, chr(32) ))
     1680         v-num-recs-p = (if v-num-recs-p = ? then 0 else v-num-recs-p)
     1681         .
     1682       end.
     1683       assign
     1684       v-date =  date( integer(entry(2, entry(1, buf_temp-tekka-tsk.other-info, chr(32)), '-':U))
     1685                     ,integer(entry(3, entry(1, buf_temp-tekka-tsk.other-info, chr(32)), '-':U))
     1686                     ,integer(entry(1, entry(1, buf_temp-tekka-tsk.other-info, chr(32)), '-':U))
     1687                     )
     1688       v-z-count = integer(entry(2, buf_temp-tekka-tsk.other-info, chr(32) ))
     1689       v-z-count = (if v-z-count = ? then 0 else v-z-count)
     1690       v-num-recs = decimal(entry(3, buf_temp-tekka-tsk.other-info, chr(32) ))
     1691       v-num-recs = (if v-num-recs = ? then 0 else v-num-recs)
     1692       no-error .
     1693       if error-status:error then return .
     1694       if p-petrol-exist then do:
     1695         assign
     1696         v-page-len-p = 1489
     1697         v-jour-no-p = truncate (v-num-recs-p / 1489, 0)
     1698         v-line-num-p = v-num-recs-p MODULO 1489
     1699         v-field-z-count-p = 5
     1700         v-field-date-p  =  8
     1701         .
     1702       end.
     1703       assign
     1704       v-page-len = 2978
     1705       v-jour-no = truncate (v-num-recs / 2340, 0)
     1706       v-line-num = v-num-recs MODULO 2340
     1707       v-field-z-count = 1
     1708       v-field-date  = (6 + 0)
     1709       .
     1710       do ii = 1 to  (IF p-PETROL-exist THEN 2 ELSE 1):
     1711         find first buf_tt-shift-info where
     1712                   buf_tt-shift-info.info-from = 'IBS'
     1713               and buf_tt-shift-info.is-petrol = (if ii = 1 and p-petrol-exist then yes else no)
     1714               and buf_tt-shift-info.chk-date = (if ii = 1 and p-petrol-exist then v-date-p else v-date)
     1715               and buf_tt-shift-info.z-count = (if ii = 1 and p-petrol-exist then v-z-count-p else v-z-count)  no-error.
     1716         if not available buf_tt-shift-info then do:
     1717           create buf_tt-shift-info.
     1718           assign
     1719           buf_tt-shift-info.info-from = 'IBS'
     1720           buf_tt-shift-info.is-petrol = (if ii = 1 and p-petrol-exist then yes else no)
     1721           buf_tt-shift-info.chk-date = (if buf_tt-shift-info.is-petrol
     1722                                         then v-date-p
     1723                                         else v-date)
     1724           buf_tt-shift-info.num-recs = (if buf_tt-shift-info.is-petrol
     1725                                         then v-num-recs-p
     1726                                         else v-num-recs)
     1727           buf_tt-shift-info.z-count = (if buf_tt-shift-info.is-petrol
     1728                                        then v-z-count-p
     1729                                        else v-z-count)
     1730           buf_tt-shift-info.jour-no = (if buf_tt-shift-info.is-petrol
     1731                                        then v-jour-no-p
     1732                                        else v-jour-no)
     1733           buf_tt-shift-info.rec-no = (if buf_tt-shift-info.is-petrol
     1734                                       then v-line-num-p
     1735                                       else v-line-num)
     1736           buf_tt-shift-info.order = ii
     1737           buf_tt-shift-info.is-current = ?
     1738           buf_tt-shift-info.is-close = ?
     1739           .
     1740         end.
     1741       end.
     1742       v-dopi = ch#TekkaApplication:StartGetObj(string(0)
     1743                                       ,buf_temp-tekka-tsk.cash-num-char
     1744                                       ,buf_temp-tekka-tsk.port-num
     1745                                       ,buf_temp-tekka-tsk.way
     1746                                       ,buf_temp-tekka-tsk.pswd  ).
     1747       run waiting in this-procedure ( input buf_temp-tekka-tsk.obj-name, input buf_temp-tekka-tsk.waiting-sek) no-error.
     1748       if error-status:error then do:
     1749         run write-err in this-procedure ( input error-status:get-message(1) ) .
     1750         quit.
     1751       end.
     1752       if return-value <> '':u then do:
     1753         run write-err in this-procedure ( input return-value  ) .
     1754         quit.
     1755       end.
     1756       vvv = ch#TekkaApplication:GetInfo().
     1757       v-error = ch#TekkaApplication:GetError().
     1758       if v-error <> "Ошибок нет." then do:
     1759         run write-err in this-procedure ( input v-error).
     1760         quit.
     1761       end.
     1762       assign
     1763       v-prev-cd-z-count = integer(entry(1, vvv, chr(32) ))
     1764       v-prev-cd-z-close = (integer(entry(3, vvv, chr(32) )) = 1)
     1765       v-cd-z-count = integer(entry(2, vvv, chr(32) ))
     1766       v-cd-z-close = (integer(entry(4, vvv, chr(32) )) = 1)
     1767       no-error .
     1768       if error-status:error then do:
     1769         run write-err in this-procedure ( input substitute("Получены неверные данные о состоянии смен на кассе &1", buf_temp-tekka-tsk.cash-num)).
     1770         quit.
     1771       end.
     1772       assign
     1773       v-prev-cd-z-count-orig = v-prev-cd-z-count
     1774       v-prev-cd-z-count = (if v-prev-cd-z-count = 0 then 100 else v-prev-cd-z-count)
     1775       v-cd-z-count-orig = v-cd-z-count
     1776       v-cd-z-count  = (if v-cd-z-count = 0 then 100 else v-cd-z-count)
     1777       .
     1778       assign
     1779       v-closed-shift-num =  v-prev-cd-z-count
     1780       .
     1781       do ii = 1 to (if p-petrol-exist then 2 else 1):
     1782         if v-prev-cd-z-count-orig > 0 then do:
     1783           find first bufm_tt-shift-info where
     1784                     bufm_tt-shift-info.info-from = 'maria'
     1785                 and bufm_tt-shift-info.is-petrol = (ii = 1 and p-petrol-exist)
     1786                 and bufm_tt-shift-info.is-current = no no-error.
     1787           if available bufm_tt-shift-info then do:
     1788             if bufm_tt-shift-info.z-count = v-prev-cd-z-count then do:
     1789             end.
     1790             else do:
     1791               assign
     1792               bufm_tt-shift-info.is-close = yes.
     1793               create bufm_tt-shift-info.
     1794               assign
     1795               bufm_tt-shift-info.info-from = 'MARIA'
     1796               bufm_tt-shift-info.is-petrol = (ii = 1 and p-petrol-exist)
     1797               bufm_tt-shift-info.is-current = no
     1798               bufm_tt-shift-info.z-count = v-prev-cd-z-count
     1799               bufm_tt-shift-info.is-close = yes
     1800               bufm_tt-shift-info.was-open = yes
     1801               .
     1802             end.
     1803           end.
     1804           else do:
     1805               create bufm_tt-shift-info.
     1806               assign
     1807               bufm_tt-shift-info.info-from = 'MARIA'
     1808               bufm_tt-shift-info.is-petrol = (ii = 1 and p-petrol-exist)
     1809               bufm_tt-shift-info.is-current = no
     1810               bufm_tt-shift-info.z-count = v-prev-cd-z-count
     1811               bufm_tt-shift-info.is-close = yes
     1812               bufm_tt-shift-info.was-open = yes
     1813               .
     1814           end.
     1815         end.
     1816         if v-cd-z-count-orig > 0 then do:
     1817           find first bufm_tt-shift-info where
     1818                     bufm_tt-shift-info.info-from = 'maria'
     1819                 and bufm_tt-shift-info.is-petrol = (ii = 1 and p-petrol-exist)
     1820                 and bufm_tt-shift-info.is-current = yes no-error.
     1821           if available bufm_tt-shift-info then  do:
     1822             assign
     1823             bufm_tt-shift-info.was-open = (not v-cd-z-close)
     1824             .
     1825             if bufm_tt-shift-info.z-count <> v-cd-z-count then do:
     1826               assign
     1827               bufm_tt-shift-info.is-close = yes
     1828               bufm_tt-shift-info.was-open = yes
     1829               .
     1830               create bufm_tt-shift-info.
     1831               assign
     1832               bufm_tt-shift-info.info-from = 'MARIA'
     1833               bufm_tt-shift-info.is-petrol = (ii = 1 and p-petrol-exist)
     1834               bufm_tt-shift-info.is-current = yes
     1835               bufm_tt-shift-info.z-count = v-cd-z-count
     1836               bufm_tt-shift-info.was-open = (not v-cd-z-close)
     1837               .
     1838             end.
     1839           end.
     1840           else do:
     1841             create bufm_tt-shift-info.
     1842             assign
     1843             bufm_tt-shift-info.info-from = 'MARIA'
     1844             bufm_tt-shift-info.is-petrol = (ii = 1 and p-petrol-exist)
     1845             bufm_tt-shift-info.is-current = yes
     1846             bufm_tt-shift-info.z-count = v-cd-z-count
     1847             bufm_tt-shift-info.was-open = (not v-cd-z-close)
     1848             .
     1849           end.
     1850         end.
     1851       end.
     1852       for each buf_tt-shift-info where
     1853                 buf_tt-shift-info.info-from = 'IBS'
     1854             and buf_tt-shift-info.is-petrol = v-is-petrol-journal
     1855       by buf_tt-shift-info.order:
     1856         v-get-closed-shift-info = no.
     1857         for each bufm_tt-shift-info where
     1858               bufm_tt-shift-info.info-from = 'maria'
     1859           and bufm_tt-shift-info.is-petrol = v-is-petrol-journal
     1860           and bufm_tt-shift-info.z-count = buf_tt-shift-info.z-count
     1861         by bufm_tt-shift-info.order:
     1862           if bufm_tt-shift-info.is-close
     1863           and bufm_tt-shift-info.z-count = v-closed-shift-num
     1864           then do:
     1865             if bufm_tt-shift-info.shift-open-date-chr = "" then do:
     1866               v-get-closed-shift-info = yes.
     1867               run get-closed-shift-info in this-procedure ( buffer buf_temp-tekka-tsk
     1868                                                           , buffer bufm_tt-shift-info
     1869                                                           , output v-closed-shift-info
     1870                                                           , output v-date-time-info
     1871                                                           , output v-num-recs-info
     1872                                                           ) no-error .
     1873             end.
     1874             else do:
     1875               v-get-closed-shift-info = yes.
     1876               assign
     1877               v-closed-shift-info = bufm_tt-shift-info.shift-open-date-chr + chr(4) +
     1878                                     bufm_tt-shift-info.shift-open-time-chr + chr(4) +
     1879                                     bufm_tt-shift-info.shift-close-date-chr + chr(4) +
     1880                                     bufm_tt-shift-info.shift-close-time-chr
     1881               v-date-time-info    =  bufm_tt-shift-info.tekka-date-chr + chr(4) +
     1882                                      bufm_tt-shift-info.tekka-time-chr
     1883               .
     1884             end.
     1885             assign
     1886             v-return-value = v-return-value + chr(44) +
     1887                             substitute("close-shift=&1", bufm_tt-shift-info.z-count).
     1888             assign
     1889             buf_tt-shift-info.is-current = no
     1890             buf_tt-shift-info.is-close = yes
     1891             .
     1892           end.
     1893           if bufm_tt-shift-info.is-current
     1894           and bufm_tt-shift-info.z-count = v-cd-z-count then do:
     1895             assign
     1896             buf_tt-shift-info.is-current = yes
     1897             buf_tt-shift-info.is-close = no
     1898             .
     1899             if v-is-closed-journal > 0
     1900             then do:
     1901               assign
     1902               v-return-value = v-return-value + chr(44) + 'next-object=' +
     1903                               string(tekka-get-next-obj-num ( input buf_temp-tekka-tsk.obj-num, input v-petrol-exist)).
     1904               return v-return-value.
     1905             end.
     1906           end.
     1907         end.
     1908         if not v-get-closed-shift-info then do:
     1909           run get-closed-shift-info in this-procedure ( buffer buf_temp-tekka-tsk
     1910                                                       , buffer bufm_tt-shift-info
     1911                                                       , output v-closed-shift-info
     1912                                                       , output v-date-time-info
     1913                                                       , output v-num-recs-info
     1914                                                       ) no-error .
     1915           assign
     1916           v-return-value = v-return-value + chr(44) +
     1917                           substitute("close-shift=&1", v-prev-cd-z-count).
     1918         end.
     1919         if buf_tt-shift-info.is-close = (v-is-closed-journal > 0) then do:
     1920           assign
     1921           v-num-recs = (if buf_tt-shift-info.num-recs = 0.0 then 0.0 else (buf_tt-shift-info.num-recs + 1.0001))
     1922           v-obj-num = buf_temp-tekka-tsk.obj-num.
     1923           assign
     1924           v-to-read-obj-num =  tekka-get-obj-num ( input v-num-recs
     1925                                                   ,input v-is-petrol-journal
     1926                                                   ,input (v-is-closed-journal = 0)
     1927                                                   ,output v-to-read-num-recs).
     1928           if buf_temp-tekka-tsk.obj-num <> v-to-read-obj-num then do:
     1929             assign
     1930             v-return-value = v-return-value + chr(44) + "next".
     1931           end.
     1932           assign
     1933           v-return-value = v-return-value + chr(44) + substitute("min-plu=&1", v-to-read-num-recs).
     1934           return v-return-value.
     1935         end.
     1936       end.
     1937       return v-return-value .
     1938     end.
     1939   END PROCEDURE.
     1940   procedure get-closed-shift-info  :
     1941   define parameter buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1942   define parameter buffer bufm_tt-shift-info  for tt-shift-info.
     1943   define output parameter p-closed-shift-info as character no-undo .
     1944   define output parameter p-date-time-info as character no-undo .
     1945   define output parameter p-num-recs-info as character no-undo .
     1946   define variable v-dopi as character no-undo .
     1947   define variable jj as integer no-undo .
     1948   define variable kk as integer no-undo .
     1949   define variable v-field-value as character no-undo .
     1950     do
     1951     on error undo, return error return-value
     1952     :
     1953       v-dopi = ch#TekkaApplication:StartGetObj (
     1954                                        string(15)
     1955                                       ,buf_temp-tekka-tsk.cash-num-char
     1956                                       ,buf_temp-tekka-tsk.port-num
     1957                                       ,buf_temp-tekka-tsk.way
     1958                                       ,buf_temp-tekka-tsk.pswd  ).
     1959       run waiting in this-procedure ( input buf_temp-tekka-tsk.obj-name, input buf_temp-tekka-tsk.waiting-sek) no-error.
     1960       if error-status:error then do:
     1961         run write-err in this-procedure ( input error-status:get-message(1) ) .
     1962         quit.
     1963       end.
     1964       if return-value <> '':u then do:
     1965         run write-err in this-procedure ( input return-value  ) .
     1966         quit.
     1967       end.
     1968       if not available bufm_tt-shift-info then do:
     1969         do jj =  3  to (3 + 4  - 1):
     1970           v-field-value = ch#TekkaApplication:GetField(1, jj).
     1971           assign
     1972           p-closed-shift-info = p-closed-shift-info + (if jj = 3
     1973                                                       then '':U
     1974                                                       else chr(4) ) + v-field-value
     1975           .
     1976         end.
     1977         do jj =  1  to 2:
     1978           v-field-value = ch#TekkaApplication:GetField(1, jj).
     1979           assign
     1980           p-date-time-info = p-date-time-info + (if jj = 1
     1981                                                       then '':U
     1982                                                       else chr(4) ) + v-field-value
     1983           .
     1984         end.
     1985         do jj =  8  to (8 +  - 1):
     1986           v-field-value = ch#TekkaApplication:GetField(1, jj).
     1987           assign
     1988           p-num-recs-info = p-num-recs-info + (if jj = 8
     1989                                                       then '':U
     1990                                                       else chr(4) ) + v-field-value
     1991           .
     1992         end.
     1993       end.
     1994       else do:
     1995         kk = buffer bufm_tt-shift-info:buffer-field("shift-open-date-chr"):position.
     1996         do jj =  3  to  (3 +  4 - 1):
     1997           v-field-value = ch#TekkaApplication:GetField(1, jj).
     1998           assign
     1999           p-closed-shift-info = p-closed-shift-info + (if jj = 3
     2000                                                       then '':U
     2001                                                       else chr(4) ) + v-field-value
     2002           buffer bufm_tt-shift-info:buffer-field(kk + jj - 3 - 1):buffer-value = v-field-value
     2003           .
     2004         end.
     2005         kk = buffer bufm_tt-shift-info:buffer-field("tekka-date-chr"):position.
     2006         do jj =  1  to 2:
     2007           v-field-value = ch#TekkaApplication:GetField(1, jj).
     2008           assign
     2009           p-date-time-info = p-date-time-info + (if jj = 1
     2010                                                       then '':U
     2011                                                       else chr(4) ) + v-field-value
     2012           buffer bufm_tt-shift-info:buffer-field(kk + jj - 1 - 1):buffer-value = v-field-value
     2013           .
     2014         end.
     2015         kk = buffer bufm_tt-shift-info:buffer-field("num-recs-petrol"):position.
     2016         do jj =  8  to (8 + 4 - 1):
     2017           v-field-value = ch#TekkaApplication:GetField(1, jj).
     2018           assign
     2019           p-num-recs-info = p-num-recs-info + (if jj = 8
     2020                                                       then '':U
     2021                                                       else chr(4) ) + v-field-value
     2022           buffer bufm_tt-shift-info:buffer-field(kk + jj - 8 - 1):buffer-value = v-field-value
     2023           .
     2024         end.
     2025      end.
     2026     end.
     2027   end procedure.
