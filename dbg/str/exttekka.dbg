      392   field min-plu       as integer
      393   field max-plu       as integer
      394   field num-fields    as integer
      395   field task-num      as character
      396   field by-record     as logical
      397   field send-get      as character
      398   field cash-num      as integer
      399   field cash-num-char as character
      400   field port-num      as character
      401   field way           as character
      402   field is-script     as logical
      403   field pswd          as character
      404   field waiting-sek   as integer
      405   field other-info    as character
      406   field order-num     as integer
      407   field secondary     as integer
