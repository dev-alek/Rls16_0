     4676   define variable n-contract-code        like         ub.fin-ob.contract-code    no-undo .
     4677   define variable n-exch-rate            like         ub.fin-ob.exch-rate        no-undo .
     4678   define variable n-exch-scale           like         ub.fin-ob.exch-scale       no-undo .
