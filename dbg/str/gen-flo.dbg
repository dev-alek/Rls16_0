     4829       input  par-host-code       ,
     4830       input  n-payer-code        ,
     4831       input  n-payer-type        ,
     4832       input  n-pay-date          ,
     4833       input  string(p-doc-code)  ,
     4834       input  'авто':U          ,
     4835       input  n-sum-base-orig     ,
     4836       input  n-sum-base          ,
     4837       input  n-sum-doc-orig      ,
     4838       input  n-sum-rubl-orig     ,
     4839       input  n-sum-rubl          ,
     4840       input  n-sum-contract      ,
     4841       input  n-trn-doc-code      ,
