     4700   define variable n-in-type              like         ub.fin-ob.in-type          no-undo .
     4701   define variable n-sum-tax-base         like         ub.fin-ob.sum-tax-base     no-undo .
     4702   define variable n-sum-tax-doc          like         ub.fin-ob.sum-tax-doc      no-undo .
     4703   define variable n-sum-tax-rubl         like         ub.fin-ob.sum-tax-rubl     no-undo .
