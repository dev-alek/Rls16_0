     3233       bfacc_tt-allsum.road-tax-cli-acc    = bf_tt-allsum.road-tax-cli-acc
     3234       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     3235       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     3236       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     3237       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     3238       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     3239       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     3240       .
     3241     assign
     3242       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     3243       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     3244       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     3245       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     3246       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     3247       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     3248       bfsacc_tt-allsum.vat-base-doc        = 0
     3249       bfsacc_tt-allsum.vat-rubl-doc        = 0
     3250       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     3251       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     3252       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     3253       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     3254       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     3255       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     3256       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     3257       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     3258       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     3259       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     3260       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     3261       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     3262       bfsacc_tt-allsum.vat-base-cur        = 0
     3263       bfsacc_tt-allsum.vat-rubl-cur        = 0
     3264       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     3265       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     3266       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     3267       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     3268       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     3269       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     3270       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     3271       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     3272       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     3273       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     3274       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     3275       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     3276       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     3277       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     3278       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     3279       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     3280       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     3281       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     3282       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     3283       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     3284       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     3285       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
