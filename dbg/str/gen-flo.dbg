     3785        input recid(bf_tt-clcparts),
     3786        input paris-doc,
     3787        input paris-cur,
     3788        input parroad-tax,
     3789        input parexcise,
     3790        input parvat-pc,
     3791        input parcons-vat-pc,
     3792        input parslt-pc,
     3793        input parbase-rate,
     3794        input parbase-scale,
