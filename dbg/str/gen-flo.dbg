     4843       input  n-user-db-num-pay   ,
     4844       input  n-user-name-fact    ,
     4845       input  n-user-name-pay     ,
     4846       input  n-in-type           ,
     4847       input  n-sum-tax-base      ,
     4848       input  n-sum-tax-doc       ,
     4849       input  n-sum-tax-rubl      ,
     4850       input  n-sum-tax-contract  ,
     4851       input  ""                  ,
     4852       output p-ri )
     4853       no-error .
     4854       if error-status :error then
