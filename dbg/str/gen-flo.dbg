     4867                       buf_fin-ob-trn.doc-type       = "order"  and
     4868                       buf_fin-ob-trn.trn-doc-code   = buf_ord-doc.doc-code
     4869                       no-error .
     4870           if not available  buf_fin-ob-trn then  do :
     4871               create buf_fin-ob-trn.
     4872               assign
     4873                 buf_fin-ob-trn.doc-code       = p-doc-code
     4874                 buf_fin-ob-trn.host-code      = par-host-code
     4875                 buf_fin-ob-trn.doc-type       = "order"
     4876                 buf_fin-ob-trn.sum-rubl       = n-sum-rubl
     4877                 buf_fin-ob-trn.trn-doc-code   = buf_ord-doc.doc-code
     4878               .
     4879           end.
     4880           find first buf2_ord-doc  exclusive-lock  where buf2_ord-doc.doc-code = buf_ord-doc.doc-code no-error .
     4881           if available buf2_ord-doc then do:
     4882               if buf_contract.usl-opl = 'Предоплата(%)':U and buf2_ord-doc.status_ = 'факт':U then
     4883               assign
     4884                 buf2_ord-doc.cr-fo2        = true
     4885                 buf2_ord-doc.fo-date2      = today
     4886               .
