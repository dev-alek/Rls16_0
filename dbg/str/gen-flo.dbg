     4691   define variable n-sum-rubl-orig        like         ub.fin-ob.sum-rubl-orig    no-undo .
     4692   define variable n-sum-rubl             like         ub.fin-ob.sum-rubl         no-undo .
     4693   define variable n-sum-contract         like         ub.fin-ob.sum-contract     no-undo .
     4694   define variable n-trn-doc-code         like         ub.fin-ob.trn-doc-code     no-undo .
