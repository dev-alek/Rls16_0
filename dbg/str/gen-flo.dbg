     5694       input  n-in-type             ,
     5695       input  n-sum-tax-base        ,
     5696       input  n-sum-tax-doc         ,
     5697       input  n-sum-tax-rubl        ,
     5698       input  n-sum-tax-contract    ,
     5699       input  ""                    ,
     5700       output p-ri )
     5701       no-error .
     5702     if error-status :error then do:
     5703        message vss-workfile vss-revision vss-description skip
     5704               "Ошибка create-fin-liab " skip
     5705                skip
     5706                error-status :get-message(1) skip
     5707                return-value skip
     5708                view-as alert-box error
     5709        .
     5710        return.
     5711     end.
     5712     col-fo = col-fo + 1.
     5713     for each tt-ord-code  where
     5714         tt-ord-code.contract-code = buf_contract.contract-code  and
     5715         tt-ord-code.obj-type      = p-obj-type    and
     5716         tt-ord-code.obj-code      = p-obj-code    and
     5717         tt-ord-code.pc            = v-pc                      and
     5718         tt-ord-code.host-code     = par-host-code
     5719         on error undo, return error :
     5720           find first  buf_fin-ob-trn no-lock  where
     5721                 buf_fin-ob-trn.doc-code       = p-doc-code  and
     5722                 buf_fin-ob-trn.doc-type       = "order"     and
     5723                 buf_fin-ob-trn.host-code      = par-host-code  and
     5724                 buf_fin-ob-trn.trn-doc-code   = tt-ord-code.doc-code
     5725                 no-error .
     5726                 if not available  buf_fin-ob-trn then  do:
     5727               create buf_fin-ob-trn.
     5728               assign
     5729                 buf_fin-ob-trn.doc-code       = p-doc-code
     5730                 buf_fin-ob-trn.doc-type       = "order"
     5731                 buf_fin-ob-trn.host-code      = par-host-code
     5732                 buf_fin-ob-trn.sum-tax-rubl   = n-sum-tax-rubl
     5733                 buf_fin-ob-trn.sum-rubl       = tt-ord-code.sum-rubl
     5734                 buf_fin-ob-trn.trn-doc-code   = tt-ord-code.doc-code
     5735               .
     5736               end.
     5737         find first buf2_ord-doc  exclusive-lock  where buf2_ord-doc.doc-code = tt-ord-code.doc-code no-error .
     5738         if available buf2_ord-doc then do:
     5739         if buf_contract.usl-opl = 'Предоплата(%)':U and buf2_ord-doc.status_ = 'факт':U then
     5740               assign
     5741                 buf2_ord-doc.cr-fo2   = true
     5742                 buf2_ord-doc.fo-date2 = today
     5743               .
     5744            else
     5745               assign
     5746                 buf2_ord-doc.cr-fo   = true
     5747                 buf2_ord-doc.fo-date = today
     5748               .
     5749         end.
     5750          if p-nalog = 1 then
     5751             run make-fin-ord-line in this-procedure
     5752             ( input p-doc-code,
     5753               input 2 ,
     5754               input buf2_ord-doc.base-rate  ,
     5755               input buf2_ord-doc.base-scale ,
     5756               input buf2_ord-doc.exch-rate  ,
     5757               input buf2_ord-doc.exch-scale ).
     5758          else
     5759             run make-fin-ord-line-VAT in this-procedure
     5760             ( input p-doc-code,
     5761               input v-pc ,
     5762               input buf2_ord-doc.base-rate  ,
     5763               input buf2_ord-doc.base-scale ,
     5764               input buf2_ord-doc.exch-rate  ,
     5765               input buf2_ord-doc.exch-scale
     5766               ).
     5767     end.
     5768     run make-tax (
     5769           input p-doc-code ,
     5770           input par-host-code
     5771           )                .
     5772     run update-fin-ob_obj (
     5773           input p-doc-code ,
     5774           input par-host-code
     5775           )
     5776       .
     5777    run close-fo-fact ( input par-host-code, input p-doc-code ) no-error   .
     5778    if error-status :error then
     5779       p-res = p-res + chr(10) + " Ошибка процедуры закрытия на ФАКТ совокупного ФО "  + error-status :get-message(1)  + return-value .
     5780    end.
     5781   end procedure.
     5782   procedure make-fin-ord-line :
     5783    do
     5784    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5785    :
     5786   define input parameter p-doc-code as character no-undo .
     5787   define input parameter p-type as integer no-undo .
     5788   define input parameter v-base-rate as decimal   no-undo .
     5789   define input parameter v-base-scale as integer   no-undo .
     5790   define input parameter v-exch-rate as decimal   no-undo .
     5791   define input parameter v-exch-scale as integer   no-undo .
     5792   define variable col-part   as integer   no-undo .
     5793     for each temp-ord-line no-lock  where
     5794              temp-ord-line.contract-code = buf_contract.contract-code
     5795              on error undo, return error :
     5796                   if not can-find ( first buf_fin-gds-part no-lock where
     5797                       buf_fin-gds-part.host-code   = par-host-code and
     5798                       buf_fin-gds-part.fin-ob-code = p-doc-code              and
     5799                       buf_fin-gds-part.obj-type    = temp-ord-line.obj-type  and
     5800                       buf_fin-gds-part.obj-code    = temp-ord-line.obj-code  and
     5801                       buf_fin-gds-part.gds-code    = temp-ord-line.gds-code  and
     5802                       buf_fin-gds-part.in-code     = temp-ord-line.in-code   and
     5803                       buf_fin-gds-part.part-code   = temp-ord-line.part-code and
     5804                       buf_fin-gds-part.doc-type    = "order"                 and
     5805                       buf_fin-gds-part.out-code    = temp-ord-line.out-code )
     5806                   then do:
     5807                       col-part = col-part + 1.
     5808                       if ( col-part  modulo temp1 = 0 ) and ( col-part >= temp1 ) then run waitfram-show( "Создано партий : " + string( col-part )) .
     5809                         create buf_fin-gds-part.
     5810                         buffer-copy temp-ord-line to buf_fin-gds-part
     5811                         assign
     5812                           buf_fin-gds-part.doc-qnty    = temp-ord-line.qnty
     5813                           buf_fin-gds-part.fact-qnty   = temp-ord-line.qnty
     5814                           buf_fin-gds-part.obj-type    = temp-ord-line.obj-type
     5815                           buf_fin-gds-part.obj-code    = temp-ord-line.obj-code
     5816                           buf_fin-gds-part.gds-code    = temp-ord-line.gds-code
     5817                           buf_fin-gds-part.in-code     = temp-ord-line.in-code
     5818                           buf_fin-gds-part.part-code   = temp-ord-line.part-code
     5819                           buf_fin-gds-part.out-code    = temp-ord-line.out-code
     5820                           buf_fin-gds-part.doc-type    = "order"
     5821                           buf_fin-gds-part.host-code          = par-host-code
     5822                           buf_fin-gds-part.fin-ob-code        = p-doc-code
     5823                           buf_fin-gds-part.status_dop         = 'авто':U
     5824                           buf_fin-gds-part.user-db-num        = g#db-num
     5825                           buf_fin-gds-part.user-name          = g#userid
     5826                           buf_fin-gds-part.doc-qnty           = temp-ord-line.qnty
     5827                           buf_fin-gds-part.sum-rubl           = temp-ord-line.sum-rubl
     5828                           buf_fin-gds-part.sum-base           = temp-ord-line.sum-base
     5829                           buf_fin-gds-part.sum-rubl-orig      = temp-ord-line.sum-rubl
     5830                           buf_fin-gds-part.sum-base-orig      = temp-ord-line.sum-base
     5831                           buf_fin-gds-part.sum-contract-orig  = temp-ord-line.sum-cli
     5832                           buf_fin-gds-part.sum-contract       = temp-ord-line.sum-cli
     5833                           buf_fin-gds-part.vat-rubl-orig      = temp-ord-line.sum-vat-rubl
     5834                           buf_fin-gds-part.vat-rubl           = temp-ord-line.sum-vat-rubl
     5835                           buf_fin-gds-part.vat-base-orig      = temp-ord-line.sum-vat-base
     5836                           buf_fin-gds-part.vat-base           = temp-ord-line.sum-vat-base
     5837                           buf_fin-gds-part.vat-contract-orig  = temp-ord-line.sum-vat
     5838                           buf_fin-gds-part.vat-contract       = temp-ord-line.sum-vat
     5839                           buf_fin-gds-part.slt-contract-orig  = temp-ord-line.sum-slt
     5840                           buf_fin-gds-part.slt-contract       = temp-ord-line.sum-slt
     5841                           buf_fin-gds-part.slt-rubl-orig      = temp-ord-line.sum-slt / v-exch-scale * v-exch-rate
     5842                           buf_fin-gds-part.slt-rubl           = temp-ord-line.sum-slt / v-exch-scale * v-exch-rate
     5843                           buf_fin-gds-part.slt-base-orig      = buf_fin-gds-part.slt-rubl * v-base-scale / v-base-rate
     5844                           buf_fin-gds-part.slt-base           = buf_fin-gds-part.slt-rubl * v-base-scale / v-base-rate
     5845                         .
     5846                   end.
     5847               end.
     5848    end.
     5849   end procedure.
     5850   procedure make-fin-ord-line-VAT :
     5851    do
     5852    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5853    :
     5854   define input  parameter p-doc-code as character no-undo .
     5855   define input  parameter v-pc as decimal   no-undo .
     5856   define input  parameter v-base-rate as decimal   no-undo .
     5857   define input  parameter v-base-scale as integer   no-undo .
     5858   define input  parameter v-exch-rate as decimal   no-undo .
     5859   define input  parameter v-exch-scale as integer   no-undo .
     5860   if var-fin-calc <> 1  then find first temp-obj-firm no-error .
     5861   define variable col-part   as integer   no-undo .
     5862     for each temp-ord-line no-lock  where
     5863              temp-ord-line.contract-code = buf_contract.contract-code and
     5864              temp-ord-line.VAT-pc = v-pc  and
     5865              ( var-fin-calc <> 1  or (
     5866              temp-ord-line.obj-type = temp-obj-firm.obj-type  and
     5867              temp-ord-line.obj-code = temp-obj-firm.obj-code ))
     5868              on error undo, return error :
     5869                   if not can-find (first buf_fin-gds-part no-lock where
     5870                       buf_fin-gds-part.host-code   = par-host-code and
     5871                       buf_fin-gds-part.fin-ob-code = p-doc-code              and
     5872                       buf_fin-gds-part.obj-type    = temp-ord-line.obj-type  and
     5873                       buf_fin-gds-part.obj-code    = temp-ord-line.obj-code  and
     5874                       buf_fin-gds-part.gds-code    = temp-ord-line.gds-code  and
     5875                       buf_fin-gds-part.in-code     = temp-ord-line.in-code   and
     5876                       buf_fin-gds-part.part-code   = temp-ord-line.part-code and
     5877                       buf_fin-gds-part.doc-type    = "order"                 and
     5878                       buf_fin-gds-part.out-code    = temp-ord-line.out-code  use-index pi )
     5879                   then do:
     5880                       col-part = col-part + 1.
     5881                       if ( col-part  modulo temp1 = 0 ) and ( col-part >= temp1 ) then run waitfram-show( "Создано партий : " + string( col-part )) .
     5882                         run clc-price-tmp .
     5883                         create buf_fin-gds-part.
     5884                         buffer-copy temp-ord-line to buf_fin-gds-part
     5885                         assign
     5886                           buf_fin-gds-part.doc-qnty    = temp-ord-line.qnty
     5887                           buf_fin-gds-part.fact-qnty   = temp-ord-line.qnty
     5888                           buf_fin-gds-part.fin-ob-code        = p-doc-code
     5889                           buf_fin-gds-part.doc-type           = "order"
     5890                           buf_fin-gds-part.status_dop         = 'авто':U
     5891                           buf_fin-gds-part.user-db-num        = g#db-num
     5892                           buf_fin-gds-part.user-name          = g#userid
     5893                           buf_fin-gds-part.doc-qnty           = temp-ord-line.qnty
     5894                           buf_fin-gds-part.sum-rubl-orig      = temp-ord-line.sum-rubl - ( temp-ord-line.sum-transport-rubl +  temp-ord-line.sum-other-rubl)
     5895                           buf_fin-gds-part.sum-rubl           = temp-ord-line.sum-rubl - ( temp-ord-line.sum-transport-rubl +  temp-ord-line.sum-other-rubl)
     5896                           buf_fin-gds-part.sum-base-orig      = temp-ord-line.sum-base - ( temp-ord-line.sum-transport-base +  temp-ord-line.sum-other-base)
     5897                           buf_fin-gds-part.sum-base           = temp-ord-line.sum-base - ( temp-ord-line.sum-transport-base +  temp-ord-line.sum-other-base)
     5898                           buf_fin-gds-part.sum-contract-orig  = temp-ord-line.sum-cli
     5899                           buf_fin-gds-part.sum-contract       = temp-ord-line.sum-cli
     5900                           buf_fin-gds-part.vat-contract-orig  = temp-ord-line.sum-vat
     5901                           buf_fin-gds-part.vat-contract       = temp-ord-line.sum-vat
     5902                           buf_fin-gds-part.slt-contract-orig  = temp-ord-line.sum-slt
     5903                           buf_fin-gds-part.slt-contract       = temp-ord-line.sum-slt
     5904                           buf_fin-gds-part.vat-rubl-orig      = temp-ord-line.sum-vat-rubl
     5905                           buf_fin-gds-part.vat-rubl           = temp-ord-line.sum-vat-rubl
     5906                           buf_fin-gds-part.slt-rubl-orig      = temp-ord-line.sum-slt  / v-exch-scale * v-exch-rate
     5907                           buf_fin-gds-part.slt-rubl           = temp-ord-line.sum-slt  / v-exch-scale * v-exch-rate
     5908                           buf_fin-gds-part.vat-base-orig      = temp-ord-line.sum-vat-base
     5909                           buf_fin-gds-part.vat-base           = temp-ord-line.sum-vat-base
     5910                           buf_fin-gds-part.slt-base-orig      = buf_fin-gds-part.slt-rubl  * v-base-scale / v-base-rate
     5911                           buf_fin-gds-part.slt-base           = buf_fin-gds-part.slt-rubl  * v-base-scale / v-base-rate
     5912                         .
     5913                   end.
     5914               end.
     5915    end.
     5916   end procedure.
     5917   procedure clc-price-tmp :
     5918     do
     5919     on error undo, return error return-value
     5920     :
     5921     end.
     5922   end procedure.
     5923   procedure calc-rest-sum :
     5924   define parameter buffer buff_ord-line for ub.ord-line.
     5925   define input  parameter p-proc        as decimal   no-undo .
     5926   define output parameter p-cl-sum-rubl as decimal   no-undo .
     5927   define output parameter p-cl-sum-base as decimal   no-undo .
     5928   define output parameter p-cl-vat-rubl as decimal   no-undo .
     5929   define output parameter p-cl-vat-base  as decimal   no-undo .
     5930   define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv  .
     5931   define buffer buf_ord-line-rcv for ub.ord-line-rcv  .
     5932   define buffer buf_trn-doc      for ub.trn-doc .
     5933   define buffer buf_doc-line     for ub.doc-line.
     5934     do
     5935     on error undo, return error return-value
     5936     :
     5937       for each buf_ord-line-rcv no-lock where
     5938               buf_ord-line-rcv.doc-code = buff_ord-line.doc-code and
     5939               buf_ord-line-rcv.artic    = buff_ord-line.artic and
     5940               buf_ord-line-rcv.prod-type = buff_ord-line.prod-type and
     5941               buf_ord-line-rcv.prod-code = buff_ord-line.prod-code ,
     5942               first buf_ord-doc-rcv no-lock where
     5943                     buf_ord-doc-rcv.rcv-code = buf_ord-line-rcv.rcv-code and
     5944                     buf_ord-doc-rcv.doc-code = buf_ord-line-rcv.doc-code ,
     5945               each ub.ord-chain no-lock where
     5946                         ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
     5947                         ub.ord-chain.doc-type = 'rcv'                  and
     5948                         ub.ord-chain.rel-doc-type = 'trn' ,
     5949               each buf_doc-line no-lock where
     5950                     buf_doc-line.doc-code  = ub.ord-chain.rel-doc-code and
     5951                     buf_doc-line.artic     = buff_ord-line.artic and
     5952                     buf_doc-line.prod-type = buff_ord-line.prod-type and
     5953                     buf_doc-line.prod-code = buff_ord-line.prod-code and
     5954                     buf_doc-line.ext-doc-type = 'ee':U   and
     5955                     buf_doc-line.status_      = 'факт':U
     5956               :
     5957                 empty temp-table tt-allsum-line .
     5958                 run clcprtsl_calc-line in this-procedure ( input recid( buf_doc-line ) ) no-error .
     5959                   find first tt-allsum-line  where tt-allsum-line.sum-type = 'основная_сумма':U no-error.
     5960                   if available tt-allsum-line then
     5961                     assign
     5962                       p-cl-sum-rubl  = p-cl-sum-rubl + abs ( tt-allsum-line.sum-dsc-rubl-doc )
     5963                       p-cl-sum-base  = p-cl-sum-base + abs ( tt-allsum-line.sum-dsc-base-doc )
     5964                       p-cl-vat-rubl  = p-cl-vat-rubl + abs ( tt-allsum-line.VAT-rubl-buyer-doc )
     5965                       p-cl-vat-base  = p-cl-vat-base + abs ( tt-allsum-line.VAT-base-buyer-doc)
     5966                       .
     5967       end.
     5968       assign
     5969         p-cl-sum-rubl  = p-cl-sum-rubl - ( p-proc *  buff_ord-line.sum-rubl / 100 )
     5970         p-cl-sum-base  = p-cl-sum-base - ( p-proc *  buff_ord-line.sum-base / 100 )
     5971         p-cl-vat-rubl  = p-cl-vat-rubl - ( p-proc *  buff_ord-line.sum-vat / 100 )
     5972         p-cl-vat-base  = p-cl-vat-base - ( p-proc *  buff_ord-line.sum-vat / 100 )
     5973         .
     5974     end.
     5975   end procedure.
