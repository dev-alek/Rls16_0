     2359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2360     (input  parartic
     2361     ,input  parprod-type
     2362     ,input  parprod-code
     2363     ,output varroot-nodecl
     2364     ) no-error .
     2365   if error-status :error then do:
     2366     message
     2367       vss-workfile vss-revision vss-description skip
     2368       "Ошибка при определении корневого признака товара" skip
     2369       "Артикул" parartic parprod-type parprod-code skip
     2370       error-status :get-message(1) skip
     2371       return-value skip
     2372       view-as alert-box error .
     2373     undo, return error .
     2374   end.
     2375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     2376     (input  varroot-nodecl
     2377     ,input  'empty-scale=request'
     2378     ,output varempty-scalecl
     2379     ) no-error .
     2380   if error-status :error then do:
     2381     message
     2382       vss-workfile vss-revision vss-description skip
     2383       "Ошибка при определении атрибута признака" skip
     2384       "Артикул" parartic parprod-type parprod-code skip
     2385       "Признак" varroot-nodecl skip
     2386       "Запрашивался атрибут" "empty-scale=request" skip
     2387       error-status :get-message(1) skip
     2388       return-value skip
     2389       view-as alert-box error .
     2390     undo, return error .
     2391   end.
     2392   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2393   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2394     (output varoutvprbcl
     2395     )  .
     2396   if varoutvprbcl = "base":u then do:
     2397     assign
     2398           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax * 1)
     2399       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
     2400     .
     2401   end.
     2402   else do:
     2403     assign
     2404           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax / parbase-rate * parbase-scale)
     2405       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   / parbase-rate * parbase-scale)
     2406     .
     2407   end.
