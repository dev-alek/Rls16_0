     3612                 varprice-sale = 0
     3613                 varroad-tax   = 0
     3614                 varexcise     = 0
     3615               .
     3616             end.
     3617             assign
     3618               varlastcur-base     = varprice-sale
     3619               varlastcur-road-tax = varroad-tax
     3620               varlastcur-excise   = varexcise
     3621               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3622               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3623               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3624               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3625             .
     3626         end.
     3627       end.
     3628       if varcur-fact-qnty = 0 then do:
     3629         assign
     3630           varcur-base      = varlastcur-base
     3631           varcur-road-tax  = varlastcur-road-tax
     3632           varcur-excise    = varlastcur-excise
     3633         .
     3634       end.
     3635       else do:
     3636         assign
     3637           varcur-base      = varcur-base      / varcur-fact-qnty
     3638           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3639           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3640         .
     3641       end.
