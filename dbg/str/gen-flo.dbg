     4739      then v-date-pay = today  .
     4740      else dO:
     4741           if p-cons = 2 and available   buf_ord-doc then do:
     4742               var-date = buf_ord-doc.fact-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     4743               if var-date < today then var-date = today.
     4744               v-date-pay = var-date.
     4745           end.
     4746      end.
     4747   end.
     4748    else do:
     4749   assign
     4750     n-doc-type            =  'при':U
     4751     n-receiver-code       =  par-host-code
     4752     n-receiver-type       =  'орг':U
     4753     n-receiver-name       =  buf_contract.own-name
     4754     n-payer-code          =  buf_contract.cli-code
     4755     n-payer-type          =  buf_contract.cli-type
     4756     n-payer-name          =  buf_contract.cli-name
     4757   .
     4758    if  buf_contract.usl-opl = 'Предоплата':U  then v-date-pay = today  .
     4759      else do:
     4760           if p-cons = 2 and available   buf_ord-doc then do:
     4761               var-date = buf_ord-doc.doc-date .
     4762               if var-date < today then var-date = today.
     4763               v-date-pay = var-date.
     4764           end.
     4765      end.
     4766   end.
     4767    if p-cons = 2 then do:
     4768         if available   buf_ord-doc
     4769            then
     4770            assign
     4771              n-trn-doc-code       =  buf_ord-doc.doc-code
     4772            .
     4773            else  n-trn-doc-code       = ?   .
     4774        end.
     4775        else do:
     4776          if pfo = true and available   buf_ord-doc
     4777            then  assign
     4778              n-trn-doc-code       =  buf_ord-doc.doc-code
     4779            .
     4780            else  n-trn-doc-code      = ?   .
     4781        end.
     4782   assign
     4783     n-user-db-num-doc    = g#db-num
     4784     n-user-name-doc      = g#userid
     4785     n-contract-code      = buf_contract.contract-code
     4786     n-contract-curr      = n-curr-code
     4787     n-contract-rate      = n-exch-rate
     4788     n-contract-scale     = n-exch-scale
     4789     n-pay-date           = v-date-pay
     4790     n-sum-rubl-orig      = v-sum-rubl
     4791     n-sum-base-orig      =     v-sum-base
     4792     n-sum-contract       =  (  n-exch-scale   / n-exch-rate ) * v-sum-rubl
     4793     n-sum-base           = n-sum-base-orig
     4794     n-sum-doc-orig       = n-sum-contract
     4795     n-sum-doc            = n-sum-contract
     4796     n-sum-rubl           = n-sum-rubl-orig
     4797     n-in-type            = 0
     4798     n-sum-tax-base       = 0
     4799     n-sum-tax-doc        = 0
     4800     n-sum-tax-rubl       = 0
     4801     n-sum-tax-contract   = 0
     4802     n-doc-date           = if p-type-date  = 1 then  date(cur-time-date()) else p-date-end
     4803    .
     4804      n-doc-type = p-fo-type .
     4805     run fin-ob-code (input g#db-num , output p-doc-code) .
     4806     run create-fin-liab (
