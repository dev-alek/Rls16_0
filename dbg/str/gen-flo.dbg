      942   define variable v-tax-sum-base      as decimal no-undo .
      943   define variable v-tax-sum-contr     as decimal no-undo .
      944   define variable v-tax-sum-doc       as decimal no-undo .
      945   define variable var-doc             as decimal no-undo .
      946   define variable var-doc-slt         as decimal no-undo .
      947   define variable var-doc-vat         as decimal no-undo .
      948   define variable v-basecode as integer no-undo .
      949   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      950   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      951     (input  p-host-code
      952     ,output v-basecode
      953     )  .
      954   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
      955                                               buf_fin-ob.doc-code  = p-doc-code
      956                                               on error undo, return error :
      957      assign
      958       v-tax-sum-rubl  = 0
      959       v-tax-sum-base  = 0
      960       v-tax-sum-contr = 0
      961       v-tax-sum-doc   = 0
      962       v-sum           = 0
      963       v-sum-rubl      = 0
      964       v-sum-base      = 0
      965       v-sum-contract  = 0
      966       v-sum-vat       = 0
      967       v-sum-rubl-vat  = 0
      968       v-sum-base-vat  = 0
      969       v-sum-contract-vat  = 0
      970       v-sum-slt           = 0
      971       v-sum-rubl-slt      = 0
      972       v-sum-base-slt      = 0
      973       v-sum-contract-slt  = 0
      974       v-line = 0
      975       .
      976       for each buf_fin-gds-part no-lock where
      977                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
      978                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
      979                break  by buf_fin-gds-part.SLT-pc
      980                       by buf_fin-gds-part.vat-pc
      981                on error undo, return error :
      982                 case buf_fin-ob.curr-code:
      983                   when 0 then do :
      984                   assign
      985                   var-doc      =  buf_fin-gds-part.sum-rubl
      986                   var-doc-slt  =  buf_fin-gds-part.slt-rubl
      987                   var-doc-vat  =  buf_fin-gds-part.vat-rubl
      988                   .
      989                   end.
      990                   when v-basecode then do :
      991                   assign
      992                   var-doc      =  buf_fin-gds-part.sum-base
      993                   var-doc-slt  =  buf_fin-gds-part.slt-base
      994                   var-doc-vat  =  buf_fin-gds-part.vat-base
      995                   .
      996                   end.
      997                   when buf_fin-ob.contract-curr then do :
      998                   assign
      999                   var-doc      =  buf_fin-gds-part.sum-contract
     1000                   var-doc-slt  =  buf_fin-gds-part.slt-contract
     1001                   var-doc-vat  =  buf_fin-gds-part.vat-contract
     1002                   .
     1003                   end.
     1004                 end case.
     1005                assign
     1006                  v-sum           = v-sum          + var-doc
     1007                  v-sum-rubl      = v-sum-rubl     + buf_fin-gds-part.sum-rubl
     1008                  v-sum-base      = v-sum-base     + buf_fin-gds-part.sum-base
     1009                  v-sum-contract  = v-sum-contract + buf_fin-gds-part.sum-contract
     1010                  v-sum-slt           = v-sum-slt          + var-doc-slt
     1011                  v-sum-rubl-slt      = v-sum-rubl-slt     + buf_fin-gds-part.slt-rubl
     1012                  v-sum-base-slt      = v-sum-base-slt     + buf_fin-gds-part.slt-base
     1013                  v-sum-contract-slt  = v-sum-contract-slt + buf_fin-gds-part.slt-contract
     1014                  v-sum-vat           = v-sum-vat          + var-doc-vat
     1015                  v-sum-rubl-vat      = v-sum-rubl-vat     + buf_fin-gds-part.vat-rubl
     1016                  v-sum-base-vat      = v-sum-base-vat     + buf_fin-gds-part.vat-base
     1017                  v-sum-contract-vat  = v-sum-contract-vat + buf_fin-gds-part.vat-contract
     1018                .
     1019                if last-of(buf_fin-gds-part.vat-pc) then do:
     1020                   v-line = v-line + 1.
     1021                   create buf_fin-ob-tax.
     1022                   assign
     1023                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     1024                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     1025                       buf_fin-ob-tax.line-num           = v-line
     1026                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     1027                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     1028                       buf_fin-ob-tax.with-slt           = true
     1029                       buf_fin-ob-tax.with-vat           = true
     1030                       buf_fin-ob-tax.sum-line-rubl      = v-sum-rubl
     1031                       buf_fin-ob-tax.sum-slt-line-rubl  = v-sum-rubl-slt
     1032                       buf_fin-ob-tax.sum-vat-line-rubl  = v-sum-rubl-vat
     1033                       buf_fin-ob-tax.sum-line-base       = v-sum-base
     1034                       buf_fin-ob-tax.sum-line-contr      = v-sum-contract
     1035                       buf_fin-ob-tax.sum-line-doc        = v-sum
     1036                       buf_fin-ob-tax.sum-slt-line-base    = v-sum-base-slt
     1037                       buf_fin-ob-tax.sum-slt-line-contr   = v-sum-contract-slt
     1038                       buf_fin-ob-tax.sum-slt-line-doc     = v-sum-slt
     1039                       buf_fin-ob-tax.sum-vat-line-base    = v-sum-base-vat
     1040                       buf_fin-ob-tax.sum-vat-line-contr   = v-sum-contract-vat
     1041                       buf_fin-ob-tax.sum-vat-line-doc     = v-sum-vat
     1042                       .
     1043                       assign
     1044                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     1045                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     1046                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     1047                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     1048                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     1049                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     1050                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     1051                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     1052                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     1053                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     1054                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     1055                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     1056                       .
     1057                       assign
     1058                          v-tax-sum-rubl   = v-tax-sum-rubl  + v-sum-rubl-slt  + v-sum-rubl-vat
     1059                          v-tax-sum-base   = v-tax-sum-base  + v-sum-base-slt  + v-sum-base-vat
     1060                          v-tax-sum-contr  = v-tax-sum-contr + v-sum-contract-slt + v-sum-contract-vat
     1061                          v-tax-sum-doc    = v-tax-sum-doc   + v-sum-slt   + v-sum-vat
     1062                       .
     1063                       assign
     1064                       v-sum  = 0
     1065                       v-sum-rubl      = 0
     1066                       v-sum-base      = 0
     1067                       v-sum-contract  = 0
     1068                       v-sum-slt           =0
     1069                       v-sum-rubl-slt      =0
     1070                       v-sum-base-slt      =0
     1071                       v-sum-contract-slt  =0
     1072                       v-sum-vat           =0
     1073                       v-sum-rubl-vat      =0
     1074                       v-sum-base-vat      =0
     1075                       v-sum-contract-vat  =0
     1076                       .
     1077                 end.
     1078       end.
     1079       assign
     1080         buf_fin-ob.sum-tax-doc      = v-tax-sum-doc
     1081         buf_fin-ob.sum-tax-rubl     = v-tax-sum-rubl
     1082         buf_fin-ob.sum-tax-base     = v-tax-sum-base
     1083         buf_fin-ob.sum-tax-contract = v-tax-sum-contr
     1084         buf_fin-ob.base-rate        = if buf_fin-ob.base-rate <> 0 then buf_fin-ob.base-rate else round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-base , 4)
     1085         buf_fin-ob.exch-rate        = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-doc  , 4)
     1086         buf_fin-ob.contract-rate    = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-contract , 4)
     1087         buf_fin-ob.base-scale       = 1
     1088         buf_fin-ob.exch-scale       = 1
     1089         buf_fin-ob.contract-scale   = 1
     1090       .
     1091       assign
     1092       v-tax-sum-rubl  = 0
     1093       v-tax-sum-base  = 0
     1094       v-tax-sum-contr = 0
     1095       v-tax-sum-doc   = 0
     1096       v-sum-vat          = 0
     1097       v-sum-rubl-vat     = 0
     1098       v-sum-base-vat     = 0
     1099       v-sum-contract-vat    = 0
     1100       v-sum-slt          = 0
     1101       v-sum-rubl-slt     = 0
     1102       v-sum-base-slt     = 0
     1103       v-sum-contract-slt    = 0
     1104       .
     1105   end.
     1106    end.
     1107   end procedure.
     1108   procedure update-fin-ob_obj :
     1109    do
     1110    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1111    :
     1112   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
     1113   define input parameter p-host-code as integer no-undo .
     1114   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     1115   define buffer buf_fin-ob       for  ub.fin-ob     .
     1116   define variable v-obj-code as integer no-undo init 0 .
     1117   define variable v-obj-type as character no-undo init "" .
     1118   define variable var-fin-calc as integer no-undo .
     1119   find first ub.sysconf no-lock where ub.sysconf.host-code = p-host-code no-error .
     1120   var-fin-calc = ub.sysconf.fin-calc   .
     1121   if var-fin-calc = 0 then return.
     1122   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     1123                                               buf_fin-ob.doc-code = p-doc-code
     1124                                               on error undo, return error :
     1125       for each buf_fin-gds-part no-lock where
     1126                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     1127                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     1128                on error undo, return error :
     1129             assign
     1130                v-obj-code  =  buf_fin-gds-part.obj-code
     1131                v-obj-type  =  buf_fin-gds-part.obj-type
     1132                .
     1133              leave.
     1134       end.
     1135       assign
     1136         buf_fin-ob.obj-code  =   v-obj-code
     1137         buf_fin-ob.obj-type  =   v-obj-type
     1138       .
     1139   end.
     1140    end.
     1141   end procedure.
     1142   procedure make-tax-rubl :
     1143    do
     1144    on error undo, return error return-value
     1145    :
     1146   define input parameter p-doc-code like ub.fin-ob.doc-code no-undo .
     1147   define input parameter p-host-code as integer no-undo .
     1148   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     1149   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
     1150   define buffer buf_fin-ob       for  ub.fin-ob     .
     1151   define variable v-line    as integer no-undo .
     1152   define variable v-sum         as decimal no-undo .
     1153   define variable v-tax-sum       as decimal no-undo .
     1154   define variable v-tax-sum-rubl  as decimal no-undo .
     1155   define variable v-tax-sum-base  as decimal no-undo .
     1156   define variable v-tax-sum-contr as decimal no-undo .
     1157   define variable v-tax-sum-doc   as decimal no-undo .
     1158   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     1159                                               buf_fin-ob.doc-code = p-doc-code
     1160                                               on error undo, return error :
     1161      assign
     1162       v-tax-sum-rubl = 0
     1163       v-tax-sum-base = 0
     1164       v-tax-sum-contr = 0
     1165       v-tax-sum-doc  = 0
     1166       v-sum          = 0
     1167       v-line = 0
     1168       .
     1169       for each buf_fin-gds-part no-lock where
     1170                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     1171                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     1172                break  by buf_fin-gds-part.SLT-pc
     1173                       by buf_fin-gds-part.vat-pc
     1174                on error undo, return error :
     1175                assign
     1176                  v-sum       = v-sum + buf_fin-gds-part.sum-rubl
     1177                .
     1178                if last-of(buf_fin-gds-part.vat-pc) then do:
     1179                   v-line = v-line + 1.
     1180                   create buf_fin-ob-tax.
     1181                   assign
     1182                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     1183                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     1184                       buf_fin-ob-tax.line-num           = v-line
     1185                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     1186                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     1187                       buf_fin-ob-tax.with-slt           = true
     1188                       buf_fin-ob-tax.with-vat           = true
     1189                       buf_fin-ob-tax.sum-line-rubl      = v-sum
     1190                       buf_fin-ob-tax.sum-slt-line-rubl  = buf_fin-ob-tax.slt-PC *  buf_fin-ob-tax.sum-line-rubl  / ( 100 + buf_fin-ob-tax.slt-PC )
     1191                       buf_fin-ob-tax.sum-vat-line-rubl  = buf_fin-ob-tax.vat-PC * (( buf_fin-ob-tax.sum-line-rubl  - buf_fin-ob-tax.sum-slt-line-rubl  ) / ( 100  + buf_fin-ob-tax.vat-PC))
     1192                       buf_fin-ob-tax.sum-line-base       = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-line-rubl
     1193                       buf_fin-ob-tax.sum-line-doc        = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-line-rubl
     1194                       buf_fin-ob-tax.sum-line-contr      = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-line-rubl
     1195                       buf_fin-ob-tax.sum-slt-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     1196                       buf_fin-ob-tax.sum-slt-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     1197                       buf_fin-ob-tax.sum-slt-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-slt-line-rubl
     1198                       buf_fin-ob-tax.sum-vat-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     1199                       buf_fin-ob-tax.sum-vat-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     1200                       buf_fin-ob-tax.sum-vat-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-vat-line-rubl
     1201                       .
     1202                       assign
     1203                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     1204                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     1205                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     1206                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     1207                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     1208                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     1209                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     1210                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     1211                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     1212                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     1213                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     1214                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     1215                       .
     1216                       assign
     1217                          v-tax-sum-rubl   = v-tax-sum-rubl  + buf_fin-ob-tax.sum-slt-line-rubl  + buf_fin-ob-tax.sum-vat-line-rubl
     1218                          v-tax-sum-base   = v-tax-sum-base  + buf_fin-ob-tax.sum-slt-line-base  + buf_fin-ob-tax.sum-vat-line-base
     1219                          v-tax-sum-contr  = v-tax-sum-contr + buf_fin-ob-tax.sum-slt-line-contr + buf_fin-ob-tax.sum-vat-line-contr
     1220                          v-tax-sum-doc    = v-tax-sum-doc   + buf_fin-ob-tax.sum-slt-line-doc   + buf_fin-ob-tax.sum-vat-line-doc
     1221                       .
     1222                       v-sum  = 0 .
     1223                 end.
     1224       end.
     1225       buf_fin-ob.sum-tax-doc   = v-tax-sum-doc   .
     1226       buf_fin-ob.sum-tax-rubl  = v-tax-sum-rubl  .
     1227       buf_fin-ob.sum-tax-base  = v-tax-sum-base  .
     1228       buf_fin-ob.sum-tax-contract = v-tax-sum-contr .
     1229       v-tax-sum-rubl  = 0 .
     1230       v-tax-sum-base  = 0 .
     1231       v-tax-sum-contr = 0 .
     1232       v-tax-sum-doc   = 0 .
     1233   end.
     1234    end.
     1235   end procedure.
     1236   define new global shared variable g#libofarh as handle no-undo .
     1237   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1238   procedure factord :
     1239     define input  parameter p-fact-date            as date    no-undo .
     1240     define input  parameter p-fact-time            as integer no-undo .
     1241     define input  parameter p-fact-num             as integer no-undo .
     1242     define input  parameter p-shift-date           as date    no-undo .
     1243     define input  parameter p-shift-num            as integer no-undo .
     1244     define input  parameter p-shift-on             as logical no-undo .
     1245     define output parameter p-fact-order           as decimal no-undo .
     1246     define output parameter p-shift-end-fact-order as decimal no-undo .
     1247     define output parameter p-day-end-fact-order   as decimal no-undo .
     1248     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1249     if p-fact-date = ?
     1250     then do:
     1251       return error "Не указана фактическая дата" .
     1252     end.
     1253     define variable v-fact-date-num as integer no-undo .
     1254     assign
     1255       v-fact-date-num = integer(p-fact-date)
     1256     .
     1257     if p-fact-num = ?
     1258     or p-fact-num = 0
     1259     then do:
     1260       return error "Не задан p-fact-num " + string(p-fact-num) .
     1261     end.
     1262     if p-fact-num < 0
     1263     then do:
     1264       return error "Отрицательный fact-num " + string(p-fact-num) .
     1265     end.
     1266     if p-fact-num >= 100000000
     1267     then do:
     1268       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1269     end.
     1270     if p-shift-on = true
     1271     then do:
     1272       if p-shift-date = ?
     1273       then do:
     1274         return error "Не задана дата смены" .
     1275       end.
     1276       if p-shift-num = ?
     1277       or p-shift-num = 0
     1278       then do:
     1279         return error "Не задан номер смены" .
     1280       end.
     1281     end.
     1282     else do:
     1283       assign
     1284         p-shift-date = p-fact-date
     1285         p-shift-num  = 24
     1286       .
     1287     end.
     1288     define variable v-shift-offset as integer no-undo .
     1289     if p-shift-date = p-fact-date
     1290     then do:
     1291       assign
     1292         v-shift-offset = 1
     1293       .
     1294     end.
     1295     if p-shift-date < p-fact-date
     1296     then do:
     1297       assign
     1298         v-shift-offset = 0
     1299       .
     1300     end.
     1301     if p-shift-date > p-fact-date
     1302     then do:
     1303       message
     1304         vss-workfile vss-revision vss-description skip
     1305         "Неправильная дата закрытия смены" skip
     1306         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1307         view-as alert-box error .
     1308       undo, return error
     1309         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1310           ,string(p-fact-date, '99/99/9999':U)
     1311           ,string(p-shift-date, '99/99/9999':U)
     1312           )
     1313       .
     1314     end.
     1315     if p-shift-num < 1
     1316     or p-shift-num > 24
     1317     then do:
     1318       message
     1319         vss-workfile vss-revision vss-description skip
     1320         "Неправильный номер смены" skip
     1321         "p-shift-num" p-shift-num skip
     1322         view-as alert-box error .
     1323       undo, return error return-value .
     1324     end.
     1325     assign
     1326       p-fact-order           = v-fact-date-num
     1327                              + v-shift-offset * 0.5
     1328                              + p-shift-num    * 0.02 - 0.01
     1329                              + p-fact-num     * 0.0000000001
     1330       p-shift-end-fact-order = v-fact-date-num
     1331                              + v-shift-offset * 0.5
     1332                              + p-shift-num    * 0.02
     1333       p-day-end-fact-order   = v-fact-date-num
     1334                              + 0.99
     1335     .
     1336     if p-fact-order           <= v-fact-date-num
     1337     or p-shift-end-fact-order <= v-fact-date-num
     1338     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1339     or p-shift-end-fact-order >= p-day-end-fact-order
     1340     then do:
     1341       message
     1342         vss-workfile vss-revision vss-description skip
     1343         "Внутренняя ошибка при генерации фактического номера" skip
     1344         "p-fact-date"            p-fact-date            skip
     1345         "p-fact-time"            p-fact-time            skip
     1346         "p-fact-num"             p-fact-num             skip
     1347         "p-shift-date"           p-shift-date           skip
     1348         "p-shift-num"            p-shift-num            skip
     1349         "p-shift-on"             p-shift-on             skip
     1350         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1351         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1352         "v-fact-date-num"        v-fact-date-num        skip
     1353         view-as alert-box error .
     1354       undo, return error return-value .
     1355     end.
     1356   end procedure.
     1357   procedure day-begin-fact-order :
     1358     define input  parameter p-fact-date            as date    no-undo .
     1359     define output parameter p-day-begin-fact-order as decimal no-undo .
     1360     do
     1361     on error undo, return error return-value
     1362     :
     1363       if p-fact-date = ?
     1364       then do:
     1365         assign
     1366           p-day-begin-fact-order = 0
     1367         .
     1368       end.
     1369       else do:
     1370         assign
     1371           p-day-begin-fact-order = integer(p-fact-date)
     1372         .
     1373       end.
     1374     end.
     1375   end procedure.
     1376   procedure factord-max-fact-order :
     1377     define output parameter p-max-fact-order as decimal   no-undo .
     1378     do
     1379     on error undo, return error return-value
     1380     :
     1381       run day-begin-fact-order in this-procedure
     1382         (input  date(1, 1, 5000)
     1383         ,output p-max-fact-order
     1384         ) .
     1385     end.
     1386   end procedure.
     1387   procedure factord-cut-archive :
     1388     define input  parameter p-obj-type             as character no-undo .
     1389     define input  parameter p-obj-code             as integer   no-undo .
     1390     define input  parameter p-fact-date            as date      no-undo .
     1391     define output parameter p-shift-on             as logical   no-undo .
     1392     define output parameter p-shift-date           as date      no-undo .
     1393     define output parameter p-shift-num            as integer   no-undo .
     1394     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1395     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1396     define variable v-fact-order as decimal   no-undo .
     1397     define buffer buf_shift-obj for ub.shift-obj .
     1398     do
     1399     on error undo, return error return-value
     1400     :
     1401   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1403     (input  p-obj-type
     1404     ,input  p-obj-code
     1405     ,input  'shift-on=request'
     1406     ,output p-shift-on
     1407     ) no-error .
     1408       if error-status :error
     1409       then do:
     1410         message
     1411           vss-workfile vss-revision vss-description skip
     1412           "Ошибка при определении атрибута объекта" skip
     1413           "Объект" p-obj-type p-obj-code skip
     1414           error-status :get-message(1) skip
     1415           return-value skip
     1416           view-as alert-box error .
     1417         undo, return error return-value .
     1418       end.
     1419       if p-shift-on = false
     1420       then do:
     1421         assign
     1422           p-shift-date               = ?
     1423           p-shift-num                = 0
     1424         .
     1425       end.
     1426       else do:
     1427         find first buf_shift-obj share-lock
     1428           where buf_shift-obj.obj-type   = p-obj-type
     1429             and buf_shift-obj.obj-code   = p-obj-code
     1430             and buf_shift-obj.shift-date > p-fact-date
     1431           use-index pi
     1432           no-error .
     1433         if not available buf_shift-obj
     1434         or buf_shift-obj.status_ <> 'зкр':U
     1435         then do:
     1436           message
     1437             vss-workfile vss-revision vss-description skip
     1438             "Невозможно вычислить последнюю смену" skip
     1439             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1440             "Объект" p-obj-type p-obj-code skip
     1441             "Дата" p-fact-date skip
     1442             view-as alert-box error .
     1443           undo, return error return-value .
     1444         end.
     1445         find last buf_shift-obj share-lock
     1446           where buf_shift-obj.obj-type = p-obj-type
     1447             and buf_shift-obj.obj-code = p-obj-code
     1448             and buf_shift-obj.shift-date <= p-fact-date
     1449           use-index pi
     1450           no-error .
     1451         if available buf_shift-obj
     1452         then do:
     1453           if  buf_shift-obj.status_ = 'зкр':U
     1454           then do:
     1455             assign
     1456               p-shift-date = buf_shift-obj.shift-date
     1457               p-shift-num  = buf_shift-obj.shift-num
     1458             .
     1459           end.
     1460           else do:
     1461             message
     1462               vss-workfile vss-revision vss-description skip
     1463               "Невозможно вычислить последнюю смену" skip
     1464               "Статус смены отличен от статуса" 'зкр':U skip
     1465               "Объект" p-obj-type p-obj-code skip
     1466               "Дата" p-fact-date skip
     1467               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1468               view-as alert-box error .
     1469             undo, return error return-value .
     1470           end.
     1471         end.
     1472         else do:
     1473           assign
     1474             p-shift-date = p-fact-date - 1
     1475             p-shift-num  = 1
     1476           .
     1477         end.
     1478       end.
     1479       run factord in this-procedure
     1480         (input  p-fact-date
     1481         ,input  1
     1482         ,input  1
     1483         ,input  p-shift-date
     1484         ,input  p-shift-num
     1485         ,input  p-shift-on
     1486         ,output v-fact-order
     1487         ,output p-shift-end-fact-order
     1488         ,output p-day-end-fact-order
     1489         ) no-error .
     1490       if error-status :error
     1491       then do:
     1492         message
     1493           vss-workfile vss-revision vss-description skip
     1494           "Ошибка при вызове процедуры factord"
     1495           error-status :get-message(1) skip
     1496           return-value skip
     1497           view-as alert-box error .
     1498         undo, return error return-value .
     1499       end.
     1500     end.
     1501   end procedure.
     1502   procedure factord-lock-shift :
     1503     define input  parameter p-obj-type  as character no-undo .
     1504     define input  parameter p-obj-code  as integer   no-undo .
     1505     define input  parameter p-fact-date as date      no-undo .
     1506     define parameter buffer buf_shift-obj for ub.shift-obj .
     1507     define variable v-shift-on      as logical   no-undo .
     1508     define variable v-extra-message as character no-undo .
     1509     define variable v-error as character no-undo .
     1510     do
     1511     on error undo, return error return-value
     1512     :
     1513   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1514   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1515     (input  p-obj-type
     1516     ,input  p-obj-code
     1517     ,input  'shift-on=request'
     1518     ,output v-shift-on
     1519     ) no-error .
     1520       if error-status :error
     1521       then do:
     1522         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1523         undo, return error v-error .
     1524       end.
     1525       if v-shift-on = true
     1526       then do:
     1527         find first buf_shift-obj share-lock
     1528           where buf_shift-obj.obj-type   = p-obj-type
     1529             and buf_shift-obj.obj-code   = p-obj-code
     1530             and buf_shift-obj.shift-date > p-fact-date
     1531           use-index pi
     1532           no-error .
     1533         if not available buf_shift-obj
     1534         or buf_shift-obj.status_ <> 'зкр':U
     1535         then do:
     1536           find last buf_shift-obj
     1537             where buf_shift-obj.obj-type = p-obj-type
     1538               and buf_shift-obj.obj-code = p-obj-code
     1539               and buf_shift-obj.status_  = 'зкр':U
     1540             use-index stts
     1541             no-error .
     1542           if available buf_shift-obj
     1543           then do:
     1544             assign
     1545               v-extra-message =
     1546                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1547                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1548                               )
     1549             .
     1550           end.
     1551           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1552           undo, return error v-error .
     1553         end.
     1554       end.
     1555     end.
     1556   end procedure.
     1557   procedure factord-end-day :
     1558     define input  parameter p-fact-date            as date    no-undo .
     1559     define output parameter p-day-end-fact-order   as decimal no-undo .
     1560     do
     1561     on error undo, return error return-value
     1562     :
     1563       if p-fact-date = ?
     1564       then do:
     1565         return error "Не указана фактическая дата" .
     1566       end.
     1567       assign
     1568         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1569       .
     1570     end.
     1571   end procedure.
     1572   procedure factord-to-date :
     1573     define input  parameter p-fact-order as decimal no-undo .
     1574     define output parameter p-fact-date  as date    no-undo .
     1575     define variable v-ref-date  as date      no-undo .
     1576     define variable v-ref-delta as integer   no-undo .
     1577     do
     1578     on error undo, return error return-value
     1579     :
     1580       if p-fact-order = ?
     1581       or p-fact-order = 0
     1582       then do:
     1583         return error "Не указан fact-order" .
     1584       end.
     1585       assign
     1586         v-ref-date  = date(1, 1, 2000)
     1587       .
     1588       assign
     1589         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1590       .
     1591       assign
     1592         p-fact-date = v-ref-date + v-ref-delta
     1593       .
     1594     end.
     1595   end procedure.
     1596   procedure factord-to-fact-num :
     1597     define input  parameter p-fact-order as decimal no-undo .
     1598     define output parameter p-fact-num   as integer no-undo .
     1599     define variable v-fact-order-trunc as decimal no-undo .
     1600     do
     1601     on error undo, return error return-value
     1602     :
     1603       if p-fact-order = ?
     1604       or p-fact-order = 0
     1605       then do:
     1606         return error "Не указан fact-order" .
     1607       end.
     1608       assign
     1609        v-fact-order-trunc = truncate(p-fact-order, 2)
     1610       .
     1611       assign
     1612         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1613       .
     1614     end.
     1615   end procedure.
     1616   procedure factord-to-shift-num :
     1617     define input  parameter p-fact-order as decimal no-undo .
     1618     define output parameter p-shift-num   as integer no-undo .
     1619     define variable  p-shift-numd  as decimal   no-undo .
     1620     define variable v-fact-order-trunc as decimal no-undo .
     1621     do
     1622     on error undo, return error return-value
     1623     :
     1624       if p-fact-order = ?
     1625       or p-fact-order = 0
     1626       then do:
     1627         return error "Не указан fact-order" .
     1628       end.
     1629       assign
     1630        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1631       .
     1632       if v-fact-order-trunc < 0.5 then do:
     1633         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1634       end.
     1635       assign
     1636         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1637         .
     1638        assign
     1639         p-shift-num = truncate (p-shift-numd , 0)
     1640       .
     1641     end.
     1642   end procedure.
     1643   procedure proc-close-one-fin-ob :
     1644    do
     1645    on error undo, return error return-value
     1646    :
     1647   define input parameter p-recid  as recid no-undo .
     1648   define buffer buf_fin-liab-fo   for ub.fin-ob .
     1649   define buffer buf_fin-ob-before for ub.fin-ob-before .
     1650   define buffer ff_fin-ob-trn     for ub.fin-ob-trn  .
     1651   define variable  v-fact-date            as date    no-undo .
     1652   define variable  v-fact-time            as integer no-undo .
     1653   define variable  v-fact-num             as integer no-undo .
     1654   define variable  v-shift-date           as date    no-undo .
     1655   define variable  v-shift-num            as integer no-undo .
     1656   define variable  v-shift-on             as logical no-undo .
     1657   define variable  v-fact-order           as decimal no-undo .
     1658   define variable  v-shift-end-fact-order as decimal no-undo .
     1659   define variable  v-day-end-fact-order   as decimal no-undo .
     1660   define variable  var-fo-fact as logical   no-undo .
     1661   define variable  par-type         as character no-undo .
     1662   define variable  v-value-date     as date   no-undo .
     1663   define variable  v-value-decimal  as decimal   no-undo .
     1664   define variable  v-value-integer  as integer   no-undo .
     1665   define variable  v-value-logical  as logical   no-undo .
     1666   define variable v-found           as logical   no-undo .
     1667   define variable v-value-character as character no-undo .
     1668   define variable v-i as integer   no-undo .
     1669   define variable p-recalc     as logical   no-undo .
     1670   define variable p-recalc2    as logical   no-undo .
     1671   define buffer recalc_fin-ob for ub.fin-ob  .
     1672   run thbjattr_value in this-procedure  (
     1673     input   "",
     1674     input   0 ,
     1675     input   'fin-global':U ,
     1676     input   'fo-fact'  ,
     1677     output  v-value-character ,
     1678     output  v-value-date      ,
     1679     output  v-value-decimal   ,
     1680     output  v-value-integer   ,
     1681     output  var-fo-fact  ,
     1682     output  par-type            ,
     1683     output  v-found
     1684     ) no-error
     1685     .
     1686   if error-status :error then var-fo-fact = false .
     1687   find first buf_fin-liab-fo no-lock where recid(buf_fin-liab-fo) = p-recid  no-error .
     1688   release buf_fin-liab-fo no-error .
     1689   find first  buf_fin-liab-fo  exclusive-lock  where recid(buf_fin-liab-fo) = p-recid  no-error .
     1690   if not available buf_fin-liab-fo then return error .
     1691      if buf_fin-liab-fo.pay-date = ? then do:
     1692         message "Финансовое обязательство : " buf_fin-liab-fo.prn-doc-code  skip
     1693                 "не задана дата платежа!"  skip
     1694                 "Закрывать ФО ?"
     1695                 view-as alert-box question
     1696                 buttons yes-no
     1697                 update v-ok as log
     1698               .
     1699         if v-ok = false then  return.
     1700      end.
     1701      if buf_fin-liab-fo.status_ = 'факт':U then do:
     1702         message "Финансовое обязательство " buf_fin-liab-fo.prn-doc-code  " уже закрыто до ФАКТ".
     1703         return.
     1704      end.
     1705     run cur-time
     1706         ( output v-fact-date
     1707         , output v-fact-time
     1708         ).
     1709     if var-fo-fact = yes then do:
     1710        v-fact-date = 01/01/1900 .
     1711        v-i = 0 .
     1712        for each ff_fin-ob-trn no-lock  where
     1713                 ff_fin-ob-trn.doc-code  =  buf_fin-liab-fo.doc-code and
     1714                 ff_fin-ob-trn.host-code =  buf_fin-liab-fo.host-code
     1715               :
     1716               v-i = v-i + 1.
     1717              case ff_fin-ob-trn.doc-type  :
     1718              when "spc" then do:
     1719                 run cur-time
     1720                     ( output v-fact-date
     1721                     , output v-fact-time
     1722                     ).
     1723              end.
     1724              when "order" then do:
     1725                   find first ub.ord-doc   no-lock where ub.ord-doc.doc-code   =  ff_fin-ob-trn.trn-doc-code no-error .
     1726                   if available ub.ord-doc then do:
     1727                       if v-fact-date < ub.ord-doc.fact-date then v-fact-date = ub.ord-doc.fact-date.
     1728                   end.
     1729              end.
     1730              when "rcv" then do:
     1731                 run cur-time
     1732                     ( output v-fact-date
     1733                     , output v-fact-time
     1734                     ).
     1735              end.
     1736              when "add" then do:
     1737                 run cur-time
     1738                     ( output v-fact-date
     1739                     , output v-fact-time
     1740                     ).
     1741              end.
     1742              otherwise do:
     1743                   find first ub.trn-doc   no-lock where ub.trn-doc.doc-code   =  ff_fin-ob-trn.trn-doc-code no-error .
     1744                   if available ub.trn-doc then do:
     1745                       if v-fact-date < ub.trn-doc.fact-date then v-fact-date = ub.trn-doc.fact-date.
     1746                   end.
     1747                   find first ub.c-trn-doc no-lock where ub.c-trn-doc.doc-code =  ff_fin-ob-trn.trn-doc-code
     1748                                                     and ub.c-trn-doc.is-del = true   no-error .
     1749                   if available ub.c-trn-doc then do:
     1750                       if v-fact-date < ub.c-trn-doc.corr-date then v-fact-date = ub.c-trn-doc.corr-date.
     1751                   end.
     1752              end.
     1753              end case.
     1754        end.
     1755        if v-i = 0  then do:
     1756             run cur-time
     1757                 ( output v-fact-date
     1758                 , output v-fact-time
     1759                 ).
     1760        end.
     1761     end.
     1762     assign
     1763         v-fact-num   = next-value ( s-fin-ob-fact, ub )
     1764         v-shift-date = ?
     1765         v-shift-num  = ?
     1766         v-shift-on   = false
     1767     .
     1768      run factord in this-procedure (
     1769          input  v-fact-date
     1770         ,input  v-fact-time
     1771         ,input  v-fact-num
     1772         ,input  v-shift-date
     1773         ,input  v-shift-num
     1774         ,input  v-shift-on
     1775         ,output v-fact-order
     1776         ,output v-shift-end-fact-order
     1777         ,output v-day-end-fact-order
     1778         ) .
     1779      assign
     1780       buf_fin-liab-fo.fact-order       =  v-fact-order
     1781       buf_fin-liab-fo.status_          =  'факт':U
     1782       buf_fin-liab-fo.fact-date        =  v-fact-date
     1783       buf_fin-liab-fo.user-db-num-fact =  g#db-num
     1784       buf_fin-liab-fo.user-name-fact   =  g#userid
     1785      .
     1786      run str/calc-bal.p (input "finob", input yes, input buf_fin-liab-fo.doc-type, input buf_fin-liab-fo.host-code, input buf_fin-liab-fo.contract-code, input buf_fin-liab-fo.sum-contract, input buf_fin-liab-fo.sum-rubl, input buf_fin-liab-fo.sum-base) .
     1787      find first ub.contract no-lock
     1788           where ub.contract.contract-code = buf_fin-liab-fo.contract-code and
     1789                 ub.contract.host-code     = buf_fin-liab-fo.host-code
     1790                 no-error.
     1791      if available ub.contract then do:
     1792        if ( ub.contract.gen-factur = 2 or
     1793             ub.contract.gen-factur = 12 or
     1794             ub.contract.gen-factur = 102 or
     1795             ub.contract.gen-factur = 112) then
     1796          assign
     1797            buf_fin-liab-fo.need-factur = 1
     1798            .
     1799      end.
     1800      for each buf_fin-ob-before  exclusive-lock  where
     1801               buf_fin-ob-before.host-code = buf_fin-liab-fo.host-code and
     1802               buf_fin-ob-before.doc-code  = buf_fin-liab-fo.doc-code and
     1803               buf_fin-ob-before.status_   = 'авто':U
     1804               on error undo, return error :
     1805           assign
     1806             buf_fin-ob-before.fact-order       =  v-fact-order
     1807             buf_fin-ob-before.status_          =  'факт':U
     1808             buf_fin-ob-before.fact-date        =  v-fact-date
