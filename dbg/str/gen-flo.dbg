     3738   procedure clcprtsl_calc-ttable :
     3739   define input parameter paris-doc           as   logical                 no-undo.
     3740   define input parameter paris-cur           as   logical                 no-undo.
     3741   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3742   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3743   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3744   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3745   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3746   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3747   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3748   define input parameter parr-b              as   character               no-undo.
     3749   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3750   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3751   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3752   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3753   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3754   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3755   define buffer bf_tt-allsum      for tt-allsum.
     3756   define buffer bf_tt-clcparts    for tt-clcparts.
     3757   define buffer bf_tt-allsum-line for tt-allsum-line.
     3758   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3759   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3760   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3761   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3762   define variable varexcise          like ub.price-list.excise     no-undo.
     3763   do on error undo, return error return-value :
     3764   for each bf_tt-allsum-line
     3765   on error undo, return error return-value
     3766    :
     3767     delete bf_tt-allsum-line.
     3768   end.
     3769   for each bf_tt-allsum
