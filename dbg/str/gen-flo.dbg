     4817       input  n-base-rate         ,
     4818       input  n-base-scale        ,
     4819       input  n-receiver-code     ,
     4820       input  n-receiver-type     ,
     4821       input  n-contract-code     ,
     4822       input  n-exch-rate         ,
     4823       input  n-exch-scale        ,
     4824       input  n-contract-curr     ,
