     5273           end.
     5274           if  min-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) <= n-doc-date
     5275               then n-pay-date = n-doc-date.
     5276               else n-pay-date = min-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     5277     run fin-ob-code (input g#db-num , output p-doc-code) .
     5278     run create-fin-liab (
     5279       input  yes                   ,
     5280       input  p-doc-code            ,
