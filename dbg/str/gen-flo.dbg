     5403   procedure make-temp-obj-firm :
     5404    do
     5405    on error undo, return error return-value
     5406    :
     5407    define buffer buf_shop for shop .
     5408    define buffer buf_store for store .
     5409   for each temp-obj-firm : delete temp-obj-firm. end.
     5410       for each buf_shop no-lock where buf_shop.host-code = par-host-code  on error undo, return error :
     5411           create temp-obj-firm.
     5412           assign
     5413             temp-obj-firm.obj-code = buf_shop.obj-code
     5414             temp-obj-firm.obj-type = 'маг':U
     5415           .
     5416       end.
     5417       for each buf_store no-lock where buf_store.host-code = par-host-code  on error undo, return error :
     5418           create temp-obj-firm.
     5419           assign
     5420             temp-obj-firm.obj-code = buf_store.obj-code
     5421             temp-obj-firm.obj-type = 'скл':U
     5422           .
     5423       end.
     5424    end.
     5425   end procedure.
     5426   procedure close-fo-fact :
     5427    do
     5428    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5429    :
     5430   define input parameter p-host-code as integer no-undo .
     5431   define input parameter p-doc-code  as character no-undo .
     5432   define buffer buf_fact-fin-ob   for fin-ob .
     5433   define buffer buf_fact-contract for contract .
     5434   find first buf_fact-fin-ob  no-lock where buf_fact-fin-ob.host-code = p-host-code and
     5435                                             buf_fact-fin-ob.doc-code  = p-doc-code no-error .
     5436                                             if error-status :error then
     5437                                             do:
     5438                                             return  error .
     5439                                             end.
     5440     find first buf_fact-contract no-lock where  buf_fact-contract.host-code = buf_fact-fin-ob.host-code and
     5441                                                 buf_fact-contract.contract-code = buf_fact-fin-ob.contract-code no-error .
     5442                                                 if error-status :error then
     5443                                                 do:
     5444                                                 return  error .
     5445                                                 end.
     5446     if buf_fact-contract.auto-pay  > 0 then do:
     5447         run proc-close-one-fin-ob (recid(buf_fact-fin-ob)) no-error .
     5448         if error-status :error then do:
     5449            message vss-workfile vss-revision vss-description skip
     5450                   "№ ФО :" buf_fact-fin-ob.doc-code skip
     5451                   "№ фирмы :" buf_fact-fin-ob.host-code skip
     5452                   "Вн.№ договора :" buf_fact-fin-ob.contract-code skip
     5453                   "Ошибка закрытия на факт ФО на ПН " skip
     5454                    skip
     5455                    error-status :get-message(1) skip
     5456                    return-value skip
     5457                    view-as alert-box error
     5458            .
     5459            return error .
     5460         end.
     5461         if buf_fact-contract.auto-pay > 1 then do:
     5462            run str/payfoavt.p ( input parParentProc, input par-host-code, input recid(buf_fact-fin-ob)) no-error .
     5463            if error-status :error then do:
     5464               message vss-workfile vss-revision vss-description skip
     5465                       "№ ФО :" buf_fact-fin-ob.doc-code skip
     5466                       "№ фирмы :" buf_fact-fin-ob.host-code skip
     5467                       "Вн.№ договора :" buf_fact-fin-ob.contract-code skip
     5468                       "Ошибка автоматического создания платежа . Вернула процедура  payfoavt.p " skip
     5469                       skip
     5470                       error-status :get-message(1) skip
     5471                       return-value skip
     5472                       view-as alert-box error
     5473               .
     5474               return error .
     5475            end.
     5476         end.
     5477     end.
     5478    end.
     5479   end procedure.
