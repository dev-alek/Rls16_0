        1   block-level on error undo, throw.
        2   define temp-table tt-trn-doc  no-undo like ub.ord-doc.
        3   define input parameter parparentproc  as widget-handle no-undo.
        4   define input parameter par-host-code  like ub.clients.obj-code no-undo.
        5   define input parameter p-date-end     as date no-undo    .
        6   define input parameter p-trn-doc      as integer no-undo .
        7   define input parameter p-cons         as integer no-undo .
        8   define input parameter p-nalog        as integer no-undo .
        9   define input parameter table for tt-trn-doc .
       10   define input-output parameter p-res as character no-undo .
       11   define input  parameter p-type-date as integer   no-undo .
       12   define input  parameter p-adm     as logical   no-undo .
       13   define input  parameter p-fo-type as character no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       15   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       16   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile: gen-flo.p $":U .
       18   define variable vss-archive     as character no-undo init "$Archive: str/gen-flo.p $":U .
       19   define variable vss-description as character no-undo init "Генерации ФО по заказам".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define new global shared variable g#language as character no-undo .
      120   if g#language <> '' and g#language <> 'rus':U then do:
      121     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      122   end.
      123   define new global shared variable g#library  as handle no-undo .
      124   define new global shared variable g#library2 as handle no-undo .
      125   define   shared variable g#auto as logical no-undo.
      126   define   shared variable g#news as logical no-undo.
      127   define   shared variable g#oxml as logical no-undo.
      128   define   shared variable g#esys as logical no-undo.
      129   define   shared variable g#news-source-db as integer no-undo.
      130   define   shared variable g#esys-source-esys as integer no-undo.
      131   define   shared variable g#db-num as integer   no-undo .
      132   define   shared variable g#userid as character no-undo .
      133   define   shared variable g#passwd as character no-undo .
      134   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   define variable v-waitfram-action01         as character   no-undo .
      136   define variable v-waitfram-action02         as character   no-undo .
      137   define variable v-waitfram-action03         as character   no-undo .
      138   define variable mWaitFramTextBeg            as character   no-undo.
      139   define variable mWaitFramTextEnd            as character   no-undo.
      140   define variable mWaitFramView               as logical     no-undo.
      141   define variable mWaitProcEvent              as logical     no-undo init yes.
      142   define variable mWaitFramInterval           as integer     no-undo init 1 .
      143   define variable mWaitFramStop               as logical     no-undo.
      144   define variable mWaitFramStopUser           as logical     no-undo.
      145   define variable mWaitFramStopTimeOut        as logical     no-undo.
      146   define variable mWaitFramStartProc          as datetime-tz no-undo.
      147   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      148   define button B-WaitFramStop auto-end-key
      149        label "Стоп"
      150        size 10 by 1 tooltip "Остоновить процесс".
      151   define button B-viewProcInfo
      152        label "Информация"
      153        size 15 by 1 tooltip "Информация о процесс".
      154   define frame waitfram
      155     v-waitfram-action01 format "x(72)" no-label skip
      156     v-waitfram-action02 format "x(72)" no-label skip
      157     v-waitfram-action03 format "x(72)" no-label skip
      158     B-viewProcInfo
      159     B-WaitFramStop at row 4 col 30
      160     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      161     .
      162   define new global shared variable mBatchMode as logical no-undo init ?.
      163   define variable mFramBachModHandle as handle no-undo.
      164   mFramBachModHandle = frame waitfram:handle.
      165   define variable mFameOldVis as logical no-undo.
      166   define variable mVisCUrentVin as logical no-undo.
      167   if session:batch-mode
      168   then
      169      mBatchMode = yes.
      170   if mBatchMode = ? then do:
      171     mVisCUrentVin = current-window:visible.
      172     mFameOldVis = mFramBachModHandle:visible.
      173     mFramBachModHandle:visible  = yes.
      174     mBatchMode = mFramBachModHandle:visible ne yes.
      175     mFramBachModHandle:visible = mFameOldVis.
      176     current-window:visible = mVisCUrentVin.
      177   end.
      178    if  log-manager:logfile-name ne ?
      179     then DO:
      180         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      181         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      182         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      183     end.
      184   on choose of B-WaitFramStop in frame waitfram
      185   do:
      186     mWaitFramStop = yes.
      187     mWaitFramStopUser = yes.
      188   end.
      189   function waitfram-check-timeout returns logical():
      190      define variable vtime as int64 no-undo.
      191      if mWaitFramStopTimeOut
      192      then
      193         return yes.
      194      vtime = ( now - mWaitFramStartProc ) / 1000 .
      195      if     mWaitFramTimeOut ne ?
      196         and mWaitFramTimeOut ne 0
      197         and mWaitFramTimeOut lt vtime
      198      then do:
      199         mWaitFramStopTimeOut = yes.
      200      end.
      201      return mWaitFramStopTimeOut.
      202   end.
      203   procedure waitfram-hide :
      204     if not session:batch-mode
      205     then do
      206     on error undo, return error return-value
      207     :
      208       pause 0 before-hide .
      209       if not mBatchMode then
      210         hide frame waitfram .
      211     if     not mWaitFramView
      212        and mWaitProcEvent
      213     then
      214       process events .
      215     end.
      216   end procedure.
      217   procedure waitfram-show :
      218     define input  parameter p-message as character no-undo .
      219     define variable v-left-margin as integer   no-undo .
      220     if not session:batch-mode
      221     then do
      222     on error undo, return error return-value
      223     :
      224       if length(p-message) <= 70 then do:
      225         assign
      226           v-left-margin = integer((70 - length(p-message)) / 2)
      227         .
      228         assign
      229           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      230         .
      231         assign
      232           v-waitfram-action01 = " "
      233           v-waitfram-action02 = " "
      234                                    + fill(" ", v-left-margin)
      235                                    + p-message
      236           v-waitfram-action03 = " "
      237         .
      238       end.
      239       else do:
      240         define variable vRindex1 as integer no-undo.
      241         define variable vRindex2 as integer no-undo.
      242         vRindex1 = r-index(p-message," ",70).
      243         if vRindex1 = 0
      244         then
      245            vRindex1 = 70.
      246         if length(p-message)  <= vRindex1 + 70 then do:
      247           assign
      248             v-waitfram-action01 = " "
      249             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      250             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      251           .
      252         end.
      253         else do:
      254           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      255           if vRindex2 <= vRindex1
      256           then
      257              vRindex2 = vRindex1 + 70.
      258           assign
      259             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      260             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      261             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      262           .
      263         end.
      264       end.
      265       B-viewProcInfo:visible   in frame waitfram = no.
      266       B-viewProcInfo:sensitive in frame waitfram = no.
      267       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      268       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      269       if  (   mWaitFramView
      270          or  mWaitProcEvent)
      271          and not mBatchMode
      272       then
      273          display
      274             v-waitfram-action01 skip
      275             v-waitfram-action02 skip
      276             v-waitfram-action03 skip
      277          with frame waitfram .
      278       if     mWaitFramView
      279          then do:
      280             if     mWaitFramInterval ne ?
      281                and not mBatchMode
      282             then
      283                wait-for go of frame waitfram pause mWaitFramInterval.
      284          end.
      285          else
      286             if     mWaitProcEvent
      287                and not mBatchMode
      288             then
      289                process events .
      290     end.
      291   end procedure.
      292      procedure waitfram-show-this:
      293         define input  parameter iInterval as int64 no-undo.
      294         define variable vtime as int64 no-undo.
      295         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      296         mWaitFramInterval = iInterval.
      297         run waitfram-show (substitute("&1&2 &3&4" ,
      298                                       mWaitFramTextBeg ,
      299                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      300                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      301                                       mWaitFramTextEnd
      302                                      )
      303                           ).
      304      end.
      305      procedure WaitFramRunPause:
      306         define input  parameter iInterval as dec no-undo.
      307         define variable vStart  as datetime-tz no-undo.
      308         define variable vend    as datetime-tz no-undo.
      309         define variable vint as int64 no-undo.
      310         define variable vOk as logical no-undo.
      311         vStart = now.
      312         vend   = vStart.
      313         publish "WaitFramPause" (iInterval,output vOk).
      314         vend   =  now.
      315         vint = vend - vStart.
      316         vint = iInterval - vint / 1000.
      317         if     not mWaitFramStop
      318            and (   vint > 0
      319                 or (    not vOk
      320                     and iInterval eq ?
      321                     )
      322                 )
      323         then
      324            run waitfram-show-this (iInterval).
      325         vend   =  now.
      326         vint = vend - vStart.
      327         vint = iInterval - vint / 1000.
      328         if     not mWaitFramStop
      329            and vint > 0
      330         then do:
      331            run gbl/pause.p (vint * 1000).
      332         end.
      333         if iInterval ne ?
      334         then
      335            publish "WaitFramStop".
      336         waitfram-check-timeout().
      337      end.
      338      procedure WaitFramWaitFor:
      339         define input  parameter iInterval as dec no-undo.
      340         assign
      341            mWaitFramStartProc   = now
      342            mWaitFramStopUser    = no
      343            mWaitFramStopTimeOut = no
      344         .
      345         block-wait:
      346         do while not mWaitFramStop:
      347            run WaitFramRunPause (iInterval).
      348            if  waitfram-check-timeout()
      349            then do:
      350               leave block-wait.
      351            end.
      352         end.
      353         run waitfram-hide.
      354      end.
      355   procedure waitfram-join :
      356     define input  parameter p-line-1  as character no-undo .
      357     define input  parameter p-line-2  as character no-undo .
      358     define input  parameter p-line-3  as character no-undo .
      359     define output parameter p-message as character no-undo .
      360     do
      361     on error undo, return error return-value
      362     :
      363       assign
      364         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      365                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      366                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      367       .
      368     end.
      369   end procedure.
      370   function waitfram-join-function returns character
      371     (input p-line-1 as character
      372     ,input p-line-2 as character
      373     ,input p-line-3 as character
      374     ).
      375     define variable v-message as character no-undo .
      376     run waitfram-join in this-procedure
      377       (input  p-line-1
      378       ,input  p-line-2
      379       ,input  p-line-3
      380       ,output v-message
      381       ) .
      382     return v-message .
      383   end function .
      384   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   procedure cur-time :
      386      define output parameter p-today as date      no-undo .
      387      define output parameter p-time  as integer   no-undo .
      388     do
      389     on error undo, return error
      390     :
      391       define variable v-date1 as date      no-undo .
      392       define variable v-date2 as date      no-undo .
      393       define variable v-time  as integer   no-undo .
      394       assign
      395         v-date1 = today
      396         v-time  = time
      397         v-date2 = today
      398       .
      399       if v-date1 <> v-date2
      400       then do:
      401         assign
      402           v-date1 = today
      403           v-time  = v-time
      404         .
      405       end.
      406       assign
      407         p-today = v-date1
      408         p-time  = v-time
      409       .
      410     end.
      411   end.
      412   function cur-time-date returns character
      413   :
      414     return string(today, '99/99/9999':U) .
      415   end.
      416   function cur-time-mjd returns decimal
      417   :
      418     define variable v-date as date      no-undo .
      419     define variable v-time as integer   no-undo .
      420     run cur-time in this-procedure
      421       (output v-date
      422       ,output v-time
      423       ) .
      424     return integer(v-date) - 2400002 + (v-time / 86400) .
      425   end.
      426   function cur-time-get-ending-index returns integer
      427   (input p-number as integer
      428   )
      429   :
      430     if p-number < 0
      431     or p-number = ?
      432     then do:
      433       return 1 .
      434     end.
      435     define variable v-rest as integer   no-undo .
      436     assign
      437       p-number = p-number modulo 100
      438     .
      439     if p-number < 20
      440     then do:
      441       assign
      442         v-rest = p-number
      443       .
      444     end.
      445     else do:
      446       assign
      447         v-rest = p-number modulo 10
      448       .
      449     end.
      450     case v-rest :
      451       when 1
      452       then do:
      453         return 2 .
      454       end.
      455       when 2 or
      456       when 3 or
      457       when 4
      458       then do:
      459         return 3 .
      460       end.
      461       otherwise do:
      462         return 1 .
      463       end.
      464     end case .
      465   end.
      466   procedure cur-time-mjd-to-date :
      467      define input  parameter i-mjd-diff as decimal no-undo.
      468      define output parameter o-Date     as date    no-undo.
      469      define output parameter o-Time     as integer no-undo.
      470      define variable v-day-number as integer   no-undo .
      471      if    i-mjd-diff < 0
      472         or i-mjd-diff = ?
      473      then do:
      474         return "?" .
      475      end.
      476      assign
      477         v-day-number = truncate(i-mjd-diff,0).
      478         o-Date = date(v-day-number + 2400002).
      479         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      480     .
      481   end.
      482   function cur-time-mjd-to-string returns character
      483   (input p-mjd-diff as decimal
      484   )
      485   :
      486     define variable v-day-number as integer   no-undo .
      487     define variable v-seconds    as integer   no-undo .
      488     define variable v-hour       as integer   no-undo .
      489     define variable v-min        as integer   no-undo .
      490     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      491     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      492     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      493     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      494     if p-mjd-diff < 0
      495     or p-mjd-diff = ?
      496     then do:
      497       return "?" .
      498     end.
      499     assign
      500       v-day-number = integer(truncate(p-mjd-diff,0))
      501       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      502     .
      503     if v-seconds > 86400
      504     then do:
      505       assign
      506         v-seconds = 86400 - 1
      507       .
      508     end.
      509     if v-seconds < 0
      510     then do:
      511       assign
      512         v-seconds = 0
      513       .
      514     end.
      515     assign
      516       v-hour = truncate(v-seconds / 3600, 0)
      517     .
      518     assign
      519       v-seconds = v-seconds modulo 3600
      520     .
      521     assign
      522       v-min = truncate(v-seconds / 60, 0)
      523     .
      524     assign
      525       v-seconds = v-seconds modulo 60
      526     .
      527     return
      528         (if v-day-number <> 0
      529           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      530           else ""
      531         )
      532       + (if v-day-number <> 0 or v-hour <> 0
      533           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      534           else ""
      535         )
      536       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      537           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      538           else ""
      539         )
      540       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      541       .
      542   end.
      543   function cur-time-string returns character
      544   :
      545     define variable v-date as date      no-undo .
      546     define variable v-time as integer   no-undo .
      547     run cur-time in this-procedure
      548       (output v-date
      549       ,output v-time
      550       ) .
      551     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      552   end.
      553   function cur-time-string-sec returns character
      554   :
      555     define variable v-date as date      no-undo .
      556     define variable v-time as integer   no-undo .
      557     run cur-time in this-procedure
      558       (output v-date
      559       ,output v-time
      560       ) .
      561     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      562   end.
      563   function cur-time-custom  returns character
      564   (input p-prefix as character
      565   ,input p-date-format as character
      566   ,input p-delimiter as character
      567   ,input p-time-format as character
      568   ,input p-suffix as character
      569   )
      570   :
      571     define variable v-date as date      no-undo .
      572     define variable v-time as integer   no-undo .
      573     run cur-time in this-procedure
      574       (output v-date
      575       ,output v-time
      576       ) .
      577     return
      578       p-prefix
      579       + string(v-date, p-date-format)
      580       + p-delimiter
      581       + string(v-time, p-time-format)
      582       + p-suffix
      583       .
      584   end.
      585   function cur-time-print  returns character
      586   :
      587     define variable v-date as date      no-undo .
      588     define variable v-time as integer   no-undo .
      589     run cur-time in this-procedure
      590       (output v-date
      591       ,output v-time
      592       ) .
      593     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      594   end.
      595   function cur-time-datetime returns datetime
      596   :
      597     define variable v-char as character no-undo .
      598     define variable v-datetime as datetime no-undo .
      599     v-char = cur-time-string().
      600     v-datetime = datetime(v-char).
      601     return  v-datetime.
      602   end.
      603   function cur-time-string-msec returns character
      604   :
      605     define variable v-date as datetime  no-undo .
      606     v-date = now.
      607     return string(v-date) .
      608   end.
      609   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      610   define buffer buf_file for ub.fin-ob .
      611   procedure current-db :
      612    do
      613    on error undo, return error return-value
      614    :
      615   define input parameter  p-host-code as integer no-undo .
      616   define input parameter  c-host-code as integer no-undo .
      617   define output parameter ret         as logical no-undo .
      618   define buffer current_sysconf for ub.sysconf.
      619   define variable v-current-db as integer no-undo .
      620   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      621   if error-status :error then return error .
      622      v-current-db = current_sysconf.firm-db-num .
      623      ret = true .
      624   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
      625   if not( ub.sysconf.firm-db-num = v-current-db or
      626           ub.sysconf.firm-db-num = 0 )
      627     then do:
      628     ret = false .
      629     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
      630     return .
      631   end.
      632    end.
      633   end procedure.
      634   procedure ver-db :
      635    do
      636    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      637    :
      638   define input parameter  c-host-code as integer no-undo .
      639   define input parameter  par-ver-db  as integer no-undo .
      640   define input parameter  p-mess as logical no-undo .
      641   define output parameter ret         as logical no-undo .
      642   define buffer current_sysconf for ub.sysconf.
      643   define variable v-current-db as integer no-undo .
      644   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      645   if error-status :error then return error .
      646      v-current-db = current_sysconf.firm-db-num .
      647      ret = true .
      648   if not( par-ver-db = v-current-db or
      649           par-ver-db = 0 )
      650     then do:
      651     ret = false .
      652     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
      653     return .
      654   end.
      655    end.
      656   end procedure.
      657   procedure fin-ob-code :
      658    do
      659    on error undo, return error return-value
      660    :
      661     define input  parameter p-db-num as integer no-undo .
      662     define output parameter p-fin-ob-code  as character no-undo .
      663     if p-db-num = 0 then
      664         p-fin-ob-code = string( next-value(s-fin-ob, ub)) .
      665         else
      666         p-fin-ob-code = string( next-value(s-fin-ob, ub)) + "-" + string(p-db-num).
      667    end.
      668   end procedure.
