     2341   end.
     2342   else do:
     2343     find first out-vatp_doc-attrcl no-lock
     2344       where out-vatp_doc-attrcl.doc-code  = pardoc-code
     2345         and out-vatp_doc-attrcl.attr-code = 'envd':U
     2346         no-error .
     2347     if not available out-vatp_doc-attrcl then do:
