     3295       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     3296       .
     3297   end.
     3298   otherwise do:
     3299     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     3300                              cl_tt-clcparts.purch-code,
     3301                              cl_tt-clcparts.part-code,
     3302                              cl_tt-clcparts.out-code,
     3303                              cl_tt-clcparts.in-code,
     3304                              cl_tt-clcparts.artic,
     3305                              cl_tt-clcparts.prod-type,
     3306                              cl_tt-clcparts.prod-code).
     3307   end.
     3308   end case.
     3309   end.
     3310   end procedure.
     3311   procedure clcprtsl_calc-line :
     3312   define input  parameter parrec-line as recid no-undo.
     3313   define variable v-tax-date         as   date                     no-undo.
     3314   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     3315   define variable varr-b             as   character                no-undo.
     3316   define variable varr-btype         as   character                no-undo.
     3317   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     3318   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     3319   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     3320   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     3321   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     3322   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     3323   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     3324   define variable varb-code          like ub.bar-code.b-code       no-undo.
     3325   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3326   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3327   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3328   define variable varexcise          like ub.price-list.excise     no-undo.
     3329   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     3330   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     3331   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     3332   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3333   define variable v-varsum           as decimal                  no-undo.
     3334   define variable varprice-salef as decimal   no-undo .
     3335   define buffer bf_trn-doc             for ub.trn-doc.
     3336   define buffer bf_doc-line            for ub.doc-line.
     3337   define buffer bf_gds-dtl             for ub.gds-dtl.
     3338   define buffer bf_goods               for ub.goods.
     3339   define buffer bf_parts               for ub.parts.
     3340   define buffer bf_sysconf             for ub.sysconf.
     3341   define buffer bf_tt-allsum-line      for tt-allsum-line.
     3342   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     3343   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     3344   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     3345   define buffer buf_parts        for ub.parts.
     3346   v-calcbypart = no.
     3347   do on error undo, return error return-value :
     3348   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3349   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3350     (output varr-b
     3351     )  .
     3352     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     3353     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     3354     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     3355                               bf_goods.prod-type = bf_doc-line.prod-type and
     3356                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     3357     if bf_trn-doc.fact-date <> ?        then do:
     3358       assign v-tax-date = bf_trn-doc.fact-date.
     3359     end.
     3360     else do:
     3361       assign v-tax-date = ?.
     3362     end.
     3363   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3364   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3365     (input  bf_goods.gds-code
     3366     ,input  '1':U
     3367     ,input  v-tax-date
     3368     ,input  bf_trn-doc.host-code
     3369     ,input  bf_trn-doc.obj-type
     3370     ,input  bf_trn-doc.obj-code
     3371     ,output v-vat-pc
     3372     ) no-error .
     3373     if error-status :error
     3374     or v-vat-pc = ? then do:
     3375        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3376     end.
     3377     if bf_goods.gds-type = 'у':U or
     3378        bf_trn-doc.status_ = 'запрос':U then do:
     3379       for each bf_tt-allsum-line
     3380       on error undo, return error return-value
     3381        :
     3382         delete bf_tt-allsum-line.
     3383       end.
     3384       create bf_tt-allsum-line.
     3385       assign
     3386        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     3387       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     3388                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     3389                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     3390                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     3391         assign
     3392           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     3393           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     3394           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     3395           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     3396           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     3397           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3398           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3399           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     3400           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     3401           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     3402           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3403           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3404           bf_tt-allsum-line.vat-cli-acc          =  ?
     3405           .
     3406       end.
     3407       assign
     3408         bf_tt-allsum-line.cli-qnty             =  ?
     3409         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3410         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3411         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3412         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3413         bf_tt-allsum-line.road-tax-base-doc    =  0
     3414         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     3415         bf_tt-allsum-line.excise-base-doc      =  0
     3416         bf_tt-allsum-line.excise-rubl-doc      =  0
     3417         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     3418         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     3419         bf_tt-allsum-line.dsc-base-cur         =  0
     3420         bf_tt-allsum-line.dsc-rubl-cur         =  0
     3421         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3422         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3423         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3424         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3425         bf_tt-allsum-line.road-tax-base-cur    =  0
     3426         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     3427         bf_tt-allsum-line.excise-base-cur      =  0
     3428         bf_tt-allsum-line.excise-rubl-cur      =  0
     3429         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     3430         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     3431         bf_tt-allsum-line.dsc-base-acc         =  0
     3432         bf_tt-allsum-line.dsc-rubl-acc         =  0
     3433         bf_tt-allsum-line.dsc-cli-acc          =  0
     3434         bf_tt-allsum-line.slt-base-acc         =  0
     3435         bf_tt-allsum-line.slt-rubl-acc         =  0
     3436         bf_tt-allsum-line.slt-cli-acc          =  0
     3437         bf_tt-allsum-line.road-tax-base-acc    =  0
     3438         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     3439         bf_tt-allsum-line.road-tax-cli-acc     =  0
     3440         bf_tt-allsum-line.excise-base-acc      =  0
