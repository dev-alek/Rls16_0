     4247     .
     4248   define variable p-usl-opl        as character no-undo .
     4249   define variable p-contract       as integer no-undo .
     4250   define variable p-cli            as integer no-undo .
     4251   define variable p-goods          as integer no-undo .
     4252   define variable Temp1         as integer init 10 no-undo .
     4253   define variable col-fo        as integer init 0 no-undo .
     4254   define variable col-bfo       as integer init 0 no-undo .
     4255   define variable col-trn       as integer init 0 no-undo .
     4256   define variable col-contract  as integer init 0 no-undo .
     4257   define variable v-k                 as integer no-undo init 0 .
     4258   define variable v-type-trn-doc      as character no-undo .
     4259   define variable v-sign-list         as character no-undo .
     4260   define variable v-sign              as integer no-undo .
     4261   define variable v-shot-type-trn-doc as character no-undo .
     4262   define buffer buf_trn-doc          for ub.trn-doc.
     4263   define buffer buf_ord-doc          for ub.ord-doc.
     4264   define buffer buf_ord-line         for ub.ord-line.
     4265   define buffer buf_contract         for ub.contract.
     4266   define buffer buf_goods            for ub.goods.
     4267   define buffer buf_fin-ob-trn       for ub.fin-ob-trn.
     4268   define buffer buf_fin-gds-part     for ub.fin-gds-part.
     4269   define buffer buf2_ord-doc         for ub.ord-doc.
     4270   define variable var-sum-rubl        as decimal   no-undo .
     4271   define variable var-sum-rublb       as decimal   no-undo .
     4272   define variable var-sum-base        as decimal   no-undo .
     4273   define variable var-sum-baseb       as decimal   no-undo .
     4274   define variable var-sum-contract    as decimal   no-undo .
     4275   define variable var-sum-contractb   as decimal   no-undo .
     4276   define variable var-income-in-code  as character no-undo .
     4277   define variable  varis-doc           as   logical                 no-undo.
     4278   define variable  varis-cur           as   logical                 no-undo.
     4279   define variable  varroad-tax         like ub.doc-line.road-tax    no-undo.
     4280   define variable  varexcise           like ub.doc-line.excise      no-undo.
     4281   define variable  varvat-pc           like ub.doc-line.vat-pc      no-undo.
     4282   define variable  varcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     4283   define variable  varslt-pc           like ub.doc-line.slt-pc      no-undo.
     4284   define variable  varbase-rate        like ub.trn-doc.base-rate    no-undo.
     4285   define variable  varbase-scale       like ub.trn-doc.base-scale   no-undo.
     4286   define variable  varr-b              as   character               no-undo.
     4287   define variable  varcur-base         like ub.gds-dtl.cur-base     no-undo.
     4288   define variable  varcurroad-tax      like ub.doc-line.road-tax    no-undo.
     4289   define variable  varcurexcise        like ub.doc-line.excise      no-undo.
     4290   define variable  varcurvat-pc        like ub.doc-line.vat-pc      no-undo.
     4291   define variable  varcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     4292   define variable  varcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     4293   define variable  v-ok                as logical   no-undo .
     4294   define variable v-spis-contract-type as character no-undo .
     4295   assign
     4296     varis-doc            = false
     4297     varis-cur            = false
     4298     varroad-tax          = 0
     4299     varexcise            = 0
     4300     varvat-pc            = 0
     4301     varcons-vat-pc       = 0
     4302     varslt-pc            = 0
     4303     varbase-rate         = 0
     4304     varbase-scale        = 0
     4305     varr-b               = ""
     4306     varcur-base          = 0
     4307     varcurroad-tax       = 0
     4308     varcurexcise         = 0
     4309     varcurvat-pc         = 0
     4310     varcurcons-vat-pc    = 0
     4311     varcurslt-pc         = 0
     4312   .
     4313   p-res = p-res +  chr(10).
     4314   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4315     run mainmenu_getcntxt in parparentproc
     4316       (output v-cntxt-db-num
     4317       ,output v-cntxt-userid
     4318       ,output v-cntxt-level
     4319       ,output v-cntxt-host-code-obj
     4320       ,output v-cntxt-obj-type
     4321       ,output v-cntxt-obj-code
     4322       ,output v-cntxt-db-num-obj
     4323       ,output v-cntxt-is-admin
     4324       ) .
     4325   define variable g-log as logical no-undo .
     4326   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4327   do:
     4328     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4329       (input  v-cntxt-db-num
     4330       ,input  v-cntxt-userid
     4331       ,input  0
     4332       ,input  'actn_fin-liability_add-def':U
     4333       ,input  'firm':U
     4334       ,input  par-host-code
     4335       ,input  '':U
     4336       ,input  0
     4337       ,input  0
     4338       ,input  0
     4339       ,input  0
     4340       ,input  true
     4341       ,output g-log
     4342       )  .
     4343   end.
     4344   if not g-log then  return .
     4345   run waitfram-show("Ждите...").
     4346   define variable var-fin-calc as integer no-undo .
     4347   find first sysconf no-lock where sysconf.host-code = par-host-code no-error .
     4348   var-fin-calc = sysconf.fin-calc   .
     4349   run make-temp-obj-firm.
     4350   assign
     4351       v-type-trn-doc = "order"
     4352       v-shot-type-trn-doc = 'заказ':U
     4353       v-sign-list    = "1"
     4354   .
     4355   if p-trn-doc <> ?  then do:
     4356       for each temp-obj-firm on error undo, return error :
     4357              for each buf_ord-doc no-lock where
     4358                      (buf_ord-doc.obj-type   = temp-obj-firm.obj-type and
     4359                       buf_ord-doc.obj-code   = temp-obj-firm.obj-code and
     4360                       buf_ord-doc.host-code  = par-host-code and
     4361                       buf_ord-doc.need-fo = 1            and
     4362                       buf_ord-doc.cr-fo   = false        and
     4363                       buf_ord-doc.cr-fo2  = false        and
     4364                       buf_ord-doc.doc-date <= p-date-end and
     4365                       buf_ord-doc.contract-code <> 0
     4366                       )
     4367                       or
     4368                      (buf_ord-doc.obj-type   = temp-obj-firm.obj-type and
     4369                       buf_ord-doc.obj-code   = temp-obj-firm.obj-code and
     4370                       buf_ord-doc.host-code  = par-host-code          and
     4371                       buf_ord-doc.status_ = 'факт':U  and
     4372                       buf_ord-doc.need-fo2 = 1       and
     4373                       buf_ord-doc.cr-fo   = true     and
     4374                       buf_ord-doc.cr-fo2  = false    and
     4375                       buf_ord-doc.contract-code <> 0 and
     4376                       buf_ord-doc.doc-date <= p-date-end
     4377                       )
     4378                       on error undo, return error :
     4379                   run proc-body .
     4380              end.
     4381       end.
     4382    end.
     4383    else do:
     4384       for each tt-trn-doc  no-lock
     4385           on error undo, return error
     4386           :
     4387           find first buf_ord-doc no-lock where buf_ord-doc.doc-code = tt-trn-doc.doc-code no-error .
     4388           if available buf_ord-doc  and
     4389             (( buf_ord-doc.need-fo2 = 1 and
     4390                buf_ord-doc.status_ = 'факт':U and
     4391                buf_ord-doc.cr-fo2  = false and
     4392                buf_ord-doc.cr-fo   = true )
     4393                or
     4394             ( buf_ord-doc.need-fo = 1 and
     4395               buf_ord-doc.cr-fo2  = false and
     4396               buf_ord-doc.cr-fo   = false
     4397               )) then do:
     4398              run proc-body .
     4399           end.
     4400       end.
     4401    end.
     4402     if p-cons = 1  then do:
     4403        assign
     4404           var-sum-rubl     =  0
     4405           var-sum-base     =  0
     4406           var-sum-contract =  0
     4407           col-contract     =  0
     4408           .
     4409        if var-fin-calc = 1  then do:
     4410           for each temp-obj-firm
     4411               on error undo, return error :
     4412                     assign
     4413                       var-sum-rubl     =  0
     4414                       var-sum-base     =  0
     4415                       var-sum-contract =  0
     4416                       col-contract     =  0
     4417                     .
     4418                     for each tt-fin-ob where
     4419                               tt-fin-ob.obj-code =  temp-obj-firm.obj-code and
     4420                               tt-fin-ob.obj-type =  temp-obj-firm.obj-type
     4421                               ,
     4422                         first buf_contract no-lock where buf_contract.contract-code = tt-fin-ob.contract-code and
     4423                                                          buf_contract.host-code     = par-host-code           and
     4424                                                          lookup( buf_contract.usl-opl ,  'По заказу':U + "," + 'Отсрочка платежа по заказу':U + "," + 'Предоплата,Предоплата(%)' )   > 0
     4425                               break
     4426                               by tt-fin-ob.contract-code
     4427                               by tt-fin-ob.pc
     4428                               on error undo, return error :
     4429                               var-sum-rubl     = var-sum-rubl     + tt-fin-ob.sum-rubl.
     4430                               var-sum-base     = var-sum-base     + tt-fin-ob.sum-base.
     4431                               var-sum-contract = var-sum-contract + tt-fin-ob.sum-contract .
     4432                               if last-of(tt-fin-ob.contract-code)  or (p-nalog = 2 and last-of(tt-fin-ob.pc)) then do:
     4433                                   col-contract = col-contract + 1 .
     4434                                   if ( col-contract  modulo temp1 = 0 ) and ( col-contract >= temp1 ) then run waitfram-show( "Объединение по договорам : " + string( col-contract )) .
     4435                                   run make-s-fo-obj (
     4436                                         input var-sum-rubl ,
     4437                                         input var-sum-base ,
     4438                                         input var-sum-contract,
     4439                                         input temp-obj-firm.obj-type ,
     4440                                         input temp-obj-firm.obj-code ,
     4441                                         input tt-fin-ob.pc )
     4442                                         no-error .
     4443                                       if error-status :error then do:
     4444                                         col-fo = col-fo - 1.
     4445                                         p-res = p-res + chr(10) + error-status :get-message(1) .
     4446                                       end.
     4447                                   var-sum-rubl =  0 .
     4448                                   var-sum-base =  0 .
     4449                                   var-sum-contract =  0 .
     4450                               end.
     4451                       end.
     4452           end.
     4453        end.
     4454        else do:
     4455             for each tt-fin-ob  ,
     4456                 first buf_contract no-lock where buf_contract.contract-code = tt-fin-ob.contract-code and
     4457                                                   buf_contract.host-code    = par-host-code           and
     4458                                                   lookup( buf_contract.usl-opl ,  'По заказу':U + "," + 'Отсрочка платежа по заказу':U  + "," + 'Предоплата,Предоплата(%)'  )   > 0
     4459                       break
     4460                          by tt-fin-ob.contract-code
     4461                          by tt-fin-ob.pc
     4462                       on error undo, return error :
     4463                       var-sum-rubl = var-sum-rubl + tt-fin-ob.sum-rubl.
     4464                       var-sum-base = var-sum-base + tt-fin-ob.sum-base.
     4465                       var-sum-contract = var-sum-contract + tt-fin-ob.sum-contract.
     4466                       if last-of(tt-fin-ob.contract-code) or (p-nalog = 2 and last-of(tt-fin-ob.pc)) then do:
     4467                           col-contract = col-contract + 1 .
     4468                           if ( col-contract  modulo temp1 = 0 ) and ( col-contract >= temp1 ) then run waitfram-show( "Объединение по договорам : " + string( col-contract )) .
     4469                           run make-s-fo ( input var-sum-rubl , input var-sum-base , input var-sum-contract , input tt-fin-ob.pc ) no-error .
     4470                               if error-status :error then do:
     4471                                 col-fo = col-fo - 1.
     4472                                 p-res = p-res + chr(10) + error-status :get-message(1) .
     4473                               end.
     4474                           var-sum-rubl     =  0 .
     4475                           var-sum-base     =  0 .
     4476                           var-sum-contract =  0 .
     4477                       end.
     4478               end.
     4479        end.
     4480     end.
     4481   run waitfram-hide.
     4482   if col-fo    < 0 then col-fo    = 0 .
     4483   p-res = p-res  + chr(10)   +
     4484          "Генерация завершена: " + cur-time-string()  + chr(10) +
     4485          "за период до " + string( p-date-end,"99/99/9999")  + chr(10) +
     4486          " Создано финансовых обязательств :" + string(col-fo) + chr(10) +
     4487          "Просмотрено заказов              :" + string(col-trn)           + chr(10) +
     4488          "Просмотрено договоров            :" + string(col-contract)
     4489          .
     4490   return .
     4491   procedure proc-body :
     4492    do
     4493    on error undo, return error return-value
     4494    :
     4495   define buffer buf1_ord-doc for ub.ord-doc  .
     4496   define variable sum-gds-code  as decimal no-undo .
     4497   define variable v-cl-sum-rubl as decimal no-undo .
     4498   define variable v-cl-sum-base as decimal no-undo .
     4499   define variable v-cl-sum-cli  as decimal no-undo .
     4500   define variable v-cl-vat-rubl as decimal no-undo .
     4501   define variable v-cl-vat-base as decimal no-undo .
     4502   define variable v-cl-vat-cli  as decimal no-undo .
     4503   define variable v-rest-sum-rubl as decimal   no-undo .
     4504   define variable v-rest-sum-base as decimal   no-undo .
     4505   define variable v-rest-vat-rubl like ub.ord-line.sum-vat no-undo .
     4506   define variable v-rest-vat-base like ub.ord-line.sum-vat no-undo .
     4507   define variable v-flag-po as logical no-undo .
     4508   define variable v-may-be  as logical   no-undo .
     4509   if (valid-handle(g#libofarh) <> true) then do:   run str/libofarh.p persistent no-error .   if error-status :error or (valid-handle(g#libofarh) <> true) then do:     message       "Error starting libofarh.p" skip       g#libofarh skip       g#libofarh :type skip       g#libofarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libofarh_doc-fogn in g#libofarh (
     4510    input 'ord'
     4511   ,input p-fo-type
     4512   ,input buf_ord-doc.doc-code
     4513   ,input g#db-num
     4514   ,output v-may-be
     4515   )
     4516   .
     4517   if v-may-be = false then do:
     4518      p-res = p-res + chr(10) + substitute("По заказу &1 нельзя создавать ФО в этой БД" , buf_ord-doc.doc-code ) .
     4519      return .
     4520   end.
     4521   assign
     4522     v-flag-po = ( if buf_ord-doc.cr-fo = true then true else false )
     4523   .
     4524   if p-adm then v-flag-po =  false .
     4525    col-trn = col-trn + 1 .
     4526   assign
     4527       var-sum-rubl = 0
     4528       var-sum-base = 0
     4529       var-sum-contract = 0
     4530       .
     4531   if ( col-trn  modulo temp1 = 0 ) and ( col-trn >= temp1 ) then run waitfram-show( "Обработано заказов : " + string( col-trn )) .
     4532         for each buf_ord-line no-lock where buf_ord-line.doc-code  = buf_ord-doc.doc-code  ,
     4533                 first buf1_ord-doc no-lock where buf1_ord-doc.doc-code  = buf_ord-line.doc-code ,
     4534                 first buf_goods no-lock where buf_goods.artic     = buf_ord-line.artic      and
     4535                                               buf_goods.prod-type = buf_ord-line.prod-type  and
     4536                                               buf_goods.prod-code = buf_ord-line.prod-code ,
     4537                 first buf_contract no-lock where buf_contract.contract-code = buf_ord-doc.contract-code and
     4538                                                  buf_contract.host-code     = buf_ord-doc.host-code     and
     4539                                                  lookup( buf_contract.usl-opl ,  'По заказу':U
     4540                                                                          + "," + 'Отсрочка платежа по заказу':U
     4541                                                                          + "," + 'Предоплата,Предоплата(%)') > 0
     4542                 break
     4543                       by buf1_ord-doc.contract-code
     4544                       by buf_ord-line.vat-pc
     4545                       on error undo, return error
     4546                       :
     4547                     case buf_contract.usl-opl :
     4548                     when 'Предоплата(%)':U then do:
     4549                           if buf1_ord-doc.status_ = 'факт':U then do:
     4550                              run calc-rest-sum in this-procedure ( buffer buf_ord-line ,
     4551                                                                    input buf_contract.srok-opl,
     4552                                                                    output v-cl-sum-rubl ,
     4553                                                                    output v-cl-sum-base,
     4554                                                                    output v-cl-vat-rubl ,
     4555                                                                    output v-cl-vat-base
     4556                                                                    ).
     4557                               assign
     4558                                 var-sum-rubl     = var-sum-rubl + v-cl-sum-rubl
     4559                                 var-sum-contract = var-sum-contract  + v-cl-sum-cli
     4560                                 var-sum-base     = var-sum-base + v-cl-sum-base
     4561                               .
     4562                           end.
     4563                           else do:
     4564                               assign
     4565                                 var-sum-rubl     = var-sum-rubl + buf_contract.srok-opl *  abs (buf_ord-line.sum-rubl) / 100
     4566                                 var-sum-contract = var-sum-contract  + buf_contract.srok-opl *  abs (buf_ord-line.sum-cli) / 100
     4567                                 var-sum-base     = var-sum-base + buf_contract.srok-opl *  abs (buf_ord-line.sum-base) / 100
     4568                               .
     4569                           end.
     4570                     end.
     4571                     when 'Предоплата':U then do:
     4572                       assign
     4573                         var-sum-rubl     = var-sum-rubl + abs (buf_ord-line.sum-rubl)
     4574                         var-sum-contract = var-sum-contract  + abs (buf_ord-line.sum-cli)
     4575                         var-sum-base     = var-sum-base + abs (buf_ord-line.sum-base)
     4576                       .
     4577                     end.
     4578                     otherwise do:
     4579                       assign
     4580                         var-sum-rubl     = var-sum-rubl + abs (buf_ord-line.sum-rubl - ( buf_ord-line.sum-other-rubl + buf_ord-line.sum-transport-rubl))
     4581                         var-sum-contract = var-sum-rubl *  (  buf_ord-doc.exch-scale   / buf_ord-doc.exch-rate )
     4582                         var-sum-base     = var-sum-base + abs (buf_ord-line.sum-base - ( buf_ord-line.sum-other-base + buf_ord-line.sum-transport-base))
     4583                       .
     4584                     end.
     4585                     end case.
     4586                     v-rest-sum-rubl = buf_ord-line.sum-rubl.
     4587                     v-rest-sum-base = buf_ord-line.sum-base.
     4588                     v-rest-vat-rubl = buf_ord-line.sum-vat  *  ( buf1_ord-doc.exch-rate  / buf1_ord-doc.exch-scale ).
     4589                     v-rest-vat-base = v-rest-vat-rubl       *  ( buf1_ord-doc.base-scale / buf1_ord-doc.base-rate ).
     4590                     if buf_contract.usl-opl = 'Предоплата(%)':U then do:
     4591                       if buf1_ord-doc.status_ = 'факт':U then do:
     4592                          run calc-rest-sum in this-procedure (
     4593                              buffer buf_ord-line ,
     4594                              input buf_contract.srok-opl,
     4595                              output v-rest-sum-rubl ,
     4596                              output v-rest-sum-base ,
     4597                              output v-rest-vat-rubl ,
     4598                              output v-rest-vat-base
     4599                              ).
     4600                       end.
     4601                       if buf1_ord-doc.status_ = 'поставка':U then do:
     4602                           v-rest-sum-rubl = buf_contract.srok-opl * buf_ord-line.sum-rubl / 100 .
     4603                           v-rest-sum-base = buf_contract.srok-opl * buf_ord-line.sum-base / 100 .
     4604                           v-rest-vat-rubl = buf_contract.srok-opl * buf_ord-line.sum-vat  *  ( buf1_ord-doc.exch-rate  / buf1_ord-doc.exch-scale ) / 100 .
     4605                           v-rest-vat-base = v-rest-vat-rubl * ( buf1_ord-doc.base-scale / buf1_ord-doc.base-rate ) .
     4606                       end.
     4607                     end.
     4608                     create temp-ord-line.
     4609                     BUFFER-COPY buf_ord-line to temp-ord-line
     4610                     assign
     4611                       temp-ord-line.sum-vat-rubl   = v-rest-vat-rubl
     4612                       temp-ord-line.sum-vat-base   = v-rest-vat-base
     4613                       temp-ord-line.sum-rubl       = v-rest-sum-rubl
     4614                       temp-ord-line.sum-base       = v-rest-sum-base
     4615                       temp-ord-line.sum-cli        = v-rest-sum-rubl *  (  buf1_ord-doc.exch-scale   / buf1_ord-doc.exch-rate )
     4616                       temp-ord-line.fact-date      = buf1_ord-doc.fact-date
     4617                       temp-ord-line.contract-code  = buf1_ord-doc.contract-code
     4618                       temp-ord-line.out-code       = buf_ord-line.doc-code
     4619                       temp-ord-line.cli-qnty       = buf_ord-line.cli-qnty
     4620                       temp-ord-line.fact-qnty      = buf_ord-line.fact-qnty
     4621                       temp-ord-line.qnty           = buf_ord-line.qnty
     4622                       temp-ord-line.gds-code       = buf_goods.gds-code
     4623                     .
     4624               if last-of(buf1_ord-doc.contract-code) or (p-nalog = 2 and last-of(buf_ord-line.vat-pc)) then do:
     4625                   if p-cons = 1 then do:
     4626                         run make-tt-fo ( input var-sum-rubl ,
     4627                                          input var-sum-base ,
     4628                                          input var-sum-contract ,
     4629                                          input buf_ord-line.vat-pc
     4630                                          ) no-error .
     4631                         if error-status :error then do:
     4632                             p-res = p-res + chr(10) + error-status :get-message(1) .
     4633                         end.
     4634                   end.
     4635                   else do:
     4636                       run make-fo ( input var-sum-rubl ,
     4637                                     input var-sum-base ,
     4638                                     input var-sum-contract
     4639                                     ) no-error .
     4640                       if error-status :error then  do:
     4641                           col-fo = col-fo - 1.
     4642                           p-res  = p-res + chr(10) + error-status :get-message(1) .
     4643                       end.
     4644                   end.
     4645                   var-sum-rubl = 0 .
     4646                   var-sum-base = 0 .
     4647                   var-sum-contract = 0 .
     4648               end.
     4649         end.
     4650    end.
     4651   end procedure.
     4652   procedure make-fo :
     4653    do
     4654    on error undo, return error return-value
     4655    :
     4656   define input parameter v-sum-rubl     as decimal no-undo .
