     1120   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1121   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     1122   define variable v-ps as character no-undo .
     1123   if available buf_sale-doc then
     1124   assign
     1125   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     1126                       , chr(4)
     1127                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
     1128                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     1129                       , buf_sale-doc.chk-amount
     1130                       , buf_sale-doc.gds-amount
     1131                       , buf_sale-doc.tot-lines
     1132                       , buf_sale-doc.tot-dtl
     1133                       ).
     1134   else  do:
     1135   assign
     1136   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     1137                       , chr(4)
     1138                       , '':U
     1139                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     1140                       , 0
     1141                       , 0
     1142                       , 0
     1143                       , 0
     1144                       ).
     1145   end.
     1146   return v-ps.
     1147   END FUNCTION.
     1148   FUNCTION get-sale-doc-kind returns character (
     1149                                                input p-doc-kind as character
     1150                                              , input p-ext-doc-type as character
     1151                                              , output p-order as integer
     1152                                              , output p-msign as integer
     1153                                              , output p-main as logical
     1154                                              , output p-in-inkas as logical
     1155                                              , output p-dir_ as integer
     1156                                              ):
     1157   define variable v-doc-kind as character no-undo.
     1158   define variable v-type as character no-undo .
     1159   define variable v-value as character no-undo .
     1160   CASE p-doc-kind:
     1161     when 'es':U then do:
     1162       assign
     1163       p-order = 100
     1164       p-msign = 1
     1165       p-main = yes
     1166       p-in-inkas = yes
     1167       p-dir_ = 1
     1168       .
     1169       return p-ext-doc-type.
     1170     end.
     1171     when  'rs':U then do:
     1172       assign
     1173       p-order = 200
     1174       p-msign = - 1
     1175       p-main = no
     1176       p-in-inkas = yes
     1177       p-dir_ = - 1
     1178       .
     1179       return p-ext-doc-type.
     1180     end.
     1181     when 'rwo':U then do:
     1182       assign
     1183       p-msign = - 1
     1184       p-main = no
     1185       p-in-inkas = no
     1186       p-order = 300
     1187       p-dir_ = 1
     1188       .
     1189       return 'rwo':U.
     1190     end.
     1191     when 'trf':U then do:
     1192       assign
     1193       p-msign = 1
     1194       p-main = no
     1195       p-in-inkas = no
     1196       p-order = 400
     1197       p-dir_ = 1
     1198       .
     1199       return 'trf':U.
     1200     end.
     1201     when 'swo':U then do:
     1202      assign
     1203      p-msign = 1
     1204      p-main = no
     1205      p-in-inkas = no
     1206      p-order =  500
     1207      p-dir_ = 1
     1208      .
     1209      return 'swo':U.
     1210    end.
     1211    when 'vir':U then do:
     1212      assign
     1213      p-msign = 1
     1214      p-main = no
     1215      p-in-inkas = no
     1216      p-order = 600
     1217      p-dir_ = 1
     1218      .
     1219      return 'vir':U.
     1220    end.
     1221    when 'itr':U then do:
     1222      assign
     1223      p-msign = 1
     1224      p-main = no
     1225      p-in-inkas = no
     1226      p-order = -1
     1227      p-dir_ = -1
     1228      .
     1229     return 'itr':U.
     1230    end.
     1231    when 'ngs':U then do:
     1232      assign
     1233      p-msign = 1
     1234      p-main = no
     1235      p-in-inkas = no
     1236      p-order = 700
     1237      p-dir_ = 1
     1238      .
     1239      return 'ngs':U.
     1240    end.
     1241    when 'rgs':U then do:
     1242      assign
     1243      p-msign = -1
     1244      p-main = no
     1245      p-in-inkas = no
     1246      p-order = 701
     1247      p-dir_ = -1
     1248      .
     1249      return 'rgs':U.
     1250    end.
     1251    otherwise do:
     1252       assign
     1253       p-msign = 1
     1254       p-main = no
     1255       p-in-inkas = no
     1256       p-order = -1.
     1257       return p-ext-doc-type.
     1258     end.
     1259   END CASE.
     1260   END FUNCTION.
     1261   procedure saledoc-create :
     1262   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     1263   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1264   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1265   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1266   define input parameter p-doc-kind as character no-undo .
     1267   define input parameter p-office as character no-undo .
     1268   define input parameter p-tpsidoc as logical no-undo .
     1269   define input parameter p-alias-type-price as character no-undo .
     1270   define input parameter p-price-obj-type as character no-undo .
     1271   define input parameter p-price-obj-code as integer no-undo .
     1272   define parameter buffer buf_trn-doc for ub.trn-doc.
     1273   define variable v-order as integer no-undo.
     1274   define variable v-main as logical no-undo .
     1275   define variable v-in-inkas as logical no-undo .
     1276   define variable v-msign as integer no-undo .
     1277   define variable v-dir_ as integer no-undo .
     1278   define variable v-trn-doc-code as character no-undo .
     1279   define buffer buf_sale-doc for ub.sale-doc.
     1280   main-block:
     1281   do
     1282   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1283   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1284   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1285   :
     1286      if available buf_trn-doc then do:
     1287        v-trn-doc-code = buf_trn-doc.doc-code.
     1288      end.
     1289      find first buf_sale-doc where
     1290               buf_sale-doc.inkas-code = p-inkas-code
     1291           and buf_sale-doc.doc-kind = p-doc-kind
     1292           and buf_sale-doc.chr-office = p-office
     1293           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
     1294           no-error .
     1295      if not available buf_sale-doc  then do:
     1296         create buf_sale-doc.
     1297         assign
     1298         buf_sale-doc.inkas-code = p-inkas-code
     1299         buf_sale-doc.storage =  'trn-doc':U
     1300         buf_sale-doc.host-code = p-host-code
     1301         buf_sale-doc.obj-type = p-obj-type
     1302         buf_sale-doc.obj-code = p-obj-code
     1303         buf_sale-doc.doc-kind  = p-doc-kind
     1304         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
     1305         buf_sale-doc.chr-office = p-office
     1306         buf_sale-doc.doc-code = v-trn-doc-code
     1307         .
     1308      end.
     1309      if available buf_trn-doc then
     1310      buffer-copy buf_trn-doc
     1311      to buf_sale-doc
     1312      .
     1313     assign
     1314     buf_sale-doc.doc-kind = get-sale-doc-kind (
     1315                                                input p-doc-kind
     1316                                               ,input buf_sale-doc.ext-doc-type
     1317                                               ,output v-order
     1318                                               ,output v-msign
     1319                                               ,output v-main
     1320                                               ,output v-in-inkas
     1321                                               ,output v-dir_).
     1322     assign
     1323     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
     1324     buf_sale-doc.main-doc = v-main
     1325     buf_sale-doc.in-inkas = v-in-inkas
     1326     buf_sale-doc.msign = v-msign
     1327     buf_sale-doc.dir = v-dir_
     1328     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
     1329     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
     1330     buf_sale-doc.poss-wro-codes = '':U
     1331     buf_sale-doc.chr-office = p-office
     1332     buf_sale-doc.tpsidoc = p-tpsidoc
     1333     buf_sale-doc.alias-type-price = p-alias-type-price
     1334     buf_sale-doc.price-obj-type = (if p-tpsidoc
     1335                                    then p-price-obj-type
     1336                                    else '':U)
     1337     buf_sale-doc.price-obj-code = (if p-tpsidoc
     1338                                    then p-price-obj-code
     1339                                    else 0)
     1340     .
     1341     assign
     1342     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
     1343     no-error.
     1344   end.
     1345   END.
     1346   procedure fbr-saledoc-create :
     1347   define input parameter p-inkas-code as character no-undo .
     1348   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
     1349   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
     1350   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
     1351   define buffer buf_fbr-doc for ub.fbr-doc.
     1352   define buffer buf_trn-doc for ub.trn-doc.
     1353   define buffer buf_sale-doc for ub.sale-doc.
     1354   define buffer buf2_sale-doc for ub.sale-doc.
     1355   define buffer buf2_trn-doc for ub.trn-doc.
     1356   define buffer buf_doc-line for ub.doc-line.
     1357   define buffer buf_gds-dtl for ub.gds-dtl.
     1358   define buffer buf_chk-gds for ub.chk-gds.
     1359   define buffer buf_chk-doc for ub.chk-doc.
     1360   do
     1361   on error undo, return error
     1362   :
     1363     for each buf_fbr-doc no-lock where
     1364           buf_fbr-doc.out-code = p-inkas-code:
     1365       for each buf_trn-doc no-lock where
     1366             buf_trn-doc.out-code = buf_fbr-doc.doc-code
     1367       by buf_trn-doc.fact-order
     1368       on error undo, return error:
     1369         if buf_trn-doc.ext-doc-type = 'em':U
     1370         or buf_trn-doc.ext-doc-type = 'im':U
     1371         or buf_trn-doc.ext-doc-type = 'wm':U
     1372         or buf_trn-doc.ext-doc-type = 'ev':U
     1373         or buf_trn-doc.ext-doc-type = 'iv':U
     1374         then do:
     1375           find first buf_sale-doc where
     1376                   buf_sale-doc.inkas-code = p-inkas-code
     1377               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
     1378               AND buf_sale-doc.storage  = 'trn-doc':U
     1379                   no-error .
     1380           if not available buf_sale-doc then do:
