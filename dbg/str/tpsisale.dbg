      613   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      614   procedure cur-time :
      615      define output parameter p-today as date      no-undo .
      616      define output parameter p-time  as integer   no-undo .
      617     do
      618     on error undo, return error
      619     :
      620       define variable v-date1 as date      no-undo .
      621       define variable v-date2 as date      no-undo .
      622       define variable v-time  as integer   no-undo .
      623       assign
      624         v-date1 = today
      625         v-time  = time
      626         v-date2 = today
      627       .
      628       if v-date1 <> v-date2
      629       then do:
      630         assign
      631           v-date1 = today
      632           v-time  = v-time
      633         .
      634       end.
      635       assign
      636         p-today = v-date1
      637         p-time  = v-time
      638       .
      639     end.
      640   end.
      641   function cur-time-date returns character
      642   :
      643     return string(today, '99/99/9999':U) .
      644   end.
      645   function cur-time-mjd returns decimal
      646   :
      647     define variable v-date as date      no-undo .
      648     define variable v-time as integer   no-undo .
      649     run cur-time in this-procedure
      650       (output v-date
      651       ,output v-time
      652       ) .
      653     return integer(v-date) - 2400002 + (v-time / 86400) .
      654   end.
      655   function cur-time-get-ending-index returns integer
      656   (input p-number as integer
      657   )
      658   :
      659     if p-number < 0
      660     or p-number = ?
      661     then do:
      662       return 1 .
      663     end.
      664     define variable v-rest as integer   no-undo .
      665     assign
      666       p-number = p-number modulo 100
      667     .
      668     if p-number < 20
      669     then do:
      670       assign
      671         v-rest = p-number
      672       .
      673     end.
      674     else do:
      675       assign
      676         v-rest = p-number modulo 10
      677       .
      678     end.
      679     case v-rest :
      680       when 1
      681       then do:
      682         return 2 .
      683       end.
      684       when 2 or
      685       when 3 or
      686       when 4
      687       then do:
      688         return 3 .
      689       end.
      690       otherwise do:
      691         return 1 .
      692       end.
      693     end case .
      694   end.
      695   procedure cur-time-mjd-to-date :
      696      define input  parameter i-mjd-diff as decimal no-undo.
      697      define output parameter o-Date     as date    no-undo.
      698      define output parameter o-Time     as integer no-undo.
      699      define variable v-day-number as integer   no-undo .
      700      if    i-mjd-diff < 0
      701         or i-mjd-diff = ?
      702      then do:
      703         return "?" .
      704      end.
      705      assign
      706         v-day-number = truncate(i-mjd-diff,0).
      707         o-Date = date(v-day-number + 2400002).
      708         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      709     .
      710   end.
      711   function cur-time-mjd-to-string returns character
      712   (input p-mjd-diff as decimal
      713   )
      714   :
      715     define variable v-day-number as integer   no-undo .
      716     define variable v-seconds    as integer   no-undo .
      717     define variable v-hour       as integer   no-undo .
      718     define variable v-min        as integer   no-undo .
      719     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      720     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      721     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      722     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      723     if p-mjd-diff < 0
      724     or p-mjd-diff = ?
      725     then do:
      726       return "?" .
      727     end.
      728     assign
      729       v-day-number = integer(truncate(p-mjd-diff,0))
      730       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      731     .
      732     if v-seconds > 86400
      733     then do:
      734       assign
      735         v-seconds = 86400 - 1
      736       .
      737     end.
      738     if v-seconds < 0
      739     then do:
      740       assign
      741         v-seconds = 0
      742       .
      743     end.
      744     assign
      745       v-hour = truncate(v-seconds / 3600, 0)
      746     .
      747     assign
      748       v-seconds = v-seconds modulo 3600
      749     .
      750     assign
      751       v-min = truncate(v-seconds / 60, 0)
      752     .
      753     assign
      754       v-seconds = v-seconds modulo 60
      755     .
      756     return
      757         (if v-day-number <> 0
      758           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      759           else ""
      760         )
      761       + (if v-day-number <> 0 or v-hour <> 0
      762           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      763           else ""
      764         )
      765       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      766           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      767           else ""
      768         )
      769       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      770       .
      771   end.
      772   function cur-time-string returns character
      773   :
      774     define variable v-date as date      no-undo .
      775     define variable v-time as integer   no-undo .
      776     run cur-time in this-procedure
      777       (output v-date
      778       ,output v-time
      779       ) .
      780     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      781   end.
      782   function cur-time-string-sec returns character
      783   :
      784     define variable v-date as date      no-undo .
      785     define variable v-time as integer   no-undo .
      786     run cur-time in this-procedure
      787       (output v-date
      788       ,output v-time
      789       ) .
      790     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      791   end.
      792   function cur-time-custom  returns character
      793   (input p-prefix as character
      794   ,input p-date-format as character
      795   ,input p-delimiter as character
      796   ,input p-time-format as character
      797   ,input p-suffix as character
      798   )
      799   :
      800     define variable v-date as date      no-undo .
      801     define variable v-time as integer   no-undo .
      802     run cur-time in this-procedure
      803       (output v-date
      804       ,output v-time
      805       ) .
      806     return
      807       p-prefix
      808       + string(v-date, p-date-format)
      809       + p-delimiter
      810       + string(v-time, p-time-format)
      811       + p-suffix
      812       .
      813   end.
      814   function cur-time-print  returns character
      815   :
      816     define variable v-date as date      no-undo .
      817     define variable v-time as integer   no-undo .
      818     run cur-time in this-procedure
      819       (output v-date
      820       ,output v-time
      821       ) .
      822     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      823   end.
      824   function cur-time-datetime returns datetime
      825   :
      826     define variable v-char as character no-undo .
      827     define variable v-datetime as datetime no-undo .
      828     v-char = cur-time-string().
      829     v-datetime = datetime(v-char).
      830     return  v-datetime.
      831   end.
      832   function cur-time-string-msec returns character
      833   :
      834     define variable v-date as datetime  no-undo .
      835     v-date = now.
      836     return string(v-date) .
      837   end.
