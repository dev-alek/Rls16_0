        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle    no-undo.
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle     as handle no-undo .
        5   define input parameter p-parameter      as character        no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: tpsisale.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/tpsisale.p $":U .
       11   define variable vss-description as character no-undo init "Закрытие цепочки документов по ТПСИ из продажи".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable p-inkas-code     like ub.inkas.inkas-code no-undo .
       67   define variable p-host-code      like ub.inkas.host-code no-undo .
       68   define variable p-obj-type       like ub.inkas.obj-type no-undo .
       69   define variable p-obj-code       like ub.inkas.obj-code no-undo .
       70   define variable log-file-name                as character      no-undo init "saleclos.txt".
       71   define variable v-view-log                   as logical        no-undo .
       72   define variable v-stop                       as logical        no-undo .
       73   define variable ii                           as integer no-undo .
       74   define variable jj                           as integer no-undo .
       75   define variable v-mes                        as character no-undo .
       76   define variable v-was-gds-moving             as logical no-undo .
       77   define variable varchip-code                as integer no-undo .
       78   define variable varchip-code2               as integer no-undo .
       79   define variable v-sys-today       like ub.trn-doc.fact-date no-undo .
       80   define variable v-today                     as date no-undo .
       81   define variable v-time                      as integer no-undo .
       82   define variable v-close-num                 as integer no-undo .
       83   define buffer buf_expense_trn-doc for ub.trn-doc.
       84   define buffer buf_income_trn-doc for ub.trn-doc.
       85   define buffer buf_doc-line for ub.doc-line.
       86   define buffer tpsi_sale-doc for ub.sale-doc.
       87   define buffer buf_sale-doc for ub.sale-doc.
       88   define new global shared variable g#language as character no-undo .
       89   if g#language <> '' and g#language <> 'rus':U then do:
       90     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       91   end.
       92   define new global shared variable g#library  as handle no-undo .
       93   define new global shared variable g#library2 as handle no-undo .
       94   define   shared variable g#auto as logical no-undo.
       95   define   shared variable g#news as logical no-undo.
       96   define   shared variable g#oxml as logical no-undo.
       97   define   shared variable g#esys as logical no-undo.
       98   define   shared variable g#news-source-db as integer no-undo.
       99   define   shared variable g#esys-source-esys as integer no-undo.
      100   define   shared variable g#db-num as integer   no-undo .
      101   define   shared variable g#userid as character no-undo .
      102   define   shared variable g#passwd as character no-undo .
      103   define new global shared variable g#lib-trn  as handle no-undo .
      104   define new global shared variable g#lib-trn2 as handle no-undo .
      105   define new global shared variable g#lib-trn3 as handle no-undo .
      106   define new global shared variable g#lib-trn4 as handle no-undo .
      107   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      108   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      109   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      110     field cst-code                like ub.trn-doc.cst-code
      111     field part-code               like ub.parts.part-code
      112     .
      113   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      114   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      115   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      116   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define new global shared variable g#trdcalib as handle no-undo.
      118   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   define shared temp-table tt0-info no-undo
      120   field doc-code   like ub.trn-doc.doc-code
      121   field artic      like ub.doc-line.artic
      122   field prod-type  like ub.doc-line.prod-type
      123   field prod-code  like ub.doc-line.prod-code
      124   field prt-code  like ub.gds-dtl.prt-code
      125   field obj-type   like ub.doc-line.obj-type
      126   field obj-code   like ub.doc-line.obj-code
      127   field error-message as character
      128   field a-to-res as decimal
      129   field was-res as decimal
      130   field to-res as decimal
      131   field is-res as decimal
      132   field o-was-res as decimal
      133   field o-to-res as decimal
      134   field o-is-res as decimal
      135   index pi is unique primary
      136   obj-type
      137   obj-code
      138   artic
      139   prod-type
      140   prod-code
      141   index iartic
      142   artic
      143   prod-type
      144   prod-code
      145   .
      146   define shared temp-table tt0-doc-line no-undo like lib-trn_ret-line.
      147   define shared temp-table tt0-gds-dtl  no-undo like ub.gds-dtl.
      148   define shared temp-table tt0-parts    no-undo like ub.parts.
      149   define shared temp-table temp-tpsi-clients  no-undo like ub.clients.
      150   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
      151   define variable v-ps as character no-undo .
      152   assign
      153   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
      154                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
      155                     , buf_sale-doc.out-code
      156                     , buf_sale-doc.obj-type
      157                     , buf_sale-doc.obj-code
      158                     , chr(4)
      159                     , buf_sale-doc.tot-lines
      160                     , buf_sale-doc.tot-dtl
      161                     ).
      162   return v-Ps.
      163   END FUNCTION.
      164   procedure create-tt0-doc-line-gds-dtl :
      165   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
      166   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
      167   define input parameter p-ext-doc-type        as character no-undo .
      168   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
      169   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
      170   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
      171   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
      172   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
      173   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
      174   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
      175   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
      176   define parameter buffer b-doc-line           for ub.doc-line.
      177   define parameter buffer b-gds-dtl            for ub.gds-dtl.
      178   define parameter buffer buf_sale-doc for ub.sale-doc.
      179   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
      180   define buffer other_doc-line for ub.doc-line.
      181   define buffer other_gds-dtl for ub.gds-dtl.
      182     do
      183     on error undo, return error return-value
      184     :
      185       find first tt0-doc-line where
      186                 tt0-doc-line.obj-type = p-proprietor-obj-type
      187             AND tt0-doc-line.obj-code = p-proprietor-obj-code
      188             AND tt0-doc-line.prod-type = p-prod-type
      189             AND tt0-doc-line.prod-code = p-prod-code
      190             AND tt0-doc-line.artic     = p-artic
      191             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
      192             AND tt0-doc-line.status_      = 'нередакт':U no-error .
      193       if not available tt0-doc-line then do:
      194         create tt0-doc-line.
      195         buffer-copy b-doc-line
      196         except
      197         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
      198         to tt0-doc-line
      199         assign
      200         tt0-doc-line.status_ = 'нередакт':U
      201         tt0-doc-line.ext-doc-type = p-ext-doc-type
      202         tt0-doc-line.obj-type = p-proprietor-obj-type
      203         tt0-doc-line.obj-code = p-proprietor-obj-code
      204         tt0-doc-line.doc-code = p-doc-code
      205         .
      206       end.
      207       if p-doc-code <> "":U then do:
      208         find first other_doc-line no-lock where
      209                 other_doc-line.doc-code = p-doc-code
      210             AND  other_doc-line.artic    = p-artic
      211             AND  other_doc-line.prod-type = p-prod-type
      212             AND  other_doc-line.prod-code = p-prod-code no-error .
      213         if available other_doc-line then do:
      214           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
      215           assign
      216           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
      217           .
      218         end.
      219         else do:
      220           assign
      221           tt0-doc-line.doc-code = '':U
      222           .
      223         end.
      224       end.
      225       find first tt0-gds-dtl where
      226               tt0-gds-dtl.obj-type = p-proprietor-obj-type
      227           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
      228           AND tt0-gds-dtl.prod-type = p-prod-type
      229           AND tt0-gds-dtl.prod-code = p-prod-code
      230           AND tt0-gds-dtl.artic     = p-artic
      231           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
      232       if not available tt0-gds-dtl then do:
      233         create tt0-gds-dtl.
      234         buffer-copy b-gds-dtl
      235         except
      236         obj-type obj-code doc-code doc-qnty fact-qnty
      237         to tt0-gds-dtl
      238         assign
      239         tt0-gds-dtl.obj-type = p-proprietor-obj-type
      240         tt0-gds-dtl.obj-code = p-proprietor-obj-code
      241         tt0-gds-dtl.doc-code = p-doc-code
      242         .
      243       end.
      244       if p-doc-code <> "":U then do:
      245           find first other_gds-dtl no-lock where
      246                   other_gds-dtl.doc-code = p-doc-code
      247               AND  other_gds-dtl.artic    = p-artic
      248               AND  other_gds-dtl.prod-type    = p-prod-type
      249               AND  other_gds-dtl.prod-code    = p-prod-code
      250               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
      251           if available other_gds-dtl then do:
      252             assign
      253             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
      254             .
      255           end.
      256           else do:
      257             assign
      258             tt0-gds-dtl.doc-code = '':U
      259             .
      260           end.
      261       end.
      262       assign
      263       old-qnty = tt0-gds-dtl.doc-qnty
      264       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
      265       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
      266       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
      267       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
      268       .
      269     end.
      270   end procedure.
      271   procedure fill-tt-tpsi-table :
      272   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
      273   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
      274   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
      275   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
      276   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
      277   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
      278   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
      279   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
      280   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
      281   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
      282   define buffer buf_goods for ub.goods.
      283   define buffer buf_doc-line for ub.doc-line.
      284   define buffer buf_gds-dtl for ub.gds-dtl.
      285   define buffer buf_sale-doc for ub.sale-doc.
      286     do
      287     on error undo, return error
      288     :
      289       _doc-line:
      290       for each buf_Doc-line no-lock where
      291             buf_doc-line.doc-code = p-doc-code,
      292         first buf_goods no-lock where
      293             buf_goods.artic = buf_doc-line.artic
      294        AND  buf_goods.prod-type  = buf_doc-line.prod-type
      295        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
      296           each buf_gds-dtl no-lock where
      297             buf_gds-dtl.doc-code = buf_doc-line.doc-code
      298         AND  buf_gds-dtl.artic    = buf_doc-line.artic
      299         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
      300         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
      301         assign
      302         v-ext-doc-type = "":U.
      303         run tpsi-preselect-gds-proprietor in this-procedure (
      304                                                     input buf_goods.gds-code
      305                                                   ,input g#db-num
      306                                                   ,output v-proprietor-host-code
      307                                                   ,output v-proprietor-obj-type
      308                                                   ,output v-proprietor-obj-code ) no-error .
      309         if v-proprietor-host-code = p-host-code then do:
      310           assign
      311           v-ext-doc-type = 'ev':U .
      312         end.
      313         else do:
      314           assign
      315           v-ext-doc-type =  'ee':U .
      316         end.
      317         if  (v-proprietor-obj-type = p-obj-type
      318         AND v-proprietor-obj-code = p-obj-code)
      319         OR (v-proprietor-obj-type = "":U
      320         AND v-proprietor-obj-code = 0)
      321         OR v-proprietor-obj-code = ?
      322         then next _doc-line.
      323         find first buf_sale-doc no-lock where
      324                   buf_sale-doc.inkas-code = p-doc-code
      325              AND buf_sale-doc.obj-type = v-proprietor-obj-type
      326              AND buf_sale-doc.obj-code = v-proprietor-obj-code
      327              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
      328              no-error .
      329         run create-tt0-doc-line-gds-dtl  in this-procedure (
      330                                                              input v-proprietor-obj-type
      331                                                             ,input v-proprietor-obj-code
      332                                                             ,input v-ext-doc-type
      333                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
      334                                                             ,input buf_doc-line.artic
      335                                                             ,input buf_Doc-line.prod-type
      336                                                             ,input buf_doc-line.prod-code
      337                                                             ,input buf_gds-dtl.prt-code
      338                                                             ,input 0
      339                                                             ,output v-was-gds-dtl-fact-qnty
      340                                                             ,output v-gds-dtl-fact-qnty
      341                                                             ,buffer buf_doc-line
      342                                                             ,buffer buf_gds-dtl
      343                                                             ,buffer buf_sale-doc
      344                                                           ).
      345       end.
      346     end.
      347   end procedure.
      348   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      349   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      350   procedure get-alias-type-price-obj :
      351   define input parameter p-host-code like ub.sysconf.host-code no-undo .
      352   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
      353   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
      354   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
      355   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
      356   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
      357   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
      358   define output parameter p-alias-type-price as character no-undo .
      359   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
      360   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
      361   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
      362   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
      363   define variable v-mediat-objf               as character no-undo .
      364   define variable v-param-type as character no-undo .
      365   define variable v-value-character as character no-undo .
      366   define variable v-value-date as date no-undo .
      367   define variable v-value-decimal as decimal no-undo .
      368   define variable v-value-integer as INTEGER no-undo .
      369   define variable v-value-logical AS LOGICAL no-undo .
      370   define variable v-tth as handle no-undo .
      371   assign
      372   v-tth = buffer thbjattr_thbj-attr:table-handle .
      373   define buffer buf_trn-doc for ub.trn-doc.
      374     _main:
      375     do
      376     on error undo, return error return-value
      377     :
      378       run adm/shattri.p (
      379         input "get":U
      380         ,input  p-prop-obj-type
      381         ,input  p-prop-obj-code
      382         ,input  'alias-tpsi':U
      383         ,input  '':U
      384         ,output v-value-character
      385         ,output v-value-date
      386         ,output v-value-decimal
      387         ,output v-value-integer
      388         ,output v-value-logical
      389         ,output v-param-type
      390         ,INPUT-OUTPUT table-handle v-tth
      391         ) no-error .
      392       if error-status:error
      393       then do:
      394         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
      395                                 , p-prop-obj-type
      396                                 , p-prop-obj-code).
      397       end.
      398       find first thbjattr_thbj-attr where
      399                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
      400             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
      401             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
      402             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
      403       if not available thbjattr_thbj-attr
      404       or thbjattr_thbj-attr.property-value-integer = 0 then do:
      405         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
      406                                 , p-prop-obj-type
      407                                 , p-prop-obj-code).
      408       end.
      409       assign
      410       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
      411       if p-prop-host-code = p-host-code
      412       and (p-alias-type-price = '':U
      413       or   p-alias-type-price <> '5':U)
      414       then  do:
      415         assign
      416         p-ext-doc-type = 'ev':U
      417         p-price-obj-type = p-obj-type
      418         p-price-obj-code = p-obj-code
      419         p-alias-type-price = '3':U
      420         .
      421       end.
      422       else do:
      423         if p-prop-host-code = p-host-code  then do:
      424           assign
      425           p-ext-doc-type = 'ev':U
      426           p-price-obj-type = p-obj-type
      427           p-price-obj-code = p-obj-code
      428           .
      429         end.
      430         else do:
      431           assign
      432           p-ext-doc-type = 'ee':U.
      433           assign
      434           v-mediat-obj-type = "":U
      435           v-mediat-obj-code = 0
      436           v-mediat-objf = "":U
      437           .
      438           if p-alias-type-price = '4':U then do:
      439             find first thbjattr_thbj-attr where
      440                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
      441                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
      442                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
      443                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
      444             if not available thbjattr_thbj-attr
      445             or thbjattr_thbj-attr.property-value-character = "":U then do:
      446               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
      447                                       , p-prop-obj-type
      448                                       , p-prop-obj-code).
      449             end.
      450             assign
      451             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
      452             v-mediat-obj-type = entry(1, v-mediat-objf)
      453             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
      454             no-error
      455             .
      456             if error-status:error then do:
      457               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
      458                                       , p-prop-obj-type
      459                                       , p-prop-obj-code).
      460             end.
      461           end.
      462           CASE p-alias-type-price:
      463             when '1':U then do:
      464               assign
      465               p-price-obj-type = p-prop-obj-type
      466               p-price-obj-code = p-prop-obj-code
      467               .
      468             end.
      469             when '2':U then do:
      470               assign
      471               p-price-obj-type = p-prop-obj-type
      472               p-price-obj-code = p-prop-obj-code
      473               .
      474             end.
      475             when '3':U
      476             or
      477             when '5':U
      478             then do:
      479               assign
      480               p-price-obj-type = p-obj-type
      481               p-price-obj-code = p-obj-code
      482               .
      483             end.
      484             when '4':U then do:
      485               assign
      486               p-price-obj-type = v-mediat-obj-type
      487               p-price-obj-code = v-mediat-obj-code
      488               .
      489             end.
      490           END CASE.
      491         end.
      492       end.
      493     end.
      494   end procedure.
      495   procedure write-tt0-info:
      496   define input parameter p-artic as character no-undo .
      497   define input parameter p-prod-type as character no-undo .
      498   define input parameter p-prod-code as integer no-undo .
      499   define input parameter p-prt-code as integer no-undo .
      500   define input parameter p-obj-type as character no-undo .
      501   define input parameter p-obj-code as integer no-undo .
      502   define input parameter p-doc-code as character no-undo .
      503   define input parameter p-from-tpsi as logical no-undo .
      504   define input parameter p-all-qnty as decimal no-undo .
      505   define input parameter p-was-res as decimal no-undo .
      506   define input parameter p-to-res as decimal no-undo .
      507   define input parameter p-is-res as decimal no-undo .
      508   define input parameter p-o-was-res as decimal no-undo .
      509   define input parameter p-o-to-res as decimal no-undo .
      510   define input parameter p-o-is-res as decimal no-undo .
      511   define input parameter p-mess   as character no-undo .
      512   define buffer buf_tt0-info for tt0-info.
      513     do
      514     on error undo, return error return-value
      515     :
      516       find first buf_tt0-info where
      517                buf_tt0-info.artic = p-artic
      518            and buf_tt0-info.prod-type = p-prod-type
      519            and buf_tt0-info.prod-code = p-prod-code
      520            and buf_tt0-info.prt-code = p-prt-code
      521            no-error .
      522       if not available buf_tt0-info then do:
      523         create buf_tt0-info.
      524         assign
      525         buf_tt0-info.artic = p-artic
      526         buf_tt0-info.prod-type = p-prod-type
      527         buf_tt0-info.prod-code = p-prod-code
      528         buf_tt0-info.prt-code  = p-prt-code
      529         buf_tt0-info.obj-type  = p-obj-type
      530         buf_tt0-info.obj-code  = p-obj-code
      531         buf_tt0-info.a-to-res  = ?
      532         buf_tt0-info.to-res    = ?
      533         buf_tt0-info.was-res   = ?
      534         buf_tt0-info.o-was-res = ?
      535         buf_tt0-info.o-to-res  = ?
      536         buf_tt0-info.o-is-res  = ?
      537         buf_tt0-info.is-res    = ?
      538         .
      539       end.
      540       assign
      541       buf_tt0-info.a-to-res  =
      542                                 (if buf_tt0-info.a-to-res <> ?
      543                                 and p-all-qnty = ?
      544                                 then buf_tt0-info.a-to-res
      545                                 else p-all-qnty)
      546       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
      547                                 and p-was-res = ?
      548                                 then buf_tt0-info.was-res
      549                                 else p-was-res)
      550       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
      551                                 and p-to-res = ?
      552                                 then buf_tt0-info.to-res
      553                                 else p-to-res)
      554       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
      555                                 and p-is-res = ?
      556                                 then buf_tt0-info.is-res
      557                                 else p-is-res)
      558       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
      559                                 and p-o-was-res = ?
      560                                 then buf_tt0-info.o-was-res
      561                                 else p-o-was-res)
      562       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
      563                                 and p-o-to-res = ?
      564                                 then buf_tt0-info.o-to-res
      565                                 else p-o-to-res)
      566       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
      567                                 and p-o-is-res = ?
      568                                 then buf_tt0-info.o-is-res
      569                                 else p-o-is-res)
      570       .
      571       assign
      572       buf_tt0-info.doc-code  = p-doc-code
      573       buf_tt0-info.error-message   = p-mess
      574       .
      575     end.
      576   end procedure.
