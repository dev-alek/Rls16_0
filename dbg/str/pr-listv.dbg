        1   block-level on error undo, throw.
        2   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   def var vss-author      as character no-undo init "$Author: expertek $":U .
        4   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   def var vss-workfile    as character no-undo init "$Workfile: pr-listv.p $":U .
        6   def var vss-archive     as character no-undo init "$Archive: str/pr-listv.p $":U .
        7   def var vss-description as character no-undo init " фильтрует методы переоценки   ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       71   define variable par-type          as character no-undo.
       72   define variable v-value-character as character no-undo .
       73   define variable v-value-date      as date      no-undo .
       74   define variable v-value-decimal   as decimal   no-undo .
       75   define variable v-value-integer   as integer   no-undo .
       76   define variable v-value-logical   as logical   no-undo .
       77   define input  parameter i-list   as character no-undo .
       78   define input  parameter init-val as character no-undo .
       79   define output parameter o-list   as character no-undo .
       80   define variable i           as integer   no-undo .
       81   define variable par-pr-list as character no-undo .
       82   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   empty temp-table thbjattr_thbj-attr.
       84   run adm/shattri.p (
       85      input "get":U
       86     ,input ''
       87     ,input 0
       88     ,input 'overval':U
       89     ,input  ""
       90     ,output v-value-character
       91     ,output v-value-date
       92     ,output v-value-decimal
       93     ,output v-value-integer
       94     ,output v-value-logical
       95     ,output par-type
       96     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
       97     ) no-error .
       98     for each thbjattr_thbj-attr :
       99         if thbjattr_thbj-attr.prop-code = 'pr-list':U then par-pr-list = thbjattr_thbj-attr.property-value-character .
      100     end.
      101    if par-pr-list = ? then par-pr-list = ""   .
      102    if par-pr-list = ""  then  do:
      103       o-list = i-list .
      104       return .
      105    end.
      106   define variable v-nn as integer   no-undo .
      107   v-nn =  num-entries ( par-pr-list )  .
      108   do i = 1 to v-nn :
      109      if lookup(caps(entry(i,par-pr-list)) , caps('Товар,Учетная,Учет-объект,Учет-резерв,Приходная,Прих-объект,Старая,Новая,Объект,Накладная,Переоценка,Накл-безНДС,Учет-безНДС,Стар-безНДС,Единая,НсП,НсП+накл,Откат_цен,Отсутствует,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U) + "," + caps('Учетная,Группа,Учет-резерв,Накладная,Накл-безНДС,Учет-безНДС,Учет+накл,Уч+накл-НДС,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U)  + "," + caps('Товар,УчетнаяS,Учет-рзрвS,ПриходнаяS,Старая,Новая,Объект,Накладная,Переоценка,ДокФормЦены,Накл-безНДС,Учет-НДСS,Стар-безНДС,Единая,Отсутствует,Откат_цен,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U) ) = 0
      110        then do:
      111        if caps(entry(i,par-pr-list)) = "" then
      112         message "Неправильное значение метода расчета переоценки - есть пробел или лишняя запятая" skip
      113         "Фильтр игнорируется !" skip
      114         "Проверьте параметр системы pr-list! " skip
      115         par-pr-list
      116         .
      117        else
      118         message "Неправильное значение метода расчета переоценки - " entry(i,par-pr-list) skip
      119         "Фильтр игнорируется !" skip
      120         "Проверьте параметр системы pr-list! ".
      121         o-list = i-list .
      122         return.
      123         end.
      124   end.
      125   o-list = "" .
      126   define variable v-1 as integer   no-undo .
      127   v-1 = num-entries ( i-list ) .
      128   do i = 1 to v-1 :
      129      if lookup(caps(entry(i,i-list)) , caps(par-pr-list)) > 0
      130         or caps(entry(i,i-list)) = caps('Отсутствует':U)
      131         or caps(entry(i,i-list)) = caps('Не-считать':U)
      132         or caps(entry(i,i-list)) = caps(init-val)
      133         then do:
      134         assign
      135           o-list = o-list
      136            + ( if o-list = "" then "" else "," )
      137            + entry( i , i-list ) .
      138         end.
      139   end.
      140   return .
