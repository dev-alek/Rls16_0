     1703   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1704   DO:
     1705   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1706   do:
     1707     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1708       (input  v-cntxt-db-num
     1709       ,input  v-cntxt-userid
     1710       ,input  0
     1711       ,input  'actn_fin-contract_add-def':U
     1712       ,input  'firm':U
     1713       ,input  p-host-code
     1714       ,input  '':U
     1715       ,input  0
     1716       ,input  0
     1717       ,input  0
     1718       ,input  0
     1719       ,input  true
     1720       ,output g-log
     1721       )  .
     1722   end.
     1723     if not g-log then return no-apply .
     1724     run run-contr in this-procedure ('ДОБАВЛЕНИЕ':U, no) .
     1725   END.
     1726   ON CHOOSE OF B-order IN FRAME Dialog-Frame
     1727   DO:
     1728   define variable v-list as character no-undo .
     1729   if not avail buf_contract then return no-apply.
     1730     run cus/zakz-rcv.w (
     1731      input   parparentproc
     1732     ,input   "all":U
     1733     ,input   "all":U
     1734     ,input   "contract":U
     1735     ,input   recid( buf_contract )
     1736     ,input   "b-lkp,nob-exec,nob-copy"
