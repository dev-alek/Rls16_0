     2364   run minbtn-set in this-procedure .
     2365   on choose of b-help in frame Dialog-Frame
     2366   do:
     2367     apply "help":u to frame Dialog-Frame .
     2368   end.
     2369   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2370   procedure minbtn-set :
     2371       do
     2372           on error undo, return error return-value
     2373           :
     2374           define variable ii              as integer       no-undo .
     2375           define variable fh              as widget-handle no-undo .
     2376           define variable hh              as widget-handle no-undo .
     2377           define variable v-h             as handle        extent 4 no-undo .
     2378           define variable v-name-button   as character     no-undo .
     2379           define variable v-help-old-x    as decimal       no-undo .
     2380           define variable v-help-old-y    as decimal       no-undo .
     2381           define variable v-help-old-size as decimal       no-undo .
     2382           define variable v-frame-width   as decimal       no-undo .
     2383           define variable jj              as integer       no-undo .
     2384           do
     2385               on error undo, return error
     2386               :
     2387               assign
     2388                   v-frame-width = frame Dialog-Frame:width - 0.3
     2389                   fh            = frame Dialog-Frame:first-child
     2390                   hh            = fh:first-child
     2391                   ii            = 1
     2392                   .
     2393               do while valid-handle(hh):
     2394                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2395                   do:
     2396                       case lc(hh:name) :
     2397                           when "b-help" then
     2398                               do:
     2399                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2400                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2401                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2402                                   hh:TOOLTIP = "Помощь" .
     2403                                   v-help-old-x = hh:column .
     2404                                   v-help-old-y = hh:row    .
     2405                                   v-help-old-size = hh:width .
     2406                                   hh:width-chars = 2.5 .
     2407                               end.
     2408                           when "b-print" then
     2409                               do:
     2410                                   hh:load-image("cmp/b-print.bmp":u) .
     2411                                   hh:TOOLTIP = "Печать" .
     2412                                   v-h[ii] = hh:handle .
     2413                                   ii = ii + 1 .
     2414                                   hh:width-chars = 3 .
     2415                               end.
     2416                           when "b-history" or
     2417                           when "b-hist" then
     2418                               do:
     2419                                   hh:load-image("cmp/b-hist.bmp":u) .
     2420                                   hh:TOOLTIP = "История" .
     2421                                   v-h[ii] = hh:handle .
     2422                                   ii = ii + 1 .
     2423                                   hh:width-chars = 3 .
     2424                               end.
     2425                           when "b-sch" then
     2426                               do:
     2427                                   hh:load-image("cmp/b-sch.bmp":u) .
     2428                                   hh:TOOLTIP = "Установка Фильтра" .
     2429                                   v-h[ii] = hh:handle .
     2430                                   ii = ii + 1 .
     2431                                   hh:width-chars = 3 .
     2432                               end.
     2433                           when "b-hist-user" then
     2434                               do:
     2435                                   hh:load-image("cmp/b-hist.bmp":u) .
     2436                                   hh:TOOLTIP = "История пользователя" .
     2437                                   ii = ii + 1 .
     2438                               end.
     2439                       end case.
     2440                   end.
     2441                   hh = hh:next-sibling.
     2442               end.
     2443               b-help:column = v-frame-width - b-help:width-chars.
     2444               jj = 0.
     2445               repeat ii = 4 to 1 by -1 :
     2446                   if valid-handle (v-h[ii] ) then
     2447                   do:
     2448                       jj  = jj + 1 .
     2449                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2450                       v-h[ii]:row    = v-help-old-y .
     2451                   end.
     2452               end.
     2453           end.
     2454       end.
     2455   end procedure.
     2456   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2457   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2458   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2459   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2460   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2461   define variable v-diasize-current-frame-height as decimal   no-undo .
     2462   define variable v-diasize-change-size          as logical   no-undo .
     2463   define variable v-diasize-resize-button        as handle    no-undo .
     2464   define variable v-diasize-wndmax               as logical   no-undo .
     2465   define variable v-diasize-wndstore             as logical   no-undo .
     2466   define variable v-diasize-proc-name            as character no-undo .
     2467   define variable v-diasize-browse-handle        as handle    no-undo .
     2468   define variable v-diasize-browse-number        as integer   no-undo .
     2469   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2470   define temp-table temp-diasize-handle no-undo
     2471     field handle-value  as handle
     2472     field save-position as decimal
     2473     index xpk is primary unique handle-value
     2474     .
     2475   define temp-table temp-browse-handle no-undo
     2476     field browse-type   as character
     2477     field browse-number as integer
     2478     field browse-handle as handle
     2479     field original-size as decimal
     2480     index xpk is primary unique browse-type browse-number
     2481     index xie browse-type browse-handle
     2482   .
     2483   procedure diasize_change-height :
     2484     define input  parameter p-change-value  as decimal   no-undo .
     2485     define input  parameter p-move-resize   as logical   no-undo .
     2486     define variable v-field-group-handle    as handle    no-undo .
     2487     define variable v-object-handle         as handle    no-undo .
     2488     define variable v-frame-height          as decimal   no-undo .
     2489     define variable v-frame-virtual-height  as decimal   no-undo .
     2490     define variable v-browse-height         as decimal   no-undo .
     2491     define variable v-window-height         as decimal   no-undo .
     2492     define variable v-window-virtual-height as decimal   no-undo .
     2493     define variable v-change-sign           as integer   no-undo .
     2494     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2495     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2496     if p-change-value > 0
     2497     then do:
     2498       if frame Dialog-Frame :height + p-change-value
     2499           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2500       then do:
     2501         assign
     2502           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2503                           - (frame Dialog-Frame :height-chars)
     2504         .
     2505         if p-change-value <= 0
     2506         then do:
     2507           run diasize_position-resize-button in this-procedure .
     2508           return .
     2509         end.
     2510       end.
     2511     end.
     2512     if p-change-value < 0
     2513     then do:
     2514       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2515       then do:
     2516         assign
     2517           p-change-value = v-diasize-orig-frame-height
     2518                          - (frame Dialog-Frame :height-chars)
     2519         .
     2520         if p-change-value >= 0
     2521         then do:
     2522           run diasize_position-resize-button in this-procedure .
     2523           return .
     2524         end.
     2525       end.
     2526     end.
     2527     if p-change-value >= 0
     2528     then do:
     2529       assign
     2530         v-change-sign = 1
     2531       .
     2532     end.
     2533     else do:
     2534       assign
     2535         v-change-sign = -1
     2536       .
     2537     end.
     2538     assign
     2539       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2540     .
     2541     if p-change-value = 0
     2542     then do:
     2543       run diasize_position-resize-button in this-procedure .
     2544       return .
     2545     end.
     2546     move_block:
     2547     do
     2548     on error undo move_block, retry move_block
     2549     :
     2550       if retry
     2551       then do:
     2552         do
     2553         on error undo move_block, leave move_block
     2554         :
     2555           if p-change-value > 0
     2556           then do:
     2557             for each buf_temp-diasize-handle
     2558             on error undo, next
     2559             :
     2560               assign
     2561                 v-object-handle = buf_temp-diasize-handle.handle-value
     2562               .
     2563               if v-object-handle <> v-diasize-resize-button
     2564               then do:
     2565                 assign
     2566                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2567                 .
     2568               end.
     2569             end.
     2570             assign
     2571               v-diasize-browse-handle :height = v-browse-height
     2572             .
     2573             for each buf_temp-browse-handle
     2574               where buf_temp-browse-handle.browse-type = 'height':u
     2575             on error undo, next
     2576             :
     2577               assign
     2578                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2579               .
     2580             end.
     2581             assign
     2582               frame Dialog-Frame :height = v-frame-height
     2583             .
     2584             if frame Dialog-Frame :scrollable = true
     2585             then do:
     2586               assign
     2587                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2588               .
     2589             end.
     2590             run diasize_position-resize-button in this-procedure .
     2591           end.
     2592           else do:
     2593             if frame Dialog-Frame :scrollable = true
     2594             then do:
     2595               assign
     2596                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2597               .
     2598             end.
     2599             assign
     2600               frame Dialog-Frame :height = v-frame-height
     2601             .
     2602             assign
     2603               v-diasize-browse-handle :height = v-browse-height
     2604             .
     2605             for each buf_temp-browse-handle
     2606               where buf_temp-browse-handle.browse-type = 'height':u
     2607             on error undo, next
     2608             :
     2609               assign
     2610                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2611               .
     2612             end.
     2613             for each buf_temp-diasize-handle
     2614             on error undo, next
     2615             :
     2616               assign
     2617                 v-object-handle = buf_temp-diasize-handle.handle-value
     2618               .
     2619               if v-object-handle <> v-diasize-resize-button
     2620               then do:
     2621                 assign
     2622                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2623                 .
     2624               end.
     2625             end.
     2626             run diasize_position-resize-button in this-procedure .
     2627           end.
     2628           assign
     2629             v-diasize-change-size = false
     2630           .
     2631           leave move_block .
     2632         end.
     2633       end.
     2634       assign
     2635         v-diasize-need-full-display = true
     2636       .
     2637       if v-diasize-change-size = false
     2638       then do:
     2639         assign
     2640           v-diasize-change-size = true
     2641         .
     2642       end.
     2643       else do:
     2644         return .
     2645       end.
     2646       assign
     2647         v-frame-height = frame Dialog-Frame :height
     2648         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2649         v-browse-height = v-diasize-browse-handle :height
     2650       .
     2651       for each buf_temp-browse-handle
     2652         where buf_temp-browse-handle.browse-type = 'height':u
     2653       :
     2654         assign
     2655           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2656         .
     2657       end.
     2658       for each buf_temp-diasize-handle
     2659       :
     2660         delete buf_temp-diasize-handle .
     2661       end.
     2662       assign
     2663         v-field-group-handle = frame Dialog-Frame :first-child
     2664       .
     2665       do while valid-handle(v-field-group-handle)
     2666       :
     2667         assign
     2668           v-object-handle = v-field-group-handle :first-child
     2669         .
     2670         do while valid-handle(v-object-handle)
     2671         :
     2672           if  v-object-handle <> v-diasize-browse-handle :handle
     2673           and can-query(v-object-handle, "row")
     2674           and can-query(v-object-handle, "height")
     2675           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2676           then do:
     2677             find first buf_temp-browse-handle
     2678               where buf_temp-browse-handle.browse-type   = 'height':u
     2679                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2680               no-error .
     2681             if available buf_temp-browse-handle
     2682             then do:
     2683             end.
     2684             else do:
     2685               create buf_temp-diasize-handle .
     2686               assign
     2687                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2688                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2689               .
     2690             end.
     2691           end.
     2692           assign
     2693             v-object-handle = v-object-handle :next-sibling
     2694           .
     2695         end.
     2696         assign
     2697           v-field-group-handle = v-field-group-handle :next-sibling
     2698         .
     2699       end.
     2700       do with frame Dialog-Frame
     2701       :
     2702         hide v-diasize-resize-button .
     2703         assign
     2704           v-diasize-resize-button :row    = 1
     2705           v-diasize-resize-button :column = 1
     2706         .
     2707       end.
     2708       if p-change-value > 0
     2709       then do:
     2710         if frame Dialog-Frame :scrollable = true
     2711         then do:
     2712           assign
     2713             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2714             no-error .
     2715           if error-status :error
     2716           or error-status :get-message(1) <> ""
     2717           then do:
     2718             undo move_block, retry move_block .
     2719           end.
     2720         end.
     2721         assign
     2722           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2723           no-error .
     2724         if error-status :error
     2725         or error-status :get-message(1) <> ""
     2726         then do:
     2727           undo move_block, retry move_block .
     2728         end.
     2729         assign
     2730           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2731           no-error .
     2732         if error-status :error
     2733         or error-status :get-message(1) <> ""
     2734         then do:
     2735           undo move_block, retry move_block .
     2736         end.
     2737         for each buf_temp-browse-handle
     2738           where buf_temp-browse-handle.browse-type = 'height':u
     2739         on error undo move_block, retry move_block
     2740         :
     2741           assign
     2742             buf_temp-browse-handle.browse-handle :height
     2743               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2744             no-error .
     2745           if error-status :error
     2746           or error-status :get-message(1) <> ""
     2747           then do:
     2748             undo move_block, retry move_block .
     2749           end.
     2750         end.
     2751         for each buf_temp-diasize-handle
     2752         on error undo move_block, retry move_block
     2753         :
     2754           assign
     2755             v-object-handle = buf_temp-diasize-handle.handle-value
     2756           .
     2757           if v-object-handle <> v-diasize-resize-button
     2758           then do:
     2759             assign
     2760               v-object-handle :row = v-object-handle :row + p-change-value
     2761               no-error .
     2762             if error-status :error
     2763             or error-status :get-message(1) <> ""
     2764             then do:
     2765               undo move_block, retry move_block .
     2766             end.
     2767           end.
     2768         end.
     2769       end.
     2770       else do:
     2771         for each buf_temp-diasize-handle
     2772         on error undo move_block, retry move_block
     2773         :
     2774           assign
     2775             v-object-handle = buf_temp-diasize-handle.handle-value
     2776           .
     2777           if v-object-handle <> v-diasize-resize-button
     2778           then do:
     2779             assign
     2780               v-object-handle :row = v-object-handle :row + p-change-value
     2781               no-error .
     2782             if error-status :error
     2783             or error-status :get-message(1) <> ""
     2784             then do:
     2785               undo move_block, retry move_block .
     2786             end.
     2787           end.
     2788         end.
     2789         assign
     2790           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2791           no-error .
     2792         if error-status :error
     2793         or error-status :get-message(1) <> ""
     2794         then do:
     2795           undo move_block, retry move_block .
     2796         end.
     2797         for each buf_temp-browse-handle
     2798           where buf_temp-browse-handle.browse-type = 'height':u
     2799         on error undo move_block, retry move_block
     2800         :
     2801           assign
     2802             buf_temp-browse-handle.browse-handle :height
     2803               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2804             no-error .
     2805           if error-status :error
     2806           or error-status :get-message(1) <> ""
     2807           then do:
     2808             undo move_block, retry move_block .
     2809           end.
     2810         end.
     2811         assign
     2812           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2813           no-error .
     2814         if error-status :error
     2815         or error-status :get-message(1) <> ""
     2816         then do:
     2817           undo move_block, retry move_block .
     2818         end.
     2819         if frame Dialog-Frame :scrollable = true
     2820         then do:
     2821           assign
     2822             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2823             no-error .
     2824           if error-status :error
     2825           or error-status :get-message(1) <> ""
     2826           then do:
     2827             undo move_block, retry move_block .
     2828           end.
     2829         end.
     2830       end.
     2831       if p-move-resize = true
     2832       then do:
     2833         run diasize_position-resize-button in this-procedure .
     2834       end.
     2835       if v-diasize-wndstore = true
     2836       then do:
     2837         if connected("ub") = true
     2838         then do:
     2839           define variable v-cntxt-db-num        as integer   no-undo .
     2840           define variable v-cntxt-userid        as character no-undo .
     2841           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2842                                             , OUTPUT v-cntxt-userid
     2843                                             ) .
     2844           run gbl/wndsizew.p
     2845             (input  v-cntxt-db-num
     2846             ,input  v-cntxt-userid
     2847             ,input  v-diasize-proc-name
     2848             ,input  'height':u
     2849             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2850             ) .
     2851         end.
     2852       end.
     2853     end.
     2854     assign
     2855       v-diasize-change-size = false
     2856     .
     2857   end procedure.
     2858   procedure diasize_set-height :
     2859     define input  parameter p-new-height  as decimal   no-undo .
     2860     define input  parameter p-move-resize as logical   no-undo .
     2861     do
     2862     on error undo, return error return-value
     2863     :
     2864       run diasize_change-height in this-procedure
     2865         (input  (p-new-height - frame Dialog-Frame :height)
     2866         ,input  p-move-resize
     2867         ) .
     2868     end.
     2869   end procedure.
     2870   procedure diasize_change-width :
     2871     define input  parameter p-change-value as decimal   no-undo .
     2872     define input  parameter p-move-resize  as logical   no-undo .
     2873     define variable v-field-group-handle   as handle    no-undo .
     2874     define variable v-object-handle        as handle    no-undo .
     2875     define variable v-frame-width          as decimal   no-undo .
     2876     define variable v-frame-virtual-width  as decimal   no-undo .
     2877     define variable v-browse-width         as decimal   no-undo .
     2878     define variable v-window-width         as decimal   no-undo .
     2879     define variable v-window-virtual-width as decimal   no-undo .
     2880     define variable v-change-sign          as integer   no-undo .
     2881     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2882     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2883     if p-change-value > 0
     2884     then do:
     2885       if frame Dialog-Frame :width + p-change-value >
     2886           session :width-chars
     2887       then do:
     2888         assign
     2889           p-change-value = session :width-chars - frame Dialog-Frame :width
     2890         .
     2891         if p-change-value <= 0
     2892         then do:
     2893           run diasize_position-resize-button in this-procedure .
     2894           return .
     2895         end.
     2896       end.
     2897     end.
     2898     if p-change-value < 0
     2899     then do:
     2900       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2901       then do:
     2902         assign
     2903           p-change-value = v-diasize-orig-frame-width
     2904                          - frame Dialog-Frame :width
     2905         .
     2906         if p-change-value >= 0
     2907         then do:
     2908           run diasize_position-resize-button in this-procedure .
     2909           return .
     2910         end.
     2911       end.
     2912     end.
     2913     if p-change-value >= 0
     2914     then do:
     2915       assign
     2916         v-change-sign = 1
     2917       .
     2918     end.
     2919     else do:
     2920       assign
     2921         v-change-sign = -1
     2922       .
     2923     end.
     2924     assign
     2925       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2926     .
     2927     if p-change-value = 0
     2928     then do:
     2929       run diasize_position-resize-button in this-procedure .
     2930       return .
     2931     end.
     2932     move_block:
     2933     do
     2934     on error undo move_block, leave move_block
     2935     :
     2936       if retry
     2937       then do:
     2938         do
     2939         on error undo move_block, leave move_block
     2940         :
     2941           if p-change-value > 0
     2942           then do:
     2943             for each buf_temp-diasize-handle
     2944             on error undo, next
     2945             :
     2946               assign
     2947                 v-object-handle = buf_temp-diasize-handle.handle-value
     2948               .
     2949               if v-object-handle <> v-diasize-resize-button
     2950               then do:
     2951                 assign
     2952                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2953                 .
     2954               end.
     2955             end.
     2956             assign
     2957               v-diasize-browse-handle :width = v-browse-width
     2958             .
     2959             for each buf_temp-browse-handle
     2960               where buf_temp-browse-handle.browse-type = 'width':u
     2961             on error undo, next
     2962             :
     2963               assign
     2964                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2965               .
     2966             end.
     2967             assign
     2968               frame Dialog-Frame :width = v-frame-width
     2969             .
     2970             if frame Dialog-Frame :scrollable = true
     2971             then do:
     2972               assign
     2973                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2974               .
     2975             end.
     2976             run diasize_position-resize-button in this-procedure .
     2977           end.
     2978           else do:
     2979             if frame Dialog-Frame :scrollable = true
     2980             then do:
     2981               assign
     2982                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2983               .
     2984             end.
     2985             assign
     2986               frame Dialog-Frame :width = v-frame-width
     2987             .
     2988             for each buf_temp-browse-handle
     2989               where buf_temp-browse-handle.browse-type = 'width':u
     2990             on error undo, next
     2991             :
     2992               assign
     2993                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2994               .
     2995             end.
     2996             assign
     2997               v-diasize-browse-handle :width = v-browse-width
     2998             .
     2999             for each buf_temp-diasize-handle
     3000             on error undo, next
     3001             :
     3002               assign
     3003                 v-object-handle = buf_temp-diasize-handle.handle-value
     3004               .
     3005               if v-object-handle <> v-diasize-resize-button
     3006               then do:
     3007                 assign
     3008                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3009                 .
     3010               end.
     3011             end.
     3012             run diasize_position-resize-button in this-procedure .
     3013           end.
     3014           assign
     3015             v-diasize-change-size = false
     3016           .
     3017           leave move_block .
     3018         end.
     3019       end.
     3020       assign
     3021         v-diasize-need-full-display = true
     3022       .
     3023       if v-diasize-change-size = false
     3024       then do:
     3025         assign
     3026           v-diasize-change-size = true
     3027         .
     3028       end.
     3029       else do:
     3030         return .
     3031       end.
     3032       assign
     3033         v-frame-width = frame Dialog-Frame :width
     3034         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3035         v-browse-width = v-diasize-browse-handle :width
     3036       .
     3037       for each buf_temp-browse-handle
     3038         where buf_temp-browse-handle.browse-type = 'width':u
     3039       :
     3040         assign
     3041           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3042         .
     3043       end.
     3044       for each buf_temp-diasize-handle
     3045       :
     3046         delete buf_temp-diasize-handle .
     3047       end.
     3048       assign
     3049         v-field-group-handle = frame Dialog-Frame :first-child
     3050       .
     3051       do while valid-handle(v-field-group-handle)
     3052       :
     3053         assign
     3054           v-object-handle = v-field-group-handle :first-child
     3055         .
     3056         do while valid-handle(v-object-handle)
     3057         :
     3058           if  v-object-handle <> v-diasize-browse-handle :handle
     3059           and v-object-handle <> v-diasize-resize-button
     3060           and can-query(v-object-handle, "row")
     3061           and can-query(v-object-handle, "height")
     3062           and ( v-object-handle :col + v-object-handle :width
     3063                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3064               )
     3065           then do:
     3066             find first buf_temp-browse-handle
     3067               where buf_temp-browse-handle.browse-type   = 'width':u
     3068                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3069               no-error .
     3070             if available buf_temp-browse-handle
     3071             then do:
     3072             end.
     3073             else do:
     3074               create buf_temp-diasize-handle .
     3075               assign
     3076                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3077                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3078               .
     3079             end.
     3080           end.
     3081           assign
     3082             v-object-handle = v-object-handle :next-sibling
     3083           .
     3084         end.
     3085         assign
     3086           v-field-group-handle = v-field-group-handle :next-sibling
     3087         .
     3088       end.
     3089       do with frame Dialog-Frame
     3090       :
     3091         hide v-diasize-resize-button .
     3092         v-diasize-resize-button :row = 1.
     3093         v-diasize-resize-button :column = 1.
     3094       end.
     3095       if p-change-value > 0
     3096       then do:
     3097         if frame Dialog-Frame :scrollable = true
     3098         then do:
     3099           assign
     3100             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3101             no-error .
     3102           if error-status :error
     3103           or error-status :get-message(1) <> ""
     3104           then do:
     3105             undo move_block, retry move_block.
     3106           end.
     3107         end.
     3108         assign
     3109           frame Dialog-Frame :width = v-frame-width + p-change-value
     3110           no-error .
     3111         if error-status :error
     3112         or error-status :get-message(1) <> ""
     3113         then do:
     3114           undo move_block, retry move_block.
     3115         end.
     3116         assign
     3117           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3118         no-error .
     3119         if error-status :error
     3120         or error-status :get-message(1) <> ""
     3121         then do:
     3122           undo move_block, retry move_block.
     3123         end.
     3124         for each buf_temp-browse-handle
     3125           where buf_temp-browse-handle.browse-type = 'width':u
     3126         on error undo move_block, retry move_block
     3127         :
     3128           assign
     3129             buf_temp-browse-handle.browse-handle :width
     3130               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3131             no-error .
     3132           if error-status :error
     3133           or error-status :get-message(1) <> ""
     3134           then do:
     3135             undo move_block, retry move_block .
     3136           end.
     3137         end.
     3138         for each buf_temp-diasize-handle
     3139         on error undo move_block, retry move_block
     3140         :
     3141           assign
     3142             v-object-handle = buf_temp-diasize-handle.handle-value
     3143           .
     3144           if v-object-handle <> v-diasize-resize-button
     3145           then do:
     3146             assign
     3147               v-object-handle :col = v-object-handle :col + p-change-value
     3148               no-error .
     3149             if error-status :error
     3150             or error-status :get-message(1) <> ""
     3151             then do:
     3152               undo move_block, retry move_block .
     3153             end.
     3154           end.
     3155         end.
     3156       end.
     3157       else do:
     3158         for each buf_temp-diasize-handle
     3159         on error undo move_block, retry move_block
     3160         :
     3161           assign
     3162             v-object-handle = buf_temp-diasize-handle.handle-value
     3163           .
     3164           if v-object-handle <> v-diasize-resize-button
     3165           then do:
     3166             assign
     3167               v-object-handle :col = v-object-handle :col + p-change-value
     3168               no-error .
     3169             if error-status :error
     3170             or error-status :get-message(1) <> ""
     3171             then do:
     3172               undo move_block, retry move_block .
     3173             end.
     3174           end.
     3175         end.
     3176         for each buf_temp-browse-handle
     3177           where buf_temp-browse-handle.browse-type = 'width':u
     3178         on error undo move_block, retry move_block
     3179         :
     3180           assign
     3181             buf_temp-browse-handle.browse-handle :width
     3182               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3183             no-error .
     3184           if error-status :error
     3185           or error-status :get-message(1) <> ""
     3186           then do:
     3187             undo move_block, retry move_block .
     3188           end.
     3189         end.
     3190         assign
     3191           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3192           no-error .
     3193         if error-status :error
     3194         or error-status :get-message(1) <> ""
     3195         then do:
     3196           undo move_block, retry move_block.
     3197         end.
     3198         assign
     3199           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3200         no-error .
     3201         if error-status :error
     3202         or error-status :get-message(1) <> ""
     3203         then do:
     3204           undo move_block, retry move_block.
     3205         end.
     3206         if frame Dialog-Frame :scrollable = true
     3207         then do:
     3208           assign
     3209             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3210           no-error .
     3211           if error-status :error
     3212           or error-status :get-message(1) <> ""
     3213           then do:
     3214             undo move_block, retry move_block.
     3215           end.
     3216         end.
     3217       end.
     3218       if p-move-resize
     3219       then do:
     3220         run diasize_position-resize-button in this-procedure .
     3221       end.
     3222       if v-diasize-wndstore = true
     3223       then do:
     3224         if connected("ub") = true
     3225         then do:
     3226           define variable v-cntxt-db-num        as integer   no-undo .
     3227           define variable v-cntxt-userid        as character no-undo .
     3228           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3229                                             , OUTPUT v-cntxt-userid
     3230                                             ) .
     3231           run gbl/wndsizew.p
     3232             (input  v-cntxt-db-num
     3233             ,input  v-cntxt-userid
     3234             ,input  v-diasize-proc-name
     3235             ,input  'width':u
     3236             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3237             ) .
     3238         end.
     3239       end.
     3240     end.
     3241     assign
     3242       v-diasize-change-size = false
     3243     .
     3244   end procedure.
     3245   procedure diasize_set-width :
     3246     define input  parameter p-new-width  as decimal   no-undo .
     3247     define input  parameter p-move-resize as logical   no-undo .
     3248     do
     3249     on error undo, return error return-value
     3250     :
     3251       run diasize_change-width in this-procedure
     3252         (input  (p-new-width - frame Dialog-Frame :width)
     3253         ,input  p-move-resize
     3254         ) .
     3255     end.
     3256   end procedure.
     3257   procedure diasize_position-resize-button :
     3258     do with frame Dialog-Frame
     3259     :
     3260       hide v-diasize-resize-button .
     3261       assign
     3262         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3263                     - 1
     3264                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3265         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3266                     - 1
     3267                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3268       .
     3269       view v-diasize-resize-button .
     3270     end.
     3271   end procedure.
     3272   on alt-right anywhere
     3273   do:
     3274     run diasize_change-width in this-procedure
     3275       (input 1
     3276       ,input true
     3277       ) .
     3278     return no-apply .
     3279   end.
     3280   on alt-left anywhere
     3281   do:
     3282     run diasize_change-width in this-procedure
     3283       (input -1
     3284       ,input true
     3285       ) .
     3286     return no-apply .
     3287   end.
     3288   on alt-down anywhere
     3289   do:
     3290     run diasize_change-height in this-procedure
     3291       (input 1
     3292       ,input true
     3293       ) .
     3294     return no-apply .
     3295   end.
     3296   on alt-up anywhere
     3297   do:
     3298     run diasize_change-height in this-procedure
     3299       (input -1
     3300       ,input true
     3301       ) .
     3302     return no-apply .
     3303   end.
     3304   on alt-enter of frame Dialog-Frame
     3305   do:
     3306     run diasize_maximize in this-procedure
     3307       (input  ?
     3308       ).
     3309     return no-apply .
     3310   end.
     3311   procedure diasize_end-move :
     3312     do
     3313     on error undo, return error return-value
     3314     :
     3315       define variable v-row-delta as decimal   no-undo .
     3316       define variable v-col-delta as decimal   no-undo .
     3317       define variable v-new-row as decimal   no-undo .
     3318       define variable v-new-col as decimal   no-undo .
     3319       assign
     3320         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3321         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3322       .
     3323       assign
     3324         v-row-delta = v-new-row - frame Dialog-Frame :height
     3325         v-col-delta = v-new-col - frame Dialog-Frame :width
     3326       .
     3327       run diasize_change-height in this-procedure
     3328         (input v-row-delta
     3329         ,input true
     3330         ) .
     3331       run diasize_change-width in this-procedure
     3332         (input v-col-delta
     3333         ,input true
     3334         ) .
     3335     end.
     3336   end procedure.
     3337   procedure diasize_maximize :
     3338     define input  parameter p-action as logical   no-undo .
     3339     do
     3340     on error undo, return error return-value
     3341     :
     3342       if p-action = ?
     3343       then do:
     3344         if v-diasize-need-maximize = true
     3345         then do:
     3346           assign
     3347             p-action = true
     3348           .
     3349         end.
     3350         else do:
     3351           assign
     3352             p-action = false
     3353           .
     3354         end.
     3355       end.
     3356       if p-action = true
     3357       then do:
     3358         run diasize_change-height in this-procedure
     3359           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3360               - frame Dialog-Frame :height-chars
     3361           ,input true
     3362           ) .
     3363         run diasize_change-width in this-procedure
     3364           (input session :width-chars
     3365               - frame Dialog-Frame :width-chars
     3366           ,input true
     3367           ) .
     3368         assign
     3369           v-diasize-need-maximize = false
     3370         .
     3371       end.
     3372       else do:
     3373         run diasize_change-width in this-procedure
     3374           (input v-diasize-orig-frame-width
     3375               - frame Dialog-Frame :width-chars
     3376           ,input true
     3377           ) .
     3378         run diasize_change-height in this-procedure
     3379           (input v-diasize-orig-frame-height
     3380               - frame Dialog-Frame :height-chars
     3381           ,input true
     3382           ) .
     3383         assign
     3384           v-diasize-need-maximize = true
     3385         .
     3386       end.
     3387     end.
     3388   end procedure.
     3389   procedure diasize_restore-orig-size :
     3390     do
     3391     on error undo, return error return-value
     3392     :
     3393       assign
     3394         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3395         v-diasize-current-frame-height = frame Dialog-Frame :height
     3396       .
     3397       run diasize_set-height in this-procedure
     3398         (input  v-diasize-orig-frame-height
     3399         ,input  true
     3400         ) .
     3401       run diasize_set-width in this-procedure
     3402         (input  v-diasize-orig-frame-width
     3403         ,input  true
     3404         ) .
     3405     end.
     3406   end procedure.
     3407   procedure diasize_restore-current-size :
     3408     do
     3409     on error undo, return error return-value
     3410     :
     3411       run diasize_set-height in this-procedure
     3412         (input  v-diasize-current-frame-height
     3413         ,input  true
     3414         ) .
     3415       run diasize_set-width in this-procedure
     3416         (input  v-diasize-current-frame-width
     3417         ,input  true
     3418         ) .
     3419     end.
     3420   end procedure.
     3421   procedure diasize_set-browse-handle :
     3422     define input  parameter p-browse-handle as handle   no-undo .
     3423     define buffer buf_temp-browse-handle for temp-browse-handle .
     3424     do
     3425     on error undo, return error return-value
     3426     :
     3427       assign
     3428         v-diasize-browse-handle = p-browse-handle
     3429       .
     3430       for each buf_temp-browse-handle
     3431       on error undo, return error return-value
     3432       :
     3433         delete buf_temp-browse-handle .
     3434       end.
     3435     end.
     3436   end procedure.
     3437   procedure diasize_add_browse :
     3438     define input  parameter p-browse-type   as character no-undo .
     3439     define input  parameter p-browse-handle as handle    no-undo .
     3440     define buffer buf_temp-browse-handle for temp-browse-handle .
     3441     do
     3442     on error undo, return error return-value
     3443     :
     3444       assign
     3445         v-diasize-browse-number = v-diasize-browse-number + 1
     3446       .
     3447       create buf_temp-browse-handle .
     3448       assign
     3449         buf_temp-browse-handle.browse-type   = p-browse-type
     3450         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3451         buf_temp-browse-handle.browse-handle = p-browse-handle
     3452       .
     3453     end.
     3454   end procedure.
     3455   procedure diasize_init :
     3456     define variable v-default-value    as logical   no-undo .
     3457     define variable v-restore-saved    as logical   no-undo .
     3458     define variable v-resize-value-str as character no-undo .
     3459     do
     3460     on error undo, return error return-value
     3461     :
     3462       do with frame Dialog-Frame
     3463       :
     3464         assign
     3465           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3466           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3467           v-diasize-browse-handle     = browse Contr-List :handle
     3468         .
     3469         create button v-diasize-resize-button
     3470         assign
     3471           parent        = frame Dialog-Frame :first-child
     3472           label         = "s"
     3473           height-pixels = 16
     3474           width-pixels  = 16
     3475           visible       = true
     3476           sensitive     = true
     3477           movable       = true
     3478           triggers:
     3479             on end-move persistent run diasize_end-move in this-procedure .
     3480           end triggers.
     3481         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3482         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3483         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3484         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3485         assign
     3486           v-diasize-wndmax = false
     3487         .
     3488         if connected("ub") = true
     3489         then do:
     3490           define variable v-cntxt-db-num        as integer   no-undo .
     3491           define variable v-cntxt-userid        as character no-undo .
     3492           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3493                                             , OUTPUT v-cntxt-userid
     3494                                             ) .
     3495           run gbl/wndpar_r.p
     3496             (input  v-cntxt-db-num
     3497             ,input  v-cntxt-userid
     3498             ,input  'wndmax':U
     3499             ,output v-diasize-wndmax
     3500             ,output v-default-value
     3501             ) .
     3502         end.
     3503         assign
     3504           v-diasize-wndstore = false
     3505         .
     3506         if connected("ub") = true
     3507         then do:
     3508           run gbl/wndpar_r.p
     3509             (input  v-cntxt-db-num
     3510             ,input  v-cntxt-userid
     3511             ,input  'wndstore':U
     3512             ,output v-diasize-wndstore
     3513             ,output v-default-value
     3514             ) .
     3515         end.
     3516         assign
     3517           v-diasize-proc-name = entry(1, program-name(2), '.')
     3518         .
     3519         if v-diasize-wndstore = true
     3520         then do:
     3521           assign
     3522             v-restore-saved = false
     3523           .
     3524           if connected("ub") = true
     3525           then do:
     3526             run gbl/wndsizer.p
     3527               (input  v-cntxt-db-num
     3528               ,input  v-cntxt-userid
     3529               ,input  v-diasize-proc-name
     3530               ,input  'height':u
     3531               ,output v-resize-value-str
     3532               ) .
     3533             if v-resize-value-str <> '':U
     3534             then do:
     3535               run diasize_change-height in this-procedure
     3536                 (input  integer(v-resize-value-str)
     3537                 ,input  true
     3538                 ) .
     3539               assign
     3540                 v-restore-saved = true
     3541               .
     3542             end.
     3543           end.
     3544           if connected("ub") = true
     3545           then do:
     3546             run gbl/wndsizer.p
     3547               (input  v-cntxt-db-num
     3548               ,input  v-cntxt-userid
     3549               ,input  v-diasize-proc-name
     3550               ,input  'width':u
     3551               ,output v-resize-value-str
     3552               ) .
     3553             if v-resize-value-str <> '':U
     3554             then do:
     3555               run diasize_change-width in this-procedure
     3556                 (input  integer(v-resize-value-str)
     3557                 ,input  true
     3558                 ) .
     3559               assign
     3560                 v-restore-saved = true
     3561               .
     3562             end.
     3563           end.
     3564           if v-restore-saved <> true
     3565           then do:
     3566             if v-diasize-wndmax = true
     3567             then do:
     3568               run diasize_maximize in this-procedure
     3569                 (input  true
     3570                 ) .
     3571             end.
     3572           end.
     3573         end.
     3574         else do:
     3575           if v-diasize-wndmax = true
     3576           then do:
     3577             run diasize_maximize in this-procedure
     3578               (input  true
     3579               ) .
     3580           end.
     3581         end.
     3582       end.
     3583     end.
     3584   end procedure.
     3585   procedure diasize_need-full-display :
     3586     define output parameter p-need-full-display as logical   no-undo .
     3587     do
     3588     on error undo, return error return-value
     3589     :
     3590       assign
     3591         p-need-full-display = v-diasize-need-full-display
     3592       .
     3593       assign
     3594         v-diasize-need-full-display = false
     3595       .
     3596     end.
     3597   end procedure.
     3598   procedure get-context :
     3599      define output parameter p-db-num as integer          no-undo.
     3600      define output parameter p-user-id as character        no-undo.
     3601      define variable v-login               as character    no-undo.
     3602      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3603      define buffer buf_user-login  for ub.user-login .
     3604      do
     3605      on error undo, return error
     3606      :
     3607            FIND FIRST buf_sys-ctrl no-lock.
     3608            ASSIGN
     3609               v-login = USERID("ub")
     3610               p-db-num = buf_sys-ctrl.db-num
     3611            .
     3612            FIND FIRST buf_user-login
     3613                 WHERE buf_user-login.db-num = p-db-num
     3614                   AND buf_user-login.user-login = v-login
     3615                 no-lock
     3616                 no-error
     3617                 .
     3618            IF AVAILABLE buf_user-login
     3619            THEN DO:
     3620               assign
     3621                  p-user-id = buf_user-login.user-id
     3622               .
     3623            END.
     3624      end.
     3625   end procedure.
     3626       run diasize_init in this-procedure .
     3627   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3628   do:
     3629     Contr-List :SET-REPOSITIONED-ROW(15, "CONDITIONAL") .
     3630   end.
     3631   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3632   on ' ' of sch-date in frame Dialog-Frame
     3633   do:
     3634     if (can-query (self, "sensitive")
     3635        and
     3636        self :sensitive = true
     3637        )
     3638     or (can-query (self, "read-only")
     3639        and
     3640        self :read-only = false
     3641        )
     3642     then do:
     3643       assign
     3644         self :screen-value = ?
     3645       .
     3646     end.
     3647     return no-apply.
     3648   end.
     3649   on delete-character of sch-date in frame Dialog-Frame
     3650   do:
     3651     if (can-query (self, "sensitive")
     3652        and
     3653        self :sensitive = true
     3654        )
     3655     or (can-query (self, "read-only")
     3656        and
     3657        self :read-only = false
     3658        )
     3659     then do:
     3660       assign
     3661         self :screen-value = ?
     3662       .
     3663     end.
     3664     return no-apply.
     3665   end.
     3666   on ctrl-d of sch-date in frame Dialog-Frame
     3667   do:
     3668     define variable v-curr-sv-date as date no-undo .
     3669     if (can-query (self, "sensitive")
     3670        and
     3671        self :sensitive = true
     3672        )
     3673     or (can-query (self, "read-only")
     3674        and
     3675        self :read-only = false
     3676        )
     3677     then do:
     3678       if self :handle <> focus :handle
     3679       then do:
     3680         apply "entry":u to self .
     3681       end.
     3682       run gbl/getcurdt.p
     3683         (output v-curr-sv-date
     3684         ) .
     3685       assign
     3686         self :screen-value = string(v-curr-sv-date) .
     3687       .
     3688     end.
     3689     return no-apply.
     3690   end.
     3691   on ctrl-b of sch-date in frame Dialog-Frame
     3692   do:
     3693     if (can-query (self, "sensitive")
     3694        and
     3695        self :sensitive = true
     3696        )
     3697     or (can-query (self, "read-only")
     3698        and
     3699        self :read-only = false
     3700        )
     3701     then do:
     3702       if self :handle <> focus :handle
     3703       then do:
     3704         apply "entry":u to self .
     3705       end.
     3706       define variable v-curr-sv-date as date no-undo .
     3707       define variable v-new-sv-date  as date no-undo .
     3708       assign
     3709         v-curr-sv-date = date(self :screen-value) no-error
     3710       .
     3711       if v-curr-sv-date = ?
     3712       then do:
     3713         run gbl/getcurdt.p
     3714           (output v-curr-sv-date
     3715           ) .
     3716       end.
     3717       if v-curr-sv-date <> ?
     3718       then do:
     3719         assign
     3720           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3721         .
     3722         assign
     3723           self :screen-value = string(v-new-sv-date) .
     3724         .
     3725       end.
     3726     end.
     3727     return no-apply .
     3728   end.
     3729   on ctrl-e of sch-date in frame Dialog-Frame
     3730   do:
     3731     if (can-query (self, "sensitive")
     3732        and
     3733        self :sensitive = true
     3734        )
     3735     or (can-query (self, "read-only")
     3736        and
     3737        self :read-only = false
     3738        )
     3739     then do:
     3740       if self :handle <> focus :handle
     3741       then do:
     3742         apply "entry":u to self .
     3743       end.
     3744       define variable v-curr-sv-date as date no-undo .
     3745       define variable v-new-sv-date  as date no-undo .
     3746       assign
     3747         v-curr-sv-date = date(self :screen-value) no-error
     3748       .
     3749       if v-curr-sv-date = ?
     3750       then do:
     3751         run gbl/getcurdt.p
     3752           (output v-curr-sv-date
     3753           ) .
     3754       end.
     3755       if v-curr-sv-date <> ?
     3756       then do:
     3757         run gbl/lastdate.p
     3758           (input  v-curr-sv-date
     3759           ,output v-new-sv-date
     3760           ).
     3761         assign
     3762           self :screen-value = string(v-new-sv-date) .
     3763         .
     3764       end.
     3765     end.
     3766     return no-apply .
     3767   end.
     3768   on ctrl-f of sch-date in frame Dialog-Frame
     3769   do:
     3770     if (can-query (self, "sensitive")
     3771        and
     3772        self :sensitive = true
     3773        )
     3774     or (can-query (self, "read-only")
     3775        and
     3776        self :read-only = false
     3777        )
     3778     then do:
     3779       if self :handle <> focus :handle
     3780       then do:
     3781         apply "entry":u to self .
     3782       end.
     3783       define variable v-ok            as logical   no-undo .
     3784       define variable v-curr-sv-date  as date      no-undo .
     3785       define variable v-description   as character no-undo .
     3786       assign
     3787         v-curr-sv-date = date(self :screen-value) no-error
     3788       .
     3789       if v-curr-sv-date = ?
     3790       then do:
     3791         run gbl/getcurdt.p
     3792           (output v-curr-sv-date
     3793           ) .
     3794       end.
     3795       if v-curr-sv-date <> ?
     3796       then do:
     3797         run gbl/d-inpday.w
     3798           (input ?
     3799           ,input "Выбор даты"
     3800           ,input v-description
     3801           ,input ""
     3802           ,input-output v-curr-sv-date
     3803           ,output v-ok
     3804           ).
     3805         if v-ok = true
     3806         then do:
     3807           assign
     3808             self :screen-value = string(v-curr-sv-date) .
     3809           .
     3810         end.
     3811       end.
     3812     end.
     3813     return no-apply .
     3814   end.
     3815     define MENU m-ed-date30
     3816       MENU-ITEM m-ed-date30-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     3817       MENU-ITEM m-ed-date30-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     3818       MENU-ITEM m-ed-date30-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     3819       MENU-ITEM m-ed-date30-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     3820       .
     3821     if sch-date :POPUP-MENU in frame Dialog-Frame = ?
     3822     then do:
     3823       ASSIGN
     3824         sch-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date30 :HANDLE
     3825         sch-date :MENU-MOUSE in frame Dialog-Frame = 3
     3826       .
     3827     end.
     3828     define variable v-label-handle30 as handle no-undo .
     3829     assign
     3830       v-label-handle30 = sch-date :side-label-handle in frame Dialog-Frame
     3831     .
     3832     if valid-handle (v-label-handle30)
     3833     then do:
     3834       if v-label-handle30 :tooltip = ""
     3835       or v-label-handle30 :tooltip = ?
     3836       then do:
     3837         assign
     3838           v-label-handle30 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     3839         .
     3840       end.
     3841     end.
     3842     ON CHOOSE OF MENU-ITEM m-ed-date30-1 in menu m-ed-date30 DO:
     3843       apply "ctrl-b":U to sch-date in frame Dialog-Frame .
     3844     END.
     3845     ON CHOOSE OF MENU-ITEM m-ed-date30-2 in menu m-ed-date30 DO:
     3846       apply "ctrl-d":U to sch-date in frame Dialog-Frame .
     3847     END.
     3848     ON CHOOSE OF MENU-ITEM m-ed-date30-3 in menu m-ed-date30 DO:
     3849       apply "ctrl-e":U to sch-date in frame Dialog-Frame .
     3850     END.
     3851     ON CHOOSE OF MENU-ITEM m-ed-date30-4 in menu m-ed-date30 DO:
     3852       apply "ctrl-f":U to sch-date in frame Dialog-Frame .
     3853     END.
     3854   def var sort-labelContr-List   as character no-undo .
     3855   def var sort-clmnContr-List    as handle    no-undo .
     3856   def var cur-clmnContr-List     as handle    no-undo .
     3857   def var cur-clmn-locContr-List as integer   no-undo .
     3858   def var re-queryContr-List     as logical   initial no no-undo .
     3859   on start-search, ctrl-o of Contr-List in frame Dialog-Frame do:
     3860      run sort-brContr-List
     3861        (input (if available buf_contract
     3862                then recid(buf_contract)
     3863                else ?
     3864               )
     3865        ).
     3866   end.
     3867   PROCEDURE sort-brContr-List :
     3868     define input parameter p-recid as recid no-undo .
     3869     if re-queryContr-List = no then do:
     3870       assign
     3871          cur-clmnContr-List = Contr-List:current-column in frame Dialog-Frame
     3872       .
     3873       if sort-clmnContr-List <> ? then sort-clmnContr-List:column-fgcolor = 0.
     3874       if cur-clmnContr-List = sort-clmnContr-List then do:
     3875         assign
     3876            sort-labelContr-List = ""
     3877            sort-clmnContr-List = ?
     3878         .
     3879        end.
     3880        else do:
     3881          assign
     3882            sort-labelContr-List = cur-clmnContr-List:label
     3883            sort-clmnContr-List  = cur-clmnContr-List
     3884            sort-clmnContr-List:column-fgcolor = 4
     3885          .
     3886        end.
     3887      end.
     3888     assign
     3889       cur-clmn-locContr-List = 1
     3890     .
     3891     def var column-handle as handle no-undo .
     3892     column-handle = Contr-List:first-column.
     3893     do while valid-handle(column-handle) :
     3894       if column-handle = cur-clmnContr-List then do:
     3895         leave .
     3896       end.
     3897       column-handle = column-handle:NEXT-COLUMN.
     3898       assign
     3899         cur-clmn-locContr-List = cur-clmn-locContr-List + 1
     3900       .
     3901     end.
     3902     case sort-labelContr-List:
     3903           when 'Ста!тус'  then DO:    assign       sort-column-name = "buf_contract.status_"     .     run OpenBr(yes, no, no).   . END.
     3904           when 'Номер'  then DO:    assign       sort-column-name = "buf_contract.contract-prn-code"     .     run OpenBr(yes, no, no).   . END.
     3905           when 'Дата!договора'  then DO:    assign       sort-column-name = "buf_contract.contract-date"     .     run OpenBr(yes, no, no).   . END.
     3906           when 'Заголовок'  then DO:    assign       sort-column-name = "buf_contract.contract-name"     .     run OpenBr(yes, no, no).   . END.
     3907           when 'Тип/код!контрагента'  then DO:    assign       sort-column-name = "(if buf_contract.cli-type = '' then '' else TRIM (buf_contract.cli-type + ' ' + STRING (buf_contract.cli-code) ))"     .     run OpenBr(yes, no, no).   . END.
     3908           when 'Контрагент'  then DO:    assign       sort-column-name = "buf_contract.cli-name"     .     run OpenBr(yes, no, no).   . END.
     3909           when 'Тип договора'  then DO:    assign       sort-column-name = "buf_contract.contract-type"     .     run OpenBr(yes, no, no).   . END.
     3910           when 'Условия!оплаты'  then DO:    assign       sort-column-name = "buf_contract.usl-opl"     .     run OpenBr(yes, no, no).   . END.
     3911           when 'Отс-!роч.'  then DO:    assign       sort-column-name = "(if buf_contract.srok-opl > 0 then string(buf_contract.srok-opl) else '')"     .     run OpenBr(yes, no, no).   . END.
     3912           when 'Город'  then DO:    assign       sort-column-name = "buf_contract.contract-city"     .     run OpenBr(yes, no, no).   . END.
     3913           when 'Начало!действия'  then DO:    assign       sort-column-name = "buf_contract.contract-date-beg"     .     run OpenBr(yes, no, no).   . END.
     3914           when 'Окончание!действия'  then DO:    assign       sort-column-name = "buf_contract.contract-date-end"     .     run OpenBr(yes, no, no).   . END.
     3915           when 'Тип/код!посредника'  then DO:    assign       sort-column-name = "(if buf_contract.posr-type = '' then '' else TRIM (buf_contract.posr-type + ' ' + STRING (buf_contract.posr-code)))"     .     run OpenBr(yes, no, no).   . END.
     3916           when 'Посредник'  then DO:    assign       sort-column-name = "buf_contract.posr-name"     .     run OpenBr(yes, no, no).   . END.
     3917           when 'Тип/код!агента'  then DO:    assign       sort-column-name = "(if buf_contract.agnt-type = '' then '' else TRIM (buf_contract.agnt-type + ' ' + STRING (buf_contract.agnt-code)))"     .     run OpenBr(yes, no, no).   . END.
     3918           when 'Агент'  then DO:    assign       sort-column-name = "buf_contract.agnt-name"     .     run OpenBr(yes, no, no).   . END.
     3919           when 'Вид'  then DO:    assign       sort-column-name = "buf_contract.doc-type"     .     run OpenBr(yes, no, no).   . END.
     3920           when 'Вн.н.'  then DO:    assign       sort-column-name = "buf_contract.contract-code"     .     run OpenBr(yes, no, no).   . END.
     3921           when 'БД'  then DO:    assign       sort-column-name = "buf_contract.db-num"     .     run OpenBr(yes, no, no).   . END.
     3922           when 'Вал'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-currency&1, &1&2&1)', chr(34), buf_contract.curr-code)     .     run OpenBr(yes, no, no).   . END.
     3923           when 'Исполнитель'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-agent&1, &1&2&1)', chr(34), buf_contract.mngr-code)     .     run OpenBr(yes, no, no).   . END.
     3924           when 'Фин.об.'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fo&1, &1&2&1, &1&3&1, &1&4&1)', chr(34), buf_contract.cr-fo, buf_contract.fo-date, buf_contract.need-fo)     .     run OpenBr(yes, no, no).   . END.
     3925       otherwise do:
     3926         assign
     3927           sort-column-name = ""
     3928         .
     3929         run OpenBr(yes, no, no).
     3930           if can-do( this-procedure:internal-entries, 'mv-brw-defaultContr-List') then do:
     3931             run mv-brw-defaultContr-List.
     3932           end.
     3933         if sort-labelContr-List <> "" then do:
     3934           assign
     3935             cur-clmnContr-List:column-fgcolor = 0
     3936           .
     3937         end.
     3938         assign
     3939           cur-clmn-locContr-List = ?
     3940         .
     3941       end.
     3942     end case.
     3943       if cur-clmn-locContr-List <> ? then do:
     3944         if can-do( this-procedure:internal-entries, 'ch-clmnContr-List') then do:
     3945           run ch-clmnContr-List in this-procedure (cur-clmn-locContr-List).
     3946         end.
     3947       end.
     3948     if p-recid <> ? then do:
     3949       reposition Contr-List to recid p-recid no-error.
     3950       apply "value-changed" to Contr-List in frame Dialog-Frame.
     3951     end.
     3952     apply "entry" to Contr-List in frame Dialog-Frame.
     3953   END PROCEDURE.
     3954   procedure re-open-query-srt-clmnContr-List:
     3955   if cur-clmnContr-List = ? then do:
     3956      run OpenBr(yes, no, no).
     3957   end.
     3958   else do:
     3959      assign re-queryContr-List = yes.
     3960      run sort-brContr-List
     3961        (input (if available buf_contract
     3962                then recid(buf_contract)
     3963                else ?
     3964               )
     3965        ).
     3966      assign re-queryContr-List = no.
     3967   end.
     3968   end.
