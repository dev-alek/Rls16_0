      965   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
      966   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      967   FUNCTION Can-Find-Spec RETURN LOGICAL (
      968      INPUT iHost-Code    AS INTEGER,
      969      INPUT iContract-Num AS INTEGER,
      970      INPUT iGds-Code     AS INTEGER ):
      971      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
      972      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
      973      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
      974      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      975      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
      976      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      977          INPUT  iHost-Code,
      978          INPUT  iContract-Num,
      979          OUTPUT iTmp-Extent3
      980          ).
      981      IF iTmp-Extent3[1] = 2 THEN DO:
      982         ASSIGN
      983            iTmp-Host-Code      = iTmp-Extent3[2]
      984            iTmp-Contract-Num   = iTmp-Extent3[3]
      985            .
      986      END. ELSE DO:
      987         ASSIGN
      988            iTmp-Host-Code      = iHost-Code
      989            iTmp-Contract-Num   = iContract-Num
      990            .
      991      END.
      992      IF iGds-Code = ? THEN DO:
      993         ASSIGN
      994            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      995                                  buf_Spec.Host-Code     = iTmp-Host-Code
      996                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      997                           ).
      998      END. ELSE DO:
      999            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1000                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1001                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1002                              AND buf_Spec.Gds-Code      = iGds-Code
     1003                            ).
     1004      END.
     1005      RETURN (lRet).
     1006   END FUNCTION.
     1007   PROCEDURE MS-Contract-EXTENT-3:
     1008      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1009      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1010      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1011      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1012      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1013      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1014      FIND FIRST buf_Cont-2 WHERE
     1015                 buf_Cont-2.Host-Code      = i-Host-Code
     1016             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1017           NO-LOCK NO-ERROR.
     1018      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1019         RETURN.
     1020      END.
     1021      FOR FIRST buf_Ext-Classif WHERE
     1022                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1023           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1024                                               STRING(i-Contract-code)
     1025           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1026          NO-LOCK,
     1027          EACH buf_Cont WHERE
     1028               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1029           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1030          NO-LOCK:
     1031          ASSIGN
     1032             i-Ret[1] = 1
     1033             i-Ret[2] = buf_Cont.Host-code
     1034             i-Ret[3] = buf_Cont.Contract-code
     1035             .
     1036          LEAVE.
     1037      END.
     1038      IF i-Ret[1] <> 1 THEN DO:
     1039         FOR FIRST buf_Ext-Classif WHERE
     1040                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1041              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1042                                                  STRING(i-Contract-code)
     1043              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1044             NO-LOCK,
     1045             EACH buf_Cont WHERE
     1046                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1047              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1048             NO-LOCK:
     1049             ASSIGN
     1050                i-Ret[1] = 2
     1051                i-Ret[2] = buf_Cont.Host-code
     1052                i-Ret[3] = buf_Cont.Contract-code
     1053                .
     1054             LEAVE.
     1055         END.
     1056      END.
     1057      RETURN.
     1058   END PROCEDURE.
     1059   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1060   DEFINE VARIABLE v-gl-UVEDOMLENIE as CHARACTER NO-UNDO INITIAL "Uvedomlenie":U.
     1061   FUNCTION Get-Contract-Attr RETURN CHARACTER(
     1062            INPUT iHost-Code AS INTEGER,
     1063            INPUT iContract-Code  AS INTEGER,
     1064            INPUT cAttr-code      AS CHARACTER):
     1065      DEFINE BUFFER buf_Contract-Attr FOR ub.Contract-Attr.
     1066      FIND FIRST buf_Contract-Attr WHERE
     1067                 buf_Contract-Attr.Host-code     = iHost-Code
     1068             AND buf_Contract-Attr.Contract-code = iContract-Code
     1069             AND buf_Contract-Attr.Attr-code     = cAttr-code
     1070           NO-LOCK NO-ERROR.
     1071      RETURN (IF AVAILABLE buf_Contract-Attr THEN buf_Contract-Attr.Attr-value ELSE ?).
     1072   END FUNCTION.
     1073   PROCEDURE Modify-Contract-Attr:
     1074      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     1075      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     1076      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     1077      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     1078      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     1079      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     1080      Tran:
     1081      DO TRANSACTION
     1082         ON ENDKEY UNDO Tran, RETRY Tran
     1083         ON ERROR  UNDO Tran, RETRY Tran
     1084         ON QUIT   UNDO Tran, RETRY Tran
     1085         ON STOP   UNDO Tran, RETRY Tran:
     1086         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1087         FIND FIRST buf_Contract-Attr WHERE
     1088                    buf_Contract-Attr.Host-Code      = iHost-Code
     1089                AND buf_Contract-Attr.Contract-Code  = iContract-Code
     1090                AND buf_Contract-Attr.Attr-code      = cAttr-code
     1091              NO-LOCK NO-ERROR.
     1092         IF NOT AVAILABLE buf_Contract-Attr THEN DO:
     1093            CREATE buf_Contract-Attr NO-ERROR.
     1094            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1095         END. ELSE DO:
     1096            FIND CURRENT buf_Contract-Attr EXCLUSIVE-LOCK NO-ERROR.
     1097            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1098         END.
     1099         ASSIGN
     1100            buf_Contract-Attr.Host-Code      = iHost-Code
     1101            buf_Contract-Attr.Contract-Code  = iContract-Code
     1102            buf_Contract-Attr.Attr-code      = cAttr-code
     1103            buf_Contract-Attr.Attr-value     = cAttr-value
     1104            NO-ERROR.
     1105         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1106         RELEASE buf_Contract-Attr NO-ERROR.
     1107         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1108      END.
     1109      RETURN.
     1110   END PROCEDURE.
     1111   PROCEDURE Create-Contract-Attr:
     1112      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     1113      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     1114      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     1115      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     1116      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     1117      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     1118      Tran:
     1119      DO TRANSACTION
     1120         ON ENDKEY UNDO Tran, RETRY Tran
     1121         ON ERROR  UNDO Tran, RETRY Tran
     1122         ON QUIT   UNDO Tran, RETRY Tran
     1123         ON STOP   UNDO Tran, RETRY Tran:
     1124         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1125         CREATE buf_Contract-Attr NO-ERROR.
     1126         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1127         ASSIGN
     1128            buf_Contract-Attr.Host-Code      = iHost-Code
     1129            buf_Contract-Attr.Contract-Code  = iContract-Code
     1130            buf_Contract-Attr.Attr-code      = cAttr-code
     1131            buf_Contract-Attr.Attr-value     = cAttr-value
     1132            NO-ERROR.
     1133         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1134         RELEASE buf_Contract-Attr NO-ERROR.
     1135         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1136      END.
     1137      RETURN.
     1138   END PROCEDURE.
     1139   FUNCTION Is-MS-Contract RETURN LOGICAL(BUFFER buf_Master FOR ub.Contract, BUFFER buf_Slave  FOR ub.Contract) FORWARD.
     1140   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract) FORWARD.
     1141   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract) FORWARD.
     1142   PROCEDURE Delete-Contract-Specif:
     1143      DEFINE PARAMETER BUFFER buf_Contract FOR ub.Contract.
     1144      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1145      DEFINE BUFFER buf_Specif      FOR ub.Contract-Specif.
     1146      DEFINE BUFFER buf_Specif-Attr FOR ub.Contract-Specif-Attr.
     1147      Tran:
     1148      DO TRANSACTION
     1149         ON ENDKEY UNDO Tran, RETRY Tran
     1150         ON ERROR  UNDO Tran, RETRY Tran
     1151         ON QUIT   UNDO Tran, RETRY Tran
     1152         ON STOP   UNDO Tran, RETRY Tran:
     1153         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1154         FOR EACH buf_Specif-Attr WHERE
     1155                  buf_Specif-Attr.Host-code     = buf_Contract.Host-code
     1156              AND buf_Specif-Attr.Contract-Num  = buf_Contract.Contract-code
     1157             EXCLUSIVE-LOCK:
     1158             DELETE buf_Specif-Attr NO-ERROR.
     1159             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1160         END.
     1161         FOR EACH buf_Specif WHERE
     1162                  buf_Specif.Host-code     = buf_Contract.Host-code
     1163              AND buf_Specif.Contract-Num  = buf_Contract.Contract-code
     1164             EXCLUSIVE-LOCK:
     1165             DELETE buf_Specif NO-ERROR.
     1166            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1167         END.
     1168      END.
     1169      RETURN.
     1170   END PROCEDURE.
     1171   PROCEDURE Modify-Slave-Contract:
     1172      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1173      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1174      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1175      DEFINE BUFFER buf_Slave FOR ub.Contract.
     1176      Tran:
     1177      DO TRANSACTION
     1178         ON ENDKEY UNDO Tran, RETRY Tran
     1179         ON ERROR  UNDO Tran, RETRY Tran
     1180         ON QUIT   UNDO Tran, RETRY Tran
     1181         ON STOP   UNDO Tran, RETRY Tran:
     1182         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1183         FOR EACH buf_Ext-Classif WHERE
     1184                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1185              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1186              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1187             NO-LOCK,
     1188             FIRST buf_Slave WHERE
     1189                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1190               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1191             EXCLUSIVE-LOCK:
     1192             BUFFER-COPY
     1193               buf_Master
     1194             EXCEPT
     1195               Host-code                               Contract-code                           Own-name                                an-uchet-code-out                       cel-nazn-code-out                       cor-acc-out                             cor-acc1-out                            an-uchet-code-in                        cel-nazn-code-in                        cor-acc-in                              cor-acc1-in                             an-uchet-code-out-cash                  cel-nazn-code-out-cash                  cor-acc-out-cash                        cor-acc1-out-cash                       an-uchet-code-in-cash                   cel-nazn-code-in-cash                   cor-acc-in-cash                         cor-acc1-in-cash                        an-uchet-code-out-payoff                cel-nazn-code-out-payoff                cor-acc-out-payoff                      cor-acc1-out-payoff                     an-uchet-code-in-payoff                 cel-nazn-code-in-payoff                 cor-acc-in-payoff                       cor-acc1-in-payoff                      transport-cli-type                      transport-cli-code                      transport-host                          transport-contract                      transport-uslov                         transport-value                         own-code-schet-start                    own-sign-post                           own-sign                                contract-city                           fin-VAT-pc                              srok-opl                                gen-factur-srok                         own-addres                              own-inn                                 own-kpp
     1196             TO buf_Slave
     1197             NO-ERROR.
     1198             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1199             RELEASE buf_Slave NO-ERROR.
     1200             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1201         END.
     1202      END.
     1203      RETURN.
     1204   END PROCEDURE.
     1205   PROCEDURE Change-Stat-Slave-Contract:
     1206      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1207      DEFINE INPUT PARAMETER cStatus  AS CHARACTER NO-UNDO.
     1208      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1209      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1210      DEFINE BUFFER buf_Slave FOR ub.Contract.
     1211      Tran:
     1212      DO TRANSACTION
     1213         ON ENDKEY UNDO Tran, RETRY Tran
     1214         ON ERROR  UNDO Tran, RETRY Tran
     1215         ON QUIT   UNDO Tran, RETRY Tran
     1216         ON STOP   UNDO Tran, RETRY Tran:
     1217         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1218         FOR EACH buf_Ext-Classif WHERE
     1219                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1220              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1221              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1222             NO-LOCK,
     1223             FIRST buf_Slave WHERE
     1224                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1225               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1226             EXCLUSIVE-LOCK:
     1227             ASSIGN
     1228                buf_Slave.Status_ = cStatus
     1229                NO-ERROR.
     1230             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1231             RELEASE buf_Slave NO-ERROR.
     1232             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1233         END.
     1234      END.
     1235      RETURN.
     1236   END PROCEDURE.
     1237   PROCEDURE Delete-Ref-Master-Slave:
     1238      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1239      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     1240      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1241      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1242      IF NOT Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     1243         cError = PROGRAM-NAME(1) + ":" + "Между договорами нет связи Master->Slave".
     1244         RETURN.
     1245      END.
     1246      Tran:
     1247      FOR FIRST buf_Ext-Classif WHERE
     1248                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1249            AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1250            AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1251            AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1252          EXCLUSIVE-LOCK
     1253          TRANSACTION
     1254          ON ENDKEY UNDO Tran, RETRY Tran
     1255          ON ERROR  UNDO Tran, RETRY Tran
     1256          ON QUIT   UNDO Tran, RETRY Tran
     1257          ON STOP   UNDO Tran, RETRY Tran:
     1258          IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1259          DELETE buf_Ext-Classif NO-ERROR.
     1260          IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1261      END.
     1262      RETURN.
     1263   END PROCEDURE.
     1264   PROCEDURE Create-Ref-Master-Slave:
     1265      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1266      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     1267      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1268      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1269      DEFINE VARIABLE cKeyRec AS CHARACTER NO-UNDO INITIAL "".
     1270      IF Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     1271         cError = PROGRAM-NAME(1) + ":" + "Между договорами  уже есть связь Master->Slave".
     1272         RETURN.
     1273      END.
     1274      RUN gen-key-rec IN THIS-PROCEDURE(
     1275          INPUT  v-S_CONTRACT,
     1276          INPUT  BUFFER buf_Master:HANDLE,
     1277          OUTPUT cKeyRec
     1278          ) NO-ERROR.
     1279      IF ERROR-STATUS:ERROR THEN DO:
     1280         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
     1281         RETURN.
     1282      END.
     1283      Tran:
     1284      DO TRANSACTION
     1285         ON ENDKEY UNDO Tran, RETRY Tran
     1286         ON ERROR  UNDO Tran, RETRY Tran
     1287         ON QUIT   UNDO Tran, RETRY Tran
     1288         ON STOP   UNDO Tran, RETRY Tran:
     1289         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1290         CREATE buf_Ext-Classif NO-ERROR.
     1291         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1292         ASSIGN
     1293            buf_Ext-Classif.Classif-name    = v-S_CONTRACT
     1294            buf_Ext-Classif.Classif-subject = v-S_CONTRACT
     1295            buf_Ext-Classif.CharKey_One     = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1296            buf_Ext-Classif.CharKey_Two     = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1297            buf_Ext-Classif.DB-num          = buf_Master.Db-num
     1298            buf_Ext-Classif.Uniq-key-rec    = cKeyRec
     1299            NO-ERROR.
     1300         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1301         RELEASE buf_Ext-Classif NO-ERROR.
     1302         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1303      END.
     1304      RETURN.
     1305   END PROCEDURE.
     1306   FUNCTION Is-MS-Contract-Int-2 RETURN INTEGER (
     1307                                 i-Host-Code AS INTEGER,
     1308                                 i-Contract-Code AS INTEGER):
     1309      DEFINE BUFFER buf_Contract FOR ub.Contract.
     1310      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     1311      FIND FIRST buf_Contract WHERE
     1312                 buf_Contract.Host-Code      = i-Host-Code
     1313             AND buf_Contract.Contract-code  = i-Contract-Code
     1314           NO-LOCK NO-ERROR.
     1315      IF AVAILABLE buf_Contract THEN DO:
     1316         ASSIGN
     1317            iRet = Is-MS-Contract-Int(BUFFER buf_Contract).
     1318      END.
     1319      RETURN (iRet).
     1320   END FUNCTION.
     1321   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract):
     1322      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1323      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1324      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     1325      FOR FIRST buf_Ext-Classif WHERE
     1326                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1327           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1328                                               STRING(buf_Contract.contract-code)
     1329           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1330          NO-LOCK,
     1331          EACH buf_Cont WHERE
     1332               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1333           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1334          NO-LOCK:
     1335          ASSIGN
     1336             iRet = 1.
     1337          LEAVE.
     1338      END.
     1339      IF iRet <> 1 THEN DO:
     1340         FOR FIRST buf_Ext-Classif WHERE
     1341                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1342              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1343                                                  STRING(buf_Contract.contract-code)
     1344              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1345             NO-LOCK,
     1346             EACH buf_Cont WHERE
     1347                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1348              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1349             NO-LOCK:
     1350             ASSIGN
     1351                iRet = 2.
     1352             LEAVE.
     1353         END.
     1354      END.
     1355      RETURN (iRet).
     1356   END FUNCTION.
     1357   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract):
     1358      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1359      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1360      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     1361      FOR FIRST buf_Ext-Classif WHERE
     1362                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1363           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1364                                               STRING(buf_Contract.contract-code)
     1365           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1366          NO-LOCK,
     1367          EACH buf_Cont WHERE
     1368               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1369           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1370          NO-LOCK:
     1371          ASSIGN
     1372             cRet = "+".
     1373          LEAVE.
     1374      END.
     1375      IF cRet = "" THEN DO:
     1376         FOR FIRST buf_Ext-Classif WHERE
     1377                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1378              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1379                                                  STRING(buf_Contract.contract-code)
     1380              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1381             NO-LOCK,
     1382             EACH buf_Cont WHERE
     1383                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1384              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1385             NO-LOCK:
     1386             ASSIGN
     1387                cRet = (IF buf_Cont.Contract-prn-code = "" THEN  STRING(buf_Cont.Contract-code) ELSE buf_Cont.Contract-prn-code).
     1388             LEAVE.
     1389         END.
     1390      END.
     1391      RETURN (cRet).
     1392   END FUNCTION.
     1393   FUNCTION Is-MS-Contract RETURN LOGICAL(
     1394            BUFFER buf_Master FOR ub.Contract,
     1395            BUFFER buf_Slave  FOR ub.Contract):
     1396      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1397      RETURN CAN-FIND ( FIRST buf_Ext-Classif WHERE
     1398                          buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1399                      AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1400                      AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1401                      AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1402                    NO-LOCK).
     1403   END FUNCTION.
     1404   FUNCTION Get-Num-Slave-Contract RETURN CHARACTER(
     1405            BUFFER buf_Master FOR ub.Contract,
     1406            INPUT iSlave-Host-Code AS INTEGER
     1407            ):
     1408      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1409      DEFINE BUFFER buf_Contract    FOR ub.Contract.
     1410      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     1411      FIND FIRST buf_Ext-Classif WHERE
     1412                 buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1413             AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1414             AND buf_Ext-Classif.CharKey_Two  BEGINS STRING(iSlave-Host-Code) + v-DELIM_CHR_3
     1415             AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1416           NO-LOCK NO-ERROR.
     1417      IF AVAILABLE buf_Ext-Classif THEN DO:
     1418         IF CAN-FIND (FIRST buf_Contract WHERE
     1419                            buf_Contract.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1420                        AND buf_Contract.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1421                       NO-LOCK) THEN DO:
     1422            ASSIGN
     1423               cRet = ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3).
     1424         END. ELSE DO:
     1425            ASSIGN
     1426               cRet = "ERROR:" + "Ошибка связи мастер договора " +
     1427                      STRING(buf_Master.Host-Code) + "," + STRING(buf_Master.Contract-code) + " " +
     1428                      "c Host-code=" + STRING(iSlave-Host-Code).
     1429         END.
     1430      END.
     1431      RETURN (cRet).
     1432   END FUNCTION.
     1433   define NEW SHARED  buffer buf_contract for ub.contract.
     1434   define new shared variable br-handle as handle  no-undo .
     1435   define new shared variable next-prev as logical no-undo .
     1436   define variable p-contr-type as character no-undo .
     1437   function fo return character ( input p-cr-fo as logical, input p-fo-date as date, input p-need-fo as integer ) .
     1438    if p-cr-fo = yes then do:
     1439      return string (p-fo-date, "99/99/99").
     1440    end.
     1441    else do:
     1442      if p-need-fo = 0 then return "--------".
     1443      if p-need-fo = 1 then return "".
     1444      if p-need-fo = 2 then return "не опред".
     1445    end.
     1446   end function.
