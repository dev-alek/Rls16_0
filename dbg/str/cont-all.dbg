      711   define output parameter p-prop-label-list as character no-undo .
      712   define output parameter p-global          as logical no-undo .
      713   define output parameter p-host           as logical no-undo .
      714   define output parameter p-shop           as logical no-undo .
      715   define output parameter p-store          as logical no-undo .
      716   define output parameter p-db             as logical no-undo .
      717   define output parameter p-region         as logical no-undo .
      718   do
      719   on error undo, return error return-value
      720   :
      721       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      722       (input  p-upper-code
      723       ,input  p-code
      724       ,output p-label
      725       ,output p-user-can-edit
      726       ,output p-output-display
      727       ,output p-other
      728       ,output p-prop-list
      729       ,output p-prop-type-list
      730       ,output p-prop-label-list
      731       ,output p-global
      732       ,output p-host
      733       ,output p-shop
      734       ,output p-store
      735       ,output p-db
      736       ,output p-region
      737       ) no-error .
      738     if error-status :error
      739     then do:
      740       undo, return error substitute( "&1. &2&3&4", vss-include-info8, return-value, chr(10), error-status :get-message (1)).
      741     end.
      742   end.
      743   end procedure.
