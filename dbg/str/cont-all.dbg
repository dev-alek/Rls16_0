     1741   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1742   DO:
     1743     if not avail buf_contract then return no-apply.
     1744   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1745   do:
     1746     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1747       (input  v-cntxt-db-num
     1748       ,input  v-cntxt-userid
     1749       ,input  0
     1750       ,input  'actn_fin-contract_update':U
     1751       ,input  'firm':U
     1752       ,input  p-host-code
     1753       ,input  '':U
     1754       ,input  0
     1755       ,input  0
     1756       ,input  0
     1757       ,input  0
     1758       ,input  true
     1759       ,output g-log
     1760       )  .
     1761   end.
     1762     if not g-log then return no-apply .
     1763     ASSIGN
     1764        iTmp = Is-MS-Contract-Int (BUFFER buf_Contract).
     1765     CASE iTmp:
     1766          WHEN 1 THEN DO:
