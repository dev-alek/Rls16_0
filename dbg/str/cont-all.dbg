     4099     if v-right-supp = false or v-right-buyer = false  then return .
     4100     RUN enable_UI in this-procedure .
     4101     RUN StartProc in this-procedure.
     4102     apply "entry" to Contr-List .
     4103   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4104   DEF VAR cur-clmn-numContr-List as INT EXTENT 20 no-undo.
     4105   DEF VAR varmviContr-List       as INT no-undo.
     4106   DEF VAR varmvjContr-List       as INT no-undo.
     4107   DEF VAR varmvkContr-List       as INT no-undo.
     4108   DEF VAR varmvlContr-List       as INT no-undo.
     4109   DEF VAR move-elementContr-List as INT no-undo.
     4110   def var jjContr-List           as int no-undo.
     4111   do varmviContr-List = 1 to EXTENT(cur-clmn-numContr-List):
     4112     ASSIGN cur-clmn-numContr-List[varmviContr-List] = varmviContr-List.
     4113   END.
     4114   RUN start-mv-clmnContr-List.
     4115   PROCEDURE start-mv-clmnContr-List:
     4116   def var old-session as logical no-undo.
     4117      old-session = SESSION:IMMEDIATE-DISPLAY.
     4118      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4119      SESSION:IMMEDIATE-DISPLAY = old-session.
     4120   END.
     4121   ON ctrl-cursor-right OF BROWSE Contr-List do:
     4122     RUN re-move-clmnContr-List ( 5, 20).
     4123   END.
     4124   ON ctrl-cursor-left OF BROWSE Contr-List do:
     4125     RUN re-move-clmnContr-List (20, 5).
     4126   END.
     4127   PROCEDURE re-move-clmnContr-List:
     4128     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4129     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4130     DO varmviContr-List = 1 TO EXTENT(cur-clmn-numContr-List):
     4131       if cur-clmn-numContr-List[varmviContr-List] = source-column THEN cur-clmn-numContr-List[varmviContr-List] = -1.
     4132     END.
     4133     if Contr-List:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4134     if source-column > target-column THEN
     4135     DO varmvjContr-List = source-column - 1 to target-column BY -1:
     4136       DO varmviContr-List = 1 TO EXTENT(cur-clmn-numContr-List):
     4137           if cur-clmn-numContr-List[varmviContr-List] = varmvjContr-List THEN DO:
     4138             cur-clmn-numContr-List[varmviContr-List] = cur-clmn-numContr-List[varmviContr-List] + 1.
     4139           END.
     4140       END.
     4141     END.
     4142     ELSE
     4143     DO varmvjContr-List = source-column + 1 to target-column:
     4144       DO varmviContr-List = 1 TO EXTENT(cur-clmn-numContr-List):
     4145         if cur-clmn-numContr-List[varmviContr-List] = varmvjContr-List THEN DO:
     4146           cur-clmn-numContr-List[varmviContr-List] = cur-clmn-numContr-List[varmviContr-List] - 1.
     4147         END.
     4148       END.
     4149     END.
     4150     DO varmviContr-List = 1 TO EXTENT(cur-clmn-numContr-List):
     4151       if cur-clmn-numContr-List[varmviContr-List] = -1 THEN cur-clmn-numContr-List[varmviContr-List] = target-column.
     4152     END.
     4153   END PROCEDURE.
     4154   PROCEDURE ch-clmnContr-List:
     4155     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4156     if cur-clmn-loc <= 5 then do:
     4157       return .
     4158     end.
     4159     DO varmviContr-List = 1 TO EXTENT(cur-clmn-numContr-List):
     4160       if cur-clmn-numContr-List[varmviContr-List] = cur-clmn-loc THEN move-elementContr-List = varmviContr-List.
     4161     END.
     4162     RUN re-move-clmnContr-List (cur-clmn-loc, 5).
     4163   END PROCEDURE.
     4164   PROCEDURE mv-brw-defaultContr-List:
     4165   def var old-session as logical no-undo.
     4166     old-session = SESSION:IMMEDIATE-DISPLAY.
     4167     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4168     do varmvlContr-List = 5 to EXTENT(cur-clmn-numContr-List):
     4169       RUN re-move-clmnContr-List (cur-clmn-numContr-List[varmvlContr-List], varmvlContr-List).
     4170     END.
     4171     RUN start-mv-clmnContr-List.
     4172     SESSION:IMMEDIATE-DISPLAY = old-session.
     4173   END PROCEDURE.
     4174   .
     4175     WAIT-FOR GO OF FRAME Dialog-Frame.
     4176   END.
     4177   RUN disable_UI in this-procedure .
     4178   PROCEDURE disable_UI :
     4179     HIDE FRAME Dialog-Frame.
     4180   END PROCEDURE.
     4181   PROCEDURE enable_UI :
     4182     DISPLAY sch-code sch-date Cli-Types Agnt-Types Cli-Status mark-num
     4183         WITH FRAME Dialog-Frame.
