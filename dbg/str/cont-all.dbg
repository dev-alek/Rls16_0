     7599         return no-apply.
     7600       end.
     7601       if can-find(first ub.contract no-lock where
     7602                         ub.contract.host-code = buf_contract.host-code
     7603                     AND ub.contract.cli-type = buf_contract.cli-type
     7604                     AND ub.contract.cli-code = buf_contract.cli-code
     7605                     and ub.contract.contract-type = 'Продажи через ТПСИ':U
     7606                     and ub.contract.status_       = 'тек':U
     7607                     ) then do:
     7608           message
     7609           "Нельзя открыть договор типа <Продажа через ТПСИ>," skip
     7610           "уже есть действующий договор этого типа с фирмой" buf_contract.cli-code
     7611           view-as alert-box error .
     7612           return error .
     7613       end.
