     7715   PROCEDURE proc-b-exp :
     7716     define variable v-file-name as character no-undo .
     7717     if not available buf_contract then return no-apply.
     7718     define variable v-sys-key   as character         no-undo.
     7719   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     7720   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     7721     (output v-sys-key
     7722     ) no-error .
     7723     assign  v-file-name =  ? .
     7724     run str/xmlcontr.p (input buf_contract.host-code, buf_contract.contract-code, input-output v-file-name, yes, yes) no-error .
     7725     if error-status:error then do:
     7726       message   "Ошибка при выгрузке платежа в XML-формате"  view-as alert-box .
     7727       return error .
     7728     end.
     7729     if search ("exmldoc.bat") <> ? then do:
     7730       os-command silent value(search ("exmldoc.bat") + " " + v-file-name + " " + v-sys-key).
     7731     end.
     7732     else do:
     7733       if search (v-file-name ) <> ? then message "Документ(-ы) выгружен(-ы) в файл " v-file-name view-as alert-box.
     7734     end.
     7735   END PROCEDURE.
     7736   PROCEDURE proc-b-imp :
     7737   define variable mFileName         as character        no-undo.
     7738   define variable vFileName         as character no-undo.
     7739   define variable v-log-file-name   as character no-undo .
     7740   define variable v-last-slash-pos  as integer no-undo .
     7741   define variable varlog            as logical   no-undo.
     7742   define variable mExcelApplication as component-handle no-undo.
     7743   define variable mWorkBook         as component-handle no-undo.
     7744   define variable mWorkSheet        as component-handle no-undo.
     7745   define variable mRange            as component-handle no-undo .
     7746     system-dialog get-file mFileName title "Выберите файл с ценами поставки"
     7747       filters "MS Excel (*.xls,*.xlsx)" "*.xls,*.xlsx",
     7748               "Все файлы" "*.*"
     7749       initial-filter 1
     7750       must-exist
     7751       update varlog.
     7752     if not varlog then return error "Отказ от импорта" .
     7753     ASSIGN
     7754       FILE-INFO:FILE-NAME = mFileName
     7755       vFilename           = FILE-INFO:FULL-PATHNAME
     7756     .
     7757     IF LENGTH(vFileName) > 0 THEN .
     7758     ELSE RETURN ERROR SUBSTITUTE("Не найден файл &1", mFileName).
     7759     v-last-slash-pos = max (
     7760       r-index(vFilename, "/"),
     7761       r-index(vFilename, "\")
     7762                            ) .
     7763     v-log-file-name  = substitute("&1&2.log"
     7764       , ibs.th.gbl.gbl-inipar:logDir
     7765       , entry(1, substring(vFileName, v-last-slash-pos + 1), ".")
     7766                                   ) .
     7767     empty temp-table t-imp-price .
     7768     create "Excel.Application":U mExcelApplication no-error.
     7769       if error-status :error then do:
     7770           message
     7771           "Ошибка при запуске Excel" skip
     7772           error-status :get-message(1) skip
     7773           view-as alert-box error .
     7774           undo, return error .
     7775       end.
     7776     assign
     7777       mExcelApplication:DisplayAlerts = no
     7778       mWorkbook                       = mExcelApplication:WorkBooks:Add(vFileName)
     7779       mWorkSheet                      = mWorkbook:Sheets:Item(1)
     7780     .
     7781     define variable vLine   as integer   no-undo.
     7782     define variable vsContractCode as character no-undo .
     7783     define variable vContractCode  as integer no-undo .
     7784     define variable vsFirmCode     as character no-undo .
     7785     define variable vFirmCode      as integer no-undo .
     7786     define variable vsGdsCode      as character no-undo .
     7787     define variable vGdsCode       as integer no-undo .
     7788     define variable vsPriceRubl    as character no-undo .
     7789     define variable vPriceRubl     as decimal no-undo .
     7790     define variable vsVatPc        as character no-undo .
     7791     define variable vVatPc         as decimal no-undo .
     7792     define variable vsPrcUp        as character no-undo .
     7793     define variable vPrcUp         as decimal no-undo .
     7794     define variable vsPrcDn        as character no-undo .
     7795     define variable vPrcDn         as decimal no-undo .
     7796     define variable vsGdsName      as character no-undo .
     7797     define variable vsFirmName     as character no-undo .
     7798     loopbl:
     7799     do vLine = 2 to 1000000:
     7800       mRange = mWorkSheet:Range(  substitute("A&1":U, vLine)  ) .
     7801       vsContractCode = mRange:formula .
     7802       mRange = mWorkSheet:Range(  substitute("B&1":U, vLine)  ) .
     7803       vsFirmCode     = mRange:formula .
     7804       mRange = mWorkSheet:Range(  substitute("C&1":U, vLine)  ) .
     7805       vsGdsCode      = mRange:formula .
     7806       assign
     7807         vContractCode = integer (vsContractCode)
     7808         vFirmCode     = integer (vsFirmCode)
     7809         vGdsCode      = integer (vsGdsCode)
     7810       no-error .
     7811       if (not error-status:error) and (vContractCode > 0) and (vFirmCode > 0) and (vGdsCode > 0) then .
     7812       else leave loopbl.
     7813       mRange = mWorkSheet:Range(  substitute("D&1":U, vLine)  ) .
     7814       vPriceRubl     = mRange:value no-error .
     7815       if vPriceRubl = ? then assign
     7816         vsPriceRubl = mRange:formula
     7817         vPriceRubl  = func-char-to-dec( vsPriceRubl )
     7818       .
     7819       mRange = mWorkSheet:Range(  substitute("E&1":U, vLine)  ) .
     7820       vVatPc         = mRange:value no-error .
     7821       if vVatPc = ? then assign
     7822         vsVatPc = mRange:formula
     7823         vVatPc  = func-char-to-dec( vsVatPc )
     7824       .
     7825       mRange = mWorkSheet:Range(  substitute("F&1":U, vLine)  ) .
     7826       vPrcUp         = mRange:value no-error .
     7827       if vPrcUp = ? then assign
     7828         vsPrcUp = mRange:formula
     7829         vPrcUp  = func-char-to-dec( vsPrcUp )
     7830       .
     7831       mRange = mWorkSheet:Range(  substitute("G&1":U, vLine)  ) .
     7832       vPrcDn         = mRange:value no-error .
     7833       if vPrcDn = ? then assign
     7834         vsPrcDn = mRange:formula
     7835         vPrcDn  = func-char-to-dec( vsPrcDn )
     7836       .
     7837       mRange = mWorkSheet:Range(  substitute("H&1":U, vLine)  ) .
     7838       vsGdsName = mRange:formula .
     7839       mRange = mWorkSheet:Range(  substitute("I&1":U, vLine)  ) .
     7840       vsFirmName = mRange:formula .
     7841       create t-imp-price .
     7842       assign
     7843         t-imp-price.contract-code = vContractCode
     7844         t-imp-price.firm-code     = vFirmCode
     7845         t-imp-price.gds-code      = vGdsCode
     7846         t-imp-price.price-rubl    = (if vPriceRubl > 0.00000000005 then vPriceRubl else 0)
     7847         t-imp-price.vat-pc        = (if vVatPc     > 0.00000000005 then vVatPc     else 0)
     7848         t-imp-price.prc-up        = (if vPrcUp     > 0.00000000005 then vPrcUp     else 0)
     7849         t-imp-price.prc-dn        = (if vPrcDn     > 0.00000000005 then vPrcDn     else 0)
     7850         t-imp-price.gds-name      = vsGdsName
     7851         t-imp-price.firm-name     = vsFirmName
     7852         t-imp-price.line-num      = vLine
     7853       no-error .
     7854       if error-status:error then leave loopbl.
     7855     end.
     7856     mWorkbook:Close(true) no-error.
     7857     release object mWorkSheet no-error.
     7858     release object mWorkbook no-error.
     7859     mExcelApplication:QUIT() no-error.
     7860     release object mExcelApplication no-error.
     7861   define variable v-today      as date no-undo .
     7862   define variable v-i-retry    as integer no-undo .
     7863   define variable v-prc-min    as decimal no-undo .
     7864   define variable v-num-passed as integer no-undo .
     7865   define variable v-num-count  as integer no-undo .
     7866   define variable v-has-errors as logical no-undo .
     7867   define variable v-is-firm    as logical no-undo .
     7868   define variable v-host-code  as integer no-undo .
     7869   define variable v-contract-code as integer no-undo .
     7870   define buffer imp_buf_contract             for ub.contract .
     7871   define buffer imp_buf_contract-specif      for ub.contract-specif .
     7872   define buffer imp_buf_contract-specif-attr for ub.contract-specif-attr .
     7873   define buffer imp_buf_goods                for ub.goods .
     7874     assign
     7875       v-today      = today
     7876       v-num-passed = 0
     7877       v-num-count  = 0
     7878       v-has-errors = false
     7879     .
     7880     output stream f-log-imp to value (v-log-file-name) .
     7881     for each t-imp-price by t-imp-price.line-num :
     7882       v-num-count = v-num-count + 1 .
     7883       if t-imp-price.price-rubl > 0 then . else do :
     7884         put stream f-log-imp unformatted
     7885            substitute("Ошибка в строке №&1. Не указана/ Равна нулю цена товара с НДС",
     7886                        t-imp-price.line-num)
     7887           skip
     7888         .
     7889         v-has-errors = true .
     7890         next .
     7891       end .
     7892       if not can-find (first imp_buf_goods where imp_buf_goods.gds-code = t-imp-price.gds-code) then do :
     7893         put stream f-log-imp unformatted
     7894            substitute("Ошибка в строке №&1. В Системе отсутствует товар с кодом &2",
     7895                      t-imp-price.line-num, t-imp-price.gds-code)
     7896           skip
     7897         .
     7898         v-has-errors = true .
     7899         next .
     7900       end .
     7901       find first imp_buf_contract no-lock
     7902            where imp_buf_contract.host-code     = p-host-code
     7903              and imp_buf_contract.contract-code = t-imp-price.contract-code no-error .
     7904       if not available imp_buf_contract then do :
     7905         put stream f-log-imp unformatted
     7906            substitute("Ошибка в строке №&1. В Системе не найдено текущего договора с № &2",
     7907                      t-imp-price.line-num, t-imp-price.contract-code)
     7908           skip
     7909         .
     7910         v-has-errors = true .
     7911         next .
     7912       end .
     7913       else do :
     7914         v-host-code     = imp_buf_contract.host-code .
     7915         v-contract-code = imp_buf_contract.contract-code .
     7916       end .
     7917       if not can-find (first clients where clients.obj-code = t-imp-price.firm-code) then do :
     7918         put stream f-log-imp unformatted
     7919            substitute("Ошибка в строке №&1. В Системе отсутствует контрагент с кодом &2",
     7920                      t-imp-price.line-num, t-imp-price.firm-code)
     7921           skip
     7922         .
     7923         v-has-errors = true .
     7924         next .
     7925       end .
     7926       if imp_buf_contract.cli-code <> t-imp-price.firm-code then do :
     7927         put stream f-log-imp unformatted
     7928            substitute("Ошибка в строке №&1. Для договора &2 указан некорректный контрагент &3",
     7929                      t-imp-price.line-num, t-imp-price.contract-code, t-imp-price.firm-code)
     7930           skip
     7931         .
     7932         v-has-errors = true .
     7933         next .
     7934       end .
     7935       if imp_buf_contract.status_ <> 'тек':U then do :
     7936         put stream f-log-imp unformatted
     7937            substitute("Ошибка в строке №&1. Договор &2 закрыт и не подлежит изменению.",
     7938                      t-imp-price.line-num, t-imp-price.contract-code)
     7939           skip
     7940         .
     7941         v-has-errors = true .
     7942         next .
     7943       end .
     7944       if imp_buf_contract.contract-date-end < v-today then do :
     7945         put stream f-log-imp unformatted
     7946            substitute("Ошибка в строке №&1. У договора &2 истёк срок действия &3.",
     7947                      t-imp-price.line-num, t-imp-price.contract-code, imp_buf_contract.contract-date-end)
     7948           skip
     7949         .
     7950         v-has-errors = true .
     7951         next .
     7952       end .
     7953       v-i-retry = 0 .
     7954   do transaction :
     7955       repeat :
     7956         find first imp_buf_contract-specif exclusive-lock
     7957              where imp_buf_contract-specif.host-code    = v-host-code
     7958                and imp_buf_contract-specif.contract-num = v-contract-code
     7959                and imp_buf_contract-specif.gds-code     = t-imp-price.gds-code no-error no-wait .
     7960         if available imp_buf_contract-specif then do :
     7961           if (t-imp-price.prc-dn > 0) then do :
     7962             find first imp_buf_contract-specif-attr exclusive-lock
     7963                  where imp_buf_contract-specif-attr.host-code    = v-host-code
     7964                    and imp_buf_contract-specif-attr.contract-num = v-contract-code
     7965                    and imp_buf_contract-specif-attr.gds-code     = t-imp-price.gds-code
     7966                    and imp_buf_contract-specif-attr.attr-code    = 'prc-min':U no-error .
     7967             if locked imp_buf_contract-specif-attr then do :
     7968               v-i-retry = v-i-retry + 1 .
     7969               if v-i-retry > 5 then leave .
     7970               pause 1 no-message .
     7971               next .
     7972             end .
     7973           end .
     7974           if (t-imp-price.prc-up > 0) and (t-imp-price.prc-dn > 0) then . else do :
     7975             put stream f-log-imp unformatted
     7976                substitute("Ошибка в строке №&1. Допустимый % отклонения равен нулю и остается прежним в Системе.",
     7977                          t-imp-price.line-num)
     7978               skip
     7979             .
     7980             v-has-errors = true .
     7981           end .
     7982           if imp_buf_contract-specif.price-cli <> t-imp-price.price-rubl then assign
     7983              imp_buf_contract-specif.price-cli  = t-imp-price.price-rubl
     7984              imp_buf_contract-specif.sum-cli    = imp_buf_contract-specif.price-cli * imp_buf_contract-specif.qnty
     7985           .
     7986           assign
     7987             imp_buf_contract-specif.VAT-pc      = t-imp-price.vat-pc
     7988       when (imp_buf_contract-specif.VAT-pc     <> t-imp-price.vat-pc)
     7989             imp_buf_contract-specif.prc         = t-imp-price.prc-up
     7990       when (
     7991            (t-imp-price.prc-up > 0) and
     7992            (imp_buf_contract-specif.prc        <> t-imp-price.prc-up)
     7993            )
     7994             v-num-passed = v-num-passed + 1
     7995           .
     7996           if (t-imp-price.prc-dn > 0) and (available imp_buf_contract-specif-attr) then do :
     7997             v-prc-min = decimal (imp_buf_contract-specif-attr.attr-value) no-error .
     7998             assign
     7999               imp_buf_contract-specif-attr.attr-value = string(t-imp-price.prc-dn)
     8000                 when ( v-prc-min <> t-imp-price.prc-dn )
     8001             .
     8002           end .
     8003           leave .
     8004         end .
     8005         else if locked imp_buf_contract-specif then do :
     8006           v-i-retry = v-i-retry + 1 .
     8007           if v-i-retry > 5 then leave .
     8008           pause 1 no-message .
     8009           next .
     8010         end .
     8011         else do :
     8012           put stream f-log-imp unformatted
     8013              substitute("Ошибка в строке №&1. Товар &2 не привязан к договору &3",
     8014                        t-imp-price.line-num, t-imp-price.gds-code, t-imp-price.contract-code)
     8015             skip
     8016           .
     8017           v-has-errors = true .
     8018           leave .
     8019         end .
     8020       end .
     8021   end .
     8022     end .
     8023     output stream f-log-imp close .
     8024   define variable v-user-action as character no-undo .
     8025   define variable v-printed     as logical no-undo .
     8026   define variable r-var1        as character no-undo initial "прочитайте" .
     8027   define variable r-var2        as character no-undo initial "!!!" .
     8028   define variable v-global-panic as character no-undo initial "" .
     8029   if (v-num-passed < v-num-count) or v-has-errors then do :
     8030       case r-var1 :
     8031         when "прочитайте" then do :
     8032       v-global-panic = "При проверке информации произошли ошибки" + r-var2 + chr(10) +
     8033               r-var2 + "Внимательно " + r-var1 + " Log-file" + r-var2 .
     8034         end .
     8035         when "съешьте" then do :
     8036       v-global-panic = "При проверке информации произошли ошибки" + r-var2 + chr(10) +
     8037               r-var2 + "Аккуратно " + r-var1 + " Log-file" + r-var2 .
     8038         end .
     8039         otherwise do :
     8040         end .
     8041       end case .
     8042   end .
     8043   message
     8044    "Статус загрузки - завершена." skip
     8045    substitute ("Обработанно &1 строк из файла импорта, загруженно в систему &2 строк.",
     8046                v-num-count, v-num-passed) skip(1)
     8047    v-global-panic
     8048   view-as alert-box .
     8049   if (v-num-passed < v-num-count) or v-has-errors then do :
     8050       run gbl/prnfilen.w (
     8051             input "Ошибки, возникшие при проверке импортируемого файла":U
     8052           , input 7
     8053           , input v-log-file-name
     8054           , input 7
     8055           , output v-user-action
     8056           , output v-printed
     8057       ).
     8058   end .
     8059   END PROCEDURE.
     8060   FUNCTION get-agent RETURNS CHARACTER
     8061     ( input agnt-code as integer ) :
     8062   define variable var-cli-name as character no-undo.
     8063   define buffer buf_clients for ub.clients.
     8064     find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = agnt-code no-error .
     8065     if available buf_clients then assign var-cli-name = STRING (agnt-code) + "   " + TRIM (buf_clients.obj-name) .
     8066   RETURN var-cli-name.
     8067   END FUNCTION.
     8068   FUNCTION func-char-to-dec RETURNS DECIMAL (iCh AS CHARACTER):
     8069       DEFINE VARIABLE vI       AS INTEGER   NO-UNDO.
     8070       DEFINE VARIABLE vCh      AS CHARACTER NO-UNDO.
     8071       DEFINE VARIABLE vNumeric AS CHARACTER NO-UNDO.
     8072       DEFINE VARIABLE vResult  AS DECIMAL   NO-UNDO.
     8073       IF LENGTH(iCh) > 0 THEN
     8074       DO:
     8075           DO vI = 1 TO LENGTH(iCh):
     8076               vCh = SUBSTRING(iCh, vI, 1).
     8077               IF INDEX("-+0123456789,.":U, vCh) > 0 THEN
     8078                   vNumeric = vNumeric + vCh.
     8079           END.
     8080           ASSIGN
     8081               vNumeric = REPLACE(vNumeric,
     8082                                   SESSION:NUMERIC-SEPARATOR,
     8083                                   SESSION:NUMERIC-DECIMAL-POINT)
     8084               vResult  = DECIMAL(vNumeric)
     8085               NO-ERROR.
     8086       END.
     8087       ELSE vResult = 0.
     8088       RETURN vResult.
     8089   END FUNCTION.
     8090   FUNCTION get-currency RETURNS CHARACTER
     8091     ( input curr-code as integer ) :
     8092   define variable var-curr-name as character no-undo.
     8093   define buffer buf_currency for ub.currency.
     8094     find first buf_currency no-lock where buf_currency.curr-code = curr-code no-error .
     8095     if available buf_currency then assign var-curr-name = buf_currency.curr-abbr .
     8096   RETURN var-curr-name.
     8097   END FUNCTION.
     8098   FUNCTION mark-string RETURNS CHARACTER
     8099     ( input par-recid as recid, input mark-list as character ) :
     8100   RETURN ( IF LOOKUP( STRING( par-recid ), mark-list ) > 0 THEN "*" ELSE "":U ).
     8101   END FUNCTION.
