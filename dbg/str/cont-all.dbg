     2184     run fltfield-add in this-procedure('contract-type', 'Тип', 'contract-type',   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2185     run fltfield-add in this-procedure('usl-opl', 'Условия генерации ФО', 'usl-opl', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2186     run fltfield-add in this-procedure('str-uslov-oplat', 'Условия оплаты', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2187     run fltfield-add in this-procedure('srok-opl', 'Отсрочка', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2188     run fltfield-add in this-procedure('contract-name', 'Заголовок', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2189     run fltfield-add in this-procedure('contract-city', 'Город', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2190     run fltfield-add in this-procedure('contract-date-beg', 'Дата начала договора', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2191     run fltfield-add in this-procedure('contract-date-end', 'Дата конца договора', '',  input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2192     run fltfield-add in this-procedure('curr-code', 'Валюта', 'curr',  input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2193     run fltfield-add in this-procedure('user-name', 'Имя оператора', 'usr',                input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2194     run fltfield-add in this-procedure('cli-type*cli-code'  , 'Контрагент' , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2195     run fltfield-add in this-procedure('posr-type*posr-code'  , 'Посредник' , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2196     run fltfield-add in this-procedure('agnt-type*agnt-code'  , 'Агент' , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2197   Filter-Block:
     2198   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     2199       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     2200       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     2201     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     2202     RUN OpenBr(yes, no, '':U).
     2203   END.
     2204   END.
     2205   ON CHOOSE OF b-SlaveContract IN FRAME Dialog-Frame
     2206   DO:
     2207     DEFINE VARIABLE v-cError AS CHARACTER NO-UNDO INITIAL "".
     2208     DEFINE VARIABLE iTmp     AS INTEGER   NO-UNDO INITIAL 0.
     2209     IF AVAILABLE buf_Contract THEN DO:
     2210     ASSIGN
     2211        iTmp = Is-MS-Contract-Int (BUFFER buf_Contract).
     2212        IF iTmp = 2 THEN DO:
     2213           MESSAGE
     2214               "Текущий договор является подчиненным !" SKIP
     2215               "Нельзя привязывать к подчиненному договору другие договора !" SKIP
     2216               VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2217           RETURN NO-APPLY.
     2218        END.
     2219        IF iTmp = 0 AND buf_contract.status_ = 'зкр':U THEN DO:
     2220           MESSAGE
     2221               "Договор уже закрыт !"
     2222               VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2223           RETURN NO-APPLY.
     2224        END.
     2225        RUN str/cont-slave.w  (
     2226            input  parparentproc,
     2227            "",
     2228            ""  ,
     2229            input  p-host-code,
     2230            BUFFER buf_Contract,
     2231            OUTPUT v-cError
     2232            ) NO-ERROR.
     2233        IF ERROR-STATUS:ERROR THEN DO:
     2234           MESSAGE ERROR-STATUS:GET-MESSAGE(1) RETURN-VALUE VIEW-AS ALERT-BOX.
     2235        END.
     2236        IF v-cError <> "" THEN DO:
     2237           MESSAGE v-cError VIEW-AS ALERT-BOX.
     2238        END.
     2239        Contr-list:REFRESH().
     2240     END.
     2241   END.
     2242   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     2243   DO:
     2244     if b-mark:sensitive = no or p-rid-list = "" then do:
     2245       if available buf_contract then p-rid-list = string( recid( buf_contract ) ) .
     2246     end.
     2247   END.
     2248   ON VALUE-CHANGED OF Cli-Status IN FRAME Dialog-Frame
     2249   DO:
     2250     assign Cli-Status .
     2251     case Cli-Status :
     2252       when "all"     then assign p-status = ? .
     2253       when "current" then assign p-status = 'тек':U .
     2254       when "deleted" then assign p-status = 'зкр':U .
     2255     end.
     2256     RUN OpenBr(yes, no, '':U).
     2257     apply "entry" to Contr-List .
     2258   END.
     2259   ON VALUE-CHANGED OF Cli-Types IN FRAME Dialog-Frame
     2260   DO:
     2261     assign Cli-Types .
     2262     if Cli-Types = "sel" then do:
     2263       run ref/cli-all.w (parParentProc, "b-sel", 'орг':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,":u, "without-obj":U, output org-list ) .
     2264       if org-list = "" then do:
     2265         assign Cli-Types = "all" .
     2266         disp Cli-Types with frame Dialog-Frame.
     2267       end.
     2268       else do:
     2269         find first ub.clients no-lock where recid(ub.clients) = int(org-list) no-error .
     2270         assign
     2271           p-cli-type = ub.clients.obj-type
     2272           p-cli-code = ub.clients.obj-code
     2273         .
     2274       end.
     2275     end .
     2276     RUN OpenBr(yes, no, '':U).
     2277   END.
     2278   ON value-changed OF Contr-List IN FRAME Dialog-Frame
     2279   DO:
     2280     if available buf_contract then do:
     2281       assign
     2282         user-name = usrfulnf(buf_contract.user-name)
     2283       .
     2284       disp user-name with frame Dialog-Frame.
     2285     end.
     2286   END.
     2287   ON RETURN OF Contr-List IN FRAME Dialog-Frame
     2288   or MOUSE-SELECT-DBLCLICK OF Contr-List IN FRAME Dialog-Frame
     2289   DO:
     2290     if b-sel:sensitive in frame Dialog-Frame then do:
     2291       if b-mark:sensitive then apply "choose" to b-mark in frame Dialog-Frame.
     2292       else                     apply "choose" to b-sel in frame Dialog-Frame.
     2293     end.
     2294     else if B-lkp:sensitive then apply "choose" to B-lkp in frame Dialog-Frame.
     2295   END.
     2296   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     2297   DO:
     2298     run proc-find-code  in this-procedure(yes, input frame Dialog-Frame sch-code ) no-error.
     2299     if error-status:error then return no-apply.
     2300   END.
     2301   ON RETURN OF sch-code IN FRAME Dialog-Frame
     2302   DO:
     2303     run proc-find-code  in this-procedure(no, input frame Dialog-Frame sch-code ) no-error.
     2304     if error-status:error then return no-apply.
     2305   END.
     2306   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     2307   DO:
     2308     run proc-find-date in this-procedure(yes, input frame Dialog-Frame sch-date) no-error.
     2309     if error-status:error then return no-apply.
     2310   END.
     2311   ON RETURN OF sch-date IN FRAME Dialog-Frame
     2312   DO:
     2313     run proc-find-date in this-procedure(no, input frame Dialog-Frame sch-date) no-error.
     2314     if error-status:error then return no-apply.
     2315   END.
     2316   b-gen:menu-mouse = 1.
