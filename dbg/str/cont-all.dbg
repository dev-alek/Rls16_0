     7483       (input  v-cntxt-db-num
     7484       ,input  v-cntxt-userid
     7485       ,input  0
     7486       ,input  'actn_fo-mc_master-open-close':U
     7487       ,input  'firm':U
     7488       ,input  p-host-code
     7489       ,input  '':U
     7490       ,input  0
     7491       ,input  0
     7492       ,input  0
     7493       ,input  0
     7494       ,input  true
     7495       ,output g-log
     7496       )  .
     7497   end.
     7498                  if not g-log then return no-apply.
     7499            END.
     7500            WHEN 2 THEN DO:
     7501   define variable vss-include-info74 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7502   do:
     7503     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7504       (input  v-cntxt-db-num
     7505       ,input  v-cntxt-userid
     7506       ,input  0
     7507       ,input  'actn_fo-mc_slave-open-close':U
     7508       ,input  'firm':U
     7509       ,input  p-host-code
     7510       ,input  '':U
