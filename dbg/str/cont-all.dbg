     1992   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1993   DO:
     1994     if available buf_contract then   do:
     1995       if can-do( p-rid-list, string( recid( buf_contract ) ) ) then  do:
     1996               p-rid-list = replace( p-rid-list, chr(44) + string( recid( buf_contract ) ), "") .
     1997               p-rid-list = replace( p-rid-list, string( recid( buf_contract ) ) + chr(44), "") .
     1998               p-rid-list = replace( p-rid-list, string( recid( buf_contract ) ), "") .
     1999       end.
     2000       else  p-rid-list = p-rid-list + ( if p-rid-list = "" then "" else chr(44) ) + string( recid( buf_contract ) ) .
     2001       g-log = Contr-List:refresh() .
     2002       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
     2003         g-log = Contr-List:select-next-row ().
     2004         apply "value-changed" to Contr-List in frame Dialog-Frame.
     2005       end.
     2006       if num-entries( p-rid-list ) = 0 then hide mark-num in frame Dialog-Frame.
     2007       else   display num-entries( p-rid-list ) @ mark-num  with frame Dialog-Frame.
     2008     end.
     2009     apply "entry" to Contr-List .
     2010   END.
     2011   ON CHOOSE OF b-open IN FRAME Dialog-Frame
     2012   DO:
     2013     if not avail buf_contract then return no-apply.
     2014     run proc-open in this-procedure no-error .
