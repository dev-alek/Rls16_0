     2023   ON ROW-DISPLAY OF  Contr-List IN FRAME Dialog-Frame
     2024   DO:
     2025     if available buf_contract then do:
     2026        if buf_contract.contract-date-end < today then do:
     2027           buf_contract.contract-date-end:bgcolor  in browse Contr-List =  8.
     2028           buf_contract.status_:bgcolor  in browse Contr-List =  8.
     2029           buf_contract.contract-prn-code:bgcolor  in browse Contr-List =  8.
     2030           buf_contract.contract-date:bgcolor  in browse Contr-List =  8.
     2031           v-type:bgcolor  in browse Contr-List =  8.
     2032           buf_contract.contract-name:bgcolor  in browse Contr-List =  8.
     2033           buf_contract.cli-name:bgcolor  in browse Contr-List =  8.
     2034        end.
     2035        else do:
     2036           buf_contract.contract-date-end:bgcolor  in browse Contr-List =  ?.
     2037           buf_contract.status_:bgcolor  in browse Contr-List =  ?.
     2038           buf_contract.contract-prn-code:bgcolor  in browse Contr-List =  ?.
     2039           buf_contract.contract-date:bgcolor  in browse Contr-List =  ?.
     2040           buf_contract.contract-name:bgcolor  in browse Contr-List =  ?.
     2041           buf_contract.cli-name:bgcolor  in browse Contr-List =  ?.
     2042           v-type:bgcolor  in browse Contr-List =  ?.
     2043        end.
     2044     end.
     2045   END.
     2046   PROCEDURE proc-m_gen-1 :
     2047     do on error undo, return error return-value :
     2048       if p-rid-list = "" then do:
     2049         if available buf_contract then assign p-rid-list = string(recid(buf_contract)).
     2050         else do:
     2051           return error "Не выделено ни одного договора для генерации ФО !". .
     2052         end.
     2053       end.
     2054       define buffer bf_contract for ub.contract.
     2055       g-log = yes.
     2056       message "Выбрано " + string( num-entries( p-rid-list)  ) + " договоров . Провести генерацию ФО ?" skip
     2057       view-as alert-box question buttons OK-Cancel update g-log.
     2058       if not g-log then return no-apply.
     2059       define variable res as character no-undo .
     2060       run str/gen-flsp.p ( INPUT parParentProc, input p-host-code, input ?, input 0, input p-rid-list, input-output res) no-error .
     2061       if error-status:error then  message "Ошибка создания ФО " view-as alert-box.
     2062       if  res <> "" then message res view-as alert-box information .
     2063       assign p-rid-list = "" .
     2064       RUN OpenBr(yes, no, '':U) .
     2065     end.
     2066   end procedure.
     2067   PROCEDURE proc-m_gen-2 :
     2068   define buffer bf_contract for ub.contract.
     2069   do on error undo, return error return-value
     2070   :
     2071       if p-rid-list = "" then do:
     2072         if available buf_contract then assign p-rid-list = string(recid(buf_contract)).
     2073       end.
     2074   vari-cycle:
     2075     do vari = 1 to num-entries (p-rid-list):
     2076       find first bf_contract where recid(bf_contract) = integer(entry (vari, p-rid-list)) exclusive-lock.
     2077       if bf_contract.status_ <> 'тек':U then do:
     2078         message "Договор " bf_contract.contract-prn-code " не в статусе " 'тек':U " . Пропускаем." view-as alert-box.
     2079         next vari-cycle.
     2080       end.
     2081       if bf_contract.cr-fo = yes then do:
     2082         message "По договору " bf_contract.contract-prn-code " уже создавалось ФО от " bf_contract.fo-date " числа." view-as alert-box.
     2083         next vari-cycle.
     2084       end.
     2085       else do:
     2086         if bf_contract.need-fo = 1 or bf_contract.need-fo = 2 then assign  bf_contract.need-fo = 0.
     2087         else do:
     2088           message "Данный договор не нуждался в генерации ФО." view-as alert-box.
     2089           next vari-cycle.
     2090         end.
     2091         reposition Contr-List to recid recid(bf_contract) no-error.
     2092         if not error-status:error then do:
     2093         end.
     2094       end.
     2095     end.
     2096     assign p-rid-list = "".
     2097   end.
     2098   end procedure.
     2099   PROCEDURE proc-m_gen-3 :
     2100   define buffer bf_contract for ub.contract.
     2101   define buffer buf_fin-ob-trn for ub.fin-ob-trn.
     2102   do on error undo, return error return-value
     2103   :
     2104     if p-rid-list = "" then do:
     2105       if available buf_contract then assign p-rid-list = string(recid(buf_contract)).
     2106     end.
     2107   vari-cycle:
     2108     do vari = 1 to num-entries (p-rid-list):
     2109       find first bf_contract where recid(bf_contract) = integer(entry (vari, p-rid-list)) exclusive-lock.
     2110       if bf_contract.status_ <> 'тек':U then do:
     2111         message "Договор " bf_contract.contract-prn-code " не в статусе " 'тек':U " . Пропускаем." view-as alert-box.
     2112         next vari-cycle.
     2113       end.
     2114       find first buf_fin-ob-trn no-lock
     2115         where buf_fin-ob-trn.host-code      = p-host-code
     2116           and buf_fin-ob-trn.doc-type       = "spc"
     2117           and buf_fin-ob-trn.trn-doc-code   = string(bf_contract.contract-code)
     2118       no-error .
     2119       if bf_contract.cr-fo = yes or available buf_fin-ob-trn then do:
     2120         assign g-log = no.
     2121         message "По договору " bf_contract.contract-prn-code " было создано ФО от " bf_contract.fo-date " . Для правильной работы удалите его или создайте корректирующее ФО!" skip
     2122                   "Вы действительно хотите снять признак, что по этому договору было ФО?"
     2123         view-as alert-box question buttons yes-no update g-log.
     2124         if g-log <> yes then  next vari-cycle.
     2125         assign
     2126           bf_contract.cr-fo   = no
     2127           bf_contract.fo-date = 01/01/1990
     2128         .
     2129         reposition Contr-List to recid recid(bf_contract) no-error.
     2130       end.
     2131       else do:
     2132         message "По договору " bf_contract.contract-prn-code " не было генерации."
     2133         view-as alert-box.
     2134      end.
     2135    end.
     2136    assign p-rid-list = "".
     2137   end.
     2138   end procedure.
     2139   PROCEDURE proc-m_gen-4 :
     2140     do on error undo, return error return-value :
     2141       if p-rid-list = "" then do:
     2142         if available buf_contract then assign p-rid-list = string(recid(buf_contract)).
     2143       end.
     2144       define buffer bf_contract for ub.contract.
     2145   vari-cycle:
     2146       do vari = 1 to num-entries (p-rid-list):
     2147         find first bf_contract where recid(bf_contract) = integer(entry (vari, p-rid-list)) exclusive-lock.
     2148         if bf_contract.status_ <> 'тек':U then do:
     2149           message "Договор " bf_contract.contract-prn-code " не в статусе " 'тек':U " . Пропускаем."  view-as alert-box.
     2150           next.
     2151         end.
     2152         if bf_contract.need-fo = 2  then do:
     2153           assign bf_contract.need-fo = 1  .
     2154           reposition Contr-List to recid recid(bf_contract) no-error.
     2155         end.
     2156         else do:
     2157           message "Договор " bf_contract.contract-prn-code "не имеет признака 'не опред' генерация ФО."
     2158           view-as alert-box.
     2159           next vari-cycle.
     2160         end.
     2161       end.
     2162       assign p-rid-list = "" .
     2163     end.
     2164   end procedure.
