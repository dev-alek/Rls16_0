     7361   PROCEDURE proc-find-code :
     7362     define input parameter p-next as logical no-undo.
     7363     define input parameter p-code as character no-undo .
     7364     display "  /  /":U @ sch-date with frame Dialog-Frame.
     7365     assign p-code = chr(34) + p-code + chr(34).
     7366     if p-code = '""' then do:
     7367       run OpenBr in this-procedure
     7368         (input false
     7369         ,input p-next
     7370         ,input substitute("and buf_contract.contract-prn-code = '' " )
     7371       ).
     7372     end.
     7373     else do:
     7374       run OpenBr in this-procedure
     7375         (input false
     7376         ,input p-next
     7377         ,input substitute("and buf_contract.contract-prn-code  begins &1 "
     7378         , p-code)
     7379         ).
     7380     end.
     7381     apply "entry":u to sch-code in frame Dialog-Frame .
     7382   END PROCEDURE.
     7383   PROCEDURE proc-find-date :
     7384     define input parameter p-next as logical no-undo.
     7385     define input parameter par-date as date    no-undo .
     7386     display "":U @ sch-code with frame Dialog-Frame.
     7387     define variable var-datechr as character no-undo .
     7388     assign var-datechr = string(day(par-date)) + chr(47) + string(month(par-date)) + chr(47) + string(year(par-date)) .
     7389     run OpenBr in this-procedure (input false ,input p-next ,input substitute("and buf_contract.contract-date = &1 ", var-datechr)).
     7390     apply "entry":u to sch-date in frame Dialog-Frame .
     7391   END PROCEDURE.
     7392   PROCEDURE StartProc :
     7393     DEFINE VARIABLE v-hdl AS HANDLE NO-UNDO .
     7394     DISABLE
     7395       b-sel   when  NOT can-do( bttns, "b-sel" )
     7396       b-mark  when  NOT can-do( bttns, "b-mark")
     7397       b-add   when (NOT can-do( bttns, "b-add" ) or p-doc-type = "all")
     7398       b-chg   when  NOT can-do( bttns, "b-chg" )
     7399       b-del   when  NOT can-do( bttns, "b-del" )
     7400       b-open  when  NOT can-do( bttns, "b-open")
     7401       b-SlaveContract when v-MS-Can-Do-List = "1"
     7402     WITH FRAME Dialog-Frame.
     7403     if p-doc-type <> 'при':U then DISABLE b-gen WITH FRAME Dialog-Frame.
     7404     define variable v-db-num  as integer no-undo .
     7405     define variable v-ret as logical no-undo .
     7406   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7407   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     7408     (output v-db-num
     7409     )  .
     7410     run ver-db (input p-host-code,  input v-db-num, input false, output v-ret ) no-error .
     7411     if error-status :error or v-ret = false then do:
     7412        disable   B-fin-ob    B-fin-doc  b-specgrp   with frame Dialog-Frame.
     7413     end.
     7414     if mark-num = 0 then hide mark-num in frame Dialog-Frame.
     7415     if p-rid-list <> "":U then assign v-doc-rec = integer(entry(1, p-rid-list)) .
     7416     p-contr-type = chr(1) .
     7417     if num-entries(p-mode,"=") = 2 then do:
     7418        if entry(1,p-mode,"=") = "contract-type" then do:
     7419           p-contr-type = entry(2,p-mode,"=") .
     7420        end.
     7421     end.
     7422     IF v-iMcMode = 0 THEN DO:
     7423        v-hdl = Contr-list:FIRST-COLUMN .
     7424        DO WHILE VALID-HANDLE(v-hdl):
     7425            IF v-hdl:LABEL = 'Мастер!Договор':U THEN v-hdl:VISIBLE = NO.
     7426               v-hdl = v-hdl:NEXT-COLUMN .
     7427        END.
     7428        ASSIGN
     7429           b-SlaveContract:HIDDEN = TRUE.
     7430     END.
     7431     Run OpenBR in this-procedure (yes, no, '':U) no-error  .
     7432   END PROCEDURE.
     7433   PROCEDURE run-contr :
     7434   define input parameter p-stat as character no-undo .
     7435   define input parameter p-fict as logical   no-undo .
     7436     define variable v-doc-tp as character no-undo .
     7437     define variable ri as recid no-undo .
     7438     if p-stat <> 'ДОБАВЛЕНИЕ':U then do:
     7439       assign
     7440         ri = recid( buf_contract )
     7441         v-doc-tp = buf_contract.doc-type
     7442       .
     7443     end.
     7444     else assign v-doc-tp = p-doc-type .
     7445     if p-stat = 'ПРОСМОТР':U then do:
     7446       br-handle = Contr-List:handle in frame Dialog-Frame .
     7447       next-prev = no.
     7448       do while next-prev <> ?:
     7449         if not available buf_contract then do:
     7450           message "Неправильный выбор документа.".
     7451           return.
     7452         end.
     7453         run str/contr.w ( input parParentProc,input p-host-code, input p-stat, input v-doc-tp, input-output ri) no-error.
     7454         if error-status:error then return no-apply.
     7455         if br-handle = ? then reposition Contr-List to recid ri no-error.
     7456       end.
     7457     end.
     7458     else do:
     7459       if p-contr-type = chr(1) then
     7460          run str/contr.w ( input parParentProc,input p-host-code, input p-stat, input v-doc-tp, input-output ri) no-error.
     7461       else
     7462          run str/contr.w ( input parParentProc,input p-host-code, input p-stat, input "contract-type=" + p-contr-type, input-output ri) no-error.
     7463       if error-status:error then return no-apply.
     7464     end.
     7465     v-doc-rec = ri .
     7466     run openbr in this-procedure (yes, no, '':u).
     7467   END PROCEDURE.
     7468   procedure proc-del :
     7469     DEFINE VARIABLE v-cError as CHARACTER NO-UNDO INITIAL "".
     7470     DEFINE VARIABLE iTmp        as INTEGER   NO-UNDO INITIAL 0.
     7471     do on error undo, return error return-value :
     7472       if buf_contract.status_ = 'зкр':U then do:
     7473         message "Договор уже закрыт!" view-as alert-box.
     7474         return .
     7475       end.
     7476       ASSIGN
     7477          iTmp = Is-MS-Contract-Int (BUFFER buf_Contract).
     7478       CASE iTmp:
     7479            WHEN 1 THEN DO:
     7480   define variable vss-include-info73 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
