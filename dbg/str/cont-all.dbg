     7572             END.
     7573          END.
     7574       end.
     7575     end.
     7576   end procedure.
     7577   procedure proc-sel-agent :
     7578     do on error undo, return error return-value :
     7579       run ref/cli-all.w ( parParentProc, "b-sel", 'чел':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,":u, "without-obj":U, output agnt-list ) .
     7580       if agnt-list = "" then do:
     7581         assign Agnt-Types = "all"  .
     7582         DISPLAY Agnt-Types with frame Dialog-Frame .
     7583       end.
     7584       else do:
     7585         find first ub.clients no-lock where recid(ub.clients) = int(agnt-list) no-error .
     7586         assign
     7587           p-mngr-code = ub.clients.obj-code
     7588           p-mngr-type = ub.clients.obj-type
     7589         .
     7590       end.
     7591     end.
     7592   end procedure.
