      702   procedure thbjattr_code_reg :
      703   define input  parameter p-upper-code     as character no-undo .
      704   define input  parameter p-code           as character no-undo .
      705   define output parameter p-label          as character no-undo .
      706   define output parameter p-user-can-edit  as logical   no-undo .
      707   define output parameter p-output-display as logical   no-undo .
      708   define output parameter p-other          as character no-undo .
