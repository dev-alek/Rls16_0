        1   define input  parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
        2   define input  parameter p-host-code    as integer   no-undo .
        3   define input  parameter bttns          as character no-undo .
        4   define input  parameter p-mode         as character no-undo .
        5   define input  parameter p-cli-type     as character no-undo .
        6   define input  parameter p-cli-code     as integer   no-undo .
        7   define input  parameter p-mngr-type    as character no-undo .
        8   define input  parameter p-mngr-code    as integer   no-undo .
        9   define input  parameter p-status       as character no-undo .
       10   define input  parameter p-doc-type     as character no-undo .
       11   define input-output param p-rid-list   as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":u .
       13   define variable vss-author      as character no-undo init "$Author$":u .
       14   define variable vss-date        as character no-undo init "$Date$":u .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       16   define variable vss-archive     as character no-undo init "$Archive$":u .
       17   define variable vss-description as character no-undo init "Список договоров" .
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   define variable c-point  as character no-undo .
      125   define variable tbl      as character no-undo .
      126   define variable join-tbl as character no-undo .
      127   define variable fld      as character no-undo .
      128   define variable lab      as character no-undo .
      129   define variable spr      as character no-undo .
      130   define variable dim      as character no-undo .
      131   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   procedure fltfield-clear :
      133     define output parameter loc-fld as character no-undo.
      134     define output parameter loc-lab as character no-undo .
      135     define output parameter loc-spr as character no-undo .
      136     define output parameter loc-dim as character no-undo .
      137     assign
      138       loc-fld = ""
      139       loc-lab = ""
      140       loc-spr = ""
      141       loc-dim = "0"
      142     .
      143   end procedure .
      144   procedure fltfield-add :
      145     define input        parameter par-fld as character no-undo.
      146     define input        parameter par-lab as character no-undo .
      147     define input        parameter par-spr as character no-undo .
      148     define input-output parameter loc-fld as character no-undo.
      149     define input-output parameter loc-lab as character no-undo .
      150     define input-output parameter loc-spr as character no-undo .
      151     define input-output parameter loc-dim as character no-undo .
      152     do
      153     on error undo, return error
      154     :
      155       assign
      156       loc-fld = if loc-dim = '0'
      157                 then par-fld
      158                 else (loc-fld + chr(44) + par-fld)
      159       loc-lab = if loc-dim = '0'
      160                 then par-lab
      161                 else (loc-lab + chr(44) + par-lab)
      162       loc-spr = if loc-dim = '0'
      163                 then par-spr
      164                 else (loc-spr + chr(44) + par-spr)
      165       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      166                 string(integer(if num-entries(loc-dim) > 1
      167                               then entry(2, loc-dim)
      168                               else entry(1, loc-dim)
      169                               ) + 1)
      170       no-error
      171       .
      172     end.
      173   end procedure.
      174   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   define variable v-waitfram-action01         as character   no-undo .
      176   define variable v-waitfram-action02         as character   no-undo .
      177   define variable v-waitfram-action03         as character   no-undo .
      178   define variable mWaitFramTextBeg            as character   no-undo.
      179   define variable mWaitFramTextEnd            as character   no-undo.
      180   define variable mWaitFramView               as logical     no-undo.
      181   define variable mWaitProcEvent              as logical     no-undo init yes.
      182   define variable mWaitFramInterval           as integer     no-undo init 1 .
      183   define variable mWaitFramStop               as logical     no-undo.
      184   define variable mWaitFramStopUser           as logical     no-undo.
      185   define variable mWaitFramStopTimeOut        as logical     no-undo.
      186   define variable mWaitFramStartProc          as datetime-tz no-undo.
      187   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      188   define button B-WaitFramStop auto-end-key
      189        label "Стоп"
      190        size 10 by 1 tooltip "Остоновить процесс".
      191   define button B-viewProcInfo
      192        label "Информация"
      193        size 15 by 1 tooltip "Информация о процесс".
      194   define frame waitfram
      195     v-waitfram-action01 format "x(72)" no-label skip
      196     v-waitfram-action02 format "x(72)" no-label skip
      197     v-waitfram-action03 format "x(72)" no-label skip
      198     B-viewProcInfo
      199     B-WaitFramStop at row 4 col 30
      200     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      201     .
      202   define new global shared variable mBatchMode as logical no-undo init ?.
      203   define variable mFramBachModHandle as handle no-undo.
      204   mFramBachModHandle = frame waitfram:handle.
      205   define variable mFameOldVis as logical no-undo.
      206   define variable mVisCUrentVin as logical no-undo.
      207   if session:batch-mode
      208   then
      209      mBatchMode = yes.
      210   if mBatchMode = ? then do:
      211     mVisCUrentVin = current-window:visible.
      212     mFameOldVis = mFramBachModHandle:visible.
      213     mFramBachModHandle:visible  = yes.
      214     mBatchMode = mFramBachModHandle:visible ne yes.
      215     mFramBachModHandle:visible = mFameOldVis.
      216     current-window:visible = mVisCUrentVin.
      217   end.
      218    if  log-manager:logfile-name ne ?
      219     then DO:
      220         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      221         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      222         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      223     end.
      224   on choose of B-WaitFramStop in frame waitfram
      225   do:
      226     mWaitFramStop = yes.
      227     mWaitFramStopUser = yes.
      228   end.
      229   function waitfram-check-timeout returns logical():
      230      define variable vtime as int64 no-undo.
      231      if mWaitFramStopTimeOut
      232      then
      233         return yes.
      234      vtime = ( now - mWaitFramStartProc ) / 1000 .
      235      if     mWaitFramTimeOut ne ?
      236         and mWaitFramTimeOut ne 0
      237         and mWaitFramTimeOut lt vtime
      238      then do:
      239         mWaitFramStopTimeOut = yes.
      240      end.
      241      return mWaitFramStopTimeOut.
      242   end.
      243   procedure waitfram-hide :
      244     if not session:batch-mode
      245     then do
      246     on error undo, return error return-value
      247     :
      248       pause 0 before-hide .
      249       if not mBatchMode then
      250         hide frame waitfram .
      251     if     not mWaitFramView
      252        and mWaitProcEvent
      253     then
      254       process events .
      255     end.
      256   end procedure.
      257   procedure waitfram-show :
      258     define input  parameter p-message as character no-undo .
      259     define variable v-left-margin as integer   no-undo .
      260     if not session:batch-mode
      261     then do
      262     on error undo, return error return-value
      263     :
      264       if length(p-message) <= 70 then do:
      265         assign
      266           v-left-margin = integer((70 - length(p-message)) / 2)
      267         .
      268         assign
      269           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      270         .
      271         assign
      272           v-waitfram-action01 = " "
      273           v-waitfram-action02 = " "
      274                                    + fill(" ", v-left-margin)
      275                                    + p-message
      276           v-waitfram-action03 = " "
      277         .
      278       end.
      279       else do:
      280         define variable vRindex1 as integer no-undo.
      281         define variable vRindex2 as integer no-undo.
      282         vRindex1 = r-index(p-message," ",70).
      283         if vRindex1 = 0
      284         then
      285            vRindex1 = 70.
      286         if length(p-message)  <= vRindex1 + 70 then do:
      287           assign
      288             v-waitfram-action01 = " "
      289             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      290             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      291           .
      292         end.
      293         else do:
      294           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      295           if vRindex2 <= vRindex1
      296           then
      297              vRindex2 = vRindex1 + 70.
      298           assign
      299             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      300             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      301             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      302           .
      303         end.
      304       end.
      305       B-viewProcInfo:visible   in frame waitfram = no.
      306       B-viewProcInfo:sensitive in frame waitfram = no.
      307       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      308       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      309       if  (   mWaitFramView
      310          or  mWaitProcEvent)
      311          and not mBatchMode
      312       then
      313          display
      314             v-waitfram-action01 skip
      315             v-waitfram-action02 skip
      316             v-waitfram-action03 skip
      317          with frame waitfram .
      318       if     mWaitFramView
      319          then do:
      320             if     mWaitFramInterval ne ?
      321                and not mBatchMode
      322             then
      323                wait-for go of frame waitfram pause mWaitFramInterval.
      324          end.
      325          else
      326             if     mWaitProcEvent
      327                and not mBatchMode
      328             then
      329                process events .
      330     end.
      331   end procedure.
      332      procedure waitfram-show-this:
      333         define input  parameter iInterval as int64 no-undo.
      334         define variable vtime as int64 no-undo.
      335         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      336         mWaitFramInterval = iInterval.
      337         run waitfram-show (substitute("&1&2 &3&4" ,
      338                                       mWaitFramTextBeg ,
      339                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      340                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      341                                       mWaitFramTextEnd
      342                                      )
      343                           ).
      344      end.
      345      procedure WaitFramRunPause:
      346         define input  parameter iInterval as dec no-undo.
      347         define variable vStart  as datetime-tz no-undo.
      348         define variable vend    as datetime-tz no-undo.
      349         define variable vint as int64 no-undo.
      350         define variable vOk as logical no-undo.
      351         vStart = now.
      352         vend   = vStart.
      353         publish "WaitFramPause" (iInterval,output vOk).
      354         vend   =  now.
      355         vint = vend - vStart.
      356         vint = iInterval - vint / 1000.
      357         if     not mWaitFramStop
      358            and (   vint > 0
      359                 or (    not vOk
      360                     and iInterval eq ?
      361                     )
      362                 )
      363         then
      364            run waitfram-show-this (iInterval).
      365         vend   =  now.
      366         vint = vend - vStart.
      367         vint = iInterval - vint / 1000.
      368         if     not mWaitFramStop
      369            and vint > 0
      370         then do:
      371            run gbl/pause.p (vint * 1000).
      372         end.
      373         if iInterval ne ?
      374         then
      375            publish "WaitFramStop".
      376         waitfram-check-timeout().
      377      end.
      378      procedure WaitFramWaitFor:
      379         define input  parameter iInterval as dec no-undo.
      380         assign
      381            mWaitFramStartProc   = now
      382            mWaitFramStopUser    = no
      383            mWaitFramStopTimeOut = no
      384         .
      385         block-wait:
      386         do while not mWaitFramStop:
      387            run WaitFramRunPause (iInterval).
      388            if  waitfram-check-timeout()
      389            then do:
      390               leave block-wait.
      391            end.
      392         end.
      393         run waitfram-hide.
      394      end.
      395   procedure waitfram-join :
      396     define input  parameter p-line-1  as character no-undo .
      397     define input  parameter p-line-2  as character no-undo .
      398     define input  parameter p-line-3  as character no-undo .
      399     define output parameter p-message as character no-undo .
      400     do
      401     on error undo, return error return-value
      402     :
      403       assign
      404         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      405                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      406                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      407       .
      408     end.
      409   end procedure.
      410   function waitfram-join-function returns character
      411     (input p-line-1 as character
      412     ,input p-line-2 as character
      413     ,input p-line-3 as character
      414     ).
      415     define variable v-message as character no-undo .
      416     run waitfram-join in this-procedure
      417       (input  p-line-1
      418       ,input  p-line-2
      419       ,input  p-line-3
      420       ,output v-message
      421       ) .
      422     return v-message .
      423   end function .
      424   procedure current-db :
      425    do
      426    on error undo, return error return-value
      427    :
      428   define input parameter  p-host-code as integer no-undo .
      429   define input parameter  c-host-code as integer no-undo .
      430   define output parameter ret         as logical no-undo .
      431   define buffer current_sysconf for ub.sysconf.
      432   define variable v-current-db as integer no-undo .
      433   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      434   if error-status :error then return error .
      435      v-current-db = current_sysconf.firm-db-num .
      436      ret = true .
      437   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
      438   if not( ub.sysconf.firm-db-num = v-current-db or
      439           ub.sysconf.firm-db-num = 0 )
      440     then do:
      441     ret = false .
      442     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
      443     return .
      444   end.
      445    end.
      446   end procedure.
      447   procedure ver-db :
      448    do
      449    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      450    :
      451   define input parameter  c-host-code as integer no-undo .
      452   define input parameter  par-ver-db  as integer no-undo .
      453   define input parameter  p-mess as logical no-undo .
      454   define output parameter ret         as logical no-undo .
      455   define buffer current_sysconf for ub.sysconf.
      456   define variable v-current-db as integer no-undo .
      457   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      458   if error-status :error then return error .
      459      v-current-db = current_sysconf.firm-db-num .
      460      ret = true .
      461   if not( par-ver-db = v-current-db or
      462           par-ver-db = 0 )
      463     then do:
      464     ret = false .
      465     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
      466     return .
      467   end.
      468    end.
      469   end procedure.
      470   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      471     define variable v-cntxt-db-num        as integer   no-undo .
      472     define variable v-cntxt-userid        as character no-undo .
      473     define variable v-cntxt-level         as character no-undo .
      474     define variable v-cntxt-host-code-obj as integer   no-undo .
      475     define variable v-cntxt-obj-type      as character no-undo .
      476     define variable v-cntxt-obj-code      as integer   no-undo .
      477     define variable v-cntxt-db-num-obj    as integer   no-undo .
      478     define variable v-cntxt-is-admin      as logical   no-undo .
      479   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      480   function usrfulnf returns character ( input p-user-id as character):
      481   define variable v-user-name as character no-undo .
      482   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      483   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      484     (input  p-user-id
      485     ,output v-user-name
      486     ) no-error .
      487   if error-status:error
      488   or v-user-name = ""
      489   then do:
      490     return p-user-id.
      491   end.
      492   else do:
      493     return v-user-name.
      494   end.
      495   end function.
      496   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      497   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      498   procedure fltopend_fltopend :
      499   define input parameter p-parent-handle as handle no-undo .
      500   define input parameter p-qh as handle no-undo .
      501   define input parameter p-flt-open-open-query  as character no-undo .
      502   define input parameter p-where-cond as character no-undo .
      503   define input parameter p-use-indFIRST-query-tail as character no-undo .
      504   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      505   define input parameter p-indexed-reposition as character no-undo .
      506     do
      507     on error undo, return error
      508     :
      509   define variable v-prepare-string as character no-undo .
      510   define variable glog as logical no-undo .
      511   assign
      512   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      513                      p-where-cond + chr(32)  +
      514                      p-use-indFIRST-query-tail + chr(32) +
      515                      p-use-ind-sort-clmn-by + chr(32) +
      516                      p-indexed-reposition
      517   .
      518   assign
      519   glog = p-qh:query-prepare(v-prepare-string) no-error .
      520   if not glog
      521   or error-status:error then do:
      522     message error-status:get-message(1) view-as alert-box .
      523     undo, return error .
      524   end.
      525   assign
      526   glog = p-qh:query-open no-error .
      527   if not glog
      528   or error-status:error then do:
      529     message error-status:get-message(1) view-as alert-box .
      530     undo, return error .
      531   end.
      532     end.
      533   end procedure.
      534   procedure fltopend_fltfindd :
      535   define input parameter p-parent-handle as handle no-undo .
      536   define input parameter p-qh as handle no-undo .
      537   define input parameter p-rowid as rowid no-undo .
      538   define input parameter p-next as logical no-undo .
      539   define input parameter p-lock as integer no-undo .
      540   define input parameter p-bh as handle no-undo .
      541   define input parameter p-where-cond as character no-undo .
      542   define input parameter p-use-index-phrase as character no-undo .
      543   define variable glog as logical no-undo .
      544   define variable v-qh as handle no-undo .
      545   define variable v-bh as handle no-undo .
      546   define variable v-recid as recid no-undo .
      547   define variable v-prepare-string as character no-undo .
      548   do
      549   on error undo, return error
      550   on stop undo, return error
      551   :
      552     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      553     create buffer v-bh for table p-bh buffer-name p-bh:name.
      554     create query v-qh.
      555     v-qh:set-buffers(v-bh).
      556     v-prepare-string = substitute("for each &1 &2 &3"
      557                                     ,v-bh:name
      558                                     ,p-where-cond
      559                                     ,p-use-index-phrase).
      560     glog = v-qh:query-prepare(v-prepare-string) no-error.
      561     if not glog then do:
      562       delete object v-qh.
      563       delete object v-bh.
      564       undo, return error .
      565     end.
      566     glog = v-qh:query-open no-error .
      567     if not glog then do:
      568       delete object v-qh.
      569       delete object v-bh.
      570       undo, return error .
      571     end.
      572     if p-next then do:
      573       v-qh:reposition-to-rowid(p-rowid) no-error .
      574       glog = v-qh:get-next( p-lock) no-error .
      575       glog = v-qh:get-next( p-lock) no-error .
      576       if not glog or v-qh:query-off-end = yes then do:
      577         glog = v-qh:get-first( p-lock) no-error .
      578       end.
      579     end.
      580     else do:
      581       glog = v-qh:get-first( p-lock) no-error .
      582     end.
      583     v-recid = v-bh:recid no-error .
      584     delete object v-qh.
      585     delete object v-bh.
      586     return string(v-recid) .
      587   end.
      588   end procedure.
      589   procedure fltopend_fltfindq :
      590   define input parameter p-parent-handle as handle no-undo .
      591   define input parameter p-qh as handle no-undo .
      592   define input parameter p-next as logical no-undo .
      593   define input parameter p-lock as integer no-undo .
      594   define input parameter p-flt-open-open-query  as character no-undo .
      595   define input parameter p-where-cond as character no-undo .
      596   define input parameter p-use-indFIRST-query-tail as character no-undo .
      597   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      598   define input parameter p-indexed-reposition as character no-undo .
      599   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      600   define variable glog as logical no-undo .
      601   define variable v-qh as handle no-undo .
      602   define variable v-bh as handle no-undo extent 18.
      603   define variable v-rowid as rowid no-undo extent 18.
      604   define variable v-ii as integer no-undo .
      605   define variable v-prepare-string as character no-undo .
      606   do
      607   on error undo, return error
      608   on stop undo, return error
      609   :
      610     create query v-qh.
      611     do v-ii = 1 to p-qh:num-buffers:
      612       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      613       assign
      614       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      615       no-error.
      616       v-qh:add-buffer(v-bh[v-ii]).
      617     end.
      618     assign
      619     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      620                       p-where-cond + chr(32)  +
      621                       p-use-indFIRST-query-tail + chr(32) +
      622                       p-use-ind-sort-clmn-by + chr(32) +
      623                       p-indexed-reposition
      624     .
      625     glog = v-qh:query-prepare( v-prepare-string) no-error .
      626     if not glog then do:
      627       delete object v-qh.
      628       do v-ii = 1 to p-qh:num-buffers:
      629         delete object v-bh[v-ii].
      630       end.
      631       undo, return error .
      632     end.
      633     glog = v-qh:query-open no-error .
      634     if not glog then do:
      635       delete object v-qh.
      636       do v-ii = 1 to p-qh:num-buffers:
      637         delete object v-bh[v-ii].
      638       end.
      639       undo, return error .
      640     end.
      641     if p-next then do:
      642       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      643       glog = v-qh:get-next( p-lock) no-error .
      644       glog = v-qh:get-next( p-lock) no-error .
      645       if not glog or v-qh:query-off-end = yes then do:
      646         glog = v-qh:get-first( p-lock) no-error .
      647       end.
      648     end.
      649     else do:
      650       glog = v-qh:get-first( p-lock) no-error .
      651     end.
      652     do v-ii = 1 to p-qh:num-buffers:
      653       assign
      654       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      655       no-error.
      656     end.
      657     delete object v-qh.
      658     do v-ii = 1 to p-qh:num-buffers:
      659       delete object v-bh[v-ii].
      660     end.
      661   end.
      662   end procedure.
