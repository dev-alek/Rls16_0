     7521       END CASE.
     7522       message
     7523         "Закрыть договор №" buf_contract.contract-prn-code "от" buf_contract.contract-date "?"
     7524         view-as alert-box QUESTION BUTTONS YES-NO update g-log .
     7525       if g-log = no then return .
     7526   define variable vss-include-info75 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7527   do:
     7528     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7529       (input  v-cntxt-db-num
     7530       ,input  v-cntxt-userid
     7531       ,input  0
     7532       ,input  'actn_fin-contract_deletion':U
     7533       ,input  'firm':U
     7534       ,input  p-host-code
     7535       ,input  '':U
     7536       ,input  0
     7537       ,input  0
     7538       ,input  0
     7539       ,input  0
     7540       ,input  true
     7541       ,output g-log
     7542       )  .
     7543   end.
     7544       if not g-log then return .
     7545       v-doc-rec = recid( buf_contract ).
     7546       do transaction :
     7547          find first contract exclusive-lock where recid(contract) = recid(buf_contract) no-error .
     7548          if available contract then do:
     7549   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7550   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     7551     (output buf_contract.user-db-num
     7552     ,output buf_contract.user-name
     7553     ,output p-sys-date
     7554     ,output p-sys-time
     7555     ,output p-sys-time-int
     7556     )  .
     7557             ASSIGN
     7558                contract.status_ = 'зкр':U
     7559                .
     7560          end.
     7561          if Is-MS-Contract-Int (BUFFER buf_Contract) = 1 THEN DO:
     7562             RUN Change-Stat-Slave-Contract in THIS-PROCEDURE(
     7563                 BUFFER buf_Contract,
     7564                 'зкр':U,
     7565                 OUTPUT v-cError
     7566                 ).
     7567             if v-cError <> "" THEN DO:
     7568                MESSAGE
