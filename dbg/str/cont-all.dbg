     2349   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2350   on help of frame Dialog-Frame
     2351   do:
     2352     run gbl/app_help.p
     2353       (input this-procedure :file-name
     2354       ,input ''
     2355       ,input ?
     2356       ) no-error.
     2357     if error-status :error then do:
     2358       message
     2359         "Ошибка при вызове помощи"
     2360         error-status :get-message(1)
     2361         view-as alert-box .
     2362     end.
