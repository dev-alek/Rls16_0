     4185            b-open b-trn-doc B-fin-ob B-fin-doc b-hist b-exp b-imp B-add Contr-List sch-code sch-date
     4186            Cli-Types Agnt-Types Cli-Status mark-num b-order
     4187         WITH FRAME Dialog-Frame.
     4188     VIEW FRAME Dialog-Frame.
     4189   END PROCEDURE.
     4190   PROCEDURE OpenBr :
     4191     define input  parameter p-open-query     as logical   no-undo .
     4192     define input  parameter p-find-next      as logical   no-undo .
     4193     define input  parameter p-find-condition as character no-undo .
     4194     if p-doc-type = "all" then run OpenBr1 ( p-open-query, p-find-next, p-find-condition) .
     4195     else                       run OpenBr2 ( p-open-query, p-find-next, p-find-condition) .
     4196   END PROCEDURE.
     4197   PROCEDURE OpenBr1 :
     4198     define input  parameter p-open-query     as logical   no-undo .
     4199     define input  parameter p-find-next      as logical   no-undo .
     4200     define input  parameter p-find-condition as character no-undo .
     4201     define variable l-query-was-opened as logical no-undo .
     4202     define variable title0 as character no-undo.
     4203     title0 = "Список договоров" + chr(32).
     4204     if p-contr-type <> chr(1) then title0 = title0 + p-contr-type  + chr(32).
     4205     define variable sort-column-phrase as character no-undo .
     4206     case sort-column-name :
     4207       when "" then assign  sort-column-phrase = ""  .
     4208       otherwise    assign  sort-column-phrase = "by " + sort-column-name .
     4209     end case.
     4210     define variable l-open-query as logical   no-undo .
     4211     filter-point = filter-point0 + p-mode.
     4212     find first ub.clients no-lock where ub.clients.obj-type = 'орг':U and ub.clients.obj-code = p-host-code .
     4213     ASSIGN title0  = title0 + " Фирма: (" + string(p-host-code) + ")":U + chr(32) + ub.clients.obj-name .
     4214     case Cli-Status :
     4215       when "all" then do:
     4216         if Agnt-Types = "all" and Cli-Types = "all" then do:
     4217           ASSIGN  frame Dialog-Frame:TITLE = title0 .
     4218   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4219   define variable  l-disable-where-37  as logical   no-undo .
     4220   define variable  l-filter-open-37    as logical   .
     4221   define variable  flt-rec-37       as recid     no-undo .
     4222   define variable  filter-name-37      as character no-undo .
     4223   define variable  where-phrase-37     as character no-undo .
     4224   define variable  sort-phrase-37      as character no-undo .
     4225   define variable  where-phrase-rus-37 as character no-undo .
     4226   define variable  sort-phrase-rus-37  as character no-undo .
     4227   run gbl/flt-get.p
     4228     (input filter-point
     4229     ,output flt-rec-37
     4230     ,output filter-name-37
     4231     ,output where-phrase-37
     4232     ,output sort-phrase-37
     4233     ,output where-phrase-rus-37
     4234     ,output sort-phrase-rus-37
     4235     ).
     4236   if p-open-query then do:
     4237       run set-filter-name in this-procedure
     4238         (INPUT filter-name-37
     4239         ) no-error .
     4240     assign
     4241       l-filter-open-37 = false
     4242     .
     4243     if flt-rec-37 <> ?
     4244       or sort-column-phrase > ""
     4245     then do:
     4246       define variable  parameter-2-37 as character no-undo .
     4247       define variable  parameter-3-37 as character no-undo .
     4248       define variable  parameter-4-37 as character no-undo .
     4249       define variable  parameter-5-37 as character no-undo .
     4250       define variable  parameter-6-37 as character no-undo .
     4251       define variable  parameter-7-37 as character no-undo .
     4252         assign
     4253         parameter-3-37 =
     4254                                 "FOR EACH buf_contract"
     4255         parameter-4-37 =
     4256           (
     4257             if (" buf_contract.host-code  = p-host-code and ( p-contr-type = chr(1) or buf_contract.contract-type = p-contr-type)" + " " + where-phrase-37) <> ""
     4258             then  substitute(' buf_contract.host-code = &1 and ( &3&2&3 = chr(1) or buf_contract.contract-type = &3&2&3)', p-host-code, p-contr-type, chr(34)) + " " + where-phrase-37
     4259             else "true"
     4260           )
     4261         parameter-5-37 = (" " + "" + " " + substitute(' and ( &1&2&1 <> &1firm-curr&1 or ( buf_contract.contract-date-end = date(&1&1) or buf_contract.contract-date-end >= today )) ' , chr(34) , p-mode  ))
     4262         parameter-6-37 = if sort-phrase-37 = ''
     4263                              then
     4264           (
     4265           " " + "  " +
     4266             " " + sort-column-phrase +
     4267           " " +  substitute(' by &1 descending', buf_contract.contract-date)
     4268           )
     4269                              else
     4270           (
     4271           " " + "  " +
     4272             " " + sort-column-phrase +
     4273           " " + sort-phrase-37
     4274           )
     4275         parameter-7-37 =
     4276           " indexed-reposition  "
     4277       .
     4278       do
     4279       on stop undo, leave
     4280       on error undo, leave
     4281       :
     4282         assign
     4283           l-disable-where-37 =
     4284             (" buf_contract.host-code  = p-host-code and ( p-contr-type = chr(1) or buf_contract.contract-type = p-contr-type)" + " " + where-phrase-37 = "")
     4285         .
     4286         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4287                             ,input query Contr-List:handle
     4288                             ,input parameter-3-37
     4289                             ,input parameter-4-37
     4290                             ,input parameter-5-37
