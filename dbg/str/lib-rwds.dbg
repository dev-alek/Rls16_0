     6296                                   wast-exp-line.prod-code = tt-wast-line.prod-code and
     6297                                   wast-exp-line.artic     = tt-wast-line.artic     and
     6298                                   wast-exp-line.status_   = 'факт':U
     6299                                   and
     6300                                   wast-exp-line.fact-order > tt-wast-line.prev-inv-fact-order
     6301                                   and
     6302                                   wast-exp-line.fact-order < tt-wast-line.fact-order
     6303                                   no-lock ,
     6304                 first wast-exp-doc where  wast-exp-doc.obj-type       = wast-exp-line.obj-type  and
     6305                                           wast-exp-doc.obj-code       = wast-exp-line.obj-code  and
     6306                                           wast-exp-doc.doc-code       = wast-exp-line.doc-code  and
     6307                                           wast-exp-doc.internal       = no                      and
     6308                                           wast-exp-doc.doc-type       = 'рас':U              and
     6309                                           wast-exp-doc.is-del         = false                   and
     6310                                           wast-exp-doc.ext-doc-type   = 'ee':U      or
     6311                                           wast-exp-doc.obj-type       = wast-exp-line.obj-type  and
     6312                                           wast-exp-doc.obj-code       = wast-exp-line.obj-code  and
     6313                                           wast-exp-doc.doc-code       = wast-exp-line.doc-code  and
     6314                                           wast-exp-doc.internal       = no                      and
     6315                                           wast-exp-doc.doc-type       = 'рас':U              and
     6316                                           wast-exp-doc.ext-doc-type   = 'es':U and
     6317                                           wast-exp-doc.is-del         = false
     6318                                           no-lock on error undo, return error return-value :
     6319       assign
     6320         varwast-sum-sale-base = 0
     6321         varwast-sum-sale-rubl = 0.
     6322       for each wast-exp-gds-dtl where wast-exp-gds-dtl.doc-code  = wast-exp-line.doc-code  and
     6323                                       wast-exp-gds-dtl.artic     = wast-exp-line.artic     and
     6324                                       wast-exp-gds-dtl.prod-type = wast-exp-line.prod-type and
     6325                                       wast-exp-gds-dtl.prod-code = wast-exp-line.prod-code no-lock :
     6326         assign
     6327           varwast-sum-sale-base = varwast-sum-sale-base + (wast-exp-gds-dtl.price-base - wast-exp-gds-dtl.discnt-base) * wast-exp-gds-dtl.fact-qnty
     6328           varwast-sum-sale-rubl = varwast-sum-sale-rubl + (wast-exp-gds-dtl.price-rubl - wast-exp-gds-dtl.discnt-rubl) * wast-exp-gds-dtl.fact-qnty.
     6329       end.
     6330       assign
     6331         varwast-fact-qnty-line     = varwast-fact-qnty-line     + wast-exp-line.fact-qnty
     6332         varwast-cli-qnty-line      = varwast-cli-qnty-line      + wast-exp-line.cli-qnty
     6333         varwast-sum-sale-base-line = varwast-sum-sale-base-line + varwast-sum-sale-base
     6334         varwast-sum-sale-rubl-line = varwast-sum-sale-rubl-line + varwast-sum-sale-rubl
     6335         varwast-sum-base-line      = varwast-sum-base-line      + wast-exp-line.fact-qnty * wast-exp-line.price-base
     6336         varwast-sum-rubl-line      = varwast-sum-rubl-line      + wast-exp-line.fact-qnty * wast-exp-line.price-rubl
     6337         .
     6338     end.
     6339    end.
     6340             end.
     6341           end.
     6342           find first bf_doc-line-sum where
     6343                      bf_doc-line-sum.doc-code = wast-cur-inv-doc.doc-code and
     6344                      bf_doc-line-sum.gds-code = wast-goods.gds-code       and
     6345                      bf_doc-line-sum.sum-type = 'wst':U.
     6346           if v_invclcsp = "yes" then do:
     6347             find first bf_cli_doc-line-sum where
     6348                        bf_cli_doc-line-sum.doc-code = wast-cur-inv-doc.doc-code and
     6349                        bf_cli_doc-line-sum.gds-code = wast-goods.gds-code       and
     6350                        bf_cli_doc-line-sum.sum-type = 'wstc':U.
     6351           end.
     6352           assign bf_doc-line-sum.fact-qnty           = varwast-fact-qnty-line     * v-normal-wastage * (if v-petrol then 0.001 else 0.01)
     6353                  bf_doc-line-sum.sale-sum-base       = varwast-sum-sale-base-line * v-normal-wastage * (if v-petrol then 0.001 else 0.01)
     6354                  bf_doc-line-sum.sale-sum-rubl       = varwast-sum-sale-rubl-line * v-normal-wastage * (if v-petrol then 0.001 else 0.01)
     6355                  bf_doc-line-sum.sale-VAT-base       = 0
     6356                  bf_doc-line-sum.sale-VAT-rubl       = 0
     6357                  bf_doc-line-sum.sale-SLT-base       = 0
     6358                  bf_doc-line-sum.sale-SLT-rubl       = 0
     6359                  bf_doc-line-sum.sale-road-tax-base  = 0
     6360                  bf_doc-line-sum.sale-road-tax-rubl  = 0
     6361                  bf_doc-line-sum.sale-excise-base    = 0
     6362                  bf_doc-line-sum.sale-excise-rubl    = 0
     6363                  bf_doc-line-sum.sale-transport-base = 0
     6364                  bf_doc-line-sum.sale-transport-rubl = 0
     6365                  bf_doc-line-sum.sale-other-base     = 0
     6366                  bf_doc-line-sum.sale-other-rubl     = 0
     6367                  bf_doc-line-sum.sale-discnt-base    = 0
     6368                  bf_doc-line-sum.sale-discnt-rubl    = 0
     6369                  bf_doc-line-sum.crsa-sum-base       = 0
     6370                  bf_doc-line-sum.crsa-sum-rubl       = 0
     6371                  bf_doc-line-sum.crsa-VAT-base       = 0
     6372                  bf_doc-line-sum.crsa-VAT-rubl       = 0
     6373                  bf_doc-line-sum.crsa-SLT-base       = 0
     6374                  bf_doc-line-sum.crsa-SLT-rubl       = 0
     6375                  bf_doc-line-sum.crsa-road-tax-base  = 0
     6376                  bf_doc-line-sum.crsa-road-tax-rubl  = 0
     6377                  bf_doc-line-sum.crsa-excise-base    = 0
     6378                  bf_doc-line-sum.crsa-excise-rubl    = 0
     6379                  bf_doc-line-sum.crsa-transport-base = 0
     6380                  bf_doc-line-sum.crsa-transport-rubl = 0
     6381                  bf_doc-line-sum.crsa-other-base     = 0
     6382                  bf_doc-line-sum.crsa-other-rubl     = 0
     6383                  bf_doc-line-sum.crsa-discnt-base    = 0
     6384                  bf_doc-line-sum.crsa-discnt-rubl    = 0
     6385                  bf_doc-line-sum.cost-sum-base       = varwast-sum-base-line      * v-normal-wastage * (if v-petrol then 0.001 else 0.01)
     6386                  bf_doc-line-sum.cost-sum-rubl       = varwast-sum-rubl-line      * v-normal-wastage * (if v-petrol then 0.001 else 0.01)
     6387                  bf_doc-line-sum.cost-VAT-base       = 0
     6388                  bf_doc-line-sum.cost-VAT-rubl       = 0
     6389                  bf_doc-line-sum.cost-SLT-base       = 0
     6390                  bf_doc-line-sum.cost-SLT-rubl       = 0
     6391                  bf_doc-line-sum.cost-road-tax-base  = 0
     6392                  bf_doc-line-sum.cost-road-tax-rubl  = 0
     6393                  bf_doc-line-sum.cost-excise-base    = 0
     6394                  bf_doc-line-sum.cost-excise-rubl    = 0
     6395                  bf_doc-line-sum.cost-transport-base = 0
     6396                  bf_doc-line-sum.cost-transport-rubl = 0
     6397                  bf_doc-line-sum.cost-other-base     = 0
     6398                  bf_doc-line-sum.cost-other-rubl     = 0
     6399                  bf_doc-line-sum.cost-discnt-base    = 0
     6400                  bf_doc-line-sum.cost-discnt-rubl    = 0.
     6401           if v_invclcsp = "yes" then do:
     6402             assign bf_cli_doc-line-sum.fact-qnty           = varwast-cli-qnty-line      * v-normal-wastage * (if v-petrol then 0.001 else 0.01)
     6403                    bf_cli_doc-line-sum.sale-sum-base       = varwast-sum-sale-base-line * v-normal-wastage * (if v-petrol then 0.001 else 0.01)
     6404                    bf_cli_doc-line-sum.sale-sum-rubl       = varwast-sum-sale-rubl-line * v-normal-wastage * (if v-petrol then 0.001 else 0.01)
     6405                    bf_cli_doc-line-sum.sale-VAT-base       = 0
     6406                    bf_cli_doc-line-sum.sale-VAT-rubl       = 0
     6407                    bf_cli_doc-line-sum.sale-SLT-base       = 0
     6408                    bf_cli_doc-line-sum.sale-SLT-rubl       = 0
     6409                    bf_cli_doc-line-sum.sale-road-tax-base  = 0
     6410                    bf_cli_doc-line-sum.sale-road-tax-rubl  = 0
     6411                    bf_cli_doc-line-sum.sale-excise-base    = 0
     6412                    bf_cli_doc-line-sum.sale-excise-rubl    = 0
     6413                    bf_cli_doc-line-sum.sale-transport-base = 0
     6414                    bf_cli_doc-line-sum.sale-transport-rubl = 0
     6415                    bf_cli_doc-line-sum.sale-other-base     = 0
     6416                    bf_cli_doc-line-sum.sale-other-rubl     = 0
     6417                    bf_cli_doc-line-sum.sale-discnt-base    = 0
     6418                    bf_cli_doc-line-sum.sale-discnt-rubl    = 0
     6419                    bf_cli_doc-line-sum.crsa-sum-base       = 0
     6420                    bf_cli_doc-line-sum.crsa-sum-rubl       = 0
     6421                    bf_cli_doc-line-sum.crsa-VAT-base       = 0
     6422                    bf_cli_doc-line-sum.crsa-VAT-rubl       = 0
     6423                    bf_cli_doc-line-sum.crsa-SLT-base       = 0
     6424                    bf_cli_doc-line-sum.crsa-SLT-rubl       = 0
     6425                    bf_cli_doc-line-sum.crsa-road-tax-base  = 0
     6426                    bf_cli_doc-line-sum.crsa-road-tax-rubl  = 0
     6427                    bf_cli_doc-line-sum.crsa-excise-base    = 0
     6428                    bf_cli_doc-line-sum.crsa-excise-rubl    = 0
     6429                    bf_cli_doc-line-sum.crsa-transport-base = 0
     6430                    bf_cli_doc-line-sum.crsa-transport-rubl = 0
     6431                    bf_cli_doc-line-sum.crsa-other-base     = 0
     6432                    bf_cli_doc-line-sum.crsa-other-rubl     = 0
     6433                    bf_cli_doc-line-sum.crsa-discnt-base    = 0
     6434                    bf_cli_doc-line-sum.crsa-discnt-rubl    = 0
     6435                    bf_cli_doc-line-sum.cost-sum-base       = varwast-sum-base-line      * v-normal-wastage * (if v-petrol then 0.001 else 0.01)
     6436                    bf_cli_doc-line-sum.cost-sum-rubl       = varwast-sum-rubl-line      * v-normal-wastage * (if v-petrol then 0.001 else 0.01)
     6437                    bf_cli_doc-line-sum.cost-VAT-base       = 0
     6438                    bf_cli_doc-line-sum.cost-VAT-rubl       = 0
     6439                    bf_cli_doc-line-sum.cost-SLT-base       = 0
     6440                    bf_cli_doc-line-sum.cost-SLT-rubl       = 0
     6441                    bf_cli_doc-line-sum.cost-road-tax-base  = 0
     6442                    bf_cli_doc-line-sum.cost-road-tax-rubl  = 0
     6443                    bf_cli_doc-line-sum.cost-excise-base    = 0
     6444                    bf_cli_doc-line-sum.cost-excise-rubl    = 0
     6445                    bf_cli_doc-line-sum.cost-transport-base = 0
     6446                    bf_cli_doc-line-sum.cost-transport-rubl = 0
     6447                    bf_cli_doc-line-sum.cost-other-base     = 0
     6448                    bf_cli_doc-line-sum.cost-other-rubl     = 0
     6449                    bf_cli_doc-line-sum.cost-discnt-base    = 0
     6450                    bf_cli_doc-line-sum.cost-discnt-rubl    = 0.
     6451           end.
     6452         end.
     6453       end.
     6454       run waitfram-hide in p-wasthandle no-error.
     6455     end.
     6456   end procedure.
     6457   procedure lib-rwds_updtrsum :
     6458     define input        parameter           p-doc-code         like ub.trn-doc.doc-code   no-undo.
     6459     define input        parameter           p-artic            like ub.doc-line.artic     no-undo.
     6460     define input        parameter           p-prod-type        like ub.doc-line.prod-type no-undo.
     6461     define input        parameter           p-prod-code        like ub.doc-line.prod-code no-undo.
     6462     define input        parameter           p-mode             as   character             no-undo.
     6463     define input-output parameter table for tt-allsum-line.
     6464     define input-output parameter table for tt-doc-line-sum.
     6465     define input-output parameter table for tt-old-doc-line-sum.
     6466     define buffer bf_gen_trn-doc-sum             for ub.trn-doc-sum.
     6467     define buffer bf_aft_trn-doc-sum             for ub.trn-doc-sum.
     6468     define buffer bf_ext_trn-doc-sum             for ub.trn-doc-sum.
     6469     define buffer bf_mis_trn-doc-sum             for ub.trn-doc-sum.
     6470     define buffer bf_gen-cli_trn-doc-sum         for ub.trn-doc-sum.
     6471     define buffer bf_aft-cli_trn-doc-sum         for ub.trn-doc-sum.
     6472     define buffer bf_ext-cli_trn-doc-sum         for ub.trn-doc-sum.
     6473     define buffer bf_mis-cli_trn-doc-sum         for ub.trn-doc-sum.
     6474     define buffer bf_gen_tt-doc-line-sum         for tt-doc-line-sum.
     6475     define buffer bf_aft_tt-doc-line-sum         for tt-doc-line-sum.
     6476     define buffer bf_gen-cli_tt-doc-line-sum     for tt-doc-line-sum.
     6477     define buffer bf_aft-cli_tt-doc-line-sum     for tt-doc-line-sum.
     6478     define buffer bf_gen_tt-old-doc-line-sum     for tt-old-doc-line-sum.
     6479     define buffer bf_aft_tt-old-doc-line-sum     for tt-old-doc-line-sum.
     6480     define buffer bf_gen-cli_tt-old-doc-line-sum for tt-old-doc-line-sum.
     6481     define buffer bf_aft-cli_tt-old-doc-line-sum for tt-old-doc-line-sum.
     6482     define buffer bf_goods                       for ub.goods.
     6483     define buffer bf_doc-line                    for ub.doc-line.
     6484     define buffer bf_trn-doc                     for ub.trn-doc.
     6485     define variable v_invclcsp  as character no-undo.
     6486     define variable v_data-type as character no-undo.
     6487     do on error undo, return error return-value :
     6488       find first bf_trn-doc where
     6489                  bf_trn-doc.doc-code = p-doc-code.
     6490       if not available bf_trn-doc then do:
     6491         return error substitute( 'lib-rwds_updtrsum. Не найден документ "&1".', p-doc-code ).
     6492       end.
     6493   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6494   empty temp-table thbjattr_thbj-attr.
     6495   run adm/shattri.p (
     6496      input "get":U
     6497     ,input bf_trn-doc.obj-type
     6498     ,input bf_trn-doc.obj-code
     6499     ,input 'inv-obj':U
     6500     ,input  ""
     6501     ,output v-value-character
     6502     ,output v-value-date
     6503     ,output v-value-decimal
     6504     ,output v-value-integer
     6505     ,output v-value-logical
     6506     ,output par-type
     6507     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6508     ) no-error .
     6509       for each thbjattr_thbj-attr :
     6510           if thbjattr_thbj-attr.prop-code = 'invclcsp'  then v_invclcsp = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
     6511       end.
     6512        empty temp-table thbjattr_thbj-attr.
     6513       find first bf_doc-line where
     6514                  bf_doc-line.doc-code  = p-doc-code  and
     6515                  bf_doc-line.artic     = p-artic     and
     6516                  bf_doc-line.prod-type = p-prod-type and
     6517                  bf_doc-line.prod-code = p-prod-code no-error.
     6518       find first bf_goods no-lock where
     6519                  bf_goods.artic     = bf_doc-line.artic     and
     6520                  bf_goods.prod-type = bf_doc-line.prod-type and
     6521                  bf_goods.prod-code = bf_doc-line.prod-code.
     6522       find first bf_gen_trn-doc-sum exclusive-lock where
     6523                  bf_gen_trn-doc-sum.doc-code = bf_doc-line.doc-code and
     6524                  bf_gen_trn-doc-sum.sum-type = 'gen':U   no-error.
     6525       if not available bf_gen_trn-doc-sum then do:
     6526         return error substitute( 'Ошибка при поиске суммы типа "&1" по документу "&2".'
     6527                                , 'gen':U
     6528                                , bf_doc-line.doc-code ).
     6529       end.
     6530       find first bf_ext_trn-doc-sum exclusive-lock where
     6531                  bf_ext_trn-doc-sum.doc-code = bf_doc-line.doc-code and
     6532                  bf_ext_trn-doc-sum.sum-type = 'ext':U     no-error.
     6533       if not available bf_ext_trn-doc-sum then do:
     6534         return error substitute( 'Ошибка при поиске суммы типа "&1" по документу "&2".'
     6535                                , 'ext':U
     6536                                , bf_doc-line.doc-code ).
     6537       end.
     6538       find first bf_mis_trn-doc-sum exclusive-lock where
     6539                  bf_mis_trn-doc-sum.doc-code = bf_doc-line.doc-code and
     6540                  bf_mis_trn-doc-sum.sum-type = 'mis':U      no-error.
     6541       if not available bf_mis_trn-doc-sum then do:
     6542         return error substitute( 'Ошибка при поиске суммы типа "&1" по документу "&2".'
     6543                                , 'mis':U
     6544                                , bf_doc-line.doc-code ).
     6545       end.
     6546       if v_invclcsp = "yes" then do:
     6547         find first bf_gen-cli_trn-doc-sum exclusive-lock where
     6548                    bf_gen-cli_trn-doc-sum.doc-code = bf_doc-line.doc-code   and
     6549                    bf_gen-cli_trn-doc-sum.sum-type = 'genc':U no-error.
     6550         if not available bf_gen-cli_trn-doc-sum then do:
     6551           return error substitute( 'Ошибка при поиске суммы типа "&1" по документу "&2".'
     6552                                  , 'genc':U
     6553                                  , bf_doc-line.doc-code ).
     6554         end.
     6555         find first bf_ext-cli_trn-doc-sum exclusive-lock where
     6556                    bf_ext-cli_trn-doc-sum.doc-code = bf_doc-line.doc-code and
     6557                    bf_ext-cli_trn-doc-sum.sum-type = 'extc':U no-error.
     6558         if not available bf_ext-cli_trn-doc-sum then do:
     6559           return error substitute( 'Ошибка при поиске суммы типа "&1" по документу "&2".'
     6560                                  , 'extc':U
     6561                                  , bf_doc-line.doc-code ).
     6562         end.
     6563         find first bf_mis-cli_trn-doc-sum exclusive-lock where
     6564                    bf_mis-cli_trn-doc-sum.doc-code = bf_doc-line.doc-code and
     6565                    bf_mis-cli_trn-doc-sum.sum-type = 'misc':U  no-error.
     6566         if not available bf_mis-cli_trn-doc-sum then do:
     6567           return error substitute( 'Ошибка при поиске суммы типа "&1" по документу "&2".'
     6568                                  , 'misc':U
     6569                                  , bf_doc-line.doc-code ).
     6570         end.
     6571       end.
     6572       find first bf_gen_tt-old-doc-line-sum where
     6573                  bf_gen_tt-old-doc-line-sum.doc-code = bf_doc-line.doc-code and
     6574                  bf_gen_tt-old-doc-line-sum.gds-code = bf_goods.gds-code    and
     6575                  bf_gen_tt-old-doc-line-sum.sum-type = 'gen':U   no-error.
     6576       if not available bf_gen_tt-old-doc-line-sum then do:
     6577         return error substitute( 'Не найдена запись по временной таблице старых сумм по типу "&1" для товара &2 &3 &4 ' +
     6578                                  'по документу "&5".'
     6579                                , 'gen':U
     6580                                , bf_goods.artic
     6581                                , bf_goods.prod-type
     6582                                , bf_goods.prod-code
     6583                                , bf_doc-line.doc-code ).
     6584       end.
     6585       if v_invclcsp = "yes" then do:
     6586         find first bf_gen-cli_tt-old-doc-line-sum where
     6587                    bf_gen-cli_tt-old-doc-line-sum.doc-code = bf_doc-line.doc-code   and
     6588                    bf_gen-cli_tt-old-doc-line-sum.gds-code = bf_goods.gds-code      and
     6589                    bf_gen-cli_tt-old-doc-line-sum.sum-type = 'genc':U no-error.
     6590         if not available bf_gen-cli_tt-old-doc-line-sum then do:
     6591           return error substitute( 'Не найдена запись по временной таблице старых сумм по типу "&1" для товара &2 &3 &4 ' +
     6592                                    'по документу "&5".'
     6593                                  , 'genc':U
     6594                                  , bf_goods.artic
     6595                                  , bf_goods.prod-type
     6596                                  , bf_goods.prod-code
     6597                                  , bf_doc-line.doc-code ).
     6598         end.
     6599       end.
     6600       if p-mode = "update":U then do:
     6601         find first bf_gen_tt-doc-line-sum where
     6602                    bf_gen_tt-doc-line-sum.doc-code = bf_doc-line.doc-code and
     6603                    bf_gen_tt-doc-line-sum.gds-code = bf_goods.gds-code    and
     6604                    bf_gen_tt-doc-line-sum.sum-type = 'gen':U   no-error.
     6605         if not available bf_gen_tt-doc-line-sum then do:
     6606           return error substitute( 'Не найдена запись по временной таблице новых сумм по типу "&1" для товара &2 &3 &4 ' +
     6607                                    'по документу "&5".'
     6608                                  , 'gen':U
     6609                                  , bf_goods.artic
     6610                                  , bf_goods.prod-type
     6611                                  , bf_goods.prod-code
     6612                                  , bf_doc-line.doc-code ).
     6613         end.
