     4650              bf_doc-line-sum.sale-transport-base = 0
     4651              bf_doc-line-sum.sale-transport-rubl = 0
     4652              bf_doc-line-sum.sale-other-base     = 0
     4653              bf_doc-line-sum.sale-other-rubl     = 0
     4654              bf_doc-line-sum.sale-discnt-base    = 0
     4655              bf_doc-line-sum.sale-discnt-rubl    = 0
     4656              bf_doc-line-sum.crsa-sum-base       = 0
     4657              bf_doc-line-sum.crsa-sum-rubl       = 0
     4658              bf_doc-line-sum.crsa-VAT-base       = 0
     4659              bf_doc-line-sum.crsa-VAT-rubl       = 0
     4660              bf_doc-line-sum.crsa-SLT-base       = 0
     4661              bf_doc-line-sum.crsa-SLT-rubl       = 0
     4662              bf_doc-line-sum.crsa-road-tax-base  = 0
     4663              bf_doc-line-sum.crsa-road-tax-rubl  = 0
     4664              bf_doc-line-sum.crsa-excise-base    = 0
     4665              bf_doc-line-sum.crsa-excise-rubl    = 0
     4666              bf_doc-line-sum.crsa-transport-base = 0
     4667              bf_doc-line-sum.crsa-transport-rubl = 0
     4668              bf_doc-line-sum.crsa-other-base     = 0
     4669              bf_doc-line-sum.crsa-other-rubl     = 0
     4670              bf_doc-line-sum.crsa-discnt-base    = 0
     4671              bf_doc-line-sum.crsa-discnt-rubl    = 0
     4672              bf_doc-line-sum.cost-sum-base       = 0
     4673              bf_doc-line-sum.cost-sum-rubl       = 0
