     5646                  bf_aft-cli_doc-line-sum.cost-transport-base   = bf_bef-cli_doc-line-sum.cost-transport-base  +
     5647                                                                  bf_gen-cli_doc-line-sum.cost-transport-base
     5648                  bf_aft-cli_doc-line-sum.cost-transport-rubl   = bf_bef-cli_doc-line-sum.cost-transport-rubl  +
     5649                                                                  bf_gen-cli_doc-line-sum.cost-transport-rubl
     5650                  bf_aft-cli_doc-line-sum.cost-other-base       = bf_bef-cli_doc-line-sum.cost-other-base      +
     5651                                                                  bf_gen-cli_doc-line-sum.cost-other-base
     5652                  bf_aft-cli_doc-line-sum.cost-other-rubl       = bf_bef-cli_doc-line-sum.cost-other-rubl      +
     5653                                                                  bf_gen-cli_doc-line-sum.cost-other-rubl
     5654                  bf_aft-cli_doc-line-sum.cost-discnt-base      = bf_bef-cli_doc-line-sum.cost-discnt-base     +
     5655                                                                  bf_gen-cli_doc-line-sum.cost-discnt-base
     5656                  bf_aft-cli_doc-line-sum.cost-discnt-rubl      = bf_bef-cli_doc-line-sum.cost-discnt-rubl     +
     5657                                                                  bf_gen-cli_doc-line-sum.cost-discnt-rubl     .
     5658         end.
     5659       end.
     5660       for each tt-doc-line-sum :
     5661         delete tt-doc-line-sum.
     5662       end.
     5663       for each bf_doc-line-sum where
     5664                bf_doc-line-sum.doc-code = p-doc-code       and
     5665                bf_doc-line-sum.gds-code = bf_goods.gds-code
     5666       on error undo, return error return-value :
     5667         create tt-doc-line-sum.
     5668         buffer-copy bf_doc-line-sum to tt-doc-line-sum.
     5669       end.
     5670     end.
     5671   end procedure.
     5672   procedure lib-rwds_ttdlsdel :
     5673     define input        parameter           p-doc-code      like ub.trn-doc.doc-code   no-undo.
     5674     define input        parameter           p-artic         like ub.doc-line.artic     no-undo.
     5675     define input        parameter           p-prod-type     like ub.doc-line.prod-type no-undo.
     5676     define input        parameter           p-prod-code     like ub.doc-line.prod-code no-undo.
     5677     define input-output parameter table for tt-doc-line-sum.
     5678     define buffer bf_goods           for ub.goods.
     5679     define buffer bf_tt-doc-line-sum for tt-doc-line-sum.
     5680     do on error undo, return error return-value :
     5681       find first bf_goods no-lock where
     5682                  bf_goods.artic     = p-artic     and
     5683                  bf_goods.prod-type = p-prod-type and
     5684                  bf_goods.prod-code = p-prod-code no-error.
     5685       if not available bf_goods then do:
     5686         return error substitute( 'lib-rwds_ttdlsdel. Не найден товар &1 &2 &3.', p-artic, p-prod-type, p-prod-code ).
     5687       end.
     5688       for each bf_tt-doc-line-sum where
     5689                bf_tt-doc-line-sum.doc-code = p-doc-code       and
     5690                bf_tt-doc-line-sum.gds-code = bf_goods.gds-code
     5691       on error undo, return error return-value :
     5692         delete bf_tt-doc-line-sum.
     5693       end.
     5694     end.
     5695   end procedure.
     5696   procedure lib-rwds_ccwstsum :
     5697     define input        parameter           p-doc-code   like trn-doc.doc-code no-undo.
     5698     define input        parameter           p-wasthandle as   handle           no-undo.
     5699     define input-output parameter table for tt-wast-line.
     5700     define buffer wast-cur-trn-doc    for ub.trn-doc.
     5701     define buffer wast-trn-doc        for ub.trn-doc.
     5702     define buffer wast-doc-line       for ub.doc-line.
     5703     define buffer wast-exp-doc        for ub.trn-doc.
     5704     define buffer wast-exp-line       for ub.doc-line.
     5705     define buffer wast-exp-gds-dtl    for ub.gds-dtl.
     5706     define buffer wast-goods          for ub.goods.
     5707     define buffer wast-cur-doc-line   for ub.doc-line.
     5708     define buffer bf_doc-line-sum     for ub.doc-line-sum.
     5709     define buffer bf_cli_doc-line-sum for ub.doc-line-sum.
     5710     define buffer bf_trn-doc-sum      for ub.trn-doc-sum.
     5711     define buffer bf_cli_trn-doc-sum  for ub.trn-doc-sum.
     5712     define buffer wast-cur-inv-doc    for ub.trn-doc.
     5713     define buffer bf_goods            for ub.goods.
     5714     define buffer buf_sale-doc        for ub.sale-doc.
     5715     define variable varwast-sum-sale-base      like ub.doc-line.price-base no-undo.
     5716     define variable varwast-sum-sale-rubl      like ub.doc-line.price-base no-undo.
     5717     define variable varwast-sum-sale-base-line like ub.doc-line.price-base no-undo.
     5718     define variable varwast-sum-sale-rubl-line like ub.doc-line.price-base no-undo.
     5719     define variable varwast-sum-base-line      like ub.doc-line.price-base no-undo.
     5720     define variable varwast-sum-rubl-line      like ub.doc-line.price-base no-undo.
     5721     define variable varwast-fact-qnty-line     like ub.doc-line.fact-qnty  no-undo.
     5722     define variable varwast-cli-qnty-line      like ub.doc-line.cli-qnty   no-undo.
     5723     define variable v_invclcsp              as character no-undo.
     5724     define variable v_data-type             as character no-undo.
     5725     define variable v-is-petrol             as logical   no-undo.
     5726     define variable v-is-pieces             as logical   no-undo.
     5727     define variable NormWast                as class ibs.th.ref.normwastsub no-undo.
     5728     define variable v-normal-wastage        as decimal   no-undo.
     5729     define variable attr-type               as character no-undo.
     5730     define variable v-petrol                as logical   no-undo.
     5731     define variable v-value                 as character no-undo.
     5732     define variable v-type                  as character no-undo.
     5733     define variable v-sign                  as integer   no-undo.
     5734     do on error undo, return error return-value :
     5735       run waitfram-show in p-wasthandle ( input 'Подсчет фондов естественной убыли по товарам в инвентаризации.' ) no-error.
     5736       if not valid-handle( p-wasthandle ) then do:
     5737         assign p-wasthandle = this-procedure :handle.
     5738       end.
     5739       for each tt-wast-line:
     5740         delete tt-wast-line.
     5741       end.
     5742       find first wast-cur-trn-doc where
     5743                  wast-cur-trn-doc.doc-code = p-doc-code no-error.
     5744       if not available wast-cur-trn-doc then do:
     5745         return error substitute( 'Не найден документ с номером "&1".', p-doc-code).
     5746       end.
     5747   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5748   empty temp-table thbjattr_thbj-attr.
     5749   run adm/shattri.p (
     5750      input "get":U
     5751     ,input wast-cur-trn-doc.obj-type
     5752     ,input wast-cur-trn-doc.obj-code
     5753     ,input 'inv-obj':U
     5754     ,input  ""
     5755     ,output v-value-character
     5756     ,output v-value-date
     5757     ,output v-value-decimal
     5758     ,output v-value-integer
     5759     ,output v-value-logical
     5760     ,output par-type
     5761     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     5762     ) no-error .
     5763       for each thbjattr_thbj-attr :
     5764           if thbjattr_thbj-attr.prop-code = 'invclcsp'  then v_invclcsp = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
     5765       end.
     5766       empty temp-table thbjattr_thbj-attr.
     5767       find first wast-cur-inv-doc exclusive-lock where
     5768                  wast-cur-inv-doc.doc-code = p-doc-code.
     5769       for  each wast-cur-doc-line where
     5770                 wast-cur-doc-line.doc-code = p-doc-code
     5771         , first bf_goods  no-lock where
     5772                 bf_goods.artic     = wast-cur-doc-line.artic     and
     5773                 bf_goods.prod-type = wast-cur-doc-line.prod-type and
     5774                 bf_goods.prod-code = wast-cur-doc-line.prod-code
     5775       on error undo, return error return-value :
     5776   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     5777     (
     5778        input bf_goods.artic
     5779     ,  input bf_goods.prod-type
     5780     ,  input bf_goods.prod-code
     5781     , output v-is-petrol
     5782     , output v-is-pieces
     5783     ) .
     5784         if  v-is-petrol = yes
     5785         and v-is-pieces = no
     5786         then do :
     5787           run gds-attr-value in this-procedure (
     5788                                            input bf_goods.gds-code
     5789                                           ,input 'ptrl-as-good':U
     5790                                           ,output v-value
     5791                                           ,output v-type) no-error.
     5792           assign v-petrol = if logical(v-value) then no else yes .
     5793         end.
     5794         if v-petrol then do:
     5795           NormWast = new ibs.th.ref.normwastsub ().
     5796           NormWast:ParGdsOAttr:GdsCode = bf_goods.gds-code.
     5797           NormWast:ParGdsOAttr:ObjType = wast-cur-trn-doc.obj-type.
     5798           NormWast:ParGdsOAttr:ObjCode = wast-cur-trn-doc.obj-code.
     5799           NormWast:ParGdsOAttr:OnDate = if wast-cur-trn-doc.fact-date <> ? then wast-cur-trn-doc.fact-date else wast-cur-trn-doc.doc-date.
     5800           run gds-o-normal-wastage-value in this-procedure
     5801                             ( input-output NormWast
     5802                             ) no-error.
     5803           v-normal-wastage = NormWast:NormalWastageDate.
     5804         end.
     5805         else do:
     5806           assign v-normal-wastage = if bf_goods.normal-wastage <> 0 and bf_goods.normal-wastage <> ? then bf_goods.normal-wastage  else 0 .
     5807         end.
     5808         if v-normal-wastage <> 0 and
     5809            v-normal-wastage <> ? then do:
     5810           create tt-wast-line.
     5811           buffer-copy wast-cur-doc-line to tt-wast-line.
     5812         end.
     5813       end.
     5814       if can-find( first tt-wast-line ) then do:
     5815         for each wast-trn-doc no-lock where
     5816                  wast-trn-doc.obj-type     = wast-cur-inv-doc.obj-type and
     5817                  wast-trn-doc.obj-code     = wast-cur-inv-doc.obj-code and
     5818                  wast-trn-doc.status_      = 'факт':U                   and
     5819                  wast-trn-doc.doc-type     = 'инв':U              and
     5820                  wast-trn-doc.internal     = no                        and
     5821                  wast-trn-doc.ext-doc-type = 'vt':U              use-index stat-fact
     5822               by wast-trn-doc.fact-order descending
     5823         on error undo, return error return-value :
     5824           if wast-cur-inv-doc.fact-order <> 0 then do:
     5825             if wast-trn-doc.fact-order >= wast-cur-inv-doc.fact-order then do: next. end.
     5826           end.
     5827           for  each tt-wast-line  no-lock where
     5828                     tt-wast-line.prev-inv-fact-order = 0 use-index prev-inv-fact-order
     5829             , first wast-doc-line no-lock where
     5830                     wast-doc-line.doc-code  = wast-trn-doc.doc-code  and
     5831                     wast-doc-line.artic     = tt-wast-line.artic     and
     5832                     wast-doc-line.prod-type = tt-wast-line.prod-type and
     5833                     wast-doc-line.prod-code = tt-wast-line.prod-code
     5834           on error undo, return error return-value :
     5835             assign tt-wast-line.prev-inv-fact-order = wast-doc-line.fact-order.
     5836           end.
     5837           if not can-find( first tt-wast-line where tt-wast-line.prev-inv-fact-order = 0 ) then do: leave. end.
     5838         end.
     5839         for  each tt-wast-line
     5840           , first wast-goods   no-lock where
     5841                   wast-goods.artic     = tt-wast-line.artic     and
     5842                   wast-goods.prod-type = tt-wast-line.prod-type and
     5843                   wast-goods.prod-code = tt-wast-line.prod-code
     5844         on error undo, return error return-value :
     5845           run waitfram-show in p-wasthandle ( input substitute( 'Подсчет фонда естественной убыли по товару &1 &2 &3.'
     5846                                                               , tt-wast-line.artic
     5847                                                               , tt-wast-line.prod-type
     5848                                                               , tt-wast-line.prod-code ) ) no-error.
     5849   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     5850     (
     5851        input tt-wast-line.artic
     5852     ,  input tt-wast-line.prod-type
     5853     ,  input tt-wast-line.prod-code
     5854     , output v-is-petrol
     5855     , output v-is-pieces
     5856     ) .
     5857         if  v-is-petrol = yes
     5858         and v-is-pieces = no
     5859         then do :
     5860           run gds-attr-value in this-procedure (
     5861                                            input bf_goods.gds-code
     5862                                           ,input 'ptrl-as-good':U
     5863                                           ,output v-value
     5864                                           ,output v-type) no-error.
     5865           assign v-petrol = if logical(v-value) then no else yes .
     5866         end.
     5867         else do:
     5868           assign v-petrol = no .
     5869         end.
     5870         if v-petrol then do:
     5871           NormWast = new ibs.th.ref.normwastsub ().
     5872           NormWast:ParGdsOAttr:GdsCode = bf_goods.gds-code.
     5873           NormWast:ParGdsOAttr:ObjType = wast-cur-trn-doc.obj-type.
     5874           NormWast:ParGdsOAttr:ObjCode = wast-cur-trn-doc.obj-code.
     5875           NormWast:ParGdsOAttr:OnDate = if wast-cur-trn-doc.fact-date <> ? then wast-cur-trn-doc.fact-date else wast-cur-trn-doc.doc-date.
     5876           run gds-o-normal-wastage-value in this-procedure
     5877                             ( input-output NormWast
     5878                             ) no-error.
     5879           v-normal-wastage = NormWast:NormalWastageDate.
     5880         end.
     5881         else do:
     5882           assign
     5883             v-normal-wastage = if wast-goods.normal-wastage <> 0 and wast-goods.normal-wastage <> ? then wast-goods.normal-wastage  else 0
     5884           .
     5885         end.
     5886           if tt-wast-line.prev-inv-fact-order = 0 then do:
     5887             if tt-wast-line.fact-order = 0 then do:
     5888   assign
     5889     varwast-sum-sale-base-line = 0
     5890     varwast-sum-sale-rubl-line = 0
     5891     varwast-fact-qnty-line     = 0
     5892     varwast-cli-qnty-line      = 0
     5893     varwast-sum-base-line      = 0
     5894     varwast-sum-rubl-line      = 0
     5895     .
     5896    if v-petrol then do:
     5897      for each wast-exp-line where wast-exp-line.obj-type  = tt-wast-line.obj-type  and
     5898                                   wast-exp-line.obj-code  = tt-wast-line.obj-code  and
     5899                                   wast-exp-line.prod-type = tt-wast-line.prod-type and
     5900                                   wast-exp-line.prod-code = tt-wast-line.prod-code and
     5901                                   wast-exp-line.artic     = tt-wast-line.artic     and
     5902                                   wast-exp-line.status_   = 'факт':U
     5903                                   no-lock ,
     5904                 first wast-exp-doc where  wast-exp-doc.obj-type       = wast-exp-line.obj-type  and
     5905                                           wast-exp-doc.obj-code       = wast-exp-line.obj-code  and
     5906                                           wast-exp-doc.doc-code       = wast-exp-line.doc-code  and
     5907                                           wast-exp-doc.internal       = no                      and
     5908                                           wast-exp-doc.doc-type       = 'при':U               and
     5909                                           wast-exp-doc.is-del         = false                   and
     5910                                           wast-exp-doc.ext-doc-type   = 'ie':U
     5911                                           and (not can-find (first buf_sale-doc
     5912                                                              where buf_sale-doc.doc-code = wast-exp-doc.doc-code
     5913                                                                and buf_sale-doc.doc-kind = 'itr':U))
     5914                                           or
     5915                                           wast-exp-doc.obj-type       = wast-exp-line.obj-type  and
     5916                                           wast-exp-doc.obj-code       = wast-exp-line.obj-code  and
     5917                                           wast-exp-doc.doc-code       = wast-exp-line.doc-code  and
     5918                                           wast-exp-doc.internal       = no                      and
     5919                                           wast-exp-doc.doc-type       = 'рас':U              and
     5920                                           wast-exp-doc.ext-doc-type   = 'ep':U   and
     5921                                           wast-exp-doc.is-del         = false
     5922                                           no-lock on error undo, return error return-value :
     5923       if wast-exp-doc.ext-doc-type = 'ie':U then do:
     5924         assign v-sign = 1.
     5925       end.
     5926       else do:
     5927         assign v-sign = -1.
     5928       end.
     5929       assign
     5930         varwast-sum-sale-base = 0
     5931         varwast-sum-sale-rubl = 0.
     5932       for each wast-exp-gds-dtl where wast-exp-gds-dtl.doc-code  = wast-exp-line.doc-code  and
     5933                                       wast-exp-gds-dtl.artic     = wast-exp-line.artic     and
     5934                                       wast-exp-gds-dtl.prod-type = wast-exp-line.prod-type and
     5935                                       wast-exp-gds-dtl.prod-code = wast-exp-line.prod-code no-lock :
     5936         assign
     5937           varwast-sum-sale-base = varwast-sum-sale-base + (wast-exp-gds-dtl.price-base - wast-exp-gds-dtl.discnt-base) * wast-exp-gds-dtl.fact-qnty
     5938           varwast-sum-sale-rubl = varwast-sum-sale-rubl + (wast-exp-gds-dtl.price-rubl - wast-exp-gds-dtl.discnt-rubl) * wast-exp-gds-dtl.fact-qnty
     5939         .
     5940       end.
     5941       assign
     5942         varwast-fact-qnty-line     = varwast-fact-qnty-line     + wast-exp-line.fact-qnty * v-sign
     5943         varwast-cli-qnty-line      = varwast-cli-qnty-line      + wast-exp-line.cli-qnty  * v-sign
     5944         varwast-sum-sale-base-line = varwast-sum-sale-base-line + varwast-sum-sale-base   * v-sign
     5945         varwast-sum-sale-rubl-line = varwast-sum-sale-rubl-line + varwast-sum-sale-rubl   * v-sign
     5946         varwast-sum-base-line      = varwast-sum-base-line      + wast-exp-line.fact-qnty * wast-exp-line.price-base * v-sign
     5947         varwast-sum-rubl-line      = varwast-sum-rubl-line      + wast-exp-line.fact-qnty * wast-exp-line.price-rubl * v-sign
     5948         .
     5949     end.
     5950    end.
     5951    else do:
     5952     for each wast-exp-line where wast-exp-line.obj-type  = tt-wast-line.obj-type  and
     5953                                   wast-exp-line.obj-code  = tt-wast-line.obj-code  and
     5954                                   wast-exp-line.prod-type = tt-wast-line.prod-type and
     5955                                   wast-exp-line.prod-code = tt-wast-line.prod-code and
     5956                                   wast-exp-line.artic     = tt-wast-line.artic     and
     5957                                   wast-exp-line.status_   = 'факт':U
     5958                                   no-lock ,
     5959                 first wast-exp-doc where  wast-exp-doc.obj-type       = wast-exp-line.obj-type  and
     5960                                           wast-exp-doc.obj-code       = wast-exp-line.obj-code  and
     5961                                           wast-exp-doc.doc-code       = wast-exp-line.doc-code  and
     5962                                           wast-exp-doc.internal       = no                      and
     5963                                           wast-exp-doc.doc-type       = 'рас':U              and
     5964                                           wast-exp-doc.is-del         = false                   and
     5965                                           wast-exp-doc.ext-doc-type   = 'ee':U      or
     5966                                           wast-exp-doc.obj-type       = wast-exp-line.obj-type  and
     5967                                           wast-exp-doc.obj-code       = wast-exp-line.obj-code  and
     5968                                           wast-exp-doc.doc-code       = wast-exp-line.doc-code  and
     5969                                           wast-exp-doc.internal       = no                      and
     5970                                           wast-exp-doc.doc-type       = 'рас':U              and
     5971                                           wast-exp-doc.ext-doc-type   = 'es':U and
     5972                                           wast-exp-doc.is-del         = false
     5973                                           no-lock on error undo, return error return-value :
     5974       assign
     5975         varwast-sum-sale-base = 0
     5976         varwast-sum-sale-rubl = 0.
     5977       for each wast-exp-gds-dtl where wast-exp-gds-dtl.doc-code  = wast-exp-line.doc-code  and
     5978                                       wast-exp-gds-dtl.artic     = wast-exp-line.artic     and
     5979                                       wast-exp-gds-dtl.prod-type = wast-exp-line.prod-type and
