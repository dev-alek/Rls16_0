     8194   procedure lib-rwds_rcallfct :
     8195     define input        parameter           p-doc-code    like ub.trn-doc.doc-code no-undo.
     8196     define input        parameter           p-calc-wast   as   logical             no-undo.
     8197     define input        parameter           p-calc-addsum as   logical             no-undo.
     8198     define input        parameter           p-rwdshandle  as   handle              no-undo.
     8199     define input-output parameter table for tt-wast-line.
     8200     define input-output parameter table for tt-allsum-line.
     8201     define input-output parameter table for tt-doc-line-sum.
     8202     define input-output parameter table for tt-clcparts.
     8203     define input-output parameter table for temp-parts.
     8204     define variable v_attr-value as character no-undo.
     8205     define variable v_type       as character no-undo.
     8206     define variable v_wastage    as character no-undo.
     8207     define variable v_invclcsp   as character no-undo.
     8208     define variable v_data-type  as character no-undo.
     8209     define variable jj_count     as integer   no-undo.
     8210     define variable j#time       as integer   no-undo.
     8211     define variable v_message    as character no-undo.
     8212     define buffer bf_trn-doc      for ub.trn-doc.
     8213     define buffer bf_doc-line     for ub.doc-line.
     8214     define buffer bf_goods        for ub.goods.
     8215     define buffer bf_trn-doc-sum  for ub.trn-doc-sum.
     8216     define buffer bf_doc-line-sum for ub.doc-line-sum.
     8217     do transaction on error undo, return error return-value :
     8218       assign j#time = time.
     8219       if not valid-handle( p-rwdshandle ) then do:
     8220         assign p-rwdshandle = this-procedure :handle.
     8221       end.
     8222       find first bf_trn-doc where
     8223                  bf_trn-doc.doc-code = p-doc-code no-error.
     8224       if not available bf_trn-doc then do:
     8225         return error substitute( 'Не найден документ с номером "&1".', p-doc-code ).
     8226       end.
     8227   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8228   empty temp-table thbjattr_thbj-attr.
     8229   run adm/shattri.p (
     8230      input "get":U
     8231     ,input bf_trn-doc.obj-type
     8232     ,input bf_trn-doc.obj-code
     8233     ,input 'inv-obj':U
     8234     ,input  ""
     8235     ,output v-value-character
     8236     ,output v-value-date
     8237     ,output v-value-decimal
     8238     ,output v-value-integer
     8239     ,output v-value-logical
     8240     ,output par-type
     8241     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     8242     ) no-error .
     8243       for each thbjattr_thbj-attr :
     8244           if thbjattr_thbj-attr.prop-code = 'invclcsp'  then v_invclcsp = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
     8245           if thbjattr_thbj-attr.prop-code = 'wastage'   then v_wastage  = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
     8246       end.
     8247       empty temp-table thbjattr_thbj-attr.
     8248   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input bf_trn-doc.doc-code ,
     8249                           input 'addsum':U ,
     8250                          output v_attr-value ,
     8251                          output v_type ) no-error .
     8252       if error-status :error then do:
     8253         return error substitute( 'Ошибка при вызове процедуры tdat-value&3&1&3&2.',
     8254                                  return-value, error-status :get-message( 1 ), chr(10) ).
     8255       end.
     8256       if v_wastage   = "yes" and
     8257          p-calc-wast =  yes  then do:
     8258         if lookup( 'wst':U, v_attr-value ) = 0 then do:
     8259           find first bf_trn-doc-sum where
     8260                      bf_trn-doc-sum.doc-code = bf_trn-doc.doc-code and
     8261                      bf_trn-doc-sum.sum-type = 'wst':U  no-error.
     8262           if not available bf_trn-doc-sum then do:
     8263             run waitfram-show in p-rwdshandle ( input substitute( 'Создаем запись для сумм типа "&1". Время: &2.'
     8264                                                                 , 'wst':U
     8265                                                                 , string( time - j#time, "hh:mm:ss":U ) ) ) no-error.
     8266             run lib-rwds_crtrnsum in this-procedure ( input bf_trn-doc.doc-code
     8267                                                     , input 'wst':U  ) no-error.
     8268             if error-status :error then do:
     8269               run waitfram-hide in p-rwdshandle no-error.
     8270               undo, return error substitute(
     8271                 'Ошибка &1 &2 на вызове программы lib-rwds_crtrnsum при расчете естественной убыли по документу "&3".',
     8272                 return-value, error-status :get-message( 1 ), bf_trn-doc.doc-code ).
     8273             end.
     8274             assign jj_count = 0.
     8275             for each bf_doc-line where
     8276                      bf_doc-line.doc-code = bf_trn-doc.doc-code
     8277             on error undo, return error return-value :
     8278               assign jj_count = jj_count + 1.
     8279               run waitfram-join in p-rwdshandle (  input substitute( 'Создаем записи строк сумм типа "&1".'
     8280                                                                    , 'wst':U )
     8281                                                 ,  input substitute( 'Обработано строк: &1', jj_count )
     8282                                                 ,  input substitute( 'Время &1.', string( time - j#time, "hh:mm:ss":U ) )
     8283                                                 , output v_message ).
     8284               run waitfram-show in p-rwdshandle (  input v_message ) no-error.
     8285               run lib-rwds_crlinsum in this-procedure ( input bf_doc-line.doc-code
     8286                                                       , input 'wst':U
     8287                                                       , input bf_doc-line.artic
     8288                                                       , input bf_doc-line.prod-type
     8289                                                       , input bf_doc-line.prod-code ) no-error.
     8290               if error-status :error then do:
     8291                 run waitfram-hide in p-rwdshandle no-error.
     8292                 undo, return error return-value.
     8293               end.
     8294             end.
     8295           end.
     8296           else do:
     8297             run waitfram-show in p-rwdshandle ( input substitute( 'Очищаем запись для сумм типа "&1". Время &2.'
     8298                                                                 , 'wst':U
     8299                                                                 , string( time - j#time, "hh:mm:ss":U ) ) ) no-error.
