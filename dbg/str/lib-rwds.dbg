     4539                bf_trn-doc-sum.crsa-SLT-rubl       = 0
     4540                bf_trn-doc-sum.crsa-road-tax-base  = 0
     4541                bf_trn-doc-sum.crsa-road-tax-rubl  = 0
     4542                bf_trn-doc-sum.crsa-excise-base    = 0
     4543                bf_trn-doc-sum.crsa-excise-rubl    = 0
