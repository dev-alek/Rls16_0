     2555     (input  bf_trn-doc.obj-type
     2556     ,input  bf_trn-doc.obj-code
     2557     ,input  varb-code
     2558     ,input  0
     2559     ,input  bf_trn-doc.fact-order
     2560     ,output vardoc-num
     2561     ,output varprice-sale
     2562     ,output varroad-tax
     2563     ,output varexcise
     2564     )  .
     2565             if varprice-sale = ?
     2566             then do:
     2567               assign
     2568                 varprice-sale = 0
     2569                 varroad-tax   = 0
     2570                 varexcise     = 0
     2571               .
     2572             end.
     2573             assign
     2574               varlastcur-base     = varprice-sale
     2575               varlastcur-road-tax = varroad-tax
     2576               varlastcur-excise   = varexcise
     2577               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2578               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2579               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2580               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2581             .
     2582         end.
     2583       end.
     2584       if varcur-fact-qnty = 0 then do:
     2585         assign
     2586           varcur-base      = varlastcur-base
     2587           varcur-road-tax  = varlastcur-road-tax
     2588           varcur-excise    = varlastcur-excise
     2589         .
     2590       end.
     2591       else do:
     2592         assign
     2593           varcur-base      = varcur-base      / varcur-fact-qnty
     2594           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2595           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2596         .
     2597       end.
     2598       if varcur-vat-pc = ?
     2599       then do:
     2600         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2601       end.
     2602       if varcur-slt-pc = ?
