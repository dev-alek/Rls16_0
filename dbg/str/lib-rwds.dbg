     4569   procedure lib-rwds_crlinsum :
     4570     define input parameter p-doc-code  like ub.trn-doc.doc-code      no-undo.
     4571     define input parameter p-sum-type  like ub.doc-line-sum.sum-type no-undo.
     4572     define input parameter p-artic     like ub.goods.artic           no-undo.
     4573     define input parameter p-prod-type like ub.goods.prod-type       no-undo.
     4574     define input parameter p-prod-code like ub.goods.prod-code       no-undo.
     4575     define buffer bf_doc-line-sum for ub.doc-line-sum.
     4576     define buffer bf_goods        for ub.goods.
     4577     define buffer bf_trn-doc      for ub.trn-doc.
     4578     do on error undo, return error return-value :
     4579       find first bf_goods no-lock where
     4580                  bf_goods.artic     = p-artic     and
     4581                  bf_goods.prod-type = p-prod-type and
     4582                  bf_goods.prod-code = p-prod-code no-error.
     4583       if not available bf_goods then do:
     4584         return error substitute( 'Ошибка в процедуре lib-rwds_crlinsum. Не найден товар &1 &2 &3.',
     4585                                  p-artic, p-prod-type, p-prod-code ).
     4586       end.
     4587       find first bf_trn-doc where
     4588                  bf_trn-doc.doc-code = p-doc-code no-error.
     4589       if not available bf_trn-doc then do:
     4590         return error substitute( 'Ошибка в процедуре lib-rwds_crlinsum. Не найден документ с номером "&1".', p-doc-code ).
     4591       end.
     4592       find first bf_doc-line-sum where
     4593                  bf_doc-line-sum.doc-code = bf_trn-doc.doc-code and
     4594                  bf_doc-line-sum.gds-code = bf_goods.gds-code   and
     4595                  bf_doc-line-sum.sum-type = p-sum-type          no-error.
     4596       if available bf_doc-line-sum then do:
     4597         return error substitute( 'Уже есть строка сумм с типом "&1" по документу "&2" товар с внутренним номером &3.',
     4598                                  p-sum-type, bf_trn-doc.doc-code, bf_goods.gds-code ).
     4599       end.
     4600       create bf_doc-line-sum.
     4601       assign bf_doc-line-sum.doc-code     = bf_trn-doc.doc-code
     4602              bf_doc-line-sum.ext-doc-type = bf_trn-doc.ext-doc-type
     4603              bf_doc-line-sum.obj-type     = bf_trn-doc.obj-type
     4604              bf_doc-line-sum.obj-code     = bf_trn-doc.obj-code
     4605              bf_doc-line-sum.gds-code     = bf_goods.gds-code
     4606              bf_doc-line-sum.sum-type     = p-sum-type.
     4607     end.
     4608   end procedure.
     4609   procedure lib-rwds_cllinsum :
     4610     define input parameter p-doc-code  like ub.trn-doc.doc-code      no-undo.
