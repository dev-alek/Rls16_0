     4555                bf_trn-doc-sum.cost-SLT-rubl       = 0
     4556                bf_trn-doc-sum.cost-road-tax-base  = 0
     4557                bf_trn-doc-sum.cost-road-tax-rubl  = 0
     4558                bf_trn-doc-sum.cost-excise-base    = 0
     4559                bf_trn-doc-sum.cost-excise-rubl    = 0
