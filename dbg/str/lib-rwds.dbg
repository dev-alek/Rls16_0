     2693   end.
     2694   procedure clcprtsl_calc-ttable :
     2695   define input parameter paris-doc           as   logical                 no-undo.
     2696   define input parameter paris-cur           as   logical                 no-undo.
     2697   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2698   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2699   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2700   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2701   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2702   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2703   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2704   define input parameter parr-b              as   character               no-undo.
     2705   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2706   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2707   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2708   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2709   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2710   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2711   define buffer bf_tt-allsum      for tt-allsum.
     2712   define buffer bf_tt-clcparts    for tt-clcparts.
     2713   define buffer bf_tt-allsum-line for tt-allsum-line.
     2714   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2715   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2716   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2717   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2718   define variable varexcise          like ub.price-list.excise     no-undo.
     2719   do on error undo, return error return-value :
     2720   for each bf_tt-allsum-line
     2721   on error undo, return error return-value
     2722    :
     2723     delete bf_tt-allsum-line.
     2724   end.
     2725   for each bf_tt-allsum
     2726   on error undo, return error return-value
     2727   :
     2728     delete bf_tt-allsum.
     2729   end.
     2730   for each bf_tt-clcparts
     2731   on error undo, return error return-value
     2732   :
     2733   if v-calcbypart then do:
     2734             assign
     2735             parcur-base =   bf_tt-clcparts.part-cur-base
     2736             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2737             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2738             .
     2739   end.
     2740      run clcprtsl_calc-parts in this-procedure (
     2741        input recid(bf_tt-clcparts),
     2742        input paris-doc,
     2743        input paris-cur,
     2744        input parroad-tax,
     2745        input parexcise,
     2746        input parvat-pc,
     2747        input parcons-vat-pc,
     2748        input parslt-pc,
     2749        input parbase-rate,
     2750        input parbase-scale,
     2751        input parr-b,
     2752        input parcur-base,
     2753        input parcur-road-tax,
     2754        input parcur-excise,
     2755        input parcur-vat-pc,
     2756        input parcurcons-vat-pc,
     2757        input parcurslt-pc
     2758        ) no-error.
     2759     if error-status:error then do:
     2760       message
     2761         vss-workfile vss-revision vss-description skip
     2762         vss-include-info8 skip
     2763         "Ошибка при обсчете партии" skip
     2764         "Документ партии " bf_tt-clcparts.out-code skip
     2765         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2766         return-value skip
     2767         error-status:get-message(1) skip
     2768         error-status:get-message(2) skip
     2769         error-status:get-message(3) skip
     2770         view-as alert-box error .
     2771       undo, return error .
     2772     end.
     2773     for each bf_tt-allsum on error undo, return error return-value :
     2774       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2775       if not available bf_tt-allsum-line then do:
     2776         create bf_tt-allsum-line.
     2777         assign
     2778           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     2779       end.
     2780       assign
     2781         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     2782         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     2783         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     2784         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     2785         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     2786         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     2787         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     2788         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     2789         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     2790         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     2791         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     2792         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     2793         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     2794         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     2795         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     2796         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     2797         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     2798         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     2799         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     2800         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     2801         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     2802         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     2803         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     2804         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
