     2840   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2841   define variable v-waitfram-action01         as character   no-undo .
     2842   define variable v-waitfram-action02         as character   no-undo .
     2843   define variable v-waitfram-action03         as character   no-undo .
     2844   define variable mWaitFramTextBeg            as character   no-undo.
     2845   define variable mWaitFramTextEnd            as character   no-undo.
     2846   define variable mWaitFramView               as logical     no-undo.
     2847   define variable mWaitProcEvent              as logical     no-undo init yes.
     2848   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2849   define variable mWaitFramStop               as logical     no-undo.
     2850   define variable mWaitFramStopUser           as logical     no-undo.
     2851   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2852   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2853   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2854   define button B-WaitFramStop auto-end-key
     2855        label "Стоп"
     2856        size 10 by 1 tooltip "Остоновить процесс".
     2857   define button B-viewProcInfo
     2858        label "Информация"
     2859        size 15 by 1 tooltip "Информация о процесс".
     2860   define frame waitfram
     2861     v-waitfram-action01 format "x(72)" no-label skip
     2862     v-waitfram-action02 format "x(72)" no-label skip
     2863     v-waitfram-action03 format "x(72)" no-label skip
     2864     B-viewProcInfo
     2865     B-WaitFramStop at row 4 col 30
     2866     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2867     .
     2868   define new global shared variable mBatchMode as logical no-undo init ?.
     2869   define variable mFramBachModHandle as handle no-undo.
     2870   mFramBachModHandle = frame waitfram:handle.
     2871   define variable mFameOldVis as logical no-undo.
     2872   define variable mVisCUrentVin as logical no-undo.
     2873   if session:batch-mode
     2874   then
     2875      mBatchMode = yes.
     2876   if mBatchMode = ? then do:
     2877     mVisCUrentVin = current-window:visible.
     2878     mFameOldVis = mFramBachModHandle:visible.
     2879     mFramBachModHandle:visible  = yes.
     2880     mBatchMode = mFramBachModHandle:visible ne yes.
     2881     mFramBachModHandle:visible = mFameOldVis.
     2882     current-window:visible = mVisCUrentVin.
     2883   end.
     2884    if  log-manager:logfile-name ne ?
     2885     then DO:
     2886         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2887         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2888         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2889     end.
     2890   on choose of B-WaitFramStop in frame waitfram
     2891   do:
     2892     mWaitFramStop = yes.
     2893     mWaitFramStopUser = yes.
     2894   end.
     2895   function waitfram-check-timeout returns logical():
     2896      define variable vtime as int64 no-undo.
     2897      if mWaitFramStopTimeOut
     2898      then
     2899         return yes.
     2900      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2901      if     mWaitFramTimeOut ne ?
     2902         and mWaitFramTimeOut ne 0
     2903         and mWaitFramTimeOut lt vtime
     2904      then do:
     2905         mWaitFramStopTimeOut = yes.
     2906      end.
     2907      return mWaitFramStopTimeOut.
     2908   end.
     2909   procedure waitfram-hide :
     2910     if not session:batch-mode
     2911     then do
     2912     on error undo, return error return-value
     2913     :
     2914       pause 0 before-hide .
     2915       if not mBatchMode then
     2916         hide frame waitfram .
     2917     if     not mWaitFramView
     2918        and mWaitProcEvent
     2919     then
     2920       process events .
     2921     end.
     2922   end procedure.
     2923   procedure waitfram-show :
     2924     define input  parameter p-message as character no-undo .
     2925     define variable v-left-margin as integer   no-undo .
     2926     if not session:batch-mode
     2927     then do
     2928     on error undo, return error return-value
     2929     :
     2930       if length(p-message) <= 70 then do:
     2931         assign
     2932           v-left-margin = integer((70 - length(p-message)) / 2)
     2933         .
     2934         assign
     2935           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2936         .
     2937         assign
     2938           v-waitfram-action01 = " "
     2939           v-waitfram-action02 = " "
     2940                                    + fill(" ", v-left-margin)
     2941                                    + p-message
     2942           v-waitfram-action03 = " "
     2943         .
     2944       end.
     2945       else do:
     2946         define variable vRindex1 as integer no-undo.
     2947         define variable vRindex2 as integer no-undo.
     2948         vRindex1 = r-index(p-message," ",70).
     2949         if vRindex1 = 0
     2950         then
     2951            vRindex1 = 70.
     2952         if length(p-message)  <= vRindex1 + 70 then do:
     2953           assign
     2954             v-waitfram-action01 = " "
     2955             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2956             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2957           .
     2958         end.
     2959         else do:
     2960           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2961           if vRindex2 <= vRindex1
     2962           then
     2963              vRindex2 = vRindex1 + 70.
     2964           assign
     2965             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2966             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2967             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2968           .
     2969         end.
     2970       end.
     2971       B-viewProcInfo:visible   in frame waitfram = no.
     2972       B-viewProcInfo:sensitive in frame waitfram = no.
     2973       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2974       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2975       if  (   mWaitFramView
     2976          or  mWaitProcEvent)
     2977          and not mBatchMode
     2978       then
     2979          display
     2980             v-waitfram-action01 skip
     2981             v-waitfram-action02 skip
     2982             v-waitfram-action03 skip
     2983          with frame waitfram .
     2984       if     mWaitFramView
     2985          then do:
     2986             if     mWaitFramInterval ne ?
     2987                and not mBatchMode
     2988             then
     2989                wait-for go of frame waitfram pause mWaitFramInterval.
     2990          end.
     2991          else
     2992             if     mWaitProcEvent
     2993                and not mBatchMode
     2994             then
     2995                process events .
     2996     end.
     2997   end procedure.
     2998      procedure waitfram-show-this:
     2999         define input  parameter iInterval as int64 no-undo.
     3000         define variable vtime as int64 no-undo.
     3001         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3002         mWaitFramInterval = iInterval.
     3003         run waitfram-show (substitute("&1&2 &3&4" ,
     3004                                       mWaitFramTextBeg ,
     3005                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3006                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3007                                       mWaitFramTextEnd
     3008                                      )
     3009                           ).
     3010      end.
     3011      procedure WaitFramRunPause:
     3012         define input  parameter iInterval as dec no-undo.
     3013         define variable vStart  as datetime-tz no-undo.
     3014         define variable vend    as datetime-tz no-undo.
     3015         define variable vint as int64 no-undo.
     3016         define variable vOk as logical no-undo.
     3017         vStart = now.
     3018         vend   = vStart.
     3019         publish "WaitFramPause" (iInterval,output vOk).
     3020         vend   =  now.
     3021         vint = vend - vStart.
     3022         vint = iInterval - vint / 1000.
     3023         if     not mWaitFramStop
     3024            and (   vint > 0
     3025                 or (    not vOk
     3026                     and iInterval eq ?
     3027                     )
     3028                 )
     3029         then
     3030            run waitfram-show-this (iInterval).
     3031         vend   =  now.
     3032         vint = vend - vStart.
     3033         vint = iInterval - vint / 1000.
     3034         if     not mWaitFramStop
     3035            and vint > 0
     3036         then do:
     3037            run gbl/pause.p (vint * 1000).
     3038         end.
     3039         if iInterval ne ?
     3040         then
     3041            publish "WaitFramStop".
     3042         waitfram-check-timeout().
     3043      end.
     3044      procedure WaitFramWaitFor:
     3045         define input  parameter iInterval as dec no-undo.
     3046         assign
     3047            mWaitFramStartProc   = now
     3048            mWaitFramStopUser    = no
     3049            mWaitFramStopTimeOut = no
     3050         .
     3051         block-wait:
     3052         do while not mWaitFramStop:
     3053            run WaitFramRunPause (iInterval).
     3054            if  waitfram-check-timeout()
     3055            then do:
     3056               leave block-wait.
     3057            end.
     3058         end.
     3059         run waitfram-hide.
     3060      end.
     3061   procedure waitfram-join :
     3062     define input  parameter p-line-1  as character no-undo .
     3063     define input  parameter p-line-2  as character no-undo .
     3064     define input  parameter p-line-3  as character no-undo .
     3065     define output parameter p-message as character no-undo .
     3066     do
     3067     on error undo, return error return-value
     3068     :
     3069       assign
     3070         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3071                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3072                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3073       .
     3074     end.
     3075   end procedure.
     3076   function waitfram-join-function returns character
     3077     (input p-line-1 as character
     3078     ,input p-line-2 as character
     3079     ,input p-line-3 as character
     3080     ).
     3081     define variable v-message as character no-undo .
     3082     run waitfram-join in this-procedure
     3083       (input  p-line-1
     3084       ,input  p-line-2
     3085       ,input  p-line-3
     3086       ,output v-message
     3087       ) .
     3088     return v-message .
     3089   end function .
     3090   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3091   procedure factord :
     3092     define input  parameter p-fact-date            as date    no-undo .
     3093     define input  parameter p-fact-time            as integer no-undo .
     3094     define input  parameter p-fact-num             as integer no-undo .
     3095     define input  parameter p-shift-date           as date    no-undo .
     3096     define input  parameter p-shift-num            as integer no-undo .
     3097     define input  parameter p-shift-on             as logical no-undo .
     3098     define output parameter p-fact-order           as decimal no-undo .
     3099     define output parameter p-shift-end-fact-order as decimal no-undo .
     3100     define output parameter p-day-end-fact-order   as decimal no-undo .
     3101     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     3102     if p-fact-date = ?
     3103     then do:
     3104       return error "Не указана фактическая дата" .
     3105     end.
     3106     define variable v-fact-date-num as integer no-undo .
     3107     assign
     3108       v-fact-date-num = integer(p-fact-date)
     3109     .
     3110     if p-fact-num = ?
     3111     or p-fact-num = 0
     3112     then do:
     3113       return error "Не задан p-fact-num " + string(p-fact-num) .
     3114     end.
     3115     if p-fact-num < 0
     3116     then do:
     3117       return error "Отрицательный fact-num " + string(p-fact-num) .
     3118     end.
     3119     if p-fact-num >= 100000000
     3120     then do:
     3121       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     3122     end.
     3123     if p-shift-on = true
     3124     then do:
     3125       if p-shift-date = ?
     3126       then do:
     3127         return error "Не задана дата смены" .
     3128       end.
     3129       if p-shift-num = ?
     3130       or p-shift-num = 0
     3131       then do:
     3132         return error "Не задан номер смены" .
     3133       end.
     3134     end.
     3135     else do:
     3136       assign
     3137         p-shift-date = p-fact-date
     3138         p-shift-num  = 24
     3139       .
     3140     end.
     3141     define variable v-shift-offset as integer no-undo .
     3142     if p-shift-date = p-fact-date
     3143     then do:
     3144       assign
     3145         v-shift-offset = 1
     3146       .
     3147     end.
     3148     if p-shift-date < p-fact-date
     3149     then do:
     3150       assign
     3151         v-shift-offset = 0
     3152       .
     3153     end.
     3154     if p-shift-date > p-fact-date
     3155     then do:
     3156       message
     3157         vss-workfile vss-revision vss-description skip
     3158         "Неправильная дата закрытия смены" skip
     3159         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     3160         view-as alert-box error .
     3161       undo, return error
     3162         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     3163           ,string(p-fact-date, '99/99/9999':U)
     3164           ,string(p-shift-date, '99/99/9999':U)
     3165           )
     3166       .
     3167     end.
     3168     if p-shift-num < 1
     3169     or p-shift-num > 24
     3170     then do:
     3171       message
     3172         vss-workfile vss-revision vss-description skip
     3173         "Неправильный номер смены" skip
     3174         "p-shift-num" p-shift-num skip
     3175         view-as alert-box error .
     3176       undo, return error return-value .
     3177     end.
     3178     assign
     3179       p-fact-order           = v-fact-date-num
     3180                              + v-shift-offset * 0.5
     3181                              + p-shift-num    * 0.02 - 0.01
     3182                              + p-fact-num     * 0.0000000001
     3183       p-shift-end-fact-order = v-fact-date-num
     3184                              + v-shift-offset * 0.5
     3185                              + p-shift-num    * 0.02
     3186       p-day-end-fact-order   = v-fact-date-num
     3187                              + 0.99
     3188     .
     3189     if p-fact-order           <= v-fact-date-num
     3190     or p-shift-end-fact-order <= v-fact-date-num
     3191     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     3192     or p-shift-end-fact-order >= p-day-end-fact-order
     3193     then do:
     3194       message
     3195         vss-workfile vss-revision vss-description skip
     3196         "Внутренняя ошибка при генерации фактического номера" skip
     3197         "p-fact-date"            p-fact-date            skip
     3198         "p-fact-time"            p-fact-time            skip
     3199         "p-fact-num"             p-fact-num             skip
     3200         "p-shift-date"           p-shift-date           skip
     3201         "p-shift-num"            p-shift-num            skip
     3202         "p-shift-on"             p-shift-on             skip
     3203         "p-shift-end-fact-order" p-shift-end-fact-order skip
     3204         "p-day-end-fact-order"   p-day-end-fact-order   skip
     3205         "v-fact-date-num"        v-fact-date-num        skip
     3206         view-as alert-box error .
     3207       undo, return error return-value .
     3208     end.
     3209   end procedure.
     3210   procedure day-begin-fact-order :
     3211     define input  parameter p-fact-date            as date    no-undo .
     3212     define output parameter p-day-begin-fact-order as decimal no-undo .
     3213     do
     3214     on error undo, return error return-value
     3215     :
     3216       if p-fact-date = ?
     3217       then do:
     3218         assign
     3219           p-day-begin-fact-order = 0
     3220         .
     3221       end.
     3222       else do:
     3223         assign
     3224           p-day-begin-fact-order = integer(p-fact-date)
     3225         .
     3226       end.
     3227     end.
     3228   end procedure.
     3229   procedure factord-max-fact-order :
     3230     define output parameter p-max-fact-order as decimal   no-undo .
     3231     do
     3232     on error undo, return error return-value
     3233     :
     3234       run day-begin-fact-order in this-procedure
     3235         (input  date(1, 1, 5000)
     3236         ,output p-max-fact-order
     3237         ) .
     3238     end.
     3239   end procedure.
     3240   procedure factord-cut-archive :
     3241     define input  parameter p-obj-type             as character no-undo .
     3242     define input  parameter p-obj-code             as integer   no-undo .
     3243     define input  parameter p-fact-date            as date      no-undo .
     3244     define output parameter p-shift-on             as logical   no-undo .
     3245     define output parameter p-shift-date           as date      no-undo .
     3246     define output parameter p-shift-num            as integer   no-undo .
     3247     define output parameter p-day-end-fact-order   as decimal   no-undo .
     3248     define output parameter p-shift-end-fact-order as decimal   no-undo .
     3249     define variable v-fact-order as decimal   no-undo .
     3250     define buffer buf_shift-obj for ub.shift-obj .
     3251     do
     3252     on error undo, return error return-value
     3253     :
     3254   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3255   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3256     (input  p-obj-type
     3257     ,input  p-obj-code
     3258     ,input  'shift-on=request'
     3259     ,output p-shift-on
     3260     ) no-error .
     3261       if error-status :error
     3262       then do:
     3263         message
     3264           vss-workfile vss-revision vss-description skip
     3265           "Ошибка при определении атрибута объекта" skip
     3266           "Объект" p-obj-type p-obj-code skip
     3267           error-status :get-message(1) skip
     3268           return-value skip
     3269           view-as alert-box error .
     3270         undo, return error return-value .
     3271       end.
     3272       if p-shift-on = false
     3273       then do:
     3274         assign
     3275           p-shift-date               = ?
     3276           p-shift-num                = 0
     3277         .
     3278       end.
     3279       else do:
     3280         find first buf_shift-obj share-lock
     3281           where buf_shift-obj.obj-type   = p-obj-type
     3282             and buf_shift-obj.obj-code   = p-obj-code
     3283             and buf_shift-obj.shift-date > p-fact-date
     3284           use-index pi
     3285           no-error .
     3286         if not available buf_shift-obj
     3287         or buf_shift-obj.status_ <> 'зкр':U
     3288         then do:
     3289           message
     3290             vss-workfile vss-revision vss-description skip
     3291             "Невозможно вычислить последнюю смену" skip
     3292             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     3293             "Объект" p-obj-type p-obj-code skip
     3294             "Дата" p-fact-date skip
     3295             view-as alert-box error .
     3296           undo, return error return-value .
     3297         end.
     3298         find last buf_shift-obj share-lock
     3299           where buf_shift-obj.obj-type = p-obj-type
     3300             and buf_shift-obj.obj-code = p-obj-code
     3301             and buf_shift-obj.shift-date <= p-fact-date
     3302           use-index pi
     3303           no-error .
     3304         if available buf_shift-obj
     3305         then do:
     3306           if  buf_shift-obj.status_ = 'зкр':U
     3307           then do:
     3308             assign
     3309               p-shift-date = buf_shift-obj.shift-date
     3310               p-shift-num  = buf_shift-obj.shift-num
     3311             .
     3312           end.
     3313           else do:
     3314             message
     3315               vss-workfile vss-revision vss-description skip
     3316               "Невозможно вычислить последнюю смену" skip
     3317               "Статус смены отличен от статуса" 'зкр':U skip
     3318               "Объект" p-obj-type p-obj-code skip
     3319               "Дата" p-fact-date skip
     3320               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     3321               view-as alert-box error .
     3322             undo, return error return-value .
     3323           end.
     3324         end.
     3325         else do:
     3326           assign
     3327             p-shift-date = p-fact-date - 1
     3328             p-shift-num  = 1
     3329           .
     3330         end.
     3331       end.
     3332       run factord in this-procedure
     3333         (input  p-fact-date
     3334         ,input  1
     3335         ,input  1
     3336         ,input  p-shift-date
     3337         ,input  p-shift-num
     3338         ,input  p-shift-on
     3339         ,output v-fact-order
     3340         ,output p-shift-end-fact-order
     3341         ,output p-day-end-fact-order
     3342         ) no-error .
     3343       if error-status :error
     3344       then do:
     3345         message
     3346           vss-workfile vss-revision vss-description skip
     3347           "Ошибка при вызове процедуры factord"
     3348           error-status :get-message(1) skip
     3349           return-value skip
     3350           view-as alert-box error .
     3351         undo, return error return-value .
     3352       end.
     3353     end.
     3354   end procedure.
     3355   procedure factord-lock-shift :
     3356     define input  parameter p-obj-type  as character no-undo .
     3357     define input  parameter p-obj-code  as integer   no-undo .
     3358     define input  parameter p-fact-date as date      no-undo .
     3359     define parameter buffer buf_shift-obj for ub.shift-obj .
     3360     define variable v-shift-on      as logical   no-undo .
     3361     define variable v-extra-message as character no-undo .
     3362     define variable v-error as character no-undo .
     3363     do
     3364     on error undo, return error return-value
     3365     :
     3366   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3367   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3368     (input  p-obj-type
     3369     ,input  p-obj-code
     3370     ,input  'shift-on=request'
     3371     ,output v-shift-on
     3372     ) no-error .
     3373       if error-status :error
     3374       then do:
     3375         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     3376         undo, return error v-error .
     3377       end.
     3378       if v-shift-on = true
     3379       then do:
     3380         find first buf_shift-obj share-lock
     3381           where buf_shift-obj.obj-type   = p-obj-type
     3382             and buf_shift-obj.obj-code   = p-obj-code
     3383             and buf_shift-obj.shift-date > p-fact-date
     3384           use-index pi
     3385           no-error .
     3386         if not available buf_shift-obj
     3387         or buf_shift-obj.status_ <> 'зкр':U
     3388         then do:
     3389           find last buf_shift-obj
     3390             where buf_shift-obj.obj-type = p-obj-type
     3391               and buf_shift-obj.obj-code = p-obj-code
     3392               and buf_shift-obj.status_  = 'зкр':U
     3393             use-index stts
     3394             no-error .
     3395           if available buf_shift-obj
     3396           then do:
     3397             assign
     3398               v-extra-message =
     3399                     substitute("Дата начала последеней закрытой смены на объекте &1"
     3400                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     3401                               )
     3402             .
     3403           end.
     3404           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     3405           undo, return error v-error .
     3406         end.
     3407       end.
     3408     end.
     3409   end procedure.
     3410   procedure factord-end-day :
     3411     define input  parameter p-fact-date            as date    no-undo .
     3412     define output parameter p-day-end-fact-order   as decimal no-undo .
     3413     do
     3414     on error undo, return error return-value
     3415     :
     3416       if p-fact-date = ?
     3417       then do:
     3418         return error "Не указана фактическая дата" .
     3419       end.
     3420       assign
     3421         p-day-end-fact-order = integer(p-fact-date) + 0.99
     3422       .
     3423     end.
     3424   end procedure.
     3425   procedure factord-to-date :
     3426     define input  parameter p-fact-order as decimal no-undo .
     3427     define output parameter p-fact-date  as date    no-undo .
     3428     define variable v-ref-date  as date      no-undo .
     3429     define variable v-ref-delta as integer   no-undo .
     3430     do
     3431     on error undo, return error return-value
     3432     :
     3433       if p-fact-order = ?
     3434       or p-fact-order = 0
     3435       then do:
     3436         return error "Не указан fact-order" .
     3437       end.
     3438       assign
     3439         v-ref-date  = date(1, 1, 2000)
     3440       .
     3441       assign
     3442         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     3443       .
     3444       assign
     3445         p-fact-date = v-ref-date + v-ref-delta
     3446       .
     3447     end.
     3448   end procedure.
     3449   procedure factord-to-fact-num :
     3450     define input  parameter p-fact-order as decimal no-undo .
     3451     define output parameter p-fact-num   as integer no-undo .
     3452     define variable v-fact-order-trunc as decimal no-undo .
     3453     do
     3454     on error undo, return error return-value
     3455     :
     3456       if p-fact-order = ?
     3457       or p-fact-order = 0
     3458       then do:
     3459         return error "Не указан fact-order" .
     3460       end.
     3461       assign
     3462        v-fact-order-trunc = truncate(p-fact-order, 2)
     3463       .
     3464       assign
     3465         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     3466       .
     3467     end.
     3468   end procedure.
     3469   procedure factord-to-shift-num :
     3470     define input  parameter p-fact-order as decimal no-undo .
     3471     define output parameter p-shift-num   as integer no-undo .
     3472     define variable  p-shift-numd  as decimal   no-undo .
     3473     define variable v-fact-order-trunc as decimal no-undo .
     3474     do
     3475     on error undo, return error return-value
     3476     :
     3477       if p-fact-order = ?
     3478       or p-fact-order = 0
     3479       then do:
     3480         return error "Не указан fact-order" .
     3481       end.
     3482       assign
     3483        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     3484       .
     3485       if v-fact-order-trunc < 0.5 then do:
     3486         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     3487       end.
     3488       assign
     3489         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     3490         .
     3491        assign
     3492         p-shift-num = truncate (p-shift-numd , 0)
     3493       .
     3494     end.
     3495   end procedure.
