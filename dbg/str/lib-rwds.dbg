     4456   procedure lib-rwds_crtrnsum :
     4457     define input parameter p-doc-code like ub.trn-doc.doc-code     no-undo.
     4458     define input parameter p-sum-type like ub.trn-doc-sum.sum-type no-undo.
     4459     define buffer bf_trn-doc      for ub.trn-doc.
     4460     define buffer bf_trn-doc-sum  for ub.trn-doc-sum.
     4461     define buffer bf_doc-attr     for ub.doc-attr.
     4462     do on error undo, return error return-value :
     4463       find first bf_trn-doc where
     4464                  bf_trn-doc.doc-code = p-doc-code no-error.
     4465       if not available bf_trn-doc then do:
     4466         return error substitute( 'Ошибка в процедуре lib-rwds_crtrnsum. Не найден документ с номером "&1".', p-doc-code ).
     4467       end.
     4468       find first bf_doc-attr where
     4469                  bf_doc-attr.doc-code  = bf_trn-doc.doc-code and
     4470                  bf_doc-attr.attr-code = 'addsum':U  no-error.
     4471       if not available bf_doc-attr then do:
     4472   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input bf_trn-doc.doc-code ,
     4473                          input 'addsum':U ,
     4474                          input p-sum-type ) no-error .
     4475       end.
     4476       else do:
     4477         if bf_doc-attr.attr-value = "":U then do:
     4478   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input bf_trn-doc.doc-code ,
     4479                          input 'addsum':U ,
     4480                          input p-sum-type ) no-error .
     4481         end.
     4482         else do:
     4483   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input bf_trn-doc.doc-code ,
     4484                          input 'addsum':U ,
     4485                          input bf_doc-attr.attr-value + ',' + p-sum-type ) no-error .
     4486         end.
     4487       end.
     4488       find first bf_trn-doc-sum where
     4489                  bf_trn-doc-sum.doc-code = bf_trn-doc.doc-code and
     4490                  bf_trn-doc-sum.sum-type = p-sum-type          no-error.
     4491       if available bf_trn-doc-sum then do:
     4492         return error substitute( 'Уже существует сумма типа "&1" по документу "&2".', p-sum-type, bf_trn-doc.doc-code ).
     4493       end.
     4494       create bf_trn-doc-sum.
     4495       assign bf_trn-doc-sum.doc-code     = bf_trn-doc.doc-code
     4496              bf_trn-doc-sum.ext-doc-type = bf_trn-doc.ext-doc-type
     4497              bf_trn-doc-sum.obj-type     = bf_trn-doc.obj-type
     4498              bf_trn-doc-sum.obj-code     = bf_trn-doc.obj-code
     4499              bf_trn-doc-sum.sum-type     = p-sum-type.
     4500     end.
     4501   end procedure.
     4502   procedure lib-rwds_cltrnsum :
     4503     define input parameter p-doc-code like ub.trn-doc.doc-code     no-undo.
