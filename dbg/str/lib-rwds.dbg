     4613     define input parameter p-prod-type like ub.goods.prod-type       no-undo.
     4614     define input parameter p-prod-code like ub.goods.prod-code       no-undo.
     4615     define buffer bf_doc-line-sum for ub.doc-line-sum.
     4616     define buffer bf_goods        for ub.goods.
     4617     do on error undo, return error return-value :
     4618       find first bf_goods no-lock where
     4619                  bf_goods.artic     = p-artic     and
     4620                  bf_goods.prod-type = p-prod-type and
     4621                  bf_goods.prod-code = p-prod-code no-error.
