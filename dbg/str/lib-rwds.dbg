     4545                bf_trn-doc-sum.crsa-transport-rubl = 0
     4546                bf_trn-doc-sum.crsa-other-base     = 0
     4547                bf_trn-doc-sum.crsa-other-rubl     = 0
     4548                bf_trn-doc-sum.crsa-discnt-base    = 0
     4549                bf_trn-doc-sum.crsa-discnt-rubl    = 0
     4550                bf_trn-doc-sum.cost-sum-base       = 0
     4551                bf_trn-doc-sum.cost-sum-rubl       = 0
     4552                bf_trn-doc-sum.cost-VAT-base       = 0
     4553                bf_trn-doc-sum.cost-VAT-rubl       = 0
