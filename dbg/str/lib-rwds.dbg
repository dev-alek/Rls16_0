     8338                   return-value, error-status :get-message( 1 ), bf_trn-doc.doc-code ).
     8339               end.
     8340               assign jj_count = 0.
     8341               for each bf_doc-line where
     8342                        bf_doc-line.doc-code = bf_trn-doc.doc-code
     8343               on error undo, return error return-value :
     8344                 assign jj_count = jj_count + 1.
     8345                 run waitfram-join in p-rwdshandle (  input substitute( 'Создаем записи строк сумм типа "&1".'
