     8324           if v_invclcsp = "yes" then do:
     8325             find first bf_trn-doc-sum where
     8326                        bf_trn-doc-sum.doc-code = bf_trn-doc.doc-code    and
     8327                        bf_trn-doc-sum.sum-type = 'wstc':U no-error.
     8328             if not available bf_trn-doc-sum then do:
