     4527                bf_trn-doc-sum.sale-excise-rubl    = 0
     4528                bf_trn-doc-sum.sale-transport-base = 0
     4529                bf_trn-doc-sum.sale-transport-rubl = 0
     4530                bf_trn-doc-sum.sale-other-base     = 0
     4531                bf_trn-doc-sum.sale-other-rubl     = 0
     4532                bf_trn-doc-sum.sale-discnt-base    = 0
     4533                bf_trn-doc-sum.sale-discnt-rubl    = 0
     4534                bf_trn-doc-sum.crsa-sum-base       = 0
     4535                bf_trn-doc-sum.crsa-sum-rubl       = 0
