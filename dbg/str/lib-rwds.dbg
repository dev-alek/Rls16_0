     4690   procedure lib-rwds_cctrnsum :
     4691     define input        parameter           p-doc-code       like ub.trn-doc.doc-code   no-undo.
     4692     define input        parameter           p-artic          like ub.doc-line.artic     no-undo.
     4693     define input        parameter           p-prod-type      like ub.doc-line.prod-type no-undo.
     4694     define input        parameter           p-prod-code      like ub.doc-line.prod-code no-undo.
     4695     define input        parameter           p-sum-type-list  as   character             no-undo.
     4696     define input-output parameter table for tt-allsum-line.
     4697     define input-output parameter table for tt-doc-line-sum.
     4698     define input-output parameter table for tt-clcparts.
     4699     define input-output parameter table for temp-parts.
     4700     define buffer bf_doc-line             for ub.doc-line.
     4701     define buffer bf_goods                for ub.goods.
     4702     define buffer bf_parts                for ub.parts.
     4703     define buffer bf_gen_doc-line-sum     for ub.doc-line-sum.
     4704     define buffer bf_bef_doc-line-sum     for ub.doc-line-sum.
     4705     define buffer bf_aft_doc-line-sum     for ub.doc-line-sum.
     4706     define buffer bf_gen-cli_doc-line-sum for ub.doc-line-sum.
     4707     define buffer bf_bef-cli_doc-line-sum for ub.doc-line-sum.
     4708     define buffer bf_aft-cli_doc-line-sum for ub.doc-line-sum.
     4709     define buffer bf_tt-allsum-line       for tt-allsum-line.
     4710     define buffer bf_doc-line-sum         for ub.doc-line-sum.
     4711     define buffer bf_trn-doc              for ub.trn-doc.
     4712     define buffer bf_gds-obj              for ub.gds-obj.
     4713     define buffer bf_prt-obj              for ub.prt-obj.
     4714     define buffer bf_bar-code             for ub.bar-code.
     4715     define variable v_curr-r-b              as   character             no-undo.
     4716     define variable v_base-rate             like ub.trn-doc.base-rate  no-undo.
     4717     define variable v_base-scale            like ub.trn-doc.base-scale no-undo.
     4718     define variable d_vat-pc                as   decimal               no-undo.
     4719     define variable d_slt-pc                as   decimal               no-undo.
     4720     define variable d_cons-vat-pc           as   decimal               no-undo.
     4721     define variable d_cur-price-sale        as   decimal               no-undo.
     4722     define variable d_cur-price-road-tax    as   decimal               no-undo.
     4723     define variable d_cur-price-excise      as   decimal               no-undo.
     4724     define variable d_curprt-price-sale     as   decimal               no-undo.
     4725     define variable d_curprt-price-road-tax as   decimal               no-undo.
     4726     define variable d_curprt-price-excise   as   decimal               no-undo.
     4727     define variable d_cur-base              as   decimal               no-undo.
     4728     define variable d_cur-road-tax-base     as   decimal               no-undo.
     4729     define variable d_cur-excise-base       as   decimal               no-undo.
     4730     define variable d_fact-qnty             as   decimal               no-undo.
     4731     define variable j_b-code                like ub.bar-code.b-code    no-undo.
     4732     define variable v_doc-num               like ub.price-doc.doc-num  no-undo.
     4733     define variable l_is-new                as   logical               no-undo.
     4734     define variable l_create-part           as   logical               no-undo.
     4735     define variable l_old-return            as   logical               no-undo.
     4736     define variable v_rsrv-code             as   character             no-undo.
     4737     define variable v_unrv-code             as   character             no-undo.
     4738     define variable l_need-rsrv             as   logical               no-undo.
     4739     define variable l_need-unrv             as   logical               no-undo.
     4740     define variable j_rsrv-sign             as   integer               no-undo.
     4741     define variable j_unrv-sign             as   integer               no-undo.
     4742     define variable v_invclcsp              as   character             no-undo.
     4743     define variable v_data-type             as   character             no-undo.
     4744     define variable varfact-order           like ub.trn-doc.fact-order no-undo.
     4745     do on error undo, return error return-value :
     4746       find first bf_doc-line no-lock where
     4747                  bf_doc-line.doc-code  = p-doc-code  and
     4748                  bf_doc-line.artic     = p-artic     and
     4749                  bf_doc-line.prod-type = p-prod-type and
     4750                  bf_doc-line.prod-code = p-prod-code no-error.
     4751       if not available bf_doc-line then do:
     4752         return error substitute( 'Не найдена строка товара &1 &2 &3 в документе "&4".',
     4753                                  p-artic, p-prod-type, p-prod-code, p-doc-code ).
     4754       end.
     4755       find first bf_goods no-lock where
     4756                  bf_goods.artic     = bf_doc-line.artic     and
     4757                  bf_goods.prod-type = bf_doc-line.prod-type and
     4758                  bf_goods.prod-code = bf_doc-line.prod-code no-error.
     4759       if not available bf_goods then do:
     4760         return error substitute( 'Не найден товар &1 &2 &3.', p-artic, p-prod-type, p-prod-code ).
     4761       end.
     4762       for each tt-doc-line-sum :
     4763         delete tt-doc-line-sum.
     4764       end.
     4765       find first bf_trn-doc where
     4766                  bf_trn-doc.doc-code = bf_doc-line.doc-code.
     4767       if not available bf_trn-doc then do:
     4768         return error substitute( 'Не найден документ "&1".', p-doc-code ).
     4769       end.
     4770   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4771   empty temp-table thbjattr_thbj-attr.
     4772   run adm/shattri.p (
     4773      input "get":U
     4774     ,input bf_trn-doc.obj-type
     4775     ,input bf_trn-doc.obj-code
     4776     ,input 'inv-obj':U
     4777     ,input  ""
     4778     ,output v-value-character
     4779     ,output v-value-date
     4780     ,output v-value-decimal
     4781     ,output v-value-integer
     4782     ,output v-value-logical
     4783     ,output par-type
     4784     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4785     ) no-error .
     4786       for each thbjattr_thbj-attr :
     4787           if thbjattr_thbj-attr.prop-code = 'invclcsp'  then v_invclcsp = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
     4788       end.
     4789       empty temp-table thbjattr_thbj-attr.
     4790       if lookup( 'bd':U,     p-sum-type-list ) <> 0 or
     4791          lookup( 'bcd':U, p-sum-type-list ) <> 0 then do:
     4792         if bf_trn-doc.status_ = 'факт':U then do:
     4793           return error substitute(
     4794             'Документ "&1" находится в статусе "&2". Расчет сумм перед документом должен проводиться специальной утилитой.',
