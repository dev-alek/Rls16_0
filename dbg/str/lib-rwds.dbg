     8347                                                   ,  input substitute( 'Обработано строк: &1', jj_count)
     8348                                                   ,  input substitute( 'Время &1.', string( time - j#time, "hh:mm:ss":U ) )
     8349                                                   , output v_message ).
     8350                 run waitfram-show in p-rwdshandle (  input v_message ) no-error.
     8351                 run lib-rwds_crlinsum in this-procedure ( input bf_doc-line.doc-code
     8352                                                         , input 'wstc':U
