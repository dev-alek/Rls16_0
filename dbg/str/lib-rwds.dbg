     2222       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     2223       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     2224       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     2225       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     2226       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     2227       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     2228       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     2229       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     2230       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     2231       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     2232       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     2233       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     2234       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     2235       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     2236       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     2237       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     2238       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     2239       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     2240       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     2241       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     2242       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     2243       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     2244       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     2245       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     2246       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     2247       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     2248       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     2249       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     2250       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     2251       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     2252       .
     2253   end.
     2254   otherwise do:
     2255     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     2256                              cl_tt-clcparts.purch-code,
     2257                              cl_tt-clcparts.part-code,
     2258                              cl_tt-clcparts.out-code,
     2259                              cl_tt-clcparts.in-code,
     2260                              cl_tt-clcparts.artic,
     2261                              cl_tt-clcparts.prod-type,
     2262                              cl_tt-clcparts.prod-code).
     2263   end.
     2264   end case.
     2265   end.
     2266   end procedure.
     2267   procedure clcprtsl_calc-line :
     2268   define input  parameter parrec-line as recid no-undo.
     2269   define variable v-tax-date         as   date                     no-undo.
     2270   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2271   define variable varr-b             as   character                no-undo.
     2272   define variable varr-btype         as   character                no-undo.
     2273   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2274   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2275   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2276   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2277   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2278   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2279   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2280   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2281   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2282   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2283   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2284   define variable varexcise          like ub.price-list.excise     no-undo.
     2285   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2286   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2287   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2288   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2289   define variable v-varsum           as decimal                  no-undo.
     2290   define variable varprice-salef as decimal   no-undo .
     2291   define buffer bf_trn-doc             for ub.trn-doc.
     2292   define buffer bf_doc-line            for ub.doc-line.
     2293   define buffer bf_gds-dtl             for ub.gds-dtl.
     2294   define buffer bf_goods               for ub.goods.
     2295   define buffer bf_parts               for ub.parts.
     2296   define buffer bf_sysconf             for ub.sysconf.
     2297   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2298   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2299   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2300   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2301   define buffer buf_parts        for ub.parts.
     2302   v-calcbypart = no.
     2303   do on error undo, return error return-value :
     2304   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2305   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2306     (output varr-b
     2307     )  .
     2308     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2309     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2310     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2311                               bf_goods.prod-type = bf_doc-line.prod-type and
     2312                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2313     if bf_trn-doc.fact-date <> ?        then do:
     2314       assign v-tax-date = bf_trn-doc.fact-date.
     2315     end.
     2316     else do:
     2317       assign v-tax-date = ?.
     2318     end.
     2319   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2320   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2321     (input  bf_goods.gds-code
     2322     ,input  '1':U
     2323     ,input  v-tax-date
     2324     ,input  bf_trn-doc.host-code
     2325     ,input  bf_trn-doc.obj-type
     2326     ,input  bf_trn-doc.obj-code
     2327     ,output v-vat-pc
     2328     ) no-error .
     2329     if error-status :error
     2330     or v-vat-pc = ? then do:
     2331        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2332     end.
     2333     if bf_goods.gds-type = 'у':U or
     2334        bf_trn-doc.status_ = 'запрос':U then do:
     2335       for each bf_tt-allsum-line
     2336       on error undo, return error return-value
     2337        :
     2338         delete bf_tt-allsum-line.
     2339       end.
     2340       create bf_tt-allsum-line.
     2341       assign
     2342        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2343       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2344                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2345                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2346                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2347         assign
     2348           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2349           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2350           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2351           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2352           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2353           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2354           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2355           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2356           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2357           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2358           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2359           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2360           bf_tt-allsum-line.vat-cli-acc          =  ?
     2361           .
     2362       end.
     2363       assign
     2364         bf_tt-allsum-line.cli-qnty             =  ?
     2365         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2366         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2367         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2368         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2369         bf_tt-allsum-line.road-tax-base-doc    =  0
     2370         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2371         bf_tt-allsum-line.excise-base-doc      =  0
     2372         bf_tt-allsum-line.excise-rubl-doc      =  0
     2373         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2374         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2375         bf_tt-allsum-line.dsc-base-cur         =  0
     2376         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2377         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2378         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2379         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2380         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2381         bf_tt-allsum-line.road-tax-base-cur    =  0
     2382         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2383         bf_tt-allsum-line.excise-base-cur      =  0
     2384         bf_tt-allsum-line.excise-rubl-cur      =  0
     2385         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2386         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2387         bf_tt-allsum-line.dsc-base-acc         =  0
     2388         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2389         bf_tt-allsum-line.dsc-cli-acc          =  0
     2390         bf_tt-allsum-line.slt-base-acc         =  0
     2391         bf_tt-allsum-line.slt-rubl-acc         =  0
     2392         bf_tt-allsum-line.slt-cli-acc          =  0
     2393         bf_tt-allsum-line.road-tax-base-acc    =  0
     2394         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2395         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2396         bf_tt-allsum-line.excise-base-acc      =  0
     2397         bf_tt-allsum-line.excise-rubl-acc      =  0
     2398         bf_tt-allsum-line.excise-cli-acc       =  0
     2399         bf_tt-allsum-line.transport-base-acc   =  0
     2400         bf_tt-allsum-line.transport-rubl-acc   =  0
     2401         bf_tt-allsum-line.transport-cli-acc    =  0
     2402         bf_tt-allsum-line.other-base-acc       =  0
     2403         bf_tt-allsum-line.other-rubl-acc       =  0
     2404         bf_tt-allsum-line.other-cli-acc        =  0
     2405         .
     2406       create bfs_tt-allsum-line.
     2407       assign
     2408       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2409       if bf_trn-doc.doc-type = 'инв':U or
     2410          bf_trn-doc.doc-type = 'при':U    or
     2411          bf_trn-doc.doc-type = 'возврат':U    then do:
     2412          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     2413       end.
     2414       else do:
     2415         assign
     2416           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     2417           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     2418           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     2419           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     2420           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     2421           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     2422           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     2423           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     2424           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     2425           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     2426           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     2427           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     2428           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     2429           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     2430           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     2431           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     2432           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     2433           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     2434           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     2435           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     2436           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     2437           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     2438           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     2439           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     2440           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     2441           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     2442           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     2443           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     2444           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     2445           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     2446           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     2447           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     2448           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     2449           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     2450           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     2451           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     2452           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     2453           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     2454           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     2455           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     2456           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     2457           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     2458           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
