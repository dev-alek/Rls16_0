      621   define variable v-mes as character no-undo .
      622   define variable v-to-send as logical no-undo init ?.
      623   define variable ii as integer no-undo .
      624   define variable v-attr-list as character no-undo .
      625   define buffer buf_cash-desk for ub.cash-desk.
      626   do
      627   on error undo, return error
      628   :
      629     if p-pos-type = '':U then dO:
      630       assign
      631       p-pos-type = 'MARIA':U  + chr(44) +
      632                    'MARIA':U
      633       v-attr-list = 'to-send':U + chr(44) +
      634                     'petrol-to-send':U
      635       .
      636     end.
      637     else do:
      638       if p-pos-type = 'MARIA':U then do:
      639         assign
      640         p-pos-type = 'MARIA':U  + chr(44) +
      641                       'MARIA':U
      642         v-attr-list = 'to-send':U + chr(44) +
      643                     'petrol-to-send':U
      644         .
      645       end.
      646     end.
      647     do ii = 1 to num-entries(p-pos-type):
      648       find first buf_cash-desk no-lock where
      649                 buf_cash-desk.db-num = g#db-num
      650           AND  buf_cash-desk.obj-code = p-obj-code
      651           and  buf_cash-desk.pos-type = entry(ii, p-pos-type) no-error .
      652       if available buf_cash-desk then do:
      653         assign
      654         p-to-send = cd-attr_get-attr-log (buffer buf_Cash-desk
      655                                         , substitute("&1_operative", buf_cash-desk.pos-type)
      656                                         , input entry(ii, v-attr-list)
      657                                         , output v-mes).
      658       end.
      659       else v-to-send = ?.
      660       p-to-send = (if v-to-send <> ?
      661                    then (p-to-send or v-to-send)
      662                    else p-to-send).
      663     end.
      664   end.
