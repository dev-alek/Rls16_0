      135   define temp-table tt-wth-doc no-undo like ub.wth-doc .
      136   define temp-table tt-wth-line no-undo like ub.wth-line .
      137   define temp-table tt-wth-parts no-undo like ub.wth-parts .
      138   define variable vidn-ser-code  as integer no-undo.
      139   define variable vidn-db-num    like ub.wth-ser.db-num no-undo.
      140   define variable vidn-stts      as integer no-undo.
      141   define variable vidn-wth-code  like ub.wth-parts.wth-code no-undo.
      142   define variable vidn-gds-code  like ub.wth-parts.gds-code no-undo.
      143   define variable vidn-par-code  like ub.wth-parts.par-code no-undo.
      144   define variable vidn-zone      as character no-undo.
      145   define variable vidn-FromDate  as date no-undo.
      146   define variable vidn-ToDate    as date no-undo.
      147   define variable vidn-priceRubl like ub.wth-parts.price-rubl  no-undo.
      148   define variable vidn-priceBase like ub.wth-parts.price-base  no-undo.
      149   define variable vidn-range     like ub.wth-parts.fact-rangeFrom  no-undo.
      150   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      151   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      152                                                       ,input p-range-type as character
      153                                                       ,input p-code as integer):
      154   define variable v-seq-val as integer no-undo .
      155   define buffer buf_code-range for ub.code-range.
      156   find first buf_code-range no-lock where
      157             buf_code-range.db-num = p-db-num
      158       and  buf_code-range.range-type = p-range-type
      159       and  buf_code-range.stts = 'u'
      160       and buf_code-range.first-code <= p-code
      161       and buf_code-range.last-code >= p-code no-error .
      162   if available buf_code-range then return yes.
      163   CASE p-range-type:
      164     when 'pngb':U then do:
      165       v-seq-val = current-value(s-pngb-code, ub).
      166     end.
      167     when 'fmgb':U then do:
      168       v-seq-val = current-value(s-fmgb-code, ub).
      169     end.
      170   END CASE.
      171   if p-code <= v-seq-val then do:
      172     find first buf_code-range no-lock where
      173               buf_code-range.db-num = p-db-num
      174         and  buf_code-range.range-type = p-range-type
      175         and  buf_code-range.stts = 'a'
      176         and buf_code-range.first-code <= p-code
      177         no-error .
      178    if available buf_code-range then return yes.
      179   end.
      180   find first buf_code-range no-lock where
      181             buf_code-range.db-num = p-db-num
      182       and  buf_code-range.range-type = p-range-type
      183       and  buf_code-range.stts = 'f'
      184       and buf_code-range.first-code <= p-code
      185       and buf_code-range.last-code >= p-code
      186       no-error .
      187   if available buf_code-range then return yes.
      188   return no.
      189   END FUNCTION.
      190   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      191                                                       ,input p-range-type as character
      192                                                       ,input p-code as integer):
      193   define variable v-seq-val as integer no-undo .
      194   define buffer buf_code-range for ub.code-range.
      195   CASE p-range-type:
      196     when 'pngb':U then do:
      197       v-seq-val = current-value(s-pngb-code, ub).
      198     end.
      199     when 'fmgb':U then do:
      200       v-seq-val = current-value(s-fmgb-code, ub).
      201     end.
      202   END CASE.
      203   if p-code <= v-seq-val then do:
      204     find first buf_code-range no-lock where
      205               buf_code-range.db-num = p-db-num
      206         and  buf_code-range.range-type = p-range-type
      207         and buf_code-range.first-code <= p-code
      208         and buf_code-range.last-code >= p-code no-error .
      209     if available buf_code-range then return yes.
      210   end.
      211   return no.
      212   END FUNCTION.
      213   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      214                                                       ,input p-db-num as integer
      215                                                       ,input p-staff-code as integer
      216                                                       ,input p-date as date
      217                                                        ):
      218   define buffer buf_staff for ub.staff.
      219   if p-date = ? then do:
      220     p-date = today .
      221   end.
      222   find first buf_staff no-lock where
      223             buf_staff.role = p-role
      224         and buf_staff.role-level = 'db':U
      225         and buf_staff.db-num = p-db-num
      226         and buf_staff.staff-code = p-staff-code
      227         and buf_staff.date-end >= p-date use-index pi  no-error .
      228   if available buf_staff then do:
      229     return buf_staff.psn-code.
      230   end.
      231   return 0.
      232   end FUNCTION.
      233   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      234                                                             ,input p-db-num as integer
      235                                                             ,input p-date as date
      236                                                                 ):
      237   define buffer buf_staff for ub.staff.
      238   define buffer buf2_staff for ub.staff.
      239   if p-date = ? then do:
      240     p-date = today .
      241   end.
      242   for each  buf_staff no-lock where
      243             buf_staff.role = p-role
      244         and buf_staff.db-num = p-db-num,
      245   first buf2_staff no-lock where
      246         buf2_staff.role = p-role
      247     and buf2_staff.role-level = 'db':U
      248     and buf2_staff.staff-code = buf_staff.staff-code
      249     and buf2_staff.date-start <= p-date
      250     and buf2_staff.date-end >= p-date
      251   by buf_staff.staff-code
      252   by date-start descending:
      253     return buf_staff.staff-code.
      254   end.
      255   end FUNCTION.
      256   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      257                                                  ,input p-db-num as integer
      258                                                  ,input p-psn-code as integer
      259                                                  ,input p-date as date
      260                                                  ,output p-c-password as character
      261                                                        ):
      262   define buffer buf_staff for ub.staff.
      263   if p-date = ? then do:
      264     p-date = today .
      265   end.
      266   find first buf_staff no-lock where
      267             buf_staff.role = p-role
      268         and buf_staff.role-level = 'db':U
      269         and buf_staff.db-num = p-db-num
      270        and buf_staff.date-end >= p-date
      271        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      272   if available buf_staff
      273   then do:
      274     assign
      275     p-c-password = buf_staff.password.
      276     return buf_staff.staff-code.
      277   end.
      278   p-c-password = ''.
      279   return 0.
      280   end FUNCTION.
      281   FUNCTION gbclcode-is-psn-role returns integer (
      282                                                 input p-role as character
      283                                                 ,input p-psn-code as integer
      284                                                 ,input p-date as date
      285                                                     ):
      286   define buffer buf_staff for ub.staff.
      287   if p-date = ? then do:
      288     p-date = today .
      289   end.
      290   for each buf_staff no-lock where
      291             buf_staff.psn-code = p-psn-code
      292        and  buf_staff.role = p-role
      293   by buf_staff.role-level
      294   by buf_staff.date-start
      295        :
      296     if  buf_staff.date-start <= p-date and
      297     buf_staff.date-end >= p-date  then do:
      298       return buf_staff.staff-code.
      299     end.
      300   end.
      301   return 0.
      302   end FUNCTION.
      303   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      304   define variable v-role-name as character no-undo .
      305   assign
      306   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      307   no-error .
      308   return v-role-name.
      309   END.
      310   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      311   FUNCTION gbclcode-get-position returns character ( input p-role as character
      312                                                     ,input p-role-level as character
      313                                                     ,input p-work-place as character
      314                                                     ,input p-staff-code as integer
      315                                                                ):
      316   define variable v-role-name as character no-undo .
      317   define variable v-role-level as character no-undo .
      318   define variable v-staff-code as integer no-undo .
      319   assign
      320   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      321   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      322   v-staff-code = p-staff-code
      323   no-error .
      324   return substitute("&1, &2, Код &3"
      325                   ,v-role-name
      326                   ,v-role-level
      327                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      328   END.
      329   FUNCTION gbclcode-get-work-place returns character (
      330                                                   input p-role as character
      331                                                  ,input p-role-level as character
      332                                                  ,input p-db-num as integer
      333                                                  ,input p-host-code as integer
      334                                                  ,input p-obj-type as character
      335                                                  ,input p-obj-code as integer
      336                                                  ) :
      337   define variable v-work-place as character no-undo .
      338   define variable v-obj-type as character no-undo .
      339     case p-role-level:
      340       when 'db':U then do:
      341         v-work-place = string(p-db-num, "99999").
      342       end.
      343       when 'firm':U then do:
      344         v-work-place = string(p-host-code, "99999").
      345       end.
      346       when 'object':U then do:
      347         assign
      348         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      349         .
      350       end.
      351     END CASE.
      352     return v-work-place.
      353   END FUNCTION.
      354   FUNCTION gbclcode-get-level-last-code returns integer (
      355                                                           input p-role as character
      356                                                         , input p-role-level as character
      357                                                         , input p-work-place as character
      358                                                         , input p-date-start as date
      359                                                         ):
      360   DEFINE VARIABLE v-today as date no-undo .
      361   define buffer buf_staff for ub.staff.
      362   if p-work-place = chr(63) then return ?.
      363   if p-date-start = ? then do:
      364     v-today = today .
      365   end.
      366   else do:
      367     v-today = p-date-start.
      368   end.
      369   find last buf_staff no-lock where
      370             buf_staff.role = p-role
      371        and  buf_staff.role-level = p-role-level
      372        and  buf_staff.work-place = p-work-place
      373        and  buf_staff.date-start <= v-today + 1
      374        and  buf_staff.date-end >= v-today + 1
      375        use-index pi  no-error .
      376   if available buf_staff
      377   then return buf_staff.staff-code.
      378   return 0.
      379   end FUNCTION.
      380   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   procedure cur-time :
      382      define output parameter p-today as date      no-undo .
      383      define output parameter p-time  as integer   no-undo .
      384     do
      385     on error undo, return error
      386     :
      387       define variable v-date1 as date      no-undo .
      388       define variable v-date2 as date      no-undo .
      389       define variable v-time  as integer   no-undo .
      390       assign
      391         v-date1 = today
      392         v-time  = time
      393         v-date2 = today
      394       .
      395       if v-date1 <> v-date2
      396       then do:
      397         assign
      398           v-date1 = today
      399           v-time  = v-time
      400         .
      401       end.
      402       assign
      403         p-today = v-date1
      404         p-time  = v-time
      405       .
      406     end.
      407   end.
      408   function cur-time-date returns character
      409   :
      410     return string(today, '99/99/9999':U) .
      411   end.
      412   function cur-time-mjd returns decimal
      413   :
      414     define variable v-date as date      no-undo .
      415     define variable v-time as integer   no-undo .
      416     run cur-time in this-procedure
      417       (output v-date
      418       ,output v-time
      419       ) .
      420     return integer(v-date) - 2400002 + (v-time / 86400) .
      421   end.
      422   function cur-time-get-ending-index returns integer
      423   (input p-number as integer
      424   )
      425   :
      426     if p-number < 0
      427     or p-number = ?
      428     then do:
      429       return 1 .
      430     end.
      431     define variable v-rest as integer   no-undo .
      432     assign
      433       p-number = p-number modulo 100
      434     .
      435     if p-number < 20
      436     then do:
      437       assign
      438         v-rest = p-number
      439       .
      440     end.
      441     else do:
      442       assign
      443         v-rest = p-number modulo 10
      444       .
      445     end.
      446     case v-rest :
      447       when 1
      448       then do:
      449         return 2 .
      450       end.
      451       when 2 or
      452       when 3 or
      453       when 4
      454       then do:
      455         return 3 .
      456       end.
      457       otherwise do:
      458         return 1 .
      459       end.
      460     end case .
      461   end.
      462   procedure cur-time-mjd-to-date :
      463      define input  parameter i-mjd-diff as decimal no-undo.
      464      define output parameter o-Date     as date    no-undo.
      465      define output parameter o-Time     as integer no-undo.
      466      define variable v-day-number as integer   no-undo .
      467      if    i-mjd-diff < 0
      468         or i-mjd-diff = ?
      469      then do:
      470         return "?" .
      471      end.
      472      assign
      473         v-day-number = truncate(i-mjd-diff,0).
      474         o-Date = date(v-day-number + 2400002).
      475         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      476     .
      477   end.
      478   function cur-time-mjd-to-string returns character
      479   (input p-mjd-diff as decimal
      480   )
      481   :
      482     define variable v-day-number as integer   no-undo .
      483     define variable v-seconds    as integer   no-undo .
      484     define variable v-hour       as integer   no-undo .
      485     define variable v-min        as integer   no-undo .
      486     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      487     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      488     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      489     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      490     if p-mjd-diff < 0
      491     or p-mjd-diff = ?
      492     then do:
      493       return "?" .
      494     end.
      495     assign
      496       v-day-number = integer(truncate(p-mjd-diff,0))
      497       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      498     .
      499     if v-seconds > 86400
      500     then do:
      501       assign
      502         v-seconds = 86400 - 1
      503       .
      504     end.
      505     if v-seconds < 0
      506     then do:
      507       assign
      508         v-seconds = 0
      509       .
      510     end.
      511     assign
      512       v-hour = truncate(v-seconds / 3600, 0)
      513     .
      514     assign
      515       v-seconds = v-seconds modulo 3600
      516     .
      517     assign
      518       v-min = truncate(v-seconds / 60, 0)
      519     .
      520     assign
      521       v-seconds = v-seconds modulo 60
      522     .
      523     return
      524         (if v-day-number <> 0
      525           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      526           else ""
      527         )
      528       + (if v-day-number <> 0 or v-hour <> 0
      529           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      530           else ""
      531         )
      532       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      533           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      534           else ""
      535         )
      536       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      537       .
      538   end.
      539   function cur-time-string returns character
      540   :
      541     define variable v-date as date      no-undo .
      542     define variable v-time as integer   no-undo .
      543     run cur-time in this-procedure
      544       (output v-date
      545       ,output v-time
      546       ) .
      547     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      548   end.
      549   function cur-time-string-sec returns character
      550   :
      551     define variable v-date as date      no-undo .
      552     define variable v-time as integer   no-undo .
      553     run cur-time in this-procedure
      554       (output v-date
      555       ,output v-time
      556       ) .
      557     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      558   end.
      559   function cur-time-custom  returns character
      560   (input p-prefix as character
      561   ,input p-date-format as character
      562   ,input p-delimiter as character
      563   ,input p-time-format as character
      564   ,input p-suffix as character
      565   )
      566   :
      567     define variable v-date as date      no-undo .
      568     define variable v-time as integer   no-undo .
      569     run cur-time in this-procedure
      570       (output v-date
      571       ,output v-time
      572       ) .
      573     return
      574       p-prefix
      575       + string(v-date, p-date-format)
      576       + p-delimiter
      577       + string(v-time, p-time-format)
      578       + p-suffix
      579       .
      580   end.
      581   function cur-time-print  returns character
      582   :
      583     define variable v-date as date      no-undo .
      584     define variable v-time as integer   no-undo .
      585     run cur-time in this-procedure
      586       (output v-date
      587       ,output v-time
      588       ) .
      589     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      590   end.
      591   function cur-time-datetime returns datetime
      592   :
      593     define variable v-char as character no-undo .
      594     define variable v-datetime as datetime no-undo .
      595     v-char = cur-time-string().
      596     v-datetime = datetime(v-char).
      597     return  v-datetime.
      598   end.
      599   function cur-time-string-msec returns character
      600   :
      601     define variable v-date as datetime  no-undo .
      602     v-date = now.
      603     return string(v-date) .
      604   end.
