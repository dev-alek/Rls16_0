      900   procedure factord :
      901     define input  parameter p-fact-date            as date    no-undo .
      902     define input  parameter p-fact-time            as integer no-undo .
      903     define input  parameter p-fact-num             as integer no-undo .
      904     define input  parameter p-shift-date           as date    no-undo .
      905     define input  parameter p-shift-num            as integer no-undo .
      906     define input  parameter p-shift-on             as logical no-undo .
      907     define output parameter p-fact-order           as decimal no-undo .
      908     define output parameter p-shift-end-fact-order as decimal no-undo .
      909     define output parameter p-day-end-fact-order   as decimal no-undo .
      910     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      911     if p-fact-date = ?
      912     then do:
      913       return error "Не указана фактическая дата" .
      914     end.
      915     define variable v-fact-date-num as integer no-undo .
      916     assign
      917       v-fact-date-num = integer(p-fact-date)
      918     .
      919     if p-fact-num = ?
      920     or p-fact-num = 0
      921     then do:
      922       return error "Не задан p-fact-num " + string(p-fact-num) .
      923     end.
      924     if p-fact-num < 0
      925     then do:
      926       return error "Отрицательный fact-num " + string(p-fact-num) .
      927     end.
      928     if p-fact-num >= 100000000
      929     then do:
      930       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      931     end.
      932     if p-shift-on = true
      933     then do:
      934       if p-shift-date = ?
      935       then do:
      936         return error "Не задана дата смены" .
      937       end.
      938       if p-shift-num = ?
      939       or p-shift-num = 0
      940       then do:
      941         return error "Не задан номер смены" .
      942       end.
      943     end.
      944     else do:
      945       assign
      946         p-shift-date = p-fact-date
      947         p-shift-num  = 24
      948       .
      949     end.
      950     define variable v-shift-offset as integer no-undo .
      951     if p-shift-date = p-fact-date
      952     then do:
      953       assign
      954         v-shift-offset = 1
      955       .
      956     end.
      957     if p-shift-date < p-fact-date
      958     then do:
      959       assign
      960         v-shift-offset = 0
      961       .
      962     end.
      963     if p-shift-date > p-fact-date
      964     then do:
      965       message
      966         vss-workfile vss-revision vss-description skip
      967         "Неправильная дата закрытия смены" skip
      968         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      969         view-as alert-box error .
      970       undo, return error
      971         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      972           ,string(p-fact-date, '99/99/9999':U)
      973           ,string(p-shift-date, '99/99/9999':U)
      974           )
      975       .
      976     end.
      977     if p-shift-num < 1
      978     or p-shift-num > 24
      979     then do:
      980       message
      981         vss-workfile vss-revision vss-description skip
      982         "Неправильный номер смены" skip
      983         "p-shift-num" p-shift-num skip
      984         view-as alert-box error .
      985       undo, return error return-value .
      986     end.
      987     assign
      988       p-fact-order           = v-fact-date-num
      989                              + v-shift-offset * 0.5
      990                              + p-shift-num    * 0.02 - 0.01
      991                              + p-fact-num     * 0.0000000001
      992       p-shift-end-fact-order = v-fact-date-num
      993                              + v-shift-offset * 0.5
      994                              + p-shift-num    * 0.02
      995       p-day-end-fact-order   = v-fact-date-num
      996                              + 0.99
      997     .
      998     if p-fact-order           <= v-fact-date-num
      999     or p-shift-end-fact-order <= v-fact-date-num
     1000     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1001     or p-shift-end-fact-order >= p-day-end-fact-order
     1002     then do:
     1003       message
     1004         vss-workfile vss-revision vss-description skip
     1005         "Внутренняя ошибка при генерации фактического номера" skip
     1006         "p-fact-date"            p-fact-date            skip
     1007         "p-fact-time"            p-fact-time            skip
     1008         "p-fact-num"             p-fact-num             skip
     1009         "p-shift-date"           p-shift-date           skip
     1010         "p-shift-num"            p-shift-num            skip
     1011         "p-shift-on"             p-shift-on             skip
     1012         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1013         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1014         "v-fact-date-num"        v-fact-date-num        skip
     1015         view-as alert-box error .
     1016       undo, return error return-value .
     1017     end.
     1018   end procedure.
     1019   procedure day-begin-fact-order :
     1020     define input  parameter p-fact-date            as date    no-undo .
     1021     define output parameter p-day-begin-fact-order as decimal no-undo .
     1022     do
     1023     on error undo, return error return-value
     1024     :
     1025       if p-fact-date = ?
     1026       then do:
     1027         assign
     1028           p-day-begin-fact-order = 0
     1029         .
     1030       end.
     1031       else do:
     1032         assign
     1033           p-day-begin-fact-order = integer(p-fact-date)
     1034         .
     1035       end.
     1036     end.
     1037   end procedure.
     1038   procedure factord-max-fact-order :
     1039     define output parameter p-max-fact-order as decimal   no-undo .
     1040     do
     1041     on error undo, return error return-value
     1042     :
     1043       run day-begin-fact-order in this-procedure
     1044         (input  date(1, 1, 5000)
     1045         ,output p-max-fact-order
     1046         ) .
     1047     end.
     1048   end procedure.
     1049   procedure factord-cut-archive :
     1050     define input  parameter p-obj-type             as character no-undo .
     1051     define input  parameter p-obj-code             as integer   no-undo .
     1052     define input  parameter p-fact-date            as date      no-undo .
     1053     define output parameter p-shift-on             as logical   no-undo .
     1054     define output parameter p-shift-date           as date      no-undo .
     1055     define output parameter p-shift-num            as integer   no-undo .
     1056     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1057     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1058     define variable v-fact-order as decimal   no-undo .
     1059     define buffer buf_shift-obj for ub.shift-obj .
     1060     do
     1061     on error undo, return error return-value
     1062     :
     1063   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1064   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1065     (input  p-obj-type
     1066     ,input  p-obj-code
     1067     ,input  'shift-on=request'
     1068     ,output p-shift-on
     1069     ) no-error .
     1070       if error-status :error
     1071       then do:
     1072         message
     1073           vss-workfile vss-revision vss-description skip
     1074           "Ошибка при определении атрибута объекта" skip
     1075           "Объект" p-obj-type p-obj-code skip
     1076           error-status :get-message(1) skip
     1077           return-value skip
     1078           view-as alert-box error .
     1079         undo, return error return-value .
     1080       end.
     1081       if p-shift-on = false
     1082       then do:
     1083         assign
     1084           p-shift-date               = ?
     1085           p-shift-num                = 0
     1086         .
     1087       end.
     1088       else do:
     1089         find first buf_shift-obj share-lock
     1090           where buf_shift-obj.obj-type   = p-obj-type
     1091             and buf_shift-obj.obj-code   = p-obj-code
     1092             and buf_shift-obj.shift-date > p-fact-date
     1093           use-index pi
     1094           no-error .
     1095         if not available buf_shift-obj
     1096         or buf_shift-obj.status_ <> 'зкр':U
     1097         then do:
     1098           message
     1099             vss-workfile vss-revision vss-description skip
     1100             "Невозможно вычислить последнюю смену" skip
     1101             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1102             "Объект" p-obj-type p-obj-code skip
     1103             "Дата" p-fact-date skip
     1104             view-as alert-box error .
     1105           undo, return error return-value .
     1106         end.
     1107         find last buf_shift-obj share-lock
     1108           where buf_shift-obj.obj-type = p-obj-type
     1109             and buf_shift-obj.obj-code = p-obj-code
     1110             and buf_shift-obj.shift-date <= p-fact-date
     1111           use-index pi
     1112           no-error .
     1113         if available buf_shift-obj
     1114         then do:
     1115           if  buf_shift-obj.status_ = 'зкр':U
     1116           then do:
     1117             assign
     1118               p-shift-date = buf_shift-obj.shift-date
     1119               p-shift-num  = buf_shift-obj.shift-num
     1120             .
     1121           end.
     1122           else do:
     1123             message
     1124               vss-workfile vss-revision vss-description skip
     1125               "Невозможно вычислить последнюю смену" skip
     1126               "Статус смены отличен от статуса" 'зкр':U skip
     1127               "Объект" p-obj-type p-obj-code skip
     1128               "Дата" p-fact-date skip
     1129               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1130               view-as alert-box error .
     1131             undo, return error return-value .
     1132           end.
     1133         end.
     1134         else do:
     1135           assign
     1136             p-shift-date = p-fact-date - 1
     1137             p-shift-num  = 1
     1138           .
     1139         end.
     1140       end.
     1141       run factord in this-procedure
     1142         (input  p-fact-date
     1143         ,input  1
     1144         ,input  1
     1145         ,input  p-shift-date
     1146         ,input  p-shift-num
     1147         ,input  p-shift-on
     1148         ,output v-fact-order
     1149         ,output p-shift-end-fact-order
     1150         ,output p-day-end-fact-order
     1151         ) no-error .
     1152       if error-status :error
     1153       then do:
     1154         message
     1155           vss-workfile vss-revision vss-description skip
     1156           "Ошибка при вызове процедуры factord"
     1157           error-status :get-message(1) skip
     1158           return-value skip
     1159           view-as alert-box error .
     1160         undo, return error return-value .
     1161       end.
     1162     end.
     1163   end procedure.
     1164   procedure factord-lock-shift :
     1165     define input  parameter p-obj-type  as character no-undo .
     1166     define input  parameter p-obj-code  as integer   no-undo .
     1167     define input  parameter p-fact-date as date      no-undo .
     1168     define parameter buffer buf_shift-obj for ub.shift-obj .
     1169     define variable v-shift-on      as logical   no-undo .
     1170     define variable v-extra-message as character no-undo .
     1171     define variable v-error as character no-undo .
     1172     do
     1173     on error undo, return error return-value
     1174     :
     1175   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1177     (input  p-obj-type
     1178     ,input  p-obj-code
     1179     ,input  'shift-on=request'
     1180     ,output v-shift-on
     1181     ) no-error .
     1182       if error-status :error
     1183       then do:
     1184         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1185         undo, return error v-error .
     1186       end.
     1187       if v-shift-on = true
     1188       then do:
     1189         find first buf_shift-obj share-lock
     1190           where buf_shift-obj.obj-type   = p-obj-type
     1191             and buf_shift-obj.obj-code   = p-obj-code
     1192             and buf_shift-obj.shift-date > p-fact-date
     1193           use-index pi
     1194           no-error .
     1195         if not available buf_shift-obj
     1196         or buf_shift-obj.status_ <> 'зкр':U
     1197         then do:
     1198           find last buf_shift-obj
     1199             where buf_shift-obj.obj-type = p-obj-type
     1200               and buf_shift-obj.obj-code = p-obj-code
     1201               and buf_shift-obj.status_  = 'зкр':U
     1202             use-index stts
     1203             no-error .
     1204           if available buf_shift-obj
     1205           then do:
     1206             assign
     1207               v-extra-message =
     1208                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1209                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1210                               )
     1211             .
     1212           end.
     1213           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1214           undo, return error v-error .
     1215         end.
     1216       end.
     1217     end.
     1218   end procedure.
     1219   procedure factord-end-day :
     1220     define input  parameter p-fact-date            as date    no-undo .
     1221     define output parameter p-day-end-fact-order   as decimal no-undo .
     1222     do
     1223     on error undo, return error return-value
     1224     :
     1225       if p-fact-date = ?
     1226       then do:
     1227         return error "Не указана фактическая дата" .
     1228       end.
     1229       assign
     1230         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1231       .
     1232     end.
     1233   end procedure.
     1234   procedure factord-to-date :
     1235     define input  parameter p-fact-order as decimal no-undo .
     1236     define output parameter p-fact-date  as date    no-undo .
     1237     define variable v-ref-date  as date      no-undo .
     1238     define variable v-ref-delta as integer   no-undo .
     1239     do
     1240     on error undo, return error return-value
     1241     :
     1242       if p-fact-order = ?
     1243       or p-fact-order = 0
     1244       then do:
     1245         return error "Не указан fact-order" .
     1246       end.
     1247       assign
     1248         v-ref-date  = date(1, 1, 2000)
     1249       .
     1250       assign
     1251         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1252       .
     1253       assign
     1254         p-fact-date = v-ref-date + v-ref-delta
     1255       .
     1256     end.
     1257   end procedure.
     1258   procedure factord-to-fact-num :
     1259     define input  parameter p-fact-order as decimal no-undo .
     1260     define output parameter p-fact-num   as integer no-undo .
     1261     define variable v-fact-order-trunc as decimal no-undo .
     1262     do
     1263     on error undo, return error return-value
     1264     :
     1265       if p-fact-order = ?
     1266       or p-fact-order = 0
     1267       then do:
     1268         return error "Не указан fact-order" .
     1269       end.
     1270       assign
     1271        v-fact-order-trunc = truncate(p-fact-order, 2)
     1272       .
     1273       assign
     1274         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1275       .
     1276     end.
     1277   end procedure.
     1278   procedure factord-to-shift-num :
     1279     define input  parameter p-fact-order as decimal no-undo .
     1280     define output parameter p-shift-num   as integer no-undo .
     1281     define variable  p-shift-numd  as decimal   no-undo .
     1282     define variable v-fact-order-trunc as decimal no-undo .
     1283     do
     1284     on error undo, return error return-value
     1285     :
     1286       if p-fact-order = ?
     1287       or p-fact-order = 0
     1288       then do:
     1289         return error "Не указан fact-order" .
     1290       end.
     1291       assign
     1292        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1293       .
     1294       if v-fact-order-trunc < 0.5 then do:
     1295         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1296       end.
     1297       assign
     1298         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1299         .
     1300        assign
     1301         p-shift-num = truncate (p-shift-numd , 0)
     1302       .
     1303     end.
     1304   end procedure.
     1305   procedure fact-order-mpl :
     1306     do
     1307     on error undo, return error return-value
     1308     :
     1309   define input  parameter p-doc-date as date     no-undo .
     1310   define input  parameter p-obj-type as character no-undo .
     1311   define input  parameter p-obj-code as integer   no-undo .
     1312   define output parameter p-fact-order as decimal   no-undo .
     1313   define variable v-fact-date            as date    no-undo .
     1314   define variable v-fact-time            as integer no-undo .
     1315   define variable v-fact-order           as decimal no-undo .
     1316   define variable v-shift-end-fact-order as decimal no-undo .
     1317   define variable v-day-end-fact-order   as decimal no-undo .
     1318   define variable l-shift-on as logical no-undo .
     1319   define variable l-date as date      no-undo .
     1320   define variable l-time as integer   no-undo .
     1321   define variable shift-date as date      no-undo .
     1322   define variable shift-num  as integer   no-undo .
     1323   define variable shift-name as character no-undo .
     1324   define variable max-fact-order as decimal   no-undo .
     1325   define buffer buf_global-state for ub.global-state  .
     1326   find first buf_global-state no-lock no-error .
     1327   if not available buf_global-state then do:
     1328      message
     1329        "Не заданы параметры ценообразования!"
     1330        view-as alert-box error
     1331      .
     1332      return error return-value .
     1333   end.
     1334     run cur-time in this-procedure
     1335     ( output v-fact-date ,
     1336       output v-fact-time  ).
     1337   if p-doc-date = ? then do:
     1338   if buf_global-state.pl-use-sys-date-time  = true then do:
     1339         run factord in this-procedure
     1340           (input  v-fact-date
     1341           ,input  v-fact-time
     1342           ,input  v-fact-time
     1343           ,input  ?
     1344           ,input  ?
     1345           ,input  false
     1346           ,output v-fact-order
     1347           ,output v-shift-end-fact-order
     1348           ,output v-day-end-fact-order
     1349           ) no-error .
     1350         if error-status :error
     1351         or v-fact-order = ?
     1352         or v-fact-order = 0 then do:
     1353           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1354         end.
     1355         p-fact-order = v-fact-order .
     1356   end.
     1357   else do:
     1358   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1360     (input  p-obj-type
     1361     ,input  p-obj-code
     1362     ,input  'shift-on=request'
     1363     ,output l-shift-on
     1364     ) no-error .
     1365         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     1366         if p-doc-date <> ? then do:
     1367         end.
     1368          run gbl/factdate.p
     1369          ( input        p-obj-type  ,
     1370            input        p-obj-code  ,
     1371            input-output v-fact-date ,
     1372            input-output v-fact-time ,
     1373            input-output shift-date      ,
     1374            input-output shift-num       ,
     1375            input-output shift-name      ,
     1376            input        yes
     1377            ) no-error .
     1378         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     1379         run factord in this-procedure
     1380           (input  v-fact-date
     1381           ,input  v-fact-time
     1382           ,input  v-fact-time
     1383           ,input  shift-date
     1384           ,input  shift-num
     1385           ,input  l-shift-on
     1386           ,output v-fact-order
     1387           ,output v-shift-end-fact-order
     1388           ,output v-day-end-fact-order
     1389           ) no-error .
     1390         if error-status :error
     1391         or v-fact-order = ?
     1392         or v-fact-order = 0 then do:
     1393           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1394         end.
     1395         p-fact-order = v-fact-order .
     1396   end.
     1397   end.
     1398   else do:
     1399          run gbl/factdate.p
     1400          ( input        p-obj-type  ,
     1401            input        p-obj-code  ,
     1402            input-output v-fact-date ,
     1403            input-output v-fact-time ,
     1404            input-output shift-date      ,
     1405            input-output shift-num       ,
     1406            input-output shift-name      ,
     1407            input        yes
     1408            ) no-error .
     1409         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1410         v-fact-date = p-doc-date .
     1411         run factord in this-procedure
     1412           (input  v-fact-date
     1413           ,input  v-fact-time
     1414           ,input  v-fact-time
     1415           ,input  shift-date
     1416           ,input  shift-num
     1417           ,input  l-shift-on
     1418           ,output v-fact-order
     1419           ,output v-shift-end-fact-order
     1420           ,output v-day-end-fact-order
     1421           ) no-error .
     1422         if error-status :error
     1423         or v-fact-order = ?
     1424         or v-fact-order = 0 then do:
     1425           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1426         end.
     1427         p-fact-order = v-fact-order .
     1428   end.
     1429     end.
     1430   end procedure.
     1431   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
     1432   field sale-qnty as decimal
     1433   field sale-sum  as decimal
     1434   field sale-tnv  as decimal
     1435   field price-sale-base as decimal
     1436   field price-sale-rubl as decimal
     1437   field road-tax-base   as decimal
     1438   field road-tax-rubl   as decimal
     1439   field excise-base as decimal
     1440   field excise-rubl as decimal
     1441   field date-1 as date
     1442   field date-2 as date
     1443   field shift-1 as int
     1444   field shift-2 as int
     1445   field time-1 as int
     1446   field time-2 as int
     1447   field grp-name as char
     1448   field interv-name as char
     1449   field pay-name as char
     1450   field unit-cli as char
     1451   index pi
     1452   plt-priority DESCENDING
     1453   fact-order DESCENDING
     1454   qnty-from asc
     1455   sum-from asc
     1456   turnover-from asc
     1457   date-1 DESCENDING
     1458   time-1 DESCENDING
     1459   date-2 DESCENDING
     1460   time-2 DESCENDING
     1461   type-price DESCENDING
     1462   .
     1463   procedure mpl-autoprice :
     1464   define input  parameter p-only-b-code as logical   no-undo .
     1465   define input  parameter p-cli-type    as character no-undo .
     1466   define input  parameter p-cli-code    as integer   no-undo .
     1467   define input  parameter p-main-b-code as integer   no-undo .
     1468   define input  parameter p-b-code      as integer   no-undo .
     1469   define input  parameter p-obj-type    as character no-undo .
     1470   define input  parameter p-obj-code    as integer   no-undo .
     1471   define input  parameter p-qnty-doc    as decimal   no-undo .
     1472   define input  parameter p-sum-doc     as decimal   no-undo .
     1473   define input  parameter p-vid-pay        as character no-undo .
     1474   define input  parameter p-cash-pay-type  as character no-undo .
     1475   define input  parameter p-fact-order  as decimal   no-undo .
     1476   define output parameter p-plt-id          as integer   no-undo .
     1477   define output parameter p-plt-db-num      as integer   no-undo .
     1478   define output parameter p-pdf-id          as integer   no-undo .
     1479   define output parameter p-pdf-db-num      as integer   no-undo .
     1480   define output parameter p-sale-price-base as decimal   no-undo .
     1481   define output parameter p-sale-price-rubl as decimal   no-undo .
     1482   define output parameter p-road-tax-base as decimal   no-undo .
     1483   define output parameter p-road-tax-rubl as decimal   no-undo .
     1484   define output parameter p-excise-base   as decimal   no-undo .
     1485   define output parameter p-excise-rubl   as decimal   no-undo .
     1486   define variable v-cli-oborot-ALL as decimal   no-undo .
     1487   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     1488   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     1489   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1490   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1491   define buffer buf_price-all              for ub.price-all  .
     1492   define buffer buf_goods                  for ub.goods      .
     1493   define buffer buf_global-state           for ub.global-state  .
     1494   define buffer buf_buyer-group            for ub.buyer-group  .
     1495   define buffer buf_turnover-group         for ub.turnover-group  .
     1496   define buffer buf_main-code              for ub.bar-code  .
     1497   define buffer buf_bar-code               for ub.bar-code  .
     1498   define buffer buf_pay-type               for ub.pay-type  .
     1499   define buffer buf_cash-pay               for ub.cash-pay  .
     1500   define variable to-day          as date      no-undo .
     1501   define variable v-base-rate0    as decimal   no-undo .
     1502   define variable v-base-scale0   as decimal   no-undo .
     1503   define variable v-exch-rate0    as decimal   no-undo .
     1504   define variable v-exch-scale0   as decimal   no-undo .
     1505   define variable v-base-rate     as decimal   no-undo .
     1506   define variable v-base-scale    as decimal   no-undo .
     1507   define variable v-exch-rate     as decimal   no-undo .
     1508   define variable v-exch-scale    as decimal   no-undo .
     1509   define variable v-host-code     as integer   no-undo .
     1510   define variable v-curr-abbr     as character no-undo .
     1511   define variable v-grp-name      as character no-undo .
     1512   define variable v-date-1        as date      no-undo .
     1513   define variable v-date-2        as date      no-undo .
     1514   define variable v-interv        as character no-undo .
     1515   define variable v-pay-name      as character no-undo .
     1516   define variable v-cli-oborot    as decimal   no-undo .
     1517   define variable v-trn-pay-code  as integer   no-undo .
     1518   define variable v-cash-pay-curr as integer   no-undo .
     1519   define variable v-cash-pay-code as integer   no-undo .
     1520   do
     1521   on error undo, return error return-value
     1522   :
     1523   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     1524   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     1525   if p-fact-order = ? then do:
     1526     run fact-order-mpl (
     1527         input   today       ,
     1528         input   p-obj-type  ,
     1529         input   p-obj-code  ,
     1530         output  p-fact-order ).
     1531   end.
     1532   if p-vid-pay <> "" then do:
     1533      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     1534      if available buf_pay-type
     1535         then v-trn-pay-code = buf_pay-type.obj-code.
     1536         else v-trn-pay-code =  0.
     1537   end.
     1538   else v-trn-pay-code = 0 .
     1539   if p-cash-pay-type <> "" then do:
     1540      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1541      if available buf_pay-type
     1542         then
     1543           assign
     1544             v-cash-pay-curr = buf_cash-pay.curr-code
     1545             v-cash-pay-code = buf_cash-pay.cdpay-code
     1546           .
     1547         else
     1548           assign
     1549             v-cash-pay-curr = 0
     1550             v-cash-pay-code = 0
     1551             .
     1552   end.
     1553   else
     1554     assign
     1555       v-cash-pay-curr = 0
     1556       v-cash-pay-code = 0
     1557       .
     1558   for each tt_price-all  : delete tt_price-all . end.
     1559   assign
     1560     p-plt-id             = ?
     1561     p-plt-db-num         = ?
     1562     p-pdf-id             = ?
     1563     p-pdf-db-num         = ?
     1564     p-sale-price-base    = ?
     1565     p-sale-price-rubl    = ?
     1566     v-cli-oborot         = 0
     1567   .
     1568   find first buf_global-state no-lock no-error .
     1569   if not available buf_global-state then do:
     1570      message
     1571        "Не заданы параметры ценообразования!"
     1572        view-as alert-box error
     1573      .
     1574      return error return-value .
     1575   end.
     1576   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1577   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1578     (input  p-obj-type
     1579     ,input  p-obj-code
     1580     ,output to-day
     1581     )  .
     1582   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1584     (input  p-obj-type
     1585     ,input  p-obj-code
     1586     ,output v-host-code
     1587     )  .
     1588   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1589   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1590     (input  v-host-code
     1591     ,input  to-day
     1592     ,output v-base-rate0
     1593     ,output v-base-scale0
     1594     )  .
     1595     v-cli-oborot-ALL  = 0 .
     1596     for each buf_turnover-buyer-main no-lock  where
     1597              buf_turnover-buyer-main.cli-type = p-cli-type  and
     1598              buf_turnover-buyer-main.cli-code = p-cli-code
     1599              :
     1600              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1601     end.
     1602   for each buf_price-all no-lock where
     1603            buf_price-all.obj-type = p-obj-type and
     1604            buf_price-all.obj-code = p-obj-code and
     1605            buf_price-all.gds-code = buf_goods.gds-code and
     1606            buf_price-all.status_  = 'акт':U  and
     1607          ( p-only-b-code = false   or
     1608          ( buf_price-all.b-code = p-main-b-code or
     1609            buf_price-all.b-code = p-b-code))    and
     1610           ( p-only-b-code = true  or
     1611             buf_price-all.b-code = p-b-code)
     1612             and
     1613             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1614           ( buf_price-all.fact-order-sys-to = ? or
     1615             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1616           :
     1617            v-interv   = "" .
     1618            v-grp-name = "" .
     1619            v-pay-name = "" .
     1620            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1621            if buf_price-all.bgr-id > 0 then do:
     1622               find first buf_buyer-group no-lock where
     1623                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1624                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1625               if available buf_buyer-group then do:
     1626                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1627                  find first buf_buyer-in-buyer-group no-lock where
     1628                             buf_buyer-in-buyer-group.stts         = 0 and
     1629                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1630                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1631                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1632                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1633                             no-error .
     1634                             if not available buf_buyer-in-buyer-group then do:
     1635                                v-grp-name = "".
     1636                                next.
     1637                             end.
     1638                             v-grp-name = buf_buyer-group.name .
     1639                  end.
     1640               end.
     1641               else do:
     1642                    v-grp-name = "".
     1643                    next.
     1644               end.
     1645            end.
     1646            if buf_price-all.tog-id > 0 then do:
     1647               find first buf_turnover-group no-lock where
     1648                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1649                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1650               if available buf_turnover-group then do:
     1651                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1652                     v-cli-oborot = v-cli-oborot-all  .
     1653                     find first buf1_tnv-in-turnover-group no-lock where
     1654                                buf1_tnv-in-turnover-group.stts       =  0     and
     1655                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1656                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1657                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1658                     find first buf2_tnv-in-turnover-group no-lock where
     1659                                buf2_tnv-in-turnover-group.stts       =  0     and
     1660                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1661                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1662                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1663                     if not (available buf1_tnv-in-turnover-group and
     1664                             available buf2_tnv-in-turnover-group ) then do:
     1665                             v-grp-name = "".
     1666                             next .
     1667                     end.
     1668                     v-grp-name = buf_turnover-group.name.
     1669                  end.
     1670               end.
     1671               else do:
     1672                    v-grp-name = "".
     1673                    next.
     1674               end.
     1675            end.
     1676            if buf_price-all.plt-fix-cource-crc-base = true then
     1677               assign
     1678                 v-base-rate  = buf_price-all.pdf-base-rate
     1679                 v-base-scale = buf_price-all.pdf-base-scale
     1680               .
     1681               else
     1682               assign
     1683                 v-base-rate  = v-base-rate0
     1684                 v-base-scale = v-base-scale0
     1685               .
     1686            if buf_price-all.plt-fix-cource-crc-doc = true then
     1687               assign
     1688                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1689                 v-exch-scale = buf_price-all.pdf-exch-scale
     1690               .
     1691               else do:
     1692   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1693   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1694     (input  buf_price-all.curr-code
     1695     ,input  to-day
     1696     ,output v-exch-rate0
     1697     ,output v-exch-scale0
     1698     ,output v-curr-abbr
     1699     )  .
     1700               assign
     1701                 v-exch-rate  = v-exch-rate0
     1702                 v-exch-scale = v-exch-scale0
     1703                 .
     1704              end.
     1705              v-date-1 = date ( "" )  .
     1706              if buf_price-all.fact-order-sys-from > 0 then do:
     1707                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1708                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1709                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1710              end.
     1711              v-date-2 =  date ( "" )  .
     1712              if buf_price-all.fact-order-sys-to > 0 then do:
     1713                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1714                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1715                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1716              end.
     1717              if buf_price-all.qnty-from <> ? then do :
     1718                 if not (
     1719                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1720                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1721                 ) then do:
     1722                        v-interv = "".
     1723                        next.
     1724                 end.
     1725                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1726              end.
     1727              if buf_price-all.sum-from <> ? then do :
     1728                 if not (
     1729                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1730                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1731                 ) then do:
     1732                    v-interv = "".
     1733                    next.
     1734                 end.
     1735                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1736              end.
     1737              if buf_price-all.turnover-from <> ? then do :
     1738                 if not (
     1739                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1740                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1741                 ) then do:
     1742                    v-interv = "".
     1743                    next.
     1744                 end.
     1745                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1746              end.
     1747              if buf_price-all.use-pay-type = 1 then do :
     1748                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     1749                    v-pay-name = "" .
     1750                    next.
     1751                  end.
     1752                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     1753              end.
     1754              if buf_price-all.use-cash-pay = 1 then do :
     1755                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     1756                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     1757                   v-pay-name = "" .
     1758                   next.
     1759                 end.
     1760                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     1761              end.
     1762             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     1763             create tt_price-all .
     1764             buffer-copy buf_price-all to tt_price-all
     1765             assign
     1766               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     1767               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     1768               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     1769               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     1770               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     1771               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     1772               tt_price-all.price-sale     = buf_price-all.price-sale
     1773               tt_price-all.road-tax       = buf_price-all.road-tax
     1774               tt_price-all.excise         = buf_price-all.excise
     1775               tt_price-all.pdf-exch-rate   = v-exch-rate
     1776               tt_price-all.pdf-exch-scale  = v-exch-scale
     1777               tt_price-all.pdf-base-rate   = v-base-rate
     1778               tt_price-all.pdf-base-scale  = v-base-scale
     1779               tt_price-all.grp-name        = v-grp-name
     1780               tt_price-all.date-1          = v-date-1
     1781               tt_price-all.shift-1         = buf_price-all.start-shift-num
     1782               tt_price-all.time-1          = buf_price-all.start-sys-time
     1783               tt_price-all.date-2          = v-date-2
     1784               tt_price-all.shift-2         = buf_price-all.end-shift-num
     1785               tt_price-all.time-2          = buf_price-all.end-sys-time
     1786               tt_price-all.interv-name     = v-interv
     1787               tt_price-all.pay-name        = v-pay-name
     1788               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     1789             .
     1790   end.
     1791   define variable vt-plt-id as integer   no-undo .
     1792   define variable vt-plt-db as integer   no-undo .
     1793   define variable vt-pdf-id as integer   no-undo .
     1794   define variable vt-pdf-db as integer   no-undo .
     1795   define buffer neos_price-all for tt_price-all  .
     1796   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     1797       if available tt_price-all then do:
     1798        assign
     1799          vt-plt-id = tt_price-all.plt-id
     1800          vt-plt-db = tt_price-all.plt-db-num
     1801          vt-pdf-id = tt_price-all.pdf-id
     1802          vt-pdf-db = tt_price-all.pdf-db
     1803        .
     1804        if tt_price-all.b-code = p-b-code then do:
     1805             assign
     1806               p-plt-id           = tt_price-all.plt-id
     1807               p-plt-db-num       = tt_price-all.plt-db-num
     1808               p-pdf-id           = tt_price-all.pdf-id
     1809               p-pdf-db-num       = tt_price-all.pdf-db
     1810               p-sale-price-base  = tt_price-all.price-sale-base
     1811               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1812               p-road-tax-base    = tt_price-all.road-tax-base
     1813               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1814               p-excise-base      = tt_price-all.excise-base
     1815               p-excise-rubl      = tt_price-all.excise-rubl
     1816               .
     1817        end.
     1818        else do:
     1819          find first neos_price-all where
     1820                     neos_price-all.b-code     = p-b-code  and
     1821                     neos_price-all.plt-id     = vt-plt-id and
     1822                     neos_price-all.plt-db-num = vt-plt-db and
     1823                     neos_price-all.pdf-id     = vt-pdf-id and
     1824                     neos_price-all.pdf-db     = vt-pdf-db
     1825                     use-index pi no-error .
     1826            if available neos_price-all then do:
     1827             assign
     1828               p-plt-id           = tt_price-all.plt-id
     1829               p-plt-db-num       = tt_price-all.plt-db-num
     1830               p-pdf-id           = tt_price-all.pdf-id
     1831               p-pdf-db-num       = tt_price-all.pdf-db
     1832               p-sale-price-base  = neos_price-all.price-sale-base
     1833               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1834               p-road-tax-base    = neos_price-all.road-tax-base
     1835               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1836               p-excise-base      = neos_price-all.excise-base
     1837               p-excise-rubl      = neos_price-all.excise-rubl
     1838               .
     1839            end.
     1840            else do:
     1841                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1842                 if error-status :error    then do:
     1843                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1844                   return error return-value .
     1845                 end.
     1846             assign
     1847               p-plt-id           = tt_price-all.plt-id
     1848               p-plt-db-num       = tt_price-all.plt-db-num
     1849               p-pdf-id           = tt_price-all.pdf-id
     1850               p-pdf-db-num       = tt_price-all.pdf-db
     1851               p-sale-price-base  = tt_price-all.price-sale-base
     1852               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1853               p-road-tax-base    = tt_price-all.road-tax-base
     1854               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1855               p-excise-base      = tt_price-all.excise-base
     1856               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     1857               .
     1858            end.
     1859        end.
     1860     end.
     1861   end.
     1862   end procedure.
     1863   procedure mpl-tpl-auto :
     1864   define input  parameter p-b-code     as integer   no-undo .
     1865   define input  parameter p-obj-type   as character no-undo .
     1866   define input  parameter p-obj-code   as integer   no-undo .
     1867   define input  parameter p-plt-id     as integer   no-undo .
     1868   define input  parameter p-plt-db-num as integer   no-undo .
     1869   define input  parameter p-fact-order as decimal   no-undo .
     1870   define output parameter p-sale-price as decimal   no-undo .
     1871   define output parameter p-pdf-id     as integer   no-undo .
     1872   define output parameter p-pdf-db-num as integer   no-undo .
     1873     do
     1874     on error undo, return error return-value
     1875     :
     1876   if p-fact-order = ? then do:
     1877     run fact-order-mpl (
     1878         input   today       ,
     1879         input   p-obj-type  ,
     1880         input   p-obj-code  ,
     1881         output  p-fact-order ) .
     1882   end.
     1883   assign
     1884     p-pdf-id      = ?
     1885     p-pdf-db-num  = ?
     1886     p-sale-price  = ?
     1887   .
     1888   define buffer buf_bar-code for ub.bar-code  .
     1889   define buffer buf_goods for ub.goods  .
     1890   find first buf_bar-code no-lock where
     1891              buf_bar-code.b-code = p-b-code
     1892              no-error .
     1893   if error-status :error then return error return-value .
     1894   find first buf_goods no-lock where
     1895              buf_goods.gds-code = buf_bar-code.gds-code
     1896              no-error .
     1897   if error-status :error then return error return-value .
     1898   define variable v-main-b-code as integer   no-undo .
     1899   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1900     (input  buf_goods.gds-code
     1901     ,input  ?
     1902     ,output v-main-b-code
     1903     )  .
     1904   define buffer buf_price-all for ub.price-all  .
     1905   for each tt_price-all : delete tt_price-all. end.
     1906       for each buf_price-all no-lock where
     1907               buf_price-all.plt-id     = p-plt-id                 and
     1908               buf_price-all.plt-db-num = p-plt-db-num             and
     1909               buf_price-all.obj-type   = p-obj-type               and
     1910               buf_price-all.obj-code   = p-obj-code               and
     1911               buf_price-all.gds-code   = buf_goods.gds-code       and
     1912             ( buf_price-all.b-code = v-main-b-code or
     1913               buf_price-all.b-code = p-b-code)    and
     1914               buf_price-all.status_    = 'акт':U         and
     1915               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1916             ( buf_price-all.fact-order-sys-to = ? or
     1917               buf_price-all.fact-order-sys-to >=  p-fact-order)
     1918               :
     1919                 create tt_price-all .
     1920                 buffer-copy buf_price-all to tt_price-all
     1921                 assign
     1922                   tt_price-all.price-sale  = buf_price-all.price-sale
     1923                 .
     1924       end.
     1925   define variable vt-plt-id as integer   no-undo .
     1926   define variable vt-plt-db as integer   no-undo .
     1927   define variable vt-pdf-id as integer   no-undo .
     1928   define variable vt-pdf-db as integer   no-undo .
     1929   define buffer neos_price-all for tt_price-all  .
     1930   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     1931       if available tt_price-all then do:
     1932        assign
     1933          vt-plt-id = tt_price-all.plt-id
     1934          vt-plt-db = tt_price-all.plt-db-num
     1935          vt-pdf-id = tt_price-all.pdf-id
     1936          vt-pdf-db = tt_price-all.pdf-db
     1937        .
     1938        if tt_price-all.b-code = p-b-code then do:
     1939             assign
     1940               p-plt-id           = tt_price-all.plt-id
     1941               p-plt-db-num       = tt_price-all.plt-db-num
     1942               p-pdf-id           = tt_price-all.pdf-id
     1943               p-pdf-db-num       = tt_price-all.pdf-db
     1944               p-sale-price       = tt_price-all.price-sale
     1945               .
     1946        end.
     1947        else do:
     1948          find first neos_price-all where
     1949                     neos_price-all.b-code     = p-b-code  and
     1950                     neos_price-all.plt-id     = vt-plt-id and
     1951                     neos_price-all.plt-db-num = vt-plt-db and
     1952                     neos_price-all.pdf-id     = vt-pdf-id and
     1953                     neos_price-all.pdf-db     = vt-pdf-db
     1954                     use-index pi no-error .
     1955            if available neos_price-all then do:
     1956             assign
     1957               p-plt-id           = tt_price-all.plt-id
     1958               p-plt-db-num       = tt_price-all.plt-db-num
     1959               p-pdf-id           = tt_price-all.pdf-id
     1960               p-pdf-db-num       = tt_price-all.pdf-db
     1961               p-sale-price       = neos_price-all.price-sale
     1962               .
     1963            end.
     1964            else do:
     1965           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1966           if error-status :error    then do:
     1967              message "Не найден бар-код" p-b-code view-as alert-box error .
     1968              return error return-value .
     1969           end.
     1970             assign
     1971               p-plt-id           = tt_price-all.plt-id
     1972               p-plt-db-num       = tt_price-all.plt-db-num
     1973               p-pdf-id           = tt_price-all.pdf-id
     1974               p-pdf-db-num       = tt_price-all.pdf-db
     1975               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     1976               .
     1977            end.
     1978        end.
     1979     end.
     1980     end.
     1981   end procedure.
     1982   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1983   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1984   procedure wthcattr-sprcli :
     1985   define input parameter parparentproc  as widget-handle no-undo.
     1986   define input parameter p-mode  as character no-undo.
     1987   define input-output parameter p-value as character no-undo .
     1988   define output parameter p-setted as logical no-undo .
     1989     DEFINE VARIABLE v-value as character no-undo .
     1990     define variable v-cli-type as character no-undo .
     1991     define variable v-cli-code as integer no-undo .
     1992     define buffer buf_clients   for ub.clients.
     1993     define variable v_rid as character no-undo.
     1994     define variable ref-rec as recid no-undo .
     1995     do
     1996     on error undo, return error
     1997     :
     1998         v-value = p-value.
     1999      if p-value <> '':U then do:
     2000       assign
     2001       v-cli-type = substring(p-value, 1, 3)
     2002       v-cli-code = integer(substring(p-value, 4))
     2003       no-error.
     2004       if error-status:error then do:
     2005         assign
     2006         v-cli-type = '':U
     2007         v-cli-code = 0
     2008         .
     2009       end.
     2010      end.
     2011      FIND FIRST buf_clients NO-LOCK WHERE
     2012               buf_clients.obj-type = v-cli-type AND
     2013               buf_clients.obj-code = v-cli-code  NO-ERROR.
     2014      IF available(buf_clients) then do:
     2015       run ref/cli-all.w (
     2016                   input parparentproc
     2017                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     2018                  ,input v-cli-type
     2019                  ,input 'все':U
     2020                  ,input 'все':U
     2021                  ,input RECID( buf_clients )
     2022                  ,input ",,,,,,NO"
     2023                  ,input ?
     2024                  ,OUTPUT v_rid ).
     2025     END.
     2026     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     2027       run ref/cli-all.w (
     2028                    input parparentproc
     2029                   ,INPUT "b-sel":U
     2030                  ,input  v-cli-type
     2031                  ,input 'все':U
     2032                  ,input 'текущие':U
     2033                  ,input ?
     2034                  ,input ",,,,,,NO"
     2035                  ,input ?
     2036                  ,OUTPUT v_rid ).
     2037     END.
     2038     else do:
     2039       message
     2040       if p-value = "":U then 'Атрибут не задан!'
     2041       else substitute('Не найден клиент &1',p-value)
     2042       view-as alert-box warning.
     2043     end.
     2044     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     2045       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     2046       IF ERROR-STATUS:ERROR THEN DO:
     2047           RETURN NO-APPLY.
     2048       END.
     2049       FIND FIRST buf_clients NO-LOCK WHERE
     2050                  RECID( buf_clients ) = ref-rec NO-ERROR.
     2051       IF AVAIL buf_clients THEN DO:
     2052         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     2053       end.
     2054     end.
     2055     if v-value <> p-value then do:
     2056       p-value = v-value.
     2057       p-setted = yes.
     2058     end.
     2059     end.
     2060   end procedure.
     2061     define new global shared variable g#wthcalib as handle no-undo.
     2062   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     2063   define variable v-tth as handle no-undo .
     2064   assign
     2065   v-tth = buffer thbjattr_thbj-attr:table-handle .
     2066   def temp-table tt-wthlib-parts no-undo like ub.wth-parts.
     2067   Procedure wth-doc-close:
     2068       define input parameter p-rec        as recid     no-undo .
     2069       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     2070     do
     2071     on error undo, return error return-value
     2072     :
     2073       find first cur-wth-parts where recid(cur-wth-parts) = p-rec exclusive-lock no-wait no-error.
     2074       if not available cur-wth-parts then return error substitute("Не найдена партия").
     2075       CASE cur-wth-parts.ext-doc-type:
     2076           WHEN 'ie':U or when 'rf':U or when 'ff':U
     2077           OR WHEN 'fj':U
     2078           THEN DO:
     2079              RUN wth-parts-close(BUFFER cur-wth-parts, 'free-zone':U ).
     2080           END.
     2081           WHEN 'ee':U THEN DO:
     2082               RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     2083           END.
     2084           WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'rp':U
     2085             OR WHEN 'ip':U OR WHEN 'pc':U
     2086             OR WHEN 'pj':U
     2087              THEN DO:
     2088               RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     2089           END.
     2090           WHEN 'df':U OR WHEN 'dp':U OR WHEN 'dc':U THEN DO:
     2091             RUN wth-parts-close(BUFFER cur-wth-parts, 'out-zone':U ).
     2092           end.
     2093           when 'ep':U or when 'ef':U
     2094           OR WHEN 'oj':U or when 'jj':U
     2095           then .
     2096           when 'xc':U then do:
     2097             if cur-wth-parts.type = 'при':U then
     2098                  RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     2099             else RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     2100           end.
     2101           OTHERWISE DO:
     2102               RETURN ERROR substitute("Неверный вызов процедуры закрытия: расш. тип = &1"
     2103                                    , cur-wth-parts.ext-doc-type
     2104                                       ).
     2105           END.
     2106       END CASE.
     2107       RELEASE cur-wth-parts.
     2108       END.
     2109   END.
     2110   PROCEDURE wth-parts-close:
     2111       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     2112       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     2113       define variable v-rec as recid.
     2114       if bfrom_wth-parts.stts  = 1 then return.
     2115          run str/wthpartp.p  ( INPUT     'ДОБАВЛЕНИЕ':U,
     2116                     INPUT     bfrom_wth-parts.obj-type,
     2117                     INPUT     bfrom_wth-parts.obj-code,
     2118                     INPUT     bfrom_wth-parts.w-p-code,
     2119                     INPUT     bfrom_wth-parts.wth-code,
     2120                     INPUT     bfrom_wth-parts.par-code,
     2121                     INPUT     bfrom_wth-parts.in-code ,
     2122                     INPUT     p-zone,
     2123                     INPUT     bfrom_wth-parts.ser-code,
     2124                     INPUT     bfrom_wth-parts.db-num  ,
     2125                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2126                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     2127                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2128                     INPUT     bfrom_wth-parts.fact-rangeTo ,
     2129                     INPUT     bfrom_wth-parts.host-code     ,
     2130                     INPUT     bfrom_wth-parts.contract-code               ,
     2131                     INPUT     bfrom_wth-parts.price-rubl    ,
     2132                     INPUT     bfrom_wth-parts.price-base    ,
     2133                     INPUT     bfrom_wth-parts.supp-type,
     2134                     INPUT     bfrom_wth-parts.supp-code,
     2135                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2136                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2137                     INPUT     bfrom_wth-parts.ext-doc-type,
     2138                     INPUT     bfrom_wth-parts.gds-code,
     2139                     INPUT     bfrom_wth-parts.stts               ,
     2140                     INPUT     bfrom_wth-parts.beg-dt        ,
     2141                     INPUT     bfrom_wth-parts.end-dt        ,
     2142                     INPUT     bfrom_wth-parts.vat-pc        ,
     2143                     INPUT     bfrom_wth-parts.cli-code,
     2144                     INPUT     bfrom_wth-parts.cli-type,
     2145                     INPUT     bfrom_wth-parts.out-obj-code,
     2146                     INPUT     bfrom_wth-parts.out-obj-type,
     2147                     INPUT     bfrom_wth-parts.sale-obj-code,
     2148                     INPUT     bfrom_wth-parts.sale-obj-type,
     2149                     INPUT     bfrom_wth-parts.out-code ,
     2150                     INPUT  yes,
     2151                     INPUT     '':U ,
     2152                     INPUT-OUTPUT v-rec
     2153                     ) no-error.
     2154       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2155   END.
     2156   Procedure wth-doc-razrez:
     2157       define input parameter p-rec as recid NO-UNDO.
     2158       define input parameter p-doc-del AS log NO-UNDO.
     2159       define variable v-mess AS CHAR NO-UNDO.
     2160       define variable p-silent AS LOG INIT NO NO-UNDO.
     2161       DEFINE BUFFER b-wth-parts FOR ub.wth-parts.
     2162       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     2163       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     2164     do
     2165     on error undo, return error return-value
     2166     :
     2167       FIND FIRST cur-wth-parts WHERE recid(cur-wth-parts) = p-rec
     2168                                 EXCLUSIVE-LOCK .
     2169       IF AVAILABLE cur-wth-parts THEN DO:
     2170           CASE cur-wth-parts.ext-doc-type:
     2171               WHEN 'ie':U or when 'ip':U or when 'rp':U
     2172               or when 'ff':U or when 'rf':U
     2173               or when 'fj':U or when 'pj':U
     2174               THEN DO:
     2175                   RUN wth-parts-raz(BUFFER cur-wth-parts, "":U,p-doc-del) .
     2176               END.
     2177               WHEN 'ee':U or when 'ef':U or when 'jj':U
     2178               THEN DO:
     2179                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del) .
     2180               END.
     2181               WHEN 'ep':U or when 'oj':U THEN DO:
     2182                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del) .
     2183               END.
     2184               WHEN 'pc':U THEN DO:
     2185                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     2186               END.
     2187               WHEN 'dp':U THEN DO:
     2188                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del)  .
     2189               END.
     2190               WHEN 'df':U THEN DO:
     2191                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del)  .
     2192               END.
     2193               WHEN 'dc':U THEN DO:
     2194                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     2195               END.
     2196               WHEN 'ps':U OR WHEN 'pz':U THEN DO:
     2197                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del).
     2198               END.
     2199               when 'xc':U then do:
     2200                 if cur-wth-parts.type = 'при':U then
     2201                      RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del ).
     2202                 else RUN wth-parts-raz(BUFFER cur-wth-parts,  'free-zone':U ,p-doc-del).
     2203               end.
     2204               OTHERWISE DO:
     2205                   RETURN ERROR substitute("Неверный вызов процедуры разрезервирования: расш. тип =  :&1&2&3"
     2206                                        , cur-wth-parts.ext-doc-type
     2207                                        , error-status:get-message(1)
     2208                                        , return-value
     2209                                        ).
     2210               END.
     2211           END CASE.
     2212       END.
     2213     END.
     2214   END.
     2215   PROCEDURE wth-parts-raz:
     2216       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     2217       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     2218       DEFINE INPUT PARAMETER p-doc-del AS log NO-UNDO.
     2219       define variable v-mes as char no-undo.
     2220       define variable v-rec as recid no-undo.
     2221       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     2222     do
     2223     on error undo, return error return-value
     2224     :
     2225       v-mes = substitute('Код серии: &1-&2 Диапазон &3-&4'
     2226                                      ,bfrom_wth-parts.ser-code
     2227                                      ,bfrom_wth-parts.db-num
     2228                                      ,bfrom_wth-parts.doc-rangeFrom
     2229                                      ,bfrom_wth-parts.doc-rangeTo).
     2230       IF lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0 THEN DO:
     2231           RETURN ERROR substitute("Нельзя удалять партии МЦ из зоны :&1&2&3&4&5"
     2232                                , error-status:get-message(1)
     2233                                , bfrom_wth-parts.out-code
     2234                                , return-value
     2235                                ,chr(10)
     2236                                ,v-mes
     2237                                ).
     2238       END.
     2239       v-rec = recid(bfrom_wth-parts).
     2240       CASE bfrom_wth-parts.ext-doc-type:
     2241           WHEN 'ie':U  or when 'fj':U or when  'pj':U THEN DO:
     2242               delete bfrom_wth-parts NO-ERROR.
     2243               if error-status:error then do:
     2244                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     2245                                      , error-status:get-message(1)
     2246                                      , chr(10)
     2247                                      , return-value
     2248                                      ,v-mes
     2249                                      ).
     2250               END.
     2251           END.
     2252           when 'rp':U or when 'rf':U then do:
     2253             if p-doc-del then do:
     2254               delete bfrom_wth-parts NO-ERROR.
     2255               if error-status:error then do:
     2256                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     2257                                      , error-status:get-message(1)
     2258                                      , chr(10)
     2259                                      , return-value
     2260                                      ,v-mes
     2261                                      ).
     2262               END.
     2263             end.
     2264             else   RETURN ERROR 'Нельзя удалять партии документа внутреннего возврата.'  .
     2265           end.
     2266           when 'ip':U or when 'ff':U then do:
     2267             if p-doc-del then do:
     2268               delete bfrom_wth-parts NO-ERROR.
     2269               if error-status:error then do:
     2270                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     2271                                      , error-status:get-message(1)
     2272                                      , chr(10)
     2273                                      , return-value
     2274                                      ,v-mes
     2275                                      ).
     2276               END.
     2277             end.
     2278             else do:
     2279               run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2280                     INPUT     bfrom_wth-parts.obj-type,
     2281                     INPUT     bfrom_wth-parts.obj-code,
     2282                     INPUT     bfrom_wth-parts.w-p-code,
     2283                     INPUT     bfrom_wth-parts.wth-code,
     2284                     INPUT     bfrom_wth-parts.par-code,
     2285                     INPUT     bfrom_wth-parts.in-code ,
     2286                     INPUT     bfrom_wth-parts.out-code,
     2287                     INPUT     bfrom_wth-parts.ser-code,
     2288                     INPUT     bfrom_wth-parts.db-num  ,
     2289                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2290                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2291                     INPUT     bfrom_wth-parts.doc-RangeFrom ,
     2292                     INPUT     bfrom_wth-parts.doc-rangeTo  ,
     2293                     INPUT     bfrom_wth-parts.host-code     ,
     2294                     INPUT     bfrom_wth-parts.contract-code ,
     2295                     INPUT     bfrom_wth-parts.price-rubl    ,
     2296                     INPUT     bfrom_wth-parts.price-base    ,
     2297                     INPUT     bfrom_wth-parts.supp-type,
     2298                     INPUT     bfrom_wth-parts.supp-code,
     2299                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2300                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2301                     INPUT     bfrom_wth-parts.ext-doc-type,
     2302                     INPUT     bfrom_wth-parts.gds-code,
     2303                     INPUT     1            ,
     2304                     INPUT     bfrom_wth-parts.beg-dt        ,
     2305                     INPUT     bfrom_wth-parts.end-dt        ,
     2306                     INPUT     bfrom_wth-parts.vat-pc        ,
     2307                     INPUT     bfrom_wth-parts.cli-code,
     2308                     INPUT     bfrom_wth-parts.cli-type,
     2309                     INPUT     bfrom_wth-parts.out-obj-code,
     2310                     INPUT     bfrom_wth-parts.out-obj-type,
     2311                     INPUT     bfrom_wth-parts.sale-obj-code,
     2312                     INPUT     bfrom_wth-parts.sale-obj-type,
     2313                     INPUT     bfrom_wth-parts.doc-code ,
     2314                     INPUT  yes,
     2315                     INPUT     bfrom_wth-parts.type ,
     2316                     INPUT-OUTPUT v-rec
     2317                     ) no-error.
     2318                if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2319             end.
     2320           end.
     2321           OTHERWISE DO:
     2322            run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2323                     INPUT     bfrom_wth-parts.obj-type,
     2324                     INPUT     bfrom_wth-parts.obj-code,
     2325                     INPUT     bfrom_wth-parts.w-p-code,
     2326                     INPUT     bfrom_wth-parts.wth-code,
     2327                     INPUT     bfrom_wth-parts.par-code,
     2328                     INPUT     bfrom_wth-parts.in-code ,
     2329                     INPUT     p-zone,
     2330                     INPUT     bfrom_wth-parts.ser-code,
     2331                     INPUT     bfrom_wth-parts.db-num  ,
     2332                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2333                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2334                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2335                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     2336                     INPUT     bfrom_wth-parts.host-code     ,
     2337                     INPUT     bfrom_wth-parts.contract-code ,
     2338                     INPUT     bfrom_wth-parts.price-rubl    ,
     2339                     INPUT     bfrom_wth-parts.price-base    ,
     2340                     INPUT     bfrom_wth-parts.supp-type,
     2341                     INPUT     bfrom_wth-parts.supp-code,
     2342                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2343                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2344                     INPUT     bfrom_wth-parts.ext-doc-type,
     2345                     INPUT     bfrom_wth-parts.gds-code,
     2346                     INPUT     bfrom_wth-parts.stts             ,
     2347                     INPUT     bfrom_wth-parts.beg-dt        ,
     2348                     INPUT     bfrom_wth-parts.end-dt        ,
     2349                     INPUT     bfrom_wth-parts.vat-pc        ,
     2350                     INPUT     bfrom_wth-parts.cli-code,
     2351                     INPUT     bfrom_wth-parts.cli-type,
     2352                     INPUT     bfrom_wth-parts.out-obj-code,
     2353                     INPUT     bfrom_wth-parts.out-obj-type,
     2354                     INPUT     bfrom_wth-parts.sale-obj-code,
     2355                     INPUT     bfrom_wth-parts.sale-obj-type,
     2356                     INPUT     bfrom_wth-parts.doc-code ,
     2357                     INPUT  yes,
     2358                     INPUT      "":U ,
     2359                     INPUT-OUTPUT v-rec
     2360                     ) no-error.
     2361       if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2362           END.
     2363       END CASE.
     2364     END.
     2365   END.
     2366   procedure wth-parts-rezerv:
     2367       define input parameter        p-param            as logical no-undo.
     2368       define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2369       define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2370       define input parameter        p-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2371       define input parameter        p-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2372       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2373       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2374       define input parameter        p-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2375       define input parameter        p-price-base       LIKE ub.wth-parts.price-base no-undo .
     2376       define input parameter        p-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2377       define input parameter        p-host-code        LIKE ub.wth-parts.host-code no-undo .
     2378       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2379       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2380       define input parameter        p-w-p-code         LIKE ub.wth-parts.w-p-code no-undo .
     2381       define input parameter        p-wth-code         LIKE ub.wth-parts.wth-code no-undo .
     2382       define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2383       define input parameter        p-in-code          LIKE ub.wth-parts.in-code no-undo .
     2384       define input parameter        p-doc-code         LIKE ub.wth-parts.out-code no-undo .
     2385       define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2386       define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2387       define input parameter        p-ext-doc-type     LIKE ub.wth-parts.ext-doc-type no-undo .
     2388       define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2389       define input parameter        p-type             LIKE ub.wth-parts.type no-undo .
     2390       define input-output parameter p-rec        as recid     no-undo .
     2391     define buffer bfrom_wth-parts   for ub.wth-parts.
     2392     define buffer bufr_wth-doc      for ub.wth-doc.
     2393     define variable v-rec    as recid        no-undo.
     2394     define variable v-recDop as recid        no-undo.
     2395     define variable v-zone   as character    no-undo.
     2396     DEFINE variable v-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2397     define VARIABLE v-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2398     define variable v-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2399     define variable v-price-base       LIKE ub.wth-parts.price-base no-undo .
     2400     define variable v-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2401     define variable v-mpl-date         as date      no-undo.
     2402     empty temp-table tt-wthlib-parts.
     2403   main-block:
     2404   do  transaction
     2405   on error  undo main-block, return error return-value + chr(32) + error-status:get-message(1)
     2406   on stop   undo main-block, return error
     2407   on endkey undo main-block, return error
     2408   :
     2409   FIND FIRST bufr_wth-doc WHERE bufr_wth-doc.doc-code = p-doc-code NO-LOCK NO-ERROR.
     2410   IF NOT AVAILABLE bufr_wth-doc THEN RETURN ERROR SUBSTITUTE('Не найден документ МЦ с номером &1',p-doc-code).
     2411     if lookup(p-ext-doc-type,'ie,ip,rp,fj,pj,ff,rf':U) > 0
     2412           then do:
     2413        run str/wthpartp.p  ( INPUT 'ДОБАВЛЕНИЕ':U,
     2414                     INPUT  p-obj-type,
     2415                     INPUT  p-obj-code,
     2416                     INPUT  p-w-p-code,
     2417                     INPUT  p-wth-code,
     2418                     INPUT  p-par-code,
     2419                     INPUT  p-in-code,
     2420                     INPUT  p-doc-code,
     2421                     INPUT  p-ser-code,
     2422                     INPUT  p-db-num  ,
     2423                     INPUT  p-Fact-RangeFrom ,
     2424                     INPUT  p-fact-rangeTo  ,
     2425                     INPUT  p-Fact-RangeFrom ,
     2426                     INPUT  p-fact-rangeTo ,
     2427                     INPUT  p-host-code     ,
     2428                     INPUT  0   ,
     2429                     INPUT  p-price-rubl    ,
     2430                     INPUT  p-price-base    ,
     2431                     INPUT  '':U,
     2432                     INPUT  0,
     2433                     INPUT  p-obj-type      ,
     2434                     INPUT  p-obj-code      ,
     2435                     INPUT  p-ext-doc-type,
     2436                     INPUT  p-gds-code,
     2437                     INPUT  0           ,
     2438                     INPUT  p-beg-dt        ,
     2439                     INPUT  p-end-dt        ,
     2440                     INPUT  p-vat-pc      ,
     2441                     INPUT  0,
     2442                     INPUT  '':U,
     2443                     INPUT  0,
     2444                     INPUT  '':U,
     2445                     INPUT  0,
     2446                     INPUT  '':U,
     2447                     INPUT  p-doc-code,
     2448                     INPUT  yes,
     2449                     INPUT p-type,
     2450                     INPUT-OUTPUT p-rec
     2451                     ) no-error.
     2452                   if error-status:error then undo main-block, return error return-value + error-status:get-message(1) .
     2453     end.
     2454     else do:
     2455       if p-rec <> ? then do:
     2456         find first bfrom_wth-parts exclusive-lock where
     2457                   recid(bfrom_wth-parts) = p-rec no-error.
     2458         if  available bfrom_wth-parts
     2459           and bfrom_wth-parts.wth-code = p-wth-code
     2460           and bfrom_wth-parts.par-code = p-par-code
     2461           and bfrom_wth-parts.ser-code = p-ser-code
     2462           and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0
     2463         then.
     2464         else if  available bfrom_wth-parts and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0
     2465         then return error substitute('Резервирование из партии (Код серии: &1-&2 Диапазон &3-&4) невозможно, т.к. партия уже входит в состав документа'
     2466                                      ,bfrom_wth-parts.ser-code
     2467                                      ,bfrom_wth-parts.db-num
     2468                                      ,bfrom_wth-parts.doc-rangeFrom
     2469                                      ,bfrom_wth-parts.doc-rangeTo).
     2470         else if  available bfrom_wth-parts then undo, return error 'Партия указанная для резервирования не соответсвует указанным параметрам!'.
     2471         if available bfrom_wth-parts
     2472            and bfrom_wth-parts.doc-rangeFrom > p-fact-rangeFrom
     2473            or bfrom_wth-parts.doc-rangeTo   < p-fact-rangeTo
     2474         then undo, return error substitute('Нельзя увеличивать границы диапазона.&1Диапазон партии &2-&3.&1Диапазон резервирования &4-&5'
     2475                                            ,chr(10)
     2476                                            ,bfrom_wth-parts.doc-rangeFrom
     2477                                            ,bfrom_wth-parts.doc-rangeTo
     2478                                            ,p-fact-rangeFrom
     2479                                            ,p-fact-rangeTo).
     2480       end.
     2481       else do:
     2482         if p-ext-doc-type = 'pz':U or (p-ext-doc-type = 'xc':U and p-type = 'при':U )then do:
     2483           for first bfrom_wth-parts no-lock where
     2484                                     bfrom_wth-parts.wth-code = p-wth-code
     2485                                 and bfrom_wth-parts.par-code = p-par-code
     2486                                 and bfrom_wth-parts.ser-code = p-ser-code
     2487                                 and bfrom_wth-parts.db-num = p-db-num
     2488                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2489                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2490                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2491                                 and bfrom_wth-parts.stts = 0
     2492                                 and bfrom_wth-parts.cli-code = p-cli-code
     2493                                 and bfrom_wth-parts.cli-type = p-cli-type
     2494                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2495                                 use-index  wth-idnt:
     2496                                 p-rec = recid(bfrom_wth-parts).
     2497            end.
     2498           If p-rec = ? and p-in-code > '' then do:
     2499              for first bfrom_wth-parts no-lock where
     2500                                     bfrom_wth-parts.wth-code = p-wth-code
     2501                                 and bfrom_wth-parts.par-code = p-par-code
     2502                                 and bfrom_wth-parts.ser-code = p-ser-code
     2503                                 and bfrom_wth-parts.db-num = p-db-num
     2504                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2505                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2506                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2507                                 and bfrom_wth-parts.stts = 0
     2508                                 and bfrom_wth-parts.cli-code = p-cli-code
     2509                                 and bfrom_wth-parts.cli-type = p-cli-type
     2510                                 use-index  wth-idnt:
     2511                                 p-rec = recid(bfrom_wth-parts).
     2512                 end.
     2513           end.
     2514                 if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2515                   recid(bfrom_wth-parts) = p-rec no-error.
     2516         end.
     2517         else if p-ext-doc-type = 'pc':U or p-ext-doc-type = 'ps':U or p-ext-doc-type = 'dc':U then do:
     2518           for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2519                                 and bfrom_wth-parts.par-code = p-par-code
     2520                                 and bfrom_wth-parts.ser-code = p-ser-code
     2521                                 and bfrom_wth-parts.db-num = p-db-num
     2522                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2523                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2524                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2525                                 and bfrom_wth-parts.stts = 0
     2526                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2527                                 use-index wth-idnt:
     2528                                 p-rec = recid(bfrom_wth-parts).
     2529            end.
     2530           If p-rec = ? and p-in-code > '' then do:
     2531            for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2532                                 and bfrom_wth-parts.par-code = p-par-code
     2533                                 and bfrom_wth-parts.ser-code = p-ser-code
     2534                                 and bfrom_wth-parts.db-num = p-db-num
     2535                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2536                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2537                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2538                                 and bfrom_wth-parts.stts = 0
     2539                                 :
     2540                                 p-rec = recid(bfrom_wth-parts).
     2541            end.
     2542           end.
     2543           if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2544                   recid(bfrom_wth-parts) = p-rec no-error.
     2545         end.
     2546         else do:
     2547           CASE p-ext-doc-type:
     2548                   WHEN 'ee':U or when 'xc':U or WHEN 'ef':U
     2549                   or when 'jj':U THEN DO:
     2550                       v-zone = 'free-zone':U.
     2551                   END.
     2552                   WHEN 'ep':U or when 'oj':U THEN DO:
     2553                       v-zone = 'put-zone':U.
     2554                   END.
     2555                   WHEN 'df':U THEN DO:
     2556                       v-zone = 'free-zone':U.
     2557                   END.
     2558                   WHEN 'dp':U  THEN DO:
     2559                       v-zone = 'put-zone':U.
     2560                   END.
     2561                   WHEN 'pc':U OR WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'dc':U THEN DO:
     2562                       v-zone = 'cli-zone':U.
     2563                   END.
     2564                   OTHERWISE DO:
     2565                       RETURN ERROR substitute("Неверный вызов процедуры резервирования: расш. тип = &1"
     2566                                            , p-ext-doc-type
     2567                                               ).
     2568                   END.
     2569           END CASE.
     2570           find first bfrom_wth-parts no-lock where
     2571                                     bfrom_wth-parts.wth-code = p-wth-code
     2572                                 and bfrom_wth-parts.obj-code = p-obj-code
     2573                                 and bfrom_wth-parts.obj-type = p-obj-type
     2574                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2575                                 and bfrom_wth-parts.par-code = p-par-code
     2576                                 and bfrom_wth-parts.ser-code = p-ser-code
     2577                                 and bfrom_wth-parts.db-num = p-db-num
     2578                                 and bfrom_wth-parts.out-code = v-zone
     2579                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2580                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2581                                 and bfrom_wth-parts.stts = 0
     2582                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2583                                 no-error.
     2584          If not available bfrom_wth-parts and p-in-code > '' then do:
     2585                  find first bfrom_wth-parts no-lock where
     2586                                     bfrom_wth-parts.wth-code = p-wth-code
     2587                                 and bfrom_wth-parts.obj-code = p-obj-code
     2588                                 and bfrom_wth-parts.obj-type = p-obj-type
     2589                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2590                                 and bfrom_wth-parts.par-code = p-par-code
     2591                                 and bfrom_wth-parts.ser-code = p-ser-code
     2592                                 and bfrom_wth-parts.db-num = p-db-num
     2593                                 and bfrom_wth-parts.out-code = v-zone
     2594                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2595                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2596                                 and bfrom_wth-parts.stts = 0
     2597                                 no-error.
     2598          end.
     2599         end.
     2600       end.
     2601       if not available bfrom_wth-parts then do:
     2602            if g#news then do:
     2603             return error 'forged':U.
     2604            end.
     2605            else
     2606             undo, return error substitute("Не найдена партия МЦ для резервирования &1Код МЦ &2&1Код номинала &3&1Код серии &4&1Диапазон с &5 по &6&1
     2607                                           ",chr(10),p-wth-code,p-par-code,p-ser-code,p-fact-rangeFrom,
     2608                                           p-fact-rangeTo).
     2609       end.
     2610       p-rec = recid(bfrom_wth-parts).
     2611       find current bfrom_wth-parts exclusive-lock.
     2612       create tt-wthlib-parts.
     2613       buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2614           ASSIGN v-beg-dt = if p-param then p-beg-dt else bfrom_wth-parts.beg-dt
     2615                  v-end-dt = if p-param then p-end-dt else bfrom_wth-parts.end-dt
     2616                  v-vat-pc = if p-param then p-vat-pc else bfrom_wth-parts.vat-pc
     2617                  v-price-rubl = if p-param then p-price-rubl else bfrom_wth-parts.price-rubl
     2618                  v-price-base = if p-param then p-price-base else bfrom_wth-parts.price-base  .
     2619       IF  not g#news and (p-ext-doc-type = 'ee':U or p-ext-doc-type = 'xc':U)  THEN DO:
     2620           IF v-beg-dt = ? AND v-end-dt = ? THEN DO:
     2621               RUN init_prtdate ( INPUT p-obj-type
     2622                                                 ,INPUT p-obj-code
     2623                                                 ,INPUT p-ser-code
     2624                                                 ,INPUT p-db-num
     2625                                                 ,INPUT bufr_wth-doc.doc-date
     2626                                                 ,OUTPUT v-beg-dt
     2627                                                 ,OUTPUT v-end-dt ) NO-ERROR.
     2628               if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2629           END.
     2630           IF v-price-rubl = 0 AND v-price-base = 0 THEN DO:
     2631             run set-wthmpl-date ( bufr_wth-doc.doc-code
     2632                                ,bufr_wth-doc.doc-date
     2633                                , v-beg-dt
     2634                                , output v-mpl-date) no-error.
     2635               RUN INIT_prtprice (
     2636                             p-host-code
     2637                           , p-obj-type
     2638                           , p-obj-code
     2639                           , p-cli-type
     2640                           , p-cli-code
     2641                           , p-wth-code
     2642                           , p-gds-code
     2643                           , p-par-code
     2644                           , v-mpl-date
     2645                           , OUTPUT  v-vat-pc
     2646                           , OUTPUT  v-price-rubl
     2647                           , OUTPUT  v-price-base
     2648                   ) NO-ERROR.
     2649             if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2650           END.
     2651       END.
     2652         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2653                     INPUT     p-obj-type,
     2654                     INPUT     p-obj-code,
     2655                     INPUT     p-w-p-code,
     2656                     INPUT     bfrom_wth-parts.wth-code,
     2657                     INPUT     bfrom_wth-parts.par-code,
