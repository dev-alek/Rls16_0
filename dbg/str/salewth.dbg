     2671                     INPUT     bfrom_wth-parts.supp-code,
     2672                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2673                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2674                     INPUT     p-ext-doc-type,
     2675                     INPUT     bfrom_wth-parts.gds-code,
     2676                     INPUT     0              ,
     2677                     INPUT     v-beg-dt    ,
     2678                     INPUT     v-end-dt   ,
     2679                     INPUT     v-vat-pc    ,
     2680                     INPUT     bfrom_wth-parts.cli-code,
     2681                     INPUT     bfrom_wth-parts.cli-type,
     2682                     INPUT     bfrom_wth-parts.out-obj-code,
     2683                     INPUT     bfrom_wth-parts.out-obj-type,
     2684                     INPUT     bfrom_wth-parts.sale-obj-code,
     2685                     INPUT     bfrom_wth-parts.sale-obj-type,
     2686                     INPUT     bfrom_wth-parts.doc-code,
     2687                     INPUT     yes,
     2688                     INPUT     p-type,
     2689                     INPUT-OUTPUT p-rec
     2690                     ) no-error.
     2691       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2692       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
