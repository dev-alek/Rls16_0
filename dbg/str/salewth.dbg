      125   FIELD sum-gds-base like ub.wth-line.sum-gds-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (баз.вал.)"
      126   FIELD price-rubl   like ub.wth-line.price-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(рубл)"
      127   FIELD price-base   like ub.wth-line.price-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(баз.вал.)"
      128   FIELD w-p-code     like ub.wth-dtl.w-p-code
      129   FIELD doc-code     like ub.wth-dtl.doc-code
      130   FIELD gds-code     like ub.wth-gds.gds-code
      131   INDEX tt-pi    IS   PRIMARY UNIQUE par-code  w-p-code doc-code  wth-code
      132   INDEX tt-i1                        par-feat par-unit par-val
      133   INDEX tt-i2                        doc-sum  q-ty-doc
