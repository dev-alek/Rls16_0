     2716                     INPUT     tt-wthlib-parts.gds-code,
     2717                     INPUT     tt-wthlib-parts.stts               ,
     2718                     INPUT     tt-wthlib-parts.beg-dt        ,
     2719                     INPUT     tt-wthlib-parts.end-dt        ,
     2720                     INPUT     tt-wthlib-parts.vat-pc        ,
     2721                     INPUT     tt-wthlib-parts.cli-code,
     2722                     INPUT     tt-wthlib-parts.cli-type,
     2723                     INPUT     tt-wthlib-parts.out-obj-code,
     2724                     INPUT     tt-wthlib-parts.out-obj-type,
     2725                     INPUT     tt-wthlib-parts.sale-obj-code,
     2726                     INPUT     tt-wthlib-parts.sale-obj-type,
     2727                     INPUT     tt-wthlib-parts.doc-code,
     2728                     INPUT  yes,
     2729                     INPUT    tt-wthlib-parts.type,
     2730                     INPUT-OUTPUT v-recDop
     2731                     ) no-error.
     2732       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2733       end.
     2734       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2735               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2736                     INPUT     tt-wthlib-parts.obj-type,
     2737                     INPUT     tt-wthlib-parts.obj-code,
     2738                     INPUT     tt-wthlib-parts.w-p-code,
     2739                     INPUT     tt-wthlib-parts.wth-code,
     2740                     INPUT     tt-wthlib-parts.par-code,
     2741                     INPUT     tt-wthlib-parts.in-code ,
     2742                     INPUT     tt-wthlib-parts.out-code,
     2743                     INPUT     tt-wthlib-parts.ser-code,
     2744                     INPUT     tt-wthlib-parts.db-num  ,
     2745                     INPUT     p-fact-rangeTo + 1 ,
     2746                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2747                     INPUT     p-fact-rangeTo + 1 ,
     2748                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2749                     INPUT     tt-wthlib-parts.host-code     ,
     2750                     INPUT     tt-wthlib-parts.contract-code               ,
     2751                     INPUT     tt-wthlib-parts.price-rubl    ,
     2752                     INPUT     tt-wthlib-parts.price-base    ,
     2753                     INPUT     tt-wthlib-parts.supp-type,
     2754                     INPUT     tt-wthlib-parts.supp-code,
     2755                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2756                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2757                     INPUT     tt-wthlib-parts.ext-doc-type,
     2758                     INPUT     tt-wthlib-parts.gds-code,
     2759                     INPUT     tt-wthlib-parts.stts               ,
     2760                     INPUT     tt-wthlib-parts.beg-dt        ,
     2761                     INPUT     tt-wthlib-parts.end-dt        ,
     2762                     INPUT     tt-wthlib-parts.vat-pc        ,
     2763                     INPUT     tt-wthlib-parts.cli-code,
     2764                     INPUT     tt-wthlib-parts.cli-type,
     2765                     INPUT     tt-wthlib-parts.out-obj-code,
     2766                     INPUT     tt-wthlib-parts.out-obj-type,
     2767                     INPUT     tt-wthlib-parts.sale-obj-code,
     2768                     INPUT     tt-wthlib-parts.sale-obj-type,
     2769                     INPUT     tt-wthlib-parts.doc-code,
     2770                     INPUT     yes,
     2771                     INPUT     tt-wthlib-parts.type,
     2772                     INPUT-OUTPUT v-recDop
     2773                     ) no-error.
     2774         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2775       end.
     2776     end.
     2777   end.
     2778   end procedure.
     2779   procedure wth-parts-inter-edit:
     2780     define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2781     define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2782     define input-output parameter p-rec        as recid     no-undo .
     2783     define buffer bfrom_wth-parts   for ub.wth-parts.
     2784     define variable v-recDop as recid        no-undo.
     2785     do on error undo, return error:
     2786         find first bfrom_wth-parts exclusive-lock where
     2787                   recid(bfrom_wth-parts) = p-rec no-error.
     2788         if not available bfrom_wth-parts then return error
     2789           substitute('Не найдена партия (recid &1)', p-rec).
     2790         if p-fact-rangeFrom < bfrom_wth-parts.doc-rangeFrom or
     2791            p-fact-rangeTo > bfrom_wth-parts.doc-rangeTo then do:
     2792            return error 'Нельзя увеличивать границы диапазона.'.
     2793         end.
     2794         empty temp-table tt-wthlib-parts.
     2795         create tt-wthlib-parts.
     2796         buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2797         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2798                     INPUT     bfrom_wth-parts.obj-type,
     2799                     INPUT     bfrom_wth-parts.obj-code,
     2800                     INPUT     bfrom_wth-parts.w-p-code,
     2801                     INPUT     bfrom_wth-parts.wth-code,
     2802                     INPUT     bfrom_wth-parts.par-code,
     2803                     INPUT     bfrom_wth-parts.in-code ,
     2804                     INPUT     bfrom_wth-parts.doc-code,
     2805                     INPUT     bfrom_wth-parts.ser-code,
     2806                     INPUT     bfrom_wth-parts.db-num  ,
     2807                     INPUT     p-Fact-RangeFrom ,
     2808                     INPUT     p-fact-rangeTo  ,
     2809                     INPUT     p-Fact-RangeFrom ,
     2810                     INPUT     p-fact-rangeTo ,
     2811                     INPUT     bfrom_wth-parts.host-code     ,
     2812                     INPUT     bfrom_wth-parts.contract-code               ,
     2813                     INPUT     bfrom_wth-parts.price-rubl  ,
     2814                     INPUT     bfrom_wth-parts.price-base    ,
     2815                     INPUT     bfrom_wth-parts.supp-type,
     2816                     INPUT     bfrom_wth-parts.supp-code,
     2817                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2818                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2819                     INPUT     bfrom_wth-parts.ext-doc-type,
     2820                     INPUT     bfrom_wth-parts.gds-code,
     2821                     INPUT     0              ,
     2822                     INPUT     bfrom_wth-parts.beg-dt      ,
     2823                     INPUT     bfrom_wth-parts.end-dt      ,
     2824                     INPUT     bfrom_wth-parts.vat-pc      ,
     2825                     INPUT     bfrom_wth-parts.cli-code,
     2826                     INPUT     bfrom_wth-parts.cli-type,
     2827                     INPUT     bfrom_wth-parts.out-obj-code,
     2828                     INPUT     bfrom_wth-parts.out-obj-type,
     2829                     INPUT     bfrom_wth-parts.sale-obj-code,
     2830                     INPUT     bfrom_wth-parts.sale-obj-type,
     2831                     INPUT     bfrom_wth-parts.doc-code,
     2832                     INPUT     yes,
     2833                     INPUT     bfrom_wth-parts.type,
     2834                     INPUT-OUTPUT p-rec
     2835                     ) no-error.
     2836       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2837       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2838       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2839                     INPUT     tt-wthlib-parts.obj-type,
     2840                     INPUT     tt-wthlib-parts.obj-code,
     2841                     INPUT     tt-wthlib-parts.w-p-code,
     2842                     INPUT     tt-wthlib-parts.wth-code,
     2843                     INPUT     tt-wthlib-parts.par-code,
     2844                     INPUT     tt-wthlib-parts.in-code ,
     2845                     INPUT     tt-wthlib-parts.out-code,
     2846                     INPUT     tt-wthlib-parts.ser-code,
     2847                     INPUT     tt-wthlib-parts.db-num  ,
     2848                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2849                     INPUT     p-fact-rangeFrom - 1  ,
     2850                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2851                     INPUT     p-fact-rangeFrom - 1,
     2852                     INPUT     tt-wthlib-parts.host-code     ,
     2853                     INPUT     tt-wthlib-parts.contract-code               ,
     2854                     INPUT     tt-wthlib-parts.price-rubl    ,
     2855                     INPUT     tt-wthlib-parts.price-base    ,
     2856                     INPUT     tt-wthlib-parts.supp-type,
     2857                     INPUT     tt-wthlib-parts.supp-code,
     2858                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2859                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2860                     INPUT     tt-wthlib-parts.ext-doc-type,
     2861                     INPUT     tt-wthlib-parts.gds-code,
     2862                     INPUT     1             ,
     2863                     INPUT     tt-wthlib-parts.beg-dt        ,
     2864                     INPUT     tt-wthlib-parts.end-dt        ,
     2865                     INPUT     tt-wthlib-parts.vat-pc        ,
     2866                     INPUT     tt-wthlib-parts.cli-code,
