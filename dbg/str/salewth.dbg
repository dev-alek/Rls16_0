     2694                     INPUT     tt-wthlib-parts.obj-type,
     2695                     INPUT     tt-wthlib-parts.obj-code,
     2696                     INPUT     tt-wthlib-parts.w-p-code,
     2697                     INPUT     tt-wthlib-parts.wth-code,
