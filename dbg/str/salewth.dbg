     2868                     INPUT     tt-wthlib-parts.out-obj-code,
     2869                     INPUT     tt-wthlib-parts.out-obj-type,
     2870                     INPUT     tt-wthlib-parts.sale-obj-code,
     2871                     INPUT     tt-wthlib-parts.sale-obj-type,
     2872                     INPUT     tt-wthlib-parts.doc-code,
     2873                     INPUT  yes,
     2874                     INPUT    tt-wthlib-parts.type,
     2875                     INPUT-OUTPUT v-recDop
     2876                     ) no-error.
     2877       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2878       end.
     2879       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2880               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2881                     INPUT     tt-wthlib-parts.obj-type,
     2882                     INPUT     tt-wthlib-parts.obj-code,
     2883                     INPUT     tt-wthlib-parts.w-p-code,
     2884                     INPUT     tt-wthlib-parts.wth-code,
     2885                     INPUT     tt-wthlib-parts.par-code,
     2886                     INPUT     tt-wthlib-parts.in-code ,
     2887                     INPUT     tt-wthlib-parts.out-code,
     2888                     INPUT     tt-wthlib-parts.ser-code,
     2889                     INPUT     tt-wthlib-parts.db-num  ,
     2890                     INPUT     p-fact-rangeTo + 1 ,
     2891                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2892                     INPUT     p-fact-rangeTo + 1 ,
     2893                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2894                     INPUT     tt-wthlib-parts.host-code     ,
     2895                     INPUT     tt-wthlib-parts.contract-code               ,
     2896                     INPUT     tt-wthlib-parts.price-rubl    ,
     2897                     INPUT     tt-wthlib-parts.price-base    ,
     2898                     INPUT     tt-wthlib-parts.supp-type,
     2899                     INPUT     tt-wthlib-parts.supp-code,
     2900                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2901                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2902                     INPUT     tt-wthlib-parts.ext-doc-type,
     2903                     INPUT     tt-wthlib-parts.gds-code,
     2904                     INPUT     1             ,
     2905                     INPUT     tt-wthlib-parts.beg-dt        ,
     2906                     INPUT     tt-wthlib-parts.end-dt        ,
     2907                     INPUT     tt-wthlib-parts.vat-pc        ,
     2908                     INPUT     tt-wthlib-parts.cli-code,
     2909                     INPUT     tt-wthlib-parts.cli-type,
     2910                     INPUT     tt-wthlib-parts.out-obj-code,
     2911                     INPUT     tt-wthlib-parts.out-obj-type,
     2912                     INPUT     tt-wthlib-parts.sale-obj-code,
     2913                     INPUT     tt-wthlib-parts.sale-obj-type,
     2914                     INPUT     tt-wthlib-parts.doc-code,
     2915                     INPUT     yes,
     2916                     INPUT     tt-wthlib-parts.type,
     2917                     INPUT-OUTPUT v-recDop
     2918                     ) no-error.
     2919         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2920         end.
     2921     end.
     2922   end procedure.
     2923   PROCEDURE INIT_prtdate:
     2924       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2925       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2926       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2927       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2928       define input parameter        p-date                AS DATE no-undo .
     2929       DEFINE OUTPUT PARAMETER p-beg-dt AS DATE NO-UNDO.
     2930       DEFINE OUTPUT PARAMETER p-end-dt AS DATE NO-UNDO.
     2931       DEFINE BUFFER buf_wth-ser FOR ub.wth-ser.
     2932       DEFINE VARIABLE v-rangeRule AS INT NO-UNDO.
     2933       define variable v-value-character as character no-undo .
     2934       define variable v-value-date as date no-undo .
     2935       define variable v-value-decimal as decimal no-undo .
     2936       define variable v-value-integer as INTEGER no-undo .
     2937       define variable v-value-logical AS LOGICAL no-undo .
     2938       define variable v-param-type as character no-undo .
     2939       FIND FIRST buf_wth-ser NO-LOCK
     2940           WHERE buf_wth-ser.ser-code = p-ser-code
     2941           AND buf_wth-ser.db-num = p-db-num.
     2942       IF buf_wth-ser.chk-bdt = 2 THEN DO:
     2943           p-beg-dt = buf_wth-ser.beg-dt.
     2944       END.
     2945       IF buf_wth-ser.chk-edt = 2 THEN DO:
     2946           p-end-dt = buf_wth-ser.end-dt.
     2947       END.
     2948       IF buf_wth-ser.chk-bdt = 0 AND buf_wth-ser.chk-edt = 0 THEN DO:
     2949           run adm/shattri.p (
     2950               input "get":U
     2951               ,input  p-obj-type
     2952               ,input  p-obj-code
     2953               ,input  'wthdoc_obj':U
     2954               ,input  'rangerule':U
     2955               ,output v-value-character
     2956               ,output v-value-date
     2957               ,output v-value-decimal
     2958               ,output v-value-integer
     2959               ,output v-value-logical
     2960               ,output v-param-type
     2961               ,INPUT-OUTPUT table-handle v-tth
     2962               ) no-error .
     2963           IF not error-status:error  then do:
     2964               v-rangeRule =  v-value-integer.
     2965           END.
     2966           CASE v-rangeRule:
     2967           WHEN 1 THEN DO:
     2968               IF MONTH(p-date) < 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date)))
     2969                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 2,YEAR(p-date))) - 1.
     2970               ELSE IF MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/12/&1',YEAR(p-date)))
     2971                                                 p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date) + 1)).
     2972               ELSE IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('01/01/&1',YEAR(p-date) + 1))
     2973                                                 p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2974           END.
     2975           when 2 then do:
     2976             IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2977                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2978             else ASSIGN p-beg-dt = DATE(substitute('&3/&1/&2',MONTH(p-date),YEAR(p-date),day(p-date)))
     2979                         p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date))) - 1
     2980                        .
     2981           end.
     2982           WHEN 3 THEN DO:
     2983               IF MONTH(p-date) < 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/&2/&3',day(p-date),MONTH(p-date),YEAR(p-date)))
     2984                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 3,YEAR(p-date))) - 1.
     2985               else if MONTH(p-date) = 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/10/&2',day(p-date),YEAR(p-date)))
     2986                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2987               else if MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('&1/11/&2',day(p-date),YEAR(p-date)))
     2988                                               p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2989               else if MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2990                                               p-end-dt = DATE(substitute('01/03/&1',YEAR(p-date) + 1)) - 1.
     2991           END.
     2992           when 4 then do:
     2993                p-beg-dt = p-date.
     2994                p-end-dt = date(substitute('31/12/&1',YEAR(p-date))).
     2995           end.
     2996           END CASE.
     2997       END.
     2998   END.
     2999   PROCEDURE INIT_prtprice:
     3000   define input parameter        p-host-code        LIKE ub.wth-parts.obj-type no-undo .
     3001   define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     3002   define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     3003   define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     3004   define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     3005   define input parameter        p-wth-code         LIKE ub.wth-parts.ser-code no-undo.
     3006   define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     3007   define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     3008   define input parameter        p-date                AS DATE no-undo .
     3009   DEFINE OUTPUT PARAMETER p-vat-pc LIKE ub.wth-parts.vat-pc NO-UNDO.
     3010   DEFINE OUTPUT PARAMETER p-price-rubl LIKE ub.wth-parts.price-rubl NO-UNDO.
     3011   DEFINE OUTPUT PARAMETER p-price-base LIKE ub.wth-parts.price-base NO-UNDO.
     3012   DEFINE BUFFER b-cash-pay FOR ub.cash-pay.
     3013   DEFINE BUFFER b-wth-par FOR ub.wth-par.
     3014   DEF VAR v-cash-type-pay AS CHAR no-undo.
     3015   define variable p-plt-id AS INT no-undo.
     3016   define variable  p-plt-db-num   AS INT no-undo.
     3017   define variable  p-pdf-id  AS INT no-undo.
     3018   define variable  p-pdf-db-num AS INT no-undo.
     3019   define variable  p-sale-price-base AS DEC no-undo.
     3020   define variable  p-sale-price-rubl AS DEC no-undo.
     3021   define variable  p-road-tax-base AS DEC no-undo.
     3022   define variable  p-road-tax-rubl AS DEC no-undo.
     3023   define variable  p-excise-base AS DEC no-undo.
     3024   define variable  p-excise-rubl AS DEC no-undo.
     3025   define variable  p-fact-order  AS DEC no-undo.
     3026   do on error undo, return error return-value :
     3027     FIND FIRST b-wth-par NO-LOCK WHERE b-wth-par.par-code = p-par-code
     3028                                     AND b-wth-par.wth-code = p-wth-code NO-ERROR.
     3029     IF NOT AVAILABLE b-wth-par THEN RETURN ERROR SUBSTITUTE("Не наден номинал с кодом &1",p-par-code).
     3030     FIND FIRST b-cash-pay WHERE b-cash-pay.wth-code = p-wth-code NO-LOCK NO-ERROR.
     3031     IF AVAILABLE b-cash-pay THEN v-cash-type-pay = STRING(recid(b-cash-pay)).
     3032     ELSE v-cash-type-pay = ?.
     3033     run fact-order-mpl (
     3034         INPUT p-date ,
     3035         INPUT p-obj-type ,
     3036         INPUT p-obj-code ,
     3037         OUTPUT p-fact-order
     3038         ) no-error .
     3039     if error-status:error then do:
     3040       message   return-value skip error-status:get-message(1)
     3041       skip  'Получение цены из множественного прайс-листа отклонено.'
     3042       view-as alert-box.
     3043       return.
     3044     end.
     3045   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3046   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3047     (input  p-gds-code
     3048     ,input  '1':U
     3049     ,input  ?
     3050     ,input  p-host-code
     3051     ,input  p-obj-type
     3052     ,input  p-obj-code
     3053     ,output p-vat-pc
     3054     ) no-error .
     3055     run mpl-autoprice in this-procedure
     3056       ( input    false
     3057         ,input   p-cli-type
     3058         ,input   p-cli-code
     3059         ,input   p-gds-code
     3060         ,input   p-gds-code
     3061         ,input   p-obj-type
     3062         ,input   p-obj-code
     3063         ,input   0
     3064         ,input   0
     3065         ,input   ""
     3066         ,input   v-cash-type-pay
     3067         ,input   p-fact-order
     3068         ,output  p-plt-id
     3069         ,output  p-plt-db-num
     3070         ,output  p-pdf-id
     3071         ,output  p-pdf-db-num
     3072         ,output  p-sale-price-base
     3073         ,output  p-sale-price-rubl
     3074         ,output  p-road-tax-base
     3075         ,output  p-road-tax-rubl
     3076         ,output  p-excise-base
     3077         ,output  p-excise-rubl
     3078         ) no-error .
     3079     if error-status:error then do:
     3080       message   return-value skip error-status:get-message(1) view-as alert-box.
     3081       return.
     3082     end.
     3083     p-price-rubl = p-sale-price-rubl * b-wth-par.par-val.
     3084     p-price-base = p-sale-price-base * b-wth-par.par-val.
     3085   end.
     3086   END.
     3087   procedure  set-wthmpl-date:
     3088   define input parameter p-doc-code like ub.wth-doc.doc-code no-undo.
     3089   define input parameter p-doc-date like ub.wth-doc.doc-date no-undo.
     3090   define input parameter p-beg-dt   like ub.wth-parts.beg-dt no-undo.
     3091   define output parameter p-date    like ub.wth-doc.doc-date no-undo.
     3092   define variable v-atrValue      as character no-undo .
     3093   define variable v-atrDsf      as CHARACTER no-undo .
     3094   define variable v-atrType     as character no-undo .
     3095   do on error undo, return error return-value :
     3096   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     3097                           input 'wthdsf':U ,
     3098                          output v-atrValue ,
     3099                          output v-atrType )  .
     3100     p-date = date(v-atrValue) no-error.
     3101     if p-date = ? then p-date = p-beg-dt no-error.
     3102     if p-date = ? then p-date = p-doc-date.
     3103   end.
     3104   end procedure.
     3105   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3106     (input  'is-wth'
     3107     ,input  0
     3108     ,input  ''
     3109     ,input  0
     3110     ,input  ''
     3111     ,input  ''
     3112     ,input  ''
     3113     ,input  yes
     3114     ,output conf-par
     3115     ,output par-type
     3116     ) no-error .
     3117   IF not error-status:error then
     3118   assign
     3119   is-wth = (conf-par = "yes":U).
     3120   if not is-wth then return.
     3121   if loc-inkas.obj-type = 'скл':U then do:
     3122     var-mes = substitute("&1 &2 &3&4Попытка закрыть продажу на объекте типа склад &5"
     3123                          ,vss-workfile
     3124                          ,vss-revision
     3125                          ,vss-description
     3126                          ,chr(10)
     3127                          ,loc-inkas.obj-code
     3128                          )
     3129               .
     3130     return error var-mes.
     3131   end.
     3132   for each tt-wth-doc:
     3133     delete tt-wth-doc.
     3134   end.
     3135   for each tt-wth-line:
     3136     delete tt-wth-line.
     3137   end.
     3138   _inkas-pay-desk:
     3139   for each ub.inkas-pay-desk no-lock where
     3140            ub.inkas-pay-desk.inkas-code = loc-inkas.inkas-code
     3141   BREAK
     3142   BY ub.inkas-pay-desk.pay-desk
     3143   BY ub.inkas-pay-desk.doc-type
     3144   BY ub.inkas-pay-desk.cashier
     3145   BY ub.inkas-pay-desk.pay-code
     3146   BY ub.inkas-pay-desk.curr-code
     3147           :
     3148     assign var-doc-sum = 0.
     3149     if first-of(ub.inkas-pay-desk.pay-desk) then do:
     3150       FIND FIRST ub.wth-place No-LOCK WHERE
     3151                 ub.wth-place.obj-type = loc-inkas.obj-type AND
     3152                 ub.wth-place.obj-code = loc-inkas.obj-code AND
     3153                 ub.wth-place.cash-desk = ub.inkas-pay-desk.pay-desk NO-ERROR.
     3154       if not available ub.wth-place then do:
     3155         var-mes = substitute("Не определено МХ МЦ для кассы N &1 &2&3"
     3156                              ,ub.inkas-pay-desk.pay-desk
     3157                              ,loc-inkas.obj-type
     3158                              ,loc-inkas.obj-code).
     3159         return error var-mes.
     3160       end.
     3161       assign
     3162       var-w-p-code = ub.wth-place.w-p-code.
     3163     end.
     3164     FIND FIRST ub.cash-pay No-LOCK where
     3165               ub.cash-pay.cdpay-code = ub.inkas-pay-desk.pay-code AND
     3166               ub.cash-pay.curr-code = ub.inkas-pay-desk.curr-code No-ERROR.
     3167     if not available ub.cash-pay then do:
     3168       var-mes = substitute("Неверный тип кассового платежа: &1" +
     3169                            "код кассового платежа &2 код валюты &3"
     3170                           ,chr(10)
     3171                           ,ub.inkas-pay-desk.pay-code
     3172                           ,ub.inkas-pay-desk.curr-code).
     3173       return error var-mes.
     3174     end.
     3175     if ub.cash-pay.wth-code <> 0 then do:
     3176       FIND FIRST ub.wealth No-LOCK where
     3177                 ub.wealth.wth-code = ub.cash-pay.wth-code No-ERROR.
     3178       if not available ub.wealth then do:
     3179         var-mes = substitute("Неверный код МЦ &1", ub.cash-pay.wth-code).
     3180         return error var-mes.
     3181       end.
     3182       assign
     3183       var-wth-code = ub.cash-pay.wth-code
     3184       .
     3185     end.
     3186     if first-of(ub.inkas-pay-desk.cashier) then do:
     3187       v-cashier-psn-code = 0.
     3188       assign
     3189       v-cashier-psn-code = gbclcode-is-this-db-role (
     3190                                                      input 'C':U
     3191                                                     ,input g#db-num
     3192                                                     ,input ub.inkas-pay-desk.cashier
     3193                                                     ,input loc-inkas.doc-date
     3194                                                     )
     3195       no-error .
     3196       if v-cashier-psn-code = 0 then do:
     3197           var-mes = substitute("Неверный код кассира &1", ub.inkas-pay-desk.cashier).
     3198           return error var-mes.
     3199       end.
     3200     end.
     3201     if ub.cash-pay.wth-code = 0 then next _inkas-pay-desk.
     3202     if first-of(ub.inkas-pay-desk.pay-code) then do:
     3203       find first tt-wth-doc where     tt-wth-doc.host-code = loc-inkas.host-code
     3204              and tt-wth-doc.obj-type = loc-inkas.obj-type
     3205              and tt-wth-doc.obj-code = loc-inkas.obj-code
     3206              and tt-wth-doc.cli-type = parcli-type
     3207              and tt-wth-doc.cli-code = parcli-code
     3208              and tt-wth-doc.doc-date = loc-inkas.doc-date
     3209              and tt-wth-doc.fact-date = loc-inkas.fact-date
     3210              and  tt-wth-doc.shift-num = loc-inkas.shift-num
     3211              and  tt-wth-doc.shift-date = (if loc-inkas.shift-num = 0
     3212                                         then ?
     3213                                         else loc-inkas.shift-date)
     3214              and tt-wth-doc.operator = v-cashier-psn-code
     3215              and tt-wth-doc.deliver  = v-cashier-psn-code
     3216              and tt-wth-doc.receiver = v-cashier-psn-code
     3217              and tt-wth-doc.exter_ = yes
     3218              and tt-wth-doc.inter_ = no
     3219              and tt-wth-doc.doc-type = ub.inkas-pay-desk.doc-type
     3220              and tt-wth-doc.source-ref = loc-inkas.inkas-code
     3221              and tt-wth-doc.source-type = 'касса':U
     3222              and tt-wth-doc.ext-doc-type = (if  available ub.wealth and ub.wealth.is-ser = 1 and  tt-wth-doc.doc-type = 'при':U
     3223                                           then 'pc':U
     3224                                           else (if  tt-wth-doc.doc-type = 'при':U  then  'ci':U else 'ce':U) )
     3225       no-error.
     3226       if available tt-wth-doc and can-find( first tt-wth-line where tt-wth-line.doc-code = tt-wth-doc.doc-code
     3227                             and  tt-wth-line.w-p-code = var-w-p-code)  then do:
     3228         var-doc-code = tt-wth-doc.doc-code.
     3229       end.
     3230       else  do:
     3231         assign
     3232         ii = ii + 1
     3233         var-doc-code = string(ii)
     3234         .
     3235       create tt-wth-doc.
     3236       assign
     3237       tt-wth-doc.doc-code = var-doc-code
     3238       tt-wth-doc.host-code = loc-inkas.host-code
     3239       tt-wth-doc.obj-type = loc-inkas.obj-type
     3240       tt-wth-doc.obj-code = loc-inkas.obj-code
     3241       tt-wth-doc.cli-type = parcli-type
     3242       tt-wth-doc.cli-code = parcli-code
     3243       tt-wth-doc.doc-date = loc-inkas.doc-date
     3244       tt-wth-doc.fact-date = (if  available ub.wealth and ub.wealth.is-ser = 1 and loc-inkas.shift-num <> 0 then loc-inkas.shift-date else loc-inkas.fact-date )
     3245       tt-wth-doc.shift-num = loc-inkas.shift-num
     3246       tt-wth-doc.shift-name = loc-inkas.shift-name
     3247       tt-wth-doc.shift-date = (if loc-inkas.shift-num = 0
     3248                                then ?
     3249                                else loc-inkas.shift-date)
     3250       tt-wth-doc.operator = v-cashier-psn-code
     3251       tt-wth-doc.deliver  = v-cashier-psn-code
     3252       tt-wth-doc.receiver = v-cashier-psn-code
     3253       tt-wth-doc.exter_ = yes
     3254       tt-wth-doc.inter_ = no
     3255       tt-wth-doc.doc-type = ub.inkas-pay-desk.doc-type
     3256       tt-wth-doc.source-ref = loc-inkas.inkas-code
     3257       tt-wth-doc.source-type = 'касса':U
     3258       tt-wth-doc.auto-fill = yes
     3259       tt-wth-doc.ps = "@":U + "Накладная" + chr(32) +
     3260                       (
     3261                       if ub.inkas-pay-desk.doc-type = 'при':U
     3262                       then pardoc-code1
     3263                       else pardoc-code2
     3264                       )
     3265       tt-wth-doc.status_ = 'разрешен':U
     3266       tt-wth-doc.doc-sum = 0
     3267       tt-wth-doc.fact-sum = 0
     3268       tt-wth-doc.ext-doc-type = (if  available ub.wealth and ub.wealth.is-ser = 1 and  tt-wth-doc.doc-type = 'при':U
     3269                                  then 'pc':U
     3270                                  else (if  tt-wth-doc.doc-type = 'при':U  then  'ci':U else 'ce':U) )
     3271       .
     3272       end.
     3273     end.
     3274     find first tt-wth-line no-lock where
     3275                tt-wth-line.doc-code = var-doc-code and
     3276                tt-wth-line.wth-code = var-wth-code and
     3277                tt-wth-line.w-p-code = var-w-p-code no-error .
     3278     if not avail tt-wth-line then do:
     3279       create tt-wth-line.
     3280       assign
     3281       tt-wth-line.doc-code = var-doc-code
     3282       tt-wth-line.wth-code = ub.cash-pay.wth-code
     3283       tt-wth-line.w-p-code = var-w-p-code
     3284       tt-wth-line.out-code = 0
     3285       .
     3286     end.
     3287     if not ub.wealth.is-ser = 1 then
     3288     do:
     3289       assign
     3290        tt-wth-line.doc-sum = tt-wth-line.doc-sum + abs(ub.inkas-pay-desk.tot-sum)
     3291        tt-wth-line.fact-sum = tt-wth-line.fact-sum + abs(ub.inkas-pay-desk.tot-sum)
     3292        var-doc-sum = var-doc-sum + abs(ub.inkas-pay-desk.tot-sum)
     3293        .
     3294        FOR EACH buf_chk-doc NO-LOCK where buf_chk-doc.out-code = ub.inkas-pay-desk.inkas-code
     3295                                          AND buf_chk-doc.pay-desk = ub.inkas-pay-desk.pay-desk
     3296                                          AND buf_chk-doc.cashier  = ub.inkas-pay-desk.cashier,
     3297            EACH buf_chk-pay NO-LOCK where buf_chk-pay.doc-code = buf_chk-doc.doc-code
     3298                                  AND  buf_chk-pay.pay-code = ub.inkas-pay-desk.pay-code
     3299                                  AND  buf_chk-pay.curr-code = ub.inkas-pay-desk.curr-code,
     3300            FIRST buf_chk-pay-attr NO-LOCK WHERE buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code
     3301                                    AND buf_chk-pay-attr.line-num = buf_chk-pay.line-num
     3302                                    AND buf_chk-pay-attr.attr-code = "autotank-sum-return":
     3303        assign
     3304         tt-wth-line.doc-sum = tt-wth-line.doc-sum - deci(buf_chk-pay-attr.attr-value)
     3305         tt-wth-line.fact-sum = tt-wth-line.fact-sum - deci(buf_chk-pay-attr.attr-value)
     3306         var-doc-sum = var-doc-sum - deci(buf_chk-pay-attr.attr-value)
     3307         .
     3308       end.
     3309     end.
     3310     if ub.wealth.is-ser = 1 then do:
     3311       if not (ub.inkas-pay-desk.doc-type = 'при':U  or ub.inkas-pay-desk.doc-type = 'рас':U) then next _inkas-pay-desk.
     3312       for each buf_chk-pay no-lock where
     3313                 buf_chk-pay.out-code = loc-inkas.inkas-code
     3314                 and buf_chk-pay.pay-code = ub.cash-pay.cdpay-code
     3315                 and buf_chk-pay.curr-code = ub.cash-pay.curr-code
     3316         , each buf_chk-doc no-lock where
     3317           buf_chk-doc.doc-code = buf_chk-pay.doc-code
     3318           and buf_chk-doc.cashier = ub.inkas-pay-desk.cashier
     3319           and buf_chk-doc.chk-type = (if ub.inkas-pay-desk.doc-type = 'при':U then 1 else int('6':U))
     3320               :
     3321              var-mes =   substitute("Не удалось идентифицировать штрих-код &4 в продаже &1&2" +
     3322                             "Код кассового платежа &3. Чек № &5. "
     3323                             ,loc-inkas.inkas-code
     3324                             ,chr(10)
     3325                             ,ub.inkas-pay-desk.pay-code
     3326                             ,buf_chk-pay.pay-card
     3327                             ,buf_chk-doc.doc-code
     3328                               ).
     3329             run str/wthidnt.p ( input buf_chk-pay.pay-card
     3330                       ,output vidn-ser-code
     3331                       ,output vidn-db-num
     3332                       ,output vidn-stts
     3333                       ,output vidn-wth-code
     3334                       ,output vidn-gds-code
     3335                       ,output vidn-par-code
     3336                       ,output vidn-zone
     3337                       ,output vidn-FromDate
     3338                       ,output vidn-ToDate
     3339                       ,output vidn-range
     3340                       ) no-error.
     3341             if error-status:error then do:
     3342                 var-mes = var-mes +  chr(10) + error-status:get-message(1) + chr(32) + return-value.
     3343                 return error var-mes.
     3344             end.
     3345             if vidn-wth-code <> ub.wealth.wth-code then do:
     3346               var-mes = var-mes + chr(10) + substitute("Код МЦ &1, идентифицируемый по штрих-коду, не соответствует коду МЦ &2 для указанного типа оплаты",vidn-wth-code,ub.wealth.wth-code).
     3347               return error var-mes.
     3348             end.
     3349             if vidn-zone <> 'cli-zone':U then do:
     3350               var-mes = var-mes + chr(10) + substitute("Зона &1 идентифицируемого штрих-кода не соотвествует зоне 'cli-zone':U", vidn-zone).
     3351               return error var-mes.
     3352             end.
     3353                    find first tt-par-dtl no-lock where
     3354                       tt-par-dtl.doc-code = var-doc-code and
     3355                       tt-par-dtl.wth-code = var-wth-code and
     3356                       tt-par-dtl.w-p-code = var-w-p-code and
     3357                       tt-par-dtl.par-code = vidn-par-code no-error .
     3358             if not avail tt-par-dtl then do:
     3359               create tt-par-dtl.
     3360               assign
     3361               tt-par-dtl.doc-code = var-doc-code
     3362               tt-par-dtl.wth-code = ub.cash-pay.wth-code
     3363               tt-par-dtl.w-p-code = var-w-p-code
     3364               tt-par-dtl.par-code = vidn-par-code
     3365               .
     3366               for first buf_wth-par no-lock where buf_wth-par.wth-code = tt-par-dtl.wth-code
     3367                                       and buf_wth-par.par-code = tt-par-dtl.par-code:
     3368                 buffer-copy buf_wth-par using par-val
     3369                                               par-unit
     3370                                               par-feat
     3371                                               par-rate
     3372                           to tt-par-dtl.
     3373               end.
     3374             end.
     3375             find first tt-wth-parts where
     3376                       tt-wth-parts.out-code = var-doc-code
     3377                   and tt-wth-parts.wth-code = ub.cash-pay.wth-code
     3378                   and tt-wth-parts.w-p-code = var-w-p-code
     3379                   and tt-wth-parts.par-code = vidn-par-code
     3380                   and tt-wth-parts.ser-code = vidn-ser-code
     3381                   and tt-wth-parts.db-num   = vidn-db-num
     3382                   and tt-wth-parts.fact-rangeFrom = vidn-range
     3383                   and tt-wth-parts.fact-rangeTo   = vidn-range   no-error.
     3384             if available tt-wth-parts then do:
     3385                         var-mes = substitute("Обработка платежа серийными МЦ со штрих-кодом &1 в чеке &2.",
     3386                                           buf_chk-pay.pay-card,
     3387                                           buf_chk-doc.doc-code
     3388                                          ) +
     3389                                substitute("&2Данная партия уже существует в документе:&2" +
     3390                               "МЦ &3, Номинал &8, Серия &4-&5, Диапазон: &6-&7."
     3391                               ,loc-inkas.inkas-code
     3392                               ,chr(10)
     3393                               ,ub.wealth.wth-name
     3394                               ,tt-wth-parts.ser-code
     3395                               ,tt-wth-parts.db-num
     3396                               ,tt-wth-parts.fact-rangeFrom
     3397                               ,tt-wth-parts.fact-rangeTo
     3398                               ,tt-par-dtl.par-val
     3399                               ).
     3400                 return error var-mes.
     3401             end.
     3402             create tt-wth-parts.
     3403             assign
     3404             tt-wth-parts.out-code = var-doc-code
     3405             tt-wth-parts.wth-code = ub.cash-pay.wth-code
     3406             tt-wth-parts.w-p-code = var-w-p-code
     3407             tt-wth-parts.par-code = vidn-par-code
     3408             tt-wth-parts.ser-code = vidn-ser-code
     3409             tt-wth-parts.db-num   = vidn-db-num
     3410             tt-wth-parts.fact-rangeFrom = vidn-range
     3411             tt-wth-parts.fact-rangeTo   = vidn-range
     3412             tt-wth-parts.gds-code = vidn-gds-code
     3413             .
     3414       end.
     3415     end.
     3416       find first tt-wth-doc where
     3417                  tt-wth-doc.doc-code = var-doc-code.
     3418       assign
     3419       tt-wth-doc.doc-sum = tt-wth-doc.doc-sum + var-doc-sum
     3420       tt-wth-doc.fact-sum = tt-wth-doc.fact-sum + var-doc-sum
     3421       .
     3422       release tt-wth-doc.
     3423   end.
     3424   _Main-block:
     3425   DO ON ERROR UNDO _main-block, return error var-mes:
     3426     _tt-wth-doc:
     3427     for each tt-wth-doc:
     3428       var-mes = substitute("Не удалось создать документ МЦ к продаже &1&2" +
     3429                            "код кассового платежа&3&2код валюты &4&2Касса &5&2&6&2Кассир &7"
     3430                             ,loc-inkas.inkas-code
     3431                            ,chr(10)
     3432                            ,ub.inkas-pay-desk.pay-code
     3433                            ,ub.inkas-pay-desk.curr-code
     3434                            ,ub.inkas-pay-desk.pay-desk
     3435                            ,(if ub.inkas-pay-desk.doc-type = 'при':U then "продажа" else "возврат")
     3436                            ,ub.inkas-pay-desk.cashier).
     3437       var-doc-code = '':U.
     3438       find first tt-wth-line no-lock where
     3439                  tt-wth-line.doc-code = tt-wth-doc.doc-code no-error .
     3440       if not avail tt-wth-line then next _tt-wth-doc.
     3441       run str/wth-inc1.p (  input yes
     3442                     ,input-output vardoc-rec
     3443                     ,input 'ДОБАВЛЕНИЕ':U
     3444                     ,input var-doc-code
     3445                     ,input tt-wth-doc.host-code
     3446                     ,input tt-wth-doc.obj-type
     3447                     ,input tt-wth-doc.obj-code
     3448                     ,input tt-wth-doc.cli-type
     3449                     ,input tt-wth-doc.cli-code
     3450                     ,input tt-wth-doc.doc-date
     3451                     ,input tt-wth-doc.fact-date
     3452                     ,input tt-wth-doc.shift-date
     3453                     ,input tt-wth-doc.shift-num
     3454                     ,input tt-wth-doc.shift-name
     3455                     ,input tt-wth-doc.operator
     3456                     ,input tt-wth-doc.deliver
     3457                     ,input tt-wth-doc.receiver
     3458                     ,input tt-wth-doc.doc-type
     3459                     ,input tt-wth-doc.auto-fill
     3460                     ,input tt-wth-doc.exter_
     3461                     ,input tt-wth-doc.inter_
     3462                     ,input tt-wth-doc.source-ref
     3463                     ,input tt-wth-doc.source-type
     3464                     ,input tt-wth-doc.borned
     3465                     ,input   0
     3466                     ,input  0
     3467                     ,input tt-wth-doc.ps
     3468                     ,input 'нередакт':U
     3469                     ,input no
     3470                     ,input tt-wth-doc.ext-doc-type
     3471                     ) no-error .
     3472       if error-status:error then do:
     3473         var-mes = substitute("&1&2&3&2&4"
     3474                             ,var-mes
     3475                             ,chr(10)
     3476                             ,error-status:get-message(1)
     3477                             ,return-value ).
     3478         return error var-mes.
     3479       end.
     3480       find first ub.wth-doc no-LOCK WHERE
     3481                  recid(ub.wth-doc) = vardoc-rec No-ERROR.
     3482       if not avail ub.wth-doc then do:
     3483         return error var-mes.
     3484       end.
     3485       assign
     3486       var-doc-code = ub.wth-doc.doc-code
     3487       .
     3488       for each tt-wth-line where
     3489                tt-wth-line.doc-code = tt-wth-doc.doc-code:
     3490         tt-wth-line.doc-code =  var-doc-code.
     3491         empty temp-table tt-dtl-line.
     3492         is-dtl = no.
     3493         for each tt-par-dtl where
     3494                 tt-par-dtl.doc-code = tt-wth-doc.doc-code
     3495             and tt-par-dtl.wth-code = tt-wth-line.wth-code:
     3496             create tt-dtl-line.
     3497             buffer-copy tt-par-dtl to tt-dtl-line
     3498             assign tt-dtl-line.doc-code = var-doc-code.
     3499             for each tt-wth-parts where
     3500                   tt-wth-parts.out-code = tt-wth-doc.doc-code and
     3501                   tt-wth-parts.wth-code = tt-par-dtl.wth-code and
     3502                   tt-wth-parts.w-p-code = tt-par-dtl.w-p-code and
     3503                   tt-wth-parts.par-code = tt-par-dtl.par-code:
     3504                   var-mes = substitute("Не удалось зарезервировать партию  в продаже &1&2" +
     3505                             "Код МЦ &3 Серия: код &4 №БД &5 Диапазон: &6-&7"
     3506                             ,loc-inkas.inkas-code
     3507                             ,chr(10)
     3508                             ,tt-wth-parts.wth-code
     3509                             ,tt-wth-parts.ser-code
     3510                             ,tt-wth-parts.db-num
     3511                             ,tt-wth-parts.fact-rangeFrom
     3512                             ,tt-wth-parts.fact-rangeTo
     3513                             ).
     3514                   varpart-rec = ?.
     3515                   RUN wth-parts-rezerv ( no
     3516                               ,tt-wth-parts.fact-rangeFrom
     3517                               , tt-wth-parts.fact-RangeTo
     3518                               , ?
     3519                               , ?
     3520                               , tt-wth-parts.ser-code
     3521                               , tt-wth-parts.db-num
     3522                               , 0
     3523                               , 0
     3524                               , 0
     3525                               , ub.wth-doc.host-code
     3526                               , ub.wth-doc.obj-type
     3527                               , ub.wth-doc.obj-code
     3528                               , tt-wth-parts.w-p-code
     3529                               , tt-wth-parts.wth-code
     3530                               , tt-wth-parts.par-code
     3531                               , '':U
     3532                               , var-doc-code
     3533                               , '':U
     3534                               , 0
     3535                               , ub.wth-doc.ext-doc-type
     3536                               , tt-wth-parts.gds-code
     3537                               , ub.wth-doc.doc-type
     3538                               ,INPUT-OUTPUT varpart-rec
     3539                               ) no-error .
     3540                   if error-status:error then do:
     3541                     var-mes = var-mes + chr(10) + error-status:get-message(1) + chr(32) + return-value.
     3542                     undo _main-block, return error var-mes.
     3543                   end.
     3544             end.
     3545   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3546   assign
     3547   tt-dtl-line.q-ty-doc  = 0
     3548   tt-dtl-line.q-ty-fact = 0
     3549   tt-dtl-line.doc-sum   = 0
     3550   tt-dtl-line.fact-sum  = 0
     3551   tt-dtl-line.sum-gds-rubl = 0
     3552   tt-dtl-line.sum-gds-base = 0
     3553   .
     3554   for each buf_wth-parts no-lock where buf_wth-parts.w-p-code = tt-dtl-line.w-p-code
     3555                          and buf_wth-parts.wth-code = tt-dtl-line.wth-code
     3556                          and buf_wth-parts.par-code = tt-dtl-line.par-code
     3557                          and buf_wth-parts.out-code = tt-dtl-line.doc-code
     3558                          and buf_wth-parts.stts = 0 :
     3559      assign
     3560     tt-dtl-line.q-ty-doc     =  tt-dtl-line.q-ty-doc  + buf_wth-parts.qnty-doc
     3561     tt-dtl-line.q-ty-fact    =  tt-dtl-line.q-ty-fact + buf_wth-parts.fact-qnty
     3562     tt-dtl-line.sum-gds-rubl =  tt-dtl-line.sum-gds-rubl + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
     3563     tt-dtl-line.sum-gds-base =  tt-dtl-line.sum-gds-base + buf_wth-parts.price-base * buf_wth-parts.fact-qnty
     3564     no-error
     3565     .
     3566   end.
     3567   assign
     3568     tt-dtl-line.doc-sum     =  tt-dtl-line.q-ty-doc  * tt-dtl-line.par-rate
     3569     tt-dtl-line.fact-sum    =  tt-dtl-line.q-ty-fact * tt-dtl-line.par-rate
     3570     no-error
     3571     .
     3572           is-dtl = yes.
     3573         end.
     3574         if is-dtl then do:
     3575   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3576   assign
     3577   tt-wth-line.doc-sum   = 0
     3578   tt-wth-line.fact-sum  = 0
     3579   tt-wth-line.sum-gds-rubl = 0
     3580   tt-wth-line.sum-gds-base = 0
     3581   tt-wth-line.price-rubl   = 0
     3582   tt-wth-line.price-base   = 0.
     3583   for each tt-dtl-line no-lock where tt-dtl-line.w-p-code = tt-wth-line.w-p-code
     3584                          and tt-dtl-line.wth-code = tt-wth-line.wth-code
     3585                          and tt-dtl-line.doc-code = tt-wth-line.doc-code
     3586                          :
     3587     assign
     3588     tt-wth-line.doc-sum      =  tt-wth-line.doc-sum  + tt-dtl-line.doc-sum
     3589     tt-wth-line.fact-sum     =  tt-wth-line.fact-sum + tt-dtl-line.fact-sum
     3590     tt-wth-line.sum-gds-rubl =  tt-wth-line.sum-gds-rubl + tt-dtl-line.sum-gds-rubl
     3591     tt-wth-line.sum-gds-base =  tt-wth-line.sum-gds-base + tt-dtl-line.sum-gds-base
     3592     .
     3593   end.
     3594   assign
     3595     tt-wth-line.price-rubl  =  tt-wth-line.sum-gds-rubl / tt-wth-line.fact-sum
     3596     tt-wth-line.price-base  =  tt-wth-line.sum-gds-base / tt-wth-line.fact-sum
     3597     .
     3598         end.
     3599         run str/wth-lnc1.p (
     3600                       input-output varline-rec,
     3601                       input  'ДОБАВЛЕНИЕ':U,
     3602                       no,
     3603                       var-doc-code,
     3604                       tt-wth-line.wth-code,
     3605                       tt-wth-line.w-p-code,
     3606                       0,
     3607                       tt-wth-line.doc-sum,
     3608                       tt-wth-line.fact-sum,
     3609                       input table tt-dtl-line,
     3610                       no,
     3611                       input tt-wth-doc.ext-doc-type
     3612                       ,tt-wth-line.sum-gds-rubl
     3613                       ,tt-wth-line.sum-gds-base
     3614                       ) no-error .
     3615         if error-status:error then do:
     3616           var-mes = var-mes + chr(10) + error-status:get-message(1) + chr(32) + return-value.
     3617           undo _main-block, return error var-mes.
     3618         end.
     3619       end.
     3620       find first locked_wth-doc EXCLUSIVE-LOCK WHERE
     3621                  recid(locked_wth-doc) = vardoc-rec No-ERROR.
     3622       if not avail locked_wth-doc then do:
     3623         undo _main-block, return error var-mes.
     3624       end.
     3625       find first locked_wth-doc exclusive-LOCK WHERE
     3626                  recid(locked_wth-doc) = vardoc-rec No-ERROR.
     3627       if not avail locked_wth-doc then do:
     3628         return error var-mes.
     3629       end.
     3630       assign
     3631       locked_wth-doc.status_ = 'разрешен':U
     3632       .
     3633       run str/wth-stts.p ( input parparentproc,
     3634                      BUFFER locked_wth-doc,
     3635                      INPUT "+":U,
     3636                      INPUT no,
     3637                      INPUT tt-wth-doc.obj-type,
     3638                      INPUT tt-wth-doc.obj-code,
     3639                      input 'clswdoc.txt':U  ) NO-ERROR.
     3640       if error-status:error then do:
     3641         var-mes = var-mes + chr(10) + error-status:get-message(1) + chr(32) + return-value.
     3642         undo _main-block, return error var-mes.
     3643       end.
     3644       release locked_wth-doc no-error.
     3645       if error-status:error then do:
     3646         var-mes = var-mes + chr(10) + error-status:get-message(1) + chr(32) + return-value.
     3647         undo _main-block, return error var-mes.
     3648       end.
     3649     end.
     3650   END.
