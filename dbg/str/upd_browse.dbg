     2131   procedure xmlchar-decode :
     2132   define input parameter p-in-string      as character        no-undo.
     2133   define output parameter p-out-string    as character        no-undo.
     2134       define variable v-position      as integer      no-undo.
     2135       define variable v-last-position as integer      no-undo.
     2136       define variable v-temp-integer  as integer      no-undo.
     2137       define variable v-current-char  as character    no-undo.
     2138       define variable v-next-char     as character    no-undo.
     2139       define variable v-success       as logical      no-undo.
     2140   do
     2141   on error undo, return error
     2142   :
     2143       assign
     2144           p-out-string = "":U
     2145           v-position   = 0
     2146       .
     2147       replace-cycle:
     2148       do while yes
     2149       on error undo, return error
     2150       :
     2151           assign
     2152               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2153           .
     2154           if v-last-position <= v-position
     2155           then do:
     2156               if v-position = 0
     2157               then do:
     2158                   assign
     2159                       p-out-string = p-in-string
     2160                   .
     2161               end.
     2162               else do:
     2163                   assign
     2164                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2165                   .
     2166               end.
     2167               leave replace-cycle.
     2168           end.
     2169           else do:
     2170               assign
     2171                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2172                   v-position      = v-last-position
     2173                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2174               .
     2175               if v-current-char = "#":U
     2176               then do:
     2177                   assign
     2178                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2179                   .
     2180                   if v-last-position > 0
     2181                   then do:
     2182                       run xmlchar-read-integer in this-procedure
     2183                        (
     2184                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2185                           , output v-temp-integer
     2186                           , output v-success
     2187                       ).
     2188                       if v-success = yes
     2189                       and v-temp-integer >= 1
     2190                       and v-temp-integer <= 255
     2191                       then do:
     2192                           assign
     2193                               p-out-string = p-out-string + chr( v-temp-integer )
     2194                               v-position   = v-last-position + 1
     2195                           .
     2196                       end.
     2197                       else do:
     2198                           assign
     2199                               p-out-string = p-out-string + "&":U
     2200                               v-position   = v-position   + 1
     2201                           .
     2202                       end.
     2203                   end.
     2204                   else do:
     2205                       assign
     2206                           p-out-string = p-out-string + "&":U
     2207                           v-position   = v-position   + 1
     2208                       .
     2209                   end.
     2210               end.
     2211               else do:
     2212                   case substring( p-in-string, v-position + 1, 3 )
     2213                   :
     2214                       when "lt;":U
     2215                       then do:
     2216                           assign
     2217                               p-out-string = p-out-string + "<":U
     2218                               v-position   = v-position   + 3
     2219                           .
     2220                       end.
     2221                       when "gt;":U
     2222                       then do:
     2223                           assign
     2224                               p-out-string = p-out-string + ">":U
     2225                               v-position   = v-position   + 3
     2226                           .
     2227                       end.
     2228                       otherwise do:
     2229                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2230                           then do:
     2231                               assign
     2232                                   p-out-string = p-out-string + "&":U
     2233                                   v-position   = v-position   + 4
     2234                               .
     2235                           end.
     2236                           else do:
     2237                               case substring( p-in-string, v-position + 1, 5 )
     2238                               :
     2239                                   when "quot;":U
     2240                                   then do:
     2241                                       assign
     2242                                           p-out-string = p-out-string + '"':U
     2243                                           v-position   = v-position   + 5
     2244                                       .
     2245                                   end.
     2246                                   when "apos;":U
     2247                                   then do:
     2248                                       assign
     2249                                           p-out-string = p-out-string + "'":U
     2250                                           v-position   = v-position   + 5
     2251                                       .
     2252                                   end.
     2253                                   otherwise do:
     2254                                       assign
     2255                                           p-out-string = p-out-string + "&":U
     2256                                       .
     2257                                   end.
     2258                               end case.
     2259                           end.
     2260                       end.
     2261                   end case.
     2262               end.
     2263           end.
     2264       end.
     2265   end.
     2266   end .
     2267   procedure xmlchar-read-integer :
     2268   define input parameter p-input-string      as character        no-undo.
     2269   define output parameter p-output-integer   as integer          no-undo.
     2270   define output parameter p-success       as logical          no-undo.
     2271   do
     2272   on error undo, return error
     2273   :
     2274       assign
     2275           p-output-integer = integer( p-input-string )
     2276       no-error.
     2277       if error-status :error
     2278       then do:
     2279           assign
     2280               p-success           = no
     2281               p-output-integer    = 0
     2282           .
     2283       end.
     2284       else do:
     2285           assign
     2286               p-success           = yes
     2287           .
     2288       end.
     2289   end.
     2290   end.
     2291   define variable mMRCCode  as logical    no-undo.
     2292   define variable mTypeMark as character  no-undo.
     2293   function IS-NeedMark returns logical
     2294   ( input ib-code as integer  ,
     2295     input ib-str as character ):
     2296      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     2297      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     2298                                    and buf_prod-bc-attr.b-str  eq ib-str
     2299                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     2300        no-lock no-error.
     2301      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     2302   end.
     2303   function repTegforDm return char
     2304   (iDM as char ):
     2305       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     2306       define variable vteg as character no-undo.
     2307       define variable oDM as character no-undo.
     2308       define variable vi as integer no-undo.
     2309       oDM = iDm.
     2310       do vi = 1 to num-entries(vTeglist):
     2311          vTeg = entry(vi,vTeglist).
     2312          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     2313       end.
     2314       return oDM.
     2315   end.
     2316   function repSpecSimbforDm return char
     2317   (iDM as char ):
     2318       define variable oDM as character no-undo.
     2319     run
     2320       xmlchar-decode(iDM, output oDM).
     2321     return repTegforDm (oDM).
     2322   end.
     2323   function CheckGtin return logical
     2324   (iGtin as char):
     2325      define variable bar_code as character no-undo.
     2326      define variable vGtin as logical no-undo init "yes".
     2327      if length(iGtin) eq 14
     2328      then do:
     2329         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     2330         run str/chk-sum.p
     2331          (input-output bar_code ) no-error .
     2332         if iGtin ne  bar_code
     2333         then
     2334            vGtin = no.
     2335      end.
     2336      else
     2337         vGtin = no.
     2338      return vgtin.
     2339   end.
     2340   function repSpecSimbforXlm return char
     2341   (iDM as char ):
     2342       iDM = replace(iDM,chr(29),"").
     2343       return iDM.
     2344   end.
     2345   function getGtinByDM return char
     2346   (IDM as char):
     2347      define variable VTXT as char no-undo.
     2348      define variable vGtin as char no-undo.
     2349      vTXt = IdM.
     2350      vGtin = IDM.
     2351      if    length(vtxt) > 14
     2352      then do:
     2353         if   vtxt begins "(01)"
     2354                or vtxt begins "(02)"
     2355         then
     2356            vGtin = substring(vtxt,5,14).
     2357         else if   (vtxt begins "01"
     2358                or vtxt begins "02" )
     2359                and (   (    substring(iDm,17,2) eq "21"
     2360                         and length(vtxt) >= 21)
     2361                     or substring(iDm,17,2) eq "37"
     2362                     or substring(iDm,17,4) eq "(37)" )
     2363         then do:
     2364            vGtin = substring(vtxt,3,14).
     2365            if not checkGtin(vGtin)
     2366            then
     2367               vGtin = substring(vtxt,1,14).
     2368         end.
     2369         else if     length(vtxt) eq 14 + 7 + 4 + 4
     2370             or length(vtxt) eq 14 + 7 + 4
     2371             or length(vtxt) eq 14 + 7
     2372         then
     2373            vGtin = substring(vtxt,1,14).
     2374      end.
     2375      if not checkGtin(vGtin)
     2376      then
     2377         vGtin = "".
     2378      return vgtin.
     2379   end.
     2380   function getGdsCodeByGtin return int
     2381   (iGtin as char):
     2382      define buffer prod-bc  for ub.prod-bc.
     2383      define buffer bar-code for ub.bar-code.
     2384      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     2385      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2386      return if avail bar-code then bar-code.gds-code else ?.
     2387   end.
     2388   function getQntyCodeByGtin return decimal
     2389   (iGtin as char):
     2390      define buffer prod-bc  for ub.prod-bc.
     2391      define buffer bar-code for ub.bar-code.
     2392      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     2393      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2394      return if avail bar-code then bar-code.cli-base-rate else ?.
     2395   end.
     2396   function getGdsCodeByDM return int
     2397   (iDm as char):
     2398      define variable vGtin as char no-undo.
     2399      define buffer prod-bc for ub.prod-bc.
     2400      vGtin  = getGtinByDM (IDM ).
     2401      return getGdsCodeByGtin (vGtin).
     2402   end.
     2403   function ChekTypeMarkByGds return logical
     2404   (iGds-code as integer ):
     2405      define buffer goods-attr for ub.goods-attr.
     2406      find first goods-attr where goods-attr.gds-code   = iGds-code
     2407                              and goods-attr.attr-code  = 'mark-type':U
     2408      no-lock no-error.
     2409      if available goods-attr
     2410      then do:
     2411         mTypeMark = goods-attr.attr-value.
     2412         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     2413           .
     2414      end.
     2415      else
     2416         return no.
     2417   end.
     2418   function ChekTypeMarkByDm return logical
     2419   (iDM as char ):
     2420      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     2421   end.
     2422   function ChekTypeMarkByGtin return logical
     2423   (iGtin as char ):
     2424      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     2425   end.
     2426   function GetNextElement return character
     2427     (input iAllTeg        as logical
     2428     ,output oteg          as character
     2429     ,output otegval       as character
     2430     ,input-output pstr    as character
     2431      ):
     2432        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     2433        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     2434        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     2435        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     2436        define variable vTeg as character no-undo.
     2437        define variable vLength as integer no-undo.
     2438        define variable vi as integer no-undo.
     2439        define variable vj as integer no-undo.
     2440        define buffer code for ub.code.
     2441        find first code where Code.parent eq "MarkType"
     2442                          and Code.CodeValue   eq mTypeMark
     2443                          no-lock no-error.
     2444        if     available code
     2445           and Code.misc1 ne ""
     2446           and Code.misc1 ne ?
     2447        then do:
     2448           integer (Code.misc1) no-error.
     2449           if not error-status:error
     2450           then
     2451             entry (4,vlistleng) = Code.misc1.
     2452        end.
     2453        if iAllTeg
     2454        then
     2455           assign
     2456              vlistElem     = vlistElem    + vlistElemDop
     2457              vlistleng     = vlistleng    + vlistlengDop
     2458           .
     2459        else if mMRCCode
     2460        then
     2461           assign
     2462              vlistElem     = vlistElem    + ",(8005),8005"
     2463              vlistleng     = vlistleng    + ",000006,0006"
     2464           .
     2465       block-elem:
     2466       do vi = 1 to num-entries(vlistElem):
     2467          vTeg = entry(vi,vlistElem).
     2468          if pstr begins vTeg
     2469          then do:
     2470             if    vTeg eq "21"
     2471             then
     2472                vLength = index(pstr,chr(29)) - 2 no-error.
     2473             if vLength  <= 0
     2474             then
     2475                vLength = int(entry(vi,vlistleng)).
     2476             otegval = substring (pstr,length(vteg) + 1, vLength).
     2477             oteg = replace(replace(vteg,")",""),"(","").
     2478             vTeg = vteg + otegval.
     2479             otegval = replace(otegval,chr(29),"").
     2480             oteg = replace(replace(oteg,")",""),"(","").
     2481             pstr = substring (pstr,length(vTeg)+ 1).
     2482             vTeg = replace(vTeg,chr(29),"").
     2483             leave block-elem.
     2484          end.
     2485          else
     2486             vTeg = "".
     2487       end.
     2488       return vteg.
     2489   end.
     2490   function GetCodeIdent return character
     2491   (iDm as char):
     2492      define variable Velement   as character no-undo init "first".
     2493      define variable oCodeIdent as character no-undo.
     2494      define variable vteg as character no-undo.
     2495      define variable vtegval as character no-undo.
     2496      define variable vGtin as character no-undo.
     2497      define buffer marking for ub.marking.
     2498      for first marking no-lock where
     2499                marking.mark eq iDm
     2500            and marking.unit-ext = "LEVEL2"
     2501      :
     2502        return iDm.
     2503      end.
     2504      vGtin  = getGtinByDM (iDm ).
     2505      ChekTypeMarkByDm(idm).
     2506      if iDm begins 'tech_':U
     2507      then
     2508         oCodeIdent = iDm.
     2509      else if length(iDm) < 21
     2510      then do:
     2511         find first marking where marking.mark eq idm
     2512         no-lock no-error.
     2513         oCodeIdent = if available marking then marking.mark else  ?.
     2514      end.
     2515      else if     length(iDm) eq 29
     2516         and not iDm begins "01"
     2517         and not iDm begins "02"
     2518      then
     2519         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     2520      else  if     length(iDm) >= 24
     2521               and (  iDm begins "01"
     2522                   or iDm begins "02")
     2523               and  substring(iDm,17,2) ne "21"
     2524      then do:
     2525         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     2526                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     2527         then
     2528            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     2529         else
     2530            oCodeIdent = iDM.
     2531      end.
     2532      else  if     (   length(iDm) eq 25
     2533                    or length(iDm) eq 21)
     2534               and (not iDm begins "01"
     2535               and  not iDm begins "02")
     2536      then
     2537         oCodeIdent = substring(iDm,1,21).
     2538      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     2539      then
     2540         oCodeIdent = substring(iDm,1,21).
     2541      else do while Velement ne "" and idm ne "":
     2542         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     2543         oCodeIdent = oCodeIdent + Velement.
     2544      end.
     2545      return oCodeIdent.
     2546   end.
     2547   function GetTegCod return character
     2548   (icodeIdent as char, iTeg as char):
     2549      define variable Velement   as character no-undo init "first".
     2550      define variable oTeg as character no-undo init ?.
     2551      define variable vteg as character no-undo.
     2552      define variable vtegval as character no-undo.
     2553      if     ((length(icodeIdent) eq 21
     2554         and not icodeIdent begins "01"
     2555         and not icodeIdent begins "02")
     2556         or
     2557             ( length(icodeIdent) eq 25
     2558               and not icodeIdent begins "01"
     2559               and not icodeIdent begins "02"))
     2560      then do:
     2561         if iTeg eq "01" or iTeg eq "02"
     2562         then
     2563            oTeg = substring(icodeIdent,1,21).
     2564         else  if  iTeg eq "21"
     2565         then
     2566            oTeg = substring(icodeIdent,15,7).
     2567      end.
     2568      else do:
     2569         ChekTypeMarkByDm(icodeIdent).
     2570         block-teg:
     2571            do while Velement ne "" and icodeIdent ne "":
     2572            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     2573            if    Velement begins iTeg
     2574               or Velement begins "(" + iTeg + ")"
     2575            then do:
     2576               oTeg = vtegval.
     2577               leave block-teg.
     2578            end.
     2579         end.
     2580      end.
     2581      return oTeg.
     2582   end.
     2583   function isOAD return logical
     2584   (icodeIdent as character):
     2585      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     2586   end.
     2587   function isMark return logical
     2588   (icodeIdent as character):
     2589      define buffer buf_marking for ub.marking.
     2590      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     2591             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     2592   end.
     2593   function addBracketForCode return character
     2594   (icodeIdent as char):
     2595      define variable Velement   as character no-undo init "first".
     2596      define variable oTeg as character no-undo.
     2597      define variable vteg as character no-undo.
     2598      define variable vtegval as character no-undo.
     2599      define buffer marking for ub.marking.
     2600      find first marking no-lock where
     2601                 marking.mark begins icodeIdent no-error.
     2602      if    not ChekTypeMarkByDm(icodeIdent)
     2603         or length(icodeIdent) le 24
     2604         or (avail marking and marking.unit-ext = "LEVEL2")
     2605      then
     2606         oTeg = icodeIdent.
     2607      else do:
     2608         if (  icodeIdent begins "01"
     2609            or icodeIdent begins "02"
     2610            ) and CheckGtin(substring (icodeIdent,3,14))
     2611            and substring (icodeIdent,17,2) eq "21"
     2612         then do:
     2613            mMRCCode = yes.
     2614            ChekTypeMarkByDm(icodeIdent).
     2615            block-teg:
     2616            do while Velement ne "" and icodeIdent ne "":
     2617               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2618               if vteg ne ""
     2619               then
     2620                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2621            end.
     2622            mMRCCode = no.
     2623         end.
     2624         else do:
     2625            oTeg = icodeIdent.
     2626         end.
     2627      end.
     2628      return oTeg.
     2629   end.
     2630   function getlevelByCodId return int
     2631   (iCode as char):
     2632      define variable vLength as int no-undo.
     2633      define variable vLevel  as int no-undo.
     2634      if not ChekTypeMarkByDM (icode) then return ?.
     2635      vLength = length(iCode).
     2636      if    vLength eq 18
     2637         or vLength eq 20
     2638      then
     2639         Vlevel = 4.
     2640      else if vLength eq 21
     2641      then
     2642         Vlevel = 1.
     2643      else if vLength eq 25
     2644      then do:
     2645         if  iCode begins "01"
     2646         then
     2647            Vlevel = 3.
     2648         else
     2649            Vlevel = 1.
     2650      end.
     2651      else if     vLength >= 26
     2652              and vLength <= 46
     2653      then do:
     2654         if    substring(iCode,17,2) eq "11"
     2655            or substring(iCode,17,2) eq "13"
     2656            or (    substring(iCode,17,2) eq "21"
     2657                and vLength >= 33
     2658                and substring(iCode,26,4) ne "8005")
     2659         then
     2660            Vlevel = 4.
     2661         else if    vLength eq 31
     2662                 or vLength eq 38
     2663                 or vLength eq 39
     2664                 or vLength eq 45
     2665         then
     2666            Vlevel = 1.
     2667         else if    vLength eq 35
     2668                 or vLength eq 43
     2669         then
     2670            Vlevel = 3.
     2671         else
     2672            Vlevel = ?.
     2673      end.
     2674      else
     2675         Vlevel = ?.
     2676      return Vlevel.
     2677   end.
     2678   function getLevelMotpBycodid return character
     2679   (iDm as char):
     2680      define variable vLevel as integer no-undo.
     2681      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2682      vLevel = getlevelByCodId(iDm).
     2683      if    vLevel eq ?
     2684         or vLevel < 1
     2685         or vLevel > 6
     2686      then
     2687         return ?.
     2688      else
     2689         return entry(vlevel,vList).
     2690   end.
     2691   function getLevelUTDByLevelMotp return character
     2692   (iUnit as char):
     2693      define variable vLevel as integer no-undo.
     2694      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2695      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2696      vLevel = lookup(iUnit,vListMOTP).
     2697      if    vLevel eq ?
     2698         or vLevel < 1
     2699         or vLevel > 4
     2700      then
     2701         return ?.
     2702      else
     2703         return entry(vlevel,vListutd).
     2704   end.
     2705   function getLevelMotpByDM return character
     2706   (iDm as char):
     2707      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2708   end.
     2709   function getLevelUTDByCodId return character
     2710   (iDm as char):
     2711      define variable vLevel as integer no-undo.
     2712      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2713      vLevel = getlevelByCodId(iDm).
     2714      if    vLevel eq ?
     2715         or vLevel < 1
     2716         or vLevel > 4
     2717      then
     2718         return ?.
     2719      else
     2720         return entry(vlevel,vList).
     2721   end.
     2722   function getLevelUTDByDM return character
     2723   (iDm as char):
     2724      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2725   end.
     2726   define variable mNotMarkQnty as logical no-undo.
     2727   function getQntyUTDByCodId return decimal
     2728   (iDM as char):
     2729      define variable vLevel as integer no-undo.
     2730      define variable vList as character no-undo init "1,5,10,500".
     2731      define variable vGtin as character no-undo.
     2732      define variable vqnty as decimal no-undo init ?.
     2733      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2734      if vqnty eq ?
     2735      then do:
     2736         if not mNotMarkQnty
     2737         then do:
     2738            define buffer marking for ub.marking.
     2739            define variable vCodident as character no-undo.
     2740            vCodident = GetCodeIdent(idm).
     2741            find first marking where marking.mark begins vCodident no-lock no-error.
     2742            if     available marking
     2743               and marking.box-qnty ne ?
     2744            then
     2745               return marking.box-qnty.
     2746         end.
     2747         vGtin = getGtinByDm(iDM).
     2748         if ChekTypeMarkByGtin (vGtin)
     2749         then do:
     2750            vLevel = getlevelByCodId(iDM).
     2751            if     vLevel >= 1
     2752               and vLevel <= 4
     2753            then
     2754               vqnty = int(entry(vlevel,vList)).
     2755         end.
     2756         else
     2757            vqnty = getQntyCodeByGtin(vgtin).
     2758      end.
     2759      return vqnty.
     2760   end.
     2761   function getQntyUTDByDM return decimal
     2762   (iDm as char):
     2763      define variable vDM as character no-undo.
     2764      if     length (iDm) ne 25
     2765         and length (iDm) ne 29
     2766         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2767      then
     2768         vDM = substring (iDm,1,length (iDm) - 6 ).
     2769      else
     2770         vDM = substring (iDm,1,length (iDm) - 4 ).
     2771      return getQntyUTDByCodId(vDM).
     2772   end.
     2773   function getMRC4 return decimal
     2774   (iMRC as char):
     2775      define variable oMrc     as decimal no-undo init ?.
     2776      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2777      define variable vi       as integer no-undo.
     2778      define variable vfound   as integer no-undo.
     2779      define variable vposStart   as integer no-undo.
     2780      do:
     2781      OMRc = 0.
     2782      do vi = 1 to 4:
     2783         define variable vsimb as character no-undo.
     2784         vsimb = substring(iMRC,vi,1).
     2785         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2786         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2787         if vfound > 0
     2788         then
     2789            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2790         end.
     2791         OMRc = OMRc / 100.
     2792      end.
     2793      return OMRc.
     2794   end.
     2795   function getMRCByDM return decimal
     2796   (iDm as char):
     2797      define variable vMRC     as character no-undo.
     2798      define variable oMrc     as decimal no-undo init ?.
     2799      define variable Velement as character no-undo init "empty".
     2800      define variable vteg as character no-undo.
     2801      define variable vtegval as character no-undo.
     2802      if    length(idm) eq 14 + 7 + 4 + 4
     2803         or length(idm) eq 14 + 7 + 4
     2804      then do:
     2805         vMRC = substring(idm,22,4).
     2806         omrc = getMRC4(vMRC).
     2807      end.
     2808      else do:
     2809          ChekTypeMarkByDm(iDm).
     2810          block-mrc:
     2811          do while Velement ne "" and idm ne "":
     2812             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2813             if Velement begins "8005"
     2814             then do:
     2815                vMRC = substring(Velement,5,6).
     2816                leave block-mrc.
     2817             end.
     2818             else if Velement begins "(8005)"
     2819             then do:
     2820                vMRC = substring(Velement,7,6).
     2821                leave block-mrc.
     2822             end.
     2823          end.
     2824          if vMRC ne ""
     2825          then
     2826             OMRc = dec(vmrc) / 100 no-error.
     2827      end.
     2828      return OMRc.
     2829   end.
     2830   function MoveDate return Date
     2831   (idate as date,
     2832    iMonth as int64):
     2833      define variable vMonth   as int64 no-undo.
     2834      define variable vYear    as int64 no-undo.
     2835      define variable vDateNew as date  no-undo.
     2836       define variable vDay     as int64 no-undo.
     2837       vMonth = month(iDate) + iMonth.
     2838       vYear =  year(iDate).
     2839       if vMonth <= 0
     2840       then assign
     2841          vMonth = vMonth + 12
     2842           vYear  = vYear - 1
     2843       .
     2844       else if vMonth > 12
     2845       then assign
     2846          vMonth = vMonth - 12
     2847           vYear  = vYear + 1
     2848       .
     2849       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2850       do while error-status:error eq yes:
     2851          VDay = vDay + 1.
     2852          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2853       end.
     2854       if VDay > 0
     2855       then
     2856          vDateNew + 1.
     2857       return vDateNew.
     2858   end.
     2859   procedure checkEMRC:
     2860   define input  parameter iDm as character no-undo.
     2861   define output parameter vok as logical   no-undo init yes.
     2862      define variable v-value-emrc as character no-undo.
     2863      define variable v-type-emrc  as character no-undo.
     2864      define variable vDateIso     as character no-undo.
     2865      define variable vMRC         as decimal no-undo.
     2866      define variable vqnty        as decimal no-undo.
     2867      define variable vPrice       as decimal no-undo.
     2868      define variable vparent      as character no-undo.
     2869      define variable vgds-code    as integer no-undo.
     2870      define buffer code for ub.code.
     2871      vMRC = getMRCByDM(iDm).
     2872      if vMRC > 0
     2873      then do:
     2874         vgds-code = getGdsCodeByDM(iDm).
     2875         vqnty     = getQntyUTDByDM(iDm).
     2876               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2877            (
     2878             input   vgds-code
     2879            ,input   'emrc-type':U
     2880            ,output   v-value-emrc
     2881            ,output   v-type-emrc
     2882          ) no-error.
     2883          if     v-value-emrc ne ""
     2884             and v-value-emrc ne ?
     2885          then do:
     2886             vDateIso = iso-date(today).
     2887             vPrice = vMRC / vqnty.
     2888             vparent ="emc" + chr(4) + v-value-emrc.
     2889             find last code where Code.parent      eq vparent
     2890                              and Code.code        le vDateIso
     2891                              and code.status_  eq 0
     2892             no-lock no-error.
     2893             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2894             then
     2895                vOk = true .
     2896             else do:
     2897                 define variable vText      as character no-undo.
     2898                 define variable vDate      as date no-undo.
     2899                 define variable vDateLast  as character no-undo.
     2900                 define variable vDateFirst as character no-undo.
     2901                 define variable vDate3     as date no-undo.
     2902                 vdate = date(code.misc1).
     2903                 vDateLast = code.misc1.
     2904                 vDate3 = MoveDate(today, - 3 ).
     2905                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2906                                      string(vDate3  , "99/99/9999"),
     2907                                      string(vDate   , "99/99/9999")
     2908                                      ).
     2909                 vdateIso = iso-date(vdate3).
     2910                 find last code  where Code.parent      eq vparent
     2911                                   and Code.code        le vDateIso
     2912                                   and code.status_  eq 0 no-lock no-error.
     2913                 if available code
     2914                 then
     2915                    vDateIso = code.code.
     2916                 vDateFirst = vDateIso.
     2917                 vDateLast = iso-date(vdate).
     2918                 define variable vGood as logical no-undo.
     2919                 define variable vDateSale as date no-undo.
     2920                 define buffer bcode for code.
     2921                 for last code where Code.parent   eq vparent
     2922                                 and code.status_  eq 0
     2923                                 and code.code     < vDateLast
     2924                                 and code.code     >= vDateFirst
     2925                 no-lock:
     2926                    find first bcode where bCode.parent   eq vparent
     2927                                       and bcode.status_  eq 0
     2928                                       and bcode.code     > code.code no-lock no-error.
     2929                    if available bcode
     2930                    then do:
     2931                       if vPrice < dec(Code.CodeValue)
     2932                       then
     2933                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2934                                                     chr(10),
     2935                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2936                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2937                                                     ).
     2938                       else do:
     2939                          vGood = yes.
     2940                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2941                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2942                                                     chr(10),
     2943                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2944                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2945                                                     string(         vDateSale            ,"99/99/9999"),
     2946                                                     string(vDateSale - today)
     2947                                                     ).
     2948                       end.
     2949                    end.
     2950                 end.
     2951                 if vgood
     2952                 then do:
     2953                    define variable choice as integer no-undo .
     2954                    run gbl/d-askw.w (input "Уточнение"
     2955                           ,input  vText
     2956                           ,input "|"
     2957                           ,input "Принять|Вернуть"
     2958                           ,input "Принять данный товар|Вернуть товар постащику"
     2959                           ,input 1
     2960                           ,input 2
     2961                           ,output choice) no-error.
     2962                    vok = choice eq 1.
     2963                 end.
     2964                 else
     2965                    vok =false.
     2966             end.
     2967          end.
     2968      end.
     2969   end.
     2970   function addGs2Mark return character
     2971   (iMark as char):
     2972      define variable vDM   as character no-undo.
     2973      define variable vIdx  as integer   no-undo.
     2974      if index(iMark,chr(29),1) > 0
     2975      then return iMark.
     2976      if substring(iMark,26,4) = "8005" then
     2977      do:
     2978        vIdx = index(iMark,"93",26 + 4 + 5).
     2979        if vIdx > 1 then do:
     2980          vDM = substitute("&1&4&2&4&3",
     2981                           substring(iMark,1,25),
     2982                           substring(iMark,26,vIdx - 25 - 1),
     2983                           substring(iMark,vIdx),
     2984                           chr(29)) no-error.
     2985          vIdx = index(vDm,"240",vIdx + 4).
     2986          if vIdx > 0 then
     2987          do:
     2988            vDM = substitute("&1&3&2",
     2989                             substring(vDm,1,vIdx - 1),
     2990                             substring(vDm,vIdx),
     2991                             chr(29)) no-error.
     2992          end.
     2993        end.
     2994        else
     2995          vDM = substitute("&1&3&2",
     2996                           substring(iMark,1,25),
     2997                           substring(iMark,26),
     2998                           chr(29)) no-error.
     2999      end.
     3000      else if substring(iMark,32,2) = "91" then
     3001      do:
     3002        vIdx = index(iMark,"92",32).
     3003        if vIdx > 1 then
     3004          vDM = substitute("&1&4&2&4&3",
     3005                           substring(iMark,1,31),
     3006                           substring(iMark,32,vIdx - 31 - 1),
     3007                           substring(iMark,vIdx),
     3008                           chr(29)) no-error.
     3009        else
     3010          vDM = substitute("&1&3&2",
     3011                           substring(iMark,1,31),
     3012                           substring(iMark,32),
     3013                           chr(29)) no-error.
     3014      end.
     3015      else if substring(iMark,39,2) = "91" then
     3016      do:
     3017        vIdx = index(iMark,"92",38).
     3018        if vIdx > 1 then
     3019          vDM = substitute("&1&4&2&4&3",
     3020                           substring(iMark,1,38),
     3021                           substring(iMark,39,vIdx - 38 - 1),
     3022                           substring(iMark,vIdx),
     3023                           chr(29)) no-error.
     3024        else
     3025          vDM = substitute("&1&3&2",
     3026                           substring(iMark,1,38),
     3027                           substring(iMark,39),
     3028                           chr(29)) no-error.
     3029      end.
     3030      else if substring(iMark,25,2) = "93" then
     3031      do:
     3032        vIdx = index(iMark,"92",25).
     3033        if vIdx > 1 then
     3034          vDM = substitute("&1&4&2&4&3",
     3035                           substring(iMark,1,24),
     3036                           substring(iMark,25,vIdx - 24 - 1),
     3037                           substring(iMark,vIdx),
     3038                           chr(29)) no-error.
     3039        else
     3040          vIdx = index(iMark,"3103",25).
     3041          if vIdx > 0 then
     3042          vDM = substitute("&1&4&2&4&3",
     3043                           substring(iMark,1,24),
     3044                           substring(iMark,25,vIdx - 24 - 1),
     3045                           substring(iMark,vIdx),
     3046                           chr(29)) no-error.
     3047          else
     3048            vDM = substitute("&1&3&2",
     3049                             substring(iMark,1,24),
     3050                             substring(iMark,25),
     3051                             chr(29)) no-error.
     3052      end.
     3053      else if substring(iMark,32,2) = "93" then
     3054      do:
     3055        vDM = substitute("&1&3&2",
     3056              substring(iMark,1,31),
     3057              substring(iMark,32),
     3058              chr(29)) no-error.
     3059      end.
     3060      return if vDM <> "" then vDm else iMark.
     3061   end.
     3062   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3063   function AddUtdErrForTab returns logical
     3064   (idb-num         as integer ,
     3065    idoc-id         as integer ,
     3066    iTab            as character,
     3067    iObj            as handle ,
     3068    iCheckType      as character,
     3069    iCodeErr        as character,
     3070    iCheckObj       as character ):
     3071      define buffer utd-err for utd-err.
     3072      define buffer utd for utd.
     3073      find first utd where utd.db-num     eq idb-num
     3074                       and utd.doc-id     eq idoc-id
     3075                       and utd.Direction  eq 'Outbound'
     3076      no-lock no-error.
     3077      if available utd
     3078      then
     3079         return no.
     3080      define variable vRecKey as character no-undo.
     3081            run gen-key-rec (input iTab,
     3082                             input  iObj,
     3083                             output vRecKey).
     3084      find first utd-err where utd-err.db-num     eq idb-num
     3085                           and utd-err.doc-id     eq idoc-id
     3086                           and utd-err.CheckType  eq iCheckType
     3087                           and utd-err.CodeErr    eq iCodeErr
     3088                           and utd-err.CheckObj   eq iCheckObj
     3089      exclusive-lock no-error.
     3090      if not available utd-err
     3091      then do:
     3092         create utd-err.
     3093         assign
     3094            utd-err.db-num         = idb-num
     3095            utd-err.doc-id         = idoc-id
     3096            utd-err.CheckType      = iCheckType
     3097            utd-err.CodeErr        = iCodeErr
     3098            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     3099            utd-err.reckey         = vRecKey
     3100            utd-err.qnty           = 1
     3101         .
     3102      end.
     3103      else
     3104         utd-err.qnty = utd-err.qnty + 1.
     3105      return utd-err.qnty eq 1.
     3106   end.
     3107   function AddUtdErr returns logical
     3108   (idb-num         as integer ,
     3109    idoc-id         as integer ,
     3110    iObj            as handle ,
     3111    iCheckType      as character,
     3112    iCodeErr        as character,
     3113    iCheckObj       as character ):
     3114      AddUtdErrForTab
     3115         (idb-num,
     3116          idoc-id,
     3117          iObj:table,
     3118          iObj,
     3119          iCheckType,
     3120          iCodeErr,
     3121          iCheckObj).
     3122   end.
     3123   function ClearUtdErrTypeCode returns logical
     3124   (idb-num         as integer,
     3125    idoc-id         as integer ,
     3126    iCheckType      as character,
     3127    iCodeErr        as character
     3128    ):
     3129      define buffer utd-err for utd-err.
     3130      if    iCheckType eq "*"
     3131         or iCheckType eq ?
     3132      then do:
     3133         if     iCodeErr ne ?
     3134            and iCodeErr ne "*"
     3135         then
     3136            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     3137            view-as alert-box.
     3138         else
     3139         for each utd-err where utd-err.db-num  eq idb-num
     3140                            and utd-err.doc-id  eq idoc-id
     3141         exclusive-lock:
     3142            delete utd-err.
     3143         end.
     3144      end.
     3145      else do:
     3146         if    iCodeErr eq ?
     3147            or iCodeErr eq "*"
     3148         then do:
     3149            for each utd-err where utd-err.db-num     eq idb-num
     3150                               and utd-err.doc-id     eq idoc-id
     3151                               and utd-err.CheckType  eq iCheckType
     3152            exclusive-lock:
     3153               delete utd-err.
     3154            end.
     3155         end.
     3156         else do:
     3157            for each utd-err where utd-err.db-num     eq idb-num
     3158                               and utd-err.doc-id     eq idoc-id
     3159                               and utd-err.CheckType  eq iCheckType
     3160                               and ub.utd-err.CodeErr eq iCodeErr
     3161            exclusive-lock:
     3162               delete utd-err.
     3163            end.
     3164         end.
     3165      end.
     3166   end.
     3167   function ClearUtdErr returns logical
     3168   (idb-num         as integer,
     3169    idoc-id         as integer ,
     3170    iCheckType      as character
     3171    ):
     3172      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     3173   end.
     3174   function GetMesError returns character
     3175   (itxt as character,
     3176    iobj as character ):
     3177    define variable vi as integer no-undo.
     3178    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     3179       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     3180    end.
     3181    return itxt.
     3182   end.
     3183   function GetTextErrorType returns character
     3184   (iCheckType as character,
     3185    iCodeErr   as character,
     3186    iChechObj  as character,
     3187    iType      as character  ):
     3188      define buffer code    for code.
     3189      define variable vError as character no-undo.
     3190      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3191                        and code.code   eq iCodeErr
     3192      no-lock no-error.
     3193      if available code
     3194      then do:
     3195         define variable vType as integer no-undo.
     3196         if code.misc3 eq "error"
     3197         then
     3198            vType = 0.
     3199         else if code.misc3 eq "warning"
     3200         then
     3201            vType = 1.
     3202         else if code.misc3 eq "Hiden"
     3203         then
     3204            vType = 2.
     3205         else
     3206            vtype = int(code.misc3) no-error.
     3207         case itype:
     3208            when "error"
     3209            then do:
     3210               if vtype eq 0
     3211               then
     3212                  vError = GetMesError(Code.CodeValue,iChechObj).
     3213            end.
     3214            when "warning"
     3215            then do:
     3216               if vtype <= 1
     3217               then
     3218                  vError = GetMesError(Code.CodeValue,iChechObj).
     3219            end.
     3220            otherwise do:
     3221               vError = GetMesError(Code.CodeValue,iChechObj).
     3222            end.
     3223         end.
     3224      end.
     3225      else
     3226         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     3227      return vError.
     3228   end.
     3229   function GetTypeError returns integer
     3230   (iCheckType as character,
     3231    iCodeErr   as character):
     3232      define buffer code    for code.
     3233      define variable vType as integer no-undo.
     3234      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3235                        and code.code   eq iCodeErr
     3236      no-lock no-error.
     3237      if     not available code
     3238         and code.misc3 eq "error"
     3239      then
     3240         vType = 0.
     3241      else if code.misc3 eq "warning"
     3242      then
     3243         vType = 1.
     3244      else if code.misc3 eq "Hiden"
     3245      then
     3246         vType = 2.
     3247      else
     3248         vtype = int(code.misc3) no-error.
     3249      return vtype.
     3250   end.
     3251   function GetTextError returns character
     3252   (iCheckType as character,
     3253    iCodeErr   as character,
     3254    iChechObj  as character ):
     3255      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     3256   end.
     3257   function GetErrForUtdStr returns character
     3258   (idb-num     as integer ,
     3259    idoc-id     as integer ,
     3260    iCheckType  as character
     3261    ):
     3262      define buffer utd-err for utd-err.
     3263      define buffer code    for code.
     3264      define variable vHQry as handle no-undo.
     3265      define variable vError as longchar no-undo.
     3266      define variable vErrorOne as longchar  no-undo.
     3267      define variable oError as character no-undo.
     3268      create query vHQry.
     3269      vHQry:set-buffers(buffer utd-err:handle).
     3270      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3271                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3272                               + if    iCheckType eq "*"
     3273                                    or iCheckType eq ?
     3274                                 then       ""
     3275                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3276      vHQry:query-open().
     3277      vHQry:get-first().
     3278      QRY-BLOCK:
     3279      repeat while not vHQry:query-off-end:
     3280         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3281         if     vErrorOne ne ""
     3282            and vErrorOne ne ?
     3283         then
     3284            vError = vError + ", " + vErrorOne.
     3285         vHQry:get-next().
     3286      end.
     3287      oError = substring(vError,3,4002).
     3288      return oError.
     3289   end.
     3290   function GetErrJsonForUtd returns character
     3291   (idb-num         as integer ,
     3292    idoc-id         as integer ,
     3293    iCheckType      as character
     3294    ):
     3295      define buffer utd-err for utd-err.
     3296      define variable vHQry as handle no-undo.
     3297      define variable vError as longchar no-undo.
     3298      define variable oError as character no-undo.
     3299      create query vHQry.
     3300      define variable vi as integer no-undo.
     3301      vHQry:set-buffers(buffer utd-err:handle).
     3302      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3303                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3304                               + if    iCheckType eq "*"
     3305                                    or iCheckType eq ?
     3306                                 then       ""
     3307                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3308      vHQry:query-open().
     3309      vHQry:get-first().
     3310      QRY-BLOCK:
     3311      repeat while not vHQry:query-off-end:
     3312         define variable vErrorOne as character no-undo.
     3313         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3314         if     vErrorOne ne ?
     3315            and vErrorOne ne ""
     3316         then do:
     3317            vi = vi + 1.
     3318            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3319                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     3320                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3321         end.
     3322         vHQry:get-next().
     3323      end.
     3324      for first utd where utd.db-num eq idb-num
     3325                      and utd.doc-id eq idoc-id
     3326                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     3327      no-lock,
     3328         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3329                                  and utd-marking-lines.doc-id eq idoc-id
     3330                                  and utd-marking-lines.doc-level eq 1
     3331      no-lock,
     3332         first marking where marking.mark eq utd-marking-lines.mark
     3333                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3334      no-lock:
     3335         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     3336         if     vErrorOne ne ?
     3337            and vErrorOne ne ""
     3338         then do:
     3339            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     3340                            + '","ОбъектОш":"' + marking.mark
     3341                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3342         end.
     3343      end.
     3344      if vError ne ""
     3345      then
     3346         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     3347      return oError.
     3348   end.
     3349   function GetErrJsonForUtdReturn returns character
     3350   (idb-num         as integer ,
     3351    idoc-id         as integer ,
     3352    iCheckType      as character
     3353    ):
     3354      define buffer utd-err for utd-err.
     3355      define variable vHQry as handle no-undo.
     3356      define variable vError as longchar no-undo.
     3357      define variable oError as character no-undo.
     3358      define variable vi as integer no-undo.
     3359      create query vHQry.
     3360      vHQry:set-buffers(buffer utd-err:handle).
     3361      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3362                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3363                               + if    iCheckType eq "*"
     3364                                    or iCheckType eq ?
     3365                                 then       ""
     3366                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3367      vHQry:query-open().
     3368      vHQry:get-first().
     3369      QRY-BLOCK:
     3370      repeat while not vHQry:query-off-end:
     3371         define variable vErrorOne as character no-undo.
     3372         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3373         if     vErrorOne ne ?
     3374            and vErrorOne ne ""
     3375         then do:
     3376            vi = vi + 1.
     3377            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3378                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     3379                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     3380         end.
     3381         vHQry:get-next().
     3382      end.
     3383      if vError ne ""
     3384      then
     3385         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     3386      return oError.
     3387   end.
     3388   function GetCodeTextError returns character
     3389   (iCheckType as character,
     3390    iCodeErr   as character,
     3391    iChechObj  as character,
     3392    output oCode as character,
     3393    output ovalue as character ):
     3394      define buffer code    for code.
     3395      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3396                        and code.code   eq iCodeErr
     3397      no-lock no-error.
     3398      if     available code
     3399      then do:
     3400         define variable vi as integer no-undo init ?.
     3401         vi = int(Code.misc3) no-error.
     3402         if    code.misc3 ne "error"
     3403            and vi ne 0
     3404         then
     3405            oCode = ?.
     3406         else if     Code.misc1 ne ?
     3407                 and Code.misc1 ne ""
     3408         then
     3409            assign
     3410               oCode  = GetMesError(Code.misc1,iChechObj)
     3411               ovalue = GetMesError(Code.misc2,iChechObj)
     3412            .
     3413      end.
     3414      return if oCode eq ""
     3415             then ""
     3416             else (oCode + "_" + ovalue).
     3417   end.
     3418   define temp-table TT-err no-undo
     3419     field code_ as character
     3420     field text_ as character
     3421   index code_ code_.
     3422   function GetErrTxtForUtd returns character
     3423   (idb-num         as integer ,
     3424    idoc-id         as integer ,
     3425    iCheckType      as character
     3426    ):
     3427      define buffer utd-err for utd-err.
     3428      define variable vHQry as handle no-undo.
     3429      define variable oError as character no-undo.
     3430      create query vHQry.
     3431      define variable vi as integer no-undo.
     3432      for each tt-err :
     3433         delete tt-err.
     3434      end.
     3435      vHQry:set-buffers(buffer utd-err:handle).
     3436      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3437                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3438                               + if    iCheckType eq "*"
     3439                                    or iCheckType eq ?
     3440                                 then       ""
     3441                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3442      vHQry:query-open().
     3443      vHQry:get-first().
     3444      define variable vcode as character no-undo.
     3445      define variable vvalue as character no-undo.
     3446      QRY-BLOCK:
     3447      repeat while not vHQry:query-off-end:
     3448         vi = vi + 1.
     3449         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     3450         if vcode ne ?
     3451         then do:
     3452            find first tt-err where tt-err.code eq vcode
     3453            no-error.
     3454            if not available tt-err
     3455            then do:
     3456               create tt-err.
     3457               assign
     3458                  tt-err.code_ = vcode
     3459                  tt-err.text_ = vvalue
     3460               .
     3461            end.
     3462            else
     3463               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3464         end.
     3465         vHQry:get-next().
     3466      end.
     3467     find first utd where utd.db-num eq idb-num
     3468                         and utd.doc-id eq idoc-id
     3469         no-lock.
     3470      define buffer cancel_utd-lines for utd-lines.
     3471      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     3472                                  and cancel_utd-lines.doc-id eq idoc-id
     3473      no-lock:
     3474         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     3475         then do:
     3476            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3477                                        and utd-marking-lines.doc-id eq idoc-id
     3478                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     3479            no-lock,
     3480               first marking where marking.mark eq utd-marking-lines.mark
     3481                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3482            no-lock:
     3483               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     3484               find first tt-err where tt-err.code eq vcode
     3485               no-error.
     3486               if not available tt-err
     3487               then do:
     3488                  create tt-err.
     3489                  assign
     3490                     tt-err.code_ = vcode
     3491                     tt-err.text_ = vvalue
     3492                  .
     3493               end.
     3494               else
     3495                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3496            end.
     3497         end.
     3498         else do:
     3499            define variable vqnty as decimal no-undo.
     3500            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     3501            if vqnty eq ? then vqnty = 0.
     3502            if vqnty ne cancel_utd-lines.Quantity
     3503            then do:
     3504               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     3505               find first tt-err where tt-err.code eq vcode
     3506               no-error.
     3507               if not available tt-err
     3508               then do:
     3509                  create tt-err.
     3510                  assign
     3511                     tt-err.code_ = vcode
     3512                     tt-err.text_ = vvalue
     3513                  .
     3514               end.
     3515               else
     3516                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3517            end.
     3518         end.
     3519      end.
     3520      for each tt-err:
     3521         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     3522      end.
     3523      return oError.
     3524   end.
     3525   define variable mFormatErr as character no-undo init "text".
     3526   function GetErrForUtd returns character
     3527   (idb-num         as integer ,
     3528    idoc-id         as integer ,
     3529    iType           as character
     3530    ):
     3531      if mFormatErr eq "text"
     3532      then
     3533         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     3534      else do:
     3535         if itype eq "return"
     3536         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     3537         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     3538      end.
     3539   end.
     3540   function GetErrComText returns longchar
     3541   (icomment as character,
     3542    itext    as longchar ):
     3543       define variable vText as longchar no-undo.
     3544      if mFormatErr eq "text"
     3545      then do:
     3546         if icomment ne ""
     3547         then
     3548            icomment = substitute("comment:|&1|",icomment).
     3549         vText = icomment + itext.
     3550      end.
     3551      else do:
     3552         icomment = if icomment begins  '"'
     3553                    then icomment
     3554                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     3555         vText = icomment + "," + itext.
     3556         vText = "~{" + trim(vText,",") + "~}".
     3557      end.
     3558      return vText.
     3559   end.
     3560   function CheckTypeForMarkLineType returns logical
     3561   (iObj            as handle,
     3562    iCheckType      as character,
     3563    iCodeErr        as character ,
     3564    iTypeErr        as character ):
     3565      define variable vRecKey-markLine as character no-undo.
     3566      define variable vGoodMark        as logical no-undo.
     3567      define variable vdb-num          as integer no-undo.
     3568      define variable vdoc-id          as integer no-undo.
     3569      define variable vlinenum         as integer no-undo.
     3570      define variable vErrorOne as character no-undo.
     3571      define buffer buf_utd-err for utd-err.
     3572      run gen-key-rec (input "utd-marking-lines",
     3573                       input  iObj,
     3574                       output vRecKey-markLine).
     3575      vGoodMark = yes.
     3576      vdb-num = iObj::db-num.
     3577      vdoc-id = iObj::doc-id.
     3578      vlinenum = iObj::linenum.
     3579      block-mark-err:
     3580      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3581                               and buf_utd-err.db-num = vdb-num
     3582                               and buf_utd-err.reckey = vRecKey-markLine
     3583                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3584                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3585      no-lock:
     3586         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3587         if     vErrorOne ne ?
     3588            and vErrorOne ne ""
     3589         then do:
     3590            vGoodMark = no.
     3591            leave block-mark-err.
     3592         end.
     3593      end.
     3594      return not vGoodMark.
     3595   end.
     3596   function CheckErrForMarkLineType returns logical
     3597   (iObj            as handle,
     3598    iType           as character  ):
     3599      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     3600   end.
     3601   function CheckErrForMarkLine returns logical
     3602   (iObj            as handle):
     3603      return CheckErrForMarkLineType(iObj,"*").
     3604   end.
     3605   function CheckErrForLineTypeCode returns logical
     3606   (iObj                 as handle,
     3607    iCheckType           as character,
     3608    iCodeErr             as character,
     3609    iTypeErr             as character,
     3610    iOneErr              as logical):
     3611      define variable vRecKey-line     as character no-undo.
     3612      define buffer buf_utd-err for utd-err.
     3613      define variable vUtdlineError as logical no-undo.
     3614      define variable vErrorOne as character no-undo.
     3615            run gen-key-rec (input "utd-lines",
     3616                             input  iObj,
     3617                             output vRecKey-line).
     3618         define variable vdb-num as integer no-undo.
     3619         define variable vdoc-id as integer no-undo.
     3620         define variable vlinenum as integer no-undo.
     3621         vdb-num = iObj::db-num.
     3622         vdoc-id = iObj::doc-id.
     3623         vlinenum = iObj::linenum.
     3624         block-err:
     3625         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3626                                  and buf_utd-err.db-num = vdb-num
     3627                                  and buf_utd-err.reckey = vRecKey-line
     3628                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3629                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3630         no-lock:
     3631            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3632            if     vErrorOne ne ?
     3633               and vErrorOne ne ""
     3634            then do:
     3635               vUtdlineError = yes.
     3636               leave block-err.
     3637            end.
     3638         end.
     3639         if  not vUtdlineError
     3640         then do:
     3641            define variable vGoodMark as logical no-undo.
     3642            vGoodMark = yes.
     3643            block-line-err:
     3644            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     3645                                         and utd-marking-lines.doc-id  eq vdoc-id
     3646                                         and utd-marking-lines.LineNum eq vLineNum
     3647            no-lock:
     3648               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     3649               if     vGoodMark
     3650                  and iOneErr eq no
     3651               then
     3652                  leave block-line-err.
     3653               if     iOneErr = yes
     3654                  and not vGoodMark
     3655               then
     3656                  leave block-line-err.
     3657            end.
     3658            vUtdlineError = not vGoodMark.
     3659         end.
     3660      return vUtdlineError.
     3661   end.
     3662   function getErrForLineType returns character
     3663   (iObj            as handle,
     3664    iType           as character  ):
     3665      define variable vRecKey-line     as character no-undo.
     3666      define buffer buf_utd-err for utd-err.
     3667      define variable vUtdlineError as logical no-undo.
     3668      define variable vErrorOne as character no-undo.
     3669      define variable oError as character no-undo.
     3670            run gen-key-rec (input "utd-lines",
     3671                             input  iObj,
     3672                             output vRecKey-line).
     3673         define variable vdb-num as integer no-undo.
     3674         define variable vdoc-id as integer no-undo.
     3675         define variable vlinenum as integer no-undo.
     3676         vdb-num = iObj::db-num.
     3677         vdoc-id = iObj::doc-id.
     3678         vlinenum = iObj::linenum.
     3679         block-err:
     3680         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3681                                  and buf_utd-err.db-num = vdb-num
     3682                                  and buf_utd-err.reckey = vRecKey-line
     3683                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     3684         no-lock:
     3685            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     3686            if     vErrorOne ne ?
     3687               and vErrorOne ne ""
     3688            then do:
     3689               oError = oError + vErrorOne + " ".
     3690            end.
     3691         end.
     3692      return oError.
     3693   end.
     3694   function CheckErrForLineType returns logical
     3695   (iObj            as handle,
     3696    iType           as character  ):
     3697       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     3698   end.
     3699   function CheckErrForLine returns logical
     3700   (iObj            as handle):
     3701      return CheckErrForLineType(iobj,"*").
     3702   end.
     3703   function CheckErrForUtd returns logical
     3704   (idb-num         as integer ,
     3705    idoc-id         as integer ):
     3706      for each utd-lines where utd-lines.db-num eq idb-num
     3707                           and utd-lines.doc-id eq idoc-id
     3708      no-lock :
     3709         if not CheckErrForLine (buffer ub.utd-lines:handle)
     3710         then
     3711            return no.
     3712      end.
     3713      return yes.
     3714   end.
     3715   function CheckMarkUtd-28rel return logical
     3716    (input idb-num as integer,
     3717    input idoc-id as integer):
     3718    define buffer utd                   for utd.
     3719    define buffer utd-lines             for utd-lines.
     3720    define buffer utd-marking-lines     for utd-marking-lines.
     3721    define variable v-par-type as character no-undo.
     3722    define variable vgdsNoMark as logical no-undo.
     3723    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3724      define variable v-par-val  as character no-undo.
     3725      find first utd where utd.db-num eq idb-num
     3726                       and utd.doc-id eq idoc-id
     3727      no-lock no-error.
     3728      if available utd
     3729      then do:
     3730         if     utd.obj-code ne ?
     3731            and utd.obj-type ne ?
     3732         then do:
     3733            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3734            Block-utd-lines:
     3735            for each utd-lines where utd-lines.db-num eq idb-num
     3736                                 and utd-lines.doc-id eq idoc-id
     3737            no-lock:
     3738               if     utd-lines.gds-code ne ?
     3739                  and utd-lines.gds-code ne 0
     3740               then do:
     3741                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3742                       ( utd-lines.gds-code,
     3743                         'mark-type':U,
     3744                          output v-par-val,
     3745                          output v-par-type
     3746                       ).
     3747                  if     EDOParSec:IsEdo
     3748                     and EDOParSec:GetIsEDOForType(v-par-val)
     3749                  then do:
     3750                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3751                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3752                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3753                                                    and length(utd-marking-lines.mark) > 13
     3754                     no-lock no-error.
     3755                     if     avail utd-marking-lines
     3756                        and not CheckErrForLine(buffer utd-lines:handle)
     3757                     then
     3758                        leave Block-utd-lines.
     3759                  end.
     3760                  else
     3761                     vgdsNoMark = yes.
     3762               end.
     3763            end.
     3764            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3765            if vgdsNoMark then return available utd-lines . else return yes .
     3766         end.
     3767      end.
     3768      return yes.
     3769   end.
     3770   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3771   define temp-table tt-utd-mark no-undo like utd-marking-lines
     3772     field side as character.
     3773   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3774   function CheckMarkUtd return logical
     3775    (input idb-num  as integer,
     3776     input idoc-id  as integer):
     3777     define buffer utd-lines             for ub.utd-lines.
     3778     block-line:
     3779     for each utd-lines where utd-lines.db-num eq idb-num
     3780                          and utd-lines.doc-id eq idoc-id
     3781     no-lock:
     3782        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     3783        then
     3784           leave block-line.
     3785     end.
     3786     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     3787     return available utd-lines.
     3788   end.
     3789   function CheckNotMarkUtd return logical
     3790    (input idb-num  as integer,
     3791     input idoc-id  as integer):
     3792     define buffer utd-lines             for ub.utd-lines.
     3793     for each utd-lines where utd-lines.db-num eq idb-num
     3794                          and utd-lines.doc-id eq idoc-id
     3795     no-lock:
     3796        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3797        then
     3798           return yes.
     3799     end.
     3800     return no.
     3801   end.
     3802   function CheckMarkUtdLine return logical
     3803    (input idb-num  as integer,
     3804     input idoc-id  as integer,
     3805     input iLineNum as integer):
     3806    define buffer utd                   for utd.
     3807    define buffer utd-lines             for utd-lines.
     3808    define buffer utd-marking-lines     for utd-marking-lines.
     3809    define variable v-par-type as character no-undo.
     3810    define variable vMarking        as logical no-undo.
     3811    define variable vArtic          as logical no-undo.
     3812    define variable vTransitional   as logical no-undo.
     3813    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3814      define variable v-par-val  as character no-undo.
     3815      find first utd where utd.db-num eq idb-num
     3816                       and utd.doc-id eq idoc-id
     3817      no-lock no-error.
     3818      if available utd
     3819      then do:
     3820         if     utd.obj-code ne ?
     3821            and utd.obj-type ne ?
     3822         then do:
     3823            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3824            Block-utd-lines:
     3825            for each utd-lines where utd-lines.db-num   eq idb-num
     3826                                 and utd-lines.doc-id   eq idoc-id
     3827                                 and utd-lines.LineNum  eq iLineNum
     3828            no-lock:
     3829               if     utd-lines.gds-code ne ?
     3830                  and utd-lines.gds-code ne 0
     3831               then do:
     3832                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3833                       ( utd-lines.gds-code,
     3834                         'mark-type':U,
     3835                          output v-par-val,
     3836                          output v-par-type
     3837                       ).
     3838                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     3839                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     3840                  if vMarking
     3841                  then do:
     3842                     block-marking:
     3843                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3844                                                    and utd-marking-lines.doc-id   eq idoc-id
     3845                                                    and utd-marking-lines.LineNum  eq iLineNum
     3846                                                    and length(utd-marking-lines.mark) > 13
     3847                     no-lock:
     3848                        if isOAD(utd-marking-lines.mark)
     3849                        then do:
     3850                           assign
     3851                              vArtic   = yes
     3852                              vMarking = no
     3853                           .
     3854                           leave block-marking.
     3855                        end.
     3856                     end.
     3857                  end.
     3858                  if vArtic
     3859                  then do:
     3860                     block-artic:
     3861                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3862                                                    and utd-marking-lines.doc-id   eq idoc-id
     3863                                                    and utd-marking-lines.LineNum  eq iLineNum
     3864                                                    and length(utd-marking-lines.mark) > 13
     3865                     no-lock:
     3866                        if isMark(utd-marking-lines.mark)
     3867                        then do:
     3868                           assign
     3869                              vArtic   = no
     3870                              vMarking = yes
     3871                           .
     3872                           leave block-artic.
     3873                        end.
     3874                     end.
     3875                  end.
     3876                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3877                  if vTransitional
     3878                  then do:
     3879                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3880                                                    and utd-marking-lines.doc-id   eq idoc-id
     3881                                                    and utd-marking-lines.LineNum  eq iLineNum
     3882                                                    and length(utd-marking-lines.mark) > 13
     3883                     no-lock no-error.
     3884                     if not available utd-marking-lines
     3885                     then assign
     3886                        vMarking = no
     3887                        vArtic   = no
     3888                     .
     3889                  end.
     3890               end.
     3891               else
     3892                  assign
     3893                     vMarking      = yes
     3894                     vArtic        = no
     3895                     vTransitional = no
     3896                  .
     3897               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3898               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3899               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3900            end.
     3901         end.
     3902      end.
     3903      return vMarking or vArtic.
     3904   end.
     3905   function getMarkUtdLine return logical
     3906    (input  idb-num  as integer,
     3907     input  idoc-id  as integer,
     3908     input  iLineNum as integer,
     3909     output oMarking        as logical,
     3910     output oArtic          as logical,
     3911     output oTransitional   as logical):
     3912     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3913     oArtic        = not oMarking
     3914            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3915     oTransitional = (oMarking or oArtic)
     3916            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3917   end.
     3918   function CheckMarking return logical
     3919    (input idb-num as integer,
     3920    input idoc-id as integer,
     3921    input iTypeErr as character ):
     3922     define variable vMarkutd as logical no-undo.
     3923     define variable vCrErr   as logical no-undo.
     3924     define buffer utd-lines         for utd-lines.
     3925     define buffer utd-marking-lines for utd-marking-lines.
     3926     define buffer marking           for marking.
     3927     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     3928      block-line:
     3929      for each utd-lines where utd-lines.db-num eq idb-num
     3930                           and utd-lines.doc-id eq idoc-id
     3931      no-lock:
     3932         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3933         then do:
     3934            for each utd-marking-lines
     3935                     where utd-marking-lines.db-num  = utd-lines.db-num
     3936                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3937                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3938            no-lock:
     3939               if isMark(utd-marking-lines.mark)
     3940               then do:
     3941                  find first marking where marking.mark eq utd-marking-lines.mark
     3942                  no-lock no-error.
     3943                  if not available marking
     3944                  then do:
     3945                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     3946                     vCrErr = yes.
     3947                     next block-line.
     3948                  end.
     3949               end.
     3950            end.
     3951         end.
     3952      end.
     3953      return vCrErr.
     3954   end.
     3955   function CheckMarkForType return logical
     3956    (input idb-num   as integer,
     3957     input idoc-id   as integer):
     3958      define variable vMarking        as logical no-undo.
     3959      define variable vArtic          as logical no-undo.
     3960      define variable vTransitional   as logical no-undo.
     3961      define buffer utd-lines         for utd-lines.
     3962      define buffer utd-marking-lines for utd-marking-lines.
     3963      block-line:
     3964      for each utd-lines where utd-lines.db-num eq idb-num
     3965                           and utd-lines.doc-id eq idoc-id
     3966      no-lock:
     3967         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     3968                          output vMarking         , output vArtic          , output vTransitional).
     3969         for each utd-marking-lines
     3970                     where utd-marking-lines.db-num  = utd-lines.db-num
     3971                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3972                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3973         no-lock:
     3974            if length(utd-marking-lines.mark) < 14
     3975            then do:
     3976               if (vMarking or vArtic) and not vTransitional
     3977               then
     3978                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3979            end.
     3980            else if not isMark(utd-marking-lines.mark)
     3981            then do:
     3982               if vMarking
     3983               then
     3984                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3985            end.
     3986            else do:
     3987            end.
     3988         end.
     3989      end.
     3990   end.
     3991   function WeighedProd return logical
     3992      ( input p-gds-code as integer) :
     3993      define variable v-par-val  as character no-undo.
     3994      define variable v-par-type as character no-undo.
     3995              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3996               ( p-gds-code,
     3997                 'weighed-gds':U,
     3998                  output v-par-val,
     3999                  output v-par-type
     4000               ).
     4001      return logical(v-par-val).
     4002   end.
     4003   function WghProdVariable return logical
     4004       (input p-obj-type as char,
     4005        input p-obj-code as integer,
     4006        input p-gds-code as integer) :
     4007      define variable v-wgh-val  as character no-undo.
     4008      define variable v-par-val  as character no-undo.
     4009      define variable v-par-type as character no-undo.
     4010      define variable vMarking        as logical no-undo.
     4011      define variable vArtic          as logical no-undo.
     4012      define variable vTransitional   as logical no-undo.
     4013      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4014         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4015           ( p-gds-code,
     4016             'weighed-gds':U,
     4017              output v-wgh-val,
     4018              output v-par-type
     4019           ).
     4020       if logical(v-wgh-val) = yes then do:
     4021           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4022               ( p-gds-code,
     4023                 'mark-type':U,
     4024                  output v-par-val,
     4025                  output v-par-type
     4026               ).
     4027           if v-par-val <> "" then do:
     4028               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     4029               assign
     4030                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     4031                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     4032                  .
     4033           end.
     4034      end.
     4035      if v-wgh-val > "" and (vMarking or vArtic)
     4036      then return yes.
     4037      else return no.
     4038   end.
     4039   function MarkWeight return decimal
     4040      ( input p-mark as character) :
     4041      define buffer  buf_marking-attr for  ub.marking-attr.
     4042      define variable vMarkWeight as decimal no-undo.
     4043      vMarkWeight = 0.
     4044      if p-mark <> "" and p-mark <> ?
     4045      then do:
     4046          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     4047                                        and buf_marking-attr.attr-code eq "weight"
     4048             no-lock no-error.
     4049          if not available buf_marking-attr
     4050          then do :
     4051            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     4052                                          and buf_marking-attr.attr-code eq "weight"
     4053               no-lock no-error.
     4054          end .
     4055          if avail buf_marking-attr
     4056          then vMarkWeight = dec(buf_marking-attr.attr-value).
     4057      end.
     4058      return vMarkWeight.
     4059   end.
     4060   function CheckQnty returns logical
     4061   (  input idb-num  as integer,
     4062      input idoc-id  as integer,
     4063      input iErrType as character
     4064   ):
     4065      if iErrType ne "loadUTD"
     4066      then do:
     4067         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     4068         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     4069         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     4070      end.
     4071      if iErrType ne "CheckQnty"
     4072      then do:
     4073         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     4074         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     4075         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     4076      end.
     4077      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     4078      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     4079      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     4080      define buffer marking               for marking.
     4081      define buffer utd-lines             for utd-lines.
     4082      define buffer utd-marking-lines     for utd-marking-lines.
     4083      define buffer Buf_utd-marking-lines for utd-marking-lines.
     4084      block-line:
     4085      for each utd-lines where utd-lines.db-num eq idb-num
     4086                           and utd-lines.doc-id eq idoc-id
     4087      no-lock:
     4088         define variable Vflagmark as logical no-undo.
     4089         find first buf_utd-marking-lines
     4090                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     4091                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     4092                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     4093                         and length(buf_utd-marking-lines.mark) > 13
     4094         no-lock no-error.
     4095         if not available buf_utd-marking-lines
     4096         then
     4097            next block-line.
     4098         define variable vqntyMark as integer no-undo.
     4099         define variable vqntyOAD  as integer no-undo.
     4100         vqntyMark = 0.
     4101         vqntyOAD  = 0.
     4102         block-mark:
     4103         for each utd-marking-lines
     4104              where utd-marking-lines.db-num  = utd-lines.db-num
     4105                and utd-marking-lines.doc-id  = utd-lines.doc-id
     4106                and utd-marking-lines.LineNum = utd-lines.LineNum
     4107                and length(utd-marking-lines.mark) > 13
     4108                and utd-marking-lines.doc-level  = 1
     4109         no-lock:
     4110            if isMark(utd-marking-lines.mark)
     4111            then do:
     4112               find first marking where marking.mark eq utd-marking-lines.mark
     4113               no-lock no-error.
     4114               if available marking
     4115               then do:
     4116                  if marking.box-qnty ne ?
     4117                  then
     4118                     vqntyMark = vqntyMark + marking.box-qnty.
     4119               end.
     4120            end.
     4121            else do:
     4122               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     4123                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     4124                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     4125                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     4126                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     4127               no-lock no-error.
     4128               if available utd-marking-lines-attr
     4129               then
     4130                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     4131            end.
     4132         end.
     4133         if     utd-lines.gds-code   gt 0
     4134            and utd-lines.gds-code   ne ?
     4135            and vqntyMark            ne 0
     4136         then do:
     4137            if utd-lines.Quantity  < vqntyMark
     4138            then
     4139               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     4140            else if utd-lines.Quantity  <> vqntyMark
     4141            then
     4142               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     4143         end.
     4144         else if     utd-lines.gds-code   gt 0
     4145            and utd-lines.gds-code   ne ?
     4146            and vqntyOAD ne 0
     4147            and utd-lines.Quantity  ne vqntyOAD
     4148         then
     4149            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     4150      end.
     4151   end.
     4152   function CheckGds returns logical
     4153   (  input idb-num   as integer,
     4154      input idoc-id   as integer,
     4155      input iobj-type as character,
     4156      input iobj-code as integer,
     4157      input iErrType as character
     4158   ):
     4159      if iErrType ne "loadUTD"
     4160      then do:
     4161         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     4162         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     4163         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     4164         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     4165         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     4166         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     4167         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     4168         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     4169         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     4170         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     4171         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     4172      end.
     4173      if iErrType ne "CheckGds"
     4174      then do:
     4175         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     4176         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     4177         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     4178         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     4179         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     4180         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     4181         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     4182         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     4183         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     4184         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     4185         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     4186      end.
     4187      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     4188      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     4189      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     4190      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     4191      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     4192      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     4193      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     4194      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     4195      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     4196      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     4197      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     4198      define variable v-par-type as character no-undo.
     4199      define variable v-par-val  as character no-undo.
     4200      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4201      define buffer marking               for marking.
     4202      define buffer utd-lines             for utd-lines.
     4203      define buffer buf_utd-lines         for utd-lines.
     4204      define buffer utd-marking-lines     for utd-marking-lines.
     4205      define buffer Buf_utd-marking-lines for utd-marking-lines.
     4206      define variable vGdsCode as integer no-undo.
     4207      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     4208      block-line:
     4209      for each utd-lines where utd-lines.db-num eq idb-num
     4210                           and utd-lines.doc-id eq idoc-id
     4211      no-lock:
     4212         vGdsCode = ?.
     4213         define variable Vflagmark as logical no-undo.
     4214         define variable VflagOAD  as logical no-undo.
     4215         assign
     4216            Vflagmark = no
     4217            VflagOAD = no
     4218         .
     4219         block-mark:
     4220         for each utd-marking-lines
     4221                  where utd-marking-lines.db-num  = utd-lines.db-num
     4222                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     4223                    and utd-marking-lines.LineNum = utd-lines.LineNum
     4224         no-lock:
     4225            if    isMark(utd-marking-lines.mark)
     4226               or isOAD (utd-marking-lines.mark)
     4227            then do:
     4228               define variable vnewGdsCode as integer no-undo.
     4229               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     4230               if isMark(utd-marking-lines.mark)
     4231               then do:
     4232                  Vflagmark = yes.
     4233                  find first marking where marking.mark eq utd-marking-lines.mark
     4234                  no-lock no-error.
     4235                  if not available marking
     4236                  then do:
     4237                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     4238                     next block-mark.
     4239                  end.
     4240                  if vnewGdsCode eq ?
     4241                  then
     4242                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     4243                  if    marking.gds-code eq 0
     4244                     or marking.gds-code eq ?
     4245                     or marking.sts eq 0
     4246                     or marking.sts eq ?
     4247                     or marking.box-qnty eq ?
     4248                     or (marking.gds-code ne vnewGdsCode
     4249                         and vnewGdsCode ne ?
     4250                         and vnewGdsCode ne 0)
     4251                  then do:
     4252                     find first marking where marking.mark eq utd-marking-lines.mark
     4253                     exclusive-lock no-error.
     4254                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     4255                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     4256                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     4257                     if    marking.gds-ext-id eq ""
     4258                        or marking.gds-ext-id eq ?
     4259                     then do:
     4260                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     4261                     end.
     4262                     else if    marking.gds-code eq 0
     4263                             or marking.gds-code eq ?
     4264                     then
     4265                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     4266                     else if     marking.sts eq 0
     4267                             or  marking.sts eq ?
     4268                     then
     4269                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     4270                  end.
     4271                  if utd-marking-lines.doc-level eq 1
     4272                  then do:
     4273                     if marking.box-qnty eq ?
     4274                     then
     4275                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4276                  end.
     4277               end.
     4278               else do:
     4279                  VflagOAD = yes.
     4280                  define variable vQnty as decimal no-undo.
     4281                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     4282                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     4283                                          utd-marking-lines.doc-id,
     4284                                          utd-marking-lines.LineNum,
     4285                                          utd-marking-lines.mark,
     4286                                          "box-qnty",
     4287                                           string(vQnty)).
     4288                  define variable vgtin as character no-undo.
     4289                  vgtin = getGtinByDM(utd-marking-lines.mark).
     4290                  if getQntyCodeByGtin(vgtin) ne 1
     4291                  then
     4292                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     4293               end.
     4294               if utd-marking-lines.gds-code ne vnewGdsCode
     4295               and vnewGdsCode ne ?
     4296               and vnewGdsCode ne 0
     4297               then do:
     4298                  find first buf_utd-marking-lines
     4299                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     4300                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     4301                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     4302                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     4303                  exclusive-lock no-error.
     4304                  if available buf_utd-marking-lines
     4305                  then do:
     4306                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     4307                  end.
     4308               end.
     4309            end.
     4310            else  do:
     4311               define variable vgdsbar as integer no-undo.
     4312               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     4313               if    utd-marking-lines.gds-code ne vgdsbar
     4314               then do:
     4315                  find first buf_utd-marking-lines
     4316                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     4317                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     4318                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     4319                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     4320                  exclusive-lock no-error.
     4321                  if available buf_utd-marking-lines
     4322                  then do:
     4323                     buf_utd-marking-lines.gds-code = vgdsbar.
     4324                  end.
     4325               end.
     4326               if vgdsbar ne ?
     4327               then do:
     4328                                 if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4329                            ( vgdsbar,
     4330                              'mark-type':U,
     4331                              output v-par-val,
     4332                              output v-par-type
     4333                             ).
     4334                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     4335                       or  EDOParSec:GetIsArticForType(v-par-val))
     4336                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     4337                   and     EDOParSec:IsEdo
     4338                  then do:
     4339                     AddUtdErr(utd-marking-lines.db-num,
     4340                               utd-marking-lines.doc-id,
     4341                               buffer utd-marking-lines:handle,
     4342                               iErrType,
     4343                               "MarkingForTypeEDO",
     4344                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4345                  end.
     4346               end.
     4347            end.
     4348            if vGdsCode eq ?
     4349            then
     4350               vGdsCode = utd-marking-lines.gds-code.
     4351            if vGdsCode ne utd-marking-lines.gds-code
     4352            and utd-marking-lines.gds-code > 0
     4353            then do:
     4354               vGdsCode = -1.
     4355            end.
     4356         end.
     4357         if  vGdsCode = -1
     4358         then do:
     4359            vGdsCode = ?.
     4360            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     4361            next block-line.
     4362         end.
     4363         if vGdsCode ne ?
     4364         then do:
     4365                     if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4366                      ( vGdsCode,
     4367                        'mark-type':U,
     4368                        output v-par-val,
     4369                        output v-par-type
     4370                       ).
     4371            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     4372                and(
     4373                 (    EDOParSec:GetIsEDOForType(v-par-val)
     4374                     and not Vflagmark)
     4375                 or  (EDOParSec:GetIsArticForType(v-par-val)
     4376                     and not VflagOAD
     4377                     and not Vflagmark))
     4378            then do:
     4379               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     4380            end.
     4381         end.
     4382         if utd-lines.gds-code ne vGdsCode
     4383         then do:
     4384            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4385                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4386                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     4387            exclusive-lock no-error.
     4388            if available buf_utd-lines
     4389            then
     4390               buf_utd-lines.gds-code = vGdsCode.
     4391            release buf_utd-lines.
     4392         end.
     4393         define variable VBarCode as character no-undo.
     4394         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     4395         if VBarCode ne ?
     4396         then do:
     4397            if num-entries(VBarCode," ") > 0
     4398            then
     4399               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     4400            vgdsbar = GetGdsCodeByGtin(VBarCode).
     4401            if vgdsbar eq ? or vgdsbar eq 0
     4402            then do:
     4403               AddUtdErr(utd-lines.db-num,
     4404                         utd-lines.doc-id,
     4405                         buffer utd-lines:handle,
     4406                         iErrType,
     4407                         "NotFindGdsForBarCode",
     4408                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     4409            end.
     4410            else do:
     4411               if    utd-lines.gds-code eq ?
     4412                  or utd-lines.gds-code eq 0
     4413               then do:
     4414                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4415                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4416                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     4417                  exclusive-lock no-error.
     4418                  if available buf_utd-lines
     4419                  then
     4420                     buf_utd-lines.gds-code = vgdsbar.
     4421                  release buf_utd-lines.
     4422               end.
     4423               else if utd-lines.gds-code ne vgdsbar
     4424               then do:
     4425                  AddUtdErr(utd-lines.db-num,
     4426                         utd-lines.doc-id,
     4427                         buffer utd-lines:handle,
     4428                         iErrType,
     4429                         "NotEqGgsForLineAndMark",
     4430                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     4431               end.
     4432            end.
     4433         end.
     4434         if vGdsCode eq ? and utd-lines.gds-code eq ?
     4435         then
     4436            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     4437      end.
     4438   end.
     4439   function GetUtdLineForOrig return logical
     4440   (input idb-num as integer,
     4441    input idoc-id as integer,
     4442    input ilineNum as integer,
     4443    input idb-numOrig as integer,
     4444    input idoc-idOrig as integer,
     4445    buffer edoc-lines for utd-lines):
     4446      define buffer edoc-marking-lines for ub.utd-marking-lines.
     4447      block-mark:
     4448      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     4449                                   and utd-marking-lines.doc-id  eq idoc-id
     4450                                   and utd-marking-lines.LineNum eq iLineNum
     4451                                   and utd-marking-lines.site eq "-"
     4452      no-lock:
     4453         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     4454                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     4455                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4456                     no-lock no-error.
     4457         if available edoc-marking-lines
     4458         then do:
     4459            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     4460                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     4461                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     4462            no-lock no-error.
     4463               leave block-mark.
     4464          end.
     4465      end.
     4466       if not available edoc-lines
     4467       then do:
     4468          find  first  utd-lines where utd-lines.db-num      = idb-num
     4469                                   and utd-lines.doc-id      = idoc-id
     4470                                   and utd-lines.LineNum     = ilinenum
     4471             no-lock no-error.
     4472          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     4473                                  and edoc-lines.doc-id      = idoc-idOrig
     4474                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     4475          no-lock no-error.
     4476       end.
     4477       if not available edoc-lines
     4478       then
     4479          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     4480                                  and edoc-lines.doc-id      = idoc-idOrig
     4481                                  and edoc-lines.gds-code    = utd-lines.gds-code
     4482          no-lock no-error.
     4483   end.
     4484   function GetLastUTDinPack returns logical
     4485   (input idb-num as integer,
     4486    input idoc-id as integer,
     4487    output odb-num as integer,
     4488    output odoc-id as integer ) forward.
     4489   function getObgFns return logical
     4490   (input iDocumentNumber   as character ,
     4491    input iFnsParticipantId as character ,
     4492    input ikpp              as character ,
     4493    output ohost-code       as integer,
     4494    output oobj-type        as character ,
     4495    output oobj-code        as integer ,
     4496    output otext            as character  ):
     4497       define buffer ext-classif   for ext-classif.
     4498       define buffer clients       for clients.
     4499       define buffer buf_clients   for clients.
     4500       define buffer clients-attr  for clients-attr.
     4501       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     4502                                and ext-classif.charkey_three eq iFnsParticipantId
     4503       no-lock no-error.
     4504       if available ext-classif
     4505       then do:
     4506          if ext-classif.CharKey_One eq 'маг':U
     4507          then do:
     4508             assign
     4509                oobj-type = ext-classif.CharKey_One
     4510                oobj-code = ext-classif.Key#_One
     4511             .
     4512             find first clients
     4513                  where clients.obj-type   = ext-classif.CharKey_One
     4514                    and clients.obj-code   = ext-classif.Key#_One
     4515             no-lock no-error .
     4516             if available clients
     4517             then
     4518                ohost-code =  clients.host-code.
     4519          end.
     4520          else do:
     4521             find first clients
     4522                  where clients.obj-type   = ext-classif.CharKey_One
     4523                    and clients.obj-code   = ext-classif.Key#_One
     4524                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     4525             no-lock no-error .
     4526             if not available clients
     4527             then do:
     4528                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     4529                return no.
     4530             end.
     4531             ohost-code = ext-classif.Key#_One.
     4532             block-cl:
     4533             for each clients-attr
     4534                where clients-attr.attr-code  = 'kpp':U
     4535                  and clients-attr.obj-type   = 'маг':U
     4536                  and clients-attr.attr-value = ikpp
     4537                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     4538                                             and buf_clients.obj-code   = clients-attr.obj-code
     4539                                             and buf_clients.host-code  = ohost-code)
     4540             no-lock :
     4541                leave block-cl.
     4542             end.
     4543             if     available clients
     4544                and clients.obj-type eq 'маг':U
     4545             then do:
     4546                assign
     4547                   oobj-type = clients.obj-type
     4548                   oobj-code = clients.obj-code
     4549                .
     4550             end.
     4551             else if available clients-attr
     4552             then do:
     4553                assign
     4554                   oobj-type = clients-attr.obj-type
     4555                   oobj-code = clients-attr.obj-code
     4556                .
     4557             end.
     4558             else do:
     4559                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     4560                return yes.
     4561             end.
     4562          end.
     4563       end.
     4564       else do:
     4565          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     4566          return no.
     4567       end.
     4568       return ?.
     4569   end.
     4570   function CheckUcdForReturn return logical
     4571   (input idb-numUcd as integer,
     4572    input idoc-idUcd as integer,
     4573    input idb-numRet as integer,
     4574    input idoc-idRet as integer  ):
     4575       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     4576                                    and utd-marking-lines.doc-id eq idoc-idUcd
     4577                                    and utd-marking-lines.doc-level eq 1
     4578       no-lock:
     4579          create tt-utd-mark.
     4580          buffer-copy utd-marking-lines to tt-utd-mark
     4581          assign
     4582             tt-utd-mark.side = "+"
     4583          .
     4584       end.
     4585       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     4586                                    and utd-marking-lines.doc-id eq idoc-idRet
     4587                                    and utd-marking-lines.doc-level eq 1
     4588       no-lock:
     4589          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     4590          no-lock no-error.
     4591          if available tt-utd-mark
     4592          then
     4593             tt-utd-mark.side = "".
     4594          else do:
     4595             create tt-utd-mark.
     4596             buffer-copy utd-marking-lines to tt-utd-mark
     4597             assign
     4598                tt-utd-mark.side = "-"
     4599             .
     4600          end.
     4601       end.
     4602       for each tt-utd-mark where  tt-utd-mark.side ne ""
     4603       no-lock:
     4604          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     4605       end.
     4606       for each tt-utd-mark:
     4607          delete tt-utd-mark.
     4608       end.
     4609   end.
     4610   function GetLastUTDinPackAft returns logical
     4611   (input idb-num as integer,
     4612    input idoc-id as integer,
     4613    output odb-num as integer,
     4614    output odoc-id as integer ) forward.
     4615   function SaturateAndCheckUTD return character
     4616   (input idb-num as integer,
     4617    input idoc-id as integer  ):
     4618      define buffer clients-attr          for clients-attr.
     4619      define buffer clients               for clients.
     4620      define buffer Utd                   for Utd.
     4621      define buffer utd_ret               for ub.utd.
     4622      define buffer utd-lines             for utd-lines.
     4623      define buffer buf_utd-lines         for utd-lines.
     4624      define buffer buf_utddoc-lines      for utd-lines.
     4625      define buffer marking               for marking.
     4626      define buffer marking-lines         for marking-lines.
     4627      define buffer utd-marking-lines     for utd-marking-lines.
     4628      define buffer Buf_utd-marking-lines for utd-marking-lines.
     4629      define buffer contract              for contract.
     4630      define buffer old_utd               for Utd.
     4631      define variable vError as character no-undo.
     4632      define variable vGdsCode as integer no-undo.
     4633      define variable vcli-type as character no-undo.
     4634      define variable vcli-code as integer no-undo.
     4635      define variable vhost-code as integer no-undo init ?.
     4636      define variable vcontract-code as integer no-undo.
     4637      define variable vobj-type as character no-undo init ?.
     4638      define variable vobj-code as integer no-undo init ?.
     4639      define variable volddb-num as integer no-undo.
     4640      define variable volddoc-id as integer no-undo.
     4641      define variable vMark as logical no-undo.
     4642      define variable VUcd as logical no-undo.
     4643      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4644      define variable v-par-type as character no-undo.
     4645      define variable v-par-val  as character no-undo.
     4646      define variable VFileMark as logical no-undo.
     4647      define variable vunit     as int no-undo.
     4648      define variable vunitCode as character no-undo.
     4649      define variable vMarkingUtd as logical no-undo.
     4650      find first Utd where utd.db-num eq idb-num
     4651                       and utd.doc-id eq idoc-id
     4652      no-lock no-error.
     4653      if available Utd
     4654      then do:
     4655         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     4656         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     4657         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     4658         assign
     4659               vobj-type  = utd.obj-type
     4660               vobj-code  = utd.obj-code
     4661               vhost-code = utd.host-code
     4662         .
     4663         do:
     4664            define variable vtext       as character no-undo.
     4665            define variable vhost-code1 as integer   no-undo.
     4666            define variable vobj-type1  as character no-undo.
     4667            define variable vobj-code1  as integer   no-undo.
     4668             getObgFns
     4669                       (input utd.DocumentNumber ,
     4670                        input utd.obj-FnsParticipantId ,
     4671                        input utd.obj-kpp,
     4672                        output vhost-code1,
     4673                        output vobj-type1,
     4674                        output vobj-code1,
     4675                        output vtext ).
     4676            assign
     4677               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     4678               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     4679               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     4680            .
     4681            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     4682            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     4683            block-line:
     4684            for each utd-lines where utd-lines.db-num eq utd.db-num
     4685                                 and utd-lines.doc-id eq utd.doc-id
     4686            no-lock:
     4687               vGdsCode =?.
     4688               define variable vNotMarkForLine as logical no-undo.
     4689               vNotMarkForLine = no.
     4690               if not VUcd
     4691               then do:
     4692                  find first utd-marking-lines
     4693                       where utd-marking-lines.db-num  = utd-lines.db-num
     4694                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     4695                         and utd-marking-lines.LineNum = utd-lines.LineNum
     4696                  no-lock no-error.
     4697                  if not available utd-marking-lines
     4698                  then do:
     4699                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     4700                     vNotMarkForLine = yes.
     4701                  end.
     4702               end.
     4703               block-mark:
     4704               for each utd-marking-lines
     4705                  where utd-marking-lines.db-num  = utd-lines.db-num
     4706                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     4707                    and utd-marking-lines.LineNum = utd-lines.LineNum
     4708               no-lock:
     4709                  vMark = yes.
     4710                  if     isMark(utd-marking-lines.mark)
     4711                     and utd-marking-lines.gds-code  ne 0
     4712                     and utd-marking-lines.gds-code ne ?
     4713                  then do:
     4714                                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4715                           ( utd-marking-lines.gds-code,
     4716                            'mark-type':U,
     4717                            output v-par-val,
     4718                            output v-par-type
     4719                            ).
     4720                      if     not VFileMark
     4721                         and not VUcd
     4722                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     4723                      then do:
     4724                          AddUtdErr(utd.db-num,
     4725                                     utd.doc-id,
     4726                                     buffer utd-marking-lines:handle,
     4727                                     "loadUtd",
     4728                                     "NotON_NSCHFDOPPRMARK",
     4729                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4730                     end.
     4731                  end.
     4732               end.
     4733               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     4734               then do :
     4735                  if     VUcd
     4736                  then do:
     4737                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     4738                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     4739                     if available buf_utddoc-lines
     4740                     then do:
     4741                        vGdsCode = buf_utddoc-lines.gds-code.
     4742                        vunitCode = buf_utddoc-lines.UnitCode.
     4743                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     4744                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4745                        then
     4746                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4747                               "loadUtd",
     4748                               "UcdUnitChangForUtd",
     4749                               string(utd-lines.LineNum )                  + chr(4) +
     4750                               buf_utddoc-lines.UnitCode                   + chr(4) +
     4751                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4752                     end.
     4753                     if     utd-lines.UnitCode ne ?
     4754                        and utd-lines.UnitCode ne ""
     4755                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4756                     then
     4757                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4758                               "loadUtd",
     4759                               "UcdUnitChang",
     4760                               string(utd-lines.LineNum )                  + chr(4) +
     4761                               utd-lines.UnitCode                          + chr(4) +
     4762                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4763                  end.
     4764               end.
     4765               else
     4766                  vGdsCode = utd-lines.gds-code.
     4767               define variable vValText as character no-undo.
     4768               define variable vValDec  as decimal no-undo.
     4769               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     4770               if VValText = ?
     4771               then do:
     4772                  vValDec = utd-lines.Quantity.
     4773                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     4774               end.
     4775               else
     4776                  vValDec = dec(VValText).
     4777               release bar-code .
     4778               if     vGdsCode > 0 and vGdsCode ne ?
     4779               then do:
     4780                  assign
     4781                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     4782                     vunit = ?
     4783                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     4784                  no-error.
     4785                  if vunit ne 0 and vunit ne ?
     4786                  then do:
     4787                     find units where units.OKEI eq vunit no-lock no-error.
     4788                     if available units
     4789                     then
     4790                        vunitCode = units.unit-name.
     4791                  end.
     4792                  find first bar-code where bar-code.gds-code eq vGdsCode
     4793                                        and bar-code.unit-cli eq vUnitCode
     4794                  no-lock no-error.
     4795                  if not available bar-code
     4796                  then
     4797                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4798                               "loadUtd",
     4799                               "Unit",
     4800                               string(utd-lines.LineNum )                  + chr(4) +
     4801                               string(vGdsCode)                            + chr(4) +
     4802                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     4803                               vunitCode).
     4804               end.
     4805               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     4806               then do:
     4807                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4808                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4809                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     4810                  exclusive-lock no-error.
     4811                  if available buf_utd-lines
     4812                  then do:
     4813                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     4814                     release buf_utd-lines.
     4815                  end.
     4816               end.
     4817               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     4818               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     4819               if     not VUcd
     4820                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     4821               then
     4822                  vMarkingUtd = yes .
     4823            end.
     4824            if not VUcd
     4825            then
     4826               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     4827            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     4828                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     4829            no-lock no-error.
     4830            if available ext-classif
     4831            then
     4832               assign
     4833                  vcli-type = ext-classif.CharKey_One
     4834                  vcli-code = ext-classif.Key#_One
     4835               .
     4836            else do:
     4837               assign
     4838                 vcli-type = ?
     4839                 vcli-code = ?
     4840               .
     4841               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     4842            end.
     4843            find first contract  where contract.host-code eq vhost-code
     4844                                   and contract.cli-type  eq vcli-type
     4845                                   and contract.cli-code  eq vcli-code
     4846                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     4847            no-lock no-error.
     4848            define variable VContractEdo as logical no-undo init yes.
     4849            if available contract
     4850            then do:
     4851               assign
     4852                  VContractEdo = contract.whole-send-news > 0
     4853                  vcontract-code = contract.contract-code
     4854               .
     4855               if not VContractEdo
     4856               then
     4857                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     4858            end.
     4859            else do:
     4860               vcontract-code = ?.
     4861            end.
     4862         end.
     4863         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     4864         then do:
     4865            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     4866         end.
     4867         define variable vdoc-code as character no-undo init ?.
     4868         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     4869         then do:
     4870            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     4871                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     4872                                 and utd_ret.Timestamp             le utd.Timestamp
     4873                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4874            no-lock no-error.
     4875            if available utd_ret
     4876            then do:
     4877               vdoc-code = utd_ret.doc-code.
     4878               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     4879            end.
     4880         end.
     4881      end.
     4882      find current utd exclusive-lock no-error.
     4883      if available utd
     4884      then do:
     4885         assign
     4886            utd.cli-type      = vcli-type      when vcli-type      ne ?
     4887            utd.cli-code      = vcli-code      when vcli-type      ne ?
     4888            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     4889            utd.contract-code = vcontract-code when vcontract-code ne ?
     4890            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     4891            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     4892            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     4893         .
     4894         if   ( utd.contract-code eq ?
     4895            or utd.contract-code eq 0)
     4896            and not vucd
     4897         then
     4898            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     4899         if utd.host-code eq ?
     4900            or utd.host-code eq 0
     4901         then
     4902            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     4903         if utd.obj-code eq ?
     4904            or utd.obj-code eq 0
     4905         then
     4906            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     4907      end.
     4908      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     4909      if vError eq ""
     4910      then do:
     4911         if utd.sts eq 0 or utd.sts eq ?
     4912         then
     4913            utd.sts = if VUcd
     4914                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     4915                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4916         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     4917         then do:
     4918            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4919         end.
     4920         if     not VUcd
     4921            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     4922         then do:
     4923            if not vMarkingUtd
     4924            then
     4925               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     4926         end.
     4927      end.
     4928      else do:
     4929         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     4930         then
     4931            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     4932      end.
     4933      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4934         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     4935      then
     4936         utd.sts-edi = ?.
     4937      else if     (not vMark and  not vucd) or not VContractEdo
     4938              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4939      then
     4940         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     4941      release utd no-error.
     4942      if error-status:error
     4943      then
     4944         return error return-value.
     4945      return vError.
     4946   end.
     4947   function ReCheckload returns logical
     4948   (idb-num as integer,
     4949    idoc-id as integer,
     4950    iload   as logical ):
     4951      subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4952      define buffer buf_c-utd for ub.c-utd .
     4953      define buffer buf_utd   for ub.utd .
     4954      find first buf_utd where buf_utd.db-num eq idb-num
     4955                           and buf_utd.doc-id eq idoc-id
     4956      exclusive-lock no-error.
     4957      if available buf_utd
     4958      then do:
     4959         if    iload
     4960            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     4961         then do:
     4962            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     4963            if  error-status:error then
     4964            do:
     4965               message return-value view-as alert-box.
     4966            end.
     4967         end.
     4968         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4969            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4970            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     4971            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     4972         then do:
     4973            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     4974                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     4975                                              buf_c-utd.sts    eq buf_utd.sts and
     4976                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     4977            no-error .
     4978            if available (buf_c-utd)
     4979            then do:
     4980               buf_utd.sts = buf_c-utd.sts .
     4981               buf_utd.sts-edi = buf_c-utd.sts-edi .
     4982            end.
     4983            else do:
     4984               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4985                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4986               then
     4987                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     4988               else
     4989                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     4990               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     4991            end.
     4992         end.
     4993         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     4994         then do:
     4995            run utl/utd-checkSpec.p (input buf_utd.db-num,
     4996                                     input buf_utd.doc-id) .
     4997         end.
     4998      end.
     4999      release buf_utd.
     5000      unsubscribe "getNextseq".
     5001   end.
     5002   function ReCheck returns logical
     5003   (idb-num as integer,
     5004    idoc-id as integer ):
     5005      ReCheckload(idb-num,idoc-id,no).
     5006   end.
     5007   function GetLastUTDForPac returns logical
     5008   (iPackegeId as character ,
     5009    iTimestamp as datetime,
     5010    output odb-num as integer,
     5011    output odoc-id as integer ):
     5012      define buffer buf_utd for utd.
     5013      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     5014                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5015                                and Buf_utd.Timestamp gt iTimestamp
     5016      no-lock no-error.
     5017      if available  buf_utd
     5018      then
     5019         assign
     5020            odb-num = buf_utd.db-num
     5021            odoc-id = buf_utd.doc-id
     5022         no-error.
     5023      else
     5024         assign
     5025            odb-num = ?
     5026            odoc-id = ?
     5027         no-error.
     5028   end.
     5029   function GetprevUTDForPac returns logical
     5030   (iPackegeId as character ,
     5031    iTimestamp as datetime,
     5032    output odb-num as integer,
     5033    output odoc-id as integer ):
     5034      define buffer buf_utd for utd.
     5035      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     5036                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5037                                and Buf_utd.Timestamp < iTimestamp
     5038      no-lock no-error.
     5039      if available  buf_utd
     5040      then
     5041         assign
     5042            odb-num = buf_utd.db-num
     5043            odoc-id = buf_utd.doc-id
     5044         no-error.
     5045      else
     5046         assign
     5047            odb-num = ?
     5048            odoc-id = ?
     5049         no-error.
     5050   end.
     5051   function GetLastUTDinPackAft returns logical
     5052   (input idb-num as integer,
     5053    input idoc-id as integer,
     5054    output odb-num as integer,
     5055    output odoc-id as integer ):
     5056      define buffer buf_utd for utd.
     5057      define buffer     utd for utd.
     5058      find first utd where utd.db-num eq idb-num
     5059                       and utd.doc-id eq idoc-id
     5060      no-lock no-error.
     5061      if available utd
     5062      then do:
     5063         if utd.PackageId eq ""
     5064         then do:
     5065            assign
     5066               odb-num = utd.db-num
     5067               odoc-id = utd.doc-id
     5068            .
     5069            return yes.
     5070         end.
     5071         else do:
     5072            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     5073            if    odb-num eq ?
     5074               or odoc-id eq ?
     5075            then do:
     5076               assign
     5077                  odb-num = utd.db-num
     5078                  odoc-id = utd.doc-id
     5079               .
     5080               return yes.
     5081            end.
     5082            else
     5083               return odoc-id = utd.doc-id.
     5084         end.
     5085      end.
     5086      return ?.
     5087   end.
     5088   function GetLastUTDinPackbef returns logical
     5089   (input idb-num as integer,
