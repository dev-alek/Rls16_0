     1660   function getattrUtdex returns char
     1661   (idb-num   as integer,
     1662    idoc-id   as integer,
     1663    iattrcode as character,
     1664    iExValue  as character  ):
     1665      define buffer utd-attr for utd-attr.
     1666      find first utd-attr where utd-attr.db-num eq idb-num
     1667                            and utd-attr.doc-id eq idoc-id
     1668                            and utd-attr.attr-code eq iattrcode
     1669      no-lock no-error.
     1670      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     1671   end.
     1672   function getattrUtd returns char
     1673   (idb-num   as integer,
     1674    idoc-id   as integer,
     1675    iattrcode as character ):
     1676     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     1677   end.
     1678   function setattrUtd returns logical
     1679   (idb-num   as integer,
     1680    idoc-id   as integer,
     1681    iattrcode as character,
     1682    iattrval  as character ):
     1683      define buffer utd-attr for utd-attr.
     1684      find first utd-attr where utd-attr.db-num eq idb-num
     1685                            and utd-attr.doc-id eq idoc-id
     1686                            and utd-attr.attr-code eq iattrcode
     1687      no-lock no-error.
     1688      if not available utd-attr
     1689      then do:
     1690         create utd-attr.
     1691         assign
     1692            utd-attr.db-num    = idb-num
     1693            utd-attr.doc-id    = idoc-id
     1694            utd-attr.attr-code = iattrcode
     1695            utd-attr.attr-value = iattrval
     1696         .
     1697      end.
     1698      else do:
     1699         if utd-attr.attr-value ne iattrval
     1700         then do:
     1701            find current utd-attr exclusive-lock no-error.
     1702            if available utd-attr
     1703            then
     1704               utd-attr.attr-value = iattrval.
     1705         end.
     1706      end.
     1707      release utd-attr.
     1708   end.
