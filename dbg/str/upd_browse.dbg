     9592   ON CHOOSE OF b_back-check IN FRAME d-utd
     9593      DO:
     9594         if c-status = ObjSrv:Env:Utd:Sts:TH:LoadError:KeyIntDB then
     9595         do:
     9596            c-status = if CheckMarkUtd (p-db-num,p-doc-id)
     9597               then ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB
     9598               else objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     9599         end.
     9600         else if c-status = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB then
     9601            do:
     9602               c-status = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     9603            end.
     9604            else
     9605            do:
     9606               c-status = ObjSrv:Env:Utd:Sts:TH:AwaitingDelivery:KeyIntDB .
     9607            end.
     9608         buf_utd.sts = integer(c-status).
     9609         buf_utd.comment = "" .
     9610         f-comment:screen-value = "" .
     9611         ReCheckload(p-db-num,p-doc-id,no).
     9612         c-status = buf_utd.sts.
     9613         display c-status with frame d-utd .
     9614         display f-info c-status c-status-edi f-comment with frame d-utd .
     9615         run enable_UI in this-procedure .
     9616         run mark-temp (?).
     9617         if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
     9618         disable
     9619            b_recheck
     9620            b_anul
     9621            b_write-cancel
     9622            b_finish
     9623            b_prov-finish
     9624            b_back-check
     9625            b_deliv-cancel
     9626            with frame d-utd .
     9627         run enable_BUTTON in this-procedure .
     9628      END.
     9629   ON CHOOSE OF b_correct IN FRAME d-utd
     9630      DO:
     9631         define variable v-ok            as logical no-undo .
     9632         define variable v-write-correct as logical no-undo init false.
     9633         define buffer cancel_utd-marking-lines for ub.utd-marking-lines .
     9634         define buffer cancel_utd-lines         for x_utd-lines .
     9635         define buffer cancel_marking           for ub.marking .
     9636         block_utd-line:
     9637         for each cancel_utd-lines where cancel_utd-lines.db-num eq p-db-num
     9638            and cancel_utd-lines.doc-id eq p-doc-id
     9639         no-lock:
     9640            if not cancel_utd-lines.isMarking
     9641            then do:
     9642               define variable vqnty as decimal no-undo.
     9643               vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     9644               if vqnty > 0
     9645                  then
     9646               do:
     9647                  v-write-correct = true .
     9648                  leave block_utd-line.
     9649               end.
     9650            end.
     9651            else do:
     9652               for each cancel_utd-marking-lines no-lock where cancel_utd-marking-lines.doc-id = p-doc-id
     9653                                                           and cancel_utd-marking-lines.db-num = p-db-num
     9654                                                           and cancel_utd-marking-lines.sts <> Marking:MarkError:KeyIntDB
     9655                                                           and cancel_utd-marking-lines.sts <> Marking:GrayZone:KeyIntDB:
     9656                  v-write-correct = true .
     9657                  leave block_utd-line.
     9658            end.
     9659            end.
     9660         end.
     9661         if not v-write-correct then
     9662         do:
     9663            message "Все марки УПД не прошли проверку в ГИС МТ, принять товары в соответствии с данным УПД невозможно." skip
     9664                    " И " skip
     9665                    "По всем штрих-кодам УПД не введено колличество принятого товара." skip
     9666               "Нажмите Отказать в поставке"
     9667               view-as alert-box.
     9668         end.
     9669         else
     9670         do:
     9671            run ref/dialog-upd.w (input buf_utd.comment, input buf_utd.db-num, input buf_utd.doc-id, output v-comment, output v-ok) no-error.
     9672            if  error-status:error then
     9673            do:
     9674               return return-value .
     9675            end.
     9676            if v-ok then
     9677            do:
     9678               buf_utd.comment = replace ( buf_utd.comment,chr(6), ", ").
     9679               if buf_utd.comment <> "" then buf_utd.comment = buf_utd.comment + ", " + v-comment .
     9680               else  buf_utd.comment = v-comment .
     9681               f-comment = buf_utd.comment .
     9682               display f-comment with frame d-utd .
     9683               if available (buf_utd) then
     9684               do:
     9685                  if p-connect <> ? then
     9686                  do:
     9687                     run Sendansver( buf_utd.db-num, buf_utd.doc-id, "CorrectionRequest", v-comment) no-error.
     9688                     if  error-status:error then
     9689                     do:
     9690                        message return-value
     9691                             view-as alert-box.
     9692                        return return-value .
     9693                     end.
     9694                  end.
     9695                  else
     9696                     assign
     9697                        buf_utd.sts     = ObjSrv:Env:Utd:Sts:TH:CorrectionRequested:KeyIntDB
     9698                        buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:SignatureAdjustment:KeyIntDB
     9699                        .
     9700                  c-status = buf_utd.sts.
     9701                  c-status-edi = buf_utd.sts-edi.
     9702               end.
     9703               display c-status c-status-edi with frame d-utd .
     9704               run enable_UI in this-procedure .
     9705               disable
     9706                  b_anul
     9707                  b_recheck
     9708                  b_write-cancel
     9709                  b_prov-finish
     9710                  b_finish
     9711                  b_prov-finish
     9712                  b_back-check
     9713                  b_deliv-cancel
     9714                  with frame d-utd .
     9715            end.
     9716         end.
     9717      END.
     9718   ON CHOOSE OF b_anul IN FRAME d-utd
     9719      DO:
     9720         c-status = ObjSrv:Env:Utd:Sts:TH:Canceled:KeyIntDB .
     9721         buf_utd.sts = integer(c-status).
     9722               display f-info c-status c-status-edi f-comment with frame d-utd .
     9723               run enable_UI in this-procedure .
     9724               run mark-temp (?).
     9725                  if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
     9726         disable
     9727            b_recheck
     9728            b_anul
     9729            b_write-cancel
     9730            b_prov-finish
     9731            b_finish
     9732            b_back-check
     9733            b_deliv-cancel
