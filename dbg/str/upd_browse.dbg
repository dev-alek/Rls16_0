     1123   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1124   procedure gen-key-rec :
     1125     define input  parameter p-tbl-name    as character no-undo.
     1126     define input  parameter p-bh_tbl-name as handle    no-undo.
     1127     define output parameter p-key-rec     as character no-undo.
     1128     do
     1129     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1130     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1131     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1132     :
     1133       define variable fh               as handle    no-undo .
     1134       define variable v-ok             as logical   no-undo .
     1135       define variable v-inform         as character no-undo .
     1136       define variable v-ind            as integer   no-undo .
     1137       define variable v-idx-field-qnty as integer   no-undo .
     1138       if p-tbl-name = ?
     1139         or p-tbl-name = "":U
     1140       then do:
     1141         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info9 ).
     1142       end.
     1143       if not p-bh_tbl-name:available then do:
     1144         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info9, p-tbl-name ).
     1145       end.
     1146       assign
     1147         p-key-rec = p-tbl-name
     1148         v-inform  = p-bh_tbl-name:index-information(1)
     1149         v-ind     = 2
     1150       .
     1151       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1152       on error undo, return error
     1153       :
     1154         assign
     1155           v-inform = p-bh_tbl-name:index-information( v-ind )
     1156           v-ind    = v-ind + 1
     1157         .
     1158       end.
     1159       if v-inform = ?
     1160         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1161         or entry( 3, v-inform, ",":U ) <> "1":U
     1162       then do:
     1163         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, p-tbl-name ).
     1164       end.
     1165       else do:
     1166         assign
     1167           v-idx-field-qnty = num-entries( v-inform ) - 4
     1168         .
     1169         if v-idx-field-qnty < 2 then do:
     1170           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, p-tbl-name ).
     1171         end.
     1172         do v-ind = 1 to v-idx-field-qnty by 2
     1173         on error undo, return error
     1174         :
     1175           assign
     1176             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1177             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1178           .
     1179         end.
     1180       end.
     1181       if p-key-rec = ? then do:
     1182         assign
     1183           p-key-rec = "":U
     1184         .
     1185         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info9, p-tbl-name ).
     1186       end.
     1187     end.
     1188     return.
     1189   end procedure.
     1190   procedure gen-where-keyr-tab :
     1191     define input  parameter i-tableSerach as character no-undo.
     1192     define input  parameter i-tablekey   as character  no-undo.
     1193     define input  parameter p-key-rec    as character  no-undo.
     1194     define input  parameter p-key-handle as handle     no-undo .
     1195     define input  parameter p-db-name    as character  no-undo .
     1196     define input  parameter p-tt-handle  as handle     no-undo .
     1197     define output parameter o-Where      as character  no-undo.
     1198     do
     1199     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1200     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1201     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1202     :
     1203       define variable v-full-tbl-name  as character no-undo .
     1204       define variable bh_tbl-name      as handle    no-undo .
     1205       define variable fh_key           as handle    no-undo .
     1206       define variable fh_search        as handle    no-undo .
     1207       define variable v-field-num      as integer   no-undo .
     1208       define variable v-count-fld      as integer   no-undo .
     1209       define variable v-inform         as character no-undo .
     1210       define variable v-ind            as integer   no-undo .
     1211       define variable v-idx-field-qnty as integer   no-undo .
     1212       define variable v-field-name     as character no-undo .
     1213       define variable v-field-val      as character no-undo .
     1214       define variable v-word-link      as character no-undo .
     1215       define variable vTable           as character no-undo.
     1216       define variable bh_tbl-key       as handle    no-undo .
     1217       assign
     1218         p-key-rec = trim( p-key-rec )
     1219       .
     1220       if p-key-handle <> ? then do:
     1221         if not valid-handle(p-key-handle)
     1222            or p-key-handle:type <> "buffer"
     1223         then do:
     1224           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info9 ).
     1225         end.
     1226         if num-entries( p-key-rec, chr(3) ) > 1
     1227           or p-key-rec = ?
     1228           or p-key-rec = "":U
     1229         then do:
     1230           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info9, p-key-rec ).
     1231         end.
     1232       end.
     1233       else do:
     1234         if p-key-rec = ?
     1235           or p-key-rec = "":U
     1236         then do:
     1237           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
     1238         end.
     1239       end.
     1240       assign
     1241         vTable = entry( 1 , p-key-rec, chr(3) )
     1242       .
     1243       if p-tt-handle <> ?
     1244         and ( not valid-handle(p-tt-handle)
     1245               or p-tt-handle:type <> "buffer"
     1246             )
     1247       then do:
     1248         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info9, vTable, chr(10) ).
     1249       end.
     1250       if p-tt-handle = ? then do:
     1251         assign
     1252           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1253         .
     1254         create buffer bh_tbl-name for table v-full-tbl-name .
     1255       end.
     1256       else do:
     1257         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1258       end.
     1259       assign
     1260         v-inform = bh_tbl-name:index-information(1)
     1261         v-ind    = 2
     1262       .
     1263       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1264       on error undo, return error
     1265       :
     1266         assign
     1267           v-inform = bh_tbl-name:index-information( v-ind )
     1268           v-ind    = v-ind + 1
     1269         .
     1270       end.
     1271       if v-inform = ?
     1272         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1273         or entry( 3, v-inform, ",":U ) <> "1":U
     1274       then do:
     1275         delete object bh_tbl-name no-error.
     1276         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info9, vTable ).
     1277       end.
     1278       assign
     1279         v-idx-field-qnty = num-entries( v-inform ) - 4
     1280       .
     1281       if v-idx-field-qnty < 2 then do:
     1282         delete object bh_tbl-name no-error.
     1283         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, vTable ).
     1284       end.
     1285       assign
     1286         o-where     = "where":U
     1287         v-word-link = "":U
     1288         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1289         v-count-fld = 0
     1290       .
     1291       if i-tablekey ne "" and i-tablekey ne ?
     1292       then do:
     1293         assign
     1294           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1295         .
     1296         create buffer bh_tbl-key for table v-full-tbl-name .
     1297       end.
     1298       if i-tableSerach ne "" and i-tableSerach ne ?
     1299       then do:
     1300         delete object bh_tbl-name no-error.
     1301         assign
     1302           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1303         .
     1304         create buffer bh_tbl-name for table v-full-tbl-name .
     1305       end.
     1306       block_where:
     1307       do v-ind = 1 to v-idx-field-qnty by 2
     1308       on error undo, return error
     1309       :
     1310         assign
     1311           v-count-fld = v-count-fld + 1
     1312         .
     1313         if p-key-handle = ?
     1314           and v-count-fld > v-field-num
     1315         then do:
     1316           leave block_where.
     1317         end.
     1318         define variable VfieldKeyTable as handle no-undo.
     1319         assign
     1320           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1321           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1322         .
     1323         if     bh_tbl-key ne ?
     1324         then do:
     1325            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1326            if VfieldKeyTable eq ?
     1327            then next block_where.
     1328         end.
     1329         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1330         then
     1331            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1332         else
     1333            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1334         if p-key-handle = ? then do:
     1335           assign
     1336             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1337           .
     1338         end.
     1339         else do:
     1340           assign
     1341             fh_key = p-key-handle:buffer-field( v-field-name )
     1342           .
     1343           if fh_key = ?
     1344             or not valid-handle( fh_key )
     1345           then do:
     1346             delete object bh_tbl-name.
     1347             if     bh_tbl-key ne ?
     1348             then
     1349                delete object bh_tbl-key.
     1350             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info9, p-key-handle:name, v-field-name ).
     1351           end.
     1352           assign
     1353             v-field-val = fh_key:buffer-value
     1354           .
     1355         end.
     1356         if fh_search:data-type ="character":U then do:
     1357           assign
     1358             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1359             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1360             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1361             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1362             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1363             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1364             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1365             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1366             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1367             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1368             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1369             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1370             v-field-val = substitute( '"&1"', v-field-val )
     1371           .
     1372         end.
     1373         assign
     1374           o-where = substitute( "&1 &2", o-where, v-field-val )
     1375         .
     1376         if v-word-link = "":U then do:
     1377           assign
     1378             v-word-link = "and":U
     1379           .
     1380         end.
     1381       end.
     1382       delete object bh_tbl-name.
     1383       if     bh_tbl-key ne ?
     1384       then
     1385          delete object bh_tbl-key.
     1386       if p-key-handle = ?
     1387         and v-count-fld <> v-field-num
     1388       then do:
     1389         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info9, vTable ).
     1390       end.
     1391     end.
     1392   end procedure.
     1393   procedure gen-hn-keyr-tab :
     1394     define input  parameter i-tableSerach as character no-undo.
     1395     define input  parameter i-tablekey   as character no-undo.
     1396     define input  parameter p-key-rec    as character no-undo.
     1397     define input  parameter p-key-handle as handle    no-undo .
     1398     define input  parameter p-db-name    as character no-undo .
     1399     define input  parameter p-tt-handle  as handle    no-undo .
     1400     define input  parameter p-stts-lock  as integer   no-undo .
     1401     define output parameter o-hn         as handle    no-undo.
     1402     define variable v-full-tbl-name as character no-undo.
     1403     define variable v-where         as character no-undo.
     1404     define variable bh_tbl-name     as handle    no-undo.
     1405     define variable vTable          as character no-undo.
     1406     do
     1407     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1408     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1409     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1410         run gen-where-keyr-tab(i-tableSerach,
     1411                                i-tablekey,
     1412                                p-key-rec,
     1413                                p-key-handle,
     1414                                p-db-name,
     1415                                p-tt-handle,
     1416                                output v-where).
     1417         if i-tableSerach ne "" and i-tableSerach ne ?
     1418         then do:
     1419            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1420            create buffer bh_tbl-name for table v-full-tbl-name .
     1421         end.
     1422         else do:
     1423            if p-tt-handle = ? then do:
     1424               assign
     1425                  vTable = entry( 1 , p-key-rec, chr(3) )
     1426               .
     1427               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1428               create buffer bh_tbl-name for table v-full-tbl-name .
     1429            end.
     1430            else do:
     1431               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1432            end.
     1433         end.
     1434         if p-tt-handle = ? then do:
     1435            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1436         end.
     1437         else do:
     1438            bh_tbl-name:find-first( v-where ) no-error .
     1439         end.
     1440         o-hn = bh_tbl-name.
     1441      end.
     1442   end procedure.
     1443   procedure gen-hn-keyr :
     1444     define input  parameter p-key-rec    as character no-undo.
     1445     define input  parameter p-key-handle as handle    no-undo .
     1446     define input  parameter p-db-name    as character no-undo .
     1447     define input  parameter p-tt-handle  as handle    no-undo .
     1448     define input  parameter p-stts-lock  as integer   no-undo .
     1449     define output parameter o-hn         as handle    no-undo.
     1450     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1451   end.
     1452   procedure gen-row-keyr :
     1453     define input  parameter p-key-rec    as character no-undo.
     1454     define input  parameter p-key-handle as handle    no-undo .
     1455     define input  parameter p-db-name    as character no-undo .
     1456     define input  parameter p-tt-handle  as handle    no-undo .
     1457     define input  parameter p-stts-lock  as integer   no-undo .
     1458     define output parameter p-tbl-row    as rowid     no-undo.
     1459     define output parameter p-tbl-name   as character no-undo.
     1460     define variable vHn as handle no-undo.
     1461       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1462       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1463       p-tbl-name =  vHn:table.
     1464       delete object vHn no-error.
     1465     if p-tbl-row = ? then do:
     1466       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info9, p-tbl-name, p-key-rec ).
     1467     end.
     1468     else do:
     1469       return.
     1470     end.
     1471   end procedure.
     1472   procedure gen-key-fv :
     1473     define input  parameter p-key-rec    as character no-undo .
     1474     define output parameter p-field-list as character no-undo .
     1475     define output parameter p-value-list as character no-undo.
     1476     do
     1477     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1478     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1479     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1480     :
     1481       define variable v-full-tbl-name  as character no-undo .
     1482       define variable bh_tbl-name      as handle    no-undo .
     1483       define variable v-tbl-name       as character no-undo .
     1484       define variable v-field-num      as integer   no-undo .
     1485       define variable v-count-fld      as integer   no-undo .
     1486       define variable v-inform         as character no-undo .
     1487       define variable v-ind            as integer   no-undo .
     1488       define variable v-idx-field-qnty as integer   no-undo .
     1489       define variable v-delim-key      as character no-undo .
     1490       if p-key-rec = ?
     1491         or p-key-rec = "":U
     1492       then do:
     1493         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
     1494       end.
     1495       assign
     1496         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1497         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1498       .
     1499       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1500       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info9 ).
     1501       assign
     1502         v-inform = bh_tbl-name:index-information(1)
     1503         v-ind    = 2
     1504       .
     1505       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1506       on error undo, return error
     1507       :
     1508         assign
     1509           v-inform = bh_tbl-name:index-information( v-ind )
     1510           v-ind    = v-ind + 1
     1511         .
     1512       end.
     1513       if v-inform = ?
     1514         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1515         or entry( 3, v-inform, ",":U ) <> "1":U
     1516       then do:
     1517         delete object bh_tbl-name no-error.
     1518         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
     1519       end.
     1520       assign
     1521         v-idx-field-qnty = num-entries( v-inform ) - 4
     1522       .
     1523       if v-idx-field-qnty < 2 then do:
     1524         delete object bh_tbl-name no-error.
     1525         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
     1526       end.
     1527       assign
     1528         p-field-list = "":U
     1529         p-value-list = "":U
     1530         v-delim-key  = "":U
     1531         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1532         v-count-fld  = 0
     1533       .
     1534       block_where:
     1535       do v-ind = 1 to v-idx-field-qnty by 2
     1536       on error undo, return error
     1537       :
     1538         assign
     1539           v-count-fld = v-count-fld + 1
     1540         .
     1541         if v-count-fld > v-field-num then do:
     1542           leave block_where.
     1543         end.
     1544         assign
     1545           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1546           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1547         .
     1548         if v-ind = 1 then do:
     1549           assign
     1550             v-delim-key = chr(3)
     1551           .
     1552         end.
     1553       end.
     1554       delete object bh_tbl-name.
     1555       if v-count-fld <> v-field-num then do:
     1556         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info9, v-tbl-name ).
     1557       end.
     1558     end.
     1559   end procedure.
     1560   procedure gen-key-field :
     1561     define input  parameter p-table      as character no-undo .
     1562     define output parameter p-field-list as character no-undo .
     1563     do
     1564     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1565     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1566     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1567     :
     1568       define variable v-full-tbl-name  as character no-undo .
     1569       define variable bh_tbl-name      as handle    no-undo .
     1570       define variable v-tbl-name       as character no-undo .
     1571       define variable v-field-num      as integer   no-undo .
     1572       define variable v-count-fld      as integer   no-undo .
     1573       define variable v-inform         as character no-undo .
     1574       define variable v-ind            as integer   no-undo .
     1575       define variable v-idx-field-qnty as integer   no-undo .
     1576       define variable v-delim-key      as character no-undo .
     1577       if p-table = ?
     1578         or p-table = "":U
     1579       then do:
     1580         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info9 ).
     1581       end.
     1582       assign
     1583         v-tbl-name      = p-table
     1584         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1585       .
     1586       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1587       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info9 ).
     1588       assign
     1589         v-inform = bh_tbl-name:index-information(1)
     1590         v-ind    = 2
     1591       .
     1592       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1593       on error undo, return error
     1594       :
     1595         assign
     1596           v-inform = bh_tbl-name:index-information( v-ind )
     1597           v-ind    = v-ind + 1
     1598         .
     1599       end.
     1600       if v-inform = ?
     1601         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1602         or entry( 3, v-inform, ",":U ) <> "1":U
     1603       then do:
     1604         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
     1605       end.
     1606       assign
     1607         v-idx-field-qnty = num-entries( v-inform ) - 4
     1608       .
     1609       if v-idx-field-qnty < 2 then do:
     1610         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
     1611       end.
     1612       assign
     1613         p-field-list = "":U
     1614         v-delim-key  = "":U
     1615         v-count-fld  = 0
     1616       .
     1617       block_where:
     1618       do v-ind = 1 to v-idx-field-qnty by 2
     1619       on error undo, return error
     1620       :
     1621         assign
     1622           v-count-fld = v-count-fld + 1
     1623         .
     1624         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1625         if v-ind = 1 then do:
     1626           assign
     1627             v-delim-key = chr(3)
     1628           .
     1629         end.
     1630       end.
     1631       delete object bh_tbl-name.
     1632     end.
     1633   end procedure.
