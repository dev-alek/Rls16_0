    12771                     b-exit
    12772                     RECT-1
    12773                     c-status-edi
    12774                     f-status-edi
    12775                     in frame d-utd .
    12776                  display
    12777                     FILL-IN-1
    12778                     FILL-IN-2
    12779                     f-obj-code-TH
