      129   define temp-table userobjs_temp-user-obj no-undo
      130     field obj-type as character
      131     field obj-code as integer
      132     index xpk is primary unique obj-type obj-code
      133     .
      134   procedure userobjs_clear :
      135     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      136     do
      137     on error undo, return error return-value
      138     :
      139       for each buf_userobjs_temp-user-obj
      140       on error undo, return error return-value
      141       :
      142         delete buf_userobjs_temp-user-obj .
      143       end.
      144     end.
      145   end .
      146   procedure userobjs_object-count :
      147     define output parameter p-total-count as integer   no-undo .
      148     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      149     do
      150     on error undo, return error return-value
      151     :
      152       assign
      153         p-total-count = 0
      154       .
      155       for each buf_userobjs_temp-user-obj
      156       on error undo, return error return-value
      157       :
      158         assign
      159           p-total-count = p-total-count + 1
      160         .
      161       end.
      162     end.
      163   end.
      164   procedure userobjs_append :
      165      define input  parameter p-obj-type as character no-undo .
      166      define input  parameter p-obj-code as integer   no-undo .
      167     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      168     do
      169     on error undo, return error return-value
      170     :
      171       find first buf_userobjs_temp-user-obj
      172         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      173           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      174         no-error .
      175       if not available buf_userobjs_temp-user-obj
      176       then do:
      177         create buf_userobjs_temp-user-obj .
      178         assign
      179           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      180           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      181         .
      182       end.
      183     end.
      184   end.
      185   procedure userobjs_object-exist :
      186     define output parameter p-object-exist as logical   no-undo .
      187     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      188     do
      189     on error undo, return error return-value
      190     :
      191       find first buf_userobjs_temp-user-obj
      192         no-error .
      193       if not available buf_userobjs_temp-user-obj
      194       then do:
      195         assign
      196           p-object-exist = false
      197         .
      198       end.
      199       else do:
      200         assign
      201           p-object-exist = true
      202         .
      203       end.
      204     end.
      205   end.
      206   procedure userobjs_transfer :
      207     define input  parameter p-callback-handle as handle no-undo .
      208     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      209     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      210     do
      211     on error undo, return error return-value
      212     :
      213       if valid-handle(p-callback-handle) <> true
      214       then do:
      215         message
      216           vss-workfile vss-revision vss-description skip
      217           "Ошибка задания входных параметров" skip
      218           "Неизвестный указатель на процедуру" skip
      219           view-as alert-box error .
      220         undo, return error return-value .
      221       end.
      222       if p-callback-handle :get-signature("userobjs_append") = ""
      223       then do:
      224         message
      225           vss-workfile vss-revision vss-description skip
      226           "Ошибка задания входных параметров" skip
      227           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      228                     ,p-callback-handle :file-name
      229                     ) skip
      230           view-as alert-box error .
      231         undo, return error return-value .
      232       end.
      233       for each buf_userobjs_temp-user-obj
      234       on error undo, return error return-value
      235       :
      236         run userobjs_append in p-callback-handle
      237           (input  buf_userobjs_temp-user-obj.obj-type
      238           ,input  buf_userobjs_temp-user-obj.obj-code
      239           ) .
      240       end.
      241     end.
      242   end procedure.
      243   procedure userobjs_select-one :
