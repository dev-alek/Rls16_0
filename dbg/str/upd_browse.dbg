    12858                     f-supp-name-TH
    12859                     f-supp-type-TH
    12860                     r-contr-TH
    12861                     r-supp-TH
    12862                     RECT-1
    12863                     c-status-edi
    12864                     f-status-edi
    12865                     in frame d-utd .
    12866                  display f-mark with frame d-utd .
    12867                  if f-obj-type-TH <> "" then display r-obj-TH with frame d-utd .
    12868                  else enable r-obj-TH with frame d-utd .
    12869               end.
    12870               if p-type = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
    12871               then
    12872               do:
    12873                     enable v-mark with frame d-utd.
