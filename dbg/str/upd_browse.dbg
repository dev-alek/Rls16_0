    10215                     message return-value
    10216                        view-as alert-box.
    10217                     return return-value .
    10218                  end.
    10219               end.
    10220               else
    10221               do:
    10222                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:RejectionUtd:KeyIntDB.
    10223                  buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:SignatureNotAccepted:KeyIntDB.
    10224               end.
    10225               validate buf_utd no-error.
    10226               assign
    10227                  c-status     = buf_utd.sts
    10228                  c-status-edi = buf_utd.sts-edi
    10229                  .
    10230            end.
    10231         end.
    10232         display c-status c-status-edi with frame d-utd .
    10233         disable
    10234            b_recheck
    10235            b_anul
    10236            b_write-cancel
    10237            b_prov-finish
    10238            b_finish
    10239            b_back-check
    10240            b_deliv-cancel
    10241            with frame d-utd .
