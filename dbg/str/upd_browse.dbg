     9796         disable
     9797            b_recheck
     9798            b_anul
     9799            b_write-cancel
     9800            b_prov-finish
     9801            b_finish
     9802            b_prov-finish
     9803            b_back-check
     9804            b_deliv-cancel
     9805            with frame d-utd .
     9806      END.
     9807   ON CHOOSE OF menu-item m_marks-lines
     9808      DO:
     9809         apply "entry" to br-utd in frame d-utd.
     9810         if available (X_utd-lines) then
     9811         do:
     9812            recid_utd = recid(X_utd-lines) .
     9813            run temp-mark (input 1) .
     9814            if available (tt-marking-lines) then
     9815            do:
     9816               run str/mark_browse.w (input parparentproc,
     9817                  input-output table tt-marking-lines by-reference,
     9818                  input p-mode,
     9819                  input "Марки по: " + EdoTypeName(buf_utd.EDocType) + " " + buf_utd.DocumentNumber + " по товару " + string(X_utd-lines.gds-code) + " " + GdsName(X_utd-lines.gds-code),
     9820                  input type_mark,
     9821                  input ""
     9822                  ) no-error .
     9823   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9824   do:
     9825     br-utd :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     9826   end.
     9827               empty temp-table tt-marking-lines .
     9828               run mark-temp (?).
     9829               if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
     9830               run enable_BUTTON .
     9831               if c-status = ObjSrv:Env:Utd:Sts:TH:AwaitingDelivery:KeyIntDB then
     9832               do:
     9833                  find first X_utd-lines no-lock where X_utd-lines.stts <> "Проверен" no-error .
     9834                  if available (X_utd-lines) then
     9835                  do:
     9836                     F-text = "                      Просканируйте марку/штрих-код" .
     9837                     f-text:screen-value = "" .
     9838                     display F-text with frame d-utd .
     9839                  end.
     9840                  else
     9841                  do:
     9842                     F-text = "" .
     9843                     f-text:screen-value = "" .
     9844                     display F-text with frame d-utd .
     9845                  end.
     9846               end.
     9847            end.
     9848            else
     9849            do:
     9850               message "Нет марок"
     9851                  view-as alert-box.
     9852            end.
     9853            br-utd :refresh() no-error .
     9854            apply "VALUE-CHANGED" to br-utd in frame d-utd.
     9855            apply "entry" to br-utd in frame d-utd.
     9856            reposition br-utd to recid recid_utd no-error .
     9857         end.
     9858         else message "Нет марок"
