    12968      then do :
    12969         define variable brii as integer no-undo .
    12970         do brii = 6 to 14 :
    12971            browse br-utd:GET-BROWSE-COLUMN(brii):VISIBLE = no no-error.
    12972         end .
    12973         browse br-utd:GET-BROWSE-COLUMN(3):label = "GTIN" no-error .
    12974         browse br-utd:GET-BROWSE-COLUMN(5):label = "Количество" no-error .
    12975      end .
    12976      if f-num-2 = "" then
