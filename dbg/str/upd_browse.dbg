     5125   function GetLastUTDinPack returns logical
     5126   (input idb-num as integer,
     5127    input idoc-id as integer,
     5128    output odb-num as integer,
     5129    output odoc-id as integer ):
     5130      define buffer buf_utd for utd.
     5131      define buffer     utd for utd.
     5132      find first utd where utd.db-num eq idb-num
     5133                       and utd.doc-id eq idoc-id
     5134      no-lock no-error.
     5135      if available utd
     5136      then do:
     5137         if utd.PackageId eq ""
     5138         then do:
     5139            assign
     5140               odb-num = utd.db-num
     5141               odoc-id = utd.doc-id
     5142            .
     5143            return yes.
     5144         end.
     5145         else do:
     5146            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     5147            if    odb-num eq ?
     5148               or odoc-id eq ?
     5149            then do:
     5150               assign
     5151                  odb-num = utd.db-num
     5152                  odoc-id = utd.doc-id
     5153               .
     5154               return yes.
     5155            end.
     5156            else
     5157               return odoc-id = utd.doc-id.
     5158         end.
     5159      end.
     5160      return ?.
     5161   end.
     5162   function delMark returns logical
     5163   ( buffer utd-marking-lines for utd-marking-lines ):
     5164      define buffer buf_utd-marking-line for utd-marking-lines.
     5165      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     5166         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     5167                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     5168                                           and buf_utd-marking-line.mark      eq marking.mark
     5169         no-lock no-error.
     5170         if available  buf_utd-marking-line
     5171         then do:
     5172            delMark(buffer buf_utd-marking-line).
     5173            delete buf_utd-marking-line.
     5174         end.
     5175      end.
     5176   end.
     5177   function addMark returns logical
     5178   ( buffer utd-marking-lines for utd-marking-lines ):
     5179      define buffer buf_utd-marking-line for utd-marking-lines.
     5180      define buffer par_utd-marking-line for utd-marking-lines.
     5181      define buffer buf_utd for ub.utd .
     5182      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     5183         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     5184                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     5185                                           and buf_utd-marking-line.mark      eq marking.mark
     5186         no-lock no-error.
     5187         if available  buf_utd-marking-line
     5188         then do:
     5189            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     5190            then do:
     5191               find current  buf_utd-marking-line exclusive-lock no-error.
     5192               if available buf_utd-marking-line
     5193               then
     5194                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     5195            end.
     5196         end.
     5197         else do:
     5198            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     5199                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     5200                                         no-error .
     5201            create buf_utd-marking-line.
     5202            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     5203            assign
     5204               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     5205               buf_utd-marking-line.mark      = marking.mark
     5206               buf_utd-marking-line.gds-code  = marking.Gds-code
     5207               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     5208                                               then marking.sts
     5209                                               else
     5210                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     5211                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     5212                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     5213                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     5214                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     5215                                                else marking.sts
     5216            .
     5217            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     5218            do:
     5219              for first par_utd-marking-line no-lock where
     5220                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     5221                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     5222                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     5223                    and par_utd-marking-line.mark    = marking.mark-parent
     5224                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     5225              :
     5226                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     5227              end.
     5228            end.
     5229         end.
     5230         addMark(buffer buf_utd-marking-line).
     5231      end.
     5232   end.
     5233   function UnLockUTDMarkbuf returns logical
     5234   (buffer old_utd for utd,
     5235    iAll as logical ):
     5236      define variable voldkey    as character no-undo.
     5237         run gen-key-rec (input "utd",
     5238                          input  buffer old_utd:handle,
     5239                          output voldkey).
     5240      for each marking where marking.loc-key eq voldkey
     5241      exclusive-lock:
     5242         if    iAll
     5243            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     5244                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     5245         then do:
     5246            marking.loc-key = "".
     5247            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     5248         end.
     5249      end.
     5250   end.
     5251   function UnLockUTDMark returns logical
     5252   (idb-num as integer ,idoc-id as integer ,iall as logical):
     5253      define buffer old_utd for utd.
     5254      find first old_utd where old_utd.db-num eq idb-num
     5255                           and old_utd.db-num eq idoc-id
     5256      no-lock no-error.
     5257      if available old_utd
     5258      then do:
     5259         UnLockUTDMarkbuf(buffer old_utd,iall).
     5260      end.
     5261   end.
     5262   function changSts returns logical
     5263   (idb-num as integer ,
     5264    idoc-id as integer ,
     5265    old_sts_edo as character ,
     5266    new_sts_edo as character  ):
     5267      if     old_sts_edo ne new_sts_edo
     5268         and ( new_sts_edo eq "RevocationAccepted"
     5269              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     5270              )
     5271      then
     5272         UnLockUTDMark(idb-num,idoc-id,yes).
     5273      if     old_sts_edo ne new_sts_edo
     5274         and ( new_sts_edo eq "WithRecipientSignature"
     5275           or  new_sts_edo eq "WithRecipientPartiallySignature"
     5276              )
     5277      then
     5278         UnLockUTDMark(idb-num,idoc-id,no).
     5279   end.
     5280   function SetLockUTDMark returns logical
     5281   (idb-num as integer ,idoc-id as integer ):
     5282      define buffer new_utd for utd.
     5283      define buffer old_utd for utd.
     5284      define variable volddb-num as integer no-undo.
     5285      define variable volddoc-id as integer no-undo.
     5286      define variable voldkey    as character no-undo.
     5287      define variable vnewkey    as character no-undo.
     5288      find first new_utd where new_utd.db-num eq idb-num
     5289                           and new_utd.doc-id eq idoc-id
     5290      no-lock no-error.
     5291      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     5292      then do trans:
     5293         find first old_utd where old_utd.db-num eq volddb-num
     5294                              and old_utd.doc-id eq volddoc-id
     5295         no-lock no-error.
     5296            run gen-key-rec (input "utd",
     5297                             input  buffer new_utd:handle,
     5298                             output vnewkey).
     5299            run gen-key-rec (input "utd",
     5300                             input  buffer old_utd:handle,
     5301                             output voldkey).
     5302         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     5303                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     5304         no-lock:
     5305            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     5306            if available  marking
     5307            then do:
     5308               if    marking.loc-key eq ""
     5309                  or marking.loc-key eq ?
     5310                  or marking.loc-key eq voldkey
     5311               then do:
     5312                  find current marking exclusive-lock no-error.
     5313                  if available marking
     5314                  then do:
     5315                     marking.loc-key = vnewkey.
     5316                     release marking.
     5317                  end.
     5318               end.
     5319               else if marking.loc-key ne vnewkey
     5320               then do:
     5321                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     5322               end.
     5323            end.
     5324         end.
     5325         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     5326      end.
     5327   end.
     5328   function CheckedocMark return logical
     5329   (input idb-numorig as integer,
     5330    input idoc-idorig as integer,
     5331    input idb-numedoc as integer,
     5332    input idoc-idedoc as integer  ):
     5333       define variable VChekOk    as logical   no-undo init yes.
     5334       define variable vMarkUtd   as logical   no-undo.
     5335       define variable v-par-type as character no-undo.
     5336       define variable v-par-val  as character no-undo.
     5337       define buffer buf_utd-attr      for utd-attr.
     5338       define buffer buf_utd           for utd.
     5339       define buffer utd-marking-lines for utd-marking-lines.
     5340       define buffer utd-lines         for utd-lines.
     5341       define buffer marking           for marking.
     5342       define buffer edoc-lines        for utd-lines.
     5343          for each utd-marking-lines where utd-marking-lines.db-num    eq idb-numorig
     5344                                       and utd-marking-lines.doc-id    eq idoc-idorig
     5345                                       and utd-marking-lines.doc-level eq 1
     5346                                       and utd-marking-lines.sts       eq objSrv:Env:marking:Sts:Mark:Checked_:KeyIntDB
     5347          no-lock:
     5348             if    isMark (utd-marking-lines.mark)
     5349             then do:
     5350                create tt-utd-mark.
     5351                buffer-copy utd-marking-lines to tt-utd-mark
     5352                assign
     5353                   tt-utd-mark.side = "+"
     5354                .
     5355             end.
     5356          end.
     5357          for each utd-marking-lines where utd-marking-lines.db-num eq idb-numedoc
     5358                                       and utd-marking-lines.doc-id eq idoc-idedoc
     5359                                       and utd-marking-lines.doc-level eq 1
     5360          no-lock:
     5361             if    isMark (utd-marking-lines.mark)
     5362             then do:
     5363                find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     5364                no-lock no-error.
     5365                if available tt-utd-mark
     5366                then
     5367                   tt-utd-mark.side = "".
     5368                else do:
     5369                   create tt-utd-mark.
     5370                   buffer-copy utd-marking-lines to tt-utd-mark
     5371                   assign
     5372                      tt-utd-mark.side = "-"
     5373                   .
     5374                end.
     5375             end.
     5376          end.
     5377          for each tt-utd-mark where  tt-utd-mark.side ne ""
     5378          no-lock:
     5379             AddUtdErrForTab(idb-numedoc, idoc-idedoc, "utd-marking-lines", buffer tt-utd-mark:handle, "edoc", "MarkOrig" + tt-utd-mark.side, tt-utd-mark.mark).
     5380             VChekOk = no.
     5381          end.
     5382          for each utd-lines where utd-lines.db-num    eq idb-numorig
     5383                               and utd-lines.doc-id    eq idoc-idorig
     5384          no-lock:
     5385             find first edoc-lines where edoc-lines.db-num eq idb-numedoc
     5386                                     and edoc-lines.doc-id eq idoc-idedoc
     5387                                     and edoc-lines.LineNum eq utd-lines.LineNum
     5388             no-lock no-error.
     5389             define variable VUtdlinequentity as decimal no-undo.
     5390             VUtdlinequentity = dec (getattrutdlinesex(utd-lines.db-num ,utd-lines.doc-id,utd-lines.LineNum,"QuantityBarCode","0")).
     5391             if     VUtdlinequentity eq ?
     5392                or (if available edoc-lines then edoc-lines.Quantity else 0) ne VUtdlinequentity
     5393             then
     5394                AddUtdErr(idb-numedoc, idoc-idedoc,buffer edoc-lines:handle,"edoc","lineQnty",string(edoc-lines.LineNum ) + chr(4) + string(VUtdlinequentity) + chr(4) + string(edoc-lines.Quantity ) ).
     5395          end.
     5396       for each tt-utd-mark:
     5397          delete tt-utd-mark.
     5398       end.
     5399   end.
     5400   function CheckEdoc returns character
     5401   (idb-numOrig as integer ,
     5402    idoc-idOrig as integer,
     5403    idb-num as integer ,
     5404    idoc-id as integer ):
     5405      define buffer utd  for ub.utd.
     5406      define buffer utd-lines  for ub.utd-lines.
     5407      define buffer utd-marking-lines  for ub.utd-marking-lines.
     5408      define buffer edoc-lines for ub.utd-lines.
     5409      define variable vSts as integer no-undo.
     5410      define variable vMarkutd as logical no-undo.
     5411      vSts = objSrv:Env:utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     5412      Block-line:
     5413      for each utd-lines where utd-lines.db-num eq idb-num
     5414                           and utd-lines.doc-id eq idoc-id
     5415      exclusive-lock:
     5416         define variable ismarkin as logical no-undo.
     5417         define variable isOAD as logical no-undo.
     5418         define variable isper as logical no-undo.
     5419         getMarkUtdLine(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,
     5420              output ismarkin, output isOAD, output isper).
     5421         if    utd-lines.Price                eq 0
     5422            or utd-lines.Total                eq 0
     5423            or utd-lines.TotalWithVatExcluded eq 0
     5424            or utd-lines.Quantity             eq 0
     5425         then do:
     5426            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     5427                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     5428                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     5429            no-lock:
     5430               if    isMark(utd-marking-lines.mark)
     5431                  or isOad(utd-marking-lines.mark)
     5432               then do:
     5433                  AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Amount" , string(utd-lines.LineNum )).
     5434                  next Block-line.
     5435               end.
     5436            end.
     5437            delete utd-lines.
     5438         end.
     5439         else if   ( utd-lines.Total                ne 0
     5440                 or utd-lines.Quantity             ne 0)
     5441                 and ismarkin or isOAD
     5442         then do:
     5443            Block-mark:
     5444            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     5445                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     5446                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     5447            no-lock:
     5448               if  (isOAD and
     5449                     isMark(utd-marking-lines.mark)
     5450                  or isOad(utd-marking-lines.mark) )
     5451                  or (ismarkin and
     5452                     isMark(utd-marking-lines.mark))
     5453               then do:
     5454                  leave Block-mark.
     5455               end.
     5456            end.
     5457            if not available utd-marking-lines
     5458            then
     5459               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Mark" ,string(utd-lines.LineNum)).
     5460         end.
     5461      end.
     5462      for each utd-lines where utd-lines.db-num eq idb-numOrig
     5463                           and utd-lines.doc-id eq idoc-idOrig
     5464      no-lock:
     5465         find first edoc-lines where edoc-lines.db-num eq idb-num
     5466                                 and edoc-lines.doc-id eq idoc-id
     5467                                 and edoc-lines.LineNum eq utd-lines.LineNum
     5468         no-lock no-error.
     5469         if     available edoc-lines
     5470         then do:
     5471            if edoc-lines.Quantity ne 0
     5472            then do:
     5473               if edoc-lines.Price ne utd-lines.Price
     5474               then
     5475                  AddUtdErr(edoc-lines.db-num,edoc-lines.doc-id,buffer edoc-lines:handle,"Edoc","Price" ,string(edoc-lines.LineNum)).
     5476            end.
     5477         end.
     5478         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     5479         CheckedocMark(idb-numOrig , idoc-idOrig , idb-num , idoc-id).
     5480      end.
     5481      define variable vError as character no-undo.
     5482      vError = GetErrForUtdstr(idb-num , idoc-id ,"edoc").
     5483      if vError ne ""
     5484      then
     5485         vSts = objSrv:Env:utd:Sts:th:edocError:KeyIntDB.
     5486      else
     5487         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     5488      find first utd where utd.db-num eq idb-num
     5489                       and utd.doc-id eq idoc-id
     5490      exclusive-lock no-error.
     5491      if available utd
     5492      then do:
     5493         utd.sts = vsts.
     5494      end.
     5495   end.
     5496   function CrEdoc returns character
     5497   (iPack as character ,
     5498    iTimestamp as datetime):
     5499      define variable vdb-num as integer no-undo.
     5500      define variable vdoc-id as integer no-undo.
     5501      define buffer utd  for ub.utd.
     5502      define buffer edoc for ub.utd.
     5503      define buffer utd_ret   for ub.utd.
     5504      define buffer utd-attr  for ub.utd-attr.
     5505      define buffer edoc-attr for ub.utd-attr.
     5506      define buffer utd-lines  for ub.utd-lines.
     5507      define buffer edoc-lines for ub.utd-lines.
     5508      define buffer utd-lines-attr  for ub.utd-lines-attr.
     5509      define buffer edoc-lines-attr for ub.utd-lines-attr.
     5510      define buffer utd-marking-lines  for ub.utd-marking-lines.
     5511      define buffer edoc-marking-lines for ub.utd-marking-lines.
     5512      define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     5513      define buffer edoc-marking-lines-attr for ub.utd-marking-lines-attr.
     5514      define variable vTimestamp  as datetime no-undo.
     5515      find last utd where utd.PackageId eq iPack
     5516                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5517                      and utd.Timestamp ge iTimestamp
     5518      no-lock no-error.
     5519      if available utd
     5520      then
     5521         return "Есть документ позже".
     5522      find last utd where utd.PackageId eq iPack
     5523                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     5524                      and utd.Timestamp le iTimestamp
     5525      no-lock no-error.
     5526      if not available utd
     5527      then
     5528         return "Не найден УКД".
     5529      define variable vdb-numOrig as integer no-undo.
     5530      define variable vdoc-idOrig as integer no-undo.
     5531      find last utd where utd.PackageId eq iPack
     5532                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5533                      and utd.Timestamp le iTimestamp
     5534      no-lock no-error.
     5535      if available utd
     5536      then do:
     5537         subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     5538         MySeqUtd = ?.
     5539         vTimestamp = utd.Timestamp.
     5540         create edoc.
     5541         vdb-num = utd.db-num.
     5542         vdoc-id = utd.doc-id.
     5543         buffer-copy utd except doc-id db-num DocumentExt OrganizationExt comment to edoc
     5544         assign
     5545            edoc.EDocType = objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5546            edoc.Timestamp = iTimestamp + 1
     5547            edoc.AmendmentRequested = no
     5548            edoc.sts-edi  = objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     5549         .
     5550         validate edoc.
     5551         for each utd-attr where utd-attr.db-num eq vdb-num
     5552                             and utd-attr.doc-id eq vdoc-id
     5553                             and utd-attr.attr-code ne "ststhbeforeCorrection"
     5554                             and utd-attr.attr-code ne "sendcode"
     5555         no-lock:
     5556            create edoc-attr.
     5557            buffer-copy utd-attr except doc-id db-num to edoc-attr
     5558            assign
     5559               edoc-attr.db-num = edoc.db-num
     5560               edoc-attr.doc-id = edoc.doc-id
     5561            .
     5562         end.
     5563         for each utd-lines where utd-lines.db-num eq vdb-num
     5564                              and utd-lines.doc-id eq vdoc-id
     5565         no-lock:
     5566            create edoc-lines.
     5567            buffer-copy utd-lines except doc-id db-num to edoc-lines
     5568            assign
     5569               edoc-lines.db-num = edoc.db-num
     5570               edoc-lines.doc-id = edoc.doc-id
     5571            .
     5572            release edoc-lines.
     5573         end.
     5574         for each utd-lines-attr where utd-lines-attr.db-num eq vdb-num
     5575                                   and utd-lines-attr.doc-id eq vdoc-id
     5576         no-lock:
     5577            create edoc-lines-attr.
     5578            buffer-copy utd-lines-attr except doc-id db-num to edoc-lines-attr
     5579            assign
     5580               edoc-lines-attr.db-num = edoc.db-num
     5581               edoc-lines-attr.doc-id = edoc.doc-id
     5582            .
     5583         end.
     5584         for each utd-marking-lines where utd-marking-lines.db-num eq vdb-num
     5585                                      and utd-marking-lines.doc-id eq vdoc-id
     5586                                      and utd-marking-lines.doc-level eq 1
     5587         no-lock:
     5588            create edoc-marking-lines.
     5589            buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     5590            assign
     5591               edoc-marking-lines.db-num = edoc.db-num
     5592               edoc-marking-lines.doc-id = edoc.doc-id
     5593            .
     5594         end.
     5595         for each utd-marking-lines-attr where utd-marking-lines-attr.db-num eq vdb-num
     5596                                           and utd-marking-lines-attr.doc-id eq vdoc-id
     5597         no-lock:
     5598            if utd-marking-lines-attr.attr-code eq "box-qnty"
     5599            then do:
     5600                find first edoc-marking-lines-attr  where edoc-marking-lines-attr.db-num    eq utd-marking-lines-attr.db-num
     5601                                                      and edoc-marking-lines-attr.doc-id    eq utd-marking-lines-attr.doc-id
     5602                                                      and edoc-marking-lines-attr.LineNum   eq utd-marking-lines-attr.LineNum
     5603                                                      and edoc-marking-lines-attr.mark      eq utd-marking-lines-attr.mark
     5604                                                      and edoc-marking-lines-attr.attr-code eq utd-marking-lines-attr.attr-code
     5605                no-lock no-error.
     5606            end.
     5607            if not avail edoc-marking-lines-attr
     5608            then do:
     5609                create edoc-marking-lines-attr.
     5610                buffer-copy utd-marking-lines-attr except doc-id db-num to edoc-marking-lines-attr
     5611                assign
     5612                   edoc-marking-lines-attr.db-num = vdb-num
     5613                   edoc-marking-lines-attr.doc-id = vdoc-id
     5614                .
     5615            end.
     5616            release edoc-marking-lines-attr.
     5617         end.
     5618         for each utd where utd.PackageId eq iPack
     5619                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     5620                        and utd.Timestamp gt vTimestamp
     5621                        and utd.Timestamp le iTimestamp
     5622                        and (    utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     5623                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB
     5624                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB
     5625                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientPartiallySignature:KeyIntDB
     5626                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     5627                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     5628         no-lock by utd.PackageId by utd.EDocType by utd.Timestamp:
     5629            edoc.Total = edoc.Total + utd.total.
     5630            edoc.Vat = edoc.Vat + utd.Vat.
     5631            edoc.DocumentDate = utd.DocumentDate.
     5632            edoc.Timestamp = utd.Timestamp + 1.
     5633            for each utd-lines where utd-lines.db-num     = utd.db-num
     5634                                 and utd-lines.doc-id     = utd.doc-id
     5635            no-lock:
     5636               block-mark:
     5637               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     5638                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     5639                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     5640                                            and utd-marking-lines.site eq "-"
     5641                                            no-lock:
     5642                  if isOAD(utd-marking-lines.mark)
     5643                  then do:
     5644                     define variable VOAD as character no-undo.
     5645                     VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5646                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5647                                                  and edoc-marking-lines.doc-id eq edoc.doc-id
     5648                                                  and edoc-marking-lines.mark   begins VOAD
     5649                     no-lock no-error.
     5650                  end.
     5651                  else
     5652                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5653                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     5654                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5655                        no-lock no-error.
     5656                  if available edoc-marking-lines
     5657                  then do:
     5658                     find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     5659                                       and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     5660                                       and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     5661                     exclusive-lock no-error.
     5662                     leave block-mark.
     5663                  end.
     5664               end.
     5665               if not available edoc-lines
     5666               then
     5667                  find first edoc-lines where edoc-lines.db-num      = edoc.db-num
     5668                                          and edoc-lines.doc-id      = edoc.doc-id
     5669                                          and edoc-lines.ProductCode = utd-lines.ProductCode
     5670                  exclusive-lock no-error.
     5671               if not available edoc-lines
     5672               then do:
     5673                  find last edoc-lines where edoc-lines.db-num      = edoc.db-num
     5674                                         and edoc-lines.doc-id      = edoc.doc-id
     5675                  no-lock no-error.
     5676                  define variable vline as integer no-undo.
     5677                  vline = if available edoc-lines then edoc-lines.linenum + 1 else 1.
     5678                  create edoc-lines.
     5679                  buffer-copy utd-lines except doc-id db-num linenum to edoc-lines
     5680                  assign
     5681                     edoc-lines.db-num = edoc.db-num
     5682                     edoc-lines.doc-id = edoc.doc-id
     5683                     edoc-lines.linenum = vline
     5684                  .
     5685               end.
     5686               else
     5687                  assign
     5688                     edoc-lines.Vat       = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Vat_old") )       + utd-lines.Vat
     5689                     edoc-lines.Total     = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Total_old") )     + utd-lines.Total
     5690                     edoc-lines.Quantity  = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity_old_new") )  + utd-lines.Quantity.
     5691                     edoc-lines.TotalWithVatExcluded = edoc-lines.Total - edoc-lines.Vat.
     5692                  .
     5693               define variable Vqnty as decimal no-undo.
     5694               Vqnty = dec(getattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity") )
     5695                     + dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity") ).
     5696               setattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity",string(vqnty)).
     5697               if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     5698                  and edoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     5699               then
     5700                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     5701                      "loadUtd",
     5702                      "UcdUnitChangForUtd",
     5703                      string(edoc-lines.LineNum )                  + chr(4) +
     5704                      edoc-lines.UnitCode                   + chr(4) +
     5705                      getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     5706               if     utd-lines.UnitCode ne ?
     5707                  and utd-lines.UnitCode ne ""
     5708                  and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     5709               then
     5710                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     5711                         "loadUtd",
     5712                         "UcdUnitChang",
     5713                         string(edoc-lines.LineNum )                  + chr(4) +
     5714                         utd-lines.UnitCode                          + chr(4) +
     5715                         getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     5716               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     5717                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     5718                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     5719               no-lock by utd-marking-lines.site by utd-marking-lines.doc-level desc:
     5720                  if utd-marking-lines.site eq "-"
     5721                  then do:
     5722                     if isOAD(utd-marking-lines.mark)
     5723                     then do:
     5724                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5725                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5726                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5727                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5728                        exclusive-lock no-error.
     5729                        if not available edoc-marking-lines
     5730                        then
     5731                           find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5732                                                        and edoc-marking-lines.doc-id eq edoc.doc-id
     5733                                                        and edoc-marking-lines.mark   begins VOAD
     5734                           exclusive-lock no-error.
     5735                        if not available edoc-marking-lines
     5736                        then
     5737                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5738                        else do:
     5739                           define variable v37tegdoc as character no-undo.
     5740                           define variable v37tegedoc as character no-undo.
     5741                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     5742                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     5743                           vqnty = int(v37tegedoc) - int(v37tegdoc) no-error.
     5744                           if error-status:error
     5745                           then
     5746                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     5747                              view-as alert-box.
     5748                           else if vqnty = 0
     5749                           then
     5750                              delete edoc-marking-lines.
     5751                           else do:
     5752                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     5753                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5754                                             edoc-marking-lines.doc-id,
     5755                                             edoc-marking-lines.LineNum,
     5756                                             edoc-marking-lines.mark,
     5757                                             "box-qnty",
     5758                                              string(vQnty)).
     5759                           end.
     5760                        end.
     5761                     end.
     5762                     else do:
     5763                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5764                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5765                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5766                        exclusive-lock no-error.
     5767                        if available edoc-marking-lines
     5768                        then
     5769                           delete edoc-marking-lines.
     5770                        else
     5771                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5772                     end.
     5773                  end.
     5774                  else if utd-marking-lines.site eq "+"
     5775                  then do:
     5776                     if isOAD(utd-marking-lines.mark)
     5777                     then do:
     5778                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5779                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5780                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     5781                                                     and edoc-marking-lines.mark   begins VOAD
     5782                        exclusive-lock no-error.
     5783                        if available edoc-marking-lines
     5784                        then do:
     5785                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     5786                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     5787                           vqnty = int(v37tegedoc) + int(v37tegdoc) no-error.
     5788                           if error-status:error
     5789                           then
     5790                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     5791                              view-as alert-box.
     5792                           else if vqnty = 0
     5793                           then
     5794                              delete edoc-marking-lines.
     5795                           else do:
     5796                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     5797                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5798                                             edoc-marking-lines.doc-id,
     5799                                             edoc-marking-lines.LineNum,
     5800                                             edoc-marking-lines.mark,
     5801                                             "box-qnty",
     5802                                              string(vQnty)).
     5803                           end.
     5804                        end.
     5805                        else do:
     5806                           create edoc-marking-lines.
     5807                           buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     5808                           assign
     5809                              edoc-marking-lines.db-num = edoc.db-num
     5810                              edoc-marking-lines.doc-id = edoc.doc-id
     5811                           .
     5812                           setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5813                                             edoc-marking-lines.doc-id,
     5814                                             edoc-marking-lines.LineNum,
     5815                                             edoc-marking-lines.mark,
     5816                                             "box-qnty",
     5817                                              string(int(GetTegCod(edoc-marking-lines.mark,"37")))) no-error.
     5818                        end.
     5819                     end.
     5820                     else do:
     5821                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5822                                                     and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5823                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5824                     no-lock no-error.
     5825                     if not available edoc-marking-lines
     5826                     then do:
     5827                        create edoc-marking-lines.
     5828                        buffer-copy utd-marking-lines except doc-id db-num linenum to edoc-marking-lines
     5829                        assign
     5830                           edoc-marking-lines.db-num  = edoc-lines.db-num
     5831                           edoc-marking-lines.doc-id  = edoc-lines.doc-id
     5832                           edoc-marking-lines.linenum = edoc-lines.linenum
     5833                        .
     5834                     end.
     5835                     else
     5836                        AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"Edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5837                  end.
     5838               end.
     5839               release edoc-lines.
     5840            end.
     5841            release edoc-lines.
     5842         end.
     5843         find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     5844                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     5845                                 and utd_ret.Timestamp             le utd.Timestamp
     5846                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     5847            no-lock no-error.
     5848         if not avail utd_ret
     5849         then
     5850            CheckEdoc (vdb-num,vdoc-id,edoc.db-num,edoc.doc-id) .
     5851      end.
     5852      for each utd where utd.PackageId eq iPack
     5853                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5854                        and utd.Timestamp < iTimestamp
     5855         exclusive-lock:
     5856            utd.sts-edi = objSrv:Env:Utd:sts:edi:Changed:KeyIntDB.
     5857            utd.sts     = objSrv:Env:Utd:sts:th:Rejection:KeyIntDB.
     5858         end.
     5859         unsubscribe "getNextseq".
     5860      end.
     5861   end.
     5862   define variable Mext-sys as integer no-undo init ?.
     5863   define variable mdb-num-local as integer no-undo.
     5864   run gbl/getdbnum.p (output mdb-num-local).
     5865   function  getExtSys returns integer
     5866   ():
     5867      define buffer ext-system      for ext-system.
     5868      define buffer ext-system-attr for ext-system-attr.
     5869      Mext-sys = ?.
     5870      block-sys-obj:
     5871      for each ext-system where ext-system.esys-type eq 12
     5872                            and ext-system.db-num    eq mdb-num-local
     5873      no-lock:
     5874          find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     5875                                       and ext-system-attr.esys-id eq ext-system.esys-id
     5876                                       and ext-system-attr.esya-attr-code eq 'obj':U
     5877          no-lock no-error.
     5878          if     available ext-system-attr
     5879             and           ext-system-attr.esya-attr-value eq v-cntxt-obj-type + string(v-cntxt-obj-code)
     5880          then do:
     5881             Mext-sys = ext-system-attr.esys-id.
     5882             leave block-sys-obj.
     5883          end.
     5884      end.
     5885      if Mext-sys eq ?
     5886      then do:
     5887         block-sys-host:
     5888         for each ext-system where ext-system.esys-type eq 12
     5889                               and ext-system.db-num    eq mdb-num-local
     5890         no-lock:
     5891             find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     5892                                          and ext-system-attr.esys-id eq ext-system.esys-id
     5893                                          and ext-system-attr.esya-attr-code eq 'host-code':U
     5894             no-lock no-error.
     5895             if     available ext-system-attr
     5896                and           ext-system-attr.esya-attr-value eq string(v-cntxt-host-code-obj)
     5897             then do:
     5898                Mext-sys = ext-system-attr.esys-id.
     5899                leave block-sys-host.
     5900             end.
     5901         end.
     5902      end.
     5903      return Mext-sys.
     5904   end.
     5905   function  getExtAttr returns character
     5906   (input icode as character ):
     5907      define variable oValue as character no-undo.
     5908      define variable vtype as character no-undo.
     5909      define buffer ext-system for ext-system.
     5910      get-key-value section "ProxyServ" key icode value oValue.
     5911      if oValue eq ?
     5912      then do:
     5913         if Mext-sys eq ?
     5914         then
     5915            getExtSys ().
     5916         find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     5917                                         and ext-system.esys-id eq Mext-sys no-error.
     5918         if available ext-system
     5919         then do:
     5920                if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-value in g#attr-lib
     5921            (ext-system.esys-id,
     5922             mdb-num-local,
     5923             icode,
     5924             output oValue,
     5925             output vtype) no-error.
     5926          end.
     5927      end.
     5928      return if oValue eq ? then "" else oValue .
     5929   end.
     5930   function  SetExtAttr returns character
     5931   (input icode   as character,
     5932    input iValue  as character):
     5933      define variable vtype as character no-undo.
     5934      define buffer ext-system for ext-system.
     5935      if Mext-sys eq ?
     5936      then
     5937         getExtSys ().
     5938      find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     5939                                      and ext-system.esys-id eq Mext-sys no-error.
     5940      if available ext-system
     5941      then do:
     5942          if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-write in g#attr-lib
     5943         (ext-system.esys-id,
     5944          mdb-num-local,
     5945          icode,
     5946          iValue) no-error.
     5947       end.
     5948   end.
     5949   define stream File-stream.
     5950   function PutMes returns character
     5951   (idext as character ):
     5952      if valid-handle(mPublishHand)
     5953      then
     5954         publish "WriteLogAsunc" from mPublishHand (idext,yes).
     5955      else do:
     5956         if idext begins "error"
     5957         then do:
     5958            message substring (idext,6)
     5959               view-as alert-box.
     5960            if mDiadocApi ne ?
     5961            then
     5962               idext = substitute ("&1 (&2)",idext , mDiadocApi:GetFullVersion())no-error.
     5963         end.
     5964         output stream File-stream to "diadoc_user.log" append.
     5965         put stream File-stream unformatted now " " idext skip.
     5966         output stream File-stream close.
     5967      end.
     5968   end.
     5969   function PutErr returns character
     5970   (idext as character ):
     5971      define variable vi as integer no-undo.
     5972      define variable vnumerr as integer no-undo.
     5973      define variable vtext as character extent 25 no-undo .
     5974      if error-status:num-messages > 0 then do:
     5975         vnumerr = error-status:num-messages.
     5976         vnumerr = min(vnumerr,extent(vtext)).
     5977         do vi = 1 to vnumerr:
     5978            vtext[vi] = error-status:get-message(vi).
     5979         end.
     5980         idext = idext + chr(10) + "Ошибка: [":U.
     5981         do vi = 1 to vnumerr:
     5982            idext = idext + chr(10) + vtext[vi] no-error.
     5983         end.
     5984         idext = idext +  chr(10) +  " ]" no-error.
     5985         if not  idext begins "Error"
     5986         then
     5987            idext = "Error " + idext.
     5988         PutMes(idext).
     5989      end.
     5990   end.
     5991   function PutStat returns character
     5992   (itext as character,
     5993    iflag as logical):
     5994      if valid-handle(mPublishHand)
     5995      then
     5996         publish "PutStatAsunc" from mPublishHand (itext,iflag).
     5997      PutMes(itext).
     5998   end.
     5999   function chekStop returns logical
     6000   ( ):
     6001      define variable oStop as logical no-undo.
     6002      if valid-handle(mPublishHand)
     6003      then
     6004         publish "StopProc" from mPublishHand (output oStop).
     6005      return oStop.
     6006   end.
     6007   function  putloggetdesc returns logical
     6008   (is1 as character ,is2 as character ,
     6009   is3 as character ):
     6010   end.
     6011   function  getdesc returns logical
     6012   (input iObj as component-handle):
     6013      if iObj eq ? then return false.
     6014      if mdebug
     6015      then do:
     6016      output stream File-stream to "diadoc_load.txt" append.
     6017      define variable vReflector as component-handle no-undo.
     6018      define variable vDescobj  as component-handle no-undo.
     6019      define variable vPropertyNames  as component-handle no-undo.
     6020      define variable vMethodsNames as component-handle no-undo.
     6021      define variable vMethodDesc as component-handle no-undo.
     6022      define variable vMethodsName as character  no-undo.
     6023      define variable vPropertyValue as char no-undo.
     6024      create "Diadoc.Reflector" vReflector.
     6025      vDescobj = vReflector:Describe(iObj).
     6026     put   stream File-stream  unformatted skip (1)
     6027      "------------------------------------------" skip
     6028      vDescobj:GetInterfaceName() skip.
     6029      define variable vPropertyName as character no-undo.
     6030      define variable vPropertyType as character no-undo.
     6031      .
     6032      putloggetdesc(vDescobj:GetInterfaceName(),"","").
     6033      putloggetdesc("property","","").
     6034      define variable vi as integer no-undo.
     6035      define variable vii as integer no-undo.
     6036     put stream File-stream  unformatted skip "property" skip.
     6037     vPropertyNames = vDescobj:GetPropertiesNames().
     6038      vi= vPropertyNames:count.
     6039      do vi= 1 to vPropertyNames:count :
     6040         vPropertyName = "".
     6041         vPropertyType = "".
     6042         vPropertyValue = "".
     6043         vPropertyName  = vPropertyNames:GetItem(vi - 1) no-error.
     6044         vPropertyType  = vDescobj:GetPropertyType(vPropertyName) no-error .
     6045         vPropertyValue = substring((vDescobj:GetProperty(vPropertyName)),1,4000) no-error.
     6046         putloggetdesc(vPropertyName,vPropertyType,vPropertyValue).
     6047        put stream File-stream  unformatted vPropertyName " " vPropertyType  " " vPropertyValue skip.
     6048      end.
     6049      release object vPropertyNames.
     6050      put stream File-stream  unformatted skip "method" skip.
     6051      vMethodsNames = vDescobj:GetMethodsNames().
     6052      vi = vMethodsNames:count.
     6053      do vi = 1 to vMethodsNames:count :
     6054         vMethodsName = "".
     6055         vMethodsName = vMethodsNames:GetItem(vi - 1)no-error.
     6056         vMethodDesc  = vDescobj:GetMethodDesc(vMethodsName)no-error.
     6057         putloggetdesc("method",vMethodsName, vMethodDesc:RetVal).
     6058         put stream File-stream  unformatted vMethodsName  " retval " vMethodDesc:RetVal skip.
     6059         do vii  = 1 to vMethodDesc:args:count:
     6060            define variable varg as character no-undo.
     6061            varg = "".
     6062            varg = vMethodDesc:args:GetItem(vii - 1) no-error.
     6063            put stream File-stream  unformatted " args " varg  skip .
     6064            putloggetdesc(" args ",varg, "").
     6065         end.
     6066         release object vMethodDesc.
     6067      end.
     6068      release object vMethodsNames.
     6069      put stream File-stream  unformatted "end---------------------------------------" skip.
     6070      output stream File-stream close.
     6071      release object vDescobj.
     6072      release object vReflector.
     6073      end.
     6074      return true.
     6075   end.
     6076   function getxsddocum returns logical
     6077   (iOrganization as component-handle):
     6078      if iOrganization eq ? then return false.
     6079      define variable vDocumentTypes as component-handle no-undo.
     6080      define variable vDocumentType as component-handle no-undo.
     6081      define variable vFunctions as component-handle no-undo.
     6082      define variable vFunction as component-handle no-undo.
     6083      define variable vVersions as component-handle no-undo.
     6084      define variable vVersion as component-handle no-undo.
     6085      define variable vTitles as component-handle no-undo.
     6086      define variable vTitle as component-handle no-undo.
     6087      define variable vi as integer no-undo.
     6088      define variable vii as integer no-undo.
     6089      define variable viii as integer no-undo.
     6090      define variable viiii as integer no-undo.
     6091      if mdebug
     6092      then do:
     6093      output stream File-stream to "diadoc_doc.txt" append.
     6094      vDocumentTypes = iOrganization:GetDocumentTypes().
     6095      do vi =1 to vDocumentTypes:count:
     6096         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     6097         put stream File-stream  unformatted "DocumentType -> NAme " vDocumentType:name skip.
     6098         put stream File-stream  unformatted "DocumentType -> Title " vDocumentType:Title skip.
     6099         vFunctions = vDocumentType:Functions.
     6100         do vii =1 to vFunctions:count:
     6101            vFunction = vFunctions:GetItem(vii - 1 ).
     6102            put stream File-stream  unformatted "DocumentType -> Function -> NAme " vFunction:name skip.
     6103            vVersions = vFunction:Versions.
     6104            do viii =1 to vVersions:count:
     6105               vVersion = vVersions:GetItem(viii - 1 ).
     6106               put stream File-stream  unformatted "DocumentType -> Function -> Version -> version " vVersion:version skip.
     6107               put stream File-stream  unformatted "DocumentType -> Function -> Version -> IsActual " vVersion:IsActual skip.
     6108               vTitles  = vVersion:Titles.
     6109               do viiii =1 to vTitles:count:
     6110                  vTitle = vTitles:GetItem(viiii - 1 ).
     6111                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> IsFormal " vTitle:IsFormal skip.
     6112                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> XsdUrl " vTitle:XsdUrl skip.
     6113                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> HaveUserDataXSD " vTitle:HaveUserDataXSD skip.
     6114                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> type " vTitle:type skip.
     6115                  release object vTitle.
     6116               end.
     6117              release object vTitles.
     6118               release object vVersion.
     6119            end.
     6120            release object vVersions.
     6121            release object vFunction.
     6122         end.
     6123         release object vFunctions.
     6124         release object vDocumentType.
     6125      end.
     6126      release object vDocumentTypes.
     6127      put stream File-stream  unformatted "--------------------------------------------------- " skip.
     6128     output stream File-stream close.
     6129     end.
     6130      return true.
     6131   end.
     6132   function GetDocTitleType returns character
     6133   (iOrganizationGuid as character ,
     6134   itype as character ,
     6135   ifunction as character,
     6136   iversion as character
     6137   ):
     6138      if iOrganizationGuid eq ? then return "".
     6139      define variable vOrganization  as component-handle no-undo.
     6140      define variable vDocumentTypes as component-handle no-undo.
     6141      define variable vDocumentType  as component-handle no-undo.
     6142      define variable vFunctions     as component-handle no-undo.
     6143      define variable vFunction      as component-handle no-undo.
     6144      define variable vVersions      as component-handle no-undo.
     6145      define variable vVersion       as component-handle no-undo.
     6146      define variable vTitles        as component-handle no-undo.
     6147      define variable vTitle         as component-handle no-undo.
     6148      define variable vi             as integer no-undo.
     6149      define variable vii            as integer no-undo.
     6150      define variable viii           as integer no-undo.
     6151      define variable viiii          as integer no-undo.
     6152      define variable oTitleType as character no-undo.
     6153      vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     6154      if vOrganization eq ? then return "".
     6155      vDocumentTypes = vOrganization:GetDocumentTypes().
     6156      do vi =1 to vDocumentTypes:count:
     6157         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     6158         if vDocumentType:name eq iType
     6159         then do:
     6160            vFunctions = vDocumentType:Functions.
     6161            do vii =1 to vFunctions:count:
     6162               vFunction = vFunctions:GetItem(vii - 1 ).
     6163               if vFunction:name eq ifunction
     6164               then do:
     6165                  vVersions = vFunction:Versions.
     6166                  do viii =1 to vVersions:count:
     6167                     vVersion = vVersions:GetItem(viii - 1 ).
     6168                     if vVersion:version eq iversion
     6169                     then do:
     6170                        vTitles  = vVersion:Titles.
     6171                        do viiii =1 to vTitles:count:
     6172                           vTitle = vTitles:GetItem(viiii - 1 ).
     6173                           oTitleType = oTitleType + "," + vTitle:type.
     6174                           release object vTitle.
     6175                        end.
     6176                        release object vTitles.
     6177                     end.
     6178                     release object vVersion.
     6179                  end.
     6180                  release object vVersions.
     6181               end.
     6182               release object vFunction.
     6183            end.
     6184            release object vFunctions.
     6185         end.
     6186         release object vDocumentType.
     6187      end.
     6188      release object vDocumentTypes.
     6189      release object vOrganization.
     6190      return left-trim(oTitleType,",").
     6191   end.
     6192   define temp-table tt-type no-undo
     6193             field id as char
     6194             field name as character
     6195             index pi id .
     6196   define temp-table tt-Class no-undo like tt-type.
     6197   function crcode returns character
     6198   ():
     6199      define variable vtypelist as character no-undo.
     6200      define variable vtypename as character no-undo.
     6201      define variable vi as integer no-undo.
     6202      vtypelist =
     6203                 "UniversalTransferDocument|"
     6204                + "UniversalTransferDocumentRevision|"
     6205                + "UniversalCorrectionDocument|"
     6206                + "UniversalCorrectionDocumentRevision"
     6207                .
     6208      vtypename =
     6209                 "УПД|"
     6210                + "Исправление УПД|"
     6211                + "УКД|"
     6212                + "Исправление УКД"
     6213                .
     6214      do vi = 1 to num-entries(vtypelist,"|"):
     6215         create tt-type.
     6216         assign
     6217            tt-type.id   =  entry(vi,vtypelist,"|")
     6218            tt-type.name =  entry(vi,vtypename,"|")
     6219         .
     6220      end.
     6221      vtypelist = "Inbound|"
     6222                + "Outbound|"
     6223                + "Proxy".
     6224      vtypename = "входящий документ|"
     6225                + "исходящий документ|"
     6226                + "документ, переданный через промежуточного получателя|".
     6227      do vi = 1 to num-entries(vtypelist,"|"):
     6228         create tt-Class.
     6229         assign
     6230            tt-Class.id   =  entry(vi,vtypelist,"|")
     6231            tt-Class.name =  entry(vi,vtypename,"|")
     6232         .
     6233      end.
     6234   end.
     6235   crcode().
     6236   function getOrganizationInfo returns character
     6237   (input iContAgent as component-handle,
     6238                                                   output oinn as character,
     6239                                                   output oKpp as character,
     6240                                                   output oFnsParticipantId as character,
     6241                                                   output oOrgName as character,
     6242                                                   output oAdditionalInfo as character,
     6243                                                   output OarddrRus as character
     6244                                                    ):
     6245      define variable vi as integer no-undo.
     6246      define variable vContAgentOrganizationDetails   as component-handle no-undo.
     6247      define variable vAddrRus                        as component-handle no-undo.
     6248      if iContAgent ne ?
     6249      then do:
     6250         getdesc(iContAgent).
     6251         vContAgentOrganizationDetails = iContAgent:OrganizationDetails.
     6252         oinn = vContAgentOrganizationDetails:Inn.
     6253         oKpp = vContAgentOrganizationDetails:Kpp.
     6254         oFnsParticipantId = vContAgentOrganizationDetails:FnsParticipantId.
     6255         oAdditionalInfo = vContAgentOrganizationDetails:OrganizationAdditionalInfo.
     6256         getdesc(vContAgentOrganizationDetails).
     6257         oOrgName = vContAgentOrganizationDetails:OrgName.
     6258         getdesc(vContAgentOrganizationDetails:Address).
     6259         vAddrRus = vContAgentOrganizationDetails:Address:RussianAddress.
     6260         getdesc(vAddrRus ).
     6261         if vAddrRus ne ?
     6262         then do:
     6263            if vAddrRus:ZipCode ne ""
     6264            then
     6265               OarddrRus = OarddrRus + " " + vAddrRus:ZipCode.
     6266            if vAddrRus:Region ne ""
     6267            then
     6268               OarddrRus = OarddrRus + " Регион: " + vAddrRus:Region.
     6269            if vAddrRus:Territory ne ""
     6270            then
     6271               OarddrRus = OarddrRus + " Область: " + vAddrRus:Territory.
     6272            if vAddrRus:City ne ""
     6273            then
     6274               OarddrRus = OarddrRus + " Город: " + vAddrRus:City.
     6275            if vAddrRus:Locality ne ""
     6276            then
     6277               OarddrRus = OarddrRus + " Район: " + vAddrRus:Locality.
     6278            if vAddrRus:Street ne ""
     6279            then
     6280               OarddrRus = OarddrRus + " Улица: " + vAddrRus:Street.
     6281            if vAddrRus:Block ne ""
     6282            then
     6283               OarddrRus = OarddrRus + " Стр: " + vAddrRus:Block.
     6284            if vAddrRus:Building ne ""
     6285            then
     6286               OarddrRus = OarddrRus + " Дом: " + vAddrRus:Building.
     6287            if vAddrRus:Apartment ne ""
     6288            then
     6289               OarddrRus = OarddrRus + " Квартира: " + vAddrRus:Apartment.
     6290         end.
     6291         release object vAddrRus.
     6292         release object vContAgentOrganizationDetails.
     6293      end.
     6294   end.
     6295   function ConectByCertif return component-handle
     6296   (iThumbprint as character ):
     6297     if mDiadocApi eq ? then return ?.
     6298     if iThumbprint eq ""
     6299     then do:
     6300        release object mDiadocConnection no-error.
     6301        return ?.
     6302     end.
     6303      mDiadocApi:ApiClientId =  getextAttr('diadoc-key':U).
     6304      mDiadocApi:ServerUrl   =  getextAttr('server-addr':U).
     6305      define variable vSSl as character no-undo.
     6306      vSSl =  getextAttr('diadoc-ssl':U).
     6307      if vSSl ne ""
     6308         and logical(vSSl)
     6309      then
     6310         mDiadocApi:VerifySslCertificate = no.
     6311      if mDiadocApi:ApiClientId eq ""
     6312         or  mDiadocApi:ServerUrl eq ""
     6313      then do:
     6314        message "Не задан адрес сервера или ключ разработчика для внешей системы Диадок"
     6315        view-as alert-box.
     6316        release object mDiadocConnection no-error.
     6317        return ?.
     6318     end.
     6319     define variable VProxy as character no-undo.
     6320      vProxy =  getextAttr('proxy-addr':U).
     6321      if     vProxy ne ""
     6322         and vProxy ne ?
     6323      then do:
     6324         mDiadocApi:ProxyMode =  "UseProxy".
     6325         mDiadocApi:ProxySettings:Url = vProxy.
     6326         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     6327         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     6328      end.
     6329      define variable vtest as component-handle no-undo.
     6330      vtest = mDiadocApi:TestConnection2().
     6331      if not vtest:ConnectionSuccess
     6332      then do:
     6333         PutMes(vtest:ErrorText).
     6334      end.
     6335      else
     6336         mDiadocConnection = mDiadocApi:CreateConnectionByCertificate(iThumbprint,"") no-error.
     6337      if mDiadocConnection eq ?
     6338      then
     6339         PutErr("DiadocApi:CreateConnectionByCertificate:").
     6340      release object vtest.
     6341      return mDiadocConnection.
     6342   end.
     6343   function ConectByLogin return component-handle
     6344   ():
     6345      define variable vSSl as character no-undo.
     6346      if mDiadocApi eq ? then return ?.
     6347      mDiadocApi:ApiClientId = getextAttr('diadoc-key':U).
     6348      mDiadocApi:ServerUrl   = getextAttr('server-addr':U).
     6349      if mDiadocApi:ApiClientId eq ""
     6350         or  mDiadocApi:ServerUrl eq ""
     6351      then do:
     6352        PutMes( "Error Не задан адрес сервера или ключ разработчика для внешей системы Диадок").
     6353        release object mDiadocConnection no-error.
     6354        return ?.
     6355     end.
     6356     vSSl =  getextAttr('diadoc-ssl':U).
     6357     if vSSl ne ""
     6358        and logical(vSSl)
     6359     then
     6360         mDiadocApi:VerifySslCertificate = no.
     6361     define variable VProxy as character no-undo.
     6362      vProxy =  getextAttr('proxy-addr':U).
     6363      if     vProxy ne ""
     6364         and vProxy ne ?
     6365      then do:
     6366         mDiadocApi:ProxyMode =  "UseProxy".
     6367         mDiadocApi:ProxySettings:Url = vProxy.
     6368         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     6369         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     6370      end.
     6371      mDiadocConnection = mDiadocAPI:CreateConnectionByLogin(getextAttr('diadoc-user':U),getextAttr('diadoc-pwd':U)) no-error.
     6372      define variable vi as integer no-undo.
     6373      if mDiadocConnection eq ?
     6374      then
     6375         PutErr("DiadocAPI:CreateConnectionByLogin").
     6376      return mDiadocConnection.
     6377   end.
     6378   function GetDocumforid returns character
     6379   (input  iorg as character ,
     6380    input  idoc-id as character ,
     6381    output oDocument      as component-handle
     6382     ):
     6383      define variable vOrganization  as component-handle no-undo.
     6384      define variable vDocument      as component-handle no-undo.
     6385      define buffer utd           for ub.utd.
     6386      if
     6387             iorg  ne ?
     6388         and iorg  ne ""
     6389         and idoc-id ne ?
     6390         and idoc-id ne ""
     6391      then do:
     6392         vOrganization = mDiadocConnection:GetOrganizationById(iorg) no-error.
     6393         if vOrganization ne ?
     6394         then do:
     6395            oDocument = vOrganization:GetDocumentById(idoc-id,false) no-error.
     6396            if oDocument eq ?
     6397            then
     6398               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", iorg,idoc-id)).
     6399         end.
     6400         else do:
     6401            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", iorg,idoc-id)).
     6402            return "Нет доступа к организации " + iorg.
     6403         end.
     6404      end.
     6405      else
     6406         return "Нет доступа к организации не ЭДО".
     6407      release object vOrganization no-error.
     6408      return "".
     6409   end.
     6410   function GetDocum returns character
     6411   (input  idb-num as integer,
     6412    input  idoc-id as integer,
     6413    output oDocument      as component-handle
     6414     ):
     6415      define variable vOrganization  as component-handle no-undo.
     6416      define variable vDocument      as component-handle no-undo.
     6417      define buffer utd           for ub.utd.
     6418      find first utd where utd.db-num eq idb-num
     6419                       and utd.doc-id eq idoc-id
     6420      no-lock no-error.
     6421      if     available utd
     6422         and utd.OrganizationExt ne ?
     6423         and utd.OrganizationExt ne ""
     6424         and utd.DocumentExt ne ?
     6425         and utd.DocumentExt ne ""
     6426      then do:
     6427         vOrganization = mDiadocConnection:GetOrganizationById(utd.OrganizationExt) no-error.
     6428         if vOrganization ne ?
     6429         then do:
     6430            oDocument = vOrganization:GetDocumentById(utd.DocumentExt,false) no-error.
     6431            if oDocument eq ?
     6432            then
     6433               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", utd.OrganizationExt,utd.DocumentExt)).
     6434            release object vOrganization no-error.
     6435         end.
     6436         else do:
     6437            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", utd.OrganizationExt,utd.DocumentNumber)).
     6438            return "Нет доступа к организации " + utd.OrganizationExt.
     6439         end.
     6440      end.
     6441      else
     6442         return "Нет доступа к организации не ЭДО".
     6443      return "".
     6444   end.
     6445   function GetFirstUTDinPack returns logical
     6446   (input idb-num as integer,
     6447    input idoc-id as integer,
     6448    output odb-num as integer,
     6449    output odoc-id as integer ):
     6450      define buffer buf_utd for utd.
     6451      define buffer     utd for utd.
     6452      find first utd where utd.db-num eq idb-num
     6453                       and utd.doc-id eq idoc-id
     6454      no-lock no-error.
     6455      if available utd
     6456      then do:
     6457         if utd.PackageId eq ""
     6458         then do:
     6459            assign
     6460               odb-num = utd.db-num
     6461               odoc-id = utd.doc-id
     6462            .
     6463            return yes.
     6464         end.
     6465         else do:
     6466            find first buf_utd where Buf_utd.PackageId eq utd.PackageId
     6467                                 and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6468            no-lock.
     6469            assign
     6470               odb-num = buf_utd.db-num
     6471               odoc-id = buf_utd.doc-id
     6472            .
     6473            return if available buf_utd then (recid(utd) eq recid(buf_utd)) else no.
     6474         end.
     6475      end.
     6476      return ?.
     6477   end.
     6478   function AddOADLine returns integer
     6479   (iDb-num  as integer ,
     6480    iDoc-id  as integer ,
     6481    ilinenum as integer ,
     6482    iGtin    as char,
     6483    iQnty    as int,
     6484    isite    as character ):
     6485       define buffer utd-marking-lines      for ub.utd-marking-lines.
     6486       define variable vnewMark as character no-undo.
     6487       define variable vQnty    as integer   no-undo.
     6488       vnewMark = "02" + iGtin + "37" + string(iQnty).
     6489       find first utd-marking-lines where utd-marking-lines.mark       = vnewMark
     6490                                      and utd-marking-lines.db-num     = idb-num
     6491                                      and utd-marking-lines.doc-id     = idoc-id
     6492                                      and utd-marking-lines.Linenum    = iLinenum
     6493       exclusive-lock no-error.
     6494       if available utd-marking-lines
     6495       then do:
     6496          delete utd-marking-lines.
     6497          vQnty = AddOADLine(idb-num, idoc-id, iLinenum, iGtin, iQnty * 2 ,isite ).
     6498       end.
     6499       else do:
     6500          create utd-marking-lines.
     6501          assign
     6502             utd-marking-lines.mark      = vnewMark
     6503             utd-marking-lines.db-num    = idb-num
     6504             utd-marking-lines.doc-id    = idoc-id
     6505             utd-marking-lines.Linenum   = iLinenum
     6506             utd-marking-lines.site      = isite
     6507             utd-marking-lines.doc-level = 1
     6508             utd-marking-lines.gds-code  = ?
     6509          .
     6510          vQnty = iQnty.
     6511       end.
     6512       return vQnty.
     6513    end.
     6514   function addMarkforUtd returns recid
     6515   (iDb-num  as integer ,
     6516    iDoc-id  as integer ,
     6517    ilinenum as integer ,
     6518    iMark as character  ,
     6519    isite   as character,
     6520    iUtdType as character    ):
     6521       define buffer     marking            for ub.marking.
     6522       define buffer     marking-attr       for ub.marking-attr.
     6523       define buffer utd-marking-lines      for ub.utd-marking-lines.
     6524       define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     6525       define variable vMRC  as decimal no-undo.
     6526       define variable vQnty as decimal no-undo.
     6527      define variable vRec as recid no-undo.
     6528      if     imark ne "-"
     6529         and imark ne ""
     6530         and imark ne ?
     6531      then do:
     6532         imark = repTegforDm(imark).
     6533         vQnty = getQntyUTDByCodId(imark) .
     6534         find first utd-marking-lines where utd-marking-lines.mark       = imark
     6535                                        and utd-marking-lines.db-num     = idb-num
     6536                                        and utd-marking-lines.doc-id     = idoc-id
     6537                                        and utd-marking-lines.Linenum    = iLinenum
     6538         exclusive-lock no-error.
     6539         if not available utd-marking-lines
     6540         then do:
     6541            create utd-marking-lines.
     6542            assign
     6543               utd-marking-lines.mark      = imark
     6544               utd-marking-lines.db-num    = idb-num
     6545               utd-marking-lines.doc-id    = idoc-id
     6546               utd-marking-lines.Linenum   = iLinenum
     6547               utd-marking-lines.site      = isite
     6548               utd-marking-lines.doc-level = 1
     6549               utd-marking-lines.gds-code  = ?
     6550            .
     6551            create utd-marking-lines-attr.
     6552            assign
     6553               utd-marking-lines-attr.mark      = imark
     6554               utd-marking-lines-attr.db-num    = idb-num
     6555               utd-marking-lines-attr.doc-id    = idoc-id
     6556               utd-marking-lines-attr.Linenum   = iLinenum
     6557               utd-marking-lines-attr.attr-code = "box-qnty"
     6558               utd-marking-lines-attr.attr-value = string(vQnty)
     6559            .
     6560            vRec = recid(utd-marking-lines).
     6561            release utd-marking-lines-attr.
     6562            release utd-marking-lines.
     6563         end.
     6564         else do:
     6565            if    (    isite eq "-"
     6566               and utd-marking-lines.site eq "+")
     6567            or (    isite eq "+"
     6568               and utd-marking-lines.site eq "-")
     6569            then
     6570               delete utd-marking-lines.
     6571            else if isOAD (imark)
     6572            then do:
     6573               vQnty = AddOADLine(idb-num, idoc-id, iLinenum, GetTegCod(imark,"02"), int(vQnty) ,isite ).
     6574               create utd-marking-lines-attr.
     6575               assign
     6576                  utd-marking-lines-attr.mark      = imark
     6577                  utd-marking-lines-attr.db-num    = idb-num
     6578                  utd-marking-lines-attr.doc-id    = idoc-id
     6579                  utd-marking-lines-attr.Linenum   = iLinenum
     6580                  utd-marking-lines-attr.attr-code = "box-qnty"
     6581                  utd-marking-lines-attr.attr-value = string(vQnty)
     6582               .
     6583            end.
     6584            vRec = recid(utd-marking-lines).
     6585            release utd-marking-lines.
     6586         end.
     6587         if isMark (imark)
     6588         then do:
     6589            find first marking where marking.mark eq iMark exclusive-lock no-error.
     6590            if not available marking
     6591            then do:
     6592               create marking.
     6593               marking.mark = iMark.
     6594               marking.gds-code = ?.
     6595               marking.unit     = getLevelUTDByCodId(marking.mark) .
     6596            end.
     6597            assign
     6598              marking.unit-ext   = if marking.unit-ext = "" or marking.unit-ext = ? then
     6599                                      getLevelMotpByCodId(marking.mark)
     6600                                   else marking.unit-ext
     6601              marking.box-qnty   = vQnty
     6602              marking.unit       = if marking.unit-ext = "LEVEL2" then "КИТУ" else getLevelUTDByCodId(marking.mark)
     6603            .
     6604            if        (     iUtdType eq "UniversalTransferDocument"
     6605                     and marking.sts = objSrv:Env:marking:Sts:Mark:NotAvailable:KeyIntDB)
     6606            then
     6607               marking.sts = ?.
     6608         end.
     6609      end.
     6610      return vRec.
     6611   end.
     6612   function isSaleMarkInUpak returns logical
     6613   (iMark    as char ):
     6614      define buffer buf_marking       for ub.marking.
     6615      for each buf_marking no-lock where
     6616               buf_marking.mark-parent = iMark
     6617      :
     6618        if can-do(objSrv:Env:marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) or
     6619           can-do(objSrv:Env:marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) then
     6620          return true.
     6621        if isSaleMarkInUpak(buf_marking.mark) then
     6622          return true.
     6623      end.
     6624      return false.
     6625    end.
     6626   function setStatusUpak returns logical
     6627   (iDbNum   as integer ,
     6628    iDocId   as integer ,
     6629    iLineNum as integer ,
     6630    iMark    as char ,
     6631    iSts     as integer):
     6632      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     6633      define buffer buf_marking           for ub.marking.
     6634      for each buf_marking exclusive-lock where
     6635               buf_marking.mark-parent = iMark,
     6636         first buf_utd-marking-lines exclusive-lock where
     6637               buf_utd-marking-lines.doc-id  = iDocId
     6638           and buf_utd-marking-lines.db-num  = iDbNum
     6639           and buf_utd-marking-lines.lineNum = iLineNum
     6640           and buf_utd-marking-lines.mark = buf_marking.mark
     6641      :
     6642        setStatusUpak(iDbNum, iDocId, iLineNum, buf_marking.mark, iSts).
     6643      end.
     6644      for first buf_utd-marking-lines exclusive-lock where
     6645                buf_utd-marking-lines.doc-id  = iDocId
     6646            and buf_utd-marking-lines.db-num  = iDbNum
     6647            and buf_utd-marking-lines.lineNum = iLineNum
     6648            and buf_utd-marking-lines.mark = iMark,
     6649          first buf_marking exclusive-lock where
     6650                buf_marking.mark = buf_utd-marking-lines.mark
     6651      :
     6652        if  buf_marking.sts <> objSrv:Env:marking:Sts:Mark:MarkError:KeyIntDB
     6653        then do:
     6654          assign
     6655            buf_utd-marking-lines.sts = iSts
     6656            buf_marking.sts           = iSts
     6657          .
     6658        end.
     6659      end.
     6660      return true.
     6661   end.
     6662   define temp-table tt-recid no-undo
     6663             field orgid as char
     6664             field docid as char
     6665             field parent as char
     6666             field stamp as datetime
     6667             index pi orgid docid
     6668             index parent parent  stamp.
     6669   function ProcessSystemMessStart return component-handle
     6670   (IStartStop as logical):
     6671      if mDiadocConnection eq ? then
     6672      define variable vOrganizationList as component-handle no-undo.
     6673      define variable vOrganization as component-handle no-undo.
     6674      define variable vReceiptGenerationProcess as component-handle no-undo.
     6675      define variable vi as integer no-undo.
     6676      if mDiadocConnection ne ?
     6677      then do:
     6678         vOrganizationList = mDiadocConnection:GetOrganizationList().
     6679          do vi = 1 to vOrganizationList:count:
     6680             vOrganization = vOrganizationList:GetItem(vi - 1 ).
     6681             vReceiptGenerationProcess = vOrganization:GetReceiptGenerationProcess().
     6682             release object vOrganization.
     6683             if IStartStop
     6684             then
     6685                vReceiptGenerationProcess:Start().
     6686             else
     6687                vReceiptGenerationProcess:Stop().
     6688             release object vReceiptGenerationProcess.
     6689          end.
     6690          release object vOrganizationList.
     6691      end.
     6692   end.
     6693   procedure  changeIdToGuid :
     6694   define input  parameter iOrganization as component-handle no-undo.
     6695      define variable vOrgId   as character no-undo.
     6696      define variable vOrgGuid as character no-undo.
     6697      define buffer utd for utd.
     6698      assign
     6699         vOrgId   = iOrganization:id.
     6700         vOrgGuid = iOrganization:guid
     6701      no-error.
     6702      if     error-status:num-messages eq 0
     6703         and vOrgId   ne ""
     6704         and vOrgGuid ne ""
     6705      then do:
     6706         define variable vfirst as logical no-undo init yes.
     6707         repeat preselect each utd where utd.OrganizationExt = vOrgId exclusive-lock:
     6708            find next utd.
     6709            if vfirst
     6710            then do:
     6711               PutMes("Конвертация документов").
     6712               vfirst = no.
     6713            end.
     6714            utd.OrganizationExt = vOrgGuid.
     6715            validate utd.
     6716            PutMes(substitute ("У документа &1 изменен индификатор организации с &2 на &3",ub.utd.DocumentNumber,vOrgId,utd.OrganizationExt)).
     6717         end.
     6718         if not vfirst
     6719         then
     6720            PutMes("Конвертация документов завершина.").
     6721      end.
     6722   end.
     6723   procedure getNewUpd :
     6724      define variable VLastDate as date no-undo init ?.
     6725      define variable vDocument     as component-handle no-undo.
     6726      define variable vYear         as integer no-undo.
     6727      define variable vMonth        as integer no-undo.
     6728      define variable vDay          as integer no-undo.
     6729      define variable vBegLoadDate  as date    no-undo.
     6730      define variable vLastLoadDate as date    no-undo.
     6731      define buffer utd for utd.
     6732      VLastDate = date( getextAttr('diadoc-lastload':U)) no-error.
     6733      find first sys-ctrl no-lock.
     6734      if VLastDate eq ?
     6735      then
     6736         VLastDate = sys-ctrl.cut-date + 3.
     6737      else if sys-ctrl.cut-date ne ?
     6738      then
     6739         VLastDate = max(VLastDate,sys-ctrl.cut-date + 3) .
     6740      vLastLoadDate = VLastDate.
     6741      for each tt-recid:
     6742         delete tt-recid.
     6743      end.
     6744      if chekStop() then return "Остановка пользователем".
     6745       run  UpdateUTDInform(if VLastDate eq ? then today - 365 else VLastDate - 3,today + 1,output VLastDate).
     6746      if chekStop() then return "Остановка пользователем".
     6747      if VLastDate ne ?
     6748      then do:
     6749         setextAttr('diadoc-lastload':U,string(VLastDate)).
     6750         vYear = year(vLastLoadDate).
     6751         vMonth = month(vLastLoadDate) - 2.
     6752         vDay   = day(vLastLoadDate).
     6753         if vMonth <= 0 then
     6754            assign
     6755               vMonth = vMonth + 12
     6756               vYear  = vYear - 1
     6757               .
     6758         repeat:
     6759            vBegLoadDate = date(vMonth, vDay, vYear) no-error.
     6760            if error-status:error then
     6761               vDay = vDay - 1.
     6762            else
     6763               leave.
     6764         end.
     6765         vBegLoadDate = vBegLoadDate + 1.
     6766      end.
     6767      block-rec:
     6768      for each tt-recid break by tt-recid.parent descending by tt-recid.stamp descending :
     6769         if  tt-recid.parent eq ""
     6770         then next  block-rec.
     6771         if first-of (tt-recid.parent)
     6772         then do:
     6773            for each utd where utd.PackageId eq tt-recid.parent
     6774            no-lock break by utd.PackageId descending by utd.Timestamp descending :
     6775               if chekStop() then return "Остановка пользователем".
     6776               if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     6777               then do:
     6778                  subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     6779                  MySeqUtd = ?.
     6780                  CrEdoc(utd.PackageId,utd.Timestamp).
     6781                  unsubscribe "getNextseq".
     6782                  next block-rec.
     6783               end.
     6784            end.
     6785         end.
     6786      end.
     6787      PutMes("Обновление информации по ранее загруженным документам за период c " + (if vBegLoadDate <> ? then
     6788                                                                                        string(vBegLoadDate)
     6789                                                                                     else "?")
     6790                                                                                     + " по " +
     6791                                                                                     (if vLastLoadDate <> ? then
     6792                                                                                         string(vLastLoadDate)
     6793                                                                                      else
     6794                                                                                         "?")
     6795                                                                                      ).
     6796      define variable vobj as character no-undo.
     6797      vobj = getExtAttr('host-code':U).
     6798      if vobj ne "0"
     6799      then
     6800          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6801                         and utd.host-code eq int(vobj)
     6802                         and (   utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6803                              or utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     6804                              )
     6805          no-lock break by utd.OrganizationExt:
     6806             if chekStop() then return "Остановка пользователем".
     6807             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     6808             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     6809                                   and tt-recid.docid = utd.DocumentExt
     6810                    no-error.
     6811             if     not available tt-recid
     6812                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     6813             then do:
     6814                 run  UpdateUTDInformOne(vDocument).
     6815                release object vDocument no-error.
     6816             end.
     6817          end.
     6818      vobj = getExtAttr('obj':U).
     6819      if vobj ne ""
     6820      then
     6821          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6822                         and utd.obj-type + string(utd.obj-code) eq vobj
     6823          no-lock break by utd.OrganizationExt:
     6824             if chekStop() then return "Остановка пользователем".
     6825             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     6826             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     6827                                   and tt-recid.docid = utd.DocumentExt
     6828                    no-error.
     6829             if     not available tt-recid
     6830                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     6831             then do:
     6832                 run  UpdateUTDInformOne(vDocument).
     6833                release object vDocument no-error.
     6834             end.
     6835          end.
     6836   end.
     6837   procedure  SendAuto:
     6838    define variable vOrganization as component-handle no-undo.
     6839    define variable vOrganizationList as component-handle no-undo.
     6840    define variable vi as integer no-undo.
     6841      if mDiadocConnection eq ?
     6842      then do:
     6843         message "По данному сертификату не удалось подключиться к Диадок"
     6844         view-as alert-box.
     6845      end.
     6846      else do:
     6847         for each tt-recid:
     6848            delete tt-recid.
     6849         end.
     6850         vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     6851         if vOrganizationList eq ? then return error ?.
     6852         vi = vOrganizationList:Count()no-error.
     6853         if vi eq ?
     6854         then
     6855            return error ?.
     6856         do vi = 1 to vOrganizationList:Count() :
     6857            vOrganization = vOrganizationList:GetItem(vi - 1 ).
     6858            define variable vorgid as character no-undo.
     6859            vorgid = vOrganization:guid.
     6860            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6861                           and utd.host-code eq v-cntxt-host-code-obj
     6862                           and utd.OrganizationExt eq vorgid
     6863            no-lock:
     6864                run  SendReceiptsAsync(utd.db-num,utd.doc-id).
     6865            end.
     6866            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6867                           and utd.host-code eq v-cntxt-host-code-obj
     6868                           and utd.OrganizationExt eq vorgid
     6869            no-lock:
     6870                run  updOneUTD(utd.db-num,utd.doc-id).
     6871            end.
     6872         end.
     6873      end.
     6874   end.
     6875   procedure SendAccept:
     6876      define input  parameter iTypeAccept     as character no-undo.
     6877      define input  parameter iReplyTask      as component-handle no-undo.
     6878      define input  parameter iOrganizationGuid as character no-undo.
     6879      define input  parameter iWorkflowId     as integer no-undo.
     6880      define input  parameter iTitleTypes    as character  no-undo.
     6881      define output parameter oOperationCode as character no-undo.
     6882      define variable vContentItems as component-handle no-undo.
     6883      define variable vContentItem  as component-handle no-undo.
     6884      define variable vSigner       as component-handle no-undo.
     6885      define variable vBuyerTitle   as component-handle no-undo.
     6886      define variable vEmployee     as component-handle no-undo.
     6887      define variable vContentOperCode as component-handle no-undo.
     6888      define variable vOrganization   as component-handle no-undo.
     6889      define variable vUserperm   as component-handle no-undo.
     6890      define variable vi as integer no-undo.
     6891     define variable vdate as date no-undo.
     6892     define variable vDocumentCreator as character no-undo.
     6893     define variable vDocumentCreatorBase as character no-undo.
     6894     define variable vOperationCode as character no-undo.
     6895     define variable vOperationContenttext as character no-undo.
     6896     define variable vOperationContent as character no-undo.
     6897     define variable vThumbprint as character no-undo.
     6898     define variable vJobTitle   as character no-undo.
     6899     vThumbprint = mDiadocConnection:Certificate:Thumbprint.
     6900     vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     6901     if vOrganization eq ?
     6902     then do:
     6903        run str\utdacp.w (output vdate, output  vDocumentCreator, output vDocumentCreatorBase, output vOperationCode, output vOperationContent) no-error.
     6904        if vdate eq ?
     6905        then
     6906           return error "".
     6907     end.
     6908     else do:
     6909        define variable vTitleType as character no-undo.
     6910        define variable vSignSet   as component-handle no-undo.
     6911        define variable vSeller as logical no-undo.
     6912        vUserperm = vOrganization:GetUserPermissions().
     6913        vJobTitle = vUserperm:JobTitle.
     6914        release object vUserperm.
     6915        blk-tit:
     6916        do vi = 1 to num-entries(iTitleTypes):
     6917           vTitleType = entry(vi,iTitleTypes).
     6918           vSeller = index(vTitleType,"Seller") > 0.
     6919           if vSeller
     6920           then
     6921              next blk-tit.
     6922           vSignSet = vOrganization:GetExtendedSignerDetails2(vThumbprint, vTitleType) no-error.
     6923           if error-status:num-messages > 0
     6924           then do:
     6925              define variable vTasksetSign   as component-handle no-undo.
     6926              define variable vTasksetSignDetal   as component-handle no-undo.
     6927              vTasksetSign = vOrganization:CreateSetExtendedSignerDetailsTask(VThumbprint).
     6928              getdesc(vTasksetSign).
     6929              vTasksetSign:DocumentTitleType = vTitleType.
     6930              getdesc(vTasksetSign).
     6931              vTasksetSignDetal = vTasksetSign:ExtendedSignerDetailsToPost.
     6932              getdesc(vTasksetSignDetal).
     6933              vTasksetSignDetal:JobTitle  = vJobTitle    .
     6934              vTasksetSignDetal:SignerType = "LegalEntity" .
     6935              vTasksetSignDetal:SignerInfo = "".
     6936              vTasksetSignDetal:Powers = if VSeller then "InvoiceSigner"  else "PersonDocumentedOperation".
     6937              vTasksetSignDetal:Status = if VSeller then "SellerEmployee" else "BuyerEmployee".
     6938              vTasksetSignDetal:PowersBase = "Должностные обязанности".
     6939              getdesc(vTasksetSignDetal).
     6940              release object vTasksetSignDetal.
     6941              vTasksetSign:send() no-error.
     6942              if error-status:num-messages > 0 then do:
     6943                 PutErr(substitute("Error Ошибка при установке подписанта по документу &1 ", vTitleType )).
     6944              end.
     6945              release object vTasksetSign.
     6946           end.
     6947           else do:
     6948              getdesc(vSignSet).
     6949              release object vSignSet.
     6950           end.
     6951        end.
     6952        vOperationContent = if iTypeAccept eq "AcceptDocumentWithDisc"
     6953                            then "2"
     6954                            else if iTypeAccept eq "AcceptDocumentNotAccepted"
     6955                            then "3"
     6956                            else "1".
     6957        vdate = today.
     6958        vDocumentCreator = substitute("&1, ИНН~/КПП &2~/&3", vOrganization:name , vOrganization:inn , vOrganization:kpp).
     6959        release object vOrganization.
     6960     end.
     6961     if    vJobTitle eq ?
     6962        or vJobTitle eq ""
     6963     then
     6964        vJobTitle = mDiadocConnection:Certificate:JobTitle.
     6965      if (   iWorkflowId = 3
     6966         or iWorkflowId = 5
     6967         or iWorkflowId = 8
     6968         or iWorkflowId = 11
     6969         or iWorkflowId = 12
     6970         or iWorkflowId = 13
     6971         or iWorkflowId = 16)
     6972         and iReplyTask ne ?
     6973      then do:
     6974         getdesc(iReplyTask).
     6975         vContentItems = iReplyTask:ContentItems.
     6976         getdesc(vContentItems).
     6977         do vi = 1 to vContentItems:count:
     6978            getdesc(vContentItems:GetItem(vi - 1 )).
     6979            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6980            vContentItem = vContentItems:GetItem(vi - 1 ):Content.
     6981            getdesc(vContentItem).
     6982            vBuyerTitle = vContentItem:UniversalTransferDocumentBuyerTitle no-error.
     6983            getdesc(vBuyerTitle).
     6984              if vBuyerTitle eq ?
     6985            then do:
     6986               vBuyerTitle = vContentItem:UniversalCorrectionDocumentBuyerTitle.
     6987               getdesc(vBuyerTitle).
     6988               vOperationContenttext = "C изменением стоимости согласен".
     6989            end.
     6990            else do:
     6991               oOperationCode = vOperationContent.
     6992      vOperationContenttext = if vOperationContent eq "1"
     6993                          then "Принято без разногласий"
     6994                          else if vOperationContent eq "2"
     6995                          then "Принято с разногласиями"
     6996                          else if vOperationContent eq "3"
     6997                          then "Товары не приняты"
     6998                          else vOperationContent.
     6999               getdesc(vBuyerTitle).
     7000               vEmployee = vBuyerTitle:Employee.
     7001               getdesc(vEmployee).
     7002               define variable vUser   as component-handle no-undo.
     7003               vUser = mDiadocConnection:GetMyUser().
     7004               getdesc(vUser).
     7005               vEmployee:position        = vJobTitle    .
     7006               vEmployee:FirstName       = vUser:FirstName  .
     7007               vEmployee:LastName        = vUser:LastName   .
     7008               vEmployee:MiddleName      = vUser:MiddleName .
     7009               vEmployee:EmployeeBase     = "Должностные обязанности".
     7010               release object vUser.
     7011               getdesc(vEmployee).
     7012               getdesc(mDiadocConnection:Certificate).
     7013               getdesc(vContentItem:UniversalTransferDocumentBuyerTitle).
     7014               getdesc(vBuyerTitle:ContentOperCode).
     7015               vContentOperCode = vBuyerTitle:ContentOperCode.
     7016               vContentOperCode:TotalCode = vOperationContent.
     7017               vBuyerTitle:OperationCode   = oOperationCode.
     7018               release object vContentOperCode.
     7019               release object vEmployee.
     7020            end.
     7021            vBuyerTitle:DocumentCreator = vDocumentCreator .
     7022            vBuyerTitle:DocumentCreatorBase     = vDocumentCreatorBase.
     7023            vBuyerTitle:OperationContent =  vOperationContenttext.
     7024            vBuyerTitle:AcceptanceDate   = vdate.
     7025            getdesc(vBuyerTitle).
     7026            getdesc(vBuyerTitle:Signers).
     7027            vSigner = vBuyerTitle:Signers:additems().
     7028            getdesc(vSigner).
     7029            getdesc(vSigner:SignerReference).
     7030            getdesc(vSigner:SignerDetails).
     7031            vSigner:SignerReference:CertificateThumbprint = mDiadocConnection:Certificate:Thumbprint.
     7032            vSigner:SignerReference:boxid = iOrganizationGuid.
     7033            getdesc(vSigner:SignerReference).
     7034            release object vBuyerTitle no-error.
     7035            release object vContentItem.
     7036         end.
     7037         release object vContentItems.
     7038      end.
     7039   end.
     7040   function SendAnswer returns character
     7041   (iReplyTask as component-handle,iorg as char,iTypeAnswer as character,imes as longchar ):
     7042      define variable vContent       as component-handle no-undo.
     7043      define variable vContentItems  as component-handle no-undo.
     7044      define variable vSigner        as component-handle no-undo.
     7045      define variable vSignTask      as component-handle no-undo.
     7046      define variable vOrganization  as component-handle no-undo.
     7047      define variable vUserperm      as component-handle no-undo.
     7048      define variable vUser          as component-handle no-undo.
     7049      define variable vi as integer no-undo.
     7050      if     itypeAnswer ne "AcceptRevocation"
     7051         and iReplyTask  ne ?
     7052      then do:
     7053         getdesc(iReplyTask).
     7054         vContentItems = iReplyTask:ContentItems.
     7055         getdesc(vContentItems).
     7056         do vi = 1 to vContentItems:count:
     7057            getdesc(vContentItems:GetItem(vi - 1 )).
     7058            getdesc(vContentItems:GetItem(vi - 1 ):document).
     7059            vContent = vContentItems:GetItem(vi - 1 ):Content.
     7060            vContent:comment =  imes.
     7061           getdesc(vContent).
     7062            vSigner = vContent:Signer.
     7063            getdesc(vSigner).
     7064            vOrganization = mDiadocConnection:GetOrganizationById(iOrg) no-error.
     7065            vUserperm = vOrganization:GetUserPermissions().
     7066            define variable vJobTitle as character no-undo.
     7067            vJobTitle = vUserperm:JobTitle.
     7068            if    vJobTitle eq ?
     7069               or vJobTitle eq ""
     7070            then
     7071               vJobTitle = mDiadocConnection:Certificate:JobTitle.
     7072            release object vUserperm.
     7073            release object vOrganization.
     7074            vUser = mDiadocConnection:GetMyUser().
     7075            getdesc(vUser).
     7076            vSigner:Surname    = vUser:FirstName.
     7077            vSigner:FirstName  = vUser:LastName.
     7078            vSigner:Patronymic = vUser:MiddleName.
     7079            vSigner:JobTitle   = vJobTitle.
     7080            vSigner:Inn        = mDiadocConnection:Certificate:inn.
     7081            getdesc(vSigner).
     7082            release object vUser.
     7083            release object vSigner.
     7084            release object vContent.
     7085         end.
     7086         release object vContentItems.
     7087      end.
     7088   end.
     7089   procedure send:
     7090      define input  parameter iDocument as component-handle no-undo.
     7091      define input  parameter iTypeAnswer as character no-undo.
     7092      define input  parameter icomment as character no-undo.
     7093      define output parameter oOperationCode as character no-undo.
     7094      define variable vReplyTask    as component-handle no-undo.
     7095      define variable vTypeAnswer as character no-undo.
     7096      define variable vTypeAnswer_orig as character no-undo.
     7097      define variable Vmes as longchar  no-undo.
     7098      define variable vOrganizationGuid as character no-undo.
     7099      define variable vDocumentid as character no-undo.
     7100      define variable vi as integer no-undo.
     7101      if iDocument ne ?
     7102      then do:
     7103         case iTypeAnswer:
     7104            when "Подписания"                 then vTypeAnswer =  "AcceptDocument".
     7105            when "отказ подписи"              then vTypeAnswer =  "RejectDocument".
     7106            when "запрос коректировки"        then vTypeAnswer =  "CorrectionRequest".
     7107            when "Запрос анулирование"        then vTypeAnswer =  "RevocationRequest".
     7108            when "Подтверждение анулирования" then vTypeAnswer =  "AcceptRevocation".
     7109            when "отказ анулирования"         then vTypeAnswer =  "RejectRevocation".
     7110            when "подписать с расхождениями"  then vTypeAnswer =  "AcceptDocumentWithDisc".
     7111            when "подписать товар не принят"  then vTypeAnswer =  "AcceptDocumentNotAccepted".
     7112            otherwise vTypeAnswer = iTypeAnswer .
     7113         end case.
     7114         vTypeAnswer_orig = vTypeAnswer.
     7115         if    vTypeAnswer =  "AcceptDocumentWithDisc"
     7116            or vTypeAnswer =  "AcceptDocumentNotAccepted"
     7117         then
     7118            vTypeAnswer =  "AcceptDocument".
     7119         if mDiadocConnection:AuthenticateType ne "Certificate" then return error "не сертификат".
     7120         vReplyTask = iDocument:CreateReplySendTask2(vTypeAnswer).
     7121         vOrganizationGuid = iDocument:OrganizationGuid.
     7122         vDocumentid     = iDocument:DocumentId.
     7123         getdesc(iDocument).
     7124         if vTypeAnswer =  "AcceptDocument"
     7125         then do:
     7126            define variable vtitletype as character no-undo.
     7127            vTitleType = GetDocTitleType(vOrganizationGuid,iDocument:TypeNamedId,iDocument:DocumentFunction,iDocument:Version).
     7128            run sendAccept in this-procedure (vTypeAnswer_orig,
     7129                                              vReplyTask,
     7130                                              iDocument:OrganizationGuid,
     7131                                              iDocument:WorkflowId,
     7132                                              vtitletype,
     7133                                              output oOperationCode ) no-error.
     7134            if error-status:error
     7135            then
     7136               return error "".
     7137         end.
     7138         else do:
     7139            find first utd where utd.DocumentExt     = vDocumentid
     7140                             and utd.OrganizationExt = vOrganizationGuid
     7141            no-lock no-error.
     7142            if available utd
     7143            then do:
     7144               if   vTypeAnswer ne  "CorrectionRequest"
     7145                   and vTypeAnswer ne  "RejectDocument"
     7146               then
     7147                  icomment = "".
     7148               if vTypeAnswer eq  "RejectDocument"
     7149               then do:
     7150                  if icomment eq ? or icomment eq "" then icomment = utd.comment.
     7151                  Vmes = (if icomment ne ? and icomment ne "" then icomment + "," else "" ) + GetErrForUtdStr(utd.db-num,utd.doc-id,?).
     7152               end.
     7153               else do:
     7154                   Vmes = GetErrForUtd(utd.db-num,utd.doc-id,?) .
     7155                   Vmes = GetErrComText(icomment,Vmes).
     7156               end.
     7157               if mFlaftest
     7158               then do:
     7159                  output stream File-stream to "SendAnswer.txt" .
     7160                  put stream File-stream unformatted string(Vmes).
     7161                  output stream File-stream close.
     7162                  message "сформирован файл " search("SendAnswer.txt")
     7163                  view-as alert-box.
     7164                  return error "ничего не отправляем".
     7165               end.
     7166               else
     7167                  SendAnswer(vReplyTask,iDocument:OrganizationGuid, iTypeAnswer,Vmes) no-error.
     7168               if error-status:error
     7169               then
     7170                  return error "".
     7171               end.
     7172            end.
     7173         if not mFlaftest
     7174         then do:
     7175            getdesc(vReplyTask).
     7176             vReplyTask:Send() no-error.
     7177            if error-status:num-messages > 0 then do:
     7178               Puterr(substitute("Error Ошибка при выполнение действия по документу &1. ", vDocumentid )).
     7179               release object vReplyTask.
     7180               return error "Ошибка при выполнение дейстия с документом".
     7181            end.
     7182         end.
     7183      end.
     7184   end.
     7185   procedure SendReceiptsAsync :
     7186   define input  parameter idb-num as integer no-undo.
     7187   define input  parameter idoc-id as integer no-undo.
     7188      define variable vDocument as component-handle no-undo.
     7189      define buffer utd for utd.
     7190      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     7191      then do:
     7192         PutMes(substitute("Обработка подписи ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     7193         define variable vAsyncResult   as component-handle no-undo.
     7194         vAsyncResult = vDocument:SendReceiptsAsync().
     7195         release object vDocument.
     7196         PutMes(substitute("Запущена асинхронная обработка ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     7197         find first utd where utd.db-num eq idb-num
     7198                          and utd.doc-id eq idoc-id
     7199         exclusive-lock no-error.
     7200         if available utd
     7201         then do:
     7202            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7203            then do:
     7204                run  UpdateUTDInformOne(vDocument).
     7205               release object vDocument.
     7206            end.
     7207            utd.flagRI = yes.
     7208       end.
     7209         PutMes(vAsyncResult:Result).
     7210         release object vAsyncResult.
     7211         if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7212         then do:
     7213             run  UpdateUTDInformOne(vDocument).
     7214            release object vDocument.
     7215         end.
     7216      end.
     7217   end.
     7218   procedure SendAnsver:
     7219      define input  parameter idb-num as integer no-undo.
     7220      define input  parameter idoc-id as integer no-undo.
     7221      define input  parameter iTypeAnswer as character no-undo.
     7222      define input  parameter iComment as character no-undo.
     7223      define variable vSendcode as character no-undo.
     7224      define variable vDocument as component-handle no-undo.
     7225      define buffer utd for utd.
     7226      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     7227      then do:
     7228         PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2",idb-num,idoc-id,iTypeAnswer)).
     7229          run   SendReceiptsAsync(idb-num,idoc-id).
     7230            find first utd where utd.db-num eq idb-num
     7231                                   and utd.doc-id eq idoc-id
     7232                  no-lock.
     7233         if      (not utd.AmendmentRequested
     7234             and  iTypeAnswer eq "CorrectionRequest")
     7235             or iTypeAnswer ne "CorrectionRequest"
     7236         then do:
     7237             run   send in this-procedure (vDocument,iTypeAnswer,iComment,output vSendcode) no-error.
     7238            if error-status:error
     7239            then do:
     7240               release object vDocument.
     7241               return error return-value.
     7242            end.
     7243            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 Завершина",idb-num,idoc-id,iTypeAnswer)).
     7244         end.
     7245         else
     7246            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 пропущена",idb-num,idoc-id,iTypeAnswer)).
     7247         release object vDocument.
     7248         if     vSendcode ne ?
     7249            and vSendcode ne ""
     7250         then
     7251            setattrutd (idb-num,idoc-id,"sendcode",vSendcode).
     7252         if not mFlaftest
     7253         then do:
     7254            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7255            then do:
     7256                run   UpdateUTDInformOne(vDocument).
     7257               release object vDocument.
     7258            end.
     7259            if    iTypeAnswer eq "CorrectionRequest"
     7260               or iTypeAnswer eq "AcceptRevocation"
     7261               or iTypeAnswer eq "RejectRevocation"
     7262               or iTypeAnswer eq "RejectDocument"
     7263               or iTypeAnswer eq "AcceptDocument"
     7264               or iTypeAnswer eq "AcceptDocumentWithDisc"
     7265               or iTypeAnswer eq "AcceptDocumentNotAccepted"
     7266            then do:
     7267               if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7268               then do:
     7269                   run  UpdateUTDInformOne(vDocument).
     7270                  release object vDocument.
     7271               end.
     7272               if   not mFlaftest
     7273               then do trans:
     7274                  find first utd where utd.db-num eq idb-num
     7275                                   and utd.doc-id eq idoc-id
     7276                                   and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7277                  exclusive-lock no-error.
     7278                  if available utd
     7279                  then do :
     7280                     case iTypeAnswer:
     7281                        when   "AcceptDocument"               then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     7282                        when   "RejectDocument"               then utd.sts-edi = if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     7283                                                                                 then ObjSrv:Env:Utd:Sts:edi:sendAutoRejected:KeyIntDB
     7284                                                                                 else ObjSrv:Env:Utd:Sts:edi:sendRejected:KeyIntDB.
     7285                        when   "CorrectionRequest"            then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendAdjustment:KeyIntDB.
     7286                        when   "AcceptRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     7287                        when   "RejectRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     7288                        when   "AcceptDocumentWithDisc"       then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     7289                        when   "AcceptDocumentNotAccepted"    then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     7290                     end case.
     7291                     if iTypeAnswer eq "CorrectionRequest"
     7292                     then do:
     7293                        utd.sts = ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB.
     7294                        if     utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7295                        then do:
     7296                            run   SendAnsver(idb-num,idoc-id,"AcceptDocumentWithDisc",iComment).
     7297                        end.
     7298                     end.
     7299                  end.
     7300               end.
     7301            end.
     7302         end.
     7303      end.
     7304   end.
     7305   procedure  SendResponse :
     7306      define input  parameter idb-num as integer no-undo.
     7307      define input  parameter idoc-id as integer no-undo.
     7308      define input  parameter iAccept as logical no-undo.
     7309      define input  parameter itestMod as logical no-undo.
     7310       define buffer utd for utd.
     7311       define buffer buf_utd for utd.
     7312       itestMod = not itestMod.
     7313       define variable vreturn as logical no-undo.
     7314       find first utd where utd.db-num eq idb-num
     7315                        and utd.doc-id eq idoc-id
     7316       no-lock no-error.
     7317       if available utd
     7318       then do:
     7319          if utd.EDocType              = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB
     7320          then do:
     7321             if     iAccept
     7322                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientSignature:KeyIntDB
     7323                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientPartiallySignature:KeyIntDB
     7324             then do:
     7325                vreturn = yes.
     7326                if itestMod
     7327                then do:
     7328                   for each buf_utd where buf_utd.PackageId eq utd.PackageId
     7329                                      and buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     7330                                      and buf_utd.Timestamp <= utd.Timestamp
     7331                                      and (     buf_utd.sts-edi   eq objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     7332                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     7333                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     7334                   no-lock :
     7335                       run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"AcceptDocument","")no-error.
     7336                      if error-status:error then return error return-value.
     7337                   end.
     7338                end.
     7339             end.
     7340          end.
     7341          else if utd.EDocType              = objSrv:Env:Utd:EDocType:returns:KeyIntDB
     7342          then do:
     7343             if iAccept
     7344             then do:
     7345                vreturn = yes.
     7346                if itestMod
     7347                then do:
     7348                   define variable vsend as logical no-undo.
     7349                   vsend = logical(getattrutdex (idb-num,idoc-id,"returnSend","no")).
     7350                   if vsend
     7351                   then
     7352                      return error "Документ был отправлен рание. Повторная отправка возможна через сервис.".
     7353                   find first buf_utd where buf_utd.OrganizationExt eq utd.parentOrganizationExt
     7354                                        and buf_utd.DocumentExt     eq utd.parentDocumentExt
     7355                   no-lock no-error.
     7356                   if available buf_utd
     7357                   then do:
     7358                      if getattrutd (idb-num,idoc-id,"TypeUTD") ne "счфДОП"
     7359                      then do:
     7360                          run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"CorrectionRequest",GetErrForUtd(utd.db-num,utd.doc-id,"return"))no-error.
     7361                         if error-status:error then return error return-value.
     7362                      end.
     7363                   end.
     7364                   run bge/sendutd.p(
     7365                        parparentproc,
     7366                        mDiadocConnection:Certificate:Thumbprint,
     7367                        idb-num,
     7368                        idoc-id) no-error.
     7369                   if error-status:error then return error return-value.
     7370                   do trans :
     7371                      find first utd where utd.db-num eq idb-num
     7372                                       and utd.doc-id eq idoc-id
     7373                      exclusive-lock no-error.
     7374                      utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB.
     7375                      setattrutd (idb-num,idoc-id,"returnSend","yes").
     7376                   end.
     7377                end.
     7378             end.
     7379          end.
     7380          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     7381          then do:
     7382             if iAccept
     7383             then do:
     7384                vreturn = yes.
     7385                if itestMod
     7386                then
     7387                    run  SendReceiptsAsync(idb-num,idoc-id).
     7388             end.
     7389          end.
     7390          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB
     7391          then do:
     7392             if not iAccept
     7393             then do:
     7394                vreturn = yes.
     7395                if itestMod
     7396                then do:
     7397                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     7398                   if error-status:error then return error return-value.
     7399                end.
     7400             end.
     7401          end.
     7402          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:RequestsMyRevocation:KeyIntDB
     7403          then do:
     7404             vreturn = yes.
     7405             if iAccept
     7406             then do:
     7407                if itestMod
     7408                then do:
     7409                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptRevocation","") no-error.
     7410                   if error-status:error then return error return-value.
     7411                end.
     7412             end.
     7413             else do:
     7414                if itestMod
     7415                then do:
     7416                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectRevocation","")no-error.
     7417                   if error-status:error then return error return-value.
     7418                end.
     7419             end.
     7420          end.
     7421          else if   utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Changed:KeyIntDB
     7422                 or utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     7423          then do:
     7424             vreturn = yes.
     7425             if iAccept
     7426             then do:
     7427                if itestMod
     7428                then do:
     7429                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocument","")no-error.
     7430                   if error-status:error then return error return-value.
     7431                end.
     7432             end.
     7433             else do:
     7434                if itestMod
     7435                then do:
     7436                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     7437                   if error-status:error then return error return-value.
     7438                end.
     7439             end.
     7440          end.
     7441          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     7442          then do:
     7443             if iAccept
     7444             then do:
     7445                vreturn = yes.
     7446                if itestMod
     7447                then do:
     7448                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     7449                   if error-status:error then return error return-value.
     7450                end.
     7451             end.
     7452          end.
     7453          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureAdjustment:KeyIntDB
     7454          then do:
     7455             if iAccept
     7456             then do:
     7457                vreturn = yes.
     7458                if itestMod
     7459                then do:
     7460                    run  SendAnsver in this-procedure (idb-num,idoc-id,"CorrectionRequest","")no-error.
     7461                   if error-status:error then return error return-value.
     7462                end.
     7463             end.
     7464          end.
     7465          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureNotAccepted:KeyIntDB
     7466          then do:
     7467             if iAccept
     7468             then do:
     7469                vreturn = yes.
     7470                if itestMod
     7471                then do:
     7472                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocumentNotAccepted","")no-error.
     7473                   if error-status:error then return error return-value.
     7474                end.
     7475             end.
     7476          end.
     7477          if itestmod and not vreturn
     7478          then do:
     7479             PutMes (substitute('Error Документ с № "&5" в.н. "&2" по БД "&1" в статусе "&3" выполнить операцию "&4" не возможно.',
     7480                                utd.db-num,
     7481                                utd.doc-id,
     7482                                ObjSrv:Env:Utd:Sts:EDI:GetLabel(utd.sts-edi),
     7483                                if iAccept then "Подписать" else "Отказать",
     7484                                utd.DocumentNumber)
     7485                                ).
     7486          end.
     7487       end.
     7488       return string(vreturn).
     7489   end.
     7490   define temp-table tt-pack no-undo
     7491             field orgid as char
     7492             field docid as char
     7493             field packid as char
     7494             field stamp as datetime
     7495             index pi packid   stamp   orgid  docid
     7496             .
     7497   function CheckLoad returns logical
     7498   (iDocument as component-handle,
     7499    output ohost-code as integer ,
     7500    output oObj-type  as character  ,
     7501    output oObj-code  as integer ):
     7502      define variable vFlag as logical no-undo.
     7503      define variable vDocumentChild as component-handle no-undo.
     7504      define variable vContent as component-handle no-undo.
     7505      define variable vConsignees as component-handle no-undo.
     7506      define variable vfilename as character no-undo.
     7507      oObj-type  = ?.
     7508      oObj-code  = ?.
     7509      ohost-code = ?.
     7510      define buffer ext-classif   for ext-classif.
     7511      define buffer clients       for clients.
     7512      define buffer buf_clients   for clients.
     7513      define buffer clients-attr  for clients-attr.
     7514      if   iDocument:type eq "UniversalTransferDocument"
     7515        or iDocument:type eq "UniversalTransferDocumentRevision"
     7516      then main-block :
     7517      do on error undo main-block, return error:
     7518         getdesc(iDocument).
     7519         vfilename = iDocument:filename.
     7520         if iDocument:Direction eq "Inbound"
     7521         then do:
     7522            define variable vOrganizationGuid as character no-undo.
     7523            define variable vDocumentid as character no-undo.
     7524            vOrganizationGuid = iDocument:OrganizationGuid.
     7525            vDocumentid     = iDocument:DocumentId.
     7526            find first utd where utd.DocumentExt     = vDocumentid
     7527                             and utd.OrganizationExt = vOrganizationGuid
     7528            no-lock no-error .
     7529            if available utd
     7530            then do:
     7531               assign
     7532                  Oobj-type = utd.obj-type
     7533                  Oobj-code = utd.obj-code
     7534                  ohost-code = utd.host-code.
     7535               .
     7536            end.
     7537            vDocumentChild = iDocument:GetDynamicContent("Seller") no-error.
     7538            getdesc(vDocumentChild).
     7539            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     7540               and ohost-code ne 0 and ohost-code ne ?)
     7541            then vFlag = no.
     7542            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     7543               and (ohost-code eq 0 and ohost-code eq ?))
     7544            then do:
     7545                find first clients  where clients.obj-type   = Oobj-type
     7546                                      and clients.obj-code   = Oobj-code
     7547                no-lock no-error .
     7548                if available clients
     7549                then
     7550                   ohost-code =  clients.host-code.
     7551                vFlag = no.
     7552            end.
     7553            else if vDocumentChild ne ?
     7554            then do:
     7555               if iDocument:version  eq "utd820_05_01_01"
     7556               then do:
     7557                  vContent = vDocumentChild:UniversalTransferDocument no-error.
     7558               end.
     7559               else
     7560                  vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     7561               release object vDocumentChild.
     7562               if vContent ne ?
     7563               then do:
     7564                  getdesc(vContent).
     7565                  define variable vFnsParticipantId as character no-undo.
     7566                  define variable vinn as character no-undo.
     7567                  define variable vkpp as character no-undo.
     7568                  define variable vorgname as character no-undo.
     7569                  define variable vAddrOrg as character no-undo.
     7570                  define variable vAdditionalInfo as character no-undo.
     7571                  if iDocument:version  eq "utd820_05_01_01"
     7572                  then do:
     7573                     getdesc(vContent:Sellers).
     7574                     getdesc(vContent:Sellers:Seller).
     7575                     getdesc(vContent:Sellers:Seller:GetItem(0)).
     7576                     getdesc(vContent:Sellers:Seller:GetItem(0):OrganizationDetails).
     7577                     getOrganizationInfo(vContent:Sellers:Seller:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7578                  end.
     7579                  else do:
     7580                     vFnsParticipantId =  vContent:SenderFnsParticipantId.
     7581                  end.
     7582                  find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     7583                                           and ext-classif.charkey_three eq vFnsParticipantId
     7584                  no-lock no-error.
     7585                  if available ext-classif
     7586                  then do:
     7587                     find first clients
     7588                       where clients.obj-type   = ext-classif.CharKey_One
     7589                         and clients.obj-code   = ext-classif.Key#_One
     7590                         and not can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     7591                     no-lock no-error .
     7592                     if not available clients
     7593                     then do:
     7594                        PutMes(substitute("По &1 отправитель &2 наша фирма." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7595                        return no.
     7596                     end.
     7597                  end.
     7598                  else do:
     7599                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7600                     return no.
     7601                  end.
     7602                  if iDocument:version  eq "utd820_05_01_01"
     7603                  then do:
     7604                     getdesc(vContent:Buyers).
     7605                     getdesc(vContent:Buyers:Buyer).
     7606                     getdesc(vContent:Buyers:Buyer:GetItem(0)).
     7607                     getOrganizationInfo(vContent:Buyers:Buyer:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo,output vAddrOrg).
     7608                  end.
     7609                  else do:
     7610                     vConsignees = vContent:Consignees.
     7611                     getdesc(vConsignees).
     7612                     getdesc(vConsignees:Consignee).
     7613                     if vConsignees:Consignee:count > 0
     7614                     then do:
     7615                        getdesc(vConsignees:Consignee:GetItem(0)).
     7616                        getOrganizationInfo(vConsignees:Consignee:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7617                     end.
     7618                     release object vConsignees.
     7619                     vFnsParticipantId = vContent:RecipientFnsParticipantId.
     7620                  end.
     7621                  release object vContent.
     7622                  define variable otext as character no-undo.
     7623                  vFlag = getObgFns
     7624                             (input iDocument:DocumentNumber ,
     7625                              input vFnsParticipantId ,
     7626                              input vkpp,
     7627                              output ohost-code,
     7628                              output oobj-type,
     7629                              output oobj-code,
     7630                              output otext ).
     7631                  if otext ne "" and otext ne ?
     7632                  then
     7633                     PutMes( otext).
     7634                  if vFlag  eq no
     7635                  then
     7636                     return vFlag .
     7637               end.
     7638               else do:
     7639                  PutMes("Error Ошибка получения данных из Диадок UniversalTransferDocument" + if iDocument:version  eq "utd820_05_01_01" then "" else "WithHyphens").
     7640                  return no.
     7641               end.
     7642            end.
     7643            else do:
     7644               PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     7645               return no.
     7646            end.
     7647         end.
     7648         else
     7649            return yes.
     7650         if ohost-code eq ? or ohost-code eq 0
     7651         then do:
     7652            PutMes(substitute("По &1 не удалось определить фирму по получателю  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7653            return no.
     7654         end.
     7655      end.
     7656      else do:
     7657         define variable vdb-num as integer no-undo.
     7658         define variable vdoc-id as integer no-undo.
     7659         define variable vpack as character no-undo init ?.
     7660         define variable vcli-type as character no-undo.
     7661         define variable vcli-code as integer no-undo.
     7662         define variable vfns as character no-undo.
     7663         define variable vchar as character no-undo.
     7664         vDocumentChild = iDocument:GetDynamicContent("Seller")no-error.
     7665         if vDocumentChild eq ?
     7666         then do:
     7667            PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     7668            return no.
     7669         end.
     7670         vContent = vDocumentChild:UniversalCorrectionDocument no-error.
     7671         if vContent ne ?
     7672         then do:
     7673            getOrganizationInfo(vContent:Seller,output vchar,output vchar,vFns, output vchar,  output vchar, output vchar).
     7674            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     7675                                     and ext-classif.charkey_three eq vFns
     7676            no-lock no-error.
     7677            if available ext-classif
     7678            then do:
     7679               assign
     7680                  vcli-type = ext-classif.CharKey_One
     7681                  vcli-code = ext-classif.Key#_One
     7682               .
     7683               vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     7684               GetprevUTDForPac(vpack,iDocument:Timestamp,output vdb-num,output vdoc-id ).
     7685               release object vContent.
     7686            end.
     7687            else do:
     7688                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7689                     return no.
     7690                  end.
     7691         end.
     7692         else do:
     7693            PutErr("Error Ошибка получения данных из Диадок Seller").
     7694            return no.
     7695         end.
     7696         release object vDocumentChild.
     7697         define buffer     utd for utd.
     7698         find first utd where utd.db-num eq vdb-num
     7699                          and utd.doc-id eq vdoc-id
     7700         no-lock no-error.
     7701         if available utd
     7702         then do:
     7703            assign
     7704               oobj-type  = utd.obj-type
     7705               oobj-code  = utd.obj-code
     7706               ohost-code = utd.host-code
     7707               vfilename  = getattrutd (utd.db-num,utd.doc-id,"FileName")
     7708            .
     7709         end.
     7710         else do:
     7711            PutMes(substitute("Не найден оригенальный документ по пакету &1.",vpack)).
     7712            return no.
     7713         end.
     7714      end.
     7715      if  yes
     7716      then do:
     7717         define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     7718         EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(oobj-type, oobj-code).
     7719         if     not EDOParSec:IsEdo
     7720            and vfilename begins "ON_NSCHFDOPPRMARK_"
     7721         then do:
     7722            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для маркированного товара.",oobj-type,oobj-code)).
     7723            vFlag = no.
     7724         end.
     7725         else if     not EDOParSec:IsEdoNotmark
     7726                 and not vfilename begins "ON_NSCHFDOPPRMARK_"
     7727         then do:
     7728            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для не маркированного товара.",oobj-type,oobj-code)).
     7729            vFlag = no.
     7730         end.
     7731         else
     7732            vFlag = yes.
     7733      end.
     7734      return vFlag.
     7735   end.
     7736   procedure  UpdateUTDInformOne :
     7737      define input  parameter iDocument as component-handle no-undo.
     7738      define variable vOrganizationGuid as character no-undo.
     7739      define variable vDocumentId as character no-undo.
     7740      define variable vi as integer no-undo.
     7741      define variable vii as integer no-undo.
     7742      define variable viii as integer no-undo.
     7743      define variable vtext as longchar no-undo.
     7744      define buffer utd           for ub.utd.
     7745      define buffer old_utd           for ub.utd.
     7746      define buffer utd-lines      for ub.utd-lines.
     7747      define buffer marking       for ub.marking.
     7748      define buffer marking-lines for ub.marking-lines.
     7749      define buffer utd-marking-lines for ub.utd-marking-lines.
     7750      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     7751      define variable vDocumentChild               as component-handle no-undo.
     7752      define variable vContent                     as component-handle no-undo.
     7753      define variable vValues                      as component-handle no-undo.
     7754      define variable vSellers                     as component-handle no-undo.
     7755      define variable vConsignees                  as component-handle no-undo.
     7756      define variable vInvoiceTable                as component-handle no-undo.
     7757      define variable vItems                       as component-handle no-undo.
     7758      define variable vExtendedInvoiceItem         as component-handle no-undo.
     7759      define variable vItemIdentificationNumber    as component-handle no-undo.
     7760      define variable vTransferBaseCol             as component-handle no-undo.
     7761      define variable vTransferBase                as component-handle no-undo.
     7762      define variable vorgname as character no-undo.
     7763      define variable vAddrOrg as character no-undo.
     7764      define variable vAdditionalInfo as character no-undo.
     7765      define variable volddb-num as integer no-undo.
     7766      define variable volddoc-id as integer no-undo.
     7767      define variable vunits  as component-handle no-undo.
     7768      define variable vunit   as component-handle no-undo.
     7769      define variable VValue  as character        no-undo.
     7770      define variable vsite   as character        no-undo.
     7771      define variable vNewUtd as logical          no-undo.
     7772      if iDocument eq ?
     7773      then
     7774        return.
     7775      vOrganizationGuid = iDocument:OrganizationGuid.
     7776      vDocumentid     = iDocument:DocumentId.
     7777      find first utd where utd.DocumentExt     = vDocumentid
     7778                       and utd.OrganizationExt = vOrganizationGuid
     7779      no-lock no-error .
     7780      find first tt-recid where tt-recid.orgid eq vOrganizationGuid
     7781                            and tt-recid.docid eq vDocumentid
     7782      no-lock no-error.
     7783      if not available tt-recid
     7784      then do trans:
     7785         if iDocument  ne ?
     7786            and (
     7787                     iDocument:type eq "UniversalTransferDocument"
     7788                  or iDocument:type eq "UniversalTransferDocumentRevision"
     7789                  or iDocument:type eq "UniversalCorrectionDocument"
     7790                 )
     7791         then do:
     7792            PutMes(substitute("Загрузка документа  &1 от &2." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7793            define variable vhost-code as integer   no-undo.
     7794            define variable vobj-type  as character no-undo.
     7795            define variable vobj-code  as integer   no-undo.
     7796            if not CheckLoad(iDocument,output vhost-code,output vobj-type,output  vobj-code )
     7797            then do:
     7798               PutMes(substitute("Документ &1 от &2 пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7799               create tt-recid.
     7800               assign
     7801                  tt-recid.orgid = vOrganizationGuid
     7802                  tt-recid.docid = vDocumentid
     7803               .
     7804               return.
     7805            end.
     7806            find first utd where utd.DocumentExt     = vDocumentid
     7807                             and utd.OrganizationExt = vOrganizationGuid
     7808            no-lock no-error  .
     7809            if available utd
     7810            then do:
     7811               if     utd.sts-edi > ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7812                  and iDocument:RevocationStatus ne "RequestsMyRevocation"
     7813               then do:
     7814                  create tt-recid.
     7815                  assign
     7816                     tt-recid.orgid = vOrganizationGuid.
     7817                     tt-recid.docid = vDocumentid
     7818                  .
     7819                  PutMes(substitute("Документ &1 от &2 в конечном статусе. Документ пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7820               end.
     7821               find current utd exclusive-lock no-error  no-wait  .
     7822               if  not available  utd
     7823               then do:
     7824                  PutMes(substitute("Документ &1 от &2 заблокирован и будет пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate )).
     7825                  return.
     7826               end.
     7827            end.
     7828            subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     7829            MySeqUtd = ?.
     7830            if     not available  utd
     7831            then do:
     7832               create utd.
     7833               assign
     7834                  utd.DocumentExt      = vDocumentid
     7835                  utd.OrganizationExt  = vOrganizationGuid
     7836                  vNewUtd              = yes
     7837               .
     7838               validate utd.
     7839            end.
     7840            assign
     7841               utd.host-code = vhost-code when vhost-code ne ? and vhost-code ne 0
     7842               utd.obj-code  = vobj-code  when vobj-code  ne ? and vobj-code  ne 0
     7843               utd.obj-type  = vobj-type  when vobj-type  ne ? and vobj-type  ne ""
     7844            .
     7845            setattrutd (utd.db-num,utd.doc-id,"FileName",iDocument:FileName).
     7846            utd.RevocationStatus = iDocument:RevocationStatus.
     7847            utd.RecipientResponseStatus          = iDocument:RecipientResponseStatus.
     7848            utd.TypeId           = iDocument:type.
     7849            utd.CounteragentId   = iDocument:Counteragent:guid.
     7850            utd.CustomDocumentId = iDocument:CustomDocumentId.
     7851            utd.sts-edi = ?.
     7852            utd.DocumentNumber = iDocument:DocumentNumber.
     7853            utd.DocumentDate   = date(iDocument:DocumentDate).
     7854            utd.Timestamp      = datetime(iDocument:Timestamp) .
     7855            utd.ReceiptStatus  = iDocument:RecipientReceiptMetadata:ReceiptStatus.
