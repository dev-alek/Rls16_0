     8260                               getdesc(vExtendedInvoiceItem:Vat ).
     8261                               getdesc(vExtendedInvoiceItem:WithoutVat).
     8262                               getdesc(vExtendedInvoiceItem:Subtotal ).
     8263                               getdesc(vExtendedInvoiceItem:ItemTracingInfos ).
     8264                               getdesc(vExtendedInvoiceItem:ItemTracingInfos:ItemTracingInfo ).
     8265                               vValues = vExtendedInvoiceItem:CorrectedItemIdentificationNumbers.
     8266                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Unit",string(vExtendedInvoiceItem:Unit:CorrectedValue)).
     8267                               utd-lines.Price       = vExtendedInvoiceItem:Price:CorrectedValue.
     8268                               utd-lines.TotalWithVatExcluded   = vExtendedInvoiceItem:SubtotalWithVatExcluded:CorrectedValue.
     8269                               utd-lines.UnitCode    = vExtendedInvoiceItem:UnitName:CorrectedValue.
     8270                               utd-lines.TaxRate   =   if  vExtendedInvoiceItem:TaxRate:CorrectedValue eq "без ндс" then -1 else decimal(trim(entry(1,vExtendedInvoiceItem:TaxRate:CorrectedValue,"/"),"%")).
     8271                               utd-lines.Vat       = vExtendedInvoiceItem:Vat:CorrectedValue.
     8272                               utd-lines.Total     = vExtendedInvoiceItem:Subtotal:CorrectedValue.
     8273                               vQuantity    = dec(vExtendedInvoiceItem:Quantity:CorrectedValue) - dec(vExtendedInvoiceItem:Quantity:OriginalValue).
     8274                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(vQuantity)).
     8275                               utd-lines.Price       = utd-lines.Price - vExtendedInvoiceItem:Price:OriginalValue.
     8276                               utd-lines.Vat       = utd-lines.Vat - vExtendedInvoiceItem:Vat:OriginalValue.
     8277                               utd-lines.Total     = utd-lines.Total  - vExtendedInvoiceItem:Subtotal:OriginalValue.
     8278                               utd-lines.TotalWithVatExcluded   = utd-lines.TotalWithVatExcluded - vExtendedInvoiceItem:SubtotalWithVatExcluded:OriginalValue.
     8279                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old",string( vExtendedInvoiceItem:Quantity:OriginalValue)).
     8280                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Price_old"   ,string( vExtendedInvoiceItem:Price:OriginalValue)).
     8281                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TotalWithVatExcluded", string( vExtendedInvoiceItem:SubtotalWithVatExcluded:OriginalValue)).
     8282                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TaxRate_old", string(  if  vExtendedInvoiceItem:TaxRate:OriginalValue eq "без ндс" then -1 else decimal(trim(entry(1,vExtendedInvoiceItem:TaxRate:OriginalValue,"/"),"%")))).
     8283                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Vat_old"    , string( vExtendedInvoiceItem:Vat:OriginalValue)).
     8284                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Total_old",       string( vExtendedInvoiceItem:Subtotal:OriginalValue)).
     8285                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"UnitCode_old", vExtendedInvoiceItem:UnitName:OriginalValue).
     8286                            end.
     8287                            vunits = vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo.
     8288                            getdesc(vunits).
     8289                            do vii = 1 to vunits:count:
     8290                               vunit = vunits:GETITEM(vii - 1).
     8291                               getdesc(vunit).
     8292                               if     vunit:Id eq "штрихкод"
     8293                                   or vunit:Id eq "ean"
     8294                               then do:
     8295                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,vunit:Id,vunit:value).
     8296                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode",vunit:value).
     8297                                  find first utd-marking-lines where       utd-marking-lines.db-num     = utd-lines.db-num
     8298                                                                 and utd-marking-lines.doc-id     = utd-lines.doc-id
     8299                                                                 and utd-marking-lines.Linenum    = utd-lines.Linenum
     8300                                  no-lock no-error.
     8301                                  if not available utd-marking-lines
     8302                                  then do:
     8303                                    vtext = vunit:Value.
     8304                                    do viii = 1 to num-entries(vtext," "):
     8305                                       VValue = entry(viii,vtext," ").
     8306                                       addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, "",iDocument:type).
     8307                                    end.
     8308                                 end.
     8309                              end.
     8310                              release object  vunit.
     8311                           end.
     8312                           release object  vunits.
     8313                            release object vExtendedInvoiceItem.
     8314                         end.
     8315                         release object vItems.
     8316                     end.
     8317                     release object vContent.
     8318                  end.
     8319                  else do:
     8320                     create tt-recid.
     8321                     assign
     8322                        tt-recid.orgid = vOrganizationGuid
     8323                        tt-recid.docid = vDocumentid
     8324                     .
     8325                     PutMes("Error Ошибка получения данных из Диадок UniversalCorrectionDocument").
     8326                     release object vDocumentChild.
     8327                     return error "Ошибка получения данных из Диадок UniversalCorrectionDocument".
     8328                  end.
     8329               end.
     8330            end.
     8331            release object vDocumentChild.
     8332            define variable vsetPAck as logical no-undo.
     8333            define variable vcli-type as character no-undo.
     8334            define variable vcli-code as integer no-undo.
     8335            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     8336                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     8337            no-lock no-error.
     8338            if available ext-classif
     8339            then do:
     8340               assign
     8341                  vcli-type = ext-classif.CharKey_One
     8342                  vcli-code = ext-classif.Key#_One
     8343               .
     8344               define variable vPack as character no-undo.
     8345               if   iDocument:type eq "UniversalTransferDocument"
     8346               then
     8347                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,utd.DocumentNumber,utd.DocumentDate).
     8348               else if iDocument:type eq "UniversalTransferDocumentRevision"
     8349               then
     8350                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalDocumentNumber,date(iDocument:OriginalDocumentDate)).
     8351               else
     8352                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     8353               if vPack ne utd.PackageId
     8354               then
     8355                  assign
     8356                     vsetPAck      = yes
     8357                     utd.PackageId = vPack
     8358                  .
     8359            end.
     8360            if vNewUtd or vsetPAck then do:
     8361               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     8362               then do:
     8363                  if vNewUtd  then do:
     8364                     GetLastUTDinPackbef(utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     8365                     find first old_utd where old_utd.db-num eq volddb-num
     8366                                          and old_utd.doc-id eq volddoc-id
     8367                        no-lock no-error.
     8368                     for each utd-marking-lines where utd-marking-lines.db-num eq utd.db-num
     8369                                                  and utd-marking-lines.doc-id eq utd.doc-id
     8370                     exclusive-lock:
     8371                        if available old_utd
     8372                           and utd.db-num ne volddb-num
     8373                           and utd.doc-id ne volddoc-id
     8374                        then
     8375                           find first buf_utd-marking-lines where buf_utd-marking-lines.mark       = utd-marking-lines.mark
     8376                                                              and buf_utd-marking-lines.db-num     = old_utd.db-num
     8377                                                              and buf_utd-marking-lines.doc-id     = old_utd.doc-id
     8378                           no-lock no-error.
     8379                        utd-marking-lines.sts = if available buf_utd-marking-lines then buf_utd-marking-lines.sts else  objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     8380                     end.
     8381                     validate utd.
     8382                     ReCheckload( utd.db-num, utd.doc-id,yes).
     8383                     subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     8384                  end.
     8385               end.
     8386               else do:
     8387                  GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     8388                  find first old_utd where old_utd.db-num eq volddb-num
     8389                                       and old_utd.doc-id eq volddoc-id
     8390                  no-lock no-error.
     8391                  if not available old_utd
     8392                     or (   utd.db-num eq volddb-num
     8393                        and utd.doc-id eq volddoc-id)
     8394                  then
     8395                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoAvailDoc",string(utd.PackageId) + chr(4) + string(utd.db-num) + chr(4) + string(utd.doc-id)).
     8396                  else do:
     8397                      assign
     8398                          utd.obj-inn               = old_utd.obj-inn
     8399                          utd.obj-kpp               = old_utd.obj-kpp
     8400                          utd.obj-FnsParticipantId  = old_utd.obj-FnsParticipantId
     8401                          utd.obj-info              = old_utd.obj-info
     8402                          utd.parentDocumentExt     = old_utd.DocumentExt
     8403                          utd.parentOrganizationExt = old_utd.OrganizationExt
     8404                          utd.contract-code         = old_utd.contract-code
     8405                      .
     8406                  end.
     8407                  validate utd.
     8408                  SaturateAndCheckUTD( utd.db-num, utd.doc-id).
     8409               end.
     8410            end.
     8411            GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     8412            find first old_utd where old_utd.db-num eq volddb-num
     8413                                 and old_utd.doc-id eq volddoc-id
     8414            no-lock no-error.
     8415            if available old_utd
     8416            then
     8417               assign
     8418                  utd.parentDocumentExt     = old_utd.DocumentExt
     8419                  utd.parentOrganizationExt = old_utd.OrganizationExt
     8420               .
     8421            create tt-recid.
     8422            assign
     8423               tt-recid.orgid = vOrganizationGuid
     8424               tt-recid.docid = vDocumentid
     8425            .
     8426            if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     8427            then do:
     8428               tt-recid.parent = utd.PackageId.
     8429               tt-recid.stamp  = utd.Timestamp.
     8430            end.
     8431            release utd no-error.
     8432            if error-status:error
     8433            then
     8434               PutMes(substitute("Документ &1 от &2 не загружен. &3" ,iDocument:DocumentNumber,iDocument:DocumentDate,return-value) ).
     8435            else
     8436               PutMes(substitute("Документ &1 от &2 загружен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     8437            unsubscribe "getNextseq".
     8438         end.
     8439      end.
     8440   end.
     8441   function packetupdd returns date
     8442   (iOrganization as component-handle, iDocument as component-handle):
     8443      define variable VPack as character no-undo.
     8444      define variable vorgid as character no-undo.
     8445      define variable vdocid as character no-undo.
     8446      define variable vstamp as datetime no-undo.
     8447      define variable VPack2 as character no-undo.
     8448      define variable vorgid2 as character no-undo.
     8449      define variable vdocid2 as character no-undo.
     8450      define variable vstamp2 as datetime no-undo.
     8451      define variable VPackage as component-handle no-undo.
     8452      define variable vi as integer no-undo.
     8453      define variable vDocument as component-handle no-undo.
     8454      define variable vDocuments as component-handle no-undo.
     8455         VPack = iDocument:PackageId.
     8456         vorgid = iDocument:OrganizationGuid.
     8457         vdocid = iDocument:DocumentId.
     8458         vstamp = iDocument:Timestamp.
     8459         find first tt-pack where tt-pack.packid eq VPack
     8460                              and tt-pack.stamp  eq vstamp
     8461                              and tt-pack.orgid  eq vorgid
     8462                              and tt-pack.docid  eq vdocid
     8463         no-lock no-error.
     8464         if not available tt-pack
     8465         then do:
     8466            create tt-pack.
     8467            assign
     8468               tt-pack.packid = VPack
     8469               tt-pack.stamp  = vstamp
     8470               tt-pack.orgid  = vorgid
     8471               tt-pack.docid  = vdocid
     8472            .
     8473         end.
     8474         getdesc(iDocument ).
     8475         getdesc(iDocument:InitialDocumentIds ).
     8476         vDocuments = iDocument:InitialDocumentIds.
     8477         do vi= 1 to vDocuments:Count:
     8478            vDocument = iOrganization:GetDocumentById(vDocuments:GetItem(vi - 1),false).
     8479            getdesc(vDocument ).
     8480            vorgid2 = vDocument:OrganizationGuid.
     8481            vdocid2 = vDocument:DocumentId.
     8482            vstamp2 = vDocument:Timestamp.
     8483            find first tt-pack where tt-pack.packid eq VPack
     8484                                 and tt-pack.stamp  eq vstamp2
     8485                                 and tt-pack.orgid  eq vorgid2
     8486                                 and tt-pack.docid  eq vdocid2
     8487            no-lock no-error.
     8488            if not available tt-pack
     8489            then do:
     8490               create tt-pack.
     8491               assign
     8492                  tt-pack.packid = VPack
     8493                  tt-pack.stamp  = vstamp2
     8494                  tt-pack.orgid  = vorgid2
     8495                  tt-pack.docid  = vdocid2
     8496               .
     8497            end.
     8498            release object vDocument.
     8499         end.
     8500         release object vDocuments.
     8501   end.
     8502   procedure UpdateUTDInform:
     8503      define input  parameter ibeg-date as date no-undo.
     8504      define input  parameter iend-date as date no-undo.
     8505      define output parameter odatelast as date no-undo.
     8506      define variable vOrganizationList as component-handle no-undo.
     8507      define variable vOrganization as component-handle no-undo.
     8508      define variable vDocumentsTask as component-handle no-undo.
     8509      define variable vDocumentList  as component-handle no-undo.
     8510      define variable vDocumentchildList  as component-handle no-undo.
     8511      define variable vDocument       as component-handle no-undo.
     8512      define buffer ext-classif_obj for ext-classif.
     8513      define buffer ext-classif_Cli  for ext-classif.
     8514      define variable vi  as integer no-undo.
     8515      define variable vii as integer no-undo.
     8516      odatelast = ibeg-date.
     8517      vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     8518      if vOrganizationList eq ? then return error ?.
     8519      vi = vOrganizationList:Count()no-error.
     8520      if vi eq ?
     8521      then
     8522         return error ?.
     8523      for each tt-recid:
     8524         delete tt-recid.
     8525      end.
     8526      for each tt-pack:
     8527         delete tt-pack.
     8528      end.
     8529      do vi = 1 to vOrganizationList:Count() :
     8530         vOrganization = vOrganizationList:GetItem(vi - 1 ).
     8531         getdesc(vOrganization).
     8532         run changeIdtoGuid(vOrganization).
     8533         vDocumentsTask = vOrganization:GetDocumentsTask().
     8534                     vDocumentsTask:FromSendDate = ibeg-date  .
     8535                     vDocumentsTask:ToSendDate   = iend-date.
     8536                     for each tt-type, each tt-Class:
     8537                         vDocumentsTask:Category     = tt-type.id + "." + tt-Class.id.
     8538                        PutMes(substitute("Формируем список зависимых документов за период с &2 по &3  &1Категория: &4 &5",
     8539                                          chr(10),
     8540                                          ibeg-date ,
     8541                                          iend-date,
     8542                                          if tt-type .id eq "Any" then "" else tt-type.name,
     8543                                          tt-Class.name)).
     8544                         vDocumentList = vDocumentsTask:GetDocuments() no-error.
     8545                         if vDocumentList ne ?
     8546                         then do:
     8547                           do vii= 1 to vDocumentList:Count:
     8548                              if chekStop() then return ?.
     8549                              vDocument = vDocumentList:GetItem(vii - 1).
     8550                              odatelast = max(odatelast,vDocument:DocumentDate) no-error.
     8551                              odatelast = min(odatelast,today).
     8552                              packetupdd(vOrganization, vDocument).
     8553                              release object vDocument.
     8554                            end.
     8555                            release object vDocumentList.
     8556                         end.
     8557                      end.
     8558                      define variable VAlldoc    as integer no-undo.
     8559                      define variable vprocessed as integer no-undo.
     8560                      for each tt-pack :
     8561                         VAlldoc = VAlldoc + 1.
     8562                      end.
     8563                      for each tt-pack :
     8564                          if chekStop() then return ?.
     8565                         if GetDocumforid (tt-pack.orgid, tt-pack.docid, output vDocument) eq ""
     8566                         then do:
     8567                             run  UpdateUTDInformOne(vDocument).
     8568                            release object vDocument.
     8569                        end.
     8570                        vprocessed = vprocessed + 1.
     8571                        PutStat (substitute ("Обработано документов &1 из &2",vprocessed,vAllDoc),yes).
     8572                     end.
     8573         release object vOrganization.
     8574         release object vDocumentsTask.
     8575      end.
     8576      release object vOrganizationList.
     8577   end.
     8578   procedure updOneUTD:
     8579      define input  parameter idb-num as integer no-undo.
     8580      define input  parameter idoc-id as integer no-undo.
     8581      define variable vDocument as component-handle no-undo.
     8582      define buffer utd for utd.
     8583      for each tt-recid:
     8584         delete tt-recid.
     8585      end.
     8586      if getdocum (idb-num, idoc-id, output vDocument) eq ""
     8587      then do:
     8588          run  UpdateUTDInformOne(vDocument).
     8589         release object vDocument.
     8590      end.
     8591   end.
     8592   function CRnewDocum return character
     8593   (
     8594   iOrgGuid as character,
     8595   iContGuid as character,
     8596   iTypeUTD as character,
     8597    iFile as character
     8598    ):
     8599   define variable vOrganization as component-handle no-undo.
     8600   define variable vSendTask as component-handle no-undo.
     8601       vOrganization = mDiadocConnection:GetOrganizationById(iOrgGuid ) no-error.
     8602       if vOrganization ne ?
     8603       then do:
     8604          vSendTask = vOrganization:CreatePackageSendTask2().
     8605          getdesc(vSendTask).
     8606          vSendTask:CounteragentId = iContGuid  .
     8607          vSendTask:AddDocumentFromFile("UniversalTransferDocument", iTypeUTD, "utd820_05_01_01", iFile).
     8608          vSendTask:Send()no-error.
     8609          if error-status:num-messages > 0 then do:
     8610             PutErr("ERROR Ошибка отправки документа").
     8611             return error "ERROR Ошибка отправки документа".
     8612          end.
     8613          else do:
     8614             PutMes("Документ отправлен успешно.").
     8615             message "Документ отправлен успешно."
     8616             view-as alert-box.
     8617          end.
     8618          release object vSendTask.
     8619         release object vOrganization .
     8620      end.
     8621   end.
     8622   procedure MySeqForUtd:
     8623      define input  parameter iTable       as character no-undo.
     8624      define input  parameter iseqnamehist as character no-undo.
     8625      define input  parameter idb-name     as character no-undo.
     8626      define output parameter Oseq         as int64 no-undo.
     8627      if iTable begins "utd"
     8628      then do:
     8629         if myseqUtd eq ?
     8630         then
     8631            myseqUtd = dynamic-next-value(iseqnamehist,idb-name).
     8632         Oseq = myseqUtd.
     8633      end.
     8634      else
     8635         Oseq = ?.
     8636      return.
     8637   end.
     8638   define   shared variable g#auto as logical no-undo.
     8639   define   shared variable g#news as logical no-undo.
     8640   define   shared variable g#oxml as logical no-undo.
     8641   define   shared variable g#esys as logical no-undo.
     8642   define   shared variable g#news-source-db as integer no-undo.
     8643   define   shared variable g#esys-source-esys as integer no-undo.
     8644   define   shared variable g#db-num as integer   no-undo .
     8645   define   shared variable g#userid as character no-undo .
     8646   define   shared variable g#passwd as character no-undo .
     8647   define variable log-res-statch as log       no-undo.
     8648   define variable rr             as recid     no-undo.
     8649   define variable v_type         as char      no-undo.
     8650   define variable v-is-deploy    as logical   no-undo .
     8651   define variable v-rid-list     as character no-undo .
     8652   define variable v-db-list      as character no-undo .
     8653   define variable v-comment      as character no-undo .
     8654   define variable gds-rec        as integer   no-undo .
     8655   define variable recid_utd      as integer   no-undo .
     8656   define variable v-GTIN         as character no-undo .
     8657   define variable m-gds-code     as character no-undo label "Товар" view-as fill-in.
     8658   define variable type_mark      as integer   no-undo .
     8659   define variable iLang          as integer   no-undo .
     8660   define variable p-value-logical as logical no-undo.
     8661   define variable p-value-character  as character no-undo.
     8662   define variable p-value-date       as date no-undo.
     8663   define variable p-value-decimal    as decimal no-undo.
     8664   define variable p-value-integer    as integer no-undo.
     8665   define variable p-param-type       as character no-undo.
     8666   define variable v-tth as handle no-undo .
     8667   define variable log-edi-doc_update as logical no-undo .
     8668   define variable Tree           as class     tree no-undo .
     8669   define variable ungroup        as logical   no-undo .
     8670   define variable line-num-error as integer   no-undo .
     8671   define variable v-pred-status  as integer   no-undo .
     8672   define variable v-obj-active   as logical   no-undo .
     8673   define variable mRecKey-line   as character no-undo.
     8674   define buffer buf_clients           for ub.clients .
     8675   define buffer X_utd-lines           for tt-utd-lines .
     8676   define buffer buf_utd               for ub.utd .
     8677   define buffer buf_utd-attr          for ub.utd-attr .
     8678   define buffer buf_utd-lines         for ub.utd-lines .
     8679   define buffer bf_utd-lines          for ub.utd-lines .
     8680   define buffer buf_contract          for ub.contract .
     8681   define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     8682   define buffer bf_utd-marking-lines  for ub.utd-marking-lines .
     8683   define buffer buf_goods             for ub.goods .
     8684   define buffer buf_marking           for ub.marking .
     8685   define buffer buf_utd-err           for ub.utd-err .
     8686   define variable v-scan-str  as character no-undo .
     8687   define variable v-manual    as logical   no-undo .
     8688   define variable v-barcode   as logical   no-undo .
     8689   DEFINE VARIABLE v-timedelay as integer   no-undo .
     8690   define variable mflagscan   as logical   no-undo.
     8691   define variable mMarkUtdLine as logical   no-undo.
     8692   define variable mOrderItem  as character   no-undo.
     8693   FUNCTION CliName RETURNS CHARACTER
     8694      (input p-cli-code as integer, input p-cli-type as character)  FORWARD.
     8695   FUNCTION ContName RETURNS CHARACTER
