      552   define  stream PrnLibStream.
      553   procedure prn-lib-prn-file :
      554     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      555     define input parameter p-DIsabledoptions as integer no-undo .
      556     define variable v-report-name as character no-undo .
