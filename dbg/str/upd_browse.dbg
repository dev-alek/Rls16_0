    11864   procedure diasize_set-width :
    11865     define input  parameter p-new-width  as decimal   no-undo .
    11866     define input  parameter p-move-resize as logical   no-undo .
    11867     do
    11868     on error undo, return error return-value
    11869     :
    11870       run diasize_change-width in this-procedure
    11871         (input  (p-new-width - frame d-utd :width)
    11872         ,input  p-move-resize
    11873         ) .
    11874     end.
    11875   end procedure.
    11876   procedure diasize_position-resize-button :
    11877     do with frame d-utd
    11878     :
    11879       hide v-diasize-resize-button .
    11880       assign
    11881         v-diasize-resize-button :row = frame d-utd :height - v-diasize-resize-button :height
    11882                     - 1
    11883                     - (frame d-utd :border-bottom-pixels / session :pixels-per-row)
    11884         v-diasize-resize-button :col = frame d-utd :width - v-diasize-resize-button :width
    11885                     - 1
    11886                     - (frame d-utd :border-right-pixels / session :pixels-per-column)
    11887       .
    11888       view v-diasize-resize-button .
    11889     end.
    11890   end procedure.
    11891   on alt-right anywhere
    11892   do:
    11893     run diasize_change-width in this-procedure
    11894       (input 1
    11895       ,input true
    11896       ) .
    11897     return no-apply .
    11898   end.
    11899   on alt-left anywhere
    11900   do:
    11901     run diasize_change-width in this-procedure
    11902       (input -1
    11903       ,input true
    11904       ) .
    11905     return no-apply .
    11906   end.
    11907   on alt-down anywhere
    11908   do:
    11909     run diasize_change-height in this-procedure
    11910       (input 1
    11911       ,input true
    11912       ) .
    11913     return no-apply .
    11914   end.
    11915   on alt-up anywhere
    11916   do:
    11917     run diasize_change-height in this-procedure
    11918       (input -1
    11919       ,input true
    11920       ) .
    11921     return no-apply .
    11922   end.
    11923   on alt-enter of frame d-utd
    11924   do:
    11925     run diasize_maximize in this-procedure
    11926       (input  ?
    11927       ).
    11928     return no-apply .
    11929   end.
    11930   procedure diasize_end-move :
    11931     do
    11932     on error undo, return error return-value
    11933     :
    11934       define variable v-row-delta as decimal   no-undo .
    11935       define variable v-col-delta as decimal   no-undo .
    11936       define variable v-new-row as decimal   no-undo .
    11937       define variable v-new-col as decimal   no-undo .
    11938       assign
    11939         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
    11940         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
    11941       .
    11942       assign
    11943         v-row-delta = v-new-row - frame d-utd :height
    11944         v-col-delta = v-new-col - frame d-utd :width
    11945       .
    11946       run diasize_change-height in this-procedure
    11947         (input v-row-delta
    11948         ,input true
    11949         ) .
    11950       run diasize_change-width in this-procedure
    11951         (input v-col-delta
    11952         ,input true
    11953         ) .
    11954     end.
    11955   end procedure.
    11956   procedure diasize_maximize :
    11957     define input  parameter p-action as logical   no-undo .
    11958     do
    11959     on error undo, return error return-value
    11960     :
    11961       if p-action = ?
    11962       then do:
    11963         if v-diasize-need-maximize = true
    11964         then do:
    11965           assign
    11966             p-action = true
    11967           .
    11968         end.
    11969         else do:
    11970           assign
    11971             p-action = false
    11972           .
    11973         end.
    11974       end.
    11975       if p-action = true
    11976       then do:
    11977         run diasize_change-height in this-procedure
    11978           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
    11979               - frame d-utd :height-chars
    11980           ,input true
    11981           ) .
    11982         run diasize_change-width in this-procedure
    11983           (input session :width-chars
    11984               - frame d-utd :width-chars
    11985           ,input true
    11986           ) .
    11987         assign
    11988           v-diasize-need-maximize = false
    11989         .
    11990       end.
    11991       else do:
    11992         run diasize_change-width in this-procedure
    11993           (input v-diasize-orig-frame-width
    11994               - frame d-utd :width-chars
    11995           ,input true
    11996           ) .
    11997         run diasize_change-height in this-procedure
    11998           (input v-diasize-orig-frame-height
    11999               - frame d-utd :height-chars
    12000           ,input true
    12001           ) .
    12002         assign
    12003           v-diasize-need-maximize = true
    12004         .
    12005       end.
    12006     end.
    12007   end procedure.
    12008   procedure diasize_restore-orig-size :
    12009     do
    12010     on error undo, return error return-value
    12011     :
    12012       assign
    12013         v-diasize-current-frame-width  = frame d-utd :width
    12014         v-diasize-current-frame-height = frame d-utd :height
    12015       .
    12016       run diasize_set-height in this-procedure
    12017         (input  v-diasize-orig-frame-height
    12018         ,input  true
    12019         ) .
    12020       run diasize_set-width in this-procedure
    12021         (input  v-diasize-orig-frame-width
    12022         ,input  true
    12023         ) .
    12024     end.
    12025   end procedure.
    12026   procedure diasize_restore-current-size :
    12027     do
    12028     on error undo, return error return-value
    12029     :
    12030       run diasize_set-height in this-procedure
    12031         (input  v-diasize-current-frame-height
    12032         ,input  true
    12033         ) .
    12034       run diasize_set-width in this-procedure
    12035         (input  v-diasize-current-frame-width
    12036         ,input  true
    12037         ) .
    12038     end.
    12039   end procedure.
    12040   procedure diasize_set-browse-handle :
    12041     define input  parameter p-browse-handle as handle   no-undo .
    12042     define buffer buf_temp-browse-handle for temp-browse-handle .
    12043     do
    12044     on error undo, return error return-value
    12045     :
    12046       assign
    12047         v-diasize-browse-handle = p-browse-handle
    12048       .
    12049       for each buf_temp-browse-handle
    12050       on error undo, return error return-value
    12051       :
    12052         delete buf_temp-browse-handle .
    12053       end.
    12054     end.
    12055   end procedure.
    12056   procedure diasize_add_browse :
    12057     define input  parameter p-browse-type   as character no-undo .
    12058     define input  parameter p-browse-handle as handle    no-undo .
    12059     define buffer buf_temp-browse-handle for temp-browse-handle .
    12060     do
    12061     on error undo, return error return-value
    12062     :
    12063       assign
    12064         v-diasize-browse-number = v-diasize-browse-number + 1
    12065       .
    12066       create buf_temp-browse-handle .
    12067       assign
    12068         buf_temp-browse-handle.browse-type   = p-browse-type
    12069         buf_temp-browse-handle.browse-number = v-diasize-browse-number
    12070         buf_temp-browse-handle.browse-handle = p-browse-handle
    12071       .
    12072     end.
    12073   end procedure.
    12074   procedure diasize_init :
    12075     define variable v-default-value    as logical   no-undo .
    12076     define variable v-restore-saved    as logical   no-undo .
    12077     define variable v-resize-value-str as character no-undo .
    12078     do
    12079     on error undo, return error return-value
    12080     :
    12081       do with frame d-utd
    12082       :
    12083         assign
    12084           v-diasize-orig-frame-height = frame d-utd :height
    12085           v-diasize-orig-frame-width  = frame d-utd :width
    12086           v-diasize-browse-handle     = browse br-utd :handle
    12087         .
    12088         create button v-diasize-resize-button
    12089         assign
    12090           parent        = frame d-utd :first-child
    12091           label         = "s"
    12092           height-pixels = 16
    12093           width-pixels  = 16
    12094           visible       = true
    12095           sensitive     = true
    12096           movable       = true
    12097           triggers:
    12098             on end-move persistent run diasize_end-move in this-procedure .
    12099           end triggers.
    12100         v-diasize-resize-button :load-mouse-pointer("SIZE") .
    12101         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
    12102         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
    12103         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
    12104         assign
    12105           v-diasize-wndmax = false
    12106         .
    12107         if connected("ub") = true
    12108         then do:
    12109           define variable v-cntxt-db-num        as integer   no-undo .
    12110           define variable v-cntxt-userid        as character no-undo .
    12111           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    12112                                             , OUTPUT v-cntxt-userid
    12113                                             ) .
    12114           run gbl/wndpar_r.p
    12115             (input  v-cntxt-db-num
    12116             ,input  v-cntxt-userid
    12117             ,input  'wndmax':U
    12118             ,output v-diasize-wndmax
    12119             ,output v-default-value
    12120             ) .
    12121         end.
    12122         assign
    12123           v-diasize-wndstore = false
    12124         .
    12125         if connected("ub") = true
    12126         then do:
    12127           run gbl/wndpar_r.p
    12128             (input  v-cntxt-db-num
    12129             ,input  v-cntxt-userid
    12130             ,input  'wndstore':U
    12131             ,output v-diasize-wndstore
    12132             ,output v-default-value
    12133             ) .
    12134         end.
    12135         assign
    12136           v-diasize-proc-name = entry(1, program-name(2), '.')
    12137         .
    12138         if v-diasize-wndstore = true
    12139         then do:
    12140           assign
    12141             v-restore-saved = false
    12142           .
    12143           if connected("ub") = true
    12144           then do:
    12145             run gbl/wndsizer.p
    12146               (input  v-cntxt-db-num
    12147               ,input  v-cntxt-userid
    12148               ,input  v-diasize-proc-name
    12149               ,input  'height':u
    12150               ,output v-resize-value-str
    12151               ) .
    12152             if v-resize-value-str <> '':U
    12153             then do:
    12154               run diasize_change-height in this-procedure
    12155                 (input  integer(v-resize-value-str)
    12156                 ,input  true
    12157                 ) .
    12158               assign
    12159                 v-restore-saved = true
    12160               .
    12161             end.
    12162           end.
    12163           if connected("ub") = true
    12164           then do:
    12165             run gbl/wndsizer.p
    12166               (input  v-cntxt-db-num
    12167               ,input  v-cntxt-userid
    12168               ,input  v-diasize-proc-name
    12169               ,input  'width':u
    12170               ,output v-resize-value-str
    12171               ) .
    12172             if v-resize-value-str <> '':U
    12173             then do:
    12174               run diasize_change-width in this-procedure
    12175                 (input  integer(v-resize-value-str)
    12176                 ,input  true
    12177                 ) .
    12178               assign
    12179                 v-restore-saved = true
    12180               .
    12181             end.
    12182           end.
    12183           if v-restore-saved <> true
    12184           then do:
    12185             if v-diasize-wndmax = true
    12186             then do:
    12187               run diasize_maximize in this-procedure
    12188                 (input  true
    12189                 ) .
    12190             end.
    12191           end.
    12192         end.
    12193         else do:
    12194           if v-diasize-wndmax = true
    12195           then do:
    12196             run diasize_maximize in this-procedure
    12197               (input  true
    12198               ) .
    12199           end.
    12200         end.
    12201       end.
    12202     end.
    12203   end procedure.
    12204   procedure diasize_need-full-display :
    12205     define output parameter p-need-full-display as logical   no-undo .
    12206     do
    12207     on error undo, return error return-value
    12208     :
    12209       assign
    12210         p-need-full-display = v-diasize-need-full-display
    12211       .
    12212       assign
    12213         v-diasize-need-full-display = false
    12214       .
    12215     end.
    12216   end procedure.
    12217   procedure get-context :
    12218      define output parameter p-db-num as integer          no-undo.
    12219      define output parameter p-user-id as character        no-undo.
    12220      define variable v-login               as character    no-undo.
    12221      define buffer buf_sys-ctrl    for ub.sys-ctrl .
    12222      define buffer buf_user-login  for ub.user-login .
    12223      do
    12224      on error undo, return error
    12225      :
    12226            FIND FIRST buf_sys-ctrl no-lock.
    12227            ASSIGN
    12228               v-login = USERID("ub")
    12229               p-db-num = buf_sys-ctrl.db-num
    12230            .
    12231            FIND FIRST buf_user-login
    12232                 WHERE buf_user-login.db-num = p-db-num
    12233                   AND buf_user-login.user-login = v-login
    12234                 no-lock
    12235                 no-error
    12236                 .
    12237            IF AVAILABLE buf_user-login
    12238            THEN DO:
    12239               assign
    12240                  p-user-id = buf_user-login.user-id
    12241               .
    12242            END.
    12243      end.
    12244   end procedure.
    12245      run diasize_init in this-procedure .
    12246      if EDOParSec:IsManual
    12247      then v-manual = yes .
    12248      else v-manual = no .
    12249      run enable_UI in this-procedure .
    12250      run enable_BUTTON in this-procedure .
    12251      apply "entry" to v-mark in FRAME d-utd.
    12252      on F9 of frame d-utd anywhere
    12253         do:
    12254            if not available X_utd-lines then  return no-apply.
    12255            find first goods no-lock where goods.gds-code = X_utd-lines.gds-code .
    12256            gds-rec = recid(goods) .
    12257            run ref/gds-form.w
    12258               (input  parParentProc
    12259               ,input  'ПРОСМОТР':U
    12260               ,input  v-cntxt-obj-type
    12261               ,input  v-cntxt-obj-code
    12262               ,input ?
    12263               ,input-output gds-rec
    12264               ).
    12265            apply "entry" to br-utd in frame d-utd.
    12266            return no-apply.
    12267         end.
    12268      b_cleaggds:visible in frame d-utd = no.
    12269      m-gds-code:visible in frame d-utd = no.
    12270      apply "VALUE-CHANGED" to br-utd IN frame d-utd.
    12271      wait-for go of frame d-utd focus v-mark.
    12272   END.
    12273   run disable_UI in this-procedure .
    12274   PROCEDURE disable_UI :
    12275      HIDE FRAME d-utd.
    12276   END PROCEDURE.
    12277   PROCEDURE enable_BUTTON :
    12278      define buffer cancel_utd-marking-lines for ub.utd-marking-lines .
    12279      define buffer cancel_utd-lines         for ub.utd-lines .
    12280      define buffer x_utd-lines         for x_utd-lines .
    12281      define buffer cancel_marking           for ub.marking .
    12282      define variable v-write-cancel  as logical no-undo .
    12283      define variable v-write-correct as logical no-undo .
    12284      v-write-cancel = false .
    12285      v-write-correct = false .
    12286      for each x_utd-lines no-lock where x_utd-lines.doc-id = p-doc-id
    12287                                                  and x_utd-lines.db-num = p-db-num,
    12288          each cancel_utd-marking-lines no-lock where cancel_utd-marking-lines.doc-id  = x_utd-lines.doc-id
    12289                                                  and cancel_utd-marking-lines.db-num  = x_utd-lines.db-num
    12290                                                  and cancel_utd-marking-lines.lineNum = x_utd-lines.lineNum,
    12291         first cancel_marking no-lock where cancel_marking.mark = cancel_utd-marking-lines.mark
    12292                                        and (    cancel_marking.sts = Marking:PendingVerification:KeyIntDB
    12293                                              or cancel_marking.sts = Marking:DeliveryControl:KeyIntDB):
    12294         v-write-cancel = true .
    12295         leave .
    12296      end.
    12297      for each x_utd-lines no-lock where x_utd-lines.doc-id = p-doc-id
    12298                                                  and x_utd-lines.db-num = p-db-num,
    12299          each cancel_utd-marking-lines no-lock where cancel_utd-marking-lines.doc-id  = x_utd-lines.doc-id
    12300                                                  and cancel_utd-marking-lines.db-num  = x_utd-lines.db-num
    12301                                                  and cancel_utd-marking-lines.lineNum = x_utd-lines.lineNum,
    12302         first cancel_marking no-lock where cancel_marking.mark = cancel_utd-marking-lines.mark and cancel_marking.sts <> Marking:MarkError:KeyIntDB
    12303         and cancel_marking.sts <> Marking:GrayZone:KeyIntDB:
    12304         v-write-correct = true .
    12305         leave .
    12306      end.
    12307      for each cancel_utd-lines where cancel_utd-lines.db-num eq p-db-num
    12308         and cancel_utd-lines.doc-id eq p-doc-id
    12309         no-lock:
    12310         define variable vqnty as decimal no-undo.
    12311         vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
    12312         if vqnty > 0
    12313            then
    12314         do:
    12315            v-write-correct = true .
    12316            leave.
    12317         end.
    12318      end.
    12319      if p-mode <> 'ПРОСМОТР':U then
    12320      do:
    12321         if (c-status < ObjSrv:Env:Utd:Sts:TH:SignatureRequired:KeyIntDB or
    12322            c-status = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB or
    12323            c-status = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB or
    12324            c-status = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB or
    12325            c-status = ObjSrv:Env:Utd:Sts:TH:LoadError:KeyIntDB )
    12326            and
    12327            (c-type = objSrv:Env:Utd:EDocType:UTD:KeyIntDB or
    12328            c-type = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB)
    12329            then
    12330         do:
    12331            enable
    12332               b_deliv-cancel
    12333               with frame d-utd .
    12334         end.
    12335         if c-status = ObjSrv:Env:Utd:Sts:TH:LoadError:KeyIntDB or
    12336            c-status = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB or
    12337            c-status = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB or
    12338            c-status = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB or
    12339            c-status = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB then
    12340         do:
    12341            if f-contr-TH <> 0 and f-obj-code-TH <> 0 and f-supp-code-TH <> 0 then
    12342            do:
    12343               find first ub.utd-err-attr no-lock where ub.utd-err.db-num = p-db-num and ub.utd-err.doc-id = p-doc-id
    12344                  and (ub.utd-err.CodeErr = "NoSuppForId"
    12345                  or ub.utd-err.CodeErr = "NoFirmForId"
    12346                  or ub.utd-err.CodeErr = "NoContForFirmId"
    12347                  or ub.utd-err.CodeErr = "NoShopForKpp"
    12348                  or ub.utd-err.CodeErr = "NoEdoDoc"
    12349                  or ub.utd-err.CodeErr = "SpecifErr"
    12350                  or ub.utd-err.CodeErr = "ContrDate") no-error .
    12351               if not available (ub.utd-err) then
    12352               do:
    12353                  enable
    12354                     b_back-check
    12355                     with frame d-utd .
    12356               end.
    12357               else
    12358               do:
    12359                  disable
    12360                     b_back-check
    12361                     with frame d-utd .
    12362               end.
    12363            end.
    12364            else
    12365            do:
    12366               disable
    12367                  b_back-check
    12368                  with frame d-utd .
    12369            end.
    12370         end.
    12371         case c-status:
    12372            when ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB then
    12373               do:
    12374                  enable
    12375                     b_prov-finish
    12376                     with frame d-utd .
    12377               end.
    12378            when ObjSrv:Env:Utd:Sts:TH:AwaitingDelivery:KeyIntDB then
    12379               do:
    12380                  enable
    12381                     b_correct
    12382                     b_write-cancel
    12383                     b_prov-finish
    12384                     with frame d-utd .
    12385                  if v-write-cancel then
    12386                  do:
    12387                     DISABLE
    12388                        b_correct
    12389                        with frame d-utd .
    12390                  end.
    12391               end.
    12392            when ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB or
    12393            when ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB or
    12394            when ObjSrv:Env:Utd:Sts:TH:LoadError:KeyIntDB then
    12395               do:
    12396                  enable
    12397                     b_correct
    12398                     b_write-cancel
    12399                     b_recheck
    12400                     with frame d-utd .
    12401                  if v-write-cancel then
    12402                  do:
    12403                     DISABLE
    12404                        b_correct
    12405                        with frame d-utd .
    12406                  end.
    12407               end.
    12408            when ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB or
    12409            when ObjSrv:Env:Utd:Sts:TH:RequiresAdjustment:KeyIntDB or
    12410            when ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB or
    12411            when ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB then
    12412               do:
    12413                  enable
    12414                     b_correct
    12415                     b_write-cancel
    12416                     with frame d-utd .
    12417                  if c-status = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
    12418                  then
    12419                     enable
    12420                     b_recheck
    12421                     with frame d-utd .
    12422                  if v-write-cancel then
    12423                  do:
    12424                     DISABLE
    12425                        b_correct
    12426                        with frame d-utd .
    12427                  end.
    12428               end.
    12429            when ObjSrv:Env:Utd:Sts:TH:SignatureRequired:KeyIntDB then
    12430               do:
    12431                  disable
    12432                     b_write-cancel
    12433                     with frame d-utd .
    12434               end.
    12435            otherwise
    12436            do:
    12437               display
    12438                  b_correct
    12439                  b_recheck
    12440                  b_write-cancel
    12441                  b_prov-finish
    12442                  with frame d-utd .
    12443            end.
    12444         end case .
    12445         if c-type = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
    12446         then
    12447         do:
    12448            disable
    12449               b_correct
    12450               b_recheck
    12451               b_write-cancel
    12452               with frame d-utd .
    12453         end.
    12454         if c-type <> objSrv:Env:Utd:EDocType:Introduce:KeyIntDB then
    12455         do:
    12456            disable
    12457               b_finish
    12458               with frame d-utd .
    12459         end.
    12460         if c-type = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB then
    12461         do:
    12462            disable
    12463               b_correct
    12464               b_write-cancel
    12465               with frame d-utd .
    12466            if c-status <> ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB then
    12467            do:
    12468               enable
    12469                  b_finish
    12470                  with frame d-utd .
    12471            end.
    12472         end.
    12473         if p-connect = ? then
    12474         do:
    12475            display
    12476               b_correct
    12477               b_recheck
    12478               with frame d-utd .
    12479         end.
    12480         if not v-write-correct then
    12481         do:
    12482            disable
    12483               b_correct
    12484               with frame d-utd .
    12485            enable
    12486               b_deliv-cancel
    12487            with frame d-utd .
    12488         end.
    12489      end.
    12490      if v-cntxt-db-num <> 0 then
    12491      do:
    12492         disable
    12493            b_write-cancel
    12494            b_back-check
    12495            b_correct
    12496            with frame d-utd .
    12497      end.
    12498      if not v-obj-active then
    12499      do:
    12500         disable
    12501            b_prov-finish
    12502            with frame d-utd .
    12503      end.
    12504   END PROCEDURE.
    12505   PROCEDURE enable_UI :
    12506      p-type = c-type .
