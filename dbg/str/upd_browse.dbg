     1750               utd-lines-attr.doc-id    = idoc-id
     1751               utd-lines-attr.lineNum   = ilineNum
     1752               utd-lines-attr.attr-code = iattrcode
     1753               utd-lines-attr.attr-value = iattrval
     1754            .
     1755         end.
     1756      end.
     1757      else do:
     1758         if utd-lines-attr.attr-value ne iattrval
     1759         then do:
     1760            find current utd-lines-attr exclusive-lock no-error.
     1761            if available utd-lines-attr
     1762            then do:
     1763               if    iattrval eq ?
     1764                  or iattrval eq ""
     1765               then do:
     1766                  delete utd-lines-attr.
     1767               end.
     1768               else do:
     1769                  utd-lines-attr.attr-value = iattrval.
     1770               end.
