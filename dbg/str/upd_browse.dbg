    11500     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    11501     define buffer buf_temp-browse-handle  for temp-browse-handle .
    11502     if p-change-value > 0
    11503     then do:
    11504       if frame d-utd :width + p-change-value >
    11505           session :width-chars
    11506       then do:
    11507         assign
    11508           p-change-value = session :width-chars - frame d-utd :width
    11509         .
    11510         if p-change-value <= 0
    11511         then do:
    11512           run diasize_position-resize-button in this-procedure .
    11513           return .
    11514         end.
    11515       end.
    11516     end.
    11517     if p-change-value < 0
    11518     then do:
    11519       if frame d-utd :width + p-change-value < v-diasize-orig-frame-width
    11520       then do:
    11521         assign
    11522           p-change-value = v-diasize-orig-frame-width
    11523                          - frame d-utd :width
    11524         .
    11525         if p-change-value >= 0
    11526         then do:
    11527           run diasize_position-resize-button in this-procedure .
    11528           return .
    11529         end.
    11530       end.
    11531     end.
    11532     if p-change-value >= 0
    11533     then do:
    11534       assign
    11535         v-change-sign = 1
    11536       .
    11537     end.
    11538     else do:
    11539       assign
    11540         v-change-sign = -1
    11541       .
    11542     end.
    11543     assign
    11544       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
    11545     .
    11546     if p-change-value = 0
    11547     then do:
    11548       run diasize_position-resize-button in this-procedure .
    11549       return .
    11550     end.
    11551     move_block:
