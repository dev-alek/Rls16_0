     1856   procedure xmlchar-test :
     1857   define input parameter p-in-string          as character        no-undo.
     1858   define output parameter p-out-string-enc    as character        no-undo.
     1859   define output parameter p-out-string-dec    as character        no-undo.
     1860   do
     1861   on error undo, return error
     1862   :
     1863          run xmlchar-encode in this-procedure
     1864       (
     1865             input p-in-string
     1866           , output p-out-string-enc
     1867       ).
     1868          run xmlchar-decode in this-procedure
     1869       (
     1870             input p-out-string-enc
     1871           , output p-out-string-dec
     1872       ).
     1873   end.
     1874   end .
     1875   procedure xmlchar-encode :
     1876   define input parameter p-in-string      as character        no-undo.
     1877   define output parameter p-out-string    as character        no-undo.
     1878       define variable v-position      as integer      no-undo.
     1879       define variable v-current-char  as character    no-undo.
     1880   do
     1881   on error undo, return error
     1882   :
     1883       assign
     1884           p-out-string = "":U
     1885       .
     1886       case p-in-string
     1887       :
     1888           when ?
     1889           then do:
     1890               assign
     1891                   p-out-string = "?":U
     1892               .
     1893           end.
     1894           when "?":U
     1895           then do:
     1896               assign
     1897                   p-out-string = "&#63;":U
     1898               .
     1899           end.
     1900           otherwise do:
     1901               do v-position = 1 to length( p-in-string )
     1902               :
     1903                   assign
     1904                       v-current-char = substring( p-in-string, v-position, 1 )
     1905                   .
     1906                   case v-current-char
     1907                   :
     1908                       when "&":U
     1909                       then do:
     1910                           assign
     1911                               p-out-string = p-out-string + "&amp;":U
     1912                           .
     1913                       end.
     1914                       when ">":U
     1915                       then do:
     1916                           assign
     1917                               p-out-string = p-out-string + "&gt;":U
     1918                           .
     1919                       end.
     1920                       when "<":U
     1921                       then do:
     1922                           assign
     1923                               p-out-string = p-out-string + "&lt;":U
     1924                           .
     1925                       end.
     1926                       when "'":U
     1927                       then do:
     1928                           assign
     1929                               p-out-string = p-out-string + "&apos;":U
     1930                           .
     1931                       end.
     1932                       when '"':U
     1933                       then do:
     1934                           assign
     1935                               p-out-string = p-out-string + "&quot;":U
     1936                           .
     1937                       end.
     1938                       when chr(1)
     1939                       then do:
     1940                           assign
     1941                               p-out-string = p-out-string + "":U
     1942                           .
     1943                       end.
     1944                       when chr(2)
     1945                       then do:
     1946                           assign
     1947                               p-out-string = p-out-string + "":U
     1948                           .
     1949                       end.
     1950                       when chr(3)
     1951                       then do:
     1952                           assign
     1953                               p-out-string = p-out-string + "":U
     1954                           .
     1955                       end.
     1956                       when chr(4)
     1957                       then do:
     1958                           assign
     1959                               p-out-string = p-out-string + "":U
     1960                           .
     1961                       end.
     1962                       when chr(5)
     1963                       then do:
     1964                           assign
     1965                               p-out-string = p-out-string + "":U
     1966                           .
     1967                       end.
     1968                       when chr(6)
     1969                       then do:
     1970                           assign
     1971                               p-out-string = p-out-string + "":U
     1972                           .
     1973                       end.
     1974                       when chr(7)
     1975                       then do:
     1976                           assign
     1977                               p-out-string = p-out-string + "":U
     1978                           .
     1979                       end.
     1980                       when chr(8)
     1981                       then do:
     1982                           assign
     1983                               p-out-string = p-out-string + "":U
     1984                           .
     1985                       end.
     1986                       when chr(9)
     1987                       then do:
     1988                           assign
     1989                               p-out-string = p-out-string + "":U
     1990                           .
     1991                       end.
     1992                       when chr(29)
     1993                       then do:
     1994                           assign
     1995                               p-out-string = p-out-string + "":U
     1996                           .
     1997                       end.
     1998                       when chr(10)
     1999                       then do:
     2000                           assign
     2001                               p-out-string = p-out-string + "&#10;":U
     2002                           .
     2003                       end.
     2004                       when chr(13)
     2005                       then do:
     2006                           assign
     2007                               p-out-string = p-out-string + "&#13;":U
     2008                           .
     2009                       end.
     2010                       otherwise do:
     2011                           assign
     2012                               p-out-string = p-out-string + v-current-char
     2013                           .
     2014                       end.
     2015                   end case.
     2016               end.
     2017           end.
     2018       end case.
     2019   end.
     2020   end .
