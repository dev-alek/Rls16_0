     9907   ON CHOOSE OF b_prov-finish IN FRAME d-utd
     9908      DO:
     9909         define variable v-ok        as logical no-undo .
     9910         define variable v-check     as logical no-undo .
     9911         define variable v-qnty-mark as integer no-undo .
     9912         define variable v-fact-qnty as integer no-undo .
     9913         define buffer bf_utd-marking-lines for ub.utd-marking-lines .
     9914         define buffer bf_utd-lines-attr    for ub.utd-lines-attr .
     9915         define buffer bf_utd-lines         for X_utd-lines .
     9916         define buffer bf_marking           for ub.marking .
     9917         define variable v-not-mark as integer no-undo .
     9918         define variable vPawd as character no-undo.
     9919         run adm\ask-pswd.w ("Введите пароль пользователя, осуществляющего обработку электронного документа, с целью подтверждения соответствия фактически полученного от поставщика количества товара и количества указанного в системе.",output vPawd).
     9920         if  vPawd eq ?
     9921         then
     9922            return no-apply.
     9923         If vPawd ne encode(g#passwd)
     9924            then
     9925         do:
     9926            message "Введен неправильный пароль"
     9927               view-as alert-box.
     9928            return no-apply.
     9929         end.
     9930         if c-type = objSrv:Env:Utd:EDocType:UTD:KeyIntDB or c-type = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB then
     9931         do:
     9932            define variable vFlagErrorMarkCheck as logical no-undo.
     9933            find first buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd.db-num and
     9934               buf_utd-marking-lines.doc-id = buf_utd.doc-id and buf_utd-marking-lines.sts = Marking:Checked_:KeyIntDB no-error .
     9935            if not available (buf_utd-marking-lines) then
     9936            do:
     9937               vFlagErrorMarkCheck = yes.
     9938            end.
     9939            define variable vFlagErrorBarCheck as logical no-undo.
     9940            find first X_utd-lines no-lock where X_utd-lines.db-num = buf_utd.db-num and X_utd-lines.doc-id = buf_utd.doc-id and
     9941               X_utd-lines.qnty-scan ne 0 no-error .
     9942            if not available (X_utd-lines) then
     9943            do:
     9944               vFlagErrorBarCheck = yes.
     9945            end.
     9946            if      vFlagErrorMarkCheck
     9947               and  vFlagErrorBarCheck
     9948            then do:
     9949               message "Ни одна марка не просканирована и ни один штрих-код не просканирован. Просканируйте штрих-коды/марки или откажите в поставке."
     9950                     view-as alert-box.
     9951                  return no-apply .
     9952            end.
     9953         end.
     9954         if c-status = ObjSrv:Env:Utd:Sts:TH:AwaitingDelivery:KeyIntDB then
     9955         do:
     9956            run check_mol (output v-check).
     9957            if not v-check then return no-apply .
     9958            run save_mol.
     9959         end.
     9960         for first X_utd-lines no-lock where
     9961                                              X_utd-lines.db-num     eq buf_utd.db-num
     9962                                         and  X_utd-lines.doc-id     eq buf_utd.doc-id
     9963                                         and  X_utd-lines.Quantity   ne X_utd-lines.qnty-scan
     9964         :
     9965            v-ok = yes .
     9966         end.
     9967         for each buf_utd-err where buf_utd-err.CodeErr = "NotMarkForLine" and
     9968            buf_utd-err.db-num = p-db-num and
     9969            buf_utd-err.doc-id = p-doc-id:
     9970            v-ok = yes .
     9971         end.
     9972         if v-ok and (c-type = objSrv:Env:Utd:EDocType:UTD:KeyIntDB or c-type = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB) then
     9973         do:
     9974            run ref/dialog-ok.w (output v-comment
     9975               ) no-error .
     9976            if v-comment = "" then return NO-APPLY .
     9977         end .
     9978         if c-type = objSrv:Env:Utd:EDocType:UTD:KeyIntDB or c-type = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB then
     9979         do:
     9980            if v-ok then c-status = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB .
     9981            else c-status = ObjSrv:Env:Utd:Sts:TH:SignatureRequired:KeyIntDB .
     9982            for each bf_utd-lines where bf_utd-lines.db-num eq buf_utd.db-num
     9983                                    and bf_utd-lines.doc-id eq buf_utd.doc-id
     9984            no-lock:
     9985               if bf_utd-lines.isMarking
     9986               then do:
     9987                  for each bf_utd-marking-lines no-lock where bf_utd-marking-lines.db-num  = bf_utd-lines.db-num
     9988                                                          and bf_utd-marking-lines.doc-id  = bf_utd-lines.doc-id
     9989                                                          and bf_utd-marking-lines.LineNum = bf_utd-lines.LineNum,
     9990                  first buf_marking exclusive-lock where buf_marking.mark = bf_utd-marking-lines.mark:
     9991                     case bf_utd-marking-lines.sts:
     9992                        when Marking:Checked_:KeyIntDB then
     9993                           do:
     9994                              if buf_marking.sts <> Marking:MarkError:KeyIntDB and buf_marking.sts <> Marking:Ungrouped:KeyIntDB and
     9995                                 not (can-do(Marking:Sale_Return_Wait,string(buf_marking.sts)) or
     9996                                      can-do(Marking:Doc_Status,string(buf_marking.sts)))
     9997                              then
     9998                                 buf_marking.sts = Marking:Checked_:KeyIntDB .
     9999                           end.
    10000                        when Marking:MarkError:KeyIntDB or
    10001                        when Marking:SaleLock:KeyIntDB or
    10002                        when Marking:SaleWaitLock:KeyIntDB or
    10003                        when Marking:ReturnLock:KeyIntDB or
    10004                        when Marking:ReturnWaitLock:KeyIntDB or
    10005                        when Marking:Ungrouped:KeyIntDB then
    10006                           do:
    10007                           end.
    10008                        otherwise
    10009                        do:
    10010                           if buf_marking.sts <> Marking:MarkError:KeyIntDB then
    10011                              buf_marking.sts = Marking:NotAvailable:KeyIntDB .
    10012                        end.
    10013                     end.
    10014                  end.
    10015               end.
    10016               else do:
    10017                  if bf_utd-lines.Quantity <> bf_utd-lines.qnty-scan then
    10018                  do:
    10019                     setattrUtdlines(p-db-num,p-doc-id,bf_utd-lines.LineNum,"NoQuantityBarCode",string(bf_utd-lines.Quantity - bf_utd-lines.qnty-scan)).
    10020                  end.
    10021               end.
    10022            end.
    10023         end.
    10024         else
    10025         do:
    10026            if c-type = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
    10027            then
    10028            do:
    10029               c-status = ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB .
    10030            end.
    10031            if c-type =  objSrv:Env:Utd:EDocType:Introduce:KeyIntDB then
    10032            do:
    10033               c-status = ObjSrv:Env:Utd:Sts:TH:AwaitingConfirmation:KeyIntDB .
    10034               for each bf_utd-lines no-lock where bf_utd-lines.doc-id = buf_utd.doc-id and
    10035                  bf_utd-lines.db-num = buf_utd.db-num:
    10036                  v-qnty-mark = 0 .
    10037                  v-fact-qnty = 0 .
    10038                  for each bf_utd-marking-lines no-lock where bf_utd-marking-lines.doc-id = bf_utd-lines.doc-id and
    10039                     bf_utd-marking-lines.db-num = bf_utd-lines.db-num and
    10040                     bf_utd-marking-lines.gds-code = bf_utd-lines.gds-code and
    10041                     bf_utd-marking-lines.LineNum = bf_utd-lines.LineNum and
    10042                     bf_utd-marking-lines.doc-level = 1,
    10043                     first bf_marking no-lock where bf_marking.mark = bf_utd-marking-lines.mark:
    10044                     v-qnty-mark = v-qnty-mark + bf_marking.box-qnty .
    10045                  end.
    10046                  for first bf_utd-lines-attr exclusive-lock where bf_utd-lines-attr.db-num = bf_utd-lines.db-num and
    10047                     bf_utd-lines-attr.doc-id = bf_utd-lines.doc-id and
    10048                     bf_utd-lines-attr.LineNum = bf_utd-lines.LineNum and
    10049                     bf_utd-lines-attr.attr-code = "utd-fact-qnty":
    10050                     v-fact-qnty = integer(bf_utd-lines-attr.attr-value) .
    10051                  end.
    10052                  v-not-mark = v-fact-qnty - v-qnty-mark .
    10053                  setattrUtdlines(bf_utd-lines.db-num,bf_utd-lines.doc-id,bf_utd-lines.LineNum,"NoMarking",string(v-not-mark)).
    10054               end.
    10055            end.
    10056         end.
    10057         buf_utd.sts = integer(c-status).
    10058         do:
    10059            define variable v-check-db-num  as integer   no-undo .
    10060            define variable v-check-user-id as character no-undo .
    10061   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10062   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
    10063     (output v-check-db-num
    10064     ,output v-check-user-id
    10065     ) no-error .
    10066            run ibs\th\str\utd\adaputd.p
    10067               (buf_utd.db-num,
    10068               buf_utd.doc-id,
    10069               v-check-user-id
    10070               ) no-error .
    10071            def var v-msg as char no-undo.
    10072            if not error-status:error
    10073               then
    10074            do:
    10075               v-msg = "".
    10076               if return-value matches "*ошибка*"
    10077                  then v-msg = substitute ('Документ № &1 от &2. Сформирована ПН: &3. &4', buf_utd.DocumentNumber, string (buf_utd.DocumentDate) , buf_utd.doc-code, return-value).
    10078               else do:
    10079                  if     buf_utd.sts ne objSrv:Env:Utd:Sts:TH:Confirmed           :KeyIntDB
    10080                  then    v-msg = substitute ('Получен УПД. Документ № &1 от &2. Сформирована ПН: &3. &5 &6 &4',
    10081                                              buf_utd.DocumentNumber,
    10082                                              string (buf_utd.DocumentDate) ,
    10083                                              buf_utd.doc-code,
    10084                                              return-value,
    10085                                              if ChecknotMarkUtd(buf_utd.db-num,buf_utd.doc-id) then "Немаркированные товары можно продавать на кассе. " else "",
    10086                                              if CheckMarkUtd(buf_utd.db-num,buf_utd.doc-id) then "Продажа маркированных товаров из данной поставки запрещена до получения дополнительного уведомления. " else "").
    10087                  else if     buf_utd.sts eq objSrv:Env:Utd:Sts:TH:Confirmed           :KeyIntDB
    10088                          and CheckMarkUtd(buf_utd.db-num,buf_utd.doc-id)
    10089                  then    v-msg = substitute ('Получен УПД. Документ № &1 от &2. Сформирована ПН: &3. &5 &4', buf_utd.DocumentNumber, string (buf_utd.DocumentDate) , buf_utd.doc-code, return-value, "Маркированные товары данной поставки можно продавать на кассе").
    10090               end.
    10091            end.
    10092            else v-msg = substitute ('Документ: &1 от &2. Ошибка при формировании ПН. &3. &4', buf_utd.DocumentNumber, string (buf_utd.DocumentDate), trim(return-value, ".")).
    10093            if v-msg ne ""
    10094            then
    10095               message v-msg
    10096                  view-as alert-box.
    10097         end.
    10098         run enable_UI in this-procedure .
    10099         buf_utd.comment = v-comment .
    10100         f-comment = v-comment .
    10101         display f-comment c-status with frame d-utd.
    10102         apply "choose" to b-save in frame d-utd.
    10103      END.
    10104   ON CHOOSE OF b_recheck IN FRAME d-utd
    10105      DO:
    10106         define variable Log-Res as logical no-undo.
    10107         if available (buf_utd)
    10108            then
    10109         do:
    10110   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10111   do:
    10112     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10113       (input  v-cntxt-db-num
    10114       ,input  v-cntxt-userid
    10115       ,input  0
    10116       ,input  'actn_edi-doc_recheck':U
    10117       ,input  'firm':U
    10118       ,input  v-cntxt-host-code-obj
    10119       ,input  '':U
    10120       ,input  0
    10121       ,input  0
    10122       ,input  0
    10123       ,input  0
    10124       ,input  true
    10125       ,output log-res
    10126       )  .
    10127   end.
    10128            if log-res
    10129               then
    10130            do:
    10131               Recheck(buf_utd.db-num, buf_utd.doc-id).
    10132               assign
    10133                  c-status     = buf_utd.sts
    10134                  c-status-edi = buf_utd.sts-edi
    10135                  f-comment    = buf_utd.comment
    10136                  .
    10137               display f-info c-status c-status-edi f-comment with frame d-utd .
    10138               run enable_UI in this-procedure .
    10139               run mark-temp (?).
    10140                  if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
    10141               run enable_BUTTON in this-procedure .
    10142            end.
    10143         end.
    10144      end.
    10145   ON CHOOSE OF b_write-cancel IN FRAME d-utd
    10146      DO:
    10147         define variable v-ok as logical no-undo .
    10148         if available (buf_utd) then
    10149         do:
    10150            run ref/dialog-upd.w (input buf_utd.comment, input buf_utd.db-num, input buf_utd.doc-id, output v-comment, output v-ok) no-error.
    10151            if  error-status:error then
    10152            do:
    10153               return return-value .
    10154            end.
    10155            if v-ok then
    10156            do:
    10157               buf_utd.comment = replace ( buf_utd.comment,chr(6), ", ").
    10158               if buf_utd.comment <> "" then buf_utd.comment = buf_utd.comment + ", " + v-comment .
    10159               else  buf_utd.comment = v-comment .
    10160               f-comment = buf_utd.comment .
    10161               display f-comment with frame d-utd .
    10162               if p-connect <> ? then
    10163               do:
    10164                  run SendResponse( buf_utd.db-num, buf_utd.doc-id, no, no) no-error.
    10165                  if  error-status:error then
    10166                  do:
    10167                     message return-value
    10168                           view-as alert-box.
    10169                     return return-value .
    10170                  end.
    10171               end.
    10172               else
    10173               do:
    10174                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:RejectionUtd:KeyIntDB.
    10175                  buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:AutoRejected:KeyIntDB.
    10176               end.
    10177            end.
    10178            assign
    10179               c-status     = buf_utd.sts
    10180               c-status-edi = buf_utd.sts-edi
    10181               .
    10182            display c-status c-status-edi with frame d-utd .
    10183            disable
    10184               b_recheck
    10185               b_anul
    10186               b_write-cancel
    10187               b_prov-finish
    10188               b_finish
    10189               b_back-check
    10190               b_deliv-cancel
    10191               with frame d-utd .
    10192         end.
    10193      END.
    10194   ON CHOOSE OF b_deliv-cancel IN FRAME d-utd
    10195      DO:
    10196         define variable v-ok as logical no-undo .
    10197         if available (buf_utd) then
    10198         do:
    10199            run ref/dialog-upd.w (input buf_utd.comment, input buf_utd.db-num, input buf_utd.doc-id, output v-comment, output v-ok) no-error.
    10200            if  error-status:error then
    10201            do:
    10202               return return-value .
    10203            end.
    10204            if v-ok then
    10205            do:
    10206               if buf_utd.comment <> "" and buf_utd.comment <> ? then buf_utd.comment = buf_utd.comment + chr(6) + v-comment .
    10207               else buf_utd.comment = v-comment .
