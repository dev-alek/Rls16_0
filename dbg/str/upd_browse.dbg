     5110            if    odb-num eq ?
     5111               or odoc-id eq ?
     5112            then do:
     5113               assign
     5114                  odb-num = utd.db-num
     5115                  odoc-id = utd.doc-id
     5116               .
     5117               return yes.
     5118            end.
     5119            else
