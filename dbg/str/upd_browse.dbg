     9014   DEFINE BROWSE br-utd
     9015      QUERY br-utd NO-LOCK DISPLAY
     9016      X_utd-lines.LineNum COLUMN-LABEL "№ п/п" FORMAT ">>>9":U
     9017      X_utd-lines.gds-code COLUMN-LABEL "Код товара" FORMAT ">>>>999999":U
     9018      X_utd-lines.ProductCode COLUMN-LABEL "Наименование!УПД" FORMAT "x(40)":U width 25
     9019      X_utd-lines.gds-name COLUMN-LABEL "Наименование ТН" FORMAT "x(112)":U width 25
     9020      X_utd-lines.Quantity COLUMN-LABEL "Кол-во в ед.!изм TH по!УПД" FORMAT "->>,>>9.999":U
     9021      X_utd-lines.qnty-scan COLUMN-LABEL "Факт!кол-во" FORMAT "->>>>>>>>>9.999":U
     9022      gdsunit (X_utd-lines.gds-code) @ mgdsunit COLUMN-LABEL "Ед.изм!TH" FORMAT "x(6)":U
     9023      if X_utd-lines.IsMarking and X_utd-lines.isWeight
     9024      then "вп"
     9025      else if X_utd-lines.IsArtic and X_utd-lines.isWeight
     9026      then "во"
     9027      else if X_utd-lines.IsMarking
     9028      then "п"
     9029      else if X_utd-lines.IsArtic
     9030      then "о"
     9031      else "-" @
     9032       much COLUMN-LABEL "У" FORMAT "X(2)":U
     9033      X_utd-lines.stts COLUMN-LABEL "Статус" FORMAT "x(20)":U WIDTH 18.13
     9034      X_utd-lines.Price COLUMN-LABEL "Цена!(без НДC)" FORMAT "->>>>>>>>>>99.99":U width 10
     9035      X_utd-lines.Total COLUMN-LABEL "Сумма!(с НДС)" FORMAT "->>>>>>>>>>>>>>99.99":U width 10
     9036      X_utd-lines.TaxRate_ COLUMN-LABEL "Ставка!НДС" FORMAT "X(7)":U
     9037      X_utd-lines.UnitCliQnty COLUMN-LABEL "Кол-во в!ед.изм постав-ка" FORMAT "->>>>>9":U
     9038   X_utd-lines.UnitCode COLUMN-LABEL "Ед.изм!постав-ка" FORMAT "x(5)":U
     9039      X_utd-lines.PieceTTH COLUMN-LABEL "Штуки ТТН" FORMAT "x(10)":U
     9040      X_utd-lines.PieceFact COLUMN-LABEL "Штуки факт" FORMAT "x(10)":U
