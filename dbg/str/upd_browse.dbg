    10819      END.
    10820   ON value-changed OF R-error IN FRAME d-utd
    10821      DO:
    10822         assign R-error .
    10823            if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
    10824      END.
    10825   ON value-changed OF R-error-2 IN FRAME d-utd
    10826      DO:
    10827         assign R-error-2 .
    10828            if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
    10829      END.
    10830   ON value-changed OF f-num IN FRAME d-utd
    10831      DO:
    10832         assign f-num .
    10833         display f-num with frame d-utd .
    10834      END.
    10835   ON RETURN OF F-date IN FRAME d-utd
    10836      DO:
    10837         apply "TAB":U to self .
    10838         return no-apply .
    10839      END.
    10840   ON TAB OF F-date IN FRAME d-utd
    10841      DO:
    10842         assign f-date .
    10843         display f-date with frame d-utd .
    10844      END.
    10845   ON leave OF F-num IN FRAME d-utd
    10846      DO:
    10847         assign f-num .
    10848         if f-date:SCREEN-VALUE <> "" and f-num:SCREEN-VALUE <> "" then
    10849         do:
    10850            find first ub.utd no-lock where ub.utd.DocumentNumber = f-num
    10851               and ub.utd.DocumentDate = f-date
    10852               and (   ub.utd.EDocType = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
    10853                    or ub.utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB
    10854                    )no-error .
    10855            if AVAILABLE (ub.utd) then
    10856            do:
    10857               MESSAGE "Документ с № " + ub.utd.DocumentNumber + " от даты: " + string(ub.utd.DocumentDate) + " уже заведен в системе." skip
    10858                  VIEW-AS ALERT-BOX.
    10859               return NO-APPLY .
    10860            end.
    10861         end.
    10862         display f-num with frame d-utd .
    10863      END.
    10864   ON leave OF F-date IN FRAME d-utd
    10865      DO:
    10866         assign f-date .
    10867         if f-num:SCREEN-VALUE <> "" and f-num:SCREEN-VALUE <> ? then
    10868         do:
    10869            find first ub.utd no-lock where ub.utd.DocumentNumber = f-num
    10870               and ub.utd.DocumentDate = f-date
    10871               and (   ub.utd.EDocType = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
    10872                    or ub.utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB
    10873                    )no-error .
    10874            if AVAILABLE (ub.utd) then
    10875            do:
    10876               MESSAGE "Документ с № " + ub.utd.DocumentNumber + " от даты: " + string(ub.utd.DocumentDate) + " уже заведен в системе." skip
    10877                  VIEW-AS ALERT-BOX.
    10878               return NO-APPLY .
    10879            end.
    10880         end.
    10881         display f-date with frame d-utd .
    10882      END.
    10883   ON CHOOSE OF r-wrkr IN FRAME d-utd
    10884      DO:
    10885         run ref/cli-all.w (
    10886            input parparentproc
    10887            ,input "b-sel"
    10888            ,input 'чел':U
    10889            ,input 'все':U
    10890            ,input 'текущие':U
    10891            ,input ?
    10892            ,input ",,,,,,NO,,"
    10893            ,input ""
    10894            ,output v-rid-list ) NO-ERROR.
    10895         IF v-rid-list = '':U THEN RETURN NO-APPLY.
    10896         FIND FIRST buf_clients NO-LOCK WHERE
    10897            recid(buf_clients) = INTEGER(v-rid-list) NO-ERROR.
    10898         IF NOT AVAILABLE buf_clients THEN RETURN NO-APPLY.
    10899         ASSIGN
    10900            f-wrkr    = buf_clients.obj-code
    10901            wrkr-name = buf_clients.obj-name
    10902            .
    10903         display f-wrkr wrkr-name  with frame d-utd.
    10904      END.
    10905   ON ENTRY OF v-mark IN FRAME d-utd
    10906      DO:
    10907         run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
    10908         run adm/shattri.p (
    10909                  input "get":U
    10910                  ,input  v-cntxt-obj-type
    10911                  ,input  v-cntxt-obj-code
    10912                  ,input  'marking':U
    10913                  ,input  'rus-key':U
    10914                  ,output p-value-character
    10915                  ,output p-value-date
    10916                  ,output p-value-decimal
    10917                  ,output p-value-integer
    10918                  ,output p-value-logical
    10919                  ,output p-param-type
    10920                  ,input-output table-handle v-tth
    10921                  ) no-error .
    10922         IF p-value-logical = yes THEN  iLang = 68748313.
    10923         run ActivateKeyboardLayout (input iLang, input 0).
    10924      END.
    10925   ON leave OF v-mark IN FRAME d-utd
    10926      DO:
    10927         v-mark = "" .
    10928         if f-text <> "                       Просканируйте марку/штрих-код" then
    10929         do:
    10930            F-text = "" .
    10931            f-text:screen-value = "" .
    10932         end.
    10933      END.
    10934   ON return OF v-mark IN FRAME d-utd
    10935      DO:
    10936         if  log-manager:logfile-name ne ?
    10937         then do:
    10938            def var speed as int64 no-undo.
    10939            speed = etime.
    10940            log-manager:write-message(substitute('Последовательность символов "&1" была просканирована за &2 мс',v-scan-str, speed), "ScanSpeed").
    10941         end.
    10942         if p-mode = 'ПРОСМОТР':U then
    10943         do:
    10944            v-mark:screen-value in frame d-utd = "" .
    10945            v-mark = "" .
    10946         end .
    10947         if v-mark:screen-value in frame d-utd = ""
    10948            then
    10949         do:
    10950            v-mark:screen-value in frame d-utd = v-scan-str.
    10951         end.
    10952         v-scan-str = "".
    10953         assign
    10954            v-mark = v-mark:screen-value in frame d-utd.
    10955         if isMark(v-mark)
    10956         then do:
    10957            run save_mark .
    10958         end.
    10959         else do:
    10960             run save_bar-code .
    10961         end.
    10962         IF  b_cleaggds:visible = yes
    10963            THEN
    10964         DO:
    10965            apply "ENTRY" to br-utd IN FRAME d-utd.
    10966            REturn no-apply.
    10967         end.
    10968      END.
    10969   ON any-printable OF v-mark IN FRAME d-utd
    10970      do:
    10971         run proc-any-key.
    10972      end.
    10973   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-utd:PARENT eq ?
    10974      THEN FRAME d-utd:PARENT = ACTIVE-WINDOW.
    10975   ON WINDOW-CLOSE OF FRAME d-utd
    10976      do:
    10977         APPLY "CLOSE":U TO THIS-PROCEDURE.
    10978         if p-mode = 'ДОБАВЛЕНИЕ':U and available (buf_utd) then
    10979         do:
    10980            delete buf_utd .
    10981         end.
    10982      end.
