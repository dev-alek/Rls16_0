    12926            end.
    12927         end.
    12928         hide
    12929            v-mark
    12930            in frame d-utd .
    12931         if p-mode <> 'ПРОСМОТР':U and buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB and c-type <> 0 then
    12932         do:
    12933               enable v-mark with frame d-utd.
