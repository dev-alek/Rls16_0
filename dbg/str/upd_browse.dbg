    14532                        buf_utd-lines-attr.LineNum   = X_utd-lines.LineNum
    14533                        buf_utd-lines-attr.attr-code = "utd-fact-qnty"
    14534                        .
    14535                  end.
    14536                  buf_utd-lines-attr.attr-value = string(X_utd-lines.fact-qnty) .
    14537               end.
    14538               recid_utd = recid(X_utd-lines) .
    14539               create buf_utd-marking-lines .
    14540               assign
    14541                  buf_utd-marking-lines.db-num    = buf_utd.db-num
    14542                  buf_utd-marking-lines.doc-id    = buf_utd.doc-id
    14543                  buf_utd-marking-lines.gds-code  = buf_utd-lines.gds-code
    14544                  buf_utd-marking-lines.LineNum   = buf_utd-lines.LineNum
    14545                  buf_utd-marking-lines.mark      = v-marking
    14546                  buf_utd-marking-lines.sts       = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB
    14547                  buf_utd-marking-lines.doc-level = 1
    14548                  .
    14549               find first buf_marking exclusive-lock where buf_marking.mark begins v-marking no-error .
    14550               if not available (buf_marking) then
    14551               do:
    14552                  create buf_marking .
    14553                  assign
    14554                     buf_marking.gds-code   = buf_utd-marking-lines.gds-code
    14555                     buf_marking.mark       = v-marking
    14556                     buf_marking.sts        = Marking:PendingVerification:KeyIntDB
    14557                     buf_marking.gds-ext-id = v-GTIN
    14558                     buf_marking.obj-code   = buf_utd.obj-code
    14559                     buf_marking.obj-type   = buf_utd.obj-type
    14560                     .
    14561                  buf_marking.unit-ext  = getLevelMotpBycodid(v-marking) .
    14562                  buf_marking.box-qnty  = getQntyUTDBycodid(v-marking) .
    14563                  buf_marking.unit = getLevelUTDBycodid(v-marking) .
    14564               end.
    14565               else
    14566               do:
    14567                  buf_marking.sts      = Marking:PendingVerification:KeyIntDB .
    14568               end.
    14569               if buf_marking.box-qnty = ? or buf_marking.box-qnty = 0 then
    14570               do:
    14571                  v-qnty = 0 .
    14572                  run gbl/d-prompt.w (
    14573                     'title=':u + "Ввод количества" + '\':u
    14574                     + 'text1=':u + "Введите количество:" + '\':u
    14575                     + 'format=' + ">>>>>9.99" + '\':u
    14576                     + 'type=' + 'D':U + '\':u
    14577                     + 'fillin_row=3\':u
    14578                     + 'fillin_col=6\':u
    14579                     + 'fillin_width=17\':u
    14580                     + 'fillin_height=1\':u
    14581                     + 'max-chars=17\':u
    14582                     + 'readonly=no\':u
    14583                     , input-output v-qnty
    14584                     ).
    14585                  buf_marking.box-qnty = v-qnty .
    14586                  buf_marking.unit  = if available (buf_goods) then buf_goods.unit-base else "".
    14587                  buf_marking.unit-ext = "UNIT" .
    14588               end.
    14589               find first X_utd-lines exclusive-lock where X_utd-lines.gds-code = buf_utd-lines.gds-code and X_utd-lines.lineNum = buf_utd-lines.LineNum
    14590                  and X_utd-lines.db-num = buf_utd-lines.db-num and X_utd-lines.doc-id = buf_utd-lines.doc-id no-error .
    14591               buf_utd-lines.Quantity  = buf_utd-lines.Quantity  + buf_marking.box-qnty .
    14592               X_utd-lines.qnty-scan = X_utd-lines.qnty-scan + buf_marking.box-qnty .
    14593               X_utd-lines.Quantity  = X_utd-lines.Quantity  + buf_marking.box-qnty .
    14594               X_utd-lines.qnty-mark = X_utd-lines.qnty-mark + 1 .
    14595               br-utd:refresh () no-error .
    14596               reposition br-utd to recid recid_utd no-error .
    14597               v-mark:screen-value = "" .
    14598               v-mark = "" .
    14599            end.
    14600            else
    14601            do:
    14602               F-text = "                GTIN - " + v-GTIN + " не привязан к товару в базе".
    14603               display F-text with frame d-utd.
    14604               v-mark:screen-value = "" .
    14605               v-mark = "" .
    14606               return.
    14607            end.
    14608         end.
    14609         else
    14610         do:
    14611            F-text = "                              Нет возможности получить GTIN " .
    14612            display F-text with frame d-utd.
    14613            v-mark:screen-value = "" .
    14614            v-mark = "" .
    14615            return.
    14616         end.
    14617         for first buf_marking exclusive-lock where buf_marking.mark begins v-marking and buf_marking.sts = Marking:GrayZone:KeyIntDB:
    14618            empty temp-table tt-marking-lines .
    14619            for first gray_utd-marking-lines no-lock where gray_utd-marking-lines.db-num = X_utd-lines.db-num and gray_utd-marking-lines.doc-id = X_utd-lines.doc-id
    14620               and gray_utd-marking-lines.LineNum = X_utd-lines.LineNum and gray_utd-marking-lines.mark = buf_utd-marking-lines.mark:
    14621               for first gray_marking no-lock where gray_marking.mark = buf_utd-marking-lines.mark :
    14622                  create tt-marking-lines .
    14623                  assign
    14624                     tt-marking-lines.gds-name    = GdsName(gray_utd-marking-lines.gds-code)
    14625                     tt-marking-lines.stts-utd    = StatusTHName(gray_utd-marking-lines.sts)
    14626                     tt-marking-lines.stts        = StatusTHName(gray_marking.sts)
    14627                     tt-marking-lines.mark        = gray_marking.mark
    14628                     tt-marking-lines.mark-parent = gray_marking.mark-parent
    14629                     tt-marking-lines.gds-code    = gray_utd-marking-lines.gds-code
    14630                     tt-marking-lines.sts         = gray_marking.sts
    14631                     tt-marking-lines.sts-utd     = gray_utd-marking-lines.sts
    14632                     tt-marking-lines.unit        = gray_marking.unit
    14633                     tt-marking-lines.box-qnty    = gray_marking.box-qnty
    14634                     tt-marking-lines.LineNum     = gray_utd-marking-lines.LineNum
    14635                     tt-marking-lines.db-num      = gray_utd-marking-lines.db-num
    14636                     tt-marking-lines.doc-id      = gray_utd-marking-lines.doc-id
    14637                     tt-marking-lines.doc-level   = gray_utd-marking-lines.doc-level
    14638                     .
    14639               end.
    14640               for each gray_unit-marking no-lock where gray_unit-marking.mark-parent = gray_utd-marking-lines.mark:
    14641                  for first gray_unit_utd-marking-lines no-lock where gray_unit_utd-marking-lines.mark = gray_unit-marking.mark:
    14642                     create tt-marking-lines .
    14643                     assign
    14644                        tt-marking-lines.gds-name    = GdsName(gray_unit_utd-marking-lines.gds-code)
    14645                        tt-marking-lines.stts-utd    = StatusTHName(gray_unit_utd-marking-lines.sts)
    14646                        tt-marking-lines.stts        = StatusTHName(gray_unit-marking.sts)
    14647                        tt-marking-lines.mark        = gray_unit-marking.mark
    14648                        tt-marking-lines.mark-parent = gray_unit-marking.mark-parent
    14649                        tt-marking-lines.gds-code    = gray_unit_utd-marking-lines.gds-code
    14650                        tt-marking-lines.sts         = gray_unit-marking.sts
    14651                        tt-marking-lines.sts-utd     = gray_unit_utd-marking-lines.sts
    14652                        tt-marking-lines.unit        = gray_unit-marking.unit
    14653                        tt-marking-lines.unit-ext    = gray_unit-marking.unit-ext
    14654                        tt-marking-lines.box-qnty    = gray_unit-marking.box-qnty
    14655                        tt-marking-lines.LineNum     = gray_unit_utd-marking-lines.LineNum
    14656                        tt-marking-lines.db-num      = gray_unit_utd-marking-lines.db-num
    14657                        tt-marking-lines.doc-id      = gray_unit_utd-marking-lines.doc-id
    14658                        tt-marking-lines.doc-level   = gray_unit_utd-marking-lines.doc-level
    14659                        .
    14660                  end.
    14661               end.
    14662            end.
    14663            run str/mark_browse.w (input parparentproc,
    14664               input-output table tt-marking-lines by-reference,
    14665               input p-mode,
    14666               input "Марки по товару " + string(X_utd-lines.gds-code) + " " + GdsName(X_utd-lines.gds-code) + " со статусом: " + StatusTHName(Marking:GrayZone:KeyIntDB),
    14667               input 6,
    14668               input ""
    14669               ) no-error .
    14670   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14671   do:
    14672     br-utd :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
    14673   end.
    14674         end.
    14675      end.
    14676      if c-status = ObjSrv:Env:Utd:Sts:TH:AwaitingDelivery:KeyIntDB then
    14677      do:
    14678         find first X_utd-lines no-lock where X_utd-lines.stts <> "Проверен" no-error .
    14679         if available (X_utd-lines) then
    14680         do:
    14681            F-text = "                            Просканируйте марку" .
    14682            f-text:screen-value = "" .
    14683            display F-text with frame d-utd .
    14684         end.
    14685         else
    14686         do:
    14687            F-text = "" .
    14688            f-text:screen-value = "" .
    14689            display F-text with frame d-utd .
    14690         end.
    14691         find first X_utd-lines no-lock where recid (X_utd-lines) = recid_utd and X_utd-lines.stts = "Проверен" no-error .
    14692         if available (X_utd-lines) then
    14693         do:
    14694            if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
    14695         end.
    14696      end.
    14697      display F-text with frame d-utd.
    14698      v-mark:screen-value = "" .
    14699      v-mark = "" .
    14700   END PROCEDURE.
    14701   PROCEDURE save_bar-code :
    14702      define variable v_list    as character no-undo .
    14703      define variable ii        as integer   no-undo .
    14704      define variable jj        as integer   no-undo .
    14705      define variable v-marking as character no-undo .
    14706      define buffer buf_parts                   for ub.parts .
    14707      define buffer gray_marking                for ub.marking .
    14708      define buffer gray_unit-marking           for ub.marking .
    14709      define buffer gray_utd-marking-lines      for ub.utd-marking-lines .
    14710      define buffer gray_unit_utd-marking-lines for ub.utd-marking-lines .
    14711      define buffer buf_utd-lines-attr          for ub.utd-lines-attr .
    14712      define buffer un_utd-marking-lines        for ub.utd-marking-lines .
    14713      define buffer buf_bar-code                for ub.bar-code .
    14714      define buffer buf_prod-bc                 for ub.prod-bc .
    14715      define VARIABLE v-qnty       as decimal   no-undo .
    14716      define VARIABLE v-rowid      as rowid     no-undo .
    14717      define VARIABLE v-tbl-name   as character no-undo .
    14718      define variable v-ungroup_ok as logical   no-undo .
    14719      define variable v-gds-code as integer no-undo.
    14720      if p-mode = 'ПРОСМОТР':U then
    14721      do:
    14722         v-Mark:screen-value in frame d-utd = "" .
    14723         v-Mark = "" .
    14724      end .
    14725      if v-Mark:screen-value in frame d-utd = ""
    14726         then
    14727      do:
    14728         v-Mark:screen-value in frame d-utd = v-scan-str.
    14729      end.
    14730      v-scan-str = "".
    14731      assign
    14732         v-Mark = v-Mark:screen-value in frame d-utd.
    14733      F-text = "" .
    14734      f-text:screen-value = "" .
    14735      v-GTIN = "" .
    14736      m-gds-code = ? .
    14737      v-gds-code = ?.
    14738      ASSIGN
    14739         v_list = 'Ё,Й,Ц,У,К,Е,Н,Г,Ш,Щ,З,Х,Ъ,Ф,Ы,В,А,П,Р,О,Л,Д,Ж,Э,Я,Ч,С,М,И,Т,Ь,Б,Ю':U .
    14740      do ii = 1 to length (v-Mark):
    14741         if LOOKUP( SUBSTRING( v-Mark, ii, 1 ), v_list )  > 1 then
    14742         do:
    14743            message "Не корректно считан штрих-код, перед считыванием переключите клавиатуру на английскую раскладку."
    14744               view-as alert-box.
    14745            v-Mark:screen-value = "" .
    14746            v-Mark = "" .
    14747            return no-apply.
    14748         end.
    14749      end.
    14750      if v-Mark = "" or v-Mark = ? then
    14751      do:
    14752         F-text = "            Ошибка чтения штрих-кода" .
    14753         display F-text with frame d-utd.
    14754         v-Mark:screen-value = "" .
    14755         v-Mark = "" .
    14756         return no-apply.
    14757      end.
    14758      mMRCCode  = yes.
    14759      do:
    14760         for first buf_prod-bc no-lock where buf_prod-bc.b-str = v-Mark,
    14761            first buf_bar-code no-lock where buf_bar-code.b-code = buf_prod-bc.b-code and
    14762            buf_bar-code.stts_ = 0:
    14763            define variable v-par-val  as character no-undo.
    14764            define variable v-par-type as character no-undo.
    14765                            if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    14766                       ( buf_bar-code.gds-code,
    14767                         'mark-type':U,
    14768                          output v-par-val,
    14769                          output v-par-type
    14770                       ).
    14771            if (  EDOParSec:GetIsEDOForType(v-par-val)
    14772               or EDOParSec:GetIsArticForType(v-par-val))
    14773             and IS-NeedMark(buf_prod-bc.b-code,buf_prod-bc.b-str)
    14774            then do:
    14775               F-text = "           Штрих-код подлежит обязательной маркировке. Просканируйте марку." .
    14776               display F-text with frame d-utd.
    14777               v-Mark:screen-value = "" .
    14778               v-Mark = "" .
    14779               return no-apply.
    14780            end.
    14781            else
    14782               v-gds-code = buf_bar-code.gds-code .
    14783         end.
    14784         if v-gds-code eq ?
    14785         then do:
    14786            F-text = "   Просканированный код не найден. Просканируйте Data Matrix или верните товар поставщику." .
    14787            display F-text with frame d-utd.
    14788            v-Mark:screen-value = "" .
    14789            v-Mark = "" .
    14790            return no-apply.
    14791         end.
    14792      end.
    14793      if p-type = objSrv:Env:Utd:EDocType:UTD:KeyIntDB then
    14794      do:
    14795         block-u-l:
    14796         for each X_utd-lines no-lock where X_utd-lines.gds-code = v-gds-code :
    14797            leave block-u-l.
    14798         end.
    14799         if available (X_utd-lines) then
    14800         do:
    14801            if X_utd-lines.sts_err then
    14802            do:
    14803               F-text = "Товар не подлежит приемке, т.к. не прошел проверку на корректность" .
    14804               display F-text with frame d-utd.
    14805               v-Mark:screen-value = "" .
    14806               v-Mark = "" .
    14807               return no-apply.
    14808            end.
    14809            X_utd-lines.qnty-scan:COLUMN-READ-ONLY IN BROWSE br-utd = FALSE.
    14810            find first X_utd-lines exclusive-lock where X_utd-lines.gds-code = v-gds-code no-error .
    14811            if available (X_utd-lines) then
    14812               recid_utd = recid (X_utd-lines) .
    14813            m-gds-code = string(v-gds-code).
    14814            b_cleaggds:sensitive = yes.
    14815            b_cleaggds:visible = yes.
    14816            m-gds-code:visible = yes.
    14817            F-text:screen-value = "               Введите количество или просканируйте другой штрих-код" .
    14818            m-gds-code:screen-value = m-gds-code.
    14819            if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
    14820            reposition br-utd to recid recid_utd no-error .
    14821            apply "VALUE-CHANGED" to br-utd IN FRAME d-utd.
    14822            v-mark:screen-value = "" .
    14823            v-mark = "" .
    14824            return no-apply .
    14825         end.
    14826         else
    14827         do :
    14828            F-text = "Просканированный код не найден. Просканируйте Data Matrix или верните товар поставщику." .
    14829            display F-text with frame d-utd.
    14830            v-Mark:screen-value = "" .
    14831            v-Mark = "" .
    14832            b_cleaggds:visible = no.
    14833            m-gds-code:visible = no.
    14834            m-gds-code = ?.
    14835            if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
    14836            apply "VALUE-CHANGED" to br-utd IN FRAME d-utd.
    14837             return no-apply .
    14838         end.
    14839      end.
    14840      if p-type = objSrv:Env:Utd:EDocType:AKT:KeyIntDB and buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB then
    14841      do:
    14842         if f-obj-type-th = "" then
    14843         do:
    14844            message "Не выбран объект"
    14845               view-as alert-box.
    14846            v-Mark:screen-value = "" .
    14847            v-mark = "" .
    14848            return no-apply .
    14849         end.
    14850         if c-type = 0 then
    14851         do:
    14852            message "Не выбран тип документа"
    14853               view-as alert-box.
    14854            v-Mark:screen-value = "" .
    14855            v-Mark = "" .
    14856            return no-apply .
    14857         end.
    14858            find first buf_goods no-lock where buf_goods.gds-code = v-gds-code no-error .
    14859            if available (buf_goods)
    14860            then
    14861            do:
    14862               find first buf_utd-lines where buf_utd-lines.doc-id = buf_utd.doc-id and buf_utd-lines.db-num = buf_utd.db-num
    14863                  and buf_utd-lines.gds-code = v-gds-code no-error .
    14864               if not available (buf_utd-lines) then
    14865               do:
    14866                  find last X_utd-lines no-lock no-error .
    14867                  if not available (X_utd-lines) then jj = 0 .
    14868                  else jj = X_utd-lines.LineNum .
    14869                  create buf_utd-lines .
    14870                  assign
    14871                     buf_utd-lines.GdsName  = GdsName(v-gds-code)
    14872                     buf_utd-lines.db-num   = buf_utd.db-num
    14873                     buf_utd-lines.doc-id   = buf_utd.doc-id
    14874                     buf_utd-lines.LineNum  = jj + 1
    14875                     buf_utd-lines.gds-code = v-gds-code
    14876                     buf_utd-lines.sts      = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
    14877                  buf_utd-lines.UnitCode = if available (buf_goods) then buf_goods.unit-base else ""
    14878                     .
    14879                  create  X_utd-lines .
    14880                  buffer-copy buf_utd-lines to X_utd-lines .
    14881                  assign
    14882                     X_utd-lines.stts = StatusTHName(buf_utd-lines.sts).
    14883                  X_utd-lines.gds-name = GdsName(v-gds-code)
    14884                     .
    14885                  X_utd-lines.ismarking = CheckMarkUtdline(buf_utd-lines.db-num,buf_utd-lines.doc-id,buf_utd-lines.LineNum).
    14886                  X_utd-lines.isArtic = logical(getAttrUtdLinesEx (buf_utd-lines.db-num,buf_utd-lines.doc-id,buf_utd-lines.LineNum,"ArticUtdLine","yes")).
    14887                  for each buf_parts no-lock where  buf_parts.artic = buf_goods.artic and
    14888                     buf_parts.prod-code = buf_goods.prod-code and
    14889                     buf_parts.prod-type = buf_goods.prod-type and
    14890                     buf_parts.out-code = 'free-zone':U and
    14891                     buf_parts.obj-code = buf_utd.obj-code and
    14892                     buf_parts.obj-type = buf_utd.obj-type :
    14893                     X_utd-lines.fact-qnty = X_utd-lines.fact-qnty + buf_parts.fact-qnty .
    14894                  end.
    14895                  find first buf_utd-lines-attr exclusive-lock where buf_utd-lines-attr.db-num = X_utd-lines.db-num and
    14896                     buf_utd-lines-attr.doc-id = X_utd-lines.doc-id and
    14897                     buf_utd-lines-attr.LineNum = X_utd-lines.LineNum and
    14898                     buf_utd-lines-attr.attr-code = "utd-fact-qnty" no-error .
    14899                  if not available (buf_utd-lines-attr) then
    14900                  do:
    14901                     create buf_utd-lines-attr .
    14902                     assign
    14903                        buf_utd-lines-attr.db-num    = X_utd-lines.db-num
    14904                        buf_utd-lines-attr.doc-id    = X_utd-lines.doc-id
    14905                        buf_utd-lines-attr.LineNum   = X_utd-lines.LineNum
    14906                        buf_utd-lines-attr.attr-code = "utd-fact-qnty"
    14907                        .
    14908                  end.
    14909                  buf_utd-lines-attr.attr-value = string(X_utd-lines.fact-qnty) .
    14910               end.
    14911               recid_utd = recid(X_utd-lines) .
    14912               create buf_utd-marking-lines .
    14913               assign
    14914                  buf_utd-marking-lines.db-num    = buf_utd.db-num
    14915                  buf_utd-marking-lines.doc-id    = buf_utd.doc-id
    14916                  buf_utd-marking-lines.gds-code  = buf_utd-lines.gds-code
    14917                  buf_utd-marking-lines.LineNum   = buf_utd-lines.LineNum
    14918                  buf_utd-marking-lines.mark      = v-mark
    14919                  buf_utd-marking-lines.sts       = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB
    14920                  buf_utd-marking-lines.doc-level = 1
    14921                  .
    14922               br-utd:refresh () no-error .
    14923               reposition br-utd to recid recid_utd no-error .
    14924               v-mark:screen-value = "" .
    14925               v-mark = "" .
    14926            end.
    14927            else
    14928            do:
    14929               F-text = "                Штрих-код - " + v-Mark + " не привязан к товару в базе".
    14930               display F-text with frame d-utd.
    14931               v-mark:screen-value = "" .
    14932               v-mark = "" .
    14933               return.
    14934            end.
    14935      end.
    14936      if p-type = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB and buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB then
    14937      do:
    14938         mMRCCode  = no.
    14939         if f-obj-type-th = "" then
    14940         do:
    14941            message "Не выбран объект"
    14942               view-as alert-box.
    14943            v-mark:screen-value = "" .
    14944            v-mark = "" .
    14945            return no-apply .
    14946         end.
    14947         if c-type = 0 then
    14948         do:
    14949            message "Не выбран тип документа"
    14950               view-as alert-box.
    14951            v-Mark:screen-value = "" .
    14952            v-mark = "" .
    14953            return no-apply .
    14954         end.
    14955         find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark = v-mark and buf_utd-marking-lines.db-num = buf_utd.db-num
    14956            and buf_utd-marking-lines.doc-id = buf_utd.doc-id no-error .
    14957         if available (buf_utd-marking-lines) then
    14958         do:
    14959            F-text = "                        Штрих-код уже просканирован в этом документе " .
    14960            display F-text with frame d-utd.
    14961            v-mark:screen-value = "" .
    14962            v-mark = "" .
    14963            return.
    14964         end.
    14965      end.
    14966      if c-status = ObjSrv:Env:Utd:Sts:TH:AwaitingDelivery:KeyIntDB then
    14967      do:
    14968         find first X_utd-lines no-lock where X_utd-lines.stts <> "Проверен" no-error .
    14969         if available (X_utd-lines) then
    14970         do:
    14971            if v-gds-code ne ?
    14972               then
    14973            do:
    14974               assign
    14975                  F-text:screen-value = "               Введите количество или просканируйте другой штрих-код"
    14976                  F-text.
    14977            end.
    14978            else
    14979            do:
    14980               F-text = "                Приемка товара невозможна, передайте товар поставщику" .
    14981               display F-text with frame d-utd .
    14982            end.
    14983         end.
    14984         else
    14985         do:
    14986            F-text = "" .
    14987            f-text:screen-value = "" .
    14988            display F-text with frame d-utd .
    14989         end.
    14990         find first X_utd-lines no-lock where recid (X_utd-lines) = recid_utd and X_utd-lines.stts = "Проверен" no-error .
    14991         if available (X_utd-lines) then
    14992         do:
    14993            if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
    14994         end.
    14995      end.
    14996      display F-text with frame d-utd.
    14997      v-mark:screen-value = "" .
    14998      v-mark = "" .
    14999   END PROCEDURE.
    15000   PROCEDURE save_mol :
    15001      find first buf_utd-attr exclusive-lock where buf_utd-attr.db-num = buf_utd.db-num and buf_utd-attr.doc-id = buf_utd.doc-id and buf_utd-attr.attr-code = "wrkr" no-error .
    15002      if not available (buf_utd-attr) then
    15003      do:
    15004         create buf_utd-attr .
    15005         assign
    15006            buf_utd-attr.db-num    = buf_utd.db-num
    15007            buf_utd-attr.doc-id    = buf_utd.doc-id
    15008            buf_utd-attr.attr-code = "wrkr"
    15009            .
    15010      end.
    15011      buf_utd-attr.attr-value = string(f-wrkr) .
    15012      find first buf_utd-attr exclusive-lock where buf_utd-attr.db-num = buf_utd.db-num and buf_utd-attr.doc-id = buf_utd.doc-id and buf_utd-attr.attr-code = "agnt" no-error .
    15013      if not available (buf_utd-attr) then
    15014      do:
    15015         create buf_utd-attr .
    15016         assign
    15017            buf_utd-attr.db-num    = buf_utd.db-num
    15018            buf_utd-attr.doc-id    = buf_utd.doc-id
    15019            buf_utd-attr.attr-code = "agnt"
    15020            .
    15021      end.
    15022      buf_utd-attr.attr-value = string(f-agnt) .
    15023      find first buf_utd-attr exclusive-lock where buf_utd-attr.db-num = buf_utd.db-num and buf_utd-attr.doc-id = buf_utd.doc-id and buf_utd-attr.attr-code = "boss" no-error .
    15024      if not available (buf_utd-attr) then
    15025      do:
    15026         create buf_utd-attr .
    15027         assign
    15028            buf_utd-attr.db-num    = buf_utd.db-num
    15029            buf_utd-attr.doc-id    = buf_utd.doc-id
    15030            buf_utd-attr.attr-code = "boss"
    15031            .
    15032      end.
    15033      buf_utd-attr.attr-value = string(f-boss) .
    15034   END PROCEDURE.
    15035   procedure LoadKeyboardLayoutA external "user32" :
    15036      define input  parameter P1 as char.
    15037      define input  parameter P2 as LONG.
    15038      define return parameter pret as LONG.
    15039   end procedure.
    15040   procedure ActivateKeyboardLayout external "user32" :
    15041      define input parameter P1 as LONG.
    15042      define input parameter P2 as LONG.
    15043   END PROCEDURE.
    15044   PROCEDURE proc-any-key :
    15045      if v-scan-str = ""
    15046      then etime(yes).
    15047         if  not v-manual and v-scan-str ne ""
    15048         then do:
    15049            if etime > 2000
    15050               then
    15051            do:
    15052               if  log-manager:logfile-name ne ?
    15053               then do:
    15054    def var speed as int64 no-undo.
    15055                  speed = etime.
    15056                  log-manager:write-message(substitute('Последовательность символов "&1" была сброшена после &2 мс',v-scan-str, speed), "ScanSpeed").
    15057               end.
    15058               v-scan-str = "".
    15059               etime(yes).
    15060            end.
    15061        end.
    15062      v-scan-str = v-scan-str + last-event:label.
    15063   end.
    15064   PROCEDURE add-mark-weight :
    15065       define input  parameter iMark     as character no-undo.
    15066       define input  parameter iGTIN     as character no-undo.
    15067       define input  parameter iDocId    as integer   no-undo.
    15068       define input  parameter iDbNum    as integer   no-undo.
    15069       define output parameter oRecUtd as recid     no-undo.
    15070       define output parameter oTxt    as character no-undo.
    15071       define variable vWeight as decimal no-undo.
    15072       define variable vFnd    as logical no-undo.
    15073       define variable vChkWeight as logical no-undo.
    15074       define variable vUnitCode  as character no-undo.
    15075       define variable vMarkShort as character no-undo.
    15076       define variable vGdsCode  as integer   no-undo.
    15077       define buffer bX_utd-lines for X_utd-lines.
    15078       define buffer buf_utd-marking-lines for ub.utd-marking-lines.
    15079       define buffer buf_utd-marking-lines-attr for ub.utd-marking-lines-attr.
    15080       define buffer tt-utd-lines-filtr for tt-utd-lines-filtr.
    15081       define buffer buf_marking  for ub.marking .
    15082       define buffer buf_marking-attr for ub.marking-attr.
    15083       define buffer buf_utd-lines-attr for ub.utd-lines-attr.
    15084       assign
    15085           vChkWeight = no
    15086           vMarkShort = GetCodeIdent(iMark)
    15087           vGdsCode = getGdsCodeByGtin(m-gds-code)
    15088           .
    15089       find first buf_marking no-lock where buf_marking.mark begins vMarkShort no-error .
    15090       if not avail buf_marking then .
    15091       else if
    15092          (buf_marking.sts eq ObjSrv:Env:Marking:Sts:Mark:DeliveryControl:KeyIntDB
    15093            or buf_marking.sts eq ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
    15094            or buf_marking.sts eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
    15095            or buf_marking.sts eq ObjSrv:Env:Marking:Sts:Mark:Freezone:KeyIntDB
    15096            or buf_marking.sts eq ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB)
    15097       then .
    15098       else do:
    15099          assign
    15100             oRecUtd = ?
    15101             oTxt = "Товар не подлежит приемке, т. к. не прошел проверку на корректность"
    15102             .
    15103             return "".
    15104       end.
    15105       if ChkAnotherUtd(iDocId, iDbNum, vMarkShort)
    15106       then do:
    15107          find first buf_marking-attr where buf_marking-attr.mark begins vMarkShort
    15108                                        and buf_marking-attr.attr-code eq "weight"
    15109             no-lock no-error.
    15110          if avail buf_marking-attr
    15111          then do:
    15112             vWeight = decimal(buf_marking-attr.attr-value) no-error.
    15113             if vWeight <> 0 and vWeight <> ? then do:
    15114                 vUnitCode = gdsunit (vGdsCode).
    15115                 MESSAGE "Масса товара равна "
    15116                     (if vWeight < 1  and vWeight >= 0
    15117                         then string(vWeight,"9.999")
    15118                         else string(vWeight))
    15119                     vUnitCode "?"
    15120                     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO
    15121                     TITLE "" UPDATE lChoice AS LOGICAL.
    15122                 if lChoice then do:
    15123                     vChkWeight = yes.
    15124                 end.
    15125                 else do:
    15126                     assign
    15127                        oRecUtd = ?
    15128                        oTxt = "Масса товара не совпадает с данными в системе. Товар не подлежит приемке."
    15129                        .
    15130                     return .
    15131                 end.
    15132             end.
    15133             else run str/add-weight.w (vGdsCode, output vWeight).
    15134          end.
    15135          else run str/add-weight.w (vGdsCode, output vWeight).
    15136       end.
    15137       else run str/add-weight.w (vGdsCode, output vWeight).
    15138       if vWeight = 0 then do:
    15139           MESSAGE "Вес товара обязательный"
    15140           VIEW-AS ALERT-BOX.
    15141           return "".
    15142       end.
    15143       assign
    15144          oRecUtd = ?
    15145          vFnd = no
    15146          .
    15147       utline:
    15148       for each bX_utd-lines where
    15149                bX_utd-lines.doc-id = iDocId
    15150            and bX_utd-lines.db-num = iDbNum
    15151            and bX_utd-lines.gds-code = vGdsCode
    15152            and bX_utd-lines.isArtic = yes
    15153            by bX_utd-lines.LineNum :
    15154            vFnd = yes.
    15155            if bX_utd-lines.PieceFact < bX_utd-lines.PieceTTH
    15156            and bX_utd-lines.qnty-scan + vWeight <= bX_utd-lines.Quantity
    15157            then do:
    15158               oRecUtd = recid(bX_utd-lines) .
    15159               create buf_utd-marking-lines .
    15160               assign
    15161                  buf_utd-marking-lines.db-num    = bX_utd-lines.db-num
    15162                  buf_utd-marking-lines.doc-id    = bX_utd-lines.doc-id
    15163                  buf_utd-marking-lines.gds-code  = bX_utd-lines.gds-code
    15164                  buf_utd-marking-lines.LineNum   = bX_utd-lines.LineNum
    15165                  buf_utd-marking-lines.mark      = vMarkShort
    15166                  buf_utd-marking-lines.sts       = Marking:Checked_:KeyIntDB .
    15167                  buf_utd-marking-lines.doc-level = 1
    15168                  .
    15169               setattrUtdMarkingLines(buf_utd-marking-lines.db-num,
    15170                                      buf_utd-marking-lines.doc-id,
    15171                                      buf_utd-marking-lines.LineNum,
    15172                                      buf_utd-marking-lines.mark,
    15173                                      "AddMarkWeight",
    15174                                      "yes") .
    15175               find first buf_marking exclusive-lock where buf_marking.mark begins vMarkShort no-error .
    15176               if not available (buf_marking)
    15177               and not locked buf_marking then
    15178               do:
    15179                    create buf_marking .
    15180                    assign
    15181                       buf_marking.gds-code   = buf_utd-marking-lines.gds-code
    15182                       buf_marking.mark       = vMarkShort
    15183                       buf_marking.sts        = Marking:DeliveryControl:KeyIntDB
    15184                       buf_marking.gds-ext-id = iGTIN
    15185                       buf_marking.obj-code   = buf_utd.obj-code
    15186                       buf_marking.obj-type   = buf_utd.obj-type
    15187                       buf_marking.box-qnty   = 1
    15188                       buf_marking.unit       = getLevelUTDByCodId(iMark)
    15189                       buf_marking.unit-ext   = "UNIT"
    15190                       .
    15191               end.
    15192               if not vChkWeight then do:
    15193                   find first buf_marking-attr where
    15194                              buf_marking-attr.attr-code eq "weight"
    15195                          and buf_marking-attr.mark eq buf_marking.mark
    15196                        exclusive-lock no-error.
    15197                   if not available buf_marking-attr
    15198                      and not locked buf_marking-attr
    15199                   then
    15200                   do:
    15201                     create buf_marking-attr.
    15202                     assign
    15203                       buf_marking-attr.mark = buf_marking.mark
    15204                       buf_marking-attr.attr-code = "weight"
    15205                     .
    15206                   end.
    15207                   if available buf_marking-attr
    15208                   then buf_marking-attr.attr-value = if vWeight < 1
    15209                                                         then string(vWeight,"9.999")
    15210                                                         else string(vWeight).
    15211               end.
    15212               assign
    15213                   bX_utd-lines.qnty-scan = bX_utd-lines.qnty-scan + vWeight
    15214                   bX_utd-lines.qnty-mark = bX_utd-lines.qnty-mark + 1
    15215                   bX_utd-lines.PieceFact = String(int(bX_utd-lines.PieceFact) + 1) no-error
    15216                   .
    15217               setattrUtdlines(bX_utd-lines.db-num,
    15218                               bX_utd-lines.doc-id,
    15219                               bX_utd-lines.LineNum,
    15220                               "QuantityBarCode",
    15221                               string(bX_utd-lines.qnty-scan)).
    15222               setattrUtdlines(bX_utd-lines.db-num,
    15223                               bX_utd-lines.doc-id,
    15224                               bX_utd-lines.LineNum,
    15225                               "QuantityPiece",
    15226                               bX_utd-lines.PieceFact).
    15227               recid_utd = recid (bX_utd-lines) .
    15228               run mark-temp (?).
    15229               leave utline.
    15230            end.
    15231       end.
    15232       if vFnd and oRecUtd = ? then
    15233          oTxt = "Внимание! Масса/количество товара не может быть больше массы/количества, переданной в УПД." .
    15234       else if not vFnd then
    15235          oTxt = "Товар не найден. Если сканируете КМ транспортной или груп. упак., то просканировать КМ потребительской упак., или верните товар поставщику." .
    15236   end procedure.
    15237   FUNCTION CliName RETURNS CHARACTER
    15238      (input p-cli-code as integer, input p-cli-type as character) :
    15239      define variable v-cli-name as character no-undo .
    15240      find first buf_clients no-lock where buf_clients.obj-code = p-cli-code
    15241         and buf_clients.obj-type = p-cli-type no-error .
    15242      if available (buf_clients) then v-cli-name = buf_clients.obj-name .
    15243      RETURN v-cli-name.
    15244   END FUNCTION.
    15245   FUNCTION ContName RETURNS CHARACTER
    15246      ( input p-contract-code as integer, input p-host-code as integer ) :
    15247      define variable v-contract-name as character no-undo .
    15248      find first buf_contract no-lock where buf_contract.contract-code = p-contract-code and buf_contract.host-code = p-host-code no-error .
    15249      if available (buf_contract) then v-contract-name = buf_contract.contract-name .
    15250      RETURN v-contract-name.
    15251   END FUNCTION.
    15252   FUNCTION GdsName RETURNS CHARACTER
    15253      ( input p-gds-code as integer) :
    15254      define variable v-gds-name as character no-undo .
    15255      define buffer buf_goods for ub.goods .
    15256      find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
    15257      if available (buf_goods) then v-gds-name = buf_goods.gds-name .
    15258      RETURN v-gds-name.
    15259   END FUNCTION.
    15260   FUNCTION GdsUnit RETURNS CHARACTER
    15261      ( input p-gds-code as integer) :
    15262      define variable v-gds-unit as character no-undo .
    15263      define buffer buf_goods for ub.goods .
    15264      find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
    15265      if available (buf_goods) then v-gds-unit = buf_goods.unit-base .
    15266      RETURN v-gds-unit.
    15267   END FUNCTION.
    15268   FUNCTION StatusName RETURNS CHARACTER
    15269      ( input p-doc-id as integer,
    15270      input p-db-num as integer) :
    15271      define variable v-status-name as character no-undo .
    15272      define buffer buf_utd-attr for ub.utd-attr .
    15273      find first buf_utd-attr no-lock where buf_utd-attr.doc-id = p-doc-id and
    15274         buf_utd-attr.db-num = p-db-num and
    15275         buf_utd-attr.attr-code = "sendcode"  no-error .
    15276      if available (buf_utd-attr) then
    15277      do:
    15278         case buf_utd-attr.attr-value:
    15279            when "2" then
    15280               do:
    15281                  v-status-name = "(С расхождением)" .
    15282               end.
    15283            when "3" then
    15284               do:
    15285                  v-status-name = "(Не принято)" .
    15286               end.
    15287            otherwise
    15288            do:
    15289               v-status-name = "" .
    15290            end.
    15291         end case .
    15292      end.
    15293      else v-status-name = "" .
    15294      RETURN v-status-name.
    15295   END FUNCTION.
    15296   FUNCTION ChkAnotherUtd RETURNS LOGICAL
    15297      ( input p-doc-id as integer,
    15298        input p-db-num as integer,
    15299        input p-mark as character
    15300        ) :
    15301      define buffer buf_utd-marking-lines for ub.utd-marking-lines .
    15302      define variable vAvail as logical no-undo.
    15303      vAvail = no.
    15304      uml:
    15305      for each buf_utd-marking-lines no-lock where
    15306               buf_utd-marking-lines.mark begins p-mark
    15307           :
    15308           if buf_utd-marking-lines.doc-id <> p-doc-id
    15309              or buf_utd-marking-lines.db-num  <> p-db-num
    15310           then do:
    15311               vAvail = yes.
    15312               leave uml.
    15313           end.
    15314      end.
    15315      RETURN vAvail.
    15316   END FUNCTION.
