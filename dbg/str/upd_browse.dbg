     9093      f-info AT ROW 13.71 COL 17 NO-LABEL WIDGET-ID 268
     9094      f-info-name AT ROW 14.04 COL 7 NO-LABEL WIDGET-ID 342
     9095      f-boss-name AT ROW 14.67 COL 118.25 NO-LABEL WIDGET-ID 350
     9096      f-boss AT ROW 14.67 COL 121.25 COLON-ALIGNED NO-LABEL WIDGET-ID 294
     9097      r-boss AT ROW 14.67 COL 145.5 WIDGET-ID 300
     9098      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     9099      SIDE-LABELS THREE-D  SCROLLABLE .
     9100   DEFINE FRAME d-utd
     9101      f-mark AT ROW 15.67 COL 10 NO-LABEL WIDGET-ID 344
     9102      v-mark AT ROW 15.67 COL 15 COLON-ALIGNED NO-LABEL WIDGET-ID 34
     9103      a-n-c AT ROW 16.71 COL 2.38 NO-LABEL WIDGET-ID 272
     9104      a-n-c-name AT ROW 16.75 COL 39.5 COLON-ALIGNED NO-LABEL WIDGET-ID 278
     9105      R-error AT ROW 16.79 COL 124.63 NO-LABEL WIDGET-ID 316
     9106      R-error-2 AT ROW 16.79 COL 124.63 NO-LABEL WIDGET-ID 316
     9107      br-utd AT ROW 17.83 COL 2.5 WIDGET-ID 100
     9108      F-text AT ROW 28.75 COL 2.5 NO-LABEL WIDGET-ID 224
     9109      b_prov-finish AT ROW 30.5 COL 2.75 WIDGET-ID 70
     9110      b_recheck AT ROW 30.5 COL 39.5 WIDGET-ID 228
     9111      b_correct AT ROW 30.5 COL 76.13 WIDGET-ID 230
     9112      b_anul AT ROW 30.5 COL 112.75 WIDGET-ID 324
     9113      b_back-check AT ROW 31.88 COL 2.75 WIDGET-ID 236
     9114      b_finish AT ROW 31.88 COL 39.5 WIDGET-ID 252
     9115      b_write-cancel AT ROW 31.88 COL 76.13 WIDGET-ID 232
     9116      b_deliv-cancel AT ROW 31.88 COL 112.75 WIDGET-ID 230
     9117      wrkr-name AT ROW 12.25 COL 132.88 COLON-ALIGNED NO-LABEL WIDGET-ID 306
     9118      agnt-name AT ROW 13.46 COL 132.88 COLON-ALIGNED NO-LABEL WIDGET-ID 292
     9119      boss-name AT ROW 14.67 COL 132.88 COLON-ALIGNED NO-LABEL WIDGET-ID 296
     9120      "Доп.инфо:" VIEW-AS TEXT
     9121      SIZE 9.5 BY .67 AT ROW 14.17 COL 7 WIDGET-ID 264
     9122      m-gds-code  AT ROW 16.7 COL 87
     9123      b_cleaggds AT ROW 16.7 COL 105
     9124      "Объект:" VIEW-AS TEXT
     9125      SIZE 8 BY .67 AT ROW 4.42 COL 3 WIDGET-ID 182
     9126      "Данные ТН:" VIEW-AS TEXT
     9127      SIZE 11 BY .67 AT ROW 3.75 COL 32.63 WIDGET-ID 180
     9128      RECT-1 AT ROW 30.25 COL 2 WIDGET-ID 64
     9129      R-TH AT ROW 4 COL 2 WIDGET-ID 112
     9130      SPACE(74.51) SKIP(23.07)
     9131      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     9132      SIDE-LABELS THREE-D  SCROLLABLE
     9133      TITLE "Проверка кодов маркировки":L.
     9134   ASSIGN
     9135      FRAME d-utd:SCROLLABLE = FALSE
     9136      br-utd:num-locked-columns in frame d-utd = 3
     9137      .
     9138   ASSIGN
     9139      b-servis:POPUP-MENU IN FRAME d-utd = MENU POPUP-MENU-b-servis:HANDLE.
     9140   ASSIGN
     9141      b-servis:MENU-MOUSE = 1.
     9142   ASSIGN
     9143      br-utd:COLUMN-RESIZABLE IN FRAME d-utd = TRUE.
     9144   ASSIGN
     9145      b_error:POPUP-MENU IN FRAME d-utd = MENU m_error:HANDLE.
     9146   ASSIGN
     9147      b_error:MENU-MOUSE = 1.
     9148   ASSIGN
     9149      B_mark:POPUP-MENU IN FRAME d-utd = MENU m_marks:HANDLE.
     9150   ASSIGN
     9151      b_mark:MENU-MOUSE = 1.
     9152   ASSIGN
     9153      f-comment:READ-ONLY IN FRAME d-utd = TRUE.
     9154   ASSIGN
     9155      f-info:READ-ONLY IN FRAME d-utd = TRUE.
     9156   ASSIGN
     9157      f-mark:HIDDEN IN FRAME d-utd = TRUE.
     9158   ASSIGN
     9159      f-obj-name-2:READ-ONLY IN FRAME d-utd = TRUE.
     9160   ASSIGN
     9161      v-mark:HIDDEN IN FRAME d-utd = TRUE.
     9162   ON VALUE-CHANGED OF a-n-c IN FRAME d-utd
     9163      DO:
     9164         assign a-n-c .
     9165         apply "TAB":U to self .
     9166         return no-apply .
     9167      END.
     9168   ON leave, return OF a-n-c-name IN FRAME d-utd
     9169      DO:
     9170         assign a-n-c-name .
     9171         assign a-n-c .
     9172         case a-n-c:
     9173            when "code" then
     9174               do:
     9175                  find first X_utd-lines where X_utd-lines.gds-code = integer(a-n-c-name) no-error .
     9176                  if available (X_utd-lines) then
     9177                  do:
     9178                     recid_utd = recid (X_utd-lines) .
     9179                     br-utd :refresh() no-error.
     9180                     reposition br-utd to recid recid_utd no-error .
     9181                  end.
     9182               end.
     9183            when "name" then
     9184               do:
     9185                  find first X_utd-lines where (X_utd-lines.ProductCode begins a-n-c-name or X_utd-lines.gds-name begins a-n-c-name) no-error .
     9186                  if available (X_utd-lines) then
     9187                  do:
     9188                     recid_utd = recid (X_utd-lines) .
     9189                     br-utd :refresh() no-error.
     9190                     reposition br-utd to recid recid_utd no-error .
     9191                  end.
     9192               end.
     9193            when "context" then
     9194               do:
     9195                  find first X_utd-lines where (X_utd-lines.ProductCode MATCHES "*" + a-n-c-name + "*" or X_utd-lines.gds-name MATCHES "*" + a-n-c-name + "*") no-error .
     9196                  if available (X_utd-lines) then
     9197                  do:
     9198                     recid_utd = recid (X_utd-lines) .
     9199                     br-utd :refresh() no-error.
     9200                     reposition br-utd to recid recid_utd no-error .
     9201                  end.
     9202               end.
     9203         end case.
     9204         apply "TAB":U to self .
     9205         return no-apply .
     9206      END.
     9207   ON CHOOSE OF b-order IN FRAME d-utd
     9208   DO:
     9209       define buffer buf_order-doc for ub.order-doc.
     9210       find first buf_order-doc where
     9211                  buf_order-doc.order-item = mOrderItem
     9212            no-lock no-error.
     9213       if available (buf_order-doc) then
     9214       do:
     9215          run str/order-doc.w (input parparentproc,
     9216                               input buf_order-doc.doc-code,
     9217                               input 'ПРОСМОТР':U
     9218                              )  .
     9219       end.
     9220       else
     9221       do:
     9222           message "Заказ не найден."
     9223               view-as alert-box.
     9224           return no-apply .
     9225       end.
     9226   END.
     9227   ON choose OF b-cancel IN FRAME d-utd
     9228      DO:
     9229         if p-mode = 'ДОБАВЛЕНИЕ':U and available (buf_utd) then
     9230         do:
     9231            delete buf_utd .
     9232         end.
     9233      END.
     9234   ON choose OF b-exit IN FRAME d-utd
     9235      DO:
     9236      END.
     9237   ON choose OF b-save IN FRAME d-utd
     9238      DO:
     9239         define variable v-ok as logical no-undo .
     9240         if p-mode <> 'ПРОСМОТР':U and type_mark = 1 then
     9241         do:
     9242            run save_mol.
     9243         end .
     9244         if p-mode <> 'ПРОСМОТР':U then
     9245         do:
     9246            if f-obj-type-th = "" then
     9247            do:
     9248               message "Не выбран объект"
     9249                  view-as alert-box.
     9250               return no-apply .
     9251            end.
     9252            if c-type = 0 then
     9253            do:
     9254               message "Не выбран тип документа"
     9255                  view-as alert-box.
     9256               return no-apply .
     9257            end.
     9258            if available (buf_utd) then
     9259            do:
     9260               assign
     9261                  buf_utd.obj-code = f-obj-code-TH
     9262                  buf_utd.obj-type = f-obj-type-TH
     9263                  .
     9264            end.
     9265            if f-contr-TH <> 0 and f-contr-TH <> ? then
     9266            do:
     9267               assign
     9268                  buf_utd.contract-code = f-contr-TH
     9269                  .
     9270            end.
     9271            else
     9272            do:
     9273               if c-type = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
     9274               then
     9275               do:
     9276                  message "Не заполнен номер договора"
     9277                     view-as alert-box.
     9278                  return no-apply .
     9279               end.
     9280            end.
     9281            if f-obj-code-TH <> 0 and f-obj-code-TH <> ? then
     9282            do:
     9283               assign
     9284                  buf_utd.obj-code = f-obj-code-TH
     9285                  buf_utd.obj-type = f-obj-type-TH
     9286                  .
     9287            end.
     9288            else
     9289            do:
     9290               if c-type = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
     9291               then
     9292               do:
     9293                  message "Не заполнен объект"
     9294                     view-as alert-box.
     9295                  return no-apply .
     9296               end.
     9297            end.
     9298            if f-supp-code-TH <> 0 and f-supp-code-TH <> ? then
     9299            do:
     9300               assign
     9301                  buf_utd.cli-code = f-supp-code-TH
     9302                  buf_utd.cli-type = f-supp-type-TH
     9303                  .
     9304            end.
     9305            else
     9306            do:
     9307               if c-type = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
     9308               then
     9309               do:
     9310                  message "Не заполнен поставщик"
     9311                     view-as alert-box.
     9312                  return no-apply .
     9313               end .
     9314            end.
     9315            if c-type = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
     9316            then
     9317            do:
     9318               if f-num = "" then
     9319               do:
     9320                  message "Заполните номер документа"
     9321                     view-as alert-box.
     9322                  return no-apply .
     9323               end.
     9324               assign
     9325                  buf_utd.DocumentNumber = f-num
     9326                  buf_utd.DocumentDate   = f-date
     9327                  buf_utd.sts-edi        = ObjSrv:Env:Utd:Sts:EDI:RecipientResponseStatusNotAccep:KeyIntDB
     9328                  .
     9329               for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.doc-id = buf_utd.doc-id
     9330                  and buf_utd-marking-lines.db-num = buf_utd.db-num,
     9331                  first buf_marking EXCLUSIVE-LOCK where buf_marking.mark begins buf_utd-marking-lines.mark:
     9332                  buf_marking.sts = Marking:PendingVerification:KeyIntDB .
     9333               end.
     9334            end.
     9335            if c-type = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB and p-mode = 'ДОБАВЛЕНИЕ':U then
     9336            do:
     9337               if buf_utd.DocumentNumber = "" then buf_utd.DocumentNumber = string(buf_utd.doc-id) .
     9338               assign
     9339                  buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:RecipientResponseStatusNotAccep:KeyIntDB
     9340                  .
     9341            end.
     9342         end.
     9343      END.
     9344   ON ROW-DISPLAY OF br-utd IN FRAME d-utd
     9345      DO:
     9346         define variable vColor as integer no-undo.
     9347         if     buf_utd.Direction   ne 'inbound'
     9348             or buf_utd.EDocType    eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     9349         then
     9350            .
     9351         else if X_utd-lines.stts eq "Проверен" then
     9352         do:
     9353            if type_mark = 1 then
     9354            do:
     9355               vColor = CYAN_COLOR.
     9356            end.
     9357         end.
     9358         else if X_utd-lines.stts begins  "Ошибка" then
     9359         do:
     9360            vColor = red_COLOR.
     9361         end.
     9362         if X_utd-lines.DelivCodeMis then
     9363         do:
     9364            vColor = LIGHT_RED_COLOR.
     9365         end.
     9366         X_utd-lines.LineNum     :fGCOLOR in browse br-utd = vColor.
     9367         X_utd-lines.gds-code    :fGCOLOR in browse br-utd = vColor.
     9368         X_utd-lines.ProductCode :fGCOLOR in browse br-utd = vColor.
     9369         X_utd-lines.Gds-Name    :fGCOLOR in browse br-utd = vColor.
     9370         X_utd-lines.UnitCode    :fGCOLOR in browse br-utd = vColor.
     9371         X_utd-lines.UnitCliQnty :fGCOLOR in browse br-utd = vColor.
     9372         X_utd-lines.Quantity    :fGCOLOR in browse br-utd = vColor.
     9373         X_utd-lines.price       :fGCOLOR in browse br-utd = vColor.
     9374         X_utd-lines.total       :fGCOLOR in browse br-utd = vColor.
     9375         X_utd-lines.TaxRate_    :fgCOLOR in browse br-utd = vColor.
     9376         X_utd-lines.qnty-scan   :fGCOLOR in browse br-utd = vColor.
     9377         much                    :fGCOLOR in browse br-utd = vColor.
     9378         mgdsunit                :fGCOLOR in browse br-utd = vColor.
     9379         X_utd-lines.stts        :fGCOLOR in browse br-utd = vColor.
     9380      END .
     9381   ON VALUE-CHANGED OF br-utd IN FRAME d-utd
     9382      DO:
     9383         f-info = "" .
     9384         define variable vRecKey          as character no-undo.
     9385         define variable vRecKey-line     as character no-undo.
     9386         define variable vRecKey-markLine as character no-undo.
     9387         if available (X_utd-lines) and available (buf_utd) then
     9388         do:
     9389            br-utd :refresh() no-error .
     9390            run gen-key-rec ("utd",
     9391               input  buffer buf_utd:handle,
     9392               output vRecKey).
     9393            run gen-key-rec ("utd-lines",
     9394               input  buffer X_utd-lines:handle,
     9395               output vRecKey-line).
     9396            mRecKey-line = vRecKey-line.
     9397            vRecKey-markLine = replace(vRecKey-line,"utd-lines","utd-marking-lines") + chr(3).
     9398            menu-item m_error-lines:sensitive in menu m_error = yes.
     9399            for each buf_utd-err no-lock where buf_utd-err.doc-id = X_utd-lines.doc-id
     9400               and buf_utd-err.db-num = X_utd-lines.db-num
     9401               and (buf_utd-err.reckey = vRecKey-line
     9402               or buf_utd-err.reckey begins vRecKey-markLine or buf_utd-err.reckey = vRecKey):
     9403               if f-info = "" then f-info = GetTextError(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj) + chr(10) no-error.
     9404               else
     9405               do:
     9406                  if length (f-info) >= 2000 then leave .
     9407                  f-info = f-info + GetTextError(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj) + chr(10) no-error.
     9408               end.
     9409            end.
     9410            line-num-error = X_utd-lines.LineNum .
     9411            if    ((    (not v-BarCode or X_utd-lines.isSelect)
     9412                    and not X_utd-lines.isArtic)
     9413               or can-find (first tt-utd-lines-filtr where tt-utd-lines-filtr.db-num   eq X_utd-lines.db-num
     9414                                                       and tt-utd-lines-filtr.doc-id   eq X_utd-lines.doc-id
     9415                                                       and tt-utd-lines-filtr.linenum  eq X_utd-lines.LineNum
     9416                                                       and tt-utd-lines-filtr.bar-code eq m-gds-code))
     9417               and f-info eq ""
     9418               and p-mode <> 'ПРОСМОТР':U
     9419               and mflagscan
     9420               and not X_utd-lines.isMarking
     9421               and not X_utd-lines.isVarWeight
     9422            then
     9423            do:
     9424               X_utd-lines.qnty-scan:COLUMN-READ-ONLY IN BROWSE br-utd = FALSE.
     9425            end.
     9426            else
     9427            do:
     9428               X_utd-lines.qnty-scan:COLUMN-READ-ONLY IN BROWSE br-utd = TRUE.
     9429            end.
     9430         end.
     9431         display f-info with frame d-utd .
     9432      END.
     9433   ON row-leave OF br-utd IN FRAME d-utd
     9434      DO:
     9435         define variable kk as decimal no-undo .
     9436         if available (X_utd-lines) then
     9437         do:
     9438            if X_utd-lines.isMarking then do:
     9439            end.
     9440            else do:
     9441               kk = X_utd-lines.qnty-scan .
     9442               assign
     9443                  browse br-utd X_utd-lines.qnty-scan
     9444                  .
     9445               if X_utd-lines.stts begins "Ошибка" and kk <> X_utd-lines.qnty-scan then
     9446               do:
     9447                  message "Приемка товара не возможна"
     9448                     view-as alert-box.
     9449                  X_utd-lines.qnty-scan = kk.
     9450                  assign
     9451                     browse br-utd X_utd-lines.qnty-scan
     9452                     .
     9453                  if X_utd-lines.Quantity = X_utd-lines.qnty-scan then X_utd-lines.stts = "Проверен" .
     9454                  else X_utd-lines.stts = "Ожидает проверку" .
     9455                  recid_utd = recid (X_utd-lines) .
     9456                  run mark-temp (?).
     9457                  if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
     9458                  br-utd :refresh() no-error.
     9459                  reposition br-utd to recid recid_utd no-error .
     9460                  apply "VALUE-CHANGED" to br-utd IN FRAME d-utd.
     9461                  return .
     9462                  .
     9463               end.
     9464               else if X_utd-lines.stts begins "Ошибка" then
     9465                  do:
     9466                     return .
     9467                  end.
     9468               if (not X_utd-lines.isWeight) and ROUND(X_utd-lines.qnty-scan,0) <> X_utd-lines.qnty-scan
     9469               then do:
     9470                   message "Данный товар не может иметь дробное количество"
     9471                   view-as alert-box.
     9472                   return no-apply.
     9473               end.
     9474               if kk > X_utd-lines.qnty-scan and kk = X_utd-lines.Quantity then
     9475               do:
     9476                  message
     9477              "Вы точно хотите уменьшить количество по строке?"
     9478              view-as alert-box question buttons yes-no update choice as logical  .
     9479                if choice = false
     9480                then do:
     9481                   X_utd-lines.qnty-scan = kk.
     9482                  assign
     9483                     browse br-utd X_utd-lines.qnty-scan
     9484                     .
     9485                  if X_utd-lines.Quantity = X_utd-lines.qnty-scan then X_utd-lines.stts = "Проверен" .
     9486                  else X_utd-lines.stts = "Ожидает проверку" .
     9487                     recid_utd = recid (X_utd-lines) .
     9488                     run mark-temp (?).
