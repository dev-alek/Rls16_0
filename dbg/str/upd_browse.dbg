      567   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      569     (input  v-report-name
      570     ,input  2
      571     ,output v-exist
      572     )  .
      573       if NOT v-exist then
      574       DO:
      575         Message
      576           "Нет заданий на печать ! "
      577           view-as alert-box .
      578         Return  .
      579       End.
      580       run gbl/prnfilen.w
      581         (input  ""
      582         ,input  p-DisabledOptions
      583         ,input  string(v-report-name )
      584         ,input  7
      585         ,output v-user-action
      586         ,output v-printed
      587         ) .
      588       if v-printed then
      589       do:
      590         return "YES" .
      591       end.
      592       else
      593       do:
      594         return "NO" .
      595       end.
      596     end.
      597   end procedure.
      598   procedure prn-lib-open-stream :
      599     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      600     define input parameter p-page-size    as integer no-undo .
      601     define input parameter p-is-stream    as logical no-undo .
      602     define input parameter p-append       as logical no-undo .
      603     define variable v-report-name as character no-undo .
      604     do
      605       on error undo, return error
      606       :
      607       run prn-lib-get-report-name  in this-procedure (
      608         input parParentProc
      609         ,output v-report-name
      610         ).
      611       if p-is-stream then
      612       do:
      613         if p-append then
      614         do:
      615           output stream PrnLibStream to value( v-report-name )
      616             page-size value(p-page-size) append .
      617         end.
      618         if not p-append then
      619         do:
      620           output stream PrnLibStream to value( v-report-name )
      621             page-size value(p-page-size) .
      622         end.
      623       end.
      624       if not p-is-stream then
      625       do:
      626         if p-append then
      627         do:
      628           output to value( v-report-name )
      629             page-size value(p-page-size) append .
      630         end.
      631         if not p-append then
      632         do:
      633           output to value( v-report-name )
      634             page-size value(p-page-size) .
      635         end.
      636       end.
      637     end.
      638   end procedure.
      639   procedure prn-lib-open-exp :
      640     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      641     define input parameter p-is-stream    as logical no-undo .
      642     define input parameter p-is-append    as logical no-undo .
      643     define output parameter p-ReportFileName as char init "report" no-undo.
      644     define output parameter p-process as logical no-undo .
      645     define variable glog as logical no-undo .
      646     do
      647       on error undo, return error
      648       :
      649       SYSTEM-DIALOG GET-FILE p-ReportFileName
      650         TITLE      "Укажите путь"
      651         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      652         ASK-OVERWRITE
      653         CREATE-TEST-FILE
      654         SAVE-AS
      655         USE-FILENAME
      656         DEFAULT-EXTENSION "txt"
      657         UPDATE glog
      658         .
      659       if not glog then  return.
      660       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      661       if p-is-stream then
      662       do:
      663         if p-is-append then
      664         do:
      665           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      666         end.
      667         else
      668         do:
      669           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      670         end.
      671       end.
      672       else
      673       do:
      674         if p-is-append then
      675         do:
      676           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      677         end.
      678         else
      679         do:
      680           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      681         end.
      682       end.
      683       p-process = yes.
      684     end.
      685   end procedure.
      686   procedure prn-lib-get-report-name :
      687     define input parameter parParentProc  as widget-handle no-undo.
      688     define output parameter p-report-name as character no-undo .
      689     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      690   end procedure.
      691   procedure prn-lib-reportviewer-report-name :
      692     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      693     define input parameter p-report-name-html as character no-undo .
      694     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      695   end procedure.
      696   procedure prn-lib-reportviewer :
      697     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      698     define input parameter p-report-name-html as character no-undo .
      699     define input parameter p-param        as character no-undo .
      700     define variable v-excel           as character no-undo init 'TRUE' .
      701     define variable v-value-character as character no-undo .
      702     define variable v-value-integer   as character no-undo .
      703     define variable v-value-date      as date      no-undo .
      704     define variable v-value-decimal   as decimal   no-undo .
      705     define variable rep-excel         as logical   no-undo .
      706     define variable excel-string      as character no-undo .
      707     define variable v-param-type      as character no-undo .
      708     define variable v-tth             as handle    no-undo .
      709     run adm/shattri.p (
      710       input "get":U
      711       ,input  ""
      712       ,input  0
      713       ,input  'report-glob':U
      714       ,input  'rep-excel':U
      715       ,output v-value-character
      716       ,output v-value-date
      717       ,output v-value-decimal
      718       ,output v-value-integer
      719       ,output rep-excel
      720       ,output v-param-type
      721       ,INPUT-OUTPUT table-handle v-tth
      722       )  .
      723     if rep-excel then v-excel = "TRUE" .
      724     else v-excel = "FALSE" .
      725     if p-param eq ""
      726     then
      727        p-param = "EXCEL:" + v-excel.
      728     else
      729        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      730     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      731   end procedure.
      732   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      733   define variable v-waitfram-action01         as character   no-undo .
      734   define variable v-waitfram-action02         as character   no-undo .
      735   define variable v-waitfram-action03         as character   no-undo .
      736   define variable mWaitFramTextBeg            as character   no-undo.
      737   define variable mWaitFramTextEnd            as character   no-undo.
      738   define variable mWaitFramView               as logical     no-undo.
      739   define variable mWaitProcEvent              as logical     no-undo init yes.
      740   define variable mWaitFramInterval           as integer     no-undo init 1 .
      741   define variable mWaitFramStop               as logical     no-undo.
      742   define variable mWaitFramStopUser           as logical     no-undo.
      743   define variable mWaitFramStopTimeOut        as logical     no-undo.
      744   define variable mWaitFramStartProc          as datetime-tz no-undo.
      745   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      746   define button B-WaitFramStop auto-end-key
      747        label "Стоп"
      748        size 10 by 1 tooltip "Остоновить процесс".
      749   define button B-viewProcInfo
      750        label "Информация"
      751        size 15 by 1 tooltip "Информация о процесс".
      752   define frame waitfram
      753     v-waitfram-action01 format "x(72)" no-label skip
      754     v-waitfram-action02 format "x(72)" no-label skip
      755     v-waitfram-action03 format "x(72)" no-label skip
      756     B-viewProcInfo
      757     B-WaitFramStop at row 4 col 30
      758     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      759     .
      760   define new global shared variable mBatchMode as logical no-undo init ?.
      761   define variable mFramBachModHandle as handle no-undo.
      762   mFramBachModHandle = frame waitfram:handle.
      763   define variable mFameOldVis as logical no-undo.
      764   define variable mVisCUrentVin as logical no-undo.
      765   if session:batch-mode
      766   then
      767      mBatchMode = yes.
      768   if mBatchMode = ? then do:
      769     mVisCUrentVin = current-window:visible.
      770     mFameOldVis = mFramBachModHandle:visible.
      771     mFramBachModHandle:visible  = yes.
      772     mBatchMode = mFramBachModHandle:visible ne yes.
      773     mFramBachModHandle:visible = mFameOldVis.
      774     current-window:visible = mVisCUrentVin.
      775   end.
      776    if  log-manager:logfile-name ne ?
      777     then DO:
      778         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      779         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      780         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      781     end.
      782   on choose of B-WaitFramStop in frame waitfram
      783   do:
      784     mWaitFramStop = yes.
      785     mWaitFramStopUser = yes.
      786   end.
      787   function waitfram-check-timeout returns logical():
      788      define variable vtime as int64 no-undo.
      789      if mWaitFramStopTimeOut
      790      then
      791         return yes.
      792      vtime = ( now - mWaitFramStartProc ) / 1000 .
      793      if     mWaitFramTimeOut ne ?
      794         and mWaitFramTimeOut ne 0
      795         and mWaitFramTimeOut lt vtime
      796      then do:
      797         mWaitFramStopTimeOut = yes.
      798      end.
      799      return mWaitFramStopTimeOut.
      800   end.
      801   procedure waitfram-hide :
      802     if not session:batch-mode
      803     then do
      804     on error undo, return error return-value
      805     :
      806       pause 0 before-hide .
      807       if not mBatchMode then
      808         hide frame waitfram .
      809     if     not mWaitFramView
      810        and mWaitProcEvent
      811     then
      812       process events .
      813     end.
      814   end procedure.
      815   procedure waitfram-show :
      816     define input  parameter p-message as character no-undo .
      817     define variable v-left-margin as integer   no-undo .
      818     if not session:batch-mode
      819     then do
      820     on error undo, return error return-value
      821     :
      822       if length(p-message) <= 70 then do:
      823         assign
      824           v-left-margin = integer((70 - length(p-message)) / 2)
      825         .
      826         assign
      827           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      828         .
      829         assign
      830           v-waitfram-action01 = " "
      831           v-waitfram-action02 = " "
      832                                    + fill(" ", v-left-margin)
      833                                    + p-message
      834           v-waitfram-action03 = " "
      835         .
      836       end.
      837       else do:
      838         define variable vRindex1 as integer no-undo.
      839         define variable vRindex2 as integer no-undo.
      840         vRindex1 = r-index(p-message," ",70).
      841         if vRindex1 = 0
      842         then
      843            vRindex1 = 70.
      844         if length(p-message)  <= vRindex1 + 70 then do:
      845           assign
      846             v-waitfram-action01 = " "
      847             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      848             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      849           .
      850         end.
      851         else do:
      852           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      853           if vRindex2 <= vRindex1
      854           then
      855              vRindex2 = vRindex1 + 70.
      856           assign
      857             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      858             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      859             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      860           .
      861         end.
      862       end.
      863       B-viewProcInfo:visible   in frame waitfram = no.
      864       B-viewProcInfo:sensitive in frame waitfram = no.
      865       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      866       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      867       if  (   mWaitFramView
      868          or  mWaitProcEvent)
      869          and not mBatchMode
      870       then
      871          display
      872             v-waitfram-action01 skip
      873             v-waitfram-action02 skip
      874             v-waitfram-action03 skip
      875          with frame waitfram .
      876       if     mWaitFramView
      877          then do:
      878             if     mWaitFramInterval ne ?
      879                and not mBatchMode
      880             then
      881                wait-for go of frame waitfram pause mWaitFramInterval.
      882          end.
      883          else
      884             if     mWaitProcEvent
      885                and not mBatchMode
      886             then
      887                process events .
      888     end.
      889   end procedure.
      890      procedure waitfram-show-this:
      891         define input  parameter iInterval as int64 no-undo.
      892         define variable vtime as int64 no-undo.
      893         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      894         mWaitFramInterval = iInterval.
      895         run waitfram-show (substitute("&1&2 &3&4" ,
      896                                       mWaitFramTextBeg ,
      897                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      898                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      899                                       mWaitFramTextEnd
      900                                      )
      901                           ).
      902      end.
      903      procedure WaitFramRunPause:
      904         define input  parameter iInterval as dec no-undo.
      905         define variable vStart  as datetime-tz no-undo.
      906         define variable vend    as datetime-tz no-undo.
      907         define variable vint as int64 no-undo.
      908         define variable vOk as logical no-undo.
      909         vStart = now.
      910         vend   = vStart.
      911         publish "WaitFramPause" (iInterval,output vOk).
      912         vend   =  now.
      913         vint = vend - vStart.
      914         vint = iInterval - vint / 1000.
      915         if     not mWaitFramStop
      916            and (   vint > 0
      917                 or (    not vOk
      918                     and iInterval eq ?
      919                     )
      920                 )
      921         then
      922            run waitfram-show-this (iInterval).
      923         vend   =  now.
      924         vint = vend - vStart.
      925         vint = iInterval - vint / 1000.
      926         if     not mWaitFramStop
      927            and vint > 0
      928         then do:
      929            run gbl/pause.p (vint * 1000).
      930         end.
      931         if iInterval ne ?
      932         then
      933            publish "WaitFramStop".
      934         waitfram-check-timeout().
      935      end.
      936      procedure WaitFramWaitFor:
      937         define input  parameter iInterval as dec no-undo.
      938         assign
      939            mWaitFramStartProc   = now
      940            mWaitFramStopUser    = no
      941            mWaitFramStopTimeOut = no
      942         .
      943         block-wait:
      944         do while not mWaitFramStop:
      945            run WaitFramRunPause (iInterval).
      946            if  waitfram-check-timeout()
      947            then do:
      948               leave block-wait.
      949            end.
      950         end.
      951         run waitfram-hide.
      952      end.
      953   procedure waitfram-join :
      954     define input  parameter p-line-1  as character no-undo .
      955     define input  parameter p-line-2  as character no-undo .
      956     define input  parameter p-line-3  as character no-undo .
      957     define output parameter p-message as character no-undo .
      958     do
      959     on error undo, return error return-value
      960     :
      961       assign
      962         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      963                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      964                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      965       .
      966     end.
      967   end procedure.
      968   function waitfram-join-function returns character
      969     (input p-line-1 as character
      970     ,input p-line-2 as character
      971     ,input p-line-3 as character
      972     ).
      973     define variable v-message as character no-undo .
      974     run waitfram-join in this-procedure
      975       (input  p-line-1
      976       ,input  p-line-2
      977       ,input  p-line-3
      978       ,output v-message
      979       ) .
      980     return v-message .
      981   end function .
