    11069      run init-temp in this-procedure .
    11070      if available (buf_utd) then
    11071      do:
    11072         assign
    11073            frame d-utd:title = EdoTypeName(buf_utd.EDocType) + "_____№ " + string (buf_utd.DocumentNumber) + "_____" + p-mode.
    11074      end.
    11075   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
    11076   define variable v-diasize-need-maximize        as logical   no-undo init true  .
    11077   define variable v-diasize-orig-frame-height    as decimal   no-undo .
    11078   define variable v-diasize-orig-frame-width     as decimal   no-undo .
    11079   define variable v-diasize-current-frame-width  as decimal   no-undo .
    11080   define variable v-diasize-current-frame-height as decimal   no-undo .
    11081   define variable v-diasize-change-size          as logical   no-undo .
    11082   define variable v-diasize-resize-button        as handle    no-undo .
    11083   define variable v-diasize-wndmax               as logical   no-undo .
    11084   define variable v-diasize-wndstore             as logical   no-undo .
    11085   define variable v-diasize-proc-name            as character no-undo .
    11086   define variable v-diasize-browse-handle        as handle    no-undo .
    11087   define variable v-diasize-browse-number        as integer   no-undo .
    11088   define variable v-diasize-need-full-display    as logical   no-undo init false .
    11089   define temp-table temp-diasize-handle no-undo
    11090     field handle-value  as handle
    11091     field save-position as decimal
    11092     index xpk is primary unique handle-value
    11093     .
    11094   define temp-table temp-browse-handle no-undo
    11095     field browse-type   as character
    11096     field browse-number as integer
    11097     field browse-handle as handle
    11098     field original-size as decimal
    11099     index xpk is primary unique browse-type browse-number
    11100     index xie browse-type browse-handle
    11101   .
    11102   procedure diasize_change-height :
    11103     define input  parameter p-change-value  as decimal   no-undo .
    11104     define input  parameter p-move-resize   as logical   no-undo .
    11105     define variable v-field-group-handle    as handle    no-undo .
    11106     define variable v-object-handle         as handle    no-undo .
    11107     define variable v-frame-height          as decimal   no-undo .
    11108     define variable v-frame-virtual-height  as decimal   no-undo .
    11109     define variable v-browse-height         as decimal   no-undo .
    11110     define variable v-window-height         as decimal   no-undo .
    11111     define variable v-window-virtual-height as decimal   no-undo .
    11112     define variable v-change-sign           as integer   no-undo .
    11113     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    11114     define buffer buf_temp-browse-handle  for temp-browse-handle .
    11115     if p-change-value > 0
    11116     then do:
    11117       if frame d-utd :height + p-change-value
    11118           > decimal(session :work-area-height-pixels) / session :pixels-per-row
    11119       then do:
    11120         assign
    11121           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
    11122                           - (frame d-utd :height-chars)
    11123         .
    11124         if p-change-value <= 0
    11125         then do:
    11126           run diasize_position-resize-button in this-procedure .
    11127           return .
    11128         end.
    11129       end.
    11130     end.
    11131     if p-change-value < 0
    11132     then do:
    11133       if frame d-utd :height + p-change-value < v-diasize-orig-frame-height
    11134       then do:
    11135         assign
    11136           p-change-value = v-diasize-orig-frame-height
    11137                          - (frame d-utd :height-chars)
    11138         .
    11139         if p-change-value >= 0
    11140         then do:
    11141           run diasize_position-resize-button in this-procedure .
    11142           return .
    11143         end.
    11144       end.
    11145     end.
    11146     if p-change-value >= 0
    11147     then do:
    11148       assign
    11149         v-change-sign = 1
    11150       .
    11151     end.
    11152     else do:
    11153       assign
    11154         v-change-sign = -1
    11155       .
    11156     end.
    11157     assign
    11158       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
    11159     .
    11160     if p-change-value = 0
    11161     then do:
    11162       run diasize_position-resize-button in this-procedure .
    11163       return .
    11164     end.
    11165     move_block:
    11166     do
    11167     on error undo move_block, retry move_block
    11168     :
    11169       if retry
    11170       then do:
    11171         do
    11172         on error undo move_block, leave move_block
    11173         :
    11174           if p-change-value > 0
    11175           then do:
    11176             for each buf_temp-diasize-handle
    11177             on error undo, next
    11178             :
    11179               assign
    11180                 v-object-handle = buf_temp-diasize-handle.handle-value
    11181               .
    11182               if v-object-handle <> v-diasize-resize-button
    11183               then do:
    11184                 assign
    11185                   v-object-handle :row = buf_temp-diasize-handle.save-position
    11186                 .
    11187               end.
    11188             end.
    11189             assign
    11190               v-diasize-browse-handle :height = v-browse-height
    11191             .
    11192             for each buf_temp-browse-handle
    11193               where buf_temp-browse-handle.browse-type = 'height':u
    11194             on error undo, next
    11195             :
    11196               assign
    11197                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
    11198               .
    11199             end.
    11200             assign
    11201               frame d-utd :height = v-frame-height
    11202             .
    11203             if frame d-utd :scrollable = true
    11204             then do:
    11205               assign
    11206                 frame d-utd :virtual-height = v-frame-virtual-height
    11207               .
    11208             end.
    11209             run diasize_position-resize-button in this-procedure .
    11210           end.
    11211           else do:
    11212             if frame d-utd :scrollable = true
    11213             then do:
    11214               assign
    11215                 frame d-utd :virtual-height = v-frame-virtual-height
    11216               .
    11217             end.
    11218             assign
    11219               frame d-utd :height = v-frame-height
    11220             .
    11221             assign
    11222               v-diasize-browse-handle :height = v-browse-height
    11223             .
    11224             for each buf_temp-browse-handle
    11225               where buf_temp-browse-handle.browse-type = 'height':u
    11226             on error undo, next
    11227             :
    11228               assign
    11229                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
    11230               .
    11231             end.
    11232             for each buf_temp-diasize-handle
    11233             on error undo, next
    11234             :
    11235               assign
    11236                 v-object-handle = buf_temp-diasize-handle.handle-value
    11237               .
    11238               if v-object-handle <> v-diasize-resize-button
    11239               then do:
    11240                 assign
    11241                   v-object-handle :row = buf_temp-diasize-handle.save-position
    11242                 .
    11243               end.
    11244             end.
    11245             run diasize_position-resize-button in this-procedure .
    11246           end.
    11247           assign
    11248             v-diasize-change-size = false
    11249           .
    11250           leave move_block .
    11251         end.
    11252       end.
    11253       assign
    11254         v-diasize-need-full-display = true
    11255       .
    11256       if v-diasize-change-size = false
    11257       then do:
    11258         assign
    11259           v-diasize-change-size = true
    11260         .
    11261       end.
    11262       else do:
    11263         return .
    11264       end.
    11265       assign
    11266         v-frame-height = frame d-utd :height
    11267         v-frame-virtual-height = frame d-utd :virtual-height
    11268         v-browse-height = v-diasize-browse-handle :height
    11269       .
    11270       for each buf_temp-browse-handle
    11271         where buf_temp-browse-handle.browse-type = 'height':u
    11272       :
    11273         assign
    11274           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
    11275         .
    11276       end.
    11277       for each buf_temp-diasize-handle
    11278       :
    11279         delete buf_temp-diasize-handle .
    11280       end.
    11281       assign
    11282         v-field-group-handle = frame d-utd :first-child
    11283       .
    11284       do while valid-handle(v-field-group-handle)
    11285       :
    11286         assign
    11287           v-object-handle = v-field-group-handle :first-child
    11288         .
    11289         do while valid-handle(v-object-handle)
    11290         :
    11291           if  v-object-handle <> v-diasize-browse-handle :handle
    11292           and can-query(v-object-handle, "row")
    11293           and can-query(v-object-handle, "height")
    11294           and ( v-object-handle :row > v-diasize-browse-handle :row )
    11295           then do:
    11296             find first buf_temp-browse-handle
    11297               where buf_temp-browse-handle.browse-type   = 'height':u
    11298                 and buf_temp-browse-handle.browse-handle = v-object-handle
    11299               no-error .
