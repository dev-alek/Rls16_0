    12987         display
    12988            f-num-name-2
    12989            f-date-name-2
    12990            with frame d-utd .
    12991      end.
    12992      if f-total = 0 then
    12993      do:
    12994         hide
    12995            f-total
    12996            f-vat
    12997            in frame d-utd .
    12998      end.
    12999      if log-res-statch then
    13000      do:
    13001         menu-item m_choose-status:sensitive in menu POPUP-MENU-b-servis = yes.
    13002      end.
    13003      else
    13004      do:
    13005         menu-item m_choose-status:sensitive in menu POPUP-MENU-b-servis = no.
    13006      end.
    13007      if log-edi-doc_update and c-status = ObjSrv:Env:Utd:Sts:TH:AwaitingDelivery:KeyIntDB and g#db-num <> 0 then
    13008      do:
