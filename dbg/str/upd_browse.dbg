    10339      END.
    10340   ON CHOOSE OF MENU-ITEM m_reset_row_data
    10341      DO:
    10342         define buffer cancel_utd-marking-lines for ub.utd-marking-lines .
    10343         define buffer cancel_marking           for ub.marking .
    10344         define buffer buf_utd-lines-attr       for ub.utd-lines-attr .
    10345         define buffer buf_marking-attr         for ub.marking-attr .
    10346         define buffer cancel_marking-attr         for ub.marking-attr .
    10347         define buffer cancel_marking-lines-attr for ub.utd-marking-lines-attr.
    10348         define variable v-gds-code as integer no-undo.
    10349         if available (X_utd-lines) then
    10350         do:
    10351            for each cancel_utd-marking-lines exclusive-lock where cancel_utd-marking-lines.doc-id  = x_utd-lines.doc-id
    10352                 and cancel_utd-marking-lines.db-num  = x_utd-lines.db-num
    10353                 and cancel_utd-marking-lines.lineNum = x_utd-lines.lineNum
    10354                 and cancel_utd-marking-lines.doc-level = 1
    10355                 and cancel_utd-marking-lines.sts = Marking:Checked_:KeyIntDB,
    10356               first cancel_marking exclusive-lock where
    10357                     cancel_marking.mark = cancel_utd-marking-lines.mark
    10358            :
    10359               if cancel_marking.sts = Marking:ungrouped:KeyIntDB then
    10360               do:
    10361                 if not isSaleMarkInUpak(cancel_utd-marking-lines.mark) then
    10362                   setStatusUpak (
    10363                     cancel_utd-marking-lines.db-num,
    10364                     cancel_utd-marking-lines.doc-id,
    10365                     cancel_utd-marking-lines.lineNum,
    10366                     cancel_utd-marking-lines.mark,
    10367                     Marking:DeliveryControl:KeyIntDB
    10368                   ).
    10369               end.
    10370               else do:
    10371                 setStatusUpak (
    10372                   cancel_utd-marking-lines.db-num,
    10373                   cancel_utd-marking-lines.doc-id,
    10374                   cancel_utd-marking-lines.lineNum,
    10375                   cancel_utd-marking-lines.mark,
    10376                   Marking:DeliveryControl:KeyIntDB
    10377                 ).
    10378               end.
    10379            end.
    10380            if x_utd-lines.isArtic and x_utd-lines.isWeight
    10381            then do:
    10382                for each cancel_utd-marking-lines exclusive-lock where
    10383                         cancel_utd-marking-lines.doc-id  = x_utd-lines.doc-id
    10384                     and cancel_utd-marking-lines.db-num  = x_utd-lines.db-num
    10385                     and cancel_utd-marking-lines.lineNum = x_utd-lines.lineNum,
    10386                first cancel_marking no-lock where
    10387                      cancel_marking.mark = cancel_utd-marking-lines.mark:
    10388                   if not ChkAnotherUtd(x_utd-lines.doc-id, x_utd-lines.db-num, cancel_marking.mark) then do:
    10389                       find first cancel_marking-attr exclusive-lock where
    10390                                  cancel_marking-attr.mark = cancel_utd-marking-lines.mark
    10391                              and cancel_marking-attr.attr-code = "weight"
    10392                              no-wait no-error.
    10393                       if avail cancel_marking-attr then
    10394                          delete cancel_marking-attr.
    10395                   end.
    10396                   delete cancel_utd-marking-lines.
    10397                end.
    10398            end.
    10399            X_utd-lines.qnty-scan = 0 .
    10400            setattrUtdlines(X_utd-lines.db-num, X_utd-lines.doc-id, X_utd-lines.LineNum, "QuantityBarCode", string(X_utd-lines.qnty-scan)).
    10401            if not x_utd-lines.isMarking then
    10402            do:
    10403               if x_utd-lines.isArtic and x_utd-lines.isWeight then
    10404               do:
    10405                  X_utd-lines.PieceFact = "" .
    10406                  setattrUtdlines(X_utd-lines.db-num, X_utd-lines.doc-id, X_utd-lines.LineNum, "QuantityPiece", X_utd-lines.PieceFact).
    10407               end.
    10408            end.
    10409            run mark-temp in this-procedure (X_utd-lines.LineNum).
    10410         end.
    10411         if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
    10412      END.
    10413   ON CHOOSE OF MENU-ITEM m_check-akt
    10414      DO:
    10415         define buffer bf_utd for ub.utd .
    10416         define variable v-rec-list as character  no-undo .
    10417         define variable not-mark   as logical    no-undo .
    10418         define variable mark-qnty  as integer    no-undo .
    10419         define variable bar-qnty   as integer    no-undo .
    10420         define variable LineNum    as integer    no-undo .
    10421         define variable vconnect   as com-handle no-undo.
    10422         define variable vmark      as character  no-undo.
    10423         define buffer buf_utd-marking-lines for ub.utd-marking-lines .
    10424         define buffer bf_utd-marking-lines  for ub.utd-marking-lines .
    10425         define buffer bf_marking            for ub.marking .
    10426         define buffer bf_utd-lines-attr     for ub.utd-lines-attr .
    10427         define variable mark-qnty-gray      as integer   no-undo .
    10428         define variable mark-qnty-check     as integer   no-undo .
    10429         define variable bar-qnty-gray       as integer   no-undo .
    10430         define variable bar-qnty-check      as integer   no-undo .
    10431         do:
    10432            find first bf_utd exclusive-lock where bf_utd.DocumentNumber = buf_utd.DocumentNumber and
    10433               bf_utd.DocumentDate = buf_utd.DocumentDate and bf_utd.edoctype = objSrv:Env:Utd:EDocType:AKT:KeyIntDB no-error .
    10434            if not available (bf_utd) then
    10435            do:
    10436               run str/UPD.w ( parparentproc, 'ВЫБОР':U, objSrv:Env:Utd:EDocType:AKT:KeyIntDB, "", input-output vconnect, output v-rec-list)  no-error .
    10437               find first bf_utd exclusive-lock where recid(bf_utd) = integer(v-rec-list) no-error .
    10438            end.
    10439            if available (bf_utd) then
    10440            do:
    10441               mark-qnty-gray  = 0 .
    10442               mark-qnty-check = 0 .
    10443               bar-qnty-gray   = 0 .
    10444               bar-qnty-check  = 0 .
    10445               mark-qnty = 0 .
    10446               bar-qnty = 0 .
    10447               NEXT_:
    10448               for each buf_utd-lines no-lock where buf_utd-lines.db-num = buf_utd.db-num and
    10449                  buf_utd-lines.doc-id = buf_utd.doc-id:
    10450                  LineNum = 0 .
    10451                  if logical(getAttrUtdLinesEx (buf_utd-lines.db-num,buf_utd-lines.doc-id,buf_utd-lines.LineNum,"MarkUtdLine","yes"))
    10452                  then do:
    10453                     for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
    10454                        and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
    10455                        and buf_utd-marking-lines.gds-code = buf_utd-lines.gds-code
    10456                        and buf_utd-marking-lines.linenum = buf_utd-lines.linenum
    10457                        and buf_utd-marking-lines.doc-level = 1:
    10458                        vmark = getcodeident(buf_utd-marking-lines.mark).
    10459                        find first bf_utd-marking-lines no-lock where bf_utd-marking-lines.db-num = bf_utd.db-num
    10460                           and bf_utd-marking-lines.doc-id = bf_utd.doc-id
    10461                           and bf_utd-marking-lines.gds-code = buf_utd-marking-lines.gds-code
    10462                           and bf_utd-marking-lines.mark begins vmark no-error .
    10463                        if not available (bf_utd-marking-lines) then
    10464                        do:
    10465                           not-mark = true .
    10466                           next next_ .
    10467                        end.
    10468                        find first buf_marking exclusive-lock where buf_marking.mark = buf_utd-marking-lines.mark
    10469                           and (buf_marking.sts = Marking:GrayZone:KeyIntDB
    10470                           or buf_marking.sts = Marking:MarkError:KeyIntDB) no-error .
    10471                        if available (buf_marking) then
    10472                        do:
    10473                           not-mark = true .
    10474                           next next_ .
    10475                        end.
    10476                     end.
    10477                     for each buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
    10478                        and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
    10479                        and buf_utd-marking-lines.gds-code = buf_utd-lines.gds-code
    10480                        and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum,
    10481                        first bf_utd-marking-lines exclusive-lock where bf_utd-marking-lines.db-num = bf_utd.db-num
    10482                        and bf_utd-marking-lines.doc-id = bf_utd.doc-id
    10483                        and bf_utd-marking-lines.gds-code = buf_utd-marking-lines.gds-code
    10484                        and bf_utd-marking-lines.mark begins buf_utd-marking-lines.mark
    10485                        and bf_utd-marking-lines.doc-level = 1:
    10486                        if length (buf_utd-marking-lines.mark) > length(bf_utd-marking-lines.mark)
    10487                           then
    10488                        do:
    10489                           find first bf_marking where bf_marking.mark eq buf_utd-marking-lines.mark
    10490                              exclusive-lock no-error.
    10491                           if available bf_marking
    10492                              then
    10493                           do:
    10494                              find first bf_marking where bf_marking.mark eq bf_utd-marking-lines.mark
    10495                                 exclusive-lock no-error.
    10496                              if available bf_marking
    10497                                 then
    10498                              do:
    10499                                 g#auto = yes.
    10500                                 delete bf_marking.
    10501                                 g#auto = no.
    10502                              end.
    10503                           end.
    10504                           bf_utd-marking-lines.mark = buf_utd-marking-lines.mark.
    10505                        end.
    10506                        if tree:LevelDownUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num) then
    10507                        do:
    10508                           tree:StatusDownUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num, Marking:Checked_:KeyIntDB) .
    10509                        end.
    10510                        for first buf_marking exclusive-lock where buf_marking.mark = buf_utd-marking-lines.mark:
    10511                           mark-qnty-check = mark-qnty-check + buf_marking.box-qnty .
    10512                           buf_marking.sts = Marking:Checked_:KeyIntDB.
    10513                           buf_utd-marking-lines.sts = Marking:Checked_:KeyIntDB.
    10514                        end.
    10515                     end.
    10516                  end.
    10517                  else do:
    10518                     for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
    10519                        and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
    10520                        and buf_utd-marking-lines.gds-code = buf_utd-lines.gds-code
    10521                        and buf_utd-marking-lines.linenum = buf_utd-lines.linenum
    10522                        and buf_utd-marking-lines.doc-level = 1:
    10523                        vmark = getcodeident(buf_utd-marking-lines.mark).
    10524                        find first bf_utd-marking-lines no-lock where bf_utd-marking-lines.db-num = bf_utd.db-num
    10525                           and bf_utd-marking-lines.doc-id = bf_utd.doc-id
    10526                           and bf_utd-marking-lines.gds-code = buf_utd-marking-lines.gds-code
    10527                           and bf_utd-marking-lines.mark = vmark no-error .
    10528                        if not available (bf_utd-marking-lines) then
    10529                        do:
    10530                           not-mark = true .
    10531                           next next_ .
    10532                        end.
    10533                     end.
    10534                     for each buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
    10535                        and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
    10536                        and buf_utd-marking-lines.gds-code = buf_utd-lines.gds-code
    10537                        and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum,
    10538                        first bf_utd-marking-lines exclusive-lock where bf_utd-marking-lines.db-num = bf_utd.db-num
    10539                        and bf_utd-marking-lines.doc-id = bf_utd.doc-id
    10540                        and bf_utd-marking-lines.gds-code = buf_utd-marking-lines.gds-code
    10541                        and bf_utd-marking-lines.mark = buf_utd-marking-lines.mark
    10542                        and bf_utd-marking-lines.doc-level = 1:
    10543                        for first bf_utd-lines-attr no-lock where bf_utd-lines-attr.attr-code = "QuantityBarCode" and
    10544                           bf_utd-lines-attr.db-num = bf_utd-marking-lines.db-num and
    10545                           bf_utd-lines-attr.doc-id = bf_utd-marking-lines.doc-id and
    10546                           bf_utd-lines-attr.LineNum = bf_utd-lines-attr.LineNum:
    10547                           bar-qnty-check = bar-qnty-check + integer(bf_utd-lines-attr.attr-value) .
    10548                           if integer(bf_utd-lines-attr.attr-value) = bf_utd-lines.Quantity then
    10549                           do:
    10550                              bf_utd-marking-lines.sts = Marking:Checked_:KeyIntDB.
    10551                           end.
    10552                        end.
    10553                     end.
    10554                  end.
    10555               end.
    10556               if not-mark and mark-qnty-check + bar-qnty-check  = 0 then
    10557               do:
    10558                  message "В документе неполный состав марок/штрих-кодов. Просканируйте марки/штрих-кодов вручную."
    10559                     view-as alert-box.
    10560               end.
    10561               if not-mark and mark-qnty-check + bar-qnty-check <> 0 then
    10562               do:
    10563                  for each buf_utd-lines no-lock where buf_utd-lines.db-num = buf_utd.db-num and
    10564                                                       buf_utd-lines.doc-id = buf_utd.doc-id:
    10565                     if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
    10566                     then do:
    10567                        for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num  = buf_utd-lines.db-num and
    10568                                                                     buf_utd-marking-lines.doc-id  = buf_utd-lines.doc-id and
    10569                                                                     buf_utd-marking-lines.lineNum = buf_utd-lines.lineNum and
    10570                                                                     buf_utd-marking-lines.doc-level = 1,
    10571                        first buf_marking where buf_marking.mark = buf_utd-marking-lines.mark
    10572                        no-lock:
    10573                           mark-qnty = mark-qnty + buf_marking.box-qnty .
    10574                        end.
    10575                     end.
    10576                     else do:
    10577                        for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num  = buf_utd-lines.db-num and
    10578                                                                     buf_utd-marking-lines.doc-id  = buf_utd-lines.doc-id and
    10579                                                                     buf_utd-marking-lines.lineNum = buf_utd-lines.lineNum and
    10580                                                                     buf_utd-marking-lines.doc-level = 1:
    10581                           for first bf_utd-lines-attr no-lock where bf_utd-lines-attr.attr-code = "QuantityBarCode" and
    10582                              bf_utd-lines-attr.db-num = buf_utd-marking-lines.db-num and
    10583                              bf_utd-lines-attr.doc-id = buf_utd-marking-lines.doc-id and
    10584                              bf_utd-lines-attr.LineNum = buf_utd-marking-lines.LineNum:
    10585                              bar-qnty = bar-qnty + integer(bf_utd-lines-attr.attr-value) .
    10586                              if integer(bf_utd-lines-attr.attr-value) = bf_utd-lines.Quantity then
    10587                              do:
    10588                                 buf_utd-marking-lines.sts = Marking:Checked_:KeyIntDB.
    10589                              end.
    10590                           end.
    10591                        end.
    10592                     end.
    10593                  end.
    10594                  mark-qnty-gray = mark-qnty - mark-qnty-check .
    10595                  bar-qnty-gray = bar-qnty - bar-qnty-check .
    10596                  if mark-qnty-check + bar-qnty-check <> 0 then
    10597                     bf_utd.doc-code = buf_utd.DocumentNumber .
    10598                  message "Проверка завершена" skip
    10599                     "Успешно проверено марок - " + string (mark-qnty-check) skip
    10600                     "Не проверено марок - " + string (mark-qnty-gray) skip
    10601                     "Успешно проверено марок - " + string (bar-qnty-check) skip
    10602                     "Не проверено марок - " + string (bar-qnty-gray) skip
    10603                     view-as alert-box.
    10604               end .
    10605               if mark-qnty-gray + bar-qnty-gray <> 0 then
    10606               do:
    10607                  F-text = "                     Просканируйте марку/штрих-кодов" .
    10608                  display F-text with frame d-utd .
    10609               end.
    10610            end.
    10611         end.
    10612         run mark-temp (?).
    10613         if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
    10614      END.
    10615   ON CHOOSE OF r-agnt IN FRAME d-utd
    10616      DO:
    10617         run ref/cli-all.w (
    10618            input parparentproc
    10619            ,input "b-sel"
    10620            ,input 'чел':U
    10621            ,input 'все':U
    10622            ,input 'текущие':U
    10623            ,input ?
    10624            ,input ",,,,,,NO,,"
    10625            ,input ""
    10626            ,output v-rid-list ) NO-ERROR.
    10627         IF v-rid-list = '':U THEN RETURN NO-APPLY.
    10628         FIND FIRST buf_clients NO-LOCK WHERE
    10629            recid(buf_clients) = INTEGER(v-rid-list) NO-ERROR.
    10630         IF NOT AVAILABLE buf_clients THEN RETURN NO-APPLY.
    10631         ASSIGN
    10632            f-agnt    = buf_clients.obj-code
    10633            agnt-name = buf_clients.obj-name
    10634            .
    10635         display f-agnt agnt-name  with frame d-utd.
    10636      END.
    10637   ON CHOOSE OF r-boss IN FRAME d-utd
    10638      DO:
    10639         run ref/cli-all.w (
    10640            input parparentproc
    10641            ,input "b-sel"
    10642            ,input 'чел':U
    10643            ,input 'все':U
    10644            ,input 'текущие':U
    10645            ,input ?
    10646            ,input ",,,,,,NO,,"
    10647            ,input ""
    10648            ,output v-rid-list ) NO-ERROR.
    10649         IF v-rid-list = '':U THEN RETURN NO-APPLY.
    10650         FIND FIRST buf_clients NO-LOCK WHERE
    10651            recid(buf_clients) = INTEGER(v-rid-list) NO-ERROR.
    10652         IF NOT AVAILABLE buf_clients THEN RETURN NO-APPLY.
    10653         ASSIGN
    10654            f-boss    = buf_clients.obj-code
    10655            boss-name = buf_clients.obj-name
    10656            .
    10657         display f-boss boss-name  with frame d-utd.
    10658      END.
    10659   ON CHOOSE OF r-contr-TH IN FRAME d-utd
    10660      DO:
    10661         define buffer buf_contract for contract.
    10662         define variable agnt-list as character no-undo .
    10663         if f-supp-code-TH <> 0 then
    10664         do:
    10665            run str/cont-all.w ( input  parParentProc, input v-cntxt-host-code-obj, input "b-sel":U, input 'фирма':U, input f-supp-type-TH, input f-supp-code-TH, input  ?, input  ?, input  "current", input 'при':U , input-output agnt-list   ) no-error .
    10666            find first buf_contract no-lock where RECID(buf_contract) = int (agnt-list) no-error.
    10667            if not available buf_contract then
    10668            do:
    10669               assign
    10670                  f-contr-TH      = 0
    10671                  f-contr-name-TH = ""
    10672                  .
    10673               display f-contr-TH f-contr-name-TH  with frame d-utd.
    10674               return.
    10675            end.
    10676            if c-type = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
    10677            then
    10678            do:
    10679               define variable v-tth             as handle    no-undo .
    10680               define variable v-value-character as character no-undo.
    10681               define variable v-value-date      as date      no-undo.
    10682               define variable v-value-decimal   as decimal   no-undo.
    10683               define variable v-value-integer   as integer   no-undo.
    10684               define variable v-param-type      as character no-undo.
    10685               define variable v-FlagEdo         as logical   no-undo.
    10686               run adm/shattri.p (
    10687                  input "get":U
    10688                  ,input  buf_utd.obj-type
    10689                  ,input  buf_utd.obj-code
    10690                  ,input  'marking':U
    10691                  ,input  'marking-EDO':U
    10692                  ,output v-value-character
    10693                  ,output v-value-date
    10694                  ,output v-value-decimal
    10695                  ,output v-value-integer
    10696                  ,output v-FlagEdo
    10697                  ,output v-param-type
    10698                  ,input-output table-handle v-tth
    10699                  ) no-error .
    10700               if v-FlagEdo then
    10701               do:
    10702                  if buf_contract.whole-send-news > 0 then
    10703                  do:
    10704                     assign
    10705                        f-contr-TH      = buf_contract.contract-code
    10706                        f-contr-name-TH = buf_contract.contract-prn-code + " от " + string(buf_contract.contract-date,"99/99/9999")
    10707                        .
    10708                  end.
    10709                  else
    10710                  do:
    10711                     message "У договора " + buf_contract.contract-prn-code + " нет признака - 'Поставки через ЭДО'"
    10712                        view-as alert-box.
    10713                     return no-apply .
    10714                  end.
    10715               end.
    10716               else
    10717               do:
    10718                  assign
    10719                     f-contr-TH      = buf_contract.contract-code
    10720                     f-contr-name-TH = buf_contract.contract-prn-code + " от " + string(buf_contract.contract-date,"99/99/9999")
    10721                     .
    10722               end.
    10723            end.
    10724            else
    10725            do:
    10726               assign
    10727                  f-contr-TH      = buf_contract.contract-code
    10728                  f-contr-name-TH = buf_contract.contract-prn-code + " от " + string(buf_contract.contract-date,"99/99/9999")
    10729                  .
    10730            end.
    10731            display f-contr-TH f-contr-name-TH  with frame d-utd.
    10732            if c-type <> objSrv:Env:Utd:EDocType:AKT:KeyIntDB
    10733            then
    10734               disable r-contr-TH with frame d-utd .
    10735            run enable_BUTTON .
    10736         end.
    10737         else message "Поставщик договора не известен"
    10738               view-as alert-box.
    10739      END.
    10740   ON CHOOSE OF r-obj-TH IN FRAME d-utd
    10741      DO:
    10742         define variable v-tth             as handle    no-undo .
    10743         define variable v-value-character as character no-undo.
    10744         define variable v-value-date      as date      no-undo.
    10745         define variable v-value-decimal   as decimal   no-undo.
    10746         define variable v-value-integer   as integer   no-undo.
    10747         define variable v-param-type      as character no-undo.
    10748         define variable v-FlagEdo         as logical   no-undo.
    10749         run ref/cli-all.w (
    10750            input parparentproc
    10751            ,input "b-sel"
    10752            ,input 'маг':U
    10753            ,input 'все':U
    10754            ,input 'текущие':U
    10755            ,input ?
    10756            ,input ",,,,,,NO,,"
    10757            ,input ""
    10758            ,output v-rid-list ) NO-ERROR.
    10759         IF v-rid-list = '':U THEN RETURN NO-APPLY.
    10760         FIND FIRST buf_clients NO-LOCK WHERE
    10761            recid(buf_clients) = INTEGER(v-rid-list) NO-ERROR.
    10762         IF NOT AVAILABLE buf_clients THEN RETURN NO-APPLY.
    10763         run adm/shattri.p (
    10764            input "get":U
    10765            ,input  buf_clients.obj-type
    10766            ,input  buf_clients.obj-code
    10767            ,input  'marking':U
    10768            ,input  'marking-EDO':U
    10769            ,output v-value-character
    10770            ,output v-value-date
    10771            ,output v-value-decimal
    10772            ,output v-value-integer
    10773            ,output v-FlagEdo
    10774            ,output v-param-type
    10775            ,input-output table-handle v-tth
    10776            ) no-error .
    10777         if not v-FlagEdo then
    10778         do:
    10779            message "Сформировать УПД для данного объекта невозможно." skip
    10780               "Для объекта не включен электронный документооборот"
    10781               view-as alert-box.
    10782            return no-apply .
    10783         end.
    10784         ASSIGN
    10785            f-obj-type-TH = buf_clients.obj-type
    10786            f-obj-code-TH = buf_clients.obj-code
    10787            f-obj-name-TH = buf_clients.obj-name
    10788            .
    10789         display f-obj-code-TH f-obj-type-TH f-obj-name-TH  with frame d-utd.
    10790         disable r-obj-TH with frame d-utd .
    10791         run enable_BUTTON .
    10792      END.
    10793   ON CHOOSE OF r-supp-TH IN FRAME d-utd
    10794      DO:
    10795         run ref/cli-all.w (
    10796            input parparentproc
    10797            ,input "b-sel"
    10798            ,input 'орг':U
    10799            ,input 'все':U
    10800            ,input 'текущие':U
    10801            ,input ?
    10802            ,input ",,,,,,NO,,"
    10803            ,input ""
    10804            ,output v-rid-list ) NO-ERROR.
    10805         IF v-rid-list = '':U THEN RETURN NO-APPLY.
    10806         FIND FIRST buf_clients NO-LOCK WHERE
    10807            recid(buf_clients) = INTEGER(v-rid-list) NO-ERROR.
    10808         IF NOT AVAILABLE buf_clients THEN RETURN NO-APPLY.
    10809         ASSIGN
    10810            f-supp-type-TH = buf_clients.obj-type
    10811            f-supp-code-TH = buf_clients.obj-code
    10812            f-supp-name-TH = buf_clients.obj-name
    10813            .
    10814         display f-supp-type-TH f-supp-code-TH f-supp-name-TH with frame d-utd .
    10815         if c-type <> objSrv:Env:Utd:EDocType:AKT:KeyIntDB
    10816         then
