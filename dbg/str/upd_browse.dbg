    13010      end.
    13011      else
    13012      do:
    13013         menu-item m_reset_row_data:sensitive in menu POPUP-MENU-b-servis = no.
    13014      end.
    13015      if not v-manual then
    13016      do:
    13017         v-mark:READ-ONLY IN FRAME d-utd        = TRUE .
    13018      end.
    13019      else do:
    13020         v-mark:READ-ONLY IN FRAME d-utd        = false .
    13021      end.
    13022      apply "VALUE-CHANGED" to br-utd in frame d-utd.
    13023   END PROCEDURE.
    13024   PROCEDURE init-temp :
    13025      define variable ii           as integer   no-undo .
    13026      define variable Status_      as character no-undo .
    13027      define variable StatusTH     as class     ibs.th.str.utd.sts.th   no-undo .
    13028      define variable Status_EDI   as character no-undo .
    13029      define variable StatusEDI    as class     ibs.th.str.utd.sts.edi  no-undo .
    13030      define variable Type_        as character no-undo .
    13031      define variable TypeTH       as class     ibs.th.str.utd.edoctype no-undo .
    13032      define variable v-StatusName as character no-undo .
    13033      Status_ = " " + chr(44) + '-1':U .
    13034      StatusTH = ObjSrv:Env:Utd:Sts:TH.
    13035      do ii = 1 to StatusTH:mapType:GetItemByLab(ii):
    13036         Status_ = Status_ + chr(44) + StatusTH:CurrProp:Label_ + chr(44) + string(StatusTH:CurrProp:KeyIntDB) .
    13037      end.
    13038      ASSIGN
    13039         c-status:LIST-ITEM-PAIRS  in frame d-utd = Status_ .
    13040      Status_EDI = " " + chr(44) + '-1':U .
    13041      StatusEDI = ObjSrv:Env:Utd:Sts:EDI.
    13042      do ii = 1 to StatusEDI:mapType:GetItemByLab(ii):
    13043         if StatusEDI:CurrProp:KeyIntDB = ObjSrv:Env:Utd:Sts:EDI:WithRecipientSignature:KeyIntDB then
    13044         do:
    13045            if available (buf_utd) then
    13046            do:
    13047               v-StatusName = StatusName(buf_utd.doc-id, buf_utd.db-num) .
    13048               Status_EDI = Status_EDI + chr(44) + StatusEDI:CurrProp:Label_ + " " + v-StatusName + chr(44) + string(StatusEDI:CurrProp:KeyIntDB) .
    13049            end.
    13050            else
    13051            do:
    13052               Status_EDI = Status_EDI + chr(44) + StatusEDI:CurrProp:Label_ + chr(44) + string(StatusEDI:CurrProp:KeyIntDB) .
    13053            end.
    13054         end.
    13055         else
    13056         do:
    13057            Status_EDI = Status_EDI + chr(44) + StatusEDI:CurrProp:Label_ + chr(44) + string(StatusEDI:CurrProp:KeyIntDB) .
    13058         end.
    13059      end.
    13060      ASSIGN
    13061         c-status-edi:LIST-ITEM-PAIRS  in frame d-utd = Status_EDI .
    13062      Type_ = " " + chr(44) + '0':U .
    13063      TypeTH = objSrv:Env:Utd:EDocType .
    13064      do ii = 1 to TypeTH:mapType:GetItemByLab(ii):
    13065         if p-mode = 'ДОБАВЛЕНИЕ':U then
    13066         do:
    13067            if TypeTH:CurrProp:KeyIntDB =  TypeTH:Introduce:KeyIntDB or TypeTH:CurrProp:KeyIntDB =  TypeTH:AKT:KeyIntDB then
    13068            do:
    13069               Type_ = Type_ + chr(44) + TypeTH:CurrProp:Label_ + chr(44) + string(TypeTH:CurrProp:KeyIntDB) .
    13070            end.
    13071         end.
    13072         else
    13073         do:
    13074            Type_ = Type_ + chr(44) + TypeTH:CurrProp:Label_ + chr(44) + string(TypeTH:CurrProp:KeyIntDB) .
    13075         end.
    13076      end.
    13077      ASSIGN
    13078         c-type:LIST-ITEM-PAIRS  in frame d-utd = Type_ .
    13079      if p-mode = 'ДОБАВЛЕНИЕ':U then
    13080      do:
    13081         if not available (buf_utd) then
    13082         do:
    13083            create buf_utd .
    13084            assign
    13085               buf_utd.DocumentDate = today
    13086               buf_utd.sts          = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
    13087               buf_utd.obj-code     = v-cntxt-obj-code
    13088               buf_utd.obj-type     = v-cntxt-obj-type
    13089               buf_utd.host-code    = v-cntxt-host-code-obj
    13090               .
    13091            validate buf_utd .
    13092         end.
    13093      end.
    13094      else
    13095      do:
    13096         if p-mode = 'ПРОСМОТР':U then find first buf_utd no-lock where buf_utd.doc-id = p-doc-id and buf_utd.db-num = p-db-num no-error .
    13097         if p-mode = 'ИЗМЕНЕНИЕ':U then find first buf_utd exclusive-lock where buf_utd.doc-id = p-doc-id and buf_utd.db-num = p-db-num no-wait no-error .
    13098         if  error-status:error then
    13099         do:
    13100            message "Документ занят другим пользователем"
    13101               view-as alert-box.
    13102            p-mode = 'ПРОСМОТР':U .
    13103            find first buf_utd no-lock where buf_utd.doc-id = p-doc-id and buf_utd.db-num = p-db-num no-error .
    13104         end.
    13105      end.
    13106      if available (buf_utd) then
    13107      do:
    13108         assign
    13109            f-num           = buf_utd.DocumentNumber
    13110            f-date          = buf_utd.DocumentDate
    13111            f-contr-name    = buf_utd.BaseDocumentNumber
    13112            f-contr-TH      = buf_utd.contract-code
    13113            f-contr-name-TH = ContName(buf_utd.contract-code, buf_utd.host-code)
    13114            c-status        = buf_utd.sts
    13115            mflagscan       = yes
    13116            .
    13117         c-status-edi = buf_utd.sts-edi .
    13118         assign
    13119            f-obj-code-TH  = buf_utd.obj-code
    13120            f-obj-type-TH  = buf_utd.obj-type
    13121            f-obj-name-TH  = CliName(buf_utd.obj-code, buf_utd.obj-type)
    13122            f-supp-code-TH = buf_utd.cli-code
    13123            f-supp-type-TH = buf_utd.cli-type
    13124            f-supp-name-TH = CliName(buf_utd.cli-code, buf_utd.cli-type)
    13125            f-obj-name-2   = buf_utd.obj-info
    13126            c-type         = buf_utd.EDocType
    13127            f-total        = buf_utd.total
    13128            f-vat          = buf_utd.vat
    13129            v-pred-status  = buf_utd.sts
    13130            f-comment      = buf_utd.comment
    13131            .
    13132         for first ub.utd no-lock where ub.utd.DocumentExt = buf_utd.parentDocumentExt and
    13133            ub.utd.OrganizationExt = buf_utd.parentOrganizationExt and
    13134            buf_utd.DocumentExt <> "" and buf_utd.parentDocumentExt <> "":
    13135            if ub.utd.DocumentNumber <> buf_utd.documentNumber then
    13136            do:
    13137               f-num-2           = ub.utd.DocumentNumber .
    13138               f-date-2          = ub.utd.DocumentDate .
    13139               display
    13140                  f-num-2
    13141                  f-date-2
    13142                  with frame d-utd .
    13143            end.
    13144            else
    13145            do:
    13146               hide
    13147                  f-num-2
    13148                  f-date-2
    13149                  in frame d-utd .
    13150            end.
    13151         end.
    13152         for each buf_utd-attr no-lock where buf_utd-attr.db-num = buf_utd.db-num and buf_utd-attr.doc-id = buf_utd.doc-id:
    13153            case buf_utd-attr.attr-code:
    13154               when "wrkr" then
    13155                  do:
    13156                     f-wrkr = integer(buf_utd-attr.attr-value) .
    13157                     wrkr-name = CliName(integer(buf_utd-attr.attr-value), 'чел':U) .
    13158                  end.
    13159               when "agnt" then
    13160                  do:
    13161                     f-agnt = integer(buf_utd-attr.attr-value) .
    13162                     agnt-name = CliName(integer(buf_utd-attr.attr-value), 'чел':U) .
    13163                  end.
    13164               when "boss" then
    13165                  do:
    13166                     f-boss = integer(buf_utd-attr.attr-value) .
    13167                     boss-name = CliName(integer(buf_utd-attr.attr-value), 'чел':U) .
    13168                  end.
    13169               when "order-item" then
    13170                  do:
    13171                     mOrderItem = buf_utd-attr.attr-value .
    13172                  end.
    13173            end case .
    13174         end.
    13175         if buf_utd.sts-edi <> 0 then
    13176         do:
    13177         end.
    13178         if buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:AwaitingDelivery:KeyIntDB and (buf_utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB or buf_utd.EdocType = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB) then type_mark = 1 .
    13179         else
    13180         do:
    13181            if c-status = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB then type_mark = 5 .
    13182            else type_mark = 0 .
    13183         end.
    13184      end.
    13185      if type_mark = 1 then
    13186      do:
    13187         R-error = 2 .
    13188         display R-error with frame d-utd .
    13189      end.
    13190      display
    13191         F-text
    13192         f-num
    13193         f-date
    13194         f-contr-TH
    13195         f-total
    13196         f-vat
    13197         f-contr-name-TH
    13198         f-contr-name
    13199         f-wrkr
    13200         f-agnt
    13201         f-boss
    13202         wrkr-name
    13203         agnt-name
    13204         boss-name
    13205         f-info
    13206         c-type
    13207         f-obj-name-2
    13208         f-gruz
    13209         c-status-edi
    13210         c-status
    13211         f-obj-code-TH
    13212         f-obj-type-TH
    13213         f-obj-name-TH
    13214         f-supp-code-TH
    13215         f-supp-type-TH
    13216         f-supp-name-TH
    13217         f-comment
    13218         with frame d-utd.
    13219      run mark-temp (?).
    13220      if m-gds-code ne ? and m-gds-code ne "" then do:    if r-error = 2 then   OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else    if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. else                          OPEN QUERY br-utd FOR EACH X_utd-lines                                     , first tt-utd-lines-filtr where tt-utd-lines-filtr.bar-code = m-gds-code and tt-utd-lines-filtr.db-num = X_utd-lines.db-num and tt-utd-lines-filtr.doc-id = X_utd-lines.doc-id and tt-utd-lines-filtr.LineNum = X_utd-lines.linenum  NO-LOCK INDEXED-REPOSITION. end. else do: if r-error = 2 then    OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts <> "Проверен", first tt-utd-lines-filtr  INDEXED-REPOSITION. else  if r-error-2 = 2 then OPEN QUERY br-utd FOR EACH X_utd-lines no-lock where X_utd-lines.stts begins "Ошибка"   , first tt-utd-lines-filtr  INDEXED-REPOSITION. else                        OPEN QUERY br-utd FOR EACH X_utd-lines NO-LOCK                                     , first tt-utd-lines-filtr  INDEXED-REPOSITION.      end.
    13221   END PROCEDURE.
    13222   PROCEDURE add-filter :
    13223      define input  parameter idb-num   as integer no-undo.
    13224      define input  parameter idoc-id   as integer no-undo.
    13225      define input  parameter ilinenum  as integer no-undo.
    13226      define input  parameter igds-code as character  no-undo.
    13227      find first tt-utd-lines-filtr where tt-utd-lines-filtr.db-num   = idb-num
    13228                                      and tt-utd-lines-filtr.doc-id   = idoc-id
    13229                                      and tt-utd-lines-filtr.linenum  = ilinenum
    13230                                      and tt-utd-lines-filtr.bar-code = igds-code
    13231       no-lock no-error.
    13232       if not available tt-utd-lines-filtr
    13233       then do:
    13234          create tt-utd-lines-filtr.
    13235          assign
    13236             tt-utd-lines-filtr.db-num   = idb-num
    13237             tt-utd-lines-filtr.doc-id   = idoc-id
    13238             tt-utd-lines-filtr.linenum  = ilinenum
    13239             tt-utd-lines-filtr.bar-code = igds-code
    13240          .
    13241      end.
    13242   end.
    13243   PROCEDURE mark-temp :
    13244      define input parameter iLine as integer no-undo.
    13245      define buffer buf_marking           for ub.marking .
    13246      define buffer buf_utd-marking-lines for ub.utd-marking-lines .
    13247      define buffer buf_utd-lines-attr    for ub.utd-lines-attr .
    13248      define buffer buf_goods             for ub.goods .
    13249      define buffer buf_bar-code          for ub.bar-code .
    13250      define buffer buf_marking-attr for ub.marking-attr.
    13251      define variable v-db-num       as integer   no-undo .
    13252      define variable v-doc-id       as integer   no-undo .
    13253      define variable vType          as character no-undo .
    13254      define variable vIsErrMark     as logical   no-undo .
    13255      define variable vQntyScan      as decimal   no-undo .
    13256      empty temp-table  tt-utd-lines-filtr.
    13257      run add-filter(?  ,
    13258                     ?  ,
    13259                     ? ,
    13260                     "нет товара").
    13261      for each buf_utd-lines no-lock where
    13262               buf_utd-lines.doc-id = buf_utd.doc-id and
    13263               buf_utd-lines.db-num = buf_utd.db-num and
    13264               (if iLine <> ? then buf_utd-lines.LineNum = iLine else true):
    13265         find first X_utd-lines EXCLUSIVE-LOCK where buf_utd-lines.doc-id = X_utd-lines.doc-id and buf_utd-lines.db-num = X_utd-lines.db-num and buf_utd-lines.LineNum = X_utd-lines.LineNum no-error .
    13266         buffer-copy buf_utd-lines to X_utd-lines .
    13267         define variable vper as logical no-undo.
    13268         getMarkUtdLine(buf_utd-lines.db-num,buf_utd-lines.doc-id,buf_utd-lines.LineNum,
    13269         output x_utd-lines.isMarking, output x_utd-lines.isArtic, output vper).
    13270         X_utd-lines.isWeight = WeighedProd(X_utd-lines.gds-code).
    13271         X_utd-lines.isVarWeight = WghProdVariable(buf_utd.obj-type, buf_utd.obj-code, X_utd-lines.gds-code).
    13272         X_utd-lines.isSelect = logical(getAttrUtdLinesEx (buf_utd-lines.db-num,
    13273                                                           buf_utd-lines.doc-id,
    13274                                                           buf_utd-lines.LineNum,
    13275                                                           "manual-selection",
    13276                                                           "no")).
    13277         if x_utd-lines.isMarking then
    13278         do:
    13279                            if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    13280                       ( buf_utd-lines.gds-code,
    13281                         'mark-type':U,
    13282                          output x_utd-lines.markType,
    13283                          output vtype
    13284                       ).
    13285         end.
    13286         if not x_utd-lines.isArtic and not x_utd-lines.isMarking
    13287         then do:
    13288            run add-filter(buf_utd-lines.db-num  ,
    13289                           buf_utd-lines.doc-id  ,
    13290                           buf_utd-lines.LineNum ,
    13291                           x_utd-lines.gds-code).
    13292         end.
    13293         else if x_utd-lines.isArtic
    13294         then do:
    13295            for each buf_utd-marking-lines  where buf_utd-marking-lines.db-num = buf_utd-lines.db-num and
    13296                                                  buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id and
    13297                                                  buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum
    13298            no-lock:
    13299               if  GetAttrUtdMarkingLinesEx
    13300                       (buf_utd-marking-lines.db-num,
    13301                        buf_utd-marking-lines.doc-id,
    13302                        buf_utd-marking-lines.LineNum,
    13303                        buf_utd-marking-lines.mark,
    13304                        "AddMarkWeight",
    13305                        "no") <> "yes"
    13306               then do:
    13307                  run add-filter(buf_utd-marking-lines.db-num  ,
    13308                                 buf_utd-marking-lines.doc-id  ,
    13309                                 buf_utd-marking-lines.LineNum ,
    13310                                 getGtinBydm(buf_utd-marking-lines.mark)).
    13311                  if X_utd-lines.isWeight then X_utd-lines.PieceTTH = String(getQntyUTDByCodId(buf_utd-marking-lines.mark)).
    13312               end.
    13313            end.
    13314         end.
    13315         if buf_utd.EdocType = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB
    13316         or (buf_utd.EdocType = objSrv:Env:Utd:EDocType:AKT:KeyIntDB
    13317             and not x_utd-lines.isMarking)
    13318         then
    13319         do:
    13320            for first buf_utd-lines-attr no-lock where buf_utd-lines-attr.db-num = X_utd-lines.db-num and
    13321               buf_utd-lines-attr.doc-id = X_utd-lines.doc-id and
    13322               buf_utd-lines-attr.LineNum = X_utd-lines.LineNum and
    13323               buf_utd-lines-attr.attr-code = "utd-fact-qnty":
    13324               X_utd-lines.fact-qnty = integer(buf_utd-lines-attr.attr-value) .
    13325            end.
    13326         end.
    13327         for first buf_utd-lines-attr no-lock where buf_utd-lines-attr.db-num = X_utd-lines.db-num and
    13328            buf_utd-lines-attr.doc-id = X_utd-lines.doc-id and
    13329            buf_utd-lines-attr.LineNum = X_utd-lines.LineNum and
    13330            buf_utd-lines-attr.attr-code = "Quantity":
    13331            X_utd-lines.UnitCliQnty = integer(buf_utd-lines-attr.attr-value) .
    13332         end.
    13333         if x_utd-lines.isMarking then do:
    13334           for first buf_utd-lines-attr no-lock where buf_utd-lines-attr.db-num = X_utd-lines.db-num and
    13335              buf_utd-lines-attr.doc-id = X_utd-lines.doc-id and
    13336              buf_utd-lines-attr.LineNum = X_utd-lines.LineNum and
    13337              buf_utd-lines-attr.attr-code = "QuantityBarCode":
    13338              X_utd-lines.qnty-scan = decimal(buf_utd-lines-attr.attr-value) .
    13339           end.
    13340         end.
    13341         else do:
    13342           for first buf_utd-lines-attr no-lock where buf_utd-lines-attr.db-num = X_utd-lines.db-num and
    13343              buf_utd-lines-attr.doc-id = X_utd-lines.doc-id and
    13344              buf_utd-lines-attr.LineNum = X_utd-lines.LineNum and
    13345              buf_utd-lines-attr.attr-code = "QuantityBarCode":
    13346              X_utd-lines.qnty-scan = decimal(buf_utd-lines-attr.attr-value) .
    13347           end.
    13348           if X_utd-lines.isWeight then
    13349           for first buf_utd-lines-attr no-lock where buf_utd-lines-attr.db-num = X_utd-lines.db-num and
    13350              buf_utd-lines-attr.doc-id = X_utd-lines.doc-id and
    13351              buf_utd-lines-attr.LineNum = X_utd-lines.LineNum and
    13352              buf_utd-lines-attr.attr-code = "QuantityPiece":
    13353              X_utd-lines.PieceFact = buf_utd-lines-attr.attr-value .
    13354           end.
    13355         end.
    13356         for first buf_bar-code no-lock where buf_bar-code.gds-code = buf_utd-lines.gds-code and
    13357            buf_bar-code.unit-cli = buf_utd-lines.UnitCode:
    13358            X_utd-lines.Price = buf_utd-lines.Price / buf_bar-code.cli-base-rate .
    13359         end.
    13360         X_utd-lines.sts_err = CheckErrForLine(buffer X_utd-lines:handle).
    13361         if not X_utd-lines.sts_err
    13362         then do:
    13363            X_utd-lines.DelivCodeMis = CheckErrForLineTypeCode (buffer X_utd-lines:handle,"CheckQnty","QntyMArk","warning",no).
    13364            if not X_utd-lines.DelivCodeMis
    13365            then do:
    13366               block-war:
    13367               for each buf_utd-marking-lines         where buf_utd-marking-lines.db-num = buf_utd-lines.db-num and
    13368                                                            buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id and
    13369                                                            buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum
    13370               no-lock:
    13371                  X_utd-lines.DelivCodeMis = CheckTypeForMarkLineType(buffer utd-marking-lines:handle,"*","*","warning").
    13372                  if X_utd-lines.DelivCodeMis
    13373                  then
    13374                     leave block-war.
    13375               end.
    13376            end.
    13377         end.
    13378         if x_utd-lines.isMarking then
    13379         do:
    13380            find first buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd-lines.db-num and
    13381               buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id and
    13382               buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum and
    13383               buf_utd-marking-lines.sts = Marking:MarkError:KeyIntDB no-error .
    13384            if available (buf_utd-marking-lines)
    13385               then X_utd-lines.stts = "Ошибка статус марки" .
    13386            else
    13387            do:
    13388               find first buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd-lines.db-num and
    13389                  buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id and
    13390                  buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum and
    13391                  buf_utd-marking-lines.doc-level = 1 and
    13392                  not can-do(Marking:EqualChecked,string(buf_utd-marking-lines.sts)) no-error .
    13393               if available (buf_utd-marking-lines) then  X_utd-lines.stts = "Ожидает проверку" .
    13394               else
    13395               do:
    13396                  find first buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd-lines.db-num and
    13397                     buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id and
    13398                     buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum and
    13399                     buf_utd-marking-lines.doc-level = 1 and
    13400                     can-do(Marking:EqualChecked,string(buf_utd-marking-lines.sts)) no-error .
    13401                  if available (buf_utd-marking-lines) then do:
    13402                      X_utd-lines.stts = "Проверен" .
    13403                  end.
    13404               end.
    13405            end.
    13406            assign
    13407              X_utd-lines.qnty-mark = 0
    13408              X_utd-lines.qnty-scan = 0
    13409            .
    13410            for each buf_utd-marking-lines no-lock where
    13411                     buf_utd-marking-lines.db-num  = buf_utd-lines.db-num
    13412                 and buf_utd-marking-lines.doc-id  = buf_utd-lines.doc-id
    13413                 and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum
    13414                 and buf_utd-marking-lines.doc-level = 1
    13415            :
    13416              X_utd-lines.qnty-mark = X_utd-lines.qnty-mark + 1.
    13417              if buf_utd-marking-lines.sts = Marking:Checked_:KeyIntDB then
    13418              do:
    13419                find first buf_marking no-lock where
    13420                           buf_marking.mark begins buf_utd-marking-lines.mark
    13421                no-error.
    13422                if available buf_marking then do:
    13423                    if X_utd-lines.isWeight
    13424                    then do:
    13425                       X_utd-lines.qnty-scan = X_utd-lines.qnty-scan + MarkWeight(buf_marking.mark).
    13426                    end.
    13427                    else
    13428                       X_utd-lines.qnty-scan = X_utd-lines.qnty-scan + buf_marking.box-qnty.
    13429                end.
    13430                else X_utd-lines.stts = "Ошибка статус марки" .
    13431              end.
    13432              else
    13433              do:
    13434                 run calcQntyMarkByUnit in this-procedure(
    13435                   buf_utd-lines.db-num,
    13436                   buf_utd-lines.doc-id,
    13437                   buf_utd-lines.LineNum,
    13438                   buf_utd-marking-lines.mark,
    13439                   X_utd-lines.isWeight,
    13440                   output vQntyScan,
    13441                   output vIsErrMark).
    13442                 X_utd-lines.qnty-scan = X_utd-lines.qnty-scan + vQntyScan.
    13443                 if vIsErrMark then X_utd-lines.stts = "Ошибка статус марки" .
    13444              end.
    13445            end.
    13446            find first buf_utd-lines-attr where
    13447                       buf_utd-lines-attr.db-num = X_utd-lines.db-num and
    13448                       buf_utd-lines-attr.doc-id = X_utd-lines.doc-id and
    13449                       buf_utd-lines-attr.LineNum = X_utd-lines.LineNum and
    13450                       buf_utd-lines-attr.attr-code = "QuantityBarCode"
    13451                 exclusive-lock no-error.
    13452            if avail buf_utd-lines-attr then
    13453            do:
    13454               if X_utd-lines.qnty-scan <> 0 then
    13455                 buf_utd-lines-attr.attr-value = string(X_utd-lines.qnty-scan).
    13456               else
    13457                 delete buf_utd-lines-attr.
    13458            end.
    13459            else do:
    13460               if X_utd-lines.qnty-scan <> 0 then
    13461               do:
    13462                  create buf_utd-lines-attr.
    13463                  assign
    13464                     buf_utd-lines-attr.db-num     = X_utd-lines.db-num
    13465                     buf_utd-lines-attr.doc-id     = X_utd-lines.doc-id
    13466                     buf_utd-lines-attr.LineNum    = X_utd-lines.LineNum
    13467                     buf_utd-lines-attr.attr-code  = "QuantityBarCode"
    13468                     buf_utd-lines-attr.attr-value = string(X_utd-lines.qnty-scan) .
    13469                  .
    13470               end.
    13471            end.
    13472         end.
    13473         else
    13474         do:
    13475            if  not x_utd-lines.isMarking
    13476            then do:
    13477               if X_utd-lines.Quantity = X_utd-lines.qnty-scan
    13478               then X_utd-lines.stts = "Проверен" .
    13479               else X_utd-lines.stts = "Ожидает проверку" .
    13480            end.
    13481         end.
    13482         X_utd-lines.gds-name = GdsName(X_utd-lines.gds-code) .
    13483         X_utd-lines.taxRate_ = string(X_utd-lines.TaxRate) + " %" .
    13484         if X_utd-lines.TaxRate = -1 then X_utd-lines.taxRate_ = "Без НДС" .
    13485         if X_utd-lines.sts_err then X_utd-lines.stts = "Ошибка по строке" .
    13486      end.
    13487      for each X_utd-lines:
    13488         if not CAN-FIND (ub.utd-lines where ub.utd-lines.db-num = X_utd-lines.db-num and ub.utd-lines.doc-id = X_utd-lines.doc-id and ub.utd-lines.LineNum = X_utd-lines.LineNum) then
    13489            delete X_utd-lines .
    13490      end.
    13491   END PROCEDURE.
    13492   PROCEDURE calcQntyMarkByUnit :
    13493      define input  parameter iDbNum     as integer no-undo.
    13494      define input  parameter iDocId     as integer no-undo.
    13495      define input  parameter iLineNum   as integer no-undo.
    13496      define input  parameter iMark      as character no-undo.
    13497      define input  parameter iIsWeight  as logical no-undo.
    13498      define output parameter oQntyScan  as decimal no-undo.
    13499      define output parameter oIsErrMark as logical no-undo init false.
    13500      define variable vIsErrMark     as logical   no-undo .
    13501      define variable vQntyScan      as decimal   no-undo .
    13502      define buffer buf_marking           for ub.marking.
    13503      define buffer buf_utd-marking-lines for ub.utd-marking-lines .
    13504      for each buf_marking no-lock where
    13505               buf_marking.mark-parent begins iMark,
    13506          first buf_utd-marking-lines no-lock where
    13507                buf_utd-marking-lines.db-num  = iDbNum and
    13508                buf_utd-marking-lines.doc-id  = iDocId and
    13509                buf_utd-marking-lines.LineNum = iLineNum and
    13510                buf_utd-marking-lines.mark    = buf_marking.mark
    13511      :
    13512        if buf_marking.unit-ext = "UNIT" then
    13513        do:
    13514          if     can-do(Marking:EqualChecked,string(buf_utd-marking-lines.sts))
    13515          then do:
    13516            if iIsWeight
    13517            then do:
    13518               oQntyScan = oQntyScan + MarkWeight(buf_marking.mark).
    13519            end.
    13520            else oQntyScan = oQntyScan + buf_marking.box-qnty.
    13521          end.
    13522        end .
    13523        run calcQntyMarkByUnit in this-procedure(
    13524            iDbNum,
    13525            iDocId,
    13526            iLineNum,
    13527            buf_marking.mark,
    13528            iIsWeight,
    13529            output vQntyScan,
    13530            output vIsErrMark).
    13531        oQntyScan = oQntyScan + vQntyScan.
    13532        if vIsErrMark then oIsErrMark = vIsErrMark.
    13533      end.
    13534   END PROCEDURE.
    13535   PROCEDURE temp-mark :
    13536      define input parameter p-id as integer no-undo .
    13537      define buffer buf_marking for ub.marking .
    13538      define buffer buf_marking-attr for ub.marking-attr.
    13539      empty temp-table tt-marking-lines .
    13540      define variable mQuery as handle    no-undo.
    13541      define variable vqry   as character no-undo.
    13542      create query mQuery.
    13543      mQuery:set-buffers(buffer buf_utd-marking-lines:HANDLE).
    13544      vqry = substitute("for each buf_utd-marking-lines no-lock where ~
    13545                                  buf_utd-marking-lines.db-num = &1 ~
    13546                              and buf_utd-marking-lines.doc-id = &2 "
    13547                              ,  p-db-num, p-doc-id).
    13548      if p-id = 1
    13549      then
    13550         vqry = vqry + substitute (" and buf_utd-marking-lines.LineNum = &1",X_utd-lines.LineNum).
    13551       mQuery:query-prepare(vqry).
    13552       mQuery:query-open ().
    13553       mQuery:get-first ().
    13554       do while not mQuery:query-off-end:
    13555          create tt-marking-lines .
    13556          assign
    13557             tt-marking-lines.gds-name  = GdsName(buf_utd-marking-lines.gds-code)
    13558             tt-marking-lines.stts-utd  = StatusTHName(buf_utd-marking-lines.sts)
    13559             tt-marking-lines.mark      = buf_utd-marking-lines.mark
    13560             tt-marking-lines.gds-code  = buf_utd-marking-lines.gds-code
    13561             tt-marking-lines.sts-utd   = buf_utd-marking-lines.sts
    13562             tt-marking-lines.LineNum   = buf_utd-marking-lines.LineNum
    13563             tt-marking-lines.db-num    = buf_utd-marking-lines.db-num
    13564             tt-marking-lines.doc-id    = buf_utd-marking-lines.doc-id
    13565             tt-marking-lines.doc-level = buf_utd-marking-lines.doc-level
    13566             tt-marking-lines.site      = buf_utd-marking-lines.site
    13567          .
    13568          tt-marking-lines.isMark    = IsMark(tt-marking-lines.mark).
    13569          tt-marking-lines.isWeight = WeighedProd(tt-marking-lines.gds-code).
    13570          find first utd-marking-lines-attr where utd-marking-lines-attr.doc-id    eq buf_utd-marking-lines.doc-id
    13571                                              and utd-marking-lines-attr.db-num    eq buf_utd-marking-lines.db-num
    13572                                              and utd-marking-lines-attr.LineNum   eq buf_utd-marking-lines.LineNum
    13573                                              and utd-marking-lines-attr.mark      eq buf_utd-marking-lines.mark
    13574                                              and utd-marking-lines-attr.attr-code eq "box-qnty"
    13575          no-lock no-error.
    13576          if avail utd-marking-lines-attr
    13577          then
    13578             tt-marking-lines.box-qnty = dec(utd-marking-lines-attr.attr-value).
    13579          if tt-marking-lines.isMark then
    13580          do:
    13581             for first buf_marking  where buf_marking.mark begins buf_utd-marking-lines.mark :
    13582                assign
    13583                   tt-marking-lines.sts         = buf_marking.sts
    13584                   tt-marking-lines.unit        = buf_marking.unit
    13585                   tt-marking-lines.unit-ext    = buf_marking.unit-ext
    13586                   tt-marking-lines.box-qnty    = buf_marking.box-qnty  when tt-marking-lines.box-qnty eq 0 or tt-marking-lines.box-qnty eq ?
    13587                   tt-marking-lines.mark-parent = buf_marking.mark-parent
    13588                .
    13589                tt-marking-lines.stts        = StatusTHName(buf_marking.sts).
    13590                tt-marking-lines.weight = if tt-marking-lines.isWeight then string(MarkWeight(buf_marking.mark)) else "".
    13591             end.
    13592          end.
    13593          else
    13594          do:
    13595             tt-marking-lines.stts-utd = StatusTHName(Marking:Checked_:KeyIntDB) .
    13596          end.
    13597         mQuery:get-next ().
    13598      end.
    13599      delete object mQuery.
    13600   END PROCEDURE.
    13601   PROCEDURE check_mol :
    13602      define output parameter p-ok as logical no-undo .
    13603      define variable varchk-prs      as character no-undo .
    13604      define variable varchk-prs-type as character no-undo .
    13605   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    13606     (input  'chk-prs'
    13607     ,input  ''
    13608     ,input  ''
    13609     ,input  0
    13610     ,input  ''
    13611     ,input  ''
    13612     ,input  ''
    13613     ,input  no
    13614     ,output varchk-prs
    13615     ,output varchk-prs-type
    13616     ) no-error .
    13617      if varchk-prs <> "no" then
    13618      do:
    13619         if f-agnt = 0 or f-agnt = ? then
    13620         do:
    13621            message "Не указан исполнитель " f-agnt view-as alert-box error.
    13622            p-ok = false .
    13623            return.
    13624         end.
    13625         if f-boss = 0 or f-boss = ? then
    13626         do:
    13627            message "Не указан менеджер " f-boss view-as alert-box error.
    13628            p-ok = false .
    13629            return.
    13630         end.
    13631         if f-wrkr = 0 or f-wrkr = ? then
    13632         do:
    13633            message "Не указан кладовщик " f-wrkr view-as alert-box error.
    13634            p-ok = false .
    13635            return.
    13636         end.
    13637         p-ok = true .
    13638      end.
    13639      else p-ok = true .
    13640   END PROCEDURE.
    13641   PROCEDURE save_mark :
    13642      define variable v_list    as character no-undo .
    13643      define variable ii        as integer   no-undo .
    13644      define variable jj        as integer   no-undo .
    13645      define variable v-marking as character no-undo .
    13646      define buffer buf_parts                   for ub.parts .
    13647      define buffer gray_marking                for ub.marking .
    13648      define buffer bf_marking                  for ub.marking .
    13649      define buffer gray_unit-marking           for ub.marking .
    13650      define buffer gray_utd-marking-lines      for ub.utd-marking-lines .
    13651      define buffer gray_unit_utd-marking-lines for ub.utd-marking-lines .
    13652      define buffer buf_utd-lines-attr          for ub.utd-lines-attr .
    13653      define buffer un_utd-marking-lines        for ub.utd-marking-lines .
    13654      define buffer parent_marking              for ub.marking .
    13655      define buffer parent_utd-marking-lines    for ub.utd-marking-lines .
    13656      define buffer buf_goods-attr              for ub.goods-attr.
    13657      define buffer buf_marking-attr            for ub.marking-attr.
    13658      define VARIABLE v-qnty       as decimal   no-undo .
    13659      define VARIABLE v-rowid      as rowid     no-undo .
    13660      define VARIABLE v-tbl-name   as character no-undo .
    13661      define variable v-ungroup_ok as logical   no-undo .
    13662      define variable v-gds-code   as integer   no-undo.
    13663      define variable vFlag        as logical   no-undo.
    13664      define variable v-gds-fl-wt  as logical   no-undo.
    13665      b_cleaggds:sensitive in frame d-utd = no.
    13666      b_cleaggds:visible   in frame d-utd = no.
    13667      m-gds-code:visible   in frame d-utd = no.
    13668      F-text = "" .
    13669      f-text:screen-value in frame d-utd = "" .
    13670      v-GTIN = "" .
    13671      m-gds-code = ? .
    13672      ASSIGN
    13673         v_list = 'Ё,Й,Ц,У,К,Е,Н,Г,Ш,Щ,З,Х,Ъ,Ф,Ы,В,А,П,Р,О,Л,Д,Ж,Э,Я,Ч,С,М,И,Т,Ь,Б,Ю':U .
    13674      do ii = 1 to length (v-mark):
    13675         if LOOKUP( SUBSTRING( v-mark, ii, 1 ), v_list )  > 1 then
    13676         do:
    13677            message "Не корректно считана акцизная марка, перед считыванием переключите клавиатуру на английскую раскладку."
    13678               view-as alert-box.
    13679            v-mark:screen-value in frame d-utd = "" .
    13680            v-mark = "" .
    13681            return no-apply.
    13682         end.
    13683      end.
    13684      mMRCCode  = no.
    13685      v-marking = GetCodeIdent(v-mark) .
    13686     if v-mark <> v-marking then
    13687     do:
    13688       find first bf_marking exclusive-lock where bf_marking.mark begins v-marking no-error .
    13689       if avail bf_marking and
    13690          bf_marking.unit-ext = "LEVEL2" then
    13691       do:
    13692         v-marking = v-mark.
    13693       end.
    13694     end.
    13695      if v-marking = "" or v-marking = ? then
    13696      do:
    13697         F-text = "Товар не найден. Если сканируете КМ транспортной или груп. упак., то просканировать КМ потребительской упак., или верните товар поставщику." .
    13698         display F-text with frame d-utd.
    13699         v-mark:screen-value = "" .
    13700         v-mark = "" .
    13701         return no-apply.
    13702      end.
    13703      if p-type = objSrv:Env:Utd:EDocType:UTD:KeyIntDB then
    13704      do:
    13705         find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark begins v-marking and buf_utd-marking-lines.db-num = p-db-num
    13706            and buf_utd-marking-lines.doc-id = buf_utd.doc-id no-error .
    13707         if available (buf_utd-marking-lines) then
    13708         do:
    13709            run checkEMRC(v-mark, output vFlag).
    13710            if not vFlag
    13711            then do:
    13712               F-text = "МРЦ на упаковке меньше ЕМЦ. Приемка товара запрещена." .
    13713               display F-text with frame d-utd.
    13714               v-mark:screen-value = "" .
    13715               v-mark = "" .
    13716               return no-apply.
    13717            end.
    13718            if CheckErrForMarkLine(buffer buf_utd-marking-lines:handle)
    13719            then do:
    13720               F-text = "Товар не подлежит приемке, т.к. не прошел проверку на корректность" .
    13721                  display F-text with frame d-utd.
    13722                  v-mark:screen-value = "" .
    13723                  v-mark = "" .
    13724                  return no-apply.
    13725            end.
    13726            for first buf_marking no-lock where
    13727                      buf_marking.mark = buf_utd-marking-lines.mark and buf_marking.sts = Marking:Ungrouped:KeyIntDB
    13728            :
    13729               if isSaleMarkInUpak(buf_marking.mark) then
    13730                 F-text = "Марка уже проверена, просканируйте другую.".
    13731               else
    13732                 F-text = substitute(
    13733                   "&1 упаковка разгруппирована, просканируйте марку &2 упаковки.",
    13734                   if buf_marking.unit-ext = "LEVEL1" then "Групповая" else "Транспортная",
    13735                   if buf_marking.unit-ext = "LEVEL1" then "потребительской" else "групповой").
    13736               display F-text with frame d-utd.
    13737               v-mark:screen-value = "" .
    13738               v-mark = "" .
    13739               return no-apply.
    13740            end.
    13741            find first X_utd-lines exclusive-lock where X_utd-lines.LineNum = buf_utd-marking-lines.LineNum no-error .
    13742            if available (X_utd-lines) then
    13743            do:
    13744               if X_utd-lines.sts_err then
    13745               do:
    13746                  F-text = "Товар не подлежит приемке, т.к. не прошел проверку на корректность" .
    13747                  display F-text with frame d-utd.
    13748                  v-mark:screen-value = "" .
    13749                  v-mark = "" .
    13750                  return no-apply.
    13751               end.
    13752               if can-do(Marking:EqualChecked,string(buf_utd-marking-lines.sts)) then
    13753               do:
    13754                  F-text = "Марка уже проверена, просканируйте следующую" .
    13755                  display F-text with frame d-utd.
    13756                  v-mark:screen-value = "" .
    13757                  v-mark = "" .
    13758                  return no-apply.
    13759               end.
    13760               else
    13761               do:
    13762                  if can-find (buf_marking where buf_marking.mark = buf_utd-marking-lines.mark and buf_marking.sts = Marking:MarkError:KeyIntDB)
    13763                     then
    13764                  do:
    13765                     F-text = "Товар не подлежит приемке, т.к. не прошел проверку на корректность" .
    13766                     display F-text with frame d-utd.
    13767                     v-mark:screen-value = "" .
    13768                     v-mark = "" .
    13769                     return no-apply.
    13770                  end.
    13771                  if can-find (buf_marking where buf_marking.mark = buf_utd-marking-lines.mark and buf_marking.sts = Marking:GrayZone:KeyIntDB)
    13772                     then
    13773                  do:
    13774                     empty temp-table tt-marking-lines .
    13775                     for first gray_utd-marking-lines no-lock where gray_utd-marking-lines.db-num = X_utd-lines.db-num and gray_utd-marking-lines.doc-id = X_utd-lines.doc-id
    13776                        and gray_utd-marking-lines.LineNum = X_utd-lines.LineNum and gray_utd-marking-lines.mark = buf_utd-marking-lines.mark:
    13777                        for first gray_marking no-lock where gray_marking.mark = buf_utd-marking-lines.mark :
    13778                           create tt-marking-lines .
    13779                           assign
    13780                              tt-marking-lines.gds-name    = GdsName(gray_utd-marking-lines.gds-code)
    13781                              tt-marking-lines.stts-utd    = StatusTHName(gray_utd-marking-lines.sts)
    13782                              tt-marking-lines.stts        = StatusTHName(gray_marking.sts)
    13783                              tt-marking-lines.mark        = gray_marking.mark
    13784                              tt-marking-lines.mark-parent = gray_marking.mark-parent
    13785                              tt-marking-lines.gds-code    = gray_utd-marking-lines.gds-code
    13786                              tt-marking-lines.sts         = gray_marking.sts
    13787                              tt-marking-lines.sts-utd     = gray_utd-marking-lines.sts
    13788                              tt-marking-lines.unit        = gray_marking.unit
    13789                              tt-marking-lines.box-qnty    = gray_marking.box-qnty
    13790                              tt-marking-lines.LineNum     = gray_utd-marking-lines.LineNum
    13791                              tt-marking-lines.db-num      = gray_utd-marking-lines.db-num
    13792                              tt-marking-lines.doc-id      = gray_utd-marking-lines.doc-id
    13793                              tt-marking-lines.doc-level   = gray_utd-marking-lines.doc-level
    13794                              .
    13795                        end.
    13796                        for each gray_unit-marking no-lock where gray_unit-marking.mark-parent = gray_utd-marking-lines.mark:
    13797                           for first gray_unit_utd-marking-lines no-lock where gray_unit_utd-marking-lines.db-num = X_utd-lines.db-num and gray_unit_utd-marking-lines.doc-id = X_utd-lines.doc-id
    13798                              and gray_unit_utd-marking-lines.LineNum = X_utd-lines.LineNum and gray_unit_utd-marking-lines.mark = gray_unit-marking.mark:
    13799                              create tt-marking-lines .
    13800                              assign
    13801                                 tt-marking-lines.gds-name    = GdsName(gray_unit_utd-marking-lines.gds-code)
    13802                                 tt-marking-lines.stts-utd    = StatusTHName(gray_unit_utd-marking-lines.sts)
    13803                                 tt-marking-lines.stts        = StatusTHName(gray_unit-marking.sts)
    13804                                 tt-marking-lines.mark        = gray_unit-marking.mark
    13805                                 tt-marking-lines.mark-parent = gray_unit-marking.mark-parent
    13806                                 tt-marking-lines.gds-code    = gray_unit_utd-marking-lines.gds-code
    13807                                 tt-marking-lines.sts         = gray_unit-marking.sts
    13808                                 tt-marking-lines.sts-utd     = gray_unit_utd-marking-lines.sts
    13809                                 tt-marking-lines.unit        = gray_unit-marking.unit
    13810                                 tt-marking-lines.unit-ext    = gray_unit-marking.unit-ext
    13811                                 tt-marking-lines.box-qnty    = gray_unit-marking.box-qnty
    13812                                 tt-marking-lines.LineNum     = gray_unit_utd-marking-lines.LineNum
    13813                                 tt-marking-lines.db-num      = gray_unit_utd-marking-lines.db-num
    13814                                 tt-marking-lines.doc-id      = gray_unit_utd-marking-lines.doc-id
    13815                                 tt-marking-lines.doc-level   = gray_unit_utd-marking-lines.doc-level
    13816                                 .
    13817                           end.
    13818                        end.
    13819                     end.
    13820                     run str/mark_browse.w (input parparentproc,
    13821                        input-output table tt-marking-lines by-reference,
    13822                        input p-mode,
    13823                        input "Марки по товару " + string(X_utd-lines.gds-code) + " " + GdsName(X_utd-lines.gds-code) + " со статусом: " + StatusTHName(Marking:GrayZone:KeyIntDB),
    13824                        input 6,
    13825                        input ""
    13826                        ) no-error .
    13827   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13828   do:
    13829     br-utd :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
    13830   end.
    13831                  end.
    13832                  else
    13833                  do:
    13834                     if buf_utd-marking-lines.doc-level > 1 then
    13835                     do:
    13836                           find first ub.marking where ub.marking.mark = buf_utd-marking-lines.mark no-lock no-error.
    13837                           if avail ub.marking and ub.marking.mark-parent <> "" then
    13838                             find first parent_marking no-lock where
    13839                                        parent_marking.mark = ub.marking.mark-parent no-error.
    13840                           if not avail parent_marking or parent_marking.sts <> Marking:Ungrouped:KeyIntDB
    13841                           then do:
    13842                             F-text = "            Марка входит в состав упаковки, просканируйте марку упаковки" .
    13843                             display F-text with frame d-utd.
    13844                             v-mark:screen-value = "" .
    13845                             v-mark = "" .
    13846                             return no-apply.
    13847                           end.
    13848                     end.
    13849                        if X_utd-lines.isMarking
    13850                        then do:
    13851                           define variable vCheck as logical no-undo init yes.
    13852                           do:
    13853                              for first bf_utd-marking-lines exclusive-lock where bf_utd-marking-lines.mark = buf_utd-marking-lines.mark and bf_utd-marking-lines.db-num = buf_utd-marking-lines.db-num and
