      317   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      318   procedure cur-time :
      319      define output parameter p-today as date      no-undo .
      320      define output parameter p-time  as integer   no-undo .
      321     do
      322     on error undo, return error
      323     :
      324       define variable v-date1 as date      no-undo .
      325       define variable v-date2 as date      no-undo .
      326       define variable v-time  as integer   no-undo .
      327       assign
      328         v-date1 = today
      329         v-time  = time
      330         v-date2 = today
      331       .
      332       if v-date1 <> v-date2
      333       then do:
      334         assign
      335           v-date1 = today
      336           v-time  = v-time
      337         .
      338       end.
      339       assign
      340         p-today = v-date1
      341         p-time  = v-time
      342       .
      343     end.
      344   end.
      345   function cur-time-date returns character
      346   :
      347     return string(today, '99/99/9999':U) .
      348   end.
      349   function cur-time-mjd returns decimal
      350   :
      351     define variable v-date as date      no-undo .
      352     define variable v-time as integer   no-undo .
      353     run cur-time in this-procedure
      354       (output v-date
      355       ,output v-time
      356       ) .
      357     return integer(v-date) - 2400002 + (v-time / 86400) .
      358   end.
      359   function cur-time-get-ending-index returns integer
      360   (input p-number as integer
      361   )
      362   :
      363     if p-number < 0
      364     or p-number = ?
      365     then do:
      366       return 1 .
      367     end.
      368     define variable v-rest as integer   no-undo .
      369     assign
      370       p-number = p-number modulo 100
      371     .
      372     if p-number < 20
      373     then do:
      374       assign
      375         v-rest = p-number
      376       .
      377     end.
      378     else do:
      379       assign
      380         v-rest = p-number modulo 10
      381       .
      382     end.
      383     case v-rest :
      384       when 1
      385       then do:
      386         return 2 .
      387       end.
      388       when 2 or
      389       when 3 or
      390       when 4
      391       then do:
      392         return 3 .
      393       end.
      394       otherwise do:
      395         return 1 .
      396       end.
      397     end case .
      398   end.
      399   procedure cur-time-mjd-to-date :
      400      define input  parameter i-mjd-diff as decimal no-undo.
      401      define output parameter o-Date     as date    no-undo.
      402      define output parameter o-Time     as integer no-undo.
      403      define variable v-day-number as integer   no-undo .
      404      if    i-mjd-diff < 0
      405         or i-mjd-diff = ?
      406      then do:
      407         return "?" .
      408      end.
      409      assign
      410         v-day-number = truncate(i-mjd-diff,0).
      411         o-Date = date(v-day-number + 2400002).
      412         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      413     .
      414   end.
      415   function cur-time-mjd-to-string returns character
      416   (input p-mjd-diff as decimal
      417   )
      418   :
      419     define variable v-day-number as integer   no-undo .
      420     define variable v-seconds    as integer   no-undo .
      421     define variable v-hour       as integer   no-undo .
      422     define variable v-min        as integer   no-undo .
      423     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      424     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      425     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      426     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      427     if p-mjd-diff < 0
      428     or p-mjd-diff = ?
      429     then do:
      430       return "?" .
      431     end.
      432     assign
      433       v-day-number = integer(truncate(p-mjd-diff,0))
      434       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      435     .
      436     if v-seconds > 86400
      437     then do:
      438       assign
      439         v-seconds = 86400 - 1
      440       .
      441     end.
      442     if v-seconds < 0
      443     then do:
      444       assign
      445         v-seconds = 0
      446       .
      447     end.
      448     assign
      449       v-hour = truncate(v-seconds / 3600, 0)
      450     .
      451     assign
      452       v-seconds = v-seconds modulo 3600
      453     .
      454     assign
      455       v-min = truncate(v-seconds / 60, 0)
      456     .
      457     assign
      458       v-seconds = v-seconds modulo 60
      459     .
      460     return
      461         (if v-day-number <> 0
      462           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      463           else ""
      464         )
      465       + (if v-day-number <> 0 or v-hour <> 0
      466           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      467           else ""
      468         )
      469       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      470           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      471           else ""
      472         )
      473       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      474       .
      475   end.
      476   function cur-time-string returns character
      477   :
      478     define variable v-date as date      no-undo .
      479     define variable v-time as integer   no-undo .
      480     run cur-time in this-procedure
      481       (output v-date
      482       ,output v-time
      483       ) .
      484     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      485   end.
      486   function cur-time-string-sec returns character
      487   :
      488     define variable v-date as date      no-undo .
      489     define variable v-time as integer   no-undo .
      490     run cur-time in this-procedure
      491       (output v-date
      492       ,output v-time
      493       ) .
      494     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      495   end.
      496   function cur-time-custom  returns character
      497   (input p-prefix as character
      498   ,input p-date-format as character
      499   ,input p-delimiter as character
      500   ,input p-time-format as character
      501   ,input p-suffix as character
      502   )
      503   :
      504     define variable v-date as date      no-undo .
      505     define variable v-time as integer   no-undo .
      506     run cur-time in this-procedure
      507       (output v-date
      508       ,output v-time
      509       ) .
      510     return
      511       p-prefix
      512       + string(v-date, p-date-format)
      513       + p-delimiter
      514       + string(v-time, p-time-format)
      515       + p-suffix
      516       .
      517   end.
      518   function cur-time-print  returns character
      519   :
      520     define variable v-date as date      no-undo .
      521     define variable v-time as integer   no-undo .
      522     run cur-time in this-procedure
      523       (output v-date
      524       ,output v-time
      525       ) .
      526     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      527   end.
      528   function cur-time-datetime returns datetime
      529   :
      530     define variable v-char as character no-undo .
      531     define variable v-datetime as datetime no-undo .
      532     v-char = cur-time-string().
      533     v-datetime = datetime(v-char).
      534     return  v-datetime.
      535   end.
      536   function cur-time-string-msec returns character
      537   :
      538     define variable v-date as datetime  no-undo .
      539     v-date = now.
      540     return string(v-date) .
      541   end.
