     9756   ON CHOOSE OF b_finish IN FRAME d-utd
     9757      DO:
     9758         define variable Log-Res  as logical no-undo.
     9759         define variable quest-ok as logical no-undo .
     9760   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9761   do:
     9762     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9763       (input  v-cntxt-db-num
     9764       ,input  v-cntxt-userid
     9765       ,input  0
     9766       ,input  'actn_mark_befree':U
     9767       ,input  'firm':U
     9768       ,input  v-cntxt-host-code-obj
     9769       ,input  '':U
     9770       ,input  0
     9771       ,input  0
     9772       ,input  0
     9773       ,input  0
     9774       ,input  true
     9775       ,output log-res
     9776       )  .
     9777   end.
     9778         if available (buf_utd) and log-res then
     9779         do:
     9780            message "Уверены, что продажи по продукции закрыты?"
     9781                  view-as alert-box question buttons yes-no update quest-ok.
     9782            if quest-ok then
     9783            do:
     9784               run utl/utd-mark-introduce.p (input buf_utd.db-num, input buf_utd.doc-id) no-error.
     9785               if  error-status:error then
     9786               do:
     9787                  return return-value .
     9788               end.
     9789               assign
     9790                  c-status     = buf_utd.sts
     9791                  c-status-edi = buf_utd.sts-edi
     9792                  .
     9793            end.
     9794         end.
