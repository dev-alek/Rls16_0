     9006   FUNCTION StatusTHName RETURNS CHARACTER
     9007      (input p-stsTH as integer)  .
     9008      Return Marking:GetLabel(p-stsTH) .
     9009   END FUNCTION .
     9010   FUNCTION EdoTypeName RETURNS CHARACTER
     9011      (input p-stsTH as integer)  .
