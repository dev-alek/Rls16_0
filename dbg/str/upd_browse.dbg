      983   FUNCTION mark-string RETURNS CHARACTER
      984     ( input p-recid as recid, input mark-list as character  ) :
      985     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      986   END FUNCTION.
