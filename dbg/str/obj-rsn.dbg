      762   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      763   on F1 of frame fr-D-obj-rsn anywhere do:
      764     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-obj-rsn. END.
      765     return no-apply.
      766   end.
      767   if valid-handle( active-window ) and frame fr-D-obj-rsn :parent = ? then frame fr-D-obj-rsn :parent = active-window.
      768   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      769   on window-close of frame fr-D-obj-rsn do: apply "END-ERROR":U to self. end.
      770   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      771   on help of frame fr-D-obj-rsn
      772   do:
      773     run gbl/app_help.p
      774       (input this-procedure :file-name
      775       ,input ''
      776       ,input ?
      777       ) no-error.
      778     if error-status :error then do:
      779       message
      780         "Ошибка при вызове помощи"
      781         error-status :get-message(1)
      782         view-as alert-box .
      783     end.
      784   end.
      785   run minbtn-set in this-procedure .
      786   on choose of b-help in frame fr-D-obj-rsn
      787   do:
      788     apply "help":u to frame fr-D-obj-rsn .
      789   end.
      790   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      791   procedure minbtn-set :
      792       do
      793           on error undo, return error return-value
      794           :
      795           define variable ii              as integer       no-undo .
      796           define variable fh              as widget-handle no-undo .
      797           define variable hh              as widget-handle no-undo .
      798           define variable v-h             as handle        extent 4 no-undo .
      799           define variable v-name-button   as character     no-undo .
      800           define variable v-help-old-x    as decimal       no-undo .
      801           define variable v-help-old-y    as decimal       no-undo .
      802           define variable v-help-old-size as decimal       no-undo .
      803           define variable v-frame-width   as decimal       no-undo .
      804           define variable jj              as integer       no-undo .
      805           do
      806               on error undo, return error
      807               :
      808               assign
      809                   v-frame-width = frame fr-D-obj-rsn:width - 0.3
      810                   fh            = frame fr-D-obj-rsn:first-child
      811                   hh            = fh:first-child
      812                   ii            = 1
      813                   .
      814               do while valid-handle(hh):
      815                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      816                   do:
      817                       case lc(hh:name) :
      818                           when "b-help" then
      819                               do:
      820                                   hh:load-image-up("cmp/b-help.bmp":u) .
      821                                   hh:load-image-down("cmp/b-help.bmp":u) .
      822                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      823                                   hh:TOOLTIP = "Помощь" .
      824                                   v-help-old-x = hh:column .
      825                                   v-help-old-y = hh:row    .
      826                                   v-help-old-size = hh:width .
      827                                   hh:width-chars = 2.5 .
      828                               end.
      829                           when "b-print" then
      830                               do:
      831                                   hh:load-image("cmp/b-print.bmp":u) .
      832                                   hh:TOOLTIP = "Печать" .
      833                                   v-h[ii] = hh:handle .
      834                                   ii = ii + 1 .
      835                                   hh:width-chars = 3 .
      836                               end.
      837                           when "b-history" or
      838                           when "b-hist" then
      839                               do:
      840                                   hh:load-image("cmp/b-hist.bmp":u) .
      841                                   hh:TOOLTIP = "История" .
      842                                   v-h[ii] = hh:handle .
      843                                   ii = ii + 1 .
      844                                   hh:width-chars = 3 .
      845                               end.
      846                           when "b-sch" then
      847                               do:
      848                                   hh:load-image("cmp/b-sch.bmp":u) .
      849                                   hh:TOOLTIP = "Установка Фильтра" .
      850                                   v-h[ii] = hh:handle .
      851                                   ii = ii + 1 .
      852                                   hh:width-chars = 3 .
      853                               end.
      854                           when "b-hist-user" then
      855                               do:
      856                                   hh:load-image("cmp/b-hist.bmp":u) .
      857                                   hh:TOOLTIP = "История пользователя" .
      858                                   ii = ii + 1 .
      859                               end.
      860                       end case.
      861                   end.
      862                   hh = hh:next-sibling.
      863               end.
      864               b-help:column = v-frame-width - b-help:width-chars.
      865               jj = 0.
      866               repeat ii = 4 to 1 by -1 :
      867                   if valid-handle (v-h[ii] ) then
      868                   do:
      869                       jj  = jj + 1 .
      870                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      871                       v-h[ii]:row    = v-help-old-y .
      872                   end.
      873               end.
      874           end.
      875       end.
      876   end procedure.
      877   Main-Block:
      878   do on error   undo Main-Block, leave Main-Block
      879      on end-key undo Main-Block, leave Main-Block :
      880     j_host-code = v-cntxt-host-code-obj .
      881   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      882   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      883     (input  p-obj-type
      884     ,input  p-obj-code
      885     ,output p-host-code
      886     )  .
      887     if j_host-code <> p-host-code then do:
      888       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      889               "У вас нет прав для изменения настроек на объекте, принадлежащем другой фирме." skip( 0 )
      890               "Текущий объект:" p-obj-type p-obj-code skip( 0 )
      891               "Фирма объекта:"  p-host-code skip( 0 )
      892               "Текущая фирма:"  j_host-code "."
      893       view-as alert-box error.
      894       undo Main-Block, leave Main-Block.
      895     end.
      896     run Init-Vars in this-procedure.
      897     run UI-On     in this-procedure.
      898     wait-for go of frame fr-D-obj-rsn.
      899   end.
      900   hide frame fr-D-obj-rsn no-pause.
