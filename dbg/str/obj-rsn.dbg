     1117         assign
     1118                ub.trn-reason-obj.obj-type     = p-obj-type
     1119                ub.trn-reason-obj.obj-code     = p-obj-code
     1120                ub.trn-reason-obj.ext-doc-type = 'ie':U
     1121                ub.trn-reason-obj.hold-doc     = no
     1122         .
     1123       end.
     1124       assign ub.trn-reason-obj.reason-code = rsn-ie.
     1125     end.
     1126     else do:
     1127       if available ub.trn-reason-obj
     1128        and rsn-ie = ? then do:
     1129          delete ub.trn-reason-obj .
     1130        end.
     1131     end.
