      244   with view-as dialog-box side-labels no-underline three-d scrollable
      245        title "":U default-button b-Exit cancel-button b-Exit.
      246   assign frame fr-D-obj-rsn :scrollable = no.
      247   on choose of b-OK in frame fr-D-obj-rsn do:
      248   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      249   if lookup(self :type
      250            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      251            ) = 0
      252   then do:
      253     message
      254       "$Workfile$"
      255       "Указанному интерфейсному элементу фокус не может быть передан" skip
      256       "Интерфейсный элемент" self :name  skip
      257       "Тип" self :type  skip
      258       "Процедура" this-procedure :file-name skip
      259       view-as alert-box .
      260   end.
      261   else do:
      262     apply "entry":u to self  .
      263     if focus :handle <> self :handle  then do:
      264       return no-apply .
      265     end.
      266   end.
      267     run Save-Vars in this-procedure.
      268     apply "GO":U to frame fr-D-obj-rsn.
      269   end.
      270   on choose of b-Exit in frame fr-D-obj-rsn do:
      271   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      272   if lookup(self :type
      273            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
