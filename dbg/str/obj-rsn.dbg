     1719             recid( ub.trn-reason-obj ) = ref-rec.
     1720       end.
     1721       else do:
     1722         create ub.trn-reason-obj.
     1723         assign
     1724                ub.trn-reason-obj.obj-type     = p-obj-type
     1725                ub.trn-reason-obj.obj-code     = p-obj-code
     1726                ub.trn-reason-obj.ext-doc-type = 'ee':U
     1727                ub.trn-reason-obj.hold-doc     = yes
     1728         .
     1729       end.
     1730       assign ub.trn-reason-obj.reason-code = rsn-eeh.
     1731     end.
     1732     else do:
     1733       if available ub.trn-reason-obj
     1734        and rsn-eeh = ? then do:
     1735          delete ub.trn-reason-obj .
     1736        end.
     1737     end.
     1738     find first ub.trn-reason no-lock where
     1739                ub.trn-reason.reason-code = rsn-eph no-error.
     1740       find first ub.trn-reason-obj exclusive-lock where
     1741                  ub.trn-reason-obj.obj-type     = p-obj-type  and
     1742                  ub.trn-reason-obj.obj-code     = p-obj-code  and
     1743                  ub.trn-reason-obj.ext-doc-type = 'ep':U      and
     1744                  ub.trn-reason-obj.hold-doc     = yes
     1745                  no-error.
     1746     if available ub.trn-reason then do:
     1747       if available ub.trn-reason-obj then do:
     1748         assign ref-rec = recid( ub.trn-reason-obj ).
     1749         find first ub.trn-reason-obj exclusive-lock where
     1750             recid( ub.trn-reason-obj ) = ref-rec.
     1751       end.
     1752       else do:
     1753         create ub.trn-reason-obj.
     1754         assign
     1755                ub.trn-reason-obj.obj-type     = p-obj-type
     1756                ub.trn-reason-obj.obj-code     = p-obj-code
     1757                ub.trn-reason-obj.ext-doc-type = 'ep':U
     1758                ub.trn-reason-obj.hold-doc     = yes
     1759         .
     1760       end.
     1761       assign ub.trn-reason-obj.reason-code = rsn-eph.
     1762     end.
     1763     else do:
     1764       if available ub.trn-reason-obj
     1765        and rsn-eph = ? then do:
     1766          delete ub.trn-reason-obj .
     1767        end.
     1768     end.
     1769     find first ub.trn-reason no-lock where
     1770                ub.trn-reason.reason-code = rsn-reh no-error.
     1771       find first ub.trn-reason-obj exclusive-lock where
     1772                  ub.trn-reason-obj.obj-type     = p-obj-type  and
     1773                  ub.trn-reason-obj.obj-code     = p-obj-code  and
     1774                  ub.trn-reason-obj.ext-doc-type = 're':U      and
     1775                  ub.trn-reason-obj.hold-doc     = yes
     1776                  no-error.
     1777     if available ub.trn-reason then do:
     1778       if available ub.trn-reason-obj then do:
     1779         assign ref-rec = recid( ub.trn-reason-obj ).
     1780         find first ub.trn-reason-obj exclusive-lock where
     1781             recid( ub.trn-reason-obj ) = ref-rec.
     1782       end.
     1783       else do:
     1784         create ub.trn-reason-obj.
     1785         assign
     1786                ub.trn-reason-obj.obj-type     = p-obj-type
     1787                ub.trn-reason-obj.obj-code     = p-obj-code
     1788                ub.trn-reason-obj.ext-doc-type = 're':U
     1789                ub.trn-reason-obj.hold-doc     = yes
     1790         .
     1791       end.
     1792       assign ub.trn-reason-obj.reason-code = rsn-reh.
     1793     end.
     1794     else do:
     1795       if available ub.trn-reason-obj
     1796        and rsn-reh = ? then do:
     1797          delete ub.trn-reason-obj .
     1798        end.
     1799     end.
     1800   end procedure.
     1801     procedure Apply-Next :
     1802       define input parameter p-name as character no-undo.
     1803       case p-name :
     1804         when      'ie':U          then do: apply "ENTRY":U  to rsn-ee          in frame fr-D-obj-rsn. end.
     1805         when      'ee':U          then do: apply "ENTRY":U  to rsn-ep       in frame fr-D-obj-rsn. end.
     1806         when      'ep':U       then do: apply "ENTRY":U  to rsn-es     in frame fr-D-obj-rsn. end.
     1807         when      'es':U     then do: apply "ENTRY":U  to rsn-re      in frame fr-D-obj-rsn. end.
     1808         when      're':U      then do: apply "ENTRY":U  to rsn-rs in frame fr-D-obj-rsn. end.
     1809         when      'rs':U then do: apply "ENTRY":U  to rsn-we          in frame fr-D-obj-rsn. end.
     1810         when      'we':U          then do: apply "ENTRY":U  to rsn-vt                in frame fr-D-obj-rsn. end.
     1811         when      'vt':U                then do: apply "ENTRY":U  to rsn-vp           in frame fr-D-obj-rsn. end.
     1812         when      'vp':U           then do: apply "ENTRY":U  to rsn-iv          in frame fr-D-obj-rsn. end.
     1813         when      'iv':U          then do: apply "ENTRY":U  to rsn-ev          in frame fr-D-obj-rsn. end.
     1814         when      'ev':U          then do: apply "ENTRY":U  to rsn-rv      in frame fr-D-obj-rsn. end.
     1815         when      'rv':U      then do: apply "ENTRY":U  to rsn-em           in frame fr-D-obj-rsn. end.
     1816         when      'em':U           then do: apply "ENTRY":U  to rsn-wm           in frame fr-D-obj-rsn. end.
     1817         when      'wm':U           then do: apply "ENTRY":U  to rsn-im           in frame fr-D-obj-rsn. end.
     1818         when      'im':U           then do: apply "ENTRY":U  to rsn-ap           in frame fr-D-obj-rsn. end.
     1819         when      'ap':U     then do: apply "ENTRY":U  to rsn-pc     in frame fr-D-obj-rsn. end.
     1820         when      'pc':U     then do: apply "ENTRY":U  to rsn-mp   in frame fr-D-obj-rsn. end.
     1821         when      'mp':U   then do: apply "ENTRY":U  to rsn-ieh         in frame fr-D-obj-rsn. end.
     1822         when 'ieh':U      then do: apply "ENTRY":U  to rsn-eeh         in frame fr-D-obj-rsn. end.
     1823         when 'eeh':U      then do: apply "ENTRY":U  to rsn-eph      in frame fr-D-obj-rsn. end.
     1824         when 'eph':U   then do: apply "ENTRY":U  to rsn-reh     in frame fr-D-obj-rsn. end.
     1825         when 'reh':U  then do: apply "CHOOSE":U to b-OK                              in frame fr-D-obj-rsn. end.
     1826       end case.
     1827     end procedure.
