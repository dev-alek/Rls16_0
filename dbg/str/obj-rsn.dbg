      322     on choose of b-ie in frame fr-D-obj-rsn do:
      323       assign j_rsn-code = ( input frame fr-D-obj-rsn rsn-ie ).
      324       run str/trn-reas.w ( input parparentproc
      325                          , input 'выбор':U
      326                          , input-output j_rsn-code
      327                          ) .
      328       find first ub.trn-reason no-lock where
      329                  ub.trn-reason.reason-code = j_rsn-code no-error.
      330       if available ub.trn-reason then do:
      331         assign  rsn-ie = j_rsn-code.
      332         display rsn-ie with frame fr-D-obj-rsn.
      333       end.
      334     end.
      335     on return of rsn-ie in frame fr-D-obj-rsn do:
      336       find first ub.trn-reason no-lock where
      337                  ub.trn-reason.reason-code = ( input frame fr-D-obj-rsn rsn-ie ) no-error.
      338       if available ub.trn-reason then do: assign rsn-ie. end.
      339       run Apply-Next in this-procedure ( input "ie" ).
      340       return no-apply.
      341     end.
