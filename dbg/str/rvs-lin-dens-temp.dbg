        1   define shared temp-table tt-dens-temp no-undo
        2     field ii as integer
        3     field key_ as character
        4     field density as decimal format "9.9999999999"
        5     field temperature as decimal format "->>>9.<<"
        6     index pi
        7       as primary unique
        8       ii
        9   .
       10   define input parameter parparentproc as handle no-undo .
       11   define input parameter p-sr-izm-type as integer no-undo .
       12   define input parameter p-place-type as integer no-undo .
       13   define input parameter p-diameter   as decimal no-undo .
       14   define input parameter p-fuel-level as decimal no-undo .
       15   define input-output parameter p-mi-tmp-dnst as integer no-undo .
       16   define output parameter p-avg-density as decimal no-undo .
       17   define output parameter p-avg-temperature as decimal no-undo .
       18   define output parameter p-ok as logical no-undo .
       19   define new global shared variable g#language as character no-undo .
       20   if g#language <> '' and g#language <> 'rus':U then do:
       21     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       22   end.
       23   procedure proc-alt-shift-f2:
       24     if not ibs.th.gbl.gbl-var:rcode
       25   then
       26     run gbl\inidebug.p .
       27   end.
       28   procedure proc-alt-shift-f3:
       29     run gbl/prvssinf.p
       30       ( input this-procedure
       31       ) .
       32   end.
       33   define variable v-inform-launched as logical no-undo initial false .
       34   procedure proc-alt-shift-f4:
       35     define variable v-action as character no-undo .
       36     if v-inform-launched = false then do:
       37       assign
       38         v-inform-launched = true
       39       .
       40       run gbl/d-inform.w
       41         (  input self
       42         ,  input this-procedure
       43         , output v-action
       44         ) no-error .
       45       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       46       assign
       47         v-inform-launched = false
       48       .
       49     end.
       50   end.
       51   procedure proc-alt-f1:
       52     run gbl/corrhelp.p
       53       (input this-procedure
       54       ) .
       55   end .
       56   on alt-shift-f2 anywhere do:
       57     run proc-alt-shift-f2.
       58   end.
       59   on alt-shift-f3 anywhere do:
       60     run proc-alt-shift-f3 in this-procedure .
       61   end.
       62   on alt-shift-f4 anywhere do:
       63     run proc-alt-shift-f4 in this-procedure.
       64   end.
       65   on alt-f1 anywhere do:
       66     run proc-alt-f1 in this-procedure .
       67   end.
       68   define buffer tmp-dnst_sr-izmerenia for sr-izmerenia .
       69   DEFINE BUTTON b-cancel AUTO-END-KEY
       70        LABEL "Отмена"
       71        SIZE 15 BY 1.14
       72        BGCOLOR 8 .
       73   DEFINE BUTTON b-ok AUTO-GO
       74        LABEL "Ввод"
       75        SIZE 15 BY 1.14
       76        BGCOLOR 8 .
       77   DEFINE BUTTON b-mi-tmp-dnst
       78        IMAGE-UP FILE "btn-down-arrow":U
       79        IMAGE-DOWN FILE "btn-down-arrow":U
       80        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       81        label ""
       82        tooltip ""
       83        SIZE 3 BY .87.
       84   DEFINE VARIABLE v-mi-tmp-dnst AS integer FORMAT ">>>>>9":U
       85        LABEL ""
       86        VIEW-AS FILL-IN
       87        SIZE 11 BY 1 NO-UNDO.
       88   DEFINE VARIABLE v-mi-tmp-dnst-name AS character FORMAT "X(10)":U
       89        LABEL ""
       90        VIEW-AS FILL-IN
       91        SIZE 11 BY 1 NO-UNDO.
       92   define button b-fill-empty
       93       label "Заполнить пустые"
       94       size 18 by 1 .
       95   define query br-dens-temp for tt-dens-temp .
       96   define browse br-dens-temp query br-dens-temp exclusive-lock
       97     display
       98       tt-dens-temp.key_        label "Уровень " format "X(8)"
       99       tt-dens-temp.density     label "Значение,г/см3" format "9.9999"
      100       tt-dens-temp.temperature label "t измер. р,°C" format "->>9.9"
      101     enable
      102       tt-dens-temp.density
      103       tt-dens-temp.temperature
      104     with size 41 by 10 separators
      105   .
      106   DEFINE FRAME Dialog-Frame
      107        b-ok AT ROW 1.24 COL 2
      108        b-cancel AT ROW 1.24 COL 17
      109        "СИ температуры изм. плотности:" view-as text at row 2.4 col 2
      110        v-mi-tmp-dnst at row 3.45 col 2 no-label
      111        v-mi-tmp-dnst-name at row 3.45 col 2 no-label
      112        b-mi-tmp-dnst at row 3.5 col 14
      113        br-dens-temp at row 4.5 col 1
      114        b-fill-empty at row 15 col 2
      115        SPACE(1) SKIP(1)
      116       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      117            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      118            TITLE "Таблица измерений плотности"
      119            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
      120   ASSIGN
      121          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      122          FRAME Dialog-Frame:HIDDEN           = TRUE.
      123   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      124   DO:
      125     APPLY "END-ERROR":U TO SELF.
      126   END.
      127   on choose of b-ok in frame Dialog-Frame
      128   do :
      129     define buffer buf1_tt-dens-temp for tt-dens-temp .
      130     define buffer buf2_tt-dens-temp for tt-dens-temp .
      131     define buffer buf3_tt-dens-temp for tt-dens-temp .
      132     for first tt-dens-temp no-lock where tt-dens-temp.density = 0
      133                                       or tt-dens-temp.density = ?
      134                                       or tt-dens-temp.temperature = ?
      135                                       :
      136       message "Необходимо заполнить значения на всех уровнях!" view-as alert-box .
      137       return no-apply .
      138     end .
      139     case p-sr-izm-type :
      140       when 1
      141       then do :
      142         case p-place-type :
      143           when 1
      144           then do :
      145             find first buf1_tt-dens-temp where buf1_tt-dens-temp.ii = 1 .
      146             find first buf2_tt-dens-temp where buf2_tt-dens-temp.ii = 2 no-error .
      147             find first buf3_tt-dens-temp where buf3_tt-dens-temp.ii = 3 no-error .
      148             p-avg-density = buf1_tt-dens-temp.density .
      149             p-avg-temperature = buf1_tt-dens-temp.temperature .
      150             if available buf2_tt-dens-temp
      151             and not available buf3_tt-dens-temp
      152             then do :
      153               p-avg-density = (buf1_tt-dens-temp.density + buf2_tt-dens-temp.density) / 2 .
      154               p-avg-temperature = (buf1_tt-dens-temp.temperature + buf2_tt-dens-temp.temperature) / 2 .
      155             end .
      156             if available buf2_tt-dens-temp
      157             and available buf3_tt-dens-temp
      158             then do :
      159               p-avg-density = (buf1_tt-dens-temp.density + (3 * buf2_tt-dens-temp.density) + buf3_tt-dens-temp.density) / 5 .
      160               p-avg-temperature = (buf1_tt-dens-temp.temperature + (3 * buf2_tt-dens-temp.temperature) + buf3_tt-dens-temp.temperature) / 5 .
      161             end .
      162           end .
      163           when 2
      164           then do :
      165             find first buf1_tt-dens-temp where buf1_tt-dens-temp.ii = 1 .
      166             find first buf2_tt-dens-temp where buf2_tt-dens-temp.ii = 2 no-error .
      167             find first buf3_tt-dens-temp where buf3_tt-dens-temp.ii = 3 no-error .
      168             p-avg-density = buf1_tt-dens-temp.density .
      169             p-avg-temperature = buf1_tt-dens-temp.temperature .
      170             if available buf2_tt-dens-temp
      171             and not available buf3_tt-dens-temp
      172             then do :
      173               p-avg-density = (buf1_tt-dens-temp.density + (3 * buf2_tt-dens-temp.density)) / 4 .
      174               p-avg-temperature = (buf1_tt-dens-temp.temperature + (3 * buf2_tt-dens-temp.temperature)) / 4 .
      175             end .
      176             if available buf2_tt-dens-temp
      177             and available buf3_tt-dens-temp
      178             then do :
      179               p-avg-density = (buf1_tt-dens-temp.density + (6 * buf2_tt-dens-temp.density) + buf3_tt-dens-temp.density) / 8 .
      180               p-avg-temperature = (buf1_tt-dens-temp.temperature + (6 * buf2_tt-dens-temp.temperature) + buf3_tt-dens-temp.temperature) / 8 .
      181             end .
      182           end .
      183         end case .
      184       end .
      185     end case .
      186     p-mi-tmp-dnst = v-mi-tmp-dnst .
      187     p-ok = true .
      188   end .
      189   on return of tt-dens-temp.density in browse br-dens-temp
      190   do :
      191     apply "leave" to self .
      192   end .
      193   on leave of tt-dens-temp.density in browse br-dens-temp
      194   do :
      195     define variable is-empty as logical no-undo .
      196     define buffer buf_tt-dens-temp for tt-dens-temp .
      197     if decimal(tt-dens-temp.density:screen-value in browse br-dens-temp) >= 1
      198     then do :
      199       message "Неверное значение плотности!" view-as alert-box .
      200       return no-apply .
      201     end .
      202     assign tt-dens-temp.density = decimal(tt-dens-temp.density:screen-value in browse br-dens-temp) .
      203   end .
      204   on return of tt-dens-temp.temperature in browse br-dens-temp
      205   do :
      206     apply "leave" to self .
      207   end .
      208   on leave of tt-dens-temp.temperature in browse br-dens-temp
      209   do :
      210     define variable is-empty as logical no-undo .
      211     define buffer buf_tt-dens-temp for tt-dens-temp .
      212     assign tt-dens-temp.temperature = decimal(tt-dens-temp.temperature:screen-value in browse br-dens-temp) .
      213   end .
      214   on choose of b-fill-empty in frame Dialog-Frame
      215   do :
      216     define buffer buf_tt-dens-temp for tt-dens-temp .
      217     if available tt-dens-temp
      218     and (tt-dens-temp.density > 0 or tt-dens-temp.temperature <> ?)
      219     then do :
      220       for each buf_tt-dens-temp :
      221         if (buf_tt-dens-temp.density = ?
      222         or buf_tt-dens-temp.density = 0)
      223         and tt-dens-temp.density > 0
      224         then do :
      225           buf_tt-dens-temp.density = tt-dens-temp.density .
      226         end .
      227         if buf_tt-dens-temp.temperature = ?
      228         and tt-dens-temp.temperature <> ?
      229         then do :
      230           buf_tt-dens-temp.temperature = tt-dens-temp.temperature .
      231         end .
      232       end .
      233       br-dens-temp:refresh() in frame Dialog-Frame .
      234     end .
      235   end .
      236   on entry of tt-dens-temp.temperature IN browse br-dens-temp
      237   DO:
      238     define variable vlog as logical no-undo .
      239     if v-mi-tmp-dnst = 0
      240     or v-mi-tmp-dnst = ?
      241     then do :
      242       message "Для заполнения температуры измерения плотности необходимо выбрать соответствующее СИ. Выполнить выбор сейчас?"
      243       view-as alert-box question buttons yes-no update vlog .
      244       if vlog
      245       then do :
      246         apply "choose" to b-mi-tmp-dnst in FRAME Dialog-Frame .
      247         if v-mi-tmp-dnst = 0
      248         or v-mi-tmp-dnst = ?
      249         then do :
      250           return no-apply .
      251         end .
      252       end .
      253       else do :
      254         apply "entry" to tt-dens-temp.density IN browse br-dens-temp.
      255         return no-apply .
      256       end .
      257     end .
      258   end .
      259   ON CHOOSE OF b-mi-tmp-dnst IN FRAME Dialog-Frame
      260   DO:
      261     define variable v-node-code as integer no-undo.
      262     define variable v-sr-type-id as character no-undo.
      263     v-node-code = 0 .
      264     run ref/sr-izm.w (input parparentproc ,
      265                       input "b-sel"       ,
      266                       input 'ПРОСМОТР':U     ,
      267                       input "1"           ,
      268                       input "tmp"         ,
      269                       input-output v-node-code,
      270                       output v-sr-type-id) no-error.
      271     if v-node-code <> 0 and v-node-code <> ? then do :
      272       v-mi-tmp-dnst = v-node-code.
      273       v-mi-tmp-dnst:screen-value = string(v-node-code).
      274       find first tmp-dnst_sr-izmerenia no-lock where tmp-dnst_sr-izmerenia.node-code = v-mi-tmp-dnst .
      275       apply "leave" to v-mi-tmp-dnst in frame Dialog-Frame .
      276     end.
      277     else do :
      278       apply "entry" to tt-dens-temp.density IN browse br-dens-temp.
      279     end .
      280   END.
      281   on entry of v-mi-tmp-dnst-name IN FRAME Dialog-Frame
      282   do:
      283     apply "entry" to v-mi-tmp-dnst in frame Dialog-Frame.
      284   end .
      285   on entry of v-mi-tmp-dnst IN FRAME Dialog-Frame
      286   do:
      287     hide v-mi-tmp-dnst-name in frame Dialog-Frame.
      288   end .
      289   on return of v-mi-tmp-dnst IN FRAME Dialog-Frame
      290   do:
      291     apply "leave" to v-mi-tmp-dnst IN FRAME Dialog-Frame .
      292   end .
      293   on del of v-mi-tmp-dnst in frame Dialog-Frame
      294   do :
      295     v-mi-tmp-dnst = ? .
      296     v-mi-tmp-dnst:screen-value = "?" .
      297   end .
      298   on leave of v-mi-tmp-dnst IN FRAME Dialog-Frame
      299   do:
      300     define variable vlog as logical no-undo .
      301     define variable v-old-val as character no-undo .
      302     v-old-val = string(v-mi-tmp-dnst) .
      303     find first tmp-dnst_sr-izmerenia no-lock where tmp-dnst_sr-izmerenia.node-code = integer(v-mi-tmp-dnst:screen-value) no-error .
      304     if not available tmp-dnst_sr-izmerenia
      305     then do :
      306       if v-mi-tmp-dnst:screen-value <> "?"
      307       and v-mi-tmp-dnst:screen-value <> "0"
      308       then do :
      309         message ("Не найдено средтсво измерения с кодом " + v-mi-tmp-dnst:screen-value) view-as alert-box .
      310         v-mi-tmp-dnst:screen-value = v-old-val .
      311       end .
      312       return .
      313     end .
      314     else do :
      315       if tmp-dnst_sr-izmerenia.sr-type-izm = 2
      316       then do :
      317         message "Средство измерения является Измерительной Системой!" view-as alert-box .
      318         v-mi-tmp-dnst:screen-value = v-old-val .
      319         return .
      320       end .
      321       if tmp-dnst_sr-izmerenia.sr-type-izm = 0
      322       then do :
      323         message "Средство измерения является Автоматизированным!" view-as alert-box .
      324         v-mi-tmp-dnst:screen-value = v-old-val .
      325         return .
      326       end .
      327       if not tmp-dnst_sr-izmerenia.sr-temperature
      328       then do :
      329         message "Средство измерения НЕ измеряет температуру!" view-as alert-box .
      330         v-mi-tmp-dnst:screen-value = v-old-val .
      331         return .
      332       end .
      333     end .
      334     v-mi-tmp-dnst-name = tmp-dnst_sr-izmerenia.sr-model .
      335     display v-mi-tmp-dnst-name with frame Dialog-Frame.
      336     enable v-mi-tmp-dnst-name with frame Dialog-Frame.
      337     assign v-mi-tmp-dnst .
      338   end .
      339   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      340   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      341   MAIN-BLOCK:
      342   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      343      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      344     p-ok = false .
      345     run fill-tt .
      346     for first sr-izmerenia no-lock where sr-izmerenia.node-code = p-mi-tmp-dnst :
      347       assign
      348         v-mi-tmp-dnst = sr-izmerenia.node-code
      349         v-mi-tmp-dnst-name = sr-izmerenia.sr-model
      350       .
      351       display v-mi-tmp-dnst-name with frame Dialog-Frame.
      352       enable v-mi-tmp-dnst-name with frame Dialog-Frame.
      353     end .
      354     RUN enable_UI.
      355     WAIT-FOR GO OF FRAME Dialog-Frame.
      356   END.
      357   RUN disable_UI.
      358   procedure fill-tt :
      359     define variable ii as integer no-undo .
      360     case p-sr-izm-type :
      361       when 1
      362       then do :
      363         case p-place-type :
      364           when 1
      365           then do :
      366             find first tt-dens-temp where tt-dens-temp.key_ begins "P1" no-error .
      367             if available tt-dens-temp
      368             then do :
      369               empty temp-table tt-dens-temp .
      370             end .
      371             find first tt-dens-temp no-error .
      372             if not available tt-dens-temp
      373             then do :
      374               create tt-dens-temp .
      375               assign
      376                 tt-dens-temp.ii = 1
      377                 tt-dens-temp.key_ = "Pн"
      378                 tt-dens-temp.temperature = ?
      379               .
      380               if p-fuel-level > 1000
      381               then do :
      382                 create tt-dens-temp .
      383                 assign
      384                   tt-dens-temp.ii = 2
      385                   tt-dens-temp.key_ = "Pв"
      386                   tt-dens-temp.temperature = ?
      387                 .
      388               end .
      389               if p-fuel-level > 2000
      390               then do :
      391                 tt-dens-temp.key_ = "Pср" .
      392                 create tt-dens-temp .
      393                 assign
      394                   tt-dens-temp.ii = 3
      395                   tt-dens-temp.key_ = "Pв"
      396                   tt-dens-temp.temperature = ?
      397                 .
      398               end .
      399             end .
      400           end .
      401           when 2
      402           then do :
      403             find first tt-dens-temp where tt-dens-temp.key_ begins "P1" no-error .
      404             if available tt-dens-temp
      405             then do :
      406               empty temp-table tt-dens-temp .
      407             end .
      408             find first tt-dens-temp no-error .
      409             if not available tt-dens-temp
      410             then do :
      411               create tt-dens-temp .
      412               assign
      413                 tt-dens-temp.ii = 1
      414                 tt-dens-temp.key_ = "Pн"
      415                 tt-dens-temp.temperature = ?
      416               .
      417               if (p-diameter >= 2500 and p-fuel-level >= (p-diameter / 2))
      418               or (p-diameter < 2500 and p-fuel-level >= 500)
      419               or (p-fuel-level >= 500 and p-fuel-level <= (p-diameter / 2))
      420               then do :
      421                 create tt-dens-temp .
      422                 assign
      423                   tt-dens-temp.ii = 2
      424                   tt-dens-temp.key_ = "Pср"
      425                   tt-dens-temp.temperature = ?
      426                 .
      427               end .
      428               if (p-diameter >= 2500 and p-fuel-level >= (p-diameter / 2))
      429               then do :
      430                 create tt-dens-temp .
      431                 assign
      432                   tt-dens-temp.ii = 3
      433                   tt-dens-temp.key_ = "Pв"
      434                   tt-dens-temp.temperature = ?
      435                 .
      436               end .
      437             end .
      438           end .
      439         end case .
      440       end .
      441     end case .
      442   end procedure .
      443   PROCEDURE disable_UI :
      444     HIDE FRAME Dialog-Frame.
      445   END PROCEDURE.
      446   PROCEDURE enable_UI :
      447     ENABLE b-ok b-cancel br-dens-temp b-fill-empty b-mi-tmp-dnst v-mi-tmp-dnst v-mi-tmp-dnst-name
      448         WITH FRAME Dialog-Frame.
      449     VIEW FRAME Dialog-Frame.
      450     open query br-dens-temp for each tt-dens-temp .
      451   END PROCEDURE.
