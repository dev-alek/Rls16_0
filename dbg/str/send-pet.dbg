     3043   procedure xml-cd-write-header:
     3044   do
     3045   on error undo, return error
     3046   :
     3047   define input parameter p-xml-file-name       as character    no-undo.
     3048   define input parameter p-xml-file-name-path  as character    no-undo.
     3049   define input parameter p-doc-name            as character    no-undo.
     3050   define input parameter p-version             as character    no-undo.
     3051   define input parameter p-obj-list            as character    no-undo.
     3052   define input parameter p-correspondent       as character    no-undo .
     3053   define input parameter p-write-header        as logical      no-undo .
     3054   define variable OS-time as character no-undo .
     3055   define variable id as character no-undo .
     3056   define buffer buf_db for ub.db.
     3057   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3058   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3059   assign
     3060   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3061   .
     3062   run bgelib-tag-open in this-procedure (
     3063                                        1
     3064                                       ,p-doc-name
     3065                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3066                                         ).
     3067   if p-write-header then do:
     3068     run bgelib-tag-open(2, "Header","").
     3069     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3070     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3071     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3072     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3073     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3074     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3075     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3076     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3077     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3078     run bgelib-tag-close( 2, "Header" ).
     3079   end.
     3080   output stream stmXMLOut close.
     3081   end.
     3082   end procedure.
     3083   procedure xml-cd-write-footer:
     3084   do
     3085   on error undo, return error
     3086   :
     3087   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3088   define input parameter p-xml-file-name as character    no-undo.
     3089   define input parameter p-doc-name      as character    no-undo .
     3090   define variable v-error-num     as integer           no-undo.
     3091   define variable v-md5-signature as character no-undo .
     3092   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3093   run bgelib-tag-close( 0, p-doc-name ).
     3094   put stream stmXMLOut unformatted skip.
     3095   output stream stmXMLOut close.
     3096   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3097   if v-error-num > 0
     3098   then do:
     3099      return error.
     3100   end.
     3101   if opsys = "unix"
     3102   then do:
     3103       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3104   end.
     3105   end.
     3106   end procedure.
     3107   procedure xml-cd-filename :
     3108   do
     3109   on error undo, return error
     3110   :
     3111   define input parameter  p-out               as character no-undo .
     3112   define output parameter p-xml-file-name     as character    no-undo.
     3113   define output parameter p-xml-file-name-path   as character    no-undo.
     3114   define output parameter p-log-file-name     as character    no-undo.
     3115   define output parameter p-locked            as logical      no-undo.
     3116   define variable v-out as character     no-undo.
     3117   define variable loc#log as logical no-undo .
     3118   define variable BadFlag as logical no-undo .
     3119   define variable fq as integer no-undo .
     3120   define variable v-remote as character no-undo .
     3121   assign
     3122   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3123   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3124   p-log-file-name = p-out + "actions.log"
     3125   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3126   .
     3127   end.
     3128   end procedure.
     3129   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3130   define variable v-date-str as character no-undo .
     3131   assign
     3132   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3133                string(Month(p-date), "99":U) + "-":U +
     3134                string(DAY(p-date), "99":U).
     3135   return v-date-str.
     3136   END FUNCTION.
     3137   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3138   define variable v-date-str as character no-undo .
     3139   assign
     3140   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3141                string(Month(p-date), "99":U) + "-":U +
     3142                string(DAY(p-date), "99":U) + chr(32) +
     3143                string(p-time, "HH:MM:SS").
     3144   return v-date-str.
     3145   END FUNCTION.
     3146   function string-to-date returns date ( input p-string  as character):
     3147     define variable v-date as date no-undo .
     3148     assign
     3149     v-date = date(integer(substring(p-string, 4, 2))
     3150                   ,integer(substring(p-string, 1, 2))
     3151                   ,integer(substring(p-string, 7, 4))
     3152                  ) no-error .
     3153     if error-status:error then return ?.
     3154     return v-date.
     3155   END FUNCTION.
     3156   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3157   define variable v-time as integer no-undo init ?.
     3158   define variable v-dop1 as character no-undo .
     3159   define variable v-dop2 as character no-undo .
     3160   assign
     3161   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3162   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3163   no-error .
     3164   if error-status:error then return ?.
     3165   assign
     3166   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3167             integer(entry(2, v-dop2, ";":U)) * 60 +
     3168             integer(entry(3, v-dop2, ";":U)) no-error .
     3169   return v-time.
     3170   END FUNCTION.
     3171   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3172   procedure gdcstcod_cst-code :
     3173     define input  parameter p-obj-type  as character no-undo .
     3174     define input  parameter p-obj-code  as integer   no-undo .
     3175     define input  parameter p-gds-code  as integer   no-undo .
     3176     define input  parameter p-in-code   as character no-undo .
     3177     define input  parameter p-part-code as character no-undo .
     3178     define output parameter p-cst-code  as character no-undo .
     3179     define buffer buf_goods for ub.goods .
     3180     define buffer buf_parts for ub.parts .
     3181     do
     3182     on error undo, return error return-value
     3183     :
     3184       assign
     3185         p-cst-code = ''
     3186       .
     3187       find first buf_goods no-lock
     3188         where buf_goods.gds-code = p-gds-code
     3189         no-error .
     3190       if not available buf_goods
     3191       then do:
     3192         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
     3193       end.
     3194       if p-in-code = ?
     3195       then do:
     3196         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
     3197       end.
     3198       if p-part-code = ?
     3199       then do:
     3200         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
     3201       end.
     3202       if p-in-code = '':u
     3203       then do:
     3204         find first buf_parts no-lock
     3205           where buf_parts.obj-type  = p-obj-type
     3206             and buf_parts.obj-code  = p-obj-code
     3207             and buf_parts.artic     = buf_goods.artic
     3208             and buf_parts.prod-type = buf_goods.prod-type
     3209             and buf_parts.prod-code = buf_goods.prod-code
     3210             and buf_parts.out-code  = 'free-zone':U
     3211             and buf_parts.status_   = false
     3212           no-error .
     3213         if available buf_parts
     3214         then do:
     3215           assign
     3216             p-cst-code = buf_parts.cst-code
     3217           .
     3218         end.
     3219       end.
     3220       else do:
     3221         find first buf_parts no-lock
     3222           where buf_parts.obj-type  = p-obj-type
     3223             and buf_parts.obj-code  = p-obj-code
     3224             and buf_parts.artic     = buf_goods.artic
     3225             and buf_parts.prod-type = buf_goods.prod-type
     3226             and buf_parts.prod-code = buf_goods.prod-code
     3227             and buf_parts.out-code  = 'free-zone':U
     3228             and buf_parts.in-code   = p-in-code
     3229             and buf_parts.part-code = p-part-code
     3230           no-error .
     3231         if available buf_parts
     3232         then do:
     3233           assign
     3234             p-cst-code = buf_parts.cst-code
     3235           .
     3236         end.
     3237       end.
     3238     end.
     3239   end procedure.
