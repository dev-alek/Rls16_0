     3277   procedure alienini-getkey :
     3278   define input parameter i-filename as char.
     3279   define input parameter i-section as char.
     3280   define input parameter i-key as char.
     3281   define output parameter o-value as char.
     3282   define variable EntryPointer as integer no-undo.
     3283   define variable mem1 as memptr no-undo.
     3284   define variable mem2 as memptr no-undo.
     3285   define variable mem1size as integer no-undo.
     3286   define variable mem2size as integer no-undo.
     3287   define variable ii       as integer    no-undo.
     3288   define variable cbReturnSize  as integer    no-undo.
     3289   assign
     3290   set-size(mem1)  = 4000
     3291   mem1size = 4000.
     3292   if i-key = "" then EntryPointer = 0.
     3293   else do:
     3294     assign
     3295     set-size(mem2) = 128
     3296     mem2size = 128
     3297     EntryPointer = get-pointer-value(mem2)
     3298     put-string(mem2, 1) = i-key.
     3299   end.
     3300   run getprivateprofilestringA
     3301                                 (i-section,
     3302                                  EntryPointer,
     3303                                  "",
     3304                                  get-pointer-value(mem1),
     3305                                  input mem1size,
     3306                                  i-filename,
     3307                                  output cbReturnSize).
     3308   do ii = 1 to cbReturnSize:
     3309     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3310                  then o-value + ","
     3311                  else o-value + chr(get-byte(mem1, ii)).
     3312   end.
     3313     set-size(mem1) = 0.
     3314     set-size(mem2) = 0.
     3315   end procedure.
     3316   procedure alienini-putkey :
     3317   define input parameter i-filename as char.
     3318   define input parameter i-section as char.
     3319   define input parameter i-key as char.
     3320   define input parameter i-value as char.
     3321   define variable cbReturnSize as integer.
     3322   run writeprivateprofilestringA
     3323                                  (i-section,
     3324                                   i-key,
     3325                                   i-value,
     3326                                   i-filename,
     3327                                   output cbReturnSize ).
     3328   end procedure.
     3329   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3330     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3331     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3332     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3333     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3334     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3335     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3336     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3337   END PROCEDURE.
     3338   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3339     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3340     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3341     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3342     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3343     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3344   END PROCEDURE.
     3345   define   temp-table temp-tekka-tsk no-undo
     3346   field filename      as character
     3347   field obj-num       as integer
     3348   field obj-name      as character
     3349   field num-records   as integer
     3350   field max-records   as integer
     3351   field min-plu       as integer
     3352   field max-plu       as integer
     3353   field num-fields    as integer
     3354   field task-num      as character
     3355   field by-record     as logical
     3356   field send-get      as character
     3357   field cash-num      as integer
     3358   field cash-num-char as character
     3359   field port-num      as character
     3360   field way           as character
     3361   field is-script     as logical
     3362   field pswd          as character
     3363   field waiting-sek   as integer
     3364   field other-info    as character
     3365   field order-num     as integer
     3366   field secondary     as integer
     3367   field shift-fields  as integer
     3368   field binary        as logical
     3369   field range         as integer
     3370   index pi is unique primary
     3371   filename
     3372   range
     3373   index lpi
     3374   filename
     3375   min-plu
     3376   index gpi
     3377   filename
     3378   max-plu
     3379   index iorder
     3380   order-num
     3381   .
     3382   define   temp-table temp-tekka-schema no-undo
     3383   field obj-num as integer
     3384   field obj-name as character
     3385   field field-num as integer
     3386   field field-name as character
     3387   field num-records as integer
     3388   field size_ as integer
     3389   field host as character
     3390   field progress-type as character
     3391   field custom-type as character
     3392   field start-pos as integer
     3393   field end-pos as integer
     3394   field bin-group as character
     3395   index pi is unique primary
     3396   host obj-num field-num
     3397   .
     3398   define temp-table temp-tekka-record no-undo
     3399   field obj-num as integer
     3400   field plu as integer
     3401   field body as character
     3402   field shift as integer
     3403   index pi is unique primary obj-num plu.
     3404   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3405   define variable v-is-closed-shift-journal as integer no-undo .
     3406   assign
     3407   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3408                               +
     3409                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3410                               +
     3411                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3412   .
     3413   return v-is-closed-shift-journal.
     3414   END FUNCTION.
     3415   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3416   define variable v-is-first-journal as logical no-undo .
     3417   assign
     3418   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3419                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3420                     or (p-journal-num =  integer(entry(1, '17':U)))
     3421                     or (p-journal-num = integer(entry(1, '16':U)))
     3422   .
     3423   return v-is-first-journal.
     3424   END FUNCTION.
     3425   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3426   define variable v-is-petrol-journal as logical no-undo .
     3427   assign
     3428   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3429   return v-is-petrol-journal.
     3430   END FUNCTION.
     3431   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3432   define variable v-max-record-num as integer no-undo .
     3433   assign
     3434   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3435                       then 1489
     3436                       else 2340).
     3437   return v-max-record-num.
     3438   END FUNCTION.
     3439   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3440   define variable v-max-record-num as integer no-undo .
     3441   assign
     3442   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3443                       then 1489 * num-entries('30,31,32,33':U)
     3444                       else 2340 * num-entries('17':U)).
     3445   return v-max-record-num.
     3446   END FUNCTION.
     3447   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3448                                           ,input p-rec-no as integer):
     3449   define variable v-num-recs as integer no-undo .
     3450   if tekka-is-petrol-journal (p-journal-num) then do:
     3451     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3452       assign
     3453       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3454       .
     3455     end.
     3456     else do:
     3457       assign
     3458       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3459       .
     3460     end.
     3461   end.
     3462   else do:
     3463     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3464       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3465         assign
     3466         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3467         .
     3468       end.
     3469       else do:
     3470         assign
     3471         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3472         .
     3473       end.
     3474     end.
     3475     else do:
     3476       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3477         assign
     3478         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3479         .
     3480       end.
     3481       else do:
     3482         assign
     3483         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3484         .
     3485       end.
     3486     end.
     3487   end.
     3488   return v-num-recs.
     3489   END FUNCTION.
     3490   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3491                                              ,input p-is-petrol as logical
     3492                                              ,input p-is-current as logical
     3493                                              ,output p-rec-no as decimal
     3494                                              ):
     3495   define variable v-obj-num0 as integer no-undo .
     3496   define variable v-obj-num as integer no-undo .
     3497   define variable v-obj-num2 as integer no-undo .
     3498   define variable p-num-recs2 as integer no-undo .
     3499   define variable p-rec-no2 as integer no-undo .
     3500   if p-is-petrol then do:
     3501     assign
     3502     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3503     .
     3504     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3505     then
     3506     assign
     3507     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3508     p-rec-no = p-num-recs modulo 1489
     3509     .
     3510     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3511     then
     3512     assign
     3513     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3514     p-rec-no = p-num-recs modulo 1489
     3515     .
     3516   end.
     3517   else do:
     3518     assign
     3519     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3520     p-num-recs = trunc(p-num-recs, 0)
     3521     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3522     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3523     .
     3524     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3525     then
     3526     assign
     3527     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3528     p-rec-no = p-num-recs modulo 2340
     3529     .
     3530     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3531     then
     3532     assign
     3533     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3534     p-rec-no = p-num-recs modulo 2340
     3535     .
     3536     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3537     then
     3538     assign
     3539     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3540     p-rec-no2 = p-num-recs2 modulo 2978
     3541     .
     3542     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3543     then
     3544     assign
     3545     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3546     p-rec-no2 = p-num-recs2 modulo 2978
     3547     .
     3548     assign
     3549     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3550     .
     3551   end.
     3552   if v-obj-num = 0 then v-obj-num = 100.
     3553   return v-obj-num.
     3554   END FUNCTION.
     3555   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3556   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3557   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3558      if p-is-ptrl then
     3559      return integer(entry(1, '26,27,28,29':U)).
     3560      if not p-is-ptrl then
     3561      return integer(entry(1, '16':U)).
     3562   end.
     3563   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3564   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3565   return 0.
     3566   END FUNCTION.
     3567   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3568   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3569   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3570     if p-is-ptrl then
     3571     return integer(entry(1, '26,27,28,29':U)).
     3572     if not p-is-ptrl then
     3573     return integer(entry(1, '16':U)).
     3574   end.
     3575   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3576   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3577   return 0.
     3578   END FUNCTION.
     3579   PROCEDURE maria-put:
     3580   define parameter buffer buf_cash-desk for ub.cash-desk.
     3581   define input parameter p-out    as character no-undo .
     3582   define input parameter p-fname as character no-undo .
     3583   define input parameter p-by-record as logical no-undo .
     3584   define input parameter p-shift-fields as integer no-undo .
     3585   define input parameter p-binary as logical no-undo .
     3586   define input parameter p-obj-num as integer no-undo .
     3587   define input parameter p-max-records as integer no-undo .
     3588   define input parameter p-plu as integer no-undo .
     3589   define input parameter p-value as character no-undo .
     3590   define variable v-file-name as character no-undo .
     3591   define variable v-create as logical no-undo .
     3592   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3593   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3594   output stream IBMSTREAM
     3595   to value(v-file-name) append .
     3596   Put  stream IBMSTREAM unformatted
     3597   p-plu
     3598   chr(3)
     3599   p-value
     3600   skip.
     3601   output stream IBMSTREAM
     3602   close.
     3603   if not p-by-record then do:
     3604     find first buf_temp-tekka-tsk where
     3605               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3606     if not available buf_temp-tekka-tsk then do:
     3607       v-create = yes.
     3608     end.
     3609   end.
     3610   else do:
     3611     find first buf_temp-tekka-tsk where
     3612               buf_temp-tekka-tsk.filename  = v-file-name
     3613           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3614     if not available buf_temp-tekka-tsk
     3615     then do:
     3616       find first buf_temp-tekka-tsk where
     3617                 buf_temp-tekka-tsk.filename  = v-file-name
     3618             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3619       if not available buf_temp-tekka-tsk
     3620       then do:
     3621         v-create = yes.
     3622       end.
     3623     end.
     3624   end.
     3625   if v-create then do:
     3626     create buf_temp-tekka-tsk.
     3627     assign
     3628     buf_temp-tekka-tsk.filename = v-file-name
     3629     buf_temp-tekka-tsk.range    = p-plu
     3630     buf_temp-tekka-tsk.obj-num = p-obj-num
     3631     buf_temp-tekka-tsk.obj-name = '':U
     3632     buf_temp-tekka-tsk.num-records = 0
     3633     buf_temp-tekka-tsk.max-records = p-max-records
     3634     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3635     buf_temp-tekka-tsk.task-num = p-fname
     3636     buf_temp-tekka-tsk.by-record = p-by-record
     3637     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3638     buf_temp-tekka-tsk.binary = p-binary
     3639     buf_temp-tekka-tsk.send-get = 'send'
     3640     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3641     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3642     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3643     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3644                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3645                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3646                                 then 'local'
     3647                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3648     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3649     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3650     buf_temp-tekka-tsk.waiting-sek = 30
     3651     buf_temp-tekka-tsk.min-plu     = p-plu
     3652     buf_temp-tekka-tsk.max-plu     = p-plu
     3653     .
     3654   end.
     3655   assign
     3656   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3657   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3658   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3659   .
     3660   END PROCEDURE.
     3661   PROCEDURE maria-get:
     3662   define parameter buffer buf_cash-desk for ub.cash-desk.
     3663   define input parameter p-out    as character no-undo .
     3664   define input parameter p-fname as character no-undo .
     3665   define input parameter p-by-record as logical no-undo .
     3666   define input parameter p-obj-num as integer no-undo .
     3667   define input parameter p-num-fields as integer no-undo .
     3668   define input parameter p-max-records as integer no-undo .
     3669   define input parameter p-min-plu as integer no-undo .
     3670   define input parameter p-max-plu as integer no-undo .
     3671   define input parameter p-other as character no-undo .
     3672   define input parameter p-order-num as integer no-undo .
     3673   define variable v-file-name as character no-undo .
     3674   define variable v-secondary-obj-num as character no-undo .
     3675   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3676   if p-by-record then do:
     3677     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3678   end.
     3679   else do:
     3680     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3681   end.
     3682   find first buf_temp-tekka-tsk where
     3683             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3684   if not available buf_temp-tekka-tsk then do:
     3685     create buf_temp-tekka-tsk.
     3686     assign
     3687     buf_temp-tekka-tsk.filename = v-file-name
     3688     buf_temp-tekka-tsk.obj-num = p-obj-num
     3689     buf_temp-tekka-tsk.obj-name = '':U
     3690     buf_temp-tekka-tsk.max-records = p-max-records
     3691     buf_temp-tekka-tsk.num-fields = p-num-fields
     3692     buf_temp-tekka-tsk.task-num = p-fname
     3693     buf_temp-tekka-tsk.by-record = p-by-record
     3694     buf_temp-tekka-tsk.send-get = 'get'
     3695     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3696     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3697     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3698     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3699                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3700                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3701                                   then 'local'
     3702                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3703     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3704     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3705     buf_temp-tekka-tsk.waiting-sek = 30
     3706     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3707     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3708     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3709                                       and p-max-plu <> ?
     3710                                       then p-max-plu - p-min-plu + 1
     3711                                       else 0)
     3712     buf_temp-tekka-tsk.other-info = p-other
     3713     buf_temp-tekka-tsk.order-num = p-order-num
     3714     .
     3715     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3716       assign
     3717       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3718       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3719       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3720       no-error
     3721       .
     3722       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3723     end.
     3724   end.
     3725   END PROCEDURE.
     3726   PROCEDURE maria-task:
     3727   define parameter buffer buf_cash-desk for ub.cash-desk.
     3728   define input parameter p-fname as character no-undo .
     3729   define input parameter p-obj-num-list as character no-undo .
     3730   define input parameter p-parameters as character no-undo .
     3731   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3732   find first buf_temp-tekka-tsk where
     3733             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3734   if not available buf_temp-tekka-tsk then do:
     3735     create buf_temp-tekka-tsk.
     3736     assign
     3737     buf_temp-tekka-tsk.filename = ''
     3738     buf_temp-tekka-tsk.range = 1
     3739     buf_temp-tekka-tsk.obj-num = 0
     3740     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3741     buf_temp-tekka-tsk.task-num = p-fname
     3742     buf_temp-tekka-tsk.by-record = no
     3743     buf_temp-tekka-tsk.send-get = 'task'
     3744     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3745     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3746     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3747     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3748                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3749                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3750                                   then 'local'
     3751                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3752     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3753     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3754     buf_temp-tekka-tsk.waiting-sek = 30
     3755     buf_temp-tekka-tsk.other-info = p-parameters
     3756     buf_temp-tekka-tsk.order-num = 0
     3757     .
     3758   end.
     3759   END PROCEDURE.
     3760   procedure tekkatsk-verify-schema :
     3761   define input parameter p-obj-list as character no-undo .
     3762   define input parameter p-dir-path as character no-undo .
     3763   define variable v-obj-num as integer no-undo .
     3764   define variable v-obj-name as character no-undo .
     3765   define variable v-num-records as integer no-undo .
     3766   define variable v-size_ as integer no-undo .
     3767   define variable v-value as character no-undo .
     3768   define variable ii as integer no-undo .
     3769   define variable jj as integer no-undo .
     3770   define variable ii-ibs as integer no-undo .
     3771   define variable ii-tekka as integer no-undo .
     3772   define variable v-result as character no-undo .
     3773   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     3774   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     3775     do
     3776     on error undo, return error
     3777     :
     3778        for each buf_temp-tekka-schema:
     3779          delete buf_temp-tekka-schema.
     3780        end.
     3781        input from value('tekkasch.d').
     3782        repeat :
     3783          create buf_temp-tekka-schema.
     3784          import buf_temp-tekka-schema.
     3785          assign
     3786          buf_temp-tekka-schema.host = 'IBS'
     3787          ii = ii + 1.
     3788          .
     3789        end.
     3790        input close.
     3791        ii-ibs = ii.
     3792         _ii:
     3793         do ii = 1 to 256:
     3794           if p-obj-list = "ALL"
     3795           or lookup(string(ii), p-obj-list) > 0 then do:
     3796             assign
     3797             v-obj-num = 0
     3798             v-obj-name = ''
     3799             v-num-records = 0
     3800             v-size_ = 0
     3801             .
     3802             run alienini-getkey in this-procedure (
     3803                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3804                                                     ,input ('obj' + string(ii, '999'))
     3805                                                     ,input 'oname'
     3806                                                     ,output v-value) no-error .
     3807             if v-value = ? then next _ii.
     3808             assign
     3809             v-obj-num = ii
     3810             v-obj-name = v-value
     3811             .
     3812             run alienini-getkey in this-procedure (
     3813                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3814                                                     ,input ('obj' + string(ii, '999'))
     3815                                                     ,input 'size'
     3816                                                     ,output v-value) no-error .
     3817             assign
     3818             v-num-records = integer(v-value) no-error  .
     3819             if error-status:error
     3820             or v-num-records = 0 then next _ii.
     3821             run alienini-getkey in this-procedure (
     3822                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3823                                                     ,input 'obj' + string(ii, '999')
     3824                                                     ,input 'f000'
     3825                                                     ,output v-value) no-error .
     3826             assign
     3827             v-size_ = integer(v-value) no-error  .
     3828             if error-status:error
     3829             or v-size_ = 0 then next _ii.
     3830             _jj:
     3831             do jj = 1 to 256:
     3832               run alienini-getkey in this-procedure (
     3833                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3834                                                       ,input 'obj' + string(ii, '999')
     3835                                                       ,input 'f' + string(jj, '999')
     3836                                                       ,output v-value) no-error .
     3837               if v-value = ? then next _ii.
     3838               create buf_temp-tekka-schema.
     3839               assign
     3840               buf_temp-tekka-schema.host = 'tekka'
     3841               buf_temp-tekka-schema.obj-num = v-obj-num
     3842               buf_temp-tekka-schema.obj-name = v-obj-name
     3843               buf_temp-tekka-schema.num-records = v-num-records
     3844               buf_temp-tekka-schema.size_ = v-size_
     3845               buf_temp-tekka-schema.field-num = jj
     3846               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     3847               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     3848                                                  then entry(2, entry(2, v-value, '#'), ':')
     3849                                                  else '':U)
     3850               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     3851               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     3852               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     3853                                                           , 'C,I,I,I,D,D,D,D,D':U)
     3854               no-error
     3855               .
     3856               if error-status:error then do:
     3857                 delete buf_temp-tekka-schema.
     3858                 next _jj.
     3859               end.
     3860               run alienini-getkey in this-procedure (
     3861                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3862                                                       ,input 'obj' + string(ii, '999') + 'name'
     3863                                                       ,input 'n' + string(jj, '999')
     3864                                                       ,output v-value) no-error .
     3865               if v-value <> ? then
     3866               buf_temp-tekka-schema.field-name = v-value.
     3867             end.
     3868           end.
     3869         end.
     3870         ii-tekka = ii - 1.
     3871        if p-obj-list <> 'ALL' then do:
     3872         if ii-tekka <> ii-ibs then do:
     3873           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     3874                                   , ii-ibs
     3875                                   , ii-tekka).
     3876         end.
     3877        end.
     3878        for each buf_temp-tekka-schema where
     3879               buf_temp-tekka-schema.host = 'tekka':
     3880          find first buf2_temp-tekka-schema where
     3881                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     3882                AND buf2_temp-tekka-schema.host = 'ibs'
     3883                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     3884          if not available buf2_temp-tekka-schema then do:
     3885           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     3886                                   , buf_temp-tekka-schema.field-num
     3887                                   , buf_temp-tekka-schema.obj-num).
     3888          end.
     3889          buffer-compare buf_temp-tekka-schema
     3890          to buf2_temp-tekka-schema
     3891          save result in v-result.
     3892          if v-result <> '':U then do:
     3893           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     3894                                   , buf_temp-tekka-schema.field-num
     3895                                   , buf_temp-tekka-schema.obj-num).
     3896          end.
     3897        end.
     3898     end.
     3899   end procedure.
     3900   FUNCTION set-Sx returns character (input p-string as character):
     3901   return p-string.
     3902   END FUNCTION.
     3903   FUNCTION get-Sx returns character (input p-string  as character):
     3904   return p-string.
     3905   END FUNCTION.
     3906   FUNCTION set-B returns character (input p-string  as character):
     3907   return chr(integer(p-string)).
     3908   END FUNCTION.
     3909   FUNCTION get-B returns character (input p-string  as character):
     3910   return string(asc(p-string)).
     3911   END FUNCTION.
     3912   FUNCTION set-BF returns character (input p-string  as character):
     3913   define variable v-dopi as integer no-undo .
     3914   define variable ii as integer no-undo .
     3915   do ii = 1 to 8:
     3916     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3917   end.
     3918   return chr(v-dopi).
     3919   END FUNCTION.
     3920   FUNCTION get-BF returns character (input p-string  as character):
     3921   define variable v-dopi as integer no-undo .
     3922   define variable v-dops as character no-undo .
     3923   define variable ii as integer no-undo .
     3924   v-dopi = asc(p-string).
     3925   do ii = 8 to 1 BY -1:
     3926     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3927   end.
     3928   return v-dops.
     3929   END FUNCTION.
     3930   FUNCTION set-BN returns character (input p-string  as character
     3931                                     ,input p-bin-group as character):
     3932   define variable v-dopi as integer no-undo .
     3933   define variable ii as integer no-undo .
     3934   define variable jj as integer no-undo .
     3935   define variable v-grp-nums as integer no-undo .
     3936   define variable v-dopi2 as integer no-undo .
     3937   v-grp-nums = num-entries(p-bin-group).
     3938   do jj = 0 to v-grp-nums - 1:
     3939     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3940     do ii = 1 to 8:
     3941       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3942     end.
     3943   end.
     3944   return chr(v-dopi).
     3945   END FUNCTION.
     3946   FUNCTION get-BN returns character (input p-string  as character
     3947                                     ,input p-bin-group as character):
     3948   define variable v-dopi as integer no-undo .
     3949   define variable v-dops as character no-undo .
     3950   define variable v-grp-nums as integer no-undo .
     3951   define variable ii as integer no-undo .
     3952   define variable jj as integer no-undo .
     3953   v-dopi = asc(p-string).
     3954   v-grp-nums = num-entries(p-bin-group).
     3955   do jj = 1 to v-grp-nums:
     3956   do ii = 8 to 1 BY -1:
     3957     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3958   end.
     3959   end.
     3960   return v-dops.
     3961   END FUNCTION.
     3962   procedure fill-temp-cd :
     3963   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     3964   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3965   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3966   define input parameter p-clear-table as logical no-undo .
     3967   define buffer buf_temp-cd for temp-cd.
     3968   define buffer buf_cash-desk for ub.cash-desk.
     3969     do
     3970     on error undo, return error
     3971     :
     3972        if p-clear-table  then do:
     3973          for each buf_temp-cd:
     3974            delete buf_temp-cd.
     3975          end.
     3976        end.
     3977        for each buf_cash-desk no-lock where
     3978               buf_cash-desk.db-num = p-db-num
     3979           AND buf_cash-desk.obj-code = p-obj-code
     3980           and buf_cash-desk.cash-on  = yes
     3981        BREAK by buf_cash-desk.pos-type:
     3982          if first-of(buf_cash-desk.pos-type) then do:
     3983            create buf_temp-cd.
     3984            buffer-copy buf_cash-desk to buf_temp-cd.
     3985          end.
     3986        end.
     3987     end.
     3988   end procedure.
     3989   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3990   FUNCTION name-2cdf returns character
     3991                      (  input p-name-2cd as character
     3992                       , input p-mode as logical
     3993                       , input p-cod-pcod as logical
     3994                       , input p-b-code  as integer
     3995                       , input p-gds-code as integer
     3996                       , input p-artic   as character
     3997                       , input p-engl-name  as character
     3998                       , input p-in-code as character
     3999                       , input p-part-code as character
     4000                       , input p-obj-type as character
     4001                       , input p-obj-code as integer
     4002                       , input p-alpha1 as character
     4003                       , output p-gtd as character
     4004                       ) :
     4005   define variable v-name-2cd as character no-undo .
     4006   define variable v-dop-alt-name as character no-undo.
     4007   define variable v-type as character no-undo.
     4008   define buffer buf_parts for ub.parts.
     4009   define buffer buf_code for ub.code.
     4010   if not p-mode and p-name-2cd = "PLU":U then do:
     4011     return "PLU кассы":U.
     4012   end.
     4013   if not p-mode then do:
     4014     if p-name-2cd <> "GTD":U
     4015     and  p-name-2cd <> "alpha1|gtd":U
     4016     then do:
     4017     assign
     4018     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
     4019   end.
     4020   end.
     4021   if p-part-code = "":U or p-cod-pcod = no then do:
     4022     run gdsoattr-value in this-procedure (
     4023       'dt-seasons':U,
     4024       p-gds-code,
     4025       p-obj-type,
     4026       p-obj-code,
     4027       output v-dop-alt-name,
     4028       output v-type
     4029     ) no-error.
     4030     if v-dop-alt-name <> "" then do:
     4031       find first buf_code where
     4032                  buf_code.parent = "DTSeasons"
     4033              and buf_code.code   = v-dop-alt-name
     4034            no-lock no-error.
     4035       if available buf_code then
     4036         assign
     4037           p-engl-name = ""
     4038           v-dop-alt-name =  buf_code.misc1
     4039         .
     4040     end.
     4041     else do:
     4042       run gdsoattr-value in this-procedure
     4043                           ( input  'dop-alt-name-o':U
     4044                            ,input  p-gds-code
     4045                            ,input  p-obj-type
     4046                            ,input  p-obj-code
     4047                            ,output v-dop-alt-name
     4048                            ,output v-type
     4049                           ) no-error .
     4050     end.
     4051     CASE p-name-2cd:
     4052       when "name" then do:
     4053         if p-mode then return p-engl-name + v-dop-alt-name.
     4054         return "Англ. название".
     4055       end.
     4056       when "code":U then do:
     4057         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4058         return "Лок. код товара"  .
     4059       end.
     4060       when "GTD":U
     4061       or
     4062       when "name-GTD":U
     4063       or
     4064       when "code-GTD":U
     4065       or
     4066       when "alpha1|gtd":U
     4067       or
     4068       when "name-alpha1|gtd":U
     4069       or
     4070       when "code-alpha1|gtd":U
     4071       then do:
     4072         if p-mode then do:
     4073           run gdcstcod_cst-code  in this-procedure (
     4074                                                       input  p-obj-type
     4075                                                       ,input  p-obj-code
     4076                                                       ,input  p-gds-code
     4077                                                       ,input  p-in-code
     4078                                                       ,input  p-part-code
     4079                                                       ,output p-gtd
     4080                                                       ) no-error .
     4081         end.
     4082         if p-name-2cd = "name-gtd":U then do:
     4083           if p-mode then return p-engl-name  + v-dop-alt-name.
     4084           return "Англ. название".
     4085         end.
     4086         if p-name-2cd = "name-alpha1|gtd":U then do:
     4087           if p-mode then return p-engl-name  + v-dop-alt-name.
     4088           return "Англ. название".
     4089         end.
     4090         if p-name-2cd = "code-GTD":U then do:
     4091           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4092           return "Лок. код товара"  .
     4093         end.
     4094         if p-name-2cd = "code-alpha1|gtd":U then do:
     4095           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4096           return "Лок. код товара"  .
     4097         end.
     4098         if p-mode then do:
     4099           if p-name-2cd = "GTD" then  return p-gtd.
     4100           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
     4101         end.
     4102         if p-name-2cd = "GTD" then  return "Код ГТД".
     4103         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
     4104       end.
     4105     END CASE.
     4106   end.
     4107   else do:
     4108     if p-name-2cd = "name-gtd":U
     4109     or p-name-2cd = "code-GTD":U
     4110     or p-name-2cd = "name-alpha1|GTD":U
     4111     or p-name-2cd = "code-alpha1|GTD":U
     4112     or p-name-2cd = "alpha1|GTD":U
     4113     then do:
     4114       if p-mode then do:
     4115         run gdcstcod_cst-code  in this-procedure (
     4116                                                      input  p-obj-type
     4117                                                     ,input  p-obj-code
     4118                                                     ,input  p-gds-code
     4119                                                     ,input  p-in-code
     4120                                                     ,input  p-part-code
     4121                                                     ,output p-gtd
     4122                                                     ) no-error .
     4123       end.
     4124       else do:
     4125         if p-name-2cd = "gtd":U then
     4126         p-gtd = "Код ГТД".
     4127         if p-name-2cd = "alpha1|Gtd":U then
     4128         p-gtd = "Страна|Код ГТД".
     4129       end.
     4130     end.
     4131     if p-mode then  return p-part-code.
     4132     return "Код партии".
     4133   end.
     4134   END FUNCTION.
     4135   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
     4136                                            ,input p-nam-2str as logical
     4137                                            ,input p-nam-artc as logical
     4138                                            ,input p-unit-cli-type as character
     4139                                            ,input p-unit-base as character
     4140                                            ,input p-unit-cli as character
     4141                                            ,input p-cli-base-rate as decimal
     4142                                            ,input p-artic as character
     4143                                            ,input p-f-name as character
     4144                                            ,input p-gds-name as character
     4145                                            ,input p-gds-name1 as character
     4146                                            ,output p-second-name as character):
     4147   define variable v-length as integer no-undo .
     4148   define variable nam-2str-shift as integer no-undo .
     4149   define variable chk_name as character no-undo .
     4150   assign
     4151   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
     4152   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
     4153   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
     4154               then 5
     4155               else v-length)
     4156   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
     4157   nam-2str-shift = (if p-nam-2str then v-length else 0)
     4158   .
     4159   if p-nam-artc then do:
     4160     assign
     4161     chk_name = substitute("&1 &2", p-artic, p-f-name)
     4162       .
     4163   end.
     4164   else  do:
     4165     assign
     4166     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
     4167     .
     4168   end.
     4169   if p-unit-base <> p-unit-cli then do:
     4170     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
     4171     assign
     4172     chk_name = string(substr(chk_name
     4173                               ,1
     4174                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
     4175                       "*":U +
     4176                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
     4177   end.
     4178   else do:
     4179     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
     4180   end.
     4181   if p-nam-2str then do:
     4182     assign
     4183     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
     4184     chk_name = substr(chk_name, 1, v-length)
     4185     .
     4186   end.
     4187   else do:
     4188     assign
     4189     p-second-name = replace(p-gds-name1, chr(39), "":U)
     4190     p-second-name =   (chr(34) +
     4191                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
     4192                       + chr(34) )
     4193     .
     4194   end.
     4195   return chk_name.
     4196   end function.
     4197   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4198   procedure disrules-get-interface-form :
     4199   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     4200   define output parameter p-form-name as character no-undo .
     4201   define buffer buf_temp-drt-prop for temp-drt-prop.
     4202   define buffer buf_drt-prop for ub.drt-prop.
     4203   find first buf_temp-drt-prop where
     4204             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4205         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     4206         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     4207   if not available buf_temp-drt-prop then do:
     4208     find first buf_drt-prop where
     4209               buf_drt-prop.templ-rl-root = p-templ-rl-root
     4210           and buf_drt-prop.upper-prop-code = "InputForm"
     4211           and buf_drt-prop.prop-code = "FormName" no-error.
     4212     if available buf_drt-prop then do:
     4213       p-form-name = buf_drt-prop.property-value.
     4214     end.
     4215     else do:
     4216       p-form-name = "ref/dis-ruli.w".
     4217     end.
     4218   end.
     4219   else do:
     4220     p-form-name = buf_temp-drt-prop.property-value.
     4221   end.
     4222   end procedure.
