    10133   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10134   PROCEDURE term-prt.
    10135   define input parameter c-root like ub.gds-prt.prt-root no-undo.
    10136   define input parameter c-node like ub.gds-prt.node-code no-undo.
    10137   define buffer b-g-p for ub.gds-prt.
    10138   define buffer pr-bc for ub.bar-code .
    10139   define buffer b-bc for ub.bar-code .
    10140   define buffer p-bar-code for ub.bar-code .
    10141   define buffer b-units for ub.units.
    10142   define variable pusto as char init "" no-undo.
    10143   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10144     if action = "U" then do:
    10145   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
    10146     (input  gds-list.gds-code
    10147     ,input  ?
    10148     ,output main-b-code
    10149     ) no-error .
    10150         find first buf_producer no-lock where
    10151                    buf_producer.obj-type = gds-list.prod-type
    10152                AND buf_producer.obj-code = gds-list.prod-code no-error .
    10153         assign
    10154         for-producer = (if available buf_producer
    10155                         then buf_producer.obj-name
    10156                         else (gds-list.prod-type + string(gds-list.prod-code)))
    10157         for-producer-int = (if gds-list.prod-type = 'орг':U then 1000000 else 0 ) + gds-list.prod-code
    10158         .
    10159     end.
    10160     if LOOKUP('топ':U, ub.units.type) > 0 and
    10161         LOOKUP('дро':U, ub.units.type) > 0 AND
    10162         gds-list.gds-type = 'т':U
    10163     then do:
    10164           petrol-trk = yes.
    10165     end.
    10166     else petrol-trk = no.
    10167     _b-g-p:
    10168      FOR EACH ub.bar-code NO-LOCK where
    10169               ub.bar-code.gds-code = gds-list.gds-code,
    10170         FIRST b-g-p NO-LOCK WHERE
    10171               b-g-p.node-code = ub.bar-code.node-code
    10172          AND  b-g-p.prt-root = c-root
    10173          AND  b-g-p.is-term = yes
    10174        :
    10175        if ub.bar-code.part-code <> ""
    10176        OR ub.bar-code.in-code <> ""
    10177        OR ub.bar-code.unit-cli <> gds-list.unit-base then NEXT _b-g-p.
    10178   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10179   FIND FIRST ub.prt-obj WHERE
    10180           ub.prt-obj.obj-type = 'маг':U AND
    10181           ub.prt-obj.obj-code = ub.shop.obj-code AND
    10182           ub.prt-obj.prod-type = gds-list.prod-type AND
    10183           ub.prt-obj.prod-code = gds-list.prod-code AND
    10184           ub.prt-obj.artic = gds-list.artic AND
    10185           ub.prt-obj.prt-code = b-g-p.node-code NO-LOCK NO-ERROR .
    10186   if v-is-restaurant and v-is-null-price then.
    10187   else do:
    10188       def var l-in-ov87 as logical no-undo .
    10189   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10190   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    10191     (input  'маг':U
    10192     ,input  ub.shop.obj-code
    10193     ,input  gds-list.artic
    10194     ,input  gds-list.prod-type
    10195     ,input  gds-list.prod-code
    10196     ,input  'in-ov=request'
    10197     ,output l-in-ov87
    10198     ) no-error .
    10199     if error-status:error then do:
    10200       message
    10201         "Ошибка получения признака товара на объекте" skip
    10202         error-status :get-message(1) skip
    10203         return-value skip
    10204         view-as alert-box error .
    10205       undo, return error .
    10206     end.
    10207     if (ub.shop.in-ov and  l-in-ov87 ) then
