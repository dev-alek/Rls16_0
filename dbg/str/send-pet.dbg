     8313   for each thbjattr_thbj-attr where
     8314           thbjattr_thbj-attr.obj-type = 'маг':U
     8315       and thbjattr_thbj-attr.obj-code = i-obj-code
     8316       and thbjattr_thbj-attr.upper-prop-code = 'cd-inf-send':U
     8317   on error undo, return error :
     8318     case thbjattr_thbj-attr.prop-code:
     8319       when 'nam-artc':U then do:
     8320         nam-artc = thbjattr_thbj-attr.property-value-logical.
     8321       end.
     8322       when 'cod-pcod':U then do:
