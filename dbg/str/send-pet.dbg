    11516       and gds-list.artic     = buf_goods.artic
    11517     no-error .
    11518   if available gds-list then do:
    11519     assign
    11520       gds-list.to-del = no
    11521     .
    11522   end.
    11523   else do:
    11524     define variable v-last104 as integer no-undo .
    11525     find last gds-list use-index oi no-error.
    11526     if available gds-list then do:
    11527       v-last104 = gds-list.order-num .
    11528     end.
    11529     else do:
    11530       v-last104 = 0 .
    11531     end.
    11532     create gds-list .
    11533     buffer-copy buf_goods to gds-list
    11534     assign
    11535       gds-list.to-del = no
    11536       gds-list.order-num = v-last104 + 1
    11537     .
    11538     assign
