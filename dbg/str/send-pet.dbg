     7610   varpgscales-pref  = ?.
     7611   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7612     (input  'scpgpref':u
     7613     ,input  '':u
     7614     ,input  '':u
     7615     ,input  0
     7616     ,input  '':u
     7617     ,input  '':u
     7618     ,input  '':u
     7619     ,input  no
     7620     ,output varpgscales-pref
     7621     ,output varpgscales-pref-type52
     7622     ) no-error .
     7623   if varpgscales-pref = ? then do:
     7624     assign
     7625     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     7626   end.
     7627   define variable callpoint                    as character      no-undo .
     7628   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7629   PROCEDURE asc-gds.
     7630   DEFINE parameter buffer loc-goods for gds-list.
     7631   DEFINE parameter buffer loc-bar-code for ub.bar-code.
     7632   DEFINE parameter buffer loc-gds-prt-root for ub.gds-prt.
     7633   DEFINE parameter buffer loc-gds-obj for ub.gds-obj.
     7634   DEFINE parameter buffer loc-price-list for ub.price-list.
     7635   DEFINE parameter buffer loc-units for ub.units.
     7636   DEFINE parameter buffer loc-gds-prt-term for ub.gds-prt.
     7637   DEFINE input parameter loc-prod-bc like ub.prod-bc.b-str.
     7638   DEFINE input parameter loc-bc-on-type like ub.prod-bc.bc-on-type.
     7639   DEFINE input parameter loc-bc-units-cli-type like ub.units.type.
     7640   DEFINE input parameter loc-bc-units-okei like ub.units.okei.
     7641   define input parameter parhost-code like ub.sysconf.host-code no-undo .
     7642   define input parameter parobj-type like ub.clients.obj-type no-undo .
     7643   define input parameter parobj-code like ub.clients.obj-code no-undo .
     7644   define variable v-doc-num like ub.price-list.doc-num no-undo .
     7645   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     7646   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     7647   define variable v-disc-price-sale as decimal no-undo .
     7648   define variable v-pdf-id as integer no-undo .
     7649   define variable v-pdf-db-num as integer no-undo .
     7650   define variable v-oss as character no-undo.
     7651   define variable v-gtd as character no-undo .
     7652   define variable v-is-gas as character no-undo .
     7653   define variable v-ban-bonus as character no-undo .
     7654   define variable v-ptrl-as-good as character no-undo .
     7655   define variable v-type as character no-undo .
     7656   define variable disc-b-code as integer no-undo .
     7657   define variable v-main-prt-b-code as integer no-undo .
     7658   define variable IBM-good-code as character no-undo .
     7659   define variable IBM-good-code-2 as character no-undo .
     7660   define variable IBM2-short      as character no-undo .
     7661   define variable v-gds-null-price as character no-undo .
     7662   define variable iii as integer no-undo .
     7663   define variable v-mask-full as character no-undo .
     7664   define variable v-mask-short as character no-undo .
     7665   define variable vKKT as integer no-undo.
     7666   define variable attrValue as character no-undo.
     7667   define variable attrType  as character no-undo.
     7668   DEFine BUFFER BUF_BAR-CODE FOR UB.BAR-CODE.
     7669   define buffer buf_price-list for ub.price-list.
     7670   define buffer buf_price-doc-forming-gds FOR UB.PRICE-doc-forming-gds.
     7671   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
     7672   define buffer main-prt-bar-code  for ub.bar-code.
     7673   define buffer buf_goods-attr for goods-attr.
     7674   define buffer b-code for code.
     7675   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     7676   start-paket = no.
     7677   if not avail cash-gds then do:
     7678   create cash-gds.
     7679   error-status:error = false.
     7680   end.
     7681   cash-gds.crf = cr + 1.
     7682   cr = cr + 1.
     7683   if loc-bar-code.in-code <> ''
     7684   or loc-bar-code.part-code <> ''
     7685   then do:
     7686     find first main-prt-bar-code no-lock where
     7687               main-prt-bar-code.gds-code = loc-goods.gds-code
     7688           and main-prt-bar-code.node-code = loc-bar-code.node-code
     7689           and main-prt-bar-code.unit-cli = loc-bar-code.unit-cli
     7690           and main-prt-bar-code.part-code = ''
     7691           and main-prt-bar-code.in-code = '' no-error.
     7692     if available main-prt-bar-code then do:
     7693       v-main-prt-b-code = main-prt-bar-code.b-code.
     7694     end.
     7695   end.
     7696   else do:
     7697     v-main-prt-b-code = loc-bar-code.b-code.
     7698   end.
     7699   find first tt-tax no-lock where
     7700              tt-tax.tax-code = vattaxcd no-error .
     7701   do iii = 1 to num-entries(mask_s-c) :
     7702     assign
     7703       v-mask-full  = trim(entry(iii, mask_s-c))
     7704       v-mask-short = entry(1, v-mask-full, "*")
     7705       loc-prod-bc  = trim(loc-prod-bc)
     7706     .
     7707     if length(v-mask-full) = length(loc-prod-bc) and  substring(loc-prod-bc, 1, length(v-mask-short)) = v-mask-short then
     7708       loc-prod-bc = "*" + substring(loc-prod-bc, length(v-mask-short) + 1).
     7709   end.
     7710   define variable vBc-on as logical no-undo.
     7711   if loc-prod-bc ne ?
     7712   then do:
     7713       find first prod-bc where prod-bc.b-code eq loc-bar-code.b-code
     7714                            and prod-bc.b-str  eq loc-prod-bc
     7715                            no-lock no-error.
     7716       if available prod-bc
     7717       then
     7718          vBc-on = prod-bc.bc-on.
     7719       else
     7720          vBc-on = yes.
     7721   end.
     7722   else
     7723      vBc-on = yes.
     7724   run gdsoattr-value in this-procedure (
     7725     'dt-seasons':U,
     7726     loc-goods.gds-code,
     7727     parobj-type,
     7728     parobj-code,
     7729     output attrValue,
     7730     output attrType
     7731   ) no-error.
     7732   if attrValue <> "" then do:
     7733     find first b-code where
     7734                b-code.parent = "DTSeasons"
     7735            and b-code.code   = attrValue
     7736          no-lock no-error.
     7737     v-main-prt-b-code = integer(b-code.code).
     7738   end.
     7739   else release b-code.
     7740   assign
     7741   cash-gds.gds-code = loc-goods.gds-code
     7742   cash-gds.artic = loc-goods.artic
     7743   cash-gds.b-code = loc-bar-code.b-code
     7744   cash-gds.main-prt-b-code = v-main-prt-b-code
     7745   cash-gds.b-str = if loc-prod-bc = ? then "" else loc-prod-bc
     7746   cash-gds.bc-on-type = loc-bc-on-type
     7747   cash-gds.bc-on = vBc-on
     7748   cash-gds.unit-cli = loc-bar-code.unit-cli
     7749   cash-gds.cli-base-rate = loc-bar-code.cli-base-rate
     7750   cash-gds.std-discnt-rule = std-discnt-rule_
     7751   cash-gds.gds-namelong = loc-goods.gds-name
     7752   cash-gds.gds-name = IF nam-2str
     7753                       then if available b-code then b-code.codename else loc-goods.gds-name
     7754                       else (
     7755                             IF nam-artc
     7756                             then loc-goods.artic
     7757                             else if available b-code
     7758                                  then b-code.codename
     7759                                  else (if loc-goods.chk-name <> ""
     7760                                        then loc-goods.chk-name
     7761                                        else loc-goods.gds-name)
     7762                            )
     7763   cash-gds.f-name = if NOT l-empty-scale then loc-gds-prt-term.f-name else ""
     7764   cash-gds.unit-base = loc-goods.unit-base
     7765   cash-gds.grp-code = for-grp-code
     7766   cash-gds.fp = for-fp
     7767   cash-gds.ingredient = loc-goods.struct
     7768   cash-gds.producer = for-producer
     7769   cash-gds.producer-int = for-producer-int
     7770   cash-gds.alpha1     = loc-goods.alpha1.
     7771     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7772                                            ,input 'office-type':U
     7773                                            ,output v-oss
     7774                                            ,output v-type) no-error.
     7775   cash-gds.office-type = v-oss.
     7776     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7777                                            ,input 'type-method-calc':U
     7778                                            ,output v-oss
     7779                                            ,output v-type) no-error.
     7780   if v-oss <> "" then
     7781     assign
     7782       cash-gds.CalculationMethod = int(entry(1,v-oss,","))
     7783       cash-gds.CalculationMethodRestr = if num-entries(v-oss,",") > 1 then int(entry(2,v-oss,",")) else 0
     7784     .
     7785   else
     7786     assign
     7787       cash-gds.CalculationMethod = 0
     7788       cash-gds.CalculationMethodRestr = 0
     7789     .
     7790   assign
     7791   cash-gds.fact-qnty = for-fact-qnty
     7792   cash-gds.okei = loc-bc-units-okei
     7793   cash-gds.kat-discnt-method = kat-discnt-method_
     7794   cash-gds.temp-discnt-method = temp-discnt-method_
     7795   cash-gds.kat-discnt-rule = (if how-pcnt-kat = 'pcnt-kat-pdf':U
     7796                                then  kat-discnt-rule_pdf
     7797                                else  kat-discnt-rule_)
     7798   cash-gds.date-discnt-rule = date-discnt-rule_
     7799   cash-gds.abs-discnt-rule = abs-discnt-rule_
     7800   cash-gds.tot-discnt-rule = tot-discnt-rule_
     7801   cash-gds.wgd-rule = for-wgd
     7802   cash-gds.gds-stat = ( if lookup( 'вес':U, loc-bc-units-cli-type ) > 0 OR lookup('дро':U, loc-bc-units-cli-type) > 0
     7803                           then 1
     7804                           else 0)
     7805   cash-gds.gds-stat = (if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0)
     7806                        or for-petrol-purse
     7807                        then (cash-gds.gds-stat + 8)
     7808                        else cash-gds.gds-stat)
     7809   cash-gds.gds-stat = if (loc-goods.gds-type = 'у':U and (cash-gds.gds-stat < 8 or for-petrol-purse))
     7810                       then (cash-gds.gds-stat + 16)
     7811                       else cash-gds.gds-stat
     7812   cash-gds.gds-stat = if cash-gds.fp
     7813                       then (cash-gds.gds-stat + 2)
     7814                       else cash-gds.gds-stat
     7815   cash-gds.gds-stat = if cash-gds.wgd-rule > 0
     7816                       then (cash-gds.gds-stat + 128)
     7817                       else cash-gds.gds-stat
     7818   cash-gds.office = if loc-goods.gds-type = 'у':U then 1 else 0
     7819   cash-gds.temp-discnt-rule = (if how-temp-disc = 'temp-disc-pdf':U
     7820                                then temp-discnt-rule_pdf
     7821                                else temp-discnt-rule_)
     7822   cash-gds.wd-rule = for-wd
     7823   cash-gds.pp = (if for-petrol-purse then 1 else 0)
     7824   cash-gds.need-auth = (if need-auth then 1 else 0)
     7825   cash-gds.price-sale =  for-price
     7826   cash-gds.unit-type = loc-units.type
     7827   cash-gds.unit-cli-type = loc-bc-units-cli-type
     7828   cash-gds.tax-string = tax-string
     7829   cash-gds.new-good = new-good
     7830   cash-gds.rc = recid(loc-goods)
     7831   cash-gds.qnty-discnt-rule = qnty-discnt-rule_
     7832   cash-gds.vat-pc = (if avail tt-tax
     7833                      then tt-tax.rate-value
     7834                      else 0)
     7835   cash-gds.vat-code = (if avail tt-tax
     7836                        then tt-tax.rate-code
     7837                        else ?)
     7838   cash-gds.is-menu  = (if v-is-menu then 1 else 0)
     7839   cash-gds.is-semi-finished = (if v-is-semi-finished then 1 else 0)
     7840   cash-gds.is-modificator = (if v-is-modificator then 1 else 0)
     7841   cash-gds.fbr-grp-code = v-fbr-grp-code
     7842   cash-gds.fbr-grp-code-0 = loc-goods.fbr-grp-code
     7843   cash-gds.DepartID = v-fbr-obj-code
     7844   cash-gds.zp = (if v-is-null-price then 1 else 0)
     7845   cash-gds.node-code = loc-bar-code.node-code
     7846   cash-gds.taracode = for-taracode
     7847   cash-gds.is-main-code = (if cash-gds.b-str = ""
     7848                            and loc-bar-code.in-code = ""
     7849                            and loc-bar-code.part-code = ""
     7850                            and cash-gds.unit-base = cash-gds.unit-cli
     7851                            then yes
     7852                            else no)
     7853   cash-gds.obj-type = parobj-type
     7854   cash-gds.obj-code = parobj-code
     7855   .
     7856   assign
     7857   cash-gds.gds-name1 =   name-2cdf(
     7858                         input name-2cd
     7859                       , input yes
     7860                       , input cod-pcod
     7861                       , input cash-gds.b-code
     7862                       , input loc-goods.gds-code
     7863                       , input loc-goods.artic
     7864                       , input loc-goods.engl-name
     7865                       , input loc-bar-code.in-code
     7866                       , input loc-bar-code.part-code
     7867                       , input parobj-type
     7868                       , input parobj-code
     7869                       , input loc-goods.alpha1
     7870                       , output v-gtd
     7871                       )
     7872   cash-gds.gtd   = v-gtd
     7873   .
     7874   vKKT = 255.
     7875   find first b-code where
     7876              b-code.parent  = "okei-kkt"
     7877          and b-code.code    = string(cash-gds.okei)
     7878          and b-code.status_ = 0
     7879   no-lock no-error.
     7880   if avail b-code then
     7881      vKKT = integer(b-code.CodeName) no-error.
     7882   if error-status:error then vKKT = 255.
     7883   cash-gds.kkt = vKKT.
     7884   if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0) then do:
     7885      run gds-attr-value in this-procedure  (
     7886                                             input cash-gds.gds-code
     7887                                            ,input 'fuel-type':U
     7888                                            ,output v-is-gas
     7889                                            ,output v-type) no-error.
     7890      run gds-attr-value in this-procedure  (
     7891                                             input cash-gds.gds-code
     7892                                            ,input 'ptrl-as-good':U
     7893                                            ,output v-ptrl-as-good
     7894                                            ,output v-type) no-error.
     7895      assign
     7896      cash-gds.ptrl-as-good = logical(v-ptrl-as-good)
     7897      no-error .
     7898      assign
     7899      cash-gds.is-gas = (v-is-gas = 'metan':U)
     7900      no-error .
     7901      if cash-gds.is-gas then do:
     7902        cash-gds.gds-stat = cash-gds.gds-stat + 64.
     7903      end.
     7904   end.
     7905      run gds-attr-value in this-procedure  (
     7906                                             input cash-gds.gds-code
     7907                                            ,input 'ban-bonus':U
     7908                                            ,output v-ban-bonus
     7909                                            ,output v-type) no-error.
     7910     assign
     7911      cash-gds.wd = int(logical(v-ban-bonus))
     7912      no-error .
     7913   if how-temp-disc = 'temp-disc':U then do:
     7914     case temp-discnt-method_:
     7915       when "" then do:
     7916       end.
     7917       when "bar-code.b-code" then do:
     7918         if loc-bar-code.in-code <> ''
     7919         or loc-bar-code.part-code <> ''
     7920         then do:
     7921           disc-b-code = cash-gds.main-prt-b-code.
     7922         end.
     7923         else do:
     7924           disc-b-code = cash-gds.b-code.
     7925         end.
     7926         find first buf_temp-dis-gds-rule where
     7927                 buf_temp-dis-gds-rule.gds-code = cash-gds.gds-code
     7928             and buf_temp-dis-gds-rule.nonunique = string( disc-b-code) no-error.
     7929         if available buf_temp-dis-gds-rule then do:
     7930             cash-gds.temp-discnt-rule = buf_temp-dis-gds-rule.rule-num.
     7931         end.
     7932       end.
     7933       otherwise do:
     7934         cash-gds.temp-discnt-rule = 0.
     7935       end.
     7936     end.
     7937   end.
     7938   assign
     7939   cash-gds.gds-name1 =   name-2cdf(
     7940                         input name-2cd
     7941                       , input yes
     7942                       , input cod-pcod
     7943                       , input cash-gds.b-code
     7944                       , input loc-goods.gds-code
     7945                       , input loc-goods.artic
     7946                       , input loc-goods.engl-name
     7947                       , input loc-bar-code.in-code
     7948                       , input loc-bar-code.part-code
     7949                       , input parobj-type
     7950                       , input parobj-code
     7951                       , input loc-goods.alpha1
     7952                       , output v-gtd
     7953                       )
     7954   cash-gds.gtd   = v-gtd
     7955   .
     7956   assign
     7957   cash-gds.ean-lz = ''
     7958   cash-gds.ean-rz = ''
     7959   cash-gds.code-short = ''
     7960   .
     7961   run ibm-gdsc in this-procedure (input no
     7962                                 , output cash-gds.ean-lz
     7963                                 , output cash-gds.ean-rz
     7964                                 , output cash-gds.code-short
     7965                                 ) no-error .
     7966   if new-good then new-good = not new-good.
     7967   if action = "U" then do:
     7968     if cash-gds.kat-discnt-rule <> 0
     7969     and how-pcnt-kat = 'pcnt-kat-pdf':U
     7970     then do:
     7971       for each cash-dis-rule no-lock where
     7972             cash-dis-rule.upper-rule-num = cash-gds.kat-discnt-rule
     7973       :
     7974         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     7975                                             ,input 'маг':U
     7976                                             ,input i-obj-code
     7977                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     7978                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     7979                                             ,input ?
     7980                                             ,output v-disc-price-sale
     7981                                             ,output v-pdf-id
     7982                                             ,output v-pdf-db-num ) no-error.
     7983         if error-status:error
     7984         or v-disc-price-sale = 0
     7985         or v-disc-price-sale = ?
     7986         then do:
     7987         end.
     7988         else do:
     7989           find first  cash-gds-discnt where
     7990                     cash-gds-discnt.b-code = cash-gds.b-code
     7991                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7992                   and cash-gds-discnt.obj-type = parobj-type
     7993                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     7994           if not available cash-gds-discnt then do:
     7995             find first  cash-gds-discnt where
     7996                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     7997             if not available cash-gds-discnt then do:
     7998               create cash-gds-discnt.
     7999               assign
     8000               cash-gds-discnt.crf = crgd + 1.
     8001             end.
     8002             crgd = crgd + 1.
     8003             assign
     8004             cash-gds-discnt.b-code = cash-gds.b-code
     8005             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8006             cash-gds-discnt.obj-type = parobj-type
     8007             cash-gds-discnt.obj-code = parobj-code
     8008             cash-gds-discnt.discnt-value = v-disc-price-sale
     8009             .
     8010             release cash-gds-discnt.
     8011           end.
     8012         end.
     8013       end.
     8014     end.
     8015     if cash-gds.temp-discnt-rule <> 0
     8016     and how-temp-disc = 'temp-disc-pdf':U
     8017     then do:
     8018       for each cash-dis-rule no-lock where
     8019             (cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule
     8020         or cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     8021         and cash-dis-rule.is-term = yes
     8022       :
     8023         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8024                                             ,input 'маг':U
     8025                                             ,input i-obj-code
     8026                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8027                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8028                                             ,input ?
     8029                                             ,output v-disc-price-sale
     8030                                             ,output v-pdf-id
     8031                                             ,output v-pdf-db-num ) no-error.
     8032         if error-status:error
     8033         or v-disc-price-sale = 0
     8034         or v-disc-price-sale = ?
     8035         then do:
     8036         end.
     8037         else do:
     8038           find first  cash-gds-discnt where
     8039                     cash-gds-discnt.b-code = cash-gds.b-code
     8040                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8041                   and cash-gds-discnt.obj-type = parobj-type
     8042                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8043           if not available cash-gds-discnt then do:
     8044             find first  cash-gds-discnt where
     8045                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8046             if not available cash-gds-discnt then do:
     8047               create cash-gds-discnt.
     8048               assign
     8049               cash-gds-discnt.crf = crgd + 1.
     8050             end.
     8051             crgd = crgd + 1.
     8052             assign
     8053             cash-gds-discnt.b-code = cash-gds.b-code
     8054             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8055             cash-gds-discnt.obj-type = parobj-type
     8056             cash-gds-discnt.obj-code = parobj-code
     8057             cash-gds-discnt.discnt-value = v-disc-price-sale.
     8058             release cash-gds-discnt.
     8059           end.
     8060         end.
     8061       end.
     8062     end.
     8063   end.
