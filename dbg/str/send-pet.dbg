    11600                                 , gds-list.artic
    11601                                 , gds-list.prod-type
    11602                                 , gds-list.prod-code
    11603                                 )
    11604                                   ).
    11605         assign
    11606         v-view-log = yes
    11607         .
    11608         if g#news then return error.
    11609       end.
    11610       ACCUMULATE gds-list.artic (COUNT).
    11611       delete gds-list.
    11612   END .
    11613   RUN SENDING no-error.
    11614   if error-status:error then do:
    11615     run write-log-and-file in p-log-handle (
    11616           input 1
    11617         , input log-file-name
    11618         , input 1
    11619         , input substitute( "!!!Ошибки при отсылке конфигурации АЗС на кассы &1&2"
    11620                            , p-obj-type, i-obj-code
    11621                           )
    11622                                           ).
    11623     assign
    11624     v-view-log = yes
    11625     .
    11626   end.
    11627   if v-view-log then return error .
    11628     finally :
    11629       run write-log-and-file in p-log-handle (
    11630           input 1
    11631         , input log-file-name
    11632         , input 1
    11633         , input substitute("&1", chr(10))
    11634       ).
    11635       define variable v-save-file-name as character no-undo .
    11636       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
    11637       OS-APPEND value(log-file-name) value(v-save-file-name).
    11638       OS-DELETE value(log-file-name).
    11639     end finally .
