    11579                  ub.gds-obj.artic = gds-list.artic AND
    11580                  ub.gds-obj.prod-type = gds-list.prod-type AND
    11581                  ub.gds-obj.prod-code = gds-list.prod-code nO-LOCK NO-ERROR.
    11582       if g#news and not avail gds-obj then NEXT.
    11583       if not g#news then do:
    11584         if v-count modulo 10 = 0 then do:
    11585           run show-counter in p-log-handle .
    11586           run write-counter in p-log-handle (substitute("Обработано: &1. Подготовка данных - товар &2 &3&4"
    11587                                              , v-count
    11588                                              , gds-list.artic
    11589                                              , gds-list.prod-type
    11590                                              , gds-list.prod-code)) no-error.
    11591         end.
    11592       end.
    11593       RUN term-prt( ub.gds-prt.prt-root, ?) no-error.
