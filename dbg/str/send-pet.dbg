     6130   procedure fact-order-mpl :
     6131     do
     6132     on error undo, return error return-value
     6133     :
     6134   define input  parameter p-doc-date as date     no-undo .
     6135   define input  parameter p-obj-type as character no-undo .
     6136   define input  parameter p-obj-code as integer   no-undo .
     6137   define output parameter p-fact-order as decimal   no-undo .
     6138   define variable v-fact-date            as date    no-undo .
     6139   define variable v-fact-time            as integer no-undo .
     6140   define variable v-fact-order           as decimal no-undo .
     6141   define variable v-shift-end-fact-order as decimal no-undo .
     6142   define variable v-day-end-fact-order   as decimal no-undo .
     6143   define variable l-shift-on as logical no-undo .
     6144   define variable l-date as date      no-undo .
     6145   define variable l-time as integer   no-undo .
     6146   define variable shift-date as date      no-undo .
     6147   define variable shift-num  as integer   no-undo .
     6148   define variable shift-name as character no-undo .
     6149   define variable max-fact-order as decimal   no-undo .
     6150   define buffer buf_global-state for ub.global-state  .
     6151   find first buf_global-state no-lock no-error .
     6152   if not available buf_global-state then do:
     6153      message
     6154        "Не заданы параметры ценообразования!"
     6155        view-as alert-box error
     6156      .
     6157      return error return-value .
     6158   end.
     6159     run cur-time in this-procedure
     6160     ( output v-fact-date ,
     6161       output v-fact-time  ).
     6162   if p-doc-date = ? then do:
     6163   if buf_global-state.pl-use-sys-date-time  = true then do:
     6164         run factord in this-procedure
     6165           (input  v-fact-date
     6166           ,input  v-fact-time
     6167           ,input  v-fact-time
     6168           ,input  ?
     6169           ,input  ?
     6170           ,input  false
     6171           ,output v-fact-order
     6172           ,output v-shift-end-fact-order
     6173           ,output v-day-end-fact-order
     6174           ) no-error .
     6175         if error-status :error
     6176         or v-fact-order = ?
     6177         or v-fact-order = 0 then do:
     6178           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6179         end.
     6180         p-fact-order = v-fact-order .
     6181   end.
     6182   else do:
     6183   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6184   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6185     (input  p-obj-type
     6186     ,input  p-obj-code
     6187     ,input  'shift-on=request'
     6188     ,output l-shift-on
     6189     ) no-error .
     6190         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6191         if p-doc-date <> ? then do:
     6192         end.
     6193          run gbl/factdate.p
     6194          ( input        p-obj-type  ,
     6195            input        p-obj-code  ,
     6196            input-output v-fact-date ,
     6197            input-output v-fact-time ,
     6198            input-output shift-date      ,
     6199            input-output shift-num       ,
     6200            input-output shift-name      ,
     6201            input        yes
     6202            ) no-error .
     6203         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6204         run factord in this-procedure
     6205           (input  v-fact-date
     6206           ,input  v-fact-time
     6207           ,input  v-fact-time
     6208           ,input  shift-date
     6209           ,input  shift-num
     6210           ,input  l-shift-on
     6211           ,output v-fact-order
     6212           ,output v-shift-end-fact-order
     6213           ,output v-day-end-fact-order
     6214           ) no-error .
     6215         if error-status :error
     6216         or v-fact-order = ?
     6217         or v-fact-order = 0 then do:
     6218           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6219         end.
     6220         p-fact-order = v-fact-order .
     6221   end.
     6222   end.
     6223   else do:
     6224          run gbl/factdate.p
     6225          ( input        p-obj-type  ,
     6226            input        p-obj-code  ,
     6227            input-output v-fact-date ,
     6228            input-output v-fact-time ,
     6229            input-output shift-date      ,
     6230            input-output shift-num       ,
     6231            input-output shift-name      ,
     6232            input        yes
     6233            ) no-error .
     6234         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6235         v-fact-date = p-doc-date .
     6236         run factord in this-procedure
     6237           (input  v-fact-date
     6238           ,input  v-fact-time
     6239           ,input  v-fact-time
     6240           ,input  shift-date
     6241           ,input  shift-num
     6242           ,input  l-shift-on
     6243           ,output v-fact-order
     6244           ,output v-shift-end-fact-order
     6245           ,output v-day-end-fact-order
     6246           ) no-error .
     6247         if error-status :error
     6248         or v-fact-order = ?
     6249         or v-fact-order = 0 then do:
     6250           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6251         end.
     6252         p-fact-order = v-fact-order .
     6253   end.
     6254     end.
     6255   end procedure.
