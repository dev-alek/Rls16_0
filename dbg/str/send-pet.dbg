     4762   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4763   PROCEDURE cd-mrkt_plu-marketer :
     4764   define input parameter p-silence as logical no-undo .
     4765   define parameter buffer buf_cash-desk for ub.cash-desk.
     4766   define input parameter p-id as character no-undo .
     4767   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     4768   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     4769   define input parameter p-loc-ean as logical no-undo .
     4770   define input parameter p-is-petrolium as logical no-undo .
     4771   define input parameter p-extra as character no-undo .
     4772   define variable v-tot-gds as integer no-undo .
     4773   define variable v-max-gds as integer no-undo .
     4774   define variable v-petrol-start as integer no-undo .
     4775   define variable v-petrol-range as integer no-undo .
     4776   DEFINE VARIABLE v-today as date no-undo .
     4777   DEFINE VARIABLE v-time as integer no-undo .
     4778   define variable v-plu-type as character no-undo .
     4779   define variable v-int as integer no-undo .
     4780   define buffer  buf_cd-plu for ub.cd-plu.
     4781   define buffer  loc_cd-plu for ub.cd-plu.
     4782   define variable  ii as integer no-undo.
     4783   define variable v-mes as character no-undo .
     4784   _main:
     4785   DO ON ERROR undo, leave on stop undo, leave:
     4786     if buf_cash-desk.pos-type <> 'MARIA':U
     4787     or buf_cash-desk.cash-num <> 0 then do:
     4788       assign
     4789       v-mes =
     4790       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     4791                 , buf_cash-desk.pos-type).
     4792       if not p-silence then
     4793       message
     4794       v-mes
     4795       view-as alert-box error .
     4796       return error v-mes.
     4797     end.
     4798     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4799                                     ,input 'MARIA_operative':U
     4800                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4801                                           and p-is-petrolium
     4802                                           then 'tot-petrol':U
     4803                                           else 'tot-gds':U)
     4804                                     , output v-mes).
     4805     if v-tot-gds = ? then undo _main, return error v-mes.
     4806     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4807                                     ,input 'MARIA_general':U
     4808                                     ,input 'max-gds':U
     4809                                     ,output v-mes).
     4810     if v-max-gds = ? then undo _main, return error v-mes.
     4811     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     4812                                          ,input 'petrolium-range':U
     4813                                          ,input 'petrolium-range':U
     4814                                          ,output v-mes).
     4815     if v-petrol-range = ? then undo _main, return error v-mes.
     4816     if buf_cash-desk.pos-type = 'MARIA':U then do:
     4817       assign
     4818       v-petrol-start = 1
     4819       v-max-gds = (if p-is-petrolium
     4820                    then v-petrol-range
     4821                    else v-max-gds)
     4822       v-plu-type = (if p-is-petrolium
     4823                  then 'топ':U
     4824                  else '':U)
     4825       .
     4826       if p-is-petrolium then do:
     4827         if p-id = '':U then do:
     4828           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     4829                               "Невозможно привязать к кассе типа &3"
     4830                               , p-b-str
     4831                               , chr(10)
     4832                               , 'MARIA':U).
     4833           if not p-silence then
     4834           message
     4835           v-mes
     4836           view-as alert-box error .
     4837           return error v-mes.
     4838         end.
     4839         assign
     4840         v-int = integer(p-id)
     4841         no-error
     4842         .
     4843         if error-status:error
     4844         or v-int > v-petrol-range then do:
     4845           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     4846                               "в диапазоны номеров резервуаров для кассы типа &4"
     4847                               , p-id
     4848                               , p-b-str
     4849                               , chr(10)
     4850                               , 'MARIA':U).
     4851           if not p-silence then
     4852           message
     4853           v-mes
     4854           view-as alert-box error .
     4855           return error v-mes.
     4856         end.
     4857       end.
     4858     end.
     4859     if buf_cash-desk.pos-type = 'MARIA':U
     4860     and p-is-petrolium then do:
     4861       find first loc_cd-plu where
     4862                loc_cd-plu.obj-type = 'маг':U
     4863            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     4864            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     4865            and loc_cd-plu.plu-type = 'топ':U
     4866      no-error .
     4867      if available loc_cd-plu then do:
     4868        if loc_cd-plu.b-code = p-b-code
     4869        and loc_cd-plu.b-str = p-b-str then do:
     4870           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     4871                               , p-id
     4872                               , p-b-str
     4873                               , chr(10)
     4874                               ).
     4875           if not p-silence then
     4876           message
     4877           v-mes
     4878           view-as alert-box WARNING .
     4879           return v-mes.
     4880        end.
     4881        else do:
     4882           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     4883                               "нельзя его привязать к топливу &2&3"
     4884                               , p-id
     4885                               , loc_cd-plu.b-str
     4886                               , chr(10)
     4887                               , p-b-str).
     4888           if not p-silence then
     4889           message
     4890           v-mes
     4891           view-as alert-box error .
     4892           return error v-mes.
     4893        end.
     4894      end.
     4895      ii = v-int.
     4896     end.
     4897     else do:
     4898       DO ii = (if p-is-petrolium
     4899               then v-petrol-start
     4900               else (if buf_cash-desk.pos-type = 'MARIA':U
     4901                    then 1
     4902                    else (if v-petrol-start = 1
     4903                           then (v-petrol-range + 1)
     4904                           else 1)
     4905                   )
     4906               )
     4907         to v-max-gds :
     4908         if not can-find (loc_cd-plu where
     4909                         loc_cd-plu.obj-type = 'маг':U
     4910                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4911                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4912                      and loc_cd-plu.plu-type = v-plu-type
     4913                      and loc_cd-plu.plu-code = ii
     4914                       )
     4915         then LEAVE .
     4916       END .
     4917     end.
     4918     if ii > v-max-gds then do:
     4919         if not p-silence then
     4920         message
     4921         substitute("Превышено максимально допустимое количество &5 &1" +
     4922                   "для касс &2 &3&4"
     4923                   , chr(10)
     4924                   , v-max-gds
     4925                   , 'маг':U
     4926                   , buf_cash-desk.obj-code
     4927                   , (if p-is-petrolium then "топлив" else "товаров")
     4928                   )
     4929         view-as alert-box ERROR .
     4930         undo, return error "max-gds":U.
     4931     end.
     4932     DO ii = (if p-is-petrolium
     4933              then v-petrol-start
     4934              else (if v-petrol-start = 1
     4935                    then (v-petrol-range + 1)
     4936                    else 1)
     4937              )
     4938        to v-max-gds :
     4939       if not can-find (loc_cd-plu where
     4940                         loc_cd-plu.obj-type = 'маг':U
     4941                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4942                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4943                      and loc_cd-plu.plu-type = v-plu-type
     4944                      and loc_cd-plu.plu-code = ii
     4945                      )
     4946       then LEAVE .
     4947     END .
     4948     if ii > v-max-gds then do:
     4949         if not p-silence then
     4950         message
     4951         substitute("Превышено максимально допустимое количество &5 &1" +
     4952                   "для касс &2 &3&4"
     4953                   , chr(10)
     4954                   , v-max-gds
     4955                   , 'маг':U
     4956                   , buf_cash-desk.obj-code
     4957                   , (if p-is-petrolium then "топлив" else "товаров")
     4958                   )
     4959         view-as alert-box ERROR .
     4960         undo, return error "max-gds":U.
     4961     end.
     4962     run cur-time in this-procedure ( output v-today, output v-time).
     4963     create buf_cd-plu.
     4964     assign
     4965     buf_cd-plu.b-code = p-b-code
     4966     buf_cd-plu.b-str = p-b-str
     4967     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     4968                                         then buf_cash-desk.addr-path
     4969                                         else "U":U)
     4970     buf_cd-plu.to-send = yes
     4971     buf_cd-plu.charkey_one = "":U
     4972     buf_cd-plu.to-del = no
     4973     buf_cd-plu.plu-code = ii
     4974     buf_cd-plu.obj-type = 'маг':U
     4975     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     4976     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     4977     buf_cd-plu.plu-type = v-plu-type
     4978     buf_cd-plu.logkey_one = p-loc-ean
     4979     buf_cd-plu.key#_one = integer(p-extra)
     4980     .
     4981     run cd-attr-write  in this-procedure (
     4982                                           input   buf_cash-desk.db-num
     4983                                           ,input  buf_cash-desk.obj-code
     4984                                           ,input  buf_cash-desk.pos-type
     4985                                           ,input  buf_cash-desk.cash-num
     4986                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     4987                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4988                                                 and p-is-petrolium
     4989                                                 then 'tot-petrol':U
     4990                                                 else 'tot-gds':U)
     4991                                           ,input ''
     4992                                           ,input ?
     4993                                           ,input 0.0
     4994                                           ,input  (v-tot-gds + 1)
     4995                                           ,input no
     4996                                          ) no-error .
     4997     if error-status:error then do:
     4998       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     4999                          ,buf_cash-desk.cash-num
     5000                          , 'маг':U
     5001                          ,buf_cash-desk.obj-code
     5002                          , chr(10)
     5003                          , error-status:get-message(1)
     5004                          , return-value
     5005                          ).
     5006       if not p-silence then
     5007       message
     5008       v-mes
     5009       view-as alert-box error .
     5010       undo _main, return error v-mes.
     5011     end.
     5012     run cd-attr-write  in this-procedure (
     5013                                           input   buf_cash-desk.db-num
     5014                                           ,input  buf_cash-desk.obj-code
     5015                                           ,input  buf_cash-desk.pos-type
     5016                                           ,input  buf_cash-desk.cash-num
     5017                                           ,input  'MARIA_operative':U
     5018                                           ,input  'to-send':U
     5019                                           ,input ''
     5020                                           ,input ?
     5021                                           ,input 0.0
     5022                                           ,input 0
     5023                                           ,input yes
     5024                                          ) no-error .
     5025     if error-status:error then do:
     5026       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5027                          ,buf_cash-desk.cash-num
     5028                          , 'маг':U
     5029                          ,buf_cash-desk.obj-code
     5030                          , chr(10)
     5031                          , error-status:get-message(1)
     5032                          , return-value
     5033                          ).
     5034       if not p-silence then
     5035       message
     5036       v-mes
     5037       view-as alert-box error .
     5038       undo _main, return error v-mes.
     5039     end.
     5040     return "":U.
     5041   end.
     5042   END PROCEDURE.
     5043   procedure cd-mrkt_update-marketer :
     5044   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5045   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5046   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5047   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5048   define input parameter p-is-petrolium as logical no-undo .
     5049   define variable v-to-send as logical no-undo .
     5050   define variable v-tot-gds as integer no-undo .
     5051   define variable v-max-plu as integer no-undo .
     5052   define buffer buf_cd-plu for ub.cd-plu.
     5053   define variable v-plu-type as character no-undo .
     5054     do
     5055     on error undo, return error
     5056     :
     5057       v-to-send = no.
     5058       v-tot-gds = 0.
     5059       assign
     5060       v-plu-type = (if p-is-petrolium
     5061                     then  'топ':U
     5062                     else '':U
     5063                 )
     5064       .
     5065       FOR EACH buf_cd-plu WHERE
     5066              buf_cd-plu.obj-type = 'маг':U
     5067         and  buf_cd-plu.obj-code = p-obj-code
     5068         and  buf_cd-plu.pos-type = p-pos-type
     5069         and  buf_cd-plu.plu-type = v-plu-type
     5070             :
     5071         if  buf_cd-plu.to-del
     5072         or  buf_cd-plu.to-send then do:
     5073           assign
     5074           v-to-send = yes.
     5075         end.
     5076         assign
     5077         v-tot-gds = v-tot-gds + 1.
     5078       end.
     5079       run cd-attr-write  in this-procedure (
     5080                                               input   p-db-num
     5081                                               ,input  p-obj-code
     5082                                               ,input  p-pos-type
     5083                                               ,input  p-cash-num
     5084                                               ,input  'MARIA_operative':U
     5085                                               ,input  (if p-pos-type = 'MARIA':U
     5086                                                        and p-is-petrolium
     5087                                                        then  'tot-petrol':U
     5088                                                        else 'tot-gds':U)
     5089                                               ,input ''
     5090                                               ,input ?
     5091                                               ,input 0.0
     5092                                               ,input v-tot-gds
     5093                                               ,input no
     5094                                                                                           ) no-error .
     5095       if error-status:error then do:
     5096           UNDO, RETURN ERROR RETURN-VALUE.
     5097       END.
     5098       run cd-attr-write  in this-procedure (
     5099                                               input   p-db-num
     5100                                               ,input  p-obj-code
     5101                                               ,input  p-pos-type
     5102                                               ,input  p-cash-num
     5103                                               ,input  'MARIA_operative':U
     5104                                               ,input  (if p-pos-type = 'MARIA':U
     5105                                                        and p-is-petrolium
     5106                                                        then  'petrol-to-send':U
     5107                                                        else 'to-send':U)
     5108                                               ,input ''
     5109                                               ,input ?
     5110                                               ,input 0.0
     5111                                               ,input 0
     5112                                               ,input v-to-send
     5113                                               ) no-error .
     5114       if error-status:error then do:
     5115           UNDO, RETURN ERROR RETURN-VALUE.
     5116       END.
     5117       FIND LAST buf_cd-plu NO-LOCK  WHERE
     5118                buf_cd-plu.obj-type = 'маг':U
     5119            and buf_cd-plu.obj-code = p-obj-code
     5120            and buf_cd-plu.pos-type = p-pos-type
     5121            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     5122       if available buf_cd-plu then do:
     5123         if v-max-plu < buf_cd-plu.plu-code
     5124         then
     5125         v-max-plu = buf_cd-plu.plu-code .
     5126       end.
     5127       else do:
     5128         v-max-plu = 0.
     5129       end.
     5130       run cd-attr-write  in this-procedure (
     5131                                             input   p-db-num
     5132                                             ,input  p-obj-code
     5133                                             ,input  p-pos-type
     5134                                             ,input  p-cash-num
     5135                                             ,input  'MARIA_operative':U
     5136                                             ,input  (if p-pos-type = 'MARIA':U
     5137                                                     and p-is-petrolium
     5138                                                     then 'max-petrol-plu':U
     5139                                                     else 'max-plu':U)
     5140                                               ,input ''
     5141                                               ,input ?
     5142                                               ,input 0.0
     5143                                               ,input v-max-plu
     5144                                               ,input no
     5145                                             ) no-error .
     5146       if error-status:error then do:
     5147           UNDO, RETURN ERROR RETURN-VALUE.
     5148       END.
     5149     end.
     5150   end procedure.
     5151   PROCEDURE cd-mrkt_clu-marketer :
     5152   define input parameter p-silence as logical no-undo .
     5153   define parameter buffer buf_cash-desk for ub.cash-desk.
     5154   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5155   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5156   define variable v-tot-cli as integer no-undo .
     5157   define variable v-max-cli as integer no-undo .
     5158   DEFINE VARIABLE v-today as date no-undo .
     5159   DEFINE VARIABLE v-time as integer no-undo .
     5160   define buffer  buf_cd-clu for ub.cd-clu.
     5161   define buffer  loc_cd-clu for ub.cd-clu.
     5162   define variable  ii as integer no-undo.
     5163   define variable v-mes as character no-undo .
     5164   _main:
     5165   DO ON ERROR undo, leave on stop undo, leave:
     5166     if buf_cash-desk.pos-type <> 'MARIA':U
     5167     or buf_cash-desk.cash-num <> 0 then do:
     5168       assign
     5169       v-mes =
     5170       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5171                 , buf_cash-desk.pos-type).
     5172       if not p-silence then
     5173       message
     5174       v-mes
     5175       view-as alert-box error .
     5176       return error v-mes.
     5177     end.
     5178     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5179                                     ,input 'MARIA_operative':U
     5180                                     ,input 'tot-cli':U
     5181                                     ,output v-mes).
     5182     if v-tot-cli = ? then undo _main, return error v-mes.
     5183     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5184                                     ,input 'MARIA_general':U
     5185                                     ,input 'max-cli':U
     5186                                     , output v-mes).
     5187     if v-max-cli = ? then undo _main, return error v-mes.
     5188     DO ii = 1
     5189        to v-max-cli :
     5190       if not can-find (loc_cd-clu where
     5191                       loc_cd-clu.obj-type = 'маг':U
     5192                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5193                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5194                   and loc_cd-clu.clu-type = '':U
     5195                   and loc_cd-clu.clu-code = ii
     5196                      )
     5197       then LEAVE .
     5198     END .
     5199     if ii > v-max-cli then do:
     5200         if not p-silence then
     5201         message
     5202         substitute("Превышено максимально допустимое количество клиентов &1" +
     5203                   "для касс &2 &3&4"
     5204                   , chr(10)
     5205                   , v-max-cli
     5206                   , 'маг':U
     5207                   , buf_cash-desk.obj-code
     5208                   )
     5209         view-as alert-box ERROR .
     5210         undo, return error "max-cli":U.
     5211     end.
     5212     run cur-time in this-procedure ( output v-today, output v-time).
     5213     create buf_cd-clu.
     5214     assign
     5215     buf_cd-clu.cli-code = p-obj-code
     5216     buf_cd-clu.cli-type = p-obj-type
     5217     buf_cd-clu.obj-type = 'маг':U
     5218     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5219     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5220     buf_cd-clu.clu-type = '':U
     5221     buf_cd-clu.to-send = yes
     5222     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5223                               then buf_cash-desk.addr-path
     5224                               else "U":U)
     5225     buf_cd-clu.clu-code = ii
     5226     .
     5227     run cd-attr-write  in this-procedure (
     5228                                           input   buf_cash-desk.db-num
     5229                                           ,input  buf_cash-desk.obj-code
     5230                                           ,input  buf_cash-desk.pos-type
     5231                                           ,input  buf_cash-desk.cash-num
     5232                                           ,input  'MARIA_operative':U
     5233                                           ,input  'tot-cli':U
     5234                                           ,input ''
     5235                                           ,input ?
     5236                                           ,input 0.0
     5237                                           ,input  (v-tot-cli + 1)
     5238                                           ,input no
     5239                                          ) no-error .
     5240     if error-status:error then do:
     5241       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5242                          ,buf_cash-desk.cash-num
     5243                          , 'маг':U
     5244                          ,buf_cash-desk.obj-code
     5245                          , chr(10)
     5246                          , error-status:get-message(1)
     5247                          , return-value
     5248                          ).
     5249       if not p-silence then
     5250       message
     5251       v-mes
     5252       view-as alert-box error .
     5253       undo _main, return error v-mes.
     5254     end.
     5255     run cd-attr-write  in this-procedure (
     5256                                           input   buf_cash-desk.db-num
     5257                                           ,input  buf_cash-desk.obj-code
     5258                                           ,input  buf_cash-desk.pos-type
     5259                                           ,input  buf_cash-desk.cash-num
     5260                                           ,input  'MARIA_operative':U
     5261                                           ,input  'cli-to-send':U
     5262                                           ,input ''
     5263                                           ,input ?
     5264                                           ,input 0.0
     5265                                           ,input 0
     5266                                           ,input yes
     5267                                          ) no-error .
     5268     if error-status:error then do:
     5269       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5270                          ,buf_cash-desk.cash-num
     5271                          , 'маг':U
     5272                          ,buf_cash-desk.obj-code
     5273                          , chr(10)
     5274                          , error-status:get-message(1)
     5275                          , return-value
     5276                          ).
     5277       if not p-silence then
     5278       message
     5279       v-mes
     5280       view-as alert-box error .
     5281       undo _main, return error v-mes.
     5282     end.
     5283     return "":U.
     5284   end.
     5285   END PROCEDURE.
     5286   procedure cd-mrkt_update-marketer-cli :
     5287   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5288   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5289   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5290   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5291   define variable v-cli-to-send as logical no-undo .
     5292   define variable v-tot-cli as integer no-undo .
     5293   define variable v-max-clu as integer no-undo .
     5294   define buffer buf_cd-clu for ub.cd-clu.
     5295   do
     5296   on error undo, return error return-value
     5297   :
     5298     v-cli-to-send = no.
     5299     v-tot-cli = 0.
     5300     FOR EACH buf_cd-clu WHERE
     5301           buf_cd-clu.obj-type = 'маг':U
     5302       and buf_cd-clu.obj-code =  p-obj-code
     5303       and buf_cd-clu.pos-type =  p-pos-type
     5304       and buf_cd-clu.clu-type =  '':U
     5305       :
     5306       if buf_cd-clu.to-del = yes then do:
     5307         assign
     5308         v-cli-to-send = yes.
     5309       end.
     5310       assign
     5311       v-tot-cli = v-tot-cli + 1.
     5312     end.
     5313     run cd-attr-write  in this-procedure (
     5314                                             input   p-db-num
     5315                                             ,input  p-obj-code
     5316                                             ,input  p-pos-type
     5317                                             ,input  p-cash-num
     5318                                             ,input  'MARIA_operative':U
     5319                                             ,input  'tot-cli':U
     5320                                             ,input ''
     5321                                             ,input ?
     5322                                             ,input 0.0
     5323                                             ,input v-tot-cli
     5324                                             ,input no
     5325                                             ) no-error .
     5326     if error-status:error then do:
     5327         UNDO, RETURN ERROR RETURN-VALUE.
     5328     END.
     5329     run cd-attr-write  in this-procedure (
     5330                                             input   p-db-num
     5331                                             ,input  p-obj-code
     5332                                             ,input  p-pos-type
     5333                                             ,input  p-cash-num
     5334                                             ,input  'MARIA_operative':U
     5335                                             ,input  'cli-to-send':U
     5336                                             ,input ''
     5337                                             ,input ?
     5338                                             ,input 0.0
     5339                                             ,input 0
     5340                                             ,input v-cli-to-send
     5341                                             ) no-error .
     5342     if error-status:error then do:
     5343         UNDO, RETURN ERROR RETURN-VALUE.
     5344     END.
     5345     FIND LAST buf_cd-clu WHERE
     5346             buf_cd-clu.obj-type = 'маг':U
     5347         and buf_cd-clu.obj-code = p-obj-code
     5348         and buf_cd-clu.pos-type = p-pos-type
     5349         and buf_cd-clu.clu-type = '':U
     5350         NO-LOCK use-index pi no-error .
     5351     if available buf_cd-clu then do:
     5352       if v-max-clu < buf_cd-clu.clu-code
     5353       then
     5354       v-max-clu = buf_cd-clu.clu-code.
     5355     end.
     5356     else do:
     5357       v-max-clu = 0.
     5358     end.
     5359     run cd-attr-write  in this-procedure (
     5360                                           input   p-db-num
     5361                                           ,input  p-obj-code
     5362                                           ,input  p-pos-type
     5363                                           ,input  p-cash-num
     5364                                           ,input  'MARIA_operative':U
     5365                                           ,input  'max-clu':U
     5366                                           ,input ''
     5367                                           ,input ?
     5368                                           ,input 0.0
     5369                                           ,input v-max-clu
     5370                                           ,input no
     5371                                           ) no-error .
     5372     if error-status:error then do:
     5373         UNDO, RETURN ERROR RETURN-VALUE.
     5374     END.
     5375   end.
     5376   end procedure.
