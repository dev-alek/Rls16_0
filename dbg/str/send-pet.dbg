     6998   procedure grp-obj-notcorr-value :
     6999   do
     7000   on error undo, return error
     7001   :
     7002   define input parameter p-node-code             as integer      no-undo.
     7003   define input parameter p-obj-type              as character    no-undo.
     7004   define input parameter p-obj-code              as integer      no-undo.
     7005   define output parameter p-notcorr              as character    no-undo init ?.
     7006   define output parameter p-range-notcorr     as integer      no-undo.
     7007   define output parameter p-exists-notcorr    as logical      no-undo.
     7008   define variable v-host-code as integer      no-undo.
     7009   DEFINE VARIABLE v-found as logical no-undo .
     7010   DEFINE VARIABLE v-exists as logical no-undo .
     7011   DEFINE VARIABLE v-range as integer no-undo .
     7012   DEFINE VARIABLE jj as integer no-undo .
     7013   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     7014   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     7015   define buffer buf_gds-grp for ub.gds-grp.
     7016   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     7017   find first buf_gds-grp no-lock where
     7018              buf_gds-grp.node-code = p-node-code no-error .
     7019   if not avail buf_gds-grp and p-node-code <> 0 then do:
     7020     message
     7021       vss-workfile vss-revision vss-description
     7022       skip "Не удалось найти группу товаров с кодом" p-node-code
     7023       view-as alert-box error .
     7024     undo, return error .
     7025   end.
     7026   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7027   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7028     (input  p-obj-type
     7029     ,input  p-obj-code
     7030     ,output v-host-code
     7031     ) no-error .
     7032   if error-status :error
     7033   then do:
     7034       message
     7035         vss-workfile vss-revision vss-description
     7036         skip "Не удалось найти фирму объекта"
     7037         skip p-obj-type p-obj-code
     7038         skip return-value
     7039         skip trim(error-status :get-message(1))
     7040       view-as alert-box error.
     7041       undo, return error .
     7042   end.
     7043   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7044   do while v-found = no and jj < 2:
     7045     if v-range <> 3 then do:
     7046       find first buf_gds-grp-obj no-lock
     7047           where buf_gds-grp-obj.node-code = p-node-code
     7048             and buf_gds-grp-obj.host-code = v-host-code
     7049             and buf_gds-grp-obj.obj-type  = p-obj-type
     7050             and buf_gds-grp-obj.obj-code  = p-obj-code
     7051       no-error .
     7052     end.
     7053     if v-range = 3 or not available buf_gds-grp-obj
     7054     then do:
     7055        if v-range <> 2 then do:
     7056           find first buf_gds-grp-obj no-lock
     7057               where buf_gds-grp-obj.node-code = p-node-code
     7058                 and buf_gds-grp-obj.host-code = v-host-code
     7059                 and buf_gds-grp-obj.obj-type  = ""
     7060                 and buf_gds-grp-obj.obj-code  = 0
     7061           no-error .
     7062         end.
     7063         if v-range = 2 or not available buf_gds-grp-obj
     7064         then do:
     7065             if v-range <> 1 then do:
     7066               find first buf_gds-grp-obj no-lock
     7067                   where buf_gds-grp-obj.node-code = p-node-code
     7068                   and buf_gds-grp-obj.host-code = 0
     7069                   and buf_gds-grp-obj.obj-type  = ""
     7070                   and buf_gds-grp-obj.obj-code  = 0
     7071               no-error .
     7072             end.
     7073             if v-range = 1 or not available buf_gds-grp-obj
     7074             then do:
     7075                 assign
     7076                     v-exists = no
     7077                 .
     7078             end.
     7079             else do:
     7080                 assign
     7081                     v-exists = yes
     7082                     v-range = 1
     7083                 .
     7084             end.
     7085         end.
     7086         else do:
     7087             assign
     7088                 v-exists = yes
     7089                 v-range  = 2
     7090             .
     7091         end.
     7092     end.
     7093     else do:
     7094         assign
     7095             v-exists = yes
     7096             v-range  = 3
     7097         .
     7098     end.
     7099     if available buf_gds-grp-obj
     7100     then do:
     7101       find first buf_gds-grp-obj-attr no-lock
     7102         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7103           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7104           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7105           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7106           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7107         no-error .
     7108       if available buf_gds-grp-obj-attr then do:
     7109         assign
     7110           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7111         .
     7112       end.
     7113       else do:
     7114         assign
     7115           v-notcorr-value = ?
     7116         .
     7117       end.
     7118       assign
     7119       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7120                           then yes
     7121                           else p-exists-notcorr)
     7122       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7123                         then v-range
     7124                         else p-range-notcorr
     7125       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7126                         then v-notcorr-value
     7127                         else p-notcorr
     7128       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7129       jj = jj + 1
     7130       .
     7131     end.
     7132     else do:
     7133       assign
     7134       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7135       jj = jj + 1
     7136       .
     7137     end.
     7138   end.
     7139   end.
     7140   end procedure.
