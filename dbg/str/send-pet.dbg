     1508   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1509   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1510   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1511   procedure disrules-fill-properties:
     1512   define input  parameter p-templ-rl-root as integer   no-undo .
     1513   define buffer buf_drt-prop for ub.drt-prop.
     1514   define buffer buf_temp-drt-prop for temp-drt-prop.
     1515   do
     1516   on error undo, return error return-value
     1517   :
     1518     for each buf_temp-drt-prop:
     1519       delete buf_temp-drt-prop.
     1520     end.
     1521     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1522       create buf_temp-drt-prop.
     1523       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1524     end.
     1525   end.
     1526   end procedure.
     1527   ~
     1528   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1529   procedure discfgru-check :
     1530   define input parameter p-table-name as character no-undo .
     1531   define input parameter p-templ-rl-root as integer no-undo .
     1532   define input parameter p-time-templ-rl-root as integer no-undo .
     1533   define input parameter p-pos-type as character no-undo .
     1534   define output parameter p-disnct-role as character no-undo .
     1535   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1536     do
     1537     on error undo, return error return-value
     1538     :
     1539       find first buf_dis-cfg-rule no-lock where
     1540               buf_dis-cfg-rule.table-name = p-table-name
     1541           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1542           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1543           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1544       if not available buf_dis-cfg-rule
     1545       or p-pos-type = "":U
     1546       then do:
     1547          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1548                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1549                                  , p-templ-rl-root
     1550                                  , (if p-time-templ-rl-root = ?
     1551                                     then '':U
     1552                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1553                                     )
     1554                                  ).
     1555       end.
     1556       assign
     1557       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1558       .
     1559     end.
     1560   end procedure.
     1561   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1562   FUNCTION get-region RETURNS CHARACTER
     1563     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1564     define variable par-region as character no-undo.
     1565     if parhost-code = 0 and
     1566          parobj-type = "":U and
     1567          parobj-code = 0 then do:
     1568          par-region = "Глобально".
     1569          return par-region.
     1570       end.
     1571       if parobj-type = 'орг':U then do:
     1572          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1573          return par-region.
     1574       end.
     1575       if parobj-type = 'регион':U
     1576       then do:
     1577          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1578          return par-region.
     1579       end.
     1580       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1581       return par-region.
     1582   END FUNCTION.
     1583   FUNCTION get-objregion RETURNS CHARACTER
     1584     (  input parobj-type as character, input parobj-code as integer ) :
     1585     define variable par-region as character no-undo.
     1586     if  parobj-type = "":U and
     1587         parobj-code = 0
     1588     then do:
     1589        par-region = "Глобально".
     1590     end.
     1591     else if parobj-type = 'орг':U
     1592     then do:
     1593        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1594     end.
     1595     else if parobj-type = 'регион':U
     1596     then do:
     1597        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1598     end.
     1599     else
     1600        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1601     return par-region.
     1602   END FUNCTION.
     1603   procedure disgdsru-name :
     1604   define buffer buf_dis-rule for ub.dis-rule.
     1605   do
     1606     on error undo, return error
     1607     :
     1608     define input  parameter p-templ-rl-root  as integer no-undo .
     1609     define output parameter p-label          as character no-undo .
     1610     find first buf_dis-rule no-lock where
     1611               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1612     if available buf_dis-rule
     1613     then do:
     1614       if buf_dis-rule.rule-num > 0 then
     1615       p-label = buf_dis-rule.des.
     1616     end.
     1617     else do:
     1618       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1619     end.
     1620   end.
     1621   end procedure.
     1622   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1623   define variable v-rule-label as character no-undo .
     1624   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1625                                        ,output v-rule-label) no-error.
     1626   return v-rule-label.
     1627   end function.
     1628   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1629   define variable v-rule-label as character no-undo .
     1630   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1631   end function.
     1632   procedure disgdsru-write :
     1633     do
     1634     on error undo, return error
     1635     :
     1636       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1637       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1638       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1639       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1640       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1641       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1642       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1643       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1644       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1645       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1646       define buffer buf_dis-rule for ub.dis-rule.
     1647       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1648       define variable v-label          as character no-undo .
     1649       define variable v-discnt-role as character no-undo .
     1650       run discfgru-check in this-procedure (
     1651                                             input 'dis-gds-rule':U
     1652                                            ,input p-templ-rl-root
     1653                                            ,input p-time-templ-rl-root
     1654                                            ,input p-pos-type
     1655                                            ,output v-discnt-role
     1656                                             ) no-error .
     1657       if error-status :error then do:
     1658         undo, return error return-value .
     1659       end.
     1660       if p-discnt-role = ? then do:
     1661         p-discnt-role = v-discnt-role.
     1662       end.
     1663       if p-discnt-role <> v-discnt-role then do:
     1664         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1665                                 ,p-gds-code
     1666                                 ,p-obj-type
     1667                                 ,p-obj-code
     1668                                 ,p-pos-type
     1669                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1670                                 ,chr(10)
     1671                                 ,p-templ-rl-root
     1672                                 ,p-rule-num).
     1673       end.
     1674       if p-pos-type = ? then do:
     1675   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1676   define variable v-param-type23 as character no-undo .
     1677   define variable v-value-date23 as date no-undo .
     1678   define variable v-value-decimal23 as decimal no-undo .
     1679   define variable v-value-integer23 as INTEGER no-undo .
     1680   define variable v-value-logical23 AS LOGICAL no-undo .
     1681   define variable v-tth23 as handle no-undo .
     1682   run adm/shattri.p (
     1683       input "get":U
     1684       ,input  p-obj-type
     1685       ,input  p-obj-code
     1686       ,input  'cd-sending':U
     1687       ,input  'dflt-cd':U
     1688       ,output p-pos-type
     1689       ,output v-value-date23
     1690       ,output v-value-decimal23
     1691       ,output v-value-integer23
     1692       ,output v-value-logical23
     1693       ,output v-param-type23
     1694       ,INPUT-OUTPUT table-handle v-tth23
     1695       )  .
     1696   delete object v-tth23 no-error.
     1697       end.
     1698       find first buf_dis-rule no-lock where
     1699                 buf_dis-rule.rule-num = p-rule-num no-error.
     1700       if not available buf_Dis-rule then do:
     1701         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1702                                 ,p-gds-code
     1703                                 ,p-obj-type
     1704                                 ,p-obj-code
     1705                                 ,p-pos-type
     1706                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1707                                 ,chr(10)
     1708                                 ,p-rule-num).
     1709       end.
     1710       if buf_dis-rule.root <> yes then do:
     1711         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1712                                 ,p-gds-code
     1713                                 ,p-obj-type
     1714                                 ,p-obj-code
     1715                                 ,p-pos-type
     1716                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1717                                 ,chr(10)
     1718                                 ,p-rule-num).
     1719       end.
     1720       if not (p-obj-type = buf_dis-rule.obj-type
     1721           and p-obj-code = buf_dis-rule.obj-code)
     1722       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1723                and
     1724                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1725        then do:
     1726         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1727                                 ,p-gds-code
     1728                                 ,p-obj-type
     1729                                 ,p-obj-code
     1730                                 ,p-pos-type
     1731                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1732                                 ,chr(10)
     1733                                 ) +
     1734                             substitute("Правило скидки &1 определено для &2&3" +
     1735                                        "а привязка к товару для &4"
     1736                                        ,buf_dis-rule.rule-num
     1737                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1738                                        ,chr(10)
     1739                                        ,get-objregion( p-obj-type, p-obj-code)
     1740                                        ))
     1741                                 .
     1742       end.
     1743       find first buf_dis-gds-rule exclusive-lock where
     1744                  buf_dis-gds-rule.gds-code  = p-gds-code
     1745              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1746              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1747              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1748              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1749              and buf_dis-gds-rule.nonunique = p-nonunique
     1750              no-error .
     1751       if not available buf_dis-gds-rule then do:
     1752         find first buf_dis-gds-rule exclusive-lock where
     1753                   buf_dis-gds-rule.gds-code  = p-gds-code
     1754               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1755               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1756               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1757               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1758               no-error .
     1759         if available buf_Dis-gds-rule then do:
     1760           if p-nonunique = ''
     1761           and available buf_dis-gds-rule
     1762           then do:
     1763             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1764                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1765                                      , p-gds-code
     1766                                      , buf_Dis-rule.obj-type
     1767                                      , buf_Dis-rule.obj-code
     1768                                      , p-nonunique
     1769                                     ).
     1770           end.
     1771           if available buf_dis-gds-rule
     1772           and buf_dis-gds-rule.nonunique = ''
     1773           and p-nonunique <> ''then do:
     1774             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1775                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1776                                      , p-gds-code
     1777                                      , buf_Dis-rule.obj-type
     1778                                      , buf_Dis-rule.obj-code
     1779                                     ).
     1780           end.
     1781         end.
     1782         create buf_dis-gds-rule .
     1783         assign
     1784         buf_dis-gds-rule.gds-code  = p-gds-code
     1785         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1786         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1787         buf_dis-gds-rule.pos-type = p-pos-type
     1788         buf_dis-gds-rule.discnt-role = v-discnt-role
     1789         buf_dis-gds-rule.rule-num = p-rule-num
     1790         buf_dis-gds-rule.nonunique = p-nonunique
     1791         no-error
     1792         .
     1793       end.
     1794       ASSIGN
     1795       buf_dis-gds-rule.rule-num = p-rule-num
     1796       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1797       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1798       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1799       buf_dis-gds-rule.nonunique = p-nonunique
     1800       no-error.
     1801     end.
     1802   end procedure.
     1803   PROCEDURE cmp-disgdsru-write :
     1804   do
     1805   on error undo, return error
     1806   :
     1807     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1808     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1809     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1810     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1811     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1812     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1813     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1814     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1815     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1816     define variable v-rule-label          as character no-undo .
     1817     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1818     define buffer buf_dis-rule     for ub.dis-rule.
     1819     run disgdsru-name in this-procedure (
     1820                                         input  p-templ-rl-root
     1821                                         ,output v-rule-label
     1822                                         ) no-error .
     1823     if error-status :error then do:
     1824       undo, return error return-value .
     1825     end.
     1826     find first buf_tt0-dis-gds-rule exclusive-lock where
     1827                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1828             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1829             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1830             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1831             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1832             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1833             no-error .
     1834     if not available buf_tt0-dis-gds-rule then do:
     1835       create buf_tt0-dis-gds-rule .
     1836       assign
     1837       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1838       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1839       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1840       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1841       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1842       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1843       no-error
     1844       .
     1845     end.
     1846     find first buf_dis-rule no-lock where
     1847               buf_dis-rule.rule-num = p-rule-num.
     1848     ASSIGN
     1849     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1850     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1851     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1852     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1853     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1854     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1855     no-error.
     1856     release buf_tt0-dis-gds-rule no-error .
     1857     if error-status:error then do:
     1858       undo, return error return-value .
     1859     end.
     1860   end.
     1861   END PROCEDURE.
     1862   define variable vss-include-info24 as character format "X(65)" no-undo
     1863   initial "@(#)$Workfile$ $Revision$".
     1864   define variable v-bgelib-bgefmt        as character         no-undo.
     1865   define variable v-bgelib-bgeflold      as character         no-undo.
