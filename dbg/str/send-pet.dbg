    11462   END PROCEDURE .
    11463   run write-log-and-file in p-log-handle (
    11464         input 1
    11465       , input log-file-name
    11466       , input 1
    11467       , input substitute("Пересылка конфигурации АЗС на кассы &1&2", p-obj-type, i-obj-code)
    11468                                                                                    ).
    11469   for each cash-place:
    11470     delete cash-place.
    11471   end.
    11472   _buf_place:
    11473   for each buf_place no-lock where
    11474           buf_place.obj-type = p-obj-type
    11475       AND buf_place.obj-code = i-obj-code
    11476       and buf_place.status_  <> 'удал':U,
    11477       first buf_pl-gds no-lock where
    11478             buf_pl-gds.obj-type = p-obj-type
    11479         AND buf_pl-gds.obj-code = i-obj-code
    11480         and buf_pl-gds.pl-code = buf_place.pl-code
    11481         and buf_pl-gds.status_ = 'тек':U,
    11482       first buf_goods no-lock where buf_goods.gds-code = buf_pl-gds.gds-code and buf_goods.stts = integer('0':U) :
    11483     assign
    11484     dop-int = integer(buf_place.loc1)
    11485     no-error .
    11486     if error-status:error
    11487     or buf_place.loc1 = '':U
    11488     or dop-int > 999
    11489     then do:
    11490       run write-log-and-file in p-log-handle (
    11491             input 1
    11492           , input log-file-name
    11493           , input 1
    11494           , input substitute("!!!Ошибка при пересылке конфигурации АЗС:&1" +
    11495                              "для резервуара с кодом скл места &2&1" +
    11496                              "не задан или неверно задан порядкой код резервуара (коорд1) = &3"
    11497                               , chr(10)
    11498                               , buf_place.pl-code
    11499                               , Buf_place.loc1 )).
    11500       v-view-log = yes.
    11501       next _buf_place.
    11502     end.
    11503   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    11504     (
    11505        input buf_goods.artic
    11506     ,  input buf_goods.prod-type
    11507     ,  input buf_goods.prod-code
    11508     , output is-petrolium
    11509     , output is-pieces
    11510     ) no-error.
    11511     if not (is-petrolium and not is-pieces) then NEXT.
