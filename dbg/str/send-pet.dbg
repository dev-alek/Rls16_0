      138   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   def new shared var bc-frmt as character no-undo .
      140   def new shared var bc-pfx  as character no-undo .
      141   def var bc-par-type as character no-undo .
      142       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      143       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      144           do:
      145               message "Не задан или не верно задан ТИП собственного бар-кода!"
      146                   view-as alert-box ERROR TITLE "".
      147               return error.
      148           end.
      149       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      150       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      151           do:
      152               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      153                   view-as alert-box ERROR TITLE "".
      154               return error.
      155           end.
      156   PROCEDURE gen-bc:
      157     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      158     def output parameter full-b-code     as character init ""    no-undo .
      159   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      160     define variable tmp-str4  as character no-undo.
      161     define variable tmp-num4  as character no-undo.
      162     define variable i4        as integer   no-undo.
      163     define variable sum4      as integer   no-undo.
      164     define variable len-code4 as integer   no-undo.
      165     define variable varcont4  as logical   initial yes no-undo.
      166     CASE bc-frmt :
      167       WHEN "EAN13" THEN do:
      168         assign
      169           tmp-str4 = string( internal-b-code, "999999999999" )
      170         .
      171       end.
      172       WHEN "EAN8" THEN do:
      173         assign
      174           tmp-str4 = string( internal-b-code, "9999999" )
      175         .
      176       end.
      177       OTHERWISE DO:
      178           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      179           view-as alert-box error.
      180           return error.
      181       END.
      182     END CASE.
      183     if varcont4 = yes then do:
      184       if integer( substring( tmp-str4, 1, length( bc-pfx ) ) ) <> 0
      185       then do:
      186         message
      187           "Невозможно сформировать бар-код" SKIP
      188           "для товара с кодом: " internal-b-code
      189           view-as alert-box error title "подрезание кода".
      190         return error.
      191       end.
      192       else do:
      193         assign
      194           full-b-code = bc-pfx + substring( tmp-str4, length( bc-pfx ) + 1, length( tmp-str4 ) - length( bc-pfx ) )
      195           len-code4    = length( full-b-code )
      196         .
      197         define variable v-sum-char4 as character no-undo .
      198         assign
      199           sum4 = 0
      200         .
      201         do i4 = 1 to len-code4 by 2
      202         :
      203           assign
      204             v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      205           .
      206           if v-sum-char4 < "0"
      207           or v-sum-char4 > "9"
      208           then do:
      209             message
      210               "Невозможно сформировать бар-код" skip
      211               "для товара с кодом: " internal-b-code skip
      212               view-as alert-box error title "подсчет контрольной суммы".
      213             return error.
      214           end.
      215           assign
      216             sum4 = sum4 + integer(v-sum-char4)
      217           .
      218         end.
      219         if varcont4 = yes then do:
      220           assign
      221             sum4 = sum4 * 3
      222           .
      223           do i4 = 2 to len-code4 by 2
      224           :
      225             assign
      226               v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      227             .
      228             if v-sum-char4 < "0"
      229             or v-sum-char4 > "9"
      230             then do:
      231               message
      232                 "Невозможно сформировать бар-код" skip
      233                 "для товара с кодом: " internal-b-code skip
      234                 view-as alert-box error title "подсчет контрольной суммы".
      235               return error.
      236             end.
      237             assign
      238               sum4 = sum4 + integer(v-sum-char4)
      239             .
      240           end.
      241           if varcont4 = yes then do:
      242              if sum4 mod 10 = 0 then do:
      243                assign
      244                  full-b-code = full-b-code + '0'
      245                .
      246              end.
      247              else do:
      248                assign
      249                  full-b-code = full-b-code + string(10 - sum4 mod 10)
      250                .
      251              end.
      252           end.
      253         end.
      254       end.
      255     end.
      256   END PROCEDURE.
