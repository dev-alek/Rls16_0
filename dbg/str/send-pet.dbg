      398   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      400                                                                     input  orders as integer):
      401   define variable  round-m-sum as decimal no-undo.
      402   if orders >= 0 then
      403   round-m-sum = round(mysum,orders).
      404   else
      405   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      406   return round-m-sum.
      407   END FUNCTION.
      408   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      409   procedure factord :
      410     define input  parameter p-fact-date            as date    no-undo .
      411     define input  parameter p-fact-time            as integer no-undo .
      412     define input  parameter p-fact-num             as integer no-undo .
      413     define input  parameter p-shift-date           as date    no-undo .
      414     define input  parameter p-shift-num            as integer no-undo .
      415     define input  parameter p-shift-on             as logical no-undo .
      416     define output parameter p-fact-order           as decimal no-undo .
      417     define output parameter p-shift-end-fact-order as decimal no-undo .
      418     define output parameter p-day-end-fact-order   as decimal no-undo .
      419     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      420     if p-fact-date = ?
      421     then do:
      422       return error "Не указана фактическая дата" .
      423     end.
      424     define variable v-fact-date-num as integer no-undo .
      425     assign
      426       v-fact-date-num = integer(p-fact-date)
      427     .
      428     if p-fact-num = ?
      429     or p-fact-num = 0
      430     then do:
      431       return error "Не задан p-fact-num " + string(p-fact-num) .
      432     end.
      433     if p-fact-num < 0
      434     then do:
      435       return error "Отрицательный fact-num " + string(p-fact-num) .
      436     end.
      437     if p-fact-num >= 100000000
      438     then do:
      439       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      440     end.
      441     if p-shift-on = true
      442     then do:
      443       if p-shift-date = ?
      444       then do:
      445         return error "Не задана дата смены" .
      446       end.
      447       if p-shift-num = ?
      448       or p-shift-num = 0
      449       then do:
      450         return error "Не задан номер смены" .
      451       end.
      452     end.
      453     else do:
      454       assign
      455         p-shift-date = p-fact-date
      456         p-shift-num  = 24
      457       .
      458     end.
      459     define variable v-shift-offset as integer no-undo .
      460     if p-shift-date = p-fact-date
      461     then do:
      462       assign
      463         v-shift-offset = 1
      464       .
      465     end.
      466     if p-shift-date < p-fact-date
      467     then do:
      468       assign
      469         v-shift-offset = 0
      470       .
      471     end.
      472     if p-shift-date > p-fact-date
      473     then do:
      474       message
      475         vss-workfile vss-revision vss-description skip
      476         "Неправильная дата закрытия смены" skip
      477         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      478         view-as alert-box error .
      479       undo, return error
      480         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      481           ,string(p-fact-date, '99/99/9999':U)
      482           ,string(p-shift-date, '99/99/9999':U)
      483           )
      484       .
      485     end.
      486     if p-shift-num < 1
      487     or p-shift-num > 24
      488     then do:
      489       message
      490         vss-workfile vss-revision vss-description skip
      491         "Неправильный номер смены" skip
      492         "p-shift-num" p-shift-num skip
      493         view-as alert-box error .
      494       undo, return error return-value .
      495     end.
      496     assign
      497       p-fact-order           = v-fact-date-num
      498                              + v-shift-offset * 0.5
      499                              + p-shift-num    * 0.02 - 0.01
      500                              + p-fact-num     * 0.0000000001
      501       p-shift-end-fact-order = v-fact-date-num
      502                              + v-shift-offset * 0.5
      503                              + p-shift-num    * 0.02
      504       p-day-end-fact-order   = v-fact-date-num
      505                              + 0.99
      506     .
      507     if p-fact-order           <= v-fact-date-num
      508     or p-shift-end-fact-order <= v-fact-date-num
      509     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      510     or p-shift-end-fact-order >= p-day-end-fact-order
      511     then do:
      512       message
      513         vss-workfile vss-revision vss-description skip
      514         "Внутренняя ошибка при генерации фактического номера" skip
      515         "p-fact-date"            p-fact-date            skip
      516         "p-fact-time"            p-fact-time            skip
      517         "p-fact-num"             p-fact-num             skip
      518         "p-shift-date"           p-shift-date           skip
      519         "p-shift-num"            p-shift-num            skip
      520         "p-shift-on"             p-shift-on             skip
      521         "p-shift-end-fact-order" p-shift-end-fact-order skip
      522         "p-day-end-fact-order"   p-day-end-fact-order   skip
      523         "v-fact-date-num"        v-fact-date-num        skip
      524         view-as alert-box error .
      525       undo, return error return-value .
      526     end.
      527   end procedure.
      528   procedure day-begin-fact-order :
      529     define input  parameter p-fact-date            as date    no-undo .
      530     define output parameter p-day-begin-fact-order as decimal no-undo .
      531     do
      532     on error undo, return error return-value
      533     :
      534       if p-fact-date = ?
      535       then do:
      536         assign
      537           p-day-begin-fact-order = 0
      538         .
      539       end.
      540       else do:
      541         assign
      542           p-day-begin-fact-order = integer(p-fact-date)
      543         .
      544       end.
      545     end.
      546   end procedure.
      547   procedure factord-max-fact-order :
      548     define output parameter p-max-fact-order as decimal   no-undo .
      549     do
      550     on error undo, return error return-value
      551     :
      552       run day-begin-fact-order in this-procedure
      553         (input  date(1, 1, 5000)
      554         ,output p-max-fact-order
      555         ) .
      556     end.
      557   end procedure.
      558   procedure factord-cut-archive :
      559     define input  parameter p-obj-type             as character no-undo .
      560     define input  parameter p-obj-code             as integer   no-undo .
      561     define input  parameter p-fact-date            as date      no-undo .
      562     define output parameter p-shift-on             as logical   no-undo .
      563     define output parameter p-shift-date           as date      no-undo .
      564     define output parameter p-shift-num            as integer   no-undo .
      565     define output parameter p-day-end-fact-order   as decimal   no-undo .
      566     define output parameter p-shift-end-fact-order as decimal   no-undo .
      567     define variable v-fact-order as decimal   no-undo .
      568     define buffer buf_shift-obj for ub.shift-obj .
      569     do
      570     on error undo, return error return-value
      571     :
      572   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      574     (input  p-obj-type
      575     ,input  p-obj-code
      576     ,input  'shift-on=request'
      577     ,output p-shift-on
      578     ) no-error .
      579       if error-status :error
      580       then do:
      581         message
      582           vss-workfile vss-revision vss-description skip
      583           "Ошибка при определении атрибута объекта" skip
      584           "Объект" p-obj-type p-obj-code skip
      585           error-status :get-message(1) skip
      586           return-value skip
      587           view-as alert-box error .
      588         undo, return error return-value .
      589       end.
      590       if p-shift-on = false
      591       then do:
      592         assign
      593           p-shift-date               = ?
      594           p-shift-num                = 0
      595         .
      596       end.
      597       else do:
      598         find first buf_shift-obj share-lock
      599           where buf_shift-obj.obj-type   = p-obj-type
      600             and buf_shift-obj.obj-code   = p-obj-code
      601             and buf_shift-obj.shift-date > p-fact-date
      602           use-index pi
      603           no-error .
      604         if not available buf_shift-obj
      605         or buf_shift-obj.status_ <> 'зкр':U
      606         then do:
      607           message
      608             vss-workfile vss-revision vss-description skip
      609             "Невозможно вычислить последнюю смену" skip
      610             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      611             "Объект" p-obj-type p-obj-code skip
      612             "Дата" p-fact-date skip
      613             view-as alert-box error .
      614           undo, return error return-value .
      615         end.
      616         find last buf_shift-obj share-lock
      617           where buf_shift-obj.obj-type = p-obj-type
      618             and buf_shift-obj.obj-code = p-obj-code
      619             and buf_shift-obj.shift-date <= p-fact-date
      620           use-index pi
      621           no-error .
      622         if available buf_shift-obj
      623         then do:
      624           if  buf_shift-obj.status_ = 'зкр':U
      625           then do:
      626             assign
      627               p-shift-date = buf_shift-obj.shift-date
      628               p-shift-num  = buf_shift-obj.shift-num
      629             .
      630           end.
      631           else do:
      632             message
      633               vss-workfile vss-revision vss-description skip
      634               "Невозможно вычислить последнюю смену" skip
      635               "Статус смены отличен от статуса" 'зкр':U skip
      636               "Объект" p-obj-type p-obj-code skip
      637               "Дата" p-fact-date skip
      638               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      639               view-as alert-box error .
      640             undo, return error return-value .
      641           end.
      642         end.
      643         else do:
      644           assign
      645             p-shift-date = p-fact-date - 1
      646             p-shift-num  = 1
      647           .
      648         end.
      649       end.
      650       run factord in this-procedure
      651         (input  p-fact-date
      652         ,input  1
      653         ,input  1
      654         ,input  p-shift-date
      655         ,input  p-shift-num
      656         ,input  p-shift-on
      657         ,output v-fact-order
      658         ,output p-shift-end-fact-order
      659         ,output p-day-end-fact-order
      660         ) no-error .
      661       if error-status :error
      662       then do:
      663         message
      664           vss-workfile vss-revision vss-description skip
      665           "Ошибка при вызове процедуры factord"
      666           error-status :get-message(1) skip
      667           return-value skip
      668           view-as alert-box error .
      669         undo, return error return-value .
      670       end.
      671     end.
      672   end procedure.
      673   procedure factord-lock-shift :
      674     define input  parameter p-obj-type  as character no-undo .
      675     define input  parameter p-obj-code  as integer   no-undo .
      676     define input  parameter p-fact-date as date      no-undo .
      677     define parameter buffer buf_shift-obj for ub.shift-obj .
      678     define variable v-shift-on      as logical   no-undo .
      679     define variable v-extra-message as character no-undo .
      680     define variable v-error as character no-undo .
      681     do
      682     on error undo, return error return-value
      683     :
      684   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      685   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      686     (input  p-obj-type
      687     ,input  p-obj-code
      688     ,input  'shift-on=request'
      689     ,output v-shift-on
      690     ) no-error .
      691       if error-status :error
      692       then do:
      693         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      694         undo, return error v-error .
      695       end.
      696       if v-shift-on = true
      697       then do:
      698         find first buf_shift-obj share-lock
      699           where buf_shift-obj.obj-type   = p-obj-type
      700             and buf_shift-obj.obj-code   = p-obj-code
      701             and buf_shift-obj.shift-date > p-fact-date
      702           use-index pi
      703           no-error .
      704         if not available buf_shift-obj
      705         or buf_shift-obj.status_ <> 'зкр':U
      706         then do:
      707           find last buf_shift-obj
      708             where buf_shift-obj.obj-type = p-obj-type
      709               and buf_shift-obj.obj-code = p-obj-code
      710               and buf_shift-obj.status_  = 'зкр':U
      711             use-index stts
      712             no-error .
      713           if available buf_shift-obj
      714           then do:
      715             assign
      716               v-extra-message =
      717                     substitute("Дата начала последеней закрытой смены на объекте &1"
      718                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      719                               )
      720             .
      721           end.
      722           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      723           undo, return error v-error .
      724         end.
      725       end.
      726     end.
      727   end procedure.
      728   procedure factord-end-day :
      729     define input  parameter p-fact-date            as date    no-undo .
      730     define output parameter p-day-end-fact-order   as decimal no-undo .
      731     do
      732     on error undo, return error return-value
      733     :
      734       if p-fact-date = ?
      735       then do:
      736         return error "Не указана фактическая дата" .
      737       end.
      738       assign
      739         p-day-end-fact-order = integer(p-fact-date) + 0.99
      740       .
      741     end.
      742   end procedure.
      743   procedure factord-to-date :
      744     define input  parameter p-fact-order as decimal no-undo .
      745     define output parameter p-fact-date  as date    no-undo .
      746     define variable v-ref-date  as date      no-undo .
      747     define variable v-ref-delta as integer   no-undo .
      748     do
      749     on error undo, return error return-value
      750     :
      751       if p-fact-order = ?
      752       or p-fact-order = 0
      753       then do:
      754         return error "Не указан fact-order" .
      755       end.
      756       assign
      757         v-ref-date  = date(1, 1, 2000)
      758       .
      759       assign
      760         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      761       .
      762       assign
      763         p-fact-date = v-ref-date + v-ref-delta
      764       .
      765     end.
      766   end procedure.
      767   procedure factord-to-fact-num :
      768     define input  parameter p-fact-order as decimal no-undo .
      769     define output parameter p-fact-num   as integer no-undo .
      770     define variable v-fact-order-trunc as decimal no-undo .
      771     do
      772     on error undo, return error return-value
      773     :
      774       if p-fact-order = ?
      775       or p-fact-order = 0
      776       then do:
      777         return error "Не указан fact-order" .
      778       end.
      779       assign
      780        v-fact-order-trunc = truncate(p-fact-order, 2)
      781       .
      782       assign
      783         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      784       .
      785     end.
      786   end procedure.
      787   procedure factord-to-shift-num :
      788     define input  parameter p-fact-order as decimal no-undo .
      789     define output parameter p-shift-num   as integer no-undo .
      790     define variable  p-shift-numd  as decimal   no-undo .
      791     define variable v-fact-order-trunc as decimal no-undo .
      792     do
      793     on error undo, return error return-value
      794     :
      795       if p-fact-order = ?
      796       or p-fact-order = 0
      797       then do:
      798         return error "Не указан fact-order" .
      799       end.
      800       assign
      801        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      802       .
      803       if v-fact-order-trunc < 0.5 then do:
      804         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      805       end.
      806       assign
      807         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      808         .
      809        assign
      810         p-shift-num = truncate (p-shift-numd , 0)
      811       .
      812     end.
      813   end procedure.
      814   define new global shared variable g#lib-trn  as handle no-undo .
      815   define new global shared variable g#lib-trn2 as handle no-undo .
      816   define new global shared variable g#lib-trn3 as handle no-undo .
      817   define new global shared variable g#lib-trn4 as handle no-undo .
      818   define temp-table  tt-tax no-undo
      819     field tax-code    like ub.tax.tax-code
      820     field individual  like ub.tax.individual
      821     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      822     field rate-code   like ub.tax-rate.rate-code
      823     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      824     field tax-type    like ub.tax.tax-type
      825     field rate-value  like ub.tax-rate-value.rate-value
      826     field tax-rate-gds-rc  as recid
      827     field to-cashdesk like ub.tax.to-cashdesk
      828     index tax-code is unique primary tax-code
      829     .
      830   procedure tax-val :
      831     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      832     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      833     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      834     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      835     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      836     define input  parameter       parunits-type like ub.units.type         no-undo.
      837     define input  parameter       parrec-id     as recid                   no-undo.
      838     define input  parameter       paris-log     as logical                 no-undo.
      839     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      840     define input  parameter       vattaxcdvalue as integer                 no-undo.
      841     define input  parameter       exctaxcdvalue as integer                 no-undo.
      842     define input  parameter       only-check    as logical                 no-undo.
      843     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      844     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      845     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      846     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      847     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      848     define output parameter       parerr-mes    as character               no-undo.
      849     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      850     do
      851     on error undo, return error return-value
      852     :
      853   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      855   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      856   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      857   define variable gp-excise     like ub.price-list.excise     no-undo.
      858   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      859   define variable gp-fact-order as decimal   no-undo .
      860   define variable gp-price-sale-parts as decimal   no-undo .
      861       define buffer buf_tax          for ub.tax .
      862       define buffer buf_tax-rate     for ub.tax-rate .
      863       define buffer buf_tax-units    for ub.tax-units .
      864       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      865       define buffer buf_goods        for ub.goods .
      866       define buffer buf_bar-code     for ub.bar-code .
      867       define buffer buf_prod-bc      for ub.prod-bc .
      868       define buffer buf_units        for ub.units .
      869       define buffer buf_shop         for ub.shop .
      870       define buffer buf_store        for ub.store .
      871       define buffer buf_gds-prt      for ub.gds-prt .
      872       define buffer buf_tt-tax       for tt-tax .
      873       define variable varrate-value    as decimal   initial ? no-undo.
      874       define variable pr-list-recid    as recid     initial ? no-undo.
      875       define variable varmes           as character no-undo.
      876       define variable varfactorrtvalue as char      initial ? no-undo.
      877       define variable varfactorrttype  as char      initial ? no-undo.
      878       define variable is-petrolium     as logical no-undo.
      879       define variable is-pieces        as logical no-undo.
      880       define variable vargds-code      like ub.goods.gds-code no-undo.
      881       define variable pargds-code      like ub.goods.gds-code no-undo.
      882       define variable var-fact-order   as decimal no-undo .
      883       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      884       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      885       define variable currate-gds-rc   as recid no-undo .
      886       define variable v-today          as date no-undo .
      887       define variable v-time           as integer no-undo .
      888       for each buf_tt-tax:
      889         delete buf_tt-tax.
      890       end.
      891       run cur-time in this-procedure(output v-today, output v-time).
      892       run factord-end-day in this-procedure (input v-today, output var-fact-order).
      893       if parartic     = ?
      894       or parprod-type = ?
      895       or parprod-code = ?
      896       or parunit-base = ?
      897       then do:
      898         find first buf_goods no-lock
      899           where recid(buf_goods) = parrec-id
      900           no-error .
      901       end.
      902       else do:
      903         find first buf_goods no-lock
      904           where buf_goods.artic = parartic
      905             and buf_goods.prod-type = parprod-type
      906             and buf_goods.prod-code = parprod-code
      907           no-error .
      908       end.
      909       if not available buf_goods then do:
      910         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
      911         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      912       end.
      913       assign
      914         parartic     = buf_goods.artic
      915         parprod-type = buf_goods.prod-type
      916         parprod-code = buf_goods.prod-code
      917         parunit-base = buf_goods.unit-base
      918         pargds-code  = buf_goods.gds-code
      919       .
      920       if parunits-type = ?
      921       then do:
      922         find buf_units no-lock
      923           where buf_units.unit-name = parunit-base
      924           no-error .
      925         if not available buf_units then do:
      926           assign
      927             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
      928           .
      929           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      930         end.
      931         assign
      932           parunits-type = buf_units.type
      933         .
      934       end.
      935       if parhost-code = ?
      936       or parhost-code = 0
      937       then do:
      938   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      939   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      940     (input  parobj-type
      941     ,input  abs(parobj-code)
      942     ,output parhost-code
      943     ) no-error .
      944         if error-status :error then do:
      945           assign
      946             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
      947               ,string(parobj-type)
      948               ,string(parobj-code)
      949               ) + chr(10)
      950           .
      951           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      952         end.
      953       end.
      954       assign
      955         vargds-code = buf_goods.gds-code
      956       .
      957       for each buf_tax-units no-lock
      958         where LOOKUP(buf_tax-units.type, parunits-type) > 0
      959       ,first buf_tax no-lock
      960         where buf_tax.tax-code = buf_tax-units.tax-code
      961       :
      962         find first buf_tt-tax where
      963                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
      964         if not available buf_tt-tax then do:
      965           create buf_tt-tax .
      966         end.
      967         assign
      968           buf_tt-tax.tax-code = buf_tax.tax-code
      969         .
      970         if buf_tax.individual = false then do:
      971           assign
      972             currate-gds-rc = ?
      973           .
      974           _tax-rate-gds:
      975           for each buf_tax-rate-gds no-lock where
      976                   buf_tax-rate-gds.gds-code = pargds-code and
      977                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
      978           first buf_tax-rate where
      979                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
      980                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
      981           by buf_tax-rate-gds.host-code
      982           by buf_tax-rate-gds.obj-type
      983           by buf_tax-rate-gds.obj-code
      984           by buf_tax-rate-gds.fact-order
      985           :
      986             if buf_tax-rate-gds.fact-order > var-fact-order then do:
      987               next _tax-rate-gds.
      988             end.
      989             if buf_tax-rate-gds.host-code = 0 or
      990               ((buf_tax-rate-gds.host-code = parhost-code) or
      991               (buf_tax-rate-gds.obj-type = parobj-type AND
      992               buf_tax-rate-gds.obj-code = parobj-code))
      993             then do:
      994               assign
      995               currate-code = buf_tax-rate.rate-code
      996               currate-name = buf_tax-rate.rate-name
