     1867   define stream stmXMLLog.
     1868   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1869   procedure cur-time :
     1870      define output parameter p-today as date      no-undo .
     1871      define output parameter p-time  as integer   no-undo .
     1872     do
     1873     on error undo, return error
     1874     :
     1875       define variable v-date1 as date      no-undo .
     1876       define variable v-date2 as date      no-undo .
     1877       define variable v-time  as integer   no-undo .
     1878       assign
     1879         v-date1 = today
     1880         v-time  = time
     1881         v-date2 = today
     1882       .
     1883       if v-date1 <> v-date2
     1884       then do:
     1885         assign
     1886           v-date1 = today
     1887           v-time  = v-time
     1888         .
     1889       end.
     1890       assign
     1891         p-today = v-date1
     1892         p-time  = v-time
     1893       .
     1894     end.
     1895   end.
     1896   function cur-time-date returns character
     1897   :
     1898     return string(today, '99/99/9999':U) .
     1899   end.
     1900   function cur-time-mjd returns decimal
     1901   :
     1902     define variable v-date as date      no-undo .
     1903     define variable v-time as integer   no-undo .
     1904     run cur-time in this-procedure
     1905       (output v-date
     1906       ,output v-time
     1907       ) .
     1908     return integer(v-date) - 2400002 + (v-time / 86400) .
     1909   end.
     1910   function cur-time-get-ending-index returns integer
     1911   (input p-number as integer
     1912   )
     1913   :
     1914     if p-number < 0
     1915     or p-number = ?
     1916     then do:
     1917       return 1 .
     1918     end.
     1919     define variable v-rest as integer   no-undo .
     1920     assign
     1921       p-number = p-number modulo 100
     1922     .
     1923     if p-number < 20
     1924     then do:
     1925       assign
     1926         v-rest = p-number
     1927       .
     1928     end.
     1929     else do:
     1930       assign
     1931         v-rest = p-number modulo 10
     1932       .
     1933     end.
     1934     case v-rest :
     1935       when 1
     1936       then do:
     1937         return 2 .
     1938       end.
     1939       when 2 or
     1940       when 3 or
     1941       when 4
     1942       then do:
     1943         return 3 .
     1944       end.
     1945       otherwise do:
     1946         return 1 .
     1947       end.
     1948     end case .
     1949   end.
     1950   procedure cur-time-mjd-to-date :
     1951      define input  parameter i-mjd-diff as decimal no-undo.
     1952      define output parameter o-Date     as date    no-undo.
     1953      define output parameter o-Time     as integer no-undo.
     1954      define variable v-day-number as integer   no-undo .
     1955      if    i-mjd-diff < 0
     1956         or i-mjd-diff = ?
     1957      then do:
     1958         return "?" .
     1959      end.
     1960      assign
     1961         v-day-number = truncate(i-mjd-diff,0).
     1962         o-Date = date(v-day-number + 2400002).
     1963         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1964     .
     1965   end.
     1966   function cur-time-mjd-to-string returns character
     1967   (input p-mjd-diff as decimal
     1968   )
     1969   :
     1970     define variable v-day-number as integer   no-undo .
     1971     define variable v-seconds    as integer   no-undo .
     1972     define variable v-hour       as integer   no-undo .
     1973     define variable v-min        as integer   no-undo .
     1974     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1975     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1976     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1977     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1978     if p-mjd-diff < 0
     1979     or p-mjd-diff = ?
     1980     then do:
     1981       return "?" .
     1982     end.
     1983     assign
     1984       v-day-number = integer(truncate(p-mjd-diff,0))
     1985       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1986     .
     1987     if v-seconds > 86400
     1988     then do:
     1989       assign
     1990         v-seconds = 86400 - 1
     1991       .
     1992     end.
     1993     if v-seconds < 0
     1994     then do:
     1995       assign
     1996         v-seconds = 0
     1997       .
     1998     end.
     1999     assign
     2000       v-hour = truncate(v-seconds / 3600, 0)
     2001     .
     2002     assign
     2003       v-seconds = v-seconds modulo 3600
     2004     .
     2005     assign
     2006       v-min = truncate(v-seconds / 60, 0)
     2007     .
     2008     assign
     2009       v-seconds = v-seconds modulo 60
     2010     .
     2011     return
     2012         (if v-day-number <> 0
     2013           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2014           else ""
     2015         )
     2016       + (if v-day-number <> 0 or v-hour <> 0
     2017           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2018           else ""
     2019         )
     2020       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2021           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2022           else ""
     2023         )
     2024       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2025       .
     2026   end.
     2027   function cur-time-string returns character
     2028   :
     2029     define variable v-date as date      no-undo .
     2030     define variable v-time as integer   no-undo .
     2031     run cur-time in this-procedure
     2032       (output v-date
     2033       ,output v-time
     2034       ) .
     2035     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2036   end.
     2037   function cur-time-string-sec returns character
     2038   :
     2039     define variable v-date as date      no-undo .
     2040     define variable v-time as integer   no-undo .
     2041     run cur-time in this-procedure
     2042       (output v-date
     2043       ,output v-time
     2044       ) .
     2045     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2046   end.
     2047   function cur-time-custom  returns character
     2048   (input p-prefix as character
     2049   ,input p-date-format as character
     2050   ,input p-delimiter as character
     2051   ,input p-time-format as character
     2052   ,input p-suffix as character
     2053   )
     2054   :
     2055     define variable v-date as date      no-undo .
     2056     define variable v-time as integer   no-undo .
     2057     run cur-time in this-procedure
     2058       (output v-date
     2059       ,output v-time
     2060       ) .
     2061     return
     2062       p-prefix
     2063       + string(v-date, p-date-format)
     2064       + p-delimiter
     2065       + string(v-time, p-time-format)
     2066       + p-suffix
     2067       .
     2068   end.
     2069   function cur-time-print  returns character
     2070   :
     2071     define variable v-date as date      no-undo .
     2072     define variable v-time as integer   no-undo .
     2073     run cur-time in this-procedure
     2074       (output v-date
     2075       ,output v-time
     2076       ) .
     2077     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2078   end.
     2079   function cur-time-datetime returns datetime
     2080   :
     2081     define variable v-char as character no-undo .
     2082     define variable v-datetime as datetime no-undo .
     2083     v-char = cur-time-string().
     2084     v-datetime = datetime(v-char).
     2085     return  v-datetime.
     2086   end.
     2087   function cur-time-string-msec returns character
     2088   :
     2089     define variable v-date as datetime  no-undo .
     2090     v-date = now.
     2091     return string(v-date) .
     2092   end.
     2093   define variable vss-include-info26 as character format "X(65)" no-undo
     2094   initial "@(#)$Workfile$ $Revision$".
     2095   procedure xmlchar-test :
     2096   define input parameter p-in-string          as character        no-undo.
     2097   define output parameter p-out-string-enc    as character        no-undo.
     2098   define output parameter p-out-string-dec    as character        no-undo.
     2099   do
     2100   on error undo, return error
     2101   :
     2102          run xmlchar-encode in this-procedure
     2103       (
     2104             input p-in-string
     2105           , output p-out-string-enc
     2106       ).
     2107          run xmlchar-decode in this-procedure
     2108       (
     2109             input p-out-string-enc
     2110           , output p-out-string-dec
     2111       ).
     2112   end.
     2113   end .
     2114   procedure xmlchar-encode :
     2115   define input parameter p-in-string      as character        no-undo.
     2116   define output parameter p-out-string    as character        no-undo.
     2117       define variable v-position      as integer      no-undo.
     2118       define variable v-current-char  as character    no-undo.
     2119   do
     2120   on error undo, return error
     2121   :
     2122       assign
     2123           p-out-string = "":U
     2124       .
     2125       case p-in-string
     2126       :
     2127           when ?
     2128           then do:
     2129               assign
     2130                   p-out-string = "?":U
     2131               .
     2132           end.
     2133           when "?":U
     2134           then do:
     2135               assign
     2136                   p-out-string = "&#63;":U
     2137               .
     2138           end.
     2139           otherwise do:
     2140               do v-position = 1 to length( p-in-string )
     2141               :
     2142                   assign
     2143                       v-current-char = substring( p-in-string, v-position, 1 )
     2144                   .
     2145                   case v-current-char
     2146                   :
     2147                       when "&":U
     2148                       then do:
     2149                           assign
     2150                               p-out-string = p-out-string + "&amp;":U
     2151                           .
     2152                       end.
     2153                       when ">":U
     2154                       then do:
     2155                           assign
     2156                               p-out-string = p-out-string + "&gt;":U
     2157                           .
     2158                       end.
     2159                       when "<":U
     2160                       then do:
     2161                           assign
     2162                               p-out-string = p-out-string + "&lt;":U
     2163                           .
     2164                       end.
     2165                       when "'":U
     2166                       then do:
     2167                           assign
     2168                               p-out-string = p-out-string + "&apos;":U
     2169                           .
     2170                       end.
     2171                       when '"':U
     2172                       then do:
     2173                           assign
     2174                               p-out-string = p-out-string + "&quot;":U
     2175                           .
     2176                       end.
     2177                       when chr(1)
     2178                       then do:
     2179                           assign
     2180                               p-out-string = p-out-string + "":U
     2181                           .
     2182                       end.
     2183                       when chr(2)
     2184                       then do:
     2185                           assign
     2186                               p-out-string = p-out-string + "":U
     2187                           .
     2188                       end.
     2189                       when chr(3)
     2190                       then do:
     2191                           assign
     2192                               p-out-string = p-out-string + "":U
     2193                           .
     2194                       end.
     2195                       when chr(4)
     2196                       then do:
     2197                           assign
     2198                               p-out-string = p-out-string + "":U
     2199                           .
     2200                       end.
     2201                       when chr(5)
     2202                       then do:
     2203                           assign
     2204                               p-out-string = p-out-string + "":U
     2205                           .
     2206                       end.
     2207                       when chr(6)
     2208                       then do:
     2209                           assign
     2210                               p-out-string = p-out-string + "":U
     2211                           .
     2212                       end.
     2213                       when chr(7)
     2214                       then do:
     2215                           assign
     2216                               p-out-string = p-out-string + "":U
     2217                           .
     2218                       end.
     2219                       when chr(8)
     2220                       then do:
     2221                           assign
     2222                               p-out-string = p-out-string + "":U
     2223                           .
     2224                       end.
     2225                       when chr(9)
     2226                       then do:
     2227                           assign
     2228                               p-out-string = p-out-string + "":U
     2229                           .
     2230                       end.
     2231                       when chr(29)
     2232                       then do:
     2233                           assign
     2234                               p-out-string = p-out-string + "":U
     2235                           .
     2236                       end.
     2237                       when chr(10)
     2238                       then do:
     2239                           assign
     2240                               p-out-string = p-out-string + "&#10;":U
     2241                           .
     2242                       end.
     2243                       when chr(13)
     2244                       then do:
     2245                           assign
     2246                               p-out-string = p-out-string + "&#13;":U
     2247                           .
     2248                       end.
     2249                       otherwise do:
     2250                           assign
     2251                               p-out-string = p-out-string + v-current-char
     2252                           .
     2253                       end.
     2254                   end case.
     2255               end.
     2256           end.
     2257       end case.
     2258   end.
     2259   end .
     2260   procedure xmlchar-encode-1c :
     2261   define input parameter p-in-string      as character        no-undo.
     2262   define output parameter p-out-string    as character        no-undo.
     2263       define variable v-position      as integer      no-undo.
     2264       define variable v-current-char  as character    no-undo.
     2265   do
     2266   on error undo, return error
     2267   :
     2268       assign
     2269           p-out-string = "":U
     2270       .
     2271       case p-in-string
     2272       :
     2273           when ?
     2274           then do:
     2275               assign
     2276                   p-out-string = "?":U
     2277               .
     2278           end.
     2279           otherwise do:
     2280               do v-position = 1 to length( p-in-string )
     2281               :
     2282                   assign
     2283                       v-current-char = substring( p-in-string, v-position, 1 )
     2284                   .
     2285                   case v-current-char
     2286                   :
     2287                       when chr(1)
     2288                       then do:
     2289                           assign
     2290                               p-out-string = p-out-string + " ":U
     2291                           .
     2292                       end.
     2293                       when chr(2)
     2294                       then do:
     2295                           assign
     2296                               p-out-string = p-out-string + " ":U
     2297                           .
     2298                       end.
     2299                       when chr(3)
     2300                       then do:
     2301                           assign
     2302                               p-out-string = p-out-string + " ":U
     2303                           .
     2304                       end.
     2305                       when chr(4)
     2306                       then do:
     2307                           assign
     2308                               p-out-string = p-out-string + " ":U
     2309                           .
     2310                       end.
     2311                       when chr(5)
     2312                       then do:
     2313                           assign
     2314                               p-out-string = p-out-string + " ":U
     2315                           .
     2316                       end.
     2317                       when chr(6)
     2318                       then do:
     2319                           assign
     2320                               p-out-string = p-out-string + " ":U
     2321                           .
     2322                       end.
     2323                       when chr(7)
     2324                       then do:
     2325                           assign
     2326                               p-out-string = p-out-string + " ":U
     2327                           .
     2328                       end.
     2329                       when chr(8)
     2330                       then do:
     2331                           assign
     2332                               p-out-string = p-out-string + " ":U
     2333                           .
     2334                       end.
     2335                       when chr(9)
     2336                       then do:
     2337                           assign
     2338                               p-out-string = p-out-string + " ":U
     2339                           .
     2340                       end.
     2341                       when chr(29)
     2342                       then do:
     2343                           assign
     2344                               p-out-string = p-out-string + " ":U
     2345                           .
     2346                       end.
     2347                       when chr(10)
     2348                       then do:
     2349                           assign
     2350                               p-out-string = p-out-string + " ":U
     2351                           .
     2352                       end.
     2353                       when chr(13)
     2354                       then do:
     2355                           assign
     2356                               p-out-string = p-out-string + " ":U
     2357                           .
     2358                       end.
     2359                       otherwise do:
     2360                           assign
     2361                               p-out-string = p-out-string + v-current-char
     2362                           .
     2363                       end.
     2364                   end case.
     2365               end.
     2366           end.
     2367       end case.
     2368   end.
     2369   end .
     2370   procedure xmlchar-decode :
     2371   define input parameter p-in-string      as character        no-undo.
     2372   define output parameter p-out-string    as character        no-undo.
     2373       define variable v-position      as integer      no-undo.
     2374       define variable v-last-position as integer      no-undo.
     2375       define variable v-temp-integer  as integer      no-undo.
     2376       define variable v-current-char  as character    no-undo.
     2377       define variable v-next-char     as character    no-undo.
     2378       define variable v-success       as logical      no-undo.
     2379   do
     2380   on error undo, return error
     2381   :
     2382       assign
     2383           p-out-string = "":U
     2384           v-position   = 0
     2385       .
     2386       replace-cycle:
     2387       do while yes
     2388       on error undo, return error
     2389       :
     2390           assign
     2391               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2392           .
     2393           if v-last-position <= v-position
     2394           then do:
     2395               if v-position = 0
     2396               then do:
     2397                   assign
     2398                       p-out-string = p-in-string
     2399                   .
     2400               end.
     2401               else do:
     2402                   assign
     2403                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2404                   .
     2405               end.
     2406               leave replace-cycle.
     2407           end.
     2408           else do:
     2409               assign
     2410                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2411                   v-position      = v-last-position
     2412                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2413               .
     2414               if v-current-char = "#":U
     2415               then do:
     2416                   assign
     2417                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2418                   .
     2419                   if v-last-position > 0
     2420                   then do:
     2421                       run xmlchar-read-integer in this-procedure
     2422                        (
     2423                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2424                           , output v-temp-integer
     2425                           , output v-success
     2426                       ).
     2427                       if v-success = yes
     2428                       and v-temp-integer >= 1
     2429                       and v-temp-integer <= 255
     2430                       then do:
     2431                           assign
     2432                               p-out-string = p-out-string + chr( v-temp-integer )
     2433                               v-position   = v-last-position + 1
     2434                           .
     2435                       end.
     2436                       else do:
     2437                           assign
     2438                               p-out-string = p-out-string + "&":U
     2439                               v-position   = v-position   + 1
     2440                           .
     2441                       end.
     2442                   end.
     2443                   else do:
     2444                       assign
     2445                           p-out-string = p-out-string + "&":U
     2446                           v-position   = v-position   + 1
     2447                       .
     2448                   end.
     2449               end.
     2450               else do:
     2451                   case substring( p-in-string, v-position + 1, 3 )
     2452                   :
     2453                       when "lt;":U
     2454                       then do:
     2455                           assign
     2456                               p-out-string = p-out-string + "<":U
     2457                               v-position   = v-position   + 3
     2458                           .
     2459                       end.
     2460                       when "gt;":U
     2461                       then do:
     2462                           assign
     2463                               p-out-string = p-out-string + ">":U
     2464                               v-position   = v-position   + 3
     2465                           .
     2466                       end.
     2467                       otherwise do:
     2468                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2469                           then do:
     2470                               assign
     2471                                   p-out-string = p-out-string + "&":U
     2472                                   v-position   = v-position   + 4
     2473                               .
     2474                           end.
     2475                           else do:
     2476                               case substring( p-in-string, v-position + 1, 5 )
     2477                               :
     2478                                   when "quot;":U
     2479                                   then do:
     2480                                       assign
     2481                                           p-out-string = p-out-string + '"':U
     2482                                           v-position   = v-position   + 5
     2483                                       .
     2484                                   end.
     2485                                   when "apos;":U
     2486                                   then do:
     2487                                       assign
     2488                                           p-out-string = p-out-string + "'":U
     2489                                           v-position   = v-position   + 5
     2490                                       .
     2491                                   end.
     2492                                   otherwise do:
     2493                                       assign
     2494                                           p-out-string = p-out-string + "&":U
     2495                                       .
     2496                                   end.
     2497                               end case.
     2498                           end.
     2499                       end.
     2500                   end case.
     2501               end.
     2502           end.
     2503       end.
     2504   end.
     2505   end .
     2506   procedure xmlchar-read-integer :
     2507   define input parameter p-input-string      as character        no-undo.
     2508   define output parameter p-output-integer   as integer          no-undo.
     2509   define output parameter p-success       as logical          no-undo.
     2510   do
     2511   on error undo, return error
     2512   :
     2513       assign
     2514           p-output-integer = integer( p-input-string )
     2515       no-error.
     2516       if error-status :error
     2517       then do:
     2518           assign
     2519               p-success           = no
     2520               p-output-integer    = 0
     2521           .
     2522       end.
     2523       else do:
     2524           assign
     2525               p-success           = yes
     2526           .
     2527       end.
     2528   end.
     2529   end.
     2530   define variable v-bgelib-bgeclall           as logical      no-undo.
     2531   define variable v-bgelib-bgedict            as logical      no-undo.
     2532   define temp-table temp_ext-doc-type no-undo
     2533       field edt-key               as integer
     2534       field ext-doc-type          as character
     2535       field ext-doc-type-label    as character
     2536       index pi is primary unique
     2537           edt-key
     2538   .
     2539   define temp-table temp_bgelib_goods no-undo
     2540       field gds-code as integer
     2541       index pi is primary unique
     2542           gds-code
     2543   .
     2544   define temp-table temp_bgelib_clients no-undo
     2545       field obj-type as character
     2546       field obj-code as integer
     2547       index pi is primary unique
     2548           obj-type
     2549           obj-code
     2550   .
     2551   define temp-table temp_bgelib_dis-card no-undo
     2552       field d-card as character
     2553       index pi is primary unique
     2554           d-card
     2555   .
     2556   define temp-table temp_bgelib_trn-doc no-undo
     2557       field doc-code as integer
     2558   .
     2559   procedure bgelib-tag-open:
     2560   do
     2561   on error undo, return error
     2562   :
     2563   define input parameter v-tag-level  as integer      no-undo.
     2564   define input parameter v-tag-name   as character    no-undo.
     2565   define input parameter v-tag-value  as character    no-undo.
     2566       put stream stmXMLOut unformatted
     2567           chr(10)
     2568           + fill(" ", 4 * v-tag-level)
     2569           + "<" + v-tag-name
     2570           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2571           + v-tag-value + ">"
     2572       .
     2573   end.
     2574   end procedure.
     2575   procedure bgelib-tag-put:
     2576   do
     2577   on error undo, return error
     2578   :
     2579   define input parameter v-tag-level      as integer      no-undo.
     2580   define input parameter v-tag-name       as character    no-undo.
     2581   define input parameter v-tag-value      as character    no-undo.
     2582   define input parameter v-empty-mode     as integer      no-undo.
     2583       v-tag-name = trim(v-tag-name).
     2584       if  v-empty-mode = 1
     2585       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2586       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2587       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2588       then do:
     2589           run xmlchar-encode in this-procedure (
     2590                 input v-tag-value
     2591               , output v-tag-value
     2592           ).
     2593           put stream stmXMLOut unformatted
     2594               chr(10) + fill(" ", 4 * v-tag-level)
     2595                           + '<' + v-tag-name + '>'
     2596                           + v-tag-value
     2597                           + '</' + v-tag-name + '>'
     2598           .
     2599       end.
     2600   end.
     2601   end procedure.
     2602   procedure bgelib-tag-close:
     2603   do
     2604   on error undo, return error
     2605   :
     2606   define input parameter v-tag-level as integer      no-undo.
     2607   define input parameter v-tag-name  as character    no-undo.
     2608       put stream stmXMLOut unformatted
     2609           chr(10)
     2610           + fill( " ", 4 * v-tag-level)
     2611           + '</' + v-tag-name + '>'
     2612       .
     2613   end.
     2614   end procedure.
     2615   procedure bgelib-write-log:
     2616   do
     2617   on error undo, return error
     2618   :
     2619   define input parameter v-filename   as character    no-undo.
     2620   define input parameter v-log-level  as integer      no-undo.
     2621   define input parameter v-out-string as character    no-undo.
     2622       output stream stmXMLLog to value( v-filename ) append.
     2623       put stream stmXMLLog unformatted
     2624           chr(10)
     2625       .
     2626       put stream stmXMLLog unformatted
     2627           ( if v-log-level = 0
     2628             or v-out-string = "&DLine"
     2629             or v-out-string = "&Line"
     2630             then ""
     2631             else cur-time-string-sec() + " " )
     2632       .
     2633       put stream stmXMLLog unformatted
     2634           ( if v-out-string = "&Line"
     2635             then fill( "-", 80 )
     2636             else if v-out-string = "&DLine"
     2637                  then fill( "=", 80 )
     2638                  else v-out-string )
     2639       .
     2640       output stream stmXMLLog close.
     2641   end.
     2642   end procedure.
     2643   procedure bgelib-write-edt:
     2644   do
     2645   on error undo, return error
     2646   :
     2647   define input parameter v-editor-handle    as handle       no-undo.
     2648   define input parameter v-log-level        as integer      no-undo.
     2649   define input parameter v-out-string       as character    no-undo.
     2650       if valid-handle ( v-editor-handle )
     2651       then do:
     2652           v-editor-handle :move-to-eof().
     2653           v-editor-handle :insert-string( ( if v-log-level = 0
     2654                                             or v-out-string = "&DLine"
     2655                                             or v-out-string = "&Line"
     2656                                             then ""
     2657                                             else cur-time-string-sec() + " "
     2658                                         ) ).
     2659           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2660                                             then fill( "-", 80 )
     2661                                             else if v-out-string = "&DLine" then fill("=", 80)
     2662                                             else fill( " ", v-log-level) + v-out-string
     2663                                         ) ).
     2664           v-editor-handle :insert-string( chr(10) ).
     2665       end.
     2666       process events.
     2667       output to 'bgescn.txt' append.
     2668           put unformatted
     2669               chr(10)
     2670               string( ( if v-log-level = 0
     2671                         or v-out-string = "&DLine"
     2672                         or v-out-string = "&Line"
     2673                         then ""
     2674                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2675                     ) )
     2676               string( ( if v-out-string = "&Line"
     2677                         then fill( "-", 80 )
     2678                         else if v-out-string = "&DLine"
     2679                              then fill( "=", 80 )
     2680                              else fill( " ", v-log-level ) + v-out-string
     2681                     ) )
     2682           .
     2683       output close.
     2684   end.
     2685   end procedure.
     2686   procedure bgelib-show-cnt:
     2687   do
     2688   on error undo, return error
     2689   :
     2690   define input parameter v-fillin-handle     as handle   no-undo.
     2691       if valid-handle( v-fillin-handle )
     2692       then do:
     2693           assign
     2694               v-fillin-handle :visible = true
     2695           .
     2696       end.
     2697   end.
     2698   end procedure.
     2699   procedure bgelib-hide-cnt:
     2700   do
     2701   on error undo, return error
     2702   :
     2703   define input parameter v-fillin-handle     as handle   no-undo.
     2704       if valid-handle( v-fillin-handle )
     2705       then do:
     2706           assign v-fillin-handle :visible = false.
     2707       end.
     2708   end.
     2709   end procedure.
     2710   procedure bgelib-write-cnt:
     2711   do
     2712   on error undo, return error
     2713   :
     2714   define input parameter v-fillin-handle    as handle       no-undo.
     2715   define input parameter v-fillin-string    as character    no-undo.
     2716       if valid-handle( v-fillin-handle )
     2717       then do:
     2718           assign
     2719               v-fillin-handle :SCREEN-value = v-fillin-string
     2720           .
     2721       end.
     2722   end.
     2723   end procedure.
     2724   procedure bgelib-write-header:
     2725   do
     2726   on error undo, return error
     2727   :
     2728   define input parameter p-first-file     as logical      no-undo.
     2729   define input parameter p-xml-file-name  as character    no-undo.
     2730   define input parameter p-list-file-name as character    no-undo.
     2731   define input parameter p-file-number    as integer      no-undo.
     2732   define input parameter p-have-prev      as logical      no-undo.
     2733   define input parameter p-prev-filename  as character    no-undo.
     2734   define input parameter p-obj-list       as character    no-undo.
     2735   define input parameter p-doc-type-list  as character    no-undo.
     2736   define input parameter p-parameter-list as character    no-undo.
     2737       define variable v-counter    as integer        no-undo.
     2738       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2739       put stream stmXMLOut unformatted
     2740           "<?xml version='1.0' encoding='windows-1251'?>"
     2741       .
     2742       run bgelib-tag-open( input 0, input "root"  , input "" ).
     2743       run bgelib-tag-open( input 0, input "header", input "" ).
     2744       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2745       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2746       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2747       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2748       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     2749       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2750       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2751       :
     2752           run bgelib-tag-put(
     2753                 input 1
     2754               , input entry( 2 * v-counter, p-parameter-list )
     2755               , input entry( 2 * v-counter + 1, p-parameter-list )
     2756               , input 0
     2757           ).
     2758       end.
     2759       run bgelib-tag-close( input 0, input "header" ).
     2760       output stream stmXMLOut close.
     2761       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2762       if p-first-file = yes
     2763       then do:
     2764           put stream stmXMLOut unformatted
     2765               "<?xml version='1.0' encoding='windows-1251'?>"
     2766           .
     2767           run bgelib-tag-open( input 0, input "export", input "" ).
     2768       end.
     2769       run bgelib-tag-open( input 1, input "file", input "" ).
     2770       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2771       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2772       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2773       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2774       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2775       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2776       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2777       :
     2778           run bgelib-tag-put(
     2779                 input 2
     2780               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2781               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2782               , input 0
     2783           ).
     2784       end.
     2785       run bgelib-tag-close( input 1, input "file" ).
     2786       output stream stmXMLOut close.
     2787   end.
     2788   end procedure.
     2789   procedure bgelib-write-footer:
     2790   do
     2791   on error undo, return error
     2792   :
     2793   define input parameter p-last-file      as logical      no-undo.
     2794   define input parameter p-xml-file-name  as character    no-undo.
     2795   define input parameter p-list-file-name as character    no-undo.
     2796   define input parameter p-have-next      as logical      no-undo.
     2797   define input parameter p-next-file-name as character    no-undo.
     2798       define variable v-error-num     as integer           no-undo.
     2799       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2800       if p-have-next = yes
     2801       then do:
     2802           run bgelib-tag-open( input 0, input "footer", "" ).
     2803           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2804           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2805           run bgelib-tag-close( input 0, input "footer" ).
     2806       end.
     2807       run bgelib-tag-close( input 0, input "root" ).
     2808       output stream stmXMLOut close.
     2809       run bge/os_copy.p (
     2810             input "M"
     2811           , input p-xml-file-name + "tmp"
     2812           , input p-xml-file-name + "xml"
     2813           , output v-error-num
     2814       ).
     2815       if p-last-file = yes
     2816       then do:
     2817           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2818               run bgelib-tag-close( input 0, input "export" ).
     2819           output stream stmXMLOut close.
     2820           run bge/os_copy.p (
     2821                 input "M"
     2822               , input p-list-file-name + "tmp"
     2823               , input p-list-file-name + "xml"
     2824               , output v-error-num
     2825           ).
     2826       end.
     2827   end.
     2828   end procedure.
     2829   procedure bgelib-filename :
     2830   do
     2831   on error undo, return error
     2832   :
     2833   define input parameter p-prefix             as character    no-undo.
     2834   define output parameter p-xml-file-name     as character    no-undo.
     2835   define output parameter p-log-file-name     as character    no-undo.
     2836   define output parameter p-list-file-name    as character    no-undo.
     2837       define variable v-home-dir  as character    no-undo.
     2838       define variable v-error-num as integer      no-undo.
     2839       get-key-value section "BGE" key "outdir" value v-home-dir.
     2840       if v-home-dir = ?
     2841       then do:
     2842           message
     2843             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2844             skip(1)
     2845             skip "Обратитесь к администратору."
     2846           view-as alert-box error.
     2847           undo, return error .
     2848       end.
     2849       run gbl/dir-cre.p (
     2850           input v-home-dir
     2851       ) no-error.
     2852       if error-status :error
     2853       then do:
     2854           message
     2855             skip "Неверно задан каталог экспорта."
     2856             skip(1)
     2857             skip "Обратитесь к администратору."
     2858           view-as alert-box error.
     2859           undo, return error .
     2860       end.
     2861       run bge/genfname.p (
     2862             input v-home-dir
     2863           , input p-prefix
     2864           , input ""
     2865           , input "xml"
     2866           , input "tmp"
     2867           , output p-xml-file-name
     2868       ).
     2869       assign
     2870           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2871           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2872           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2873       .
     2874   end.
     2875   end procedure.
     2876   procedure bgelib-read-config :
     2877   do
     2878   on error undo, return error
     2879   :
     2880   define variable v-par-type as character     no-undo.
     2881     define variable v-param-type      as character  no-undo .
     2882     define variable v-value-character as character  no-undo .
     2883     define variable v-value-date      as date       no-undo .
     2884     define variable v-value-decimal   as decimal    no-undo .
     2885     define variable v-value-integer   as integer    no-undo .
     2886     define variable v-value-logical   as logical    no-undo .
     2887     define variable v-tth             as handle     no-undo .
     2888       assign
     2889           v-bgelib-bgeclall = no
     2890           v-bgelib-bgedict  = no
     2891       .
     2892       run adm/shattri.p ( input "get":U
     2893                         , input  '':u
     2894                         , input  0
     2895                         , input  'bge-export':U
     2896                         , input  'bgeclall':U
     2897                         , output v-value-character
     2898                         , output v-value-date
     2899                         , output v-value-decimal
     2900                         , output v-value-integer
     2901                         , output v-value-logical
     2902                         , output v-param-type
     2903                         , input-output table-handle v-tth
     2904                         ) no-error .
     2905       if error-status :error
     2906       then do:
     2907         assign
     2908           v-bgelib-bgeclall = no
     2909         .
     2910       end.
     2911       else do:
     2912         assign
     2913           v-bgelib-bgeclall = v-value-logical
     2914         .
     2915       end.
     2916       delete object v-tth.
     2917       run adm/shattri.p ( input "get":U
     2918                         , input  '':u
     2919                         , input  0
     2920                         , input  'bge-export':U
     2921                         , input  'bgedict':U
     2922                         , output v-value-character
     2923                         , output v-value-date
     2924                         , output v-value-decimal
     2925                         , output v-value-integer
     2926                         , output v-value-logical
     2927                         , output v-param-type
     2928                         , input-output table-handle v-tth
     2929                         ) no-error .
     2930       if error-status :error
     2931       then do:
     2932         assign
     2933           v-bgelib-bgedict = no
     2934         .
     2935       end.
     2936       else do:
     2937         assign
     2938           v-bgelib-bgedict = v-value-logical
     2939         .
     2940       end.
     2941       delete object v-tth.
     2942       run adm/shattri.p ( input "get":U
     2943                         , input  '':u
     2944                         , input  0
     2945                         , input  'bge-export':U
     2946                         , input  'bgefmt':U
     2947                         , output v-value-character
     2948                         , output v-value-date
     2949                         , output v-value-decimal
     2950                         , output v-value-integer
     2951                         , output v-value-logical
     2952                         , output v-param-type
     2953                         , input-output table-handle v-tth
     2954                         ) no-error .
     2955       if error-status :error
     2956       then do:
     2957         assign
     2958           v-bgelib-bgefmt  = "xml":U
     2959         .
     2960       end.
     2961       else do:
     2962         assign
     2963           v-bgelib-bgefmt  = v-value-character
     2964         .
     2965       end.
     2966       delete object v-tth.
     2967       run adm/shattri.p ( input "get":U
     2968                         , input  '':u
     2969                         , input  0
     2970                         , input  'bge-export':U
     2971                         , input  'bgeflold':U
     2972                         , output v-value-character
     2973                         , output v-value-date
     2974                         , output v-value-decimal
     2975                         , output v-value-integer
     2976                         , output v-value-logical
     2977                         , output v-param-type
     2978                         , input-output table-handle v-tth
     2979                         ) no-error .
     2980       if error-status :error
     2981       then do:
     2982         assign
     2983           v-bgelib-bgeflold  = "old":U
     2984         .
     2985       end.
     2986       else do:
     2987         assign
     2988           v-bgelib-bgeflold  = v-value-character
     2989         .
     2990       end.
     2991       delete object v-tth.
     2992   end.
     2993   end procedure.
     2994   procedure bgelib-check-file-size :
     2995   do
     2996   on error undo, return error
     2997   :
     2998   define input parameter p-out-filename   as character    no-undo.
     2999   define output parameter p-is-big        as logical      no-undo.
     3000       define variable v-current-position    as integer        no-undo.
     3001       assign
     3002           v-current-position = seek( stmXMLOut )
     3003       .
     3004       if v-current-position / 1024 / 1024  >= 100
     3005       then do:
     3006           assign
     3007               p-is-big = yes
     3008           .
     3009       end.
     3010   end.
     3011   end procedure.
     3012   procedure bgelib-init-ext-doc-type :
     3013       define variable v-counter    as integer      no-undo.
     3014       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     3015   do
     3016   for buf_temp_ext-doc-type
     3017   on error undo, return error
     3018   :
     3019       empty temp-table buf_temp_ext-doc-type.
     3020       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3021       :
     3022           create buf_temp_ext-doc-type.
     3023           assign
     3024               buf_temp_ext-doc-type.edt-key               = v-counter
     3025               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3026               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     3027           .
     3028       end.
     3029   end.
     3030   end procedure.
     3031   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3032   define variable v-xml-file-name     as character            no-undo.
     3033   define variable v-xml-file-name-path as character            no-undo.
     3034   define variable v-log-file-name     as character            no-undo.
     3035   define variable v-locked            as logical              no-undo.
     3036   define variable v-log-string        as character            no-undo.
     3037   define variable v-oper-num          as integer              no-undo.
     3038   define variable v-obj-list          as character            no-undo.
     3039   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     3040   DEF VAR intRep      AS INT NO-UNDO.
     3041   define variable hEDT             AS HANDLE NO-UNDO.
