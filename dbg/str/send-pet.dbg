     6315   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6316   define buffer buf_price-all              for ub.price-all  .
     6317   define buffer buf_goods                  for ub.goods      .
     6318   define buffer buf_global-state           for ub.global-state  .
     6319   define buffer buf_buyer-group            for ub.buyer-group  .
     6320   define buffer buf_turnover-group         for ub.turnover-group  .
     6321   define buffer buf_main-code              for ub.bar-code  .
     6322   define buffer buf_bar-code               for ub.bar-code  .
     6323   define buffer buf_pay-type               for ub.pay-type  .
     6324   define buffer buf_cash-pay               for ub.cash-pay  .
     6325   define variable to-day          as date      no-undo .
     6326   define variable v-base-rate0    as decimal   no-undo .
     6327   define variable v-base-scale0   as decimal   no-undo .
     6328   define variable v-exch-rate0    as decimal   no-undo .
     6329   define variable v-exch-scale0   as decimal   no-undo .
     6330   define variable v-base-rate     as decimal   no-undo .
     6331   define variable v-base-scale    as decimal   no-undo .
     6332   define variable v-exch-rate     as decimal   no-undo .
     6333   define variable v-exch-scale    as decimal   no-undo .
     6334   define variable v-host-code     as integer   no-undo .
     6335   define variable v-curr-abbr     as character no-undo .
     6336   define variable v-grp-name      as character no-undo .
     6337   define variable v-date-1        as date      no-undo .
     6338   define variable v-date-2        as date      no-undo .
     6339   define variable v-interv        as character no-undo .
     6340   define variable v-pay-name      as character no-undo .
     6341   define variable v-cli-oborot    as decimal   no-undo .
     6342   define variable v-trn-pay-code  as integer   no-undo .
     6343   define variable v-cash-pay-curr as integer   no-undo .
     6344   define variable v-cash-pay-code as integer   no-undo .
     6345   do
     6346   on error undo, return error return-value
     6347   :
     6348   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6349   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6350   if p-fact-order = ? then do:
     6351     run fact-order-mpl (
     6352         input   today       ,
     6353         input   p-obj-type  ,
     6354         input   p-obj-code  ,
     6355         output  p-fact-order ).
     6356   end.
     6357   if p-vid-pay <> "" then do:
     6358      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6359      if available buf_pay-type
     6360         then v-trn-pay-code = buf_pay-type.obj-code.
     6361         else v-trn-pay-code =  0.
     6362   end.
     6363   else v-trn-pay-code = 0 .
     6364   if p-cash-pay-type <> "" then do:
     6365      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6366      if available buf_pay-type
     6367         then
     6368           assign
     6369             v-cash-pay-curr = buf_cash-pay.curr-code
     6370             v-cash-pay-code = buf_cash-pay.cdpay-code
     6371           .
     6372         else
     6373           assign
     6374             v-cash-pay-curr = 0
     6375             v-cash-pay-code = 0
     6376             .
     6377   end.
     6378   else
     6379     assign
     6380       v-cash-pay-curr = 0
     6381       v-cash-pay-code = 0
     6382       .
     6383   for each tt_price-all  : delete tt_price-all . end.
     6384   assign
     6385     p-plt-id             = ?
     6386     p-plt-db-num         = ?
     6387     p-pdf-id             = ?
     6388     p-pdf-db-num         = ?
     6389     p-sale-price-base    = ?
     6390     p-sale-price-rubl    = ?
     6391     v-cli-oborot         = 0
     6392   .
     6393   find first buf_global-state no-lock no-error .
     6394   if not available buf_global-state then do:
     6395      message
     6396        "Не заданы параметры ценообразования!"
     6397        view-as alert-box error
     6398      .
     6399      return error return-value .
     6400   end.
     6401   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6403     (input  p-obj-type
     6404     ,input  p-obj-code
     6405     ,output to-day
     6406     )  .
     6407   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6408   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6409     (input  p-obj-type
     6410     ,input  p-obj-code
     6411     ,output v-host-code
     6412     )  .
     6413   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6415     (input  v-host-code
     6416     ,input  to-day
     6417     ,output v-base-rate0
     6418     ,output v-base-scale0
     6419     )  .
     6420     v-cli-oborot-ALL  = 0 .
     6421     for each buf_turnover-buyer-main no-lock  where
     6422              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6423              buf_turnover-buyer-main.cli-code = p-cli-code
     6424              :
     6425              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6426     end.
     6427   for each buf_price-all no-lock where
     6428            buf_price-all.obj-type = p-obj-type and
     6429            buf_price-all.obj-code = p-obj-code and
     6430            buf_price-all.gds-code = buf_goods.gds-code and
     6431            buf_price-all.status_  = 'акт':U  and
     6432          ( p-only-b-code = false   or
     6433          ( buf_price-all.b-code = p-main-b-code or
     6434            buf_price-all.b-code = p-b-code))    and
     6435           ( p-only-b-code = true  or
     6436             buf_price-all.b-code = p-b-code)
     6437             and
     6438             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6439           ( buf_price-all.fact-order-sys-to = ? or
     6440             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6441           :
     6442            v-interv   = "" .
     6443            v-grp-name = "" .
     6444            v-pay-name = "" .
     6445            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6446            if buf_price-all.bgr-id > 0 then do:
     6447               find first buf_buyer-group no-lock where
     6448                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6449                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6450               if available buf_buyer-group then do:
     6451                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6452                  find first buf_buyer-in-buyer-group no-lock where
     6453                             buf_buyer-in-buyer-group.stts         = 0 and
     6454                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6455                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6456                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6457                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6458                             no-error .
     6459                             if not available buf_buyer-in-buyer-group then do:
     6460                                v-grp-name = "".
     6461                                next.
     6462                             end.
     6463                             v-grp-name = buf_buyer-group.name .
     6464                  end.
     6465               end.
     6466               else do:
     6467                    v-grp-name = "".
     6468                    next.
     6469               end.
     6470            end.
     6471            if buf_price-all.tog-id > 0 then do:
     6472               find first buf_turnover-group no-lock where
     6473                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6474                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6475               if available buf_turnover-group then do:
     6476                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6477                     v-cli-oborot = v-cli-oborot-all  .
     6478                     find first buf1_tnv-in-turnover-group no-lock where
     6479                                buf1_tnv-in-turnover-group.stts       =  0     and
     6480                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6481                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6482                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6483                     find first buf2_tnv-in-turnover-group no-lock where
     6484                                buf2_tnv-in-turnover-group.stts       =  0     and
     6485                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6486                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6487                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6488                     if not (available buf1_tnv-in-turnover-group and
     6489                             available buf2_tnv-in-turnover-group ) then do:
     6490                             v-grp-name = "".
     6491                             next .
     6492                     end.
     6493                     v-grp-name = buf_turnover-group.name.
     6494                  end.
     6495               end.
     6496               else do:
     6497                    v-grp-name = "".
     6498                    next.
     6499               end.
     6500            end.
     6501            if buf_price-all.plt-fix-cource-crc-base = true then
     6502               assign
     6503                 v-base-rate  = buf_price-all.pdf-base-rate
     6504                 v-base-scale = buf_price-all.pdf-base-scale
     6505               .
     6506               else
     6507               assign
     6508                 v-base-rate  = v-base-rate0
     6509                 v-base-scale = v-base-scale0
     6510               .
     6511            if buf_price-all.plt-fix-cource-crc-doc = true then
     6512               assign
     6513                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6514                 v-exch-scale = buf_price-all.pdf-exch-scale
     6515               .
     6516               else do:
     6517   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6518   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6519     (input  buf_price-all.curr-code
     6520     ,input  to-day
     6521     ,output v-exch-rate0
     6522     ,output v-exch-scale0
     6523     ,output v-curr-abbr
     6524     )  .
     6525               assign
     6526                 v-exch-rate  = v-exch-rate0
     6527                 v-exch-scale = v-exch-scale0
     6528                 .
     6529              end.
     6530              v-date-1 = date ( "" )  .
     6531              if buf_price-all.fact-order-sys-from > 0 then do:
     6532                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6533                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6534                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6535              end.
     6536              v-date-2 =  date ( "" )  .
     6537              if buf_price-all.fact-order-sys-to > 0 then do:
     6538                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6539                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6540                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6541              end.
     6542              if buf_price-all.qnty-from <> ? then do :
     6543                 if not (
     6544                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6545                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6546                 ) then do:
     6547                        v-interv = "".
     6548                        next.
     6549                 end.
     6550                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6551              end.
     6552              if buf_price-all.sum-from <> ? then do :
     6553                 if not (
     6554                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6555                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6556                 ) then do:
     6557                    v-interv = "".
     6558                    next.
     6559                 end.
     6560                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6561              end.
     6562              if buf_price-all.turnover-from <> ? then do :
     6563                 if not (
     6564                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6565                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6566                 ) then do:
     6567                    v-interv = "".
     6568                    next.
     6569                 end.
     6570                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6571              end.
     6572              if buf_price-all.use-pay-type = 1 then do :
     6573                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6574                    v-pay-name = "" .
     6575                    next.
     6576                  end.
     6577                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6578              end.
     6579              if buf_price-all.use-cash-pay = 1 then do :
     6580                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6581                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6582                   v-pay-name = "" .
     6583                   next.
     6584                 end.
     6585                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6586              end.
     6587             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6588             create tt_price-all .
     6589             buffer-copy buf_price-all to tt_price-all
     6590             assign
     6591               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6592               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6593               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6594               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6595               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6596               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6597               tt_price-all.price-sale     = buf_price-all.price-sale
     6598               tt_price-all.road-tax       = buf_price-all.road-tax
     6599               tt_price-all.excise         = buf_price-all.excise
     6600               tt_price-all.pdf-exch-rate   = v-exch-rate
     6601               tt_price-all.pdf-exch-scale  = v-exch-scale
     6602               tt_price-all.pdf-base-rate   = v-base-rate
     6603               tt_price-all.pdf-base-scale  = v-base-scale
     6604               tt_price-all.grp-name        = v-grp-name
     6605               tt_price-all.date-1          = v-date-1
     6606               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6607               tt_price-all.time-1          = buf_price-all.start-sys-time
     6608               tt_price-all.date-2          = v-date-2
     6609               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6610               tt_price-all.time-2          = buf_price-all.end-sys-time
     6611               tt_price-all.interv-name     = v-interv
     6612               tt_price-all.pay-name        = v-pay-name
     6613               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6614             .
     6615   end.
     6616   define variable vt-plt-id as integer   no-undo .
     6617   define variable vt-plt-db as integer   no-undo .
     6618   define variable vt-pdf-id as integer   no-undo .
     6619   define variable vt-pdf-db as integer   no-undo .
     6620   define buffer neos_price-all for tt_price-all  .
     6621   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6622       if available tt_price-all then do:
     6623        assign
     6624          vt-plt-id = tt_price-all.plt-id
     6625          vt-plt-db = tt_price-all.plt-db-num
     6626          vt-pdf-id = tt_price-all.pdf-id
     6627          vt-pdf-db = tt_price-all.pdf-db
     6628        .
     6629        if tt_price-all.b-code = p-b-code then do:
     6630             assign
     6631               p-plt-id           = tt_price-all.plt-id
     6632               p-plt-db-num       = tt_price-all.plt-db-num
     6633               p-pdf-id           = tt_price-all.pdf-id
     6634               p-pdf-db-num       = tt_price-all.pdf-db
     6635               p-sale-price-base  = tt_price-all.price-sale-base
     6636               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6637               p-road-tax-base    = tt_price-all.road-tax-base
     6638               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6639               p-excise-base      = tt_price-all.excise-base
     6640               p-excise-rubl      = tt_price-all.excise-rubl
     6641               .
     6642        end.
     6643        else do:
     6644          find first neos_price-all where
     6645                     neos_price-all.b-code     = p-b-code  and
     6646                     neos_price-all.plt-id     = vt-plt-id and
     6647                     neos_price-all.plt-db-num = vt-plt-db and
     6648                     neos_price-all.pdf-id     = vt-pdf-id and
     6649                     neos_price-all.pdf-db     = vt-pdf-db
     6650                     use-index pi no-error .
     6651            if available neos_price-all then do:
     6652             assign
     6653               p-plt-id           = tt_price-all.plt-id
     6654               p-plt-db-num       = tt_price-all.plt-db-num
     6655               p-pdf-id           = tt_price-all.pdf-id
     6656               p-pdf-db-num       = tt_price-all.pdf-db
     6657               p-sale-price-base  = neos_price-all.price-sale-base
     6658               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6659               p-road-tax-base    = neos_price-all.road-tax-base
     6660               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6661               p-excise-base      = neos_price-all.excise-base
     6662               p-excise-rubl      = neos_price-all.excise-rubl
     6663               .
     6664            end.
     6665            else do:
     6666                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6667                 if error-status :error    then do:
     6668                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6669                   return error return-value .
     6670                 end.
     6671             assign
     6672               p-plt-id           = tt_price-all.plt-id
     6673               p-plt-db-num       = tt_price-all.plt-db-num
     6674               p-pdf-id           = tt_price-all.pdf-id
     6675               p-pdf-db-num       = tt_price-all.pdf-db
     6676               p-sale-price-base  = tt_price-all.price-sale-base
     6677               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6678               p-road-tax-base    = tt_price-all.road-tax-base
     6679               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6680               p-excise-base      = tt_price-all.excise-base
     6681               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6682               .
     6683            end.
     6684        end.
     6685     end.
     6686   end.
     6687   end procedure.
     6688   procedure mpl-tpl-auto :
     6689   define input  parameter p-b-code     as integer   no-undo .
     6690   define input  parameter p-obj-type   as character no-undo .
     6691   define input  parameter p-obj-code   as integer   no-undo .
     6692   define input  parameter p-plt-id     as integer   no-undo .
     6693   define input  parameter p-plt-db-num as integer   no-undo .
     6694   define input  parameter p-fact-order as decimal   no-undo .
     6695   define output parameter p-sale-price as decimal   no-undo .
     6696   define output parameter p-pdf-id     as integer   no-undo .
     6697   define output parameter p-pdf-db-num as integer   no-undo .
     6698     do
     6699     on error undo, return error return-value
     6700     :
     6701   if p-fact-order = ? then do:
     6702     run fact-order-mpl (
     6703         input   today       ,
     6704         input   p-obj-type  ,
     6705         input   p-obj-code  ,
     6706         output  p-fact-order ) .
     6707   end.
     6708   assign
     6709     p-pdf-id      = ?
     6710     p-pdf-db-num  = ?
     6711     p-sale-price  = ?
     6712   .
     6713   define buffer buf_bar-code for ub.bar-code  .
     6714   define buffer buf_goods for ub.goods  .
     6715   find first buf_bar-code no-lock where
     6716              buf_bar-code.b-code = p-b-code
     6717              no-error .
     6718   if error-status :error then return error return-value .
     6719   find first buf_goods no-lock where
     6720              buf_goods.gds-code = buf_bar-code.gds-code
     6721              no-error .
     6722   if error-status :error then return error return-value .
     6723   define variable v-main-b-code as integer   no-undo .
     6724   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6725     (input  buf_goods.gds-code
     6726     ,input  ?
     6727     ,output v-main-b-code
     6728     )  .
     6729   define buffer buf_price-all for ub.price-all  .
     6730   for each tt_price-all : delete tt_price-all. end.
     6731       for each buf_price-all no-lock where
     6732               buf_price-all.plt-id     = p-plt-id                 and
     6733               buf_price-all.plt-db-num = p-plt-db-num             and
     6734               buf_price-all.obj-type   = p-obj-type               and
     6735               buf_price-all.obj-code   = p-obj-code               and
     6736               buf_price-all.gds-code   = buf_goods.gds-code       and
     6737             ( buf_price-all.b-code = v-main-b-code or
     6738               buf_price-all.b-code = p-b-code)    and
     6739               buf_price-all.status_    = 'акт':U         and
     6740               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6741             ( buf_price-all.fact-order-sys-to = ? or
     6742               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6743               :
     6744                 create tt_price-all .
     6745                 buffer-copy buf_price-all to tt_price-all
     6746                 assign
     6747                   tt_price-all.price-sale  = buf_price-all.price-sale
     6748                 .
     6749       end.
     6750   define variable vt-plt-id as integer   no-undo .
     6751   define variable vt-plt-db as integer   no-undo .
     6752   define variable vt-pdf-id as integer   no-undo .
     6753   define variable vt-pdf-db as integer   no-undo .
     6754   define buffer neos_price-all for tt_price-all  .
     6755   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6756       if available tt_price-all then do:
     6757        assign
     6758          vt-plt-id = tt_price-all.plt-id
     6759          vt-plt-db = tt_price-all.plt-db-num
     6760          vt-pdf-id = tt_price-all.pdf-id
     6761          vt-pdf-db = tt_price-all.pdf-db
     6762        .
     6763        if tt_price-all.b-code = p-b-code then do:
     6764             assign
     6765               p-plt-id           = tt_price-all.plt-id
     6766               p-plt-db-num       = tt_price-all.plt-db-num
     6767               p-pdf-id           = tt_price-all.pdf-id
     6768               p-pdf-db-num       = tt_price-all.pdf-db
     6769               p-sale-price       = tt_price-all.price-sale
     6770               .
     6771        end.
     6772        else do:
     6773          find first neos_price-all where
     6774                     neos_price-all.b-code     = p-b-code  and
     6775                     neos_price-all.plt-id     = vt-plt-id and
     6776                     neos_price-all.plt-db-num = vt-plt-db and
     6777                     neos_price-all.pdf-id     = vt-pdf-id and
     6778                     neos_price-all.pdf-db     = vt-pdf-db
     6779                     use-index pi no-error .
     6780            if available neos_price-all then do:
     6781             assign
     6782               p-plt-id           = tt_price-all.plt-id
     6783               p-plt-db-num       = tt_price-all.plt-db-num
     6784               p-pdf-id           = tt_price-all.pdf-id
     6785               p-pdf-db-num       = tt_price-all.pdf-db
     6786               p-sale-price       = neos_price-all.price-sale
     6787               .
     6788            end.
     6789            else do:
     6790           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6791           if error-status :error    then do:
     6792              message "Не найден бар-код" p-b-code view-as alert-box error .
     6793              return error return-value .
     6794           end.
     6795             assign
     6796               p-plt-id           = tt_price-all.plt-id
     6797               p-plt-db-num       = tt_price-all.plt-db-num
     6798               p-pdf-id           = tt_price-all.pdf-id
     6799               p-pdf-db-num       = tt_price-all.pdf-db
     6800               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     6801               .
     6802            end.
     6803        end.
     6804     end.
     6805     end.
     6806   end procedure.
