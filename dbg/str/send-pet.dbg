     7253   def var vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7254   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     7255   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     7256   procedure create-dis-rule :
     7257   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     7258   define input parameter p-tree as logical no-undo .
     7259   define buffer buf_dis-rule for ub.dis-rule.
     7260   define buffer buf_dis-time-rule for ub.dis-time-rule.
     7261   define buffer term_dis-rule for ub.dis-rule.
     7262   define buffer term_dis-time-rule for ub.dis-time-rule.
     7263   define buffer root_cash-dis-rule for cash-dis-rule.
     7264   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     7265   define buffer term_cash-dis-rule for cash-dis-rule.
     7266   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     7267     do
     7268     on error undo, return error
     7269     :
     7270       find first root_cash-dis-rule no-lock where                                                         ~
     7271                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     7272       if not available root_cash-dis-rule then do:
     7273         find first buf_dis-rule no-lock where
     7274                   buf_dis-rule.rule-num = p-rule-num no-error.
     7275         if available buf_dis-rule then do:
     7276           if buf_dis-rule.time-rule-num <> 0 then do:
     7277             find first buf_dis-time-rule no-lock where
     7278                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7279           end.
     7280           create root_cash-dis-rule.
     7281           buffer-copy buf_dis-rule to root_cash-dis-rule.
     7282           if available buf_dis-time-rule then do:
     7283             find first root_cash-dis-time-rule no-lock where
     7284                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7285             if not available root_cash-dis-time-rule then do:
     7286               create root_cash-dis-time-rule.
     7287               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     7288             end.
     7289           end.
     7290           else do:
     7291             assign
     7292             root_cash-dis-rule.time-rule-num = 0.
     7293           end.
     7294           if buf_dis-rule.uniq-field <> "":U then do:
     7295             for each term_dis-rule no-lock where
     7296                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     7297               if term_dis-rule.time-rule-num <> 0 then do:
     7298                 find first term_dis-time-rule no-lock where
     7299                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7300               end.
     7301               create term_cash-dis-rule.
     7302               buffer-copy term_dis-rule to term_cash-dis-rule.
     7303               if term_dis-rule.time-rule-num = 0
     7304               or available term_dis-time-rule
     7305               or root_cash-dis-rule.time-rule-num = 0
     7306               then do:
     7307                 if available term_dis-time-rule then do:
     7308                   find first term_cash-dis-time-rule no-lock where
     7309                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7310                   if not available term_cash-dis-time-rule then do:
     7311                     create term_cash-dis-time-rule.
     7312                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     7313                   end.
     7314                 end.
     7315               end.
     7316             end.
     7317           end.
     7318         end.
     7319       end.
     7320     end.
     7321   end procedure.
     7322   define temp-table temp-cd-plu no-undo like ub.cd-plu .
     7323   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7324   function ncr-amnt-disc returns character (
     7325     input p-pcnt-discnt-rule as integer, input p-price-sale as decimal).
     7326   define variable v-result as character no-undo .
     7327   define variable ii as integer no-undo .
     7328   define variable v-entry as character no-undo extent 3.
     7329   for each cash-dis-rule  no-lock where
     7330         cash-dis-rule.upper-rule-num = p-pcnt-discnt-rule:
     7331     assign
     7332     ii = ii + 1
     7333     v-entry[ii] = "000000":U + string(round(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate, 0), "999999":U) +
     7334                   replace(string(p-price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U)
     7335     .
     7336   end.
     7337   if v-entry[2] = "":U then
     7338   assign
     7339   v-entry[2] = v-entry[1]
     7340   .
     7341   if v-entry[3] = "":U then
     7342   assign
     7343   v-entry[3] = v-entry[2]
     7344   .
     7345   assign
     7346   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7347   .
     7348   return v-result.
     7349   END FUNCTION.
     7350   function ncr-date-disc returns character (
     7351     input p-date-discnt-rule  as integer, input p-price-sale as decimal).
     7352   define variable v-result as character no-undo .
     7353   define variable ii as integer no-undo .
     7354   define variable v-entry as character no-undo extent 3.
     7355   for each cash-dis-rule  no-lock where
     7356         cash-dis-rule.upper-rule-num = p-date-discnt-rule,
     7357       first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7358     assign
     7359     ii = ii + 1
     7360     v-entry[ii] =
     7361                   substring(string(year(cash-dis-time-rule.date-from), "9999":U), 3, 2)   +
     7362                   string(month(cash-dis-time-rule.date-from), "99":U) +
     7363                   string(day(cash-dis-time-rule.date-from), "99":U)  +
     7364                   substring(string(year(cash-dis-time-rule.date-to), "9999":U), 3, 2)   +
     7365                   string(month(cash-dis-time-rule.date-to), "99":U) +
     7366                   string(day(cash-dis-time-rule.date-to), "99":U) +
     7367                   replace(string(cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U).
     7368   end.
     7369   if v-entry[2] = "":U then
     7370   assign
     7371   v-entry[2] = v-entry[1]
     7372   .
     7373   if v-entry[3] = "":U then
     7374   assign
     7375   v-entry[3] = v-entry[2]
     7376   .
     7377   assign
     7378   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7379   .
     7380   return v-result.
     7381   END FUNCTION.
     7382   function ncr-temp-disc returns character (
     7383     input p-temp-discnt-rule  as integer, input p-price-sale as decimal, p-temp-disc-dec as decimal).
     7384   define variable v-result as character no-undo .
     7385   define variable ii as integer no-undo .
     7386   define variable v-entry as character no-undo extent 3.
     7387   define variable v-dec as decimal no-undo .
     7388   define variable v-disc-price-sale as decimal no-undo .
     7389   define variable v-pdf-id as integer no-undo .
     7390   define variable v-pdf-db-num as integer no-undo .
     7391   define buffer buf_cash-dis-rule for cash-dis-rule.
     7392   find first buf_cash-dis-rule where
     7393            buf_cash-dis-rule.rule-num = p-temp-discnt-rule no-error .
     7394   if not available buf_cash-dis-rule then return "":U.
     7395   if buf_cash-dis-rule.templ-rl-root <> 29
     7396   and buf_cash-dis-rule.templ-rl-root <> 86
     7397   then do:
     7398     assign
     7399     v-entry[1] =
     7400     "000"                                                   +
     7401     "0"                                                     +
     7402     "0000"                                                  +
     7403     "2359"                                                     +
     7404      replace(string(cash-gds.price-sale * (1 + p-temp-disc-dec / 100), "999999.99"), ".":U, "":U)
     7405      .
     7406   end.
     7407   else do:
     7408     for each cash-dis-rule  no-lock where
     7409           cash-dis-rule.upper-rule-num = p-temp-discnt-rule ,
     7410         first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7411       case cash-dis-rule.value-type:
     7412         when integer('1':U) then do:
     7413           v-dec = cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100).
     7414         end.
     7415         when integer('12':U) then do:
     7416           find first cash-gds-discnt where
     7417                     cash-gds-discnt.b-code = cash-gds.b-code
     7418                 and cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7419                 and cash-gds-discnt.obj-type = 'маг':U
     7420                 and cash-gds-discnt.obj-code = i-obj-code
     7421                 no-error.
     7422           if not available cash-gds-discnt then do:
     7423             v-dec = cash-gds.price-sale.
     7424           end.
     7425           else do:
     7426             assign
     7427             v-dec = cash-gds-discnt.discnt-value
     7428             .
     7429           end.
     7430         end.
     7431         otherwise do:
     7432           v-dec = cash-gds.price-sale.
     7433         end.
     7434       end case.
     7435       assign
     7436       ii = ii + 1
     7437       v-entry[ii] =
     7438                     "000"                                                   +
     7439                     (if cash-dis-time-rule.week-day-0 then "0" else "":U)   +
     7440                     (if cash-dis-time-rule.week-day-7 then "1" else "":U)   +
     7441                     (if cash-dis-time-rule.week-day-1 then "2" else "":U)   +
     7442                     (if cash-dis-time-rule.week-day-2 then "3" else "":U)   +
     7443                     (if cash-dis-time-rule.week-day-3 then "4" else "":U)   +
     7444                     (if cash-dis-time-rule.week-day-4 then "5" else "":U)   +
     7445                     (if cash-dis-time-rule.week-day-5 then "6" else "":U)   +
     7446                     (if cash-dis-time-rule.week-day-6 then "7" else "":U)   +
     7447                     replace(string(cash-dis-time-rule.time-from, "HH:MM"), ":":U, "":U) +
     7448                     replace(string(cash-dis-time-rule.time-to, "HH:MM"), ":":U, "":U) +
     7449                     replace(string(v-dec, "999999.99"), ".":U, "":U)
     7450       .
     7451   if ii = 3 then leave.
     7452     end.
     7453   end.
     7454   if v-entry[2] = "":U then
     7455   assign
     7456   v-entry[2] = v-entry[1]
     7457   .
     7458   if v-entry[3] = "":U then
     7459   assign
     7460   v-entry[3] = v-entry[2]
     7461   .
     7462   assign
     7463   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7464   .
     7465   return v-result.
     7466   END FUNCTION.
     7467   function ncr-d-rank returns character (
     7468     input p-d-rank as character, input p-pcnt-discnt-rule  as integer, input p-temp-discnt-rule as integer, input p-date-discnt-rule as integer).
     7469   define variable v-result as character no-undo .
     7470   define variable ii as integer no-undo .
     7471   do ii = 1 to length(p-d-rank):
     7472     CASE substr(p-d-rank, ii, 1):
     7473       when "X":U then do:
     7474         if p-pcnt-discnt-rule <> 0 then v-result = "X":U.
     7475       end.
     7476       when "T":U then do:
     7477         if p-temp-discnt-rule <> 0 then v-result = "T":U.
     7478       end.
     7479       when "D":U then do:
     7480         if p-date-discnt-rule <> 0 then v-result = "D":U.
     7481       end.
     7482     END CASE.
     7483     if v-result <> "":U then LEAVE.
     7484   end.
     7485   if v-result = "":U then v-result = chr(32).
     7486   return v-result.
     7487   END FUNCTION.
     7488   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     7489       define variable v-upper-code as int no-undo.
     7490       define variable v-value as character no-undo.
     7491       define variable v-type as character no-undo.
     7492       define buffer lc_gds-grp for ub.gds-grp.
     7493       define buffer lc_goods for ub.goods.
     7494      if p-gds-code <> 0 then do:
     7495       find first lc_goods where lc_goods.gds-code = p-gds-code.
     7496       v-upper-code = lc_goods.grp-code.
     7497       do while v-upper-code > 0 :
     7498           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     7499           run ggoattr-value(
     7500             input lc_gds-grp.node-code,
     7501             input 0,
     7502             input "",
     7503             input 0,
     7504             input 'ban-sales-via-cd':U,
     7505             output v-value,
     7506             output v-type
     7507           ).
     7508          if v-value = "yes" then
     7509             return true.
     7510          else
     7511          do:
     7512             run ggoattr-value(
     7513                input lc_gds-grp.node-code,
     7514                input shop.host-code,
     7515                input "",
     7516                input 0,
     7517                input 'ban-sales-via-cd':U,
     7518                output v-value,
     7519                output v-type
     7520                ).
     7521             if v-value = "yes" then
     7522                return true.
     7523             else
     7524             do:
     7525                run ggoattr-value(
     7526                   input lc_gds-grp.node-code,
     7527                   input shop.host-code,
     7528                   input 'маг':U,
     7529                   input i-obj-code,
     7530                   input 'ban-sales-via-cd':U,
     7531                   output v-value,
     7532                   output v-type
     7533                   ).
     7534                if v-value = "yes" then
     7535                   return true.
     7536                else v-upper-code = lc_gds-grp.upper-code.
     7537             end .
     7538          end.
     7539         end.
     7540       end.
     7541   end.
     7542   FUNCTION convert-tax-code returns integer
     7543                                             ( input p-rate-code as integer
     7544                                              ,input p-cdtaxlst  as character
     7545                                             ) :
     7546   define variable jj as integer no-undo .
     7547     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7548       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7549         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     7550       end.
     7551     end.
     7552   END FUNCTION.
     7553   FUNCTION convert-maria-tax-code returns character
     7554                                             ( input p-vat-rate-code as integer
     7555                                              ,input p-slt-rate-code as integer
     7556                                              ,input p-cdtaxlst  as character
     7557                                             ) :
     7558   define variable jj as integer no-undo .
     7559   define variable aa as character no-undo extent 8.
     7560   define variable v-return-value as character no-undo .
     7561     do jj = 1 to 8:
     7562       if jj <= num-entries(p-cdtaxlst, ";") then do:
     7563         if entry(jj, p-cdtaxlst, ";") begins (string(p-vat-rate-code) + "-") then do:
     7564           aa[jj] = '1'.
     7565         end.
     7566         if entry(jj, p-cdtaxlst, ";") begins (string(p-slt-rate-code) + "-") then do:
     7567           aa[jj] = '1'.
     7568         end.
     7569       end.
     7570       if aa[jj] = '':U then aa[jj] = '0'.
     7571       v-return-value = aa[jj] + v-return-value.
     7572     end.
     7573   return v-return-value.
     7574   END FUNCTION.
     7575   FUNCTION convert-maria-tax-code-2 returns integer
     7576                                             ( input p-rate-code as integer
     7577                                              ,input p-cdtaxlst  as character
     7578                                             ) :
     7579   define variable jj as integer no-undo .
     7580   define variable v-return-value as integer no-undo .
     7581     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7582       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7583         return jj.
     7584       end.
     7585     end.
     7586   return 0.
     7587   END FUNCTION.
     7588   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7589   define variable varscales-pref as character no-undo .
     7590   define variable varpgscales-pref as character no-undo .
     7591   define variable varscales-pref-type52 as character no-undo.
     7592   varscales-pref  = ?.
     7593   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7594     (input  'sclspref':u
     7595     ,input  '':u
