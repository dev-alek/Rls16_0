        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        4   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        5   def input param action as char no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: rcp-cash.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/rcp-cash.p $":U .
       11   define variable vss-description as character no-undo init "пересылка компонентов составных товаров на кассу".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define new shared temp-table gds-list no-undo like ub.goods
       74     field qnty   as decimal
       75     field to-del as logical
       76     field order-num as integer
       77     field to-sel as logical
       78     field promo-code as character
       79     field ActionId  as int64
       80     field db-num as integer
       81     index art  is primary unique artic prod-type prod-code
       82     index code is         unique gds-code
       83     index oi order-num
       84     index isel to-sel
       85     .
       86   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define  new shared  temp-table gds-list-hist no-undo
       88   field list-table as character
       89   field id as integer
       90   field line as integer
       91   field hist-mode as character
       92   field des as character
       93   field num-recs as integer
       94   field option_ as character
       95   field item_ as character
       96   field status_ as character
       97   field num-add as integer
       98   field num-ignored as integer
       99   field done as logical
      100   field err_ as logical
      101   field err-mes as character
      102   index pi is primary
      103   id
      104   line
      105   index isdone
      106   done
      107   .
      108   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      109   DEFINE NEW SHARED TEMP-TABLE cash-rcp no-undo
      110   FIELD rc as recid
      111   FIELD rcp-string AS char
      112   FIELD news-action as logical
      113   index pi IS UNIQUE PRIMARY rc
      114   .
      115   define variable rid-list as  char    no-undo .
      116   define variable ii as integer no-undo.
      117   define variable choice as integer no-undo.
      118   define variable glog as logical no-undo .
      119   FOR EACH gds-list:
      120       DELETE gds-list.
      121   END.
      122   run gbl/d-askw.w (input "Выбор топливных рецептов",
      123                         input ("Передать на кассу "),
      124                         input "|",
      125                         input "Все топливные рецепты|Выбрать рецепт из справочника|Отказ",
      126                         input "|",
      127                         input 1,
      128                         input 3,
      129                         output choice).
      130   CASE choice:
      131       when 1 then do:
      132       run ref/rcp-all.w (
      133             input parparentproc
      134           , input "b-sel"
      135           , input 'топливо':U
      136           , input ?
      137           , input p-obj-type
      138           , input p-obj-code
      139           , output rid-list
      140       ).
      141       if rid-list = "" then do:
      142               message "Вы не определили список топливных рецептов для пересылки их составляющих!"
      143               view-as alert-box WARNING.
      144               return.
      145       end.
      146       do ii = 1 to NUm-entries(rid-list):
      147           FIND FIRST ub.recipe no-lock where recid(ub.recipe) = integer(entry(ii, rid-list)) No-ERROR.
      148           if NOT avail ub.recipe then NEXT.
      149           if ub.recipe.recipe-type <> 'топливо':U then NEXT.
      150           FIND FIRST ub.goods no-lock where ub.goods.artic = ub.recipe.artic AND
      151                                                                 ub.goods.prod-type = ub.recipe.prod-type AND
      152                                                                 ub.goods.prod-code = ub.recipe.prod-code NO-ERROR.
      153           FIND FIRST gds-list NO-LOCK where gds-list.artic = ub.goods.artic AND
      154                                                                       gds-list.prod-type = ub.goods.prod-type AND
      155                                                                       gds-list.prod-code = ub.goods.prod-code No-ERROR.
      156           IF not avail gds-list then do:
      157               create gds-list.
      158               buffer-copy goods to gds-list.
      159           end.
      160       end.
      161   end.
      162   when 2 then do:
      163      FOR EACH ub.recipe no-lock where ub.recipe.recipe-type =  'топливо':U:
      164           FIND FIRST ub.goods no-lock where ub.goods.artic = ub.recipe.artic AND
      165                                                                 ub.goods.prod-type = ub.recipe.prod-type AND
      166                                                                 ub.goods.prod-code = ub.recipe.prod-code NO-ERROR.
      167           FIND FIRST gds-list NO-LOCK where gds-list.artic = goods.artic AND
      168                                                                       gds-list.prod-type = ub.goods.prod-type AND
      169                                                                       gds-list.prod-code = ub.goods.prod-code No-ERROR.
      170           IF not avail gds-list then do:
      171               create gds-list.
      172               buffer-copy goods to gds-list.
      173           end.
      174       END.
      175   end.
      176   END CASE.
      177   if not  can-find(first gds-list no-lock) then do:
      178           message "К сожалению список топливных рецептов пуст!"
      179           view-as alert-box WARNING.
      180           return.
      181   end.
      182   glog = yes.
      183   message
      184   "Передать все товары списка на кассы ?"
      185   view-as alert-box question buttons OK-Cancel update glog.
      186   if glog <> true then return.
      187   run str/diallog.w (
      188                 input parparentproc
      189               , input this-procedure
      190               , input 'str/s-cgds.p':U
      191               , input (string(p-obj-code) + chr(4) + action)
      192               , input no
      193               , input '':U
      194               , input 'Передача товаров на кассы') no-error .
