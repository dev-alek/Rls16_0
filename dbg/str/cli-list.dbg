     4691   procedure get-context :
     4692      define output parameter p-db-num as integer          no-undo.
     4693      define output parameter p-user-id as character        no-undo.
     4694      define variable v-login               as character    no-undo.
     4695      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4696      define buffer buf_user-login  for ub.user-login .
     4697      do
     4698      on error undo, return error
     4699      :
     4700            FIND FIRST buf_sys-ctrl no-lock.
     4701            ASSIGN
     4702               v-login = USERID("ub")
     4703               p-db-num = buf_sys-ctrl.db-num
     4704            .
     4705            FIND FIRST buf_user-login
     4706                 WHERE buf_user-login.db-num = p-db-num
     4707                   AND buf_user-login.user-login = v-login
     4708                 no-lock
     4709                 no-error
     4710                 .
     4711            IF AVAILABLE buf_user-login
     4712            THEN DO:
     4713               assign
     4714                  p-user-id = buf_user-login.user-id
     4715               .
     4716            END.
     4717      end.
     4718   end procedure.
     4719   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4720   def var vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4721   define variable v-no-context as logical no-undo .
     4722   define variable v-user-obj-type as character no-undo .
     4723   define variable v-user-obj-code as integer no-undo .
     4724   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     4725                                            , input p-no-context as logical ):
     4726   define variable v-uniq-key-rec as character no-undo .
     4727   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     4728     v-uniq-key-rec = 'clients':U + chr(3) +
     4729                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     4730                     entry(5, p-uniq-key-rec, chr(3)).
     4731   end.
     4732   else do:
     4733     v-uniq-key-rec = p-uniq-key-rec.
     4734     case entry(1, p-uniq-key-rec, chr(3)):
     4735        when 'user-obj':U then do:
     4736          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     4737          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     4738        end.
     4739     end case.
     4740   end.
     4741   return v-uniq-key-rec.
     4742   end function.
     4743   procedure find-user-obj-rowid :
     4744   define input parameter p-rowid as rowid no-undo .
     4745   define input parameter p-no-context as logical no-undo .
     4746   define output parameter p-user-obj-type as character no-undo .
     4747   define output parameter p-user-obj-code as integer no-undo .
     4748   define buffer user-obj_clients for ub.clients.
     4749   define buffer user-obj_user-obj for ub.user-obj .
     4750   if p-no-context then do:
     4751     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     4752     assign
     4753     p-user-obj-type = user-obj_clients.obj-type
     4754     p-user-obj-code = user-obj_clients.obj-code.
     4755   end.
     4756   else do:
     4757     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     4758     if not available user-obj_user-obj then do:
     4759       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     4760     end.
     4761     assign
     4762     p-user-obj-type = user-obj_user-obj.obj-type
     4763     p-user-obj-code = user-obj_user-obj.obj-code.
     4764   end.
     4765   end procedure.
     4766   define variable an-listp-start-macro-id as integer no-undo init ?.
     4767   define variable an-listp-end-macro-id as integer no-undo  init ?.
     4768   define variable an-listp-macros-label-id as integer   no-undo .
     4769   define variable v-macro-is-running as logical no-undo .
     4770   define variable v-current-step as integer no-undo .
     4771   define variable v-expand as logical no-undo .
     4772   define variable v-downed as character no-undo .
     4773   define variable p-title as character no-undo .
     4774   define variable bttns as character no-undo .
     4775   define variable p-keep-query as logical no-undo .
     4776   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4777   define     temp-table keep-macro-list-hist no-undo
     4778   field list-table as character
     4779   field id as integer
     4780   field line as integer
     4781   field hist-mode as character
     4782   field des as character
     4783   field num-recs as integer
     4784   field option_ as character
     4785   field item_ as character
     4786   field status_ as character
     4787   field num-add as integer
     4788   field num-ignored as integer
     4789   field done as logical
