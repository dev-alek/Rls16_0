     1601   def
     1602   new shared
     1603   temp-table  obj-list no-undo
     1604     field obj-type like ub.clients.obj-type
     1605     field obj-code like ub.clients.obj-code
     1606     field obj-name like ub.clients.obj-name
     1607     field obj-id   as integer
