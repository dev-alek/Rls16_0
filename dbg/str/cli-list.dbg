     4798   procedure assign-nums :
     4799   define input-output parameter p-num-add as integer no-undo .
     4800   define input-output parameter p-num-rec as integer no-undo .
     4801   define input-output parameter p-num-ignored as integer no-undo .
     4802   define input parameter p-line-mode as character no-undo .
     4803   assign
     4804   p-num-add  = lns-cnt - v-num-add
     4805   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     4806                             then (tot-lns + p-num-add)
     4807                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     4808   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     4809   p-num-ignored = lns-ignore  - v-num-ignored
     4810   v-num-add             = lns-cnt
     4811   v-num-ignored         = lns-ignore
     4812   .
     4813   END PROCEDURE.
     4814   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     4815   or INSERT-MODE of br-list
     4816   DO:
     4817   define variable glog as logical no-undo .
     4818   define buffer buf-cli-list-hist for cli-list-hist.
     4819   define buffer buf_macro-list-hist for macro-list-hist.
     4820   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     4821    if p-keep-query then do:
     4822       glog = no.
     4823       message "Реинициализация списка. Вы уверены ?"
     4824               view-as alert-box question buttons OK-Cancel update glog.
     4825       if not glog then return no-apply.
     4826       if session:set-wait-state( "COMPILER" )  then .
     4827       for each cli-list:
     4828         delete cli-list.
     4829       end.
     4830       if session:set-wait-state( "" )  then .
     4831       tot-lns = 0.
     4832       v-seq = 1.
     4833       for each buf-cli-list-hist:
     4834         delete buf-cli-list-hist.
     4835       end.
     4836      for each buf_keep-macro-list-hist:
     4837        create buf_macro-list-hist.
     4838      end.
     4839      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     4840      run create-cli-list-hist in this-procedure (
     4841                                             input 'ДОБАВЛЕНИЕ':U
     4842                                           , input-output v-seq
     4843                                           , input 0
     4844                                           , input '0':U
     4845                                           , input "# Реинициализация списка."
     4846                                           , input 0
     4847                                           , input "init"
     4848                                           , input '':U
     4849                                           , input '':U
     4850                                           , input '':U
     4851                                           , input ?
     4852                                           ).
     4853       display
     4854       tot-lns @ f-tot-lns
     4855       with frame Dialog-Frame.
     4856       run MyEnable in this-procedure .
     4857    end.
     4858    else do:
     4859      assign rs-list-method = "single".
     4860      run proc-b-add in this-procedure(input no
     4861                                     ,input ?
     4862                                     ,input rs-list-method
     4863                                     ,input rs-status)  no-error .
     4864     if error-status:error then return no-apply.
     4865   end.
     4866   END.
     4867   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     4868   or DELETE-CHARACTER of br-list
     4869   DO:
     4870     if not available cli-list then return no-apply.
     4871     assign rs-list-method = "single".
     4872       run proc-b-del in this-procedure(
     4873                                                  input no
     4874                                                 ,input ?
     4875                                                 ,input rs-list-method
     4876                                                 ,input rs-status) no-error .
     4877     if error-status:error then return no-apply.
     4878   END.
     4879   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     4880   DO:
     4881   if not available cli-list then return no-apply.
     4882     assign rs-list-method = "single".
     4883    run proc-b-rest in this-procedure(
     4884                                                   input no
     4885                                                  ,input ?
     4886                                                  ,input rs-list-method
     4887                                                  ,input rs-status) no-error .
     4888     if error-status:error then return no-apply.
     4889   END.
     4890   on choose of MENU-ITEM m-macro-file in menu m-play DO:
     4891     assign
     4892     macro-play-option = 'file':U.
     4893     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     4894   end.
     4895   on choose of MENU-ITEM m-macro-lob in menu m-play DO:
     4896     assign
     4897     macro-play-option = 'lob':U.
     4898     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     4899   end.
     4900   ON CHOOSE OF B-macro IN FRAME Dialog-Frame
     4901   DO:
     4902   if macro-play-option = '':U then do:
     4903         run gbl/pop-up.p ( input self:handle, input no) no-error.
     4904   end.
     4905   if macro-play-option = '':U then return no-apply.
     4906   run proc-b-macro in this-procedure ( input macro-play-option) no-error .
     4907   if error-status:error then return no-apply.
     4908   END.
     4909   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     4910   DO:
     4911   define variable glog as logical no-undo .
     4912   message
     4913   "Начать запись макроса формирования списка?"
     4914   view-as alert-box QUESTION buttons yes-no update glog.
     4915   if not glog then return no-apply.
     4916   assign
     4917   an-listp-start-macro-id = v-seq
     4918   an-listp-end-macro-id = ?
     4919   .
     4920     menu-item m-macro-file:label in menu m-play = "Ранее записанный макрос формирования списка товаров".
     4921     menu-item m-macro-lob:sensitive in menu m-play = no.
     4922   disable
     4923   b-record with frame Dialog-Frame .
     4924   hide
     4925   b-record
     4926   b-macro
     4927   in frame Dialog-Frame .
     4928   enable
     4929   b-stop with frame Dialog-Frame .
     4930   run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     4931                                       , input-output v-seq
     4932                                       , input 0
     4933                                       , input 'o':U
     4934                                       , input "Начата запись макроса формирования списка"
     4935                                       , input tot-lns
     4936                                       , input 'macro':U
     4937                                       , input '':U
     4938                                       , input '':U
     4939                                       , input '':U
     4940                                       , input ?
     4941                                       ).
     4942   END.
     4943   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     4944   DO:
     4945   define variable glog as logical no-undo .
     4946   define variable v-id as integer no-undo .
     4947   define buffer buf_cli-list-hist for cli-list-hist.
     4948   message
     4949   "Закончить запись макроса формирования списка?"
     4950   view-as alert-box QUESTION buttons yes-no update glog.
     4951   if not glog then return no-apply.
     4952   assign
     4953   an-listp-end-macro-id = v-seq.
     4954   disable
     4955   b-stop with frame Dialog-Frame .
     4956   hide
     4957   b-stop in frame Dialog-Frame .
     4958   enable
     4959   b-record
     4960   b-macro
     4961   with frame Dialog-Frame .
     4962   run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     4963                                       , input-output v-seq
     4964                                       , input 0
     4965                                       , input '[]':U
     4966                                       , input "Закончена запись макроса формирования списка"
     4967                                       , input tot-lns
     4968                                       , input 'macro':U
     4969                                       , input '':U
     4970                                       , input '':U
     4971                                       , input '':U
     4972                                       , input ?
     4973                                       ).
     4974   for each macro-list-hist:
     4975     delete macro-list-hist.
     4976   end.
     4977   for each buf_cli-list-hist where
     4978           buf_cli-list-hist.id >=  an-listp-start-macro-id
     4979     and  buf_cli-list-hist.id <=  an-listp-end-macro-id:
     4980     create macro-list-hist.
     4981     buffer-copy buf_cli-list-hist
     4982     except id num-recs num-add num-ignored
     4983     to macro-list-hist
     4984     assign
     4985     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     4986     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     4987     .
     4988   end.
     4989   END.
     4990   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     4991   DO:
     4992   disable
     4993   b-clear-macro with frame Dialog-Frame .
     4994   assign
     4995   an-listp-start-macro-id = ?
     4996   an-listp-end-macro-id = ?
     4997   an-listp-macros-label-id = 0
     4998   .
     4999   menu-item m-macro-lob:sensitive in menu m-play = yes.
     5000   for each macro-list-hist:
     5001     delete macro-list-hist.
     5002   end.
     5003   hide
     5004   b-clear-macro in frame Dialog-Frame .
     5005   enable
     5006   b-record
     5007   b-macro
     5008   with frame Dialog-Frame .
     5009   END.
     5010   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     5011   DO:
