     2941        IMAGE-INSENSITIVE FILE "cmp/fstopi.bmp":U
     2942        LABEL "&[ ]"
     2943        SIZE 4 BY 1.25 TOOLTIP "Удаление макроса формирования истории из памяти".
     2944   DEFINE BUTTON B-clr
     2945        LABEL "Очи&стить"
     2946        SIZE 10 BY 1 TOOLTIP "Удалить из списка всех клиентов".
     2947   DEFINE BUTTON B-del
     2948        LABEL "&-Удал. строку"
     2949        SIZE 20 BY 1 TOOLTIP "Удаленить из списка клиентов текукую строку".
     2950   DEFINE BUTTON B-exit AUTO-GO
     2951        LABEL "&Выход"
     2952        SIZE 10 BY 1 TOOLTIP "Выход из списка клиентов (передача списка другой программе)"
     2953        BGCOLOR 8 .
     2954   DEFINE BUTTON B-Help
     2955        LABEL "Помо&щь"
     2956        SIZE 10 BY 1
     2957        BGCOLOR 8 .
     2958   DEFINE BUTTON B-hist
     2959        LABEL "Ис&тория"
     2960        SIZE 10 BY 1 TOOLTIP "Последовательность шагов, приведшая к заполнению данного списка".
     2961   DEFINE BUTTON B-lkp
     2962        LABEL "&Просмотр"
     2963        SIZE 10 BY 1 TOOLTIP "Просмотр описания текущего клиента".
     2964   DEFINE BUTTON B-macro
     2965        IMAGE-UP FILE "cmp/run.bmp":U
     2966        IMAGE-DOWN FILE "cmp/runi.bmp":U
     2967        IMAGE-INSENSITIVE FILE "cmp/runi.bmp":U
     2968        LABEL "&>"
     2969        SIZE 4 BY 1.25 TOOLTIP "Выполнение макроса формирования истории".
     2970   DEFINE BUTTON B-print
     2971        LABEL "Пе&чать"
     2972        SIZE 10 BY 1.
     2973   DEFINE BUTTON B-record
     2974        IMAGE-UP FILE "cmp/record.bmp":U
     2975        IMAGE-DOWN FILE "cmp/recordi.bmp":U
     2976        IMAGE-INSENSITIVE FILE "cmp/recordi.bmp":U
     2977        LABEL "&o"
     2978        SIZE 4 BY 1.25 TOOLTIP "Запись макроса формирования истории".
     2979   DEFINE BUTTON B-rest
     2980        LABEL "&Оставить"
     2981        SIZE 20 BY 1 TOOLTIP "Оставить в списке только текущую строку".
     2982   DEFINE BUTTON B-save
     2983        LABEL "Со&хр/Вып."
     2984        SIZE 10 BY 1 TOOLTIP "Сохр. список клиентов в текст.файле, EXCEL; операции над списком".
     2985   DEFINE BUTTON B-stop
     2986        IMAGE-UP FILE "cmp/stop.bmp":U
     2987        IMAGE-DOWN FILE "cmp/stopi.bmp":U
     2988        IMAGE-INSENSITIVE FILE "cmp/stopi.bmp":U
     2989        LABEL "&[ ]"
     2990        SIZE 4 BY 1.25 TOOLTIP "Конец записи макроса формирования истории".
     2991   DEFINE VARIABLE ed-notes AS CHARACTER
     2992        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2993        SIZE 75.63 BY 1.54 NO-UNDO.
     2994   DEFINE VARIABLE dsp-rs AS CHARACTER FORMAT "X(256)":U
     2995         VIEW-AS TEXT
     2996        SIZE 75.5 BY 1 TOOLTIP "Строка текущего состояния списка"
     2997        FGCOLOR 4  NO-UNDO.
     2998   DEFINE VARIABLE f-tot-lns AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     2999         VIEW-AS TEXT
     3000        SIZE 10 BY .71 TOOLTIP "Кол. строк"
     3001        FGCOLOR 4  NO-UNDO.
     3002   DEFINE VARIABLE NameOrCode AS CHARACTER FORMAT "X(256)":U
     3003        VIEW-AS FILL-IN
     3004        SIZE 40.13 BY 1 NO-UNDO.
     3005   DEFINE VARIABLE n-c AS CHARACTER INITIAL "1"
     3006        VIEW-AS RADIO-SET HORIZONTAL
     3007        RADIO-BUTTONS
     3008             "Название", "1",
     3009   "Код", "2"
     3010        SIZE 23 BY .79 NO-UNDO.
     3011   DEFINE VARIABLE RS-Status AS CHARACTER
     3012        VIEW-AS RADIO-SET HORIZONTAL
     3013        RADIO-BUTTONS
     3014             "Item 1", "1",
     3015   "Item 2", "2",
     3016   "Item 3", "3"
     3017        SIZE 36.13 BY .75 NO-UNDO.
     3018   DEFINE QUERY BR-list FOR
     3019         cli-list SCROLLING.
     3020   DEFINE QUERY br-option FOR
     3021         temp-list SCROLLING.
     3022   DEFINE BROWSE BR-list
     3023     QUERY BR-list NO-LOCK DISPLAY
     3024         cli-list.obj-type
     3025         cli-list.obj-code
     3026         IF (cli-list.stts = 0) THEN (cli-list.obj-name)
     3027   ELSE (substring (cli-list.obj-name, 1, 25) +
     3028         FILL(chr(32), 25 -
     3029         LENGTH(substring (cli-list.obj-name, 1, 25)) ) +       '---  УДАЛЕН  ---':U) COLUMN-LABEL "Название" FORMAT "x(40)"
     3030         cli-list.grp-name FORMAT "X(60)"
     3031         cli-list.is-prod COLUMN-LABEL "Пр-ль" FORMAT "+/"
     3032         cli-list.sup-gds COLUMN-LABEL "Пост-к/т" FORMAT "+/"
     3033         cli-list.sup-cons COLUMN-LABEL "Пост-к/к" FORMAT "+/"
     3034         cli-list.buy-gds COLUMN-LABEL "Пок-ль/т" FORMAT "+/"
     3035         cli-list.buy-cons COLUMN-LABEL "Пок-ль/к" FORMAT "+/"
     3036         cli-list.buy-serv COLUMN-LABEL "Пок-ль/у" FORMAT "+/"
     3037         is-dis-cardc(cli-list.obj-type, cli-list.obj-code) COLUMN-LABEL "Дисконтная карта" FORMAT "X(16)"
     3038         is-cashierc(cli-list.obj-type, cli-list.obj-code) COLUMN-LABEL "Кассир" FORMAT "X(6)"
     3039         cli-list.db-num
     3040         is-sellerc(cli-list.obj-type, cli-list.obj-code) COLUMN-LABEL "Прод-ц" FORMAT "X(6)"
     3041       WITH NO-ROW-MARKERS SEPARATORS SIZE 79 BY 15.13.
     3042   DEFINE BROWSE BR-option
     3043     QUERY br-option DISPLAY
     3044         temp-list.fname format "X(40)"
     3045       WITH NO-LABELS NO-ROW-MARKERS SEPARATORS SIZE 29 BY 21 TOOLTIP "Условие для выбора клиентов, которые будут добавлены/удалены/оставле".
     3046   DEFINE FRAME Dialog-Frame
     3047        dsp-rs AT ROW 1 COL 1 NO-LABEL
     3048        br-option AT ROW 2 COL 80
     3049        B-exit AT ROW 2 COL 1
     3050        B-save AT ROW 2 COL 11
     3051        B-print AT ROW 2 COL 21
     3052        B-hist AT ROW 2 COL 31
     3053        B-lkp AT ROW 2 COL 41
     3054        B-clr AT ROW 2 COL 51
     3055        B-Help AT ROW 1 COL 61
     3056        B-add AT ROW 3 COL 11
     3057        B-del AT ROW 3 COL 31
     3058        B-rest AT ROW 3 COL 51
     3059        B-macro AT ROW 3 COL 71
     3060        B-stop AT ROW 3 COL 75
     3061        B-clear-macro AT ROW 3 COL 75
     3062        B-record AT ROW 3 COL 75
     3063        NameOrCode AT ROW 4.04 COL 34 COLON-ALIGNED NO-LABEL
     3064        n-c AT ROW 4.08 COL 2.38 NO-LABEL
     3065        RS-Status AT ROW 5 COL 3.25 NO-LABEL
     3066        f-tot-lns AT ROW 5 COL 66 COLON-ALIGNED NO-LABEL
     3067        BR-list AT ROW 6 COL 1.13
     3068        ed-notes AT ROW 21.38 COL 1 NO-LABEL
     3069        SPACE(23.00) SKIP(0.15)
     3070       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3071            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3072            TITLE "Список клиентов"
     3073            DEFAULT-BUTTON B-exit.
     3074   ASSIGN
     3075          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3076          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3077   ASSIGN
     3078          B-save:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-save:HANDLE.
     3079   ASSIGN
     3080          B-macro:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-play:HANDLE.
     3081   ASSIGN
     3082          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     3083   ASSIGN
     3084          ed-notes:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3085   on GO of frame Dialog-Frame do:
     3086     define variable glog as logical no-undo .
     3087   end.
     3088   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3089   DO:
     3090     APPLY "END-ERROR":U TO SELF.
     3091   END.
     3092   ON CHOOSE OF B-clr IN FRAME Dialog-Frame
     3093   DO:
     3094   define variable glog as logical no-undo .
     3095   define buffer buf-cli-list-hist for cli-list-hist.
     3096   glog = no.
     3097   message
     3098   "Удаление всех строк списка. Вы уверены ?"
     3099   view-as alert-box question buttons OK-Cancel update glog.
     3100   if not glog then return no-apply.
     3101   if session:set-wait-state( "COMPILER" )  then .
     3102   for each cli-list:
     3103     delete cli-list.
     3104   end.
     3105   if session:set-wait-state( "" )  then .
     3106   tot-lns = 0.
     3107   v-seq = 1.
     3108   for each buf-cli-list-hist:
     3109     delete buf-cli-list-hist.
     3110   end.
     3111   run create-cli-list-hist in this-procedure (
     3112                                          input 'ДОБАВЛЕНИЕ':U
     3113                                        , input-output v-seq
     3114                                        , input 0
     3115                                        , input '0':U
     3116                                        , input "# Список карт очищен."
     3117                                        , input 0
     3118                                        , input "clear"
     3119                                        , input '':U
     3120                                        , input '':U
     3121                                        , input '':U
     3122                                        , input ?
     3123                                        ).
     3124   ed-notes:screen-value = ''.
     3125   display
     3126   tot-lns @ f-tot-lns
     3127   with frame Dialog-Frame.
     3128   run MyEnable in this-procedure .
     3129   END.
     3130   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     3131   DO:
     3132   define buffer buf_cli-list-hist for cli-list-hist.
     3133   run prn-lib-open-stream  in this-procedure (
     3134                                                input parParentProc
     3135                                               ,input 43
     3136                                               ,input yes
     3137                                               ,input no
     3138                                               ).
     3139   find first buf_cli-list-hist no-lock where buf_cli-list-hist.id = 0 no-error .
     3140   PUT  STREAM PrnLibStream unformatted
     3141   SPACE(25) "История создания списка клиентов "
     3142   (if available buf_cli-list-hist
     3143   then buf_cli-list-hist.des
     3144   else "БЕЗЫМЯННЫЙ") skip(0)
     3145   space(25) cur-time-print() skip(1)
     3146   .
     3147   put stream PrnLibStream unformatted
     3148   string("№", "X(9)") chr(32)
     3149   string("Действие", "X(9)") chr(32)
     3150   string("записей", "X(9)") chr(32)
     3151   string(" = итого", "X(12)") chr(32)
     3152   string("Множество", "X(155)")
     3153   skip(0)
     3154   fill('-':U, 9) chr(32)
     3155   fill('-':U, 9) chr(32)
     3156   fill('-':U, 9) chr(32)
     3157   fill('-':U, 12) chr(32)
     3158   fill('-':U, 155)
     3159   skip(0)
     3160   .
     3161   for each buf_cli-list-hist where buf_cli-list-hist.id > 0
     3162   by buf_cli-list-hist.id
     3163   :
     3164     put stream PrnLibStream unformatted
     3165     (if buf_cli-list-hist.line = 0
     3166      then string(buf_cli-list-hist.id, ">>>>>>>>9")
     3167      else fill(chr(32) , 9)
     3168     )  chr(32)
     3169     (if buf_cli-list-hist.item_ <> '':U
     3170      then string(buf_cli-list-hist.hist-mode, "X(8)")
     3171      else fill( chr(32), 8)) chr(32)
     3172     string(buf_cli-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     3173     string(buf_cli-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     3174     string(buf_cli-list-hist.des, "X(155)") skip.
     3175   end.
     3176   output stream prnlibstream close.
     3177   run prn-lib-prn-file in this-procedure (
     3178                                             input parParentProc
     3179                                             ,input 8
     3180                                             ).
     3181   apply "entry" to br-list in frame Dialog-Frame.
     3182   END.
     3183   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     3184   DO:
     3185     if not available cli-list then do:
     3186     message "Неправильно выбран клиент."
     3187             view-as alert-box error.
     3188     return no-apply.
     3189   end.
     3190    run ref/showcli.p (
     3191                input parparentproc
     3192               ,input cli-list.obj-type
     3193               ,input cli-list.obj-code
     3194               ).
     3195    apply "entry" to br-list in frame Dialog-Frame.
     3196   END.
     3197   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     3198   DO:
     3199   define variable v-frame-width as integer no-undo.
     3200   if print-option = "" then do:
     3201       run gbl/pop-up.p ( input self:handle, input no) no-error.
     3202   end.
     3203   if print-option = "artic":U then do:
     3204     run str/cliartpr.p ( input parparentproc
     3205                    ,output v-frame-width ) no-error.
     3206   end.
     3207   else do:
     3208     run str/clil-prn.p ( input parparentproc
     3209                    ,input print-option
     3210                    ,output v-Frame-Width) no-error.
     3211   end.
     3212   print-option = "".
     3213   if v-frame-width <= 198 then do:
     3214     run prn-lib-prn-file in this-procedure (
     3215                                               input parParentProc
     3216                                               ,input (if v-frame-width <= 136 then 0 else 8)
     3217                                               ).
     3218   end.
     3219   else do:
     3220     run prn-lib-prn-file in this-procedure (
     3221                                               input parParentProc
     3222                                               ,input (if v-frame-width <= 255 then 1 else 20)
     3223                                               ).
     3224   end.
     3225   make-excel = no.
     3226   apply "entry" to br-list in frame Dialog-Frame.
     3227   END.
     3228   ON CHOOSE OF B-save IN FRAME Dialog-Frame
     3229   DO:
     3230     if save-option = "" then do:
     3231          run gbl/pop-up.p ( input self:handle, input no) no-error.
     3232      end.
     3233      run proc-b-save in this-procedure ( input save-option) no-error.
     3234      if error-status:error then return no-apply.
     3235   END.
     3236   ON VALUE-CHANGED OF BR-list IN FRAME Dialog-Frame
     3237   DO:
     3238       if avail cli-list then do:     assign ed-notes = cli-list.ps.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.   else do:     assign ed-notes = ''.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.
     3239   END.
     3240   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     3241   DO:
     3242     assign
     3243     Rs-list-method = temp-list.fvalue
     3244     .
     3245     run proc-vc-rs-list-method in this-procedure no-error .
     3246     if error-status:error then return no-apply.
     3247   END.
     3248   ON CHOOSE OF MENU-ITEM m_art-print
     3249   DO:
     3250     assign
     3251     print-option = "artic":U.
     3252     apply "choose" to b-print in frame Dialog-Frame.
     3253   END.
     3254   ON CHOOSE OF MENU-ITEM m_cli-save
     3255   DO:
     3256     assign
     3257     save-option = "cli-list":U.
     3258     apply "choose" to b-save in frame Dialog-Frame.
     3259   END.
     3260   ON CHOOSE OF MENU-ITEM m_cli-save-db
     3261   DO:
     3262     assign
     3263     save-option = "cli-list-db":U.
     3264     apply "choose" to b-save in frame Dialog-Frame.
     3265   END.
     3266   ON CHOOSE OF MENU-ITEM m-macros-save  DO:
     3267   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3268   if lookup(b-save :type in frame Dialog-Frame
     3269            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3270            ) = 0
     3271   then do:
     3272     message
     3273       "$Workfile$"
     3274       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3275       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3276       "Тип" self :type in frame Dialog-Frame skip
     3277       "Процедура" this-procedure :file-name skip
     3278       view-as alert-box .
     3279   end.
     3280   else do:
     3281     apply "entry":u to b-save in frame Dialog-Frame .
     3282     if focus :handle <> b-save :handle in frame Dialog-Frame then do:
     3283       return no-apply .
     3284     end.
     3285   end.
     3286   run proc-macros in this-procedure no-error .
     3287   if error-status:error then return no-apply.
     3288   END.
     3289   ON CHOOSE OF MENU-ITEM m-macros-save-db
     3290   DO:
     3291     assign
     3292     save-option = "cli-list-macros-db":U.
     3293     apply "choose" to b-save in frame Dialog-Frame.
     3294   END.
     3295   ON CHOOSE OF MENU-ITEM m_main-print
     3296   DO:
     3297     assign
     3298     print-option = "main":U.
     3299     apply "choose" to b-print in frame Dialog-Frame.
     3300   END.
     3301   ON CHOOSE OF MENU-ITEM m-rum  DO:
     3302   define variable glog as logical no-undo .
     3303   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3304   if lookup(b-save :type in frame Dialog-Frame
     3305            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3306            ) = 0
     3307   then do:
     3308     message
     3309       "$Workfile$"
     3310       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3311       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3312       "Тип" self :type in frame Dialog-Frame skip
     3313       "Процедура" this-procedure :file-name skip
     3314       view-as alert-box .
     3315   end.
     3316   else do:
     3317     apply "entry":u to b-save in frame Dialog-Frame .
     3318     if focus :handle <> b-save :handle in frame Dialog-Frame then do:
     3319       return no-apply .
     3320     end.
     3321   end.
     3322   run str/diallog.w (
     3323         input parParentProc
     3324       , input this-procedure
     3325       , input "utl/thbjrumr.w":U
     3326       , input 'clients':U + chr(4) +
     3327               ('batchwork-export':U + chr(44) + 'batchwork-routing':U)
     3328       , input no
     3329       , input "&Стоп"
     3330       , input substitute("Операции над списком клиентов") ) .
     3331   END.
     3332   ON CHOOSE OF MENU-ITEM m_sel-print
     3333   DO:
     3334     assign
     3335     print-option = "extended":U.
     3336     apply "choose" to b-print in frame Dialog-Frame.
     3337   END.
     3338   ON CHOOSE OF MENU-ITEM m-title-save
     3339   DO:
     3340   define variable v-value as character no-undo .
     3341     run gbl/d-prompt.w (
     3342         'title=':u + "Введите ИМЯ СПИСКА КАРТ" + '\':u
     3343       + 'format=' + "X(60)" + '\':u
     3344       + 'type=' + 'C':U + '\':u
     3345       + 'fillin_row=2\':u
     3346       + 'fillin_col=4\':u
     3347       + 'fillin_width=60\':u
     3348       + 'fillin_height=1\':u
     3349       + 'max-chars=60\':u
     3350       + 'readonly=no\':u
     3351       , input-output v-value
     3352       ).
     3353   if return-value = 'false':u then return NO-apply.
     3354   run create-cli-list-hist in this-procedure (
     3355                                          input 'title'
     3356                                        , input-output v-seq
     3357                                        , input 0
     3358                                        , input 'N':U
     3359                                        , input v-value
     3360                                        , input tot-lns
     3361                                        , input "title"
     3362                                        , input '':U
     3363                                        , input '':U
     3364                                        , input '':U
     3365                                        , input ?
     3366                                        ).
     3367   assign
     3368   frame Dialog-Frame:title = substitute("СПИСОК  КАРТ &1", v-value).
     3369   END.
     3370   ON CHOOSE OF MENU-ITEM m_xls-save
     3371   DO:
     3372     assign
     3373     save-option = "excel":U.
     3374     apply "choose" to b-save in frame Dialog-Frame.
     3375   END.
     3376   ON VALUE-CHANGED OF n-c IN FRAME Dialog-Frame
     3377   DO:
     3378       define variable loc#log as logical no-undo.
     3379       if can-do( 'код':U, n-c ) then do:
     3380           assign
     3381               NameOrCode:width-chars = 10
     3382               NameOrCode:format = "x(9)" .
     3383       end.
     3384       else do:
     3385           assign
     3386               NameOrCode:width-chars = 34.63
     3387               NameOrCode:format = "X(40)" .
     3388       end.
     3389       if nameorcode:visible in frame Dialog-Frame then
     3390       apply "entry" to NameOrCode in frame Dialog-Frame .
     3391   END.
     3392   ON CTRL-J OF NameOrCode IN FRAME Dialog-Frame
     3393   DO:
     3394     assign
     3395     n-c
     3396     nameorcode.
     3397     run proc-find-nameorcode in this-procedure no-error.
     3398     if error-status:error then do:
     3399       return no-apply.
     3400     end.
     3401   END.
     3402   ON RETURN OF NameOrCode IN FRAME Dialog-Frame
     3403   DO:
     3404     assign
     3405     n-c
     3406     nameorcode.
     3407     run proc-find-nameorcode in this-procedure no-error.
     3408     if error-status:error then do:
     3409       return no-apply.
     3410     end.
     3411   END.
     3412   ON VALUE-CHANGED OF RS-Status IN FRAME Dialog-Frame
     3413   DO:
     3414     assign
     3415     RS-status.
     3416   END.
     3417   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3418   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     3419     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     3420     return no-apply.
     3421   end.
     3422   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3423   on F3 of frame Dialog-Frame anywhere do:
     3424     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     3425     return no-apply.
     3426   end.
     3427   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3428   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     3429     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     3430     return no-apply.
     3431   end.
     3432   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3433   on F8 of frame Dialog-Frame anywhere do:
     3434     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     3435     return no-apply.
     3436   end.
     3437   ON RETURN, MOUSE-SELECT-DBLCLICK OF br-list IN FRAME Dialog-Frame DO:
     3438       apply "choose" to b-lkp in frame Dialog-Frame.
     3439   END.
     3440   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3441   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3442   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3443   on help of frame Dialog-Frame
     3444   do:
     3445     run gbl/app_help.p
     3446       (input this-procedure :file-name
     3447       ,input ''
     3448       ,input ?
     3449       ) no-error.
     3450     if error-status :error then do:
     3451       message
     3452         "Ошибка при вызове помощи"
     3453         error-status :get-message(1)
     3454         view-as alert-box .
     3455     end.
     3456   end.
     3457   run minbtn-set in this-procedure .
     3458   on choose of b-help in frame Dialog-Frame
     3459   do:
     3460     apply "help":u to frame Dialog-Frame .
     3461   end.
     3462   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3463   procedure minbtn-set :
     3464       do
     3465           on error undo, return error return-value
     3466           :
     3467           define variable ii              as integer       no-undo .
     3468           define variable fh              as widget-handle no-undo .
     3469           define variable hh              as widget-handle no-undo .
     3470           define variable v-h             as handle        extent 4 no-undo .
     3471           define variable v-name-button   as character     no-undo .
     3472           define variable v-help-old-x    as decimal       no-undo .
     3473           define variable v-help-old-y    as decimal       no-undo .
     3474           define variable v-help-old-size as decimal       no-undo .
     3475           define variable v-frame-width   as decimal       no-undo .
     3476           define variable jj              as integer       no-undo .
     3477           do
     3478               on error undo, return error
     3479               :
     3480               assign
     3481                   v-frame-width = frame Dialog-Frame:width - 0.3
     3482                   fh            = frame Dialog-Frame:first-child
     3483                   hh            = fh:first-child
     3484                   ii            = 1
     3485                   .
     3486               do while valid-handle(hh):
     3487                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3488                   do:
     3489                       case lc(hh:name) :
     3490                           when "b-help" then
     3491                               do:
     3492                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3493                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3494                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3495                                   hh:TOOLTIP = "Помощь" .
     3496                                   v-help-old-x = hh:column .
     3497                                   v-help-old-y = hh:row    .
     3498                                   v-help-old-size = hh:width .
     3499                                   hh:width-chars = 2.5 .
     3500                               end.
     3501                           when "b-print" then
     3502                               do:
     3503                                   hh:load-image("cmp/b-print.bmp":u) .
     3504                                   hh:TOOLTIP = "Печать" .
     3505                                   v-h[ii] = hh:handle .
     3506                                   ii = ii + 1 .
     3507                                   hh:width-chars = 3 .
     3508                               end.
     3509                           when "b-history" or
     3510                           when "b-hist" then
     3511                               do:
     3512                                   hh:load-image("cmp/b-hist.bmp":u) .
     3513                                   hh:TOOLTIP = "История" .
     3514                                   v-h[ii] = hh:handle .
     3515                                   ii = ii + 1 .
     3516                                   hh:width-chars = 3 .
     3517                               end.
     3518                           when "b-sch" then
     3519                               do:
     3520                                   hh:load-image("cmp/b-sch.bmp":u) .
     3521                                   hh:TOOLTIP = "Установка Фильтра" .
     3522                                   v-h[ii] = hh:handle .
     3523                                   ii = ii + 1 .
     3524                                   hh:width-chars = 3 .
     3525                               end.
     3526                           when "b-hist-user" then
     3527                               do:
     3528                                   hh:load-image("cmp/b-hist.bmp":u) .
     3529                                   hh:TOOLTIP = "История пользователя" .
     3530                                   ii = ii + 1 .
     3531                               end.
     3532                       end case.
     3533                   end.
     3534                   hh = hh:next-sibling.
     3535               end.
     3536               b-help:column = v-frame-width - b-help:width-chars.
     3537               jj = 0.
     3538               repeat ii = 4 to 1 by -1 :
     3539                   if valid-handle (v-h[ii] ) then
     3540                   do:
     3541                       jj  = jj + 1 .
     3542                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3543                       v-h[ii]:row    = v-help-old-y .
     3544                   end.
     3545               end.
     3546           end.
     3547       end.
     3548   end procedure.
     3549   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3550   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3551   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3552   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3553   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3554   define variable v-diasize-current-frame-height as decimal   no-undo .
     3555   define variable v-diasize-change-size          as logical   no-undo .
     3556   define variable v-diasize-resize-button        as handle    no-undo .
     3557   define variable v-diasize-wndmax               as logical   no-undo .
     3558   define variable v-diasize-wndstore             as logical   no-undo .
     3559   define variable v-diasize-proc-name            as character no-undo .
     3560   define variable v-diasize-browse-handle        as handle    no-undo .
     3561   define variable v-diasize-browse-number        as integer   no-undo .
     3562   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3563   define temp-table temp-diasize-handle no-undo
     3564     field handle-value  as handle
     3565     field save-position as decimal
     3566     index xpk is primary unique handle-value
     3567     .
     3568   define temp-table temp-browse-handle no-undo
     3569     field browse-type   as character
     3570     field browse-number as integer
     3571     field browse-handle as handle
     3572     field original-size as decimal
     3573     index xpk is primary unique browse-type browse-number
     3574     index xie browse-type browse-handle
     3575   .
     3576   procedure diasize_change-height :
     3577     define input  parameter p-change-value  as decimal   no-undo .
     3578     define input  parameter p-move-resize   as logical   no-undo .
     3579     define variable v-field-group-handle    as handle    no-undo .
     3580     define variable v-object-handle         as handle    no-undo .
     3581     define variable v-frame-height          as decimal   no-undo .
     3582     define variable v-frame-virtual-height  as decimal   no-undo .
     3583     define variable v-browse-height         as decimal   no-undo .
     3584     define variable v-window-height         as decimal   no-undo .
     3585     define variable v-window-virtual-height as decimal   no-undo .
     3586     define variable v-change-sign           as integer   no-undo .
     3587     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3588     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3589     if p-change-value > 0
     3590     then do:
     3591       if frame Dialog-Frame :height + p-change-value
     3592           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3593       then do:
     3594         assign
     3595           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3596                           - (frame Dialog-Frame :height-chars)
     3597         .
     3598         if p-change-value <= 0
     3599         then do:
     3600           run diasize_position-resize-button in this-procedure .
     3601           return .
     3602         end.
     3603       end.
     3604     end.
     3605     if p-change-value < 0
     3606     then do:
     3607       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3608       then do:
     3609         assign
     3610           p-change-value = v-diasize-orig-frame-height
     3611                          - (frame Dialog-Frame :height-chars)
     3612         .
     3613         if p-change-value >= 0
     3614         then do:
     3615           run diasize_position-resize-button in this-procedure .
     3616           return .
     3617         end.
     3618       end.
     3619     end.
     3620     if p-change-value >= 0
     3621     then do:
     3622       assign
     3623         v-change-sign = 1
     3624       .
     3625     end.
     3626     else do:
     3627       assign
     3628         v-change-sign = -1
     3629       .
     3630     end.
     3631     assign
     3632       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3633     .
     3634     if p-change-value = 0
     3635     then do:
     3636       run diasize_position-resize-button in this-procedure .
     3637       return .
     3638     end.
     3639     move_block:
     3640     do
     3641     on error undo move_block, retry move_block
     3642     :
     3643       if retry
     3644       then do:
     3645         do
     3646         on error undo move_block, leave move_block
     3647         :
     3648           if p-change-value > 0
     3649           then do:
     3650             for each buf_temp-diasize-handle
     3651             on error undo, next
     3652             :
     3653               assign
     3654                 v-object-handle = buf_temp-diasize-handle.handle-value
     3655               .
     3656               if v-object-handle <> v-diasize-resize-button
     3657               then do:
     3658                 assign
     3659                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3660                 .
     3661               end.
     3662             end.
     3663             assign
     3664               v-diasize-browse-handle :height = v-browse-height
     3665             .
     3666             for each buf_temp-browse-handle
     3667               where buf_temp-browse-handle.browse-type = 'height':u
     3668             on error undo, next
     3669             :
     3670               assign
     3671                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3672               .
     3673             end.
     3674             assign
     3675               frame Dialog-Frame :height = v-frame-height
     3676             .
     3677             if frame Dialog-Frame :scrollable = true
     3678             then do:
     3679               assign
     3680                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3681               .
     3682             end.
     3683             run diasize_position-resize-button in this-procedure .
     3684           end.
     3685           else do:
     3686             if frame Dialog-Frame :scrollable = true
     3687             then do:
     3688               assign
     3689                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3690               .
     3691             end.
     3692             assign
     3693               frame Dialog-Frame :height = v-frame-height
     3694             .
     3695             assign
     3696               v-diasize-browse-handle :height = v-browse-height
     3697             .
     3698             for each buf_temp-browse-handle
     3699               where buf_temp-browse-handle.browse-type = 'height':u
     3700             on error undo, next
     3701             :
     3702               assign
     3703                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3704               .
     3705             end.
     3706             for each buf_temp-diasize-handle
     3707             on error undo, next
     3708             :
     3709               assign
     3710                 v-object-handle = buf_temp-diasize-handle.handle-value
     3711               .
     3712               if v-object-handle <> v-diasize-resize-button
     3713               then do:
     3714                 assign
     3715                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3716                 .
     3717               end.
     3718             end.
     3719             run diasize_position-resize-button in this-procedure .
     3720           end.
     3721           assign
     3722             v-diasize-change-size = false
     3723           .
     3724           leave move_block .
     3725         end.
     3726       end.
     3727       assign
     3728         v-diasize-need-full-display = true
     3729       .
     3730       if v-diasize-change-size = false
     3731       then do:
     3732         assign
     3733           v-diasize-change-size = true
     3734         .
     3735       end.
     3736       else do:
     3737         return .
     3738       end.
     3739       assign
     3740         v-frame-height = frame Dialog-Frame :height
     3741         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3742         v-browse-height = v-diasize-browse-handle :height
     3743       .
     3744       for each buf_temp-browse-handle
     3745         where buf_temp-browse-handle.browse-type = 'height':u
     3746       :
     3747         assign
     3748           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3749         .
     3750       end.
     3751       for each buf_temp-diasize-handle
     3752       :
     3753         delete buf_temp-diasize-handle .
     3754       end.
     3755       assign
     3756         v-field-group-handle = frame Dialog-Frame :first-child
     3757       .
     3758       do while valid-handle(v-field-group-handle)
     3759       :
     3760         assign
     3761           v-object-handle = v-field-group-handle :first-child
     3762         .
     3763         do while valid-handle(v-object-handle)
     3764         :
     3765           if  v-object-handle <> v-diasize-browse-handle :handle
     3766           and can-query(v-object-handle, "row")
     3767           and can-query(v-object-handle, "height")
     3768           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3769           then do:
     3770             find first buf_temp-browse-handle
     3771               where buf_temp-browse-handle.browse-type   = 'height':u
     3772                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3773               no-error .
     3774             if available buf_temp-browse-handle
     3775             then do:
     3776             end.
     3777             else do:
     3778               create buf_temp-diasize-handle .
     3779               assign
     3780                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3781                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3782               .
     3783             end.
     3784           end.
     3785           assign
     3786             v-object-handle = v-object-handle :next-sibling
     3787           .
     3788         end.
     3789         assign
     3790           v-field-group-handle = v-field-group-handle :next-sibling
     3791         .
     3792       end.
     3793       do with frame Dialog-Frame
     3794       :
     3795         hide v-diasize-resize-button .
     3796         assign
     3797           v-diasize-resize-button :row    = 1
     3798           v-diasize-resize-button :column = 1
     3799         .
     3800       end.
     3801       if p-change-value > 0
     3802       then do:
     3803         if frame Dialog-Frame :scrollable = true
     3804         then do:
     3805           assign
     3806             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3807             no-error .
     3808           if error-status :error
     3809           or error-status :get-message(1) <> ""
     3810           then do:
     3811             undo move_block, retry move_block .
     3812           end.
     3813         end.
     3814         assign
     3815           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3816           no-error .
     3817         if error-status :error
     3818         or error-status :get-message(1) <> ""
     3819         then do:
     3820           undo move_block, retry move_block .
     3821         end.
     3822         assign
     3823           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3824           no-error .
     3825         if error-status :error
     3826         or error-status :get-message(1) <> ""
     3827         then do:
     3828           undo move_block, retry move_block .
     3829         end.
     3830         for each buf_temp-browse-handle
     3831           where buf_temp-browse-handle.browse-type = 'height':u
     3832         on error undo move_block, retry move_block
     3833         :
     3834           assign
     3835             buf_temp-browse-handle.browse-handle :height
     3836               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3837             no-error .
     3838           if error-status :error
     3839           or error-status :get-message(1) <> ""
     3840           then do:
     3841             undo move_block, retry move_block .
     3842           end.
     3843         end.
     3844         for each buf_temp-diasize-handle
     3845         on error undo move_block, retry move_block
     3846         :
     3847           assign
     3848             v-object-handle = buf_temp-diasize-handle.handle-value
     3849           .
     3850           if v-object-handle <> v-diasize-resize-button
     3851           then do:
     3852             assign
     3853               v-object-handle :row = v-object-handle :row + p-change-value
     3854               no-error .
     3855             if error-status :error
     3856             or error-status :get-message(1) <> ""
     3857             then do:
     3858               undo move_block, retry move_block .
     3859             end.
     3860           end.
     3861         end.
     3862       end.
     3863       else do:
     3864         for each buf_temp-diasize-handle
     3865         on error undo move_block, retry move_block
     3866         :
     3867           assign
     3868             v-object-handle = buf_temp-diasize-handle.handle-value
     3869           .
     3870           if v-object-handle <> v-diasize-resize-button
     3871           then do:
     3872             assign
     3873               v-object-handle :row = v-object-handle :row + p-change-value
     3874               no-error .
     3875             if error-status :error
     3876             or error-status :get-message(1) <> ""
     3877             then do:
     3878               undo move_block, retry move_block .
     3879             end.
     3880           end.
     3881         end.
     3882         assign
     3883           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3884           no-error .
     3885         if error-status :error
     3886         or error-status :get-message(1) <> ""
     3887         then do:
     3888           undo move_block, retry move_block .
     3889         end.
     3890         for each buf_temp-browse-handle
     3891           where buf_temp-browse-handle.browse-type = 'height':u
     3892         on error undo move_block, retry move_block
     3893         :
     3894           assign
     3895             buf_temp-browse-handle.browse-handle :height
     3896               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3897             no-error .
     3898           if error-status :error
     3899           or error-status :get-message(1) <> ""
     3900           then do:
     3901             undo move_block, retry move_block .
     3902           end.
     3903         end.
     3904         assign
     3905           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3906           no-error .
     3907         if error-status :error
     3908         or error-status :get-message(1) <> ""
     3909         then do:
     3910           undo move_block, retry move_block .
     3911         end.
     3912         if frame Dialog-Frame :scrollable = true
     3913         then do:
     3914           assign
     3915             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3916             no-error .
     3917           if error-status :error
     3918           or error-status :get-message(1) <> ""
     3919           then do:
     3920             undo move_block, retry move_block .
     3921           end.
     3922         end.
     3923       end.
     3924       if p-move-resize = true
     3925       then do:
     3926         run diasize_position-resize-button in this-procedure .
     3927       end.
     3928       if v-diasize-wndstore = true
     3929       then do:
     3930         if connected("ub") = true
     3931         then do:
     3932           define variable v-cntxt-db-num        as integer   no-undo .
     3933           define variable v-cntxt-userid        as character no-undo .
     3934           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3935                                             , OUTPUT v-cntxt-userid
     3936                                             ) .
     3937           run gbl/wndsizew.p
     3938             (input  v-cntxt-db-num
     3939             ,input  v-cntxt-userid
     3940             ,input  v-diasize-proc-name
     3941             ,input  'height':u
     3942             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3943             ) .
     3944         end.
     3945       end.
     3946     end.
     3947     assign
     3948       v-diasize-change-size = false
     3949     .
     3950   end procedure.
     3951   procedure diasize_set-height :
     3952     define input  parameter p-new-height  as decimal   no-undo .
     3953     define input  parameter p-move-resize as logical   no-undo .
     3954     do
     3955     on error undo, return error return-value
     3956     :
     3957       run diasize_change-height in this-procedure
     3958         (input  (p-new-height - frame Dialog-Frame :height)
     3959         ,input  p-move-resize
     3960         ) .
     3961     end.
     3962   end procedure.
     3963   procedure diasize_change-width :
     3964     define input  parameter p-change-value as decimal   no-undo .
     3965     define input  parameter p-move-resize  as logical   no-undo .
     3966     define variable v-field-group-handle   as handle    no-undo .
     3967     define variable v-object-handle        as handle    no-undo .
     3968     define variable v-frame-width          as decimal   no-undo .
     3969     define variable v-frame-virtual-width  as decimal   no-undo .
     3970     define variable v-browse-width         as decimal   no-undo .
     3971     define variable v-window-width         as decimal   no-undo .
     3972     define variable v-window-virtual-width as decimal   no-undo .
     3973     define variable v-change-sign          as integer   no-undo .
     3974     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3975     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3976     if p-change-value > 0
     3977     then do:
     3978       if frame Dialog-Frame :width + p-change-value >
     3979           session :width-chars
     3980       then do:
     3981         assign
     3982           p-change-value = session :width-chars - frame Dialog-Frame :width
     3983         .
     3984         if p-change-value <= 0
     3985         then do:
     3986           run diasize_position-resize-button in this-procedure .
     3987           return .
     3988         end.
     3989       end.
     3990     end.
     3991     if p-change-value < 0
     3992     then do:
     3993       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3994       then do:
     3995         assign
     3996           p-change-value = v-diasize-orig-frame-width
     3997                          - frame Dialog-Frame :width
     3998         .
     3999         if p-change-value >= 0
     4000         then do:
     4001           run diasize_position-resize-button in this-procedure .
     4002           return .
     4003         end.
     4004       end.
     4005     end.
     4006     if p-change-value >= 0
     4007     then do:
     4008       assign
     4009         v-change-sign = 1
     4010       .
     4011     end.
     4012     else do:
     4013       assign
     4014         v-change-sign = -1
     4015       .
     4016     end.
     4017     assign
     4018       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4019     .
     4020     if p-change-value = 0
     4021     then do:
     4022       run diasize_position-resize-button in this-procedure .
     4023       return .
     4024     end.
     4025     move_block:
     4026     do
     4027     on error undo move_block, leave move_block
     4028     :
     4029       if retry
     4030       then do:
     4031         do
     4032         on error undo move_block, leave move_block
     4033         :
     4034           if p-change-value > 0
     4035           then do:
     4036             for each buf_temp-diasize-handle
     4037             on error undo, next
     4038             :
     4039               assign
     4040                 v-object-handle = buf_temp-diasize-handle.handle-value
     4041               .
     4042               if v-object-handle <> v-diasize-resize-button
     4043               then do:
     4044                 assign
     4045                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4046                 .
     4047               end.
     4048             end.
     4049             assign
     4050               v-diasize-browse-handle :width = v-browse-width
     4051             .
     4052             for each buf_temp-browse-handle
     4053               where buf_temp-browse-handle.browse-type = 'width':u
     4054             on error undo, next
     4055             :
     4056               assign
     4057                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4058               .
     4059             end.
     4060             assign
     4061               frame Dialog-Frame :width = v-frame-width
     4062             .
     4063             if frame Dialog-Frame :scrollable = true
     4064             then do:
     4065               assign
     4066                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4067               .
     4068             end.
     4069             run diasize_position-resize-button in this-procedure .
     4070           end.
     4071           else do:
     4072             if frame Dialog-Frame :scrollable = true
     4073             then do:
     4074               assign
     4075                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4076               .
     4077             end.
     4078             assign
     4079               frame Dialog-Frame :width = v-frame-width
     4080             .
     4081             for each buf_temp-browse-handle
     4082               where buf_temp-browse-handle.browse-type = 'width':u
     4083             on error undo, next
     4084             :
     4085               assign
     4086                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4087               .
     4088             end.
     4089             assign
     4090               v-diasize-browse-handle :width = v-browse-width
     4091             .
     4092             for each buf_temp-diasize-handle
     4093             on error undo, next
     4094             :
     4095               assign
     4096                 v-object-handle = buf_temp-diasize-handle.handle-value
     4097               .
     4098               if v-object-handle <> v-diasize-resize-button
     4099               then do:
     4100                 assign
     4101                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4102                 .
     4103               end.
     4104             end.
     4105             run diasize_position-resize-button in this-procedure .
     4106           end.
     4107           assign
     4108             v-diasize-change-size = false
     4109           .
     4110           leave move_block .
     4111         end.
     4112       end.
     4113       assign
     4114         v-diasize-need-full-display = true
     4115       .
     4116       if v-diasize-change-size = false
     4117       then do:
     4118         assign
     4119           v-diasize-change-size = true
     4120         .
     4121       end.
     4122       else do:
     4123         return .
     4124       end.
     4125       assign
     4126         v-frame-width = frame Dialog-Frame :width
     4127         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     4128         v-browse-width = v-diasize-browse-handle :width
     4129       .
     4130       for each buf_temp-browse-handle
     4131         where buf_temp-browse-handle.browse-type = 'width':u
     4132       :
     4133         assign
     4134           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     4135         .
     4136       end.
     4137       for each buf_temp-diasize-handle
     4138       :
     4139         delete buf_temp-diasize-handle .
     4140       end.
     4141       assign
     4142         v-field-group-handle = frame Dialog-Frame :first-child
     4143       .
     4144       do while valid-handle(v-field-group-handle)
     4145       :
     4146         assign
     4147           v-object-handle = v-field-group-handle :first-child
     4148         .
     4149         do while valid-handle(v-object-handle)
     4150         :
     4151           if  v-object-handle <> v-diasize-browse-handle :handle
     4152           and v-object-handle <> v-diasize-resize-button
     4153           and can-query(v-object-handle, "row")
     4154           and can-query(v-object-handle, "height")
     4155           and ( v-object-handle :col + v-object-handle :width
     4156                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     4157               )
     4158           then do:
     4159             find first buf_temp-browse-handle
     4160               where buf_temp-browse-handle.browse-type   = 'width':u
     4161                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4162               no-error .
     4163             if available buf_temp-browse-handle
     4164             then do:
     4165             end.
     4166             else do:
     4167               create buf_temp-diasize-handle .
     4168               assign
     4169                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4170                 buf_temp-diasize-handle.save-position = v-object-handle :col
     4171               .
     4172             end.
     4173           end.
     4174           assign
     4175             v-object-handle = v-object-handle :next-sibling
     4176           .
     4177         end.
     4178         assign
     4179           v-field-group-handle = v-field-group-handle :next-sibling
     4180         .
     4181       end.
     4182       do with frame Dialog-Frame
     4183       :
     4184         hide v-diasize-resize-button .
     4185         v-diasize-resize-button :row = 1.
     4186         v-diasize-resize-button :column = 1.
     4187       end.
     4188       if p-change-value > 0
     4189       then do:
     4190         if frame Dialog-Frame :scrollable = true
     4191         then do:
     4192           assign
     4193             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4194             no-error .
     4195           if error-status :error
     4196           or error-status :get-message(1) <> ""
     4197           then do:
     4198             undo move_block, retry move_block.
     4199           end.
     4200         end.
     4201         assign
     4202           frame Dialog-Frame :width = v-frame-width + p-change-value
     4203           no-error .
     4204         if error-status :error
     4205         or error-status :get-message(1) <> ""
     4206         then do:
     4207           undo move_block, retry move_block.
     4208         end.
     4209         assign
     4210           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4211         no-error .
     4212         if error-status :error
     4213         or error-status :get-message(1) <> ""
     4214         then do:
     4215           undo move_block, retry move_block.
     4216         end.
     4217         for each buf_temp-browse-handle
     4218           where buf_temp-browse-handle.browse-type = 'width':u
     4219         on error undo move_block, retry move_block
     4220         :
     4221           assign
     4222             buf_temp-browse-handle.browse-handle :width
     4223               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4224             no-error .
     4225           if error-status :error
     4226           or error-status :get-message(1) <> ""
     4227           then do:
     4228             undo move_block, retry move_block .
     4229           end.
     4230         end.
     4231         for each buf_temp-diasize-handle
     4232         on error undo move_block, retry move_block
     4233         :
     4234           assign
     4235             v-object-handle = buf_temp-diasize-handle.handle-value
     4236           .
     4237           if v-object-handle <> v-diasize-resize-button
     4238           then do:
     4239             assign
     4240               v-object-handle :col = v-object-handle :col + p-change-value
     4241               no-error .
     4242             if error-status :error
     4243             or error-status :get-message(1) <> ""
     4244             then do:
     4245               undo move_block, retry move_block .
     4246             end.
     4247           end.
     4248         end.
     4249       end.
     4250       else do:
     4251         for each buf_temp-diasize-handle
     4252         on error undo move_block, retry move_block
     4253         :
     4254           assign
     4255             v-object-handle = buf_temp-diasize-handle.handle-value
     4256           .
     4257           if v-object-handle <> v-diasize-resize-button
     4258           then do:
     4259             assign
     4260               v-object-handle :col = v-object-handle :col + p-change-value
     4261               no-error .
     4262             if error-status :error
     4263             or error-status :get-message(1) <> ""
     4264             then do:
     4265               undo move_block, retry move_block .
     4266             end.
     4267           end.
     4268         end.
     4269         for each buf_temp-browse-handle
     4270           where buf_temp-browse-handle.browse-type = 'width':u
     4271         on error undo move_block, retry move_block
     4272         :
     4273           assign
     4274             buf_temp-browse-handle.browse-handle :width
     4275               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4276             no-error .
     4277           if error-status :error
     4278           or error-status :get-message(1) <> ""
     4279           then do:
     4280             undo move_block, retry move_block .
     4281           end.
     4282         end.
     4283         assign
     4284           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4285           no-error .
     4286         if error-status :error
     4287         or error-status :get-message(1) <> ""
     4288         then do:
     4289           undo move_block, retry move_block.
     4290         end.
     4291         assign
     4292           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4293         no-error .
     4294         if error-status :error
     4295         or error-status :get-message(1) <> ""
     4296         then do:
     4297           undo move_block, retry move_block.
     4298         end.
     4299         if frame Dialog-Frame :scrollable = true
     4300         then do:
     4301           assign
     4302             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4303           no-error .
     4304           if error-status :error
     4305           or error-status :get-message(1) <> ""
     4306           then do:
     4307             undo move_block, retry move_block.
     4308           end.
     4309         end.
     4310       end.
     4311       if p-move-resize
     4312       then do:
     4313         run diasize_position-resize-button in this-procedure .
     4314       end.
     4315       if v-diasize-wndstore = true
     4316       then do:
     4317         if connected("ub") = true
     4318         then do:
     4319           define variable v-cntxt-db-num        as integer   no-undo .
     4320           define variable v-cntxt-userid        as character no-undo .
     4321           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4322                                             , OUTPUT v-cntxt-userid
     4323                                             ) .
     4324           run gbl/wndsizew.p
     4325             (input  v-cntxt-db-num
     4326             ,input  v-cntxt-userid
     4327             ,input  v-diasize-proc-name
     4328             ,input  'width':u
     4329             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4330             ) .
     4331         end.
     4332       end.
     4333     end.
     4334     assign
     4335       v-diasize-change-size = false
     4336     .
     4337   end procedure.
     4338   procedure diasize_set-width :
     4339     define input  parameter p-new-width  as decimal   no-undo .
     4340     define input  parameter p-move-resize as logical   no-undo .
     4341     do
     4342     on error undo, return error return-value
     4343     :
     4344       run diasize_change-width in this-procedure
     4345         (input  (p-new-width - frame Dialog-Frame :width)
     4346         ,input  p-move-resize
     4347         ) .
     4348     end.
     4349   end procedure.
     4350   procedure diasize_position-resize-button :
     4351     do with frame Dialog-Frame
     4352     :
     4353       hide v-diasize-resize-button .
     4354       assign
     4355         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4356                     - 1
     4357                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4358         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4359                     - 1
     4360                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4361       .
     4362       view v-diasize-resize-button .
     4363     end.
     4364   end procedure.
     4365   on alt-right anywhere
     4366   do:
     4367     run diasize_change-width in this-procedure
     4368       (input 1
     4369       ,input true
     4370       ) .
     4371     return no-apply .
     4372   end.
     4373   on alt-left anywhere
     4374   do:
     4375     run diasize_change-width in this-procedure
     4376       (input -1
     4377       ,input true
     4378       ) .
     4379     return no-apply .
     4380   end.
     4381   on alt-down anywhere
     4382   do:
     4383     run diasize_change-height in this-procedure
     4384       (input 1
     4385       ,input true
     4386       ) .
     4387     return no-apply .
     4388   end.
     4389   on alt-up anywhere
     4390   do:
     4391     run diasize_change-height in this-procedure
     4392       (input -1
     4393       ,input true
     4394       ) .
     4395     return no-apply .
     4396   end.
     4397   on alt-enter of frame Dialog-Frame
     4398   do:
     4399     run diasize_maximize in this-procedure
     4400       (input  ?
     4401       ).
     4402     return no-apply .
     4403   end.
     4404   procedure diasize_end-move :
     4405     do
     4406     on error undo, return error return-value
     4407     :
     4408       define variable v-row-delta as decimal   no-undo .
     4409       define variable v-col-delta as decimal   no-undo .
     4410       define variable v-new-row as decimal   no-undo .
     4411       define variable v-new-col as decimal   no-undo .
     4412       assign
     4413         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4414         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4415       .
     4416       assign
     4417         v-row-delta = v-new-row - frame Dialog-Frame :height
     4418         v-col-delta = v-new-col - frame Dialog-Frame :width
     4419       .
     4420       run diasize_change-height in this-procedure
     4421         (input v-row-delta
     4422         ,input true
     4423         ) .
     4424       run diasize_change-width in this-procedure
     4425         (input v-col-delta
     4426         ,input true
     4427         ) .
     4428     end.
     4429   end procedure.
     4430   procedure diasize_maximize :
     4431     define input  parameter p-action as logical   no-undo .
     4432     do
     4433     on error undo, return error return-value
     4434     :
     4435       if p-action = ?
     4436       then do:
     4437         if v-diasize-need-maximize = true
     4438         then do:
     4439           assign
     4440             p-action = true
     4441           .
     4442         end.
     4443         else do:
     4444           assign
     4445             p-action = false
     4446           .
     4447         end.
     4448       end.
     4449       if p-action = true
     4450       then do:
     4451         run diasize_change-height in this-procedure
     4452           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4453               - frame Dialog-Frame :height-chars
     4454           ,input true
     4455           ) .
     4456         run diasize_change-width in this-procedure
     4457           (input session :width-chars
     4458               - frame Dialog-Frame :width-chars
     4459           ,input true
     4460           ) .
     4461         assign
     4462           v-diasize-need-maximize = false
     4463         .
     4464       end.
     4465       else do:
     4466         run diasize_change-width in this-procedure
     4467           (input v-diasize-orig-frame-width
     4468               - frame Dialog-Frame :width-chars
     4469           ,input true
     4470           ) .
     4471         run diasize_change-height in this-procedure
     4472           (input v-diasize-orig-frame-height
     4473               - frame Dialog-Frame :height-chars
     4474           ,input true
     4475           ) .
     4476         assign
     4477           v-diasize-need-maximize = true
     4478         .
     4479       end.
     4480     end.
     4481   end procedure.
     4482   procedure diasize_restore-orig-size :
     4483     do
     4484     on error undo, return error return-value
     4485     :
     4486       assign
     4487         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4488         v-diasize-current-frame-height = frame Dialog-Frame :height
     4489       .
     4490       run diasize_set-height in this-procedure
     4491         (input  v-diasize-orig-frame-height
     4492         ,input  true
     4493         ) .
     4494       run diasize_set-width in this-procedure
     4495         (input  v-diasize-orig-frame-width
     4496         ,input  true
     4497         ) .
     4498     end.
     4499   end procedure.
     4500   procedure diasize_restore-current-size :
     4501     do
     4502     on error undo, return error return-value
     4503     :
     4504       run diasize_set-height in this-procedure
     4505         (input  v-diasize-current-frame-height
     4506         ,input  true
     4507         ) .
     4508       run diasize_set-width in this-procedure
     4509         (input  v-diasize-current-frame-width
     4510         ,input  true
     4511         ) .
     4512     end.
     4513   end procedure.
     4514   procedure diasize_set-browse-handle :
     4515     define input  parameter p-browse-handle as handle   no-undo .
     4516     define buffer buf_temp-browse-handle for temp-browse-handle .
     4517     do
     4518     on error undo, return error return-value
     4519     :
     4520       assign
     4521         v-diasize-browse-handle = p-browse-handle
     4522       .
     4523       for each buf_temp-browse-handle
     4524       on error undo, return error return-value
     4525       :
     4526         delete buf_temp-browse-handle .
     4527       end.
     4528     end.
     4529   end procedure.
     4530   procedure diasize_add_browse :
     4531     define input  parameter p-browse-type   as character no-undo .
     4532     define input  parameter p-browse-handle as handle    no-undo .
     4533     define buffer buf_temp-browse-handle for temp-browse-handle .
     4534     do
     4535     on error undo, return error return-value
     4536     :
     4537       assign
     4538         v-diasize-browse-number = v-diasize-browse-number + 1
     4539       .
     4540       create buf_temp-browse-handle .
     4541       assign
     4542         buf_temp-browse-handle.browse-type   = p-browse-type
     4543         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4544         buf_temp-browse-handle.browse-handle = p-browse-handle
     4545       .
     4546     end.
     4547   end procedure.
     4548   procedure diasize_init :
     4549     define variable v-default-value    as logical   no-undo .
     4550     define variable v-restore-saved    as logical   no-undo .
     4551     define variable v-resize-value-str as character no-undo .
     4552     do
     4553     on error undo, return error return-value
     4554     :
     4555       do with frame Dialog-Frame
     4556       :
     4557         assign
     4558           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4559           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4560           v-diasize-browse-handle     = browse br-list :handle
     4561         .
     4562         create button v-diasize-resize-button
     4563         assign
     4564           parent        = frame Dialog-Frame :first-child
     4565           label         = "s"
     4566           height-pixels = 16
     4567           width-pixels  = 16
     4568           visible       = true
     4569           sensitive     = true
     4570           movable       = true
     4571           triggers:
     4572             on end-move persistent run diasize_end-move in this-procedure .
     4573           end triggers.
     4574         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4575         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4576         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4577         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4578         assign
     4579           v-diasize-wndmax = false
     4580         .
     4581         if connected("ub") = true
     4582         then do:
     4583           define variable v-cntxt-db-num        as integer   no-undo .
     4584           define variable v-cntxt-userid        as character no-undo .
     4585           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4586                                             , OUTPUT v-cntxt-userid
     4587                                             ) .
     4588           run gbl/wndpar_r.p
     4589             (input  v-cntxt-db-num
     4590             ,input  v-cntxt-userid
     4591             ,input  'wndmax':U
     4592             ,output v-diasize-wndmax
     4593             ,output v-default-value
     4594             ) .
     4595         end.
     4596         assign
     4597           v-diasize-wndstore = false
     4598         .
     4599         if connected("ub") = true
     4600         then do:
     4601           run gbl/wndpar_r.p
     4602             (input  v-cntxt-db-num
     4603             ,input  v-cntxt-userid
     4604             ,input  'wndstore':U
     4605             ,output v-diasize-wndstore
     4606             ,output v-default-value
     4607             ) .
     4608         end.
     4609         assign
     4610           v-diasize-proc-name = entry(1, program-name(2), '.')
     4611         .
     4612         if v-diasize-wndstore = true
     4613         then do:
     4614           assign
     4615             v-restore-saved = false
     4616           .
     4617           if connected("ub") = true
     4618           then do:
     4619             run gbl/wndsizer.p
     4620               (input  v-cntxt-db-num
     4621               ,input  v-cntxt-userid
     4622               ,input  v-diasize-proc-name
     4623               ,input  'height':u
     4624               ,output v-resize-value-str
     4625               ) .
     4626             if v-resize-value-str <> '':U
     4627             then do:
     4628               run diasize_change-height in this-procedure
     4629                 (input  integer(v-resize-value-str)
     4630                 ,input  true
     4631                 ) .
     4632               assign
     4633                 v-restore-saved = true
     4634               .
     4635             end.
     4636           end.
     4637           if connected("ub") = true
     4638           then do:
     4639             run gbl/wndsizer.p
     4640               (input  v-cntxt-db-num
     4641               ,input  v-cntxt-userid
     4642               ,input  v-diasize-proc-name
     4643               ,input  'width':u
     4644               ,output v-resize-value-str
     4645               ) .
     4646             if v-resize-value-str <> '':U
     4647             then do:
     4648               run diasize_change-width in this-procedure
     4649                 (input  integer(v-resize-value-str)
     4650                 ,input  true
     4651                 ) .
     4652               assign
     4653                 v-restore-saved = true
     4654               .
     4655             end.
     4656           end.
     4657           if v-restore-saved <> true
     4658           then do:
     4659             if v-diasize-wndmax = true
     4660             then do:
     4661               run diasize_maximize in this-procedure
     4662                 (input  true
     4663                 ) .
     4664             end.
     4665           end.
     4666         end.
     4667         else do:
     4668           if v-diasize-wndmax = true
     4669           then do:
     4670             run diasize_maximize in this-procedure
     4671               (input  true
     4672               ) .
     4673           end.
     4674         end.
     4675       end.
     4676     end.
     4677   end procedure.
     4678   procedure diasize_need-full-display :
     4679     define output parameter p-need-full-display as logical   no-undo .
     4680     do
     4681     on error undo, return error return-value
     4682     :
     4683       assign
     4684         p-need-full-display = v-diasize-need-full-display
     4685       .
     4686       assign
     4687         v-diasize-need-full-display = false
     4688       .
     4689     end.
