     7164         must-exist
     7165         update glog
     7166         default-extension "cli".
     7167         if not glog then do:
     7168           run MyEnable in this-procedure .
     7169           return error.
     7170         end.
     7171         run create-cli-list-hist in this-procedure (
     7172                                               input 'ДОБАВЛЕНИЕ':U
     7173                                             , input-output v-seq
     7174                                             , input 0
     7175                                             , input '':U
     7176                                             , input substitute("Все клиенты из сохраненного в файле списка клиентов &1 &2", f-name, stat-line(rs-status))
     7177                                             , input tot-lns
     7178                                             , input rs-list-method
     7179                                             , input rs-status
     7180                                             , input f-name
     7181                                             , input '':U
     7182                                             , input ?
     7183                                             ).
     7184       end.
     7185       when "clob-data" then do:
     7186         glog = yes.
     7187         message "Все клиенты из ранее сохраненного в БД списка"
     7188         skip stat-line(rs-status)
     7189         view-as alert-box question buttons OK-Cancel update glog.
     7190         if not glog then do:
     7191           run Myenable in this-procedure.
     7192           return error.
     7193         end.
     7194         run ref/clobbnds.w ( input parparentproc
     7195                             ,input this-procedure:handle
     7196                             ,input 'b-sel'
     7197                             ,input "uniq-key-rec"
     7198                             ,input ""
     7199                             ,input 'list':U
     7200                             ,input 'cli-list'
     7201                             ,input -1
     7202                             ,input-output v-rid-list) no-error.
     7203         if v-rid-list = '' then do:
     7204           run Myenable in this-procedure.
     7205           return error.
     7206         end.
     7207         find first buf_clob-bind no-lock where
     7208                   recid(buf_clob-bind) = integer(v-rid-list) .
     7209         run gen-key-rec in this-procedure ( input 'clob-bind':U
     7210                                             ,input (buffer buf_clob-bind:handle)
     7211                                             ,output v-uniq-key-rec).
     7212         run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7213                                             , input-output v-seq
     7214                                             , input 0
     7215                                             , input '':U
     7216                                             , input substitute("Хранимый Файл списка : &1 &2", buf_clob-bind.field-name, stat-line(rs-status))
     7217                                             , input tot-lns
     7218                                             , input rs-list-method
     7219                                             , input rs-status
     7220                                             , input v-uniq-key-rec
     7221                                             , input '':U
     7222                                             , input ?
     7223                                             ).
     7224       end.
     7225       WHEN "FILTER" THEN DO:
     7226         run trig-filter in this-procedure no-error.
     7227         if error-status:error then do:
     7228           run MyEnable in this-procedure .
     7229           return error.
     7230         end.
     7231       END.
     7232     end case.
     7233     if tot-lns <> 0 then do:
     7234       run get-operation in this-procedure ( input dsp-rs, output v-operation).
     7235       CASE v-operation:
     7236         when 1 then do:
     7237           run proc-b-add in this-procedure ( input no, input ?, input rs-list-method, input rs-status) no-error  .
     7238         end.
     7239         when 2 then do:
     7240           run proc-b-del in this-procedure ( input no, input ?, input rs-list-method, input rs-status ) no-error  .
     7241         end.
     7242         when 3 then do:
     7243           run proc-b-rest in this-procedure ( input no, input ?, input rs-list-method, input rs-status) no-error  .
     7244         end.
     7245         otherwise do:
     7246           assign
     7247           dsp-rs = "":U.
     7248           run MyEnable in this-procedure .
     7249           return error.
     7250         end.
     7251       END CASE.
     7252     end.
     7253     assign
     7254     rs-list-method =  temp-list.fvalue
     7255       .
     7256     find last buf_cli-list-hist no-lock where
     7257               buf_cli-list-hist.id = (v-seq - 1)
     7258         and  buf_cli-list-hist.line = 0 no-error .
     7259     DISPLAY
     7260     (if available buf_cli-list-hist
     7261     then buf_cli-list-hist.des
     7262     else '') @ dsp-rs
     7263     with frame Dialog-Frame.
     7264     if tot-lns = 0
     7265     then do:
     7266       run proc-b-add in this-procedure ( input no, input ?, input rs-list-method, input rs-status)  .
     7267     end.
     7268   end.
     7269   END PROCEDURE.
     7270   PROCEDURE rs-do :
     7271   define input parameter p-from-macro as logical no-undo .
     7272   define input parameter p-step as logical no-undo .
     7273   define input parameter rs-list-method as character no-undo .
     7274   define input parameter rs-status as character no-undo .
     7275   define input parameter line-mode as character no-undo .
     7276   define input parameter p-id      as integer no-undo .
     7277   define variable grp-path like ub.goods.grp-name no-undo.
     7278   define variable imp-ART like ub.goods.ARTIC no-undo.
     7279   define variable scan-qnty as dec no-undo.
     7280   define variable imp-type like ub.goods.prod-type no-undo.
     7281   define variable imp-code like ub.goods.prod-code no-undo.
     7282   define variable v-report-num as integer no-undo .
     7283   define variable glog as logical no-undo .
     7284   define variable v-rowid   as rowid no-undo .
     7285   define variable v-tbl-name as character no-undo .
     7286   define variable v-obj-type as character  no-undo.
     7287   define variable v-obj-code as integer    no-undo.
     7288   DEFINE VARIABLE v-attr-code          as character           no-undo .
     7289   define variable v-sum-1 as decimal no-undo .
     7290   define variable v-sum-2 as decimal no-undo .
     7291   define variable v-cashier-role-string as character no-undo .
     7292   define variable v-seller-role-string as character no-undo .
     7293   DEFINE VARIABLE v-today as date no-undo .
     7294   DEFINE VARIABLE v-time as integer no-undo .
     7295   define buffer buf_cli-list-hist for cli-list-hist.
     7296   do
     7297   on error undo, return error return-value
     7298   :
     7299   assign
     7300   lns-cnt = 0
     7301   lns-ignore = 0
     7302   v-num-add  = 0
     7303   v-num-ignored = 0
     7304   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     7305   .
     7306   run write-hist in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode).
     7307   if session:set-wait-state( "COMPILER" )  then .
     7308   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     7309   case rs-list-method:
     7310     when "cli-grp" then do:
     7311       for each buf_cli-list-hist where
     7312                buf_cli-list-hist.id = p-id
     7313           and  buf_cli-list-hist.item_ <> '':U:
     7314         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_cli-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7315         grp-path = "".
     7316         find first ub.cli-grp no-lock where rowid(ub.cli-grp) = v-rowid.
     7317         grp-path = ''.
     7318         run cli-grplib-get-full-name in this-procedure ( input ub.cli-grp.node-code, output grp-path).
     7319         for each ub.clients no-lock where ub.clients.grp-name begins grp-path:
     7320           run ex-CLI in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7321         end.
     7322         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7323       end.
     7324     end.
     7325     when "cli"  then do:
     7326       for each buf_cli-list-hist where
     7327                buf_cli-list-hist.id = p-id
     7328           and  buf_cli-list-hist.item_ <> '':U:
     7329         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_cli-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7330         find first ub.clients no-lock where rowid(ub.clients) = v-rowid.
     7331         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7332         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7333       end.
     7334     end.
     7335     when "prod" then do:
     7336       find first buf_cli-list-hist where
     7337                  buf_cli-list-hist.id = p-id .
     7338       for each ub.clients where ub.clients.is-prod = yes no-lock:
     7339         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7340       end.
     7341       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7342     end.
     7343     when "sup-gds" then do:
     7344       find first buf_cli-list-hist where
     7345                  buf_cli-list-hist.id = p-id .
     7346         for each ub.clients where ub.clients.sup-gds = yes no-lock:
     7347         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7348       end.
     7349       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7350     end.
     7351     when "sup-cons" then do:
     7352       find first buf_cli-list-hist where
     7353                  buf_cli-list-hist.id = p-id .
     7354       for each ub.clients where ub.clients.sup-cons = yes no-lock:
     7355         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7356       end.
     7357       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7358     end.
     7359     when "buy-gds" then do:
     7360       find first buf_cli-list-hist where
     7361                  buf_cli-list-hist.id = p-id .
     7362       for each ub.clients where ub.clients.buy-gds = yes no-lock:
     7363         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7364       end.
     7365       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7366     end.
     7367     when "buy-cons" then do:
     7368       find first buf_cli-list-hist where
     7369                  buf_cli-list-hist.id = p-id .
     7370       for each ub.clients where ub.clients.buy-cons = yes no-lock:
     7371         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7372       end.
     7373       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7374     end.
     7375     when "buy-serv" then do:
     7376       find first buf_cli-list-hist where
     7377                  buf_cli-list-hist.id = p-id .
     7378       for each ub.clients where ub.clients.buy-serv = yes no-lock:
     7379         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7380       end.
     7381       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7382     end.
     7383     when "dis-card" then do:
     7384       find first buf_cli-list-hist where
     7385                  buf_cli-list-hist.id = p-id .
     7386       for each ub.clients no-lock,
     7387           first ub.dis-card no-lock where
     7388                 ub.dis-card.cli-type = ub.clients.obj-type AND
     7389                 ub.dis-card.cli-code = ub.clients.obj-code:
     7390         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7391       end.
     7392       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7393     end.
     7394     when "cashiers" then do:
     7395       if v-cntxt-db-num <> 0 then do:
     7396         v-cashier-role-string = gbclcode-get-work-place  (
     7397                                                     input 'C':U
     7398                                                   ,input 'db':U
     7399                                                   ,input v-cntxt-db-num
     7400                                                   ,input 0
     7401                                                   ,input '':U
     7402                                                   ,input 0  ).
     7403       end.
     7404       run cur-time in this-procedure ( output v-today, output v-time).
     7405       find first buf_cli-list-hist where
     7406                  buf_cli-list-hist.id = p-id .
     7407       for each ub.staff no-lock where
     7408               ub.staff.role = 'C':U
     7409           and ub.staff.role-leve = 'db':U
     7410           and (v-cntxt-db-num = 0 or ub.staff.work-place = v-cashier-role-string)
     7411           and ub.staff.date-end >= v-today,
     7412          first ub.clients no-lock where
     7413                 ub.clients.obj-type = 'чел':U AND
     7414                 ub.clients.obj-code = staff.psn-code:
     7415         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7416       end.
     7417       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7418     end.
     7419     when "sellers" then do:
     7420       if v-cntxt-db-num <> 0  then do:
     7421         v-cashier-role-string = gbclcode-get-work-place  (
     7422                                                     input 'C':U
     7423                                                   ,input 'db':U
     7424                                                   ,input v-cntxt-db-num
     7425                                                   ,input 0
     7426                                                   ,input '':U
     7427                                                   ,input 0  ).
     7428       end.
     7429       run cur-time in this-procedure ( output v-today, output v-time).
     7430       find first buf_cli-list-hist where
     7431                  buf_cli-list-hist.id = p-id .
     7432       for each ub.staff no-lock where
     7433               ub.staff.role =  'S':U
     7434           and ub.staff.role-leve = 'db':U
     7435           and (v-cntxt-db-num = 0 or ub.staff.work-place = v-cashier-role-string)
     7436           and ub.staff.date-end >= v-today,
     7437               first ub.clients no-lock where
     7438                 ub.clients.obj-type = 'чел':U AND
     7439                 ub.clients.obj-code = ub.staff.psn-code:
     7440         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7441       end.
     7442       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7443     end.
     7444     when "firm" then do:
     7445       find first buf_cli-list-hist where
     7446                  buf_cli-list-hist.id = p-id .
     7447       for each ub.clients where ub.clients.obj-type = 'орг':U no-lock:
     7448         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7449       end.
     7450       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7451     end.
     7452     when "person" then do:
     7453       find first buf_cli-list-hist where
     7454                  buf_cli-list-hist.id = p-id .
     7455       for each ub.clients where ub.clients.obj-type = 'чел':U no-lock:
     7456         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7457       end.
     7458       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7459     end.
     7460     when "shop" then do:
     7461       find first buf_cli-list-hist where
     7462                  buf_cli-list-hist.id = p-id .
     7463       for each ub.clients where ub.clients.obj-type = 'маг':U no-lock:
     7464         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7465       end.
     7466       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7467     end.
     7468     when "store" then do:
     7469       find first buf_cli-list-hist where
     7470                  buf_cli-list-hist.id = p-id .
     7471       for each ub.clients where ub.clients.obj-type = 'скл':U no-lock:
     7472         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7473       end.
     7474       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7475     end.
     7476    when "waybill" then do:
     7477      for each buf_cli-list-hist where
     7478               buf_cli-list-hist.id = p-id
     7479         and  buf_cli-list-hist.item_ <> '':U:
     7480         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_cli-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7481         find first ub.trn-doc no-lock where
     7482                   rowid(ub.trn-doc) = v-rowid no-error.
     7483         if available ub.trn-doc then do:
     7484           FIND FIRST ub.clients No-LOCK WHERE
     7485                     ub.clients.obj-type = ub.trn-doc.cli-type AND
     7486                     ub.clients.obj-code = ub.trn-doc.cli-code No-ERROR.
     7487           if avail ub.clients then
     7488           run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7489         end.
     7490         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7491       end.
     7492    end.
     7493    when "attr" or when "attr-val" then do:
     7494       find first buf_cli-list-hist where
     7495                buf_cli-list-hist.id = p-id
     7496            AND buf_cli-list-hist.item_ <> '':U no-error .
     7497       assign
     7498       v-obj-type = entry(1, buf_cli-list-hist.item_, chr(3))
     7499       v-obj-code = integer(entry(2, buf_cli-list-hist.item_, chr(3)))
     7500       v-attr-code = entry(3, buf_cli-list-hist.item_, chr(3))
     7501       vvalue = (if rs-list-method = "attr" then '':U else entry(4, buf_cli-list-hist.item_, chr(3)))
     7502       no-error
     7503       .
     7504       if error-status:error then do:
     7505       end.
     7506       else do:
     7507         for each ub.clients no-lock,
     7508           first ub.clients-attr No-LOCK WHERE
     7509                 ub.clients-attr.obj-type = ub.clients.obj-type AND
     7510                 ub.clients-attr.obj-code = ub.clients.obj-code AND
     7511                ub.clients-attr.attr-code = v-attr-code
     7512           :
     7513           if rs-list-method = "attr-val" then do:
     7514             run clntattr-value in this-procedure (
     7515                               input ub.clients.obj-type
     7516                              ,input ub.clients.obj-code
     7517                              ,input v-attr-code
     7518                              ,output vvalue1
     7519                              ,output vtype1).
     7520             if vvalue1 <> vvalue then NEXT.
     7521           end.
     7522           run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7523         end.
     7524         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7525       end.
     7526     end.
     7527     when "grp-buy"  then do:
     7528       for each buf_cli-list-hist where
     7529                buf_cli-list-hist.id = p-id
     7530           and  buf_cli-list-hist.item_ <> '':U:
     7531         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_cli-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7532         grp-path = "".
     7533         find first ub.buyer-group no-lock where rowid(ub.buyer-group) = v-rowid.
     7534         for each ub.clients no-lock,
     7535             first ub.buyer-in-buyer-group No-LOCK WHERE
     7536                   ub.buyer-in-buyer-group.stts         = 0
     7537               and ub.buyer-in-buyer-group.bbg-obj-type = ub.clients.obj-type
     7538               and ub.buyer-in-buyer-group.bbg-obj-code = ub.clients.obj-code
     7539               and ub.buyer-in-buyer-group.bgr-id       = ub.buyer-group.bgr-id
     7540               and ub.buyer-in-buyer-group.bgr-db-num   = ub.buyer-group.bgr-db-num:
     7541           run ex-CLI in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7542         end.
     7543         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7544       end.
     7545     end.
     7546     when "turnov-buy"  then do:
     7547       find first buf_cli-list-hist where
     7548                  buf_cli-list-hist.id = p-id
     7549           and    buf_cli-list-hist.item_ <> '':U.
     7550       assign
     7551       v-sum-1 = decimal(entry(1, buf_cli-list-hist.item_, chr(3)))
     7552       v-sum-2 = decimal(entry(2, buf_cli-list-hist.item_, chr(3)))
     7553       no-error
     7554       .
     7555       if error-status:error then do:
     7556       end.
     7557       else do:
     7558         run str/two-sum.w (  input  'calc'
     7559                         ,input-output v-sum-1
     7560                         ,input-output v-sum-2
     7561                         ,output table temp-list-buyer
     7562                     ) .
     7563         if not can-find(first temp-list-buyer) then return.
     7564         for each temp-list-buyer,
     7565             first clients no-lock where
     7566                 clients.obj-type = temp-list-buyer.obj-type
     7567             and clients.obj-code = temp-list-buyer.obj-code:
     7568           run ex-CLI in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7569         end.
     7570         empty temp-table temp-list-buyer.
     7571         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7572       end.
     7573     end.
     7574     when "doc-list"
     7575     or
     7576     when "gds-list"
     7577     or
     7578     when "file"
     7579     or
     7580     when "clob-data"
     7581     then do:
     7582       run proc-file-list-methods in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode, input p-id).
     7583     end.
     7584     when "deleted" then do:
     7585       find first buf_cli-list-hist where
     7586                  buf_cli-list-hist.id = p-id .
     7587       for each clients where clients.stts <> 0 no-lock:
     7588         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7589       end.
     7590       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7591     end.
     7592     when "filter" then do:
     7593       define variable v-filter-var as character no-undo .
     7594       find first buf_cli-list-hist where
     7595                buf_cli-list-hist.id = p-id
     7596            AND buf_cli-list-hist.item_ <> '':U .
     7597       run proc-write-filter-expression-var in this-procedure ( input buf_cli-list-hist.item_, output v-filter-var ).
     7598       run gbl/cli-fill.p (
     7599                        input "Формирование списка по фильтру (без учета сортировки)"
     7600                      , input rs-list-method
     7601                      , input rs-status
     7602                      , input line-mode
     7603                      , input v-filter-var
     7604                      , output lns-cnt
     7605                      , output line-rec
     7606                      )  .
     7607        assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7608     end.
     7609     when "all" then do:
     7610       find first buf_cli-list-hist where
     7611                  buf_cli-list-hist.id = p-id .
     7612       for each clients no-lock:
     7613         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7614       end.
     7615       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7616     end.
     7617   END CASE.
     7618   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     7619   if session:set-wait-state( "" )  then .
     7620   case line-mode :
     7621     when 'ДОБАВЛЕНИЕ':U then do:
     7622       tot-lns = tot-lns + lns-cnt.
     7623       if not p-from-macro or p-step then
     7624       message
     7625       "Добавлено строк :" lns-cnt skip(0)
     7626       string(if lns-ignore <> 0
     7627       then ("Проигнорировано строк :" + string(lns-ignore))
     7628       else "":U)
     7629       .
     7630     end.
     7631     when 'удаление':U then do:
     7632       tot-lns = tot-lns - lns-cnt.
     7633       if not p-from-macro or p-step then
     7634       message
     7635       "Удалено строк :" lns-cnt skip(0)
     7636       string(if lns-ignore <> 0
     7637       then ("Проигнорировано строк :" + string(lns-ignore))
     7638       else "":U)
     7639       .
     7640     end.
     7641   end.
     7642   if line-mode <> 'ОСТАВИТЬ':U then
     7643     run Myenable in this-procedure .
     7644   end.
     7645   END PROCEDURE.
     7646   PROCEDURE trig-attr :
     7647   define input parameter rs-list-method as character no-undo .
     7648   define variable ii as integer no-undo.
     7649   define variable glog as logical no-undo .
     7650   DEFINE VARIABLE vattr-codes          as character           no-undo.
     7651   DEFINE VARIABLE vattr-labels         as character           no-undo.
     7652   DEFINE VARIABLE vtooltip             as character           no-undo.
     7653   DEFINE VARIABLE vlabel               as character           no-undo .
     7654   DEFINE VARIABLE vtype                as character           no-undo .
     7655   DEFINE VARIABLE vformat              as character           no-undo .
     7656   DEFINE VARIABLE vuser-can-edit       as logical             no-undo .
     7657   DEFINE VARIABLE voutput-display      as logical             no-undo .
     7658   DEFINE VARIABLE vother               as character           no-undo .
     7659   DEFINE VARIABLE v-ref-list           as character           no-undo .
     7660   DEFINE VARIABLE jj                   as integer             no-undo .
     7661   DEFINE VARIABLE v-spr                as character           no-undo .
     7662   DEFINE VARIABLE v-spr-param          as character           no-undo .
     7663   DEFINE VARIABLE v-setted             as logical             no-undo .
     7664   define variable v-init               as character           no-undo .
     7665   define variable v-item               as character           no-undo .
     7666   DEFINE VARIABLE v-attr-code          as character           no-undo .
     7667   assign
     7668   ref-list = ""
     7669   vattr-codes = ""
     7670   vattr-labels = ""
     7671   vvalue = ""
     7672   .
     7673   DO ii = 1 to num-entries('doc-start,arh-detail,arh-start,ahsp-detail,ahsp-start,aht-detail,aht-start,arh-del,ahsp-del,aht-del,arh-calc,ahsp-calc,aht-calc,arh-recalc,ahsp-recalc,aht-recalc,is-inkassator,shftrep2,db,is-superviser,purch-code,als-gds,alien,envd,kpp,pharm,upd-date-time,holdfirm-code,vat-register,bge-incr-last-shift-date,bge-incr-last-shift-num,bge-sap-sng-last-shift,egrip-date,egrip-num,cli-local,cli-alc-producer,region-code,foreign-producer,main-accholder,not-corr-op,veto-man-doc,requisite-alc-decl,division-code,supp-np,own-supp,supp-lgas,tank-farm-for,NPZ,auto-tank-for,code-KSK,code-AIS,owner-code,cli-for-close-fo,cli-clim-grp,cli-decommissioned,exp-isPM-last-date':U):
     7674       run clntattr-code in this-procedure (
     7675                                            input entry(ii, 'doc-start,arh-detail,arh-start,ahsp-detail,ahsp-start,aht-detail,aht-start,arh-del,ahsp-del,aht-del,arh-calc,ahsp-calc,aht-calc,arh-recalc,ahsp-recalc,aht-recalc,is-inkassator,shftrep2,db,is-superviser,purch-code,als-gds,alien,envd,kpp,pharm,upd-date-time,holdfirm-code,vat-register,bge-incr-last-shift-date,bge-incr-last-shift-num,bge-sap-sng-last-shift,egrip-date,egrip-num,cli-local,cli-alc-producer,region-code,foreign-producer,main-accholder,not-corr-op,veto-man-doc,requisite-alc-decl,division-code,supp-np,own-supp,supp-lgas,tank-farm-for,NPZ,auto-tank-for,code-KSK,code-AIS,owner-code,cli-for-close-fo,cli-clim-grp,cli-decommissioned,exp-isPM-last-date':U)
     7676                                           ,output vtype
     7677                                           ,output vformat
     7678                                           ,output vlabel
     7679                                           ,output vuser-can-edit
     7680                                           ,output voutput-display
     7681                                           ,output vother) no-error.
     7682       if NOT error-status:error anD VOUTPUT-DISPLAY = yes then do:
     7683           assign
     7684           vattr-codes = vattr-codes + chr(4) + entry(ii, 'doc-start,arh-detail,arh-start,ahsp-detail,ahsp-start,aht-detail,aht-start,arh-del,ahsp-del,aht-del,arh-calc,ahsp-calc,aht-calc,arh-recalc,ahsp-recalc,aht-recalc,is-inkassator,shftrep2,db,is-superviser,purch-code,als-gds,alien,envd,kpp,pharm,upd-date-time,holdfirm-code,vat-register,bge-incr-last-shift-date,bge-incr-last-shift-num,bge-sap-sng-last-shift,egrip-date,egrip-num,cli-local,cli-alc-producer,region-code,foreign-producer,main-accholder,not-corr-op,veto-man-doc,requisite-alc-decl,division-code,supp-np,own-supp,supp-lgas,tank-farm-for,NPZ,auto-tank-for,code-KSK,code-AIS,owner-code,cli-for-close-fo,cli-clim-grp,cli-decommissioned,exp-isPM-last-date':U)
     7685           vattr-labels = vattr-labels + chr(4) + vlabel
     7686           .
     7687       end.
     7688   end.
     7689   run gbl/d-list.w (
     7690                      input "b-sel":U
     7691                     ,input "Выберите атрибут"
     7692                     ,input vattr-codes
     7693                     ,input vattr-labels
     7694                     ,input chr(4)
     7695                     ,input "":U
     7696                     ,output v-attr-code).
     7697   if v-attr-code = "" then do:
     7698     return error.
     7699   end.
     7700   glog = yes.
     7701   if rs-list-method = "attr" then do:
     7702       run clntattr-tooltip in this-procedure ( input v-attr-code,
     7703                            output vtooltip,
     7704                            output vlabel).
     7705       message "Все клиенты с установленным атрибутом " + vlabel
     7706               view-as alert-box question buttons OK-Cancel update glog.
     7707       if not glog then do:
     7708         return error.
     7709       end.
     7710       assign
     7711       dsp-rs = substitute("ВСЕ клиенты с установленным атрибутом &1: &2", vlabel, stat-line(rs-status))
     7712       v-item = '':U + chr(3) + '':U + chr(3) + v-attr-code
     7713       .
     7714   end.
     7715   else do:
     7716       run clntattr-code in this-procedure (
     7717                                             input v-attr-code
     7718                                           ,output vtype
     7719                                           ,output vformat
     7720                                           ,output vlabel
     7721                                           ,output vuser-can-edit
     7722                                           ,output voutput-display
     7723                                           ,output vother).
     7724       run gbl/d-prompt.w (
     7725         'title=':u + "Значение атрибута клиента" + '\':u
     7726       + 'text1=':u + vlabel + '\':u
     7727       + 'format=' + (if vtype = 'L':U then "yes/no" else vformat) + '\':u
     7728       + 'type=' + vtype + '\':u
     7729       + 'fillin_row=2\':u
     7730       + 'fillin_col=4\':u
     7731       + 'fillin_width=20\':u
     7732       + 'fillin_height=1\':u
     7733       + 'max-chars=70\':u
     7734       + 'readonly=no\':u
     7735       , input-output vvalue
     7736       ).
     7737       if return-value = 'false':U then do:
     7738         return error.
     7739       end.
     7740       message ("Все клиенты с атрибутом " + vlabel + " = ":U + vvalue)
     7741               view-as alert-box question buttons OK-Cancel update glog.
     7742       if not glog then do:
     7743         return error.
     7744       end.
     7745       assign
     7746       dsp-rs = substitute("Все клиенты с атрибутом &1 =&2 &3", vlabel, vvalue, stat-line(rs-status))
     7747       v-item = '':U + chr(3) + '':U + chr(3) + v-attr-code + chr(3) + vvalue
     7748       .
     7749   end.
     7750   v-no-hist = 0.
     7751   run create-cli-list-hist in this-procedure ( input 'ДОБАВЛЕНИЕ':U
     7752                                       , input-output v-seq
     7753                                       , input 0
     7754                                       , input '':U
     7755                                       , input dsp-rs
     7756                                       , input tot-lns
     7757                                       , input rs-list-method
     7758                                       , input rs-status
     7759                                       , input v-item
     7760                                       , input '':U
     7761                                       , input ?
     7762                                       ).
     7763   END PROCEDURE.
     7764   PROCEDURE trig-filter :
     7765   define variable glog as logical no-undo .
     7766   define variable v-flt-rec as recid no-undo .
     7767   define variable v-filter-name as character no-undo .
     7768   define variable where-phrase as character no-undo .
     7769   define variable sort-phrase as character no-undo .
     7770   define variable where-phrase-rus as character no-undo .
     7771   define variable sort-phrase-rus as character no-undo .
     7772   glog = yes.
     7773   message
     7774   "Все клиенты, выбранные в соответствии с заданным фильтром  (без учета сортировки)."
     7775    view-as alert-box question buttons OK-Cancel update glog.
     7776   if not glog then do:
     7777     return error.
     7778   end.
     7779   assign
     7780   c-point = "cli-list" + chr(4) + "Список клиентов" + chr(4) + "no"
     7781   .
     7782    assign
     7783       tbl = 'clients'
     7784       join-tbl = ''
     7785       fld = ""
     7786       lab = ""
     7787       spr = ""
     7788       dim = '0'
     7789       .
     7790       run fltfield-add in this-procedure('obj-type*obj-code', 'Клиент', 'cli',
     7791                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7792       run fltfield-add in this-procedure('obj-type', 'Тип', '',
     7793                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7794       run fltfield-add in this-procedure('obj-code', 'Код', '',
     7795                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7796       run fltfield-add in this-procedure ('obj-name', 'Название', '',
     7797                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7798       run fltfield-add in this-procedure('stts', 'Статус', '',
     7799                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7800       run fltfield-add in this-procedure('is-prod', 'Производитель', '',
     7801                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7802       run fltfield-add in this-procedure('grp-name', 'Название группы', 'cligrp',
     7803                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7804       run fltfield-add in this-procedure('sup-gds', 'Поставщик товаров', '',
     7805                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7806       run fltfield-add in this-procedure('sup-cons', 'Консигнант', '',
     7807                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7808       run fltfield-add in this-procedure('buy-gds', 'Покупатель товаров', '',
     7809                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7810       run fltfield-add in this-procedure('buy-cons', 'Покупатель консигнационных товаров', '',
     7811                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7812       run fltfield-add in this-procedure('buy-serv', 'Покупатель услуг', '',
     7813                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7814       run fltfield-add in this-procedure('lim-kr', 'Лимит кредита', '',
     7815                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7816       run fltfield-add in this-procedure('PS', 'Примечание', '',
     7817                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7818       run fltfield-add in this-procedure('db-num', 'Номер БД', '',
     7819                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7820   run gbl/filter.w ( input parparentproc
     7821                    , input c-point
     7822                    , input tbl
     7823                    , input join-tbl
     7824                    , input fld
     7825                    , input lab
     7826                    , input spr
     7827                    , input dim).
     7828   run gbl/flt-get.p (
     7829                    input  c-point
     7830                   ,output v-flt-rec
     7831                   ,output v-filter-name
     7832                   ,output where-phrase
     7833                   ,output sort-phrase
     7834                   ,output where-phrase-rus
     7835                   ,output sort-phrase-rus  ).
     7836   if v-flt-rec = ? then do:
     7837     run MyENable in this-procedure .
     7838     return error.
     7839   end.
     7840   else do:
     7841     find ubflt.filter where recid (ubflt.filter) = v-flt-rec no-lock.
     7842     run create-cli-list-hist in this-procedure (
     7843                                           input 'ДОБАВЛЕНИЕ':U
     7844                                         , input-output v-seq
     7845                                         , input 0
     7846                                         , input '':U
     7847                                         , input substitute("Фильтр : &1 &2 &3", ubflt.filter.naim, ubflt.filter.where-ysl-rus, stat-line(rs-status))
     7848                                         , input tot-lns
     7849                                         , input rs-list-method
     7850                                         , input rs-status
     7851                                         , input ubflt.filter.where-ysl
     7852                                         , input '':U
     7853                                         , input ?
     7854                                         ).
     7855   end.
     7856   END PROCEDURE.
     7857   PROCEDURE trig-grp-buy :
     7858   define variable glog as logical no-undo .
     7859   define variable ii as integer no-undo.
     7860   define variable v-ref-list as character no-undo .
     7861   define variable v-recs as integer no-undo.
     7862   define variable v-ref-rec as recid no-undo .
     7863   define variable v-temp-seq as integer no-undo .
     7864   define variable v-line as integer no-undo .
     7865   define variable v-item as character no-undo .
     7866   define variable v-tbl-name as character no-undo .
     7867   define variable v-bh as handle no-undo .
     7868   define variable v-tot-lns as integer no-undo .
     7869   define buffer buf_buyer-group for ub.buyer-group.
     7870   glog = yes.
     7871   message "Все покупатели по группе."
     7872   skip stat-line(rs-status)
     7873   view-as alert-box question buttons OK-Cancel update glog.
     7874   if not glog then do:
     7875     return error.
     7876   end.
     7877   run ref/gr-bupr.w (
     7878        input parparentproc
     7879       ,input "b-sel":U
     7880       ,input-output v-ref-list )
     7881       .
     7882   if v-ref-list = "" then do:
     7883     return error.
     7884   end.
     7885   v-recs = num-entries (v-ref-list) .
     7886   do num-rec = 0 to v-recs:
     7887     if v-recs = 1 then do:
     7888       num-rec = 1 .
     7889     end.
     7890     if num-rec > 0 then do:
     7891       v-ref-rec = integer (entry (num-rec, v-ref-list)).
     7892       find first buf_buyer-group no-lock where recid (buf_buyer-group) = v-ref-rec no-error .
     7893     end.
     7894     if v-recs = 1 then do:
     7895       assign
     7896       v-temp-seq = v-seq
     7897       v-line     = 0
     7898       dsp-rs = substitute("Из группы покупателей :&1 &2", buf_buyer-group.name, stat-line(rs-status))
     7899       v-item     = '':U
     7900       v-tbl-name = 'buyer-group':U
     7901       v-bh       = buffer buf_buyer-group:handle
     7902       v-tot-lns = tot-lns
     7903       .
     7904     end.
     7905     else do:
     7906       if num-rec = 0 then do:
     7907         assign
     7908         v-temp-seq = v-seq
     7909         v-line     = 0
     7910         dsp-rs = substitute("Из групп покупателей : &1", stat-line(rs-status))
     7911         v-item     = '':U
     7912         v-tbl-name = '':U
     7913         v-bh       = ?
     7914         v-tot-lns = tot-lns
     7915         .
     7916       end.
     7917       else do:
     7918         assign
     7919         v-temp-seq = v-seq - 1
     7920         v-line     = num-rec
     7921         dsp-rs = substitute("&1", buf_buyer-group.name)
     7922         v-item     = '':U
     7923         v-tbl-name = 'buyer-group':U
     7924         v-bh       = buffer buf_buyer-group:handle
     7925         v-tot-lns = tot-lns + num-rec
     7926         .
     7927       end.
     7928     end.
     7929     v-no-hist = (if num-rec = 1 then 0 else num-rec).
     7930     run create-cli-list-hist in this-procedure (
     7931                                           input 'ДОБАВЛЕНИЕ':U
     7932                                         , input-output v-temp-seq
     7933                                         , input v-line
     7934                                         , input '':U
     7935                                         , input dsp-rs
     7936                                         , input v-tot-lns
     7937                                         , input rs-list-method
     7938                                         , input rs-status
     7939                                         , input v-item
     7940                                         , input v-tbl-name
     7941                                         , input v-bh
     7942                                         ).
     7943     if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     7944   end.
     7945   END PROCEDURE.
     7946   PROCEDURE trig-turnov-buy :
     7947   define variable glog as logical no-undo .
     7948   define variable ii as integer no-undo.
     7949   define variable v-ref-list as character no-undo .
     7950   define variable v-sum-1 as decimal   no-undo .
     7951   define variable v-sum-2 as decimal   no-undo .
     7952   for each temp-list-buyer :
     7953     delete temp-list-buyer.
     7954   end.
     7955   run str/two-sum.w (  input 'sums'
     7956                   ,input-output v-sum-1
     7957                   ,input-output v-sum-2
     7958                   ,output table temp-list-buyer
     7959                   ) .
     7960   if v-sum-2 = ?  then do:
     7961     return error.
     7962   end.
     7963   glog = yes.
     7964   message
     7965   "Все покупатели c оборотом в интервале " skip
     7966   v-sum-1 " " v-sum-2 skip
     7967   view-as alert-box question buttons OK-Cancel update glog.
     7968   if not glog then do:
     7969     return error.
     7970   end.
     7971   run create-cli-list-hist in this-procedure (
     7972                   input 'ДОБАВЛЕНИЕ':U
     7973                 , input-output v-seq
     7974                 , input 0
     7975                 , input '':U
     7976                 , input substitute ('Все покупатели c оборотом в интервале с &1 по &2: &3'
     7977                                     , v-sum-1
     7978                                     , v-sum-2
     7979                                     , stat-line(rs-status))
     7980                 , input tot-lns
     7981                 , input rs-list-method
     7982                 , input rs-status
     7983                 , input (string(v-sum-1) + chr(3) + string(v-sum-2))
     7984                 , input ""
     7985                 , input ?
     7986                 ).
     7987   END PROCEDURE.
     7988   PROCEDURE write-hist :
     7989   define input parameter p-from-macro as logical no-undo .
     7990   define input parameter rs-list-method as character no-undo .
     7991   define input parameter rs-status as character no-undo .
     7992   define input parameter line-mode as character no-undo .
     7993   define variable v-ii as integer no-undo .
     7994   define variable v-temp-seq as integer no-undo .
     7995   if rs-list-method = "single" then do:
     7996     if v-no-hist < 0 then do:
     7997       run create-cli-list-hist in this-procedure (
     7998                                             input 'ДОБАВЛЕНИЕ':U
     7999                                           , input-output v-seq
     8000                                           , input 0
     8001                                           , input get-hist-mode(line-mode)
     8002                                           , input substitute("КЛИЕНТ &1&2 ", cli-list.obj-type, cli-list.obj-code)
     8003                                           , input tot-lns
     8004                                           , input rs-list-method
     8005                                           , input rs-status
     8006                                           , input ('clients':U + chr(3) + cli-list.obj-type + chr(3) + string(cli-list.obj-code))
     8007                                           , input '':U
     8008                                           , input ?
     8009                                           ).
     8010     end.
     8011     else do:
     8012       v-temp-seq = v-seq - 1.
     8013       do v-ii = 0 to v-no-hist:
     8014         run create-cli-list-hist in this-procedure ( input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8015                                             , input-output v-temp-seq
     8016                                             , input v-ii
     8017                                             , input get-hist-mode(line-mode)
     8018                                             , input substitute("КЛИЕНТ &12", cli-list.obj-type, cli-list.obj-code)
     8019                                             , input tot-lns
     8020                                             , input '':U
     8021                                             , input '':U
     8022                                             , input ('clients':U + chr(3) + cli-list.obj-type + chr(3) + string(cli-list.obj-code))
     8023                                             , input '':U
     8024                                             , input ?
     8025                                             ).
     8026       end.
     8027     end.
     8028   end.
     8029   else do:
     8030     v-temp-seq = v-seq - 1.
     8031     do v-ii = 0 to v-no-hist:
     8032       run create-cli-list-hist in this-procedure (
     8033                                             input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8034                                           , input-output  v-temp-seq
     8035                                           , input v-ii
     8036                                           , input get-hist-mode(line-mode)
     8037                                           , input '':U
     8038                                           , input tot-lns
     8039                                           , input rs-list-method
     8040                                           , input '':U
     8041                                           , input '':U
     8042                                           , input '':U
     8043                                           , input ?
     8044                                           ).
     8045     end.
     8046   end.
     8047   END PROCEDURE.
     8048   FUNCTION is-cashierc RETURNS CHARACTER
     8049   ( input loc-type as character, input loc-code as integer ) :
     8050     if loc-type <> 'чел':U
     8051     then return "".
     8052     return string( gbclcode-is-psn-role ( input 'C':U, input loc-code, input ?)).
     8053   END FUNCTION.
     8054   FUNCTION is-dis-cardc RETURNS CHARACTER
     8055   ( input loc-type as character, input loc-code as integer ) :
     8056     FIND ub.dis-card No-LOCK WHERE
     8057          ub.dis-card.cli-type = loc-type AND
     8058          ub.dis-card.cli-code = loc-code No-ERROR.
     8059     if avail ub.dis-card then return ub.dis-card.d-card.
     8060     else do:
     8061       if AMBIGUOUS dis-card then do:
     8062           return "............":U.
     8063       end.
     8064       else return "".
     8065     end.
     8066   END FUNCTION.
     8067   FUNCTION is-sellerc RETURNS CHARACTER
     8068   ( input loc-type as character, input loc-code as integer ) :
     8069     if loc-type <> 'чел':U
     8070     then return "".
     8071     return string( gbclcode-is-psn-role ( input 'S':U, input loc-code, input ?)).
     8072   END FUNCTION.
     8073   FUNCTION stat-line RETURNS CHARACTER
     8074     ( input p-status-chr as character ) :
     8075   DEFINE VARIABLE var-stat-line as character no-undo .
     8076   CASE p-status-chr:
     8077     when 'все':U then do:
     8078       assign
     8079       var-stat-line = "(текущие и удаленные клиенты)"
     8080       .
     8081     end.
     8082     when 'текущие':U then do:
     8083       assign
     8084       var-stat-line = "(текущие клиенты)"
     8085       .
     8086     end.
     8087     when 'удаленные':U then do:
     8088       assign
     8089       var-stat-line = "(удаленные клиенты)"
     8090       .
     8091     end.
     8092   END CASE.
     8093   return var-stat-line .
     8094   END FUNCTION.
