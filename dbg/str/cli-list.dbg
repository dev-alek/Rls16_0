     5018   PROCEDURE get-operation :
     5019   define input parameter p-message as character no-undo .
     5020   define output parameter p-operation as integer no-undo .
     5021     do
     5022     on error undo, return error
     5023     :
     5024       run gbl/d-askw.w (
     5025                     input "Выбор операции над заданным списком"
     5026                    ,input (p-message + chr(10) +
     5027                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     5028                    ,input "|"
     5029                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     5030                            "Удалить" + "|" +
     5031                            "Оставить" + "|" +
     5032                            "Отказ")
     5033                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     5034                           "Удалить полученный список из уже имеющегося" + "|" +
     5035                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     5036                           "Ничего не делать")
     5037                    ,input  (if p-keep-query then 2 else 1)
     5038                    ,input  4
     5039                    ,output p-operation).
     5040      if p-operation = 4 then do:
     5041         return error .
     5042      end.
     5043     end.
     5044   END PROCEDURE.
     5045   PROCEDURE proc-fill-temp-list :
     5046     define variable v-index               as integer   no-undo .
     5047     define variable v-num-entries-options as integer   no-undo .
     5048     do
     5049     on error undo, return error
     5050     :
     5051       assign
     5052         v-num-entries-options = num-entries("Текущая строка,single,                              Клиент,cli,                                          Группа клиентов,cli-grp,                             Группа покупателей,grp-buy,                          Оборот покупателя с - по,turnov-buy,                 Все производители,prod,                              Все поставщики товаров,sup-gds,                      Все консигнанты,sup-cons,                            Все покупатели товаров,buy-gds,                      Все покупатели конс. товаров,buy-cons,               Все покупатели услуг,buy-serv,                       Все влад-цы диск.карт,dis-card,                      Все кассиры,cashiers,                                Все продавцы,sellers,                                Все  организации,firm,                               Все физ.лица,person,                                 Все магазины,shop,                                   Все склады,store,                                    Контрагенты по док-там,waybill,                      С установл. атрибутом,attr,                          С атрибутом = ,attr-val,                             Произ-ли товаров списка,gds-list,                    Контрагенты док-тов списка,doc-list,                 Удаленные,deleted,                                   Файл,file,                                           Хранимый в БД список,clob-data,                        Фильтр,filter,                                       Все клиенты,all")
     5053       .
     5054       do v-index = 1 to v-num-entries-options by 2
     5055       :
     5056         create temp-list.
     5057         assign
     5058           temp-list.fname  = trim(entry(v-index
     5059                                        ,"Текущая строка,single,                              Клиент,cli,                                          Группа клиентов,cli-grp,                             Группа покупателей,grp-buy,                          Оборот покупателя с - по,turnov-buy,                 Все производители,prod,                              Все поставщики товаров,sup-gds,                      Все консигнанты,sup-cons,                            Все покупатели товаров,buy-gds,                      Все покупатели конс. товаров,buy-cons,               Все покупатели услуг,buy-serv,                       Все влад-цы диск.карт,dis-card,                      Все кассиры,cashiers,                                Все продавцы,sellers,                                Все  организации,firm,                               Все физ.лица,person,                                 Все магазины,shop,                                   Все склады,store,                                    Контрагенты по док-там,waybill,                      С установл. атрибутом,attr,                          С атрибутом = ,attr-val,                             Произ-ли товаров списка,gds-list,                    Контрагенты док-тов списка,doc-list,                 Удаленные,deleted,                                   Файл,file,                                           Хранимый в БД список,clob-data,                        Фильтр,filter,                                       Все клиенты,all"
     5060                                        )
     5061                                  ,chr(32)
     5062                                  )
     5063           temp-list.fvalue = trim(entry(v-index + 1
     5064                                        ,"Текущая строка,single,                              Клиент,cli,                                          Группа клиентов,cli-grp,                             Группа покупателей,grp-buy,                          Оборот покупателя с - по,turnov-buy,                 Все производители,prod,                              Все поставщики товаров,sup-gds,                      Все консигнанты,sup-cons,                            Все покупатели товаров,buy-gds,                      Все покупатели конс. товаров,buy-cons,               Все покупатели услуг,buy-serv,                       Все влад-цы диск.карт,dis-card,                      Все кассиры,cashiers,                                Все продавцы,sellers,                                Все  организации,firm,                               Все физ.лица,person,                                 Все магазины,shop,                                   Все склады,store,                                    Контрагенты по док-там,waybill,                      С установл. атрибутом,attr,                          С атрибутом = ,attr-val,                             Произ-ли товаров списка,gds-list,                    Контрагенты док-тов списка,doc-list,                 Удаленные,deleted,                                   Файл,file,                                           Хранимый в БД список,clob-data,                        Фильтр,filter,                                       Все клиенты,all"
     5065                                        )
     5066                                  ,chr(32)
     5067                                  )
     5068           temp-list.id     = v-index
     5069         .
     5070       end.
     5071     end.
     5072   END PROCEDURE.
     5073   procedure proc-b-macro :
     5074   define input parameter p-option as character no-undo .
     5075   define variable glog as logical no-undo .
     5076   define variable v-id as integer no-undo .
     5077   define variable v-result as character no-undo .
     5078   define variable v-des as character no-undo .
     5079   define variable v-hist-mode as character no-undo .
     5080   define variable v-file as logical no-undo .
     5081   define variable v-full-path        as character no-undo .
     5082   define variable v-path             as character no-undo .
     5083   define variable v-file-name        as character no-undo .
     5084   define variable v-file-name-no-ext as character no-undo .
     5085   define variable v-file-name-ext    as character no-undo .
     5086   define variable v-rid-list as character no-undo .
     5087   define variable v-ok as logical no-undo .
     5088   define buffer buf_cli-list-hist for cli-list-hist.
     5089   define buffer buf_clob-bind for ub.clob-bind.
     5090   define buffer buf_clob-data for ub.clob-data.
     5091   do
     5092   on error undo, return error
     5093   :
     5094     if v-macro-is-running then do:
     5095     end.
     5096     else do:
     5097       glog = yes.
     5098       if an-listp-start-macro-id >= 1 then do:
     5099         case p-option:
     5100           when "file" then do:
     5101         message
     5102         "Согласно командам формирования списка из записанного макроса"
     5103         view-as alert-box question buttons OK-Cancel update glog.
     5104           end.
     5105           when "lob" then do:
     5106             message
     5107             "Нелья!"
     5108             view-as alert-box question buttons OK-Cancel update glog.
     5109             run MyEnable in this-procedure .
     5110             return error.
     5111           end.
     5112         end case.
     5113         if not glog then do:
     5114           run MyEnable in this-procedure .
     5115           return error.
     5116         end.
     5117         if an-listp-end-macro-id = ? then do:
     5118           assign
     5119           an-listp-end-macro-id  = v-seq.
     5120           for each macro-list-hist:
     5121             delete macro-list-hist.
     5122           end.
     5123           for each buf_cli-list-hist where
     5124                   buf_cli-list-hist.id >=  an-listp-start-macro-id
     5125             and  buf_cli-list-hist.id <=  an-listp-end-macro-id:
     5126             create macro-list-hist.
     5127             buffer-copy buf_cli-list-hist
     5128             except id num-recs num-add num-ignored
     5129             to macro-list-hist
     5130             assign
     5131             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5132             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5133             macro-list-hist.done = no
     5134             .
     5135           end.
     5136         end.
     5137         else do:
     5138           find last macro-list-hist no-error.
     5139           if available macro-list-hist then do:
     5140             v-id = macro-list-hist.id.
     5141           end.
     5142         end.
     5143       end.
     5144       else do:
     5145         case p-option:
     5146           when "file" then do:
     5147         message
     5148         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     5149         view-as alert-box question buttons OK-Cancel update glog.
     5150         if not glog then do:
     5151           run MyEnable in this-procedure .
     5152           return error.
     5153         end.
     5154         system-dialog get-file f-name
     5155           filters "Макрос формирования списка *.clm" "*.clm"
     5156           title "Выберите файл макроса"
     5157           INITIAL-DIR "."
     5158           return-to-start-dir
     5159           must-exist
     5160           update glog
     5161           default-extension "clm".
     5162         if not glog then do:
     5163           run MyEnable in this-procedure .
     5164           return error.
     5165         end.
     5166           end.
     5167           when "lob" then do:
     5168             message
     5169             "Согласно командам формирования списка из макроса, сохраненного в БД"
     5170             view-as alert-box question buttons OK-Cancel update glog.
     5171             if not glog then do:
     5172               run MyEnable in this-procedure .
     5173               return error.
     5174             end.
     5175             run ref/clobbnds.w ( input parparentproc
     5176                                 ,input this-procedure:handle
     5177                                 ,input 'b-sel'
     5178                                 ,input "uniq-key-rec"
     5179                                 ,input ""
     5180                                 ,input 'list-macro':U
     5181                                 ,input 'cli-list'
     5182                                 ,input -1
     5183                                 ,input-output v-rid-list) no-error.
     5184             if v-rid-list = '' then do:
     5185               run MyEnable in this-procedure.
     5186               return error.
     5187             end.
     5188             find first buf_clob-bind no-lock where
     5189                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     5190             if not available buf_clob-bind then do:
     5191               message
     5192               "Не найдена ссылка на макрос, сохраненный в БД!"
     5193               view-as alert-box error .
     5194               run MyEnable in this-procedure .
     5195               return error.
     5196             end.
     5197             find first buf_clob-data no-lock where
     5198                       buf_clob-data.db-num = buf_clob-bind.db-num
     5199                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     5200             if not available buf_clob-data then do:
     5201               message
     5202               "Не найдена ссылка на макрос, сохраненный в БД!"
     5203               view-as alert-box error .
     5204               run MyEnable in this-procedure .
     5205               return error.
     5206             end.
     5207             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     5208               message
     5209               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     5210                         , buf_clob-data.db-num
     5211                         , chr(10))
     5212              view-as alert-box question buttons yes-no update v-ok.
     5213              if not v-ok then do:
     5214                 run MyEnable in this-procedure .
     5215                 return error.
     5216              end.
     5217             end.
     5218             run gbl/_tmpfile.p ( input ""
     5219                           ,input "tmp"
     5220                           ,output v-file-name) .
     5221             copy-lob from object buf_clob-data.cdata
     5222             to file f-name.
     5223             run gbl/filename.p
     5224               (input  v-file-name
     5225               ,output f-name
     5226               ,output v-path
     5227               ,output v-file-name
     5228               ,output v-file-name-no-ext
     5229               ,output v-file-name-ext
     5230               ) no-error .
     5231             if error-status:error then do:
     5232             end.
     5233           end.
     5234         end case.
     5235         for each macro-list-hist:
     5236           delete macro-list-hist.
     5237         end.
     5238         input stream sout from value (f-name).
     5239         _macro:
     5240         repeat:
     5241           create macro-list-hist.
     5242           import stream sout macro-list-hist no-error.
     5243           if error-status:error then do:
     5244               undo _macro, next _macro.
     5245           end.
     5246           assign
     5247           macro-list-hist.num-rec = 0
     5248           macro-list-hist.num-add = 0
     5249           macro-list-hist.num-ignored = 0
     5250           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5251           macro-list-hist.done = no
     5252           .
     5253         end.
     5254         find first macro-list-hist where
     5255                 macro-list-hist.id = 0.
     5256         delete macro-list-hist.
     5257         input stream sout close.
     5258         If p-option = "lob" then do:
     5259          os-delete value(f-name).
     5260         end.
     5261         v-file = yes.
     5262       end.
     5263       an-listp-macros-label-id = v-seq.
     5264       run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5265                                           , input-output v-seq
     5266                                           , input 0
     5267                                           , input '>':U
     5268                                           , input (if v-file
     5269                                                   then substitute("Файл макроса : &1", f-name)
     5270                                                   else substitute("Записанный макрос")
     5271                                                   )
     5272                                           , input tot-lns
     5273                                           , input 'macro':U
     5274                                           , input '':U
     5275                                           , input (if v-file then f-name else '':U)
     5276                                           , input '':U
     5277                                           , input ?
     5278                                           ).
     5279     end.
     5280     disable
     5281     b-record
     5282     b-macro
     5283     with frame Dialog-Frame .
     5284     hide
     5285     b-record in frame Dialog-Frame .
     5286     enable
     5287     b-clear-macro with frame Dialog-Frame .
     5288     v-macro-is-running = yes.
     5289     run str/listmcro.w (input parparentproc
     5290                   ,input this-procedure:handle
     5291                  ,input "Макрос формирования списка клиентов" + chr(4) + "clm"
     5292                   ,input "b-play,b-step"
     5293                   ,input-output v-current-step
     5294                   ,input v-id
     5295                   ,output v-result) no-error .
     5296     if error-status:error
     5297     or v-result = "b-stop"
     5298     or v-result = 'end':U
     5299     then do:
     5300       for each macro-list-hist:
     5301         delete macro-list-hist.
     5302       end.
     5303       assign
     5304       an-listp-start-macro-id = ?
     5305       an-listp-end-macro-id = ?
     5306       an-listp-macros-label-id = 0
     5307       .
     5308       menu-item m-macro-file:label in menu m-play = "Сохраненный в файле макрос формирования списка товаров".
     5309       menu-item m-macro-lob:sensitive in menu m-play = yes.
     5310       if v-result = 'b-stop' then do:
     5311         assign
     5312         v-hist-mode = '[]':U
     5313         v-des = "Выполнение макроса прекращено пользователем"
     5314         .
     5315         hide
     5316         b-clear-macro
     5317         b-stop
     5318         in frame Dialog-Frame .
     5319         enable
     5320         b-record
     5321         with frame Dialog-Frame .
     5322       end.
     5323       if v-result = 'end' then do:
     5324         assign
     5325         v-hist-mode = '<':U
     5326         v-des = "Выполнение макроса завершено"
     5327         .
     5328         hide
     5329         b-clear-macro
     5330         b-stop
     5331         in frame Dialog-Frame .
     5332         enable
     5333         b-record
     5334         with frame Dialog-Frame .
     5335       end.
     5336       if error-status:error then do:
     5337         assign
     5338         v-hist-mode = 'E':U
     5339         v-des = "Выполнение макроса прекращено из-за ошибки"
     5340         .
     5341       end.
     5342       run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5343                                           , input-output v-seq
     5344                                           , input 0
     5345                                           , input v-hist-mode
     5346                                           , input v-des
     5347                                           , input tot-lns
     5348                                           , input 'macro':U
     5349                                           , input '':U
     5350                                           , input f-name
     5351                                           , input '':U
     5352                                           , input ?
     5353                                           ) no-error .
     5354       assign
     5355       v-macro-is-running = no
     5356       v-current-step = 0
     5357       .
     5358     end.
     5359     enable
     5360     b-macro
     5361     with frame Dialog-Frame .
     5362   end.
     5363   end procedure.
     5364   procedure proc-create-macro-list-hist :
     5365   define input parameter p-list-table as character no-undo .
     5366   define input parameter p-id as integer           no-undo .
     5367   define input parameter p-line as integer         no-undo .
     5368   define input parameter p-hist-mode as character  no-undo .
     5369   define input parameter p-des as character        no-undo .
     5370   define input parameter p-option_ as character    no-undo .
     5371   define input parameter p-item_ as character      no-undo .
     5372   define input parameter p-status_ as character    no-undo .
     5373   define buffer buf_macro-list-hist for macro-list-hist.
     5374   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5375     do
     5376     on error undo, return error return-value
     5377     :
     5378       create buf_macro-list-hist.
     5379       assign
     5380       buf_macro-list-hist.list-table = p-list-table
     5381       buf_macro-list-hist.id         = p-id
     5382       buf_macro-list-hist.line       = p-line
     5383       buf_macro-list-hist.hist-mode  = p-hist-mode
     5384       buf_macro-list-hist.des        = p-des
     5385       buf_macro-list-hist.option_    = p-option_
     5386       buf_macro-list-hist.item_      = p-item_
     5387       buf_macro-list-hist.status_    = p-status_
     5388       .
     5389       if p-keep-query then do:
     5390         create buf_keep-macro-list-hist.
     5391         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     5392       end.
     5393     end.
     5394   end procedure.
     5395   procedure proc-macro-play :
     5396   define input parameter p-id as integer no-undo .
     5397   define input parameter p-step as logical no-undo .
     5398   define input parameter p-max-id as integer no-undo .
     5399   define variable v-id as integer no-undo .
     5400   define variable v-rowid   as rowid no-undo .
     5401   define variable v-tbl-name as character no-undo .
     5402   define variable v-old-seq as integer no-undo .
     5403   define variable v-current-id as integer no-undo .
     5404   define variable v-temp-seq as integer no-undo .
     5405   define variable v-rs-do-error as logical no-undo .
     5406   define  buffer buf_macro-list-hist for macro-list-hist.
     5407   define  buffer buf_cli-list-hist for cli-list-hist.
     5408   do
     5409   on error undo, return error return-value
     5410   :
     5411     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     5412       assign
     5413       v-current-id = v-current-id + 1
     5414       v-id = macro-list-hist.id.
     5415       CASE entry(1, macro-list-hist.option_, chr(4)):
     5416         when 'macro':U
     5417         or
     5418         when 'title':U
     5419         or
     5420         when 'start':U
     5421         then do:
     5422         end.
     5423         when 'clear':U then do:
     5424           for each cli-list:
     5425             delete cli-list.
     5426           end.
     5427           for each cli-list-hist where cli-list-hist.id > an-listp-macros-label-id:
     5428             delete cli-list-hist.
     5429           end.
     5430           tot-lns = 0.
     5431           v-seq = an-listp-macros-label-id + 1.
     5432           v-no-hist = 0.
     5433           create buf_cli-list-hist.
     5434           buffer-copy macro-list-hist
     5435           to buf_cli-list-hist
     5436           assign buf_cli-list-hist.id = v-seq
     5437           v-temp-seq = v-seq
     5438           v-seq = v-seq + 1
     5439           v-no-hist = v-no-hist + 1
     5440           .
     5441           run MyEnable in this-procedure .
     5442         end.
     5443         when 'single' then do:
     5444            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     5445                                                 ,input ?
     5446                                                 ,input 'ub'
     5447                                                 ,input ?
     5448                                                 ,input no-lock
     5449                                                 ,output v-rowid
     5450                                                 ,output v-tbl-name) no-error .
     5451           if not error-status:error then do:
     5452             CASE macro-list-hist.hist-mode:
     5453               when '+':U then do:
     5454                 run proc-b-add in this-procedure(input yes
     5455                                                 ,input v-rowid
     5456                                                 ,input macro-list-hist.option_
     5457                                                 ,input macro-list-hist.status_) no-error .
     5458               end.
     5459               when '-':U then do:
     5460                 run proc-b-del in this-procedure(input yes
     5461                                                 ,input v-rowid
     5462                                                 ,input macro-list-hist.option_
     5463                                                 ,input macro-list-hist.status_) no-error .
     5464               end.
     5465               when '*':U then do:
     5466                 run proc-b-rest in this-procedure(input yes
     5467                                                  ,input v-rowid
     5468                                                  ,input macro-list-hist.option_
     5469                                                  ,input macro-list-hist.status_) no-error .
     5470               end.
     5471             END.
     5472             if error-status:error then do:
     5473                 return ("error" + chr(4) + return-value) .
     5474             end.
     5475             find first  buf_cli-list-hist where
     5476                     buf_cli-list-hist.id = v-seq - 1 no-error .
     5477             if available buf_cli-list-hist then
     5478             assign
     5479             macro-list-hist.num-recs = buf_cli-list-hist.num-recs
     5480             macro-list-hist.num-add = buf_cli-list-hist.num-add
     5481             macro-list-hist.num-ignored = buf_cli-list-hist.num-ignored
     5482             .
     5483           end.
     5484           else do:
     5485             return ("error" + chr(4) + return-value).
     5486           end.
     5487         end.
     5488         otherwise do:
     5489           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     5490           or lookup(macro-list-hist.option_, '':U) > 0
     5491           then do:
     5492             if macro-list-hist.line = 0 then do:
     5493               v-no-hist = 0.
     5494               for each buf_macro-list-hist where
     5495                       buf_macro-list-hist.id = v-id:
     5496                 create buf_cli-list-hist.
     5497                 buffer-copy buf_macro-list-hist
     5498                 except id  num-recs num-add num-ignored done
     5499                 to buf_cli-list-hist
     5500                 assign
     5501                 buf_cli-list-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     5502                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     5503                 v-seq = (if buf_macro-list-hist.line = 0
     5504                         then (v-seq + 1)
     5505                         else v-seq)
     5506                 v-no-hist = v-no-hist + 1
     5507                 .
     5508               end.
     5509               if v-no-hist = 1 then v-no-hist = 0.
     5510               run rs-do in this-procedure (input yes
     5511                                         , input p-step
     5512                                         , input macro-list-hist.option_
     5513                                         , input macro-list-hist.status_
     5514                                         , input get-line-mode(macro-list-hist.hist-mode)
     5515                                         , input v-temp-seq
     5516                                         ) no-error .
     5517               if error-status:error then do:
     5518                 assign
     5519                 v-rs-do-error = yes.
     5520               end.
     5521               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     5522                 run proc-b-rest-2 in this-procedure .
     5523                 run MyEnable in this-procedure .
     5524               end.
     5525               for each buf_cli-list-hist where
     5526                       buf_cli-list-hist.id = v-temp-seq,
     5527                  first buf_macro-list-hist where
     5528                       buf_macro-list-hist.id = v-id
     5529                   AND buf_macro-list-hist.line = buf_cli-list-hist.line:
     5530                  assign
     5531                  buf_macro-list-hist.num-recs = buf_cli-list-hist.num-recs
     5532                  buf_macro-list-hist.num-add = buf_cli-list-hist.num-add
     5533                  buf_macro-list-hist.num-ignored = buf_cli-list-hist.num-ignored
     5534                  .
     5535               end.
     5536               if v-rs-do-error then do:
     5537                 run MyEnable in this-procedure .
     5538                 return ("error" + chr(4) + return-value).
     5539               end.
     5540               v-id = macro-list-hist.id.
     5541             end.
     5542           end.
     5543         end.
     5544       END CASE.
     5545     end.
     5546   end.
     5547   end procedure.
     5548   procedure proc-b-rest-2 :
     5549     do
     5550     on error undo, return error
     5551     :
     5552       for each cli-list:
     5553         if cli-list.to-del = ? then do:
     5554           assign
     5555           cli-list.to-del = no
     5556           .
     5557         end.
     5558         else do:
     5559           delete cli-list.
     5560         end.
     5561       end.
     5562       tot-lns = lns-cnt.
     5563     end.
     5564   end procedure.
     5565   PROCEDURE proc-expand :
     5566   define input parameter p-shift as integer no-undo .
     5567   define input parameter p-from as integer no-undo .
     5568   define input parameter p-to as integer no-undo .
     5569   define input parameter p-forcer-name as character no-undo .
     5570   define variable fh as widget-handle no-undo .
     5571   define variable hh as widget-handle no-undo .
     5572   define variable lh as widget-handle no-undo .
     5573   define variable ii as INTEGER no-undo .
     5574   ASSIGN
     5575   fh = frame Dialog-Frame:first-child
     5576   hh = fh:first-child
     5577   .
     5578   CASE v-expand:
     5579     WHEN YES THEN DO:
     5580       ASSIGN
     5581       v-expand = NO.
     5582       DO ii = 1 TO NUM-ENTRIES(v-downed):
     5583         ASSIGN
     5584         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     5585         hh:ROW          = (hh:ROW - p-shift).
     5586         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     5587       END.
     5588     END.
     5589     WHEN NO THEN DO:
     5590       v-expand = YES.
     5591       v-downed = ''.
     5592       _do:
     5593       do while valid-handle(hh):
     5594         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     5595          AND hh:ROW >= p-from
     5596          AND hh:ROW <= p-to
     5597          and lookup(hh:name, p-forcer-name) = 0
     5598          THEN DO:
     5599           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     5600           hh:ROW          = (hh:ROW + p-shift).
     5601           ASSIGN
     5602           v-downed = v-downed + chr(44) + STRING(hh).
     5603           IF hh:TYPE = "fill-in"
     5604           AND valid-handle(hh:side-label-handle) THEN dO:
     5605             assign
     5606             lh = hh:SIDE-LABEL-HANDLE
     5607             lh:ROW = lh:ROW + p-shift
     5608             v-downed = v-downed + chr(44) + STRING(lh)
     5609             .
     5610            END.
     5611          END.
     5612          hh = hh:next-sibling.
     5613       END.
     5614       v-downed = trim(v-downed, chr(44)).
     5615     END.
     5616   END CASE.
     5617   END PROCEDURE.
     5618   if lookup(bttns, "hide") = 0 then do:
     5619   run diasize_add_browse in this-procedure
     5620     (input  'height':u
     5621     ,input  browse BR-option :handle
     5622     ) .
     5623   run diasize_init in this-procedure .
     5624   end.
     5625   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5626   PROCEDURE ex-cli :
     5627   define input parameter rs-list-method as character no-undo .
     5628   define input parameter rs-status as character no-undo .
     5629   define input parameter line-mode as character no-undo .
     5630   if rs-list-method = "single":U or
     5631     (ub.clients.stts = 0  and rs-status <> 'удаленные':U) or
     5632     (ub.clients.stts <> 0 and rs-status <> 'текущие':U) then do:
     5633     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
     5634       find first cli-list where
     5635                  cli-list.obj-type = ub.clients.obj-type AND
     5636                  cli-list.obj-code = ub.clients.obj-code no-error.
     5637       if available cli-list then do:
     5638         if line-mode = 'удаление':U then do:
     5639           lns-cnt = lns-cnt + 1.
     5640           delete cli-list.
     5641         end.
     5642         else do:
     5643           if cli-list.to-del = ? then .
     5644           else do:
     5645              lns-cnt = lns-cnt + 1.
     5646              cli-list.to-del = ?.
     5647           end.
     5648         end.
     5649       end.
     5650     end.
     5651     else
     5652       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
     5653   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5654   find cli-list
     5655     where cli-list.obj-type = clients.obj-type
     5656       and cli-list.obj-code = clients.obj-code
     5657     no-error .
     5658   if available cli-list then do:
     5659     assign
     5660       cli-list.to-del = no
     5661     .
     5662   end.
     5663   else do:
     5664     create cli-list .
     5665     buffer-copy clients to cli-list
     5666     assign
     5667       cli-list.to-del = no
     5668     .
     5669     assign
     5670       lns-cnt = lns-cnt + 1
     5671       line-rec = recid (cli-list)
     5672     .
     5673   end.
     5674       end.
     5675     if lns-cnt modulo 25 = 0 then
     5676     disp "Ждите..." + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     5677   end.
     5678   else
     5679   assign
     5680   lns-ignore = lns-ignore + 1
     5681   .
     5682   end.
     5683   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5684   do:
     5685     br-list :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     5686   end.
     5687   MAIN-BLOCK:
     5688   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5689      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     5690     if lookup("automain", parparentproc:file-name, ".") > 0 then do:
     5691       v-no-context = yes.
     5692     end.
     5693     else do:
     5694   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5695     run mainmenu_getcntxt in parparentproc
     5696       (output v-cntxt-db-num
     5697       ,output v-cntxt-userid
     5698       ,output v-cntxt-level
     5699       ,output v-cntxt-host-code-obj
     5700       ,output v-cntxt-obj-type
     5701       ,output v-cntxt-obj-code
     5702       ,output v-cntxt-db-num-obj
     5703       ,output v-cntxt-is-admin
     5704       ) .
     5705     end.
     5706   define variable vss-include-info41 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5707   do:
     5708     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5709       (input  v-cntxt-db-num
     5710       ,input  v-cntxt-userid
     5711       ,input  0
     5712       ,input  'actn_documents_all':U
     5713       ,input  'global':U
     5714       ,input  0
     5715       ,input  '':U
     5716       ,input  0
     5717       ,input  0
     5718       ,input  0
     5719       ,input  0
     5720       ,input  false
     5721       ,output v-docs-all
     5722       )  .
     5723   end.
     5724   define variable vss-include-info42 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5725   do:
     5726     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5727       (input  v-cntxt-db-num
     5728       ,input  v-cntxt-userid
     5729       ,input  0
     5730       ,input  'actn_documents_company':U
     5731       ,input  'firm':U
     5732       ,input  v-cntxt-host-code-obj
     5733       ,input  '':U
     5734       ,input  0
     5735       ,input  0
     5736       ,input  0
     5737       ,input  0
     5738       ,input  false
     5739       ,output v-docs-cmp
     5740       )  .
     5741   end.
     5742     run get-report-num in parparentproc ( output g#report-num ).
     5743       assign
     5744       line-rec = ?
     5745       .
     5746       assign
     5747       n-c:radio-buttons in frame Dialog-Frame =
     5748       "Название" + chr(44) + 'название':U + chr(44) +
     5749                       "Код" + chr(44) + 'код':U
     5750       RS-status:radio-buttons = "Текущие&+" + chr(44) + 'текущие':U + chr(44) +
     5751                                 "Все!" + chr(44) + 'все':U + chr(44) +
     5752                                 "Удаленные-" + chr(44) + 'удаленные':U
     5753       RS-status = 'текущие':U
     5754       .
     5755     ASSIGN b-save:MENU-MOUSE = 1.
     5756     ASSIGN b-print:MENU-MOUSE = 1.
     5757     assign b-macro:menu-mouse = 1.
     5758     run proc-fill-temp-list in this-procedure .
     5759     if lookup(bttns, "hide") > 0 then do:
     5760       return.
     5761     end.
     5762     RUN Myenable in this-procedure .
     5763     APPLY "VALUE-CHANGED" to n-c.
     5764     WAIT-FOR GO OF FRAME Dialog-Frame.
     5765   END.
     5766   RUN disable_UI in this-procedure .
     5767   procedure cb_fill-lob-res-list :
     5768   define input  parameter p-full-path as character no-undo .
     5769   output to value (p-full-path).
     5770   for each cli-list:
     5771     export
     5772     cli-list.obj-type
     5773     cli-list.obj-code.
     5774   end.
     5775   output close.
     5776   end procedure.
     5777   procedure cb_fill-lob-res-list-macro :
     5778   define input  parameter p-full-path as character no-undo .
     5779   define buffer buf_cli-list-hist for cli-list-hist.
     5780   output to value (p-full-path).
     5781   for each buf_cli-list-hist:
     5782       export
     5783       buf_cli-list-hist.
     5784   end.
     5785   output close.
     5786   end procedure.
     5787   procedure cb_get-next-cli-by-obj-type-code :
     5788   define input parameter p-obj-type as character no-undo .
     5789   define input parameter p-obj-code as integer no-undo .
     5790   define input parameter p-bh as handle no-undo .
     5791   define buffer buf_cli-list for cli-list.
     5792   find first buf_cli-list no-lock where
     5793             (buf_cli-list.obj-type = p-obj-type
     5794        and  buf_cli-list.obj-code = p-obj-code) no-error.
     5795   find next buf_cli-list use-index obj no-error.
     5796   if available buf_cli-list then do:
     5797     p-bh:buffer-create().
     5798     p-bh:buffer-copy(buffer buf_cli-list:handle).
     5799   end.
     5800   else do:
     5801   end.
     5802   end procedure.
     5803   PROCEDURE disable_UI :
     5804     HIDE FRAME Dialog-Frame.
     5805   END PROCEDURE.
     5806   PROCEDURE enable_UI :
     5807     DISPLAY dsp-rs NameOrCode n-c RS-Status ed-notes f-tot-lns
     5808         WITH FRAME Dialog-Frame.
     5809     ENABLE dsp-rs B-exit B-save B-print B-hist B-lkp B-clr B-Help B-add
     5810            B-del B-rest B-macro B-stop B-clear-macro B-record NameOrCode
     5811            n-c RS-Status BR-list ed-notes f-tot-lns
     5812         WITH FRAME Dialog-Frame.
     5813     VIEW FRAME Dialog-Frame.
     5814     OPEN QUERY BR-list FOR EACH cli-list NO-LOCK INDEXED-REPOSITION.     open query br-option for each temp-list no-lock .
     5815   END PROCEDURE.
     5816   procedure m_cli-save-db-proc :
     5817   define variable v-rid-list as character no-undo .
     5818   run ref/clobbnds.w ( input parparentproc
     5819                       ,input this-procedure:handle
     5820                       ,input 'b-add'
     5821                       ,input "uniq-key-rec"
     5822                       ,input 'ИЗМЕНЕНИЕ':U
     5823                       ,input 'list':U
     5824                       ,input 'cli-list'
     5825                       ,input -1
     5826                       ,input-output v-rid-list) no-error.
     5827   end procedure.
     5828   procedure m-macros-save-db-proc :
     5829   define variable v-rid-list as character no-undo .
     5830   run ref/clobbnds.w ( input parparentproc
     5831                       ,input this-procedure:handle
     5832                       ,input 'b-add'
     5833                       ,input "uniq-key-rec"
     5834                       ,input 'ИЗМЕНЕНИЕ':U
     5835                       ,input 'list-macro':U
     5836                       ,input 'cli-list'
     5837                       ,input -1
     5838                       ,input-output v-rid-list) no-error.
     5839   end procedure.
     5840   PROCEDURE MyEnable :
     5841   define variable v-start as logical no-undo .
     5842   define variable v-recid0 as recid no-undo .
     5843   define buffer buf_temp-list for temp-list.
     5844   define buffer buf_cli-list-hist for cli-list-hist.
     5845   find first buf_cli-list-hist where buf_cli-list-hist.id = 0 no-error.
     5846   if available buf_cli-list-hist then
     5847   assign
     5848   frame Dialog-Frame:title = substitute("СПИСОК  КАРТ &1",  string(buf_cli-list-hist.des, "X(60)"))
     5849   .
     5850   br-option:column-scrolling in frame Dialog-Frame  = no.
     5851   if tot-lns = ? then do:
     5852     v-start = yes.
     5853     for each l-cli-list :
     5854       accumulate l-cli-list.obj-code (count).
     5855     end.
     5856     tot-lns = (accum count l-cli-list.obj-code).
     5857     if tot-lns > 0 then do:
     5858       find last  buf_cli-list-hist no-error .
     5859       v-seq = (if available buf_cli-list-hist then buf_cli-list-hist.id else 0)  + 1.
     5860       run create-cli-list-hist in this-procedure (
     5861                                               input 'ДОБАВЛЕНИЕ':U
     5862                                             , input-output v-seq
     5863                                             , input 0
     5864                                             , input 'S':U
     5865                                             , input substitute("# Исходный список: &1 строк", tot-lns)
     5866                                             , input tot-lns
     5867                                             , input "start":U
     5868                                             , input '':U
     5869                                             , input '':U
     5870                                             , input '':U
     5871                                             , input ?
     5872                                             ).
     5873     end.
     5874     else do:
     5875       line-mode = 'ДОБАВЛЕНИЕ':U.
     5876       for each buf_cli-list-hist:
     5877         delete buf_cli-list-hist.
     5878       end.
     5879       v-seq = 1.
     5880       run create-cli-list-hist in this-procedure ( input 'ДОБАВЛЕНИЕ':U
     5881                                             , input-output v-seq
     5882                                             , input 0
     5883                                             , input '':U
     5884                                             , input "# Исходный список клиентов пуст."
     5885                                             , input tot-lns
     5886                                             , input 'start':U
     5887                                             , input '':U
     5888                                             , input '':U
     5889                                             , input '':U
     5890                                             , input ?
     5891                                             ).
     5892     end.
     5893   end.
     5894   assign
     5895   nameorcode = ""
     5896   RS-list-method = "single".
     5897   find first buf_temp-list no-lock where
     5898               buf_temp-list.fvalue = "single".
     5899   assign
     5900   v-recid0 = recid(buf_temp-list).
     5901   open query br-option for each temp-list no-lock .
     5902   if v-seq > 1 then
     5903   find last buf_cli-list-hist no-lock where
     5904             buf_cli-list-hist.id = (v-seq - 1)
     5905         and  buf_cli-list-hist.line = 0 no-error .
     5906   DISPLAY br-option
     5907   (if available buf_cli-list-hist
     5908   then buf_cli-list-hist.des
     5909   else '') @ dsp-rs
     5910   RS-Status WITH FRAME Dialog-Frame.
     5911   ENABLE
     5912   b-macro  when v-start
     5913   b-record when v-start
     5914   b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     5915   if v-start then do:
     5916     hide
     5917     b-stop
     5918     b-clear-macro
     5919     in frame Dialog-Frame.
     5920   end.
     5921   v-start = no.
     5922   hide nameorcode in frame Dialog-Frame .
     5923   reposition br-option to recid v-recid0.
     5924   if tot-lns > 0 then
     5925     ENABLE
     5926     b-print
     5927     b-rest
     5928     b-save
     5929     b-del
     5930     b-lkp
     5931     b-clr
     5932     n-c
     5933     nameorcode
     5934     WITH FRAME Dialog-Frame.
     5935   else do:
     5936     DISABLE b-print b-rest b-save b-del b-lkp b-clr n-c nameorcode WITH FRAME Dialog-Frame.
     5937   end.
     5938   if tot-lns = ? or tot-lns = 0 then do:
     5939     hide nameorcode in frame Dialog-Frame .
     5940   end.
     5941   VIEW FRAME Dialog-Frame.
     5942   run openbr in this-procedure .
     5943       if line-rec <> ? then
     5944     reposition br-list to recid line-rec no-error.
     5945   if avail cli-list then do:     assign ed-notes = cli-list.ps.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.   else do:     assign ed-notes = ''.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.
     5946   END PROCEDURE.
     5947   PROCEDURE Openbr :
     5948   Open query br-list
     5949   for each cli-list No-LOCK indexed-reposition.
     5950   APPLY "ENTRY" to br-list in frame Dialog-Frame.
     5951   END PROCEDURE.
     5952   PROCEDURE proc-b-add :
     5953   define input parameter p-from-macro as logical no-undo .
     5954   define input parameter p-rowid as rowid no-undo .
     5955   define input parameter rs-list-method as character no-undo .
     5956   define input parameter rs-status as character no-undo .
     5957   line-mode = 'ДОБАВЛЕНИЕ':U.
     5958   if rs-list-method = "single" then do:
     5959     v-no-hist = - 1.
     5960     if p-from-macro then do:
     5961       find ub.clients where rowid(ub.clients) = p-rowid no-lock no-error .
     5962     end.
     5963     else do:
     5964     run ref/cli-all.w (
     5965                         input parparentproc
     5966                       , input "b-sel,b-add"
     5967                       , input ?
     5968                       , input ?
     5969                       , input ?
     5970                       , input ?
     5971                       , input ?
     5972                       , input ?
     5973                       , output ref-list).
     5974       apply "entry" to br-list in frame Dialog-Frame.
     5975       if ref-list = "" then return error.
     5976       find ub.clients where recid (ub.clients) = integer (ref-list) no-lock.
     5977     end.
     5978     if available ub.clients then do:
     5979       run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     5980       tot-lns = tot-lns + 1.
     5981       run write-hist in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode).
     5982     end.
     5983     else do:
     5984       return error "Нет в БД такого клиента".
     5985     end.
     5986     run Myenable in this-procedure .
     5987   end.
     5988   else do:
     5989       run rs-do in this-procedure ( input no, input no, input rs-list-method, input rs-status, input line-mode, input (v-seq - 1)).
     5990   end.
     5991   END PROCEDURE.
     5992   PROCEDURE proc-b-del :
     5993   define input parameter p-from-macro as logical no-undo .
     5994   define input parameter p-rowid as rowid no-undo .
     5995   define input parameter rs-list-method as character no-undo .
     5996   define input parameter rs-status as character no-undo .
     5997   define variable rep-rec as recid no-undo .
     5998   define variable glog as logical no-undo .
     5999   line-mode = 'удаление':U.
     6000   if rs-list-method = "single" then do:
     6001     v-no-hist = - 1.
     6002     if p-from-macro then do:
     6003       find first ub.clients where rowid(ub.clients) = p-rowid no-error.
     6004       if not available ub.clients then return error "Нет в БД такой клиента".
     6005       find first cli-list where
     6006                cli-list.obj-type = ub.clients.obj-type
     6007            AND cli-list.obj-code = ub.clients.obj-code no-error.
     6008     end.
     6009     if available cli-list then do:
     6010       line-rec = recid (cli-list).
     6011       get next br-list.
     6012       if available cli-list then rep-rec = recid (cli-list).
     6013       else do:
     6014         reposition br-list to recid line-rec no-error.
     6015         get prev br-list.
     6016         if available cli-list then rep-rec = recid (cli-list).
     6017       end.
     6018       reposition br-list to recid line-rec no-error.
     6019       tot-lns = tot-lns - 1.
     6020       run write-hist in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode).
     6021       delete cli-list.
     6022       line-rec = rep-rec.
     6023       run Myenable in this-procedure .
     6024     end.
     6025   end.
     6026   else do:
     6027     glog = no.
     6028     message "Удалить клиентов из списка ПО заданному УСЛОВИЮ ?   Вы уверены ?"
     6029             view-as alert-box question buttons OK-Cancel update glog.
     6030     if not glog then
     6031       return error.
     6032     run rs-do in this-procedure ( input no, input no, input rs-list-method, input rs-status, input line-mode, input (v-seq - 1)).
     6033   end.
     6034   END PROCEDURE.
     6035   PROCEDURE proc-b-rest :
     6036   define input parameter p-from-macro as logical no-undo .
     6037   define input parameter p-rowid as rowid no-undo .
     6038   define input parameter rs-list-method as character no-undo .
     6039   define input parameter rs-status as character no-undo .
     6040   define variable glog as logical no-undo .
     6041   define buffer buf_cli-list-hist for cli-list-hist.
     6042   line-mode = 'ОСТАВИТЬ':U.
     6043   if rs-list-method = "single" then do:
     6044     v-no-hist = - 1.
     6045     if p-from-macro then do:
     6046       find first ub.clients where rowid(ub.clients) = p-rowid no-error.
     6047       if not available ub.clients then return error substitute("Нет в БД такого клиента").
     6048       find first cli-list where
     6049                 cli-list.obj-type = ub.clients.obj-type
     6050             AND cli-list.obj-code = ub.clients.obj-code no-error.
     6051     end.
     6052     if available cli-list then do:
     6053       if p-from-macro then do:
     6054          glog = yes.
     6055       end.
     6056       else do:
     6057         glog = no.
     6058         message
     6059         "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     6060         view-as alert-box question buttons OK-Cancel update glog.
     6061         if not glog then return no-apply.
     6062       end.
     6063       line-rec = recid (cli-list).
     6064       v-seq = 1.
     6065       for each buf_cli-list-hist:
     6066         delete buf_cli-list-hist.
     6067       end.
     6068       run write-hist in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode).
     6069       for each cli-list:
     6070         if line-rec <> recid (cli-list) then delete cli-list.
     6071       end.
     6072       tot-lns = 1.
     6073       run Myenable in this-procedure .
     6074     end.
     6075     else do:
     6076       return error substitute("Нет в списке такой клиента").
     6077     end.
     6078   end.
     6079   else do:
     6080     if not p-from-macro then do:
     6081       glog = no.
     6082       message
     6083       "Оставить клиентов в списке ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕХ ОСТАЛЬНЫХ ?   Вы уверены ?"
     6084       view-as alert-box question buttons OK-Cancel update glog.
     6085       if not glog then
     6086         return no-apply.
     6087     end.
     6088     assign
     6089     lns-cnt = 0
     6090     lns-ignore = 0
     6091     .
     6092     run rs-do in this-procedure ( input no, input no, input rs-list-method, input rs-status, input line-mode, input (v-seq - 1)).
     6093     for each cli-list:
     6094       if cli-list.to-del = ? then do:
     6095         assign
     6096         cli-list.to-del = no
     6097         .
     6098       end.
     6099       else do:
     6100         delete cli-list.
     6101       end.
     6102     end.
     6103     tot-lns = lns-cnt.
     6104     run Myenable in this-procedure .
     6105     message
     6106     "Оставлено строк :" lns-cnt skip(0)
     6107     string(if lns-ignore <> 0
     6108     then ("Проигнорировано строк :" + string(lns-ignore))
     6109     else "":U)
     6110     .
     6111   end.
     6112   END PROCEDURE.
     6113   procedure proc-file-list-methods :
     6114   define input parameter p-from-macro as logical no-undo .
     6115   define input parameter rs-list-method as character no-undo .
     6116   define input parameter rs-status as character no-undo .
     6117   define input parameter line-mode as character no-undo .
     6118   define input parameter p-id      as integer no-undo .
     6119   define variable ss as character no-undo .
     6120   define variable imp-type like ub.goods.prod-type no-undo.
     6121   define variable imp-code like ub.goods.prod-code no-undo.
     6122   define variable imp-art like ub.goods.artic no-undo.
     6123   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
     6124   define variable imp-doc-type as character no-undo.
     6125   define variable v-full-path        as character no-undo .
     6126   define variable v-path             as character no-undo .
     6127   define variable v-file-name        as character no-undo .
     6128   define variable v-file-name-no-ext as character no-undo .
     6129   define variable v-file-name-ext    as character no-undo .
     6130   define variable v-tbl-row          as rowid no-undo .
     6131   define variable v-tbl-name         as character no-undo .
     6132   define buffer buf_cli-list-hist for cli-list-hist.
     6133   define buffer buf_clob-data for ub.clob-data.
     6134   define buffer buf_clob-bind for ub.clob-bind.
     6135   do
     6136   on error undo, return error
     6137   :
     6138     find first buf_cli-list-hist where
     6139             buf_cli-list-hist.id = p-id
     6140         AND buf_cli-list-hist.item_ <> '':U .
     6141   if rs-list-method = "clob-data" then do:
     6142     run gen-row-keyr in this-procedure (
     6143      input  buf_cli-list-hist.item_
     6144     ,input  ?
     6145     ,input  "ub"
     6146     ,input  ?
     6147     ,input NO-LOCK
     6148     ,output v-tbl-row
     6149     ,output v-tbl-name  ) no-error.
     6150     if error-status :error then do:
     6151       message
     6152       "Ошибка при поиске хранимого файла"
     6153       view-as alert-box error.
     6154       return error.
     6155     end.
     6156     find first buf_clob-bind no-lock where
     6157               rowid(buf_clob-bind) = v-tbl-row .
     6158     find first buf_clob-data no-lock where
     6159               buf_clob-data.db-num = buf_clob-bind.db-num
     6160           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     6161     if error-status :error then do:
     6162       message
     6163       "Ошибка при пополучении хранимого файла"
     6164       view-as alert-box error.
     6165       return error.
     6166     end.
     6167     run gbl/_tmpfile.p ( input ""
     6168                   ,input "tmp"
     6169                   ,output v-file-name) .
     6170     copy-lob from object buf_clob-data.cdata
     6171     to file v-file-name.
     6172   end.
     6173     run gbl/filename.p (
     6174      input  (if rs-list-method = "clob-data" then v-file-name else buf_cli-list-hist.item_  )
     6175     ,output v-full-path
     6176     ,output v-path
     6177     ,output v-file-name
     6178     ,output v-file-name-no-ext
     6179     ,output v-file-name-ext
     6180     ) no-error .
     6181     if error-status:error then do:
     6182     end.
     6183     else do:
     6184       input stream sout from value (v-full-path).
     6185       CASE rs-list-method:
     6186         when "doc-list" then do:
     6187           repeat:
     6188             import stream sout imp-doc-code imp-doc-type no-error.
     6189             if imp-doc-type <>  'переоценка':U then do:
     6190               find first ub.trn-doc no-lock where
     6191                         ub.trn-doc.doc-code = imp-doc-code No-error.
     6192               if available ub.trn-doc  then do:
     6193                 find first ub.clients no-lock where
     6194                           ub.clients.obj-type = ub.trn-doc.cli-type
     6195                       AND ub.clients.obj-code = ub.trn-doc.cli-code no-error.
     6196                  if available ub.clients then
     6197                  run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     6198               end.
     6199             end.
     6200           end.
     6201         end.
     6202         when "file"
     6203         or
     6204         when "clob-data"
     6205         then do:
     6206           repeat:
     6207             import stream sout imp-type imp-code no-error.
     6208             find clients where
     6209                 clients.obj-type = imp-type and
     6210                 CLIENTS.OBJ-code = imp-code
     6211                 no-lock no-error.
     6212             if available CLIENTS then do:
     6213               run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     6214             end.
     6215           end.
     6216           if rs-list-method = "clob-data" then do:
     6217             os-delete value(v-full-path) .
     6218           end.
     6219         end.
     6220         when "gds-list" then do:
     6221           repeat:
     6222             import stream sout imp-type imp-code imp-art no-error.
     6223             find ub.goods where ub.goods.prod-type = imp-type
     6224                       and ub.goods.prod-code = imp-code
     6225                       and ub.goods.artic     = imp-art no-lock no-error.
     6226             if available ub.goods then do:
     6227               find first ub.clients no-lock where
     6228                         ub.clients.obj-type = ub.goods.prod-type
     6229                     AND ub.clients.obj-code = ub.goods.prod-code no-error.
     6230               if available ub.clients then do:
     6231                 run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     6232               end.
     6233             end.
     6234           end.
     6235         end.
     6236       end CASE.
     6237     end.
     6238     input stream sout close.
     6239     assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     6240   end.
     6241   end procedure.
     6242   PROCEDURE proc-b-save :
     6243   define input parameter loc-save-option as character no-undo.
     6244   define variable v-frame-width as integer no-undo.
     6245   define variable glog as logical no-undo .
     6246   define variable v-rid-list as character no-undo .
     6247   case loc-save-option:
     6248     when "cli-list":U then do:
     6249       assign
     6250       f-name = "default.cli"
     6251       glog = yes
     6252       .
     6253       system-dialog get-file f-name
     6254       filters "Списки клиентов *.cli" "*.cli"
     6255       ask-overwrite
     6256       save-as
     6257       use-filename
     6258       update glog
     6259       default-extension "cli".
     6260       if not glog then do:
     6261         apply "entry" to br-list in frame Dialog-Frame.
     6262         return no-apply.
     6263       end.
     6264       output to value (f-name).
     6265       for each cli-list:
     6266         export
     6267         cli-list.obj-type
     6268         cli-list.obj-code
     6269         .
     6270       end.
     6271       output close.
     6272     end.
     6273     when "cli-list-macros-db" then do:
     6274       run m-macros-save-db-proc in this-procedure .
     6275     END.
     6276     when "cli-list-db" then do:
     6277       run m_cli-save-db-proc in this-procedure .
     6278     end.
     6279     when "excel":U then do:
     6280       do on stop  undo, return no-apply
     6281           on error undo, return no-apply
     6282           on quit  undo, return no-apply
     6283       :
     6284         run str/clil-prn.p (
     6285                          input parparentproc
     6286                         ,input "excel":U
     6287                         ,output v-Frame-Width) no-error.
     6288         run waitfram-hide in this-procedure .
     6289       end.
     6290     end.
     6291   end case.
     6292   END PROCEDURE.
     6293   PROCEDURE proc-find-nameorcode :
     6294   case n-c:
     6295     when 'название':U then do:
     6296       if last-event:label = "Ctrl-J" then
     6297           find next l-cli-list no-lock where
     6298                      l-cli-list.obj-name begins nameorcode no-error.
     6299       else
     6300           find first l-cli-list no-lock where
     6301                      l-cli-list.obj-name begins nameorcode no-error.
     6302     end.
     6303     when 'код':U then do:
     6304       if last-event:label = "Ctrl-J" then
     6305           find next l-cli-list no-lock where
     6306                      l-cli-list.obj-code = integer(nameorcode) no-error.
     6307       else
     6308           find first l-cli-list no-lock where
     6309                      l-cli-list.obj-code = integer(nameorcode) no-error.
     6310     end.
     6311   end case.
     6312   if available l-cli-list then do:
     6313     line-rec = recid (l-cli-list).
     6314     reposition br-list to recid line-rec no-error.
     6315     apply "value-changed" to br-list in frame Dialog-Frame.
     6316   end.
     6317   else do:
     6318     message
     6319     "Строка не найдена."
     6320     view-as alert-box error.
     6321   end.
     6322   END PROCEDURE.
     6323   procedure proc-macros :
     6324   define variable glog as logical no-undo .
     6325   define variable v-option as integer no-undo .
     6326   define buffer buf_cli-list-hist for cli-list-hist.
     6327   define buffer buf_macro-list-hist for macro-list-hist.
     6328   if can-find(first macro-list-hist) then do:
     6329     run gbl/d-askw.w ( input "Сохранение макроса"
     6330                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
     6331                   ,input "|"
     6332                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
     6333                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
     6334                   ,input 1
     6335                   ,input 3
     6336                   ,output v-option).
     6337     if v-option = 3 then return no-apply.
     6338     v-option = 1.
     6339   end.
     6340   else do:
     6341     message
     6342     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
     6343     view-as alert-box question buttons yes-no update glog.
     6344     v-option = 2.
     6345     if not glog then do:
     6346       return no-apply.
     6347     end.
     6348   end.
     6349     do
     6350     on error undo, return error
     6351     :
     6352     assign
     6353       f-name = "default.clm"
     6354       glog = yes
     6355       .
     6356     system-dialog get-file f-name
     6357       filters "Макрос создания списка клиентов *.clm" "*.clm"
     6358       ask-overwrite
     6359       save-as
     6360       use-filename
     6361       update glog
     6362       default-extension "clm".
     6363     if not glog then do:
     6364       apply "entry" to br-list in frame Dialog-Frame.
     6365       return no-apply.
     6366     end.
     6367     run waitfram-show in this-procedure ( input "Сохранение макроса формирования списка клиентов.    ЖДИТЕ...").
     6368     output stream PrnLibStream to value (f-name).
     6369     case v-option:
     6370       when 1 then do:
     6371         for each buf_macro-list-hist:
     6372           export stream PrnLibStream
     6373           buf_macro-list-hist.
     6374         end.
     6375       end.
     6376       when 2 then do:
     6377     for each buf_cli-list-hist:
     6378         export stream PrnLibStream
     6379         buf_cli-list-hist.
     6380     end.
     6381       end.
     6382     end case.
     6383     output stream PrnLibStream close.
     6384     run waitfram-hide in this-procedure .
     6385     end.
     6386   end procedure.
     6387   PROCEDURE proc-vc-rs-list-method :
     6388   define variable v-operation as integer no-undo .
     6389   define variable ii as integer no-undo.
     6390   define variable glog as logical no-undo .
     6391   define variable v-recs as integer no-undo .
     6392   define variable v-line as integer no-undo .
     6393   define variable v-item as character no-undo .
     6394   define variable v-tbl-name as character no-undo .
     6395   define variable v-bh as handle no-undo .
     6396   define variable v-tot-lns as integer no-undo .
     6397   define variable v-temp-seq as integer no-undo .
     6398   define variable v-message as character no-undo .
     6399   define variable grp-path as character no-undo .
     6400   define variable v-input-output as character no-undo .
     6401   define variable v-ref-rec as recid no-undo .
     6402   define variable v-grp-rec as recid no-undo .
     6403   define variable v-rid-list as character no-undo .
     6404   define variable v-uniq-key-rec as character no-undo .
     6405   define variable f-name as char init "default.cli" no-undo.
     6406   define buffer buf_clob-bind for ub.clob-bind.
     6407   define buffer buf_cli-list-hist for cli-list-hist.
     6408   v-no-hist = - 1.
     6409   if  rs-list-method = "single" then
     6410   run Myenable in this-procedure .
     6411   else do:
     6412      v-no-hist = 0.
     6413     case rs-list-method:
     6414       when "all" then do:
     6415         glog = yes.
     6416         message "Все клиенты из справочника клиентов"
     6417         skip stat-line(rs-status)
     6418         view-as alert-box question buttons OK-Cancel update glog.
     6419         if not glog then do:
     6420           run MyEnable in this-procedure .
     6421           return error.
     6422         end.
     6423         v-no-hist = 1.
     6424         run create-cli-list-hist in this-procedure (
     6425                                               input 'ДОБАВЛЕНИЕ':U
     6426                                             , input-output v-seq
     6427                                             , input 0
     6428                                             , input '':U
     6429                                             , input substitute('Все клиенты &1', stat-line(rs-status))
     6430                                             , input tot-lns
     6431                                             , input rs-list-method
     6432                                             , input rs-status
     6433                                             , input 'all':U
     6434                                             , input '':U
     6435                                             , input ?
     6436                                             ).
     6437       end.
     6438       when "cli"
     6439       or
     6440       WHEN "cli-grp" then do:
     6441         if rs-list-method = "cli-grp" then do:
     6442           glog = yes.
     6443           message "1 или несколько групп клиентов"
     6444           skip stat-line(rs-status)
     6445           view-as alert-box question buttons OK-Cancel update glog.
     6446           if not glog then do:
     6447             run MyEnable in this-procedure .
     6448             return error.
     6449           end.
     6450           GRP-list = "".
     6451           ref-list = "".
     6452           run ref/cli-grps.w ( input parparentproc
     6453                              , input "b-sel,b-mark"
     6454                              , input-output grp-list).
     6455         end.
     6456         else do:
     6457           glog = yes.
     6458           message "1 или несколько произвольных клиентов из справочника."
     6459           skip stat-line(rs-status)
     6460           view-as alert-box question buttons OK-Cancel update glog.
     6461           if not glog then do:
     6462             run MyEnable in this-procedure .
     6463             return error.
     6464           end.
     6465           run ref/cli-all.w ( input parparentproc
     6466                           , input "b-sel,b-mark,b-add"
     6467                           , input ?
     6468                           , input ?
     6469                           , input ?
     6470                           , input ?
     6471                           , input ?
     6472                           , input ?
     6473                           , output ref-list).
     6474           grp-list = ?.
     6475         end.
     6476         if grp-list <> ? and
     6477         grp-list <> "" then do:
     6478           v-recs = num-entries (grp-list).
     6479           do num-rec = 0 to v-recs:
     6480             if v-recs = 1 then do:
     6481               num-rec = 1 .
     6482             end.
     6483             if num-rec > 0 then do:
     6484               v-grp-rec = integer (entry (num-rec, grp-list)).
     6485               find ub.cli-grp where recid (ub.cli-grp) = v-grp-rec no-lock.
     6486               run cli-grplib-get-full-name in this-procedure ( input ub.cli-grp.node-code, output grp-path).
     6487             end.
     6488             if v-recs = 1 then do:
     6489               assign
     6490               v-temp-seq = v-seq
     6491               v-line     = 0
     6492               dsp-rs = substitute("Группа клиентов &1 &2", grp-path, stat-line(rs-status))
     6493               v-item     = '':U
     6494               v-tbl-name = 'cli-grp':U
     6495               v-bh       = buffer cli-grp:handle
     6496               v-tot-lns = tot-lns
     6497               .
     6498             end.
     6499             else do:
     6500               if num-rec = 0 then do:
     6501                 assign
     6502                 v-temp-seq = v-seq
     6503                 v-line     = 0
     6504                 dsp-rs = substitute("Группы клиентов: &1", stat-line(rs-status))
     6505                 v-item     = '':U
     6506                 v-tbl-name = '':U
     6507                 v-bh       = ?
     6508                 v-tot-lns = tot-lns
     6509                 .
     6510               end.
     6511               else do:
     6512                 assign
     6513                 v-temp-seq = v-seq - 1
     6514                 v-line     = num-rec
     6515                 dsp-rs = substitute("&1", grp-path)
     6516                 v-item     = '':U
     6517                 v-tbl-name = 'cli-grp':U
     6518                 v-bh       = buffer cli-grp:handle
     6519                 v-tot-lns = tot-lns + num-rec
     6520                 .
     6521               end.
     6522             end.
     6523             v-no-hist = (if num-rec = 1 then 0 else num-rec).
     6524             run create-cli-list-hist in this-procedure (
     6525                                                   input 'ДОБАВЛЕНИЕ':U
     6526                                                 , input-output v-temp-seq
     6527                                                 , input v-line
     6528                                                 , input '':U
     6529                                                 , input dsp-rs
     6530                                                 , input v-tot-lns
     6531                                                 , input rs-list-method
     6532                                                 , input rs-status
     6533                                                 , input v-item
     6534                                                 , input v-tbl-name
     6535                                                 , input v-bh
     6536                                                 ).
     6537             if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     6538           end.
     6539         end.
     6540         else if ref-list <> "" and  ref-list <> ? then do:
     6541           v-recs = num-entries (ref-list) .
     6542           do num-rec = 0 to v-recs:
     6543             if v-recs = 1 then do:
     6544               num-rec = 1 .
     6545             end.
     6546             if num-rec > 0 then do:
     6547               v-ref-rec = integer (entry (num-rec, ref-list)).
     6548               find ub.clients where recid (ub.clients) = v-ref-rec no-lock.
     6549             end.
     6550             if v-recs = 1 then do:
     6551               assign
     6552               v-temp-seq = v-seq
     6553               v-line     = 0
     6554               dsp-rs = substitute("Клиент :&1 &2", ub.clients.obj-name, stat-line(rs-status))
     6555               v-item     = '':U
     6556               v-tbl-name = 'clients':U
     6557               v-bh       = buffer ub.clients:handle
     6558               v-tot-lns = tot-lns
     6559               .
     6560             end.
     6561             else do:
     6562               if num-rec = 0 then do:
     6563                 assign
     6564                 v-temp-seq = v-seq
     6565                 v-line     = 0
     6566                 dsp-rs = substitute("Клиент : &1", stat-line(rs-status))
     6567                 v-item     = '':U
     6568                 v-tbl-name = '':U
     6569                 v-bh       = ?
     6570                 v-tot-lns = tot-lns
     6571                 .
     6572               end.
     6573               else do:
     6574                 assign
     6575                 v-temp-seq = v-seq - 1
     6576                 v-line     = num-rec
     6577                 dsp-rs = substitute("&1", clients.obj-name)
     6578                 v-item     = '':U
     6579                 v-tbl-name = 'clients':U
     6580                 v-bh       = buffer clients:handle
     6581                 v-tot-lns = tot-lns + num-rec
     6582                 .
     6583               end.
     6584             end.
     6585             v-no-hist = (if num-rec = 1 then 0 else num-rec).
     6586             run create-cli-list-hist in this-procedure (
     6587                                                   input 'ДОБАВЛЕНИЕ':U
     6588                                                 , input-output v-temp-seq
     6589                                                 , input v-line
     6590                                                 , input '':U
     6591                                                 , input dsp-rs
     6592                                                 , input v-tot-lns
     6593                                                 , input rs-list-method
     6594                                                 , input rs-status
     6595                                                 , input v-item
     6596                                                 , input v-tbl-name
     6597                                                 , input v-bh
     6598                                                 ).
     6599             if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     6600           end.
