     6923         run str/all-docs.w (input parparentproc
     6924                       ,input (if v-docs-all
     6925                               then ?
     6926                               else v-cntxt-host-code-obj)
     6927                       ,input (if v-docs-all
     6928                               then ?
     6929                               else v-cntxt-obj-type)
     6930                       ,input (if v-docs-all
     6931                               then ?
     6932                               else v-cntxt-obj-code)
     6933                       ,input (if v-docs-all
     6934                               then 'работа':U
     6935                               else (if v-docs-cmp
     6936                                     then 'фирма':U
     6937                                     else 'объект':U)
     6938                               )
     6939                        ,input ?
     6940                        ,input ?
     6941                        ,input ?
     6942                        ,input ?
     6943                        ,input "b-sel,b-mark"
     6944                        ,input ?
     6945                        ,input ?
     6946                        ,input ?
     6947                        ,output ref-list).
     6948         if ref-list = "" then do:
     6949           run MyEnable in this-procedure .
     6950           return error.
     6951         end.
     6952         v-recs = num-entries(ref-list).
     6953         do num-rec = 0 to v-recs:
     6954           if v-recs = 1 then do:
     6955             num-rec = 1 .
     6956           end.
     6957           if num-rec > 0 then do:
     6958             v-ref-rec = integer (entry (num-rec, ref-list)).
     6959             find ub.trn-doc where recid (ub.trn-doc) = v-ref-rec no-lock.
     6960           end.
     6961           if v-recs = 1 then do:
     6962             assign
     6963             v-temp-seq = v-seq
     6964             v-line     = 0
     6965             dsp-rs = substitute("Контрагенты по документу : &1 &2 &3 &4 № &5 от &6 &7"
     6966                                 , ub.trn-doc.doc-type
     6967                                 , ub.trn-doc.status_
     6968                                 , ub.trn-doc.obj-type
     6969                                 , ub.trn-doc.obj-code
     6970                                 , ub.trn-doc.doc-code
     6971                                 , string (ub.trn-doc.doc-date, '99/99/9999')
     6972                                 , stat-line(rs-status)
     6973                                 )
     6974             v-item     = '':U
     6975             v-tbl-name = 'trn-doc':U
     6976             v-bh       = buffer ub.trn-doc:handle
     6977             v-tot-lns = tot-lns
     6978             .
     6979           end.
     6980           else do:
     6981             if num-rec = 0 then do:
     6982               assign
     6983               v-temp-seq = v-seq
     6984               v-line     = 0
     6985               dsp-rs = substitute("Контрагенты по документам : &1", stat-line(rs-status))
     6986               v-item     = '':U
     6987               v-tbl-name = '':U
     6988               v-bh       = ?
     6989               v-tot-lns = tot-lns
     6990               .
     6991             end.
     6992             else do:
     6993               assign
     6994               v-temp-seq = v-seq - 1
     6995               v-line     = num-rec
     6996               dsp-rs = substitute("&1 &2 &3 &4 № &5 от &6"
     6997                                   , ub.trn-doc.doc-type
     6998                                   , ub.trn-doc.status_
     6999                                   , ub.trn-doc.obj-type
     7000                                   , ub.trn-doc.obj-code
     7001                                   , ub.trn-doc.doc-code
     7002                                   , string (ub.trn-doc.doc-date, '99/99/9999')
     7003                                   )
     7004               v-item     = '':U
     7005               v-tbl-name = 'trn-doc':U
     7006               v-bh       = buffer ub.trn-doc:handle
     7007               v-tot-lns = tot-lns + num-rec
     7008               .
     7009             end.
     7010           end.
     7011           v-no-hist = (if num-rec = 1 then 0 else num-rec).
     7012           run create-cli-list-hist in this-procedure (
     7013                                                 input 'ДОБАВЛЕНИЕ':U
