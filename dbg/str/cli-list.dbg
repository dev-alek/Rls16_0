     1613   procedure create_obj-list :
     1614      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1615      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1616      do
     1617      on error undo, return error return-value
     1618      :
     1619         define buffer cli-obj for ub.clients .
     1620         define variable p-var as integer no-undo .
     1621         define buffer buf_obj-list for obj-list .
     1622         find last buf_obj-list  use-index pi no-error .
     1623         if available buf_obj-list
     1624         then
     1625            p-var = buf_obj-list.obj-id + 1.
     1626         else
     1627            p-var = 1.
     1628         find first cli-obj where
     1629                   cli-obj.obj-type = p-obj-type
     1630               and cli-obj.obj-code = p-obj-code
     1631         no-lock no-error.
     1632         if available cli-obj
     1633         then do:
     1634            create buf_obj-list.
     1635            assign
     1636               buf_obj-list.obj-id   = p-var
     1637               buf_obj-list.obj-code = cli-obj.obj-code
     1638               buf_obj-list.obj-type = cli-obj.obj-type
     1639               buf_obj-list.obj-name = cli-obj.obj-name
     1640               buf_obj-list.db-num   = cli-obj.db-num
     1641            .
     1642         end.
     1643      end.
     1644   end.
