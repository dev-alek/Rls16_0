        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        3   define input parameter p-obj-type       like ub.clients.obj-type no-undo .
        4   define input parameter p-obj-code       like ub.clients.obj-code no-undo .
        5   define new global shared variable g#language as character no-undo .
        6   if g#language <> '' and g#language <> 'rus':U then do:
        7     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        8   end.
        9   define new global shared variable g#library  as handle no-undo .
       10   define new global shared variable g#library2 as handle no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Автоматизированное формирование списка клиентов".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   def SHARED temp-table cli-list no-undo like ub.clients
      118     field to-del as logical
      119     index obj  is primary unique obj-type obj-code
      120     index cli-name      obj-name
      121     .
      122   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define  SHARED  temp-table cli-list-hist no-undo
      124   field list-table as character
      125   field id as integer
      126   field line as integer
      127   field hist-mode as character
      128   field des as character
      129   field num-recs as integer
      130   field option_ as character
      131   field item_ as character
      132   field status_ as character
      133   field num-add as integer
      134   field num-ignored as integer
      135   field done as logical
      136   field err_ as logical
      137   field err-mes as character
      138   index pi is primary
      139   id
      140   line
      141   index isdone
      142   done
      143   .
      144   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145     define variable v-cntxt-db-num        as integer   no-undo .
      146     define variable v-cntxt-userid        as character no-undo .
      147     define variable v-cntxt-level         as character no-undo .
      148     define variable v-cntxt-host-code-obj as integer   no-undo .
      149     define variable v-cntxt-obj-type      as character no-undo .
      150     define variable v-cntxt-obj-code      as integer   no-undo .
      151     define variable v-cntxt-db-num-obj    as integer   no-undo .
      152     define variable v-cntxt-is-admin      as logical   no-undo .
      153   define variable g#report-num as integer no-undo .
      154   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      156   procedure gen-key-rec :
      157     define input  parameter p-tbl-name    as character no-undo.
      158     define input  parameter p-bh_tbl-name as handle    no-undo.
      159     define output parameter p-key-rec     as character no-undo.
      160     do
      161     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      162     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      163     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      164     :
      165       define variable fh               as handle    no-undo .
      166       define variable v-ok             as logical   no-undo .
      167       define variable v-inform         as character no-undo .
      168       define variable v-ind            as integer   no-undo .
      169       define variable v-idx-field-qnty as integer   no-undo .
      170       if p-tbl-name = ?
      171         or p-tbl-name = "":U
      172       then do:
      173         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      174       end.
      175       if not p-bh_tbl-name:available then do:
      176         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      177       end.
      178       assign
      179         p-key-rec = p-tbl-name
      180         v-inform  = p-bh_tbl-name:index-information(1)
      181         v-ind     = 2
      182       .
      183       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      184       on error undo, return error
      185       :
      186         assign
      187           v-inform = p-bh_tbl-name:index-information( v-ind )
      188           v-ind    = v-ind + 1
      189         .
      190       end.
      191       if v-inform = ?
      192         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      193         or entry( 3, v-inform, ",":U ) <> "1":U
      194       then do:
      195         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      196       end.
      197       else do:
      198         assign
      199           v-idx-field-qnty = num-entries( v-inform ) - 4
      200         .
      201         if v-idx-field-qnty < 2 then do:
      202           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      203         end.
      204         do v-ind = 1 to v-idx-field-qnty by 2
      205         on error undo, return error
      206         :
      207           assign
      208             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      209             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      210           .
      211         end.
      212       end.
      213       if p-key-rec = ? then do:
      214         assign
      215           p-key-rec = "":U
      216         .
      217         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      218       end.
      219     end.
      220     return.
      221   end procedure.
      222   procedure gen-where-keyr-tab :
      223     define input  parameter i-tableSerach as character no-undo.
      224     define input  parameter i-tablekey   as character  no-undo.
      225     define input  parameter p-key-rec    as character  no-undo.
      226     define input  parameter p-key-handle as handle     no-undo .
      227     define input  parameter p-db-name    as character  no-undo .
      228     define input  parameter p-tt-handle  as handle     no-undo .
      229     define output parameter o-Where      as character  no-undo.
      230     do
      231     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      232     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      233     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      234     :
      235       define variable v-full-tbl-name  as character no-undo .
      236       define variable bh_tbl-name      as handle    no-undo .
      237       define variable fh_key           as handle    no-undo .
      238       define variable fh_search        as handle    no-undo .
      239       define variable v-field-num      as integer   no-undo .
      240       define variable v-count-fld      as integer   no-undo .
      241       define variable v-inform         as character no-undo .
      242       define variable v-ind            as integer   no-undo .
      243       define variable v-idx-field-qnty as integer   no-undo .
      244       define variable v-field-name     as character no-undo .
      245       define variable v-field-val      as character no-undo .
      246       define variable v-word-link      as character no-undo .
      247       define variable vTable           as character no-undo.
      248       define variable bh_tbl-key       as handle    no-undo .
      249       assign
      250         p-key-rec = trim( p-key-rec )
      251       .
      252       if p-key-handle <> ? then do:
      253         if not valid-handle(p-key-handle)
      254            or p-key-handle:type <> "buffer"
      255         then do:
      256           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      257         end.
      258         if num-entries( p-key-rec, chr(3) ) > 1
      259           or p-key-rec = ?
      260           or p-key-rec = "":U
      261         then do:
      262           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      263         end.
      264       end.
      265       else do:
      266         if p-key-rec = ?
      267           or p-key-rec = "":U
      268         then do:
      269           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      270         end.
      271       end.
      272       assign
      273         vTable = entry( 1 , p-key-rec, chr(3) )
      274       .
      275       if p-tt-handle <> ?
      276         and ( not valid-handle(p-tt-handle)
      277               or p-tt-handle:type <> "buffer"
      278             )
      279       then do:
      280         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      281       end.
      282       if p-tt-handle = ? then do:
      283         assign
      284           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      285         .
      286         create buffer bh_tbl-name for table v-full-tbl-name .
      287       end.
      288       else do:
      289         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      290       end.
      291       assign
      292         v-inform = bh_tbl-name:index-information(1)
      293         v-ind    = 2
      294       .
      295       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      296       on error undo, return error
      297       :
      298         assign
      299           v-inform = bh_tbl-name:index-information( v-ind )
      300           v-ind    = v-ind + 1
      301         .
      302       end.
      303       if v-inform = ?
      304         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      305         or entry( 3, v-inform, ",":U ) <> "1":U
      306       then do:
      307         delete object bh_tbl-name no-error.
      308         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      309       end.
      310       assign
      311         v-idx-field-qnty = num-entries( v-inform ) - 4
      312       .
      313       if v-idx-field-qnty < 2 then do:
      314         delete object bh_tbl-name no-error.
      315         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      316       end.
      317       assign
      318         o-where     = "where":U
      319         v-word-link = "":U
      320         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      321         v-count-fld = 0
      322       .
      323       if i-tablekey ne "" and i-tablekey ne ?
      324       then do:
      325         assign
      326           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      327         .
      328         create buffer bh_tbl-key for table v-full-tbl-name .
      329       end.
      330       if i-tableSerach ne "" and i-tableSerach ne ?
      331       then do:
      332         delete object bh_tbl-name no-error.
      333         assign
      334           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      335         .
      336         create buffer bh_tbl-name for table v-full-tbl-name .
      337       end.
      338       block_where:
      339       do v-ind = 1 to v-idx-field-qnty by 2
      340       on error undo, return error
      341       :
      342         assign
      343           v-count-fld = v-count-fld + 1
      344         .
      345         if p-key-handle = ?
      346           and v-count-fld > v-field-num
      347         then do:
      348           leave block_where.
      349         end.
      350         define variable VfieldKeyTable as handle no-undo.
      351         assign
      352           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      353           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      354         .
      355         if     bh_tbl-key ne ?
      356         then do:
      357            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      358            if VfieldKeyTable eq ?
      359            then next block_where.
      360         end.
      361         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      362         then
      363            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      364         else
      365            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      366         if p-key-handle = ? then do:
      367           assign
      368             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      369           .
      370         end.
      371         else do:
      372           assign
      373             fh_key = p-key-handle:buffer-field( v-field-name )
      374           .
      375           if fh_key = ?
      376             or not valid-handle( fh_key )
      377           then do:
      378             delete object bh_tbl-name.
      379             if     bh_tbl-key ne ?
      380             then
      381                delete object bh_tbl-key.
      382             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      383           end.
      384           assign
      385             v-field-val = fh_key:buffer-value
      386           .
      387         end.
      388         if fh_search:data-type ="character":U then do:
      389           assign
      390             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      391             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      392             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      393             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      394             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      395             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      396             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      397             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      398             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      399             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      400             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      401             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      402             v-field-val = substitute( '"&1"', v-field-val )
      403           .
      404         end.
      405         assign
      406           o-where = substitute( "&1 &2", o-where, v-field-val )
      407         .
      408         if v-word-link = "":U then do:
      409           assign
      410             v-word-link = "and":U
      411           .
      412         end.
      413       end.
      414       delete object bh_tbl-name.
      415       if     bh_tbl-key ne ?
      416       then
      417          delete object bh_tbl-key.
      418       if p-key-handle = ?
      419         and v-count-fld <> v-field-num
      420       then do:
      421         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      422       end.
      423     end.
      424   end procedure.
      425   procedure gen-hn-keyr-tab :
      426     define input  parameter i-tableSerach as character no-undo.
      427     define input  parameter i-tablekey   as character no-undo.
      428     define input  parameter p-key-rec    as character no-undo.
      429     define input  parameter p-key-handle as handle    no-undo .
      430     define input  parameter p-db-name    as character no-undo .
      431     define input  parameter p-tt-handle  as handle    no-undo .
      432     define input  parameter p-stts-lock  as integer   no-undo .
      433     define output parameter o-hn         as handle    no-undo.
      434     define variable v-full-tbl-name as character no-undo.
      435     define variable v-where         as character no-undo.
      436     define variable bh_tbl-name     as handle    no-undo.
      437     define variable vTable          as character no-undo.
      438     do
      439     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      440     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      441     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      442         run gen-where-keyr-tab(i-tableSerach,
      443                                i-tablekey,
      444                                p-key-rec,
      445                                p-key-handle,
      446                                p-db-name,
      447                                p-tt-handle,
      448                                output v-where).
      449         if i-tableSerach ne "" and i-tableSerach ne ?
      450         then do:
      451            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      452            create buffer bh_tbl-name for table v-full-tbl-name .
      453         end.
      454         else do:
      455            if p-tt-handle = ? then do:
      456               assign
      457                  vTable = entry( 1 , p-key-rec, chr(3) )
      458               .
      459               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      460               create buffer bh_tbl-name for table v-full-tbl-name .
      461            end.
      462            else do:
      463               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      464            end.
      465         end.
      466         if p-tt-handle = ? then do:
      467            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      468         end.
      469         else do:
      470            bh_tbl-name:find-first( v-where ) no-error .
      471         end.
      472         o-hn = bh_tbl-name.
      473      end.
      474   end procedure.
      475   procedure gen-hn-keyr :
      476     define input  parameter p-key-rec    as character no-undo.
      477     define input  parameter p-key-handle as handle    no-undo .
      478     define input  parameter p-db-name    as character no-undo .
      479     define input  parameter p-tt-handle  as handle    no-undo .
      480     define input  parameter p-stts-lock  as integer   no-undo .
      481     define output parameter o-hn         as handle    no-undo.
      482     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      483   end.
      484   procedure gen-row-keyr :
      485     define input  parameter p-key-rec    as character no-undo.
      486     define input  parameter p-key-handle as handle    no-undo .
      487     define input  parameter p-db-name    as character no-undo .
      488     define input  parameter p-tt-handle  as handle    no-undo .
      489     define input  parameter p-stts-lock  as integer   no-undo .
      490     define output parameter p-tbl-row    as rowid     no-undo.
      491     define output parameter p-tbl-name   as character no-undo.
      492     define variable vHn as handle no-undo.
      493       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      494       p-tbl-row = if vHn:available then vHn:rowid else ?.
      495       p-tbl-name =  vHn:table.
      496       delete object vHn no-error.
      497     if p-tbl-row = ? then do:
      498       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      499     end.
      500     else do:
      501       return.
      502     end.
      503   end procedure.
      504   procedure gen-key-fv :
      505     define input  parameter p-key-rec    as character no-undo .
      506     define output parameter p-field-list as character no-undo .
      507     define output parameter p-value-list as character no-undo.
      508     do
      509     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      510     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      511     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      512     :
      513       define variable v-full-tbl-name  as character no-undo .
      514       define variable bh_tbl-name      as handle    no-undo .
      515       define variable v-tbl-name       as character no-undo .
      516       define variable v-field-num      as integer   no-undo .
      517       define variable v-count-fld      as integer   no-undo .
      518       define variable v-inform         as character no-undo .
      519       define variable v-ind            as integer   no-undo .
      520       define variable v-idx-field-qnty as integer   no-undo .
      521       define variable v-delim-key      as character no-undo .
      522       if p-key-rec = ?
      523         or p-key-rec = "":U
      524       then do:
      525         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      526       end.
      527       assign
      528         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      529         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      530       .
      531       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      532       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      533       assign
      534         v-inform = bh_tbl-name:index-information(1)
      535         v-ind    = 2
      536       .
      537       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      538       on error undo, return error
      539       :
      540         assign
      541           v-inform = bh_tbl-name:index-information( v-ind )
      542           v-ind    = v-ind + 1
      543         .
      544       end.
      545       if v-inform = ?
      546         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      547         or entry( 3, v-inform, ",":U ) <> "1":U
      548       then do:
      549         delete object bh_tbl-name no-error.
      550         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      551       end.
      552       assign
      553         v-idx-field-qnty = num-entries( v-inform ) - 4
      554       .
      555       if v-idx-field-qnty < 2 then do:
      556         delete object bh_tbl-name no-error.
      557         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      558       end.
      559       assign
      560         p-field-list = "":U
      561         p-value-list = "":U
      562         v-delim-key  = "":U
      563         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      564         v-count-fld  = 0
      565       .
      566       block_where:
      567       do v-ind = 1 to v-idx-field-qnty by 2
      568       on error undo, return error
      569       :
      570         assign
      571           v-count-fld = v-count-fld + 1
      572         .
      573         if v-count-fld > v-field-num then do:
      574           leave block_where.
      575         end.
      576         assign
      577           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      578           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      579         .
      580         if v-ind = 1 then do:
      581           assign
      582             v-delim-key = chr(3)
      583           .
      584         end.
      585       end.
      586       delete object bh_tbl-name.
      587       if v-count-fld <> v-field-num then do:
      588         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      589       end.
      590     end.
      591   end procedure.
      592   procedure gen-key-field :
      593     define input  parameter p-table      as character no-undo .
      594     define output parameter p-field-list as character no-undo .
      595     do
      596     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      597     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      598     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      599     :
      600       define variable v-full-tbl-name  as character no-undo .
      601       define variable bh_tbl-name      as handle    no-undo .
      602       define variable v-tbl-name       as character no-undo .
      603       define variable v-field-num      as integer   no-undo .
      604       define variable v-count-fld      as integer   no-undo .
      605       define variable v-inform         as character no-undo .
      606       define variable v-ind            as integer   no-undo .
      607       define variable v-idx-field-qnty as integer   no-undo .
      608       define variable v-delim-key      as character no-undo .
      609       if p-table = ?
      610         or p-table = "":U
      611       then do:
      612         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      613       end.
      614       assign
      615         v-tbl-name      = p-table
      616         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      617       .
      618       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      619       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      620       assign
      621         v-inform = bh_tbl-name:index-information(1)
      622         v-ind    = 2
      623       .
      624       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      625       on error undo, return error
      626       :
      627         assign
      628           v-inform = bh_tbl-name:index-information( v-ind )
      629           v-ind    = v-ind + 1
      630         .
      631       end.
      632       if v-inform = ?
      633         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      634         or entry( 3, v-inform, ",":U ) <> "1":U
      635       then do:
      636         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      637       end.
      638       assign
      639         v-idx-field-qnty = num-entries( v-inform ) - 4
      640       .
      641       if v-idx-field-qnty < 2 then do:
      642         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      643       end.
      644       assign
      645         p-field-list = "":U
      646         v-delim-key  = "":U
      647         v-count-fld  = 0
      648       .
      649       block_where:
      650       do v-ind = 1 to v-idx-field-qnty by 2
      651       on error undo, return error
      652       :
      653         assign
      654           v-count-fld = v-count-fld + 1
      655         .
      656         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      657         if v-ind = 1 then do:
      658           assign
      659             v-delim-key = chr(3)
      660           .
      661         end.
      662       end.
      663       delete object bh_tbl-name.
      664     end.
      665   end procedure.
      666   procedure create-cli-list-hist :
      667   define input parameter p-mode as character no-undo .
      668   define input-output parameter p-seq as integer no-undo .
      669   define input parameter p-line as integer no-undo .
      670   define variable p-list-table as character no-undo .
      671   define input parameter p-hist-mode as character no-undo .
      672   define input parameter p-des as character no-undo .
      673   define input parameter p-num-recs as integer no-undo .
      674   define input parameter p-option as character no-undo .
      675   define input parameter p-status_ as character no-undo .
      676   define input parameter p-item as character no-undo .
      677   define input parameter p-tbl-name as character no-undo .
      678   define input parameter p-bh_tbl-name as handle no-undo .
      679   define variable v-num-add as integer no-undo .
      680   define variable v-num-ignored as integer no-undo .
      681   define buffer buf_cli-list-hist for cli-list-hist.
      682     do
      683     on error undo, return error
      684     :
      685       CASE p-mode:
      686         when 'title' then do:
      687           find first buf_cli-list-hist where
      688                      buf_cli-list-hist.id = 0   no-error.
      689           if not available buf_cli-list-hist then do:
      690             create buf_cli-list-hist.
      691             assign
      692             buf_cli-list-hist.id = 0
      693             buf_cli-list-hist.line = 0
      694             buf_cli-list-hist.list-table = '':U
      695             .
      696           end.
      697           assign
      698           buf_cli-list-hist.des =  p-des
      699           buf_cli-list-hist.num-recs = p-num-recs
      700           buf_cli-list-hist.option_  = p-option
      701           buf_cli-list-hist.item_ = p-item
      702           .
      703         end.
      704         when 'ДОБАВЛЕНИЕ':U then do:
      705           if p-option begins 'single' then do:
      706             CASE p-hist-mode:
      707               when '+':U then do:
      708                 assign
      709                 v-num-add = 1
      710                 v-num-ignored  = 0
      711                 .
      712               end.
      713               when '-':U then do:
      714                 assign
      715                 v-num-add = 1
      716                 v-num-ignored  = 0
      717                 .
      718               end.
      719               when '*':U then do:
      720                 assign
      721                 v-num-add = p-num-recs - 1
      722                 p-num-recs = 1
      723                 v-num-ignored  = 0
      724                 .
      725               end.
      726             END CASE.
      727           end.
      728           create buf_cli-list-hist.
      729           assign
      730           buf_cli-list-hist.id = p-seq
      731           buf_cli-list-hist.list-table = p-list-table
      732            p-seq = (if p-line = 0 then (p-seq + 1) else p-seq)
      733           buf_cli-list-hist.des =  p-des
      734           buf_cli-list-hist.line = p-line
      735           buf_cli-list-hist.num-recs = p-num-recs
      736           buf_cli-list-hist.option_  = p-option
      737           buf_cli-list-hist.item_ = p-item
      738           buf_cli-list-hist.hist-mode =  p-hist-mode
      739           buf_cli-list-hist.status_ =  p-status_
      740           buf_cli-list-hist.num-add = v-num-add
      741           buf_cli-list-hist.num-ignored = v-num-ignored
      742           .
      743         end.
      744         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'des' then do:
      745           find first buf_cli-list-hist where
      746                     buf_cli-list-hist.id = p-seq
      747                 and buf_cli-list-hist.line = p-line no-error .
      748           if  available buf_cli-list-hist then do:
      749             assign
      750             buf_cli-list-hist.des =  p-des
      751             buf_cli-list-hist.num-recs = p-num-recs
      752             buf_cli-list-hist.option_  = p-option
      753             buf_cli-list-hist.item_ = p-item
      754             buf_cli-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      755                                        then p-list-table
      756                                        else buf_cli-list-hist.list-table)
      757             .
      758           end.
      759         end.
      760         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'mode' then do:
      761           find first buf_cli-list-hist where
      762                     buf_cli-list-hist.id = p-seq
      763                 and buf_cli-list-hist.line = p-line  no-error .
      764           if available buf_cli-list-hist then do:
      765             assign
      766             buf_cli-list-hist.hist-mode =  p-hist-mode
      767             buf_cli-list-hist.num-recs  = (if buf_cli-list-hist.line = 0 then p-num-recs else buf_cli-list-hist.num-recs)
      768             buf_cli-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      769                                        then p-list-table
      770                                        else buf_cli-list-hist.list-table)
      771             .
      772           end.
      773         end.
      774       END CASE.
      775       if p-tbl-name <> "":U
      776       and valid-handle(p-bh_tbl-name)
      777       then do:
      778         run gen-key-rec  in this-procedure (
      779                                               input  p-tbl-name
      780                                              ,input  p-bh_tbl-name
      781                                              ,output p-item) no-error .
      782         if not error-status:error then do:
      783           assign
      784           buf_cli-list-hist.item_ = p-item
      785           .
      786         end.
      787         else do:
      788           assign
      789           buf_cli-list-hist.item_ = "!ERROR"
      790           .
      791         end.
      792       end.
      793     end.
      794   end procedure.
      795   FUNCTION get-line-mode returns character(input p-hist-mode as character):
      796   case p-hist-mode:
      797     when '+':U then
      798       return  'ДОБАВЛЕНИЕ':U.
      799     when '-':U then
      800       return  'удаление':U.
      801     when '*':U then
      802       return  'ОСТАВИТЬ':U.
      803   end CASE.
      804   END FUNCTION.
      805   FUNCTION get-hist-mode returns character(input p-line-mode as character):
      806   case p-line-mode:
      807     when 'ДОБАВЛЕНИЕ':U then
      808       return  "+".
      809     when 'удаление':U then
      810       return  "-".
      811     when 'ОСТАВИТЬ':U then
      812       return  "*".
      813   end CASE.
      814   END FUNCTION.
      815   procedure proc-write-filter-expression :
      816   define input parameter p-filter-expression as character no-undo .
      817   define variable v-ii as integer no-undo .
      818   output to value(string(g#report-num) + ".whr").
      819   put .
      820   if num-entries(p-filter-expression) > 0 then do:
      821      put unformatted 'and ('.
      822      do v-ii = 1 to num-entries(p-filter-expression):
      823        put unformatted entry(v-ii, p-filter-expression) skip.
      824      end.
      825      put unformatted ')'.
      826   end.
      827   output close.
      828   end procedure.
      829   procedure proc-write-filter-expression-var :
      830   define input parameter p-filter-expression as character no-undo .
      831   define output parameter p-string as character no-undo .
      832   define variable v-ii as integer no-undo .
      833   if num-entries(p-filter-expression) > 0 then do:
      834      p-string = 'and ('.
      835      do v-ii = 1 to num-entries(p-filter-expression):
      836        p-string = p-string + entry(v-ii, p-filter-expression) + chr(10).
      837      end.
      838      p-string = p-string + ')'.
      839   end.
      840   end procedure.
      841   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      842   define variable c-point  as character no-undo .
      843   define variable tbl      as character no-undo .
      844   define variable join-tbl as character no-undo .
      845   define variable fld      as character no-undo .
      846   define variable lab      as character no-undo .
      847   define variable spr      as character no-undo .
      848   define variable dim      as character no-undo .
      849   function diff-list returns character (
      850     input parfirst-list  as character,
      851     input parsecond-list as character,
      852     input pardelim       as character).
      853     if pardelim = ""
      854     or pardelim = ?
      855     then do:
      856       assign
      857         pardelim = ","
      858       .
      859     end.
      860     def var ind as integer no-undo .
      861     def var v-elem as character no-undo .
      862     def var v-result-list as character no-undo init "".
      863     def var v-num-parfirst-list as integer no-undo .
      864     assign
      865       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      866     .
      867     do ind = 1 to v-num-parfirst-list
      868     :
      869       assign
      870         v-elem = entry(ind, parfirst-list, pardelim)
      871       .
      872       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      873         assign
      874           v-result-list = v-result-list
      875                         + (if v-result-list > "" then pardelim else "")
      876                         + v-elem
      877         .
      878       end.
      879     end.
      880     return v-result-list .
      881   end function.
      882   function add-list returns character (
      883    input parfirst-list  as character,
      884    input parsecond-list as character,
      885    input pardelim       as character).
      886     if pardelim = ""
      887     or pardelim = ?
      888     then do:
      889       assign
      890         pardelim = ","
      891       .
      892     end.
      893     def var ind as integer no-undo .
      894     def var v-elem as character no-undo .
      895     def var v-result-list as character no-undo init "".
      896     def var v-num-parfirst-list as integer no-undo .
      897     assign
      898       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      899     .
      900     do ind = 1 to v-num-parfirst-list
      901     :
      902       assign
      903         v-elem = entry(ind, parfirst-list, pardelim)
      904       .
      905       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      906         assign
      907           v-result-list = v-result-list
      908                         + (if v-result-list > "" then pardelim else "")
      909                         + v-elem
      910         .
      911       end.
      912     end.
      913     def var v-num-parsecond-list as integer no-undo .
      914     assign
      915       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      916     .
      917     do ind = 1 to v-num-parsecond-list
      918     :
      919       assign
      920         v-elem = entry(ind, parsecond-list, pardelim)
      921       .
      922       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      923         assign
      924           v-result-list = v-result-list
      925                         + (if v-result-list > "" then pardelim else "")
      926                         + v-elem
      927         .
      928       end.
      929     end.
      930     return v-result-list .
      931   end function.
      932   function cross-list returns character (
      933    input parfirst-list  as character,
      934    input parsecond-list as character,
      935    input pardelim       as character).
      936     if pardelim = ""
      937     or pardelim = ?
      938     then do:
      939       assign
      940         pardelim = ","
      941       .
      942     end.
      943     def var ind as integer no-undo .
      944     def var v-elem as character no-undo .
      945     def var v-result-list as character no-undo init "".
      946     def var v-num-parfirst-list as integer no-undo .
      947     assign
      948       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      949     .
      950     do ind = 1 to v-num-parfirst-list
      951     :
      952       assign
      953         v-elem = entry(ind, parfirst-list, pardelim)
      954       .
      955       if lookup(v-elem, v-result-list, pardelim) = 0
      956       and lookup(v-elem, parsecond-list, pardelim) > 0
      957       then do:
      958         assign
      959           v-result-list = v-result-list
      960                         + (if v-result-list > "" then pardelim else "")
      961                         + v-elem
      962         .
      963       end.
      964     end.
      965     return v-result-list .
      966   end function.
      967   function radio-label returns character (
      968    input par-rs-value  as character,
      969    input par-rs-radio-buttons as character)
      970    .
      971    DEFINE variable v-result-label as character no-undo.
      972    assign
      973    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      974                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      975                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      976                             ), par-rs-radio-buttons
      977                           )
      978    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      979    .
      980   return v-result-label.
      981   end function.
      982   function m-radio-label returns character (
      983    input par-rs-value  as character,
      984    input par-rs-radio-buttons as character,
      985    input par-delim as character
      986    )
      987    .
      988    DEFINE variable v-result-label as character no-undo.
      989    assign
      990    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      991                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      992                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      993                             ), par-rs-radio-buttons, par-delim
      994                           )
      995    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      996    .
      997   return v-result-label.
      998   end function.
      999   FUNCTION mixlist returns character
     1000   (
     1001    input parfirst-list  as character
     1002    ,input parsecond-list as character
     1003    ,input pardelim       as character
     1004    ,input pardelim-result as character ) :
     1005     if pardelim = ""
     1006     or pardelim = ?
     1007     then do:
     1008       assign
     1009         pardelim = ","
     1010       .
     1011     end.
     1012     def var ind as integer no-undo .
     1013     def var v-elem1 as character no-undo .
     1014     def var v-elem2 as character no-undo .
     1015     def var v-result-list as character no-undo init "".
     1016     do ind = 1 to num-entries(parfirst-list, pardelim)
     1017     :
     1018       assign
     1019         v-elem1 = entry(ind, parfirst-list, pardelim)
     1020         v-elem2 = entry(ind, parsecond-list, pardelim)
     1021       .
     1022         assign
     1023           v-result-list = v-result-list
     1024                         + (if v-result-list > "" then pardelim-result else "")
     1025                         + v-elem1 + pardelim-result + v-elem2
     1026         .
     1027     end.
     1028     return v-result-list .
     1029   END FUNCTION.
