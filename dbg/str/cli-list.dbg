     2053   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2054   procedure cli-grplib-get-full-name :
     2055      define input parameter  p-node-code  as integer      no-undo.
     2056      define output parameter p-full-name as character    no-undo.
     2057   do
     2058   on error undo, return error
     2059   :
     2060       define variable v-upper-code    as integer           no-undo.
     2061       define buffer buf_cli-grp       for ub.cli-grp.
     2062       define buffer buf_upper_cli-grp for ub.cli-grp.
     2063       find first buf_cli-grp no-lock
     2064            where buf_cli-grp.node-code = p-node-code
     2065       no-error.
     2066       if not available buf_cli-grp
     2067       then do:
     2068           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     2069       end.
     2070       assign
     2071           p-full-name  = ""
     2072           v-upper-code = 1
     2073       .
     2074       do while buf_cli-grp.upper-code <> 0
     2075       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2076       :
     2077           assign
     2078               p-full-name  = buf_cli-grp.node-name
     2079                            + (if p-full-name <> "" then chr(47) else "")
     2080                            + p-full-name
     2081               v-upper-code = buf_cli-grp.upper-code
     2082           .
     2083           find first buf_cli-grp no-lock
     2084                where buf_cli-grp.node-code = v-upper-code
     2085           no-error.
     2086           if not available buf_cli-grp
     2087           then do:
     2088               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     2089                                   + string( v-upper-code )
     2090                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2091           end.
     2092       end.
     2093       assign
     2094       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2095       .
     2096   end.
     2097   end .
     2098   procedure cgrplib-get-node-from-full-name :
     2099   define input parameter p-full-name as character no-undo .
     2100   define output parameter p-node-code as integer no-undo .
     2101   define variable v-ii as integer no-undo .
     2102   define variable v-upper-code as integer no-undo .
     2103   define variable v-root-code as integer no-undo .
     2104   define variable v-entry as character no-undo .
     2105   define buffer buf_cli-grp       for ub.cli-grp.
     2106   do
     2107   on error undo, return error
     2108   :
     2109     find first buf_cli-grp no-lock
     2110         where buf_cli-grp.upper-code = 0
     2111     no-error .
     2112     if not available buf_cli-grp
     2113     then do:
     2114         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     2115     end.
     2116     else do:
     2117       assign
     2118       v-root-code = buf_cli-grp.node-code
     2119       .
     2120     end.
     2121     v-upper-code = v-root-code.
     2122     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2123       assign
     2124       v-entry = entry(v-ii, p-full-name, chr(47)).
     2125       if v-entry = '' then leave.
     2126       find first buf_cli-grp no-lock where
     2127                 buf_cli-grp.node-name = v-entry
     2128             and buf_cli-grp.upper-code = v-upper-code
     2129             no-error.
     2130       if not available buf_cli-grp then do:
     2131         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2132       end.
     2133       else do:
     2134         p-node-code = buf_cli-grp.node-code.
     2135         v-upper-code = buf_cli-grp.node-code.
     2136       end.
     2137     end.
     2138   end.
     2139   end .
     2140   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2141   procedure cur-time :
     2142      define output parameter p-today as date      no-undo .
     2143      define output parameter p-time  as integer   no-undo .
     2144     do
     2145     on error undo, return error
     2146     :
     2147       define variable v-date1 as date      no-undo .
     2148       define variable v-date2 as date      no-undo .
     2149       define variable v-time  as integer   no-undo .
     2150       assign
     2151         v-date1 = today
     2152         v-time  = time
     2153         v-date2 = today
     2154       .
     2155       if v-date1 <> v-date2
     2156       then do:
     2157         assign
     2158           v-date1 = today
     2159           v-time  = v-time
     2160         .
     2161       end.
     2162       assign
     2163         p-today = v-date1
     2164         p-time  = v-time
     2165       .
     2166     end.
     2167   end.
     2168   function cur-time-date returns character
     2169   :
     2170     return string(today, '99/99/9999':U) .
     2171   end.
     2172   function cur-time-mjd returns decimal
     2173   :
     2174     define variable v-date as date      no-undo .
     2175     define variable v-time as integer   no-undo .
     2176     run cur-time in this-procedure
     2177       (output v-date
     2178       ,output v-time
     2179       ) .
     2180     return integer(v-date) - 2400002 + (v-time / 86400) .
     2181   end.
     2182   function cur-time-get-ending-index returns integer
     2183   (input p-number as integer
     2184   )
     2185   :
     2186     if p-number < 0
     2187     or p-number = ?
     2188     then do:
     2189       return 1 .
     2190     end.
     2191     define variable v-rest as integer   no-undo .
     2192     assign
     2193       p-number = p-number modulo 100
     2194     .
     2195     if p-number < 20
     2196     then do:
     2197       assign
     2198         v-rest = p-number
     2199       .
     2200     end.
     2201     else do:
     2202       assign
     2203         v-rest = p-number modulo 10
     2204       .
     2205     end.
     2206     case v-rest :
     2207       when 1
     2208       then do:
     2209         return 2 .
     2210       end.
     2211       when 2 or
     2212       when 3 or
     2213       when 4
     2214       then do:
     2215         return 3 .
     2216       end.
     2217       otherwise do:
     2218         return 1 .
     2219       end.
     2220     end case .
     2221   end.
     2222   procedure cur-time-mjd-to-date :
     2223      define input  parameter i-mjd-diff as decimal no-undo.
     2224      define output parameter o-Date     as date    no-undo.
     2225      define output parameter o-Time     as integer no-undo.
     2226      define variable v-day-number as integer   no-undo .
     2227      if    i-mjd-diff < 0
     2228         or i-mjd-diff = ?
     2229      then do:
     2230         return "?" .
     2231      end.
     2232      assign
     2233         v-day-number = truncate(i-mjd-diff,0).
     2234         o-Date = date(v-day-number + 2400002).
     2235         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2236     .
     2237   end.
     2238   function cur-time-mjd-to-string returns character
     2239   (input p-mjd-diff as decimal
     2240   )
     2241   :
     2242     define variable v-day-number as integer   no-undo .
     2243     define variable v-seconds    as integer   no-undo .
     2244     define variable v-hour       as integer   no-undo .
     2245     define variable v-min        as integer   no-undo .
     2246     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2247     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2248     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2249     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2250     if p-mjd-diff < 0
     2251     or p-mjd-diff = ?
     2252     then do:
     2253       return "?" .
     2254     end.
     2255     assign
     2256       v-day-number = integer(truncate(p-mjd-diff,0))
     2257       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2258     .
     2259     if v-seconds > 86400
     2260     then do:
     2261       assign
     2262         v-seconds = 86400 - 1
     2263       .
     2264     end.
     2265     if v-seconds < 0
     2266     then do:
     2267       assign
     2268         v-seconds = 0
     2269       .
     2270     end.
     2271     assign
     2272       v-hour = truncate(v-seconds / 3600, 0)
     2273     .
     2274     assign
     2275       v-seconds = v-seconds modulo 3600
     2276     .
     2277     assign
     2278       v-min = truncate(v-seconds / 60, 0)
     2279     .
     2280     assign
     2281       v-seconds = v-seconds modulo 60
     2282     .
     2283     return
     2284         (if v-day-number <> 0
     2285           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2286           else ""
     2287         )
     2288       + (if v-day-number <> 0 or v-hour <> 0
     2289           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2290           else ""
     2291         )
     2292       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2293           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2294           else ""
     2295         )
     2296       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2297       .
     2298   end.
     2299   function cur-time-string returns character
     2300   :
     2301     define variable v-date as date      no-undo .
     2302     define variable v-time as integer   no-undo .
     2303     run cur-time in this-procedure
     2304       (output v-date
     2305       ,output v-time
     2306       ) .
     2307     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2308   end.
     2309   function cur-time-string-sec returns character
     2310   :
     2311     define variable v-date as date      no-undo .
     2312     define variable v-time as integer   no-undo .
     2313     run cur-time in this-procedure
     2314       (output v-date
     2315       ,output v-time
     2316       ) .
     2317     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2318   end.
     2319   function cur-time-custom  returns character
     2320   (input p-prefix as character
     2321   ,input p-date-format as character
     2322   ,input p-delimiter as character
     2323   ,input p-time-format as character
     2324   ,input p-suffix as character
     2325   )
     2326   :
     2327     define variable v-date as date      no-undo .
     2328     define variable v-time as integer   no-undo .
     2329     run cur-time in this-procedure
     2330       (output v-date
     2331       ,output v-time
     2332       ) .
     2333     return
     2334       p-prefix
     2335       + string(v-date, p-date-format)
     2336       + p-delimiter
     2337       + string(v-time, p-time-format)
     2338       + p-suffix
     2339       .
     2340   end.
     2341   function cur-time-print  returns character
     2342   :
     2343     define variable v-date as date      no-undo .
     2344     define variable v-time as integer   no-undo .
     2345     run cur-time in this-procedure
     2346       (output v-date
     2347       ,output v-time
     2348       ) .
     2349     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2350   end.
     2351   function cur-time-datetime returns datetime
     2352   :
     2353     define variable v-char as character no-undo .
     2354     define variable v-datetime as datetime no-undo .
     2355     v-char = cur-time-string().
     2356     v-datetime = datetime(v-char).
     2357     return  v-datetime.
     2358   end.
     2359   function cur-time-string-msec returns character
     2360   :
     2361     define variable v-date as datetime  no-undo .
     2362     v-date = now.
     2363     return string(v-date) .
     2364   end.
     2365   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2366   define variable v-waitfram-action01         as character   no-undo .
     2367   define variable v-waitfram-action02         as character   no-undo .
     2368   define variable v-waitfram-action03         as character   no-undo .
     2369   define variable mWaitFramTextBeg            as character   no-undo.
     2370   define variable mWaitFramTextEnd            as character   no-undo.
     2371   define variable mWaitFramView               as logical     no-undo.
     2372   define variable mWaitProcEvent              as logical     no-undo init yes.
     2373   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2374   define variable mWaitFramStop               as logical     no-undo.
     2375   define variable mWaitFramStopUser           as logical     no-undo.
     2376   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2377   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2378   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2379   define button B-WaitFramStop auto-end-key
     2380        label "Стоп"
     2381        size 10 by 1 tooltip "Остоновить процесс".
     2382   define button B-viewProcInfo
     2383        label "Информация"
     2384        size 15 by 1 tooltip "Информация о процесс".
     2385   define frame waitfram
     2386     v-waitfram-action01 format "x(72)" no-label skip
     2387     v-waitfram-action02 format "x(72)" no-label skip
     2388     v-waitfram-action03 format "x(72)" no-label skip
     2389     B-viewProcInfo
     2390     B-WaitFramStop at row 4 col 30
     2391     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2392     .
     2393   define new global shared variable mBatchMode as logical no-undo init ?.
     2394   define variable mFramBachModHandle as handle no-undo.
     2395   mFramBachModHandle = frame waitfram:handle.
     2396   define variable mFameOldVis as logical no-undo.
     2397   define variable mVisCUrentVin as logical no-undo.
     2398   if session:batch-mode
     2399   then
     2400      mBatchMode = yes.
     2401   if mBatchMode = ? then do:
     2402     mVisCUrentVin = current-window:visible.
     2403     mFameOldVis = mFramBachModHandle:visible.
     2404     mFramBachModHandle:visible  = yes.
     2405     mBatchMode = mFramBachModHandle:visible ne yes.
     2406     mFramBachModHandle:visible = mFameOldVis.
     2407     current-window:visible = mVisCUrentVin.
     2408   end.
     2409    if  log-manager:logfile-name ne ?
     2410     then DO:
     2411         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2412         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2413         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2414     end.
     2415   on choose of B-WaitFramStop in frame waitfram
     2416   do:
     2417     mWaitFramStop = yes.
     2418     mWaitFramStopUser = yes.
     2419   end.
     2420   function waitfram-check-timeout returns logical():
     2421      define variable vtime as int64 no-undo.
     2422      if mWaitFramStopTimeOut
     2423      then
     2424         return yes.
     2425      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2426      if     mWaitFramTimeOut ne ?
     2427         and mWaitFramTimeOut ne 0
     2428         and mWaitFramTimeOut lt vtime
     2429      then do:
     2430         mWaitFramStopTimeOut = yes.
     2431      end.
     2432      return mWaitFramStopTimeOut.
     2433   end.
     2434   procedure waitfram-hide :
     2435     if not session:batch-mode
     2436     then do
     2437     on error undo, return error return-value
     2438     :
     2439       pause 0 before-hide .
     2440       if not mBatchMode then
     2441         hide frame waitfram .
     2442     if     not mWaitFramView
     2443        and mWaitProcEvent
     2444     then
     2445       process events .
     2446     end.
     2447   end procedure.
     2448   procedure waitfram-show :
     2449     define input  parameter p-message as character no-undo .
     2450     define variable v-left-margin as integer   no-undo .
     2451     if not session:batch-mode
     2452     then do
     2453     on error undo, return error return-value
     2454     :
     2455       if length(p-message) <= 70 then do:
     2456         assign
     2457           v-left-margin = integer((70 - length(p-message)) / 2)
     2458         .
     2459         assign
     2460           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2461         .
     2462         assign
     2463           v-waitfram-action01 = " "
     2464           v-waitfram-action02 = " "
     2465                                    + fill(" ", v-left-margin)
     2466                                    + p-message
     2467           v-waitfram-action03 = " "
     2468         .
     2469       end.
     2470       else do:
     2471         define variable vRindex1 as integer no-undo.
     2472         define variable vRindex2 as integer no-undo.
     2473         vRindex1 = r-index(p-message," ",70).
     2474         if vRindex1 = 0
     2475         then
     2476            vRindex1 = 70.
     2477         if length(p-message)  <= vRindex1 + 70 then do:
     2478           assign
     2479             v-waitfram-action01 = " "
     2480             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2481             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2482           .
     2483         end.
     2484         else do:
     2485           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2486           if vRindex2 <= vRindex1
     2487           then
     2488              vRindex2 = vRindex1 + 70.
     2489           assign
     2490             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2491             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2492             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2493           .
     2494         end.
     2495       end.
     2496       B-viewProcInfo:visible   in frame waitfram = no.
     2497       B-viewProcInfo:sensitive in frame waitfram = no.
     2498       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2499       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2500       if  (   mWaitFramView
     2501          or  mWaitProcEvent)
     2502          and not mBatchMode
     2503       then
     2504          display
     2505             v-waitfram-action01 skip
     2506             v-waitfram-action02 skip
     2507             v-waitfram-action03 skip
     2508          with frame waitfram .
     2509       if     mWaitFramView
     2510          then do:
     2511             if     mWaitFramInterval ne ?
     2512                and not mBatchMode
     2513             then
     2514                wait-for go of frame waitfram pause mWaitFramInterval.
     2515          end.
     2516          else
     2517             if     mWaitProcEvent
     2518                and not mBatchMode
     2519             then
     2520                process events .
     2521     end.
     2522   end procedure.
     2523      procedure waitfram-show-this:
     2524         define input  parameter iInterval as int64 no-undo.
     2525         define variable vtime as int64 no-undo.
     2526         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2527         mWaitFramInterval = iInterval.
     2528         run waitfram-show (substitute("&1&2 &3&4" ,
     2529                                       mWaitFramTextBeg ,
     2530                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2531                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2532                                       mWaitFramTextEnd
     2533                                      )
     2534                           ).
     2535      end.
     2536      procedure WaitFramRunPause:
     2537         define input  parameter iInterval as dec no-undo.
     2538         define variable vStart  as datetime-tz no-undo.
     2539         define variable vend    as datetime-tz no-undo.
     2540         define variable vint as int64 no-undo.
     2541         define variable vOk as logical no-undo.
     2542         vStart = now.
     2543         vend   = vStart.
     2544         publish "WaitFramPause" (iInterval,output vOk).
     2545         vend   =  now.
     2546         vint = vend - vStart.
     2547         vint = iInterval - vint / 1000.
     2548         if     not mWaitFramStop
     2549            and (   vint > 0
     2550                 or (    not vOk
     2551                     and iInterval eq ?
     2552                     )
     2553                 )
     2554         then
     2555            run waitfram-show-this (iInterval).
     2556         vend   =  now.
     2557         vint = vend - vStart.
     2558         vint = iInterval - vint / 1000.
     2559         if     not mWaitFramStop
     2560            and vint > 0
     2561         then do:
     2562            run gbl/pause.p (vint * 1000).
     2563         end.
     2564         if iInterval ne ?
     2565         then
     2566            publish "WaitFramStop".
     2567         waitfram-check-timeout().
     2568      end.
     2569      procedure WaitFramWaitFor:
     2570         define input  parameter iInterval as dec no-undo.
     2571         assign
     2572            mWaitFramStartProc   = now
     2573            mWaitFramStopUser    = no
     2574            mWaitFramStopTimeOut = no
     2575         .
     2576         block-wait:
     2577         do while not mWaitFramStop:
     2578            run WaitFramRunPause (iInterval).
     2579            if  waitfram-check-timeout()
     2580            then do:
     2581               leave block-wait.
     2582            end.
     2583         end.
     2584         run waitfram-hide.
     2585      end.
     2586   procedure waitfram-join :
     2587     define input  parameter p-line-1  as character no-undo .
     2588     define input  parameter p-line-2  as character no-undo .
     2589     define input  parameter p-line-3  as character no-undo .
     2590     define output parameter p-message as character no-undo .
     2591     do
     2592     on error undo, return error return-value
     2593     :
     2594       assign
     2595         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2596                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2597                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2598       .
     2599     end.
     2600   end procedure.
     2601   function waitfram-join-function returns character
     2602     (input p-line-1 as character
     2603     ,input p-line-2 as character
     2604     ,input p-line-3 as character
     2605     ).
     2606     define variable v-message as character no-undo .
     2607     run waitfram-join in this-procedure
     2608       (input  p-line-1
     2609       ,input  p-line-2
     2610       ,input  p-line-3
     2611       ,output v-message
     2612       ) .
     2613     return v-message .
     2614   end function .
     2615   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2616   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
     2617                                                       ,input p-range-type as character
     2618                                                       ,input p-code as integer):
     2619   define variable v-seq-val as integer no-undo .
     2620   define buffer buf_code-range for ub.code-range.
     2621   find first buf_code-range no-lock where
     2622             buf_code-range.db-num = p-db-num
     2623       and  buf_code-range.range-type = p-range-type
     2624       and  buf_code-range.stts = 'u'
     2625       and buf_code-range.first-code <= p-code
     2626       and buf_code-range.last-code >= p-code no-error .
     2627   if available buf_code-range then return yes.
     2628   CASE p-range-type:
     2629     when 'pngb':U then do:
     2630       v-seq-val = current-value(s-pngb-code, ub).
     2631     end.
     2632     when 'fmgb':U then do:
     2633       v-seq-val = current-value(s-fmgb-code, ub).
     2634     end.
     2635   END CASE.
     2636   if p-code <= v-seq-val then do:
     2637     find first buf_code-range no-lock where
     2638               buf_code-range.db-num = p-db-num
     2639         and  buf_code-range.range-type = p-range-type
     2640         and  buf_code-range.stts = 'a'
     2641         and buf_code-range.first-code <= p-code
     2642         no-error .
     2643    if available buf_code-range then return yes.
     2644   end.
     2645   find first buf_code-range no-lock where
     2646             buf_code-range.db-num = p-db-num
     2647       and  buf_code-range.range-type = p-range-type
     2648       and  buf_code-range.stts = 'f'
     2649       and buf_code-range.first-code <= p-code
     2650       and buf_code-range.last-code >= p-code
     2651       no-error .
     2652   if available buf_code-range then return yes.
     2653   return no.
     2654   END FUNCTION.
     2655   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
     2656                                                       ,input p-range-type as character
     2657                                                       ,input p-code as integer):
     2658   define variable v-seq-val as integer no-undo .
     2659   define buffer buf_code-range for ub.code-range.
     2660   CASE p-range-type:
     2661     when 'pngb':U then do:
     2662       v-seq-val = current-value(s-pngb-code, ub).
     2663     end.
     2664     when 'fmgb':U then do:
     2665       v-seq-val = current-value(s-fmgb-code, ub).
     2666     end.
     2667   END CASE.
     2668   if p-code <= v-seq-val then do:
     2669     find first buf_code-range no-lock where
     2670               buf_code-range.db-num = p-db-num
     2671         and  buf_code-range.range-type = p-range-type
     2672         and buf_code-range.first-code <= p-code
     2673         and buf_code-range.last-code >= p-code no-error .
     2674     if available buf_code-range then return yes.
     2675   end.
     2676   return no.
     2677   END FUNCTION.
     2678   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
     2679                                                       ,input p-db-num as integer
     2680                                                       ,input p-staff-code as integer
     2681                                                       ,input p-date as date
     2682                                                        ):
     2683   define buffer buf_staff for ub.staff.
     2684   if p-date = ? then do:
     2685     p-date = today .
     2686   end.
     2687   find first buf_staff no-lock where
     2688             buf_staff.role = p-role
     2689         and buf_staff.role-level = 'db':U
     2690         and buf_staff.db-num = p-db-num
     2691         and buf_staff.staff-code = p-staff-code
     2692         and buf_staff.date-end >= p-date use-index pi  no-error .
     2693   if available buf_staff then do:
     2694     return buf_staff.psn-code.
     2695   end.
     2696   return 0.
     2697   end FUNCTION.
     2698   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
     2699                                                             ,input p-db-num as integer
     2700                                                             ,input p-date as date
     2701                                                                 ):
     2702   define buffer buf_staff for ub.staff.
     2703   define buffer buf2_staff for ub.staff.
     2704   if p-date = ? then do:
     2705     p-date = today .
     2706   end.
     2707   for each  buf_staff no-lock where
     2708             buf_staff.role = p-role
     2709         and buf_staff.db-num = p-db-num,
     2710   first buf2_staff no-lock where
     2711         buf2_staff.role = p-role
     2712     and buf2_staff.role-level = 'db':U
     2713     and buf2_staff.staff-code = buf_staff.staff-code
     2714     and buf2_staff.date-start <= p-date
     2715     and buf2_staff.date-end >= p-date
     2716   by buf_staff.staff-code
     2717   by date-start descending:
     2718     return buf_staff.staff-code.
     2719   end.
     2720   end FUNCTION.
     2721   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
     2722                                                  ,input p-db-num as integer
     2723                                                  ,input p-psn-code as integer
     2724                                                  ,input p-date as date
     2725                                                  ,output p-c-password as character
     2726                                                        ):
     2727   define buffer buf_staff for ub.staff.
     2728   if p-date = ? then do:
     2729     p-date = today .
     2730   end.
     2731   find first buf_staff no-lock where
     2732             buf_staff.role = p-role
     2733         and buf_staff.role-level = 'db':U
     2734         and buf_staff.db-num = p-db-num
     2735        and buf_staff.date-end >= p-date
     2736        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
     2737   if available buf_staff
     2738   then do:
     2739     assign
     2740     p-c-password = buf_staff.password.
     2741     return buf_staff.staff-code.
     2742   end.
     2743   p-c-password = ''.
     2744   return 0.
     2745   end FUNCTION.
     2746   FUNCTION gbclcode-is-psn-role returns integer (
     2747                                                 input p-role as character
     2748                                                 ,input p-psn-code as integer
     2749                                                 ,input p-date as date
     2750                                                     ):
     2751   define buffer buf_staff for ub.staff.
     2752   if p-date = ? then do:
     2753     p-date = today .
     2754   end.
     2755   for each buf_staff no-lock where
     2756             buf_staff.psn-code = p-psn-code
     2757        and  buf_staff.role = p-role
     2758   by buf_staff.role-level
     2759   by buf_staff.date-start
     2760        :
     2761     if  buf_staff.date-start <= p-date and
     2762     buf_staff.date-end >= p-date  then do:
     2763       return buf_staff.staff-code.
     2764     end.
     2765   end.
     2766   return 0.
     2767   end FUNCTION.
     2768   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
     2769   define variable v-role-name as character no-undo .
     2770   assign
     2771   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     2772   no-error .
     2773   return v-role-name.
     2774   END.
     2775   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2776   FUNCTION gbclcode-get-position returns character ( input p-role as character
     2777                                                     ,input p-role-level as character
     2778                                                     ,input p-work-place as character
     2779                                                     ,input p-staff-code as integer
     2780                                                                ):
     2781   define variable v-role-name as character no-undo .
     2782   define variable v-role-level as character no-undo .
     2783   define variable v-staff-code as integer no-undo .
     2784   assign
     2785   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     2786   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
     2787   v-staff-code = p-staff-code
     2788   no-error .
     2789   return substitute("&1, &2, Код &3"
     2790                   ,v-role-name
     2791                   ,v-role-level
     2792                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
     2793   END.
     2794   FUNCTION gbclcode-get-work-place returns character (
     2795                                                   input p-role as character
     2796                                                  ,input p-role-level as character
     2797                                                  ,input p-db-num as integer
     2798                                                  ,input p-host-code as integer
     2799                                                  ,input p-obj-type as character
     2800                                                  ,input p-obj-code as integer
     2801                                                  ) :
     2802   define variable v-work-place as character no-undo .
     2803   define variable v-obj-type as character no-undo .
     2804     case p-role-level:
     2805       when 'db':U then do:
     2806         v-work-place = string(p-db-num, "99999").
     2807       end.
     2808       when 'firm':U then do:
     2809         v-work-place = string(p-host-code, "99999").
     2810       end.
     2811       when 'object':U then do:
     2812         assign
     2813         v-work-place = p-obj-type + string(p-obj-code, "999999999")
     2814         .
     2815       end.
     2816     END CASE.
     2817     return v-work-place.
     2818   END FUNCTION.
     2819   FUNCTION gbclcode-get-level-last-code returns integer (
     2820                                                           input p-role as character
     2821                                                         , input p-role-level as character
     2822                                                         , input p-work-place as character
     2823                                                         , input p-date-start as date
     2824                                                         ):
     2825   DEFINE VARIABLE v-today as date no-undo .
     2826   define buffer buf_staff for ub.staff.
     2827   if p-work-place = chr(63) then return ?.
     2828   if p-date-start = ? then do:
     2829     v-today = today .
     2830   end.
     2831   else do:
     2832     v-today = p-date-start.
     2833   end.
     2834   find last buf_staff no-lock where
     2835             buf_staff.role = p-role
     2836        and  buf_staff.role-level = p-role-level
     2837        and  buf_staff.work-place = p-work-place
     2838        and  buf_staff.date-start <= v-today + 1
     2839        and  buf_staff.date-end >= v-today + 1
     2840        use-index pi  no-error .
     2841   if available buf_staff
     2842   then return buf_staff.staff-code.
     2843   return 0.
     2844   end FUNCTION.
