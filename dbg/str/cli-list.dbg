     1312   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313   procedure fltfield-clear :
     1314     define output parameter loc-fld as character no-undo.
     1315     define output parameter loc-lab as character no-undo .
     1316     define output parameter loc-spr as character no-undo .
     1317     define output parameter loc-dim as character no-undo .
     1318     assign
     1319       loc-fld = ""
     1320       loc-lab = ""
     1321       loc-spr = ""
     1322       loc-dim = "0"
     1323     .
     1324   end procedure .
     1325   procedure fltfield-add :
     1326     define input        parameter par-fld as character no-undo.
     1327     define input        parameter par-lab as character no-undo .
     1328     define input        parameter par-spr as character no-undo .
     1329     define input-output parameter loc-fld as character no-undo.
     1330     define input-output parameter loc-lab as character no-undo .
     1331     define input-output parameter loc-spr as character no-undo .
     1332     define input-output parameter loc-dim as character no-undo .
     1333     do
     1334     on error undo, return error
     1335     :
     1336       assign
     1337       loc-fld = if loc-dim = '0'
     1338                 then par-fld
     1339                 else (loc-fld + chr(44) + par-fld)
     1340       loc-lab = if loc-dim = '0'
     1341                 then par-lab
     1342                 else (loc-lab + chr(44) + par-lab)
     1343       loc-spr = if loc-dim = '0'
     1344                 then par-spr
     1345                 else (loc-spr + chr(44) + par-spr)
     1346       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1347                 string(integer(if num-entries(loc-dim) > 1
     1348                               then entry(2, loc-dim)
     1349                               else entry(1, loc-dim)
     1350                               ) + 1)
     1351       no-error
     1352       .
     1353     end.
     1354   end procedure.
     1355   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1356   define  stream PrnLibStream.
     1357   procedure prn-lib-prn-file :
     1358     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1359     define input parameter p-DIsabledoptions as integer no-undo .
     1360     define variable v-report-name as character no-undo .
     1361     define variable v-user-action as character no-undo .
     1362     define variable v-printed     as logical   no-undo .
     1363     define variable v-exist       as logical   no-undo .
     1364     do
     1365       on error undo, return error
     1366       :
     1367       run prn-lib-get-report-name  in this-procedure (
     1368         input parParentProc
     1369         ,output v-report-name
     1370         ).
     1371   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1373     (input  v-report-name
     1374     ,input  2
     1375     ,output v-exist
     1376     )  .
     1377       if NOT v-exist then
     1378       DO:
     1379         Message
     1380           "Нет заданий на печать ! "
     1381           view-as alert-box .
     1382         Return  .
     1383       End.
     1384       run gbl/prnfilen.w
     1385         (input  ""
     1386         ,input  p-DisabledOptions
     1387         ,input  string(v-report-name )
     1388         ,input  7
     1389         ,output v-user-action
     1390         ,output v-printed
     1391         ) .
     1392       if v-printed then
     1393       do:
     1394         return "YES" .
     1395       end.
     1396       else
     1397       do:
     1398         return "NO" .
     1399       end.
     1400     end.
     1401   end procedure.
     1402   procedure prn-lib-open-stream :
     1403     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1404     define input parameter p-page-size    as integer no-undo .
     1405     define input parameter p-is-stream    as logical no-undo .
     1406     define input parameter p-append       as logical no-undo .
     1407     define variable v-report-name as character no-undo .
     1408     do
     1409       on error undo, return error
     1410       :
     1411       run prn-lib-get-report-name  in this-procedure (
     1412         input parParentProc
     1413         ,output v-report-name
     1414         ).
     1415       if p-is-stream then
     1416       do:
     1417         if p-append then
     1418         do:
     1419           output stream PrnLibStream to value( v-report-name )
     1420             page-size value(p-page-size) append .
     1421         end.
     1422         if not p-append then
     1423         do:
     1424           output stream PrnLibStream to value( v-report-name )
     1425             page-size value(p-page-size) .
     1426         end.
     1427       end.
     1428       if not p-is-stream then
     1429       do:
     1430         if p-append then
     1431         do:
     1432           output to value( v-report-name )
     1433             page-size value(p-page-size) append .
     1434         end.
     1435         if not p-append then
     1436         do:
     1437           output to value( v-report-name )
     1438             page-size value(p-page-size) .
     1439         end.
     1440       end.
     1441     end.
     1442   end procedure.
     1443   procedure prn-lib-open-exp :
     1444     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1445     define input parameter p-is-stream    as logical no-undo .
     1446     define input parameter p-is-append    as logical no-undo .
     1447     define output parameter p-ReportFileName as char init "report" no-undo.
     1448     define output parameter p-process as logical no-undo .
     1449     define variable glog as logical no-undo .
     1450     do
     1451       on error undo, return error
     1452       :
     1453       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1454         TITLE      "Укажите путь"
     1455         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1456         ASK-OVERWRITE
     1457         CREATE-TEST-FILE
     1458         SAVE-AS
     1459         USE-FILENAME
     1460         DEFAULT-EXTENSION "txt"
     1461         UPDATE glog
     1462         .
     1463       if not glog then  return.
     1464       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1465       if p-is-stream then
     1466       do:
     1467         if p-is-append then
     1468         do:
     1469           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1470         end.
     1471         else
     1472         do:
     1473           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1474         end.
     1475       end.
     1476       else
     1477       do:
     1478         if p-is-append then
     1479         do:
     1480           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1481         end.
     1482         else
     1483         do:
     1484           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1485         end.
     1486       end.
     1487       p-process = yes.
     1488     end.
     1489   end procedure.
     1490   procedure prn-lib-get-report-name :
     1491     define input parameter parParentProc  as widget-handle no-undo.
     1492     define output parameter p-report-name as character no-undo .
     1493     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1494   end procedure.
     1495   procedure prn-lib-reportviewer-report-name :
     1496     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1497     define input parameter p-report-name-html as character no-undo .
     1498     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1499   end procedure.
     1500   procedure prn-lib-reportviewer :
     1501     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1502     define input parameter p-report-name-html as character no-undo .
     1503     define input parameter p-param        as character no-undo .
     1504     define variable v-excel           as character no-undo init 'TRUE' .
     1505     define variable v-value-character as character no-undo .
     1506     define variable v-value-integer   as character no-undo .
     1507     define variable v-value-date      as date      no-undo .
     1508     define variable v-value-decimal   as decimal   no-undo .
     1509     define variable rep-excel         as logical   no-undo .
     1510     define variable excel-string      as character no-undo .
     1511     define variable v-param-type      as character no-undo .
     1512     define variable v-tth             as handle    no-undo .
     1513     run adm/shattri.p (
     1514       input "get":U
     1515       ,input  ""
     1516       ,input  0
     1517       ,input  'report-glob':U
     1518       ,input  'rep-excel':U
     1519       ,output v-value-character
     1520       ,output v-value-date
     1521       ,output v-value-decimal
     1522       ,output v-value-integer
     1523       ,output rep-excel
     1524       ,output v-param-type
     1525       ,INPUT-OUTPUT table-handle v-tth
     1526       )  .
     1527     if rep-excel then v-excel = "TRUE" .
     1528     else v-excel = "FALSE" .
     1529     if p-param eq ""
     1530     then
     1531        p-param = "EXCEL:" + v-excel.
     1532     else
     1533        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1534     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1535   end procedure.
