      983   run minbtn-set in this-procedure .
      984   on choose of b-help in frame Dialog-Frame
      985   do:
      986     apply "help":u to frame Dialog-Frame .
      987   end.
      988   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      989   procedure minbtn-set :
      990       do
      991           on error undo, return error return-value
      992           :
      993           define variable ii              as integer       no-undo .
      994           define variable fh              as widget-handle no-undo .
      995           define variable hh              as widget-handle no-undo .
      996           define variable v-h             as handle        extent 4 no-undo .
      997           define variable v-name-button   as character     no-undo .
      998           define variable v-help-old-x    as decimal       no-undo .
      999           define variable v-help-old-y    as decimal       no-undo .
     1000           define variable v-help-old-size as decimal       no-undo .
     1001           define variable v-frame-width   as decimal       no-undo .
     1002           define variable jj              as integer       no-undo .
     1003           do
     1004               on error undo, return error
     1005               :
     1006               assign
     1007                   v-frame-width = frame Dialog-Frame:width - 0.3
     1008                   fh            = frame Dialog-Frame:first-child
     1009                   hh            = fh:first-child
     1010                   ii            = 1
     1011                   .
     1012               do while valid-handle(hh):
     1013                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1014                   do:
     1015                       case lc(hh:name) :
     1016                           when "b-help" then
     1017                               do:
     1018                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1019                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1020                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1021                                   hh:TOOLTIP = "Помощь" .
     1022                                   v-help-old-x = hh:column .
     1023                                   v-help-old-y = hh:row    .
     1024                                   v-help-old-size = hh:width .
     1025                                   hh:width-chars = 2.5 .
     1026                               end.
     1027                           when "b-print" then
     1028                               do:
     1029                                   hh:load-image("cmp/b-print.bmp":u) .
     1030                                   hh:TOOLTIP = "Печать" .
     1031                                   v-h[ii] = hh:handle .
     1032                                   ii = ii + 1 .
     1033                                   hh:width-chars = 3 .
     1034                               end.
     1035                           when "b-history" or
     1036                           when "b-hist" then
     1037                               do:
     1038                                   hh:load-image("cmp/b-hist.bmp":u) .
     1039                                   hh:TOOLTIP = "История" .
     1040                                   v-h[ii] = hh:handle .
     1041                                   ii = ii + 1 .
     1042                                   hh:width-chars = 3 .
     1043                               end.
     1044                           when "b-sch" then
     1045                               do:
     1046                                   hh:load-image("cmp/b-sch.bmp":u) .
     1047                                   hh:TOOLTIP = "Установка Фильтра" .
     1048                                   v-h[ii] = hh:handle .
     1049                                   ii = ii + 1 .
     1050                                   hh:width-chars = 3 .
     1051                               end.
     1052                           when "b-hist-user" then
     1053                               do:
     1054                                   hh:load-image("cmp/b-hist.bmp":u) .
     1055                                   hh:TOOLTIP = "История пользователя" .
     1056                                   ii = ii + 1 .
     1057                               end.
     1058                       end case.
     1059                   end.
     1060                   hh = hh:next-sibling.
     1061               end.
     1062               b-help:column = v-frame-width - b-help:width-chars.
     1063               jj = 0.
     1064               repeat ii = 4 to 1 by -1 :
     1065                   if valid-handle (v-h[ii] ) then
     1066                   do:
     1067                       jj  = jj + 1 .
     1068                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1069                       v-h[ii]:row    = v-help-old-y .
     1070                   end.
     1071               end.
     1072           end.
     1073       end.
     1074   end procedure.
     1075   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1076   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1077   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1078   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1079   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1080   define variable v-diasize-current-frame-height as decimal   no-undo .
     1081   define variable v-diasize-change-size          as logical   no-undo .
     1082   define variable v-diasize-resize-button        as handle    no-undo .
     1083   define variable v-diasize-wndmax               as logical   no-undo .
     1084   define variable v-diasize-wndstore             as logical   no-undo .
     1085   define variable v-diasize-proc-name            as character no-undo .
     1086   define variable v-diasize-browse-handle        as handle    no-undo .
     1087   define variable v-diasize-browse-number        as integer   no-undo .
     1088   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1089   define temp-table temp-diasize-handle no-undo
     1090     field handle-value  as handle
     1091     field save-position as decimal
     1092     index xpk is primary unique handle-value
     1093     .
     1094   define temp-table temp-browse-handle no-undo
     1095     field browse-type   as character
     1096     field browse-number as integer
     1097     field browse-handle as handle
     1098     field original-size as decimal
     1099     index xpk is primary unique browse-type browse-number
     1100     index xie browse-type browse-handle
     1101   .
     1102   procedure diasize_change-height :
     1103     define input  parameter p-change-value  as decimal   no-undo .
     1104     define input  parameter p-move-resize   as logical   no-undo .
     1105     define variable v-field-group-handle    as handle    no-undo .
     1106     define variable v-object-handle         as handle    no-undo .
     1107     define variable v-frame-height          as decimal   no-undo .
     1108     define variable v-frame-virtual-height  as decimal   no-undo .
     1109     define variable v-browse-height         as decimal   no-undo .
     1110     define variable v-window-height         as decimal   no-undo .
     1111     define variable v-window-virtual-height as decimal   no-undo .
     1112     define variable v-change-sign           as integer   no-undo .
     1113     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1114     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1115     if p-change-value > 0
     1116     then do:
     1117       if frame Dialog-Frame :height + p-change-value
     1118           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1119       then do:
     1120         assign
     1121           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1122                           - (frame Dialog-Frame :height-chars)
     1123         .
     1124         if p-change-value <= 0
     1125         then do:
     1126           run diasize_position-resize-button in this-procedure .
     1127           return .
     1128         end.
     1129       end.
     1130     end.
     1131     if p-change-value < 0
     1132     then do:
     1133       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1134       then do:
     1135         assign
     1136           p-change-value = v-diasize-orig-frame-height
     1137                          - (frame Dialog-Frame :height-chars)
     1138         .
     1139         if p-change-value >= 0
     1140         then do:
     1141           run diasize_position-resize-button in this-procedure .
     1142           return .
     1143         end.
     1144       end.
     1145     end.
     1146     if p-change-value >= 0
     1147     then do:
     1148       assign
     1149         v-change-sign = 1
     1150       .
     1151     end.
     1152     else do:
     1153       assign
     1154         v-change-sign = -1
     1155       .
     1156     end.
     1157     assign
     1158       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1159     .
     1160     if p-change-value = 0
     1161     then do:
     1162       run diasize_position-resize-button in this-procedure .
     1163       return .
     1164     end.
     1165     move_block:
     1166     do
     1167     on error undo move_block, retry move_block
     1168     :
     1169       if retry
     1170       then do:
     1171         do
     1172         on error undo move_block, leave move_block
     1173         :
     1174           if p-change-value > 0
     1175           then do:
     1176             for each buf_temp-diasize-handle
     1177             on error undo, next
     1178             :
     1179               assign
     1180                 v-object-handle = buf_temp-diasize-handle.handle-value
     1181               .
     1182               if v-object-handle <> v-diasize-resize-button
     1183               then do:
     1184                 assign
     1185                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1186                 .
     1187               end.
     1188             end.
     1189             assign
     1190               v-diasize-browse-handle :height = v-browse-height
     1191             .
     1192             for each buf_temp-browse-handle
     1193               where buf_temp-browse-handle.browse-type = 'height':u
     1194             on error undo, next
     1195             :
     1196               assign
     1197                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1198               .
     1199             end.
     1200             assign
     1201               frame Dialog-Frame :height = v-frame-height
     1202             .
     1203             if frame Dialog-Frame :scrollable = true
     1204             then do:
     1205               assign
     1206                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1207               .
     1208             end.
     1209             run diasize_position-resize-button in this-procedure .
     1210           end.
     1211           else do:
     1212             if frame Dialog-Frame :scrollable = true
     1213             then do:
     1214               assign
     1215                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1216               .
     1217             end.
     1218             assign
     1219               frame Dialog-Frame :height = v-frame-height
     1220             .
     1221             assign
     1222               v-diasize-browse-handle :height = v-browse-height
     1223             .
     1224             for each buf_temp-browse-handle
     1225               where buf_temp-browse-handle.browse-type = 'height':u
     1226             on error undo, next
     1227             :
     1228               assign
     1229                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1230               .
     1231             end.
     1232             for each buf_temp-diasize-handle
     1233             on error undo, next
     1234             :
     1235               assign
     1236                 v-object-handle = buf_temp-diasize-handle.handle-value
     1237               .
     1238               if v-object-handle <> v-diasize-resize-button
     1239               then do:
     1240                 assign
     1241                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1242                 .
     1243               end.
     1244             end.
     1245             run diasize_position-resize-button in this-procedure .
     1246           end.
     1247           assign
     1248             v-diasize-change-size = false
     1249           .
     1250           leave move_block .
     1251         end.
     1252       end.
     1253       assign
     1254         v-diasize-need-full-display = true
     1255       .
     1256       if v-diasize-change-size = false
     1257       then do:
     1258         assign
     1259           v-diasize-change-size = true
     1260         .
     1261       end.
     1262       else do:
     1263         return .
     1264       end.
     1265       assign
     1266         v-frame-height = frame Dialog-Frame :height
     1267         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1268         v-browse-height = v-diasize-browse-handle :height
     1269       .
     1270       for each buf_temp-browse-handle
     1271         where buf_temp-browse-handle.browse-type = 'height':u
     1272       :
     1273         assign
     1274           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1275         .
     1276       end.
     1277       for each buf_temp-diasize-handle
     1278       :
     1279         delete buf_temp-diasize-handle .
     1280       end.
     1281       assign
     1282         v-field-group-handle = frame Dialog-Frame :first-child
     1283       .
     1284       do while valid-handle(v-field-group-handle)
     1285       :
     1286         assign
     1287           v-object-handle = v-field-group-handle :first-child
     1288         .
     1289         do while valid-handle(v-object-handle)
     1290         :
     1291           if  v-object-handle <> v-diasize-browse-handle :handle
     1292           and can-query(v-object-handle, "row")
     1293           and can-query(v-object-handle, "height")
     1294           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1295           then do:
     1296             find first buf_temp-browse-handle
     1297               where buf_temp-browse-handle.browse-type   = 'height':u
     1298                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1299               no-error .
     1300             if available buf_temp-browse-handle
     1301             then do:
     1302             end.
     1303             else do:
     1304               create buf_temp-diasize-handle .
     1305               assign
     1306                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1307                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1308               .
     1309             end.
     1310           end.
     1311           assign
     1312             v-object-handle = v-object-handle :next-sibling
     1313           .
     1314         end.
     1315         assign
     1316           v-field-group-handle = v-field-group-handle :next-sibling
     1317         .
     1318       end.
     1319       do with frame Dialog-Frame
     1320       :
     1321         hide v-diasize-resize-button .
     1322         assign
     1323           v-diasize-resize-button :row    = 1
     1324           v-diasize-resize-button :column = 1
     1325         .
     1326       end.
     1327       if p-change-value > 0
     1328       then do:
     1329         if frame Dialog-Frame :scrollable = true
     1330         then do:
     1331           assign
     1332             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1333             no-error .
     1334           if error-status :error
     1335           or error-status :get-message(1) <> ""
     1336           then do:
     1337             undo move_block, retry move_block .
     1338           end.
     1339         end.
     1340         assign
     1341           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1342           no-error .
     1343         if error-status :error
     1344         or error-status :get-message(1) <> ""
     1345         then do:
     1346           undo move_block, retry move_block .
     1347         end.
     1348         assign
     1349           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1350           no-error .
     1351         if error-status :error
     1352         or error-status :get-message(1) <> ""
     1353         then do:
     1354           undo move_block, retry move_block .
     1355         end.
     1356         for each buf_temp-browse-handle
     1357           where buf_temp-browse-handle.browse-type = 'height':u
     1358         on error undo move_block, retry move_block
     1359         :
     1360           assign
     1361             buf_temp-browse-handle.browse-handle :height
     1362               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1363             no-error .
     1364           if error-status :error
     1365           or error-status :get-message(1) <> ""
     1366           then do:
     1367             undo move_block, retry move_block .
     1368           end.
     1369         end.
     1370         for each buf_temp-diasize-handle
     1371         on error undo move_block, retry move_block
     1372         :
     1373           assign
     1374             v-object-handle = buf_temp-diasize-handle.handle-value
     1375           .
     1376           if v-object-handle <> v-diasize-resize-button
     1377           then do:
     1378             assign
     1379               v-object-handle :row = v-object-handle :row + p-change-value
     1380               no-error .
     1381             if error-status :error
     1382             or error-status :get-message(1) <> ""
     1383             then do:
     1384               undo move_block, retry move_block .
     1385             end.
     1386           end.
     1387         end.
     1388       end.
     1389       else do:
     1390         for each buf_temp-diasize-handle
     1391         on error undo move_block, retry move_block
     1392         :
     1393           assign
     1394             v-object-handle = buf_temp-diasize-handle.handle-value
     1395           .
     1396           if v-object-handle <> v-diasize-resize-button
     1397           then do:
     1398             assign
     1399               v-object-handle :row = v-object-handle :row + p-change-value
     1400               no-error .
     1401             if error-status :error
     1402             or error-status :get-message(1) <> ""
     1403             then do:
     1404               undo move_block, retry move_block .
     1405             end.
     1406           end.
     1407         end.
     1408         assign
     1409           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1410           no-error .
     1411         if error-status :error
     1412         or error-status :get-message(1) <> ""
     1413         then do:
     1414           undo move_block, retry move_block .
     1415         end.
     1416         for each buf_temp-browse-handle
     1417           where buf_temp-browse-handle.browse-type = 'height':u
     1418         on error undo move_block, retry move_block
     1419         :
     1420           assign
     1421             buf_temp-browse-handle.browse-handle :height
     1422               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1423             no-error .
     1424           if error-status :error
     1425           or error-status :get-message(1) <> ""
     1426           then do:
     1427             undo move_block, retry move_block .
     1428           end.
     1429         end.
     1430         assign
     1431           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1432           no-error .
     1433         if error-status :error
     1434         or error-status :get-message(1) <> ""
     1435         then do:
     1436           undo move_block, retry move_block .
     1437         end.
     1438         if frame Dialog-Frame :scrollable = true
     1439         then do:
     1440           assign
     1441             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1442             no-error .
     1443           if error-status :error
     1444           or error-status :get-message(1) <> ""
     1445           then do:
     1446             undo move_block, retry move_block .
     1447           end.
     1448         end.
     1449       end.
     1450       if p-move-resize = true
     1451       then do:
     1452         run diasize_position-resize-button in this-procedure .
     1453       end.
     1454       if v-diasize-wndstore = true
     1455       then do:
     1456         if connected("ub") = true
     1457         then do:
     1458           define variable v-cntxt-db-num        as integer   no-undo .
     1459           define variable v-cntxt-userid        as character no-undo .
     1460           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1461                                             , OUTPUT v-cntxt-userid
     1462                                             ) .
     1463           run gbl/wndsizew.p
     1464             (input  v-cntxt-db-num
     1465             ,input  v-cntxt-userid
     1466             ,input  v-diasize-proc-name
     1467             ,input  'height':u
     1468             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1469             ) .
     1470         end.
     1471       end.
     1472     end.
     1473     assign
     1474       v-diasize-change-size = false
     1475     .
     1476   end procedure.
     1477   procedure diasize_set-height :
     1478     define input  parameter p-new-height  as decimal   no-undo .
     1479     define input  parameter p-move-resize as logical   no-undo .
     1480     do
     1481     on error undo, return error return-value
     1482     :
     1483       run diasize_change-height in this-procedure
     1484         (input  (p-new-height - frame Dialog-Frame :height)
     1485         ,input  p-move-resize
     1486         ) .
     1487     end.
     1488   end procedure.
     1489   procedure diasize_change-width :
     1490     define input  parameter p-change-value as decimal   no-undo .
     1491     define input  parameter p-move-resize  as logical   no-undo .
     1492     define variable v-field-group-handle   as handle    no-undo .
     1493     define variable v-object-handle        as handle    no-undo .
     1494     define variable v-frame-width          as decimal   no-undo .
     1495     define variable v-frame-virtual-width  as decimal   no-undo .
     1496     define variable v-browse-width         as decimal   no-undo .
     1497     define variable v-window-width         as decimal   no-undo .
     1498     define variable v-window-virtual-width as decimal   no-undo .
     1499     define variable v-change-sign          as integer   no-undo .
     1500     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1501     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1502     if p-change-value > 0
     1503     then do:
     1504       if frame Dialog-Frame :width + p-change-value >
     1505           session :width-chars
     1506       then do:
     1507         assign
     1508           p-change-value = session :width-chars - frame Dialog-Frame :width
     1509         .
     1510         if p-change-value <= 0
     1511         then do:
     1512           run diasize_position-resize-button in this-procedure .
     1513           return .
     1514         end.
     1515       end.
     1516     end.
     1517     if p-change-value < 0
     1518     then do:
     1519       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1520       then do:
     1521         assign
     1522           p-change-value = v-diasize-orig-frame-width
     1523                          - frame Dialog-Frame :width
     1524         .
     1525         if p-change-value >= 0
     1526         then do:
     1527           run diasize_position-resize-button in this-procedure .
     1528           return .
     1529         end.
     1530       end.
     1531     end.
     1532     if p-change-value >= 0
     1533     then do:
     1534       assign
     1535         v-change-sign = 1
     1536       .
     1537     end.
     1538     else do:
     1539       assign
     1540         v-change-sign = -1
     1541       .
     1542     end.
     1543     assign
     1544       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1545     .
     1546     if p-change-value = 0
     1547     then do:
     1548       run diasize_position-resize-button in this-procedure .
     1549       return .
     1550     end.
     1551     move_block:
     1552     do
     1553     on error undo move_block, leave move_block
     1554     :
     1555       if retry
     1556       then do:
     1557         do
     1558         on error undo move_block, leave move_block
     1559         :
     1560           if p-change-value > 0
     1561           then do:
     1562             for each buf_temp-diasize-handle
     1563             on error undo, next
     1564             :
     1565               assign
     1566                 v-object-handle = buf_temp-diasize-handle.handle-value
     1567               .
     1568               if v-object-handle <> v-diasize-resize-button
     1569               then do:
     1570                 assign
     1571                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1572                 .
     1573               end.
     1574             end.
     1575             assign
     1576               v-diasize-browse-handle :width = v-browse-width
     1577             .
     1578             for each buf_temp-browse-handle
     1579               where buf_temp-browse-handle.browse-type = 'width':u
     1580             on error undo, next
     1581             :
     1582               assign
     1583                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1584               .
     1585             end.
     1586             assign
     1587               frame Dialog-Frame :width = v-frame-width
     1588             .
     1589             if frame Dialog-Frame :scrollable = true
     1590             then do:
     1591               assign
     1592                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1593               .
     1594             end.
     1595             run diasize_position-resize-button in this-procedure .
     1596           end.
     1597           else do:
     1598             if frame Dialog-Frame :scrollable = true
     1599             then do:
     1600               assign
     1601                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1602               .
     1603             end.
     1604             assign
     1605               frame Dialog-Frame :width = v-frame-width
     1606             .
     1607             for each buf_temp-browse-handle
     1608               where buf_temp-browse-handle.browse-type = 'width':u
     1609             on error undo, next
     1610             :
     1611               assign
     1612                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1613               .
     1614             end.
     1615             assign
     1616               v-diasize-browse-handle :width = v-browse-width
     1617             .
     1618             for each buf_temp-diasize-handle
     1619             on error undo, next
     1620             :
     1621               assign
     1622                 v-object-handle = buf_temp-diasize-handle.handle-value
     1623               .
     1624               if v-object-handle <> v-diasize-resize-button
     1625               then do:
     1626                 assign
     1627                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1628                 .
     1629               end.
     1630             end.
     1631             run diasize_position-resize-button in this-procedure .
     1632           end.
     1633           assign
     1634             v-diasize-change-size = false
     1635           .
     1636           leave move_block .
     1637         end.
     1638       end.
     1639       assign
     1640         v-diasize-need-full-display = true
     1641       .
     1642       if v-diasize-change-size = false
     1643       then do:
     1644         assign
     1645           v-diasize-change-size = true
     1646         .
     1647       end.
     1648       else do:
     1649         return .
     1650       end.
     1651       assign
     1652         v-frame-width = frame Dialog-Frame :width
     1653         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1654         v-browse-width = v-diasize-browse-handle :width
     1655       .
     1656       for each buf_temp-browse-handle
     1657         where buf_temp-browse-handle.browse-type = 'width':u
     1658       :
     1659         assign
     1660           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1661         .
     1662       end.
     1663       for each buf_temp-diasize-handle
     1664       :
     1665         delete buf_temp-diasize-handle .
     1666       end.
     1667       assign
     1668         v-field-group-handle = frame Dialog-Frame :first-child
     1669       .
     1670       do while valid-handle(v-field-group-handle)
     1671       :
     1672         assign
     1673           v-object-handle = v-field-group-handle :first-child
     1674         .
     1675         do while valid-handle(v-object-handle)
     1676         :
     1677           if  v-object-handle <> v-diasize-browse-handle :handle
     1678           and v-object-handle <> v-diasize-resize-button
     1679           and can-query(v-object-handle, "row")
     1680           and can-query(v-object-handle, "height")
     1681           and ( v-object-handle :col + v-object-handle :width
     1682                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1683               )
     1684           then do:
     1685             find first buf_temp-browse-handle
     1686               where buf_temp-browse-handle.browse-type   = 'width':u
     1687                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1688               no-error .
     1689             if available buf_temp-browse-handle
     1690             then do:
     1691             end.
     1692             else do:
     1693               create buf_temp-diasize-handle .
     1694               assign
     1695                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1696                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1697               .
     1698             end.
     1699           end.
     1700           assign
     1701             v-object-handle = v-object-handle :next-sibling
     1702           .
     1703         end.
     1704         assign
     1705           v-field-group-handle = v-field-group-handle :next-sibling
     1706         .
     1707       end.
     1708       do with frame Dialog-Frame
     1709       :
     1710         hide v-diasize-resize-button .
     1711         v-diasize-resize-button :row = 1.
     1712         v-diasize-resize-button :column = 1.
     1713       end.
     1714       if p-change-value > 0
     1715       then do:
     1716         if frame Dialog-Frame :scrollable = true
     1717         then do:
     1718           assign
     1719             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1720             no-error .
     1721           if error-status :error
     1722           or error-status :get-message(1) <> ""
     1723           then do:
     1724             undo move_block, retry move_block.
     1725           end.
     1726         end.
     1727         assign
     1728           frame Dialog-Frame :width = v-frame-width + p-change-value
     1729           no-error .
     1730         if error-status :error
     1731         or error-status :get-message(1) <> ""
     1732         then do:
     1733           undo move_block, retry move_block.
     1734         end.
     1735         assign
     1736           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1737         no-error .
     1738         if error-status :error
     1739         or error-status :get-message(1) <> ""
     1740         then do:
     1741           undo move_block, retry move_block.
     1742         end.
     1743         for each buf_temp-browse-handle
     1744           where buf_temp-browse-handle.browse-type = 'width':u
     1745         on error undo move_block, retry move_block
     1746         :
     1747           assign
     1748             buf_temp-browse-handle.browse-handle :width
     1749               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1750             no-error .
     1751           if error-status :error
     1752           or error-status :get-message(1) <> ""
     1753           then do:
     1754             undo move_block, retry move_block .
     1755           end.
     1756         end.
     1757         for each buf_temp-diasize-handle
     1758         on error undo move_block, retry move_block
     1759         :
     1760           assign
     1761             v-object-handle = buf_temp-diasize-handle.handle-value
     1762           .
     1763           if v-object-handle <> v-diasize-resize-button
     1764           then do:
     1765             assign
     1766               v-object-handle :col = v-object-handle :col + p-change-value
     1767               no-error .
     1768             if error-status :error
     1769             or error-status :get-message(1) <> ""
     1770             then do:
     1771               undo move_block, retry move_block .
     1772             end.
     1773           end.
     1774         end.
     1775       end.
     1776       else do:
     1777         for each buf_temp-diasize-handle
     1778         on error undo move_block, retry move_block
     1779         :
     1780           assign
     1781             v-object-handle = buf_temp-diasize-handle.handle-value
     1782           .
     1783           if v-object-handle <> v-diasize-resize-button
     1784           then do:
     1785             assign
     1786               v-object-handle :col = v-object-handle :col + p-change-value
     1787               no-error .
     1788             if error-status :error
     1789             or error-status :get-message(1) <> ""
     1790             then do:
     1791               undo move_block, retry move_block .
     1792             end.
     1793           end.
     1794         end.
     1795         for each buf_temp-browse-handle
     1796           where buf_temp-browse-handle.browse-type = 'width':u
     1797         on error undo move_block, retry move_block
     1798         :
     1799           assign
     1800             buf_temp-browse-handle.browse-handle :width
     1801               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1802             no-error .
     1803           if error-status :error
     1804           or error-status :get-message(1) <> ""
     1805           then do:
     1806             undo move_block, retry move_block .
     1807           end.
     1808         end.
     1809         assign
     1810           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1811           no-error .
     1812         if error-status :error
     1813         or error-status :get-message(1) <> ""
     1814         then do:
     1815           undo move_block, retry move_block.
     1816         end.
     1817         assign
     1818           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1819         no-error .
     1820         if error-status :error
     1821         or error-status :get-message(1) <> ""
     1822         then do:
     1823           undo move_block, retry move_block.
     1824         end.
     1825         if frame Dialog-Frame :scrollable = true
     1826         then do:
     1827           assign
     1828             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1829           no-error .
     1830           if error-status :error
     1831           or error-status :get-message(1) <> ""
     1832           then do:
     1833             undo move_block, retry move_block.
     1834           end.
     1835         end.
     1836       end.
     1837       if p-move-resize
     1838       then do:
     1839         run diasize_position-resize-button in this-procedure .
     1840       end.
     1841       if v-diasize-wndstore = true
     1842       then do:
     1843         if connected("ub") = true
     1844         then do:
     1845           define variable v-cntxt-db-num        as integer   no-undo .
     1846           define variable v-cntxt-userid        as character no-undo .
     1847           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1848                                             , OUTPUT v-cntxt-userid
     1849                                             ) .
     1850           run gbl/wndsizew.p
     1851             (input  v-cntxt-db-num
     1852             ,input  v-cntxt-userid
     1853             ,input  v-diasize-proc-name
     1854             ,input  'width':u
     1855             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1856             ) .
     1857         end.
     1858       end.
     1859     end.
     1860     assign
     1861       v-diasize-change-size = false
     1862     .
     1863   end procedure.
     1864   procedure diasize_set-width :
     1865     define input  parameter p-new-width  as decimal   no-undo .
     1866     define input  parameter p-move-resize as logical   no-undo .
     1867     do
     1868     on error undo, return error return-value
     1869     :
     1870       run diasize_change-width in this-procedure
     1871         (input  (p-new-width - frame Dialog-Frame :width)
     1872         ,input  p-move-resize
     1873         ) .
     1874     end.
     1875   end procedure.
     1876   procedure diasize_position-resize-button :
     1877     do with frame Dialog-Frame
     1878     :
     1879       hide v-diasize-resize-button .
     1880       assign
     1881         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1882                     - 1
     1883                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1884         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1885                     - 1
     1886                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1887       .
     1888       view v-diasize-resize-button .
     1889     end.
     1890   end procedure.
     1891   on alt-right anywhere
     1892   do:
     1893     run diasize_change-width in this-procedure
     1894       (input 1
     1895       ,input true
     1896       ) .
     1897     return no-apply .
     1898   end.
     1899   on alt-left anywhere
     1900   do:
     1901     run diasize_change-width in this-procedure
     1902       (input -1
     1903       ,input true
     1904       ) .
     1905     return no-apply .
     1906   end.
     1907   on alt-down anywhere
     1908   do:
     1909     run diasize_change-height in this-procedure
     1910       (input 1
     1911       ,input true
     1912       ) .
     1913     return no-apply .
     1914   end.
     1915   on alt-up anywhere
     1916   do:
     1917     run diasize_change-height in this-procedure
     1918       (input -1
     1919       ,input true
     1920       ) .
     1921     return no-apply .
     1922   end.
     1923   on alt-enter of frame Dialog-Frame
     1924   do:
     1925     run diasize_maximize in this-procedure
     1926       (input  ?
     1927       ).
     1928     return no-apply .
     1929   end.
     1930   procedure diasize_end-move :
     1931     do
     1932     on error undo, return error return-value
     1933     :
     1934       define variable v-row-delta as decimal   no-undo .
     1935       define variable v-col-delta as decimal   no-undo .
     1936       define variable v-new-row as decimal   no-undo .
     1937       define variable v-new-col as decimal   no-undo .
     1938       assign
     1939         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1940         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1941       .
     1942       assign
     1943         v-row-delta = v-new-row - frame Dialog-Frame :height
     1944         v-col-delta = v-new-col - frame Dialog-Frame :width
     1945       .
     1946       run diasize_change-height in this-procedure
     1947         (input v-row-delta
     1948         ,input true
     1949         ) .
     1950       run diasize_change-width in this-procedure
     1951         (input v-col-delta
     1952         ,input true
     1953         ) .
     1954     end.
     1955   end procedure.
     1956   procedure diasize_maximize :
     1957     define input  parameter p-action as logical   no-undo .
     1958     do
     1959     on error undo, return error return-value
     1960     :
     1961       if p-action = ?
     1962       then do:
     1963         if v-diasize-need-maximize = true
     1964         then do:
     1965           assign
     1966             p-action = true
     1967           .
     1968         end.
     1969         else do:
     1970           assign
     1971             p-action = false
     1972           .
     1973         end.
     1974       end.
     1975       if p-action = true
     1976       then do:
     1977         run diasize_change-height in this-procedure
     1978           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1979               - frame Dialog-Frame :height-chars
     1980           ,input true
     1981           ) .
     1982         run diasize_change-width in this-procedure
     1983           (input session :width-chars
     1984               - frame Dialog-Frame :width-chars
     1985           ,input true
     1986           ) .
     1987         assign
     1988           v-diasize-need-maximize = false
     1989         .
     1990       end.
     1991       else do:
     1992         run diasize_change-width in this-procedure
     1993           (input v-diasize-orig-frame-width
     1994               - frame Dialog-Frame :width-chars
     1995           ,input true
     1996           ) .
     1997         run diasize_change-height in this-procedure
     1998           (input v-diasize-orig-frame-height
     1999               - frame Dialog-Frame :height-chars
     2000           ,input true
     2001           ) .
     2002         assign
     2003           v-diasize-need-maximize = true
     2004         .
     2005       end.
     2006     end.
     2007   end procedure.
     2008   procedure diasize_restore-orig-size :
     2009     do
     2010     on error undo, return error return-value
     2011     :
     2012       assign
     2013         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2014         v-diasize-current-frame-height = frame Dialog-Frame :height
     2015       .
     2016       run diasize_set-height in this-procedure
     2017         (input  v-diasize-orig-frame-height
     2018         ,input  true
     2019         ) .
     2020       run diasize_set-width in this-procedure
     2021         (input  v-diasize-orig-frame-width
     2022         ,input  true
     2023         ) .
     2024     end.
     2025   end procedure.
     2026   procedure diasize_restore-current-size :
     2027     do
     2028     on error undo, return error return-value
     2029     :
     2030       run diasize_set-height in this-procedure
     2031         (input  v-diasize-current-frame-height
     2032         ,input  true
     2033         ) .
     2034       run diasize_set-width in this-procedure
     2035         (input  v-diasize-current-frame-width
     2036         ,input  true
     2037         ) .
     2038     end.
     2039   end procedure.
     2040   procedure diasize_set-browse-handle :
     2041     define input  parameter p-browse-handle as handle   no-undo .
     2042     define buffer buf_temp-browse-handle for temp-browse-handle .
     2043     do
     2044     on error undo, return error return-value
     2045     :
     2046       assign
     2047         v-diasize-browse-handle = p-browse-handle
     2048       .
     2049       for each buf_temp-browse-handle
     2050       on error undo, return error return-value
     2051       :
     2052         delete buf_temp-browse-handle .
     2053       end.
     2054     end.
     2055   end procedure.
     2056   procedure diasize_add_browse :
     2057     define input  parameter p-browse-type   as character no-undo .
     2058     define input  parameter p-browse-handle as handle    no-undo .
     2059     define buffer buf_temp-browse-handle for temp-browse-handle .
     2060     do
     2061     on error undo, return error return-value
     2062     :
     2063       assign
     2064         v-diasize-browse-number = v-diasize-browse-number + 1
     2065       .
     2066       create buf_temp-browse-handle .
     2067       assign
     2068         buf_temp-browse-handle.browse-type   = p-browse-type
     2069         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2070         buf_temp-browse-handle.browse-handle = p-browse-handle
     2071       .
     2072     end.
     2073   end procedure.
     2074   procedure diasize_init :
     2075     define variable v-default-value    as logical   no-undo .
     2076     define variable v-restore-saved    as logical   no-undo .
     2077     define variable v-resize-value-str as character no-undo .
     2078     do
     2079     on error undo, return error return-value
     2080     :
     2081       do with frame Dialog-Frame
     2082       :
     2083         assign
     2084           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2085           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2086           v-diasize-browse-handle     = browse br-goods :handle
     2087         .
     2088         create button v-diasize-resize-button
     2089         assign
     2090           parent        = frame Dialog-Frame :first-child
     2091           label         = "s"
     2092           height-pixels = 16
     2093           width-pixels  = 16
     2094           visible       = true
     2095           sensitive     = true
     2096           movable       = true
     2097           triggers:
     2098             on end-move persistent run diasize_end-move in this-procedure .
     2099           end triggers.
     2100         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2101         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2102         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2103         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2104         assign
     2105           v-diasize-wndmax = false
     2106         .
     2107         if connected("ub") = true
     2108         then do:
     2109           define variable v-cntxt-db-num        as integer   no-undo .
     2110           define variable v-cntxt-userid        as character no-undo .
     2111           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2112                                             , OUTPUT v-cntxt-userid
     2113                                             ) .
     2114           run gbl/wndpar_r.p
     2115             (input  v-cntxt-db-num
     2116             ,input  v-cntxt-userid
     2117             ,input  'wndmax':U
     2118             ,output v-diasize-wndmax
     2119             ,output v-default-value
     2120             ) .
     2121         end.
     2122         assign
     2123           v-diasize-wndstore = false
     2124         .
     2125         if connected("ub") = true
     2126         then do:
     2127           run gbl/wndpar_r.p
     2128             (input  v-cntxt-db-num
     2129             ,input  v-cntxt-userid
     2130             ,input  'wndstore':U
     2131             ,output v-diasize-wndstore
     2132             ,output v-default-value
     2133             ) .
     2134         end.
     2135         assign
     2136           v-diasize-proc-name = entry(1, program-name(2), '.')
     2137         .
     2138         if v-diasize-wndstore = true
     2139         then do:
     2140           assign
     2141             v-restore-saved = false
     2142           .
     2143           if connected("ub") = true
     2144           then do:
     2145             run gbl/wndsizer.p
     2146               (input  v-cntxt-db-num
     2147               ,input  v-cntxt-userid
     2148               ,input  v-diasize-proc-name
     2149               ,input  'height':u
     2150               ,output v-resize-value-str
     2151               ) .
     2152             if v-resize-value-str <> '':U
     2153             then do:
     2154               run diasize_change-height in this-procedure
     2155                 (input  integer(v-resize-value-str)
     2156                 ,input  true
     2157                 ) .
     2158               assign
     2159                 v-restore-saved = true
     2160               .
     2161             end.
     2162           end.
     2163           if connected("ub") = true
     2164           then do:
     2165             run gbl/wndsizer.p
     2166               (input  v-cntxt-db-num
     2167               ,input  v-cntxt-userid
     2168               ,input  v-diasize-proc-name
     2169               ,input  'width':u
     2170               ,output v-resize-value-str
     2171               ) .
     2172             if v-resize-value-str <> '':U
     2173             then do:
     2174               run diasize_change-width in this-procedure
     2175                 (input  integer(v-resize-value-str)
     2176                 ,input  true
     2177                 ) .
     2178               assign
     2179                 v-restore-saved = true
     2180               .
     2181             end.
     2182           end.
     2183           if v-restore-saved <> true
     2184           then do:
     2185             if v-diasize-wndmax = true
     2186             then do:
     2187               run diasize_maximize in this-procedure
     2188                 (input  true
     2189                 ) .
     2190             end.
     2191           end.
     2192         end.
     2193         else do:
     2194           if v-diasize-wndmax = true
     2195           then do:
     2196             run diasize_maximize in this-procedure
     2197               (input  true
     2198               ) .
     2199           end.
     2200         end.
     2201       end.
     2202     end.
     2203   end procedure.
     2204   procedure diasize_need-full-display :
     2205     define output parameter p-need-full-display as logical   no-undo .
     2206     do
     2207     on error undo, return error return-value
     2208     :
     2209       assign
     2210         p-need-full-display = v-diasize-need-full-display
     2211       .
     2212       assign
     2213         v-diasize-need-full-display = false
     2214       .
     2215     end.
     2216   end procedure.
     2217   procedure get-context :
     2218      define output parameter p-db-num as integer          no-undo.
     2219      define output parameter p-user-id as character        no-undo.
     2220      define variable v-login               as character    no-undo.
     2221      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2222      define buffer buf_user-login  for ub.user-login .
     2223      do
     2224      on error undo, return error
     2225      :
     2226            FIND FIRST buf_sys-ctrl no-lock.
     2227            ASSIGN
     2228               v-login = USERID("ub")
     2229               p-db-num = buf_sys-ctrl.db-num
     2230            .
     2231            FIND FIRST buf_user-login
     2232                 WHERE buf_user-login.db-num = p-db-num
     2233                   AND buf_user-login.user-login = v-login
     2234                 no-lock
     2235                 no-error
     2236                 .
     2237            IF AVAILABLE buf_user-login
     2238            THEN DO:
     2239               assign
     2240                  p-user-id = buf_user-login.user-id
     2241               .
     2242            END.
     2243      end.
     2244   end procedure.
     2245   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2246   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2247   MAIN-BLOCK:
     2248   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2249      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2250   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2251     run mainmenu_getcntxt in parparentproc
     2252       (output v-cntxt-db-num
     2253       ,output v-cntxt-userid
     2254       ,output v-cntxt-level
     2255       ,output v-cntxt-host-code-obj
     2256       ,output v-cntxt-obj-type
     2257       ,output v-cntxt-obj-code
     2258       ,output v-cntxt-db-num-obj
     2259       ,output v-cntxt-is-admin
     2260       ) .
     2261     run make-tt-goods in this-procedure .
     2262     run enable_UI in this-procedure .
     2263   run diasize_add_browse in this-procedure
     2264       (input  'width':u
     2265       ,input  browse br-parts :handle
     2266       ) .
     2267   run diasize_init in this-procedure .
     2268   tt-goods.gds-name:resizable in browse BR-goods   = true .
     2269   clients.obj-name:resizable in browse BR-goods   = true .
     2270   tt-goods.grp-name:resizable in browse BR-goods   = true .
     2271     WAIT-FOR GO OF FRAME Dialog-Frame.
     2272   END.
     2273   run disable_UI in this-procedure .
     2274   PROCEDURE disable_UI :
     2275     HIDE FRAME Dialog-Frame.
     2276   END PROCEDURE.
     2277   PROCEDURE enable_UI :
     2278     ENABLE b-ok B-print B-help BR-goods BR-parts B-trn B-trn-2
     2279         WITH FRAME Dialog-Frame.
     2280     VIEW FRAME Dialog-Frame.
     2281     OPEN QUERY BR-goods FOR EACH tt-goods NO-LOCK,              EACH ub.clients WHERE            ub.clients.obj-code = tt-goods.prod-code AND            ub.clients.obj-type = tt-goods.prod-type            OUTER-JOIN NO-LOCK.    OPEN QUERY BR-parts FOR EACH ub.fin-gds-part       WHERE ub.fin-gds-part.fin-ob-code = p-fin-doc-code and ub.fin-gds-part.host-code   = p-host-code and ub.fin-gds-part.gds-code    = tt-goods.gds-code NO-LOCK.
     2282   END PROCEDURE.
     2283   PROCEDURE make-tt-goods :
     2284   ASSIGN frame Dialog-Frame:TITLE =
     2285    "Партии по документу Внутр.№ " + string(p-fin-doc-code)  +
     2286    "   ФИРМА: "  +  string(p-host-code)
     2287    .
     2288   define buffer buf_fin-gds-part for fin-gds-part .
     2289   define buffer buf_goods for goods .
     2290   for each tt-goods : delete tt-goods. end.
     2291   for each buf_fin-gds-part no-lock where
     2292       buf_fin-gds-part.host-code = p-host-code and
     2293       buf_fin-gds-part.fin-ob-code  = p-fin-doc-code :
     2294       if not can-find (first tt-goods where tt-goods.gds-code = buf_fin-gds-part.gds-code ) then do:
     2295         find first buf_goods where buf_goods.gds-code = buf_fin-gds-part.gds-code no-lock no-error .
     2296         if available buf_goods then do:
     2297             create tt-goods.
     2298             BUFFER-COPY buf_goods TO tt-goods .
     2299         end.
     2300       end.
     2301   end.
     2302     tt-goods.gds-type :read-only in browse br-goods = true .
     2303     ub.fin-gds-part.part-code :read-only in browse br-parts = true .
     2304   END PROCEDURE.
     2305   PROCEDURE proc-print :
     2306   do
     2307    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2308    :
     2309   define variable g-log as logical no-undo .
     2310   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2311   do:
     2312     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2313       (input  v-cntxt-db-num
     2314       ,input  v-cntxt-userid
     2315       ,input  0
     2316       ,input  'actn_fin-liability_print':U
     2317       ,input  'firm':U
     2318       ,input  p-host-code
     2319       ,input  '':U
     2320       ,input  0
     2321       ,input  0
     2322       ,input  0
     2323       ,input  0
     2324       ,input  true
     2325       ,output g-log
     2326       )  .
     2327   end.
     2328   if not g-log then  return .
     2329   def var date_string     as      char    no-undo.
     2330   def var Line                as      char    no-undo.
     2331   def var for-time as char.
     2332   DEFINE FRAME prt-frame
     2333         tt-goods.gds-code      COLUMN-LABEL "Код!товара" FORMAT "999999999":U
     2334         tt-goods.unit-base     COLUMN-LABEL "Ед.!изм." FORMAT "X(3)":U
     2335         tt-goods.gds-name      FORMAT "X(25)":U
     2336         fin-gds-part.status_dop   FORMAT "X(6)":U
     2337         fin-gds-part.out-code  COLUMN-LABEL "№ накл" FORMAT "X(14)":U
     2338         fin-gds-part.fact-date COLUMN-LABEL "Дата!закрытия" FORMAT "99/99/99":U
     2339         fin-gds-part.fact-qnty COLUMN-LABEL "Факт!кол-во" FORMAT "->>,>>>,>>9.999":U
     2340         fin-gds-part.sum-rubl  COLUMN-LABEL "Сумма(руб)" FORMAT "->,>>>,>>>,>>>,>>9.99":U
     2341         fin-gds-part.vat-pc    FORMAT ">9.9<%":U
     2342         fin-gds-part.SLT-pc    FORMAT ">9.9<%":U
     2343         fin-gds-part.obj-code  FORMAT "99999":U
     2344         fin-gds-part.obj-type  FORMAT "X(3)":U
     2345         fin-gds-part.in-code   FORMAT "X(14)":U COLUMN-LABEL "№ док.в парт."
     2346         fin-gds-part.part-code COLUMN-LABEL "№ партии" FORMAT "X(5)":U
     2347         fin-gds-part.user-name COLUMN-LABEL "Создал" FORMAT "X(8)":U
     2348           HEADER  date_string AT 5 format "X(35)"
     2349                       string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER( PrnLibStream) AT 70 FORMAT ">>>>9" SKIP
     2350                       Line format "X(165)" AT 1
     2351       with width 232 down stream-io use-text    .
     2352       Line = fill("-", 225).
     2353       date_string = cur-time-print() .
     2354       run prn-lib-open-stream  in this-procedure (
     2355          input parParentProc
     2356         ,input 43
     2357         ,input yes
     2358         ,input no
     2359         ).
     2360       PUT  STREAM PrnLibStream
     2361       SPACE(25) ( frame Dialog-Frame:title )
     2362       format "x(116)" SKIP(1) .
     2363       FORM HEADER
     2364               Line format "X(177)" AT 1 SKIP
     2365               "Продолжение - на следующей странице" AT 30 SKIP
     2366               with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2367       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2368       FORM with FRAME prt-frame  .
     2369       run waitfram-show in this-procedure ("Ждите...").
     2370       find first tt-goods no-lock no-error .
     2371        for each tt-goods
     2372            on error undo, return error :
     2373               OPEN QUERY BR-parts FOR EACH ub.fin-gds-part       WHERE ub.fin-gds-part.fin-ob-code = p-fin-doc-code and ub.fin-gds-part.host-code   = p-host-code and ub.fin-gds-part.gds-code    = tt-goods.gds-code NO-LOCK.
     2374               DO WHILE available fin-gds-part :
     2375                   Display STREAM PrnLibStream
     2376                     tt-goods.gds-code
     2377                     tt-goods.unit-base
     2378                     tt-goods.gds-name
     2379                     fin-gds-part.status_dop
     2380                     fin-gds-part.out-code
     2381                     fin-gds-part.fact-date
     2382                     fin-gds-part.fact-qnty
     2383                     fin-gds-part.sum-rubl
     2384                     fin-gds-part.vat-pc
     2385                     fin-gds-part.SLT-pc
     2386                     fin-gds-part.obj-code
     2387                     fin-gds-part.obj-type
     2388                     fin-gds-part.in-code
     2389                     fin-gds-part.part-code
     2390                     fin-gds-part.user-name
     2391                       with FRAME prt-frame .
     2392                       DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     2393                       GET next br-parts.
     2394                 END.
     2395        end.
     2396         UNDERLINE  STREAM PrnLibStream
     2397              tt-goods.gds-code
     2398              tt-goods.unit-base
     2399              tt-goods.gds-name
     2400              fin-gds-part.status_dop
     2401              fin-gds-part.out-code
     2402              fin-gds-part.fact-date
     2403              fin-gds-part.fact-qnty
     2404              fin-gds-part.sum-rubl
     2405              fin-gds-part.vat-pc
     2406              fin-gds-part.SLT-pc
     2407              fin-gds-part.obj-code
     2408              fin-gds-part.obj-type
     2409              fin-gds-part.in-code
     2410              fin-gds-part.part-code
     2411              fin-gds-part.user-name
     2412       with FRAME prt-frame .
     2413       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     2414       HIDE  STREAM PrnLibStream FRAME CheckList.
     2415       output  STREAM PrnLibStream CLOSE.
     2416       run waitfram-hide in this-procedure .
     2417       run prn-lib-prn-file in this-procedure (
     2418           input parParentProc
     2419          ,input 8
     2420           ).
     2421    end.
     2422   end procedure.
     2423   PROCEDURE show-gds :
     2424   do
     2425    on error undo, return error return-value
     2426    :
     2427     define buffer buf_goods for goods.
     2428     def var gds-rec as recid no-undo.
     2429     if not available tt-goods then  return no-apply.
     2430     find first buf_goods where buf_goods.gds-code = tt-goods.gds-code no-lock no-error .
     2431     if not available buf_goods then  return no-apply.
     2432     gds-rec = recid (Buf_goods).
     2433     find first shop where shop.host-code = p-host-code  no-lock no-error .
     2434     if available shop then
     2435        run str/showgds.p ( input parparentproc
     2436                           ,input ?
     2437                           ,input buf_goods.gds-code
     2438                           ,input 'ПРОСМОТР':U ).
     2439     apply "entry" to br-goods in frame Dialog-Frame.
     2440   end.
     2441   END PROCEDURE.
