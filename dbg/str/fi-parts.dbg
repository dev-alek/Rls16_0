      533   define variable v-waitfram-action01         as character   no-undo .
      534   define variable v-waitfram-action02         as character   no-undo .
      535   define variable v-waitfram-action03         as character   no-undo .
      536   define variable mWaitFramTextBeg            as character   no-undo.
      537   define variable mWaitFramTextEnd            as character   no-undo.
      538   define variable mWaitFramView               as logical     no-undo.
      539   define variable mWaitProcEvent              as logical     no-undo init yes.
      540   define variable mWaitFramInterval           as integer     no-undo init 1 .
      541   define variable mWaitFramStop               as logical     no-undo.
      542   define variable mWaitFramStopUser           as logical     no-undo.
      543   define variable mWaitFramStopTimeOut        as logical     no-undo.
      544   define variable mWaitFramStartProc          as datetime-tz no-undo.
      545   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      546   define button B-WaitFramStop auto-end-key
      547        label "Стоп"
      548        size 10 by 1 tooltip "Остоновить процесс".
      549   define button B-viewProcInfo
      550        label "Информация"
      551        size 15 by 1 tooltip "Информация о процесс".
      552   define frame waitfram
      553     v-waitfram-action01 format "x(72)" no-label skip
      554     v-waitfram-action02 format "x(72)" no-label skip
      555     v-waitfram-action03 format "x(72)" no-label skip
      556     B-viewProcInfo
      557     B-WaitFramStop at row 4 col 30
      558     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      559     .
      560   define new global shared variable mBatchMode as logical no-undo init ?.
      561   define variable mFramBachModHandle as handle no-undo.
      562   mFramBachModHandle = frame waitfram:handle.
      563   define variable mFameOldVis as logical no-undo.
      564   define variable mVisCUrentVin as logical no-undo.
      565   if session:batch-mode
      566   then
      567      mBatchMode = yes.
      568   if mBatchMode = ? then do:
      569     mVisCUrentVin = current-window:visible.
      570     mFameOldVis = mFramBachModHandle:visible.
      571     mFramBachModHandle:visible  = yes.
      572     mBatchMode = mFramBachModHandle:visible ne yes.
      573     mFramBachModHandle:visible = mFameOldVis.
      574     current-window:visible = mVisCUrentVin.
      575   end.
      576    if  log-manager:logfile-name ne ?
      577     then DO:
      578         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      579         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      580         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      581     end.
      582   on choose of B-WaitFramStop in frame waitfram
      583   do:
      584     mWaitFramStop = yes.
      585     mWaitFramStopUser = yes.
      586   end.
      587   function waitfram-check-timeout returns logical():
      588      define variable vtime as int64 no-undo.
      589      if mWaitFramStopTimeOut
      590      then
      591         return yes.
      592      vtime = ( now - mWaitFramStartProc ) / 1000 .
      593      if     mWaitFramTimeOut ne ?
      594         and mWaitFramTimeOut ne 0
      595         and mWaitFramTimeOut lt vtime
      596      then do:
      597         mWaitFramStopTimeOut = yes.
      598      end.
      599      return mWaitFramStopTimeOut.
      600   end.
      601   procedure waitfram-hide :
      602     if not session:batch-mode
      603     then do
      604     on error undo, return error return-value
      605     :
      606       pause 0 before-hide .
      607       if not mBatchMode then
      608         hide frame waitfram .
      609     if     not mWaitFramView
      610        and mWaitProcEvent
      611     then
      612       process events .
      613     end.
      614   end procedure.
      615   procedure waitfram-show :
      616     define input  parameter p-message as character no-undo .
      617     define variable v-left-margin as integer   no-undo .
      618     if not session:batch-mode
      619     then do
      620     on error undo, return error return-value
      621     :
      622       if length(p-message) <= 70 then do:
      623         assign
      624           v-left-margin = integer((70 - length(p-message)) / 2)
      625         .
      626         assign
      627           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      628         .
      629         assign
      630           v-waitfram-action01 = " "
      631           v-waitfram-action02 = " "
      632                                    + fill(" ", v-left-margin)
      633                                    + p-message
      634           v-waitfram-action03 = " "
      635         .
      636       end.
      637       else do:
      638         define variable vRindex1 as integer no-undo.
      639         define variable vRindex2 as integer no-undo.
      640         vRindex1 = r-index(p-message," ",70).
      641         if vRindex1 = 0
      642         then
      643            vRindex1 = 70.
      644         if length(p-message)  <= vRindex1 + 70 then do:
      645           assign
      646             v-waitfram-action01 = " "
      647             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      648             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      649           .
      650         end.
      651         else do:
      652           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      653           if vRindex2 <= vRindex1
      654           then
      655              vRindex2 = vRindex1 + 70.
      656           assign
      657             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      658             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      659             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      660           .
      661         end.
      662       end.
      663       B-viewProcInfo:visible   in frame waitfram = no.
      664       B-viewProcInfo:sensitive in frame waitfram = no.
      665       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      666       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      667       if  (   mWaitFramView
      668          or  mWaitProcEvent)
      669          and not mBatchMode
      670       then
      671          display
      672             v-waitfram-action01 skip
      673             v-waitfram-action02 skip
      674             v-waitfram-action03 skip
      675          with frame waitfram .
      676       if     mWaitFramView
      677          then do:
      678             if     mWaitFramInterval ne ?
      679                and not mBatchMode
      680             then
      681                wait-for go of frame waitfram pause mWaitFramInterval.
      682          end.
      683          else
      684             if     mWaitProcEvent
      685                and not mBatchMode
      686             then
      687                process events .
      688     end.
      689   end procedure.
      690      procedure waitfram-show-this:
      691         define input  parameter iInterval as int64 no-undo.
      692         define variable vtime as int64 no-undo.
      693         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      694         mWaitFramInterval = iInterval.
      695         run waitfram-show (substitute("&1&2 &3&4" ,
      696                                       mWaitFramTextBeg ,
      697                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      698                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      699                                       mWaitFramTextEnd
      700                                      )
      701                           ).
      702      end.
      703      procedure WaitFramRunPause:
      704         define input  parameter iInterval as dec no-undo.
      705         define variable vStart  as datetime-tz no-undo.
      706         define variable vend    as datetime-tz no-undo.
      707         define variable vint as int64 no-undo.
      708         define variable vOk as logical no-undo.
      709         vStart = now.
      710         vend   = vStart.
      711         publish "WaitFramPause" (iInterval,output vOk).
      712         vend   =  now.
      713         vint = vend - vStart.
      714         vint = iInterval - vint / 1000.
      715         if     not mWaitFramStop
      716            and (   vint > 0
      717                 or (    not vOk
      718                     and iInterval eq ?
      719                     )
      720                 )
      721         then
      722            run waitfram-show-this (iInterval).
      723         vend   =  now.
      724         vint = vend - vStart.
      725         vint = iInterval - vint / 1000.
      726         if     not mWaitFramStop
      727            and vint > 0
      728         then do:
      729            run gbl/pause.p (vint * 1000).
      730         end.
      731         if iInterval ne ?
      732         then
      733            publish "WaitFramStop".
      734         waitfram-check-timeout().
      735      end.
      736      procedure WaitFramWaitFor:
      737         define input  parameter iInterval as dec no-undo.
      738         assign
      739            mWaitFramStartProc   = now
      740            mWaitFramStopUser    = no
      741            mWaitFramStopTimeOut = no
      742         .
      743         block-wait:
      744         do while not mWaitFramStop:
      745            run WaitFramRunPause (iInterval).
      746            if  waitfram-check-timeout()
      747            then do:
      748               leave block-wait.
      749            end.
      750         end.
      751         run waitfram-hide.
      752      end.
      753   procedure waitfram-join :
      754     define input  parameter p-line-1  as character no-undo .
      755     define input  parameter p-line-2  as character no-undo .
      756     define input  parameter p-line-3  as character no-undo .
      757     define output parameter p-message as character no-undo .
      758     do
      759     on error undo, return error return-value
      760     :
      761       assign
      762         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      763                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      764                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      765       .
      766     end.
      767   end procedure.
      768   function waitfram-join-function returns character
      769     (input p-line-1 as character
      770     ,input p-line-2 as character
      771     ,input p-line-3 as character
      772     ).
      773     define variable v-message as character no-undo .
      774     run waitfram-join in this-procedure
      775       (input  p-line-1
      776       ,input  p-line-2
      777       ,input  p-line-3
      778       ,output v-message
      779       ) .
      780     return v-message .
      781   end function .
      782   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783     define variable v-cntxt-db-num        as integer   no-undo .
      784     define variable v-cntxt-userid        as character no-undo .
      785     define variable v-cntxt-level         as character no-undo .
      786     define variable v-cntxt-host-code-obj as integer   no-undo .
      787     define variable v-cntxt-obj-type      as character no-undo .
      788     define variable v-cntxt-obj-code      as integer   no-undo .
      789     define variable v-cntxt-db-num-obj    as integer   no-undo .
      790     define variable v-cntxt-is-admin      as logical   no-undo .
      791   DEFINE INPUT PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
      792   define input parameter p-fin-doc-code like fin-ob.doc-code no-undo.
      793   define input parameter p-host-code    like fin-ob.host-code no-undo.
      794   DEFINE NEW SHARED BUFFER bufs_ord-doc-rcv FOR ub.ord-doc-rcv.
      795   define NEW SHARED  buffer  loc-doc-rcv   for ord-doc-rcv.
      796   define NEW SHARED  variable br-rcv-handle as handle no-undo   .
      797   define NEW SHARED  variable x-make-avto   as integer no-undo .
      798   DEFINE BUTTON B-help DEFAULT
      799        LABEL "Помо&щь"
      800        SIZE 10 BY 1
      801        BGCOLOR 8 .
      802   DEFINE BUTTON b-ok AUTO-END-KEY
      803        LABEL "&Выход"
      804        SIZE 10 BY 1.
      805   DEFINE BUTTON B-print DEFAULT
      806        LABEL "&Печать"
      807        SIZE 10 BY 1
      808        BGCOLOR 8 .
      809   DEFINE BUTTON B-trn DEFAULT
      810        LABEL "&Документ"
      811        SIZE 10 BY 1 TOOLTIP "Просмотр документа "
      812        BGCOLOR 8 .
      813   DEFINE BUTTON B-trn-2 DEFAULT
      814        LABEL "&Исх накл."
      815        SIZE 10 BY 1 TOOLTIP "Просмотр порождающей  накладной"
      816        BGCOLOR 8 .
      817   DEFINE QUERY BR-goods FOR
      818         tt-goods,
      819         clients SCROLLING.
      820   DEFINE QUERY BR-parts FOR
      821         ub.fin-gds-part SCROLLING.
      822   DEFINE BROWSE BR-goods
      823     QUERY BR-goods NO-LOCK DISPLAY
      824         tt-goods.gds-type COLUMN-LABEL "Т! " FORMAT "X(1)":U
      825         tt-goods.gds-code COLUMN-LABEL "Код!товара" FORMAT "999999999":U
      826         tt-goods.artic FORMAT "X(16)":U
      827         tt-goods.unit-base COLUMN-LABEL "Ед.!изм." FORMAT "X(3)":U
      828         tt-goods.unit-cli COLUMN-LABEL "Ед.из!пост." FORMAT "X(3)":U
      829         tt-goods.gds-name FORMAT "X(48)":U
      830         ub.clients.obj-name COLUMN-LABEL "Производитель! " FORMAT "X(20)":U
      831         tt-goods.grp-name FORMAT "X(40)":U
      832     ENABLE
      833         tt-goods.gds-type
      834       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.13 BY 8.21 ROW-HEIGHT-CHARS .6.
      835   DEFINE BROWSE BR-parts
      836     QUERY BR-parts NO-LOCK DISPLAY
      837         ub.fin-gds-part.out-code  COLUMN-LABEL "№ накл" FORMAT "X(14)":U
      838         ub.fin-gds-part.fact-date COLUMN-LABEL "Дата!закрытия" FORMAT "99/99/99":U
      839         ub.fin-gds-part.fact-qnty COLUMN-LABEL "Факт!кол-во" FORMAT "->>,>>>,>>9.999":U
      840         ub.fin-gds-part.sum-rubl  COLUMN-LABEL "Сумма в!нац.вал."  FORMAT "->,>>>,>>>,>>>,>>9.99":U
      841         ub.fin-gds-part.vat-pc   FORMAT ">9.9<%":U
      842         ub.fin-gds-part.vat-type FORMAT "X(8)":U
      843         ub.fin-gds-part.SLT-pc   FORMAT ">9.9<%":U
      844         ub.fin-gds-part.SLT-type FORMAT "X(8)":U
      845         ub.fin-gds-part.in-code  FORMAT "X(14)":U
      846         ub.fin-gds-part.obj-code FORMAT "99999":U
      847         ub.fin-gds-part.obj-type FORMAT "X(3)":U
      848         ub.fin-gds-part.sum-base COLUMN-LABEL "Сумма!баз.вал." FORMAT "->,>>>,>>>,>>>,>>9.99":U
      849         ub.fin-gds-part.part-code COLUMN-LABEL "№ партии" FORMAT "X(5)":U
      850     ENABLE
      851         ub.fin-gds-part.part-code
      852       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.13 BY 9.42
      853            TITLE "Партии товара" ROW-HEIGHT-CHARS .6.
      854   DEFINE FRAME Dialog-Frame
      855        b-ok AT ROW 1 COL 1
      856        B-print AT ROW 1 COL 78
      857        B-help AT ROW 1 COL 88
      858        BR-goods AT ROW 2.04 COL 1
      859        BR-parts AT ROW 10.33 COL 1
      860        B-trn AT ROW 19.92 COL 1.25
      861        B-trn-2 AT ROW 19.92 COL 87.63
      862        SPACE(0.62) SKIP(0.24)
      863       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      864            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      865            TITLE "Партии документа".
      866   ASSIGN
      867          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      868          FRAME Dialog-Frame:HIDDEN           = TRUE.
      869   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      870   DO:
      871     APPLY "END-ERROR":U TO SELF.
      872   END.
      873   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      874   DO:
      875     run proc-print in this-procedure .
      876     OPEN QUERY BR-goods FOR EACH tt-goods NO-LOCK,              EACH ub.clients WHERE            ub.clients.obj-code = tt-goods.prod-code AND            ub.clients.obj-type = tt-goods.prod-type            OUTER-JOIN NO-LOCK.    OPEN QUERY BR-parts FOR EACH ub.fin-gds-part       WHERE ub.fin-gds-part.fin-ob-code = p-fin-doc-code and ub.fin-gds-part.host-code   = p-host-code and ub.fin-gds-part.gds-code    = tt-goods.gds-code NO-LOCK.
      877   END.
      878   ON CHOOSE OF B-trn IN FRAME Dialog-Frame
      879   DO:
      880   define buffer buf-ord-doc     for ub.ord-doc  .
      881   define buffer buf-ord-doc-rcv for ub.ord-doc-rcv  .
      882   define buffer buf_fin-ob-trn  for ub.fin-ob-trn  .
      883   define variable vv-r as recid no-undo .
      884   define buffer buf-add-doc for ub.add-doc  .
      885   define variable v-recid as recid no-undo .
      886     if available fin-gds-part and  fin-gds-part.out-code <> "" then do:
      887     find first buf_fin-ob-trn no-lock where
      888                buf_fin-ob-trn.doc-code     = fin-gds-part.fin-ob-code and
      889                buf_fin-ob-trn.trn-doc-code = fin-gds-part.out-code
      890                no-error .
      891     if not available buf_fin-ob-trn then return .
      892      case buf_fin-ob-trn.doc-type :
      893           when "add" then do:
      894               find first buf-add-doc no-lock where buf-add-doc.doc-code = fin-gds-part.out-code no-error .
      895               if available buf-add-doc then  do:
      896                   v-recid = recid(buf-add-doc) .
      897                   run str/add-docu.w ( input parparentproc  ,
      898                                        input-output v-recid ,
      899                                        input 'ПРОСМОТР':U      ,
      900                                        input ?              ).
      901               end.
      902           end.
      903           when "order" then do:
      904               find first buf-ord-doc no-lock where buf-ord-doc.doc-code = fin-gds-part.out-code no-error .
      905               if available buf-ord-doc then
      906                   run cus/show-ord.p ( ParParentProc , recid(buf-ord-doc)) .
      907           end.
      908           when "rcv" then do:
      909               find first buf-ord-doc-rcv no-lock where buf-ord-doc-rcv.rcv-code = fin-gds-part.out-code no-error .
      910               if available buf-ord-doc-rcv then do:
      911                  vv-r = recid(buf-ord-doc-rcv) .
      912                  run cus/lkp-rcv.w
      913                     ( ParParentProc ,
      914                       input-output vv-r
      915                       ).
      916                end.
      917           end.
      918           when "" then do:
      919               run str/fishdoc.p
      920                 ( ParParentProc,
      921                   fin-gds-part.host-code ,
      922                   fin-gds-part.obj-type,
      923                   fin-gds-part.obj-code,
      924                   fin-gds-part.out-code ,
      925                   fin-gds-part.gds-code
      926                   ) .
      927           end.
      928      end case.
      929   end.
      930   END.
      931   ON CHOOSE OF B-trn-2 IN FRAME Dialog-Frame
      932   DO:
      933   define buffer buf_parts-attr for parts-attr.
      934     if available fin-gds-part and  fin-gds-part.in-code <> "" then do:
      935        find first buf_parts-attr no-lock where
      936                   buf_parts-attr.in-code      = fin-gds-part.in-code  and
      937                   buf_parts-attr.part-code    = fin-gds-part.part-code and
      938                   buf_parts-attr.gds-code     = fin-gds-part.gds-code
      939                   no-error .
      940                   if available buf_parts-attr then
      941                       run str/fishdoc.p
      942                               ( ParParentProc,
      943                                 fin-gds-part.host-code ,
      944                                 fin-gds-part.obj-type,
      945                                 fin-gds-part.obj-code,
      946                                 buf_parts-attr.income-in-code ,
      947                                 fin-gds-part.gds-code
      948                                 ) .
      949                       else
      950                       run str/fishdoc.p
      951                               ( ParParentProc,
      952                                 fin-gds-part.host-code ,
      953                                 fin-gds-part.obj-type,
      954                                 fin-gds-part.obj-code,
      955                                 fin-gds-part.in-code ,
      956                                 fin-gds-part.gds-code
      957                                 ) .
      958   end.
      959   END.
      960   ON VALUE-CHANGED OF BR-goods IN FRAME Dialog-Frame
      961   DO:
      962     OPEN QUERY BR-parts FOR EACH ub.fin-gds-part       WHERE ub.fin-gds-part.fin-ob-code = p-fin-doc-code and ub.fin-gds-part.host-code   = p-host-code and ub.fin-gds-part.gds-code    = tt-goods.gds-code NO-LOCK.
      963   END.
      964   on F9 of frame dialog-frame anywhere do:
      965     run show-gds in this-procedure  .
      966     return no-apply.
      967   END.
      968   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      969   on help of frame Dialog-Frame
      970   do:
      971     run gbl/app_help.p
      972       (input this-procedure :file-name
      973       ,input ''
      974       ,input ?
      975       ) no-error.
      976     if error-status :error then do:
      977       message
      978         "Ошибка при вызове помощи"
      979         error-status :get-message(1)
      980         view-as alert-box .
