        1   DEFINE TEMP-TABLE tt-goods NO-UNDO LIKE ub.goods.
        2   def var vss-revision    as character no-undo init "$Revision$":U .
        3   def var vss-author      as character no-undo init "$Author$":U .
        4   def var vss-date        as character no-undo init "$Date$":U .
        5   def var vss-workfile    as character no-undo init "$Workfile$":U .
        6   def var vss-archive     as character no-undo init "$Archive$":U .
        7   def var vss-description as character no-undo init "Просмотр партий по документу фин.обязательств ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      124   define new shared variable RepPathName        as character no-undo .
      125   define new shared variable PrintRubl          as logical   no-undo .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define  stream PrnLibStream.
      128   procedure prn-lib-prn-file :
      129     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      130     define input parameter p-DIsabledoptions as integer no-undo .
      131     define variable v-report-name as character no-undo .
      132     define variable v-user-action as character no-undo .
      133     define variable v-printed     as logical   no-undo .
      134     define variable v-exist       as logical   no-undo .
      135     do
      136       on error undo, return error
      137       :
      138       run prn-lib-get-report-name  in this-procedure (
      139         input parParentProc
      140         ,output v-report-name
      141         ).
      142   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      143   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      144     (input  v-report-name
      145     ,input  2
      146     ,output v-exist
      147     )  .
      148       if NOT v-exist then
      149       DO:
      150         Message
      151           "Нет заданий на печать ! "
      152           view-as alert-box .
      153         Return  .
      154       End.
      155       run gbl/prnfilen.w
      156         (input  ""
      157         ,input  p-DisabledOptions
      158         ,input  string(v-report-name )
      159         ,input  7
      160         ,output v-user-action
      161         ,output v-printed
      162         ) .
      163       if v-printed then
      164       do:
      165         return "YES" .
      166       end.
      167       else
      168       do:
      169         return "NO" .
      170       end.
      171     end.
      172   end procedure.
      173   procedure prn-lib-open-stream :
      174     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      175     define input parameter p-page-size    as integer no-undo .
      176     define input parameter p-is-stream    as logical no-undo .
      177     define input parameter p-append       as logical no-undo .
      178     define variable v-report-name as character no-undo .
      179     do
      180       on error undo, return error
      181       :
      182       run prn-lib-get-report-name  in this-procedure (
      183         input parParentProc
      184         ,output v-report-name
      185         ).
      186       if p-is-stream then
      187       do:
      188         if p-append then
      189         do:
      190           output stream PrnLibStream to value( v-report-name )
      191             page-size value(p-page-size) append .
      192         end.
      193         if not p-append then
      194         do:
      195           output stream PrnLibStream to value( v-report-name )
      196             page-size value(p-page-size) .
      197         end.
      198       end.
      199       if not p-is-stream then
      200       do:
      201         if p-append then
      202         do:
      203           output to value( v-report-name )
      204             page-size value(p-page-size) append .
      205         end.
      206         if not p-append then
      207         do:
      208           output to value( v-report-name )
      209             page-size value(p-page-size) .
      210         end.
      211       end.
      212     end.
      213   end procedure.
      214   procedure prn-lib-open-exp :
      215     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      216     define input parameter p-is-stream    as logical no-undo .
      217     define input parameter p-is-append    as logical no-undo .
      218     define output parameter p-ReportFileName as char init "report" no-undo.
      219     define output parameter p-process as logical no-undo .
      220     define variable glog as logical no-undo .
      221     do
      222       on error undo, return error
      223       :
      224       SYSTEM-DIALOG GET-FILE p-ReportFileName
      225         TITLE      "Укажите путь"
      226         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      227         ASK-OVERWRITE
      228         CREATE-TEST-FILE
      229         SAVE-AS
      230         USE-FILENAME
      231         DEFAULT-EXTENSION "txt"
      232         UPDATE glog
      233         .
      234       if not glog then  return.
      235       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      236       if p-is-stream then
      237       do:
      238         if p-is-append then
      239         do:
      240           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      241         end.
      242         else
      243         do:
      244           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      245         end.
      246       end.
      247       else
      248       do:
      249         if p-is-append then
      250         do:
      251           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      252         end.
      253         else
      254         do:
      255           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      256         end.
      257       end.
      258       p-process = yes.
      259     end.
      260   end procedure.
      261   procedure prn-lib-get-report-name :
      262     define input parameter parParentProc  as widget-handle no-undo.
      263     define output parameter p-report-name as character no-undo .
      264     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      265   end procedure.
      266   procedure prn-lib-reportviewer-report-name :
      267     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      268     define input parameter p-report-name-html as character no-undo .
      269     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      270   end procedure.
      271   procedure prn-lib-reportviewer :
      272     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      273     define input parameter p-report-name-html as character no-undo .
      274     define input parameter p-param        as character no-undo .
      275     define variable v-excel           as character no-undo init 'TRUE' .
      276     define variable v-value-character as character no-undo .
      277     define variable v-value-integer   as character no-undo .
      278     define variable v-value-date      as date      no-undo .
      279     define variable v-value-decimal   as decimal   no-undo .
      280     define variable rep-excel         as logical   no-undo .
      281     define variable excel-string      as character no-undo .
      282     define variable v-param-type      as character no-undo .
      283     define variable v-tth             as handle    no-undo .
      284     run adm/shattri.p (
      285       input "get":U
      286       ,input  ""
      287       ,input  0
      288       ,input  'report-glob':U
      289       ,input  'rep-excel':U
      290       ,output v-value-character
      291       ,output v-value-date
      292       ,output v-value-decimal
      293       ,output v-value-integer
      294       ,output rep-excel
      295       ,output v-param-type
      296       ,INPUT-OUTPUT table-handle v-tth
      297       )  .
      298     if rep-excel then v-excel = "TRUE" .
      299     else v-excel = "FALSE" .
      300     if p-param eq ""
      301     then
      302        p-param = "EXCEL:" + v-excel.
      303     else
      304        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      305     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      306   end procedure.
      307   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   procedure cur-time :
      309      define output parameter p-today as date      no-undo .
      310      define output parameter p-time  as integer   no-undo .
      311     do
      312     on error undo, return error
      313     :
      314       define variable v-date1 as date      no-undo .
      315       define variable v-date2 as date      no-undo .
      316       define variable v-time  as integer   no-undo .
      317       assign
      318         v-date1 = today
      319         v-time  = time
      320         v-date2 = today
      321       .
      322       if v-date1 <> v-date2
      323       then do:
      324         assign
      325           v-date1 = today
      326           v-time  = v-time
      327         .
      328       end.
      329       assign
      330         p-today = v-date1
      331         p-time  = v-time
      332       .
      333     end.
      334   end.
      335   function cur-time-date returns character
      336   :
      337     return string(today, '99/99/9999':U) .
      338   end.
      339   function cur-time-mjd returns decimal
      340   :
      341     define variable v-date as date      no-undo .
      342     define variable v-time as integer   no-undo .
      343     run cur-time in this-procedure
      344       (output v-date
      345       ,output v-time
      346       ) .
      347     return integer(v-date) - 2400002 + (v-time / 86400) .
      348   end.
      349   function cur-time-get-ending-index returns integer
      350   (input p-number as integer
      351   )
      352   :
      353     if p-number < 0
      354     or p-number = ?
      355     then do:
      356       return 1 .
      357     end.
      358     define variable v-rest as integer   no-undo .
      359     assign
      360       p-number = p-number modulo 100
      361     .
      362     if p-number < 20
      363     then do:
      364       assign
      365         v-rest = p-number
      366       .
      367     end.
      368     else do:
      369       assign
      370         v-rest = p-number modulo 10
      371       .
      372     end.
      373     case v-rest :
      374       when 1
      375       then do:
      376         return 2 .
      377       end.
      378       when 2 or
      379       when 3 or
      380       when 4
      381       then do:
      382         return 3 .
      383       end.
      384       otherwise do:
      385         return 1 .
      386       end.
      387     end case .
      388   end.
      389   procedure cur-time-mjd-to-date :
      390      define input  parameter i-mjd-diff as decimal no-undo.
      391      define output parameter o-Date     as date    no-undo.
      392      define output parameter o-Time     as integer no-undo.
      393      define variable v-day-number as integer   no-undo .
      394      if    i-mjd-diff < 0
      395         or i-mjd-diff = ?
      396      then do:
      397         return "?" .
      398      end.
      399      assign
      400         v-day-number = truncate(i-mjd-diff,0).
      401         o-Date = date(v-day-number + 2400002).
      402         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      403     .
      404   end.
      405   function cur-time-mjd-to-string returns character
      406   (input p-mjd-diff as decimal
      407   )
      408   :
      409     define variable v-day-number as integer   no-undo .
      410     define variable v-seconds    as integer   no-undo .
      411     define variable v-hour       as integer   no-undo .
      412     define variable v-min        as integer   no-undo .
      413     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      414     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      415     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      416     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      417     if p-mjd-diff < 0
      418     or p-mjd-diff = ?
      419     then do:
      420       return "?" .
      421     end.
      422     assign
      423       v-day-number = integer(truncate(p-mjd-diff,0))
      424       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      425     .
      426     if v-seconds > 86400
      427     then do:
      428       assign
      429         v-seconds = 86400 - 1
      430       .
      431     end.
      432     if v-seconds < 0
      433     then do:
      434       assign
      435         v-seconds = 0
      436       .
      437     end.
      438     assign
      439       v-hour = truncate(v-seconds / 3600, 0)
      440     .
      441     assign
      442       v-seconds = v-seconds modulo 3600
      443     .
      444     assign
      445       v-min = truncate(v-seconds / 60, 0)
      446     .
      447     assign
      448       v-seconds = v-seconds modulo 60
      449     .
      450     return
      451         (if v-day-number <> 0
      452           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      453           else ""
      454         )
      455       + (if v-day-number <> 0 or v-hour <> 0
      456           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      457           else ""
      458         )
      459       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      460           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      461           else ""
      462         )
      463       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      464       .
      465   end.
      466   function cur-time-string returns character
      467   :
      468     define variable v-date as date      no-undo .
      469     define variable v-time as integer   no-undo .
      470     run cur-time in this-procedure
      471       (output v-date
      472       ,output v-time
      473       ) .
      474     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      475   end.
      476   function cur-time-string-sec returns character
      477   :
      478     define variable v-date as date      no-undo .
      479     define variable v-time as integer   no-undo .
      480     run cur-time in this-procedure
      481       (output v-date
      482       ,output v-time
      483       ) .
      484     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      485   end.
      486   function cur-time-custom  returns character
      487   (input p-prefix as character
      488   ,input p-date-format as character
      489   ,input p-delimiter as character
      490   ,input p-time-format as character
      491   ,input p-suffix as character
      492   )
      493   :
      494     define variable v-date as date      no-undo .
      495     define variable v-time as integer   no-undo .
      496     run cur-time in this-procedure
      497       (output v-date
      498       ,output v-time
      499       ) .
      500     return
      501       p-prefix
      502       + string(v-date, p-date-format)
      503       + p-delimiter
      504       + string(v-time, p-time-format)
      505       + p-suffix
      506       .
      507   end.
      508   function cur-time-print  returns character
      509   :
      510     define variable v-date as date      no-undo .
      511     define variable v-time as integer   no-undo .
      512     run cur-time in this-procedure
      513       (output v-date
      514       ,output v-time
      515       ) .
      516     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      517   end.
      518   function cur-time-datetime returns datetime
      519   :
      520     define variable v-char as character no-undo .
      521     define variable v-datetime as datetime no-undo .
      522     v-char = cur-time-string().
      523     v-datetime = datetime(v-char).
      524     return  v-datetime.
      525   end.
      526   function cur-time-string-msec returns character
      527   :
      528     define variable v-date as datetime  no-undo .
      529     v-date = now.
      530     return string(v-date) .
      531   end.
