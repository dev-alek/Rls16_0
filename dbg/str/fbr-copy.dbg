        1   block-level on error undo, throw.
        2   define input parameter parparentproc            as handle           no-undo.
        3   define input parameter p-fbr-doc-doc-code       as character        no-undo.
        4   define input parameter p-trn-doc-doc-code       as character        no-undo.
        5   define input parameter p-fbr-doc-obj-type       as character        no-undo.
        6   define input parameter p-fbr-doc-obj-code       as integer          no-undo.
        7   define input parameter p-price-sale-obj-type    as character        no-undo.
        8   define input parameter p-price-sale-obj-code    as integer          no-undo.
        9   define input parameter p-fbrhist-handle         as handle           no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Копирование накладной в документ производства.".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
       87   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
       88     field cst-code                like ub.trn-doc.cst-code
       89     field part-code               like ub.parts.part-code
       90     .
       91   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
       92   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
       93   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
       94   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95   procedure cur-time :
       96      define output parameter p-today as date      no-undo .
       97      define output parameter p-time  as integer   no-undo .
       98     do
       99     on error undo, return error
      100     :
      101       define variable v-date1 as date      no-undo .
      102       define variable v-date2 as date      no-undo .
      103       define variable v-time  as integer   no-undo .
      104       assign
      105         v-date1 = today
      106         v-time  = time
      107         v-date2 = today
      108       .
      109       if v-date1 <> v-date2
      110       then do:
      111         assign
      112           v-date1 = today
      113           v-time  = v-time
      114         .
      115       end.
      116       assign
      117         p-today = v-date1
      118         p-time  = v-time
      119       .
      120     end.
      121   end.
      122   function cur-time-date returns character
      123   :
      124     return string(today, '99/99/9999':U) .
      125   end.
      126   function cur-time-mjd returns decimal
      127   :
      128     define variable v-date as date      no-undo .
      129     define variable v-time as integer   no-undo .
      130     run cur-time in this-procedure
      131       (output v-date
      132       ,output v-time
      133       ) .
      134     return integer(v-date) - 2400002 + (v-time / 86400) .
      135   end.
      136   function cur-time-get-ending-index returns integer
      137   (input p-number as integer
      138   )
      139   :
      140     if p-number < 0
      141     or p-number = ?
      142     then do:
      143       return 1 .
      144     end.
      145     define variable v-rest as integer   no-undo .
      146     assign
      147       p-number = p-number modulo 100
      148     .
      149     if p-number < 20
      150     then do:
      151       assign
      152         v-rest = p-number
      153       .
      154     end.
      155     else do:
      156       assign
      157         v-rest = p-number modulo 10
      158       .
      159     end.
      160     case v-rest :
      161       when 1
      162       then do:
      163         return 2 .
      164       end.
      165       when 2 or
      166       when 3 or
      167       when 4
      168       then do:
      169         return 3 .
      170       end.
      171       otherwise do:
      172         return 1 .
      173       end.
      174     end case .
      175   end.
      176   procedure cur-time-mjd-to-date :
      177      define input  parameter i-mjd-diff as decimal no-undo.
      178      define output parameter o-Date     as date    no-undo.
      179      define output parameter o-Time     as integer no-undo.
      180      define variable v-day-number as integer   no-undo .
      181      if    i-mjd-diff < 0
      182         or i-mjd-diff = ?
      183      then do:
      184         return "?" .
      185      end.
      186      assign
      187         v-day-number = truncate(i-mjd-diff,0).
      188         o-Date = date(v-day-number + 2400002).
      189         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      190     .
      191   end.
      192   function cur-time-mjd-to-string returns character
      193   (input p-mjd-diff as decimal
      194   )
      195   :
      196     define variable v-day-number as integer   no-undo .
      197     define variable v-seconds    as integer   no-undo .
      198     define variable v-hour       as integer   no-undo .
      199     define variable v-min        as integer   no-undo .
      200     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      201     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      202     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      203     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      204     if p-mjd-diff < 0
      205     or p-mjd-diff = ?
      206     then do:
      207       return "?" .
      208     end.
      209     assign
      210       v-day-number = integer(truncate(p-mjd-diff,0))
      211       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      212     .
      213     if v-seconds > 86400
      214     then do:
      215       assign
      216         v-seconds = 86400 - 1
      217       .
      218     end.
      219     if v-seconds < 0
      220     then do:
      221       assign
      222         v-seconds = 0
      223       .
      224     end.
      225     assign
      226       v-hour = truncate(v-seconds / 3600, 0)
      227     .
      228     assign
      229       v-seconds = v-seconds modulo 3600
      230     .
      231     assign
      232       v-min = truncate(v-seconds / 60, 0)
      233     .
      234     assign
      235       v-seconds = v-seconds modulo 60
      236     .
      237     return
      238         (if v-day-number <> 0
      239           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      240           else ""
      241         )
      242       + (if v-day-number <> 0 or v-hour <> 0
      243           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      244           else ""
      245         )
      246       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      247           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      248           else ""
      249         )
      250       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      251       .
      252   end.
      253   function cur-time-string returns character
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      262   end.
      263   function cur-time-string-sec returns character
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      272   end.
      273   function cur-time-custom  returns character
      274   (input p-prefix as character
      275   ,input p-date-format as character
      276   ,input p-delimiter as character
      277   ,input p-time-format as character
      278   ,input p-suffix as character
      279   )
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return
      288       p-prefix
      289       + string(v-date, p-date-format)
      290       + p-delimiter
      291       + string(v-time, p-time-format)
      292       + p-suffix
      293       .
      294   end.
      295   function cur-time-print  returns character
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      304   end.
      305   function cur-time-datetime returns datetime
      306   :
      307     define variable v-char as character no-undo .
      308     define variable v-datetime as datetime no-undo .
      309     v-char = cur-time-string().
      310     v-datetime = datetime(v-char).
      311     return  v-datetime.
      312   end.
      313   function cur-time-string-msec returns character
      314   :
      315     define variable v-date as datetime  no-undo .
      316     v-date = now.
      317     return string(v-date) .
      318   end.
      319   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320     define variable v-cntxt-db-num        as integer   no-undo .
      321     define variable v-cntxt-userid        as character no-undo .
      322     define variable v-cntxt-level         as character no-undo .
      323     define variable v-cntxt-host-code-obj as integer   no-undo .
      324     define variable v-cntxt-obj-type      as character no-undo .
      325     define variable v-cntxt-obj-code      as integer   no-undo .
      326     define variable v-cntxt-db-num-obj    as integer   no-undo .
      327     define variable v-cntxt-is-admin      as logical   no-undo .
      328   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329       def var log-file-name as char no-undo.
      330       if search('fbr.log') = ?
      331       then do:
      332           assign
      333               log-file-name = ""
      334           .
      335       end.
      336       else do:
      337           assign
      338               log-file-name = 'fbr.log'
      339           .
      340       end.
      341       DEF STREAM stm-log.
      342       PROCEDURE writelog:
      343       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      344       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      345       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      346       if p-file-name <> ""
      347       then do:
      348       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      349           PUT STREAM stm-log UNFORMATTED chr(10).
      350           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      351                                           OR p-log-string = "&Line") THEN "" ELSE
      352                                           cur-time-string-sec() + " ").
      353           PUT STREAM stm-log UNFORMATTED
      354                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      355                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      356                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      357       OUTPUT STREAM stm-log CLOSE.
      358       end.
      359       END PROCEDURE.
      360   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   define new global shared variable g#trdcalib as handle no-undo.
      362   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   define NEW SHARED temp-table tt0-info no-undo
      364   field doc-code   like ub.trn-doc.doc-code
      365   field artic      like ub.doc-line.artic
      366   field prod-type  like ub.doc-line.prod-type
      367   field prod-code  like ub.doc-line.prod-code
      368   field prt-code  like ub.gds-dtl.prt-code
      369   field obj-type   like ub.doc-line.obj-type
      370   field obj-code   like ub.doc-line.obj-code
      371   field error-message as character
      372   field a-to-res as decimal
      373   field was-res as decimal
      374   field to-res as decimal
      375   field is-res as decimal
      376   field o-was-res as decimal
      377   field o-to-res as decimal
      378   field o-is-res as decimal
      379   index pi is unique primary
      380   obj-type
      381   obj-code
      382   artic
      383   prod-type
      384   prod-code
      385   index iartic
      386   artic
      387   prod-type
      388   prod-code
      389   .
      390   define NEW SHARED temp-table tt0-doc-line no-undo like lib-trn_ret-line.
      391   define NEW SHARED temp-table tt0-gds-dtl  no-undo like ub.gds-dtl.
      392   define NEW SHARED temp-table tt0-parts    no-undo like ub.parts.
      393   define NEW SHARED temp-table temp-tpsi-clients  no-undo like ub.clients.
      394   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
      395   define variable v-ps as character no-undo .
      396   assign
      397   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
      398                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
      399                     , buf_sale-doc.out-code
      400                     , buf_sale-doc.obj-type
      401                     , buf_sale-doc.obj-code
      402                     , chr(4)
      403                     , buf_sale-doc.tot-lines
      404                     , buf_sale-doc.tot-dtl
      405                     ).
      406   return v-Ps.
      407   END FUNCTION.
      408   procedure create-tt0-doc-line-gds-dtl :
      409   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
      410   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
      411   define input parameter p-ext-doc-type        as character no-undo .
      412   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
      413   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
      414   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
      415   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
      416   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
      417   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
      418   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
      419   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
      420   define parameter buffer b-doc-line           for ub.doc-line.
      421   define parameter buffer b-gds-dtl            for ub.gds-dtl.
      422   define parameter buffer buf_sale-doc for ub.sale-doc.
      423   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
      424   define buffer other_doc-line for ub.doc-line.
      425   define buffer other_gds-dtl for ub.gds-dtl.
      426     do
      427     on error undo, return error return-value
      428     :
      429       find first tt0-doc-line where
      430                 tt0-doc-line.obj-type = p-proprietor-obj-type
      431             AND tt0-doc-line.obj-code = p-proprietor-obj-code
      432             AND tt0-doc-line.prod-type = p-prod-type
      433             AND tt0-doc-line.prod-code = p-prod-code
      434             AND tt0-doc-line.artic     = p-artic
      435             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
      436             AND tt0-doc-line.status_      = 'нередакт':U no-error .
      437       if not available tt0-doc-line then do:
      438         create tt0-doc-line.
      439         buffer-copy b-doc-line
      440         except
      441         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
      442         to tt0-doc-line
      443         assign
      444         tt0-doc-line.status_ = 'нередакт':U
      445         tt0-doc-line.ext-doc-type = p-ext-doc-type
      446         tt0-doc-line.obj-type = p-proprietor-obj-type
      447         tt0-doc-line.obj-code = p-proprietor-obj-code
      448         tt0-doc-line.doc-code = p-doc-code
      449         .
      450       end.
      451       if p-doc-code <> "":U then do:
      452         find first other_doc-line no-lock where
      453                 other_doc-line.doc-code = p-doc-code
      454             AND  other_doc-line.artic    = p-artic
      455             AND  other_doc-line.prod-type = p-prod-type
      456             AND  other_doc-line.prod-code = p-prod-code no-error .
      457         if available other_doc-line then do:
      458           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
      459           assign
      460           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
      461           .
      462         end.
      463         else do:
      464           assign
      465           tt0-doc-line.doc-code = '':U
      466           .
      467         end.
      468       end.
      469       find first tt0-gds-dtl where
      470               tt0-gds-dtl.obj-type = p-proprietor-obj-type
      471           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
      472           AND tt0-gds-dtl.prod-type = p-prod-type
      473           AND tt0-gds-dtl.prod-code = p-prod-code
      474           AND tt0-gds-dtl.artic     = p-artic
      475           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
      476       if not available tt0-gds-dtl then do:
      477         create tt0-gds-dtl.
      478         buffer-copy b-gds-dtl
      479         except
      480         obj-type obj-code doc-code doc-qnty fact-qnty
      481         to tt0-gds-dtl
      482         assign
      483         tt0-gds-dtl.obj-type = p-proprietor-obj-type
      484         tt0-gds-dtl.obj-code = p-proprietor-obj-code
      485         tt0-gds-dtl.doc-code = p-doc-code
      486         .
      487       end.
      488       if p-doc-code <> "":U then do:
      489           find first other_gds-dtl no-lock where
      490                   other_gds-dtl.doc-code = p-doc-code
      491               AND  other_gds-dtl.artic    = p-artic
      492               AND  other_gds-dtl.prod-type    = p-prod-type
      493               AND  other_gds-dtl.prod-code    = p-prod-code
      494               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
      495           if available other_gds-dtl then do:
      496             assign
      497             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
      498             .
      499           end.
      500           else do:
      501             assign
      502             tt0-gds-dtl.doc-code = '':U
      503             .
      504           end.
      505       end.
      506       assign
      507       old-qnty = tt0-gds-dtl.doc-qnty
      508       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
      509       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
      510       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
      511       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
      512       .
      513     end.
      514   end procedure.
      515   procedure fill-tt-tpsi-table :
      516   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
      517   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
      518   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
      519   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
      520   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
      521   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
      522   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
      523   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
      524   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
      525   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
      526   define buffer buf_goods for ub.goods.
      527   define buffer buf_doc-line for ub.doc-line.
      528   define buffer buf_gds-dtl for ub.gds-dtl.
      529   define buffer buf_sale-doc for ub.sale-doc.
      530     do
      531     on error undo, return error
      532     :
      533       _doc-line:
      534       for each buf_Doc-line no-lock where
      535             buf_doc-line.doc-code = p-doc-code,
      536         first buf_goods no-lock where
      537             buf_goods.artic = buf_doc-line.artic
      538        AND  buf_goods.prod-type  = buf_doc-line.prod-type
      539        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
      540           each buf_gds-dtl no-lock where
      541             buf_gds-dtl.doc-code = buf_doc-line.doc-code
      542         AND  buf_gds-dtl.artic    = buf_doc-line.artic
      543         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
      544         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
      545         assign
      546         v-ext-doc-type = "":U.
      547         run tpsi-preselect-gds-proprietor in this-procedure (
      548                                                     input buf_goods.gds-code
      549                                                   ,input g#db-num
      550                                                   ,output v-proprietor-host-code
      551                                                   ,output v-proprietor-obj-type
      552                                                   ,output v-proprietor-obj-code ) no-error .
      553         if v-proprietor-host-code = p-host-code then do:
      554           assign
      555           v-ext-doc-type = 'ev':U .
      556         end.
      557         else do:
      558           assign
      559           v-ext-doc-type =  'ee':U .
      560         end.
      561         if  (v-proprietor-obj-type = p-obj-type
      562         AND v-proprietor-obj-code = p-obj-code)
      563         OR (v-proprietor-obj-type = "":U
      564         AND v-proprietor-obj-code = 0)
      565         OR v-proprietor-obj-code = ?
      566         then next _doc-line.
      567         find first buf_sale-doc no-lock where
      568                   buf_sale-doc.inkas-code = p-doc-code
      569              AND buf_sale-doc.obj-type = v-proprietor-obj-type
      570              AND buf_sale-doc.obj-code = v-proprietor-obj-code
      571              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
      572              no-error .
      573         run create-tt0-doc-line-gds-dtl  in this-procedure (
      574                                                              input v-proprietor-obj-type
      575                                                             ,input v-proprietor-obj-code
      576                                                             ,input v-ext-doc-type
      577                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
      578                                                             ,input buf_doc-line.artic
      579                                                             ,input buf_Doc-line.prod-type
      580                                                             ,input buf_doc-line.prod-code
      581                                                             ,input buf_gds-dtl.prt-code
      582                                                             ,input 0
      583                                                             ,output v-was-gds-dtl-fact-qnty
      584                                                             ,output v-gds-dtl-fact-qnty
      585                                                             ,buffer buf_doc-line
      586                                                             ,buffer buf_gds-dtl
      587                                                             ,buffer buf_sale-doc
      588                                                           ).
      589       end.
      590     end.
      591   end procedure.
      592   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      594   procedure get-alias-type-price-obj :
      595   define input parameter p-host-code like ub.sysconf.host-code no-undo .
      596   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
      597   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
      598   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
      599   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
      600   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
      601   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
      602   define output parameter p-alias-type-price as character no-undo .
      603   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
      604   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
      605   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
      606   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
      607   define variable v-mediat-objf               as character no-undo .
      608   define variable v-param-type as character no-undo .
      609   define variable v-value-character as character no-undo .
      610   define variable v-value-date as date no-undo .
      611   define variable v-value-decimal as decimal no-undo .
      612   define variable v-value-integer as INTEGER no-undo .
      613   define variable v-value-logical AS LOGICAL no-undo .
      614   define variable v-tth as handle no-undo .
      615   assign
      616   v-tth = buffer thbjattr_thbj-attr:table-handle .
      617   define buffer buf_trn-doc for ub.trn-doc.
      618     _main:
      619     do
      620     on error undo, return error return-value
      621     :
      622       run adm/shattri.p (
      623         input "get":U
      624         ,input  p-prop-obj-type
      625         ,input  p-prop-obj-code
      626         ,input  'alias-tpsi':U
      627         ,input  '':U
      628         ,output v-value-character
      629         ,output v-value-date
      630         ,output v-value-decimal
      631         ,output v-value-integer
      632         ,output v-value-logical
      633         ,output v-param-type
      634         ,INPUT-OUTPUT table-handle v-tth
      635         ) no-error .
      636       if error-status:error
      637       then do:
      638         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
      639                                 , p-prop-obj-type
      640                                 , p-prop-obj-code).
      641       end.
      642       find first thbjattr_thbj-attr where
      643                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
      644             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
      645             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
      646             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
      647       if not available thbjattr_thbj-attr
      648       or thbjattr_thbj-attr.property-value-integer = 0 then do:
      649         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
      650                                 , p-prop-obj-type
      651                                 , p-prop-obj-code).
      652       end.
      653       assign
      654       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
      655       if p-prop-host-code = p-host-code
      656       and (p-alias-type-price = '':U
      657       or   p-alias-type-price <> '5':U)
      658       then  do:
      659         assign
      660         p-ext-doc-type = 'ev':U
      661         p-price-obj-type = p-obj-type
      662         p-price-obj-code = p-obj-code
      663         p-alias-type-price = '3':U
      664         .
      665       end.
      666       else do:
      667         if p-prop-host-code = p-host-code  then do:
      668           assign
      669           p-ext-doc-type = 'ev':U
      670           p-price-obj-type = p-obj-type
      671           p-price-obj-code = p-obj-code
      672           .
      673         end.
      674         else do:
      675           assign
      676           p-ext-doc-type = 'ee':U.
      677           assign
      678           v-mediat-obj-type = "":U
      679           v-mediat-obj-code = 0
      680           v-mediat-objf = "":U
      681           .
      682           if p-alias-type-price = '4':U then do:
      683             find first thbjattr_thbj-attr where
      684                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
      685                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
      686                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
      687                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
      688             if not available thbjattr_thbj-attr
      689             or thbjattr_thbj-attr.property-value-character = "":U then do:
      690               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
      691                                       , p-prop-obj-type
      692                                       , p-prop-obj-code).
      693             end.
      694             assign
      695             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
      696             v-mediat-obj-type = entry(1, v-mediat-objf)
      697             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
      698             no-error
      699             .
      700             if error-status:error then do:
      701               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
      702                                       , p-prop-obj-type
      703                                       , p-prop-obj-code).
      704             end.
      705           end.
      706           CASE p-alias-type-price:
      707             when '1':U then do:
      708               assign
      709               p-price-obj-type = p-prop-obj-type
      710               p-price-obj-code = p-prop-obj-code
      711               .
      712             end.
      713             when '2':U then do:
      714               assign
      715               p-price-obj-type = p-prop-obj-type
      716               p-price-obj-code = p-prop-obj-code
      717               .
      718             end.
      719             when '3':U
      720             or
      721             when '5':U
      722             then do:
      723               assign
      724               p-price-obj-type = p-obj-type
      725               p-price-obj-code = p-obj-code
      726               .
      727             end.
      728             when '4':U then do:
      729               assign
      730               p-price-obj-type = v-mediat-obj-type
      731               p-price-obj-code = v-mediat-obj-code
      732               .
      733             end.
      734           END CASE.
      735         end.
      736       end.
      737     end.
      738   end procedure.
      739   procedure write-tt0-info:
      740   define input parameter p-artic as character no-undo .
      741   define input parameter p-prod-type as character no-undo .
      742   define input parameter p-prod-code as integer no-undo .
      743   define input parameter p-prt-code as integer no-undo .
      744   define input parameter p-obj-type as character no-undo .
      745   define input parameter p-obj-code as integer no-undo .
      746   define input parameter p-doc-code as character no-undo .
      747   define input parameter p-from-tpsi as logical no-undo .
      748   define input parameter p-all-qnty as decimal no-undo .
      749   define input parameter p-was-res as decimal no-undo .
      750   define input parameter p-to-res as decimal no-undo .
      751   define input parameter p-is-res as decimal no-undo .
      752   define input parameter p-o-was-res as decimal no-undo .
      753   define input parameter p-o-to-res as decimal no-undo .
      754   define input parameter p-o-is-res as decimal no-undo .
      755   define input parameter p-mess   as character no-undo .
      756   define buffer buf_tt0-info for tt0-info.
      757     do
      758     on error undo, return error return-value
      759     :
      760       find first buf_tt0-info where
      761                buf_tt0-info.artic = p-artic
      762            and buf_tt0-info.prod-type = p-prod-type
      763            and buf_tt0-info.prod-code = p-prod-code
      764            and buf_tt0-info.prt-code = p-prt-code
      765            no-error .
      766       if not available buf_tt0-info then do:
      767         create buf_tt0-info.
      768         assign
      769         buf_tt0-info.artic = p-artic
      770         buf_tt0-info.prod-type = p-prod-type
      771         buf_tt0-info.prod-code = p-prod-code
      772         buf_tt0-info.prt-code  = p-prt-code
      773         buf_tt0-info.obj-type  = p-obj-type
      774         buf_tt0-info.obj-code  = p-obj-code
      775         buf_tt0-info.a-to-res  = ?
      776         buf_tt0-info.to-res    = ?
      777         buf_tt0-info.was-res   = ?
      778         buf_tt0-info.o-was-res = ?
      779         buf_tt0-info.o-to-res  = ?
      780         buf_tt0-info.o-is-res  = ?
      781         buf_tt0-info.is-res    = ?
      782         .
      783       end.
      784       assign
      785       buf_tt0-info.a-to-res  =
      786                                 (if buf_tt0-info.a-to-res <> ?
      787                                 and p-all-qnty = ?
      788                                 then buf_tt0-info.a-to-res
      789                                 else p-all-qnty)
      790       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
      791                                 and p-was-res = ?
      792                                 then buf_tt0-info.was-res
      793                                 else p-was-res)
      794       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
      795                                 and p-to-res = ?
      796                                 then buf_tt0-info.to-res
      797                                 else p-to-res)
      798       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
      799                                 and p-is-res = ?
      800                                 then buf_tt0-info.is-res
      801                                 else p-is-res)
      802       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
      803                                 and p-o-was-res = ?
      804                                 then buf_tt0-info.o-was-res
      805                                 else p-o-was-res)
      806       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
      807                                 and p-o-to-res = ?
      808                                 then buf_tt0-info.o-to-res
      809                                 else p-o-to-res)
      810       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
      811                                 and p-o-is-res = ?
      812                                 then buf_tt0-info.o-is-res
      813                                 else p-o-is-res)
      814       .
      815       assign
      816       buf_tt0-info.doc-code  = p-doc-code
      817       buf_tt0-info.error-message   = p-mess
      818       .
      819     end.
      820   end procedure.
      821   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      822   DEFINE new SHARED temp-table dtl-rests no-undo
      823   field b-code like ub.bar-code.b-code
      824   field artic like ub.gds-dtl.artic
      825   field prod-type like ub.gds-dtl.prod-type
      826   field prod-code like ub.gds-dtl.prod-code
      827   field gds-code like ub.goods.gds-code
      828   field prt-code like ub.gds-dtl.prt-code
      829   field unit-base like ub.goods.unit-base
      830   field rest-fact-qnty as decimal
      831   field maybe-qnty as decimal
      832   field prt-qnty as decimal
      833   field free-qnty as decimal
      834   field need-qnty as decimal
      835   field gds-name like ub.goods.gds-name
      836   field OK as logical column-label "ОК"
      837   FIELD fbr as integer
