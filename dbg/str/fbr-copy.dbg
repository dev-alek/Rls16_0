     2145   procedure fbrlib_get-default-pay-code :
     2146   define input parameter p-obj-type   as character        no-undo.
     2147   define input parameter p-obj-code   as integer          no-undo.
     2148   define output parameter p-pay-code  as integer          no-undo.
