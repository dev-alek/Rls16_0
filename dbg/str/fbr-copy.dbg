     7249   procedure gds-glob-sum-grps :
     7250     define input  parameter p-mode        as character no-undo .
     7251     define input  parameter p-gds-code like ub.gds-obj-attr.gds-code no-undo .
     7252     define input-output parameter p-value as integer no-undo .
     7253     define output parameter p-setted as logical no-undo .
     7254     do
     7255     on error undo, return error
     7256     :
     7257           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-glob-sum-grps in g#attr-lib
     7258         (input p-mode
