     5639                   skip(1) "Обратитесь к администратору."
     5640                   skip(1) return-value
     5641               view-as alert-box information.
     5642               run clear-temp-tables in this-procedure .
     5643               undo, return error.
     5644           end.
     5645           find first buf_fbr-line no-lock
     5646                where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     5647                  and buf_fbr-line.is-comp     = yes
     5648                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5649           no-error.
     5650           if available buf_fbr-line
     5651           then do:
