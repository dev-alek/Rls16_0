     1717     .
     1718   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1719   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1720   define variable vss-include-info16 as character format "X(65)" no-undo
     1721   initial "@(#)$Workfile$ $Revision$".
     1722   define temp-table temp_fbrcode-doc-code no-undo
     1723       field rec-type      as character
     1724       field doc-code      as character
     1725       field obj-type      as character
     1726       field obj-code      as integer
     1727       field cli-type      as character
     1728       field cli-code      as integer
     1729       field ext-doc-type  as character
     1730       field doc-type      as character
