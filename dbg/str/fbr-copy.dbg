     5781               , input buf_fbr-recipe.recipe-code
     5782               , input v-trn-type
     5783               , input v-is-comp
     5784               , input yes
     5785               , input buf_fbr-doc.obj-type
     5786               , input buf_fbr-doc.obj-code
     5787               , output v-fbr-line-recid
     5788           ).
     5789           if buf_start_temp_goods-qnty.need-qnty = ?
     5790           then do:
     5791               find first tt-marking-lines no-error .
     5792               if available tt-marking-lines
     5793               then do :
     5794                 assign v-mark-qnty = 0 .
     5795                 for first buf_fbr-line no-lock where recid(buf_fbr-line) = v-fbr-line-recid,
     5796                 first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5797                                           and buf_goods.prod-type = buf_fbr-line.prod-type
     5798                                           and buf_goods.prod-code = buf_fbr-line.prod-code,
     5799                 each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5800                 :
     5801                   assign v-mark-qnty = v-mark-qnty + tt-marking-lines.box-qnty .
     5802                 end .
     5803               end .
     5804               run str/fbr-line.w (
     5805                     input p-fbrhist-handle
     5806                   , input buf_fbr-doc.status_
     5807                   , input p-fbr-doc-doc-code
     5808                   , input v-fbr-line-recid
     5809                   , input v-mark-qnty
     5810                   , output v-cancel
     5811               ) no-error.
     5812               if error-status :error
     5813               or v-cancel = yes
     5814               then do:
     5815                   find first buf_fbr-line exclusive-lock
     5816                        where recid( buf_fbr-line ) = v-fbr-line-recid
     5817                   .
     5818                   for first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5819                                             and buf_goods.prod-type = buf_fbr-line.prod-type
     5820                                             and buf_goods.prod-code = buf_fbr-line.prod-code,
     5821                   each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5822                   :
     5823                     for first buf_marking exclusive-lock where buf_marking.mark begins tt-marking-lines.mark :
     5824                       assign
     5825                         buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB
     5826                       .
     5827                     end .
     5828                   end .
     5829                   delete buf_fbr-line.
     5830                   run clear-temp-tables in this-procedure.
     5831                   return.
     5832               end.
     5833               for first buf_fbr-line no-lock where recid(buf_fbr-line) = v-fbr-line-recid,
     5834               first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5835                                         and buf_goods.prod-type = buf_fbr-line.prod-type
     5836                                         and buf_goods.prod-code = buf_fbr-line.prod-code,
     5837               each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5838               :
     5839                 create buf_marking-lines .
     5840                 assign
     5841                   buf_marking-lines.mark      = tt-marking-lines.mark
     5842                   buf_marking-lines.obj-type  = buf_fbr-doc.obj-type
     5843                   buf_marking-lines.obj-code  = buf_fbr-doc.obj-code
     5844                   buf_marking-lines.gds-code  = buf_goods.gds-code
     5845                   buf_marking-lines.in-code   = "manufacturing"
     5846                   buf_marking-lines.out-code  = buf_fbr-line.doc-code
     5847                   buf_marking-lines.part-code = buf_fbr-line.recipe-code
     5848                   buf_marking-lines.prt-code  = 0
     5849                   buf_marking-lines.doc-level = 1
     5850                 .
     5851               end .
     5852               find first buf_fbr-line exclusive-lock
     5853                    where recid( buf_fbr-line ) = v-fbr-line-recid
     5854               .
     5855               if p-same-good = yes
     5856               then do:
