     2214   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     2215   do
     2216   on error undo, return error
     2217   :
     2218   define input parameter p-fbr-doc-code as character    no-undo.
     2219       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     2220       define variable v-gds-name      as character    no-undo.
     2221       define buffer buf_fbr-doc               for ub.fbr-doc.
     2222       define buffer buf_fbr-line              for ub.fbr-line.
     2223       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     2224       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     2225       find first buf_fbr-doc no-lock
     2226            where buf_fbr-doc.doc-code = p-fbr-doc-code
     2227       .
     2228       for each buf_temp_fbrlib_recipe
     2229       :
     2230           delete buf_temp_fbrlib_recipe.
     2231       end.
     2232       for each buf_fbr-line no-lock
     2233          where buf_fbr-line.doc-code = p-fbr-doc-code
     2234       :
     2235           find first buf_temp_fbrlib_recipe
     2236                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     2237           no-error.
     2238           if not available buf_temp_fbrlib_recipe
     2239           then do:
     2240               create buf_temp_fbrlib_recipe.
     2241               assign
     2242                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     2243                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     2244               .
     2245           end.
     2246       end.
     2247       for each buf_temp_fbrlib_recipe
     2248       :
     2249           assign
     2250               buf_temp_fbrlib_recipe.count-income                = 0
     2251               buf_temp_fbrlib_recipe.qnty-income                 = 0
     2252               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     2253               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     2254               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     2255               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     2256               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     2257               buf_temp_fbrlib_recipe.count-write-off             = 0
     2258               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     2259               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     2260               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     2261               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     2262               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     2263               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     2264           .
     2265           for each buf_fbr-line no-lock
     2266              where buf_fbr-line.doc-code     = p-fbr-doc-code
     2267                and buf_fbr-line.trn-type     = 'при':U
     2268                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     2269           :
     2270               if ( buf_fbr-line.price-base   = ?
     2271                   or buf_fbr-line.price-rubl = ?
     2272                   or buf_fbr-line.price-base <= 0
     2273                   or buf_fbr-line.price-rubl <= 0 )
     2274               and buf_fbr-line.fact-qnty <> 0
     2275               and buf_fbr-line.rsrv-qnty <> ?
     2276               and buf_fbr-doc.is-free    = no
     2277               then do:
     2278   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2279   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     2280     (input  buf_fbr-line.artic
     2281     ,input  buf_fbr-line.prod-type
     2282     ,input  buf_fbr-line.prod-code
     2283     ,output v-gds-name
     2284     ) no-error .
     2285                   if error-status :error
     2286                   then do:
     2287                       assign
     2288                           v-gds-name = ""
     2289                       .
     2290                   end.
     2291                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     2292                                                 ,vss-description
     2293                                                 ,buf_fbr-doc.doc-code
     2294                                                 ,chr(10)
     2295                                                 ,buf_fbr-line.recipe-code
     2296                                                 ,buf_fbr-line.artic
     2297                                                 ,v-gds-name).
     2298               end.
     2299               assign
     2300                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     2301                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     2302                                                                   + buf_fbr-line.fact-qnty
     2303                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     2304                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     2305               .
     2306               if buf_fbr-line.is-waste = no
     2307               then do:
     2308                   assign
     2309                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     2310                                                                       + buf_fbr-line.price-sum-base
     2311                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2312                                                                       + buf_fbr-line.price-sum-rubl
     2313                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2314                                                                       + buf_fbr-line.price-sum-vat-base
     2315                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2316                                                                       + buf_fbr-line.price-sum-vat-rubl
     2317                   .
     2318               end.
     2319           end.
     2320           for each buf_fbr-line no-lock
     2321              where buf_fbr-line.doc-code     = p-fbr-doc-code
     2322                and buf_fbr-line.trn-type     = 'спи':U
     2323                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     2324           :
     2325               if ( buf_fbr-line.price-base   = ?
     2326                   or buf_fbr-line.price-rubl = ?
     2327                   or buf_fbr-line.price-base <= 0
     2328                   or buf_fbr-line.price-rubl <= 0 )
     2329               and buf_fbr-line.fact-qnty <> 0
     2330               and buf_fbr-line.rsrv-qnty <> ?
     2331               and buf_fbr-doc.is-free    = no
     2332               and buf_fbr-doc.status_    = 'разрешен':U
     2333               then do:
     2334   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2335   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     2336     (input  buf_fbr-line.artic
     2337     ,input  buf_fbr-line.prod-type
     2338     ,input  buf_fbr-line.prod-code
     2339     ,output v-gds-name
     2340     ) no-error .
     2341                   if error-status :error
     2342                   then do:
     2343                       assign
     2344                           v-gds-name = ""
     2345                       .
     2346                   end.
     2347                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     2348                                                 ,vss-description
     2349                                                 ,buf_fbr-doc.doc-code
     2350                                                 ,chr(10)
     2351                                                 ,buf_fbr-line.recipe-code
     2352                                                 ,buf_fbr-line.artic
     2353                                                 ,v-gds-name).
     2354               end.
     2355               assign
     2356                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     2357                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     2358                                                                   + buf_fbr-line.fact-qnty
     2359                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     2360                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     2361               .
     2362               if buf_fbr-line.is-waste = no
     2363               then do:
     2364                   assign
     2365                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2366                                                                       + buf_fbr-line.price-sum-base
     2367                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2368                                                                       + buf_fbr-line.price-sum-rubl
     2369                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2370                                                                       + buf_fbr-line.price-sum-vat-base
     2371                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2372                                                                       + buf_fbr-line.price-sum-vat-rubl
     2373                   .
     2374               end.
     2375           end.
     2376           if buf_fbr-doc.status_    = 'разрешен':U
     2377           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     2378           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     2379           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     2380           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     2381               )
     2382           then do:
     2383            undo, return error
     2384               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     2385                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     2386                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     2387                           "Сумма в &9.&4&7&4&4&8&2"
     2388                          , buf_fbr-doc.doc-code
     2389                          , chr(10)
     2390                          , buf_temp_fbrlib_recipe.recipe-code
     2391                          , chr(9)
     2392                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2393                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     2394                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2395                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2396                          , "руб"
     2397                          )
     2398              +
     2399              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     2400                         "НДС в &7.&1&5&1&1&6&4"
     2401                        ,  chr(9)
     2402                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2403                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2404                        ,chr(10)
     2405                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2406                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2407                        ,"руб"
     2408                        )       .
     2409           end.
     2410       end.
     2411   end.
     2412   end procedure.
     2413   procedure fbrlib-fill-sum-fbr-doc :
     2414   do
     2415   on error undo, return error
     2416   :
     2417   define input parameter p-fbr-doc-recid  as recid        no-undo.
     2418   define input parameter p-mode           as character    no-undo.
     2419       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     2420       define buffer buf_fbr-doc           for ub.fbr-doc.
     2421       define buffer buf_fbr-line          for ub.fbr-line.
     2422       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     2423       define variable v-in-count          as integer       no-undo.
     2424       define variable v-out-count         as integer       no-undo.
     2425       find first buf_fbr-doc exclusive-lock
     2426            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     2427       .
     2428       find first buf_temp_fbrlib_recipe no-error.
     2429       if not available buf_temp_fbrlib_recipe
     2430       then do:
     2431           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     2432               input buf_fbr-doc.doc-code
     2433           ) no-error.
     2434           if error-status :error
     2435           then do:
     2436               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     2437                                              , vss-description
     2438                                              , chr(10)
     2439                                              , error-status:get-message(1)
     2440                                              , return-value ).
     2441           end.
     2442       end.
     2443       assign
     2444           v-in-count                  = 0
     2445           buf_fbr-doc.in-qnty         = 0
     2446           buf_fbr-doc.in-sale         = 0
     2447           buf_fbr-doc.in-base         = 0
     2448           buf_fbr-doc.in-rubl         = 0
     2449           buf_fbr-doc.in-vat-base     = 0
     2450           buf_fbr-doc.in-vat-rubl     = 0
     2451           v-out-count                 = 0
     2452           buf_fbr-doc.out-qnty        = 0
     2453           buf_fbr-doc.out-sale        = 0
     2454           buf_fbr-doc.out-base        = 0
     2455           buf_fbr-doc.out-rubl        = 0
     2456           buf_fbr-doc.out-vat-base    = 0
     2457           buf_fbr-doc.out-vat-rubl    = 0
     2458       .
     2459       for each buf_temp_fbrlib_recipe
     2460       :
     2461           assign
     2462               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     2463               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     2464               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     2465               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     2466               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2467               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2468               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2469               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     2470               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     2471               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     2472               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2473               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2474               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2475               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2476           .
     2477       end.
     2478       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     2479       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     2480       or p-mode <> 'факт':U
     2481       then do:
     2482           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     2483           then do:
     2484               assign
     2485                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     2486                                   + string( v-out-count, ">>>,>>9" )
     2487                                   + chr(10) + "Строк исходных товаров : "
     2488                                   + string( v-in-count, ">>>,>>9" )
     2489               .
     2490           end.
     2491       end.
     2492       else do:
     2493         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     2494                                       "Сумма списанных товаров в &3 - &4&2" +
     2495                                       "Сумма оприходованных товаров в &3 - &5&2" +
     2496                                       "Сумма оприходованных товаров в &3 - &6&2" +
     2497                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     2498                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     2499                                       , buf_fbr-doc.doc-code
     2500                                       , chr(10)
     2501                                       , "рублях"
     2502                                       , round( buf_fbr-doc.out-rubl, 2 )
     2503                                       , round( buf_fbr-doc.in-rubl,  2 )
     2504                                       , round( buf_fbr-doc.in-rubl,  2 )
     2505                                       , round( buf_fbr-doc.out-base, 2 )
     2506                                       , round( buf_fbr-doc.in-base,  2 )).
     2507       end.
     2508   end.
     2509   end procedure.
     2510   procedure fbrlib-calc-prices :
     2511   do
     2512   on error undo, return error
     2513   :
     2514   define input parameter p-fbr-line-recid as recid        no-undo.
     2515   define input parameter p-price-obj-type as character    no-undo.
     2516   define input parameter p-price-obj-code as integer      no-undo.
     2517   define output parameter p-current-price as decimal      no-undo.
     2518       define variable v-void          as decimal       no-undo.
     2519       define variable v-void-char     as character     no-undo.
     2520       define variable v-gds-code      as integer       no-undo.
     2521       define variable v-b-code        as integer       no-undo.
     2522       define buffer buf_fbr-doc   for ub.fbr-doc.
     2523       define buffer buf_fbr-line  for ub.fbr-line.
     2524       define buffer buf_gds-prt   for ub.gds-prt.
     2525       define buffer buf_bar-code  for ub.bar-code.
     2526       find first buf_fbr-line no-lock
     2527           where recid( buf_fbr-line ) = p-fbr-line-recid
     2528       .
     2529   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2530   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2531     (input  buf_fbr-line.artic
     2532     ,input  buf_fbr-line.prod-type
     2533     ,input  buf_fbr-line.prod-code
     2534     ,output v-gds-code
     2535     ) no-error .
     2536       if error-status :error
     2537       then do:
     2538         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     2539                                         ,vss-workfile
     2540                                         ,vss-revision
     2541                                         ,vss-description
     2542                                         ,chr(10)
     2543                                         , error-status:get-message(1)
     2544                                         , return-value
     2545                                         , buf_fbr-line.artic
     2546                                         ).
     2547       end.
     2548   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2549     (input  v-gds-code
     2550     ,input  ?
     2551     ,output v-b-code
     2552     ) no-error .
     2553       if error-status :error
     2554       then do:
     2555         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     2556                                         ,vss-workfile
     2557                                         ,vss-revision
     2558                                         ,vss-description
     2559                                         ,chr(10)
     2560                                         , error-status:get-message(1)
     2561                                         , return-value
     2562                                         , v-gds-code
     2563                                         ).
     2564       end.
     2565       if buf_fbr-line.is-calc = no
     2566       then do:
     2567   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2569     (input  p-price-obj-type
     2570     ,input  p-price-obj-code
     2571     ,input  v-b-code
     2572     ,input  0
     2573     ,input  0
     2574     ,output v-void-char
     2575     ,output p-current-price
     2576     ,output v-void
     2577     ,output v-void
     2578     ) no-error .
     2579           if error-status :error
     2580           then do:
     2581             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     2582                                             ,vss-workfile
     2583                                             ,vss-revision
     2584                                             ,vss-description
     2585                                             ,chr(10)
     2586                                             , error-status:get-message(1)
     2587                                             , return-value
     2588                                             , v-gds-code
     2589                                             ).
     2590           end.
     2591       end.
     2592       else do:
     2593           assign
     2594               p-current-price = buf_fbr-line.price-sale
     2595           .
     2596       end.
     2597   end.
     2598   end procedure.
     2599   procedure fbrlib-put-in-order-recipe :
     2600   do
     2601   on error undo, return error
     2602   :
     2603   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2604       define variable v-recipe-counter    as integer          no-undo.
     2605       define variable v-recipe-amount     as integer init 0   no-undo.
     2606       define variable v-child-counter     as integer          no-undo.
     2607       define variable v-is-call-cycle     as logical          no-undo.
     2608       define variable v-str as character     no-undo.
     2609       define buffer buf_in_fbr-line       for ub.fbr-line.
     2610       define buffer buf_dress_fbr-line    for ub.fbr-line.
     2611       define buffer buf_fbr-line          for ub.fbr-line.
     2612       define buffer buf_recipe-gds        for ub.recipe-gds.
     2613       define buffer buf_recipe            for ub.recipe.
     2614       for each temp_recipe-childs-qnty
     2615       :
     2616           delete temp_recipe-childs-qnty.
     2617       end.
     2618       for each temp_recipe-childs
     2619       :
     2620           delete temp_recipe-childs.
     2621       end.
     2622       for each temp_recipe-order
     2623       :
     2624           delete temp_recipe-order.
     2625       end.
     2626       for each buf_fbr-line no-lock
     2627          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2628       on error undo, return error
     2629       :
     2630           find first temp_recipe-childs-qnty
     2631                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2632           no-error.
     2633           if not available temp_recipe-childs-qnty
     2634           then do:
     2635               create temp_recipe-childs-qnty.
     2636               assign
     2637                   v-recipe-amount                     = v-recipe-amount + 1
     2638                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2639                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2640                   temp_recipe-childs-qnty.childs-qnty = 0
     2641                   v-child-counter                     = 0
     2642               .
     2643           end.
     2644       end.
     2645       for each buf_in_fbr-line no-lock
     2646          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2647            and buf_in_fbr-line.trn-type = 'спи':U
     2648       on error undo, return error
     2649       :
     2650           for each buf_dress_fbr-line no-lock
     2651              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2652                and buf_dress_fbr-line.trn-type    = 'при':U
     2653                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2654                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2655                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2656           on error undo, return error
     2657           :
     2658               find first buf_recipe no-lock
     2659                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2660               .
     2661               if buf_in_fbr-line.is-comp = yes
     2662               then do:
     2663                   find last temp_recipe-childs-qnty
     2664                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2665                   .
     2666                   assign
     2667                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2668                   .
     2669                   create temp_recipe-childs.
     2670                   assign
     2671                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2672                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2673                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2674                   .
     2675               end.
     2676               else do:
     2677               end.
     2678           end.
     2679       end.
     2680       for each buf_in_fbr-line no-lock
     2681          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2682            and buf_in_fbr-line.trn-type = 'при':U
     2683       on error undo, return error
     2684       :
     2685           find first buf_recipe no-lock
     2686                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2687           no-error.
     2688           if buf_in_fbr-line.is-comp = no
     2689           then do:
     2690           end.
     2691           else do:
     2692               for each buf_recipe-gds no-lock
     2693               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2694               :
     2695                   for each buf_fbr-line no-lock
     2696                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2697                       and buf_fbr-line.trn-type    = 'при':U
     2698                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2699                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2700                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2701                   on error undo, return error
     2702                   :
     2703                       find first buf_recipe no-lock
     2704                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2705                       .
     2706                       if buf_recipe.recipe-type = 'разделка':U
     2707                       then do:
     2708                       end.
     2709                       else do:
     2710                           find last temp_recipe-childs-qnty
     2711                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2712                           .
     2713                           assign
     2714                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2715                           .
     2716                           create temp_recipe-childs.
     2717                           assign
     2718                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2719                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2720                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2721                           .
     2722                       end.
     2723                   end.
     2724               end.
     2725           end.
     2726       end.
     2727       for each temp_recipe-order
     2728       on error undo, return error
     2729       :
     2730           delete temp_recipe-order.
     2731       end.
     2732       assign
     2733           v-fbrlib-recipe-order = 0
     2734       .
     2735       do v-recipe-counter = 1 to v-recipe-amount
     2736       on error undo, return error
     2737       :
     2738           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2739                 input v-recipe-counter
     2740               , input 0
     2741               , output v-is-call-cycle
     2742           ).
     2743           if v-is-call-cycle = yes
     2744           then do:
     2745               message
     2746                       "Достигнут максимальный уровень вложенности рецептов."
     2747                   skip(1)
     2748                   skip "Невозможно упорядочить рецепты."
     2749                   skip(1)
     2750                   skip "Необходимо изменить структуру рецептов,"
     2751                   skip "используемых при формировании"
     2752                   skip "данного документа производства."
     2753               view-as alert-box error
     2754               title "Невозможно рассчитать документ производства".
     2755               for each temp_recipe-childs-qnty
     2756               :
     2757                   delete temp_recipe-childs-qnty.
     2758               end.
     2759               for each temp_recipe-childs
     2760               :
     2761                   delete temp_recipe-childs.
     2762               end.
     2763               for each temp_recipe-order
     2764               :
     2765                   delete temp_recipe-order.
     2766               end.
     2767               for each temp_recipe-order
     2768               on error undo, return error
     2769               :
     2770                   delete temp_recipe-order.
     2771               end.
     2772               for each temp_fbrlib_recipe
     2773               on error undo, return error
     2774               :
     2775                   delete temp_recipe-order.
     2776               end.
     2777               undo, return error.
     2778           end.
     2779       end.
     2780   end.
     2781   end procedure.
     2782   procedure fbrlib-add-recipe-in-tmp-order :
     2783   do
     2784   on error undo, return error
     2785   :
     2786   define input parameter p-order              as integer      no-undo.
     2787   define input parameter p-call-counter       as integer      no-undo.
     2788   define output parameter p-is-call-cycle     as logical      no-undo.
     2789       define variable v-nodes-counter     as integer       no-undo.
     2790       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2791       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2792       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2793       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2794       assign
     2795           p-call-counter = p-call-counter + 1
     2796       .
     2797       if p-call-counter > 50
     2798       then do:
     2799           assign
     2800               p-is-call-cycle = yes
     2801           .
     2802       end.
     2803       else do:
     2804           find first buf_temp_recipe-childs-qnty
     2805                where buf_temp_recipe-childs-qnty.order = p-order
     2806           .
     2807           find first buf_temp_recipe-order
     2808                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2809           no-error.
     2810           if not available buf_temp_recipe-order
     2811           then do:
     2812               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2813               :
     2814                   find first buf_temp_recipe-childs
     2815                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2816                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2817                   .
     2818                   find first buf_c_temp_recipe-childs-qnty
     2819                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2820                   .
     2821                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2822                         input buf_c_temp_recipe-childs-qnty.order
     2823                       , input p-call-counter
     2824                       , output p-is-call-cycle
     2825                   ).
     2826                   if p-is-call-cycle = yes
     2827                   then do:
     2828                       return.
     2829                   end.
     2830               end.
     2831               assign
     2832                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2833               .
     2834               create buf_temp_recipe-order.
     2835               assign
     2836                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2837                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2838               .
     2839           end.
     2840       end.
     2841   end.
     2842   end procedure.
     2843   procedure fbrlib-get-trn-type :
     2844   define input parameter p-recipe-code    as character    no-undo.
     2845   define input parameter p-goods-recid    as recid        no-undo.
     2846   define input parameter p-is-integration as logical      no-undo.
     2847   define output parameter p-is-comp       as logical      no-undo.
     2848   define output parameter p-trn-type      as character    no-undo.
     2849   define buffer buf_recipe    for ub.recipe.
     2850   define buffer buf_goods     for ub.goods.
     2851   do
     2852   for buf_recipe
     2853     , buf_goods
     2854   on error undo, return error
     2855   :
     2856       find first buf_goods no-lock
     2857            where recid( buf_goods ) = p-goods-recid
     2858       .
     2859       find first buf_recipe no-lock
     2860            where buf_recipe.recipe-code = p-recipe-code
     2861       no-error.
     2862       if not available buf_recipe
     2863       then do:
     2864           assign
     2865               p-is-comp = no
     2866               p-trn-type = "":U
     2867           .
     2868           undo, return.
     2869       end.
     2870       if  buf_recipe.artic        = buf_goods.artic
     2871       and buf_recipe.prod-type    = buf_goods.prod-type
     2872       and buf_recipe.prod-code    = buf_goods.prod-code
     2873       then do:
     2874           assign
     2875               p-is-comp = yes
     2876           .
     2877       end.
     2878       else do:
     2879           assign
     2880               p-is-comp = no
     2881           .
     2882       end.
     2883       case buf_recipe.recipe-type
     2884       :
     2885           when 'производство':U
     2886           then do:
     2887               if p-is-comp = yes
     2888               then do:
     2889                   assign
     2890                       p-trn-type = 'при':U
     2891                   .
     2892               end.
     2893               else do:
     2894                   assign
     2895                       p-trn-type = 'спи':U
     2896                   .
     2897               end.
     2898           end.
     2899           when 'альтернатива':U
     2900           then do:
     2901               if p-is-comp = yes
     2902               then do:
     2903                   assign
     2904                       p-trn-type = 'при':U
     2905                   .
     2906               end.
     2907               else do:
     2908                   assign
     2909                       p-trn-type = 'спи':U
     2910                   .
     2911               end.
     2912           end.
     2913           when 'разделка':U
     2914           then do:
     2915               if p-is-comp = no
     2916               then do:
     2917                   assign
     2918                       p-trn-type = 'при':U
     2919                   .
     2920               end.
     2921               else do:
     2922                   assign
     2923                       p-trn-type = 'спи':U
     2924                   .
     2925               end.
     2926           end.
     2927           when 'комплектация':U
     2928           then do:
     2929               if p-is-integration = ?
     2930               then do:
     2931                   message
     2932                       "Выберите тип операции по рецепту комплектации:"
     2933                       skip (2) "YES - комплектация"
     2934                       skip     "NO - разукомплектация"
     2935                   view-as alert-box question
     2936                   buttons YES-NO
     2937                   update p-is-integration.
     2938               end.
     2939               if p-is-integration = yes
     2940               then do:
     2941                   if p-is-comp = yes
     2942                   then do:
     2943                       assign
     2944                           p-trn-type = 'при':U
     2945                       .
     2946                   end.
     2947                   else do:
     2948                       assign
     2949                           p-trn-type = 'спи':U
     2950                       .
     2951                   end.
     2952               end.
     2953               else do:
     2954                   if p-is-comp = yes
     2955                   then do:
     2956                       assign
     2957                           p-trn-type = 'спи':U
     2958                       .
     2959                   end.
     2960                   else do:
     2961                       assign
     2962                           p-trn-type = 'при':U
     2963                       .
     2964                   end.
     2965               end.
     2966           end.
     2967       end case.
     2968   end.
     2969   end procedure.
     2970   procedure fbrlib-get-mark :
     2971   define input parameter p-recipe-code    as character    no-undo.
     2972   define output parameter p-mark          as logical    no-undo.
     2973   define buffer buf_goods-attr     for ub.goods-attr.
     2974   define buffer buf_recipe-gds for ub.recipe-gds .
     2975       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2976            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2977                                               buf_goods-attr.attr-code = 'mark-type':U:
     2978            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2979               p-mark = true .
     2980               return .
     2981            end.
     2982       end.
     2983   end procedure.
     2984   procedure fbrlib-check-temp-tables :
     2985   do
     2986   on error undo, return error
     2987   :
     2988   define input parameter p-title  as character    no-undo.
     2989       define variable v-str               as character        no-undo.
     2990       assign
     2991           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2992       .
     2993       for each temp_recipe-childs-qnty
     2994       on error undo, return error
     2995       :
     2996           assign
     2997               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2998                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2999                       + "   " + string( temp_recipe-childs-qnty.order )
     3000                       + chr(10)
     3001           .
     3002       end.
     3003       assign
     3004           v-str = v-str + "temp_recipe-childs:" + chr(10)
     3005       .
     3006       for each temp_recipe-childs
     3007       on error undo, return error
     3008       :
     3009           assign
     3010               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     3011                       + "   " + string( temp_recipe-childs.child-code )
     3012                       + "   " + string( temp_recipe-childs.child-recipe-code )
     3013                       + chr(10)
     3014           .
     3015       end.
     3016       assign
     3017           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     3018       .
     3019       for each temp_recipe-order
     3020       on error undo, return error
     3021       :
     3022           assign
     3023               v-str   = v-str + string( temp_recipe-order.recipe-code )
     3024                       + "   " + string( temp_recipe-order.order )
     3025                       + chr(10)
     3026           .
     3027       end.
     3028       assign
     3029           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     3030       .
     3031       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     3032       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     3033       for each temp_fbrlib_recipe
     3034       on error undo, return error
     3035       :
     3036           assign
     3037               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     3038                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     3039                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     3040                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     3041                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     3042                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     3043                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     3044                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     3045                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     3046                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     3047                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     3048                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     3049                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     3050                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     3051                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     3052                       + chr(10)
     3053           .
     3054           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     3055       end.
     3056   end.
     3057   end procedure.
     3058   procedure fbrlib-s-coeff-value :
     3059   define input  parameter p-gds-code    as integer        no-undo.
     3060   define input  parameter p-date        as date           no-undo.
     3061   define input  parameter p-obj-type    as character      no-undo.
     3062   define input  parameter p-obj-code    as integer        no-undo.
     3063   define output parameter p-coeff-value as decimal        no-undo.
     3064   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     3065       define variable v-date          as date         no-undo.
     3066       define variable v-host-code     as integer      no-undo.
     3067       define buffer buf_goods       for ub.goods.
     3068       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3069       define buffer buf_clients     for ub.clients.
     3070       define buffer buf_s-coeff     for ub.s-coeff.
     3071   do
     3072   for buf_goods
     3073     , buf_fbr-gds-obj
     3074     , buf_clients
     3075     , buf_s-coeff
     3076   on error undo, return error return-value
     3077   :
     3078       find first buf_goods no-lock
     3079            where buf_goods.gds-code = p-gds-code
     3080       no-error .
     3081       if not available buf_goods
     3082       then do:
     3083          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     3084       end.
     3085       find first buf_clients no-lock
     3086            where buf_clients.obj-type = p-obj-type
     3087              and buf_clients.obj-code = p-obj-code
     3088       no-error.
     3089       if not available buf_clients
     3090       then do:
     3091          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     3092       end.
     3093       assign
     3094           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     3095       .
     3096       find first buf_fbr-gds-obj no-lock
     3097            where buf_fbr-gds-obj.gds-code = p-gds-code
     3098              and buf_fbr-gds-obj.obj-type = p-obj-type
     3099              and buf_fbr-gds-obj.obj-code = p-obj-code
     3100       no-error.
     3101       if not available buf_fbr-gds-obj
     3102       or buf_fbr-gds-obj.is-season = no
     3103       then do:
     3104           assign
     3105               p-coeff-value = 0
     3106           .
     3107           return.
     3108       end.
     3109   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3110   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3111     (input  p-obj-type
     3112     ,input  p-obj-code
     3113     ,output v-host-code
     3114     )  .
     3115       find last buf_s-coeff no-lock
     3116           where buf_s-coeff.gds-code = p-gds-code
     3117             and buf_s-coeff.host-code = v-host-code
     3118             and buf_s-coeff.obj-type = p-obj-type
     3119             and buf_s-coeff.obj-code = p-obj-code
     3120             and buf_s-coeff.s-date <= v-date
     3121       no-error.
     3122       if available buf_s-coeff
     3123       then do:
     3124           assign
     3125               p-coeff-value = buf_s-coeff.coeff-value
     3126           .
     3127           return.
     3128       end.
     3129       find last buf_s-coeff no-lock
     3130           where buf_s-coeff.gds-code = p-gds-code
     3131             and buf_s-coeff.host-code = v-host-code
     3132             and buf_s-coeff.obj-type = "":U
     3133             and buf_s-coeff.obj-code = 0
     3134             and buf_s-coeff.s-date <= v-date
     3135       no-error.
     3136       if available buf_s-coeff
     3137       then do:
     3138           assign
     3139               p-coeff-value = buf_s-coeff.coeff-value
     3140           .
     3141           return.
     3142       end.
     3143       find last buf_s-coeff no-lock
     3144           where buf_s-coeff.gds-code = p-gds-code
     3145             and buf_s-coeff.host-code = 0
     3146             and buf_s-coeff.obj-type = "":U
     3147             and buf_s-coeff.obj-code = 0
     3148             and buf_s-coeff.s-date <= v-date
     3149       no-error.
     3150       if available buf_s-coeff
     3151       then do:
     3152           assign
     3153               p-coeff-value = buf_s-coeff.coeff-value
     3154           .
     3155       end.
     3156       else do:
     3157           assign
     3158               p-coeff-value = 0
     3159           .
     3160       end.
     3161   end.
     3162   end procedure.
     3163   procedure fbrlib_create-fbr-recipe-gds :
     3164   define input parameter p-doc-code         as character      no-undo.
     3165   define input parameter p-recipe-code      as character      no-undo.
     3166   define input parameter p-prod-type        as character      no-undo.
     3167   define input parameter p-prod-code        as integer        no-undo.
     3168   define input parameter p-artic            as character      no-undo.
     3169   define input parameter p-gds-code         as integer        no-undo.
     3170   define input parameter p-is-waste         as logical        no-undo.
     3171   define input parameter p-proc-number      as integer        no-undo.
     3172   define input parameter p-obj-date         as date           no-undo.
     3173   define input parameter p-obj-type         as character      no-undo.
     3174   define input parameter p-obj-code         as integer        no-undo.
     3175   define input parameter p-calc-method      as decimal        no-undo.
     3176   define input parameter p-coeff-waste      as decimal        no-undo.
     3177   define input parameter p-orig-qnty        as decimal        no-undo.
     3178   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     3179       define variable v-coeff-season  as decimal      no-undo.
     3180       define variable v-void-decimal  as decimal      no-undo.
     3181       define variable v-void-integer  as integer      no-undo.
     3182       define variable v-recipe-type   as character    no-undo.
     3183       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3184       define buffer buf_goods             for ub.goods.
     3185       define buffer buf_recipe            for ub.recipe.
     3186   do
     3187   for buf_fbr-recipe-gds
     3188     , buf_recipe
     3189     , buf_goods
     3190   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3191   :
     3192       find first buf_fbr-recipe-gds exclusive-lock
     3193            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3194              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3195              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     3196              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     3197              and buf_fbr-recipe-gds.artic       = p-artic
     3198       no-error.
     3199       if not available buf_fbr-recipe-gds
     3200       then do:
     3201           create buf_fbr-recipe-gds.
     3202           assign
     3203               buf_fbr-recipe-gds.doc-code           = p-doc-code
     3204               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     3205               buf_fbr-recipe-gds.prod-type          = p-prod-type
     3206               buf_fbr-recipe-gds.prod-code          = p-prod-code
     3207               buf_fbr-recipe-gds.artic              = p-artic
     3208               buf_fbr-recipe-gds.gds-code           = p-gds-code
     3209               buf_fbr-recipe-gds.is-waste           = p-is-waste
     3210               buf_fbr-recipe-gds.proc-number        = p-proc-number
     3211               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     3212               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     3213           .
     3214           find first buf_goods no-lock
     3215                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     3216                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     3217                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     3218           .
     3219           run fbrlib-s-coeff-value in this-procedure (
     3220                 input buf_goods.gds-code
     3221               , input p-obj-date
     3222               , input p-obj-type
     3223               , input p-obj-code
     3224               , output v-coeff-season
     3225           ) no-error.
     3226           if error-status:error
     3227           then do:
     3228               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     3229           end.
     3230           assign
     3231               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     3232               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     3233               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     3234           .
     3235           run fbrlib-get-recipe-type in this-procedure (
     3236                 input buf_fbr-recipe-gds.doc-code
     3237               , input buf_fbr-recipe-gds.recipe-code
     3238               , output v-recipe-type
     3239           ).
     3240           if v-recipe-type <> 'производство':U
     3241           then do:
     3242               assign
     3243                   buf_fbr-recipe-gds.coeff-value  = 0
     3244                   buf_fbr-recipe-gds.coeff-waste  = 0
     3245                   buf_fbr-recipe-gds.calc-method  = 1
     3246                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     3247               .
     3248           end.
     3249           else do:
     3250               run fbrlib-calc-brutto in this-procedure (
     3251                     input v-recipe-type
     3252                   , input buf_fbr-recipe-gds.qnty
     3253                   , input buf_fbr-recipe-gds.coeff-value
     3254                   , input buf_fbr-recipe-gds.coeff-waste
     3255                   , input 0
     3256                   , input 3
     3257                   , output v-void-decimal
     3258                   , output v-void-decimal
     3259                   , output buf_fbr-recipe-gds.brutto-qnty
     3260                   , output v-void-integer
     3261               ).
     3262               assign
     3263                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     3264               .
     3265               run fbrlib-calc-brutto in this-procedure (
     3266                     input v-recipe-type
     3267                   , input buf_fbr-recipe-gds.qnty
     3268                   , input buf_fbr-recipe-gds.coeff-value
     3269                   , input buf_fbr-recipe-gds.coeff-waste
     3270                   , input buf_fbr-recipe-gds.brutto-qnty
     3271                   , input buf_fbr-recipe-gds.calc-method
     3272                   , output buf_fbr-recipe-gds.qnty
     3273                   , output v-void-decimal
     3274                   , output v-void-decimal
     3275                   , output v-void-integer
     3276               ).
     3277           end.
     3278       end.
     3279   end.
     3280   end procedure.
     3281   procedure fbrlib-set-default-recipe :
     3282   define input parameter p-obj-type   as character    no-undo.
     3283   define input parameter p-obj-code   as integer      no-undo.
     3284   define input parameter p-gds-code   as integer      no-undo.
     3285       define variable v-artic             as character    no-undo.
     3286       define variable v-prod-type         as character    no-undo.
     3287       define variable v-prod-code         as character    no-undo.
     3288       define variable v-recipe-code       as character    no-undo.
     3289       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3290       define variable v-recipe-found      as logical      no-undo.
     3291       define buffer buf_recipe        for ub.recipe.
     3292       define buffer buf_other_recipe  for ub.recipe.
     3293       define buffer buf_goods         for ub.goods.
     3294       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3295   do
     3296   for buf_recipe
     3297     , buf_goods
     3298     , buf_fbr-gds-obj
     3299   on error undo, return error
     3300   :
     3301       find first buf_goods no-lock
     3302            where buf_goods.gds-code = p-gds-code
     3303       .
     3304       run fbrlib-get-obj-recipe in this-procedure (
     3305             input p-obj-type
     3306           , input p-obj-code
     3307           , input p-gds-code
     3308           , output v-recipe-code
     3309       ).
     3310       if v-recipe-code <> ""
     3311       then do:
     3312           find first buf_recipe no-lock
     3313               where buf_recipe.recipe-code = v-recipe-code
     3314           no-error.
     3315           if not available buf_recipe
     3316           then do:
     3317               assign
     3318                   v-recipe-code = ""
     3319               .
     3320           end.
     3321       end.
     3322       if v-recipe-code = ""
     3323       then do:
     3324           find first buf_fbr-gds-obj exclusive-lock
     3325                where buf_fbr-gds-obj.obj-type = p-obj-type
     3326                  and buf_fbr-gds-obj.obj-code = p-obj-code
     3327                  and buf_fbr-gds-obj.gds-code = p-gds-code
     3328           no-error.
     3329           if not available buf_fbr-gds-obj
     3330           then do:
     3331               run ref/fgdsobj1.p (
     3332                     input-output v-fbr-gds-obj-recid
     3333                   , input 'ДОБАВЛЕНИЕ':U
     3334                   , input no
     3335                   , input p-gds-code
     3336                   , input p-obj-type
     3337                   , input p-obj-code
     3338                   , input 0
     3339                   , input ""
     3340                   , input 0
     3341                   , input no
     3342                   , input no
     3343                   , input no
     3344                   , input no
     3345                   , input no
     3346                   , input no
     3347               ) no-error.
     3348               if error-status:error
     3349               then do:
     3350                   message
     3351                           vss-workfile vss-revision vss-description
     3352                       skip "Ошибка изменения атрибутов товара на объекте"
     3353                       skip return-value
     3354                       skip trim(error-status :get-message(1))
     3355                               trim(error-status :get-message(2))
     3356                               trim(error-status :get-message(3))
     3357                   view-as alert-box error.
     3358                   undo, return error .
     3359               end.
     3360               find first buf_fbr-gds-obj exclusive-lock
     3361                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     3362               .
     3363           end.
     3364           assign
     3365               v-recipe-found = no
     3366           .
     3367           for first buf_recipe no-lock
     3368               where buf_recipe.obj-type    = p-obj-type
     3369                 and buf_recipe.obj-code    = p-obj-code
     3370                 and buf_recipe.artic       = buf_goods.artic
     3371                 and buf_recipe.prod-type   = buf_goods.prod-type
     3372                 and buf_recipe.prod-code   = buf_goods.prod-code
     3373                 and buf_recipe.recipe-type = 'производство':U
     3374                 or (
     3375                     buf_recipe.obj-type    = ""
     3376                 and buf_recipe.obj-code    = 0
     3377                 and buf_recipe.artic       = buf_goods.artic
     3378                 and buf_recipe.prod-type   = buf_goods.prod-type
     3379                 and buf_recipe.prod-code   = buf_goods.prod-code
     3380                 and buf_recipe.recipe-type = 'производство':U
     3381                     )
     3382           :
     3383               assign
     3384                   v-recipe-found = yes
     3385                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3386               .
     3387           end.
     3388           if v-recipe-found = no
     3389           then do:
     3390               for first buf_recipe no-lock
     3391                   where buf_recipe.obj-type    = p-obj-type
     3392                     and buf_recipe.obj-code    = p-obj-code
     3393                     and buf_recipe.artic       = buf_goods.artic
     3394                     and buf_recipe.prod-type   = buf_goods.prod-type
     3395                     and buf_recipe.prod-code   = buf_goods.prod-code
     3396                     and buf_recipe.recipe-type <> 'альтернатива':U
     3397                     or (
     3398                         buf_recipe.obj-type    = ""
     3399                     and buf_recipe.obj-code    = 0
     3400                     and buf_recipe.artic       = buf_goods.artic
     3401                     and buf_recipe.prod-type   = buf_goods.prod-type
     3402                     and buf_recipe.prod-code   = buf_goods.prod-code
     3403                     and buf_recipe.recipe-type <> 'альтернатива':U
     3404                         )
     3405               :
     3406                   assign
     3407                       v-recipe-found = yes
     3408                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3409                   .
     3410               end.
     3411               if v-recipe-found = no
     3412               then do:
     3413                   for first buf_recipe no-lock
     3414                       where buf_recipe.obj-type    = p-obj-type
     3415                         and buf_recipe.obj-code    = p-obj-code
     3416                         and buf_recipe.artic       = buf_goods.artic
     3417                         and buf_recipe.prod-type   = buf_goods.prod-type
     3418                         and buf_recipe.prod-code   = buf_goods.prod-code
     3419                         or (
     3420                             buf_recipe.obj-type    = ""
     3421                         and buf_recipe.obj-code    = 0
     3422                         and buf_recipe.artic       = buf_goods.artic
     3423                         and buf_recipe.prod-type   = buf_goods.prod-type
     3424                         and buf_recipe.prod-code   = buf_goods.prod-code
     3425                             )
     3426                   :
     3427                       assign
     3428                           v-recipe-found = yes
     3429                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3430                       .
     3431                   end.
     3432                   if v-recipe-found = no
     3433                   then do:
     3434                       assign
     3435                           buf_fbr-gds-obj.default-recipe-code = ""
     3436                       .
     3437                   end.
     3438               end.
     3439           end.
     3440       end.
     3441   end.
     3442   end procedure.
     3443   procedure fbrlib-get-obj-recipe :
     3444   define input parameter p-obj-type       as character    no-undo.
     3445   define input parameter p-obj-code       as integer      no-undo.
     3446   define input parameter p-gds-code       as integer      no-undo.
     3447   define output parameter p-recipe-code   as character    no-undo.
     3448       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3449   do
     3450   for buf_fbr-gds-obj
     3451   on error undo, return error
     3452   :
     3453       find first buf_fbr-gds-obj no-lock
     3454            where buf_fbr-gds-obj.obj-type = p-obj-type
     3455              and buf_fbr-gds-obj.obj-code = p-obj-code
     3456              and buf_fbr-gds-obj.gds-code = p-gds-code
     3457       no-error.
     3458       if available buf_fbr-gds-obj
     3459       then do:
     3460           assign
     3461               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     3462           .
     3463       end.
     3464       else do:
     3465           assign
     3466               p-recipe-code = ""
     3467           .
     3468       end.
     3469   end.
     3470   end procedure.
     3471   procedure fbrlib-create-or-update-recipe-gds :
     3472   define input parameter p-recipe-code    as character        no-undo.
     3473   define input parameter p-gds-code       as integer          no-undo.
     3474   define input parameter p-is-waste       as logical          no-undo.
     3475   define input parameter p-qnty           as decimal          no-undo.
     3476   define input parameter p-proc-number    as integer          no-undo.
     3477   define input parameter p-nws-self       as logical          no-undo.
     3478       define variable v-max-proc-num  as integer      no-undo.
     3479       define variable v-recipe-type   as character    no-undo.
     3480       define buffer buf_goods             for ub.goods.
     3481       define buffer buf_recipe-gds        for ub.recipe-gds.
     3482       define buffer buf_recipe            for ub.recipe.
     3483       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     3484   do
     3485   for buf_goods
     3486     , buf_recipe-gds
     3487     , buf_recipe
     3488     , buf_proc_recipe-gds
     3489   on error undo, return error
     3490   :
     3491       find first buf_recipe no-lock
     3492            where buf_recipe.recipe-code = p-recipe-code
     3493       .
     3494       find first buf_goods no-lock
     3495            where buf_goods.gds-code = p-gds-code
     3496       .
     3497       find first buf_recipe-gds
     3498            where buf_recipe-gds.recipe-code = p-recipe-code
     3499              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     3500              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     3501              and buf_recipe-gds.artic       = buf_goods.artic
     3502       no-error.
     3503       if not available buf_recipe-gds
     3504       then do:
     3505           create buf_recipe-gds.
     3506           assign
     3507               buf_recipe-gds.recipe-code = p-recipe-code
     3508               buf_recipe-gds.gds-code    = p-gds-code
     3509               buf_recipe-gds.prod-type   = buf_goods.prod-type
     3510               buf_recipe-gds.prod-code   = buf_goods.prod-code
     3511               buf_recipe-gds.artic       = buf_goods.artic
     3512           .
     3513           assign
     3514               buf_recipe-gds.is-waste    = no
     3515               buf_recipe-gds.qnty        = 0
     3516               buf_recipe-gds.coeff-waste = 0
     3517               buf_recipe-gds.brutto-qnty = 0
     3518               buf_recipe-gds.proc-number = 0
     3519               buf_recipe-gds.nws-self    = no
     3520           .
     3521       end.
     3522       assign
     3523           buf_recipe-gds.is-waste    = p-is-waste
     3524       .
     3525       run fbrlib-get-recipe-type in this-procedure (
     3526             input "":U
     3527           , input buf_recipe-gds.recipe-code
     3528           , output v-recipe-type
     3529       ).
     3530       if v-recipe-type <> 'производство':U
     3531       then do:
     3532           assign
     3533               buf_recipe-gds.calc-method = 1
     3534               buf_recipe-gds.qnty        = p-qnty
     3535               buf_recipe-gds.brutto-qnty = p-qnty
     3536               buf_recipe-gds.coeff-waste = 0
     3537           .
     3538       end.
     3539       else do:
     3540           assign
     3541               buf_recipe-gds.calc-method = 1
     3542               buf_recipe-gds.brutto-qnty = p-qnty
     3543           .
     3544           run fbrlib-calc-brutto in this-procedure (
     3545                 input v-recipe-type
     3546               , input 0
     3547               , input 0
     3548               , input buf_recipe-gds.coeff-waste
     3549               , input buf_recipe-gds.brutto-qnty
     3550               , input 1
     3551               , output buf_recipe-gds.qnty
     3552               , output buf_recipe-gds.coeff-waste
     3553               , output buf_recipe-gds.brutto-qnty
     3554               , output buf_recipe-gds.calc-method
     3555           ).
     3556       end.
     3557       assign
     3558           buf_recipe-gds.nws-self    = p-nws-self
     3559       .
     3560       if buf_recipe.recipe-type = 'альтернатива':U
     3561       and buf_recipe-gds.proc-number <> 0
     3562       then do:
     3563       end.
     3564       else do:
     3565           if p-proc-number <> 0
     3566           then do:
     3567               assign
     3568                   buf_recipe-gds.proc-number = p-proc-number
     3569               .
     3570           end.
     3571           else do:
     3572               assign
     3573                   v-max-proc-num = 0
     3574               .
     3575               for each buf_proc_recipe-gds no-lock
     3576                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     3577               :
     3578                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     3579                   then do:
     3580                       assign
     3581                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     3582                       .
     3583                   end.
     3584               end.
     3585               assign
     3586                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     3587               .
     3588           end.
     3589       end.
     3590   end.
     3591   end procedure.
     3592   PROCEDURE fbrlib-create-or-update-recipe :
     3593   define input parameter p-mode               as character    no-undo.
     3594   define input parameter p-obj-type           as character    no-undo.
     3595   define input parameter p-obj-code           as integer      no-undo.
     3596   define input parameter p-recipe-code        as character    no-undo.
     3597   define input parameter p-recipe-type        as character    no-undo.
     3598   define input parameter p-gds-code           as integer      no-undo.
     3599   define input parameter p-name               as character    no-undo.
     3600   define input parameter p-design             as character    no-undo.
     3601   define input parameter p-order              as integer      no-undo.
     3602   define input parameter p-quality            as character    no-undo.
     3603   define input parameter p-ref-num            as character    no-undo.
     3604   define input parameter p-technique          as character    no-undo.
     3605   define input parameter p-template           as character    no-undo.
     3606   define input parameter p-qnty               as decimal      no-undo.
     3607   define input parameter p-portion-qnty       as integer      no-undo.
     3608   define input parameter p-portion-weight     as decimal      no-undo.
     3609   define output parameter p-new-recipe-code   as character    no-undo.
     3610       define variable v-host-code         as integer      no-undo.
     3611       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3612       define buffer buf_recipe    for ub.recipe.
     3613       define buffer buf_goods     for ub.goods.
     3614   do
     3615   for buf_recipe
     3616     , buf_goods
     3617   on error undo, return error
     3618   :
     3619       if p-mode <> 'ДОБАВЛЕНИЕ':U
     3620       and p-mode <> 'ИЗМЕНЕНИЕ':U
     3621       then do:
     3622           message
     3623               skip "Ошибка задания типа операции для создания или измения рецепта."
     3624               skip (1)
     3625               skip "Задан тип операции:" p-mode
     3626           view-as alert-box error.
     3627           undo, return error .
     3628       end.
     3629       if p-recipe-code = ""
     3630       then do:
     3631   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3632   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3633     (input  p-obj-type
     3634     ,input  p-obj-code
     3635     ,output v-host-code
     3636     )  .
     3637           find first buf_goods no-lock
     3638                where buf_goods.gds-code = p-gds-code
     3639           .
     3640           create buf_recipe .
     3641           run fbrcode-gen-recipe-code in this-procedure (
     3642                 input p-obj-type
     3643               , input p-obj-code
     3644               , output buf_recipe.recipe-code
     3645           ).
     3646           assign
     3647               buf_recipe.artic               = buf_goods.artic
     3648               buf_recipe.prod-type           = buf_goods.prod-type
     3649               buf_recipe.prod-code           = buf_goods.prod-code
     3650               buf_recipe.recipe-type         = p-recipe-type
     3651               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3652               buf_recipe.gds-code            = p-gds-code
     3653               buf_recipe.host-code           = v-host-code
     3654               buf_recipe.obj-type            = p-obj-type
     3655               buf_recipe.obj-code            = p-obj-code
     3656               buf_recipe.recipe-design       = ""
     3657               buf_recipe.recipe-order        = 0
     3658               buf_recipe.recipe-quality      = ""
     3659               buf_recipe.recipe-ref-num      = ""
     3660               buf_recipe.recipe-technique    = ""
     3661               buf_recipe.recipe-template     = ""
     3662               buf_recipe.qnty                = 1.0
     3663               buf_recipe.portion-qnty        = 1
     3664               buf_recipe.portion-weight      = 0
     3665           .
     3666       end.
     3667       if p-name <> ""
     3668       then do:
     3669           assign
     3670               buf_recipe.recipe-name = p-name
     3671           .
     3672       end.
     3673       assign
     3674           buf_recipe.recipe-design       = p-design
     3675           buf_recipe.recipe-order        = p-order
     3676           buf_recipe.recipe-quality      = p-quality
     3677           buf_recipe.recipe-ref-num      = p-ref-num
     3678           buf_recipe.recipe-technique    = p-technique
     3679           buf_recipe.recipe-template     = p-template
     3680           buf_recipe.qnty                = p-qnty
     3681           buf_recipe.portion-qnty        = p-portion-qnty
     3682           buf_recipe.portion-weight      = p-portion-weight
     3683       .
     3684       assign
     3685           p-new-recipe-code = buf_recipe.recipe-code
     3686       .
     3687       run fbrlib-set-default-recipe in this-procedure (
     3688             input p-obj-type
     3689           , input p-obj-code
     3690           , input buf_goods.gds-code
     3691       ).
     3692   end.
     3693   END PROCEDURE.
     3694   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3695   define input parameter parparentproc-handle as widget-handle no-undo .
     3696   define input parameter p-doc-code   as character no-undo.
     3697   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3698       define variable v-shift-on      as logical      no-undo.
     3699       define variable v-shift-date    as date         no-undo.
     3700       define variable v-shift-num     as integer      no-undo.
     3701       define variable v-shift-name    as character    no-undo.
     3702       define variable v-obj-date      as date         no-undo.
     3703       define variable v-chip-num      as integer      no-undo.
     3704       define buffer buf_fbr-doc       for ub.fbr-doc.
     3705       define buffer buf_fbr-line      for ub.fbr-line.
     3706       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3707       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3708       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3709       define buffer buf_marking-lines for ub.marking-lines .
     3710       define buffer buf_marking       for ub.marking .
     3711       define buffer buf_goods         for ub.goods .
     3712   do
     3713   for buf_fbr-doc
     3714     , buf_fbr-line
     3715     , buf_c-fbr-doc
     3716     , buf_fbr-recipe
     3717     , buf_fbr-recipe-gds
     3718     , buf_goods
     3719     , buf_marking
     3720     , buf_marking-lines
     3721   on error undo, return error
     3722   :
     3723   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3724     define variable v-cntxt-db-num        as integer   no-undo .
     3725     define variable v-cntxt-userid        as character no-undo .
     3726     define variable v-cntxt-level         as character no-undo .
     3727     define variable v-cntxt-host-code-obj as integer   no-undo .
     3728     define variable v-cntxt-obj-type      as character no-undo .
     3729     define variable v-cntxt-obj-code      as integer   no-undo .
     3730     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3731     define variable v-cntxt-is-admin      as logical   no-undo .
     3732   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3733     run mainmenu_getcntxt in parparentproc-handle
     3734       (output v-cntxt-db-num
     3735       ,output v-cntxt-userid
     3736       ,output v-cntxt-level
     3737       ,output v-cntxt-host-code-obj
     3738       ,output v-cntxt-obj-type
     3739       ,output v-cntxt-obj-code
     3740       ,output v-cntxt-db-num-obj
     3741       ,output v-cntxt-is-admin
     3742       ) .
     3743       if search ("delfbr.err") <> ?
     3744       then do:
     3745           os-delete "delfbr.err".
     3746       end.
     3747     _del-block:
     3748       do transaction
     3749     on error undo _del-block, return error return-value
     3750     on endkey undo _del-block , return error return-value
     3751     on stop undo _del-block , return error return-value
     3752       :
     3753           find first buf_fbr-doc exclusive-lock
     3754                where buf_fbr-doc.doc-code = p-doc-code
     3755           no-error.
     3756           if not available buf_fbr-doc
     3757           then do:
     3758         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3759                                           ,vss-workfile
     3760                                           ,vss-revision
     3761                                           ,vss-description
     3762                                           ,chr(10)
     3763                                           , p-doc-code).
     3764           end.
     3765           run fbrlib-delete-fact-trn-doc in this-procedure (
     3766               input parparentproc-handle
     3767              ,input p-doc-code
     3768              ,input 'при':U
     3769              ,input p-chip-num
     3770              ,output v-chip-num
     3771           ) no-error.
     3772           if error-status :error
     3773           then do:
     3774               run fbrlib-print-del-error-message in this-procedure .
     3775         undo _del-block, return error.
     3776           end.
     3777           assign
     3778           p-chip-num = (if p-chip-num = ?
     3779                         then v-chip-num
     3780                         else p-chip-num).
     3781           run fbrlib-delete-fact-trn-doc in this-procedure (
     3782               input parparentproc-handle
     3783              ,input p-doc-code
     3784              ,input 'рас':U
     3785              ,input p-chip-num
     3786              ,output v-chip-num
     3787           ) no-error.
     3788           if error-status :error
     3789           then do:
     3790               run fbrlib-print-del-error-message in this-procedure .
     3791         undo _del-block, return error.
     3792           end.
     3793           run fbrlib-delete-fact-trn-doc in this-procedure (
     3794               input parparentproc-handle
     3795              ,input p-doc-code
     3796              ,input 'спи':U
     3797              ,input p-chip-num
     3798              ,output v-chip-num
     3799           ) no-error.
     3800           if error-status :error
     3801           then do:
     3802               run fbrlib-print-del-error-message in this-procedure .
     3803         undo _del-block, return error.
     3804           end.
     3805           create buf_c-fbr-doc.
     3806           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3807   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3808   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3809     (input  buf_fbr-doc.obj-type
     3810     ,input  buf_fbr-doc.obj-code
     3811     ,output v-obj-date
     3812     ) no-error .
     3813           if error-status :error
     3814           or v-obj-date = ?
     3815           then do:
     3816         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3817           end.
     3818   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3819   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3820     (input  buf_fbr-doc.obj-type
     3821     ,input  buf_fbr-doc.obj-code
     3822     ,input  'shift-on=request'
     3823     ,output v-shift-on
     3824     )  .
     3825           if v-shift-on
     3826           then do:
     3827   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3828   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3829     (input  buf_fbr-doc.obj-type
     3830     ,input  buf_fbr-doc.obj-code
     3831     ,output v-shift-date
     3832     ,output v-shift-num
     3833     ,output v-shift-name
     3834     ) no-error .
     3835               if error-status :error
     3836               then do:
     3837           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3838               end.
     3839           end.
     3840           else do:
     3841               assign
     3842                   v-shift-date = ?
     3843                   v-shift-num  = ?
     3844                   v-shift-name = ?
     3845               .
     3846           end.
     3847           define variable v-today       as date         no-undo.
     3848           define variable v-time        as integer      no-undo.
     3849           run cur-time in this-procedure (
     3850                 output v-today
     3851               , output v-time
     3852           ).
     3853           assign
     3854               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3855               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3856               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3857               buf_c-fbr-doc.corr-date        = v-today
     3858               buf_c-fbr-doc.corr-time        = v-time
     3859               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3860               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3861               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3862               buf_c-fbr-doc.is-del           = yes
     3863           .
     3864           assign
     3865               buf_fbr-doc.is-del = yes
     3866           .
     3867           for each buf_fbr-line exclusive-lock
     3868              where buf_fbr-line.doc-code = p-doc-code
     3869       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3870       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3871       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3872           :
     3873               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3874                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3875                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3876               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3877                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3878                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3879                                                       and buf_marking-lines.in-code  = "manufacturing"
     3880                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3881                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3882                                                       and buf_marking-lines.prt-code = 0
     3883               :
     3884                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3885                   assign
     3886                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3887                   .
     3888                 end .
     3889                 delete buf_marking-lines.
     3890               end .
     3891               delete buf_fbr-line.
     3892           end.
     3893           for each buf_fbr-recipe exclusive-lock
     3894              where buf_fbr-recipe.doc-code = p-doc-code
     3895       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3896       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3897       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3898           :
     3899               delete buf_fbr-recipe.
     3900           end.
     3901           for each buf_fbr-recipe-gds exclusive-lock
     3902              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3903       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3904       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3905       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3906           :
     3907               delete buf_fbr-recipe-gds.
     3908           end.
     3909           delete buf_fbr-doc.
     3910       end.
     3911   end.
     3912   END PROCEDURE.
     3913   PROCEDURE fbrlib-del-trn-doc :
     3914   do
     3915   on error undo, return error
     3916   :
     3917   define input parameter parparentproc        as widget-handle no-undo .
     3918   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3919   define input parameter p-trn-doc-type       as character    no-undo.
     3920   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3921   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3922       define variable v-trn-doc-doc-code  as character     no-undo.
     3923       define buffer buf_trn-doc       for ub.trn-doc.
     3924   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3925     define variable v-cntxt-db-num        as integer   no-undo .
     3926     define variable v-cntxt-userid        as character no-undo .
     3927     define variable v-cntxt-level         as character no-undo .
     3928     define variable v-cntxt-host-code-obj as integer   no-undo .
     3929     define variable v-cntxt-obj-type      as character no-undo .
     3930     define variable v-cntxt-obj-code      as integer   no-undo .
     3931     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3932     define variable v-cntxt-is-admin      as logical   no-undo .
     3933   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3934     run mainmenu_getcntxt in parparentproc
     3935       (output v-cntxt-db-num
     3936       ,output v-cntxt-userid
     3937       ,output v-cntxt-level
     3938       ,output v-cntxt-host-code-obj
     3939       ,output v-cntxt-obj-type
     3940       ,output v-cntxt-obj-code
     3941       ,output v-cntxt-db-num-obj
     3942       ,output v-cntxt-is-admin
     3943       ) .
     3944       run fbrcode-trn-doc in this-procedure (
     3945             input 'производство':U
     3946           , input p-fbr-doc-doc-code
     3947           , input p-trn-doc-type
     3948           , output v-trn-doc-doc-code
     3949       ).
     3950       find first buf_trn-doc no-lock
     3951            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3952       no-error.
     3953       if available buf_trn-doc
     3954       then do:
     3955           run str/del-doc.p (
     3956                 input parparentproc
     3957               , input buf_trn-doc.doc-code
     3958               , input v-cntxt-db-num
     3959               , input "del-doc.err"
     3960               , input ?
     3961               , input p-fbr-doc-doc-code
     3962               , input v-cntxt-userid
     3963               , input 0
     3964               , input p-phchip-num
     3965               , output p-chip-num
     3966           ) no-error.
     3967           if error-status :error
     3968           then do:
     3969             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3970                                           ,v-trn-doc-doc-code
     3971                                           ,p-fbr-doc-doc-code
     3972                                           , chr(10)
     3973                                           , error-status:get-message(1)
     3974                                           , return-value ).
     3975           end.
     3976       end.
     3977   end.
     3978   END PROCEDURE.
     3979   PROCEDURE fbrlib-delete-fact-trn-doc :
     3980   define input parameter parparentproc    as widget-handle    no-undo.
     3981   define input parameter p-fbr-doc-code   as character        no-undo.
     3982   define input parameter p-doc-type       as character    no-undo.
     3983   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3984   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3985       define variable v-doc-code          as character        no-undo.
     3986       define variable v-ext-doc-type      as character        no-undo.
     3987       define variable v-trn-doc-recid     as recid            no-undo.
     3988       define variable varchip-code        as integer          no-undo.
     3989       define variable varchip-code2       as integer          no-undo.
     3990       define variable v-chip-counter      as integer          no-undo.
     3991       define buffer buf_trn-doc       for ub.trn-doc.
     3992       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3993       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3994   do
     3995   for buf_trn-doc
     3996     , buf_pri_trn-doc
     3997     , buf_cons_trn-doc
     3998   on error undo, return error
     3999   :
     4000   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4001     define variable v-cntxt-db-num        as integer   no-undo .
     4002     define variable v-cntxt-userid        as character no-undo .
     4003     define variable v-cntxt-level         as character no-undo .
     4004     define variable v-cntxt-host-code-obj as integer   no-undo .
     4005     define variable v-cntxt-obj-type      as character no-undo .
     4006     define variable v-cntxt-obj-code      as integer   no-undo .
     4007     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4008     define variable v-cntxt-is-admin      as logical   no-undo .
     4009   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4010     run mainmenu_getcntxt in parparentproc
     4011       (output v-cntxt-db-num
     4012       ,output v-cntxt-userid
     4013       ,output v-cntxt-level
     4014       ,output v-cntxt-host-code-obj
     4015       ,output v-cntxt-obj-type
     4016       ,output v-cntxt-obj-code
     4017       ,output v-cntxt-db-num-obj
     4018       ,output v-cntxt-is-admin
     4019       ) .
     4020       run fbrcode-trn-doc in this-procedure (
     4021             input 'производство':U
     4022           , input p-fbr-doc-code
     4023           , input p-doc-type
     4024           , output v-doc-code
     4025       ).
     4026       find first buf_trn-doc no-lock
     4027            where buf_trn-doc.doc-code = v-doc-code
     4028       no-error.
     4029       if not available buf_trn-doc
     4030       then do:
     4031           if p-doc-type <> 'спи':U
     4032           then do:
     4033               message
     4034                   "Не найден документ '" p-doc-type "'"
     4035                   "по документу производства " p-fbr-doc-code
     4036               view-as alert-box.
     4037               undo, return error.
     4038           end.
     4039           else do:
     4040           end.
     4041       end.
     4042       else do:
     4043           assign
     4044               v-trn-doc-recid = recid( buf_trn-doc )
     4045               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     4046           .
     4047           if v-ext-doc-type = 'ev':U
     4048           then do:
     4049               find first buf_pri_trn-doc no-lock
     4050                    where buf_pri_trn-doc.out-code     = v-doc-code
     4051                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     4052               no-error.
     4053               if available buf_pri_trn-doc
     4054               then do:
     4055                   run str/del-doc.p (
     4056                         input parparentproc
     4057                       , input buf_pri_trn-doc.doc-code
     4058                       , input v-cntxt-db-num
     4059                       , input "delfbr.err"
     4060                       , input ?
     4061                       , input p-fbr-doc-code
     4062                       , input v-cntxt-userid
     4063                       , input 0
     4064                       , input (if p-ph-chip-num <> ?
     4065                               then p-ph-chip-num
     4066                               else (if varchip-code <> 0
     4067                                   then varchip-code
     4068                                   else ?)
     4069                               )
     4070                       , output varchip-code2
     4071                   ) no-error.
     4072                   if error-status :error
     4073                   then do:
     4074                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     4075                                                   ,buf_pri_trn-doc.doc-code
     4076                                                   ,p-fbr-doc-code
     4077                                                   , chr(10)
     4078                                                   , error-status:get-message(1)
     4079                                                   , return-value ).
     4080                   end.
     4081               end.
     4082           end.
     4083           define buffer buf_out_trn-doc       for ub.trn-doc.
     4084           if p-doc-type = 'при':U
     4085           then do:
     4086               assign
     4087                   v-chip-counter = 0
     4088               .
     4089               for each buf_out_trn-doc exclusive-lock
     4090                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     4091               on error undo, return error
     4092               :
     4093                   assign
     4094                       v-chip-counter = v-chip-counter + 1
     4095                   .
     4096                   if v-chip-counter > 1
     4097                   then do:
     4098                       assign
     4099                           varchip-code = varchip-code2
     4100                       .
     4101                   end.
     4102                   run str/del-doc.p (
     4103                         input parparentproc
     4104                       , input buf_out_trn-doc.doc-code
     4105                       , input v-cntxt-db-num
     4106                       , input "delfbr.err"
     4107                       , input ?
     4108                       , input p-fbr-doc-code
     4109                       , input v-cntxt-userid
     4110                       , input 0
     4111                       , input (if p-ph-chip-num <> ?
     4112                               then p-ph-chip-num
     4113                               else (if varchip-code <> 0
     4114                                   then varchip-code
     4115                                   else ?)
     4116                               )
     4117                       , output varchip-code2
     4118                   ) no-error.
     4119                   if error-status :error
     4120                   then do:
     4121                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     4122                                                   ,buf_out_trn-doc.doc-code
     4123                                                   ,buf_trn-doc.doc-code
     4124                                                   ,p-fbr-doc-code
     4125                                                   , chr(10)
     4126                                                   , error-status:get-message(1)
     4127                                                   , return-value ).
     4128                   end.
     4129               end.
     4130           end.
     4131           run str/del-doc.p (
     4132                 input parparentproc
     4133               , input buf_trn-doc.doc-code
     4134               , input v-cntxt-db-num
     4135               , input "delfbr.err"
     4136               , input ?
     4137               , input p-fbr-doc-code
     4138               , input v-cntxt-userid
     4139               , input 0
     4140               , input (if p-ph-chip-num <> ?
     4141                        then p-ph-chip-num
     4142                        else (if varchip-code <> 0
     4143                              then varchip-code
     4144                              else ?)
     4145                        )
     4146               , output varchip-code2
     4147           ) no-error.
     4148           if error-status :error
     4149           then do:
     4150               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     4151                                             ,buf_trn-doc.doc-code
     4152                                             ,p-fbr-doc-code
     4153                                             , chr(10)
     4154                                             , error-status:get-message(1)
     4155                                             , return-value ).
     4156           end.
     4157           if p-doc-type = 'рас':U
     4158           or p-doc-type = 'спи':U
     4159           then do:
     4160               assign
     4161                   v-chip-counter = 0
     4162               .
     4163               for each buf_cons_trn-doc no-lock
     4164                  where buf_cons_trn-doc.out-code      = v-doc-code
     4165                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     4166               :
     4167                   assign
     4168                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     4169                       v-chip-counter = v-chip-counter + 1
     4170                   .
     4171                   assign
     4172                   varchip-code = if v-chip-counter = 2
     4173                                  then varchip-code2
     4174                                  else varchip-code.
     4175                   run str/del-doc.p (
     4176                         input parparentproc
     4177                       , input buf_cons_trn-doc.doc-code
     4178                       , input v-cntxt-db-num
     4179                       , input "delfbr.err"
     4180                       , input ?
     4181                       , input ?
     4182                       , input v-cntxt-userid
     4183                       , input 0
     4184                       , input (if p-ph-chip-num <> ?
     4185                                then p-ph-chip-num
     4186                                else ( if v-chip-counter = 1
     4187                                       then ?
     4188                                       else varchip-code )
     4189                                )
     4190                       , output varchip-code2
     4191                   ) no-error.
     4192                   if error-status :error
     4193                   then do:
     4194                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     4195                                                     ,buf_cons_trn-doc.doc-code
     4196                                                     ,p-fbr-doc-code
     4197                                                     , chr(10)
     4198                                                     , error-status:get-message(1)
     4199                                                     , return-value ).
     4200                   end.
     4201                   assign
     4202                       p-chip-num = varchip-code2
     4203                   .
     4204               end.
     4205           end.
     4206           assign
     4207               p-chip-num = varchip-code2
     4208           .
     4209       end.
     4210   end.
     4211   END PROCEDURE.
     4212   PROCEDURE fbrlib-print-del-error-message :
     4213   do
     4214   on error undo, return error
     4215   :
     4216       define variable v-user-action   as character    no-undo.
     4217       define variable v-printed       as logical      no-undo.
     4218       message
     4219           vss-workfile vss-revision vss-description
     4220           skip "Ошибка при удалении документа."
     4221           skip return-value
     4222           skip trim(error-status :get-message(1))
     4223           skip trim(error-status :get-message(2))
     4224           skip trim(error-status :get-message(3))
     4225       view-as alert-box error.
     4226       if search ("delfbr.err") <> ?
     4227       then do:
     4228         run gbl/prnfilen.w
     4229           (input  "Ошибки при удалении документа производства"
     4230           ,input  0
     4231           ,input  "delfbr.err"
     4232           ,input  7
     4233           ,output v-user-action
     4234           ,output v-printed
     4235           ).
     4236       end.
     4237   end.
     4238   END PROCEDURE.
     4239   procedure fbrlib-calc-brutto :
     4240   define input parameter p-recipe-type        as character        no-undo.
     4241   define input parameter p-netto              as decimal          no-undo.
     4242   define input parameter p-coeff-value        as decimal          no-undo.
     4243   define input parameter p-coeff-waste        as decimal          no-undo.
     4244   define input parameter p-brutto             as decimal          no-undo.
     4245   define input parameter p-calc-method        as integer          no-undo.
     4246   define output parameter p-new-netto         as decimal          no-undo.
     4247   define output parameter p-new-coeff-waste   as decimal          no-undo.
     4248   define output parameter p-new-brutto        as decimal          no-undo.
     4249   define output parameter p-new-calc-method   as integer          no-undo.
     4250   do
     4251   on error undo, return error
     4252   :
     4253       if p-recipe-type <> 'производство':U
     4254       then do:
     4255           assign
     4256               p-new-coeff-waste = 0
     4257               p-new-calc-method = 1
     4258               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     4259               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     4260           .
     4261       end.
     4262       else do:
     4263           assign
     4264               p-new-calc-method = p-calc-method
     4265           .
     4266           if p-coeff-waste = 0
     4267           then do:
     4268               assign
     4269                   p-coeff-value = 0
     4270               .
     4271           end.
     4272           case p-calc-method
     4273           :
     4274               when 1
     4275               then do:
     4276                   assign
     4277                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     4278                       p-new-coeff-waste   = p-coeff-waste
     4279                       p-new-brutto        = p-brutto
     4280                   .
     4281               end.
     4282               when 2
     4283               then do:
     4284                   assign
     4285                       p-new-netto         = p-netto
     4286                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     4287                       p-new-brutto        = p-brutto
     4288                   .
     4289               end.
     4290               when 3
     4291               then do:
     4292                   assign
     4293                       p-new-netto         = p-netto
     4294                       p-new-coeff-waste   = p-coeff-waste
     4295                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     4296                   .
     4297               end.
     4298               otherwise do:
     4299                   define variable v-yesno    as logical      no-undo.
     4300                   assign
     4301                       v-yesno = yes
     4302                   .
     4303                   message
     4304                       "Неверный метод для расчета брутто, нетто и процента потерь."
     4305                       skip "Значение метода должно быть 1, 2 или 3."
     4306                       skip(1)
     4307                       skip "Заданное значение:" p-calc-method
     4308                       skip(1)
     4309                       skip "Установить значение метода расчета 1"
     4310                       skip "(расчет нетто по брутто и проценту потерь)?"
     4311                   view-as alert-box warning
     4312                   buttons yes-no
     4313                   title "Неверное значение метода пересчета в строках документа-производства"
     4314                   update v-yesno
     4315                   .
     4316                   if v-yesno = yes
     4317                   then do:
     4318                       assign
     4319                           p-new-calc-method   = 1
     4320                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     4321                           p-new-coeff-waste   = p-coeff-waste
     4322                           p-new-brutto        = p-brutto
     4323                       .
     4324                   end.
     4325                   else do:
     4326                       message
     4327                               vss-workfile vss-revision vss-description
     4328                           skip(1)
     4329                           skip "Ошибка расчета брутто, нетто и процента потерь."
     4330                           skip return-value
     4331                           skip trim(error-status :get-message(1))
     4332                               trim(error-status :get-message(2))
     4333                               trim(error-status :get-message(3))
     4334                       view-as alert-box error
     4335                       title "Неверное значение метода расчета"
     4336                       .
     4337                       undo, return error .
     4338                   end.
     4339               end.
     4340           end case.
     4341       end.
     4342   end.
     4343   end procedure.
     4344   procedure fbrlib-check-brutto :
     4345   define input parameter p-recipe-type        as character        no-undo.
     4346   define input parameter p-netto              as decimal          no-undo.
     4347   define input parameter p-coeff-value        as decimal          no-undo.
     4348   define input parameter p-coeff-waste        as decimal          no-undo.
     4349   define input parameter p-brutto             as decimal          no-undo.
     4350   define input parameter p-calc-method        as integer          no-undo.
     4351   define output parameter p-error-message     as character        no-undo.
     4352   define output parameter p-not-good          as logical          no-undo.
     4353   do
     4354   on error undo, return error
     4355   :
     4356       if p-recipe-type <> 'производство':U
     4357       then do:
     4358           if p-netto <> p-brutto
     4359           or p-coeff-waste <> 0
     4360           then do:
     4361               assign
     4362                   p-not-good      = yes
     4363                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     4364                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     4365               .
     4366           end.
     4367       end.
     4368       else do:
     4369           if p-coeff-waste = 0
     4370           then do:
     4371               assign
     4372                   p-coeff-value = 0
     4373               .
     4374           end.
     4375           case p-calc-method
     4376           :
     4377               when 1
     4378               then do:
     4379                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     4380                   then do:
     4381                       assign
     4382                           p-not-good      = yes
     4383                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     4384                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4385                       .
     4386                   end.
     4387               end.
     4388               when 2
     4389               then do:
     4390                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     4391                   then do:
     4392                       assign
     4393                           p-not-good      = yes
     4394                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     4395                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     4396                       .
     4397                   end.
     4398               end.
     4399               when 3
     4400               then do:
     4401                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     4402                   then do:
     4403                       assign
     4404                           p-not-good      = yes
     4405                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     4406                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4407                       .
     4408                   end.
     4409               end.
     4410               otherwise do:
     4411                   assign
     4412                       p-not-good      = yes
     4413                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     4414                   .
     4415               end.
     4416           end case.
     4417       end.
     4418   end.
     4419   end procedure.
     4420   procedure fbrlib-check-fbr-recipe :
     4421   define input parameter p-doc-code       as character        no-undo.
     4422   define input parameter p-recipe-code    as character        no-undo.
     4423   define output parameter p-is-correct    as logical          no-undo.
     4424       define variable v-comp-factor    as decimal      no-undo.
     4425       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4426       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4427       define buffer buf_fbr-line          for ub.fbr-line.
     4428   do
     4429   for buf_fbr-recipe
     4430     , buf_fbr-recipe-gds
     4431     , buf_fbr-line
     4432   on error undo, return error
     4433   :
     4434       assign
     4435           p-is-correct = yes
     4436       .
     4437       find first buf_fbr-recipe no-lock
     4438            where buf_fbr-recipe.doc-code    = p-doc-code
     4439              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     4440       .
     4441       if not available buf_fbr-recipe then do:
     4442         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     4443       end.
     4444       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4445       then do:
     4446       end.
     4447       else do:
     4448           find first buf_fbr-line no-lock
     4449                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     4450                  and buf_fbr-line.is-comp     = yes
     4451                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     4452                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     4453                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     4454                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     4455           .
     4456           assign
     4457               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     4458           .
     4459           recipe-line-cycle:
     4460           for each buf_fbr-recipe-gds no-lock
     4461              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4462                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4463           on error undo, return error
     4464           :
     4465               find first buf_fbr-line no-lock
     4466                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4467                      and buf_fbr-line.is-comp     = no
     4468                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4469                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4470                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4471                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4472               .
     4473               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     4474               then do:
     4475                   assign
     4476                       p-is-correct = no
     4477                   .
     4478                   leave recipe-line-cycle.
     4479               end.
     4480           end.
     4481       end.
     4482   end.
     4483   end procedure.
     4484   procedure fbrlib-get-recipe-type :
     4485   define input parameter p-fbr-doc-code   as character        no-undo.
     4486   define input parameter p-recipe-code    as character        no-undo.
     4487   define output parameter p-recipe-type   as character        no-undo.
     4488       define buffer buf_recipe        for ub.recipe.
     4489       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     4490   do
     4491   for buf_recipe
     4492     , buf_fbr-recipe
     4493   on error undo, return error
     4494   :
     4495       if p-fbr-doc-code = ""
     4496       then do:
     4497           find first buf_recipe no-lock
     4498                where buf_recipe.recipe-code = p-recipe-code
     4499           no-error.
     4500           if available buf_recipe
     4501           then do:
     4502               assign
     4503                   p-recipe-type = buf_recipe.recipe-type
     4504               .
     4505           end.
     4506           else do:
     4507               assign
     4508                   p-recipe-type = "":U
     4509               .
     4510           end.
     4511       end.
     4512       else do:
     4513           find first buf_fbr-recipe no-lock
     4514                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     4515                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     4516           no-error.
     4517           if available buf_fbr-recipe
     4518           then do:
     4519               assign
     4520                   p-recipe-type = buf_fbr-recipe.recipe-type
     4521               .
     4522           end.
     4523           else do:
     4524               assign
     4525                   p-recipe-type = "":U
     4526               .
     4527           end.
     4528       end.
     4529   end.
     4530   end procedure.
     4531   PROCEDURE calc-comp-from-ingr :
     4532   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     4533   define input parameter p-fact-qnty                          as decimal      no-undo.
     4534   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     4535   define output parameter p-comp-qnty                         as decimal      no-undo.
     4536       define variable v-ingr-qnty     as decimal       no-undo.
     4537       define buffer buf_i_fbr-line    for ub.fbr-line.
     4538       define buffer buf_fbr-line      for ub.fbr-line.
     4539       define buffer buf_recipe        for ub.fbr-recipe.
     4540       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     4541   do
     4542   for buf_i_fbr-line
     4543     , buf_fbr-line
     4544     , buf_recipe
     4545     , buf_recipe-gds
     4546   on error undo, return error
     4547   :
     4548       find first buf_i_fbr-line no-lock
     4549            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     4550       .
     4551       find first buf_recipe no-lock
     4552            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     4553              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     4554       no-error.
     4555       if not available buf_recipe
     4556       then do:
     4557           message
     4558                   vss-workfile vss-revision vss-description
     4559               skip "В строке производства не указан рецепт."
     4560               skip "Невозможно рассчитать количество составного товара."
     4561               skip return-value
     4562               skip trim(error-status :get-message(1))
     4563                   trim(error-status :get-message(2))
     4564                   trim(error-status :get-message(3))
     4565           view-as alert-box error.
     4566           undo, return error .
     4567       end.
     4568       if buf_recipe.recipe-type = 'альтернатива':U
     4569       then do:
     4570           for each buf_fbr-line no-lock
     4571              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4572                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     4573                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4574           on error undo, return error
     4575           :
     4576               find first buf_recipe-gds no-lock
     4577                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4578                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4579                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     4580                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     4581                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     4582               .
     4583               assign
     4584                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     4585               .
     4586           end.
     4587           assign
     4588               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     4589           .
     4590       end.
     4591       else do:
     4592           find first buf_recipe-gds no-lock
     4593                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4594                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4595                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     4596                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     4597                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     4598           .
     4599           assign
     4600               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     4601           .
     4602       end.
     4603       find first buf_fbr-line no-lock
     4604            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4605              and buf_fbr-line.is-comp     = yes
     4606              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4607       .
     4608       assign
     4609           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     4610       .
     4611   end.
     4612   END PROCEDURE.
     4613   PROCEDURE get-temp_dressing-ingr-used-qnty :
     4614   define input parameter p-recipe-code    as character    no-undo.
     4615   define input parameter p-gds-code       as integer      no-undo.
     4616   define output parameter p-line-qnty     as decimal      no-undo.
     4617   define output parameter p-used-qnty     as decimal      no-undo.
     4618   define output parameter p-recipe-qnty   as decimal      no-undo.
     4619       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     4620   do
     4621   for buf_temp_dressing-ingr
     4622   on error undo, return error
     4623   :
     4624       find first buf_temp_dressing-ingr no-lock
     4625            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     4626              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     4627       no-error.
     4628       if available buf_temp_dressing-ingr
     4629       then do:
     4630           assign
     4631               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4632               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4633               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4634           .
     4635       end.
     4636       else do:
     4637           assign
     4638               p-line-qnty     = 0
     4639               p-used-qnty     = 0
     4640               p-recipe-qnty   = 0
     4641           .
     4642       end.
     4643   end.
     4644   END PROCEDURE.
     4645   PROCEDURE fbrlib_adjust-recipe :
     4646   do
     4647   on error undo, return error
     4648   :
     4649   define input parameter parparentproc as widget-handle no-undo .
     4650   define input parameter p-fbrhist-handle as handle no-undo .
     4651   define input parameter p-doc-code       as character    no-undo.
     4652   define input parameter p-recipe-code    as character    no-undo.
     4653   define input parameter p-price-sale-obj-type as character no-undo .
     4654   define input parameter p-price-sale-obj-code as integer no-undo .
     4655       define variable v-recipe-qnty       as decimal      no-undo.
     4656       define variable v-comp-qnty         as decimal      no-undo.
     4657       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4658       define variable v-ingr-qnty         as decimal      no-undo.
     4659       define variable v-qnty              as decimal      no-undo.
     4660       define variable v-coeff-waste       as decimal      no-undo.
     4661       define variable v-brutto-qnty       as decimal      no-undo.
     4662       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4663       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4664       define buffer buf_fbr-line          for ub.fbr-line.
     4665       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4666       find first buf_fbr-recipe no-lock
     4667            where buf_fbr-recipe.doc-code      = p-doc-code
     4668              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4669       .
     4670       assign
     4671           v-recipe-qnty = buf_fbr-recipe.qnty
     4672       .
     4673       find first buf_fbr-line no-lock
     4674            where buf_fbr-line.doc-code    = p-doc-code
     4675              and buf_fbr-line.is-comp     = yes
     4676              and buf_fbr-line.recipe-code = p-recipe-code
     4677       .
     4678       assign
     4679           v-comp-qnty = buf_fbr-line.fact-qnty
     4680       .
     4681       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4682       then do:
     4683       end.
     4684       else do:
     4685           for each buf_fbr-recipe-gds no-lock
     4686              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4687                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4688           on error undo, return error
     4689           :
     4690               find first buf_fbr-line no-lock
     4691                    where buf_fbr-line.doc-code    = p-doc-code
     4692                      and buf_fbr-line.is-comp     = no
     4693                      and buf_fbr-line.recipe-code = p-recipe-code
     4694                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4695                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4696                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4697               .
     4698               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4699               then do:
     4700                   do transaction
     4701                   on error undo, return error
     4702                   :
     4703                       find first buf_el_fbr-recipe-gds exclusive-lock
     4704                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4705                       .
     4706                       assign
     4707                           buf_el_fbr-recipe-gds.calc-method   = 1
     4708                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4709                       .
     4710                       run fbrlib-calc-brutto in this-procedure (
     4711                             input buf_fbr-recipe.recipe-type
     4712                           , input 0
     4713                           , input buf_el_fbr-recipe-gds.coeff-value
     4714                           , input buf_el_fbr-recipe-gds.coeff-waste
     4715                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4716                           , input 1
     4717                           , output buf_el_fbr-recipe-gds.qnty
     4718                           , output buf_el_fbr-recipe-gds.coeff-waste
     4719                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4720                           , output buf_el_fbr-recipe-gds.calc-method
     4721                       ).
     4722                   end.
     4723               end.
     4724           end.
     4725           run fbrlib_adjust-doc-lines in this-procedure (
     4726                 input parparentproc
     4727               , input p-fbrhist-handle
     4728               , input p-doc-code
     4729               , input p-recipe-code
     4730               , input p-price-sale-obj-type
     4731               , input p-price-sale-obj-code
     4732           ).
     4733       end.
     4734   end.
     4735   END PROCEDURE.
     4736   PROCEDURE fbrlib_adjust-doc-lines :
     4737   define input parameter parparentproc as widget-handle no-undo .
     4738   define input parameter p-fbrhist-handle as handle no-undo .
     4739   define input parameter p-doc-code       as character    no-undo.
     4740   define input parameter p-recipe-code    as character    no-undo.
     4741   define input parameter p-price-sale-obj-type as character no-undo .
     4742   define input parameter p-price-sale-obj-code as integer no-undo .
     4743   define variable v-comp-qnty         as decimal      no-undo.
     4744   define variable v-trn-type          as character    no-undo.
     4745   define variable v-ingr-qnty         as decimal      no-undo.
     4746   define variable v-recipe-qnty       as decimal      no-undo.
     4747   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4748   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4749   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4750   define buffer buf_fbr-line          for ub.fbr-line.
     4751   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4752   define buffer buf_goods             for ub.goods.
     4753   define buffer buf_fbr-doc           for ub.fbr-doc.
     4754   do
     4755   for buf_fbr-recipe
     4756     , buf_fbr-recipe-gds
     4757     , buf_fbr-line
     4758     , buf_coeff_fbr-line
     4759     , buf_goods
     4760     , buf_fbr-doc
     4761   on error undo, return error
     4762   :
     4763       find first buf_fbr-line no-lock
     4764            where buf_fbr-line.doc-code      = p-doc-code
     4765              and buf_fbr-line.is-comp       = yes
     4766              and buf_fbr-line.recipe-code   = p-recipe-code
     4767       .
     4768       find first buf_fbr-doc no-lock
     4769            where buf_fbr-doc.doc-code      = p-doc-code
     4770       .
     4771       assign
     4772           v-comp-qnty = buf_fbr-line.fact-qnty
     4773           v-trn-type  = buf_fbr-line.trn-type
     4774       .
     4775       find first buf_fbr-recipe no-lock
     4776            where buf_fbr-recipe.doc-code    = p-doc-code
     4777              and buf_fbr-recipe.recipe-code = p-recipe-code
     4778       .
     4779       assign
     4780       v-recipe-qnty = buf_fbr-recipe.qnty
     4781       .
     4782       do transaction
     4783       on error undo, return error
     4784       :
     4785           for each buf_fbr-recipe-gds no-lock
     4786              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4787                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4788           on error undo, return error
     4789           :
     4790               find first buf_fbr-line no-lock
     4791                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4792                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4793                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4794                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4795                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4796               no-error.
     4797               if not available buf_fbr-line
     4798               then do:
     4799                   find first buf_goods no-lock
     4800                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4801                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4802                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4803                   .
     4804                   run str/fbr-crln.p (
     4805                         input parparentproc
     4806                       , input recid( buf_fbr-doc )
     4807                       , input recid( buf_goods )
     4808                       , input buf_fbr-recipe-gds.recipe-code
     4809                       , input v-trn-type
     4810                       , input no
     4811                       , input no
     4812                       , input buf_fbr-doc.obj-type
     4813                       , input buf_fbr-doc.obj-code
     4814                       , output v-fbr-v-fbr-doc-line-recid
     4815                   ).
     4816                   find first buf_fbr-line no-lock
     4817                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4818                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4819                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4820                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4821                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4822                   no-error.
     4823                   if not available buf_fbr-line
     4824                   then do:
     4825                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4826                                                      , p-doc-code
     4827                                                      , buf_fbr-recipe-gds.artic
     4828                                                      , buf_fbr-recipe-gds.prod-type
     4829                                                      , buf_fbr-recipe-gds.prod-code).
     4830                   end.
     4831               end.
     4832               find first buf_coeff_fbr-line exclusive-lock
     4833                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4834               .
     4835               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4836               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4837               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4838               then do:
     4839                   assign
     4840                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4841                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4842                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4843                   .
     4844               end.
     4845           end.
     4846       end.
     4847       define variable v-need-goods    as logical       no-undo.
     4848       define variable v-need-goods-list       as character     no-undo.
     4849       define variable v-need-goods-qnty-list  as character     no-undo.
     4850       find first buf_fbr-line no-lock
     4851            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4852              and buf_fbr-line.is-comp     = yes
     4853              and buf_fbr-line.recipe-code = p-recipe-code
     4854       .
     4855       run str/fbr-qnty.p (
     4856             input parparentproc
     4857           , input p-fbrhist-handle
     4858           , input recid( buf_fbr-doc )
     4859           , input recid( buf_fbr-line )
     4860           , input no
     4861           , input "ingr"
     4862           , input no
     4863           , input p-price-sale-obj-type
     4864           , input p-price-sale-obj-code
     4865           , input no
     4866           , input no
     4867           , input no
     4868           , output v-need-goods
     4869           , output v-need-goods-list
     4870           , output v-need-goods-qnty-list
     4871       ).
     4872   end.
     4873   END PROCEDURE.
     4874   procedure fbrlib_check-before-close :
     4875   define input parameter p-doc-code as character no-undo .
     4876   define variable same-sale as decimal no-undo .
     4877   define variable is-waste as logical no-undo .
     4878   define variable fix-price as logical no-undo .
     4879   define buffer buf_fbr-doc for ub.fbr-doc.
     4880   define buffer buf_fbr-line for ub.fbr-line.
     4881   define buffer buf_goods for ub.goods.
     4882   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4883   do
     4884   on error undo, return error
     4885   :
     4886     for each buf_fbr-line no-lock
     4887         where buf_fbr-line.doc-code = p-doc-code
     4888       , each buf_goods no-lock
     4889         where buf_goods.artic     = buf_fbr-line.artic
     4890           and buf_goods.prod-type = buf_fbr-line.prod-type
     4891           and buf_goods.prod-code = buf_fbr-line.prod-code
     4892     break by buf_fbr-line.prod-type
     4893           by buf_fbr-line.prod-code
     4894           by buf_fbr-line.artic
     4895     :
     4896       if first-of (buf_fbr-line.artic)
     4897       then do:
     4898         assign
     4899         same-sale = buf_fbr-line.price-sale
     4900         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4901         fix-price = buf_fbr-line.is-calc
     4902         .
     4903       end.
     4904       if same-sale <> buf_fbr-line.price-sale
     4905       then do:
     4906           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4907                                         ,p-doc-code
     4908                                         ,buf_goods.artic
     4909                                         ,buf_goods.gds-name
     4910                                         ,chr(10)).
     4911       end.
     4912       if fix-price <> buf_fbr-line.is-calc then do:
     4913           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4914                                         ,p-doc-code
     4915                                         ,buf_goods.artic
     4916                                         ,buf_goods.gds-name
     4917                                         ,chr(10)).
     4918       end.
     4919       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4920       then do:
     4921         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4922                                         ,p-doc-code
     4923                                         ,buf_goods.artic
     4924                                         ,buf_goods.gds-name
     4925                                         ,chr(10)).
     4926       end.
     4927       if buf_fbr-line.rsrv-qnty <> ?
     4928       and buf_goods.gds-type <> 'у':U
     4929       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4930       and buf_fbr-line.fact-qnty <> 0
     4931       then do:
     4932         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4933           if  can-find(first buf_fbr-gds-obj no-lock where
     4934                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4935               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4936               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4937               and buf_fbr-gds-obj.is-null-price  )  then .
     4938                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4939                                         ,p-doc-code
     4940                                         ,buf_goods.artic
     4941                                         ,buf_goods.gds-name
     4942                                         ,chr(10)
     4943                                         ,buf_fbr-line.recipe-code
     4944                                         ).
     4945         end.
     4946         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4947                                         ,p-doc-code
     4948                                         ,buf_goods.artic
     4949                                         ,buf_goods.gds-name
     4950                                         ,chr(10)
     4951                                         ,buf_fbr-line.recipe-code
     4952                                         ).
     4953       end.
     4954     end.
     4955   end.
     4956   end procedure.
     4957   procedure fbrrest-get-free-qnty :
     4958   do
     4959   on error undo, return error
     4960   :
     4961   define input parameter p-obj-type       as character            no-undo.
     4962   define input parameter p-obj-code       as integer              no-undo.
     4963   define input parameter p-gds-code       as integer              no-undo.
     4964   define input parameter p-autofbr        as logical              no-undo.
     4965   define output parameter p-avail-qnty    as decimal              no-undo.
     4966       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
     4967       define variable v-free-qnty as decimal       no-undo.
     4968       define buffer buf_goods         for ub.goods.
     4969       define buffer buf_gds-obj       for ub.gds-obj.
     4970       define buffer buf_temp-parts    for temp-parts.
     4971       find first buf_goods no-lock
     4972            where buf_goods.gds-code = p-gds-code
     4973       .
     4974       assign
     4975           p-avail-qnty = 0
     4976       .
     4977       run partslib-init-temp-parts in this-procedure (
     4978             input p-obj-type
     4979           , input p-obj-code
     4980           , input buf_goods.artic
     4981           , input buf_goods.prod-type
     4982           , input buf_goods.prod-code
     4983       ).
     4984       assign
     4985           v-free-qnty = 0
     4986       .
     4987       for each buf_temp-parts
     4988       on error undo, return error
     4989       :
     4990           if buf_temp-parts.qnty > 0
     4991           then do:
     4992               assign
     4993                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
     4994               .
     4995           end.
     4996       end.
     4997       assign
     4998           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
     4999       .
     5000   end.
     5001   end procedure.
     5002   procedure fbrrest-get-catering-object :
     5003   do
     5004   on error undo, return error
     5005   :
     5006   define input parameter p-obj-code            as integer      no-undo.
     5007   define output parameter p-catering-obj-type  as character    no-undo.
     5008   define output parameter p-catering-obj-code  as integer      no-undo.
     5009       define buffer buf_shop              for ub.shop.
     5010       find first buf_shop no-lock
     5011            where buf_shop.obj-code = p-obj-code
     5012       .
     5013       assign
     5014           p-catering-obj-type = buf_shop.kitchen-store-type
     5015           p-catering-obj-code = buf_shop.kitchen-store-code
     5016       .
     5017   end.
     5018   end procedure.
     5019   define variable vss-include-info41 as character format "X(65)" no-undo
     5020   initial "@(#)$Workfile$ $Revision$".
     5021   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5022   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     5023       define variable v-upper-code as int no-undo.
     5024       define variable v-value as character no-undo.
     5025       define variable v-type as character no-undo.
     5026       define buffer lc_gds-grp for ub.gds-grp.
     5027       define buffer lc_goods for ub.goods.
     5028      if p-gds-code <> 0 then do:
     5029       find first lc_goods where lc_goods.gds-code = p-gds-code.
     5030       v-upper-code = lc_goods.grp-code.
     5031       do while v-upper-code > 0 :
     5032           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     5033           run ggoattr-value(
     5034             input lc_gds-grp.node-code,
     5035             input 0,
     5036             input "",
     5037             input 0,
     5038             input 'ban-sales-via-cd':U,
     5039             output v-value,
     5040             output v-type
     5041           ).
     5042          if v-value = "yes" then
     5043             return true.
     5044          else
     5045          do:
     5046             run ggoattr-value(
     5047                input lc_gds-grp.node-code,
     5048                input v-cntxt-host-code-obj,
     5049                input "",
     5050                input 0,
     5051                input 'ban-sales-via-cd':U,
     5052                output v-value,
     5053                output v-type
     5054                ).
     5055             if v-value = "yes" then
     5056                return true.
     5057             else
     5058             do:
     5059                run ggoattr-value(
     5060                   input lc_gds-grp.node-code,
     5061                   input v-cntxt-host-code-obj,
     5062                   input v-cntxt-obj-type,
     5063                   input v-cntxt-obj-code,
     5064                   input 'ban-sales-via-cd':U,
     5065                   output v-value,
     5066                   output v-type
     5067                   ).
     5068                if v-value = "yes" then
     5069                   return true.
     5070                else v-upper-code = lc_gds-grp.upper-code.
     5071             end .
     5072          end.
     5073         end.
     5074       end.
     5075       if v-value = "" or logical(v-value) = false then return false .
     5076   end.
     5077   FUNCTION check-ban-sales-via-cd-grp return logical ( input p-grp-code as integer ) :
     5078       define variable v-upper-code as int no-undo.
     5079       define variable v-value as character no-undo.
     5080       define variable v-type as character no-undo.
     5081       define buffer lc_gds-grp for ub.gds-grp.
     5082       define buffer lc_goods for ub.goods.
     5083       v-upper-code = p-grp-code.
     5084       do while v-upper-code > 0 :
     5085           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     5086           run ggoattr-value(
     5087             input lc_gds-grp.node-code,
     5088             input 0,
     5089             input "",
     5090             input 0,
     5091             input 'ban-sales-via-cd':U,
     5092             output v-value,
     5093             output v-type
     5094           ).
     5095          if v-value = "yes" then
     5096             return true.
     5097          else
     5098          do:
     5099             run ggoattr-value(
     5100                input lc_gds-grp.node-code,
     5101                input v-cntxt-host-code-obj,
     5102                input "",
     5103                input 0,
     5104                input 'ban-sales-via-cd':U,
     5105                output v-value,
     5106                output v-type
     5107                ).
     5108             if v-value = "yes" then
     5109                return true.
     5110             else
     5111             do:
     5112                run ggoattr-value(
     5113                   input lc_gds-grp.node-code,
     5114                   input v-cntxt-host-code-obj,
     5115                   input v-cntxt-obj-type,
     5116                   input v-cntxt-obj-code,
     5117                   input 'ban-sales-via-cd':U,
     5118                   output v-value,
     5119                   output v-type
     5120                   ).
     5121                if v-value = "yes" then
     5122                   return true.
     5123                else v-upper-code = lc_gds-grp.upper-code.
     5124             end .
     5125          end.
     5126         end.
     5127   end.
     5128   define temp-table temp_goods-qnty no-undo
     5129       field gds-code      as integer
     5130       field artic         as character
     5131       field prod-type     as character
     5132       field prod-code     as integer
     5133       field recipe-type   as character
     5134       field recipe-code   as character
     5135       field trn-type      as character
     5136       field need-qnty     as decimal
     5137       field calculated    as logical
     5138       index pi is primary unique gds-code recipe-code
     5139       index cl calculated
     5140   .
     5141   PROCEDURE create-initial-temp-goods :
     5142   do
     5143   on error undo, return error
     5144   :
     5145   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     5146   define input parameter p-artic              as character    no-undo.
     5147   define input parameter p-prod-type          as character    no-undo.
     5148   define input parameter p-prod-code          as integer      no-undo.
     5149   define input parameter p-trn-type           as character    no-undo.
     5150   define input parameter p-recipe-type        as character    no-undo.
     5151   define input parameter p-recipe-code        as character    no-undo.
     5152   define input parameter p-need-qnty          as decimal      no-undo.
     5153   define output parameter p-same-good             as logical      no-undo.
     5154   define output parameter p-same-good-old-qnty    as decimal      no-undo.
     5155       define variable v-gds-code    as integer      no-undo.
     5156       define buffer buf_fbr-doc               for ub.fbr-doc.
     5157       define buffer buf_fbr-line              for ub.fbr-line.
     5158       define buffer buf_recipe                for ub.fbr-recipe.
     5159       define buffer buf_obj_recipe            for ub.recipe.
     5160       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5161       run clear-temp-tables in this-procedure.
     5162   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5163   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     5164     (input  p-artic
     5165     ,input  p-prod-type
     5166     ,input  p-prod-code
     5167     ,output v-gds-code
     5168     )  .
     5169       create buf_temp_goods-qnty.
     5170       assign
     5171           buf_temp_goods-qnty.gds-code    = v-gds-code
     5172           buf_temp_goods-qnty.artic       = p-artic
     5173           buf_temp_goods-qnty.prod-type   = p-prod-type
     5174           buf_temp_goods-qnty.prod-code   = p-prod-code
     5175           buf_temp_goods-qnty.trn-type    = p-trn-type
     5176           buf_temp_goods-qnty.recipe-type = p-recipe-type
     5177           buf_temp_goods-qnty.recipe-code = p-recipe-code
     5178           buf_temp_goods-qnty.need-qnty   = p-need-qnty
     5179           buf_temp_goods-qnty.calculated  = no
     5180       .
     5181       assign
     5182           p-same-good                 = no
     5183           p-same-good-old-qnty        = 0
     5184       .
     5185       find first buf_fbr-doc where buf_fbr-doc.doc-code = p-fbr-doc-doc-code exclusive-lock.
     5186       for each buf_fbr-line no-lock
     5187          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     5188            and buf_fbr-line.is-comp  = yes
     5189       on error undo, return error
     5190       :
     5191           find first buf_temp_goods-qnty
     5192                where buf_temp_goods-qnty.artic        = buf_fbr-line.artic
     5193                  and buf_temp_goods-qnty.prod-type    = buf_fbr-line.prod-type
     5194                  and buf_temp_goods-qnty.prod-code    = buf_fbr-line.prod-code
     5195           no-error.
     5196           if available buf_temp_goods-qnty
     5197           then do:
     5198               assign
     5199                   p-same-good                 = yes
     5200                   p-same-good-old-qnty        = buf_fbr-line.fact-qnty
     5201                   buf_temp_goods-qnty.calculated  = no
     5202               .
     5203           end.
     5204           else do:
     5205               define variable v-recipe-type   as character     no-undo.
     5206               run copy-recipe-in-doc in this-procedure (
     5207                     input p-fbr-doc-doc-code
     5208                   , input buf_fbr-line.recipe-code
     5209                   , input buf_fbr-doc.doc-date
     5210                   , input buf_fbr-doc.obj-type
     5211                   , input buf_fbr-doc.obj-code
     5212               ).
     5213               find first buf_recipe no-lock
     5214                    where buf_recipe.doc-code      = p-fbr-doc-doc-code
     5215                      and buf_recipe.recipe-code   = buf_fbr-line.recipe-code
     5216               no-error.
     5217               if available buf_recipe
     5218               then do:
     5219                   assign
     5220                       v-recipe-type = buf_recipe.recipe-type
     5221                   .
     5222                   if v-recipe-type = 'разделка':U
     5223                   or ( v-recipe-type = 'комплектация':U
     5224                       and buf_fbr-line.trn-type = 'спи':U )
     5225                   then do:
     5226                       run fill-temp-dressing-ingr in this-procedure (
     5227                             input buf_fbr-line.doc-code
     5228                           , input buf_recipe.recipe-code
     5229                       ).
     5230                   end.
     5231               end.
     5232               else do:
     5233                   assign
     5234                       v-recipe-type = ?
     5235                   .
     5236               end.
     5237   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5238   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     5239     (input  buf_fbr-line.artic
     5240     ,input  buf_fbr-line.prod-type
     5241     ,input  buf_fbr-line.prod-code
     5242     ,output v-gds-code
     5243     )  .
     5244               create buf_temp_goods-qnty.
     5245               assign
     5246                   buf_temp_goods-qnty.gds-code    = v-gds-code
     5247                   buf_temp_goods-qnty.artic       = buf_fbr-line.artic
     5248                   buf_temp_goods-qnty.prod-type   = buf_fbr-line.prod-type
     5249                   buf_temp_goods-qnty.prod-code   = buf_fbr-line.prod-code
     5250                   buf_temp_goods-qnty.trn-type    = buf_fbr-line.trn-type
     5251                   buf_temp_goods-qnty.need-qnty   = buf_fbr-line.fact-qnty
     5252                   buf_temp_goods-qnty.recipe-type = v-recipe-type
     5253                   buf_temp_goods-qnty.recipe-code = buf_fbr-line.recipe-code
     5254                   buf_temp_goods-qnty.calculated  = yes
     5255               .
     5256           end.
     5257       end.
     5258   end.
     5259   END PROCEDURE.
     5260   PROCEDURE calc-not-calculated-goods :
     5261   do
     5262   on error undo, return error
     5263   :
     5264   define input parameter p-mainmenu-handle        as handle           no-undo.
     5265   define input parameter p-fbrhist-handle         as widget-handle    no-undo.
     5266   define input parameter p-fbr-doc-doc-code       as character        no-undo.
     5267   define input parameter p-same-good              as logical          no-undo.
     5268   define input parameter p-same-good-old-qnty     as decimal          no-undo.
     5269   define input parameter p-always-select-recipe   as logical          no-undo.
     5270   define input parameter p-add-childs             as logical          no-undo.
     5271   define input parameter p-price-sale-obj-type    as character        no-undo.
     5272   define input parameter p-price-sale-obj-code    as integer          no-undo.
     5273   define input parameter p-autofbr                as logical          no-undo.
     5274   define input parameter p-have-store             as logical          no-undo.
     5275       define variable v-counter               as integer       no-undo.
     5276       define variable v-recipe-type           as character     no-undo.
     5277       define variable v-recipe-code           as character     no-undo.
     5278       define variable v-recipe-found          as logical       no-undo.
     5279       define variable v-gds-code              as integer       no-undo.
     5280       define variable v-yesno                 as logical       no-undo.
     5281       define variable v-fbr-line-recid        as recid         no-undo.
     5282       define variable v-recipe-recid-list     as character     no-undo.
     5283       define variable v-need-goods            as logical       no-undo.
     5284       define variable v-need-goods-list       as character     no-undo.
     5285       define variable v-need-goods-qnty-list  as character     no-undo.
     5286       define variable v-have-rights           as logical       no-undo.
     5287       define variable v-trn-type              as character     no-undo.
     5288       define variable v-is-comp               as logical       no-undo.
     5289       define variable v-host-code             as integer       no-undo.
     5290       define variable v-is-manual-input       as logical       no-undo.
     5291       define variable v-add-good              as logical       no-undo.
     5292       define variable v-cancel                as logical       no-undo.
     5293       define variable v-value          as character no-undo .
     5294       define variable v-type           as character no-undo .
     5295       define variable v-attr-value     as character no-undo .
     5296       define variable v-attr-value-rec as character no-undo .
     5297       define variable v-attr-type      as character no-undo .
     5298       define variable v-mark-qnty      as decimal no-undo init ? .
     5299       define buffer buf_obj_recipe            for recipe.
     5300       define buffer buf_obj_recipe-gds        for recipe-gds.
     5301       define buffer buf_fbr-recipe            for fbr-recipe.
     5302       define buffer buf_fbr-recipe-gds        for fbr-recipe-gds.
     5303       define buffer buf_goods                 for goods.
     5304       define buffer buf_fbr-doc               for fbr-doc.
     5305       define buffer buf_fbr-line              for fbr-line.
     5306       define buffer buf_comp_fbr-line         for fbr-line.
     5307       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5308       define buffer buf_new_temp_goods-qnty   for temp_goods-qnty.
     5309       define buffer buf_start_temp_goods-qnty for temp_goods-qnty.
     5310       define buffer buf_del_temp_goods-qnty   for temp_goods-qnty.
     5311       define buffer buf_marking-lines         for ub.marking-lines .
     5312       define buffer buf_marking               for ub.marking .
     5313      define variable v-ban-recipes as logical no-undo .
     5314      define variable v-ban-altr    as logical no-undo .
     5315      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true .
     5316      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     5317       find first buf_fbr-doc no-lock
     5318            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     5319       .
     5320       run test-temp-tables in this-procedure ( "Заполнена временная таблица по товарам документа." ).
     5321       find first buf_start_temp_goods-qnty
     5322            where buf_start_temp_goods-qnty.calculated = no
     5323       no-error.
     5324       calc-not-calculated-goods:
     5325       do while available buf_start_temp_goods-qnty
     5326       :
     5327           run writelog in this-procedure ( log-file-name, 2, substitute( "Расчет товара с артикулом &1", buf_start_temp_goods-qnty.artic ) ).
     5328           find first buf_goods no-lock
     5329                where buf_goods.gds-code = buf_start_temp_goods-qnty.gds-code
     5330           .
     5331           if buf_start_temp_goods-qnty.recipe-code = ?
     5332           then do:
     5333               assign
     5334                   v-is-manual-input = yes
     5335               .
     5336           end.
     5337           else do:
     5338               assign
     5339                   v-is-manual-input = no
     5340               .
     5341           end.
     5342           if buf_start_temp_goods-qnty.recipe-code = ?
     5343           or p-always-select-recipe = yes
     5344           then do:
     5345               assign
     5346                   v-yesno     = ?
     5347                   v-add-good  = no
     5348               .
     5349               do while v-yesno = ?
     5350               and v-add-good = no
     5351               :
     5352                   run ref/rcp-all.w (
     5353                         input p-mainmenu-handle
     5354                       , input "b-add,b-sel"
     5355                       , input 'все':U
     5356                       , input recid( buf_goods )
     5357                       , input buf_fbr-doc.obj-type
     5358                       , input buf_fbr-doc.obj-code
     5359                       , output v-recipe-recid-list
     5360                   ) no-error.
     5361                   if error-status :error
     5362                   or v-recipe-recid-list = ""
     5363                   then do:
     5364                       message
     5365                           "Отменить добавление товара?"
     5366                           skip(1)
     5367                           skip "Товар:" buf_goods.artic buf_goods.gds-name
     5368                           skip(1)
     5369                           skip "Yes - отменить добавление текущего товара"
     5370                           skip "No  - отменить добавление всех товаров списка"
     5371                           skip "Cancel - вернуться к выбору рецепта"
     5372                       view-as alert-box question
     5373                       buttons yes-no-cancel
     5374                       title "Отмена"
     5375                       update v-yesno
     5376                       .
     5377                   end.
     5378                   else do:
     5379         if v-ban-altr or v-ban-recipes then
     5380         do:
     5381            for each buf_obj_recipe no-lock where recid (buf_obj_recipe) = integer(v-recipe-recid-list):
     5382               if buf_obj_recipe.recipe-type = 'производство':U and v-ban-recipes then
     5383               do:
     5384                  for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_obj_recipe.recipe-code:
     5385                     run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     5386                        , input  'mark-type':U
     5387                        , output v-attr-value
     5388                        , output v-attr-type
     5389                        ) no-error .
     5390                     if v-attr-value <> "" and v-attr-value <> "not-type" then
     5391                     do:
     5392                        message "Рецепт производства " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + " содержит маркированный товар."
     5393                           view-as alert-box.
     5394                        return .
     5395                     end.
     5396                  end.
     5397               end.
     5398               if buf_obj_recipe.recipe-type = 'альтернатива':U and v-ban-altr then
     5399               do:
     5400                  if not check-ban-sales-via-cd(buf_goods.gds-code) then
     5401                  do:
     5402                     message "Рецепт альтернатива " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + chr(10) + "входит в группу, у которой не установлен атрибут: " + chr(10) + "Запрет передачи на кассу."
     5403                        view-as alert-box.
     5404                     return .
     5405                  end.
     5406               end.
     5407               if buf_obj_recipe.recipe-type = 'комплектация':U and v-ban-recipes then
     5408               do:
     5409                  for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_obj_recipe.recipe-code:
     5410                     run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     5411                        , input  'mark-type':U
     5412                        , output v-attr-value
     5413                        , output v-attr-type
     5414                        ) no-error .
     5415                     if v-attr-value <> "" and v-attr-value <> "not-type" then
     5416                     do:
     5417                        run gds-attr-value in this-procedure  ( input  buf_obj_recipe.gds-code
     5418                           , input  'mark-type':U
     5419                           , output v-attr-value-rec
     5420                           , output v-attr-type
     5421                           ) no-error .
     5422                        if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     5423                        do:
     5424                           message "Рецепт комплектации " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + " должен быть маркированным"
     5425                              view-as alert-box.
     5426                           return .
     5427                        end.
     5428                        else leave.
     5429                     end.
     5430                  end.
     5431               end.
     5432            end.
     5433         end.
     5434                       assign
     5435                           v-add-good = yes
     5436                       .
     5437                   end.
     5438               end.
     5439               if v-add-good = no
     5440               then do:
     5441                   if v-yesno = yes
     5442                   then do:
     5443                       for each tt-marking-lines where tt-marking-lines.gds-code = buf_start_temp_goods-qnty.gds-code
     5444                       :
     5445                         for first buf_marking exclusive-lock where buf_marking.mark begins tt-marking-lines.mark :
     5446                           assign
     5447                             buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB
     5448                           .
     5449                         end .
     5450                         delete tt-marking-lines .
     5451                       end .
     5452                       delete buf_start_temp_goods-qnty.
     5453                       find first buf_start_temp_goods-qnty
     5454                               where buf_start_temp_goods-qnty.calculated = no
     5455                       no-error.
     5456                       next calc-not-calculated-goods.
     5457                   end.
     5458                   else do:
     5459                       undo, return error .
     5460                   end.
     5461               end.
     5462               find first buf_obj_recipe no-lock
     5463                    where recid( buf_obj_recipe ) = integer( v-recipe-recid-list )
     5464               no-error.
     5465               if not available buf_obj_recipe
     5466               then do:
     5467                   if p-always-select-recipe = yes
     5468                   then do:
     5469                       assign
     5470                           buf_start_temp_goods-qnty.calculated = yes
     5471                       .
     5472                       find first buf_start_temp_goods-qnty
     5473                            where buf_start_temp_goods-qnty.calculated = no
     5474                       no-error.
     5475                       next calc-not-calculated-goods.
     5476                   end.
     5477                   else do:
     5478                       message
     5479                           "Неверно выбран рецепт для товара."
