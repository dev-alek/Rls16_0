     1613   define temp-table tt-sert-utd
     1614     field doc-id like ub.utd.doc-id
     1615     field db-num like ub.utd.db-num
     1616     field DocumentDate like ub.utd.DocumentDate
     1617     field DocumentNumber like ub.utd.DocumentNumber
