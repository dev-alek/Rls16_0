     8164   procedure grp-obj-notcorr-value :
     8165   do
     8166   on error undo, return error
     8167   :
     8168   define input parameter p-node-code             as integer      no-undo.
     8169   define input parameter p-obj-type              as character    no-undo.
     8170   define input parameter p-obj-code              as integer      no-undo.
     8171   define output parameter p-notcorr              as character    no-undo init ?.
     8172   define output parameter p-range-notcorr     as integer      no-undo.
     8173   define output parameter p-exists-notcorr    as logical      no-undo.
     8174   define variable v-host-code as integer      no-undo.
     8175   DEFINE VARIABLE v-found as logical no-undo .
     8176   DEFINE VARIABLE v-exists as logical no-undo .
     8177   DEFINE VARIABLE v-range as integer no-undo .
     8178   DEFINE VARIABLE jj as integer no-undo .
     8179   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     8180   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     8181   define buffer buf_gds-grp for ub.gds-grp.
     8182   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     8183   find first buf_gds-grp no-lock where
     8184              buf_gds-grp.node-code = p-node-code no-error .
     8185   if not avail buf_gds-grp and p-node-code <> 0 then do:
     8186     message
     8187       vss-workfile vss-revision vss-description
     8188       skip "Не удалось найти группу товаров с кодом" p-node-code
     8189       view-as alert-box error .
     8190     undo, return error .
     8191   end.
     8192   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8193   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     8194     (input  p-obj-type
     8195     ,input  p-obj-code
     8196     ,output v-host-code
     8197     ) no-error .
     8198   if error-status :error
     8199   then do:
     8200       message
     8201         vss-workfile vss-revision vss-description
     8202         skip "Не удалось найти фирму объекта"
     8203         skip p-obj-type p-obj-code
     8204         skip return-value
     8205         skip trim(error-status :get-message(1))
     8206       view-as alert-box error.
     8207       undo, return error .
     8208   end.
     8209   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     8210   do while v-found = no and jj < 2:
     8211     if v-range <> 3 then do:
     8212       find first buf_gds-grp-obj no-lock
     8213           where buf_gds-grp-obj.node-code = p-node-code
     8214             and buf_gds-grp-obj.host-code = v-host-code
     8215             and buf_gds-grp-obj.obj-type  = p-obj-type
     8216             and buf_gds-grp-obj.obj-code  = p-obj-code
     8217       no-error .
     8218     end.
     8219     if v-range = 3 or not available buf_gds-grp-obj
     8220     then do:
     8221        if v-range <> 2 then do:
     8222           find first buf_gds-grp-obj no-lock
     8223               where buf_gds-grp-obj.node-code = p-node-code
     8224                 and buf_gds-grp-obj.host-code = v-host-code
     8225                 and buf_gds-grp-obj.obj-type  = ""
     8226                 and buf_gds-grp-obj.obj-code  = 0
     8227           no-error .
     8228         end.
     8229         if v-range = 2 or not available buf_gds-grp-obj
     8230         then do:
     8231             if v-range <> 1 then do:
     8232               find first buf_gds-grp-obj no-lock
     8233                   where buf_gds-grp-obj.node-code = p-node-code
     8234                   and buf_gds-grp-obj.host-code = 0
     8235                   and buf_gds-grp-obj.obj-type  = ""
     8236                   and buf_gds-grp-obj.obj-code  = 0
     8237               no-error .
     8238             end.
     8239             if v-range = 1 or not available buf_gds-grp-obj
     8240             then do:
     8241                 assign
     8242                     v-exists = no
     8243                 .
     8244             end.
     8245             else do:
     8246                 assign
     8247                     v-exists = yes
     8248                     v-range = 1
     8249                 .
     8250             end.
     8251         end.
     8252         else do:
     8253             assign
     8254                 v-exists = yes
     8255                 v-range  = 2
     8256             .
     8257         end.
     8258     end.
     8259     else do:
     8260         assign
     8261             v-exists = yes
     8262             v-range  = 3
     8263         .
     8264     end.
     8265     if available buf_gds-grp-obj
     8266     then do:
     8267       find first buf_gds-grp-obj-attr no-lock
     8268         where buf_gds-grp-obj-attr.node-code   = p-node-code
     8269           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     8270           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     8271           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     8272           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     8273         no-error .
     8274       if available buf_gds-grp-obj-attr then do:
     8275         assign
     8276           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     8277         .
     8278       end.
     8279       else do:
     8280         assign
     8281           v-notcorr-value = ?
     8282         .
     8283       end.
     8284       assign
     8285       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     8286                           then yes
     8287                           else p-exists-notcorr)
     8288       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     8289                         then v-range
     8290                         else p-range-notcorr
     8291       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     8292                         then v-notcorr-value
     8293                         else p-notcorr
     8294       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     8295       jj = jj + 1
     8296       .
     8297     end.
     8298     else do:
     8299       assign
     8300       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     8301       jj = jj + 1
     8302       .
     8303     end.
     8304   end.
     8305   end.
     8306   end procedure.
     8307       define variable v-copy-qnty             like doc-line.fact-qnty     no-undo.
     8308       define variable v-auto-select-recipes   as logical                  no-undo.
     8309       define variable v-gds-code              as integer       no-undo.
     8310       define variable v-trn-type              as character     no-undo.
     8311       define variable v-need-qnty             as decimal       no-undo.
     8312       define variable v-recipe-type           as character     no-undo.
     8313       define variable v-recipe-code           as character     no-undo.
     8314       define variable v-recipe-found          as logical       no-undo.
     8315       define variable v-same-good             as logical       no-undo.
     8316       define variable v-same-good-old-qnty    as decimal       no-undo.
     8317       define variable v-no-add-good           as logical       no-undo.
     8318       define buffer buf_doc-line          for doc-line.
     8319       define buffer buf_trn-doc           for trn-doc.
     8320       define buffer buf_return_doc-line   for doc-line.
     8321       define buffer buf_goods             for goods.
     8322   do
     8323   for buf_doc-line
     8324     , buf_trn-doc
     8325     , buf_return_doc-line
     8326     , buf_goods
     8327   on error undo, return error
     8328   :
     8329   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8330     run mainmenu_getcntxt in parparentproc
     8331       (output v-cntxt-db-num
     8332       ,output v-cntxt-userid
     8333       ,output v-cntxt-level
     8334       ,output v-cntxt-host-code-obj
     8335       ,output v-cntxt-obj-type
     8336       ,output v-cntxt-obj-code
     8337       ,output v-cntxt-db-num-obj
     8338       ,output v-cntxt-is-admin
     8339       ) .
     8340       find first buf_trn-doc no-lock
     8341            where buf_trn-doc.doc-code = p-trn-doc-doc-code
     8342       .
     8343       assign
     8344           v-auto-select-recipes = yes
     8345       .
     8346       message
     8347           "Добавление строк из накладной (продажи) №" buf_trn-doc.doc-code
     8348           skip (2)
     8349           skip "YES - выбирать рецепты автоматически"
     8350           skip "NO - давать выбирать и добавлять рецепты по ходу работы"
     8351           skip "CANCEL - отказ от добавления из документа"
     8352       view-as alert-box question
     8353       buttons YES-NO-CANCEL
     8354       update v-auto-select-recipes.
     8355       if v-auto-select-recipes = ?
     8356       then do:
     8357           return error.
     8358       end.
     8359       if buf_trn-doc.discnt-type = 'касс':U
     8360       then do:
     8361           run str/dtlrests.p (
     8362                           input  buf_trn-doc.doc-code
     8363                           ,input no
     8364                           ,input "parts":U
     8365                           ,input yes
     8366                           ,input yes
     8367                           ,input no
     8368                           ,input no
     8369                           ,input no
     8370                           ,input no
     8371           ).
     8372       end.
     8373       for each buf_doc-line no-lock
     8374          where buf_doc-line.doc-code = buf_trn-doc.doc-code
     8375       on error undo, return error
     8376       :
     8377           find first buf_goods no-lock
     8378                where buf_goods.artic     = buf_doc-line.artic
     8379                  and buf_goods.prod-type = buf_doc-line.prod-type
     8380                  and buf_goods.prod-code = buf_doc-line.prod-code
     8381           .
     8382           if buf_trn-doc.doc-type = 'рас':U
     8383           or buf_trn-doc.doc-type = 'спи':U
     8384           then do:
     8385               if buf_trn-doc.discnt-type = 'касс':U
     8386               then do:
     8387                   find first dtl-rests no-lock
     8388                        where dtl-rests.gds-code = buf_goods.gds-code
     8389                   no-error.
     8390                   if available dtl-rests
     8391                   then do:
     8392                       assign
     8393                           v-copy-qnty = dtl-rests.need-qnty
     8394                       .
     8395                   end.
     8396                   else do:
     8397                       assign
     8398                           v-copy-qnty = 0
     8399                       .
     8400                   end.
     8401               end.
     8402               else do:
     8403                   assign
     8404                       v-copy-qnty = buf_doc-line.fact-qnty
     8405                   .
     8406               end.
     8407               if v-copy-qnty <> 0
     8408               then do:
     8409                   run str/fbrselr.p (
     8410                         input parparentproc
     8411                       , input p-fbr-doc-obj-type
     8412                       , input p-fbr-doc-obj-code
     8413                       , input buf_goods.gds-code
     8414                       , input ( if v-copy-qnty > 0
     8415                               then 'при':U
     8416                               else 'спи':U )
     8417                       , input absolute( v-copy-qnty )
     8418                       , input no
     8419                       , input no
     8420                       , output v-gds-code
     8421                       , output v-trn-type
     8422                       , output v-need-qnty
     8423                       , output v-recipe-type
     8424                       , output v-recipe-code
     8425                       , output v-recipe-found
     8426                       , output v-no-add-good
     8427                   ) no-error.
     8428                   if not error-status :error
     8429                   and v-recipe-found = yes
     8430                   and v-no-add-good  = no
     8431                   then do:
     8432                       find first buf_goods no-lock
     8433                           where buf_goods.gds-code = v-gds-code
     8434                       .
     8435                       run create-initial-temp-goods in this-procedure (
     8436                             input p-fbr-doc-doc-code
     8437                           , input buf_goods.artic
     8438                           , input buf_goods.prod-type
     8439                           , input buf_goods.prod-code
     8440                           , input v-trn-type
     8441                           , input v-recipe-type
     8442                           , input v-recipe-code
     8443                           , input v-need-qnty
     8444                           , output v-same-good
     8445                           , output v-same-good-old-qnty
     8446                       ).
     8447                       run calc-not-calculated-goods in this-procedure (
     8448                             input parparentproc
     8449                           , input p-fbrhist-handle
     8450                           , input p-fbr-doc-doc-code
     8451                           , input v-same-good
     8452                           , input v-same-good-old-qnty
     8453                           , input NOT( v-auto-select-recipes )
     8454                           , input yes
     8455                           , input p-price-sale-obj-type
     8456                           , input p-price-sale-obj-code
     8457                           , input no
     8458                           , input no
     8459                       ).
     8460                   end.
     8461               end.
     8462           end.
     8463           else do:
     8464           end.
     8465       end.
     8466   end.
