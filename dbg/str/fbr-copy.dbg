     5882                               buf_start_temp_goods-qnty.calculated  = yes
     5883                           .
     5884                           run writelog in this-procedure ( log-file-name, 3, substitute( "Товар уже есть в документе. Расчитанная строка документа оставлена без изменений. Количество &1", buf_start_temp_goods-qnty.need-qnty ) ).
     5885                           run test-temp-tables in this-procedure ( "Добавили товар." ).
     5886                           find first buf_start_temp_goods-qnty
     5887                                where buf_start_temp_goods-qnty.calculated = no
     5888                           no-error.
     5889                           next calc-not-calculated-goods.
     5890                       end.
     5891                   end.
     5892                   assign
     5893                       buf_start_temp_goods-qnty.calculated  = no
     5894                   .
     5895                   if v-yesno = yes
     5896                   then do:
     5897                       assign
     5898                           buf_fbr-line.fact-qnty = buf_fbr-line.fact-qnty + p-same-good-old-qnty
     5899                       .
     5900                   end.
     5901                   run writelog in this-procedure ( log-file-name, 3, substitute( "Товар уже есть в документе. Количество в рассчитанной строке документа изменено на &1", buf_fbr-line.fact-qnty ) ).
     5902               end.
     5903               assign
     5904                   buf_start_temp_goods-qnty.recipe-code = buf_fbr-line.recipe-code
     5905                   buf_start_temp_goods-qnty.need-qnty   = buf_fbr-line.fact-qnty
     5906                   buf_start_temp_goods-qnty.trn-type    = buf_fbr-line.trn-type
     5907               .
     5908           end.
     5909           run writelog in this-procedure ( log-file-name, 2, "Идем по ингредиентам товара." ).
     5910           for each buf_fbr-recipe-gds no-lock
     5911              where buf_fbr-recipe-gds.doc-code    = buf_fbr-recipe.doc-code
     5912                and buf_fbr-recipe-gds.recipe-code = buf_fbr-recipe.recipe-code
     5913           on error undo, return error
     5914           :
     5915               find first buf_goods no-lock
     5916                    where buf_goods.artic      = buf_fbr-recipe-gds.artic
     5917                      and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     5918                      and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     5919               .
     5920               assign
     5921                   v-is-comp = no
     5922                   v-trn-type = ( if buf_start_temp_goods-qnty.trn-type = 'при':U then 'спи':U else 'при':U )
     5923               .
     5924               run str/fbr-crln.p (
     5925                     input p-mainmenu-handle
     5926                   , input recid( buf_fbr-doc )
     5927                   , input recid( buf_goods )
     5928                   , input buf_fbr-recipe.recipe-code
     5929                   , input v-trn-type
     5930                   , input v-is-comp
     5931                   , input yes
     5932                   , input buf_fbr-doc.obj-type
     5933                   , input buf_fbr-doc.obj-code
     5934                   , output v-fbr-line-recid
     5935               ).
     5936               find first buf_fbr-line no-lock
     5937                    where recid( buf_fbr-line ) = v-fbr-line-recid
     5938               .
     5939               run writelog in this-procedure ( log-file-name, 3, substitute( "Создана строка ингредиента с артикулом '&1'", buf_fbr-line.artic ) ).
     5940           end.
     5941           run writelog in this-procedure ( log-file-name, 2, substitute( "Упорядочивание рецептов. Идем по рецептам с последнего." ) ).
     5942           run fbrlib-put-in-order-recipe in this-procedure (
     5943               input buf_fbr-doc.doc-code
     5944           ) no-error.
     5945           if error-status :error
     5946           then do:
     5947               for each buf_del_temp_goods-qnty
     5948               :
     5949                   delete buf_del_temp_goods-qnty.
     5950               end.
     5951               undo, return error.
     5952           end.
     5953           find last temp_recipe-order.
     5954           calc-all-recipes:
     5955           do while available temp_recipe-order
     5956           :
     5957               run writelog in this-procedure ( log-file-name, 3, substitute( "Обработка рецепта номер: &1", temp_recipe-order.recipe-code ) ).
     5958               find first buf_comp_fbr-line exclusive-lock
     5959                    where buf_comp_fbr-line.doc-code    = p-fbr-doc-doc-code
     5960                      and buf_comp_fbr-line.is-comp     = yes
     5961                      and buf_comp_fbr-line.recipe-code = temp_recipe-order.recipe-code
     5962               .
     5963               find first buf_temp_goods-qnty
     5964                    where buf_temp_goods-qnty.artic        = buf_comp_fbr-line.artic
     5965                      and buf_temp_goods-qnty.prod-type    = buf_comp_fbr-line.prod-type
     5966                      and buf_temp_goods-qnty.prod-code    = buf_comp_fbr-line.prod-code
     5967                      and buf_temp_goods-qnty.recipe-code  = buf_comp_fbr-line.recipe-code
     5968               no-error.
     5969               if not available buf_temp_goods-qnty
     5970               or buf_temp_goods-qnty.calculated = no
     5971               then do:
     5972                   run writelog in this-procedure ( log-file-name, 4, "Товар рецепта не рассчитан. Рассчитываем." ).
     5973                   if available buf_temp_goods-qnty
     5974                   and buf_temp_goods-qnty.need-qnty <> buf_comp_fbr-line.fact-qnty
     5975                   then do:
     5976                       assign
     5977                           buf_comp_fbr-line.fact-qnty = buf_temp_goods-qnty.need-qnty
     5978                       .
     5979                       run writelog in this-procedure ( log-file-name, 5, substitute( "Прописываем количество в строку составного товара: &1", buf_comp_fbr-line.fact-qnty  ) ).
     5980                   end.
     5981                   run str/fbr-qnty.p (
     5982                         input p-mainmenu-handle
     5983                       , input p-fbrhist-handle
     5984                       , input recid( buf_fbr-doc )
     5985                       , input recid( buf_comp_fbr-line )
     5986                       , input no
     5987                       , input "ingr"
     5988                       , input no
     5989                       , input p-price-sale-obj-type
     5990                       , input p-price-sale-obj-code
     5991                       , input yes
     5992                       , input p-autofbr
     5993                       , input p-have-store
     5994                       , output v-need-goods
     5995                       , output v-need-goods-list
     5996                       , output v-need-goods-qnty-list
     5997                   ).
     5998                   if p-add-childs  = yes
     5999                   and v-need-goods = yes
     6000                   then do:
     6001                       do v-counter = 1 to num-entries( v-need-goods-list ) / 2
     6002                       :
     6003                           run add-new-recipe in this-procedure (
     6004                                 input p-mainmenu-handle
     6005                               , input buf_fbr-doc.doc-code
     6006                               , input entry( 2 * v-counter, v-need-goods-list )
     6007                               , input integer( entry( 2 * v-counter - 1 , v-need-goods-list ) )
     6008                               , input decimal( entry( v-counter, v-need-goods-qnty-list ) )
     6009                               , input p-autofbr
     6010                               , input p-have-store
     6011                           ).
     6012                       end.
     6013                       leave calc-all-recipes.
     6014                   end.
     6015               end.
     6016               find prev temp_recipe-order no-error.
     6017           end.
     6018           assign
     6019               buf_start_temp_goods-qnty.calculated = yes
     6020           .
     6021           if buf_start_temp_goods-qnty.recipe-type = 'разделка':U
     6022           or ( buf_start_temp_goods-qnty.recipe-type = 'комплектация':U
     6023                and buf_start_temp_goods-qnty.trn-type = 'спи':U )
     6024           then do:
     6025               run fill-temp-dressing-ingr in this-procedure (
     6026                     input buf_fbr-doc.doc-code
     6027                   , input buf_start_temp_goods-qnty.recipe-code
     6028               ).
     6029           end.
     6030           run test-temp-tables in this-procedure ( "Добавили товар." ).
     6031           find first buf_start_temp_goods-qnty
     6032                where buf_start_temp_goods-qnty.calculated = no
     6033           no-error.
     6034       end.
     6035   end.
     6036   END PROCEDURE.
     6037   PROCEDURE clear-temp-tables :
     6038   do
     6039   on error undo, return error
     6040   :
     6041       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     6042       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     6043       for each buf_temp_goods-qnty
     6044       on error undo, return error
     6045       :
     6046           delete buf_temp_goods-qnty.
     6047       end.
     6048       for each buf_temp_dressing-ingr
     6049       on error undo, return error
     6050       :
     6051           delete buf_temp_dressing-ingr.
     6052       end.
     6053   end.
     6054   END PROCEDURE.
     6055   PROCEDURE copy-recipe-in-doc :
     6056   define input parameter p-doc-code       as character             no-undo.
     6057   define input parameter p-recipe-code    as character             no-undo.
     6058   define input parameter p-obj-date       as date                  no-undo.
     6059   define input parameter p-obj-type       like ub.clients.obj-type no-undo.
     6060   define input parameter p-obj-code       like ub.clients.obj-code no-undo.
     6061       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     6062       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     6063       define buffer buf_recipe            for ub.recipe.
     6064       define buffer buf_recipe-gds        for ub.recipe-gds.
     6065   do
     6066   for buf_fbr-recipe
     6067     , buf_fbr-recipe-gds
     6068     , buf_recipe
     6069     , buf_recipe-gds
     6070   on error undo, return error return-value
     6071   :
     6072   find first buf_recipe no-lock
     6073        where buf_recipe.recipe-code = p-recipe-code
     6074   .
     6075   find first buf_fbr-recipe exclusive-lock
     6076        where buf_fbr-recipe.doc-code      = p-doc-code
     6077          and buf_fbr-recipe.recipe-code   = p-recipe-code
     6078   no-error.
     6079   if not available buf_fbr-recipe
     6080   then do:
     6081     create buf_fbr-recipe.
     6082     assign
     6083       buf_fbr-recipe.doc-code     = p-doc-code
     6084       buf_fbr-recipe.recipe-code  = p-recipe-code
     6085       buf_fbr-recipe.recipe-type  = buf_recipe.recipe-type
     6086     .
     6087     for each buf_recipe-gds exclusive-lock
     6088        where buf_recipe-gds.recipe-code = p-recipe-code
     6089     on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     6090           run fbrlib_create-fbr-recipe-gds in this-procedure (
     6091                 input p-doc-code
     6092               , input buf_recipe-gds.recipe-code
     6093               , input buf_recipe-gds.prod-type
     6094               , input buf_recipe-gds.prod-code
     6095               , input buf_recipe-gds.artic
     6096               , input buf_recipe-gds.gds-code
     6097               , input buf_recipe-gds.is-waste
     6098               , input buf_recipe-gds.proc-number
     6099               , input p-obj-date
     6100               , input p-obj-type
     6101               , input p-obj-code
     6102               , input buf_recipe-gds.calc-method
     6103               , input buf_recipe-gds.coeff-waste
     6104               , input buf_recipe-gds.qnty
     6105               , input buf_recipe-gds.brutto-qnty
     6106         ) no-error.
     6107         if error-status:error
     6108         then do:
     6109               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     6110         end.
     6111     end.
     6112     buffer-copy buf_recipe to buf_fbr-recipe.
     6113   end.
     6114   end.
     6115   END PROCEDURE.
     6116   PROCEDURE fill-temp-dressing-ingr :
     6117   do
     6118   on error undo, return error
     6119   :
     6120   define input parameter p-doc-code       as character    no-undo.
     6121   define input parameter p-recipe-code    as character    no-undo.
     6122       define variable v-free-qnty     as decimal       no-undo.
     6123       define buffer buf_fbr-doc               for ub.fbr-doc.
     6124       define buffer buf_c_fbr-line            for ub.fbr-line.
     6125       define buffer buf_i_fbr-line            for ub.fbr-line.
     6126       define buffer buf_i_other_fbr-line      for ub.fbr-line.
     6127       define buffer buf_goods                 for ub.goods.
     6128       define buffer buf_recipe                for ub.fbr-recipe.
     6129       define buffer buf_recipe-gds            for ub.fbr-recipe-gds.
     6130       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     6131       find first buf_fbr-doc no-lock
     6132            where buf_fbr-doc.doc-code = p-doc-code
     6133       .
     6134       find first buf_recipe no-lock
     6135            where buf_recipe.doc-code    = p-doc-code
     6136              and buf_recipe.recipe-code = p-recipe-code
     6137       .
     6138       find first buf_c_fbr-line no-lock
     6139            where buf_c_fbr-line.doc-code    = p-doc-code
     6140              and buf_c_fbr-line.is-comp     = yes
     6141              and buf_c_fbr-line.recipe-code = p-recipe-code
     6142       .
     6143       if buf_recipe.recipe-type <> 'разделка':U
     6144       and ( buf_recipe.recipe-type <> 'комплектация':U
     6145            or buf_c_fbr-line.trn-type <> 'спи':U )
     6146       then do:
     6147           message
     6148                    vss-workfile vss-revision vss-description
     6149               skip "Процедура fill-temp-dressing-ingr применима только к рецептам разделки и разукомплектации."
     6150               skip return-value
     6151           view-as alert-box error.
     6152           undo, return error .
     6153       end.
     6154       for each buf_temp_dressing-ingr
     6155       :
     6156           delete buf_temp_dressing-ingr.
     6157       end.
     6158       for each buf_i_fbr-line no-lock
     6159          where buf_i_fbr-line.doc-code    = p-doc-code
     6160            and buf_i_fbr-line.is-comp     = no
     6161            and buf_i_fbr-line.recipe-code = p-recipe-code
     6162       on error undo, return error
     6163       :
     6164           find first buf_goods no-lock
     6165                where buf_goods.artic      = buf_i_fbr-line.artic
     6166                  and buf_goods.prod-type  = buf_i_fbr-line.prod-type
     6167                  and buf_goods.prod-code  = buf_i_fbr-line.prod-code
     6168           .
     6169           find first buf_temp_dressing-ingr
     6170                where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     6171                  and buf_temp_dressing-ingr.gds-code    = buf_goods.gds-code
     6172           no-error.
     6173           if not available buf_temp_dressing-ingr
     6174           then do:
     6175               create buf_temp_dressing-ingr.
     6176               assign
     6177                   buf_temp_dressing-ingr.recipe-code  = p-recipe-code
     6178                   buf_temp_dressing-ingr.gds-code     = buf_goods.gds-code
     6179                   buf_temp_dressing-ingr.used-qnty    = 0
     6180                   buf_temp_dressing-ingr.line-qnty    = 0
     6181                   buf_temp_dressing-ingr.recipe-qnty  = 0
     6182               .
     6183           end.
     6184           run fbrrest-get-free-qnty in this-procedure (
     6185                 input buf_fbr-doc.obj-type
     6186               , input buf_fbr-doc.obj-code
     6187               , input buf_goods.gds-code
     6188               , input no
     6189               , output v-free-qnty
     6190           ).
     6191           find first buf_recipe-gds no-lock
     6192                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     6193                  and buf_recipe-gds.recipe-code = p-recipe-code
     6194                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     6195                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     6196                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     6197           .
     6198           for each buf_i_other_fbr-line no-lock
     6199              where buf_i_other_fbr-line.doc-code    = p-doc-code
     6200                and buf_i_other_fbr-line.is-comp     = no
     6201                and buf_i_other_fbr-line.recipe-code <> p-recipe-code
     6202                and buf_i_other_fbr-line.artic       = buf_i_fbr-line.artic
     6203                and buf_i_other_fbr-line.prod-type   = buf_i_fbr-line.prod-type
     6204                and buf_i_other_fbr-line.prod-code   = buf_i_fbr-line.prod-code
     6205           :
     6206               assign
     6207                   buf_temp_dressing-ingr.line-qnty    = buf_temp_dressing-ingr.line-qnty
     6208                                                           + buf_i_other_fbr-line.fact-qnty
     6209               .
     6210           end.
     6211           if available buf_temp_dressing-ingr
     6212           then do:
     6213               assign
     6214                   buf_temp_dressing-ingr.used-qnty = buf_temp_dressing-ingr.line-qnty - v-free-qnty
     6215               .
     6216           end.
     6217       end.
     6218       for each buf_temp_dressing-ingr
     6219          where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     6220       :
     6221           find first buf_goods no-lock
     6222                where buf_goods.gds-code = buf_temp_dressing-ingr.gds-code
     6223           .
     6224           for each buf_i_other_fbr-line no-lock
     6225              where buf_i_other_fbr-line.doc-code    = p-doc-code
     6226                and buf_i_other_fbr-line.is-comp     = no
     6227                and buf_i_other_fbr-line.recipe-code = buf_temp_dressing-ingr.recipe-code
     6228                and buf_i_other_fbr-line.artic       = buf_goods.artic
     6229                and buf_i_other_fbr-line.prod-type   = buf_goods.prod-type
     6230                and buf_i_other_fbr-line.prod-code   = buf_goods.prod-code
     6231           on error undo, return error
     6232           :
     6233               assign
     6234                   buf_temp_dressing-ingr.recipe-qnty = buf_temp_dressing-ingr.recipe-qnty
     6235                                                       + buf_i_other_fbr-line.fact-qnty
     6236               .
     6237           end.
     6238       end.
     6239   end.
     6240   END PROCEDURE.
     6241   PROCEDURE test-temp-tables :
     6242       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     6243       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     6244   do
     6245   on error undo, return error
     6246   :
     6247   define input parameter p-title  as character    no-undo.
     6248   define variable v-str               as character        no-undo.
     6249       assign
     6250           v-str = p-title + " temp_goods-qnty:"
     6251       .
     6252       run writelog in this-procedure (  log-file-name, 0, v-str ).
     6253       for each buf_temp_goods-qnty
     6254       on error undo, return error
     6255       :
     6256           assign
     6257               v-str   = string( buf_temp_goods-qnty.gds-code )
     6258                       + "   " + ( if buf_temp_goods-qnty.recipe-type = ? then "?" else string( buf_temp_goods-qnty.recipe-type ) )
     6259                       + "   " + ( if buf_temp_goods-qnty.recipe-code = ? then "?" else string( buf_temp_goods-qnty.recipe-code ) )
     6260                       + "   " + ( if buf_temp_goods-qnty.trn-type = ?    then "?" else string( buf_temp_goods-qnty.trn-type ) )
     6261                       + "   " + ( if buf_temp_goods-qnty.need-qnty = ?   then "?" else string( buf_temp_goods-qnty.need-qnty ) )
     6262                       + "   " + string( buf_temp_goods-qnty.calculated )
     6263           .
     6264           run writelog in this-procedure (  log-file-name, 1, v-str ).
     6265       end.
     6266       assign
     6267           v-str = "        temp_dressing-ingr:"
     6268       .
     6269       run writelog in this-procedure (  log-file-name, 0, v-str ).
     6270       for each buf_temp_dressing-ingr
     6271       on error undo, return error
     6272       :
     6273           assign
     6274               v-str   = string( buf_temp_dressing-ingr.recipe-code  )
     6275                       + "   " + string( buf_temp_dressing-ingr.gds-code )
     6276                       + "   " + ( if buf_temp_dressing-ingr.line-qnty = ?   then "?" else string( buf_temp_dressing-ingr.line-qnty ) )
     6277                       + "   " + ( if buf_temp_dressing-ingr.used-qnty = ?   then "?" else string( buf_temp_dressing-ingr.used-qnty ) )
     6278                       + "   " + ( if buf_temp_dressing-ingr.recipe-qnty = ? then "?" else string( buf_temp_dressing-ingr.recipe-qnty ) )
     6279           .
     6280           run writelog in this-procedure (  log-file-name, 1, v-str ).
     6281       end.
     6282   end.
     6283   END PROCEDURE.
     6284   PROCEDURE add-new-recipe :
     6285   do
     6286   on error undo, return error
     6287   :
     6288   define input parameter p-mainmenu-handle    as handle           no-undo.
     6289   define input parameter p-doc-code           as character        no-undo.
     6290   define input parameter p-trn-type           as character        no-undo.
     6291   define input parameter p-gds-code           as integer          no-undo.
     6292   define input parameter p-need-qnty          as decimal          no-undo.
     6293   define input parameter p-autofbr            as logical          no-undo.
     6294   define input parameter p-have-store         as logical          no-undo.
     6295       define variable v-comp-gds-code         as integer          no-undo.
     6296       define variable v-comp-trn-type         as character        no-undo.
     6297       define variable v-comp-need-qnty        as decimal          no-undo.
     6298       define variable v-comp-recipe-type      as character        no-undo.
     6299       define variable v-comp-recipe-code      as character        no-undo.
     6300       define variable v-comp-recipe-found     as logical          no-undo.
     6301       define variable v-ext-comp-recipe-type  as character        no-undo.
     6302       define variable v-no-add-good           as logical          no-undo.
     6303       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     6304       define buffer buf_new_temp_goods-qnty   for temp_goods-qnty.
     6305       define buffer buf_goods                 for ub.goods.
     6306       define buffer buf_fbr-line              for ub.fbr-line.
     6307       define buffer buf_fbr-doc               for ub.fbr-doc.
     6308       define variable v-value          as character no-undo .
     6309       define variable v-type           as character no-undo .
     6310       define variable v-attr-value     as character no-undo .
     6311       define variable v-attr-value-rec as character no-undo .
     6312       define variable v-attr-type      as character no-undo .
     6313       define variable v-ban-recipes as logical no-undo .
     6314       define variable v-ban-altr    as logical no-undo .
     6315       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true .
     6316       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     6317       find first buf_fbr-doc no-lock
     6318            where buf_fbr-doc.doc-code = p-doc-code
     6319       .
     6320       run extend-noweight-gds-qnty in this-procedure (
     6321             input p-gds-code
     6322           , input p-need-qnty
     6323           , output p-need-qnty
     6324       ).
     6325       run select-recipe in this-procedure (
     6326             input p-mainmenu-handle
     6327           , input buf_fbr-doc.obj-type
     6328           , input buf_fbr-doc.obj-code
     6329           , input p-gds-code
     6330           , input p-trn-type
     6331           , input p-need-qnty
     6332           , input p-autofbr
     6333           , input p-have-store
     6334           , output v-comp-gds-code
     6335           , output v-comp-trn-type
     6336           , output v-comp-need-qnty
     6337           , output v-comp-recipe-type
     6338           , output v-comp-recipe-code
     6339           , output v-comp-recipe-found
     6340           , output v-no-add-good
     6341       ) no-error.
     6342       if not error-status :error
     6343       and v-comp-recipe-found = yes
     6344       and v-no-add-good       = no
     6345       then do:
     6346           find first buf_goods no-lock
     6347                where buf_goods.gds-code = v-comp-gds-code
     6348           .
     6349           assign
     6350               v-ext-comp-recipe-type = v-comp-recipe-type
     6351           .
     6352           if v-comp-recipe-type = 'комплектация':U
     6353           and v-comp-trn-type   = 'спи':U
     6354           then do:
     6355               assign
     6356                   v-ext-comp-recipe-type = 'разделка':U
     6357               .
     6358           end.
     6359           case v-ext-comp-recipe-type
     6360           :
     6361               when 'разделка':U
     6362               then do:
     6363                   find first buf_temp_goods-qnty
     6364                        where buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     6365                          and buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     6366                   no-error.
     6367                   if not available buf_temp_goods-qnty
     6368                   then do:
     6369                       create buf_temp_goods-qnty.
     6370                       assign
     6371                           buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     6372                           buf_temp_goods-qnty.recipe-type = v-comp-recipe-type
     6373                           buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     6374                           buf_temp_goods-qnty.artic       = buf_goods.artic
     6375                           buf_temp_goods-qnty.prod-type   = buf_goods.prod-type
     6376                           buf_temp_goods-qnty.prod-code   = buf_goods.prod-code
     6377                           buf_temp_goods-qnty.trn-type    = v-comp-trn-type
     6378                           buf_temp_goods-qnty.need-qnty   = v-comp-need-qnty
     6379                           buf_temp_goods-qnty.calculated  = no
     6380                       .
     6381                   end.
     6382                   else do:
     6383                       find first buf_goods no-lock
     6384                            where buf_goods.gds-code = p-gds-code
     6385                       .
     6386                       find first buf_fbr-line no-lock
     6387                            where buf_fbr-line.doc-code    = p-doc-code
     6388                              and buf_fbr-line.trn-type    = p-trn-type
     6389                              and buf_fbr-line.recipe-code = v-comp-recipe-code
     6390                              and buf_fbr-line.artic       = buf_goods.artic
     6391                              and buf_fbr-line.prod-type   = buf_goods.prod-type
     6392                              and buf_fbr-line.prod-code   = buf_goods.prod-code
     6393                       no-error.
     6394                       if available buf_fbr-line
     6395                       then do:
     6396                           define variable v-line-qnty             as decimal   no-undo.
     6397                           define variable v-used-qnty             as decimal   no-undo.
     6398                           define variable v-free-qnty             as decimal   no-undo.
     6399                           define variable v-recipe-qnty           as decimal   no-undo.
     6400                           define variable v-comp-fbr-line-recid   as recid     no-undo.
     6401                           run get-temp_dressing-ingr-used-qnty in this-procedure (
     6402                                 input v-comp-recipe-code
     6403                               , input p-gds-code
     6404                               , output v-line-qnty
     6405                               , output v-used-qnty
     6406                               , output v-recipe-qnty
     6407                           ).
     6408                           run fbrrest-get-free-qnty in this-procedure (
     6409                                 input buf_fbr-doc.obj-type
     6410                               , input buf_fbr-doc.obj-code
     6411                               , input p-gds-code
     6412                               , input p-autofbr
     6413                               , output v-free-qnty
     6414                           ).
     6415                           assign
     6416                               p-need-qnty = p-need-qnty + v-recipe-qnty
     6417                           .
     6418                           run calc-comp-from-ingr in this-procedure (
     6419                                 input recid( buf_fbr-line )
     6420                               , input p-need-qnty
     6421                               , output v-comp-fbr-line-recid
     6422                               , output v-comp-need-qnty
     6423                           ) .
     6424                       end.
     6425                       assign
     6426                           buf_temp_goods-qnty.need-qnty   = maximum( buf_temp_goods-qnty.need-qnty, v-comp-need-qnty )
     6427                           buf_temp_goods-qnty.calculated  = no
     6428                       .
     6429                   end.
     6430               end.
     6431               otherwise do:
     6432         if v-ban-altr or v-ban-recipes then
     6433         do:
     6434             if v-ext-comp-recipe-type = 'производство':U and v-ban-recipes then
     6435             do:
     6436                for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = v-comp-recipe-code:
     6437                   run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     6438                      , input  'mark-type':U
     6439                      , output v-attr-value
     6440                      , output v-attr-type
     6441                      ) no-error .
     6442                   if v-attr-value <> "" and v-attr-value <> "not-type" then
     6443                   do:
     6444                      message "Рецепт производства " + v-comp-recipe-code + " содержит маркированный товар."
     6445                         view-as alert-box.
     6446                      return .
     6447                   end.
     6448                end.
     6449             end.
     6450             if v-ext-comp-recipe-type = 'альтернатива':U and v-ban-altr then
     6451             do:
     6452                if not check-ban-sales-via-cd(buf_goods.gds-code) then
     6453                do:
     6454                  message "Рецепт альтернатива " + v-comp-recipe-code + " входит в группу, у которой не установлен атрибут: " + chr(10) + "Запрет передачи на кассу."
     6455                    view-as alert-box.
     6456                  return .
     6457                end.
     6458             end.
     6459             if v-ext-comp-recipe-type = 'комплектация':U and v-ban-recipes then
     6460             do:
     6461                for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = v-comp-recipe-code:
     6462                   run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     6463                      , input  'mark-type':U
     6464                      , output v-attr-value
     6465                      , output v-attr-type
     6466                      ) no-error .
     6467                   if v-attr-value <> "" and v-attr-value <> "not-type" then
     6468                   do:
     6469                      run gds-attr-value in this-procedure  ( input  p-gds-code
     6470                         , input  'mark-type':U
     6471                         , output v-attr-value-rec
     6472                         , output v-attr-type
     6473                         ) no-error .
     6474                      if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     6475                      do:
     6476                         message "Рецепт комплектации " + v-comp-recipe-code + " должен быть маркированным"
     6477                            view-as alert-box.
     6478                         return .
     6479                      end.
     6480                      else leave.
     6481                   end.
     6482                end.
     6483             end.
     6484         end.
     6485                   find first buf_temp_goods-qnty
     6486                        where buf_temp_goods-qnty.gds-code = p-gds-code
     6487                          and buf_temp_goods-qnty.trn-type = p-trn-type
     6488                   no-error.
     6489                   if available buf_temp_goods-qnty
     6490                   then do:
     6491                       assign
     6492                           buf_temp_goods-qnty.need-qnty  = buf_temp_goods-qnty.need-qnty + p-need-qnty
     6493                       .
     6494                       if buf_temp_goods-qnty.recipe-code <> ""
     6495                       then do:
     6496                           assign
     6497                               buf_temp_goods-qnty.calculated = no
     6498                           .
     6499                       end.
     6500                       run writelog in this-procedure ( log-file-name, 5, substitute( "Раскрутка ингредиетнов: добавляем товар '&1' к уже рассчитанному: &2", buf_temp_goods-qnty.artic, buf_temp_goods-qnty.need-qnty  ) ).
     6501                   end.
     6502                   else do:
     6503                       find first buf_temp_goods-qnty
     6504                            where buf_temp_goods-qnty.gds-code = v-comp-gds-code
     6505                              and buf_temp_goods-qnty.trn-type = v-comp-trn-type
     6506                       no-error.
     6507                       if not available buf_temp_goods-qnty
     6508                       then do:
     6509                           create buf_temp_goods-qnty.
     6510                           find first buf_goods no-lock
     6511                                where buf_goods.gds-code = v-comp-gds-code
     6512                           .
     6513                           assign
     6514                               buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     6515                               buf_temp_goods-qnty.artic       = buf_goods.artic
     6516                               buf_temp_goods-qnty.prod-type   = buf_goods.prod-type
     6517                               buf_temp_goods-qnty.prod-code   = buf_goods.prod-code
     6518                               buf_temp_goods-qnty.trn-type    = v-comp-trn-type
     6519                               buf_temp_goods-qnty.need-qnty   = v-comp-need-qnty
     6520                               buf_temp_goods-qnty.recipe-type = v-comp-recipe-type
     6521                               buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     6522                               buf_temp_goods-qnty.calculated  = no
     6523                           .
     6524                           run writelog in this-procedure ( log-file-name, 5, "Раскрутка ингредиентов: добавляем товар как не рассчитанный." ).
     6525                       end.
     6526                   end.
     6527               end.
     6528           end case.
     6529           if available buf_temp_goods-qnty
     6530           then do:
     6531               run extend-noweight-gds-qnty in this-procedure (
     6532                     input buf_temp_goods-qnty.gds-code
     6533                   , input buf_temp_goods-qnty.need-qnty
     6534                   , output buf_temp_goods-qnty.need-qnty
     6535               ).
     6536           end.
     6537           find first buf_goods no-lock
     6538                where buf_goods.gds-code = v-comp-gds-code
     6539           .
     6540           if v-ext-comp-recipe-type = 'разделка':U
     6541           then do:
     6542               find first buf_fbr-line exclusive-lock
     6543                   where buf_fbr-line.doc-code    = p-doc-code
     6544                   and buf_fbr-line.trn-type    = v-comp-trn-type
     6545                   and buf_fbr-line.recipe-code = v-comp-recipe-code
     6546                   and buf_fbr-line.artic       = buf_goods.artic
     6547                   and buf_fbr-line.prod-type   = buf_goods.prod-type
     6548                   and buf_fbr-line.prod-code   = buf_goods.prod-code
     6549               no-error.
     6550               if available buf_fbr-line
     6551               then do:
     6552                   assign
     6553                       buf_fbr-line.fact-qnty = 0
     6554                   .
     6555               end.
     6556           end.
     6557           else do:
     6558               for each buf_fbr-line exclusive-lock
     6559               where buf_fbr-line.doc-code    = p-doc-code
     6560                   and buf_fbr-line.recipe-code = v-comp-recipe-code
     6561               on error undo, return error
     6562               :
     6563                   delete buf_fbr-line.
     6564               end.
     6565           end.
     6566       end.
     6567   end.
     6568   END PROCEDURE.
     6569   PROCEDURE extend-noweight-gds-qnty :
     6570   do
     6571   on error undo, return error
     6572   :
     6573   define input parameter p-gds-code   as integer      no-undo.
     6574   define input parameter p-in-qnty    as decimal      no-undo.
     6575   define output parameter p-out-qnty  as decimal      no-undo.
     6576       define buffer buf_goods                 for ub.goods.
     6577       define buffer buf_units                 for ub.units.
     6578       find first buf_goods no-lock
     6579            where buf_goods.gds-code = p-gds-code
     6580       .
     6581       find first buf_units no-lock
     6582            where buf_units.unit-name = buf_goods.unit-base
     6583       .
     6584       assign
     6585           p-out-qnty = p-in-qnty
     6586       .
     6587       if not ( lookup( 'вес':U, buf_units.type ) > 0
     6588                or lookup ('дро':U, buf_units.type) > 0 )
     6589       then do:
     6590           if p-out-qnty <> truncate( p-out-qnty, 0 )
     6591           then do:
     6592               assign
     6593                   p-out-qnty = truncate( p-out-qnty, 0 ) + 1
     6594               .
     6595           end.
     6596       end.
     6597   end.
     6598   END PROCEDURE.
     6599   PROCEDURE select-recipe :
     6600   do
     6601   on error undo, return error
     6602   :
     6603   define input parameter p-mainmenu-handle    as handle           no-undo.
     6604   define input parameter p-obj-type           as character        no-undo.
     6605   define input parameter p-obj-code           as integer          no-undo.
     6606   define input parameter p-gds-code           as integer          no-undo.
     6607   define input parameter p-trn-type           as character        no-undo.
     6608   define input parameter p-gds-qnty           as decimal          no-undo.
     6609   define input parameter p-autofbr            as logical          no-undo.
     6610   define input parameter p-have-store         as logical          no-undo.
     6611   define output parameter p-out-gds-code      as integer          no-undo.
     6612   define output parameter p-out-trn-type      as character        no-undo.
     6613   define output parameter p-out-gds-qnty      as decimal          no-undo.
     6614   define output parameter p-out-recipe-type   as character        no-undo.
     6615   define output parameter p-out-recipe-code   as character        no-undo.
     6616   define output parameter p-recipe-found      as logical          no-undo.
     6617   define output parameter p-no-need-good      as logical          no-undo.
     6618   define variable v-host-code             as integer      no-undo.
     6619   define variable v-value-character as character  no-undo .
     6620   define variable v-value-date      as date       no-undo .
     6621   define variable v-value-decimal   as decimal    no-undo .
     6622   define variable v-value-integer   as integer    no-undo .
     6623   define variable v-value-logical   as logical    no-undo .
     6624   define variable v-tth             as handle     no-undo .
     6625   define variable v-param-type            as character no-undo .
     6626   define variable v-type                  as character    no-undo.
     6627   define variable v-recipe-type           as character    no-undo.
     6628   define variable v-recipe-list           as character    no-undo.
     6629   define variable v-is-comp               as logical      no-undo.
     6630   define variable v-is-integration        as logical      no-undo.
     6631   define variable v-cancel                as logical      no-undo.
     6632   define variable v-yesno                 as logical      no-undo.
     6633   define variable v-default-recipe-code   as character    no-undo.
     6634       define buffer buf_recipe            for ub.recipe.
     6635       define buffer buf_goods             for ub.goods.
     6636       define buffer buf_selected_recipe   for ub.recipe.
     6637       define buffer buf_recipe-gds        for ub.recipe-gds.
     6638       define buffer buf_ingr_goods        for ub.goods.
     6639       run writelog in this-procedure (
     6640           input log-file-name
     6641           , input 0
     6642           , input "******** select-recipe ***************************************"
     6643       ).
     6644       find first buf_goods no-lock
     6645            where buf_goods.gds-code = p-gds-code
     6646       .
     6647       if p-trn-type = ?
     6648       then do:
     6649           run writelog in this-procedure ( log-file-name, 0, "Не определен тип строки. Добавление невозможно" ).
     6650           undo, return error.
     6651       end.
     6652   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6653   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6654     (input  p-obj-type
     6655     ,input  p-obj-code
     6656     ,output v-host-code
     6657     )  .
     6658       run adm/shattri.p ( input "get":U
     6659                         , input  '':u
     6660                         , input  0
     6661                         , input  'fbrattr':U
     6662                         , input  'fbr-frcp':U
     6663                         , output v-value-character
     6664                         , output v-value-date
     6665                         , output v-value-decimal
     6666                         , output v-value-integer
     6667                         , output v-value-logical
     6668                         , output v-param-type
     6669                         , input-output table-handle v-tth
     6670                         ) no-error .
     6671       if error-status :error then do:
     6672          assign
     6673             v-value-logical = FALSE
     6674          .
     6675       end.
     6676       run writelog in this-procedure (
     6677             input log-file-name
     6678           , input 1
     6679           , input substitute( "fbr-frcp = '&1'", v-value-logical )
     6680       ).
     6681       assign
     6682           p-out-recipe-type = ?
     6683           p-out-recipe-code = ?
     6684           v-recipe-type = ?
     6685       .
     6686       run fbrlib-get-obj-recipe in this-procedure (
     6687             input p-obj-type
     6688           , input p-obj-code
     6689           , input p-gds-code
     6690           , output v-default-recipe-code
     6691       ).
     6692       comp-recipe:
     6693       for each buf_recipe no-lock
     6694          where ( buf_recipe.obj-type = p-obj-type
     6695              and buf_recipe.obj-code = p-obj-code
     6696              and buf_recipe.artic     = buf_goods.artic
     6697              and buf_recipe.prod-type = buf_goods.prod-type
     6698              and buf_recipe.prod-code = buf_goods.prod-code
     6699              and buf_recipe.stts      <> 2
     6700             )
     6701             or ( buf_recipe.obj-type = ""
     6702              and buf_recipe.obj-code = 0
     6703              and buf_recipe.artic     = buf_goods.artic
     6704              and buf_recipe.prod-type = buf_goods.prod-type
     6705              and buf_recipe.prod-code = buf_goods.prod-code
     6706              and buf_recipe.stts      <> 2
     6707             )
     6708       :
     6709           if  ( p-autofbr = yes or v-value-logical = yes ) and buf_recipe.recipe-code <> v-default-recipe-code
     6710           then do:
     6711               undo comp-recipe, next comp-recipe.
     6712           end.
     6713           run writelog in this-procedure (
     6714                 input log-file-name
     6715               , input 3
     6716               , input substitute( "Рецепт: &1. Тип: &2 " , buf_recipe.recipe-code, buf_recipe.recipe-type )
     6717           ).
     6718           if p-autofbr = yes
     6719           and buf_recipe.recipe-type <> 'производство':U
     6720           and buf_recipe.recipe-type <> 'альтернатива':U
     6721           and buf_recipe.recipe-type <> 'комплектация':U
     6722           and buf_recipe.recipe-type <> 'комплектация':U
     6723           then do:
     6724               next comp-recipe.
     6725           end.
     6726           if p-trn-type = 'при':U
     6727           and buf_recipe.recipe-type = 'разделка':U
     6728           then do:
     6729               run writelog in this-procedure (
     6730                     input log-file-name
     6731                   , input 4
     6732                   , input "Разделка для составного не может дать прихода. Ищем следующий рецепт"
     6733               ).
     6734               next comp-recipe.
     6735           end.
     6736           if p-trn-type = 'спи':U
     6737           and buf_recipe.recipe-type <> 'разделка':U
     6738           and buf_recipe.recipe-type <> 'комплектация':U
     6739           then do:
     6740               run writelog in this-procedure (
     6741                     input log-file-name
     6742                   , input 4
     6743                   , input "Только разделка или разукомплектация для составного может дать списание. Ищем следующий рецепт"
     6744               ).
     6745               next comp-recipe.
     6746           end.
     6747           if v-recipe-type = ?
     6748           then do:
     6749               assign
     6750                   p-out-recipe-type = buf_recipe.recipe-type
     6751                   p-out-recipe-code = buf_recipe.recipe-code
     6752                   v-recipe-type = "recipe"
     6753                   v-is-integration = yes
     6754               .
     6755               run writelog in this-procedure (
     6756                     input log-file-name
     6757                   , input 4
     6758                   , input "Найден первый подходящий рецепт для составного"
     6759               ).
     6760               if v-value-logical
     6761               then do:
     6762                   run writelog in this-procedure (
     6763                       input log-file-name
     6764                       , input 4
     6765                       , input "Включен параметр fbr-frcp. Больше рецепт не ищем"
     6766                   ).
     6767                   leave comp-recipe.
     6768               end.
     6769               if p-autofbr = yes
     6770               then do:
     6771                   run writelog in this-procedure (
     6772                         input log-file-name
     6773                       , input 4
     6774                       , input "Раскрутка для ресторана. Больше рецепт не ищем"
     6775                   ).
     6776                   leave comp-recipe.
     6777               end.
     6778           end.
     6779           else do:
     6780               run writelog in this-procedure (
     6781                     input log-file-name
     6782                   , input 4
     6783                   , input "Найден еще один подходящий рецепт"
     6784               ).
     6785               assign
     6786                   v-yesno = ?
     6787                   p-no-need-good = yes
     6788               .
     6789               do while v-yesno = ?
     6790               and p-no-need-good = yes
     6791               :
     6792                   run ref/rcp-all.w (
     6793                         input p-mainmenu-handle
     6794                       , input "b-sel"
     6795                       , input 'все':U
     6796                       , input recid( buf_goods )
     6797                       , input p-obj-type
     6798                       , input p-obj-code
     6799                       , output v-recipe-list
     6800                   ) no-error.
     6801                   if error-status :error
     6802                   or v-recipe-list = ""
     6803                   then do:
     6804                       message
     6805                           "Отменить добавление товара?"
     6806                           skip(1)
     6807                           skip "Товар:" buf_goods.artic buf_goods.gds-name
     6808                           skip(1)
     6809                           skip "Yes - отменить добавление текущего товара"
     6810                           skip "No  - отменить добавление товаров"
     6811                           skip "Cancel - вернуться к выбору рецептов"
     6812                       view-as alert-box question
     6813                       buttons yes-no-cancel
     6814                       title "Отмена"
     6815                       update v-yesno
     6816                       .
     6817                   end.
     6818                   else do:
     6819                       assign
     6820                           p-no-need-good = no
     6821                       .
     6822                   end.
     6823               end.
     6824               if p-no-need-good = yes
     6825               then do:
     6826                   if v-yesno = no
     6827                   then do:
     6828                       undo, return error .
     6829                   end.
     6830                   else do:
     6831                       return.
     6832                   end.
     6833               end.
     6834               find first buf_selected_recipe no-lock
     6835                    where recid( buf_selected_recipe ) = integer( entry( 1, v-recipe-list ) )
     6836               no-error.
     6837               if not available buf_selected_recipe
     6838               then do:
     6839                   assign
     6840                       p-out-recipe-type = ?
     6841                       p-out-recipe-code = ?
     6842                       v-is-integration  = ?
     6843                   .
     6844               end.
     6845               else do:
     6846                   assign
     6847                       p-out-recipe-type   = buf_selected_recipe.recipe-type
     6848                       p-out-recipe-code   = buf_selected_recipe.recipe-code
     6849                       v-recipe-type       = "recipe"
     6850                       v-is-integration    = yes
     6851                   .
     6852                   leave comp-recipe.
     6853               end.
     6854           end.
     6855       end.
     6856       if v-recipe-type = ?
     6857       and p-autofbr = no
     6858       then do:
     6859           run writelog in this-procedure (
     6860                 input log-file-name
     6861               , input 3
     6862               , input "Поиск товара среди ингредиентов рецептов."
     6863           ).
     6864           search-recipe-gds:
     6865           for each buf_recipe-gds
     6866              where buf_recipe-gds.artic       = buf_goods.artic
     6867                and buf_recipe-gds.prod-type   = buf_goods.prod-type
     6868                and buf_recipe-gds.prod-code   = buf_goods.prod-code
     6869           :
     6870               find first buf_recipe no-lock
     6871                    where buf_recipe.recipe-code = buf_recipe-gds.recipe-code
     6872                      and buf_recipe.obj-type    = p-obj-type
     6873                      and buf_recipe.obj-code    = p-obj-code
     6874                    no-error
     6875               .
     6876               if not available buf_recipe then next search-recipe-gds.
     6877               find buf_ingr_goods no-lock
     6878                   where buf_ingr_goods.gds-code = buf_recipe.gds-code
     6879               .
     6880               if buf_ingr_goods.stts <> 0 then do:
     6881                   run writelog in this-procedure (
     6882                         input log-file-name
     6883                       , input 3
     6884                       , input subst("Рецепт &1 на товар &2 не подходит т.к. товар удален", buf_recipe.recipe-code, buf_ingr_goods.gds-code)
     6885                   ).
     6886                   next search-recipe-gds.
     6887               end.
     6888               run writelog in this-procedure (
     6889                     input log-file-name
     6890                   , input 3
     6891                   , input substitute( "Рецепт: &1. Тип: &2 " , buf_recipe.recipe-code, buf_recipe.recipe-type )
     6892               ).
     6893               if p-trn-type = 'при':U
     6894               and buf_recipe.recipe-type <> 'разделка':U
     6895               and buf_recipe.recipe-type <> 'комплектация':U
     6896               then do:
     6897                   run writelog in this-procedure (
     6898                         input log-file-name
     6899                       , input 3
     6900                       , input "Тип не подходит. Только разделка или разукомплектация для ингредиента может дать приход"
     6901                   ).
     6902                   next search-recipe-gds.
     6903               end.
     6904               if p-trn-type = 'спи':U
     6905               and buf_recipe.recipe-type = 'разделка':U
     6906               then do:
     6907                   run writelog in this-procedure (
     6908                         input log-file-name
     6909                       , input 3
     6910                       , input "Тип не подходит. Разделка для ингредиента не может дать списания"
     6911                   ).
     6912                   next search-recipe-gds.
     6913               end.
     6914               if v-recipe-type = ?
     6915               then do:
     6916                   assign
     6917                       p-out-recipe-type   = buf_recipe.recipe-type
     6918                       p-out-recipe-code   = buf_recipe.recipe-code
     6919                       v-recipe-type       = "recipe-gds"
     6920                       v-is-integration    = no
     6921                   .
     6922                   if v-value-logical
     6923                   then do:
     6924                       leave search-recipe-gds.
     6925                   end.
     6926               end.
     6927               else do:
     6928                   assign
     6929                       p-out-recipe-type = ?
     6930                       p-out-recipe-code = p-out-recipe-code + chr(44) + buf_recipe.recipe-code
     6931                       v-is-integration  = ?
     6932                   .
     6933               end.
     6934           end.
     6935       end.
     6936       if p-out-recipe-type = ?
     6937       and p-out-recipe-code = ?
     6938       then do:
     6939           assign
     6940               p-recipe-found = no
     6941           .
     6942       end.
     6943       else do:
     6944           if p-out-recipe-type = ?
     6945           then do:
     6946               define variable v-recipe-recid-list as character     no-undo.
     6947               run str/rcp-sel.w (
     6948                     input p-mainmenu-handle
     6949                   , input buf_goods.gds-code
     6950                   , input 'при':U
     6951                   , output p-out-recipe-code
     6952                   , output v-is-integration
     6953                   , output v-cancel
     6954               ) .
     6955               if v-cancel = yes
     6956               then do:
     6957                   assign
     6958                       p-recipe-found = no
     6959                       p-no-need-good = yes
     6960                   .
     6961                   return.
     6962               end.
     6963           end.
     6964           assign
     6965               p-recipe-found = yes
     6966           .
     6967           find first buf_recipe no-lock
     6968                where buf_recipe.recipe-code = p-out-recipe-code
     6969           .
     6970           find first buf_goods no-lock
     6971                where buf_goods.artic      = buf_recipe.artic
     6972                  and buf_goods.prod-type  = buf_recipe.prod-type
     6973                  and buf_goods.prod-code  = buf_recipe.prod-code
     6974           .
     6975           assign
     6976               p-out-recipe-type   = buf_recipe.recipe-type
     6977               p-out-gds-code      = buf_goods.gds-code
     6978           .
     6979           run fbrlib-get-trn-type in this-procedure (
     6980                 input buf_recipe.recipe-code
     6981               , input recid( buf_goods )
     6982               , input v-is-integration
     6983               , output v-is-comp
     6984               , output p-out-trn-type
     6985           ).
     6986           run writelog in this-procedure (
     6987                 input log-file-name
     6988               , input 1
     6989               , input substitute( "Найден рецепт '&1' с is-comp = &2, товаром '&3 &4', типом &5"
     6990                                   , p-out-recipe-code
     6991                                   , v-is-comp
     6992                                   , buf_goods.artic
     6993                                   , buf_goods.gds-name
     6994                                   , p-out-trn-type )
     6995           ).
     6996           if p-out-gds-code <> p-gds-code
     6997           then do:
     6998               run writelog in this-procedure (
     6999                     input log-file-name
     7000                   , input 1
     7001                   , input "Необходимый товар является ингредиентом"
     7002               ).
     7003               find first buf_goods no-lock
     7004                    where buf_goods.gds-code = p-gds-code
     7005               .
     7006               find first buf_recipe-gds no-lock
     7007                    where buf_recipe-gds.recipe-code = buf_recipe.recipe-code
     7008                      and buf_recipe-gds.artic       = buf_goods.artic
     7009                      and buf_recipe-gds.prod-type   = buf_goods.prod-type
     7010                      and buf_recipe-gds.prod-code   = buf_goods.prod-code
     7011               .
     7012               if buf_recipe-gds.brutto-qnty = ?
     7013               or buf_recipe-gds.brutto-qnty = 0
     7014               then do:
     7015                   message
     7016                       "При раскрутке рецепта обнаружен ингредиент с количеством " buf_recipe-gds.brutto-qnty
     7017                       skip "Продолжение расчета документа невозможно."
     7018                       skip(1) "Код рецепта:      " buf_recipe.recipe-code
     7019                       skip    "Товар ингредиента:" buf_recipe-gds.artic buf_goods.gds-name
     7020                   view-as alert-box error.
     7021                   undo, return error .
     7022               end.
     7023               assign
     7024                   p-out-gds-qnty = p-gds-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     7025                   p-out-trn-type = ( if p-trn-type = 'спи':U then 'при':U else 'спи':U )
     7026               .
     7027               run writelog in this-procedure (
     7028                   input log-file-name
     7029                   , input 1
     7030                   , input substitute( "Количество товара: &1. Для его производства необходимо: &2 по рецепту: &3. Тип строки составного: &4."
     7031                                       , p-gds-qnty
     7032                                       , p-out-gds-qnty
     7033                                       , p-out-recipe-code
     7034                                       , p-out-trn-type )
     7035               ).
     7036           end.
     7037           else do:
     7038               assign
     7039                   p-out-gds-qnty = p-gds-qnty
     7040                   p-out-trn-type = p-trn-type
     7041               .
     7042               run writelog in this-procedure (
     7043                     input log-file-name
     7044                   , input 1
     7045                   , input substitute( "Для производства товара необходимо: &1 по рецепту: &2. Тип строки: &3."
     7046                                       , p-out-gds-qnty
     7047                                       , p-out-recipe-code
     7048                                       , p-out-trn-type )
     7049               ).
     7050           end.
     7051       end.
     7052   end.
     7053   END PROCEDURE.
     7054   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7055   define new global shared variable g#attr-lib  as handle no-undo .
     7056   define variable v-attr-lib-variable as handle no-undo .
     7057   procedure gds-attr-name :
     7058     define input  parameter p-code           as character no-undo .
     7059     define output parameter p-type           as character no-undo .
     7060     define output parameter p-format         as character no-undo .
     7061     define output parameter p-label          as character no-undo .
     7062     define output parameter p-user-can-edit  as logical   no-undo .
     7063     define output parameter p-output-display as logical   no-undo .
     7064     define output parameter p-other          as character no-undo .
     7065     do
     7066     on error undo, return error
     7067     :
     7068           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     7069         (input  p-code
     7070         ,output p-type
     7071         ,output p-format
     7072         ,output p-label
     7073         ,output p-user-can-edit
     7074         ,output p-output-display
     7075         ,output p-other
     7076         ) no-error .
     7077       if error-status :error
     7078       then do:
     7079         undo, return error return-value .
     7080       end.
     7081     end.
     7082   end procedure.
