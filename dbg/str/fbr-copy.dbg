     1689   define temp-table tt-marking like ub.marking
     1690     .
     1691   define temp-table tt-utd-marking-lines like ub.utd-marking-lines
     1692     .
     1693   define temp-table tt-inv-marking no-undo
     1694     field gds-code      as integer
