     1734   .
     1735   procedure fbrcode-gen-recipe-code :
     1736   do
     1737   on error undo, return error
     1738   :
     1739   define input parameter p-obj-type           as character    no-undo.
     1740   define input parameter p-obj-code           as integer      no-undo.
     1741   define output parameter p-recipe-code       as character    no-undo.
     1742       assign
     1743           p-recipe-code   = string( next-value( s-recipe, ub ) )
     1744                               + "-"
     1745                               + trim( string( p-obj-code, ">>>>9" ) )
     1746                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     1747       .
     1748   end.
     1749   end procedure.
     1750   procedure fbrcode-is-from-object :
     1751   do
     1752   on error undo, return error
     1753   :
     1754   define input parameter p-doc-code           as character    no-undo.
     1755   define input parameter p-obj-type           as character    no-undo.
     1756   define input parameter p-obj-code           as integer      no-undo.
     1757   define output parameter p-is-from-object    as logical      no-undo.
     1758       if num-entries( p-doc-code, "-" ) < 2
     1759       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
     1760                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     1761       then do:
     1762           assign
     1763               p-is-from-object = no
     1764           .
     1765       end.
     1766       else do:
     1767           assign
     1768               p-is-from-object = yes
     1769           .
     1770       end.
     1771   end.
     1772   end procedure.
     1773   procedure fbrcode-trn-doc :
     1774   do
     1775   on error undo, return error
     1776   :
     1777       define input parameter p-out-doc-type       as character    no-undo.
     1778       define input parameter p-out-code           as character    no-undo.
     1779       define input parameter p-trn-doc-out-type   as character    no-undo.
     1780       define output parameter p-trn-doc-doc-code  as character   no-undo.
     1781       case p-out-doc-type:
     1782           when 'производство':U
     1783           then do:
     1784               case p-trn-doc-out-type :
     1785                   when 'рас':U
     1786                   then do:
     1787                       assign
     1788                           p-trn-doc-doc-code = p-out-code
     1789                       .
     1790                   end.
     1791                   when 'при':U
     1792                   then do:
     1793                       assign
     1794                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
     1795                       .
     1796                   end.
     1797                   when 'спи':U
     1798                   then do:
     1799                       assign
     1800                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
     1801                       .
     1802                   end.
     1803                   otherwise do:
     1804                       assign
     1805                           p-trn-doc-doc-code = ""
     1806                       .
     1807                       undo, return error "Не может быть обработан тип складского документа '"
     1808                                           + p-trn-doc-out-type + "' во входных параметрах".
     1809                   end.
     1810               end case.
     1811           end.
     1812           otherwise do:
     1813               assign
     1814                   p-trn-doc-doc-code = ""
     1815               .
     1816               undo, return error "Не может быть обработан тип внешнего документа '"
     1817                                   + p-out-doc-type + "' во входных параметрах".
     1818           end.
     1819       end case.
     1820   end.
     1821   end procedure.
     1822   procedure fbrcode-fill-fbr-by-sale-or-pln :
     1823   define input parameter p-main-doc-code      as character        no-undo.
     1824       define variable v-order    as integer      no-undo.
     1825       define buffer buf_fbr-doc               for ub.fbr-doc.
     1826       define buffer buf_trn-doc               for ub.trn-doc.
     1827       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
     1828   do
     1829   for buf_fbr-doc
     1830     , buf_trn-doc
     1831     , buf_temp_fbrcode-doc-code
     1832   on error undo, return error
     1833   :
     1834       for each buf_temp_fbrcode-doc-code
     1835       on error undo, return error
     1836       :
     1837           delete buf_temp_fbrcode-doc-code.
     1838       end.
     1839       assign
     1840           v-order = 0
     1841       .
     1842       for each buf_fbr-doc no-lock
     1843          where buf_fbr-doc.out-code = p-main-doc-code
     1844       on error undo, return error
     1845       :
     1846           create buf_temp_fbrcode-doc-code.
     1847           assign
     1848               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
     1849               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
     1850               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
     1851               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
     1852               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
     1853               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
     1854               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
     1855               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
     1856           .
     1857           for each buf_trn-doc no-lock
     1858              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
     1859           by buf_trn-doc.fact-order
     1860           on error undo, return error
     1861           :
     1862               if buf_trn-doc.ext-doc-type = 'em':U
     1863               or buf_trn-doc.ext-doc-type = 'im':U
     1864               or buf_trn-doc.ext-doc-type = 'wm':U
     1865               or buf_trn-doc.ext-doc-type = 'ev':U
     1866               then do:
     1867                   assign
     1868                       v-order = v-order + 1
     1869                   .
     1870                   create buf_temp_fbrcode-doc-code.
     1871                   assign
     1872                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
     1873                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
     1874                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
     1875                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
     1876                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
     1877                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
     1878                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
     1879                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
     1880                       buf_temp_fbrcode-doc-code.order         = v-order
     1881                   .
     1882               end.
     1883           end.
     1884           assign
     1885               v-order  = v-order + 1
     1886           .
     1887           find first buf_temp_fbrcode-doc-code
     1888                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
     1889                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
     1890           .
     1891           assign
     1892               buf_temp_fbrcode-doc-code.order = v-order
     1893           .
     1894       end.
     1895       for each buf_trn-doc no-lock
     1896          where buf_trn-doc.out-code = p-main-doc-code
     1897       by buf_trn-doc.fact-order
     1898       on error undo, return error
     1899       :
     1900           assign
     1901               v-order = v-order + 1
     1902           .
     1903           create buf_temp_fbrcode-doc-code.
     1904           assign
     1905               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
     1906               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
     1907               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
     1908               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
     1909               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
     1910               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
     1911               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
     1912               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
     1913               buf_temp_fbrcode-doc-code.order         = v-order
     1914           .
     1915       end.
     1916   end.
     1917   end procedure.
     1918   procedure fbrcode-get-final-doc :
     1919   define input parameter p-main-doc-code      as character        no-undo.
     1920   define output parameter p-income-doc-code   as character        no-undo.
     1921       define variable v-main-obj-type    as character    no-undo.
     1922       define variable v-main-obj-code    as integer      no-undo.
     1923       define buffer buf_trn-doc               for ub.trn-doc.
     1924       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
     1925   do
     1926   for buf_trn-doc
     1927   on error undo, return error
     1928   :
     1929       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
     1930           input p-main-doc-code
     1931       ).
     1932       find first buf_trn-doc no-lock
     1933            where buf_trn-doc.doc-code = p-main-doc-code
     1934       .
     1935       assign
     1936           v-main-obj-type = buf_trn-doc.obj-type
     1937           v-main-obj-code = buf_trn-doc.obj-code
     1938       .
     1939       find first buf_temp_fbrcode-doc-code
     1940            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
     1941              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
     1942              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
     1943       no-error.
     1944       if available buf_temp_fbrcode-doc-code
     1945       then do:
     1946           find first buf_trn-doc no-lock
     1947                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
     1948                  and buf_trn-doc.ext-doc-type = 'iv':U
     1949           .
     1950           assign
     1951               p-income-doc-code = buf_trn-doc.doc-code
     1952           .
     1953       end.
     1954       else do:
     1955           find first buf_temp_fbrcode-doc-code
     1956                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
     1957                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
     1958                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
     1959           no-error.
     1960           if available buf_temp_fbrcode-doc-code
     1961           then do:
     1962               assign
     1963                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
     1964               .
     1965           end.
     1966           else do:
     1967               assign
     1968                   p-income-doc-code = "":U
     1969               .
     1970           end.
     1971       end.
     1972   end.
     1973   end procedure.
