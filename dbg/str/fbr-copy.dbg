      857   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      858   define  new shared  temp-table dtl-rests-mark no-undo
      859   field artic like ub.gds-dtl.artic
      860   field prod-type like ub.gds-dtl.prod-type
      861   field prod-code like ub.gds-dtl.prod-code
