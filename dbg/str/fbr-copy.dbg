      866   .
      867   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      868   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      869   procedure partslib-clear-temp-parts :
      870     define buffer buf_temp-parts for temp-parts .
      871     do
      872     on error undo, return error
      873     :
      874       for each buf_temp-parts
      875       on error undo, return error
      876       :
      877         delete buf_temp-parts .
      878       end.
      879     end.
      880   end procedure.
      881   procedure partslib-create-temp-parts :
      882     define parameter buffer buf_parts       for ub.parts .
      883     define parameter buffer buf_temp-parts  for temp-parts .
      884     define input  parameter p-goods-twounit as logical   no-undo .
      885     define variable v-base-part-code as character no-undo .
      886     do
      887     on error undo, return error
      888     :
      889       if p-goods-twounit = true
      890       then do:
      891         assign
      892           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      893         .
      894       end.
      895       else do:
      896         assign
      897           v-base-part-code = buf_parts.part-code
      898         .
      899       end.
      900       find first buf_temp-parts exclusive-lock
      901         where buf_temp-parts.obj-type  = buf_parts.obj-type
      902           and buf_temp-parts.obj-code  = buf_parts.obj-code
      903           and buf_temp-parts.artic     = buf_parts.artic
      904           and buf_temp-parts.prod-type = buf_parts.prod-type
      905           and buf_temp-parts.prod-code = buf_parts.prod-code
      906           and buf_temp-parts.in-code   = buf_parts.in-code
      907           and buf_temp-parts.out-code  = 'free-zone':U
      908           and buf_temp-parts.part-code = v-base-part-code
      909         no-error.
      910       if not available buf_temp-parts
      911       then do:
      912         create buf_temp-parts .
      913         buffer-copy buf_parts to buf_temp-parts
      914         assign
      915           buf_temp-parts.out-code  = 'free-zone':U
      916           buf_temp-parts.part-code = v-base-part-code
      917           buf_temp-parts.rsrv-free = yes
      918           buf_temp-parts.status_   = no
      919           buf_temp-parts.qnty      = 0
      920           buf_temp-parts.fact-qnty = 0
      921           buf_temp-parts.real-qnty = 0
      922           buf_temp-parts.cli-qnty  = 0
      923         .
      924       end.
      925     end.
      926   end procedure.
      927   procedure partslib-init-temp-parts :
      928     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      929     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      930     define input parameter p-artic           like ub.parts.artic     no-undo .
      931     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      932     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      933     define buffer buf_parts      for ub.parts .
      934     define buffer buf_temp-parts for temp-parts .
      935     define variable v-goods-twounit    as logical   no-undo .
      936     do
      937     on error undo, return error
      938     :
      939   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      940   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      941     (input  p-artic
      942     ,input  p-prod-type
      943     ,input  p-prod-code
      944     ,input  'twounit=request':u
      945     ,output v-goods-twounit
      946     ) no-error .
      947       if error-status :error
      948       then do:
      949         message
      950           vss-workfile vss-revision vss-description skip
      951           vss-include-info9 skip
      952           "Ошибка при определении атрибута товара" skip
      953           "Артикул" p-artic p-prod-type p-prod-code skip
      954           "twounit=request" skip
      955           error-status :get-message(1) skip
      956           return-value skip
      957           view-as alert-box error .
      958         undo, return error return-value .
      959       end.
      960       run partslib-clear-temp-parts in this-procedure .
      961       for each buf_parts
      962         where buf_parts.obj-type  = p-obj-type
      963           and buf_parts.obj-code  = p-obj-code
      964           and buf_parts.artic     = p-artic
      965           and buf_parts.prod-type = p-prod-type
      966           and buf_parts.prod-code = p-prod-code
      967           and buf_parts.rsrv-free = yes
      968           and buf_parts.status_   = no
      969           and buf_parts.in-code   <> buf_parts.out-code
      970       on error undo, return error
      971       :
      972         run partslib-create-temp-parts in this-procedure
      973           (buffer buf_parts
      974           ,buffer buf_temp-parts
      975           ,input  v-goods-twounit
      976           ) .
      977         define variable v-parts-qnty          as decimal   no-undo .
      978         define variable v-parts-cli-qnty      as decimal   no-undo .
      979         define variable v-parts-free-qnty     as decimal   no-undo .
      980         define variable v-parts-free-cli-qnty as decimal   no-undo .
      981         if buf_parts.out-code = 'free-zone':U
      982         then do:
      983           assign
      984             v-parts-qnty          = buf_parts.qnty
      985             v-parts-cli-qnty      = buf_parts.cli-qnty
      986             v-parts-free-qnty     = buf_parts.qnty
      987             v-parts-free-cli-qnty = buf_parts.cli-qnty
      988           .
      989         end.
      990         else do:
      991           assign
      992             v-parts-qnty          = abs(buf_parts.qnty)
      993             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      994             v-parts-free-qnty     = 0
      995             v-parts-free-cli-qnty = 0
      996           .
      997         end.
      998         assign
      999           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1000           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1001           buf_temp-parts.real-qnty     = 0
     1002           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1003           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1004           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1005         .
     1006       end.
     1007     end.
     1008   end procedure.
     1009   procedure partslib-init-temp-parts-by-factord :
     1010     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1011     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1012     define input parameter p-artic              like ub.parts.artic     no-undo .
     1013     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1014     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1015     define input parameter p-fact-order         as decimal   no-undo .
     1016     define input parameter p-include-fact-order as logical   no-undo .
     1017     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1018     define buffer buf_gds-obj  for ub.gds-obj .
     1019     do
     1020     on error undo, return error
     1021     :
     1022       do transaction
     1023       on error undo, return error
     1024       :
     1025   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1026   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1027     (input  p-obj-type
     1028     ,input  p-obj-code
     1029     ,input  p-artic
     1030     ,input  p-prod-type
     1031     ,input  p-prod-code
     1032     ,buffer buf_gds-obj
     1033     ) no-error .
     1034         if error-status :error
     1035         then do:
     1036           message
     1037             vss-workfile vss-revision vss-description skip
     1038             vss-include-info9 skip
     1039             "Невозможно найти товар на объекте" skip
     1040             "Объект" p-obj-type p-obj-code skip
     1041             "Артикул" p-artic p-prod-type p-prod-code skip
     1042             error-status :get-message(1) skip
     1043             return-value skip
     1044             view-as alert-box error .
     1045           undo, return error .
     1046         end.
     1047         find current buf_gds-obj exclusive-lock .
     1048       end.
     1049       run partslib-init-temp-parts in this-procedure
     1050         (input p-obj-type
     1051         ,input p-obj-code
     1052         ,input p-artic
     1053         ,input p-prod-type
     1054         ,input p-prod-code
     1055         ) no-error .
     1056       if error-status :error
     1057       then do:
     1058         message
     1059           vss-workfile vss-revision vss-description skip
     1060           vss-include-info9 skip
     1061           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1062           "Объект" p-obj-type p-obj-code skip
     1063           "Артикул" p-artic p-prod-type p-prod-code skip
     1064           "p-fact-order" p-fact-order skip
     1065           view-as alert-box error .
     1066         undo, return error .
     1067       end.
     1068       if p-include-fact-order = true
     1069       then do:
     1070         assign
     1071           p-fact-order = p-fact-order - 0.0000000001
     1072         .
     1073       end.
     1074       define variable v-max-fact-order as character no-undo .
     1075       run factord-max-fact-order in this-procedure
     1076         (output v-max-fact-order
     1077         ) no-error .
     1078       if error-status :error
     1079       then do:
     1080         message
     1081           vss-workfile vss-revision vss-description skip
     1082           vss-include-info9 skip
     1083           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1084           "Объект" p-obj-type p-obj-code skip
     1085           "Артикул" p-artic p-prod-type p-prod-code skip
     1086           "p-fact-order" p-fact-order skip
     1087           view-as alert-box error .
     1088         undo, return error .
     1089       end.
     1090       run partslib-update-by-factord in this-procedure
     1091         (input p-obj-type
     1092         ,input p-obj-code
     1093         ,input p-artic
     1094         ,input p-prod-type
     1095         ,input p-prod-code
     1096         ,input p-fact-order
     1097         ,input v-max-fact-order
     1098         ,input false
     1099         ) no-error .
     1100       if error-status :error
     1101       then do:
     1102         message
     1103           vss-workfile vss-revision vss-description skip
     1104           vss-include-info9 skip
     1105           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1106           "Объект" p-obj-type p-obj-code skip
     1107           "Артикул" p-artic p-prod-type p-prod-code skip
     1108           "p-fact-order" p-fact-order skip
     1109           "v-max-fact-order" v-max-fact-order skip
     1110           view-as alert-box error .
     1111         undo, return error .
     1112       end.
     1113     end.
     1114   end procedure.
     1115   procedure partslib-update-by-factord :
     1116     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1117     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1118     define input parameter p-artic              like ub.parts.artic     no-undo .
     1119     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1120     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1121     define input parameter p-start-fact-order   as decimal   no-undo .
     1122     define input parameter p-end-fact-order     as decimal   no-undo .
     1123     define input parameter p-lock-gds-obj       as logical   no-undo .
     1124     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1125     define buffer buf_gds-obj  for ub.gds-obj .
     1126     define buffer buf_doc-line for ub.doc-line .
     1127     define variable v-total-parts-qnty as decimal   no-undo .
     1128     define variable v-goods-gds-goods  as logical   no-undo .
     1129     define variable v-goods-twounit    as logical   no-undo .
     1130     do
     1131     on error undo, return error
     1132     :
     1133       if p-start-fact-order > p-end-fact-order
     1134       then do:
     1135         message
     1136           vss-workfile vss-revision vss-description skip
     1137           vss-include-info9 skip
     1138           "Ошибка задания входных параметров" skip
     1139           "Начало интервала превышает конец интервала" skip
     1140           "Объект" p-obj-type p-obj-code skip
     1141           "Артикул" p-artic p-prod-type p-prod-code skip
     1142           "p-start-fact-order" p-start-fact-order skip
     1143           "p-end-fact-order"   p-end-fact-order skip
     1144           view-as alert-box error .
     1145         undo, return error .
     1146       end.
     1147       if p-lock-gds-obj = true
     1148       then do:
     1149         do transaction
     1150         on error undo, return error
     1151         :
     1152   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1154     (input  p-obj-type
     1155     ,input  p-obj-code
     1156     ,input  p-artic
     1157     ,input  p-prod-type
     1158     ,input  p-prod-code
     1159     ,buffer buf_gds-obj
     1160     ) no-error .
     1161           if error-status :error
     1162           then do:
     1163             message
     1164               vss-workfile vss-revision vss-description skip
     1165               vss-include-info9 skip
     1166               "Невозможно найти gds-obj" skip
     1167               error-status :get-message(1) skip
     1168               return-value skip
     1169               view-as alert-box error .
     1170             undo, return error .
     1171           end.
     1172           find current buf_gds-obj exclusive-lock .
     1173         end.
     1174       end.
     1175   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1177     (input  p-artic
     1178     ,input  p-prod-type
     1179     ,input  p-prod-code
     1180     ,input  'gds-goods=request':u
     1181     ,output v-goods-gds-goods
     1182     ) no-error .
     1183       if error-status :error
     1184       then do:
     1185         message
     1186           vss-workfile vss-revision vss-description skip
     1187           vss-include-info9 skip
     1188           "Ошибка при определении атрибута товара" skip
     1189           "Артикул" p-artic p-prod-type p-prod-code skip
     1190           "gds-goods=request" skip
     1191           error-status :get-message(1) skip
     1192           return-value skip
     1193           view-as alert-box error .
     1194         undo, return error return-value .
     1195       end.
     1196   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1197   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1198     (input  p-artic
     1199     ,input  p-prod-type
     1200     ,input  p-prod-code
     1201     ,input  'twounit=request':u
     1202     ,output v-goods-twounit
     1203     ) no-error .
     1204       if error-status :error
     1205       then do:
     1206         message
     1207           vss-workfile vss-revision vss-description skip
     1208           vss-include-info9 skip
     1209           "Ошибка при определении атрибута товара" skip
     1210           "Артикул" p-artic p-prod-type p-prod-code skip
     1211           "twounit=request" skip
     1212           error-status :get-message(1) skip
     1213           return-value skip
     1214           view-as alert-box error .
     1215         undo, return error return-value .
     1216       end.
     1217       for each buf_doc-line no-lock
     1218         where buf_doc-line.obj-type   = p-obj-type
     1219           and buf_doc-line.obj-code   = p-obj-code
     1220           and buf_doc-line.artic      = p-artic
     1221           and buf_doc-line.prod-type  = p-prod-type
     1222           and buf_doc-line.prod-code  = p-prod-code
     1223           and buf_doc-line.status_    = 'факт':U
     1224           and buf_doc-line.fact-order > p-start-fact-order
     1225           and buf_doc-line.fact-order <= p-end-fact-order
     1226       on error undo, return error
     1227       :
     1228         run partslib-process-document in this-procedure
     1229           (input  buf_doc-line.doc-code
     1230           ,input  p-obj-type
     1231           ,input  p-obj-code
     1232           ,input  p-artic
     1233           ,input  p-prod-type
     1234           ,input  p-prod-code
     1235           ,input  v-goods-gds-goods
     1236           ,input  v-goods-twounit
     1237           ,output v-total-parts-qnty
     1238           ) no-error .
     1239         if error-status :error
     1240         then do:
     1241           message
     1242             vss-workfile vss-revision vss-description skip
     1243             vss-include-info9 skip
     1244             "Ошибка при вызове процедуры partslib-process-document" skip
     1245             "Документ" buf_doc-line.doc-code skip
     1246             "Объект" p-obj-type p-obj-code skip
     1247             "Артикул" p-artic p-prod-type p-prod-code skip
     1248             "p-start-fact-order" p-start-fact-order skip
     1249             "p-end-fact-order" p-end-fact-order skip
     1250             error-status :get-message(1) skip
     1251             return-value skip
     1252             view-as alert-box error .
     1253           undo, return error return-value .
     1254         end.
     1255       end.
     1256     end.
     1257   end procedure.
     1258   procedure partslib-process-document :
     1259     define input  parameter p-doc-code         as character no-undo .
     1260     define input  parameter p-obj-type         as character no-undo .
     1261     define input  parameter p-obj-code         as integer   no-undo .
     1262     define input  parameter p-artic            as character no-undo .
     1263     define input  parameter p-prod-type        as character no-undo .
     1264     define input  parameter p-prod-code        as integer   no-undo .
     1265     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1266     define input  parameter p-goods-twounit    as logical   no-undo .
     1267     define output parameter p-total-parts-qnty as decimal   no-undo .
     1268     define variable v-parts-sign as integer   no-undo .
     1269     define buffer buf_trn-doc    for ub.trn-doc .
     1270     define buffer buf_doc-line   for ub.doc-line .
     1271     define buffer buf_parts      for ub.parts .
     1272     define buffer buf_temp-parts for temp-parts .
     1273     do
     1274     on error undo, return error return-value
     1275     :
     1276       find first buf_trn-doc no-lock
     1277         where buf_trn-doc.doc-code = p-doc-code
     1278         no-error .
     1279       if not available buf_trn-doc
     1280       then do:
     1281         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1282                                      ,p-doc-code
     1283                                      ) .
     1284       end.
     1285       case buf_trn-doc.doc-type
     1286       :
     1287         when 'при':U or
     1288         when 'возврат':U or
     1289         when 'инв':U
     1290         then do:
     1291           assign
     1292             v-parts-sign = -1
     1293           .
     1294         end.
     1295         when 'рас':U or
     1296         when 'спи':U
     1297         then do:
     1298           assign
     1299             v-parts-sign = 1
     1300           .
     1301         end.
     1302         otherwise do:
     1303           undo, return error substitute("Неизвестный тип документа &1"
     1304                                       ,buf_trn-doc.doc-type
     1305                                       ) .
     1306         end.
     1307       end.
     1308       find first buf_doc-line no-lock
     1309         where buf_doc-line.doc-code  = p-doc-code
     1310           and buf_doc-line.artic     = p-artic
     1311           and buf_doc-line.prod-type = p-prod-type
     1312           and buf_doc-line.prod-code = p-prod-code
     1313         no-error .
     1314       if not available buf_doc-line
     1315       then do:
     1316         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1317                                      ,p-doc-code
     1318                                      ,artic
     1319                                      ,prod-type
     1320                                      ,prod-code
     1321                                      ) .
     1322       end.
     1323       assign
     1324         p-total-parts-qnty = 0
     1325       .
     1326       if p-goods-gds-goods = true
     1327       then do:
     1328         for each buf_parts no-lock
     1329           where buf_parts.out-code  = p-doc-code
     1330             and buf_parts.obj-type  = p-obj-type
     1331             and buf_parts.obj-code  = p-obj-code
     1332             and buf_parts.artic     = p-artic
     1333             and buf_parts.prod-type = p-prod-type
     1334             and buf_parts.prod-code = p-prod-code
     1335         on error undo, return error
     1336         :
     1337           run partslib-create-temp-parts in this-procedure
     1338             (buffer buf_parts
     1339             ,buffer buf_temp-parts
     1340             ,input  p-goods-twounit
     1341             ) .
     1342           assign
     1343             p-total-parts-qnty        = p-total-parts-qnty
     1344                                       + v-parts-sign * buf_parts.fact-qnty
     1345             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1346                                       + v-parts-sign * buf_parts.fact-qnty
     1347             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1348                                       + v-parts-sign * buf_parts.fact-qnty
     1349             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1350                                       + v-parts-sign * buf_parts.cli-qnty
     1351           .
     1352           if buf_temp-parts.qnty = 0
     1353           then do:
     1354             delete buf_temp-parts .
     1355           end.
     1356         end.
     1357       end.
     1358       else do:
     1359         assign
     1360           p-total-parts-qnty = p-total-parts-qnty
     1361                              + v-parts-sign * buf_doc-line.fact-qnty
     1362         .
     1363       end.
     1364     end.
     1365   end procedure.
     1366   procedure partslib-init-temp-parts-by-date :
     1367     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1368     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1369     define input parameter p-artic           like ub.parts.artic     no-undo .
     1370     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1371     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1372     define input parameter p-fact-date       as date      no-undo .
     1373     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1374     do
     1375     on error undo, return error
     1376     :
     1377       define variable v-fact-order                as decimal   no-undo .
     1378       define variable v-shift-end-fact-order      as decimal   no-undo .
     1379       define variable v-day-end-fact-order        as decimal   no-undo .
     1380       run factord in this-procedure
     1381         (input  p-fact-date
     1382         ,input  1
     1383         ,input  1
     1384         ,input  ?
     1385         ,input  0
     1386         ,input  false
     1387         ,output v-fact-order
     1388         ,output v-shift-end-fact-order
     1389         ,output v-day-end-fact-order
     1390         ) no-error .
     1391       if error-status :error
     1392       then do:
     1393         message
     1394           vss-workfile vss-revision vss-description skip
     1395           vss-include-info9 skip
     1396           "Ошибка при определении момента времени, на который требуется остаток" skip
     1397           "Объект" p-obj-type p-obj-code skip
     1398           "Артикул" p-artic p-prod-type p-prod-code skip
     1399           "Дата" p-fact-date skip
     1400           view-as alert-box error .
     1401         undo, return error .
     1402       end.
     1403       run partslib-init-temp-parts-by-factord in this-procedure
     1404         (input p-obj-type
     1405         ,input p-obj-code
     1406         ,input p-artic
     1407         ,input p-prod-type
     1408         ,input p-prod-code
     1409         ,input v-day-end-fact-order
     1410         ,input false
     1411         ) no-error .
     1412       if error-status :error
     1413       then do:
     1414         message
     1415           vss-workfile vss-revision vss-description skip
     1416           vss-include-info9 skip
     1417           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1418           "Объект" p-obj-type p-obj-code skip
     1419           "Артикул" p-artic p-prod-type p-prod-code skip
     1420           "Дата" p-fact-date skip
     1421           view-as alert-box error .
     1422         undo, return error .
     1423       end.
     1424     end.
     1425   end procedure.
     1426   procedure partslib-calc-cost :
     1427     define output parameter p-fact-qnty      as decimal   no-undo .
     1428     define output parameter p-vat-pc         as decimal   no-undo .
     1429     define output parameter p-slt-pc         as decimal   no-undo .
     1430     define output parameter p-sum-base       as decimal   no-undo .
     1431     define output parameter p-sum-rubl       as decimal   no-undo .
     1432     define output parameter p-vat-base       as decimal   no-undo .
     1433     define output parameter p-vat-rubl       as decimal   no-undo .
     1434     define output parameter p-slt-base       as decimal   no-undo .
     1435     define output parameter p-slt-rubl       as decimal   no-undo .
     1436     define output parameter p-road-tax-base  as decimal   no-undo .
     1437     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1438     define output parameter p-transport-base as decimal   no-undo .
     1439     define output parameter p-transport-rubl as decimal   no-undo .
     1440     define output parameter p-other-base     as decimal   no-undo .
     1441     define output parameter p-other-rubl     as decimal   no-undo .
     1442     define output parameter p-excise-base    as decimal   no-undo .
     1443     define output parameter p-excise-rubl    as decimal   no-undo .
     1444     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1445     do
     1446     on error undo, return error return-value
     1447     :
     1448       define buffer buf_temp-parts for temp-parts .
     1449       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1450       define buffer   in-vatp-parts    for ub.parts   .
     1451       define buffer   in-vatp-doc      for ub.trn-doc .
     1452       define buffer   in-vatp-goods    for ub.goods   .
     1453       define buffer   in-vatp-sysconf  for ub.sysconf .
     1454       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1455       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1456       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1457       define variable varinvprb                  as   character              no-undo.
     1458       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1459       define variable cli-base-rate              as   decimal                no-undo.
     1460       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1461       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1462       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1463       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1464       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1465       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1466       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1467       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1468       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1469       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1470       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1471       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1472       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1473       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1474       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1475       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1476       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1477       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1478       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1479       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1480       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1481       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1482       define variable varinvatp-envd             as   character              no-undo.
     1483       define variable varinvatp-type             as   character              no-undo.
     1484       for each buf_temp-parts
     1485       on error undo, return error
     1486       :
     1487   assign
     1488     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1489     price-base-with-tax-loc = buf_temp-parts.price-base
     1490   .
     1491   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1492   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1493     (output varinvprb
     1494     )  .
     1495     if buf_temp-parts.out-code = 'free-zone':U     or
     1496        buf_temp-parts.out-code = 'out-zone':U   or
     1497        buf_temp-parts.doc-type = 'акт':U then do:
     1498       assign
     1499         in-vatp-have-vat-slt = yes.
     1500     end.
     1501     else do:
     1502       find first in-vatp_doc-attr no-lock
     1503         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1504           and in-vatp_doc-attr.attr-code = 'envd':U
     1505         no-error .
     1506       if not available in-vatp_doc-attr then do:
     1507         assign
     1508           in-vatp-have-vat-slt = yes.
     1509       end.
     1510       else do:
     1511            in-vatp-have-vat-slt = no.
     1512       end.
     1513     end.
     1514     assign
     1515      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1516      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1517     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1518              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1519     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1520             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1521             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1522             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1523             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1524             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1525             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1526       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1527     assign
     1528       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1529     assign
     1530       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1531       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1532       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1533       transport-cli-loc  = 0
     1534       other-cli-loc      = 0
     1535     .
     1536   ASSIGN
     1537             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1538       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1539   .
     1540         assign
     1541           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1542           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1543           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1544           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1545           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1546           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1547           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1548           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1549           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1550           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1551           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1552           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1553           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1554           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1555           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1556           p-excise-base    = p-excise-base    + 0
     1557           p-excise-rubl    = p-excise-rubl    + 0
     1558         .
     1559       end.
     1560       if p-fact-qnty      = ?
     1561       or p-sum-base       = ?
     1562       or p-sum-rubl       = ?
     1563       or p-vat-base       = ?
     1564       or p-vat-rubl       = ?
     1565       or p-slt-base       = ?
     1566       or p-slt-rubl       = ?
     1567       or p-road-tax-base  = ?
     1568       or p-road-tax-rubl  = ?
     1569       or p-transport-base = ?
     1570       or p-transport-rubl = ?
     1571       or p-other-base     = ?
     1572       or p-other-rubl     = ?
     1573       or p-excise-base    = ?
     1574       or p-excise-rubl    = ?
     1575       then do:
     1576         message
     1577           vss-workfile vss-revision vss-description skip
     1578           vss-include-info9 skip
     1579           "Программа in-vatp.i вернула неопределенные значения" skip
     1580           "p-fact-qnty"      p-fact-qnty      skip
     1581           "p-sum-base"       p-sum-base       skip
     1582           "p-sum-rubl"       p-sum-rubl       skip
     1583           "p-vat-base"       p-vat-base       skip
     1584           "p-vat-rubl"       p-vat-rubl       skip
     1585           "p-slt-base"       p-slt-base       skip
     1586           "p-slt-rubl"       p-slt-rubl       skip
     1587           "p-road-tax-base"  p-road-tax-base  skip
     1588           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1589           "p-transport-base" p-transport-base skip
     1590           "p-transport-rubl" p-transport-rubl skip
     1591           "p-other-base"     p-other-base     skip
     1592           "p-other-rubl"     p-other-rubl     skip
     1593           "p-excise-base"    p-excise-base    skip
     1594           "p-excise-rubl"    p-excise-rubl    skip
     1595           view-as alert-box error .
     1596         undo, return error .
     1597       end.
     1598     end.
     1599   end procedure.
     1600   define temp-table tt-utd like ub.utd
     1601     field stts        as character
     1602     field stts-edi    as character
     1603     field cli-name    as character
     1604     field EDoTypeName as character
     1605     field ModifyTime_ as character
     1606     field orig-code   as character
     1607     field GrayZone    as logical
     1608     field obj-name    as character
     1609     field is-initial  as character
     1610     field scan-qnty   as decimal
     1611     field free-qnty   as decimal
