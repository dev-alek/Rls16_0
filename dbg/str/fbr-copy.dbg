     5866                           skip "Вы можете добавить введенное количество в строку документа,"
     5867                           skip "изменить количество в документе на введенное"
     5868                           skip "или отменить добавление товара, оставив рецепт без изменений"
     5869                           skip(1)
     5870                           skip "Артикул товара:        " buf_start_temp_goods-qnty.artic
     5871                           skip "Количество в документе:" p-same-good-old-qnty
     5872                           skip(1)
     5873                           skip "Добавить в строку?"
     5874                       view-as alert-box question
     5875                       buttons yes-no-cancel
     5876                       title "Добавление товара"
     5877                       update v-yesno.
     5878                       if v-yesno = ?
     5879                       then do:
     5880                           assign
