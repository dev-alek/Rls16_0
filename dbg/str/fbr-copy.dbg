     8092   procedure ggoattr-delete :
     8093     define input  parameter p-node-code   like ub.gds-grp-obj-attr.node-code     no-undo .
     8094     define input  parameter p-host-code    like ub.gds-grp-obj-attr.host-code     no-undo .
     8095     define input  parameter p-obj-type     like ub.gds-grp-obj-attr.obj-type     no-undo .
     8096     define input  parameter p-obj-code     like ub.gds-grp-obj-attr.obj-code     no-undo .
     8097     define input  parameter p-code     like ub.gds-grp-obj-attr.attr-code  no-undo .
