     2155     , buf_store
     2156     , buf_sysconf
     2157   on error undo, return error
     2158   :
     2159     case p-obj-type  :
     2160       when 'маг':U then do:
     2161           find first buf_shop no-lock
     2162                 where buf_shop.obj-code = p-obj-code
     2163           no-error.
