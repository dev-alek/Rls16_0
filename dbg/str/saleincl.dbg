       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   procedure cur-time :
       98      define output parameter p-today as date      no-undo .
       99      define output parameter p-time  as integer   no-undo .
      100     do
      101     on error undo, return error
      102     :
      103       define variable v-date1 as date      no-undo .
      104       define variable v-date2 as date      no-undo .
      105       define variable v-time  as integer   no-undo .
      106       assign
      107         v-date1 = today
      108         v-time  = time
      109         v-date2 = today
      110       .
      111       if v-date1 <> v-date2
      112       then do:
      113         assign
      114           v-date1 = today
      115           v-time  = v-time
      116         .
      117       end.
      118       assign
      119         p-today = v-date1
      120         p-time  = v-time
      121       .
      122     end.
      123   end.
      124   function cur-time-date returns character
      125   :
      126     return string(today, '99/99/9999':U) .
      127   end.
      128   function cur-time-mjd returns decimal
      129   :
      130     define variable v-date as date      no-undo .
      131     define variable v-time as integer   no-undo .
      132     run cur-time in this-procedure
      133       (output v-date
      134       ,output v-time
      135       ) .
      136     return integer(v-date) - 2400002 + (v-time / 86400) .
      137   end.
      138   function cur-time-get-ending-index returns integer
      139   (input p-number as integer
      140   )
      141   :
      142     if p-number < 0
      143     or p-number = ?
      144     then do:
      145       return 1 .
      146     end.
      147     define variable v-rest as integer   no-undo .
      148     assign
      149       p-number = p-number modulo 100
      150     .
      151     if p-number < 20
      152     then do:
      153       assign
      154         v-rest = p-number
      155       .
      156     end.
      157     else do:
      158       assign
      159         v-rest = p-number modulo 10
      160       .
      161     end.
      162     case v-rest :
      163       when 1
      164       then do:
      165         return 2 .
      166       end.
      167       when 2 or
      168       when 3 or
      169       when 4
      170       then do:
      171         return 3 .
      172       end.
      173       otherwise do:
      174         return 1 .
      175       end.
      176     end case .
      177   end.
      178   procedure cur-time-mjd-to-date :
      179      define input  parameter i-mjd-diff as decimal no-undo.
      180      define output parameter o-Date     as date    no-undo.
      181      define output parameter o-Time     as integer no-undo.
      182      define variable v-day-number as integer   no-undo .
      183      if    i-mjd-diff < 0
      184         or i-mjd-diff = ?
      185      then do:
      186         return "?" .
      187      end.
      188      assign
      189         v-day-number = truncate(i-mjd-diff,0).
      190         o-Date = date(v-day-number + 2400002).
      191         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193   end.
      194   function cur-time-mjd-to-string returns character
      195   (input p-mjd-diff as decimal
      196   )
      197   :
      198     define variable v-day-number as integer   no-undo .
      199     define variable v-seconds    as integer   no-undo .
      200     define variable v-hour       as integer   no-undo .
      201     define variable v-min        as integer   no-undo .
      202     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      203     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      204     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      205     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      206     if p-mjd-diff < 0
      207     or p-mjd-diff = ?
      208     then do:
      209       return "?" .
      210     end.
      211     assign
      212       v-day-number = integer(truncate(p-mjd-diff,0))
      213       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      214     .
      215     if v-seconds > 86400
      216     then do:
      217       assign
      218         v-seconds = 86400 - 1
      219       .
      220     end.
      221     if v-seconds < 0
      222     then do:
      223       assign
      224         v-seconds = 0
      225       .
      226     end.
      227     assign
      228       v-hour = truncate(v-seconds / 3600, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 3600
      232     .
      233     assign
      234       v-min = truncate(v-seconds / 60, 0)
      235     .
      236     assign
      237       v-seconds = v-seconds modulo 60
      238     .
      239     return
      240         (if v-day-number <> 0
      241           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      242           else ""
      243         )
      244       + (if v-day-number <> 0 or v-hour <> 0
      245           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      246           else ""
      247         )
      248       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      249           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      250           else ""
      251         )
      252       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      253       .
      254   end.
      255   function cur-time-string returns character
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      264   end.
      265   function cur-time-string-sec returns character
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      274   end.
      275   function cur-time-custom  returns character
      276   (input p-prefix as character
      277   ,input p-date-format as character
      278   ,input p-delimiter as character
      279   ,input p-time-format as character
      280   ,input p-suffix as character
      281   )
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return
      290       p-prefix
      291       + string(v-date, p-date-format)
      292       + p-delimiter
      293       + string(v-time, p-time-format)
      294       + p-suffix
      295       .
      296   end.
      297   function cur-time-print  returns character
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      306   end.
      307   function cur-time-datetime returns datetime
      308   :
      309     define variable v-char as character no-undo .
      310     define variable v-datetime as datetime no-undo .
      311     v-char = cur-time-string().
      312     v-datetime = datetime(v-char).
      313     return  v-datetime.
      314   end.
      315   function cur-time-string-msec returns character
      316   :
      317     define variable v-date as datetime  no-undo .
      318     v-date = now.
      319     return string(v-date) .
      320   end.
      321   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      322   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      323   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      324   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      325   define variable gp-excise     like ub.price-list.excise     no-undo.
      326   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      327   define variable gp-fact-order as decimal   no-undo .
      328   define variable gp-price-sale-parts as decimal   no-undo .
      329   FUNCTION calc-excise RETURNS DECIMAL(input  parprice-sale as decimal,
      330                                        input  parroad-tax   as decimal,
      331                                        input  parvat-pc     as decimal,
      332                                        input  parfactorrd   as decimal,
      333                                        output parexcise     as decimal):
      334   ASSIGN parexcise = (parprice-sale - parroad-tax) * parvat-pc / (100 + parvat-pc) -
      335                      1 / parfactorrd * parroad-tax.
      336   RETURN parexcise.
      337   END FUNCTION.
      338   function diff-list returns character (
      339     input parfirst-list  as character,
      340     input parsecond-list as character,
      341     input pardelim       as character).
      342     if pardelim = ""
      343     or pardelim = ?
      344     then do:
      345       assign
      346         pardelim = ","
      347       .
      348     end.
      349     def var ind as integer no-undo .
      350     def var v-elem as character no-undo .
      351     def var v-result-list as character no-undo init "".
      352     def var v-num-parfirst-list as integer no-undo .
      353     assign
      354       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      355     .
      356     do ind = 1 to v-num-parfirst-list
      357     :
      358       assign
      359         v-elem = entry(ind, parfirst-list, pardelim)
      360       .
      361       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      362         assign
      363           v-result-list = v-result-list
      364                         + (if v-result-list > "" then pardelim else "")
      365                         + v-elem
      366         .
      367       end.
      368     end.
      369     return v-result-list .
      370   end function.
      371   function add-list returns character (
      372    input parfirst-list  as character,
      373    input parsecond-list as character,
      374    input pardelim       as character).
      375     if pardelim = ""
      376     or pardelim = ?
      377     then do:
      378       assign
      379         pardelim = ","
      380       .
      381     end.
      382     def var ind as integer no-undo .
      383     def var v-elem as character no-undo .
      384     def var v-result-list as character no-undo init "".
      385     def var v-num-parfirst-list as integer no-undo .
      386     assign
      387       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      388     .
      389     do ind = 1 to v-num-parfirst-list
      390     :
      391       assign
      392         v-elem = entry(ind, parfirst-list, pardelim)
      393       .
      394       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      395         assign
      396           v-result-list = v-result-list
      397                         + (if v-result-list > "" then pardelim else "")
      398                         + v-elem
      399         .
      400       end.
      401     end.
      402     def var v-num-parsecond-list as integer no-undo .
      403     assign
      404       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      405     .
      406     do ind = 1 to v-num-parsecond-list
      407     :
      408       assign
      409         v-elem = entry(ind, parsecond-list, pardelim)
      410       .
      411       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      412         assign
      413           v-result-list = v-result-list
      414                         + (if v-result-list > "" then pardelim else "")
      415                         + v-elem
      416         .
      417       end.
      418     end.
      419     return v-result-list .
      420   end function.
      421   function cross-list returns character (
      422    input parfirst-list  as character,
      423    input parsecond-list as character,
      424    input pardelim       as character).
      425     if pardelim = ""
      426     or pardelim = ?
      427     then do:
      428       assign
      429         pardelim = ","
      430       .
      431     end.
      432     def var ind as integer no-undo .
      433     def var v-elem as character no-undo .
      434     def var v-result-list as character no-undo init "".
      435     def var v-num-parfirst-list as integer no-undo .
      436     assign
      437       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      438     .
      439     do ind = 1 to v-num-parfirst-list
      440     :
      441       assign
      442         v-elem = entry(ind, parfirst-list, pardelim)
      443       .
      444       if lookup(v-elem, v-result-list, pardelim) = 0
      445       and lookup(v-elem, parsecond-list, pardelim) > 0
      446       then do:
      447         assign
      448           v-result-list = v-result-list
      449                         + (if v-result-list > "" then pardelim else "")
      450                         + v-elem
      451         .
      452       end.
      453     end.
      454     return v-result-list .
      455   end function.
      456   function radio-label returns character (
      457    input par-rs-value  as character,
      458    input par-rs-radio-buttons as character)
      459    .
      460    DEFINE variable v-result-label as character no-undo.
      461    assign
      462    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      463                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      464                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      465                             ), par-rs-radio-buttons
      466                           )
      467    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      468    .
      469   return v-result-label.
      470   end function.
      471   function m-radio-label returns character (
      472    input par-rs-value  as character,
      473    input par-rs-radio-buttons as character,
      474    input par-delim as character
      475    )
      476    .
      477    DEFINE variable v-result-label as character no-undo.
      478    assign
      479    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      480                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      481                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      482                             ), par-rs-radio-buttons, par-delim
      483                           )
      484    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      485    .
      486   return v-result-label.
      487   end function.
      488   FUNCTION mixlist returns character
      489   (
      490    input parfirst-list  as character
      491    ,input parsecond-list as character
      492    ,input pardelim       as character
      493    ,input pardelim-result as character ) :
      494     if pardelim = ""
      495     or pardelim = ?
      496     then do:
      497       assign
      498         pardelim = ","
      499       .
      500     end.
      501     def var ind as integer no-undo .
      502     def var v-elem1 as character no-undo .
      503     def var v-elem2 as character no-undo .
      504     def var v-result-list as character no-undo init "".
      505     do ind = 1 to num-entries(parfirst-list, pardelim)
      506     :
      507       assign
      508         v-elem1 = entry(ind, parfirst-list, pardelim)
      509         v-elem2 = entry(ind, parsecond-list, pardelim)
      510       .
      511         assign
      512           v-result-list = v-result-list
      513                         + (if v-result-list > "" then pardelim-result else "")
      514                         + v-elem1 + pardelim-result + v-elem2
      515         .
      516     end.
      517     return v-result-list .
      518   END FUNCTION.
