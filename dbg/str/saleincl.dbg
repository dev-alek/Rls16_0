     5345               ub.doc-fbr-gds.fact-qnty = ub.doc-fbr-gds.fact-qnty +  t-gds.doc-qnty .
     5346             end.
     5347         define variable v-discnt-r-b like ub.gds-dtl.discnt-rubl no-undo .
     5348     define variable v-price-r-b like ub.gds-dtl.price-rubl no-undo .
     5349             assign
     5350             v-discnt-r-b = (if (buf_gds-dtl.fact-qnty + abs(t-gds.doc-qnty)) = 0
     5351                             then 0
     5352                             else (if prcl-spl
     5353                                     then
     5354                                     (t-gds.new-price * (buf_gds-dtl.fact-qnty + abs(t-gds.doc-qnty))
     5355                                     - ((if v-curr-r-b = 'base':U then buf_gds-dtl.price-base else buf_gds-dtl.price-rubl) - (if v-curr-r-b = 'base':U then buf_gds-dtl.discnt-base else buf_gds-dtl.discnt-rubl)) * buf_gds-dtl.fact-qnty
     5356                                     - buf_sale-doc.msign * (t-gds.price-sum - t-gds.discnt-sum)
     5357                                     ) / (buf_gds-dtl.fact-qnty + abs(t-gds.doc-qnty))
     5358                                     else
     5359                                     (t-gds.price-base * (buf_gds-dtl.fact-qnty + abs(t-gds.doc-qnty))
     5360                                     - ((if v-curr-r-b = 'base':U then buf_gds-dtl.price-base else buf_gds-dtl.price-rubl) - (if v-curr-r-b = 'base':U then buf_gds-dtl.discnt-base else buf_gds-dtl.discnt-rubl)) * buf_gds-dtl.fact-qnty
     5361                                     - buf_sale-doc.msign * (t-gds.price-sum - t-gds.discnt-sum)
     5362                                     ) / (buf_gds-dtl.fact-qnty + abs(t-gds.doc-qnty))
     5363                                   )
     5364                             )
     5365             buf_gds-dtl.fact-qnty = buf_gds-dtl.fact-qnty + abs( t-gds.doc-qnty )
     5366             v-price-r-b =  (if prcl-spl then  t-gds.new-price  else t-gds.price-base )
     5367             buf_gds-dtl.price-base = (if v-curr-r-b = 'rubl':U
     5368                                   then  v-price-r-b / trn-doc.base-rate * trn-doc.base-scale
     5369                                   else v-price-r-b)
     5370             buf_gds-dtl.discnt-base = (if v-curr-r-b = 'rubl':U
     5371                                     then v-discnt-r-b / trn-doc.base-rate * trn-doc.base-scale
     5372                                     else v-discnt-r-b )
     5373             buf_gds-dtl.price-rubl = (if v-curr-r-b = 'base':U
     5374                                   then v-price-r-b * trn-doc.base-rate / trn-doc.base-scale
     5375                                   else v-price-r-b)
     5376             buf_gds-dtl.discnt-rubl = (if v-curr-r-b = 'base':U
     5377                                   then v-discnt-r-b  * trn-doc.base-rate / trn-doc.base-scale
     5378                                   else v-discnt-r-b )
     5379             buf_doc-line.road-tax = (if road
     5380                                 then
     5381                                 (buf_doc-line.road-tax * (buf_doc-line.fact-qnty - abs(t-gds.doc-qnty) ) +
     5382                                   buf_sale-doc.msign * t-gds.road-sum ) / (buf_doc-line.fact-qnty )
     5383                                 else 0)
     5384             buf_doc-line.excise = (if road
     5385                               then
     5386                               t-gds.excise
     5387                               else 0)
     5388             buf_gds-dtl.discnt-pc = (if t-gds.is-modificator then 0 else buf_gds-dtl.discnt-pc)
     5389             .
     5390             if X_chk-doc.doc-code <> buf_sale-doc.chk-doc-code
     5391             AND buf_sale-doc.main-receipt-type = X_chk-doc.chk-type
     5392             then do:
     5393               assign
     5394               buf_sale-doc.chk-doc-code = X_chk-doc.doc-code
     5395               buf_sale-doc.chk-amount = buf_sale-doc.chk-amount + 1
     5396               .
     5397             end.
     5398             assign
     5399             buf_sale-doc.tot-lines = buf_sale-doc.tot-lines + (if v-created then 1 else 0)
     5400             line-out = line-out + (if buf_sale-doc.doc-kind = 'es':U
     5401                                    and v-created
     5402                                    then 1
     5403                                    else 0)
     5404             line-ret = line-ret + (if buf_sale-doc.doc-kind = 'rs':U
     5405                                    and v-created
     5406                                    then 1
     5407                                    else 0)
     5408             buf_sale-doc.tot-dtl = buf_sale-doc.tot-dtl + (if v-created-dtl then 1 else 0)
     5409             dtl-out = dtl-out + (if buf_sale-doc.doc-kind = 'es':U
     5410                                  and v-created-dtl
     5411                                  then 1
     5412                                  else 0)
     5413             dtl-ret = dtl-ret + (if buf_sale-doc.doc-kind = 'rs':U
     5414                                  and v-created-dtl
     5415                                  then 1
     5416                                  else 0)
     5417             buf_sale-doc.gds-amount = buf_sale-doc.gds-amount + t-gds.num-lines
     5418             buf_sale-doc.fact-qnty = buf_sale-doc.fact-qnty  + t-gds.doc-qnty * buf_sale-doc.msign.
     5419           END .
     5420           var-doc-type = '':U.
     5421           if kind-to-reserv begins 'es':U then do:
     5422             var-doc-type =  'при':U.
     5423           end.
     5424           if kind-to-reserv begins 'rs':U or v-cash-pay-attr <> "" then do:
     5425             var-doc-type =  'рас':U .
     5426           end.
     5427           FOR  EACH buf_chk-pay WHERE buf_chk-pay.doc-code = X_chk-doc.doc-code
     5428           BREAK
     5429           BY buf_chk-pay.doc-code
     5430           BY buf_chk-pay.pay-code
     5431           BY buf_chk-pay.curr-code :
     5432             if var-doc-type <> '':U
     5433             or (X_chk-doc.chk-type <> integer('7':U)
     5434                 and
     5435                 lookup(string(X_chk-doc.chk-type), '2,3,4,5,7':U) > 0
     5436                 )
     5437             then do:
     5438               find first buf_inkas-pay-wth where
     5439                         buf_inkas-pay-wth.inkas-code = ink-doc.inkas-code
     5440                     and buf_inkas-pay-wth.pay-code = buf_chk-pay.pay-code
     5441                     and buf_inkas-pay-wth.curr-code = buf_chk-pay.curr-code
     5442                     and buf_inkas-pay-wth.wth-code = buf_chk-pay.wth-code
     5443                     and buf_inkas-pay-wth.par-code = buf_chk-pay.par-code
     5444                     and buf_inkas-pay-wth.pay-desk = X_chk-doc.pay-desk
     5445                     and buf_inkas-pay-wth.cashier = X_chk-doc.cashier
     5446                     and buf_inkas-pay-wth.chk-type = X_chk-doc.chk-type no-error.
     5447               if not available  buf_inkas-pay-wth then do:
     5448                 create buf_inkas-pay-wth.
     5449                 assign
     5450                 buf_inkas-pay-wth.inkas-code = ink-doc.inkas-code
     5451                 buf_inkas-pay-wth.pay-code = buf_chk-pay.pay-code
     5452                 buf_inkas-pay-wth.curr-code = buf_chk-pay.curr-code
     5453                 buf_inkas-pay-wth.wth-code = buf_chk-pay.wth-code
     5454                 buf_inkas-pay-wth.par-code = buf_chk-pay.par-code
     5455                 buf_inkas-pay-wth.pay-desk = X_chk-doc.pay-desk
     5456                 buf_inkas-pay-wth.cashier = X_chk-doc.cashier
     5457                 buf_inkas-pay-wth.chk-type = X_chk-doc.chk-type
     5458                 buf_inkas-pay-wth.par-val = buf_chk-pay.par-val
     5459                 .
     5460               end.
     5461               assign
     5462               buf_inkas-pay-wth.tot-sum = buf_inkas-pay-wth.tot-sum + buf_chk-pay.tot-sum
     5463               buf_inkas-pay-wth.tot-base = buf_inkas-pay-wth.tot-base + buf_chk-pay.tot-base
     5464               buf_inkas-pay-wth.tot-rubl = buf_inkas-pay-wth.tot-rubl + buf_chk-pay.tot-rubl
     5465               buf_inkas-pay-wth.doc-qnty = buf_inkas-pay-wth.doc-qnty + buf_chk-pay.doc-qnty
     5466               buf_inkas-pay-wth.tot-lines = buf_inkas-pay-wth.tot-lines + 1
     5467               .
     5468             end.
     5469             IF FIRST-OF(buf_chk-pay.curr-code) then do:
     5470               assign
     5471               accum-chk-pay-tot-sum-by = 0
     5472               accum-chk-pay-tot-base-by = 0
     5473               accum-chk-pay-tot-rubl-by = 0
     5474               .
     5475             end.
     5476             assign
     5477             accum-chk-pay-tot-sum-by = accum-chk-pay-tot-sum-by + buf_chk-pay.tot-sum
     5478             accum-chk-pay-tot-base-by = accum-chk-pay-tot-base-by + buf_chk-pay.tot-base
     5479             accum-chk-pay-tot-rubl-by = accum-chk-pay-tot-rubl-by + buf_chk-pay.tot-rubl
     5480             .
     5481             buf_chk-pay.out-code = ink-doc.inkas-code .
     5482             if last-of( buf_chk-pay.curr-code ) then  do:
     5483               FIND FIRST buf_inkas-pay WHERE
     5484                           buf_inkas-pay.inkas-code = ink-doc.inkas-code AND
     5485                           buf_inkas-pay.pay-code = buf_chk-pay.pay-code AND
     5486                           buf_inkas-pay.curr-code = buf_chk-pay.curr-code NO-ERROR.
     5487               if NOT available buf_inkas-pay then do:
     5488                 CREATE buf_inkas-pay.
     5489                 assign
     5490                 buf_inkas-pay.inkas-code = ink-doc.inkas-code
     5491                 buf_inkas-pay.pay-code = buf_chk-pay.pay-code
     5492                 buf_inkas-pay.curr-code = buf_chk-pay.curr-code
     5493                 buf_inkas-pay.tot-sum = 0
     5494                 buf_inkas-pay.tot-base = 0
     5495                 buf_inkas-pay.tot-rubl = 0
     5496                 .
     5497               end.
     5498               if var-doc-type <> '':U then do:
     5499                 FIND FIRST buf_inkas-pay-desk WHERE
     5500                             buf_inkas-pay-desk.inkas-code = ink-doc.inkas-code AND
     5501                             buf_inkas-pay-desk.pay-code = buf_chk-pay.pay-code AND
     5502                             buf_inkas-pay-desk.curr-code = buf_chk-pay.curr-code AND
     5503                             buf_inkas-pay-desk.pay-desk = X_chk-doc.pay-desk AND
     5504                             buf_inkas-pay-desk.doc-type = var-doc-type AND
     5505                             buf_inkas-pay-desk.cashier = X_chk-doc.cashier
     5506                             NO-ERROR.
     5507                 if NOT available buf_inkas-pay-desk then do:
     5508                   CREATE buf_inkas-pay-desk.
     5509                   assign
     5510                   buf_inkas-pay-desk.inkas-code = ink-doc.inkas-code
     5511                   buf_inkas-pay-desk.pay-code = buf_chk-pay.pay-code
     5512                   buf_inkas-pay-desk.curr-code = buf_chk-pay.curr-code
     5513                   buf_inkas-pay-desk.pay-desk = X_chk-doc.pay-desk
     5514                   buf_inkas-pay-desk.tot-sum = 0
     5515                   buf_inkas-pay-desk.tot-base = 0
     5516                   buf_inkas-pay-desk.tot-rubl = 0
     5517                   buf_inkas-pay-desk.doc-type = var-doc-type
     5518                   buf_inkas-pay-desk.cashier = X_chk-doc.cashier
     5519                   .
     5520                 end.
     5521                 assign
     5522                 buf_inkas-pay.tot-sum = buf_inkas-pay.tot-sum + accum-chk-pay-tot-sum-by
     5523                 buf_inkas-pay.tot-base = buf_inkas-pay.tot-base + accum-chk-pay-tot-base-by
     5524                 buf_inkas-pay.tot-rubl = buf_inkas-pay.tot-rubl + accum-chk-pay-tot-rubl-by
     5525                 buf_inkas-pay-desk.tot-sum = buf_inkas-pay-desk.tot-sum + accum-chk-pay-tot-sum-by
     5526                 buf_inkas-pay-desk.tot-base = buf_inkas-pay-desk.tot-base + accum-chk-pay-tot-base-by
     5527                 buf_inkas-pay-desk.tot-rubl = buf_inkas-pay-desk.tot-rubl + accum-chk-pay-tot-rubl-by
     5528                 .
     5529               end.
     5530             end.
     5531           END.
     5532           FOR EACH buf_chk-discnt where
     5533                     buf_chk-discnt.doc-code = X_chk-doc.doc-code
     5534           on error undo _one-check, leave _one-check:
     5535             assign
     5536             buf_chk-discnt.out-code = ink-doc.inkas-code
     5537             .
     5538           end.
     5539         end.
     5540        if X_chk-doc.chk-type = integer('12':U)
     5541        or X_chk-doc.chk-type = integer('43':U)
     5542        or X_chk-doc.chk-type = integer('44':U)
     5543        then do:
     5544           for each buf_chk-pay where
     5545                  buf_chk-pay.doc-code = X_chk-doc.doc-code
     5546            on error undo c-d, NEXT c-d:
     5547              buf_chk-pay.out-code = ink-doc.inkas-code .
     5548           end.
     5549         end.
     5550         for each buf_c-chk-doc where
     5551                 buf_c-chk-doc.doc-code = X_chk-doc.doc-code
     5552         on error undo c-d, NEXT c-d:
     5553           assign
     5554           buf_c-chk-doc.out-code = ink-doc.inkas-code
     5555           .
     5556         end.
     5557         for each buf_c-chk-gds where
     5558                 buf_c-chk-gds.doc-code = X_chk-doc.doc-code
     5559         on error undo c-d, NEXT c-d:
     5560           assign
     5561           buf_c-chk-gds.out-code = ink-doc.inkas-code
     5562           .
     5563         end.
     5564         for each buf_c-chk-discnt where
     5565                 buf_c-chk-discnt.doc-code = X_chk-doc.doc-code
     5566         on error undo c-d, NEXT c-d:
     5567           assign
     5568           buf_c-chk-discnt.out-code = ink-doc.inkas-code
     5569           .
     5570         end.
     5571         for each buf_c-chk-pay where
     5572                 buf_c-chk-pay.doc-code = X_chk-doc.doc-code
     5573         on error undo c-d, NEXT c-d:
     5574           assign
     5575           buf_c-chk-pay.out-code = ink-doc.inkas-code
     5576           .
     5577         end.
     5578         for each buf_c-chk-doc-attr where
     5579                 buf_c-chk-doc-attr.doc-code = X_chk-doc.doc-code
     5580         on error undo c-d, NEXT c-d:
     5581           assign
     5582           buf_c-chk-doc-attr.out-code = ink-doc.inkas-code
     5583           .
     5584         end.
     5585         for each buf_chk-gds-pay where
     5586                 buf_chk-gds-pay.doc-code = X_chk-doc.doc-code
     5587         on error undo c-d, NEXT c-d:
     5588           assign
     5589           buf_chk-gds-pay.out-code = ink-doc.inkas-code
     5590           .
     5591         end.
     5592         X_chk-doc.out-code = ink-doc.inkas-code.
     5593         if pay-gds-algo <> '' then do:
     5594           if lookup(string(X_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then do:
     5595           end.
     5596           else do:
     5597             run r-pychk0 in this-procedure ( input ub.sysconf.base-code
     5598                                             ,input X_chk-doc.doc-code) no-error.
     5599             if error-status:error then do:
     5600                 run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Чек &1 возникла ошибка при формировании распределения платежей. Чек не будет закачан в продажу&2&3"                                    , X_chk-doc.doc-code                                               , chr(10)                                                    , return-value                                                     )                                       ) .
     5601                 undo _one-check, leave _one-check.
     5602             end.
     5603           end.
     5604         end.
     5605         assign
     5606         chk-amount = chk-amount + 1
     5607         nf-chk-amount = nf-chk-amount + add-nf-amount
     5608         nff-chk-amount = nff-chk-amount + (if lookup(string(X_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then 1 else 0)
     5609         .
     5610         if X_chk-doc.chk-type <> integer('43':U) and X_chk-doc.chk-type <> integer('44':U)
     5611         then
     5612         assign
     5613         accum-chk-doc-tot-doc = accum-chk-doc-tot-doc  + X_chk-doc.tot-doc
     5614         accum-chk-doc-discnt = accum-chk-doc-discnt + X_chk-doc.discnt
     5615         accum-chk-doc-netto = accum-chk-doc-netto + X_chk-doc.netto
     5616         accum-chk-doc-sub-discnt = accum-chk-doc-sub-discnt + X_chk-doc.sub-discnt
     5617         .
     5618         if p-ii < 10
     5619         or (p-ii < 1000 and chk-amount modulo 10 = 0)
     5620         or (p-ii < 10000 and chk-amount modulo 100 = 0)
     5621         then
     5622         run display-ink-doc in p-call-handle(
     5623                                               input gds-amount
     5624                                              ,input nf-gds-amount
     5625                                              ,input line-out
     5626                                              ,input line-ret
     5627                                              ,input dtl-out
     5628                                              ,input dtl-ret
     5629                                               ).
     5630         assign
     5631         p-ii-ok = p-ii-ok + 1
     5632         .
     5633       end.
     5634     END.
     5635     assign
     5636     ink-doc.tot-doc = ink-doc.tot-doc + accum-chk-doc-tot-doc
     5637     ink-doc.discnt = ink-doc.discnt + accum-chk-doc-discnt
     5638     ink-doc.netto = ink-doc.netto + accum-chk-doc-netto
     5639     ink-doc.sub-discnt = ink-doc.sub-discnt + accum-chk-doc-sub-discnt
     5640     ink-doc.num-chk = chk-amount
     5641     ink-doc.num-chk-nf = nf-chk-amount
     5642     ink-doc.num-chk-nff = nff-chk-amount
     5643     .
     5644     assign
     5645     ink-doc.qnty = 0
     5646     .
     5647     for each buf_sale-doc where
     5648              buf_sale-doc.inkas-code = ink-doc.inkas-code
     5649          and buf_sale-doc.order > 0,
     5650         first dop_trn-doc where dop_trn-doc.doc-code = buf_sale-doc.doc-code:
     5651       assign
     5652       dop_trn-doc.fact-qnty = buf_sale-doc.fact-qnty
     5653       dop_trn-doc.tot-lines = buf_sale-doc.tot-lines
     5654       buf_sale-doc.filled = buf_sale-doc.tot-lines <> 0 or buf_sale-doc.fact-qnty <> 0
     5655       .
     5656       dop_trn-doc.ps = set-sale-doc-ps(buffer buf_sale-doc)
     5657       .
     5658       if buf_sale-doc.in-inkas then
     5659       assign
     5660       ink-doc.qnty = ink-doc.qnty + buf_sale-doc.fact-qnty * (if lookup(buf_sale-doc.ext-doc-type, 'vt,vp,rs':U) > 0 then - 1 else 1)
     5661       .
     5662     END.
     5663     assign
     5664     ink-doc.PS = set-inkas-ps (
     5665                             input ink-doc.ps
     5666                           , input chk-amount
     5667                           , input gds-amount
     5668                           , input line-out
     5669                           , input dtl-out
     5670                           , input line-ret
     5671                           , input dtl-ret
     5672                           , input nf-chk-amount
     5673                           , input nf-gds-amount
     5674                           , input p-filter-rus
     5675                           ).
     5676       for each buf_sale-doc where
     5677               buf_sale-doc.inkas-code = ink-doc.inkas-code,
     5678         first dop_trn-doc where dop_trn-doc.doc-code = buf_sale-doc.doc-code:
     5679       if buf_sale-doc.ext-doc-type <> 'es':U
     5680       and not can-find(first buf_doc-line no-lock where
     5681                       buf_doc-line.doc-code = dop_trn-doc.doc-code) then do:
     5682         assign
     5683         dop_trn-doc.status_ = 'накл':U
     5684         dop_trn-doc.flag_ = no.
     5685         run str/del-doc.p (
     5686             input parparentproc,
     5687             input  buf_sale-doc.doc-code,
     5688             input  g#db-num,
     5689             input  "del-doc.err",
     5690             input  ?,
     5691             input  ?,
     5692             input  g#userid,
     5693             input  '0',
     5694             input  varchip-code,
     5695             output varchip-code2)
     5696             no-error.
     5697         if error-status:error then do:
     5698           assign
     5699           v-mes =  substitute("Ошибка при удалении ПУСТОГО документа &1 для продажи &2&3:&3&4&3&5"
     5700                                   , buf_sale-doc.doc-code
     5701                                   , ink-doc.inkas-code
     5702                                   , chr(10)
     5703                                   , error-status:get-message(1)
     5704                                   , return-value ).
     5705   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input v-mes                                       ) .
     5706           next .
     5707         end.
     5708         else do:
     5709           delete buf_sale-doc.
     5710         end.
     5711       end.
     5712     end.
     5713     if can-find(first buf_doc-line no-lock where
     5714                     buf_doc-line.doc-code = trn-doc.doc-code)
     5715     and
     5716     not (old-doc-date = new-doc-date
     5717           AND
     5718           old-shift-date = new-shift-date
     5719           AND
     5720           old-shift-num  = new-shift-num) then do:
     5721       _tpsi_sale-doc:
     5722       for each tpsi_sale-doc where
     5723               tpsi_sale-doc.inkas-code = ink-doc.inkas-code
     5724           and tpsi_sale-doc.tpsidoc = yes,
     5725         first buf_trn-doc EXCLUSIVE-LOCK where
     5726             buf_trn-doc.doc-code = tpsi_sale-doc.doc-code
     5727       on error undo, return error
     5728       :
     5729         assign
     5730         buf_trn-doc.status_ = 'накл':U
     5731         buf_trn-doc.flag_ = no.
     5732         run str/del-doc.p (
     5733             input parparentproc,
     5734             input  tpsi_sale-doc.doc-code,
     5735             input  g#db-num,
     5736             input  "del-doc.err",
     5737             input  ?,
     5738             input  ?,
     5739             input  g#userid,
     5740             input  '0',
     5741             input  varchip-code,
     5742             output varchip-code2)
     5743             no-error.
     5744         if error-status:error then do:
     5745           assign
     5746           v-mes =  substitute("Ошибка при удалении ПУСТОГО расходного документа ЧУЖИХ товаров &1 по объекту &2&3 для продажи &4 &5:&3&6 &7"
     5747                                   , tpsi_sale-doc.doc-code
     5748                                   , (tpsi_sale-doc.obj-type + string(tpsi_sale-doc.obj-code))
     5749                                   , chr(10)
     5750                                   , ink-doc.inkas-code
     5751                                   , (ink-doc.obj-type + string(ink-doc.obj-code))
     5752                                   , error-status:get-message(1)
     5753                                   , return-value ).
     5754   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input v-mes                                       ) .
     5755           UNDO , return error.
     5756         end.
     5757         else do:
     5758           delete tpsi_sale-doc.
     5759         end.
     5760       end.
     5761       for each tt0-gds-dtl:
     5762         delete tt0-gds-dtl.
     5763       end.
     5764       for each tt0-doc-line:
     5765         delete tt0-doc-line.
     5766       end.
     5767     end.
     5768     run display-chk in p-call-handle (chk-amount, nf-chk-amount).
     5769     run display-ink-doc in p-call-handle(
     5770                                            input gds-amount
     5771                                           ,input nf-gds-amount
     5772                                           ,input line-out
     5773                                           ,input line-ret
     5774                                           ,input dtl-out
     5775                                           ,input dtl-ret
     5776                                           ).
     5777   end.
     5778   end procedure.
     5779   PROCEDURE Get-tpsi-params :
     5780   define input  parameter p-obj-type like ub.clients.obj-type no-undo.
     5781   define input  parameter p-obj-code like ub.clients.obj-code no-undo.
     5782   define output parameter p-is-tpsi-obj as logical no-undo .
     5783   define output parameter p-tpsi-mode as integer no-undo .
     5784   define output parameter p-main-tpsi as logical no-undo .
     5785   define variable v-param-type as character no-undo .
     5786   define variable v-value-character as character no-undo .
     5787   define variable v-value-date as date no-undo .
     5788   define variable v-value-decimal as decimal no-undo .
     5789   define variable v-value-integer as INTEGER no-undo .
     5790   define variable v-value-logical AS LOGICAL no-undo .
     5791   define variable v-tth as handle no-undo .
     5792   assign
     5793   v-tth = buffer thbjattr_thbj-attr:table-handle .
     5794   run gbl/tpsi-obj.p (
     5795                   input p-obj-type
     5796                 , input p-obj-code
     5797                 , output p-is-tpsi-obj) no-error .
     5798   if p-is-tpsi-obj then do:
     5799     run adm/shattri.p (
     5800         input "get":U
     5801       ,input  p-obj-type
     5802       ,input  p-obj-code
     5803       ,input  'autosale':U
     5804       ,input  "":U
     5805       , output v-value-character
     5806       , output v-value-date
     5807       , output v-value-decimal
     5808       , output v-value-integer
     5809       , output v-value-logical
     5810       , output v-param-type
     5811       , INPUT-OUTPUT table-handle v-tth
     5812       ) no-error .
     5813     IF error-status:error then do:
     5814        message
     5815        substitute("Ошибка при получении опций продажи НА ОБЪЕКТЕ &1&2:&3&4 &5"
     5816                 , p-obj-type
     5817                 , p-obj-code
     5818                 , chr(10)
     5819                 , error-status:get-message(1)
     5820                 , return-value )
     5821        view-as alert-box error .
     5822        undo, return error .
     5823     end.
     5824     find first thbjattr_thbj-attr where
     5825               thbjattr_thbj-attr.obj-type = p-obj-type
     5826           and thbjattr_thbj-attr.obj-code = p-obj-code
     5827           and thbjattr_thbj-attr.upper-prop-code = 'autosale':U
     5828           and thbjattr_thbj-attr.prop-code = 'tpsi-mode':U no-error.
     5829     if available thbjattr_thbj-attr then do:
     5830       p-tpsi-mode = thbjattr_thbj-attr.property-value-integer.
     5831     end.
     5832     if p-tpsi-mode = 2 then do:
     5833       find first thbjattr_thbj-attr where
     5834                 thbjattr_thbj-attr.obj-type = p-obj-type
     5835             and thbjattr_thbj-attr.obj-code = p-obj-code
     5836             and thbjattr_thbj-attr.upper-prop-code = 'autosale':U
     5837             and thbjattr_thbj-attr.prop-code = 'main-tpsi':U no-error.
     5838       if available thbjattr_thbj-attr then do:
     5839         p-main-tpsi = thbjattr_thbj-attr.property-value-logical.
     5840       end.
     5841     end.
     5842   end.
     5843   END PROCEDURE.
     5844   if v-input-error = yes then do:
     5845     run write-log-and-file in p-log-handle (
     5846           input 1
     5847         , input log-file-name
     5848         , input 1
     5849         , input substitute("Ошибка входных параметров &1:&2&3&4"
     5850                            , p-parameter
     5851                            , chr(10)
     5852                            , v-esm
     5853                            , return-value
     5854                            )).
     5855     assign
     5856     v-view-log = yes.
     5857     if p-auto = 0 then do:
     5858   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5859   if v-view-log
     5860   and not g#news
     5861   and not g#auto
     5862   then do:
     5863     message
     5864     substitute('!!!В процессе закачки чеков в продажу произошли ошибки!!!')  skip
     5865     "!!!Внимательно прочитайте Log-file!!"
     5866     view-as alert-box error .
     5867        define variable v-user-action23   as character no-undo .
     5868     define variable v-printed23       as logical   no-undo .
     5869     run gbl/prnfilen.w
     5870       (input  (substitute('!!!В процессе закачки чеков в продажу произошли ошибки!!!'))
     5871       ,input  0
     5872       ,input  (string("./":U) + 'saleincl.log')
     5873       ,input  7
     5874       ,output v-user-action23
     5875       ,output v-printed23
     5876       ) .
     5877   end.
     5878   if v-view-log = true
     5879   and (g#news
     5880   or g#auto)
     5881   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     5882   then do:
     5883      run cb_set-view-log in p-parent-handle ( input yes).
     5884   end.
     5885   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     5886     OS-DELETE value(string("./":U) + 'saleincl.log').
     5887   end.
     5888                           return "error":U.                  end.
     5889   end.
     5890   assign
     5891   p-call-handle = this-procedure .
     5892   find first ink-doc exclusive-lock where
     5893               ink-doc.inkas-code = p-inkas-code no-error no-wait.
     5894   if NOT available ink-doc
     5895   and not locked ink-doc
     5896   then do:
     5897     return error substitute("Не найден отчет о продаже №&1", p-inkas-code).
     5898   end.
     5899   if locked ink-doc then do:
     5900     if p-auto < 2 then
     5901     return error substitute("Отчет о продаже №&1 занят", p-inkas-code).
     5902     else do:
     5903       return "":U.
     5904     end.
     5905   end.
     5906   FIND FIRST trn-doc WHERE trn-doc.doc-code = ink-doc.inkas-code exclusive.
     5907   assign
     5908   p-obj-type = ink-doc.obj-type
     5909   p-obj-code = ink-doc.obj-code
     5910   .
     5911   if (p-auto < 2
     5912   and not (ink-doc.status_ = 'новый':U
     5913             or
     5914             ink-doc.status_ = 'нередакт':U ))
     5915   then do:
     5916     return error substitute("Отчет о продаже №&1 имеет статус &2", ink-doc.inkas-code, ink-doc.status_).
     5917   end.
     5918   if p-auto >= 2
     5919   and ink-doc.status_ <> 'новый':U
     5920   and trn-doc.flag_ <> no
     5921   then do:
     5922     return "":U.
     5923   end.
     5924   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5925   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     5926     (input  'маг':U
     5927     ,input  ink-doc.obj-code
     5928     ,output v-db-num
     5929     )  .
     5930   if v-db-num <> g#db-num then do:
     5931     return error substitute("Отчет о продаже №&1 относится к магазину БД &2, текущая БД &3"
     5932                             , ink-doc.inkas-code
     5933                             , v-db-num
     5934                             , g#db-num
     5935                             ).
     5936   end.
     5937   find first buf_sysconf where
     5938             buf_sysconf.host-code = ink-doc.host-code no-lock.
     5939   if not available buf_sysconf then do:
     5940     return error substitute("Не найдена запись о фирме &1", ink-doc.host-code).
     5941   end.
     5942   run get-inkas-ps in this-procedure (
     5943                                       buffer ink-doc
     5944                                     , output chk-amount
     5945                                     , output gds-amount
     5946                                     , output line-out
     5947                                     , output dtl-out
     5948                                     , output line-ret
     5949                                     , output dtl-ret
     5950                                     , output nf-chk-amount
     5951                                     , output nf-gds-amount
     5952                                     , output v-dop-where-rus
     5953                                     ).
     5954     assign
     5955     ink-doc.PS = set-inkas-ps-simple (
     5956                             input chk-amount
     5957                           , input gds-amount
     5958                           , input line-out
     5959                           , input dtl-out
     5960                           , input line-ret
     5961                           , input dtl-ret
     5962                           , input nf-chk-amount
     5963                           , input nf-gds-amount
     5964                           )
     5965     .
     5966   assign
     5967   old-doc-date   =  ink-doc.doc-date
     5968   old-shift-date =  ink-doc.shift-date
     5969   old-shift-num  =  ink-doc.shift-num
     5970   new-doc-date   =  ink-doc.doc-date
     5971   new-shift-date =  ink-doc.shift-date
     5972   new-shift-num  =  ink-doc.shift-num
     5973   ink-doc.is-auto-get = (p-auto >= 2)
     5974   .
     5975   if p-filter-on
     5976   or (p-auto >= 2 and (ink-doc.sale-filter <> '':U
     5977                        and ink-doc.sale-filter <> ?)
     5978       )
     5979   then do:
     5980     assign
     5981     v-filter-name = ink-doc.sale-filter-name
     5982     v-where-phrase = ink-doc.sale-filter
     5983     p-filter-rus = ink-doc.sale-filter-rus
     5984     .
     5985   end.
     5986   if one-curs then do:
     5987     assign
     5988     cursh = trn-doc.exch-rate
     5989     cursh-scale = trn-doc.exch-scale
     5990     .
     5991   end.
     5992   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Обработка продажи &1............"                                                      , p-inkas-code)                                       ).
     5993   if cas-shft then do:
     5994   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Закачиваются чеки с датой продажи(учета) &1 по смене &2"                                                      , string(old-shift-date, "99/99/9999")                                                                         , old-shift-num)                                       ).
     5995   end.
     5996   else do:
     5997     if p-day-only then do:
     5998           run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Закачиваются чеки с датой продажи(учета) &1"                                                          , string(old-shift-date, "99/99/9999"))                                       ).
     5999     end.
     6000     else do:
     6001       if p-filter-on then do:
     6002               run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Закачиваются чеки с любой датой продажи(учета)"                                                            )                                       ).
     6003       end.
     6004       else do:
     6005               run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Закачиваются чеки с датой продажи(учета) <= &1"                                                            , string(old-shift-date, "99/99/9999"))                                       ).
     6006       end.
     6007     end.
     6008   end.
     6009   if p-filter-on then do:
     6010       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Закачиваются ТОЛЬКО чеки удовлятворяющие фильтру:&1&2"                                                        , chr(10)                                                                                                , p-filter-rus)                                       ).
     6011   end.
     6012   ASSIGN
     6013   v-query-prepare = substitute("for each X_chk-doc no-lock where ":U +
     6014                             "X_chk-doc.obj-type = '&1'":U +
     6015                             " AND X_chk-doc.obj-code = &2":U +
     6016                             " AND X_chk-doc.out-code = ? ", ink-doc.obj-type, ink-doc.obj-code).
     6017   if cas-shft then do:
     6018     ASSIGN
     6019     v-query-prepare = v-query-prepare +
     6020                     substitute(" AND X_chk-doc.shift-date = &1 AND X_chk-doc.shift-num = &2"
     6021                               , string(ink-doc.shift-date, "99/99/9999")
     6022                               , ink-doc.shift-num).
     6023   end.
     6024   else do:
     6025       if p-day-only then do:
     6026           ASSIGN
     6027           v-query-prepare = v-query-prepare +
     6028                           substitute(" AND X_chk-doc.shift-date = &1", string(ink-doc.shift-date, "99/99/9999")).
     6029                           .
     6030       end.
     6031       else do:
     6032           ASSIGN
     6033           v-query-prepare = v-query-prepare +
     6034                           substitute(" AND X_chk-doc.shift-date <= &1", string(ink-doc.shift-date, "99/99/9999")).
     6035       end.
     6036   end.
     6037   assign
     6038   glog =
     6039   QUERY query-chk-doc:QUERY-PREPARE(v-query-prepare + v-where-phrase) No-error.
     6040   IF not glog THEN DO:
     6041   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Ошибка - неверно выбран или построен ФИЛЬТР:&1&2&1 &3"                            , chr(10)                                                                    , (v-query-prepare + v-where-phrase)                                               , error-status:get-message(1))                                       ).
     6042     UNDO, RETURN ERROR.
     6043   END.
     6044   assign
     6045   glog = QUERY query-chk-doc:query-OPEN() NO-ERROR.
     6046   IF not glog THEN DO:
     6047   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Ошибка - неверно выбран или построен ФИЛЬТР:&1&2&1 &3"                             , chr(10)                                                                     , (v-query-prepare + v-where-phrase)                                                , error-status:get-message(1))                                       ).
     6048     UNDO, RETURN ERROR.
     6049   END.
     6050   ASSIGN
     6051   glog = QUERY query-chk-doc:GET-FIRST(no-lock) NO-ERROR.
     6052   IF not glog THEN DO:
     6053   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Нет чеков, удовлетворяющих условиям закачки в продажу &1"                            , p-inkas-code)                                       ).
     6054     assign
     6055     v-no-check = yes
     6056     .
     6057   END.
     6058   ASSIGN
     6059   glog = QUERY query-chk-doc:GET-FIRST(exclusive-LOCK, no-wait) NO-ERROR.
     6060   do while locked (X_chk-doc ) and available X_chk-doc:
     6061       p-ii = p-ii + 1.
     6062       glog = QUERY query-chk-doc:GET-NEXT(exclusive-LOCK, no-wait) NO-ERROR.
     6063   end.
     6064   if not v-no-check then do:
     6065   if one-curs then do:
     6066     run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Закачиваются ТОЛЬКО чеки с курсом баз.вал. = &1"                                                        , string(trn-doc.exch-rate / trn-doc.exch-scale, ">>,>>9.9999"))                                       ).
     6067   end.
     6068   end.
     6069   end.
     6070   if not v-no-check then do:
     6071     run proc-main in this-procedure ( input trn-doc.status_) no-error .
     6072     if error-status:error then do:
     6073       run write-log-and-file in p-log-handle (
     6074             input 1
     6075           , input log-file-name
     6076           , input 1
     6077           , input substitute("Ошибка при закачке чеков в продажу &1 &2&3:&4&5 &6"
     6078                             , p-inkas-code
     6079                             , (if p-obj-type <> "":U then p-obj-type else "":U)
     6080                             , (if p-obj-code <> 0 then string(p-obj-code) else "":U)
     6081                             , chr(10)
     6082                             , error-status:get-message(1)
     6083                             , return-value
     6084                             )).
     6085       assign
     6086       v-view-log = yes.
     6087       if p-auto = 0 then do:
     6088   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6089   if v-view-log
     6090   and not g#news
     6091   and not g#auto
     6092   then do:
     6093     message
     6094     substitute('!!!В процессе закачки чеков в продажу произошли ошибки!!!')  skip
     6095     "!!!Внимательно прочитайте Log-file!!"
     6096     view-as alert-box error .
     6097        define variable v-user-action26   as character no-undo .
     6098     define variable v-printed26       as logical   no-undo .
     6099     run gbl/prnfilen.w
     6100       (input  (substitute('!!!В процессе закачки чеков в продажу произошли ошибки!!!'))
     6101       ,input  0
     6102       ,input  (string("./":U) + 'saleincl.log')
     6103       ,input  7
     6104       ,output v-user-action26
     6105       ,output v-printed26
     6106       ) .
     6107   end.
     6108   if v-view-log = true
     6109   and (g#news
     6110   or g#auto)
     6111   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     6112   then do:
     6113      run cb_set-view-log in p-parent-handle ( input yes).
     6114   end.
     6115   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     6116     OS-DELETE value(string("./":U) + 'saleincl.log').
     6117   end.
     6118                           return "error":U.                  end.
     6119     end.
     6120     else do:
     6121       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Просмотрено &1 чеков, успешно закачано в продажу &2", p-ii, p-ii-ok)                                       ).
     6122     end.
     6123   end.
     6124   if p-auto = 3 then do:
     6125     run str/salestat.p (
     6126                        input parparentproc
     6127                       ,input p-inkas-code
     6128                       ,input '<закрытие документа>':U
     6129                       ,input 'новый':U
     6130                       ,input yes
     6131                       ,input yes ) no-error .
     6132     if not error-status:error then do:
     6133   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Продажа &1 помечена как готовая к резервированию", p-inkas-code)                                       ).
     6134     end.
     6135     else do:
     6136       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("!!!Ошибка при переводе статуса продажи:&1&2 &3"                  , chr(10)                                                               , error-status:get-message(1)                                                 , return-value )                                       ).
     6137     end.
     6138   end.
     6139   procedure display-chk :
     6140   DEFINE INPUT PARAMETER p-chk-amount AS INTEGER NO-UNDO.
     6141   define input parameter p-nf-chk-amount as integer no-undo .
     6142     do
     6143     on error undo, return error
     6144     :
     6145   run write-counter in p-log-handle (input substitute("Чеков &1 (&7) Строк &2 Расход: товаров &3 признаков &4 Возврат: товаров &5 признаков &6"                                    , p-chk-amount                                                                                                               , gds-amount                                                                                                                , line-out                                                                                                                  , dtl-out                                                                                                                   , line-ret                                                                                                                  , dtl-ret                                                                                                                   , p-nf-chk-amount)).
     6146     end.
     6147   end procedure.
     6148   PROCEDURE display-ink-doc :
     6149   define input parameter p-gds-amount  as integer no-undo .
     6150   define input parameter p-nf-gds-amount  as integer no-undo .
     6151   define input parameter p-line-out    as integer no-undo .
     6152   define input parameter p-line-ret    as integer no-undo .
     6153   define input parameter p-dtl-out     as integer no-undo .
     6154   define input parameter p-dtl-ret     as integer no-undo .
     6155   run write-counter in p-log-handle (input substitute("Чеков &1 Строк &2 (&7) Расход: товаров &3 признаков &4 Возврат: товаров &5 признаков &6"                                    , chk-amount                                                                                                                  , p-gds-amount                                                                                                                , p-line-out                                                                                                                  , p-dtl-out                                                                                                                   , p-line-ret                                                                                                                  , p-dtl-ret                                                                                                                   , p-nf-gds-amount)).
     6156   END PROCEDURE.
