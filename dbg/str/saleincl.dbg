     2611   procedure placelib_write-attr:
     2612   define input  parameter p-code     like ub.place-attr.attr-code .
     2613   define input  parameter p-obj-code like ub.place-attr.obj-code .
     2614   define input  parameter p-obj-type like ub.place-attr.obj-type .
     2615   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     2616   define input  parameter p-value    like ub.place-attr.attr-value .
     2617   define output parameter p-ok       as logical.
     2618   define buffer buf_place-attr for ub.place-attr .
     2619     do on error undo, return error return-value :
     2620        p-ok = false.
     2621        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     2622                                                   and buf_place-attr.obj-code    = p-obj-code
     2623                                                   and buf_place-attr.obj-type    = p-obj-type
     2624                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2625        if not available buf_place-attr then do :
     2626           create buf_place-attr.
     2627           assign
     2628             buf_place-attr.attr-code   = p-code
     2629             buf_place-attr.attr-value  = p-value
     2630             buf_place-attr.obj-code    = p-obj-code
     2631             buf_place-attr.obj-type    = p-obj-type
     2632             buf_place-attr.pl-code     = p-pl-code
     2633           .
     2634           p-ok = true.
     2635        end.
     2636        else do:
     2637           buf_place-attr.attr-value  = p-value .
     2638           p-ok = true.
     2639        end.
     2640     end.
     2641   end.
     2642   procedure placelib_get-attr:
     2643   define input  parameter  p-code     like ub.place-attr.attr-code .
     2644   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     2645   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     2646   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     2647   define output parameter  p-value    like ub.place-attr.attr-value .
     2648   define output parameter  p-ok       as logical.
     2649   define buffer buf_place-attr for ub.place-attr .
     2650     do on error undo, return error return-value :
     2651        p-ok = false.
     2652        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     2653                                                   and buf_place-attr.obj-code    = p-obj-code
     2654                                                   and buf_place-attr.obj-type    = p-obj-type
     2655                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2656        if available buf_place-attr then do :
     2657          p-value = buf_place-attr.attr-value.
     2658          p-ok = true.
     2659        end.
     2660        else do :
     2661          p-ok = false.
     2662        end.
     2663     end.
     2664   end.
     2665   procedure placelib_del-attr:
     2666   define input parameter  p-code     like ub.place-attr.attr-code .
     2667   define input parameter  p-obj-code like ub.place-attr.obj-code .
     2668   define input parameter  p-obj-type like ub.place-attr.obj-type .
     2669   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     2670   define input parameter  p-value    like ub.place-attr.attr-value .
     2671   define output parameter p-ok       as logical.
     2672   define buffer buf_place-attr for ub.place-attr .
     2673     do on error undo, return error return-value :
     2674        p-ok = false.
     2675        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     2676                                                   and buf_place-attr.obj-code    = p-obj-code
     2677                                                   and buf_place-attr.obj-type    = p-obj-type
     2678                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2679        if available buf_place-attr then do :
     2680           delete buf_place-attr.
     2681           p-ok = true.
     2682        end.
     2683     end.
     2684   end.
