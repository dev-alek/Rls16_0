     2716   define variable v-view-log as logical no-undo .
     2717   define variable v-esm as character no-undo .
     2718   define variable v-input-error as logical no-undo .
     2719   define variable v-db-num  like ub.db.db-num no-undo .
     2720   define variable v-filter-name as character no-undo .
     2721   define variable v-where-phrase as character no-undo .
     2722   define variable v-query-prepare as character no-undo .
     2723   define variable glog            as logical no-undo .
     2724   define variable v-filter-exist as logical no-undo .
     2725   do
     2726   on error undo, return error
     2727   :
     2728   if num-entries(p-parameter, chr(4)) <> 15
     2729   then do:
     2730     assign
     2731     v-input-error = yes
     2732     v-esm         = substitute("Неверное количество ENTRY в составном параметре - &1, должно быть 15"
     2733                                ,num-entries(p-parameter, chr(4))).
     2734     .
     2735   end.
     2736   else do:
     2737     assign
     2738     p-auto              = integer(entry(1, p-parameter, chr(4)))
     2739     p-inkas-code        = entry(2, p-parameter, chr(4))
     2740     p-filter-on         = logical(entry(3, p-parameter, chr(4)))
     2741     v-curr-r-b          = entry(4, p-parameter, chr(4))
     2742     is-wth              = logical(entry(5, p-parameter, chr(4)))
     2743     cas-shft            = logical(entry(6, p-parameter, chr(4)))
     2744     one-curs            = logical(entry(7, p-parameter, chr(4)))
     2745     cas-curs            = logical(entry(8, p-parameter, chr(4)))
     2746     prcl-spl            = logical(entry(9, p-parameter, chr(4)))
     2747     pay-gds-algo        = entry(10, p-parameter, chr(4))
     2748     rdtaxcd             = integer(entry(12, p-parameter, chr(4)))
     2749     exctaxcd            = integer(entry(12, p-parameter, chr(4)))
     2750     factorrt            = decimal(entry(13, p-parameter, chr(4)))
     2751     btltaxcd            = integer(entry(14, p-parameter, chr(4)))
     2752     p-day-only          = logical(entry(15, p-parameter, chr(4)))
     2753     no-error
     2754     .
     2755     if error-status:error then do:
     2756       assign
     2757       v-esm = error-status:get-message(1)
     2758       v-input-error = yes
     2759       .
     2760     end.
     2761   end.
     2762   if p-auto = 0 then do:
     2763     log-file-name = 'saleincl.log' .
     2764   end.
     2765   else do:
     2766     log-file-name = 'ext-sale.log'.
     2767   end.
     2768   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile: inc-salr.i $ $Revision: 5b89e89c1f45, 2641, rls $".
     2769   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2770   FUNCTION get-inc-sal returns integer(input p-chk-type as character
     2771                                      , input p-netto as decimal
     2772                                      , input p-chk-doc as logical
     2773                                      , input p-office as character
     2774                                      , input p-write-off-code  as character
     2775                                      , output p-add as logical
     2776                                      , output p-office-to-reserv as character
     2777                                      , output p-kind-to-reserv as character
     2778                                      , output p-add-nf-amount as integer
     2779                                      ):
     2780   define variable v-docs-to-reserv as integer no-undo.
     2781   if lookup(p-chk-type , '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0
     2782   then do:
     2783       assign
     2784       v-docS-to-reserv = 0
     2785       p-kind-to-reserv = '':U
     2786       p-add-nf-amount = 1
     2787       .
     2788       return v-docs-to-reserv.
     2789   end.
     2790   p-add = no.
     2791   if p-chk-doc then do:
     2792     if p-chk-type = ? then do:
     2793       if p-netto >= 0 then do:
     2794         assign
     2795         p-chk-type = '1':U.
     2796       end.
     2797       if p-netto < 0 then do:
     2798         assign
     2799         p-chk-type = '6':U.
     2800       end.
     2801     end.
     2802     CASE p-chk-type:
     2803       when '1':U then do:
     2804         assign
     2805         p-kind-to-reserv = 'es':U
     2806         v-docs-to-reserv = 1
     2807         .
     2808       end.
     2809       when '6':U then do:
     2810         assign
     2811         p-kind-to-reserv = 'rs':U
     2812         v-docs-to-reserv = 1
     2813         .
     2814       end.
     2815       when '17':U then do:
     2816         assign
     2817         p-kind-to-reserv = 'trf':U
     2818         v-docs-to-reserv = 1
     2819         .
     2820       end.
     2821       when '96':U then do:
     2822         assign
     2823         p-kind-to-reserv = 'rs':U + chr(44) + 'rwo':U
     2824         v-docs-to-reserv = 2
     2825         .
     2826       end.
     2827       when '69':U then do:
     2828         assign
     2829         p-kind-to-reserv = 'swo':U
     2830         v-docs-to-reserv = 1
     2831         .
     2832       end.
     2833       otherwise do:
     2834         assign
     2835         p-kind-to-reserv = '':U
     2836         v-docs-to-reserv = 0
     2837         .
     2838       End.
     2839     END CASE.
     2840     ASSIGN
     2841     p-add-nf-amount = 0.
     2842     if p-office = 'т':U
     2843     or p-office = 'у':U then do:
     2844       p-office-to-reserv = (if v-docs-to-reserv = 0
     2845                             then '':U
     2846                             else trim(fill((p-office + chr(44)), v-docs-to-reserv), chr(44))).
     2847     end.
     2848     else do:
     2849       assign
     2850       p-office-to-reserv  = (if v-docs-to-reserv = 0
     2851                              then '':U
     2852                              else (trim(fill(entry(1, p-office) + chr(44), v-docs-to-reserv), chr(44)) +
     2853                                   chr(44) +
     2854                                    trim(fill(entry(2, p-office) + chr(44), v-docs-to-reserv), chr(44))))
     2855       v-docs-to-reserv = v-docs-to-reserv * 2
     2856       p-kind-to-reserv = (if p-kind-to-reserv = '':U
     2857                           then  '':U
     2858                           else (p-kind-to-reserv + chr(44) + p-kind-to-reserv)) .
     2859     end.
     2860     return v-docs-to-reserv.
     2861   end.
     2862   else do:
     2863     ASSIGN
     2864     P-kind-to-reserv = '':U
     2865     p-add-nf-amount = 0
     2866     p-add = yes
     2867     p-office-to-reserv = '':U
     2868     .
     2869     if p-write-off-code = '0':U
     2870     or p-write-off-code = ? then do:
     2871       return 0.
     2872     end.
     2873     CASE p-chk-type:
     2874       when '1':U
     2875       then do:
     2876          if p-write-off-code = '1':U
     2877          or p-write-off-code = '3':U
     2878          then do:
     2879             assign
     2880             p-kind-to-reserv = 'swo':U
     2881             v-docs-to-reserv = 1
     2882             p-add = no
     2883             p-office-to-reserv = p-office
     2884             .
     2885          end.
     2886       end.
     2887       when '6':U then do:
     2888          if p-write-off-code = '-6':U
     2889          or p-write-off-code = '-3':U
     2890          then do:
     2891             assign
     2892             p-kind-to-reserv = 'rwo':U
     2893             v-docs-to-reserv = 1
     2894             p-add = no
     2895             p-office-to-reserv = p-office
     2896             .
     2897          end.
     2898       end.
     2899     END CASE.
     2900     return v-docs-to-reserv.
     2901   end.
     2902   END FUNCTION.
     2903   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2904     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     2905       define variable v-answ as logical no-undo .
     2906       if ( p-unit-base-cli-eq = true
     2907            and p-density = 1.0
     2908          )
     2909         or ( p-unit-base-cli-eq = false
     2910              and p-density <> ?
     2911              and p-density > 0.0
     2912              and p-density < 1.0
     2913            )
     2914       then do:
     2915         assign
     2916           v-answ = true
     2917         .
     2918       end.
     2919       else do:
     2920         assign
     2921           v-answ = false
     2922         .
     2923       end.
     2924       return v-answ.
     2925     end function.
