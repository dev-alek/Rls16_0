     2968   function ChkGdsPromo returns logical
     2969       (input iDocCode as character)
     2970       :
     2971       define buffer buf_chk-gds for ub.chk-gds.
     2972       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2973       define variable vPromo as logical no-undo.
     2974       vPromo = no.
     2975       cspr:
     2976       for each buf_chk-gds no-lock where
     2977                    buf_chk-gds.doc-code = iDocCode,
     2978              first buf_chk-gds-attr no-lock where
     2979                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     2980                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2981                and buf_chk-gds-attr.attr-code = "CSPromo"
     2982                and buf_chk-gds-attr.attr-value <> "0":
     2983          vPromo = yes.
     2984          leave cspr.
     2985       end.
     2986       return vPromo.
     2987   end.
     2988   function ChkPromoLine returns logical
     2989       (input iDocCode as character,
     2990       input iLineNum as integer)
     2991       :
     2992       define buffer buf_chk-gds for ub.chk-gds.
     2993       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2994       define variable vPromo as logical no-undo.
     2995       vPromo = no.
     2996       find first buf_chk-gds-attr no-lock where
     2997                    buf_chk-gds-attr.doc-code = iDocCode
     2998                and buf_chk-gds-attr.line-num  = iLineNum
     2999                and buf_chk-gds-attr.attr-code = "CSPromo"
     3000                and buf_chk-gds-attr.attr-value <> "0"
     3001       no-error.
     3002       if avail buf_chk-gds-attr then vPromo = yes.
     3003       return vPromo.
     3004   end.
     3005   function ChkPromoSum returns decimal
     3006       (input iDocCode as character,
     3007        input iLineNum as integer)
     3008       :
     3009      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3010      define variable vSumPromo as decimal no-undo.
     3011      find first buf_chk-gds-attr no-lock where
     3012                 buf_chk-gds-attr.doc-code = iDocCode
     3013             and buf_chk-gds-attr.line-num  = iLineNum
     3014             and buf_chk-gds-attr.attr-code = "CSPromoSum"
     3015         no-error.
     3016      if avail buf_chk-gds-attr then
     3017         vSumPromo = DEC(buf_chk-gds-attr.attr-value) no-error.
     3018      return vSumPromo.
     3019   end function.
     3020   function ChkPromoPrice returns logical
     3021       (input iDocCode as character,
     3022        input iLineNum as integer)
     3023       :
     3024      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3025      define variable v-is-promo as logical no-undo.
     3026      v-is-promo = no.
     3027      find first buf_chk-gds-attr no-lock where
     3028                 buf_chk-gds-attr.doc-code = iDocCode
     3029             and buf_chk-gds-attr.line-num  = iLineNum
     3030             and buf_chk-gds-attr.attr-code = "CSPromo"
     3031         no-error.
     3032      if avail buf_chk-gds-attr
     3033        and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     3034      then v-is-promo = yes.
     3035      return v-is-promo.
     3036   end function.
     3037   function ChkDopLitr returns logical
     3038       (input iDocCode as character,
     3039        input iLineNum as integer)
     3040       :
     3041      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3042      define variable v-is-promo as logical no-undo.
     3043      v-is-promo = no.
     3044      find first buf_chk-gds-attr no-lock where
     3045                 buf_chk-gds-attr.doc-code = iDocCode
     3046             and buf_chk-gds-attr.line-num  = iLineNum
     3047             and buf_chk-gds-attr.attr-code = "CSPromo"
     3048         no-error.
     3049      if avail buf_chk-gds-attr and
     3050        buf_chk-gds-attr.attr-value = "3"
     3051      then v-is-promo = yes.
     3052      return v-is-promo.
     3053   end function.
     3054   function RoundUp return decimal
     3055       (input iQnty as decimal,
     3056        input iPrice as decimal):
     3057       def var vSum  as decimal no-undo.
     3058       def var vSumR as decimal no-undo.
     3059       vSum = ABSOLUTE(iQnty) * iPrice.
     3060       vSumR = Round(vSum,2).
     3061       if vSumR < vSum then vSumR = vSumR + 0.01.
     3062       if iQnty < 0 then vSumR = - vSumR.
     3063       return vSumR.
     3064   end function.
     3065   function GetPromoSum returns decimal
     3066       (input iDocCode as character)
     3067       :
     3068       define buffer buf_chk-doc for ub.chk-doc.
     3069       define buffer buf2_chk-doc for ub.chk-doc.
     3070       define buffer buf_chk-gds for ub.chk-gds.
     3071       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3072       define buffer buf2_chk-gds for ub.chk-gds.
     3073       define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
     3074       define variable v-price-base as decimal no-undo.
     3075       define variable v-doc-qnty as decimal no-undo.
     3076       define variable v-sum-base as decimal no-undo.
     3077       define variable v-sum-all as decimal no-undo.
     3078       define variable v-sum-promo as decimal no-undo.
     3079       define variable v-sum-chk as decimal no-undo.
     3080       assign
     3081          v-price-base = 0
     3082          v-doc-qnty = 0
     3083          v-sum-all = 0
     3084          v-sum-chk = 0
     3085          v-sum-promo = 0
     3086          .
     3087       for each buf_chk-gds no-lock where
     3088                buf_chk-gds.doc-code = iDocCode,
     3089          first buf_chk-gds-attr no-lock where
     3090                buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3091            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3092            and buf_chk-gds-attr.attr-code = "CSPromoSum"
     3093          :
     3094          v-sum-promo = Dec(buf_chk-gds-attr.attr-value).
     3095       end.
     3096       if v-sum-promo = 0 then do:
     3097           for each buf_chk-gds no-lock where
     3098                    buf_chk-gds.doc-code = iDocCode,
     3099              first buf_chk-gds-attr no-lock where
     3100                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3101                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3102                and buf_chk-gds-attr.attr-code = "CSPromo"
     3103                and can-do("1,6", buf_chk-gds-attr.attr-value)
     3104              :
     3105              assign
     3106                v-price-base = buf_chk-gds.price-base
     3107                v-doc-qnty   = if buf_chk-gds.doc-qnty = ? then buf_chk-gds.src-qnty else buf_chk-gds.doc-qnty
     3108                v-sum-base = if buf_chk-gds.sum-base = ? then round(v-doc-qnty * v-price-base, 2) else buf_chk-gds.sum-base
     3109                .
     3110           end.
     3111           for each buf_chk-gds no-lock where
     3112                    buf_chk-gds.doc-code = iDocCode,
     3113              first buf_chk-gds-attr no-lock where
     3114                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3115                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3116                and buf_chk-gds-attr.attr-code = "CSPromo"
     3117                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     3118              :
     3119              if v-price-base = 0 then do:
     3120                 find first buf_chk-doc no-lock where
     3121                            buf_chk-doc.doc-code = iDocCode
     3122                     no-error.
     3123                 if avail buf_chk-doc and
     3124                    buf_chk-doc.chk-type = int('6':U) and
     3125                    buf_chk-doc.doc-num2 > ""  and
     3126                    num-entries(buf_chk-doc.doc-num2,":") = 2
     3127                 then
     3128                 for first buf2_chk-doc no-lock where
     3129                           buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     3130                       and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     3131                       and buf2_chk-doc.chk-type = int('1':U)
     3132                       and buf2_chk-doc.chk-num = int(entry(1,buf_chk-doc.doc-num2,":"))
     3133                       and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     3134                       :
     3135                   for each buf2_chk-gds no-lock where
     3136                            buf2_chk-gds.doc-code = buf2_chk-doc.doc-code,
     3137                      first buf2_chk-gds-attr no-lock where
     3138                            buf2_chk-gds-attr.doc-code = buf2_chk-gds.doc-code
     3139                        and buf2_chk-gds-attr.line-num  = buf2_chk-gds.line-num
     3140                        and buf2_chk-gds-attr.attr-code = "CSPromo"
     3141                        and can-do("1,6", buf2_chk-gds-attr.attr-value)
     3142                      :
     3143                       v-price-base = buf2_chk-gds.price-base.
     3144                   end.
     3145                 end.
     3146              end.
     3147              if buf_chk-gds.sum-base = ? or buf_chk-gds.src-qnty = 0 then do:
     3148                  assign
     3149                     v-sum-all = (buf_chk-gds.src-qnty + v-doc-qnty) * v-price-base
     3150                     v-sum-chk = v-sum-base + RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
     3151                     .
     3152              end.
     3153              else do:
     3154                 assign
     3155                 v-sum-all = (buf_chk-gds.doc-qnty + v-doc-qnty ) * v-price-base
     3156                 v-sum-chk = v-sum-base + buf_chk-gds.sum-base
     3157                 .
     3158              end.
     3159           end.
     3160           v-sum-promo = Round(v-sum-all, 2) - Round(v-sum-chk, 2).
     3161       end.
     3162       return v-sum-promo.
     3163   end function.
     3164   function GetUnBaseSum returns decimal
     3165       (input iDocCode as character,
     3166        input iLineNum as integer,
     3167        input iQnty as decimal,
     3168        input iPrice as decimal):
     3169      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3170      define variable vBaseSum as decimal no-undo.
     3171      define variable vDiscSum as decimal no-undo.
     3172      vDiscSum = 0.
     3173      find first buf_chk-gds-attr no-lock where
     3174                        buf_chk-gds-attr.doc-code = iDocCode
     3175                    and buf_chk-gds-attr.line-num  = iLineNum
     3176                    and buf_chk-gds-attr.attr-code = "CSPromoSum"
     3177             no-error.
     3178      if avail buf_chk-gds-attr then
     3179         vDiscSum = dec(buf_chk-gds-attr.attr-value) no-error.
     3180      vBaseSum = iQnty * iPrice + vDiscSum.
     3181      if vDiscSum = 0 and ChkPromoPrice(iDocCode, iLineNum) then
     3182         vBaseSum = RoundUp(iQnty, iPrice).
     3183      return vBaseSum.
     3184   end function.
     3185   function GetRoundSum returns decimal
     3186       (input iDocCode as character,
     3187        input iLineNum as integer,
     3188        input iQnty as decimal,
     3189        input iPrice as decimal):
     3190      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3191      define variable vBaseSum as decimal no-undo.
     3192      if ChkPromoPrice(iDocCode, iLineNum) then
     3193         vBaseSum = RoundUp(iQnty, iPrice).
     3194      else vBaseSum = iQnty * iPrice.
     3195      return vBaseSum.
     3196   end function.
     3197   function GetRoundSumChkDel returns decimal
     3198       (input iDocCode as character,
     3199        input iLineNum as integer,
     3200        input iChipNum as integer,
     3201        input iQnty as decimal,
     3202        input iPrice as decimal):
     3203      define buffer  buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     3204      define variable vBaseSum as decimal no-undo.
     3205      define variable vIsPromo as logical no-undo.
     3206      for each buf_c-chk-doc-attr no-lock where
     3207               buf_c-chk-doc-attr.doc-code = iDocCode
     3208           and buf_c-chk-doc-attr.chip-num = iChipNum
     3209          :
     3210          if num-entries(buf_c-chk-doc-attr.attr-code, chr(4)) > 1
     3211          then do :
     3212            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "gds="
     3213            and entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) = "CSPromo"
     3214            and entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=") = String(iLineNum)
     3215            and can-do("2,4,5,7", buf_c-chk-doc-attr.attr-value)
     3216            then vIsPromo = yes.
     3217          end.
     3218      end.
     3219      if ChkPromoPrice(iDocCode, iLineNum) then
     3220         vBaseSum = RoundUp(iQnty, iPrice).
     3221      else vBaseSum = iQnty * iPrice.
     3222      return vBaseSum.
     3223   end function.
     3224   function GetSaleRetDisc returns decimal
     3225       (input iDocCode as character,
     3226        input iSaleCode as character):
     3227      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3228      define buffer buf_chk-gds for ub.chk-gds.
     3229      define variable vQntyPromoRet as decimal no-undo.
     3230      define variable vQntyPromoSel as decimal no-undo.
     3231      define variable vDiscSumRet   as decimal no-undo.
     3232      define variable vDiscSumSale  as decimal no-undo.
     3233      vDiscSumRet = 0.
     3234      cspr:
     3235      for each  buf_chk-gds no-lock where
     3236                buf_chk-gds.doc-code = iDocCode,
     3237          first buf_chk-gds-attr no-lock where
     3238                buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     3239            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3240            and buf_chk-gds-attr.attr-code = "CSPromo"
     3241            and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     3242          :
     3243          vQntyPromoRet = buf_chk-gds.src-qnty.
     3244          leave cspr.
     3245      end.
     3246      if vQntyPromoRet <> 0 then
     3247      for each  buf_chk-gds no-lock where
     3248                buf_chk-gds.doc-code = iSaleCode:
     3249          find first buf_chk-gds-attr no-lock where
     3250                     buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     3251                 and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3252                 and buf_chk-gds-attr.attr-code = "CSPromo"
     3253          no-error.
     3254          if avail buf_chk-gds-attr
     3255               and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     3256          then
     3257            vQntyPromoSel = buf_chk-gds.src-qnty.
     3258          find first buf_chk-gds-attr no-lock where
     3259                    buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     3260                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3261                and buf_chk-gds-attr.attr-code = "CSPromoSum"
     3262          no-error.
     3263          if avail buf_chk-gds-attr then
     3264             vDiscSumSale = dec(buf_chk-gds-attr.attr-value) no-error.
     3265      end.
     3266      if vQntyPromoRet <> 0 and
     3267         vQntyPromoSel = -1 * vQntyPromoRet
     3268      then vDiscSumRet = -1 * vDiscSumSale.
     3269      return vDiscSumRet.
     3270   end function.
     3271   function SetPromoDisc return logical
     3272    (input iDocCode as character,
     3273        input iLineNum as integer
     3274        )
     3275       :
     3276      define buffer buf_chk-doc for ub.chk-doc.
     3277      define buffer buf2_chk-doc for ub.chk-doc.
     3278      define buffer buf_chk-gds for ub.chk-gds.
     3279      define buffer buf2_chk-gds for ub.chk-gds.
     3280      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3281      define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
     3282      define buffer buf_chk-discnt for ub.chk-discnt.
     3283      define buffer buf2_chk-discnt for ub.chk-discnt.
     3284      define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
     3285      define buffer buf2_chk-discnt-attr for ub.chk-discnt-attr.
     3286      define variable v-promo-sum as decimal no-undo.
     3287      define variable v-disc-promo-id as character no-undo.
     3288      define variable var-discnt-id as integer no-undo.
     3289      define variable v-chk-sale as character no-undo.
     3290      find first buf_chk-gds-attr no-lock where
     3291                 buf_chk-gds-attr.doc-code = iDocCode
     3292             and buf_chk-gds-attr.line-num  = iLineNum
     3293             and buf_chk-gds-attr.attr-code = "CSPromo"
     3294         no-error.
     3295      if avail buf_chk-gds-attr
     3296        then do:
     3297        find first buf_chk-discnt no-lock where
     3298                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     3299               and buf_chk-discnt.line-num = buf_chk-gds-attr.line-num
     3300               and buf_chk-discnt.record-type = 0
     3301               and buf_chk-discnt.promo-id > ""
     3302               no-error.
     3303        if not avail buf_chk-discnt then do:
     3304           find first buf_chk-doc no-lock where
     3305                      buf_chk-doc.doc-code = iDocCode
     3306              no-error.
     3307           find first buf_chk-gds no-lock where
     3308                      buf_chk-gds.doc-code = iDocCode
     3309                 and  buf_chk-gds.line-num = iLineNum
     3310              no-error.
     3311          for first buf2_chk-doc no-lock where
     3312                    buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     3313                and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     3314                and buf2_chk-doc.pay-desk = buf_chk-doc.pay-desk
     3315                and buf2_chk-doc.chk-type = int('1':U)
     3316                and buf2_chk-doc.chk-num  = int(entry(1,buf_chk-doc.doc-num2,":"))
     3317                and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     3318              :
     3319              find first buf2_chk-gds no-lock where
     3320                         buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
     3321                    and  buf2_chk-gds.b-code   = buf_chk-gds.b-code
     3322              no-error.
     3323              if not avail buf2_chk-gds then return no.
     3324              v-chk-sale = buf2_chk-doc.doc-code.
     3325              find first buf_chk-discnt no-lock where
     3326                         buf_chk-discnt.doc-code =  buf2_chk-doc.doc-code and
     3327                         buf_chk-discnt.record-type = 1 and
     3328                         buf_chk-discnt.object-line-num = buf2_chk-gds.line-num and
     3329                         buf_chk-discnt.promo-id > ""
     3330              no-error .
     3331              if avail buf_chk-discnt
     3332              then do:
     3333                 v-disc-promo-id = buf_chk-discnt.promo-id.
     3334                 find first buf2_chk-discnt no-lock where
     3335                   buf2_chk-discnt.doc-code = iDocCode and
     3336                   buf2_chk-discnt.record-type = 5 and
     3337                   buf2_chk-discnt.line-num = 0 and
     3338                   buf2_chk-discnt.promo-id =  v-disc-promo-id
     3339                 no-error.
     3340                 find first buf2_chk-discnt-attr no-lock where
     3341                            buf2_chk-discnt-attr.doc-code = iDocCode and
     3342                            buf2_chk-discnt-attr.record-type = 5 and
     3343                            buf2_chk-discnt-attr.line-num = 0 and
     3344                            buf2_chk-discnt-attr.attr-code = "promo-id" and
     3345                            buf2_chk-discnt-attr.attr-value = v-disc-promo-id
     3346                       no-error .
     3347                 if not avail buf2_chk-discnt
     3348                 then do:
     3349                     for each buf_chk-discnt no-lock where
     3350                              buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     3351                          and buf_chk-discnt.record-type = 5:
     3352                          var-discnt-id  = var-discnt-id + 1.
     3353                     end.
     3354                     create buf2_chk-discnt.
     3355                     assign
     3356                       buf2_chk-discnt.doc-code = iDocCode
     3357                       buf2_chk-discnt.record-type = 5
     3358                       buf2_chk-discnt.line-num = 0
     3359                       buf2_chk-discnt.promo-id = v-disc-promo-id
     3360                       buf2_chk-discnt.object-sum = 0
     3361                       buf2_chk-discnt.discnt-id = if avail buf2_chk-discnt-attr
     3362                                                      then buf2_chk-discnt-attr.discnt-id
     3363                                                      else (var-discnt-id + 1)
     3364                       var-discnt-id = 0
     3365                       buf2_chk-discnt.object-line-num = 0
     3366                       buf2_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     3367                       buf2_chk-discnt.obj-code = buf_chk-doc.obj-code
     3368                       buf2_chk-discnt.obj-type = buf_chk-doc.obj-type
     3369                       buf2_chk-discnt.chk-date = buf_chk-doc.chk-date
     3370                       buf2_chk-discnt.shift-date = buf_chk-doc.shift-date
     3371                       buf2_chk-discnt.shift-num = buf_chk-doc.shift-num
     3372                       buf2_chk-discnt.chk-time = buf_chk-doc.chk-time
     3373                       .
     3374                 end.
     3375                 if avail buf2_chk-discnt and
     3376                    not avail buf2_chk-discnt-attr
     3377                 then do:
     3378                    create buf2_chk-discnt-attr.
     3379                    assign
     3380                       buf2_chk-discnt-attr.doc-code = iDocCode
     3381                       buf2_chk-discnt-attr.discnt-id = buf2_chk-discnt.discnt-id
     3382                       buf2_chk-discnt-attr.record-type     = 5
     3383                       buf2_chk-discnt-attr.line-num        = 0
     3384                       buf2_chk-discnt-attr.object-line-num = 0
     3385                       buf2_chk-discnt-attr.attr-code       = "promo-id"
     3386                       buf2_chk-discnt-attr.attr-value      = v-disc-promo-id
     3387                       .
     3388                 end.
     3389              end.
     3390          end.
     3391           v-promo-sum = 0.
     3392           if can-do("1,6,7", buf_chk-gds-attr.attr-value)
     3393           then do:
     3394              if v-chk-sale <> ? and v-chk-sale <> "" then
     3395                 v-promo-sum = GetSaleRetDisc(iDocCode,v-chk-sale).
     3396              v-promo-sum = if v-promo-sum = 0 then GetPromoSum(iDocCode) else v-promo-sum.
     3397              if v-promo-sum <> 0 then do:
     3398                  find first buf2_chk-gds-attr no-lock where
     3399                             buf2_chk-gds-attr.doc-code = iDocCode
     3400                         and buf2_chk-gds-attr.line-num  = iLineNum
     3401                         and buf2_chk-gds-attr.attr-code = "CSPromoSum"
     3402                     no-error.
     3403                  if not avail buf2_chk-gds-attr then do:
     3404                      create buf2_chk-gds-attr.
     3405                      assign
     3406                         buf2_chk-gds-attr.doc-code = iDocCode
     3407                         buf2_chk-gds-attr.line-num  = iLineNum
     3408                         buf2_chk-gds-attr.attr-code = "CSPromoSum"
     3409                         buf2_chk-gds-attr.attr-value = string(Round(v-promo-sum,2))
     3410                         .
     3411                  end.
     3412              end.
     3413           end.
     3414           for each buf_chk-discnt no-lock where
     3415                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     3416               and buf_chk-discnt.record-type = 0:
     3417              var-discnt-id  = var-discnt-id + 1.
     3418           end.
     3419           create buf_chk-discnt.
     3420           assign
     3421               buf_chk-discnt.doc-code = iDocCode
     3422               buf_chk-discnt.line-num = iLineNum
     3423               buf_chk-discnt.record-type = 0
     3424               buf_chk-discnt.discnt-id = (var-discnt-id + 1)
     3425               buf_chk-discnt.time-oper = buf_chk-gds.time-oper
     3426               buf_chk-discnt.line-type = integer('1':U)
     3427               buf_chk-discnt.line-sign = no
     3428               buf_chk-discnt.pass-discnt = integer('0':U)
     3429               buf_chk-discnt.value-type = integer('2':U)
     3430               buf_chk-discnt.src-d-card = buf_chk-gds.src-d-card
     3431               buf_chk-discnt.d-card = buf_chk-gds.d-card
     3432               buf_chk-discnt.discnt-value-abs = 0
     3433               buf_chk-discnt.discnt-value-pcnt = 0
     3434               buf_chk-discnt.object-line-num = iLineNum
     3435               buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     3436               buf_chk-discnt.obj-code = buf_chk-doc.obj-code
     3437               buf_chk-discnt.obj-type = buf_chk-doc.obj-type
     3438               buf_chk-discnt.chk-date = buf_chk-doc.chk-date
     3439               buf_chk-discnt.chk-time = buf_chk-doc.chk-time
     3440               buf_chk-discnt.shift-date = buf_chk-doc.shift-date
     3441               buf_chk-discnt.shift-num = buf_chk-doc.shift-num
     3442               buf_chk-discnt.object-qnty = buf_chk-gds.src-qnty
     3443               buf_chk-discnt.object-sum = buf_chk-gds.src-sum
     3444               var-discnt-id = var-discnt-id + 1
     3445               buf_chk-discnt.promo-id = v-disc-promo-id
     3446               buf_chk-discnt.discnt-type = integer('7':U)
     3447               .
     3448           find first buf_chk-discnt-attr no-lock where
     3449                      buf_chk-discnt-attr.attr-code = "promo-id"
     3450                  and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     3451                  and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     3452                  and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     3453                  no-error.
     3454           if not avail buf_chk-discnt-attr then
     3455           do:
     3456               create buf_chk-discnt-attr .
     3457               assign
     3458                   buf_chk-discnt-attr.attr-code = "promo-id"
     3459                   buf_chk-discnt-attr.attr-value = buf_chk-discnt.promo-id
     3460                   buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     3461                   buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     3462                   buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     3463                   buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     3464                   buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
     3465                   .
     3466            end.
     3467        end.
     3468      end.
     3469      return yes.
     3470   end function.
     3471   function GetPromoPriceSum returns decimal
     3472       (input iDocCode as character)
     3473       :
     3474       define buffer buf_chk-gds for ub.chk-gds.
     3475       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3476       define variable vPromoSum as decimal no-undo.
     3477       vPromoSum = 0.
     3478       cspr:
     3479       for each buf_chk-gds no-lock where
     3480                    buf_chk-gds.doc-code = iDocCode,
     3481              first buf_chk-gds-attr no-lock where
     3482                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3483                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3484                and buf_chk-gds-attr.attr-code = "CSPromo"
     3485                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     3486          vPromoSum = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price).
     3487          leave cspr.
     3488       end.
     3489       return vPromoSum.
     3490   end.
     3491   function GetPromoPriceLine returns integer
     3492       (input iDocCode as character)
     3493       :
     3494       define buffer buf_chk-gds for ub.chk-gds.
     3495       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3496       define variable vPromoLine as integer no-undo.
     3497       vPromoLine = 0.
     3498       cspr:
     3499       for each buf_chk-gds no-lock where
     3500                    buf_chk-gds.doc-code = iDocCode,
     3501              first buf_chk-gds-attr no-lock where
     3502                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3503                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3504                and buf_chk-gds-attr.attr-code = "CSPromo"
     3505                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     3506          vPromoLine = buf_chk-gds-attr.line-num.
     3507          leave cspr.
     3508       end.
     3509       return vPromoLine.
     3510   end.
     3511   procedure r-pychk0:
     3512   define input parameter v-base-code as integer no-undo .
     3513   define input parameter p-doc-code as character no-undo .
     3514   _chk-doc:
     3515   for first ub.chk-doc no-lock where
     3516             ub.chk-doc.doc-code = p-doc-code,
     3517       each ub.chk-pay NO-LOCK WHERE
     3518           ub.chk-pay.doc-code = ub.chk-doc.doc-code
     3519   BREAK
     3520   BY CHK-pay.DOC-CODE
     3521   BY CHK-pay.LINE-NUM:
     3522   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3523   if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     3524     pychk_create = not can-find (first buf_chk-gds-pay
     3525                                  where buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
     3526                                    and buf_chk-gds-pay.algo-num = "1.8") .
     3527     if pychk_create then do:
     3528       for each temp-chk-pay:
     3529         delete temp-chk-pay.
     3530       end.
     3531       for each temp-chk-gds:
     3532         delete temp-chk-gds.
     3533       end.
     3534       for each temp-chk-dp:
     3535         delete temp-chk-dp.
     3536       end.
     3537       assign
     3538       pychk_kk = 0
     3539       pychk_jj = 1
     3540       pychk_jjp = 0
     3541       pychk_jjo = 0
     3542       pychk_pay-sum = ub.chk-doc.netto
     3543       pychk_dop-sumg = 0
     3544       pychk_pays_count = 0
     3545       .
     3546     end .
     3547   end.
     3548   if pychk_create   then do:
     3549   create-block:
     3550   do transaction
     3551   on stop   undo create-block, return error substitute( "&1. stop", vss-workfile )
     3552   on endkey undo create-block, return error substitute( "&1. endkey", vss-workfile )
     3553   on error  undo, throw:
     3554     find first buf2_chk-doc exclusive-lock where
     3555            recid(buf2_chk-doc) = recid(ub.chk-doc).
     3556     if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     3557       FOR EACH ub.chk-gds No-LOCK WHERE
     3558               ub.chk-gds.doc-code = ub.chk-pay.doc-code
     3559       BY ub.chk-gds.line-num:
     3560         if   ub.chk-gds.write-off-code > 0
     3561           or ub.chk-gds.doc-qnty  eq 0
     3562           or ub.chk-gds.doc-qnty  eq ?
     3563         then NEXT.
     3564         find first buf_bar-code no-lock where
     3565                   buf_bar-code.b-code = ub.chk-gds.b-code no-error.
     3566         if not available buf_bar-code then do:
     3567           undo create-block, return error substitute("Не найден товар для бар-кода &1: чек &2 &3&4 строка &5"
     3568                                                       , ub.chk-gds.b-code
     3569                                                       , ub.chk-gds.doc-code
     3570                                                       , ub.chk-doc.obj-type
     3571                                                       , ub.chk-doc.obj-code
     3572                                                       , ub.chk-gds.line-num).
     3573         end.
     3574         if ub.chk-gds.pump <> 0 then do:
     3575           pychk_rec-type = 1.
     3576           find first temp-ptrl-goods where
     3577                      temp-ptrl-goods.b-code = ub.chk-gds.b-code no-error.
     3578           if not available temp-ptrl-goods then do:
     3579             run gds-attr-value in this-procedure (
     3580                                                    input buf_bar-code.gds-code
     3581                                                   ,input 'ptrl-as-good':U
     3582                                                   ,output pychk_value
     3583                                                   ,output pychk_type) no-error.
     3584             create temp-ptrl-goods.
     3585             assign
     3586             temp-ptrl-goods.gds-code = buf_bar-code.gds-code
     3587             temp-ptrl-goods.b-code = buf_bar-code.b-code
     3588             temp-ptrl-goods.ptrl-good = (not logical(pychk_value))
     3589             no-error.
     3590           end.
     3591           pychk_line-type = if temp-ptrl-goods.ptrl-good then 1 else 0 .
     3592           release temp-ptrl-goods.
     3593         end.
     3594         else do:
     3595           assign
     3596           pychk_rec-type = 0
     3597           pychk_line-type = 0
     3598           .
     3599         end.
     3600         find first temp-chk-gds where
     3601                   temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3602               AND temp-chk-gds.rec-type = pychk_rec-type
     3603               and temp-chk-gds.b-code = ub.chk-gds.b-code
     3604               and temp-chk-gds.line-num = 0
     3605               no-error.
     3606         if not available temp-chk-gds then do:
     3607           find first temp-chk-gds use-index ijj where
     3608                   temp-chk-gds.jj_ = pychk_jj
     3609               and temp-chk-gds.line-num = 0
     3610                   no-error.
     3611           if not available temp-chk-gds then do:
     3612             create temp-chk-gds.
     3613             assign
     3614             temp-chk-gds.jj_ = pychk_jj
     3615             temp-chk-gds.b-code = ub.chk-gds.b-code
     3616             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3617             temp-chk-gds.line-num = 0
     3618             temp-chk-gds.rec-type = pychk_rec-type
     3619             temp-chk-gds.gds-code = buf_bar-code.gds-code.
     3620             .
     3621           end.
     3622           else do:
     3623             assign
     3624             temp-chk-gds.b-code = ub.chk-gds.b-code
     3625             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3626             temp-chk-gds.line-num = 0
     3627             temp-chk-gds.rec-type = pychk_rec-type
     3628             temp-chk-gds.sum = 0
     3629             temp-chk-gds.jjp_ = 0
     3630             temp-chk-gds.jjo_ = 0
     3631             temp-chk-gds.line-type = '':U
     3632             temp-chk-gds.num-lines = 0
     3633             temp-chk-gds.doc-qnty = 0
     3634             temp-chk-gds.sum = 0
     3635             temp-chk-gds.flag  = no
     3636             .
     3637           end.
     3638           assign
     3639           temp-chk-gds.line-type = (if pychk_line-type = 1
     3640                                   then 'топ':U
     3641                                   else entry(1, ub.chk-gds.line-type, chr(4))
     3642                                   ) + chr(4) +
     3643                                   (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     3644                                   then entry(2, ub.chk-gds.line-type, chr(4))
     3645                                   else '')
     3646           temp-chk-gds.line-num = 0
     3647           temp-chk-gds.num-lines = 0
     3648           temp-chk-gds.density   = ub.chk-gds.density
     3649           pychk_jj = pychk_jj + 1
     3650           .
     3651           if pychk_rec-type = 1 then do:
     3652             assign
     3653             temp-chk-gds.jjp_ = pychk_jjp + 1
     3654             pychk_jjp = pychk_jjp + 1
     3655             .
     3656           end.
     3657           else do:
     3658             assign
     3659             temp-chk-gds.jjo_ = pychk_jjo + 1
     3660             pychk_jjo = pychk_jjo + 1
     3661             .
     3662           end.
     3663         end.
     3664         vSumRound = ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt).
     3665         if ChkPromoPrice(ub.chk-gds.doc-code, ub.chk-gds.line-num) then vSumRound = ub.chk-gds.src-sum.
     3666         assign
     3667         temp-chk-gds.doc-qnty = temp-chk-gds.doc-qnty + ub.chk-gds.doc-qnty
     3668         temp-chk-gds.sum = temp-chk-gds.sum + vSumRound
     3669         temp-chk-gds.num-lines = temp-chk-gds.num-lines  + 1
     3670         .
     3671         find first temp-chk-gds use-index ijj where
     3672                 temp-chk-gds.jj_ = 0
     3673             and temp-chk-gds.line-num = ub.chk-gds.line-num
     3674                 no-error.
     3675         if not available temp-chk-gds then do:
     3676           create temp-chk-gds.
     3677           assign
     3678           temp-chk-gds.jj_ = 0
     3679           temp-chk-gds.line-num = ub.chk-gds.line-num
     3680           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3681           temp-chk-gds.b-code = ub.chk-gds.b-code
     3682           temp-chk-gds.gds-code = buf_bar-code.gds-code
     3683           temp-chk-gds.rec-type = pychk_rec-type
     3684           temp-chk-gds.line-num = ub.chk-gds.line-num
     3685           .
     3686         end.
     3687         else do:
     3688           assign
     3689           temp-chk-gds.doc-qnty = 0
     3690           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3691           temp-chk-gds.b-code = ub.chk-gds.b-code
     3692           temp-chk-gds.gds-code = buf_bar-code.gds-code
     3693           temp-chk-gds.rec-type = pychk_rec-type
     3694           temp-chk-gds.line-num = ub.chk-gds.line-num
     3695           temp-chk-gds.jjp_ = 0
     3696           temp-chk-gds.jjo_ = 0
     3697           temp-chk-gds.line-type = '':U
     3698                   .
     3699         end.
     3700         assign
     3701         temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3702         temp-chk-gds.b-code = ub.chk-gds.b-code
     3703         temp-chk-gds.doc-qnty = ub.chk-gds.doc-qnty
     3704         temp-chk-gds.price-base = ub.chk-gds.price-base
     3705         temp-chk-gds.price-service = ub.chk-gds.price-service
     3706         temp-chk-gds.line-type = (if pychk_line-type = 1
     3707                                 then 'топ':U
     3708                                 else entry(1, ub.chk-gds.line-type, chr(4))
     3709                                 ) + chr(4) +
     3710                                 (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     3711                                 then entry(2, ub.chk-gds.line-type, chr(4))
     3712                                 else '')
     3713         temp-chk-gds.line-sign = ub.chk-gds.line-sign
     3714         temp-chk-gds.discnt = ub.chk-gds.discnt
     3715         temp-chk-gds.sum = vSumRound
     3716         temp-chk-gds.rec-type = pychk_rec-type
     3717         temp-chk-gds.line-num = ub.chk-gds.line-num
     3718         temp-chk-gds.num-lines = 1
     3719         temp-chk-gds.density   = ub.chk-gds.density
     3720         .
     3721       END.
     3722       for each chk-discnt no-lock
     3723          where chk-discnt.doc-code = ub.chk-doc.doc-code
     3724            and record-type = 10
     3725            and chk-discnt.discnt-value-abs <> 0,
     3726           first ub.chk-gds of ub.chk-doc where ub.chk-gds.line-num =  chk-discnt.object-line-num :
     3727               if ub.chk-doc.chk-type = 1 and chk-discnt.object-qnty < 0 then do:
     3728                   for first temp-chk-dp where temp-chk-dp.doc-code = ub.chk-doc.doc-code
     3729                   and temp-chk-dp.b-code = chk-gds.b-code:
     3730                       temp-chk-dp.sum = temp-chk-dp.sum - abs(chk-discnt.discnt-value-abs * chk-discnt.object-qnty).
     3731                   end.
     3732               end.
     3733               else do:
     3734                   create temp-chk-dp .
     3735                   assign
     3736                   temp-chk-dp.doc-code = ub.chk-doc.doc-code
     3737                   temp-chk-dp.sum = abs(chk-discnt.discnt-value-abs) * chk-discnt.object-qnty
     3738                   temp-chk-dp.line-num = chk-discnt.object-line-num
     3739                   temp-chk-dp.pay-code = chk-discnt.rank
     3740                   temp-chk-dp.b-code = chk-gds.b-code
     3741                   temp-chk-dp.qnty   = abs(chk-discnt.discnt-value-pcnt)
     3742                   temp-chk-dp.all-sum =  chk-discnt.discnt-value-abs * chk-discnt.discnt-value-pcnt
     3743                   .
     3744               end.
     3745       end.
     3746     end.
     3747     FIND FIRST ub.cash-pay No-LOCK WHERE
     3748               ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
     3749               ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
     3750     if available ub.cash-pay then do:
     3751       pychk_payline_rrn = "" .
     3752       if not ub.cash-pay.is-cash then do :
     3753         for first buf_chk-pay-attr no-lock
     3754             where buf_chk-pay-attr.doc-code  = ub.CHK-pay.DOC-CODE
     3755               and buf_chk-pay-attr.attr-code = "cpdoc":U
     3756               and buf_chk-pay-attr.line-num  = ub.CHK-pay.line-num :
     3757           pychk_payline_rrn = buf_chk-pay-attr.attr-value .
     3758         end .
     3759       end .
     3760         find first temp-chk-pay where
     3761                 temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3762             and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3763             and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     3764             and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     3765             and temp-chk-pay.rrn       = pychk_payline_rrn
     3766                    no-error.
     3767       if not available temp-chk-pay then do:
     3768           find first temp-chk-pay where
     3769                   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3770               and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3771               and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     3772               and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     3773               and abs(temp-chk-pay.tot-r-b) >= abs(ub.chk-pay.tot-sum)
     3774               and (temp-chk-pay.tot-r-b >=0) NE (ub.chk-pay.tot-sum >=0)
     3775               no-error.
     3776         if not  avail temp-chk-pay then do:
     3777           find first temp-chk-pay where
     3778                     temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3779                 and temp-chk-pay.line-num = ub.chk-pay.line-num use-index pi no-error.
     3780           if not available temp-chk-pay then do:
     3781             create temp-chk-pay.
     3782             assign
     3783             temp-chk-pay.line-num = ub.chk-pay.line-num
     3784             temp-chk-pay.doc-code = ub.chk-doc.doc-code
     3785             temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3786             temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     3787             temp-chk-pay.rrn       = pychk_payline_rrn
     3788             pychk_pays_count = pychk_pays_count + 1
     3789             .
     3790           end.
     3791           assign
     3792           temp-chk-pay.doc-code = ub.chk-doc.doc-code
     3793           temp-chk-pay.pet-good = integer(cash-pay.atr64) * 2 + integer(cash-pay.is-cash) + 2 * int(can-find(first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code ))
     3794           temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3795           temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     3796           temp-chk-pay.is-cash  = ub.cash-pay.is-cash
     3797           temp-chk-pay.register = ub.cash-pay.register
     3798           temp-chk-pay.pay-card = ub.chk-pay.pay-card
     3799           temp-chk-pay.tot-rubl = 0
     3800           temp-chk-pay.tot-base = 0
     3801           temp-chk-pay.num-lines = 0
     3802           temp-chk-pay.flag  = no
     3803           .
     3804         end.
     3805       end.
     3806       assign
     3807       temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b + (if v-curr-r-b = 'rubl':U
     3808                                                      then ub.chk-pay.tot-rubl
     3809                                                      else ub.chk-pay.tot-base)
     3810       temp-chk-pay.tot-rubl = temp-chk-pay.tot-rubl + ub.chk-pay.tot-rubl
     3811       temp-chk-pay.tot-base = temp-chk-pay.tot-base + ub.chk-pay.tot-base
     3812       temp-chk-pay.num-lines = temp-chk-pay.num-lines  + 1
     3813       .
     3814     end.
     3815     if available temp-chk-pay then RELEASE TEMP-CHK-PAY.
     3816     if last-of(ub.chk-pay.doc-code) then do:
     3817       for each temp-chk-pay where
     3818               temp-chk-pay.doc-code = ub.chk-doc.doc-code:
     3819          if    (temp-chk-pay.tot-r-b  >= 0) NE (ub.chk-doc.netto >= 0)
     3820             and temp-chk-pay.tot-r-b <> 0
     3821             and abs(ub.chk-doc.netto) > 0.00000001
     3822          then do:
     3823             if not g#auto then do:
     3824                message
     3825                   substitute("Не могу обработать чек &1&2&3&4 смена &5 пор.&6 касса &7 № на кассе &8"
     3826                             ,ub.chk-doc.doc-code
     3827                             ,chr(10)
     3828                             ,ub.chk-doc.obj-type
     3829                             ,ub.chk-doc.obj-code
     3830                             ,ub.chk-doc.shift-date
     3831                             ,ub.chk-doc.shift-num
     3832                             ,ub.chk-doc.pay-desk
     3833                             ,ub.chk-doc.chk-num)
     3834                   view-as alert-box error .
     3835             end.
     3836             next _chk-doc.
     3837          end.
     3838       end.
     3839       for each temp-chk-pay where
     3840               temp-chk-pay.doc-code = ub.chk-doc.doc-code
     3841       break
     3842       by temp-chk-pay.pet-good descending
     3843       by temp-chk-pay.line-num:
     3844          dp:
     3845          for each temp-chk-dp no-lock
     3846             where temp-chk-dp.pay-code = temp-chk-pay.pay-code
     3847               and temp-chk-dp.doc-code = temp-chk-pay.doc-code
     3848               and temp-chk-dp.sum <> 0 :
     3849               find first buf_temp-chk-gds2 where
     3850                   buf_temp-chk-gds2.doc-code = ub.chk-doc.doc-code
     3851               and buf_temp-chk-gds2.line-num  =  temp-chk-dp.line-num no-error.
     3852               if available buf_temp-chk-gds2 then
     3853               for each buf_temp-chk-gds where
     3854                   buf_temp-chk-gds.b-code = buf_temp-chk-gds2.b-code
     3855                   and buf_temp-chk-gds.line-num ne 0
     3856               no-lock by buf_temp-chk-gds.line-num  ne  temp-chk-dp.line-num :
     3857                    if         temp-chk-dp.all-sum  eq ?
     3858                       or abs(temp-chk-dp.all-sum) <= 0.001
     3859                   then
     3860                      next dp.
     3861                   find first  temp-chk-gds where
     3862                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     3863                       and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     3864                     and temp-chk-gds.line-num = 0
     3865                   no-error .
     3866                   if not available temp-chk-gds then next dp.
     3867                   case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     3868                       when 1 then do:
     3869                         pychk_line-type-chr = temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     3870                       end.
     3871                       when 2 then do:
     3872                         pychk_line-type-chr = temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     3873                       end.
     3874                   end case.
     3875                   pychk_dop-sumk =  if temp-chk-dp.sum >= 0
     3876                   then min(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum,temp-chk-pay.tot-r-b)
     3877                   else max(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum).
     3878                   if abs(temp-chk-pay.tot-r-b - pychk_dop-sumk) <= 0.001
     3879                   then
     3880                      pychk_dop-sumk = temp-chk-pay.tot-r-b.
     3881                   temp-chk-dp.all-sum           = temp-chk-dp.all-sum - pychk_dop-sumk.
     3882                   if can-find (first buf_chk-gds-pay no-lock where
     3883                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3884                                  and buf_chk-gds-pay.algo-num = "1.8"
     3885                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     3886                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     3887                                      )
     3888                   then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     3889                                                       , temp-chk-pay.doc-code
     3890                                                       , ub.chk-doc.obj-type
     3891                                                       , ub.chk-doc.obj-code
     3892                                                       , buf_temp-chk-gds.line-num
     3893                                                       , temp-chk-pay.line-num).
     3894                   create buf_chk-gds-pay.
     3895                     assign
     3896                     buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3897                     buf_chk-gds-pay.chk-type = ub.chk-doc.chk-type
     3898                     buf_chk-gds-pay.algo-num = "1.8"
     3899                     buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     3900                     buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     3901                     buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     3902                     buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     3903                     buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     3904                     buf_chk-gds-pay.tot-r-b =  pychk_dop-sumk
     3905                     buf_chk-gds-pay.eff-base-rate = 1
     3906                     buf_chk-gds-pay.eff-doc-qnty = (if (temp-chk-gds.num-lines = 1
     3907                                                     and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     3908                                                     and pychk_pays_count = 1)
     3909                                                     or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     3910                                                     then temp-chk-gds.doc-qnty
     3911                                                     else (buf_chk-gds-pay.tot-r-b / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     3912                                                     )
     3913                     buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     3914                     buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     3915                     buf_chk-gds-pay.price-base = buf_temp-chk-gds.price-base
     3916                     buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     3917                     buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     3918                     buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     3919                     buf_chk-gds-pay.line-type = pychk_line-type-chr
     3920                     buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     3921                     buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     3922                     buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     3923                     buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     3924                     buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     3925                     buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     3926                     buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     3927                     buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     3928                     buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     3929                     buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     3930                     .
     3931                   assign
     3932                   buf_temp-chk-gds.sum = buf_temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     3933                   temp-chk-gds.sum =  temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     3934                   buf_temp-chk-gds.doc-qnty = buf_temp-chk-gds.doc-qnty - buf_chk-gds-pay.eff-doc-qnty
     3935                   temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b - buf_chk-gds-pay.tot-r-b
     3936                   pychk_dop-sumk = pychk_dop-sumk - buf_chk-gds-pay.tot-r-b
     3937                   .
     3938                    if (ub.chk-doc.chk-type = 1 and temp-chk-pay.tot-r-b <= 0) or (ub.chk-doc.chk-type <> 1 and temp-chk-pay.tot-r-b >= 0) then leave dp.
     3939               end.
     3940           end.
     3941         assign
     3942         pychk_dop-sump = temp-chk-pay.tot-r-b
     3943         pychk_exch = if pychk_No-exch then 1
     3944                      else (if temp-chk-pay.tot-base = 0
     3945                            then 0
     3946                            else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     3947         pychk_exch-rubl = if pychk_No-exch-rubl
     3948                           then 1
     3949                           else (if temp-chk-pay.tot-base = 0
     3950                                 then 0
     3951                                 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     3952         temp-chk-pay.flag = (if abs(temp-chk-pay.tot-rubl) < 0.001 then no else yes)
     3953         .
     3954         _repeat:
     3955         REPEAT WHILE  abs(pychk_dop-sump) > 0 :
     3956           if pychk_dop-sumg = 0 then do:
     3957             assign
     3958             pychk_kk = pychk_kk + 1
     3959             .
     3960             if pychk_kk >= pychk_jj then LEAVE _repeat.
     3961             if pychk_kk <= pychk_jjp then do:
     3962               find first temp-chk-gds where
     3963                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     3964                     and temp-chk-gds.jjp_ = pychk_kk
     3965                     and temp-chk-gds.line-num = 0
     3966                   no-error .
     3967             end.
     3968             else do:
     3969               find first temp-chk-gds where
     3970                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     3971                     and temp-chk-gds.jjo_ = pychk_kk - pychk_jjp
     3972                     and temp-chk-gds.line-num = 0
     3973                   no-error .
     3974             end.
     3975             if not available temp-chk-gds
     3976             or (temp-chk-gds.sum = 0
     3977                 or
     3978                 (temp-chk-gds.sum <= 0  and ub.chk-doc.netto > 0)
     3979                 )
     3980             then do:
     3981               NEXT _repeat.
     3982             end.
     3983             assign
     3984             pychk_dop-sumg = if available temp-chk-gds then temp-chk-gds.sum else 0
     3985             temp-chk-gds.flag = yes
     3986             .
     3987           end.
     3988           assign
     3989           pychk_dop-sumk = min(abs(pychk_dop-sumg), abs(pychk_dop-sump))  * (if pychk_dop-sump > 0 then 1 else -1 ) * (if pychk_dop-sumg < 0 AND ub.chk-doc.chk-type = 1 then -1 else 1 )
     3990           pychk_pay-sum = pychk_pay-sum - pychk_dop-sumk
     3991           pychk_dop-sump = pychk_dop-sump - pychk_dop-sumk
     3992           pychk_dop-sumg = pychk_dop-sumg - pychk_dop-sumk
     3993           pychk_sum-promo = GetPromoPriceSum(ub.chk-doc.doc-code)
     3994           .
     3995           if pychk_sum-promo <> 0 then
     3996              vPromoLineNum = GetPromoPriceLine(ub.chk-doc.doc-code).
     3997           else vPromoLineNum = 0.
     3998           for each buf_temp-chk-gds where
     3999                   buf_temp-chk-gds.doc-code = ub.chk-doc.doc-code
     4000               and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     4001               and buf_temp-chk-gds.line-num  > 0
     4002           by buf_temp-chk-gds.doc-code
     4003           by buf_temp-chk-gds.rec-type descending
     4004           by buf_temp-chk-gds.line-num
     4005            :
     4006             case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     4007               when 1 then do:
     4008                 pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     4009               end.
     4010               when 2 then do:
     4011                 pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     4012               end.
     4013             end case.
     4014             if  vPromoLineNum <> 0 and
     4015                 temp-chk-gds.num-lines > 1 and
     4016                 buf_temp-chk-gds.line-num = vPromoLineNum and
     4017                 can-find(first buf_chk-gds-pay no-lock where
     4018                                buf_chk-gds-pay.doc-code = buf_temp-chk-gds.doc-code
     4019                            and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num)
     4020             then .
     4021             else
     4022             if not (buf_temp-chk-gds.sum = 0 and can-find (first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code and buf_temp-chk-gds.line-num  =  temp-chk-dp.line-num)) then do:
     4023                 if vPromoLineNum <> 0 and
     4024                    buf_temp-chk-gds.line-num = vPromoLineNum
     4025                 then do:
     4026                    vSum = RoundUp(buf_temp-chk-gds.doc-qnty, buf_temp-chk-gds.price-base).
     4027                 end.
     4028                 else if vPromoLineNum <> 0 and
     4029                         temp-chk-gds.num-lines > 1 and
     4030                         pychk_sum-promo <> 0 and
     4031                         ChkPromoLine(buf_temp-chk-gds.doc-code, buf_temp-chk-gds.line-num)
     4032                 then do:
     4033                     if can-find(first buf_chk-gds-pay no-lock where
     4034                                       buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4035                                   and buf_chk-gds-pay.line-num = vPromoLineNum
     4036                                   )
     4037                      then vSum = (pychk_dop-sumk * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     4038                      else vSum = ((pychk_dop-sumk - pychk_sum-promo) * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     4039                 end.
     4040                 else
     4041                 vSum                     = (if    temp-chk-gds.num-lines = 1
     4042                                               and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     4043                                             then pychk_dop-sumk
     4044                                             else (pychk_dop-sumk * buf_temp-chk-gds.sum / temp-chk-gds.sum)
     4045                                            )
     4046                 .
     4047                 if can-find (first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code) then do:
     4048                     find first buf_chk-gds-pay where buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4049                     and buf_chk-gds-pay.algo-num = "1.8"
     4050                     and buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     4051                     and buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     4052                     and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     4053                     and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     4054                     and buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card exclusive-lock no-error.
     4055                     if not available buf_chk-gds-pay then do:
     4056                        if can-find (first buf_chk-gds-pay no-lock where
     4057                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4058                                  and buf_chk-gds-pay.algo-num = "1.8"
     4059                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     4060                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     4061                                      )
     4062                        then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     4063                                                       , temp-chk-pay.doc-code
     4064                                                       , ub.chk-doc.obj-type
     4065                                                       , ub.chk-doc.obj-code
     4066                                                       , buf_temp-chk-gds.line-num
     4067                                                       , temp-chk-pay.line-num).
     4068                        create buf_chk-gds-pay.
     4069                     end.
     4070                 end.
     4071                 else do:
     4072                      if can-find (first buf_chk-gds-pay no-lock where
     4073                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4074                                  and buf_chk-gds-pay.algo-num = "1.8"
     4075                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     4076                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     4077                                      )
     4078                      then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     4079                                                       , temp-chk-pay.doc-code
     4080                                                       , ub.chk-doc.obj-type
     4081                                                       , ub.chk-doc.obj-code
     4082                                                       , buf_temp-chk-gds.line-num
     4083                                                       , temp-chk-pay.line-num).
     4084                      create buf_chk-gds-pay.
     4085                 end.
     4086                 assign
     4087                 buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4088                 buf_chk-gds-pay.chk-type = ub.chk-doc.chk-type
     4089                 buf_chk-gds-pay.algo-num = "1.8"
     4090                 buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     4091                 buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     4092                 buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     4093                 buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     4094                 buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     4095                 buf_chk-gds-pay.tot-r-b = buf_chk-gds-pay.tot-r-b  + vSum
     4096                 buf_chk-gds-pay.eff-base-rate = pychk_exch
     4097                 buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     4098                 buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     4099                 buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     4100                 buf_chk-gds-pay.price-base = buf_temp-chk-gds.price-base
     4101                 buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     4102                 buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     4103                 buf_chk-gds-pay.line-type = pychk_line-type-chr
     4104                 buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     4105                 buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     4106                 buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     4107                 buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     4108                 buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     4109                 buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     4110                 buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     4111                 buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     4112                 buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     4113                 buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     4114                 buf_temp-chk-gds.flag = yes
     4115                 .
     4116                 if buf_temp-chk-gds.line-num = vPromoLineNum
     4117                 then do:
     4118                    buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty.
     4119                 end.
     4120                 else
     4121                 buf_chk-gds-pay.eff-doc-qnty = (if buf_chk-gds-pay.eff-doc-qnty = ? then 0 else buf_chk-gds-pay.eff-doc-qnty) + (if (temp-chk-gds.num-lines = 1
     4122                                                 and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     4123                                                 and pychk_pays_count = 1)
     4124                                                 or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     4125                                                 then temp-chk-gds.doc-qnty
     4126                                                 else (vSum / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     4127                                                 )
     4128                 .
     4129               end.
     4130           end.
     4131         end.
     4132       end.
     4133       if available temp-chk-gds then release temp-chk-gds.
     4134       if available temp-chk-pay then release temp-chk-pay.
     4135       pychk_zero-gds = 0.
     4136       pychk_zero-pay = 0.
     4137       for each temp-chk-gds where
     4138               temp-chk-gds.doc-code = ub.chk-pay.doc-code
     4139           and temp-chk-gds.flag = no
     4140           and temp-chk-gds.line-num  > 0
     4141           :
     4142          pychk_zero-gds = pychk_zero-gds + 1.
     4143       end.
     4144       for each temp-chk-pay where
     4145               temp-chk-pay.doc-code = ub.chk-pay.doc-code
     4146           and temp-chk-pay.flag = no:
     4147          pychk_zero-pay = pychk_zero-pay + 1.
     4148       end.
     4149       find first temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code
     4150                                 and temp-chk-pay.flag = no
     4151       no-lock no-error.
     4152       if not available temp-chk-pay
     4153       then do:
     4154          block-pay:
     4155          for each temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code:
     4156             assign
     4157                pychk_zero-pay = pychk_zero-pay +  1
     4158                temp-chk-pay.flag = no
     4159             .
     4160             leave block-pay.
     4161          end.
     4162       end.
     4163       for each temp-chk-pay
     4164       where   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     4165           and temp-chk-pay.flag = no:
     4166         pychk_zero-n = 0.
     4167         for each buf_temp-chk-gds
     4168         where   buf_temp-chk-gds.doc-code = ub.chk-pay.doc-code
     4169             and buf_temp-chk-gds.flag = no
     4170             and buf_temp-chk-gds.line-num  > 0 :
     4171           pychk_zero-n = pychk_zero-n + 1.
     4172           if  temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 and abs(buf_temp-chk-gds.sum) > 0 then next.
     4173           case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     4174             when 1 then do:
     4175               pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     4176             end.
     4177             when 2 then do:
     4178               pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     4179             end.
     4180           end case.
     4181           if can-find(first buf_chk-gds-pay no-lock where
     4182                             buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4183                         and buf_chk-gds-pay.algo-num = "1.8"
     4184                         and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     4185                         and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num)
     4186           then do:
     4187               buf_temp-chk-gds.flag = yes.
     4188           end.
     4189           else do:
     4190               create buf_chk-gds-pay.
     4191               assign
     4192               buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4193               buf_chk-gds-pay.algo-num = "1.8"
     4194               buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     4195               buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     4196               buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     4197               buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     4198               buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     4199               buf_chk-gds-pay.tot-r-b = 0
     4200               buf_chk-gds-pay.eff-base-rate = pychk_exch
     4201               buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty
     4202               buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     4203               buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     4204               buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     4205               buf_chk-gds-pay.price-base = (if temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 then 0 else buf_temp-chk-gds.price-base)
     4206               buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     4207               buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     4208               buf_chk-gds-pay.line-type = pychk_line-type-chr
     4209               buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     4210               buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     4211               buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     4212               buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     4213               buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     4214               buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     4215               buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     4216               buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     4217               buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     4218               buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     4219               buf_temp-chk-gds.flag = yes
     4220               .
     4221           end.
     4222           if pychk_zero-n > pychk_zero-gds / pychk_zero-pay then leave.
     4223         end.
     4224         temp-chk-pay.flag = yes.
     4225       end.
     4226     end.
     4227   end.
     4228   end.
     4229   end.
     4230   end.
     4231   procedure proc-main :
     4232   define input parameter p-status_ like ub.trn-doc.status_ no-undo .
     4233   define variable road as logical no-undo.
     4234   define variable for-price as decimal no-undo.
     4235   define variable for-excise as decimal no-undo.
     4236   define variable for-road as decimal no-undo.
     4237   define variable bottle as logical no-undo.
     4238   define variable accum-chk-doc-tot-doc as decimal no-undo.
     4239   define variable accum-chk-doc-discnt as decimal no-undo.
     4240   define variable accum-chk-doc-netto as decimal no-undo.
     4241   define variable accum-chk-doc-sub-discnt as decimal no-undo.
     4242   define variable accum-chk-pay-tot-sum-by as decimal no-undo.
     4243   define variable accum-chk-pay-tot-base-by as decimal no-undo.
     4244   define variable accum-chk-pay-tot-rubl-by as decimal no-undo.
     4245   define variable KIND-TO-RESERV as character no-undo .
     4246   define variable KIND-TO-RESERV-GDS as character no-undo .
     4247   define variable cli-type-to-reserv as character no-undo.
     4248   define variable cli-code-to-reserv as integer no-undo.
     4249   define variable v-real-doc-kind as character no-undo .
     4250   define variable office-TO-RESERV as character no-undo .
     4251   define variable office-TO-RESERV-GDS as character no-undo .
     4252   define variable docs-to-reserv as integer no-undo .
     4253   define variable docs-to-reserv-gds as integer no-undo .
     4254   define variable v-add as logical no-undo .
     4255   define variable dtrg as integer no-undo .
     4256   define variable dtrg-start as logical no-undo .
     4257   define variable cashparts as logical no-undo.
     4258   define variable cashparts-chk as logical no-undo.
     4259   define variable serparts as logical no-undo.
     4260   define variable plcode like ub.place.pl-code no-undo.
     4261   define variable cashfbrs as logical no-undo .
     4262   define variable v-is-dish as character no-undo .
     4263   define variable v-deleted as logical no-undo .
     4264   define variable varchip-code as integer no-undo .
     4265   define variable varchip-code2 as integer no-undo .
     4266   define variable v-mes as character no-undo .
     4267   define variable v-clcdoc-vat-pc                     like ub.doc-line.vat-pc           no-undo.
     4268   define variable v-clcdoc-slt-pc                     like ub.doc-line.slt-pc           no-undo.
     4269   define variable glog as logical no-undo .
     4270   define variable action as character no-undo .
     4271   define variable other-doc-code as character no-undo .
     4272   define variable v-is-tpsi-obj as logical no-undo .
     4273   define variable v-tpsi-mode as integer no-undo .
     4274   define variable v-main-tpsi as logical no-undo .
     4275   DEFINE VARIABLE var-doc-type like ub.inkas-pay-desk.doc-type no-undo .
     4276   define variable v-rc-ii as integer no-undo initial 1.
     4277   define variable v-rc-max as integer no-undo .
     4278   define variable v-first as logical no-undo init yes .
     4279   define variable v-created as logical no-undo .
     4280   define variable v-created-dtl as logical no-undo .
     4281   define variable add-nf-amount as integer   no-undo .
     4282   define variable add-NF-gds-amount as integer   no-undo .
     4283   define variable v-dop as character no-undo .
     4284   define variable v-rec-inv-line as recid no-undo .
     4285   define variable nff-chk-amount as integer no-undo .
     4286   define variable v-cash-pay-attr as character no-undo.
     4287   define variable par-alcohol as character no-undo .
     4288   define variable par-type    as character no-undo .
     4289   define variable mark-ii     as integer no-undo .
     4290   define variable v-doc-code_fbr as character no-undo .
     4291   define variable v-pl-code   like ub.place.pl-code no-undo .
     4292   define variable v-pl-list   as character no-undo .
     4293   define variable v-pl-ii     as integer   no-undo .
     4294   define variable v-value     as character no-undo .
     4295   define variable v-ok        as logical   no-undo .
     4296   define variable v-Reconc-tank-attr as character no-undo .
     4297   define buffer buf_trn-doc for ub.trn-doc.
     4298   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4299   define buffer buf_c-chk-doc for ub.c-chk-doc.
     4300   define buffer buf_c-chk-gds for ub.c-chk-gds.
     4301   define buffer buf_c-chk-pay for ub.c-chk-pay.
     4302   define buffer buf_c-chk-discnt for ub.c-chk-discnt.
     4303   define buffer buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     4304   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
     4305   define buffer buf_chk-pay for ub.chk-pay.
     4306   define buffer buf_cash-pay-attr for ub.cash-pay-attr.
     4307   define buffer buf_chk-gds for ub.chk-gds.
     4308   define buffer buf_chk-discnt for ub.chk-discnt.
     4309   define buffer buf_inkas-pay for ub.inkas-pay.
     4310   define buffer buf_inkas-pay-desk for ub.inkas-pay-desk.
     4311   define buffer buf_inkas-pay-wth for ub.inkas-pay-wth.
     4312   define buffer buf_place       for ub.place.
     4313   define buffer com_place       for ub.place.
     4314   define buffer dop_trn-doc for ub.trn-doc.
     4315   define buffer buf_doc-line for ub.doc-line.
     4316   define buffer buf_gds-dtl for ub.gds-dtl.
     4317   define buffer BUF_sale-doc for ub.sale-doc.
     4318   define buffer tpsi_sale-doc for ub.sale-doc.
     4319   do
     4320   on error undo, return error return-value
     4321   :
     4322     if ink-doc.status_ = 'факт':U
     4323     then do:
     4324       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Продажа &1 уже закрыта:&2Докачка чеков не может быть произведена"                                , ink-doc.inkas-code                                        , chr(10)                                                )                                       ) .
     4325        UNDO, return error.
     4326     end.
     4327     find first ub.sysconf no-lock where
     4328               ub.sysconf.host-code = ink-doc.host-code .
     4329     if v-curr-r-b = 'base':U or
     4330     ub.sysconf.base-code = 0 then pychk_NO-exch = yes.
     4331     else pychk_No-exch = no.
     4332     if v-curr-r-b = 'rubl':U or
     4333     ub.sysconf.base-code = 0 then pychk_NO-exch-rubl = yes.
     4334     else pychk_No-exch-rubl = no.
     4335     assign
     4336     accum-chk-doc-tot-doc = 0
     4337     accum-chk-doc-discnt = 0
     4338     accum-chk-doc-netto = 0
     4339     accum-chk-doc-sub-discnt = 0
     4340     v-rc-max = (if p-rid-list <> '':U then num-entries(p-rid-list) else 1)
     4341     v-rc-ii = (if p-rid-list <> '':U
     4342                then (if available X_chk-doc
     4343                      then lookup(string(recid(X_chk-doc)), p-rid-list)
     4344                      else v-rc-ii)
     4345                else v-rc-ii)
     4346     .
     4347     run get-inkas-ps in this-procedure (
     4348                                         buffer ink-doc
     4349                                       , output chk-amount
     4350                                       , output gds-amount
     4351                                       , output line-out
     4352                                       , output dtl-out
     4353                                       , output line-ret
     4354                                       , output dtl-ret
     4355                                       , output nf-chk-amount
     4356                                       , output nf-gds-amount
     4357                                       , output p-filter-rus
     4358                                       ).
     4359     run get-tpsi-params in this-procedure (
     4360                                             input ink-doc.obj-type
     4361                                            ,input ink-doc.obj-code
     4362                                            ,output v-is-tpsi-obj
     4363                                            ,output v-tpsi-mode
     4364                                            ,output v-main-tpsi ) no-error.
     4365   end.
     4366   do
     4367   on error undo, return error return-value
     4368   :
     4369     for each buf_sale-doc where
     4370              buf_sale-doc.inkas-code = ink-doc.inkas-code
     4371          and buf_sale-doc.order > 0:
     4372       buf_sale-doc.chk-doc-code = '':U.
     4373     end.
     4374     c-d:
     4375     DO WHILE available X_chk-doc or (p-rid-list <> '':U and  v-rc-ii <= v-rc-max) or action = "next"
     4376     on error undo c-d, NEXT c-d
     4377     on stop undo c-d, NEXT c-d:
     4378       action = '':U.
     4379       if not v-first then do:
     4380         if p-rid-list = "":U then do:
     4381           ASSIGN
     4382           glog = QUERY query-chk-doc:GET-next(no-LOCK) NO-ERROR.
     4383           if available X_chk-doc then do:
     4384             ASSIGN
     4385             glog = QUERY query-chk-doc:GET-current(exclusive-LOCK, no-wait) NO-ERROR.
     4386             if locked(X_chk-doc)
     4387             or X_chk-doc.out-code <> ?
     4388             then do:
     4389               error-status:error = no.
     4390               action = "next".
     4391               next c-d.
     4392             end.
     4393           end.
     4394         end.
     4395         else do:
     4396           assign
     4397           v-rc-ii = v-rc-ii + 1.
     4398           _v-rc:
     4399           do while v-rc-ii <= v-rc-max:
     4400             find first X_chk-doc exclusive-lock where
     4401                       recid(X_chk-doc) = integer(entry(v-rc-ii, p-rid-list))  no-error  NO-WAIT.
     4402             if locked X_chk-doc or not available X_chk-doc
     4403             or X_chk-doc.out-code <> ?
     4404             then do:
     4405               assign
     4406               v-rc-ii = v-rc-ii + 1.
     4407               next _v-rc.
     4408             end.
     4409             else LEAVE _v-rc.
     4410           end.
     4411           if v-rc-ii > v-rc-max then release X_chk-doc.
     4412         end.
     4413         if (not available X_chk-doc and action = '':U)
     4414         or (p-rid-list <> "":U and v-rc-ii > v-rc-max) then LEAVE c-d.
     4415       end.
     4416       if v-first then v-first = no.
     4417       cr = 0.
     4418       if lookup(string(X_chk-doc.chk-type), '101,106,108,169,196,114,115,116,136,117,111,112,113':U) > 0
     4419       or lookup(string(X_chk-doc.chk-type), '11,111,201,206':U) > 0
     4420       or X_chk-doc.out-code <> ?
     4421       then do:
     4422         next c-d.
     4423       end.
     4424       if lookup(string(X_chk-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) = 0
     4425       then do:
     4426         next c-d.
     4427       end.
     4428       if lookup(string(X_chk-doc.chk-type), '2,3,4,5,7':U) > 0
     4429       and is-wth = yes then do:
     4430         NEXT c-d .
     4431       end.
     4432       if v-is-tpsi-obj then do:
     4433         if (p-status_ = 'запрос':U
     4434         and index(X_chk-doc.doc-code, '>':U)  > 0 )
     4435         or (p-status_ = 'касс':U
     4436             and v-tpsi-mode = 2
     4437             and index(X_chk-doc.doc-code, '>':U)  = 0
     4438             )
     4439         then next c-d.
     4440       end.
     4441       if cas-shft then do:
     4442         if ink-doc.doc-date <> X_chk-doc.shift-date OR ink-doc.shift-num <> X_chk-doc.shift-num then do:
     4443           NEXT c-d .
     4444         end.
     4445       end.
     4446       else do:
     4447         if p-day-only then do:
     4448           if ink-doc.doc-date <> X_chk-doc.shift-date then do:
     4449             NEXT c-d .
     4450           end.
     4451         end.
     4452         else do:
     4453           if X_chk-doc.shift-date > ink-doc.shift-date
     4454           and ((p-rid-list = "":U and p-filter-on = no)
     4455               or
     4456               p-filter-on = no)
     4457           then do:
     4458             NEXT c-d .
     4459           end.
     4460         end.
     4461       end.
     4462       if replace(replace(replace(X_chk-doc.office
     4463                                  , 'т':U
     4464                                  , '':U)
     4465                          , 'у':U
     4466                          , '':U)
     4467                  , chr(44)
     4468                  , '':U) <> '':U
     4469       then do:
     4470         NEXT c-d .
     4471       end.
     4472       if one-curs
     4473       and LOokup(string(X_chk-doc.chk-type), '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) = 0 then do:
     4474         if cas-curs then do:
     4475           find first buf_chk-pay where buf_chk-pay.doc-code = X_chk-doc.doc-code No-LOCK No-ERROR.
     4476           if abs(buf_chk-pay.tot-rubl / buf_chk-pay.tot-base - cursh / cursh-scale) > 0.00005 then NEXT c-d.
     4477         end.
     4478         else do:
     4479           if
     4480           X_chk-doc.cash-rate <> cursh
     4481           or
     4482           X_chk-doc.cash-scale <> cursh-scale  then NEXT c-d.
     4483         end.
     4484       end.
     4485       assign
     4486       p-ii = p-ii + 1
     4487       .
     4488       if p-ii < 10
     4489       or (p-ii < 1000 and chk-amount modulo 10 = 0)
     4490       or (p-ii < 10000 and chk-amount modulo 100 = 0)
     4491       then do:
     4492         run display-chk in p-call-handle (chk-amount, nf-chk-amount).
     4493       end.
     4494       if X_chk-doc.chk-type <> integer('12':U) and X_chk-doc.office <> "" then do:
     4495       docs-to-reserv = get-inc-sal (
     4496                                     input string(X_chk-doc.chk-type)
     4497                                   , input X_chk-doc.netto
     4498                                   , input yes
     4499                                   , input X_chk-doc.office
     4500                                   , input ?
     4501                                   , output v-add
     4502                                   , output office-to-reserv
     4503                                   , output kind-to-reserv
     4504                                   , output add-nf-amount
     4505                                   ) no-error .
     4506       end.
     4507       else docs-to-reserv = 0 .
     4508       v-cash-pay-attr = "".
     4509       cli-type-to-reserv = "".
     4510       cli-code-to-reserv = 0.
     4511       if X_chk-doc.chk-type = integer('17':U) then do:
     4512           for each buf_chk-pay where buf_chk-pay.doc-code = X_chk-doc.doc-code no-lock:
     4513               find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = buf_chk-pay.pay-code
     4514                                            and buf_cash-pay-attr.curr-code = buf_chk-pay.curr-code
     4515                                            and buf_cash-pay-attr.attr-code = "dop-doc" no-lock no-error.
     4516               if not available(buf_cash-pay-attr) then next.
     4517               v-cash-pay-attr = buf_cash-pay-attr.attr-value.
     4518               case entry(1, v-cash-pay-attr, ','):
     4519                   when 'swo':U then do:
     4520                       v-add = no.
     4521                       docs-to-reserv = 1.
     4522                       office-to-reserv = 'т':U.
     4523                       kind-to-reserv = entry(1, v-cash-pay-attr, ',').
     4524                       cli-type-to-reserv = entry(2, v-cash-pay-attr, ',').
     4525                       cli-code-to-reserv = int(entry(3, v-cash-pay-attr, ',')).
     4526                   end.
     4527                   when 'trf':U then do:
     4528                       cli-type-to-reserv = entry(2, v-cash-pay-attr, ',').
     4529                       cli-code-to-reserv = int(entry(3, v-cash-pay-attr, ',')).
     4530                   end.
     4531                   when 'vir':U then do:
     4532                       kind-to-reserv = 'vir':U.
     4533                       cli-type-to-reserv = entry(2, v-cash-pay-attr, ',').
     4534                       cli-code-to-reserv = int(entry(3, v-cash-pay-attr, ',')).
     4535                   end.
     4536                   when 'none' then do:
     4537                       docs-to-reserv = 0.
     4538                       kind-to-reserv = 'none'.
     4539                   end.
     4540               end case.
     4541           end.
     4542       end.
     4543       if docs-to-reserv > 0
     4544       and not (KIND-TO-RESERV = 'es':U
     4545                and office-to-reserv = 'т':U) then do:
     4546         do dtrg = 1 to docs-to-reserv:
     4547           find first buf_sale-doc where
     4548                     buf_Sale-doc.inkas-code = ink-doc.inkas-code
     4549                 and buf_sale-doc.doc-kind = entry(dtrg, kind-to-reserv)
     4550                 and buf_sale-doc.chr-office = entry(dtrg, office-to-reserv) no-error .
     4551           if not available buf_sale-doc then do:
     4552             run str/cresalad.p (
     4553                             buffer trn-doc
     4554                           , buffer dop_trn-doc
     4555                           , input entry(dtrg, kind-to-reserv)
     4556                           , input entry(dtrg, office-to-reserv)
     4557                           , input cli-type-to-reserv
     4558                           , input cli-code-to-reserv
     4559                           , output other-doc-code) no-error .
     4560             if error-status:error then do:
     4561               run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("&1 &2 &3&4&5&4&6"                                    , vss-workfile                                                     , vss-revision                                                     , vss-description                                                  , chr(10)                                                    , error-status:get-message(1)                                      , return-value)                                       ) .
     4562               undo c-d, next c-d.
     4563             end.
     4564           end.
     4565         end.
     4566       end.
     4567       _one-check:
     4568       do
     4569       on error undo _one-check, leave _one-check
     4570       on stop undo _one-check, leave _one-check
     4571       :
     4572         _buf_chk-gds:
     4573         FOR EACH buf_chk-gds WHERE buf_chk-gds.doc-code = X_chk-doc.doc-code
     4574         by buf_chk-gds.price-base
     4575         on error undo _one-check, LEAVE _one-check
     4576         on stop undo _one-check, leave _one-check
     4577         :
     4578           buf_chk-gds.out-code = ink-doc.inkas-code .
     4579           if buf_chk-gds.doc-qnty = 0 then do:
     4580             assign
     4581             GDS-AMOUNT = GDS-AMOUNT + 1
     4582             nf-gds-amount = nf-gds-amount  + 1 when (  lookup( string(X_chk-doc.chk-type), '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U )  >  0  )
     4583             .
     4584             NEXT _Buf_chk-gds.
     4585           end.
     4586            if X_chk-doc.chk-type <> integer('12':U) and X_chk-doc.office = "" then
     4587            do:
     4588               run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Чек &1 не имеет тип чека. Чек не будет закачан в продажу&2&3"                                    , X_chk-doc.doc-code                                               , chr(10)                                                    , return-value                                                     )                                       ) .
     4589               undo _one-check, leave _one-check.
     4590            end.
     4591           docs-to-reserv-gds = get-inc-sal(
     4592                                         input string(X_chk-doc.chk-type)
     4593                                       , input X_chk-doc.netto
     4594                                       , input no
     4595                                       , input entry(1, buf_chk-gds.line-type, chr(4))
     4596                                       , input string(BUF_CHK-GDS.WRITE-OFF-CODE)
     4597                                       , output v-add
     4598                                       , output office-to-reserv-gds
     4599                                       , output kind-to-reserv-gds
     4600                                       , output add-nf-gds-amount
     4601                                       ) no-error.
     4602           if X_chk-doc.chk-type = integer('17':U) then do:
     4603               for each buf_chk-pay where buf_chk-pay.doc-code = X_chk-doc.doc-code no-lock:
     4604                   find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = buf_chk-pay.pay-code
     4605                                                and buf_cash-pay-attr.curr-code = buf_chk-pay.curr-code
     4606                                                and buf_cash-pay-attr.attr-code = "dop-doc" no-lock no-error.
     4607                   if not available(buf_cash-pay-attr) then next.
     4608                   v-cash-pay-attr = buf_cash-pay-attr.attr-value.
     4609                   case entry(1, v-cash-pay-attr, ','):
     4610                       when 'vir':U then do:
     4611                           assign
     4612                           kind-to-reserv-gds = 'vir':U
     4613                           docs-to-reserv-gds = 1
     4614                           v-add = no
     4615                           office-TO-RESERV-GDS = 'т'.
     4616                       end.
     4617                       when 'none' then do:
     4618                           assign
     4619                           kind-to-reserv-gds = 'none'
     4620                           docs-to-reserv-gds = 0
     4621                           v-add = no
     4622                           office-TO-RESERV-GDS = 'т'.
     4623                           create buf_sale-doc.
     4624                           assign
     4625                           buf_sale-doc.inkas-code = ink-doc.inkas-code
     4626                           buf_sale-doc.storage =  'trn-doc':U
     4627                           buf_sale-doc.host-code = ink-doc.host-code
     4628                           buf_sale-doc.obj-type = ink-doc.obj-type
     4629                           buf_sale-doc.obj-code = ink-doc.obj-code
     4630                           buf_sale-doc.doc-kind  = 'none'
     4631                           buf_sale-doc.order = 0
     4632                           buf_sale-doc.chr-office = 'т'
     4633                           buf_sale-doc.doc-code = ''.
     4634                       end.
     4635                    end case.
     4636               end.
     4637           end.
     4638           assign
     4639           GDS-AMOUNT = GDS-AMOUNT + 1
     4640           nf-gds-amount = nf-gds-amount  + add-nf-gds-amount
     4641           .
     4642           assign
     4643           office-to-reserv-gds = (if v-add
     4644                                 then (office-to-reserv + (if kind-to-reserv-gds = '':u
     4645                                                         then '':u
     4646                                                         else chr(44)) +
     4647                                     office-to-reserv-gds)
     4648                                 else  office-to-reserv-gds)
     4649           kind-to-reserv-gds = (if v-add
     4650                                 then (kind-to-reserv + (if kind-to-reserv-gds = '':u
     4651                                                         then '':u
     4652                                                         else chr(44)) +
     4653                                     kind-to-reserv-gds)
     4654                               else  kind-to-reserv-gds)
     4655             docs-to-reserv-gds = (docs-to-reserv  + docs-to-reserv-gds) when v-add
     4656           .
     4657           FIND FIRST ub.bar-code WHERE ub.bar-code.b-code = buf_chk-gds.b-code NO-LOCK NO-ERROR.
     4658           release ub.goods.
     4659           if avail ub.bar-code then
     4660             FIND FIRST ub.goods WHERE
     4661                        ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK.
