     1491   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1492   procedure findtank:
     1493     define input  parameter p-obj-type     as character no-undo.
     1494     define input  parameter p-obj-code     as integer   no-undo.
     1495     define input  parameter p-pump-code    as integer   no-undo.
     1496     define input  parameter p-nozzle-code  as integer   no-undo .
     1497     define input  parameter p-from-pl-code as integer   no-undo .
     1498     define input  parameter p-gds-code     as integer   no-undo.
     1499     define output parameter p-pl-code      as integer   no-undo .
     1500     define variable v-pl-code            like ub.place.pl-code no-undo .
     1501     define variable v-dopstr             as character no-undo .
     1502     define buffer buf_place for ub.place.
     1503     define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     1504     define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     1505     define buffer buf_pl-gds for ub.pl-gds.
     1506     do
     1507     on error undo, return error return-value
     1508     :
     1509       assign
     1510         v-pl-code = 0
     1511         p-pl-code = ?
     1512       .
     1513       if p-from-pl-code <> ?
     1514         and p-from-pl-code <> 0
     1515       then do:
     1516         find first buf_pl-gds no-lock
     1517           where buf_pl-gds.obj-type  = p-obj-type
     1518             and buf_pl-gds.obj-code  = p-obj-code
     1519             and buf_pl-gds.pl-code   = p-from-pl-code
     1520             and buf_pl-gds.gds-code  = p-gds-code
     1521           no-error.
     1522         if available buf_pl-gds then do:
     1523           assign
     1524             v-pl-code = buf_pl-gds.pl-code
     1525           .
     1526         end.
     1527       end.
     1528       if v-pl-code <> 0
     1529         and p-nozzle-code <> ?
     1530         and p-nozzle-code <> 0
     1531       then do:
     1532         find first buf_pl-pump-nozzle no-lock
     1533           where buf_pl-pump-nozzle.obj-type    = p-obj-type
     1534             and buf_pl-pump-nozzle.obj-code    = p-obj-code
     1535             and buf_pl-pump-nozzle.pl-code     = v-pl-code
     1536             and buf_pl-pump-nozzle.pump-code   = p-pump-code
     1537             and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
     1538           no-error .
     1539         if not available buf_pl-pump-nozzle then do:
     1540           return.
     1541         end.
     1542       end.
     1543       if v-pl-code = 0 then do:
     1544         if p-nozzle-code = 0 then do:
     1545           find first buf_pl-gds-pump no-lock
     1546             where buf_pl-gds-pump.obj-type  = p-obj-type
     1547               and buf_pl-gds-pump.obj-code  = p-obj-code
     1548               and buf_pl-gds-pump.pump-code = p-pump-code
     1549               and buf_pl-gds-pump.gds-code  = p-gds-code
     1550               and buf_pl-gds-pump.status_   = 'тек':U
     1551             no-error.
     1552           if available buf_pl-gds-pump then do:
     1553             assign
     1554               v-pl-code = buf_pl-gds-pump.pl-code
     1555             .
     1556           end.
     1557         end.
     1558         else do:
     1559           _ppnz:
     1560           for each buf_pl-pump-nozzle no-lock
     1561             where buf_pl-pump-nozzle.obj-type = p-obj-type
     1562               and buf_pl-pump-nozzle.obj-code = p-obj-code
     1563               and buf_pl-pump-nozzle.pump-code = p-pump-code
     1564               and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
     1565             ,first buf_pl-gds-pump no-lock
     1566             where buf_pl-gds-pump.obj-type  = p-obj-type
     1567               and buf_pl-gds-pump.obj-code  = p-obj-code
     1568               and buf_pl-gds-pump.pump-code = p-pump-code
     1569               and buf_pl-gds-pump.gds-code  = p-gds-code
     1570               and buf_pl-gds-pump.status_   = 'тек':U
     1571               and buf_pl-gds-pump.pl-code   = buf_pl-pump-nozzle.pl-code
     1572           on error undo, return error return-value
     1573           :
     1574             assign
     1575               v-pl-code = buf_pl-pump-nozzle.pl-code
     1576             .
     1577             leave _ppnz.
     1578           end.
     1579         end.
     1580       end.
     1581       if v-pl-code <> 0 then do:
     1582         assign
     1583           p-pl-code = v-pl-code
     1584         .
     1585       end.
     1586     end.
     1587   end procedure.
     1588   procedure find-nzl:
     1589   define input  parameter p-obj-type   as character no-undo.
     1590   define input  parameter p-obj-code   as integer   no-undo.
     1591   define input  parameter p-pump-code  as integer   no-undo.
     1592   define input  parameter p-gds-code   as integer   no-undo.
     1593   define input  parameter p-pl-code    as integer no-undo .
     1594   define output parameter p-nozzle-code    as integer   no-undo.
     1595   define variable v-nozzle-code        like ub.nozzle.nozzle-code no-undo .
     1596   define variable v-pl-code            like ub.place.pl-code no-undo .
     1597   define variable v-pump-code          like ub.pump.pump-code no-undo .
     1598   define variable v-loc1-code          like ub.place.loc1 no-undo .
     1599   define variable v-dopstr             as character no-undo .
     1600   define buffer buf_place for ub.place.
     1601   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     1602   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     1603   define buffer buf_pl-gds for ub.pl-gds.
     1604   do on error undo, return error return-value :
     1605     v-pump-code = p-pump-code.
     1606     find first buf_pl-pump-nozzle no-lock where
     1607                   buf_pl-pump-nozzle.obj-type = p-obj-type
     1608               and buf_pl-pump-nozzle.obj-code = p-obj-code
     1609               and buf_pl-pump-nozzle.pump-code = p-pump-code
     1610               and buf_pl-pump-nozzle.pl-code = p-pl-code no-error.
     1611     if not available buf_pl-pump-nozzle then do:
     1612       assign
     1613       p-nozzle-code = ?.
     1614       return .
     1615     end.
     1616     assign
     1617     p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
     1618     return.
     1619     .
     1620   end.
     1621   end procedure.
     1622   procedure find-nzl-without-pl:
     1623   define input  parameter p-obj-type   as character no-undo.
     1624   define input  parameter p-obj-code   as integer   no-undo.
     1625   define input  parameter p-pump-code  as integer   no-undo.
     1626   define input  parameter p-gds-code   as integer   no-undo.
     1627   define output parameter p-nozzle-code    as integer   no-undo.
     1628   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     1629   define buffer buf_pl-gds for ub.pl-gds.
     1630   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     1631   do on error undo, return error return-value :
     1632     for each buf_pl-gds-pump no-lock where
     1633               buf_pl-gds-pump.obj-type  = p-obj-type
     1634           and buf_pl-gds-pump.obj-code  = p-obj-code
     1635           and buf_pl-gds-pump.pump-code = p-pump-code
     1636           and buf_pl-gds-pump.gds-code  = p-gds-code
     1637           and buf_pl-gds-pump.status_   = 'тек':U,
     1638         first buf_pl-gds no-lock where
     1639                   buf_pl-gds.obj-type = p-obj-type
     1640               AND buf_pl-gds.obj-code = p-obj-code
     1641               AND buf_pl-gds.pl-code = buf_pl-gds-pump.pl-code
     1642               AND buf_pl-gds.gds-code = p-gds-code
     1643               AND buf_pl-gds.status_ = 'тек':U,
     1644        first buf_pl-pump-nozzle no-lock where
     1645                 buf_pl-pump-nozzle.obj-type = p-obj-type
     1646             and buf_pl-pump-nozzle.obj-code = p-obj-code
     1647             and buf_pl-pump-nozzle.pl-code = buf_pl-gds.pl-code
     1648             and buf_pl-pump-nozzle.pump-code = p-pump-code:
     1649       assign
     1650       p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
     1651       return .
     1652     end.
     1653     assign
     1654     p-nozzle-code = ?.
     1655     return.
     1656     .
     1657   end.
     1658   end procedure.
     1659   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
