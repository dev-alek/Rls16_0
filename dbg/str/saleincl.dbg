      535   FUNCTION set-inkas-PS returns character(    input p-ps as character,
      536                                               input p-chk-amount as integer,
      537                                               input p-gds-amount as integer,
      538                                               input p-line-out as integer,
      539                                               input p-dtl-out as integer,
      540                                               input p-line-ret as integer,
      541                                               input p-dtl-ret as integer,
      542                                               input p-nf-chk-amount as integer,
      543                                               input p-nf-gds-amount as integer,
      544                                               input p-ps-where-rus as character
      545                                               ):
      546   define variable v-ps as character no-undo .
      547   define variable v-other as character no-undo .
      548   v-other = p-ps.
      549   entry(1, v-other, "@") = ''.
      550   v-other = trim(v-other, "@").
      551   v-PS = substitute('Кол-во_чеков &2&1строк_чеков &3&1товаров_расход &4&1признаков_расход &5&1товаров_возврат &6&1признаков_возврат &7&1'
      552                       , chr(4)
      553                       , p-chk-amount
      554                       , p-gds-amount
      555                       , p-line-out
      556                       , p-dtl-out
      557                       , p-line-ret
      558                       , p-dtl-ret).
      559   v-ps = v-ps +  substitute("без_докум_чеков &1&2без_докум_строк_чеков &3&2&4@&5"
      560                               , p-nf-chk-amount
      561                               , chr(4)
      562                               , p-nf-gds-amount
      563                               , p-ps-where-rus
      564                               , v-other)
      565                       .
      566   return v-ps.
      567   END FUNCTION.
      568   FUNCTION set-inkas-PS-simple returns character(
      569                                               input p-chk-amount as integer,
      570                                               input p-gds-amount as integer,
      571                                               input p-line-out as integer,
      572                                               input p-dtl-out as integer,
      573                                               input p-line-ret as integer,
      574                                               input p-dtl-ret as integer,
      575                                               input p-nf-chk-amount as integer,
      576                                               input p-nf-gds-amount as integer
      577                                               ):
      578   define variable v-ps as character no-undo .
      579   define variable v-str1 as character no-undo .
      580   assign
      581     v-ps = fill( chr(32) +  chr(4), 9).
      582     v-str1 = ENTRY(1, v-PS, chr(4)).
      583     entry(2, v-str1, chr(32))  = string(p-chk-amount).
      584     ENTRY(1, v-PS, chr(4)) = v-str1.
      585     v-str1 = ENTRY(2, v-PS, chr(4)).
      586     entry(2, v-str1, chr(32))  = string(p-gds-amount).
      587     ENTRY(2, v-PS, chr(4)) = v-str1.
      588     v-str1 = ENTRY(3, v-PS, chr(4)).
      589     entry(2, v-str1, chr(32))  = string(p-line-out).
      590     ENTRY(3, v-PS, chr(4)) = v-str1.
      591     v-str1 = ENTRY(4, v-PS, chr(4)).
      592     entry(2, v-str1, chr(32))  = string(p-dtl-out).
      593     ENTRY(4, v-PS, chr(4)) = v-str1.
      594     v-str1 = ENTRY(5, v-PS, chr(4)).
      595     entry(2, v-str1, chr(32))  = string(p-line-ret).
      596     ENTRY(5, v-PS, chr(4)) = v-str1.
      597     v-str1 = ENTRY(6, v-PS, chr(4)).
      598     entry(2, v-str1, chr(32))  = string(p-dtl-ret).
      599     ENTRY(5, v-PS, chr(4)) = v-str1.
      600     v-str1 = ENTRY(7, v-PS, chr(4)).
      601     entry(2, v-str1, chr(32))  = string(p-nf-chk-amount).
      602     ENTRY(5, v-PS, chr(4)) = v-str1.
      603     v-str1 = ENTRY(8, v-PS, chr(4)).
      604     entry(2, v-str1, chr(32))  = string(p-nf-gds-amount).
      605     ENTRY(5, v-PS, chr(4)) = v-str1.
      606   return v-ps.
      607   END FUNCTION.
      608   FUNCTION get-inkas-nf-PS-simple returns logical (
      609                                                input p-ps as character
      610                                               ,output p-gds-amount as integer
      611                                               ,output p-nf-gds-amount as integer
      612                                               ):
      613   if num-entries(p-ps, chr(4)) >= 8 then do:
      614     assign
      615     p-gds-amount = integer(entry(2, ENTRY(2, p-PS, chr(4)), chr(32)))
      616     p-nf-gds-amount = integer(entry(2, ENTRY(8, p-PS, chr(4)), chr(32)))
      617     no-error .
      618   end.
      619   return not error-status:error .
      620   END FUNCTION.
      621   PROCEDURE get-inkas-PS:
      622   define parameter buffer buf_inkas for ub.inkas.
      623   define output parameter p-chk-amount as integer no-undo .
      624   define output parameter p-gds-amount as integer no-undo .
      625   define output parameter p-line-out as integer no-undo .
      626   define output parameter p-dtl-out as integer no-undo .
      627   define output parameter p-line-ret as integer no-undo .
      628   define output parameter p-dtl-ret as integer no-undo .
      629   define output parameter p-nf-chk-amount as integer no-undo .
      630   define output parameter p-nf-gds-amount as integer no-undo .
      631   define output parameter p-ps-where-rus as character no-undo .
      632   define variable v-gds-amount as integer no-undo .
      633   define variable v-nf-gds-amount as integer no-undo .
      634   define buffer buf_sale-doc for ub.sale-doc.
      635   for each buf_sale-doc no-lock where
      636           buf_sale-doc.inkas-code = buf_inkas.inkas-code
      637       and buf_sale-doc.order > 0:
      638     assign
      639     p-gds-amount = p-gds-amount + (if buf_sale-doc.in-inkas = yes
      640                                    or buf_sale-doc.doc-kind = 'trf':U
      641                                    then buf_sale-doc.gds-amount
      642                                    else 0)
      643     p-line-out = p-line-out  + (if buf_sale-doc.in-inkas = yes
      644                                 and buf_sale-doc.dir = 1
      645                                 then buf_sale-doc.tot-lines
      646                                 else 0)
      647     p-dtl-out = p-dtl-out + (if buf_sale-doc.in-inkas = yes
      648                             and buf_sale-doc.dir = 1
      649                             then buf_sale-doc.tot-dtl
      650                             else 0)
      651     p-line-ret = p-line-ret  + (if buf_sale-doc.in-inkas = yes
      652                                 and buf_sale-doc.dir = -1
      653                                 then buf_sale-doc.tot-lines
      654                                 else 0)
      655     p-dtl-ret = p-dtl-ret + (if buf_sale-doc.in-inkas = yes
      656                              and buf_sale-doc.dir = -1
      657                             then buf_sale-doc.tot-dtl
      658                             else 0)
      659     .
      660   end.
      661   if get-inkas-nf-PS-simple( input buf_inkas.ps
      662                             ,output v-gds-amount
      663                             ,output v-nf-gds-amount) then do:
      664     assign
      665     p-gds-amount = v-gds-amount
      666     p-nf-gds-amount = v-nf-gds-amount
      667     .
      668   end.
      669   assign
      670   p-ps-where-rus = buf_inkas.sale-filter-rus
      671   p-nf-chk-amount = buf_inkas.num-chk-nf
      672   p-chk-amount = buf_inkas.num-chk
      673   .
      674   END PROCEDURE.
      675   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
      677   define variable v-ps as character no-undo .
      678   if available buf_sale-doc then
      679   assign
      680   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
      681                       , chr(4)
      682                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
      683                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      684                       , buf_sale-doc.chk-amount
      685                       , buf_sale-doc.gds-amount
      686                       , buf_sale-doc.tot-lines
      687                       , buf_sale-doc.tot-dtl
      688                       ).
      689   else  do:
      690   assign
      691   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
      692                       , chr(4)
      693                       , '':U
      694                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      695                       , 0
      696                       , 0
      697                       , 0
      698                       , 0
      699                       ).
      700   end.
      701   return v-ps.
      702   END FUNCTION.
      703   FUNCTION get-sale-doc-kind returns character (
      704                                                input p-doc-kind as character
      705                                              , input p-ext-doc-type as character
      706                                              , output p-order as integer
      707                                              , output p-msign as integer
      708                                              , output p-main as logical
      709                                              , output p-in-inkas as logical
      710                                              , output p-dir_ as integer
      711                                              ):
      712   define variable v-doc-kind as character no-undo.
      713   define variable v-type as character no-undo .
      714   define variable v-value as character no-undo .
      715   CASE p-doc-kind:
      716     when 'es':U then do:
      717       assign
      718       p-order = 100
      719       p-msign = 1
      720       p-main = yes
      721       p-in-inkas = yes
      722       p-dir_ = 1
      723       .
      724       return p-ext-doc-type.
      725     end.
      726     when  'rs':U then do:
      727       assign
      728       p-order = 200
      729       p-msign = - 1
      730       p-main = no
      731       p-in-inkas = yes
      732       p-dir_ = - 1
      733       .
      734       return p-ext-doc-type.
      735     end.
      736     when 'rwo':U then do:
      737       assign
      738       p-msign = - 1
      739       p-main = no
      740       p-in-inkas = no
      741       p-order = 300
      742       p-dir_ = 1
      743       .
      744       return 'rwo':U.
      745     end.
      746     when 'trf':U then do:
      747       assign
      748       p-msign = 1
      749       p-main = no
      750       p-in-inkas = no
      751       p-order = 400
      752       p-dir_ = 1
      753       .
      754       return 'trf':U.
      755     end.
      756     when 'swo':U then do:
      757      assign
      758      p-msign = 1
      759      p-main = no
      760      p-in-inkas = no
      761      p-order =  500
      762      p-dir_ = 1
      763      .
      764      return 'swo':U.
      765    end.
      766    when 'vir':U then do:
      767      assign
      768      p-msign = 1
      769      p-main = no
      770      p-in-inkas = no
      771      p-order = 600
      772      p-dir_ = 1
      773      .
      774      return 'vir':U.
      775    end.
      776    when 'itr':U then do:
      777      assign
      778      p-msign = 1
      779      p-main = no
      780      p-in-inkas = no
      781      p-order = -1
      782      p-dir_ = -1
      783      .
      784     return 'itr':U.
      785    end.
      786    when 'ngs':U then do:
      787      assign
      788      p-msign = 1
      789      p-main = no
      790      p-in-inkas = no
      791      p-order = 700
      792      p-dir_ = 1
      793      .
      794      return 'ngs':U.
      795    end.
      796    when 'rgs':U then do:
      797      assign
      798      p-msign = -1
      799      p-main = no
      800      p-in-inkas = no
      801      p-order = 701
      802      p-dir_ = -1
      803      .
      804      return 'rgs':U.
      805    end.
      806    otherwise do:
      807       assign
      808       p-msign = 1
      809       p-main = no
      810       p-in-inkas = no
      811       p-order = -1.
      812       return p-ext-doc-type.
      813     end.
      814   END CASE.
      815   END FUNCTION.
      816   procedure saledoc-create :
      817   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
      818   define input parameter p-host-code like ub.sysconf.host-code no-undo .
      819   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
      820   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
      821   define input parameter p-doc-kind as character no-undo .
      822   define input parameter p-office as character no-undo .
      823   define input parameter p-tpsidoc as logical no-undo .
      824   define input parameter p-alias-type-price as character no-undo .
      825   define input parameter p-price-obj-type as character no-undo .
      826   define input parameter p-price-obj-code as integer no-undo .
      827   define parameter buffer buf_trn-doc for ub.trn-doc.
      828   define variable v-order as integer no-undo.
      829   define variable v-main as logical no-undo .
      830   define variable v-in-inkas as logical no-undo .
      831   define variable v-msign as integer no-undo .
      832   define variable v-dir_ as integer no-undo .
      833   define variable v-trn-doc-code as character no-undo .
      834   define buffer buf_sale-doc for ub.sale-doc.
      835   main-block:
      836   do
      837   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      838   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      839   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      840   :
      841      if available buf_trn-doc then do:
      842        v-trn-doc-code = buf_trn-doc.doc-code.
      843      end.
      844      find first buf_sale-doc where
      845               buf_sale-doc.inkas-code = p-inkas-code
      846           and buf_sale-doc.doc-kind = p-doc-kind
      847           and buf_sale-doc.chr-office = p-office
      848           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
      849           no-error .
      850      if not available buf_sale-doc  then do:
      851         create buf_sale-doc.
      852         assign
      853         buf_sale-doc.inkas-code = p-inkas-code
      854         buf_sale-doc.storage =  'trn-doc':U
      855         buf_sale-doc.host-code = p-host-code
      856         buf_sale-doc.obj-type = p-obj-type
      857         buf_sale-doc.obj-code = p-obj-code
      858         buf_sale-doc.doc-kind  = p-doc-kind
      859         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
      860         buf_sale-doc.chr-office = p-office
      861         buf_sale-doc.doc-code = v-trn-doc-code
      862         .
      863      end.
      864      if available buf_trn-doc then
      865      buffer-copy buf_trn-doc
      866      to buf_sale-doc
      867      .
      868     assign
      869     buf_sale-doc.doc-kind = get-sale-doc-kind (
      870                                                input p-doc-kind
      871                                               ,input buf_sale-doc.ext-doc-type
      872                                               ,output v-order
      873                                               ,output v-msign
      874                                               ,output v-main
      875                                               ,output v-in-inkas
      876                                               ,output v-dir_).
      877     assign
      878     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
      879     buf_sale-doc.main-doc = v-main
      880     buf_sale-doc.in-inkas = v-in-inkas
      881     buf_sale-doc.msign = v-msign
      882     buf_sale-doc.dir = v-dir_
      883     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
      884     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
      885     buf_sale-doc.poss-wro-codes = '':U
      886     buf_sale-doc.chr-office = p-office
      887     buf_sale-doc.tpsidoc = p-tpsidoc
      888     buf_sale-doc.alias-type-price = p-alias-type-price
      889     buf_sale-doc.price-obj-type = (if p-tpsidoc
      890                                    then p-price-obj-type
      891                                    else '':U)
      892     buf_sale-doc.price-obj-code = (if p-tpsidoc
      893                                    then p-price-obj-code
      894                                    else 0)
      895     .
      896     assign
      897     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
      898     no-error.
      899   end.
      900   END.
      901   procedure fbr-saledoc-create :
      902   define input parameter p-inkas-code as character no-undo .
      903   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
      904   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
      905   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
      906   define buffer buf_fbr-doc for ub.fbr-doc.
      907   define buffer buf_trn-doc for ub.trn-doc.
      908   define buffer buf_sale-doc for ub.sale-doc.
      909   define buffer buf2_sale-doc for ub.sale-doc.
      910   define buffer buf2_trn-doc for ub.trn-doc.
      911   define buffer buf_doc-line for ub.doc-line.
      912   define buffer buf_gds-dtl for ub.gds-dtl.
      913   define buffer buf_chk-gds for ub.chk-gds.
      914   define buffer buf_chk-doc for ub.chk-doc.
      915   do
      916   on error undo, return error
      917   :
      918     for each buf_fbr-doc no-lock where
      919           buf_fbr-doc.out-code = p-inkas-code:
      920       for each buf_trn-doc no-lock where
      921             buf_trn-doc.out-code = buf_fbr-doc.doc-code
      922       by buf_trn-doc.fact-order
      923       on error undo, return error:
      924         if buf_trn-doc.ext-doc-type = 'em':U
      925         or buf_trn-doc.ext-doc-type = 'im':U
      926         or buf_trn-doc.ext-doc-type = 'wm':U
      927         or buf_trn-doc.ext-doc-type = 'ev':U
      928         or buf_trn-doc.ext-doc-type = 'iv':U
      929         then do:
      930           find first buf_sale-doc where
      931                   buf_sale-doc.inkas-code = p-inkas-code
      932               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
      933               AND buf_sale-doc.storage  = 'trn-doc':U
      934                   no-error .
      935           if not available buf_sale-doc then do:
      936           create buf_sale-doc.                                                                                             buffer-copy buf_trn-doc                                                                                             to buf_sale-doc.                                                                                                assign                                                                                                                  buf_sale-doc.storage  =  'trn-doc':U                                                                          buf_sale-doc.doc-kind = buf_trn-doc.ext-doc-type                                                                buf_sale-doc.order =  - 1                                                                                          buf_sale-doc.main-doc = no                                                                                             buf_sale-doc.in-inkas = no                                                                                         buf_sale-doc.fbrsale = yes                                                                                         buf_sale-doc.msign = 1                                                                                             buf_sale-doc.filled   = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0                       buf_sale-doc.doc-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf_sale-doc.doc-qnty)                                                          buf_sale-doc.fact-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf_sale-doc.fact-qnty)                                                        buf_sale-doc.inkas-code = p-inkas-code.
      937           end.
      938           if buf_trn-doc.ext-doc-type = 'im':U then do:
      939             assign
      940             v-pri-prvo-doc-qnty = buf_trn-doc.doc-qnty
      941             v-pri-prvo-fact-qnty = buf_trn-doc.fact-qnty
      942             v-pri-prvo-tot-lines = buf_trn-doc.tot-lines
      943             .
      944           end.
      945           for each buf2_trn-doc no-lock where
      946                   buf2_trn-doc.out-code = buf_sale-doc.doc-code:
      947             find first buf2_sale-doc where
      948                     buf2_sale-doc.inkas-code = p-inkas-code
      949                 and buf2_sale-doc.doc-code = buf2_trn-doc.doc-code
      950                 AND buf2_sale-doc.storage = 'trn-doc':U no-error .
      951             if not available buf2_sale-doc then do:
      952               create buf2_sale-doc.                                                                                             buffer-copy buf2_trn-doc                                                                                             to buf2_sale-doc.                                                                                                assign                                                                                                                  buf2_sale-doc.storage  =  'trn-doc':U                                                                          buf2_sale-doc.doc-kind = buf2_trn-doc.ext-doc-type                                                                buf2_sale-doc.order =  - 1                                                                                          buf2_sale-doc.main-doc = no                                                                                             buf2_sale-doc.in-inkas = no                                                                                         buf2_sale-doc.fbrsale = yes                                                                                         buf2_sale-doc.msign = 1                                                                                             buf2_sale-doc.filled   = buf2_sale-doc.fact-qnty <> 0 or buf2_sale-doc.tot-lines <> 0                       buf2_sale-doc.doc-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf2_sale-doc.doc-qnty)                                                          buf2_sale-doc.fact-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf2_sale-doc.fact-qnty)                                                        buf2_sale-doc.inkas-code = p-inkas-code.
      953             end.
      954           end.
      955         end.
      956       end.
      957       find first buf_sale-doc where
      958                 buf_sale-doc.inkas-code = p-inkas-code
      959             AND buf_sale-doc.storage = 'fbr-doc':U
      960             AND buf_sale-doc.doc-code = buf_fbr-doc.doc-code no-error .
      961       if not available buf_sale-doc then do:
      962         create buf_sale-doc.
      963         assign
      964         buf_sale-doc.storage       =  'fbr-doc':U
      965         buf_sale-doc.doc-type      = 'производство':U
      966         buf_sale-doc.doc-code      = buf_fbr-doc.doc-code
      967         buf_sale-doc.ext-doc-type  = 'производство':U
      968         buf_sale-doc.doc-kind      = 'производство':U
      969         buf_sale-doc.obj-type      = buf_fbr-doc.obj-type
      970         buf_sale-doc.obj-code      = buf_fbr-doc.obj-code
      971         buf_sale-doc.cli-type      = buf_fbr-doc.obj-type
      972         buf_sale-doc.cli-code      = buf_fbr-doc.obj-code
      973         buf_sale-doc.doc-qnty      = v-pri-prvo-doc-qnty
      974         buf_sale-doc.fact-qnty     = v-pri-prvo-fact-qnty
      975         buf_sale-doc.tot-lines     = v-pri-prvo-tot-lines
      976         buf_sale-doc.tot-dtl       = v-pri-prvo-tot-lines
      977         buf_sale-doc.fbrsale       = yes
      978         buf_sale-doc.inkas-code    = p-inkas-code
      979         .
      980       end.
      981     end.
      982   end.
      983   end procedure.
      984   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      985   define SHARED temp-table tt0-info no-undo
      986   field doc-code   like ub.trn-doc.doc-code
      987   field artic      like ub.doc-line.artic
      988   field prod-type  like ub.doc-line.prod-type
      989   field prod-code  like ub.doc-line.prod-code
      990   field prt-code  like ub.gds-dtl.prt-code
      991   field obj-type   like ub.doc-line.obj-type
      992   field obj-code   like ub.doc-line.obj-code
      993   field error-message as character
      994   field a-to-res as decimal
      995   field was-res as decimal
      996   field to-res as decimal
      997   field is-res as decimal
      998   field o-was-res as decimal
      999   field o-to-res as decimal
     1000   field o-is-res as decimal
     1001   index pi is unique primary
     1002   obj-type
     1003   obj-code
     1004   artic
     1005   prod-type
     1006   prod-code
     1007   index iartic
     1008   artic
     1009   prod-type
     1010   prod-code
     1011   .
     1012   define SHARED temp-table tt0-doc-line no-undo like lib-trn_ret-line.
     1013   define SHARED temp-table tt0-gds-dtl  no-undo like ub.gds-dtl.
     1014   define SHARED temp-table tt0-parts    no-undo like ub.parts.
     1015   define SHARED temp-table temp-tpsi-clients  no-undo like ub.clients.
     1016   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     1017   define variable v-ps as character no-undo .
     1018   assign
     1019   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
     1020                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
     1021                     , buf_sale-doc.out-code
     1022                     , buf_sale-doc.obj-type
     1023                     , buf_sale-doc.obj-code
     1024                     , chr(4)
     1025                     , buf_sale-doc.tot-lines
     1026                     , buf_sale-doc.tot-dtl
     1027                     ).
     1028   return v-Ps.
     1029   END FUNCTION.
     1030   procedure create-tt0-doc-line-gds-dtl :
     1031   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
     1032   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
     1033   define input parameter p-ext-doc-type        as character no-undo .
     1034   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
     1035   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
     1036   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
     1037   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
     1038   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
     1039   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
     1040   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
     1041   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
     1042   define parameter buffer b-doc-line           for ub.doc-line.
     1043   define parameter buffer b-gds-dtl            for ub.gds-dtl.
     1044   define parameter buffer buf_sale-doc for ub.sale-doc.
     1045   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
     1046   define buffer other_doc-line for ub.doc-line.
     1047   define buffer other_gds-dtl for ub.gds-dtl.
     1048     do
     1049     on error undo, return error return-value
     1050     :
     1051       find first tt0-doc-line where
     1052                 tt0-doc-line.obj-type = p-proprietor-obj-type
     1053             AND tt0-doc-line.obj-code = p-proprietor-obj-code
     1054             AND tt0-doc-line.prod-type = p-prod-type
     1055             AND tt0-doc-line.prod-code = p-prod-code
     1056             AND tt0-doc-line.artic     = p-artic
     1057             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
     1058             AND tt0-doc-line.status_      = 'нередакт':U no-error .
     1059       if not available tt0-doc-line then do:
     1060         create tt0-doc-line.
     1061         buffer-copy b-doc-line
     1062         except
     1063         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
     1064         to tt0-doc-line
     1065         assign
     1066         tt0-doc-line.status_ = 'нередакт':U
     1067         tt0-doc-line.ext-doc-type = p-ext-doc-type
     1068         tt0-doc-line.obj-type = p-proprietor-obj-type
     1069         tt0-doc-line.obj-code = p-proprietor-obj-code
     1070         tt0-doc-line.doc-code = p-doc-code
     1071         .
     1072       end.
     1073       if p-doc-code <> "":U then do:
     1074         find first other_doc-line no-lock where
     1075                 other_doc-line.doc-code = p-doc-code
     1076             AND  other_doc-line.artic    = p-artic
     1077             AND  other_doc-line.prod-type = p-prod-type
     1078             AND  other_doc-line.prod-code = p-prod-code no-error .
     1079         if available other_doc-line then do:
     1080           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
     1081           assign
     1082           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
     1083           .
     1084         end.
     1085         else do:
     1086           assign
     1087           tt0-doc-line.doc-code = '':U
     1088           .
     1089         end.
     1090       end.
     1091       find first tt0-gds-dtl where
     1092               tt0-gds-dtl.obj-type = p-proprietor-obj-type
     1093           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
     1094           AND tt0-gds-dtl.prod-type = p-prod-type
     1095           AND tt0-gds-dtl.prod-code = p-prod-code
     1096           AND tt0-gds-dtl.artic     = p-artic
     1097           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
     1098       if not available tt0-gds-dtl then do:
     1099         create tt0-gds-dtl.
     1100         buffer-copy b-gds-dtl
     1101         except
     1102         obj-type obj-code doc-code doc-qnty fact-qnty
     1103         to tt0-gds-dtl
     1104         assign
     1105         tt0-gds-dtl.obj-type = p-proprietor-obj-type
     1106         tt0-gds-dtl.obj-code = p-proprietor-obj-code
     1107         tt0-gds-dtl.doc-code = p-doc-code
     1108         .
     1109       end.
     1110       if p-doc-code <> "":U then do:
     1111           find first other_gds-dtl no-lock where
     1112                   other_gds-dtl.doc-code = p-doc-code
     1113               AND  other_gds-dtl.artic    = p-artic
     1114               AND  other_gds-dtl.prod-type    = p-prod-type
     1115               AND  other_gds-dtl.prod-code    = p-prod-code
     1116               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
     1117           if available other_gds-dtl then do:
     1118             assign
     1119             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
     1120             .
     1121           end.
     1122           else do:
     1123             assign
     1124             tt0-gds-dtl.doc-code = '':U
     1125             .
     1126           end.
     1127       end.
     1128       assign
     1129       old-qnty = tt0-gds-dtl.doc-qnty
     1130       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
     1131       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
     1132       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
     1133       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
     1134       .
     1135     end.
     1136   end procedure.
     1137   procedure fill-tt-tpsi-table :
     1138   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
     1139   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
     1140   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
     1141   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
     1142   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
     1143   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
     1144   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
     1145   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
     1146   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
     1147   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
     1148   define buffer buf_goods for ub.goods.
     1149   define buffer buf_doc-line for ub.doc-line.
     1150   define buffer buf_gds-dtl for ub.gds-dtl.
     1151   define buffer buf_sale-doc for ub.sale-doc.
     1152     do
     1153     on error undo, return error
     1154     :
     1155       _doc-line:
     1156       for each buf_Doc-line no-lock where
     1157             buf_doc-line.doc-code = p-doc-code,
     1158         first buf_goods no-lock where
     1159             buf_goods.artic = buf_doc-line.artic
     1160        AND  buf_goods.prod-type  = buf_doc-line.prod-type
     1161        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
     1162           each buf_gds-dtl no-lock where
     1163             buf_gds-dtl.doc-code = buf_doc-line.doc-code
     1164         AND  buf_gds-dtl.artic    = buf_doc-line.artic
     1165         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1166         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
     1167         assign
     1168         v-ext-doc-type = "":U.
     1169         run tpsi-preselect-gds-proprietor in this-procedure (
     1170                                                     input buf_goods.gds-code
     1171                                                   ,input g#db-num
     1172                                                   ,output v-proprietor-host-code
     1173                                                   ,output v-proprietor-obj-type
     1174                                                   ,output v-proprietor-obj-code ) no-error .
     1175         if v-proprietor-host-code = p-host-code then do:
     1176           assign
     1177           v-ext-doc-type = 'ev':U .
     1178         end.
     1179         else do:
     1180           assign
     1181           v-ext-doc-type =  'ee':U .
     1182         end.
     1183         if  (v-proprietor-obj-type = p-obj-type
     1184         AND v-proprietor-obj-code = p-obj-code)
     1185         OR (v-proprietor-obj-type = "":U
     1186         AND v-proprietor-obj-code = 0)
     1187         OR v-proprietor-obj-code = ?
     1188         then next _doc-line.
     1189         find first buf_sale-doc no-lock where
     1190                   buf_sale-doc.inkas-code = p-doc-code
     1191              AND buf_sale-doc.obj-type = v-proprietor-obj-type
     1192              AND buf_sale-doc.obj-code = v-proprietor-obj-code
     1193              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
     1194              no-error .
     1195         run create-tt0-doc-line-gds-dtl  in this-procedure (
     1196                                                              input v-proprietor-obj-type
     1197                                                             ,input v-proprietor-obj-code
     1198                                                             ,input v-ext-doc-type
     1199                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
     1200                                                             ,input buf_doc-line.artic
     1201                                                             ,input buf_Doc-line.prod-type
     1202                                                             ,input buf_doc-line.prod-code
     1203                                                             ,input buf_gds-dtl.prt-code
     1204                                                             ,input 0
     1205                                                             ,output v-was-gds-dtl-fact-qnty
     1206                                                             ,output v-gds-dtl-fact-qnty
     1207                                                             ,buffer buf_doc-line
     1208                                                             ,buffer buf_gds-dtl
     1209                                                             ,buffer buf_sale-doc
     1210                                                           ).
     1211       end.
     1212     end.
     1213   end procedure.
     1214   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1215   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1216   procedure get-alias-type-price-obj :
     1217   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1218   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1219   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1220   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
     1221   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
     1222   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
     1223   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
     1224   define output parameter p-alias-type-price as character no-undo .
     1225   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
     1226   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
     1227   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
     1228   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
     1229   define variable v-mediat-objf               as character no-undo .
     1230   define variable v-param-type as character no-undo .
     1231   define variable v-value-character as character no-undo .
     1232   define variable v-value-date as date no-undo .
     1233   define variable v-value-decimal as decimal no-undo .
     1234   define variable v-value-integer as INTEGER no-undo .
     1235   define variable v-value-logical AS LOGICAL no-undo .
     1236   define variable v-tth as handle no-undo .
     1237   assign
     1238   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1239   define buffer buf_trn-doc for ub.trn-doc.
     1240     _main:
     1241     do
     1242     on error undo, return error return-value
     1243     :
     1244       run adm/shattri.p (
     1245         input "get":U
     1246         ,input  p-prop-obj-type
     1247         ,input  p-prop-obj-code
     1248         ,input  'alias-tpsi':U
     1249         ,input  '':U
     1250         ,output v-value-character
     1251         ,output v-value-date
     1252         ,output v-value-decimal
     1253         ,output v-value-integer
     1254         ,output v-value-logical
     1255         ,output v-param-type
     1256         ,INPUT-OUTPUT table-handle v-tth
     1257         ) no-error .
     1258       if error-status:error
     1259       then do:
     1260         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1261                                 , p-prop-obj-type
     1262                                 , p-prop-obj-code).
     1263       end.
     1264       find first thbjattr_thbj-attr where
     1265                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1266             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1267             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1268             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
     1269       if not available thbjattr_thbj-attr
     1270       or thbjattr_thbj-attr.property-value-integer = 0 then do:
     1271         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1272                                 , p-prop-obj-type
     1273                                 , p-prop-obj-code).
     1274       end.
     1275       assign
     1276       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
     1277       if p-prop-host-code = p-host-code
     1278       and (p-alias-type-price = '':U
     1279       or   p-alias-type-price <> '5':U)
     1280       then  do:
     1281         assign
     1282         p-ext-doc-type = 'ev':U
     1283         p-price-obj-type = p-obj-type
     1284         p-price-obj-code = p-obj-code
     1285         p-alias-type-price = '3':U
     1286         .
     1287       end.
     1288       else do:
     1289         if p-prop-host-code = p-host-code  then do:
     1290           assign
     1291           p-ext-doc-type = 'ev':U
     1292           p-price-obj-type = p-obj-type
     1293           p-price-obj-code = p-obj-code
     1294           .
     1295         end.
     1296         else do:
     1297           assign
     1298           p-ext-doc-type = 'ee':U.
     1299           assign
     1300           v-mediat-obj-type = "":U
     1301           v-mediat-obj-code = 0
     1302           v-mediat-objf = "":U
     1303           .
     1304           if p-alias-type-price = '4':U then do:
     1305             find first thbjattr_thbj-attr where
     1306                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1307                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1308                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1309                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
     1310             if not available thbjattr_thbj-attr
     1311             or thbjattr_thbj-attr.property-value-character = "":U then do:
     1312               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
     1313                                       , p-prop-obj-type
     1314                                       , p-prop-obj-code).
     1315             end.
     1316             assign
     1317             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
     1318             v-mediat-obj-type = entry(1, v-mediat-objf)
     1319             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
     1320             no-error
     1321             .
     1322             if error-status:error then do:
     1323               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
     1324                                       , p-prop-obj-type
     1325                                       , p-prop-obj-code).
     1326             end.
     1327           end.
     1328           CASE p-alias-type-price:
     1329             when '1':U then do:
     1330               assign
     1331               p-price-obj-type = p-prop-obj-type
     1332               p-price-obj-code = p-prop-obj-code
     1333               .
     1334             end.
     1335             when '2':U then do:
     1336               assign
     1337               p-price-obj-type = p-prop-obj-type
     1338               p-price-obj-code = p-prop-obj-code
     1339               .
     1340             end.
     1341             when '3':U
     1342             or
     1343             when '5':U
     1344             then do:
     1345               assign
     1346               p-price-obj-type = p-obj-type
     1347               p-price-obj-code = p-obj-code
     1348               .
     1349             end.
     1350             when '4':U then do:
     1351               assign
     1352               p-price-obj-type = v-mediat-obj-type
     1353               p-price-obj-code = v-mediat-obj-code
     1354               .
     1355             end.
     1356           END CASE.
     1357         end.
     1358       end.
     1359     end.
     1360   end procedure.
     1361   procedure write-tt0-info:
     1362   define input parameter p-artic as character no-undo .
     1363   define input parameter p-prod-type as character no-undo .
     1364   define input parameter p-prod-code as integer no-undo .
     1365   define input parameter p-prt-code as integer no-undo .
     1366   define input parameter p-obj-type as character no-undo .
     1367   define input parameter p-obj-code as integer no-undo .
     1368   define input parameter p-doc-code as character no-undo .
     1369   define input parameter p-from-tpsi as logical no-undo .
     1370   define input parameter p-all-qnty as decimal no-undo .
     1371   define input parameter p-was-res as decimal no-undo .
     1372   define input parameter p-to-res as decimal no-undo .
     1373   define input parameter p-is-res as decimal no-undo .
     1374   define input parameter p-o-was-res as decimal no-undo .
     1375   define input parameter p-o-to-res as decimal no-undo .
     1376   define input parameter p-o-is-res as decimal no-undo .
     1377   define input parameter p-mess   as character no-undo .
     1378   define buffer buf_tt0-info for tt0-info.
     1379     do
     1380     on error undo, return error return-value
     1381     :
     1382       find first buf_tt0-info where
     1383                buf_tt0-info.artic = p-artic
     1384            and buf_tt0-info.prod-type = p-prod-type
     1385            and buf_tt0-info.prod-code = p-prod-code
     1386            and buf_tt0-info.prt-code = p-prt-code
     1387            no-error .
     1388       if not available buf_tt0-info then do:
     1389         create buf_tt0-info.
     1390         assign
     1391         buf_tt0-info.artic = p-artic
     1392         buf_tt0-info.prod-type = p-prod-type
     1393         buf_tt0-info.prod-code = p-prod-code
     1394         buf_tt0-info.prt-code  = p-prt-code
     1395         buf_tt0-info.obj-type  = p-obj-type
     1396         buf_tt0-info.obj-code  = p-obj-code
     1397         buf_tt0-info.a-to-res  = ?
     1398         buf_tt0-info.to-res    = ?
     1399         buf_tt0-info.was-res   = ?
     1400         buf_tt0-info.o-was-res = ?
     1401         buf_tt0-info.o-to-res  = ?
     1402         buf_tt0-info.o-is-res  = ?
     1403         buf_tt0-info.is-res    = ?
     1404         .
     1405       end.
     1406       assign
     1407       buf_tt0-info.a-to-res  =
     1408                                 (if buf_tt0-info.a-to-res <> ?
     1409                                 and p-all-qnty = ?
     1410                                 then buf_tt0-info.a-to-res
     1411                                 else p-all-qnty)
     1412       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
     1413                                 and p-was-res = ?
     1414                                 then buf_tt0-info.was-res
     1415                                 else p-was-res)
     1416       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
     1417                                 and p-to-res = ?
     1418                                 then buf_tt0-info.to-res
     1419                                 else p-to-res)
     1420       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
     1421                                 and p-is-res = ?
     1422                                 then buf_tt0-info.is-res
     1423                                 else p-is-res)
     1424       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
     1425                                 and p-o-was-res = ?
     1426                                 then buf_tt0-info.o-was-res
     1427                                 else p-o-was-res)
     1428       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
     1429                                 and p-o-to-res = ?
     1430                                 then buf_tt0-info.o-to-res
     1431                                 else p-o-to-res)
     1432       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
     1433                                 and p-o-is-res = ?
     1434                                 then buf_tt0-info.o-is-res
     1435                                 else p-o-is-res)
     1436       .
     1437       assign
     1438       buf_tt0-info.doc-code  = p-doc-code
     1439       buf_tt0-info.error-message   = p-mess
     1440       .
     1441     end.
     1442   end procedure.
     1443   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1444   def var cr as integer no-undo.
