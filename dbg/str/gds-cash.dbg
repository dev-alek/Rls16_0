        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        4   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        5   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        6   define input parameter fnc as char no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: gds-cash.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/gds-cash.p $":U .
       12   define variable vss-description as character no-undo init "Пересылка товаров на кассу".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   define new shared temp-table gds-list no-undo like ub.goods
       84     field qnty   as decimal
       85     field to-del as logical
       86     field order-num as integer
       87     field to-sel as logical
       88     field promo-code as character
       89     field ActionId  as int64
       90     field db-num as integer
       91     index art  is primary unique artic prod-type prod-code
       92     index code is         unique gds-code
       93     index oi order-num
       94     index isel to-sel
       95     .
       96   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   define  new shared  temp-table gds-list-hist no-undo
       98   field list-table as character
       99   field id as integer
      100   field line as integer
      101   field hist-mode as character
      102   field des as character
      103   field num-recs as integer
      104   field option_ as character
      105   field item_ as character
      106   field status_ as character
      107   field num-add as integer
      108   field num-ignored as integer
      109   field done as logical
      110   field err_ as logical
      111   field err-mes as character
      112   index pi is primary
      113   id
      114   line
      115   index isdone
      116   done
      117   .
      118   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   define new shared temp-table scn-list no-undo like ub.goods
      120     field qnty   as decimal
      121     field to-del as logical
      122     field order-num as integer
      123     field to-sel as logical
      124     field promo-code as character
      125     field ActionId  as int64
      126     field db-num as integer
      127     index art  is primary unique artic prod-type prod-code
      128     index code is         unique gds-code
      129     index oi order-num
      130     index isel to-sel
      131     .
      132   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define  new shared  temp-table scn-list-hist no-undo
      134   field list-table as character
      135   field id as integer
      136   field line as integer
      137   field hist-mode as character
      138   field des as character
      139   field num-recs as integer
      140   field option_ as character
      141   field item_ as character
      142   field status_ as character
      143   field num-add as integer
      144   field num-ignored as integer
      145   field done as logical
      146   field err_ as logical
      147   field err-mes as character
      148   index pi is primary
      149   id
      150   line
      151   index isdone
      152   done
      153   .
      154   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   def NEW shared temp-table goa-list no-undo like ub.gds-obj-attr
      156                           field rc as recid
      157                           field to-del as  logical
      158                           field order-num as integer
      159                           index rci is unique rc to-del
      160                           index gds-code-i is primary gds-code obj-type obj-code attr-code to-del
      161                           index iobj obj-type obj-code
      162                           index io order-num
      163                           .
      164   define variable glog as logical no-undo .
      165   define variable v-necessary as logical no-undo .
      166   define variable choice as integer no-undo .
      167   CASE fnc :
      168     when "qnty" then do:
      169       run str/scn-list.w ( input parparentproc
      170                          , input p-curr-host-code
      171                          , input p-curr-obj-type
      172                          , input p-curr-obj-code).
      173       return.
      174     end.
      175     when "cash" or
      176     when 'InfoKiosk':U or
      177     when 'pricecheck-Servis+':U
      178     then do:
      179      run str/gds-list.w ( input parparentproc
      180                         , input p-curr-host-code
      181                         , input p-curr-obj-type
      182                         , input p-curr-obj-code).
      183     end.
      184   END.
      185   if fnc begins "cash"
      186   or fnc = 'InfoKiosk':U
      187   or fnc = 'pricecheck-Servis+':U
      188   then do:
      189     if fnc begins "cash"
      190     then do:
      191       if not  can-find(first gds-list no-lock) then do:
      192             message "Вы не определили список товаров для пересылки!"
      193             view-as alert-box WARNING.
      194             return.
      195       end.
      196       glog = yes.
      197       message
      198       "Передать все товары списка на кассы ?"
      199       view-as alert-box question buttons OK-Cancel update glog.
      200       if glog <> true then return.
      201     end.
      202     if fnc begins 'InfoKiosk':U then do:
      203       if not  can-find(first gds-list no-lock) then do:
      204         message
      205         "Вы не определили список товаров для пересылки" skip
      206         "Хотите передать справочники групп товаров и справочники шкал?"
      207         view-as alert-box QUESTION buttons yes-no update glog.
      208         if not glog then return.
      209       end.
      210       run gbl/d-askw.w (input "Опции передачи справочников групп товаров и справочников шкал",
      211                   input  "Выберите необходимую опцию передачи справочников",
      212                   input "|",
      213                   input "Обязательно|По необходим.|Отказ",
      214                   input "БЕЗУСЛОВНАЯ передача справочников|ЕСЛИ после последней передачи справочники МЕНЯЛИСЬ|Отменить",
      215                   input 1,
      216                   input 3,
      217                   output choice).
      218       if choice = 3
      219       then do:
      220           return.
      221       end.
      222       if choice = 1 then do:
      223         v-necessary = yes.
      224       end.
      225     end.
      226     if fnc begins 'pricecheck-Servis+':U then do:
      227         if not  can-find(first gds-list no-lock) then do:
      228           message
      229           "Вы не определили список товаров для пересылки" skip
      230           view-as alert-box error .
      231           return.
      232         end.
      233         v-necessary = yes.
      234     end.
      235   end.
      236   CASE fnc:
      237     when "cash"
      238     or
      239     when 'InfoKiosk':U
      240     then do:
      241       if fnc = 'InfoKiosk':U then do:
      242         run str/diallog.w ( input parparentproc
      243                     , input this-procedure
      244                     , input 'str/s-infk-1.p':U
      245                     , input (string( - p-curr-obj-code) + chr(4) +  string(v-necessary))
      246                     , input can-find(first gds-list no-lock)
      247                     , input 'Прервать'
      248                     , input 'Отсылка справочников в ИНФОРМАЦИОННЫЙ КИОСК') no-error .
      249       end.
      250       if can-find(first gds-list no-lock) then do:
      251       run str/diallog.w ( input parparentproc
      252                     , input this-procedure
      253                     , input 'str/send-gds.p':U
      254                     , input (string( - p-curr-obj-code) + chr(4) + "no":U +
      255                        (if fnc = 'InfoKiosk':U then ( chr(4) + 'InfoKiosk':U + '-only':U)
      256                         else '')
      257                       )
      258                     , input no
      259                     , input 'Прервать'
      260                     , input 'Отсылка товаров на кассу') no-error .
      261       end.
      262     end.
      263     when  'pricecheck-Servis+':U
      264     then do:
      265          if can-find(first gds-list no-lock) then do:
      266             run str/diallog.w (
      267                   input parparentproc
      268                 , input this-procedure
      269                 , input 'str/send-gds.p':U
      270                 , input (string( - p-curr-obj-code) + chr(4) +  "no":U +
      271                     (chr(4) + 'pricecheck-Servis+':U)
      272                   )
      273                 , input no
      274                 , input 'Прервать'
      275                 , input 'Отсылка товаров на ПРАЙС-ЧЕКЕР Сервис+') no-error .
      276          end.
      277     end.
      278   END CASE.
