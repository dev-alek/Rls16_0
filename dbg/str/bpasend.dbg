        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Толкач пересылки ОСС на кассу".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82     define variable v-cntxt-db-num        as integer   no-undo .
       83     define variable v-cntxt-userid        as character no-undo .
       84     define variable v-cntxt-level         as character no-undo .
       85     define variable v-cntxt-host-code-obj as integer   no-undo .
       86     define variable v-cntxt-obj-type      as character no-undo .
       87     define variable v-cntxt-obj-code      as integer   no-undo .
       88     define variable v-cntxt-db-num-obj    as integer   no-undo .
       89     define variable v-cntxt-is-admin      as logical   no-undo .
       90   define variable p-pos-type as character no-undo .
       91   define variable p-obj-type like ub.clients.obj-type no-undo .
       92   define variable p-obj-code like ub.clients.obj-code no-undo .
       93   define variable action as char no-undo .
       94   define var choice as integer no-undo.
       95   define var rid-list as char no-undo.
       96   define variable glog as logical no-undo .
       97   define variable log-file-name as character no-undo init "send-cd.txt":U .
       98   define variable v-view-log as logical no-undo .
       99   define variable v-host-code like ub.sysconf.host-code no-undo .
      100   define variable vSubs as character no-undo .
      101   assign
      102   p-pos-type = entry(1, p-parameter, chr(4))
      103   p-obj-type = entry(2, p-parameter, chr(4))
      104   p-obj-code = integer(entry(3, p-parameter, chr(4)))
      105   action     = entry(4, p-parameter, chr(4))
      106   no-error .
      107   if error-status:error then do:
      108     run write-log-and-file in p-log-handle (
      109           input 1
      110         , input log-file-name
      111         , input 1
      112         , input substitute("Ошибка входных параметров &1:&2&3"
      113                            , p-parameter
      114                            , chr(10)
      115                            , error-status:get-message(1)
      116                            )).
      117     v-view-log = yes.
      118     undo, return error .
      119   end .
      120   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121     run mainmenu_getcntxt in parparentproc
      122       (output v-cntxt-db-num
      123       ,output v-cntxt-userid
      124       ,output v-cntxt-level
      125       ,output v-cntxt-host-code-obj
      126       ,output v-cntxt-obj-type
      127       ,output v-cntxt-obj-code
      128       ,output v-cntxt-db-num-obj
      129       ,output v-cntxt-is-admin
      130       ) .
      131   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      133     (input  p-obj-type
      134     ,input  p-obj-code
      135     ,output v-host-code
      136     )  .
      137   CASE p-pos-type:
      138     when 'IBM-XML':U
      139     then do:
      140       FIND FIRST ub.cash-desk NO-LOCK WHERE
      141                 ub.cash-desk.db-num = g#db-num AND
      142                 ub.cash-desk.pos-type = 'IBM-XML':U
      143                 No-error.
      144       IF not avail(ub.cash-desk) then do:
      145           run write-log-and-file in p-log-handle (
      146                 input 1
      147               , input log-file-name
      148               , input 1
      149               , input substitute( "!!!&1 платежные агенты/операторы реализуются только для POS &2"
      150                                   , (if action begins "U" then "Передача" else "Удаление")
      151                                   , 'IBM-XML':U
      152                                 )
      153                                                 ).
      154         return.
      155       end.
      156       if action = "U"
      157       then do:
      158       end.
      159       else do:
      160       end.
      161     end.
      162   END CASE.
      163   if action = "DD"
      164   or action = "UU"
      165   then do :
      166     choice = 1 .
      167   end .
      168   else do :
      169     run gbl/d-askw.w (input "Выбор платежных агентов/операторов для пересылки",
      170                 input ( (if action = "U"
      171                           then "Переслать на кассу"
      172                           else "Удалить из кассы" ) + chr(10) +
      173                                   "информацию о платежных агентах/операторов"
      174                                   ),
      175                 input "|",
      176                 input "Все|Выборочно|Отказ от пересылки",
      177                 input "||",
      178                 input 1,
      179                 input 3,
      180                 output choice).
      181   end .
      182   CASE choice:
      183     when 1 then do:
      184     end.
      185     when 2 then do:
      186       run ref/bpa.p(INPUT parparentproc,INPUT 'ВЫБОР':U,OUTPUT vSubs) no-error.
      187       if vSubs = "" then return.
      188     end.
      189     when 3 then do:
      190       return.
      191     end.
      192   END CASE.
      193   CASE p-pos-type:
      194     when  'IBM-XML':U
      195     then do:
      196       run str/sendcoss.p (
      197                       input parparentproc
      198                      ,input p-parent-handle
      199                      ,input p-log-handle
      200                      ,input p-obj-code
      201                      ,input action
      202                      ,input (if vSubs = ""
      203                              then 0
      204                              else 1)
      205                     , input vSubs
      206                     , input log-file-name
      207                     , input-output v-view-log
      208                     ) no-error .
      209     end.
      210   end CASE.
      211     finally :
      212       run write-log-and-file in p-log-handle (
      213           input 1
      214         , input log-file-name
      215         , input 1
      216         , input substitute("&1", chr(10))
      217       ).
      218       define variable v-save-file-name as character no-undo .
      219       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
      220       OS-APPEND value(log-file-name) value(v-save-file-name).
      221       OS-DELETE value(log-file-name).
      222     end finally .
