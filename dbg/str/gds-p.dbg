      486   WITH SIZE 93 BY 15 separators.
      487   DEFINE BUTTON b-exit AUTO-go
      488        LABEL "&Выход ":L
      489        SIZE 9 BY 1.
      490   DEFINE BUTTON b-sel AUTO-go
      491        LABEL "Вы&бор ":L
      492        SIZE 9 BY 1.
