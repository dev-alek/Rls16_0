      494        LABEL "&Удалить ":L
      495        SIZE 9 BY 1.
      496   DEFINE BUTTON b-exp-nd
      497        LABEL "&>>":L
      498        SIZE 4.5 BY 1.
      499   DEFINE BUTTON b-exp-tree
      500        LABEL ">>&->>":L
      501        SIZE 9 BY 1.
      502   DEFINE BUTTON b-amnt
      503        LABEL "&Чеки  ":L
      504        SIZE 9 BY 1.
      505   DEFINE BUTTON b-codes
      506        LABEL "&Коды":L
      507        SIZE 9 BY 1.
      508   DEFINE MENU m-alt
      509          MENU-ITEM m-alt-current  LABEL "Существующие неосновные цены"
      510          MENU-ITEM m-alt-all      LABEL "Все неосновные коды"
      511          rule
      512          MENU-ITEM m-prod-all     LABEL "Дополнительные коды"
      513          .
      514   DEFINE MENU MENU-b-print
      515          MENU-ITEM m_hor          LABEL "Уровни по горизонтали"
      516          MENU-ITEM m_vert         LABEL "Уровни по вертикали"
      517          .
      518   DEFINE BUTTON b-alt
      519        LABEL "&Неос/Доп":L
      520        SIZE 9 BY 1.
      521   DEFINE BUTTON b-rest
      522        LABEL "&Остатки":L
      523        SIZE 9 BY 1.
      524   DEFINE MENU m-inf
      525          MENU-ITEM m-inf-prt      LABEL "По признаку"
      526          MENU-ITEM m-inf-gds      LABEL "По товару"
      527          .
      528   DEFINE BUTTON b-info
      529        LABEL "&Архив":L
      530        SIZE 9 BY 1.
      531   DEFINE BUTTON b-print
      532        LABEL "Пе&чать":L
      533        SIZE 9 BY 1.
      534   DEFINE BUTTON b-help
      535        LABEL "Помо&щь":L
      536        SIZE 9 BY 1.
      537   DEFINE BUTTON b-prt-ref
      538        LABEL "Шкала - новый интерфейс":L
      539        SIZE 25 BY 1.
      540   DEFINE FRAME d-gds-prt
      541     b-exit     AT ROW 1.25  COL 1
      542     b-sel      AT ROW 1.25  COL 10
      543     b-del      AT ROW 1.25  COL 19
      544     b-exp-nd   AT ROW 1.25  COL 28
      545     b-exp-tree AT ROW 1.25  COL 32.5
      546     b-amnt     AT ROW 1.25  COL 41.5
      547     b-codes    AT ROW 1.25  COL 50.5
      548     b-alt      AT ROW 1.25  COL 59.5
      549     b-rest     AT ROW 1.25  COL 68.5
      550     b-info     AT ROW 1.25  COL 77.5
      551     b-print    AT ROW 1.25  COL 76.5
      552     b-help     AT ROW 1.25  COL 78.5
      553     b-prt-ref  AT ROW 2.25  COL 1
      554     ub.goods.unit-base at row 2.5   col 70  no-label      format "x(3)"
      555     flt-amnt        at row 3.5   col 5   label "Только с количествами" view-as toggle-box
      556     br-gds-prt      AT ROW 4.5   COL 2
      557     WITH size 96 by 21 VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D.
      558     ASSIGN
      559     b-print:POPUP-MENU IN FRAME d-gds-prt       = MENU MENU-b-print:HANDLE.
      560     br-gds-prt :set-repositioned-row (10, "conditional").
      561     b-print:MENU-MOUSE in frame d-gds-prt  = 1.
      562     ASSIGN
      563       FRAME d-gds-prt:SCROLLABLE = FALSE
      564       b-info    :POPUP-MENU IN FRAME d-gds-prt         = MENU m-inf  :HANDLE
      565       b-info    :MENU-MOUSE                                = 1
      566       b-alt     :POPUP-MENU IN FRAME d-gds-prt         = MENU m-alt  :HANDLE
      567       b-alt     :MENU-MOUSE                                = 1
      568       .
      569   on value-changed of flt-amnt do:
      570     gds-prt-row = current-result-row ("br-gds-prt").
      571     find first prt-tree.
      572     if input frame d-gds-prt flt-amnt then
      573       run exp-tree.
      574       run UI-on.
      575   end.
      576   on row-display of br-gds-prt do:
      577     if prt-tree.is-root then
      578       shift-name :fgcolor in browse br-gds-prt = BLUE_COLOR.
      579     else
      580       if not prt-tree.is-term then
      581         shift-name :fgcolor in browse br-gds-prt = BROWN_COLOR.
      582   end.
      583   ON CHOOSE OF b-exit IN FRAME d-gds-prt  DO:
      584     prt-rec = prt-tree.rid.
      585     return "exit":U.
      586   END.
      587   ON CHOOSE OF b-sel IN FRAME d-gds-prt  DO:
      588     prt-rec = prt-tree.rid.
      589   END.
      590   ON choose of b-del IN FRAME d-gds-prt DO:
      591      def var gds-prt-recid as recid   no-undo.
      592      def var chg-qnty      as decimal no-undo.
      593   END.
      594   ON choose of b-exp-nd IN FRAME d-gds-prt DO:
      595     gds-prt-row = current-result-row ("br-gds-prt").
      596     run exp-nd (?).
      597     run UI-on.
      598   END.
      599   ON choose of b-exp-tree IN FRAME d-gds-prt DO:
      600     gds-prt-row = current-result-row ("br-gds-prt").
      601     run exp-tree.
      602     run UI-on.
      603   END.
      604   ON MOUSE-SELECT-DBLCLICK, return OF br-gds-prt IN FRAME d-gds-prt DO:
      605     gds-prt-row = current-result-row ("br-gds-prt").
      606     if prt-tree.is-term then do:
      607       if b-amnt:sensitive then
      608         apply "choose" to b-amnt in frame d-gds-prt.
      609     end.
      610     else
      611       apply "choose" to b-exp-nd in frame d-gds-prt.
      612     return no-apply.
      613   END.
      614   ON CHOOSE OF b-amnt IN FRAME d-gds-prt  DO:
      615     DEFINE VARIABLE rid-list as character no-undo .
      616     gds-prt-row = current-result-row ("br-gds-prt").
      617     if not prt-tree.is-root and
      618        not prt-tree.is-term then do:
      619       message "Данный признак промежуточный и не может быть выбран."
      620               view-as alert-box error.
      621       return no-apply.
      622     end.
      623     if prt-tree.bc = ? then do:
      624       message
      625         "Чеков по данному признаку нет."
      626         view-as alert-box.
      627       return no-apply.
      628     end.
      629     run ref/gds-chk.w (input parparentproc
      630                   ,input prt-tree.bc
      631                   ,input "":U
      632                   ,input 'объект':U
      633                   ,input ?
      634                   ,input store-type
      635                   ,input store-code
      636                   ,input "":U
      637                   ,input "":U
      638                   ,output rid-list
      639                   ).
      640     apply "entry" to br-gds-prt in frame d-gds-prt.
      641   END.
      642   ON CHOOSE OF b-codes IN FRAME d-gds-prt do:
      643     run cre-code no-error.
      644     if error-status :error then
      645       return no-apply.
      646     prt-rec = prt-tree.rid.
      647     run ref/alt-bc.w (
      648                   input parParentProc
      649                 , input store-type
      650                 , input store-code
      651                 , input prt-tree.bc).
      652     apply "entry" to br-gds-prt in frame d-gds-prt.
      653   END.
      654   ON CHOOSE OF menu-item m-alt-current do:
      655     run cre-code no-error.
      656     if error-status :error then
      657       return no-apply.
      658     run ref/alt-cds.w ( input parParentProc
      659                        ,input store-type
      660                        ,input store-code
      661                        ,input "code-current"
      662                        ,input ub.goods.gds-code
      663                        ,input prt-tree.bc
      664                        ,output rec-list).
      665     apply "entry" to br-gds-prt in frame d-gds-prt.
      666   END.
      667   ON CHOOSE OF menu-item m-alt-all do:
      668     run cre-code no-error.
      669     if error-status :error then
      670       return no-apply.
      671     run ref/alt-cds.w ( input parParentProc
      672                        ,input store-type
      673                        ,input store-code
      674                        ,input "code-all"
      675                        ,input ub.goods.gds-code
      676                        ,input prt-tree.bc
      677                        ,output rec-list).
      678     apply "entry" to br-gds-prt in frame d-gds-prt.
      679   END.
      680   ON CHOOSE OF menu-item m-prod-all do:
      681     run cre-code no-error.
      682     if error-status :error then
      683       return no-apply.
      684     run ref/prod-cds.w (parParentProc, store-type, store-code,
      685                     "code-all", ub.goods.gds-code, prt-tree.bc, output rec-list).
      686     apply "entry" to br-gds-prt in frame d-gds-prt.
      687   END.
      688   ON CHOOSE OF menu-item m-inf-prt
      689   do:
      690   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      691   do:
      692     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      693       (input  v-cntxt-db-num
      694       ,input  v-cntxt-userid
      695       ,input  0
      696       ,input  'actn_reference_archive':U
      697       ,input  'firm':U
      698       ,input  v-cntxt-host-code-obj
      699       ,input  '':U
      700       ,input  0
      701       ,input  0
      702       ,input  0
      703       ,input  0
      704       ,input  true
      705       ,output g#log
      706       )  .
      707   end.
      708     if g#log then
      709       run ref/prt_inf.w (buffer ub.goods,
      710                      input prt-tree.n-code,
      711                      input store-type,
      712                      input store-code).
      713     apply "entry" to br-gds-prt in frame d-gds-prt.
      714   END.
      715   ON CHOOSE OF menu-item m-inf-gds do:
      716      run local-gds_inf.
      717   END.
      718   ON CHOOSE OF b-rest IN FRAME d-gds-prt do:
      719     prt-rec = prt-tree.rid.
      720       run rep/gds-objs.w (parparentproc, ub.goods.artic, ub.goods.prod-type, ub.goods.prod-code, g#host-code, prt-tree.n-code).
      721     apply "entry" to br-gds-prt in frame d-gds-prt.
      722   END.
      723   ON CHOOSE OF b-prt-ref IN FRAME d-gds-prt do:
      724     define variable v-sel-node-code as integer   no-undo .
      725     run str/prt-ref.w
      726       (input parParentProc
      727       ,input  ub.goods.gds-code
      728       ,input  prt-mode
      729       ,input  store-type
      730       ,input  store-code
      731       ,input  ""
      732       ,input  ""
      733       ,output v-sel-node-code
      734       ) .
      735   END.
      736   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED THEN
      737     CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      738   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      739   on help of frame d-gds-prt
      740   do:
      741     run gbl/app_help.p
      742       (input this-procedure :file-name
      743       ,input ''
      744       ,input ?
      745       ) no-error.
      746     if error-status :error then do:
      747       message
      748         "Ошибка при вызове помощи"
      749         error-status :get-message(1)
      750         view-as alert-box .
      751     end.
      752   end.
      753   run minbtn-set in this-procedure .
      754   on choose of b-help in frame d-gds-prt
      755   do:
      756     apply "help":u to frame d-gds-prt .
      757   end.
      758   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      759   procedure minbtn-set :
      760       do
      761           on error undo, return error return-value
      762           :
      763           define variable ii              as integer       no-undo .
      764           define variable fh              as widget-handle no-undo .
      765           define variable hh              as widget-handle no-undo .
      766           define variable v-h             as handle        extent 4 no-undo .
      767           define variable v-name-button   as character     no-undo .
      768           define variable v-help-old-x    as decimal       no-undo .
      769           define variable v-help-old-y    as decimal       no-undo .
      770           define variable v-help-old-size as decimal       no-undo .
      771           define variable v-frame-width   as decimal       no-undo .
      772           define variable jj              as integer       no-undo .
      773           do
      774               on error undo, return error
      775               :
      776               assign
      777                   v-frame-width = frame d-gds-prt:width - 0.3
      778                   fh            = frame d-gds-prt:first-child
      779                   hh            = fh:first-child
      780                   ii            = 1
      781                   .
      782               do while valid-handle(hh):
      783                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      784                   do:
      785                       case lc(hh:name) :
      786                           when "b-help" then
      787                               do:
      788                                   hh:load-image-up("cmp/b-help.bmp":u) .
      789                                   hh:load-image-down("cmp/b-help.bmp":u) .
      790                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      791                                   hh:TOOLTIP = "Помощь" .
      792                                   v-help-old-x = hh:column .
      793                                   v-help-old-y = hh:row    .
      794                                   v-help-old-size = hh:width .
      795                                   hh:width-chars = 2.5 .
      796                               end.
      797                           when "b-print" then
      798                               do:
      799                                   hh:load-image("cmp/b-print.bmp":u) .
      800                                   hh:TOOLTIP = "Печать" .
      801                                   v-h[ii] = hh:handle .
      802                                   ii = ii + 1 .
      803                                   hh:width-chars = 3 .
      804                               end.
      805                           when "b-history" or
      806                           when "b-hist" then
      807                               do:
      808                                   hh:load-image("cmp/b-hist.bmp":u) .
      809                                   hh:TOOLTIP = "История" .
      810                                   v-h[ii] = hh:handle .
      811                                   ii = ii + 1 .
      812                                   hh:width-chars = 3 .
      813                               end.
      814                           when "b-sch" then
      815                               do:
      816                                   hh:load-image("cmp/b-sch.bmp":u) .
      817                                   hh:TOOLTIP = "Установка Фильтра" .
      818                                   v-h[ii] = hh:handle .
      819                                   ii = ii + 1 .
      820                                   hh:width-chars = 3 .
      821                               end.
      822                           when "b-hist-user" then
      823                               do:
      824                                   hh:load-image("cmp/b-hist.bmp":u) .
      825                                   hh:TOOLTIP = "История пользователя" .
      826                                   ii = ii + 1 .
      827                               end.
      828                       end case.
      829                   end.
      830                   hh = hh:next-sibling.
      831               end.
      832               b-help:column = v-frame-width - b-help:width-chars.
      833               jj = 0.
      834               repeat ii = 4 to 1 by -1 :
      835                   if valid-handle (v-h[ii] ) then
      836                   do:
      837                       jj  = jj + 1 .
      838                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      839                       v-h[ii]:row    = v-help-old-y .
      840                   end.
      841               end.
      842           end.
      843       end.
      844   end procedure.
      845   ON WINDOW-CLOSE OF FRAME d-gds-prt APPLY "END-ERROR":U TO SELF.
      846   find ub.goods no-lock where
      847        recid (ub.goods) = gds-rec.
      848   find ub.gds-prt no-lock where
      849        ub.gds-prt.upper-code = ub.goods.prt-root.
      850   g#log = session:set-wait-state ("COMPILER") .
      851   ENABLE br-gds-prt
      852          b-exit
      853          b-help
      854          b-rest
      855          b-exp-nd
      856          b-exp-tree with FRAME d-gds-prt.
      857   run cre-nd (buffer  ub.gds-prt, buffer prt-tree, 0).
      858   find first prt-tree.
      859   run exp-nd (yes).
      860   FRAME d-gds-prt:title =
      861     ub.goods.artic + " " + ub.goods.gds-name + "  -  " + prt-mode.
      862   ENABLE b-sel when prt-mode = 'выбор':U
      863          b-info
      864          b-codes b-alt b-amnt
      865          with FRAME d-gds-prt.
      866   ENABLE flt-amnt with FRAME d-gds-prt.
      867   run ui-on.
      868   g#log = session:set-wait-state ( "" ) .
      869   define variable v-sys-key as character no-undo .
      870   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
      871   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
      872     (output v-sys-key
      873     ) no-error .
      874   if error-status :error
      875     or v-sys-key <> 'ExpertekIBS':U
      876   then do:
      877     assign
      878       b-prt-ref :visible   = false
      879     .
      880   end.
      881   else do:
      882     assign
      883       b-prt-ref :visible   = true
      884       b-prt-ref :sensitive = true
      885     .
      886   end.
      887   do on endkey undo, leave  on error undo, leave:
      888     WAIT-FOR GO OF FRAME d-gds-prt.
      889   end.
      890   run disable_ui.
      891   PROCEDURE disable_UI :
      892     HIDE FRAME d-gds-prt.
      893   END PROCEDURE.
      894   PROCEDURE UI-on :
      895   find  ub.prt-obj where  ub.prt-obj.prt-code  =  ub.gds-prt.node-code
      896                  and  ub.prt-obj.prod-code = ub.goods.prod-code
      897                  and  ub.prt-obj.prod-type = ub.goods.prod-type
      898                  and  ub.prt-obj.artic     = ub.goods.artic
      899                  and  ub.prt-obj.obj-code  = store-code
      900                  and  ub.prt-obj.obj-type  = store-type
      901                  no-lock no-error.
      902   if input frame d-gds-prt flt-amnt then
      903     OPEN QUERY br-gds-prt
      904       FOR EACH  prt-tree where
      905                 prt-tree.visible = yes and
      906                 (prt-tree.is-term = no or
      907                 prt-tree.fact-qnty <> 0
      908                 ) no-lock.
      909   else
      910   OPEN QUERY  br-gds-prt
      911     FOR EACH  prt-tree where
      912               prt-tree.visible = yes no-lock.
      913   reposition br-gds-prt to row gds-prt-row no-error.
      914   apply "ENTRY":U to br-gds-prt in frame d-gds-prt.
      915   END PROCEDURE.
      916   PROCEDURE exp-nd :
      917   def input param make-visible as logical no-undo.
      918   define variable nd-level as integer no-undo.
      919   def buffer b-prt-tree for prt-tree.
      920   if prt-tree.exp then do:
      921     nd-level = prt-tree.level.
      922     find b-prt-tree where
      923          recid (b-prt-tree) = recid (prt-tree).
      924     inverse:
      925     do while true:
      926       find next b-prt-tree no-error.
      927       if not available b-prt-tree then
      928         leave inverse.
      929       if b-prt-tree.level > nd-level then do:
      930         if make-visible = ? then
      931           make-visible = not (b-prt-tree.visible).
      932         if not make-visible or
      933            b-prt-tree.level - nd-level = 1 then do:
      934           b-prt-tree.visible = make-visible.
      935           if not b-prt-tree.is-term then
      936             b-prt-tree.mark = "»".
      937         end.
      938       end.
      939       else
      940         leave inverse.
      941     end.
      942   end.
      943   else do:
      944     prt-tree.exp = yes.
      945     run cre-level (recid (prt-tree), prt-tree.level + 1).
      946     make-visible = yes.
      947   end.
      948   if not prt-tree.is-term then
      949     if make-visible then
      950       prt-tree.mark = " ".
      951     else
      952       prt-tree.mark = "»".
      953   END PROCEDURE.
      954   PROCEDURE exp-tree :
      955     define variable rid as recid no-undo.
      956     do
      957     on error undo, return error return-value
      958     :
      959       tree-level = prt-tree.level.
      960       run waitfram-show in this-procedure
      961         (input "Раскрывается шкала. Ждите..."
      962         ).
      963       tree:
      964       do while true:
      965         rid = recid (prt-tree).
      966         run exp-nd (yes).
      967         find prt-tree where rid = recid (prt-tree).
      968         find next prt-tree no-error.
      969         if not available prt-tree or
      970           prt-tree.level <= tree-level
      971           then
      972           leave tree.
      973       end.
      974       run waitfram-hide in this-procedure .
      975     end.
      976   END PROCEDURE.
      977   PROCEDURE cre-level:
      978   def input param prt-tree-rec as recid   no-undo.
      979   def input param cur-lev      as integer no-undo.
      980   def buffer b-gds-prt  for  ub.gds-prt.
      981   def buffer b-prt-tree for prt-tree.
      982   define variable up-code like  ub.gds-prt.node-code no-undo.
      983   find b-prt-tree where
      984        recid (b-prt-tree) = prt-tree-rec.
      985   up-code = b-prt-tree.n-code.
      986   for each b-gds-prt no-lock where
      987            b-gds-prt.upper-code = up-code
      988            by b-gds-prt.prt-num:
      989     run cre-nd (buffer b-gds-prt, buffer b-prt-tree, cur-lev).
      990   end.
      991   END PROCEDURE.
      992   PROCEDURE cre-nd:
      993   def param buffer b-gds-prt  for  ub.gds-prt.
      994   def param buffer b-prt-tree for prt-tree.
      995   def input param cur-lev as integer no-undo.
      996   create b-prt-tree.
      997   assign
      998     b-prt-tree.n-code   = b-gds-prt.node-code
      999     b-prt-tree.level    = cur-lev
     1000     b-prt-tree.n-name   = b-gds-prt.node-name
     1001     b-prt-tree.rid      = recid (b-gds-prt)
     1002     b-prt-tree.visible  = yes
     1003     b-prt-tree.is-term  = b-gds-prt.is-term
     1004     b-prt-tree.is-root  = b-gds-prt.root
     1005     .
     1006   if b-gds-prt.is-term then
     1007     assign
     1008       b-prt-tree.mark = " "
     1009       b-prt-tree.exp = yes
     1010       .
     1011   else
     1012     assign
     1013       b-prt-tree.mark = "»"
     1014       b-prt-tree.exp = no
     1015       .
     1016   run clc-nd (buffer b-prt-tree).
     1017   END PROCEDURE.
     1018   PROCEDURE clc-nd:
     1019   def param buffer b-prt-tree for prt-tree.
     1020   def buffer b-gds-prt for  ub.gds-prt.
     1021   find b-gds-prt no-lock where
     1022        recid (b-gds-prt) = b-prt-tree.rid.
     1023   find  ub.prt-obj no-lock where
     1024          ub.prt-obj.prt-code  = b-gds-prt.node-code and
     1025          ub.prt-obj.obj-type  = store-type and
     1026          ub.prt-obj.obj-code  = store-code and
     1027          ub.prt-obj.artic     = ub.goods.artic and
     1028          ub.prt-obj.prod-type = ub.goods.prod-type and
     1029          ub.prt-obj.prod-code = ub.goods.prod-code no-error.
     1030   if available  ub.prt-obj then do:
     1031     assign
     1032       b-prt-tree.free-qnty  =  ub.prt-obj.free-qnty
     1033       b-prt-tree.fact-qnty  =  ub.prt-obj.fact-qnty
     1034       .
     1035     b-prt-tree.price =  ub.prt-obj.price-sale.
     1036   end.
     1037   find  ub.bar-code no-lock where
     1038         ub.bar-code.gds-code  = ub.goods.gds-code and
     1039         ub.bar-code.node-code = b-gds-prt.node-code and
     1040         ub.bar-code.part-code = "" and
     1041         ub.bar-code.in-code   = "" and
     1042         ub.bar-code.unit-cli  = ub.goods.unit-base no-error.
     1043   if available ub.bar-code then
     1044     b-prt-tree.bc = ub.bar-code.b-code.
     1045   else
     1046     b-prt-tree.bc = ?.
     1047   END PROCEDURE.
     1048   PROCEDURE cre-code:
     1049   define variable is-new as log no-undo.
     1050   def buffer buf_bar-code for ub.bar-code.
     1051     if not prt-tree.is-term and
     1052        not prt-tree.is-root then do:
     1053       message
     1054         "Узел промежуточный. Работа с кодами запрещена."
     1055         view-as alert-box error.
     1056       return error.
     1057     end.
     1058     if prt-tree.bc = ? then do:
     1059       g#log = no.
     1060       message "Основной код для данного признака отсутствует. Создать код?"
     1061               view-as alert-box question buttons YES-NO update g#log.
     1062       if not g#log then
     1063         return error.
     1064   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1065   do:
     1066     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1067       (input  v-cntxt-db-num
     1068       ,input  v-cntxt-userid
     1069       ,input  0
     1070       ,input  'actn_main-barcode_preparation':U
     1071       ,input  'global':U
     1072       ,input  0
     1073       ,input  '':U
     1074       ,input  0
     1075       ,input  0
     1076       ,input  0
     1077       ,input  0
     1078       ,input  true
     1079       ,output g#log
     1080       )  .
     1081   end.
     1082       if not g#log then do:
     1083         return error.
     1084       END.
     1085   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1086   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1087     (input  ub.goods.gds-code
     1088     ,input  prt-tree.n-code
     1089     ,input  ''
     1090     ,input  ''
     1091     ,input  ub.goods.unit-base
     1092     ,input  1
     1093     ,output is-new
     1094     ,buffer buf_bar-code
     1095     ) no-error .
     1096       if error-status :error then do:
     1097         message
     1098           "Ошибка поиска / создания основного кода." skip
     1099           "Код товара:"        ub.goods.gds-code skip
     1100           "Код признака:"      prt-tree.n-code skip
     1101           "Единица измерения:" ub.goods.unit-base skip
     1102           error-status :get-message(1) skip
     1103           return-value skip
     1104           view-as alert-box error.
     1105         return error.
     1106       end.
     1107       prt-tree.bc = buf_bar-code.b-code.
     1108       disp prt-tree.bc with browse br-gds-prt.
     1109     end.
     1110   end.
     1111   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1112   procedure local-gds_inf :
     1113     for each tt-goods
     1114     :
     1115       delete tt-goods.
     1116     end.
     1117     for each tt-clients
     1118     :
     1119       delete tt-clients.
     1120     end.
     1121     create tt-goods.
     1122     buffer-copy ub.goods to tt-goods.
     1123     create tt-clients.
     1124     assign
     1125       tt-clients.obj-type = store-type
     1126       tt-clients.obj-code = store-code
     1127     .
     1128     define variable v-ok as logical   no-undo .
     1129     define variable v-chk-act-host-code as integer   no-undo .
     1130   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1132     (input  tt-clients.obj-type
     1133     ,input  tt-clients.obj-code
     1134     ,output v-chk-act-host-code
     1135     )  .
     1136   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1137   do:
     1138     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1139       (input  v-cntxt-db-num
     1140       ,input  v-cntxt-userid
     1141       ,input  0
     1142       ,input  'actn_reference_archive':U
     1143       ,input  'firm':U
     1144       ,input  v-chk-act-host-code
     1145       ,input  '':U
     1146       ,input  0
     1147       ,input  0
     1148       ,input  0
     1149       ,input  0
     1150       ,input  true
     1151       ,output v-ok
     1152       )  .
     1153   end.
     1154     if v-ok then do:
     1155       run arc/gds_inf.w (parparentproc, tt-clients.obj-type, tt-clients.obj-code).
     1156     end.
     1157   end procedure.
