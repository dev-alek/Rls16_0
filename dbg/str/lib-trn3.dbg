     9916   procedure lib-trn3_trn-rsn :
     9917     define input parameter p-doc-code like ub.trn-doc.doc-code no-undo.
     9918     define variable is_hold-doc as logical no-undo.
     9919     define variable j_rsn-code  as integer no-undo initial ?.
     9920     define buffer buf_trn-doc for ub.trn-doc.
     9921     define buffer src_trn-doc for ub.trn-doc.
     9922     do on error undo, return error "lib-trn3_trn-rsn: ошибка установки кода основания (причины) создания документа" :
     9923       find first buf_trn-doc no-lock where
     9924                  buf_trn-doc.doc-code = p-doc-code no-error.
     9925       if not available buf_trn-doc then do:
     9926         undo, return error substitute( 'lib-trn3_trn-rsn: не найдена накладная "&1"', p-doc-code ).
     9927       end.
     9928   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9929   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     9930     (input  p-doc-code
     9931     ,output is_hold-doc
     9932     )  .
     9933       if is_hold-doc = yes or is_hold-doc = no and
     9934          lookup( buf_trn-doc.ext-doc-type, 'iv,rv':U ) > 0 then do:
     9935         find first src_trn-doc no-lock where
     9936                    src_trn-doc.doc-code = buf_trn-doc.out-code no-error.
     9937         if available src_trn-doc then do:
     9938           assign j_rsn-code = buf_trn-doc.reason-code.
     9939         end.
     9940       end.
     9941       if j_rsn-code = ? then do:
     9942         find first ub.trn-reason-obj no-lock where
     9943                    ub.trn-reason-obj.obj-type     = buf_trn-doc.obj-type     and
     9944                    ub.trn-reason-obj.obj-code     = buf_trn-doc.obj-code     and
     9945                    ub.trn-reason-obj.ext-doc-type = buf_trn-doc.ext-doc-type and
     9946                    ub.trn-reason-obj.hold-doc     = is_hold-doc              no-error.
     9947         if available ub.trn-reason-obj then do:
     9948           assign j_rsn-code = ub.trn-reason-obj.reason-code.
     9949         end.
     9950       end.
     9951       if j_rsn-code = ? then do:
     9952         find first ub.trn-reason-host no-lock where
     9953                    ub.trn-reason-host.host-code    = buf_trn-doc.host-code    and
     9954                    ub.trn-reason-host.ext-doc-type = buf_trn-doc.ext-doc-type and
     9955                    ub.trn-reason-host.hold-doc     = is_hold-doc              no-error.
     9956         if available ub.trn-reason-host then do:
     9957           assign j_rsn-code = ub.trn-reason-host.reason-code.
     9958         end.
     9959       end.
     9960       if j_rsn-code <> ? then do:
     9961         do transaction on error undo, return error :
     9962           find first buf_trn-doc exclusive-lock where buf_trn-doc.doc-code = p-doc-code.
     9963           assign buf_trn-doc.reason-code = j_rsn-code.
     9964           find first buf_trn-doc        no-lock where buf_trn-doc.doc-code = p-doc-code.
     9965         end.
     9966       end.
     9967     end.
     9968   end procedure.
     9969   procedure lib-trn3_canclsee :
     9970     define  input parameter p-doc-code like ub.trn-doc.doc-code no-undo.
     9971     define output parameter p-CanClose as   logical             no-undo initial no.
     9972     define variable v-DataType as character no-undo.
     9973     define variable v-ProxyCrd as character no-undo.
     9974     define buffer bf_trn-doc  for ub.trn-doc.
     9975     define buffer bf_doc-attr for ub.doc-attr.
     9976     do on error undo, return error "canclsee: ошибка определения параметра proxycrd" :
     9977       find first bf_trn-doc no-lock where
     9978                  bf_trn-doc.doc-code = p-doc-code no-error.
     9979       if not available bf_trn-doc then do:
     9980         undo, return error substitute( 'canclsee: не найдена накладная "&1"', p-doc-code ).
     9981       end.
     9982       if lookup( bf_trn-doc.ext-doc-type, 'ee,ep':U ) = 0 then do:
     9983         assign p-CanClose = yes.
     9984         return.
     9985       end.
     9986   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9987   empty temp-table thbjattr_thbj-attr.
     9988   run adm/shattri.p (
     9989      input "get":U
     9990     ,input bf_trn-doc.obj-type
     9991     ,input bf_trn-doc.obj-code
     9992     ,input 'nakl_par':U
     9993     ,input  ""
     9994     ,output v-value-character
     9995     ,output v-value-date
     9996     ,output v-value-decimal
     9997     ,output v-value-integer
     9998     ,output v-value-logical
     9999     ,output par-type
    10000     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    10001     ) no-error .
    10002   for each thbjattr_thbj-attr :
    10003       if thbjattr_thbj-attr.prop-code = 'proxycrd'   then v-ProxyCrd = string( thbjattr_thbj-attr.property-value-logical, "yes/no" ) .
    10004   end.
    10005   empty temp-table thbjattr_thbj-attr.
    10006       if  v-ProxyCrd <> "yes" then do:
    10007         assign p-CanClose = yes.
    10008         return.
    10009       end.
    10010       find first bf_doc-attr no-lock where
    10011                  bf_doc-attr.doc-code  = p-doc-code       and
    10012                  bf_doc-attr.attr-code = 'ndov':U no-error.
    10013       if not available bf_doc-attr then do:
    10014         undo, return error 'canclsee: не найден атрибут "Номер доверенности"'.
    10015       end.
    10016       if bf_doc-attr.attr-value = ? or bf_doc-attr.attr-value = "":U then do:
    10017         undo, return error 'canclsee: атрибут "Номер доверенности" не заполнен'.
    10018       end.
    10019       find first bf_doc-attr no-lock where
    10020                  bf_doc-attr.doc-code  = p-doc-code       and
    10021                  bf_doc-attr.attr-code = 'ddov':U no-error.
    10022       if not available bf_doc-attr then do:
    10023         undo, return error 'canclsee: не найден атрибут "Дата доверенности"'.
    10024       end.
    10025       if bf_doc-attr.attr-value = ? or bf_doc-attr.attr-value = "":U then do:
    10026         undo, return error 'canclsee: атрибут "Дата доверенности" не заполнен'.
    10027       end.
    10028       assign p-CanClose = yes.
    10029     end.
    10030   end procedure.
    10031   procedure lib-trn3_holdcdoc :
    10032     define  input parameter p-doc-code as character no-undo.
    10033     define output parameter p-is-hold  as logical   no-undo initial no.
    10034     define buffer bf_c-trn-doc for ub.c-trn-doc.
    10035     do on error undo, return error substitute( '&1 &2', return-value, error-status :get-message( 1 ) ) :
    10036       find first bf_c-trn-doc no-lock where
    10037                  bf_c-trn-doc.doc-code = p-doc-code no-error.
    10038       if not available bf_c-trn-doc then do:
    10039         return error substitute( 'Не найдена история документа (удаленный документ) с номером "&1" .', p-doc-code ).
    10040       end.
    10041       if   ( bf_c-trn-doc.ext-doc-type         =  'ie':U       or
    10042              bf_c-trn-doc.ext-doc-type         =  'ee':U       or
    10043              bf_c-trn-doc.ext-doc-type         =  'ep':U    or
    10044              bf_c-trn-doc.ext-doc-type         =  're':U ) and
    10045          ( ( bf_c-trn-doc.hold-doc-code-child  <> '':U                     and
    10046              bf_c-trn-doc.hold-doc-code-child  <> 'no-hold':U )            or
    10047            ( bf_c-trn-doc.hold-doc-code-parent <> '':U                     and
    10048              bf_c-trn-doc.hold-doc-code-parent <> 'no-hold':U )          ) then do:
    10049         assign
    10050           p-is-hold = yes
    10051         .
    10052       end.
    10053     end.
    10054   end procedure.
    10055   procedure lib-trn3_shiftnam :
    10056     define input  parameter parobj-type       like ub.clients.obj-type     no-undo.
    10057     define input  parameter parobj-code       like ub.clients.obj-code     no-undo.
    10058     define input  parameter parshift-date     like ub.shift-obj.shift-date no-undo.
    10059     define input  parameter parshift-num      like ub.shift-obj.shift-num  no-undo.
    10060     define output parameter parshift-name     as   character               no-undo.
    10061     define output parameter parshift-name-num as   character               no-undo.
    10062     define buffer bf_shift-obj   for ub.shift-obj.
    10063     define buffer bf_shift-staff for ub.shift-staff.
    10064     do on error undo, return error return-value :
    10065       find first bf_shift-obj where bf_shift-obj.obj-type   = parobj-type   and
    10066                                     bf_shift-obj.obj-code   = parobj-code   and
    10067                                     bf_shift-obj.shift-date = parshift-date and
    10068                                     bf_shift-obj.shift-num  = parshift-num  no-lock no-error.
    10069       if not available bf_shift-obj then do:
    10070         return error substitute ("Нет смены по объекту &1 &2 дата &3 порядок &4.", parobj-type, parobj-code, parshift-date, parshift-num).
    10071       end.
    10072       assign
    10073         parshift-name     = bf_shift-obj.shift-name
    10074         parshift-name-num = (if parshift-num = integer(parshift-num) then parshift-name else bf_shift-obj.shift-name + "(" + string(bf_shift-obj.shift-num) + ")").
    10075     end.
    10076   end procedure.
    10077   procedure lib-trn3_shiftnme :
    10078     define input  parameter parobj-type       like ub.clients.obj-type     no-undo.
    10079     define input  parameter parobj-code       like ub.clients.obj-code     no-undo.
    10080     define input  parameter parshift-date     like ub.shift-obj.shift-date no-undo.
    10081     define input  parameter parshift-num      like ub.shift-obj.shift-num  no-undo.
    10082     define input-output parameter parshift-name     as   character               no-undo.
    10083     define output parameter parshift-name-num as   character               no-undo.
    10084     define buffer bf_shift-obj   for ub.shift-obj.
    10085     define buffer bf_shift-staff for ub.shift-staff.
    10086     do on error undo, return error return-value :
    10087       find first bf_shift-obj where bf_shift-obj.obj-type   = parobj-type   and
    10088                                     bf_shift-obj.obj-code   = parobj-code   and
    10089                                     bf_shift-obj.shift-date = parshift-date and
    10090                                     bf_shift-obj.shift-num  = parshift-num  no-lock no-error.
    10091       if not available bf_shift-obj then do:
    10092         assign
    10093         parshift-name = parshift-name
    10094         parshift-name-num = (if parshift-num = integer(parshift-name) then parshift-name else (parshift-name + "(" + string(parshift-num) + ")")).
    10095       end.
    10096       else do:
    10097         assign
    10098         parshift-name     = bf_shift-obj.shift-name
    10099         parshift-name-num = (if bf_shift-obj.shift-num = integer(bf_shift-obj.shift-name)
    10100                              then bf_shift-obj.shift-name
    10101                              else bf_shift-obj.shift-name + "(" + string(bf_shift-obj.shift-num) + ")").
    10102       end.
    10103     end.
    10104   end procedure.
    10105   procedure lib-trn3_rvschtrn :
    10106     define  input parameter p-obj-type   as character no-undo .
    10107     define  input parameter p-obj-code   as integer   no-undo .
