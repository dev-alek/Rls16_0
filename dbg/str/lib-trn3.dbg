     2683       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     2684       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     2685       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     2686       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     2687       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     2688       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     2689       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     2690       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     2691       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     2692       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     2693       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     2694       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     2695       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     2696       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     2697       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     2698       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     2699       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     2700       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     2701       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     2702       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     2703       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     2704       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     2705       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     2706       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     2707       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     2708       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     2709       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     2710       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     2711       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     2712       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     2713       .
     2714   end.
     2715   otherwise do:
     2716     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     2717                              cl_tt-clcparts.purch-code,
     2718                              cl_tt-clcparts.part-code,
     2719                              cl_tt-clcparts.out-code,
     2720                              cl_tt-clcparts.in-code,
     2721                              cl_tt-clcparts.artic,
     2722                              cl_tt-clcparts.prod-type,
     2723                              cl_tt-clcparts.prod-code).
     2724   end.
     2725   end case.
     2726   end.
     2727   end procedure.
     2728   procedure clcprtsl_calc-line :
     2729   define input  parameter parrec-line as recid no-undo.
     2730   define variable v-tax-date         as   date                     no-undo.
     2731   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2732   define variable varr-b             as   character                no-undo.
     2733   define variable varr-btype         as   character                no-undo.
     2734   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2735   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2736   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2737   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2738   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2739   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2740   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2741   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2742   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2743   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2744   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2745   define variable varexcise          like ub.price-list.excise     no-undo.
     2746   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2747   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2748   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2749   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2750   define variable v-varsum           as decimal                  no-undo.
     2751   define variable varprice-salef as decimal   no-undo .
     2752   define buffer bf_trn-doc             for ub.trn-doc.
     2753   define buffer bf_doc-line            for ub.doc-line.
     2754   define buffer bf_gds-dtl             for ub.gds-dtl.
     2755   define buffer bf_goods               for ub.goods.
     2756   define buffer bf_parts               for ub.parts.
     2757   define buffer bf_sysconf             for ub.sysconf.
     2758   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2759   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2760   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2761   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2762   define buffer buf_parts        for ub.parts.
     2763   v-calcbypart = no.
     2764   do on error undo, return error return-value :
     2765   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2766   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2767     (output varr-b
     2768     )  .
     2769     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2770     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2771     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2772                               bf_goods.prod-type = bf_doc-line.prod-type and
     2773                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2774     if bf_trn-doc.fact-date <> ?        then do:
     2775       assign v-tax-date = bf_trn-doc.fact-date.
     2776     end.
     2777     else do:
     2778       assign v-tax-date = ?.
     2779     end.
     2780   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2781   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2782     (input  bf_goods.gds-code
     2783     ,input  '1':U
     2784     ,input  v-tax-date
     2785     ,input  bf_trn-doc.host-code
     2786     ,input  bf_trn-doc.obj-type
     2787     ,input  bf_trn-doc.obj-code
     2788     ,output v-vat-pc
     2789     ) no-error .
     2790     if error-status :error
     2791     or v-vat-pc = ? then do:
     2792        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2793     end.
     2794     if bf_goods.gds-type = 'у':U or
     2795        bf_trn-doc.status_ = 'запрос':U then do:
     2796       for each bf_tt-allsum-line
     2797       on error undo, return error return-value
     2798        :
     2799         delete bf_tt-allsum-line.
     2800       end.
     2801       create bf_tt-allsum-line.
     2802       assign
     2803        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2804       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2805                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2806                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2807                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2808         assign
     2809           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2810           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2811           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2812           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2813           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2814           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2815           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2816           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2817           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2818           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2819           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2820           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2821           bf_tt-allsum-line.vat-cli-acc          =  ?
     2822           .
     2823       end.
     2824       assign
     2825         bf_tt-allsum-line.cli-qnty             =  ?
     2826         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2827         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2828         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2829         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2830         bf_tt-allsum-line.road-tax-base-doc    =  0
     2831         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2832         bf_tt-allsum-line.excise-base-doc      =  0
     2833         bf_tt-allsum-line.excise-rubl-doc      =  0
     2834         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2835         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2836         bf_tt-allsum-line.dsc-base-cur         =  0
     2837         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2838         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2839         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2840         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2841         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2842         bf_tt-allsum-line.road-tax-base-cur    =  0
     2843         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2844         bf_tt-allsum-line.excise-base-cur      =  0
     2845         bf_tt-allsum-line.excise-rubl-cur      =  0
     2846         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2847         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2848         bf_tt-allsum-line.dsc-base-acc         =  0
     2849         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2850         bf_tt-allsum-line.dsc-cli-acc          =  0
     2851         bf_tt-allsum-line.slt-base-acc         =  0
     2852         bf_tt-allsum-line.slt-rubl-acc         =  0
     2853         bf_tt-allsum-line.slt-cli-acc          =  0
     2854         bf_tt-allsum-line.road-tax-base-acc    =  0
     2855         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2856         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2857         bf_tt-allsum-line.excise-base-acc      =  0
     2858         bf_tt-allsum-line.excise-rubl-acc      =  0
     2859         bf_tt-allsum-line.excise-cli-acc       =  0
     2860         bf_tt-allsum-line.transport-base-acc   =  0
     2861         bf_tt-allsum-line.transport-rubl-acc   =  0
     2862         bf_tt-allsum-line.transport-cli-acc    =  0
     2863         bf_tt-allsum-line.other-base-acc       =  0
     2864         bf_tt-allsum-line.other-rubl-acc       =  0
     2865         bf_tt-allsum-line.other-cli-acc        =  0
     2866         .
     2867       create bfs_tt-allsum-line.
     2868       assign
     2869       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2870       if bf_trn-doc.doc-type = 'инв':U or
     2871          bf_trn-doc.doc-type = 'при':U    or
     2872          bf_trn-doc.doc-type = 'возврат':U    then do:
     2873          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     2874       end.
     2875       else do:
     2876         assign
     2877           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     2878           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     2879           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     2880           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     2881           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     2882           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     2883           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     2884           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     2885           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     2886           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     2887           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     2888           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     2889           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     2890           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     2891           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     2892           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     2893           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     2894           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     2895           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     2896           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     2897           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     2898           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     2899           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     2900           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     2901           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     2902           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     2903           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     2904           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     2905           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     2906           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     2907           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     2908           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     2909           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     2910           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     2911           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     2912           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     2913           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     2914           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     2915           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     2916           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     2917           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     2918           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     2919           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
