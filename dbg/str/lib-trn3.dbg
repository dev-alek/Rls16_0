     5548     run adm/shattri.p (
     5549         input "get":U
     5550         ,input  p-obj-type
     5551         ,input  p-obj-code
     5552         ,input  'scale-inf':U
     5553         ,input  'scallist':U
     5554         ,output v-value-character
     5555         ,output v-value-date
     5556         ,output v-value-decimal
     5557         ,output v-value-integer
     5558         ,output v-value-logical
     5559         ,output v-param-type
     5560         ,INPUT-OUTPUT table-handle v-tth
     5561         ) no-error .
     5562     scallist = v-value-character.
     5563     delete object v-tth.
     5564     for each buf_temp-add-scal:
     5565       delete buf_temp-add-scal.
     5566     end.
     5567   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     5569     (input  p-obj-type
     5570     ,input  p-obj-code
     5571     ,output v-obj-db-num
     5572     )  .
     5573     m-d:
     5574     do transaction on error undo m-d, return error "Ошибка при обновлении информации на весах.":
     5575       if p-doc-type <> 'переоценка':U then do:
     5576         run waitfram-show in p-add-scal-handle  (  "Добавление товаров на весы по привязанным группам товаров." ) .
     5577         find first buf_trn-doc no-lock where
     5578                   buf_trn-doc.doc-code = d-c no-error .
     5579         if error-status:error then return error substitute("Не найден документ &1", d-c).
     5580         _doc-line:
     5581         FOR EACH as_doc-line WHERE
     5582                  as_doc-line.doc-code = d-c AND
     5583                  as_doc-line.fact-qnty > 0    NO-LOCK,
     5584             FIRST as_goods WHERE
     5585                   as_goods.artic = as_doc-line.artic AND
     5586                   as_goods.prod-type = as_doc-line.prod-type AND
     5587                   as_goods.prod-code = as_doc-line.prod-code      NO-LOCK,
     5588            FIRST as_units no-lock where as_units.unit-name = as_goods.unit-base
     5589         on error undo m-d, return error return-value
     5590            :
     5591             if ii modulo 10 = 0 then do:
     5592               run waitfram-show in p-add-scal-handle  ( input "Обработано товаров : " + string( ii )).
     5593             end.
     5594            if lookup( 'у':U, as_goods.gds-type ) > 0 then  NEXT _doc-line.
     5595            if lookup( 'вес':U, as_units.type ) = 0 then  NEXT _doc-line.
     5596   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5597     (input  as_goods.gds-code
     5598     ,input  ?
     5599     ,output v-b-code
     5600     )  .
     5601            create buf_temp-add-scal.
     5602            buffer-copy as_doc-line
     5603            to buf_temp-add-scal
     5604            assign
     5605            buf_temp-add-scal.gds-code = as_goods.gds-code
     5606            buf_temp-add-scal.b-code = v-b-code
     5607            buf_temp-add-scal.unit-base = as_goods.unit-base
     5608            buf_temp-add-scal.grp-code = as_goods.grp-code
     5609            buf_temp-add-scal.deadline = as_goods.deadline
     5610            .
     5611          end.
     5612        end.
     5613        if p-doc-type = 'переоценка':U then do:
     5614          _price-list:
     5615          FOR EACH as_price-list no-lock WHERE
     5616                  as_price-list.doc-num = d-c
     5617               and as_price-list.main-price = yes,
     5618            FIRST as_goods no-lock WHERE
     5619                   as_goods.artic     = as_price-list.artic
     5620               AND as_goods.prod-type = as_price-list.prod-type
     5621               AND as_goods.prod-code = as_price-list.prod-code,
     5622            FIRST as_gds-obj no-lock where
     5623                   as_gds-obj.gds-code = as_goods.gds-code
     5624               AND as_gds-obj.obj-type = as_price-list.obj-type
     5625               AND as_gds-obj.obj-code = as_price-list.obj-code,
     5626            FIRST as_units no-lock where as_units.unit-name = as_goods.unit-base
     5627           on error undo m-d, return error return-value  :
     5628           if ii modulo 10 = 0 then do:
     5629             run waitfram-show in p-add-scal-handle  ( input "Обработано товаров : " + string( ii )).
     5630           end.
     5631            if lookup( 'вес':U, as_units.type ) = 0 then  NEXT _price-list.
     5632            if lookup( 'у':U, as_goods.gds-type ) > 0 then  NEXT _price-list.
     5633   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5634     (input  as_goods.gds-code
     5635     ,input  ?
     5636     ,output v-b-code
     5637     )  .
     5638            create buf_temp-add-scal.
     5639            buffer-copy as_price-list
     5640            to buf_temp-add-scal
     5641            assign
     5642            buf_temp-add-scal.gds-code = as_goods.gds-code
     5643            buf_temp-add-scal.doc-code = as_gds-obj.in-code
     5644            buf_temp-add-scal.b-code = v-b-code
     5645            buf_temp-add-scal.grp-code = as_goods.grp-code
     5646            buf_temp-add-scal.deadline = as_goods.deadline
     5647            buf_temp-add-scal.unit-base = as_goods.unit-base
     5648            .
     5649           end.
     5650         end.
     5651         if p-doc-type <> 'переоценка':U then do:
     5652           _scales:
     5653           for each buf_temp-add-scal,
     5654               each as_scales-grp exclusive-lock where
     5655                   as_scales-grp.node-code = buf_temp-add-scal.grp-code
     5656               and  as_scales-grp.db-num = v-obj-db-num  ,
     5657               first as_scales exclusive-lock where
     5658                   as_scales.db-num = v-obj-db-num
     5659               and as_scales.scales-num = as_scales-grp.scales-num
     5660               and as_scales.master = 0
     5661           on error undo m-d, return error return-value :
     5662             if scallist <> "":U and lookup(string(as_scales.scales-num), scallist) = 0 then NEXT _scales.
     5663             if buf_temp-add-scal.unit-base <> as_scales.unit-base then NEXT _scales.
     5664             find first as_scales-gds where
     5665                       as_scales-gds.scales-num = as_scales.scales-num
     5666                   and as_scales-gds.db-num = v-obj-db-num
     5667                   and as_scales-gds.b-code     = buf_temp-add-scal.b-code  no-lock no-error.
     5668             if not available as_scales-gds then do:
     5669               find first as_bar-code no-lock where
     5670                         as_bar-code.b-code = buf_temp-add-scal.b-code .
     5671                             run ref/ves-pbc.p (
     5672                                             input parparentproc
     5673                                           , input 'ДОБАВЛЕНИЕ':U
     5674                                           , input p-obj-type
     5675                                           , input p-obj-code
     5676                                           , input (if sclin-ld > 0 then ? else buf_temp-add-scal.deadline)
     5677                                           , input (if sclin-ld > 0 then (buf_temp-add-scal.last-date - 01/01/2000 + 1) * 24 else ?)
     5678                                           , input (if sclin-ld > 0 then integer('1':U) else integer('0':U))
     5679                                           , input 0
     5680                                           , buffer as_bar-code
     5681                                           , buffer as_scales) no-error.
     5682               if error-status:error then do:
     5683                 run waitfram-hide in p-add-scal-handle  .
     5684                 undo m-d, return error .
     5685               end.
     5686             end.
     5687           end.
     5688           if sclin-ld = 0 then return.
     5689         end.
     5690         if sclin-ld > 0 then do:
     5691           _parts:
     5692           for each buf_temp-add-scal,
     5693               each buf_parts no-lock where
     5694                   buf_parts.obj-type  = p-obj-type
     5695               and buf_parts.obj-code  = p-obj-code
     5696               and buf_parts.artic     = buf_temp-add-scal.artic
     5697               and buf_parts.prod-type = buf_temp-add-scal.prod-type
     5698               and buf_parts.prod-code = buf_temp-add-scal.prod-code
     5699               and buf_parts.out-code  = buf_temp-add-scal.doc-code
     5700           on error undo m-d, return error return-value :
     5701             if buf_parts.last-date = ? then next _parts.
     5702             assign
     5703             buf_temp-add-scal.last-date = (if buf_temp-add-scal.last-date = ?
     5704                                             or (buf_temp-add-scal.last-date <> ?
     5705                                                 and sclin-ld = 1
     5706                                                 and buf_temp-add-scal.last-date > buf_parts.last-date)
     5707                                             or (buf_temp-add-scal.last-date <> ?
     5708                                                 and sclin-ld = 2
     5709                                                 and buf_temp-add-scal.last-date < buf_parts.last-date)
     5710                                                 then buf_parts.last-date
     5711                                                 else buf_temp-add-scal.last-date)
     5712             .
     5713           end.
     5714         end.
     5715         _scales:
     5716         for each buf_temp-add-scal:
     5717           for each as_scales-gds no-lock WHERE
     5718              as_scales-gds.b-code = buf_temp-add-scal.b-code
     5719           and as_scales-gds.db-num = v-obj-db-num
     5720           and as_scales-gds.obj-type = p-obj-type
     5721           and as_scales-gds.obj-code = p-obj-code  ,
     5722           first as_scales Exclusive-lock where
     5723                as_scales.scales-num = as_scales-gds.scales-num
     5724            and as_scales.db-num = as_scales-gds.db-num,
     5725           first as_bar-code no-lock where
     5726                   as_bar-code.b-code = as_scales-gds.b-code
     5727          on error undo m-d, return error return-value :
     5728             run ref/ves-pbc.p (
     5729                             input parparentproc
     5730                           , input 'ИЗМЕНЕНИЕ':U
     5731                           , input p-obj-type
     5732                           , input p-obj-code
     5733                           , input (if sclin-ld > 0 then ? else as_scales-gds.deadline)
     5734                           , input (if sclin-ld > 0 then (buf_temp-add-scal.last-date - 01/01/2000 + 1) * 24 else ?)
     5735                           , input (if sclin-ld > 0 then integer('1':U) else integer('0':U))
     5736                           , input 0
     5737                           , buffer as_bar-code
     5738                           , buffer as_scales) no-error.
     5739             if error-status:error then do:
     5740               run waitfram-hide in p-add-scal-handle  .
     5741               undo m-d, return error .
     5742             end.
     5743           end.
     5744         end.
     5745     end.
     5746     run waitfram-hide in p-add-scal-handle  .
     5747   end procedure .
     5748   procedure lib-trn3_clr-line :
     5749     define input parameter parmain-menu-handle as   handle                no-undo.
     5750     define input parameter pardoc-code         like ub.doc-line.doc-code  no-undo.
     5751     define input parameter parartic            like ub.doc-line.artic     no-undo.
     5752     define input parameter parprod-type        like ub.doc-line.prod-type no-undo.
     5753     define input parameter parprod-code        like ub.doc-line.prod-code no-undo.
     5754     define input parameter fnc                 as   character             no-undo.
     5755     define variable chg-qnty        as decimal   no-undo.
     5756     define variable pl-chg-qnty     as decimal   no-undo.
     5757     define variable mem-pl-chg-qnty as decimal   no-undo.
     5758     define variable varterminal-prt as logical   no-undo.
     5759     define variable r-rec-inv-line  as recid     no-undo.
     5760     define variable is-petrol       as logical   no-undo.
     5761     define variable is-pieces       as logical   no-undo.
     5762     define variable v-ptrl          as logical   no-undo.
     5763     define variable v-b-code        as integer   no-undo .
     5764     define buffer buf_goods   for ub.goods .
     5765     define buffer bf_doc-line for ub.doc-line.
     5766     define buffer bf_gds-dtl  for ub.gds-dtl.
     5767     define buffer bf_prt-obj  for ub.prt-obj.
     5768     define buffer bf_inv-line for ub.inv-line.
     5769     define buffer bf_pl-gds   for ub.pl-gds.
     5770     define buffer buf_doc-pl  for ub.doc-pl .
     5771     define buffer buf_chk-gds for ub.chk-gds.
     5772     tr:
     5773     do transaction
     5774     on error undo tr, return error return-value
     5775     :
     5776   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     5777     (
     5778        input parartic
     5779     ,  input parprod-type
     5780     ,  input parprod-code
     5781     , output is-petrol
     5782     , output is-pieces
     5783     ) no-error.
     5784       assign
     5785         v-ptrl = ( if not error-status :error and is-petrol = yes and is-pieces = no then yes else no )
     5786       .
     5787       find first bf_doc-line exclusive-lock
     5788         where bf_doc-line.doc-code  = pardoc-code
     5789           and bf_doc-line.artic     = parartic
     5790           and bf_doc-line.prod-type = parprod-type
     5791           and bf_doc-line.prod-code = parprod-code
     5792         .
     5793       find first buf_goods exclusive-lock
     5794         where buf_goods.artic     = bf_doc-line.artic
     5795           and buf_goods.prod-type = bf_doc-line.prod-type
     5796           and buf_goods.prod-code = bf_doc-line.prod-code
     5797         .
     5798       if v-ptrl = yes then do:
     5799         find first bf_inv-line no-lock
     5800           where bf_inv-line.doc-code  = bf_doc-line.doc-code
     5801             and bf_inv-line.artic     = bf_doc-line.artic
     5802             and bf_inv-line.prod-type = bf_doc-line.prod-type
     5803             and bf_inv-line.prod-code = bf_doc-line.prod-code
     5804           no-error.
     5805         if available bf_inv-line then do:
     5806           assign
     5807             r-rec-inv-line = recid( bf_inv-line )
     5808           .
     5809           find first bf_inv-line exclusive-lock where recid( bf_inv-line ) = r-rec-inv-line.
     5810         end.
     5811         else do:
     5812           undo tr, return error substitute( 'Не найдена строка итогов в кг по топливу. Документ "&1", топливо &2 (&3 &4)',
     5813                                             pardoc-code,
     5814                                             parartic,
     5815                                             parprod-type,
     5816                                             parprod-code
     5817                                           ).
     5818         end.
     5819       end.
     5820       run trg/rsrv-del.p
     5821         ( input bf_doc-line.doc-code
     5822         , input bf_doc-line.artic
     5823         , input bf_doc-line.prod-type
     5824         , input bf_doc-line.prod-code
     5825         ) no-error.
     5826       if error-status :error then do:
     5827         undo tr, return error return-value.
     5828       end.
     5829       if fnc = "исх":u then do:
     5830         for each bf_gds-dtl
     5831           where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     5832             and bf_gds-dtl.artic     = bf_doc-line.artic
     5833             and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     5834             and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     5835         on error undo tr, return error return-value
     5836         :
     5837           delete bf_gds-dtl.
     5838         end.
     5839         if v-ptrl = yes
     5840           and available bf_inv-line
     5841         then do:
     5842           assign
     5843             bf_inv-line.after-cli-qnty = bf_inv-line.before-cli-qnty
     5844             bf_inv-line.wast-cli-qnty  = bf_inv-line.before-cli-qnty
     5845             bf_doc-line.cli-qnty       = 0
     5846           .
     5847         end.
     5848       end.
     5849       if fnc = "ноль":u then do:
     5850         for each bf_prt-obj where
     5851                  bf_prt-obj.obj-type  = bf_doc-line.obj-type  and
     5852                  bf_prt-obj.obj-code  = bf_doc-line.obj-code  and
     5853                  bf_prt-obj.prod-type = bf_doc-line.prod-type and
     5854                  bf_prt-obj.prod-code = bf_doc-line.prod-code and
     5855                  bf_prt-obj.artic     = bf_doc-line.artic
     5856         on error undo tr, return error return-value
     5857         :
     5858           if bf_prt-obj.fact-qnty = 0
     5859             and v-ptrl <> yes
     5860           then do:
     5861             next.
     5862           end.
     5863   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     5864     (input  bf_prt-obj.prt-code
     5865     ,input  'terminal-prt=request':u
     5866     ,output varterminal-prt
     5867     )  .
     5868           if varterminal-prt <> yes then do:
     5869             next.
     5870           end.
     5871   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     5872     ( input bf_doc-line.obj-code
     5873      ,input bf_doc-line.obj-type
     5874      ,input bf_doc-line.doc-code
     5875      ,input bf_doc-line.artic
     5876      ,input bf_doc-line.prod-code
     5877      ,input bf_doc-line.prod-type
     5878      ,input bf_prt-obj.prt-code
     5879      ,input yes
     5880     ) no-error .
     5881           if error-status :error then do:
     5882               undo tr, return error return-value.
     5883           end.
     5884           find first bf_gds-dtl where
     5885                      bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     5886                      bf_gds-dtl.artic     = bf_doc-line.artic     and
     5887                      bf_gds-dtl.prod-code = bf_doc-line.prod-code and
     5888                      bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     5889                      bf_gds-dtl.prt-code  = bf_prt-obj.prt-code.
     5890           assign
     5891             chg-qnty = - bf_prt-obj.fact-qnty
     5892           .
     5893           if v-ptrl = yes then do:
     5894             assign
     5895               pl-chg-qnty = 0
     5896             .
     5897             for each bf_pl-gds
     5898               where bf_pl-gds.gds-code = buf_goods.gds-code
     5899                 and bf_pl-gds.obj-type = bf_gds-dtl.obj-type
     5900                 and bf_pl-gds.obj-code = bf_gds-dtl.obj-code
     5901               use-index gds-code
     5902             on error undo tr, return error return-value
     5903             :
     5904               assign
     5905                 pl-chg-qnty = pl-chg-qnty + bf_pl-gds.fact-qnty
     5906               .
     5907             end.
     5908             if pl-chg-qnty <> bf_prt-obj.fact-qnty then do:
     5909               undo tr, return error substitute( 'Документ "&1", топливо &2 (&3 &4): факт.кол-во по резервуарам (&5) НЕ СОВПАДАЕТ c факт.кол-вом на объекте &6 &7 (&8)',
     5910                                                 pardoc-code,
     5911                                                 parartic,
     5912                                                 parprod-type,
     5913                                                 parprod-code,
     5914                                                 pl-chg-qnty,
     5915                                                 bf_gds-dtl.obj-type,
     5916                                                 bf_gds-dtl.obj-code,
     5917                                                 bf_gds-dtl.fact-qnty
     5918                                               ).
     5919             end.
     5920             for each bf_pl-gds exclusive-lock
     5921               where bf_pl-gds.gds-code = buf_goods.gds-code
     5922                 and bf_pl-gds.obj-type = bf_gds-dtl.obj-type
     5923                 and bf_pl-gds.obj-code = bf_gds-dtl.obj-code
     5924               use-index gds-code
     5925             on error undo tr, return error return-value
     5926             :
     5927               assign
     5928                 pl-chg-qnty     = - bf_pl-gds.fact-qnty
     5929                 mem-pl-chg-qnty = pl-chg-qnty
     5930               .
     5931               run trg/rsrv-dtl.p
     5932                 ( input        parmain-menu-handle
     5933                  ,input        'reserv':U + "," + 'plcode':U + "=" + string( bf_pl-gds.pl-code )
     5934                  ,buffer       bf_gds-dtl
     5935                  ,input-output pl-chg-qnty
     5936                  ,input-output bf_doc-line.price-base
     5937                  ,input-output bf_doc-line.price-rubl
     5938                  ,input        -1
     5939                  ,input ""
     5940                 ).
     5941               if mem-pl-chg-qnty <> pl-chg-qnty then do:
     5942                 undo tr, return error substitute ("Не удалось зарезервировать товар (&1) по месту хранения &2", buf_goods.gds-code, bf_pl-gds.pl-code) .
     5943               end.
     5944               find first buf_doc-pl exclusive-lock
     5945                 where buf_doc-pl.obj-type = bf_pl-gds.obj-type
     5946                   and buf_doc-pl.obj-code = bf_pl-gds.obj-code
     5947                   and buf_doc-pl.pl-code  = bf_pl-gds.pl-code
     5948                   and buf_doc-pl.out-code = bf_doc-line.doc-code
     5949                   and buf_doc-pl.gds-code = buf_goods.gds-code
     5950                 no-error .
     5951               if not available buf_doc-pl then do:
     5952                 undo tr, return error substitute ("В документе отсутствует запись о месте хранения &2 товара &1", buf_goods.gds-code, bf_pl-gds.pl-code) .
     5953               end.
     5954               assign
     5955                 buf_doc-pl.rest-af-qnty     = 0.0
     5956                 buf_doc-pl.cli-rest-af-qnty = 0.0
     5957                 buf_doc-pl.fact-qnty        = (- buf_doc-pl.rest-bf-qnty)
     5958                 buf_doc-pl.cli-fact-qnty    = (- buf_doc-pl.cli-rest-bf-qnty)
     5959                 buf_doc-pl.doc-qnty         = buf_doc-pl.fact-qnty
     5960                 buf_doc-pl.cli-doc-qnty     = buf_doc-pl.cli-fact-qnty
     5961                 buf_doc-pl.cli-qnty         = buf_doc-pl.cli-doc-qnty
     5962               .
     5963             end.
     5964           end.
     5965           else do:
     5966             run trg/rsrv-dtl.p
     5967               ( input        parmain-menu-handle
     5968                ,input        'reserv':U
     5969                ,buffer       bf_gds-dtl
     5970                ,input-output chg-qnty
     5971                ,input-output bf_doc-line.price-base
     5972                ,input-output bf_doc-line.price-rubl
     5973                ,input        -1
     5974                ,input ""
     5975              ).
     5976           end.
     5977           assign
     5978             bf_gds-dtl.doc-qnty   = chg-qnty
     5979             bf_gds-dtl.fact-qnty  = 0
     5980             bf_doc-line.fact-qnty = bf_doc-line.fact-qnty + chg-qnty
     5981             bf_doc-line.doc-qnty  = 0
     5982             bf_doc-line.prt-ok    = yes
     5983           .
     5984           if v-ptrl = yes
     5985             and available bf_inv-line
     5986           then do:
     5987             assign
     5988               bf_doc-line.cli-qnty       = - bf_inv-line.before-cli-qnty
     5989               bf_inv-line.wast-cli-qnty  = 0
     5990               bf_inv-line.after-cli-qnty = bf_inv-line.wast-cli-qnty
     5991             .
     5992           end.
     5993   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5994     (input  buf_goods.gds-code
     5995     ,input  bf_gds-dtl.prt-code
     5996     ,output v-b-code
     5997     ) no-error .
     5998           if error-status :error then do:
     5999             undo tr, return error return-value.
     6000           end.
     6001           for each buf_chk-gds where
     6002                   buf_chk-gds.out-code = bf_gds-dtl.doc-code
     6003              and  buf_chk-gds.b-code   = v-b-code
     6004           on error undo tr, return error return-value :
     6005             assign
     6006             buf_chk-gds.is-error = yes
     6007             .
     6008           end.
     6009         end.
     6010         if error-status :error then do:
     6011           undo tr, return error return-value.
     6012         end.
     6013       end.
     6014       if ( fnc = "исх":u
     6015            or fnc = "ноль":u
     6016          )
     6017         and v-ptrl = yes
     6018         and available bf_inv-line
     6019       then do:
     6020         if bf_doc-line.doc-qnty <> 0.0
     6021           and bf_inv-line.wast-cli-qnty <> 0.0
     6022         then do:
     6023           assign
     6024             bf_doc-line.doc-density = bf_inv-line.wast-cli-qnty / bf_doc-line.doc-qnty
     6025           .
     6026         end.
     6027         else do:
     6028           if valid-density( bf_doc-line.doc-density, (buf_goods.unit-base = buf_goods.unit-cli) ) <> true then do:
     6029             assign
     6030               bf_doc-line.doc-density = 1.0 / buf_goods.cli-base-rate
     6031             .
     6032             if valid-density( bf_doc-line.doc-density, (buf_goods.unit-base = buf_goods.unit-cli) ) <> true then do:
     6033               undo tr, return error substitute( 'В карточке товара указан некорректный коэффициент единиц измерения поставщика.&1'
     6034                                                 + 'Невозможно установить плотность товара.&1'
     6035                                                 + 'Документ: &2&1'
     6036                                                 + 'Код товара: &3&1'
     6037                                                 + 'Плотность: &4&1'
     6038                                                 ,chr(10)
     6039                                                 ,bf_doc-line.doc-code
     6040                                                 ,buf_goods.gds-code
     6041                                                 ,bf_doc-line.doc-density
     6042                                               ).
     6043             end.
     6044           end .
     6045         end.
     6046         assign
     6047           bf_doc-line.fact-density = bf_doc-line.doc-density
     6048         .
     6049       end.
     6050     end.
     6051   end procedure.
     6052   procedure lib-trn3_adinvdoc:
     6053   define input  parameter parobj-type like ub.clients.obj-type no-undo.
     6054   define input  parameter parobj-code like ub.clients.obj-code no-undo.
     6055   define input  parameter paruserid   as   character           no-undo.
     6056   define output parameter parrecid    as   recid               no-undo.
     6057   define variable vardoc-code   like ub.trn-doc.doc-code       no-undo.
     6058   define variable varinv-pay    like ub.shop.inv-pay           no-undo.
     6059   define variable varhost-code  like ub.sysconf.host-code      no-undo.
     6060   define variable v-today       as date                        no-undo.
     6061   define buffer bf_shop       for ub.shop.
     6062   define buffer bf_store      for ub.store.
     6063   define buffer bf_pay-type   for ub.pay-type.
     6064   define buffer bf_trn-doc    for ub.trn-doc.
     6065   define buffer bf_curr-accnt for ub.curr-accnt.
     6066   define buffer bf_sysconf    for ub.sysconf.
     6067   define buffer bf_sys-ctrl   for ub.sys-ctrl.
     6068   define buffer bf_clients    for ub.clients.
     6069   do on error undo, return error return-value :
     6070   find first bf_sys-ctrl no-lock.
     6071   case parobj-type:
     6072   when 'маг':U then do:
     6073     find first bf_shop where bf_shop.obj-code = parobj-code no-lock.
     6074     assign
     6075       varinv-pay   = bf_shop.inv-pay
     6076       varhost-code = bf_shop.host-code.
     6077   end.
     6078   when 'скл':U then do:
     6079     find first bf_store where bf_store.obj-code = parobj-code no-lock.
     6080     assign
     6081       varinv-pay   = bf_store.inv-pay
     6082       varhost-code = bf_store.host-code.
     6083   end.
     6084   otherwise do:
     6085     return error substitute ("Неверный тип объекта учета &1.", parobj-type).
     6086   end.
     6087   end case.
     6088   find first bf_sysconf where bf_sysconf.host-code = varhost-code no-lock.
     6089   find first bf_clients where bf_clients.obj-type = 'орг':U               and
     6090                               bf_clients.obj-code = bf_sysconf.host-code no-lock.
     6091   if not can-find (bf_pay-type where bf_pay-type.obj-code = varinv-pay no-lock) then do:
     6092     return error "Не задан код оплаты для инвентаризации в настройках по текущему объекту.".
     6093   end.
     6094   run doc-code
     6095   (input  "main",
     6096    input  parobj-type,
     6097    input  parobj-code,
     6098    input  ?,
     6099    output vardoc-code ) no-error.
     6100   if error-status:error then do:
     6101     message "Ошибка при генерации номера документа." skip
     6102             return-value
     6103     view-as alert-box.
     6104     return error.
     6105   end.
