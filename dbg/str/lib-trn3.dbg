     3689   procedure get-ptrl-prop :
     3690     define input  parameter p-obj-type as character no-undo .
     3691     define input  parameter p-obj-code as integer   no-undo .
     3692     do
     3693     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3694     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     3695     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     3696     :
     3697       define variable par-type          as character no-undo.
     3698       define variable v-value-character as character no-undo .
     3699       define variable v-value-date      as date      no-undo .
     3700       define variable v-value-decimal   as decimal   no-undo .
     3701       define variable v-value-integer   as integer   no-undo .
     3702       define variable v-value-logical   as logical   no-undo .
     3703       for each thbjattr_thbj-attr
     3704       :
     3705         delete thbjattr_thbj-attr .
     3706       end.
     3707       run adm/shattri.p
     3708         ( input "get":U
     3709         , input p-obj-type
     3710         , input p-obj-code
     3711         , input 'petrol':U
     3712         , input  ""
     3713         , output v-value-character
     3714         , output v-value-date
     3715         , output v-value-decimal
     3716         , output v-value-integer
     3717         , output v-value-logical
     3718         , output par-type
     3719         , input-output table thbjattr_thbj-attr
     3720         ) no-error .
     3721       for each thbjattr_thbj-attr
     3722       on error undo, return error return-value
     3723       :
     3724         case thbjattr_thbj-attr.prop-code :
     3725           when 'denstclc':U then do:
     3726             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     3727               assign
     3728                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
     3729               .
     3730             end.
     3731           end.
     3732           when 'expptrl':U then do:
     3733             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     3734               and thbjattr_thbj-attr.prop-value-type = 'character':U
     3735             then do:
     3736               assign
     3737                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
     3738               .
     3739             end.
     3740           end.
     3741           when 'inpptrl':U then do:
     3742             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     3743               and thbjattr_thbj-attr.prop-value-type = 'character':U
     3744             then do:
     3745               assign
     3746                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
     3747               .
     3748             end.
     3749           end.
