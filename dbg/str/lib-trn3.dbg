     4665             buf_gds-obj-attr.obj-type = temp-tpsi-clients.obj-type
     4666         AND buf_gds-obj-attr.obj-code = temp-tpsi-clients.obj-code
     4667         AND buf_gds-obj-attr.gds-code = p-gds-code
     4668         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
