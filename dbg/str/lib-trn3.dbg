      694   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      695   procedure doc-code:
      696   define input  parameter parmode          as   character           no-undo.
      697   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      698   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      699   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      700   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      701   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      702   define variable vardb-remote     as   logical             no-undo.
      703   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      704   define variable v-delimiter as character no-undo .
      705   do
      706   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      707   :
      708   find first buf_sys-ctrl no-lock .
      709   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      710     CASE parmode:
      711       when "main":u then do:
      712         if vardb-remote then do:
      713           assign
      714             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      715         end.
      716         else do:
      717           assign
      718             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      719         end.
      720       end.
      721       when "trio" then do:
      722         assign
      723           pardoc-code = replace (parroot-doc-code, "=", "*").
      724       end.
      725       otherwise do:
      726         assign
      727         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      728         no-error
      729         .
      730         if error-status:error  then do:
      731           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      732                                         ,chr(10)
      733                                         ,parmode
      734                                         ).
      735         end.
      736         if num-entries(parmode) = 1
      737         and parmode <> "chip":U
      738         and parmode <> "chip_s":U
      739         then do:
      740           assign
      741           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      742         end.
      743         else if (lookup("chip":U, parmode) > 0
      744                  or
      745                  lookup("chip_s":U, parmode) > 0) then do:
      746           assign
      747             vartemp-doc-code = parroot-doc-code.
      748           do while true:
      749             if index (vartemp-doc-code , ".") = 0 then
      750               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      751             else
      752               vartemp-doc-code  =
      753               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      754               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      755               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      756             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      757           end.
      758           assign
      759             pardoc-code = vartemp-doc-code.
      760         end.
      761       end.
      762     end CASE.
      763     if pardoc-code = '':U
      764     or (parroot-doc-code <> '':U
      765     and pardoc-code = parroot-doc-code) then do:
      766       undo, return error substitute("Ошибка при генерации номера документа&1"
      767                                     ,chr(10)).
      768     end.
      769   end.
      770   end. // procedure/method
      771   function get-doc-code-int64 returns int64
      772     ( input p-doc-code as character ) :
      773     define variable v-ind              as integer   no-undo .
      774     define variable v-num-entries      as integer   no-undo .
      775     define variable v-doc-code-int64   as int64     no-undo .
      776     define variable v-canonic-doc-code as character no-undo .
      777     assign
      778       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      779       v-canonic-doc-code = p-doc-code
      780     .
      781     do v-ind = 1 to v-num-entries
      782     :
      783       assign
      784         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      785       .
      786     end.
      787     assign
      788       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      789     .
      790     return v-doc-code-int64 .
      791   end. // function/method
      792   procedure plgdsfnd :
      793     define input  parameter p-chk-and-chs    as logical               no-undo .
      794     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      795     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      796     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      797     define output parameter p-reserv-pl-code as   logical             no-undo .
      798     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      799     define buffer buf_goods         for ub.goods .
      800     define buffer buf_pl-gds        for ub.pl-gds .
      801     define buffer buf_second_pl-gds for ub.pl-gds .
      802     find first buf_goods no-lock where
      803                buf_goods.gds-code = p-gds-code no-error .
      804     if not available buf_goods
      805     then do:
      806       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      807     end.
      808   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      809   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      810     (input  p-obj-type
      811     ,input  p-obj-code
      812     ,input  buf_goods.artic
      813     ,input  buf_goods.prod-type
      814     ,input  buf_goods.prod-code
      815     ,input  'place-rsrv=request'
      816     ,output p-reserv-pl-code
      817     ) no-error .
      818     if error-status :error
      819     then do:
      820       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
      821     end.
      822     if p-reserv-pl-code = no
      823     then do:
      824       return .
      825     end.
      826     if p-chk-and-chs <> yes
      827     then do:
      828       return .
      829     end.
      830     find first buf_pl-gds no-lock where
      831                buf_pl-gds.obj-type = p-obj-type and
      832                buf_pl-gds.obj-code = p-obj-code and
      833                buf_pl-gds.gds-code = p-gds-code no-error .
      834     if not available buf_pl-gds
      835     then do:
      836       return error "К товару не привязано ни одного места хранения" .
      837     end.
      838     find first buf_second_pl-gds no-lock where
      839                buf_second_pl-gds.obj-type  = p-obj-type          and
      840                buf_second_pl-gds.obj-code  = p-obj-code          and
      841                buf_second_pl-gds.gds-code  = p-gds-code          and
      842                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
      843     if not available buf_second_pl-gds
      844     then do:
      845       assign
      846         p-pl-code = buf_pl-gds.pl-code
      847       .
      848     end.
      849     else do:
      850       return error "Не выбрано место хранения " + chr(10) .
      851     end.
      852   end procedure.
      853     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
      854       define variable v-answ as logical no-undo .
      855       if ( p-unit-base-cli-eq = true
      856            and p-density = 1.0
      857          )
      858         or ( p-unit-base-cli-eq = false
      859              and p-density <> ?
      860              and p-density > 0.0
      861              and p-density < 1.0
      862            )
      863       then do:
      864         assign
      865           v-answ = true
      866         .
      867       end.
      868       else do:
      869         assign
      870           v-answ = false
      871         .
      872       end.
      873       return v-answ.
      874     end function.
      875   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      876   procedure factord :
      877     define input  parameter p-fact-date            as date    no-undo .
      878     define input  parameter p-fact-time            as integer no-undo .
      879     define input  parameter p-fact-num             as integer no-undo .
      880     define input  parameter p-shift-date           as date    no-undo .
      881     define input  parameter p-shift-num            as integer no-undo .
      882     define input  parameter p-shift-on             as logical no-undo .
      883     define output parameter p-fact-order           as decimal no-undo .
      884     define output parameter p-shift-end-fact-order as decimal no-undo .
      885     define output parameter p-day-end-fact-order   as decimal no-undo .
      886     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      887     if p-fact-date = ?
      888     then do:
      889       return error "Не указана фактическая дата" .
      890     end.
      891     define variable v-fact-date-num as integer no-undo .
      892     assign
      893       v-fact-date-num = integer(p-fact-date)
      894     .
      895     if p-fact-num = ?
      896     or p-fact-num = 0
      897     then do:
      898       return error "Не задан p-fact-num " + string(p-fact-num) .
      899     end.
      900     if p-fact-num < 0
      901     then do:
      902       return error "Отрицательный fact-num " + string(p-fact-num) .
      903     end.
      904     if p-fact-num >= 100000000
      905     then do:
      906       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      907     end.
      908     if p-shift-on = true
      909     then do:
      910       if p-shift-date = ?
      911       then do:
      912         return error "Не задана дата смены" .
      913       end.
      914       if p-shift-num = ?
      915       or p-shift-num = 0
      916       then do:
      917         return error "Не задан номер смены" .
      918       end.
      919     end.
      920     else do:
      921       assign
      922         p-shift-date = p-fact-date
      923         p-shift-num  = 24
      924       .
      925     end.
      926     define variable v-shift-offset as integer no-undo .
      927     if p-shift-date = p-fact-date
      928     then do:
      929       assign
      930         v-shift-offset = 1
      931       .
      932     end.
      933     if p-shift-date < p-fact-date
      934     then do:
      935       assign
      936         v-shift-offset = 0
      937       .
      938     end.
      939     if p-shift-date > p-fact-date
      940     then do:
      941       message
      942         vss-workfile vss-revision vss-description skip
      943         "Неправильная дата закрытия смены" skip
      944         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      945         view-as alert-box error .
      946       undo, return error
      947         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      948           ,string(p-fact-date, '99/99/9999':U)
      949           ,string(p-shift-date, '99/99/9999':U)
      950           )
      951       .
      952     end.
      953     if p-shift-num < 1
      954     or p-shift-num > 24
      955     then do:
      956       message
      957         vss-workfile vss-revision vss-description skip
      958         "Неправильный номер смены" skip
      959         "p-shift-num" p-shift-num skip
      960         view-as alert-box error .
      961       undo, return error return-value .
      962     end.
      963     assign
      964       p-fact-order           = v-fact-date-num
      965                              + v-shift-offset * 0.5
      966                              + p-shift-num    * 0.02 - 0.01
      967                              + p-fact-num     * 0.0000000001
      968       p-shift-end-fact-order = v-fact-date-num
      969                              + v-shift-offset * 0.5
      970                              + p-shift-num    * 0.02
      971       p-day-end-fact-order   = v-fact-date-num
      972                              + 0.99
      973     .
      974     if p-fact-order           <= v-fact-date-num
      975     or p-shift-end-fact-order <= v-fact-date-num
      976     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      977     or p-shift-end-fact-order >= p-day-end-fact-order
      978     then do:
      979       message
      980         vss-workfile vss-revision vss-description skip
      981         "Внутренняя ошибка при генерации фактического номера" skip
      982         "p-fact-date"            p-fact-date            skip
      983         "p-fact-time"            p-fact-time            skip
      984         "p-fact-num"             p-fact-num             skip
      985         "p-shift-date"           p-shift-date           skip
      986         "p-shift-num"            p-shift-num            skip
      987         "p-shift-on"             p-shift-on             skip
      988         "p-shift-end-fact-order" p-shift-end-fact-order skip
      989         "p-day-end-fact-order"   p-day-end-fact-order   skip
      990         "v-fact-date-num"        v-fact-date-num        skip
      991         view-as alert-box error .
      992       undo, return error return-value .
      993     end.
      994   end procedure.
      995   procedure day-begin-fact-order :
      996     define input  parameter p-fact-date            as date    no-undo .
      997     define output parameter p-day-begin-fact-order as decimal no-undo .
      998     do
      999     on error undo, return error return-value
     1000     :
     1001       if p-fact-date = ?
     1002       then do:
     1003         assign
     1004           p-day-begin-fact-order = 0
     1005         .
     1006       end.
     1007       else do:
     1008         assign
     1009           p-day-begin-fact-order = integer(p-fact-date)
     1010         .
     1011       end.
     1012     end.
     1013   end procedure.
     1014   procedure factord-max-fact-order :
     1015     define output parameter p-max-fact-order as decimal   no-undo .
     1016     do
     1017     on error undo, return error return-value
     1018     :
     1019       run day-begin-fact-order in this-procedure
     1020         (input  date(1, 1, 5000)
     1021         ,output p-max-fact-order
     1022         ) .
     1023     end.
     1024   end procedure.
     1025   procedure factord-cut-archive :
     1026     define input  parameter p-obj-type             as character no-undo .
     1027     define input  parameter p-obj-code             as integer   no-undo .
     1028     define input  parameter p-fact-date            as date      no-undo .
     1029     define output parameter p-shift-on             as logical   no-undo .
     1030     define output parameter p-shift-date           as date      no-undo .
     1031     define output parameter p-shift-num            as integer   no-undo .
     1032     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1033     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1034     define variable v-fact-order as decimal   no-undo .
     1035     define buffer buf_shift-obj for ub.shift-obj .
     1036     do
     1037     on error undo, return error return-value
     1038     :
     1039   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1040   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1041     (input  p-obj-type
     1042     ,input  p-obj-code
     1043     ,input  'shift-on=request'
     1044     ,output p-shift-on
     1045     ) no-error .
     1046       if error-status :error
     1047       then do:
     1048         message
     1049           vss-workfile vss-revision vss-description skip
     1050           "Ошибка при определении атрибута объекта" skip
     1051           "Объект" p-obj-type p-obj-code skip
     1052           error-status :get-message(1) skip
     1053           return-value skip
     1054           view-as alert-box error .
     1055         undo, return error return-value .
     1056       end.
     1057       if p-shift-on = false
     1058       then do:
     1059         assign
     1060           p-shift-date               = ?
     1061           p-shift-num                = 0
     1062         .
     1063       end.
     1064       else do:
     1065         find first buf_shift-obj share-lock
     1066           where buf_shift-obj.obj-type   = p-obj-type
     1067             and buf_shift-obj.obj-code   = p-obj-code
     1068             and buf_shift-obj.shift-date > p-fact-date
     1069           use-index pi
     1070           no-error .
     1071         if not available buf_shift-obj
     1072         or buf_shift-obj.status_ <> 'зкр':U
     1073         then do:
     1074           message
     1075             vss-workfile vss-revision vss-description skip
     1076             "Невозможно вычислить последнюю смену" skip
     1077             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1078             "Объект" p-obj-type p-obj-code skip
     1079             "Дата" p-fact-date skip
     1080             view-as alert-box error .
     1081           undo, return error return-value .
     1082         end.
     1083         find last buf_shift-obj share-lock
     1084           where buf_shift-obj.obj-type = p-obj-type
     1085             and buf_shift-obj.obj-code = p-obj-code
     1086             and buf_shift-obj.shift-date <= p-fact-date
     1087           use-index pi
     1088           no-error .
     1089         if available buf_shift-obj
     1090         then do:
     1091           if  buf_shift-obj.status_ = 'зкр':U
     1092           then do:
     1093             assign
     1094               p-shift-date = buf_shift-obj.shift-date
     1095               p-shift-num  = buf_shift-obj.shift-num
     1096             .
     1097           end.
     1098           else do:
     1099             message
     1100               vss-workfile vss-revision vss-description skip
     1101               "Невозможно вычислить последнюю смену" skip
     1102               "Статус смены отличен от статуса" 'зкр':U skip
     1103               "Объект" p-obj-type p-obj-code skip
     1104               "Дата" p-fact-date skip
     1105               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1106               view-as alert-box error .
     1107             undo, return error return-value .
     1108           end.
     1109         end.
     1110         else do:
     1111           assign
     1112             p-shift-date = p-fact-date - 1
     1113             p-shift-num  = 1
     1114           .
     1115         end.
     1116       end.
     1117       run factord in this-procedure
     1118         (input  p-fact-date
     1119         ,input  1
     1120         ,input  1
     1121         ,input  p-shift-date
     1122         ,input  p-shift-num
     1123         ,input  p-shift-on
     1124         ,output v-fact-order
     1125         ,output p-shift-end-fact-order
     1126         ,output p-day-end-fact-order
     1127         ) no-error .
     1128       if error-status :error
     1129       then do:
     1130         message
     1131           vss-workfile vss-revision vss-description skip
     1132           "Ошибка при вызове процедуры factord"
     1133           error-status :get-message(1) skip
     1134           return-value skip
     1135           view-as alert-box error .
     1136         undo, return error return-value .
     1137       end.
     1138     end.
     1139   end procedure.
     1140   procedure factord-lock-shift :
     1141     define input  parameter p-obj-type  as character no-undo .
     1142     define input  parameter p-obj-code  as integer   no-undo .
     1143     define input  parameter p-fact-date as date      no-undo .
     1144     define parameter buffer buf_shift-obj for ub.shift-obj .
     1145     define variable v-shift-on      as logical   no-undo .
     1146     define variable v-extra-message as character no-undo .
     1147     define variable v-error as character no-undo .
     1148     do
     1149     on error undo, return error return-value
     1150     :
     1151   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1152   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1153     (input  p-obj-type
     1154     ,input  p-obj-code
     1155     ,input  'shift-on=request'
     1156     ,output v-shift-on
     1157     ) no-error .
     1158       if error-status :error
     1159       then do:
     1160         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1161         undo, return error v-error .
     1162       end.
     1163       if v-shift-on = true
     1164       then do:
     1165         find first buf_shift-obj share-lock
     1166           where buf_shift-obj.obj-type   = p-obj-type
     1167             and buf_shift-obj.obj-code   = p-obj-code
     1168             and buf_shift-obj.shift-date > p-fact-date
     1169           use-index pi
     1170           no-error .
     1171         if not available buf_shift-obj
     1172         or buf_shift-obj.status_ <> 'зкр':U
     1173         then do:
     1174           find last buf_shift-obj
     1175             where buf_shift-obj.obj-type = p-obj-type
     1176               and buf_shift-obj.obj-code = p-obj-code
     1177               and buf_shift-obj.status_  = 'зкр':U
     1178             use-index stts
     1179             no-error .
     1180           if available buf_shift-obj
     1181           then do:
     1182             assign
     1183               v-extra-message =
     1184                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1185                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1186                               )
     1187             .
     1188           end.
     1189           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1190           undo, return error v-error .
     1191         end.
     1192       end.
     1193     end.
     1194   end procedure.
     1195   procedure factord-end-day :
     1196     define input  parameter p-fact-date            as date    no-undo .
     1197     define output parameter p-day-end-fact-order   as decimal no-undo .
     1198     do
     1199     on error undo, return error return-value
     1200     :
     1201       if p-fact-date = ?
     1202       then do:
     1203         return error "Не указана фактическая дата" .
     1204       end.
     1205       assign
     1206         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1207       .
     1208     end.
     1209   end procedure.
     1210   procedure factord-to-date :
     1211     define input  parameter p-fact-order as decimal no-undo .
     1212     define output parameter p-fact-date  as date    no-undo .
     1213     define variable v-ref-date  as date      no-undo .
     1214     define variable v-ref-delta as integer   no-undo .
     1215     do
     1216     on error undo, return error return-value
     1217     :
     1218       if p-fact-order = ?
     1219       or p-fact-order = 0
     1220       then do:
     1221         return error "Не указан fact-order" .
     1222       end.
     1223       assign
     1224         v-ref-date  = date(1, 1, 2000)
     1225       .
     1226       assign
     1227         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1228       .
     1229       assign
     1230         p-fact-date = v-ref-date + v-ref-delta
     1231       .
     1232     end.
     1233   end procedure.
     1234   procedure factord-to-fact-num :
     1235     define input  parameter p-fact-order as decimal no-undo .
     1236     define output parameter p-fact-num   as integer no-undo .
     1237     define variable v-fact-order-trunc as decimal no-undo .
     1238     do
     1239     on error undo, return error return-value
     1240     :
     1241       if p-fact-order = ?
     1242       or p-fact-order = 0
     1243       then do:
     1244         return error "Не указан fact-order" .
     1245       end.
     1246       assign
     1247        v-fact-order-trunc = truncate(p-fact-order, 2)
     1248       .
     1249       assign
     1250         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1251       .
     1252     end.
     1253   end procedure.
     1254   procedure factord-to-shift-num :
     1255     define input  parameter p-fact-order as decimal no-undo .
     1256     define output parameter p-shift-num   as integer no-undo .
     1257     define variable  p-shift-numd  as decimal   no-undo .
     1258     define variable v-fact-order-trunc as decimal no-undo .
     1259     do
     1260     on error undo, return error return-value
     1261     :
     1262       if p-fact-order = ?
     1263       or p-fact-order = 0
     1264       then do:
     1265         return error "Не указан fact-order" .
     1266       end.
     1267       assign
     1268        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1269       .
     1270       if v-fact-order-trunc < 0.5 then do:
     1271         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1272       end.
     1273       assign
     1274         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1275         .
     1276        assign
     1277         p-shift-num = truncate (p-shift-numd , 0)
     1278       .
     1279     end.
     1280   end procedure.
