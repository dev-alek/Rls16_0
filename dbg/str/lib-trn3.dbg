     5430       g#lib-trn3 skip
     5431       g#lib-trn3 :type skip
     5432       g#lib-trn3 :file-name skip
     5433       valid-handle( g#lib-trn3 ) skip
     5434       this-procedure :handle skip
     5435       this-procedure :type skip
     5436       this-procedure :file-name skip
     5437       valid-handle( this-procedure ) skip
     5438       view-as alert-box error .
