     4680   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4681   procedure grp-attr-name :
     4682   do
     4683     on error undo, return error
     4684     :
     4685     define input  parameter p-code           as character no-undo .
     4686     define output parameter p-type           as character no-undo .
     4687     define output parameter p-format         as character no-undo .
     4688     define output parameter p-label          as character no-undo .
     4689     define output parameter p-user-can-edit  as logical   no-undo .
     4690     define output parameter p-output-display as logical   no-undo .
     4691     define output parameter p-other          as character no-undo .
     4692       case p-code :
     4693               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     4694         otherwise do:
     4695           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
     4696         end.
     4697       end.
     4698     end.
     4699   end procedure.
     4700   procedure grp-attr-tooltip :
     4701   do
     4702     on error undo, return error
     4703     :
     4704       define input  parameter p-code    as character no-undo .
     4705       define output parameter p-tooltip as character no-undo .
     4706       define output parameter p-label   as character no-undo .
     4707       case p-code :
     4708               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
     4709         otherwise do:
     4710               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
     4711         end.
     4712       end.
     4713     end.
     4714   end procedure.
     4715   procedure grp-attr-value :
     4716   do
     4717   on error undo, return error
     4718   :
     4719   define input  parameter p-node-code   as integer    no-undo.
     4720   define input  parameter p-code        as character  no-undo.
     4721   define input  parameter p-host-code   as integer    no-undo.
     4722   define input  parameter p-obj-type    as character  no-undo.
     4723   define input  parameter p-obj-code    as integer    no-undo.
     4724   define output parameter p-value       as character  no-undo.
     4725   define output parameter p-type        as character  no-undo.
     4726       define variable v-format         as character no-undo .
     4727       define variable v-label          as character no-undo .
     4728       define variable v-user-can-edit  as logical   no-undo .
     4729       define variable v-output-display as logical   no-undo .
     4730       define variable v-other          as character no-undo .
     4731       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
     4732       run grp-attr-name in this-procedure (
     4733             input  p-code
     4734           , output p-type
     4735           , output v-format
     4736           , output v-label
     4737           , output v-user-can-edit
     4738           , output v-output-display
     4739           , output v-other
     4740       ) no-error .
     4741       if error-status :error
     4742       then do:
     4743           undo, return error return-value .
     4744       end.
     4745       find first buf_gds-grp-attr no-lock
     4746            where buf_gds-grp-attr.node-code = p-node-code
     4747              and buf_gds-grp-attr.attr-code = p-code
     4748              and buf_gds-grp-attr.host-code = p-host-code
     4749              and buf_gds-grp-attr.obj-type  = p-obj-type
     4750              and buf_gds-grp-attr.obj-code  = p-obj-code
     4751       no-error .
     4752       if available buf_gds-grp-attr
     4753       then do:
     4754           assign
     4755               p-value = buf_gds-grp-attr.attr-value
     4756           .
     4757       end.
     4758       else do:
     4759           assign
     4760               p-value = if p-type = 'L':U then "no":U else ""
     4761           .
     4762       end.
     4763   end.
     4764   end procedure.
     4765   procedure grp-attr-write :
     4766   do
     4767   on error undo, return error
     4768   :
     4769   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
     4770   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
     4771   define input parameter p-host-code  as integer                          no-undo.
     4772   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
     4773   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
     4774   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
     4775       define variable v-type              as character                no-undo.
     4776       define variable v-format            as character                no-undo.
     4777       define variable v-label             as character                no-undo.
     4778       define variable v-user-can-edit     as logical                  no-undo.
     4779       define variable v-output-display    as logical                  no-undo.
     4780       define variable v-other             as character                no-undo.
     4781       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
     4782       run grp-attr-name in this-procedure (
     4783                         input  p-code
     4784                       , output v-type
     4785                       , output v-format
     4786                       , output v-label
     4787                       , output v-user-can-edit
     4788                       , output v-output-display
     4789                       , output v-other
     4790       ) no-error.
     4791       if error-status :error
     4792       then do:
     4793           undo, return error return-value.
     4794       end.
     4795       find first buf_gds-grp-attr exclusive-lock
     4796            where buf_gds-grp-attr.node-code  = p-node-code
     4797              and buf_gds-grp-attr.attr-code  = p-code
     4798              and buf_gds-grp-attr.host-code  = p-host-code
     4799              and buf_gds-grp-attr.obj-type   = p-obj-type
     4800              and buf_gds-grp-attr.obj-code   = p-obj-code
     4801       no-error.
     4802       if not available buf_gds-grp-attr
     4803       then do:
     4804           create buf_gds-grp-attr.
     4805           assign
     4806                   buf_gds-grp-attr.node-code  = p-node-code
     4807                   buf_gds-grp-attr.attr-code  = p-code
     4808                   buf_gds-grp-attr.host-code  = p-host-code
     4809                   buf_gds-grp-attr.obj-type   = p-obj-type
     4810                   buf_gds-grp-attr.obj-code   = p-obj-code
     4811                   buf_gds-grp-attr.attr-value = p-value
     4812           .
     4813       end.
     4814       else do:
     4815           assign
     4816               buf_gds-grp-attr.attr-value = p-value
     4817           .
     4818       end.
     4819   end.
     4820   end procedure.
     4821   procedure grp-attr-delete :
     4822   do
     4823   on error undo, return error
     4824   :
     4825   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
     4826   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
     4827   define input parameter p-host-code  as integer                      no-undo.
     4828   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
     4829   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
     4830   define output parameter p-deleted   as logical                      no-undo.
     4831       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
     4832       define variable v-type              as character                no-undo.
     4833       define variable v-format            as character                no-undo.
     4834       define variable v-label             as character                no-undo.
     4835       define variable v-user-can-edit     as logical                  no-undo.
     4836       define variable v-output-display    as logical                  no-undo.
     4837       define variable v-other             as character                no-undo.
     4838       run grp-attr-name in this-procedure
     4839       ( input  p-code
     4840       , output v-type
     4841       , output v-format
     4842       , output v-label
     4843       , output v-user-can-edit
     4844       , output v-output-display
     4845       , output v-other
     4846       ) no-error .
     4847       if error-status :error then do:
     4848           undo, return error return-value .
     4849       end.
     4850       find first buf_gds-grp-attr exclusive-lock
     4851            where buf_gds-grp-attr.node-code  = p-node-code
     4852              and buf_gds-grp-attr.attr-code  = p-code
     4853              and buf_gds-grp-attr.host-code  = p-host-code
     4854              and buf_gds-grp-attr.obj-type   = p-obj-type
     4855              and buf_gds-grp-attr.obj-code   = p-obj-code
     4856       no-error.
     4857       if not available buf_gds-grp-attr
     4858       then do:
     4859           assign
     4860               p-deleted = no
     4861           .
     4862       end.
     4863       else do:
     4864          delete buf_gds-grp-attr.
     4865          assign
     4866               p-deleted = yes
     4867           .
     4868       end.
     4869   end.
     4870   end procedure.
     4871   procedure grp-attr-news :
     4872   do
     4873   on error undo, return error
     4874   :
     4875       define input  parameter p-code           as character no-undo .
     4876       define output parameter p-news           as logical   no-undo .
     4877       case p-code :
     4878               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
     4879         otherwise do:
     4880           undo, return error "неизвестный атрибут товара на фирме" + " " + p-code .
     4881         end.
     4882       end.
     4883   end.
     4884   end procedure.
     4885   procedure grp-attr-obj-value :
     4886   do
     4887   on error undo, return error
     4888   :
     4889   define input parameter p-node-code as integer      no-undo.
     4890   define input parameter p-obj-type  as character    no-undo.
     4891   define input parameter p-obj-code  as integer      no-undo.
     4892   define input parameter p-attr-code as character    no-undo .
     4893   define output parameter p-attr-value     as character   no-undo.
     4894   define output parameter p-range     as integer      no-undo.
     4895   define output parameter p-exists    as logical      no-undo.
     4896   define variable v-host-code as integer      no-undo.
     4897   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4898   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4899     (input  p-obj-type
     4900     ,input  p-obj-code
     4901     ,output v-host-code
     4902     ) no-error .
     4903   if error-status :error
     4904   then do:
     4905       message
     4906         vss-workfile vss-revision vss-description
     4907         skip "Не удалось найти фирму объекта"
     4908         skip p-obj-type p-obj-code
     4909         skip return-value
     4910         skip trim(error-status :get-message(1))
     4911              trim(error-status :get-message(2))
     4912              trim(error-status :get-message(3))
     4913              trim(error-status :get-message(4))
     4914              trim(error-status :get-message(5))
     4915       view-as alert-box error.
     4916       undo, return error .
     4917   end.
     4918   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
     4919   find first buf_gds-grp-attr no-lock
     4920        where buf_gds-grp-attr.node-code = p-node-code
     4921          and buf_gds-grp-attr.attr-code = p-attr-code
     4922          and buf_gds-grp-attr.host-code = v-host-code
     4923          and buf_gds-grp-attr.obj-type  = p-obj-type
     4924          and buf_gds-grp-attr.obj-code  = p-obj-code
     4925   no-error .
     4926   if not available buf_gds-grp-attr
     4927   then do:
     4928       find first buf_gds-grp-attr no-lock
     4929            where buf_gds-grp-attr.node-code = p-node-code
     4930              and buf_gds-grp-attr.attr-code = p-attr-code
     4931              and buf_gds-grp-attr.host-code = v-host-code
     4932              and buf_gds-grp-attr.obj-type  = ""
     4933              and buf_gds-grp-attr.obj-code  = 0
     4934       no-error .
     4935       if not available buf_gds-grp-attr
     4936       then do:
     4937           find first buf_gds-grp-attr no-lock
     4938               where buf_gds-grp-attr.node-code = p-node-code
     4939               and buf_gds-grp-attr.attr-code = p-attr-code
     4940               and buf_gds-grp-attr.host-code = 0
     4941               and buf_gds-grp-attr.obj-type  = ""
     4942               and buf_gds-grp-attr.obj-code  = 0
     4943           no-error .
     4944           if not available buf_gds-grp-attr
     4945           then do:
     4946               assign
     4947                   p-exists = no
     4948               .
     4949           end.
     4950           else do:
     4951               assign
     4952                   p-exists = yes
     4953                   p-range  = 1
     4954               .
     4955           end.
     4956       end.
     4957       else do:
     4958           assign
     4959               p-exists = yes
     4960               p-range  = 2
     4961           .
     4962       end.
     4963   end.
     4964   else do:
     4965       assign
     4966           p-exists = yes
     4967           p-range  = 3
     4968       .
     4969   end.
     4970   if available buf_gds-grp-attr
     4971   then do:
     4972     assign
     4973     p-attr-value = buf_gds-grp-attr.attr-value
     4974     .
     4975   end.
     4976   end.
     4977   end procedure.
     4978   procedure ver-gds-grp-nabor :
     4979   do
     4980   on error undo, return error return-value
     4981   :
     4982   define input  parameter p-gds-code as integer   no-undo .
     4983   define output parameter p-nabor as logical   no-undo .
     4984   define buffer buf_goods for ub.goods.
     4985   p-nabor = false .
     4986   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     4987   if error-status :error then return error .
     4988   define variable v-value       as character  no-undo.
     4989   define variable v-type        as character  no-undo.
     4990     run grp-attr-value (
     4991        input   buf_goods.grp-code
     4992       ,input   'gds-grp-nabor':U
     4993       ,input   0
     4994       ,input   ""
     4995       ,input   0
     4996       ,output  v-value
     4997       ,output  v-type       ) no-error .
     4998       if error-status :error then return error .
     4999     if v-value = "yes" then p-nabor = true  .
     5000   end.
     5001   end procedure.
     5002   define variable vss-include-info35 as character no-undo format "x(65)":U initial "@(#)$Workfile$ $Revision$":U.
     5003   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5004   procedure valid-ren-art-tbl-list :
     5005     do
     5006     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5007     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     5008     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     5009     :
     5010       define variable v-std-list        as character no-undo .
     5011       define variable v-ignore-list     as character no-undo .
     5012       define variable v-special-list    as character no-undo .
     5013       assign
     5014         v-std-list     = "cli-gds,cli-gds-attr,cli-art,cli-art-attr,contract-specif,c-contract-specif,doc-line,c-doc-line,fbr-line,c-fbr-line,fbr-recipe,fbr-recipe-gds,fbr-pln-line,c-fbr-pln-line,gds-dtl,c-gds-dtl,gds-dtl-attr,c-gds-dtl-attr,gds-obj,inv-line,inv-line-attr,c-inv-line,ot-supp-line,ot-supp-line-attr,ot-line-attr,ord-line,c-ord-line,ord-line-rcv,ord-dtl,c-ord-dtl,ord-dtl-attr,ord-dtl-rcv,ord-dtl-cons,ord-gds-cons,prt-obj,prt-obj-attr,parts,c-parts,parts-supp,parts-supp-attr,price-list,c-price-list,price-doc-forming-gds,c-price-doc-forming-gds,price-doc-forming-gds-qnty,c-price-doc-forming-gds-qnty,price-doc-forming-gds-sum,c-price-doc-forming-gds-sum,price-doc-forming-gds-tnv,c-price-doc-forming-gds-tnv,recipe,recipe-gds,c-recipe,c-recipe-gds,c-recipe-hist,stk-supp-line,stk-supp-line-attr,stk-line-attr,tmp-sale-dtl,tmp-sale-dtl-attr,tmp-sale-gds,tmp-sale-gds-attr":U
     5015         v-ignore-list  = "c-goods,c-order-line":U
     5016         v-special-list = "goods,ot-line,stk-line,order-line":U
     5017       .
     5018   def var vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5019       define variable v-ind         as integer   no-undo .
     5020       define variable v-num-entries as integer   no-undo .
     5021       define variable v-inform      as character no-undo .
     5022       define variable bh_tbl-name   as handle    no-undo .
     5023       define variable v-tbl-not-idx as character no-undo .
     5024       define variable v-idx-avail   as logical   no-undo .
     5025       define variable new-tbl-list  as character no-undo .
     5026       define variable old-tbl-list  as character no-undo .
     5027       define variable old-tbl-avail as logical   no-undo .
     5028       define variable v-double-tbl  as character no-undo .
     5029       define variable v-tbl-name    as character no-undo .
     5030       define variable v-msg         as character no-undo .
     5031       assign
     5032         v-msg         = "":U
     5033         v-tbl-not-idx = "":U
     5034         new-tbl-list  = "":U
     5035       .
     5036       for each ub._Field no-lock
     5037         where ub._Field._Field-Name = 'artic':U
     5038       ,first ub._File of ub._Field
     5039       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5040       :
     5041         if  lookup( ub._File._File-Name, v-std-list     ) = 0
     5042         and lookup( ub._File._File-Name, v-ignore-list  ) = 0
     5043         and lookup( ub._File._File-Name, v-special-list ) = 0
     5044         then do:
     5045           assign
     5046             new-tbl-list = new-tbl-list + chr(10) + ub._File._File-Name
     5047           .
     5048         end.
     5049         if lookup( ub._File._File-Name, v-std-list ) <> 0
     5050           or lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0
     5051         then do:
     5052           create buffer bh_tbl-name for table substitute( "ub.&1":U, ub._File._File-Name ) .
     5053           assign
     5054             v-idx-avail = false
     5055             v-inform    = bh_tbl-name:index-information(1)
     5056             v-ind       = 2
     5057           .
     5058           block_chk-idx:
     5059           do while v-inform <> ?
     5060           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5061           :
     5062             if v-inform <> ?
     5063                 and lookup( entry( 5, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
     5064                 and lookup( entry( 7, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
     5065                 and lookup( entry( 9, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
     5066             then do:
     5067               assign
     5068                 v-idx-avail = true
     5069               .
     5070               leave block_chk-idx.
     5071             end.
     5072             assign
     5073               v-inform = bh_tbl-name:index-information( v-ind )
     5074               v-ind    = v-ind + 1
     5075             .
     5076           end.
     5077           if v-idx-avail = false then do:
     5078             if lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0 then do:
     5079               assign
     5080                 new-tbl-list = new-tbl-list + " (индекса нет)"
     5081               .
     5082             end.
     5083             else do:
     5084               assign
     5085                 v-tbl-not-idx = v-tbl-not-idx + chr(10) + ub._File._File-Name
     5086               .
     5087             end.
     5088           end.
     5089           delete object bh_tbl-name.
     5090         end.
     5091       end.
     5092       assign
     5093         old-tbl-list  = "":U
     5094         v-double-tbl  = "":U
     5095         v-num-entries = num-entries( v-std-list )
     5096       .
     5097       do v-ind = 1 to v-num-entries
     5098       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5099       :
     5100         assign
     5101           v-tbl-name    = entry( v-ind, v-std-list )
     5102           old-tbl-avail = false
     5103         .
     5104         find first ub._File no-lock
     5105           where ub._File._File-Name = v-tbl-name
     5106           no-error .
     5107         if not available ub._File then do:
     5108           assign
     5109             old-tbl-avail = true
     5110           .
     5111         end.
     5112         else do:
     5113           find first ub._Field no-lock
     5114             where ub._Field._File-recid = recid( ub._File )
     5115               and ub._Field._Field-Name = 'artic':U
     5116             no-error .
     5117           if not available ub._Field then do:
     5118             assign
     5119               old-tbl-avail = true
     5120             .
     5121           end.
     5122             find first ub._Field no-lock
     5123               where ub._Field._File-recid = recid( ub._File )
     5124                 and ub._Field._Field-Name = "prod-type"
     5125               no-error .
     5126             if not available ub._Field then do:
     5127               assign
     5128                 old-tbl-avail = true
     5129               .
     5130             end.
     5131             find first ub._Field no-lock
     5132               where ub._Field._File-recid = recid( ub._File )
     5133                 and ub._Field._Field-Name = "prod-code"
     5134               no-error .
     5135             if not available ub._Field then do:
     5136               assign
     5137                 old-tbl-avail = true
     5138               .
     5139             end.
     5140         end.
     5141         if old-tbl-avail = true then do:
     5142           assign
     5143             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     5144           .
     5145         end.
     5146         if ( lookup( v-tbl-name, v-std-list ) > v-ind
     5147              or lookup( v-tbl-name, v-ignore-list ) > 0
     5148              or lookup( v-tbl-name, v-special-list ) > 0
     5149            )
     5150           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     5151         then do:
     5152           assign
     5153             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     5154           .
     5155         end.
     5156       end.
     5157       assign
     5158         v-num-entries = num-entries( v-ignore-list )
     5159       .
     5160       do v-ind = 1 to v-num-entries
     5161       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5162       :
     5163         assign
     5164           v-tbl-name = entry( v-ind, v-ignore-list )
     5165           old-tbl-avail = false
     5166         .
     5167         find first ub._File no-lock
     5168           where ub._File._File-Name = v-tbl-name
     5169           no-error .
     5170         if not available ub._File then do:
     5171           assign
     5172             old-tbl-avail = true
     5173           .
     5174         end.
     5175         else do:
     5176           find first ub._Field no-lock
     5177             where ub._Field._File-recid = recid( ub._File )
     5178               and ub._Field._Field-Name = 'artic':U
     5179             no-error .
     5180           if not available ub._Field then do:
     5181             assign
     5182               old-tbl-avail = true
     5183             .
     5184           end.
     5185             find first ub._Field no-lock
     5186               where ub._Field._File-recid = recid( ub._File )
     5187                 and ub._Field._Field-Name = "prod-type"
     5188               no-error .
     5189             if not available ub._Field then do:
     5190               assign
     5191                 old-tbl-avail = true
     5192               .
     5193             end.
     5194             find first ub._Field no-lock
     5195               where ub._Field._File-recid = recid( ub._File )
     5196                 and ub._Field._Field-Name = "prod-code"
     5197               no-error .
     5198             if not available ub._Field then do:
     5199               assign
     5200                 old-tbl-avail = true
     5201               .
     5202             end.
     5203         end.
     5204         if old-tbl-avail = true then do:
     5205           assign
     5206             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     5207           .
     5208         end.
     5209         if ( lookup( v-tbl-name, v-std-list ) > 0
     5210              or lookup( v-tbl-name, v-ignore-list ) > v-ind
     5211              or lookup( v-tbl-name, v-special-list ) > 0
     5212            )
     5213           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     5214         then do:
     5215           assign
     5216             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     5217           .
     5218         end.
     5219       end.
     5220       assign
     5221         v-num-entries = num-entries( v-special-list )
     5222       .
     5223       do v-ind = 1 to v-num-entries
     5224       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5225       :
     5226         assign
     5227           v-tbl-name = entry( v-ind, v-special-list )
     5228         .
     5229         find first ub._File no-lock
     5230           where ub._File._File-Name = v-tbl-name
     5231           no-error .
     5232         if available ub._File then do:
     5233           find first ub._Field no-lock
     5234             where ub._Field._File-recid = recid( ub._File )
     5235               and ub._Field._Field-Name = 'artic':U
     5236             no-error .
     5237         end.
     5238         if not available ub._File
     5239           or ( available ub._File
     5240                and not available ub._Field
     5241              )
     5242         then do:
     5243           assign
     5244             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     5245           .
     5246         end.
     5247         if ( lookup( v-tbl-name, v-std-list ) > 0
     5248              or lookup( v-tbl-name, v-ignore-list ) > 0
     5249              or lookup( v-tbl-name, v-special-list ) > v-ind
     5250            )
     5251           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     5252         then do:
     5253           assign
     5254             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     5255           .
     5256         end.
     5257       end.
     5258       if v-tbl-not-idx <> "" then do:
     5259         assign
     5260           v-msg = v-msg + substitute( "Таблицы не имеют индекса с полями &3 на первом месте и нет спецобработки: &2&1&1", chr(10), v-tbl-not-idx, 'artic, prod-type, prod-code':U )
     5261         .
     5262       end.
     5263       if new-tbl-list <> "":U then do:
