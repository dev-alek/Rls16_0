     9744     ,input  bf_goods.prod-code
     9745     ,input  'inv-on=request'
     9746     ,output l-inv-on
     9747     ) no-error .
     9748     if error-status :error then do:
     9749       undo, return error "Ошибка получения признака товара на объекте".
     9750     end.
     9751     if l-inv-on then do:
     9752       return error substitute("Артикул : &1 &2 &3 &4  - товар в инвентаризации. Операция невозможна.", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_goods.gds-name) .
     9753     end.
     9754     for each tt-doc-line :
     9755       delete tt-doc-line.
     9756     end.
     9757     create tt-doc-line.
     9758     assign
     9759       tt-doc-line.doc-code  = bf_trn-doc.doc-code
     9760       tt-doc-line.obj-type  = bf_trn-doc.obj-type
     9761       tt-doc-line.obj-code  = bf_trn-doc.obj-code
     9762       tt-doc-line.artic     = bf_goods.artic
     9763       tt-doc-line.prod-type = bf_goods.prod-type
     9764       tt-doc-line.prod-code = bf_goods.prod-code.
     9765     bl-inv-on:
     9766     for
     9767    each bf_parts no-lock
     9768           where
     9769               (     bf_parts.prod-type = tt-doc-line.prod-type
     9770                 and bf_parts.prod-code = tt-doc-line.prod-code
     9771                 and bf_parts.artic     = tt-doc-line.artic
     9772                 and bf_parts.obj-type  = tt-doc-line.obj-type
     9773                 and bf_parts.obj-code  = tt-doc-line.obj-code
     9774                 and bf_parts.rsrv-free = true
     9775                 and bf_parts.status_   = false
     9776                 and bf_parts.out-code  <> 'free-zone':U
     9777                 and bf_parts.out-code  <> bf_trn-doc.doc-code
     9778               )
     9779               or
     9780               (     bf_parts.prod-type = tt-doc-line.prod-type
     9781                 and bf_parts.prod-code = tt-doc-line.prod-code
     9782                 and bf_parts.artic     = tt-doc-line.artic
     9783                 and bf_parts.obj-type  = tt-doc-line.obj-type
     9784                 and bf_parts.obj-code  = tt-doc-line.obj-code
     9785                 and bf_parts.rsrv-free = false
     9786                 and bf_parts.status_   = false
     9787                 and bf_parts.out-code  <> 'out-zone':U
     9788                 and bf_parts.out-code  <> bf_trn-doc.doc-code
     9789               )
     9790     on error undo bl-inv-on, return error :
     9791       undo bl-inv-on, return error substitute("Включить инвентаризацию нельзя - на товаре есть резервы. Товар &1 &2 &3 Документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_parts.out-code).
     9792     end.
     9793   end.
