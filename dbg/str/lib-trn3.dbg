     5268       if v-double-tbl <> "":U then do:
     5269         assign
     5270           v-msg = v-msg + substitute( "В списках есть задублированные таблицы: &2&1&1", chr(10), v-double-tbl )
     5271         .
     5272       end.
     5273       if old-tbl-list <> "":U then do:
     5274         assign
     5275           v-msg = v-msg + substitute( "В списках есть несуществующие таблицы или таблицы в которых отсутствуют переименовываемые поля: &2&1&1", chr(10), old-tbl-list )
     5276         .
     5277       end.
     5278       if v-msg <> "":U then do:
     5279         return error substitute( "Утилита переименования &3 не корректна.&1&1&2", chr(10), v-msg, 'artic, prod-type, prod-code':U ) .
     5280       end.
     5281     end.
     5282   end procedure.
     5283   procedure check-use-artic :
     5284     define input  parameter p-tbl-name  as   character                      no-undo .
     5285     define input  parameter p-artic     like ub.goods.artic     no-undo .
     5286     define input  parameter p-prod-type like ub.goods.prod-type no-undo .
     5287     define input  parameter p-prod-code like ub.goods.prod-code no-undo .
     5288     do
     5289     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info35, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5290     on stop   undo, return error substitute( "&1. stop",   vss-include-info35 )
     5291     on endkey undo, return error substitute( "&1. endkey", vss-include-info35 )
     5292     :
     5293       define buffer buf_goods for ub.goods .
     5294       if lookup( p-tbl-name, "c-goods,c-order-line":U ) = 0 then do:
     5295         find first buf_goods no-lock
     5296           where buf_goods.artic     = p-artic
     5297             and buf_goods.prod-type = p-prod-type
     5298             and buf_goods.prod-code = p-prod-code
     5299           no-error .
     5300         if not available buf_goods then do:
     5301           return error substitute( "&1 (check-use-artic). Не найден товар с артикулом &2 и производителем &3 &4", vss-include-info35, p-artic, p-prod-type, p-prod-code ) .
     5302         end.
     5303         if buf_goods.stts = integer('51':U) then do:
     5304           return error substitute( "&1 (check-use-artic). Нельзя использовать товар с артикулом &2 и производителем &3 &4&5"
     5305                                   + "Выполняется переименование артикула и(или) производителя"
     5306                                   ,vss-include-info35
     5307                                   ,p-artic
     5308                                   ,p-prod-type
     5309                                   ,p-prod-code
     5310                                   ,chr(10)
     5311                                 ) .
     5312         end.
     5313       end.
     5314       return .
     5315     end.
     5316   end procedure.
     5317   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5318   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     5319   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     5320   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     5321   ASSIGN
     5322      v-S_CONTRACT                = "Contract":U
     5323      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     5324      v-DELIM_CHR_3               = ","
     5325      .
     5326   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     5327   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     5328   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     5329   FUNCTION Can-Find-Spec RETURN LOGICAL (
     5330      INPUT iHost-Code    AS INTEGER,
     5331      INPUT iContract-Num AS INTEGER,
     5332      INPUT iGds-Code     AS INTEGER ):
     5333      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     5334      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     5335      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     5336      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     5337      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     5338      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     5339          INPUT  iHost-Code,
     5340          INPUT  iContract-Num,
     5341          OUTPUT iTmp-Extent3
     5342          ).
     5343      IF iTmp-Extent3[1] = 2 THEN DO:
     5344         ASSIGN
     5345            iTmp-Host-Code      = iTmp-Extent3[2]
     5346            iTmp-Contract-Num   = iTmp-Extent3[3]
     5347            .
     5348      END. ELSE DO:
     5349         ASSIGN
     5350            iTmp-Host-Code      = iHost-Code
     5351            iTmp-Contract-Num   = iContract-Num
     5352            .
     5353      END.
     5354      IF iGds-Code = ? THEN DO:
     5355         ASSIGN
     5356            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     5357                                  buf_Spec.Host-Code     = iTmp-Host-Code
     5358                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     5359                           ).
     5360      END. ELSE DO:
     5361            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     5362                                  buf_Spec.Host-Code     = iTmp-Host-Code
     5363                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     5364                              AND buf_Spec.Gds-Code      = iGds-Code
     5365                            ).
     5366      END.
     5367      RETURN (lRet).
     5368   END FUNCTION.
     5369   PROCEDURE MS-Contract-EXTENT-3:
     5370      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     5371      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     5372      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     5373      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     5374      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     5375      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     5376      FIND FIRST buf_Cont-2 WHERE
     5377                 buf_Cont-2.Host-Code      = i-Host-Code
     5378             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     5379           NO-LOCK NO-ERROR.
     5380      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     5381         RETURN.
     5382      END.
     5383      FOR FIRST buf_Ext-Classif WHERE
     5384                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     5385           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     5386                                               STRING(i-Contract-code)
     5387           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     5388          NO-LOCK,
     5389          EACH buf_Cont WHERE
     5390               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     5391           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     5392          NO-LOCK:
     5393          ASSIGN
     5394             i-Ret[1] = 1
     5395             i-Ret[2] = buf_Cont.Host-code
     5396             i-Ret[3] = buf_Cont.Contract-code
     5397             .
     5398          LEAVE.
     5399      END.
     5400      IF i-Ret[1] <> 1 THEN DO:
     5401         FOR FIRST buf_Ext-Classif WHERE
     5402                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     5403              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     5404                                                  STRING(i-Contract-code)
     5405              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     5406             NO-LOCK,
     5407             EACH buf_Cont WHERE
     5408                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     5409              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     5410             NO-LOCK:
     5411             ASSIGN
     5412                i-Ret[1] = 2
     5413                i-Ret[2] = buf_Cont.Host-code
     5414                i-Ret[3] = buf_Cont.Contract-code
     5415                .
     5416             LEAVE.
     5417         END.
     5418      END.
     5419      RETURN.
     5420   END PROCEDURE.
     5421   define variable lns-cnt  as integer no-undo.
     5422   define variable line-rec as recid   no-undo.
     5423   if valid-handle (g#lib-trn3)
