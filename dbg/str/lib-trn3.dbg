    10141           view-as alert-box error .
    10142         end.
    10143         undo Main-Block, return error substitute( "Невозможно определить фирму для объекта &1 &2"
    10144                                                 , p-obj-type
    10145                                                 , p-obj-code ) .
    10146       end.
    10147   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    10148     (input  'shopendc':U
    10149     ,input  v-host-code
    10150     ,input  p-obj-type
    10151     ,input  p-obj-code
    10152     ,input  '':U
    10153     ,input  '':U
    10154     ,input  '':U
    10155     ,input  no
    10156     ,output chk-open-doc
    10157     ,output v_data-type
    10158     ) no-error .
    10159       if error-status :error or
    10160          v_data-type <> "L":U or
    10161          lookup( chk-open-doc, "yes,no":U ) = 0
    10162       then do:
    10163         assign
    10164           chk-open-doc = "no"
    10165         .
    10166       end.
    10167       if chk-open-doc = "no" then do:
    10168         assign
    10169           p-found = no
    10170         .
    10171         return .
    10172       end.
    10173       find first bf_shift-obj no-lock where
    10174                  bf_shift-obj.obj-type   = p-obj-type   and
    10175                  bf_shift-obj.obj-code   = p-obj-code   and
    10176                  bf_shift-obj.shift-date = p-shift-date and
    10177                  bf_shift-obj.shift-num  = p-shift-num  use-index pi no-error .
    10178       if not available bf_shift-obj then do:
    10179         find first bf_shift-obj no-lock where
    10180                    bf_shift-obj.obj-type =   p-obj-type   and
    10181                    bf_shift-obj.obj-code =   p-obj-code   and
    10182                    bf_shift-obj.status_  = 'тек':U use-index pi no-error .
    10183         if not available bf_shift-obj then do:
    10184           if p-talk-on = yes then do:
    10185             message "lib-trn3_rvschtrn:" skip( 1 )
    10186                     "Нет открытой смены на объекте" p-obj-type p-obj-code skip( 1 )
    10187             view-as alert-box error .
    10188           end.
    10189           undo Main-Block, return error substitute( "Нет открытой смены на объекте &1 &2"
    10190                                                   , p-obj-type
    10191                                                   , p-obj-code ) .
    10192         end.
    10193       end.
    10194   for each bf_trn-doc no-lock where
    10195            bf_trn-doc.obj-type     =  bf_shift-obj.obj-type   and
    10196            bf_trn-doc.obj-code     =  bf_shift-obj.obj-code   and
    10197            bf_trn-doc.internal     =  no                     and
    10198            bf_trn-doc.status_      <> 'факт':U                 and
    10199            bf_trn-doc.status_      <> 'запрос':U              and
    10200          (
    10201            bf_trn-doc.ext-doc-type =  'ie':U      or
    10202            bf_trn-doc.ext-doc-type =  'ee':U      or
    10203            bf_trn-doc.ext-doc-type =  'ep':U   or
    10204            bf_trn-doc.ext-doc-type =  're':U  or
    10205            bf_trn-doc.ext-doc-type =  'we':U      or
    10206            bf_trn-doc.ext-doc-type =  'vt':U            or
    10207            bf_trn-doc.ext-doc-type =  'vp':U       or
    10208            no
    10209          )
    10210   :
    10211     assign
    10212       ext-doc-name = entry( lookup( bf_trn-doc.ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
    10213     .
    10214     if
    10215               bf_trn-doc.ext-doc-type = 'ep':U  or
    10216               bf_trn-doc.ext-doc-type = 're':U or
    10217               no
    10218     then do:
    10219   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10220   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
    10221     (input  bf_trn-doc.doc-code
    10222     ,output is_hold-doc
    10223     ) no-error .
    10224       if error-status :error or
    10225          is_hold-doc = ?
    10226       then do:
    10227         assign
    10228           string-error = "":U
    10229         .
    10230         do jj = 1 to error-status :num-messages
    10231         :
    10232           assign
    10233             string-error = string-error
    10234                          + ( if string-error = "":U then "":U else chr(10) )
    10235                          + error-status :get-message( jj )
    10236           .
    10237         end.
    10238         if p-talk-on = yes then do:
    10239           message "lib-trn3_rvschtrn:" skip( 1 )
    10240                   substitute( 'Невозможно определить межфирменный тип для документа "&1" &2 в статусе "&3".'
    10241                             , bf_trn-doc.doc-code
    10242                             , ext-doc-name
    10243                             , bf_trn-doc.status_ ) skip( 0 )
    10244                   string-error skip( 0 )
    10245                   return-value skip( 1 )
    10246           view-as alert-box error .
    10247         end.
    10248         undo Main-Block, return error substitute( 'Невозможно определить межфирменный тип для документа "&4" &5 '
    10249                                                 + 'в статусе "&6".&2&1&2&3'
    10250                                                 , string-error
    10251                                                 , chr(10)
    10252                                                 , return-value
    10253                                                 , bf_trn-doc.doc-code
    10254                                                 , ext-doc-name
    10255                                                 , bf_trn-doc.status_ ) .
    10256       end.
    10257       if is_hold-doc = no then do:
    10258         if ( bf_trn-doc.ext-doc-type = 'ie':U or
    10259              bf_trn-doc.ext-doc-type = 'vt':U       or
    10260              bf_trn-doc.ext-doc-type = 'vp':U  ) and
    10261              bf_trn-doc.status_      = 'накл':U
    10262         then do:
    10263           if bf_trn-doc.out-code = p-rvs-code then do:
    10264             next .
    10265           end.
    10266           if p-talk-on = yes then do:
    10267             if p-ask = yes then do:
    10268               message "lib-trn3_rvschtrn:" skip( 1 )
    10269                       substitute( 'Есть складской документ "&1" "&2" статус "&3" .'
    10270                                 , bf_trn-doc.doc-code
    10271                                 , ext-doc-name
    10272                                 , bf_trn-doc.status_ + string( bf_trn-doc.flag, '+/-':U )
    10273                                 ) skip( 1 )
    10274                       chr(9) 'ЗАКРЫТЬ СВЕРКУ?' skip( 1 )
    10275               view-as alert-box question buttons yes-no update g-log .
    10276             end.
    10277             else do:
    10278               assign
    10279                 g-log = yes
    10280               .
    10281             end.
    10282           end.
    10283           else do:
    10284             assign
    10285               g-log = no
    10286             .
    10287           end.
    10288           if g-log <> yes then do:
    10289             undo Main-Block, return error substitute( 'Есть складской документ "&1" "&2" статус "&3" .'
    10290                                                     , bf_trn-doc.doc-code
    10291                                                     , ext-doc-name
    10292                                                     , bf_trn-doc.status_ + string( bf_trn-doc.flag, '+/-':U ) ) .
    10293           end.
    10294         end.
    10295         next .
    10296       end.
    10297     end.
    10298     if p-talk-on = yes then do:
    10299       message "lib-trn3_rvschtrn:"                                                  skip( 1 )
    10300               "Объект:" bf_shift-obj.obj-type   bf_shift-obj.obj-code               skip( 0 )
    10301               "Смена:"  bf_shift-obj.shift-date                                     skip( 0 )
    10302               "Порядок смены:" bf_shift-obj.shift-num                               skip( 0 )
    10303               "Номер смены" bf_shift-obj.shift-name                                 skip( 0 )
    10304               "Имеется документ" '"' + bf_trn-doc.doc-code + '"' ext-doc-name
    10305               "в статусе:" '"'       + bf_trn-doc.status_  + '"'                    skip( 1 )
    10306       view-as alert-box error .
    10307     end.
    10308     return substitute( 'Имеется документ "&1" &2 в статусе "&3".&4Объект &5 &6.&4Смена: &7 порядок: &8 номер: &9'
    10309                      , bf_trn-doc.doc-code
    10310                      , ext-doc-name
    10311                      , bf_trn-doc.status_
    10312                      , chr(10)
    10313                      , bf_shift-obj.obj-type
    10314                      , bf_shift-obj.obj-code
    10315                      , bf_shift-obj.shift-date
    10316                      , bf_shift-obj.shift-num
    10317                      , bf_shift-obj.shift-name ) .
    10318   end.
    10319   for each bf_trn-doc no-lock where
    10320            bf_trn-doc.obj-type     =  bf_shift-obj.obj-type   and
    10321            bf_trn-doc.obj-code     =  bf_shift-obj.obj-code   and
    10322            bf_trn-doc.internal     =  yes                     and
    10323            bf_trn-doc.status_      <> 'факт':U                 and
    10324            bf_trn-doc.status_      <> 'запрос':U              and
    10325          (
    10326            bf_trn-doc.ext-doc-type =  'iv':U      or
    10327            bf_trn-doc.ext-doc-type =  'ev':U      or
    10328            bf_trn-doc.ext-doc-type =  'rv':U  or
    10329            no
    10330          )
    10331   :
    10332     assign
    10333       ext-doc-name = entry( lookup( bf_trn-doc.ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
    10334     .
    10335     if bf_trn-doc.ext-doc-type = 'iv':U and
    10336        bf_trn-doc.flag_        = yes                and
    10337        bf_trn-doc.status_      = 'накл':U
    10338     then do:
    10339       if bf_trn-doc.out-code = p-rvs-code then do:
    10340         next .
    10341       end.
    10342       if p-talk-on = yes then do:
    10343         if p-ask = yes then do:
    10344           message "lib-trn3_rvschtrn:" skip( 1 )
    10345                   substitute( 'Есть складской документ "&1" "&2" статус "&3" .'
    10346                             , bf_trn-doc.doc-code
    10347                             , ext-doc-name
    10348                             , bf_trn-doc.status_ + string( bf_trn-doc.flag, '+/-':U )
    10349                             ) skip( 1 )
    10350                   chr(9) 'ЗАКРЫТЬ СВЕРКУ?' skip( 1 )
    10351           view-as alert-box question buttons yes-no update g-log .
    10352         end.
    10353         else do:
    10354           assign
    10355             g-log = yes
    10356           .
    10357         end.
    10358       end.
    10359       else do:
    10360         assign
    10361           g-log = no
    10362         .
    10363       end.
    10364       if g-log <> yes then do:
    10365         undo Main-Block, return error substitute( 'Есть складской документ "&1" "&2" статус "&3" .'
    10366                                                 , bf_trn-doc.doc-code
    10367                                                 , ext-doc-name
    10368                                                 , bf_trn-doc.status_ + string( bf_trn-doc.flag, '+/-':U ) ) .
    10369       end.
    10370     end.
    10371     if p-talk-on = yes then do:
    10372       message "lib-trn3_rvschtrn:"                                                  skip( 1 )
    10373               "Объект:" bf_shift-obj.obj-type   bf_shift-obj.obj-code               skip( 0 )
    10374               "Смена:"  bf_shift-obj.shift-date                                     skip( 0 )
    10375               "Порядок смены:" bf_shift-obj.shift-num                               skip( 0 )
    10376               "Номер смены" bf_shift-obj.shift-name                                 skip( 0 )
    10377               "Имеется документ" '"' + bf_trn-doc.doc-code + '"' ext-doc-name
    10378               "в статусе:" '"'       + bf_trn-doc.status_  + '"'                    skip( 1 )
    10379       view-as alert-box error .
    10380     end.
    10381     return substitute( 'Имеется документ "&1" &2 в статусе "&3".&4Объект &5 &6.&4Смена: &7 порядок: &8 номер: &9'
    10382                      , bf_trn-doc.doc-code
    10383                      , ext-doc-name
    10384                      , bf_trn-doc.status_
    10385                      , chr(10)
    10386                      , bf_shift-obj.obj-type
    10387                      , bf_shift-obj.obj-code
    10388                      , bf_shift-obj.shift-date
    10389                      , bf_shift-obj.shift-num
    10390                      , bf_shift-obj.shift-name ) .
    10391   end.
    10392       assign
    10393         p-found = no
    10394       .
    10395     end.
    10396   end procedure.
    10397   procedure lib-trn3_invdnull :
    10398     define input parameter p-doc-code like ub.trn-doc.doc-code no-undo.
    10399     define input parameter p-talk-on  as   logical             no-undo.
    10400     define variable r_trn-doc   as recid     no-undo.
    10401     define variable r_trn-lin   as recid     no-undo.
    10402     define variable v_inv-null  as character no-undo.
    10403     define variable v_data-type as character no-undo.
    10404     define variable l-inv-on    as logical   no-undo.
    10405     define buffer bf_trn-doc  for ub.trn-doc.
    10406     define buffer bf_trn-line for ub.doc-line.
    10407     define buffer bf_doc-line for ub.doc-line.
    10408     define buffer bf_gds-dtl  for ub.gds-dtl.
    10409     define buffer bf_inv-line for ub.inv-line.
    10410     define buffer bf_parts    for ub.parts.
    10411     Main-Block:
    10412     do on error undo Main-Block, return error return-value :
    10413       find first bf_trn-doc no-lock where
    10414                  bf_trn-doc.doc-code = p-doc-code no-error.
    10415       if not available bf_trn-doc then do:
    10416         if p-talk-on = yes then do:
    10417           message "lib-trn3_invdnull:"                                                  skip( 1 )
    10418                   substitute( 'Не найдена инвентаризация с номером "&1".', p-doc-code ) skip( 1 )
    10419           view-as alert-box error.
    10420         end.
    10421         undo Main-Block, return error substitute( 'Не найдена инвентаризация с номером "&1".', p-doc-code ).
    10422       end.
    10423       if bf_trn-doc.ext-doc-type <> 'vt':U then do:
    10424         if p-talk-on = yes then do:
    10425           message "lib-trn3_invdnull:"                                                             skip( 1 )
    10426                   substitute( 'Документ с номером "&1" не является инвентаризацией.', p-doc-code ) skip( 1 )
    10427           view-as alert-box error.
    10428         end.
    10429         undo Main-Block, return error substitute( 'Документ с номером "&1" не является инвентаризацией.', p-doc-code ).
    10430       end.
    10431   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10432   empty temp-table thbjattr_thbj-attr.
    10433   run adm/shattri.p (
    10434      input "get":U
    10435     ,input bf_trn-doc.obj-type
    10436     ,input bf_trn-doc.obj-code
    10437     ,input 'inv-obj':U
    10438     ,input  ""
    10439     ,output v-value-character
    10440     ,output v-value-date
    10441     ,output v-value-decimal
    10442     ,output v-value-integer
    10443     ,output v-value-logical
    10444     ,output par-type
    10445     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    10446     ) no-error .
    10447       for each thbjattr_thbj-attr :
    10448           if thbjattr_thbj-attr.prop-code = 'invdnull' then v_inv-null = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
    10449       end.
    10450       empty temp-table thbjattr_thbj-attr.
    10451       if v_inv-null = "no" then do: return. end.
    10452       assign r_trn-doc = recid( bf_trn-doc ).
    10453       find first bf_trn-doc exclusive-lock where
    10454           recid( bf_trn-doc ) = r_trn-doc.
    10455       check-line:
    10456       for each bf_doc-line no-lock where
    10457                bf_doc-line.doc-code = bf_trn-doc.doc-code :
    10458         if bf_doc-line.doc-qnty  <> 0.00 or
    10459            bf_doc-line.fact-qnty <> 0.00 then do:
    10460           next check-line.
    10461         end.
    10462         for each bf_gds-dtl no-lock where
    10463                  bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
    10464                  bf_gds-dtl.artic     = bf_doc-line.artic     and
    10465                  bf_gds-dtl.prod-type = bf_doc-line.prod-type and
    10466                  bf_gds-dtl.prod-code = bf_doc-line.prod-code :
    10467           if bf_gds-dtl.doc-qnty  <> 0.00 or
    10468              bf_gds-dtl.fact-qnty <> 0.00 then do:
    10469             next check-line.
    10470           end.
    10471         end.
    10472         for each bf_parts no-lock where
    10473                  bf_parts.out-code  = bf_doc-line.doc-code  and
    10474                  bf_parts.obj-type  = bf_trn-doc.obj-type   and
    10475                  bf_parts.obj-code  = bf_trn-doc.obj-code   and
    10476                  bf_parts.artic     = bf_doc-line.artic     and
    10477                  bf_parts.prod-type = bf_doc-line.prod-type and
    10478                  bf_parts.prod-code = bf_doc-line.prod-code :
    10479           if bf_parts.fact-qnty <> 0.00 then do:
    10480             next check-line.
    10481           end.
    10482         end.
    10483         find first bf_inv-line no-lock where
    10484                    bf_inv-line.doc-code  = bf_doc-line.doc-code  and
    10485                    bf_inv-line.artic     = bf_doc-line.artic     and
    10486                    bf_inv-line.prod-type = bf_doc-line.prod-type and
    10487                    bf_inv-line.prod-code = bf_doc-line.prod-code no-error.
    10488         if available bf_inv-line then do:
    10489           if bf_inv-line.before-cli-qnty <> 0.00 or
    10490              bf_inv-line.after-cli-qnty  <> 0.00 or
    10491              bf_inv-line.wast-cli-qnty   <> 0.00 or
    10492              bf_doc-line.cli-qnty        <> 0.00 then do:
    10493             next check-line.
    10494           end.
    10495         end.
    10496         assign r_trn-lin = recid( bf_doc-line ).
    10497         delete-line:
    10498         do on error undo Main-Block, return error return-value :
    10499           find first bf_trn-line exclusive-lock where
    10500               recid( bf_trn-line ) = r_trn-lin.
    10501   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    10503     (input  bf_trn-line.obj-type
    10504     ,input  bf_trn-line.obj-code
    10505     ,input  bf_trn-line.artic
    10506     ,input  bf_trn-line.prod-type
    10507     ,input  bf_trn-line.prod-code
    10508     ,input  'inv-on=false'
    10509     ,output l-inv-on
    10510     ) no-error .
    10511           if error-status :error then do:
    10512             if p-talk-on = yes then do:
    10513               message "lib-trn3_invdnull:"                                                      skip( 1 )
    10514                       "Ошибка установки атрибута товара на объекте"                             skip( 0 )
    10515                       "Документ:" '"' + bf_trn-line.doc-code + '"'                              skip( 0 )
    10516                       "Объект:"   bf_trn-line.obj-type bf_trn-line.obj-code                     skip( 0 )
    10517                       "Товар:"    bf_trn-line.artic bf_trn-line.prod-type bf_trn-line.prod-code skip( 0 )
    10518                       "l-inv-on:" l-inv-on                                                      skip( 1 )
    10519               view-as alert-box error.
    10520             end.
    10521             undo, return error substitute( 'lib-trn3_invdnull: Ошибка установки атрибута товара на объекте.&1'
    10522                                          + 'Документ: "&2".&1Объект: &3 &4.&1Товар: &5 &6 &7.&1l-inv-on: &8.'
    10523                                          , chr(10)
    10524                                          , bf_trn-line.doc-code
    10525                                          , bf_trn-line.obj-type
    10526                                          , bf_trn-line.obj-code
    10527                                          , bf_trn-line.artic
    10528                                          , bf_trn-line.prod-type
    10529                                          , bf_trn-line.prod-code
    10530                                          , l-inv-on ).
    10531           end.
    10532           delete bf_trn-line.
    10533         end.
    10534       end.
    10535       find first bf_trn-doc no-lock where
    10536           recid( bf_trn-doc ) = r_trn-doc.
    10537     end.
    10538   end procedure.
    10539   procedure lib-trn3_chkslpr :
    10540   define input parameter pardoc-code  like ub.doc-line.doc-code  no-undo.
    10541   define input parameter parartic     like ub.doc-line.artic     no-undo.
    10542   define input parameter parprod-type like ub.doc-line.prod-type no-undo.
    10543   define input parameter parprod-code like ub.doc-line.prod-code no-undo.
    10544   define buffer bf_doc-line for ub.doc-line.
    10545   do on error undo, return error return-value :
    10546     find first bf_doc-line where bf_doc-line.doc-code  = pardoc-code  and
    10547                                  bf_doc-line.artic     = parartic     and
    10548                                  bf_doc-line.prod-type = parprod-type and
    10549                                  bf_doc-line.prod-code = parprod-code no-lock.
    10550     run clcprtsl_calc-line in this-procedure (recid(bf_doc-line)) no-error.
    10551     if error-status:error then do:
    10552       return error return-value.
    10553     end.
    10554     find first tt-allsum-line where tt-allsum-line.sum-type = 'основная_сумма':U.
    10555     if sum-dsc-rubl-doc < sum-dsc-rubl-acc then do:
    10556       return error substitute("Цена реализации товара &1 &2 &3 в национальной валюте &4 ниже цены товара по учетным ценам &5.", bf_doc-line.artic, bf_doc-line.prod-type, bf_doc-line.prod-code, sum-dsc-rubl-doc / bf_doc-line.fact-qnty , sum-dsc-rubl-acc / bf_doc-line.fact-qnty).
    10557     end.
    10558     if sum-dsc-base-doc < sum-dsc-base-acc then do:
    10559       return error substitute("Цена реализации товара &1 &2 &3 в базовой валюте &4 ниже цены товара по учетным ценам &5.", bf_doc-line.artic, bf_doc-line.prod-type, bf_doc-line.prod-code, sum-dsc-base-doc / bf_doc-line.fact-qnty, sum-dsc-base-acc / bf_doc-line.fact-qnty).
    10560     end.
    10561   end.
    10562   end procedure.
    10563   procedure lib-trn3_goods-tr :
    10564     define input parameter parrec-doc   as recid no-undo .
    10565     define input parameter parrec-goods as recid no-undo .
    10566     define variable is-hold-doc        as   logical           no-undo .
    10567     define variable can-process        as   logical           no-undo .
    10568     define variable is-petrol          as   logical           no-undo .
    10569     define variable is-pieces          as   logical           no-undo .
    10570     define variable is-petrolium-gds-b as   logical           no-undo .
    10571     define variable is-pieces-gds-b    as   logical           no-undo .
    10572     define variable varres             as   logical           no-undo .
    10573     define variable var-code-temp      like ub.pl-gds.pl-code no-undo .
    10574     define buffer gds-b       for ub.goods    .
    10575     define buffer cg_trn-doc  for ub.trn-doc  .
    10576     define buffer cg_goods    for ub.goods    .
    10577     define buffer cg_doc-line for ub.doc-line .
    10578     define variable l-inv-on          as logical   no-undo .
    10579     define variable v-can-edit-inv-on as character no-undo .
    10580     do
    10581     on error undo, return error return-value
    10582     :
    10583       find first cg_trn-doc where
    10584           recid( cg_trn-doc ) = parrec-doc .
    10585       find first cg_goods   where
    10586           recid( cg_goods )   = parrec-goods .
    10587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run trnat in g#library
    10588     (input  cg_trn-doc.doc-type
    10589     ,input  cg_trn-doc.internal
    10590     ,input  cg_trn-doc.discnt-type
    10591     ,input  cg_trn-doc.status_
    10592     ,input  cg_trn-doc.flag_
    10593     ,input  cg_trn-doc.ext-doc-type
    10594     ,input  'can-edit-inv-on=request':u
    10595     ,output v-can-edit-inv-on
    10596     ) no-error .
    10597       if error-status :error
    10598       then do:
    10599         undo, return error substitute( "Невозможно запросить признак складского документа &1 &2"
    10600                                      , error-status :get-message( 1 )
    10601                                      , return-value
    10602                                      ) .
    10603       end.
    10604       if v-can-edit-inv-on <> "true":u
    10605       then do:
    10606   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10607   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    10608     (input  cg_trn-doc.obj-type
    10609     ,input  cg_trn-doc.obj-code
    10610     ,input  cg_goods.artic
    10611     ,input  cg_goods.prod-type
    10612     ,input  cg_goods.prod-code
    10613     ,input  'inv-on=request'
    10614     ,output l-inv-on
    10615     ) no-error .
    10616         if error-status :error
    10617         then do:
    10618           undo, return error substitute( "Ошибка получения признака товара на объекте &1 &2."
    10619                                        , error-status :get-message( 1 )
    10620                                        , return-value
    10621                                        ) .
    10622         end.
    10623       end.
    10624   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10625   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
    10626     (input  cg_trn-doc.doc-code
    10627     ,output is-hold-doc
    10628     ) no-error .
    10629       if error-status :error
    10630       then do:
    10631         undo, return error "goods-tr: Ошибка получения признака межфирменного перемещения." .
    10632       end.
    10633       if l-inv-on = yes and
    10634          cg_trn-doc.status_ <> 'запрос':U
    10635       then do:
    10636         return error substitute( 'Артикул : &1 "&2" - товар в инвентаризации. Операция невозможна.'
    10637                                , cg_goods.artic
    10638                                , cg_goods.gds-name
    10639                                ) .
    10640       end.
    10641       if lookup( cg_goods.gds-type, 'у':U ) > 0 and
    10642          ( cg_trn-doc.doc-type <> 'рас':U or
    10643            cg_trn-doc.internal  = yes )
    10644       then do:
    10645         return error substitute( 'Выбрана УСЛУГА из справочника. Для документа с типом "&1", а также для внутренних '
    10646                                + 'перемещений услуги не предусмотрены. Артикул &2'
    10647                                , cg_trn-doc.doc-type
    10648                                ,cg_goods.artic
    10649                                ) .
    10650       end.
    10651       if cg_trn-doc.doc-type = 'рас':U and cg_trn-doc.internal = yes or
    10652          cg_trn-doc.doc-type = 'рас':U and cg_trn-doc.internal = no
    10653                                           and is-hold-doc         = yes
    10654       then do:
    10655         run plgdsfnd in this-procedure
    10656           (  input no
    10657           ,  input cg_trn-doc.obj-type
    10658           ,  input cg_trn-doc.obj-code
    10659           ,  input cg_goods.gds-code
    10660           , output varres
    10661           , output var-code-temp
    10662           ) no-error .
    10663         if error-status :error
    10664         then do:
    10665           undo, return error substitute( "Ошибка при проверке привязки товара к складскому месту: &1 &2 &3 &4"
    10666                                        , cg_goods.artic
    10667                                        , cg_goods.prod-type
    10668                                        , cg_goods.prod-code
    10669                                        , return-value
    10670                                        ) .
    10671         end.
    10672         if varres = yes
    10673         then do:
    10674   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    10675     (
    10676        input cg_goods.artic
    10677     ,  input cg_goods.prod-type
    10678     ,  input cg_goods.prod-code
    10679     , output is-petrol
    10680     , output is-pieces
    10681     ) no-error.
    10682           if error-status :error or
    10683              is-petrol <> yes or
    10684              is-pieces <> no
    10685           then do:
    10686   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_gdnorsrv in g#lib-trn4
    10687     (  input cg_goods.artic
    10688     ,  input cg_goods.prod-type
    10689     ,  input cg_goods.prod-code
    10690     ,  input cg_trn-doc.doc-code
    10691     , output can-process
    10692     )        no-error .
    10693             if error-status :error or
    10694                can-process <> yes
    10695             then do:
    10696             undo, return error substitute( "Товар &1 &2&3 резервируется по складским местам - "
    10697                                          + "&4&5 недопустим."
    10698                                          , cg_goods.artic
    10699                                          , cg_goods.prod-type
    10700                                          , cg_goods.prod-code
    10701                                          , entry( lookup( cg_trn-doc.ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
    10702                                          , ( if is-hold-doc = yes then "(межфирменные перемещения)" else "":U )
    10703                                          ) .
    10704             end.
    10705           end.
    10706         end.
    10707       end.
    10708       find first cg_doc-line no-lock where
    10709                  cg_doc-line.doc-code = cg_trn-doc.doc-code no-error .
    10710       if available cg_doc-line
    10711       then do:
    10712         find first gds-b no-lock where
    10713                    gds-b.artic     = cg_doc-line.artic     and
    10714                    gds-b.prod-type = cg_doc-line.prod-type and
    10715                    gds-b.prod-code = cg_doc-line.prod-code .
    10716                   if cg_trn-doc.doc-type <> "рас" then do:
    10717                 if gds-b.gds-type <> cg_goods.gds-type
    10718                 then do:
    10719                   return error "Услуги и товары не могут быть добавлены в один и тот же документ." .
    10720                 end.
    10721                   end.
    10722       end.
    10723       if cg_goods.stts = integer( '1':U )
    10724       then do:
    10725         return error substitute( "Товар &1 &2 &3 удален. Добавление невозможно."
    10726                                , cg_goods.artic
    10727                                , cg_goods.prod-type
    10728                                , cg_goods.prod-code
    10729                                ) .
    10730       end.
    10731       assign
    10732         cg_trn-doc.office = ( cg_goods.gds-type = 'у':U )
    10733       .
    10734     end.
    10735   end procedure.
    10736   procedure lib-trn3_chkqnpl :
    10737     define input  parameter p-doc-type like ub.trn-doc.doc-type no-undo .
    10738     define input  parameter p-obj-type like ub.doc-pl.obj-type  no-undo .
    10739     define input  parameter p-obj-code like ub.doc-pl.obj-code  no-undo .
    10740     define input  parameter p-pl-code  like ub.doc-pl.pl-code   no-undo .
    10741     define input  parameter p-gds-code like ub.doc-pl.gds-code  no-undo .
    10742     define input  parameter p-msg-on   as logical   no-undo .
    10743     define input  parameter p-qnty     as decimal   no-undo .
    10744     define output parameter p-new-qnty as decimal   no-undo .
    10745     define variable v-rest-qnty as decimal   no-undo .
    10746     define variable v-rest-av   as logical   no-undo .
    10747     define buffer buf-qnty_pl-gds for ub.pl-gds .
    10748     define buffer buf-qnty_place  for ub.place .
    10749     define buffer buf-qnty_goods  for ub.goods .
    10750     assign
    10751       v-rest-qnty = 0
    10752       v-rest-av   = false
    10753       p-new-qnty  = p-qnty
    10754     .
    10755     if is-sug(p-gds-code) then return .
    10756     if p-doc-type = 'инв':U then do:
    10757       return.
    10758     end.
    10759     find first buf-qnty_pl-gds no-lock
    10760       where buf-qnty_pl-gds.obj-type = p-obj-type
    10761         and buf-qnty_pl-gds.obj-code = p-obj-code
    10762         and buf-qnty_pl-gds.pl-code  = p-pl-code
    10763         and buf-qnty_pl-gds.gds-code = p-gds-code
    10764       no-error .
    10765     if not available buf-qnty_pl-gds then do:
    10766       message
    10767         vss-workfile vss-revision vss-description skip
    10768         "Ошибка задания входных параметров." skip
    10769         "Место хранения не найдено" skip
    10770         substitute( "код товара: &1", p-gds-code ) skip
    10771         substitute( "объект: &1 &2", p-obj-type, p-obj-code ) skip
    10772         substitute( "код места хранения: &1", p-pl-code ) skip
    10773         view-as alert-box error .
    10774       return error .
    10775     end.
    10776     else do:
    10777       assign
    10778         v-rest-av   = true
    10779       .
    10780     end.
    10781     if p-qnty >= 0 then do:
    10782       find first buf-qnty_goods no-lock
    10783         where buf-qnty_goods.gds-code = p-gds-code
    10784         .
    10785       if p-doc-type = 'при':U
    10786         or p-doc-type = 'возврат':U
    10787       then do:
    10788         assign
    10789           v-rest-qnty = buf-qnty_pl-gds.fact-qnty
    10790         .
    10791         find first buf-qnty_place no-lock
    10792           where buf-qnty_place.obj-type = p-obj-type
    10793             and buf-qnty_place.obj-code = p-obj-code
    10794             and buf-qnty_place.pl-code  = p-pl-code
    10795           no-error .
    10796         if available buf-qnty_place
    10797           and buf-qnty_place.chk-max-qnty = true
    10798           and buf-qnty_place.max-qnty <> ?
    10799           and buf-qnty_place.max-qnty > 0.0
    10800         then do:
    10801           if p-qnty > buf-qnty_place.max-qnty - v-rest-qnty then do:
    10802             if v-rest-av = false
    10803               or buf-qnty_place.max-qnty - v-rest-qnty < 0.0
    10804             then do:
    10805               assign
    10806                 p-new-qnty = 0.0
    10807               .
    10808             end.
    10809             else do:
    10810               assign
    10811                 p-new-qnty = buf-qnty_place.max-qnty - v-rest-qnty
    10812               .
    10813             end.
    10814             if p-msg-on = true then do:
    10815               find first buf-qnty_goods no-lock
    10816                 where buf-qnty_goods.gds-code = p-gds-code
    10817                 .
    10818               message
    10819                 substitute( "Невозможно установить количество больше чем доступно на месте хранения." ) skip(1)
    10820                 substitute( "Попытка установить: &1 (&2)", p-qnty, buf-qnty_goods.unit-base ) skip
    10821                 substitute( "Возможно установить: &1 (&2)", p-new-qnty, buf-qnty_goods.unit-base ) skip(1)
    10822                 substitute( "Т.к. максимально допустимое для места хранения: &1 (&2),", buf-qnty_place.max-qnty, buf-qnty_goods.unit-base ) skip
    10823                 substitute( "а расчетный остаток по месту хранения: &1 (&2).", (if v-rest-av = true then v-rest-qnty else ?), buf-qnty_goods.unit-base ) skip
    10824                 view-as alert-box information.
    10825             end.
    10826           end.
    10827         end.
    10828       end.
    10829       else do:
    10830         assign
    10831           v-rest-qnty = buf-qnty_pl-gds.fact-qnty
    10832         .
    10833         if p-qnty > v-rest-qnty then do:
    10834           if v-rest-av = false
    10835             or v-rest-qnty < 0.0
    10836           then do:
    10837             assign
    10838               p-new-qnty = 0.0
    10839             .
    10840           end.
    10841           else do:
    10842             assign
    10843               p-new-qnty = v-rest-qnty
    10844             .
    10845           end.
    10846           if p-msg-on = true then do:
    10847             find first buf-qnty_goods no-lock
    10848               where buf-qnty_goods.gds-code = p-gds-code
    10849               .
    10850             message
    10851               substitute( "Невозможно установить количество больше чем доступно на месте хранения." ) skip(1)
    10852               substitute( "Попытка установить: &1 (&2)", p-qnty, buf-qnty_goods.unit-base ) skip
    10853               substitute( "Возможно установить: &1 (&2)", p-new-qnty, buf-qnty_goods.unit-base ) skip(1)
    10854               substitute( "Т.к. расчетный остаток по месту хранения: &1 (&2).", (if v-rest-av = true then v-rest-qnty else ?), buf-qnty_goods.unit-base ) skip
    10855               view-as alert-box information.
    10856           end.
    10857         end.
    10858       end.
    10859     end.
    10860     else do:
    10861       if p-msg-on = true then do:
    10862         message
    10863           "Невозможно установить количество < 0." skip
    10864           view-as alert-box information.
    10865       end.
    10866       assign
    10867         p-new-qnty = 0.0
    10868       .
    10869     end.
    10870     return .
    10871   end procedure.
    10872   procedure lib-trn3_avprpart :
    10873   define input  parameter p-obj-type   as character no-undo .
    10874   define input  parameter p-obj-code   as integer   no-undo .
    10875   define input  parameter p-bar-code   as integer   no-undo .
    10876   define input  parameter p-node-code  as integer   no-undo .
    10877   define input  parameter p-fact-order as decimal   no-undo .
    10878   define output parameter p-doc-num    as character no-undo .
    10879   define output parameter p-price-sale as decimal   no-undo .
    10880   define output parameter p-road-tax   as decimal   no-undo .
    10881   define output parameter p-excise     as decimal   no-undo .
    10882   define variable p-gds-code as integer   no-undo .
    10883   define buffer buf_gds-obj for ub.gds-obj  .
    10884   define buffer buf_parts for ub.parts  .
    10885   define buffer buf_price-list for ub.price-list  .
    10886   define variable v-qnty as decimal   no-undo .
    10887   define variable main-b-code as integer   no-undo .
    10888   define variable k as integer   no-undo .
    10889     do
    10890     on error undo, return error return-value
    10891     :
    10892     define buffer buf_bar-code for ub.bar-code  .
    10893     find first buf_bar-code no-lock where buf_bar-code.b-code = p-bar-code no-error .
    10894     if error-status :error then return .
    10895     p-gds-code = buf_bar-code.gds-code .
    10896   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
    10897     (input  p-gds-code
    10898     ,input  ?
    10899     ,output main-b-code
    10900     ) no-error .
    10901   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10902   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
    10903     (input  p-obj-type
    10904     ,input  p-obj-code
    10905     ,input  main-b-code
    10906     ,input  0
    10907     ,input  p-fact-order
    10908     ,output p-doc-num
    10909     ,output p-price-sale
    10910     ,output p-road-tax
    10911     ,output p-excise
    10912     ) no-error .
    10913    find first buf_gds-obj no-lock where
    10914               buf_gds-obj.obj-type = p-obj-type and
    10915               buf_gds-obj.obj-code = p-obj-code and
    10916               buf_gds-obj.gds-code = p-gds-code and
    10917               buf_gds-obj.cash-parts = true no-error .
    10918   if not available buf_gds-obj then return .
    10919   assign
    10920     p-price-sale = 0
    10921     p-road-tax   = 0
    10922     p-excise     = 0
    10923     v-qnty       = 0
    10924   .
    10925   k = 0.
    10926    for each buf_price-list no-lock where
    10927             buf_price-list.doc-num    = p-doc-num and
    10928             buf_price-list.price-type = "" and
    10929             buf_price-list.main-price = false and
    10930             buf_price-list.artic      = buf_gds-obj.artic and
    10931             buf_price-list.prod-type  = buf_gds-obj.prod-type and
    10932             buf_price-list.prod-code  = buf_gds-obj.prod-code and
    10933             buf_price-list.doc-qnty > 0
    10934             :
    10935             k = k + 1.
    10936             p-price-sale = p-price-sale + buf_price-list.price-sale * buf_price-list.doc-qnty.
    10937             p-road-tax   = p-road-tax   + buf_price-list.road-tax * buf_price-list.doc-qnty.
    10938             p-excise     = p-excise     + buf_price-list.excise * buf_price-list.doc-qnty.
    10939             v-qnty       = v-qnty + buf_price-list.doc-qnty.
    10940     end.
    10941     if k = 0 then do:
    10942       for each buf_price-list no-lock where
    10943                 buf_price-list.doc-num    = p-doc-num and
    10944                 buf_price-list.price-type = "" and
    10945                 buf_price-list.b-code     = main-b-code and
    10946                 buf_price-list.main-price = true and
    10947                 buf_price-list.artic      = buf_gds-obj.artic and
    10948                 buf_price-list.prod-type  = buf_gds-obj.prod-type and
    10949                 buf_price-list.prod-code  = buf_gds-obj.prod-code
    10950                 :
    10951                 p-price-sale =  buf_price-list.price-sale .
    10952                 p-road-tax   =  buf_price-list.road-tax .
    10953                 p-excise     =  buf_price-list.excise.
    10954                 v-qnty       =  0 .
    10955         end.
    10956     end.
    10957     else do:
    10958         assign
    10959           p-price-sale = p-price-sale / v-qnty
    10960           p-road-tax   = p-road-tax   / v-qnty
    10961           p-excise     = p-excise     / v-qnty
    10962         .
    10963     end.
    10964     if p-price-sale = ? then p-price-sale = 0.
    10965     if p-road-tax   = ? then p-road-tax = 0.
    10966     if p-excise     = ? then p-excise  = 0.
    10967     end.
    10968   end procedure.
    10969   procedure CrTempDump:
    10970      define input parameter p-obj-type as character no-undo.
    10971      define input parameter p-obj-code as integer no-undo.
    10972      define input parameter p-shift-date as date no-undo.
    10973      define input parameter p-shift-num as integer no-undo.
    10974      define input parameter p-pl-code as integer no-undo.
    10975      define input parameter p-gds-code as integer no-undo.
    10976      define buffer buf_rvs-doc for ub.rvs-doc.
    10977      define buffer buf_rvs-line for ub.rvs-line.
    10978      define buffer buf_rvs-doc_end for ub.rvs-doc.
    10979      define buffer buf_doc-line-attr  for ub.doc-line-attr.
    10980      define buffer buf_doc-line-attr1 for ub.doc-line-attr.
    10981      define variable vBegTime as datetime no-undo.
    10982      define variable vEndTime as datetime no-undo.
    10983      define variable vTimeAutoSkip as integer no-undo.
    10984      vTimeAutoSkip = if ptrlprop-autopump-skip-time <> ? then ptrlprop-autopump-skip-time else 0.
    10985      rvsdoc:
    10986      for each buf_rvs-doc no-lock
    10987           where buf_rvs-doc.obj-type   = p-obj-type
    10988             and buf_rvs-doc.obj-code   = p-obj-code
    10989             and buf_rvs-doc.shift-date = p-shift-date
    10990             and buf_rvs-doc.shift-num  = p-shift-num
    10991             and buf_rvs-doc.status_    = 'факт':U
    10992             and buf_rvs-doc.rvs-type  = 'перед_док':U
    10993           ,first buf_rvs-line no-lock
    10994           where buf_rvs-line.rvs-code   = buf_rvs-doc.rvs-code
    10995             and buf_rvs-line.obj-type   = buf_rvs-doc.obj-type
    10996             and buf_rvs-line.obj-code   = buf_rvs-doc.obj-code
    10997             and buf_rvs-line.pl-code    = p-pl-code
    10998             and buf_rvs-line.gds-code   = p-gds-code:
    10999         find first  buf_rvs-doc_end no-lock
    11000              where buf_rvs-doc_end.rvs-type = 'после_док':U
    11001             and buf_rvs-doc_end.out-code =  buf_rvs-doc.out-code
    11002             no-error.
    11003         if not avail buf_rvs-doc_end then next  rvsdoc.
    11004         find first buf_doc-line-attr no-lock where
    11005                    buf_doc-line-attr.doc-code = buf_rvs-doc.out-code
    11006                and buf_doc-line-attr.gds-code = buf_rvs-line.gds-code
    11007                and buf_doc-line-attr.attr-code begins "date-start"
    11008            no-error.
    11009         find first buf_doc-line-attr1 no-lock where
    11010                    buf_doc-line-attr1.doc-code = buf_rvs-doc.out-code
    11011                and buf_doc-line-attr1.gds-code = buf_rvs-line.gds-code
    11012                and buf_doc-line-attr1.attr-code begins "time-start"
    11013            no-error.
    11014         if available buf_doc-line-attr and
    11015            available buf_doc-line-attr1
    11016         then  vBegTime = datetime(date(buf_doc-line-attr.attr-value), (int(buf_doc-line-attr1.attr-value) * 1000 )).
    11017         else  vBegTime = datetime(buf_rvs-doc.sys-date, (buf_rvs-doc.sys-time-int * 1000 )).
    11018         find first buf_doc-line-attr no-lock where
    11019                    buf_doc-line-attr.doc-code = buf_rvs-doc.out-code
    11020                and buf_doc-line-attr.gds-code = buf_rvs-line.gds-code
    11021                and buf_doc-line-attr.attr-code begins "date-end"
    11022            no-error.
    11023         find first buf_doc-line-attr1 no-lock where
    11024                    buf_doc-line-attr1.doc-code = buf_rvs-doc.out-code
    11025                and buf_doc-line-attr1.gds-code = buf_rvs-line.gds-code
    11026                and buf_doc-line-attr1.attr-code begins "time-end"
    11027            no-error.
    11028         if available buf_doc-line-attr and
    11029            available buf_doc-line-attr1
    11030         then  vEndTime = datetime(date(buf_doc-line-attr.attr-value), ((int(buf_doc-line-attr1.attr-value) + vTimeAutoSkip * 60) * 1000 )).
    11031         else  vEndTime = datetime(buf_rvs-doc_end.sys-date, ((buf_rvs-doc_end.sys-time-int + vTimeAutoSkip * 60) * 1000 )).
    11032         create ttDump.
    11033         assign
    11034            ttDump.BegTime = vBegTime
    11035            ttDump.EndTime = vEndTime
    11036            .
    11037         if session:debug-alert
    11038         then do:
    11039            OUTPUT STREAM out_s TO "avrgdens.log" APPEND.
    11040            put stream out_s unformatted "Приемка топлива: "
    11041            " Начало слива " ttDump.BegTime
    11042            " Конец слива плюс время пропуска после слива " ttDump.EndTime
    11043            " Время пропуска автосверок после слива " vTimeAutoSkip
    11044            " Топливо " p-pl-code
    11045            " Код товара " p-gds-code
    11046            skip.
    11047            OUTPUT STREAM out_s CLOSE.
    11048         end.
    11049      end.
    11050   end procedure.
    11051   procedure ChkRvsSkip:
    11052      define input parameter p-obj-type     as character no-undo.
    11053      define input parameter p-obj-code     as integer   no-undo.
    11054      define input parameter p-rvs-code     as character no-undo.
    11055      define input parameter p-pl-code      as integer   no-undo.
    11056      define input parameter p-gds-code     as integer   no-undo.
    11057      define input parameter p-sys-date     as date      no-undo.
    11058      define input parameter p-sys-time-int as integer   no-undo.
    11059      define output parameter vNeedSkip     as logical   no-undo.
    11060      define buffer buf_doc-attr      for ub.doc-attr.
    11061      define buffer buf_rvs-line-attr for ub.rvs-line-attr.
    11062      vNeedSkip = no.
    11063      if can-find(first buf_doc-attr no-lock where
    11064                        buf_doc-attr.doc-code = p-rvs-code
    11065                    and buf_doc-attr.attr-code = "rvs-auto"
    11066                    and buf_doc-attr.attr-value = "Yes")
    11067          and can-find(first buf_rvs-line-attr no-lock where
    11068                             buf_rvs-line-attr.obj-code  = p-obj-code
    11069                         and buf_rvs-line-attr.obj-type  = p-obj-type
    11070                         and buf_rvs-line-attr.gds-code  = p-gds-code
    11071                         and buf_rvs-line-attr.pl-code   = p-pl-code
    11072                         and buf_rvs-line-attr.rvs-code  = p-rvs-code
    11073                         and buf_rvs-line-attr.attr-code = "rvd-on"
    11074                         and buf_rvs-line-attr.attr-value > "")
    11075      then vNeedSkip = yes.
    11076      else do:
    11077         find first ttDump where
    11078                    ttDump.BegTime <= datetime(p-sys-date, (p-sys-time-int * 1000 ))
    11079                and ttDump.EndTime >= datetime(p-sys-date, (p-sys-time-int * 1000 ))
    11080                no-error.
    11081         if available ttDump then do:
    11082            if session:debug-alert
    11083            then do:
    11084               OUTPUT STREAM out_s TO "avrgdens.log" APPEND.
    11085               put stream out_s unformatted "Пропуск автосверки из-за попадания в период слива: "
    11086               " Время сверки " datetime(p-sys-date, (p-sys-time-int * 1000 ))
    11087               " Начало слива " ttDump.BegTime
    11088               " Конец слива плюс время пропуска после слива " ttDump.EndTime
    11089               " Топливо " p-pl-code
    11090               " Код товара " p-gds-code
    11091               skip.
    11092               OUTPUT STREAM out_s CLOSE.
    11093            end.
    11094            vNeedSkip = yes.
    11095         end.
    11096      end.
    11097   end procedure.
