     4499   procedure placelib_write-attr:
     4500   define input  parameter p-code     like ub.place-attr.attr-code .
     4501   define input  parameter p-obj-code like ub.place-attr.obj-code .
     4502   define input  parameter p-obj-type like ub.place-attr.obj-type .
     4503   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     4504   define input  parameter p-value    like ub.place-attr.attr-value .
     4505   define output parameter p-ok       as logical.
     4506   define buffer buf_place-attr for ub.place-attr .
     4507     do on error undo, return error return-value :
     4508        p-ok = false.
     4509        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     4510                                                   and buf_place-attr.obj-code    = p-obj-code
     4511                                                   and buf_place-attr.obj-type    = p-obj-type
     4512                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     4513        if not available buf_place-attr then do :
     4514           create buf_place-attr.
     4515           assign
     4516             buf_place-attr.attr-code   = p-code
     4517             buf_place-attr.attr-value  = p-value
     4518             buf_place-attr.obj-code    = p-obj-code
     4519             buf_place-attr.obj-type    = p-obj-type
     4520             buf_place-attr.pl-code     = p-pl-code
     4521           .
     4522           p-ok = true.
     4523        end.
     4524        else do:
     4525           buf_place-attr.attr-value  = p-value .
     4526           p-ok = true.
     4527        end.
     4528     end.
     4529   end.
     4530   procedure placelib_get-attr:
     4531   define input  parameter  p-code     like ub.place-attr.attr-code .
     4532   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     4533   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     4534   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     4535   define output parameter  p-value    like ub.place-attr.attr-value .
     4536   define output parameter  p-ok       as logical.
     4537   define buffer buf_place-attr for ub.place-attr .
     4538     do on error undo, return error return-value :
     4539        p-ok = false.
     4540        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     4541                                                   and buf_place-attr.obj-code    = p-obj-code
     4542                                                   and buf_place-attr.obj-type    = p-obj-type
     4543                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     4544        if available buf_place-attr then do :
     4545          p-value = buf_place-attr.attr-value.
     4546          p-ok = true.
     4547        end.
     4548        else do :
     4549          p-ok = false.
     4550        end.
     4551     end.
     4552   end.
     4553   procedure placelib_del-attr:
     4554   define input parameter  p-code     like ub.place-attr.attr-code .
     4555   define input parameter  p-obj-code like ub.place-attr.obj-code .
     4556   define input parameter  p-obj-type like ub.place-attr.obj-type .
     4557   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     4558   define input parameter  p-value    like ub.place-attr.attr-value .
     4559   define output parameter p-ok       as logical.
     4560   define buffer buf_place-attr for ub.place-attr .
     4561     do on error undo, return error return-value :
     4562        p-ok = false.
     4563        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     4564                                                   and buf_place-attr.obj-code    = p-obj-code
     4565                                                   and buf_place-attr.obj-type    = p-obj-type
     4566                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     4567        if available buf_place-attr then do :
     4568           delete buf_place-attr.
     4569           p-ok = true.
     4570        end.
     4571     end.
     4572   end.
     4573   define temp-table temp-tpsi-clients no-undo like ub.clients.
     4574   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4575   procedure tpsi-gds-fill-tpsi-obj-table :
     4576   define input parameter p-db-num like ub.db.db-num no-undo .
     4577   define variable v-is-tpsi-obj as logical no-undo .
     4578   define buffer buf_clients for ub.clients.
     4579     do
     4580     on error undo, return error return-value
     4581     :
     4582       for each temp-tpsi-clients :
     4583         delete temp-tpsi-clients.
     4584       end.
     4585       _clients:
     4586       for each buf_clients no-lock where
     4587             buf_clients.db-num = p-db-num:
     4588         assign
     4589         v-is-tpsi-obj = no.
     4590         run gbl/tpsi-obj.p (
     4591                         input buf_clients.obj-type
     4592                       ,input buf_clients.obj-code
     4593                       ,output v-is-tpsi-obj) .
     4594         if not v-is-tpsi-obj then NEXT _clients.
     4595         create temp-tpsi-clients.
     4596         buffer-copy
     4597         buf_clients to
     4598         temp-tpsi-clients.
     4599       end.
     4600     end.
     4601   end procedure.
     4602   procedure tpsi-gds-proprietor :
     4603   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     4604   define input parameter p-db-num   like ub.db.db-num      no-undo .
     4605   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
     4606   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
     4607   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
     4608   define variable v-is-tpsi-obj as logical no-undo .
     4609   do
     4610   on error undo, return error return-value
     4611   :
     4612       define buffer buf_clients for ub.clients.
     4613       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     4614       assign
     4615       p-proprietor-obj-type = "":U
     4616       p-proprietor-obj-code = ?
     4617       p-proprietor-host-code = ?
     4618       .
     4619       _gds-obj-attr:
     4620       for each buf_clients no-lock where
     4621               buf_clients.db-num = p-db-num,
     4622         each buf_gds-obj-attr no-lock where
     4623             buf_gds-obj-attr.obj-type = buf_Clients.obj-type
     4624         AND buf_gds-obj-attr.obj-code = buf_clients.obj-code
     4625         AND buf_gds-obj-attr.gds-code = p-gds-code
     4626         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
     4627         if logical(buf_gds-obj-attr.attr-value) = yes then do:
     4628           assign
     4629           v-is-tpsi-obj = no.
     4630           run gbl/tpsi-obj.p (
     4631                           input buf_gds-obj-attr.obj-type
     4632                         ,input buf_gds-obj-attr.obj-code
     4633                         ,output v-is-tpsi-obj) .
     4634           if not v-is-tpsi-obj then NEXT _gds-obj-attr.
     4635           assign
     4636           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
     4637           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
     4638           p-proprietor-host-code = buf_clients.host-code
     4639           .
     4640           LEAVE.
     4641         end.
     4642       end.
     4643   end.
     4644   end procedure.
     4645   procedure tpsi-preselect-gds-proprietor :
     4646   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     4647   define input parameter p-db-num   like ub.db.db-num      no-undo .
     4648   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
     4649   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
     4650   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
