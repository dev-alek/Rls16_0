     6178   procedure lib-trn3_adinvlin:
     6179   define  input parameter parmain-menu-handle as   handle                no-undo.
     6180   define  input parameter pardoc-code         like ub.doc-line.doc-code  no-undo.
     6181   define  input parameter parartic            like ub.doc-line.artic     no-undo.
     6182   define  input parameter parprod-type        like ub.doc-line.prod-type no-undo.
     6183   define  input parameter parprod-code        like ub.doc-line.prod-code no-undo.
     6184   define output parameter parrecid            as   recid                 no-undo.
     6185     do
     6186     on error undo, return error return-value
     6187     :
     6188       define variable v-vat-pc        like ub.doc-line.vat-pc   no-undo.
     6189       define variable v-slt-pc        like ub.doc-line.slt-pc   no-undo.
     6190       define variable v-have-slt-pc   as   logical              no-undo.
     6191       define variable v-host-code     like ub.sysconf.host-code no-undo.
     6192       define buffer bf_goods    for ub.goods.
     6193       define buffer bf_trn-doc  for ub.trn-doc.
     6194       define buffer bf_doc-line for ub.doc-line.
     6195       define buffer bf_sysconf  for ub.sysconf.
     6196       find first bf_trn-doc no-lock
     6197         where bf_trn-doc.doc-code = pardoc-code
     6198         .
     6199       find first bf_sysconf no-lock
     6200         where bf_sysconf.host-code = bf_trn-doc.host-code
     6201         .
     6202       find first bf_goods no-lock
     6203         where bf_goods.artic     = parartic
     6204           and bf_goods.prod-type = parprod-type
     6205           and bf_goods.prod-code = parprod-code
     6206         .
     6207       if bf_goods.gds-type = 'у':U then do:
     6208         return error.
     6209       end.
     6210       find bf_doc-line
     6211         where bf_doc-line.artic     = parartic
     6212           and bf_doc-line.prod-type = parprod-type
     6213           and bf_doc-line.prod-code = parprod-code
     6214           and bf_doc-line.doc-code  = pardoc-code
     6215         no-error.
     6216       if not available bf_doc-line then do:
     6217   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6218   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6219     (input  bf_trn-doc.obj-type
     6220     ,input  bf_trn-doc.obj-code
     6221     ,output v-host-code
     6222     )  .
     6223   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6224   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6225     (input  bf_goods.gds-code
     6226     ,input  '1':U
     6227     ,input  ?
     6228     ,input  v-host-code
     6229     ,input  bf_trn-doc.obj-type
     6230     ,input  bf_trn-doc.obj-code
     6231     ,output v-vat-pc
     6232     ) no-error .
     6233   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_st-sltpc in g#lib-trn
     6234   (
     6235    input  recid(bf_goods)
     6236   ,input  recid(bf_trn-doc)
     6237   ,input  bf_sysconf.cash-pay
     6238   ,output v-slt-pc
     6239   )
     6240   .
     6241         if bf_sysconf.cons-vat-pc = ? then do:
     6242           return error "У Вас не установлен НДС для консигнационного товара по фирме.".
     6243         end.
     6244   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclin in g#lib-trn
     6245   (input bf_trn-doc.doc-code
     6246   ,input bf_goods.artic
     6247   ,input bf_goods.prod-type
     6248   ,input bf_goods.prod-code
     6249   ,input bf_trn-doc.obj-type
     6250   ,input bf_trn-doc.obj-code
     6251   ,input bf_trn-doc.status_
     6252   ,input bf_trn-doc.ext-doc-type
     6253   ,input bf_goods.prt-root
     6254   ,input v-vat-pc
     6255   ,input v-slt-pc
     6256   ,input bf_sysconf.cons-vat-pc
     6257   )
     6258   .
     6259         find first bf_doc-line exclusive-lock
     6260           where bf_doc-line.doc-code  = bf_trn-doc.doc-code
     6261             and bf_doc-line.artic     = bf_goods.artic
     6262             and bf_doc-line.prod-type = bf_goods.prod-type
     6263             and bf_doc-line.prod-code = bf_goods.prod-code
     6264           .
     6265   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_clr-line in g#lib-trn3
     6266   (input parmain-menu-handle
     6267   ,input bf_doc-line.doc-code
     6268   ,input bf_doc-line.artic
     6269   ,input bf_doc-line.prod-type
     6270   ,input bf_doc-line.prod-code
     6271   ,input 'исх':u
     6272   ) .
     6273       end.
     6274     end.
     6275     assign
     6276       parrecid = recid(bf_doc-line)
     6277     .
     6278   end procedure.
     6279   procedure lib-trn3_igdstpsi:
     6280   define input parameter pargds-code like ub.goods.gds-code   no-undo.
     6281   define input parameter parobj-type like ub.clients.obj-type no-undo.
     6282   define input parameter parobj-code like ub.clients.obj-code no-undo.
     6283   define buffer bf_goods   for ub.goods.
     6284   define buffer bf_clients for ub.clients.
     6285   define variable varproprietor-host-code like ub.clients.host-code no-undo.
     6286   define variable varproprietor-obj-type  like ub.clients.obj-type  no-undo.
     6287   define variable varproprietor-obj-code  like ub.clients.obj-code  no-undo.
     6288   define variable varals-gds              as   character            no-undo.
     6289   define variable vartypeals-gds          as   character            no-undo.
     6290   do on error undo, return error return-value :
     6291     find first bf_clients where bf_clients.obj-type = parobj-type and
     6292                                 bf_clients.obj-code = parobj-code no-lock.
     6293     run clntattr-value in this-procedure
     6294      (input  'орг':U,
     6295       input  bf_clients.host-code,
     6296       input  'als-gds':U,
     6297       output varals-gds,
     6298       output vartypeals-gds
     6299      ).
     6300     if varals-gds = "yes":u then do:
     6301       find first bf_goods where bf_goods.gds-code = pargds-code no-lock.
     6302       run tpsi-gds-fill-tpsi-obj-table in this-procedure (input bf_clients.db-num).
     6303       run tpsi-preselect-gds-proprietor in this-procedure (
     6304         input bf_goods.gds-code,
     6305         input bf_clients.db-num,
     6306         output varproprietor-host-code,
     6307         output varproprietor-obj-type,
     6308         output varproprietor-obj-code
     6309       ).
     6310       if varproprietor-host-code <> ?
     6311          and varproprietor-host-code <> bf_clients.host-code
     6312       then do:
     6313         return error substitute ("Товар &1 &2 &3 &4 на базе данных &5 принадлежит объекту &6 &7 фирмы &8. Наш объект принадлежит фирме &9. Приход товара недопустим.",
     6314                                  bf_goods.artic,
     6315                                  bf_goods.prod-type,
     6316                                  bf_goods.prod-code,
     6317                                  bf_goods.gds-name,
     6318                                  bf_clients.db-num,
     6319                                  varproprietor-obj-type,
     6320                                  varproprietor-obj-code,
     6321                                  varproprietor-host-code,
     6322                                  bf_clients.host-code).
     6323       end.
     6324     end.
     6325   end.
     6326   end procedure.
     6327   procedure lib-trn3_trdcattr-news:
     6328     do
     6329     on error undo, return error return-value
     6330     :
     6331       define input  parameter p-code           as character no-undo .
     6332       define output parameter p-news           as logical   no-undo .
     6333       case p-code :
     6334               when 'hold-part-code':U then do:     assign     p-news = true.   end.
     6335               when 'dov':U then do:     assign     p-news = true.   end.
     6336               when 'dids':U then do:     assign     p-news = true.   end.
     6337               when 'nids':U then do:     assign     p-news = true.   end.
     6338               when 'ddog':U then do:     assign     p-news = true.   end.
     6339               when 'ndog':U then do:     assign     p-news = true.   end.
     6340               when 'dsf':U then do:     assign     p-news = true.   end.
     6341               when 'nsf':U then do:     assign     p-news = true.   end.
     6342               when 'addsum':U then do:     assign     p-news = true.   end.
     6343               when 'clcasol':U then do:     assign     p-news = true.   end.
     6344               when 'clcaswt':U then do:     assign     p-news = true.   end.
     6345               when 'scanfile':U then do:     assign     p-news = true.   end.
     6346               when 'indoclnsum':U then do:     assign     p-news = true.   end.
     6347               when 'purchlimit':U then do:     assign     p-news = true.   end.
     6348               when 'purchcodelist':U then do:     assign     p-news = true.   end.
     6349               when 'expense_own':U then do:     assign     p-news = true.   end.
     6350               when 'envd':U then do:     assign     p-news = true.   end.
     6351               when 'acc-ship':U then do:     assign     p-news = true.   end.
     6352               when 'othermoves':U then do:     assign     p-news = true.   end.
     6353         otherwise do:
     6354           undo, return error "неизвестный атрибут документа" + " " + p-code .
     6355         end.
     6356       end.
     6357     end.
     6358   end procedure.
     6359   procedure lib-trn3_trdcattr-tooltip :
     6360     do
     6361     on error undo, return error return-value :
     6362       define input  parameter p-code    as character no-undo .
     6363       define output parameter p-tooltip as character no-undo .
     6364       define output parameter p-label   as character no-undo .
     6365       case p-code :
     6366               when 'hold-part-code':U then do:     assign     p-tooltip = "Номер партии для документа межфирменного перемещения"     p-label = "Номер партии для документа межфирменного перемещения" .   end.
     6367               when 'dov':U then do:     assign     p-tooltip = "Доверенность"     p-label = "Доверенность" .   end.
     6368               when 'dids':U then do:     assign     p-tooltip = "Дата приходной накладной поставщика"     p-label = "Дата приходной накладной поставщика" .   end.
     6369               when 'nids':U then do:     assign     p-tooltip = "Номер приходной накладной поставщика"     p-label = "Номер приходной накладной поставщика" .   end.
     6370               when 'ddog':U then do:     assign     p-tooltip = "Договор: Дата"     p-label = "Договор: Дата" .   end.
     6371               when 'ndog':U then do:     assign     p-tooltip = "Договор: Номер"     p-label = "Договор: Номер" .   end.
     6372               when 'dsf':U then do:     assign     p-tooltip = "Счет-фактура поставщика: Дата"     p-label = "Счет-фактура поставщика: Дата" .   end.
     6373               when 'nsf':U then do:     assign     p-tooltip = "Счет-фактура поставщика: Номер"     p-label = "Счет-фактура поставщика: Номер" .   end.
     6374               when 'addsum':U then do:     assign     p-tooltip = "Дополнительные суммы посчитанные по документу"     p-label = "Дополнительные суммы посчитанные по документу" .   end.
     6375               when 'clcasol':U then do:     assign     p-tooltip = "On-line расчет дополнительных сумм основных и после документа"     p-label = "On-line расчет дополнительных сумм основных и после документа" .   end.
     6376               when 'clcaswt':U then do:     assign     p-tooltip = "On-line расчет естественной убыли"     p-label = "On-line расчет естественной убыли" .   end.
     6377               when 'scanfile':U then do:     assign     p-tooltip = "Загруженные в документ сканерные файлы"     p-label = "Загруженные в документ сканерные файлы" .   end.
     6378               when 'indoclnsum':U then do:     assign     p-tooltip = "Заводить внешнюю приходную накладную через суммы"     p-label = "Заводить внешнюю приходную накладную через суммы" .   end.
     6379               when 'purchlimit':U then do:     assign     p-tooltip = "Есть в документе ограничение по типам кодов приобретения для резервирования"     p-label = "Есть в документе ограничение по типам кодов приобретения для резервирования" .   end.
     6380               when 'purchcodelist':U then do:     assign     p-tooltip = "Список кодов типов приобретения"     p-label = "Список кодов типов приобретения" .   end.
     6381               when 'expense_own':U then do:     assign     p-tooltip = "Расходы не включаемые в учетную цену"     p-label = "Расходы не включаемые в учетную цену" .   end.
     6382               when 'envd':U then do:     assign     p-tooltip = "Единый налог на вмененный доход"     p-label = "Единый налог на вмененный доход" .   end.
     6383                when 'othermoves':U then do:     assign     p-tooltip = "Признак топливной накладной с прочими перемещениями (для ИС Президентский Мониторинг)"     p-label = "Прочие перемещения НП" .   end.
     6384               when 'acc-ship':U then do:     assign     p-tooltip = "Допустимый % погрешности поставщика"     p-label = "Допустимый % погрешности поставщика" .   end.
     6385         otherwise do:
     6386           undo, return error "неизвестный атрибут документа" + " " + p-code .
     6387         end.
     6388       end.
     6389     end.
     6390   end procedure.
     6391   procedure lib-trn3_resv-inqv :
     6392     do
     6393     on error undo, return error return-value
     6394     :
     6395   define variable v-nabor as logical   no-undo .
     6396   define input  parameter  p-doc-code as character no-undo .
     6397   define output parameter  v-exit  as logical   no-undo initial true .
     6398   define buffer bf_goods    for ub.goods.
     6399   define buffer bf_doc-line for ub.doc-line.
     6400   for each bf_doc-line no-lock where bf_doc-line.doc-code = p-doc-code :
     6401      find first bf_goods where bf_goods.artic     = bf_doc-line.artic
     6402                            and bf_goods.prod-type = bf_doc-line.prod-type
     6403                            and bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     6404      run ver-gds-grp-nabor (input bf_goods.gds-code , output v-nabor ) .
     6405      if v-nabor = true then do:
     6406      v-exit = false .
     6407      leave.
     6408      end.
     6409   end.
     6410     end.
     6411   end procedure.
     6412   procedure lib-trn3_grp-nabor :
     6413     do
     6414     on error undo, return error return-value
     6415     :
     6416     define input  parameter  p-gds-code as integer   no-undo .
     6417     define output parameter  p-nabor as logical   no-undo .
     6418       run ver-gds-grp-nabor (input p-gds-code , output p-nabor )  .
     6419     end.
     6420   end procedure.
     6421   procedure lib-trn3_delnabor :
     6422     do
     6423     on error undo, return error return-value
     6424     :
     6425      define input parameter parmain-menu-handle as   handle                no-undo.
     6426      define input parameter p-doc-code as character no-undo .
     6427      define buffer buf_trn-doc  for ub.trn-doc.
     6428      define buffer buf_doc-line for ub.doc-line.
     6429      define buffer buf_gds-dtl  for ub.gds-dtl.
     6430      define buffer buf_goods    for ub.goods.
     6431      define buffer buf_doc-line-attr for ub.doc-line-attr.
     6432      define buffer new_doc-line-attr for ub.doc-line-attr.
     6433      define variable unrv-qnty as decimal   no-undo .
     6434      define variable v-nabor as logical   no-undo .
     6435      find first buf_trn-doc no-lock where  buf_trn-doc.doc-code = p-doc-code no-error .
     6436      if  buf_trn-doc.is-flora = false then return .
     6437       for each buf_doc-line exclusive-lock where
     6438               buf_doc-line.doc-code = p-doc-code :
     6439       find first  buf_goods no-lock where
     6440                     buf_goods.artic     = buf_doc-line.artic AND
     6441                     buf_goods.prod-type = buf_doc-line.prod-type AND
     6442                     buf_goods.prod-code = buf_doc-line.prod-code no-error .
     6443                     if error-status :error
     6444                     then do:
     6445                       undo, return error.
     6446                     end.
     6447         run ver-gds-grp-nabor (input buf_goods.gds-code , output v-nabor )  .
     6448           if v-nabor = true then do:
     6449               find first buf_gds-dtl no-lock    where
     6450                     buf_gds-dtl.doc-code  = buf_doc-line.doc-code and
     6451                     buf_gds-dtl.artic     = buf_doc-line.artic and
     6452                     buf_gds-dtl.prod-type = buf_doc-line.prod-type and
     6453                     buf_gds-dtl.prod-code = buf_doc-line.prod-code  .
     6454               unrv-qnty = - buf_gds-dtl.fact-qnty .
     6455               run trg/rsrv-dtl.p
     6456                 (input        parmain-menu-handle
     6457                 ,input        'reserv':U
     6458                           + ",":U + 'no-msg-create':U
     6459                           + ",":U + 'negative-check':U + '=':U + '1':U
     6460                 ,buffer       buf_gds-dtl
     6461                 ,input-output unrv-qnty
     6462                 ,input-output buf_doc-line.price-base
     6463                 ,input-output buf_doc-line.price-rubl
     6464                 ,input        -1
     6465                 ,input ""
     6466                 ) no-error.
     6467               if error-status :error
     6468               then do:
     6469                 undo, return error return-value .
     6470               end.
     6471               delete buf_doc-line  .
     6472               for each buf_doc-line-attr no-lock where
     6473                        buf_doc-line-attr.doc-code = buf_trn-doc.out-code and
     6474                        buf_doc-line-attr.gds-code = buf_goods.gds-code and
     6475                        buf_doc-line-attr.attr-code = 'flora_ps':U :
     6476                         create    new_doc-line-attr.
     6477                         BUFFER-COPY buf_doc-line-attr TO new_doc-line-attr
     6478                         assign
     6479                           new_doc-line-attr.doc-code = p-doc-code
     6480                         .
     6481               end.
     6482           end.
     6483       end.
     6484     end.
     6485   end procedure.
     6486   procedure lib-trn3_flornakl :
     6487     do
     6488     on error undo, return error return-value
     6489     :
     6490       define input  parameter p-doc-code as character no-undo .
     6491       define output parameter v-fl as logical   no-undo .
     6492       define buffer buf_trn-doc for ub.trn-doc.
     6493       v-fl = false .
     6494       find first buf_trn-doc  no-lock where buf_trn-doc.doc-code =  p-doc-code no-error .
     6495       if error-status :error then return error  .
     6496       v-fl =  buf_trn-doc.is-flora.
     6497       if v-fl = ? then v-fl = false .
     6498     end.
     6499   end procedure.
     6500   procedure lib-trn3_ckcntspc :
     6501   define input parameter parhost-code     like ub.contract.host-code     no-undo.
     6502   define input parameter parcontract-code like ub.contract.contract-code no-undo.
     6503   define input parameter pargds-code      like ub.goods.gds-code         no-undo.
     6504   define input parameter parprice-check   like ub.doc-line.price-rubl    no-undo.
     6505   define input parameter parvat-type      like ub.parts.vat-type    no-undo.
     6506   define input parameter parvat-pc        like ub.parts.vat-pc      no-undo.
     6507   define variable v-doc-code like ub.trn-doc.doc-code no-undo.
     6508   define variable v-has-old-vat as logical no-undo .
     6509   define buffer bf_trn-doc              for ub.trn-doc.
     6510   define buffer bf_goods             for ub.goods.
     6511   define buffer bf_contract          for ub.contract.
     6512   define buffer bf_contract-specif   for ub.contract-specif.
     6513   define buffer bf_contract-specif-attr for ub.contract-specif-attr.
     6514   define buffer bf-f_contract-specif for ub.contract-specif.
     6515   do on error undo, return error return-value :
     6516     if num-entries(parvat-type) > 1 then do:
     6517         v-doc-code = entry(2, parvat-type).
     6518         parvat-type = entry(1, parvat-type).
     6519         find first bf_trn-doc where bf_trn-doc.doc-code = v-doc-code no-lock.
     6520     end.
     6521     find first bf_contract where bf_contract.host-code     = parhost-code     and
     6522                                  bf_contract.contract-code = parcontract-code no-lock no-error.
     6523     if not available bf_contract then do:
     6524       return error substitute ("Не найден контракт по фирме &1 с номером &2.", parhost-code, parcontract-code).
     6525     end.
     6526     find first bf_goods no-lock where bf_goods.gds-code = pargds-code no-error .
     6527     if not available bf_goods then do:
     6528       return error substitute ("Не найден товар с внутренним кодом &1.", pargds-code).
     6529     end.
     6530   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6531   ASSIGN
     6532      i-gl-Host-Code      = 0
     6533      i-gl-Contract-Code  = 0
     6534      i-gl-Extent3        = 0
     6535      .
     6536   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     6537       INPUT  bf_contract.host-code,
     6538       INPUT  bf_contract.contract-code,
     6539       OUTPUT i-gl-Extent3
     6540      ).
     6541   IF i-gl-Extent3[1] = 2 THEN DO:
     6542      ASSIGN
     6543         i-gl-Host-Code      = i-gl-Extent3[2]
     6544         i-gl-Contract-Code  = i-gl-Extent3[3]
     6545         .
     6546   END. ELSE DO:
     6547      ASSIGN
     6548         i-gl-Host-Code      = bf_contract.host-code
     6549         i-gl-Contract-Code  = bf_contract.contract-code
     6550         .
     6551   END.
     6552       FIND FIRST bf-f_contract-specif
     6553              NO-LOCK
     6554              WHERE
     6555                  bf-f_contract-specif.Host-code    = i-gl-Host-Code
     6556              AND bf-f_contract-specif.Contract-num = i-gl-Contract-Code
     6557              NO-ERROR
     6558              .
     6559     if available bf-f_contract-specif then do:
     6560   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6561   ASSIGN
     6562      i-gl-Host-Code      = 0
     6563      i-gl-Contract-Code  = 0
     6564      i-gl-Extent3        = 0
     6565      .
     6566   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     6567       INPUT  bf_contract.host-code,
     6568       INPUT  bf_contract.contract-code,
     6569       OUTPUT i-gl-Extent3
     6570      ).
     6571   IF i-gl-Extent3[1] = 2 THEN DO:
     6572      ASSIGN
     6573         i-gl-Host-Code      = i-gl-Extent3[2]
     6574         i-gl-Contract-Code  = i-gl-Extent3[3]
     6575         .
     6576   END. ELSE DO:
     6577      ASSIGN
     6578         i-gl-Host-Code      = bf_contract.host-code
     6579         i-gl-Contract-Code  = bf_contract.contract-code
     6580         .
     6581   END.
     6582       FIND FIRST bf_contract-specif
     6583              NO-LOCK
     6584              WHERE
     6585                  bf_contract-specif.Host-code    = i-gl-Host-Code
     6586              AND bf_contract-specif.Contract-num = i-gl-Contract-Code
     6587              AND bf_contract-specif.Gds-code     = bf_goods.gds-code
     6588              NO-ERROR
     6589              .
     6590       if not available bf_contract-specif then do:
     6591         if avail bf_trn-doc and bf_trn-doc.is-flora then
     6592           return.
     6593         else
     6594         return error substitute ("В спецификации к договору &1 по фирме &2 в спецификации нет товара &3 &4 &5 &6.",
     6595                                  bf_contract.contract-prn-code,
     6596                                  bf_contract.host-code,
     6597                                  bf_goods.artic,
     6598                                  bf_goods.prod-type,
     6599                                  bf_goods.prod-code,
     6600                                  bf_goods.gds-name).
     6601       end.
     6602       define variable v-unitstore as class ibs.th.gbl.storage.unitmercstr no-undo .
     6603       define variable v-unitsubs  as class ibs.th.str.mercury.unitsubs no-undo .
     6604       define variable v-unitsub   as class ibs.th.str.mercury.unitsub no-undo .
     6605       define variable v-i-counter as integer no-undo .
     6606       define variable v-i-num     as integer no-undo .
     6607       define variable v-stub      as integer no-undo .
     6608       define variable v-unit-k    as decimal no-undo .
     6609       define variable v-contr-price-cli as decimal no-undo .
     6610       if bf_goods.unit-base = bf_contract-specif.unit-cli then do :
     6611           v-contr-price-cli  = bf_contract-specif.price-cli .
     6612       end .
     6613       else do :
     6614           v-unit-k = 1.
     6615           v-unitstore = new ibs.th.gbl.storage.unitmercstr () .
     6616           v-unitsubs = v-unitstore:getunitmercs(bf_goods.gds-code) .
     6617           v-i-counter = v-unitsubs:iCounter .
     6618           do v-i-num = 1 to v-i-counter :
     6619             v-stub = v-unitsubs:Get(v-i-num) . // возвращает кол-во элементов и переключает currItem
     6620             v-unitsub = cast(v-unitsubs:SubjectObjCurr, ibs.th.str.mercury.unitsub) .
     6621             if v-unitsub:UnitName = bf_contract-specif.unit-cli then do :
     6622               v-unit-k = v-unitsub:UnitCoef .
     6623               leave .
     6624             end .
     6625           end .
     6626           v-contr-price-cli = bf_contract-specif.price-cli / v-unit-k .
     6627           if valid-object (v-unitsubs) then delete object v-unitsubs .
     6628           if valid-object (v-unitstore) then delete object v-unitstore .
     6629       end .
     6630       if bf_contract-specif.prc > 0 then do :
     6631         if v-contr-price-cli * (1 + 1 / 100 * bf_contract-specif.prc) < parprice-check THEN DO:
     6632         return error substitute ("В спецификации к договору &1 по фирме &2 по товару &3 &4 &5 указана цена &6 за 1 единицу товара в базовых единицах измерения товара и отклонение в большую сторону &7%. Максимально допустимая цена = &8. В документе указана цена &9.",
     6633                                  bf_contract.contract-prn-code,
     6634                                  bf_contract.host-code,
     6635                                  bf_goods.artic,
     6636                                  bf_goods.prod-type,
     6637                                  bf_goods.prod-code,
     6638                                  v-contr-price-cli,
     6639                                  bf_contract-specif.prc,
     6640                                  v-contr-price-cli * (1 + 1 / 100 * bf_contract-specif.prc),
     6641                                  parprice-check).
     6642         END.
     6643       end .
     6644         for first bf_contract-specif-attr no-lock
     6645            where bf_contract-specif-attr.contract-num = bf_contract-specif.contract-num
     6646              and bf_contract-specif-attr.gds-code     = bf_contract-specif.gds-code
     6647              and bf_contract-specif-attr.host-code    = bf_contract-specif.host-code
     6648              and bf_contract-specif-attr.attr-code    = 'prc-min':U
     6649              and bf_contract-specif-attr.attr-value <> ?
     6650               and decimal(bf_contract-specif-attr.attr-value) > 0 :
     6651          if v-contr-price-cli * (1 - 1 / 100 * decimal(bf_contract-specif-attr.attr-value)) > parprice-check
     6652          then do :
     6653           return error substitute ("В спецификации к договору &1 по фирме &2 по товару &3 &4 &5 указана цена &6 и отклонение &7%. Минимально допустимая цена = &8. В документе указана цена &9.",
     6654                                  bf_contract.contract-prn-code,
     6655                                  bf_contract.host-code,
     6656                                  bf_goods.artic,
     6657                                  bf_goods.prod-type,
     6658                                  bf_goods.prod-code,
     6659                                  v-contr-price-cli,
     6660                                  decimal(bf_contract-specif-attr.attr-value),
     6661                                  v-contr-price-cli * (1 - 1 / 100 * decimal(bf_contract-specif-attr.attr-value)),
     6662                                  parprice-check).
     6663         end.
     6664       END.
     6665       if bf_contract-specif.VAT-type <> ?  and bf_contract-specif.VAT-type <> "" then do:
     6666          if bf_contract-specif.VAT-type <> parvat-type then do:
     6667           return error substitute ("В спецификации к договору &1 по фирме &2 в спецификации по товару &3 &4 &5 указан тип НДС &6. Вы указали в накладной тип НДС &7 .",
     6668                                   bf_contract.contract-prn-code,
     6669                                   bf_contract.host-code,
     6670                                   bf_goods.artic,
     6671                                   bf_goods.prod-type,
     6672                                   bf_goods.prod-code,
     6673                                   bf_contract-specif.vat-type,
     6674                                   parvat-type).
     6675          end.
     6676       end.
     6677       if bf_contract-specif.VAT-pc <> ?  then do:
     6678          if bf_contract-specif.VAT-pc <> round ( parvat-pc, 1 ) then do:
     6679            run lib-trn3_vatPrevValue in this-procedure (parvat-pc, bf_contract-specif.VAT-pc, output v-has-old-vat) .
     6680            if not v-has-old-vat then
     6681            return error substitute ("В спецификации к договору &1 по фирме &2 в спецификации по товару &3 &4 &5 указан НДС &6 %. Вы указали в накладной НДС &7 %.",
     6682                                   bf_contract.contract-prn-code,
     6683                                   bf_contract.host-code,
     6684                                   bf_goods.artic,
     6685                                   bf_goods.prod-type,
     6686                                   bf_goods.prod-code,
     6687                                   bf_contract-specif.vat-pc,
     6688                                   parvat-pc).
     6689          end.
     6690       end.
     6691     end.
     6692   end.
     6693   end procedure.
     6694   procedure lib-trn3_vatPrevValue private :
     6695   define input  parameter p-vat-pc1    as decimal no-undo .
     6696   define input  parameter p-vat-pc2    as decimal no-undo .
     6697   define output parameter p-is-present as logical initial false no-undo .
     6698   define buffer buf_tax-rate-value for ub.tax-rate-value .
     6699     find first buf_tax-rate-value no-lock
     6700          where buf_tax-rate-value.tax-code   = 1
     6701            and buf_tax-rate-value.rate-value = p-vat-pc1 no-error .
     6702     if available buf_tax-rate-value then do :
     6703       p-is-present = can-find (first tax-rate-value
     6704                                where tax-rate-value.tax-code   = buf_tax-rate-value.tax-code
     6705                                  and tax-rate-value.rate-code  = buf_tax-rate-value.rate-code
     6706                                  and tax-rate-value.rate-value = p-vat-pc2) .
     6707     end .
     6708     else p-is-present = false .
     6709   end procedure .
     6710   procedure lib-trn3_st-sltyn :
     6711   do
     6712   on error undo, return error
     6713   :
     6714   define input  parameter p-trn-doc-recid     as recid   no-undo.
     6715   define input  parameter p-cash-pay          as integer no-undo.
     6716   define output parameter p-st-sltpc-have-slt as logical no-undo.
     6717   define variable varslt-yes as logical no-undo.
     6718   define buffer buf_st-sltpc_trn-doc for ub.trn-doc.
     6719   find first buf_st-sltpc_trn-doc where recid(buf_st-sltpc_trn-doc)   = p-trn-doc-recid.
     6720   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_chpsltpc in g#lib-trn
     6721   (
     6722    input  buf_st-sltpc_trn-doc.internal
     6723   ,input  buf_st-sltpc_trn-doc.doc-type
     6724   ,input  buf_st-sltpc_trn-doc.pay-code
     6725   ,input  p-cash-pay
     6726   ,input  buf_st-sltpc_trn-doc.slt-type
     6727   ,input  buf_st-sltpc_trn-doc.ext-doc-type
     6728   ,output varslt-yes
     6729   )
     6730   no-error.
     6731   if error-status:error then do:
     6732     message
     6733       vss-workfile vss-revision vss-description skip
     6734       "Ошибка при проверке установки налога с продаж " skip
     6735       " в документе " buf_st-sltpc_trn-doc.doc-code skip
     6736       return-value skip
     6737       trim(error-status :get-message(1))
     6738       trim(error-status :get-message(2))
     6739       trim(error-status :get-message(3))
     6740       trim(error-status :get-message(4))
     6741       trim(error-status :get-message(5)) skip
     6742       view-as alert-box error.
     6743     undo, return error .
     6744   end.
     6745   assign
     6746       p-st-sltpc-have-slt = varslt-yes.
     6747   end.
     6748   end procedure.
     6749   procedure lib-trn3_reclcdsc:
     6750   define input parameter parrec-line as recid no-undo.
     6751   define buffer rd_doc-line for ub.doc-line.
     6752   define buffer rd_trn-doc  for ub.trn-doc.
     6753   define buffer rd_sysconf  for ub.sysconf.
     6754   define buffer rd_gds-dtl  for ub.gds-dtl.
     6755   define buffer rd_doc-attr for ub.doc-attr.
     6756   do on error undo, return error :
     6757   define variable v-sum-deliv as decimal   no-undo initial 0 .
     6758   define variable v-sum-delive-rubl  as decimal   no-undo initial 0 .
     6759   define variable v-sum-delive-base  as decimal   no-undo initial 0 .
     6760   find first rd_doc-line where recid(rd_doc-line) = parrec-line.
     6761   find first rd_trn-doc where rd_trn-doc.doc-code = rd_doc-line.doc-code.
     6762   find first rd_doc-attr no-lock where rd_doc-attr.doc-code  = rd_trn-doc.doc-code     and
     6763                                        rd_doc-attr.attr-code = 'discnt-other':U and
     6764                                        rd_doc-attr.attr-value = "yes" no-error .
     6765   if available  rd_doc-attr then do:
     6766      return .
     6767   end.
     6768   FIND rd_sysconf WHERE rd_sysconf.host-code = rd_trn-doc.host-code NO-LOCK.
     6769   for each rd_gds-dtl where rd_gds-dtl.doc-code  = rd_trn-doc.doc-code
     6770                         and rd_gds-dtl.prod-code = rd_doc-line.prod-code
     6771                         and rd_gds-dtl.prod-type = rd_doc-line.prod-type
     6772                         and rd_gds-dtl.artic     = rd_doc-line.artic :
     6773       if can-do ('процент,сумма,карта,группа':U, rd_trn-doc.discnt-type) then do:
     6774         if rd_trn-doc.discnt-type = 'сумма':U then do:
     6775            assign
     6776            rd_gds-dtl.discnt-pc   = rd_trn-doc.discnt-pc.
     6777            if rd_trn-doc.print-rubl then do:
     6778              assign
     6779              rd_gds-dtl.discnt-base = rd_gds-dtl.price-base * rd_trn-doc.discnt-rubl / rd_trn-doc.tot-rubl
     6780              rd_gds-dtl.discnt-rubl = rd_gds-dtl.price-rubl * rd_trn-doc.discnt-rubl   / rd_trn-doc.tot-rubl.
     6781            end.
     6782            else do:
     6783              assign
     6784              rd_gds-dtl.discnt-base = rd_gds-dtl.price-base * rd_trn-doc.tot-calc / rd_trn-doc.tot-doc
     6785              rd_gds-dtl.discnt-rubl = rd_gds-dtl.price-rubl * rd_trn-doc.tot-calc / rd_trn-doc.tot-doc.
     6786            end.
     6787         end.
     6788         else do:
     6789           assign
     6790           rd_gds-dtl.discnt-pc   = rd_trn-doc.discnt-pc
     6791           rd_gds-dtl.discnt-base = rd_gds-dtl.price-base  * rd_gds-dtl.discnt-pc / 100
     6792           rd_gds-dtl.discnt-rubl = rd_gds-dtl.price-rubl  * rd_gds-dtl.discnt-pc / 100.
     6793         end.
     6794       end.
     6795       if can-do ('строка':U, rd_trn-doc.discnt-type) then do:
     6796         if rd_gds-dtl.discnt-type then do:
     6797           assign
     6798             rd_gds-dtl.discnt-base = rd_gds-dtl.price-base * rd_gds-dtl.discnt-pc / 100
     6799             rd_gds-dtl.discnt-rubl = rd_gds-dtl.price-rubl * rd_gds-dtl.discnt-pc / 100.
     6800         end.
     6801         else do:
     6802           if rd_trn-doc.print-rubl then do:
     6803             assign
     6804               rd_gds-dtl.discnt-pc   = (if rd_gds-dtl.price-rubl = 0
     6805                                         then 0
     6806                                         else rd_gds-dtl.discnt-rubl * 100 / rd_gds-dtl.price-rubl)
     6807               rd_gds-dtl.discnt-base = rd_gds-dtl.discnt-rubl / rd_trn-doc.base-rate * rd_trn-doc.base-scale.
     6808           end.
     6809           else do:
     6810             assign
     6811               rd_gds-dtl.discnt-pc   = (if rd_gds-dtl.price-base = 0
     6812                                         then 0
     6813                                         else rd_gds-dtl.discnt-base * 100 / rd_gds-dtl.price-base)
     6814               rd_gds-dtl.discnt-rubl = rd_gds-dtl.discnt-base * rd_trn-doc.base-rate / rd_trn-doc.base-scale.
     6815           end.
     6816         end.
     6817       end.
     6818   end.
     6819   end.
     6820   end procedure.
     6821   procedure lib-trn3_corinvln :
     6822     define input  parameter p-doc-code  like ub.inv-line.doc-code   no-undo.
     6823     define input  parameter p-artic     like ub.inv-line.artic      no-undo.
     6824     define input  parameter p-prod-type like ub.inv-line.prod-type  no-undo.
     6825     define input  parameter p-prod-code like ub.inv-line.prod-code  no-undo.
     6826     define input  parameter p-sale-rubl like ub.gds-dtl.price-rubl  no-undo.
     6827     define input  parameter p-sale-base like ub.gds-dtl.price-base  no-undo.
     6828     define input  parameter p-acc-rubl  like ub.doc-line.price-rubl no-undo.
     6829     define input  parameter p-acc-base  like ub.doc-line.price-base no-undo.
     6830     define input  parameter p-fact-qnty like ub.gds-dtl.fact-qnty   no-undo.
     6831     define input  parameter p-density   like ub.doc-line.fact-density    no-undo.
     6832     define output parameter rec-inv-lin as   recid                  no-undo.
     6833     define variable is-petrol   as logical   no-undo.
     6834     define variable is-pieces   as logical   no-undo.
     6835     define variable last-invlin as recid     no-undo initial ?.
     6836     define variable v-price-rubl like ub.gds-dtl.price-rubl no-undo initial 0.0.
     6837     define variable v-price-base like ub.gds-dtl.price-base no-undo initial 0.0.
     6838     define variable v-qnty       like ub.gds-dtl.fact-qnty  no-undo initial 0.0.
     6839     define variable v-after-qnty like ub.gds-dtl.fact-qnty  no-undo initial 0.0.
     6840     define variable v-new-qnty   like ub.gds-dtl.fact-qnty  no-undo initial 0.0.
     6841     define variable v-tmp-qnty   like ub.gds-dtl.fact-qnty  no-undo initial 0.0.
     6842     define buffer buf_trn-doc  for ub.trn-doc.
     6843     define buffer buf_inv-line for ub.inv-line.
     6844     define buffer buf_doc-line for ub.doc-line.
     6845     define buffer buf_gds-dtl  for ub.gds-dtl.
     6846     define buffer buf_goods    for ub.goods.
     6847     define buffer bf_rvs-doc   for ub.rvs-doc.
     6848     define buffer bf_pl-gds    for ub.pl-gds.
     6849     do
     6850     on error undo, return error "lib-trn3_corinvln: ошибка изменения записи inv-line"
     6851     :
     6852   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     6853     (
     6854        input p-artic
     6855     ,  input p-prod-type
     6856     ,  input p-prod-code
     6857     , output is-petrol
     6858     , output is-pieces
     6859     ) no-error.
     6860       if error-status :error then do:
     6861         return error return-value.
     6862       end.
     6863       if is-petrol = yes
     6864         and is-pieces = no
     6865       then do:
     6866         find first buf_trn-doc exclusive-lock
     6867           where buf_trn-doc.doc-code = p-doc-code
     6868           no-error.
     6869         if not available buf_trn-doc then do:
     6870           undo, return error substitute( 'lib-trn3_corinvln: не найдена накладная "&1"', p-doc-code ).
     6871         end.
     6872         find first buf_goods no-lock
     6873           where buf_goods.artic     = p-artic
     6874             and buf_goods.prod-type = p-prod-type
     6875             and buf_goods.prod-code = p-prod-code
     6876           no-error.
     6877         if not available buf_goods then do:
     6878           undo, return error substitute( 'lib-trn3_corinvln: не найден товар: Артикул "&1" (производитель: &2 &3)', p-artic, p-prod-type, p-prod-code ).
     6879         end.
     6880         find first buf_inv-line exclusive-lock
     6881           where buf_inv-line.doc-code  = p-doc-code
     6882             and buf_inv-line.artic     = p-artic
     6883             and buf_inv-line.prod-type = p-prod-type
     6884             and buf_inv-line.prod-code = p-prod-code
     6885           no-error.
     6886         if available buf_inv-line then do:
     6887           assign
     6888             rec-inv-lin = recid( buf_inv-line )
     6889           .
     6890         end.
     6891         else do:
     6892           run check-use-artic in this-procedure
     6893             ( input "inv-line":U
     6894              ,input p-artic
     6895              ,input p-prod-type
     6896              ,input p-prod-code
     6897             ) no-error.
     6898           if error-status :error then do:
     6899             undo, return error substitute( 'lib-trn3_corinvln: &1', return-value ).
     6900           end.
     6901           create buf_inv-line.
     6902           assign
     6903             buf_inv-line.doc-code  = p-doc-code
     6904             buf_inv-line.artic     = p-artic
     6905             buf_inv-line.prod-type = p-prod-type
     6906             buf_inv-line.prod-code = p-prod-code
     6907             rec-inv-lin            = recid( buf_inv-line )
     6908           .
     6909         end.
     6910         find first buf_doc-line exclusive-lock
     6911           where buf_doc-line.doc-code  = p-doc-code
     6912             and buf_doc-line.artic     = p-artic
     6913             and buf_doc-line.prod-type = p-prod-type
     6914             and buf_doc-line.prod-code = p-prod-code
     6915           no-error.
     6916         if not available buf_doc-line then do:
     6917           undo, return error substitute( 'lib-trn3_corinvln: не найдена строка накладной "&1" с товаром: Артикул "&2" (производитель: &3 &4)'
     6918                                         ,p-doc-code
     6919                                         ,p-artic
     6920                                         ,p-prod-type
     6921                                         ,p-prod-code
     6922                                        ).
     6923         end.
     6924         if
     6925     valid-density( p-density, buf_goods.unit-base = buf_goods.unit-cli )
     6926     = true then do:
     6927           if not ( buf_trn-doc.ext-doc-type = 'ie':U
     6928                   and ( ( buf_trn-doc.status_ = 'накл':U
     6929                           and buf_trn-doc.flag_ = true
     6930                         )
     6931                         or buf_trn-doc.status_ = 'факт':U
     6932                       )
     6933                 )
     6934           then do:
     6935             if p-acc-rubl = ? or p-acc-rubl = 0.0 then do:
     6936               assign
     6937                 p-acc-rubl = buf_doc-line.price-rubl / p-density
     6938               .
     6939             end.
     6940             if p-acc-base = ? or p-acc-base = 0.0 then do:
     6941               assign
     6942                 p-acc-base = buf_doc-line.price-base / p-density
     6943               .
     6944             end.
     6945           end.
     6946           if ( ( p-sale-rubl = ?
     6947                  or p-sale-rubl = 0.0
     6948                  or p-sale-base = ?
     6949                  or p-sale-base = 0.0
     6950                )
     6951                and not ( buf_trn-doc.ext-doc-type = 'ie':U
     6952                          and ( ( buf_trn-doc.status_      = 'накл':U
     6953                                  and buf_trn-doc.flag_        = true
     6954                                )
     6955                                or buf_trn-doc.status_      = 'факт':U
     6956                              )
     6957                        )
     6958              )
     6959              or ( p-fact-qnty = ?
     6960                   or p-fact-qnty = 0.0
     6961                 )
     6962                 and not ( buf_trn-doc.ext-doc-type = 'ie':U
     6963                           and buf_trn-doc.status_      = 'факт':U
     6964                         )
     6965           then do:
     6966             find first buf_gds-dtl exclusive-lock
     6967               where buf_gds-dtl.doc-code  = p-doc-code
     6968                 and buf_gds-dtl.artic     = p-artic
     6969                 and buf_gds-dtl.prod-code = p-prod-code
     6970                 and buf_gds-dtl.prod-type = p-prod-type
     6971               no-error
     6972             .
     6973             if available buf_gds-dtl then do:
     6974               assign
     6975                 v-price-rubl = ( if buf_gds-dtl.price-rubl = ? then 0.0 else buf_gds-dtl.price-rubl )
     6976                 v-price-base = ( if buf_gds-dtl.price-base = ? then 0.0 else buf_gds-dtl.price-base )
     6977               .
     6978             end.
     6979             if v-price-rubl = ? then do:
     6980               assign
     6981                 v-price-rubl = 0.0
     6982               .
     6983             end.
     6984             if v-price-base = ? then do:
     6985               assign
     6986                 v-price-base = 0.0
     6987               .
     6988             end.
     6989             if not ( buf_trn-doc.ext-doc-type = 'ie':U
     6990                      and buf_trn-doc.status_      = 'накл':U
     6991                      and buf_trn-doc.flag_        = yes
     6992                    )
     6993             then do:
     6994               if p-sale-rubl = ? or p-sale-rubl = 0.0 then do:
     6995                 assign
     6996                   p-sale-rubl = v-price-rubl / p-density
     6997                 .
     6998               end.
     6999               if p-sale-base = ? or p-sale-base = 0.0 then do:
     7000                 assign
     7001                   p-sale-base = v-price-base / p-density
     7002                 .
     7003               end.
     7004             end.
     7005             if p-fact-qnty = ?
     7006               or p-fact-qnty = 0.0
     7007             then do:
     7008               if buf_trn-doc.doc-type = 'инв':U then do:
     7009                 assign
     7010                   v-qnty = buf_doc-line.doc-qnty
     7011                 .
     7012               end.
     7013               else do:
     7014                 if available buf_gds-dtl then do:
     7015                   assign
     7016                     v-qnty = ( if buf_gds-dtl.fact-qnty = ?  then 0.0 else buf_gds-dtl.fact-qnty )
     7017                   .
     7018                 end.
     7019                 else do:
     7020                   assign
     7021                     v-qnty = buf_doc-line.fact-qnty
     7022                   .
     7023                 end.
     7024               end.
     7025               assign
     7026                 p-fact-qnty = v-qnty * p-density
     7027               .
     7028             end.
     7029           end.
     7030         end.
     7031         if not ( buf_trn-doc.ext-doc-type = 'ie':U
     7032                  and ( ( buf_trn-doc.status_      = 'накл':U
     7033                          and buf_trn-doc.flag_        = yes
     7034                        )
     7035                        or buf_trn-doc.status_      = 'факт':U
     7036                      )
     7037                )
     7038         then do:
     7039           if p-sale-rubl = ? then do:
     7040             assign
     7041               p-sale-rubl = 0.0
     7042             .
     7043           end.
     7044           if p-sale-base = ? then do:
     7045             assign
     7046               p-sale-base = 0.0
     7047             .
     7048           end.
     7049           if p-acc-rubl  = ? then do:
     7050             assign
     7051               p-acc-rubl  = 0.0
     7052             .
     7053           end.
     7054           if p-acc-base  = ? then do:
     7055             assign
     7056               p-acc-base  = 0.0
     7057             .
     7058           end.
     7059           assign
     7060             buf_inv-line.wast-rubl      = p-sale-rubl
     7061             buf_inv-line.wast-base      = p-sale-base
     7062             buf_inv-line.unus-wast-rubl = p-acc-rubl
     7063             buf_inv-line.unus-wast-base = p-acc-base
     7064           .
     7065         end.
     7066         if buf_trn-doc.ext-doc-type = 'ie':U
     7067           and buf_trn-doc.status_ = 'факт':U
     7068         then do:
     7069           assign
     7070             p-fact-qnty = buf_inv-line.wast-cli-qnty
     7071           .
     7072         end.
     7073         if p-fact-qnty = ? then do:
     7074           assign
     7075             p-fact-qnty = 0.0
     7076           .
     7077         end.
     7078         if absolute( buf_inv-line.wast-cli-qnty - p-fact-qnty ) > 0
     7079           and ( buf_doc-line.status_ <> 'факт':U
     7080                 or buf_trn-doc.ext-doc-type = 'es':U
     7081                 or buf_trn-doc.ext-doc-type = 'rs':U
     7082               )
     7083         then do:
     7084           assign
     7085             buf_inv-line.wast-cli-qnty = p-fact-qnty
     7086           .
     7087         end.
     7088         if buf_trn-doc.status_ = 'факт':U then do:
     7089           if buf_trn-doc.doc-type = 'инв':U then do:
     7090             assign
     7091               buf_inv-line.after-cli-qnty = buf_inv-line.wast-cli-qnty
     7092             .
     7093           end.
     7094           else do:
     7095   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_lastinvl in g#lib-trn3
     7096   (
     7097      input buf_inv-line.doc-code
     7098   ,  input buf_inv-line.artic
     7099   ,  input buf_inv-line.prod-type
     7100   ,  input buf_inv-line.prod-code
     7101   , output v-after-qnty
     7102   , output last-invlin
     7103   )  .
     7104             if v-after-qnty = ? then do:
     7105               assign
     7106                 v-after-qnty = 0.0
     7107               .
     7108               find first buf_goods no-lock
     7109               where buf_goods.artic     = buf_inv-line.artic
     7110                 and buf_goods.prod-type = buf_inv-line.prod-type
     7111                 and buf_goods.prod-code = buf_inv-line.prod-code
     7112                 no-error.
     7113               for each bf_pl-gds no-lock
     7114               where bf_pl-gds.gds-code  = buf_goods.gds-code
     7115                 and bf_pl-gds.obj-type  = buf_inv-line.obj-type
     7116                 and bf_pl-gds.obj-code  = buf_inv-line.obj-code
     7117               use-index gds-code
     7118                 :
     7119                 assign v-after-qnty = v-after-qnty + bf_pl-gds.cli-fact-qnty.
     7120               end.
     7121             end.
     7122             assign
     7123               buf_inv-line.before-cli-qnty = v-after-qnty
     7124               v-new-qnty                   = buf_inv-line.wast-cli-qnty
     7125             .
     7126             run lib-trn3_correct-quantity in this-procedure ( input buf_trn-doc.doc-type, input-output v-new-qnty ).
     7127             assign
     7128               buf_inv-line.after-cli-qnty = buf_inv-line.before-cli-qnty + ( if v-new-qnty = ? then 0.0 else v-new-qnty   )
     7129             .
     7130           end.
     7131           if buf_inv-line.after-cli-qnty = ? then do:
     7132             assign
     7133               buf_inv-line.after-cli-qnty = 0.0
     7134             .
     7135           end.
     7136         end.
     7137       end.
     7138     end.
     7139   end procedure.
     7140   procedure lib-trn3_lastinvl :
     7141     define  input parameter p-doc-code   like ub.inv-line.doc-code       no-undo.
     7142     define  input parameter p-artic      like ub.inv-line.artic          no-undo.
     7143     define  input parameter p-prod-type  like ub.inv-line.prod-type      no-undo.
     7144     define  input parameter p-prod-code  like ub.inv-line.prod-code      no-undo.
     7145     define output parameter p-after-qnty like ub.inv-line.after-cli-qnty no-undo.
     7146     define output parameter p-invlin-rec as   recid                      no-undo initial ?.
     7147     define variable is-petrol    as logical   no-undo.
     7148     define variable is-pieces    as logical   no-undo.
     7149     define variable Fact-Order-0 as decimal   no-undo initial 0.
     7150     define variable v-shift-fo   as decimal   no-undo initial 0.
     7151     define variable v-day-fo     as decimal   no-undo initial 0.
     7152     define variable v-fact-date  as date      no-undo initial ?.
     7153     define variable v-fact-time  as integer   no-undo initial 0.
     7154     define variable v-fact-num   as integer   no-undo initial 0.
     7155     define variable v-shift-date as date      no-undo initial ?.
     7156     define variable v-shift-num  as integer   no-undo initial 0.
     7157     define variable v-shift-on   as logical   no-undo initial no.
     7158     define buffer buf_trn-doc   for ub.trn-doc.
     7159     define buffer buf_doc-line  for ub.doc-line.
     7160     define buffer buf_inv-line  for ub.inv-line.
     7161     define buffer last_inv-line for ub.inv-line.
     7162     define buffer last_doc-line for ub.doc-line.
     7163     do
     7164     on error undo, return error return-value
     7165     :
     7166       find first buf_trn-doc exclusive-lock
     7167         where buf_trn-doc.doc-code = p-doc-code
     7168         no-error .
     7169       if not available buf_trn-doc then do:
     7170         undo, return error substitute( 'lib-trn3_lastinvl: не найден документ "&1"'
     7171                                       ,p-doc-code
     7172                                      ).
     7173       end.
     7174       find first buf_doc-line exclusive-lock
     7175         where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     7176           and buf_doc-line.artic     = p-artic
     7177           and buf_doc-line.prod-type = p-prod-type
     7178           and buf_doc-line.prod-code = p-prod-code
     7179         no-error.
     7180       if not available buf_doc-line then do:
     7181         undo, return error substitute( 'lib-trn3_lastinvl: не найдена строка документа "&1" с товаром: Артикул "&2" (производитель: &3 &4)'
     7182                                       ,buf_trn-doc.doc-code
     7183                                       ,p-artic
     7184                                       ,p-prod-type
     7185                                       ,p-prod-code
     7186                                      ).
     7187       end.
     7188       assign
     7189         p-invlin-rec = ?
     7190         p-after-qnty = 0.0
     7191       .
     7192   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7193     (
     7194        input buf_doc-line.artic
     7195     ,  input buf_doc-line.prod-type
     7196     ,  input buf_doc-line.prod-code
     7197     , output is-petrol
     7198     , output is-pieces
     7199     ) .
     7200       if is-petrol = true
     7201         and is-pieces = false
     7202       then do:
     7203         find first buf_inv-line exclusive-lock
     7204           where buf_inv-line.doc-code  = buf_trn-doc.doc-code
     7205             and buf_inv-line.artic     = buf_doc-line.artic
     7206             and buf_inv-line.prod-type = buf_doc-line.prod-type
     7207             and buf_inv-line.prod-code = buf_doc-line.prod-code
     7208           no-error.
     7209         if not available buf_inv-line then do:
     7210           undo, return error substitute( 'lib-trn3_lastinvl: не найдена строка итогов (кг) накладной "&1" с товаром: Артикул "&2" (производитель: &3 &4)'
     7211                                         ,buf_trn-doc.doc-code
     7212                                         ,buf_doc-line.artic
     7213                                         ,buf_doc-line.prod-type
     7214                                         ,buf_doc-line.prod-code
     7215                                        ).
     7216         end.
     7217         if buf_trn-doc.fact-order = 0
     7218           or buf_trn-doc.fact-order = ?
     7219         then do:
     7220           assign
     7221             v-fact-date  = buf_trn-doc.fact-date
     7222             v-fact-time  = buf_trn-doc.fact-time
     7223             v-fact-num   = buf_trn-doc.fact-num
     7224             v-shift-date = buf_trn-doc.shift-date
     7225             v-shift-num  = buf_trn-doc.shift-num
     7226           .
     7227   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7228   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     7229     (input  buf_trn-doc.obj-type
     7230     ,input  buf_trn-doc.obj-code
     7231     ,input  'shift-on=request'
     7232     ,output v-shift-on
     7233     ) no-error .
     7234           if error-status :error
     7235             or v-shift-on = ?
     7236           then do:
     7237             assign
     7238               v-shift-date = ?
     7239               v-shift-num  = 0
     7240               v-shift-on   = no
     7241             .
     7242           end.
     7243           if v-fact-date = ? then do:
     7244             assign
     7245               v-fact-date = today
     7246             .
     7247           end.
     7248           if v-fact-time = ?
     7249             or v-fact-time = 0
     7250           then do:
     7251             assign
     7252               v-fact-time = time
     7253             .
     7254           end.
     7255           if v-fact-num = ?
     7256             or v-fact-num = 0
     7257           then do:
     7258             assign
     7259               v-fact-num = current-value( s-trn-fact, ub )
     7260             .
     7261           end.
     7262           if v-shift-on = yes then do:
     7263             if v-shift-date = ? then do:
     7264               assign
     7265                 v-shift-date = v-fact-date
     7266               .
     7267             end.
     7268             if v-shift-num = 0
     7269               or v-shift-num = ?
     7270             then do:
     7271               assign
     7272                 v-shift-num = 24
     7273               .
     7274             end.
     7275           end.
     7276           run factord in this-procedure
     7277             ( input v-fact-date
     7278              ,input v-fact-time
     7279              ,input v-fact-num
     7280              ,input v-shift-date
     7281              ,input v-shift-num
     7282              ,input v-shift-on
     7283              ,output Fact-Order-0
     7284              ,output v-shift-fo
     7285              ,output v-day-fo
     7286             ).
     7287         end.
     7288         else do:
     7289           assign
     7290             Fact-Order-0 = buf_trn-doc.fact-order
     7291           .
     7292         end.
     7293         if Fact-Order-0 = 0
     7294           or Fact-Order-0 = ?
     7295         then do:
     7296           run factord-max-fact-order in this-procedure
     7297             ( output Fact-Order-0
     7298             ).
     7299         end.
     7300         for each last_doc-line share-lock
     7301           where last_doc-line.obj-type    = buf_trn-doc.obj-type
     7302             and last_doc-line.obj-code    = buf_trn-doc.obj-code
     7303             and last_doc-line.artic       = buf_doc-line.artic
     7304             and last_doc-line.prod-code   = buf_doc-line.prod-code
     7305             and last_doc-line.prod-type   = buf_doc-line.prod-type
     7306             and last_doc-line.status_     = 'факт':U
     7307             and last_doc-line.fact-order  > 0
     7308             and last_doc-line.fact-order  < Fact-Order-0
     7309           use-index fact-order
     7310           by last_doc-line.fact-order descending
     7311         on error undo, return error return-value
     7312         :
     7313           if recid( last_doc-line ) = recid( buf_doc-line ) then do:
     7314             next.
     7315           end.
     7316           find first last_inv-line share-lock
     7317             where last_inv-line.doc-code  = last_doc-line.doc-code
     7318               and last_inv-line.artic     = last_doc-line.artic
     7319               and last_inv-line.prod-code = last_doc-line.prod-code
     7320               and last_inv-line.prod-type = last_doc-line.prod-type
     7321             no-error.
     7322           if available last_inv-line then do:
     7323             if recid( last_inv-line ) = recid( buf_inv-line ) then do:
     7324               next.
     7325             end.
     7326             assign
     7327               p-invlin-rec = recid( last_inv-line )
     7328               p-after-qnty = last_inv-line.after-cli-qnty
     7329             .
     7330             leave.
     7331           end.
     7332         end.
     7333       end.
     7334     end.
     7335   end procedure.
     7336   procedure lib-trn3_correct-quantity :
     7337     define input        parameter p-doc-type like ub.trn-doc.doc-type  no-undo.
     7338     define input-output parameter p-quantity like ub.trn-doc.fact-qnty no-undo.
     7339     do on error undo, return error "lib-trn3_correct-quantity: неверный тип документа" :
     7340               if lookup( p-doc-type, 'при,рас,спи,возврат,инв':U ) = 0 then do:
     7341         undo, return error substitute( 'lib-trn3_correct-quantity: неверный тип документа - "&1"', p-doc-type ).
     7342       end.
     7343       if lookup( p-doc-type, 'инв,при,возврат':U ) > 0 and p-quantity < 0.0 or
     7344          lookup( p-doc-type, 'спи,рас':U ) > 0 and p-quantity > 0.0 then do:
     7345         assign
     7346           p-quantity = - p-quantity
     7347         .
     7348       end.
     7349     end.
     7350   end procedure.
     7351   define temp-table tt_trn-doc  no-undo like ub.trn-doc .
     7352   define temp-table tt_doc-line no-undo like ub.doc-line
     7353     field gds-code like ub.goods.gds-code
     7354   .
     7355   define temp-table tt_corr-place no-undo
     7356     field pl-code  like ub.doc-pl.pl-code
     7357     field gds-code like ub.doc-pl.gds-code
     7358     index pi is primary unique gds-code pl-code
     7359   .
     7360   procedure lib-trn3_reclcptr :
     7361     define input  parameter p-handle-trn-doc  as handle    no-undo .
     7362     define input  parameter p-handle-doc-line as handle    no-undo .
     7363     define input  parameter p-warp-factor     as decimal   no-undo .
     7364     define input  parameter p-ext-doc-type    as character no-undo .
     7365     define input  parameter p-chip-num-main   as integer   no-undo .
     7366     do
     7367     on error  undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7368     on stop   undo, return error substitute( "lib-trn3_reclcptr. stop" )
     7369     on endkey undo, return error substitute( "lib-trn3_reclcptr. endkey" )
     7370     :
     7371       define variable v-ok           as logical   no-undo .
     7372       define variable is-petrol      as logical   no-undo .
     7373       define variable is-pieces      as logical   no-undo .
     7374       define variable v-cre-hist     as logical   no-undo .
     7375       define variable v-doc-code     as character no-undo .
     7376       define variable v-ext-doc-type as character no-undo .
     7377       define variable v-doc-cli-qnty as decimal   no-undo .
     7378       define variable v-sign         as decimal   no-undo .
     7379       define buffer buf_goods         for ub.goods .
     7380       define buffer buf_doc-line      for ub.doc-line .
     7381       define buffer buf_inv-line      for ub.inv-line .
     7382       define buffer buf_doc-pl        for ub.doc-pl .
     7383       define buffer buf_rvs-doc       for ub.rvs-doc .
     7384       define buffer buf_rvs-line      for ub.rvs-line .
     7385       define buffer buf-next_inv-line for ub.inv-line .
     7386       define buffer buf-next_trn-doc  for ub.trn-doc .
     7387       define buffer buf-next_rvs-doc  for ub.rvs-doc .
     7388       define buffer buf-next_rvs-line for ub.rvs-line .
     7389       if valid-handle( p-handle-trn-doc )
     7390         and valid-handle( p-handle-doc-line )
     7391       then do:
     7392         undo, return error substitute( "lib-trn3_reclcptr. Ошибка задания входных параметров. Заданы указатели на документ и на строку документа одновременно." ) .
     7393       end.
     7394       if p-warp-factor <> 1.0
     7395         and p-warp-factor <> -1.0
     7396       then do:
     7397         undo, return error substitute( "lib-trn3_reclcptr. Ошибка задания входных параметров. Не задано направление пересчета итогов." ) .
     7398       end.
     7399       for each tt_trn-doc
     7400       on error undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7401       :
     7402         delete tt_trn-doc .
     7403       end.
     7404       for each tt_doc-line
     7405       on error undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7406       :
     7407         delete tt_doc-line .
     7408       end.
     7409       for each tt_corr-place
     7410       on error undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7411       :
     7412         delete tt_corr-place .
     7413       end.
     7414       if valid-handle( p-handle-trn-doc ) then do:
     7415         create tt_trn-doc.
     7416         assign
     7417           v-ok = buffer tt_trn-doc :handle :buffer-copy ( p-handle-trn-doc )
     7418         .
     7419         if tt_trn-doc.status_ <> 'факт':U then do:
     7420           delete tt_trn-doc.
     7421           return .
     7422         end.
     7423         for each buf_doc-line exclusive-lock
     7424           where buf_doc-line.doc-code = tt_trn-doc.doc-code
     7425         on error undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7426         :
     7427           find first buf_goods no-lock
     7428             where buf_goods.artic     = buf_doc-line.artic
     7429               and buf_goods.prod-type = buf_doc-line.prod-type
     7430               and buf_goods.prod-code = buf_doc-line.prod-code
     7431             .
     7432   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7433     (
     7434        input buf_goods.artic
     7435     ,  input buf_goods.prod-type
     7436     ,  input buf_goods.prod-code
     7437     , output is-petrol
     7438     , output is-pieces
     7439     ) .
     7440           if is-petrol = true
     7441             and is-pieces = false
     7442             and buf_doc-line.status_ = 'факт':U
     7443           then do:
     7444             create tt_doc-line .
     7445             buffer-copy buf_doc-line to tt_doc-line
     7446               assign
     7447                 tt_doc-line.gds-code = buf_goods.gds-code
     7448             .
     7449           end.
     7450         end.
     7451         assign
     7452           v-doc-code     = tt_trn-doc.doc-code
     7453           v-ext-doc-type = tt_trn-doc.ext-doc-type
     7454         .
     7455       end.
     7456       else do:
     7457         if valid-handle( p-handle-doc-line ) then do:
     7458           create tt_doc-line .
     7459           assign
     7460             v-ok = buffer tt_doc-line :handle :buffer-copy ( p-handle-doc-line )
     7461           .
     7462           find first buf_goods no-lock
     7463             where buf_goods.artic     = tt_doc-line.artic
     7464               and buf_goods.prod-type = tt_doc-line.prod-type
     7465               and buf_goods.prod-code = tt_doc-line.prod-code
     7466             .
     7467   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7468     (
     7469        input buf_goods.artic
     7470     ,  input buf_goods.prod-type
     7471     ,  input buf_goods.prod-code
     7472     , output is-petrol
     7473     , output is-pieces
     7474     ) .
     7475           if not( is-petrol = true
     7476                   and is-pieces = false
     7477                 )
     7478             or tt_doc-line.status_ <> 'факт':U
     7479           then do:
     7480             delete tt_doc-line.
     7481           end.
     7482           else do:
     7483             assign
     7484               tt_doc-line.gds-code = buf_goods.gds-code
     7485               v-doc-code           = tt_doc-line.doc-code
     7486               v-ext-doc-type       = tt_doc-line.ext-doc-type
     7487             .
     7488           end.
     7489         end.
     7490         else do:
     7491           undo, return error substitute( "lib-trn3_reclcptr.  Ошибка задания входных параметров. Не задан указатель на документ или на строку документа." ) .
     7492         end.
     7493       end.
     7494       for each tt_doc-line
     7495       on error undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7496       :
     7497         if tt_doc-line.doc-code <> v-doc-code then do:
     7498           undo, return error substitute( 'lib-trn3_reclcptr. Пересчет может запускаться только для одного документа, а запускается для "&1" и "&2".', v-doc-code, tt_doc-line.doc-code ).
     7499         end.
     7500         if tt_doc-line.ext-doc-type <> v-ext-doc-type then do:
     7501           undo, return error substitute( 'lib-trn3_reclcptr. В документе &1 есть строки с разным расширенным типом: "&2" и "&3".', v-doc-code, v-ext-doc-type, tt_doc-line.ext-doc-type ).
     7502         end.
     7503         if lookup( tt_doc-line.ext-doc-type, 'ee,ep,es,we,ev,em,wm,eo':U ) > 0 then do:
     7504           assign
     7505             v-sign = p-warp-factor * -1.0
     7506           .
     7507         end.
     7508         else do:
     7509           assign
     7510             v-sign = p-warp-factor
     7511           .
     7512           if lookup( tt_doc-line.ext-doc-type, 'ie,re,rs,vt,vp,ap,mp,pc,iv,rv,im,io':U ) = 0 then do:
     7513             undo, return error substitute( 'lib-trn3_reclcptr. Тип "&1" не внесен в списки документов уменьшающих(увеличивающих) остатки!', tt_doc-line.ext-doc-type).
     7514           end.
     7515         end.
     7516         find first buf_inv-line exclusive-lock
     7517           where buf_inv-line.doc-code  = tt_doc-line.doc-code
     7518             and buf_inv-line.artic     = tt_doc-line.artic
     7519             and buf_inv-line.prod-type = tt_doc-line.prod-type
     7520             and buf_inv-line.prod-code = tt_doc-line.prod-code
     7521           no-error .
     7522         if not available buf_inv-line then do:
     7523           undo, return error substitute( 'lib-trn3_reclcptr. Нет строки и с нарастающим итогом (inv-line).&1Документ &2&1Товар &3', chr(10), tt_doc-line.doc-code, tt_doc-line.artic).
     7524         end.
     7525         if lookup( tt_doc-line.ext-doc-type, 'vt,ap,mp,vp,':U ) > 0 then do:
     7526           assign
     7527             v-doc-cli-qnty = tt_doc-line.cli-qnty
     7528           .
     7529         end.
     7530         else do:
     7531           assign
     7532             v-doc-cli-qnty = buf_inv-line.wast-cli-qnty
     7533           .
     7534         end.
     7535         if buf_inv-line.wast-cli-qnty <> 0.0 then do:
     7536           for each buf-next_inv-line exclusive-lock
     7537             where buf-next_inv-line.obj-type   = tt_doc-line.obj-type
     7538               and buf-next_inv-line.obj-code   = tt_doc-line.obj-code
     7539               and buf-next_inv-line.prod-code  = tt_doc-line.prod-code
     7540               and buf-next_inv-line.prod-type  = tt_doc-line.prod-type
     7541               and buf-next_inv-line.artic      = tt_doc-line.artic
     7542               and buf-next_inv-line.status_    = 'факт':U
     7543               and buf-next_inv-line.fact-order > tt_doc-line.fact-order
     7544             use-index fact-order
     7545           on error undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7546           :
     7547             assign
     7548               buf-next_inv-line.before-cli-qnty = buf-next_inv-line.before-cli-qnty + v-doc-cli-qnty * v-sign
     7549               buf-next_inv-line.after-cli-qnty  = buf-next_inv-line.after-cli-qnty  + v-doc-cli-qnty * v-sign
     7550             .
     7551             find first buf-next_trn-doc no-lock
     7552               where buf-next_trn-doc.doc-code = buf-next_inv-line.doc-code
     7553               no-error .
     7554             if not available buf-next_trn-doc then do:
     7555               undo, return error substitute( "lib-trn3_reclcptr. Отсутствует шапка документа &1. Пересчет невозможен!", buf-next_inv-line.doc-code).
     7556             end.
     7557             if buf-next_trn-doc.doc-type = 'инв':U then do:
     7558               assign
     7559                 buf-next_inv-line.wast-cli-qnty = buf-next_inv-line.after-cli-qnty
     7560               .
     7561             end.
     7562           end.
     7563         end.
     7564         for each buf-next_rvs-doc
     7565           where buf-next_rvs-doc.obj-type   = tt_doc-line.obj-type
     7566             and buf-next_rvs-doc.obj-code   = tt_doc-line.obj-code
     7567             and buf-next_rvs-doc.status_    = 'факт':U
     7568             and buf-next_rvs-doc.rvs-type  <> 'проверка':U
     7569             and buf-next_rvs-doc.fact-order > tt_doc-line.fact-order
     7570         on error undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7571         :
     7572           if buf-next_rvs-doc.out-code = tt_doc-line.doc-code then do:
     7573             next.
     7574           end.
     7575           assign
     7576             v-cre-hist = false
     7577           .
     7578           for each buf_doc-pl no-lock
     7579             where buf_doc-pl.out-code = tt_doc-line.doc-code
     7580               and buf_doc-pl.gds-code = tt_doc-line.gds-code
     7581               and buf_doc-pl.obj-type = tt_doc-line.obj-type
     7582               and buf_doc-pl.obj-code = tt_doc-line.obj-code
     7583             ,first buf-next_rvs-line
     7584               where buf-next_rvs-line.rvs-code = buf-next_rvs-doc.rvs-code
     7585                 and buf-next_rvs-line.obj-type = buf_doc-pl.obj-type
     7586                 and buf-next_rvs-line.obj-code = buf_doc-pl.obj-code
     7587                 and buf-next_rvs-line.pl-code  = buf_doc-pl.pl-code
     7588                 and buf-next_rvs-line.gds-code = buf_doc-pl.gds-code
     7589           on error undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7590           :
     7591             if v-cre-hist = false then do:
     7592   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_hstc-rvs in g#lib-rvs
     7593   ( buffer buf-next_rvs-doc
     7594    ,input integer('3':U)
     7595    ,input tt_doc-line.doc-code
     7596    ,input p-chip-num-main
     7597   ) no-error.
     7598               if error-status :error then do:
     7599                 undo, return error substitute("lib-trn3_reclcptr. Ошибка при вызове процедуры lib-trn_hstc-rvs. &1 &2", error-status :get-message(1), return-value).
     7600               end.
     7601               assign
     7602                 v-cre-hist = true
     7603               .
     7604             end.
     7605             assign
     7606               buf-next_rvs-line.system-qnty     = buf-next_rvs-line.system-qnty     + buf_doc-pl.fact-qnty     * v-sign
     7607               buf-next_rvs-doc.system-qnty      = buf-next_rvs-doc.system-qnty      + buf_doc-pl.fact-qnty     * v-sign
     7608               buf-next_rvs-line.system-cli-qnty = buf-next_rvs-line.system-cli-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     7609               buf-next_rvs-doc.system-cli-qnty  = buf-next_rvs-doc.system-cli-qnty  + buf_doc-pl.cli-fact-qnty * v-sign
     7610             .
     7611             find first tt_corr-place
     7612               where tt_corr-place.gds-code = buf_doc-pl.gds-code
     7613                 and tt_corr-place.pl-code  = buf_doc-pl.pl-code
     7614               no-error .
     7615             if not available tt_corr-place then do:
     7616               create tt_corr-place.
     7617               assign
     7618                 tt_corr-place.gds-code = buf_doc-pl.gds-code
     7619                 tt_corr-place.pl-code  = buf_doc-pl.pl-code
     7620               .
     7621             end.
     7622           end.
     7623         end.
     7624       end.
     7625       for each buf_rvs-doc exclusive-lock
     7626         where buf_rvs-doc.out-code = v-doc-code
     7627         ,each tt_corr-place
     7628         ,first buf_rvs-line exclusive-lock
     7629         where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     7630           and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     7631           and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     7632           and buf_rvs-line.pl-code  = tt_corr-place.pl-code
     7633           and buf_rvs-line.gds-code = tt_corr-place.gds-code
     7634       on error undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7635       :
     7636         assign
     7637           buf_rvs-line.system-qnty     = ?
     7638           buf_rvs-doc.system-qnty      = ?
     7639           buf_rvs-line.system-cli-qnty = ?
     7640           buf_rvs-doc.system-cli-qnty  = ?
     7641         .
     7642       end.
     7643       for each tt_trn-doc
     7644       on error undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7645       :
     7646         delete tt_trn-doc .
     7647       end.
     7648       for each tt_doc-line
     7649       on error undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7650       :
     7651         delete tt_doc-line .
     7652       end.
     7653       for each tt_corr-place
     7654       on error undo, return error substitute( "lib-trn3_reclcptr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7655       :
     7656         delete tt_corr-place .
     7657       end.
     7658       return.
     7659     end.
     7660   end procedure.
     7661   procedure lib-trn3_invlnprc :
     7662     define  input parameter p-doc-code     like ub.doc-line.doc-code   no-undo.
     7663     define  input parameter p-artic        like ub.doc-line.artic      no-undo.
     7664     define  input parameter p-prod-type    like ub.doc-line.prod-type  no-undo.
     7665     define  input parameter p-prod-code    like ub.doc-line.prod-code  no-undo.
     7666     define  input parameter p-price-type   as   character              no-undo.
     7667     define  input parameter p-print-rubl   as   logical                no-undo.
     7668     define output parameter p-out-price-kg like ub.doc-line.price-rubl no-undo initial 0.0.
     7669     define buffer buf_inv-line for ub.inv-line.
     7670     do on error undo, return error return-value :
     7671       if lookup( p-price-type, "acc,sale" ) = 0 then do:
     7672         undo, return error substitute( 'lib-trn3_invlnprc: неизвестный тип цены - "&1" (допустимо: acc,sale)',
     7673                                        p-price-type ).
     7674       end.
     7675       assign p-price-type = p-price-type + ( if p-print-rubl = yes then "-rubl" else "-base" ).
     7676       find buf_inv-line no-lock where
     7677            buf_inv-line.doc-code  = p-doc-code  and
     7678            buf_inv-line.artic     = p-artic     and
     7679            buf_inv-line.prod-code = p-prod-code and
     7680            buf_inv-line.prod-type = p-prod-type no-error.
     7681       if available buf_inv-line then do:
     7682         case p-price-type :
     7683           when "acc-rubl"  then do: assign p-out-price-kg = buf_inv-line.unus-wast-rubl. end.
     7684           when "acc-base"  then do: assign p-out-price-kg = buf_inv-line.unus-wast-base. end.
     7685           when "sale-rubl" then do: assign p-out-price-kg = buf_inv-line.wast-rubl.      end.
     7686           when "sale-base" then do: assign p-out-price-kg = buf_inv-line.wast-base.      end.
     7687           otherwise             do:
     7688             undo, return error substitute(
     7689               'lib-trn3_invlnprc: неизвестный тип цены - "&1" (допустимо: acc,sale[-rubl/-base])', p-price-type ).
     7690           end.
     7691         end case.
     7692       end.
     7693     end.
     7694   end procedure.
     7695   procedure lib-trn3_invlnqty :
     7696     define  input parameter p-doc-code     like ub.doc-line.doc-code   no-undo.
     7697     define  input parameter p-artic        like ub.doc-line.artic      no-undo.
     7698     define  input parameter p-prod-type    like ub.doc-line.prod-type  no-undo.
     7699     define  input parameter p-prod-code    like ub.doc-line.prod-code  no-undo.
     7700     define  input parameter p-is-arch-qnty as   logical                no-undo.
     7701     define output parameter p-out-qnty-kg  like ub.doc-line.price-rubl no-undo initial 0.0.
     7702     define buffer buf_inv-line for ub.inv-line.
     7703     do on error undo, return error return-value :
     7704       if p-is-arch-qnty <> yes then do: assign p-is-arch-qnty = no. end.
     7705       find buf_inv-line          no-lock where
     7706            buf_inv-line.doc-code  = p-doc-code  and
     7707            buf_inv-line.artic     = p-artic     and
     7708            buf_inv-line.prod-type = p-prod-type and
     7709            buf_inv-line.prod-code = p-prod-code no-error.
     7710       if available buf_inv-line then do:
     7711         assign p-out-qnty-kg = ( if p-is-arch-qnty = yes then buf_inv-line.after-cli-qnty else buf_inv-line.wast-cli-qnty ).
     7712       end.
     7713     end.
     7714   end procedure.
     7715   procedure lib-trn3_getwtqty :
     7716     define  input parameter p-doc-code      like ub.doc-line.doc-code  no-undo.
     7717     define  input parameter p-artic         like ub.doc-line.artic     no-undo.
     7718     define  input parameter p-prod-type     like ub.doc-line.prod-type no-undo.
     7719     define  input parameter p-prod-code     like ub.doc-line.prod-code no-undo.
     7720     define output parameter p-before-qnty   like ub.doc-line.fact-qnty no-undo initial 0.0.
     7721     define output parameter p-after-qnty    like ub.doc-line.fact-qnty no-undo initial 0.0.
     7722     define output parameter p-diff-qnty     like ub.doc-line.fact-qnty no-undo initial 0.0.
     7723     define output parameter p-diff-abs-qnty like ub.doc-line.fact-qnty no-undo initial 0.0.
     7724     define variable is-petrol    as logical   no-undo.
     7725     define variable is-pieces    as logical   no-undo.
     7726     define variable v-data-type  as character no-undo.
     7727     define variable rec-doc-line as recid     no-undo.
     7728     define variable rec-inv-line as recid     no-undo.
     7729     define variable rec-goods    as recid     no-undo.
     7730     define buffer buf_trn-doc  for ub.trn-doc.
     7731     define buffer buf_goods    for ub.goods.
     7732     define buffer buf_doc-line for ub.doc-line.
     7733     define buffer buf_inv-line for ub.inv-line.
     7734     do on error undo, return error return-value :
     7735   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7736     (
     7737        input p-artic
     7738     ,  input p-prod-type
     7739     ,  input p-prod-code
     7740     , output is-petrol
     7741     , output is-pieces
     7742     ) no-error.
     7743       if error-status :error then do:
     7744         return error return-value.
     7745       end.
     7746       if is-petrol = true
     7747         and is-pieces = false
     7748       then do:
     7749         find buf_trn-doc exclusive-lock
     7750           where buf_trn-doc.doc-code = p-doc-code
     7751           no-error
     7752         .
     7753         if not available buf_trn-doc then do:
     7754           undo, return error substitute( 'lib-trn3_getwtqty: не найден документ "&1"', p-doc-code ).
     7755         end.
     7756         find first buf_goods share-lock
     7757           where buf_goods.artic     = p-artic
     7758             and buf_goods.prod-type = p-prod-type
     7759             and buf_goods.prod-code = p-prod-code
     7760           no-error.
     7761         if not available buf_goods then do:
     7762           undo, return error substitute( 'lib-trn3_getwtqty: не найден товар: Артикул "&1" (производитель: &2 &3)', p-artic, p-prod-type, p-prod-code ).
     7763         end.
     7764         assign
     7765           rec-goods = recid( buf_goods )
     7766         .
     7767         find buf_doc-line        no-lock where
     7768               buf_doc-line.doc-code  = p-doc-code  and
     7769               buf_doc-line.artic     = p-artic     and
     7770               buf_doc-line.prod-type = p-prod-type and
     7771               buf_doc-line.prod-code = p-prod-code no-error.
     7772         if not available buf_doc-line then do:
     7773           undo, return error substitute(
     7774             'lib-trn3_getwtqty: не найдена строка накладной "&1" с товаром: Артикул "&2" (производитель: &3 &4)',
     7775             p-doc-code,
     7776             p-artic,
     7777             p-prod-type,
     7778             p-prod-code                ).
     7779         end.
     7780         assign
     7781           rec-doc-line = recid( buf_doc-line )
     7782         .
     7783         find buf_doc-line exclusive-lock where recid( buf_doc-line ) = rec-doc-line.
     7784         find first buf_inv-line no-lock where
     7785                     buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     7786                     buf_inv-line.artic     = buf_doc-line.artic     and
     7787                     buf_inv-line.prod-type = buf_doc-line.prod-type and
     7788                     buf_inv-line.prod-code = buf_doc-line.prod-code no-error.
     7789         if not available buf_inv-line then do:
     7790           undo, return error substitute(
     7791             'lib-trn3_getwtqty: не найдена строка накладной "&1", товар: Артикул "&2" (производитель: &3 &4)' +
     7792             ' с весовыми итогами по топливу',
     7793             p-doc-code,
     7794             p-artic,
     7795             p-prod-type,
     7796             p-prod-code                ).
     7797         end.
     7798         assign
     7799           rec-inv-line = recid( buf_inv-line )
     7800         .
     7801         find buf_inv-line exclusive-lock where recid( buf_inv-line ) = rec-inv-line.
     7802         if buf_trn-doc.ext-doc-type = 'vt':U      or
     7803             buf_trn-doc.ext-doc-type = 'vp':U then do:
     7804           assign
     7805             p-before-qnty   = buf_inv-line.before-cli-qnty
     7806             p-after-qnty    = buf_inv-line.after-cli-qnty
     7807             p-diff-qnty     = ( p-after-qnty - p-before-qnty )
     7808             p-diff-abs-qnty = abs( p-diff-qnty )
     7809           .
     7810         end.
     7811         else do:
     7812           assign
     7813             p-after-qnty    = buf_inv-line.after-cli-qnty
     7814             p-diff-qnty     = buf_inv-line.wast-cli-qnty
     7815             p-diff-abs-qnty = abs( p-diff-qnty )
     7816           .
     7817           run lib-trn3_correct-quantity in this-procedure ( input buf_trn-doc.doc-type, input-output p-diff-qnty ).
     7818           assign
     7819             p-before-qnty   = ( p-after-qnty - p-diff-qnty )
     7820           .
     7821         end.
     7822         find buf_inv-line        no-lock where recid( buf_inv-line ) = rec-inv-line.
     7823         find buf_doc-line        no-lock where recid( buf_doc-line ) = rec-doc-line.
     7824         find buf_goods           no-lock where recid( buf_goods    ) = rec-goods.
     7825         find buf_trn-doc        no-lock where buf_trn-doc.doc-code = p-doc-code.
     7826       end.
     7827     end.
     7828   end procedure.
     7829   procedure lib-trn3_vollosan :
     7830     define input  parameter p-gds-code   like ub.goods.gds-code        no-undo .
     7831     define input  parameter p-obj-type   like ub.trn-doc.obj-type      no-undo .
     7832     define input  parameter p-obj-code   like ub.trn-doc.obj-code      no-undo .
     7833     define input  parameter p-pl-list    as character                  no-undo .
     7834     define input  parameter p-shift-date like ub.trn-doc.shift-date    no-undo .
     7835     define input  parameter p-shift-num  like ub.trn-doc.shift-num     no-undo .
     7836     define input  parameter p-fact-date  like ub.trn-doc.fact-date     no-undo .
     7837     define input  parameter p-fact-time  like ub.trn-doc.fact-time     no-undo .
     7838     define output parameter p-pl-code    like ub.pl-gds.pl-code no-undo .
     7839     do
     7840     on error  undo, return error substitute( "&1 (lib-trn3_vollosan). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7841     on stop   undo, return error substitute( "&1 (lib-trn3_vollosan). stop", vss-workfile )
     7842     on endkey undo, return error substitute( "&1 (lib-trn3_vollosan). endkey", vss-workfile )
     7843     :
     7844       define variable is-petrol           as logical   no-undo .
     7845       define variable is-pieces           as logical   no-undo .
     7846       define variable from_fact-order     as decimal   no-undo .
     7847       define variable v-next-fact-order   as decimal   no-undo .
     7848       define variable v-prev-fact-order   as decimal   no-undo .
     7849       define variable v-next-date         as date      no-undo .
     7850       define variable v-prev-date         as date      no-undo .
     7851       define variable v-prev-doc          like ub.rvs-doc.rvs-code      no-undo .
     7852       define variable v-next-time         as integer   no-undo .
     7853       define variable v-prev-time         as integer   no-undo .
     7854       define variable v-num-rvs           as integer   no-undo .
     7855       define variable v-prev-rvs-doc      as character no-undo .
     7856       define variable v-next-rvs-doc      as character no-undo .
     7857       define variable vNeedSkip           as logical   no-undo .
     7858       define variable ii                  as integer   no-undo .
     7859       define variable v-max-volume-loss   as decimal   no-undo init 0.0 .
     7860       define variable v-value             as character no-undo.
     7861       define variable v-ok                as logical no-undo.
     7862       define buffer buf_goods          for ub.goods .
     7863       define buffer buf_rvs-doc        for ub.rvs-doc .
     7864       define buffer buf_rvs-line       for ub.rvs-line .
     7865       define buffer buf-curr_shift-obj for ub.shift-obj .
     7866       define buffer buf-prev_shift-obj for ub.shift-obj .
     7867       define buffer buf-prev_rvs-doc   for ub.rvs-doc .
     7868       define buffer buf-prev_rvs-line  for ub.rvs-line .
     7869       define buffer buf_tt-place-volume-loss for tt-place-volume-loss .
     7870       find first buf_goods no-lock
     7871         where buf_goods.gds-code = p-gds-code
     7872         no-error.
     7873       if not available buf_goods then do:
     7874         undo, return error substitute( "&1 (lib-trn3_avrgdens). Не найден товар &2 ", vss-workfile, p-gds-code ).
     7875       end.
     7876   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7877     (
     7878        input buf_goods.artic
     7879     ,  input buf_goods.prod-type
     7880     ,  input buf_goods.prod-code
     7881     , output is-petrol
     7882     , output is-pieces
     7883     ) .
     7884       if is-petrol = yes
     7885         and is-pieces = no
     7886       then do:
     7887   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7888   run get-ptrl-prop in this-procedure
     7889     ( input p-obj-type
     7890     , input p-obj-code
     7891     ) .
     7892         assign
     7893           from_fact-order = 0.0
     7894         .
     7895         find first buf-curr_shift-obj no-lock
     7896           where buf-curr_shift-obj.obj-type   = p-obj-type
     7897             and buf-curr_shift-obj.obj-code   = p-obj-code
     7898             and buf-curr_shift-obj.shift-date = p-shift-date
     7899             and buf-curr_shift-obj.shift-num  = p-shift-num
     7900           no-error .
     7901         if not available buf-curr_shift-obj then do:
     7902           undo, return error substitute( 'lib-trn3_avrgdens: не найдена смена &1 &2 на объекте &3 &4'
     7903                                       , p-shift-num
     7904                                       , p-shift-date
     7905                                       , p-obj-type
     7906                                       , p-obj-code
     7907                                       ) .
     7908         end.
     7909         find last buf-prev_shift-obj no-lock
     7910           where buf-prev_shift-obj.obj-type   = p-obj-type
     7911             and buf-prev_shift-obj.obj-code   = p-obj-code
     7912             and ( ( buf-prev_shift-obj.shift-date = p-shift-date
     7913                     and buf-prev_shift-obj.shift-num  < p-shift-num
     7914                   )
     7915                   or ( buf-prev_shift-obj.shift-date < p-shift-date
     7916                         and buf-prev_shift-obj.shift-num  > 0
     7917                       )
     7918                 )
     7919           use-index pi
     7920           no-error.
     7921         if available buf-prev_shift-obj then do:
     7922           find first buf-prev_rvs-doc no-lock
     7923             where buf-prev_rvs-doc.obj-type   = buf-prev_shift-obj.obj-type
     7924               and buf-prev_rvs-doc.obj-code   = buf-prev_shift-obj.obj-code
     7925               and buf-prev_rvs-doc.shift-date = buf-prev_shift-obj.shift-date
     7926               and buf-prev_rvs-doc.shift-num  = buf-prev_shift-obj.shift-num
     7927               and buf-prev_rvs-doc.status_    = 'факт':U
     7928               and buf-prev_rvs-doc.rvs-type   = 'смена':U
     7929             use-index shift-type
     7930             no-error .
     7931           if available buf-prev_rvs-doc then do:
     7932             find first buf-prev_rvs-line no-lock
     7933               where buf-prev_rvs-line.rvs-code   = buf-prev_rvs-doc.rvs-code
     7934                 and buf-prev_rvs-line.obj-type   = buf-prev_rvs-doc.obj-type
     7935                 and buf-prev_rvs-line.obj-code   = buf-prev_rvs-doc.obj-code
     7936                 and buf-prev_rvs-line.pl-code    = integer(entry(1, p-pl-list))
     7937                 and buf-prev_rvs-line.gds-code   = buf_goods.gds-code
     7938               no-error .
     7939             if available buf-prev_rvs-line then do:
     7940               assign
     7941                 from_fact-order = buf-prev_rvs-doc.fact-order
     7942               .
     7943             end.
     7944           end.
     7945         end.
     7946         assign
     7947           v-next-fact-order = ?
     7948           v-prev-fact-order = ?
     7949           v-next-date       = ?
     7950           v-prev-date       = ?
     7951           v-next-time       = 0
     7952           v-prev-time       = 0
     7953           v-num-rvs         = 0
     7954           v-prev-rvs-doc    = ""
     7955           v-next-rvs-doc    = ""
     7956         .
     7957         if available buf-prev_rvs-line then do:
     7958           assign
     7959             v-prev-date       = buf-prev_rvs-doc.sys-date
     7960             v-prev-time       = buf-prev_rvs-doc.sys-time-int
     7961             v-prev-fact-order = buf-prev_rvs-doc.fact-order
     7962             v-num-rvs         = 1
     7963           .
     7964         end.
     7965         do ii = 1 to num-entries(p-pl-list) :
     7966           run CrTempDump (p-obj-type,
     7967                           p-obj-code,
     7968                           p-shift-date,
     7969                           p-shift-num,
     7970                           integer(entry(ii, p-pl-list)),
     7971                           buf_goods.gds-code).
     7972         end .
     7973         rvsdoc:
     7974         for each buf_rvs-doc no-lock
     7975           where buf_rvs-doc.obj-type   = p-obj-type
     7976             and buf_rvs-doc.obj-code   = p-obj-code
     7977             and buf_rvs-doc.shift-date = p-shift-date
     7978             and buf_rvs-doc.shift-num  = p-shift-num
     7979             and buf_rvs-doc.status_    = 'факт':U
     7980           ,each buf_rvs-line no-lock
     7981           where buf_rvs-line.rvs-code   = buf_rvs-doc.rvs-code
     7982             and buf_rvs-line.obj-type   = buf_rvs-doc.obj-type
     7983             and buf_rvs-line.obj-code   = buf_rvs-doc.obj-code
     7984             and buf_rvs-line.gds-code   = buf_goods.gds-code
     7985             and can-do(p-pl-list, string(buf_rvs-line.pl-code))
     7986           by buf_rvs-doc.fact-order
     7987         on error undo, return error substitute( "&1 (lib-trn3_vollosan). &2 ", vss-workfile, return-value )
     7988         :
     7989           if buf_rvs-doc.rvs-type  = 'перед_док':U
     7990           or buf_rvs-doc.rvs-type  = 'после_док':U
     7991           or buf_rvs-doc.rvs-type  = 'проверка':U
     7992             then next rvsdoc.
     7993           assign
     7994             v-num-rvs = v-num-rvs + 1
     7995           .
     7996           if buf_rvs-doc.sys-date < p-fact-date
     7997             or ( buf_rvs-doc.sys-date = p-fact-date
     7998                 and buf_rvs-doc.sys-time-int < p-fact-time
     7999                )
     8000           then do:
     8001             if v-prev-fact-order = ?
     8002               or ( v-prev-date = ?
     8003                   and v-prev-time = 0
     8004                 )
     8005               or v-prev-date < buf_rvs-doc.sys-date
     8006               or ( v-prev-date = buf_rvs-doc.sys-date
     8007                   and v-prev-time < buf_rvs-doc.sys-time-int
     8008                 )
     8009               or ( v-prev-date = buf_rvs-doc.sys-date
     8010                   and v-prev-time = buf_rvs-doc.sys-time-int
     8011                   and v-prev-fact-order < buf_rvs-doc.fact-order
     8012                 )
     8013             then do:
     8014                run ChkRvsSkip(buf_rvs-line.obj-type,
     8015                               buf_rvs-line.obj-code,
     8016                               buf_rvs-line.rvs-code,
     8017                               buf_rvs-line.pl-code,
     8018                               buf_rvs-line.gds-code,
     8019                               buf_rvs-doc.sys-date,
     8020                               buf_rvs-doc.sys-time-int,
     8021                               output vNeedSkip).
     8022                if vNeedSkip then .
     8023                else
     8024                  assign
     8025                    v-prev-date       = buf_rvs-doc.sys-date
     8026                    v-prev-time       = buf_rvs-doc.sys-time-int
     8027                    v-prev-fact-order = buf_rvs-doc.fact-order
     8028                    v-prev-rvs-doc    = buf_rvs-doc.rvs-code
     8029                  .
     8030             end.
     8031           end.
     8032           if buf_rvs-doc.sys-date > p-fact-date
     8033             or ( buf_rvs-doc.sys-date = p-fact-date
     8034                 and buf_rvs-doc.sys-time-int > p-fact-time
     8035               )
     8036           then do:
     8037             if v-next-fact-order = ?
     8038               or ( v-next-date = ?
     8039                    and v-next-time = 0
     8040                   )
     8041               or v-next-date > buf_rvs-doc.sys-date
     8042               or ( v-next-date = buf_rvs-doc.sys-date
     8043                     and v-next-time > buf_rvs-doc.sys-time-int
     8044                   )
     8045               or ( v-next-date = buf_rvs-doc.sys-date
     8046                     and v-next-time = buf_rvs-doc.sys-time-int
     8047                     and v-next-fact-order > buf_rvs-doc.fact-order
     8048                   )
     8049             then do:
     8050                run ChkRvsSkip(buf_rvs-line.obj-type,
     8051                               buf_rvs-line.obj-code,
     8052                               buf_rvs-line.rvs-code,
     8053                               buf_rvs-line.pl-code,
     8054                               buf_rvs-line.gds-code,
     8055                               buf_rvs-doc.sys-date,
     8056                               buf_rvs-doc.sys-time-int,
     8057                               output vNeedSkip).
     8058                if vNeedSkip then .
     8059                else
     8060                  assign
     8061                    v-next-date       = buf_rvs-doc.sys-date
     8062                    v-next-time       = buf_rvs-doc.sys-time-int
     8063                    v-next-fact-order = buf_rvs-doc.fact-order
     8064                    v-next-rvs-doc    = buf_rvs-doc.rvs-code
     8065                  .
     8066             end.
     8067           end.
     8068         end.
     8069         empty temp-table ttDump.
     8070         if v-num-rvs = 0 then do:
     8071           undo, return error substitute( 'lib-trn3_vollosan: нет ни одной сверки за смену &1 &2 и нет сменной сверки за предыдущую смену на объекте &3 &4 по месту хранения &5'
     8072                                         ,p-shift-num
     8073                                         ,p-shift-date
     8074                                         ,p-obj-type
     8075                                         ,p-obj-code
     8076                                         ,integer(entry(1, p-pl-list))
     8077                                        ) .
     8078         end.
     8079         if v-next-rvs-doc = ""
     8080         and v-prev-rvs-doc > ""
     8081         then do :
     8082           assign v-next-rvs-doc = v-prev-rvs-doc .
     8083         end .
     8084         if v-prev-rvs-doc = ""
     8085         and v-next-rvs-doc > ""
     8086         then do :
     8087           assign v-prev-rvs-doc = v-next-rvs-doc .
     8088         end .
     8089         for first buf_rvs-doc no-lock where buf_rvs-doc.rvs-code = v-next-rvs-doc,
     8090           each buf_rvs-line no-lock
     8091           where buf_rvs-line.rvs-code   = buf_rvs-doc.rvs-code
     8092             and buf_rvs-line.obj-type   = buf_rvs-doc.obj-type
     8093             and buf_rvs-line.obj-code   = buf_rvs-doc.obj-code
     8094             and buf_rvs-line.gds-code   = buf_goods.gds-code
     8095             and can-do(p-pl-list, string(buf_rvs-line.pl-code))
     8096         :
     8097           create tt-place-volume-loss .
     8098           assign
     8099             tt-place-volume-loss.pl-code     = buf_rvs-line.pl-code
     8100             tt-place-volume-loss.volume-loss = buf_rvs-line.state-measure-qnty
     8101           .
     8102         end .
     8103         for first buf_rvs-doc no-lock where buf_rvs-doc.rvs-code = v-prev-rvs-doc,
     8104           each buf_rvs-line no-lock
     8105           where buf_rvs-line.rvs-code   = buf_rvs-doc.rvs-code
     8106             and buf_rvs-line.obj-type   = buf_rvs-doc.obj-type
     8107             and buf_rvs-line.obj-code   = buf_rvs-doc.obj-code
     8108             and buf_rvs-line.gds-code   = buf_goods.gds-code
     8109             and can-do(p-pl-list, string(buf_rvs-line.pl-code))
     8110         :
     8111           find first tt-place-volume-loss where tt-place-volume-loss.pl-code = buf_rvs-line.pl-code no-error .
     8112           if available tt-place-volume-loss
     8113           then do :
     8114             assign
     8115               tt-place-volume-loss.volume-loss = tt-place-volume-loss.volume-loss - buf_rvs-line.state-measure-qnty
     8116             .
     8117           end .
     8118         end .
     8119         for each tt-place-volume-loss :
     8120           if tt-place-volume-loss.volume-loss > 0 then tt-place-volume-loss.volume-loss = 0 .
     8121           if tt-place-volume-loss.volume-loss < 0 then tt-place-volume-loss.volume-loss = abs(tt-place-volume-loss.volume-loss) .
     8122         end .
     8123         for each tt-place-volume-loss :
     8124           v-max-volume-loss = max(v-max-volume-loss, tt-place-volume-loss.volume-loss) .
     8125         end .
     8126         find tt-place-volume-loss where tt-place-volume-loss.volume-loss = v-max-volume-loss no-wait no-error .
     8127         if ambiguous tt-place-volume-loss
     8128         then do :
     8129           for each tt-place-volume-loss :
     8130             run placelib_get-attr(input "place-current"
     8131                                  ,input p-obj-code
     8132                                  ,input p-obj-type
     8133                                  ,input tt-place-volume-loss.pl-code
     8134                                  ,output v-value
     8135                                  ,output v-ok)
     8136             no-error .
     8137             if v-ok
     8138             and logical(v-value)
     8139             then do :
     8140               p-pl-code = tt-place-volume-loss.pl-code .
     8141               leave .
     8142             end .
     8143           end .
     8144         end .
     8145         else do :
     8146           if available tt-place-volume-loss
     8147           then do :
     8148             p-pl-code = tt-place-volume-loss.pl-code .
     8149             run placelib_write-attr (input "place-current"
     8150                                     ,input p-obj-code
     8151                                     ,input p-obj-type
     8152                                     ,input p-pl-code
     8153                                     ,input "yes"
     8154                                     ,output v-ok      )
     8155             no-error.
     8156             for each buf_tt-place-volume-loss where buf_tt-place-volume-loss.pl-code <> tt-place-volume-loss.pl-code :
     8157               run placelib_write-attr (input "place-current"
     8158                                       ,input p-obj-code
     8159                                       ,input p-obj-type
     8160                                       ,input buf_tt-place-volume-loss.pl-code
     8161                                       ,input "no"
     8162                                       ,output v-ok      )
     8163               no-error.
     8164             end .
     8165           end .
     8166         end .
     8167         empty temp-table tt-place-volume-loss .
     8168       end .
     8169     end .
     8170   end procedure .
     8171   procedure lib-trn3_avrgdens :
     8172     define input  parameter p-gds-code   like ub.goods.gds-code        no-undo .
     8173     define input  parameter p-obj-type   like ub.trn-doc.obj-type      no-undo .
     8174     define input  parameter p-obj-code   like ub.trn-doc.obj-code      no-undo .
     8175     define input  parameter p-pl-code    like ub.pl-gds.pl-code        no-undo .
     8176     define input  parameter p-shift-date like ub.trn-doc.shift-date    no-undo .
     8177     define input  parameter p-shift-num  like ub.trn-doc.shift-num     no-undo .
     8178     define input  parameter p-fact-date  like ub.trn-doc.fact-date     no-undo .
     8179     define input  parameter p-fact-time  like ub.trn-doc.fact-time     no-undo .
     8180     define output parameter p-density    like ub.doc-line.fact-density no-undo .
     8181     define output parameter p-Reconc-tank-attr as character no-undo .
     8182     do
     8183     on error  undo, return error substitute( "&1 (lib-trn3_avrgdens). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     8184     on stop   undo, return error substitute( "&1 (lib-trn3_avrgdens). stop", vss-workfile )
     8185     on endkey undo, return error substitute( "&1 (lib-trn3_avrgdens). endkey", vss-workfile )
     8186     :
     8187       define variable is-petrol       as logical   no-undo .
     8188       define variable is-pieces       as logical   no-undo .
     8189       define variable v-host-code     as integer   no-undo .
     8190       define variable v-avrgdens      as character no-undo .
     8191       define variable v-data-type     as character no-undo .
     8192       define variable from_fact-order as decimal   no-undo .
     8193       define variable v-density-acc   as decimal   no-undo .
     8194       define variable v-num-rvs       as integer   no-undo .
     8195       define variable v-next-fact-order      as decimal   no-undo .
     8196       define variable v-prev-fact-order      as decimal   no-undo .
     8197       define variable v-next-date            as date      no-undo .
     8198       define variable v-prev-date            as date      no-undo .
     8199       define variable v-prev-doc             like ub.rvs-doc.rvs-code      no-undo .
     8200       define variable v-next-time            as integer   no-undo .
     8201       define variable v-prev-time            as integer   no-undo .
     8202       define variable v-next-density         as decimal   no-undo .
     8203       define variable v-prev-density         as decimal   no-undo .
     8204       define variable v-ostatok-kg           as decimal   no-undo .
     8205       define variable v-oboroty-kg           as decimal   no-undo .
     8206       define variable v-ostatok-lt           as decimal   no-undo .
     8207       define variable v-oboroty-lt           as decimal   no-undo .
     8208       define buffer buf_goods          for ub.goods .
     8209       define buffer buf_rvs-doc        for ub.rvs-doc .
     8210       define buffer buf_rvs-line       for ub.rvs-line .
     8211       define buffer buf-curr_shift-obj for ub.shift-obj .
     8212       define buffer buf-prev_shift-obj for ub.shift-obj .
     8213       define buffer buf-prev_rvs-doc   for ub.rvs-doc .
     8214       define buffer buf-prev_rvs-line  for ub.rvs-line .
     8215       define buffer buf_trn-doc        for ub.trn-doc .
     8216       define buffer buf_doc-line       for ub.doc-line .
     8217       define buffer buf_doc-pl         for ub.doc-pl .
     8218       define buffer buf_pl-gds         for ub.pl-gds .
     8219       define buffer buf_doc-attr       for doc-attr.
     8220       define variable v-attr-type            as character  no-undo.
     8221       define variable v-gds-ptrl-densities   as character  no-undo.
     8222       define variable v-min-dens             as   decimal  no-undo.
     8223       define variable v-max-dens             as   decimal  no-undo.
     8224       define variable v-delta             as   decimal  no-undo.
     8225       define variable v-prev-rvs-doc   as character no-undo.
     8226       define variable v-next-rvs-doc   as character no-undo.
     8227       define variable vNeedSkip        as logical   no-undo.
     8228       find first buf_goods no-lock
     8229         where buf_goods.gds-code = p-gds-code
     8230         no-error.
     8231       if not available buf_goods then do:
     8232         undo, return error substitute( "&1 (lib-trn3_avrgdens). Не найден товар &2 ", vss-workfile, p-gds-code ).
     8233       end.
     8234   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     8235     (
     8236        input buf_goods.artic
     8237     ,  input buf_goods.prod-type
     8238     ,  input buf_goods.prod-code
     8239     , output is-petrol
     8240     , output is-pieces
     8241     ) .
     8242       define variable is-vir as logical no-undo.
     8243       define variable v-value as character no-undo.
     8244       define variable v-ok as logical no-undo.
     8245       define variable vAutoRvd as logical no-undo.
     8246       run placelib_get-attr(input "place-virtual"
     8247                            ,input p-obj-code
     8248                            ,input p-obj-type
     8249                            ,input p-pl-code
     8250                            ,output v-value
     8251                            ,output v-ok) no-error.
     8252       is-vir = if (v-ok and logical(v-value)) then true else false.
     8253       if is-petrol = yes
     8254         and is-pieces = no or is-gas(buf_goods.gds-code) or is-vir
     8255       then do:
     8256         if buf_goods.unit-base = buf_goods.unit-cli then do:
     8257           assign
     8258             p-density = 1.0
     8259           .
     8260         end.
     8261         if is-gas(buf_goods.gds-code) then p-density = 1 / buf_goods.cli-base-rate.
     8262         else do:
     8263           if is-vir then do:
     8264               find first buf_pl-gds no-lock
     8265                 where buf_pl-gds.obj-type = p-obj-type
     8266                   and buf_pl-gds.obj-code = p-obj-code
     8267                   and buf_pl-gds.pl-code = p-pl-code
     8268                   and buf_pl-gds.gds-code = buf_goods.gds-code no-error.
     8269               p-density = buf_pl-gds.cli-fact-qnty / buf_pl-gds.fact-qnty.
     8270           end.
     8271           else do:
     8272   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8273   run get-ptrl-prop in this-procedure
     8274     ( input p-obj-type
     8275     , input p-obj-code
     8276     ) .
     8277           assign
     8278             from_fact-order = 0.0
     8279           .
     8280           find first buf-curr_shift-obj no-lock
     8281             where buf-curr_shift-obj.obj-type   = p-obj-type
     8282               and buf-curr_shift-obj.obj-code   = p-obj-code
     8283               and buf-curr_shift-obj.shift-date = p-shift-date
     8284               and buf-curr_shift-obj.shift-num  = p-shift-num
     8285             no-error .
     8286           if not available buf-curr_shift-obj then do:
     8287             undo, return error substitute( 'lib-trn3_avrgdens: не найдена смена &1 &2 на объекте &3 &4'
     8288                                         , p-shift-num
     8289                                         , p-shift-date
     8290                                         , p-obj-type
     8291                                         , p-obj-code
     8292                                         ) .
     8293           end.
     8294           find last buf-prev_shift-obj no-lock
     8295             where buf-prev_shift-obj.obj-type   = p-obj-type
     8296               and buf-prev_shift-obj.obj-code   = p-obj-code
     8297               and ( ( buf-prev_shift-obj.shift-date = p-shift-date
     8298                       and buf-prev_shift-obj.shift-num  < p-shift-num
     8299                     )
     8300                     or ( buf-prev_shift-obj.shift-date < p-shift-date
     8301                           and buf-prev_shift-obj.shift-num  > 0
     8302                         )
     8303                   )
     8304             use-index pi
     8305             no-error.
     8306           if available buf-prev_shift-obj then do:
     8307             find first buf-prev_rvs-doc no-lock
     8308               where buf-prev_rvs-doc.obj-type   = buf-prev_shift-obj.obj-type
     8309                 and buf-prev_rvs-doc.obj-code   = buf-prev_shift-obj.obj-code
     8310                 and buf-prev_rvs-doc.shift-date = buf-prev_shift-obj.shift-date
     8311                 and buf-prev_rvs-doc.shift-num  = buf-prev_shift-obj.shift-num
     8312                 and buf-prev_rvs-doc.status_    = 'факт':U
     8313                 and buf-prev_rvs-doc.rvs-type   = 'смена':U
     8314               use-index shift-type
     8315               no-error .
     8316             if available buf-prev_rvs-doc then do:
     8317               find first buf-prev_rvs-line no-lock
     8318                 where buf-prev_rvs-line.rvs-code   = buf-prev_rvs-doc.rvs-code
     8319                   and buf-prev_rvs-line.obj-type   = buf-prev_rvs-doc.obj-type
     8320                   and buf-prev_rvs-line.obj-code   = buf-prev_rvs-doc.obj-code
     8321                   and buf-prev_rvs-line.pl-code    = p-pl-code
     8322                   and buf-prev_rvs-line.gds-code   = buf_goods.gds-code
     8323                 no-error .
     8324               if available buf-prev_rvs-line then do:
     8325                 assign
     8326                   from_fact-order = buf-prev_rvs-doc.fact-order
     8327                 .
     8328               end.
     8329             end.
     8330           end.
     8331           case ptrlprop-denstclc :
     8332             when 'avrg-chk':U then do:
     8333               assign
     8334                 v-next-fact-order = ?
     8335                 v-prev-fact-order = ?
     8336                 v-next-date       = ?
     8337                 v-prev-date       = ?
     8338                 v-next-time       = 0
     8339                 v-prev-time       = 0
     8340                 v-next-density    = ?
     8341                 v-prev-density    = ?
     8342                 v-num-rvs         = 0
     8343                 v-prev-rvs-doc    = ""
     8344                 v-next-rvs-doc    = ""
     8345               .
     8346               if available buf-prev_rvs-line then do:
     8347                 assign
     8348                   v-prev-date       = buf-prev_rvs-doc.sys-date
     8349                   v-prev-time       = buf-prev_rvs-doc.sys-time-int
     8350                   v-prev-density    = buf-prev_rvs-line.state-density
     8351                   v-prev-fact-order = buf-prev_rvs-doc.fact-order
     8352                   v-prev-rvs-doc    = buf-prev_rvs-doc.rvs-code
     8353                   v-num-rvs         = 1
     8354                 .
     8355               end.
     8356               run CrTempDump (p-obj-type,
     8357                               p-obj-code,
     8358                               p-shift-date,
     8359                               p-shift-num,
     8360                               p-pl-code,
     8361                               buf_goods.gds-code).
     8362               rvsdoc:
     8363               for each buf_rvs-doc no-lock
     8364                 where buf_rvs-doc.obj-type   = p-obj-type
     8365                   and buf_rvs-doc.obj-code   = p-obj-code
     8366                   and buf_rvs-doc.shift-date = p-shift-date
     8367                   and buf_rvs-doc.shift-num  = p-shift-num
     8368                   and buf_rvs-doc.status_    = 'факт':U
     8369                 ,first buf_rvs-line no-lock
     8370                 where buf_rvs-line.rvs-code   = buf_rvs-doc.rvs-code
     8371                   and buf_rvs-line.obj-type   = buf_rvs-doc.obj-type
     8372                   and buf_rvs-line.obj-code   = buf_rvs-doc.obj-code
     8373                   and buf_rvs-line.pl-code    = p-pl-code
     8374                   and buf_rvs-line.gds-code   = buf_goods.gds-code
     8375                 by buf_rvs-doc.fact-order
     8376               on error undo, return error substitute( "&1 (lib-trn3_avrgdens). &2 ", vss-workfile, return-value )
     8377               :
     8378                 if buf_rvs-doc.rvs-type  = 'перед_док':U
     8379                 or buf_rvs-doc.rvs-type  = 'после_док':U
     8380                 or buf_rvs-doc.rvs-type  = 'проверка':U
     8381                   then next rvsdoc.
     8382                 assign
     8383                   v-num-rvs = v-num-rvs + 1
     8384                 .
     8385                 if buf_rvs-doc.sys-date < p-fact-date
     8386                   or ( buf_rvs-doc.sys-date = p-fact-date
     8387                       and buf_rvs-doc.sys-time-int < p-fact-time
     8388                      )
     8389                 then do:
     8390                   if v-prev-fact-order = ?
     8391                     or ( v-prev-date = ?
     8392                         and v-prev-time = 0
     8393                       )
     8394                     or v-prev-date < buf_rvs-doc.sys-date
     8395                     or ( v-prev-date = buf_rvs-doc.sys-date
     8396                         and v-prev-time < buf_rvs-doc.sys-time-int
     8397                       )
     8398                     or ( v-prev-date = buf_rvs-doc.sys-date
     8399                         and v-prev-time = buf_rvs-doc.sys-time-int
     8400                         and v-prev-fact-order < buf_rvs-doc.fact-order
     8401                       )
     8402                   then do:
     8403                      run ChkRvsSkip(buf_rvs-line.obj-type,
     8404                                     buf_rvs-line.obj-code,
     8405                                     buf_rvs-line.rvs-code,
     8406                                     buf_rvs-line.pl-code,
     8407                                     buf_rvs-line.gds-code,
     8408                                     buf_rvs-doc.sys-date,
     8409                                     buf_rvs-doc.sys-time-int,
     8410                                     output vNeedSkip).
     8411                      if vNeedSkip then .
     8412                      else
     8413                        assign
     8414                          v-prev-date       = buf_rvs-doc.sys-date
     8415                          v-prev-time       = buf_rvs-doc.sys-time-int
     8416                          v-prev-density    = buf_rvs-line.state-density
     8417                          v-prev-fact-order = buf_rvs-doc.fact-order
     8418                          v-prev-rvs-doc    = buf_rvs-doc.rvs-code
     8419                        .
     8420                   end.
     8421                 end.
     8422                 if buf_rvs-doc.sys-date > p-fact-date
     8423                   or ( buf_rvs-doc.sys-date = p-fact-date
     8424                       and buf_rvs-doc.sys-time-int > p-fact-time
     8425                     )
     8426                 then do:
     8427                   if v-next-fact-order = ?
     8428                     or ( v-next-date = ?
     8429                          and v-next-time = 0
     8430                         )
     8431                     or v-next-date > buf_rvs-doc.sys-date
     8432                     or ( v-next-date = buf_rvs-doc.sys-date
     8433                           and v-next-time > buf_rvs-doc.sys-time-int
     8434                         )
     8435                     or ( v-next-date = buf_rvs-doc.sys-date
     8436                           and v-next-time = buf_rvs-doc.sys-time-int
     8437                           and v-next-fact-order > buf_rvs-doc.fact-order
     8438                         )
     8439                   then do:
     8440                      run ChkRvsSkip(buf_rvs-line.obj-type,
     8441                                     buf_rvs-line.obj-code,
     8442                                     buf_rvs-line.rvs-code,
     8443                                     buf_rvs-line.pl-code,
     8444                                     buf_rvs-line.gds-code,
     8445                                     buf_rvs-doc.sys-date,
     8446                                     buf_rvs-doc.sys-time-int,
     8447                                     output vNeedSkip).
     8448                      if vNeedSkip then .
     8449                      else
     8450                        assign
     8451                          v-next-date       = buf_rvs-doc.sys-date
     8452                          v-next-time       = buf_rvs-doc.sys-time-int
     8453                          v-next-density    = buf_rvs-line.state-density
     8454                          v-next-fact-order = buf_rvs-doc.fact-order
     8455                          v-next-rvs-doc    = buf_rvs-doc.rvs-code
     8456                        .
     8457                   end.
     8458                 end.
     8459               end.
     8460               empty temp-table ttDump.
     8461               if session:debug-alert
     8462               then do:
     8463                OUTPUT STREAM out_s TO "avrgdens.log" APPEND.
     8464                  put stream out_s unformatted "Расчет средней плотности чека. Время чека: "
     8465                  datetime(p-fact-date, (p-fact-time * 1000 ))
     8466                  " Сверка до " v-prev-rvs-doc
     8467                  " Время " datetime(v-prev-date, (v-prev-time * 1000 ))
     8468                  " Плотность " v-prev-density
     8469                  " Сверка после " v-next-rvs-doc
     8470                  " Время " datetime(v-next-date, (v-next-time * 1000 ))
     8471                  " Плотность " v-next-density
     8472                  skip.
     8473                  OUTPUT STREAM out_s CLOSE.
     8474               end.
     8475               if v-num-rvs = 0 then do:
     8476                 undo, return error substitute( 'lib-trn3_avrgdens: нет ни одной сверки за смену &1 &2 и нет сменной сверки за предыдущую смену на объекте &3 &4 по месту хранения &5'
     8477                                               ,p-shift-num
     8478                                               ,p-shift-date
     8479                                               ,p-obj-type
     8480                                               ,p-obj-code
     8481                                               ,p-pl-code
     8482                                              ) .
     8483               end.
     8484               if v-prev-density = ?
     8485                 and v-next-density <> ?
     8486               then do:
     8487                 assign
     8488                   v-prev-density = v-next-density
     8489                 .
     8490               end.
     8491               if v-next-density = ?
     8492                 and v-prev-density <> ?
     8493               then do:
     8494                 assign
     8495                   v-next-density = v-prev-density
     8496                 .
     8497               end.
     8498               assign
     8499                 p-density = ( v-next-density + v-prev-density ) / 2.0
     8500                 p-Reconc-tank-attr = v-prev-rvs-doc + "," + v-next-rvs-doc + "," + string(p-pl-code)
     8501               .
     8502             end.
     8503             when 'avrg-rvs':U then do:
     8504               if available buf-prev_rvs-line then do:
     8505                 assign
     8506                   v-density-acc = buf-prev_rvs-line.state-density
     8507                   v-num-rvs     = 1
     8508                 .
     8509               end.
     8510               else do:
     8511                 assign
     8512                   v-density-acc = 0.0
     8513                   v-num-rvs     = 0
     8514                 .
     8515               end.
     8516               for each buf_rvs-doc no-lock
     8517                 where buf_rvs-doc.obj-type   = p-obj-type
     8518                   and buf_rvs-doc.obj-code   = p-obj-code
     8519                   and buf_rvs-doc.shift-date = p-shift-date
     8520                   and buf_rvs-doc.shift-num  = p-shift-num
     8521                   and buf_rvs-doc.status_    = 'факт':U
     8522                 ,first buf_rvs-line no-lock
     8523                 where buf_rvs-line.rvs-code   = buf_rvs-doc.rvs-code
     8524                   and buf_rvs-line.obj-type   = buf_rvs-doc.obj-type
     8525                   and buf_rvs-line.obj-code   = buf_rvs-doc.obj-code
     8526                   and buf_rvs-line.pl-code    = p-pl-code
     8527                   and buf_rvs-line.gds-code   = buf_goods.gds-code
     8528                 by buf_rvs-doc.fact-order
     8529               on error undo, return error substitute( "&1 (lib-trn3_avrgdens). &2 ", vss-workfile, return-value )
     8530               :
     8531                 if buf_rvs-doc.rvs-type = 'проверка':U then next .
     8532                 if buf_rvs-line.state-density <> ?
     8533                   and buf_rvs-doc.rvs-type <> 'смена':U
     8534                 then do:
     8535                   assign
     8536                     v-density-acc = v-density-acc + buf_rvs-line.state-density
     8537                     v-num-rvs     = v-num-rvs + 1
     8538                   .
     8539                 end.
     8540               end.
     8541               if v-num-rvs = 0 then do:
     8542                 undo, return error substitute( 'lib-trn3_avrgdens: нет ни одной сверки за смену &1 &2 и нет сменной сверки за предыдущую смену на объекте &3 &4 по месту хранения &5'
     8543                                               ,p-shift-num
     8544                                               ,p-shift-date
     8545                                               ,p-obj-type
     8546                                               ,p-obj-code
     8547                                               ,p-pl-code
     8548                                              ) .
     8549               end.
     8550               assign
     8551                 p-density = v-density-acc / v-num-rvs
     8552               .
     8553             end.
     8554             when 'shft_rvs-inc':U then do:
     8555               assign
     8556                 v-ostatok-lt    = 0.0
     8557                 v-oboroty-lt    = 0.0
     8558                 v-ostatok-kg    = 0.0
     8559                 v-oboroty-kg    = 0.0
     8560               .
     8561               if available buf-prev_rvs-doc then do:
     8562                 find first buf_rvs-line no-lock
     8563                   where buf_rvs-line.rvs-code = buf-prev_rvs-doc.rvs-code
     8564                     and buf_rvs-line.obj-type = buf-prev_rvs-doc.obj-type
     8565                     and buf_rvs-line.obj-code = buf-prev_rvs-doc.obj-code
     8566                     and buf_rvs-line.pl-code  = p-pl-code
     8567                     and buf_rvs-line.gds-code = buf_goods.gds-code
     8568                   no-error .
     8569                 if available buf_rvs-line then do:
     8570                   assign
     8571                     v-ostatok-lt = buf_rvs-line.state-measure-qnty
     8572                     v-ostatok-kg = buf_rvs-line.state-measure-cli-qnty
     8573                   .
     8574                 end.
     8575               end.
     8576               for each buf_trn-doc no-lock
     8577                 where buf_trn-doc.obj-type   = p-obj-type
     8578                   and buf_trn-doc.obj-code   = p-obj-code
     8579                   and buf_trn-doc.shift-date = p-shift-date
     8580                   and buf_trn-doc.shift-num  = p-shift-num
     8581                   and buf_trn-doc.status_    = 'факт':U
     8582                 ,each buf_doc-line no-lock
     8583                 where buf_doc-line.doc-code     = buf_trn-doc.doc-code
     8584                   and buf_doc-line.artic        = buf_goods.artic
     8585                   and buf_doc-line.prod-type    = buf_goods.prod-type
     8586                   and buf_doc-line.prod-code    = buf_goods.prod-code
     8587                   and buf_doc-line.ext-doc-type = 'ie':U
     8588               on error undo, return error substitute( "&1 (lib-trn3_avrgdens). &2 ", vss-workfile, return-value )
     8589               :
     8590                 find first buf_doc-pl no-lock
     8591                   where buf_doc-pl.obj-type = buf_doc-line.obj-type
     8592                     and buf_doc-pl.obj-code = buf_doc-line.obj-code
     8593                     and buf_doc-pl.pl-code  = p-pl-code
     8594                     and buf_doc-pl.out-code = buf_doc-line.doc-code
     8595                     and buf_doc-pl.gds-code = buf_goods.gds-code
     8596                   no-error.
     8597                 if available buf_doc-pl
     8598                   and buf_doc-pl.fact-qnty <> ?
     8599                   and buf_doc-pl.cli-fact-qnty <> ?
     8600                 then do:
     8601                   assign
     8602                     v-oboroty-lt = v-oboroty-lt + buf_doc-pl.fact-qnty
     8603                     v-oboroty-kg = v-oboroty-kg + buf_doc-pl.cli-fact-qnty
     8604                   .
     8605                 end.
     8606               end.
     8607               if v-ostatok-kg + v-oboroty-kg = 0 or ( v-ostatok-lt + v-oboroty-lt ) = 0 and available buf_rvs-line  then
     8608               assign p-density = buf_rvs-line.state-density.
     8609               else assign
     8610                 p-density = abs( ( v-ostatok-kg + v-oboroty-kg ) / ( v-ostatok-lt + v-oboroty-lt ) )
     8611               .
     8612             end.
     8613             when 'shft_sys-inc':U then do:
     8614               assign
     8615                 v-ostatok-lt    = 0.0
     8616                 v-oboroty-lt    = 0.0
     8617                 v-ostatok-kg    = 0.0
     8618                 v-oboroty-kg    = 0.0
     8619               .
     8620               if available buf-prev_rvs-doc then do:
     8621                 find first buf_rvs-line no-lock
     8622                   where buf_rvs-line.rvs-code = buf-prev_rvs-doc.rvs-code
     8623                     and buf_rvs-line.obj-type = buf-prev_rvs-doc.obj-type
     8624                     and buf_rvs-line.obj-code = buf-prev_rvs-doc.obj-code
     8625                     and buf_rvs-line.pl-code  = p-pl-code
     8626                     and buf_rvs-line.gds-code = buf_goods.gds-code
     8627                   no-error .
     8628                 if available buf_rvs-line then do:
     8629                   assign
     8630                     v-ostatok-lt = buf_rvs-line.system-qnty
     8631                     v-ostatok-kg = buf_rvs-line.system-cli-qnty
     8632                   .
     8633                 end.
     8634               end.
     8635               for each buf_trn-doc no-lock
     8636                 where buf_trn-doc.obj-type   = p-obj-type
     8637                   and buf_trn-doc.obj-code   = p-obj-code
     8638                   and buf_trn-doc.shift-date = p-shift-date
     8639                   and buf_trn-doc.shift-num  = p-shift-num
     8640                   and buf_trn-doc.status_    = 'факт':U
     8641                 ,each buf_doc-line no-lock
     8642                 where buf_doc-line.doc-code     = buf_trn-doc.doc-code
     8643                   and buf_doc-line.artic        = buf_goods.artic
     8644                   and buf_doc-line.prod-type    = buf_goods.prod-type
     8645                   and buf_doc-line.prod-code    = buf_goods.prod-code
     8646                   and buf_doc-line.ext-doc-type = 'ie':U
     8647               on error undo, return error substitute( "&1 (lib-trn3_avrgdens). &2 ", vss-workfile, return-value )
     8648               :
     8649                 find first buf_doc-pl no-lock
     8650                   where buf_doc-pl.obj-type = buf_doc-line.obj-type
     8651                     and buf_doc-pl.obj-code = buf_doc-line.obj-code
     8652                     and buf_doc-pl.pl-code  = p-pl-code
     8653                     and buf_doc-pl.out-code = buf_doc-line.doc-code
     8654                     and buf_doc-pl.gds-code = buf_goods.gds-code
     8655                   no-error.
     8656                 if available buf_doc-pl
     8657                   and buf_doc-pl.fact-qnty <> ?
     8658                   and buf_doc-pl.cli-fact-qnty <> ?
     8659                 then do:
     8660                   assign
     8661                     v-oboroty-lt = v-oboroty-lt + buf_doc-pl.fact-qnty
     8662                     v-oboroty-kg = v-oboroty-kg + buf_doc-pl.cli-fact-qnty
     8663                   .
     8664                 end.
     8665               end.
     8666               if v-ostatok-kg + v-oboroty-kg = 0 or ( v-ostatok-lt + v-oboroty-lt ) = 0 and available buf_rvs-line  then
     8667               assign p-density = buf_rvs-line.state-density.
     8668               else assign
     8669                 p-density = abs( ( v-ostatok-kg + v-oboroty-kg ) / ( v-ostatok-lt + v-oboroty-lt ) )
     8670               .
     8671             end.
     8672             when "fact-approx" then do:
     8673                 v-min-dens = 0.1.
     8674                 v-max-dens = 0.9.
     8675                 find last  buf_rvs-doc no-lock
     8676                 where buf_rvs-doc.obj-type   = p-obj-type
     8677                   and buf_rvs-doc.obj-code   = p-obj-code
     8678                   and buf_rvs-doc.shift-date = p-shift-date
     8679                   and buf_rvs-doc.shift-num  = p-shift-num
     8680                   and buf_rvs-doc.status_    = 'факт':U
     8681                   and buf_rvs-doc.rvs-type  = 'контроль':U no-error.
     8682                 if available buf_rvs-doc then    v-prev-doc = buf_rvs-doc.rvs-code .
     8683                 else  undo, return error substitute( 'lib-trn3_avrgdens: Нет ни одной контрольной сверки в текущей смене.'
     8684                                                                                      ) .
     8685                 for first buf_rvs-line no-lock
     8686                 where buf_rvs-line.rvs-code   =  v-prev-doc
     8687                   and buf_rvs-line.obj-type   = p-obj-type
     8688                   and buf_rvs-line.obj-code   = p-obj-code
     8689                   and buf_rvs-line.pl-code    = p-pl-code
     8690                   and buf_rvs-line.gds-code   = buf_goods.gds-code
     8691                 by buf_rvs-doc.fact-order
     8692               on error undo, return error substitute( "&1 (lib-trn3_avrgdens). &2 ", vss-workfile, return-value )
     8693               :
     8694                   p-density = abs ((buf_rvs-line.system-cli-qnty  - buf_rvs-line.state-measure-cli-qnty) / (buf_rvs-line.system-qnty - buf_rvs-line.state-measure-qnty)).
     8695                      run gds-attr-value in this-procedure
     8696                      ( input  buf_goods.gds-code
     8697                       ,input  'gds-ptrl-densities':U
     8698                       ,output v-gds-ptrl-densities
     8699                       ,output v-attr-type
     8700                      ) .
     8701                      if v-gds-ptrl-densities <> "" and v-gds-ptrl-densities <> ? then do:
     8702                         assign
     8703                           v-min-dens = decimal(replace(entry(1, v-gds-ptrl-densities, "-":U ), "кг\л", "":U))
     8704                           v-max-dens = decimal(replace(entry(2, v-gds-ptrl-densities, "-":U ), "кг\л":U, "":U))
     8705                         no-error .
     8706                      end.
     8707                   if p-density = ? then p-density =  buf_rvs-line.state-density.
     8708                   if  p-density >  v-max-dens then p-density = v-max-dens .
     8709                   if  p-density <  v-min-dens then p-density = v-min-dens .
     8710               end.
     8711             end.
     8712             otherwise do:
     8713               undo, return error substitute( 'lib-trn3_avrgdens: нет описания алгоритма определения плотности &1'
     8714                                             , ptrlprop-denstclc
     8715                                            ) .
     8716             end.
     8717           end case.
     8718           if
     8719     valid-density( p-density, buf_goods.unit-base = buf_goods.unit-cli )
     8720     <> true then do:
     8721             undo, return error substitute( 'lib-trn3_avrgdens: нет возможности определить плотность для товара "&1" (&2) на объекте &3 &4 за смену &5 &6 по алгоритму &7'
     8722                                         , buf_goods.gds-name
     8723                                         , buf_goods.gds-code
     8724                                         , p-obj-type
     8725                                         , p-obj-code
     8726                                         , p-shift-num
     8727                                         , p-shift-date
     8728                                         , ptrlprop-denstclc
     8729                                         ) .
     8730           end.
     8731         end.
     8732         end.
     8733       end.
     8734     end.
     8735   end procedure.
     8736   procedure lib-trn3_check-pair:
     8737   define input parameter pardoc-code  like ub.trn-doc.doc-code no-undo.
     8738   define input parameter parcurdb-num as   integer             no-undo.
     8739   define variable varhold      as character no-undo.
     8740   define variable varhold-type as character no-undo.
     8741   define variable varhold-doc  as character no-undo.
     8742   define buffer bf_trn-doc        for ub.trn-doc.
     8743   define buffer bf-child_trn-doc  for ub.trn-doc.
     8744   define buffer bf-parent_trn-doc for ub.trn-doc.
     8745   define buffer bf_clients        for ub.clients.
     8746   define buffer bf_doc-line       for ub.doc-line.
     8747   define buffer bf-contr_clients  for ub.clients.
     8748   do on error undo, return error return-value :
     8749     find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     8750     if not available bf_trn-doc then do:
     8751       return error substitute ("Не найден документ с номером &1.", bf_trn-doc.doc-code).
     8752     end.
     8753     find first bf_clients where bf_clients.obj-type = bf_trn-doc.obj-type and
     8754                                 bf_clients.obj-code = bf_trn-doc.obj-code no-lock.
     8755   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     8756     (input  'holding':u
     8757     ,input  0
     8758     ,input  '':u
     8759     ,input  0
     8760     ,input  '':u
     8761     ,input  '':u
     8762     ,input  '':u
     8763     ,input  no
     8764     ,output varhold
     8765     ,output varhold-type
     8766     ) no-error .
     8767     if varhold = "yes":u then do:
     8768   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8769   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     8770     (input  bf_trn-doc.doc-code
     8771     ,output varhold-doc
     8772     )  .
     8773     end.
     8774     case bf_trn-doc.ext-doc-type:
     8775       when 'ev':U then do:
     8776         find first bf-contr_clients where bf-contr_clients.obj-type = bf_trn-doc.cli-type and
     8777                                           bf-contr_clients.obj-code = bf_trn-doc.cli-code no-lock.
     8778         if parcurdb-num       = 0                       or
     8779            bf_clients.db-num  = bf-contr_clients.db-num then do:
     8780           if bf_trn-doc.status_ = 'факт':U then do:
     8781             find first bf-child_trn-doc where bf-child_trn-doc.out-code = bf_trn-doc.doc-code no-lock no-error.
     8782             if not available bf-child_trn-doc then do:
     8783               return error substitute ("Документ &1 внутреннего расхода закрыт до факта. По нему не найдено документа внутреннего прихода.", bf_trn-doc.doc-code).
     8784             end.
     8785             if bf-child_trn-doc.ext-doc-type <> 'iv':U then do:
     8786               return error substitute ("Документ &1 внутреннего расхода закрыт до факта. Связанный с ним документ &2 не является документом внутреннего прихода.", bf_trn-doc.doc-code, bf-child_trn-doc.doc-code).
     8787             end.
     8788           end.
     8789         end.
     8790       end.
     8791       when 'iv':U then do:
     8792         find first bf-contr_clients where bf-contr_clients.obj-type = bf_trn-doc.cli-type and
     8793                                           bf-contr_clients.obj-code = bf_trn-doc.cli-code no-lock.
     8794         if parcurdb-num       = 0                       or
     8795            bf_clients.db-num  = bf-contr_clients.db-num then do:
     8796           find first bf-parent_trn-doc where bf-parent_trn-doc.doc-code = bf_trn-doc.out-code no-lock no-error.
     8797           if not available bf-parent_trn-doc then do:
     8798             return error substitute ("Документ &1 внутреннего прихода со ссылкой на внутренний расход &2. Внутренний расход не найден.", bf_trn-doc.doc-code, bf_trn-doc.out-code).
     8799           end.
     8800           if bf-parent_trn-doc.ext-doc-type <> 'ev':U then do:
     8801             return error substitute ("Документ &1 внутреннего прихода. Родительский документ &2 не является документом внутреннего расхода.", bf_trn-doc.doc-code, bf-parent_trn-doc.doc-code).
     8802           end.
     8803           if bf_trn-doc.status_ = 'факт':U then do:
     8804             find first bf_doc-line where bf_doc-line.doc-code  = bf_trn-doc.doc-code  and
     8805                                          bf_doc-line.fact-qnty < bf_doc-line.doc-qnty no-lock no-error.
     8806             if available bf_doc-line then do:
     8807               find first bf-child_trn-doc where bf-child_trn-doc.out-code = bf_trn-doc.doc-code no-lock no-error.
     8808               if not available bf-child_trn-doc then do:
     8809                 return error substitute ("Документ &1 внутреннего прихода закрыт до факта. По нему не найдено документа внутреннего возврата.", bf_trn-doc.doc-code).
     8810               end.
     8811               if bf-child_trn-doc.ext-doc-type <> 'rv':U then do:
     8812                 return error substitute ("Документ &1 внутреннего прихода закрыт до факта. Связанный с ним документ &2 не является документом внутреннего возврата.", bf_trn-doc.doc-code, bf-child_trn-doc.doc-code).
     8813               end.
     8814             end.
     8815           end.
     8816         end.
     8817       end.
     8818       when 'rv':U then do:
     8819         find first bf-contr_clients where bf-contr_clients.obj-type = bf_trn-doc.cli-type and
     8820                                           bf-contr_clients.obj-code = bf_trn-doc.cli-code no-lock.
     8821         if parcurdb-num       = 0                       or
     8822            bf_clients.db-num  = bf-contr_clients.db-num then do:
     8823           find first bf-parent_trn-doc where bf-parent_trn-doc.doc-code = bf_trn-doc.out-code no-lock no-error.
     8824           if not available bf-parent_trn-doc then do:
     8825             return error substitute ("Документ &1 внутреннего возврата с ссылкой на внутренний приход &2. Внутренний приход не найден.", bf_trn-doc.doc-code, bf_trn-doc.out-code).
     8826           end.
     8827           if bf-parent_trn-doc.ext-doc-type <> 'iv':U then do:
     8828             return error substitute ("Документ &1 внутреннего возврата. Родительский документ &2 не является документом внутреннего прихода.", bf_trn-doc.doc-code, bf-parent_trn-doc.doc-code).
     8829           end.
     8830         end.
     8831       end.
     8832       when 'ee':U then do:
     8833         if varhold-doc = "yes":u then do:
     8834           find first bf-contr_clients where bf-contr_clients.obj-type = bf_trn-doc.hold-obj-type and
     8835                                             bf-contr_clients.obj-code = bf_trn-doc.hold-obj-code no-lock.
     8836           if parcurdb-num       = 0                       or
     8837              bf_clients.db-num  = bf-contr_clients.db-num then do:
     8838             find first bf-child_trn-doc where bf-child_trn-doc.hold-doc-code-parent = bf_trn-doc.doc-code no-lock no-error.
     8839           end.
     8840         end.
     8841       end.
     8842       when 'ie':U then do:
     8843         if varhold-doc = "yes":u then do:
     8844           find first bf-contr_clients where bf-contr_clients.obj-type = bf_trn-doc.hold-obj-type and
     8845                                             bf-contr_clients.obj-code = bf_trn-doc.hold-obj-code no-lock.
     8846           if parcurdb-num       = 0                       or
     8847              bf_clients.db-num  = bf-contr_clients.db-num then do:
     8848           end.
     8849         end.
     8850       end.
     8851       when 're':U then do:
     8852         if varhold-doc = "yes":u then do:
     8853           find first bf-contr_clients where bf-contr_clients.obj-type = bf_trn-doc.hold-obj-type and
     8854                                             bf-contr_clients.obj-code = bf_trn-doc.hold-obj-code no-lock.
     8855           if parcurdb-num       = 0                       or
     8856              bf_clients.db-num  = bf-contr_clients.db-num then do:
     8857           end.
     8858         end.
     8859       end.
     8860       when 'ep':U then do:
     8861         if varhold-doc = "yes":u then do:
     8862           find first bf-contr_clients where bf-contr_clients.obj-type = bf_trn-doc.hold-obj-type and
     8863                                             bf-contr_clients.obj-code = bf_trn-doc.hold-obj-code no-lock.
     8864           if parcurdb-num       = 0                       or
     8865              bf_clients.db-num  = bf-contr_clients.db-num then do:
     8866           end.
     8867         end.
     8868       end.
     8869     end case.
     8870   end.
     8871   end procedure.
     8872   procedure lib-trn3_chklinst :
     8873     define  input parameter parhandle   as   handle              no-undo .
     8874     define  input parameter pardoc-code like ub.trn-doc.doc-code no-undo .
     8875     define  input parameter parstatus   as   character           no-undo .
     8876     define output parameter parfact-ok  as   logical             no-undo .
     8877     define variable is-err-unit                as   logical              no-undo .
     8878     define variable clspl-code                 like ub.place.pl-code     no-undo .
     8879     define variable varparts-total-doc-qnty    like ub.parts.qnty        no-undo .
     8880     define variable varparts-total-fact-qnty   like ub.parts.fact-qnty   no-undo .
     8881     define variable vargds-dtl-total-doc-qnty  like ub.gds-dtl.doc-qnty  no-undo .
     8882     define variable vargds-dtl-total-fact-qnty like ub.gds-dtl.fact-qnty no-undo .
     8883     define buffer bf_trn-doc  for ub.trn-doc .
     8884     define buffer bf_doc-line for ub.doc-line .
     8885     define buffer bf_goods    for ub.goods .
     8886     define buffer bf_gds-dtl  for ub.gds-dtl .
     8887     define buffer bf_parts    for ub.parts .
     8888     define buffer bfe_parts   for ub.parts .
     8889     do
     8890     on error undo, return error return-value
     8891     :
     8892       assign
     8893         parfact-ok = yes
     8894       .
     8895       find first bf_trn-doc no-lock where
     8896                  bf_trn-doc.doc-code = pardoc-code .
     8897       for each  bf_doc-line where
     8898                 bf_doc-line.doc-code = pardoc-code
     8899         , first bf_goods no-lock where
     8900                 bf_goods.artic     = bf_doc-line.artic     and
     8901                 bf_goods.prod-code = bf_doc-line.prod-code and
     8902                 bf_goods.prod-type = bf_doc-line.prod-type
     8903       on error undo, return error return-value
     8904       :
     8905         run str/ck-uncli.p
     8906           (
     8907              input bf_doc-line.unit-cli
     8908           ,  input bf_goods.gds-code
     8909           ,  input bf_trn-doc.obj-type
     8910           ,  input bf_trn-doc.obj-code
     8911           ,  input bf_trn-doc.hold-doc-code-parent
     8912           ,  input bf_trn-doc.hold-doc-code-child
     8913           , output is-err-unit
     8914           ) .
     8915         if is-err-unit = yes
     8916         then do:
     8917           run waitfram-hide in parhandle no-error .
     8918           undo, return error substitute( "Ошибочная единица измерения поставщика <<&1>> товара &2 &3 &4 или "
     8919                                        + "нельзя изменять единицу измерения поставщика на данном объекте."
     8920                                        , bf_doc-line.unit-cli
     8921                                        , bf_goods.artic
     8922                                        , bf_goods.prod-type
     8923                                        , bf_goods.prod-code
     8924                                        ) .
     8925         end.
     8926         assign
     8927           vargds-dtl-total-doc-qnty  = 0
     8928           vargds-dtl-total-fact-qnty = 0
     8929         .
     8930         for each bf_gds-dtl where
     8931                  bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     8932                  bf_gds-dtl.prod-code = bf_doc-line.prod-code and
     8933                  bf_gds-dtl.artic     = bf_doc-line.artic     and
     8934                  bf_gds-dtl.doc-code  = bf_trn-doc.doc-code
     8935         on error undo, return error return-value
     8936         :
     8937           if bf_gds-dtl.doc-qnty <> bf_gds-dtl.fact-qnty
     8938           then do:
     8939             assign
     8940               parfact-ok = no
     8941             .
     8942           end.
     8943           assign
     8944             vargds-dtl-total-doc-qnty  = vargds-dtl-total-doc-qnty  + bf_gds-dtl.doc-qnty
     8945             vargds-dtl-total-fact-qnty = vargds-dtl-total-fact-qnty + bf_gds-dtl.fact-qnty
     8946           .
     8947         end.
     8948         assign
     8949           varparts-total-doc-qnty  = 0
     8950           varparts-total-fact-qnty = 0
     8951         .
     8952         assign
     8953           varparts-total-doc-qnty  = 0
     8954           varparts-total-fact-qnty = 0
     8955         .
     8956         for each bfe_parts where
     8957                  bfe_parts.out-code  = bf_trn-doc.doc-code   and
     8958                  bfe_parts.obj-type  = bf_trn-doc.obj-type   and
     8959                  bfe_parts.obj-code  = bf_trn-doc.obj-code   and
     8960                  bfe_parts.prod-type = bf_doc-line.prod-type and
     8961                  bfe_parts.prod-code = bf_doc-line.prod-code and
     8962                  bfe_parts.artic     = bf_doc-line.artic
     8963         on error undo, return error return-value
     8964         :
     8965           if bfe_parts.qnty <> bfe_parts.fact-qnty
     8966           then do:
     8967             assign
     8968               parfact-ok = no
     8969             .
     8970           end.
     8971           assign
     8972             varparts-total-doc-qnty  = varparts-total-doc-qnty  + bfe_parts.qnty
     8973             varparts-total-fact-qnty = varparts-total-fact-qnty + bfe_parts.fact-qnty
     8974           .
     8975         end.
     8976         if parstatus               <> 'факт':U                                      and
     8977            varparts-total-doc-qnty <> bf_doc-line.doc-qnty                         and
     8978            varparts-total-doc-qnty <> 0
     8979         then do:
     8980           run waitfram-hide in parhandle no-error .
     8981           undo, return error substitute( "Артикул : &1 &2 &3 &4 По всем партиям : &5 &6."
     8982                                        , bf_doc-line.artic
     8983                                        , bf_goods.gds-name
     8984                                        , bf_doc-line.doc-qnty
     8985                                        , bf_goods.unit-base
     8986                                        , varparts-total-doc-qnty
     8987                                        , bf_goods.unit-base
     8988                                        ) .
     8989         end.
     8990         if parstatus = 'факт':U and
     8991            varparts-total-fact-qnty <> bf_doc-line.fact-qnty
     8992         then do:
     8993           run waitfram-hide in parhandle no-error .
     8994           undo, return error substitute( "Неправильно заполнены ПАРТИИ. Артикул : &1 &2 &3 &4 . По всем партиям : &5 &6. "
     8995                                        + "Эти количества должны совпадать !"
     8996                                        , bf_doc-line.artic
     8997                                        , bf_goods.gds-name
     8998                                        , bf_doc-line.fact-qnty
     8999                                        , bf_goods.unit-base
     9000                                        , varparts-total-fact-qnty
     9001                                        , bf_goods.unit-base
     9002                                        ) .
     9003         end.
     9004         if parstatus          <> 'факт':U and
     9005            bf_doc-line.prt-OK <> ?       and
     9006            vargds-dtl-total-doc-qnty <> bf_doc-line.doc-qnty
     9007         then do:
     9008           run waitfram-hide in parhandle no-error .
     9009           undo, return error substitute( "Неправильно заполнены количества ПО ШКАЛЕ." + chr(10)
     9010                                        + " Артикул : &1 &2 &3 &4"                     + chr(10)
     9011                                        + "По всем признакам : &5 &6. Эти количества должны совпадать ! "
     9012                                        , bf_doc-line.artic
     9013                                        , bf_goods.gds-name
     9014                                        , bf_doc-line.doc-qnty
     9015                                        , bf_goods.unit-base
     9016                                        , vargds-dtl-total-doc-qnty
     9017                                        , bf_goods.unit-base
     9018                                        ) .
     9019         end.
     9020         if parstatus                  = 'факт':U                and
     9021            vargds-dtl-total-fact-qnty <> bf_doc-line.fact-qnty
     9022         then do:
     9023           run waitfram-hide in parhandle no-error .
     9024           undo, return error substitute( "Неправильно заполнены количества ПО ШКАЛЕ. Артикул : &1 &2 &3 &4 "
     9025                                        + "По всем признакам : &5 &6. Эти количества должны совпадать !"
     9026                                        , bf_doc-line.artic
     9027                                        , bf_goods.gds-name
     9028                                        , bf_doc-line.fact-qnty
     9029                                        , bf_goods.unit-base
     9030                                        , vargds-dtl-total-fact-qnty
     9031                                        , bf_goods.unit-base
     9032                                        ) .
     9033         end.
     9034       end.
     9035     end.
     9036   end procedure.
     9037   define temp-table tt-dis-rule no-undo
     9038   field doc-qnty     like ub.dis-rule.doc-qnty
     9039   field discnt-value like ub.dis-rule.discnt-value
     9040   index pi is unique primary doc-qnty.
     9041   procedure lib-trn3_set-pr :
     9042   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9043   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     9044   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     9045   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     9046   define variable gp-excise     like ub.price-list.excise     no-undo.
     9047   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     9048   define variable gp-fact-order as decimal   no-undo .
     9049   define variable gp-price-sale-parts as decimal   no-undo .
     9050   define input parameter parrec-dtl         as recid     no-undo.
     9051   define input parameter paruse-discnt-qnty as logical   no-undo.
     9052   define input parameter pardiscnt-qnty     as decimal   no-undo.
     9053   define buffer sp_gds-dtl          for ub.gds-dtl .
     9054   define buffer sp_trn-doc          for ub.trn-doc .
     9055   define buffer sp_doc-line         for ub.doc-line.
     9056   define buffer sp_shop             for ub.shop        .
     9057   define buffer sp_goods            for ub.goods       .
     9058   define buffer sp_gds-obj-attr     for ub.gds-obj-attr.
     9059   define buffer sp-parent_dis-rule  for ub.dis-rule.
     9060   define buffer sp-child_dis-rule   for ub.dis-rule.
     9061   define buffer sp_tt-dis-rule      for tt-dis-rule.
     9062   define buffer sp-prev_tt-dis-rule for tt-dis-rule.
     9063   define buffer buf_dis-gds-rule    for ub.dis-gds-rule.
     9064   define variable varr-b               as character no-undo.
     9065   define variable varis-perm           as logical initial no no-undo.
     9066   define variable varprice-target      as character no-undo.
     9067   define variable varprice-target-type as character no-undo.
     9068   define variable vartype              as character no-undo.
     9069   define variable varhave-qnty-discnt  as logical   no-undo.
     9070   define variable  v-main-b-code  as integer   no-undo .
     9071   define variable  v-sum-doc      as decimal   no-undo .
     9072   define variable  v-fact-order   as decimal   no-undo .
     9073   define variable  v-plt-id        as integer   no-undo .
     9074   define variable  v-plt-db-num    as integer   no-undo .
     9075   define variable  v-pdf-id        as integer   no-undo .
     9076   define variable  v-pdf-db-num    as integer   no-undo .
     9077   define variable  v-sale-price-base  as decimal   no-undo .
     9078   define variable  v-sale-price-rubl  as decimal   no-undo .
     9079   define variable  v-road-tax-base    as decimal   no-undo .
     9080   define variable  v-road-tax-rubl    as decimal   no-undo .
     9081   define variable  v-excise-base      as decimal   no-undo .
     9082   define variable  v-excise-rubl      as decimal   no-undo .
     9083   do on error undo, return error return-value :
     9084   assign
     9085     varhave-qnty-discnt = no.
     9086   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     9087   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     9088     (output varr-b
     9089     )  .
     9090   find first sp_gds-dtl where recid(sp_gds-dtl)   =  parrec-dtl.
     9091   find first sp_trn-doc where sp_trn-doc.doc-code = sp_gds-dtl.doc-code.
     9092   find first sp_doc-line where sp_doc-line.doc-code   = sp_gds-dtl.doc-code  and
     9093                                sp_doc-line.artic      = sp_gds-dtl.artic     and
     9094                                sp_doc-line.prod-type  = sp_gds-dtl.prod-type and
     9095                                sp_doc-line.prod-code  = sp_gds-dtl.prod-code .
     9096   find first sp_goods   where sp_goods.artic      = sp_gds-dtl.artic     and
     9097                               sp_goods.prod-type  = sp_gds-dtl.prod-type and
     9098                               sp_goods.prod-code  = sp_gds-dtl.prod-code .
     9099   if ((sp_trn-doc.status_ = 'накл':U or
     9100        sp_trn-doc.status_ = 'разрешен':U) and
     9101        lookup (sp_trn-doc.doc-type, 'рас,спи,возврат':U) > 0 )
     9102        or ( sp_trn-doc.status_ = 'запрос':U )
     9103        or ( sp_trn-doc.status_ = 'разрешен':U and sp_trn-doc.doc-type = 'инв':U )
     9104        then do:
     9105     if sp_trn-doc.ret-supp = no         and
     9106        not sp_gds-dtl.ov                and
     9107        sp_trn-doc.internal              and
     9108        sp_trn-doc.doc-type = 'рас':U and
     9109        sp_trn-doc.status_  = 'накл':U    and
     9110        not sp_trn-doc.flag              then do:
     9111        if sp_trn-doc.cli-type = 'маг':U    then do:
     9112          find sp_shop where sp_shop.obj-code = sp_trn-doc.cli-code no-lock.
     9113          assign
     9114            varis-perm = sp_shop.in-perm.
     9115        end.
     9116        if varis-perm = no then do:
     9117   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input sp_trn-doc.doc-code ,
     9118                           input 'price-target':U ,
     9119                          output varprice-target ,
     9120                          output varprice-target-type )  .
     9121          if varprice-target = "yes":u then do:
     9122            assign
     9123              varis-perm = yes.
     9124          end.
     9125        end.
     9126        if varis-perm then do:
     9127   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9128   gp-fact-order = 0 .
     9129   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     9130     (input  sp_goods.gds-code
     9131     ,input  sp_gds-dtl.prt-code
     9132     ,output gp-b-code
     9133     ) no-error .
     9134   if error-status:error then do:
     9135     message
     9136       error-status :get-message(1) skip
     9137       return-value skip
     9138       view-as alert-box error .
     9139     return error.
     9140   end.
     9141   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9142   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     9143     (input  sp_trn-doc.cli-type
     9144     ,input  sp_trn-doc.cli-code
     9145     ,input  gp-b-code
     9146     ,input  0
     9147     ,input  gp-fact-order
     9148     ,output gp-doc-num
     9149     ,output gp-price-sale
     9150     ,output gp-road-tax
     9151     ,output gp-excise
     9152     ) no-error .
     9153   if error-status:error then do:
     9154     return error.
     9155   end.
     9156   gp-price-sale-parts = gp-price-sale.
     9157   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9158   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     9159     (input  sp_trn-doc.cli-type
     9160     ,input  sp_trn-doc.cli-code
     9161     ,input  gp-b-code
     9162     ,input  0
     9163     ,input  gp-fact-order
     9164     ,output gp-doc-num
     9165     ,output gp-price-sale-parts
     9166     ,output gp-road-tax
     9167     ,output gp-excise
     9168     ) no-error .
     9169   if error-status:error then do:
     9170     return error.
     9171   end.
     9172   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     9173       gp-price-sale = gp-price-sale-parts.
     9174    end.
     9175          if gp-price-sale <> ? then do:
     9176            if varr-b = "rubl":u then do:
     9177              assign
     9178                sp_gds-dtl.price-rubl = gp-price-sale.
     9179            end.
     9180            else do:
     9181              assign
     9182                sp_gds-dtl.price-base = gp-price-sale.
     9183            end.
     9184            assign
     9185            sp_doc-line.excise      = gp-excise
     9186            sp_doc-line.road-tax    = gp-road-tax
     9187            sp_gds-dtl.ov           = yes.
     9188          end.
     9189          else do:
     9190            message substitute (" Неизвестна цена товара &1 &2 по &3 &4 Товар будет перемещен по цене текущего объекта &5 &6.",
     9191                                     sp_goods.artic,
     9192                                     sp_goods.gds-name,
     9193                                     sp_trn-doc.cli-type,
     9194                                     sp_trn-doc.cli-code,
     9195                                     sp_trn-doc.obj-type,
     9196                                     sp_trn-doc.obj-code)
     9197            view-as alert-box information.
     9198          end.
     9199        end.
     9200     end.
     9201     if sp_trn-doc.ret-supp = yes      then do:
     9202       if not sp_gds-dtl.ov              and
     9203          (sp_trn-doc.status_  = 'накл':U  and
     9204           not sp_trn-doc.flag            or
     9205           sp_trn-doc.status_ = 'разрешен':U) then do:
     9206         if varr-b = "rubl":u then do:
     9207           assign
     9208             sp_gds-dtl.price-rubl = ?.
     9209         end.
     9210         else do:
     9211           assign
     9212             sp_gds-dtl.price-base = ?.
     9213         end.
     9214         IF sp_doc-line.transport-base = ? then ASSIGN sp_doc-line.transport-base = 0.
     9215         IF sp_doc-line.transport-rubl = ? then ASSIGN sp_doc-line.transport-rubl = 0.
     9216         IF sp_doc-line.other-base = ?     then ASSIGN sp_doc-line.other-base     = 0.
     9217         IF sp_doc-line.other-rubl = ?     then ASSIGN sp_doc-line.other-rubl     = 0.
     9218         if varr-b = "rubl":u then do:
     9219           assign sp_gds-dtl.price-rubl = sp_doc-line.price-rubl - sp_doc-line.transport-rubl - sp_doc-line.other-rubl.
     9220         end.
     9221         else do:
     9222           assign sp_gds-dtl.price-base = sp_doc-line.price-base - sp_doc-line.transport-base - sp_doc-line.other-base.
     9223         end.
     9224         assign
     9225           sp_doc-line.excise   = 0
     9226           sp_doc-line.road-tax = 0.
     9227       end.
     9228     end.
     9229     else do:
     9230   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9231   gp-fact-order = 0 .
     9232   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     9233     (input  sp_goods.gds-code
     9234     ,input  sp_gds-dtl.prt-code
     9235     ,output gp-b-code
     9236     ) no-error .
     9237   if error-status:error then do:
     9238     message
     9239       error-status :get-message(1) skip
     9240       return-value skip
     9241       view-as alert-box error .
     9242     return error.
     9243   end.
     9244   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9245   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     9246     (input  sp_gds-dtl.obj-type
     9247     ,input  sp_gds-dtl.obj-code
     9248     ,input  gp-b-code
     9249     ,input  0
     9250     ,input  gp-fact-order
     9251     ,output gp-doc-num
     9252     ,output gp-price-sale
     9253     ,output gp-road-tax
     9254     ,output gp-excise
     9255     ) no-error .
     9256   if error-status:error then do:
     9257     return error.
     9258   end.
     9259   gp-price-sale-parts = gp-price-sale.
     9260   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9261   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     9262     (input  sp_gds-dtl.obj-type
     9263     ,input  sp_gds-dtl.obj-code
     9264     ,input  gp-b-code
     9265     ,input  0
     9266     ,input  gp-fact-order
     9267     ,output gp-doc-num
     9268     ,output gp-price-sale-parts
     9269     ,output gp-road-tax
     9270     ,output gp-excise
     9271     ) no-error .
     9272   if error-status:error then do:
     9273     return error.
     9274   end.
     9275   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     9276       gp-price-sale = gp-price-sale-parts.
     9277    end.
     9278       if sp_trn-doc.ext-doc-type = 'ee':U then do:
     9279          run factord-end-day in this-procedure (input sp_trn-doc.doc-date , output v-fact-order ).
     9280   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     9281     (input  sp_goods.gds-code
     9282     ,input  ?
     9283     ,output v-main-b-code
     9284     )  .
     9285           run str/set-mppr.p (
     9286              input  true
     9287             ,input  sp_trn-doc.cli-type
     9288             ,input  sp_trn-doc.cli-code
     9289             ,input  v-main-b-code
     9290             ,input  gp-b-code
     9291             ,input  sp_trn-doc.obj-type
     9292             ,input  sp_trn-doc.obj-code
     9293             ,input  ( if pardiscnt-qnty = 0 or pardiscnt-qnty = ? then sp_gds-dtl.fact-qnty else pardiscnt-qnty )
     9294             ,input  0
     9295             ,input  string(sp_trn-doc.pay-code)
     9296             ,input  ""
     9297             ,input  v-fact-order
     9298             ,output sp_gds-dtl.plt-id
     9299             ,output sp_gds-dtl.plt-db-num
     9300             ,output sp_gds-dtl.pdf-id
     9301             ,output sp_gds-dtl.pdf-db
     9302             ,output v-sale-price-base
     9303             ,output v-sale-price-rubl
     9304             ,output v-road-tax-base
     9305             ,output v-road-tax-rubl
     9306             ,output v-excise-base
     9307             ,output v-excise-rubl
     9308             ) .
     9309           if varr-b = "rubl":u then do:
     9310               assign
     9311                 gp-excise     = v-excise-rubl
     9312                 gp-road-tax   = v-road-tax-rubl
     9313                 gp-price-sale = v-sale-price-rubl
     9314               .
     9315           end.
     9316           else do:
     9317               assign
     9318                 gp-excise     = v-excise-base
     9319                 gp-road-tax   = v-road-tax-base
     9320                 gp-price-sale = v-sale-price-base
     9321               .
     9322           end.
     9323       end.
     9324       if sp_trn-doc.ext-doc-type = 'ee':U and
     9325          not sp_gds-dtl.ov                            then do:
     9326         find first buf_dis-gds-rule no-lock where
     9327                   buf_dis-gds-rule.obj-type = sp_gds-dtl.obj-type
     9328               and buf_dis-gds-rule.obj-code = sp_gds-dtl.obj-code
     9329               and buf_dis-gds-rule.gds-code = sp_goods.gds-code
     9330               and buf_dis-gds-rule.pos-type = '-':U
     9331               and buf_dis-gds-rule.discnt-role = 'pcnt-qnty':U no-error.
     9332         if available buf_dis-gds-rule then do:
     9333           assign
     9334             varhave-qnty-discnt = yes.
     9335           find first sp-parent_dis-rule where sp-parent_dis-rule.rule-num = buf_dis-gds-rule.rule-num.
     9336           for each sp_tt-dis-rule :
     9337             delete sp_tt-dis-rule.
     9338           end.
     9339           for each sp-child_dis-rule where sp-child_dis-rule.upper-rule-num = sp-parent_dis-rule.rule-num on error undo, return error return-value :
     9340             create sp_tt-dis-rule.
     9341             assign
     9342               sp_tt-dis-rule.doc-qnty     = sp-child_dis-rule.doc-qnty
     9343               sp_tt-dis-rule.discnt-value = sp-child_dis-rule.discnt-value
     9344             .
     9345           end.
     9346           if paruse-discnt-qnty then do:
     9347             find last sp_tt-dis-rule where sp_tt-dis-rule.doc-qnty <= pardiscnt-qnty use-index pi no-error.
     9348           end.
     9349           else do:
     9350             find last sp_tt-dis-rule where sp_tt-dis-rule.doc-qnty <= sp_doc-line.fact-qnty use-index pi no-error.
     9351           end.
     9352           if available sp_tt-dis-rule then do:
     9353             assign
     9354               varhave-qnty-discnt = yes.
     9355               gp-price-sale       = gp-price-sale * (1 - sp_tt-dis-rule.discnt-value / 100 ).
     9356           end.
     9357         end.
     9358       end.
     9359       if not sp_gds-dtl.ov   or
     9360          varhave-qnty-discnt then do:
     9361         if gp-price-sale <> ? then do:
     9362           if varr-b = "rubl":u then do:
     9363             assign
     9364              sp_doc-line.excise    = gp-excise
     9365              sp_doc-line.road-tax  = gp-road-tax
     9366              sp_gds-dtl.price-rubl = gp-price-sale.
     9367           end.
     9368           else do:
     9369             assign
     9370              sp_doc-line.excise    = gp-excise
     9371              sp_doc-line.road-tax  = gp-road-tax
     9372              sp_gds-dtl.price-base = gp-price-sale.
     9373           end.
     9374         end.
     9375       end.
     9376     end.
     9377   end.
     9378   if varr-b = "base":u then do:
     9379     if sp_gds-dtl.ov and
     9380        sp_trn-doc.print-rubl then do:
     9381       assign
     9382         sp_gds-dtl.price-base = sp_gds-dtl.price-rubl / sp_trn-doc.base-rate * sp_trn-doc.base-scale.
     9383     end.
     9384     else do:
     9385       assign
     9386         sp_gds-dtl.price-rubl = sp_gds-dtl.price-base * sp_trn-doc.base-rate / sp_trn-doc.base-scale.
     9387     end.
     9388   end.
     9389   else do:
     9390     if sp_gds-dtl.ov and
     9391        not sp_trn-doc.print-rubl then do:
     9392       assign
     9393         sp_gds-dtl.price-rubl = sp_gds-dtl.price-base * sp_trn-doc.base-rate / sp_trn-doc.base-scale.
     9394     end.
     9395     else do:
     9396       assign
     9397         sp_gds-dtl.price-base = sp_gds-dtl.price-rubl / sp_trn-doc.base-rate * sp_trn-doc.base-scale.
     9398     end.
     9399   end.
     9400   end.
     9401   end procedure.
     9402   procedure lib-trn3_rsrplgds :
     9403     define input parameter pardoc-code like ub.trn-doc.doc-code no-undo .
     9404     define buffer bf_trn-doc  for ub.trn-doc .
     9405     define buffer bf_doc-line for ub.doc-line .
     9406     define buffer bf_goods    for ub.goods .
     9407     define buffer bf_doc-pl   for ub.doc-pl .
     9408     define buffer bf_parts    for ub.parts .
     9409     define buffer bf_place    for ub.place .
     9410     define buffer bf_pl-gds   for ub.pl-gds .
     9411     define variable clsreserv-pl-code as   logical          no-undo .
     9412     define variable clspl-code        like ub.place.pl-code no-undo .
     9413     do
     9414     on error undo, return error return-value
     9415     :
     9416       find first bf_trn-doc no-lock where
     9417                  bf_trn-doc.doc-code = pardoc-code .
     9418       for each bf_doc-line where
     9419                bf_doc-line.doc-code = pardoc-code
     9420       on error undo, return error return-value
     9421       :
     9422         find first bf_goods no-lock where
     9423                    bf_goods.artic      = bf_doc-line.artic     and
     9424                    bf_goods.prod-code  = bf_doc-line.prod-code and
     9425                    bf_goods.prod-type  = bf_doc-line.prod-type .
     9426         run plgdsfnd in this-procedure
     9427           (  input no
     9428           ,  input bf_doc-line.obj-type
     9429           ,  input bf_doc-line.obj-code
     9430           ,  input bf_goods.gds-code
     9431           , output clsreserv-pl-code
     9432           , output clspl-code
     9433           ) no-error .
     9434         if error-status :error
     9435         then do:
     9436           undo, return error substitute( "Ошибка при выборе складского места для товара &1 &2 &3 &4 ."
     9437                                        , bf_goods.artic
     9438                                        , bf_goods.prod-type
     9439                                        , bf_goods.prod-code
     9440                                        , return-value
     9441                                        ) .
     9442         end.
     9443         if clsreserv-pl-code = yes
     9444         then do:
     9445           for each bf_parts where
     9446                    bf_parts.obj-type  = bf_trn-doc.obj-type   and
     9447                    bf_parts.obj-code  = bf_trn-doc.obj-code   and
     9448                    bf_parts.artic     = bf_doc-line.artic     and
     9449                    bf_parts.prod-type = bf_doc-line.prod-type and
     9450                    bf_parts.prod-code = bf_doc-line.prod-code and
     9451                    bf_parts.out-code  = bf_doc-line.doc-code
     9452           on error undo, return error return-value :
     9453             if bf_parts.pl-code = 0 or
     9454                bf_parts.pl-code = ?
     9455             then do:
     9456               undo, return error substitute( "lib-trn3_rsrplgds: Не указан код места хранения в партии по товару: &1 &2 &3."
     9457                                            , bf_goods.artic
     9458                                            , bf_goods.prod-type
     9459                                            , bf_goods.prod-code
     9460                                            ) .
     9461             end.
     9462             find first bf_place no-lock where
     9463                        bf_place.obj-type = bf_parts.obj-type and
     9464                        bf_place.obj-code = bf_parts.obj-code and
     9465                        bf_place.pl-code  = bf_parts.pl-code  no-error .
     9466             if not available bf_place
     9467             then do:
     9468               undo, return error substitute( "lib-trn3_rsrplgds: Неверно указан код места хранения в партии '
     9469                                            + 'по товару: &1 &2 &3."
     9470                                            , bf_goods.artic
     9471                                            , bf_goods.prod-type
     9472                                            , bf_goods.prod-code
     9473                                            ) .
     9474             end.
     9475             find first bf_pl-gds no-lock where
     9476                        bf_pl-gds.obj-type = bf_parts.obj-type and
     9477                        bf_pl-gds.obj-code = bf_parts.obj-code and
     9478                        bf_pl-gds.pl-code  = bf_parts.pl-code  and
     9479                        bf_pl-gds.gds-code = bf_goods.gds-code no-error .
     9480             if not available bf_pl-gds
     9481             then do:
     9482               find first bf_pl-gds no-lock where
     9483                          bf_pl-gds.obj-type = bf_parts.obj-type and
     9484                          bf_pl-gds.obj-code = bf_parts.obj-code and
     9485                          bf_pl-gds.pl-code  = bf_parts.pl-code  no-error .
     9486               undo, return error substitute( "lib-trn3_rsrplgds: Неверно указан код места хранения в партии "
     9487                                            + "по товару: &1 &2 &3. На указанном месте хранится товар с кодом &4."
     9488                                            , bf_goods.artic
     9489                                            , bf_goods.prod-type
     9490                                            , bf_goods.prod-code
     9491                                            , ( if available bf_pl-gds then bf_pl-gds.gds-code else 0 )
     9492                                            ) .
     9493             end.
     9494             find first bf_doc-pl no-lock where
     9495                        bf_doc-pl.obj-type = bf_doc-line.obj-type and
     9496                        bf_doc-pl.obj-code = bf_doc-line.obj-code and
     9497                        bf_doc-pl.pl-code  = bf_parts.pl-code     and
     9498                        bf_doc-pl.out-code = bf_doc-line.doc-code and
     9499                        bf_doc-pl.gds-code = bf_goods.gds-code    no-error .
     9500             if not available bf_doc-pl
     9501             then do:
     9502               undo, return error substitute( "lib-trn3_rsrplgds: Не найден doc-pl по товару: &1 &2 &3, место хранения &4 . "
     9503                                            , bf_goods.artic
     9504                                            , bf_goods.prod-type
     9505                                            , bf_goods.prod-code
     9506                                            , bf_parts.pl-code
     9507                                            ) .
     9508             end.
     9509           end.
     9510         end.
     9511       end.
     9512     end.
     9513   end procedure.
     9514   procedure lib-trn3_purchcon :
     9515     do
     9516     on error undo, return error return-value
     9517     :
     9518   define input  parameter p-host-code      as integer   no-undo .
     9519   define input  parameter p-contract-code  as integer   no-undo .
     9520   define output parameter varpurch-code    as character no-undo .
     9521   define output parameter varpurch-code-name as character no-undo .
     9522   define buffer bf_contract for ub.contract  .
     9523     find first bf_contract where bf_contract.host-code     = p-host-code     and
     9524                                  bf_contract.contract-code = p-contract-code no-lock.
     9525     if lookup (bf_contract.contract-type, 'Купли-продажи,Агентский договор,Давальческого сырья,Продажи через ТПСИ':U) > 0 then do:
     9526           assign
     9527         varpurch-code-name = entry (lookup ('1':U, '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U)
     9528         varpurch-code      = '1':U
     9529         .
     9530     end.
     9531     else do:
     9532       if lookup (bf_contract.contract-type, 'Консигнации':U) > 0 then do:
     9533               assign
     9534           varpurch-code-name = entry (lookup ('2':U, '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U)
     9535           varpurch-code      = '2':U
     9536           .
     9537       end.
     9538       else do:
     9539         if lookup (bf_contract.contract-type, 'Ответственного хранения':U) > 0 then do:
     9540                   assign
     9541             varpurch-code-name = entry (lookup ('3':U, '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U)
     9542             varpurch-code      = '3':U
     9543             .
     9544         end.
     9545         else do:
     9546           message "Нельзя определить по договору " bf_contract.contract-prn-code  bf_contract.contract-code " с типом " bf_contract.contract-type " тип приобретения для партий накладной."
     9547           view-as alert-box error.
     9548           return error.
     9549         end.
     9550       end.
     9551     end.
     9552     end.
     9553   end procedure.
     9554   procedure lib-trn3_ch-amin :
     9555   define input parameter p-obj-type  like ub.trn-doc.obj-type no-undo.
     9556   define input parameter p-obj-code  like ub.trn-doc.obj-code no-undo.
     9557   define input parameter p-gds-code  like ub.goods.gds-code no-undo.
     9558   define input parameter p-mess      as logical   no-undo .
     9559   define output parameter  v-flag as logical   no-undo init false .
     9560   define variable v-flag1 as decimal   no-undo .
     9561   define variable v-flag2 as decimal   no-undo .
     9562   define buffer buf_gds-obj-prop for ub.gds-obj-prop.
     9563   define buffer buf_gds-obj      for ub.gds-obj.
     9564   define buffer buf_goods for ub.goods.
     9565     do
     9566     on error undo, return error return-value
     9567     :
     9568     v-flag = false  .
     9569       for each buf_gds-obj-prop no-lock where
     9570               buf_gds-obj-prop.obj-type = p-obj-type and
     9571               buf_gds-obj-prop.obj-code = p-obj-code and
     9572               buf_gds-obj-prop.gds-code = p-gds-code and
     9573               buf_gds-obj-prop.gdop-assort-min = true ,
     9574         first buf_gds-obj no-lock where
     9575               buf_gds-obj.obj-type = p-obj-type and
     9576               buf_gds-obj.obj-code = p-obj-code and
     9577               buf_gds-obj.gds-code = p-gds-code and
     9578               buf_gds-obj-prop.gdop-min-stock > buf_gds-obj.fact-qnty :
     9579            v-flag = true .
     9580            v-flag1 =  buf_gds-obj-prop.gdop-min-stock.
     9581            v-flag2 =  buf_gds-obj.fact-qnty          .
     9582       end.
     9583       if v-flag = true then do:
     9584          if p-mess then do:
     9585            find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     9586            message
     9587               "В документе есть товары , фактический остаток которых меньше минимального запаса ! " skip
     9588               "Например   :" skip
     9589               "Товар      :" buf_goods.gds-name skip
     9590               "Артикул    :" buf_goods.artic skip
     9591               "На объекте :" p-obj-type p-obj-code skip
     9592               "Минимальный остаток :" v-flag1  skip
     9593               "Фактический остаток :" v-flag2
     9594               view-as alert-box information
     9595               title "ВНИМАНИЕ !!!"
     9596               .
     9597          end.
     9598       end.
     9599     end.
     9600   end procedure.
     9601   procedure lib-trn3_chkinvln :
     9602     define  input parameter p-doc-code  like ub.inv-line.doc-code   no-undo.
     9603     define  input parameter p-artic     like ub.inv-line.artic      no-undo.
     9604     define  input parameter p-prod-type like ub.inv-line.prod-type  no-undo.
     9605     define  input parameter p-prod-code like ub.inv-line.prod-code  no-undo.
