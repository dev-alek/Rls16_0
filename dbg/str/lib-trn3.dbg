     1935   assign
     1936     varsum-base-factovpcl     = 0
     1937     varslt-base-factovpcl     = 0
     1938     varvat-base-factovpcl     = 0
     1939     varvatcons-base-factovpcl = 0
     1940     vardsc-base-factovpcl     = 0
