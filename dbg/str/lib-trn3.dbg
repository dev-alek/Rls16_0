     3852               .
     3853             end.
     3854           end.
     3855           when 'trn-reas-sug':U then do:
     3856             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     3857               assign
     3858                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
     3859               .
     3860             end.
     3861           end.
     3862                 when 'rvd-own-nb':U then do:
     3863             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
