     9727   define temp-table tt-doc-line no-undo like ub.doc-line.
     9728   procedure lib-trn3_chkgdsd:
     9729   define input parameter parrec-doc as recid no-undo.
     9730   define input parameter parrec-gds as recid no-undo.
