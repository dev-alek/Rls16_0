    10124   define buffer bf_trn-doc for ub.trn-doc .
    10125     define buffer bf_shift-obj for ub.shift-obj .
    10126     Main-Block:
    10127     do on error undo Main-Block, return error return-value :
    10128   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10129   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    10130     (input  p-obj-type
