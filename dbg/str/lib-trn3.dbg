     5489   procedure lib-trn3_add-scal :
     5490     define input parameter parparentproc as widget-handle no-undo .
     5491     define input parameter p-obj-type   like ub.clients.obj-type no-undo .
     5492     define input parameter p-obj-code   like ub.clients.obj-code no-undo .
     5493     define input parameter d-c like ub.trn-doc.doc-code no-undo .
     5494     define input parameter p-doc-type as character no-undo .
     5495     define input parameter p-add-scal-handle as   handle           no-undo.
     5496     define buffer as_doc-line   for ub.doc-line.
     5497     define buffer as_price-list for ub.price-list.
     5498     define buffer as_goods      for ub.goods.
     5499     define buffer as_bar-code   for ub.bar-code.
     5500     define buffer as_scales     for ub.scales.
     5501     define buffer as_scales-gds for ub.scales-gds.
     5502     define buffer as_scales-grp for ub.scales-grp.
     5503     define buffer as_units      for ub.units.
     5504     define buffer as_gds-prt    for ub.gds-prt.
     5505     define buffer as_gds-obj    for ub.gds-obj.
     5506     define variable ii as integer no-undo .
     5507     define variable conf-attr as character no-undo .
     5508     define variable conf-par as character no-undo .
     5509     define variable par-type as character no-undo .
     5510     define variable v-obj-db-num like ub.db.db-num no-undo .
     5511     define variable sclin-ld as integer no-undo .
     5512     define variable v-last-date as date no-undo .
     5513     define variable v-b-code like ub.bar-code.b-code no-undo .
     5514     define variable v-param-type as character no-undo .
     5515     define variable v-value-character as character no-undo .
     5516     define variable v-value-date as date no-undo .
     5517     define variable v-value-decimal as decimal no-undo .
     5518     define variable v-value-integer as INTEGER no-undo .
     5519     define variable v-value-logical AS LOGICAL no-undo .
     5520     define variable v-tth as handle no-undo .
     5521     define variable scallist as character no-undo .
     5522     define buffer buf_trn-doc  for ub.trn-doc.
     5523     define buffer buf_price-doc  for ub.price-doc.
     5524     define buffer buf_parts for ub.parts.
     5525     define buffer buf_temp-add-scal for temp-add-scal.
     5526   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5527   define variable v-param-type39 as character no-undo .
     5528   define variable v-value-character39 as character no-undo .
     5529   define variable v-value-date39 as date no-undo .
     5530   define variable v-value-decimal39 as decimal no-undo .
     5531   define variable v-value-logical39 AS LOGICAL no-undo .
     5532   define variable v-tth39 as handle no-undo .
     5533   run adm/shattri.p (
     5534       input "get":U
     5535       ,input  p-obj-type
     5536       ,input  p-obj-code
     5537       ,input  'scale-inf':U
     5538       ,input  'sclin-ld':U
     5539       ,output v-value-character39
     5540       ,output v-value-date39
     5541       ,output v-value-decimal39
     5542       ,output sclin-ld
     5543       ,output v-value-logical39
     5544       ,output v-param-type39
     5545       ,INPUT-OUTPUT table-handle v-tth39
     5546       )  .
