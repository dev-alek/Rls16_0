     3029                 varprice-sale = 0
     3030                 varroad-tax   = 0
     3031                 varexcise     = 0
     3032               .
     3033             end.
     3034             assign
     3035               varlastcur-base     = varprice-sale
     3036               varlastcur-road-tax = varroad-tax
     3037               varlastcur-excise   = varexcise
     3038               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3039               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3040               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3041               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3042             .
     3043         end.
     3044       end.
     3045       if varcur-fact-qnty = 0 then do:
     3046         assign
     3047           varcur-base      = varlastcur-base
     3048           varcur-road-tax  = varlastcur-road-tax
     3049           varcur-excise    = varlastcur-excise
     3050         .
     3051       end.
     3052       else do:
     3053         assign
     3054           varcur-base      = varcur-base      / varcur-fact-qnty
     3055           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3056           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3057         .
     3058       end.
     3059       if varcur-vat-pc = ?
     3060       then do:
     3061         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3062       end.
