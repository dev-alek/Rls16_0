     3880               .
     3881             end.
     3882           end.
     3883         end case.
     3884         delete thbjattr_thbj-attr .
     3885       end.
     3886     end.
     3887     return .
     3888   end procedure.
     3889   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3890   procedure gds-attr-name :
