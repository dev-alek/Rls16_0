     3301   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3302   def var vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3303   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     3304   procedure disrules-fill-properties:
     3305   define input  parameter p-templ-rl-root as integer   no-undo .
     3306   define buffer buf_drt-prop for ub.drt-prop.
     3307   define buffer buf_temp-drt-prop for temp-drt-prop.
     3308   do
     3309   on error undo, return error return-value
     3310   :
     3311     for each buf_temp-drt-prop:
     3312       delete buf_temp-drt-prop.
     3313     end.
     3314     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     3315       create buf_temp-drt-prop.
     3316       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     3317     end.
     3318   end.
     3319   end procedure.
     3320   ~
     3321   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3322   procedure discfgru-check :
     3323   define input parameter p-table-name as character no-undo .
     3324   define input parameter p-templ-rl-root as integer no-undo .
     3325   define input parameter p-time-templ-rl-root as integer no-undo .
     3326   define input parameter p-pos-type as character no-undo .
     3327   define output parameter p-disnct-role as character no-undo .
     3328   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     3329     do
     3330     on error undo, return error return-value
     3331     :
     3332       find first buf_dis-cfg-rule no-lock where
     3333               buf_dis-cfg-rule.table-name = p-table-name
     3334           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     3335           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     3336           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     3337       if not available buf_dis-cfg-rule
     3338       or p-pos-type = "":U
     3339       then do:
     3340          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     3341                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     3342                                  , p-templ-rl-root
     3343                                  , (if p-time-templ-rl-root = ?
     3344                                     then '':U
     3345                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     3346                                     )
     3347                                  ).
     3348       end.
     3349       assign
     3350       p-disnct-role = buf_dis-cfg-rule.discnt-role
     3351       .
     3352     end.
     3353   end procedure.
     3354   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3355   FUNCTION get-region RETURNS CHARACTER
     3356     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     3357     define variable par-region as character no-undo.
     3358     if parhost-code = 0 and
     3359          parobj-type = "":U and
     3360          parobj-code = 0 then do:
     3361          par-region = "Глобально".
     3362          return par-region.
     3363       end.
     3364       if parobj-type = 'орг':U then do:
     3365          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     3366          return par-region.
     3367       end.
     3368       if parobj-type = 'регион':U
     3369       then do:
     3370          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     3371          return par-region.
     3372       end.
     3373       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     3374       return par-region.
     3375   END FUNCTION.
     3376   FUNCTION get-objregion RETURNS CHARACTER
     3377     (  input parobj-type as character, input parobj-code as integer ) :
     3378     define variable par-region as character no-undo.
     3379     if  parobj-type = "":U and
     3380         parobj-code = 0
     3381     then do:
     3382        par-region = "Глобально".
     3383     end.
     3384     else if parobj-type = 'орг':U
     3385     then do:
     3386        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     3387     end.
     3388     else if parobj-type = 'регион':U
     3389     then do:
     3390        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     3391     end.
     3392     else
     3393        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     3394     return par-region.
     3395   END FUNCTION.
     3396   procedure disgdsru-name :
     3397   define buffer buf_dis-rule for ub.dis-rule.
     3398   do
     3399     on error undo, return error
     3400     :
     3401     define input  parameter p-templ-rl-root  as integer no-undo .
     3402     define output parameter p-label          as character no-undo .
     3403     find first buf_dis-rule no-lock where
     3404               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     3405     if available buf_dis-rule
     3406     then do:
     3407       if buf_dis-rule.rule-num > 0 then
     3408       p-label = buf_dis-rule.des.
     3409     end.
     3410     else do:
     3411       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     3412     end.
     3413   end.
     3414   end procedure.
     3415   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     3416   define variable v-rule-label as character no-undo .
     3417   run disgdsru-name in this-procedure ( input p-templ-rl-root
     3418                                        ,output v-rule-label) no-error.
     3419   return v-rule-label.
     3420   end function.
     3421   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     3422   define variable v-rule-label as character no-undo .
     3423   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     3424   end function.
     3425   procedure disgdsru-write :
     3426     do
     3427     on error undo, return error
     3428     :
     3429       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     3430       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     3431       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     3432       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     3433       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     3434       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     3435       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     3436       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     3437       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     3438       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     3439       define buffer buf_dis-rule for ub.dis-rule.
     3440       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     3441       define variable v-label          as character no-undo .
     3442       define variable v-discnt-role as character no-undo .
     3443       run discfgru-check in this-procedure (
     3444                                             input 'dis-gds-rule':U
     3445                                            ,input p-templ-rl-root
     3446                                            ,input p-time-templ-rl-root
     3447                                            ,input p-pos-type
     3448                                            ,output v-discnt-role
     3449                                             ) no-error .
     3450       if error-status :error then do:
     3451         undo, return error return-value .
     3452       end.
     3453       if p-discnt-role = ? then do:
     3454         p-discnt-role = v-discnt-role.
     3455       end.
     3456       if p-discnt-role <> v-discnt-role then do:
     3457         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     3458                                 ,p-gds-code
     3459                                 ,p-obj-type
     3460                                 ,p-obj-code
     3461                                 ,p-pos-type
     3462                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     3463                                 ,chr(10)
     3464                                 ,p-templ-rl-root
     3465                                 ,p-rule-num).
     3466       end.
     3467       if p-pos-type = ? then do:
     3468   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3469   define variable v-param-type26 as character no-undo .
     3470   define variable v-value-date26 as date no-undo .
     3471   define variable v-value-decimal26 as decimal no-undo .
     3472   define variable v-value-integer26 as INTEGER no-undo .
     3473   define variable v-value-logical26 AS LOGICAL no-undo .
     3474   define variable v-tth26 as handle no-undo .
     3475   run adm/shattri.p (
     3476       input "get":U
     3477       ,input  p-obj-type
     3478       ,input  p-obj-code
     3479       ,input  'cd-sending':U
     3480       ,input  'dflt-cd':U
     3481       ,output p-pos-type
     3482       ,output v-value-date26
     3483       ,output v-value-decimal26
     3484       ,output v-value-integer26
     3485       ,output v-value-logical26
     3486       ,output v-param-type26
     3487       ,INPUT-OUTPUT table-handle v-tth26
     3488       )  .
     3489   delete object v-tth26 no-error.
     3490       end.
     3491       find first buf_dis-rule no-lock where
     3492                 buf_dis-rule.rule-num = p-rule-num no-error.
     3493       if not available buf_Dis-rule then do:
     3494         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     3495                                 ,p-gds-code
     3496                                 ,p-obj-type
     3497                                 ,p-obj-code
     3498                                 ,p-pos-type
     3499                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     3500                                 ,chr(10)
     3501                                 ,p-rule-num).
     3502       end.
     3503       if buf_dis-rule.root <> yes then do:
     3504         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     3505                                 ,p-gds-code
     3506                                 ,p-obj-type
     3507                                 ,p-obj-code
     3508                                 ,p-pos-type
     3509                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     3510                                 ,chr(10)
     3511                                 ,p-rule-num).
     3512       end.
     3513       if not (p-obj-type = buf_dis-rule.obj-type
     3514           and p-obj-code = buf_dis-rule.obj-code)
     3515       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     3516                and
     3517                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     3518        then do:
     3519         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     3520                                 ,p-gds-code
     3521                                 ,p-obj-type
     3522                                 ,p-obj-code
     3523                                 ,p-pos-type
     3524                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     3525                                 ,chr(10)
     3526                                 ) +
     3527                             substitute("Правило скидки &1 определено для &2&3" +
     3528                                        "а привязка к товару для &4"
     3529                                        ,buf_dis-rule.rule-num
     3530                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     3531                                        ,chr(10)
     3532                                        ,get-objregion( p-obj-type, p-obj-code)
     3533                                        ))
     3534                                 .
     3535       end.
     3536       find first buf_dis-gds-rule exclusive-lock where
     3537                  buf_dis-gds-rule.gds-code  = p-gds-code
     3538              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     3539              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     3540              AND buf_dis-gds-rule.pos-type  = p-pos-type
     3541              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     3542              and buf_dis-gds-rule.nonunique = p-nonunique
     3543              no-error .
     3544       if not available buf_dis-gds-rule then do:
     3545         find first buf_dis-gds-rule exclusive-lock where
     3546                   buf_dis-gds-rule.gds-code  = p-gds-code
     3547               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     3548               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     3549               AND buf_dis-gds-rule.pos-type  = p-pos-type
     3550               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     3551               no-error .
     3552         if available buf_Dis-gds-rule then do:
     3553           if p-nonunique = ''
     3554           and available buf_dis-gds-rule
     3555           then do:
     3556             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     3557                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     3558                                      , p-gds-code
     3559                                      , buf_Dis-rule.obj-type
     3560                                      , buf_Dis-rule.obj-code
     3561                                      , p-nonunique
     3562                                     ).
     3563           end.
     3564           if available buf_dis-gds-rule
     3565           and buf_dis-gds-rule.nonunique = ''
     3566           and p-nonunique <> ''then do:
     3567             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     3568                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     3569                                      , p-gds-code
     3570                                      , buf_Dis-rule.obj-type
     3571                                      , buf_Dis-rule.obj-code
     3572                                     ).
     3573           end.
     3574         end.
     3575         create buf_dis-gds-rule .
     3576         assign
     3577         buf_dis-gds-rule.gds-code  = p-gds-code
     3578         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     3579         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     3580         buf_dis-gds-rule.pos-type = p-pos-type
     3581         buf_dis-gds-rule.discnt-role = v-discnt-role
     3582         buf_dis-gds-rule.rule-num = p-rule-num
     3583         buf_dis-gds-rule.nonunique = p-nonunique
     3584         no-error
     3585         .
     3586       end.
     3587       ASSIGN
     3588       buf_dis-gds-rule.rule-num = p-rule-num
     3589       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     3590       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     3591       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     3592       buf_dis-gds-rule.nonunique = p-nonunique
     3593       no-error.
     3594     end.
     3595   end procedure.
     3596   PROCEDURE cmp-disgdsru-write :
     3597   do
     3598   on error undo, return error
     3599   :
     3600     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     3601     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     3602     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     3603     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     3604     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     3605     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     3606     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     3607     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     3608     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     3609     define variable v-rule-label          as character no-undo .
     3610     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     3611     define buffer buf_dis-rule     for ub.dis-rule.
     3612     run disgdsru-name in this-procedure (
     3613                                         input  p-templ-rl-root
     3614                                         ,output v-rule-label
     3615                                         ) no-error .
     3616     if error-status :error then do:
     3617       undo, return error return-value .
     3618     end.
     3619     find first buf_tt0-dis-gds-rule exclusive-lock where
     3620                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     3621             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     3622             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     3623             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     3624             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     3625             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     3626             no-error .
     3627     if not available buf_tt0-dis-gds-rule then do:
     3628       create buf_tt0-dis-gds-rule .
     3629       assign
     3630       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     3631       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     3632       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     3633       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     3634       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     3635       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     3636       no-error
     3637       .
     3638     end.
     3639     find first buf_dis-rule no-lock where
     3640               buf_dis-rule.rule-num = p-rule-num.
     3641     ASSIGN
     3642     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     3643     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     3644     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     3645     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     3646     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     3647     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     3648     no-error.
     3649     release buf_tt0-dis-gds-rule no-error .
     3650     if error-status:error then do:
     3651       undo, return error return-value .
     3652     end.
     3653   end.
     3654   END PROCEDURE.
     3655     define new global shared variable g#lib-rvs as handle no-undo.
