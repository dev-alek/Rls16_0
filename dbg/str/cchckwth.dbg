     2199   procedure diasize_init :
     2200     define variable v-default-value    as logical   no-undo .
     2201     define variable v-restore-saved    as logical   no-undo .
     2202     define variable v-resize-value-str as character no-undo .
     2203     do
     2204     on error undo, return error return-value
     2205     :
     2206       do with frame Dialog-Frame
     2207       :
     2208         assign
     2209           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2210           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2211           v-diasize-browse-handle     = browse br-par-chk-pay :handle
     2212         .
     2213         create button v-diasize-resize-button
     2214         assign
     2215           parent        = frame Dialog-Frame :first-child
     2216           label         = "s"
     2217           height-pixels = 16
     2218           width-pixels  = 16
     2219           visible       = true
     2220           sensitive     = true
     2221           movable       = true
     2222           triggers:
     2223             on end-move persistent run diasize_end-move in this-procedure .
     2224           end triggers.
     2225         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2226         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2227         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2228         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2229         assign
     2230           v-diasize-wndmax = false
     2231         .
     2232         if connected("ub") = true
     2233         then do:
     2234           define variable v-cntxt-db-num        as integer   no-undo .
     2235           define variable v-cntxt-userid        as character no-undo .
     2236           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2237                                             , OUTPUT v-cntxt-userid
     2238                                             ) .
     2239           run gbl/wndpar_r.p
     2240             (input  v-cntxt-db-num
     2241             ,input  v-cntxt-userid
     2242             ,input  'wndmax':U
     2243             ,output v-diasize-wndmax
     2244             ,output v-default-value
     2245             ) .
     2246         end.
     2247         assign
     2248           v-diasize-wndstore = false
     2249         .
     2250         if connected("ub") = true
     2251         then do:
     2252           run gbl/wndpar_r.p
     2253             (input  v-cntxt-db-num
     2254             ,input  v-cntxt-userid
     2255             ,input  'wndstore':U
     2256             ,output v-diasize-wndstore
     2257             ,output v-default-value
     2258             ) .
     2259         end.
     2260         assign
     2261           v-diasize-proc-name = entry(1, program-name(2), '.')
     2262         .
     2263         if v-diasize-wndstore = true
     2264         then do:
     2265           assign
     2266             v-restore-saved = false
     2267           .
     2268           if connected("ub") = true
     2269           then do:
     2270             run gbl/wndsizer.p
     2271               (input  v-cntxt-db-num
     2272               ,input  v-cntxt-userid
     2273               ,input  v-diasize-proc-name
     2274               ,input  'height':u
     2275               ,output v-resize-value-str
     2276               ) .
     2277             if v-resize-value-str <> '':U
     2278             then do:
     2279               run diasize_change-height in this-procedure
     2280                 (input  integer(v-resize-value-str)
     2281                 ,input  true
     2282                 ) .
     2283               assign
     2284                 v-restore-saved = true
     2285               .
     2286             end.
     2287           end.
     2288           if connected("ub") = true
     2289           then do:
     2290             run gbl/wndsizer.p
     2291               (input  v-cntxt-db-num
     2292               ,input  v-cntxt-userid
     2293               ,input  v-diasize-proc-name
     2294               ,input  'width':u
     2295               ,output v-resize-value-str
     2296               ) .
     2297             if v-resize-value-str <> '':U
     2298             then do:
     2299               run diasize_change-width in this-procedure
     2300                 (input  integer(v-resize-value-str)
     2301                 ,input  true
     2302                 ) .
     2303               assign
     2304                 v-restore-saved = true
     2305               .
     2306             end.
     2307           end.
     2308           if v-restore-saved <> true
     2309           then do:
     2310             if v-diasize-wndmax = true
     2311             then do:
     2312               run diasize_maximize in this-procedure
     2313                 (input  true
     2314                 ) .
     2315             end.
     2316           end.
     2317         end.
     2318         else do:
     2319           if v-diasize-wndmax = true
     2320           then do:
     2321             run diasize_maximize in this-procedure
     2322               (input  true
     2323               ) .
     2324           end.
     2325         end.
     2326       end.
     2327     end.
     2328   end procedure.
     2329   procedure diasize_need-full-display :
     2330     define output parameter p-need-full-display as logical   no-undo .
     2331     do
     2332     on error undo, return error return-value
     2333     :
     2334       assign
     2335         p-need-full-display = v-diasize-need-full-display
     2336       .
     2337       assign
     2338         v-diasize-need-full-display = false
     2339       .
     2340     end.
