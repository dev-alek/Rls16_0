      966             LABEL "z-отчет"
      967             VIEW-AS FILL-IN
      968             SIZE 10.75 BY 1
      969        BR-lines AT ROW 8.5 COL 1
      970        br-par-chk-pay AT ROW 14 COL 1.5
      971        f-par-sum AT ROW 15.5 COL 78.5 COLON-ALIGNED
      972        tt-chk-doc.PS AT ROW 19.75 COL 1 NO-LABEL
      973             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      974             SIZE 98 BY 2.25
      975        ":" VIEW-AS TEXT
      976             SIZE .75 BY 1.08 AT ROW 3.71 COL 16.38
      977        ":" VIEW-AS TEXT
      978             SIZE .75 BY 1.08 AT ROW 3.71 COL 20.38
      979        "Тип чека" VIEW-AS TEXT
      980             SIZE 11.75 BY .83 AT ROW 1.46 COL 72.25
      981        "Время:" VIEW-AS TEXT
      982             SIZE 10.25 BY 1 AT ROW 3.63 COL 2
      983        SPACE(86.75) SKIP(17.43)
      984       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      985            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      986            TITLE "Чек МЦ"
      987            CANCEL-BUTTON b-quit.
      988   ASSIGN
      989          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      990          FRAME Dialog-Frame:HIDDEN           = TRUE.
      991   ASSIGN
      992          br-par-chk-pay:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
      993   ASSIGN
      994          f-par-sum:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      995   ON ANY-KEY OF FRAME Dialog-Frame
      996   DO:
      997     return no-apply.
      998   END.
      999   ON END-ERROR OF FRAME Dialog-Frame
     1000   DO:
     1001      apply "choose" to B-quit in frame Dialog-Frame.
     1002     return no-apply.
     1003   END.
     1004   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1005   DO:
     1006      p-next-prev = "QUIT".
     1007     APPLY "END-ERROR":U TO SELF.
     1008   END.
     1009   ON CHOOSE OF B-next IN FRAME Dialog-Frame
     1010   DO:
     1011         run reposition-c-chk-doc in this-procedure
     1012     (input 'next':U
     1013     ).
     1014   END.
     1015   ON CHOOSE OF B-prev IN FRAME Dialog-Frame
     1016   DO:
     1017        run reposition-c-chk-doc in this-procedure
     1018     (input 'prev':U
     1019     ).
     1020   END.
     1021   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1022   DO:
     1023   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1024   if lookup(self :type
     1025            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1026            ) = 0
     1027   then do:
     1028     message
     1029       "$Workfile$"
     1030       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1031       "Интерфейсный элемент" self :name  skip
     1032       "Тип" self :type  skip
     1033       "Процедура" this-procedure :file-name skip
     1034       view-as alert-box .
     1035   end.
     1036   else do:
     1037     apply "entry":u to self  .
     1038     if focus :handle <> self :handle  then do:
     1039       return no-apply .
     1040     end.
     1041   end.
     1042   define variable glog as logical no-undo .
     1043     DO TRANSACTION ON ERROR UNDO, LEAVE :
     1044       p-doc-rec = ?.
     1045       p-next-prev = "QUIT".
     1046     END.
     1047     p-next-prev = "QUIT".
     1048   END.
     1049   ON VALUE-CHANGED OF BR-lines IN FRAME Dialog-Frame
     1050   DO:
     1051     OPEN QUERY br-par-chk-pay FOR EACH tt-par-chk-pay WHERE         tt-par-chk-pay.doc-code = tt-chk-doc.doc-code     AND tt-par-chk-pay.pay-code = tt-chk-pay.pay-code     AND tt-par-chk-pay.curr-code = tt-chk-pay.curr-code       INDEXED-REPOSITION.
     1052     run get-sums IN THIS-PROCEDURE ( INPUT tt-chk-pay.pay-code, input tt-chk-pay.curr-code) NO-ERROR.
     1053   END.
     1054   ON VALUE-CHANGED OF tt-chk-doc.chk-type IN FRAME Dialog-Frame
     1055   DO:
     1056   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1057   if lookup(self :type
     1058            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1059            ) = 0
     1060   then do:
     1061     message
     1062       "$Workfile$"
     1063       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1064       "Интерфейсный элемент" self :name  skip
     1065       "Тип" self :type  skip
     1066       "Процедура" this-procedure :file-name skip
     1067       view-as alert-box .
     1068   end.
     1069   else do:
     1070     apply "entry":u to self  .
     1071     if focus :handle <> self :handle  then do:
     1072       return no-apply .
     1073     end.
     1074   end.
     1075     IF CAN-FIND(FIRST tt-chk-pay WHERE tt-chk-pay.doc-code = tt-chk-doc.doc-code)
     1076     OR CAN-FIND(FIRST tt-par-chk-pay WHERE tt-par-chk-pay.doc-code = tt-chk-doc.doc-code)
     1077         THEN DO:
     1078         MESSAGE
     1079         "Установить тип чека можно только в самом начале процесса создания чека" SKIP
     1080         "когда еще не созданы строки"
     1081         VIEW-AS ALERT-BOX ERROR.
     1082         display tt-chk-doc.chk-type
     1083         with frame Dialog-Frame .
     1084         RETURN NO-APPLY.
     1085     END.
     1086     ASSIGN
     1087     tt-chk-doc.chk-type.
     1088     locked_c-chk-doc.chk-type = tt-chk-doc.chk-type.
     1089     RUN enable-disable-par-chk-pay IN THIS-PROCEDURE .
     1090   END.
     1091   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1092   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1093   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1094   on help of frame Dialog-Frame
     1095   do:
     1096     run gbl/app_help.p
     1097       (input this-procedure :file-name
     1098       ,input ''
     1099       ,input ?
     1100       ) no-error.
     1101     if error-status :error then do:
     1102       message
     1103         "Ошибка при вызове помощи"
     1104         error-status :get-message(1)
     1105         view-as alert-box .
     1106     end.
     1107   end.
     1108   run minbtn-set in this-procedure .
     1109   on choose of b-help in frame Dialog-Frame
     1110   do:
     1111     apply "help":u to frame Dialog-Frame .
     1112   end.
     1113   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1114   procedure minbtn-set :
     1115       do
     1116           on error undo, return error return-value
     1117           :
     1118           define variable ii              as integer       no-undo .
     1119           define variable fh              as widget-handle no-undo .
     1120           define variable hh              as widget-handle no-undo .
     1121           define variable v-h             as handle        extent 4 no-undo .
     1122           define variable v-name-button   as character     no-undo .
     1123           define variable v-help-old-x    as decimal       no-undo .
     1124           define variable v-help-old-y    as decimal       no-undo .
     1125           define variable v-help-old-size as decimal       no-undo .
     1126           define variable v-frame-width   as decimal       no-undo .
     1127           define variable jj              as integer       no-undo .
     1128           do
     1129               on error undo, return error
     1130               :
     1131               assign
     1132                   v-frame-width = frame Dialog-Frame:width - 0.3
     1133                   fh            = frame Dialog-Frame:first-child
     1134                   hh            = fh:first-child
     1135                   ii            = 1
     1136                   .
     1137               do while valid-handle(hh):
     1138                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1139                   do:
     1140                       case lc(hh:name) :
     1141                           when "b-help" then
     1142                               do:
     1143                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1144                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1145                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1146                                   hh:TOOLTIP = "Помощь" .
     1147                                   v-help-old-x = hh:column .
     1148                                   v-help-old-y = hh:row    .
     1149                                   v-help-old-size = hh:width .
     1150                                   hh:width-chars = 2.5 .
     1151                               end.
     1152                           when "b-print" then
     1153                               do:
     1154                                   hh:load-image("cmp/b-print.bmp":u) .
     1155                                   hh:TOOLTIP = "Печать" .
     1156                                   v-h[ii] = hh:handle .
     1157                                   ii = ii + 1 .
     1158                                   hh:width-chars = 3 .
     1159                               end.
     1160                           when "b-history" or
     1161                           when "b-hist" then
     1162                               do:
     1163                                   hh:load-image("cmp/b-hist.bmp":u) .
     1164                                   hh:TOOLTIP = "История" .
     1165                                   v-h[ii] = hh:handle .
     1166                                   ii = ii + 1 .
     1167                                   hh:width-chars = 3 .
     1168                               end.
     1169                           when "b-sch" then
     1170                               do:
     1171                                   hh:load-image("cmp/b-sch.bmp":u) .
     1172                                   hh:TOOLTIP = "Установка Фильтра" .
     1173                                   v-h[ii] = hh:handle .
     1174                                   ii = ii + 1 .
     1175                                   hh:width-chars = 3 .
     1176                               end.
     1177                           when "b-hist-user" then
     1178                               do:
     1179                                   hh:load-image("cmp/b-hist.bmp":u) .
     1180                                   hh:TOOLTIP = "История пользователя" .
     1181                                   ii = ii + 1 .
     1182                               end.
     1183                       end case.
     1184                   end.
     1185                   hh = hh:next-sibling.
     1186               end.
     1187               b-help:column = v-frame-width - b-help:width-chars.
     1188               jj = 0.
     1189               repeat ii = 4 to 1 by -1 :
     1190                   if valid-handle (v-h[ii] ) then
     1191                   do:
     1192                       jj  = jj + 1 .
     1193                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1194                       v-h[ii]:row    = v-help-old-y .
     1195                   end.
     1196               end.
     1197           end.
     1198       end.
     1199   end procedure.
     1200   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1201   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1202   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1203   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1204   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1205   define variable v-diasize-current-frame-height as decimal   no-undo .
     1206   define variable v-diasize-change-size          as logical   no-undo .
     1207   define variable v-diasize-resize-button        as handle    no-undo .
     1208   define variable v-diasize-wndmax               as logical   no-undo .
     1209   define variable v-diasize-wndstore             as logical   no-undo .
     1210   define variable v-diasize-proc-name            as character no-undo .
     1211   define variable v-diasize-browse-handle        as handle    no-undo .
     1212   define variable v-diasize-browse-number        as integer   no-undo .
     1213   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1214   define temp-table temp-diasize-handle no-undo
     1215     field handle-value  as handle
     1216     field save-position as decimal
     1217     index xpk is primary unique handle-value
     1218     .
     1219   define temp-table temp-browse-handle no-undo
     1220     field browse-type   as character
     1221     field browse-number as integer
     1222     field browse-handle as handle
     1223     field original-size as decimal
     1224     index xpk is primary unique browse-type browse-number
     1225     index xie browse-type browse-handle
     1226   .
     1227   procedure diasize_change-height :
     1228     define input  parameter p-change-value  as decimal   no-undo .
     1229     define input  parameter p-move-resize   as logical   no-undo .
     1230     define variable v-field-group-handle    as handle    no-undo .
     1231     define variable v-object-handle         as handle    no-undo .
     1232     define variable v-frame-height          as decimal   no-undo .
     1233     define variable v-frame-virtual-height  as decimal   no-undo .
     1234     define variable v-browse-height         as decimal   no-undo .
     1235     define variable v-window-height         as decimal   no-undo .
     1236     define variable v-window-virtual-height as decimal   no-undo .
     1237     define variable v-change-sign           as integer   no-undo .
     1238     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1239     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1240     if p-change-value > 0
     1241     then do:
     1242       if frame Dialog-Frame :height + p-change-value
     1243           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1244       then do:
     1245         assign
     1246           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1247                           - (frame Dialog-Frame :height-chars)
     1248         .
     1249         if p-change-value <= 0
     1250         then do:
     1251           run diasize_position-resize-button in this-procedure .
     1252           return .
     1253         end.
     1254       end.
     1255     end.
     1256     if p-change-value < 0
     1257     then do:
     1258       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1259       then do:
     1260         assign
     1261           p-change-value = v-diasize-orig-frame-height
     1262                          - (frame Dialog-Frame :height-chars)
     1263         .
     1264         if p-change-value >= 0
     1265         then do:
     1266           run diasize_position-resize-button in this-procedure .
     1267           return .
     1268         end.
     1269       end.
     1270     end.
     1271     if p-change-value >= 0
     1272     then do:
     1273       assign
     1274         v-change-sign = 1
     1275       .
     1276     end.
     1277     else do:
     1278       assign
     1279         v-change-sign = -1
     1280       .
     1281     end.
     1282     assign
     1283       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1284     .
     1285     if p-change-value = 0
     1286     then do:
     1287       run diasize_position-resize-button in this-procedure .
     1288       return .
     1289     end.
     1290     move_block:
     1291     do
     1292     on error undo move_block, retry move_block
     1293     :
     1294       if retry
     1295       then do:
     1296         do
     1297         on error undo move_block, leave move_block
     1298         :
     1299           if p-change-value > 0
     1300           then do:
     1301             for each buf_temp-diasize-handle
     1302             on error undo, next
     1303             :
     1304               assign
     1305                 v-object-handle = buf_temp-diasize-handle.handle-value
     1306               .
     1307               if v-object-handle <> v-diasize-resize-button
     1308               then do:
     1309                 assign
     1310                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1311                 .
     1312               end.
     1313             end.
     1314             assign
     1315               v-diasize-browse-handle :height = v-browse-height
     1316             .
     1317             for each buf_temp-browse-handle
     1318               where buf_temp-browse-handle.browse-type = 'height':u
     1319             on error undo, next
     1320             :
     1321               assign
     1322                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1323               .
     1324             end.
     1325             assign
     1326               frame Dialog-Frame :height = v-frame-height
     1327             .
     1328             if frame Dialog-Frame :scrollable = true
     1329             then do:
     1330               assign
     1331                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1332               .
     1333             end.
     1334             run diasize_position-resize-button in this-procedure .
     1335           end.
     1336           else do:
     1337             if frame Dialog-Frame :scrollable = true
     1338             then do:
     1339               assign
     1340                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1341               .
     1342             end.
     1343             assign
     1344               frame Dialog-Frame :height = v-frame-height
     1345             .
     1346             assign
     1347               v-diasize-browse-handle :height = v-browse-height
     1348             .
     1349             for each buf_temp-browse-handle
     1350               where buf_temp-browse-handle.browse-type = 'height':u
     1351             on error undo, next
     1352             :
     1353               assign
     1354                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1355               .
     1356             end.
     1357             for each buf_temp-diasize-handle
     1358             on error undo, next
     1359             :
     1360               assign
     1361                 v-object-handle = buf_temp-diasize-handle.handle-value
     1362               .
     1363               if v-object-handle <> v-diasize-resize-button
     1364               then do:
     1365                 assign
     1366                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1367                 .
     1368               end.
     1369             end.
     1370             run diasize_position-resize-button in this-procedure .
     1371           end.
     1372           assign
     1373             v-diasize-change-size = false
     1374           .
     1375           leave move_block .
     1376         end.
     1377       end.
     1378       assign
     1379         v-diasize-need-full-display = true
     1380       .
     1381       if v-diasize-change-size = false
     1382       then do:
     1383         assign
     1384           v-diasize-change-size = true
     1385         .
     1386       end.
     1387       else do:
     1388         return .
     1389       end.
     1390       assign
     1391         v-frame-height = frame Dialog-Frame :height
     1392         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1393         v-browse-height = v-diasize-browse-handle :height
     1394       .
     1395       for each buf_temp-browse-handle
     1396         where buf_temp-browse-handle.browse-type = 'height':u
     1397       :
     1398         assign
     1399           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1400         .
     1401       end.
     1402       for each buf_temp-diasize-handle
     1403       :
     1404         delete buf_temp-diasize-handle .
     1405       end.
     1406       assign
     1407         v-field-group-handle = frame Dialog-Frame :first-child
     1408       .
     1409       do while valid-handle(v-field-group-handle)
     1410       :
     1411         assign
     1412           v-object-handle = v-field-group-handle :first-child
     1413         .
     1414         do while valid-handle(v-object-handle)
     1415         :
     1416           if  v-object-handle <> v-diasize-browse-handle :handle
     1417           and can-query(v-object-handle, "row")
     1418           and can-query(v-object-handle, "height")
     1419           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1420           then do:
     1421             find first buf_temp-browse-handle
     1422               where buf_temp-browse-handle.browse-type   = 'height':u
     1423                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1424               no-error .
     1425             if available buf_temp-browse-handle
     1426             then do:
     1427             end.
     1428             else do:
     1429               create buf_temp-diasize-handle .
     1430               assign
     1431                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1432                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1433               .
     1434             end.
     1435           end.
     1436           assign
     1437             v-object-handle = v-object-handle :next-sibling
     1438           .
     1439         end.
     1440         assign
     1441           v-field-group-handle = v-field-group-handle :next-sibling
     1442         .
     1443       end.
     1444       do with frame Dialog-Frame
     1445       :
     1446         hide v-diasize-resize-button .
     1447         assign
     1448           v-diasize-resize-button :row    = 1
     1449           v-diasize-resize-button :column = 1
     1450         .
     1451       end.
     1452       if p-change-value > 0
     1453       then do:
     1454         if frame Dialog-Frame :scrollable = true
     1455         then do:
     1456           assign
     1457             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1458             no-error .
     1459           if error-status :error
     1460           or error-status :get-message(1) <> ""
     1461           then do:
     1462             undo move_block, retry move_block .
     1463           end.
     1464         end.
     1465         assign
     1466           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1467           no-error .
     1468         if error-status :error
     1469         or error-status :get-message(1) <> ""
     1470         then do:
     1471           undo move_block, retry move_block .
     1472         end.
     1473         assign
     1474           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1475           no-error .
     1476         if error-status :error
     1477         or error-status :get-message(1) <> ""
     1478         then do:
     1479           undo move_block, retry move_block .
     1480         end.
     1481         for each buf_temp-browse-handle
     1482           where buf_temp-browse-handle.browse-type = 'height':u
     1483         on error undo move_block, retry move_block
     1484         :
     1485           assign
     1486             buf_temp-browse-handle.browse-handle :height
     1487               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1488             no-error .
     1489           if error-status :error
     1490           or error-status :get-message(1) <> ""
     1491           then do:
     1492             undo move_block, retry move_block .
     1493           end.
     1494         end.
     1495         for each buf_temp-diasize-handle
     1496         on error undo move_block, retry move_block
     1497         :
     1498           assign
     1499             v-object-handle = buf_temp-diasize-handle.handle-value
     1500           .
     1501           if v-object-handle <> v-diasize-resize-button
     1502           then do:
     1503             assign
     1504               v-object-handle :row = v-object-handle :row + p-change-value
     1505               no-error .
     1506             if error-status :error
     1507             or error-status :get-message(1) <> ""
     1508             then do:
     1509               undo move_block, retry move_block .
     1510             end.
     1511           end.
     1512         end.
     1513       end.
     1514       else do:
     1515         for each buf_temp-diasize-handle
     1516         on error undo move_block, retry move_block
     1517         :
     1518           assign
     1519             v-object-handle = buf_temp-diasize-handle.handle-value
     1520           .
     1521           if v-object-handle <> v-diasize-resize-button
     1522           then do:
     1523             assign
     1524               v-object-handle :row = v-object-handle :row + p-change-value
     1525               no-error .
     1526             if error-status :error
     1527             or error-status :get-message(1) <> ""
     1528             then do:
     1529               undo move_block, retry move_block .
     1530             end.
     1531           end.
     1532         end.
     1533         assign
     1534           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1535           no-error .
     1536         if error-status :error
     1537         or error-status :get-message(1) <> ""
     1538         then do:
     1539           undo move_block, retry move_block .
     1540         end.
     1541         for each buf_temp-browse-handle
     1542           where buf_temp-browse-handle.browse-type = 'height':u
     1543         on error undo move_block, retry move_block
     1544         :
     1545           assign
     1546             buf_temp-browse-handle.browse-handle :height
     1547               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1548             no-error .
     1549           if error-status :error
     1550           or error-status :get-message(1) <> ""
     1551           then do:
     1552             undo move_block, retry move_block .
     1553           end.
     1554         end.
     1555         assign
     1556           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1557           no-error .
     1558         if error-status :error
     1559         or error-status :get-message(1) <> ""
     1560         then do:
     1561           undo move_block, retry move_block .
     1562         end.
     1563         if frame Dialog-Frame :scrollable = true
     1564         then do:
     1565           assign
     1566             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1567             no-error .
     1568           if error-status :error
     1569           or error-status :get-message(1) <> ""
     1570           then do:
     1571             undo move_block, retry move_block .
     1572           end.
     1573         end.
     1574       end.
     1575       if p-move-resize = true
     1576       then do:
     1577         run diasize_position-resize-button in this-procedure .
     1578       end.
     1579       if v-diasize-wndstore = true
     1580       then do:
     1581         if connected("ub") = true
     1582         then do:
     1583           define variable v-cntxt-db-num        as integer   no-undo .
     1584           define variable v-cntxt-userid        as character no-undo .
     1585           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1586                                             , OUTPUT v-cntxt-userid
     1587                                             ) .
     1588           run gbl/wndsizew.p
     1589             (input  v-cntxt-db-num
     1590             ,input  v-cntxt-userid
     1591             ,input  v-diasize-proc-name
     1592             ,input  'height':u
     1593             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1594             ) .
     1595         end.
     1596       end.
     1597     end.
     1598     assign
     1599       v-diasize-change-size = false
     1600     .
     1601   end procedure.
     1602   procedure diasize_set-height :
     1603     define input  parameter p-new-height  as decimal   no-undo .
     1604     define input  parameter p-move-resize as logical   no-undo .
     1605     do
     1606     on error undo, return error return-value
     1607     :
     1608       run diasize_change-height in this-procedure
     1609         (input  (p-new-height - frame Dialog-Frame :height)
     1610         ,input  p-move-resize
     1611         ) .
     1612     end.
     1613   end procedure.
     1614   procedure diasize_change-width :
     1615     define input  parameter p-change-value as decimal   no-undo .
     1616     define input  parameter p-move-resize  as logical   no-undo .
     1617     define variable v-field-group-handle   as handle    no-undo .
     1618     define variable v-object-handle        as handle    no-undo .
     1619     define variable v-frame-width          as decimal   no-undo .
     1620     define variable v-frame-virtual-width  as decimal   no-undo .
     1621     define variable v-browse-width         as decimal   no-undo .
     1622     define variable v-window-width         as decimal   no-undo .
     1623     define variable v-window-virtual-width as decimal   no-undo .
     1624     define variable v-change-sign          as integer   no-undo .
     1625     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1626     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1627     if p-change-value > 0
     1628     then do:
     1629       if frame Dialog-Frame :width + p-change-value >
     1630           session :width-chars
     1631       then do:
     1632         assign
     1633           p-change-value = session :width-chars - frame Dialog-Frame :width
     1634         .
     1635         if p-change-value <= 0
     1636         then do:
     1637           run diasize_position-resize-button in this-procedure .
     1638           return .
     1639         end.
     1640       end.
     1641     end.
     1642     if p-change-value < 0
     1643     then do:
     1644       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1645       then do:
     1646         assign
     1647           p-change-value = v-diasize-orig-frame-width
     1648                          - frame Dialog-Frame :width
     1649         .
     1650         if p-change-value >= 0
     1651         then do:
     1652           run diasize_position-resize-button in this-procedure .
     1653           return .
     1654         end.
     1655       end.
     1656     end.
     1657     if p-change-value >= 0
     1658     then do:
     1659       assign
     1660         v-change-sign = 1
     1661       .
     1662     end.
     1663     else do:
     1664       assign
     1665         v-change-sign = -1
     1666       .
     1667     end.
     1668     assign
     1669       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1670     .
     1671     if p-change-value = 0
     1672     then do:
     1673       run diasize_position-resize-button in this-procedure .
     1674       return .
     1675     end.
     1676     move_block:
     1677     do
     1678     on error undo move_block, leave move_block
     1679     :
     1680       if retry
     1681       then do:
     1682         do
     1683         on error undo move_block, leave move_block
     1684         :
     1685           if p-change-value > 0
     1686           then do:
     1687             for each buf_temp-diasize-handle
     1688             on error undo, next
     1689             :
     1690               assign
     1691                 v-object-handle = buf_temp-diasize-handle.handle-value
     1692               .
     1693               if v-object-handle <> v-diasize-resize-button
     1694               then do:
     1695                 assign
     1696                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1697                 .
     1698               end.
     1699             end.
     1700             assign
     1701               v-diasize-browse-handle :width = v-browse-width
     1702             .
     1703             for each buf_temp-browse-handle
     1704               where buf_temp-browse-handle.browse-type = 'width':u
     1705             on error undo, next
     1706             :
     1707               assign
     1708                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1709               .
     1710             end.
     1711             assign
     1712               frame Dialog-Frame :width = v-frame-width
     1713             .
     1714             if frame Dialog-Frame :scrollable = true
     1715             then do:
     1716               assign
     1717                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1718               .
     1719             end.
     1720             run diasize_position-resize-button in this-procedure .
     1721           end.
     1722           else do:
     1723             if frame Dialog-Frame :scrollable = true
     1724             then do:
     1725               assign
     1726                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1727               .
     1728             end.
     1729             assign
     1730               frame Dialog-Frame :width = v-frame-width
     1731             .
     1732             for each buf_temp-browse-handle
     1733               where buf_temp-browse-handle.browse-type = 'width':u
     1734             on error undo, next
     1735             :
     1736               assign
     1737                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1738               .
     1739             end.
     1740             assign
     1741               v-diasize-browse-handle :width = v-browse-width
     1742             .
     1743             for each buf_temp-diasize-handle
     1744             on error undo, next
     1745             :
     1746               assign
     1747                 v-object-handle = buf_temp-diasize-handle.handle-value
     1748               .
     1749               if v-object-handle <> v-diasize-resize-button
     1750               then do:
     1751                 assign
     1752                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1753                 .
     1754               end.
     1755             end.
     1756             run diasize_position-resize-button in this-procedure .
     1757           end.
     1758           assign
     1759             v-diasize-change-size = false
     1760           .
     1761           leave move_block .
     1762         end.
     1763       end.
     1764       assign
     1765         v-diasize-need-full-display = true
     1766       .
     1767       if v-diasize-change-size = false
     1768       then do:
     1769         assign
     1770           v-diasize-change-size = true
     1771         .
     1772       end.
     1773       else do:
     1774         return .
     1775       end.
     1776       assign
     1777         v-frame-width = frame Dialog-Frame :width
     1778         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1779         v-browse-width = v-diasize-browse-handle :width
     1780       .
     1781       for each buf_temp-browse-handle
     1782         where buf_temp-browse-handle.browse-type = 'width':u
     1783       :
     1784         assign
     1785           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1786         .
     1787       end.
     1788       for each buf_temp-diasize-handle
     1789       :
     1790         delete buf_temp-diasize-handle .
     1791       end.
     1792       assign
     1793         v-field-group-handle = frame Dialog-Frame :first-child
     1794       .
     1795       do while valid-handle(v-field-group-handle)
     1796       :
     1797         assign
     1798           v-object-handle = v-field-group-handle :first-child
     1799         .
     1800         do while valid-handle(v-object-handle)
     1801         :
     1802           if  v-object-handle <> v-diasize-browse-handle :handle
     1803           and v-object-handle <> v-diasize-resize-button
     1804           and can-query(v-object-handle, "row")
     1805           and can-query(v-object-handle, "height")
     1806           and ( v-object-handle :col + v-object-handle :width
     1807                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1808               )
     1809           then do:
     1810             find first buf_temp-browse-handle
     1811               where buf_temp-browse-handle.browse-type   = 'width':u
     1812                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1813               no-error .
     1814             if available buf_temp-browse-handle
     1815             then do:
     1816             end.
     1817             else do:
     1818               create buf_temp-diasize-handle .
     1819               assign
     1820                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1821                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1822               .
     1823             end.
     1824           end.
     1825           assign
     1826             v-object-handle = v-object-handle :next-sibling
     1827           .
     1828         end.
     1829         assign
     1830           v-field-group-handle = v-field-group-handle :next-sibling
     1831         .
     1832       end.
     1833       do with frame Dialog-Frame
     1834       :
     1835         hide v-diasize-resize-button .
     1836         v-diasize-resize-button :row = 1.
     1837         v-diasize-resize-button :column = 1.
     1838       end.
     1839       if p-change-value > 0
     1840       then do:
     1841         if frame Dialog-Frame :scrollable = true
     1842         then do:
     1843           assign
     1844             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1845             no-error .
     1846           if error-status :error
     1847           or error-status :get-message(1) <> ""
     1848           then do:
     1849             undo move_block, retry move_block.
     1850           end.
     1851         end.
     1852         assign
     1853           frame Dialog-Frame :width = v-frame-width + p-change-value
     1854           no-error .
     1855         if error-status :error
     1856         or error-status :get-message(1) <> ""
     1857         then do:
     1858           undo move_block, retry move_block.
     1859         end.
     1860         assign
     1861           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1862         no-error .
     1863         if error-status :error
     1864         or error-status :get-message(1) <> ""
     1865         then do:
     1866           undo move_block, retry move_block.
     1867         end.
     1868         for each buf_temp-browse-handle
     1869           where buf_temp-browse-handle.browse-type = 'width':u
     1870         on error undo move_block, retry move_block
     1871         :
     1872           assign
     1873             buf_temp-browse-handle.browse-handle :width
     1874               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1875             no-error .
     1876           if error-status :error
     1877           or error-status :get-message(1) <> ""
     1878           then do:
     1879             undo move_block, retry move_block .
     1880           end.
     1881         end.
     1882         for each buf_temp-diasize-handle
     1883         on error undo move_block, retry move_block
     1884         :
     1885           assign
     1886             v-object-handle = buf_temp-diasize-handle.handle-value
     1887           .
     1888           if v-object-handle <> v-diasize-resize-button
     1889           then do:
     1890             assign
     1891               v-object-handle :col = v-object-handle :col + p-change-value
     1892               no-error .
     1893             if error-status :error
     1894             or error-status :get-message(1) <> ""
     1895             then do:
     1896               undo move_block, retry move_block .
     1897             end.
     1898           end.
     1899         end.
     1900       end.
     1901       else do:
     1902         for each buf_temp-diasize-handle
     1903         on error undo move_block, retry move_block
     1904         :
     1905           assign
     1906             v-object-handle = buf_temp-diasize-handle.handle-value
     1907           .
     1908           if v-object-handle <> v-diasize-resize-button
     1909           then do:
     1910             assign
     1911               v-object-handle :col = v-object-handle :col + p-change-value
     1912               no-error .
     1913             if error-status :error
     1914             or error-status :get-message(1) <> ""
     1915             then do:
     1916               undo move_block, retry move_block .
     1917             end.
     1918           end.
     1919         end.
     1920         for each buf_temp-browse-handle
     1921           where buf_temp-browse-handle.browse-type = 'width':u
     1922         on error undo move_block, retry move_block
     1923         :
     1924           assign
     1925             buf_temp-browse-handle.browse-handle :width
     1926               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1927             no-error .
     1928           if error-status :error
     1929           or error-status :get-message(1) <> ""
     1930           then do:
     1931             undo move_block, retry move_block .
     1932           end.
     1933         end.
     1934         assign
     1935           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1936           no-error .
     1937         if error-status :error
     1938         or error-status :get-message(1) <> ""
     1939         then do:
     1940           undo move_block, retry move_block.
     1941         end.
     1942         assign
     1943           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1944         no-error .
     1945         if error-status :error
     1946         or error-status :get-message(1) <> ""
     1947         then do:
     1948           undo move_block, retry move_block.
     1949         end.
     1950         if frame Dialog-Frame :scrollable = true
     1951         then do:
     1952           assign
     1953             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1954           no-error .
     1955           if error-status :error
     1956           or error-status :get-message(1) <> ""
     1957           then do:
     1958             undo move_block, retry move_block.
     1959           end.
     1960         end.
     1961       end.
     1962       if p-move-resize
     1963       then do:
     1964         run diasize_position-resize-button in this-procedure .
     1965       end.
     1966       if v-diasize-wndstore = true
     1967       then do:
     1968         if connected("ub") = true
     1969         then do:
     1970           define variable v-cntxt-db-num        as integer   no-undo .
     1971           define variable v-cntxt-userid        as character no-undo .
     1972           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1973                                             , OUTPUT v-cntxt-userid
     1974                                             ) .
     1975           run gbl/wndsizew.p
     1976             (input  v-cntxt-db-num
     1977             ,input  v-cntxt-userid
     1978             ,input  v-diasize-proc-name
     1979             ,input  'width':u
     1980             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1981             ) .
     1982         end.
     1983       end.
     1984     end.
     1985     assign
     1986       v-diasize-change-size = false
     1987     .
     1988   end procedure.
     1989   procedure diasize_set-width :
     1990     define input  parameter p-new-width  as decimal   no-undo .
     1991     define input  parameter p-move-resize as logical   no-undo .
     1992     do
     1993     on error undo, return error return-value
     1994     :
     1995       run diasize_change-width in this-procedure
     1996         (input  (p-new-width - frame Dialog-Frame :width)
     1997         ,input  p-move-resize
     1998         ) .
     1999     end.
     2000   end procedure.
     2001   procedure diasize_position-resize-button :
     2002     do with frame Dialog-Frame
     2003     :
     2004       hide v-diasize-resize-button .
     2005       assign
     2006         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2007                     - 1
     2008                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2009         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2010                     - 1
     2011                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2012       .
     2013       view v-diasize-resize-button .
     2014     end.
     2015   end procedure.
     2016   on alt-right anywhere
     2017   do:
     2018     run diasize_change-width in this-procedure
     2019       (input 1
     2020       ,input true
     2021       ) .
     2022     return no-apply .
     2023   end.
     2024   on alt-left anywhere
     2025   do:
     2026     run diasize_change-width in this-procedure
     2027       (input -1
     2028       ,input true
     2029       ) .
     2030     return no-apply .
     2031   end.
     2032   on alt-down anywhere
     2033   do:
     2034     run diasize_change-height in this-procedure
     2035       (input 1
     2036       ,input true
     2037       ) .
     2038     return no-apply .
     2039   end.
     2040   on alt-up anywhere
     2041   do:
     2042     run diasize_change-height in this-procedure
     2043       (input -1
     2044       ,input true
     2045       ) .
     2046     return no-apply .
     2047   end.
     2048   on alt-enter of frame Dialog-Frame
     2049   do:
     2050     run diasize_maximize in this-procedure
     2051       (input  ?
     2052       ).
     2053     return no-apply .
     2054   end.
     2055   procedure diasize_end-move :
     2056     do
     2057     on error undo, return error return-value
     2058     :
     2059       define variable v-row-delta as decimal   no-undo .
     2060       define variable v-col-delta as decimal   no-undo .
     2061       define variable v-new-row as decimal   no-undo .
     2062       define variable v-new-col as decimal   no-undo .
     2063       assign
     2064         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2065         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2066       .
     2067       assign
     2068         v-row-delta = v-new-row - frame Dialog-Frame :height
     2069         v-col-delta = v-new-col - frame Dialog-Frame :width
     2070       .
     2071       run diasize_change-height in this-procedure
     2072         (input v-row-delta
     2073         ,input true
     2074         ) .
     2075       run diasize_change-width in this-procedure
     2076         (input v-col-delta
     2077         ,input true
     2078         ) .
     2079     end.
     2080   end procedure.
     2081   procedure diasize_maximize :
     2082     define input  parameter p-action as logical   no-undo .
     2083     do
     2084     on error undo, return error return-value
     2085     :
     2086       if p-action = ?
     2087       then do:
     2088         if v-diasize-need-maximize = true
     2089         then do:
     2090           assign
     2091             p-action = true
     2092           .
     2093         end.
     2094         else do:
     2095           assign
     2096             p-action = false
     2097           .
     2098         end.
     2099       end.
     2100       if p-action = true
     2101       then do:
     2102         run diasize_change-height in this-procedure
     2103           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2104               - frame Dialog-Frame :height-chars
     2105           ,input true
     2106           ) .
     2107         run diasize_change-width in this-procedure
     2108           (input session :width-chars
     2109               - frame Dialog-Frame :width-chars
     2110           ,input true
     2111           ) .
     2112         assign
     2113           v-diasize-need-maximize = false
     2114         .
     2115       end.
     2116       else do:
     2117         run diasize_change-width in this-procedure
     2118           (input v-diasize-orig-frame-width
     2119               - frame Dialog-Frame :width-chars
     2120           ,input true
     2121           ) .
     2122         run diasize_change-height in this-procedure
     2123           (input v-diasize-orig-frame-height
     2124               - frame Dialog-Frame :height-chars
     2125           ,input true
     2126           ) .
     2127         assign
     2128           v-diasize-need-maximize = true
     2129         .
     2130       end.
     2131     end.
     2132   end procedure.
     2133   procedure diasize_restore-orig-size :
