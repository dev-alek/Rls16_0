      858        LABEL "Fill 1"
      859        VIEW-AS FILL-IN
      860        SIZE 16 BY 1
      861        FGCOLOR 4  NO-UNDO.
      862   DEFINE VARIABLE fhour AS INTEGER FORMAT "99":U INITIAL 0
      863        VIEW-AS FILL-IN
      864        SIZE 2.88 BY 1 NO-UNDO.
      865   DEFINE VARIABLE fmin AS INTEGER FORMAT "99":U INITIAL 0
      866        VIEW-AS FILL-IN
      867        SIZE 2.88 BY 1 NO-UNDO.
      868   DEFINE VARIABLE fsec AS INTEGER FORMAT "99":U INITIAL 0
      869        VIEW-AS FILL-IN
      870        SIZE 2.88 BY 1 NO-UNDO.
