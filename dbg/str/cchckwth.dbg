     2342   procedure get-context :
     2343      define output parameter p-db-num as integer          no-undo.
     2344      define output parameter p-user-id as character        no-undo.
     2345      define variable v-login               as character    no-undo.
     2346      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2347      define buffer buf_user-login  for ub.user-login .
     2348      do
     2349      on error undo, return error
     2350      :
     2351            FIND FIRST buf_sys-ctrl no-lock.
     2352            ASSIGN
     2353               v-login = USERID("ub")
     2354               p-db-num = buf_sys-ctrl.db-num
     2355            .
     2356            FIND FIRST buf_user-login
     2357                 WHERE buf_user-login.db-num = p-db-num
     2358                   AND buf_user-login.user-login = v-login
     2359                 no-lock
     2360                 no-error
     2361                 .
     2362            IF AVAILABLE buf_user-login
     2363            THEN DO:
     2364               assign
     2365                  p-user-id = buf_user-login.user-id
     2366               .
     2367            END.
     2368      end.
     2369   end procedure.
     2370       run diasize_init in this-procedure .
     2371   p-next-prev = "".
     2372   n-p:
     2373   do while p-next-prev = "":U:
     2374   MAIN-BLOCK:
     2375   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2376      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2377       assign
     2378       v-first-mode = par-mode
     2379       .
     2380       if not par-mode = 'ПРОСМОТР':U then
     2381       p-next-prev = "QUIT".
     2382     assign
     2383     shop-type =   p-obj-type
     2384     shop-code = p-obj-code
     2385     .
     2386   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2387   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2388   FUNCTION convert-discount returns integer
     2389                                             ( input p-disc-reason as integer
     2390                                             , input p-disc-type  as integer
     2391                                             , input p-line-type as integer) :
     2392   define variable v-disc-type as integer no-undo .
     2393   if p-line-type = integer('1':U)
     2394   or p-line-type = integer('0':U)
     2395   then do:
     2396     if p-disc-type = 0
     2397     or p-disc-type = 1
     2398     or p-disc-type = 2
     2399     then do:
     2400       if p-disc-reason <> 0 then
     2401       p-disc-type = p-disc-reason
     2402       .
     2403     end.
     2404   end.
     2405   if p-line-type = integer('3':U)
     2406   or p-line-type = integer('2':U) then do:
     2407     if p-disc-type = 101
     2408     or p-disc-type = 102
     2409     then do:
     2410       if p-disc-reason <> 0 then
     2411       p-disc-type = p-disc-reason
     2412       .
     2413     end.
     2414   end.
     2415   if p-disc-reason <> 0 then do:
     2416     CASE p-disc-reason:
     2417       when 0 then do:
     2418         return integer('0':U).
     2419       end.
     2420       when 1 then do:
     2421         return integer('11':U).
     2422       end.
     2423       when 2 then do:
     2424         return integer('1':U).
     2425       end.
     2426       when 3 or when 15 then do:
     2427         return integer('7':U).
     2428       end.
     2429       when 4 then do:
     2430         return integer('4':U).
     2431       end.
     2432       when 5 then do:
     2433         return integer('12':U).
     2434       end.
     2435       when 6 then do:
     2436         return integer('3':U).
     2437       end.
     2438       when 7 then do:
     2439         return integer('13':U).
     2440       end.
     2441       when 8
     2442       or
     2443       when 9
     2444       or
     2445       when 10
     2446       then do:
     2447         return integer('20':U).
     2448       end.
     2449       when 11
     2450       then do:
     2451         return integer('21':U).
     2452       end.
     2453       when 13
     2454       then do:
     2455         return integer('22':U).
     2456       end.
     2457       when 16 then do:
     2458         return integer('23':U).
     2459       end.
     2460     END CASE.
     2461   end.
     2462   CASE p-disc-type:
     2463     when 0 then do:
     2464       return integer('0':U).
     2465     end.
     2466     when 1 then do:
     2467       return integer('13':U).
     2468     end.
     2469     when 2 then do:
     2470       return integer('2':U).
     2471     end.
     2472     when 3 then do:
     2473       return integer('4':U).
     2474     end.
     2475     when 4 then do:
     2476       return integer('12':U).
     2477     end.
     2478     when 5 then do:
     2479       return integer('1':U).
     2480     end.
     2481     when 6 then do:
     2482       return integer('3':U).
     2483     end.
     2484     when 7 then do:
     2485       return integer('14':U).
     2486     end.
     2487     when 8 then do:
     2488       return integer('15':U).
     2489     end.
     2490     when 9 then do:
     2491       return integer('16':U).
     2492     end.
     2493     when 101 then do:
     2494       return integer('13':U).
     2495     end.
     2496     when 102 then do:
     2497       return integer('5':U).
     2498     end.
     2499     when 103 then do:
     2500       return integer('1':U).
     2501     end.
     2502     when 104 then do:
     2503       return integer('5':U).
     2504     end.
     2505     when 105 then do:
     2506       return integer('1':U).
     2507     end.
     2508     when 106 then do:
     2509       return integer('1':U).
     2510     end.
     2511   END CASE.
     2512   END FUNCTION.
     2513   run get-general-parameters in this-procedure .
     2514   procedure get-general-parameters :
     2515   define buffer buf_get-chkc_context for get-chkc_context.
     2516   do
     2517   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2518   :
     2519     for each buf_get-chkc_context:
     2520       delete buf_get-chkc_context.
     2521     end.
     2522     create buf_get-chkc_context.
     2523   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2524   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_create-context in g#libchkvl
     2525     (input  shop-type
     2526     ,input  shop-code
     2527     ,input  buffer buf_get-chkc_context:handle
     2528     ) no-error .
     2529     if error-status:error then do:
     2530       undo, return error substitute("Ошибка при создании контекста&1&2&1&3"
     2531                                      , chr(10)
     2532                                      , error-status:get-message(1)
     2533                                      , return-value ).
     2534     end.
     2535     find first buf_get-chkc_context.
     2536     assign
     2537     buf_get-chkc_context.parparentproc = parparentproc
     2538     buf_get-chkc_context.p-log-handle = p-log-handle
     2539     buf_get-chkc_context.tt-wd-bh     = buffer tt-wd:handle
     2540     .
     2541     release buf_get-chkc_context.
     2542     find first get-chkc_context.
     2543   end.
     2544   end procedure.
     2545     run get-params in this-procedure ( input shop-type, input shop-code) no-error.
     2546     if error-status:error then return error.
     2547     Run fill-tables in this-procedure no-error.
     2548     if error-status:error then return error.
     2549     RUN MyEnable in this-procedure .
     2550     WAIT-FOR GO OF FRAME Dialog-Frame.
     2551   END.
     2552   end.
     2553   RUN disable_UI in this-procedure .
     2554   PROCEDURE check-time :
     2555   define input parameter parscreen-value as integer no-undo.
     2556   define input parameter par-mode as character no-undo.
     2557   define variable var-limit as integer no-undo.
     2558   CASE par-mode:
     2559       when "hour":U then do:
     2560            var-limit = 23.
     2561       end.
     2562       when "min":U then do:
     2563             var-limit = 59.
     2564       end.
     2565       when "sec" then do:
     2566             var-limit = 59.
     2567       end.
     2568   END.
     2569     if int(parscreen-value) > var-limit then do:
     2570       bell.
     2571       Message "Неверное время!" view-as alert-box ERROR.
     2572       return error.
     2573     end.
     2574     run find-curs in this-procedure (
     2575                                       input date(tt-chk-doc.chk-date:screen-value in frame Dialog-Frame)
     2576                                       ,input (integer(fhour:screen-value) * 3600 + integer(fmin:screen-value) * 60) + integer(fsec:screen-value)
     2577                                       ,output varbase-curs) no-error.
     2578    if error-status:error then return error.
     2579   END PROCEDURE.
     2580   PROCEDURE control-line :
     2581   DEFINE OUTPUT PARAMETER locked-title as logical no-undo.
     2582   IF CAN-FIND(FIRST ub.chk-pay No-LOCK WHERE
     2583                     ub.chk-pay.doc-code = tt-chk-doc.doc-code) then
     2584   locked-title = yes.
     2585   else locked-title = no.
     2586   END PROCEDURE.
     2587   PROCEDURE disable_UI :
     2588     HIDE FRAME Dialog-Frame.
     2589   END PROCEDURE.
     2590   PROCEDURE enable-disable-par-chk-pay :
     2591   IF tt-chk-doc.chk-type = INTEGER('7':U) THEN DO:
     2592      DISPLAY
     2593      br-par-chk-pay
     2594      f-par-sum
     2595      WITH FRAME Dialog-Frame.
     2596      br-lines:HEIGHT-CHARS = 5.5.
     2597      APPLy "ENTRY" to br-par-chk-pay.
     2598      apply "VAlue-changed" to br-par-chk-pay.
     2599   END.
     2600   ELSE DO:
     2601       hide
     2602       br-par-chk-pay
     2603       f-par-sum
     2604       IN FRAME Dialog-Frame.
     2605       br-lines:HEIGHT-CHARS = 11.
     2606   END.
     2607   END PROCEDURE.
     2608   PROCEDURE enable_UI :
     2609     OPEN QUERY Dialog-Frame FOR EACH tt-chk-doc SHARE-LOCK.
     2610     GET FIRST Dialog-Frame.
     2611     DISPLAY fhour fmin fsec f-par-sum
     2612         WITH FRAME Dialog-Frame.
     2613     IF AVAILABLE tt-chk-doc THEN
     2614       DISPLAY tt-chk-doc.chk-date tt-chk-doc.obj-code tt-chk-doc.chk-type
     2615             tt-chk-doc.pay-desk tt-chk-doc.src-shift-date tt-chk-doc.shift-date
     2616             tt-chk-doc.cashier tt-chk-doc.shift-name tt-chk-doc.shift-num
     2617             tt-chk-doc.chk-num tt-chk-doc.cash-rate tt-chk-doc.z-number
     2618             tt-chk-doc.PS
     2619         WITH FRAME Dialog-Frame.
     2620     ENABLE b-quit B-prev B-next B-Help tt-chk-doc.chk-date tt-chk-doc.obj-code
     2621            tt-chk-doc.chk-type fhour fmin fsec tt-chk-doc.pay-desk
     2622            tt-chk-doc.src-shift-date tt-chk-doc.shift-date tt-chk-doc.cashier
     2623            tt-chk-doc.shift-name tt-chk-doc.shift-num tt-chk-doc.chk-num
     2624            tt-chk-doc.cash-rate tt-chk-doc.z-number BR-lines br-par-chk-pay f-par-sum
     2625            tt-chk-doc.PS
     2626         WITH FRAME Dialog-Frame.
     2627     VIEW FRAME Dialog-Frame.
     2628     OPEN QUERY br-par-chk-pay FOR EACH tt-par-chk-pay WHERE         tt-par-chk-pay.doc-code = tt-chk-doc.doc-code     AND tt-par-chk-pay.pay-code = tt-chk-pay.pay-code     AND tt-par-chk-pay.curr-code = tt-chk-pay.curr-code       INDEXED-REPOSITION.    OPEN QUERY BR-lines FOR EACH locked_c-chk-pay NO-LOCK WHERE        locked_c-chk-pay.doc-code = tt-chk-doc.doc-code     AND locked_c-chk-pay.chip-num = locked_c-chk-pay.chip-num,            FIRST tt-chk-pay WHERE         tt-chk-pay.doc-code = tt-chk-doc.doc-code     AND tt-chk-pay.line-num = locked_c-chk-pay.line-num.
     2629   END PROCEDURE.
     2630   PROCEDURE fill-tables :
     2631   define variable v-first-cashier as integer no-undo .
     2632   define variable v-first-seller as integer no-undo .
     2633   DEFINE VARIABLE v-today as date no-undo .
     2634   DEFINE VARIABLE v-time as integer no-undo .
     2635   for each tt-chk-doc:
     2636       delete tt-chk-doc.
     2637   end.
     2638   for each tt-chk-pay:
     2639       delete tt-chk-pay.
     2640   end.
     2641   for each tt-par-chk-pay:
     2642       delete tt-par-chk-pay.
     2643   end.
     2644   FIND FIRST locked_c-chk-doc NO-LOCK WHERE
     2645               recid(locked_c-chk-doc) = p-doc-rec.
     2646   IF NOT AVAIL locked_c-chk-doc then
     2647   return error.
     2648   if locked_c-chk-doc.out-code <> '':U and par-mode <> 'ПРОСМОТР':U then do:
     2649     message
     2650     "Чек МЦ с N" locked_c-chk-doc.doc-code  "включен в документ МЦ" SKIP
     2651     "Изменения не допускаются"
     2652     view-as alert-box error.
     2653     return error.
     2654   end.
     2655   assign
     2656   p-obj-type = locked_c-chk-doc.obj-type
     2657   p-obj-code = locked_c-chk-doc.obj-code
     2658   .
     2659   run get-environment in this-Procedure no-error.
     2660   if error-status:error then return error.
     2661   create tt-chk-doc.
     2662   buffer-copy locked_c-chk-doc to tt-chk-doc.
     2663   if gbclcode-is-this-db-role ( input 'C':U, input vardb-num, input tt-chk-doc.cashier, input tt-chk-doc.chk-date) = 0 then do:
     2664     message
     2665     "В справочнике нет кассира" tt-chk-doc.cashier
     2666     view-as alert-box WARNING.
     2667   end.
     2668   FIND FIRST buf_cash-desk where
     2669             buf_cash-desk.db-num = vardb-num and
     2670             buf_cash-desk.obj-code = p-obj-code AND
     2671             buf_cash-desk.cash-num = tt-chk-doc.pay-desk no-error.
     2672   if not available buf_cash-desk then dO:
     2673     message
     2674     "В справочнике нет кассы" tt-chk-doc.pay-desk
     2675     view-as alert-box error.
     2676   end.
     2677   for each locked_c-chk-pay no-lock where
     2678             locked_c-chk-pay.doc-code = tt-chk-doc.doc-code
     2679         and locked_c-chk-pay.chip-num = locked_c-chk-doc.chip-num   :
     2680         create tt-chk-pay.
     2681         buffer-copy locked_c-chk-pay to tt-chk-pay.
     2682     end.
     2683     for each locked-par_c-chk-pay no-lock where
     2684             locked-par_c-chk-pay.doc-code = tt-chk-doc.doc-code
     2685         and locked-par_c-chk-pay.chip-num = locked_c-chk-doc.chip-num   :
     2686         create tt-par-chk-pay.
     2687         buffer-copy locked-par_c-chk-pay to tt-par-chk-pay
     2688         .
     2689     end.
     2690     for each locked_c-chk-doc-attr no-lock where
     2691             locked_c-chk-doc-attr.doc-code = tt-chk-doc.doc-code
     2692         and locked_c-chk-doc-attr.chip-num = locked_c-chk-doc.chip-num  :
     2693         create tt-chk-doc-attr.
     2694         buffer-copy locked_c-chk-doc-attr to tt-chk-doc-attr.
     2695     end.
     2696   END PROCEDURE.
     2697   PROCEDURE find-curs :
     2698   DEFINE INPUT PARAMETER par-date as date no-undo.
     2699   DEFINE INPUT PARAMETER par-time as integer no-undo.
     2700   DEFINE output PARAMETER parbase-curs as decimal no-undo.
     2701   DEFINE BUFFER buf_curr-shop FOR ub.curr-shop .
     2702   IF varbase-code <> 0 then do:
     2703       FIND LAST buf_curr-shop NO-LOCK Where
     2704                            buf_curr-shop.obj-type = p-obj-type AND
     2705                   buf_curr-shop.obj-code  = p-obj-code AND
     2706                   buf_curr-shop.curr-code = varbase-code AND
     2707                  ( ( buf_curr-shop.exch-date = par-date AND
     2708                  buf_curr-shop.exch-time <= par-time ) OR
     2709                  buf_curr-shop.exch-date < par-date ) NO-ERROR .
     2710       IF NOT AVAIL buf_curr-shop then do:
     2711           message
     2712           "Нет магазинного курса базовой валюты на дату и время чека!" skip
     2713            " - дата " string(par-date, "99/99/9999")
     2714           " время - " string(par-time, "hh:mm") view-as alert-box ERROR.
     2715          return error.
     2716       end.
     2717       parbase-curs = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale.
     2718   END.
     2719   else parbase-curs = 1.
     2720   END PROCEDURE.
     2721   PROCEDURE find-uchet-date :
     2722   assign
     2723   tt-chk-doc.src-shift-date = if (get-chkc_context.cas-shft and not get-chkc_context.shift-on)
     2724                                 then tt-chk-doc.src-shift-date
     2725                                 else tt-chk-doc.chk-date
     2726   tt-chk-doc.shift-date = if t-shft < 0 AND tt-chk-doc.chk-time < abs(t-shft)
     2727                             then (tt-chk-doc.chk-date - 1)
     2728                             else tt-chk-doc.src-shift-date
     2729   .
     2730   display
     2731   tt-chk-doc.shift-date
     2732   with frame Dialog-Frame.
     2733   run find-curs in this-procedure (
     2734                                         input tt-chk-doc.chk-date
     2735                                        ,input tt-chk-doc.chk-time
     2736                                        ,output cash-rate_
     2737                                        ) no-error.
     2738    if error-status:error then return error.
     2739   END PROCEDURE.
     2740   PROCEDURE get-environment :
     2741     FIND FIRST buf_obj No-LOCK WHERE
     2742                   buf_obj.obj-type = p-obj-type and
     2743                   buf_obj.obj-code = p-obj-code No-ERROR.
     2744   if not avail buf_obj or p-obj-type <> 'маг':U then do:
     2745       message vss-workfile vss-revision vss-description skip
     2746       "Неверный параметр вызова p-obj-type и/или p-obj-code" p-obj-type p-obj-code
     2747       view-as alert-box ERROR.
     2748       return.
     2749   end.
     2750   vardb-num = buf_obj.db-num.
     2751   FIND FIRST ub.shop No-LOCK WHERE
     2752                            ub.shop.obj-code = p-obj-code No-ERROR.
     2753           if not available shop then do:
     2754               message "Не найден магазин с кодом" p-obj-code
     2755               view-as alert-box ERROR.
     2756               return error.
     2757           end.
     2758   FIND FIRSt ub.sysconf No-LOCK WHERE
     2759                           ub.sysconf.host-code = ub.shop.host-code No-ERROR.
     2760           if not available ub.sysconf then do:
     2761               message "Не найдена фирма с кодом" ub.shop.host-code
     2762               view-as alert-box ERROR.
     2763               return error.
     2764           end.
     2765           assign
     2766           varbase-code = ub.sysconf.base-code.
     2767   END PROCEDURE.
     2768   PROCEDURE get-params :
     2769   DEFINE INPUT PARAMETER p-obj-type like ub.clients.obj-type no-undo.
     2770   DEFINE INPUT PARAMETER p-obj-code like ub.clients.obj-code no-undo.
     2771   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2772   define variable v-param-type18 as character no-undo .
     2773   define variable v-value-date18 as date no-undo .
     2774   define variable v-value-decimal18 as decimal no-undo .
     2775   define variable v-value-integer18 as INTEGER no-undo .
     2776   define variable v-value-logical18 AS LOGICAL no-undo .
     2777   define variable v-tth18 as handle no-undo .
     2778   run adm/shattri.p (
     2779       input "get":U
     2780       ,input  p-obj-type
     2781       ,input  p-obj-code
     2782       ,input  'cd-sending':U
     2783       ,input  'dflt-cd':U
     2784       ,output dflt-cd
     2785       ,output v-value-date18
     2786       ,output v-value-decimal18
     2787       ,output v-value-integer18
     2788       ,output v-value-logical18
     2789       ,output v-param-type18
     2790       ,INPUT-OUTPUT table-handle v-tth18
     2791       )  .
     2792   delete object v-tth18 no-error.
     2793   get-chkc_context.pos-type = dflt-cd.
     2794   get-chkc_context.p-log-handle = this-procedure:handle.
     2795   if get-chkc_context.shift-on and not get-chkc_context.cas-shft then do:
     2796     message
     2797     "Внимание! На текущем объекте требуется использование смен" skip
     2798     "а настройка СМЕНЫ НА КАССЕ ( cas-shft ) выключена - это недопустимо." skip (2)
     2799     view-as alert-box ERROR.
     2800     return ERROR.
     2801   end.
     2802   END PROCEDURE.
     2803   PROCEDURE get-sums :
     2804   DEFINE INPUT PARAMETER p-pay-code AS INTEGER NO-UNDO.
     2805   DEFINE INPUT PARAMETER p-curr-code AS INTEGER NO-UNDO.
     2806   DEFINE BUFFER buf-tt-par-chk-pay FOR tt-par-chk-pay.
     2807   f-par-sum = 0.
     2808   FOR EACH  buf-tt-par-chk-pay NO-LOCK WHERE
     2809           buf-tt-par-chk-pay.doc-code = tt-chk-doc.doc-code
     2810       AND buf-tt-par-chk-pay.pay-code = p-pay-code
     2811           AND buf-tt-par-chk-pay.curr-code = p-curr-code:
     2812      ASSIGN
     2813      f-par-sum = f-par-sum + buf-tt-par-chk-pay.par-val * buf-tt-par-chk-pay.doc-qnty
     2814      .
     2815   END.
     2816   IF br-par-chk-pay:VISIBLE IN FRAME Dialog-Frame = YES THEN DO:
     2817       DISPLAY
     2818       f-par-sum
     2819       WITH FRAME Dialog-Frame.
     2820   END.
     2821   END PROCEDURE.
     2822   PROCEDURE lock-proc :
     2823   DEFINE INPUT PARAMETER locked-title as logical no-undo.
     2824   if locked-title then do:
     2825       DISABLE
     2826       fhour fmin fsec
     2827       tt-chk-doc.cash-rate
     2828       tt-chk-doc.chk-date
     2829       tt-chk-doc.chk-type
     2830       with frame Dialog-Frame
     2831       .
     2832   end.
     2833   else do:
     2834       if par-mode <> 'ПРОСМОТР':U then
     2835       ENABLE
     2836       fhour when par-mode = 'ДОБАВЛЕНИЕ':U
     2837       fmin when par-mode = 'ДОБАВЛЕНИЕ':U
     2838       fsec when par-mode = 'ДОБАВЛЕНИЕ':U
     2839       tt-chk-doc.cash-rate when par-mode = 'ДОБАВЛЕНИЕ':U
     2840       tt-chk-doc.chk-date when par-mode = 'ДОБАВЛЕНИЕ':U
     2841       tt-chk-doc.chk-type when par-mode = 'ДОБАВЛЕНИЕ':U
     2842       tt-chk-doc.src-shift-date  when (get-chkc_context.cas-shft and not  get-chkc_context.SHiFT-on)
     2843       tt-chk-doc.shift-name when (get-chkc_context.cas-shft and not  get-chkc_context.SHiFT-on)
     2844       with frame Dialog-Frame
     2845       .
     2846   end.
     2847   END PROCEDURE.
     2848   PROCEDURE MyEnable :
     2849   define variable var-dopi as integer no-undo.
     2850    tt-chk-doc.chk-type:Radio-buttons in frame Dialog-Frame =
     2851    "Инкассация" + chr(44) + string('2':U) + chr(44) +
     2852    "Касс_фонд" + chr(44) + string('3':U) + chr(44) +
     2853    "Перевод_опл" + chr(44) + string('4':U) + chr(44) +
     2854    "Расход_кассы" + chr(44) + string('5':U) + chr(44) +
     2855    "Декл_ден_ящ" + chr(44) + string('7':U)
     2856    .
     2857   if get-chkc_context.cas-curs then
     2858   assign
     2859   tt-chk-pay.cash-rate:READ-ONLY IN BROWSE BR-lines = no
     2860   tt-chk-pay.bank-rate:READ-ONLY IN BROWSE BR-lines = no
     2861   tt-chk-pay.bank-scale:READ-ONLY IN BROWSE BR-lines = no
     2862   .
     2863   else
     2864   assign
     2865   tt-chk-pay.cash-rate:READ-ONLY IN BROWSE BR-lines = yes
     2866   tt-chk-pay.bank-rate:READ-ONLY IN BROWSE BR-lines = yes
     2867   tt-chk-pay.bank-scale:READ-ONLY IN BROWSE BR-lines = yes
     2868   .
     2869   assign
     2870   fhour = (tt-chk-doc.chk-time - tt-chk-doc.chk-time MODULO 3600) / 3600
     2871   var-dopi = tt-chk-doc.chk-time MODULO 3600
     2872   fmin =  (var-dopi - var-dopi modulo 60) / 60
     2873   var-dopi = var-dopi modulo 60
     2874   fsec = (var-dopi - var-dopi modulo 60) / 60
     2875   .
     2876   IF AVAILABLE tt-chk-doc THEN
     2877   DISPLAY
     2878   fhour
     2879   fmin
     2880   fsec
     2881   tt-chk-doc.cash-rate
     2882   tt-chk-doc.cash-scale
     2883   tt-chk-doc.chk-date
     2884   tt-chk-doc.obj-code
     2885   tt-chk-doc.chk-type
     2886   tt-chk-doc.src-shift-date
     2887   tt-chk-doc.shift-date
     2888   tt-chk-doc.pay-desk
     2889   tt-chk-doc.shift-num
     2890   tt-chk-doc.shift-name
     2891   tt-chk-doc.cashier
     2892   tt-chk-doc.z-number
     2893   tt-chk-doc.chk-num
     2894   tt-chk-doc.ps
     2895   WITH FRAME Dialog-Frame .
     2896   ASSIGN
     2897   tt-chk-pay.tot-sum:READ-ONLY IN BROWSE BR-lines = yes
     2898   tt-chk-pay.cash-rate:READ-ONLY IN BROWSE BR-lines = yes
     2899   tt-chk-pay.bank-rate:READ-ONLY IN BROWSE BR-lines = yes
     2900   tt-chk-pay.bank-scale:READ-ONLY IN BROWSE BR-lines = yes
     2901   tt-chk-pay.pay-code:READ-ONLY IN BROWSE BR-lines = yes
     2902   tt-chk-pay.curr-code:READ-ONLY IN BROWSE BR-lines = yes
     2903   tt-par-chk-pay.doc-qnty:READ-ONLY IN BROWSE BR-par-chk-pay = yes
     2904   .
     2905   b-quit:label = "&Выход".
     2906   ENABLE
     2907   b-quit
     2908   B-Help
     2909   b-next
     2910   b-prev
     2911   BR-lines
     2912   br-par-chk-pay
     2913   WITH FRAME Dialog-Frame .
     2914   VIEW FRAME Dialog-Frame .
     2915   run control-line in this-procedure ( output locked-title).
     2916   run lock-proc in this-procedure ( locked-title).
     2917   if not cas-shft then do:
     2918     hide
     2919     tt-chk-doc.src-shift-date
     2920     tt-chk-doc.shift-num
     2921     tt-chk-doc.shift-name
     2922     in frame Dialog-Frame.
     2923   end.
     2924   RUN enable-disable-par-chk-pay IN THIS-PROCEDURE .
     2925   OPEN QUERY br-par-chk-pay FOR EACH tt-par-chk-pay WHERE         tt-par-chk-pay.doc-code = tt-chk-doc.doc-code     AND tt-par-chk-pay.pay-code = tt-chk-pay.pay-code     AND tt-par-chk-pay.curr-code = tt-chk-pay.curr-code       INDEXED-REPOSITION.    OPEN QUERY BR-lines FOR EACH locked_c-chk-pay NO-LOCK WHERE        locked_c-chk-pay.doc-code = tt-chk-doc.doc-code     AND locked_c-chk-pay.chip-num = locked_c-chk-pay.chip-num,            FIRST tt-chk-pay WHERE         tt-chk-pay.doc-code = tt-chk-doc.doc-code     AND tt-chk-pay.line-num = locked_c-chk-pay.line-num.
     2926   IF ERROR-STATUS:ERROR THEN DO:
     2927     REPOSITION br-lines TO ROW 1 NO-ERROR.
     2928   END.
     2929   APPLY "ENTRY":U TO br-lines IN FRAME Dialog-Frame.
     2930   APPLY "VALUE-CHANGED" to br-lines in frame Dialog-Frame .
     2931   ASSIGN
     2932   frame Dialog-Frame:title =
     2933                             substitute("ЧЕК № &1 Дата: &2 Время: &3"
     2934                                         ,tt-chk-doc.doc-code
     2935                                         ,tt-chk-doc.chk-date
     2936                                         ,string (tt-chk-doc.chk-time, "HH:MM")) +
     2937                             if (cas-shft OR T-SHFT <> 0)
     2938                             then substitute(" Смена от &1 N смены &2&3"
     2939                                             ,string(tt-chk-doc.src-shift-date, "99/99/9999")
     2940                                             ,tt-chk-doc.shift-name
     2941                                             , (if integer(tt-chk-doc.shift-name) = tt-chk-doc.shift-num
     2942                                                 then '':U
     2943                                                 else string(tt-chk-doc.shift-num, "(>9)"))
     2944                                             )
     2945                             else substitute("Дата учета &1", string(tt-chk-doc.shift-date))
     2946   .
     2947   END PROCEDURE.
     2948   PROCEDURE reposition-c-chk-doc :
     2949   define input parameter p-direction as character no-undo .
     2950   define variable v-new-c-chk-doc-recid as recid no-undo .
     2951   do
     2952   on error undo, return error
     2953   :
     2954     if valid-handle(p-call-prog)
     2955     then do:
     2956       run reposition-c-chk-doc in p-call-prog
     2957         (input  p-direction
     2958         ,output v-new-c-chk-doc-recid
     2959         ).
     2960       if v-new-c-chk-doc-recid <> ?
     2961       then do:
     2962         define buffer buf_c-chk-doc for ub.c-chk-doc .
     2963         find first buf_c-chk-doc no-lock
     2964           where recid(buf_c-chk-doc) = v-new-c-chk-doc-recid
     2965           no-error .
     2966         assign
     2967         p-doc-rec = v-new-c-chk-doc-recid
     2968         p-next-prev = '':U
     2969         .
     2970       end.
     2971     end.
     2972     else do:
     2973       message "Список чеков МЦ не определен." view-as alert-box INFORMATION .
     2974       return no-apply.
     2975     end.
     2976     END.
     2977   END PROCEDURE.
     2978   PROCEDURE write-log-and-file :
     2979   define input parameter p-tab-position   as integer   no-undo.
     2980   define input parameter p-file-name      as character no-undo .
     2981   define input parameter p-log-level      as integer no-undo .
     2982   define input parameter p-log-string     as character no-undo .
     2983   message
     2984   p-log-string
     2985   view-as alert-box error .
     2986   END PROCEDURE.
     2987   FUNCTION get-cash-pay RETURNS CHARACTER
     2988     ( input parpay-code as integer, parcurr-code as integer, OUTPUT p-wth-code AS INTEGER ) :
     2989   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     2990   DEFINE BUFFER buf_wealth FOR ub.wealth.
     2991   FIND FIRST buf_cash-pay No-LOCK WHERE
     2992            buf_cash-pay.cdpay-code = parpay-code
     2993       AND buf_cash-pay.curr-code = parcurr-code No-ERROR.
     2994   if available buf_cash-pay then do:
     2995     varwth-code = buf_cash-pay.wth-code.
     2996     p-wth-code = varwth-code.
     2997     if varwth-code > 0 then do:
     2998         FIND FIRST buf_wealth No-LOCK WHERE
     2999                         buf_wealth.wth-code = varwth-code No-error.
     3000         if available buf_wealth then do:
     3001           assign
     3002           varwth-code = buf_wealth.wth-code
     3003           varwth-name = buf_wealth.wth-name
     3004           p-wth-code = varwth-code
     3005           .
     3006           return buf_cash-pay.obj-name.
     3007         end.
     3008         else do:
     3009           assign
     3010           varwth-code = 0
     3011           varwth-name = "Неопознанная МЦ"
     3012           p-wth-code = varwth-code
     3013           .
     3014           RETURN buf_cash-pay.obj-name.
     3015         end.
     3016     end.
     3017     else do:
     3018       assign
     3019       varwth-code = 0
     3020       varwth-name = "Неопознанная МЦ"
     3021       p-wth-code = varwth-code
     3022       .
     3023       RETURN buf_cash-pay.obj-name .
     3024     end.
     3025   end.
     3026   assign
     3027   varwth-code = 0
     3028   varwth-name = '':U
     3029   p-wth-code = varwth-code
     3030   .
     3031   RETURN "Неопознанная оплата".
     3032   END FUNCTION.
