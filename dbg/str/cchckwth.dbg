      587   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      588   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      589                                                       ,input p-range-type as character
      590                                                       ,input p-code as integer):
      591   define variable v-seq-val as integer no-undo .
      592   define buffer buf_code-range for ub.code-range.
      593   find first buf_code-range no-lock where
      594             buf_code-range.db-num = p-db-num
      595       and  buf_code-range.range-type = p-range-type
      596       and  buf_code-range.stts = 'u'
      597       and buf_code-range.first-code <= p-code
      598       and buf_code-range.last-code >= p-code no-error .
      599   if available buf_code-range then return yes.
      600   CASE p-range-type:
      601     when 'pngb':U then do:
      602       v-seq-val = current-value(s-pngb-code, ub).
      603     end.
      604     when 'fmgb':U then do:
      605       v-seq-val = current-value(s-fmgb-code, ub).
      606     end.
      607   END CASE.
      608   if p-code <= v-seq-val then do:
      609     find first buf_code-range no-lock where
      610               buf_code-range.db-num = p-db-num
      611         and  buf_code-range.range-type = p-range-type
      612         and  buf_code-range.stts = 'a'
      613         and buf_code-range.first-code <= p-code
      614         no-error .
      615    if available buf_code-range then return yes.
      616   end.
      617   find first buf_code-range no-lock where
      618             buf_code-range.db-num = p-db-num
      619       and  buf_code-range.range-type = p-range-type
      620       and  buf_code-range.stts = 'f'
      621       and buf_code-range.first-code <= p-code
      622       and buf_code-range.last-code >= p-code
      623       no-error .
      624   if available buf_code-range then return yes.
      625   return no.
      626   END FUNCTION.
      627   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      628                                                       ,input p-range-type as character
      629                                                       ,input p-code as integer):
      630   define variable v-seq-val as integer no-undo .
      631   define buffer buf_code-range for ub.code-range.
      632   CASE p-range-type:
      633     when 'pngb':U then do:
      634       v-seq-val = current-value(s-pngb-code, ub).
      635     end.
      636     when 'fmgb':U then do:
      637       v-seq-val = current-value(s-fmgb-code, ub).
      638     end.
      639   END CASE.
      640   if p-code <= v-seq-val then do:
      641     find first buf_code-range no-lock where
      642               buf_code-range.db-num = p-db-num
      643         and  buf_code-range.range-type = p-range-type
      644         and buf_code-range.first-code <= p-code
      645         and buf_code-range.last-code >= p-code no-error .
      646     if available buf_code-range then return yes.
      647   end.
      648   return no.
      649   END FUNCTION.
      650   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      651                                                       ,input p-db-num as integer
      652                                                       ,input p-staff-code as integer
      653                                                       ,input p-date as date
      654                                                        ):
      655   define buffer buf_staff for ub.staff.
      656   if p-date = ? then do:
      657     p-date = today .
      658   end.
      659   find first buf_staff no-lock where
      660             buf_staff.role = p-role
      661         and buf_staff.role-level = 'db':U
      662         and buf_staff.db-num = p-db-num
      663         and buf_staff.staff-code = p-staff-code
      664         and buf_staff.date-end >= p-date use-index pi  no-error .
      665   if available buf_staff then do:
      666     return buf_staff.psn-code.
      667   end.
      668   return 0.
      669   end FUNCTION.
      670   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      671                                                             ,input p-db-num as integer
      672                                                             ,input p-date as date
      673                                                                 ):
      674   define buffer buf_staff for ub.staff.
      675   define buffer buf2_staff for ub.staff.
      676   if p-date = ? then do:
      677     p-date = today .
      678   end.
      679   for each  buf_staff no-lock where
      680             buf_staff.role = p-role
      681         and buf_staff.db-num = p-db-num,
      682   first buf2_staff no-lock where
      683         buf2_staff.role = p-role
      684     and buf2_staff.role-level = 'db':U
      685     and buf2_staff.staff-code = buf_staff.staff-code
      686     and buf2_staff.date-start <= p-date
      687     and buf2_staff.date-end >= p-date
      688   by buf_staff.staff-code
      689   by date-start descending:
      690     return buf_staff.staff-code.
      691   end.
      692   end FUNCTION.
      693   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      694                                                  ,input p-db-num as integer
      695                                                  ,input p-psn-code as integer
      696                                                  ,input p-date as date
      697                                                  ,output p-c-password as character
      698                                                        ):
      699   define buffer buf_staff for ub.staff.
      700   if p-date = ? then do:
      701     p-date = today .
      702   end.
      703   find first buf_staff no-lock where
      704             buf_staff.role = p-role
      705         and buf_staff.role-level = 'db':U
      706         and buf_staff.db-num = p-db-num
      707        and buf_staff.date-end >= p-date
      708        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      709   if available buf_staff
      710   then do:
      711     assign
      712     p-c-password = buf_staff.password.
      713     return buf_staff.staff-code.
      714   end.
      715   p-c-password = ''.
      716   return 0.
      717   end FUNCTION.
      718   FUNCTION gbclcode-is-psn-role returns integer (
      719                                                 input p-role as character
      720                                                 ,input p-psn-code as integer
      721                                                 ,input p-date as date
      722                                                     ):
      723   define buffer buf_staff for ub.staff.
      724   if p-date = ? then do:
      725     p-date = today .
      726   end.
      727   for each buf_staff no-lock where
      728             buf_staff.psn-code = p-psn-code
      729        and  buf_staff.role = p-role
      730   by buf_staff.role-level
      731   by buf_staff.date-start
      732        :
      733     if  buf_staff.date-start <= p-date and
      734     buf_staff.date-end >= p-date  then do:
      735       return buf_staff.staff-code.
      736     end.
      737   end.
      738   return 0.
      739   end FUNCTION.
      740   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      741   define variable v-role-name as character no-undo .
      742   assign
      743   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      744   no-error .
      745   return v-role-name.
      746   END.
      747   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      748   FUNCTION gbclcode-get-position returns character ( input p-role as character
      749                                                     ,input p-role-level as character
      750                                                     ,input p-work-place as character
      751                                                     ,input p-staff-code as integer
      752                                                                ):
      753   define variable v-role-name as character no-undo .
      754   define variable v-role-level as character no-undo .
      755   define variable v-staff-code as integer no-undo .
      756   assign
      757   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      758   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      759   v-staff-code = p-staff-code
      760   no-error .
      761   return substitute("&1, &2, Код &3"
      762                   ,v-role-name
      763                   ,v-role-level
      764                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      765   END.
      766   FUNCTION gbclcode-get-work-place returns character (
      767                                                   input p-role as character
      768                                                  ,input p-role-level as character
      769                                                  ,input p-db-num as integer
      770                                                  ,input p-host-code as integer
      771                                                  ,input p-obj-type as character
      772                                                  ,input p-obj-code as integer
      773                                                  ) :
      774   define variable v-work-place as character no-undo .
      775   define variable v-obj-type as character no-undo .
      776     case p-role-level:
      777       when 'db':U then do:
      778         v-work-place = string(p-db-num, "99999").
      779       end.
      780       when 'firm':U then do:
      781         v-work-place = string(p-host-code, "99999").
      782       end.
      783       when 'object':U then do:
      784         assign
      785         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      786         .
      787       end.
      788     END CASE.
      789     return v-work-place.
      790   END FUNCTION.
      791   FUNCTION gbclcode-get-level-last-code returns integer (
      792                                                           input p-role as character
      793                                                         , input p-role-level as character
      794                                                         , input p-work-place as character
      795                                                         , input p-date-start as date
      796                                                         ):
      797   DEFINE VARIABLE v-today as date no-undo .
      798   define buffer buf_staff for ub.staff.
      799   if p-work-place = chr(63) then return ?.
      800   if p-date-start = ? then do:
      801     v-today = today .
      802   end.
      803   else do:
      804     v-today = p-date-start.
      805   end.
      806   find last buf_staff no-lock where
      807             buf_staff.role = p-role
      808        and  buf_staff.role-level = p-role-level
      809        and  buf_staff.work-place = p-work-place
      810        and  buf_staff.date-start <= v-today + 1
      811        and  buf_staff.date-end >= v-today + 1
      812        use-index pi  no-error .
      813   if available buf_staff
      814   then return buf_staff.staff-code.
      815   return 0.
      816   end FUNCTION.
