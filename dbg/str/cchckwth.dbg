      839     return varshift-name-num.
      840   end function.
      841   FUNCTION get-cash-pay RETURNS CHARACTER
      842     ( input parpay-code as integer, parcurr-code as integer, OUTPUT p-wth-code AS INTEGER )  FORWARD.
      843   DEFINE BUTTON B-Help
      844        LABEL "Помо&щь"
      845        SIZE 3 BY 1
      846        BGCOLOR 8 .
      847   DEFINE BUTTON B-next AUTO-GO
      848        LABEL "&>>"
      849        SIZE 4 BY 1.
      850   DEFINE BUTTON B-prev AUTO-GO
      851        LABEL "&<<"
      852        SIZE 4 BY 1.
