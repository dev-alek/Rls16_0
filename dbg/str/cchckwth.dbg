      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define new global shared variable g#language as character no-undo .
      128   if g#language <> '' and g#language <> 'rus':U then do:
      129     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      130   end.
      131   define new global shared variable g#library  as handle no-undo .
      132   define new global shared variable g#library2 as handle no-undo .
      133   define   shared variable g#auto as logical no-undo.
      134   define   shared variable g#news as logical no-undo.
      135   define   shared variable g#oxml as logical no-undo.
      136   define   shared variable g#esys as logical no-undo.
      137   define   shared variable g#news-source-db as integer no-undo.
      138   define   shared variable g#esys-source-esys as integer no-undo.
      139   define   shared variable g#db-num as integer   no-undo .
      140   define   shared variable g#userid as character no-undo .
      141   define   shared variable g#passwd as character no-undo .
      142   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      143   procedure cur-time :
      144      define output parameter p-today as date      no-undo .
      145      define output parameter p-time  as integer   no-undo .
      146     do
      147     on error undo, return error
      148     :
      149       define variable v-date1 as date      no-undo .
      150       define variable v-date2 as date      no-undo .
      151       define variable v-time  as integer   no-undo .
      152       assign
      153         v-date1 = today
      154         v-time  = time
      155         v-date2 = today
      156       .
      157       if v-date1 <> v-date2
      158       then do:
      159         assign
      160           v-date1 = today
      161           v-time  = v-time
      162         .
      163       end.
      164       assign
      165         p-today = v-date1
      166         p-time  = v-time
      167       .
      168     end.
      169   end.
      170   function cur-time-date returns character
      171   :
      172     return string(today, '99/99/9999':U) .
      173   end.
      174   function cur-time-mjd returns decimal
      175   :
      176     define variable v-date as date      no-undo .
      177     define variable v-time as integer   no-undo .
      178     run cur-time in this-procedure
      179       (output v-date
      180       ,output v-time
      181       ) .
      182     return integer(v-date) - 2400002 + (v-time / 86400) .
      183   end.
      184   function cur-time-get-ending-index returns integer
      185   (input p-number as integer
      186   )
      187   :
      188     if p-number < 0
      189     or p-number = ?
      190     then do:
      191       return 1 .
      192     end.
      193     define variable v-rest as integer   no-undo .
      194     assign
      195       p-number = p-number modulo 100
      196     .
      197     if p-number < 20
      198     then do:
      199       assign
      200         v-rest = p-number
      201       .
      202     end.
      203     else do:
      204       assign
      205         v-rest = p-number modulo 10
      206       .
      207     end.
      208     case v-rest :
      209       when 1
      210       then do:
      211         return 2 .
      212       end.
      213       when 2 or
      214       when 3 or
      215       when 4
      216       then do:
      217         return 3 .
      218       end.
      219       otherwise do:
      220         return 1 .
      221       end.
      222     end case .
      223   end.
      224   procedure cur-time-mjd-to-date :
      225      define input  parameter i-mjd-diff as decimal no-undo.
      226      define output parameter o-Date     as date    no-undo.
      227      define output parameter o-Time     as integer no-undo.
      228      define variable v-day-number as integer   no-undo .
      229      if    i-mjd-diff < 0
      230         or i-mjd-diff = ?
      231      then do:
      232         return "?" .
      233      end.
      234      assign
      235         v-day-number = truncate(i-mjd-diff,0).
      236         o-Date = date(v-day-number + 2400002).
      237         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      238     .
      239   end.
      240   function cur-time-mjd-to-string returns character
      241   (input p-mjd-diff as decimal
      242   )
      243   :
      244     define variable v-day-number as integer   no-undo .
      245     define variable v-seconds    as integer   no-undo .
      246     define variable v-hour       as integer   no-undo .
      247     define variable v-min        as integer   no-undo .
      248     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      249     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      250     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      251     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      252     if p-mjd-diff < 0
      253     or p-mjd-diff = ?
      254     then do:
      255       return "?" .
      256     end.
      257     assign
      258       v-day-number = integer(truncate(p-mjd-diff,0))
      259       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      260     .
      261     if v-seconds > 86400
      262     then do:
      263       assign
      264         v-seconds = 86400 - 1
      265       .
      266     end.
      267     if v-seconds < 0
      268     then do:
      269       assign
      270         v-seconds = 0
      271       .
      272     end.
      273     assign
      274       v-hour = truncate(v-seconds / 3600, 0)
      275     .
      276     assign
      277       v-seconds = v-seconds modulo 3600
      278     .
      279     assign
      280       v-min = truncate(v-seconds / 60, 0)
      281     .
      282     assign
      283       v-seconds = v-seconds modulo 60
      284     .
      285     return
      286         (if v-day-number <> 0
      287           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      288           else ""
      289         )
      290       + (if v-day-number <> 0 or v-hour <> 0
      291           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      292           else ""
      293         )
      294       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      295           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      296           else ""
      297         )
      298       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      299       .
      300   end.
      301   function cur-time-string returns character
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      310   end.
      311   function cur-time-string-sec returns character
      312   :
      313     define variable v-date as date      no-undo .
      314     define variable v-time as integer   no-undo .
      315     run cur-time in this-procedure
      316       (output v-date
      317       ,output v-time
      318       ) .
      319     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      320   end.
      321   function cur-time-custom  returns character
      322   (input p-prefix as character
      323   ,input p-date-format as character
      324   ,input p-delimiter as character
      325   ,input p-time-format as character
      326   ,input p-suffix as character
      327   )
      328   :
      329     define variable v-date as date      no-undo .
      330     define variable v-time as integer   no-undo .
      331     run cur-time in this-procedure
      332       (output v-date
      333       ,output v-time
      334       ) .
      335     return
      336       p-prefix
      337       + string(v-date, p-date-format)
      338       + p-delimiter
      339       + string(v-time, p-time-format)
      340       + p-suffix
      341       .
      342   end.
      343   function cur-time-print  returns character
      344   :
      345     define variable v-date as date      no-undo .
      346     define variable v-time as integer   no-undo .
      347     run cur-time in this-procedure
      348       (output v-date
      349       ,output v-time
      350       ) .
      351     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      352   end.
      353   function cur-time-datetime returns datetime
      354   :
      355     define variable v-char as character no-undo .
      356     define variable v-datetime as datetime no-undo .
      357     v-char = cur-time-string().
      358     v-datetime = datetime(v-char).
      359     return  v-datetime.
      360   end.
      361   function cur-time-string-msec returns character
      362   :
      363     define variable v-date as datetime  no-undo .
      364     v-date = now.
      365     return string(v-date) .
      366   end.
