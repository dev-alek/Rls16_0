       40   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
       41   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
       42   define variable vss-date        as character no-undo initial "$Date: 2014/01/27 14:27:46 $":U .
       43   define variable vss-workfile    as character no-undo initial "$Workfile: cor-line.p $":U .
       44   define variable vss-archive     as character no-undo initial "$Archive: str/cor-line.p $":U .
       45   define variable vss-description as character no-undo initial "Редактирование линии внешней приходной накладной":U .
       46   procedure vss-get-info :
       47     define output parameter p-vss-revision    like vss-revision    no-undo .
       48     define output parameter p-vss-author      like vss-author      no-undo .
       49     define output parameter p-vss-date        like vss-date        no-undo .
       50     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       51     define output parameter p-vss-archive     like vss-archive     no-undo .
       52     define output parameter p-vss-description like vss-description no-undo .
       53     assign
       54       p-vss-revision    = vss-revision
       55       p-vss-author      = vss-author
       56       p-vss-date        = vss-date
       57       p-vss-workfile    = vss-workfile
       58       p-vss-archive     = vss-archive
       59       p-vss-description = vss-description
       60     .
       61   end procedure.
       62   procedure vss-get-parameters :
       63     define output parameter p-vss-parameters as character no-undo .
       64       assign
       65         p-vss-parameters = substitute('&1|&2|&3':u,substitute('&1|&2|&3|&4|&5|&6':u,parprod-type,parprod-code,parartic,parcli-qnty,parcli-base-rate,parfact-qnty,pardoc-qnty),substitute('&1|&2|&3|&4|&5|&6':u,parunit-cli,parvat-pc,parslt-pc,parprice-cli,parprice-base,parprice-rubl,parnum-place),substitute('&1|&2|&3|&4|&5|&6|&7':u,parwt-brutto,parroad-tax,parexcise,pardoc-density,parfact-density,partemperature,parcontract-code,parcst-code,parlast-date))
       66       .
       67   end procedure.
       68   define new global shared variable g#vssrevis-logger as handle    no-undo .
       69   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       70   define variable v-vssrevis-logger                   as handle    no-undo .
       71   procedure vss-logevent :
       72     define input  parameter p-extra-paramters as character no-undo .
       73     define variable v-vssrevis-parameters as character no-undo .
       74     do
       75     on error undo, return error return-value
       76     :
       77       if  valid-handle(v-vssrevis-logger)
       78       and v-vssrevis-logger :get-signature("logevent") <> ""
       79       then do:
       80         run vss-get-parameters in this-procedure
       81           (output v-vssrevis-parameters
       82           ).
       83         run logevent in v-vssrevis-logger
       84           (input vss-workfile
       85           ,input vss-revision
       86           ,input v-vssrevis-parameters
       87           ,input p-extra-paramters
       88           ).
       89       end.
       90     end.
       91   end procedure.
       92   assign
       93     v-vssrevis-logger = g#vssrevis-logger
       94   .
       95   if  valid-handle(v-vssrevis-logger)
       96   and v-vssrevis-logger :get-signature("logevent") <> ""
       97   then do:
       98     assign
       99       v-vssrevis-logevent = true
      100     .
      101     run vss-logevent in this-procedure (input vss-description) .
      102   end.
