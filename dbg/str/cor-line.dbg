      401     end.
      402   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_copy-inh in g#lib-trn
      403   ( input parparentproc
      404    ,input recid(t-doc)
      405    ,input 'cr-upd'
      406    ,input yes
      407    ,input yes
      408    ,input table lib-trn_ret-doc
      409    ,input table lib-trn_ret-line
      410    ,input table lib-trn_ret-line-attr
      411    ,input table lib-trn_ret-dtl
      412    ,input table lib-trn_ret-parts
      413     ) no-error .
      414     if error-status :error then do:
      415       message "Ошибка при пересчете линии документа (cor-line.p)" skip
      416               return-value                 skip
      417               error-status :get-message(1) skip
      418       view-as alert-box error.
      419       undo, return error.
      420     end.
      421     find first new-doc-line where new-doc-line.doc-code  = t-doc.doc-code        and
      422                                   new-doc-line.artic     = tt-doc-line.artic     and
      423                                   new-doc-line.prod-type = tt-doc-line.prod-type and
      424                                   new-doc-line.prod-code = tt-doc-line.prod-code no-error .
      425     if error-status :error then return .
      426     assign
      427       par-rec-doc-line = recid(new-doc-line).
      428     if tt-doc-line.cst-code <> ? then do:
      429       assign
      430         varaddparam = 'cst-code':U + '=':u
      431                     + str-encode (tt-doc-line.cst-code, '', ',=':u )
      432       .
      433     end.
      434     if tt-doc-line.contract-code <> ? then do:
      435       assign
      436         varaddparam = (if varaddparam = '' then '' else varaddparam + ',') +
      437                       'contract-code':U + '=':u +
      438                       str-encode (string(tt-doc-line.contract-code), '', ',=':u )
      439       .
      440     end.
      441     if tt-doc-line.last-date <> ? then do:
      442       assign
      443         varaddparam = (if varaddparam = '' then '' else varaddparam + ',') +
      444                       'last-date':U + '=':u +
      445                       str-encode (string(tt-doc-line.last-date), '', ',=':u )
