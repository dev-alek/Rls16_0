      136   function octal-to-char return character
      137   ( p-string as character ) :
      138     def var v-asc     as integer no-undo .
      139     def var v-new-asc as integer no-undo .
      140     def var ind       as integer no-undo .
      141     if length(p-string) <> 3 then do:
      142       return ? .
      143     end.
      144     assign
      145       v-asc = 0
      146     .
      147     do ind = 1 to length(p-string)
      148     :
      149       assign
      150         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      151       .
      152       if v-new-asc < 0 or v-new-asc >= 8 then do:
      153         return ? .
      154       end.
      155       assign
      156         v-asc = v-asc * 8 + v-new-asc
      157       .
      158     end.
      159     return chr(v-asc) .
      160   end function .
      161   function char-to-octal return character
      162   ( p-chr as character ) :
      163     def var v-asc    as integer   no-undo .
      164     def var ind      as integer   no-undo .
      165     def var v-string as character no-undo .
      166     if length(p-chr) <> 1 then do:
      167       return ? .
      168     end.
      169     assign
      170       v-asc    = asc(p-chr)
      171       v-string = ""
      172     .
      173     do ind = 1 to 3
      174     :
      175       assign
      176         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      177       .
      178       assign
      179         v-asc = truncate(v-asc / 8, 0)
      180       .
      181     end.
      182     return v-string .
      183   end.
      184   function str-encode return character
      185   (   p-init-string       as character
      186     , p-encode-char       as character
      187     , p-special-char-list as character
      188   ) :
      189     def var p-encode-string as character no-undo .
      190     def var ind                as integer no-undo .
      191     def var v-num-special-char as integer no-undo .
      192     def var v-special-char     as character no-undo .
      193     if p-encode-char = ?
      194     or p-encode-char = "" then do:
      195       assign
      196         p-encode-char = "~~"
      197       .
      198     end.
      199     if p-init-string = ? then do:
      200       return "?" .
      201     end.
      202     if p-init-string = "?" then do:
      203       return p-encode-char + char-to-octal("?") .
      204     end.
      205     assign
      206       v-num-special-char = length(p-special-char-list)
      207       p-encode-string    = replace(p-init-string
      208                                   ,p-encode-char
      209                                   ,p-encode-char + char-to-octal(p-encode-char)
      210                                   )
      211     .
      212     do ind = 1 to v-num-special-char
      213     :
      214       assign
      215         v-special-char = substring(p-special-char-list, ind, 1)
      216       .
      217       if v-special-char <> p-encode-char then do:
      218         assign
      219           p-encode-string = replace (p-encode-string
      220                                     ,v-special-char
      221                                     ,p-encode-char + char-to-octal(v-special-char)
      222                                     )
      223         .
      224       end.
      225     end.
      226     return p-encode-string .
      227   end.
      228   function str-decode returns character
      229     (p-init-string   as character
      230     ,p-encode-char   as character
      231     ) :
      232     def var p-decode-string as character no-undo .
      233     def var ind                       as integer no-undo .
      234     def var v-num-entries-init-string as integer no-undo .
      235     def var v-sub-phrase              as character no-undo .
      236     def var v-special-char            as character no-undo .
      237     if p-encode-char = ?
      238     or p-encode-char = "" then do:
      239       assign
      240         p-encode-char = "~~"
      241       .
      242     end.
      243     if p-init-string = "?" then do:
      244       return ? .
      245     end.
      246     assign
      247       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      248     .
      249     if v-num-entries-init-string > 1 then do:
      250       assign
      251         p-decode-string = entry(1, p-init-string, p-encode-char)
      252       .
      253       do ind = 2 to v-num-entries-init-string
      254       :
      255         assign
      256           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      257         .
      258         assign
      259           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      260         .
      261         if v-special-char <> ? then do:
      262           assign
      263             p-decode-string = p-decode-string
      264                             + v-special-char
      265                             + substring(v-sub-phrase, 4)
      266           .
      267         end.
      268         else do:
      269           assign
      270             p-decode-string = p-decode-string
      271                             + p-encode-char
      272                             + v-sub-phrase
      273           .
      274         end.
      275       end.
      276     end.
      277     else do:
      278       assign
      279         p-decode-string = p-init-string
      280       .
      281     end.
      282     return p-decode-string .
      283   end.
      284   define buffer t-doc        for ub.trn-doc.
      285   define buffer new-doc-line for ub.doc-line.
      286   define buffer bf_doc-pl    for ub.doc-pl.
