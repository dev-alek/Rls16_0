      310     .
      311   define temp-table old-doc-line no-undo like ub.doc-line.
      312   do
      313   on error undo, return error return-value
      314   :
      315     find first t-doc
      316       where t-doc.doc-code = pardoc-code
      317     .
      318     create tt-doc-line.
      319     assign
      320    TT-doc-line.doc-code                 = pardoc-code
      321    TT-doc-line.prod-type                = parprod-type
      322    TT-doc-line.prod-code                = parprod-code
      323    TT-doc-line.artic                    = parartic
      324    TT-doc-line.cli-qnty                 = parcli-qnty
      325    TT-doc-line.cli-base-rate            = parcli-base-rate
      326    TT-doc-line.fact-qnty                = parfact-qnty
      327    TT-doc-line.doc-qnty                 = pardoc-qnty
      328    TT-doc-line.unit-cli                 = parunit-cli
      329    TT-doc-line.vat-pc                   = parvat-pc
      330    TT-doc-line.slt-pc                   = parslt-pc
      331    TT-doc-line.price-cli                = parprice-cli
      332    TT-doc-line.price-base               = parprice-base
      333    TT-doc-line.price-rubl               = parprice-rubl
      334    TT-doc-line.new-price-sale           = parnew-price-sale
      335    TT-doc-line.num-place                = parnum-place
      336    TT-doc-line.wt-brutto                = parwt-brutto
      337    TT-doc-line.road-tax                 = parroad-tax
      338    TT-doc-line.excise                   = parexcise
      339    TT-doc-line.doc-density              = pardoc-density
      340    TT-doc-line.temperature              = partemperature
      341    TT-doc-line.contract-code            = parcontract-code
      342    TT-doc-line.last-date                = parlast-date
      343    TT-doc-line.fact-qnty-kg             = parfact-qnty-kg
      344    TT-doc-line.fact-density             = parfact-density
      345    TT-doc-line.cst-code                 = parcst-code
      346    TT-doc-line.alc-update               = paralc-update
      347    TT-doc-line.part-code                = paralc-part-code
      348    TT-doc-line.alc-mark-db-num          = paralc-mark-db-num
      349    TT-doc-line.alc-mark-code            = paralc-mark-code
      350    TT-doc-line.alc-bottling-date        = paralc-bottling-date
      351    TT-doc-line.alc-ref-ab-path          = paralc-ref-ab-path
      352    TT-doc-line.alc-quality-certif-path  = paralc-quality-certif-path
      353    TT-doc-line.alc-imp-type             = paralc-imp-type
      354    TT-doc-line.alc-imp-code             = paralc-imp-code
      355    TT-doc-line.alc-certif-path          = paralc-certif-path
      356     .
      357     if t-doc.status_ = 'накл':U
      358       and t-doc.flag = no
      359     then do:
      360       assign
      361         tt-doc-line.fact-density = tt-doc-line.doc-density
      362         tt-doc-line.fact-qnty    = pardoc-qnty
      363         tt-doc-line.fact-qnty-kg = pardoc-qnty * tt-doc-line.doc-density
      364       .
      365     end.
      366     else do:
      367       assign
      368         tt-doc-line.fact-qnty    = parfact-qnty
      369         tt-doc-line.fact-qnty-kg = parfact-qnty * tt-doc-line.fact-density
      370       .
      371     end.
      372     find first ub.goods no-lock where
      373               ub.goods.artic     = parartic     and
      374               ub.goods.prod-type = parprod-type and
      375               ub.goods.prod-code = parprod-code.
      376     for each lib-trn_ret-doc:
