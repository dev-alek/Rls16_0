     2201   procedure cp-attr-value :
     2202     do
     2203     on error undo, return error
     2204     :
     2205       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2206       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2207       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2208       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2209       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2210       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     2211       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     2212       define output parameter p-type        as character no-undo .
     2213       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2214       define variable v-format         as character no-undo .
     2215       define variable v-label          as character no-undo .
     2216       define variable v-range          as integer   no-undo .
     2217       define variable v-user-can-edit  as logical   no-undo .
     2218       define variable v-output-display as logical   no-undo .
     2219       define variable v-other          as character no-undo .
     2220       run cp-attr-code in this-procedure
     2221         (input  p-code
     2222         ,output p-type
     2223         ,output v-format
     2224         ,output v-label
     2225         ,output v-range
     2226         ,output v-user-can-edit
     2227         ,output v-output-display
     2228         ,output v-other
     2229         ) no-error .
     2230       if error-status :error then do:
     2231         undo, return error return-value .
     2232       end.
     2233       find first buf_cash-pay-attr no-lock
     2234         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2235           and buf_cash-pay-attr.curr-code  = p-curr-code
     2236           and buf_cash-pay-attr.host-code  = p-host-code
     2237           and buf_cash-pay-attr.obj-type   = p-obj-type
     2238           and buf_cash-pay-attr.obj-code   = p-obj-code
     2239           and buf_cash-pay-attr.attr-code  = p-code
     2240         no-error .
     2241       if avail buf_cash-pay-attr then do:
     2242         assign
     2243           p-value =  buf_cash-pay-attr.attr-value
     2244         .
     2245       end.
     2246       else do:
     2247         assign
     2248           p-value = if p-type = 'L':U then "no":U else ""
     2249         .
     2250       end.
     2251     end.
     2252   end procedure.
     2253   procedure cp-attr-write :
     2254     do
     2255     on error undo, return error
     2256     :
     2257       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2258       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2259       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2260       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2261       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2262       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2263       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     2264       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2265       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     2266       define variable v-type           as character no-undo .
