     1269   procedure xml-cd-write-header:
     1270   do
     1271   on error undo, return error
     1272   :
     1273   define input parameter p-xml-file-name       as character    no-undo.
     1274   define input parameter p-xml-file-name-path  as character    no-undo.
     1275   define input parameter p-doc-name            as character    no-undo.
     1276   define input parameter p-version             as character    no-undo.
     1277   define input parameter p-obj-list            as character    no-undo.
     1278   define input parameter p-correspondent       as character    no-undo .
     1279   define input parameter p-write-header        as logical      no-undo .
     1280   define variable OS-time as character no-undo .
     1281   define variable id as character no-undo .
     1282   define buffer buf_db for ub.db.
     1283   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1284   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1285   assign
     1286   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1287   .
     1288   run bgelib-tag-open in this-procedure (
     1289                                        1
     1290                                       ,p-doc-name
     1291                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1292                                         ).
     1293   if p-write-header then do:
     1294     run bgelib-tag-open(2, "Header","").
     1295     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1296     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1297     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1298     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1299     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1300     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1301     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1302     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1303     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1304     run bgelib-tag-close( 2, "Header" ).
     1305   end.
     1306   output stream stmXMLOut close.
     1307   end.
     1308   end procedure.
     1309   procedure xml-cd-write-footer:
     1310   do
     1311   on error undo, return error
     1312   :
     1313   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1314   define input parameter p-xml-file-name as character    no-undo.
     1315   define input parameter p-doc-name      as character    no-undo .
     1316   define variable v-error-num     as integer           no-undo.
     1317   define variable v-md5-signature as character no-undo .
     1318   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1319   run bgelib-tag-close( 0, p-doc-name ).
     1320   put stream stmXMLOut unformatted skip.
     1321   output stream stmXMLOut close.
     1322   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1323   if v-error-num > 0
     1324   then do:
     1325      return error.
     1326   end.
     1327   if opsys = "unix"
     1328   then do:
     1329       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1330   end.
     1331   end.
     1332   end procedure.
     1333   procedure xml-cd-filename :
     1334   do
     1335   on error undo, return error
     1336   :
     1337   define input parameter  p-out               as character no-undo .
     1338   define output parameter p-xml-file-name     as character    no-undo.
     1339   define output parameter p-xml-file-name-path   as character    no-undo.
     1340   define output parameter p-log-file-name     as character    no-undo.
     1341   define output parameter p-locked            as logical      no-undo.
     1342   define variable v-out as character     no-undo.
     1343   define variable loc#log as logical no-undo .
     1344   define variable BadFlag as logical no-undo .
     1345   define variable fq as integer no-undo .
     1346   define variable v-remote as character no-undo .
     1347   assign
     1348   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1349   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1350   p-log-file-name = p-out + "actions.log"
     1351   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1352   .
     1353   end.
     1354   end procedure.
     1355   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1356   define variable v-date-str as character no-undo .
     1357   assign
     1358   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1359                string(Month(p-date), "99":U) + "-":U +
     1360                string(DAY(p-date), "99":U).
     1361   return v-date-str.
     1362   END FUNCTION.
     1363   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1364   define variable v-date-str as character no-undo .
     1365   assign
     1366   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1367                string(Month(p-date), "99":U) + "-":U +
     1368                string(DAY(p-date), "99":U) + chr(32) +
     1369                string(p-time, "HH:MM:SS").
     1370   return v-date-str.
     1371   END FUNCTION.
     1372   function string-to-date returns date ( input p-string  as character):
     1373     define variable v-date as date no-undo .
     1374     assign
     1375     v-date = date(integer(substring(p-string, 4, 2))
     1376                   ,integer(substring(p-string, 1, 2))
     1377                   ,integer(substring(p-string, 7, 4))
     1378                  ) no-error .
     1379     if error-status:error then return ?.
     1380     return v-date.
     1381   END FUNCTION.
     1382   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1383   define variable v-time as integer no-undo init ?.
     1384   define variable v-dop1 as character no-undo .
     1385   define variable v-dop2 as character no-undo .
     1386   assign
     1387   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1388   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1389   no-error .
     1390   if error-status:error then return ?.
     1391   assign
     1392   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1393             integer(entry(2, v-dop2, ";":U)) * 60 +
     1394             integer(entry(3, v-dop2, ";":U)) no-error .
     1395   return v-time.
     1396   END FUNCTION.
