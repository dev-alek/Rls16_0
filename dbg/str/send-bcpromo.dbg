     2359   procedure cp-attr-delete :
     2360     do
     2361     on error undo, return error
     2362     :
     2363       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2364       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2365       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2366       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2367       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2368       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2369       define output parameter p-deleted  as logical no-undo.
     2370       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2371       define variable v-type           as character no-undo .
     2372       define variable v-format         as character no-undo .
     2373       define variable v-label          as character no-undo .
     2374       define variable v-range          as integer   no-undo .
     2375       define variable v-user-can-edit  as logical   no-undo .
     2376       define variable v-output-display as logical   no-undo .
     2377       define variable v-other          as character no-undo .
     2378       run cp-attr-code in this-procedure
     2379         (input  p-code
     2380         ,output v-type
     2381         ,output v-format
     2382         ,output v-label
     2383         ,output v-range
     2384         ,output v-user-can-edit
     2385         ,output v-output-display
     2386         ,output v-other
     2387         ) no-error .
     2388       if error-status :error then do:
     2389         undo, return error return-value .
     2390       end.
     2391       find first buf_cash-pay-attr exclusive-lock
     2392         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2393           and buf_cash-pay-attr.curr-code  = p-curr-code
     2394           and buf_cash-pay-attr.host-code  = p-host-code
     2395           and buf_cash-pay-attr.obj-type   = p-obj-type
     2396           and buf_cash-pay-attr.obj-code   = p-obj-code
     2397           and buf_cash-pay-attr.attr-code = p-code
     2398         no-error NO-WAIT.
     2399       if not available buf_cash-pay-attr then do:
     2400         p-deleted = no.
     2401       end.
     2402       else do:
     2403         delete buf_cash-pay-attr no-error .
     2404         if error-status:error then do:
     2405           undo, return error return-value .
     2406         end.
     2407         p-deleted = yes.
     2408       end.
     2409     end.
     2410   end procedure.
     2411   procedure cp-attr-news :
     2412     do
     2413     on error undo, return error
     2414     :
     2415       define input  parameter p-code           as character no-undo .
