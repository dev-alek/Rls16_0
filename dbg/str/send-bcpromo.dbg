     2417       case p-code :
     2418               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     2419               when 'grp-code':U then do:     assign     p-news = true.   end.
     2420               when 'is-use':U then do:     assign     p-news = true.   end.
     2421               when 'dop-doc':U then do:     assign     p-news = true.   end.
     2422               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     2423               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     2424               when 'form_km3':U then do:     assign     p-news = false.   end.
     2425               when 'bal_malina':U then do:     assign     p-news = false.   end.
     2426               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     2427               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     2428         otherwise do:
     2429           p-news = no.
     2430         end.
     2431       end.
     2432     end.
     2433   end procedure.
