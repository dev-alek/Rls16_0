      596   procedure xmlchar-decode :
      597   define input parameter p-in-string      as character        no-undo.
      598   define output parameter p-out-string    as character        no-undo.
      599       define variable v-position      as integer      no-undo.
      600       define variable v-last-position as integer      no-undo.
      601       define variable v-temp-integer  as integer      no-undo.
      602       define variable v-current-char  as character    no-undo.
      603       define variable v-next-char     as character    no-undo.
      604       define variable v-success       as logical      no-undo.
      605   do
      606   on error undo, return error
      607   :
      608       assign
      609           p-out-string = "":U
      610           v-position   = 0
      611       .
      612       replace-cycle:
      613       do while yes
      614       on error undo, return error
      615       :
      616           assign
      617               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      618           .
      619           if v-last-position <= v-position
      620           then do:
      621               if v-position = 0
      622               then do:
      623                   assign
      624                       p-out-string = p-in-string
      625                   .
      626               end.
      627               else do:
      628                   assign
      629                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      630                   .
      631               end.
      632               leave replace-cycle.
      633           end.
      634           else do:
      635               assign
      636                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      637                   v-position      = v-last-position
      638                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      639               .
      640               if v-current-char = "#":U
      641               then do:
      642                   assign
      643                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      644                   .
      645                   if v-last-position > 0
      646                   then do:
      647                       run xmlchar-read-integer in this-procedure
      648                        (
      649                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      650                           , output v-temp-integer
      651                           , output v-success
      652                       ).
      653                       if v-success = yes
      654                       and v-temp-integer >= 1
      655                       and v-temp-integer <= 255
      656                       then do:
      657                           assign
      658                               p-out-string = p-out-string + chr( v-temp-integer )
      659                               v-position   = v-last-position + 1
      660                           .
      661                       end.
      662                       else do:
      663                           assign
      664                               p-out-string = p-out-string + "&":U
      665                               v-position   = v-position   + 1
      666                           .
      667                       end.
      668                   end.
      669                   else do:
      670                       assign
      671                           p-out-string = p-out-string + "&":U
      672                           v-position   = v-position   + 1
      673                       .
      674                   end.
      675               end.
      676               else do:
      677                   case substring( p-in-string, v-position + 1, 3 )
      678                   :
      679                       when "lt;":U
      680                       then do:
      681                           assign
      682                               p-out-string = p-out-string + "<":U
      683                               v-position   = v-position   + 3
      684                           .
      685                       end.
      686                       when "gt;":U
      687                       then do:
      688                           assign
      689                               p-out-string = p-out-string + ">":U
      690                               v-position   = v-position   + 3
      691                           .
      692                       end.
      693                       otherwise do:
      694                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      695                           then do:
      696                               assign
      697                                   p-out-string = p-out-string + "&":U
      698                                   v-position   = v-position   + 4
      699                               .
      700                           end.
      701                           else do:
      702                               case substring( p-in-string, v-position + 1, 5 )
      703                               :
      704                                   when "quot;":U
      705                                   then do:
      706                                       assign
      707                                           p-out-string = p-out-string + '"':U
      708                                           v-position   = v-position   + 5
      709                                       .
      710                                   end.
      711                                   when "apos;":U
      712                                   then do:
      713                                       assign
      714                                           p-out-string = p-out-string + "'":U
      715                                           v-position   = v-position   + 5
      716                                       .
      717                                   end.
      718                                   otherwise do:
      719                                       assign
      720                                           p-out-string = p-out-string + "&":U
      721                                       .
      722                                   end.
      723                               end case.
      724                           end.
      725                       end.
      726                   end case.
      727               end.
      728           end.
      729       end.
      730   end.
      731   end .
      732   procedure xmlchar-read-integer :
      733   define input parameter p-input-string      as character        no-undo.
      734   define output parameter p-output-integer   as integer          no-undo.
      735   define output parameter p-success       as logical          no-undo.
      736   do
      737   on error undo, return error
      738   :
      739       assign
      740           p-output-integer = integer( p-input-string )
      741       no-error.
      742       if error-status :error
      743       then do:
      744           assign
      745               p-success           = no
      746               p-output-integer    = 0
      747           .
      748       end.
      749       else do:
      750           assign
      751               p-success           = yes
      752           .
      753       end.
      754   end.
      755   end.
      756   define variable v-bgelib-bgeclall           as logical      no-undo.
      757   define variable v-bgelib-bgedict            as logical      no-undo.
      758   define temp-table temp_ext-doc-type no-undo
      759       field edt-key               as integer
      760       field ext-doc-type          as character
      761       field ext-doc-type-label    as character
      762       index pi is primary unique
      763           edt-key
      764   .
      765   define temp-table temp_bgelib_goods no-undo
      766       field gds-code as integer
      767       index pi is primary unique
      768           gds-code
      769   .
      770   define temp-table temp_bgelib_clients no-undo
      771       field obj-type as character
      772       field obj-code as integer
      773       index pi is primary unique
      774           obj-type
      775           obj-code
      776   .
      777   define temp-table temp_bgelib_dis-card no-undo
      778       field d-card as character
      779       index pi is primary unique
      780           d-card
      781   .
      782   define temp-table temp_bgelib_trn-doc no-undo
      783       field doc-code as integer
      784   .
      785   procedure bgelib-tag-open:
      786   do
      787   on error undo, return error
      788   :
      789   define input parameter v-tag-level  as integer      no-undo.
      790   define input parameter v-tag-name   as character    no-undo.
      791   define input parameter v-tag-value  as character    no-undo.
      792       put stream stmXMLOut unformatted
      793           chr(10)
      794           + fill(" ", 4 * v-tag-level)
      795           + "<" + v-tag-name
      796           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      797           + v-tag-value + ">"
      798       .
      799   end.
      800   end procedure.
      801   procedure bgelib-tag-put:
      802   do
      803   on error undo, return error
      804   :
      805   define input parameter v-tag-level      as integer      no-undo.
      806   define input parameter v-tag-name       as character    no-undo.
      807   define input parameter v-tag-value      as character    no-undo.
      808   define input parameter v-empty-mode     as integer      no-undo.
      809       v-tag-name = trim(v-tag-name).
      810       if  v-empty-mode = 1
      811       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      812       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      813       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      814       then do:
      815           run xmlchar-encode in this-procedure (
      816                 input v-tag-value
      817               , output v-tag-value
      818           ).
      819           put stream stmXMLOut unformatted
      820               chr(10) + fill(" ", 4 * v-tag-level)
      821                           + '<' + v-tag-name + '>'
      822                           + v-tag-value
      823                           + '</' + v-tag-name + '>'
      824           .
      825       end.
      826   end.
      827   end procedure.
      828   procedure bgelib-tag-close:
      829   do
      830   on error undo, return error
      831   :
      832   define input parameter v-tag-level as integer      no-undo.
      833   define input parameter v-tag-name  as character    no-undo.
      834       put stream stmXMLOut unformatted
      835           chr(10)
      836           + fill( " ", 4 * v-tag-level)
      837           + '</' + v-tag-name + '>'
      838       .
      839   end.
      840   end procedure.
      841   procedure bgelib-write-log:
      842   do
      843   on error undo, return error
      844   :
      845   define input parameter v-filename   as character    no-undo.
      846   define input parameter v-log-level  as integer      no-undo.
      847   define input parameter v-out-string as character    no-undo.
      848       output stream stmXMLLog to value( v-filename ) append.
      849       put stream stmXMLLog unformatted
      850           chr(10)
      851       .
      852       put stream stmXMLLog unformatted
      853           ( if v-log-level = 0
      854             or v-out-string = "&DLine"
      855             or v-out-string = "&Line"
      856             then ""
      857             else cur-time-string-sec() + " " )
      858       .
      859       put stream stmXMLLog unformatted
      860           ( if v-out-string = "&Line"
      861             then fill( "-", 80 )
      862             else if v-out-string = "&DLine"
      863                  then fill( "=", 80 )
      864                  else v-out-string )
      865       .
      866       output stream stmXMLLog close.
      867   end.
      868   end procedure.
      869   procedure bgelib-write-edt:
      870   do
      871   on error undo, return error
      872   :
      873   define input parameter v-editor-handle    as handle       no-undo.
      874   define input parameter v-log-level        as integer      no-undo.
      875   define input parameter v-out-string       as character    no-undo.
      876       if valid-handle ( v-editor-handle )
      877       then do:
      878           v-editor-handle :move-to-eof().
      879           v-editor-handle :insert-string( ( if v-log-level = 0
      880                                             or v-out-string = "&DLine"
      881                                             or v-out-string = "&Line"
      882                                             then ""
      883                                             else cur-time-string-sec() + " "
      884                                         ) ).
      885           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      886                                             then fill( "-", 80 )
      887                                             else if v-out-string = "&DLine" then fill("=", 80)
      888                                             else fill( " ", v-log-level) + v-out-string
      889                                         ) ).
      890           v-editor-handle :insert-string( chr(10) ).
      891       end.
      892       process events.
      893       output to 'bgescn.txt' append.
      894           put unformatted
      895               chr(10)
      896               string( ( if v-log-level = 0
      897                         or v-out-string = "&DLine"
      898                         or v-out-string = "&Line"
      899                         then ""
      900                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      901                     ) )
      902               string( ( if v-out-string = "&Line"
      903                         then fill( "-", 80 )
      904                         else if v-out-string = "&DLine"
      905                              then fill( "=", 80 )
      906                              else fill( " ", v-log-level ) + v-out-string
      907                     ) )
      908           .
      909       output close.
      910   end.
      911   end procedure.
      912   procedure bgelib-show-cnt:
      913   do
      914   on error undo, return error
      915   :
      916   define input parameter v-fillin-handle     as handle   no-undo.
      917       if valid-handle( v-fillin-handle )
      918       then do:
      919           assign
      920               v-fillin-handle :visible = true
      921           .
      922       end.
      923   end.
      924   end procedure.
      925   procedure bgelib-hide-cnt:
      926   do
      927   on error undo, return error
      928   :
      929   define input parameter v-fillin-handle     as handle   no-undo.
      930       if valid-handle( v-fillin-handle )
      931       then do:
      932           assign v-fillin-handle :visible = false.
      933       end.
      934   end.
      935   end procedure.
      936   procedure bgelib-write-cnt:
      937   do
      938   on error undo, return error
      939   :
      940   define input parameter v-fillin-handle    as handle       no-undo.
      941   define input parameter v-fillin-string    as character    no-undo.
      942       if valid-handle( v-fillin-handle )
      943       then do:
      944           assign
      945               v-fillin-handle :SCREEN-value = v-fillin-string
      946           .
      947       end.
      948   end.
      949   end procedure.
      950   procedure bgelib-write-header:
      951   do
      952   on error undo, return error
      953   :
      954   define input parameter p-first-file     as logical      no-undo.
      955   define input parameter p-xml-file-name  as character    no-undo.
      956   define input parameter p-list-file-name as character    no-undo.
      957   define input parameter p-file-number    as integer      no-undo.
      958   define input parameter p-have-prev      as logical      no-undo.
      959   define input parameter p-prev-filename  as character    no-undo.
      960   define input parameter p-obj-list       as character    no-undo.
      961   define input parameter p-doc-type-list  as character    no-undo.
      962   define input parameter p-parameter-list as character    no-undo.
      963       define variable v-counter    as integer        no-undo.
      964       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      965       put stream stmXMLOut unformatted
      966           "<?xml version='1.0' encoding='windows-1251'?>"
      967       .
      968       run bgelib-tag-open( input 0, input "root"  , input "" ).
      969       run bgelib-tag-open( input 0, input "header", input "" ).
      970       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      971       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      972       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      973       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      974       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      975       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      976       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      977       :
      978           run bgelib-tag-put(
      979                 input 1
      980               , input entry( 2 * v-counter, p-parameter-list )
      981               , input entry( 2 * v-counter + 1, p-parameter-list )
      982               , input 0
      983           ).
      984       end.
      985       run bgelib-tag-close( input 0, input "header" ).
      986       output stream stmXMLOut close.
      987       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      988       if p-first-file = yes
      989       then do:
      990           put stream stmXMLOut unformatted
      991               "<?xml version='1.0' encoding='windows-1251'?>"
      992           .
      993           run bgelib-tag-open( input 0, input "export", input "" ).
      994       end.
      995       run bgelib-tag-open( input 1, input "file", input "" ).
      996       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      997       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      998       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      999       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1000       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1001       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1002       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1003       :
     1004           run bgelib-tag-put(
     1005                 input 2
     1006               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1007               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1008               , input 0
     1009           ).
     1010       end.
     1011       run bgelib-tag-close( input 1, input "file" ).
     1012       output stream stmXMLOut close.
     1013   end.
     1014   end procedure.
     1015   procedure bgelib-write-footer:
     1016   do
     1017   on error undo, return error
     1018   :
     1019   define input parameter p-last-file      as logical      no-undo.
     1020   define input parameter p-xml-file-name  as character    no-undo.
     1021   define input parameter p-list-file-name as character    no-undo.
     1022   define input parameter p-have-next      as logical      no-undo.
     1023   define input parameter p-next-file-name as character    no-undo.
     1024       define variable v-error-num     as integer           no-undo.
     1025       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1026       if p-have-next = yes
     1027       then do:
     1028           run bgelib-tag-open( input 0, input "footer", "" ).
     1029           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1030           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1031           run bgelib-tag-close( input 0, input "footer" ).
     1032       end.
     1033       run bgelib-tag-close( input 0, input "root" ).
     1034       output stream stmXMLOut close.
     1035       run bge/os_copy.p (
     1036             input "M"
     1037           , input p-xml-file-name + "tmp"
     1038           , input p-xml-file-name + "xml"
     1039           , output v-error-num
     1040       ).
     1041       if p-last-file = yes
     1042       then do:
     1043           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1044               run bgelib-tag-close( input 0, input "export" ).
     1045           output stream stmXMLOut close.
     1046           run bge/os_copy.p (
     1047                 input "M"
     1048               , input p-list-file-name + "tmp"
     1049               , input p-list-file-name + "xml"
     1050               , output v-error-num
     1051           ).
     1052       end.
     1053   end.
     1054   end procedure.
     1055   procedure bgelib-filename :
     1056   do
     1057   on error undo, return error
     1058   :
     1059   define input parameter p-prefix             as character    no-undo.
     1060   define output parameter p-xml-file-name     as character    no-undo.
     1061   define output parameter p-log-file-name     as character    no-undo.
     1062   define output parameter p-list-file-name    as character    no-undo.
     1063       define variable v-home-dir  as character    no-undo.
     1064       define variable v-error-num as integer      no-undo.
     1065       get-key-value section "BGE" key "outdir" value v-home-dir.
     1066       if v-home-dir = ?
     1067       then do:
     1068           message
     1069             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1070             skip(1)
     1071             skip "Обратитесь к администратору."
     1072           view-as alert-box error.
     1073           undo, return error .
     1074       end.
     1075       run gbl/dir-cre.p (
     1076           input v-home-dir
     1077       ) no-error.
     1078       if error-status :error
     1079       then do:
     1080           message
     1081             skip "Неверно задан каталог экспорта."
     1082             skip(1)
     1083             skip "Обратитесь к администратору."
     1084           view-as alert-box error.
     1085           undo, return error .
     1086       end.
     1087       run bge/genfname.p (
     1088             input v-home-dir
     1089           , input p-prefix
     1090           , input ""
     1091           , input "xml"
     1092           , input "tmp"
     1093           , output p-xml-file-name
     1094       ).
     1095       assign
     1096           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1097           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1098           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1099       .
     1100   end.
     1101   end procedure.
     1102   procedure bgelib-read-config :
     1103   do
     1104   on error undo, return error
     1105   :
     1106   define variable v-par-type as character     no-undo.
     1107     define variable v-param-type      as character  no-undo .
     1108     define variable v-value-character as character  no-undo .
     1109     define variable v-value-date      as date       no-undo .
     1110     define variable v-value-decimal   as decimal    no-undo .
     1111     define variable v-value-integer   as integer    no-undo .
     1112     define variable v-value-logical   as logical    no-undo .
     1113     define variable v-tth             as handle     no-undo .
     1114       assign
     1115           v-bgelib-bgeclall = no
     1116           v-bgelib-bgedict  = no
     1117       .
     1118       run adm/shattri.p ( input "get":U
     1119                         , input  '':u
     1120                         , input  0
     1121                         , input  'bge-export':U
     1122                         , input  'bgeclall':U
     1123                         , output v-value-character
     1124                         , output v-value-date
     1125                         , output v-value-decimal
     1126                         , output v-value-integer
     1127                         , output v-value-logical
     1128                         , output v-param-type
     1129                         , input-output table-handle v-tth
     1130                         ) no-error .
     1131       if error-status :error
     1132       then do:
     1133         assign
     1134           v-bgelib-bgeclall = no
     1135         .
     1136       end.
     1137       else do:
     1138         assign
     1139           v-bgelib-bgeclall = v-value-logical
     1140         .
     1141       end.
     1142       delete object v-tth.
     1143       run adm/shattri.p ( input "get":U
     1144                         , input  '':u
     1145                         , input  0
     1146                         , input  'bge-export':U
     1147                         , input  'bgedict':U
     1148                         , output v-value-character
     1149                         , output v-value-date
     1150                         , output v-value-decimal
     1151                         , output v-value-integer
     1152                         , output v-value-logical
     1153                         , output v-param-type
     1154                         , input-output table-handle v-tth
     1155                         ) no-error .
     1156       if error-status :error
     1157       then do:
     1158         assign
     1159           v-bgelib-bgedict = no
     1160         .
     1161       end.
     1162       else do:
     1163         assign
     1164           v-bgelib-bgedict = v-value-logical
     1165         .
     1166       end.
     1167       delete object v-tth.
     1168       run adm/shattri.p ( input "get":U
     1169                         , input  '':u
     1170                         , input  0
     1171                         , input  'bge-export':U
     1172                         , input  'bgefmt':U
     1173                         , output v-value-character
     1174                         , output v-value-date
     1175                         , output v-value-decimal
     1176                         , output v-value-integer
     1177                         , output v-value-logical
     1178                         , output v-param-type
     1179                         , input-output table-handle v-tth
     1180                         ) no-error .
     1181       if error-status :error
     1182       then do:
     1183         assign
     1184           v-bgelib-bgefmt  = "xml":U
     1185         .
     1186       end.
     1187       else do:
     1188         assign
     1189           v-bgelib-bgefmt  = v-value-character
     1190         .
     1191       end.
     1192       delete object v-tth.
     1193       run adm/shattri.p ( input "get":U
     1194                         , input  '':u
     1195                         , input  0
     1196                         , input  'bge-export':U
     1197                         , input  'bgeflold':U
     1198                         , output v-value-character
     1199                         , output v-value-date
     1200                         , output v-value-decimal
     1201                         , output v-value-integer
     1202                         , output v-value-logical
     1203                         , output v-param-type
     1204                         , input-output table-handle v-tth
     1205                         ) no-error .
     1206       if error-status :error
     1207       then do:
     1208         assign
     1209           v-bgelib-bgeflold  = "old":U
     1210         .
     1211       end.
     1212       else do:
     1213         assign
     1214           v-bgelib-bgeflold  = v-value-character
     1215         .
     1216       end.
     1217       delete object v-tth.
     1218   end.
     1219   end procedure.
     1220   procedure bgelib-check-file-size :
     1221   do
     1222   on error undo, return error
     1223   :
     1224   define input parameter p-out-filename   as character    no-undo.
     1225   define output parameter p-is-big        as logical      no-undo.
     1226       define variable v-current-position    as integer        no-undo.
     1227       assign
     1228           v-current-position = seek( stmXMLOut )
     1229       .
     1230       if v-current-position / 1024 / 1024  >= 100
     1231       then do:
     1232           assign
     1233               p-is-big = yes
     1234           .
     1235       end.
     1236   end.
     1237   end procedure.
     1238   procedure bgelib-init-ext-doc-type :
     1239       define variable v-counter    as integer      no-undo.
     1240       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1241   do
     1242   for buf_temp_ext-doc-type
     1243   on error undo, return error
     1244   :
     1245       empty temp-table buf_temp_ext-doc-type.
     1246       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1247       :
     1248           create buf_temp_ext-doc-type.
     1249           assign
     1250               buf_temp_ext-doc-type.edt-key               = v-counter
     1251               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1252               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1253           .
     1254       end.
     1255   end.
     1256   end procedure.
