     1561   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1562   define variable v-is-closed-shift-journal as integer no-undo .
     1563   assign
     1564   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1565                               +
     1566                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1567                               +
     1568                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1569   .
     1570   return v-is-closed-shift-journal.
     1571   END FUNCTION.
     1572   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1573   define variable v-is-first-journal as logical no-undo .
     1574   assign
     1575   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1576                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1577                     or (p-journal-num =  integer(entry(1, '17':U)))
     1578                     or (p-journal-num = integer(entry(1, '16':U)))
     1579   .
     1580   return v-is-first-journal.
     1581   END FUNCTION.
     1582   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1583   define variable v-is-petrol-journal as logical no-undo .
     1584   assign
     1585   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1586   return v-is-petrol-journal.
     1587   END FUNCTION.
     1588   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1589   define variable v-max-record-num as integer no-undo .
     1590   assign
     1591   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1592                       then 1489
     1593                       else 2340).
     1594   return v-max-record-num.
     1595   END FUNCTION.
     1596   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1597   define variable v-max-record-num as integer no-undo .
     1598   assign
     1599   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1600                       then 1489 * num-entries('30,31,32,33':U)
     1601                       else 2340 * num-entries('17':U)).
     1602   return v-max-record-num.
     1603   END FUNCTION.
     1604   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1605                                           ,input p-rec-no as integer):
     1606   define variable v-num-recs as integer no-undo .
     1607   if tekka-is-petrol-journal (p-journal-num) then do:
     1608     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1609       assign
     1610       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1611       .
     1612     end.
     1613     else do:
     1614       assign
     1615       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1616       .
     1617     end.
     1618   end.
     1619   else do:
     1620     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1621       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1622         assign
     1623         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1624         .
     1625       end.
     1626       else do:
     1627         assign
     1628         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1629         .
     1630       end.
     1631     end.
     1632     else do:
     1633       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1634         assign
     1635         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1636         .
     1637       end.
     1638       else do:
     1639         assign
     1640         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1641         .
     1642       end.
     1643     end.
     1644   end.
     1645   return v-num-recs.
     1646   END FUNCTION.
     1647   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1648                                              ,input p-is-petrol as logical
     1649                                              ,input p-is-current as logical
     1650                                              ,output p-rec-no as decimal
     1651                                              ):
     1652   define variable v-obj-num0 as integer no-undo .
     1653   define variable v-obj-num as integer no-undo .
     1654   define variable v-obj-num2 as integer no-undo .
     1655   define variable p-num-recs2 as integer no-undo .
     1656   define variable p-rec-no2 as integer no-undo .
     1657   if p-is-petrol then do:
     1658     assign
     1659     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1660     .
     1661     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1662     then
     1663     assign
     1664     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1665     p-rec-no = p-num-recs modulo 1489
     1666     .
     1667     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1668     then
     1669     assign
     1670     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1671     p-rec-no = p-num-recs modulo 1489
     1672     .
     1673   end.
     1674   else do:
     1675     assign
     1676     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1677     p-num-recs = trunc(p-num-recs, 0)
     1678     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1679     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1680     .
     1681     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1682     then
     1683     assign
     1684     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1685     p-rec-no = p-num-recs modulo 2340
     1686     .
     1687     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1688     then
     1689     assign
     1690     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1691     p-rec-no = p-num-recs modulo 2340
     1692     .
     1693     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1694     then
     1695     assign
     1696     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1697     p-rec-no2 = p-num-recs2 modulo 2978
     1698     .
     1699     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1700     then
     1701     assign
     1702     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1703     p-rec-no2 = p-num-recs2 modulo 2978
     1704     .
     1705     assign
     1706     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1707     .
     1708   end.
     1709   if v-obj-num = 0 then v-obj-num = 100.
     1710   return v-obj-num.
     1711   END FUNCTION.
     1712   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1713   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1714   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1715      if p-is-ptrl then
     1716      return integer(entry(1, '26,27,28,29':U)).
     1717      if not p-is-ptrl then
     1718      return integer(entry(1, '16':U)).
     1719   end.
     1720   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1721   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1722   return 0.
     1723   END FUNCTION.
     1724   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1725   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1726   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1727     if p-is-ptrl then
     1728     return integer(entry(1, '26,27,28,29':U)).
     1729     if not p-is-ptrl then
     1730     return integer(entry(1, '16':U)).
     1731   end.
     1732   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1733   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1734   return 0.
     1735   END FUNCTION.
     1736   PROCEDURE maria-put:
     1737   define parameter buffer buf_cash-desk for ub.cash-desk.
     1738   define input parameter p-out    as character no-undo .
     1739   define input parameter p-fname as character no-undo .
     1740   define input parameter p-by-record as logical no-undo .
     1741   define input parameter p-shift-fields as integer no-undo .
     1742   define input parameter p-binary as logical no-undo .
     1743   define input parameter p-obj-num as integer no-undo .
     1744   define input parameter p-max-records as integer no-undo .
     1745   define input parameter p-plu as integer no-undo .
     1746   define input parameter p-value as character no-undo .
     1747   define variable v-file-name as character no-undo .
     1748   define variable v-create as logical no-undo .
     1749   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1750   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     1751   output stream IBMSTREAM
     1752   to value(v-file-name) append .
     1753   Put  stream IBMSTREAM unformatted
     1754   p-plu
     1755   chr(3)
     1756   p-value
     1757   skip.
     1758   output stream IBMSTREAM
     1759   close.
     1760   if not p-by-record then do:
     1761     find first buf_temp-tekka-tsk where
     1762               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1763     if not available buf_temp-tekka-tsk then do:
     1764       v-create = yes.
     1765     end.
     1766   end.
     1767   else do:
     1768     find first buf_temp-tekka-tsk where
     1769               buf_temp-tekka-tsk.filename  = v-file-name
     1770           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     1771     if not available buf_temp-tekka-tsk
     1772     then do:
     1773       find first buf_temp-tekka-tsk where
     1774                 buf_temp-tekka-tsk.filename  = v-file-name
     1775             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     1776       if not available buf_temp-tekka-tsk
     1777       then do:
     1778         v-create = yes.
     1779       end.
     1780     end.
     1781   end.
     1782   if v-create then do:
     1783     create buf_temp-tekka-tsk.
     1784     assign
     1785     buf_temp-tekka-tsk.filename = v-file-name
     1786     buf_temp-tekka-tsk.range    = p-plu
     1787     buf_temp-tekka-tsk.obj-num = p-obj-num
     1788     buf_temp-tekka-tsk.obj-name = '':U
     1789     buf_temp-tekka-tsk.num-records = 0
     1790     buf_temp-tekka-tsk.max-records = p-max-records
     1791     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     1792     buf_temp-tekka-tsk.task-num = p-fname
     1793     buf_temp-tekka-tsk.by-record = p-by-record
     1794     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     1795     buf_temp-tekka-tsk.binary = p-binary
     1796     buf_temp-tekka-tsk.send-get = 'send'
     1797     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1798     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1799     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1800     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1801                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1802                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1803                                 then 'local'
     1804                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1805     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1806     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1807     buf_temp-tekka-tsk.waiting-sek = 30
     1808     buf_temp-tekka-tsk.min-plu     = p-plu
     1809     buf_temp-tekka-tsk.max-plu     = p-plu
     1810     .
     1811   end.
     1812   assign
     1813   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     1814   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     1815   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     1816   .
     1817   END PROCEDURE.
     1818   PROCEDURE maria-get:
     1819   define parameter buffer buf_cash-desk for ub.cash-desk.
     1820   define input parameter p-out    as character no-undo .
     1821   define input parameter p-fname as character no-undo .
     1822   define input parameter p-by-record as logical no-undo .
     1823   define input parameter p-obj-num as integer no-undo .
     1824   define input parameter p-num-fields as integer no-undo .
     1825   define input parameter p-max-records as integer no-undo .
     1826   define input parameter p-min-plu as integer no-undo .
     1827   define input parameter p-max-plu as integer no-undo .
     1828   define input parameter p-other as character no-undo .
     1829   define input parameter p-order-num as integer no-undo .
     1830   define variable v-file-name as character no-undo .
     1831   define variable v-secondary-obj-num as character no-undo .
     1832   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1833   if p-by-record then do:
     1834     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     1835   end.
     1836   else do:
     1837     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     1838   end.
     1839   find first buf_temp-tekka-tsk where
     1840             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1841   if not available buf_temp-tekka-tsk then do:
     1842     create buf_temp-tekka-tsk.
     1843     assign
     1844     buf_temp-tekka-tsk.filename = v-file-name
     1845     buf_temp-tekka-tsk.obj-num = p-obj-num
     1846     buf_temp-tekka-tsk.obj-name = '':U
     1847     buf_temp-tekka-tsk.max-records = p-max-records
     1848     buf_temp-tekka-tsk.num-fields = p-num-fields
     1849     buf_temp-tekka-tsk.task-num = p-fname
     1850     buf_temp-tekka-tsk.by-record = p-by-record
     1851     buf_temp-tekka-tsk.send-get = 'get'
     1852     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1853     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1854     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1855     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1856                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1857                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1858                                   then 'local'
     1859                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1860     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1861     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1862     buf_temp-tekka-tsk.waiting-sek = 30
     1863     buf_temp-tekka-tsk.min-plu     = p-min-plu
     1864     buf_temp-tekka-tsk.max-plu     = p-max-plu
     1865     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     1866                                       and p-max-plu <> ?
     1867                                       then p-max-plu - p-min-plu + 1
     1868                                       else 0)
     1869     buf_temp-tekka-tsk.other-info = p-other
     1870     buf_temp-tekka-tsk.order-num = p-order-num
     1871     .
     1872     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     1873       assign
     1874       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     1875       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     1876       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     1877       no-error
     1878       .
     1879       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     1880     end.
     1881   end.
     1882   END PROCEDURE.
     1883   PROCEDURE maria-task:
     1884   define parameter buffer buf_cash-desk for ub.cash-desk.
     1885   define input parameter p-fname as character no-undo .
     1886   define input parameter p-obj-num-list as character no-undo .
     1887   define input parameter p-parameters as character no-undo .
     1888   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1889   find first buf_temp-tekka-tsk where
     1890             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     1891   if not available buf_temp-tekka-tsk then do:
     1892     create buf_temp-tekka-tsk.
     1893     assign
     1894     buf_temp-tekka-tsk.filename = ''
     1895     buf_temp-tekka-tsk.range = 1
     1896     buf_temp-tekka-tsk.obj-num = 0
     1897     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     1898     buf_temp-tekka-tsk.task-num = p-fname
     1899     buf_temp-tekka-tsk.by-record = no
     1900     buf_temp-tekka-tsk.send-get = 'task'
     1901     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1902     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1903     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1904     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1905                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1906                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1907                                   then 'local'
     1908                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1909     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1910     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1911     buf_temp-tekka-tsk.waiting-sek = 30
     1912     buf_temp-tekka-tsk.other-info = p-parameters
     1913     buf_temp-tekka-tsk.order-num = 0
     1914     .
     1915   end.
     1916   END PROCEDURE.
     1917   procedure tekkatsk-verify-schema :
     1918   define input parameter p-obj-list as character no-undo .
     1919   define input parameter p-dir-path as character no-undo .
     1920   define variable v-obj-num as integer no-undo .
     1921   define variable v-obj-name as character no-undo .
     1922   define variable v-num-records as integer no-undo .
     1923   define variable v-size_ as integer no-undo .
     1924   define variable v-value as character no-undo .
     1925   define variable ii as integer no-undo .
     1926   define variable jj as integer no-undo .
     1927   define variable ii-ibs as integer no-undo .
     1928   define variable ii-tekka as integer no-undo .
     1929   define variable v-result as character no-undo .
     1930   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1931   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1932     do
     1933     on error undo, return error
     1934     :
     1935        for each buf_temp-tekka-schema:
     1936          delete buf_temp-tekka-schema.
     1937        end.
     1938        input from value('tekkasch.d').
     1939        repeat :
     1940          create buf_temp-tekka-schema.
     1941          import buf_temp-tekka-schema.
     1942          assign
     1943          buf_temp-tekka-schema.host = 'IBS'
     1944          ii = ii + 1.
     1945          .
     1946        end.
     1947        input close.
     1948        ii-ibs = ii.
     1949         _ii:
     1950         do ii = 1 to 256:
     1951           if p-obj-list = "ALL"
     1952           or lookup(string(ii), p-obj-list) > 0 then do:
     1953             assign
     1954             v-obj-num = 0
     1955             v-obj-name = ''
     1956             v-num-records = 0
     1957             v-size_ = 0
     1958             .
     1959             run alienini-getkey in this-procedure (
     1960                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1961                                                     ,input ('obj' + string(ii, '999'))
     1962                                                     ,input 'oname'
     1963                                                     ,output v-value) no-error .
     1964             if v-value = ? then next _ii.
     1965             assign
     1966             v-obj-num = ii
     1967             v-obj-name = v-value
     1968             .
     1969             run alienini-getkey in this-procedure (
     1970                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1971                                                     ,input ('obj' + string(ii, '999'))
     1972                                                     ,input 'size'
     1973                                                     ,output v-value) no-error .
     1974             assign
     1975             v-num-records = integer(v-value) no-error  .
     1976             if error-status:error
     1977             or v-num-records = 0 then next _ii.
     1978             run alienini-getkey in this-procedure (
     1979                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1980                                                     ,input 'obj' + string(ii, '999')
     1981                                                     ,input 'f000'
     1982                                                     ,output v-value) no-error .
     1983             assign
     1984             v-size_ = integer(v-value) no-error  .
     1985             if error-status:error
     1986             or v-size_ = 0 then next _ii.
     1987             _jj:
     1988             do jj = 1 to 256:
     1989               run alienini-getkey in this-procedure (
     1990                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1991                                                       ,input 'obj' + string(ii, '999')
     1992                                                       ,input 'f' + string(jj, '999')
     1993                                                       ,output v-value) no-error .
     1994               if v-value = ? then next _ii.
     1995               create buf_temp-tekka-schema.
     1996               assign
     1997               buf_temp-tekka-schema.host = 'tekka'
     1998               buf_temp-tekka-schema.obj-num = v-obj-num
     1999               buf_temp-tekka-schema.obj-name = v-obj-name
     2000               buf_temp-tekka-schema.num-records = v-num-records
     2001               buf_temp-tekka-schema.size_ = v-size_
     2002               buf_temp-tekka-schema.field-num = jj
     2003               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2004               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2005                                                  then entry(2, entry(2, v-value, '#'), ':')
     2006                                                  else '':U)
     2007               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2008               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2009               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2010                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2011               no-error
     2012               .
     2013               if error-status:error then do:
     2014                 delete buf_temp-tekka-schema.
     2015                 next _jj.
     2016               end.
     2017               run alienini-getkey in this-procedure (
     2018                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2019                                                       ,input 'obj' + string(ii, '999') + 'name'
     2020                                                       ,input 'n' + string(jj, '999')
     2021                                                       ,output v-value) no-error .
     2022               if v-value <> ? then
     2023               buf_temp-tekka-schema.field-name = v-value.
     2024             end.
     2025           end.
     2026         end.
     2027         ii-tekka = ii - 1.
     2028        if p-obj-list <> 'ALL' then do:
     2029         if ii-tekka <> ii-ibs then do:
     2030           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2031                                   , ii-ibs
     2032                                   , ii-tekka).
     2033         end.
     2034        end.
     2035        for each buf_temp-tekka-schema where
     2036               buf_temp-tekka-schema.host = 'tekka':
     2037          find first buf2_temp-tekka-schema where
     2038                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2039                AND buf2_temp-tekka-schema.host = 'ibs'
     2040                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2041          if not available buf2_temp-tekka-schema then do:
     2042           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2043                                   , buf_temp-tekka-schema.field-num
     2044                                   , buf_temp-tekka-schema.obj-num).
     2045          end.
     2046          buffer-compare buf_temp-tekka-schema
     2047          to buf2_temp-tekka-schema
     2048          save result in v-result.
     2049          if v-result <> '':U then do:
     2050           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2051                                   , buf_temp-tekka-schema.field-num
     2052                                   , buf_temp-tekka-schema.obj-num).
     2053          end.
     2054        end.
     2055     end.
     2056   end procedure.
     2057   FUNCTION set-Sx returns character (input p-string as character):
     2058   return p-string.
     2059   END FUNCTION.
     2060   FUNCTION get-Sx returns character (input p-string  as character):
     2061   return p-string.
     2062   END FUNCTION.
     2063   FUNCTION set-B returns character (input p-string  as character):
     2064   return chr(integer(p-string)).
     2065   END FUNCTION.
     2066   FUNCTION get-B returns character (input p-string  as character):
     2067   return string(asc(p-string)).
     2068   END FUNCTION.
     2069   FUNCTION set-BF returns character (input p-string  as character):
     2070   define variable v-dopi as integer no-undo .
     2071   define variable ii as integer no-undo .
     2072   do ii = 1 to 8:
     2073     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2074   end.
     2075   return chr(v-dopi).
     2076   END FUNCTION.
     2077   FUNCTION get-BF returns character (input p-string  as character):
     2078   define variable v-dopi as integer no-undo .
     2079   define variable v-dops as character no-undo .
     2080   define variable ii as integer no-undo .
     2081   v-dopi = asc(p-string).
     2082   do ii = 8 to 1 BY -1:
     2083     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2084   end.
     2085   return v-dops.
     2086   END FUNCTION.
     2087   FUNCTION set-BN returns character (input p-string  as character
     2088                                     ,input p-bin-group as character):
     2089   define variable v-dopi as integer no-undo .
     2090   define variable ii as integer no-undo .
     2091   define variable jj as integer no-undo .
     2092   define variable v-grp-nums as integer no-undo .
     2093   define variable v-dopi2 as integer no-undo .
     2094   v-grp-nums = num-entries(p-bin-group).
     2095   do jj = 0 to v-grp-nums - 1:
     2096     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     2097     do ii = 1 to 8:
     2098       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2099     end.
     2100   end.
     2101   return chr(v-dopi).
     2102   END FUNCTION.
     2103   FUNCTION get-BN returns character (input p-string  as character
     2104                                     ,input p-bin-group as character):
     2105   define variable v-dopi as integer no-undo .
     2106   define variable v-dops as character no-undo .
     2107   define variable v-grp-nums as integer no-undo .
     2108   define variable ii as integer no-undo .
     2109   define variable jj as integer no-undo .
     2110   v-dopi = asc(p-string).
     2111   v-grp-nums = num-entries(p-bin-group).
     2112   do jj = 1 to v-grp-nums:
     2113   do ii = 8 to 1 BY -1:
     2114     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2115   end.
     2116   end.
     2117   return v-dops.
     2118   END FUNCTION.
     2119   procedure fill-temp-cd :
     2120   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     2121   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2122   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2123   define input parameter p-clear-table as logical no-undo .
     2124   define buffer buf_temp-cd for temp-cd.
     2125   define buffer buf_cash-desk for ub.cash-desk.
     2126     do
     2127     on error undo, return error
     2128     :
     2129        if p-clear-table  then do:
     2130          for each buf_temp-cd:
     2131            delete buf_temp-cd.
     2132          end.
     2133        end.
     2134        for each buf_cash-desk no-lock where
     2135               buf_cash-desk.db-num = p-db-num
     2136           AND buf_cash-desk.obj-code = p-obj-code
     2137           and buf_cash-desk.cash-on  = yes
     2138        BREAK by buf_cash-desk.pos-type:
     2139          if first-of(buf_cash-desk.pos-type) then do:
     2140            create buf_temp-cd.
     2141            buffer-copy buf_cash-desk to buf_temp-cd.
     2142          end.
     2143        end.
     2144     end.
     2145   end procedure.
     2146   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2147   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2148   procedure cp-attr-code :
     2149     do
     2150     on error undo, return error
     2151     :
     2152       define input  parameter p-code           as character no-undo .
     2153       define output parameter p-type           as character no-undo .
     2154       define output parameter p-format         as character no-undo .
     2155       define output parameter p-label          as character no-undo .
     2156       define output parameter p-range          as integer   no-undo .
     2157       define output parameter p-user-can-edit  as logical   no-undo .
     2158       define output parameter p-output-display as logical   no-undo .
     2159       define output parameter p-other          as character no-undo .
     2160       case p-code :
     2161               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     2162               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
     2163               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
     2164               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
     2165               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     2166               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     2167               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2168               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2169               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2170               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2171         otherwise do:
     2172           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     2173         end.
     2174       end.
     2175     end.
     2176   end procedure.
