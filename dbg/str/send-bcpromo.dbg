     2274         (input  p-code
     2275         ,output v-type
     2276         ,output v-format
     2277         ,output v-label
     2278         ,output v-range
     2279         ,output v-user-can-edit
     2280         ,output v-output-display
     2281         ,output v-other
     2282         ) no-error .
     2283       if error-status :error then do:
     2284         undo, return error return-value .
     2285       end.
     2286       find first buf_cash-pay-attr exclusive-lock
     2287         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2288           and buf_cash-pay-attr.curr-code  = p-curr-code
     2289           and buf_cash-pay-attr.host-code  = p-host-code
     2290           and buf_cash-pay-attr.obj-type   = p-obj-type
     2291           and buf_cash-pay-attr.obj-code   = p-obj-code
     2292           and buf_cash-pay-attr.attr-code = p-code
     2293         no-error .
     2294       if not available buf_cash-pay-attr then do:
     2295         create buf_cash-pay-attr .
     2296         assign
     2297         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2298         buf_cash-pay-attr.curr-code  = p-curr-code
     2299         buf_cash-pay-attr.host-code  = p-host-code
     2300         buf_cash-pay-attr.obj-type   = p-obj-type
     2301         buf_cash-pay-attr.obj-code   = p-obj-code
     2302         buf_cash-pay-attr.attr-code = p-code
     2303         .
     2304       end.
     2305       assign
     2306         buf_cash-pay-attr.attr-value = p-value
     2307       .
     2308       release buf_cash-pay-attr no-error .
     2309       if error-status:error then do:
     2310         undo, return error return-value .
     2311       end.
     2312     end.
     2313   end procedure.
