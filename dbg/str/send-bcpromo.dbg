     2454   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2455   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2456   FUNCTION cp-isuse returns logical ( input p-cdpay-code as integer
     2457                                      ,input p-curr-code as integer
     2458                                      ,input p-host-code as integer
     2459                                      ,input p-obj-type as character
     2460                                      ,input p-obj-code as integer
     2461                                      ,input p-cp-is-use as logical
     2462                                      ,input p-cash-num as integer
     2463                                      ,input p-pos-type as character
     2464                                      ):
     2465   define variable v-value as character no-undo .
     2466   define variable v-type as character no-undo .
     2467   if p-cp-is-use then do:
     2468     run cp-attr-value  in this-procedure (
     2469                                              input p-cdpay-code
     2470                                             ,input p-curr-code
     2471                                             ,input p-host-code
     2472                                             ,input p-obj-type
     2473                                             ,input p-obj-code
     2474                                             ,input 'is-use':U
     2475                                             ,output v-value
     2476                                             ,output v-type) no-error .
     2477     if error-status:error
     2478     or v-value = '':u then do:
     2479       run cp-attr-value  in this-procedure (
     2480                                                input p-cdpay-code
     2481                                               ,input p-curr-code
     2482                                               ,input p-host-code
     2483                                               ,input '':U
     2484                                               ,input  0
     2485                                               ,input 'is-use':U
     2486                                               ,output v-value
     2487                                               ,output v-type) no-error .
     2488       if error-status:error
     2489       or v-value = '':u then do:
     2490         run cp-attr-value  in this-procedure (
     2491                                                 input  p-cdpay-code
     2492                                                 ,input p-curr-code
     2493                                                 ,input  0
     2494                                                 ,input  '':U
     2495                                                 ,input  0
     2496                                                 ,input  'is-use':U
     2497                                                 ,output v-value
     2498                                                 ,output v-type) no-error .
     2499       end.
     2500     end.
     2501     if v-value <> '*':U
     2502     and lookup(string(p-cash-num) + chr(44) + p-pos-type, v-value, chr(4)) = 0 then do:
     2503       return no.
     2504     end.
     2505   end.
     2506   return yes.
     2507   END FUNCTION.
