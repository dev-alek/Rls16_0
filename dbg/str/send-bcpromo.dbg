     1258   define variable v-xml-file-name     as character            no-undo.
     1259   define variable v-xml-file-name-path as character            no-undo.
     1260   define variable v-log-file-name     as character            no-undo.
     1261   define variable v-locked            as logical              no-undo.
     1262   define variable v-log-string        as character            no-undo.
     1263   define variable v-oper-num          as integer              no-undo.
     1264   define variable v-obj-list          as character            no-undo.
     1265   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
