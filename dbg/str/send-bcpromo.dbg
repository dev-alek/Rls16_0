     3301     define buffer buf_promogoods  for ub.PromoGoods .
     3302     define variable producer-int as integer no-undo .
     3303     do
     3304       on error undo, return error
     3305       :
     3306       if pRow = "" then
     3307       do:
     3308         if action = "D" then
     3309         do:
     3310           FOR EACH ub.PromoAttr EXCLUSIVE-LOCK
     3311             :
     3312   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3313   assign
     3314     v-version-dec = decimal(p-pos-version)
     3315       no-error .
     3316   for each ub.PromoGoods no-lock where ub.PromoGoods.db-num = integer(entry(2,ub.PromoAttr.p-key,chr(3))) and
     3317     ub.PromoGoods.idAction = int64(entry(1,ub.PromoAttr.p-key,chr(3))) and
     3318     ub.PromoGoods.gds-code = integer(entry(3,ub.PromoAttr.p-key,chr(3))):
     3319     find first ub.goods no-lock where ub.goods.gds-code = ub.PromoGoods.gds-code no-error .
     3320     for first ub.bar-code no-lock where ub.bar-code.gds-code = ub.goods.gds-code and ub.bar-code.b-code = ub.goods.gds-code:
     3321       producer-int = (if ub.goods.prod-type = 'орг':U then 1000000 else 0 ) + ub.goods.prod-code .
     3322       run gds-attr-value in this-procedure (
     3323         input ub.goods.gds-code
     3324         ,input 'emrc-type':U
     3325         ,output v-attr-emrc
     3326         ,output v-attr-type) no-error.
     3327       run bgelib-tag-open in this-procedure ( input 2, input "ItemBarCode", input substitute("ctrl='&1' tms='&2' code='&3'"
     3328         , "DEL":U
     3329         , OS2-time
     3330         , string(ub.PromoAttr.attr-value))).
     3331       run bgelib-tag-put in this-procedure ( input 3, input "IBCCode"
     3332         , input string( ub.bar-code.b-code )
     3333         , input 1 ).
     3334       run bgelib-tag-put in this-procedure ( input 3, input "IBCProducer"
     3335         , input string(producer-int), input 1 ).
     3336       run bgelib-tag-put in this-procedure ( input 3, input "IBCIngredient"
     3337         , input trim(string( ub.goods.struct, "X(40)")), input 1 ).
     3338       find first country no-lock where country.alpha1 = ub.goods.alpha1 no-error.
     3339       if available country then
     3340         run bgelib-tag-put in this-procedure ( input 3, input "IBCCountry"
     3341           , input country.short-name, input 1 ).
     3342       find last ub.price-all no-lock where ub.price-all.gds-code = ub.goods.gds-code and
     3343         ub.price-all.obj-code = i-obj-code and
     3344         ub.price-all.obj-type = 'маг':U and
     3345         ub.price-all.main-indication = 0 and
     3346         ub.price-all.type-price = 0 no-error .
     3347       if available (ub.price-all) then
     3348       do:
     3349          run bgelib-tag-put in this-procedure ( input 3, input "IBCPrice"
     3350            , input string(ub.price-all.price-sale)
     3351            , input 1 ).
     3352       end.
     3353       else do:
     3354          run bgelib-tag-put in this-procedure ( input 3, input "IBCPrice"
     3355            , input "0"
     3356            , input 1 ).
     3357       end.
     3358       run bgelib-tag-put in this-procedure ( input 3, input "IBCType"
     3359         , input string( 0 ), input 1 ).
     3360       run bgelib-tag-put in this-procedure ( input 3, input "IBC_EMRC"                                        ~
     3361         , input  v-attr-emrc, input 1 ).
     3362       run bgelib-tag-put in this-procedure ( input 3, input "IBCUnitFactor"                                   ~
     3363         , input  string(ub.bar-code.cli-base-rate), input 1 ).
     3364       run bgelib-tag-close in this-procedure ( input 2, input "ItemBarCode") .
     3365     end.
     3366   end.
     3367     .
     3368           END.
     3369         end.
     3370       end.
     3371       else
     3372       do:
     3373         DO ii = 1 to num-entries (pRow):
     3374           v-rid-list = integer(entry(ii,pRow)) .
     3375           FIND FIRST ub.PromoAttr No-LOCK where recid(ub.PromoAttr) = v-rid-list No-ERROR.
     3376           IF available ub.PromoAttr then
     3377           do:
     3378   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3379   assign
     3380     v-version-dec = decimal(p-pos-version)
     3381       no-error .
     3382   for each ub.PromoGoods no-lock where ub.PromoGoods.db-num = integer(entry(2,ub.PromoAttr.p-key,chr(3))) and
     3383     ub.PromoGoods.idAction = int64(entry(1,ub.PromoAttr.p-key,chr(3))) and
     3384     ub.PromoGoods.gds-code = integer(entry(3,ub.PromoAttr.p-key,chr(3))):
     3385     find first ub.goods no-lock where ub.goods.gds-code = ub.PromoGoods.gds-code no-error .
     3386     for first ub.bar-code no-lock where ub.bar-code.gds-code = ub.goods.gds-code and ub.bar-code.b-code = ub.goods.gds-code:
     3387       producer-int = (if ub.goods.prod-type = 'орг':U then 1000000 else 0 ) + ub.goods.prod-code .
     3388       run gds-attr-value in this-procedure (
     3389         input ub.goods.gds-code
     3390         ,input 'emrc-type':U
     3391         ,output v-attr-emrc
     3392         ,output v-attr-type) no-error.
     3393       run bgelib-tag-open in this-procedure ( input 2, input "ItemBarCode", input substitute("ctrl='&1' tms='&2' code='&3'"
     3394         , "DEL":U
     3395         , OS2-time
     3396         , string(ub.PromoAttr.attr-value))).
     3397       run bgelib-tag-put in this-procedure ( input 3, input "IBCCode"
     3398         , input string( ub.bar-code.b-code )
     3399         , input 1 ).
     3400       run bgelib-tag-put in this-procedure ( input 3, input "IBCProducer"
     3401         , input string(producer-int), input 1 ).
     3402       run bgelib-tag-put in this-procedure ( input 3, input "IBCIngredient"
     3403         , input trim(string( ub.goods.struct, "X(40)")), input 1 ).
     3404       find first country no-lock where country.alpha1 = ub.goods.alpha1 no-error.
     3405       if available country then
     3406         run bgelib-tag-put in this-procedure ( input 3, input "IBCCountry"
     3407           , input country.short-name, input 1 ).
     3408       find last ub.price-all no-lock where ub.price-all.gds-code = ub.goods.gds-code and
     3409         ub.price-all.obj-code = i-obj-code and
     3410         ub.price-all.obj-type = 'маг':U and
     3411         ub.price-all.main-indication = 0 and
     3412         ub.price-all.type-price = 0 no-error .
     3413       if available (ub.price-all) then
     3414       do:
     3415          run bgelib-tag-put in this-procedure ( input 3, input "IBCPrice"
     3416            , input string(ub.price-all.price-sale)
     3417            , input 1 ).
     3418       end.
     3419       else do:
     3420          run bgelib-tag-put in this-procedure ( input 3, input "IBCPrice"
     3421            , input "0"
     3422            , input 1 ).
     3423       end.
     3424       run bgelib-tag-put in this-procedure ( input 3, input "IBCType"
     3425         , input string( 0 ), input 1 ).
     3426       run bgelib-tag-put in this-procedure ( input 3, input "IBC_EMRC"                                        ~
     3427         , input  v-attr-emrc, input 1 ).
     3428       run bgelib-tag-put in this-procedure ( input 3, input "IBCUnitFactor"                                   ~
     3429         , input  string(ub.bar-code.cli-base-rate), input 1 ).
     3430       run bgelib-tag-close in this-procedure ( input 2, input "ItemBarCode") .
     3431     end.
     3432   end.
     3433     .
     3434           end.
     3435         END.
     3436       end.
     3437     end.
     3438   end procedure.
     3439   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3440   PROCEDURE   for-cash-cycle:
     3441      DEFINE VARIABLE v-dir-remote     as character no-undo .
     3442      DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
     3443      define buffer for-cash-desk for ub.cash-desk.
     3444      FOR EACH for-cash-desk NO-LOCK WHERE
     3445         for-cash-desk.db-num = g#db-num AND
     3446         for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     3447         for-cash-desk.obj-code = i-obj-code AND
     3448         for-cash-desk.cash-on  = yes:
     3449         IF (LOOKUP(ub.cash-desk.pos-type,'IBM-XML':U) > 0
     3450            and for-cash-desk.autonomy = integer('1':U)) then NEXT.
     3451         run write-log-and-file in p-log-handle (
     3452            input 1
     3453            , input log-file-name
     3454            , input 1
     3455            , input substitute("Пересылка - касса &1", for-cash-desk.cash-num)
     3456            ).
     3457   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3458   case for-cash-desk.pos-type:
     3459       when 'IBM-XML':U or when 'Autotank':U
     3460     then do:
     3461   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3462   run xml-cd-filename in this-procedure (
     3463         input out
     3464       , output v-xml-file-name
     3465       , output v-xml-file-name-path
     3466       , output v-log-file-name
     3467       , output v-locked
     3468   ).
     3469   run write-log-and-file in p-log-handle (
     3470         input 1
     3471       , input log-file-name
     3472       , input 1
     3473       , input substitute( ("''" + " &1")
     3474                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     3475                         )
     3476                                         ).
     3477   run write-log-and-file in p-log-handle (
     3478         input 1
     3479       , input log-file-name
     3480       , input 1
     3481       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     3482                                         ).
     3483   assign
     3484   v-obj-list = 'маг':U + string(i-obj-code)
     3485   .
     3486   run xml-cd-write-header in this-procedure (
     3487         input v-xml-file-name
     3488       , input v-xml-file-name-path
     3489       , input 'data'
     3490       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     3491       , input v-obj-list
     3492       , input (
     3493                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     3494                   then (if for-cash-desk.autonomy = integer('0':U)
     3495                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     3496                         else ("КМ"   )
     3497                         )
     3498                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     3499                   )
     3500               )
     3501       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     3502   ).
     3503   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     3504   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     3505     end.
     3506   END CASE.
     3507         RUN putc-17 in this-procedure (buffer for-cash-desk
     3508            ,input for-cash-desk.cash-num
     3509            ,input for-cash-desk.version
     3510            ).
     3511   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3512   case for-cash-desk.pos-type:
     3513       when 'IBM-XML':U or when 'Autotank':U
     3514     then do:
     3515   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3516   output stream stmxmlout close.
     3517   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     3518       , input 'data'
     3519   ).
     3520   run write-log-and-file in p-log-handle (
     3521         input 1
     3522       , input log-file-name
     3523       , input 1
     3524       , input substitute( "Данные выгружены в файл &1"
     3525                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     3526                         )
     3527                                          ).
     3528   if (
     3529   not (g#news or g#auto or g#esys )
     3530   or
     3531   (
     3532   for-cash-desk.pos-type = 'MAGIA-XML':U
     3533   or
     3534     (for-cash-desk.pos-type = 'IBM-XML':U
     3535   or (for-cash-desk.pos-type = 'Autotank':U
     3536     and
     3537     for-cash-desk.autonomy = integer('2':U))
     3538     )))
     3539   then do:
     3540     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     3541     end.
     3542     if (for-cash-desk.pos-type = 'IBM-XML':U
     3543     and for-cash-desk.autonomy = integer('0':U))
     3544     or (for-cash-desk.pos-type = 'Autotank':U
     3545     and for-cash-desk.autonomy = integer('2':U))
     3546     then do:
     3547       run str/post-xml.p
     3548         (
     3549          input parparentproc
     3550         ,input p-parent-handle
     3551         ,input p-log-handle
     3552         ,input g#news or g#esys
     3553         ,input g#auto
     3554         ,input 'send'
     3555         ,input log-file-name
     3556         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     3557         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     3558         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     3559         ,input 30
     3560         ,input   ( if action = 'U'
     3561                     then ('Ждите - ' + 'добавление ШК промоакций ')
     3562                     else ('Ждите - ' + 'удаление ШК промоакций ') ) +
     3563                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     3564         ) no-error .
     3565       if error-status:error
     3566       or return-value = "error" then do:
     3567         run write-log-and-file in p-log-handle (
     3568               input 1
     3569             , input log-file-name
     3570             , input 1
     3571             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     3572                                   ,for-cash-desk.obj-code
     3573                                   ,for-cash-desk.cash-num
     3574                                   , chr(10)
     3575                                   , error-status:get-message(1)
     3576                                   , return-value
     3577                               )
     3578                                               ).
     3579         assign
     3580         v-view-log = yes
     3581         .
     3582       end.
     3583     end.
     3584     if not available ub.shop then do:
     3585       find first ub.shop no-lock where
     3586                 ub.shop.obj-code = for-cash-desk.obj-code.
     3587     end.
     3588     if
     3589     not (g#news or g#esys)
     3590     then do:
     3591       run str/getxibmf.p (
     3592                       input parparentproc
     3593                     ,input p-log-handle
     3594                     ,input 'маг':U
     3595                     ,input for-cash-desk.obj-code
     3596                     ,input ub.shop.host-code
     3597                     ,input in_
     3598                     ,input spl
     3599                     ,input (in_ + sav)
     3600                     ,input for-cash-desk.pos-type
     3601                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     3602                             and for-cash-desk.autonomy = integer('0':U))
     3603                             or (for-cash-desk.pos-type = 'Autotank':U
     3604                             and for-cash-desk.autonomy = integer('2':U))
     3605                             then "utf-8":U
     3606                             else "windows-1251")
     3607                     ,input log-file-name
     3608                     ,input "data":U
     3609                     ,input v-xml-file-name
     3610                     ,input-output v-view-log
     3611                     ) no-error .
     3612       if error-status:error then do:
     3613         run write-log-and-file in p-log-handle (
     3614               input 1
     3615             , input log-file-name
     3616             , input 1
     3617             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     3618                                   ,for-cash-desk.obj-code
     3619                                   ,for-cash-desk.cash-num
     3620                               )
     3621                                               ).
     3622         assign
     3623         v-view-log = yes
     3624         .
     3625       end.
     3626     end.
     3627   end.
     3628   if g#news
     3629   or g#auto
     3630   or g#esys
     3631   and for-cash-desk.pos-type = 'MAGIA-XML':U
     3632   then do:
     3633   end.
     3634     end.
     3635   END CASE.
     3636   END .
     3637   END PROCEDURE.
     3638   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3639   PROCEDURE SENDING:
     3640   DEFINE VARIABLE fq as integer no-undo .
     3641   define variable glog as logical no-undo .
     3642   FOR EACH ub.cash-desk NO-LOCK WHERE
     3643            ub.cash-desk.db-num = g#db-num
     3644        AND ub.cash-desk.obj-code = i-obj-code
     3645        AND ub.cash-desk.cash-on
     3646   BREAK
     3647   By ub.cash-desk.pos-type :
     3648     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     3649   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3650   define variable dflt-cd22 as character no-undo .
     3651   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3652   define variable v-param-type23 as character no-undo .
     3653   define variable v-value-date23 as date no-undo .
     3654   define variable v-value-decimal23 as decimal no-undo .
     3655   define variable v-value-integer23 as INTEGER no-undo .
     3656   define variable v-value-logical23 AS LOGICAL no-undo .
     3657   define variable v-tth23 as handle no-undo .
     3658   run adm/shattri.p (
     3659       input "get":U
     3660       ,input  'маг':U
     3661       ,input  ub.cash-desk.obj-code
     3662       ,input  'cd-sending':U
     3663       ,input  'dflt-cd':U
     3664       ,output dflt-cd22
     3665       ,output v-value-date23
     3666       ,output v-value-decimal23
     3667       ,output v-value-integer23
     3668       ,output v-value-logical23
     3669       ,output v-param-type23
     3670       ,INPUT-OUTPUT table-handle v-tth23
     3671       ) no-error .
     3672   delete object v-tth23 no-error.
     3673   case ub.cash-desk.pos-type:
     3674       when 'IBM-XML':U or when 'Autotank':U
     3675     then do:
     3676   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3677   run str/get-inis.p (
     3678                   input 'маг':U
     3679                 , input ub.cash-desk.obj-code
     3680                 , input ub.cash-desk.pos-type
     3681                 , input cash-desk.remote
     3682                 , input "send":U
     3683                 , output out
     3684                 , output out2
     3685                 , output in_
     3686                 , output spl
     3687                 , output sav
     3688                 , output v-remote
     3689                 )  no-error .
     3690   if error-status:error then do:
     3691     run write-log-and-file in p-log-handle (
     3692           input 1
     3693         , input log-file-name
     3694         , input 1
     3695         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     3696                             , ub.cash-desk.pos-type
     3697                             , ub.cash-desk.obj-code
     3698                             , chr(10)
     3699                             , error-status:get-message(1)
     3700                             , return-value )).
     3701     assign
     3702     v-view-log = yes.
     3703     return error.
     3704   end.
     3705   if ub.cash-desk.pos-type = 'IBM-XML':U
     3706   or ub.cash-desk.pos-type = 'Autotank':U
     3707   then do:
     3708     file-info:file-name = (out  + "undelivered").
     3709     if file-info:FULL-PATHNAME <> ? then do:
     3710       run str/rsndxibm.p ( input parparentproc
     3711                           ,input p-parent-handle
     3712                           ,input p-log-handle
     3713                           ,input out  + "undelivered" ) no-error.
     3714     end.
     3715   end.
     3716     if ub.cash-desk.pos-type = 'IBM-XML':U
     3717     then do:
     3718     run adm/shattri.p (
     3719         input "get":U
     3720         ,input  'маг':U
     3721         ,input  ub.cash-desk.obj-code
     3722         ,input  'cd-type-IBM-XML':U
     3723         ,input  'ibmrubc':U
     3724         ,output v-value-character
     3725         ,output v-value-date
     3726         ,output v-value-decimal
     3727         ,output v-value-integer
     3728         ,output v-value-logical
     3729         ,output v-param-type
     3730         ,INPUT-OUTPUT table-handle v-tth
     3731         ) no-error .
     3732       IF not error-status:error then do:
     3733         delete object v-tth.
     3734         kassa-rub-code = v-value-integer.
     3735       end.
     3736       else do:
     3737         delete object v-tth.
     3738         return error return-value .
     3739       end.
     3740     end.
     3741     else do:
     3742       kassa-rub-code = 0.
     3743     end.
     3744     if ub.cash-desk.pos-type = 'IBM-XML':U then do:
     3745       run adm/shattri.p (
     3746           input "get":U
     3747           ,input  'маг':U
     3748           ,input  ub.cash-desk.obj-code
     3749           ,input  'cd-type-IBM-XML':U
     3750           ,input  'ibmnalc':U
     3751           ,output v-value-character
     3752           ,output v-value-date
     3753           ,output v-value-decimal
     3754           ,output v-value-integer
     3755           ,output v-value-logical
