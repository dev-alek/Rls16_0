     3009                        ?,
     3010                        ?,
     3011                        output cost-base   ,
     3012                        output cost-rubl   ,
     3013                        output v-price-base  ,
     3014                        output v-price-rubl  ,
     3015                        output cur-rt-base ,
     3016                        output cur-rt-rubl ).
     3017                        if var-pr-r-b = "rubl"
     3018                           then l_price = v-price-rubl.
     3019                           else l_price = v-price-base.
     3020           end.
     3021           when "sale":u then do:
     3022                 l_price = ( if var-pr-r-b = "rubl"
     3023                                then b_doc-line.price-rubl
     3024                                else b_doc-line.price-base ).
     3025           end.
     3026           when "prod":u then do:
     3027   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
