     3242   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3243   procedure doc-code:
     3244   define input  parameter parmode          as   character           no-undo.
     3245   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     3246   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     3247   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     3248   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     3249   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     3250   define variable vardb-remote     as   logical             no-undo.
     3251   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     3252   define variable v-delimiter as character no-undo .
     3253   do
     3254   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3255   :
     3256   find first buf_sys-ctrl no-lock .
     3257   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     3258     CASE parmode:
     3259       when "main":u then do:
     3260         if vardb-remote then do:
     3261           assign
     3262             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     3263         end.
     3264         else do:
     3265           assign
     3266             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     3267         end.
     3268       end.
     3269       when "trio" then do:
     3270         assign
     3271           pardoc-code = replace (parroot-doc-code, "=", "*").
     3272       end.
     3273       otherwise do:
     3274         assign
     3275         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     3276         no-error
     3277         .
     3278         if error-status:error  then do:
     3279           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     3280                                         ,chr(10)
     3281                                         ,parmode
     3282                                         ).
     3283         end.
     3284         if num-entries(parmode) = 1
     3285         and parmode <> "chip":U
     3286         and parmode <> "chip_s":U
     3287         then do:
     3288           assign
     3289           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     3290         end.
     3291         else if (lookup("chip":U, parmode) > 0
     3292                  or
     3293                  lookup("chip_s":U, parmode) > 0) then do:
     3294           assign
     3295             vartemp-doc-code = parroot-doc-code.
     3296           do while true:
     3297             if index (vartemp-doc-code , ".") = 0 then
     3298               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     3299             else
     3300               vartemp-doc-code  =
     3301               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     3302               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     3303               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     3304             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     3305           end.
     3306           assign
     3307             pardoc-code = vartemp-doc-code.
     3308         end.
     3309       end.
     3310     end CASE.
     3311     if pardoc-code = '':U
     3312     or (parroot-doc-code <> '':U
     3313     and pardoc-code = parroot-doc-code) then do:
     3314       undo, return error substitute("Ошибка при генерации номера документа&1"
     3315                                     ,chr(10)).
     3316     end.
     3317   end.
     3318   end. // procedure/method
     3319   function get-doc-code-int64 returns int64
     3320     ( input p-doc-code as character ) :
     3321     define variable v-ind              as integer   no-undo .
     3322     define variable v-num-entries      as integer   no-undo .
     3323     define variable v-doc-code-int64   as int64     no-undo .
     3324     define variable v-canonic-doc-code as character no-undo .
     3325     assign
     3326       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     3327       v-canonic-doc-code = p-doc-code
     3328     .
     3329     do v-ind = 1 to v-num-entries
     3330     :
     3331       assign
     3332         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     3333       .
     3334     end.
     3335     assign
     3336       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     3337     .
     3338     return v-doc-code-int64 .
     3339   end. // function/method
     3340   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3341   define variable v-waitfram-action01         as character   no-undo .
     3342   define variable v-waitfram-action02         as character   no-undo .
     3343   define variable v-waitfram-action03         as character   no-undo .
     3344   define variable mWaitFramTextBeg            as character   no-undo.
     3345   define variable mWaitFramTextEnd            as character   no-undo.
     3346   define variable mWaitFramView               as logical     no-undo.
     3347   define variable mWaitProcEvent              as logical     no-undo init yes.
     3348   define variable mWaitFramInterval           as integer     no-undo init 1 .
     3349   define variable mWaitFramStop               as logical     no-undo.
     3350   define variable mWaitFramStopUser           as logical     no-undo.
     3351   define variable mWaitFramStopTimeOut        as logical     no-undo.
     3352   define variable mWaitFramStartProc          as datetime-tz no-undo.
     3353   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     3354   define button B-WaitFramStop auto-end-key
     3355        label "Стоп"
     3356        size 10 by 1 tooltip "Остоновить процесс".
     3357   define button B-viewProcInfo
     3358        label "Информация"
     3359        size 15 by 1 tooltip "Информация о процесс".
     3360   define frame waitfram
     3361     v-waitfram-action01 format "x(72)" no-label skip
     3362     v-waitfram-action02 format "x(72)" no-label skip
     3363     v-waitfram-action03 format "x(72)" no-label skip
     3364     B-viewProcInfo
     3365     B-WaitFramStop at row 4 col 30
     3366     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     3367     .
     3368   define new global shared variable mBatchMode as logical no-undo init ?.
     3369   define variable mFramBachModHandle as handle no-undo.
     3370   mFramBachModHandle = frame waitfram:handle.
     3371   define variable mFameOldVis as logical no-undo.
     3372   define variable mVisCUrentVin as logical no-undo.
     3373   if session:batch-mode
     3374   then
     3375      mBatchMode = yes.
     3376   if mBatchMode = ? then do:
     3377     mVisCUrentVin = current-window:visible.
     3378     mFameOldVis = mFramBachModHandle:visible.
     3379     mFramBachModHandle:visible  = yes.
     3380     mBatchMode = mFramBachModHandle:visible ne yes.
     3381     mFramBachModHandle:visible = mFameOldVis.
     3382     current-window:visible = mVisCUrentVin.
     3383   end.
     3384    if  log-manager:logfile-name ne ?
     3385     then DO:
     3386         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3387         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3388         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3389     end.
     3390   on choose of B-WaitFramStop in frame waitfram
     3391   do:
     3392     mWaitFramStop = yes.
     3393     mWaitFramStopUser = yes.
     3394   end.
     3395   function waitfram-check-timeout returns logical():
     3396      define variable vtime as int64 no-undo.
     3397      if mWaitFramStopTimeOut
     3398      then
     3399         return yes.
     3400      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3401      if     mWaitFramTimeOut ne ?
     3402         and mWaitFramTimeOut ne 0
     3403         and mWaitFramTimeOut lt vtime
     3404      then do:
     3405         mWaitFramStopTimeOut = yes.
     3406      end.
     3407      return mWaitFramStopTimeOut.
     3408   end.
     3409   procedure waitfram-hide :
     3410     if not session:batch-mode
     3411     then do
     3412     on error undo, return error return-value
     3413     :
     3414       pause 0 before-hide .
     3415       if not mBatchMode then
     3416         hide frame waitfram .
     3417     if     not mWaitFramView
     3418        and mWaitProcEvent
     3419     then
     3420       process events .
     3421     end.
     3422   end procedure.
     3423   procedure waitfram-show :
     3424     define input  parameter p-message as character no-undo .
     3425     define variable v-left-margin as integer   no-undo .
     3426     if not session:batch-mode
     3427     then do
     3428     on error undo, return error return-value
     3429     :
     3430       if length(p-message) <= 70 then do:
     3431         assign
     3432           v-left-margin = integer((70 - length(p-message)) / 2)
     3433         .
     3434         assign
     3435           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3436         .
     3437         assign
     3438           v-waitfram-action01 = " "
     3439           v-waitfram-action02 = " "
     3440                                    + fill(" ", v-left-margin)
     3441                                    + p-message
     3442           v-waitfram-action03 = " "
     3443         .
     3444       end.
     3445       else do:
     3446         define variable vRindex1 as integer no-undo.
     3447         define variable vRindex2 as integer no-undo.
     3448         vRindex1 = r-index(p-message," ",70).
     3449         if vRindex1 = 0
     3450         then
     3451            vRindex1 = 70.
     3452         if length(p-message)  <= vRindex1 + 70 then do:
     3453           assign
     3454             v-waitfram-action01 = " "
     3455             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3456             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3457           .
     3458         end.
     3459         else do:
     3460           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3461           if vRindex2 <= vRindex1
     3462           then
     3463              vRindex2 = vRindex1 + 70.
     3464           assign
     3465             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3466             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3467             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3468           .
     3469         end.
     3470       end.
     3471       B-viewProcInfo:visible   in frame waitfram = no.
     3472       B-viewProcInfo:sensitive in frame waitfram = no.
     3473       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3474       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3475       if  (   mWaitFramView
     3476          or  mWaitProcEvent)
     3477          and not mBatchMode
     3478       then
     3479          display
     3480             v-waitfram-action01 skip
     3481             v-waitfram-action02 skip
     3482             v-waitfram-action03 skip
     3483          with frame waitfram .
     3484       if     mWaitFramView
     3485          then do:
     3486             if     mWaitFramInterval ne ?
     3487                and not mBatchMode
     3488             then
     3489                wait-for go of frame waitfram pause mWaitFramInterval.
     3490          end.
     3491          else
     3492             if     mWaitProcEvent
     3493                and not mBatchMode
     3494             then
     3495                process events .
     3496     end.
     3497   end procedure.
     3498      procedure waitfram-show-this:
     3499         define input  parameter iInterval as int64 no-undo.
     3500         define variable vtime as int64 no-undo.
     3501         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3502         mWaitFramInterval = iInterval.
     3503         run waitfram-show (substitute("&1&2 &3&4" ,
     3504                                       mWaitFramTextBeg ,
     3505                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3506                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3507                                       mWaitFramTextEnd
     3508                                      )
     3509                           ).
     3510      end.
     3511      procedure WaitFramRunPause:
     3512         define input  parameter iInterval as dec no-undo.
     3513         define variable vStart  as datetime-tz no-undo.
     3514         define variable vend    as datetime-tz no-undo.
     3515         define variable vint as int64 no-undo.
     3516         define variable vOk as logical no-undo.
     3517         vStart = now.
     3518         vend   = vStart.
     3519         publish "WaitFramPause" (iInterval,output vOk).
     3520         vend   =  now.
     3521         vint = vend - vStart.
     3522         vint = iInterval - vint / 1000.
     3523         if     not mWaitFramStop
     3524            and (   vint > 0
     3525                 or (    not vOk
     3526                     and iInterval eq ?
     3527                     )
     3528                 )
     3529         then
     3530            run waitfram-show-this (iInterval).
     3531         vend   =  now.
     3532         vint = vend - vStart.
     3533         vint = iInterval - vint / 1000.
     3534         if     not mWaitFramStop
     3535            and vint > 0
     3536         then do:
     3537            run gbl/pause.p (vint * 1000).
     3538         end.
     3539         if iInterval ne ?
     3540         then
     3541            publish "WaitFramStop".
     3542         waitfram-check-timeout().
     3543      end.
     3544      procedure WaitFramWaitFor:
     3545         define input  parameter iInterval as dec no-undo.
     3546         assign
     3547            mWaitFramStartProc   = now
     3548            mWaitFramStopUser    = no
     3549            mWaitFramStopTimeOut = no
     3550         .
     3551         block-wait:
     3552         do while not mWaitFramStop:
     3553            run WaitFramRunPause (iInterval).
     3554            if  waitfram-check-timeout()
     3555            then do:
     3556               leave block-wait.
     3557            end.
     3558         end.
     3559         run waitfram-hide.
     3560      end.
     3561   procedure waitfram-join :
     3562     define input  parameter p-line-1  as character no-undo .
     3563     define input  parameter p-line-2  as character no-undo .
     3564     define input  parameter p-line-3  as character no-undo .
     3565     define output parameter p-message as character no-undo .
     3566     do
     3567     on error undo, return error return-value
     3568     :
     3569       assign
     3570         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3571                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3572                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3573       .
     3574     end.
     3575   end procedure.
     3576   function waitfram-join-function returns character
     3577     (input p-line-1 as character
     3578     ,input p-line-2 as character
     3579     ,input p-line-3 as character
     3580     ).
     3581     define variable v-message as character no-undo .
     3582     run waitfram-join in this-procedure
     3583       (input  p-line-1
     3584       ,input  p-line-2
     3585       ,input  p-line-3
     3586       ,output v-message
     3587       ) .
     3588     return v-message .
     3589   end function .
     3590   def var vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3591   procedure gen-key-rec :
     3592     define input  parameter p-tbl-name    as character no-undo.
     3593     define input  parameter p-bh_tbl-name as handle    no-undo.
     3594     define output parameter p-key-rec     as character no-undo.
     3595     do
     3596     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3597     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     3598     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     3599     :
     3600       define variable fh               as handle    no-undo .
     3601       define variable v-ok             as logical   no-undo .
     3602       define variable v-inform         as character no-undo .
     3603       define variable v-ind            as integer   no-undo .
     3604       define variable v-idx-field-qnty as integer   no-undo .
     3605       if p-tbl-name = ?
     3606         or p-tbl-name = "":U
     3607       then do:
     3608         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info41 ).
     3609       end.
     3610       if not p-bh_tbl-name:available then do:
     3611         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info41, p-tbl-name ).
     3612       end.
     3613       assign
     3614         p-key-rec = p-tbl-name
     3615         v-inform  = p-bh_tbl-name:index-information(1)
     3616         v-ind     = 2
     3617       .
     3618       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3619       on error undo, return error
     3620       :
     3621         assign
     3622           v-inform = p-bh_tbl-name:index-information( v-ind )
     3623           v-ind    = v-ind + 1
     3624         .
     3625       end.
     3626       if v-inform = ?
     3627         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3628         or entry( 3, v-inform, ",":U ) <> "1":U
     3629       then do:
     3630         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info41, p-tbl-name ).
     3631       end.
     3632       else do:
     3633         assign
     3634           v-idx-field-qnty = num-entries( v-inform ) - 4
     3635         .
     3636         if v-idx-field-qnty < 2 then do:
     3637           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info41, v-inform, p-tbl-name ).
     3638         end.
     3639         do v-ind = 1 to v-idx-field-qnty by 2
     3640         on error undo, return error
     3641         :
     3642           assign
     3643             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     3644             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     3645           .
     3646         end.
     3647       end.
     3648       if p-key-rec = ? then do:
     3649         assign
     3650           p-key-rec = "":U
     3651         .
     3652         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info41, p-tbl-name ).
     3653       end.
     3654     end.
     3655     return.
     3656   end procedure.
     3657   procedure gen-where-keyr-tab :
     3658     define input  parameter i-tableSerach as character no-undo.
     3659     define input  parameter i-tablekey   as character  no-undo.
     3660     define input  parameter p-key-rec    as character  no-undo.
     3661     define input  parameter p-key-handle as handle     no-undo .
     3662     define input  parameter p-db-name    as character  no-undo .
     3663     define input  parameter p-tt-handle  as handle     no-undo .
     3664     define output parameter o-Where      as character  no-undo.
     3665     do
     3666     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3667     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3668     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     3669     :
     3670       define variable v-full-tbl-name  as character no-undo .
     3671       define variable bh_tbl-name      as handle    no-undo .
     3672       define variable fh_key           as handle    no-undo .
     3673       define variable fh_search        as handle    no-undo .
     3674       define variable v-field-num      as integer   no-undo .
     3675       define variable v-count-fld      as integer   no-undo .
     3676       define variable v-inform         as character no-undo .
     3677       define variable v-ind            as integer   no-undo .
     3678       define variable v-idx-field-qnty as integer   no-undo .
     3679       define variable v-field-name     as character no-undo .
     3680       define variable v-field-val      as character no-undo .
     3681       define variable v-word-link      as character no-undo .
     3682       define variable vTable           as character no-undo.
     3683       define variable bh_tbl-key       as handle    no-undo .
     3684       assign
     3685         p-key-rec = trim( p-key-rec )
     3686       .
     3687       if p-key-handle <> ? then do:
     3688         if not valid-handle(p-key-handle)
     3689            or p-key-handle:type <> "buffer"
     3690         then do:
     3691           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info41 ).
     3692         end.
     3693         if num-entries( p-key-rec, chr(3) ) > 1
     3694           or p-key-rec = ?
     3695           or p-key-rec = "":U
     3696         then do:
     3697           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info41, p-key-rec ).
     3698         end.
     3699       end.
     3700       else do:
     3701         if p-key-rec = ?
     3702           or p-key-rec = "":U
     3703         then do:
     3704           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info41 ).
     3705         end.
     3706       end.
     3707       assign
     3708         vTable = entry( 1 , p-key-rec, chr(3) )
     3709       .
     3710       if p-tt-handle <> ?
     3711         and ( not valid-handle(p-tt-handle)
     3712               or p-tt-handle:type <> "buffer"
     3713             )
     3714       then do:
     3715         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info41, vTable, chr(10) ).
     3716       end.
     3717       if p-tt-handle = ? then do:
     3718         assign
     3719           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     3720         .
     3721         create buffer bh_tbl-name for table v-full-tbl-name .
     3722       end.
     3723       else do:
     3724         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3725       end.
     3726       assign
     3727         v-inform = bh_tbl-name:index-information(1)
     3728         v-ind    = 2
     3729       .
     3730       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3731       on error undo, return error
     3732       :
     3733         assign
     3734           v-inform = bh_tbl-name:index-information( v-ind )
     3735           v-ind    = v-ind + 1
     3736         .
     3737       end.
     3738       if v-inform = ?
     3739         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3740         or entry( 3, v-inform, ",":U ) <> "1":U
     3741       then do:
     3742         delete object bh_tbl-name no-error.
     3743         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info41, vTable ).
     3744       end.
     3745       assign
     3746         v-idx-field-qnty = num-entries( v-inform ) - 4
     3747       .
     3748       if v-idx-field-qnty < 2 then do:
     3749         delete object bh_tbl-name no-error.
     3750         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info41, v-inform, vTable ).
     3751       end.
     3752       assign
     3753         o-where     = "where":U
     3754         v-word-link = "":U
     3755         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     3756         v-count-fld = 0
     3757       .
     3758       if i-tablekey ne "" and i-tablekey ne ?
     3759       then do:
     3760         assign
     3761           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     3762         .
     3763         create buffer bh_tbl-key for table v-full-tbl-name .
     3764       end.
     3765       if i-tableSerach ne "" and i-tableSerach ne ?
     3766       then do:
     3767         delete object bh_tbl-name no-error.
     3768         assign
     3769           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     3770         .
     3771         create buffer bh_tbl-name for table v-full-tbl-name .
     3772       end.
     3773       block_where:
     3774       do v-ind = 1 to v-idx-field-qnty by 2
     3775       on error undo, return error
     3776       :
     3777         assign
     3778           v-count-fld = v-count-fld + 1
     3779         .
     3780         if p-key-handle = ?
     3781           and v-count-fld > v-field-num
     3782         then do:
     3783           leave block_where.
     3784         end.
     3785         define variable VfieldKeyTable as handle no-undo.
     3786         assign
     3787           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     3788           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     3789         .
     3790         if     bh_tbl-key ne ?
     3791         then do:
     3792            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     3793            if VfieldKeyTable eq ?
     3794            then next block_where.
     3795         end.
     3796         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     3797         then
     3798            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     3799         else
     3800            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     3801         if p-key-handle = ? then do:
     3802           assign
     3803             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     3804           .
     3805         end.
     3806         else do:
     3807           assign
     3808             fh_key = p-key-handle:buffer-field( v-field-name )
     3809           .
     3810           if fh_key = ?
     3811             or not valid-handle( fh_key )
     3812           then do:
     3813             delete object bh_tbl-name.
     3814             if     bh_tbl-key ne ?
     3815             then
     3816                delete object bh_tbl-key.
     3817             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info41, p-key-handle:name, v-field-name ).
     3818           end.
     3819           assign
     3820             v-field-val = fh_key:buffer-value
     3821           .
     3822         end.
     3823         if fh_search:data-type ="character":U then do:
     3824           assign
     3825             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     3826             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     3827             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     3828             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     3829             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     3830             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     3831             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     3832             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     3833             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     3834             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     3835             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     3836             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     3837             v-field-val = substitute( '"&1"', v-field-val )
     3838           .
     3839         end.
     3840         assign
     3841           o-where = substitute( "&1 &2", o-where, v-field-val )
     3842         .
     3843         if v-word-link = "":U then do:
     3844           assign
     3845             v-word-link = "and":U
     3846           .
     3847         end.
     3848       end.
     3849       delete object bh_tbl-name.
     3850       if     bh_tbl-key ne ?
     3851       then
     3852          delete object bh_tbl-key.
     3853       if p-key-handle = ?
     3854         and v-count-fld <> v-field-num
     3855       then do:
     3856         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info41, vTable ).
     3857       end.
     3858     end.
     3859   end procedure.
     3860   procedure gen-hn-keyr-tab :
     3861     define input  parameter i-tableSerach as character no-undo.
     3862     define input  parameter i-tablekey   as character no-undo.
     3863     define input  parameter p-key-rec    as character no-undo.
     3864     define input  parameter p-key-handle as handle    no-undo .
     3865     define input  parameter p-db-name    as character no-undo .
     3866     define input  parameter p-tt-handle  as handle    no-undo .
     3867     define input  parameter p-stts-lock  as integer   no-undo .
     3868     define output parameter o-hn         as handle    no-undo.
     3869     define variable v-full-tbl-name as character no-undo.
     3870     define variable v-where         as character no-undo.
     3871     define variable bh_tbl-name     as handle    no-undo.
     3872     define variable vTable          as character no-undo.
     3873     do
     3874     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3875     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3876     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     3877         run gen-where-keyr-tab(i-tableSerach,
     3878                                i-tablekey,
     3879                                p-key-rec,
     3880                                p-key-handle,
     3881                                p-db-name,
     3882                                p-tt-handle,
     3883                                output v-where).
     3884         if i-tableSerach ne "" and i-tableSerach ne ?
     3885         then do:
     3886            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     3887            create buffer bh_tbl-name for table v-full-tbl-name .
     3888         end.
     3889         else do:
     3890            if p-tt-handle = ? then do:
     3891               assign
     3892                  vTable = entry( 1 , p-key-rec, chr(3) )
     3893               .
     3894               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     3895               create buffer bh_tbl-name for table v-full-tbl-name .
     3896            end.
     3897            else do:
     3898               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3899            end.
     3900         end.
     3901         if p-tt-handle = ? then do:
     3902            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     3903         end.
     3904         else do:
     3905            bh_tbl-name:find-first( v-where ) no-error .
     3906         end.
     3907         o-hn = bh_tbl-name.
     3908      end.
     3909   end procedure.
     3910   procedure gen-hn-keyr :
     3911     define input  parameter p-key-rec    as character no-undo.
     3912     define input  parameter p-key-handle as handle    no-undo .
     3913     define input  parameter p-db-name    as character no-undo .
     3914     define input  parameter p-tt-handle  as handle    no-undo .
     3915     define input  parameter p-stts-lock  as integer   no-undo .
     3916     define output parameter o-hn         as handle    no-undo.
     3917     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     3918   end.
     3919   procedure gen-row-keyr :
     3920     define input  parameter p-key-rec    as character no-undo.
     3921     define input  parameter p-key-handle as handle    no-undo .
     3922     define input  parameter p-db-name    as character no-undo .
     3923     define input  parameter p-tt-handle  as handle    no-undo .
     3924     define input  parameter p-stts-lock  as integer   no-undo .
     3925     define output parameter p-tbl-row    as rowid     no-undo.
     3926     define output parameter p-tbl-name   as character no-undo.
     3927     define variable vHn as handle no-undo.
     3928       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     3929       p-tbl-row = if vHn:available then vHn:rowid else ?.
     3930       p-tbl-name =  vHn:table.
     3931       delete object vHn no-error.
     3932     if p-tbl-row = ? then do:
     3933       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info41, p-tbl-name, p-key-rec ).
     3934     end.
     3935     else do:
     3936       return.
     3937     end.
     3938   end procedure.
     3939   procedure gen-key-fv :
     3940     define input  parameter p-key-rec    as character no-undo .
     3941     define output parameter p-field-list as character no-undo .
     3942     define output parameter p-value-list as character no-undo.
     3943     do
     3944     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3945     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3946     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3947     :
     3948       define variable v-full-tbl-name  as character no-undo .
     3949       define variable bh_tbl-name      as handle    no-undo .
     3950       define variable v-tbl-name       as character no-undo .
     3951       define variable v-field-num      as integer   no-undo .
     3952       define variable v-count-fld      as integer   no-undo .
     3953       define variable v-inform         as character no-undo .
     3954       define variable v-ind            as integer   no-undo .
     3955       define variable v-idx-field-qnty as integer   no-undo .
     3956       define variable v-delim-key      as character no-undo .
     3957       if p-key-rec = ?
     3958         or p-key-rec = "":U
     3959       then do:
     3960         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info41 ).
     3961       end.
     3962       assign
     3963         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     3964         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3965       .
     3966       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3967       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info41 ).
     3968       assign
     3969         v-inform = bh_tbl-name:index-information(1)
     3970         v-ind    = 2
     3971       .
     3972       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3973       on error undo, return error
     3974       :
     3975         assign
     3976           v-inform = bh_tbl-name:index-information( v-ind )
     3977           v-ind    = v-ind + 1
     3978         .
     3979       end.
     3980       if v-inform = ?
     3981         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3982         or entry( 3, v-inform, ",":U ) <> "1":U
     3983       then do:
     3984         delete object bh_tbl-name no-error.
     3985         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info41, v-tbl-name ).
     3986       end.
     3987       assign
     3988         v-idx-field-qnty = num-entries( v-inform ) - 4
     3989       .
     3990       if v-idx-field-qnty < 2 then do:
     3991         delete object bh_tbl-name no-error.
     3992         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info41, v-inform, v-tbl-name ).
     3993       end.
     3994       assign
     3995         p-field-list = "":U
     3996         p-value-list = "":U
     3997         v-delim-key  = "":U
     3998         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     3999         v-count-fld  = 0
     4000       .
     4001       block_where:
     4002       do v-ind = 1 to v-idx-field-qnty by 2
     4003       on error undo, return error
     4004       :
     4005         assign
     4006           v-count-fld = v-count-fld + 1
     4007         .
     4008         if v-count-fld > v-field-num then do:
     4009           leave block_where.
     4010         end.
     4011         assign
     4012           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     4013           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     4014         .
     4015         if v-ind = 1 then do:
     4016           assign
     4017             v-delim-key = chr(3)
     4018           .
     4019         end.
     4020       end.
     4021       delete object bh_tbl-name.
     4022       if v-count-fld <> v-field-num then do:
     4023         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info41, v-tbl-name ).
     4024       end.
     4025     end.
     4026   end procedure.
     4027   procedure gen-key-field :
     4028     define input  parameter p-table      as character no-undo .
     4029     define output parameter p-field-list as character no-undo .
     4030     do
     4031     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4032     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     4033     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     4034     :
     4035       define variable v-full-tbl-name  as character no-undo .
     4036       define variable bh_tbl-name      as handle    no-undo .
     4037       define variable v-tbl-name       as character no-undo .
     4038       define variable v-field-num      as integer   no-undo .
     4039       define variable v-count-fld      as integer   no-undo .
     4040       define variable v-inform         as character no-undo .
     4041       define variable v-ind            as integer   no-undo .
     4042       define variable v-idx-field-qnty as integer   no-undo .
     4043       define variable v-delim-key      as character no-undo .
     4044       if p-table = ?
     4045         or p-table = "":U
     4046       then do:
     4047         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info41 ).
     4048       end.
     4049       assign
     4050         v-tbl-name      = p-table
     4051         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     4052       .
     4053       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     4054       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info41 ).
     4055       assign
     4056         v-inform = bh_tbl-name:index-information(1)
     4057         v-ind    = 2
     4058       .
     4059       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4060       on error undo, return error
     4061       :
     4062         assign
     4063           v-inform = bh_tbl-name:index-information( v-ind )
     4064           v-ind    = v-ind + 1
     4065         .
     4066       end.
     4067       if v-inform = ?
     4068         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4069         or entry( 3, v-inform, ",":U ) <> "1":U
     4070       then do:
     4071         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info41, v-tbl-name ).
     4072       end.
     4073       assign
     4074         v-idx-field-qnty = num-entries( v-inform ) - 4
     4075       .
     4076       if v-idx-field-qnty < 2 then do:
     4077         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info41, v-inform, v-tbl-name ).
     4078       end.
     4079       assign
     4080         p-field-list = "":U
     4081         v-delim-key  = "":U
     4082         v-count-fld  = 0
     4083       .
     4084       block_where:
     4085       do v-ind = 1 to v-idx-field-qnty by 2
     4086       on error undo, return error
     4087       :
     4088         assign
     4089           v-count-fld = v-count-fld + 1
     4090         .
     4091         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     4092         if v-ind = 1 then do:
     4093           assign
     4094             v-delim-key = chr(3)
     4095           .
     4096         end.
     4097       end.
     4098       delete object bh_tbl-name.
     4099     end.
     4100   end procedure.
     4101   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4102   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
