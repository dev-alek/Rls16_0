     2895                                        in-vatp-goods.prod-type = b_doc-line.prod-type and
     2896                                        in-vatp-goods.prod-code = b_doc-line.prod-code no-lock.
     2897      if (not b_trn-doc.internal and
     2898              b_trn-doc.doc-type = 'при':U) or
