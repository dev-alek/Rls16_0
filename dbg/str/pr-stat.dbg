     1139   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1140   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1141   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1142   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1143   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1144   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1145   ASSIGN
     1146      v-S_CONTRACT                = "Contract":U
     1147      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1148      v-DELIM_CHR_3               = ","
     1149      .
     1150   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1151   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1152   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1153   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1154      INPUT iHost-Code    AS INTEGER,
     1155      INPUT iContract-Num AS INTEGER,
     1156      INPUT iGds-Code     AS INTEGER ):
     1157      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1158      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1159      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1160      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1161      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1162      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1163          INPUT  iHost-Code,
     1164          INPUT  iContract-Num,
     1165          OUTPUT iTmp-Extent3
     1166          ).
     1167      IF iTmp-Extent3[1] = 2 THEN DO:
     1168         ASSIGN
     1169            iTmp-Host-Code      = iTmp-Extent3[2]
     1170            iTmp-Contract-Num   = iTmp-Extent3[3]
     1171            .
     1172      END. ELSE DO:
     1173         ASSIGN
     1174            iTmp-Host-Code      = iHost-Code
     1175            iTmp-Contract-Num   = iContract-Num
     1176            .
     1177      END.
     1178      IF iGds-Code = ? THEN DO:
     1179         ASSIGN
     1180            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1181                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1182                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1183                           ).
     1184      END. ELSE DO:
     1185            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1186                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1187                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1188                              AND buf_Spec.Gds-Code      = iGds-Code
     1189                            ).
     1190      END.
     1191      RETURN (lRet).
     1192   END FUNCTION.
     1193   PROCEDURE MS-Contract-EXTENT-3:
     1194      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1195      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1196      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1197      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1198      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1199      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1200      FIND FIRST buf_Cont-2 WHERE
     1201                 buf_Cont-2.Host-Code      = i-Host-Code
     1202             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1203           NO-LOCK NO-ERROR.
     1204      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1205         RETURN.
     1206      END.
     1207      FOR FIRST buf_Ext-Classif WHERE
     1208                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1209           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1210                                               STRING(i-Contract-code)
     1211           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1212          NO-LOCK,
     1213          EACH buf_Cont WHERE
     1214               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1215           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1216          NO-LOCK:
     1217          ASSIGN
     1218             i-Ret[1] = 1
     1219             i-Ret[2] = buf_Cont.Host-code
     1220             i-Ret[3] = buf_Cont.Contract-code
     1221             .
     1222          LEAVE.
     1223      END.
     1224      IF i-Ret[1] <> 1 THEN DO:
     1225         FOR FIRST buf_Ext-Classif WHERE
     1226                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1227              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1228                                                  STRING(i-Contract-code)
     1229              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1230             NO-LOCK,
     1231             EACH buf_Cont WHERE
     1232                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1233              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1234             NO-LOCK:
     1235             ASSIGN
     1236                i-Ret[1] = 2
     1237                i-Ret[2] = buf_Cont.Host-code
     1238                i-Ret[3] = buf_Cont.Contract-code
     1239                .
     1240             LEAVE.
     1241         END.
     1242      END.
     1243      RETURN.
     1244   END PROCEDURE.
     1245   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1246   procedure ggoattr-code :
     1247     define input  parameter p-code           as character no-undo .
     1248     define output parameter p-type           as character no-undo .
     1249     define output parameter p-format         as character no-undo .
     1250     define output parameter p-label          as character no-undo .
     1251     define output parameter p-user-can-edit  as logical   no-undo .
     1252     define output parameter p-output-display as logical   no-undo .
     1253     define output parameter p-other          as character no-undo .
     1254     do
     1255     on error undo, return error
     1256     :
     1257           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-code in g#attr-lib
     1258         (input  p-code
     1259         ,output p-type
     1260         ,output p-format
     1261         ,output p-label
     1262         ,output p-user-can-edit
     1263         ,output p-output-display
     1264         ,output p-other
     1265         ) no-error .
     1266       if error-status :error
     1267       then do:
     1268         undo, return error return-value .
     1269       end.
     1270     end.
     1271   end procedure.
     1272   procedure ggoattr-tooltip :
     1273     define input  parameter p-code    as character no-undo .
     1274     define output parameter p-tooltip as character no-undo .
     1275     define output parameter p-label   as character no-undo .
     1276     do
