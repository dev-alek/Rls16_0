     3053          run view-price-list-attr (
     3054               input   'full-price-sale':U   ,
     3055               input   b_price-list.b-code       ,
     3056               input   b_price-list.doc-num      ,
     3057               input   b_price-list.price-type   ,
     3058               output  p-attr-value   ).
     3059              if not ( p-attr-value = ? or p-attr-value = "")  then
     3060                      tt-price-sale = decimal(p-attr-value).
     3061                 else  tt-price-sale = b_price-list.price-sale .
     3062           if v-bonus <> ? and v-bonus <> 0 then do:
     3063               l_price0 = l_price .
     3064               l_price = l_price + ( l_price * v-bonus / 100 ) .
     3065           end.
     3066           t-prc = ( (tt-price-sale / v-koff)   / l_price - 1) * 100 .
     3067      end.
     3068   end.
     3069     if  p-prc-max <> ? then do:
     3070       if  t-prc <> ? and ( p-prc-max < t-prc  or p-prc-min > t-prc)
     3071       then do:
     3072         message (if b_price-list.main-price = true then "По товару :"
     3073             else "По признаку"  )
     3074             b_price-list.artic
     3075             b_price-list.prod-type
     3076             b_price-list.prod-code skip
     3077             "бар-код: " b_price-list.b-code skip
