     1039   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1040   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
     1041                                           local-doc-num as char).
     1042   define buffer base-price        for ub.price-list.
     1043   define variable local-main-code like ub.bar-code.b-code no-undo.
     1044   define variable local-base-code like ub.bar-code.b-code no-undo.
     1045     run prc-base-code (input local-bc, output local-base-code).
     1046     find base-price no-lock where
     1047          base-price.doc-num = local-doc-num and
     1048          base-price.b-code  = local-base-code and
     1049          base-price.price-type = "" no-error.
     1050     if not available base-price then do:
     1051       run prc-main-code (input local-bc, output local-main-code).
     1052       find  base-price no-lock where
     1053             base-price.doc-num = local-doc-num and
     1054             base-price.b-code  = local-main-code and
     1055             base-price.price-type = "" no-error.
     1056     end.
     1057     if available base-price then
     1058       return (base-price.price-sale).
     1059     else
     1060       return (?).
     1061   END FUNCTION.
     1062   procedure prc-main-code:
     1063   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1064   define output parameter local-main-code like ub.bar-code.b-code no-undo.
     1065   define buffer local-bar-code        for ub.bar-code.
     1066   define buffer local-goods           for ub.goods.
     1067   define buffer main-code             for ub.bar-code.
     1068   define buffer main-prt              for ub.gds-prt.
     1069     local-main-code = ?.
     1070     find local-bar-code no-lock where
     1071          local-bar-code.b-code = local-bc no-error.
     1072     if not available local-bar-code then
     1073       return.
     1074     find local-goods no-lock where
     1075          local-goods.gds-code = local-bar-code.gds-code.
     1076     find first  main-prt no-lock where
     1077                 main-prt.upper-code = local-goods.prt-root.
     1078     find  main-code no-lock where
     1079           main-code.gds-code  = local-bar-code.gds-code and
     1080           main-code.in-code   = "" and
     1081           main-code.part-code = "" and
     1082           main-code.unit-cli  = local-goods.unit-base and
     1083           main-code.node-code = main-prt.node-code.
     1084     local-main-code = main-code.b-code.
     1085   end procedure.
     1086   procedure prc-base-code:
     1087   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1088   define output parameter local-base-code like ub.bar-code.b-code no-undo.
     1089   define buffer local-bar-code for ub.bar-code.
     1090   define buffer local-goods    for ub.goods.
     1091   define buffer base-code      for ub.bar-code.
     1092     local-base-code = ?.
     1093     find local-bar-code no-lock where
     1094          local-bar-code.b-code = local-bc no-error.
     1095     if not available local-bar-code then
     1096       return.
     1097     find local-goods no-lock where
     1098          local-goods.gds-code = local-bar-code.gds-code.
     1099     find base-code no-lock where
     1100          base-code.gds-code  = local-bar-code.gds-code and
     1101          base-code.node-code = local-bar-code.node-code and
     1102          base-code.in-code   = local-bar-code.in-code and
     1103          base-code.part-code = local-bar-code.part-code and
     1104          base-code.unit-cli  = local-goods.unit-base.
     1105     local-base-code = base-code.b-code.
     1106   end procedure.
