      808   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      809   procedure tax-name:
      810   define input  parameter pardef-tax  as character           no-undo.
      811   define output parameter parname-tax as character initial ? no-undo.
      812   define buffer bf_tax for ub.tax.
      813   do on error undo, return error :
      814      case pardef-tax:
      815         when 'vat':U then do:
      816                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      817         end.
      818         when 'slt':U then do:
      819                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      820         end.
      821         when 'rdt':U then do:
      822                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      823         end.
      824         when 'exc':U then do:
      825                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      826         end.
      827         otherwise do:
      828            return error "Задан неверный параметр " + pardef-tax + " .".
      829         end.
      830      end case.
      831   end.
      832   end procedure.
      833   procedure create-price-list-attr :
      834    do
      835    on error undo, return error return-value
      836    :
      837   define input parameter p-attr-code    like ub.price-list-attr.attr-code  no-undo .
      838   define input parameter p-attr-value   like ub.price-list-attr.attr-value no-undo .
      839   define input parameter p-b-code       like ub.price-list-attr.b-code     no-undo .
      840   define input parameter p-doc-num      like ub.price-list-attr.doc-num    no-undo .
      841   define input parameter p-price-type   like ub.price-list-attr.price-type no-undo .
      842   define buffer buf_price-list-attr for ub.price-list-attr.
      843   find first buf_price-list-attr  exclusive-lock  where
      844     buf_price-list-attr.attr-code    = p-attr-code    and
      845     buf_price-list-attr.b-code       = p-b-code       and
      846     buf_price-list-attr.doc-num      = p-doc-num      and
      847     buf_price-list-attr.price-type   = p-price-type  no-error .
      848     if not available  buf_price-list-attr then do:
      849         create buf_price-list-attr.
      850         assign
      851           buf_price-list-attr.attr-code    = p-attr-code
      852           buf_price-list-attr.attr-value   = p-attr-value
      853           buf_price-list-attr.b-code       = p-b-code
      854           buf_price-list-attr.doc-num      = p-doc-num
      855           buf_price-list-attr.price-type   = p-price-type
      856         .
      857     end.
      858     else do:
      859           buf_price-list-attr.attr-value   = p-attr-value .
      860     end.
      861    end.
      862   end procedure.
      863   procedure view-price-list-attr :
      864    do
      865    on error undo, return error return-value
      866    :
      867   define input  parameter p-attr-code    like ub.price-list-attr.attr-code  no-undo .
      868   define input  parameter p-b-code       like ub.price-list-attr.b-code     no-undo .
      869   define input  parameter p-doc-num      like ub.price-list-attr.doc-num    no-undo .
      870   define input  parameter p-price-type   like ub.price-list-attr.price-type no-undo .
      871   define output parameter p-attr-value   like ub.price-list-attr.attr-value no-undo .
      872   define buffer buf_price-list-attr for ub.price-list-attr.
      873   find first buf_price-list-attr no-lock where
      874     buf_price-list-attr.attr-code    = p-attr-code    and
      875     buf_price-list-attr.b-code       = p-b-code       and
      876     buf_price-list-attr.doc-num      = p-doc-num      and
      877     buf_price-list-attr.price-type   = p-price-type  no-error .
      878     if available  buf_price-list-attr then do:
      879         assign
      880           p-attr-value = buf_price-list-attr.attr-value
      881         .
      882     end.
      883     else do:
      884           p-attr-value = ? .
      885     end.
      886    end.
      887   end procedure.
      888   procedure pdoc-forming-attr :
      889   define input  parameter p-plt-id       as integer   no-undo .
      890   define input  parameter p-plt-db-num   as integer   no-undo .
      891   define input  parameter p-pdf-id       as integer   no-undo .
      892   define input  parameter p-pdf-db       as integer   no-undo .
      893   define input  parameter p-attr-code    as character no-undo .
      894   define input  parameter p-val          as character no-undo .
      895     do
      896     on error undo, return error return-value
      897     :
      898     find first  ub.price-doc-forming-attr exclusive-lock where
      899                 ub.price-doc-forming-attr.plt-id       = p-plt-id       and
      900                 ub.price-doc-forming-attr.plt-db-num   = p-plt-db-num   and
      901                 ub.price-doc-forming-attr.pdf-id       = p-pdf-id       and
      902                 ub.price-doc-forming-attr.pdf-db       = p-pdf-db       and
      903                 ub.price-doc-forming-attr.attr-code    = p-attr-code
      904                 no-error .
      905       if not available  ub.price-doc-forming-attr then create ub.price-doc-forming-attr.
      906       assign
      907         ub.price-doc-forming-attr.plt-id       = p-plt-id
      908         ub.price-doc-forming-attr.plt-db-num   = p-plt-db-num
      909         ub.price-doc-forming-attr.pdf-id       = p-pdf-id
      910         ub.price-doc-forming-attr.pdf-db       = p-pdf-db
      911         ub.price-doc-forming-attr.attr-code    = p-attr-code
      912         ub.price-doc-forming-attr.attr-value   = p-val
      913       .
      914     end.
      915   end procedure.
      916   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      917   procedure check-use-bar-code :
      918     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
      919     do
      920     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      921     on stop   undo, return error substitute( "&1. stop", vss-include-info6 )
      922     on endkey undo, return error substitute( "&1. endkey", vss-include-info6 )
      923     :
      924       define buffer buf_bar-code for ub.bar-code .
      925       find first buf_bar-code no-lock
      926         where buf_bar-code.b-code     = p-b-code
      927         no-error .
      928       if not available buf_bar-code then do:
      929         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info6, p-b-code ) .
      930       end.
      931       if buf_bar-code.stts = integer('99':U) then do:
      932         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
      933                                 + "Выполняется удаление бар-кода"
      934                                 ,vss-include-info6
      935                                 ,p-b-code
      936                                 ,chr(10)
      937                               ) .
      938       end.
      939       if buf_bar-code.stts = integer('79':U) then do:
      940         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
      941                                 + "Бар-код выключен"
      942                                 ,vss-include-info6
      943                                 ,p-b-code
      944                                 ,chr(10)
      945                               ) .
      946       end.
      947       return .
      948     end.
      949   end procedure.
      950   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      951   define variable var-pr-r-b as character no-undo .
      952   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      953   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      954     (output var-pr-r-b
      955     )  .
      956   function fnc-cost-pc return decimal (buffer local-price-list for ub.price-list).
      957   define variable f-cost     as decimal no-undo .
      958   define variable f-cost-pc  as decimal no-undo .
      959   find first ub.goods where ub.goods.artic = local-price-list.artic and
      960                          ub.goods.prod-type = local-price-list.prod-type and
      961                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
      962   find ub.gds-obj no-lock where
      963        ub.gds-obj.gds-code = ub.goods.gds-code and
      964        ub.gds-obj.obj-type = local-price-list.obj-type and
      965        ub.gds-obj.obj-code = local-price-list.obj-code no-error.
      966   if  available ub.gds-obj then
      967     if ub.goods.gds-type = 'т':U then
      968       assign
      969         f-cost = ( if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base)
      970         .
      971       else  f-cost = ?.
      972   else f-cost = ?.
      973    f-cost-pc = (round(local-price-list.price-sale / f-cost , 2) - 1) * 100.
      974     if f-cost-pc > 9999 then
      975       f-cost-pc = ?.
      976     return (f-cost-pc).
      977   end function.
      978   function fnc-pr-pc return decimal (buffer local-price-list for ub.price-list).
      979   define variable f-pr     as decimal no-undo .
      980   define variable f-pr-pc  as decimal no-undo.
      981   find first ub.goods where ub.goods.artic = local-price-list.artic and
      982                          ub.goods.prod-type = local-price-list.prod-type and
      983                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
      984   find ub.gds-obj no-lock where
      985        ub.gds-obj.gds-code = ub.goods.gds-code and
      986        ub.gds-obj.obj-type = local-price-list.obj-type and
      987        ub.gds-obj.obj-code = local-price-list.obj-code  no-error .
      988   if  available ub.gds-obj then do:
      989     if ub.goods.gds-type = 'т':U then
      990       assign
      991         f-pr = (if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl else ub.gds-obj.last-base)
      992         .
      993       else f-pr = ?.
      994   end.
      995   else f-pr = ?.
      996     f-pr-pc = ( local-price-list.price-sale / f-pr - 1 ) * 100.
      997     if f-pr-pc > 9999 then
      998       f-pr-pc = ?.
      999     return (f-pr-pc).
     1000   end function.
     1001   function fnc-cost return decimal (buffer local-price-list for ub.price-list).
     1002   define variable f-cost   as decimal no-undo .
     1003   find first ub.goods where
     1004              ub.goods.artic = local-price-list.artic and
     1005              ub.goods.prod-type = local-price-list.prod-type and
     1006              ub.goods.prod-code = local-price-list.prod-code no-lock
     1007              no-error .
     1008   find ub.gds-obj no-lock where
     1009        ub.gds-obj.gds-code = ub.goods.gds-code and
     1010        ub.gds-obj.obj-type = local-price-list.obj-type and
     1011        ub.gds-obj.obj-code = local-price-list.obj-code no-error.
     1012   if  available ub.gds-obj then
     1013     if ub.goods.gds-type = 'т':U then
     1014       assign
     1015         f-cost = if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
     1016         .
     1017       else  f-cost = ?.
     1018   else f-cost = ?.
     1019     return ( f-cost ).
     1020   end function.
     1021   function fnc-pr return decimal (buffer local-price-list for ub.price-list).
     1022   define variable f-pr   as decimal no-undo .
