     3117   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3118   procedure check-alc-min-price :
     3119    do
     3120    on error undo, return error return-value
     3121    :
     3122     define input parameter   p-doc        like ub.price-doc.doc-num no-undo.
     3123     define output parameter  p-err        as logical no-undo .
     3124     define variable v-alcohol-prod  as logical   no-undo.
     3125     define variable v-alc-min-price as character no-undo.
     3126     define variable v-type          as character no-undo.
     3127     define variable i               as integer   no-undo.
     3128     define variable proof-price     as character no-undo.
     3129     define variable v-base-code     as integer   no-undo.
