     5371   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     5372     (input  buf-price-doc.host-code
     5373     ,input  buf-price-doc.fact-date
     5374     ,output buf-price-doc.base-rate
     5375     ,output buf-price-doc.base-scale
     5376     ) no-error .
     5377       if error-status :error
     5378       then do:
     5379         if p-ask-q = false then
     5380         message
     5381           vss-workfile vss-revision vss-description skip
     5382           "Ошибка при определении текущего курса в переоценке " skip
     5383           "Код фирмы" buf-price-doc.host-code skip
     5384           "Дата" buf-price-doc.fact-date skip
     5385           error-status :get-message(1) skip
     5386           return-value skip
     5387           view-as alert-box error .
     5388         undo main-block, return error "Ошибка при определении текущего курса в переоценке " .
     5389       end.
     5390     release buf-price-doc no-error .
     5391     if error-status :error then do:
     5392        undo main-block, return error return-value .
     5393     end.
     5394     find first buf-price-doc no-lock
     5395       where buf-price-doc.doc-num = price-doc-num
     5396       no-error .
     5397       if buf-price-doc.status_ = 'акт':U then do:
     5398           run str/pdfdiscl.p ( Parparentproc , price-doc-num ) no-error .
     5399           if error-status :error then do:
     5400               message
     5401                 vss-workfile vss-revision vss-description skip
     5402                 error-status :get-message(1) skip
     5403                 return-value skip
     5404                 "из pdfdiscl"
     5405                 view-as alert-box error
     5406               .
     5407               undo main-block, return error substitute("Ошибка при закрытии порожденных ДНЦ &1 по переоценке &2 ." ,return-value , price-doc-num) .
     5408           end.
     5409       end.
     5410       if p-mode = "close"
     5411       then do:
     5412         case buf-price-doc.status_ :
     5413           when 'разрешен':U
     5414           then do:
     5415             if p-ask-q = false then
     5416             message "Переоценка включена.".
     5417             if buf-price-doc.obj-type = 'маг':U
     5418             then do:
     5419               if p-ask-q = false then
     5420               message
     5421                 "Рекомендуется принять чеки," skip
     5422                 "закрыть отчеты о продажах" skip
     5423                 "и после этого закрывать переоценку." skip
     5424                 view-as alert-box information .
     5425             end.
     5426           end.
     5427         end.
     5428       end.
     5429       define buffer buf_thbj-attr for ub.thbj-attr.
     5430       define variable v-uniq-key-rec as character no-undo .
     5431       find first buf_thbj-attr no-lock where
     5432                 buf_thbj-attr.upper-prop-code = 'rum':U
     5433             and buf_thbj-attr.prop-code = 'edoc':U
     5434             and buf_thbj-attr.obj-type = ''
     5435             and buf_thbj-attr.obj-code = 0
     5436             and buf_thbj-attr.property-value-logical = yes
     5437             no-error.
     5438       if available buf_thbj-attr then do:
     5439         run gen-key-rec in this-procedure (
     5440                                           input  'thbj-attr':U
     5441                                         ,input (buffer buf_thbj-attr:handle)
     5442                                         ,output v-uniq-key-rec).
     5443         run str/edocrum.p
     5444           (
     5445           input parparentproc
     5446           ,input this-procedure:handle
     5447           ,input p-log-handle
     5448           ,input 'batchwork-routing_price-doc':U
     5449           ,input 0
     5450           ,input 18
     5451           ,input 10
     5452           ,input curr-db-num
     5453           ,input v-uniq-key-rec
     5454           ,input ( buf-price-doc.doc-num + chr(4) + '')
     5455           ,input yes
     5456           ) no-error .
     5457         if error-status:error then do:
     5458           undo main-block, return error substitute("Ошибка при маршрутизации переоценки во внешнюю систему:&1&2&1&3"
     5459                                                    , chr(10)
     5460                                                    , error-status:get-message(1)
     5461                                                    , return-value) .
     5462         end.
     5463       end.
     5464       define variable varok as logical no-undo.
     5465       run check-the-same-object (output varok).
     5466       if buf-price-doc.obj-type = 'маг':U and
     5467           can-find (first ub.scales no-lock where ub.scales.db-num = curr-db-num ) and  varok
     5468       then do:
     5469         run send-to-scales(INPUT int(recid(buf-price-doc))) no-error.
     5470         if error-status:error then
     5471           undo main-block, return error subst("Ошибка при отправке на весы - &1", return-value).
     5472       end.
     5473     end.
     5474     run waitfram-hide in this-procedure .
     5475   end.
     5476   procedure check-the-same-object :
     5477     define output parameter p-ok as logical no-undo .
     5478     find first ub.clients no-lock
     5479       where ub.clients.obj-type = buf-price-doc.obj-type
     5480         and ub.clients.obj-code = buf-price-doc.obj-code
     5481       .
     5482     assign
     5483       p-ok = (ub.clients.db-num = curr-db-num )
     5484     .
     5485   end procedure.
     5486   procedure proc-cost-price-fact :
     5487    do
     5488    on error undo, return error return-value
     5489    :
     5490   define variable v-total-avrg-base  as decimal no-undo .
     5491   define variable v-total-avrg-rubl  as decimal no-undo .
     5492   define variable v-total-avrg-qnty  as decimal no-undo .
     5493   define buffer buf_parts for ub.parts.
     5494   define buffer buf_price-list for ub.price-list.
     5495   define variable p-price-base as decimal no-undo .
     5496   define variable p-price-rubl as decimal no-undo .
     5497   for each buf_price-list no-lock
     5498       where buf_price-list.doc-num = buf-price-doc.doc-num
     5499   on error undo, return error return-value
     5500   :
     5501         for each buf_parts no-lock
     5502           where  buf_parts.obj-type  = buf-price-doc.obj-type
     5503             and buf_parts.obj-code   = buf-price-doc.obj-code
     5504             and buf_parts.artic      = buf_price-list.artic
     5505             and buf_parts.prod-type  = buf_price-list.prod-type
     5506             and buf_parts.prod-code  = buf_price-list.prod-code
     5507             and ( buf_parts.out-code  = 'free-zone':U  or
     5508                   buf_parts.out-code  = buf-price-doc.doc-num
     5509             )
     5510         on error undo, return error return-value
     5511         :
     5512           assign
     5513             v-total-avrg-base = v-total-avrg-base
     5514                               + (buf_parts.price-base * buf_parts.qnty)
     5515             v-total-avrg-rubl = v-total-avrg-rubl
     5516                               + (buf_parts.price-rubl * buf_parts.qnty)
     5517             v-total-avrg-qnty = v-total-avrg-qnty
     5518                               + buf_parts.qnty
     5519           .
     5520         end.
     5521         if v-total-avrg-qnty > 0
     5522         then do:
     5523           assign
     5524             p-price-base = ( v-total-avrg-base / v-total-avrg-qnty )
     5525             p-price-rubl = ( v-total-avrg-rubl / v-total-avrg-qnty )
     5526           .
     5527         end.
     5528         else do:
     5529           assign
     5530             p-price-base = ?
     5531             p-price-rubl = ?
     5532           .
     5533         end.
     5534    define variable p-attr-value as character no-undo .
     5535    if var-pr-r-b = "rubl" then
     5536       p-attr-value = string ( p-price-rubl ) .
     5537       else
     5538       p-attr-value = string ( p-price-base ) .
     5539     run create-price-list-attr in this-procedure (
     5540       'cost-price-fact':U    ,
     5541       p-attr-value          ,
     5542       buf_price-list.b-code ,
     5543       buf-price-doc.doc-num ,
     5544       ""
     5545       ) .
     5546   end.
     5547    end.
     5548   end procedure.
     5549   procedure proc-d-pcnt :
     5550   define input  parameter p-doc-code as character no-undo .
     5551   define output parameter v-rez as logical   no-undo  .
     5552     do
     5553     on error undo, return error return-value
     5554     :
     5555   define buffer bb_price-list for ub.price-list  .
     5556   v-rez = false .
     5557     end.
     5558   end procedure.
     5559   procedure update-den-price-all :
     5560   define buffer buf_price-all for ub.price-all  .
     5561     do
     5562     on error undo, return error return-value
     5563     :
     5564     for each ub.price-list  where ub.price-list.doc-num = buf-price-doc.doc-num
     5565     on error undo , return error return-value
     5566     :
     5567       find ub.goods no-lock
     5568         where ub.goods.artic     = ub.price-list.artic
     5569           and ub.goods.prod-type = ub.price-list.prod-type
     5570           and ub.goods.prod-code = ub.price-list.prod-code
     5571         .
     5572           find first buf_price-all exclusive-lock where
     5573                     buf_price-all.obj-type = buf-price-doc.obj-type and
     5574                     buf_price-all.obj-code = buf-price-doc.obj-code and
     5575                     buf_price-all.main-indication = 0 and
     5576                     buf_price-all.plt-id       = buf-price-doc.plt-id   and
     5577                     buf_price-all.plt-db-num   = buf-price-doc.plt-db-num and
     5578                     buf_price-all.pdf-id       = buf-price-doc.pdf-id     and
     5579                     buf_price-all.pdf-db       = buf-price-doc.pdf-db     and
     5580                     buf_price-all.gds-code     = ub.goods.gds-code and
     5581                     buf_price-all.b-code       = ub.price-list.b-code no-error .
     5582                     if available buf_price-all
     5583                     then do:
     5584                       assign
     5585                         buf_price-all.out-code    = buf-price-doc.doc-num
     5586                         buf_price-all.last-pr     = true
     5587                         buf_price-all.status_     = 'акт':U
     5588                       .
     5589                     end.
     5590          end.
     5591     end.
     5592   end procedure.
     5593   procedure ver-date-period :
     5594   define input  parameter  p-fact-date as date   no-undo .
     5595   define variable v-value-character   as character no-undo .
     5596   define variable v-date-close-period as date      no-undo .
     5597   define variable v-value-decimal     as decimal   no-undo .
     5598   define variable v-value-integer     as integer   no-undo .
     5599   define variable v-value-logical     as logical   no-undo .
     5600   define variable v-value-type        as character no-undo .
     5601     do
     5602     on error undo, return error return-value
     5603     :
     5604     for each thbjattr_thbj-attr:
     5605       delete thbjattr_thbj-attr.
     5606     end.
     5607     run adm/shattri.p (
     5608         input "get":U
     5609         ,input buf-price-doc.obj-type
     5610         ,input buf-price-doc.obj-code
     5611         ,input 'nakl_par':U
     5612         ,input  "date-close-period"
     5613         ,output v-value-character
     5614         ,output v-date-close-period
     5615         ,output v-value-decimal
     5616         ,output v-value-integer
     5617         ,output v-value-logical
     5618         ,output v-value-type
     5619         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     5620         ) no-error .
     5621         if error-status :error then v-date-close-period = date('').
     5622         if v-date-close-period <> date('') then do:
     5623             if  p-fact-date < v-date-close-period
     5624             then do:
     5625               return error substitute(
     5626                 "Дата закрытия документа &1 более ранняя, чем дата закрытия периода &2
     5627                 Дата закрытия документа &3 &2
     5628                 Дата закрытия периода &4
     5629                 Объект &5 &6     " ,
     5630                 buf-price-doc.doc-num  ,
     5631                 chr(10)  ,
     5632                 string ( p-fact-date        , "99/99/9999") ,
     5633                 string ( v-date-close-period, "99/99/9999") ,
     5634                 buf-price-doc.obj-type ,
     5635                 buf-price-doc.obj-code
     5636                 ) .
     5637             end.
     5638         end.
     5639     end.
     5640   end procedure.
     5641   procedure send-to-scales:
     5642       define input parameter p-price-doc-recid as integer no-undo.
     5643       define variable v-param-type as character no-undo .
     5644       define variable v-value-character as character no-undo .
     5645       define variable v-value-date as date no-undo .
     5646       define variable v-value-decimal as decimal no-undo .
     5647       define variable v-value-integer as INTEGER no-undo .
     5648       define variable v-value-logical AS LOGICAL no-undo .
     5649       define variable v-tth as handle no-undo .
     5650       define buffer buf_price-doc for ub.price-doc.
     5651       define buffer buf_price-list for ub.price-list.
     5652       define buffer buf_bar-code for ub.bar-code.
     5653       define buffer buf_goods for ub.goods.
     5654       v-tth = buffer thbjattr_thbj-attr:table-handle .
     5655       for each thbjattr_thbj-attr:
     5656         delete thbjattr_thbj-attr.
     5657       end.
     5658       run adm/shattri.p (
     5659          input "get":U
     5660         ,input  v-cntxt-obj-type
     5661         ,input  v-cntxt-obj-code
     5662         ,input  'scale-inf':U
     5663         ,input  'noauto-scls':U
     5664         , output v-value-character
     5665         , output v-value-date
     5666         , output v-value-decimal
     5667         , output v-value-integer
     5668         , output v-value-logical
     5669         , output v-param-type
     5670         , INPUT-OUTPUT table-handle v-tth
     5671         ) no-error .
     5672       IF error-status:error then do:
     5673           message
     5674           substitute("Ошибка при получении настроек, необъодимых для работы весов НА ОБЪЕКТЕ &1&2:&3&4 &5"
     5675                   , v-cntxt-obj-type
     5676                   , v-cntxt-obj-code
     5677                   , chr(10)
     5678                   , error-status:get-message(1)
     5679                   , return-value )
     5680           view-as alert-box error .
     5681           undo, return error .
     5682       end.
     5683       find first buf_price-doc no-lock
     5684         where recid(buf_price-doc) = p-price-doc-recid.
     5685   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5686   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_add-scal in g#lib-trn3
     5687   (input parparentproc
     5688   ,input buf_price-doc.obj-type
     5689   ,input buf_price-doc.obj-code
     5690   ,input buf_price-doc.doc-num
     5691   ,input 'переоценка':U
     5692   ,input this-procedure
     5693   ) no-error.
     5694       if error-status :error
     5695       then do:
     5696         return error "Ошибка при обновлении информации на весах " + return-value .
     5697       end.
     5698       if v-value-logical OR p-mode = 'close' then return.
     5699       run str/diallog.w
     5700         ( input parparentproc
     5701         , input this-procedure
     5702         , input "ref/sendscal.p":U
     5703         , input (buf_price-doc.obj-type + chr(4) + string(buf_price-doc.obj-code) + chr(4) + chr(63) + chr(4) +
     5704                  "changed":U + chr(4) + '' + chr(4) + "current":U + chr(4) + string(0))
     5705         , input no
     5706         , input "":U
     5707         , input substitute("Отсылка изменений на весы")
     5708         ) no-error.
     5709   end procedure.
