     2908             road-tax-base-loc = b_doc-line.road-tax / b_trn-doc.base-rate * b_trn-doc.base-scale.
     2909         end.
     2910         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     2911         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     2912         assign
     2913           road-tax-cli-loc = ?.
     2914         ASSIGN
     2915           transport-base-loc = (if b_doc-line.transport-base = ? then 0 else b_doc-line.transport-base)
     2916           transport-rubl-loc = (if b_doc-line.transport-rubl = ? then 0 else b_doc-line.transport-rubl)
