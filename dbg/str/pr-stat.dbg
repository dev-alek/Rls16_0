     4389   do
     4390   on error undo, return error return-value
     4391   :
     4392   define variable curr-db-num as integer   no-undo .
     4393   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4394   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     4395     (output curr-db-num
     4396     )  .
     4397   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4398     run mainmenu_getcntxt in parparentproc
     4399       (output v-cntxt-db-num
     4400       ,output v-cntxt-userid
     4401       ,output v-cntxt-level
     4402       ,output v-cntxt-host-code-obj
     4403       ,output v-cntxt-obj-type
     4404       ,output v-cntxt-obj-code
     4405       ,output v-cntxt-db-num-obj
     4406       ,output v-cntxt-is-admin
     4407       ) .
     4408     find first buf-price-doc no-lock
     4409       where buf-price-doc.doc-num = price-doc-num
     4410       no-error .
     4411     if not available buf-price-doc
     4412     then do:
     4413       v-text-mess = substitute ( "Невозможно найти переоценку с номером &1 " , price-doc-num ) .
     4414       if p-ask-q = false then
     4415       message
     4416         vss-workfile vss-revision vss-description skip
     4417         v-text-mess
     4418         view-as alert-box error .
     4419       undo, return error v-text-mess .
     4420     end.
     4421     ASSIGN
     4422       varfact-date  = buf-price-doc.fact-date
     4423       varfact-time  = buf-price-doc.fact-time
     4424       varshift-date = buf-price-doc.shift-date
     4425       varshift-num  = buf-price-doc.shift-num
     4426       varshift-name = buf-price-doc.shift-name
     4427       .
     4428     if  buf-price-doc.status_ <> 'новый':U
     4429     and buf-price-doc.status_ <> 'приказ':U
     4430     and buf-price-doc.status_ <> 'разрешен':U
     4431     and buf-price-doc.status_ <> 'акт':U
     4432     then do:
     4433       v-text-mess  = substitute("Недопустимый исходный статус документа переоценки  &1  Статус &2 " ,  buf-price-doc.doc-num ,    buf-price-doc.status_     ) .
     4434       if p-ask-q = false then
     4435       message
     4436         vss-workfile vss-revision vss-description skip
     4437         v-text-mess
