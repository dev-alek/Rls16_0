      110   procedure grp-obj-write :
      111   do
      112   on error undo, return error
      113   :
      114   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      115   define input parameter p-host-code  as integer                          no-undo.
      116   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      117   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      118   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      119   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      120   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      121   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      122   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      123   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      124   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      125   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      126   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      127       find first buf_gds-grp-obj exclusive-lock
      128            where buf_gds-grp-obj.node-code  = p-node-code
      129              and buf_gds-grp-obj.host-code  = p-host-code
      130              and buf_gds-grp-obj.obj-type   = p-obj-type
      131              and buf_gds-grp-obj.obj-code   = p-obj-code
      132       no-error.
      133       if not available buf_gds-grp-obj
      134       then do:
      135           create buf_gds-grp-obj.
      136           assign
      137                   buf_gds-grp-obj.node-code  = p-node-code
      138                   buf_gds-grp-obj.host-code  = p-host-code
      139                   buf_gds-grp-obj.obj-type   = p-obj-type
      140                   buf_gds-grp-obj.obj-code   = p-obj-code
      141           .
      142       end.
      143       assign
      144       buf_gds-grp-obj.min-increase = p-min-increase
      145       buf_gds-grp-obj.max-increase = p-max-increase
      146       buf_gds-grp-obj.increase-pc = p-increase-pc
      147       buf_gds-grp-obj.calc-method = p-calc-method
      148       buf_gds-grp-obj.round-method = p-round-method
      149       buf_gds-grp-obj.round-coef = p-round-coef
      150       buf_gds-grp-obj.cli-type   = p-cli-type
      151       buf_gds-grp-obj.cli-code   = p-cli-code
      152       .
      153   end.
      154   end procedure.
      155   procedure grp-obj-margin-value :
      156   do
      157   on error undo, return error
      158   :
      159   define input parameter p-node-code as integer      no-undo.
      160   define input parameter p-obj-type  as character    no-undo.
      161   define input parameter p-obj-code  as integer      no-undo.
      162   define output parameter p-min-value as decimal      no-undo init ?.
      163   define output parameter p-max-value as decimal      no-undo init ?.
      164   define output parameter p-increase-pc as decimal      no-undo init ?.
      165   define output parameter p-round-method as character no-undo init "":U.
      166   define output parameter p-base as decimal no-undo init ?.
      167   define output parameter p-range-margin     as integer      no-undo.
      168   define output parameter p-exists-margin    as logical      no-undo.
      169   define output parameter p-range-increase     as integer      no-undo.
      170   define output parameter p-exists-increase    as logical      no-undo.
      171   define output parameter p-range-rmethod     as integer no-undo .
      172   define output parameter p-exists-rmethod    as logical no-undo .
      173   define variable v-host-code as integer      no-undo.
      174   DEFINE VARIABLE v-found as logical no-undo .
      175   DEFINE VARIABLE v-exists as logical no-undo .
      176   DEFINE VARIABLE v-range as integer no-undo .
      177   DEFINE VARIABLE jj as integer no-undo .
      178   DEFINE VARIABLE v-margin-found as logical no-undo .
      179   DEFINE VARIABLE v-increase-found as logical no-undo .
      180   DEFINE VARIABLE v-min-value as decimal      no-undo.
      181   DEFINE VARIABLE v-max-value as decimal      no-undo.
      182   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      183   define variable v-round-method as character no-undo .
      184   define variable v-base as decimal no-undo .
      185   define variable v-print-code as character no-undo .
      186   define buffer buf_gds-grp for ub.gds-grp.
      187   find first buf_gds-grp no-lock where
      188              buf_gds-grp.node-code = p-node-code no-error .
      189   if not avail buf_gds-grp and p-node-code <> 0 then do:
      190     message
      191       vss-workfile vss-revision vss-description
      192       skip "Не удалось найти группу товаров с кодом" p-node-code
      193       view-as alert-box error .
      194     undo, return error .
      195   end.
      196   if p-obj-type <> '' then do:
      197   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      199     (input  p-obj-type
      200     ,input  p-obj-code
      201     ,output v-host-code
      202     ) no-error .
      203     if error-status :error
      204     then do:
      205         message
      206           vss-workfile vss-revision vss-description
      207           skip "Не удалось найти фирму объекта"
      208           skip p-obj-type p-obj-code
      209           skip return-value
      210           skip trim(error-status :get-message(1))
      211               trim(error-status :get-message(2))
      212               trim(error-status :get-message(3))
      213               trim(error-status :get-message(4))
      214               trim(error-status :get-message(5))
      215         view-as alert-box error.
      216         undo, return error .
      217     end.
      218   end.
      219   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      220   do while v-found = no and jj < 2:
      221     if v-range <> 3 then do:
      222       find first buf_gds-grp-obj no-lock
      223           where buf_gds-grp-obj.node-code = p-node-code
      224             and buf_gds-grp-obj.host-code = v-host-code
      225             and buf_gds-grp-obj.obj-type  = p-obj-type
      226             and buf_gds-grp-obj.obj-code  = p-obj-code
      227       no-error .
      228     end.
      229     if v-range = 3 or not available buf_gds-grp-obj
      230     then do:
      231        if v-range <> 2 then do:
      232           find first buf_gds-grp-obj no-lock
      233               where buf_gds-grp-obj.node-code = p-node-code
      234                 and buf_gds-grp-obj.host-code = v-host-code
      235                 and buf_gds-grp-obj.obj-type  = ""
      236                 and buf_gds-grp-obj.obj-code  = 0
      237           no-error .
      238         end.
      239         if v-range = 2 or not available buf_gds-grp-obj
      240         then do:
      241             if v-range <> 1 then do:
      242               find first buf_gds-grp-obj no-lock
      243                   where buf_gds-grp-obj.node-code = p-node-code
      244                   and buf_gds-grp-obj.host-code = 0
      245                   and buf_gds-grp-obj.obj-type  = ""
      246                   and buf_gds-grp-obj.obj-code  = 0
      247               no-error .
      248             end.
      249             if v-range = 1 or not available buf_gds-grp-obj
      250             then do:
      251                 assign
      252                     v-exists = no
      253                 .
      254             end.
      255             else do:
      256                 assign
      257                     v-exists = yes
      258                     v-range = 1
      259                 .
      260             end.
      261         end.
      262         else do:
      263             assign
      264                 v-exists = yes
      265                 v-range  = 2
      266             .
      267         end.
      268     end.
      269     else do:
      270         assign
      271             v-exists = yes
      272             v-range  = 3
      273         .
      274     end.
      275     if available buf_gds-grp-obj
      276     then do:
      277       assign
      278       v-min-value    = buf_gds-grp-obj.min-increase
      279       v-max-value    = buf_gds-grp-obj.max-increase
      280       v-increase-pc  = buf_gds-grp-obj.increase-pc
      281       v-round-method = buf_gds-grp-obj.round-method
      282       v-base         = buf_gds-grp-obj.round-coef
      283       .
      284       assign
      285       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      286                           then yes
      287                           else p-exists-margin)
      288       p-range-margin = if p-exists-margin and p-min-value = ?
      289                         then v-range
      290                         else p-range-margin
      291       p-min-value   =  if p-exists-margin and  p-min-value = ?
      292                         then v-min-value
      293                         else p-min-value
      294       p-max-value   =  if p-exists-margin and  p-max-value = ?
      295                         then v-max-value
      296                         else p-max-value
      297       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      298                           then yes
      299                           else p-exists-increase)
      300       p-range-increase = if p-exists-increase and p-increase-pc = ?
      301                         then v-range
      302                         else p-range-increase
      303       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      304                         then v-increase-pc
      305                         else p-increase-pc)
      306       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      307                           then yes
      308                           else p-exists-rmethod
      309       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      310                           then v-range
      311                           else p-range-rmethod)
      312       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
      313                           then v-round-method
      314                           else p-round-method)
      315       p-base          = (if p-exists-rmethod and p-base = ?
      316                           then v-base
      317                           else p-base)
      318       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
      319       jj = jj + 1
      320       .
      321     end.
      322     else do:
      323       assign
      324       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
      325       jj = jj + 1
      326       .
      327     end.
      328   end.
      329   end.
      330   end procedure.
      331   procedure grp-obj-income-cli-value :
      332   do
      333   on error undo, return error
      334   :
      335   define input parameter p-node-code as integer      no-undo.
      336   define input parameter p-obj-type  as character    no-undo.
      337   define input parameter p-obj-code  as integer      no-undo.
      338   define output parameter p-cli-type as character    no-undo init ?.
      339   define output parameter p-cli-code as integer      no-undo init ?.
      340   define output parameter p-range-income-cli     as integer      no-undo.
      341   define output parameter p-exists-income-cli    as logical      no-undo.
      342   define variable v-host-code as integer      no-undo.
      343   DEFINE VARIABLE v-found as logical no-undo .
      344   DEFINE VARIABLE v-exists as logical no-undo .
      345   DEFINE VARIABLE v-range as integer no-undo .
      346   DEFINE VARIABLE jj as integer no-undo .
      347   DEFINE VARIABLE v-income-cli-found as logical no-undo .
      348   DEFINE VARIABLE v-cli-type-value as char      no-undo.
      349   DEFINE VARIABLE v-cli-code-value as int      no-undo.
      350   define buffer buf_gds-grp for ub.gds-grp.
      351   find first buf_gds-grp no-lock where
      352              buf_gds-grp.node-code = p-node-code no-error .
      353   if not avail buf_gds-grp and p-node-code <> 0 then do:
      354     message
      355       vss-workfile vss-revision vss-description
      356       skip "Не удалось найти группу товаров с кодом" p-node-code
      357       view-as alert-box error .
      358     undo, return error .
      359   end.
      360   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      362     (input  p-obj-type
      363     ,input  p-obj-code
      364     ,output v-host-code
      365     ) no-error .
      366   if error-status :error
      367   then do:
      368       message
      369         vss-workfile vss-revision vss-description
      370         skip "Не удалось найти фирму объекта"
      371         skip p-obj-type p-obj-code
      372         skip return-value
      373         skip trim(error-status :get-message(1))
      374              trim(error-status :get-message(2))
      375              trim(error-status :get-message(3))
      376              trim(error-status :get-message(4))
      377              trim(error-status :get-message(5))
      378       view-as alert-box error.
      379       undo, return error .
      380   end.
      381   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      382   do while v-found = no and jj < 2:
      383     if v-range <> 3 then do:
      384       find first buf_gds-grp-obj no-lock
      385           where buf_gds-grp-obj.node-code = p-node-code
      386             and buf_gds-grp-obj.host-code = v-host-code
      387             and buf_gds-grp-obj.obj-type  = p-obj-type
      388             and buf_gds-grp-obj.obj-code  = p-obj-code
      389       no-error .
      390     end.
      391     if v-range = 3 or not available buf_gds-grp-obj
      392     then do:
      393        if v-range <> 2 then do:
      394           find first buf_gds-grp-obj no-lock
      395               where buf_gds-grp-obj.node-code = p-node-code
      396                 and buf_gds-grp-obj.host-code = v-host-code
      397                 and buf_gds-grp-obj.obj-type  = ""
      398                 and buf_gds-grp-obj.obj-code  = 0
      399           no-error .
      400         end.
      401         if v-range = 2 or not available buf_gds-grp-obj
      402         then do:
      403             if v-range <> 1 then do:
      404               find first buf_gds-grp-obj no-lock
      405                   where buf_gds-grp-obj.node-code = p-node-code
      406                   and buf_gds-grp-obj.host-code = 0
      407                   and buf_gds-grp-obj.obj-type  = ""
      408                   and buf_gds-grp-obj.obj-code  = 0
      409               no-error .
      410             end.
      411             if v-range = 1 or not available buf_gds-grp-obj
      412             then do:
      413                 assign
      414                     v-exists = no
      415                 .
      416             end.
      417             else do:
      418                 assign
      419                     v-exists = yes
      420                     v-range = 1
      421                 .
      422             end.
      423         end.
      424         else do:
      425             assign
      426                 v-exists = yes
      427                 v-range  = 2
      428             .
      429         end.
      430     end.
      431     else do:
      432         assign
      433             v-exists = yes
      434             v-range  = 3
      435         .
      436     end.
      437     if available buf_gds-grp-obj
      438     then do:
      439       assign
      440       v-cli-type-value    = buf_gds-grp-obj.cli-type
      441       v-cli-code-value    = buf_gds-grp-obj.cli-code
      442       .
      443       assign
      444       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
      445                           then yes
      446                           else p-exists-income-cli)
      447       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
      448                         then v-range
      449                         else p-range-income-cli
      450       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
      451                         then v-cli-type-value
      452                         else p-cli-type
      453       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
      454                         then v-cli-code-value
      455                         else p-cli-code
      456       v-found =  (p-exists-income-cli ) or (v-range <= 1)
      457       jj = jj + 1
      458       .
      459     end.
      460     else do:
      461       assign
      462       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
      463       jj = jj + 1
      464       .
      465     end.
      466   end.
      467   end.
      468   end procedure.
      469   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      470   define new global shared variable g#attr-lib  as handle no-undo .
      471   define variable v-attr-lib-variable as handle no-undo .
