       33   procedure vss-get-info :
       34     define output parameter p-vss-revision    like vss-revision    no-undo .
       35     define output parameter p-vss-author      like vss-author      no-undo .
       36     define output parameter p-vss-date        like vss-date        no-undo .
       37     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       38     define output parameter p-vss-archive     like vss-archive     no-undo .
       39     define output parameter p-vss-description like vss-description no-undo .
       40     assign
       41       p-vss-revision    = vss-revision
       42       p-vss-author      = vss-author
       43       p-vss-date        = vss-date
       44       p-vss-workfile    = vss-workfile
       45       p-vss-archive     = vss-archive
       46       p-vss-description = vss-description
       47     .
       48   end procedure.
       49   procedure vss-get-parameters :
       50     define output parameter p-vss-parameters as character no-undo .
       51       assign
       52         p-vss-parameters = substitute('&1|&2',p-mode,price-doc-num)
       53       .
       54   end procedure.
       55   define new global shared variable g#vssrevis-logger as handle    no-undo .
       56   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       57   define variable v-vssrevis-logger                   as handle    no-undo .
       58   procedure vss-logevent :
       59     define input  parameter p-extra-paramters as character no-undo .
       60     define variable v-vssrevis-parameters as character no-undo .
       61     do
       62     on error undo, return error return-value
       63     :
       64       if  valid-handle(v-vssrevis-logger)
       65       and v-vssrevis-logger :get-signature("logevent") <> ""
       66       then do:
       67         run vss-get-parameters in this-procedure
       68           (output v-vssrevis-parameters
       69           ).
       70         run logevent in v-vssrevis-logger
       71           (input vss-workfile
       72           ,input vss-revision
       73           ,input v-vssrevis-parameters
       74           ,input p-extra-paramters
       75           ).
       76       end.
       77     end.
       78   end procedure.
       79   assign
       80     v-vssrevis-logger = g#vssrevis-logger
       81   .
       82   if  valid-handle(v-vssrevis-logger)
       83   and v-vssrevis-logger :get-signature("logevent") <> ""
       84   then do:
       85     assign
       86       v-vssrevis-logevent = true
       87     .
       88     run vss-logevent in this-procedure (input vss-description) .
       89   end.
       90   define new global shared variable g#language as character no-undo .
       91   if g#language <> '' and g#language <> 'rus':U then do:
       92     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       93   end.
       94   define new global shared variable g#library  as handle no-undo .
       95   define new global shared variable g#library2 as handle no-undo .
       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97     define variable v-cntxt-db-num        as integer   no-undo .
