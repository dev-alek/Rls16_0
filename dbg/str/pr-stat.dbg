     2994                 s-qnty = 0
     2995                .
     2996              end.
     2997              l_price  =  (f-cost * f-qnty + s-cost * s-qnty ) / (f-qnty + s-qnty)  .
     2998           end.
     2999           when "cost-vat":u then do:
     3000                run str/gdsnovat.p ('Уч+накл-НДС':U,
