     2518   PROCEDURE read-retro-bonus :
     2519   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2520   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2521   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2522   define output parameter v-retro-bonus as character   no-undo .
     2523     do
     2524     on error undo, return error return-value
     2525     :
     2526   find first ub.contract-specif-attr no-lock  where
     2527              ub.contract-specif-attr.contract-num = p-contract-num  and
     2528              ub.contract-specif-attr.host-code    = p-host-code     and
     2529              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2530              ub.contract-specif-attr.attr-code    = "retro-bonus"
     2531              no-error .
     2532      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
     2533                                           else  v-retro-bonus = "" .
     2534   end.
