     2598   define variable p-value-rmethod  as integer   no-undo .
     2599   define variable p-type-rmethod   as logical   no-undo .
     2600   define variable l_price           as decimal   no-undo .
     2601   define variable l_pricewithvat    as decimal   no-undo .
     2602   define variable l_pricewithoutvat as decimal   no-undo .
