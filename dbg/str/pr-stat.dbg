     1436   procedure grp-obj-notcorr-value :
     1437   do
     1438   on error undo, return error
     1439   :
     1440   define input parameter p-node-code             as integer      no-undo.
     1441   define input parameter p-obj-type              as character    no-undo.
     1442   define input parameter p-obj-code              as integer      no-undo.
     1443   define output parameter p-notcorr              as character    no-undo init ?.
     1444   define output parameter p-range-notcorr     as integer      no-undo.
     1445   define output parameter p-exists-notcorr    as logical      no-undo.
     1446   define variable v-host-code as integer      no-undo.
     1447   DEFINE VARIABLE v-found as logical no-undo .
     1448   DEFINE VARIABLE v-exists as logical no-undo .
     1449   DEFINE VARIABLE v-range as integer no-undo .
     1450   DEFINE VARIABLE jj as integer no-undo .
     1451   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1452   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1453   define buffer buf_gds-grp for ub.gds-grp.
     1454   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1455   find first buf_gds-grp no-lock where
     1456              buf_gds-grp.node-code = p-node-code no-error .
     1457   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1458     message
     1459       vss-workfile vss-revision vss-description
     1460       skip "Не удалось найти группу товаров с кодом" p-node-code
     1461       view-as alert-box error .
     1462     undo, return error .
     1463   end.
     1464   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1465   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1466     (input  p-obj-type
     1467     ,input  p-obj-code
     1468     ,output v-host-code
     1469     ) no-error .
     1470   if error-status :error
     1471   then do:
     1472       message
     1473         vss-workfile vss-revision vss-description
     1474         skip "Не удалось найти фирму объекта"
     1475         skip p-obj-type p-obj-code
     1476         skip return-value
     1477         skip trim(error-status :get-message(1))
     1478       view-as alert-box error.
     1479       undo, return error .
     1480   end.
     1481   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1482   do while v-found = no and jj < 2:
     1483     if v-range <> 3 then do:
     1484       find first buf_gds-grp-obj no-lock
     1485           where buf_gds-grp-obj.node-code = p-node-code
     1486             and buf_gds-grp-obj.host-code = v-host-code
     1487             and buf_gds-grp-obj.obj-type  = p-obj-type
     1488             and buf_gds-grp-obj.obj-code  = p-obj-code
     1489       no-error .
     1490     end.
     1491     if v-range = 3 or not available buf_gds-grp-obj
     1492     then do:
     1493        if v-range <> 2 then do:
     1494           find first buf_gds-grp-obj no-lock
     1495               where buf_gds-grp-obj.node-code = p-node-code
     1496                 and buf_gds-grp-obj.host-code = v-host-code
     1497                 and buf_gds-grp-obj.obj-type  = ""
     1498                 and buf_gds-grp-obj.obj-code  = 0
     1499           no-error .
     1500         end.
     1501         if v-range = 2 or not available buf_gds-grp-obj
     1502         then do:
     1503             if v-range <> 1 then do:
     1504               find first buf_gds-grp-obj no-lock
     1505                   where buf_gds-grp-obj.node-code = p-node-code
     1506                   and buf_gds-grp-obj.host-code = 0
     1507                   and buf_gds-grp-obj.obj-type  = ""
     1508                   and buf_gds-grp-obj.obj-code  = 0
     1509               no-error .
     1510             end.
     1511             if v-range = 1 or not available buf_gds-grp-obj
     1512             then do:
     1513                 assign
     1514                     v-exists = no
     1515                 .
     1516             end.
     1517             else do:
     1518                 assign
     1519                     v-exists = yes
     1520                     v-range = 1
     1521                 .
     1522             end.
     1523         end.
     1524         else do:
     1525             assign
     1526                 v-exists = yes
     1527                 v-range  = 2
     1528             .
     1529         end.
     1530     end.
     1531     else do:
     1532         assign
     1533             v-exists = yes
     1534             v-range  = 3
     1535         .
     1536     end.
     1537     if available buf_gds-grp-obj
     1538     then do:
     1539       find first buf_gds-grp-obj-attr no-lock
     1540         where buf_gds-grp-obj-attr.node-code   = p-node-code
     1541           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     1542           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     1543           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     1544           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     1545         no-error .
     1546       if available buf_gds-grp-obj-attr then do:
     1547         assign
     1548           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     1549         .
     1550       end.
     1551       else do:
     1552         assign
     1553           v-notcorr-value = ?
     1554         .
     1555       end.
     1556       assign
     1557       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     1558                           then yes
     1559                           else p-exists-notcorr)
     1560       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     1561                         then v-range
     1562                         else p-range-notcorr
     1563       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     1564                         then v-notcorr-value
     1565                         else p-notcorr
     1566       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     1567       jj = jj + 1
     1568       .
     1569     end.
     1570     else do:
     1571       assign
     1572       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     1573       jj = jj + 1
     1574       .
     1575     end.
     1576   end.
     1577   end.
     1578   end procedure.
     1579   define variable vss-include-info15 as character format "X(65)" no-undo
     1580   initial "@(#)$Workfile$ $Revision$".
     1581   procedure grplib-get-full-name :
     1582      define input parameter p-node-code  as integer      no-undo.
     1583      define output parameter p-full-name as character    no-undo.
     1584      do
     1585   on error undo, return error
     1586   :
     1587       define variable v-upper-code    as integer           no-undo.
     1588       define buffer buf_gds-grp       for ub.gds-grp.
     1589       define buffer buf_upper_gds-grp for ub.gds-grp.
     1590       find first buf_gds-grp no-lock
     1591            where buf_gds-grp.node-code = p-node-code
     1592       no-error.
     1593       if not available buf_gds-grp
     1594       then do:
     1595           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1596       end.
     1597       assign
     1598           p-full-name  = ""
     1599           v-upper-code = 1
     1600       .
     1601       do while buf_gds-grp.upper-code <> 0
     1602       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1603       :
     1604           assign
     1605               p-full-name  = buf_gds-grp.node-name
     1606                            + (if p-full-name <> "" then chr(47) else "")
     1607                            + p-full-name
     1608               v-upper-code = buf_gds-grp.upper-code
     1609           .
     1610           find first buf_gds-grp no-lock
     1611                where buf_gds-grp.node-code = v-upper-code
     1612           no-error.
     1613           if not available buf_gds-grp
     1614           then do:
     1615               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1616                                   + string( v-upper-code )
     1617                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1618           end.
     1619       end.
     1620       assign
     1621       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1622       .
     1623   end.
     1624   end .
     1625   procedure grplib-get-node-from-full-name :
     1626   define input parameter p-full-name as character no-undo .
     1627   define output parameter p-node-code as integer no-undo .
     1628   define variable v-ii as integer no-undo .
     1629   define variable v-upper-code as integer no-undo .
     1630   define variable v-root-code as integer no-undo .
     1631   define variable v-entry as character no-undo .
     1632   define buffer buf_gds-grp       for ub.gds-grp.
     1633   do
     1634   on error undo, return error
     1635   :
     1636     find first buf_gds-grp no-lock
     1637         where buf_gds-grp.upper-code = 0
     1638     no-error .
     1639     if not available buf_gds-grp
     1640     then do:
     1641         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1642     end.
     1643     else do:
     1644       assign
     1645       v-root-code = buf_gds-grp.node-code
     1646       .
     1647     end.
     1648     v-upper-code = v-root-code.
     1649     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1650       assign
     1651       v-entry = entry(v-ii, p-full-name, chr(47)).
     1652       if v-entry = '' then leave.
     1653       find first buf_gds-grp no-lock where
     1654                 buf_gds-grp.node-name = v-entry
     1655             and buf_gds-grp.upper-code = v-upper-code
     1656             no-error.
     1657       if not available buf_gds-grp then do:
     1658         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1659       end.
     1660       else do:
     1661         p-node-code = buf_gds-grp.node-code.
     1662         v-upper-code = buf_gds-grp.node-code.
     1663       end.
     1664     end.
     1665   end.
     1666   end .
     1667   procedure  chec-par :
     1668   define output parameter l-par as logical no-undo .
     1669   define input parameter l-host like ub.clients.obj-code no-undo .
     1670   define input parameter l-type like ub.clients.obj-type no-undo .
     1671   define input parameter l-code like ub.clients.obj-code no-undo .
     1672   define variable par-type          as character no-undo.
     1673   define variable v-value-character as character no-undo .
     1674   define variable v-value-date      as date      no-undo .
     1675   define variable v-value-decimal   as decimal   no-undo .
     1676   define variable v-value-integer   as integer   no-undo .
     1677   define variable v-value-logical   as logical   no-undo .
     1678   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1679     (input  'alcohol'
     1680     ,input  l-host
     1681     ,input  l-type
     1682     ,input  l-code
     1683     ,input  ''
     1684     ,input  ''
     1685     ,input  ''
     1686     ,input  no
     1687     ,output par-alcohol
     1688     ,output par-type
     1689     ) no-error .
     1690    .
     1691   empty temp-table thbjattr_thbj-attr.
     1692   run adm/shattri.p (
     1693      input "get":U
     1694     ,input l-type
     1695     ,input l-code
     1696     ,input 'overval':U
     1697     ,input  ""
     1698     ,output v-value-character
     1699     ,output v-value-date
     1700     ,output v-value-decimal
     1701     ,output v-value-integer
     1702     ,output v-value-logical
     1703     ,output par-type
     1704     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1705     ) no-error .
     1706   for each thbjattr_thbj-attr :
     1707       if thbjattr_thbj-attr.prop-code = 'pr-clt-q':U then par-pr-clt-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1708       if thbjattr_thbj-attr.prop-code = 'pr-dpl-q':U then par-pr-dpl-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1709       if thbjattr_thbj-attr.prop-code = 'pr-rdc-q':U then par-pr-rdc-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1710       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     1711       if thbjattr_thbj-attr.prop-code = 'pr-abs-d':U then par-pr-abs-d = string ( thbjattr_thbj-attr.property-value-logical) .
     1712       if thbjattr_thbj-attr.prop-code = 'pr-altex':U then par-pr-altex = string ( thbjattr_thbj-attr.property-value-logical) .
     1713       if thbjattr_thbj-attr.prop-code = 'pr-parex':U then par-pr-parex = string ( thbjattr_thbj-attr.property-value-logical) .
     1714       if thbjattr_thbj-attr.prop-code = 'pr-sclex':U then par-pr-sclex = string ( thbjattr_thbj-attr.property-value-logical) .
     1715       if thbjattr_thbj-attr.prop-code = 'pr-discm':U then par-pr-discm =  thbjattr_thbj-attr.property-value-character .
     1716       if thbjattr_thbj-attr.prop-code = 'pr-dscnt':U then par-pr-dscnt  = string ( thbjattr_thbj-attr.property-value-logical) .
     1717       if thbjattr_thbj-attr.prop-code = 'pr-print':U then par-pr-print  = string ( thbjattr_thbj-attr.property-value-logical) .
     1718       if thbjattr_thbj-attr.prop-code = 'pr-sigma':U then par-pr-sigma  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1719       if thbjattr_thbj-attr.prop-code = 'pr-incpc':U then par-pr-incpc  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1720       if thbjattr_thbj-attr.prop-code = 'pr-rndmt':U then par-pr-rndmt  =  thbjattr_thbj-attr.property-value-character .
     1721       if thbjattr_thbj-attr.prop-code = 'pr-rndbs':U then par-pr-rndbs  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1722       if thbjattr_thbj-attr.prop-code = 'pr-notls':U then par-pr-notls = string ( thbjattr_thbj-attr.property-value-logical) .
     1723       if v-cntxt-db-num = 0 then do:
     1724         if thbjattr_thbj-attr.prop-code = 'pr-nogds0':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     1725         if thbjattr_thbj-attr.prop-code = 'pr-goods0':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     1726       end.
     1727       else do:
     1728         if thbjattr_thbj-attr.prop-code = 'pr-nogds':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     1729         if thbjattr_thbj-attr.prop-code = 'pr-goods':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     1730       end.
     1731   end.
     1732   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1733   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplmrgn in g#library2
     1734     (input  ?
     1735     ,input  l-type
     1736     ,input  l-code
     1737     ,output par-gen-mrgn-ie
     1738     ,output par-gen-mrgn-iv
     1739     ,output par-gen-mrgn-im
     1740     ) no-error .
     1741      IF error-status :error THEN message
     1742        vss-workfile vss-revision vss-description skip
     1743        error-status :get-message(1) skip
     1744        return-value skip
     1745        "gbl/gtplmrgn.i"
     1746        view-as alert-box error
     1747      .
     1748   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1749   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     1750     (input  ?
     1751     ,input  l-type
     1752     ,input  l-code
     1753     ,output par-pr-nakl-ie
     1754     ,output par-pr-nakl-iv
     1755     ,output par-pr-nakl-im
     1756     ) no-error .
     1757      define variable ii as integer   no-undo .
     1758      define variable nn as integer   no-undo .
     1759      define variable v-fullname as character no-undo .
     1760      nn = num-entries ( par-pr-nogds ).
     1761      par-pr-nogds-long = "".
     1762      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     1763         repeat ii = 1 to nn :
     1764           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     1765           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     1766         end.
     1767         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     1768      end.
     1769   l-par = true .
     1770   end procedure.
     1771   PROCEDURE cre-pr-list:
     1772   define input  parameter bc      like ub.price-list.b-code no-undo.
     1773   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     1774   define output parameter new-rec as recid             no-undo.
     1775   define buffer buf-price-list for ub.price-list.
     1776   define buffer buf-price-doc  for ub.price-doc.
     1777   define buffer buf-bar-code   for ub.bar-code.
     1778   define buffer buf-goods      for ub.goods.
     1779   define buffer buf-gds-prt    for ub.gds-prt.
     1780   define buffer root-gds-prt   for ub.gds-prt.
     1781   define variable cur-pr like ub.price-list.price-sale no-undo.
     1782   define variable cur-rt like ub.price-list.road-tax   no-undo.
     1783   define variable cur-ex like ub.price-list.excise     no-undo.
     1784   define variable cur-dn like ub.price-list.doc-num    no-undo.
     1785   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1786   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1787   define variable cur-rt-base as decimal no-undo .
     1788   define variable cur-rt-rubl as decimal no-undo .
     1789   define variable p-hostcode as int no-undo .
     1790   define variable v-line-num as integer no-undo .
     1791   define variable v-skip-del-gds as logical no-undo initial no .
     1792   cre-pr:
     1793   do on error undo cre-pr, return error:
     1794     find  buf-bar-code no-lock where
     1795           buf-bar-code.b-code = bc.
     1796     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     1797     if error-status :error then do:
     1798       message
     1799         return-value skip
     1800         "Ошибка !"
     1801         view-as alert-box error
     1802       .
     1803       undo cre-pr, return.
     1804     end.
     1805     find  buf-goods no-lock where
     1806           buf-goods.gds-code = buf-bar-code.gds-code.
     1807     find first root-gds-prt no-lock where
     1808               root-gds-prt.upper-code = buf-goods.prt-root.
     1809     if root-gds-prt.node-name <> '_Пустая шкала':U and
     1810       buf-bar-code.in-code <> "" then do:
     1811       message
     1812         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1813         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1814         view-as alert-box error.
     1815       undo cre-pr, return.
     1816     end.
     1817     find  buf-gds-prt no-lock where
     1818           buf-gds-prt.node-code = buf-bar-code.node-code.
     1819     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     1820       message
     1821         "Не допускается создавать цены на удаленные товары!" skip (2)
     1822         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1823         view-as alert-box error.
     1824       undo cre-pr, return.
     1825     end.
     1826     find  buf-price-doc where
     1827           buf-price-doc.doc-num = new-num.
     1828   define variable v-ret as logical no-undo .
     1829      run ver-modificator-price-is-null (
     1830             input    buf-goods.artic        ,
     1831             input    buf-goods.prod-type    ,
     1832             input    buf-goods.prod-code    ,
     1833             input    buf-price-doc.obj-type   ,
     1834             input    buf-price-doc.obj-code   ,
     1835             output   v-ret ).
     1836         if v-ret = false then dO:
     1837             message
     1838               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     1839               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1840               view-as alert-box error.
     1841             undo cre-pr, return.
     1842           end.
     1843   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1844   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1845     (input  buf-price-doc.obj-type
     1846     ,input  buf-price-doc.obj-code
     1847     ,output p-hostcode
     1848     ) no-error .
     1849   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1850   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1851     (input  buf-goods.gds-code
     1852     ,input  '1':U
     1853     ,input  ?
     1854     ,input  p-hostcode
     1855     ,input  buf-price-doc.obj-type
     1856     ,input  buf-price-doc.obj-code
     1857     ,output local_vat-pc
     1858     ) no-error .
     1859   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1860   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1861     (input  buf-goods.gds-code
     1862     ,input  '2':U
     1863     ,input  ?
     1864     ,input  p-hostcode
     1865     ,input  buf-price-doc.obj-type
     1866     ,input  buf-price-doc.obj-code
     1867     ,output local_slt-pc
     1868     ) no-error .
     1869   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1870   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1871     (input  buf-price-doc.obj-type
     1872     ,input  buf-price-doc.obj-code
     1873     ,input  bc
     1874     ,input  0
     1875     ,input  0
     1876     ,output cur-dn
     1877     ,output cur-pr
     1878     ,output cur-rt
     1879     ,output cur-ex
     1880     ) no-error .
     1881     find first buf-price-list where
     1882               buf-price-list.b-code  = buf-bar-code.b-code and
     1883               buf-price-list.doc-num = new-num  and
     1884               buf-price-list.price-type = ""    no-error .
     1885     if not available buf-price-list then do:
     1886       run calc-price-line-num (input  new-num , output v-line-num) .
     1887       create buf-price-list.
     1888       assign
     1889         buf-price-list.line-num  = v-line-num
     1890         buf-price-list.b-code    = buf-bar-code.b-code
     1891         buf-price-list.doc-num   = buf-price-doc.doc-num
     1892         buf-price-list.prod-type = buf-goods.prod-type
     1893         buf-price-list.prod-code = buf-goods.prod-code
     1894         buf-price-list.artic     = buf-goods.artic
     1895         buf-price-list.obj-type  = buf-price-doc.obj-type
     1896         buf-price-list.obj-code  = buf-price-doc.obj-code
     1897         buf-price-list.vat-pc    = local_vat-pc
     1898         buf-price-list.slt-pc    = local_slt-pc
     1899         buf-price-list.price-prev = cur-pr
     1900         .
     1901       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     1902           buf-bar-code.in-code   = "" and
     1903           buf-bar-code.part-code = "" and
     1904           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     1905         buf-price-list.main-price = yes.
     1906         if cur-pr <> ? then do:
     1907           run exp-prt (input buf-goods.gds-code,
     1908                       input cur-dn,
     1909                       input new-num,
     1910                       output new-rec) no-error.
     1911           if error-status :error then do:
     1912             message
     1913               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     1914               view-as alert-box error.
     1915             undo cre-pr, return error.
     1916           end.
     1917         end.
     1918       end.
     1919       else do:
     1920         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     1921           buf-price-list.d-pcnt = ?.
     1922         end.
     1923         buf-price-list.main-price = no.
     1924       end.
     1925     end.
     1926   end.
     1927   new-rec = recid (buf-price-list).
     1928   END PROCEDURE.
     1929   procedure calc-price-line-num :
     1930    do
     1931    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1932    :
     1933   define input parameter p-doc-num as character no-undo .
     1934   define output parameter p-num  as integer no-undo .
     1935   define variable v-fact as integer no-undo .
     1936   define buffer buf_1_price-list for ub.price-list .
     1937   p-num = 1 .
     1938   find last  buf_1_price-list no-lock where
     1939              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     1940              if available buf_1_price-list then
     1941                   assign
     1942                     v-fact = buf_1_price-list.line-num
     1943                   .
     1944   v-fact = v-fact + 1.
     1945   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     1946    end.
     1947   end procedure.
     1948   PROCEDURE del-pr-list:
     1949   define input parameter bc    like ub.bar-code.b-code   no-undo.
     1950   define input parameter d-num like ub.price-doc.doc-num no-undo.
     1951   define input parameter round-method as character         no-undo.
     1952   define input parameter round-base   as decimal      no-undo.
     1953   define buffer buf-price-list for ub.price-list.
     1954   define buffer buf-bar-code   for ub.bar-code.
     1955   define buffer buf-goods      for ub.goods.
     1956   define variable l-ov-on as logical no-undo .
     1957   del-pr:
     1958   do on error undo del-pr, return error:
     1959     find first  buf-price-list no-lock where
     1960                 buf-price-list.doc-num    = d-num and
     1961                 buf-price-list.b-code     = bc and
     1962                 buf-price-list.price-type = "" no-error.
     1963     if not available buf-price-list then
     1964       undo del-pr, return error.
     1965     find  buf-goods no-lock where
     1966           buf-goods.prod-type = buf-price-list.prod-type and
     1967           buf-goods.prod-code = buf-price-list.prod-code and
     1968           buf-goods.artic     = buf-price-list.artic.
     1969     if buf-price-list.main-price then do:
     1970       for each  buf-price-list exclusive-lock where
     1971                 buf-price-list.doc-num   = d-num and
     1972                 buf-price-list.artic     = buf-goods.artic and
     1973                 buf-price-list.prod-type = buf-goods.prod-type and
     1974                 buf-price-list.prod-code = buf-goods.prod-code,
     1975           first buf-bar-code no-lock where
     1976                 buf-bar-code.b-code = buf-price-list.b-code
     1977       on error undo del-pr, return error:
     1978   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1979   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1980     (input  ub.buf-price-list.obj-type
     1981     ,input  ub.buf-price-list.obj-code
     1982     ,input  ub.buf-price-list.artic
     1983     ,input  ub.buf-price-list.prod-type
     1984     ,input  ub.buf-price-list.prod-code
     1985     ,input  'ov-on=request:exclusive'
     1986     ,output l-ov-on
     1987     ) no-error .
     1988         if error-status:error then do:
     1989           message
     1990             vss-workfile vss-revision vss-description skip
     1991             "Ошибка получения признака товара на объекте" skip
     1992             error-status :get-message(1) skip
     1993             return-value skip
     1994             view-as alert-box error .
     1995         end.
     1996         if l-ov-on then do:
     1997   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1998   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1999     (input  ub.buf-price-list.obj-type
     2000     ,input  ub.buf-price-list.obj-code
     2001     ,input  ub.buf-price-list.artic
     2002     ,input  ub.buf-price-list.prod-type
     2003     ,input  ub.buf-price-list.prod-code
     2004     ,input  'ov-on=false'
     2005     ,output l-ov-on
     2006     ) no-error .
     2007           if error-status :error then do:
     2008           end.
     2009          end.
     2010         delete buf-price-list.
     2011       end.
     2012     end.
     2013     else do:
     2014       find  buf-bar-code no-lock where
     2015             buf-bar-code.b-code = buf-price-list.b-code.
     2016       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2017         message
     2018           "Нельзя удалить неосновную цену." skip
     2019           "Неосновная цена (скидка) не может быть неопределенной." skip
     2020           "Код:" bc skip
     2021           "Переоценка:" d-num
     2022           view-as alert-box error.
     2023         undo del-pr, return error.
     2024       end.
     2025       find current buf-price-list exclusive-lock no-error .
     2026       delete buf-price-list.
     2027       run calc-base-upd (input buf-bar-code.b-code,
     2028                         input d-num,
     2029                         input round-method,
     2030                         input round-base) no-error.
     2031       if error-status :error then
     2032         undo del-pr, return error.
     2033     end.
     2034   end.
     2035   END PROCEDURE.
     2036   PROCEDURE calc-base-upd:
     2037   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2038   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2039   define input parameter round-method as character         no-undo.
     2040   define input parameter round-base   as decimal      no-undo.
     2041   define buffer alt-bar-code   for ub.bar-code.
     2042   define buffer alt-price-list for ub.price-list.
     2043   define buffer buf-bar-code   for ub.bar-code.
     2044   define buffer buf-goods      for ub.goods.
     2045   calc-base:
     2046   do on error undo calc-base, return error:
     2047     find  buf-bar-code no-lock where
     2048           buf-bar-code.b-code = bc.
     2049     find  buf-goods no-lock where
     2050           buf-goods.gds-code = buf-bar-code.gds-code.
     2051     for each  alt-bar-code no-lock where
     2052               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     2053               alt-bar-code.node-code = buf-bar-code.node-code and
     2054               alt-bar-code.part-code = buf-bar-code.part-code and
     2055               alt-bar-code.in-code   = buf-bar-code.in-code and
     2056               alt-bar-code.unit-cli <> buf-goods.unit-base,
     2057         each  alt-price-list where
     2058               alt-price-list.doc-num    = d-num and
     2059               alt-price-list.b-code     = alt-bar-code.b-code and
     2060               alt-price-list.price-type = ""
     2061         on error undo calc-base, return error:
     2062       run calc-pr-alt (input d-num,
     2063                       input alt-bar-code.b-code,
     2064                       input round-method,
     2065                       input round-base) no-error.
     2066       if error-status:error then
     2067         undo calc-base, return error.
     2068     end.
     2069   end.
     2070   END PROCEDURE.
     2071   PROCEDURE calc-pr-alt:
     2072   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2073   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2074   define input parameter r-method as character             no-undo.
     2075   define input parameter r-base   as decimal              no-undo.
     2076   define buffer buf-price-doc  for ub.price-doc.
     2077   define buffer buf-price-list for ub.price-list.
     2078   define buffer buf-bar-code   for ub.bar-code.
     2079   define buffer buf-goods      for ub.goods.
     2080   define buffer old-price-list for ub.price-list.
     2081   define variable pr-rec   as   recid                  no-undo.
     2082   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2083   pr-alt:
     2084   do on error undo pr-alt, return error:
     2085     if r-method = ? or
     2086        r-base = ? then do:
     2087       message
     2088         "Нельзя удалить основную цену." skip
     2089         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     2090         "Код:" bc skip
     2091         "Переоценка:" d-num
     2092         view-as alert-box error.
     2093       undo pr-alt, return error.
     2094     end.
     2095     find  buf-price-doc where
     2096           buf-price-doc.doc-num = d-num.
     2097     find  buf-bar-code no-lock where
     2098           buf-bar-code.b-code = bc.
     2099     find  buf-goods no-lock where
     2100           buf-goods.gds-code = buf-bar-code.gds-code.
     2101     find  buf-price-list where
     2102           buf-price-list.doc-num = buf-price-doc.doc-num and
     2103           buf-price-list.b-code  = bc.
     2104     if buf-price-list.d-pcnt = ? then do:
     2105   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2106   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2107     (input  buf-price-doc.obj-type
     2108     ,input  buf-price-doc.obj-code
     2109     ,input  bc
     2110     ,input  0
     2111     ,input  0
     2112     ,output pr-rec
     2113     ,output pr-c-b-r
     2114     )  .
     2115       find old-price-list no-lock where
     2116           recid (old-price-list) = pr-rec no-error.
     2117       if available old-price-list and
     2118         old-price-list.b-code = bc then
     2119         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     2120       else
     2121         buf-price-list.d-pcnt = 0.
     2122     end.
     2123      if buf-price-list.d-pcnt = ? then do:
     2124         assign
     2125           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     2126           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     2127           .
     2128     end.
     2129     else do:
     2130         assign
     2131           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     2132                                         buf-bar-code.cli-base-rate *
     2133                                         (1 - buf-price-list.d-pcnt / 100)
     2134           buf-price-list.calc-method =  'Основная':U
     2135           .
     2136   case r-method :
     2137     when '9-окончание':U then do:
     2138       if buf-price-list.price-sale < 29 then do:
     2139         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     2140           assign
     2141             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     2142           .
     2143         end.
     2144       end.
     2145       else do:
     2146         if (buf-price-list.price-sale modulo 10) < 3 then do:
     2147           assign
     2148             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2149                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2150                   - 1 ) * 10
     2151                 + 9
     2152           .
     2153         end.
     2154         else do:
     2155           assign
     2156             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2157                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2158                   ) * 10
     2159                 + 9
     2160           .
     2161         end.
     2162         assign
     2163           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2164         .
     2165       end.
     2166     end.
     2167     when '9-99окончание':U then do:
     2168       if buf-price-list.price-sale < r-base then do:
     2169         assign
     2170           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     2171         .
     2172       end.
     2173       else do:
     2174         assign
     2175           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     2176         .
     2177       end.
     2178     end.
     2179     when 'Без-дробных':U then do:
     2180       assign
     2181         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2182       .
     2183     end.
     2184     when 'Произвольно':U then do:
     2185       if r-base <> 0 then do:
     2186         assign
     2187           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     2188         .
     2189         if buf-price-list.price-sale = 0 then do:
     2190           assign
     2191             buf-price-list.price-sale = r-base
     2192           .
     2193         end.
     2194       end.
     2195     end.
     2196     when 'Вверх':U then do:
     2197       if r-base <> 0 then do:
     2198         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     2199           assign
     2200             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     2201           .
     2202         end.
     2203       end.
     2204       if buf-price-list.price-sale = 0 then do:
     2205         assign
     2206           buf-price-list.price-sale = r-base
     2207         .
     2208       end.
     2209     end.
     2210     when 'Коэффициент':U then do:
     2211       if r-base <> 0 then do:
     2212         assign
     2213           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     2214         .
     2215       end.
     2216     end.
     2217     when 'Отключено':U then do:
     2218     end.
     2219     otherwise do:
     2220       message
     2221         vss-workfile vss-revision vss-description skip
     2222         "Неизвестный метод округления продажной цены" skip
     2223         "round-method" r-method skip
     2224         "round-base"   r-base   skip
     2225         "price"        buf-price-list.price-sale             skip
     2226         view-as alert-box error .
     2227     end.
     2228   end.
     2229     end.
     2230   end.
     2231   END PROCEDURE.
     2232   PROCEDURE calc-pr-discnt:
     2233   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2234   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2235   define buffer buf-price-doc  for ub.price-doc.
     2236   define buffer buf-price-list for ub.price-list.
     2237   define buffer buf-bar-code   for ub.bar-code.
     2238   define buffer buf-goods      for ub.goods.
     2239   define buffer old-price-list for ub.price-list.
     2240   define variable pr-rec   as   recid                  no-undo.
     2241   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2242   pr-discnt:
     2243   do on error undo pr-discnt, return error:
     2244     find  buf-price-doc where
     2245           buf-price-doc.doc-num = d-num.
     2246     find  buf-bar-code no-lock where
     2247           buf-bar-code.b-code = bc.
     2248     find  buf-goods no-lock where
     2249           buf-goods.gds-code = buf-bar-code.gds-code.
     2250     find  buf-price-list where
     2251           buf-price-list.doc-num = buf-price-doc.doc-num and
     2252           buf-price-list.b-code  = bc.
     2253     buf-price-list.d-pcnt = (1 -
     2254                              buf-price-list.price-sale /
     2255                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     2256                              buf-bar-code.cli-base-rate) *
     2257                              100
     2258                              .
     2259   end.
     2260   END PROCEDURE.
     2261   PROCEDURE calc-pr-sub :
     2262   define  input  parameter bc             like ub.price-list.b-code no-undo.
     2263   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     2264   define  input  parameter calc-method  as character    no-undo.
     2265   define  input  parameter increase-pc  as decimal      no-undo.
     2266   define  input  parameter round-method as character    no-undo.
     2267   define  input  parameter round-base   as decimal      no-undo.
     2268   define  output parameter calc-rec     as recid        no-undo.
     2269   define  buffer buf-price-list for ub.price-list.
     2270   define  buffer buf-bar-code   for ub.bar-code.
     2271   define  buffer buf-goods      for ub.goods.
     2272   define  buffer buf-gds-prt    for ub.gds-prt.
     2273   define  buffer buf-gds-grp    for ub.gds-grp.
     2274   define  buffer buf-price-doc  for ub.price-doc.
     2275   calc-sub:
     2276   do on error undo calc-sub, return error:
     2277     find  buf-bar-code no-lock where
     2278           buf-bar-code.b-code = bc.
     2279     find  buf-goods no-lock where
     2280           buf-goods.gds-code = buf-bar-code.gds-code.
     2281     find  buf-gds-prt no-lock where
     2282           buf-gds-prt.node-code = buf-bar-code.node-code.
     2283     find  buf-price-list where
     2284           buf-price-list.doc-num    = d-num and
     2285           buf-price-list.b-code     = bc and
     2286           buf-price-list.price-type = "".
     2287     find  buf-price-doc where
     2288           buf-price-doc.doc-num = d-num.
     2289     calc-rec = recid (buf-price-list).
     2290     if buf-price-list.main-price then do:
     2291       for each  buf-price-list where
     2292                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2293                 buf-price-list.main-price = no and
     2294                 buf-price-list.artic      = buf-goods.artic and
     2295                 buf-price-list.prod-type  = buf-goods.prod-type and
     2296                 buf-price-list.prod-code  = buf-goods.prod-code,
     2297           first buf-bar-code no-lock where
     2298                 buf-bar-code.b-code   = buf-price-list.b-code and
     2299                 buf-bar-code.unit-cli = buf-goods.unit-base
     2300           on error undo calc-sub, return error:
     2301         run calc-pr-list (input  buf-bar-code.b-code,
     2302                           input  buf-price-list.doc-num,
     2303                           input  calc-method,
     2304                           input  increase-pc,
     2305                           input  round-method,
     2306                           input  round-base,
     2307                           input ? ,
     2308                           input ? ,
     2309                           input ? ,
     2310                           input ? ,
     2311                           output calc-rec) no-error.
     2312         if error-status :error then
     2313           undo calc-sub, return error.
     2314         calc-rec = recid (buf-price-list).
     2315       end.
     2316       for each  buf-price-list where
     2317                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2318                 buf-price-list.main-price = no and
     2319                 buf-price-list.artic      = buf-goods.artic and
     2320                 buf-price-list.prod-type  = buf-goods.prod-type and
     2321                 buf-price-list.prod-code  = buf-goods.prod-code,
     2322           first buf-bar-code no-lock where
     2323                 buf-bar-code.b-code    = buf-price-list.b-code and
     2324                 buf-bar-code.unit-cli <> buf-goods.unit-base
     2325           on error undo calc-sub, return error:
     2326         run calc-pr-alt (input buf-price-doc.doc-num,
     2327                         input buf-bar-code.b-code,
     2328                         input round-method,
     2329                         input round-base) no-error.
     2330         if error-status :error then
     2331           undo calc-sub, return error.
     2332       end.
     2333     end.
     2334     else do:
     2335       run calc-base-upd (input buf-bar-code.b-code,
     2336                         input buf-price-doc.doc-num,
     2337                         input round-method,
     2338                         input round-base) no-error.
     2339       if error-status :error then
     2340         undo calc-sub, return error.
     2341     end.
     2342   end.
     2343   END PROCEDURE.
     2344   procedure ver-pr-nogds :
     2345   define input  parameter p-gds-code      as integer   no-undo .
     2346   define input  parameter p-par-pr-nogds  as character no-undo .
     2347   define output parameter p-not           as logical   no-undo .
     2348   define output parameter p-str           as character no-undo .
     2349   define buffer buf_goods for ub.goods  .
     2350   define variable nn as integer   no-undo .
     2351   define variable ii as integer   no-undo .
     2352   define variable v-namegrp as character no-undo .
     2353     do
     2354     on error undo, return error return-value
     2355     :
     2356     if p-par-pr-nogds = "1" then do:
     2357        assign
     2358         p-not = true
     2359         p-str = ""
     2360        .
     2361        return .
     2362     end.
     2363     assign
     2364       p-not = false
     2365       p-str = ""
     2366     .
     2367     find first buf_goods no-lock where
     2368                buf_goods.gds-code = p-gds-code no-error .
     2369     nn = num-entries(par-pr-nogds-long,chr(4)) .
     2370     repeat ii = 1 to nn:
     2371        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     2372        if buf_goods.grp-name  begins v-namegrp  then do:
     2373           assign
     2374             p-not = true
     2375             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     2376           .
     2377           leave .
     2378        end.
     2379     end.
     2380     end.
     2381   end procedure.
     2382   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2383   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2384   PROCEDURE write-bonus :
     2385   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2386   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2387   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2388   define input  parameter v-bonus as decimal   no-undo .
     2389     do
     2390     on error undo, return error return-value
     2391     :
     2392       find first ub.contract-specif-attr exclusive-lock  where
     2393                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2394                  ub.contract-specif-attr.host-code    = p-host-code     and
     2395                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2396                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2397                 no-error .
     2398         if not available ub.contract-specif-attr then do:
     2399            create ub.contract-specif-attr .
     2400            assign
     2401                 ub.contract-specif-attr.contract-num = p-contract-num
     2402                 ub.contract-specif-attr.host-code    = p-host-code
     2403                 ub.contract-specif-attr.gds-code     = p-gds-code
     2404                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2405            .
     2406         end.
     2407         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2408   end.
     2409   END PROCEDURE.
     2410   PROCEDURE read-bonus :
     2411   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2412   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2413   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2414   define output parameter v-bonus as decimal   no-undo .
     2415     do
     2416     on error undo, return error return-value
     2417     :
     2418   find first ub.contract-specif-attr no-lock  where
     2419              ub.contract-specif-attr.contract-num = p-contract-num  and
     2420              ub.contract-specif-attr.host-code    = p-host-code     and
     2421              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2422              ub.contract-specif-attr.attr-code    = 'bonus':U
     2423              no-error .
     2424      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     2425                                           else  v-bonus = 0 .
     2426   end.
     2427   END PROCEDURE.
     2428   PROCEDURE write-prc-min :
     2429   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2430   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2431   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2432   define input  parameter v-prc-min        as decimal   no-undo .
     2433     do
     2434     on error undo, return error return-value
     2435     :
     2436       find first ub.contract-specif-attr exclusive-lock  where
     2437                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2438                 ub.contract-specif-attr.host-code    = p-host-code     and
     2439                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2440                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2441                 no-error .
     2442         if not available ub.contract-specif-attr then do:
     2443            create ub.contract-specif-attr .
     2444            assign
     2445                 ub.contract-specif-attr.contract-num = p-contract-num
     2446                 ub.contract-specif-attr.host-code    = p-host-code
     2447                 ub.contract-specif-attr.gds-code     = p-gds-code
     2448                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2449                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     2450            .
     2451         end.
     2452         else do:
     2453            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     2454         end.
     2455       find first ub.contract-specif exclusive-lock where
     2456           ub.contract-specif.contract-num = p-contract-num and
     2457           ub.contract-specif.host-code    = p-host-code    and
     2458           ub.contract-specif.gds-code     = p-gds-code.
     2459           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2460   end.
     2461   END PROCEDURE.
     2462   PROCEDURE read-prc-min :
     2463   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2464   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2465   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2466   define output parameter v-prc-min as decimal   no-undo .
     2467     do
     2468     on error undo, return error return-value
     2469     :
     2470   find first ub.contract-specif-attr no-lock  where
     2471              ub.contract-specif-attr.contract-num = p-contract-num  and
     2472              ub.contract-specif-attr.host-code    = p-host-code     and
     2473              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2474              ub.contract-specif-attr.attr-code    = 'prc-min':U
     2475              no-error .
     2476      if available ub.contract-specif-attr then  v-prc-min = decimal (ub.contract-specif-attr.attr-value ) .
     2477                                           else  v-prc-min = 0 .
     2478   end.
     2479   END PROCEDURE.
     2480   PROCEDURE write-retro-bonus :
     2481   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2482   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2483   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2484   define input  parameter v-retro-bonus as character   no-undo .
     2485     do
     2486     on error undo, return error return-value
     2487     :
     2488       find first ub.contract-specif-attr exclusive-lock  where
     2489                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2490                 ub.contract-specif-attr.host-code    = p-host-code     and
     2491                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2492                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2493                 no-error .
     2494         if not available ub.contract-specif-attr then do:
     2495            create ub.contract-specif-attr .
     2496            assign
     2497                 ub.contract-specif-attr.contract-num = p-contract-num
     2498                 ub.contract-specif-attr.host-code    = p-host-code
     2499                 ub.contract-specif-attr.gds-code     = p-gds-code
     2500                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2501            .
     2502            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2503            if error-status:error then
     2504               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2505         end.
     2506         else do:
     2507            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2508            if error-status:error then
     2509               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2510         end.
     2511       find first ub.contract-specif exclusive-lock where
     2512           ub.contract-specif.contract-num = p-contract-num and
     2513           ub.contract-specif.host-code    = p-host-code    and
     2514           ub.contract-specif.gds-code     = p-gds-code.
     2515           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2516   end.
