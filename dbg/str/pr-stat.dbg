     2683         output  p-type-rmethod
     2684         ) no-error .
     2685         if error-status :error then message
     2686           vss-workfile vss-revision vss-description skip
     2687           error-status :get-message(1) skip
     2688           return-value skip
     2689           "123"
     2690           view-as alert-box error
     2691         .
     2692       if p-type-margin = false  then next.
     2693    if  trn-doc-code = ? or trn-doc-code = "" then do:
     2694           if b_price-list.main-price = true then do :
     2695             case  pr-discm :
     2696                 when "prod":u then do:
     2697   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2698   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     2699   (  input  b_price-list.b-code
     2700    , input  p-obj-type
     2701    , input  p-obj-code
     2702    , output l_pricewithoutvat
     2703    , output l_price
     2704    , output l_prod-vat
     2705    , output v-str
     2706    , output v-str
     2707           )  .
     2708                     t-prc  =  (b_price-list.price-sale  / l_price - 1) * 100  .
     2709                 end.
     2710                 when "prod-vat":u then do:
     2711   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2712   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     2713   (  input  b_price-list.b-code
     2714    , input  p-obj-type
     2715    , input  p-obj-code
     2716    , output l_price
     2717    , output l_pricewithvat
     2718    , output l_prod-vat
     2719    , output v-str
     2720    , output v-str
     2721           )  .
     2722                     t-prc  =  (b_price-list.price-sale  / l_price - 1) * 100  .
     2723                 end.
     2724                 when "cost-vat":u then do:
     2725                     run str/gdsnovat.p ('Учет-безНДС':U,
     2726                             b_price-list.obj-type,
     2727                             b_price-list.obj-code,
     2728                             p-host-code,
     2729                             b_price-list.artic,
     2730                             b_price-list.prod-type,
     2731                             b_price-list.prod-code,
     2732                             0 ,
     2733                             ? ,
     2734                             ? ,
     2735                             ? ,
     2736                             output cost-base   ,
     2737                             output cost-rubl   ,
     2738                             output v-price-base  ,
     2739                             output v-price-rubl  ,
     2740                             output cur-rt-base ,
     2741                             output cur-rt-rubl ).
     2742                             l_price =  if var-pr-r-b = "rubl" then v-price-rubl else v-price-base .
     2743                             t-prc = (b_price-list.price-sale / l_price - 1) * 100.
     2744                 end.
     2745               when "cost":u       then do:
     2746                 t-prc =  fnc-cost-pc (buffer b_price-list) .
     2747               end.
     2748               when "sale":u then do:
     2749                 t-prc =  fnc-pr-pc   (buffer b_price-list) .
     2750               end.
     2751             end case.
     2752           end.
     2753           else do:
     2754             case  pr-discm :
     2755                 when "prod":u then do:
     2756   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2757   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     2758   (  input  b_price-list.b-code
     2759    , input  p-obj-type
     2760    , input  p-obj-code
     2761    , output l_pricewithoutvat
     2762    , output l_price
     2763    , output l_prod-vat
     2764    , output v-str
     2765    , output v-str
     2766           )  .
     2767                 end.
     2768                 when "prod-vat":u then do:
     2769   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2770   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     2771   (  input  b_price-list.b-code
     2772    , input  p-obj-type
     2773    , input  p-obj-code
     2774    , output l_price
     2775    , output l_pricewithvat
     2776    , output l_prod-vat
     2777    , output v-str
     2778    , output v-str
     2779           )  .
     2780               end.
     2781               when "cost":u
     2782               or when "cost-vat":u
     2783               then do:
     2784                 l_price =  fnc-cost (buffer b_price-list) .
     2785               end.
     2786               when "sale":u then do:
     2787                 l_price =  fnc-pr   (buffer b_price-list) .
     2788               end.
     2789             end case.
     2790             t-prc = (b_price-list.price-sale / (l_price * v-koff) - 1) * 100.
     2791           end.
     2792   end.
     2793   else do:
     2794       find first b_trn-doc where b_trn-doc.doc-code = trn-doc-code no-lock no-error .
     2795       if available b_trn-doc then do:
     2796        find first b_doc-line where
     2797           b_doc-line.doc-code  = b_trn-doc.doc-code and
     2798           b_doc-line.artic     = bl_goods.artic     and
     2799           b_doc-line.prod-code = bl_goods.prod-code and
     2800           b_doc-line.prod-type = bl_goods.prod-type no-lock no-error .
     2801        end.
     2802        else do:
     2803          return error return-value + "Не найден документ с номером " + trn-doc-code.
     2804        end.
     2805   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2806   ASSIGN
     2807      i-gl-Host-Code      = 0
     2808      i-gl-Contract-Code  = 0
     2809      i-gl-Extent3        = 0
     2810      .
     2811   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2812       INPUT  b_trn-doc.host-code,
     2813       INPUT  b_trn-doc.contract-code,
     2814       OUTPUT i-gl-Extent3
     2815      ).
     2816   IF i-gl-Extent3[1] = 2 THEN DO:
     2817      ASSIGN
     2818         i-gl-Host-Code      = i-gl-Extent3[2]
     2819         i-gl-Contract-Code  = i-gl-Extent3[3]
     2820         .
     2821   END. ELSE DO:
     2822      ASSIGN
     2823         i-gl-Host-Code      = b_trn-doc.host-code
     2824         i-gl-Contract-Code  = b_trn-doc.contract-code
     2825         .
     2826   END.
     2827       FIND FIRST buf_contract-specif
     2828              NO-LOCK
     2829              WHERE
     2830                  buf_contract-specif.Host-code    = i-gl-Host-Code
     2831              AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     2832              AND buf_contract-specif.Gds-code     = bl_goods.gds-code
     2833              NO-ERROR
     2834              .
     2835       if available buf_contract-specif then do:
     2836           run read-bonus (
     2837               input  buf_contract-specif.contract-num  ,
     2838               input  buf_contract-specif.host-code     ,
     2839               input  buf_contract-specif.gds-code      ,
     2840               output v-bonus  ) .
     2841       end.
     2842       else do:
     2843           v-bonus  = 0 .
     2844       end.
     2845         if b_trn-doc.ext-doc-type = 'ie':U then   pr-gen-margin = par-gen-mrgn-ie.
     2846         if b_trn-doc.ext-doc-type = 'iv':U then   pr-gen-margin = par-gen-mrgn-iv.
     2847         if b_trn-doc.ext-doc-type = 'im':U  then   pr-gen-margin = par-gen-mrgn-im.
     2848         pr-gen-margin = lc(pr-gen-margin).
     2849         if available b_doc-line then do:
     2850         case  pr-discm :
     2851           when "cost":u then do:
     2852                   f-qnty = 0.
     2853                   find ub.gds-obj no-lock where
     2854                       ub.gds-obj.gds-code = bl_goods.gds-code and
     2855                       ub.gds-obj.obj-type = b_trn-doc.obj-type and
     2856                       ub.gds-obj.obj-code = b_trn-doc.obj-code no-error.
     2857                   if  available ub.gds-obj then
     2858                     if bl_goods.gds-type = 'т':U then do:
     2859                             if var-pr-r-b = "rubl" then
     2860                                 assign
     2861                                   f-cost = if  ub.gds-obj.avrg-rubl = ? then 0 else ub.gds-obj.avrg-rubl
     2862                                   f-qnty = ub.gds-obj.avrg-qnty
     2863                                   .
     2864                             else
     2865                                 assign
     2866                                   f-cost = if  ub.gds-obj.avrg-base = ? then 0 else ub.gds-obj.avrg-base
     2867                                   f-qnty = ub.gds-obj.avrg-qnty
     2868                                   .
     2869                         end.
     2870                       else  f-cost = ?.
     2871                   else f-cost = ?.
     2872              if pr-gen-margin = 'before-margin':U then do:
