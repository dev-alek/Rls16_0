     1819   procedure diasize_set-height :
     1820     define input  parameter p-new-height  as decimal   no-undo .
     1821     define input  parameter p-move-resize as logical   no-undo .
     1822     do
     1823     on error undo, return error return-value
     1824     :
     1825       run diasize_change-height in this-procedure
     1826         (input  (p-new-height - frame Dialog-Frame :height)
     1827         ,input  p-move-resize
     1828         ) .
     1829     end.
