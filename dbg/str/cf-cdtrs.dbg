     2206   procedure diasize_set-width :
     2207     define input  parameter p-new-width  as decimal   no-undo .
     2208     define input  parameter p-move-resize as logical   no-undo .
     2209     do
     2210     on error undo, return error return-value
     2211     :
     2212       run diasize_change-width in this-procedure
     2213         (input  (p-new-width - frame Dialog-Frame :width)
     2214         ,input  p-move-resize
     2215         ) .
     2216     end.
     2217   end procedure.
     2218   procedure diasize_position-resize-button :
     2219     do with frame Dialog-Frame
     2220     :
     2221       hide v-diasize-resize-button .
     2222       assign
     2223         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2224                     - 1
     2225                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2226         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2227                     - 1
     2228                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2229       .
     2230       view v-diasize-resize-button .
     2231     end.
     2232   end procedure.
     2233   on alt-right anywhere
     2234   do:
     2235     run diasize_change-width in this-procedure
     2236       (input 1
     2237       ,input true
     2238       ) .
     2239     return no-apply .
     2240   end.
     2241   on alt-left anywhere
     2242   do:
     2243     run diasize_change-width in this-procedure
     2244       (input -1
     2245       ,input true
     2246       ) .
     2247     return no-apply .
     2248   end.
     2249   on alt-down anywhere
     2250   do:
     2251     run diasize_change-height in this-procedure
     2252       (input 1
     2253       ,input true
     2254       ) .
     2255     return no-apply .
     2256   end.
     2257   on alt-up anywhere
     2258   do:
     2259     run diasize_change-height in this-procedure
     2260       (input -1
     2261       ,input true
     2262       ) .
     2263     return no-apply .
     2264   end.
     2265   on alt-enter of frame Dialog-Frame
     2266   do:
     2267     run diasize_maximize in this-procedure
     2268       (input  ?
     2269       ).
     2270     return no-apply .
     2271   end.
     2272   procedure diasize_end-move :
     2273     do
     2274     on error undo, return error return-value
     2275     :
     2276       define variable v-row-delta as decimal   no-undo .
     2277       define variable v-col-delta as decimal   no-undo .
     2278       define variable v-new-row as decimal   no-undo .
     2279       define variable v-new-col as decimal   no-undo .
     2280       assign
     2281         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2282         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2283       .
     2284       assign
     2285         v-row-delta = v-new-row - frame Dialog-Frame :height
     2286         v-col-delta = v-new-col - frame Dialog-Frame :width
     2287       .
     2288       run diasize_change-height in this-procedure
     2289         (input v-row-delta
     2290         ,input true
     2291         ) .
     2292       run diasize_change-width in this-procedure
     2293         (input v-col-delta
     2294         ,input true
     2295         ) .
     2296     end.
     2297   end procedure.
     2298   procedure diasize_maximize :
     2299     define input  parameter p-action as logical   no-undo .
     2300     do
     2301     on error undo, return error return-value
     2302     :
     2303       if p-action = ?
     2304       then do:
     2305         if v-diasize-need-maximize = true
     2306         then do:
     2307           assign
     2308             p-action = true
     2309           .
     2310         end.
     2311         else do:
     2312           assign
     2313             p-action = false
     2314           .
     2315         end.
     2316       end.
     2317       if p-action = true
     2318       then do:
     2319         run diasize_change-height in this-procedure
     2320           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2321               - frame Dialog-Frame :height-chars
     2322           ,input true
     2323           ) .
     2324         run diasize_change-width in this-procedure
     2325           (input session :width-chars
     2326               - frame Dialog-Frame :width-chars
     2327           ,input true
     2328           ) .
     2329         assign
     2330           v-diasize-need-maximize = false
     2331         .
     2332       end.
     2333       else do:
     2334         run diasize_change-width in this-procedure
     2335           (input v-diasize-orig-frame-width
     2336               - frame Dialog-Frame :width-chars
     2337           ,input true
     2338           ) .
     2339         run diasize_change-height in this-procedure
     2340           (input v-diasize-orig-frame-height
     2341               - frame Dialog-Frame :height-chars
     2342           ,input true
     2343           ) .
     2344         assign
     2345           v-diasize-need-maximize = true
     2346         .
     2347       end.
     2348     end.
     2349   end procedure.
     2350   procedure diasize_restore-orig-size :
     2351     do
     2352     on error undo, return error return-value
     2353     :
     2354       assign
     2355         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2356         v-diasize-current-frame-height = frame Dialog-Frame :height
     2357       .
     2358       run diasize_set-height in this-procedure
     2359         (input  v-diasize-orig-frame-height
     2360         ,input  true
     2361         ) .
     2362       run diasize_set-width in this-procedure
     2363         (input  v-diasize-orig-frame-width
     2364         ,input  true
     2365         ) .
     2366     end.
     2367   end procedure.
     2368   procedure diasize_restore-current-size :
     2369     do
     2370     on error undo, return error return-value
     2371     :
     2372       run diasize_set-height in this-procedure
     2373         (input  v-diasize-current-frame-height
     2374         ,input  true
     2375         ) .
     2376       run diasize_set-width in this-procedure
     2377         (input  v-diasize-current-frame-width
     2378         ,input  true
     2379         ) .
     2380     end.
     2381   end procedure.
     2382   procedure diasize_set-browse-handle :
     2383     define input  parameter p-browse-handle as handle   no-undo .
     2384     define buffer buf_temp-browse-handle for temp-browse-handle .
     2385     do
     2386     on error undo, return error return-value
     2387     :
     2388       assign
     2389         v-diasize-browse-handle = p-browse-handle
     2390       .
     2391       for each buf_temp-browse-handle
     2392       on error undo, return error return-value
     2393       :
     2394         delete buf_temp-browse-handle .
     2395       end.
     2396     end.
     2397   end procedure.
     2398   procedure diasize_add_browse :
     2399     define input  parameter p-browse-type   as character no-undo .
     2400     define input  parameter p-browse-handle as handle    no-undo .
     2401     define buffer buf_temp-browse-handle for temp-browse-handle .
     2402     do
     2403     on error undo, return error return-value
     2404     :
     2405       assign
     2406         v-diasize-browse-number = v-diasize-browse-number + 1
     2407       .
     2408       create buf_temp-browse-handle .
     2409       assign
     2410         buf_temp-browse-handle.browse-type   = p-browse-type
     2411         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2412         buf_temp-browse-handle.browse-handle = p-browse-handle
     2413       .
     2414     end.
     2415   end procedure.
     2416   procedure diasize_init :
     2417     define variable v-default-value    as logical   no-undo .
     2418     define variable v-restore-saved    as logical   no-undo .
     2419     define variable v-resize-value-str as character no-undo .
     2420     do
     2421     on error undo, return error return-value
     2422     :
     2423       do with frame Dialog-Frame
     2424       :
     2425         assign
     2426           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2427           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2428           v-diasize-browse-handle     = browse br-trans :handle
     2429         .
     2430         create button v-diasize-resize-button
     2431         assign
     2432           parent        = frame Dialog-Frame :first-child
     2433           label         = "s"
     2434           height-pixels = 16
     2435           width-pixels  = 16
     2436           visible       = true
     2437           sensitive     = true
     2438           movable       = true
     2439           triggers:
     2440             on end-move persistent run diasize_end-move in this-procedure .
     2441           end triggers.
     2442         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2443         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2444         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2445         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2446         assign
     2447           v-diasize-wndmax = false
     2448         .
     2449         if connected("ub") = true
     2450         then do:
     2451           define variable v-cntxt-db-num        as integer   no-undo .
     2452           define variable v-cntxt-userid        as character no-undo .
     2453           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2454                                             , OUTPUT v-cntxt-userid
     2455                                             ) .
     2456           run gbl/wndpar_r.p
     2457             (input  v-cntxt-db-num
     2458             ,input  v-cntxt-userid
     2459             ,input  'wndmax':U
     2460             ,output v-diasize-wndmax
     2461             ,output v-default-value
     2462             ) .
     2463         end.
     2464         assign
     2465           v-diasize-wndstore = false
     2466         .
     2467         if connected("ub") = true
     2468         then do:
     2469           run gbl/wndpar_r.p
     2470             (input  v-cntxt-db-num
     2471             ,input  v-cntxt-userid
     2472             ,input  'wndstore':U
     2473             ,output v-diasize-wndstore
     2474             ,output v-default-value
     2475             ) .
     2476         end.
     2477         assign
     2478           v-diasize-proc-name = entry(1, program-name(2), '.')
     2479         .
     2480         if v-diasize-wndstore = true
     2481         then do:
     2482           assign
     2483             v-restore-saved = false
     2484           .
     2485           if connected("ub") = true
     2486           then do:
     2487             run gbl/wndsizer.p
     2488               (input  v-cntxt-db-num
     2489               ,input  v-cntxt-userid
     2490               ,input  v-diasize-proc-name
     2491               ,input  'height':u
     2492               ,output v-resize-value-str
     2493               ) .
     2494             if v-resize-value-str <> '':U
     2495             then do:
     2496               run diasize_change-height in this-procedure
     2497                 (input  integer(v-resize-value-str)
     2498                 ,input  true
     2499                 ) .
     2500               assign
     2501                 v-restore-saved = true
     2502               .
     2503             end.
     2504           end.
     2505           if connected("ub") = true
     2506           then do:
     2507             run gbl/wndsizer.p
     2508               (input  v-cntxt-db-num
     2509               ,input  v-cntxt-userid
     2510               ,input  v-diasize-proc-name
     2511               ,input  'width':u
     2512               ,output v-resize-value-str
     2513               ) .
     2514             if v-resize-value-str <> '':U
     2515             then do:
     2516               run diasize_change-width in this-procedure
     2517                 (input  integer(v-resize-value-str)
     2518                 ,input  true
     2519                 ) .
     2520               assign
     2521                 v-restore-saved = true
     2522               .
     2523             end.
     2524           end.
     2525           if v-restore-saved <> true
     2526           then do:
     2527             if v-diasize-wndmax = true
     2528             then do:
     2529               run diasize_maximize in this-procedure
     2530                 (input  true
     2531                 ) .
     2532             end.
     2533           end.
     2534         end.
     2535         else do:
     2536           if v-diasize-wndmax = true
     2537           then do:
     2538             run diasize_maximize in this-procedure
     2539               (input  true
     2540               ) .
     2541           end.
     2542         end.
     2543       end.
     2544     end.
     2545   end procedure.
     2546   procedure diasize_need-full-display :
     2547     define output parameter p-need-full-display as logical   no-undo .
     2548     do
     2549     on error undo, return error return-value
     2550     :
     2551       assign
     2552         p-need-full-display = v-diasize-need-full-display
     2553       .
     2554       assign
     2555         v-diasize-need-full-display = false
     2556       .
     2557     end.
     2558   end procedure.
     2559   procedure get-context :
     2560      define output parameter p-db-num as integer          no-undo.
     2561      define output parameter p-user-id as character        no-undo.
     2562      define variable v-login               as character    no-undo.
     2563      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2564      define buffer buf_user-login  for ub.user-login .
     2565      do
     2566      on error undo, return error
     2567      :
     2568            FIND FIRST buf_sys-ctrl no-lock.
     2569            ASSIGN
     2570               v-login = USERID("ub")
     2571               p-db-num = buf_sys-ctrl.db-num
     2572            .
     2573            FIND FIRST buf_user-login
     2574                 WHERE buf_user-login.db-num = p-db-num
     2575                   AND buf_user-login.user-login = v-login
     2576                 no-lock
     2577                 no-error
     2578                 .
     2579            IF AVAILABLE buf_user-login
     2580            THEN DO:
     2581               assign
     2582                  p-user-id = buf_user-login.user-id
     2583               .
     2584            END.
     2585      end.
     2586   end procedure.
     2587       run diasize_init in this-procedure .
     2588   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2589   on INS of frame Dialog-Frame anywhere do:
     2590     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2591     return no-apply.
     2592   end.
     2593   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2594   on F2 of frame Dialog-Frame anywhere do:
     2595     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2596     return no-apply.
     2597   end.
     2598   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2599   procedure set-filter-name :
     2600   define input parameter p-filter-name as character no-undo .
     2601     do with frame Dialog-Frame:
     2602       if p-filter-name > "" then do:
     2603         assign
     2604           frame Dialog-Frame:title
     2605             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2606         .
     2607         assign
     2608           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2609         .
     2610       end.
     2611       else do:
     2612         assign
     2613           b-sch :tooltip = ""
     2614         .
     2615       end.
     2616     end.
     2617   end procedure.
     2618   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2619   on f5 of frame Dialog-Frame anywhere
     2620   do:
     2621      v-rep-rec = ?. if available X_cd-trans then v-rep-rec = recid(X_cd-trans). RUn OpenBR in this-procedure ( input yes, input no, input '':U).  reposition br-trans to recid v-rep-rec no-error.
     2622       apply "VALUE-CHANGED" to br-trans.
     2623   end.
     2624   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2625   do:
     2626     br-trans :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2627   end.
     2628   MAIN-BLOCK:
     2629   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2630      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2631   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2632     run mainmenu_getcntxt in parparentproc
     2633       (output v-cntxt-db-num
     2634       ,output v-cntxt-userid
     2635       ,output v-cntxt-level
     2636       ,output v-cntxt-host-code-obj
     2637       ,output v-cntxt-obj-type
     2638       ,output v-cntxt-obj-code
     2639       ,output v-cntxt-db-num-obj
     2640       ,output v-cntxt-is-admin
     2641       ) .
     2642     if lookup(p-list-mode, 'объект':U + chr(44) + "chk-id") = 0 THEN DO:
     2643       message vss-workfile vss-revision vss-description skip
     2644       "Неверный вызов - p-list-mode=" p-list-mode
     2645       view-as alert-box ERROR.
     2646       return.
     2647     END.
     2648     IF p-list-mode = 'объект':U
     2649     OR p-list-mode = "chk-date":U THEN DO:
     2650       FIND FIRST buf_obj No-LOCK WHERE
     2651                   buf_obj.obj-type = p-obj-type and
     2652                   buf_obj.obj-code = p-obj-code No-ERROR.
     2653       if not avail buf_obj then do:
     2654         message vss-workfile vss-revision vss-description skip
     2655         "Неверное значение параметров вызова p-obj-type и/или p-obj-code"
     2656         p-obj-type p-obj-code
     2657         view-as alert-box ERROR.
     2658         return.
     2659       end.
     2660     end.
     2661     IF p-list-mode = "chk-date":U then do:
     2662         if p-start-date > p-end-date
     2663         or p-start-date = ?
     2664         or p-end-date = ?
     2665         then do:
     2666             message vss-workfile vss-revision vss-description skip
     2667             "Неверное значение параметров p-start-date p-end-date" p-start-date p-end-date
     2668             view-as alert-box ERROR.
     2669             return.
     2670       end.
     2671     END.
     2672     if this-procedure:instantiating-procedure:get-signature("cd-trans_cb")  <> "" then do:
     2673       run cd-trans_cb in (this-procedure:INSTANTIATING-PROCEDURE) ( input ( buffer temp-param:handle)) no-error.
     2674       if error-status:error then do:
     2675          message
     2676          substitute("Ошибка при инициализации параметров &1 в &2"
     2677                     , this-procedure:file-name
     2678                     , this-procedure:INSTANTIATING-PROCEDURE:file-name)
     2679          view-as alert-box error .
     2680          undo main-block, return error .
     2681       end.
     2682     end.
     2683     RUN Myenable IN THIS-PROCEDURE.
     2684     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2685     ASSIGN
     2686     v-rid-list = p-rid-list.
     2687     HIDE mark-num in frame Dialog-Frame .
     2688     if entry(1, v-rid-list) <> '':U then
     2689     REPOSITION br-trans to recid integer(entry(1, v-rid-list)) No-ERROR.
     2690     WAIT-FOR GO OF FRAME Dialog-Frame.
     2691   END.
     2692   RUN disable_UI.
     2693   PROCEDURE disable_UI :
     2694     HIDE FRAME Dialog-Frame.
     2695   END PROCEDURE.
     2696   PROCEDURE enable_UI :
     2697     DISPLAY mark-num
     2698         WITH FRAME Dialog-Frame.
     2699     ENABLE b-quit b-mark b-sel b-chk-doc b-sch B-Help br-trans mark-num
     2700         WITH FRAME Dialog-Frame.
     2701     VIEW FRAME Dialog-Frame.
     2702   END PROCEDURE.
     2703   PROCEDURE MyEnable :
     2704   DEFINE VARIABLE v-h AS HANDLE NO-UNDO.
     2705   DEFINE VARIABLE v-chk-time-h AS HANDLE NO-UNDO.
     2706   DEFINE BUFFER buf_custom-labels FOR ub.custom-labels.
     2707   ASSIGN
     2708   v-h = br-trans:FIRST-COLUMN IN FRAME Dialog-Frame
     2709   .
     2710   DO while valid-handle(v-h) :
     2711    IF p-trans-type > 0  THEN DO:
     2712       FIND FIRST buf_custom-labels NO-LOCK WHERE
     2713               buf_custom-labels.CALL-TYPE = "cd-trans"
     2714         AND buf_custom-labels.call-point = string(p-trans-type)
     2715         AND buf_custom-labels.tbl-name = 'cd-trans':U
     2716         AND buf_custom-labels.fld-name = v-h:NAME NO-ERROR.
     2717       IF NOT AVAILABLE buf_custom-labels THEN DO:
     2718          v-h:VISIBLE = NO.
     2719       END.
     2720       ELSE DO:
     2721         ASSIGN
     2722         v-h:visible = YES
     2723         v-h:LABEL = buf_custom-labels.custom-label
     2724         v-h:width = max(buf_custom-labels.widget-width, length(buf_custom-labels.custom-label))
     2725         v-h:RESIZABLE = (v-h:DATA-TYPE = 'character':U)
     2726         .
     2727         if v-h:name = "charkey_one" then do:
     2728           assign
     2729           v-charkey-one-label = buf_custom-labels.custom-label
     2730           .
     2731         end.
     2732       END.
     2733     END.
     2734     IF v-h:LABEL = "Время" THEN DO:
     2735        v-chk-time-h = v-h.
     2736     END.
     2737     IF v-h:LABEL = "Тип!транзакции" THEN DO:
     2738        v-h:RESIZABLE = YES.
     2739     END.
     2740   v-h = v-h:NEXT-COLUMN.
     2741   END.
     2742   CASE p-list-mode:
     2743     WHEN 'объект':U THEN DO:
     2744         ASSIGN
     2745         X_cd-trans.obj-type:VISIBLE IN BROWSE br-trans = NO
     2746         X_cd-trans.obj-code:VISIBLE IN BROWSE br-trans = NO
     2747         .
     2748     END.
     2749     WHEN "chk-id" THEN DO:
     2750        ASSIGN
     2751        X_cd-trans.chk-date:VISIBLE IN BROWSE br-trans = NO
     2752        v-chk-time-h:VISIBLE = NO
     2753        X_cd-trans.doc-code:VISIBLE IN BROWSE br-trans = NO
     2754        X_cd-trans.obj-type:VISIBLE IN BROWSE br-trans = NO
     2755        X_cd-trans.obj-code:VISIBLE IN BROWSE br-trans = NO
     2756        X_cd-trans.pay-desk:VISIBLE IN BROWSE br-trans = NO
     2757        X_cd-trans.out-code:VISIBLE IN BROWSE br-trans = NO
     2758        .
     2759     END.
     2760   END CASE.
     2761   DISPLAY
     2762   mark-num
     2763   WITH FRAME Dialog-Frame .
     2764   ENABLE
     2765   b-quit
     2766   b-mark when lookup("b-sel", bttns) > 0
     2767   b-sel  when lookup("b-sel", bttns) > 0
     2768   b-chk-doc WHEN p-list-mode <> "chk-id"
     2769   b-sch
     2770   B-Help
     2771   br-trans
     2772   mark-num
     2773   WITH FRAME Dialog-Frame .
     2774   VIEW FRAME Dialog-Frame .
     2775   END PROCEDURE.
     2776   PROCEDURE OpenBr :
     2777   define input  parameter p-open-query     as logical   no-undo .
     2778   define input  parameter p-find-next      as logical   no-undo .
     2779   define input  parameter p-find-condition as character no-undo .
