      402   define  stream PrnLibStream.
      403   procedure prn-lib-prn-file :
      404     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      405     define input parameter p-DIsabledoptions as integer no-undo .
      406     define variable v-report-name as character no-undo .
      407     define variable v-user-action as character no-undo .
      408     define variable v-printed     as logical   no-undo .
      409     define variable v-exist       as logical   no-undo .
      410     do
      411       on error undo, return error
      412       :
      413       run prn-lib-get-report-name  in this-procedure (
      414         input parParentProc
      415         ,output v-report-name
      416         ).
      417   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      418   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      419     (input  v-report-name
      420     ,input  2
      421     ,output v-exist
      422     )  .
      423       if NOT v-exist then
      424       DO:
      425         Message
      426           "Нет заданий на печать ! "
      427           view-as alert-box .
      428         Return  .
      429       End.
      430       run gbl/prnfilen.w
      431         (input  ""
      432         ,input  p-DisabledOptions
      433         ,input  string(v-report-name )
      434         ,input  7
      435         ,output v-user-action
      436         ,output v-printed
      437         ) .
      438       if v-printed then
      439       do:
      440         return "YES" .
      441       end.
      442       else
      443       do:
      444         return "NO" .
      445       end.
      446     end.
      447   end procedure.
      448   procedure prn-lib-open-stream :
      449     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      450     define input parameter p-page-size    as integer no-undo .
      451     define input parameter p-is-stream    as logical no-undo .
      452     define input parameter p-append       as logical no-undo .
      453     define variable v-report-name as character no-undo .
      454     do
      455       on error undo, return error
      456       :
      457       run prn-lib-get-report-name  in this-procedure (
      458         input parParentProc
      459         ,output v-report-name
      460         ).
      461       if p-is-stream then
      462       do:
      463         if p-append then
      464         do:
      465           output stream PrnLibStream to value( v-report-name )
      466             page-size value(p-page-size) append .
      467         end.
      468         if not p-append then
      469         do:
      470           output stream PrnLibStream to value( v-report-name )
      471             page-size value(p-page-size) .
      472         end.
      473       end.
      474       if not p-is-stream then
      475       do:
      476         if p-append then
      477         do:
      478           output to value( v-report-name )
      479             page-size value(p-page-size) append .
      480         end.
      481         if not p-append then
      482         do:
      483           output to value( v-report-name )
      484             page-size value(p-page-size) .
      485         end.
      486       end.
      487     end.
      488   end procedure.
      489   procedure prn-lib-open-exp :
      490     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      491     define input parameter p-is-stream    as logical no-undo .
      492     define input parameter p-is-append    as logical no-undo .
      493     define output parameter p-ReportFileName as char init "report" no-undo.
      494     define output parameter p-process as logical no-undo .
      495     define variable glog as logical no-undo .
      496     do
      497       on error undo, return error
      498       :
      499       SYSTEM-DIALOG GET-FILE p-ReportFileName
      500         TITLE      "Укажите путь"
      501         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      502         ASK-OVERWRITE
      503         CREATE-TEST-FILE
      504         SAVE-AS
      505         USE-FILENAME
      506         DEFAULT-EXTENSION "txt"
      507         UPDATE glog
      508         .
      509       if not glog then  return.
      510       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      511       if p-is-stream then
      512       do:
      513         if p-is-append then
      514         do:
      515           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      516         end.
      517         else
      518         do:
      519           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      520         end.
      521       end.
      522       else
      523       do:
      524         if p-is-append then
      525         do:
      526           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      527         end.
      528         else
      529         do:
      530           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      531         end.
      532       end.
      533       p-process = yes.
      534     end.
      535   end procedure.
      536   procedure prn-lib-get-report-name :
      537     define input parameter parParentProc  as widget-handle no-undo.
      538     define output parameter p-report-name as character no-undo .
      539     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      540   end procedure.
      541   procedure prn-lib-reportviewer-report-name :
      542     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      543     define input parameter p-report-name-html as character no-undo .
      544     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      545   end procedure.
      546   procedure prn-lib-reportviewer :
      547     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      548     define input parameter p-report-name-html as character no-undo .
      549     define input parameter p-param        as character no-undo .
      550     define variable v-excel           as character no-undo init 'TRUE' .
      551     define variable v-value-character as character no-undo .
      552     define variable v-value-integer   as character no-undo .
      553     define variable v-value-date      as date      no-undo .
      554     define variable v-value-decimal   as decimal   no-undo .
      555     define variable rep-excel         as logical   no-undo .
      556     define variable excel-string      as character no-undo .
      557     define variable v-param-type      as character no-undo .
      558     define variable v-tth             as handle    no-undo .
      559     run adm/shattri.p (
      560       input "get":U
      561       ,input  ""
      562       ,input  0
      563       ,input  'report-glob':U
      564       ,input  'rep-excel':U
      565       ,output v-value-character
      566       ,output v-value-date
      567       ,output v-value-decimal
      568       ,output v-value-integer
      569       ,output rep-excel
      570       ,output v-param-type
      571       ,INPUT-OUTPUT table-handle v-tth
      572       )  .
      573     if rep-excel then v-excel = "TRUE" .
      574     else v-excel = "FALSE" .
      575     if p-param eq ""
      576     then
      577        p-param = "EXCEL:" + v-excel.
      578     else
      579        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      580     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      581   end procedure.
      582   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      583   procedure fltfield-clear :
      584     define output parameter loc-fld as character no-undo.
      585     define output parameter loc-lab as character no-undo .
      586     define output parameter loc-spr as character no-undo .
      587     define output parameter loc-dim as character no-undo .
      588     assign
      589       loc-fld = ""
      590       loc-lab = ""
      591       loc-spr = ""
      592       loc-dim = "0"
      593     .
      594   end procedure .
      595   procedure fltfield-add :
      596     define input        parameter par-fld as character no-undo.
      597     define input        parameter par-lab as character no-undo .
      598     define input        parameter par-spr as character no-undo .
      599     define input-output parameter loc-fld as character no-undo.
      600     define input-output parameter loc-lab as character no-undo .
      601     define input-output parameter loc-spr as character no-undo .
      602     define input-output parameter loc-dim as character no-undo .
      603     do
      604     on error undo, return error
      605     :
      606       assign
      607       loc-fld = if loc-dim = '0'
      608                 then par-fld
      609                 else (loc-fld + chr(44) + par-fld)
      610       loc-lab = if loc-dim = '0'
      611                 then par-lab
      612                 else (loc-lab + chr(44) + par-lab)
      613       loc-spr = if loc-dim = '0'
      614                 then par-spr
      615                 else (loc-spr + chr(44) + par-spr)
      616       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      617                 string(integer(if num-entries(loc-dim) > 1
      618                               then entry(2, loc-dim)
      619                               else entry(1, loc-dim)
      620                               ) + 1)
      621       no-error
      622       .
      623     end.
      624   end procedure.
      625   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626   procedure cur-time :
      627      define output parameter p-today as date      no-undo .
      628      define output parameter p-time  as integer   no-undo .
      629     do
      630     on error undo, return error
      631     :
      632       define variable v-date1 as date      no-undo .
      633       define variable v-date2 as date      no-undo .
      634       define variable v-time  as integer   no-undo .
      635       assign
      636         v-date1 = today
      637         v-time  = time
      638         v-date2 = today
      639       .
      640       if v-date1 <> v-date2
      641       then do:
      642         assign
      643           v-date1 = today
      644           v-time  = v-time
      645         .
      646       end.
      647       assign
      648         p-today = v-date1
      649         p-time  = v-time
      650       .
      651     end.
      652   end.
      653   function cur-time-date returns character
      654   :
      655     return string(today, '99/99/9999':U) .
      656   end.
      657   function cur-time-mjd returns decimal
      658   :
      659     define variable v-date as date      no-undo .
      660     define variable v-time as integer   no-undo .
      661     run cur-time in this-procedure
      662       (output v-date
      663       ,output v-time
      664       ) .
      665     return integer(v-date) - 2400002 + (v-time / 86400) .
      666   end.
      667   function cur-time-get-ending-index returns integer
      668   (input p-number as integer
      669   )
      670   :
      671     if p-number < 0
      672     or p-number = ?
      673     then do:
      674       return 1 .
      675     end.
      676     define variable v-rest as integer   no-undo .
      677     assign
      678       p-number = p-number modulo 100
      679     .
      680     if p-number < 20
      681     then do:
      682       assign
      683         v-rest = p-number
      684       .
      685     end.
      686     else do:
      687       assign
      688         v-rest = p-number modulo 10
      689       .
      690     end.
      691     case v-rest :
      692       when 1
      693       then do:
      694         return 2 .
      695       end.
      696       when 2 or
      697       when 3 or
      698       when 4
      699       then do:
      700         return 3 .
      701       end.
      702       otherwise do:
      703         return 1 .
      704       end.
      705     end case .
      706   end.
      707   procedure cur-time-mjd-to-date :
      708      define input  parameter i-mjd-diff as decimal no-undo.
      709      define output parameter o-Date     as date    no-undo.
      710      define output parameter o-Time     as integer no-undo.
      711      define variable v-day-number as integer   no-undo .
      712      if    i-mjd-diff < 0
      713         or i-mjd-diff = ?
      714      then do:
      715         return "?" .
      716      end.
      717      assign
      718         v-day-number = truncate(i-mjd-diff,0).
      719         o-Date = date(v-day-number + 2400002).
      720         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      721     .
      722   end.
      723   function cur-time-mjd-to-string returns character
      724   (input p-mjd-diff as decimal
      725   )
      726   :
      727     define variable v-day-number as integer   no-undo .
      728     define variable v-seconds    as integer   no-undo .
      729     define variable v-hour       as integer   no-undo .
      730     define variable v-min        as integer   no-undo .
      731     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      732     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      733     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      734     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      735     if p-mjd-diff < 0
      736     or p-mjd-diff = ?
      737     then do:
      738       return "?" .
      739     end.
      740     assign
      741       v-day-number = integer(truncate(p-mjd-diff,0))
      742       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      743     .
      744     if v-seconds > 86400
      745     then do:
      746       assign
      747         v-seconds = 86400 - 1
      748       .
      749     end.
      750     if v-seconds < 0
      751     then do:
      752       assign
      753         v-seconds = 0
      754       .
      755     end.
      756     assign
      757       v-hour = truncate(v-seconds / 3600, 0)
      758     .
      759     assign
      760       v-seconds = v-seconds modulo 3600
      761     .
      762     assign
      763       v-min = truncate(v-seconds / 60, 0)
      764     .
      765     assign
      766       v-seconds = v-seconds modulo 60
      767     .
      768     return
      769         (if v-day-number <> 0
      770           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      771           else ""
      772         )
      773       + (if v-day-number <> 0 or v-hour <> 0
      774           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      775           else ""
      776         )
      777       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      778           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      779           else ""
      780         )
      781       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      782       .
      783   end.
      784   function cur-time-string returns character
      785   :
      786     define variable v-date as date      no-undo .
      787     define variable v-time as integer   no-undo .
      788     run cur-time in this-procedure
      789       (output v-date
      790       ,output v-time
      791       ) .
      792     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      793   end.
      794   function cur-time-string-sec returns character
      795   :
      796     define variable v-date as date      no-undo .
      797     define variable v-time as integer   no-undo .
      798     run cur-time in this-procedure
      799       (output v-date
      800       ,output v-time
      801       ) .
      802     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      803   end.
      804   function cur-time-custom  returns character
      805   (input p-prefix as character
      806   ,input p-date-format as character
      807   ,input p-delimiter as character
      808   ,input p-time-format as character
      809   ,input p-suffix as character
      810   )
      811   :
      812     define variable v-date as date      no-undo .
      813     define variable v-time as integer   no-undo .
      814     run cur-time in this-procedure
      815       (output v-date
      816       ,output v-time
      817       ) .
      818     return
      819       p-prefix
      820       + string(v-date, p-date-format)
      821       + p-delimiter
      822       + string(v-time, p-time-format)
      823       + p-suffix
      824       .
      825   end.
      826   function cur-time-print  returns character
      827   :
      828     define variable v-date as date      no-undo .
      829     define variable v-time as integer   no-undo .
      830     run cur-time in this-procedure
      831       (output v-date
      832       ,output v-time
      833       ) .
      834     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      835   end.
      836   function cur-time-datetime returns datetime
      837   :
      838     define variable v-char as character no-undo .
      839     define variable v-datetime as datetime no-undo .
      840     v-char = cur-time-string().
      841     v-datetime = datetime(v-char).
      842     return  v-datetime.
      843   end.
      844   function cur-time-string-msec returns character
      845   :
      846     define variable v-date as datetime  no-undo .
      847     v-date = now.
      848     return string(v-date) .
      849   end.
