     1716             v-object-handle = buf_temp-diasize-handle.handle-value
     1717           .
     1718           if v-object-handle <> v-diasize-resize-button
     1719           then do:
     1720             assign
     1721               v-object-handle :row = v-object-handle :row + p-change-value
     1722               no-error .
     1723             if error-status :error
     1724             or error-status :get-message(1) <> ""
     1725             then do:
     1726               undo move_block, retry move_block .
     1727             end.
     1728           end.
     1729         end.
     1730       end.
     1731       else do:
