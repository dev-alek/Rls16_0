      874   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   FUNCTION mark-string RETURNS CHARACTER
      876     ( input p-recid as recid, input mark-list as character  ) :
      877     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      878   END FUNCTION.
      879   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880     define variable v-cntxt-db-num        as integer   no-undo .
      881     define variable v-cntxt-userid        as character no-undo .
      882     define variable v-cntxt-level         as character no-undo .
      883     define variable v-cntxt-host-code-obj as integer   no-undo .
      884     define variable v-cntxt-obj-type      as character no-undo .
      885     define variable v-cntxt-obj-code      as integer   no-undo .
      886     define variable v-cntxt-db-num-obj    as integer   no-undo .
      887     define variable v-cntxt-is-admin      as logical   no-undo .
      888   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      889   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      890   procedure fltopend_fltopend :
      891   define input parameter p-parent-handle as handle no-undo .
      892   define input parameter p-qh as handle no-undo .
      893   define input parameter p-flt-open-open-query  as character no-undo .
      894   define input parameter p-where-cond as character no-undo .
      895   define input parameter p-use-indFIRST-query-tail as character no-undo .
      896   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      897   define input parameter p-indexed-reposition as character no-undo .
      898     do
      899     on error undo, return error
      900     :
      901   define variable v-prepare-string as character no-undo .
      902   define variable glog as logical no-undo .
      903   assign
      904   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      905                      p-where-cond + chr(32)  +
      906                      p-use-indFIRST-query-tail + chr(32) +
      907                      p-use-ind-sort-clmn-by + chr(32) +
      908                      p-indexed-reposition
      909   .
      910   assign
      911   glog = p-qh:query-prepare(v-prepare-string) no-error .
      912   if not glog
      913   or error-status:error then do:
      914     message error-status:get-message(1) view-as alert-box .
      915     undo, return error .
      916   end.
      917   assign
      918   glog = p-qh:query-open no-error .
      919   if not glog
      920   or error-status:error then do:
      921     message error-status:get-message(1) view-as alert-box .
      922     undo, return error .
      923   end.
      924     end.
      925   end procedure.
      926   procedure fltopend_fltfindd :
      927   define input parameter p-parent-handle as handle no-undo .
      928   define input parameter p-qh as handle no-undo .
      929   define input parameter p-rowid as rowid no-undo .
      930   define input parameter p-next as logical no-undo .
      931   define input parameter p-lock as integer no-undo .
      932   define input parameter p-bh as handle no-undo .
      933   define input parameter p-where-cond as character no-undo .
      934   define input parameter p-use-index-phrase as character no-undo .
      935   define variable glog as logical no-undo .
      936   define variable v-qh as handle no-undo .
      937   define variable v-bh as handle no-undo .
      938   define variable v-recid as recid no-undo .
      939   define variable v-prepare-string as character no-undo .
      940   do
      941   on error undo, return error
      942   on stop undo, return error
      943   :
      944     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      945     create buffer v-bh for table p-bh buffer-name p-bh:name.
      946     create query v-qh.
      947     v-qh:set-buffers(v-bh).
      948     v-prepare-string = substitute("for each &1 &2 &3"
      949                                     ,v-bh:name
      950                                     ,p-where-cond
      951                                     ,p-use-index-phrase).
      952     glog = v-qh:query-prepare(v-prepare-string) no-error.
      953     if not glog then do:
      954       delete object v-qh.
      955       delete object v-bh.
      956       undo, return error .
      957     end.
      958     glog = v-qh:query-open no-error .
      959     if not glog then do:
      960       delete object v-qh.
      961       delete object v-bh.
      962       undo, return error .
      963     end.
      964     if p-next then do:
      965       v-qh:reposition-to-rowid(p-rowid) no-error .
      966       glog = v-qh:get-next( p-lock) no-error .
      967       glog = v-qh:get-next( p-lock) no-error .
      968       if not glog or v-qh:query-off-end = yes then do:
      969         glog = v-qh:get-first( p-lock) no-error .
      970       end.
      971     end.
      972     else do:
      973       glog = v-qh:get-first( p-lock) no-error .
      974     end.
      975     v-recid = v-bh:recid no-error .
      976     delete object v-qh.
      977     delete object v-bh.
      978     return string(v-recid) .
      979   end.
      980   end procedure.
      981   procedure fltopend_fltfindq :
      982   define input parameter p-parent-handle as handle no-undo .
      983   define input parameter p-qh as handle no-undo .
      984   define input parameter p-next as logical no-undo .
      985   define input parameter p-lock as integer no-undo .
      986   define input parameter p-flt-open-open-query  as character no-undo .
      987   define input parameter p-where-cond as character no-undo .
      988   define input parameter p-use-indFIRST-query-tail as character no-undo .
      989   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      990   define input parameter p-indexed-reposition as character no-undo .
      991   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      992   define variable glog as logical no-undo .
      993   define variable v-qh as handle no-undo .
      994   define variable v-bh as handle no-undo extent 18.
      995   define variable v-rowid as rowid no-undo extent 18.
      996   define variable v-ii as integer no-undo .
      997   define variable v-prepare-string as character no-undo .
      998   do
      999   on error undo, return error
     1000   on stop undo, return error
     1001   :
     1002     create query v-qh.
     1003     do v-ii = 1 to p-qh:num-buffers:
     1004       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1005       assign
     1006       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1007       no-error.
     1008       v-qh:add-buffer(v-bh[v-ii]).
     1009     end.
     1010     assign
     1011     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1012                       p-where-cond + chr(32)  +
     1013                       p-use-indFIRST-query-tail + chr(32) +
     1014                       p-use-ind-sort-clmn-by + chr(32) +
     1015                       p-indexed-reposition
     1016     .
     1017     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1018     if not glog then do:
     1019       delete object v-qh.
     1020       do v-ii = 1 to p-qh:num-buffers:
     1021         delete object v-bh[v-ii].
     1022       end.
     1023       undo, return error .
     1024     end.
     1025     glog = v-qh:query-open no-error .
     1026     if not glog then do:
     1027       delete object v-qh.
     1028       do v-ii = 1 to p-qh:num-buffers:
     1029         delete object v-bh[v-ii].
     1030       end.
     1031       undo, return error .
     1032     end.
     1033     if p-next then do:
     1034       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1035       glog = v-qh:get-next( p-lock) no-error .
     1036       glog = v-qh:get-next( p-lock) no-error .
     1037       if not glog or v-qh:query-off-end = yes then do:
     1038         glog = v-qh:get-first( p-lock) no-error .
     1039       end.
     1040     end.
     1041     else do:
     1042       glog = v-qh:get-first( p-lock) no-error .
     1043     end.
     1044     do v-ii = 1 to p-qh:num-buffers:
     1045       assign
     1046       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1047       no-error.
     1048     end.
     1049     delete object v-qh.
     1050     do v-ii = 1 to p-qh:num-buffers:
     1051       delete object v-bh[v-ii].
     1052     end.
     1053   end.
     1054   end procedure.
     1055   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1056   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1057   procedure paramls-clear :
     1058     define buffer buf_temp-param for temp-param .
     1059     do
     1060     on error undo, return error return-value
     1061     :
     1062       for each buf_temp-param
     1063       on error undo, return error
     1064       :
     1065         delete buf_temp-param .
     1066       end.
     1067     end.
     1068   end procedure.
     1069   procedure paramls-write :
     1070     define input  parameter p-code     as character no-undo .
     1071     define input  parameter p-sub-code as character no-undo .
     1072     define input  parameter p-value    as character no-undo .
     1073     define buffer buf_temp-param for temp-param .
     1074     do
     1075     on error undo, return error return-value
     1076     :
     1077       find first buf_temp-param
     1078         where buf_temp-param.param-code     = p-code
     1079           and buf_temp-param.param-sub-code = p-sub-code
     1080         no-error .
     1081       if not available buf_temp-param then do:
     1082         create buf_temp-param .
     1083         assign
     1084           buf_temp-param.param-code     = p-code
     1085           buf_temp-param.param-sub-code = p-sub-code
     1086         .
     1087       end.
     1088       assign
     1089         buf_temp-param.param-value = p-value
     1090       .
     1091     end.
     1092   end procedure.
     1093   procedure paramls-read :
     1094     define input  parameter p-code          as character no-undo .
     1095     define input  parameter p-sub-code      as character no-undo .
     1096     define input  parameter p-default-value as character no-undo .
     1097     define output parameter p-value         as character no-undo .
     1098     define buffer buf_temp-param for temp-param .
     1099     do
     1100     on error undo, return error return-value
     1101     :
     1102       find first buf_temp-param
     1103         where buf_temp-param.param-code     = p-code
     1104           and buf_temp-param.param-sub-code = p-sub-code
     1105         no-error .
     1106       if available buf_temp-param then do:
     1107         assign
     1108           p-value = buf_temp-param.param-value
     1109         .
     1110       end.
     1111       else do:
     1112         assign
     1113           p-value = p-default-value
     1114         .
     1115       end.
     1116     end.
     1117   end procedure.
     1118   procedure paramls-append :
     1119     define input  parameter p-code     as character no-undo .
     1120     define input  parameter p-sub-code as character no-undo .
     1121     define input  parameter p-value    as character no-undo .
     1122     define buffer buf_temp-param for temp-param .
     1123     do
     1124     on error undo, return error return-value
     1125     :
     1126       find first buf_temp-param
     1127            where buf_temp-param.param-code     = p-code
     1128              and buf_temp-param.param-sub-code = p-sub-code
     1129         no-error .
     1130       if not available buf_temp-param then do:
     1131         create buf_temp-param .
     1132         assign
     1133           buf_temp-param.param-code     = p-code
     1134           buf_temp-param.param-sub-code = p-sub-code
     1135           buf_temp-param.param-value    = p-value
     1136         .
     1137       end.
     1138       else do:
     1139           assign
     1140               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1141           .
     1142       end.
     1143     end.
     1144   end procedure.
     1145   FUNCTION get-trans-name RETURNS CHARACTER
     1146     ( p-trans-type AS INTEGER)  FORWARD.
     1147   DEFINE BUTTON b-chk-doc
     1148        LABEL "Чек"
     1149        SIZE 10 BY 1.
     1150   DEFINE BUTTON B-Help
     1151        LABEL "Помо&щь"
     1152        SIZE 3 BY 1
     1153        BGCOLOR 8 .
     1154   DEFINE BUTTON b-mark
     1155        LABEL "&*"
     1156        SIZE 3 BY 1.
     1157   DEFINE BUTTON b-quit AUTO-END-KEY
     1158        LABEL "&Выход"
     1159        SIZE 10 BY 1
     1160        BGCOLOR 8 .
     1161   DEFINE BUTTON b-sch
     1162        LABEL "&Фильтр"
     1163        SIZE 3 BY 1.
     1164   DEFINE BUTTON b-sel AUTO-GO
     1165        LABEL "&Выбор"
     1166        SIZE 10 BY 1.
     1167   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U INITIAL "0"
     1168         VIEW-AS TEXT
     1169        SIZE 10 BY .67 NO-UNDO.
     1170   DEFINE QUERY br-trans FOR
     1171         X_cd-trans SCROLLING.
     1172   DEFINE BROWSE br-trans
     1173     QUERY br-trans NO-LOCK DISPLAY
     1174         mark-string(recid(X_cd-trans), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1175   X_cd-trans.chk-date COLUMN-LABEL "Дата" FORMAT "99/99/9999":U
     1176   string(X_cd-trans.chk-time, "HH:MM") COLUMN-LABEL "Время" FORMAT "X(5)"
     1177   X_cd-trans.doc-code COLUMN-LABEL "Номер чека" FORMAT "X(20)":U
     1178   X_cd-trans.obj-type COLUMN-LABEL "Тип!Объ" FORMAT "X(3)":U
     1179   X_cd-trans.obj-code COLUMN-LABEL "Код!обЪ" FORMAT ">>>>9":U
     1180   X_cd-trans.pay-desk COLUMN-LABEL "Касса" FORMAT ">>>9":U
     1181   X_cd-trans.out-code COLUMN-LABEL "Номер_РН" FORMAT "X(14)":U
     1182   get-trans-name(X_cd-trans.trans-type) COLUMN-LABEL "Тип!транзакции" FORMAT "X(255)" WIDTH 40
     1183   X_cd-trans.charkey_one COLuMN-LABEL "" FORMAT "X(255)":U WIDTH 20
     1184   X_cd-trans.key#_one COLuMN-LABEL "" FORMAT "->>>>>>>>9":U
     1185   X_cd-trans.deckey_one COLuMN-LABEL "" FORMAT "->>>>>>>>9.99":U
     1186       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.8 BY 20 FIT-LAST-COLUMN.
     1187   DEFINE FRAME Dialog-Frame
     1188        b-quit AT ROW 1 COL 1
     1189        b-mark AT ROW 1 COL 21 WIDGET-ID 52
     1190        b-sel AT ROW 1 COL 24 WIDGET-ID 54
     1191        b-chk-doc AT ROW 1 COL 41 WIDGET-ID 50
     1192        b-sch AT ROW 1 COL 92 WIDGET-ID 60
     1193        B-Help AT ROW 1 COL 95
     1194        br-trans AT ROW 2 COL 1 WIDGET-ID 100
     1195        mark-num AT ROW 1 COL 9 COLON-ALIGNED NO-LABEL WIDGET-ID 62
     1196        SPACE(78.80) SKIP(21.60)
     1197       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1198            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1199            TITLE ""
     1200            CANCEL-BUTTON b-quit.
     1201   ASSIGN
     1202          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1203          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1204   ON GO OF FRAME Dialog-Frame
     1205   DO:
     1206     p-rid-list = v-rid-list.
     1207   END.
     1208   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1209   DO:
     1210     APPLY "END-ERROR":U TO SELF.
     1211   END.
     1212   ON CHOOSE OF b-chk-doc IN FRAME Dialog-Frame
     1213   DO:
     1214   define variable next-prev as character no-undo .
     1215   define variable v-doc-rec as recid no-undo .
     1216   define variable v-chk-doc-rec as recid no-undo .
     1217   DEFINE BUFFER buf_chk-doc FOR ub.chk-doc.
     1218   assign
     1219   next-prev = '':U
     1220   v-cd-trans-recid = (if available X_cd-trans then recid(X_cd-trans) else ?)
     1221   .
     1222   DO WHILE next-prev = '':U:
     1223       if NOT available X_cd-trans then do:
     1224               message "Неправильно выбрана транзакция." view-as alert-box ERROR.
     1225               return no-apply.
     1226       end.
     1227       IF X_cd-trans.chk-id = "" THEN DO:
     1228         MESSAGE
     1229         "Нет ссылки на чек для этой транзакции"
     1230         VIEW-AS ALERT-BOX.
     1231         undo, return no-apply.
     1232       END.
     1233       FIND FIRST buf_chk-doc NO-LOCK WHERE
     1234                  buf_chk-doc.chk-id = X_cd-trans.chk-id
     1235              and buf_chk-doc.obj-type = X_cd-trans.obj-type
     1236              and buf_chk-doc.obj-code = X_cd-trans.obj-code no-error .
     1237       if not available buf_chk-doc then do:
     1238         message
     1239         substitute("Неверная ссылка на чек для этой транзакции&1id=&2"
     1240                   ,chr(10)
     1241                   ,X_cd-trans.chk-id)
     1242         view-as alert-box error .
     1243         undo, return no-apply.
     1244       end.
     1245       v-chk-doc-rec = recid(buf_chk-doc).
     1246       run str/superchk.w
     1247                     (
     1248                        input parparentproc
     1249                       ,input 'ПРОСМОТР':U
     1250                       ,input buf_chk-doc.obj-type
     1251                       ,input buf_chk-doc.obj-code
     1252                       ,input-output v-chk-doc-rec
     1253                       ,input this-procedure:handle
     1254                       ,input-output next-prev
     1255                                   )
     1256       .
     1257   END .
     1258   reposition br-trans to recid v-cd-trans-recid no-error.
     1259   apply "entry" to br-trans in frame Dialog-Frame.
     1260   apply "value-changed" to br-trans in frame Dialog-Frame.
     1261   END.
     1262   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1263   DO:
     1264     define variable glog as logical no-undo .
     1265     if available X_cd-trans then do:
     1266   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1267   define variable v-str-recid15 as character no-undo .
     1268   define variable v-num-entry15 as integer   no-undo .
     1269   assign
     1270     v-str-recid15 = trim( string( recid( X_cd-trans ) , "->>>>>>>>>>>9":U ) )
     1271     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1272   .
     1273   if v-num-entry15 > 0 then do:
     1274     assign
     1275       entry( v-num-entry15, v-rid-list ) = "":U
     1276       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1277     .
     1278   end.
     1279   else do:
     1280     assign
     1281       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1282     .
     1283   end.
     1284       glog = br-trans:refresh() .
     1285       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1286           glog = br-trans:select-next-row ().
     1287           apply "VALUE-CHANGED" to br-trans in frame Dialog-Frame.
     1288       end.
     1289       if num-entries( v-rid-list ) = 0
     1290       then
     1291           hide mark-num in frame Dialog-Frame.
     1292       else
     1293           display
     1294           num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1295     end.
     1296     apply "entry" to br-trans in frame Dialog-Frame.
     1297   END.
     1298   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1299   DO:
     1300       run proc-b-sch in this-procedure no-error.
     1301     if error-status:error then return no-apply.
     1302   END.
     1303   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1304   DO:
     1305       if ( available X_cd-trans ) AND ( v-rid-list = "" ) then
     1306       v-rid-list = string( recid( X_cd-trans ) ) .
     1307   END.
     1308   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1309   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1310   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1311   on help of frame Dialog-Frame
     1312   do:
     1313     run gbl/app_help.p
     1314       (input this-procedure :file-name
     1315       ,input ''
     1316       ,input ?
     1317       ) no-error.
     1318     if error-status :error then do:
     1319       message
     1320         "Ошибка при вызове помощи"
     1321         error-status :get-message(1)
     1322         view-as alert-box .
     1323     end.
     1324   end.
     1325   run minbtn-set in this-procedure .
     1326   on choose of b-help in frame Dialog-Frame
     1327   do:
     1328     apply "help":u to frame Dialog-Frame .
     1329   end.
     1330   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1331   procedure minbtn-set :
     1332       do
     1333           on error undo, return error return-value
     1334           :
     1335           define variable ii              as integer       no-undo .
     1336           define variable fh              as widget-handle no-undo .
     1337           define variable hh              as widget-handle no-undo .
     1338           define variable v-h             as handle        extent 4 no-undo .
     1339           define variable v-name-button   as character     no-undo .
     1340           define variable v-help-old-x    as decimal       no-undo .
     1341           define variable v-help-old-y    as decimal       no-undo .
     1342           define variable v-help-old-size as decimal       no-undo .
     1343           define variable v-frame-width   as decimal       no-undo .
     1344           define variable jj              as integer       no-undo .
     1345           do
     1346               on error undo, return error
     1347               :
     1348               assign
     1349                   v-frame-width = frame Dialog-Frame:width - 0.3
     1350                   fh            = frame Dialog-Frame:first-child
     1351                   hh            = fh:first-child
     1352                   ii            = 1
     1353                   .
     1354               do while valid-handle(hh):
     1355                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1356                   do:
     1357                       case lc(hh:name) :
     1358                           when "b-help" then
     1359                               do:
     1360                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1361                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1362                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1363                                   hh:TOOLTIP = "Помощь" .
     1364                                   v-help-old-x = hh:column .
     1365                                   v-help-old-y = hh:row    .
     1366                                   v-help-old-size = hh:width .
     1367                                   hh:width-chars = 2.5 .
     1368                               end.
     1369                           when "b-print" then
     1370                               do:
     1371                                   hh:load-image("cmp/b-print.bmp":u) .
     1372                                   hh:TOOLTIP = "Печать" .
     1373                                   v-h[ii] = hh:handle .
     1374                                   ii = ii + 1 .
     1375                                   hh:width-chars = 3 .
     1376                               end.
     1377                           when "b-history" or
     1378                           when "b-hist" then
     1379                               do:
     1380                                   hh:load-image("cmp/b-hist.bmp":u) .
     1381                                   hh:TOOLTIP = "История" .
     1382                                   v-h[ii] = hh:handle .
     1383                                   ii = ii + 1 .
     1384                                   hh:width-chars = 3 .
     1385                               end.
     1386                           when "b-sch" then
     1387                               do:
     1388                                   hh:load-image("cmp/b-sch.bmp":u) .
     1389                                   hh:TOOLTIP = "Установка Фильтра" .
     1390                                   v-h[ii] = hh:handle .
     1391                                   ii = ii + 1 .
     1392                                   hh:width-chars = 3 .
     1393                               end.
     1394                           when "b-hist-user" then
     1395                               do:
     1396                                   hh:load-image("cmp/b-hist.bmp":u) .
     1397                                   hh:TOOLTIP = "История пользователя" .
     1398                                   ii = ii + 1 .
     1399                               end.
     1400                       end case.
     1401                   end.
     1402                   hh = hh:next-sibling.
     1403               end.
     1404               b-help:column = v-frame-width - b-help:width-chars.
     1405               jj = 0.
     1406               repeat ii = 4 to 1 by -1 :
     1407                   if valid-handle (v-h[ii] ) then
     1408                   do:
     1409                       jj  = jj + 1 .
     1410                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1411                       v-h[ii]:row    = v-help-old-y .
     1412                   end.
     1413               end.
     1414           end.
     1415       end.
     1416   end procedure.
     1417   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1418   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1419   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1420   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1421   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1422   define variable v-diasize-current-frame-height as decimal   no-undo .
     1423   define variable v-diasize-change-size          as logical   no-undo .
     1424   define variable v-diasize-resize-button        as handle    no-undo .
     1425   define variable v-diasize-wndmax               as logical   no-undo .
     1426   define variable v-diasize-wndstore             as logical   no-undo .
     1427   define variable v-diasize-proc-name            as character no-undo .
     1428   define variable v-diasize-browse-handle        as handle    no-undo .
     1429   define variable v-diasize-browse-number        as integer   no-undo .
     1430   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1431   define temp-table temp-diasize-handle no-undo
     1432     field handle-value  as handle
     1433     field save-position as decimal
     1434     index xpk is primary unique handle-value
     1435     .
     1436   define temp-table temp-browse-handle no-undo
     1437     field browse-type   as character
     1438     field browse-number as integer
     1439     field browse-handle as handle
     1440     field original-size as decimal
     1441     index xpk is primary unique browse-type browse-number
     1442     index xie browse-type browse-handle
     1443   .
     1444   procedure diasize_change-height :
     1445     define input  parameter p-change-value  as decimal   no-undo .
     1446     define input  parameter p-move-resize   as logical   no-undo .
     1447     define variable v-field-group-handle    as handle    no-undo .
     1448     define variable v-object-handle         as handle    no-undo .
     1449     define variable v-frame-height          as decimal   no-undo .
     1450     define variable v-frame-virtual-height  as decimal   no-undo .
     1451     define variable v-browse-height         as decimal   no-undo .
     1452     define variable v-window-height         as decimal   no-undo .
     1453     define variable v-window-virtual-height as decimal   no-undo .
     1454     define variable v-change-sign           as integer   no-undo .
     1455     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1456     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1457     if p-change-value > 0
     1458     then do:
     1459       if frame Dialog-Frame :height + p-change-value
     1460           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1461       then do:
     1462         assign
     1463           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1464                           - (frame Dialog-Frame :height-chars)
     1465         .
     1466         if p-change-value <= 0
     1467         then do:
     1468           run diasize_position-resize-button in this-procedure .
     1469           return .
     1470         end.
     1471       end.
     1472     end.
     1473     if p-change-value < 0
     1474     then do:
     1475       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1476       then do:
     1477         assign
     1478           p-change-value = v-diasize-orig-frame-height
     1479                          - (frame Dialog-Frame :height-chars)
     1480         .
     1481         if p-change-value >= 0
     1482         then do:
     1483           run diasize_position-resize-button in this-procedure .
     1484           return .
     1485         end.
     1486       end.
     1487     end.
     1488     if p-change-value >= 0
     1489     then do:
     1490       assign
     1491         v-change-sign = 1
     1492       .
     1493     end.
     1494     else do:
     1495       assign
     1496         v-change-sign = -1
     1497       .
     1498     end.
     1499     assign
     1500       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1501     .
     1502     if p-change-value = 0
     1503     then do:
     1504       run diasize_position-resize-button in this-procedure .
     1505       return .
     1506     end.
     1507     move_block:
     1508     do
     1509     on error undo move_block, retry move_block
     1510     :
     1511       if retry
     1512       then do:
     1513         do
     1514         on error undo move_block, leave move_block
     1515         :
     1516           if p-change-value > 0
     1517           then do:
     1518             for each buf_temp-diasize-handle
     1519             on error undo, next
     1520             :
     1521               assign
     1522                 v-object-handle = buf_temp-diasize-handle.handle-value
     1523               .
     1524               if v-object-handle <> v-diasize-resize-button
     1525               then do:
     1526                 assign
     1527                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1528                 .
     1529               end.
     1530             end.
     1531             assign
     1532               v-diasize-browse-handle :height = v-browse-height
     1533             .
     1534             for each buf_temp-browse-handle
     1535               where buf_temp-browse-handle.browse-type = 'height':u
     1536             on error undo, next
     1537             :
     1538               assign
     1539                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1540               .
     1541             end.
     1542             assign
     1543               frame Dialog-Frame :height = v-frame-height
     1544             .
     1545             if frame Dialog-Frame :scrollable = true
     1546             then do:
     1547               assign
     1548                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1549               .
     1550             end.
     1551             run diasize_position-resize-button in this-procedure .
     1552           end.
     1553           else do:
     1554             if frame Dialog-Frame :scrollable = true
     1555             then do:
     1556               assign
     1557                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1558               .
     1559             end.
     1560             assign
     1561               frame Dialog-Frame :height = v-frame-height
     1562             .
     1563             assign
     1564               v-diasize-browse-handle :height = v-browse-height
     1565             .
     1566             for each buf_temp-browse-handle
     1567               where buf_temp-browse-handle.browse-type = 'height':u
     1568             on error undo, next
     1569             :
     1570               assign
     1571                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1572               .
     1573             end.
     1574             for each buf_temp-diasize-handle
     1575             on error undo, next
     1576             :
     1577               assign
     1578                 v-object-handle = buf_temp-diasize-handle.handle-value
     1579               .
     1580               if v-object-handle <> v-diasize-resize-button
     1581               then do:
     1582                 assign
     1583                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1584                 .
     1585               end.
     1586             end.
     1587             run diasize_position-resize-button in this-procedure .
     1588           end.
     1589           assign
     1590             v-diasize-change-size = false
     1591           .
     1592           leave move_block .
     1593         end.
     1594       end.
     1595       assign
     1596         v-diasize-need-full-display = true
     1597       .
     1598       if v-diasize-change-size = false
     1599       then do:
     1600         assign
     1601           v-diasize-change-size = true
     1602         .
     1603       end.
     1604       else do:
     1605         return .
     1606       end.
     1607       assign
     1608         v-frame-height = frame Dialog-Frame :height
     1609         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1610         v-browse-height = v-diasize-browse-handle :height
     1611       .
     1612       for each buf_temp-browse-handle
     1613         where buf_temp-browse-handle.browse-type = 'height':u
     1614       :
     1615         assign
     1616           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1617         .
     1618       end.
     1619       for each buf_temp-diasize-handle
     1620       :
     1621         delete buf_temp-diasize-handle .
     1622       end.
     1623       assign
     1624         v-field-group-handle = frame Dialog-Frame :first-child
     1625       .
     1626       do while valid-handle(v-field-group-handle)
     1627       :
     1628         assign
     1629           v-object-handle = v-field-group-handle :first-child
     1630         .
     1631         do while valid-handle(v-object-handle)
     1632         :
     1633           if  v-object-handle <> v-diasize-browse-handle :handle
     1634           and can-query(v-object-handle, "row")
     1635           and can-query(v-object-handle, "height")
     1636           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1637           then do:
     1638             find first buf_temp-browse-handle
     1639               where buf_temp-browse-handle.browse-type   = 'height':u
     1640                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1641               no-error .
     1642             if available buf_temp-browse-handle
     1643             then do:
     1644             end.
     1645             else do:
     1646               create buf_temp-diasize-handle .
     1647               assign
     1648                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1649                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1650               .
     1651             end.
     1652           end.
     1653           assign
     1654             v-object-handle = v-object-handle :next-sibling
     1655           .
     1656         end.
     1657         assign
     1658           v-field-group-handle = v-field-group-handle :next-sibling
     1659         .
     1660       end.
     1661       do with frame Dialog-Frame
     1662       :
     1663         hide v-diasize-resize-button .
     1664         assign
     1665           v-diasize-resize-button :row    = 1
     1666           v-diasize-resize-button :column = 1
     1667         .
     1668       end.
     1669       if p-change-value > 0
     1670       then do:
     1671         if frame Dialog-Frame :scrollable = true
     1672         then do:
     1673           assign
     1674             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1675             no-error .
     1676           if error-status :error
     1677           or error-status :get-message(1) <> ""
     1678           then do:
     1679             undo move_block, retry move_block .
     1680           end.
     1681         end.
     1682         assign
     1683           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1684           no-error .
     1685         if error-status :error
     1686         or error-status :get-message(1) <> ""
     1687         then do:
     1688           undo move_block, retry move_block .
     1689         end.
     1690         assign
     1691           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1692           no-error .
     1693         if error-status :error
     1694         or error-status :get-message(1) <> ""
     1695         then do:
     1696           undo move_block, retry move_block .
     1697         end.
     1698         for each buf_temp-browse-handle
     1699           where buf_temp-browse-handle.browse-type = 'height':u
     1700         on error undo move_block, retry move_block
     1701         :
     1702           assign
     1703             buf_temp-browse-handle.browse-handle :height
     1704               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1705             no-error .
     1706           if error-status :error
     1707           or error-status :get-message(1) <> ""
     1708           then do:
     1709             undo move_block, retry move_block .
     1710           end.
     1711         end.
     1712         for each buf_temp-diasize-handle
     1713         on error undo move_block, retry move_block
     1714         :
