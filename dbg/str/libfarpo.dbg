      230                                           rbfps_arh-fin-doc-an-obj.calc-curr-code     = bfps_arh-fin-doc-an-obj.calc-curr-code    and
      231                                           rbfps_arh-fin-doc-an-obj.sum-type           = bfps_arh-fin-doc-an-obj.sum-type          and
      232                                           rbfps_arh-fin-doc-an-obj.fact-order         > bfps_arh-fin-doc-an-obj.fact-order        use-index pi exclusive-lock on error undo, return error return-value :
      233     assign
      234       rbfps_arh-fin-doc-an-obj.expense     = rbfps_arh-fin-doc-an-obj.expense     + parsum-doc
      235       rbfps_arh-fin-doc-an-obj.expense-vat = rbfps_arh-fin-doc-an-obj.expense-vat + parsum-vat-doc
      236       rbfps_arh-fin-doc-an-obj.expense-slt = rbfps_arh-fin-doc-an-obj.expense-slt + parsum-slt-doc.
      237   end.
      238   if parmode = "close":u then do:
      239     find last bors_arh-fin-doc-an-obj where bors_arh-fin-doc-an-obj.host-code         = parhost-code            and
      240                                             bors_arh-fin-doc-an-obj.obj-type          = parobj-type             and
      241                                             bors_arh-fin-doc-an-obj.obj-code          = parobj-code             and
      242                                             bors_arh-fin-doc-an-obj.cli-type          = parreceiver-type        and
      243                                             bors_arh-fin-doc-an-obj.cli-code          = parreceiver-code        and
      244                                             bors_arh-fin-doc-an-obj.code-schet        = parreceiver-code-schet  and
      245                                             bors_arh-fin-doc-an-obj.fin-ext-doc-type  = parfin-ext-doc-type     and
      246                                             bors_arh-fin-doc-an-obj.fin-code-an-uchet = parfin-code-an-uchet    and
      247                                             bors_arh-fin-doc-an-obj.fin-code-cel-nazn = parfin-code-cel-nazn    and
      248                                             bors_arh-fin-doc-an-obj.fin-code-cor-acc  = parfin-code-cor-acc     and
      249                                             bors_arh-fin-doc-an-obj.calc-curr-code    = parcurr-code            and
      250                                             bors_arh-fin-doc-an-obj.sum-type          = parsum-type             and
      251                                             bors_arh-fin-doc-an-obj.fact-order        < parfact-order           use-index pi no-error.
      252       create bfrs_arh-fin-doc-an-obj.
      253     assign
      254       bfrs_arh-fin-doc-an-obj.host-code         = parhost-code
      255       bfrs_arh-fin-doc-an-obj.obj-type          = parobj-type
      256       bfrs_arh-fin-doc-an-obj.obj-code          = parobj-code
      257       bfrs_arh-fin-doc-an-obj.cli-type          = parreceiver-type
      258       bfrs_arh-fin-doc-an-obj.cli-code          = parreceiver-code
      259       bfrs_arh-fin-doc-an-obj.code-schet        = parreceiver-code-schet
      260       bfrs_arh-fin-doc-an-obj.fin-ext-doc-type  = parfin-ext-doc-type
      261       bfrs_arh-fin-doc-an-obj.fin-code-an-uchet = parfin-code-an-uchet
      262       bfrs_arh-fin-doc-an-obj.fin-code-cel-nazn = parfin-code-cel-nazn
      263       bfrs_arh-fin-doc-an-obj.fin-code-cor-acc  = parfin-code-cor-acc
      264       bfrs_arh-fin-doc-an-obj.calc-curr-code    = parcurr-code
      265       bfrs_arh-fin-doc-an-obj.sum-type          = parsum-type
      266       bfrs_arh-fin-doc-an-obj.cource-des        = "s":u
      267       bfrs_arh-fin-doc-an-obj.fact-order        = parfact-order
      268       bfrs_arh-fin-doc-an-obj.fin-doc-code      = parfin-doc-code
      269       bfrs_arh-fin-doc-an-obj.fact-date         = parfact-date
      270       bfrs_arh-fin-doc-an-obj.curr-code         = parcurr-code.
      271     assign
