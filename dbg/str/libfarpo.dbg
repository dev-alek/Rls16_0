      273       bfrs_arh-fin-doc-an-obj.expense-vat       = (if available bors_arh-fin-doc-an-obj then bors_arh-fin-doc-an-obj.expense-vat else 0)
      274       bfrs_arh-fin-doc-an-obj.expense-slt       = (if available bors_arh-fin-doc-an-obj then bors_arh-fin-doc-an-obj.expense-slt else 0)
      275       bfrs_arh-fin-doc-an-obj.income            = (if available bors_arh-fin-doc-an-obj then bors_arh-fin-doc-an-obj.income      else 0) + parsum-doc
      276       bfrs_arh-fin-doc-an-obj.income-vat        = (if available bors_arh-fin-doc-an-obj then bors_arh-fin-doc-an-obj.income-vat  else 0) + parsum-vat-doc
      277       bfrs_arh-fin-doc-an-obj.income-slt        = (if available bors_arh-fin-doc-an-obj then bors_arh-fin-doc-an-obj.income-slt  else 0) + parsum-slt-doc
      278     .
      279   end.
      280   else do:
      281     find first bfrs_arh-fin-doc-an-obj where bfrs_arh-fin-doc-an-obj.host-code         = parhost-code            and
      282                                              bfrs_arh-fin-doc-an-obj.obj-type          = parobj-type             and
      283                                              bfrs_arh-fin-doc-an-obj.obj-code          = parobj-code             and
      284                                              bfrs_arh-fin-doc-an-obj.cli-type          = parreceiver-type        and
