        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: defa58501af7, 2087, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: druban $":U .
        4   define variable vss-date        as character no-undo init "$Date: Wed Dec 25 15:23:51 2019 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: libfarpo.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/libfarpo.p $":U .
        7   define variable vss-description as character no-undo init "Внутренние процедуры для библиотеки по работы с финансовыми архивами по финдокументам (объекты)".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#libfarpo as handle no-undo .
       67   if valid-handle (g#libfarpo)
       68   and g#libfarpo <> this-procedure :handle
       69   and g#libfarpo :get-signature('libfarpo_calc-arh-fin-doc-an-obj':u) <> ""
       70   then do:
       71     message
       72       vss-workfile vss-revision vss-description skip
       73       "Попытка повторной загрузки внутренних процедур библиотеки для работы с финансовыми архивами по финансовым документам (объекты)" skip
       74       g#libfarpo skip
       75       g#libfarpo :type skip
       76       g#libfarpo :file-name skip
       77       valid-handle(g#libfarpo) skip
       78       this-procedure :handle skip
       79       this-procedure :type skip
       80       this-procedure :file-name skip
       81       valid-handle(this-procedure) skip
       82       view-as alert-box error .
       83     undo, return error .
       84   end.
       85   else do:
       86     assign
       87       g#libfarpo = this-procedure :handle
       88     .
       89   end.
       90   on delete of this-procedure do:
       91     assign
       92       g#libfarpo = ?
       93     .
       94   end.
       95   define stream str-err.
       96   procedure libfarpo_calc-arh-fin-doc-an-obj :
       97   define input parameter parmode                    as   character                   no-undo.
       98   define input parameter parhost-code               like ub.fin-doc.host-code        no-undo.
       99   define input parameter parobj-type                like ub.fin-doc.obj-type         no-undo.
      100   define input parameter parobj-code                like ub.fin-doc.obj-code         no-undo.
      101   define input parameter parpayer-type              like ub.fin-doc.payer-type       no-undo.
      102   define input parameter parpayer-code              like ub.fin-doc.payer-code       no-undo.
      103   define input parameter parreceiver-type           like ub.fin-doc.receiver-type    no-undo.
      104   define input parameter parreceiver-code           like ub.fin-doc.receiver-code    no-undo.
      105   define input parameter parpayer-code-schet        like ub.fin-schet.code-schet     no-undo.
      106   define input parameter parreceiver-code-schet     like ub.fin-schet.code-schet     no-undo.
      107   define input parameter parfin-ext-doc-type        like ub.fin-doc.fin-ext-doc-type no-undo.
      108   define input parameter parfin-code-an-uchet       like ub.fin-doc.an-uchet-code    no-undo.
      109   define input parameter parfin-code-cel-nazn       like ub.fin-doc.cel-nazn-code    no-undo.
      110   define input parameter parfin-code-cor-acc        like ub.fin-doc.cor-acc          no-undo.
      111   define input parameter parsum-type                as   character                   no-undo.
      112   define input parameter parfact-order              like ub.fin-doc.fact-order       no-undo.
      113   define input parameter parfin-doc-code            like ub.fin-doc.fin-doc-code     no-undo.
      114   define input parameter parfact-date               like ub.fin-doc.fact-date        no-undo.
      115   define input parameter parcurr-code               like ub.fin-doc.curr-code        no-undo.
      116   define input parameter parbase-code               like ub.sysconf.base-code        no-undo.
      117   define input parameter parcurr-dog-code           like ub.contract.curr-code       no-undo.
      118   define input parameter parrel-dog-code            as   logical                     no-undo.
      119   define input parameter parsum-doc                 as   decimal                     no-undo.
      120   define input parameter parsum-rubl                as   decimal                     no-undo.
      121   define input parameter parsum-base                as   decimal                     no-undo.
      122   define input parameter parsum-contr               as   decimal                     no-undo.
      123   define input parameter parsum-vat-doc             as   decimal                     no-undo.
      124   define input parameter parsum-vat-rubl            as   decimal                     no-undo.
      125   define input parameter parsum-vat-base            as   decimal                     no-undo.
      126   define input parameter parsum-vat-contr           as   decimal                     no-undo.
      127   define input parameter parsum-slt-doc             as   decimal                     no-undo.
      128   define input parameter parsum-slt-rubl            as   decimal                     no-undo.
      129   define input parameter parsum-slt-base            as   decimal                     no-undo.
      130   define input parameter parsum-slt-contr           as   decimal                     no-undo.
      131   define buffer bfps_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      132   define buffer bfrs_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      133   define buffer rbfps_arh-fin-doc-an-obj for ub.arh-fin-doc-an-obj.
      134   define buffer rbfrs_arh-fin-doc-an-obj for ub.arh-fin-doc-an-obj.
      135   define buffer bops_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      136   define buffer bors_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      137   define buffer bdps_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      138   define buffer bdrs_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      139   define buffer bfpr_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      140   define buffer bfrr_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      141   define buffer rbfpr_arh-fin-doc-an-obj for ub.arh-fin-doc-an-obj.
      142   define buffer rbfrr_arh-fin-doc-an-obj for ub.arh-fin-doc-an-obj.
      143   define buffer bopr_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      144   define buffer borr_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      145   define buffer bdpr_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      146   define buffer bdrr_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      147   define buffer bfpb_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      148   define buffer bfrb_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      149   define buffer rbfpb_arh-fin-doc-an-obj for ub.arh-fin-doc-an-obj.
      150   define buffer rbfrb_arh-fin-doc-an-obj for ub.arh-fin-doc-an-obj.
      151   define buffer bopb_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      152   define buffer borb_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      153   define buffer bdpb_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      154   define buffer bdrb_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      155   define buffer bfpc_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      156   define buffer bfrc_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      157   define buffer rbfpc_arh-fin-doc-an-obj for ub.arh-fin-doc-an-obj.
      158   define buffer rbfrc_arh-fin-doc-an-obj for ub.arh-fin-doc-an-obj.
      159   define buffer bopc_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      160   define buffer borc_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      161   define buffer bdpc_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      162   define buffer bdrc_arh-fin-doc-an-obj  for ub.arh-fin-doc-an-obj.
      163   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      164   if parmode = "close":u then do:
      165     find last bops_arh-fin-doc-an-obj where bops_arh-fin-doc-an-obj.host-code         = parhost-code         and
      166                                             bops_arh-fin-doc-an-obj.cli-type          = parpayer-type        and
      167                                             bops_arh-fin-doc-an-obj.cli-code          = parpayer-code        and
      168                                             bops_arh-fin-doc-an-obj.obj-type          = parobj-type          and
      169                                             bops_arh-fin-doc-an-obj.obj-code          = parobj-code          and
      170                                             bops_arh-fin-doc-an-obj.code-schet        = parpayer-code-schet  and
      171                                             bops_arh-fin-doc-an-obj.fin-ext-doc-type  = parfin-ext-doc-type  and
      172                                             bops_arh-fin-doc-an-obj.fin-code-an-uchet = parfin-code-an-uchet and
      173                                             bops_arh-fin-doc-an-obj.fin-code-cel-nazn = parfin-code-cel-nazn and
      174                                             bops_arh-fin-doc-an-obj.fin-code-cor-acc  = parfin-code-cor-acc  and
      175                                             bops_arh-fin-doc-an-obj.calc-curr-code    = parcurr-code         and
      176                                             bops_arh-fin-doc-an-obj.sum-type          = parsum-type          and
      177                                             bops_arh-fin-doc-an-obj.fact-order        < parfact-order        use-index pi no-error.
      178     create bfps_arh-fin-doc-an-obj.
      179     assign
      180       bfps_arh-fin-doc-an-obj.host-code         = parhost-code
      181       bfps_arh-fin-doc-an-obj.obj-type          = parobj-type
      182       bfps_arh-fin-doc-an-obj.obj-code          = parobj-code
      183       bfps_arh-fin-doc-an-obj.cli-type          = parpayer-type
      184       bfps_arh-fin-doc-an-obj.cli-code          = parpayer-code
      185       bfps_arh-fin-doc-an-obj.code-schet        = parpayer-code-schet
      186       bfps_arh-fin-doc-an-obj.fin-ext-doc-type  = parfin-ext-doc-type
      187       bfps_arh-fin-doc-an-obj.fin-code-an-uchet = parfin-code-an-uchet
      188       bfps_arh-fin-doc-an-obj.fin-code-cel-nazn = parfin-code-cel-nazn
      189       bfps_arh-fin-doc-an-obj.fin-code-cor-acc  = parfin-code-cor-acc
      190       bfps_arh-fin-doc-an-obj.calc-curr-code    = parcurr-code
      191       bfps_arh-fin-doc-an-obj.sum-type          = parsum-type
      192       bfps_arh-fin-doc-an-obj.cource-des        = "s":u
      193       bfps_arh-fin-doc-an-obj.fact-order        = parfact-order
      194       bfps_arh-fin-doc-an-obj.fin-doc-code      = parfin-doc-code
      195       bfps_arh-fin-doc-an-obj.fact-date         = parfact-date
      196       bfps_arh-fin-doc-an-obj.curr-code         = parcurr-code
      197       bfps_arh-fin-doc-an-obj.income            = (if available bops_arh-fin-doc-an-obj then bops_arh-fin-doc-an-obj.income      else 0)
      198       bfps_arh-fin-doc-an-obj.income-vat        = (if available bops_arh-fin-doc-an-obj then bops_arh-fin-doc-an-obj.income-vat  else 0)
      199       bfps_arh-fin-doc-an-obj.income-slt        = (if available bops_arh-fin-doc-an-obj then bops_arh-fin-doc-an-obj.income-slt  else 0)
      200       bfps_arh-fin-doc-an-obj.expense           = (if available bops_arh-fin-doc-an-obj then bops_arh-fin-doc-an-obj.expense     else 0) + parsum-doc
      201       bfps_arh-fin-doc-an-obj.expense-vat       = (if available bops_arh-fin-doc-an-obj then bops_arh-fin-doc-an-obj.expense-vat else 0) + parsum-vat-doc
      202       bfps_arh-fin-doc-an-obj.expense-slt       = (if available bops_arh-fin-doc-an-obj then bops_arh-fin-doc-an-obj.expense-slt else 0) + parsum-slt-doc
      203     .
      204   end.
      205   else do:
      206     find first bfps_arh-fin-doc-an-obj where bfps_arh-fin-doc-an-obj.host-code         = parhost-code         and
      207                                              bfps_arh-fin-doc-an-obj.obj-type          = parobj-type          and
      208                                              bfps_arh-fin-doc-an-obj.obj-code          = parobj-code          and
      209                                              bfps_arh-fin-doc-an-obj.cli-type          = parpayer-type        and
      210                                              bfps_arh-fin-doc-an-obj.cli-code          = parpayer-code        and
      211                                              bfps_arh-fin-doc-an-obj.code-schet        = parpayer-code-schet  and
      212                                              bfps_arh-fin-doc-an-obj.fin-ext-doc-type  = parfin-ext-doc-type  and
      213                                              bfps_arh-fin-doc-an-obj.fin-code-an-uchet = parfin-code-an-uchet and
      214                                              bfps_arh-fin-doc-an-obj.fin-code-cel-nazn = parfin-code-cel-nazn and
      215                                              bfps_arh-fin-doc-an-obj.fin-code-cor-acc  = parfin-code-cor-acc  and
      216                                              bfps_arh-fin-doc-an-obj.calc-curr-code    = parcurr-code         and
      217                                              bfps_arh-fin-doc-an-obj.sum-type          = parsum-type          and
      218                                              bfps_arh-fin-doc-an-obj.fact-order        = parfact-order        exclusive-lock.
      219   end.
      220   for each rbfps_arh-fin-doc-an-obj where rbfps_arh-fin-doc-an-obj.host-code          = bfps_arh-fin-doc-an-obj.host-code         and
      221                                           rbfps_arh-fin-doc-an-obj.obj-type           = bfps_arh-fin-doc-an-obj.obj-type          and
      222                                           rbfps_arh-fin-doc-an-obj.obj-code           = bfps_arh-fin-doc-an-obj.obj-code          and
      223                                           rbfps_arh-fin-doc-an-obj.cli-type           = parpayer-type                             and
      224                                           rbfps_arh-fin-doc-an-obj.cli-code           = parpayer-code                             and
      225                                           rbfps_arh-fin-doc-an-obj.code-schet         = bfps_arh-fin-doc-an-obj.code-schet        and
      226                                           rbfps_arh-fin-doc-an-obj.fin-ext-doc-type   = bfps_arh-fin-doc-an-obj.fin-ext-doc-type  and
      227                                           rbfps_arh-fin-doc-an-obj.fin-code-an-uchet  = bfps_arh-fin-doc-an-obj.fin-code-an-uchet and
      228                                           rbfps_arh-fin-doc-an-obj.fin-code-cel-nazn  = bfps_arh-fin-doc-an-obj.fin-code-cel-nazn and
