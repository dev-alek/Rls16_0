        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle no-undo .
        3   define input parameter p-inkas-code     like ub.inkas.inkas-code no-undo .
        4   define input parameter p-close-mode     as character no-undo .
        5   define input parameter p-status_        as character no-undo .
        6   define input parameter p-flag_          as logical no-undo .
        7   define input parameter p-silent                       as logical no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: salestat.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: str/salestat.p $":U .
       13   define variable vss-description as character no-undo init "Перевод статусов для продажи".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define new global shared variable g#trdcalib as handle no-undo.
       85   define variable v-pre-status_ as character no-undo .
       86   define variable v-pre-flag_   as logical no-undo .
       87   define variable v-status_ as character no-undo .
       88   define variable v-flag_   as logical   no-undo .
       89   define variable v-ask-message as character no-undo .
       90   define variable v-correct as logical no-undo .
       91   define variable v-mess as character no-undo .
       92   define buffer buf_inkas for ub.inkas.
       93   define buffer buf_trn-doc for ub.trn-doc.
       94   define buffer buf_sale-doc for ub.sale-doc.
       95   _main:
       96   do
       97   on error undo, return error return-value
       98   on stop undo, return error return-value
       99   :
      100     find first buf_inkas exclusive-lock where
      101               buf_inkas.inkas-code = p-inkas-code .
      102     find first buf_trn-doc exclusive-lock where
      103                 buf_trn-doc.doc-code = p-inkas-code  .
      104     run str/salegraf.p (
      105                      input  buf_inkas.inkas-code
      106                     ,input  p-close-mode
      107                     ,input  buf_inkas.status_
      108                     ,input  buf_trn-doc.flag_
      109                     ,output v-status_
      110                     ,output v-flag_
      111                     ,output v-ask-message
      112                     ) no-error.
      113     if error-status:error
      114     then do:
      115       run err-mess ( substitute("Ошибка при проверке возможности открытия/закрытия:&1&2 &3"
      116                     ,  chr(10)
      117                     , error-status:get-message(1)
      118                     , return-value
      119                     )
      120                     , output v-mess).
      121       undo _main, return error v-mess.
      122     end.
      123     if v-status_ <> p-status_
      124     or v-flag_ <> p-flag_
      125     then do:
      126       run err-mess ( substitute("Невозможно открыть/закрыть продажу до запрашиваемого статуса &1&2&3&4"
      127                     , p-status_
      128                     , string(p-flag_, "+/-")
      129                     ,  chr(10)
      130                     , return-value
      131                     )
      132                     , output v-mess).
      133       undo _main, return error v-mess.
      134     end.
      135     if p-status_ = 'факт':U then do:
      136       run err-mess ( substitute( "Неверный вызов процедуры - для статуса &1",   p-status_), output v-mess).
      137       undo _main, return error v-mess.
      138     end.
      139     if p-close-mode <> '<закрытие документа на факт>':U then do:
      140       assign
      141       v-pre-status_ = buf_inkas.status_
      142       v-pre-flag_   = buf_inkas.flag_
      143       .
      144       assign
      145       buf_inkas.status_ = p-status_
      146       buf_inkas.flag_ = p-flag_
      147       .
      148       for each buf_sale-doc where
      149               buf_sale-doc.inkas-code = p-inkas-code
      150           and buf_sale-doc.order > 0,
      151       first buf_trn-doc exclusive-lock where
      152           buf_trn-doc.doc-code = buf_sale-doc.doc-code
      153       by buf_sale-doc.order
      154       on error undo _main, return  error return-value
      155       on stop undo _main, return  error return-value :
      156         assign
      157         buf_trn-doc.flag_ = p-flag_
      158         .
      159         release buf_trn-doc no-error .
      160         if error-status:error then do:
      161           run err-mess (substitute("Ошибка при смене статуса на &1&2&3&4 &5"
      162                                   , p-status_
      163                                   , p-flag_
      164                                   , chr(10)
      165                                   , error-status:get-message(1)
      166                                   , return-value
      167                                   ), output v-mess).
      168           undo _main, return error v-mess.
      169         end.
      170       end.
      171       release buf_inkas no-error .
      172       if error-status:error then do:
      173         run err-mess (substitute("Ошибка при смене статуса на &1&2&3&4 &5"
      174                                 , p-status_
      175                                 , p-flag_
      176                                 , chr(10)
      177                                 , error-status:get-message(1)
      178                                 , return-value
      179                                 ), output v-mess).
      180         undo _main, return error v-mess.
      181       end.
      182     end.
      183     else do:
      184     end.
      185   end.
      186   PROCEDURE err-mess:
      187     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      188     define output parameter p-mess2 as character no-undo .
      189     assign
      190     p-mess2 = substitute("ПРОДАЖА &1: &2&3&4&5"
      191                         , buf_inkas.inkas-code
      192                         , buf_inkas.obj-type
      193                         , buf_inkas.obj-code
      194                         , chr(10)
      195                         , p-mess
      196                         ).
      197    if not p-silent then do:
      198       message
      199       p-mess2
      200       view-as alert-box error .
      201    end.
      202   END PROCEDURE.
