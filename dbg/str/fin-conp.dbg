        1   define input        parameter p-max as decimal   no-undo .
        2   define input-output parameter p-sum as decimal   no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Связка фин. обязательств с платежами".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   procedure proc-alt-shift-f2:
       64     if not ibs.th.gbl.gbl-var:rcode
       65   then
       66     run gbl\inidebug.p .
       67   end.
       68   procedure proc-alt-shift-f3:
       69     run gbl/prvssinf.p
       70       ( input this-procedure
       71       ) .
       72   end.
       73   define variable v-inform-launched as logical no-undo initial false .
       74   procedure proc-alt-shift-f4:
       75     define variable v-action as character no-undo .
       76     if v-inform-launched = false then do:
       77       assign
       78         v-inform-launched = true
       79       .
       80       run gbl/d-inform.w
       81         (  input self
       82         ,  input this-procedure
       83         , output v-action
       84         ) no-error .
       85       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       86       assign
       87         v-inform-launched = false
       88       .
       89     end.
       90   end.
       91   procedure proc-alt-f1:
       92     run gbl/corrhelp.p
       93       (input this-procedure
       94       ) .
       95   end .
       96   on alt-shift-f2 anywhere do:
       97     run proc-alt-shift-f2.
       98   end.
       99   on alt-shift-f3 anywhere do:
      100     run proc-alt-shift-f3 in this-procedure .
      101   end.
      102   on alt-shift-f4 anywhere do:
      103     run proc-alt-shift-f4 in this-procedure.
      104   end.
      105   on alt-f1 anywhere do:
      106     run proc-alt-f1 in this-procedure .
      107   end.
      108   DEFINE BUTTON b-exit AUTO-GO
      109        LABEL "&Ввод"
      110        SIZE 10 BY 1
      111        BGCOLOR 8 .
      112   DEFINE BUTTON b-help
      113        LABEL "Помо&щь"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-quit AUTO-END-KEY
      117        LABEL "&Отмена"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE VARIABLE sum AS DECIMAL FORMAT "->,>>>,>>>,>>>,>>9.99":U INITIAL 0
      121        LABEL "Сумма"
      122        VIEW-AS FILL-IN
      123        SIZE 30 BY 1 NO-UNDO.
      124   DEFINE FRAME Dialog-Frame
      125        b-exit AT ROW 1 COL 1
      126        b-quit AT ROW 1 COL 11
      127        b-help AT ROW 1 COL 29.88
      128        sum AT ROW 2.25 COL 7 COLON-ALIGNED
      129        SPACE(0.87) SKIP(0.49)
      130       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      131            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      132            TITLE "Изменение суммы связи".
      133   ASSIGN
      134          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      135          FRAME Dialog-Frame:HIDDEN           = TRUE.
      136   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      137   DO:
      138     APPLY "END-ERROR":U TO SELF.
      139   END.
      140   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      141   DO:
      142     assign sum .
      143     if sum > 0 and p-max > 0 and sum > p-max then do:
      144       message "Сумма связки не может превышать несвязанный остаток!"  view-as alert-box.
      145       assign sum = p-max .
      146       DISPLAY sum WITH FRAME Dialog-Frame.
      147       return no-apply.
      148     end.
      149     assign p-sum = sum .
      150   END.
      151   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   on help of frame Dialog-Frame
      153   do:
      154     run gbl/app_help.p
      155       (input this-procedure :file-name
      156       ,input ''
      157       ,input ?
      158       ) no-error.
      159     if error-status :error then do:
      160       message
      161         "Ошибка при вызове помощи"
      162         error-status :get-message(1)
      163         view-as alert-box .
      164     end.
      165   end.
      166   run minbtn-set in this-procedure .
      167   on choose of b-help in frame Dialog-Frame
      168   do:
      169     apply "help":u to frame Dialog-Frame .
      170   end.
      171   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   procedure minbtn-set :
      173       do
      174           on error undo, return error return-value
      175           :
      176           define variable ii              as integer       no-undo .
      177           define variable fh              as widget-handle no-undo .
      178           define variable hh              as widget-handle no-undo .
      179           define variable v-h             as handle        extent 4 no-undo .
      180           define variable v-name-button   as character     no-undo .
      181           define variable v-help-old-x    as decimal       no-undo .
      182           define variable v-help-old-y    as decimal       no-undo .
      183           define variable v-help-old-size as decimal       no-undo .
      184           define variable v-frame-width   as decimal       no-undo .
      185           define variable jj              as integer       no-undo .
      186           do
      187               on error undo, return error
      188               :
      189               assign
      190                   v-frame-width = frame Dialog-Frame:width - 0.3
      191                   fh            = frame Dialog-Frame:first-child
      192                   hh            = fh:first-child
      193                   ii            = 1
      194                   .
      195               do while valid-handle(hh):
      196                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      197                   do:
      198                       case lc(hh:name) :
      199                           when "b-help" then
      200                               do:
      201                                   hh:load-image-up("cmp/b-help.bmp":u) .
      202                                   hh:load-image-down("cmp/b-help.bmp":u) .
      203                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      204                                   hh:TOOLTIP = "Помощь" .
      205                                   v-help-old-x = hh:column .
      206                                   v-help-old-y = hh:row    .
      207                                   v-help-old-size = hh:width .
      208                                   hh:width-chars = 2.5 .
      209                               end.
      210                           when "b-print" then
      211                               do:
      212                                   hh:load-image("cmp/b-print.bmp":u) .
      213                                   hh:TOOLTIP = "Печать" .
      214                                   v-h[ii] = hh:handle .
      215                                   ii = ii + 1 .
      216                                   hh:width-chars = 3 .
      217                               end.
      218                           when "b-history" or
      219                           when "b-hist" then
      220                               do:
      221                                   hh:load-image("cmp/b-hist.bmp":u) .
      222                                   hh:TOOLTIP = "История" .
      223                                   v-h[ii] = hh:handle .
      224                                   ii = ii + 1 .
      225                                   hh:width-chars = 3 .
      226                               end.
      227                           when "b-sch" then
      228                               do:
      229                                   hh:load-image("cmp/b-sch.bmp":u) .
      230                                   hh:TOOLTIP = "Установка Фильтра" .
      231                                   v-h[ii] = hh:handle .
      232                                   ii = ii + 1 .
      233                                   hh:width-chars = 3 .
      234                               end.
      235                           when "b-hist-user" then
      236                               do:
      237                                   hh:load-image("cmp/b-hist.bmp":u) .
      238                                   hh:TOOLTIP = "История пользователя" .
      239                                   ii = ii + 1 .
      240                               end.
      241                       end case.
      242                   end.
      243                   hh = hh:next-sibling.
      244               end.
      245               b-help:column = v-frame-width - b-help:width-chars.
      246               jj = 0.
      247               repeat ii = 4 to 1 by -1 :
      248                   if valid-handle (v-h[ii] ) then
      249                   do:
      250                       jj  = jj + 1 .
      251                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      252                       v-h[ii]:row    = v-help-old-y .
      253                   end.
      254               end.
      255           end.
      256       end.
      257   end procedure.
      258   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      259   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      260   MAIN-BLOCK:
      261   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      262      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      263     assign sum = p-sum .
      264     RUN enable_UI.
      265     WAIT-FOR GO OF FRAME Dialog-Frame.
      266   END.
      267   RUN disable_UI.
      268   PROCEDURE disable_UI :
      269     HIDE FRAME Dialog-Frame.
      270   END PROCEDURE.
      271   PROCEDURE enable_UI :
      272     DISPLAY sum
      273         WITH FRAME Dialog-Frame.
      274     ENABLE b-exit b-quit b-help sum
      275         WITH FRAME Dialog-Frame.
      276     VIEW FRAME Dialog-Frame.
      277   END PROCEDURE.
