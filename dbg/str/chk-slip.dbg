        1   define input parameter p-db-num as integer no-undo .
        2   define input parameter p-ID as character no-undo .
        3   define input parameter p-CheckId as character no-undo .
        4   define input parameter p-RRN as character no-undo .
        5   DEFINE BUTTON b-exit AUTO-END-KEY
        6        LABEL "Выход"
        7        SIZE 15 BY 1.14
        8        BGCOLOR 8 .
        9   DEFINE BUTTON b-print
       10        LABEL "Сохранить в файл"
       11        SIZE 17 BY 1.14
       12        BGCOLOR 8 .
       13   define query br-chk-slip-string for chk-slip-string scrolling .
       14   define browse br-chk-slip-string
       15     query br-chk-slip-string display
       16     chk-slip-string.str-value format "X(70)"
       17   WITH no-separators no-labels no-row-markers SIZE 70 BY 26 FIT-LAST-COLUMN.
       18   DEFINE FRAME Dialog-Frame
       19        b-exit AT ROW 1.1 COL 2
       20        b-print AT ROW 1.1 COL 17 WIDGET-ID 2
       21        br-chk-slip-string at row 2.3 col 2
       22        SPACE(1) SKIP(1)
       23       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       24            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       25            TITLE "Отчет"
       26            CANCEL-BUTTON b-exit WIDGET-ID 100.
       27   ASSIGN
       28          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       29          FRAME Dialog-Frame:HIDDEN           = TRUE.
       30   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       31   DO:
       32     APPLY "END-ERROR":U TO SELF.
       33   END.
       34   ON CHOOSE OF b-print IN FRAME Dialog-Frame
       35   DO:
       36     run str/chk-slip-print.p (input p-db-num,
       37                               input p-ID,
       38                               input p-CheckID,
       39                               input p-RRN,
       40                               input "one")
       41                               .
       42   END.
       43   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       44   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       45   MAIN-BLOCK:
       46   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       47      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       48     RUN enable_UI.
       49     open query br-chk-slip-string for each chk-slip-string no-lock where chk-slip-string.db-num = p-db-num
       50                                                                      and chk-slip-string.ID = p-ID
       51                                                                      and chk-slip-string.CheckID = p-CheckId
       52                                                                      and chk-slip-string.RRN = p-RRN
       53                                                                      and chk-slip-string.str-num < 10000
       54                                                                      by chk-slip-string.str-num
       55                                                                      .
       56     WAIT-FOR GO OF FRAME Dialog-Frame.
       57   END.
       58   RUN disable_UI.
       59   PROCEDURE disable_UI :
       60     HIDE FRAME Dialog-Frame.
       61   END PROCEDURE.
       62   PROCEDURE enable_UI :
       63     ENABLE b-exit b-print br-chk-slip-string
       64         WITH FRAME Dialog-Frame.
       65     VIEW FRAME Dialog-Frame.
       66   END PROCEDURE.
