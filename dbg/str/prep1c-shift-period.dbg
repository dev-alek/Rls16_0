        1   block-level on error undo, throw.
        2   define temp-table tt-pl-gds no-undo
        3     field pl-code like ub.place.pl-code
        4     field loc1 like ub.place.loc1
        5     field gds-code like ub.goods.gds-code
        6     field num-pri-periods as integer
        7   .
        8   define input parameter parparentproc as widget-handle no-undo .
        9   define input parameter p-obj-type like ub.shift-obj.obj-type no-undo .
       10   define input parameter p-obj-code like ub.shift-obj.obj-code no-undo .
       11   define input parameter p-shift-date like ub.shift-obj.shift-date no-undo .
       12   define input parameter p-shift-num like ub.shift-obj.shift-num no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision:$":U .
       14   define variable vss-author      as character no-undo init "$Author:$":U .
       15   define variable vss-date        as character no-undo init "$Date:$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       17   define variable vss-archive     as character no-undo init "$Archive:$":U .
       18   define variable vss-description as character no-undo init "".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define buffer buf_place for ub.place .
       74   define buffer buf_shift-obj for ub.shift-obj .
       75   define buffer buf_shift-period for ub.shift-period .
       76   define variable expData as memptr no-undo .
       77   define variable log-file-name as character no-undo initial "shift-period.log" .
       78   define variable v-pid as int64 no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   procedure cur-time :
       85      define output parameter p-today as date      no-undo .
       86      define output parameter p-time  as integer   no-undo .
       87     do
       88     on error undo, return error
       89     :
       90       define variable v-date1 as date      no-undo .
       91       define variable v-date2 as date      no-undo .
       92       define variable v-time  as integer   no-undo .
       93       assign
       94         v-date1 = today
       95         v-time  = time
       96         v-date2 = today
       97       .
       98       if v-date1 <> v-date2
       99       then do:
      100         assign
      101           v-date1 = today
      102           v-time  = v-time
      103         .
      104       end.
      105       assign
      106         p-today = v-date1
      107         p-time  = v-time
      108       .
      109     end.
      110   end.
      111   function cur-time-date returns character
      112   :
      113     return string(today, '99/99/9999':U) .
      114   end.
      115   function cur-time-mjd returns decimal
      116   :
      117     define variable v-date as date      no-undo .
      118     define variable v-time as integer   no-undo .
      119     run cur-time in this-procedure
      120       (output v-date
      121       ,output v-time
      122       ) .
      123     return integer(v-date) - 2400002 + (v-time / 86400) .
      124   end.
      125   function cur-time-get-ending-index returns integer
      126   (input p-number as integer
      127   )
      128   :
      129     if p-number < 0
      130     or p-number = ?
      131     then do:
      132       return 1 .
      133     end.
      134     define variable v-rest as integer   no-undo .
      135     assign
      136       p-number = p-number modulo 100
      137     .
      138     if p-number < 20
      139     then do:
      140       assign
      141         v-rest = p-number
      142       .
      143     end.
      144     else do:
      145       assign
      146         v-rest = p-number modulo 10
      147       .
      148     end.
      149     case v-rest :
      150       when 1
      151       then do:
      152         return 2 .
      153       end.
      154       when 2 or
      155       when 3 or
      156       when 4
      157       then do:
      158         return 3 .
      159       end.
      160       otherwise do:
      161         return 1 .
      162       end.
      163     end case .
      164   end.
      165   procedure cur-time-mjd-to-date :
      166      define input  parameter i-mjd-diff as decimal no-undo.
      167      define output parameter o-Date     as date    no-undo.
      168      define output parameter o-Time     as integer no-undo.
      169      define variable v-day-number as integer   no-undo .
      170      if    i-mjd-diff < 0
      171         or i-mjd-diff = ?
      172      then do:
      173         return "?" .
      174      end.
      175      assign
      176         v-day-number = truncate(i-mjd-diff,0).
      177         o-Date = date(v-day-number + 2400002).
      178         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      179     .
      180   end.
      181   function cur-time-mjd-to-string returns character
      182   (input p-mjd-diff as decimal
      183   )
      184   :
      185     define variable v-day-number as integer   no-undo .
      186     define variable v-seconds    as integer   no-undo .
      187     define variable v-hour       as integer   no-undo .
      188     define variable v-min        as integer   no-undo .
      189     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      190     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      191     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      192     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      193     if p-mjd-diff < 0
      194     or p-mjd-diff = ?
      195     then do:
      196       return "?" .
      197     end.
      198     assign
      199       v-day-number = integer(truncate(p-mjd-diff,0))
      200       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      201     .
      202     if v-seconds > 86400
      203     then do:
      204       assign
      205         v-seconds = 86400 - 1
      206       .
      207     end.
      208     if v-seconds < 0
      209     then do:
      210       assign
      211         v-seconds = 0
      212       .
      213     end.
      214     assign
      215       v-hour = truncate(v-seconds / 3600, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 3600
      219     .
      220     assign
      221       v-min = truncate(v-seconds / 60, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 60
      225     .
      226     return
      227         (if v-day-number <> 0
      228           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0
      232           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      236           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      237           else ""
      238         )
      239       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      240       .
      241   end.
      242   function cur-time-string returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      251   end.
      252   function cur-time-string-sec returns character
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      261   end.
      262   function cur-time-custom  returns character
      263   (input p-prefix as character
      264   ,input p-date-format as character
      265   ,input p-delimiter as character
      266   ,input p-time-format as character
      267   ,input p-suffix as character
      268   )
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return
      277       p-prefix
      278       + string(v-date, p-date-format)
      279       + p-delimiter
      280       + string(v-time, p-time-format)
      281       + p-suffix
      282       .
      283   end.
      284   function cur-time-print  returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      293   end.
      294   function cur-time-datetime returns datetime
      295   :
      296     define variable v-char as character no-undo .
      297     define variable v-datetime as datetime no-undo .
      298     v-char = cur-time-string().
      299     v-datetime = datetime(v-char).
      300     return  v-datetime.
      301   end.
      302   function cur-time-string-msec returns character
      303   :
      304     define variable v-date as datetime  no-undo .
      305     v-date = now.
      306     return string(v-date) .
      307   end.
      308   function string-mth returns character
      309     (inValue as decimal)
      310   :
      311     def var v-str as character no-undo.
      312     def var v-stt as decimal   no-undo.
      313     if inValue = ?  then v-str = "0".
      314     if inValue < 0 then
      315     do:
      316       v-stt = inValue .
      317       inValue = abs(v-stt).
      318     end.
      319     if string (inValue) begins "."
      320       then v-str = "0" + string (inValue).
      321     else v-str = string (inValue).
      322     if v-stt <> 0 then v-str = "-" + v-str.
      323     return v-str.
      324   end.
      325   find first buf_shift-obj no-lock where buf_shift-obj.obj-type = p-obj-type
      326                                      and buf_shift-obj.obj-code = p-obj-code
      327                                      and buf_shift-obj.shift-date = p-shift-date
      328                                      and buf_shift-obj.shift-num = p-shift-num
      329                                      no-error .
      330   if not available buf_shift-obj
      331   then do :
      332     return .
      333   end .
      334   for each buf_shift-period no-lock where buf_shift-period.obj-type = buf_shift-obj.obj-type
      335                                       and buf_shift-period.obj-code = buf_shift-obj.obj-code
      336                                       and buf_shift-period.shift-date = buf_shift-obj.shift-date
      337                                       and buf_shift-period.shift-num = buf_shift-obj.shift-num,
      338     first buf_place no-lock where buf_place.pl-code = buf_shift-period.pl-code
      339   :
      340     find first tt-pl-gds where tt-pl-gds.pl-code = buf_shift-period.pl-code
      341                            and tt-pl-gds.gds-code = buf_shift-period.gds-code
      342                            no-error .
      343     if not available tt-pl-gds
      344     then do :
      345       create tt-pl-gds .
      346       assign
      347         tt-pl-gds.pl-code = buf_shift-period.pl-code
      348         tt-pl-gds.loc1 = buf_place.loc1
      349         tt-pl-gds.gds-code = buf_shift-period.gds-code
      350         tt-pl-gds.num-pri-periods = 0
      351       .
      352     end .
      353     if buf_shift-period.period-type = 4
      354     then do :
      355       assign tt-pl-gds.num-pri-periods = tt-pl-gds.num-pri-periods + 1 .
      356     end .
      357   end .
      358   run create-esys-data .
      359   run exp1C .
      360   procedure create-esys-data :
      361     define variable sw as handle no-undo.
      362     define variable ii as integer no-undo .
      363     define variable v-num-pri-periods as integer no-undo .
      364     define variable v-period as character no-undo .
      365     define variable v-doc-code as character no-undo .
      366     create sax-writer sw.
      367     sw:set-output-destination ("memptr", expData).
      368     sw:encoding = "UTF-8".
      369     sw:fragment = true .
      370     sw:formatted = true .
      371     sw:start-document () .
      372       sw:start-element ("shift-period") .
      373         sw:write-data-element ("shift-date", iso-date(buf_shift-obj.shift-date)).
      374         sw:write-data-element ("shift-num", string(buf_shift-obj.shift-num)).
      375         sw:start-element ("tanks") .
      376           for each tt-pl-gds :
      377             assign v-num-pri-periods = 0 .
      378             sw:start-element ("tank") .
      379               sw:write-data-element ("tank-num", string(tt-pl-gds.loc1)) .
      380               sw:write-data-element ("gd-code", string(tt-pl-gds.gds-code)) .
      381               sw:start-element ("section-periods") .
      382                 for each buf_shift-period no-lock where buf_shift-period.obj-type = buf_shift-obj.obj-type
      383                                                     and buf_shift-period.obj-code = buf_shift-obj.obj-code
      384                                                     and buf_shift-period.shift-date = buf_shift-obj.shift-date
      385                                                     and buf_shift-period.shift-num = buf_shift-obj.shift-num
      386                                                     and buf_shift-period.gds-code = tt-pl-gds.gds-code
      387                                                     and buf_shift-period.pl-code = tt-pl-gds.pl-code
      388                                                     by buf_shift-period.period-num
      389                 :
      390                   sw:start-element ("section-period") .
      391                     assign v-period = string(buf_shift-period.period-type) .
      392                     if buf_shift-period.period-type = 4
      393                     and tt-pl-gds.num-pri-periods > 1
      394                     then do :
      395                       assign
      396                         v-num-pri-periods = v-num-pri-periods + 1
      397                         v-period = string(buf_shift-period.period-type) + "." + string(v-num-pri-periods)
      398                       .
      399                     end .
      400                     sw:write-data-element ("period", v-period) .
      401                     if buf_shift-period.period-type = 0
      402                     or buf_shift-period.period-type = 1
      403                     then do :
      404                       sw:write-data-element ("initializ", string(1)) .
      405                     end .
      406                     if buf_shift-period.period-type = 1
      407                     or buf_shift-period.period-type = 3
      408                     then do :
      409                       assign
      410                         v-doc-code = entry(2, buf_shift-period.period-name, "№")
      411                         v-doc-code = entry(1, v-doc-code, ")")
      412                       .
      413                       sw:write-data-element ("before-invoice", v-doc-code) .
      414                     end .
      415                     if buf_shift-period.period-type = 4
      416                     then do :
      417                       assign
      418                         v-doc-code = entry(2, buf_shift-period.period-name, "№")
      419                         v-doc-code = entry(1, v-doc-code, ")")
      420                       .
      421                       sw:write-data-element ("from-invoice", v-doc-code) .
      422                       assign
      423                         v-doc-code = entry(3, buf_shift-period.period-name, "№")
      424                         v-doc-code = entry(1, v-doc-code, ")")
      425                       .
      426                       sw:write-data-element ("before-invoice", v-doc-code) .
      427                     end .
      428                     if buf_shift-period.period-type = 5
      429                     then do :
      430                       assign
      431                         v-doc-code = entry(2, buf_shift-period.period-name, "№")
      432                         v-doc-code = entry(1, v-doc-code, ")")
      433                       .
      434                       sw:write-data-element ("from-invoice", v-doc-code) .
      435                     end .
      436                     sw:write-data-element ("contrl-dnst", string-mth(round(buf_shift-period.control-density, 4))) .
      437                     sw:write-data-element ("implem15-dnst", string-mth(round(buf_shift-period.sales-density15, 4))) .
      438                     sw:write-data-element ("delta-dnst", string-mth(round(buf_shift-period.delta-density, 4))) .
      439                   sw:end-element ("section-period") .
      440                 end .
      441               sw:end-element ("section-periods") .
      442             sw:end-element ("tank") .
      443           end .
      444         sw:end-element ("tanks") .
      445       sw:end-element ("shift-period") .
      446     sw:end-document () .
      447   end procedure .
      448   procedure exp1C :
      449     run str/send1C-some-data.p (input parparentproc,
      450                                 input this-procedure,
      451                                 input this-procedure,
      452                                 input expData,
      453                                 input "shift-periods" + chr(4) + substitute("shift-obj&1&2",chr(3),string(rowid(buf_shift-obj))) )
      454                                 no-error .
      455     if error-status:error
      456     then do :
      457       run write-to-log( "Ошибка при отправке в 1С. " + return-value ).
      458     end .
      459   end procedure .
      460   procedure write-to-log :
      461     define input param p-str as character no-undo .
      462     assign
      463       p-str = substitute( "&3&1&3&2&3", cur-time-string(), p-str, chr(10) )
      464     .
      465     output to value(log-file-name) append .
      466     put unformatted p-str .
      467     output close .
      468   end procedure .
      469   procedure write-log-and-file :
      470     define input parameter p-tab-position   as integer   no-undo.
      471     define input parameter p-file-name      as character no-undo .
      472     define input parameter p-log-level      as integer   no-undo .
      473     define input parameter p-log-string     AS CHARacter NO-UNDO.
      474     define variable v-jj as integer   no-undo .
      475     run write-to-log (input p-log-string) .
      476   end procedure .
