        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        4   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        5   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        6   define input parameter interface as logical no-undo.
        7   define input parameter from-doc as logical no-undo.
        8   define input parameter par-rid as recid no-undo.
        9   define output parameter v-notes  as character no-undo .
       10   define output parameter not-all-doced as logical init no.
       11   define output parameter not-all-normal as logical init no.
       12   define output parameter not-all-closed as logical no-undo init no.
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: chk-winf.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: str/chk-winf.p $":U .
       18   define variable vss-description as character no-undo init "".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define new global shared variable g#lib-trn  as handle no-undo .
       81   define new global shared variable g#lib-trn2 as handle no-undo .
       82   define new global shared variable g#lib-trn3 as handle no-undo .
       83   define new global shared variable g#lib-trn4 as handle no-undo .
       84   function shift-name-no-err return char (
       85                                           buffer loc-wth-doc for ub.wth-doc
       86    ).
       87   define variable varshift-name as character no-undo.
       88   define variable varshift-name-num as character no-undo.
       89     varshift-name = loc-wth-doc.shift-name.
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnme in g#lib-trn3 ( input  loc-wth-doc.obj-type,
       92                          input  loc-wth-doc.obj-code,
       93                          input  loc-wth-doc.shift-date,
       94                          input  loc-wth-doc.shift-num,
       95                          input-output varshift-name,
       96                          output varshift-name-num
       97                          ) no-error .
       98     if error-status:error then do:
       99       return "":u.
      100     end.
      101     return varshift-name-num.
      102   end function.
      103   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104     define variable v-cntxt-db-num        as integer   no-undo .
      105     define variable v-cntxt-userid        as character no-undo .
      106     define variable v-cntxt-level         as character no-undo .
      107     define variable v-cntxt-host-code-obj as integer   no-undo .
      108     define variable v-cntxt-obj-type      as character no-undo .
      109     define variable v-cntxt-obj-code      as integer   no-undo .
      110     define variable v-cntxt-db-num-obj    as integer   no-undo .
      111     define variable v-cntxt-is-admin      as logical   no-undo .
      112   DEFINE VARIABLE doc as logical init no.
      113   DEFINE VARIABLE not-doced-ch as char no-undo.
      114   DEFINE VARIABLE not-doced-err-ch as char no-undo.
      115   DEFINE VARIABLE doc-ch as char no-undo.
      116   DEFINE VARIABLE cas-shft as logical no-undo init no.
      117   DEFINE VARIABLE l-shift-on as logical no-undo init no.
      118   define variable chk-inf as logical no-undo init yes.
      119   define variable v-shift-str as character no-undo .
      120   define variable v-param-type as character no-undo .
      121   define variable v-value-character as character no-undo .
      122   define variable v-value-date as date no-undo .
      123   define variable v-value-decimal as decimal no-undo .
      124   define variable v-value-integer as INTEGER no-undo .
      125   define variable v-value-logical AS LOGICAL no-undo .
      126   define variable v-tth as handle no-undo .
      127   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define variable v-waitfram-action01         as character   no-undo .
      129   define variable v-waitfram-action02         as character   no-undo .
      130   define variable v-waitfram-action03         as character   no-undo .
      131   define variable mWaitFramTextBeg            as character   no-undo.
      132   define variable mWaitFramTextEnd            as character   no-undo.
      133   define variable mWaitFramView               as logical     no-undo.
      134   define variable mWaitProcEvent              as logical     no-undo init yes.
      135   define variable mWaitFramInterval           as integer     no-undo init 1 .
      136   define variable mWaitFramStop               as logical     no-undo.
      137   define variable mWaitFramStopUser           as logical     no-undo.
      138   define variable mWaitFramStopTimeOut        as logical     no-undo.
      139   define variable mWaitFramStartProc          as datetime-tz no-undo.
      140   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      141   define button B-WaitFramStop auto-end-key
      142        label "Стоп"
      143        size 10 by 1 tooltip "Остоновить процесс".
      144   define button B-viewProcInfo
      145        label "Информация"
      146        size 15 by 1 tooltip "Информация о процесс".
      147   define frame waitfram
      148     v-waitfram-action01 format "x(72)" no-label skip
      149     v-waitfram-action02 format "x(72)" no-label skip
      150     v-waitfram-action03 format "x(72)" no-label skip
      151     B-viewProcInfo
      152     B-WaitFramStop at row 4 col 30
      153     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      154     .
      155   define new global shared variable mBatchMode as logical no-undo init ?.
      156   define variable mFramBachModHandle as handle no-undo.
      157   mFramBachModHandle = frame waitfram:handle.
      158   define variable mFameOldVis as logical no-undo.
      159   define variable mVisCUrentVin as logical no-undo.
      160   if session:batch-mode
      161   then
      162      mBatchMode = yes.
      163   if mBatchMode = ? then do:
      164     mVisCUrentVin = current-window:visible.
      165     mFameOldVis = mFramBachModHandle:visible.
      166     mFramBachModHandle:visible  = yes.
      167     mBatchMode = mFramBachModHandle:visible ne yes.
      168     mFramBachModHandle:visible = mFameOldVis.
      169     current-window:visible = mVisCUrentVin.
      170   end.
      171    if  log-manager:logfile-name ne ?
      172     then DO:
      173         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      174         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      175         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      176     end.
      177   on choose of B-WaitFramStop in frame waitfram
      178   do:
      179     mWaitFramStop = yes.
      180     mWaitFramStopUser = yes.
      181   end.
      182   function waitfram-check-timeout returns logical():
      183      define variable vtime as int64 no-undo.
      184      if mWaitFramStopTimeOut
      185      then
      186         return yes.
      187      vtime = ( now - mWaitFramStartProc ) / 1000 .
      188      if     mWaitFramTimeOut ne ?
      189         and mWaitFramTimeOut ne 0
      190         and mWaitFramTimeOut lt vtime
      191      then do:
      192         mWaitFramStopTimeOut = yes.
      193      end.
      194      return mWaitFramStopTimeOut.
      195   end.
      196   procedure waitfram-hide :
      197     if not session:batch-mode
      198     then do
      199     on error undo, return error return-value
      200     :
      201       pause 0 before-hide .
      202       if not mBatchMode then
      203         hide frame waitfram .
      204     if     not mWaitFramView
      205        and mWaitProcEvent
      206     then
      207       process events .
      208     end.
      209   end procedure.
      210   procedure waitfram-show :
      211     define input  parameter p-message as character no-undo .
      212     define variable v-left-margin as integer   no-undo .
      213     if not session:batch-mode
      214     then do
      215     on error undo, return error return-value
      216     :
      217       if length(p-message) <= 70 then do:
      218         assign
      219           v-left-margin = integer((70 - length(p-message)) / 2)
      220         .
      221         assign
      222           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      223         .
      224         assign
      225           v-waitfram-action01 = " "
      226           v-waitfram-action02 = " "
      227                                    + fill(" ", v-left-margin)
      228                                    + p-message
      229           v-waitfram-action03 = " "
      230         .
      231       end.
      232       else do:
      233         define variable vRindex1 as integer no-undo.
      234         define variable vRindex2 as integer no-undo.
      235         vRindex1 = r-index(p-message," ",70).
      236         if vRindex1 = 0
      237         then
      238            vRindex1 = 70.
      239         if length(p-message)  <= vRindex1 + 70 then do:
      240           assign
      241             v-waitfram-action01 = " "
      242             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      243             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      244           .
      245         end.
      246         else do:
      247           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      248           if vRindex2 <= vRindex1
      249           then
      250              vRindex2 = vRindex1 + 70.
      251           assign
      252             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      253             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      254             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      255           .
      256         end.
      257       end.
      258       B-viewProcInfo:visible   in frame waitfram = no.
      259       B-viewProcInfo:sensitive in frame waitfram = no.
      260       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      262       if  (   mWaitFramView
      263          or  mWaitProcEvent)
      264          and not mBatchMode
      265       then
      266          display
      267             v-waitfram-action01 skip
      268             v-waitfram-action02 skip
      269             v-waitfram-action03 skip
      270          with frame waitfram .
      271       if     mWaitFramView
      272          then do:
      273             if     mWaitFramInterval ne ?
      274                and not mBatchMode
      275             then
      276                wait-for go of frame waitfram pause mWaitFramInterval.
      277          end.
      278          else
      279             if     mWaitProcEvent
      280                and not mBatchMode
      281             then
      282                process events .
      283     end.
      284   end procedure.
      285      procedure waitfram-show-this:
      286         define input  parameter iInterval as int64 no-undo.
      287         define variable vtime as int64 no-undo.
      288         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      289         mWaitFramInterval = iInterval.
      290         run waitfram-show (substitute("&1&2 &3&4" ,
      291                                       mWaitFramTextBeg ,
      292                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      293                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      294                                       mWaitFramTextEnd
      295                                      )
      296                           ).
      297      end.
      298      procedure WaitFramRunPause:
      299         define input  parameter iInterval as dec no-undo.
      300         define variable vStart  as datetime-tz no-undo.
      301         define variable vend    as datetime-tz no-undo.
      302         define variable vint as int64 no-undo.
      303         define variable vOk as logical no-undo.
      304         vStart = now.
      305         vend   = vStart.
      306         publish "WaitFramPause" (iInterval,output vOk).
      307         vend   =  now.
      308         vint = vend - vStart.
      309         vint = iInterval - vint / 1000.
      310         if     not mWaitFramStop
      311            and (   vint > 0
      312                 or (    not vOk
      313                     and iInterval eq ?
      314                     )
      315                 )
      316         then
      317            run waitfram-show-this (iInterval).
      318         vend   =  now.
      319         vint = vend - vStart.
      320         vint = iInterval - vint / 1000.
      321         if     not mWaitFramStop
      322            and vint > 0
      323         then do:
      324            run gbl/pause.p (vint * 1000).
      325         end.
      326         if iInterval ne ?
      327         then
      328            publish "WaitFramStop".
      329         waitfram-check-timeout().
      330      end.
      331      procedure WaitFramWaitFor:
      332         define input  parameter iInterval as dec no-undo.
      333         assign
      334            mWaitFramStartProc   = now
      335            mWaitFramStopUser    = no
      336            mWaitFramStopTimeOut = no
      337         .
      338         block-wait:
      339         do while not mWaitFramStop:
      340            run WaitFramRunPause (iInterval).
      341            if  waitfram-check-timeout()
      342            then do:
      343               leave block-wait.
      344            end.
      345         end.
      346         run waitfram-hide.
      347      end.
      348   procedure waitfram-join :
      349     define input  parameter p-line-1  as character no-undo .
      350     define input  parameter p-line-2  as character no-undo .
      351     define input  parameter p-line-3  as character no-undo .
      352     define output parameter p-message as character no-undo .
      353     do
      354     on error undo, return error return-value
      355     :
      356       assign
      357         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      359                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      360       .
      361     end.
      362   end procedure.
      363   function waitfram-join-function returns character
      364     (input p-line-1 as character
      365     ,input p-line-2 as character
      366     ,input p-line-3 as character
      367     ).
      368     define variable v-message as character no-undo .
      369     run waitfram-join in this-procedure
      370       (input  p-line-1
      371       ,input  p-line-2
      372       ,input  p-line-3
      373       ,output v-message
      374       ) .
      375     return v-message .
      376   end function .
      377   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378     run mainmenu_getcntxt in parparentproc
      379       (output v-cntxt-db-num
      380       ,output v-cntxt-userid
      381       ,output v-cntxt-level
      382       ,output v-cntxt-host-code-obj
      383       ,output v-cntxt-obj-type
      384       ,output v-cntxt-obj-code
      385       ,output v-cntxt-db-num-obj
      386       ,output v-cntxt-is-admin
