      391                 "№ БД объекта &2, № текущей БД &3"
      392                 , chr(10)
      393                 , v-cntxt-db-num-obj
      394                 , v-cntxt-db-num)
      395     view-as alert-box error .
      396     return.
      397   end.
      398   run adm/shattri.p (
      399       input "get":U
      400       ,input  p-curr-obj-type
      401       ,input  p-curr-obj-code
      402       ,input  'chk-view':U
      403       ,input  'chk-inf':U
      404       ,output v-value-character
      405       ,output v-value-date
      406       ,output v-value-decimal
      407       ,output v-value-integer
      408       ,output v-value-logical
      409       ,output v-param-type
      410       ,INPUT-OUTPUT table-handle v-tth
      411       ) no-error .
      412   IF not error-status:error then
      413   assign
      414   chk-inf = v-value-logical.
      415   delete object v-tth.
      416   if not chk-inf and not interface and not from-doc then return.
      417   run waitfram-show in this-procedure ("Поиск ошибочных и неучтенных чеков. ЖДИТЕ...").
      418   v-notes = "".
      419   if from-doc then do:
      420     FIND FIRST ub.wth-doc No-LOCK WHERE recid(ub.wth-doc) = par-rid.
      421   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      422   define variable v-param-type5 as character no-undo .
      423   define variable v-value-character5 as character no-undo .
      424   define variable v-value-date5 as date no-undo .
      425   define variable v-value-decimal5 as decimal no-undo .
      426   define variable v-value-integer5 as INTEGER no-undo .
      427   define variable v-tth5 as handle no-undo .
      428   run adm/shattri.p (
      429       input "get":U
      430       ,input  p-curr-obj-type
      431       ,input  p-curr-obj-code
      432       ,input  'get-chk':U
      433       ,input  'cas-shft':U
      434       ,output v-value-character5
      435       ,output v-value-date5
      436       ,output v-value-decimal5
      437       ,output v-value-integer5
      438       ,output cas-shft
      439       ,output v-param-type5
      440       ,INPUT-OUTPUT table-handle v-tth5
      441       )  .
      442   delete object v-tth5.
      443   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      444   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      445     (input  p-curr-obj-type
      446     ,input  p-curr-obj-code
      447     ,input  'shift-on=request'
      448     ,output l-shift-on
      449     )  .
      450   end.
      451   cas-shft = cas-shft OR l-shift-on.
      452   if from-doc then do:
      453     assign
      454     v-shift-str = substitute("&1 &2"
      455                             , string(ub.wth-doc.doc-date, "99/99/9999")
      456                             , (if cas-shft
      457                                then (" СМЕНА № " + shift-name-no-err(buffer wth-doc))
      458                                else  "") ).
      459     assign
      460     not-doced-ch = substitute("НЕУЧТЕННЫХ ЧЕКОВ МЦ ЗА &1 НЕТ&2"
      461                               ,v-shift-str
      462                               ,chr(10))
      463     not-doced-err-ch = substitute("ОШИБОЧНЫX чеков МЦ ЗА &1 НЕТ&2"
      464                                  ,v-shift-str
      465                                  ,chr(10))
      466     doc-ch = "Нет НЕЗАКРЫТЫХ автодокументов МЦ " + chr(10)
      467     .
      468     if chk-inf then do:
      469       For each  ub.chk-doc where
      470                 ub.chk-doc.obj-type = p-curr-obj-type and
      471                 ub.chk-doc.obj-code = p-curr-obj-code and
      472                 ub.chk-doc.out-code = '':U
      473       by ub.chk-doc.shift-date descending
      474       by ub.chk-doc.chk-time descending
      475       :
      476         if lookup(string(chk-doc.chk-type), '2,3,4,5,7':U) = 0 then next.
      477         if ((NOT cas-shft)  AND chk-doc.shift-date = wth-doc.doc-date) OR
      478             ( cas-shft AND
      479               chk-doc.shift-date = wth-doc.shift-date AND
      480               chk-doc.shift-num = wth-doc.shift-num)
      481         then do:
      482           assign
      483           not-doced-ch = substitute("Есть НЕУЧТЕННЫЙ чек МЦ за : &1&2"
      484                                      ,string(chk-doc.shift-date, "99/99/9999")
      485                                      ,chr(10)).
      486           not-all-doced = yes.
      487         end.
      488         if NOT chk-doc.correct then do:
      489           assign
      490           not-doced-err-ch = substitute("Есть ОШИБОЧНЫЙ чек МЦ за : &1&2&2"
      491                                         ,string(chk-doc.shift-date, "99/99/9999")
      492                                         ,chr(10)).
      493           not-all-normal = yes.
      494         end.
      495       end.
      496     end.
      497   end.
      498   else do:
      499   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      500   define variable v-param-type7 as character no-undo .
      501   define variable v-value-character7 as character no-undo .
      502   define variable v-value-date7 as date no-undo .
      503   define variable v-value-decimal7 as decimal no-undo .
      504   define variable v-value-integer7 as INTEGER no-undo .
      505   define variable v-tth7 as handle no-undo .
      506   run adm/shattri.p (
      507       input "get":U
      508       ,input  p-curr-obj-type
      509       ,input  p-curr-obj-code
      510       ,input  'get-chk':U
      511       ,input  'cas-shft':U
      512       ,output v-value-character7
      513       ,output v-value-date7
      514       ,output v-value-decimal7
      515       ,output v-value-integer7
      516       ,output cas-shft
      517       ,output v-param-type7
      518       ,INPUT-OUTPUT table-handle v-tth7
      519       )  .
      520   delete object v-tth7.
      521   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      522   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      523     (input  p-curr-obj-type
      524     ,input  p-curr-obj-code
      525     ,input  'shift-on=request'
      526     ,output l-shift-on
      527     )  .
      528    cas-shft = cas-shft OR l-shift-on.
      529    define variable v-status-list as character no-undo .
      530    define variable v-ii as integer no-undo .
      531     v-status-list = 'накл':U + chr(4) + 'разрешен':U.
      532     _do:
      533     do v-ii = 1 to num-entries(v-status-list, chr(4)):
      534       _for:
      535       for each ub.wth-doc No-LOCK WHERE
      536               ub.wth-doc.host-code = p-curr-host-code
      537           and ub.wth-doc.obj-type = p-curr-obj-type
      538           AND ub.wth-doc.obj-code = p-curr-obj-code
      539           AND ub.wth-doc.status_ = entry(v-ii, v-status-list, chr(4) )
      540           AND ub.wth-doc.auto-fill = yes
      541       by ub.wth-doc.host-code
      542       by ub.wth-doc.obj-type
      543       by ub.wth-doc.obj-code
      544       by ub.wth-doc.status_
      545       by ub.wth-doc.fact-order descending:
      546         if not not-all-closed then do:
      547       not-all-closed = yes.
      548           leave _for.
      549         end.
      550     END.
      551       if not-all-closed then leave _do.
      552     end.
      553     assign
      554     not-doced-ch = "НЕУЧТЕННЫХ ЧЕКОВ МЦ НЕТ" + chr(10)
      555     not-doced-err-ch =   "ОШИБОЧНЫX чеков НЕТ " + chr(10)
      556     doc-ch = "Нет НЕЗАКРЫТЫХ автодокументов МЦ" + chr(10)
      557     .
      558     For each  ub.chk-doc no-lock  where
      559               ub.chk-doc.obj-type = p-curr-obj-type AND
      560               ub.chk-doc.obj-code = p-curr-obj-code AND
      561               ub.chk-doc.out-code = '':U
      562     by ub.chk-doc.chk-date
      563     by ub.chk-doc.chk-time
      564     :
      565       if lookup(string(ub.chk-doc.chk-type), '2,3,4,5,7':U) = 0 then next.
      566       if NOT not-all-doced  AND
      567         (
      568           NOT not-all-closed OR
      569           (NOT cas-shft AND
      570             (  (not-all-closed AND ub.chk-doc.shift-date = ub.wth-doc.doc-date) OR
      571                 not-all-closed
      572             )
      573           )  OR
      574           (cas-shft AND (not-all-closed AND wth-doc.shift-date = chk-doc.shift-date)
      575           )
      576         ) then do:
      577         assign
      578         not-all-doced = yes
      579         not-doced-ch =  substitute("Самый старый НЕУЧТЕННЫЙ чек МЦ за : &1&2"
      580                                    ,string(chk-doc.shift-date, "99/99/9999")
      581                                    ,chr(10)).
      582       end.
      583       if NOT not-all-normal AND chk-doc.correct = no then do:
      584         assign
      585         not-all-normal = yes
      586         not-doced-err-ch = substitute("Самый старый ОШИБОЧНЫЙ чек МЦ за : &1&2&2"
      587                                       ,string(chk-doc.shift-date, "99/99/9999")
      588                                       ,chr(10)).
      589       end.
      590     end.
      591   end.
      592   for each wth-doc No-LOCK WHERE
      593            wth-doc.obj-type = p-curr-obj-type AND
      594            wth-doc.obj-code = p-curr-obj-code AND
      595            wth-doc.auto-fill = yes AND
      596            wth-doc.status_ = 'факт':U
      597   by wth-doc.doc-date descending:
      598     doc = yes.
      599     doc-ch = substitute("Дата последнего закрытого автодокумента МЦ : &1&2&2"
      600                         ,string (wth-doc.fact-date, "99/99/9999")
      601                         ,chr(10)).
      602     LEAVE.
      603   end.
      604   v-notes = v-notes + not-doced-ch +
      605           (if not-all-normal then not-doced-err-ch else "") +
      606           doc-ch.
      607   run waitfram-hide in this-procedure .
      608   if interface then
      609   run gbl/showtext.p (
      610                    input "Неучтенные и ошибочные чеки МЦ, последние закрытые автодокументы МЦ"
      611                   ,input 60
      612                   ,input 15
      613                   ,input v-notes
      614                   ).
