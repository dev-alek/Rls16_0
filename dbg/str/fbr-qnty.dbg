     4891                       and buf_fbr-recipe-gds.recipe-code  = buf_fbr-recipe.recipe-code
     4892                       and buf_fbr-recipe-gds.artic        = buf_ingr_fbr-line.artic
     4893                       and buf_fbr-recipe-gds.prod-type    = buf_ingr_fbr-line.prod-type
     4894                       and buf_fbr-recipe-gds.prod-code    = buf_ingr_fbr-line.prod-code)
     4895           then delete
