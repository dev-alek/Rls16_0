     1223   procedure fbrlib_get-default-pay-code :
     1224   define input parameter p-obj-type   as character        no-undo.
     1225   define input parameter p-obj-code   as integer          no-undo.
     1226   define output parameter p-pay-code  as integer          no-undo.
     1227   define variable v-host-code as integer no-undo .
     1228   define buffer buf_shop          for ub.shop.
     1229   define buffer buf_store         for ub.store.
     1230   define buffer buf_sysconf       for ub.sysconf.
     1231   do
     1232   for buf_shop
     1233     , buf_store
     1234     , buf_sysconf
     1235   on error undo, return error
     1236   :
     1237     case p-obj-type  :
     1238       when 'маг':U then do:
     1239           find first buf_shop no-lock
     1240                 where buf_shop.obj-code = p-obj-code
     1241           no-error.
     1242           if available buf_shop
     1243           then do:
     1244               assign
     1245                   p-pay-code = buf_shop.fbr-pay
     1246               .
     1247           end.
     1248       end.
     1249       when 'скл':U then do:
     1250           find first buf_store no-lock
     1251                 where buf_store.obj-code = p-obj-code
     1252           no-error.
     1253           if available buf_store
     1254           then do:
     1255               assign
     1256                   p-pay-code = buf_store.fbr-pay
     1257               .
     1258           end.
     1259       end.
     1260     end case.
     1261     if p-pay-code = ?
     1262     or p-pay-code = 0
     1263     then do:
     1264   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1265   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1266     (input  p-obj-type
     1267     ,input  p-obj-code
     1268     ,output v-host-code
     1269     )  .
     1270         find first buf_sysconf no-lock
     1271               where buf_sysconf.host-code = v-host-code
     1272         no-error.
     1273         if available buf_sysconf
     1274         then do:
     1275             assign
     1276                 p-pay-code = buf_sysconf.fbr-pay
     1277             .
     1278         end.
     1279     end.
     1280     if p-pay-code = ?
     1281     or p-pay-code = 0
     1282     then do:
     1283   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1284   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1285     (input  p-obj-type
     1286     ,input  p-obj-code
     1287     ,output p-pay-code
     1288     )  .
     1289     end.
     1290   end.
     1291   end procedure.
     1292   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1293   do
     1294   on error undo, return error
     1295   :
     1296   define input parameter p-fbr-doc-code as character    no-undo.
     1297       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1298       define variable v-gds-name      as character    no-undo.
     1299       define buffer buf_fbr-doc               for ub.fbr-doc.
     1300       define buffer buf_fbr-line              for ub.fbr-line.
     1301       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1302       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1303       find first buf_fbr-doc no-lock
     1304            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1305       .
     1306       for each buf_temp_fbrlib_recipe
     1307       :
     1308           delete buf_temp_fbrlib_recipe.
     1309       end.
     1310       for each buf_fbr-line no-lock
     1311          where buf_fbr-line.doc-code = p-fbr-doc-code
     1312       :
     1313           find first buf_temp_fbrlib_recipe
     1314                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1315           no-error.
     1316           if not available buf_temp_fbrlib_recipe
     1317           then do:
     1318               create buf_temp_fbrlib_recipe.
     1319               assign
     1320                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1321                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1322               .
     1323           end.
     1324       end.
     1325       for each buf_temp_fbrlib_recipe
     1326       :
     1327           assign
     1328               buf_temp_fbrlib_recipe.count-income                = 0
     1329               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1330               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1331               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1332               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1333               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1334               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1335               buf_temp_fbrlib_recipe.count-write-off             = 0
     1336               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1337               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1338               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1339               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1340               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1341               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1342           .
     1343           for each buf_fbr-line no-lock
     1344              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1345                and buf_fbr-line.trn-type     = 'при':U
     1346                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1347           :
     1348               if ( buf_fbr-line.price-base   = ?
     1349                   or buf_fbr-line.price-rubl = ?
     1350                   or buf_fbr-line.price-base <= 0
     1351                   or buf_fbr-line.price-rubl <= 0 )
     1352               and buf_fbr-line.fact-qnty <> 0
     1353               and buf_fbr-line.rsrv-qnty <> ?
     1354               and buf_fbr-doc.is-free    = no
     1355               then do:
     1356   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1358     (input  buf_fbr-line.artic
     1359     ,input  buf_fbr-line.prod-type
     1360     ,input  buf_fbr-line.prod-code
     1361     ,output v-gds-name
     1362     ) no-error .
     1363                   if error-status :error
     1364                   then do:
     1365                       assign
     1366                           v-gds-name = ""
     1367                       .
     1368                   end.
     1369                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1370                                                 ,vss-description
     1371                                                 ,buf_fbr-doc.doc-code
     1372                                                 ,chr(10)
     1373                                                 ,buf_fbr-line.recipe-code
     1374                                                 ,buf_fbr-line.artic
     1375                                                 ,v-gds-name).
     1376               end.
     1377               assign
     1378                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1379                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1380                                                                   + buf_fbr-line.fact-qnty
     1381                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1382                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1383               .
     1384               if buf_fbr-line.is-waste = no
     1385               then do:
     1386                   assign
     1387                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1388                                                                       + buf_fbr-line.price-sum-base
     1389                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1390                                                                       + buf_fbr-line.price-sum-rubl
     1391                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1392                                                                       + buf_fbr-line.price-sum-vat-base
     1393                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1394                                                                       + buf_fbr-line.price-sum-vat-rubl
     1395                   .
     1396               end.
     1397           end.
     1398           for each buf_fbr-line no-lock
     1399              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1400                and buf_fbr-line.trn-type     = 'спи':U
     1401                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1402           :
     1403               if ( buf_fbr-line.price-base   = ?
     1404                   or buf_fbr-line.price-rubl = ?
     1405                   or buf_fbr-line.price-base <= 0
     1406                   or buf_fbr-line.price-rubl <= 0 )
     1407               and buf_fbr-line.fact-qnty <> 0
     1408               and buf_fbr-line.rsrv-qnty <> ?
     1409               and buf_fbr-doc.is-free    = no
     1410               and buf_fbr-doc.status_    = 'разрешен':U
     1411               then do:
     1412   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1413   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1414     (input  buf_fbr-line.artic
     1415     ,input  buf_fbr-line.prod-type
     1416     ,input  buf_fbr-line.prod-code
     1417     ,output v-gds-name
     1418     ) no-error .
     1419                   if error-status :error
     1420                   then do:
     1421                       assign
     1422                           v-gds-name = ""
     1423                       .
     1424                   end.
     1425                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1426                                                 ,vss-description
     1427                                                 ,buf_fbr-doc.doc-code
     1428                                                 ,chr(10)
     1429                                                 ,buf_fbr-line.recipe-code
     1430                                                 ,buf_fbr-line.artic
     1431                                                 ,v-gds-name).
     1432               end.
     1433               assign
     1434                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1435                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1436                                                                   + buf_fbr-line.fact-qnty
     1437                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1438                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1439               .
     1440               if buf_fbr-line.is-waste = no
     1441               then do:
     1442                   assign
     1443                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1444                                                                       + buf_fbr-line.price-sum-base
     1445                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1446                                                                       + buf_fbr-line.price-sum-rubl
     1447                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1448                                                                       + buf_fbr-line.price-sum-vat-base
     1449                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1450                                                                       + buf_fbr-line.price-sum-vat-rubl
     1451                   .
     1452               end.
     1453           end.
     1454           if buf_fbr-doc.status_    = 'разрешен':U
     1455           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1456           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1457           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1458           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1459               )
     1460           then do:
     1461            undo, return error
     1462               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1463                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1464                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1465                           "Сумма в &9.&4&7&4&4&8&2"
     1466                          , buf_fbr-doc.doc-code
     1467                          , chr(10)
     1468                          , buf_temp_fbrlib_recipe.recipe-code
     1469                          , chr(9)
     1470                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1471                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1472                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1473                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1474                          , "руб"
     1475                          )
     1476              +
     1477              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     1478                         "НДС в &7.&1&5&1&1&6&4"
     1479                        ,  chr(9)
     1480                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1481                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1482                        ,chr(10)
     1483                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1484                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1485                        ,"руб"
     1486                        )       .
     1487           end.
     1488       end.
     1489   end.
     1490   end procedure.
     1491   procedure fbrlib-fill-sum-fbr-doc :
     1492   do
     1493   on error undo, return error
     1494   :
     1495   define input parameter p-fbr-doc-recid  as recid        no-undo.
     1496   define input parameter p-mode           as character    no-undo.
     1497       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     1498       define buffer buf_fbr-doc           for ub.fbr-doc.
     1499       define buffer buf_fbr-line          for ub.fbr-line.
     1500       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     1501       define variable v-in-count          as integer       no-undo.
     1502       define variable v-out-count         as integer       no-undo.
     1503       find first buf_fbr-doc exclusive-lock
     1504            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     1505       .
     1506       find first buf_temp_fbrlib_recipe no-error.
     1507       if not available buf_temp_fbrlib_recipe
     1508       then do:
     1509           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     1510               input buf_fbr-doc.doc-code
     1511           ) no-error.
     1512           if error-status :error
     1513           then do:
     1514               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     1515                                              , vss-description
     1516                                              , chr(10)
     1517                                              , error-status:get-message(1)
     1518                                              , return-value ).
     1519           end.
     1520       end.
     1521       assign
     1522           v-in-count                  = 0
     1523           buf_fbr-doc.in-qnty         = 0
     1524           buf_fbr-doc.in-sale         = 0
     1525           buf_fbr-doc.in-base         = 0
     1526           buf_fbr-doc.in-rubl         = 0
     1527           buf_fbr-doc.in-vat-base     = 0
     1528           buf_fbr-doc.in-vat-rubl     = 0
     1529           v-out-count                 = 0
     1530           buf_fbr-doc.out-qnty        = 0
     1531           buf_fbr-doc.out-sale        = 0
     1532           buf_fbr-doc.out-base        = 0
     1533           buf_fbr-doc.out-rubl        = 0
     1534           buf_fbr-doc.out-vat-base    = 0
     1535           buf_fbr-doc.out-vat-rubl    = 0
     1536       .
     1537       for each buf_temp_fbrlib_recipe
     1538       :
     1539           assign
     1540               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     1541               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     1542               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     1543               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     1544               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1545               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1546               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1547               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     1548               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     1549               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     1550               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1551               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1552               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1553               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1554           .
     1555       end.
     1556       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     1557       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     1558       or p-mode <> 'факт':U
     1559       then do:
     1560           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     1561           then do:
     1562               assign
     1563                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     1564                                   + string( v-out-count, ">>>,>>9" )
     1565                                   + chr(10) + "Строк исходных товаров : "
     1566                                   + string( v-in-count, ">>>,>>9" )
     1567               .
     1568           end.
     1569       end.
     1570       else do:
     1571         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     1572                                       "Сумма списанных товаров в &3 - &4&2" +
     1573                                       "Сумма оприходованных товаров в &3 - &5&2" +
     1574                                       "Сумма оприходованных товаров в &3 - &6&2" +
     1575                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     1576                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     1577                                       , buf_fbr-doc.doc-code
     1578                                       , chr(10)
     1579                                       , "рублях"
     1580                                       , round( buf_fbr-doc.out-rubl, 2 )
     1581                                       , round( buf_fbr-doc.in-rubl,  2 )
     1582                                       , round( buf_fbr-doc.in-rubl,  2 )
     1583                                       , round( buf_fbr-doc.out-base, 2 )
     1584                                       , round( buf_fbr-doc.in-base,  2 )).
     1585       end.
     1586   end.
     1587   end procedure.
     1588   procedure fbrlib-calc-prices :
     1589   do
     1590   on error undo, return error
     1591   :
     1592   define input parameter p-fbr-line-recid as recid        no-undo.
     1593   define input parameter p-price-obj-type as character    no-undo.
     1594   define input parameter p-price-obj-code as integer      no-undo.
     1595   define output parameter p-current-price as decimal      no-undo.
     1596       define variable v-void          as decimal       no-undo.
     1597       define variable v-void-char     as character     no-undo.
     1598       define variable v-gds-code      as integer       no-undo.
     1599       define variable v-b-code        as integer       no-undo.
     1600       define buffer buf_fbr-doc   for ub.fbr-doc.
     1601       define buffer buf_fbr-line  for ub.fbr-line.
     1602       define buffer buf_gds-prt   for ub.gds-prt.
     1603       define buffer buf_bar-code  for ub.bar-code.
     1604       find first buf_fbr-line no-lock
     1605           where recid( buf_fbr-line ) = p-fbr-line-recid
     1606       .
     1607   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1608   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1609     (input  buf_fbr-line.artic
     1610     ,input  buf_fbr-line.prod-type
     1611     ,input  buf_fbr-line.prod-code
     1612     ,output v-gds-code
     1613     ) no-error .
     1614       if error-status :error
     1615       then do:
     1616         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     1617                                         ,vss-workfile
     1618                                         ,vss-revision
     1619                                         ,vss-description
     1620                                         ,chr(10)
     1621                                         , error-status:get-message(1)
     1622                                         , return-value
     1623                                         , buf_fbr-line.artic
     1624                                         ).
     1625       end.
     1626   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1627     (input  v-gds-code
     1628     ,input  ?
     1629     ,output v-b-code
     1630     ) no-error .
     1631       if error-status :error
     1632       then do:
     1633         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     1634                                         ,vss-workfile
     1635                                         ,vss-revision
     1636                                         ,vss-description
     1637                                         ,chr(10)
     1638                                         , error-status:get-message(1)
     1639                                         , return-value
     1640                                         , v-gds-code
     1641                                         ).
     1642       end.
     1643       if buf_fbr-line.is-calc = no
     1644       then do:
     1645   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1646   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1647     (input  p-price-obj-type
     1648     ,input  p-price-obj-code
     1649     ,input  v-b-code
     1650     ,input  0
     1651     ,input  0
     1652     ,output v-void-char
     1653     ,output p-current-price
     1654     ,output v-void
     1655     ,output v-void
     1656     ) no-error .
     1657           if error-status :error
     1658           then do:
     1659             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     1660                                             ,vss-workfile
     1661                                             ,vss-revision
     1662                                             ,vss-description
     1663                                             ,chr(10)
     1664                                             , error-status:get-message(1)
     1665                                             , return-value
     1666                                             , v-gds-code
     1667                                             ).
     1668           end.
     1669       end.
     1670       else do:
     1671           assign
     1672               p-current-price = buf_fbr-line.price-sale
     1673           .
     1674       end.
     1675   end.
     1676   end procedure.
     1677   procedure fbrlib-put-in-order-recipe :
     1678   do
     1679   on error undo, return error
     1680   :
     1681   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1682       define variable v-recipe-counter    as integer          no-undo.
     1683       define variable v-recipe-amount     as integer init 0   no-undo.
     1684       define variable v-child-counter     as integer          no-undo.
     1685       define variable v-is-call-cycle     as logical          no-undo.
     1686       define variable v-str as character     no-undo.
     1687       define buffer buf_in_fbr-line       for ub.fbr-line.
     1688       define buffer buf_dress_fbr-line    for ub.fbr-line.
     1689       define buffer buf_fbr-line          for ub.fbr-line.
     1690       define buffer buf_recipe-gds        for ub.recipe-gds.
     1691       define buffer buf_recipe            for ub.recipe.
     1692       for each temp_recipe-childs-qnty
     1693       :
     1694           delete temp_recipe-childs-qnty.
     1695       end.
     1696       for each temp_recipe-childs
     1697       :
     1698           delete temp_recipe-childs.
     1699       end.
     1700       for each temp_recipe-order
     1701       :
     1702           delete temp_recipe-order.
     1703       end.
     1704       for each buf_fbr-line no-lock
     1705          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1706       on error undo, return error
     1707       :
     1708           find first temp_recipe-childs-qnty
     1709                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1710           no-error.
     1711           if not available temp_recipe-childs-qnty
     1712           then do:
     1713               create temp_recipe-childs-qnty.
     1714               assign
     1715                   v-recipe-amount                     = v-recipe-amount + 1
     1716                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1717                   temp_recipe-childs-qnty.order       = v-recipe-amount
     1718                   temp_recipe-childs-qnty.childs-qnty = 0
     1719                   v-child-counter                     = 0
     1720               .
     1721           end.
     1722       end.
     1723       for each buf_in_fbr-line no-lock
     1724          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1725            and buf_in_fbr-line.trn-type = 'спи':U
     1726       on error undo, return error
     1727       :
     1728           for each buf_dress_fbr-line no-lock
     1729              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     1730                and buf_dress_fbr-line.trn-type    = 'при':U
     1731                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     1732                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     1733                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     1734           on error undo, return error
     1735           :
     1736               find first buf_recipe no-lock
     1737                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     1738               .
     1739               if buf_in_fbr-line.is-comp = yes
     1740               then do:
     1741                   find last temp_recipe-childs-qnty
     1742                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1743                   .
     1744                   assign
     1745                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1746                   .
     1747                   create temp_recipe-childs.
     1748                   assign
     1749                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1750                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1751                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     1752                   .
     1753               end.
     1754               else do:
     1755               end.
     1756           end.
     1757       end.
     1758       for each buf_in_fbr-line no-lock
     1759          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1760            and buf_in_fbr-line.trn-type = 'при':U
     1761       on error undo, return error
     1762       :
     1763           find first buf_recipe no-lock
     1764                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     1765           no-error.
     1766           if buf_in_fbr-line.is-comp = no
     1767           then do:
     1768           end.
     1769           else do:
     1770               for each buf_recipe-gds no-lock
     1771               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     1772               :
     1773                   for each buf_fbr-line no-lock
     1774                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1775                       and buf_fbr-line.trn-type    = 'при':U
     1776                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     1777                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     1778                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     1779                   on error undo, return error
     1780                   :
     1781                       find first buf_recipe no-lock
     1782                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     1783                       .
     1784                       if buf_recipe.recipe-type = 'разделка':U
     1785                       then do:
     1786                       end.
     1787                       else do:
     1788                           find last temp_recipe-childs-qnty
     1789                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1790                           .
     1791                           assign
     1792                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1793                           .
     1794                           create temp_recipe-childs.
     1795                           assign
     1796                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1797                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1798                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     1799                           .
     1800                       end.
     1801                   end.
     1802               end.
     1803           end.
     1804       end.
     1805       for each temp_recipe-order
     1806       on error undo, return error
     1807       :
     1808           delete temp_recipe-order.
     1809       end.
     1810       assign
     1811           v-fbrlib-recipe-order = 0
     1812       .
     1813       do v-recipe-counter = 1 to v-recipe-amount
     1814       on error undo, return error
     1815       :
     1816           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1817                 input v-recipe-counter
     1818               , input 0
     1819               , output v-is-call-cycle
     1820           ).
     1821           if v-is-call-cycle = yes
     1822           then do:
     1823               message
     1824                       "Достигнут максимальный уровень вложенности рецептов."
     1825                   skip(1)
     1826                   skip "Невозможно упорядочить рецепты."
     1827                   skip(1)
     1828                   skip "Необходимо изменить структуру рецептов,"
     1829                   skip "используемых при формировании"
     1830                   skip "данного документа производства."
     1831               view-as alert-box error
     1832               title "Невозможно рассчитать документ производства".
     1833               for each temp_recipe-childs-qnty
     1834               :
     1835                   delete temp_recipe-childs-qnty.
     1836               end.
     1837               for each temp_recipe-childs
     1838               :
     1839                   delete temp_recipe-childs.
     1840               end.
     1841               for each temp_recipe-order
     1842               :
     1843                   delete temp_recipe-order.
     1844               end.
     1845               for each temp_recipe-order
     1846               on error undo, return error
     1847               :
     1848                   delete temp_recipe-order.
     1849               end.
     1850               for each temp_fbrlib_recipe
     1851               on error undo, return error
     1852               :
     1853                   delete temp_recipe-order.
     1854               end.
     1855               undo, return error.
     1856           end.
     1857       end.
     1858   end.
     1859   end procedure.
     1860   procedure fbrlib-add-recipe-in-tmp-order :
     1861   do
     1862   on error undo, return error
     1863   :
     1864   define input parameter p-order              as integer      no-undo.
     1865   define input parameter p-call-counter       as integer      no-undo.
     1866   define output parameter p-is-call-cycle     as logical      no-undo.
     1867       define variable v-nodes-counter     as integer       no-undo.
     1868       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     1869       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     1870       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     1871       define buffer buf_temp_recipe-order         for temp_recipe-order.
     1872       assign
     1873           p-call-counter = p-call-counter + 1
     1874       .
     1875       if p-call-counter > 50
     1876       then do:
     1877           assign
     1878               p-is-call-cycle = yes
     1879           .
     1880       end.
     1881       else do:
     1882           find first buf_temp_recipe-childs-qnty
     1883                where buf_temp_recipe-childs-qnty.order = p-order
     1884           .
     1885           find first buf_temp_recipe-order
     1886                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1887           no-error.
     1888           if not available buf_temp_recipe-order
     1889           then do:
     1890               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     1891               :
     1892                   find first buf_temp_recipe-childs
     1893                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1894                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     1895                   .
     1896                   find first buf_c_temp_recipe-childs-qnty
     1897                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     1898                   .
     1899                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1900                         input buf_c_temp_recipe-childs-qnty.order
     1901                       , input p-call-counter
     1902                       , output p-is-call-cycle
     1903                   ).
     1904                   if p-is-call-cycle = yes
     1905                   then do:
     1906                       return.
     1907                   end.
     1908               end.
     1909               assign
     1910                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     1911               .
     1912               create buf_temp_recipe-order.
     1913               assign
     1914                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     1915                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     1916               .
     1917           end.
     1918       end.
     1919   end.
     1920   end procedure.
     1921   procedure fbrlib-get-trn-type :
     1922   define input parameter p-recipe-code    as character    no-undo.
     1923   define input parameter p-goods-recid    as recid        no-undo.
     1924   define input parameter p-is-integration as logical      no-undo.
     1925   define output parameter p-is-comp       as logical      no-undo.
     1926   define output parameter p-trn-type      as character    no-undo.
     1927   define buffer buf_recipe    for ub.recipe.
     1928   define buffer buf_goods     for ub.goods.
     1929   do
     1930   for buf_recipe
     1931     , buf_goods
     1932   on error undo, return error
     1933   :
     1934       find first buf_goods no-lock
     1935            where recid( buf_goods ) = p-goods-recid
     1936       .
     1937       find first buf_recipe no-lock
     1938            where buf_recipe.recipe-code = p-recipe-code
     1939       no-error.
     1940       if not available buf_recipe
     1941       then do:
     1942           assign
     1943               p-is-comp = no
     1944               p-trn-type = "":U
     1945           .
     1946           undo, return.
     1947       end.
     1948       if  buf_recipe.artic        = buf_goods.artic
     1949       and buf_recipe.prod-type    = buf_goods.prod-type
     1950       and buf_recipe.prod-code    = buf_goods.prod-code
     1951       then do:
     1952           assign
     1953               p-is-comp = yes
     1954           .
     1955       end.
     1956       else do:
     1957           assign
     1958               p-is-comp = no
     1959           .
     1960       end.
     1961       case buf_recipe.recipe-type
     1962       :
     1963           when 'производство':U
     1964           then do:
     1965               if p-is-comp = yes
     1966               then do:
     1967                   assign
     1968                       p-trn-type = 'при':U
     1969                   .
     1970               end.
     1971               else do:
     1972                   assign
     1973                       p-trn-type = 'спи':U
     1974                   .
     1975               end.
     1976           end.
     1977           when 'альтернатива':U
     1978           then do:
     1979               if p-is-comp = yes
     1980               then do:
     1981                   assign
     1982                       p-trn-type = 'при':U
     1983                   .
     1984               end.
     1985               else do:
     1986                   assign
     1987                       p-trn-type = 'спи':U
     1988                   .
     1989               end.
     1990           end.
     1991           when 'разделка':U
     1992           then do:
     1993               if p-is-comp = no
     1994               then do:
     1995                   assign
     1996                       p-trn-type = 'при':U
     1997                   .
     1998               end.
     1999               else do:
     2000                   assign
     2001                       p-trn-type = 'спи':U
     2002                   .
     2003               end.
     2004           end.
     2005           when 'комплектация':U
     2006           then do:
     2007               if p-is-integration = ?
     2008               then do:
     2009                   message
     2010                       "Выберите тип операции по рецепту комплектации:"
     2011                       skip (2) "YES - комплектация"
     2012                       skip     "NO - разукомплектация"
     2013                   view-as alert-box question
     2014                   buttons YES-NO
     2015                   update p-is-integration.
     2016               end.
     2017               if p-is-integration = yes
     2018               then do:
     2019                   if p-is-comp = yes
     2020                   then do:
     2021                       assign
     2022                           p-trn-type = 'при':U
     2023                       .
     2024                   end.
     2025                   else do:
     2026                       assign
     2027                           p-trn-type = 'спи':U
     2028                       .
     2029                   end.
     2030               end.
     2031               else do:
     2032                   if p-is-comp = yes
     2033                   then do:
     2034                       assign
     2035                           p-trn-type = 'спи':U
     2036                       .
     2037                   end.
     2038                   else do:
     2039                       assign
     2040                           p-trn-type = 'при':U
     2041                       .
     2042                   end.
     2043               end.
     2044           end.
     2045       end case.
     2046   end.
     2047   end procedure.
     2048   procedure fbrlib-get-mark :
     2049   define input parameter p-recipe-code    as character    no-undo.
     2050   define output parameter p-mark          as logical    no-undo.
     2051   define buffer buf_goods-attr     for ub.goods-attr.
     2052   define buffer buf_recipe-gds for ub.recipe-gds .
     2053       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2054            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2055                                               buf_goods-attr.attr-code = 'mark-type':U:
     2056            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2057               p-mark = true .
     2058               return .
     2059            end.
     2060       end.
     2061   end procedure.
     2062   procedure fbrlib-check-temp-tables :
     2063   do
     2064   on error undo, return error
     2065   :
     2066   define input parameter p-title  as character    no-undo.
     2067       define variable v-str               as character        no-undo.
     2068       assign
     2069           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2070       .
     2071       for each temp_recipe-childs-qnty
     2072       on error undo, return error
     2073       :
     2074           assign
     2075               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2076                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2077                       + "   " + string( temp_recipe-childs-qnty.order )
     2078                       + chr(10)
     2079           .
     2080       end.
     2081       assign
     2082           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2083       .
     2084       for each temp_recipe-childs
     2085       on error undo, return error
     2086       :
     2087           assign
     2088               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2089                       + "   " + string( temp_recipe-childs.child-code )
     2090                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2091                       + chr(10)
     2092           .
     2093       end.
     2094       assign
     2095           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2096       .
     2097       for each temp_recipe-order
     2098       on error undo, return error
     2099       :
     2100           assign
     2101               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2102                       + "   " + string( temp_recipe-order.order )
     2103                       + chr(10)
     2104           .
     2105       end.
     2106       assign
     2107           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2108       .
     2109       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2110       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2111       for each temp_fbrlib_recipe
     2112       on error undo, return error
     2113       :
     2114           assign
     2115               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2116                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2117                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2118                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2119                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2120                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2121                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2122                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2123                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2124                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2125                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2126                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2127                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2128                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2129                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2130                       + chr(10)
     2131           .
     2132           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2133       end.
     2134   end.
     2135   end procedure.
     2136   procedure fbrlib-s-coeff-value :
     2137   define input  parameter p-gds-code    as integer        no-undo.
     2138   define input  parameter p-date        as date           no-undo.
     2139   define input  parameter p-obj-type    as character      no-undo.
     2140   define input  parameter p-obj-code    as integer        no-undo.
     2141   define output parameter p-coeff-value as decimal        no-undo.
     2142   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2143       define variable v-date          as date         no-undo.
     2144       define variable v-host-code     as integer      no-undo.
     2145       define buffer buf_goods       for ub.goods.
     2146       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2147       define buffer buf_clients     for ub.clients.
     2148       define buffer buf_s-coeff     for ub.s-coeff.
     2149   do
     2150   for buf_goods
     2151     , buf_fbr-gds-obj
     2152     , buf_clients
     2153     , buf_s-coeff
     2154   on error undo, return error return-value
     2155   :
     2156       find first buf_goods no-lock
     2157            where buf_goods.gds-code = p-gds-code
     2158       no-error .
     2159       if not available buf_goods
     2160       then do:
     2161          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2162       end.
     2163       find first buf_clients no-lock
     2164            where buf_clients.obj-type = p-obj-type
     2165              and buf_clients.obj-code = p-obj-code
     2166       no-error.
     2167       if not available buf_clients
     2168       then do:
     2169          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2170       end.
     2171       assign
     2172           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2173       .
     2174       find first buf_fbr-gds-obj no-lock
     2175            where buf_fbr-gds-obj.gds-code = p-gds-code
     2176              and buf_fbr-gds-obj.obj-type = p-obj-type
     2177              and buf_fbr-gds-obj.obj-code = p-obj-code
     2178       no-error.
     2179       if not available buf_fbr-gds-obj
     2180       or buf_fbr-gds-obj.is-season = no
     2181       then do:
     2182           assign
     2183               p-coeff-value = 0
     2184           .
     2185           return.
     2186       end.
     2187   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2188   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2189     (input  p-obj-type
     2190     ,input  p-obj-code
     2191     ,output v-host-code
     2192     )  .
     2193       find last buf_s-coeff no-lock
     2194           where buf_s-coeff.gds-code = p-gds-code
     2195             and buf_s-coeff.host-code = v-host-code
     2196             and buf_s-coeff.obj-type = p-obj-type
     2197             and buf_s-coeff.obj-code = p-obj-code
     2198             and buf_s-coeff.s-date <= v-date
     2199       no-error.
     2200       if available buf_s-coeff
     2201       then do:
     2202           assign
     2203               p-coeff-value = buf_s-coeff.coeff-value
     2204           .
     2205           return.
     2206       end.
     2207       find last buf_s-coeff no-lock
     2208           where buf_s-coeff.gds-code = p-gds-code
     2209             and buf_s-coeff.host-code = v-host-code
     2210             and buf_s-coeff.obj-type = "":U
     2211             and buf_s-coeff.obj-code = 0
     2212             and buf_s-coeff.s-date <= v-date
     2213       no-error.
     2214       if available buf_s-coeff
     2215       then do:
     2216           assign
     2217               p-coeff-value = buf_s-coeff.coeff-value
     2218           .
     2219           return.
     2220       end.
     2221       find last buf_s-coeff no-lock
     2222           where buf_s-coeff.gds-code = p-gds-code
     2223             and buf_s-coeff.host-code = 0
     2224             and buf_s-coeff.obj-type = "":U
     2225             and buf_s-coeff.obj-code = 0
     2226             and buf_s-coeff.s-date <= v-date
     2227       no-error.
     2228       if available buf_s-coeff
     2229       then do:
     2230           assign
     2231               p-coeff-value = buf_s-coeff.coeff-value
     2232           .
     2233       end.
     2234       else do:
     2235           assign
     2236               p-coeff-value = 0
     2237           .
     2238       end.
     2239   end.
     2240   end procedure.
     2241   procedure fbrlib_create-fbr-recipe-gds :
     2242   define input parameter p-doc-code         as character      no-undo.
     2243   define input parameter p-recipe-code      as character      no-undo.
     2244   define input parameter p-prod-type        as character      no-undo.
     2245   define input parameter p-prod-code        as integer        no-undo.
     2246   define input parameter p-artic            as character      no-undo.
     2247   define input parameter p-gds-code         as integer        no-undo.
     2248   define input parameter p-is-waste         as logical        no-undo.
     2249   define input parameter p-proc-number      as integer        no-undo.
     2250   define input parameter p-obj-date         as date           no-undo.
     2251   define input parameter p-obj-type         as character      no-undo.
     2252   define input parameter p-obj-code         as integer        no-undo.
     2253   define input parameter p-calc-method      as decimal        no-undo.
     2254   define input parameter p-coeff-waste      as decimal        no-undo.
     2255   define input parameter p-orig-qnty        as decimal        no-undo.
     2256   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2257       define variable v-coeff-season  as decimal      no-undo.
     2258       define variable v-void-decimal  as decimal      no-undo.
     2259       define variable v-void-integer  as integer      no-undo.
     2260       define variable v-recipe-type   as character    no-undo.
     2261       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2262       define buffer buf_goods             for ub.goods.
     2263       define buffer buf_recipe            for ub.recipe.
     2264   do
     2265   for buf_fbr-recipe-gds
     2266     , buf_recipe
     2267     , buf_goods
     2268   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2269   :
     2270       find first buf_fbr-recipe-gds exclusive-lock
     2271            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2272              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2273              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2274              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2275              and buf_fbr-recipe-gds.artic       = p-artic
     2276       no-error.
     2277       if not available buf_fbr-recipe-gds
     2278       then do:
     2279           create buf_fbr-recipe-gds.
     2280           assign
     2281               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2282               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2283               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2284               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2285               buf_fbr-recipe-gds.artic              = p-artic
     2286               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2287               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2288               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2289               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2290               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2291           .
     2292           find first buf_goods no-lock
     2293                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2294                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2295                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2296           .
     2297           run fbrlib-s-coeff-value in this-procedure (
     2298                 input buf_goods.gds-code
     2299               , input p-obj-date
     2300               , input p-obj-type
     2301               , input p-obj-code
     2302               , output v-coeff-season
     2303           ) no-error.
     2304           if error-status:error
     2305           then do:
     2306               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2307           end.
     2308           assign
     2309               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2310               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2311               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2312           .
     2313           run fbrlib-get-recipe-type in this-procedure (
     2314                 input buf_fbr-recipe-gds.doc-code
     2315               , input buf_fbr-recipe-gds.recipe-code
     2316               , output v-recipe-type
     2317           ).
     2318           if v-recipe-type <> 'производство':U
     2319           then do:
     2320               assign
     2321                   buf_fbr-recipe-gds.coeff-value  = 0
     2322                   buf_fbr-recipe-gds.coeff-waste  = 0
     2323                   buf_fbr-recipe-gds.calc-method  = 1
     2324                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2325               .
     2326           end.
     2327           else do:
     2328               run fbrlib-calc-brutto in this-procedure (
     2329                     input v-recipe-type
     2330                   , input buf_fbr-recipe-gds.qnty
     2331                   , input buf_fbr-recipe-gds.coeff-value
     2332                   , input buf_fbr-recipe-gds.coeff-waste
     2333                   , input 0
     2334                   , input 3
     2335                   , output v-void-decimal
     2336                   , output v-void-decimal
     2337                   , output buf_fbr-recipe-gds.brutto-qnty
     2338                   , output v-void-integer
     2339               ).
     2340               assign
     2341                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2342               .
     2343               run fbrlib-calc-brutto in this-procedure (
     2344                     input v-recipe-type
     2345                   , input buf_fbr-recipe-gds.qnty
     2346                   , input buf_fbr-recipe-gds.coeff-value
     2347                   , input buf_fbr-recipe-gds.coeff-waste
     2348                   , input buf_fbr-recipe-gds.brutto-qnty
     2349                   , input buf_fbr-recipe-gds.calc-method
     2350                   , output buf_fbr-recipe-gds.qnty
     2351                   , output v-void-decimal
     2352                   , output v-void-decimal
     2353                   , output v-void-integer
     2354               ).
     2355           end.
     2356       end.
     2357   end.
     2358   end procedure.
     2359   procedure fbrlib-set-default-recipe :
     2360   define input parameter p-obj-type   as character    no-undo.
     2361   define input parameter p-obj-code   as integer      no-undo.
     2362   define input parameter p-gds-code   as integer      no-undo.
     2363       define variable v-artic             as character    no-undo.
     2364       define variable v-prod-type         as character    no-undo.
     2365       define variable v-prod-code         as character    no-undo.
     2366       define variable v-recipe-code       as character    no-undo.
     2367       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2368       define variable v-recipe-found      as logical      no-undo.
     2369       define buffer buf_recipe        for ub.recipe.
     2370       define buffer buf_other_recipe  for ub.recipe.
     2371       define buffer buf_goods         for ub.goods.
     2372       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2373   do
     2374   for buf_recipe
     2375     , buf_goods
     2376     , buf_fbr-gds-obj
     2377   on error undo, return error
     2378   :
     2379       find first buf_goods no-lock
     2380            where buf_goods.gds-code = p-gds-code
     2381       .
     2382       run fbrlib-get-obj-recipe in this-procedure (
     2383             input p-obj-type
     2384           , input p-obj-code
     2385           , input p-gds-code
     2386           , output v-recipe-code
     2387       ).
     2388       if v-recipe-code <> ""
     2389       then do:
     2390           find first buf_recipe no-lock
     2391               where buf_recipe.recipe-code = v-recipe-code
     2392           no-error.
     2393           if not available buf_recipe
     2394           then do:
     2395               assign
     2396                   v-recipe-code = ""
     2397               .
     2398           end.
     2399       end.
     2400       if v-recipe-code = ""
     2401       then do:
     2402           find first buf_fbr-gds-obj exclusive-lock
     2403                where buf_fbr-gds-obj.obj-type = p-obj-type
     2404                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2405                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2406           no-error.
     2407           if not available buf_fbr-gds-obj
     2408           then do:
     2409               run ref/fgdsobj1.p (
     2410                     input-output v-fbr-gds-obj-recid
     2411                   , input 'ДОБАВЛЕНИЕ':U
     2412                   , input no
     2413                   , input p-gds-code
     2414                   , input p-obj-type
     2415                   , input p-obj-code
     2416                   , input 0
     2417                   , input ""
     2418                   , input 0
     2419                   , input no
     2420                   , input no
     2421                   , input no
     2422                   , input no
     2423                   , input no
     2424                   , input no
     2425               ) no-error.
     2426               if error-status:error
     2427               then do:
     2428                   message
     2429                           vss-workfile vss-revision vss-description
     2430                       skip "Ошибка изменения атрибутов товара на объекте"
     2431                       skip return-value
     2432                       skip trim(error-status :get-message(1))
     2433                               trim(error-status :get-message(2))
     2434                               trim(error-status :get-message(3))
     2435                   view-as alert-box error.
     2436                   undo, return error .
     2437               end.
     2438               find first buf_fbr-gds-obj exclusive-lock
     2439                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2440               .
     2441           end.
     2442           assign
     2443               v-recipe-found = no
     2444           .
     2445           for first buf_recipe no-lock
     2446               where buf_recipe.obj-type    = p-obj-type
     2447                 and buf_recipe.obj-code    = p-obj-code
     2448                 and buf_recipe.artic       = buf_goods.artic
     2449                 and buf_recipe.prod-type   = buf_goods.prod-type
     2450                 and buf_recipe.prod-code   = buf_goods.prod-code
     2451                 and buf_recipe.recipe-type = 'производство':U
     2452                 or (
     2453                     buf_recipe.obj-type    = ""
     2454                 and buf_recipe.obj-code    = 0
     2455                 and buf_recipe.artic       = buf_goods.artic
     2456                 and buf_recipe.prod-type   = buf_goods.prod-type
     2457                 and buf_recipe.prod-code   = buf_goods.prod-code
     2458                 and buf_recipe.recipe-type = 'производство':U
     2459                     )
     2460           :
     2461               assign
     2462                   v-recipe-found = yes
     2463                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2464               .
     2465           end.
     2466           if v-recipe-found = no
     2467           then do:
     2468               for first buf_recipe no-lock
     2469                   where buf_recipe.obj-type    = p-obj-type
     2470                     and buf_recipe.obj-code    = p-obj-code
     2471                     and buf_recipe.artic       = buf_goods.artic
     2472                     and buf_recipe.prod-type   = buf_goods.prod-type
     2473                     and buf_recipe.prod-code   = buf_goods.prod-code
     2474                     and buf_recipe.recipe-type <> 'альтернатива':U
     2475                     or (
     2476                         buf_recipe.obj-type    = ""
     2477                     and buf_recipe.obj-code    = 0
     2478                     and buf_recipe.artic       = buf_goods.artic
     2479                     and buf_recipe.prod-type   = buf_goods.prod-type
     2480                     and buf_recipe.prod-code   = buf_goods.prod-code
     2481                     and buf_recipe.recipe-type <> 'альтернатива':U
     2482                         )
     2483               :
     2484                   assign
     2485                       v-recipe-found = yes
     2486                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2487                   .
     2488               end.
     2489               if v-recipe-found = no
     2490               then do:
     2491                   for first buf_recipe no-lock
     2492                       where buf_recipe.obj-type    = p-obj-type
     2493                         and buf_recipe.obj-code    = p-obj-code
     2494                         and buf_recipe.artic       = buf_goods.artic
     2495                         and buf_recipe.prod-type   = buf_goods.prod-type
     2496                         and buf_recipe.prod-code   = buf_goods.prod-code
     2497                         or (
     2498                             buf_recipe.obj-type    = ""
     2499                         and buf_recipe.obj-code    = 0
     2500                         and buf_recipe.artic       = buf_goods.artic
     2501                         and buf_recipe.prod-type   = buf_goods.prod-type
     2502                         and buf_recipe.prod-code   = buf_goods.prod-code
     2503                             )
     2504                   :
     2505                       assign
     2506                           v-recipe-found = yes
     2507                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2508                       .
     2509                   end.
     2510                   if v-recipe-found = no
     2511                   then do:
     2512                       assign
     2513                           buf_fbr-gds-obj.default-recipe-code = ""
     2514                       .
     2515                   end.
     2516               end.
     2517           end.
     2518       end.
     2519   end.
     2520   end procedure.
     2521   procedure fbrlib-get-obj-recipe :
     2522   define input parameter p-obj-type       as character    no-undo.
     2523   define input parameter p-obj-code       as integer      no-undo.
     2524   define input parameter p-gds-code       as integer      no-undo.
     2525   define output parameter p-recipe-code   as character    no-undo.
     2526       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2527   do
     2528   for buf_fbr-gds-obj
     2529   on error undo, return error
     2530   :
     2531       find first buf_fbr-gds-obj no-lock
     2532            where buf_fbr-gds-obj.obj-type = p-obj-type
     2533              and buf_fbr-gds-obj.obj-code = p-obj-code
     2534              and buf_fbr-gds-obj.gds-code = p-gds-code
     2535       no-error.
     2536       if available buf_fbr-gds-obj
     2537       then do:
     2538           assign
     2539               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     2540           .
     2541       end.
     2542       else do:
     2543           assign
     2544               p-recipe-code = ""
     2545           .
     2546       end.
     2547   end.
     2548   end procedure.
     2549   procedure fbrlib-create-or-update-recipe-gds :
     2550   define input parameter p-recipe-code    as character        no-undo.
     2551   define input parameter p-gds-code       as integer          no-undo.
     2552   define input parameter p-is-waste       as logical          no-undo.
     2553   define input parameter p-qnty           as decimal          no-undo.
     2554   define input parameter p-proc-number    as integer          no-undo.
     2555   define input parameter p-nws-self       as logical          no-undo.
     2556       define variable v-max-proc-num  as integer      no-undo.
     2557       define variable v-recipe-type   as character    no-undo.
     2558       define buffer buf_goods             for ub.goods.
     2559       define buffer buf_recipe-gds        for ub.recipe-gds.
     2560       define buffer buf_recipe            for ub.recipe.
     2561       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     2562   do
     2563   for buf_goods
     2564     , buf_recipe-gds
     2565     , buf_recipe
     2566     , buf_proc_recipe-gds
     2567   on error undo, return error
     2568   :
     2569       find first buf_recipe no-lock
     2570            where buf_recipe.recipe-code = p-recipe-code
     2571       .
     2572       find first buf_goods no-lock
     2573            where buf_goods.gds-code = p-gds-code
     2574       .
     2575       find first buf_recipe-gds
     2576            where buf_recipe-gds.recipe-code = p-recipe-code
     2577              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     2578              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     2579              and buf_recipe-gds.artic       = buf_goods.artic
     2580       no-error.
     2581       if not available buf_recipe-gds
     2582       then do:
     2583           create buf_recipe-gds.
     2584           assign
     2585               buf_recipe-gds.recipe-code = p-recipe-code
     2586               buf_recipe-gds.gds-code    = p-gds-code
     2587               buf_recipe-gds.prod-type   = buf_goods.prod-type
     2588               buf_recipe-gds.prod-code   = buf_goods.prod-code
     2589               buf_recipe-gds.artic       = buf_goods.artic
     2590           .
     2591           assign
     2592               buf_recipe-gds.is-waste    = no
     2593               buf_recipe-gds.qnty        = 0
     2594               buf_recipe-gds.coeff-waste = 0
     2595               buf_recipe-gds.brutto-qnty = 0
     2596               buf_recipe-gds.proc-number = 0
     2597               buf_recipe-gds.nws-self    = no
     2598           .
     2599       end.
     2600       assign
     2601           buf_recipe-gds.is-waste    = p-is-waste
     2602       .
     2603       run fbrlib-get-recipe-type in this-procedure (
     2604             input "":U
     2605           , input buf_recipe-gds.recipe-code
     2606           , output v-recipe-type
     2607       ).
     2608       if v-recipe-type <> 'производство':U
     2609       then do:
     2610           assign
     2611               buf_recipe-gds.calc-method = 1
     2612               buf_recipe-gds.qnty        = p-qnty
     2613               buf_recipe-gds.brutto-qnty = p-qnty
     2614               buf_recipe-gds.coeff-waste = 0
     2615           .
     2616       end.
     2617       else do:
     2618           assign
     2619               buf_recipe-gds.calc-method = 1
     2620               buf_recipe-gds.brutto-qnty = p-qnty
     2621           .
     2622           run fbrlib-calc-brutto in this-procedure (
     2623                 input v-recipe-type
     2624               , input 0
     2625               , input 0
     2626               , input buf_recipe-gds.coeff-waste
     2627               , input buf_recipe-gds.brutto-qnty
     2628               , input 1
     2629               , output buf_recipe-gds.qnty
     2630               , output buf_recipe-gds.coeff-waste
     2631               , output buf_recipe-gds.brutto-qnty
     2632               , output buf_recipe-gds.calc-method
     2633           ).
     2634       end.
     2635       assign
     2636           buf_recipe-gds.nws-self    = p-nws-self
     2637       .
     2638       if buf_recipe.recipe-type = 'альтернатива':U
     2639       and buf_recipe-gds.proc-number <> 0
     2640       then do:
     2641       end.
     2642       else do:
     2643           if p-proc-number <> 0
     2644           then do:
     2645               assign
     2646                   buf_recipe-gds.proc-number = p-proc-number
     2647               .
     2648           end.
     2649           else do:
     2650               assign
     2651                   v-max-proc-num = 0
     2652               .
     2653               for each buf_proc_recipe-gds no-lock
     2654                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     2655               :
     2656                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     2657                   then do:
     2658                       assign
     2659                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     2660                       .
     2661                   end.
     2662               end.
     2663               assign
     2664                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     2665               .
     2666           end.
     2667       end.
     2668   end.
     2669   end procedure.
     2670   PROCEDURE fbrlib-create-or-update-recipe :
     2671   define input parameter p-mode               as character    no-undo.
     2672   define input parameter p-obj-type           as character    no-undo.
     2673   define input parameter p-obj-code           as integer      no-undo.
     2674   define input parameter p-recipe-code        as character    no-undo.
     2675   define input parameter p-recipe-type        as character    no-undo.
     2676   define input parameter p-gds-code           as integer      no-undo.
     2677   define input parameter p-name               as character    no-undo.
     2678   define input parameter p-design             as character    no-undo.
     2679   define input parameter p-order              as integer      no-undo.
     2680   define input parameter p-quality            as character    no-undo.
     2681   define input parameter p-ref-num            as character    no-undo.
     2682   define input parameter p-technique          as character    no-undo.
     2683   define input parameter p-template           as character    no-undo.
     2684   define input parameter p-qnty               as decimal      no-undo.
     2685   define input parameter p-portion-qnty       as integer      no-undo.
     2686   define input parameter p-portion-weight     as decimal      no-undo.
     2687   define output parameter p-new-recipe-code   as character    no-undo.
     2688       define variable v-host-code         as integer      no-undo.
     2689       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2690       define buffer buf_recipe    for ub.recipe.
     2691       define buffer buf_goods     for ub.goods.
     2692   do
     2693   for buf_recipe
     2694     , buf_goods
     2695   on error undo, return error
     2696   :
     2697       if p-mode <> 'ДОБАВЛЕНИЕ':U
     2698       and p-mode <> 'ИЗМЕНЕНИЕ':U
     2699       then do:
     2700           message
     2701               skip "Ошибка задания типа операции для создания или измения рецепта."
     2702               skip (1)
     2703               skip "Задан тип операции:" p-mode
     2704           view-as alert-box error.
     2705           undo, return error .
     2706       end.
     2707       if p-recipe-code = ""
     2708       then do:
     2709   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2710   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2711     (input  p-obj-type
     2712     ,input  p-obj-code
     2713     ,output v-host-code
     2714     )  .
     2715           find first buf_goods no-lock
     2716                where buf_goods.gds-code = p-gds-code
     2717           .
     2718           create buf_recipe .
     2719           run fbrcode-gen-recipe-code in this-procedure (
     2720                 input p-obj-type
     2721               , input p-obj-code
     2722               , output buf_recipe.recipe-code
     2723           ).
     2724           assign
     2725               buf_recipe.artic               = buf_goods.artic
     2726               buf_recipe.prod-type           = buf_goods.prod-type
     2727               buf_recipe.prod-code           = buf_goods.prod-code
     2728               buf_recipe.recipe-type         = p-recipe-type
     2729               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     2730               buf_recipe.gds-code            = p-gds-code
     2731               buf_recipe.host-code           = v-host-code
     2732               buf_recipe.obj-type            = p-obj-type
     2733               buf_recipe.obj-code            = p-obj-code
     2734               buf_recipe.recipe-design       = ""
     2735               buf_recipe.recipe-order        = 0
     2736               buf_recipe.recipe-quality      = ""
     2737               buf_recipe.recipe-ref-num      = ""
     2738               buf_recipe.recipe-technique    = ""
     2739               buf_recipe.recipe-template     = ""
     2740               buf_recipe.qnty                = 1.0
     2741               buf_recipe.portion-qnty        = 1
     2742               buf_recipe.portion-weight      = 0
     2743           .
     2744       end.
     2745       if p-name <> ""
     2746       then do:
     2747           assign
     2748               buf_recipe.recipe-name = p-name
     2749           .
     2750       end.
     2751       assign
     2752           buf_recipe.recipe-design       = p-design
     2753           buf_recipe.recipe-order        = p-order
     2754           buf_recipe.recipe-quality      = p-quality
     2755           buf_recipe.recipe-ref-num      = p-ref-num
     2756           buf_recipe.recipe-technique    = p-technique
     2757           buf_recipe.recipe-template     = p-template
     2758           buf_recipe.qnty                = p-qnty
     2759           buf_recipe.portion-qnty        = p-portion-qnty
     2760           buf_recipe.portion-weight      = p-portion-weight
     2761       .
     2762       assign
     2763           p-new-recipe-code = buf_recipe.recipe-code
     2764       .
     2765       run fbrlib-set-default-recipe in this-procedure (
     2766             input p-obj-type
     2767           , input p-obj-code
     2768           , input buf_goods.gds-code
     2769       ).
     2770   end.
     2771   END PROCEDURE.
     2772   PROCEDURE fbrlib-delete-fact-fbr-doc :
     2773   define input parameter parparentproc-handle as widget-handle no-undo .
     2774   define input parameter p-doc-code   as character no-undo.
     2775   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     2776       define variable v-shift-on      as logical      no-undo.
     2777       define variable v-shift-date    as date         no-undo.
     2778       define variable v-shift-num     as integer      no-undo.
     2779       define variable v-shift-name    as character    no-undo.
     2780       define variable v-obj-date      as date         no-undo.
     2781       define variable v-chip-num      as integer      no-undo.
     2782       define buffer buf_fbr-doc       for ub.fbr-doc.
     2783       define buffer buf_fbr-line      for ub.fbr-line.
     2784       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     2785       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     2786       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     2787       define buffer buf_marking-lines for ub.marking-lines .
     2788       define buffer buf_marking       for ub.marking .
     2789       define buffer buf_goods         for ub.goods .
     2790   do
     2791   for buf_fbr-doc
     2792     , buf_fbr-line
     2793     , buf_c-fbr-doc
     2794     , buf_fbr-recipe
     2795     , buf_fbr-recipe-gds
     2796     , buf_goods
     2797     , buf_marking
     2798     , buf_marking-lines
     2799   on error undo, return error
     2800   :
     2801   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2802     define variable v-cntxt-db-num        as integer   no-undo .
     2803     define variable v-cntxt-userid        as character no-undo .
     2804     define variable v-cntxt-level         as character no-undo .
     2805     define variable v-cntxt-host-code-obj as integer   no-undo .
     2806     define variable v-cntxt-obj-type      as character no-undo .
     2807     define variable v-cntxt-obj-code      as integer   no-undo .
     2808     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2809     define variable v-cntxt-is-admin      as logical   no-undo .
     2810   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2811     run mainmenu_getcntxt in parparentproc-handle
     2812       (output v-cntxt-db-num
     2813       ,output v-cntxt-userid
     2814       ,output v-cntxt-level
     2815       ,output v-cntxt-host-code-obj
     2816       ,output v-cntxt-obj-type
     2817       ,output v-cntxt-obj-code
     2818       ,output v-cntxt-db-num-obj
     2819       ,output v-cntxt-is-admin
     2820       ) .
     2821       if search ("delfbr.err") <> ?
     2822       then do:
     2823           os-delete "delfbr.err".
     2824       end.
     2825     _del-block:
     2826       do transaction
     2827     on error undo _del-block, return error return-value
     2828     on endkey undo _del-block , return error return-value
     2829     on stop undo _del-block , return error return-value
     2830       :
     2831           find first buf_fbr-doc exclusive-lock
     2832                where buf_fbr-doc.doc-code = p-doc-code
     2833           no-error.
     2834           if not available buf_fbr-doc
     2835           then do:
     2836         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     2837                                           ,vss-workfile
     2838                                           ,vss-revision
     2839                                           ,vss-description
     2840                                           ,chr(10)
     2841                                           , p-doc-code).
     2842           end.
     2843           run fbrlib-delete-fact-trn-doc in this-procedure (
     2844               input parparentproc-handle
     2845              ,input p-doc-code
     2846              ,input 'при':U
     2847              ,input p-chip-num
     2848              ,output v-chip-num
     2849           ) no-error.
     2850           if error-status :error
     2851           then do:
     2852               run fbrlib-print-del-error-message in this-procedure .
     2853         undo _del-block, return error.
     2854           end.
     2855           assign
     2856           p-chip-num = (if p-chip-num = ?
     2857                         then v-chip-num
     2858                         else p-chip-num).
     2859           run fbrlib-delete-fact-trn-doc in this-procedure (
     2860               input parparentproc-handle
     2861              ,input p-doc-code
     2862              ,input 'рас':U
     2863              ,input p-chip-num
     2864              ,output v-chip-num
     2865           ) no-error.
     2866           if error-status :error
     2867           then do:
     2868               run fbrlib-print-del-error-message in this-procedure .
     2869         undo _del-block, return error.
     2870           end.
     2871           run fbrlib-delete-fact-trn-doc in this-procedure (
     2872               input parparentproc-handle
     2873              ,input p-doc-code
     2874              ,input 'спи':U
     2875              ,input p-chip-num
     2876              ,output v-chip-num
     2877           ) no-error.
     2878           if error-status :error
     2879           then do:
     2880               run fbrlib-print-del-error-message in this-procedure .
     2881         undo _del-block, return error.
     2882           end.
     2883           create buf_c-fbr-doc.
     2884           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     2885   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2886   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2887     (input  buf_fbr-doc.obj-type
     2888     ,input  buf_fbr-doc.obj-code
     2889     ,output v-obj-date
     2890     ) no-error .
     2891           if error-status :error
     2892           or v-obj-date = ?
     2893           then do:
     2894         undo _del-block, return error "Нет текущей даты на объекте документа.".
     2895           end.
     2896   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2897   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2898     (input  buf_fbr-doc.obj-type
     2899     ,input  buf_fbr-doc.obj-code
     2900     ,input  'shift-on=request'
     2901     ,output v-shift-on
     2902     )  .
     2903           if v-shift-on
     2904           then do:
     2905   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2906   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     2907     (input  buf_fbr-doc.obj-type
     2908     ,input  buf_fbr-doc.obj-code
     2909     ,output v-shift-date
     2910     ,output v-shift-num
     2911     ,output v-shift-name
     2912     ) no-error .
     2913               if error-status :error
     2914               then do:
     2915           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     2916               end.
     2917           end.
     2918           else do:
     2919               assign
     2920                   v-shift-date = ?
     2921                   v-shift-num  = ?
     2922                   v-shift-name = ?
     2923               .
     2924           end.
     2925           define variable v-today       as date         no-undo.
     2926           define variable v-time        as integer      no-undo.
     2927           run cur-time in this-procedure (
     2928                 output v-today
     2929               , output v-time
     2930           ).
     2931           assign
     2932               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     2933               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     2934               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     2935               buf_c-fbr-doc.corr-date        = v-today
     2936               buf_c-fbr-doc.corr-time        = v-time
     2937               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     2938               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     2939               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     2940               buf_c-fbr-doc.is-del           = yes
     2941           .
     2942           assign
     2943               buf_fbr-doc.is-del = yes
     2944           .
     2945           for each buf_fbr-line exclusive-lock
     2946              where buf_fbr-line.doc-code = p-doc-code
     2947       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2948       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2949       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2950           :
     2951               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     2952                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     2953                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     2954               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     2955                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     2956                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     2957                                                       and buf_marking-lines.in-code  = "manufacturing"
     2958                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     2959                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     2960                                                       and buf_marking-lines.prt-code = 0
     2961               :
     2962                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     2963                   assign
     2964                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     2965                   .
     2966                 end .
     2967                 delete buf_marking-lines.
     2968               end .
     2969               delete buf_fbr-line.
     2970           end.
     2971           for each buf_fbr-recipe exclusive-lock
     2972              where buf_fbr-recipe.doc-code = p-doc-code
     2973       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2974       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2975       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2976           :
     2977               delete buf_fbr-recipe.
     2978           end.
     2979           for each buf_fbr-recipe-gds exclusive-lock
     2980              where buf_fbr-recipe-gds.doc-code = p-doc-code
     2981       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2982       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2983       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2984           :
     2985               delete buf_fbr-recipe-gds.
     2986           end.
     2987           delete buf_fbr-doc.
     2988       end.
     2989   end.
     2990   END PROCEDURE.
     2991   PROCEDURE fbrlib-del-trn-doc :
     2992   do
     2993   on error undo, return error
     2994   :
     2995   define input parameter parparentproc        as widget-handle no-undo .
     2996   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2997   define input parameter p-trn-doc-type       as character    no-undo.
     2998   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     2999   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3000       define variable v-trn-doc-doc-code  as character     no-undo.
     3001       define buffer buf_trn-doc       for ub.trn-doc.
     3002   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3003     define variable v-cntxt-db-num        as integer   no-undo .
     3004     define variable v-cntxt-userid        as character no-undo .
     3005     define variable v-cntxt-level         as character no-undo .
     3006     define variable v-cntxt-host-code-obj as integer   no-undo .
     3007     define variable v-cntxt-obj-type      as character no-undo .
     3008     define variable v-cntxt-obj-code      as integer   no-undo .
     3009     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3010     define variable v-cntxt-is-admin      as logical   no-undo .
     3011   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3012     run mainmenu_getcntxt in parparentproc
     3013       (output v-cntxt-db-num
     3014       ,output v-cntxt-userid
     3015       ,output v-cntxt-level
     3016       ,output v-cntxt-host-code-obj
     3017       ,output v-cntxt-obj-type
     3018       ,output v-cntxt-obj-code
     3019       ,output v-cntxt-db-num-obj
     3020       ,output v-cntxt-is-admin
     3021       ) .
     3022       run fbrcode-trn-doc in this-procedure (
     3023             input 'производство':U
     3024           , input p-fbr-doc-doc-code
     3025           , input p-trn-doc-type
     3026           , output v-trn-doc-doc-code
     3027       ).
     3028       find first buf_trn-doc no-lock
     3029            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3030       no-error.
     3031       if available buf_trn-doc
     3032       then do:
     3033           run str/del-doc.p (
     3034                 input parparentproc
     3035               , input buf_trn-doc.doc-code
     3036               , input v-cntxt-db-num
     3037               , input "del-doc.err"
     3038               , input ?
     3039               , input p-fbr-doc-doc-code
     3040               , input v-cntxt-userid
     3041               , input 0
     3042               , input p-phchip-num
     3043               , output p-chip-num
     3044           ) no-error.
     3045           if error-status :error
     3046           then do:
     3047             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3048                                           ,v-trn-doc-doc-code
     3049                                           ,p-fbr-doc-doc-code
     3050                                           , chr(10)
     3051                                           , error-status:get-message(1)
     3052                                           , return-value ).
     3053           end.
     3054       end.
     3055   end.
     3056   END PROCEDURE.
     3057   PROCEDURE fbrlib-delete-fact-trn-doc :
     3058   define input parameter parparentproc    as widget-handle    no-undo.
     3059   define input parameter p-fbr-doc-code   as character        no-undo.
     3060   define input parameter p-doc-type       as character    no-undo.
     3061   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3062   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3063       define variable v-doc-code          as character        no-undo.
     3064       define variable v-ext-doc-type      as character        no-undo.
     3065       define variable v-trn-doc-recid     as recid            no-undo.
     3066       define variable varchip-code        as integer          no-undo.
     3067       define variable varchip-code2       as integer          no-undo.
     3068       define variable v-chip-counter      as integer          no-undo.
     3069       define buffer buf_trn-doc       for ub.trn-doc.
     3070       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3071       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3072   do
     3073   for buf_trn-doc
     3074     , buf_pri_trn-doc
     3075     , buf_cons_trn-doc
     3076   on error undo, return error
     3077   :
     3078   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3079     define variable v-cntxt-db-num        as integer   no-undo .
     3080     define variable v-cntxt-userid        as character no-undo .
     3081     define variable v-cntxt-level         as character no-undo .
     3082     define variable v-cntxt-host-code-obj as integer   no-undo .
     3083     define variable v-cntxt-obj-type      as character no-undo .
     3084     define variable v-cntxt-obj-code      as integer   no-undo .
     3085     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3086     define variable v-cntxt-is-admin      as logical   no-undo .
     3087   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3088     run mainmenu_getcntxt in parparentproc
     3089       (output v-cntxt-db-num
     3090       ,output v-cntxt-userid
     3091       ,output v-cntxt-level
     3092       ,output v-cntxt-host-code-obj
     3093       ,output v-cntxt-obj-type
     3094       ,output v-cntxt-obj-code
     3095       ,output v-cntxt-db-num-obj
     3096       ,output v-cntxt-is-admin
     3097       ) .
     3098       run fbrcode-trn-doc in this-procedure (
     3099             input 'производство':U
     3100           , input p-fbr-doc-code
     3101           , input p-doc-type
     3102           , output v-doc-code
     3103       ).
     3104       find first buf_trn-doc no-lock
     3105            where buf_trn-doc.doc-code = v-doc-code
     3106       no-error.
     3107       if not available buf_trn-doc
     3108       then do:
     3109           if p-doc-type <> 'спи':U
     3110           then do:
     3111               message
     3112                   "Не найден документ '" p-doc-type "'"
     3113                   "по документу производства " p-fbr-doc-code
     3114               view-as alert-box.
     3115               undo, return error.
     3116           end.
     3117           else do:
     3118           end.
     3119       end.
     3120       else do:
     3121           assign
     3122               v-trn-doc-recid = recid( buf_trn-doc )
     3123               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3124           .
     3125           if v-ext-doc-type = 'ev':U
     3126           then do:
     3127               find first buf_pri_trn-doc no-lock
     3128                    where buf_pri_trn-doc.out-code     = v-doc-code
     3129                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3130               no-error.
     3131               if available buf_pri_trn-doc
     3132               then do:
     3133                   run str/del-doc.p (
     3134                         input parparentproc
     3135                       , input buf_pri_trn-doc.doc-code
     3136                       , input v-cntxt-db-num
     3137                       , input "delfbr.err"
     3138                       , input ?
     3139                       , input p-fbr-doc-code
     3140                       , input v-cntxt-userid
     3141                       , input 0
     3142                       , input (if p-ph-chip-num <> ?
     3143                               then p-ph-chip-num
     3144                               else (if varchip-code <> 0
     3145                                   then varchip-code
     3146                                   else ?)
     3147                               )
     3148                       , output varchip-code2
     3149                   ) no-error.
     3150                   if error-status :error
     3151                   then do:
     3152                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3153                                                   ,buf_pri_trn-doc.doc-code
     3154                                                   ,p-fbr-doc-code
     3155                                                   , chr(10)
     3156                                                   , error-status:get-message(1)
     3157                                                   , return-value ).
     3158                   end.
     3159               end.
     3160           end.
     3161           define buffer buf_out_trn-doc       for ub.trn-doc.
     3162           if p-doc-type = 'при':U
     3163           then do:
     3164               assign
     3165                   v-chip-counter = 0
     3166               .
     3167               for each buf_out_trn-doc exclusive-lock
     3168                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3169               on error undo, return error
     3170               :
     3171                   assign
     3172                       v-chip-counter = v-chip-counter + 1
     3173                   .
     3174                   if v-chip-counter > 1
     3175                   then do:
     3176                       assign
     3177                           varchip-code = varchip-code2
     3178                       .
     3179                   end.
     3180                   run str/del-doc.p (
     3181                         input parparentproc
     3182                       , input buf_out_trn-doc.doc-code
     3183                       , input v-cntxt-db-num
     3184                       , input "delfbr.err"
     3185                       , input ?
     3186                       , input p-fbr-doc-code
     3187                       , input v-cntxt-userid
     3188                       , input 0
     3189                       , input (if p-ph-chip-num <> ?
     3190                               then p-ph-chip-num
     3191                               else (if varchip-code <> 0
     3192                                   then varchip-code
     3193                                   else ?)
     3194                               )
     3195                       , output varchip-code2
     3196                   ) no-error.
     3197                   if error-status :error
     3198                   then do:
     3199                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3200                                                   ,buf_out_trn-doc.doc-code
     3201                                                   ,buf_trn-doc.doc-code
     3202                                                   ,p-fbr-doc-code
     3203                                                   , chr(10)
     3204                                                   , error-status:get-message(1)
     3205                                                   , return-value ).
     3206                   end.
     3207               end.
     3208           end.
     3209           run str/del-doc.p (
     3210                 input parparentproc
     3211               , input buf_trn-doc.doc-code
     3212               , input v-cntxt-db-num
     3213               , input "delfbr.err"
     3214               , input ?
     3215               , input p-fbr-doc-code
     3216               , input v-cntxt-userid
     3217               , input 0
     3218               , input (if p-ph-chip-num <> ?
     3219                        then p-ph-chip-num
     3220                        else (if varchip-code <> 0
     3221                              then varchip-code
     3222                              else ?)
     3223                        )
     3224               , output varchip-code2
     3225           ) no-error.
     3226           if error-status :error
     3227           then do:
     3228               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3229                                             ,buf_trn-doc.doc-code
     3230                                             ,p-fbr-doc-code
     3231                                             , chr(10)
     3232                                             , error-status:get-message(1)
     3233                                             , return-value ).
     3234           end.
     3235           if p-doc-type = 'рас':U
     3236           or p-doc-type = 'спи':U
     3237           then do:
     3238               assign
     3239                   v-chip-counter = 0
     3240               .
     3241               for each buf_cons_trn-doc no-lock
     3242                  where buf_cons_trn-doc.out-code      = v-doc-code
     3243                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3244               :
     3245                   assign
     3246                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3247                       v-chip-counter = v-chip-counter + 1
     3248                   .
     3249                   assign
     3250                   varchip-code = if v-chip-counter = 2
     3251                                  then varchip-code2
     3252                                  else varchip-code.
     3253                   run str/del-doc.p (
     3254                         input parparentproc
     3255                       , input buf_cons_trn-doc.doc-code
     3256                       , input v-cntxt-db-num
     3257                       , input "delfbr.err"
     3258                       , input ?
     3259                       , input ?
     3260                       , input v-cntxt-userid
     3261                       , input 0
     3262                       , input (if p-ph-chip-num <> ?
     3263                                then p-ph-chip-num
     3264                                else ( if v-chip-counter = 1
     3265                                       then ?
     3266                                       else varchip-code )
     3267                                )
     3268                       , output varchip-code2
     3269                   ) no-error.
     3270                   if error-status :error
     3271                   then do:
     3272                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3273                                                     ,buf_cons_trn-doc.doc-code
     3274                                                     ,p-fbr-doc-code
     3275                                                     , chr(10)
     3276                                                     , error-status:get-message(1)
     3277                                                     , return-value ).
     3278                   end.
     3279                   assign
     3280                       p-chip-num = varchip-code2
     3281                   .
     3282               end.
     3283           end.
     3284           assign
     3285               p-chip-num = varchip-code2
     3286           .
     3287       end.
     3288   end.
     3289   END PROCEDURE.
     3290   PROCEDURE fbrlib-print-del-error-message :
     3291   do
     3292   on error undo, return error
     3293   :
     3294       define variable v-user-action   as character    no-undo.
     3295       define variable v-printed       as logical      no-undo.
     3296       message
     3297           vss-workfile vss-revision vss-description
     3298           skip "Ошибка при удалении документа."
     3299           skip return-value
     3300           skip trim(error-status :get-message(1))
     3301           skip trim(error-status :get-message(2))
     3302           skip trim(error-status :get-message(3))
     3303       view-as alert-box error.
     3304       if search ("delfbr.err") <> ?
     3305       then do:
     3306         run gbl/prnfilen.w
     3307           (input  "Ошибки при удалении документа производства"
     3308           ,input  0
     3309           ,input  "delfbr.err"
     3310           ,input  7
     3311           ,output v-user-action
     3312           ,output v-printed
     3313           ).
     3314       end.
     3315   end.
     3316   END PROCEDURE.
     3317   procedure fbrlib-calc-brutto :
     3318   define input parameter p-recipe-type        as character        no-undo.
     3319   define input parameter p-netto              as decimal          no-undo.
     3320   define input parameter p-coeff-value        as decimal          no-undo.
     3321   define input parameter p-coeff-waste        as decimal          no-undo.
     3322   define input parameter p-brutto             as decimal          no-undo.
     3323   define input parameter p-calc-method        as integer          no-undo.
     3324   define output parameter p-new-netto         as decimal          no-undo.
     3325   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3326   define output parameter p-new-brutto        as decimal          no-undo.
     3327   define output parameter p-new-calc-method   as integer          no-undo.
     3328   do
     3329   on error undo, return error
     3330   :
     3331       if p-recipe-type <> 'производство':U
     3332       then do:
     3333           assign
     3334               p-new-coeff-waste = 0
     3335               p-new-calc-method = 1
     3336               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3337               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3338           .
     3339       end.
     3340       else do:
     3341           assign
     3342               p-new-calc-method = p-calc-method
     3343           .
     3344           if p-coeff-waste = 0
     3345           then do:
     3346               assign
     3347                   p-coeff-value = 0
     3348               .
     3349           end.
     3350           case p-calc-method
     3351           :
     3352               when 1
     3353               then do:
     3354                   assign
     3355                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3356                       p-new-coeff-waste   = p-coeff-waste
     3357                       p-new-brutto        = p-brutto
     3358                   .
     3359               end.
     3360               when 2
     3361               then do:
     3362                   assign
     3363                       p-new-netto         = p-netto
     3364                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3365                       p-new-brutto        = p-brutto
     3366                   .
     3367               end.
     3368               when 3
     3369               then do:
     3370                   assign
     3371                       p-new-netto         = p-netto
     3372                       p-new-coeff-waste   = p-coeff-waste
     3373                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3374                   .
     3375               end.
     3376               otherwise do:
     3377                   define variable v-yesno    as logical      no-undo.
     3378                   assign
     3379                       v-yesno = yes
     3380                   .
     3381                   message
     3382                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3383                       skip "Значение метода должно быть 1, 2 или 3."
     3384                       skip(1)
     3385                       skip "Заданное значение:" p-calc-method
     3386                       skip(1)
     3387                       skip "Установить значение метода расчета 1"
     3388                       skip "(расчет нетто по брутто и проценту потерь)?"
     3389                   view-as alert-box warning
     3390                   buttons yes-no
     3391                   title "Неверное значение метода пересчета в строках документа-производства"
     3392                   update v-yesno
     3393                   .
     3394                   if v-yesno = yes
     3395                   then do:
     3396                       assign
     3397                           p-new-calc-method   = 1
     3398                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3399                           p-new-coeff-waste   = p-coeff-waste
     3400                           p-new-brutto        = p-brutto
     3401                       .
     3402                   end.
     3403                   else do:
     3404                       message
     3405                               vss-workfile vss-revision vss-description
     3406                           skip(1)
     3407                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3408                           skip return-value
     3409                           skip trim(error-status :get-message(1))
     3410                               trim(error-status :get-message(2))
     3411                               trim(error-status :get-message(3))
     3412                       view-as alert-box error
     3413                       title "Неверное значение метода расчета"
     3414                       .
     3415                       undo, return error .
     3416                   end.
     3417               end.
     3418           end case.
     3419       end.
     3420   end.
     3421   end procedure.
     3422   procedure fbrlib-check-brutto :
     3423   define input parameter p-recipe-type        as character        no-undo.
     3424   define input parameter p-netto              as decimal          no-undo.
     3425   define input parameter p-coeff-value        as decimal          no-undo.
     3426   define input parameter p-coeff-waste        as decimal          no-undo.
     3427   define input parameter p-brutto             as decimal          no-undo.
     3428   define input parameter p-calc-method        as integer          no-undo.
     3429   define output parameter p-error-message     as character        no-undo.
     3430   define output parameter p-not-good          as logical          no-undo.
     3431   do
     3432   on error undo, return error
     3433   :
     3434       if p-recipe-type <> 'производство':U
     3435       then do:
     3436           if p-netto <> p-brutto
     3437           or p-coeff-waste <> 0
     3438           then do:
     3439               assign
     3440                   p-not-good      = yes
     3441                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3442                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3443               .
     3444           end.
     3445       end.
     3446       else do:
     3447           if p-coeff-waste = 0
     3448           then do:
     3449               assign
     3450                   p-coeff-value = 0
     3451               .
     3452           end.
     3453           case p-calc-method
     3454           :
     3455               when 1
     3456               then do:
     3457                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3458                   then do:
     3459                       assign
     3460                           p-not-good      = yes
     3461                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3462                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3463                       .
     3464                   end.
     3465               end.
     3466               when 2
     3467               then do:
     3468                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3469                   then do:
     3470                       assign
     3471                           p-not-good      = yes
     3472                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     3473                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     3474                       .
     3475                   end.
     3476               end.
     3477               when 3
     3478               then do:
     3479                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     3480                   then do:
     3481                       assign
     3482                           p-not-good      = yes
     3483                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     3484                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3485                       .
     3486                   end.
     3487               end.
     3488               otherwise do:
     3489                   assign
     3490                       p-not-good      = yes
     3491                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     3492                   .
     3493               end.
     3494           end case.
     3495       end.
     3496   end.
     3497   end procedure.
     3498   procedure fbrlib-check-fbr-recipe :
     3499   define input parameter p-doc-code       as character        no-undo.
     3500   define input parameter p-recipe-code    as character        no-undo.
     3501   define output parameter p-is-correct    as logical          no-undo.
     3502       define variable v-comp-factor    as decimal      no-undo.
     3503       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3504       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3505       define buffer buf_fbr-line          for ub.fbr-line.
     3506   do
     3507   for buf_fbr-recipe
     3508     , buf_fbr-recipe-gds
     3509     , buf_fbr-line
     3510   on error undo, return error
     3511   :
     3512       assign
     3513           p-is-correct = yes
     3514       .
     3515       find first buf_fbr-recipe no-lock
     3516            where buf_fbr-recipe.doc-code    = p-doc-code
     3517              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     3518       .
     3519       if not available buf_fbr-recipe then do:
     3520         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     3521       end.
     3522       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3523       then do:
     3524       end.
     3525       else do:
     3526           find first buf_fbr-line no-lock
     3527                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     3528                  and buf_fbr-line.is-comp     = yes
     3529                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     3530                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     3531                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     3532                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     3533           .
     3534           assign
     3535               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     3536           .
     3537           recipe-line-cycle:
     3538           for each buf_fbr-recipe-gds no-lock
     3539              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3540                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3541           on error undo, return error
     3542           :
     3543               find first buf_fbr-line no-lock
     3544                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3545                      and buf_fbr-line.is-comp     = no
     3546                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3547                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3548                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3549                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3550               .
     3551               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     3552               then do:
     3553                   assign
     3554                       p-is-correct = no
     3555                   .
     3556                   leave recipe-line-cycle.
     3557               end.
     3558           end.
     3559       end.
     3560   end.
     3561   end procedure.
     3562   procedure fbrlib-get-recipe-type :
     3563   define input parameter p-fbr-doc-code   as character        no-undo.
     3564   define input parameter p-recipe-code    as character        no-undo.
     3565   define output parameter p-recipe-type   as character        no-undo.
     3566       define buffer buf_recipe        for ub.recipe.
     3567       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     3568   do
     3569   for buf_recipe
     3570     , buf_fbr-recipe
     3571   on error undo, return error
     3572   :
     3573       if p-fbr-doc-code = ""
     3574       then do:
     3575           find first buf_recipe no-lock
     3576                where buf_recipe.recipe-code = p-recipe-code
     3577           no-error.
     3578           if available buf_recipe
     3579           then do:
     3580               assign
     3581                   p-recipe-type = buf_recipe.recipe-type
     3582               .
     3583           end.
     3584           else do:
     3585               assign
     3586                   p-recipe-type = "":U
     3587               .
     3588           end.
     3589       end.
     3590       else do:
     3591           find first buf_fbr-recipe no-lock
     3592                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     3593                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     3594           no-error.
     3595           if available buf_fbr-recipe
     3596           then do:
     3597               assign
     3598                   p-recipe-type = buf_fbr-recipe.recipe-type
     3599               .
     3600           end.
     3601           else do:
     3602               assign
     3603                   p-recipe-type = "":U
     3604               .
     3605           end.
     3606       end.
     3607   end.
     3608   end procedure.
     3609   PROCEDURE calc-comp-from-ingr :
     3610   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     3611   define input parameter p-fact-qnty                          as decimal      no-undo.
     3612   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     3613   define output parameter p-comp-qnty                         as decimal      no-undo.
     3614       define variable v-ingr-qnty     as decimal       no-undo.
     3615       define buffer buf_i_fbr-line    for ub.fbr-line.
     3616       define buffer buf_fbr-line      for ub.fbr-line.
     3617       define buffer buf_recipe        for ub.fbr-recipe.
     3618       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     3619   do
     3620   for buf_i_fbr-line
     3621     , buf_fbr-line
     3622     , buf_recipe
     3623     , buf_recipe-gds
     3624   on error undo, return error
     3625   :
     3626       find first buf_i_fbr-line no-lock
     3627            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     3628       .
     3629       find first buf_recipe no-lock
     3630            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     3631              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     3632       no-error.
     3633       if not available buf_recipe
     3634       then do:
     3635           message
     3636                   vss-workfile vss-revision vss-description
     3637               skip "В строке производства не указан рецепт."
     3638               skip "Невозможно рассчитать количество составного товара."
     3639               skip return-value
     3640               skip trim(error-status :get-message(1))
     3641                   trim(error-status :get-message(2))
     3642                   trim(error-status :get-message(3))
     3643           view-as alert-box error.
     3644           undo, return error .
     3645       end.
     3646       if buf_recipe.recipe-type = 'альтернатива':U
     3647       then do:
     3648           for each buf_fbr-line no-lock
     3649              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3650                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     3651                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3652           on error undo, return error
     3653           :
     3654               find first buf_recipe-gds no-lock
     3655                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3656                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3657                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     3658                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     3659                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     3660               .
     3661               assign
     3662                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     3663               .
     3664           end.
     3665           assign
     3666               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     3667           .
     3668       end.
     3669       else do:
     3670           find first buf_recipe-gds no-lock
     3671                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3672                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3673                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     3674                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     3675                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     3676           .
     3677           assign
     3678               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     3679           .
     3680       end.
     3681       find first buf_fbr-line no-lock
     3682            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3683              and buf_fbr-line.is-comp     = yes
     3684              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3685       .
     3686       assign
     3687           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     3688       .
     3689   end.
     3690   END PROCEDURE.
     3691   PROCEDURE get-temp_dressing-ingr-used-qnty :
     3692   define input parameter p-recipe-code    as character    no-undo.
     3693   define input parameter p-gds-code       as integer      no-undo.
     3694   define output parameter p-line-qnty     as decimal      no-undo.
     3695   define output parameter p-used-qnty     as decimal      no-undo.
     3696   define output parameter p-recipe-qnty   as decimal      no-undo.
     3697       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     3698   do
     3699   for buf_temp_dressing-ingr
     3700   on error undo, return error
     3701   :
     3702       find first buf_temp_dressing-ingr no-lock
     3703            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     3704              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     3705       no-error.
     3706       if available buf_temp_dressing-ingr
     3707       then do:
     3708           assign
     3709               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     3710               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     3711               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     3712           .
     3713       end.
     3714       else do:
     3715           assign
     3716               p-line-qnty     = 0
     3717               p-used-qnty     = 0
     3718               p-recipe-qnty   = 0
     3719           .
     3720       end.
     3721   end.
     3722   END PROCEDURE.
     3723   PROCEDURE fbrlib_adjust-recipe :
     3724   do
     3725   on error undo, return error
     3726   :
     3727   define input parameter parparentproc as widget-handle no-undo .
     3728   define input parameter p-fbrhist-handle as handle no-undo .
     3729   define input parameter p-doc-code       as character    no-undo.
     3730   define input parameter p-recipe-code    as character    no-undo.
     3731   define input parameter p-price-sale-obj-type as character no-undo .
     3732   define input parameter p-price-sale-obj-code as integer no-undo .
     3733       define variable v-recipe-qnty       as decimal      no-undo.
     3734       define variable v-comp-qnty         as decimal      no-undo.
     3735       define variable v-recipe-gds-qnty   as decimal      no-undo.
     3736       define variable v-ingr-qnty         as decimal      no-undo.
     3737       define variable v-qnty              as decimal      no-undo.
     3738       define variable v-coeff-waste       as decimal      no-undo.
     3739       define variable v-brutto-qnty       as decimal      no-undo.
     3740       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3741       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3742       define buffer buf_fbr-line          for ub.fbr-line.
     3743       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     3744       find first buf_fbr-recipe no-lock
     3745            where buf_fbr-recipe.doc-code      = p-doc-code
     3746              and buf_fbr-recipe.recipe-code   = p-recipe-code
     3747       .
     3748       assign
     3749           v-recipe-qnty = buf_fbr-recipe.qnty
     3750       .
     3751       find first buf_fbr-line no-lock
     3752            where buf_fbr-line.doc-code    = p-doc-code
     3753              and buf_fbr-line.is-comp     = yes
     3754              and buf_fbr-line.recipe-code = p-recipe-code
     3755       .
     3756       assign
     3757           v-comp-qnty = buf_fbr-line.fact-qnty
     3758       .
     3759       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3760       then do:
     3761       end.
     3762       else do:
     3763           for each buf_fbr-recipe-gds no-lock
     3764              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3765                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3766           on error undo, return error
     3767           :
     3768               find first buf_fbr-line no-lock
     3769                    where buf_fbr-line.doc-code    = p-doc-code
     3770                      and buf_fbr-line.is-comp     = no
     3771                      and buf_fbr-line.recipe-code = p-recipe-code
     3772                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3773                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3774                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3775               .
     3776               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     3777               then do:
     3778                   do transaction
     3779                   on error undo, return error
     3780                   :
     3781                       find first buf_el_fbr-recipe-gds exclusive-lock
     3782                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     3783                       .
     3784                       assign
     3785                           buf_el_fbr-recipe-gds.calc-method   = 1
     3786                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     3787                       .
     3788                       run fbrlib-calc-brutto in this-procedure (
     3789                             input buf_fbr-recipe.recipe-type
     3790                           , input 0
     3791                           , input buf_el_fbr-recipe-gds.coeff-value
     3792                           , input buf_el_fbr-recipe-gds.coeff-waste
     3793                           , input buf_el_fbr-recipe-gds.brutto-qnty
     3794                           , input 1
     3795                           , output buf_el_fbr-recipe-gds.qnty
     3796                           , output buf_el_fbr-recipe-gds.coeff-waste
     3797                           , output buf_el_fbr-recipe-gds.brutto-qnty
     3798                           , output buf_el_fbr-recipe-gds.calc-method
     3799                       ).
     3800                   end.
     3801               end.
     3802           end.
     3803           run fbrlib_adjust-doc-lines in this-procedure (
     3804                 input parparentproc
     3805               , input p-fbrhist-handle
     3806               , input p-doc-code
     3807               , input p-recipe-code
     3808               , input p-price-sale-obj-type
     3809               , input p-price-sale-obj-code
     3810           ).
     3811       end.
     3812   end.
     3813   END PROCEDURE.
     3814   PROCEDURE fbrlib_adjust-doc-lines :
     3815   define input parameter parparentproc as widget-handle no-undo .
     3816   define input parameter p-fbrhist-handle as handle no-undo .
     3817   define input parameter p-doc-code       as character    no-undo.
     3818   define input parameter p-recipe-code    as character    no-undo.
     3819   define input parameter p-price-sale-obj-type as character no-undo .
     3820   define input parameter p-price-sale-obj-code as integer no-undo .
     3821   define variable v-comp-qnty         as decimal      no-undo.
     3822   define variable v-trn-type          as character    no-undo.
     3823   define variable v-ingr-qnty         as decimal      no-undo.
     3824   define variable v-recipe-qnty       as decimal      no-undo.
     3825   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     3826   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3827   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3828   define buffer buf_fbr-line          for ub.fbr-line.
     3829   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     3830   define buffer buf_goods             for ub.goods.
     3831   define buffer buf_fbr-doc           for ub.fbr-doc.
     3832   do
     3833   for buf_fbr-recipe
     3834     , buf_fbr-recipe-gds
     3835     , buf_fbr-line
     3836     , buf_coeff_fbr-line
     3837     , buf_goods
     3838     , buf_fbr-doc
     3839   on error undo, return error
     3840   :
     3841       find first buf_fbr-line no-lock
     3842            where buf_fbr-line.doc-code      = p-doc-code
     3843              and buf_fbr-line.is-comp       = yes
     3844              and buf_fbr-line.recipe-code   = p-recipe-code
     3845       .
     3846       find first buf_fbr-doc no-lock
     3847            where buf_fbr-doc.doc-code      = p-doc-code
     3848       .
     3849       assign
     3850           v-comp-qnty = buf_fbr-line.fact-qnty
     3851           v-trn-type  = buf_fbr-line.trn-type
     3852       .
     3853       find first buf_fbr-recipe no-lock
     3854            where buf_fbr-recipe.doc-code    = p-doc-code
     3855              and buf_fbr-recipe.recipe-code = p-recipe-code
     3856       .
     3857       assign
     3858       v-recipe-qnty = buf_fbr-recipe.qnty
     3859       .
     3860       do transaction
     3861       on error undo, return error
     3862       :
     3863           for each buf_fbr-recipe-gds no-lock
     3864              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     3865                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     3866           on error undo, return error
     3867           :
     3868               find first buf_fbr-line no-lock
     3869                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3870                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3871                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3872                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3873                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3874               no-error.
     3875               if not available buf_fbr-line
     3876               then do:
     3877                   find first buf_goods no-lock
     3878                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     3879                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     3880                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     3881                   .
     3882                   run str/fbr-crln.p (
     3883                         input parparentproc
     3884                       , input recid( buf_fbr-doc )
     3885                       , input recid( buf_goods )
     3886                       , input buf_fbr-recipe-gds.recipe-code
     3887                       , input v-trn-type
     3888                       , input no
     3889                       , input no
     3890                       , input buf_fbr-doc.obj-type
     3891                       , input buf_fbr-doc.obj-code
     3892                       , output v-fbr-v-fbr-doc-line-recid
     3893                   ).
     3894                   find first buf_fbr-line no-lock
     3895                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3896                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3897                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3898                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3899                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3900                   no-error.
     3901                   if not available buf_fbr-line
     3902                   then do:
     3903                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     3904                                                      , p-doc-code
     3905                                                      , buf_fbr-recipe-gds.artic
     3906                                                      , buf_fbr-recipe-gds.prod-type
     3907                                                      , buf_fbr-recipe-gds.prod-code).
     3908                   end.
     3909               end.
     3910               find first buf_coeff_fbr-line exclusive-lock
     3911                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     3912               .
     3913               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     3914               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     3915               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     3916               then do:
     3917                   assign
     3918                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     3919                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     3920                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     3921                   .
     3922               end.
     3923           end.
     3924       end.
     3925       define variable v-need-goods    as logical       no-undo.
     3926       define variable v-need-goods-list       as character     no-undo.
     3927       define variable v-need-goods-qnty-list  as character     no-undo.
     3928       find first buf_fbr-line no-lock
     3929            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     3930              and buf_fbr-line.is-comp     = yes
     3931              and buf_fbr-line.recipe-code = p-recipe-code
     3932       .
     3933       run str/fbr-qnty.p (
     3934             input parparentproc
     3935           , input p-fbrhist-handle
     3936           , input recid( buf_fbr-doc )
     3937           , input recid( buf_fbr-line )
     3938           , input no
     3939           , input "ingr"
     3940           , input no
     3941           , input p-price-sale-obj-type
     3942           , input p-price-sale-obj-code
     3943           , input no
     3944           , input no
     3945           , input no
     3946           , output v-need-goods
     3947           , output v-need-goods-list
     3948           , output v-need-goods-qnty-list
     3949       ).
     3950   end.
     3951   END PROCEDURE.
     3952   procedure fbrlib_check-before-close :
     3953   define input parameter p-doc-code as character no-undo .
     3954   define variable same-sale as decimal no-undo .
     3955   define variable is-waste as logical no-undo .
     3956   define variable fix-price as logical no-undo .
     3957   define buffer buf_fbr-doc for ub.fbr-doc.
     3958   define buffer buf_fbr-line for ub.fbr-line.
     3959   define buffer buf_goods for ub.goods.
     3960   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3961   do
     3962   on error undo, return error
     3963   :
     3964     for each buf_fbr-line no-lock
     3965         where buf_fbr-line.doc-code = p-doc-code
     3966       , each buf_goods no-lock
     3967         where buf_goods.artic     = buf_fbr-line.artic
     3968           and buf_goods.prod-type = buf_fbr-line.prod-type
     3969           and buf_goods.prod-code = buf_fbr-line.prod-code
     3970     break by buf_fbr-line.prod-type
     3971           by buf_fbr-line.prod-code
     3972           by buf_fbr-line.artic
     3973     :
     3974       if first-of (buf_fbr-line.artic)
     3975       then do:
     3976         assign
     3977         same-sale = buf_fbr-line.price-sale
     3978         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     3979         fix-price = buf_fbr-line.is-calc
     3980         .
     3981       end.
     3982       if same-sale <> buf_fbr-line.price-sale
     3983       then do:
     3984           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     3985                                         ,p-doc-code
     3986                                         ,buf_goods.artic
     3987                                         ,buf_goods.gds-name
     3988                                         ,chr(10)).
     3989       end.
     3990       if fix-price <> buf_fbr-line.is-calc then do:
     3991           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     3992                                         ,p-doc-code
     3993                                         ,buf_goods.artic
     3994                                         ,buf_goods.gds-name
     3995                                         ,chr(10)).
     3996       end.
     3997       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     3998       then do:
     3999         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4000                                         ,p-doc-code
     4001                                         ,buf_goods.artic
     4002                                         ,buf_goods.gds-name
     4003                                         ,chr(10)).
     4004       end.
     4005       if buf_fbr-line.rsrv-qnty <> ?
     4006       and buf_goods.gds-type <> 'у':U
     4007       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4008       and buf_fbr-line.fact-qnty <> 0
     4009       then do:
     4010         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4011           if  can-find(first buf_fbr-gds-obj no-lock where
     4012                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4013               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4014               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4015               and buf_fbr-gds-obj.is-null-price  )  then .
     4016                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4017                                         ,p-doc-code
     4018                                         ,buf_goods.artic
     4019                                         ,buf_goods.gds-name
     4020                                         ,chr(10)
     4021                                         ,buf_fbr-line.recipe-code
     4022                                         ).
     4023         end.
     4024         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4025                                         ,p-doc-code
     4026                                         ,buf_goods.artic
     4027                                         ,buf_goods.gds-name
     4028                                         ,chr(10)
     4029                                         ,buf_fbr-line.recipe-code
     4030                                         ).
     4031       end.
     4032     end.
     4033   end.
     4034   end procedure.
     4035   procedure fbrrest-get-free-qnty :
     4036   do
     4037   on error undo, return error
     4038   :
     4039   define input parameter p-obj-type       as character            no-undo.
     4040   define input parameter p-obj-code       as integer              no-undo.
     4041   define input parameter p-gds-code       as integer              no-undo.
     4042   define input parameter p-autofbr        as logical              no-undo.
     4043   define output parameter p-avail-qnty    as decimal              no-undo.
     4044       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
     4045       define variable v-free-qnty as decimal       no-undo.
     4046       define buffer buf_goods         for ub.goods.
     4047       define buffer buf_gds-obj       for ub.gds-obj.
     4048       define buffer buf_temp-parts    for temp-parts.
     4049       find first buf_goods no-lock
     4050            where buf_goods.gds-code = p-gds-code
     4051       .
     4052       assign
     4053           p-avail-qnty = 0
     4054       .
     4055       run partslib-init-temp-parts in this-procedure (
     4056             input p-obj-type
     4057           , input p-obj-code
     4058           , input buf_goods.artic
     4059           , input buf_goods.prod-type
     4060           , input buf_goods.prod-code
     4061       ).
     4062       assign
     4063           v-free-qnty = 0
     4064       .
     4065       for each buf_temp-parts
     4066       on error undo, return error
     4067       :
     4068           if buf_temp-parts.qnty > 0
     4069           then do:
     4070               assign
     4071                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
     4072               .
     4073           end.
     4074       end.
     4075       assign
     4076           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
     4077       .
     4078   end.
     4079   end procedure.
     4080   procedure fbrrest-get-catering-object :
     4081   do
     4082   on error undo, return error
     4083   :
     4084   define input parameter p-obj-code            as integer      no-undo.
     4085   define output parameter p-catering-obj-type  as character    no-undo.
     4086   define output parameter p-catering-obj-code  as integer      no-undo.
     4087       define buffer buf_shop              for ub.shop.
     4088       find first buf_shop no-lock
     4089            where buf_shop.obj-code = p-obj-code
     4090       .
     4091       assign
     4092           p-catering-obj-type = buf_shop.kitchen-store-type
     4093           p-catering-obj-code = buf_shop.kitchen-store-code
     4094       .
     4095   end.
     4096   end procedure.
     4097   define variable vss-include-info32 as character format "X(65)" no-undo
     4098   initial "@(#)$Workfile$ $Revision$".
     4099   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4100       def var log-file-name as char no-undo.
     4101       if search('fbr.log') = ?
     4102       then do:
     4103           assign
     4104               log-file-name = ""
     4105           .
     4106       end.
     4107       else do:
     4108           assign
     4109               log-file-name = 'fbr.log'
     4110           .
     4111       end.
     4112       DEF STREAM stm-log.
     4113       PROCEDURE writelog:
     4114       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     4115       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     4116       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     4117       if p-file-name <> ""
     4118       then do:
     4119       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     4120           PUT STREAM stm-log UNFORMATTED chr(10).
     4121           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     4122                                           OR p-log-string = "&Line") THEN "" ELSE
     4123                                           cur-time-string-sec() + " ").
     4124           PUT STREAM stm-log UNFORMATTED
     4125                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     4126                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     4127                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     4128       OUTPUT STREAM stm-log CLOSE.
     4129       end.
     4130       END PROCEDURE.
     4131   define variable v-free-qnty             as decimal      no-undo.
     4132   define variable v-available-qnty        as decimal      no-undo.
     4133   define variable v-required-qnty         as decimal      no-undo.
     4134   define variable v-produced-qnty         as decimal      no-undo.
     4135   define variable v-need-qnty             as decimal      no-undo.
     4136   define variable v-comp-shortage         as decimal      no-undo.
     4137   define variable v-ingr-qnty             as decimal      no-undo.
     4138   define variable v-value-character as character  no-undo .
     4139   define variable v-value-date      as date       no-undo .
     4140   define variable v-value-decimal   as decimal    no-undo .
     4141   define variable v-value-integer   as integer    no-undo .
     4142   define variable v-value-ioff   as logical    no-undo .
     4143   define variable v-value-qntc   as logical    no-undo .
     4144   define variable v-tth             as handle     no-undo .
     4145   define variable v-param-type            as character no-undo .
     4146   define variable v-par-type              as character    no-undo.
     4147   define variable v-sum-recipe-ingr       as decimal      no-undo.
     4148   define variable v-sum-ingr-fact-qnty    as decimal      no-undo.
     4149   define variable v-count-ingr-line       as integer      no-undo.
     4150   define variable v-min-ingr-fact-qnty    as decimal      no-undo.
     4151   define variable v-ingr-fact-qnty        as decimal      no-undo.
     4152   define variable v-price-sale            as decimal      no-undo.
     4153   define variable v-ingr-line-exists      as logical      no-undo.
     4154   define variable v-catering-obj-type         as character      no-undo.
     4155   define variable v-catering-obj-code         as integer        no-undo.
     4156   define buffer buf_fbr-line          for fbr-line.
     4157   define buffer buf_fbr-doc           for fbr-doc.
     4158   define buffer buf_goods             for goods.
     4159   define buffer buf_units             for units.
     4160   define buffer buf_fbr-recipe        for fbr-recipe.
     4161   define buffer buf_fbr-recipe-gds    for fbr-recipe-gds.
     4162   define buffer buf_ingr_fbr-line     for fbr-line.
     4163   define buffer buf_ingr_goods        for goods.
     4164   define buffer buf_ingr_units        for units.
     4165   calc-ingr:
     4166   do
     4167   on stop  undo calc-ingr, return error
     4168   on error undo calc-ingr, return error
     4169   :
     4170       find first buf_fbr-doc
     4171            where recid( buf_fbr-doc )  = p-fbr-doc-recid
     4172       .
     4173       run adm/shattri.p ( input "get":U
     4174                          , input  buf_fbr-doc.obj-type
     4175                          , input  buf_fbr-doc.obj-code
     4176                          , input  'fbrattr':U
     4177                          , input  'fbr-ioff':U
     4178                          , output v-value-character
     4179                          , output v-value-date
     4180                          , output v-value-decimal
     4181                          , output v-value-integer
     4182                          , output v-value-ioff
     4183                          , output v-param-type
     4184                          , input-output table-handle v-tth
     4185                          ) no-error .
     4186       if error-status :error then do:
     4187         assign
     4188            v-value-ioff = FALSE
     4189         .
     4190       end.
     4191       run adm/shattri.p ( input "get":U
     4192                          , input  buf_fbr-doc.obj-type
     4193                          , input  buf_fbr-doc.obj-code
     4194                          , input  'fbrattr':U
     4195                          , input  'fbr-qntc':U
     4196                          , output v-value-character
     4197                          , output v-value-date
     4198                          , output v-value-decimal
     4199                          , output v-value-integer
     4200                          , output v-value-qntc
     4201                          , output v-param-type
     4202                          , input-output table-handle v-tth
     4203                          ) no-error .
     4204       if error-status :error then do:
     4205         assign
     4206            v-value-qntc = FALSE
     4207         .
     4208       end.
     4209       if p-have-store = no
     4210       then do:
     4211           assign
     4212               v-catering-obj-type = buf_fbr-doc.obj-type
     4213               v-catering-obj-code = buf_fbr-doc.obj-code
     4214           .
     4215       end.
     4216       else do:
     4217           run fbrrest-get-catering-object in this-procedure (
     4218                 input buf_fbr-doc.obj-code
     4219               , output v-catering-obj-type
     4220               , output v-catering-obj-code
     4221           ) no-error.
     4222           if error-status :error
     4223           then do:
     4224               message
     4225                       vss-workfile vss-revision vss-description
     4226                   skip "Ошибка определения склада для кухни ресторана."
     4227                   skip return-value
     4228                   skip trim(error-status :get-message(1))
     4229                       trim(error-status :get-message(2))
     4230                       trim(error-status :get-message(3))
     4231               view-as alert-box error.
     4232               undo, return error .
     4233           end.
     4234       end.
     4235       find first buf_fbr-line
     4236            where recid( buf_fbr-line ) = p-fbr-line-recid
     4237       .
     4238       find first buf_goods no-lock
     4239            where buf_goods.artic     = buf_fbr-line.artic
     4240              and buf_goods.prod-type = buf_fbr-line.prod-type
     4241              and buf_goods.prod-code = buf_fbr-line.prod-code
     4242       .
     4243       find first buf_units no-lock
     4244            where buf_units.unit-name = buf_goods.unit-base
     4245       .
     4246       find first buf_fbr-recipe no-lock
     4247            where buf_fbr-recipe.doc-code    = buf_fbr-doc.doc-code
     4248              and buf_fbr-recipe.recipe-code = buf_fbr-line.recipe-code
     4249       no-error.
     4250       if not available buf_fbr-recipe
     4251       then do:
     4252           message
     4253               "Товар без рецепта. Расчет количеств по рецепту невозможен."
     4254           view-as alert-box.
     4255           return error.
     4256       end.
     4257   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4258       run writelog in this-procedure (log-file-name, 0, '&Line') .
     4259       run writelog in this-procedure (
     4260             input log-file-name
     4261           , input 1
     4262           , input vss-workfile
     4263       ).
     4264       run writelog in this-procedure (
     4265             input log-file-name
     4266           , input 1
     4267           , input substitute( "Составной: &1. Рецепт: &2. Товар: &3 &4. Факт. кол.: &5. Зарезерв.кол.: &6"
     4268                               , buf_fbr-line.is-comp
     4269                               , buf_fbr-line.recipe-code
     4270                               , buf_fbr-line.artic
     4271                               , buf_goods.gds-name
     4272                               , buf_fbr-line.fact-qnty
     4273                               , buf_fbr-line.rsrv-qnty
     4274                             )
     4275       ).
     4276       if p-calc-direct = "ingr"
     4277       then do:
     4278           run writelog in this-procedure  (
     4279               input log-file-name
     4280               , input 2
     4281               , input substitute( "Проверки количества составного товара = &1. тип ЕИ = &2."
     4282                                   , buf_fbr-line.fact-qnty
     4283                                   , buf_units.type
     4284                                 )
     4285           ).
     4286           if not ( lookup ( 'вес':U, buf_units.type ) > 0
     4287           or lookup ( 'дро':U, buf_units.type ) > 0 )
     4288           then do:
     4289               run writelog in this-procedure  ( log-file-name, 3,  "Невесовой товар" ).
     4290               if buf_fbr-line.fact-qnty <> truncate( buf_fbr-line.fact-qnty, 0 )
     4291               then do:
     4292                   run writelog in this-procedure  (log-file-name, 4,  "Фактическое количество - не целое").
     4293                   if buf_fbr-recipe.recipe-type = 'комплектация':U
     4294                   then do:
     4295                       if buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty <> trunc (buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty, 0)
     4296                       then do:
     4297                           message
     4298                               "Артикул:" buf_goods.artic buf_goods.gds-name
     4299                               skip "Рецепт:" buf_fbr-recipe.recipe-code
     4300                               skip (2)
     4301                               skip buf_fbr-line.fact-qnty "не кратно" buf_fbr-recipe.qnty
     4302                               skip "Заменяем на" ( truncate( buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty, 0) + 1) * buf_fbr-recipe.qnty
     4303                           view-as alert-box error.
     4304                           assign
     4305                               buf_fbr-line.fact-qnty      = ( truncate( buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty, 0 ) + 1 ) * buf_fbr-recipe.qnty
     4306                           .
     4307                           run writelog in this-procedure ( log-file-name, 4,  substitute( "Заменяем количество на &1", buf_fbr-line.fact-qnty ) ).
     4308                       end.
     4309                   end.
     4310                   else do:
     4311                       run writelog in this-procedure  (log-file-name, 6,  "Не комплектация - замена на целое количество").
     4312                       message
     4313                           "Артикул:" buf_goods.artic buf_goods.gds-name
     4314                           skip "Рецепт:" buf_fbr-recipe.recipe-code
     4315                           skip (2)
     4316                           skip buf_fbr-line.fact-qnty "не целое"
     4317                           skip "Заменяем на" ( truncate( buf_fbr-line.fact-qnty, 0 ) + 1 )
     4318                       view-as alert-box error.
     4319                       assign
     4320                           buf_fbr-line.fact-qnty = ( truncate( buf_fbr-line.fact-qnty, 0 ) + 1 )
     4321                       .
     4322                       run writelog in this-procedure ( log-file-name, 5,  substitute( "Заменяем количество на &1", buf_fbr-line.fact-qnty ) ).
     4323                   end.
     4324               end.
     4325           end.
     4326           if not (buf_fbr-line.fact-qnty > 0)
     4327           then do:
     4328               run writelog in this-procedure ( log-file-name, 3, substitute( "Рецепт: &1. Товар: &1 &2. Количество: &3. Количество меньше или равно 0! "
     4329                                                           , buf_fbr-recipe.recipe-code
     4330                                                           , buf_goods.artic
     4331                                                           , buf_goods.gds-name
     4332                                                           , buf_fbr-line.fact-qnty
     4333                                                         )
     4334               ).
     4335               message
     4336                   "Артикул:" buf_goods.artic buf_goods.gds-name
     4337                   skip "Рецепт:" buf_fbr-recipe.recipe-code
     4338                   skip (2)
     4339                   skip "Количество равно 0!"
     4340               view-as alert-box error.
     4341               return error.
     4342           end.
     4343       end.
     4344       run fbrlib-calc-prices in this-procedure (
     4345             input recid( buf_fbr-line )
     4346           , input p-price-obj-type
     4347           , input p-price-obj-code
     4348           , output v-price-sale
     4349       ) no-error.
     4350       if error-status:error then do:
     4351         undo, return error substitute("Ошибка при расчете цен по док-ту пр-ва &4&1&2&1&3"
     4352                             , chr(10)
     4353                             , error-status:get-message(1)
     4354                             , return-value
     4355                             , buf_fbr-line.doc-code
     4356       ).
     4357       end.
     4358       if v-price-sale <> ?
     4359       then do:
     4360           assign
     4361               buf_fbr-line.price-sale = v-price-sale
     4362           .
     4363           if p-price-obj-type <> buf_fbr-doc.obj-type
     4364           or p-price-obj-code <> buf_fbr-doc.obj-code
     4365           then do:
     4366               assign
     4367                   buf_fbr-line.is-calc = yes
     4368               .
     4369           end.
     4370       end.
     4371       assign
     4372           v-comp-shortage = buf_fbr-line.fact-qnty.
     4373       .
     4374       run writelog in this-procedure (
     4375             input log-file-name
     4376           , input 2
     4377           , input substitute( "Расчитана продажная цена для составного товара: &1", buf_fbr-line.price-sale )
     4378       ).
     4379       run writelog in this-procedure (
     4380             input log-file-name
     4381           , input 2
     4382           , input substitute( "Не хватает составного товара: &1", v-comp-shortage )
     4383       ).
     4384       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4385       then do:
     4386           run writelog in this-procedure (
     4387                 input log-file-name
     4388               , input 2
     4389               , input substitute( "Рецепт: &1. Товар: &2. Тип рецепта: Альтернатива. "
     4390                                   , buf_fbr-recipe.recipe-code
     4391                                   , buf_goods.artic
     4392                                   , buf_goods.gds-name
     4393                                 )
     4394           ).
     4395           for each buf_ingr_fbr-line
     4396              where buf_ingr_fbr-line.doc-code       = buf_fbr-doc.doc-code
     4397                and buf_ingr_fbr-line.recipe-code    = buf_fbr-line.recipe-code
     4398                and buf_ingr_fbr-line.is-comp        = no
     4399           :
     4400               find first buf_fbr-recipe-gds no-lock
     4401                    where buf_fbr-recipe-gds.doc-code      = buf_ingr_fbr-line.doc-code
     4402                      and buf_fbr-recipe-gds.recipe-code   = buf_fbr-recipe.recipe-code
     4403                      and buf_fbr-recipe-gds.prod-type     = buf_ingr_fbr-line.prod-type
     4404                      and buf_fbr-recipe-gds.prod-code     = buf_ingr_fbr-line.prod-code
     4405                      and buf_fbr-recipe-gds.artic         = buf_ingr_fbr-line.artic
     4406               .
     4407               assign
     4408                   v-comp-shortage = v-comp-shortage - ( buf_ingr_fbr-line.fact-qnty * buf_fbr-recipe-gds.brutto-qnty ).
     4409               .
     4410           end.
     4411           run writelog in this-procedure (
     4412                 input log-file-name
     4413               , input 2
     4414               , input substitute( "Не хватает составного товара: &1", v-comp-shortage )
     4415           ).
     4416       end.
     4417       assign
     4418           v-sum-recipe-ingr       = 0
     4419           v-sum-ingr-fact-qnty    = 0
     4420           v-count-ingr-line       = 0
     4421           v-min-ingr-fact-qnty    = ?
     4422       .
     4423       for each buf_fbr-recipe-gds no-lock
     4424          where buf_fbr-recipe-gds.doc-code    = buf_fbr-doc.doc-code
     4425            and buf_fbr-recipe-gds.recipe-code = buf_fbr-recipe.recipe-code
     4426       by buf_fbr-recipe-gds.proc-number
     4427       on error undo calc-ingr, return error
     4428       :
     4429           find first buf_ingr_goods no-lock
     4430                where buf_ingr_goods.artic     = buf_fbr-recipe-gds.artic
     4431                  and buf_ingr_goods.prod-type = buf_fbr-recipe-gds.prod-type
     4432                  and buf_ingr_goods.prod-code = buf_fbr-recipe-gds.prod-code
     4433           .
     4434           find first buf_ingr_units no-lock
     4435                where buf_ingr_units.unit-name = buf_ingr_goods.unit-base
     4436           .
     4437           if p-calc-direct = "ingr"
     4438           and buf_fbr-recipe.recipe-type = 'альтернатива':U
     4439           and ( v-comp-shortage = 0 and v-value-ioff )
     4440           then do:
     4441               next.
     4442           end.
     4443           run writelog in this-procedure (
     4444                 input log-file-name
     4445               , input 2
     4446               , input substitute( "Бежим по ингредиентам. Ингредиент: &1 &2. ЕИ: &3 "
     4447                                   , buf_fbr-recipe-gds.artic
     4448                                   , buf_ingr_goods.gds-name
     4449                                   , buf_ingr_units.unit-name
     4450                                   )
     4451           ).
     4452               find first buf_ingr_fbr-line
     4453                    where buf_ingr_fbr-line.doc-code     = buf_fbr-doc.doc-code
     4454                      and buf_ingr_fbr-line.is-comp      = no
     4455                      and buf_ingr_fbr-line.recipe-code  = buf_fbr-line.recipe-code
     4456                      and buf_ingr_fbr-line.artic        = buf_fbr-recipe-gds.artic
     4457                      and buf_ingr_fbr-line.prod-type    = buf_fbr-recipe-gds.prod-type
     4458                      and buf_ingr_fbr-line.prod-code    = buf_fbr-recipe-gds.prod-code
     4459               no-error.
     4460               if not available buf_ingr_fbr-line
     4461               then do:
     4462                   create buf_ingr_fbr-line.
     4463                   assign
     4464                       buf_ingr_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4465                       buf_ingr_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4466                       buf_ingr_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4467                       buf_ingr_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4468                       buf_ingr_fbr-line.recipe-code = buf_fbr-line.recipe-code
     4469                       buf_ingr_fbr-line.trn-type    = ( if buf_fbr-line.trn-type    = 'при':U
     4470                                                         or buf_ingr_goods.gds-type  = 'у':U
     4471                                                         then 'спи':U
     4472                                                         else 'при':U
     4473                                                       )
     4474                       buf_ingr_fbr-line.is-calc               = no
     4475                       buf_ingr_fbr-line.is-comp               = no
     4476                       buf_ingr_fbr-line.is-waste              = buf_fbr-recipe-gds.is-waste
     4477                       buf_ingr_fbr-line.price-base            = 0
     4478                       buf_ingr_fbr-line.price-rubl            = 0
     4479                       buf_ingr_fbr-line.price-sum-base        = 0
     4480                       buf_ingr_fbr-line.price-sum-rubl        = 0
     4481                       buf_ingr_fbr-line.price-sum-vat-base    = 0
     4482                       buf_ingr_fbr-line.price-sum-vat-rubl    = 0
     4483                       buf_ingr_fbr-line.fact-qnty             = 0
     4484                   .
     4485                   run writelog in this-procedure (
     4486                         input log-file-name
     4487                       , input 3
     4488                       , input  substitute( "Создана строка ингредиента. Тип: &1" , buf_ingr_fbr-line.trn-type )
     4489                   ).
     4490                   assign
     4491                       v-ingr-line-exists = no
     4492                   .
     4493               end.
     4494               else do:
     4495                   run writelog in this-procedure (
     4496                         input log-file-name
     4497                       , input 3
     4498                       , input  substitute( "Найдена строка ингредиента. Тип: &1" , buf_ingr_fbr-line.trn-type )
     4499                   ).
     4500                   assign
     4501                       v-ingr-line-exists = yes
     4502                   .
     4503               end.
     4504               assign
     4505                   buf_ingr_fbr-line.calc-method           = buf_fbr-recipe-gds.calc-method
     4506                   buf_ingr_fbr-line.coeff-value           = buf_fbr-recipe-gds.coeff-value
     4507                   buf_ingr_fbr-line.coeff-waste           = buf_fbr-recipe-gds.coeff-waste
     4508               .
     4509               if buf_fbr-recipe-gds.is-waste
     4510               then do:
     4511                   assign
     4512                       buf_ingr_fbr-line.price-sale = 0
     4513                       buf_ingr_fbr-line.rsrv-qnty = ?
     4514                   .
     4515                   run writelog in this-procedure (
     4516                         input log-file-name
     4517                       , input 3
     4518                       , input  "Отходы. Делаем цену для ингредиента = 0, зарезервированное количество = ?"
     4519                   ).
     4520               end.
     4521               else do:
     4522                   assign
     4523                       buf_ingr_fbr-line.rsrv-qnty = 0
     4524                   .
     4525                   run writelog in this-procedure (
     4526                         input log-file-name
     4527                       , input 3
     4528                       , input "Делаем зарезервированное количество для ингредиента = 0"
     4529                   ).
     4530               end.
     4531               if p-calc-direct = "ingr"
     4532               then do:
     4533                   run writelog in this-procedure (
     4534                         input log-file-name
     4535                       , input 3
     4536                       , input "Направление расчёта - 'ingr'"
     4537                   ).
     4538                   define variable v-gds-code  as integer       no-undo.
     4539   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4541     (input  buf_fbr-recipe-gds.artic
