     4613                                   , input 6
     4614                                   , input "Товара хватает"
     4615                               ).
     4616                               if lookup ('вес':U, buf_ingr_units.type) > 0
     4617                               or lookup ('дро':U, buf_ingr_units.type) > 0
     4618                               or truncate (v-comp-shortage / buf_fbr-recipe-gds.brutto-qnty, 0) = v-comp-shortage / buf_fbr-recipe-gds.brutto-qnty
     4619                               then do:
     4620                                   assign
