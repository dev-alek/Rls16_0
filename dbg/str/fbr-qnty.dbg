     4967                       , input buf_fbr-doc.obj-type
     4968                       , input buf_fbr-doc.obj-code
     4969                       , input 'изм_стр':U
     4970                       , input 1
     4971                       , input "str/fbr-qnty.p"
     4972                       , input substitute( "doc-code:&1,artic:&2,msg-on:&3,calc-direct:&4,recursive:&5,price-object:&6&7,new-algorithm:&8,autofbr:&9"
     4973                                           , buf_fbr-recipe.doc-code
     4974                                           , buf_goods.artic
     4975                                           , msg-on
     4976                                           , p-calc-direct
     4977                                           , p-recursive
     4978                                           , p-price-obj-type
     4979                                           , p-price-obj-code
     4980                                           , p-new-algorithm
     4981                                           , p-autofbr
     4982                                           )
     4983                                + substitute( ",have-store:&1", p-have-store )
     4984                       , input buf_fbr-recipe.doc-code
     4985                       , input 'производство':U
     4986                       , input buf_fbr-doc.status_
     4987                       , input buf_fbr-doc.is-free
     4988                       , input buf_fbr-recipe.recipe-code
     4989                       , input buf_fbr-recipe.recipe-type
     4990                       , input buf_goods.gds-code
     4991                       , input buf_fbr-line.trn-type
     4992                       , input buf_fbr-line.fact-qnty
     4993                       , input substitute( "Рецепт альтернативы. Не удалось произвести необходимое количество: &1 &2. Разница по количеству: &3."
     4994                                           , buf_fbr-line.fact-qnty
     4995                                           , buf_goods.unit-base
     4996                                           , v-comp-shortage
     4997                                       )
     4998                       , input yes
     4999                   ).
     5000                   undo, return error .
     5001               end.
     5002           end.
     5003           else do:
     5004           end.
     5005       end.
     5006       if p-calc-direct = "comp"
     5007       then do:
     5008           case buf_fbr-recipe.recipe-type
     5009           :
     5010               when 'альтернатива':U
     5011               then do:
     5012                   assign
     5013                       buf_fbr-line.fact-qnty = v-sum-recipe-ingr
     5014                   .
     5015               end.
     5016               when 'разделка':U
     5017               then do:
     5018                   assign
     5019                       buf_fbr-line.fact-qnty = v-sum-ingr-fact-qnty
     5020                   .
     5021               end.
     5022               otherwise do:
     5023                   if v-count-ingr-line = 0
     5024                   then do:
     5025                       assign
     5026                           buf_fbr-line.fact-qnty = 0
     5027                       .
     5028                   end.
     5029                   else do:
     5030                       assign
     5031                           buf_fbr-line.fact-qnty = v-min-ingr-fact-qnty
     5032                       .
     5033                   end.
     5034               end.
     5035           end case.
     5036       end.
     5037   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5038       run writelog in this-procedure (log-file-name, 0, '&Line') .
     5039   end.
