     4636                                                                       + ( truncate( v-comp-shortage / buf_fbr-recipe-gds.brutto-qnty, 0 ) + 1 )
     4637                                                                       * buf_fbr-recipe-gds.brutto-qnty
     4638                                                                       - v-comp-shortage
