        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-fbrhist-handle         as widget-handle        no-undo.
        4   define input parameter p-fbr-doc-recid          as recid                no-undo.
        5   define input parameter p-fbr-line-recid         as recid                no-undo.
        6   define input parameter msg-on                   as logical              no-undo.
        7   define input parameter p-calc-direct            as character            no-undo.
        8   define input parameter p-recursive              as logical              no-undo.
        9   define input parameter p-price-obj-type         like clients.obj-type   no-undo.
       10   define input parameter p-price-obj-code         like clients.obj-code   no-undo.
       11   define input parameter p-new-algorithm          as logical              no-undo.
       12   define input parameter p-autofbr                as logical              no-undo.
       13   define input parameter p-have-store             as logical              no-undo.
       14   define output parameter p-need-goods            as logical init no      no-undo.
       15   define output parameter p-need-goods-list       as character init ""    no-undo.
       16   define output parameter p-need-goods-qnty-list  as character init ""    no-undo.
       17   define variable vss-revision    as character no-undo init "$Revision$":U .
       18   define variable vss-author      as character no-undo init "$Author$":U .
       19   define variable vss-date        as character no-undo init "$Date$":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       21   define variable vss-archive     as character no-undo init "$Archive$":U .
       22   define variable vss-description as character no-undo init "Расчет строк ингредиентов для одной строки составного товара ИЛИ НАОБОРОТ".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define   shared variable g#auto as logical no-undo.
       84   define   shared variable g#news as logical no-undo.
       85   define   shared variable g#oxml as logical no-undo.
       86   define   shared variable g#esys as logical no-undo.
       87   define   shared variable g#news-source-db as integer no-undo.
       88   define   shared variable g#esys-source-esys as integer no-undo.
       89   define   shared variable g#db-num as integer   no-undo .
       90   define   shared variable g#userid as character no-undo .
       91   define   shared variable g#passwd as character no-undo .
       92   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   procedure cur-time :
       94      define output parameter p-today as date      no-undo .
       95      define output parameter p-time  as integer   no-undo .
       96     do
       97     on error undo, return error
       98     :
       99       define variable v-date1 as date      no-undo .
      100       define variable v-date2 as date      no-undo .
      101       define variable v-time  as integer   no-undo .
      102       assign
      103         v-date1 = today
      104         v-time  = time
      105         v-date2 = today
      106       .
      107       if v-date1 <> v-date2
      108       then do:
      109         assign
      110           v-date1 = today
      111           v-time  = v-time
      112         .
      113       end.
      114       assign
      115         p-today = v-date1
      116         p-time  = v-time
      117       .
      118     end.
      119   end.
      120   function cur-time-date returns character
      121   :
      122     return string(today, '99/99/9999':U) .
      123   end.
      124   function cur-time-mjd returns decimal
      125   :
      126     define variable v-date as date      no-undo .
      127     define variable v-time as integer   no-undo .
      128     run cur-time in this-procedure
      129       (output v-date
      130       ,output v-time
      131       ) .
      132     return integer(v-date) - 2400002 + (v-time / 86400) .
      133   end.
      134   function cur-time-get-ending-index returns integer
      135   (input p-number as integer
      136   )
      137   :
      138     if p-number < 0
      139     or p-number = ?
      140     then do:
      141       return 1 .
      142     end.
      143     define variable v-rest as integer   no-undo .
      144     assign
      145       p-number = p-number modulo 100
      146     .
      147     if p-number < 20
      148     then do:
      149       assign
      150         v-rest = p-number
      151       .
      152     end.
      153     else do:
      154       assign
      155         v-rest = p-number modulo 10
      156       .
      157     end.
      158     case v-rest :
      159       when 1
      160       then do:
      161         return 2 .
      162       end.
      163       when 2 or
      164       when 3 or
      165       when 4
      166       then do:
      167         return 3 .
      168       end.
      169       otherwise do:
      170         return 1 .
      171       end.
      172     end case .
      173   end.
      174   procedure cur-time-mjd-to-date :
      175      define input  parameter i-mjd-diff as decimal no-undo.
      176      define output parameter o-Date     as date    no-undo.
      177      define output parameter o-Time     as integer no-undo.
      178      define variable v-day-number as integer   no-undo .
      179      if    i-mjd-diff < 0
      180         or i-mjd-diff = ?
      181      then do:
      182         return "?" .
      183      end.
      184      assign
      185         v-day-number = truncate(i-mjd-diff,0).
      186         o-Date = date(v-day-number + 2400002).
      187         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189   end.
      190   function cur-time-mjd-to-string returns character
      191   (input p-mjd-diff as decimal
      192   )
      193   :
      194     define variable v-day-number as integer   no-undo .
      195     define variable v-seconds    as integer   no-undo .
      196     define variable v-hour       as integer   no-undo .
      197     define variable v-min        as integer   no-undo .
      198     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      199     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      200     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      201     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      202     if p-mjd-diff < 0
      203     or p-mjd-diff = ?
      204     then do:
      205       return "?" .
      206     end.
      207     assign
      208       v-day-number = integer(truncate(p-mjd-diff,0))
      209       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      210     .
      211     if v-seconds > 86400
      212     then do:
      213       assign
      214         v-seconds = 86400 - 1
      215       .
      216     end.
      217     if v-seconds < 0
      218     then do:
      219       assign
      220         v-seconds = 0
      221       .
      222     end.
      223     assign
      224       v-hour = truncate(v-seconds / 3600, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 3600
      228     .
      229     assign
      230       v-min = truncate(v-seconds / 60, 0)
      231     .
      232     assign
      233       v-seconds = v-seconds modulo 60
      234     .
      235     return
      236         (if v-day-number <> 0
      237           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0
      241           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      242           else ""
      243         )
      244       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      245           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      246           else ""
      247         )
      248       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      249       .
      250   end.
      251   function cur-time-string returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      260   end.
      261   function cur-time-string-sec returns character
      262   :
      263     define variable v-date as date      no-undo .
      264     define variable v-time as integer   no-undo .
      265     run cur-time in this-procedure
      266       (output v-date
      267       ,output v-time
      268       ) .
      269     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      270   end.
      271   function cur-time-custom  returns character
      272   (input p-prefix as character
      273   ,input p-date-format as character
      274   ,input p-delimiter as character
      275   ,input p-time-format as character
      276   ,input p-suffix as character
      277   )
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return
      286       p-prefix
      287       + string(v-date, p-date-format)
      288       + p-delimiter
      289       + string(v-time, p-time-format)
      290       + p-suffix
      291       .
      292   end.
      293   function cur-time-print  returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-datetime returns datetime
      304   :
      305     define variable v-char as character no-undo .
      306     define variable v-datetime as datetime no-undo .
      307     v-char = cur-time-string().
      308     v-datetime = datetime(v-char).
      309     return  v-datetime.
      310   end.
      311   function cur-time-string-msec returns character
      312   :
      313     define variable v-date as datetime  no-undo .
      314     v-date = now.
      315     return string(v-date) .
      316   end.
      317   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      318   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      319   procedure partslib-clear-temp-parts :
      320     define buffer buf_temp-parts for temp-parts .
      321     do
      322     on error undo, return error
      323     :
      324       for each buf_temp-parts
      325       on error undo, return error
      326       :
      327         delete buf_temp-parts .
      328       end.
      329     end.
      330   end procedure.
      331   procedure partslib-create-temp-parts :
      332     define parameter buffer buf_parts       for ub.parts .
      333     define parameter buffer buf_temp-parts  for temp-parts .
      334     define input  parameter p-goods-twounit as logical   no-undo .
      335     define variable v-base-part-code as character no-undo .
      336     do
      337     on error undo, return error
      338     :
      339       if p-goods-twounit = true
      340       then do:
      341         assign
      342           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      343         .
      344       end.
      345       else do:
      346         assign
      347           v-base-part-code = buf_parts.part-code
      348         .
      349       end.
      350       find first buf_temp-parts exclusive-lock
      351         where buf_temp-parts.obj-type  = buf_parts.obj-type
      352           and buf_temp-parts.obj-code  = buf_parts.obj-code
      353           and buf_temp-parts.artic     = buf_parts.artic
      354           and buf_temp-parts.prod-type = buf_parts.prod-type
      355           and buf_temp-parts.prod-code = buf_parts.prod-code
      356           and buf_temp-parts.in-code   = buf_parts.in-code
      357           and buf_temp-parts.out-code  = 'free-zone':U
      358           and buf_temp-parts.part-code = v-base-part-code
      359         no-error.
      360       if not available buf_temp-parts
      361       then do:
      362         create buf_temp-parts .
      363         buffer-copy buf_parts to buf_temp-parts
      364         assign
      365           buf_temp-parts.out-code  = 'free-zone':U
      366           buf_temp-parts.part-code = v-base-part-code
      367           buf_temp-parts.rsrv-free = yes
      368           buf_temp-parts.status_   = no
      369           buf_temp-parts.qnty      = 0
      370           buf_temp-parts.fact-qnty = 0
      371           buf_temp-parts.real-qnty = 0
      372           buf_temp-parts.cli-qnty  = 0
      373         .
      374       end.
      375     end.
      376   end procedure.
      377   procedure partslib-init-temp-parts :
      378     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      379     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      380     define input parameter p-artic           like ub.parts.artic     no-undo .
      381     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      382     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      383     define buffer buf_parts      for ub.parts .
      384     define buffer buf_temp-parts for temp-parts .
      385     define variable v-goods-twounit    as logical   no-undo .
      386     do
      387     on error undo, return error
      388     :
      389   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      391     (input  p-artic
      392     ,input  p-prod-type
      393     ,input  p-prod-code
      394     ,input  'twounit=request':u
      395     ,output v-goods-twounit
      396     ) no-error .
      397       if error-status :error
      398       then do:
      399         message
      400           vss-workfile vss-revision vss-description skip
      401           vss-include-info1 skip
      402           "Ошибка при определении атрибута товара" skip
      403           "Артикул" p-artic p-prod-type p-prod-code skip
      404           "twounit=request" skip
      405           error-status :get-message(1) skip
      406           return-value skip
      407           view-as alert-box error .
      408         undo, return error return-value .
      409       end.
      410       run partslib-clear-temp-parts in this-procedure .
      411       for each buf_parts
      412         where buf_parts.obj-type  = p-obj-type
      413           and buf_parts.obj-code  = p-obj-code
      414           and buf_parts.artic     = p-artic
      415           and buf_parts.prod-type = p-prod-type
      416           and buf_parts.prod-code = p-prod-code
      417           and buf_parts.rsrv-free = yes
      418           and buf_parts.status_   = no
      419           and buf_parts.in-code   <> buf_parts.out-code
      420       on error undo, return error
      421       :
      422         run partslib-create-temp-parts in this-procedure
      423           (buffer buf_parts
      424           ,buffer buf_temp-parts
      425           ,input  v-goods-twounit
      426           ) .
      427         define variable v-parts-qnty          as decimal   no-undo .
      428         define variable v-parts-cli-qnty      as decimal   no-undo .
      429         define variable v-parts-free-qnty     as decimal   no-undo .
      430         define variable v-parts-free-cli-qnty as decimal   no-undo .
      431         if buf_parts.out-code = 'free-zone':U
      432         then do:
      433           assign
      434             v-parts-qnty          = buf_parts.qnty
      435             v-parts-cli-qnty      = buf_parts.cli-qnty
      436             v-parts-free-qnty     = buf_parts.qnty
      437             v-parts-free-cli-qnty = buf_parts.cli-qnty
      438           .
      439         end.
      440         else do:
      441           assign
      442             v-parts-qnty          = abs(buf_parts.qnty)
      443             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      444             v-parts-free-qnty     = 0
      445             v-parts-free-cli-qnty = 0
      446           .
      447         end.
      448         assign
      449           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      450           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      451           buf_temp-parts.real-qnty     = 0
      452           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      453           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      454           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      455         .
      456       end.
      457     end.
      458   end procedure.
      459   procedure partslib-init-temp-parts-by-factord :
      460     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      461     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      462     define input parameter p-artic              like ub.parts.artic     no-undo .
      463     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      464     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      465     define input parameter p-fact-order         as decimal   no-undo .
      466     define input parameter p-include-fact-order as logical   no-undo .
      467     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      468     define buffer buf_gds-obj  for ub.gds-obj .
      469     do
      470     on error undo, return error
      471     :
      472       do transaction
      473       on error undo, return error
      474       :
      475   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      476   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      477     (input  p-obj-type
      478     ,input  p-obj-code
      479     ,input  p-artic
      480     ,input  p-prod-type
      481     ,input  p-prod-code
      482     ,buffer buf_gds-obj
      483     ) no-error .
      484         if error-status :error
      485         then do:
      486           message
      487             vss-workfile vss-revision vss-description skip
      488             vss-include-info1 skip
      489             "Невозможно найти товар на объекте" skip
      490             "Объект" p-obj-type p-obj-code skip
      491             "Артикул" p-artic p-prod-type p-prod-code skip
      492             error-status :get-message(1) skip
      493             return-value skip
      494             view-as alert-box error .
      495           undo, return error .
      496         end.
      497         find current buf_gds-obj exclusive-lock .
      498       end.
      499       run partslib-init-temp-parts in this-procedure
      500         (input p-obj-type
      501         ,input p-obj-code
      502         ,input p-artic
      503         ,input p-prod-type
      504         ,input p-prod-code
      505         ) no-error .
      506       if error-status :error
      507       then do:
      508         message
      509           vss-workfile vss-revision vss-description skip
      510           vss-include-info1 skip
      511           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      512           "Объект" p-obj-type p-obj-code skip
      513           "Артикул" p-artic p-prod-type p-prod-code skip
      514           "p-fact-order" p-fact-order skip
      515           view-as alert-box error .
      516         undo, return error .
      517       end.
      518       if p-include-fact-order = true
      519       then do:
      520         assign
      521           p-fact-order = p-fact-order - 0.0000000001
      522         .
      523       end.
      524       define variable v-max-fact-order as character no-undo .
      525       run factord-max-fact-order in this-procedure
      526         (output v-max-fact-order
      527         ) no-error .
      528       if error-status :error
      529       then do:
      530         message
      531           vss-workfile vss-revision vss-description skip
      532           vss-include-info1 skip
      533           "Ошибка при вызове процедуры factord-max-fact-order" skip
      534           "Объект" p-obj-type p-obj-code skip
      535           "Артикул" p-artic p-prod-type p-prod-code skip
      536           "p-fact-order" p-fact-order skip
      537           view-as alert-box error .
      538         undo, return error .
      539       end.
      540       run partslib-update-by-factord in this-procedure
      541         (input p-obj-type
      542         ,input p-obj-code
      543         ,input p-artic
      544         ,input p-prod-type
      545         ,input p-prod-code
      546         ,input p-fact-order
      547         ,input v-max-fact-order
      548         ,input false
      549         ) no-error .
      550       if error-status :error
      551       then do:
      552         message
      553           vss-workfile vss-revision vss-description skip
      554           vss-include-info1 skip
      555           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      556           "Объект" p-obj-type p-obj-code skip
      557           "Артикул" p-artic p-prod-type p-prod-code skip
      558           "p-fact-order" p-fact-order skip
      559           "v-max-fact-order" v-max-fact-order skip
      560           view-as alert-box error .
      561         undo, return error .
      562       end.
      563     end.
      564   end procedure.
      565   procedure partslib-update-by-factord :
      566     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      567     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      568     define input parameter p-artic              like ub.parts.artic     no-undo .
      569     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      570     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      571     define input parameter p-start-fact-order   as decimal   no-undo .
      572     define input parameter p-end-fact-order     as decimal   no-undo .
      573     define input parameter p-lock-gds-obj       as logical   no-undo .
      574     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      575     define buffer buf_gds-obj  for ub.gds-obj .
      576     define buffer buf_doc-line for ub.doc-line .
      577     define variable v-total-parts-qnty as decimal   no-undo .
      578     define variable v-goods-gds-goods  as logical   no-undo .
      579     define variable v-goods-twounit    as logical   no-undo .
      580     do
      581     on error undo, return error
      582     :
      583       if p-start-fact-order > p-end-fact-order
      584       then do:
      585         message
      586           vss-workfile vss-revision vss-description skip
      587           vss-include-info1 skip
      588           "Ошибка задания входных параметров" skip
      589           "Начало интервала превышает конец интервала" skip
      590           "Объект" p-obj-type p-obj-code skip
      591           "Артикул" p-artic p-prod-type p-prod-code skip
      592           "p-start-fact-order" p-start-fact-order skip
      593           "p-end-fact-order"   p-end-fact-order skip
      594           view-as alert-box error .
      595         undo, return error .
      596       end.
      597       if p-lock-gds-obj = true
      598       then do:
      599         do transaction
      600         on error undo, return error
      601         :
      602   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      604     (input  p-obj-type
      605     ,input  p-obj-code
      606     ,input  p-artic
      607     ,input  p-prod-type
      608     ,input  p-prod-code
      609     ,buffer buf_gds-obj
      610     ) no-error .
      611           if error-status :error
      612           then do:
      613             message
      614               vss-workfile vss-revision vss-description skip
      615               vss-include-info1 skip
      616               "Невозможно найти gds-obj" skip
      617               error-status :get-message(1) skip
      618               return-value skip
      619               view-as alert-box error .
      620             undo, return error .
      621           end.
      622           find current buf_gds-obj exclusive-lock .
      623         end.
      624       end.
      625   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      627     (input  p-artic
      628     ,input  p-prod-type
      629     ,input  p-prod-code
      630     ,input  'gds-goods=request':u
      631     ,output v-goods-gds-goods
      632     ) no-error .
      633       if error-status :error
      634       then do:
      635         message
      636           vss-workfile vss-revision vss-description skip
      637           vss-include-info1 skip
      638           "Ошибка при определении атрибута товара" skip
      639           "Артикул" p-artic p-prod-type p-prod-code skip
      640           "gds-goods=request" skip
      641           error-status :get-message(1) skip
      642           return-value skip
      643           view-as alert-box error .
      644         undo, return error return-value .
      645       end.
      646   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      647   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      648     (input  p-artic
      649     ,input  p-prod-type
      650     ,input  p-prod-code
      651     ,input  'twounit=request':u
      652     ,output v-goods-twounit
      653     ) no-error .
      654       if error-status :error
      655       then do:
      656         message
      657           vss-workfile vss-revision vss-description skip
      658           vss-include-info1 skip
      659           "Ошибка при определении атрибута товара" skip
      660           "Артикул" p-artic p-prod-type p-prod-code skip
      661           "twounit=request" skip
      662           error-status :get-message(1) skip
      663           return-value skip
      664           view-as alert-box error .
      665         undo, return error return-value .
      666       end.
      667       for each buf_doc-line no-lock
      668         where buf_doc-line.obj-type   = p-obj-type
      669           and buf_doc-line.obj-code   = p-obj-code
      670           and buf_doc-line.artic      = p-artic
      671           and buf_doc-line.prod-type  = p-prod-type
      672           and buf_doc-line.prod-code  = p-prod-code
      673           and buf_doc-line.status_    = 'факт':U
      674           and buf_doc-line.fact-order > p-start-fact-order
      675           and buf_doc-line.fact-order <= p-end-fact-order
      676       on error undo, return error
      677       :
      678         run partslib-process-document in this-procedure
      679           (input  buf_doc-line.doc-code
      680           ,input  p-obj-type
      681           ,input  p-obj-code
      682           ,input  p-artic
      683           ,input  p-prod-type
      684           ,input  p-prod-code
      685           ,input  v-goods-gds-goods
      686           ,input  v-goods-twounit
      687           ,output v-total-parts-qnty
      688           ) no-error .
      689         if error-status :error
      690         then do:
      691           message
      692             vss-workfile vss-revision vss-description skip
      693             vss-include-info1 skip
      694             "Ошибка при вызове процедуры partslib-process-document" skip
      695             "Документ" buf_doc-line.doc-code skip
      696             "Объект" p-obj-type p-obj-code skip
      697             "Артикул" p-artic p-prod-type p-prod-code skip
      698             "p-start-fact-order" p-start-fact-order skip
      699             "p-end-fact-order" p-end-fact-order skip
      700             error-status :get-message(1) skip
      701             return-value skip
      702             view-as alert-box error .
      703           undo, return error return-value .
      704         end.
      705       end.
      706     end.
      707   end procedure.
      708   procedure partslib-process-document :
      709     define input  parameter p-doc-code         as character no-undo .
      710     define input  parameter p-obj-type         as character no-undo .
      711     define input  parameter p-obj-code         as integer   no-undo .
      712     define input  parameter p-artic            as character no-undo .
      713     define input  parameter p-prod-type        as character no-undo .
      714     define input  parameter p-prod-code        as integer   no-undo .
      715     define input  parameter p-goods-gds-goods  as logical   no-undo .
      716     define input  parameter p-goods-twounit    as logical   no-undo .
      717     define output parameter p-total-parts-qnty as decimal   no-undo .
      718     define variable v-parts-sign as integer   no-undo .
      719     define buffer buf_trn-doc    for ub.trn-doc .
      720     define buffer buf_doc-line   for ub.doc-line .
      721     define buffer buf_parts      for ub.parts .
      722     define buffer buf_temp-parts for temp-parts .
      723     do
      724     on error undo, return error return-value
      725     :
      726       find first buf_trn-doc no-lock
      727         where buf_trn-doc.doc-code = p-doc-code
      728         no-error .
      729       if not available buf_trn-doc
      730       then do:
      731         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      732                                      ,p-doc-code
      733                                      ) .
      734       end.
      735       case buf_trn-doc.doc-type
      736       :
      737         when 'при':U or
      738         when 'возврат':U or
      739         when 'инв':U
      740         then do:
      741           assign
      742             v-parts-sign = -1
      743           .
      744         end.
      745         when 'рас':U or
      746         when 'спи':U
      747         then do:
      748           assign
      749             v-parts-sign = 1
      750           .
      751         end.
      752         otherwise do:
      753           undo, return error substitute("Неизвестный тип документа &1"
      754                                       ,buf_trn-doc.doc-type
      755                                       ) .
      756         end.
      757       end.
      758       find first buf_doc-line no-lock
      759         where buf_doc-line.doc-code  = p-doc-code
      760           and buf_doc-line.artic     = p-artic
      761           and buf_doc-line.prod-type = p-prod-type
      762           and buf_doc-line.prod-code = p-prod-code
      763         no-error .
      764       if not available buf_doc-line
      765       then do:
      766         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      767                                      ,p-doc-code
      768                                      ,artic
      769                                      ,prod-type
      770                                      ,prod-code
      771                                      ) .
      772       end.
      773       assign
      774         p-total-parts-qnty = 0
      775       .
      776       if p-goods-gds-goods = true
      777       then do:
      778         for each buf_parts no-lock
      779           where buf_parts.out-code  = p-doc-code
      780             and buf_parts.obj-type  = p-obj-type
      781             and buf_parts.obj-code  = p-obj-code
      782             and buf_parts.artic     = p-artic
      783             and buf_parts.prod-type = p-prod-type
      784             and buf_parts.prod-code = p-prod-code
      785         on error undo, return error
      786         :
      787           run partslib-create-temp-parts in this-procedure
      788             (buffer buf_parts
      789             ,buffer buf_temp-parts
      790             ,input  p-goods-twounit
      791             ) .
      792           assign
      793             p-total-parts-qnty        = p-total-parts-qnty
      794                                       + v-parts-sign * buf_parts.fact-qnty
      795             buf_temp-parts.qnty       = buf_temp-parts.qnty
      796                                       + v-parts-sign * buf_parts.fact-qnty
      797             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      798                                       + v-parts-sign * buf_parts.fact-qnty
      799             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      800                                       + v-parts-sign * buf_parts.cli-qnty
      801           .
      802           if buf_temp-parts.qnty = 0
      803           then do:
      804             delete buf_temp-parts .
      805           end.
      806         end.
      807       end.
      808       else do:
      809         assign
      810           p-total-parts-qnty = p-total-parts-qnty
      811                              + v-parts-sign * buf_doc-line.fact-qnty
      812         .
      813       end.
      814     end.
      815   end procedure.
      816   procedure partslib-init-temp-parts-by-date :
      817     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      818     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      819     define input parameter p-artic           like ub.parts.artic     no-undo .
      820     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      821     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      822     define input parameter p-fact-date       as date      no-undo .
      823     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      824     do
      825     on error undo, return error
      826     :
      827       define variable v-fact-order                as decimal   no-undo .
      828       define variable v-shift-end-fact-order      as decimal   no-undo .
      829       define variable v-day-end-fact-order        as decimal   no-undo .
      830       run factord in this-procedure
      831         (input  p-fact-date
      832         ,input  1
      833         ,input  1
      834         ,input  ?
      835         ,input  0
      836         ,input  false
      837         ,output v-fact-order
      838         ,output v-shift-end-fact-order
      839         ,output v-day-end-fact-order
      840         ) no-error .
      841       if error-status :error
      842       then do:
      843         message
      844           vss-workfile vss-revision vss-description skip
      845           vss-include-info1 skip
      846           "Ошибка при определении момента времени, на который требуется остаток" skip
      847           "Объект" p-obj-type p-obj-code skip
      848           "Артикул" p-artic p-prod-type p-prod-code skip
      849           "Дата" p-fact-date skip
      850           view-as alert-box error .
      851         undo, return error .
      852       end.
      853       run partslib-init-temp-parts-by-factord in this-procedure
      854         (input p-obj-type
      855         ,input p-obj-code
      856         ,input p-artic
      857         ,input p-prod-type
      858         ,input p-prod-code
      859         ,input v-day-end-fact-order
      860         ,input false
      861         ) no-error .
      862       if error-status :error
      863       then do:
      864         message
      865           vss-workfile vss-revision vss-description skip
      866           vss-include-info1 skip
      867           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      868           "Объект" p-obj-type p-obj-code skip
      869           "Артикул" p-artic p-prod-type p-prod-code skip
      870           "Дата" p-fact-date skip
      871           view-as alert-box error .
      872         undo, return error .
      873       end.
      874     end.
      875   end procedure.
      876   procedure partslib-calc-cost :
      877     define output parameter p-fact-qnty      as decimal   no-undo .
      878     define output parameter p-vat-pc         as decimal   no-undo .
      879     define output parameter p-slt-pc         as decimal   no-undo .
      880     define output parameter p-sum-base       as decimal   no-undo .
      881     define output parameter p-sum-rubl       as decimal   no-undo .
      882     define output parameter p-vat-base       as decimal   no-undo .
      883     define output parameter p-vat-rubl       as decimal   no-undo .
      884     define output parameter p-slt-base       as decimal   no-undo .
      885     define output parameter p-slt-rubl       as decimal   no-undo .
      886     define output parameter p-road-tax-base  as decimal   no-undo .
      887     define output parameter p-road-tax-rubl  as decimal   no-undo .
      888     define output parameter p-transport-base as decimal   no-undo .
      889     define output parameter p-transport-rubl as decimal   no-undo .
      890     define output parameter p-other-base     as decimal   no-undo .
      891     define output parameter p-other-rubl     as decimal   no-undo .
      892     define output parameter p-excise-base    as decimal   no-undo .
      893     define output parameter p-excise-rubl    as decimal   no-undo .
      894     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      895     do
      896     on error undo, return error return-value
      897     :
      898       define buffer buf_temp-parts for temp-parts .
      899       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      900       define buffer   in-vatp-parts    for ub.parts   .
      901       define buffer   in-vatp-doc      for ub.trn-doc .
      902       define buffer   in-vatp-goods    for ub.goods   .
      903       define buffer   in-vatp-sysconf  for ub.sysconf .
      904       define buffer   in-vatp_doc-attr for ub.doc-attr.
      905       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      906       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      907       define variable varinvprb                  as   character              no-undo.
      908       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      909       define variable cli-base-rate              as   decimal                no-undo.
      910       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      911       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      912       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      913       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      914       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      915       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      916       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      917       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      918       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      919       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      920       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      921       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      922       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      923       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      924       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      925       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      926       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      927       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      928       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      929       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      930       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      931       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      932       define variable varinvatp-envd             as   character              no-undo.
      933       define variable varinvatp-type             as   character              no-undo.
      934       for each buf_temp-parts
      935       on error undo, return error
      936       :
      937   assign
      938     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      939     price-base-with-tax-loc = buf_temp-parts.price-base
      940   .
      941   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      942   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      943     (output varinvprb
      944     )  .
      945     if buf_temp-parts.out-code = 'free-zone':U     or
      946        buf_temp-parts.out-code = 'out-zone':U   or
      947        buf_temp-parts.doc-type = 'акт':U then do:
      948       assign
      949         in-vatp-have-vat-slt = yes.
      950     end.
      951     else do:
      952       find first in-vatp_doc-attr no-lock
      953         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      954           and in-vatp_doc-attr.attr-code = 'envd':U
      955         no-error .
      956       if not available in-vatp_doc-attr then do:
      957         assign
      958           in-vatp-have-vat-slt = yes.
      959       end.
      960       else do:
      961            in-vatp-have-vat-slt = no.
      962       end.
      963     end.
      964     assign
      965      price-cli-with-tax-loc = buf_temp-parts.price-cli
      966      cli-base-rate          = buf_temp-parts.cli-base-rate.
      967     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      968              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      969     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      970             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      971             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      972             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      973             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      974             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      975             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      976       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      977     assign
      978       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      979     assign
      980       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      981       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      982       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      983       transport-cli-loc  = 0
      984       other-cli-loc      = 0
      985     .
      986   ASSIGN
      987             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      988       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      989   .
      990         assign
      991           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      992           p-vat-pc         = p-vat-pc         + vat-pc-loc
      993           p-slt-pc         = p-slt-pc         + slt-pc-loc
      994           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      995           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      996           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      997           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      998           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      999           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1000           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1001           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1002           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1003           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1004           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1005           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1006           p-excise-base    = p-excise-base    + 0
     1007           p-excise-rubl    = p-excise-rubl    + 0
     1008         .
     1009       end.
     1010       if p-fact-qnty      = ?
     1011       or p-sum-base       = ?
     1012       or p-sum-rubl       = ?
     1013       or p-vat-base       = ?
     1014       or p-vat-rubl       = ?
     1015       or p-slt-base       = ?
     1016       or p-slt-rubl       = ?
     1017       or p-road-tax-base  = ?
     1018       or p-road-tax-rubl  = ?
     1019       or p-transport-base = ?
     1020       or p-transport-rubl = ?
     1021       or p-other-base     = ?
     1022       or p-other-rubl     = ?
     1023       or p-excise-base    = ?
     1024       or p-excise-rubl    = ?
     1025       then do:
     1026         message
     1027           vss-workfile vss-revision vss-description skip
     1028           vss-include-info1 skip
     1029           "Программа in-vatp.i вернула неопределенные значения" skip
     1030           "p-fact-qnty"      p-fact-qnty      skip
     1031           "p-sum-base"       p-sum-base       skip
     1032           "p-sum-rubl"       p-sum-rubl       skip
     1033           "p-vat-base"       p-vat-base       skip
     1034           "p-vat-rubl"       p-vat-rubl       skip
     1035           "p-slt-base"       p-slt-base       skip
     1036           "p-slt-rubl"       p-slt-rubl       skip
     1037           "p-road-tax-base"  p-road-tax-base  skip
     1038           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1039           "p-transport-base" p-transport-base skip
     1040           "p-transport-rubl" p-transport-rubl skip
     1041           "p-other-base"     p-other-base     skip
     1042           "p-other-rubl"     p-other-rubl     skip
     1043           "p-excise-base"    p-excise-base    skip
     1044           "p-excise-rubl"    p-excise-rubl    skip
     1045           view-as alert-box error .
     1046         undo, return error .
     1047       end.
     1048     end.
     1049   end procedure.
