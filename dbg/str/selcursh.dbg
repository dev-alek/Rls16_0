        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-obj-type like ub.inkas.obj-type no-undo .
        3   define input parameter p-curr-obj-code like ub.inkas.obj-code no-undo .
        4   define input parameter p-base-code like ub.sysconf.base-code no-undo .
        5   DEFINE INPUT PARAMETER inkas-date like ub.inkas.doc-date.
        6   DEFINE INPUT PARAMETER day-only like ub.shop.day-only.
        7   DEFINE INPUT-OUTPUT PARAMETER cursh like ub.curr-shop.exch-rate.
        8   DEFINE OUTPUT PARAMETER cursh-scale like ub.curr-shop.exch-scale.
        9   DEFINE INPUT-OUTPUT PARAMETER cursh-date1 like ub.curr-shop.exch-date.
       10   DEFINE OUTPUT PARAMETER cursh-date2 like ub.curr-shop.exch-date.
       11   DEFINE INPUT-OUTPUT PARAMETER cursh-time1 like ub.curr-shop.exch-time.
       12   DEFINE OUTPUT PARAMETER cursh-time2 like ub.curr-shop.exch-time.
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Выбор курса чеков, которые будут входить в продажу".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   procedure proc-alt-shift-f2:
       89     if not ibs.th.gbl.gbl-var:rcode
       90   then
       91     run gbl\inidebug.p .
       92   end.
       93   procedure proc-alt-shift-f3:
       94     run gbl/prvssinf.p
       95       ( input this-procedure
       96       ) .
       97   end.
       98   define variable v-inform-launched as logical no-undo initial false .
       99   procedure proc-alt-shift-f4:
      100     define variable v-action as character no-undo .
      101     if v-inform-launched = false then do:
      102       assign
      103         v-inform-launched = true
      104       .
      105       run gbl/d-inform.w
      106         (  input self
      107         ,  input this-procedure
      108         , output v-action
      109         ) no-error .
      110       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      111       assign
      112         v-inform-launched = false
      113       .
      114     end.
      115   end.
      116   procedure proc-alt-f1:
      117     run gbl/corrhelp.p
      118       (input this-procedure
      119       ) .
      120   end .
      121   on alt-shift-f2 anywhere do:
      122     run proc-alt-shift-f2.
      123   end.
      124   on alt-shift-f3 anywhere do:
      125     run proc-alt-shift-f3 in this-procedure .
      126   end.
      127   on alt-shift-f4 anywhere do:
      128     run proc-alt-shift-f4 in this-procedure.
      129   end.
      130   on alt-f1 anywhere do:
      131     run proc-alt-f1 in this-procedure .
      132   end.
      133   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   procedure cur-time :
      135      define output parameter p-today as date      no-undo .
      136      define output parameter p-time  as integer   no-undo .
      137     do
      138     on error undo, return error
      139     :
      140       define variable v-date1 as date      no-undo .
      141       define variable v-date2 as date      no-undo .
      142       define variable v-time  as integer   no-undo .
      143       assign
      144         v-date1 = today
      145         v-time  = time
      146         v-date2 = today
      147       .
      148       if v-date1 <> v-date2
      149       then do:
      150         assign
      151           v-date1 = today
      152           v-time  = v-time
      153         .
      154       end.
      155       assign
      156         p-today = v-date1
      157         p-time  = v-time
      158       .
      159     end.
      160   end.
      161   function cur-time-date returns character
      162   :
      163     return string(today, '99/99/9999':U) .
      164   end.
      165   function cur-time-mjd returns decimal
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return integer(v-date) - 2400002 + (v-time / 86400) .
      174   end.
      175   function cur-time-get-ending-index returns integer
      176   (input p-number as integer
      177   )
      178   :
      179     if p-number < 0
      180     or p-number = ?
      181     then do:
      182       return 1 .
      183     end.
      184     define variable v-rest as integer   no-undo .
      185     assign
      186       p-number = p-number modulo 100
      187     .
      188     if p-number < 20
      189     then do:
      190       assign
      191         v-rest = p-number
      192       .
      193     end.
      194     else do:
      195       assign
      196         v-rest = p-number modulo 10
      197       .
      198     end.
      199     case v-rest :
      200       when 1
      201       then do:
      202         return 2 .
      203       end.
      204       when 2 or
      205       when 3 or
      206       when 4
      207       then do:
      208         return 3 .
      209       end.
      210       otherwise do:
      211         return 1 .
      212       end.
      213     end case .
      214   end.
      215   procedure cur-time-mjd-to-date :
      216      define input  parameter i-mjd-diff as decimal no-undo.
      217      define output parameter o-Date     as date    no-undo.
      218      define output parameter o-Time     as integer no-undo.
      219      define variable v-day-number as integer   no-undo .
      220      if    i-mjd-diff < 0
      221         or i-mjd-diff = ?
      222      then do:
      223         return "?" .
      224      end.
      225      assign
      226         v-day-number = truncate(i-mjd-diff,0).
      227         o-Date = date(v-day-number + 2400002).
      228         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230   end.
      231   function cur-time-mjd-to-string returns character
      232   (input p-mjd-diff as decimal
      233   )
      234   :
      235     define variable v-day-number as integer   no-undo .
      236     define variable v-seconds    as integer   no-undo .
      237     define variable v-hour       as integer   no-undo .
      238     define variable v-min        as integer   no-undo .
      239     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      240     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      241     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      242     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      243     if p-mjd-diff < 0
      244     or p-mjd-diff = ?
      245     then do:
      246       return "?" .
      247     end.
      248     assign
      249       v-day-number = integer(truncate(p-mjd-diff,0))
      250       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252     if v-seconds > 86400
      253     then do:
      254       assign
      255         v-seconds = 86400 - 1
      256       .
      257     end.
      258     if v-seconds < 0
      259     then do:
      260       assign
      261         v-seconds = 0
      262       .
      263     end.
      264     assign
      265       v-hour = truncate(v-seconds / 3600, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 3600
      269     .
      270     assign
      271       v-min = truncate(v-seconds / 60, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 60
      275     .
      276     return
      277         (if v-day-number <> 0
      278           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0
      282           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      286           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      287           else ""
      288         )
      289       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      290       .
      291   end.
      292   function cur-time-string returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-string-sec returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      311   end.
      312   function cur-time-custom  returns character
      313   (input p-prefix as character
      314   ,input p-date-format as character
      315   ,input p-delimiter as character
      316   ,input p-time-format as character
      317   ,input p-suffix as character
      318   )
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return
      327       p-prefix
      328       + string(v-date, p-date-format)
      329       + p-delimiter
      330       + string(v-time, p-time-format)
      331       + p-suffix
      332       .
      333   end.
      334   function cur-time-print  returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-datetime returns datetime
      345   :
      346     define variable v-char as character no-undo .
      347     define variable v-datetime as datetime no-undo .
      348     v-char = cur-time-string().
      349     v-datetime = datetime(v-char).
      350     return  v-datetime.
      351   end.
      352   function cur-time-string-msec returns character
      353   :
      354     define variable v-date as datetime  no-undo .
      355     v-date = now.
      356     return string(v-date) .
      357   end.
      358   DEFINE BUFFER b-cs for ub.curr-shop.
      359   DEFINE VARIABLE yesterday as logical initial no no-undo.
      360   define variable cas-curs as logical no-undo init no.
      361   define variable added as logical init no no-undo.
      362   define variable b-added as logical init no no-undo.
      363   define variable v-param-type as character no-undo .
      364   define variable v-value-character as character no-undo .
      365   define variable v-value-date as date no-undo .
      366   define variable v-value-decimal as decimal no-undo .
      367   define variable v-value-integer as INTEGER no-undo .
      368   define variable v-value-logical AS LOGICAL no-undo .
      369   define variable v-tth as handle no-undo .
      370   DEFINE BUTTON B-add
      371        LABEL "&Другой"
      372        SIZE 10 BY 1.13
      373        BGCOLOR 8 .
      374   DEFINE BUTTON B-help
      375        LABEL "Помо&щь"
      376        SIZE 10 BY 1.13
      377        BGCOLOR 8 .
      378   DEFINE BUTTON B-quit AUTO-END-KEY
      379        LABEL "&Отмена"
      380        SIZE 10 BY 1.13
      381        BGCOLOR 8 .
      382   DEFINE BUTTON B-Sel AUTO-GO
      383        LABEL "Вы&бор "
      384        SIZE 10 BY 1.13
      385        BGCOLOR 8 .
      386   DEFINE VARIABLE FILL-cursh AS DECIMAL FORMAT ">>,>>9.9999":U INITIAL 0
      387        LABEL "Укажите другой курс"
      388        VIEW-AS FILL-IN
      389        SIZE 18.88 BY 1 NO-UNDO.
      390   DEFINE QUERY BROWSE-1 FOR
      391         ub.curr-shop SCROLLING.
      392   DEFINE BROWSE BROWSE-1
      393     QUERY BROWSE-1 DISPLAY
      394         ub.curr-shop.exch-rate
      395         ub.curr-shop.exch-scale
      396         ub.curr-shop.exch-date FORMAT "99/99/9999"
      397         STRING (ub.curr-shop.exch-time,"HH:MM:SS") COLUMN-LABEL "Время"
      398       WITH NO-ROW-MARKERS SIZE 40.88 BY 9.67.
      399   DEFINE FRAME Dialog-Frame
      400        B-Sel AT ROW 1.21 COL 1.88
      401        B-quit AT ROW 1.21 COL 12.13
      402        B-help AT ROW 1.21 COL 35.38
      403        B-add AT ROW 1.25 COL 22.5
      404        FILL-cursh AT ROW 2.75 COL 23.13 COLON-ALIGNED
      405        BROWSE-1 AT ROW 4 COL 3.63
      406        SPACE(2.86) SKIP(0.86)
      407       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      408            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      409            TITLE "Курс базовой валюты"
      410            DEFAULT-BUTTON B-Sel CANCEL-BUTTON B-quit.
      411   ASSIGN
      412          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      413          FRAME Dialog-Frame:HIDDEN           = TRUE.
      414   ASSIGN
      415          B-add:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      416   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      417   DO:
      418     APPLY "END-ERROR":U TO SELF.
      419   END.
      420   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      421   DO:
      422     ENABLE FILL-cursh with frame Dialog-Frame.
      423     APPLY "ENTRY" to FILL-cursh.
      424   END.
      425   ON CHOOSE OF B-Sel IN FRAME Dialog-Frame
      426   DO:
      427     if not added then do:
      428         if not available ub.curr-shop then return no-apply.
      429         assign
      430         cursh = ub.curr-shop.exch-rate
      431         cursh-scale = ub.curr-shop.exch-scale.
      432         RUN DIAPAZON.
      433     end.
      434   END.
      435   ON LEAVE OF FILL-cursh IN FRAME Dialog-Frame
      436   DO:
      437   define variable glog as logical no-undo .
      438     if NOT b-added then dO:
      439       message "Чтобы подтвердить выбор указанного курса"
      440               "нажмите ДА, чтобы отказаться нажмите НЕТ"
      441               view-as alert-box QUESTION buttons YES-NO update glog.
      442     end.
      443     if glog then do:
      444       APPLY "RETURN" to FILL-CURSH.
      445     end.
      446     hide FILL-cursh in frame Dialog-Frame.
      447   END.
      448   ON RETURN OF FILL-cursh IN FRAME Dialog-Frame
      449   DO:
      450     define variable found as logical init no no-undo.
      451     define variable glog as logical no-undo .
      452     assign
      453     fill-cursh.
      454     FOR EACH b-cs WHERE b-cs.curr-code = p-base-code
      455                     AND b-cs.obj-type = p-curr-obj-type
      456                     AND b-cs.obj-code = p-curr-obj-code
      457                     AND (b-cs.exch-date = inkas-date OR
      458                         (yesterday AND b-cs.exch-date <= inkas-date)
      459                         )
      460                     AND b-cs.exch-rate / b-cs.exch-scale = fill-cursh
      461                     NO-LOCK  BY b-cs.exch-date DESCENDING
      462                              BY b-cs.exch-time DESCENDING:
      463          found = yes.
      464          LEAVE.
      465     end.
      466     if not found then do:
      467         message "Вы уверены, что хотите закачивать в продажу чеки с курсом," skip
      468                 "который не был официальным курсом магазина?" view-as alert-box question
      469                 buttons YEs-NO update glog.
      470       if glog then do:
      471           assign
      472           cursh = fill-cursh
      473           cursh-scale = 1
      474           added = yes.
      475       end.
      476       else return no-apply.
      477     end.
      478     else do:
      479       assign
      480       cursh = fill-cursh
      481       cursh-scale = 1
      482       added = yes.
      483       find first ub.curr-shop where recid(ub.curr-shop) = recid(b-cs) No-LOCK NO-ERROR.
      484     end.
      485     assign
      486     b-added = yes.
      487     APPLY "CHOOSE" TO b-sel.
      488   END.
      489   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      490   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      491   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   on help of frame Dialog-Frame
      493   do:
      494     run gbl/app_help.p
      495       (input this-procedure :file-name
      496       ,input ''
      497       ,input ?
      498       ) no-error.
      499     if error-status :error then do:
      500       message
      501         "Ошибка при вызове помощи"
      502         error-status :get-message(1)
      503         view-as alert-box .
      504     end.
      505   end.
      506   run minbtn-set in this-procedure .
      507   on choose of b-help in frame Dialog-Frame
      508   do:
      509     apply "help":u to frame Dialog-Frame .
      510   end.
      511   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      512   procedure minbtn-set :
      513       do
      514           on error undo, return error return-value
      515           :
      516           define variable ii              as integer       no-undo .
      517           define variable fh              as widget-handle no-undo .
      518           define variable hh              as widget-handle no-undo .
      519           define variable v-h             as handle        extent 4 no-undo .
      520           define variable v-name-button   as character     no-undo .
      521           define variable v-help-old-x    as decimal       no-undo .
      522           define variable v-help-old-y    as decimal       no-undo .
      523           define variable v-help-old-size as decimal       no-undo .
      524           define variable v-frame-width   as decimal       no-undo .
      525           define variable jj              as integer       no-undo .
      526           do
      527               on error undo, return error
      528               :
      529               assign
      530                   v-frame-width = frame Dialog-Frame:width - 0.3
      531                   fh            = frame Dialog-Frame:first-child
      532                   hh            = fh:first-child
      533                   ii            = 1
      534                   .
      535               do while valid-handle(hh):
      536                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      537                   do:
      538                       case lc(hh:name) :
      539                           when "b-help" then
      540                               do:
      541                                   hh:load-image-up("cmp/b-help.bmp":u) .
      542                                   hh:load-image-down("cmp/b-help.bmp":u) .
      543                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      544                                   hh:TOOLTIP = "Помощь" .
      545                                   v-help-old-x = hh:column .
      546                                   v-help-old-y = hh:row    .
      547                                   v-help-old-size = hh:width .
      548                                   hh:width-chars = 2.5 .
      549                               end.
      550                           when "b-print" then
      551                               do:
      552                                   hh:load-image("cmp/b-print.bmp":u) .
      553                                   hh:TOOLTIP = "Печать" .
      554                                   v-h[ii] = hh:handle .
      555                                   ii = ii + 1 .
      556                                   hh:width-chars = 3 .
      557                               end.
      558                           when "b-history" or
      559                           when "b-hist" then
      560                               do:
      561                                   hh:load-image("cmp/b-hist.bmp":u) .
      562                                   hh:TOOLTIP = "История" .
      563                                   v-h[ii] = hh:handle .
      564                                   ii = ii + 1 .
      565                                   hh:width-chars = 3 .
      566                               end.
      567                           when "b-sch" then
      568                               do:
      569                                   hh:load-image("cmp/b-sch.bmp":u) .
      570                                   hh:TOOLTIP = "Установка Фильтра" .
      571                                   v-h[ii] = hh:handle .
      572                                   ii = ii + 1 .
      573                                   hh:width-chars = 3 .
      574                               end.
      575                           when "b-hist-user" then
      576                               do:
      577                                   hh:load-image("cmp/b-hist.bmp":u) .
      578                                   hh:TOOLTIP = "История пользователя" .
      579                                   ii = ii + 1 .
      580                               end.
      581                       end case.
      582                   end.
      583                   hh = hh:next-sibling.
      584               end.
      585               b-help:column = v-frame-width - b-help:width-chars.
      586               jj = 0.
      587               repeat ii = 4 to 1 by -1 :
      588                   if valid-handle (v-h[ii] ) then
      589                   do:
      590                       jj  = jj + 1 .
      591                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      592                       v-h[ii]:row    = v-help-old-y .
      593                   end.
      594               end.
      595           end.
      596       end.
      597   end procedure.
      598   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      599   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      600   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      601   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      602   define variable v-diasize-current-frame-width  as decimal   no-undo .
      603   define variable v-diasize-current-frame-height as decimal   no-undo .
      604   define variable v-diasize-change-size          as logical   no-undo .
      605   define variable v-diasize-resize-button        as handle    no-undo .
      606   define variable v-diasize-wndmax               as logical   no-undo .
      607   define variable v-diasize-wndstore             as logical   no-undo .
      608   define variable v-diasize-proc-name            as character no-undo .
      609   define variable v-diasize-browse-handle        as handle    no-undo .
      610   define variable v-diasize-browse-number        as integer   no-undo .
      611   define variable v-diasize-need-full-display    as logical   no-undo init false .
      612   define temp-table temp-diasize-handle no-undo
      613     field handle-value  as handle
      614     field save-position as decimal
      615     index xpk is primary unique handle-value
      616     .
      617   define temp-table temp-browse-handle no-undo
      618     field browse-type   as character
      619     field browse-number as integer
      620     field browse-handle as handle
      621     field original-size as decimal
      622     index xpk is primary unique browse-type browse-number
      623     index xie browse-type browse-handle
      624   .
      625   procedure diasize_change-height :
      626     define input  parameter p-change-value  as decimal   no-undo .
      627     define input  parameter p-move-resize   as logical   no-undo .
      628     define variable v-field-group-handle    as handle    no-undo .
      629     define variable v-object-handle         as handle    no-undo .
      630     define variable v-frame-height          as decimal   no-undo .
      631     define variable v-frame-virtual-height  as decimal   no-undo .
      632     define variable v-browse-height         as decimal   no-undo .
      633     define variable v-window-height         as decimal   no-undo .
      634     define variable v-window-virtual-height as decimal   no-undo .
      635     define variable v-change-sign           as integer   no-undo .
      636     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      637     define buffer buf_temp-browse-handle  for temp-browse-handle .
      638     if p-change-value > 0
      639     then do:
      640       if frame Dialog-Frame :height + p-change-value
      641           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      642       then do:
      643         assign
      644           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      645                           - (frame Dialog-Frame :height-chars)
      646         .
      647         if p-change-value <= 0
      648         then do:
      649           run diasize_position-resize-button in this-procedure .
      650           return .
      651         end.
      652       end.
      653     end.
      654     if p-change-value < 0
      655     then do:
      656       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      657       then do:
      658         assign
      659           p-change-value = v-diasize-orig-frame-height
      660                          - (frame Dialog-Frame :height-chars)
      661         .
      662         if p-change-value >= 0
      663         then do:
      664           run diasize_position-resize-button in this-procedure .
      665           return .
      666         end.
      667       end.
      668     end.
      669     if p-change-value >= 0
      670     then do:
      671       assign
      672         v-change-sign = 1
      673       .
      674     end.
      675     else do:
      676       assign
      677         v-change-sign = -1
      678       .
      679     end.
      680     assign
      681       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      682     .
      683     if p-change-value = 0
      684     then do:
      685       run diasize_position-resize-button in this-procedure .
      686       return .
      687     end.
      688     move_block:
      689     do
      690     on error undo move_block, retry move_block
      691     :
      692       if retry
      693       then do:
      694         do
      695         on error undo move_block, leave move_block
      696         :
      697           if p-change-value > 0
      698           then do:
      699             for each buf_temp-diasize-handle
      700             on error undo, next
      701             :
      702               assign
      703                 v-object-handle = buf_temp-diasize-handle.handle-value
      704               .
      705               if v-object-handle <> v-diasize-resize-button
      706               then do:
      707                 assign
      708                   v-object-handle :row = buf_temp-diasize-handle.save-position
      709                 .
      710               end.
      711             end.
      712             assign
      713               v-diasize-browse-handle :height = v-browse-height
      714             .
      715             for each buf_temp-browse-handle
      716               where buf_temp-browse-handle.browse-type = 'height':u
      717             on error undo, next
      718             :
      719               assign
      720                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      721               .
      722             end.
      723             assign
      724               frame Dialog-Frame :height = v-frame-height
      725             .
      726             if frame Dialog-Frame :scrollable = true
      727             then do:
      728               assign
      729                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      730               .
      731             end.
      732             run diasize_position-resize-button in this-procedure .
      733           end.
      734           else do:
      735             if frame Dialog-Frame :scrollable = true
      736             then do:
      737               assign
      738                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      739               .
      740             end.
      741             assign
      742               frame Dialog-Frame :height = v-frame-height
      743             .
      744             assign
      745               v-diasize-browse-handle :height = v-browse-height
      746             .
      747             for each buf_temp-browse-handle
      748               where buf_temp-browse-handle.browse-type = 'height':u
      749             on error undo, next
      750             :
      751               assign
      752                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      753               .
      754             end.
      755             for each buf_temp-diasize-handle
      756             on error undo, next
      757             :
      758               assign
      759                 v-object-handle = buf_temp-diasize-handle.handle-value
      760               .
      761               if v-object-handle <> v-diasize-resize-button
      762               then do:
      763                 assign
      764                   v-object-handle :row = buf_temp-diasize-handle.save-position
      765                 .
      766               end.
      767             end.
      768             run diasize_position-resize-button in this-procedure .
      769           end.
      770           assign
      771             v-diasize-change-size = false
      772           .
      773           leave move_block .
      774         end.
      775       end.
      776       assign
      777         v-diasize-need-full-display = true
      778       .
      779       if v-diasize-change-size = false
      780       then do:
      781         assign
      782           v-diasize-change-size = true
      783         .
      784       end.
      785       else do:
      786         return .
      787       end.
      788       assign
      789         v-frame-height = frame Dialog-Frame :height
      790         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      791         v-browse-height = v-diasize-browse-handle :height
      792       .
      793       for each buf_temp-browse-handle
      794         where buf_temp-browse-handle.browse-type = 'height':u
      795       :
      796         assign
      797           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      798         .
      799       end.
      800       for each buf_temp-diasize-handle
      801       :
      802         delete buf_temp-diasize-handle .
      803       end.
      804       assign
      805         v-field-group-handle = frame Dialog-Frame :first-child
      806       .
      807       do while valid-handle(v-field-group-handle)
      808       :
      809         assign
      810           v-object-handle = v-field-group-handle :first-child
      811         .
      812         do while valid-handle(v-object-handle)
      813         :
      814           if  v-object-handle <> v-diasize-browse-handle :handle
      815           and can-query(v-object-handle, "row")
      816           and can-query(v-object-handle, "height")
      817           and ( v-object-handle :row > v-diasize-browse-handle :row )
      818           then do:
      819             find first buf_temp-browse-handle
      820               where buf_temp-browse-handle.browse-type   = 'height':u
      821                 and buf_temp-browse-handle.browse-handle = v-object-handle
      822               no-error .
      823             if available buf_temp-browse-handle
      824             then do:
      825             end.
      826             else do:
      827               create buf_temp-diasize-handle .
      828               assign
      829                 buf_temp-diasize-handle.handle-value  = v-object-handle
      830                 buf_temp-diasize-handle.save-position = v-object-handle :row
      831               .
      832             end.
      833           end.
      834           assign
      835             v-object-handle = v-object-handle :next-sibling
      836           .
      837         end.
      838         assign
      839           v-field-group-handle = v-field-group-handle :next-sibling
      840         .
      841       end.
      842       do with frame Dialog-Frame
      843       :
      844         hide v-diasize-resize-button .
      845         assign
      846           v-diasize-resize-button :row    = 1
      847           v-diasize-resize-button :column = 1
      848         .
      849       end.
      850       if p-change-value > 0
      851       then do:
      852         if frame Dialog-Frame :scrollable = true
      853         then do:
      854           assign
      855             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      856             no-error .
      857           if error-status :error
      858           or error-status :get-message(1) <> ""
      859           then do:
      860             undo move_block, retry move_block .
      861           end.
      862         end.
      863         assign
      864           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      865           no-error .
      866         if error-status :error
      867         or error-status :get-message(1) <> ""
      868         then do:
      869           undo move_block, retry move_block .
      870         end.
      871         assign
      872           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      873           no-error .
      874         if error-status :error
      875         or error-status :get-message(1) <> ""
      876         then do:
      877           undo move_block, retry move_block .
      878         end.
      879         for each buf_temp-browse-handle
      880           where buf_temp-browse-handle.browse-type = 'height':u
      881         on error undo move_block, retry move_block
      882         :
      883           assign
      884             buf_temp-browse-handle.browse-handle :height
      885               = buf_temp-browse-handle.browse-handle :height + p-change-value
      886             no-error .
      887           if error-status :error
      888           or error-status :get-message(1) <> ""
      889           then do:
      890             undo move_block, retry move_block .
      891           end.
      892         end.
      893         for each buf_temp-diasize-handle
      894         on error undo move_block, retry move_block
      895         :
      896           assign
      897             v-object-handle = buf_temp-diasize-handle.handle-value
      898           .
      899           if v-object-handle <> v-diasize-resize-button
      900           then do:
      901             assign
      902               v-object-handle :row = v-object-handle :row + p-change-value
      903               no-error .
      904             if error-status :error
      905             or error-status :get-message(1) <> ""
      906             then do:
      907               undo move_block, retry move_block .
      908             end.
      909           end.
      910         end.
      911       end.
      912       else do:
      913         for each buf_temp-diasize-handle
      914         on error undo move_block, retry move_block
      915         :
      916           assign
      917             v-object-handle = buf_temp-diasize-handle.handle-value
      918           .
      919           if v-object-handle <> v-diasize-resize-button
      920           then do:
      921             assign
      922               v-object-handle :row = v-object-handle :row + p-change-value
      923               no-error .
      924             if error-status :error
      925             or error-status :get-message(1) <> ""
      926             then do:
      927               undo move_block, retry move_block .
      928             end.
      929           end.
      930         end.
      931         assign
      932           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      933           no-error .
      934         if error-status :error
      935         or error-status :get-message(1) <> ""
      936         then do:
      937           undo move_block, retry move_block .
      938         end.
      939         for each buf_temp-browse-handle
      940           where buf_temp-browse-handle.browse-type = 'height':u
      941         on error undo move_block, retry move_block
      942         :
      943           assign
      944             buf_temp-browse-handle.browse-handle :height
      945               = buf_temp-browse-handle.browse-handle :height + p-change-value
      946             no-error .
      947           if error-status :error
      948           or error-status :get-message(1) <> ""
      949           then do:
      950             undo move_block, retry move_block .
      951           end.
      952         end.
      953         assign
      954           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      955           no-error .
      956         if error-status :error
      957         or error-status :get-message(1) <> ""
      958         then do:
      959           undo move_block, retry move_block .
      960         end.
      961         if frame Dialog-Frame :scrollable = true
      962         then do:
      963           assign
      964             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      965             no-error .
      966           if error-status :error
      967           or error-status :get-message(1) <> ""
      968           then do:
      969             undo move_block, retry move_block .
      970           end.
      971         end.
      972       end.
      973       if p-move-resize = true
      974       then do:
      975         run diasize_position-resize-button in this-procedure .
      976       end.
      977       if v-diasize-wndstore = true
      978       then do:
      979         if connected("ub") = true
      980         then do:
      981           define variable v-cntxt-db-num        as integer   no-undo .
      982           define variable v-cntxt-userid        as character no-undo .
      983           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      984                                             , OUTPUT v-cntxt-userid
      985                                             ) .
      986           run gbl/wndsizew.p
      987             (input  v-cntxt-db-num
      988             ,input  v-cntxt-userid
      989             ,input  v-diasize-proc-name
      990             ,input  'height':u
      991             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      992             ) .
      993         end.
      994       end.
      995     end.
      996     assign
      997       v-diasize-change-size = false
      998     .
      999   end procedure.
     1000   procedure diasize_set-height :
     1001     define input  parameter p-new-height  as decimal   no-undo .
     1002     define input  parameter p-move-resize as logical   no-undo .
     1003     do
     1004     on error undo, return error return-value
     1005     :
     1006       run diasize_change-height in this-procedure
     1007         (input  (p-new-height - frame Dialog-Frame :height)
     1008         ,input  p-move-resize
     1009         ) .
     1010     end.
     1011   end procedure.
     1012   procedure diasize_change-width :
     1013     define input  parameter p-change-value as decimal   no-undo .
     1014     define input  parameter p-move-resize  as logical   no-undo .
     1015     define variable v-field-group-handle   as handle    no-undo .
     1016     define variable v-object-handle        as handle    no-undo .
     1017     define variable v-frame-width          as decimal   no-undo .
     1018     define variable v-frame-virtual-width  as decimal   no-undo .
     1019     define variable v-browse-width         as decimal   no-undo .
     1020     define variable v-window-width         as decimal   no-undo .
     1021     define variable v-window-virtual-width as decimal   no-undo .
     1022     define variable v-change-sign          as integer   no-undo .
     1023     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1024     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1025     if p-change-value > 0
     1026     then do:
     1027       if frame Dialog-Frame :width + p-change-value >
     1028           session :width-chars
     1029       then do:
     1030         assign
     1031           p-change-value = session :width-chars - frame Dialog-Frame :width
     1032         .
     1033         if p-change-value <= 0
     1034         then do:
     1035           run diasize_position-resize-button in this-procedure .
     1036           return .
     1037         end.
     1038       end.
     1039     end.
     1040     if p-change-value < 0
     1041     then do:
     1042       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1043       then do:
     1044         assign
     1045           p-change-value = v-diasize-orig-frame-width
     1046                          - frame Dialog-Frame :width
     1047         .
     1048         if p-change-value >= 0
     1049         then do:
     1050           run diasize_position-resize-button in this-procedure .
     1051           return .
     1052         end.
     1053       end.
     1054     end.
     1055     if p-change-value >= 0
     1056     then do:
     1057       assign
     1058         v-change-sign = 1
     1059       .
     1060     end.
     1061     else do:
     1062       assign
     1063         v-change-sign = -1
     1064       .
     1065     end.
     1066     assign
     1067       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1068     .
     1069     if p-change-value = 0
     1070     then do:
     1071       run diasize_position-resize-button in this-procedure .
     1072       return .
     1073     end.
     1074     move_block:
     1075     do
     1076     on error undo move_block, leave move_block
     1077     :
     1078       if retry
     1079       then do:
     1080         do
     1081         on error undo move_block, leave move_block
     1082         :
     1083           if p-change-value > 0
     1084           then do:
     1085             for each buf_temp-diasize-handle
     1086             on error undo, next
     1087             :
     1088               assign
     1089                 v-object-handle = buf_temp-diasize-handle.handle-value
     1090               .
     1091               if v-object-handle <> v-diasize-resize-button
     1092               then do:
     1093                 assign
     1094                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1095                 .
     1096               end.
     1097             end.
     1098             assign
     1099               v-diasize-browse-handle :width = v-browse-width
     1100             .
     1101             for each buf_temp-browse-handle
     1102               where buf_temp-browse-handle.browse-type = 'width':u
     1103             on error undo, next
     1104             :
     1105               assign
     1106                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1107               .
     1108             end.
     1109             assign
     1110               frame Dialog-Frame :width = v-frame-width
     1111             .
     1112             if frame Dialog-Frame :scrollable = true
     1113             then do:
     1114               assign
     1115                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1116               .
     1117             end.
     1118             run diasize_position-resize-button in this-procedure .
     1119           end.
     1120           else do:
     1121             if frame Dialog-Frame :scrollable = true
     1122             then do:
     1123               assign
     1124                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1125               .
     1126             end.
     1127             assign
     1128               frame Dialog-Frame :width = v-frame-width
     1129             .
     1130             for each buf_temp-browse-handle
     1131               where buf_temp-browse-handle.browse-type = 'width':u
     1132             on error undo, next
     1133             :
     1134               assign
     1135                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1136               .
     1137             end.
     1138             assign
     1139               v-diasize-browse-handle :width = v-browse-width
     1140             .
     1141             for each buf_temp-diasize-handle
     1142             on error undo, next
     1143             :
     1144               assign
     1145                 v-object-handle = buf_temp-diasize-handle.handle-value
     1146               .
     1147               if v-object-handle <> v-diasize-resize-button
     1148               then do:
     1149                 assign
     1150                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1151                 .
     1152               end.
     1153             end.
     1154             run diasize_position-resize-button in this-procedure .
     1155           end.
     1156           assign
     1157             v-diasize-change-size = false
     1158           .
     1159           leave move_block .
     1160         end.
     1161       end.
     1162       assign
     1163         v-diasize-need-full-display = true
     1164       .
     1165       if v-diasize-change-size = false
     1166       then do:
     1167         assign
     1168           v-diasize-change-size = true
     1169         .
     1170       end.
     1171       else do:
     1172         return .
     1173       end.
     1174       assign
     1175         v-frame-width = frame Dialog-Frame :width
     1176         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1177         v-browse-width = v-diasize-browse-handle :width
     1178       .
     1179       for each buf_temp-browse-handle
     1180         where buf_temp-browse-handle.browse-type = 'width':u
     1181       :
     1182         assign
     1183           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1184         .
     1185       end.
     1186       for each buf_temp-diasize-handle
     1187       :
     1188         delete buf_temp-diasize-handle .
     1189       end.
     1190       assign
     1191         v-field-group-handle = frame Dialog-Frame :first-child
     1192       .
     1193       do while valid-handle(v-field-group-handle)
     1194       :
     1195         assign
     1196           v-object-handle = v-field-group-handle :first-child
     1197         .
     1198         do while valid-handle(v-object-handle)
     1199         :
     1200           if  v-object-handle <> v-diasize-browse-handle :handle
     1201           and v-object-handle <> v-diasize-resize-button
     1202           and can-query(v-object-handle, "row")
     1203           and can-query(v-object-handle, "height")
     1204           and ( v-object-handle :col + v-object-handle :width
     1205                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1206               )
     1207           then do:
     1208             find first buf_temp-browse-handle
     1209               where buf_temp-browse-handle.browse-type   = 'width':u
     1210                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1211               no-error .
     1212             if available buf_temp-browse-handle
     1213             then do:
     1214             end.
     1215             else do:
     1216               create buf_temp-diasize-handle .
     1217               assign
     1218                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1219                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1220               .
     1221             end.
     1222           end.
     1223           assign
     1224             v-object-handle = v-object-handle :next-sibling
     1225           .
     1226         end.
     1227         assign
     1228           v-field-group-handle = v-field-group-handle :next-sibling
     1229         .
     1230       end.
     1231       do with frame Dialog-Frame
     1232       :
     1233         hide v-diasize-resize-button .
     1234         v-diasize-resize-button :row = 1.
     1235         v-diasize-resize-button :column = 1.
     1236       end.
     1237       if p-change-value > 0
     1238       then do:
     1239         if frame Dialog-Frame :scrollable = true
     1240         then do:
     1241           assign
     1242             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1243             no-error .
     1244           if error-status :error
     1245           or error-status :get-message(1) <> ""
     1246           then do:
     1247             undo move_block, retry move_block.
     1248           end.
     1249         end.
     1250         assign
     1251           frame Dialog-Frame :width = v-frame-width + p-change-value
     1252           no-error .
     1253         if error-status :error
     1254         or error-status :get-message(1) <> ""
     1255         then do:
     1256           undo move_block, retry move_block.
     1257         end.
     1258         assign
     1259           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1260         no-error .
     1261         if error-status :error
     1262         or error-status :get-message(1) <> ""
     1263         then do:
     1264           undo move_block, retry move_block.
     1265         end.
     1266         for each buf_temp-browse-handle
     1267           where buf_temp-browse-handle.browse-type = 'width':u
     1268         on error undo move_block, retry move_block
     1269         :
     1270           assign
     1271             buf_temp-browse-handle.browse-handle :width
     1272               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1273             no-error .
     1274           if error-status :error
     1275           or error-status :get-message(1) <> ""
     1276           then do:
     1277             undo move_block, retry move_block .
     1278           end.
     1279         end.
     1280         for each buf_temp-diasize-handle
     1281         on error undo move_block, retry move_block
     1282         :
     1283           assign
     1284             v-object-handle = buf_temp-diasize-handle.handle-value
     1285           .
     1286           if v-object-handle <> v-diasize-resize-button
     1287           then do:
     1288             assign
     1289               v-object-handle :col = v-object-handle :col + p-change-value
     1290               no-error .
     1291             if error-status :error
     1292             or error-status :get-message(1) <> ""
     1293             then do:
     1294               undo move_block, retry move_block .
     1295             end.
     1296           end.
     1297         end.
     1298       end.
     1299       else do:
     1300         for each buf_temp-diasize-handle
     1301         on error undo move_block, retry move_block
     1302         :
     1303           assign
     1304             v-object-handle = buf_temp-diasize-handle.handle-value
     1305           .
     1306           if v-object-handle <> v-diasize-resize-button
     1307           then do:
     1308             assign
     1309               v-object-handle :col = v-object-handle :col + p-change-value
     1310               no-error .
     1311             if error-status :error
     1312             or error-status :get-message(1) <> ""
     1313             then do:
     1314               undo move_block, retry move_block .
     1315             end.
     1316           end.
     1317         end.
     1318         for each buf_temp-browse-handle
     1319           where buf_temp-browse-handle.browse-type = 'width':u
     1320         on error undo move_block, retry move_block
     1321         :
     1322           assign
     1323             buf_temp-browse-handle.browse-handle :width
     1324               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1325             no-error .
     1326           if error-status :error
     1327           or error-status :get-message(1) <> ""
     1328           then do:
     1329             undo move_block, retry move_block .
     1330           end.
     1331         end.
     1332         assign
     1333           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1334           no-error .
     1335         if error-status :error
     1336         or error-status :get-message(1) <> ""
     1337         then do:
     1338           undo move_block, retry move_block.
     1339         end.
     1340         assign
     1341           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1342         no-error .
     1343         if error-status :error
     1344         or error-status :get-message(1) <> ""
     1345         then do:
     1346           undo move_block, retry move_block.
     1347         end.
     1348         if frame Dialog-Frame :scrollable = true
     1349         then do:
     1350           assign
     1351             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1352           no-error .
     1353           if error-status :error
     1354           or error-status :get-message(1) <> ""
     1355           then do:
     1356             undo move_block, retry move_block.
     1357           end.
     1358         end.
     1359       end.
     1360       if p-move-resize
     1361       then do:
     1362         run diasize_position-resize-button in this-procedure .
     1363       end.
     1364       if v-diasize-wndstore = true
     1365       then do:
     1366         if connected("ub") = true
     1367         then do:
     1368           define variable v-cntxt-db-num        as integer   no-undo .
     1369           define variable v-cntxt-userid        as character no-undo .
     1370           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1371                                             , OUTPUT v-cntxt-userid
     1372                                             ) .
     1373           run gbl/wndsizew.p
     1374             (input  v-cntxt-db-num
     1375             ,input  v-cntxt-userid
     1376             ,input  v-diasize-proc-name
     1377             ,input  'width':u
     1378             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1379             ) .
     1380         end.
     1381       end.
     1382     end.
     1383     assign
     1384       v-diasize-change-size = false
     1385     .
     1386   end procedure.
     1387   procedure diasize_set-width :
     1388     define input  parameter p-new-width  as decimal   no-undo .
     1389     define input  parameter p-move-resize as logical   no-undo .
     1390     do
     1391     on error undo, return error return-value
     1392     :
     1393       run diasize_change-width in this-procedure
     1394         (input  (p-new-width - frame Dialog-Frame :width)
     1395         ,input  p-move-resize
     1396         ) .
     1397     end.
     1398   end procedure.
     1399   procedure diasize_position-resize-button :
     1400     do with frame Dialog-Frame
     1401     :
     1402       hide v-diasize-resize-button .
     1403       assign
     1404         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1405                     - 1
     1406                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1407         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1408                     - 1
     1409                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1410       .
     1411       view v-diasize-resize-button .
     1412     end.
     1413   end procedure.
     1414   on alt-right anywhere
     1415   do:
     1416     run diasize_change-width in this-procedure
     1417       (input 1
     1418       ,input true
     1419       ) .
     1420     return no-apply .
     1421   end.
     1422   on alt-left anywhere
     1423   do:
     1424     run diasize_change-width in this-procedure
     1425       (input -1
     1426       ,input true
     1427       ) .
     1428     return no-apply .
     1429   end.
     1430   on alt-down anywhere
     1431   do:
     1432     run diasize_change-height in this-procedure
     1433       (input 1
     1434       ,input true
     1435       ) .
     1436     return no-apply .
     1437   end.
     1438   on alt-up anywhere
     1439   do:
     1440     run diasize_change-height in this-procedure
     1441       (input -1
     1442       ,input true
     1443       ) .
     1444     return no-apply .
     1445   end.
     1446   on alt-enter of frame Dialog-Frame
     1447   do:
     1448     run diasize_maximize in this-procedure
     1449       (input  ?
     1450       ).
     1451     return no-apply .
     1452   end.
     1453   procedure diasize_end-move :
     1454     do
     1455     on error undo, return error return-value
     1456     :
     1457       define variable v-row-delta as decimal   no-undo .
     1458       define variable v-col-delta as decimal   no-undo .
     1459       define variable v-new-row as decimal   no-undo .
     1460       define variable v-new-col as decimal   no-undo .
     1461       assign
     1462         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1463         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1464       .
     1465       assign
     1466         v-row-delta = v-new-row - frame Dialog-Frame :height
     1467         v-col-delta = v-new-col - frame Dialog-Frame :width
     1468       .
     1469       run diasize_change-height in this-procedure
     1470         (input v-row-delta
     1471         ,input true
     1472         ) .
     1473       run diasize_change-width in this-procedure
     1474         (input v-col-delta
     1475         ,input true
     1476         ) .
     1477     end.
     1478   end procedure.
     1479   procedure diasize_maximize :
     1480     define input  parameter p-action as logical   no-undo .
     1481     do
     1482     on error undo, return error return-value
     1483     :
     1484       if p-action = ?
     1485       then do:
     1486         if v-diasize-need-maximize = true
     1487         then do:
     1488           assign
     1489             p-action = true
     1490           .
     1491         end.
     1492         else do:
     1493           assign
     1494             p-action = false
     1495           .
     1496         end.
     1497       end.
     1498       if p-action = true
     1499       then do:
     1500         run diasize_change-height in this-procedure
     1501           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1502               - frame Dialog-Frame :height-chars
     1503           ,input true
     1504           ) .
     1505         run diasize_change-width in this-procedure
     1506           (input session :width-chars
     1507               - frame Dialog-Frame :width-chars
     1508           ,input true
     1509           ) .
     1510         assign
     1511           v-diasize-need-maximize = false
     1512         .
     1513       end.
     1514       else do:
     1515         run diasize_change-width in this-procedure
     1516           (input v-diasize-orig-frame-width
     1517               - frame Dialog-Frame :width-chars
     1518           ,input true
     1519           ) .
     1520         run diasize_change-height in this-procedure
     1521           (input v-diasize-orig-frame-height
     1522               - frame Dialog-Frame :height-chars
     1523           ,input true
     1524           ) .
     1525         assign
     1526           v-diasize-need-maximize = true
     1527         .
     1528       end.
     1529     end.
     1530   end procedure.
     1531   procedure diasize_restore-orig-size :
     1532     do
     1533     on error undo, return error return-value
     1534     :
     1535       assign
     1536         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1537         v-diasize-current-frame-height = frame Dialog-Frame :height
     1538       .
     1539       run diasize_set-height in this-procedure
     1540         (input  v-diasize-orig-frame-height
     1541         ,input  true
     1542         ) .
     1543       run diasize_set-width in this-procedure
     1544         (input  v-diasize-orig-frame-width
     1545         ,input  true
     1546         ) .
     1547     end.
     1548   end procedure.
     1549   procedure diasize_restore-current-size :
     1550     do
     1551     on error undo, return error return-value
     1552     :
     1553       run diasize_set-height in this-procedure
     1554         (input  v-diasize-current-frame-height
     1555         ,input  true
     1556         ) .
     1557       run diasize_set-width in this-procedure
     1558         (input  v-diasize-current-frame-width
     1559         ,input  true
     1560         ) .
     1561     end.
     1562   end procedure.
     1563   procedure diasize_set-browse-handle :
     1564     define input  parameter p-browse-handle as handle   no-undo .
     1565     define buffer buf_temp-browse-handle for temp-browse-handle .
     1566     do
     1567     on error undo, return error return-value
     1568     :
     1569       assign
     1570         v-diasize-browse-handle = p-browse-handle
     1571       .
     1572       for each buf_temp-browse-handle
     1573       on error undo, return error return-value
     1574       :
     1575         delete buf_temp-browse-handle .
     1576       end.
     1577     end.
     1578   end procedure.
     1579   procedure diasize_add_browse :
     1580     define input  parameter p-browse-type   as character no-undo .
     1581     define input  parameter p-browse-handle as handle    no-undo .
     1582     define buffer buf_temp-browse-handle for temp-browse-handle .
     1583     do
     1584     on error undo, return error return-value
     1585     :
     1586       assign
     1587         v-diasize-browse-number = v-diasize-browse-number + 1
     1588       .
     1589       create buf_temp-browse-handle .
     1590       assign
     1591         buf_temp-browse-handle.browse-type   = p-browse-type
     1592         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1593         buf_temp-browse-handle.browse-handle = p-browse-handle
     1594       .
     1595     end.
     1596   end procedure.
     1597   procedure diasize_init :
     1598     define variable v-default-value    as logical   no-undo .
     1599     define variable v-restore-saved    as logical   no-undo .
     1600     define variable v-resize-value-str as character no-undo .
     1601     do
     1602     on error undo, return error return-value
     1603     :
     1604       do with frame Dialog-Frame
     1605       :
     1606         assign
     1607           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1608           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1609           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1610         .
     1611         create button v-diasize-resize-button
     1612         assign
     1613           parent        = frame Dialog-Frame :first-child
     1614           label         = "s"
     1615           height-pixels = 16
     1616           width-pixels  = 16
     1617           visible       = true
     1618           sensitive     = true
     1619           movable       = true
     1620           triggers:
     1621             on end-move persistent run diasize_end-move in this-procedure .
     1622           end triggers.
     1623         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1624         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1625         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1626         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1627         assign
     1628           v-diasize-wndmax = false
     1629         .
     1630         if connected("ub") = true
     1631         then do:
     1632           define variable v-cntxt-db-num        as integer   no-undo .
     1633           define variable v-cntxt-userid        as character no-undo .
     1634           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1635                                             , OUTPUT v-cntxt-userid
     1636                                             ) .
     1637           run gbl/wndpar_r.p
     1638             (input  v-cntxt-db-num
     1639             ,input  v-cntxt-userid
     1640             ,input  'wndmax':U
     1641             ,output v-diasize-wndmax
     1642             ,output v-default-value
     1643             ) .
     1644         end.
     1645         assign
     1646           v-diasize-wndstore = false
     1647         .
     1648         if connected("ub") = true
     1649         then do:
     1650           run gbl/wndpar_r.p
     1651             (input  v-cntxt-db-num
     1652             ,input  v-cntxt-userid
     1653             ,input  'wndstore':U
     1654             ,output v-diasize-wndstore
     1655             ,output v-default-value
     1656             ) .
     1657         end.
     1658         assign
     1659           v-diasize-proc-name = entry(1, program-name(2), '.')
     1660         .
     1661         if v-diasize-wndstore = true
     1662         then do:
     1663           assign
     1664             v-restore-saved = false
     1665           .
     1666           if connected("ub") = true
     1667           then do:
     1668             run gbl/wndsizer.p
     1669               (input  v-cntxt-db-num
     1670               ,input  v-cntxt-userid
     1671               ,input  v-diasize-proc-name
     1672               ,input  'height':u
     1673               ,output v-resize-value-str
     1674               ) .
     1675             if v-resize-value-str <> '':U
     1676             then do:
     1677               run diasize_change-height in this-procedure
     1678                 (input  integer(v-resize-value-str)
     1679                 ,input  true
     1680                 ) .
     1681               assign
     1682                 v-restore-saved = true
     1683               .
     1684             end.
     1685           end.
     1686           if connected("ub") = true
     1687           then do:
     1688             run gbl/wndsizer.p
     1689               (input  v-cntxt-db-num
     1690               ,input  v-cntxt-userid
     1691               ,input  v-diasize-proc-name
     1692               ,input  'width':u
     1693               ,output v-resize-value-str
     1694               ) .
     1695             if v-resize-value-str <> '':U
     1696             then do:
     1697               run diasize_change-width in this-procedure
     1698                 (input  integer(v-resize-value-str)
     1699                 ,input  true
     1700                 ) .
     1701               assign
     1702                 v-restore-saved = true
     1703               .
     1704             end.
     1705           end.
     1706           if v-restore-saved <> true
     1707           then do:
     1708             if v-diasize-wndmax = true
     1709             then do:
     1710               run diasize_maximize in this-procedure
     1711                 (input  true
     1712                 ) .
     1713             end.
     1714           end.
     1715         end.
     1716         else do:
     1717           if v-diasize-wndmax = true
     1718           then do:
     1719             run diasize_maximize in this-procedure
     1720               (input  true
     1721               ) .
     1722           end.
     1723         end.
     1724       end.
     1725     end.
     1726   end procedure.
     1727   procedure diasize_need-full-display :
     1728     define output parameter p-need-full-display as logical   no-undo .
     1729     do
     1730     on error undo, return error return-value
     1731     :
     1732       assign
     1733         p-need-full-display = v-diasize-need-full-display
     1734       .
     1735       assign
     1736         v-diasize-need-full-display = false
     1737       .
     1738     end.
     1739   end procedure.
     1740   procedure get-context :
     1741      define output parameter p-db-num as integer          no-undo.
     1742      define output parameter p-user-id as character        no-undo.
     1743      define variable v-login               as character    no-undo.
     1744      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1745      define buffer buf_user-login  for ub.user-login .
     1746      do
     1747      on error undo, return error
     1748      :
     1749            FIND FIRST buf_sys-ctrl no-lock.
     1750            ASSIGN
     1751               v-login = USERID("ub")
     1752               p-db-num = buf_sys-ctrl.db-num
     1753            .
     1754            FIND FIRST buf_user-login
     1755                 WHERE buf_user-login.db-num = p-db-num
     1756                   AND buf_user-login.user-login = v-login
     1757                 no-lock
     1758                 no-error
     1759                 .
     1760            IF AVAILABLE buf_user-login
     1761            THEN DO:
     1762               assign
     1763                  p-user-id = buf_user-login.user-id
     1764               .
     1765            END.
     1766      end.
     1767   end procedure.
     1768       run diasize_init in this-procedure .
     1769   run adm/shattri.p (
     1770       input "get":U
     1771       ,input  p-curr-obj-type
     1772       ,input  p-curr-obj-code
     1773       ,input  'get-chk':U
     1774       ,input  'cas-curs':U
     1775       ,output v-value-character
     1776       ,output v-value-date
     1777       ,output v-value-decimal
     1778       ,output v-value-integer
     1779       ,output v-value-logical
     1780       ,output v-param-type
     1781       ,INPUT-OUTPUT table-handle v-tth
     1782       ) no-error .
     1783   IF not error-status:error then do:
     1784     cas-curs = v-value-logical.
     1785   end.
     1786   delete object v-tth.
     1787   if cursh > 0 then do:
     1788   FIND LAST curr-shop WHERE curr-shop.obj-type = p-curr-obj-type
     1789                                            and curr-shop.obj-code = p-curr-obj-code
     1790                                            and curr-shop.curr-code = p-base-code
     1791                                            and
     1792                                            ( ( curr-shop.exch-date = cursh-date1 AND
     1793                                            curr-shop.exch-time <= cursh-time1 ) OR
     1794                                            curr-shop.exch-date < cursh-date1 )  NO-LOCK no-error.
     1795           if not avail curr-shop then return error.
     1796           RUN DIAPAZON.
     1797           return.
     1798   end.
     1799   FIND LAST curr-shop WHERE curr-shop.obj-type = p-curr-obj-type
     1800                                            and curr-shop.obj-code = p-curr-obj-code
     1801                                            and curr-shop.curr-code = p-base-code
     1802                                            and curr-shop.exch-date <= inkas-date NO-LOCK no-error.
     1803   if not avail curr-shop then return error.
     1804   IF curr-shop.exch-date < inkas-date then do:
     1805       if day-only then do:
     1806           assign
     1807           cursh = curr-shop.exch-rate
     1808           cursh-scale = curr-shop.exch-scale.
     1809           RUN DIAPAZON.
     1810           return.
     1811       end.
     1812       assign
     1813       yesterday = yes.
     1814   end.
     1815   else if NOT cas-curs then do:
     1816       FIND FIRST b-cs No-LOCK WHERE
     1817                          b-cs.obj-type = p-curr-obj-type AND
     1818                          b-cs.obj-code = p-curr-obj-code AND
     1819                          b-cs.curr-code = p-base-code AND
     1820                          b-cs.exch-date = inkas-date AND
     1821                          recid(b-cs) <> recid(curr-shop) No-ERROR.
     1822       IF NOT AVAIL b-cs then do:
     1823           assign
     1824           cursh = curr-shop.exch-rate
     1825           cursh-scale = curr-shop.exch-scale.
     1826           RUN DIAPAZON.
     1827           return.
     1828       end.
     1829   end.
     1830   MAIN-BLOCK:
     1831   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1832      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1833     RUN enable_UI.
     1834     if cas-curs then ENABLE b-add with frame Dialog-Frame.
     1835     APPLY "ENTRY" TO BROWSE-1.
     1836     WAIT-FOR GO OF FRAME Dialog-Frame.
     1837   END.
     1838   RUN disable_UI.
     1839   PROCEDURE DIAPAZON :
     1840   DEFINE VARIABLE b-cs-recid as recid no-undo.
     1841   DEFINE VARIABLE v-today as date no-undo .
     1842   DEFINE VARIABLE v-time as integer no-undo .
     1843      b-cs-recid = ?.
     1844     FOR EACH    b-cs NO-LOCK WHERE
     1845                          b-cs.obj-type = p-curr-obj-type AND
     1846                          b-cs.obj-code = p-curr-obj-code AND
     1847                          b-cs.curr-code = p-base-code AND
     1848                          (b-cs.exch-date < ub.curr-shop.exch-date
     1849                          OR
     1850                          (b-cs.exch-date = ub.curr-shop.exch-date AND
     1851                          b-cs.exch-time < ub.curr-shop.exch-time))
     1852                          BY b-cs.exch-date descending BY b-cs.exch-time descending:
     1853           IF  b-cs.exch-rate / b-cs.exch-scale <> cursh / cursh-scale then LEAVE.
     1854           b-cs-recid = recid(b-cs).
     1855       END.
     1856      IF b-cs-recid <> ? then do:
     1857      FIND FIRST b-cs where recid(b-cs) = b-cs-recid No-LOCK NO-ERROR.
     1858      assign
     1859      cursh-date1 = b-cs.exch-date
     1860      cursh-time1 = b-cs.exch-time.
     1861      end.
     1862      else do:
     1863       assign
     1864       cursh-date1 = curr-shop.exch-date
     1865       cursh-time1 = curr-shop.exch-time.
     1866      end.
     1867     FIND FIRST b-cs WHERE
     1868                          b-cs.obj-type = p-curr-obj-type AND
     1869                          b-cs.obj-code = p-curr-obj-code AND
     1870                          b-cs.curr-code = p-base-code AND
     1871                          (b-cs.exch-date > curr-shop.exch-date
     1872                          OR
     1873                          (b-cs.exch-date = curr-shop.exch-date AND
     1874                          b-cs.exch-time > curr-shop.exch-time)) AND
     1875                          b-cs.exch-rate / b-cs.exch-scale <> cursh / cursh-scale AND
     1876                          YEAR(b-cs.exch-date) <> 9999
     1877                          USE-INDEX pi   No-LOCK NO-ERROR.
     1878      IF AVAIL b-cs then
     1879      assign
     1880      cursh-date2 = b-cs.exch-date
     1881      cursh-time2 = b-cs.exch-time.
     1882      else do:
     1883       run cur-time in this-procedure(output v-today, output v-time).
     1884       assign
     1885       cursh-date2 = v-today + 365
     1886       cursh-time2 = v-time.
     1887      end.
     1888   END PROCEDURE.
     1889   PROCEDURE disable_UI :
     1890     HIDE FRAME Dialog-Frame.
     1891   END PROCEDURE.
     1892   PROCEDURE enable_UI :
     1893     ENABLE B-Sel B-quit B-help BROWSE-1
     1894         WITH FRAME Dialog-Frame.
     1895     VIEW FRAME Dialog-Frame.
     1896     OPEN QUERY BROWSE-1 FOR EACH ub.curr-shop       WHERE ub.curr-shop.curr-code = p-base-code  AND ub.curr-shop.obj-type = p-curr-obj-type  AND ub.curr-shop.obj-code = p-curr-obj-code  AND (ub.curr-shop.exch-date = inkas-date OR (yesterday AND ub.curr-shop.exch-date <= inkas-date)      ) NO-LOCK     BY ub.curr-shop.exch-date DESCENDING        BY ub.curr-shop.exch-time DESCENDING.
     1897   END PROCEDURE.
