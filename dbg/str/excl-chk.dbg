       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   FUNCTION calc-excise RETURNS DECIMAL(input  parprice-sale as decimal,
       81                                        input  parroad-tax   as decimal,
       82                                        input  parvat-pc     as decimal,
       83                                        input  parfactorrd   as decimal,
       84                                        output parexcise     as decimal):
       85   ASSIGN parexcise = (parprice-sale - parroad-tax) * parvat-pc / (100 + parvat-pc) -
       86                      1 / parfactorrd * parroad-tax.
       87   RETURN parexcise.
       88   END FUNCTION.
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure findtank:
       91     define input  parameter p-obj-type     as character no-undo.
       92     define input  parameter p-obj-code     as integer   no-undo.
       93     define input  parameter p-pump-code    as integer   no-undo.
       94     define input  parameter p-nozzle-code  as integer   no-undo .
       95     define input  parameter p-from-pl-code as integer   no-undo .
       96     define input  parameter p-gds-code     as integer   no-undo.
       97     define output parameter p-pl-code      as integer   no-undo .
       98     define variable v-pl-code            like ub.place.pl-code no-undo .
       99     define variable v-dopstr             as character no-undo .
      100     define buffer buf_place for ub.place.
      101     define buffer buf_pl-gds-pump for ub.pl-gds-pump.
      102     define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
      103     define buffer buf_pl-gds for ub.pl-gds.
      104     do
      105     on error undo, return error return-value
      106     :
      107       assign
      108         v-pl-code = 0
      109         p-pl-code = ?
      110       .
      111       if p-from-pl-code <> ?
      112         and p-from-pl-code <> 0
      113       then do:
      114         find first buf_pl-gds no-lock
      115           where buf_pl-gds.obj-type  = p-obj-type
      116             and buf_pl-gds.obj-code  = p-obj-code
      117             and buf_pl-gds.pl-code   = p-from-pl-code
      118             and buf_pl-gds.gds-code  = p-gds-code
      119           no-error.
      120         if available buf_pl-gds then do:
      121           assign
      122             v-pl-code = buf_pl-gds.pl-code
      123           .
      124         end.
      125       end.
      126       if v-pl-code <> 0
      127         and p-nozzle-code <> ?
      128         and p-nozzle-code <> 0
      129       then do:
      130         find first buf_pl-pump-nozzle no-lock
      131           where buf_pl-pump-nozzle.obj-type    = p-obj-type
      132             and buf_pl-pump-nozzle.obj-code    = p-obj-code
      133             and buf_pl-pump-nozzle.pl-code     = v-pl-code
      134             and buf_pl-pump-nozzle.pump-code   = p-pump-code
      135             and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
      136           no-error .
      137         if not available buf_pl-pump-nozzle then do:
      138           return.
      139         end.
      140       end.
      141       if v-pl-code = 0 then do:
      142         if p-nozzle-code = 0 then do:
      143           find first buf_pl-gds-pump no-lock
      144             where buf_pl-gds-pump.obj-type  = p-obj-type
      145               and buf_pl-gds-pump.obj-code  = p-obj-code
      146               and buf_pl-gds-pump.pump-code = p-pump-code
      147               and buf_pl-gds-pump.gds-code  = p-gds-code
      148               and buf_pl-gds-pump.status_   = 'тек':U
      149             no-error.
      150           if available buf_pl-gds-pump then do:
      151             assign
      152               v-pl-code = buf_pl-gds-pump.pl-code
      153             .
      154           end.
      155         end.
      156         else do:
      157           _ppnz:
      158           for each buf_pl-pump-nozzle no-lock
      159             where buf_pl-pump-nozzle.obj-type = p-obj-type
      160               and buf_pl-pump-nozzle.obj-code = p-obj-code
      161               and buf_pl-pump-nozzle.pump-code = p-pump-code
      162               and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
      163             ,first buf_pl-gds-pump no-lock
      164             where buf_pl-gds-pump.obj-type  = p-obj-type
      165               and buf_pl-gds-pump.obj-code  = p-obj-code
      166               and buf_pl-gds-pump.pump-code = p-pump-code
      167               and buf_pl-gds-pump.gds-code  = p-gds-code
      168               and buf_pl-gds-pump.status_   = 'тек':U
      169               and buf_pl-gds-pump.pl-code   = buf_pl-pump-nozzle.pl-code
      170           on error undo, return error return-value
      171           :
      172             assign
      173               v-pl-code = buf_pl-pump-nozzle.pl-code
      174             .
      175             leave _ppnz.
      176           end.
      177         end.
      178       end.
      179       if v-pl-code <> 0 then do:
      180         assign
      181           p-pl-code = v-pl-code
      182         .
      183       end.
      184     end.
      185   end procedure.
      186   procedure find-nzl:
      187   define input  parameter p-obj-type   as character no-undo.
      188   define input  parameter p-obj-code   as integer   no-undo.
      189   define input  parameter p-pump-code  as integer   no-undo.
      190   define input  parameter p-gds-code   as integer   no-undo.
      191   define input  parameter p-pl-code    as integer no-undo .
      192   define output parameter p-nozzle-code    as integer   no-undo.
      193   define variable v-nozzle-code        like ub.nozzle.nozzle-code no-undo .
      194   define variable v-pl-code            like ub.place.pl-code no-undo .
      195   define variable v-pump-code          like ub.pump.pump-code no-undo .
      196   define variable v-loc1-code          like ub.place.loc1 no-undo .
      197   define variable v-dopstr             as character no-undo .
      198   define buffer buf_place for ub.place.
      199   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
      200   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
      201   define buffer buf_pl-gds for ub.pl-gds.
      202   do on error undo, return error return-value :
      203     v-pump-code = p-pump-code.
      204     find first buf_pl-pump-nozzle no-lock where
      205                   buf_pl-pump-nozzle.obj-type = p-obj-type
      206               and buf_pl-pump-nozzle.obj-code = p-obj-code
      207               and buf_pl-pump-nozzle.pump-code = p-pump-code
      208               and buf_pl-pump-nozzle.pl-code = p-pl-code no-error.
      209     if not available buf_pl-pump-nozzle then do:
      210       assign
      211       p-nozzle-code = ?.
      212       return .
      213     end.
      214     assign
      215     p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
      216     return.
      217     .
      218   end.
      219   end procedure.
      220   procedure find-nzl-without-pl:
      221   define input  parameter p-obj-type   as character no-undo.
      222   define input  parameter p-obj-code   as integer   no-undo.
      223   define input  parameter p-pump-code  as integer   no-undo.
      224   define input  parameter p-gds-code   as integer   no-undo.
      225   define output parameter p-nozzle-code    as integer   no-undo.
      226   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
      227   define buffer buf_pl-gds for ub.pl-gds.
      228   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
      229   do on error undo, return error return-value :
      230     for each buf_pl-gds-pump no-lock where
      231               buf_pl-gds-pump.obj-type  = p-obj-type
      232           and buf_pl-gds-pump.obj-code  = p-obj-code
      233           and buf_pl-gds-pump.pump-code = p-pump-code
      234           and buf_pl-gds-pump.gds-code  = p-gds-code
      235           and buf_pl-gds-pump.status_   = 'тек':U,
      236         first buf_pl-gds no-lock where
      237                   buf_pl-gds.obj-type = p-obj-type
      238               AND buf_pl-gds.obj-code = p-obj-code
      239               AND buf_pl-gds.pl-code = buf_pl-gds-pump.pl-code
      240               AND buf_pl-gds.gds-code = p-gds-code
      241               AND buf_pl-gds.status_ = 'тек':U,
      242        first buf_pl-pump-nozzle no-lock where
      243                 buf_pl-pump-nozzle.obj-type = p-obj-type
      244             and buf_pl-pump-nozzle.obj-code = p-obj-code
      245             and buf_pl-pump-nozzle.pl-code = buf_pl-gds.pl-code
      246             and buf_pl-pump-nozzle.pump-code = p-pump-code:
      247       assign
      248       p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
      249       return .
      250     end.
      251     assign
      252     p-nozzle-code = ?.
      253     return.
      254     .
      255   end.
      256   end procedure.
      257   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      258   def var cr as integer no-undo.
      259   DEFINE  TEMP-TABLE t-gds No-UNDO
      260   FIELD b-code like ub.chk-gds.b-code
      261   FIELD gds-code like ub.goods.gds-code
      262   FIELD artic like ub.goods.artic
      263   FIELD prod-type like ub.goods.prod-type
      264   FIELD prod-code like ub.goods.prod-code
      265   FIELD doc-qnty like ub.chk-gds.doc-qnty
      266   FIELD price-base like ub.chk-gds.price-base
      267   FIELD price-sum like ub.chk-gds.price-base
      268   FIELD discnt like ub.chk-gds.discnt
      269   FIELD discnt-sum like ub.chk-gds.discnt
      270   FIELD price-service like ub.chk-gds.price-service
      271   FIELD road-tax like ub.chk-gds.road-tax
      272   FIELD road-sum like ub.chk-gds.road-tax
      273   FIELD new-price like ub.chk-gds.price-base
      274   FIELD cashparts as logical
      275   FIELD cashplace as logical
      276   FIELD pl-code like ub.doc-pl.pl-code
      277   field density as decimal
      278   FIELD rdoc-line as recid
      279   FIELD rgds-dtl as recid
