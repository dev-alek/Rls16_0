     1910   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1911   FUNCTION get-inc-sal returns integer(input p-chk-type as character
     1912                                      , input p-netto as decimal
     1913                                      , input p-chk-doc as logical
     1914                                      , input p-office as character
     1915                                      , input p-write-off-code  as character
     1916                                      , output p-add as logical
     1917                                      , output p-office-to-reserv as character
     1918                                      , output p-kind-to-reserv as character
     1919                                      , output p-add-nf-amount as integer
     1920                                      ):
     1921   define variable v-docs-to-reserv as integer no-undo.
     1922   if lookup(p-chk-type , '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0
     1923   then do:
     1924       assign
     1925       v-docS-to-reserv = 0
     1926       p-kind-to-reserv = '':U
     1927       p-add-nf-amount = 1
     1928       .
     1929       return v-docs-to-reserv.
     1930   end.
     1931   p-add = no.
     1932   if p-chk-doc then do:
     1933     if p-chk-type = ? then do:
     1934       if p-netto >= 0 then do:
     1935         assign
     1936         p-chk-type = '1':U.
     1937       end.
     1938       if p-netto < 0 then do:
     1939         assign
     1940         p-chk-type = '6':U.
     1941       end.
     1942     end.
     1943     CASE p-chk-type:
     1944       when '1':U then do:
     1945         assign
     1946         p-kind-to-reserv = 'es':U
     1947         v-docs-to-reserv = 1
     1948         .
     1949       end.
     1950       when '6':U then do:
     1951         assign
     1952         p-kind-to-reserv = 'rs':U
     1953         v-docs-to-reserv = 1
     1954         .
     1955       end.
     1956       when '17':U then do:
     1957         assign
     1958         p-kind-to-reserv = 'trf':U
     1959         v-docs-to-reserv = 1
     1960         .
     1961       end.
     1962       when '96':U then do:
     1963         assign
     1964         p-kind-to-reserv = 'rs':U + chr(44) + 'rwo':U
     1965         v-docs-to-reserv = 2
     1966         .
     1967       end.
     1968       when '69':U then do:
     1969         assign
     1970         p-kind-to-reserv = 'swo':U
     1971         v-docs-to-reserv = 1
     1972         .
     1973       end.
     1974       otherwise do:
     1975         assign
     1976         p-kind-to-reserv = '':U
     1977         v-docs-to-reserv = 0
     1978         .
     1979       End.
     1980     END CASE.
     1981     ASSIGN
     1982     p-add-nf-amount = 0.
     1983     if p-office = 'т':U
     1984     or p-office = 'у':U then do:
     1985       p-office-to-reserv = (if v-docs-to-reserv = 0
     1986                             then '':U
     1987                             else trim(fill((p-office + chr(44)), v-docs-to-reserv), chr(44))).
     1988     end.
     1989     else do:
     1990       assign
     1991       p-office-to-reserv  = (if v-docs-to-reserv = 0
     1992                              then '':U
     1993                              else (trim(fill(entry(1, p-office) + chr(44), v-docs-to-reserv), chr(44)) +
     1994                                   chr(44) +
     1995                                    trim(fill(entry(2, p-office) + chr(44), v-docs-to-reserv), chr(44))))
     1996       v-docs-to-reserv = v-docs-to-reserv * 2
     1997       p-kind-to-reserv = (if p-kind-to-reserv = '':U
     1998                           then  '':U
     1999                           else (p-kind-to-reserv + chr(44) + p-kind-to-reserv)) .
     2000     end.
     2001     return v-docs-to-reserv.
     2002   end.
     2003   else do:
     2004     ASSIGN
     2005     P-kind-to-reserv = '':U
     2006     p-add-nf-amount = 0
     2007     p-add = yes
     2008     p-office-to-reserv = '':U
     2009     .
     2010     if p-write-off-code = '0':U
     2011     or p-write-off-code = ? then do:
     2012       return 0.
     2013     end.
     2014     CASE p-chk-type:
     2015       when '1':U
     2016       then do:
     2017          if p-write-off-code = '1':U
     2018          or p-write-off-code = '3':U
     2019          then do:
     2020             assign
     2021             p-kind-to-reserv = 'swo':U
     2022             v-docs-to-reserv = 1
     2023             p-add = no
     2024             p-office-to-reserv = p-office
     2025             .
     2026          end.
     2027       end.
     2028       when '6':U then do:
     2029          if p-write-off-code = '-6':U
     2030          or p-write-off-code = '-3':U
     2031          then do:
     2032             assign
     2033             p-kind-to-reserv = 'rwo':U
     2034             v-docs-to-reserv = 1
     2035             p-add = no
     2036             p-office-to-reserv = p-office
     2037             .
     2038          end.
     2039       end.
     2040     END CASE.
     2041     return v-docs-to-reserv.
     2042   end.
     2043   END FUNCTION.
