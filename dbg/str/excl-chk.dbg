     1805   procedure tpsi-gds-fill-tpsi-obj-table :
     1806   define input parameter p-db-num like ub.db.db-num no-undo .
     1807   define variable v-is-tpsi-obj as logical no-undo .
     1808   define buffer buf_clients for ub.clients.
     1809     do
     1810     on error undo, return error return-value
     1811     :
     1812       for each temp-tpsi-clients :
     1813         delete temp-tpsi-clients.
     1814       end.
     1815       _clients:
     1816       for each buf_clients no-lock where
     1817             buf_clients.db-num = p-db-num:
     1818         assign
     1819         v-is-tpsi-obj = no.
     1820         run gbl/tpsi-obj.p (
     1821                         input buf_clients.obj-type
     1822                       ,input buf_clients.obj-code
     1823                       ,output v-is-tpsi-obj) .
     1824         if not v-is-tpsi-obj then NEXT _clients.
     1825         create temp-tpsi-clients.
     1826         buffer-copy
     1827         buf_clients to
     1828         temp-tpsi-clients.
     1829       end.
     1830     end.
     1831   end procedure.
     1832   procedure tpsi-gds-proprietor :
     1833   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     1834   define input parameter p-db-num   like ub.db.db-num      no-undo .
     1835   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
     1836   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
     1837   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
     1838   define variable v-is-tpsi-obj as logical no-undo .
     1839   do
     1840   on error undo, return error return-value
     1841   :
     1842       define buffer buf_clients for ub.clients.
     1843       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     1844       assign
     1845       p-proprietor-obj-type = "":U
     1846       p-proprietor-obj-code = ?
     1847       p-proprietor-host-code = ?
     1848       .
     1849       _gds-obj-attr:
     1850       for each buf_clients no-lock where
     1851               buf_clients.db-num = p-db-num,
     1852         each buf_gds-obj-attr no-lock where
     1853             buf_gds-obj-attr.obj-type = buf_Clients.obj-type
     1854         AND buf_gds-obj-attr.obj-code = buf_clients.obj-code
     1855         AND buf_gds-obj-attr.gds-code = p-gds-code
     1856         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
     1857         if logical(buf_gds-obj-attr.attr-value) = yes then do:
     1858           assign
     1859           v-is-tpsi-obj = no.
     1860           run gbl/tpsi-obj.p (
     1861                           input buf_gds-obj-attr.obj-type
     1862                         ,input buf_gds-obj-attr.obj-code
     1863                         ,output v-is-tpsi-obj) .
     1864           if not v-is-tpsi-obj then NEXT _gds-obj-attr.
     1865           assign
     1866           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
     1867           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
     1868           p-proprietor-host-code = buf_clients.host-code
     1869           .
     1870           LEAVE.
     1871         end.
     1872       end.
     1873   end.
     1874   end procedure.
     1875   procedure tpsi-preselect-gds-proprietor :
