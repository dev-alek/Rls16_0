     3366             road-tax-base-loc = b-doc-line.road-tax / b-trn-doc.base-rate * b-trn-doc.base-scale.
     3367         end.
     3368         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     3369         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     3370         assign
