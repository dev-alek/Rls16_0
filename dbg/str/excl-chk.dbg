     3615           slt-pc-loc         = (if b-doc-line.slt-pc         = ? then 0 else b-doc-line.slt-pc).
     3616                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3617               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3618         assign
     3619           vat-cli-loc            = ?
     3620           slt-cli-loc            = ?
     3621           price-cli-with-tax-loc = ?.
     3622      end.
     3623      else do:
     3624                                                   for each in-vatp-parts where in-vatp-parts.out-code  = b-doc-line.doc-code  and
     3625                                         in-vatp-parts.obj-type  = b-doc-line.obj-type  and
     3626                                         in-vatp-parts.obj-code  = b-doc-line.obj-code  and
     3627                                         in-vatp-parts.artic     = b-doc-line.artic     and
     3628                                         in-vatp-parts.prod-type = b-doc-line.prod-type and
     3629                                         in-vatp-parts.prod-code = b-doc-line.prod-code
     3630                            use-index out-code no-lock:
     3631             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     3632                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     3633                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     3634                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     3635                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     3636                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     3637                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     3638                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     3639                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     3640                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     3641                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     3642                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     3643                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     3644                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     3645                         .
     3646         end.
     3647         ASSIGN
     3648           road-tax-base-loc   = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     3649           road-tax-rubl-loc   = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     3650           transport-base-loc  = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     3651           transport-rubl-loc  = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     3652           other-base-loc      = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     3653           other-rubl-loc      = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     3654                                           vat-base-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-doc-line.fact-qnty   else 0
     3655           slt-base-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-doc-line.fact-qnty   else 0
     3656                   vat-rubl-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-doc-line.fact-qnty   else 0
     3657           slt-rubl-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-doc-line.fact-qnty   else 0
     3658           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     3659           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     3660         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     3661         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     3662         if transport-base-loc = ? then transport-base-loc = 0.
     3663         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     3664         if other-base-loc     = ? then other-base-loc     = 0.
     3665         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     3666         assign
     3667           transport-cli-loc      = 0
     3668           other-cli-loc          = 0
     3669           road-tax-cli-loc       = ?
     3670           vat-cli-loc            = ?
     3671           slt-cli-loc            = ?
     3672           price-cli-with-tax-loc = ?.
     3673      end.
     3674   ASSIGN
     3675             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3676       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3677   .
     3678           assign
     3679           b-doc-line.road-tax = (if v-curr-r-b = 'rubl':U then road-tax-rubl-loc else road-tax-base-loc).
     3680         end.
     3681         if rz then do:
     3682           if b-trn-doc.print-rubl
     3683           then assign
     3684             loc-gds-dtl.price-base = loc-gds-dtl.price-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     3685             loc-gds-dtl.discnt-base = loc-gds-dtl.discnt-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     3686             loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-rubl = 0
     3687                                      then 0
     3688                                      else loc-gds-dtl.discnt-rubl * 100 / loc-gds-dtl.price-rubl) .
     3689           else
     3690           assign
     3691           loc-gds-dtl.price-rubl = loc-gds-dtl.price-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     3692           loc-gds-dtl.discnt-rubl = loc-gds-dtl.discnt-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     3693           loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-base = 0
     3694                                    then 0
     3695                                    else loc-gds-dtl.discnt-base * 100 / loc-gds-dtl.price-base ).
     3696         end.
     3697       end.
     3698       if chg-qnty = res-qnty
     3699       then parts-ok = yes.
     3700       else parts-ok = no.
     3701       release loc-gds-dtl.
     3702       if no-partion-qnty = 0 then return.
     3703     end.
     3704     if not cashparts or no-partion-qnty <> 0 or NOT cashplace OR no-place-qnty <> 0 then do:
     3705     if cashplace then no-partion-qnty = no-place-qnty.
     3706     _gdsdtl:
     3707     FOR EACH loc-gds-dtl WHERE
     3708             loc-gds-dtl.doc-code = b-trn-doc.doc-code AND
     3709             loc-gds-dtl.artic = b-doc-line.artic AND
     3710             loc-gds-dtl.prod-type = b-doc-line.prod-type AND
     3711             loc-gds-dtl.prod-code = b-doc-line.prod-code
     3712             EXCLUSIVE-LOCK ON ERROR UNDO, NEXT:
     3713       IF rz AND loc-gds-dtl.fact-qnty <= loc-gds-dtl.doc-qnty then NEXT.
     3714       IF not rz AND loc-gds-dtl.doc-qnty = 0 AND v-is-own then NEXT.
     3715       IF NOT (rgds-dtl = ?) then do:
     3716         if NOT recid(loc-gds-dtl) = rgds-dtl THEN NEXT.
     3717         assign
     3718         r-prt-code = loc-gds-dtl.prt-code.
     3719       end.
     3720   if ( num_rec modulo 10 ) = 0 then
     3721   run waitfram-show in this-procedure (input substitute("&1 - обработано &2, из них успешно - &3"                                                         , rsrv-title                                                                 , num_rec                                                                    , num_rec_res) ).
     3722       assign
     3723       res-qnty = if cashparts
     3724                   then (if rz
     3725                         then no-partion-qnty
     3726                         else (if r-qnty = ?
     3727                               then (- loc-gds-dtl.doc-qnty)
     3728                               else no-partion-qnty)
     3729                         )
     3730                   else (if rz
     3731                         then (loc-gds-dtl.fact-qnty - loc-gds-dtl.doc-qnty)
     3732                         else (if r-qnty = ?
     3733                               then (- loc-gds-dtl.doc-qnty)
     3734                               else r-qnty
     3735                               )
     3736                         )
     3737       chg-qnty = res-qnty
     3738       cost-base = 0
     3739       cost-rubl = 0 .
     3740       if not v-is-own and rz then do:
     3741         find first buf_tt0-gds-dtl no-lock where
     3742                   buf_tt0-gds-dtl.artic     = loc-gds-dtl.artic
     3743               AND buf_tt0-gds-dtl.prod-type = loc-gds-dtl.prod-type
     3744               AND buf_tt0-gds-dtl.prod-code = loc-gds-dtl.prod-code
     3745               AND buf_tt0-gds-dtl.prt-code = loc-gds-dtl.prt-code no-error .
     3746         if available buf_tt0-gds-dtl then do:
     3747           assign
     3748           chg-qnty = chg-qnty - buf_tt0-gds-dtl.doc-qnty.
     3749         end.
     3750       end.
     3751       if not v-is-own and not rz and chg-qnty = 0 then
     3752       assign
     3753       v-to-reserv = no
     3754       .
     3755       if not v-is-own
     3756       and rz
     3757       and (available buf_tt0-gds-dtl and (buf_tt0-gds-dtl.doc-qnty + loc-gds-dtl.doc-qnty) = loc-gds-dtl.fact-qnty)
     3758       then
     3759       assign
     3760       v-to-reserv = no
     3761       .
     3762       if p-auto-fbr-on
     3763       then do :
     3764         find first goods no-lock where goods.artic = loc-gds-dtl.artic
     3765                                    and goods.prod-type = loc-gds-dtl.prod-type
     3766                                    and goods.prod-code = loc-gds-dtl.prod-code
     3767                                    .
     3768         if b-trn-doc.ext-doc-type =  'rs':U
     3769         then do :
     3770           find first buf_doc-fbr-gds no-lock where buf_doc-fbr-gds.out-code = replace(loc-gds-dtl.doc-code, "=", "-")
     3771                                                and buf_doc-fbr-gds.gds-code = goods.gds-code
     3772                                                no-error .
     3773           if available buf_doc-fbr-gds
     3774           then do :
     3775             if buf_doc-fbr-gds.fact-qnty > 0
     3776             then do :
     3777               assign
     3778                 v-to-reserv = no
     3779               .
     3780             end.
     3781             else do :
     3782               chg-qnty = if res-qnty >= 0 then abs(buf_doc-fbr-gds.fact-qnty) else buf_doc-fbr-gds.fact-qnty.
     3783             end.
     3784           end.
     3785         end.
     3786         if b-trn-doc.ext-doc-type =  'es':U
     3787         then do :
     3788           find first buf_doc-fbr-gds no-lock where buf_doc-fbr-gds.out-code = loc-gds-dtl.doc-code
     3789                                                and buf_doc-fbr-gds.gds-code = goods.gds-code
     3790                                                no-error .
     3791           if available buf_doc-fbr-gds
     3792           then do :
     3793             if buf_doc-fbr-gds.fact-qnty >= 0
     3794             then do :
     3795               chg-qnty = if res-qnty >= 0 then buf_doc-fbr-gds.fact-qnty else - buf_doc-fbr-gds.fact-qnty .
     3796             end.
     3797             else do :
     3798               assign
     3799                 v-to-reserv = no
     3800               .
     3801             end.
     3802           end.
     3803         end.
     3804       end.
     3805       if v-to-reserv and chg-qnty <> 0 then do:
     3806         if b-trn-doc.status_ = 'нередакт':U
     3807         or b-trn-doc.flag <> no
     3808         then do:
     3809           assign
     3810           v-return-status =  b-trn-doc.status_
     3811           v-return-flag = b-trn-doc.flag
     3812           b-trn-doc.status_ = 'накл':U
     3813           b-trn-doc.flag = no
     3814           v-return-st-fl = yes
     3815           .
     3816         end.
     3817         if not (is-gas(gdscode) and buf_sale-doc.doc-kind <> 'rs':U)
     3818         then do :
     3819           if recid(loc-gds-dtl) <> current-rgds-dtl then assign num_rec = num_rec + 1 current-rgds-dtl = recid(loc-gds-dtl).
     3820         end.
     3821         run trg/rsrv-dtl.p (
     3822                          input parparentproc
     3823                         ,input rsrv-option
     3824                         ,buffer loc-gds-dtl
     3825                         ,input-output chg-qnty
     3826                         ,input-output cost-base
     3827                         ,input-output cost-rubl
     3828                         , -1
     3829                         , "" ) no-error.
     3830         if error-status:error then  do:
     3831           v-return-st-fl = no.
     3832           undo _gdsdtl, return error.
     3833         end.
     3834       if v-return-st-fl then do:
     3835         assign
     3836         b-trn-doc.status_ = v-return-status
     3837         b-trn-doc.flag = v-return-flag
     3838         v-return-st-fl = no
     3839         .
     3840       end.
     3841         if cashfbr then do:
     3842           assign
