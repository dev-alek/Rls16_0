        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-curr-r-b as character no-undo .
        4   define parameter buffer X_chk-doc for ub.chk-doc.
        5   define variable vss-revision    as character no-undo init "$Revision: 18022dc3b171, 1949, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        7   define variable vss-date        as character no-undo init "$Date: Fri Jul 26 11:38:58 2019 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: excl-chk.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: str/excl-chk.p $":U .
       10   define variable vss-description as character no-undo init "Исключение чека из незакрытой продажи".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
