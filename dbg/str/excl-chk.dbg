      702   field prod-code  like ub.doc-line.prod-code
      703   field prt-code  like ub.gds-dtl.prt-code
      704   field obj-type   like ub.doc-line.obj-type
      705   field obj-code   like ub.doc-line.obj-code
      706   field error-message as character
      707   field a-to-res as decimal
      708   field was-res as decimal
      709   field to-res as decimal
      710   field is-res as decimal
      711   field o-was-res as decimal
      712   field o-to-res as decimal
      713   field o-is-res as decimal
      714   index pi is unique primary
      715   obj-type
      716   obj-code
      717   artic
      718   prod-type
      719   prod-code
      720   index iartic
      721   artic
      722   prod-type
      723   prod-code
      724   .
      725   define shared temp-table tt0-doc-line no-undo like lib-trn_ret-line.
      726   define shared temp-table tt0-gds-dtl  no-undo like ub.gds-dtl.
      727   define shared temp-table tt0-parts    no-undo like ub.parts.
      728   define shared temp-table temp-tpsi-clients  no-undo like ub.clients.
      729   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
      730   define variable v-ps as character no-undo .
      731   assign
      732   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
      733                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
      734                     , buf_sale-doc.out-code
      735                     , buf_sale-doc.obj-type
      736                     , buf_sale-doc.obj-code
      737                     , chr(4)
      738                     , buf_sale-doc.tot-lines
      739                     , buf_sale-doc.tot-dtl
      740                     ).
      741   return v-Ps.
      742   END FUNCTION.
      743   procedure create-tt0-doc-line-gds-dtl :
      744   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
      745   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
      746   define input parameter p-ext-doc-type        as character no-undo .
      747   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
      748   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
      749   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
      750   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
      751   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
      752   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
      753   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
      754   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
      755   define parameter buffer b-doc-line           for ub.doc-line.
      756   define parameter buffer b-gds-dtl            for ub.gds-dtl.
      757   define parameter buffer buf_sale-doc for ub.sale-doc.
      758   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
      759   define buffer other_doc-line for ub.doc-line.
      760   define buffer other_gds-dtl for ub.gds-dtl.
      761     do
      762     on error undo, return error return-value
      763     :
      764       find first tt0-doc-line where
      765                 tt0-doc-line.obj-type = p-proprietor-obj-type
      766             AND tt0-doc-line.obj-code = p-proprietor-obj-code
      767             AND tt0-doc-line.prod-type = p-prod-type
      768             AND tt0-doc-line.prod-code = p-prod-code
      769             AND tt0-doc-line.artic     = p-artic
      770             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
      771             AND tt0-doc-line.status_      = 'нередакт':U no-error .
      772       if not available tt0-doc-line then do:
      773         create tt0-doc-line.
      774         buffer-copy b-doc-line
      775         except
      776         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
      777         to tt0-doc-line
      778         assign
      779         tt0-doc-line.status_ = 'нередакт':U
      780         tt0-doc-line.ext-doc-type = p-ext-doc-type
      781         tt0-doc-line.obj-type = p-proprietor-obj-type
      782         tt0-doc-line.obj-code = p-proprietor-obj-code
      783         tt0-doc-line.doc-code = p-doc-code
      784         .
      785       end.
      786       if p-doc-code <> "":U then do:
      787         find first other_doc-line no-lock where
      788                 other_doc-line.doc-code = p-doc-code
      789             AND  other_doc-line.artic    = p-artic
      790             AND  other_doc-line.prod-type = p-prod-type
      791             AND  other_doc-line.prod-code = p-prod-code no-error .
      792         if available other_doc-line then do:
      793           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
      794           assign
      795           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
      796           .
      797         end.
      798         else do:
      799           assign
      800           tt0-doc-line.doc-code = '':U
      801           .
      802         end.
      803       end.
      804       find first tt0-gds-dtl where
      805               tt0-gds-dtl.obj-type = p-proprietor-obj-type
      806           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
      807           AND tt0-gds-dtl.prod-type = p-prod-type
      808           AND tt0-gds-dtl.prod-code = p-prod-code
      809           AND tt0-gds-dtl.artic     = p-artic
      810           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
      811       if not available tt0-gds-dtl then do:
      812         create tt0-gds-dtl.
      813         buffer-copy b-gds-dtl
      814         except
      815         obj-type obj-code doc-code doc-qnty fact-qnty
      816         to tt0-gds-dtl
      817         assign
      818         tt0-gds-dtl.obj-type = p-proprietor-obj-type
      819         tt0-gds-dtl.obj-code = p-proprietor-obj-code
      820         tt0-gds-dtl.doc-code = p-doc-code
      821         .
      822       end.
      823       if p-doc-code <> "":U then do:
      824           find first other_gds-dtl no-lock where
      825                   other_gds-dtl.doc-code = p-doc-code
      826               AND  other_gds-dtl.artic    = p-artic
      827               AND  other_gds-dtl.prod-type    = p-prod-type
      828               AND  other_gds-dtl.prod-code    = p-prod-code
      829               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
      830           if available other_gds-dtl then do:
      831             assign
      832             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
      833             .
      834           end.
      835           else do:
      836             assign
      837             tt0-gds-dtl.doc-code = '':U
      838             .
      839           end.
      840       end.
      841       assign
      842       old-qnty = tt0-gds-dtl.doc-qnty
      843       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
      844       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
      845       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
      846       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
      847       .
      848     end.
      849   end procedure.
      850   procedure fill-tt-tpsi-table :
      851   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
      852   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
      853   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
      854   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
      855   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
      856   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
      857   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
      858   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
      859   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
      860   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
      861   define buffer buf_goods for ub.goods.
      862   define buffer buf_doc-line for ub.doc-line.
      863   define buffer buf_gds-dtl for ub.gds-dtl.
      864   define buffer buf_sale-doc for ub.sale-doc.
      865     do
      866     on error undo, return error
      867     :
      868       _doc-line:
      869       for each buf_Doc-line no-lock where
      870             buf_doc-line.doc-code = p-doc-code,
      871         first buf_goods no-lock where
      872             buf_goods.artic = buf_doc-line.artic
      873        AND  buf_goods.prod-type  = buf_doc-line.prod-type
      874        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
      875           each buf_gds-dtl no-lock where
      876             buf_gds-dtl.doc-code = buf_doc-line.doc-code
      877         AND  buf_gds-dtl.artic    = buf_doc-line.artic
      878         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
      879         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
      880         assign
      881         v-ext-doc-type = "":U.
      882         run tpsi-preselect-gds-proprietor in this-procedure (
      883                                                     input buf_goods.gds-code
      884                                                   ,input g#db-num
      885                                                   ,output v-proprietor-host-code
      886                                                   ,output v-proprietor-obj-type
      887                                                   ,output v-proprietor-obj-code ) no-error .
      888         if v-proprietor-host-code = p-host-code then do:
      889           assign
      890           v-ext-doc-type = 'ev':U .
      891         end.
      892         else do:
      893           assign
      894           v-ext-doc-type =  'ee':U .
      895         end.
      896         if  (v-proprietor-obj-type = p-obj-type
      897         AND v-proprietor-obj-code = p-obj-code)
      898         OR (v-proprietor-obj-type = "":U
      899         AND v-proprietor-obj-code = 0)
      900         OR v-proprietor-obj-code = ?
      901         then next _doc-line.
      902         find first buf_sale-doc no-lock where
      903                   buf_sale-doc.inkas-code = p-doc-code
      904              AND buf_sale-doc.obj-type = v-proprietor-obj-type
      905              AND buf_sale-doc.obj-code = v-proprietor-obj-code
      906              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
      907              no-error .
      908         run create-tt0-doc-line-gds-dtl  in this-procedure (
      909                                                              input v-proprietor-obj-type
      910                                                             ,input v-proprietor-obj-code
      911                                                             ,input v-ext-doc-type
      912                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
      913                                                             ,input buf_doc-line.artic
      914                                                             ,input buf_Doc-line.prod-type
      915                                                             ,input buf_doc-line.prod-code
      916                                                             ,input buf_gds-dtl.prt-code
      917                                                             ,input 0
      918                                                             ,output v-was-gds-dtl-fact-qnty
      919                                                             ,output v-gds-dtl-fact-qnty
      920                                                             ,buffer buf_doc-line
      921                                                             ,buffer buf_gds-dtl
      922                                                             ,buffer buf_sale-doc
      923                                                           ).
      924       end.
      925     end.
      926   end procedure.
      927   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      928   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      929   procedure get-alias-type-price-obj :
      930   define input parameter p-host-code like ub.sysconf.host-code no-undo .
      931   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
      932   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
      933   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
      934   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
      935   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
      936   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
      937   define output parameter p-alias-type-price as character no-undo .
      938   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
      939   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
      940   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
      941   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
      942   define variable v-mediat-objf               as character no-undo .
      943   define variable v-param-type as character no-undo .
      944   define variable v-value-character as character no-undo .
      945   define variable v-value-date as date no-undo .
      946   define variable v-value-decimal as decimal no-undo .
      947   define variable v-value-integer as INTEGER no-undo .
      948   define variable v-value-logical AS LOGICAL no-undo .
      949   define variable v-tth as handle no-undo .
      950   assign
      951   v-tth = buffer thbjattr_thbj-attr:table-handle .
      952   define buffer buf_trn-doc for ub.trn-doc.
      953     _main:
      954     do
      955     on error undo, return error return-value
      956     :
      957       run adm/shattri.p (
      958         input "get":U
      959         ,input  p-prop-obj-type
      960         ,input  p-prop-obj-code
      961         ,input  'alias-tpsi':U
      962         ,input  '':U
      963         ,output v-value-character
      964         ,output v-value-date
      965         ,output v-value-decimal
      966         ,output v-value-integer
      967         ,output v-value-logical
      968         ,output v-param-type
      969         ,INPUT-OUTPUT table-handle v-tth
      970         ) no-error .
      971       if error-status:error
      972       then do:
      973         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
      974                                 , p-prop-obj-type
      975                                 , p-prop-obj-code).
      976       end.
      977       find first thbjattr_thbj-attr where
      978                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
      979             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
      980             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
      981             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
      982       if not available thbjattr_thbj-attr
      983       or thbjattr_thbj-attr.property-value-integer = 0 then do:
      984         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
      985                                 , p-prop-obj-type
      986                                 , p-prop-obj-code).
      987       end.
      988       assign
      989       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
      990       if p-prop-host-code = p-host-code
      991       and (p-alias-type-price = '':U
      992       or   p-alias-type-price <> '5':U)
      993       then  do:
      994         assign
      995         p-ext-doc-type = 'ev':U
      996         p-price-obj-type = p-obj-type
      997         p-price-obj-code = p-obj-code
      998         p-alias-type-price = '3':U
      999         .
     1000       end.
     1001       else do:
     1002         if p-prop-host-code = p-host-code  then do:
     1003           assign
     1004           p-ext-doc-type = 'ev':U
     1005           p-price-obj-type = p-obj-type
     1006           p-price-obj-code = p-obj-code
     1007           .
     1008         end.
     1009         else do:
     1010           assign
     1011           p-ext-doc-type = 'ee':U.
     1012           assign
     1013           v-mediat-obj-type = "":U
     1014           v-mediat-obj-code = 0
     1015           v-mediat-objf = "":U
     1016           .
     1017           if p-alias-type-price = '4':U then do:
     1018             find first thbjattr_thbj-attr where
     1019                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1020                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1021                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1022                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
     1023             if not available thbjattr_thbj-attr
     1024             or thbjattr_thbj-attr.property-value-character = "":U then do:
     1025               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
     1026                                       , p-prop-obj-type
     1027                                       , p-prop-obj-code).
     1028             end.
     1029             assign
     1030             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
     1031             v-mediat-obj-type = entry(1, v-mediat-objf)
     1032             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
     1033             no-error
     1034             .
     1035             if error-status:error then do:
     1036               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
     1037                                       , p-prop-obj-type
     1038                                       , p-prop-obj-code).
     1039             end.
     1040           end.
     1041           CASE p-alias-type-price:
     1042             when '1':U then do:
     1043               assign
     1044               p-price-obj-type = p-prop-obj-type
     1045               p-price-obj-code = p-prop-obj-code
     1046               .
     1047             end.
     1048             when '2':U then do:
     1049               assign
     1050               p-price-obj-type = p-prop-obj-type
     1051               p-price-obj-code = p-prop-obj-code
     1052               .
     1053             end.
     1054             when '3':U
     1055             or
     1056             when '5':U
     1057             then do:
     1058               assign
     1059               p-price-obj-type = p-obj-type
     1060               p-price-obj-code = p-obj-code
     1061               .
     1062             end.
     1063             when '4':U then do:
     1064               assign
     1065               p-price-obj-type = v-mediat-obj-type
     1066               p-price-obj-code = v-mediat-obj-code
     1067               .
     1068             end.
     1069           END CASE.
     1070         end.
     1071       end.
     1072     end.
     1073   end procedure.
     1074   procedure write-tt0-info:
     1075   define input parameter p-artic as character no-undo .
     1076   define input parameter p-prod-type as character no-undo .
     1077   define input parameter p-prod-code as integer no-undo .
     1078   define input parameter p-prt-code as integer no-undo .
     1079   define input parameter p-obj-type as character no-undo .
     1080   define input parameter p-obj-code as integer no-undo .
     1081   define input parameter p-doc-code as character no-undo .
     1082   define input parameter p-from-tpsi as logical no-undo .
     1083   define input parameter p-all-qnty as decimal no-undo .
     1084   define input parameter p-was-res as decimal no-undo .
     1085   define input parameter p-to-res as decimal no-undo .
     1086   define input parameter p-is-res as decimal no-undo .
     1087   define input parameter p-o-was-res as decimal no-undo .
     1088   define input parameter p-o-to-res as decimal no-undo .
     1089   define input parameter p-o-is-res as decimal no-undo .
     1090   define input parameter p-mess   as character no-undo .
     1091   define buffer buf_tt0-info for tt0-info.
     1092     do
     1093     on error undo, return error return-value
     1094     :
     1095       find first buf_tt0-info where
     1096                buf_tt0-info.artic = p-artic
     1097            and buf_tt0-info.prod-type = p-prod-type
     1098            and buf_tt0-info.prod-code = p-prod-code
     1099            and buf_tt0-info.prt-code = p-prt-code
     1100            no-error .
     1101       if not available buf_tt0-info then do:
     1102         create buf_tt0-info.
     1103         assign
     1104         buf_tt0-info.artic = p-artic
     1105         buf_tt0-info.prod-type = p-prod-type
     1106         buf_tt0-info.prod-code = p-prod-code
     1107         buf_tt0-info.prt-code  = p-prt-code
     1108         buf_tt0-info.obj-type  = p-obj-type
     1109         buf_tt0-info.obj-code  = p-obj-code
     1110         buf_tt0-info.a-to-res  = ?
     1111         buf_tt0-info.to-res    = ?
     1112         buf_tt0-info.was-res   = ?
     1113         buf_tt0-info.o-was-res = ?
     1114         buf_tt0-info.o-to-res  = ?
     1115         buf_tt0-info.o-is-res  = ?
     1116         buf_tt0-info.is-res    = ?
     1117         .
     1118       end.
     1119       assign
     1120       buf_tt0-info.a-to-res  =
     1121                                 (if buf_tt0-info.a-to-res <> ?
     1122                                 and p-all-qnty = ?
     1123                                 then buf_tt0-info.a-to-res
     1124                                 else p-all-qnty)
     1125       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
     1126                                 and p-was-res = ?
     1127                                 then buf_tt0-info.was-res
     1128                                 else p-was-res)
     1129       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
     1130                                 and p-to-res = ?
     1131                                 then buf_tt0-info.to-res
     1132                                 else p-to-res)
     1133       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
     1134                                 and p-is-res = ?
     1135                                 then buf_tt0-info.is-res
     1136                                 else p-is-res)
     1137       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
     1138                                 and p-o-was-res = ?
     1139                                 then buf_tt0-info.o-was-res
     1140                                 else p-o-was-res)
     1141       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
     1142                                 and p-o-to-res = ?
     1143                                 then buf_tt0-info.o-to-res
     1144                                 else p-o-to-res)
     1145       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
     1146                                 and p-o-is-res = ?
     1147                                 then buf_tt0-info.o-is-res
     1148                                 else p-o-is-res)
     1149       .
     1150       assign
     1151       buf_tt0-info.doc-code  = p-doc-code
     1152       buf_tt0-info.error-message   = p-mess
     1153       .
     1154     end.
     1155   end procedure.
     1156   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1157   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     1158   define variable v-ps as character no-undo .
     1159   if available buf_sale-doc then
     1160   assign
     1161   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     1162                       , chr(4)
     1163                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
     1164                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     1165                       , buf_sale-doc.chk-amount
     1166                       , buf_sale-doc.gds-amount
     1167                       , buf_sale-doc.tot-lines
     1168                       , buf_sale-doc.tot-dtl
     1169                       ).
     1170   else  do:
     1171   assign
     1172   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     1173                       , chr(4)
     1174                       , '':U
     1175                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     1176                       , 0
     1177                       , 0
     1178                       , 0
     1179                       , 0
     1180                       ).
     1181   end.
     1182   return v-ps.
     1183   END FUNCTION.
     1184   FUNCTION get-sale-doc-kind returns character (
     1185                                                input p-doc-kind as character
     1186                                              , input p-ext-doc-type as character
     1187                                              , output p-order as integer
     1188                                              , output p-msign as integer
     1189                                              , output p-main as logical
     1190                                              , output p-in-inkas as logical
     1191                                              , output p-dir_ as integer
     1192                                              ):
     1193   define variable v-doc-kind as character no-undo.
     1194   define variable v-type as character no-undo .
     1195   define variable v-value as character no-undo .
     1196   CASE p-doc-kind:
     1197     when 'es':U then do:
     1198       assign
     1199       p-order = 100
     1200       p-msign = 1
     1201       p-main = yes
     1202       p-in-inkas = yes
     1203       p-dir_ = 1
     1204       .
     1205       return p-ext-doc-type.
     1206     end.
     1207     when  'rs':U then do:
     1208       assign
     1209       p-order = 200
     1210       p-msign = - 1
     1211       p-main = no
     1212       p-in-inkas = yes
     1213       p-dir_ = - 1
     1214       .
     1215       return p-ext-doc-type.
     1216     end.
     1217     when 'rwo':U then do:
     1218       assign
     1219       p-msign = - 1
     1220       p-main = no
     1221       p-in-inkas = no
     1222       p-order = 300
     1223       p-dir_ = 1
     1224       .
     1225       return 'rwo':U.
     1226     end.
     1227     when 'trf':U then do:
     1228       assign
     1229       p-msign = 1
     1230       p-main = no
     1231       p-in-inkas = no
     1232       p-order = 400
     1233       p-dir_ = 1
     1234       .
     1235       return 'trf':U.
     1236     end.
     1237     when 'swo':U then do:
     1238      assign
     1239      p-msign = 1
     1240      p-main = no
     1241      p-in-inkas = no
     1242      p-order =  500
     1243      p-dir_ = 1
     1244      .
     1245      return 'swo':U.
     1246    end.
     1247    when 'vir':U then do:
     1248      assign
     1249      p-msign = 1
     1250      p-main = no
     1251      p-in-inkas = no
     1252      p-order = 600
     1253      p-dir_ = 1
     1254      .
     1255      return 'vir':U.
     1256    end.
     1257    when 'itr':U then do:
     1258      assign
     1259      p-msign = 1
     1260      p-main = no
     1261      p-in-inkas = no
     1262      p-order = -1
     1263      p-dir_ = -1
     1264      .
     1265     return 'itr':U.
     1266    end.
     1267    when 'ngs':U then do:
     1268      assign
     1269      p-msign = 1
     1270      p-main = no
     1271      p-in-inkas = no
     1272      p-order = 700
     1273      p-dir_ = 1
     1274      .
     1275      return 'ngs':U.
     1276    end.
     1277    when 'rgs':U then do:
     1278      assign
     1279      p-msign = -1
     1280      p-main = no
     1281      p-in-inkas = no
     1282      p-order = 701
     1283      p-dir_ = -1
     1284      .
     1285      return 'rgs':U.
     1286    end.
     1287    otherwise do:
     1288       assign
     1289       p-msign = 1
     1290       p-main = no
     1291       p-in-inkas = no
     1292       p-order = -1.
     1293       return p-ext-doc-type.
     1294     end.
     1295   END CASE.
     1296   END FUNCTION.
     1297   procedure saledoc-create :
     1298   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     1299   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1300   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1301   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1302   define input parameter p-doc-kind as character no-undo .
     1303   define input parameter p-office as character no-undo .
     1304   define input parameter p-tpsidoc as logical no-undo .
     1305   define input parameter p-alias-type-price as character no-undo .
     1306   define input parameter p-price-obj-type as character no-undo .
     1307   define input parameter p-price-obj-code as integer no-undo .
     1308   define parameter buffer buf_trn-doc for ub.trn-doc.
     1309   define variable v-order as integer no-undo.
     1310   define variable v-main as logical no-undo .
     1311   define variable v-in-inkas as logical no-undo .
     1312   define variable v-msign as integer no-undo .
     1313   define variable v-dir_ as integer no-undo .
     1314   define variable v-trn-doc-code as character no-undo .
     1315   define buffer buf_sale-doc for ub.sale-doc.
     1316   main-block:
     1317   do
     1318   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1319   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1320   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1321   :
     1322      if available buf_trn-doc then do:
     1323        v-trn-doc-code = buf_trn-doc.doc-code.
     1324      end.
     1325      find first buf_sale-doc where
     1326               buf_sale-doc.inkas-code = p-inkas-code
     1327           and buf_sale-doc.doc-kind = p-doc-kind
     1328           and buf_sale-doc.chr-office = p-office
     1329           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
     1330           no-error .
     1331      if not available buf_sale-doc  then do:
     1332         create buf_sale-doc.
     1333         assign
     1334         buf_sale-doc.inkas-code = p-inkas-code
     1335         buf_sale-doc.storage =  'trn-doc':U
     1336         buf_sale-doc.host-code = p-host-code
     1337         buf_sale-doc.obj-type = p-obj-type
     1338         buf_sale-doc.obj-code = p-obj-code
     1339         buf_sale-doc.doc-kind  = p-doc-kind
     1340         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
     1341         buf_sale-doc.chr-office = p-office
     1342         buf_sale-doc.doc-code = v-trn-doc-code
     1343         .
     1344      end.
     1345      if available buf_trn-doc then
     1346      buffer-copy buf_trn-doc
     1347      to buf_sale-doc
     1348      .
     1349     assign
     1350     buf_sale-doc.doc-kind = get-sale-doc-kind (
     1351                                                input p-doc-kind
     1352                                               ,input buf_sale-doc.ext-doc-type
     1353                                               ,output v-order
     1354                                               ,output v-msign
     1355                                               ,output v-main
     1356                                               ,output v-in-inkas
     1357                                               ,output v-dir_).
     1358     assign
     1359     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
     1360     buf_sale-doc.main-doc = v-main
     1361     buf_sale-doc.in-inkas = v-in-inkas
     1362     buf_sale-doc.msign = v-msign
     1363     buf_sale-doc.dir = v-dir_
     1364     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
     1365     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
     1366     buf_sale-doc.poss-wro-codes = '':U
     1367     buf_sale-doc.chr-office = p-office
     1368     buf_sale-doc.tpsidoc = p-tpsidoc
     1369     buf_sale-doc.alias-type-price = p-alias-type-price
     1370     buf_sale-doc.price-obj-type = (if p-tpsidoc
     1371                                    then p-price-obj-type
     1372                                    else '':U)
     1373     buf_sale-doc.price-obj-code = (if p-tpsidoc
     1374                                    then p-price-obj-code
     1375                                    else 0)
     1376     .
     1377     assign
     1378     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
     1379     no-error.
     1380   end.
     1381   END.
     1382   procedure fbr-saledoc-create :
     1383   define input parameter p-inkas-code as character no-undo .
     1384   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
     1385   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
     1386   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
     1387   define buffer buf_fbr-doc for ub.fbr-doc.
     1388   define buffer buf_trn-doc for ub.trn-doc.
     1389   define buffer buf_sale-doc for ub.sale-doc.
     1390   define buffer buf2_sale-doc for ub.sale-doc.
     1391   define buffer buf2_trn-doc for ub.trn-doc.
     1392   define buffer buf_doc-line for ub.doc-line.
     1393   define buffer buf_gds-dtl for ub.gds-dtl.
     1394   define buffer buf_chk-gds for ub.chk-gds.
     1395   define buffer buf_chk-doc for ub.chk-doc.
     1396   do
     1397   on error undo, return error
     1398   :
     1399     for each buf_fbr-doc no-lock where
     1400           buf_fbr-doc.out-code = p-inkas-code:
     1401       for each buf_trn-doc no-lock where
     1402             buf_trn-doc.out-code = buf_fbr-doc.doc-code
     1403       by buf_trn-doc.fact-order
     1404       on error undo, return error:
     1405         if buf_trn-doc.ext-doc-type = 'em':U
     1406         or buf_trn-doc.ext-doc-type = 'im':U
     1407         or buf_trn-doc.ext-doc-type = 'wm':U
     1408         or buf_trn-doc.ext-doc-type = 'ev':U
     1409         or buf_trn-doc.ext-doc-type = 'iv':U
     1410         then do:
     1411           find first buf_sale-doc where
     1412                   buf_sale-doc.inkas-code = p-inkas-code
     1413               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
     1414               AND buf_sale-doc.storage  = 'trn-doc':U
     1415                   no-error .
     1416           if not available buf_sale-doc then do:
     1417           create buf_sale-doc.                                                                                             buffer-copy buf_trn-doc                                                                                             to buf_sale-doc.                                                                                                assign                                                                                                                  buf_sale-doc.storage  =  'trn-doc':U                                                                          buf_sale-doc.doc-kind = buf_trn-doc.ext-doc-type                                                                buf_sale-doc.order =  - 1                                                                                          buf_sale-doc.main-doc = no                                                                                             buf_sale-doc.in-inkas = no                                                                                         buf_sale-doc.fbrsale = yes                                                                                         buf_sale-doc.msign = 1                                                                                             buf_sale-doc.filled   = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0                       buf_sale-doc.doc-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf_sale-doc.doc-qnty)                                                          buf_sale-doc.fact-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf_sale-doc.fact-qnty)                                                        buf_sale-doc.inkas-code = p-inkas-code.
     1418           end.
     1419           if buf_trn-doc.ext-doc-type = 'im':U then do:
     1420             assign
     1421             v-pri-prvo-doc-qnty = buf_trn-doc.doc-qnty
     1422             v-pri-prvo-fact-qnty = buf_trn-doc.fact-qnty
     1423             v-pri-prvo-tot-lines = buf_trn-doc.tot-lines
     1424             .
     1425           end.
     1426           for each buf2_trn-doc no-lock where
     1427                   buf2_trn-doc.out-code = buf_sale-doc.doc-code:
     1428             find first buf2_sale-doc where
     1429                     buf2_sale-doc.inkas-code = p-inkas-code
     1430                 and buf2_sale-doc.doc-code = buf2_trn-doc.doc-code
     1431                 AND buf2_sale-doc.storage = 'trn-doc':U no-error .
     1432             if not available buf2_sale-doc then do:
     1433               create buf2_sale-doc.                                                                                             buffer-copy buf2_trn-doc                                                                                             to buf2_sale-doc.                                                                                                assign                                                                                                                  buf2_sale-doc.storage  =  'trn-doc':U                                                                          buf2_sale-doc.doc-kind = buf2_trn-doc.ext-doc-type                                                                buf2_sale-doc.order =  - 1                                                                                          buf2_sale-doc.main-doc = no                                                                                             buf2_sale-doc.in-inkas = no                                                                                         buf2_sale-doc.fbrsale = yes                                                                                         buf2_sale-doc.msign = 1                                                                                             buf2_sale-doc.filled   = buf2_sale-doc.fact-qnty <> 0 or buf2_sale-doc.tot-lines <> 0                       buf2_sale-doc.doc-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf2_sale-doc.doc-qnty)                                                          buf2_sale-doc.fact-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf2_sale-doc.fact-qnty)                                                        buf2_sale-doc.inkas-code = p-inkas-code.
     1434             end.
     1435           end.
     1436         end.
     1437       end.
     1438       find first buf_sale-doc where
     1439                 buf_sale-doc.inkas-code = p-inkas-code
     1440             AND buf_sale-doc.storage = 'fbr-doc':U
     1441             AND buf_sale-doc.doc-code = buf_fbr-doc.doc-code no-error .
     1442       if not available buf_sale-doc then do:
     1443         create buf_sale-doc.
     1444         assign
     1445         buf_sale-doc.storage       =  'fbr-doc':U
     1446         buf_sale-doc.doc-type      = 'производство':U
     1447         buf_sale-doc.doc-code      = buf_fbr-doc.doc-code
     1448         buf_sale-doc.ext-doc-type  = 'производство':U
     1449         buf_sale-doc.doc-kind      = 'производство':U
     1450         buf_sale-doc.obj-type      = buf_fbr-doc.obj-type
     1451         buf_sale-doc.obj-code      = buf_fbr-doc.obj-code
     1452         buf_sale-doc.cli-type      = buf_fbr-doc.obj-type
     1453         buf_sale-doc.cli-code      = buf_fbr-doc.obj-code
     1454         buf_sale-doc.doc-qnty      = v-pri-prvo-doc-qnty
     1455         buf_sale-doc.fact-qnty     = v-pri-prvo-fact-qnty
     1456         buf_sale-doc.tot-lines     = v-pri-prvo-tot-lines
     1457         buf_sale-doc.tot-dtl       = v-pri-prvo-tot-lines
     1458         buf_sale-doc.fbrsale       = yes
     1459         buf_sale-doc.inkas-code    = p-inkas-code
     1460         .
     1461       end.
     1462     end.
     1463   end.
     1464   end procedure.
