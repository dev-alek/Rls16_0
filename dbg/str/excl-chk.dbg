     4051                                           ,input v-ext-doc-type
     4052                                           ,input (if available tpsi_sale-doc then tpsi_sale-doc.doc-code else "":U)
     4053                                           ,input  b-doc-line.artic
     4054                                           ,input  b-doc-line.prod-type
     4055                                           ,input  b-doc-line.prod-code
     4056                                           ,input  loc-gds-dtl.prt-code
     4057                                           ,input  (if rz
     4058                                                     then (loc-gds-dtl.fact-qnty - loc-gds-dtl.doc-qnty)
     4059                                                     else
     4060                                                     (if r-qnty = ?
     4061                                                     then ?
     4062                                                     else r-qnty
     4063                                                     )
     4064                                                    )
     4065                                           ,output v-was-gds-dtl-doc-qnty
     4066                                           ,output v-gds-dtl-fact-qnty
     4067                                           ,buffer b-doc-line
     4068                                           ,buffer loc-gds-dtl
     4069                                           ,buffer tpsi_sale-doc
     4070                                           ).
     4071           if not v-is-own and p-r-v > 0 and v-gds-dtl-fact-qnty <> 0 then do:
     4072             if not (is-gas(gdscode) and buf_sale-doc.doc-kind <> 'rs':U)
     4073             then do :
     4074               if recid(loc-gds-dtl) <> current-rgds-dtl then assign num_rec = num_rec + 1 current-rgds-dtl = recid(loc-gds-dtl).
     4075             end.
     4076             run write-tt0-info in this-procedure (
     4077                                                   input b-doc-line.artic
     4078                                                 ,input b-doc-line.prod-type
     4079                                                 ,input b-doc-line.prod-code
     4080                                                 ,input loc-gds-dtl.prt-code
     4081                                                 ,input v-proprietor-obj-type
     4082                                                 ,input v-proprietor-obj-code
     4083                                                 ,input (if available tpsi_sale-doc then tpsi_sale-doc.doc-code else "":U)
     4084                                                 ,input no
     4085                                                 ,input loc-gds-dtl.fact-qnty
     4086                                                 ,input loc-gds-dtl.doc-qnty
     4087                                                 ,input ?
     4088                                                 ,input loc-gds-dtl.fact-qnty
     4089                                                 ,input v-was-gds-dtl-doc-qnty
     4090                                                 ,input v-gds-dtl-fact-qnty
     4091                                                 ,input v-was-gds-dtl-doc-qnty
     4092                                                 ,input '':u).
     4093           end.
     4094           if v-gds-dtl-fact-qnty = 0 then do:
     4095               p-run-tpsi = no.
     4096           end.
     4097         end.
     4098       end.
     4099     END.
     4100   end.
     4101   END.
     4102   do
     4103   on error undo, return error return-value
     4104   :
     4105     assign
     4106     r-qnty = ?.
     4107     rsrv-title = substitute("Снятие резервов со всех товаров чека &1. Строк ", X_chk-doc.doc-code)
     4108     .
     4109     FIND FIRST ub.inkas WHERE ub.inkas.inkas-code = X_chk-doc.out-code NO-LOCK NO-ERROR.
     4110     if not avail ub.inkas then do:
     4111         message
     4112         substitute("Ошибка! Чек &1 привязан к отсутствующему отчету о продаже!", X_chk-doc.doc-code)
     4113         view-as alert-box ERROR.
     4114         return error.
     4115     end.
     4116   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4117   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4118     (input  ub.inkas.obj-type
     4119     ,input  ub.inkas.obj-code
     4120     ,output v-host-code
     4121     )  .
     4122     run get-inkas-ps in this-procedure (
     4123                                           buffer inkas
     4124                                         , output chk-amount
     4125                                         , output gds-amount
     4126                                         , output line-out
     4127                                         , output dtl-out
     4128                                         , output line-ret
     4129                                         , output dtl-ret
     4130                                         , output nf-chk-amount
     4131                                         , output nf-gds-amount
     4132                                         , output p-filter-rus
     4133                                         ).
     4134     FIND FIRST buf0_trn-doc exclusive-lock WHERE
     4135              buf0_trn-doc.doc-code = X_chk-doc.out-code no-wait NO-ERROR.
     4136     if not avail buf0_trn-doc then do:
     4137         message
     4138         substitute("Не найдена или не занята накладная &1!", X_chk-doc.out-code)  view-as alert-box ERROR.
     4139         undo, return error.
     4140     end.
     4141     assign
     4142     v-base-rate = buf0_trn-doc.base-rate
     4143     v-base-scale = buf0_trn-doc.base-scale
     4144     .
     4145   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4146   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4147     (output v-curr-r-b
     4148     )  .
     4149     docs-to-reserv = get-inc-sal(string(X_chk-doc.chk-type)
     4150                                 , input X_chk-doc.netto
     4151                                 , input yes
     4152                                 , input X_chk-doc.office
     4153                                 , input ?
     4154                                 , output v-add
     4155                                 , output office-to-reserv
     4156                                 , output kind-to-reserv
     4157                                 , output add-nf-amount
     4158                                 ).
     4159     v-cash-pay-attr = "".
     4160     cli-type-to-reserv = "".
     4161     cli-code-to-reserv = 0.
     4162     if X_chk-doc.chk-type = integer('17':U) then do:
     4163         for each buf_chk-pay where buf_chk-pay.doc-code = X_chk-doc.doc-code no-lock:
     4164             find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = buf_chk-pay.pay-code
     4165                                          and buf_cash-pay-attr.curr-code = buf_chk-pay.curr-code
     4166                                          and buf_cash-pay-attr.attr-code = "dop-doc" no-lock no-error.
     4167             if not available(buf_cash-pay-attr) then next.
     4168             v-cash-pay-attr = buf_cash-pay-attr.attr-value.
     4169             case entry(1, v-cash-pay-attr, ','):
     4170                 when 'swo':U then do:
     4171                     v-add = no.
     4172                     docs-to-reserv = 1.
     4173                     office-to-reserv = 'т':U.
     4174                     kind-to-reserv = entry(1, v-cash-pay-attr, ',').
     4175                     cli-type-to-reserv = entry(2, v-cash-pay-attr, ',').
     4176                     cli-code-to-reserv = int(entry(3, v-cash-pay-attr, ',')).
     4177                 end.
     4178                 when 'trf':U then do:
     4179                     cli-type-to-reserv = entry(2, v-cash-pay-attr, ',').
     4180                     cli-code-to-reserv = int(entry(3, v-cash-pay-attr, ',')).
     4181                 end.
     4182                 when 'vir':U then do:
     4183                     kind-to-reserv = 'vir':U.
     4184                     cli-type-to-reserv = entry(2, v-cash-pay-attr, ',').
     4185                     cli-code-to-reserv = int(entry(3, v-cash-pay-attr, ',')).
     4186                 end.
     4187                 when 'none' then do:
     4188                     docs-to-reserv = 0.
     4189                     kind-to-reserv = 'none'.
     4190                 end.
     4191             end case.
     4192         end.
     4193     end.
     4194     assign
     4195     v-is-tpsi-obj = can-find(first tpsi_sale-doc no-lock where
     4196                                   tpsi_sale-doc.inkas-code = X_chk-doc.out-code
     4197                               and tpsi_sale-doc.tpsidoc = yes).
     4198   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4199   empty temp-table thbjattr_thbj-attr.
     4200   run adm/shattri.p (
     4201      input "get":U
     4202     ,input ''
     4203     ,input 0
     4204     ,input 'nakl_par':U
     4205     ,input  ""
     4206     ,output v-value-character
     4207     ,output v-value-date
     4208     ,output v-value-decimal
     4209     ,output v-value-integer
     4210     ,output v-value-logical
     4211     ,output par-type
     4212     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4213     ) no-error .
     4214     for each thbjattr_thbj-attr :
     4215         if thbjattr_thbj-attr.prop-code = 'factorrt' then factorrt = thbjattr_thbj-attr.property-value-integer .
     4216     end.
     4217     run adm/shattri.p (
     4218         input "get":U
     4219         ,input  inkas.obj-type
     4220         ,input  inkas.obj-code
     4221         ,input  'autosale':U
     4222         ,input  'prcl-spl':U
     4223         , output v-value-character
     4224         , output v-value-date
     4225         , output v-value-decimal
     4226         , output v-value-integer
     4227         , output v-value-logical
     4228         , output par-type
     4229         , INPUT-OUTPUT table-handle v-tth
     4230         ) no-error .
     4231     IF not error-status:error then
     4232     assign
     4233     prcl-spl = v-value-logical.
     4234     delete object v-tth.
     4235     btltaxcd = integer('3':U).
     4236     for each buf_sale-doc where
     4237             buf_Sale-doc.inkas-code = inkas.inkas-code
     4238     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4239     :
     4240       buf_sale-doc.chk-doc-code = '':U.
     4241     end.
     4242     _chk-gds:
     4243     for each buf_chk-gds NO-LOCK WHERE buf_chk-gds.doc-code = X_chk-doc.doc-code
     4244     on error undo, return error error-status:get-message(1) :
     4245       assign
     4246       docs-to-reserv-gds = 0
     4247       kind-to-reserv-gds = '':U
     4248       office-to-reserv-gds = '':U
     4249       add-nf-gds-amount  = 0
     4250       v-add = no
     4251       .
     4252       if buf_chk-gds.doc-qnty = 0 then do:
     4253         gds-amount = gds-amount  - 1.
     4254         nf-gds-amount = nf-gds-amount + (if lookup(string(X_chk-doc.chk-type) ,'14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0
     4255                                           then - 1
     4256                                           else 0).
     4257         next _chk-gds.
     4258       end.
     4259       docs-to-reserv-gds = get-inc-sal(string(X_chk-doc.chk-type)
     4260                                   , input X_chk-doc.netto
     4261                                   , input no
     4262                                   , input entry(1, buf_chk-gds.line-type, chr(4))
     4263                                   , input string(BUF_CHK-GDS.WRITE-OFF-CODE)
     4264                                   , output v-add
     4265                                   , output office-to-reserv-gds
     4266                                   , output kind-to-reserv-GDS
     4267                                   , output add-nf-gds-amount
     4268                                   ).
     4269       if X_chk-doc.chk-type = integer('17':U) then do:
     4270           for each buf_chk-pay where buf_chk-pay.doc-code = X_chk-doc.doc-code no-lock:
     4271               find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = buf_chk-pay.pay-code
     4272                                            and buf_cash-pay-attr.curr-code = buf_chk-pay.curr-code
     4273                                            and buf_cash-pay-attr.attr-code = "dop-doc" no-lock no-error.
     4274               if not available(buf_cash-pay-attr) then next.
     4275               v-cash-pay-attr = buf_cash-pay-attr.attr-value.
     4276               case entry(1, v-cash-pay-attr, ','):
     4277                   when 'vir':U then do:
     4278                       assign
     4279                       kind-to-reserv-gds = 'vir':U
     4280                       docs-to-reserv-gds = 1
     4281                       v-add = no
     4282                       office-TO-RESERV-GDS = 'т'.
     4283                   end.
     4284                   when 'none' then do:
     4285                       assign
     4286                       kind-to-reserv-gds = 'none'
     4287                       docs-to-reserv-gds = 0
     4288                       v-add = no
     4289                       office-TO-RESERV-GDS = 'т'.
     4290                   end.
     4291                end case.
     4292           end.
     4293       end.
     4294       gds-amount = gds-amount - 1.
     4295       nf-gds-amount = nf-gds-amount  - add-nf-gds-amount.
     4296       assign
     4297       office-to-reserv-gds = (if v-add
     4298                             then (office-to-reserv + (if kind-to-reserv-gds = '':u
     4299                                                     then '':u
     4300                                                     else chr(44)) +
     4301                                  office-to-reserv-gds)
     4302                            else  office-to-reserv-gds)
     4303       kind-to-reserv-gds = (if v-add
     4304                             then (kind-to-reserv + (if kind-to-reserv-gds = '':u
     4305                                                     then '':u
     4306                                                     else chr(44)) +
     4307                                  kind-to-reserv-gds)
     4308                            else  kind-to-reserv-gds)
     4309       docs-to-reserv-gds = (if v-add
     4310                             then (docs-to-reserv  + docs-to-reserv-gds)
     4311                             else docs-to-reserv-gds)
     4312       .
     4313       if docs-to-reserv-gds <> 0 then dO:
     4314         FIND FIRST ub.bar-code No-LOCK WHERE
     4315                   ub.bar-code.b-code = buf_chk-gds.b-code No-ERROR.
     4316         IF NOT AVAIL bar-code then do:
     4317           message
     4318           substitute("Ошибки в строке чека &1 - товар с кодом &2 отсутствует в базе!"
     4319                      , X_chk-doc.doc-code
     4320                      , buf_chk-gds.b-code)
     4321           view-as alert-box ERROR.
     4322           run waitfram-hide in this-procedure .
     4323           undo, return error.
     4324         END.
     4325         FIND FIRST ub.goods NO-LOCK WHERE
     4326                     ub.goods.gds-code = ub.bar-code.gds-code NO-ERROR.
     4327         FIND FIRST ub.units No-LOCK WHERE
     4328                     ub.units.unit-name = ub.goods.unit-base NO-ERROR.
     4329         IF NOT AVAIL(goods) then do:
     4330           message "Не найден товар!" view-as alert-box ERROR.
     4331           run waitfram-hide in this-procedure .
     4332           undo, return error.
     4333         end.
     4334         IF NOT AVAIL(ub.units) then do:
     4335           message "Не найдена единица измерения!" view-as alert-box ERROR.
     4336           run waitfram-hide in this-procedure .
     4337           undo, return error.
     4338         end.
     4339         if can-find(first ub.tax-units where
     4340                           ub.tax-units.tax-code = btltaxcd AND
     4341                           LOOKUP(ub.tax-units.type, units.type) > 0 ) then  do:
     4342           assign
     4343           bottle = yes.
     4344         end.
     4345         else do:
     4346           bottle = no.
     4347         end.
     4348         _dtrg-gds:
     4349         do dtrg = 1 to docs-to-reserv-gds:
     4350           if entry(dtrg, office-to-reserv-gds) <> entry(1, buf_chk-gds.line-type, chr(4)) then next _dtrg-gds.
     4351           find first buf_sale-doc where
     4352                     buf_Sale-doc.inkas-code = inkas.inkas-code
     4353                 and buf_sale-doc.doc-kind = entry(dtrg, kind-to-reserv-gds)
     4354                 and buf_sale-doc.chr-office = entry(dtrg, office-to-reserv-gds)
     4355                 .
     4356           if dtrg <= docs-to-reserv
     4357           and X_chk-doc.doc-code <> buf_sale-doc.chk-doc-code then do:
     4358             assign
     4359             buf_sale-doc.chk-doc-code = X_chk-doc.doc-code
     4360             buf_sale-doc.chk-amount = buf_sale-doc.chk-amount - 1
     4361             .
     4362           end.
     4363           find first buf_doc-line nO-lock where
     4364                     buf_doc-line.doc-code = buf_sale-doc.doc-code
     4365                AND  buf_doc-line.artic = goods.artic
     4366                AND  buf_doc-line.prod-type = goods.prod-type
     4367                AND  buf_doc-line.prod-code = goods.prod-code No-ERROR.
     4368           if not avail buf_doc-line then NEXT.
     4369           FIND FIRST buf_gds-dtl WHERE
     4370                     buf_gds-dtl.doc-code = buf_sale-doc.doc-code
     4371                AND  buf_gds-dtl.artic = goods.artic
     4372                AND  buf_gds-dtl.prod-code = goods.prod-code
     4373                AND  buf_gds-dtl.prod-type = goods.prod-type
     4374                AND  buf_gds-dtl.prt-code = bar-code.node-code NO-ERROR.
     4375           if not avail buf_gds-dtl then NEXT.
     4376           for-price = 0.
     4377           assign
     4378           plcode = ?
     4379           cashplace = no.
     4380           if buf_chk-gds.pump > 0 then do:
     4381             if buf_chk-gds.pl-code <> 0
     4382             and buf_chk-gds.pl-code <> ? then do:
     4383               plcode = buf_chk-gds.pl-code.
     4384             end.
     4385             else do:
     4386               run findtank in this-procedure
     4387                               (input  inkas.obj-type,
     4388                                 input  inkas.obj-code,
     4389                                 input  buf_chk-gds.pump,
     4390                                 input  buf_chk-gds.nozzle-code,
     4391                                 input  buf_chk-gds.pl-code,
     4392                                 input  goods.gds-code,
     4393                                 output plcode         ) no-error.
     4394             end.
     4395             assign
     4396             pumpcode = buf_chk-gds.pump.
     4397             if plcode <> ? then do:
     4398               FIND FIRST ub.doc-pl No-LOCK WHERE
     4399                         ub.doc-pl.gds-code = ub.goods.gds-code
     4400                    AND  ub.doc-pl.out-code = buf_sale-doc.doc-code NO-ERROR.
     4401               IF AVAIL ub.doc-pl
     4402               then
     4403               cashplace = yes .
     4404               else cashplace = no.
     4405             end.
     4406           end.
     4407           else pumpcode = 0.
     4408           if not cashplace then do:
     4409             two-units-parts = no.
     4410             IF lookup('2ед':U, ub.units.type) > 0 then do:
     4411             FIND FIRST ub.doc-prts No-LOCK WHERE
     4412                       ub.doc-prts.gds-code = ub.goods.gds-code
     4413                  AND  ub.doc-prts.out-code = buf_sale-doc.doc-code
     4414                  AND  ub.doc-prts.fact-qnty = abs(buf_chk-gds.doc-qnty) NO-ERROR.
     4415                assign
     4416                two-units-parts = yes.
     4417             end.
     4418             else do:
     4419             FIND FIRST ub.doc-prts No-LOCK WHERE
     4420                       ub.doc-prts.b-code = buf_chk-gds.b-code
     4421                   AND ub.doc-prts.out-code = buf_sale-doc.doc-code NO-ERROR.
     4422             end.
     4423             IF ub.bar-code.in-code <> "" OR AVAIL ub.doc-prts
     4424             then cashparts = yes.
     4425             else cashparts = no.
     4426             release doc-prts.
     4427           end.
     4428           else cashparts = no.
     4429           if NOT two-units-parts then
     4430           find first t-gds WHERE
     4431                     t-gds.doc-code = buf_sale-doc.doc-code
     4432                AND  t-gds.b-code = buf_chk-gds.b-code
     4433                AND  t-gds.artic = ub.goods.artic
     4434                AND  t-gds.prod-type = ub.goods.prod-type
     4435                AND  t-gds.prod-code = ub.goods.prod-code
     4436                AND  t-gds.node-code = ub.bar-code.node-code
     4437                AND  t-gds.pl-code = plcode
     4438                AND  t-gds.pump = pumpcode
     4439                AND  t-gds.fbr-obj-type = buf_chk-gds.depart-type
     4440                AND  t-gds.fbr-obj-code = buf_chk-gds.depart-code NO-ERROR.
     4441           IF NOT AVAIL t-gds oR two-units-parts then do:
     4442             if not prcl-spl then do:
     4443               IF avail buf_gds-dtl
     4444               AND ((p-curr-r-b = 'base':U and buf_gds-dtl.price-base <> buf_chk-gds.price-base )
     4445                   OR
     4446                   (p-curr-r-b = 'rubl':U and buf_gds-dtl.price-rubl <> buf_chk-gds.price-base )
     4447                   )
     4448               then  for-price = (if p-curr-r-b = 'base':U
     4449                                 then buf_gds-dtl.price-base
     4450                                 else buf_gds-dtl.price-rubl)
     4451                                 .
     4452               else do:
     4453                 if cashparts then dO:
     4454                   FOR EACH buf-bar No-LOCK WHERE
     4455                           buf-bar.gds-code = goods.gds-code,
     4456                       EACH for-gds NO-LOCK where
     4457                           for-gds.b-code = buf-bar.b-code AND
     4458                           for-gds.out-code = X_chk-doc.out-code AND
     4459                           NOT for-gds.doc-code = X_chk-doc.doc-code
     4460                           BY for-gds.doc-code DESCENDING:
     4461                     if (buf_chk-gds.price-base + buf_chk-gds.price-service) > 0 AND
     4462                       (for-gds.price-base + for-gds.price-service) = 0 AND
     4463                       can-find(first for2-gds WHERE
     4464                                       for2-gds.b-code = buf_chk-gds.b-code AND
     4465                                       for2-gds.out-code = buf_chk-gds.out-code AND
     4466                                       for2-gds.doc-code <> buf_chk-gds.doc-code AND
     4467                                       for2-gds.doc-code <> for-gds.doc-code)
     4468                     then NEXT.
     4469                     LEAVE.
     4470                   END.
     4471                   if avail for-gds then
     4472                   for-price = for-gds.price-base.
     4473                 end.
     4474                 else do:
     4475                   FOR each for-gds no-lock where
     4476                                   for-gds.out-code = X_chk-doc.out-code and
     4477                                   for-gds.b-code = bar-code.b-code AND
     4478                                   NOT for-gds.doc-code = X_chk-doc.doc-code
     4479                           BY  for-gds.doc-code DESCENDING:
     4480                               if (buf_chk-gds.price-base + buf_chk-gds.price-service) > 0 AND
     4481                                 (for-gds.price-base + for-gds.price-service) = 0 AND
     4482                                 can-find(first for2-gds WHERE
     4483                                                 for2-gds.b-code = buf_chk-gds.b-code AND
     4484                                                 for2-gds.out-code = buf_chk-gds.out-code AND
     4485                                                 for2-gds.doc-code <> buf_chk-gds.doc-code AND
     4486                                                 for2-gds.doc-code <> for-gds.doc-code)
     4487                                 then NEXT.
     4488                     LEAVE.
     4489                   END.
     4490                   if avail for-gds then
     4491                   for-price = for-gds.price-base.
     4492                 end.
     4493               end.
     4494             end.
     4495             if not avail t-gds OR (LOOKUP('2ед':U, units.type) > 0 ) then do:
     4496               create t-gds.
     4497               assign
     4498               t-gds.doc-code = buf_sale-doc.doc-code
     4499               t-gds.b-code = buf_chk-gds.b-code
     4500               t-gds.gds-code = goods.gds-code
     4501               t-gds.artic = goods.artic
     4502               t-gds.prod-type = goods.prod-type
     4503               t-gds.prod-code = goods.prod-code
     4504               t-gds.unit-base = goods.unit-base
     4505               t-gds.cashparts = cashparts
     4506               t-gds.cashplace = cashplace
     4507               t-gds.pl-code  = plcode
     4508               t-gds.density = buf_chk-gds.density
     4509               t-gds.pump = pumpcode
     4510               t-gds.fbr-obj-type = buf_chk-gds.depart-type
     4511               t-gds.fbr-obj-code = buf_chk-gds.depart-code
     4512               t-gds.doc-qnty = 0
     4513               t-gds.price-service = buf_chk-gds.price-service
     4514               t-gds.node-code = bar-code.node-code
     4515               t-gds.new-price = for-price
     4516               t-gds.rdoc-line = recid(buf_doc-line)
     4517               t-gds.rgds-dtl = recid(buf_gds-dtl)
     4518               t-gds.type = units.type
     4519               t-gds.grc = (if LOOKUP('2ед':U, units.type) > 0 then recid(buf_chk-gds) else ?)
     4520               t-gds.marks = ''
     4521               .
     4522             end.
     4523             if t-gds.pump > 0
     4524             and (t-gds.density = ? or t-gds.density = 0) then do:
     4525               message substitute("Чек &1 Бар-код &2 ТРК &3&4Не удается определить плотность топлива в танке&4&5&4Чек не будет закачан в продажу"
     4526                               , X_chk-doc.doc-code
     4527                               , t-gds.b-code
     4528                               , t-gds.pump
     4529                               , chr(10)
     4530                               , return-value
     4531                               )
     4532               view-as alert-box error .
     4533               run waitfram-hide in this-procedure .
     4534               undo, return error.
     4535             end.
     4536           end.
     4537           assign
     4538           t-gds.doc-qnty = t-gds.doc-qnty + buf_chk-gds.doc-qnty
     4539           t-gds.num-lines = t-gds.num-lines + 1
     4540           t-gds.price-base = buf_chk-gds.price-base + buf_chk-gds.price-service
     4541           t-gds.discnt = (if buf_sale-doc.doc-type = 'спи':U then 0 else buf_chk-gds.discnt)
     4542           t-gds.price-sum = t-gds.price-sum + (buf_chk-gds.price-base + buf_chk-gds.price-service ) * buf_chk-gds.doc-qnty
     4543           t-gds.discnt-sum  = t-gds.discnt-sum +
     4544                               (if buf_sale-doc.doc-type = 'спи':U
     4545                               then 0
     4546                               else buf_chk-gds.discnt * buf_chk-gds.doc-qnty)
     4547           t-gds.road-sum = t-gds.road-sum + buf_chk-gds.road-tax * buf_chk-gds.doc-qnty
     4548           .
     4549           run gds-attr-value(
     4550                   t-gds.gds-code,
     4551                   'mark':U,
     4552                   output par-alcohol,
     4553                   output par-type
     4554             ).
     4555           if par-alcohol = "yes" then do :
     4556               find first chk-gds-attr no-lock where chk-gds-attr.doc-code = buf_chk-gds.doc-code
     4557                                                 and chk-gds-attr.line-num = buf_chk-gds.line-num
     4558                                                 and chk-gds-attr.attr-code = "mark-code"
     4559                                                 no-error .
     4560               if available chk-gds-attr
     4561               then do :
     4562                 t-gds.marks = t-gds.marks + (if t-gds.marks = '' then '' else ',') + chk-gds-attr.attr-value .
     4563               end.
     4564               release chk-gds-attr no-error .
     4565           end.
     4566         end.
     4567       end.
     4568       release t-gds.
     4569     END.
     4570     for each tt0-info:
     4571       delete tt0-info.
     4572     end.
     4573     f-del:
     4574     DO on ERROR undo, return error
     4575     on STOP undo, return error :
     4576       if docs-to-reserv > 0 then do:
     4577         run waitfram-show in this-procedure ( substitute("Снимаю резервы со всех товаров чека &1...", X_chk-doc.doc-code)).
     4578       _main:
     4579         FOR EACH t-gds NO-LOCK,
     4580             first buf_sale-doc where
     4581                  buf_sale-doc.inkas-code = inkas.inkas-code
     4582              and buf_sale-doc.doc-code = t-gds.doc-code,
     4583             first buf_trn-doc where
     4584                  buf_trn-doc.doc-code = buf_sale-doc.doc-code
     4585       on ERROR undo f-del, return error
     4586       on STOP undo f-del, return error :
     4587           if t-gds.doc-qnty = 0 then nEXt.
     4588           assign
     4589           buf_sale-doc.gds-amount = buf_sale-doc.gds-amount - t-gds.num-lines.
     4590           assign
     4591           r-artic =      "":U
     4592           r-prod-type = "":U
     4593           r-prod-code = 0
     4594           r-prt-code = 0
     4595           rdoc-line = t-gds.rdoc-line
     4596           rgds-dtl = t-gds.rgds-dtl
     4597           r-b-code =  ?
     4598           r-doc-prts-qnty = ?
     4599           r-or-v = buf_sale-doc.doc-kind
     4600           cashparts = t-gds.cashparts
     4601           r-qnty = ?
     4602           cashplace = t-gds.cashplace
     4603           r-pl-code = t-gds.pl-code
     4604           .
     4605           FIND FIRST buf_doc-line WHERE recid(buf_doc-line) = t-gds.rdoc-line No-ERROR.
     4606           run gds-attr-value(
     4607                   t-gds.gds-code,
     4608                   'mark':U,
     4609                   output par-alcohol,
     4610                   output par-type
     4611               ).
     4612           if t-gds.marks <> '' and par-alcohol = "yes"
     4613           then do :
     4614               find first doc-line-attr exclusive-lock where doc-line-attr.doc-code = buf_doc-line.doc-code
     4615                                                         and doc-line-attr.gds-code = t-gds.gds-code
     4616                                                         and doc-line-attr.attr-code = 'mark-code'
     4617                                                         no-error.
     4618               if available doc-line-attr
     4619               then do :
     4620                 do mark-ii = 1 to num-entries(doc-line-attr.attr-value) :
     4621                   v-mark = entry(mark-ii, doc-line-attr.attr-value) .
     4622                   if not can-do(t-gds.marks, v-mark)
     4623                   then v-mark-list = v-mark-list + (if v-mark-list = '' then '' else ',') + v-mark .
     4624                 end.
     4625                 doc-line-attr.attr-value = v-mark-list .
     4626               end.
     4627           end.
     4628           run  RSRV-line in this-procedure (
     4629                          input buf_sale-doc.dir
     4630                         ,input no
     4631                         ,input no
     4632                         ,input no
     4633                         ,input v-is-tpsi-obj
     4634                         ,input no
     4635                         ,input no
     4636                         ,input t-gds.gds-code
     4637                         ,input t-gds.node-code
     4638                         ,output v-run-tpsi
     4639                         ,buffer buf_doc-line
     4640                         ,buffer buf_trn-doc
     4641                         ,buffer buf_sale-doc
     4642                         ) no-error.
     4643           if error-status:error then do:
     4644             run waitfram-hide in this-procedure .
     4645             undo f-del, return error substitute("Ошибка при снятии резервов товаров чека &1:&2&3 &4"
     4646                                       , X_chk-doc.doc-code
     4647                                       , chr(10)
     4648                                       , error-status:get-message(1)
     4649                                       , return-value ).
     4650           end.
     4651           if v-is-tpsi-obj
     4652           and v-run-tpsi
     4653           and buf_sale-doc.doc-kind = 'es':U
     4654           then do:
     4655             run str/tpsirsrv.p (
     4656                              input parparentproc
     4657                             ,input this-procedure
     4658                             ,input ?
     4659                             ,input 0
     4660                             ,input v-curr-r-b
     4661                             ,input inkas.inkas-code
     4662                             ,input inkas.host-code
     4663                             ,input inkas.obj-type
     4664                             ,input inkas.obj-code
     4665                             ,input r-artic
     4666                             ,input r-prod-type
     4667                             ,input r-prod-code
     4668                             ,input r-prt-code
     4669                             ,input no
     4670                             ,input "Снятие резеров ЧУЖИХ товаров. Расход. Строк "
     4671                             ,input-output num_rec_res
     4672                             ,output num_rec_other
     4673                             ,output num_rec_other_res
     4674                             ,buffer buf_trn-doc
     4675                           ) no-error .
     4676             if error-status:error then do:
     4677               return error substitute("Ошибка при снятии резервов ЧУЖИХ товаров:&1&2 &3"
     4678                                       , chr(10)
     4679                                       , error-status:get-message(1)
     4680                                       , return-value ).
     4681             end.
     4682             assign
     4683             num_resv = num_resv + num_rec
     4684             num_resv_res = num_resv_res + num_rec_res
     4685             num_rec = 0
     4686             num_rec_res = 0
     4687             .
     4688           end.
     4689         END.
     4690         if num_resv > num_resv_res then do:
     4691           run waitfram-hide in this-procedure .
     4692           undo f-del, return error.
     4693         end.
     4694         run waitfram-show in this-procedure ( substitute("Пересчитываю выручку после исключения чека &1...", X_chk-doc.doc-code)).
     4695         var-doc-type = (if X_chk-doc.netto >= 0 then 'при':U else 'рас':U).
     4696         FOR  EACH buf_chk-pay WHERE
     4697                   buf_chk-pay.doc-code = X_chk-doc.doc-code
     4698         BREAK
     4699         BY buf_chk-pay.doc-code
     4700         BY buf_chk-pay.pay-code
     4701         BY buf_chk-pay.curr-code :
     4702           ACCUMULATE
     4703           buf_chk-pay.tot-sum ( SUB-TOTAL BY buf_chk-pay.curr-code )
     4704           buf_chk-pay.tot-base ( SUB-TOTAL BY buf_chk-pay.curr-code )
     4705           buf_chk-pay.tot-rubl ( SUB-TOTAL BY buf_chk-pay.curr-code )
     4706           .
     4707           find first buf_inkas-pay-wth where
     4708                     buf_inkas-pay-wth.inkas-code = X_chk-doc.out-code
     4709                 and buf_inkas-pay-wth.pay-code = buf_chk-pay.pay-code
     4710                 and buf_inkas-pay-wth.curr-code = buf_chk-pay.curr-code
     4711                 and buf_inkas-pay-wth.wth-code = buf_chk-pay.wth-code
     4712                 and buf_inkas-pay-wth.par-code = buf_chk-pay.par-code
     4713                 and buf_inkas-pay-wth.pay-desk = X_chk-doc.pay-desk
     4714                 and buf_inkas-pay-wth.cashier = X_chk-doc.cashier
     4715                 and buf_inkas-pay-wth.chk-type = X_chk-doc.chk-type no-error.
     4716           if not available  buf_inkas-pay-wth then do:
     4717             create buf_inkas-pay-wth.
     4718             assign
     4719             buf_inkas-pay-wth.inkas-code = X_chk-doc.out-code
     4720             buf_inkas-pay-wth.pay-code = buf_chk-pay.pay-code
     4721             buf_inkas-pay-wth.curr-code = buf_chk-pay.curr-code
     4722             buf_inkas-pay-wth.wth-code = buf_chk-pay.wth-code
     4723             buf_inkas-pay-wth.par-code = buf_chk-pay.par-code
     4724             buf_inkas-pay-wth.pay-desk = X_chk-doc.pay-desk
     4725             buf_inkas-pay-wth.cashier = X_chk-doc.cashier
     4726             buf_inkas-pay-wth.chk-type = X_chk-doc.chk-type
     4727             buf_inkas-pay-wth.par-val = buf_chk-pay.par-val
     4728             .
     4729           end.
     4730           assign
     4731           buf_inkas-pay-wth.tot-sum = buf_inkas-pay-wth.tot-sum - buf_chk-pay.tot-sum
     4732           buf_inkas-pay-wth.tot-base = buf_inkas-pay-wth.tot-base - buf_chk-pay.tot-base
     4733           buf_inkas-pay-wth.tot-rubl = buf_inkas-pay-wth.tot-rubl - buf_chk-pay.tot-rubl
     4734           buf_inkas-pay-wth.doc-qnty = buf_inkas-pay-wth.doc-qnty - buf_chk-pay.doc-qnty
     4735           buf_inkas-pay-wth.tot-lines = buf_inkas-pay-wth.tot-lines - 1
     4736           .
     4737           if buf_inkas-pay-wth.tot-sum = 0 then delete buf_inkas-pay-wth.
     4738           if last-of( buf_chk-pay.curr-code ) then  do:
     4739             FIND buf_inkas-pay WHERE
     4740                 buf_inkas-pay.inkas-code = X_chk-doc.out-code AND
     4741                 buf_inkas-pay.pay-code = buf_chk-pay.pay-code AND
     4742                 buf_inkas-pay.curr-code = buf_chk-pay.curr-code NO-ERROR.
     4743             if NOT available buf_inkas-pay then do:
     4744               CREATE buf_inkas-pay.
     4745               assign
     4746               buf_inkas-pay.inkas-code = X_chk-doc.out-code
     4747               buf_inkas-pay.pay-code = buf_chk-pay.pay-code
     4748               buf_inkas-pay.curr-code = buf_chk-pay.curr-code
     4749               buf_inkas-pay.tot-sum = 0
     4750               buf_inkas-pay.tot-base = 0
     4751               buf_inkas-pay.tot-rubl = 0
     4752               .
     4753             end.
     4754             var-doc-type = (if X_chk-doc.netto >= 0 then 'при':U else 'рас':U).
     4755             FIND FIRST buf_inkas-pay-desk WHERE
     4756                       buf_inkas-pay-desk.inkas-code = X_chk-doc.out-code AND
     4757                       buf_inkas-pay-desk.pay-code = buf_chk-pay.pay-code AND
     4758                       buf_inkas-pay-desk.curr-code = buf_chk-pay.curr-code AND
     4759                       buf_inkas-pay-desk.pay-desk = X_chk-doc.pay-desk AND
     4760                       buf_inkas-pay-desk.doc-type = var-doc-type AND
     4761                       buf_inkas-pay-desk.cashier = X_chk-doc.cashier
     4762                       NO-ERROR.
     4763             if NOT available buf_inkas-pay then do:
     4764               CREATE buf_inkas-pay.
     4765               assign
     4766               buf_inkas-pay.inkas-code = X_chk-doc.out-code
     4767               buf_inkas-pay.pay-code = buf_chk-pay.pay-code
     4768               buf_inkas-pay.curr-code = buf_chk-pay.curr-code
     4769               buf_inkas-pay.tot-sum = 0
     4770               buf_inkas-pay.tot-base = 0
     4771               buf_inkas-pay.tot-rubl = 0
     4772               .
     4773             end.
     4774             if NOT available buf_inkas-pay-desk then do:
     4775               CREATE buf_inkas-pay-desk.
     4776               assign
     4777               buf_inkas-pay-desk.inkas-code = X_chk-doc.out-code
     4778               buf_inkas-pay-desk.pay-code = buf_chk-pay.pay-code
     4779               buf_inkas-pay-desk.curr-code = buf_chk-pay.curr-code
     4780               buf_inkas-pay-desk.pay-desk = X_chk-doc.pay-desk
     4781               buf_inkas-pay-desk.cashier = X_chk-doc.cashier
     4782               buf_inkas-pay-desk.tot-sum = 0
     4783               buf_inkas-pay-desk.tot-base = 0
     4784               buf_inkas-pay-desk.tot-rubl = 0
     4785               buf_inkas-pay-desk.doc-type = var-doc-type
     4786               .
     4787             end.
     4788             assign
     4789                 buf_inkas-pay.tot-sum = buf_inkas-pay.tot-sum -
     4790                     ( ACCUM SUB-TOTAL BY buf_chk-pay.curr-code buf_chk-pay.tot-sum )
     4791                 buf_inkas-pay.tot-base = buf_inkas-pay.tot-base -
     4792                     ( ACCUM SUB-TOTAL BY buf_chk-pay.curr-code buf_chk-pay.tot-base )
     4793                 buf_inkas-pay.tot-rubl = buf_inkas-pay.tot-rubl -
     4794                     ( ACCUM SUB-TOTAL BY buf_chk-pay.curr-code buf_chk-pay.tot-rubl )
     4795                 buf_inkas-pay-desk.tot-sum = buf_inkas-pay-desk.tot-sum -
     4796                     ( ACCUM SUB-TOTAL BY buf_chk-pay.curr-code buf_chk-pay.tot-sum )
     4797                 buf_inkas-pay-desk.tot-base = buf_inkas-pay-desk.tot-base -
     4798                     ( ACCUM SUB-TOTAL BY buf_chk-pay.curr-code buf_chk-pay.tot-base )
     4799                 buf_inkas-pay-desk.tot-rubl = buf_inkas-pay-desk.tot-rubl -
     4800                     ( ACCUM SUB-TOTAL BY buf_chk-pay.curr-code buf_chk-pay.tot-rubl ) .
     4801             if buf_inkas-pay.tot-sum = 0 then delete buf_inkas-pay.
     4802             if buf_inkas-pay-desk.tot-sum = 0 then delete buf_inkas-pay-desk.
     4803           end.
     4804         buf_chk-pay.out-code = ? .
     4805       END.
     4806       run waitfram-show in this-procedure ( substitute("Пересчитываю строки накладных после исключения чека &1...", X_chk-doc.doc-code)).
     4807       FOR EACH t-gds ,
     4808           first buf_sale-doc where
     4809                 buf_sale-doc.inkas-code = inkas.inkas-code
     4810             and buf_sale-doc.doc-code = t-gds.doc-code,
     4811           FIRST buf_doc-line WHERE
     4812               buf_doc-line.doc-code = t-gds.doc-code
     4813           AND buf_doc-line.artic = t-gds.artic
     4814           AND buf_doc-line.prod-code = t-gds.prod-code
     4815           AND buf_doc-line.prod-type = t-gds.prod-type
     4816       break
     4817       by t-gds.doc-code
     4818       by t-gds.gds-code
     4819       by t-gds.node-code
     4820       by t-gds.b-code
     4821       by t-gds.pl-code
     4822       by t-gds.pump
     4823       by t-gds.fbr-obj-type
     4824       by t-gds.fbr-obj-code
     4825       on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4826       :
     4827         if t-gds.cashplace then do:
     4828           FIND FIRST ub.doc-pl WHERE
     4829                     ub.doc-pl.pl-code = t-gds.pl-code
     4830                 AND ub.doc-pl.gds-code = t-gds.gds-code
     4831                 AND ub.doc-pl.out-code = buf_sale-doc.doc-code NO-ERROR.
     4832           IF avail ub.doc-pl
     4833           then do:
     4834             assign
     4835             ub.doc-pl.fact-qnty = ub.doc-pl.fact-qnty - abs(t-gds.doc-qnty)
     4836             ub.doc-pl.cli-fact-qnty = ub.doc-pl.cli-fact-qnty - t-gds.density * abs(t-gds.doc-qnty)
     4837             .
     4838             if ub.doc-pl.fact-qnty = 0 then delete doc-pl.
     4839             find first ub.doc-pl-pump where
     4840                       ub.doc-pl-pump.pl-code = ub.doc-pl.pl-code
     4841                   AND ub.doc-pl-pump.gds-code = ub.doc-pl.gds-code
     4842                   AND ub.doc-pl-pump.pump-code = t-gds.pump
     4843                   AND ub.doc-pl-pump.out-code = buf_sale-doc.doc-code No-ERROR.
     4844             IF avail ub.doc-pl-pump then do:
     4845                 ub.doc-pl-pump.fact-qnty = ub.doc-pl-pump.fact-qnty - abs(t-gds.doc-qnty).
     4846                 if ub.doc-pl-pump.fact-qnty = 0 then delete ub.doc-pl-pump.
     4847             end.
     4848           end.
     4849         end.
     4850         else do:
     4851           if t-gds.cashparts then do:
     4852             IF LOOKUP('2ед':U, t-gds.type) > 0 then
     4853             FIND FIRST ub.doc-prts WHERE
     4854                         ub.doc-prts.gds-code = t-gds.gds-code
     4855                    AND  ub.doc-prts.out-code = buf_sale-doc.doc-code
     4856                    AND  ub.doc-prts.fact-qnty = abs(t-gds.doc-qnty) NO-ERROR.
     4857             else
     4858             FIND FIRST ub.doc-prts WHERE
     4859                        ub.doc-prts.b-code = t-gds.b-code
     4860                    AND ub.doc-prts.out-code = buf_sale-doc.doc-code NO-ERROR.
     4861           END.
     4862           IF avail ub.doc-prts
     4863           then do:
     4864             ub.doc-prts.fact-qnty = ub.doc-prts.fact-qnty - abs(t-gds.doc-qnty).
     4865             if ub.doc-prts.fact-qnty = 0 then delete doc-prts.
     4866           end.
     4867         end.
     4868         if NOT (t-gds.fbr-obj-type = "":U
     4869                       and
     4870                       t-gds.fbr-obj-code = 0) then do:
     4871           find first ub.doc-fbr-gds where
     4872                     ub.doc-fbr-gds.fbr-obj-type = t-gds.fbr-obj-type
     4873                 AND ub.doc-fbr-gds.fbr-obj-code= t-gds.fbr-obj-code
     4874                 AND ub.doc-fbr-gds.gds-code = t-gds.gds-code
     4875                 AND ub.doc-fbr-gds.out-code = (if buf_sale-doc.doc-kind = 'rs':U then replace(buf_sale-doc.doc-code, "=", "-") else buf_sale-doc.doc-code) NO-ERROR.
     4876           IF avail ub.doc-fbr-gds then do:
     4877             ub.doc-fbr-gds.fact-qnty = ub.doc-fbr-gds.fact-qnty - t-gds.doc-qnty.
     4878             if ub.doc-fbr-gds.fact-qnty = 0 then delete ub.doc-fbr-gds.
     4879           end.
     4880         end.
     4881         FIND FIRST buf_gds-dtl WHERE
     4882                     buf_gds-dtl.doc-code = t-gds.doc-code AND
     4883                     buf_gds-dtl.artic = t-gds.artic AND
     4884                     buf_gds-dtl.prod-code = t-gds.prod-code AND
     4885                     buf_gds-dtl.prod-type = t-gds.prod-type AND
     4886                     buf_gds-dtl.prt-code = t-gds.node-code NO-ERROR.
     4887         if t-gds.pump > 0 then do:
     4888           define variable v-qnty as decimal no-undo .
     4889           define variable v-cli-qnty as decimal no-undo .
     4890           if available doc-pl then release doc-pl.
     4891           assign
     4892           v-qnty     = 0.0
     4893           v-cli-qnty = 0.0
     4894           .
     4895           for each ub.doc-pl no-lock where
     4896                   ub.doc-pl.out-code = t-gds.doc-code
     4897               and ub.doc-pl.gds-code = t-gds.gds-code:
     4898             assign
     4899             v-qnty     = v-qnty + ub.doc-pl.fact-qnty
     4900             v-cli-qnty = v-cli-qnty + ub.doc-pl.cli-fact-qnty
     4901             .
     4902           end.
     4903           assign
     4904           buf_doc-line.fact-density = v-cli-qnty / v-qnty
     4905           buf_doc-line.doc-density = buf_doc-line.fact-density
     4906           .
     4907         end.
     4908         assign
     4909         buf_doc-line.fact-qnty = buf_doc-line.fact-qnty - abs( t-gds.doc-qnty )
     4910         buf_sale-doc.fact-qnty = buf_sale-doc.fact-qnty  -  abs( t-gds.doc-qnty )
     4911         v-real-qnty = v-real-qnty +
     4912                       (if buf_sale-doc.in-inkas
     4913                       then abs( t-gds.doc-qnty ) *
     4914                       (if lookup(buf_sale-doc.ext-doc-type, 'vt,vp,rs':U) > 0 then - 1 else 1)
     4915                       else 0)
     4916         temp-qnty = buf_gds-dtl.fact-qnty - abs( t-gds.doc-qnty )
     4917         .
     4918         if temp-qnty = 0 then do:
     4919           deleted-g = yes.
     4920           if buf_doc-line.fact-qnty = 0 then deleted-d = yes.
     4921           else deleted-d = no.
     4922         end.
     4923         else assign
     4924         deleted-d = no
     4925         deleted-g = no.
     4926         if prcl-spl then do:
     4927           if available buf_gds-dtl then do:
     4928           for-price = (if p-curr-r-b = 'base':U
     4929                       then buf_gds-dtl.price-base
     4930                       else buf_gds-dtl.price-rubl)
     4931                       .
     4932         end.
     4933         else do:
     4934             for-price = 0.
     4935           end.
     4936         end.
     4937         else do:
     4938           assign
     4939           for-price = t-gds.new-price
     4940           .
     4941         end.
     4942         if not deleted-g then do:
     4943           assign
     4944           v-discnt-r-b =
     4945           (
     4946           for-price *( buf_gds-dtl.fact-qnty -  abs(t-gds.doc-qnty) )
     4947           -
     4948           ((if p-curr-r-b = 'base':U then buf_gds-dtl.price-base else buf_gds-dtl.price-rubl) - (if p-curr-r-b = 'base':U then buf_gds-dtl.discnt-base else buf_gds-dtl.discnt-rubl)) * buf_gds-dtl.fact-qnty
     4949           +
     4950           abs(t-gds.price-sum - t-gds.discnt-sum)
     4951           ) / ( buf_gds-dtl.fact-qnty -  abs(t-gds.doc-qnty ))
     4952           v-price-r-b = for-price
     4953           buf_gds-dtl.fact-qnty = buf_gds-dtl.fact-qnty - abs( t-gds.doc-qnty )
     4954           buf_gds-dtl.price-base = if p-curr-r-b = 'rubl':U
     4955                                 then  v-price-r-b / v-base-rate * v-base-scale
     4956                                 else v-price-r-b
     4957           buf_gds-dtl.discnt-base = if p-curr-r-b = 'rubl':U
     4958                                 then v-discnt-r-b / v-base-rate * v-base-scale
     4959                                 else v-discnt-r-b
     4960           buf_gds-dtl.price-rubl = if p-curr-r-b = 'base':U
     4961                                 then v-price-r-b * v-base-rate / v-base-scale
     4962                                 else v-price-r-b
     4963           buf_gds-dtl.discnt-rubl = if p-curr-r-b = 'base':U
     4964                                 then v-discnt-r-b * v-base-rate / v-base-scale
     4965                                 else v-discnt-r-b
     4966           buf_doc-line.road-tax = (if buf_doc-line.road-tax > 0 then
     4967                                           (buf_doc-line.road-tax * (buf_doc-line.fact-qnty + abs(t-gds.doc-qnty) ) -
     4968                                           abs(t-gds.road-sum )
     4969                                           ) / (buf_doc-line.fact-qnty )
     4970                                                   else 0)
     4971           .
     4972         end.
     4973         if last-of(t-gds.node-code) then do:
     4974           if deleted-g then do:
     4975             if available buf_gds-dtl then do:
     4976             delete buf_gds-dtl no-error.
     4977             if error-status:error then undo f-del, return error.
     4978             buf_sale-doc.tot-dtl = buf_sale-doc.tot-dtl - 1.
     4979           end.
     4980           end.
     4981         end.
     4982         if last-of(t-gds.gds-code) then do:
     4983           if deleted-d then do:
     4984             delete buf_doc-line no-error.
     4985             if error-status:error then undo f-del, return error.
     4986             buf_sale-doc.tot-lines = buf_sale-doc.tot-lines - 1.
     4987           end.
     4988         end.
     4989       END.
     4990     end.
     4991     else do:
     4992       FOR  EACH buf_chk-pay WHERE
     4993                 buf_chk-pay.doc-code = X_chk-doc.doc-code:
     4994         buf_chk-pay.out-code = ? .
     4995       end.
     4996     end.
     4997     run waitfram-show in this-procedure ( substitute("Освобождаю чек &1...", X_chk-doc.doc-code)).
     4998     FOR EACH buf_chk-gds where buf_chk-gds.doc-code = X_chk-doc.doc-code
     4999     on error undo, return error error-status:get-message(1)
     5000     :
     5001         assign
     5002         buf_chk-gds.out-code = ?
     5003         buf_chk-gds.line-type = entry(1, buf_chk-gds.line-type, chr(4))
     5004        .
     5005     END.
     5006     FOR EACH buf_chk-discnt where buf_chk-discnt.doc-code = X_chk-doc.doc-code
     5007     on error undo, return error error-status:get-message(1)
     5008     :
     5009         buf_chk-discnt.out-code = ?.
     5010     END.
     5011     FOR EACH buf_chk-doc-attr where buf_chk-doc-attr.doc-code = X_chk-doc.doc-code
     5012     on error undo, return error error-status:get-message(1)
     5013     :
     5014         buf_chk-doc-attr.out-code = ?.
     5015     END.
     5016     FOR EACH buf_chk-gds-pay where buf_chk-gds-pay.doc-code = X_chk-doc.doc-code
     5017     on error undo, return error error-status:get-message(1)
     5018     :
     5019        delete buf_chk-gds-pay.
     5020     END.
     5021     for each buf_c-chk-doc where
     5022             buf_c-chk-doc.doc-code = X_chk-doc.doc-code
     5023      on error undo, return error error-status:get-message(1) :
     5024       assign
     5025       buf_c-chk-doc.out-code = ?
     5026       .
     5027     end.
     5028     for each buf_c-chk-gds where
     5029             buf_c-chk-gds.doc-code = X_chk-doc.doc-code
     5030     on error undo, return error error-status:get-message(1) :
     5031       assign
     5032       buf_c-chk-gds.out-code = ?
     5033       .
     5034     end.
     5035     for each buf_c-chk-discnt where
     5036             buf_c-chk-discnt.doc-code = X_chk-doc.doc-code
     5037      on error undo, return error error-status:get-message(1) :
     5038       assign
     5039       buf_c-chk-discnt.out-code = ?
     5040       .
     5041     end.
     5042     for each buf_c-chk-pay where
     5043             buf_c-chk-pay.doc-code = X_chk-doc.doc-code
     5044      on error undo, return error error-status:get-message(1)
     5045             :
     5046       assign
     5047       buf_c-chk-pay.out-code = ?
     5048       .
     5049     end.
     5050     for each buf_c-chk-doc-attr where
     5051             buf_c-chk-doc-attr.doc-code = X_chk-doc.doc-code
     5052     on error undo, return error error-status:get-message(1)
     5053             :
     5054       assign
     5055       buf_c-chk-doc-attr.out-code = ?
     5056       .
     5057     end.
     5058     run waitfram-show in this-procedure ( substitute("Пересчитываю общие суммы по накладным после исключения чека &1...", X_chk-doc.doc-code)).
     5059     assign
     5060     inkas.tot-doc = inkas.tot-doc - (if docs-to-reserv > 0 then X_chk-doc.tot-doc else 0)
     5061     inkas.discnt = inkas.discnt  -  (if docs-to-reserv > 0 then  X_chk-doc.discnt else 0)
     5062     inkas.netto = inkas.netto -  (if docs-to-reserv > 0 then X_chk-doc.netto else 0)
     5063     inkas.sub-discnt = inkas.sub-discnt -  X_chk-doc.sub-discnt
     5064     inkas.num-chk = inkas.num-chk  - 1
     5065     inkas.num-chk-nf = inkas.num-chk-nf - (if docs-to-reserv > 0 then 0 else 1)
     5066     inkas.qnty = inkas.qnty -  v-real-qnty
     5067     chk-amount = chk-amount - 1
     5068     nf-chk-amount = nf-chk-amount - add-nf-amount
     5069     .
     5070     assign
     5071     dtl-out = 0
     5072     line-out = 0
     5073     dtl-ret = 0
     5074     line-ret = 0
     5075     .
     5076     for each buf_sale-doc where
     5077             buf_sale-doc.inkas-code = inkas.inkas-code,
     5078         first dop_trn-doc where dop_trn-doc.doc-code = buf_sale-doc.doc-code
     5079     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     5080       if buf_sale-doc.doc-kind = 'es':U then do:
     5081         assign
     5082         dtl-out = dtl-out + buf_sale-doc.tot-dtl
     5083         line-out = line-out + buf_sale-doc.tot-lines
     5084         .
     5085       end.
     5086       if buf_sale-doc.doc-kind = 'rs':U then do:
     5087         assign
     5088         dtl-ret = dtl-ret + buf_sale-doc.tot-dtl
     5089         line-ret = line-ret + buf_sale-doc.tot-lines
     5090         .
     5091       end.
     5092       assign
     5093       dop_trn-doc.fact-qnty = buf_sale-doc.fact-qnty
     5094       dop_trn-doc.tot-lines = buf_sale-doc.tot-lines
     5095       buf_sale-doc.filled = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0
     5096       .
     5097       dop_trn-doc.ps = set-sale-doc-ps(buffer buf_sale-doc)
     5098       .
     5099       if not buf_sale-doc.filled
     5100       and buf_sale-doc.doc-kind <> 'es':U then do:
     5101         if buf_sale-doc.doc-kind = 'rs':U then do:
     5102           assign
     5103           buf0_trn-doc.out-code = '':U.
     5104         end.
     5105         delete dop_trn-doc.
     5106         delete buf_sale-doc.
     5107       end.
     5108     end.
     5109     assign
     5110     inkas.PS = set-inkas-ps(input inkas.ps
     5111                           , input chk-amount
     5112                           , input gds-amount
     5113                           , input line-out
     5114                           , input dtl-out
     5115                           , input line-ret
     5116                           , input dtl-ret
     5117                           , input nf-chk-amount
     5118                           , input nf-gds-amount
     5119                           , input p-filter-rus
     5120                           )
     5121     inkas.num-chk-nff = nff-chk-amount
     5122     .
     5123     X_chk-doc.out-code = ? .
     5124     run waitfram-hide in this-procedure .
     5125   END.
     5126   end.
