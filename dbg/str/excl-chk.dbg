     3597         end.
     3598         else do:
     3599           ASSIGN
     3600             road-tax-rubl-loc = b-doc-line.road-tax
     3601             road-tax-base-loc = b-doc-line.road-tax / b-trn-doc.base-rate * b-trn-doc.base-scale.
     3602         end.
     3603         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     3604         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     3605         assign
