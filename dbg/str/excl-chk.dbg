      284   FIELD fbr-obj-type like ub.clients.obj-type
      285   FIELD fbr-obj-code like ub.clients.obj-code
      286   FIELD type like ub.units.type
      287   FIELD grc as recid
      288   FIELD is-modificator as logical
      289   FIELD is-null-price as logical
      290   FIELD doc-code like ub.trn-doc.doc-code
