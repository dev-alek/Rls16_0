     3391                                         in-vatp-parts.obj-code  = b-doc-line.obj-code  and
     3392                                         in-vatp-parts.artic     = b-doc-line.artic     and
     3393                                         in-vatp-parts.prod-type = b-doc-line.prod-type and
     3394                                         in-vatp-parts.prod-code = b-doc-line.prod-code
     3395                            use-index out-code no-lock:
     3396             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     3397                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     3398                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     3399                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     3400                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     3401                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
