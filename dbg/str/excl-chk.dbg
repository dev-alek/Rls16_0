     2680   function cross-list returns logical (
     2681     input parfirst-stream  as character,
     2682     input parsecond-stream as character,
     2683     input pardelim         as character).
     2684     if pardelim = ""
     2685     or pardelim = ?
     2686     then do:
     2687       assign
     2688         pardelim = ","
     2689       .
     2690     end.
     2691     define variable vari            as integer no-undo .
     2692     define variable varresult-cross as logical no-undo .
     2693     assign
     2694       varresult-cross = no
     2695     .
     2696     def var v-num-parfirst-stream as integer no-undo .
     2697     assign
     2698       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
     2699     .
     2700     do vari = 1 to v-num-parfirst-stream
     2701     :
     2702       if lookup(entry(vari, parfirst-stream, pardelim)
     2703                ,parsecond-stream
     2704                ,pardelim
     2705                ) > 0 then do:
     2706         assign
     2707           varresult-cross = yes
     2708         .
     2709         leave.
     2710       end.
     2711     end.
     2712     return varresult-cross .
     2713   end function.
     2714   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2715   function octal-to-char return character
     2716   ( p-string as character ) :
     2717     def var v-asc     as integer no-undo .
     2718     def var v-new-asc as integer no-undo .
     2719     def var ind       as integer no-undo .
     2720     if length(p-string) <> 3 then do:
     2721       return ? .
     2722     end.
     2723     assign
     2724       v-asc = 0
     2725     .
     2726     do ind = 1 to length(p-string)
     2727     :
     2728       assign
     2729         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     2730       .
     2731       if v-new-asc < 0 or v-new-asc >= 8 then do:
     2732         return ? .
     2733       end.
     2734       assign
     2735         v-asc = v-asc * 8 + v-new-asc
     2736       .
     2737     end.
     2738     return chr(v-asc) .
     2739   end function .
     2740   function char-to-octal return character
     2741   ( p-chr as character ) :
     2742     def var v-asc    as integer   no-undo .
     2743     def var ind      as integer   no-undo .
     2744     def var v-string as character no-undo .
     2745     if length(p-chr) <> 1 then do:
     2746       return ? .
     2747     end.
     2748     assign
     2749       v-asc    = asc(p-chr)
     2750       v-string = ""
     2751     .
     2752     do ind = 1 to 3
     2753     :
     2754       assign
     2755         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     2756       .
     2757       assign
     2758         v-asc = truncate(v-asc / 8, 0)
     2759       .
     2760     end.
     2761     return v-string .
     2762   end.
     2763   function str-encode return character
     2764   (   p-init-string       as character
     2765     , p-encode-char       as character
     2766     , p-special-char-list as character
     2767   ) :
     2768     def var p-encode-string as character no-undo .
     2769     def var ind                as integer no-undo .
     2770     def var v-num-special-char as integer no-undo .
     2771     def var v-special-char     as character no-undo .
     2772     if p-encode-char = ?
     2773     or p-encode-char = "" then do:
     2774       assign
     2775         p-encode-char = "~~"
     2776       .
     2777     end.
     2778     if p-init-string = ? then do:
     2779       return "?" .
     2780     end.
     2781     if p-init-string = "?" then do:
     2782       return p-encode-char + char-to-octal("?") .
     2783     end.
     2784     assign
     2785       v-num-special-char = length(p-special-char-list)
     2786       p-encode-string    = replace(p-init-string
     2787                                   ,p-encode-char
     2788                                   ,p-encode-char + char-to-octal(p-encode-char)
     2789                                   )
     2790     .
     2791     do ind = 1 to v-num-special-char
     2792     :
     2793       assign
     2794         v-special-char = substring(p-special-char-list, ind, 1)
     2795       .
     2796       if v-special-char <> p-encode-char then do:
     2797         assign
     2798           p-encode-string = replace (p-encode-string
     2799                                     ,v-special-char
     2800                                     ,p-encode-char + char-to-octal(v-special-char)
     2801                                     )
     2802         .
     2803       end.
     2804     end.
     2805     return p-encode-string .
     2806   end.
     2807   function str-decode returns character
     2808     (p-init-string   as character
     2809     ,p-encode-char   as character
     2810     ) :
     2811     def var p-decode-string as character no-undo .
     2812     def var ind                       as integer no-undo .
     2813     def var v-num-entries-init-string as integer no-undo .
     2814     def var v-sub-phrase              as character no-undo .
     2815     def var v-special-char            as character no-undo .
     2816     if p-encode-char = ?
     2817     or p-encode-char = "" then do:
     2818       assign
     2819         p-encode-char = "~~"
     2820       .
     2821     end.
     2822     if p-init-string = "?" then do:
     2823       return ? .
     2824     end.
     2825     assign
     2826       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     2827     .
     2828     if v-num-entries-init-string > 1 then do:
     2829       assign
     2830         p-decode-string = entry(1, p-init-string, p-encode-char)
     2831       .
     2832       do ind = 2 to v-num-entries-init-string
     2833       :
     2834         assign
     2835           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     2836         .
     2837         assign
     2838           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     2839         .
     2840         if v-special-char <> ? then do:
     2841           assign
     2842             p-decode-string = p-decode-string
     2843                             + v-special-char
     2844                             + substring(v-sub-phrase, 4)
     2845           .
     2846         end.
     2847         else do:
     2848           assign
     2849             p-decode-string = p-decode-string
     2850                             + p-encode-char
     2851                             + v-sub-phrase
     2852           .
     2853         end.
     2854       end.
     2855     end.
     2856     else do:
     2857       assign
     2858         p-decode-string = p-init-string
     2859       .
     2860     end.
     2861     return p-decode-string .
     2862   end.
     2863   function is-gas returns logical
     2864           (input p-gds-code as integer):
