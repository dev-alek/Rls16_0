      476         where buf_BatchProcess.bp_type       = 'fgrp':U
      477           and buf_BatchProcess.bp_status     = 'N':U
      478           use-INDEX XPKN477 no-error .
      479   if avail buf_BatchProcess then do:
      480           find first buf_user-login where buf_user-login.user-id = buf_BatchProcess.User_ID no-error.
      481     assign
      482     v-fgrp-note = "Самое старое задание на пересылку информации о группе блюд на кассу" + chr(10) +
      483                  "от" + chr(32) +
      484                  string(buf_BatchProcess.BP_SysDate, "99/99/9999":U) + chr(32) +
      485                  buf_BatchProcess.BP_SysTime  + chr(10) +
      486                  "Пользователь" + chr(32) +
