      496   assign
      497   v-notes = v-gds-note
      498   v-notes = (if v-notes = "":U then "":U else (v-notes + chr(10) + chr(10))) + v-dcard-note
      499   v-notes = (if v-notes = "":U then "":U else (v-notes + chr(10) + chr(10))) + v-seller-note
      500   v-notes = (if v-notes = "":U then "":U else (v-notes + chr(10) + chr(10))) + v-cashier-note
      501   v-notes = (if v-notes = "":U then "":U else (v-notes + chr(10) + chr(10))) + v-fgrp-note
      502   .
      503   if p-interface then
      504   run gbl/showtext.p (
      505                    input "Отложенные задания пересылки на кассу"
      506                   ,input 80
      507                   ,input 15
      508                   ,input v-notes
      509                   ).
      510   if not p-run then return.
      511   run str/cd-askw.w (
      512                  input parparentproc
      513                 ,input v-cntxt-obj-type
      514                 ,input v-cntxt-obj-code
      515                 ,input-output v-gds
      516                 ,input-output v-dcard
      517                 ,input-output v-seller
      518                 ,input-output v-cashier
      519                 ,input-output v-fgrp
      520                 ,input v-gds-note
      521                 ,input v-dcard-note
      522                 ,input v-seller-note
      523                 ,input v-cashier-note
      524                 ,input v-fgrp-note
      525                 ) no-error .
      526   if error-status:error
      527   or return-value = "error":U
      528   or not (v-gds or v-dcard or v-seller or v-cashier)
      529   then return.
      530   run str/diallog.w (   parparentproc
      531                 , this-procedure
      532                 , 'str/sendalcd.p':U
      533                 , (string(v-gds) + chr(4) +
      534                    string(v-dcard) + chr(4) +
      535                    string(v-seller) + chr(4) +
      536                    string(v-cashier) + chr(4)  +
      537                    string(v-fgrp) + chr(4)
      538                      )
      539                 , no
      540                 , 'Прервать':U
      541                 , 'Отправка информации на кассу') no-error .
