      429     v-dcard-note = "Нет отложенных заданий на пересылку клиентов (карт) на кассу"
      430     .
      431   end.
      432   find first  buf_BatchProcess no-lock
      433         where buf_BatchProcess.bp_type       = 'slr':U
      434           and buf_BatchProcess.bp_status     = 'N':U
      435           use-INDEX XPKN477 no-error .
      436   if avail buf_BatchProcess then do:
      437           find first buf_user-login where buf_user-login.user-id = buf_BatchProcess.User_ID no-error.
      438     assign
