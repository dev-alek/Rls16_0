      440                  "от" + chr(32) +
      441                  string(buf_BatchProcess.BP_SysDate, "99/99/9999":U) + chr(32) +
      442                  buf_BatchProcess.BP_SysTime  + chr(10) +
      443                  "Пользователь" + chr(32) +
