      451     v-seller-note = "Нет отложенных заданий на пересылку продавцов на кассу"
      452     .
      453   end.
      454   find first  buf_BatchProcess no-lock
      455         where buf_BatchProcess.bp_type       = 'cshr':U
      456           and buf_BatchProcess.bp_status     = 'N':U
      457           use-INDEX XPKN477 no-error .
      458   if avail buf_BatchProcess then do:
      459           find first buf_user-login where buf_user-login.user-id = buf_BatchProcess.User_ID no-error.
      460     assign
      461     v-cashier-note = "Самое старое задание на пересылку информации о кассире на кассу" + chr(10) +
      462                  "от" + chr(32) +
      463                  string(buf_BatchProcess.BP_SysDate, "99/99/9999":U) + chr(32) +
      464                  buf_BatchProcess.BP_SysTime  + chr(10) +
      465                  "Пользователь" + chr(32) +
      466                  (if available buf_user-login then buf_user-login.User-login else "Логин удален с user-id =" + buf_BatchProcess.User_ID)
      467     v-cashier = yes
      468                  .
