      647     define variable v-cntxt-obj-code      as integer   no-undo .
      648     define variable v-cntxt-db-num-obj    as integer   no-undo .
      649     define variable v-cntxt-is-admin      as logical   no-undo .
      650   define variable g#host-name  as character no-undo .
