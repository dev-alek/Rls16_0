      626       (input this-procedure
      627       ) .
      628   end .
      629   on alt-shift-f2 anywhere do:
      630     run proc-alt-shift-f2.
      631   end.
      632   on alt-shift-f3 anywhere do:
      633     run proc-alt-shift-f3 in this-procedure .
      634   end.
      635   on alt-shift-f4 anywhere do:
      636     run proc-alt-shift-f4 in this-procedure.
      637   end.
      638   on alt-f1 anywhere do:
      639     run proc-alt-f1 in this-procedure .
      640   end.
      641   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      642     define variable v-cntxt-db-num        as integer   no-undo .
      643     define variable v-cntxt-userid        as character no-undo .
      644     define variable v-cntxt-level         as character no-undo .
