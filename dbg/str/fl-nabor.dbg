        1   DEFINE TEMP-TABLE tt-doc-line-attr NO-UNDO LIKE ub.doc-line-attr
        2          field node-code as int
        3          field price-rubl as dec
        4          field price-base as dec.
        5   define input  parameter   parParentProc  as widget-handle no-undo.
        6   define input  parameter   p-doc-mode  as character no-undo .
        7   define input  parameter   p-doc-code  as character no-undo .
        8   define input  parameter   p-bk-gds-code as integer   no-undo .
        9   define output parameter   p-make as logical   no-undo .
       10   define output parameter   p-sum1 as decimal   no-undo .
       11   define output parameter   p-sum2 as decimal   no-undo .
       12   define variable g#mainmenu-handle as widget-handle no-undo.
       13   g#mainmenu-handle = parParentProc .
       14   define variable list-mode as character no-undo .
       15   define new shared variable prt-rec   as recid no-undo .
       16   define new shared variable line-mode as character no-undo .
       17   define new shared variable line-rec  as recid no-undo .
       18   define new shared variable gds-rec   as recid no-undo .
       19   define variable vss-revision    as character no-undo init "$Revision$":U .
       20   define variable vss-author      as character no-undo init "$Author$":U .
       21   define variable vss-date        as character no-undo init "$Date$":U .
       22   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       23   define variable vss-archive     as character no-undo init "$Archive$":U .
       24   define variable vss-description as character no-undo init "Просмотр и корректировка состава набора".
       25   procedure vss-get-info :
       26     define output parameter p-vss-revision    like vss-revision    no-undo .
       27     define output parameter p-vss-author      like vss-author      no-undo .
       28     define output parameter p-vss-date        like vss-date        no-undo .
       29     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       30     define output parameter p-vss-archive     like vss-archive     no-undo .
       31     define output parameter p-vss-description like vss-description no-undo .
       32     assign
       33       p-vss-revision    = vss-revision
       34       p-vss-author      = vss-author
       35       p-vss-date        = vss-date
       36       p-vss-workfile    = vss-workfile
       37       p-vss-archive     = vss-archive
       38       p-vss-description = vss-description
       39     .
       40   end procedure.
       41   procedure vss-get-parameters :
       42     define output parameter p-vss-parameters as character no-undo .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   define new global shared variable g#language as character no-undo .
       80   if g#language <> '' and g#language <> 'rus':U then do:
       81     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       82   end.
       83   define new global shared variable g#library  as handle no-undo .
       84   define new global shared variable g#library2 as handle no-undo .
       85   define new global shared variable g#lib-trn  as handle no-undo .
       86   define new global shared variable g#lib-trn2 as handle no-undo .
       87   define new global shared variable g#lib-trn3 as handle no-undo .
       88   define new global shared variable g#lib-trn4 as handle no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure lineattr-value :
       91     do
       92     on error undo, return error return-value
       93     :
       94       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
       95       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
       96       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
       97       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
       98       define output parameter p-type     as character no-undo .
       99       define buffer buf_doc-line-attr for ub.doc-line-attr .
      100       def var v-format         as character no-undo .
      101       def var v-fillin_width   as integer   no-undo .
      102       def var v-fillin_height  as integer   no-undo .
      103       def var v-label          as character no-undo .
      104       def var v-user-can-edit  as logical   no-undo .
      105       def var v-output-display as logical   no-undo .
      106       def var v-other          as character no-undo .
      107       run lineattr-code in this-procedure
      108         (input  p-code
      109         ,output p-type
      110         ,output v-format
      111         ,output v-fillin_width
      112         ,output v-fillin_height
      113         ,output v-label
      114         ,output v-user-can-edit
      115         ,output v-output-display
      116         ,output v-other
      117         ) no-error .
      118       if error-status :error then do:
      119         undo, return error return-value .
      120       end.
      121       find first buf_doc-line-attr no-lock
      122         where buf_doc-line-attr.doc-code  = p-doc-code
      123           and buf_doc-line-attr.gds-code  = p-gds-code
      124           and buf_doc-line-attr.attr-code = p-code
      125         no-error .
      126       if avail buf_doc-line-attr then do:
      127         assign
      128           p-value =  buf_doc-line-attr.attr-value
      129         .
      130       end.
      131       else do:
      132         assign
      133           p-value = if p-type = 'L':U then "no":U else ""
      134         .
      135       end.
      136     end.
      137   end procedure.
      138   procedure lineattr-write :
      139     do
      140     on error undo, return error return-value
      141     :
      142       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      143       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      144       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      145       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      146       define buffer buf_doc-line-attr for ub.doc-line-attr .
      147       def var v-type           as character no-undo .
      148       def var v-format         as character no-undo .
      149       def var v-fillin_width   as integer   no-undo .
      150       def var v-fillin_height  as integer   no-undo .
      151       def var v-label          as character no-undo .
      152       def var v-user-can-edit  as logical   no-undo .
      153       def var v-output-display as logical   no-undo .
      154       def var v-other          as character no-undo .
      155       run lineattr-code in this-procedure
      156         (input  p-code
      157         ,output v-type
      158         ,output v-format
      159         ,output v-fillin_width
      160         ,output v-fillin_height
      161         ,output v-label
      162         ,output v-user-can-edit
      163         ,output v-output-display
      164         ,output v-other
      165         ) no-error .
      166       if error-status :error then do:
      167         undo, return error return-value .
      168       end.
      169       find first buf_doc-line-attr exclusive-lock
      170         where buf_doc-line-attr.doc-code  = p-doc-code
      171           and buf_doc-line-attr.gds-code  = p-gds-code
      172           and buf_doc-line-attr.attr-code = p-code
      173         no-error .
      174       if not available buf_doc-line-attr then do:
      175         create buf_doc-line-attr .
      176         assign
      177           buf_doc-line-attr.doc-code  = p-doc-code
      178           buf_doc-line-attr.gds-code = p-gds-code
      179           buf_doc-line-attr.attr-code = p-code
      180         .
      181       end.
      182       assign
      183         buf_doc-line-attr.attr-value = p-value
      184       .
      185        release buf_doc-line-attr.
      186     end.
      187   end procedure.
      188   procedure lineattr-exist :
      189     do
      190     on error undo, return error return-value
      191     :
      192       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      193       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      194       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      195       define output parameter p-exist   as logical  no-undo .
      196       define buffer buf_doc-line-attr for ub.doc-line-attr .
      197       def var v-type           as character no-undo .
      198       def var v-format         as character no-undo .
      199       def var v-fillin_width   as integer   no-undo .
      200       def var v-fillin_height  as integer   no-undo .
      201       def var v-label          as character no-undo .
      202       def var v-user-can-edit  as logical   no-undo .
      203       def var v-output-display as logical   no-undo .
      204       def var v-other          as character no-undo .
      205       run lineattr-code in this-procedure
      206         (input  p-code
      207         ,output v-type
      208         ,output v-format
      209         ,output v-fillin_width
      210         ,output v-fillin_height
      211         ,output v-label
      212         ,output v-user-can-edit
      213         ,output v-output-display
      214         ,output v-other
      215         ) no-error .
      216       if error-status :error then do:
      217         undo, return error return-value .
      218       end.
      219       find first buf_doc-line-attr no-lock
      220         where buf_doc-line-attr.doc-code  = p-doc-code
      221           and buf_doc-line-attr.gds-code = p-gds-code
      222           and buf_doc-line-attr.attr-code = p-code
      223         no-error .
      224       if  available buf_doc-line-attr then do:
      225         p-exist = yes.
      226       end.
      227     end.
      228   end procedure.
      229   procedure lineattr-delete :
      230     do
      231     on error undo, return error return-value
      232     :
      233       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      234       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      235       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      236       define output parameter p-deleted  as logical no-undo.
      237       define buffer buf_doc-line-attr for ub.doc-line-attr .
      238       def var v-type           as character no-undo .
      239       def var v-format         as character no-undo .
      240       def var v-fillin_width   as integer   no-undo .
      241       def var v-fillin_height  as integer   no-undo .
      242       def var v-label          as character no-undo .
      243       def var v-user-can-edit  as logical   no-undo .
      244       def var v-output-display as logical   no-undo .
      245       def var v-other          as character no-undo .
      246       run lineattr-code in this-procedure
      247         (input  p-code
      248         ,output v-type
      249         ,output v-format
      250         ,output v-fillin_width
      251         ,output v-fillin_height
      252         ,output v-label
      253         ,output v-user-can-edit
      254         ,output v-output-display
      255         ,output v-other
      256         ) no-error .
      257       if error-status :error then do:
      258         undo, return error return-value .
      259       end.
      260       find first buf_doc-line-attr exclusive-lock
      261         where buf_doc-line-attr.doc-code  = p-doc-code
      262           and buf_doc-line-attr.gds-code  = p-gds-code
      263           and buf_doc-line-attr.attr-code = p-code
      264         no-error NO-WAIT.
      265       if not available buf_doc-line-attr then do:
      266         p-deleted = no.
      267       end.
      268       else do:
      269         delete buf_doc-line-attr.
      270         p-deleted = yes.
      271       end.
      272     end.
      273   end procedure.
      274   procedure lineattr-code :
      275     do on error undo, return error return-value
      276     :
      277       define input  parameter p-code           as character no-undo .
      278       define output parameter p-type           as character no-undo .
      279       define output parameter p-format         as character no-undo .
      280       define output parameter p-fillin_width   as integer   no-undo .
      281       define output parameter p-fillin_height  as integer   no-undo .
      282       define output parameter p-label          as character no-undo .
      283       define output parameter p-user-can-edit  as logical   no-undo .
      284       define output parameter p-output-display as logical   no-undo .
      285       define output parameter p-other          as character no-undo .
      286       case p-code :
      287               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      288               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      289               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      290               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      291               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      292               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      293               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      294               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      295               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      296               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      297               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      298         otherwise do:
      299           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      300         end.
      301       end.
      302     end.
      303   end procedure.
      304   procedure lineattr-value-flora-gds :
      305     do
      306     on error undo, return error return-value
      307     :
      308       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      309       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      310       define input  parameter p-prt-code    as integer   no-undo .
      311       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      312       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      313       define output parameter p-value       as    decimal   no-undo .
      314       define buffer buf_doc-line-attr for ub.doc-line-attr .
      315       find first buf_doc-line-attr no-lock
      316         where buf_doc-line-attr.doc-code  = p-doc-code
      317           and buf_doc-line-attr.gds-code  = p-gds-code
      318           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      319         no-error .
      320       if avail buf_doc-line-attr then do:
      321         assign
      322           p-value = decimal( buf_doc-line-attr.attr-value)
      323         .
      324       end.
      325       else do:
      326         assign
      327           p-value = 0
      328         .
      329       end.
      330     end.
      331   end procedure.
      332   procedure lineattr-write-flora-gds :
      333     do
      334     on error undo, return error return-value
      335     :
      336       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      337       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      338       define input parameter p-prt-code    as integer   no-undo .
      339       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      340       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      341       define input parameter p-value    as decimal   no-undo .
      342       define buffer buf_doc-line-attr for ub.doc-line-attr .
      343       find first buf_doc-line-attr exclusive-lock
      344         where buf_doc-line-attr.doc-code  = p-doc-code
      345           and buf_doc-line-attr.gds-code  = p-gds-code
      346           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      347         no-error .
      348       if not available buf_doc-line-attr then do:
      349         create buf_doc-line-attr .
      350         assign
      351           buf_doc-line-attr.doc-code  = p-doc-code
      352           buf_doc-line-attr.gds-code  = p-gds-code
      353           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      354         .
      355       end.
      356       assign
      357         buf_doc-line-attr.attr-value = string( p-value )
      358       .
      359     end.
      360   end procedure.
      361   procedure lineattr-delete-flora-gds :
      362     do
      363     on error undo, return error return-value
      364     :
      365       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      366       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      367       define input  parameter p-prt-code    as integer   no-undo .
      368       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      369       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      370       define output parameter p-deleted  as logical no-undo.
      371       define buffer buf_doc-line-attr for ub.doc-line-attr .
      372       find first buf_doc-line-attr exclusive-lock
      373         where buf_doc-line-attr.doc-code  = p-doc-code
      374           and buf_doc-line-attr.gds-code  = p-gds-code
      375           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      376         no-error NO-WAIT.
      377       if not available buf_doc-line-attr then do:
      378         p-deleted = no.
      379       end.
      380       else do:
      381         delete buf_doc-line-attr.
      382         p-deleted = yes.
      383       end.
      384     end.
      385   end procedure.
      386   procedure lineattr-delete-flora-all :
      387     do
      388     on error undo, return error return-value
      389     :
      390       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      391       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      392       define input  parameter p-prt-code    as integer   no-undo .
      393       define buffer buf_doc-line-attr for ub.doc-line-attr .
      394       for each buf_doc-line-attr exclusive-lock
      395         where buf_doc-line-attr.doc-code  = p-doc-code
      396           and buf_doc-line-attr.gds-code  = p-gds-code
      397           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      398        :
      399         delete buf_doc-line-attr.
      400       end.
      401    end.
      402   end procedure.
      403   procedure lineattr-exist-flora-gds :
      404     do
      405     on error undo, return error return-value
      406     :
      407       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      408       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      409       define input  parameter p-prt-code    as integer   no-undo .
      410       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      411       define output parameter p-exist as logical   no-undo .
      412       define buffer buf_doc-line-attr for ub.doc-line-attr .
      413       p-exist = false .
      414       find first buf_doc-line-attr no-lock
      415         where buf_doc-line-attr.doc-code  = p-doc-code
      416           and buf_doc-line-attr.gds-code  = p-gds-code
      417           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      418         no-error .
      419       if avail buf_doc-line-attr then do:
      420         assign
      421          p-exist = true
      422         .
      423       end.
      424     end.
      425   end procedure.
      426   procedure lineattr-write-add-line-cli :
      427   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      428   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      429   define input  parameter p-cli-type      as character no-undo .
      430   define input  parameter p-cli-code      as integer   no-undo .
      431   define input  parameter p-contract-code as integer   no-undo .
      432   define input  parameter p-host-code     as integer   no-undo .
      433   define input  parameter p-exch-code     as integer   no-undo .
      434   define input  parameter p-exch-rate     as decimal   no-undo .
      435   define input  parameter p-exch-scale    as integer   no-undo .
      436   define input  parameter p-sum-cli       as decimal   no-undo .
      437   define input  parameter p-sum-vat       as decimal   no-undo .
      438   define buffer buf_doc-line-attr for ub.doc-line-attr .
      439     do
      440     on error undo, return error return-value
      441     :
      442       find first buf_doc-line-attr exclusive-lock
      443         where buf_doc-line-attr.doc-code  = p-doc-code
      444           and buf_doc-line-attr.gds-code  = p-gds-code
      445           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      446                                             chr(4) + p-cli-type +
      447                                             chr(4) + string(p-cli-code) +
      448                                             chr(4) + string(p-contract-code) +
      449                                             chr(4) + string(p-host-code)
      450         no-error .
      451       if not available buf_doc-line-attr then do:
      452         create buf_doc-line-attr .
      453         assign
      454           buf_doc-line-attr.doc-code  = p-doc-code
      455           buf_doc-line-attr.gds-code  = p-gds-code
      456           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      457                                         chr(4) + p-cli-type +
      458                                         chr(4) + string(p-cli-code) +
      459                                         chr(4) + string(p-contract-code) +
      460                                         chr(4) + string(p-host-code)
      461         .
      462       end.
      463       assign
      464         buf_doc-line-attr.attr-value =
      465         string(p-exch-code)  + chr(4) +
      466         string(p-exch-rate)  + chr(4) +
      467         string(p-exch-scale) + chr(4) +
      468         string(p-sum-cli)    + chr(4) +
      469         string(p-sum-vat)
      470         .
      471     end.
      472   end procedure.
      473   procedure lineattr-value-add-line-cli :
      474   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      475   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      476   define input   parameter p-cli-type      as character no-undo .
      477   define input   parameter p-cli-code      as integer   no-undo .
      478   define input   parameter p-contract-code as integer   no-undo .
      479   define input   parameter p-host-code     as integer   no-undo .
      480   define output  parameter p-exch-code     as integer   no-undo .
      481   define output  parameter p-exch-rate     as decimal   no-undo .
      482   define output  parameter p-exch-scale    as integer   no-undo .
      483   define output  parameter p-sum-cli       as decimal   no-undo .
      484   define output  parameter p-sum-vat       as decimal   no-undo .
      485   define buffer buf_doc-line-attr for ub.doc-line-attr .
      486     do
      487     on error undo, return error return-value
      488     :
      489       find first buf_doc-line-attr exclusive-lock
      490         where buf_doc-line-attr.doc-code  = p-doc-code
      491           and buf_doc-line-attr.gds-code  = p-gds-code
      492           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      493                                             chr(4) + p-cli-type +
      494                                             chr(4) + string(p-cli-code) +
      495                                             chr(4) + string(p-contract-code) +
      496                                             chr(4) + string(p-host-code)
      497         no-error .
      498       if available buf_doc-line-attr then do:
      499        assign
      500           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      501           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      502           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      503           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      504           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      505          .
      506        end.
      507     end.
      508   end procedure.
      509   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      510     define variable v-code as character no-undo .
      511     define variable v-type as character no-undo .
      512     define variable v-gds-code as integer   no-undo .
      513   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      514   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      515     (input  local-doc-line.artic
      516     ,input  local-doc-line.prod-type
      517     ,input  local-doc-line.prod-code
      518     ,output v-gds-code
      519     )  .
      520     run lineattr-value (
      521         input   local-doc-line.doc-code ,
      522         input   v-gds-code              ,
      523         input   'reason-code':U ,
      524         output  v-code                  ,
      525         output  v-type ) .
      526     find first ub.trn-reason no-lock where
      527                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      528     if not available ub.trn-reason then do:
      529        return "" .
      530     end.
      531     else do:
      532        return ub.trn-reason.reason-name .
      533     end.
      534   end function.
      535   procedure lineattr-value-parts :
      536     do
      537     on error undo, return error return-value
      538     :
      539       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      540       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      541       define input  parameter p-part-code   as character no-undo .
      542       define input  parameter p_in-code     as character no-undo .
      543       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      544       define output parameter p-value       as    decimal   no-undo .
      545       define buffer buf_doc-line-attr for ub.doc-line-attr .
      546       find first buf_doc-line-attr no-lock
      547         where buf_doc-line-attr.doc-code  = p-doc-code
      548           and buf_doc-line-attr.gds-code  = p-gds-code
      549           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      550         no-error .
      551       if avail buf_doc-line-attr then do:
      552         assign
      553           p-value = decimal( buf_doc-line-attr.attr-value)
      554         .
      555       end.
      556       else do:
      557         assign
      558           p-value = 0
      559         .
      560       end.
      561     end.
      562   end procedure.
      563   procedure lineattr-write-parts :
      564     do
      565     on error undo, return error return-value
      566     :
      567       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      568       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      569       define input parameter p-part-code  as character no-undo .
      570       define input parameter p_in-code    as character no-undo .
      571       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      572       define input parameter p-value      as decimal   no-undo .
      573       define buffer buf_doc-line-attr for ub.doc-line-attr .
      574       find first buf_doc-line-attr exclusive-lock
      575         where buf_doc-line-attr.doc-code  = p-doc-code
      576           and buf_doc-line-attr.gds-code  = p-gds-code
      577           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      578         no-error .
      579       if not available buf_doc-line-attr then do:
      580         create buf_doc-line-attr .
      581         assign
      582           buf_doc-line-attr.doc-code  = p-doc-code
      583           buf_doc-line-attr.gds-code  = p-gds-code
      584           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      585         .
      586       end.
      587       assign
      588         buf_doc-line-attr.attr-value = string( p-value )
      589       .
      590     end.
      591   end procedure.
      592   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593   define new global shared variable g#trdcalib as handle no-undo.
      594   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   define new global shared variable g#lib-calc as handle no-undo .
      596   procedure proc-alt-shift-f2:
      597     if not ibs.th.gbl.gbl-var:rcode
      598   then
      599     run gbl\inidebug.p .
      600   end.
      601   procedure proc-alt-shift-f3:
      602     run gbl/prvssinf.p
      603       ( input this-procedure
      604       ) .
      605   end.
      606   define variable v-inform-launched as logical no-undo initial false .
      607   procedure proc-alt-shift-f4:
      608     define variable v-action as character no-undo .
      609     if v-inform-launched = false then do:
      610       assign
      611         v-inform-launched = true
      612       .
      613       run gbl/d-inform.w
      614         (  input self
      615         ,  input this-procedure
      616         , output v-action
      617         ) no-error .
      618       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      619       assign
      620         v-inform-launched = false
      621       .
      622     end.
      623   end.
      624   procedure proc-alt-f1:
