      670   .
      671   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      672   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      673     (input  store-type
      674     ,input  store-code
      675     ,output g#host-code
      676     ,output g#host-name
      677     )  .
      678   run get-report-num  in parParentProc ( output g#report-num ).
      679   define temp-table temp-gds-dtl no-undo
      680   field node-code as integer
      681   field artic     as char
      682   field prod-type     as char
      683   field prod-code     as int
      684   field gds-code  as integer
      685   field rel-bk    as logical
      686   index pi node-code
      687   .
      688   def var chg-qnty like gds-dtl.doc-qnty init ? no-undo.
      689   def shared buffer t-doc for trn-doc.
      690   if t-doc.status_ = 'готов':U  or
      691      t-doc.status_ = 'отказ':U
      692   then p-doc-mode = 'ПРОСМОТР':U .
      693   p-make = false  .
      694   define buffer tt2-doc-line-attr for tt-doc-line-attr.
      695   DEF VAR v-sum-deliv AS CHAR NO-UNDO.
      696   DEFINE BUTTON B-add
      697        LABEL "Добавить"
      698        SIZE 10 BY 1
      699        BGCOLOR 8 .
      700   DEFINE BUTTON B-chg
      701        LABEL "Изменить"
      702        SIZE 10 BY 1
      703        BGCOLOR 8 .
      704   DEFINE BUTTON B-del
      705        LABEL "Удалить"
      706        SIZE 10 BY 1
      707        BGCOLOR 8 .
      708   DEFINE BUTTON B-exit AUTO-END-KEY
      709        LABEL "Выход"
      710        SIZE 10 BY 1
      711        BGCOLOR 8 .
      712   DEFINE BUTTON B-Help
      713        LABEL "Помощь"
      714        SIZE 10 BY 1
      715        BGCOLOR 8 .
      716   DEFINE VARIABLE v-prim-str AS CHARACTER
      717        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      718        SIZE 89.5 BY 3.5 NO-UNDO.
      719   DEFINE VARIABLE text-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Итого c наценкой и скидкой:"
      720         VIEW-AS TEXT
      721        SIZE 28 BY .67 NO-UNDO.
      722   DEFINE VARIABLE v-itogo-base AS DECIMAL FORMAT "->>>>>>>>9.99":U INITIAL 0
      723        LABEL "Итого (баз.вал)"
      724         VIEW-AS TEXT
      725        SIZE 21.5 BY .67
      726        FGCOLOR 4  NO-UNDO.
      727   DEFINE VARIABLE v-itogo-rubl AS DECIMAL FORMAT "->>>>>>>>9.99":U INITIAL 0
      728        LABEL "Итого "
      729         VIEW-AS TEXT
      730        SIZE 21.5 BY .67
      731        FGCOLOR 4  NO-UNDO.
      732   DEFINE VARIABLE v-pr-sk AS DECIMAL FORMAT "->>>>9.99%":U INITIAL 0
      733        LABEL "Скидка клиента"
      734         VIEW-AS TEXT
      735        SIZE 10 BY .67
      736        FGCOLOR 1  NO-UNDO.
      737   DEFINE VARIABLE v-pr-wrk AS DECIMAL FORMAT "->>>>9.99%":U INITIAL 0
      738        LABEL "Наценка за работу"
      739         VIEW-AS TEXT
      740        SIZE 10 BY .67
      741        FGCOLOR 1  NO-UNDO.
      742   DEFINE VARIABLE v-str AS CHARACTER FORMAT "X(256)":U
      743         VIEW-AS TEXT
      744        SIZE 89.5 BY 1.25
      745        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      746   DEFINE VARIABLE v-sum-with-disc-base AS DECIMAL FORMAT "->>>>>>>>9.99":U INITIAL 0
      747        LABEL "баз.вал."
      748         VIEW-AS TEXT
      749        SIZE 21.5 BY .67
      750        FGCOLOR 4  NO-UNDO.
      751   DEFINE VARIABLE v-sum-with-disc-rubl AS DECIMAL FORMAT "->>>>>>>>9.99":U INITIAL 0
      752        LABEL "."
      753         VIEW-AS TEXT
      754        SIZE 21.5 BY .67
      755        FGCOLOR 4  NO-UNDO.
      756   DEFINE QUERY BROWSE-1 FOR
      757         tt-doc-line-attr,
      758         ub.goods,
      759         ub.gds-prt SCROLLING.
      760   DEFINE BROWSE BROWSE-1
      761     QUERY BROWSE-1 NO-LOCK DISPLAY
      762         ub.goods.artic FORMAT "X(16)":U
      763         (if gds-prt.node-name <> '_Пустая шкала':U and gds-prt.upper-code <> goods.prt-root then goods.gds-name + ' - ' + gds-prt.f-name else goods.gds-name) COLUMN-LABEL "Наименование" FORMAT "x(35)":U
      764         ub.goods.unit-base COLUMN-LABEL "Ед.!изм." FORMAT "X(3)":U
      765               WIDTH 3
      766         tt-doc-line-attr.attr-value COLUMN-LABEL "Количество" FORMAT "X(10)":U
      767         tt-doc-line-attr.price-base COLUMN-LABEL "Цена в !баз.вал." FORMAT ">>>>>>9.99":U
      768         tt-doc-line-attr.price-rubl COLUMN-LABEL "Цена в руб" FORMAT ">>>>>>9.99":U
      769       WITH NO-ROW-MARKERS SEPARATORS SIZE 90 BY 10.75 EXPANDABLE.
      770   DEFINE FRAME Dialog-Frame
      771        B-exit AT ROW 1 COL 1
      772        B-add AT ROW 1 COL 11
      773        B-chg AT ROW 1 COL 21
      774        B-del AT ROW 1 COL 31
      775        B-Help AT ROW 1 COL 81
      776        BROWSE-1 AT ROW 3.75 COL 1
      777        v-prim-str AT ROW 19 COL 1 NO-LABEL
      778        v-str AT ROW 2.25 COL 1.5 NO-LABEL
      779        v-pr-wrk AT ROW 14.5 COL 21.5 COLON-ALIGNED
      780        v-itogo-base AT ROW 14.5 COL 67 COLON-ALIGNED
      781        v-pr-sk AT ROW 15.25 COL 21.5 COLON-ALIGNED
      782        v-itogo-rubl AT ROW 15.25 COL 67 COLON-ALIGNED
      783        text-1 AT ROW 16.5 COL 50 COLON-ALIGNED NO-LABEL
      784        v-sum-with-disc-base AT ROW 17.25 COL 67 COLON-ALIGNED
      785        v-sum-with-disc-rubl AT ROW 18 COL 67 COLON-ALIGNED
      786        SPACE(0.62) SKIP(3.95)
      787       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      788            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      789            TITLE "Товары в наборе"
      790            CANCEL-BUTTON B-exit.
      791   ASSIGN
      792          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      793          FRAME Dialog-Frame:HIDDEN           = TRUE.
      794   ASSIGN
      795          v-prim-str:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      796   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      797   DO:
      798     APPLY "END-ERROR":U TO SELF.
      799   END.
      800   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      801   DO:
      802   define variable  v-qnty     as character no-undo .
      803   define variable  v-qnty-old as character no-undo .
      804   define variable v-buket-gds-code as integer   no-undo .
      805   define variable v-gds-code as integer   no-undo .
      806   define variable v-prt-code as integer   no-undo .
      807   define variable varartic      like doc-line.artic      initial " " no-undo.
      808   define variable v-exist as logical   no-undo .
      809   define buffer buf_doc-line-attr for ub.doc-line-attr .
      810   define variable s-value as character no-undo .
      811   define variable notes as character no-undo .
      812   define variable lns-cnt as integer   no-undo .
      813   p-make = true .
      814   v-buket-gds-code = p-bk-gds-code .
      815     run str/chs-gds.w
      816                   ( input parparentproc
      817                    ,input t-doc.obj-type
      818                    ,input t-doc.obj-code
      819                    ,input list-mode
      820                    ,input t-doc.status_
      821                    ,input "Для нетоварной позиции" + v-str
      822                    ,input 'свободно':U
      823                    ,input t-doc.cli-type
      824                    ,input t-doc.cli-code
      825                    ,input t-doc.host-code
      826                    ,input t-doc.ext-doc-type
      827                    ,input-output varartic
      828                    ,output notes
      829                    ).
      830   if notes = '' then return.
      831   assign
      832     line-mode = 'ДОБАВЛЕНИЕ':U
      833     prt-rec = ?
      834     lns-cnt = 1
      835     .
      836   do while lns-cnt <= num-entries (notes):
      837     assign
      838       gds-rec = integer (entry (lns-cnt, notes))
      839       lns-cnt = lns-cnt + 1.
      840   find first goods no-lock where recid (goods) = gds-rec no-error .
      841   v-gds-code = goods.gds-code.
      842   find first  gds-prt no-lock where  gds-prt.upper-code = goods.prt-root no-error .
      843   if gds-prt.node-name = '_Пустая шкала':U then do:
      844      v-prt-code = gds-prt.node-code.
      845         run lineattr-exist-flora-gds
      846             ( input   t-doc.doc-code   ,
      847               input   goods.gds-code   ,
      848               input   v-prt-code       ,
      849               input   v-buket-gds-code ,
      850               output  v-exist          )
      851               .
      852           v-exist = false .
      853           find first gds-dtl no-lock where
      854                     gds-dtl.doc-code = t-doc.doc-code   and
      855                     gds-dtl.artic    = goods.artic      and
      856                     gds-dtl.prod-type = goods.prod-type and
      857                     gds-dtl.prod-code = goods.prod-code no-error .
      858           if available gds-dtl then do:
      859             assign
      860             v-exist = true
      861             .
      862           end.
      863           if v-exist = false then do:
      864             run str/out-add.p
      865             (   parparentproc
      866                , recid(t-doc)
      867                , ?
      868                , ?
      869                , recid(goods)
      870                , 'ДОБАВЛЕНИЕ':U
      871                , string(v-buket-gds-code)
      872                 ) no-error.
      873             if error-status:error then do: next. end.
      874           end.
      875           else do:
      876           end.
      877           find first gds-dtl no-lock where gds-dtl.doc-code = t-doc.doc-code   and
      878                                           gds-dtl.artic     = goods.artic      and
      879                                           gds-dtl.prod-type = goods.prod-type  and
      880                                           gds-dtl.prod-code = goods.prod-code  no-error .
      881           if available gds-dtl then do:
      882              find first tt-doc-line-attr where
      883               tt-doc-line-attr.doc-code    = p-doc-code and
      884               tt-doc-line-attr.gds-code    = v-gds-code and
      885               tt-doc-line-attr.attr-code   = 'fl_gds-code':U  + chr(44) + string(gds-dtl.prt-code)  + chr(44) + string(v-buket-gds-code )
      886               no-error .
      887              if not available tt-doc-line-attr then do:
      888                 CREATE tt-doc-line-attr.
      889                 end.
      890                 else do:
      891                 end.
      892              assign
      893               tt-doc-line-attr.doc-code    = p-doc-code
      894               tt-doc-line-attr.gds-code    = v-gds-code
      895               tt-doc-line-attr.node-code   = gds-dtl.prt-code
      896               tt-doc-line-attr.attr-value  = if v-exist = true then "1"  else string (gds-dtl.fact-qnty)
      897               tt-doc-line-attr.attr-code   = 'fl_gds-code':U  + chr(44) + string(tt-doc-line-attr.node-code)  + chr(44) + string(v-buket-gds-code )
      898               tt-doc-line-attr.price-rubl  =  gds-dtl.price-rubl
      899               tt-doc-line-attr.price-base  =  gds-dtl.price-base
      900               .
      901              find first doc-line-attr exclusive-lock where
      902               doc-line-attr.doc-code    = p-doc-code and
      903               doc-line-attr.gds-code    = v-gds-code and
      904               doc-line-attr.attr-code   = 'fl_gds-code':U  + chr(44) + string(gds-dtl.prt-code)  + chr(44) + string(v-buket-gds-code )
      905               no-error .
      906               if not available doc-line-attr then  create doc-line-attr.
      907              BUFFER-COPY tt-doc-line-attr  TO doc-line-attr .
      908           end.
      909   end.
      910   else do:
      911           v-exist = false .
      912           find first gds-dtl no-lock where gds-dtl.doc-code = t-doc.doc-code   and
      913                                           gds-dtl.artic     = goods.artic      and
      914                                           gds-dtl.prod-type = goods.prod-type and
      915                                           gds-dtl.prod-code = goods.prod-code no-error .
      916           if available gds-dtl then do:
      917             assign
      918             v-exist = true
      919             .
      920           end.
      921         if v-exist = false then do:
      922             run str/out-add.p
      923             (
      924                 parparentproc
      925                , recid(t-doc)
      926                , ?
      927                , ?
      928                , recid(goods)
      929                , 'ДОБАВЛЕНИЕ':U
      930                , string(v-buket-gds-code)
      931                 ) no-error.
      932           if error-status:error then do: next. end.
      933           for each  gds-dtl no-lock where gds-dtl.doc-code = t-doc.doc-code   and
      934                                           gds-dtl.artic     = goods.artic     and
      935                                           gds-dtl.prod-type = goods.prod-type and
      936                                           gds-dtl.prod-code = goods.prod-code  :
      937             CREATE tt-doc-line-attr.
      938                 assign
      939                 tt-doc-line-attr.doc-code    = p-doc-code
      940                 tt-doc-line-attr.gds-code    = v-gds-code
      941                 tt-doc-line-attr.node-code   = gds-dtl.prt-code
      942                 tt-doc-line-attr.attr-value  = string(gds-dtl.fact-qnty)
      943                 tt-doc-line-attr.attr-code  = 'fl_gds-code':U  + chr(44) + string(tt-doc-line-attr.node-code)  + chr(44) + string(v-buket-gds-code )
      944                 tt-doc-line-attr.price-rubl  =  gds-dtl.price-rubl
      945                 tt-doc-line-attr.price-base  =  gds-dtl.price-base
      946                 .
      947           end.
      948         end.
      949         else do:
      950             run str/out-add.p
      951             (
      952                 parparentproc
      953                , recid(t-doc)
      954                , ?
      955                , ?
      956                , recid(goods)
      957                , 'ДОБАВЛЕНИЕ':U
      958                , string(v-buket-gds-code)
      959                 ) no-error.
      960           if error-status:error then do: next. end.
      961           for each  doc-line-attr no-lock where
      962             doc-line-attr.doc-code = t-doc.doc-code   and
      963             doc-line-attr.gds-code = goods.gds-code   and
      964             lookup ('fl_gds-code':U , doc-line-attr.attr-code)  =  1 and
      965             lookup ( string(v-buket-gds-code ) , doc-line-attr.attr-code)  =  3 and
      966             decimal(doc-line-attr.attr-value) <> 0
      967             :
      968             find first tt-doc-line-attr where
      969                 tt-doc-line-attr.doc-code    = doc-line-attr.doc-code  and
      970                 tt-doc-line-attr.gds-code    = doc-line-attr.gds-code  and
      971                 tt-doc-line-attr.attr-code   = doc-line-attr.attr-code no-error .
      972             if not available tt-doc-line-attr then     CREATE tt-doc-line-attr.
      973             find first gds-dtl no-lock where gds-dtl.doc-code = t-doc.doc-code   and
      974                                             gds-dtl.prt-code = integer (entry(2, doc-line-attr.attr-code))      and
      975                                             gds-dtl.artic     = goods.artic      and
      976                                             gds-dtl.prod-type = goods.prod-type and
      977                                             gds-dtl.prod-code = goods.prod-code no-error .
      978                 assign
      979                   tt-doc-line-attr.doc-code    = doc-line-attr.doc-code
      980                   tt-doc-line-attr.gds-code    = doc-line-attr.gds-code
      981                   tt-doc-line-attr.node-code   = integer (entry(2, doc-line-attr.attr-code))
      982                   tt-doc-line-attr.attr-value  = doc-line-attr.attr-value
      983                   tt-doc-line-attr.attr-code   = doc-line-attr.attr-code
      984                   tt-doc-line-attr.price-rubl  =  gds-dtl.price-rubl
      985                   tt-doc-line-attr.price-base  =  gds-dtl.price-base
      986                 .
      987           end.
      988         end.
      989   end.
      990   end.
      991   OPEN QUERY BROWSE-1 FOR EACH tt-doc-line-attr NO-LOCK,       EACH ub.goods WHERE ub.goods.gds-code = tt-doc-line-attr.gds-code NO-LOCK,       EACH ub.gds-prt WHERE ub.gds-prt.node-code =  tt-doc-line-attr.node-code NO-LOCK INDEXED-REPOSITION.
      992   run re-disp in this-procedure .
      993   END.
      994   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      995   DO:
      996   if not available tt-doc-line-attr then return .
      997   define variable v-qnty as character no-undo .
      998   define variable v-qnty-old as character no-undo .
      999    v-qnty =  tt-doc-line-attr.attr-value .
     1000    v-qnty-old =  tt-doc-line-attr.attr-value .
     1001   run gbl/d-prompt.w
     1002   (       'title=':u + "Изменение количества товара" + '\':u
     1003         + 'text1=':u + "Количество" + (if gds-prt.node-name <> '_Пустая шкала':U and gds-prt.upper-code <> goods.prt-root then goods.gds-name + ' - ' + gds-prt.f-name else goods.gds-name) + '\':u
     1004         + 'format=' + ">>>>>>>9.99" + '\':u
     1005         + 'type=' + "decimal" + '\':u
     1006         + 'fillin_row=2\':u
     1007         + 'fillin_col=4\':u
     1008         + 'fillin_width=10\':u
     1009         + 'fillin_height=1\':u
     1010         + 'max-chars=10\':u
     1011         + 'readonly=' + (if p-doc-mode <> 'ПРОСМОТР':U then 'no':u else 'yes':u) + '\':u
     1012         , input-output v-qnty
     1013         ) no-error.
     1014      if caps(return-value) = "TRUE" and p-doc-mode <> 'ПРОСМОТР':U  then do:
     1015         tt-doc-line-attr.attr-value  = v-qnty  .
     1016         run re-disp in this-procedure .
     1017        BROWSE-1:refresh() in frame Dialog-Frame .
     1018      end.
     1019   END.
     1020   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1021   DO:
     1022   if not available tt-doc-line-attr then return .
     1023      message
     1024      "Удалять товар : " (if gds-prt.node-name <> '_Пустая шкала':U and gds-prt.upper-code <> goods.prt-root then goods.gds-name + ' - ' + gds-prt.f-name else goods.gds-name)
     1025      " из набора : " v-str "?"
     1026      view-as alert-box question
     1027      buttons yes-no
     1028      update v-d as log
     1029      .
     1030      if v-d = true then do:
     1031         delete tt-doc-line-attr.
     1032         run re-disp in this-procedure .
     1033         OPEN QUERY BROWSE-1 FOR EACH tt-doc-line-attr NO-LOCK,       EACH ub.goods WHERE ub.goods.gds-code = tt-doc-line-attr.gds-code NO-LOCK,       EACH ub.gds-prt WHERE ub.gds-prt.node-code =  tt-doc-line-attr.node-code NO-LOCK INDEXED-REPOSITION.
     1034      end.
     1035   END.
     1036   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1037   DO:
     1038     run save-proc in this-procedure .
     1039   END.
     1040   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1041   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1042   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1043   on help of frame Dialog-Frame
     1044   do:
     1045     run gbl/app_help.p
     1046       (input this-procedure :file-name
     1047       ,input ''
     1048       ,input ?
     1049       ) no-error.
     1050     if error-status :error then do:
     1051       message
     1052         "Ошибка при вызове помощи"
     1053         error-status :get-message(1)
     1054         view-as alert-box .
     1055     end.
     1056   end.
     1057   run minbtn-set in this-procedure .
     1058   on choose of b-help in frame Dialog-Frame
     1059   do:
     1060     apply "help":u to frame Dialog-Frame .
     1061   end.
     1062   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1063   procedure minbtn-set :
     1064       do
     1065           on error undo, return error return-value
     1066           :
     1067           define variable ii              as integer       no-undo .
     1068           define variable fh              as widget-handle no-undo .
     1069           define variable hh              as widget-handle no-undo .
     1070           define variable v-h             as handle        extent 4 no-undo .
     1071           define variable v-name-button   as character     no-undo .
     1072           define variable v-help-old-x    as decimal       no-undo .
     1073           define variable v-help-old-y    as decimal       no-undo .
     1074           define variable v-help-old-size as decimal       no-undo .
     1075           define variable v-frame-width   as decimal       no-undo .
     1076           define variable jj              as integer       no-undo .
     1077           do
     1078               on error undo, return error
     1079               :
     1080               assign
     1081                   v-frame-width = frame Dialog-Frame:width - 0.3
     1082                   fh            = frame Dialog-Frame:first-child
     1083                   hh            = fh:first-child
     1084                   ii            = 1
     1085                   .
     1086               do while valid-handle(hh):
     1087                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1088                   do:
     1089                       case lc(hh:name) :
     1090                           when "b-help" then
     1091                               do:
     1092                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1093                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1094                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1095                                   hh:TOOLTIP = "Помощь" .
     1096                                   v-help-old-x = hh:column .
     1097                                   v-help-old-y = hh:row    .
     1098                                   v-help-old-size = hh:width .
     1099                                   hh:width-chars = 2.5 .
     1100                               end.
     1101                           when "b-print" then
     1102                               do:
     1103                                   hh:load-image("cmp/b-print.bmp":u) .
     1104                                   hh:TOOLTIP = "Печать" .
     1105                                   v-h[ii] = hh:handle .
     1106                                   ii = ii + 1 .
     1107                                   hh:width-chars = 3 .
     1108                               end.
     1109                           when "b-history" or
     1110                           when "b-hist" then
     1111                               do:
     1112                                   hh:load-image("cmp/b-hist.bmp":u) .
     1113                                   hh:TOOLTIP = "История" .
     1114                                   v-h[ii] = hh:handle .
     1115                                   ii = ii + 1 .
     1116                                   hh:width-chars = 3 .
     1117                               end.
     1118                           when "b-sch" then
     1119                               do:
     1120                                   hh:load-image("cmp/b-sch.bmp":u) .
     1121                                   hh:TOOLTIP = "Установка Фильтра" .
     1122                                   v-h[ii] = hh:handle .
     1123                                   ii = ii + 1 .
     1124                                   hh:width-chars = 3 .
     1125                               end.
     1126                           when "b-hist-user" then
     1127                               do:
     1128                                   hh:load-image("cmp/b-hist.bmp":u) .
     1129                                   hh:TOOLTIP = "История пользователя" .
     1130                                   ii = ii + 1 .
     1131                               end.
     1132                       end case.
     1133                   end.
     1134                   hh = hh:next-sibling.
     1135               end.
     1136               b-help:column = v-frame-width - b-help:width-chars.
     1137               jj = 0.
     1138               repeat ii = 4 to 1 by -1 :
     1139                   if valid-handle (v-h[ii] ) then
     1140                   do:
     1141                       jj  = jj + 1 .
     1142                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1143                       v-h[ii]:row    = v-help-old-y .
     1144                   end.
     1145               end.
     1146           end.
     1147       end.
     1148   end procedure.
     1149   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1150   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1151   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1152   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1153   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1154   define variable v-diasize-current-frame-height as decimal   no-undo .
     1155   define variable v-diasize-change-size          as logical   no-undo .
     1156   define variable v-diasize-resize-button        as handle    no-undo .
     1157   define variable v-diasize-wndmax               as logical   no-undo .
     1158   define variable v-diasize-wndstore             as logical   no-undo .
     1159   define variable v-diasize-proc-name            as character no-undo .
     1160   define variable v-diasize-browse-handle        as handle    no-undo .
     1161   define variable v-diasize-browse-number        as integer   no-undo .
     1162   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1163   define temp-table temp-diasize-handle no-undo
     1164     field handle-value  as handle
     1165     field save-position as decimal
     1166     index xpk is primary unique handle-value
     1167     .
     1168   define temp-table temp-browse-handle no-undo
     1169     field browse-type   as character
     1170     field browse-number as integer
     1171     field browse-handle as handle
     1172     field original-size as decimal
     1173     index xpk is primary unique browse-type browse-number
     1174     index xie browse-type browse-handle
     1175   .
     1176   procedure diasize_change-height :
     1177     define input  parameter p-change-value  as decimal   no-undo .
     1178     define input  parameter p-move-resize   as logical   no-undo .
     1179     define variable v-field-group-handle    as handle    no-undo .
     1180     define variable v-object-handle         as handle    no-undo .
     1181     define variable v-frame-height          as decimal   no-undo .
     1182     define variable v-frame-virtual-height  as decimal   no-undo .
     1183     define variable v-browse-height         as decimal   no-undo .
     1184     define variable v-window-height         as decimal   no-undo .
     1185     define variable v-window-virtual-height as decimal   no-undo .
     1186     define variable v-change-sign           as integer   no-undo .
     1187     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1188     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1189     if p-change-value > 0
     1190     then do:
     1191       if frame Dialog-Frame :height + p-change-value
     1192           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1193       then do:
     1194         assign
     1195           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1196                           - (frame Dialog-Frame :height-chars)
     1197         .
     1198         if p-change-value <= 0
     1199         then do:
     1200           run diasize_position-resize-button in this-procedure .
     1201           return .
     1202         end.
     1203       end.
     1204     end.
     1205     if p-change-value < 0
     1206     then do:
     1207       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1208       then do:
     1209         assign
     1210           p-change-value = v-diasize-orig-frame-height
     1211                          - (frame Dialog-Frame :height-chars)
     1212         .
     1213         if p-change-value >= 0
     1214         then do:
     1215           run diasize_position-resize-button in this-procedure .
     1216           return .
     1217         end.
     1218       end.
     1219     end.
     1220     if p-change-value >= 0
     1221     then do:
     1222       assign
     1223         v-change-sign = 1
     1224       .
     1225     end.
     1226     else do:
     1227       assign
     1228         v-change-sign = -1
     1229       .
     1230     end.
     1231     assign
     1232       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1233     .
     1234     if p-change-value = 0
     1235     then do:
     1236       run diasize_position-resize-button in this-procedure .
     1237       return .
     1238     end.
     1239     move_block:
     1240     do
     1241     on error undo move_block, retry move_block
     1242     :
     1243       if retry
     1244       then do:
     1245         do
     1246         on error undo move_block, leave move_block
     1247         :
     1248           if p-change-value > 0
     1249           then do:
     1250             for each buf_temp-diasize-handle
     1251             on error undo, next
     1252             :
     1253               assign
     1254                 v-object-handle = buf_temp-diasize-handle.handle-value
     1255               .
     1256               if v-object-handle <> v-diasize-resize-button
     1257               then do:
     1258                 assign
     1259                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1260                 .
     1261               end.
     1262             end.
     1263             assign
     1264               v-diasize-browse-handle :height = v-browse-height
     1265             .
     1266             for each buf_temp-browse-handle
     1267               where buf_temp-browse-handle.browse-type = 'height':u
     1268             on error undo, next
     1269             :
     1270               assign
     1271                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1272               .
     1273             end.
     1274             assign
     1275               frame Dialog-Frame :height = v-frame-height
     1276             .
     1277             if frame Dialog-Frame :scrollable = true
     1278             then do:
     1279               assign
     1280                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1281               .
     1282             end.
     1283             run diasize_position-resize-button in this-procedure .
     1284           end.
     1285           else do:
     1286             if frame Dialog-Frame :scrollable = true
     1287             then do:
     1288               assign
     1289                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1290               .
     1291             end.
     1292             assign
     1293               frame Dialog-Frame :height = v-frame-height
     1294             .
     1295             assign
     1296               v-diasize-browse-handle :height = v-browse-height
     1297             .
     1298             for each buf_temp-browse-handle
     1299               where buf_temp-browse-handle.browse-type = 'height':u
     1300             on error undo, next
     1301             :
     1302               assign
     1303                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1304               .
     1305             end.
     1306             for each buf_temp-diasize-handle
     1307             on error undo, next
     1308             :
     1309               assign
     1310                 v-object-handle = buf_temp-diasize-handle.handle-value
     1311               .
     1312               if v-object-handle <> v-diasize-resize-button
     1313               then do:
     1314                 assign
     1315                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1316                 .
     1317               end.
     1318             end.
     1319             run diasize_position-resize-button in this-procedure .
     1320           end.
     1321           assign
     1322             v-diasize-change-size = false
     1323           .
     1324           leave move_block .
     1325         end.
     1326       end.
     1327       assign
     1328         v-diasize-need-full-display = true
     1329       .
     1330       if v-diasize-change-size = false
     1331       then do:
     1332         assign
     1333           v-diasize-change-size = true
     1334         .
     1335       end.
     1336       else do:
     1337         return .
     1338       end.
     1339       assign
     1340         v-frame-height = frame Dialog-Frame :height
     1341         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1342         v-browse-height = v-diasize-browse-handle :height
     1343       .
     1344       for each buf_temp-browse-handle
     1345         where buf_temp-browse-handle.browse-type = 'height':u
     1346       :
     1347         assign
     1348           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1349         .
     1350       end.
     1351       for each buf_temp-diasize-handle
     1352       :
     1353         delete buf_temp-diasize-handle .
     1354       end.
     1355       assign
     1356         v-field-group-handle = frame Dialog-Frame :first-child
     1357       .
     1358       do while valid-handle(v-field-group-handle)
     1359       :
     1360         assign
     1361           v-object-handle = v-field-group-handle :first-child
     1362         .
     1363         do while valid-handle(v-object-handle)
     1364         :
     1365           if  v-object-handle <> v-diasize-browse-handle :handle
     1366           and can-query(v-object-handle, "row")
     1367           and can-query(v-object-handle, "height")
     1368           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1369           then do:
     1370             find first buf_temp-browse-handle
     1371               where buf_temp-browse-handle.browse-type   = 'height':u
     1372                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1373               no-error .
     1374             if available buf_temp-browse-handle
     1375             then do:
     1376             end.
     1377             else do:
     1378               create buf_temp-diasize-handle .
     1379               assign
     1380                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1381                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1382               .
     1383             end.
     1384           end.
     1385           assign
     1386             v-object-handle = v-object-handle :next-sibling
     1387           .
     1388         end.
     1389         assign
     1390           v-field-group-handle = v-field-group-handle :next-sibling
     1391         .
     1392       end.
     1393       do with frame Dialog-Frame
     1394       :
     1395         hide v-diasize-resize-button .
     1396         assign
     1397           v-diasize-resize-button :row    = 1
     1398           v-diasize-resize-button :column = 1
     1399         .
     1400       end.
     1401       if p-change-value > 0
     1402       then do:
     1403         if frame Dialog-Frame :scrollable = true
     1404         then do:
     1405           assign
     1406             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1407             no-error .
     1408           if error-status :error
     1409           or error-status :get-message(1) <> ""
     1410           then do:
     1411             undo move_block, retry move_block .
     1412           end.
     1413         end.
     1414         assign
     1415           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1416           no-error .
     1417         if error-status :error
     1418         or error-status :get-message(1) <> ""
     1419         then do:
     1420           undo move_block, retry move_block .
     1421         end.
     1422         assign
     1423           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1424           no-error .
     1425         if error-status :error
     1426         or error-status :get-message(1) <> ""
     1427         then do:
     1428           undo move_block, retry move_block .
     1429         end.
     1430         for each buf_temp-browse-handle
     1431           where buf_temp-browse-handle.browse-type = 'height':u
     1432         on error undo move_block, retry move_block
     1433         :
     1434           assign
     1435             buf_temp-browse-handle.browse-handle :height
     1436               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1437             no-error .
     1438           if error-status :error
     1439           or error-status :get-message(1) <> ""
     1440           then do:
     1441             undo move_block, retry move_block .
     1442           end.
     1443         end.
     1444         for each buf_temp-diasize-handle
     1445         on error undo move_block, retry move_block
     1446         :
     1447           assign
     1448             v-object-handle = buf_temp-diasize-handle.handle-value
     1449           .
     1450           if v-object-handle <> v-diasize-resize-button
     1451           then do:
     1452             assign
     1453               v-object-handle :row = v-object-handle :row + p-change-value
     1454               no-error .
     1455             if error-status :error
     1456             or error-status :get-message(1) <> ""
     1457             then do:
     1458               undo move_block, retry move_block .
     1459             end.
     1460           end.
     1461         end.
     1462       end.
     1463       else do:
     1464         for each buf_temp-diasize-handle
     1465         on error undo move_block, retry move_block
     1466         :
     1467           assign
     1468             v-object-handle = buf_temp-diasize-handle.handle-value
     1469           .
     1470           if v-object-handle <> v-diasize-resize-button
     1471           then do:
     1472             assign
     1473               v-object-handle :row = v-object-handle :row + p-change-value
     1474               no-error .
     1475             if error-status :error
     1476             or error-status :get-message(1) <> ""
     1477             then do:
     1478               undo move_block, retry move_block .
     1479             end.
     1480           end.
     1481         end.
     1482         assign
     1483           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1484           no-error .
     1485         if error-status :error
     1486         or error-status :get-message(1) <> ""
     1487         then do:
     1488           undo move_block, retry move_block .
     1489         end.
     1490         for each buf_temp-browse-handle
     1491           where buf_temp-browse-handle.browse-type = 'height':u
     1492         on error undo move_block, retry move_block
     1493         :
     1494           assign
     1495             buf_temp-browse-handle.browse-handle :height
     1496               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1497             no-error .
     1498           if error-status :error
     1499           or error-status :get-message(1) <> ""
     1500           then do:
     1501             undo move_block, retry move_block .
     1502           end.
     1503         end.
     1504         assign
     1505           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1506           no-error .
     1507         if error-status :error
     1508         or error-status :get-message(1) <> ""
     1509         then do:
     1510           undo move_block, retry move_block .
     1511         end.
     1512         if frame Dialog-Frame :scrollable = true
     1513         then do:
     1514           assign
     1515             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1516             no-error .
     1517           if error-status :error
     1518           or error-status :get-message(1) <> ""
     1519           then do:
     1520             undo move_block, retry move_block .
     1521           end.
     1522         end.
     1523       end.
     1524       if p-move-resize = true
     1525       then do:
     1526         run diasize_position-resize-button in this-procedure .
     1527       end.
     1528       if v-diasize-wndstore = true
     1529       then do:
     1530         if connected("ub") = true
     1531         then do:
     1532           define variable v-cntxt-db-num        as integer   no-undo .
     1533           define variable v-cntxt-userid        as character no-undo .
     1534           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1535                                             , OUTPUT v-cntxt-userid
     1536                                             ) .
     1537           run gbl/wndsizew.p
     1538             (input  v-cntxt-db-num
     1539             ,input  v-cntxt-userid
     1540             ,input  v-diasize-proc-name
     1541             ,input  'height':u
     1542             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1543             ) .
     1544         end.
     1545       end.
     1546     end.
     1547     assign
     1548       v-diasize-change-size = false
     1549     .
     1550   end procedure.
     1551   procedure diasize_set-height :
     1552     define input  parameter p-new-height  as decimal   no-undo .
     1553     define input  parameter p-move-resize as logical   no-undo .
     1554     do
     1555     on error undo, return error return-value
     1556     :
     1557       run diasize_change-height in this-procedure
     1558         (input  (p-new-height - frame Dialog-Frame :height)
     1559         ,input  p-move-resize
     1560         ) .
     1561     end.
     1562   end procedure.
     1563   procedure diasize_change-width :
     1564     define input  parameter p-change-value as decimal   no-undo .
     1565     define input  parameter p-move-resize  as logical   no-undo .
     1566     define variable v-field-group-handle   as handle    no-undo .
     1567     define variable v-object-handle        as handle    no-undo .
     1568     define variable v-frame-width          as decimal   no-undo .
     1569     define variable v-frame-virtual-width  as decimal   no-undo .
     1570     define variable v-browse-width         as decimal   no-undo .
     1571     define variable v-window-width         as decimal   no-undo .
     1572     define variable v-window-virtual-width as decimal   no-undo .
     1573     define variable v-change-sign          as integer   no-undo .
     1574     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1575     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1576     if p-change-value > 0
     1577     then do:
     1578       if frame Dialog-Frame :width + p-change-value >
     1579           session :width-chars
     1580       then do:
     1581         assign
     1582           p-change-value = session :width-chars - frame Dialog-Frame :width
     1583         .
     1584         if p-change-value <= 0
     1585         then do:
     1586           run diasize_position-resize-button in this-procedure .
     1587           return .
     1588         end.
     1589       end.
     1590     end.
     1591     if p-change-value < 0
     1592     then do:
     1593       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1594       then do:
     1595         assign
     1596           p-change-value = v-diasize-orig-frame-width
     1597                          - frame Dialog-Frame :width
     1598         .
     1599         if p-change-value >= 0
     1600         then do:
     1601           run diasize_position-resize-button in this-procedure .
     1602           return .
     1603         end.
     1604       end.
     1605     end.
     1606     if p-change-value >= 0
     1607     then do:
     1608       assign
     1609         v-change-sign = 1
     1610       .
     1611     end.
     1612     else do:
     1613       assign
     1614         v-change-sign = -1
     1615       .
     1616     end.
     1617     assign
     1618       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1619     .
     1620     if p-change-value = 0
     1621     then do:
     1622       run diasize_position-resize-button in this-procedure .
     1623       return .
     1624     end.
     1625     move_block:
     1626     do
     1627     on error undo move_block, leave move_block
     1628     :
     1629       if retry
     1630       then do:
     1631         do
     1632         on error undo move_block, leave move_block
     1633         :
     1634           if p-change-value > 0
     1635           then do:
     1636             for each buf_temp-diasize-handle
     1637             on error undo, next
     1638             :
     1639               assign
     1640                 v-object-handle = buf_temp-diasize-handle.handle-value
     1641               .
     1642               if v-object-handle <> v-diasize-resize-button
     1643               then do:
     1644                 assign
     1645                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1646                 .
     1647               end.
     1648             end.
     1649             assign
     1650               v-diasize-browse-handle :width = v-browse-width
     1651             .
     1652             for each buf_temp-browse-handle
     1653               where buf_temp-browse-handle.browse-type = 'width':u
     1654             on error undo, next
     1655             :
     1656               assign
     1657                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1658               .
     1659             end.
     1660             assign
     1661               frame Dialog-Frame :width = v-frame-width
     1662             .
     1663             if frame Dialog-Frame :scrollable = true
     1664             then do:
     1665               assign
     1666                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1667               .
     1668             end.
     1669             run diasize_position-resize-button in this-procedure .
     1670           end.
     1671           else do:
     1672             if frame Dialog-Frame :scrollable = true
     1673             then do:
     1674               assign
     1675                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1676               .
     1677             end.
     1678             assign
     1679               frame Dialog-Frame :width = v-frame-width
     1680             .
     1681             for each buf_temp-browse-handle
     1682               where buf_temp-browse-handle.browse-type = 'width':u
     1683             on error undo, next
     1684             :
     1685               assign
     1686                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1687               .
     1688             end.
     1689             assign
     1690               v-diasize-browse-handle :width = v-browse-width
     1691             .
     1692             for each buf_temp-diasize-handle
     1693             on error undo, next
     1694             :
     1695               assign
     1696                 v-object-handle = buf_temp-diasize-handle.handle-value
     1697               .
     1698               if v-object-handle <> v-diasize-resize-button
     1699               then do:
     1700                 assign
     1701                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1702                 .
     1703               end.
     1704             end.
     1705             run diasize_position-resize-button in this-procedure .
     1706           end.
     1707           assign
     1708             v-diasize-change-size = false
     1709           .
     1710           leave move_block .
     1711         end.
     1712       end.
     1713       assign
     1714         v-diasize-need-full-display = true
     1715       .
     1716       if v-diasize-change-size = false
     1717       then do:
     1718         assign
     1719           v-diasize-change-size = true
     1720         .
     1721       end.
     1722       else do:
     1723         return .
     1724       end.
     1725       assign
     1726         v-frame-width = frame Dialog-Frame :width
     1727         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1728         v-browse-width = v-diasize-browse-handle :width
     1729       .
     1730       for each buf_temp-browse-handle
     1731         where buf_temp-browse-handle.browse-type = 'width':u
     1732       :
     1733         assign
     1734           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1735         .
     1736       end.
     1737       for each buf_temp-diasize-handle
     1738       :
     1739         delete buf_temp-diasize-handle .
     1740       end.
     1741       assign
     1742         v-field-group-handle = frame Dialog-Frame :first-child
     1743       .
     1744       do while valid-handle(v-field-group-handle)
     1745       :
     1746         assign
     1747           v-object-handle = v-field-group-handle :first-child
     1748         .
     1749         do while valid-handle(v-object-handle)
     1750         :
     1751           if  v-object-handle <> v-diasize-browse-handle :handle
     1752           and v-object-handle <> v-diasize-resize-button
     1753           and can-query(v-object-handle, "row")
     1754           and can-query(v-object-handle, "height")
     1755           and ( v-object-handle :col + v-object-handle :width
     1756                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1757               )
     1758           then do:
     1759             find first buf_temp-browse-handle
     1760               where buf_temp-browse-handle.browse-type   = 'width':u
     1761                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1762               no-error .
     1763             if available buf_temp-browse-handle
     1764             then do:
     1765             end.
     1766             else do:
     1767               create buf_temp-diasize-handle .
     1768               assign
     1769                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1770                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1771               .
     1772             end.
     1773           end.
     1774           assign
     1775             v-object-handle = v-object-handle :next-sibling
     1776           .
     1777         end.
     1778         assign
     1779           v-field-group-handle = v-field-group-handle :next-sibling
     1780         .
     1781       end.
     1782       do with frame Dialog-Frame
     1783       :
     1784         hide v-diasize-resize-button .
     1785         v-diasize-resize-button :row = 1.
     1786         v-diasize-resize-button :column = 1.
     1787       end.
     1788       if p-change-value > 0
     1789       then do:
     1790         if frame Dialog-Frame :scrollable = true
     1791         then do:
     1792           assign
     1793             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1794             no-error .
     1795           if error-status :error
     1796           or error-status :get-message(1) <> ""
     1797           then do:
     1798             undo move_block, retry move_block.
     1799           end.
     1800         end.
     1801         assign
     1802           frame Dialog-Frame :width = v-frame-width + p-change-value
     1803           no-error .
     1804         if error-status :error
     1805         or error-status :get-message(1) <> ""
     1806         then do:
     1807           undo move_block, retry move_block.
     1808         end.
     1809         assign
     1810           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1811         no-error .
     1812         if error-status :error
     1813         or error-status :get-message(1) <> ""
     1814         then do:
     1815           undo move_block, retry move_block.
     1816         end.
     1817         for each buf_temp-browse-handle
     1818           where buf_temp-browse-handle.browse-type = 'width':u
     1819         on error undo move_block, retry move_block
     1820         :
     1821           assign
     1822             buf_temp-browse-handle.browse-handle :width
     1823               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1824             no-error .
     1825           if error-status :error
     1826           or error-status :get-message(1) <> ""
     1827           then do:
     1828             undo move_block, retry move_block .
     1829           end.
     1830         end.
     1831         for each buf_temp-diasize-handle
     1832         on error undo move_block, retry move_block
     1833         :
     1834           assign
     1835             v-object-handle = buf_temp-diasize-handle.handle-value
     1836           .
     1837           if v-object-handle <> v-diasize-resize-button
     1838           then do:
     1839             assign
     1840               v-object-handle :col = v-object-handle :col + p-change-value
     1841               no-error .
     1842             if error-status :error
     1843             or error-status :get-message(1) <> ""
     1844             then do:
     1845               undo move_block, retry move_block .
     1846             end.
     1847           end.
     1848         end.
     1849       end.
     1850       else do:
     1851         for each buf_temp-diasize-handle
     1852         on error undo move_block, retry move_block
     1853         :
     1854           assign
     1855             v-object-handle = buf_temp-diasize-handle.handle-value
     1856           .
     1857           if v-object-handle <> v-diasize-resize-button
     1858           then do:
     1859             assign
     1860               v-object-handle :col = v-object-handle :col + p-change-value
     1861               no-error .
     1862             if error-status :error
     1863             or error-status :get-message(1) <> ""
     1864             then do:
     1865               undo move_block, retry move_block .
     1866             end.
     1867           end.
     1868         end.
     1869         for each buf_temp-browse-handle
     1870           where buf_temp-browse-handle.browse-type = 'width':u
     1871         on error undo move_block, retry move_block
     1872         :
     1873           assign
     1874             buf_temp-browse-handle.browse-handle :width
     1875               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1876             no-error .
     1877           if error-status :error
     1878           or error-status :get-message(1) <> ""
     1879           then do:
     1880             undo move_block, retry move_block .
     1881           end.
     1882         end.
     1883         assign
     1884           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1885           no-error .
     1886         if error-status :error
     1887         or error-status :get-message(1) <> ""
     1888         then do:
     1889           undo move_block, retry move_block.
     1890         end.
     1891         assign
     1892           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1893         no-error .
     1894         if error-status :error
     1895         or error-status :get-message(1) <> ""
     1896         then do:
     1897           undo move_block, retry move_block.
     1898         end.
     1899         if frame Dialog-Frame :scrollable = true
     1900         then do:
     1901           assign
     1902             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1903           no-error .
     1904           if error-status :error
     1905           or error-status :get-message(1) <> ""
     1906           then do:
     1907             undo move_block, retry move_block.
     1908           end.
     1909         end.
     1910       end.
     1911       if p-move-resize
     1912       then do:
     1913         run diasize_position-resize-button in this-procedure .
     1914       end.
     1915       if v-diasize-wndstore = true
     1916       then do:
     1917         if connected("ub") = true
     1918         then do:
     1919           define variable v-cntxt-db-num        as integer   no-undo .
     1920           define variable v-cntxt-userid        as character no-undo .
     1921           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1922                                             , OUTPUT v-cntxt-userid
     1923                                             ) .
     1924           run gbl/wndsizew.p
     1925             (input  v-cntxt-db-num
     1926             ,input  v-cntxt-userid
     1927             ,input  v-diasize-proc-name
     1928             ,input  'width':u
     1929             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1930             ) .
     1931         end.
     1932       end.
     1933     end.
     1934     assign
     1935       v-diasize-change-size = false
     1936     .
     1937   end procedure.
     1938   procedure diasize_set-width :
     1939     define input  parameter p-new-width  as decimal   no-undo .
     1940     define input  parameter p-move-resize as logical   no-undo .
     1941     do
     1942     on error undo, return error return-value
     1943     :
     1944       run diasize_change-width in this-procedure
     1945         (input  (p-new-width - frame Dialog-Frame :width)
     1946         ,input  p-move-resize
     1947         ) .
     1948     end.
     1949   end procedure.
     1950   procedure diasize_position-resize-button :
     1951     do with frame Dialog-Frame
     1952     :
     1953       hide v-diasize-resize-button .
     1954       assign
     1955         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1956                     - 1
     1957                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1958         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1959                     - 1
     1960                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1961       .
     1962       view v-diasize-resize-button .
     1963     end.
     1964   end procedure.
     1965   on alt-right anywhere
     1966   do:
     1967     run diasize_change-width in this-procedure
     1968       (input 1
     1969       ,input true
     1970       ) .
     1971     return no-apply .
     1972   end.
     1973   on alt-left anywhere
     1974   do:
     1975     run diasize_change-width in this-procedure
     1976       (input -1
     1977       ,input true
     1978       ) .
     1979     return no-apply .
     1980   end.
     1981   on alt-down anywhere
     1982   do:
     1983     run diasize_change-height in this-procedure
     1984       (input 1
     1985       ,input true
     1986       ) .
     1987     return no-apply .
     1988   end.
     1989   on alt-up anywhere
     1990   do:
     1991     run diasize_change-height in this-procedure
     1992       (input -1
     1993       ,input true
     1994       ) .
     1995     return no-apply .
     1996   end.
     1997   on alt-enter of frame Dialog-Frame
     1998   do:
     1999     run diasize_maximize in this-procedure
     2000       (input  ?
     2001       ).
     2002     return no-apply .
     2003   end.
     2004   procedure diasize_end-move :
     2005     do
     2006     on error undo, return error return-value
     2007     :
     2008       define variable v-row-delta as decimal   no-undo .
     2009       define variable v-col-delta as decimal   no-undo .
     2010       define variable v-new-row as decimal   no-undo .
     2011       define variable v-new-col as decimal   no-undo .
     2012       assign
     2013         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2014         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2015       .
     2016       assign
     2017         v-row-delta = v-new-row - frame Dialog-Frame :height
     2018         v-col-delta = v-new-col - frame Dialog-Frame :width
     2019       .
     2020       run diasize_change-height in this-procedure
     2021         (input v-row-delta
     2022         ,input true
     2023         ) .
     2024       run diasize_change-width in this-procedure
     2025         (input v-col-delta
     2026         ,input true
     2027         ) .
     2028     end.
     2029   end procedure.
     2030   procedure diasize_maximize :
     2031     define input  parameter p-action as logical   no-undo .
     2032     do
     2033     on error undo, return error return-value
     2034     :
     2035       if p-action = ?
     2036       then do:
     2037         if v-diasize-need-maximize = true
     2038         then do:
     2039           assign
     2040             p-action = true
     2041           .
     2042         end.
     2043         else do:
     2044           assign
     2045             p-action = false
     2046           .
     2047         end.
     2048       end.
     2049       if p-action = true
     2050       then do:
     2051         run diasize_change-height in this-procedure
     2052           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2053               - frame Dialog-Frame :height-chars
     2054           ,input true
     2055           ) .
     2056         run diasize_change-width in this-procedure
     2057           (input session :width-chars
     2058               - frame Dialog-Frame :width-chars
     2059           ,input true
     2060           ) .
     2061         assign
     2062           v-diasize-need-maximize = false
     2063         .
     2064       end.
     2065       else do:
     2066         run diasize_change-width in this-procedure
     2067           (input v-diasize-orig-frame-width
     2068               - frame Dialog-Frame :width-chars
     2069           ,input true
     2070           ) .
     2071         run diasize_change-height in this-procedure
     2072           (input v-diasize-orig-frame-height
     2073               - frame Dialog-Frame :height-chars
     2074           ,input true
     2075           ) .
     2076         assign
     2077           v-diasize-need-maximize = true
     2078         .
     2079       end.
     2080     end.
     2081   end procedure.
     2082   procedure diasize_restore-orig-size :
     2083     do
     2084     on error undo, return error return-value
     2085     :
     2086       assign
     2087         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2088         v-diasize-current-frame-height = frame Dialog-Frame :height
     2089       .
     2090       run diasize_set-height in this-procedure
     2091         (input  v-diasize-orig-frame-height
     2092         ,input  true
     2093         ) .
     2094       run diasize_set-width in this-procedure
     2095         (input  v-diasize-orig-frame-width
     2096         ,input  true
     2097         ) .
     2098     end.
     2099   end procedure.
     2100   procedure diasize_restore-current-size :
     2101     do
     2102     on error undo, return error return-value
     2103     :
     2104       run diasize_set-height in this-procedure
     2105         (input  v-diasize-current-frame-height
     2106         ,input  true
     2107         ) .
     2108       run diasize_set-width in this-procedure
     2109         (input  v-diasize-current-frame-width
     2110         ,input  true
     2111         ) .
     2112     end.
     2113   end procedure.
     2114   procedure diasize_set-browse-handle :
     2115     define input  parameter p-browse-handle as handle   no-undo .
     2116     define buffer buf_temp-browse-handle for temp-browse-handle .
     2117     do
     2118     on error undo, return error return-value
     2119     :
     2120       assign
     2121         v-diasize-browse-handle = p-browse-handle
     2122       .
     2123       for each buf_temp-browse-handle
     2124       on error undo, return error return-value
     2125       :
     2126         delete buf_temp-browse-handle .
     2127       end.
     2128     end.
     2129   end procedure.
     2130   procedure diasize_add_browse :
     2131     define input  parameter p-browse-type   as character no-undo .
     2132     define input  parameter p-browse-handle as handle    no-undo .
     2133     define buffer buf_temp-browse-handle for temp-browse-handle .
     2134     do
     2135     on error undo, return error return-value
     2136     :
     2137       assign
     2138         v-diasize-browse-number = v-diasize-browse-number + 1
     2139       .
     2140       create buf_temp-browse-handle .
     2141       assign
     2142         buf_temp-browse-handle.browse-type   = p-browse-type
     2143         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2144         buf_temp-browse-handle.browse-handle = p-browse-handle
     2145       .
     2146     end.
     2147   end procedure.
     2148   procedure diasize_init :
     2149     define variable v-default-value    as logical   no-undo .
     2150     define variable v-restore-saved    as logical   no-undo .
     2151     define variable v-resize-value-str as character no-undo .
     2152     do
     2153     on error undo, return error return-value
     2154     :
     2155       do with frame Dialog-Frame
     2156       :
     2157         assign
     2158           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2159           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2160           v-diasize-browse-handle     = browse BROWSE-1 :handle
     2161         .
     2162         create button v-diasize-resize-button
     2163         assign
     2164           parent        = frame Dialog-Frame :first-child
     2165           label         = "s"
     2166           height-pixels = 16
     2167           width-pixels  = 16
     2168           visible       = true
     2169           sensitive     = true
     2170           movable       = true
     2171           triggers:
     2172             on end-move persistent run diasize_end-move in this-procedure .
     2173           end triggers.
     2174         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2175         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2176         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2177         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2178         assign
     2179           v-diasize-wndmax = false
     2180         .
     2181         if connected("ub") = true
     2182         then do:
     2183           define variable v-cntxt-db-num        as integer   no-undo .
     2184           define variable v-cntxt-userid        as character no-undo .
     2185           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2186                                             , OUTPUT v-cntxt-userid
     2187                                             ) .
     2188           run gbl/wndpar_r.p
     2189             (input  v-cntxt-db-num
     2190             ,input  v-cntxt-userid
     2191             ,input  'wndmax':U
     2192             ,output v-diasize-wndmax
     2193             ,output v-default-value
     2194             ) .
     2195         end.
     2196         assign
     2197           v-diasize-wndstore = false
     2198         .
     2199         if connected("ub") = true
     2200         then do:
     2201           run gbl/wndpar_r.p
     2202             (input  v-cntxt-db-num
     2203             ,input  v-cntxt-userid
     2204             ,input  'wndstore':U
     2205             ,output v-diasize-wndstore
     2206             ,output v-default-value
     2207             ) .
     2208         end.
     2209         assign
     2210           v-diasize-proc-name = entry(1, program-name(2), '.')
     2211         .
     2212         if v-diasize-wndstore = true
     2213         then do:
     2214           assign
     2215             v-restore-saved = false
     2216           .
     2217           if connected("ub") = true
     2218           then do:
     2219             run gbl/wndsizer.p
     2220               (input  v-cntxt-db-num
     2221               ,input  v-cntxt-userid
     2222               ,input  v-diasize-proc-name
     2223               ,input  'height':u
     2224               ,output v-resize-value-str
     2225               ) .
     2226             if v-resize-value-str <> '':U
     2227             then do:
     2228               run diasize_change-height in this-procedure
     2229                 (input  integer(v-resize-value-str)
     2230                 ,input  true
     2231                 ) .
     2232               assign
     2233                 v-restore-saved = true
     2234               .
     2235             end.
     2236           end.
     2237           if connected("ub") = true
     2238           then do:
     2239             run gbl/wndsizer.p
     2240               (input  v-cntxt-db-num
     2241               ,input  v-cntxt-userid
     2242               ,input  v-diasize-proc-name
     2243               ,input  'width':u
     2244               ,output v-resize-value-str
     2245               ) .
     2246             if v-resize-value-str <> '':U
     2247             then do:
     2248               run diasize_change-width in this-procedure
     2249                 (input  integer(v-resize-value-str)
     2250                 ,input  true
     2251                 ) .
     2252               assign
     2253                 v-restore-saved = true
     2254               .
     2255             end.
     2256           end.
     2257           if v-restore-saved <> true
     2258           then do:
     2259             if v-diasize-wndmax = true
     2260             then do:
     2261               run diasize_maximize in this-procedure
     2262                 (input  true
     2263                 ) .
     2264             end.
     2265           end.
     2266         end.
     2267         else do:
     2268           if v-diasize-wndmax = true
     2269           then do:
     2270             run diasize_maximize in this-procedure
     2271               (input  true
     2272               ) .
     2273           end.
     2274         end.
     2275       end.
     2276     end.
     2277   end procedure.
     2278   procedure diasize_need-full-display :
     2279     define output parameter p-need-full-display as logical   no-undo .
     2280     do
     2281     on error undo, return error return-value
     2282     :
     2283       assign
     2284         p-need-full-display = v-diasize-need-full-display
     2285       .
     2286       assign
     2287         v-diasize-need-full-display = false
     2288       .
     2289     end.
     2290   end procedure.
     2291   procedure get-context :
     2292      define output parameter p-db-num as integer          no-undo.
     2293      define output parameter p-user-id as character        no-undo.
     2294      define variable v-login               as character    no-undo.
     2295      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2296      define buffer buf_user-login  for ub.user-login .
     2297      do
     2298      on error undo, return error
     2299      :
     2300            FIND FIRST buf_sys-ctrl no-lock.
     2301            ASSIGN
     2302               v-login = USERID("ub")
     2303               p-db-num = buf_sys-ctrl.db-num
     2304            .
     2305            FIND FIRST buf_user-login
     2306                 WHERE buf_user-login.db-num = p-db-num
     2307                   AND buf_user-login.user-login = v-login
     2308                 no-lock
     2309                 no-error
     2310                 .
     2311            IF AVAILABLE buf_user-login
     2312            THEN DO:
     2313               assign
     2314                  p-user-id = buf_user-login.user-id
     2315               .
     2316            END.
     2317      end.
     2318   end procedure.
     2319       run diasize_init in this-procedure .
     2320   MAIN-BLOCK:
     2321   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2322      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2323       define variable v-ok as logical   no-undo .
     2324   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2325   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_grp-nabor in g#lib-trn3
     2326   ( input  p-bk-gds-code ,
     2327     output v-ok
     2328   )
     2329   .
     2330       if v-ok = false then do:
     2331         message "Это не набор !" view-as alert-box information .
     2332         return  .
     2333       end.
     2334     v-itogo-rubl:LABEL = "Итого (руб)" .
     2335     v-sum-with-disc-rubl:LABEL = "руб." .
     2336     run init-proc.
     2337     run enable_ui.
     2338     run re-disp.
     2339     if p-doc-mode =  'ПРОСМОТР':U then disable b-add b-chg b-del with frame Dialog-Frame .
     2340     wait-for go of frame Dialog-Frame.
     2341   end.
     2342   run disable_ui.
     2343   PROCEDURE disable_UI :
     2344     HIDE FRAME Dialog-Frame.
     2345   END PROCEDURE.
     2346   PROCEDURE enable_UI :
     2347     DISPLAY v-prim-str v-str v-pr-wrk v-itogo-base v-pr-sk v-itogo-rubl text-1
     2348             v-sum-with-disc-base v-sum-with-disc-rubl
     2349         WITH FRAME Dialog-Frame.
     2350     ENABLE B-exit B-add B-chg B-del B-Help BROWSE-1 v-prim-str v-str v-pr-wrk
     2351            v-itogo-base v-pr-sk v-itogo-rubl text-1 v-sum-with-disc-base
     2352            v-sum-with-disc-rubl
     2353         WITH FRAME Dialog-Frame.
     2354     VIEW FRAME Dialog-Frame.
     2355     OPEN QUERY BROWSE-1 FOR EACH tt-doc-line-attr NO-LOCK,       EACH ub.goods WHERE ub.goods.gds-code = tt-doc-line-attr.gds-code NO-LOCK,       EACH ub.gds-prt WHERE ub.gds-prt.node-code =  tt-doc-line-attr.node-code NO-LOCK INDEXED-REPOSITION.
     2356   END PROCEDURE.
     2357   PROCEDURE init-proc :
     2358   define buffer bk_goods for goods.
     2359   find first bk_goods where bk_goods.gds-code  = p-bk-gds-code   no-error .
     2360   if error-status :error then return error .
     2361   define buffer ready_trn-doc for trn-doc.
     2362   define buffer nakl_trn-doc for trn-doc.
     2363   define variable p-type     as character no-undo .
     2364   v-prim-str = "" .
     2365   v-pr-sk = t-doc.discnt-pc.
     2366   if t-doc.status_ = 'готов':U  or
     2367      t-doc.status_ = 'отказ':U
     2368     then do:
     2369       run lineattr-value   (
     2370           input  t-doc.doc-code ,
     2371           input  p-bk-gds-code ,
     2372           input  'flora_ps':U     ,
     2373           output v-prim-str    ,
     2374           output p-type     ).
     2375   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     2376                           input '5deliv':U ,
     2377                          output v-sum-deliv ,
     2378                          output p-type )  .
     2379   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     2380                           input '6sumwrk':U ,
     2381                          output v-pr-wrk ,
     2382                          output p-type )  .
     2383         find first nakl_trn-doc no-lock where nakl_trn-doc.out-code = t-doc.doc-code no-error .
     2384         if error-status :error then return error .
     2385         p-doc-code = nakl_trn-doc.doc-code .
     2386     end.
     2387     else do:
     2388       find first ready_trn-doc no-lock where ready_trn-doc.doc-code = t-doc.doc-code no-error .
     2389       if available ready_trn-doc then do:
     2390           run lineattr-value   (
     2391               input  ready_trn-doc.doc-code ,
     2392               input  p-bk-gds-code ,
     2393               input  'flora_ps':U     ,
     2394               output v-prim-str    ,
     2395               output p-type     ).
     2396   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ready_trn-doc.doc-code ,
     2397                           input '5deliv':U ,
     2398                          output v-sum-deliv ,
     2399                          output p-type )  .
     2400   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ready_trn-doc.doc-code ,
     2401                           input '6sumwrk':U ,
     2402                          output v-pr-wrk ,
     2403                          output p-type )  .
     2404      end.
     2405       p-doc-code =  t-doc.doc-code .
     2406     end.
     2407   display
     2408     v-prim-str
     2409     v-pr-wrk
     2410   with frame Dialog-Frame .
     2411   define variable v-ok as logical   no-undo .
     2412   define buffer prt_goods for goods.
     2413   define buffer b2_doc-line-attr for doc-line-attr.
     2414   for each gds-dtl no-lock  where gds-dtl.doc-code  = p-doc-code :
     2415     find first prt_goods no-lock where
     2416               prt_goods.artic     = gds-dtl.artic       and
     2417               prt_goods.prod-type = gds-dtl.prod-type   and
     2418               prt_goods.prod-code = gds-dtl.prod-code   no-error .
     2419      find first b2_doc-line-attr no-lock where b2_doc-line-attr.doc-code = p-doc-code         and
     2420                                                b2_doc-line-attr.gds-code = prt_goods.gds-code  and
     2421                                                num-entries(b2_doc-line-attr.attr-code) = 3    no-error .
     2422   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2423   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_grp-nabor in g#lib-trn3
     2424   ( input  prt_goods.gds-code ,
     2425     output v-ok
     2426   )
     2427   .
     2428       if v-ok = true then next.
     2429       create  temp-gds-dtl .
     2430       assign
     2431       temp-gds-dtl.node-code  = gds-dtl.prt-code
     2432       temp-gds-dtl.artic     = prt_goods.artic
     2433       temp-gds-dtl.prod-type = prt_goods.prod-type
     2434       temp-gds-dtl.prod-code = prt_goods.prod-code
     2435       temp-gds-dtl.gds-code  = prt_goods.gds-code
     2436       temp-gds-dtl.rel-bk    = if available b2_doc-line-attr then true else false
     2437       .
     2438   end.
     2439   v-str = bk_goods.artic + " " + bk_goods.gds-name .
     2440   define buffer buf_doc-line-attr for doc-line-attr.
     2441   define buffer buf_gds-dtl for gds-dtl.
     2442   define buffer buf_goods   for goods.
     2443           for each buf_doc-line-attr no-lock
     2444             where buf_doc-line-attr.doc-code  = p-doc-code
     2445               and lookup ('fl_gds-code':U , buf_doc-line-attr.attr-code ) > 0
     2446               and lookup (string(p-bk-gds-code)      , buf_doc-line-attr.attr-code ) > 0
     2447               :
     2448               if integer (entry( 3 , buf_doc-line-attr.attr-code)) <> p-bk-gds-code then next.
     2449                 find first buf_goods no-lock where buf_goods.gds-code = buf_doc-line-attr.gds-code no-error .
     2450                 find first  buf_gds-dtl no-lock where
     2451                             buf_gds-dtl.doc-code  = p-doc-code          and
     2452                             buf_gds-dtl.artic     = buf_goods.artic     and
     2453                             buf_gds-dtl.prod-type = buf_goods.prod-type and
     2454                             buf_gds-dtl.prod-code = buf_goods.prod-code and
     2455                             buf_gds-dtl.prt-code  = integer ( entry (2 , buf_doc-line-attr.attr-code))
     2456                             .
     2457                 if available buf_gds-dtl then do:
     2458                   create tt-doc-line-attr.
     2459                   BUFFER-COPY buf_doc-line-attr TO tt-doc-line-attr.
     2460                   assign
     2461                     tt-doc-line-attr.node-code  = integer ( entry (2 , buf_doc-line-attr.attr-code))
     2462                     tt-doc-line-attr.price-rubl = buf_gds-dtl.price-rubl
     2463                     tt-doc-line-attr.price-base = buf_gds-dtl.price-base
     2464                   .
     2465                   if t-doc.status_ = 'факт':U then
     2466                   assign
     2467                      tt-doc-line-attr.price-rubl = buf_gds-dtl.price-rubl  -    buf_gds-dtl.discnt-rubl
     2468                      tt-doc-line-attr.price-base = buf_gds-dtl.price-base  -    buf_gds-dtl.discnt-base
     2469                   .
     2470                 end.
     2471           end.
     2472   END PROCEDURE.
     2473   PROCEDURE re-disp :
     2474   assign
     2475     v-itogo-base = 0
     2476     v-itogo-rubl = 0
     2477   .
     2478      for each tt2-doc-line-attr :
     2479         assign
     2480           v-itogo-base = (tt2-doc-line-attr.price-base * dec(tt2-doc-line-attr.attr-value))  + v-itogo-base
     2481           v-itogo-rubl = (tt2-doc-line-attr.price-rubl * dec(tt2-doc-line-attr.attr-value))  + v-itogo-rubl
     2482       .
     2483      end.
     2484   define variable v-itogo-base2 as decimal   no-undo .
     2485   define variable v-itogo-rubl2 as decimal   no-undo .
     2486   v-itogo-base2 = v-itogo-base - (v-itogo-base * t-doc.discnt-pc / 100 ) .
     2487   v-itogo-rubl2 = v-itogo-rubl - (v-itogo-rubl * t-doc.discnt-pc / 100 ) .
     2488   IF t-doc.status_ = 'факт':U THEN DO:
     2489     v-sum-with-disc-base = v-itogo-base2 .
     2490     v-sum-with-disc-rubl = v-itogo-rubl2 .
     2491   END.
     2492   ELSE DO:
     2493     v-sum-with-disc-base = v-itogo-base2 +  (v-pr-wrk  ) * v-itogo-base2 / 100 .
     2494     v-sum-with-disc-rubl = v-itogo-rubl2 +  (v-pr-wrk  ) * v-itogo-rubl2 / 100 .
     2495   END.
     2496   display
     2497     v-prim-str
     2498     v-pr-wrk
     2499     v-sum-with-disc-rubl  when t-doc.status_ <> 'факт':U
     2500     v-sum-with-disc-base  when t-doc.status_ <> 'факт':U
     2501     v-itogo-base
     2502     v-itogo-rubl
     2503     v-pr-sk
     2504     WITH FRAME Dialog-Frame.
     2505     if  t-doc.status_ =  'факт':U then
     2506     hide v-sum-with-disc-rubl
     2507          v-sum-with-disc-base
     2508          text-1
     2509          in frame Dialog-Frame .
     2510   END PROCEDURE.
     2511   PROCEDURE save-proc :
     2512   do
     2513     on error undo, return error return-value
     2514     :
     2515   define variable v-ok as logical   no-undo .
     2516   define buffer buf_doc-line-attr for doc-line-attr.
     2517   if p-doc-mode = 'ПРОСМОТР':U then return .
     2518     for each buf_doc-line-attr exclusive-lock
     2519       where buf_doc-line-attr.doc-code  = p-doc-code
     2520         and lookup ('fl_gds-code':U , buf_doc-line-attr.attr-code ) > 0
     2521         and lookup (string(p-bk-gds-code)      , buf_doc-line-attr.attr-code ) > 0
     2522         :
     2523           if integer (entry( 3 , buf_doc-line-attr.attr-code)) <> p-bk-gds-code then next.
     2524           find first tt-doc-line-attr where
     2525                         tt-doc-line-attr.doc-code = buf_doc-line-attr.doc-code
     2526                     and tt-doc-line-attr.gds-code = buf_doc-line-attr.gds-code
     2527                     and tt-doc-line-attr.attr-code = buf_doc-line-attr.attr-code no-error .
     2528           if available tt-doc-line-attr then do:
     2529             if buf_doc-line-attr.attr-value <> tt-doc-line-attr.attr-value then
     2530             assign
     2531               buf_doc-line-attr.attr-value = tt-doc-line-attr.attr-value
     2532             .
     2533           end.
     2534           else do:
     2535             delete buf_doc-line-attr.
     2536           end.
     2537     end.
     2538   define variable v-qnty as decimal   no-undo .
     2539   define variable v-qnty-prt as decimal   no-undo .
     2540   define buffer buf_goods for goods.
     2541   define buffer buf2_goods for goods.
     2542   define buffer buf2_doc-line for doc-line.
     2543   define buffer ready_trn-doc for trn-doc.
     2544   define buffer nakl_trn-doc for trn-doc.
     2545   find first nakl_trn-doc  no-lock where nakl_trn-doc.doc-code  = p-doc-code no-error .
     2546   if nakl_trn-doc.status_ = 'запрос':U then return .
     2547   find first ready_trn-doc no-lock where ready_trn-doc.doc-code = nakl_trn-doc.out-code no-error .
     2548     if error-status :error
     2549     then do:
     2550       message
     2551         vss-workfile vss-revision vss-description skip
     2552         "Не найден документ-щепка в статусе ГОТОВ"
     2553         view-as alert-box error .
     2554       return error.
     2555     end.
     2556   for each gds-dtl exclusive-lock where gds-dtl.doc-code  = p-doc-code ,
     2557       first temp-gds-dtl where
     2558           temp-gds-dtl.artic     = gds-dtl.artic and
     2559           temp-gds-dtl.prod-type = gds-dtl.prod-type and
     2560           temp-gds-dtl.prod-code = gds-dtl.prod-code and
     2561           temp-gds-dtl.node-code = gds-dtl.prt-code and
     2562           temp-gds-dtl.rel-bk = true
     2563     :
     2564       v-qnty = 0 .
     2565       v-qnty-prt = 0 .
     2566       for each buf2_doc-line no-lock where buf2_doc-line.doc-code  = ready_trn-doc.doc-code :
     2567         find first buf2_goods no-lock where
     2568                   buf2_goods.artic     = buf2_doc-line.artic       and
     2569                   buf2_goods.prod-type = buf2_doc-line.prod-type   and
     2570                   buf2_goods.prod-code = buf2_doc-line.prod-code   no-error .
     2571   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2572   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_grp-nabor in g#lib-trn3
     2573   ( input  buf2_goods.gds-code ,
     2574     output v-ok
     2575   )
     2576   .
     2577           if v-ok then do:
     2578               run lineattr-value-flora-gds (
     2579                   input   p-doc-code       ,
     2580                   input   temp-gds-dtl.gds-code   ,
     2581                   input   gds-dtl.prt-code  ,
     2582                   input   buf2_goods.gds-code    ,
     2583                   input   'fl_gds-code':U        ,
     2584                   output  v-qnty       ).
     2585               v-qnty-prt = v-qnty-prt + v-qnty .
     2586            end.
     2587       end.
     2588       if v-qnty-prt <> gds-dtl.fact-qnty then do:
     2589          p-make = true .
     2590          find first doc-line exclusive-lock where
     2591                    doc-line.doc-code   = gds-dtl.doc-code  and
     2592                    doc-line.artic      = gds-dtl.artic     and
     2593                    doc-line.prod-type  = gds-dtl.prod-type and
     2594                    doc-line.prod-code  = gds-dtl.prod-code no-error .
     2595         if not t-doc.flag_ and t-doc.status_ <> 'разрешен':U then do:
     2596   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2597   assign
     2598     chg-qnty = v-qnty-prt - ub.gds-dtl.doc-qnty
     2599   .
     2600     run trg/rsrv-dtl.p
     2601       ( input        ParParentProc
     2602       , input        'reserv':U
     2603       , buffer       ub.gds-dtl
     2604       , input-output chg-qnty
     2605       , input-output ub.doc-line.price-base
     2606       , input-output ub.doc-line.price-rubl
     2607       , input        -1
     2608       , input         "" ) no-error .
     2609     if error-status :error
     2610     then do:
     2611       message
     2612         vss-workfile vss-revision vss-description skip
     2613         error-status :get-message(1) skip
     2614         return-value skip
     2615         "rsrv-dtl.p doc"
     2616         view-as alert-box error
     2617   .
     2618       undo, return error return-value .
     2619     end.
     2620     if lookup( t-doc.doc-type, 'рас,спи,возврат':U ) > 0 or
     2621        ( t-doc.doc-type = 'при':U and
     2622          t-doc.internal = yes )
     2623     then do:
     2624       assign
     2625         ub.doc-line.doc-qnty  = ub.doc-line.doc-qnty + chg-qnty
     2626         ub.doc-line.fact-qnty = ub.doc-line.doc-qnty
     2627       .
     2628       if ub.doc-line.doc-density <> ? and ub.doc-line.doc-density <> 0 then do:
     2629         assign
     2630           ub.doc-line.cli-qnty = ub.doc-line.doc-qnty * ub.doc-line.doc-density
     2631         .
     2632       end.
     2633       else do:
     2634         assign
     2635           ub.doc-line.cli-qnty = ub.doc-line.doc-qnty / ub.doc-line.cli-base-rate
     2636         .
     2637       end.
     2638     end.
     2639     assign
     2640       ub.gds-dtl.doc-qnty  = ub.gds-dtl.doc-qnty + chg-qnty
     2641       ub.gds-dtl.fact-qnty = ub.gds-dtl.doc-qnty
     2642     .
     2643            end.
     2644         else do:
     2645   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2646   assign
     2647     chg-qnty = v-qnty-prt - ub.gds-dtl.fact-qnty
     2648   .
     2649     run trg/rsrv-dtl.p
     2650       ( input        ParParentProc
     2651       , input        'reserv':U
     2652       , buffer       ub.gds-dtl
     2653       , input-output chg-qnty
     2654       , input-output ub.doc-line.price-base
     2655       , input-output ub.doc-line.price-rubl
     2656       , input        -1
     2657       , input         "" ) no-error .
     2658     if error-status :error
     2659     then do:
     2660       message
     2661         vss-workfile vss-revision vss-description skip
     2662         error-status :get-message(1) skip
     2663         return-value skip
     2664         "rsrv-dtl.p fact"
     2665         view-as alert-box error
     2666   .
     2667       undo, return error return-value .
     2668     end.
     2669     if lookup( t-doc.doc-type, 'рас,спи,возврат':U ) > 0 or
     2670        ( t-doc.doc-type = 'при':U and
     2671          t-doc.internal = yes )
     2672     then do:
     2673       assign
     2674         ub.doc-line.fact-qnty = ub.doc-line.fact-qnty + chg-qnty
     2675       .
     2676     end.
     2677     assign
     2678       ub.gds-dtl.fact-qnty = ub.gds-dtl.fact-qnty + chg-qnty
     2679     .
     2680         end.
     2681         find first buf2_goods no-lock where
     2682                   buf2_goods.artic     = doc-line.artic       and
     2683                   buf2_goods.prod-type = doc-line.prod-type   and
     2684                   buf2_goods.prod-code = doc-line.prod-code   no-error .
     2685         if gds-dtl.doc-qnty = 0 then do:
     2686              assign line-mode = 'ИЗМЕНЕНИЕ':U.
     2687               run str/out-add.p
     2688               (  parparentproc
     2689                , recid(t-doc)
     2690                , recid(doc-line)
     2691                , recid(gds-dtl)
     2692                , recid(buf2_goods)
     2693                , "delete"
     2694                , ? ).
     2695            end.
     2696       end.
     2697   end.
     2698   p-sum1 = v-sum-with-disc-rubl .
     2699   p-sum2 = v-sum-with-disc-base .
     2700   end.
     2701   end procedure.
