      652   define variable store-type   as character no-undo .
      653   define variable store-code   as integer   no-undo .
      654   define variable g#log      as logical   no-undo .
      655   define variable g#report-num as integer   no-undo .
      656   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      657     run mainmenu_getcntxt in parparentproc
      658       (output v-cntxt-db-num
      659       ,output v-cntxt-userid
      660       ,output v-cntxt-level
      661       ,output v-cntxt-host-code-obj
      662       ,output v-cntxt-obj-type
      663       ,output v-cntxt-obj-code
      664       ,output v-cntxt-db-num-obj
