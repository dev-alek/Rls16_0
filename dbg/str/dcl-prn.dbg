      802   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      803     (output var-report-r-b
      804     )  .
      805   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      806   define  stream PrnLibStream.
      807   procedure prn-lib-prn-file :
      808     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      809     define input parameter p-DIsabledoptions as integer no-undo .
      810     define variable v-report-name as character no-undo .
      811     define variable v-user-action as character no-undo .
      812     define variable v-printed     as logical   no-undo .
      813     define variable v-exist       as logical   no-undo .
      814     do
      815       on error undo, return error
      816       :
      817       run prn-lib-get-report-name  in this-procedure (
      818         input parParentProc
      819         ,output v-report-name
      820         ).
      821   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      822   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      823     (input  v-report-name
      824     ,input  2
      825     ,output v-exist
      826     )  .
      827       if NOT v-exist then
      828       DO:
      829         Message
      830           "Нет заданий на печать ! "
      831           view-as alert-box .
      832         Return  .
      833       End.
      834       run gbl/prnfilen.w
      835         (input  ""
      836         ,input  p-DisabledOptions
      837         ,input  string(v-report-name )
      838         ,input  7
      839         ,output v-user-action
      840         ,output v-printed
      841         ) .
      842       if v-printed then
      843       do:
      844         return "YES" .
      845       end.
      846       else
      847       do:
      848         return "NO" .
      849       end.
      850     end.
      851   end procedure.
      852   procedure prn-lib-open-stream :
      853     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      854     define input parameter p-page-size    as integer no-undo .
      855     define input parameter p-is-stream    as logical no-undo .
      856     define input parameter p-append       as logical no-undo .
      857     define variable v-report-name as character no-undo .
      858     do
      859       on error undo, return error
      860       :
      861       run prn-lib-get-report-name  in this-procedure (
      862         input parParentProc
      863         ,output v-report-name
      864         ).
      865       if p-is-stream then
      866       do:
      867         if p-append then
      868         do:
      869           output stream PrnLibStream to value( v-report-name )
      870             page-size value(p-page-size) append .
      871         end.
      872         if not p-append then
      873         do:
      874           output stream PrnLibStream to value( v-report-name )
      875             page-size value(p-page-size) .
      876         end.
      877       end.
      878       if not p-is-stream then
      879       do:
      880         if p-append then
      881         do:
      882           output to value( v-report-name )
      883             page-size value(p-page-size) append .
      884         end.
      885         if not p-append then
      886         do:
      887           output to value( v-report-name )
      888             page-size value(p-page-size) .
      889         end.
      890       end.
      891     end.
      892   end procedure.
      893   procedure prn-lib-open-exp :
      894     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      895     define input parameter p-is-stream    as logical no-undo .
      896     define input parameter p-is-append    as logical no-undo .
      897     define output parameter p-ReportFileName as char init "report" no-undo.
      898     define output parameter p-process as logical no-undo .
      899     define variable glog as logical no-undo .
      900     do
      901       on error undo, return error
      902       :
      903       SYSTEM-DIALOG GET-FILE p-ReportFileName
      904         TITLE      "Укажите путь"
      905         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      906         ASK-OVERWRITE
      907         CREATE-TEST-FILE
      908         SAVE-AS
      909         USE-FILENAME
      910         DEFAULT-EXTENSION "txt"
      911         UPDATE glog
      912         .
      913       if not glog then  return.
      914       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      915       if p-is-stream then
      916       do:
      917         if p-is-append then
      918         do:
      919           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      920         end.
      921         else
      922         do:
      923           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      924         end.
      925       end.
      926       else
      927       do:
      928         if p-is-append then
      929         do:
      930           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      931         end.
      932         else
      933         do:
      934           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      935         end.
      936       end.
      937       p-process = yes.
      938     end.
      939   end procedure.
      940   procedure prn-lib-get-report-name :
      941     define input parameter parParentProc  as widget-handle no-undo.
      942     define output parameter p-report-name as character no-undo .
      943     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      944   end procedure.
      945   procedure prn-lib-reportviewer-report-name :
      946     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      947     define input parameter p-report-name-html as character no-undo .
      948     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      949   end procedure.
      950   procedure prn-lib-reportviewer :
      951     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      952     define input parameter p-report-name-html as character no-undo .
      953     define input parameter p-param        as character no-undo .
      954     define variable v-excel           as character no-undo init 'TRUE' .
      955     define variable v-value-character as character no-undo .
      956     define variable v-value-integer   as character no-undo .
      957     define variable v-value-date      as date      no-undo .
      958     define variable v-value-decimal   as decimal   no-undo .
      959     define variable rep-excel         as logical   no-undo .
      960     define variable excel-string      as character no-undo .
      961     define variable v-param-type      as character no-undo .
      962     define variable v-tth             as handle    no-undo .
      963     run adm/shattri.p (
      964       input "get":U
      965       ,input  ""
      966       ,input  0
      967       ,input  'report-glob':U
      968       ,input  'rep-excel':U
      969       ,output v-value-character
      970       ,output v-value-date
      971       ,output v-value-decimal
      972       ,output v-value-integer
      973       ,output rep-excel
      974       ,output v-param-type
      975       ,INPUT-OUTPUT table-handle v-tth
      976       )  .
      977     if rep-excel then v-excel = "TRUE" .
      978     else v-excel = "FALSE" .
      979     if p-param eq ""
      980     then
      981        p-param = "EXCEL:" + v-excel.
      982     else
      983        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      984     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      985   end procedure.
