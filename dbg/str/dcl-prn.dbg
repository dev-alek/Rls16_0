     1023   define variable l-col-type         as character no-undo .
     1024   define variable l-col-pos          as integer no-undo .
     1025   define variable l-col-len          as integer no-undo .
     1026   define variable l-col-format       as character no-undo .
     1027   define variable l-col-lable        as character no-undo .
     1028   define variable v-dec-sep          as character no-undo init ? .
     1029   define variable v-th-sep           as character no-undo init ? .
     1030   define variable v-r-col-num        as integer no-undo .
     1031   define variable v-reg-replace      as logical no-undo .
     1032   define variable v-date-col-format  as character no-undo .
     1033   DEFINE VARIABLE last-col-num as integer no-undo.
     1034   run gbl/getlocal.p (
     1035                     output v-dec-sep
     1036                    ,output v-th-sep
     1037                    ,output v-sdate
     1038                    ,output v-shortdate
     1039                    ) no-error .
     1040   assign
     1041   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1042                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1043   .
     1044     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1045                                               INPUT p-dec-sep AS CHARACTER  ) :
     1046       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1047       IF TRIM( p-string ) = "0"                    OR
     1048          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1049          TRIM( p-string ) =       p-dec-sep + "00" OR
     1050          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1051          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1052                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1053       RETURN ( TRIM( v-string ) ).
     1054     END FUNCTION.
     1055   FUNCTION reg-output returns character( input p-string as character
     1056                                         ,input p-private-data as character
     1057                                         ,input p-replace as logical
     1058                                         ,input p-supress as logical
     1059                                         ,input p-dec-sep as character
     1060                                         ,input p-th-sep as character
     1061                                         ):
     1062   DEFINE VARIABLE v-reg-output as character no-undo .
     1063   DEFINE VARIABLE v-data-type as character no-undo .
     1064   DEFINE VARIABLE v-progress-format as character no-undo .
     1065   assign
     1066   v-progress-format = entry(1, p-private-data, chr(4))
     1067   v-data-type = entry(2, p-private-data, chr(4))
     1068   .
     1069   if p-string = ? then return chr(63).
     1070   if (v-data-type = "INTEGER"
     1071       OR v-data-type = "DECIMAL" ) THEN DO:
     1072     IF p-replace THEN DO:
     1073       assign
     1074         v-reg-output = replace( p-string
     1075                                         ,chr(44)
     1076                                         ,"":U
     1077                                       )
     1078         v-reg-output = trim(v-reg-output)
     1079       .
     1080     END.
     1081     else do:
     1082       v-reg-output = p-string.
     1083     end.
     1084     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1085     return v-reg-output.
     1086   end.
     1087     return p-string.
     1088   END FUNCTION.
     1089   define variable g#report-num as integer no-undo .
     1090   procedure OpenForExcel :
     1091      define variable v-ch#ExcelApplication as com-handle no-undo .
     1092      define variable v-ch#Workbook         as com-handle no-undo .
     1093      define variable v-ch#Worksheet        as com-handle no-undo .
     1094      os-delete value( string( session:temp-directory ) +
     1095                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1096      os-delete value( string( session:temp-directory ) +
     1097                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1098      os-delete value( string( session:temp-directory ) +
     1099                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1100      if Make-Excel
     1101      then do:
     1102         output stream ForExcel to value( string( session:temp-directory +
     1103                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1104         assign
     1105            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1106            number-list = 1
     1107         .
     1108         if make-excel-com
     1109         then do:
     1110   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1111   if valid-handle(ch#WorkSheet) then
     1112   RELEASE OBJECT ch#WorkSheet no-error.
     1113   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1114   if valid-handle(ch#Workbook) then
     1115   RELEASE OBJECT ch#Workbook no-error.
     1116   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1117   if valid-handle(ch#ExcelApplication) then
     1118   RELEASE OBJECT ch#ExcelApplication no-error.
     1119            create "Excel.Application" ch#excelApplication connect no-error.
     1120            if error-status:error
     1121            then do :
     1122           create "Excel.Application" ch#excelApplication no-error.
     1123       if error-status :error then do:
     1124           message
     1125           "Ошибка при запуске Excel" skip
     1126           error-status :get-message(1) skip
     1127           view-as alert-box error .
     1128           undo, return error .
     1129       end.
     1130            end.
     1131            assign
     1132               num#str#  = 0.
     1133               v-ch#excelApplication  = ch#excelApplication.
     1134               v-ch#excelApplication:Interactive = false.
     1135               v-ch#excelApplication:ScreenUpdating = false.
     1136               v-ch#excelApplication:Visible = false.
     1137               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1138               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1139               v-ch#Worksheet = ch#WorkSheet.
     1140               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1141               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1142               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1143               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1144            no-error .
     1145            if error-status:error
     1146            then do:
     1147               Make-Excel-com = false .
     1148               Make-Excel = false .
     1149               output Stream  ForExcel close.
     1150               os-delete value( string( session:temp-directory ) +
     1151                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1152               os-delete value( string( session:temp-directory ) +
     1153                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1154               return.
     1155            end.
     1156         end.
     1157      end.
     1158   end.
     1159   procedure CloseForExcel :
     1160      define variable ii as integer no-undo .
     1161      define variable vsheet-num as integer no-undo.
     1162      if Make-Excel
     1163      then  do:
     1164         output Stream  ForExcel close.
     1165         os-delete value( string( session:temp-directory ) +
     1166                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1167         os-delete value( string( session:temp-directory ) +
     1168                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1169         define buffer buf_sheetf for sheetf.
     1170         find last buf_sheetf no-error .
     1171         if available buf_sheetf
     1172         then
     1173            vsheet-num = buf_sheetf.sheet-num.
     1174         if vsheet-num > 1
     1175         then do:
     1176            do ii = 2 to vsheet-num:
     1177               os-delete value( string( session:temp-directory ) +
     1178                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1179            end.
     1180         end.
     1181   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1182   if valid-handle(ch#WorkSheet) then
     1183   RELEASE OBJECT ch#WorkSheet no-error.
     1184   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1185   if valid-handle(ch#Workbook) then
     1186   RELEASE OBJECT ch#Workbook no-error.
     1187   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1188   if valid-handle(ch#ExcelApplication) then
     1189   RELEASE OBJECT ch#ExcelApplication no-error.
     1190      end.
     1191   end.
     1192   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1193   define variable v-waitfram-action01         as character   no-undo .
     1194   define variable v-waitfram-action02         as character   no-undo .
     1195   define variable v-waitfram-action03         as character   no-undo .
     1196   define variable mWaitFramTextBeg            as character   no-undo.
     1197   define variable mWaitFramTextEnd            as character   no-undo.
     1198   define variable mWaitFramView               as logical     no-undo.
     1199   define variable mWaitProcEvent              as logical     no-undo init yes.
     1200   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1201   define variable mWaitFramStop               as logical     no-undo.
     1202   define variable mWaitFramStopUser           as logical     no-undo.
     1203   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1204   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1205   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1206   define button B-WaitFramStop auto-end-key
     1207        label "Стоп"
     1208        size 10 by 1 tooltip "Остоновить процесс".
     1209   define button B-viewProcInfo
     1210        label "Информация"
     1211        size 15 by 1 tooltip "Информация о процесс".
     1212   define frame waitfram
     1213     v-waitfram-action01 format "x(72)" no-label skip
     1214     v-waitfram-action02 format "x(72)" no-label skip
     1215     v-waitfram-action03 format "x(72)" no-label skip
     1216     B-viewProcInfo
     1217     B-WaitFramStop at row 4 col 30
     1218     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1219     .
     1220   define new global shared variable mBatchMode as logical no-undo init ?.
     1221   define variable mFramBachModHandle as handle no-undo.
     1222   mFramBachModHandle = frame waitfram:handle.
     1223   define variable mFameOldVis as logical no-undo.
     1224   define variable mVisCUrentVin as logical no-undo.
     1225   if session:batch-mode
     1226   then
     1227      mBatchMode = yes.
     1228   if mBatchMode = ? then do:
     1229     mVisCUrentVin = current-window:visible.
     1230     mFameOldVis = mFramBachModHandle:visible.
     1231     mFramBachModHandle:visible  = yes.
     1232     mBatchMode = mFramBachModHandle:visible ne yes.
     1233     mFramBachModHandle:visible = mFameOldVis.
     1234     current-window:visible = mVisCUrentVin.
     1235   end.
     1236    if  log-manager:logfile-name ne ?
     1237     then DO:
     1238         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1239         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1240         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1241     end.
     1242   on choose of B-WaitFramStop in frame waitfram
     1243   do:
     1244     mWaitFramStop = yes.
     1245     mWaitFramStopUser = yes.
     1246   end.
     1247   function waitfram-check-timeout returns logical():
     1248      define variable vtime as int64 no-undo.
     1249      if mWaitFramStopTimeOut
     1250      then
     1251         return yes.
     1252      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1253      if     mWaitFramTimeOut ne ?
     1254         and mWaitFramTimeOut ne 0
     1255         and mWaitFramTimeOut lt vtime
     1256      then do:
     1257         mWaitFramStopTimeOut = yes.
     1258      end.
     1259      return mWaitFramStopTimeOut.
     1260   end.
     1261   procedure waitfram-hide :
     1262     if not session:batch-mode
     1263     then do
     1264     on error undo, return error return-value
     1265     :
     1266       pause 0 before-hide .
     1267       if not mBatchMode then
     1268         hide frame waitfram .
     1269     if     not mWaitFramView
     1270        and mWaitProcEvent
     1271     then
     1272       process events .
     1273     end.
     1274   end procedure.
     1275   procedure waitfram-show :
     1276     define input  parameter p-message as character no-undo .
     1277     define variable v-left-margin as integer   no-undo .
     1278     if not session:batch-mode
     1279     then do
     1280     on error undo, return error return-value
     1281     :
     1282       if length(p-message) <= 70 then do:
     1283         assign
     1284           v-left-margin = integer((70 - length(p-message)) / 2)
     1285         .
     1286         assign
     1287           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1288         .
     1289         assign
     1290           v-waitfram-action01 = " "
     1291           v-waitfram-action02 = " "
     1292                                    + fill(" ", v-left-margin)
     1293                                    + p-message
     1294           v-waitfram-action03 = " "
     1295         .
     1296       end.
     1297       else do:
     1298         define variable vRindex1 as integer no-undo.
     1299         define variable vRindex2 as integer no-undo.
     1300         vRindex1 = r-index(p-message," ",70).
     1301         if vRindex1 = 0
     1302         then
     1303            vRindex1 = 70.
     1304         if length(p-message)  <= vRindex1 + 70 then do:
     1305           assign
     1306             v-waitfram-action01 = " "
     1307             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1308             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1309           .
     1310         end.
     1311         else do:
     1312           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1313           if vRindex2 <= vRindex1
     1314           then
     1315              vRindex2 = vRindex1 + 70.
     1316           assign
     1317             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1318             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1319             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1320           .
     1321         end.
     1322       end.
     1323       B-viewProcInfo:visible   in frame waitfram = no.
     1324       B-viewProcInfo:sensitive in frame waitfram = no.
     1325       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1326       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1327       if  (   mWaitFramView
     1328          or  mWaitProcEvent)
     1329          and not mBatchMode
     1330       then
     1331          display
     1332             v-waitfram-action01 skip
     1333             v-waitfram-action02 skip
     1334             v-waitfram-action03 skip
     1335          with frame waitfram .
     1336       if     mWaitFramView
     1337          then do:
     1338             if     mWaitFramInterval ne ?
     1339                and not mBatchMode
     1340             then
     1341                wait-for go of frame waitfram pause mWaitFramInterval.
     1342          end.
     1343          else
     1344             if     mWaitProcEvent
     1345                and not mBatchMode
     1346             then
     1347                process events .
     1348     end.
     1349   end procedure.
     1350      procedure waitfram-show-this:
     1351         define input  parameter iInterval as int64 no-undo.
     1352         define variable vtime as int64 no-undo.
     1353         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1354         mWaitFramInterval = iInterval.
     1355         run waitfram-show (substitute("&1&2 &3&4" ,
     1356                                       mWaitFramTextBeg ,
     1357                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1358                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1359                                       mWaitFramTextEnd
     1360                                      )
     1361                           ).
     1362      end.
     1363      procedure WaitFramRunPause:
     1364         define input  parameter iInterval as dec no-undo.
     1365         define variable vStart  as datetime-tz no-undo.
     1366         define variable vend    as datetime-tz no-undo.
     1367         define variable vint as int64 no-undo.
     1368         define variable vOk as logical no-undo.
     1369         vStart = now.
     1370         vend   = vStart.
     1371         publish "WaitFramPause" (iInterval,output vOk).
     1372         vend   =  now.
     1373         vint = vend - vStart.
     1374         vint = iInterval - vint / 1000.
     1375         if     not mWaitFramStop
     1376            and (   vint > 0
     1377                 or (    not vOk
     1378                     and iInterval eq ?
     1379                     )
     1380                 )
     1381         then
     1382            run waitfram-show-this (iInterval).
     1383         vend   =  now.
     1384         vint = vend - vStart.
     1385         vint = iInterval - vint / 1000.
     1386         if     not mWaitFramStop
     1387            and vint > 0
     1388         then do:
     1389            run gbl/pause.p (vint * 1000).
     1390         end.
     1391         if iInterval ne ?
     1392         then
     1393            publish "WaitFramStop".
     1394         waitfram-check-timeout().
     1395      end.
     1396      procedure WaitFramWaitFor:
     1397         define input  parameter iInterval as dec no-undo.
     1398         assign
     1399            mWaitFramStartProc   = now
     1400            mWaitFramStopUser    = no
     1401            mWaitFramStopTimeOut = no
     1402         .
     1403         block-wait:
     1404         do while not mWaitFramStop:
     1405            run WaitFramRunPause (iInterval).
     1406            if  waitfram-check-timeout()
     1407            then do:
     1408               leave block-wait.
     1409            end.
     1410         end.
     1411         run waitfram-hide.
     1412      end.
     1413   procedure waitfram-join :
     1414     define input  parameter p-line-1  as character no-undo .
     1415     define input  parameter p-line-2  as character no-undo .
     1416     define input  parameter p-line-3  as character no-undo .
     1417     define output parameter p-message as character no-undo .
     1418     do
     1419     on error undo, return error return-value
     1420     :
     1421       assign
     1422         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1423                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1424                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1425       .
     1426     end.
     1427   end procedure.
     1428   function waitfram-join-function returns character
     1429     (input p-line-1 as character
     1430     ,input p-line-2 as character
     1431     ,input p-line-3 as character
     1432     ).
     1433     define variable v-message as character no-undo .
     1434     run waitfram-join in this-procedure
     1435       (input  p-line-1
     1436       ,input  p-line-2
     1437       ,input  p-line-3
     1438       ,output v-message
     1439       ) .
     1440     return v-message .
     1441   end function .
     1442   DEFINE VARIABLE LINE as character no-undo.
     1443   DEFINE VARIABLE for-d-card like ub.dis-card.d-card no-undo .
     1444   DEFINE VARIABLE for-issue-code like ub.dis-card.issue-code no-undo .
     1445   DEFINE VARIABLE for-issue-date like ub.dis-card.issue-date no-undo .
     1446   DEFINE VARIABLE for-d-pcnt like ub.dis-card.d-pcnt no-undo .
     1447   DEFINE VARIABLE for-cash-d-pcnt like ub.dis-card.cash-d-pcnt no-undo .
     1448   DEFINE VARIABLE for-status_ like ub.dis-card.status_ no-undo .
     1449   DEFINE VARIABLE for-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     1450   DEFINE VARIABLE for-sourced-card like ub.dis-card.sourced-card no-undo .
     1451   DEFINE VARIABLE for-obj-d-pcnt as character no-undo .
     1452   DEFINE VARIABLE for-obj-d-pcntd as decimal no-undo .
     1453   DEFINE VARIABLE for-valid-date like ub.dis-card.valid-date no-undo .
     1454   DEFINE VARIABLE for-type like ub.dis-card.type no-undo .
     1455   DEFINE VARIABLE for-credit-card like ub.dis-card.credit-card no-undo .
     1456   DEFINE VARIABLE for-lim-kr like ub.dis-card.lim-kr no-undo .
     1457   DEFINE VARIABLE for-cli-name like ub.clients.obj-name no-undo .
     1458   DEFINE VARIABLE for-cli-type like ub.dis-card.cli-type no-undo .
     1459   DEFINE VARIABLE for-cli-code like ub.dis-card.cli-code no-undo .
     1460   DEFINE VARIABLE fill3 as character no-undo.
     1461   DEFINE VARIABLE fill4 as character no-undo.
     1462   DEFINE VARIABLE fill5 as character no-undo.
     1463   DEFINE VARIABLE fill7 as character no-undo.
     1464   DEFINE VARIABLE fill8 as character no-undo.
     1465   DEFINE VARIABLE fill9 as character no-undo.
     1466   DEFINE VARIABLE fill10 as character no-undo.
     1467   DEFINE VARIABLE fill12 as character no-undo.
     1468   DEFINE VARIABLE fill14 as character no-undo.
     1469   DEFINE VARIABLE fill16 as character no-undo.
     1470   DEFINE VARIABLE fill18 as character no-undo.
     1471   DEFINE VARIABLE fill19 as character no-undo.
     1472   DEFINE VARIABLE fill45 as character no-undo.
     1473   DEFINE VARIABLE accum-count as integer no-undo.
     1474   DEFINE VARIABLE ii as integer no-undo.
     1475   DEFINE VARIABLE v-codes as character no-undo .
     1476   DEFINE VARIABLE v-labels as character no-undo .
     1477   DEFINE VARIABLE v-options as character no-undo .
     1478   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     1479        VIEW-AS EDITOR
     1480        SIZE 1 BY 4 NO-UNDO.
     1481   DEFINE FRAME top-frame
     1482       t-1       AT ROW 1 COL 1 no-label
     1483       HEADER
     1484       cur-time-print() AT 5 format "X(35)"
     1485       string( "Страница" ) AT 45 PAGE-NUMBER( PrnLibStream ) AT 55 FORMAT ">>9" SKIP
     1486       with width 232 down stream-io use-text NO-BOX.
     1487    DEFINE FRAME DC
     1488      with width 232 down stream-io use-text NO-BOX.
     1489   CASE pReportOption:
     1490     when "excel":U then do:
     1491       Make-excel = yes.
     1492     end.
     1493     when "main":U then do:
     1494       do ii = 5 to 15:
     1495         use-column[ii] = no.
     1496       end.
     1497     end.
     1498     when "extended":U then do:
     1499       assign
     1500       Make-excel = yes
     1501       v-codes =  "issue-code,issue-date,d-pcnt,status_,emitent-host-code,sourced-card,obj-d-pcnt,valid-date,type,credit-card,lim-kr,cash-d-pcnt":U
     1502       v-labels =  "Магазин выдачи" + chr(44) +
     1503                  "Дата выдачи" + chr(44) +
     1504                  "Скидка" + chr(44) +
     1505                  "Статус" + chr(44) +
     1506                  "Эмитент" + chr(44) +
     1507                  "К карте" + chr(44) +
     1508                  "Скидка на объекте" + chr(32) + parobj-type + string(parobj-code) + chr(44) +
     1509                  "Действует по" + chr(44) +
     1510                  "Тип" + chr(44) +
     1511                  "Кредитная" + chr(44) +
     1512                  "Лимит кредита" + chr(44) +
     1513                  "Скидка на итог"
     1514       .
     1515       run gbl/d-list.w ("b-sel,b-mark":U,
     1516                   "Выберите дополнительные поля для печати",
     1517                   v-codes,
     1518                   v-labels,
     1519                   chr(44),
     1520                   "":U,
     1521                   output v-options).
     1522       do ii = 1 to num-entries(v-codes):
     1523         use-column[ii + 4] = lookup(entry(ii, v-codes), v-options) > 0.
     1524       end.
     1525     end.
     1526   end.
     1527   assign
     1528   use-column[1] = yes
     1529   use-column[2] = yes
     1530   use-column[3] = yes
     1531   use-column[4] = yes
     1532   fill3 = fill("-", 3)
     1533   fill4 = fill("-", 4)
     1534   fill5 = fill("-", 5)
     1535   fill7 = fill("-", 7)
     1536   fill8 = fill("-", 8)
     1537   fill9 = fill("-", 9)
     1538   fill10 = fill("-", 10)
     1539   fill12 = fill("-", 12)
     1540   fill14 = fill("-", 14)
     1541   fill16 = fill("-", 16)
     1542   fill18 = fill("-", 18)
     1543   fill19 = fill("-", 19)
