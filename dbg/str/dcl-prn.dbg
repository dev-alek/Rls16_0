     2746   Line = fill( "-" , 60 ) .
     2747   p-frame-width = l-col-pos - 1.
     2748   run prn-lib-open-stream  in this-procedure (
     2749                                                input parParentProc
     2750                                               ,input 43
     2751                                               ,input yes
     2752                                               ,input no
     2753                                               ).
     2754   if p-frame-width > 232 then
     2755   Make-Excel = yes.
     2756   if Make-Excel then
     2757   RUN OpenForExcel in this-procedure .
     2758   FORM with FRAME dc .
     2759   FORM HEADER
     2760   Line format "X(60)" AT 1 SKIP
     2761   string( "Продолжение - на следующей странице" ) FORMAT "X(40)" AT 10 SKIP
     2762   with FRAME NBottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2763   VIEW stream PrnLibStream FRAME NBottomFrame .
     2764   PUT stream PrnLibStream UNFORMATTED
     2765   SPACE(10)
     2766   Reportname chr(10)
     2767   SKIP(1).
     2768   display STREAM PrnLibStream with frame top-Frame .
     2769   run rep/extitle.p (1).
     2770   run waitfram-show in this-procedure ("Ждите...").
     2771   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2772   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2773   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2774   FUNCTION get-d-pcnt RETURNS CHARACTER
     2775     ( buffer loc-dis-card for dc-list,
     2776       input parhost-code as integer,
     2777       input parobj-type as character,
     2778       input parobj-code as integer,
     2779       input p-discnt-role as character,
     2780       output loc-d-v as decimal) :
     2781   define variable v-node-code as integer no-undo .
     2782   define buffer buf_dis-card-type for ub.dis-card-type.
     2783   define buffer buf_dis-card-property for ub.dis-card-property.
     2784   find first buf_dis-card-type no-lock where
     2785             buf_dis-card-type.type = loc-dis-card.type
     2786         and buf_dis-card-type.emitent-host-code = loc-dis-card.emitent-host-code
     2787         and buf_dis-card-type.host-code = 0
     2788         and buf_dis-card-type.obj-type = '':U
     2789         and buf_dis-card-type.obj-code = 0 no-error.
     2790   if available buf_dis-card-type then do:
     2791     case p-discnt-role:
     2792       when 'def-pcnt':U  then do:
     2793         assign
     2794         v-node-code = 1.
     2795       end.
     2796       when 'def-cash-pcnt':U then do:
     2797         assign
     2798         v-node-code = 2.
     2799       end.
     2800       when 'def-categ':U then do:
     2801         assign
     2802         v-node-code = 3.
     2803       end.
     2804     end.
     2805     if buf_dis-card-type.d-pcnt-byshop then do:
     2806      find first buf_dis-card-property no-lock where
     2807                buf_dis-card-property.d-card = loc-dis-card.d-card
     2808            and buf_dis-card-property.dtm-code = 26
     2809            and buf_dis-card-property.host-code = parhost-code
     2810            and buf_dis-card-property.obj-type = parobj-type
     2811            and buf_dis-card-property.obj-code = parobj-code
     2812            and buf_dis-card-property.node-code = v-node-code no-error.
     2813      if available buf_dis-card-property then do:
     2814        if p-discnt-role = 'def-categ':U then do:
     2815          assign
     2816          loc-d-v = buf_dis-card-property.property-value-integer.
     2817        end.
     2818        else do:
     2819          assign
     2820          loc-d-v = buf_dis-card-property.property-value-decimal.
     2821        end.
     2822      end.
     2823       if loc-d-v = ? then do:
     2824   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2825   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     2826     (
     2827      input  loc-dis-card.type
     2828     ,input  loC-dis-card.emitent-host-code
     2829     ,input  parhost-code
     2830     ,input  parobj-type
     2831     ,input  parobj-code
     2832     ,input  p-discnt-role
     2833     ,output loc-d-v
     2834     ) no-error .
     2835       end.
     2836       if loc-d-v = ? then do:
     2837         find first buf_dis-card-property no-lock where
     2838                   buf_dis-card-property.d-card = loc-dis-card.d-card
     2839               and buf_dis-card-property.dtm-code = 26
     2840               and buf_dis-card-property.host-code = parhost-code
     2841               and buf_dis-card-property.obj-type = ''
     2842               and buf_dis-card-property.obj-code = 0
     2843               and buf_dis-card-property.node-code = v-node-code no-error.
     2844         if available buf_dis-card-property then do:
     2845           if p-discnt-role = 'def-categ':U then do:
     2846             assign
     2847             loc-d-v = buf_dis-card-property.property-value-integer.
     2848           end.
     2849           else do:
     2850             assign
     2851             loc-d-v = buf_dis-card-property.property-value-decimal.
     2852           end.
     2853         end.
     2854       end.
     2855       if loc-d-v = ? then do:
     2856   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     2858     (
     2859      input  loc-dis-card.type
     2860     ,input  loC-dis-card.emitent-host-code
     2861     ,input  parhost-code
     2862     ,input  ''
     2863     ,input  0
     2864     ,input  p-discnt-role
     2865     ,output loc-d-v
     2866     ) no-error .
     2867       end.
     2868       if loc-d-v = ? then do:
     2869         case p-discnt-role:
     2870           when 'def-categ':U then do:
     2871             loc-d-v = loc-dis-card.category.
     2872           end.
     2873           when 'def-pcnt':U then do:
     2874             loc-d-v = loc-dis-card.d-pcnt.
     2875           end.
     2876           when 'def-cash-pcnt':U then do:
     2877             loc-d-v = loc-dis-card.cash-d-pcnt.
     2878           end.
     2879         end case.
     2880       end.
     2881       if p-discnt-role = 'def-categ':U then do:
     2882         return substitute("(i) &1", string(loc-d-v, ">>>9")).
     2883       end.
     2884       else do:
     2885         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
     2886       end.
     2887     end.
     2888   end.
     2889   else do:
     2890    return "ОШИБКА-НЕТ ТИПА".
     2891   end.
     2892   case p-discnt-role:
     2893     when 'def-categ':U then do:
     2894        loc-d-v = loc-dis-card.category.
     2895        return string(loc-d-v, ">>>9").
     2896     end.
     2897     when 'def-pcnt':U then do:
     2898       loc-d-v = loc-dis-card.d-pcnt.
     2899       return string(loc-d-v, "->9.99%").
     2900     end.
     2901     when 'def-cash-pcnt':U then do:
     2902       loc-d-v = loc-dis-card.cash-d-pcnt.
     2903       return string(loc-d-v, "->9.99%").
     2904     end.
     2905   end case.
     2906   END FUNCTION.
     2907   FOR EACH dc-list No-LOCK
     2908       BREAK
     2909       BY dc-list.d-card:
     2910     assign
     2911     accum-count = accum-count + 1
     2912     .
     2913     for-status_ = dc-list.status_.
     2914     FIND FIRST  ub.clients No-LOCK WHERE
     2915           ub.clients.obj-type = dc-list.cli-type AND
     2916           ub.clients.obj-code = dc-list.cli-code No-ERROR.
     2917     if avail ub.clients then do:
     2918       for-cli-name = ub.clients.obj-name.
     2919     end.
     2920     else do:
     2921       for-cli-name = "":U .
     2922     end.
     2923     for-obj-d-pcnt = get-d-pcnt (
     2924                                   buffer dc-list
     2925                                  ,input parhost-code
     2926                                  ,input parobj-type
     2927                                  ,input parobj-code
     2928                                  ,input 'def-pcnt':U
     2929                                  ,output for-obj-d-pcntd).
     2930     if use-column[1]
     2931     then  C-for-d-card:screen-value = string(dc-list.d-card, entry(1, c-for-d-card:private-data, chr(4))).
     2932     if use-column[2]
     2933     then  C-for-cli-type:screen-value = string(dc-list.cli-type, entry(1, c-for-cli-type:private-data, chr(4))).
     2934     if use-column[3]
     2935     then  C-for-cli-code:screen-value = string(dc-list.cli-code, entry(1, c-for-cli-code:private-data, chr(4))).
     2936     if use-column[4]
     2937     then  C-for-cli-name:screen-value = string(for-cli-name, entry(1, c-for-cli-name:private-data, chr(4))).
     2938     if use-column[5]
     2939     then  C-for-issue-code:screen-value = string(dc-list.issue-code, entry(1, c-for-issue-code:private-data, chr(4))).
     2940     if use-column[6]
     2941     then  C-for-issue-date:screen-value = string(dc-list.issue-date, entry(1, c-for-issue-date:private-data, chr(4))).
     2942     if use-column[7]
     2943     then  C-for-d-pcnt:screen-value = string(dc-list.d-pcnt, entry(1, c-for-d-pcnt:private-data, chr(4))).
     2944     if use-column[8]
     2945     then  C-for-status_:screen-value = string(for-status_, entry(1, c-for-status_:private-data, chr(4))).
     2946     if use-column[9]
     2947     then  C-for-emitent-host-code:screen-value = string(dc-list.emitent-host-code, entry(1, c-for-emitent-host-code:private-data, chr(4))).
     2948     if use-column[10]
     2949     then  C-for-sourced-card:screen-value = string(dc-list.sourced-card, entry(1, c-for-sourced-card:private-data, chr(4))).
     2950     if use-column[11]
     2951     then  C-for-obj-d-pcnt:screen-value = string(for-obj-d-pcnt, entry(1, c-for-obj-d-pcnt:private-data, chr(4))).
     2952     if use-column[12]
     2953     then  C-for-valid-date:screen-value = string(dc-list.valid-date, entry(1, c-for-valid-date:private-data, chr(4))).
     2954     if use-column[13]
     2955     then  C-for-type:screen-value = string(dc-list.type, entry(1, c-for-type:private-data, chr(4))).
     2956     if use-column[14]
     2957     then  C-for-credit-card:screen-value = string(dc-list.credit-card, entry(1, c-for-credit-card:private-data, chr(4))).
     2958     if use-column[15]
