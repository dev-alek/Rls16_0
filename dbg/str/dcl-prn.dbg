     3196   if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     3197   FInd first Sheetf where
     3198              Sheetf.sheet-num = 2 No-ERROR.
     3199   if not avail sheetf then
     3200   create sheetf.
     3201   assign
     3202   Sheetf.Sheet-num = 2
     3203   sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     3204   sheetf.sizes = "9,9,9,12,155"
     3205   .
     3206   run rep/extitle.p (2).
     3207   for each dc-list-hist:
     3208     if Make-Excel then  put   stream ForExcel unformatted
     3209     (if dc-list-hist.line = 0
     3210      then string(dc-list-hist.id, ">>>>>>>>9")
     3211      else '':U)
     3212     CHR(9)
     3213     (if dc-list-hist.item_ <> '':U
     3214      then dc-list-hist.hist-mode
     3215      else '':U)  CHR(9)
     3216      (if dc-list-hist.item_ <> '':U
     3217      then string(dc-list-hist.num-add, "->>>>>>>>9")
     3218      else '':U)  CHR(9)
     3219     (if dc-list-hist.item_ <> '':U
     3220     then string(dc-list-hist.num-recs, ">>>>>>>>9")
     3221     else '':U)  CHR(9)
     3222     dc-list-hist.des
     3223     skip.
     3224   end.
     3225   HIDE STREAM PrnLibStream FRAME dc .
     3226   HIDE STREAM PrnLibStream FRAME top-Frame .
     3227   HIDE stream PrnLibStream FRAME NBottomFrame .
     3228   output stream PrnLibStream CLOSE .
     3229   if Make-Excel then output stream ForExcel close.
     3230   DELETE WIDGET-POOL "My-pool".
     3231   run waitfram-hide in this-procedure .
     3232   if Make-Excel and pReportOption = "excel":U then do:
     3233      run rep/runexcel.p (
     3234                      string( session:temp-directory +
     3235                            "rpt" +
     3236                            string( g#report-num ) + ".txt":U )
     3237                    ) .
     3238      RUN CLoseForExcel in this-procedure .
