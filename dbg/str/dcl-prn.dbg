     1552   end.
     1553   run get-report-num in parparentproc (output g#report-num).
     1554   FIND FIRST sheetf where
     1555              sheetf.sheet-num = 1 No-ERROR.
     1556   assign
     1557   ReportName = "Список дисконтных карт"
