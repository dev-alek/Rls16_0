     2234   define input parameter p-curr-code          as integer          no-undo.
     2235       define variable v-host-code    as integer      no-undo.
     2236       define variable v-par-type     as character    no-undo.
     2237   do
     2238   on error undo, return error
     2239   :
     2240       assign
     2241          v-torgconf-sup-host-code = v-host-code
     2242       .
     2243       if v-torgconf-sup-host-code = 0
     2244       then do:
     2245           assign
     2246               v-torgconf-sup-host-name           = "":U
     2247               v-torgconf-sup-host-addres         = "":U
     2248               v-torgconf-sup-host-post-addres    = "":U
     2249               v-torgconf-sup-host-phone          = "":U
     2250               v-torgconf-sup-host-inn            = "":U
     2251               v-torgconf-sup-host-kpp            = "":U
     2252               v-torgconf-sup-host-okpo           = "":U
     2253               v-torgconf-sup-host-egrip-date     = "":U
     2254               v-torgconf-sup-host-egrip-num      = "":U
     2255           .
     2256       end.
     2257       else do:
     2258           run fmtcli-get-client in this-procedure (
     2259                 input 'орг':U
     2260               , input v-torgconf-sup-host-code
     2261           ).
     2262           assign
     2263               v-torgconf-sup-host-name        = v-fmtcli-name
     2264               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2265               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2266               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2267               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2268               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2269               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2270               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2271           .
     2272           run gbl/clntat-v.p (
     2273                 input 'орг':U
     2274               , input v-torgconf-sup-host-code
     2275               , input 'egrip-date':U
     2276               , output v-torgconf-sup-host-egrip-date
     2277               , output v-par-type
     2278           ).
     2279           run gbl/clntat-v.p (
     2280                 input 'орг':U
     2281               , input v-torgconf-sup-host-code
     2282               , input 'egrip-num':U
     2283               , output v-torgconf-sup-host-egrip-num
     2284               , output v-par-type
     2285           ).
     2286           run fmtcli-get-bank in this-procedure (
     2287                 input v-host-code
     2288               , input 'орг':U
     2289               , input v-torgconf-sup-host-code
     2290               , input p-curr-code
     2291           ).
     2292       end.
     2293       assign
     2294           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2295           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2296           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2297           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2298           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2299           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2300           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2301           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2302       .
     2303       assign
     2304           v-torgconf-sup-obj-type = p-obj-type
     2305           v-torgconf-sup-obj-code = p-obj-code
     2306       .
     2307       if trim(p-obj-type) <> ""
     2308       and p-obj-code <> 0
     2309       then do:
     2310       run fmtcli-get-client in this-procedure (
     2311             input p-obj-type
     2312           , input p-obj-code
     2313       ).
     2314       assign
     2315           v-torgconf-sup-obj-name        = v-fmtcli-name
     2316           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2317           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2318           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2319           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2320           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2321           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2322       .
     2323      end.
     2324      end.
     2325   end procedure.
     2326   procedure torgconf-get-cli-param :
     2327   define input parameter p-host-obj-code      as integer          no-undo.
     2328   define input parameter p-obj-type           as character        no-undo.
     2329   define input parameter p-obj-code           as integer          no-undo.
     2330   define input parameter p-curr-code          as integer          no-undo.
     2331       define variable v-host-code    as integer      no-undo.
     2332   do
     2333   on error undo, return error
     2334   :
     2335       assign
     2336           v-torgconf-cli-type = p-obj-type
     2337           v-torgconf-cli-code = p-obj-code
     2338       .
     2339       run fmtcli-get-client in this-procedure (
     2340             input p-obj-type
     2341           , input p-obj-code
     2342       ).
     2343       assign
     2344           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     2345           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     2346           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     2347           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     2348           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     2349           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     2350           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     2351           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     2352       .
     2353      run fmtcli-get-bank in this-procedure (
     2354             input p-host-obj-code
     2355           , input p-obj-type
     2356           , input p-obj-code
     2357           , input p-curr-code
     2358       ).
     2359       assign
     2360           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2361           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2362           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2363           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2364           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2365           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2366           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2367           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2368       .
     2369   end.
     2370   end procedure.
     2371   procedure torgconf-get-ship-param :
     2372   define input parameter p-host-obj-code      as integer          no-undo.
     2373   define input parameter p-obj-type           as character        no-undo.
     2374   define input parameter p-obj-code           as integer          no-undo.
     2375   define input parameter p-curr-code          as integer          no-undo.
     2376       define variable v-host-code    as integer      no-undo.
     2377   do
     2378   on error undo, return error
     2379   :
     2380       assign
     2381           v-torgconf-ship-type = p-obj-type
     2382           v-torgconf-ship-code = p-obj-code
     2383       .
     2384       if trim(p-obj-type) = ""
     2385       and p-obj-code = 0
     2386       then do:
     2387       assign
     2388           v-torgconf-ship-name         = "":U
     2389           v-torgconf-ship-addres       = "":U
     2390           v-torgconf-ship-post-addres  = "":U
     2391           v-torgconf-ship-phone        = "":U
     2392           v-torgconf-ship-inn          = "":U
     2393           v-torgconf-ship-kpp          = "":U
     2394           v-torgconf-ship-okpo         = "":U
     2395       .
     2396       end.
     2397       else do:
     2398       run fmtcli-get-client in this-procedure (
     2399             input p-obj-type
     2400           , input p-obj-code
     2401       ).
     2402       assign
     2403           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2404           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2405           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2406           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2407           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2408           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2409           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2410           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2411       .
     2412       end.
     2413           run fmtcli-get-bank in this-procedure (
     2414             input p-host-obj-code
     2415           , input p-obj-type
     2416           , input p-obj-code
     2417           , input p-curr-code
     2418       ).
     2419       assign
     2420           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2421           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2422           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2423           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2424           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2425           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2426           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2427           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2428       .
     2429   end.
     2430   end procedure.
     2431   procedure torgconf-get-holdfirm-code :
     2432   define input parameter p-obj-type   as character        no-undo.
     2433   define input parameter p-obj-code   as integer          no-undo.
     2434   define output parameter p-firm-code as integer          no-undo.
     2435       define variable v-firm-code-str     as character    no-undo.
     2436       define variable v-par-type          as character    no-undo.
     2437       define buffer buf_clients       for ub.clients.
     2438   do
     2439   for buf_clients
     2440   on error undo, return error
     2441   :
     2442       run gbl/clntat-v.p (
     2443             input p-obj-type
     2444           , input p-obj-code
     2445           , input 'holdfirm-code':U
     2446           , output v-firm-code-str
     2447           , output v-par-type
     2448       ).
     2449       assign
     2450           p-firm-code = integer( v-firm-code-str )
     2451       no-error.
     2452       if error-status :error
     2453       then do:
     2454           message
     2455               "Неверно задан код фирмы для печати накладных."
     2456           view-as alert-box warning.
     2457           assign
     2458               p-firm-code = 0
     2459           .
     2460       end.
     2461       else do:
     2462           find first buf_clients no-lock
     2463                where buf_clients.obj-type = 'орг':U
     2464                  and buf_clients.obj-code = p-firm-code
     2465           no-error.
     2466           if not available buf_clients
     2467           then do:
     2468               message
     2469                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2470                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2471               view-as alert-box warning.
     2472               assign
     2473                   p-firm-code = 0
     2474               .
     2475           end.
     2476       end.
     2477   end.
     2478   end procedure.
     2479   procedure torgconf-get-post-head:
     2480   define input  parameter p-obj-type             as character        no-undo.
     2481   define input  parameter p-obj-code             as integer          no-undo.
     2482   define output parameter p-torgconf-post-head   as character        no-undo.
     2483      define variable v-host-code         as integer      no-undo.
     2484      define buffer buf_sysconf     for ub.sysconf.
     2485        assign
     2486         p-torgconf-post-head  = ""
     2487        .
     2488   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2489   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2490     (input  p-obj-type
     2491     ,input  p-obj-code
     2492     ,output v-host-code
     2493     )  .
     2494      find first buf_sysconf no-lock
     2495      where buf_sysconf.host-code = v-host-code
     2496      no-error.
     2497      if available buf_sysconf
     2498      then do:
     2499         assign
     2500            p-torgconf-post-head = buf_sysconf.head-position
     2501         .
     2502      end.
     2503   end procedure.
     2504   procedure torgconf-get-storekeeper:
     2505   define input  parameter p-wrkr                   as integer          no-undo.
     2506   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2507   define output parameter p-torgconf-post          as character        no-undo.
     2508      define buffer buf_sysconf     for ub.sysconf.
     2509      define buffer buf_person      for ub.person.
     2510      define buffer buf_shop        for ub.shop .
     2511      define buffer buf_store       for ub.store .
     2512      if v-torgconf-outC = "no_print"
     2513      then do:
     2514         assign p-torgconf-post = ""
     2515                p-torgconf-wrkr-name = ""
     2516                .
     2517      end.
     2518      if v-torgconf-outC = "clad_doc"
     2519      then do:
     2520         run rep/get-psn.p
     2521               (input  p-wrkr
     2522               ,output p-torgconf-wrkr-name
     2523               ) .
     2524         find first buf_person no-lock
     2525         where buf_person.psn-code = p-wrkr
     2526         no-error.
     2527         if available buf_person
     2528         then do:
     2529           p-torgconf-post = buf_person.position.
     2530         end.
     2531         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2532         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2533      end.
     2534      if v-torgconf-outC = "clad_obj"
     2535      then do:
     2536         CASE v-torgconf-self-obj-type:
     2537         WHEN 'маг':U
     2538         THEN DO:
     2539            find first buf_shop no-lock
     2540            where buf_shop.obj-code = v-torgconf-self-obj-code
     2541            .
     2542            assign
     2543               p-torgconf-wrkr-name = buf_shop.store-man
     2544               p-torgconf-post = ""
     2545            .
     2546            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2547         END.
     2548         WHEN 'скл':U
     2549         THEN DO:
     2550            find first buf_store no-lock
     2551            where buf_store.obj-code = v-torgconf-self-obj-code
     2552            .
     2553            assign
     2554               p-torgconf-wrkr-name = buf_store.store-man
     2555               p-torgconf-post = ""
     2556            .
     2557            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2558         END.
     2559         OTHERWISE DO:
     2560            assign
     2561               p-torgconf-post = "":U
     2562               p-torgconf-wrkr-name = "":U
     2563            .
     2564         END.
     2565         END CASE.
     2566      end.
     2567    end procedure.
     2568   procedure torgconf-get-form-header :
     2569   define input parameter p-for-inverse    as logical          no-undo.
     2570   define input parameter p-doc-code       as character        no-undo.
     2571   define input parameter p-print-doc      as logical          no-undo.
     2572   define input parameter p-doc-date       as date             no-undo.
     2573   define input parameter p-fact-date      as date             no-undo.
     2574   define input parameter p-doc-type       as character        no-undo.
     2575   define input parameter p-status_        as character        no-undo.
     2576   define input parameter p-reverse        as logical          no-undo.
     2577   define input parameter p-sf-par         as logical          no-undo.
     2578       define variable v-attr-type         as character    no-undo.
     2579       define variable v-doc-code-standard as logical      no-undo.
     2580       define variable v-doc-date-standard as logical      no-undo.
     2581       define variable v-par-consignee-addres  as character    no-undo.
     2582       define variable v-host-code         as integer      no-undo.
     2583       define variable v-dcode-attr        as character    no-undo.
     2584       define variable v-ddate-attr        as character    no-undo.
     2585       define variable v-doc-date          as character    no-undo.
     2586       define variable v-doc-code          as character    no-undo.
     2587       define variable v-par-type          as character    no-undo.
     2588       define variable v-attr              as character    no-undo.
     2589       define buffer buf_firm          for ub.firm .
     2590       define buffer buf_clients       for ub.clients .
     2591       define buffer buf_sysconf       for ub.sysconf .
     2592       define buffer buf_shop          for ub.shop .
     2593       define buffer buf_store         for ub.store .
     2594       define buffer buf_person        for ub.person .
     2595       define buffer buf_trn-doc       for ub.trn-doc .
     2596       define buffer buf_wth-doc       for ub.wth-doc .
     2597       do
     2598   for buf_firm
     2599     , buf_clients
     2600     , buf_sysconf
     2601     , buf_shop
     2602     , buf_trn-doc
     2603     , buf_person
     2604     , buf_wth-doc
     2605   on error undo, return error
     2606   :
     2607       if p-doc-type = 'при':U
     2608       or p-doc-type = 'возврат':U
     2609       then do:
     2610           assign
     2611               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2612                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2613               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2614                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2615               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2616                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2617               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2618                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2619               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2620               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2621               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2622               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2623               v-torgconf-supplier-type    = v-torgconf-cli-type
     2624               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2625               v-torgconf-saler-type       = v-torgconf-self-host-type
     2626               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2627               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2628               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2629               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2630               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2631               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2632               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2633               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2634               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2635               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2636               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2637               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2638               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2639               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2640               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2641           .
     2642           if v-torgconf-cli-schet-exists = yes
     2643           AND v-form-name                  = "torg12":U
     2644           then do:
     2645               assign
     2646                   v-torgconf-supplier = v-torgconf-supplier
     2647                       + substitute( ", р/с &1 к/с &2"
     2648                                   , v-torgconf-cli-bank-r-schet
     2649                                   , v-torgconf-cli-bank-c-schet
     2650                                   )
     2651                   v-torgconf-suppi = v-torgconf-supplier
     2652                       + substitute( ", р/с &1 к/с &2"
     2653                                   , v-torgconf-cli-bank-r-schet
     2654                                   , v-torgconf-cli-bank-c-schet
     2655                                   )
     2656               .
     2657               if v-torgconf-cli-bank-exists = yes
     2658               then do:
     2659                   assign
     2660                       v-torgconf-supplier = v-torgconf-supplier
     2661                           + substitute( " БИК &1 в &2 &3"
     2662                                       , v-torgconf-cli-bank-bik
     2663                                       , v-torgconf-cli-bank-name
