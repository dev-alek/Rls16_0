     1574   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1575   procedure wthcattr-sprcli :
     1576   define input parameter parparentproc  as widget-handle no-undo.
     1577   define input parameter p-mode  as character no-undo.
     1578   define input-output parameter p-value as character no-undo .
     1579   define output parameter p-setted as logical no-undo .
     1580     DEFINE VARIABLE v-value as character no-undo .
     1581     define variable v-cli-type as character no-undo .
     1582     define variable v-cli-code as integer no-undo .
     1583     define buffer buf_clients   for ub.clients.
     1584     define variable v_rid as character no-undo.
     1585     define variable ref-rec as recid no-undo .
     1586     do
     1587     on error undo, return error
     1588     :
     1589         v-value = p-value.
     1590      if p-value <> '':U then do:
     1591       assign
     1592       v-cli-type = substring(p-value, 1, 3)
     1593       v-cli-code = integer(substring(p-value, 4))
     1594       no-error.
     1595       if error-status:error then do:
     1596         assign
     1597         v-cli-type = '':U
     1598         v-cli-code = 0
     1599         .
     1600       end.
     1601      end.
     1602      FIND FIRST buf_clients NO-LOCK WHERE
     1603               buf_clients.obj-type = v-cli-type AND
     1604               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1605      IF available(buf_clients) then do:
     1606       run ref/cli-all.w (
     1607                   input parparentproc
     1608                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1609                  ,input v-cli-type
     1610                  ,input 'все':U
     1611                  ,input 'все':U
     1612                  ,input RECID( buf_clients )
     1613                  ,input ",,,,,,NO"
     1614                  ,input ?
     1615                  ,OUTPUT v_rid ).
     1616     END.
     1617     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1618       run ref/cli-all.w (
     1619                    input parparentproc
     1620                   ,INPUT "b-sel":U
     1621                  ,input  v-cli-type
     1622                  ,input 'все':U
     1623                  ,input 'текущие':U
     1624                  ,input ?
     1625                  ,input ",,,,,,NO"
     1626                  ,input ?
     1627                  ,OUTPUT v_rid ).
     1628     END.
     1629     else do:
     1630       message
     1631       if p-value = "":U then 'Атрибут не задан!'
     1632       else substitute('Не найден клиент &1',p-value)
     1633       view-as alert-box warning.
     1634     end.
     1635     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1636       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1637       IF ERROR-STATUS:ERROR THEN DO:
     1638           RETURN NO-APPLY.
     1639       END.
     1640       FIND FIRST buf_clients NO-LOCK WHERE
     1641                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1642       IF AVAIL buf_clients THEN DO:
     1643         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1644       end.
     1645     end.
     1646     if v-value <> p-value then do:
     1647       p-value = v-value.
     1648       p-setted = yes.
     1649     end.
     1650     end.
     1651   end procedure.
     1652     define new global shared variable g#wthcalib as handle no-undo.
     1653   procedure torgconf-read :
     1654   do
     1655   on error undo, return error
     1656   :
     1657       define input parameter p-form-name  as character    no-undo.
     1658       define input parameter p-host-code  as integer      no-undo.
     1659       define input parameter p-obj-type   as character    no-undo.
     1660       define input parameter p-obj-code   as integer      no-undo.
     1661       define variable v-outdate   as character     no-undo.
     1662       define variable v-outares   as character     no-undo.
     1663       define variable v-outsend   as character     no-undo.
     1664       define variable v-outasend  as character     no-undo.
     1665       define variable v-outprops  as character     no-undo.
     1666       define variable v-outnum    as character     no-undo.
     1667       define variable v-outprim   as character     no-undo.
     1668       define variable v-outdisc   as character     no-undo.
     1669       define variable v-outsubs   as character     no-undo.
     1670       define variable v-outrecv   as character     no-undo.
     1671       define variable v-outegrp   as character     no-undo.
     1672       define variable v-outt12    as character     no-undo.
     1673       define variable v-outappr   as character     no-undo.
     1674       define variable v-outrubl   as character     no-undo.
     1675       define variable v-outhold   as character     no-undo.
     1676       define variable v-outobj    as character     no-undo.
     1677       define variable v-outexlst  as character     no-undo.
     1678       define variable v-outprncd  as character     no-undo.
     1679       define variable v-par-type  as character     no-undo.
     1680       define variable v-outogr    as character     no-undo.
     1681       define variable v-outR      as character     no-undo.
     1682       define variable v-outB      as character     no-undo.
     1683       define variable v-outC      as character     no-undo.
     1684       assign
     1685           v-torgconf-outdate  = no
     1686           v-torgconf-outnum   = no
     1687           v-torgconf-outprim  = no
     1688           v-torgconf-outdisc  = no
     1689           v-torgconf-outsubs  = no
     1690           v-torgconf-outrecv  = no
     1691           v-torgconf-outegrp  = no
     1692           v-torgconf-outt12   = no
     1693           v-torgconf-outappr  = no
     1694           v-torgconf-outrubl  = no
     1695           v-torgconf-outhold  = no
     1696           v-torgconf-outobj   = no
     1697           v-torgconf-outexlst = no
     1698           v-torgconf-outexpas = "":U
     1699           v-torgconf-outprncd = yes
     1700           v-torgconf-outares  = no
     1701           v-torgconf-outsend  = no
     1702           v-torgconf-outasend  = no
     1703           v-torgconf-outprops  = no
     1704           v-form-name          = p-form-name
     1705       .
     1706   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1707   empty temp-table thbjattr_thbj-attr.
     1708   run adm/shattri.p (
     1709      input "get":U
     1710     ,input ''
     1711     ,input 0
     1712     ,input 'prt-glob':U
     1713     ,input  ""
     1714     ,output v-value-character
     1715     ,output v-value-date
     1716     ,output v-value-decimal
     1717     ,output v-value-integer
     1718     ,output v-value-logical
     1719     ,output par-type
     1720     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1721     ) no-error .
     1722   for each thbjattr_thbj-attr :
     1723       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1724       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1725       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1726   end.
     1727   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1728   empty temp-table thbjattr_thbj-attr.
     1729   run adm/shattri.p (
     1730      input "get":U
     1731     ,input p-obj-type
     1732     ,input p-obj-code
     1733     ,input 'prt-obj':U
     1734     ,input  ""
     1735     ,output v-value-character
     1736     ,output v-value-date
     1737     ,output v-value-decimal
     1738     ,output v-value-integer
     1739     ,output v-value-logical
     1740     ,output par-type
     1741     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1742     ) no-error .
     1743   for each thbjattr_thbj-attr :
     1744       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1745       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1746       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1747       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1748       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1749       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1750       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1751       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1752       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1753       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1754       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1755       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1756       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1757       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1758       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1759       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1760       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1761       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1762       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1763   end.
     1764       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1765       if error-status :error
     1766       then do:
     1767           assign
     1768               v-torgconf-outexpas = "":U
     1769           .
     1770       end.
     1771       assign
     1772           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1773       .
     1774       if p-form-name <> ""
     1775       and p-form-name <> ?
     1776       then do:
     1777           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1778           if error-status :error
     1779           then do:
     1780               assign
     1781                   v-outexlst           = ""
     1782               .
     1783           end.
     1784           if lookup( p-form-name, v-outdate ) <> 0
     1785           then do:
     1786               assign
     1787                   v-torgconf-outdate  = yes
     1788               .
     1789           end.
     1790           if lookup( p-form-name, v-outares ) <> 0
     1791           then do:
     1792               assign
     1793                   v-torgconf-outares  = yes
     1794               .
     1795           end.
     1796           if lookup( p-form-name, v-outnum  ) <> 0
     1797           then do:
     1798               assign
     1799                   v-torgconf-outnum   = yes
     1800               .
     1801           end.
     1802           if lookup( p-form-name, v-outprim ) <> 0
     1803           then do:
     1804               assign
     1805                   v-torgconf-outprim  = yes
     1806               .
     1807           end.
     1808           if lookup( p-form-name, v-outdisc ) <> 0
     1809           then do:
     1810               assign
     1811                   v-torgconf-outdisc  = yes
     1812               .
     1813           end.
     1814           if lookup( p-form-name, v-outsubs ) <> 0
     1815           then do:
     1816               assign
     1817                   v-torgconf-outsubs  = yes
     1818               .
     1819           end.
     1820           if lookup( p-form-name, v-outrecv ) <> 0
     1821           then do:
     1822               assign
     1823                   v-torgconf-outrecv  = yes
     1824               .
     1825           end.
     1826           if lookup( p-form-name, v-outegrp ) <> 0
     1827           then do:
     1828               assign
     1829                   v-torgconf-outegrp  = yes
     1830               .
     1831           end.
     1832           if lookup( p-form-name, v-outt12  ) <> 0
     1833           then do:
     1834               assign
     1835                   v-torgconf-outt12   = yes
     1836               .
     1837           end.
     1838           if lookup( p-form-name, v-outappr  ) <> 0
     1839           then do:
     1840               assign
     1841                   v-torgconf-outappr   = yes
     1842               .
     1843           end.
     1844           if lookup( p-form-name, v-outrubl  ) <> 0
     1845           then do:
     1846               assign
     1847                   v-torgconf-outrubl   = yes
     1848               .
     1849           end.
     1850           if lookup( p-form-name, v-outhold  ) <> 0
     1851           then do:
     1852               assign
     1853                   v-torgconf-outhold   = yes
     1854               .
     1855           end.
     1856           if lookup( p-form-name, v-outobj   ) <> 0
     1857           then do:
     1858               assign
     1859                   v-torgconf-outobj    = yes
     1860               .
     1861           end.
     1862           if lookup( p-form-name, v-outsend   ) <> 0
     1863           then do:
     1864               assign
     1865                   v-torgconf-outsend    = yes
     1866               .
     1867           end.
     1868           if lookup( p-form-name, v-outasend   ) <> 0
     1869           then do:
     1870               assign
     1871                   v-torgconf-outasend    = yes
     1872               .
     1873           end.
     1874           if lookup( p-form-name, v-outprops   ) <> 0
     1875           then do:
     1876               assign
     1877                   v-torgconf-outprops    = yes
     1878               .
     1879           end.
     1880           if lookup( p-form-name, v-outexlst ) <> 0
     1881           then do:
     1882               assign
     1883                   v-torgconf-outexlst  = yes
     1884               .
     1885           end.
     1886        assign
     1887         v-name = p-form-name.
     1888   end.
     1889   end.
     1890   end procedure.
     1891   procedure torgconf-get-self-param :
     1892   define input parameter p-obj-type           as character        no-undo.
     1893   define input parameter p-obj-code           as integer          no-undo.
     1894   define input parameter p-curr-code          as integer          no-undo.
     1895       define variable v-host-code    as integer      no-undo.
     1896       define variable v-par-type     as character    no-undo.
     1897   do
     1898   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1899   :
     1900   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1901   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1902     (input  p-obj-type
     1903     ,input  p-obj-code
     1904     ,output v-host-code
     1905     )  .
     1906       if v-torgconf-outhold = yes
     1907       then do:
     1908           run torgconf-get-holdfirm-code in this-procedure (
     1909                 input p-obj-type
     1910               , input p-obj-code
     1911               , output v-torgconf-self-host-code
     1912           ).
     1913           if v-torgconf-self-host-code = 0
     1914           then do:
     1915               return error.
     1916           end.
     1917       end.
     1918       else do:
     1919           assign
     1920               v-torgconf-self-host-code = v-host-code
     1921           .
     1922       end.
     1923       if v-torgconf-self-host-code = 0
     1924       then do:
     1925           assign
     1926               v-torgconf-self-host-name           = "":U
     1927               v-torgconf-self-host-addres         = "":U
     1928               v-torgconf-self-host-post-addres    = "":U
     1929               v-torgconf-self-host-phone          = "":U
     1930               v-torgconf-self-host-inn            = "":U
     1931               v-torgconf-self-host-kpp            = "":U
     1932               v-torgconf-self-host-okpo           = "":U
     1933               v-torgconf-self-host-egrip-date     = "":U
     1934               v-torgconf-self-host-egrip-num      = "":U
     1935           .
     1936       end.
     1937       else do:
     1938           run fmtcli-get-client in this-procedure (
     1939                 input 'орг':U
     1940               , input v-torgconf-self-host-code
     1941           ).
     1942           assign
     1943               v-torgconf-self-host-name        = v-fmtcli-name
     1944               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1945               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1946               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1947               v-torgconf-self-host-phone       = v-fmtcli-phone
     1948               v-torgconf-self-host-inn         = v-fmtcli-inn
     1949               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1950               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1951           .
     1952           run gbl/clntat-v.p (
     1953                 input 'орг':U
     1954               , input v-torgconf-self-host-code
     1955               , input 'egrip-date':U
     1956               , output v-torgconf-self-host-egrip-date
     1957               , output v-par-type
     1958           ).
     1959           run gbl/clntat-v.p (
     1960                 input 'орг':U
     1961               , input v-torgconf-self-host-code
     1962               , input 'egrip-num':U
     1963               , output v-torgconf-self-host-egrip-num
     1964               , output v-par-type
     1965           ).
     1966           run fmtcli-get-bank in this-procedure (
     1967                 input v-host-code
     1968               , input 'орг':U
     1969               , input v-torgconf-self-host-code
     1970               , input p-curr-code
     1971           ).
     1972       end.
     1973       assign
     1974           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1975           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1976           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1977           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1978           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1979           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1980           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1981           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1982       .
     1983       assign
     1984           v-torgconf-self-obj-type = p-obj-type
     1985           v-torgconf-self-obj-code = p-obj-code
     1986       .
     1987       run fmtcli-get-client in this-procedure (
     1988             input p-obj-type
     1989           , input p-obj-code
     1990       ).
     1991       assign
     1992           v-torgconf-self-obj-name       = v-fmtcli-name
     1993           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1994           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1995           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1996           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1997           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1998           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1999       .
     2000   end.
     2001   end procedure.
     2002   procedure torgconf-get-recepient-param :
     2003   define input parameter torgconfdoc-code   as character                  no-undo.
     2004   define output parameter v-code-rec        as integer                    no-undo .
     2005   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     2006   define output parameter v-codefirm-rec    as integer                    no-undo .
     2007   define output parameter v-curcode-rec     as integer                    no-undo .
     2008        define variable  v-recipient-code  as character                  no-undo .
     2009        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     2010        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     2011   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     2012                           input 'Recipient':U ,
     2013                          output v-recipient-code ,
     2014                          output v-trdcattr-type ) no-error .
     2015       if error-status :error then do:
     2016        message
     2017         vss-workfile vss-revision vss-description skip
     2018         "Ошибка при вызове процедуры tdat-val":U skip
     2019         "Документ: " torgconfdoc-code skip
     2020         "Атрибут: " 'Recipient':U skip
     2021         "Значение: " v-recipient skip
     2022         trim( error-status :get-message (1) ) skip
     2023         return-value skip
     2024         view-as alert-box error.
     2025       undo, return error return-value.
     2026       end.
     2027     assign
     2028       v-recipient  = v-recipient-code
     2029       v-type-rec = substring(v-recipient-code,1,3)
     2030       v-code-rec  = int(substring(v-recipient-code,4,15))
     2031       no-error
     2032     .
     2033     if v-type-rec = ? then v-type-rec = "" .
     2034     if v-code-rec  = ? then v-code-rec  =  0 .
     2035     end procedure.
