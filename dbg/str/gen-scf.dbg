        1   block-level on error undo, throw.
        2   DEFINE INPUT  PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        3   define input  parameter p-ri   as recid     no-undo .
        4   define input  parameter p-type as character no-undo .
        5   define output parameter p-list as character no-undo .
        6   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile: gen-scf.p $":U .
       10   define variable vss-archive     as character no-undo initial "$Archive: str/gen-scf.p $":U .
       11   define variable vss-description as character no-undo initial "Генерация счета-фактуры":U .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   procedure factord :
       74     define input  parameter p-fact-date            as date    no-undo .
       75     define input  parameter p-fact-time            as integer no-undo .
       76     define input  parameter p-fact-num             as integer no-undo .
       77     define input  parameter p-shift-date           as date    no-undo .
       78     define input  parameter p-shift-num            as integer no-undo .
       79     define input  parameter p-shift-on             as logical no-undo .
       80     define output parameter p-fact-order           as decimal no-undo .
       81     define output parameter p-shift-end-fact-order as decimal no-undo .
       82     define output parameter p-day-end-fact-order   as decimal no-undo .
       83     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       84     if p-fact-date = ?
       85     then do:
       86       return error "Не указана фактическая дата" .
       87     end.
       88     define variable v-fact-date-num as integer no-undo .
       89     assign
       90       v-fact-date-num = integer(p-fact-date)
       91     .
       92     if p-fact-num = ?
       93     or p-fact-num = 0
       94     then do:
       95       return error "Не задан p-fact-num " + string(p-fact-num) .
       96     end.
       97     if p-fact-num < 0
       98     then do:
       99       return error "Отрицательный fact-num " + string(p-fact-num) .
      100     end.
      101     if p-fact-num >= 100000000
      102     then do:
      103       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      104     end.
      105     if p-shift-on = true
      106     then do:
      107       if p-shift-date = ?
      108       then do:
      109         return error "Не задана дата смены" .
      110       end.
      111       if p-shift-num = ?
      112       or p-shift-num = 0
      113       then do:
      114         return error "Не задан номер смены" .
      115       end.
      116     end.
      117     else do:
      118       assign
      119         p-shift-date = p-fact-date
      120         p-shift-num  = 24
      121       .
      122     end.
      123     define variable v-shift-offset as integer no-undo .
      124     if p-shift-date = p-fact-date
      125     then do:
      126       assign
      127         v-shift-offset = 1
      128       .
      129     end.
      130     if p-shift-date < p-fact-date
      131     then do:
      132       assign
      133         v-shift-offset = 0
      134       .
      135     end.
      136     if p-shift-date > p-fact-date
      137     then do:
      138       message
      139         vss-workfile vss-revision vss-description skip
      140         "Неправильная дата закрытия смены" skip
      141         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      142         view-as alert-box error .
      143       undo, return error
      144         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      145           ,string(p-fact-date, '99/99/9999':U)
      146           ,string(p-shift-date, '99/99/9999':U)
      147           )
      148       .
      149     end.
      150     if p-shift-num < 1
      151     or p-shift-num > 24
      152     then do:
      153       message
      154         vss-workfile vss-revision vss-description skip
      155         "Неправильный номер смены" skip
      156         "p-shift-num" p-shift-num skip
      157         view-as alert-box error .
      158       undo, return error return-value .
      159     end.
      160     assign
      161       p-fact-order           = v-fact-date-num
      162                              + v-shift-offset * 0.5
      163                              + p-shift-num    * 0.02 - 0.01
      164                              + p-fact-num     * 0.0000000001
      165       p-shift-end-fact-order = v-fact-date-num
      166                              + v-shift-offset * 0.5
      167                              + p-shift-num    * 0.02
      168       p-day-end-fact-order   = v-fact-date-num
      169                              + 0.99
      170     .
      171     if p-fact-order           <= v-fact-date-num
      172     or p-shift-end-fact-order <= v-fact-date-num
      173     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      174     or p-shift-end-fact-order >= p-day-end-fact-order
      175     then do:
      176       message
      177         vss-workfile vss-revision vss-description skip
      178         "Внутренняя ошибка при генерации фактического номера" skip
      179         "p-fact-date"            p-fact-date            skip
      180         "p-fact-time"            p-fact-time            skip
      181         "p-fact-num"             p-fact-num             skip
      182         "p-shift-date"           p-shift-date           skip
      183         "p-shift-num"            p-shift-num            skip
      184         "p-shift-on"             p-shift-on             skip
      185         "p-shift-end-fact-order" p-shift-end-fact-order skip
      186         "p-day-end-fact-order"   p-day-end-fact-order   skip
      187         "v-fact-date-num"        v-fact-date-num        skip
      188         view-as alert-box error .
      189       undo, return error return-value .
      190     end.
      191   end procedure.
      192   procedure day-begin-fact-order :
      193     define input  parameter p-fact-date            as date    no-undo .
      194     define output parameter p-day-begin-fact-order as decimal no-undo .
      195     do
      196     on error undo, return error return-value
      197     :
      198       if p-fact-date = ?
      199       then do:
      200         assign
      201           p-day-begin-fact-order = 0
      202         .
      203       end.
      204       else do:
      205         assign
      206           p-day-begin-fact-order = integer(p-fact-date)
      207         .
      208       end.
      209     end.
      210   end procedure.
      211   procedure factord-max-fact-order :
      212     define output parameter p-max-fact-order as decimal   no-undo .
      213     do
      214     on error undo, return error return-value
      215     :
      216       run day-begin-fact-order in this-procedure
      217         (input  date(1, 1, 5000)
      218         ,output p-max-fact-order
      219         ) .
      220     end.
      221   end procedure.
      222   procedure factord-cut-archive :
      223     define input  parameter p-obj-type             as character no-undo .
      224     define input  parameter p-obj-code             as integer   no-undo .
      225     define input  parameter p-fact-date            as date      no-undo .
      226     define output parameter p-shift-on             as logical   no-undo .
      227     define output parameter p-shift-date           as date      no-undo .
      228     define output parameter p-shift-num            as integer   no-undo .
      229     define output parameter p-day-end-fact-order   as decimal   no-undo .
      230     define output parameter p-shift-end-fact-order as decimal   no-undo .
      231     define variable v-fact-order as decimal   no-undo .
      232     define buffer buf_shift-obj for ub.shift-obj .
      233     do
      234     on error undo, return error return-value
      235     :
      236   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      238     (input  p-obj-type
      239     ,input  p-obj-code
      240     ,input  'shift-on=request'
      241     ,output p-shift-on
      242     ) no-error .
      243       if error-status :error
      244       then do:
      245         message
      246           vss-workfile vss-revision vss-description skip
      247           "Ошибка при определении атрибута объекта" skip
      248           "Объект" p-obj-type p-obj-code skip
      249           error-status :get-message(1) skip
      250           return-value skip
      251           view-as alert-box error .
      252         undo, return error return-value .
      253       end.
      254       if p-shift-on = false
      255       then do:
      256         assign
      257           p-shift-date               = ?
      258           p-shift-num                = 0
      259         .
      260       end.
      261       else do:
      262         find first buf_shift-obj share-lock
      263           where buf_shift-obj.obj-type   = p-obj-type
      264             and buf_shift-obj.obj-code   = p-obj-code
      265             and buf_shift-obj.shift-date > p-fact-date
      266           use-index pi
      267           no-error .
      268         if not available buf_shift-obj
      269         or buf_shift-obj.status_ <> 'зкр':U
      270         then do:
      271           message
      272             vss-workfile vss-revision vss-description skip
      273             "Невозможно вычислить последнюю смену" skip
      274             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      275             "Объект" p-obj-type p-obj-code skip
      276             "Дата" p-fact-date skip
      277             view-as alert-box error .
      278           undo, return error return-value .
      279         end.
      280         find last buf_shift-obj share-lock
      281           where buf_shift-obj.obj-type = p-obj-type
      282             and buf_shift-obj.obj-code = p-obj-code
      283             and buf_shift-obj.shift-date <= p-fact-date
      284           use-index pi
      285           no-error .
      286         if available buf_shift-obj
      287         then do:
      288           if  buf_shift-obj.status_ = 'зкр':U
      289           then do:
      290             assign
      291               p-shift-date = buf_shift-obj.shift-date
      292               p-shift-num  = buf_shift-obj.shift-num
      293             .
      294           end.
      295           else do:
      296             message
      297               vss-workfile vss-revision vss-description skip
      298               "Невозможно вычислить последнюю смену" skip
      299               "Статус смены отличен от статуса" 'зкр':U skip
      300               "Объект" p-obj-type p-obj-code skip
      301               "Дата" p-fact-date skip
      302               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      303               view-as alert-box error .
      304             undo, return error return-value .
      305           end.
      306         end.
      307         else do:
      308           assign
      309             p-shift-date = p-fact-date - 1
      310             p-shift-num  = 1
      311           .
      312         end.
      313       end.
      314       run factord in this-procedure
      315         (input  p-fact-date
      316         ,input  1
      317         ,input  1
      318         ,input  p-shift-date
      319         ,input  p-shift-num
      320         ,input  p-shift-on
      321         ,output v-fact-order
      322         ,output p-shift-end-fact-order
      323         ,output p-day-end-fact-order
      324         ) no-error .
      325       if error-status :error
      326       then do:
      327         message
      328           vss-workfile vss-revision vss-description skip
      329           "Ошибка при вызове процедуры factord"
      330           error-status :get-message(1) skip
      331           return-value skip
      332           view-as alert-box error .
      333         undo, return error return-value .
      334       end.
      335     end.
      336   end procedure.
      337   procedure factord-lock-shift :
      338     define input  parameter p-obj-type  as character no-undo .
      339     define input  parameter p-obj-code  as integer   no-undo .
      340     define input  parameter p-fact-date as date      no-undo .
      341     define parameter buffer buf_shift-obj for ub.shift-obj .
      342     define variable v-shift-on      as logical   no-undo .
      343     define variable v-extra-message as character no-undo .
      344     define variable v-error as character no-undo .
      345     do
      346     on error undo, return error return-value
      347     :
      348   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      349   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      350     (input  p-obj-type
      351     ,input  p-obj-code
      352     ,input  'shift-on=request'
      353     ,output v-shift-on
      354     ) no-error .
      355       if error-status :error
      356       then do:
      357         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      358         undo, return error v-error .
      359       end.
      360       if v-shift-on = true
      361       then do:
      362         find first buf_shift-obj share-lock
      363           where buf_shift-obj.obj-type   = p-obj-type
      364             and buf_shift-obj.obj-code   = p-obj-code
      365             and buf_shift-obj.shift-date > p-fact-date
      366           use-index pi
      367           no-error .
      368         if not available buf_shift-obj
      369         or buf_shift-obj.status_ <> 'зкр':U
      370         then do:
      371           find last buf_shift-obj
      372             where buf_shift-obj.obj-type = p-obj-type
      373               and buf_shift-obj.obj-code = p-obj-code
      374               and buf_shift-obj.status_  = 'зкр':U
      375             use-index stts
      376             no-error .
      377           if available buf_shift-obj
      378           then do:
      379             assign
      380               v-extra-message =
      381                     substitute("Дата начала последеней закрытой смены на объекте &1"
      382                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      383                               )
      384             .
      385           end.
      386           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      387           undo, return error v-error .
      388         end.
      389       end.
      390     end.
      391   end procedure.
      392   procedure factord-end-day :
      393     define input  parameter p-fact-date            as date    no-undo .
      394     define output parameter p-day-end-fact-order   as decimal no-undo .
      395     do
      396     on error undo, return error return-value
      397     :
      398       if p-fact-date = ?
      399       then do:
      400         return error "Не указана фактическая дата" .
      401       end.
      402       assign
      403         p-day-end-fact-order = integer(p-fact-date) + 0.99
      404       .
      405     end.
      406   end procedure.
      407   procedure factord-to-date :
      408     define input  parameter p-fact-order as decimal no-undo .
      409     define output parameter p-fact-date  as date    no-undo .
      410     define variable v-ref-date  as date      no-undo .
      411     define variable v-ref-delta as integer   no-undo .
      412     do
      413     on error undo, return error return-value
      414     :
      415       if p-fact-order = ?
      416       or p-fact-order = 0
      417       then do:
      418         return error "Не указан fact-order" .
      419       end.
      420       assign
      421         v-ref-date  = date(1, 1, 2000)
      422       .
      423       assign
      424         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      425       .
      426       assign
      427         p-fact-date = v-ref-date + v-ref-delta
      428       .
      429     end.
      430   end procedure.
      431   procedure factord-to-fact-num :
      432     define input  parameter p-fact-order as decimal no-undo .
      433     define output parameter p-fact-num   as integer no-undo .
      434     define variable v-fact-order-trunc as decimal no-undo .
      435     do
      436     on error undo, return error return-value
      437     :
      438       if p-fact-order = ?
      439       or p-fact-order = 0
      440       then do:
      441         return error "Не указан fact-order" .
      442       end.
      443       assign
      444        v-fact-order-trunc = truncate(p-fact-order, 2)
      445       .
      446       assign
      447         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      448       .
      449     end.
      450   end procedure.
      451   procedure factord-to-shift-num :
      452     define input  parameter p-fact-order as decimal no-undo .
      453     define output parameter p-shift-num   as integer no-undo .
      454     define variable  p-shift-numd  as decimal   no-undo .
      455     define variable v-fact-order-trunc as decimal no-undo .
      456     do
      457     on error undo, return error return-value
      458     :
      459       if p-fact-order = ?
      460       or p-fact-order = 0
      461       then do:
      462         return error "Не указан fact-order" .
      463       end.
      464       assign
      465        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      466       .
      467       if v-fact-order-trunc < 0.5 then do:
      468         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      469       end.
      470       assign
      471         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      472         .
      473        assign
      474         p-shift-num = truncate (p-shift-numd , 0)
      475       .
      476     end.
      477   end procedure.
      478   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   procedure cur-time :
      480      define output parameter p-today as date      no-undo .
      481      define output parameter p-time  as integer   no-undo .
      482     do
      483     on error undo, return error
      484     :
      485       define variable v-date1 as date      no-undo .
      486       define variable v-date2 as date      no-undo .
      487       define variable v-time  as integer   no-undo .
      488       assign
      489         v-date1 = today
      490         v-time  = time
      491         v-date2 = today
      492       .
      493       if v-date1 <> v-date2
      494       then do:
      495         assign
      496           v-date1 = today
      497           v-time  = v-time
      498         .
      499       end.
      500       assign
      501         p-today = v-date1
      502         p-time  = v-time
      503       .
      504     end.
      505   end.
      506   function cur-time-date returns character
      507   :
      508     return string(today, '99/99/9999':U) .
      509   end.
      510   function cur-time-mjd returns decimal
      511   :
      512     define variable v-date as date      no-undo .
      513     define variable v-time as integer   no-undo .
      514     run cur-time in this-procedure
      515       (output v-date
      516       ,output v-time
      517       ) .
      518     return integer(v-date) - 2400002 + (v-time / 86400) .
      519   end.
      520   function cur-time-get-ending-index returns integer
      521   (input p-number as integer
      522   )
      523   :
      524     if p-number < 0
      525     or p-number = ?
      526     then do:
      527       return 1 .
      528     end.
      529     define variable v-rest as integer   no-undo .
      530     assign
      531       p-number = p-number modulo 100
      532     .
      533     if p-number < 20
      534     then do:
      535       assign
      536         v-rest = p-number
      537       .
      538     end.
      539     else do:
      540       assign
      541         v-rest = p-number modulo 10
      542       .
      543     end.
      544     case v-rest :
      545       when 1
      546       then do:
      547         return 2 .
      548       end.
      549       when 2 or
      550       when 3 or
      551       when 4
      552       then do:
      553         return 3 .
      554       end.
      555       otherwise do:
      556         return 1 .
      557       end.
      558     end case .
      559   end.
      560   procedure cur-time-mjd-to-date :
      561      define input  parameter i-mjd-diff as decimal no-undo.
      562      define output parameter o-Date     as date    no-undo.
      563      define output parameter o-Time     as integer no-undo.
      564      define variable v-day-number as integer   no-undo .
      565      if    i-mjd-diff < 0
      566         or i-mjd-diff = ?
      567      then do:
      568         return "?" .
      569      end.
      570      assign
      571         v-day-number = truncate(i-mjd-diff,0).
      572         o-Date = date(v-day-number + 2400002).
      573         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      574     .
      575   end.
      576   function cur-time-mjd-to-string returns character
      577   (input p-mjd-diff as decimal
      578   )
      579   :
      580     define variable v-day-number as integer   no-undo .
      581     define variable v-seconds    as integer   no-undo .
      582     define variable v-hour       as integer   no-undo .
      583     define variable v-min        as integer   no-undo .
      584     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      585     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      586     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      587     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      588     if p-mjd-diff < 0
      589     or p-mjd-diff = ?
      590     then do:
      591       return "?" .
      592     end.
      593     assign
      594       v-day-number = integer(truncate(p-mjd-diff,0))
      595       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      596     .
      597     if v-seconds > 86400
      598     then do:
      599       assign
      600         v-seconds = 86400 - 1
      601       .
      602     end.
      603     if v-seconds < 0
      604     then do:
      605       assign
      606         v-seconds = 0
      607       .
      608     end.
      609     assign
      610       v-hour = truncate(v-seconds / 3600, 0)
      611     .
      612     assign
      613       v-seconds = v-seconds modulo 3600
      614     .
      615     assign
      616       v-min = truncate(v-seconds / 60, 0)
      617     .
      618     assign
      619       v-seconds = v-seconds modulo 60
      620     .
      621     return
      622         (if v-day-number <> 0
      623           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      624           else ""
      625         )
      626       + (if v-day-number <> 0 or v-hour <> 0
      627           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      628           else ""
      629         )
      630       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      631           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      632           else ""
      633         )
      634       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      635       .
      636   end.
      637   function cur-time-string returns character
      638   :
      639     define variable v-date as date      no-undo .
      640     define variable v-time as integer   no-undo .
      641     run cur-time in this-procedure
      642       (output v-date
      643       ,output v-time
      644       ) .
      645     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      646   end.
      647   function cur-time-string-sec returns character
      648   :
      649     define variable v-date as date      no-undo .
      650     define variable v-time as integer   no-undo .
      651     run cur-time in this-procedure
      652       (output v-date
      653       ,output v-time
      654       ) .
      655     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      656   end.
      657   function cur-time-custom  returns character
      658   (input p-prefix as character
      659   ,input p-date-format as character
      660   ,input p-delimiter as character
      661   ,input p-time-format as character
      662   ,input p-suffix as character
      663   )
      664   :
      665     define variable v-date as date      no-undo .
      666     define variable v-time as integer   no-undo .
      667     run cur-time in this-procedure
      668       (output v-date
      669       ,output v-time
      670       ) .
      671     return
      672       p-prefix
      673       + string(v-date, p-date-format)
      674       + p-delimiter
      675       + string(v-time, p-time-format)
      676       + p-suffix
      677       .
      678   end.
      679   function cur-time-print  returns character
      680   :
      681     define variable v-date as date      no-undo .
      682     define variable v-time as integer   no-undo .
      683     run cur-time in this-procedure
      684       (output v-date
      685       ,output v-time
      686       ) .
      687     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      688   end.
      689   function cur-time-datetime returns datetime
      690   :
      691     define variable v-char as character no-undo .
      692     define variable v-datetime as datetime no-undo .
      693     v-char = cur-time-string().
      694     v-datetime = datetime(v-char).
      695     return  v-datetime.
      696   end.
      697   function cur-time-string-msec returns character
      698   :
      699     define variable v-date as datetime  no-undo .
      700     v-date = now.
      701     return string(v-date) .
      702   end.
      703   define variable vss-include-info4 as character format "X(65)" no-undo
      704   initial "@(#)$Workfile$ $Revision$".
      705   define variable v-fmtcli-name          as character    no-undo.
      706   define variable v-fmtcli-engl-name     as character    no-undo.
      707   define variable v-fmtcli-addres        as character    no-undo.
      708   define variable v-fmtcli-post-addres   as character    no-undo.
      709   define variable v-fmtcli-full-addres   as character    no-undo.
      710   define variable v-fmtcli-phone         as character    no-undo.
      711   define variable v-fmtcli-inn           as character    no-undo.
      712   define variable v-fmtcli-kpp           as character    no-undo.
      713   define variable v-fmtcli-okpo          as character    no-undo.
      714   define variable v-fmtcli-country       as character    no-undo.
      715   define variable v-fmtcli-city          as character    no-undo.
      716   define variable v-fmtcli-index         as character    no-undo.
      717   define variable v-fmtcli-schet-exists  as logical      no-undo.
      718   define variable v-fmtcli-bank-exists   as logical      no-undo.
      719   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      720   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      721   define variable v-fmtcli-bank-bik      as character    no-undo.
      722   define variable v-fmtcli-bank-name     as character    no-undo.
      723   define variable v-fmtcli-bank-addres   as character    no-undo.
      724   define variable v-fmtcli-bank-city     as character    no-undo.
      725   procedure fmtcli-get-bank :
      726   define input parameter p-host-code      as integer          no-undo.
      727   define input parameter p-obj-type       as character        no-undo.
      728   define input parameter p-obj-code       as integer          no-undo.
      729   define input parameter p-curr-code      as integer          no-undo.
      730       define buffer buf_fin-schet     for ub.fin-schet.
      731       define buffer buf_fin-bank      for ub.fin-bank.
      732   do
      733   for buf_fin-schet
      734     , buf_fin-bank
      735   on error undo, return error
      736   :
      737       assign
      738           v-fmtcli-schet-exists       = no
      739           v-fmtcli-bank-exists        = no
      740           v-fmtcli-bank-r-schet       = "":U
      741           v-fmtcli-bank-c-schet       = "":U
      742           v-fmtcli-bank-bik           = "":U
      743           v-fmtcli-bank-name          = "":U
      744           v-fmtcli-bank-addres        = "":U
      745           v-fmtcli-bank-city          = "":U
      746       .
      747       search-for-schet:
      748       for each buf_fin-schet no-lock
      749          where buf_fin-schet.host-code = p-host-code
      750            and buf_fin-schet.cli-type  = p-obj-type
      751            and buf_fin-schet.cli-code  = p-obj-code
      752            and buf_fin-schet.curr-code = p-curr-code
      753       on error undo, return error
      754       :
      755           if buf_fin-schet.status_   = 'удал':U
      756           then do:
      757           end.
      758           else do:
      759               assign
      760                   v-fmtcli-schet-exists   = yes
      761                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      762                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      763               .
      764               find first buf_fin-bank no-lock
      765                    where buf_fin-bank.host-code = p-host-code
      766                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      767               no-error.
      768               if available buf_fin-bank
      769               then do:
      770                   assign
      771                       v-fmtcli-bank-exists      = yes
      772                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      773                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      774                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      775                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      776                   .
      777               end.
      778               else do:
      779                   assign
      780                       v-fmtcli-bank-exists    = no
      781                       v-fmtcli-bank-bik       = "":U
      782                       v-fmtcli-bank-name      = "":U
      783                       v-fmtcli-bank-addres    = "":U
      784                       v-fmtcli-bank-city      = "":U
      785                   .
      786               end.
      787               leave search-for-schet.
      788           end.
      789       end.
      790   end.
      791   end procedure.
      792   procedure fmtcli-get-client :
      793   define input parameter p-obj-type       as character    no-undo.
      794   define input parameter p-obj-code       as integer      no-undo.
      795       define variable v-temp-fmtcli-address      as character     no-undo.
      796       define variable v-num-country-city    as integer      no-undo.
      797       define buffer buf_clients   for ub.clients.
      798       define buffer buf_firm      for ub.firm.
      799       define buffer buf_store     for ub.store.
      800       define buffer buf_shop      for ub.shop.
      801       define buffer buf_person    for ub.person.
      802   do
      803   for buf_clients
      804     , buf_firm
      805     , buf_store
      806     , buf_shop
      807     , buf_person
      808   on error undo, return error
      809   :
      810       assign
      811           v-fmtcli-name           = "":U
      812           v-fmtcli-addres         = "":U
      813           v-fmtcli-post-addres    = "":U
      814           v-fmtcli-full-addres    = "":U
      815           v-fmtcli-phone          = "":U
      816           v-fmtcli-inn            = "":U
      817           v-fmtcli-kpp            = "":U
      818           v-fmtcli-okpo           = "":U
      819           v-fmtcli-city           = "":U
      820           v-fmtcli-index          = "":U
      821           v-fmtcli-country        = "":U
      822       .
      823       find first buf_clients no-lock
      824            where buf_clients.obj-type = p-obj-type
      825              and buf_clients.obj-code = p-obj-code
      826       .
      827       assign
      828           v-fmtcli-name = buf_clients.obj-name
      829       .
      830       case buf_clients.obj-type:
      831          when 'орг':U
      832          then do:
      833               find first buf_firm no-lock
      834                    where buf_firm.firm-code = buf_clients.obj-code
      835                    no-error
      836               .
      837               if available buf_firm
      838               then do:
      839                   assign
      840                       v-num-country-city = num-entries( buf_firm.city )
      841                       v-fmtcli-engl-name = buf_firm.engl-name
      842                   .
      843                   if v-num-country-city > 0
      844                   then do:
      845                       assign
      846                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      847                       .
      848                   end.
      849                   if v-num-country-city > 1
      850                   then do:
      851                       assign
      852                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      853                       .
      854                   end.
      855                   run fmtcli-concatenate-strings in this-procedure (
      856                         input v-fmtcli-full-addres
      857                       , input v-fmtcli-country
      858                       , input ", ":U
      859                       , input 50
      860                       , output v-fmtcli-full-addres
      861                   ).
      862                   run fmtcli-concatenate-strings in this-procedure (
      863                         input v-fmtcli-full-addres
      864                       , input v-fmtcli-city
      865                       , input ", ":U
      866                       , input 50
      867                       , output v-fmtcli-full-addres
      868                   ).
      869                   run fmtcli-concatenate-strings in this-procedure (
      870                         input v-fmtcli-full-addres
      871                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      872                       , input ", ":U
      873                       , input 50
      874                       , output v-fmtcli-full-addres
      875                   ).
      876                   run fmtcli-concatenate-strings in this-procedure (
      877                         input v-fmtcli-post-addres
      878                       , input v-fmtcli-country
      879                       , input ", ":U
      880                       , input 50
      881                       , output v-fmtcli-post-addres
      882                   ).
      883                   run fmtcli-concatenate-strings in this-procedure (
      884                         input v-fmtcli-post-addres
      885                       , input v-fmtcli-city
      886                       , input ", ":U
      887                       , input 50
      888                       , output v-fmtcli-post-addres
      889                   ).
      890                   run fmtcli-concatenate-strings in this-procedure (
      891                         input v-fmtcli-post-addres
      892                       , input string( buf_firm.ind )
      893                       , input ", ":U
      894                       , input 50
      895                       , output v-fmtcli-post-addres
      896                   ).
      897                   run fmtcli-concatenate-strings in this-procedure (
      898                         input substring( buf_firm.addres1, 1, 50 )
      899                       , input buf_firm.addres2
      900                       , input " ":U
      901                       , input 50
      902                       , output v-temp-fmtcli-address
      903                   ).
      904                   run fmtcli-concatenate-strings in this-procedure (
      905                         input v-temp-fmtcli-address
      906                       , input substring( buf_firm.addres1, 51, 50 )
      907                       , input " ":U
      908                       , input 50
      909                       , output v-temp-fmtcli-address
      910                   ).
      911                   run fmtcli-concatenate-strings in this-procedure (
      912                         input v-temp-fmtcli-address
      913                       , input substring( buf_firm.addres1, 101, 50 )
      914                       , input " ":U
      915                       , input 50
      916                       , output v-temp-fmtcli-address
      917                   ).
      918                   assign
      919                       v-fmtcli-addres = v-temp-fmtcli-address
      920                   .
      921                   if buf_firm.addres1 <> ?
      922                   then do:
      923                       run fmtcli-concatenate-strings in this-procedure (
      924                             input v-fmtcli-full-addres
      925                           , input v-fmtcli-addres
      926                           , input ", ":U
      927                           , input 0
      928                           , output v-fmtcli-full-addres
      929                       ).
      930                   end.
      931                   run fmtcli-concatenate-strings in this-procedure (
      932                         input substring( buf_firm.post-addr1, 1, 50 )
      933                       , input buf_firm.post-addr2
      934                       , input " ":U
      935                       , input 50
      936                       , output v-fmtcli-post-addres
      937                   ).
      938                   run fmtcli-concatenate-strings in this-procedure (
      939                         input v-fmtcli-post-addres
      940                       , input substring( buf_firm.post-addr1, 51, 50 )
      941                       , input " ":U
      942                       , input 50
      943                       , output v-fmtcli-post-addres
      944                   ).
      945                   run fmtcli-concatenate-strings in this-procedure (
      946                         input v-fmtcli-post-addres
      947                       , input substring( buf_firm.post-addr1, 101, 50 )
      948                       , input " ":U
      949                       , input 50
      950                       , output v-fmtcli-post-addres
      951                   ).
      952                   assign
      953                       v-fmtcli-phone         = buf_firm.phone
      954                       v-fmtcli-inn           = buf_firm.inn
      955                       v-fmtcli-kpp           = buf_firm.kpp
      956                       v-fmtcli-okpo          = buf_firm.okpo
      957                       v-fmtcli-index         = string( buf_firm.ind )
      958                   .
      959               end.
      960          end.
      961          when 'маг':U
      962          then do:
      963               find first buf_shop no-lock
      964                    where buf_shop.obj-code = buf_clients.obj-code
      965               .
      966               if available buf_shop
      967               then do:
      968                   run fmtcli-concatenate-strings in this-procedure (
      969                         input buf_shop.addres1
      970                       , input buf_shop.addres2
      971                       , input " ":U
      972                       , input 50
      973                       , output v-fmtcli-addres
      974                   ).
      975                   assign
      976                       v-fmtcli-full-addres = v-fmtcli-addres
      977                       v-fmtcli-post-addres = v-fmtcli-addres
      978                       v-fmtcli-phone       = buf_shop.phone
      979                       v-fmtcli-inn         = "":U
      980                       v-fmtcli-kpp         = "":U
      981                       v-fmtcli-okpo        = "":U
      982                       v-fmtcli-city        = "":U
      983                       v-fmtcli-index       = "":U
      984                   .
      985               end.
      986          end.
      987          when 'скл':U
      988          then do:
      989               find first buf_store no-lock
      990                    where buf_store.obj-code = buf_clients.obj-code
      991               .
      992               if available buf_store
      993               then do:
      994                   run fmtcli-concatenate-strings in this-procedure (
      995                         input buf_store.addres1
      996                       , input buf_store.addres2
      997                       , input " ":U
      998                       , input 50
      999                       , output v-fmtcli-addres
     1000                   ).
     1001                   assign
     1002                       v-fmtcli-full-addres = v-fmtcli-addres
     1003                       v-fmtcli-phone       = buf_store.phone
     1004                       v-fmtcli-inn         = "":U
     1005                       v-fmtcli-kpp         = "":U
     1006                       v-fmtcli-okpo        = "":U
     1007                       v-fmtcli-city        = "":U
     1008                       v-fmtcli-index       = "":U
     1009                   .
     1010               end.
     1011          end.
     1012          when 'чел':U
     1013          then do:
     1014               find first buf_person no-lock
     1015                    where buf_person.psn-code = buf_clients.obj-code
     1016               .
     1017               if available buf_person
     1018               then do:
     1019                   run fmtcli-concatenate-strings in this-procedure (
     1020                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1021                                 then "":U
     1022                                 else string( buf_person.ind, "999999")
     1023                                 )
     1024                       , input buf_person.city
     1025                       , input ", ":U
     1026                       , input 0
     1027                       , output v-fmtcli-full-addres
     1028                   ).
     1029                   assign
     1030                       v-fmtcli-addres = buf_person.address
     1031                   .
     1032                   run fmtcli-concatenate-strings in this-procedure (
     1033                         input v-fmtcli-full-addres
     1034                       , input v-fmtcli-addres
     1035                       , input ", ":U
     1036                       , input 0
     1037                       , output v-fmtcli-full-addres
     1038                   ).
     1039                   assign
     1040                       v-fmtcli-phone     = buf_person.phone1
     1041                       v-fmtcli-inn       = buf_person.inn
     1042                       v-fmtcli-kpp       = buf_person.kpp
     1043                       v-fmtcli-okpo      = buf_person.okpo
     1044                       v-fmtcli-city      = buf_person.city
     1045                       v-fmtcli-index     = string( buf_person.ind )
     1046                   .
     1047               end.
     1048          end.
     1049       end case.
     1050   end.
     1051   end procedure.
     1052   procedure fmtcli-concatenate-strings :
     1053   define input parameter p-string-1       as character        no-undo.
     1054   define input parameter p-string-2       as character        no-undo.
     1055   define input parameter p-delimiter      as character        no-undo.
     1056   define input parameter p-length         as integer          no-undo.
     1057   define output parameter p-out-string    as character        no-undo.
     1058   do
     1059   on error undo, return error
     1060   :
     1061       assign
     1062           p-out-string = ( if p-string-1 = ?
     1063                            then "":U
     1064                            else trim( p-string-1 ) )
     1065       .
     1066       assign
     1067           p-out-string = p-out-string
     1068                        + ( if p-out-string = "":U
     1069                            or length( p-out-string ) = p-length
     1070                            or p-string-2 = ?
     1071                            or trim( p-string-2 ) = "":U
     1072                            then "":U
     1073                            else p-delimiter )
     1074                        + ( if p-string-2 = ?
     1075                            or trim( p-string-2 ) = "":U
     1076                            then "":U
     1077                            else trim( p-string-2 ) )
     1078       .
     1079   end.
     1080   end procedure.
     1081   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1082   define new global shared variable g#attr-lib  as handle no-undo .
     1083   define variable v-attr-lib-variable as handle no-undo .
     1084   procedure clntattr-code :
     1085     define input  parameter p-code           as character no-undo .
     1086     define output parameter p-type           as character no-undo .
     1087     define output parameter p-format         as character no-undo .
     1088     define output parameter p-label          as character no-undo .
     1089     define output parameter p-user-can-edit  as logical   no-undo .
     1090     define output parameter p-output-display as logical   no-undo .
     1091     define output parameter p-other          as character no-undo .
     1092     do
     1093     on error undo, return error return-value
     1094     :
     1095           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
     1096         (input  p-code
     1097         ,output p-type
     1098         ,output p-format
     1099         ,output p-label
     1100         ,output p-user-can-edit
     1101         ,output p-output-display
     1102         ,output p-other
     1103         ) no-error .
     1104       if error-status :error
     1105       then do:
     1106         undo, return error return-value .
     1107       end.
     1108     end.
     1109   end procedure.
     1110   procedure clntattr-tooltip :
     1111     define input  parameter p-code    as character no-undo .
     1112     define output parameter p-tooltip as character no-undo .
     1113     define output parameter p-label   as character no-undo .
     1114     do
