     4315   procedure torgconf-get-reason  :
     4316   define input parameter  p-doc-code       as character        no-undo.
     4317   define input parameter  p-reason-code    as integer          no-undo .
     4318   define input parameter  p-doc-type       as character        no-undo.
     4319       if p-reason-code > 0
     4320       then do:
     4321           define buffer buf_trn-reason for ub.trn-reason.
     4322           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4323           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4324       end.
     4325       else do:
     4326           if p-doc-type = 'при':U
     4327           then  do:
     4328               define variable v-attr-type     as character    no-undo.
     4329               define variable v-attr-value    as character    no-undo.
     4330               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4331               assign v-torgconf-reason = v-attr-value .
     4332               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4333               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4334           end.
     4335       end.
     4336   end procedure.
