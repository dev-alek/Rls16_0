     5788   procedure clcprtsl_calc-line :
     5789   define input  parameter parrec-line as recid no-undo.
     5790   define variable v-tax-date         as   date                     no-undo.
     5791   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     5792   define variable varr-b             as   character                no-undo.
     5793   define variable varr-btype         as   character                no-undo.
     5794   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     5795   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     5796   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     5797   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     5798   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     5799   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     5800   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     5801   define variable varb-code          like ub.bar-code.b-code       no-undo.
     5802   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5803   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5804   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5805   define variable varexcise          like ub.price-list.excise     no-undo.
     5806   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     5807   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     5808   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     5809   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5810   define variable v-varsum           as decimal                  no-undo.
     5811   define variable varprice-salef as decimal   no-undo .
     5812   define buffer bf_trn-doc             for ub.trn-doc.
     5813   define buffer bf_doc-line            for ub.doc-line.
     5814   define buffer bf_gds-dtl             for ub.gds-dtl.
     5815   define buffer bf_goods               for ub.goods.
     5816   define buffer bf_parts               for ub.parts.
     5817   define buffer bf_sysconf             for ub.sysconf.
     5818   define buffer bf_tt-allsum-line      for tt-allsum-line.
     5819   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     5820   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     5821   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     5822   define buffer buf_parts        for ub.parts.
     5823   v-calcbypart = no.
     5824   do on error undo, return error return-value :
     5825   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5826   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5827     (output varr-b
     5828     )  .
     5829     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     5830     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     5831     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     5832                               bf_goods.prod-type = bf_doc-line.prod-type and
     5833                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     5834     if bf_trn-doc.fact-date <> ?        then do:
     5835       assign v-tax-date = bf_trn-doc.fact-date.
     5836     end.
     5837     else do:
     5838       assign v-tax-date = ?.
     5839     end.
