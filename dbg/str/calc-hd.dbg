        1   block-level on error undo, throw.
        2   define input parameter v-doc-code like ub.trn-doc.doc-code no-undo .
        3   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: calc-hd.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: str/calc-hd.p $":U .
        8   define variable vss-description as character no-undo initial "Пересчет шапки документа в учетных ценах, расчет величины автоматической переоценки":U .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1':U,v-doc-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#lib-trn  as handle no-undo .
       71   define new global shared variable g#lib-trn2 as handle no-undo .
       72   define new global shared variable g#lib-trn3 as handle no-undo .
       73   define new global shared variable g#lib-trn4 as handle no-undo .
       74   define variable v-total-doc-line_tot-ov    like ub.trn-doc.tot-ov    no-undo.
       75   define variable v-total-doc-line_fact-rubl like ub.trn-doc.fact-rubl no-undo.
       76   define variable v-total-doc-line_fact-base like ub.trn-doc.fact-base no-undo.
       77   define variable v-total-doc-line_fact-qnty like ub.trn-doc.fact-qnty no-undo.
       78   define variable v-total-doc-line_doc-qnty  like ub.trn-doc.doc-qnty  no-undo.
       79   define variable v-total-doc-line_cli-qnty  like ub.trn-doc.cli-qnty  no-undo.
       80   define variable v-total-trn-doc_tot-ov     like ub.trn-doc.tot-ov    no-undo.
       81   define variable v-total-trn-doc_fact-rubl  like ub.trn-doc.fact-rubl no-undo.
       82   define variable v-total-trn-doc_fact-base  like ub.trn-doc.fact-base no-undo.
       83   define variable v-total-trn-doc_fact-qnty  like ub.trn-doc.fact-qnty no-undo.
       84   define variable v-total-trn-doc_doc-qnty   like ub.trn-doc.doc-qnty  no-undo.
       85   define variable v-total-trn-doc_cli-qnty   like ub.trn-doc.cli-qnty  no-undo.
       86   define buffer bf_goods for ub.goods.
       87   do on error undo, return error return-value :
       88     assign
       89       v-total-trn-doc_tot-ov    = 0
       90       v-total-trn-doc_fact-rubl = 0
       91       v-total-trn-doc_fact-base = 0
       92       v-total-trn-doc_fact-qnty = 0
       93       v-total-trn-doc_doc-qnty  = 0
       94       v-total-trn-doc_cli-qnty  = 0
       95     .
       96     find first ub.trn-doc exclusive-lock where
       97                ub.trn-doc.doc-code = v-doc-code.
       98     if ub.trn-doc.doc-type <> 'инв':U then do:
       99       assign
      100         ub.trn-doc.doc-qnty  = 0.
      101     end.
      102     assign
      103       ub.trn-doc.fact-qnty = 0
      104       ub.trn-doc.cli-qnty  = 0
      105       ub.trn-doc.fact-base = 0
      106       ub.trn-doc.fact-rubl = 0
      107       ub.trn-doc.tot-ov    = 0
      108     .
      109     for each ub.doc-line no-lock where
      110              ub.doc-line.doc-code = ub.trn-doc.doc-code
      111     on error undo, return error return-value :
      112       find first bf_goods no-lock where
      113                  bf_goods.artic     = ub.doc-line.artic     and
      114                  bf_goods.prod-type = ub.doc-line.prod-type and
      115                  bf_goods.prod-code = ub.doc-line.prod-code no-error.
      116       if not available bf_goods then do:
      117         return error substitute( "Не найден товар &1 &2 &3."
      118                                , ub.doc-line.artic
      119                                , ub.doc-line.prod-type
      120                                , ub.doc-line.prod-code ).
      121       end.
      122   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_acc-cost in g#lib-trn
      123   (
      124    input  ub.doc-line.obj-type
      125   ,input  ub.doc-line.obj-code
      126   ,input  ub.doc-line.doc-code
      127   ,input  ub.doc-line.artic
      128   ,input  ub.doc-line.prod-type
      129   ,input  ub.doc-line.prod-code
      130   ,input  ub.doc-line.cli-qnty
      131   ,input  ub.doc-line.doc-qnty
      132   ,input  ub.doc-line.fact-qnty
      133   ,input  ub.doc-line.price-base
      134   ,input  ub.doc-line.price-rubl
      135   ,input  ''
      136   ,output v-total-doc-line_tot-ov
      137   ,output v-total-doc-line_fact-rubl
      138   ,output v-total-doc-line_fact-base
      139   ,output v-total-doc-line_fact-qnty
      140   ,output v-total-doc-line_doc-qnty
      141   ,output v-total-doc-line_cli-qnty
      142   )
      143   no-error.
      144        if error-status :error then do:
      145          return error return-value.
      146        end.
      147        assign
      148          v-total-trn-doc_tot-ov    = v-total-trn-doc_tot-ov    + v-total-doc-line_tot-ov
      149          v-total-trn-doc_fact-rubl = v-total-trn-doc_fact-rubl + v-total-doc-line_fact-rubl
      150          v-total-trn-doc_fact-base = v-total-trn-doc_fact-base + v-total-doc-line_fact-base
      151          v-total-trn-doc_fact-qnty = v-total-trn-doc_fact-qnty + v-total-doc-line_fact-qnty
      152          v-total-trn-doc_doc-qnty  = v-total-trn-doc_doc-qnty  + v-total-doc-line_doc-qnty
      153          v-total-trn-doc_cli-qnty  = v-total-trn-doc_cli-qnty  + v-total-doc-line_cli-qnty
      154        .
      155     end.
      156   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_ass-cost in g#lib-trn
      157   (
      158    input recid(ub.trn-doc)
      159   ,input v-total-trn-doc_tot-ov
      160   ,input v-total-trn-doc_fact-rubl
      161   ,input v-total-trn-doc_fact-base
      162   ,input v-total-trn-doc_fact-qnty
      163   ,input v-total-trn-doc_doc-qnty
      164   ,input v-total-trn-doc_cli-qnty
      165   ,input 0
      166   ,input 0
      167   ,input 0
      168   ,input 0
      169   ,input 0
      170   ,input 0
      171   )
      172   no-error.
      173     if error-status :error then do:
      174       undo, return error return-value.
      175     end.
      176   end.
