     1795            tt_fin-connect.base-rate      = buf_fin-ob.base-rate
     1796            tt_fin-connect.base-scale     = buf_fin-ob.base-scale
     1797            tt_fin-connect.contract-curr  = buf_fin-ob.contract-curr
     1798            tt_fin-connect.contract-rate  = buf_fin-ob.contract-rate
     1799            tt_fin-connect.contract-scale = buf_fin-ob.contract-scale
     1800            tt_fin-connect.exch-rate      = buf_fin-ob.exch-rate
     1801            tt_fin-connect.exch-scale     = buf_fin-ob.exch-scale
     1802            tt_fin-connect.status_        = 'тек':U
     1803            tt_fin-connect.sum-rubl-ob    = buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-rubl
     1804            tt_fin-connect.sum-base-ob    = buf_fin-ob.sum-base     - buf_fin-ob.con-sum-base
     1805            tt_fin-connect.sum-contr-ob   = buf_fin-ob.sum-contract - buf_fin-ob.con-sum-contr
     1806            tt_fin-connect.sum-rubl       = buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-rubl
     1807            tt_fin-connect.sum-base       = buf_fin-ob.sum-base     - buf_fin-ob.con-sum-base
     1808            tt_fin-connect.sum-doc        = buf_fin-ob.sum-doc      - buf_fin-ob.con-sum-doc
     1809            tt_fin-connect.sum-contr      = buf_fin-ob.sum-contr    - buf_fin-ob.con-sum-contr
     1810            tt_fin-connect.user-db-num = 0
     1811          .
     1812         end.
     1813       end.
     1814       for each tt-fin-doc :
     1815         find first buf_contract no-lock where buf_contract.host-code = p-host-code and buf_contract.contract-code = tt-fin-doc.contract-code .
     1816         run FindBank .
     1817         assign
     1818           tt-fin-doc.base-rate       = if tt-fin-doc.sum-base  <> 0 then tt-fin-doc.sum-rubl * tt-fin-doc.base-scale / tt-fin-doc.sum-base      else 0
     1819           tt-fin-doc.contract-rate   = if tt-fin-doc.sum-contr <> 0 then tt-fin-doc.sum-rubl * tt-fin-doc.contract-scale / tt-fin-doc.sum-contr else 0
     1820           tt-fin-doc.exch-rate       = if tt-fin-doc.sum-doc   <> 0 then tt-fin-doc.sum-rubl * tt-fin-doc.exch-scale / tt-fin-doc.sum-doc       else 0
     1821         .
     1822         find first ub.currency no-lock where ub.currency.curr-code = b2_fin-schet.curr-code .
     1823         assign  curr-rc = ub.currency.curr-abbr  .
     1824         if buf_contract.pay-nal = no then do:
     1825           if buf_contract.doc-type = 'при':U then do:
     1826             if buf_fin-ob.sum-contr > 0 then assign tt-fin-doc.fin-doc-type = 'рпп':U .
     1827             else                           assign tt-fin-doc.fin-doc-type = 'ппп':U .
     1828           end.
     1829           else do:
     1830             if buf_fin-ob.sum-contr > 0 then assign tt-fin-doc.fin-doc-type = 'ппп':U .
     1831             else                           assign tt-fin-doc.fin-doc-type = 'рпп':U .
     1832           end.
     1833           assign tt-fin-doc.curr-code = b2_fin-schet.curr-code  .
     1834           case b2_fin-schet.curr-code :
     1835                 when 0 then do:
     1836                   assign tt-fin-doc.sum-doc = tt-fin-doc.sum-rubl .
     1837                   for each tt0-fin-doc-tax no-lock :
     1838                     assign
     1839                       tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-rubl
     1840                       tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-rubl
     1841                       tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-rubl
     1842                     .
     1843                   end.
     1844                 end.
     1845                 when v-curr-r-b then do:
     1846                   assign tt-fin-doc.sum-doc = tt-fin-doc.sum-base .
     1847                   for each tt0-fin-doc-tax no-lock :
     1848                     assign
     1849                       tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-base
     1850                       tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-base
     1851                       tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-base
     1852                     .
     1853                   end.
     1854                 end.
     1855                 when buf_contract.curr-code then do:
     1856                   assign tt-fin-doc.sum-doc = tt-fin-doc.sum-contr .
     1857                   for each tt0-fin-doc-tax no-lock :
     1858                     assign
     1859                       tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-contr
     1860                       tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-contr
     1861                       tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-contr
     1862                     .
     1863                   end.
     1864                 end.
     1865             otherwise do:
     1866   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1867   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1868     (input  b2_fin-schet.curr-code
     1869     ,input  today
     1870     ,output tt-fin-doc.exch-rate
     1871     ,output tt-fin-doc.exch-scale
     1872     ,output curr-rc
     1873     )  .
     1874               assign tt-fin-doc.sum-doc = tt-fin-doc.sum-rubl * tt-fin-doc.exch-scale / tt-fin-doc.exch-rate .
     1875             end.
     1876           end.
     1877         end.
     1878         else do:
     1879           if buf_contract.pay-nal = yes then do:
     1880             if buf_contract.doc-type = 'при':U then do:
     1881               if buf_fin-ob.sum-contr > 0 then assign tt-fin-doc.fin-doc-type = 'рко':U .
     1882               else                           assign tt-fin-doc.fin-doc-type = 'пко':U .
     1883             end.
     1884             else do:
     1885               if buf_fin-ob.sum-contr > 0 then assign tt-fin-doc.fin-doc-type = 'пко':U .
     1886               else                           assign tt-fin-doc.fin-doc-type = 'рко':U .
     1887             end.
     1888           end.
     1889           else do:
     1890             if buf_contract.doc-type = 'при':U then do:
     1891               if buf_fin-ob.sum-contr > 0 then assign tt-fin-doc.fin-doc-type = 'апр':U .
     1892               else                           assign tt-fin-doc.fin-doc-type = 'апп':U .
     1893             end.
     1894             else do:
     1895               if buf_fin-ob.sum-contr > 0 then assign tt-fin-doc.fin-doc-type = 'апп':U .
     1896               else                           assign tt-fin-doc.fin-doc-type = 'апр':U .
     1897             end.
     1898           end.
     1899           assign
     1900             tt-fin-doc.receiver-code-schet = 0
     1901             tt-fin-doc.receiver-bank-name  = ""
     1902             tt-fin-doc.receiver-c-schet    = ""
     1903             tt-fin-doc.receiver-r-schet    = ""
     1904             tt-fin-doc.payer-code-schet = 0
     1905             tt-fin-doc.payer-bank-name  = ""
     1906             tt-fin-doc.payer-c-schet    = ""
     1907             tt-fin-doc.payer-r-schet    = ""
     1908           .
     1909         end.
     1910         assign tt-fin-doc.fin-ext-doc-type = tt-fin-doc.fin-doc-type .
     1911         if tt-fin-doc.sum-contr < 0 then do:
     1912           assign
     1913             tt-fin-doc.payer-sign1        = ub.firm.director
     1914             tt-fin-doc.payer-sign2        = ub.sysconf.snr-accnt
     1915             tt-fin-doc.payer-sign3        = ub.sysconf.cashier
     1916           .
     1917           run InvertCli .
     1918         end.
     1919         else
     1920           assign
     1921             tt-fin-doc.receiver-sign1        = ub.firm.director
     1922             tt-fin-doc.receiver-sign2        = ub.sysconf.snr-accnt
     1923             tt-fin-doc.receiver-sign3        = ub.sysconf.cashier
     1924           .
     1925         assign sss = " В т.ч.: "  .
     1926         if buf_contract.pay-nal = no then do:
     1927           for each tt0-fin-doc-tax where tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code :
     1928             if tt0-fin-doc-tax.with-vat = no then next.
     1929             if sss <> " В т.ч.: " then sss = sss + "," .
     1930             if tt-fin-doc.curr-code = 0 then assign sss = sss + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " руб. (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     1931             else                             assign sss = sss + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     1932           end.
     1933           if sss = " В т.ч.: " then assign sss = "" .
     1934           assign tt-fin-doc.naznach-plat = tt-fin-doc.naznach-plat + "@" + sss .
     1935         end.
     1936         else if buf_contract.pay-nal = yes then do:
     1937           for each tt0-fin-doc-tax where tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code :
     1938             if tt0-fin-doc-tax.with-vat = no then next.
     1939             if sss <> " В т.ч.: " then sss = sss + "," .
     1940             if tt-fin-doc.curr-code = 0 then assign sss = sss + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " руб. (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     1941             else                             assign sss = sss + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     1942           end.
     1943           if sss = " В т.ч.: " then assign sss = "" .
     1944           assign tt-fin-doc.including = sss .
     1945         end.
     1946         run UchetCode .
     1947         define variable p-doc-rec as recid no-undo.
     1948         BUFFER-COPY tt-fin-doc TO tt_fin-doc .
     1949         for each tt0_fin-doc-tax :
     1950           delete tt0_fin-doc-tax.
     1951         end.
     1952         assign line = 1 .
     1953         for each tt0-fin-doc-tax where tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code :
     1954           create tt0_fin-doc-tax .
     1955           BUFFER-COPY tt0-fin-doc-tax TO tt0_fin-doc-tax .
     1956           assign
     1957             tt0_fin-doc-tax.line-num     = line
     1958             line = line + 1
     1959           .
     1960         end.
     1961         run ref/findoc0.p (
     1962           input-output p-doc-rec
     1963          ,input 'ДОБАВЛЕНИЕ':U
     1964          ,input yes
     1965          ,input tt_fin-doc.host-code            ,input tt_fin-doc.fin-doc-code         ,input tt_fin-doc.an-uchet-code        ,input tt_fin-doc.an-uchet-value       ,input tt_fin-doc.base-rate            ,input tt_fin-doc.base-scale           ,input tt_fin-doc.cel-nazn-code        ,input tt_fin-doc.cel-nazn-value       ,input tt_fin-doc.contract-code        ,input tt_fin-doc.contract-curr        ,input tt_fin-doc.contract-rate        ,input tt_fin-doc.contract-scale       ,input tt_fin-doc.cor-acc              ,input tt_fin-doc.cor-acc-value        ,input tt_fin-doc.cor-acc1             ,input tt_fin-doc.cor-acc1-value       ,input tt_fin-doc.curr-code            ,input tt_fin-doc.doc-date             ,input tt_fin-doc.shift-date           ,input tt_fin-doc.shift-num            ,input tt_fin-doc.shift-name           ,input tt_fin-doc.enclosure            ,input tt_fin-doc.exch-rate            ,input tt_fin-doc.exch-scale           ,input tt_fin-doc.f104                 ,input tt_fin-doc.f105                 ,input tt_fin-doc.f106                 ,input tt_fin-doc.f107                 ,input tt_fin-doc.f108                 ,input tt_fin-doc.f109                 ,input tt_fin-doc.f110                 ,input tt_fin-doc.f22                  ,input tt_fin-doc.f23                  ,input tt_fin-doc.fact-date            ,input tt_fin-doc.fin-doc-type         ,input tt_fin-doc.fin-ext-doc-type     ,input tt_fin-doc.in-doc-code          ,input tt_fin-doc.in-host-code         ,input tt_fin-doc.including            ,input tt_fin-doc.nazn-pl              ,input tt_fin-doc.naznach-plat         ,input tt_fin-doc.ocher-pl             ,input tt_fin-doc.out-doc-code         ,input tt_fin-doc.out-host-code        ,input tt_fin-doc.pay-date             ,input tt_fin-doc.payer-bank-name      ,input tt_fin-doc.payer-bank-city      ,input tt_fin-doc.payer-bik            ,input tt_fin-doc.payer-c-schet        ,input tt_fin-doc.payer-code           ,input tt_fin-doc.payer-code-schet     ,input tt_fin-doc.payer-dop1           ,input tt_fin-doc.payer-dop2           ,input tt_fin-doc.payer-inn            ,input tt_fin-doc.payer-kpp            ,input tt_fin-doc.payer-name           ,input tt_fin-doc.payer-okpo           ,input tt_fin-doc.payer-passport      ,input tt_fin-doc.payer-r-schet        ,input tt_fin-doc.payer-type           ,input tt_fin-doc.perm-date            ,input tt_fin-doc.prn-doc-code         ,input tt_fin-doc.PS                   ,input tt_fin-doc.receiver-bank-name   ,input tt_fin-doc.receiver-bank-city   ,input tt_fin-doc.receiver-bik         ,input tt_fin-doc.receiver-c-schet     ,input tt_fin-doc.receiver-code        ,input tt_fin-doc.receiver-code-schet  ,input tt_fin-doc.receiver-dop1        ,input tt_fin-doc.receiver-dop2        ,input tt_fin-doc.receiver-inn         ,input tt_fin-doc.receiver-kpp         ,input tt_fin-doc.receiver-name        ,input tt_fin-doc.receiver-okpo        ,input tt_fin-doc.receiver-passport    ,input tt_fin-doc.receiver-r-schet     ,input tt_fin-doc.receiver-type        ,input tt_fin-doc.srok-pl              ,input tt_fin-doc.stat-pl              ,input tt_fin-doc.str-podr-code        ,input tt_fin-doc.str-podr-type        ,input tt_fin-doc.str-podr-name        ,input tt_fin-doc.sum-base             ,input tt_fin-doc.sum-doc              ,input tt_fin-doc.sum-rubl             ,input tt_fin-doc.sum-contr            ,input tt_fin-doc.trn-doc-code         ,input tt_fin-doc.vid-opl              ,input tt_fin-doc.vid-plat
     1966          ,input tt_fin-doc.con-sum-rubl         ,input tt_fin-doc.con-sum-base         ,input tt_fin-doc.con-sum-doc          ,input tt_fin-doc.con-sum-contr        ,input tt_fin-doc.con-stat             ,input tt_fin-doc.payer-sign1                ,input tt_fin-doc.payer-sign2                ,input tt_fin-doc.payer-sign3                ,input tt_fin-doc.payer-sign4                ,input tt_fin-doc.receiver-sign1                ,input tt_fin-doc.receiver-sign2                ,input tt_fin-doc.receiver-sign3                ,input tt_fin-doc.receiver-sign4                ,input tt_fin-doc.obj-type                   ,input tt_fin-doc.obj-code                   ,input tt_fin-doc.doc-author                 ,input tt_fin-doc.fact-author                ,input tt_fin-doc.CashBookId
     1967          ,input table tt0_fin-doc-tax
     1968          ,input table tt_fin-doc-attr
     1969          ,input no
     1970          ,input table tt0-payment
     1971          ) no-error .
     1972        if error-status:error then do:
     1973          assign v-err = yes .
     1974          output stream LogStream to Value(v-message-text) append.
     1975          put stream Logstream unformatted
     1976            substitute("Ошибка создания платежа! Вн.№ договора &1  ФО &2&3&4"
     1977                       , tt-fin-doc.contract-code
     1978                       , tt-fin-doc.str-fo
     1979                       , chr(10)
     1980                       ,substitute( "&1&2&3", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1981                       ) skip.
     1982          output stream LogStream close.
     1983        end.
     1984        if v-err = no then do:
     1985          for each tt_fin-connect where tt_fin-connect.fin-doc-code = tt-fin-doc.fin-doc-code :
     1986            create ub.fin-connect .
     1987            BUFFER-COPY tt_fin-connect TO ub.fin-connect .
     1988   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1989   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     1990     (output ub.fin-connect.user-db-num
     1991     ,output ub.fin-connect.user-name
     1992     ,output ub.fin-connect.fact-date
     1993     ,output p-sys-time
     1994     ,output ub.fin-connect.fact-time
     1995     )  .
     1996            find first ub.fin-ob exclusive-lock where ub.fin-ob.host-code = p-host-code and ub.fin-ob.doc-code = ub.fin-connect.fin-ob-code .
     1997            assign
     1998              ub.fin-ob.con-sum-doc   = ub.fin-ob.sum-doc
     1999              ub.fin-ob.con-sum-rubl  = ub.fin-ob.sum-rubl
     2000              ub.fin-ob.con-sum-base  = ub.fin-ob.sum-base
     2001              ub.fin-ob.con-sum-contr = ub.fin-ob.sum-contr
     2002              ub.fin-ob.con-stat      = 2
     2003            .
     2004          end.
     2005          find first ub.fin-doc exclusive-lock where recid(ub.fin-doc) = p-doc-rec .
     2006          assign
     2007            ub.fin-doc.con-sum-rubl  = ub.fin-doc.sum-rubl
     2008            ub.fin-doc.con-sum-base  = ub.fin-doc.sum-base
     2009            ub.fin-doc.con-sum-doc   = ub.fin-doc.sum-doc
     2010            ub.fin-doc.con-sum-contr = ub.fin-doc.sum-contr
     2011            ub.fin-doc.con-stat      = 2
     2012          .
     2013          output stream LogStream to Value(v-message-text) append.
     2014          put stream Logstream unformatted
     2015          substitute("Успешно создан &1 № &2 по фин.об &3 ! Вн.№ договора &4", tt-fin-doc.fin-doc-type, tt-fin-doc.prn-doc-code, tt-fin-doc.str-fo, buf_contract.contract-code) skip.
     2016          output stream LogStream close.
     2017        end.
     2018      end.
     2019     end.
     2020   end procedure.
     2021   define variable vss-include-info10 as character format "X(65)" no-undo
     2022   initial "@(#)$Workfile$ $Revision$".
     2023   PROCEDURE StrTax :
     2024     do
     2025     on error undo, return error return-value
     2026     :
     2027       define input-output parameter str as character no-undo .
     2028       assign str = " В т.ч.: "  .
     2029       for each tt0-fin-doc-tax :
     2030         if tt0-fin-doc-tax.with-vat = no then next.
     2031         if str <> " В т.ч.: " then str = str + "," .
     2032         if tt-fin-doc.curr-code = 0 then
     2033           assign str = str + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " руб. (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     2034         else
     2035           assign str = str + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     2036       end.
     2037       if str = " В т.ч.: " then assign str = "" .
     2038     end.
     2039   END PROCEDURE.
     2040   PROCEDURE InvertCli :
     2041     do
     2042     on error undo, return error return-value
     2043     :
     2044         define variable payer-bank-name    like ub.fin-doc.payer-bank-name  .
     2045         define variable payer-bank-city    like ub.fin-doc.payer-bank-city  .
     2046         define variable payer-bik          like ub.fin-doc.payer-bik        .
     2047         define variable payer-c-schet      like ub.fin-doc.payer-c-schet    .
     2048         define variable payer-code         like ub.fin-doc.payer-code       .
     2049         define variable payer-code-schet   like ub.fin-doc.payer-code-schet .
     2050         define variable payer-inn          like ub.fin-doc.payer-inn        .
     2051         define variable payer-kpp          like ub.fin-doc.payer-kpp        .
     2052         define variable payer-name         like ub.fin-doc.payer-name       .
     2053         define variable payer-okpo         like ub.fin-doc.payer-okpo       .
     2054         define variable payer-passport     like ub.fin-doc.payer-passport   .
     2055         define variable payer-r-schet      like ub.fin-doc.payer-r-schet    .
