     2115             tt0-fin-doc-tax.sum-slt-line-contr = - tt0-fin-doc-tax.sum-slt-line-contr
     2116           .
     2117         end.
     2118     end.
     2119   END PROCEDURE.
     2120   PROCEDURE CheckCli :
     2121     do
     2122     on error undo, return error return-value
     2123     :
     2124       if tt-fin-doc.payer-code = p-host-code and tt-fin-doc.payer-type = 'орг':U then do:
     2125         assign
     2126           tt-fin-doc.payer-bik        = buf_contract.own-bik
     2127           tt-fin-doc.payer-code-schet = buf_contract.own-code-schet
     2128           tt-fin-doc.payer-inn        = buf_contract.own-inn
     2129           tt-fin-doc.payer-kpp        = buf_contract.own-kpp
     2130         .
     2131         if tt-fin-doc.receiver-code = buf_contract.cli-code and tt-fin-doc.receiver-type = buf_contract.cli-type then do:
     2132           assign
     2133             tt-fin-doc.receiver-bik        = buf_contract.cli-bik
     2134             tt-fin-doc.receiver-code-schet = buf_contract.cli-code-schet
     2135             tt-fin-doc.receiver-inn        = buf_contract.cli-inn
     2136             tt-fin-doc.receiver-kpp        = buf_contract.cli-kpp
     2137           .
     2138         end.
     2139         else do:
     2140           if tt-fin-doc.receiver-code = buf_contract.posr-code and tt-fin-doc.receiver-type = buf_contract.posr-type then do:
     2141             assign
     2142               tt-fin-doc.receiver-bik        = buf_contract.posr-bik
     2143               tt-fin-doc.receiver-code-schet = buf_contract.posr-code-schet
     2144               tt-fin-doc.receiver-inn        = buf_contract.posr-inn
     2145               tt-fin-doc.receiver-kpp        = buf_contract.posr-kpp
     2146             .
     2147           end.
     2148           else do:
     2149             assign
     2150               tt-fin-doc.receiver-bik        = buf_contract.agnt-bik
     2151               tt-fin-doc.receiver-code-schet = buf_contract.agnt-code-schet
     2152               tt-fin-doc.receiver-inn        = buf_contract.agnt-inn
     2153               tt-fin-doc.receiver-kpp        = buf_contract.agnt-kpp
     2154             .
     2155           end.
     2156         end.
     2157       end.
     2158       else do:
     2159         if tt-fin-doc.receiver-code = p-host-code and tt-fin-doc.receiver-type = 'орг':U then do:
     2160           assign
     2161             tt-fin-doc.receiver-bik        = buf_contract.own-bik
     2162             tt-fin-doc.receiver-code-schet = buf_contract.own-code-schet
     2163             tt-fin-doc.receiver-inn        = buf_contract.own-inn
     2164             tt-fin-doc.receiver-kpp        = buf_contract.own-kpp
     2165           .
     2166           if tt-fin-doc.payer-code = buf_contract.cli-code and tt-fin-doc.payer-type = buf_contract.cli-type then do:
     2167             assign
     2168               tt-fin-doc.payer-bik        = buf_contract.cli-bik
     2169               tt-fin-doc.payer-code-schet = buf_contract.cli-code-schet
     2170               tt-fin-doc.payer-inn        = buf_contract.cli-inn
     2171               tt-fin-doc.payer-kpp        = buf_contract.cli-kpp
     2172             .
     2173           end.
     2174           else do:
     2175             if tt-fin-doc.payer-code = buf_contract.posr-code and tt-fin-doc.payer-type = buf_contract.posr-type then do:
     2176               assign
     2177                 tt-fin-doc.payer-bik        = buf_contract.posr-bik
     2178                 tt-fin-doc.payer-code-schet = buf_contract.posr-code-schet
     2179                 tt-fin-doc.payer-inn        = buf_contract.posr-inn
     2180                 tt-fin-doc.payer-kpp        = buf_contract.posr-kpp
     2181               .
     2182             end.
     2183             else do:
     2184               assign
     2185                 tt-fin-doc.payer-bik        = buf_contract.agnt-bik
     2186                 tt-fin-doc.payer-code-schet = buf_contract.agnt-code-schet
     2187                 tt-fin-doc.payer-inn        = buf_contract.agnt-inn
     2188                 tt-fin-doc.payer-kpp        = buf_contract.agnt-kpp
     2189               .
     2190             end.
     2191           end.
     2192         end.
     2193         else return error .
     2194       end.
     2195     end.
     2196   END PROCEDURE.
     2197   PROCEDURE UchetCode :
     2198     do
     2199     on error undo, return error return-value
     2200     :
     2201       case tt-fin-doc.fin-doc-type :
     2202         when 'пко':U then do:
     2203           assign
     2204             tt-fin-doc.cor-acc       = buf_contract.cor-acc-in-cash
     2205             tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-in-cash
     2206             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-in-cash
     2207             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-in-cash
     2208           .
     2209         end.
     2210         when 'рко':U then do:
     2211           assign
     2212             tt-fin-doc.cor-acc       = buf_contract.cor-acc-out-cash
     2213             tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-out-cash
     2214             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-out-cash
     2215             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-out-cash
     2216           .
     2217         end.
     2218         when 'ппп':U then do:
     2219           assign
     2220             tt-fin-doc.cor-acc       = buf_contract.cor-acc-in
     2221             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-in
     2222             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-in
     2223           .
     2224         end.
     2225         when 'рпп':U then do:
     2226           assign
     2227             tt-fin-doc.cor-acc       = buf_contract.cor-acc-out
     2228             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-out
     2229             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-out
     2230           .
     2231         end.
     2232         when 'апп':U then do:
     2233           assign
     2234             tt-fin-doc.cor-acc       = buf_contract.cor-acc-in-payoff
     2235             tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-in-payoff
     2236             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-in-payoff
     2237             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-in-payoff
     2238           .
     2239         end.
     2240         when 'апр':U then do:
     2241           assign
     2242             tt-fin-doc.cor-acc       = buf_contract.cor-acc-out-payoff
     2243             tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-out-payoff
     2244             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-out-payoff
     2245             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-out-payoff
     2246           .
     2247         end.
     2248       end.
     2249       find first ub.fin-code-cel-nazn no-lock where ub.fin-code-cel-nazn.host-code = p-host-code and ub.fin-code-cel-nazn.fin-code = tt-fin-doc.cel-nazn-code no-error .
     2250       if available ub.fin-code-cel-nazn then assign tt-fin-doc.cel-nazn-value = ub.fin-code-cel-nazn.code-value .
     2251       find first ub.fin-code-an-uchet no-lock where ub.fin-code-an-uchet.host-code = p-host-code and ub.fin-code-an-uchet.fin-code = tt-fin-doc.an-uchet-code no-error .
     2252       if available ub.fin-code-an-uchet then assign tt-fin-doc.an-uchet-value = ub.fin-code-an-uchet.code-value .
     2253       find first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.host-code = p-host-code and ub.fin-code-cor-acc.fin-code = tt-fin-doc.cor-acc no-error .
     2254       if available ub.fin-code-cor-acc then assign tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     2255       find first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.host-code = p-host-code and ub.fin-code-cor-acc.fin-code = tt-fin-doc.cor-acc1 no-error .
     2256       if available ub.fin-code-cor-acc then assign tt-fin-doc.cor-acc1-value = ub.fin-code-cor-acc.code-value .
     2257     end.
     2258   END PROCEDURE.
     2259   PROCEDURE FindBank :
     2260     do
     2261     on error undo, return error return-value
     2262     :
     2263     find first b1_fin-schet no-lock where b1_fin-schet.host-code = p-host-code and b1_fin-schet.code-schet = tt-fin-doc.receiver-code-schet no-error .
     2264     find first ub.fin-bank no-lock where ub.fin-bank.host-code = p-host-code and ub.fin-bank.code-bank = b1_fin-schet.code-bank no-error .
     2265     if available b1_fin-schet then
     2266     assign
     2267       tt-fin-doc.receiver-bank-name  = ub.fin-bank.bank-name
     2268       tt-fin-doc.receiver-bank-city  = ub.fin-bank.bank-city
     2269       tt-fin-doc.receiver-c-schet    = b1_fin-schet.c-schet
     2270       tt-fin-doc.receiver-r-schet    = b1_fin-schet.r-schet
     2271     .
     2272     find first b2_fin-schet no-lock where b2_fin-schet.host-code = p-host-code and b2_fin-schet.code-schet = tt-fin-doc.payer-code-schet no-error .
     2273     find first ub.fin-bank no-lock where ub.fin-bank.host-code = p-host-code and ub.fin-bank.code-bank = b2_fin-schet.code-bank no-error .
     2274     if available b2_fin-schet then
     2275     assign
     2276       tt-fin-doc.payer-bank-name  = ub.fin-bank.bank-name
     2277       tt-fin-doc.payer-bank-city  = ub.fin-bank.bank-city
     2278       tt-fin-doc.payer-c-schet    = b2_fin-schet.c-schet
     2279       tt-fin-doc.payer-r-schet    = b2_fin-schet.r-schet
     2280     .
     2281     end.
     2282   END PROCEDURE.
