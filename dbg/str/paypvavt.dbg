     2057         assign
     2058           tt-fin-doc.sum-rubl  = - tt-fin-doc.sum-rubl
     2059           tt-fin-doc.sum-base  = - tt-fin-doc.sum-base
     2060           tt-fin-doc.sum-doc   = - tt-fin-doc.sum-doc
     2061           tt-fin-doc.sum-contr = - tt-fin-doc.sum-contr
     2062           payer-bank-name      = tt-fin-doc.payer-bank-name
     2063           payer-bank-city      = tt-fin-doc.payer-bank-city
     2064           payer-bik            = tt-fin-doc.payer-bik
     2065           payer-c-schet        = tt-fin-doc.payer-c-schet
     2066           payer-code           = tt-fin-doc.payer-code
     2067           payer-code-schet     = tt-fin-doc.payer-code-schet
     2068           payer-inn            = tt-fin-doc.payer-inn
     2069           payer-kpp            = tt-fin-doc.payer-kpp
     2070           payer-name           = tt-fin-doc.payer-name
     2071           payer-okpo           = tt-fin-doc.payer-okpo
     2072           payer-passport       = tt-fin-doc.payer-passport
     2073           payer-r-schet        = tt-fin-doc.payer-r-schet
     2074           payer-type           = tt-fin-doc.payer-type
     2075           tt-fin-doc.payer-bank-name    = tt-fin-doc.receiver-bank-name
     2076           tt-fin-doc.payer-bank-city    = tt-fin-doc.receiver-bank-city
     2077           tt-fin-doc.payer-bik          = tt-fin-doc.receiver-bik
     2078           tt-fin-doc.payer-c-schet      = tt-fin-doc.receiver-c-schet
     2079           tt-fin-doc.payer-code         = tt-fin-doc.receiver-code
     2080           tt-fin-doc.payer-code-schet   = tt-fin-doc.receiver-code-schet
     2081           tt-fin-doc.payer-inn          = tt-fin-doc.receiver-inn
     2082           tt-fin-doc.payer-kpp          = tt-fin-doc.receiver-kpp
     2083           tt-fin-doc.payer-name         = tt-fin-doc.receiver-name
     2084           tt-fin-doc.payer-okpo         = tt-fin-doc.receiver-okpo
     2085           tt-fin-doc.payer-passport     = tt-fin-doc.receiver-passport
     2086           tt-fin-doc.payer-r-schet      = tt-fin-doc.receiver-r-schet
     2087           tt-fin-doc.payer-type         = tt-fin-doc.receiver-type
     2088           tt-fin-doc.receiver-bank-name =  payer-bank-name
     2089           tt-fin-doc.receiver-bank-city =  payer-bank-city
     2090           tt-fin-doc.receiver-bik       =  payer-bik
     2091           tt-fin-doc.receiver-c-schet   =  payer-c-schet
     2092           tt-fin-doc.receiver-code      =  payer-code
     2093           tt-fin-doc.receiver-code-schet = payer-code-schet
     2094           tt-fin-doc.receiver-inn       =  payer-inn
     2095           tt-fin-doc.receiver-kpp       =  payer-kpp
     2096           tt-fin-doc.receiver-name      =  payer-name
     2097           tt-fin-doc.receiver-okpo      =  payer-okpo
     2098           tt-fin-doc.receiver-passport  =  payer-passport
     2099           tt-fin-doc.receiver-r-schet   =  payer-r-schet
     2100           tt-fin-doc.receiver-type      =  payer-type
     2101         .
     2102         for each  tt0-fin-doc-tax no-lock :
     2103           assign
     2104             tt0-fin-doc-tax.sum-line-doc       = - tt0-fin-doc-tax.sum-line-doc
     2105             tt0-fin-doc-tax.sum-vat-line-doc   = - tt0-fin-doc-tax.sum-vat-line-doc
     2106             tt0-fin-doc-tax.sum-slt-line-doc   = - tt0-fin-doc-tax.sum-slt-line-doc
     2107             tt0-fin-doc-tax.sum-line-rubl      = - tt0-fin-doc-tax.sum-line-rubl
     2108             tt0-fin-doc-tax.sum-vat-line-rubl  = - tt0-fin-doc-tax.sum-vat-line-rubl
     2109             tt0-fin-doc-tax.sum-slt-line-rubl  = - tt0-fin-doc-tax.sum-slt-line-rubl
     2110             tt0-fin-doc-tax.sum-line-base      = - tt0-fin-doc-tax.sum-line-base
     2111             tt0-fin-doc-tax.sum-vat-line-base  = - tt0-fin-doc-tax.sum-vat-line-base
     2112             tt0-fin-doc-tax.sum-slt-line-base  = - tt0-fin-doc-tax.sum-slt-line-base
     2113             tt0-fin-doc-tax.sum-line-contr     = - tt0-fin-doc-tax.sum-line-contr
