        1   block-level on error undo, throw.
        2   define input  parameter p-host-code    as integer   no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":u .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":u .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":u .
        6   define variable vss-workfile    as character no-undo init "$Workfile: paypvavt.p $":u .
        7   define variable vss-archive     as character no-undo init "$Archive: str/paypvavt.p $":u .
        8   define variable vss-description as character no-undo init "Автомат. оплата фин. обязательств" .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure cur-time :
       72      define output parameter p-today as date      no-undo .
       73      define output parameter p-time  as integer   no-undo .
       74     do
       75     on error undo, return error
       76     :
       77       define variable v-date1 as date      no-undo .
       78       define variable v-date2 as date      no-undo .
       79       define variable v-time  as integer   no-undo .
       80       assign
       81         v-date1 = today
       82         v-time  = time
       83         v-date2 = today
       84       .
       85       if v-date1 <> v-date2
       86       then do:
       87         assign
       88           v-date1 = today
       89           v-time  = v-time
       90         .
       91       end.
       92       assign
       93         p-today = v-date1
       94         p-time  = v-time
       95       .
       96     end.
       97   end.
       98   function cur-time-date returns character
       99   :
      100     return string(today, '99/99/9999':U) .
      101   end.
      102   function cur-time-mjd returns decimal
      103   :
      104     define variable v-date as date      no-undo .
      105     define variable v-time as integer   no-undo .
      106     run cur-time in this-procedure
      107       (output v-date
      108       ,output v-time
      109       ) .
      110     return integer(v-date) - 2400002 + (v-time / 86400) .
      111   end.
      112   function cur-time-get-ending-index returns integer
      113   (input p-number as integer
      114   )
      115   :
      116     if p-number < 0
      117     or p-number = ?
      118     then do:
      119       return 1 .
      120     end.
      121     define variable v-rest as integer   no-undo .
      122     assign
      123       p-number = p-number modulo 100
      124     .
      125     if p-number < 20
      126     then do:
      127       assign
      128         v-rest = p-number
      129       .
      130     end.
      131     else do:
      132       assign
      133         v-rest = p-number modulo 10
      134       .
      135     end.
      136     case v-rest :
      137       when 1
      138       then do:
      139         return 2 .
      140       end.
      141       when 2 or
      142       when 3 or
      143       when 4
      144       then do:
      145         return 3 .
      146       end.
      147       otherwise do:
      148         return 1 .
      149       end.
      150     end case .
      151   end.
      152   procedure cur-time-mjd-to-date :
      153      define input  parameter i-mjd-diff as decimal no-undo.
      154      define output parameter o-Date     as date    no-undo.
      155      define output parameter o-Time     as integer no-undo.
      156      define variable v-day-number as integer   no-undo .
      157      if    i-mjd-diff < 0
      158         or i-mjd-diff = ?
      159      then do:
      160         return "?" .
      161      end.
      162      assign
      163         v-day-number = truncate(i-mjd-diff,0).
      164         o-Date = date(v-day-number + 2400002).
      165         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      166     .
      167   end.
      168   function cur-time-mjd-to-string returns character
      169   (input p-mjd-diff as decimal
      170   )
      171   :
      172     define variable v-day-number as integer   no-undo .
      173     define variable v-seconds    as integer   no-undo .
      174     define variable v-hour       as integer   no-undo .
      175     define variable v-min        as integer   no-undo .
      176     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      177     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      178     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      179     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      180     if p-mjd-diff < 0
      181     or p-mjd-diff = ?
      182     then do:
      183       return "?" .
      184     end.
      185     assign
      186       v-day-number = integer(truncate(p-mjd-diff,0))
      187       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189     if v-seconds > 86400
      190     then do:
      191       assign
      192         v-seconds = 86400 - 1
      193       .
      194     end.
      195     if v-seconds < 0
      196     then do:
      197       assign
      198         v-seconds = 0
      199       .
      200     end.
      201     assign
      202       v-hour = truncate(v-seconds / 3600, 0)
      203     .
      204     assign
      205       v-seconds = v-seconds modulo 3600
      206     .
      207     assign
      208       v-min = truncate(v-seconds / 60, 0)
      209     .
      210     assign
      211       v-seconds = v-seconds modulo 60
      212     .
      213     return
      214         (if v-day-number <> 0
      215           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0
      219           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      223           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      224           else ""
      225         )
      226       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      227       .
      228   end.
      229   function cur-time-string returns character
      230   :
      231     define variable v-date as date      no-undo .
      232     define variable v-time as integer   no-undo .
      233     run cur-time in this-procedure
      234       (output v-date
      235       ,output v-time
      236       ) .
      237     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      238   end.
      239   function cur-time-string-sec returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      248   end.
      249   function cur-time-custom  returns character
      250   (input p-prefix as character
      251   ,input p-date-format as character
      252   ,input p-delimiter as character
      253   ,input p-time-format as character
      254   ,input p-suffix as character
      255   )
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return
      264       p-prefix
      265       + string(v-date, p-date-format)
      266       + p-delimiter
      267       + string(v-time, p-time-format)
      268       + p-suffix
      269       .
      270   end.
      271   function cur-time-print  returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      280   end.
      281   function cur-time-datetime returns datetime
      282   :
      283     define variable v-char as character no-undo .
      284     define variable v-datetime as datetime no-undo .
      285     v-char = cur-time-string().
      286     v-datetime = datetime(v-char).
      287     return  v-datetime.
      288   end.
      289   function cur-time-string-msec returns character
      290   :
      291     define variable v-date as datetime  no-undo .
      292     v-date = now.
      293     return string(v-date) .
      294   end.
      295   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296   define variable v-waitfram-action01         as character   no-undo .
      297   define variable v-waitfram-action02         as character   no-undo .
      298   define variable v-waitfram-action03         as character   no-undo .
      299   define variable mWaitFramTextBeg            as character   no-undo.
      300   define variable mWaitFramTextEnd            as character   no-undo.
      301   define variable mWaitFramView               as logical     no-undo.
      302   define variable mWaitProcEvent              as logical     no-undo init yes.
      303   define variable mWaitFramInterval           as integer     no-undo init 1 .
      304   define variable mWaitFramStop               as logical     no-undo.
      305   define variable mWaitFramStopUser           as logical     no-undo.
      306   define variable mWaitFramStopTimeOut        as logical     no-undo.
      307   define variable mWaitFramStartProc          as datetime-tz no-undo.
      308   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      309   define button B-WaitFramStop auto-end-key
      310        label "Стоп"
      311        size 10 by 1 tooltip "Остоновить процесс".
      312   define button B-viewProcInfo
      313        label "Информация"
      314        size 15 by 1 tooltip "Информация о процесс".
      315   define frame waitfram
      316     v-waitfram-action01 format "x(72)" no-label skip
      317     v-waitfram-action02 format "x(72)" no-label skip
      318     v-waitfram-action03 format "x(72)" no-label skip
      319     B-viewProcInfo
      320     B-WaitFramStop at row 4 col 30
      321     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      322     .
      323   define new global shared variable mBatchMode as logical no-undo init ?.
      324   define variable mFramBachModHandle as handle no-undo.
      325   mFramBachModHandle = frame waitfram:handle.
      326   define variable mFameOldVis as logical no-undo.
      327   define variable mVisCUrentVin as logical no-undo.
      328   if session:batch-mode
      329   then
      330      mBatchMode = yes.
      331   if mBatchMode = ? then do:
      332     mVisCUrentVin = current-window:visible.
      333     mFameOldVis = mFramBachModHandle:visible.
      334     mFramBachModHandle:visible  = yes.
      335     mBatchMode = mFramBachModHandle:visible ne yes.
      336     mFramBachModHandle:visible = mFameOldVis.
      337     current-window:visible = mVisCUrentVin.
      338   end.
      339    if  log-manager:logfile-name ne ?
      340     then DO:
      341         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      342         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      343         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      344     end.
      345   on choose of B-WaitFramStop in frame waitfram
      346   do:
      347     mWaitFramStop = yes.
      348     mWaitFramStopUser = yes.
      349   end.
      350   function waitfram-check-timeout returns logical():
      351      define variable vtime as int64 no-undo.
      352      if mWaitFramStopTimeOut
      353      then
      354         return yes.
      355      vtime = ( now - mWaitFramStartProc ) / 1000 .
      356      if     mWaitFramTimeOut ne ?
      357         and mWaitFramTimeOut ne 0
      358         and mWaitFramTimeOut lt vtime
      359      then do:
      360         mWaitFramStopTimeOut = yes.
      361      end.
      362      return mWaitFramStopTimeOut.
      363   end.
      364   procedure waitfram-hide :
      365     if not session:batch-mode
      366     then do
      367     on error undo, return error return-value
      368     :
      369       pause 0 before-hide .
      370       if not mBatchMode then
      371         hide frame waitfram .
      372     if     not mWaitFramView
      373        and mWaitProcEvent
      374     then
      375       process events .
      376     end.
      377   end procedure.
      378   procedure waitfram-show :
      379     define input  parameter p-message as character no-undo .
      380     define variable v-left-margin as integer   no-undo .
      381     if not session:batch-mode
      382     then do
      383     on error undo, return error return-value
      384     :
      385       if length(p-message) <= 70 then do:
      386         assign
      387           v-left-margin = integer((70 - length(p-message)) / 2)
      388         .
      389         assign
      390           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      391         .
      392         assign
      393           v-waitfram-action01 = " "
      394           v-waitfram-action02 = " "
      395                                    + fill(" ", v-left-margin)
      396                                    + p-message
      397           v-waitfram-action03 = " "
      398         .
      399       end.
      400       else do:
      401         define variable vRindex1 as integer no-undo.
      402         define variable vRindex2 as integer no-undo.
      403         vRindex1 = r-index(p-message," ",70).
      404         if vRindex1 = 0
      405         then
      406            vRindex1 = 70.
      407         if length(p-message)  <= vRindex1 + 70 then do:
      408           assign
      409             v-waitfram-action01 = " "
      410             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      411             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      412           .
      413         end.
      414         else do:
      415           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      416           if vRindex2 <= vRindex1
      417           then
      418              vRindex2 = vRindex1 + 70.
      419           assign
      420             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      421             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      422             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      423           .
      424         end.
      425       end.
      426       B-viewProcInfo:visible   in frame waitfram = no.
      427       B-viewProcInfo:sensitive in frame waitfram = no.
      428       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      429       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      430       if  (   mWaitFramView
      431          or  mWaitProcEvent)
      432          and not mBatchMode
      433       then
      434          display
      435             v-waitfram-action01 skip
      436             v-waitfram-action02 skip
      437             v-waitfram-action03 skip
      438          with frame waitfram .
      439       if     mWaitFramView
      440          then do:
      441             if     mWaitFramInterval ne ?
      442                and not mBatchMode
      443             then
      444                wait-for go of frame waitfram pause mWaitFramInterval.
      445          end.
      446          else
      447             if     mWaitProcEvent
      448                and not mBatchMode
      449             then
      450                process events .
      451     end.
      452   end procedure.
      453      procedure waitfram-show-this:
      454         define input  parameter iInterval as int64 no-undo.
      455         define variable vtime as int64 no-undo.
      456         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      457         mWaitFramInterval = iInterval.
      458         run waitfram-show (substitute("&1&2 &3&4" ,
      459                                       mWaitFramTextBeg ,
      460                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      461                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      462                                       mWaitFramTextEnd
      463                                      )
      464                           ).
      465      end.
      466      procedure WaitFramRunPause:
      467         define input  parameter iInterval as dec no-undo.
      468         define variable vStart  as datetime-tz no-undo.
      469         define variable vend    as datetime-tz no-undo.
      470         define variable vint as int64 no-undo.
      471         define variable vOk as logical no-undo.
      472         vStart = now.
      473         vend   = vStart.
      474         publish "WaitFramPause" (iInterval,output vOk).
      475         vend   =  now.
      476         vint = vend - vStart.
      477         vint = iInterval - vint / 1000.
      478         if     not mWaitFramStop
      479            and (   vint > 0
      480                 or (    not vOk
      481                     and iInterval eq ?
      482                     )
      483                 )
      484         then
      485            run waitfram-show-this (iInterval).
      486         vend   =  now.
      487         vint = vend - vStart.
      488         vint = iInterval - vint / 1000.
      489         if     not mWaitFramStop
      490            and vint > 0
      491         then do:
      492            run gbl/pause.p (vint * 1000).
      493         end.
      494         if iInterval ne ?
      495         then
      496            publish "WaitFramStop".
      497         waitfram-check-timeout().
      498      end.
      499      procedure WaitFramWaitFor:
      500         define input  parameter iInterval as dec no-undo.
      501         assign
      502            mWaitFramStartProc   = now
      503            mWaitFramStopUser    = no
      504            mWaitFramStopTimeOut = no
      505         .
      506         block-wait:
      507         do while not mWaitFramStop:
      508            run WaitFramRunPause (iInterval).
      509            if  waitfram-check-timeout()
      510            then do:
      511               leave block-wait.
      512            end.
      513         end.
      514         run waitfram-hide.
      515      end.
      516   procedure waitfram-join :
      517     define input  parameter p-line-1  as character no-undo .
      518     define input  parameter p-line-2  as character no-undo .
      519     define input  parameter p-line-3  as character no-undo .
      520     define output parameter p-message as character no-undo .
      521     do
      522     on error undo, return error return-value
      523     :
      524       assign
      525         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      526                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      527                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      528       .
      529     end.
      530   end procedure.
      531   function waitfram-join-function returns character
      532     (input p-line-1 as character
      533     ,input p-line-2 as character
      534     ,input p-line-3 as character
      535     ).
      536     define variable v-message as character no-undo .
      537     run waitfram-join in this-procedure
      538       (input  p-line-1
      539       ,input  p-line-2
      540       ,input  p-line-3
      541       ,output v-message
      542       ) .
      543     return v-message .
      544   end function .
      545   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      546   procedure gen-b-code :
      547     define input  parameter type-code like ub.code-range.range-type no-undo .
      548     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      549     do
      550     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      551     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      552     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      553     :
      554       define buffer buf_thbj-attr     for ub.thbj-attr .
      555       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      556       define buffer buf_code-range for ub.code-range .
      557       define variable l-code         as   integer              no-undo .
      558       define variable v-db-num       like ub.db.db-num         no-undo .
      559       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      560       if type-code = 'sslc':U
      561       or type-code = 'ssgb':U
      562       then do:
      563         message
      564           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      565           "Обратитесь к администратору системы."
      566           view-as alert-box error .
      567         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      568       end.
      569       run trg/getpcode.p ( input  type-code
      570                      ,output cfg-param-code
      571                     ).
      572       run get-next-seq( input  type-code,
      573                         output l-code
      574                       ).
      575       find first buf_sys-ctrl no-lock.
      576       if type-code = 'sclc':U
      577       or type-code = 'pglc':U
      578       then do:
      579         assign
      580           v-db-num = 0
      581         .
      582       end.
      583       else do:
      584         assign
      585           v-db-num = buf_sys-ctrl.db-num
      586         .
      587       end.
      588       find first buf_code-range no-lock
      589         where buf_code-range.db-num     = v-db-num
      590           and buf_code-range.range-type = type-code
      591           and buf_code-range.stts       = "a"
      592         use-index stts
      593         no-error .
      594       if available buf_code-range
      595          and l-code <= buf_code-range.last-code
      596          and l-code >= buf_code-range.first-code then do:
      597         assign
      598           p-b-code = l-code
      599         .
      600       end.
      601       else do:
      602         if available buf_code-range
      603            and l-code < buf_code-range.last-code then do:
      604           message
      605             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      606             "Обратитесь к администратору системы."
      607             view-as alert-box error .
      608           undo, return error "sequence":U .
      609         end.
      610         do transaction
      611         on error undo, return error
      612         :
      613           find first buf_thbj-attr exclusive-lock
      614             where buf_thbj-attr.upper-prop-code = 'code-range':U
      615               and buf_thbj-attr.prop-code = cfg-param-code
      616               and buf_thbj-attr.obj-type   = 'БД':U
      617               and buf_thbj-attr.obj-code   = v-db-num
      618             no-error .
      619           if not available buf_thbj-attr then do:
      620             find first buf_thbj-attr exclusive-lock
      621               where buf_thbj-attr.upper-prop-code = 'code-range':U
      622                 and buf_thbj-attr.prop-code = cfg-param-code
      623                 and buf_thbj-attr.obj-type   = ''
      624                 and buf_thbj-attr.obj-code   = 0
      625               no-error .
      626             if not available buf_thbj-attr then do:
      627               if not locked buf_thbj-attr then do:
      628                 message
      629                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      630                   "Обратитесь к администратору системы."
      631                   view-as alert-box error .
      632               end.
      633               undo, return error "config":U .
      634             end.
      635           end.
      636           run get-next-seq( input type-code,
      637                             output l-code
      638                           ).
      639           find first buf_code-range
      640             where buf_code-range.db-num     = v-db-num
      641               and buf_code-range.range-type = type-code
      642               and buf_code-range.stts       = "a"
      643             use-index stts
      644             no-error .
      645           if available buf_code-range
      646           and l-code <= buf_code-range.last-code
      647           and l-code >= buf_code-range.first-code
      648           then do:
      649             assign
      650               p-b-code = l-code
      651             .
      652           end.
      653           else do:
      654             if available buf_code-range then do:
      655               assign
      656                 buf_code-range.stts = "u"
      657               .
      658             end.
      659             find first buf_code-range
      660               where buf_code-range.db-num     = v-db-num
      661                 and buf_code-range.range-type = type-code
      662                 and buf_code-range.stts       = "f"
      663               use-index stts
      664               no-error .
      665             if not available buf_code-range then do:
      666               message
      667                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      668                 "Обратитесь к администратору системы"
      669                 view-as alert-box error .
      670               undo, return error "code-range":U .
      671             end.
      672             assign
      673               buf_code-range.stts           = "a"
      674             .
      675             if buf_code-range.first-code = 1 then do:
      676               run set-seq-cr( input type-code,
      677                               input buf_code-range.first-code
      678                             ).
      679               assign
      680                 p-b-code = 1
      681               .
      682             end.
      683             else do:
      684               run set-seq-cr( input type-code,
      685                               input ( buf_code-range.first-code - 1 )
      686                             ).
      687               run get-next-seq( input type-code,
      688                                 output p-b-code
      689                               ).
      690             end.
      691           end.
      692         end.
      693       end.
      694     end.
      695   end procedure.
      696   procedure get-next-seq :
      697     define input  parameter type-code like ub.code-range.range-type no-undo .
      698     define output parameter next-seq  as   integer                  no-undo .
      699     do
      700     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      701     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      702     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      703     :
      704       case type-code:
      705         when 'bcgb':U then do:
      706           assign
      707             next-seq = next-value(s-bcgb-code, ub)
      708           .
      709         end.
      710         when 'scgb':U then do:
      711           assign
      712             next-seq = next-value(s-scgb-code, ub)
      713           .
      714         end.
      715         when 'sclc':U then do:
      716           assign
      717             next-seq = next-value(s-sclc-code, ub)
      718           .
      719         end.
      720         when 'pglc':U then do:
      721           assign
      722             next-seq = next-value(s-pglc-code, ub)
      723           .
      724         end.
      725         when 'dcgb':U then do:
      726           assign
      727             next-seq = next-value(s-dcgb-code, ub)
      728           .
      729         end.
      730         when 'ctgb':U then do:
      731           assign
      732             next-seq = next-value(s-ctgb-code, ub)
      733           .
      734         end.
      735         when 'drgb':U then do:
      736           assign
      737             next-seq = next-value(s-drgb-code, ub)
      738           .
      739         end.
      740         when 'fmgb':U then do:
      741           assign
      742             next-seq = next-value(s-fmgb-code, ub)
      743           .
      744         end.
      745         when 'pngb':U then do:
      746           assign
      747             next-seq = next-value(s-pngb-code, ub)
      748           .
      749         end.
      750         when 'cagb':U then do:
      751           assign
      752             next-seq = next-value(s-cagb-code, ub)
      753           .
      754         end.
      755         when 'fdgb':U then do:
      756           assign
      757             next-seq = next-value(s-fin-doc, ub)
      758           .
      759         end.
      760       end case.
      761     end.
      762   end procedure.
      763   procedure set-seq-cr :
      764     define input parameter type-code like ub.code-range.range-type no-undo .
      765     define input parameter set-val   like ub.code-range.first-code no-undo .
      766     do
      767     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      768     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      769     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      770     :
      771       case type-code:
      772         when 'bcgb':U then do:
      773           assign
      774             current-value(s-bcgb-code, ub) = set-val
      775           .
      776         end.
      777         when 'scgb':U then do:
      778           assign
      779             current-value(s-scgb-code, ub) = set-val
      780           .
      781         end.
      782         when 'sclc':U then do:
      783           assign
      784             current-value(s-sclc-code, ub) = set-val
      785           .
      786         end.
      787         when 'pglc':U then do:
      788           assign
      789             current-value(s-pglc-code, ub) = set-val
      790           .
      791         end.
      792         when 'dcgb':U then do:
      793           assign
      794             current-value(s-dcgb-code, ub) = set-val
      795           .
      796         end.
      797         when 'ctgb':U then do:
      798           assign
      799             current-value(s-ctgb-code, ub) = set-val
      800           .
      801         end.
      802         when 'drgb':U then do:
      803           assign
      804             current-value(s-drgb-code, ub) = set-val
      805           .
      806         end.
      807         when 'fmgb':U then do:
      808           assign
      809             current-value(s-fmgb-code, ub) = set-val
      810           .
      811         end.
      812         when 'pngb':U then do:
      813           assign
      814             current-value(s-pngb-code, ub) = set-val
      815           .
      816         end.
      817         when 'cagb':U then do:
      818           assign
      819             current-value(s-cagb-code, ub) = set-val
      820           .
      821         end.
      822         when 'fdgb':U then do:
      823           assign
      824             current-value(s-fin-doc, ub) = set-val
      825           .
      826         end.
      827       end case.
      828     end.
      829   end procedure.
      830   procedure new-bcod-gen-code-range :
      831     do
      832     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      833     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      834     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      835     :
      836       define input parameter p-db-num  like ub.db.db-num             no-undo .
      837       define input parameter type-code like ub.code-range.range-type no-undo .
      838       define buffer buf_code-range      for ub.code-range .
      839       define buffer last_code-range     for ub.code-range .
      840       define buffer last-1_code-range   for ub.code-range .
      841       define buffer last-2_code-range   for ub.code-range .
      842       define buffer last-3_code-range   for ub.code-range .
      843       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      844       define variable conf-par       as character no-undo .
      845       define variable par-type       as character no-undo .
      846       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      847       define variable v-cre-cdrg as logical   no-undo .
      848       define variable v-cre-str  as character no-undo .
      849       define variable v-cr1      as integer no-undo .
      850       define variable v-cr2      as integer no-undo .
      851       define variable v-cr3      as integer no-undo .
      852       define variable v-cmax     as integer no-undo .
      853       find first buf_sys-ctrl no-lock .
      854       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      855         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      856                                       ,vss-workfile
      857                                       ,vss-revision
      858                                       ,vss-description
      859                                       ,chr(10)
      860                                       , p-db-num
      861                                      ).
      862       end.
      863       run trg/getpcode.p ( input  type-code
      864                      ,output cfg-param-code
      865                     ).
      866       for each buf_code-range
      867         where buf_code-range.db-num     = -1
      868           and buf_code-range.range-type = type-code
      869           and buf_code-range.stts       = "f"
      870       by buf_code-range.first-code
      871       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      872       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      873       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      874       :
      875         assign
      876           buf_code-range.db-num = p-db-num
      877         .
      878         return .
      879       end.
      880       assign
      881         v-cre-cdrg = TRUE
      882       .
      883       case type-code:
      884         when 'sclc':U
      885         or when 'scgb':U
      886         or when 'pglc':U
      887         then do:
      888           find last last-1_code-range no-lock
      889             where last-1_code-range.range-type = 'sclc':U
      890             no-error .
      891           if available last-1_code-range then do:
      892             v-cr1 = last-1_code-range.last-code.
      893           end.
      894           find last last-2_code-range no-lock
      895             where last-2_code-range.range-type = 'scgb':U
      896             no-error .
      897           if available last-2_code-range then do:
      898             v-cr2 = last-2_code-range.last-code.
      899             end.
      900           find last last-3_code-range no-lock
      901             where last-3_code-range.range-type = 'pglc':U
      902             no-error .
      903           if available last-3_code-range then do:
      904             v-cr3 = last-3_code-range.last-code.
      905           end.
      906           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      907           .
      908           if v-cmax = v-cr1  then do:
      909               find last last_code-range no-lock
      910                 where recid( last_code-range ) = recid( last-1_code-range )
      911                 .
      912             end.
      913           if v-cmax = v-cr2  then do:
      914               find last last_code-range no-lock
      915                 where recid( last_code-range ) = recid( last-2_code-range )
      916                 .
      917             end.
      918           if v-cmax = v-cr3  then do:
      919             find last last_code-range no-lock
      920               where recid( last_code-range ) = recid( last-3_code-range )
      921               .
      922           end.
      923           if last_code-range.last-code + 1 > 99999 then do:
      924             assign
      925               v-cre-cdrg = FALSE
      926             .
      927           end.
      928         end.
      929         when 'bcgb':U
      930         or when 'sslc':U
      931         or when 'ssgb':U
      932         then do:
      933           find last last-1_code-range no-lock
      934             where last-1_code-range.range-type = 'sslc':U
      935             no-error .
      936           if available last-1_code-range then do:
      937             v-cr1 = last-1_code-range.last-code.
      938           end.
      939           find last last-2_code-range no-lock
      940             where last-2_code-range.range-type = 'bcgb':U
      941             no-error .
      942           if available last-2_code-range then do:
      943             v-cr2 = last-2_code-range.last-code.
      944             end.
      945           find last last-3_code-range no-lock
      946             where last-3_code-range.range-type = 'ssgb':U
      947             no-error .
      948           if available last-3_code-range then do:
      949             v-cr3 = last-3_code-range.last-code.
      950           end.
      951           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      952           .
      953           if v-cmax = v-cr1  then do:
      954               find last last_code-range no-lock
      955                 where recid( last_code-range ) = recid( last-1_code-range )
      956                 .
      957             end.
      958           if v-cmax = v-cr2  then do:
      959               find last last_code-range no-lock
      960                 where recid( last_code-range ) = recid( last-2_code-range )
      961                 .
      962             end.
      963           if v-cmax = v-cr3  then do:
      964             find last last_code-range no-lock
      965               where recid( last_code-range ) = recid( last-3_code-range )
      966               .
      967           end.
      968         end.
      969         otherwise do:
      970           find last last_code-range no-lock
      971             where last_code-range.range-type = type-code
      972             no-error .
      973         end.
      974       end case.
      975       if not available last_code-range then do:
      976         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      977                                       ,vss-workfile
      978                                       ,vss-revision
      979                                       ,vss-description
      980                                       , chr(10)
      981                                       , type-code
      982                                      ) .
      983       end.
      984       define variable v-mes3 as character no-undo .
      985       define variable v-param-type3 as character no-undo .
      986       define variable v-value-character3 as INTEGER no-undo .
      987       define variable v-value-date3 as date no-undo .
      988       define variable v-value-decimal3 as decimal no-undo .
      989       define variable v-value-integer3 AS integer no-undo .
      990       define variable v-value-logical3 AS LOGICAL no-undo .
      991       define variable v-tth3 as handle no-undo .
      992       run adm/shattri.p (
      993           input "get":U
      994           ,input  'БД':U
      995           ,input  p-db-num
      996           ,input  'code-range':U
      997           ,input  cfg-param-code
      998           ,output v-value-character3
      999           ,output v-value-date3
     1000           ,output v-value-decimal3
     1001           ,output v-value-integer3
     1002           ,output v-value-logical3
     1003           ,output v-param-type3
     1004           ,INPUT-OUTPUT table-handle v-tth3
     1005           ) no-error .
     1006       if error-status :error then do:
     1007         delete object v-tth3.
     1008         v-mes3 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     1009                            , error-status:get-message(1)
     1010                            , chr(10)
     1011                            , return-value ).
     1012         undo, return error v-mes3.
     1013       end.
     1014       delete object v-tth3.
     1015       if v-cre-cdrg = TRUE then do:
     1016         create buf_code-range .
     1017         assign
     1018           buf_code-range.db-num     = p-db-num
     1019           buf_code-range.range-type = type-code
     1020           buf_code-range.stts       = "f"
     1021           buf_code-range.first-code = last_code-range.last-code + 1
     1022           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer3)
     1023           v-cre-str = "Свободный диапазон успешно создан"
     1024         .
     1025       end.
     1026       else do:
     1027         assign
     1028           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     1029                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     1030         .
     1031       end.
     1032     end.
     1033     return v-cre-str .
     1034   end procedure.
     1035   procedure gen-new-code-range-if-neces :
     1036     define input parameter v-db-num           like ub.db.db-num             no-undo .
     1037     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     1038     define input parameter v-cur-code         as   integer                  no-undo .
     1039     define input parameter v-g#news           as   logical                  no-undo .
     1040     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     1041     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     1042     do
     1043     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1044     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     1045     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     1046     :
     1047       define variable l-code-range-exist as logical   no-undo init false .
     1048       define variable v-db-for-send      as character no-undo .
     1049       define buffer buf_code-range  for ub.code-range .
     1050       define buffer buf1_code-range for ub.code-range .
     1051       define buffer buf_db          for ub.db .
     1052       find first buf_code-range
     1053         where buf_code-range.range-type = v-range-type
     1054           and buf_code-range.last-code >= v-cur-code
     1055         use-index last-codei
     1056         no-error .
     1057       if
     1058       (
     1059          available buf_code-range
     1060          and
     1061         (buf_code-range.db-num = v-db-num
     1062           and
     1063         buf_code-range.first-code <= v-cur-code
     1064         )
     1065       or
     1066         (
     1067           v-range-type = 'drgb':U
     1068           AND
     1069           v-cur-code = 0
     1070         )
     1071      )
     1072      then do:
     1073         assign
     1074           l-code-range-exist = true
     1075         .
     1076         if v-g#news
     1077         and buf_code-range.stts = "f" then do:
     1078           assign
     1079             buf_code-range.stts = "u"
     1080           .
     1081         end.
     1082       end.
     1083       if not l-code-range-exist
     1084          and v-g#news-source-db <> 0
     1085       then do:
     1086         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     1087                                       ,vss-workfile
     1088                                       ,vss-revision
     1089                                       ,vss-description
     1090                                       ,chr(10)
     1091                                       ,v-db-num
     1092                                       ,v-range-type
     1093                                       ,v-cur-code
     1094                                      ).
     1095       end.
     1096       if (not l-code-range-exist
     1097           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     1098          )
     1099       and ( not can-find (first buf1_code-range no-lock
     1100                           where buf1_code-range.db-num = v-db-num
     1101                             and buf1_code-range.range-type = v-range-type
     1102                             and buf1_code-range.stts = "f"
     1103                          )
     1104           )
     1105       then do:
     1106         if v-g#db-num = 0 then do:
     1107           run new-bcod-gen-code-range in this-procedure
     1108             (input v-db-num,
     1109              input v-range-type
     1110             ) no-error .
     1111           if error-status :error then do:
     1112             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     1113                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     1114                                           ,v-db-num
     1115                                           ,v-range-type
     1116                                           ,v-cur-code
     1117                                           ,chr(10)
     1118                                           ,error-status:get-message(1)
     1119                                           ,return-value
     1120                                          ).
     1121           end.
     1122         end.
     1123         else do:
     1124           if v-range-type = 'sclc':U
     1125           or v-range-type = 'pglc':U
     1126           then do:
     1127             assign
     1128               v-db-for-send = "":U
     1129             .
     1130             if v-g#db-num = 0 then do:
     1131               for each buf_db no-lock
     1132                 where buf_db.db-num > 0
     1133                   and buf_db.db-num <> v-g#news-source-db
     1134               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1135               :
     1136                 assign
     1137                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1138                 .
     1139               end.
     1140               assign
     1141                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1142               .
     1143             end.
     1144             else do:
     1145               if not v-g#news then do:
     1146                 assign
     1147                   v-db-for-send = "0":U
     1148                 .
     1149               end.
     1150             end.
     1151             run nws/cr-route.p ( input 'send-cmd':U
     1152                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1153                                  "code-range":U + chr(1) +
     1154                                  (if v-range-type = 'sclc':U
     1155                                   then string( current-value(s-sclc-code, ub))
     1156                                   else string( current-value(s-pglc-code, ub))
     1157                                   ) + chr(1) +
     1158                                   v-range-type)
     1159                           ,input ?
     1160                           ,input v-db-for-send
     1161                           ) no-error .
     1162             if error-status :error then do:
     1163               undo, return error return-value.
     1164             end.
     1165           end.
     1166         end.
     1167       end.
     1168     end.
     1169   end procedure.
     1170   procedure cre-loc-sc-code-range :
     1171     define input parameter v-cur-code as integer no-undo .
     1172   define input parameter p-cdrg-type as character no-undo .
     1173     do
     1174     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1175     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1176     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1177     :
     1178       define buffer buf_code-range for ub.code-range .
     1179       find first buf_code-range
     1180            where buf_code-range.range-type = p-cdrg-type
     1181              and buf_code-range.first-code >= v-cur-code
     1182            no-error .
     1183       if not available buf_code-range then do:
     1184         run new-bcod-gen-code-range in this-procedure
     1185           ( input 0,
     1186             input p-cdrg-type
     1187           ) no-error .
     1188         if error-status :error then do:
     1189           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1190                                          + "Код &2&1&3 &4"
     1191                                         , chr(10)
     1192                                         , v-cur-code
     1193                                         , error-status:get-message(1)
     1194                                         , return-value
     1195                                        ) .
     1196         end.
     1197       end.
     1198     end.
     1199   end procedure.
     1200   procedure mark-used-if-need :
     1201   define input parameter p-cur-code as integer no-undo .
     1202   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1203   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1204     do
     1205     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1206     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1207     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1208     :
     1209       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1210       define buffer buf_code-range for ub.code-range .
     1211       assign
     1212       v-db-num = if p-range-type = 'sclc':U
     1213                  then 0
     1214                  else p-db-num
     1215       .
     1216   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1217   define buffer locK-batchprocess4 for ub.batchprocess.
     1218   run gbl/lock-prc.p
     1219       (input 'lscc':U
     1220       ,input 0
     1221       ,input 0
     1222       ,input 0
     1223       ,input ""
     1224       ,input ""
     1225       ,input ""
     1226       ,input (
     1227               ",,,Вкл/выкл лок. вес. кодов"
     1228              )
     1229       ,input true
     1230       ,buffer lock-batchprocess4
     1231       ) no-error .
     1232     if error-status :error then do:
     1233       message
     1234         vss-workfile vss-revision vss-description skip
     1235         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1236         view-as alert-box error .
     1237       undo, return error .
     1238     end.
     1239       find first buf_code-range
     1240            where buf_code-range.range-type = p-range-type
     1241              and buf_code-range.first-code >= p-cur-code
     1242              and buf_code-range.last-code <= p-cur-code
     1243              and buf_code-range.db-num = v-db-num
     1244            no-error .
     1245       if not available buf_code-range then do:
     1246         message
     1247           vss-workfile vss-revision vss-description skip
     1248           "Ошибка при создании поиске диапазона" skip
     1249           "База данных" p-db-num skip
     1250           "Код" p-cur-code skip
     1251           "Тип" p-range-type
     1252           error-status :get-message(1) skip
     1253           return-value skip
     1254           view-as alert-box error .
     1255         undo, return error .
     1256       end.
     1257       if buf_code-range.stts = "f":U then do:
     1258         assign
     1259         buf_code-range.stts = "u":U
     1260         .
     1261       end.
     1262     end.
     1263   end procedure.
     1264   do
     1265   on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1266   :
     1267     DEFINE temp-table temp-cli no-undo
     1268       field   obj-type            as character
     1269       field   obj-code            as integer
     1270       field   obj-name            as character
     1271       INDEX pi  IS PRIMARY obj-type  obj-code
     1272     .
     1273     DEFINE TEMP-TABLE tt-fin-doc NO-UNDO LIKE ub.fin-doc
     1274       field   str-fo            as character
     1275     .
     1276     DEFINE TEMP-TABLE tt0-fin-doc-tax NO-UNDO LIKE ub.fin-doc-tax
     1277       INDEX pi1 vat-pc slt-pc with-vat with-slt
     1278     .
     1279     define temp-table tt0-payment no-undo like ub.payment.
     1280     DEFINE TEMP-TABLE tt_fin-doc NO-UNDO LIKE ub.fin-doc.
     1281     DEFINE TEMP-TABLE tt0_fin-doc-tax NO-UNDO LIKE ub.fin-doc-tax.
     1282     DEFINE TEMP-TABLE tt_fin-doc-attr NO-UNDO LIKE ub.fin-doc-attr.
     1283     DEFINE TEMP-TABLE tt_fin-connect NO-UNDO LIKE ub.fin-connect.
     1284     define stream LogStream.
     1285     define buffer buf_contract for ub.contract .
     1286     define buffer buf_fin-ob for ub.fin-ob .
     1287     define buffer b1_fin-schet for ub.fin-schet .
     1288     define buffer b2_fin-schet for ub.fin-schet .
     1289     define variable f-name as character no-undo .
     1290     define variable g#log  as logical   no-undo .
     1291     define variable s-list as character no-undo .
     1292     define variable v-message-text as character no-undo .
     1293     define variable line as integer initial 1 no-undo .
     1294     define variable v-curr-r-b as integer   no-undo .
     1295     define variable curr-rc    as character no-undo .
     1296     define variable sss    as character no-undo .
     1297     define variable p-sys-time  as character no-undo .
     1298     define variable p-koef-rubl as decimal   no-undo .
     1299     define variable p-koef-base as decimal   no-undo .
     1300     define variable p-koef-cont as decimal   no-undo .
     1301     define variable p-koef-doc  as decimal   no-undo .
     1302     define variable v-err as logical   no-undo .
     1303     assign
     1304       v-message-text = "paypvavt.log"
     1305       f-name = "default.cli"
     1306       g#log = yes
     1307     .
     1308     system-dialog get-file f-name
     1309             filters "Списки клиентов *.cli" "*.cli"
     1310             use-filename
     1311             update g#log
     1312             default-extension "cli".
     1313     if not g#log then return  error .
     1314     input from value (f-name).
     1315     REPEAT :
     1316        CREATE temp-cli.
     1317        IMPORT temp-cli.obj-type temp-cli.obj-code NO-ERROR.
     1318        IF ERROR-STATUS :ERROR THEN DO:
     1319          DELETE temp-cli.
     1320          UNDO, NEXT.
     1321        END.
     1322        find first ub.clients no-lock where ub.clients.obj-type = temp-cli.obj-type and ub.clients.obj-code = temp-cli.obj-code no-error .
     1323        assign
     1324          temp-cli.obj-name = ub.clients.obj-name
     1325          s-list = s-list + chr(10) + temp-cli.obj-type + ' ' + string(temp-cli.obj-code) + '  ' + ub.clients.obj-name
     1326        .
     1327     END.
     1328     input close.
     1329     define variable choice as integer   no-undo .
     1330     run gbl/d-askw.w (input "Автоматическая оплата по списку клиентов",
     1331                   input ("Выбраны клиенты :" + s-list ),
     1332                   input "|",
     1333                   input "Совокупный платеж по договору|Раздельные платежи по ФО|Отказ",
     1334                   input "||",
     1335                   input 1,
     1336                   input 3,
     1337                   output choice).
     1338     if choice <> 3 then do:
     1339       run waitfram-show("Ждите...").
     1340       os-delete VALUE(v-message-text).
     1341       output to value (v-message-text).
     1342       OUTPUT CLOSE.
     1343   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1344   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1345     (input  p-host-code
     1346     ,output v-curr-r-b
     1347     )  .
     1348       find first ub.sysconf no-lock      where ub.sysconf.host-code = p-host-code .
     1349       find first ub.firm no-lock         where ub.firm.firm-code    = p-host-code .
     1350       case choice :
     1351         when 2 then run pay-fin-fo .
     1352         when 1 then run pay-contract .
     1353       end.
     1354       OUTPUT CLOSE.
     1355       run waitfram-hide.
     1356       run gbl/prnfilen.w (
     1357         input  "Результат создания платежей",
     1358         input  0,
     1359         input  v-message-text,
     1360         input  7,
     1361         output sss,
     1362         output g#log
     1363         ).
     1364     end.
     1365     else return  error .
     1366   end.
     1367   procedure pay-fin-fo :
     1368   define variable v-fd-code as integer no-undo .
     1369     do  on error undo, return error return-value  :
     1370       for each temp-cli, each buf_contract no-lock where buf_contract.host-code = p-host-code and buf_contract.cli-type = temp-cli.obj-type and buf_contract.cli-code = temp-cli.obj-code :
     1371         for each buf_fin-ob no-lock
     1372           where buf_fin-ob.host-code     = p-host-code
     1373             and buf_fin-ob.contract-code = buf_contract.contract-code
     1374             and buf_fin-ob.doc-type      = 'рас':U
     1375             and buf_fin-ob.status_       =  'факт':U
     1376             and buf_fin-ob.con-stat      < 2
     1377           :
     1378           assign v-err = no .
     1379           run gen-b-code in this-procedure ( input 'fdgb':U
     1380                                           , output v-fd-code) no-error .
     1381           if error-status:error then do:
     1382             define variable v-mess as character no-undo .
     1383             v-mess = substitute("Ошибка при генерации внутреннего номера фин. док-та&1" +
     1384                                   "Вн.№ договора &1  ФО №  &2  от &3:&1&4&1&5"
     1385                                   , buf_contract.contract-code
     1386                                   , buf_fin-ob.prn-doc-code
     1387                                   , buf_fin-ob.doc-date
     1388                                   , chr(10)
     1389                                   , error-status:get-message(1)
     1390                                   , return-value ).
     1391             if error-status:error then do:
     1392               output stream LogStream to Value(v-message-text) append.
     1393               put stream Logstream unformatted
     1394               v-mess skip.
     1395               output stream LogStream close.
     1396             end.
     1397             undo, return error.
     1398           end.
     1399           create tt-fin-doc .
     1400           assign
     1401             tt-fin-doc.host-code       = p-host-code
     1402             tt-fin-doc.fin-doc-code    = v-fd-code
     1403             tt-fin-doc.base-rate       = buf_fin-ob.base-rate
     1404             tt-fin-doc.base-scale      = buf_fin-ob.base-scale
     1405             tt-fin-doc.contract-code   = buf_fin-ob.contract-code
     1406             tt-fin-doc.contract-curr   = buf_fin-ob.contract-curr
     1407             tt-fin-doc.contract-rate   = buf_fin-ob.contract-rate
     1408             tt-fin-doc.contract-scale  = buf_fin-ob.contract-scale
     1409             tt-fin-doc.curr-code       = buf_fin-ob.curr-code
     1410             tt-fin-doc.obj-code        = buf_fin-ob.obj-code
     1411             tt-fin-doc.obj-type        = buf_fin-ob.obj-type
     1412             tt-fin-doc.doc-date        = today
     1413             tt-fin-doc.exch-rate       = buf_fin-ob.exch-rate
     1414             tt-fin-doc.exch-scale      = buf_fin-ob.exch-scale
     1415             tt-fin-doc.PS              = ""
     1416             tt-fin-doc.ocher-pl        = "6"
     1417             tt-fin-doc.stat-pl         = ""
     1418             tt-fin-doc.naznach-plat    = "Оплата по договору № " + buf_contract.contract-prn-code + " от " + string( buf_contract.contract-date,"99/99/9999")
     1419             tt-fin-doc.payer-name      = buf_fin-ob.payer-name
     1420             tt-fin-doc.payer-code      = buf_fin-ob.payer-code
     1421             tt-fin-doc.payer-type      = buf_fin-ob.payer-type
     1422             tt-fin-doc.receiver-code   = buf_fin-ob.receiver-code
     1423             tt-fin-doc.receiver-name   = buf_fin-ob.receiver-name
     1424             tt-fin-doc.receiver-type   = buf_fin-ob.receiver-type
     1425             tt-fin-doc.prn-doc-code    = string(tt-fin-doc.fin-doc-code)
     1426             tt-fin-doc.sum-doc         = buf_fin-ob.sum-doc      - buf_fin-ob.con-sum-doc
     1427             tt-fin-doc.sum-base        = buf_fin-ob.sum-base     - buf_fin-ob.con-sum-base
     1428             tt-fin-doc.sum-rubl        = buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-rubl
     1429             tt-fin-doc.sum-contr       = buf_fin-ob.sum-contract - buf_fin-ob.con-sum-contr
     1430             p-koef-rubl                = ( buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-rubl ) / buf_fin-ob.sum-rubl
     1431             p-koef-base                = ( buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-base ) / buf_fin-ob.sum-rubl
     1432             p-koef-cont                = ( buf_fin-ob.sum-contract - buf_fin-ob.con-sum-contr) / buf_fin-ob.sum-contract
     1433             p-koef-doc                 = ( buf_fin-ob.sum-doc      - buf_fin-ob.con-sum-doc  ) / buf_fin-ob.sum-doc
     1434           .
     1435           for each ub.fin-ob-tax no-lock where ub.fin-ob-tax.host-code = p-host-code and ub.fin-ob-tax.doc-code = buf_fin-ob.doc-code :
     1436             create tt0-fin-doc-tax .
     1437             BUFFER-COPY ub.fin-ob-tax TO tt0-fin-doc-tax .
     1438             assign
     1439               tt0-fin-doc-tax.fin-doc-code       = tt-fin-doc.fin-doc-code
     1440               tt0-fin-doc-tax.sum-line-doc       = ROUND(tt0-fin-doc-tax.sum-line-doc       , 2)  * p-koef-doc
     1441               tt0-fin-doc-tax.sum-vat-line-doc   = ROUND(tt0-fin-doc-tax.sum-vat-line-doc   , 2)  * p-koef-doc
     1442               tt0-fin-doc-tax.sum-slt-line-doc   = ROUND(tt0-fin-doc-tax.sum-slt-line-doc   , 2)  * p-koef-doc
     1443               tt0-fin-doc-tax.sum-line-rubl      = ROUND(tt0-fin-doc-tax.sum-line-rubl      , 2)  * p-koef-rubl
     1444               tt0-fin-doc-tax.sum-vat-line-rubl  = ROUND(tt0-fin-doc-tax.sum-vat-line-rubl  , 2)  * p-koef-rubl
     1445               tt0-fin-doc-tax.sum-slt-line-rubl  = ROUND(tt0-fin-doc-tax.sum-slt-line-rubl  , 2)  * p-koef-rubl
     1446               tt0-fin-doc-tax.sum-line-base      = ROUND(tt0-fin-doc-tax.sum-line-base      , 2)  * p-koef-base
     1447               tt0-fin-doc-tax.sum-vat-line-base  = ROUND(tt0-fin-doc-tax.sum-vat-line-base  , 2)  * p-koef-base
     1448               tt0-fin-doc-tax.sum-slt-line-base  = ROUND(tt0-fin-doc-tax.sum-slt-line-base  , 2)  * p-koef-base
     1449               tt0-fin-doc-tax.sum-line-contr     = tt0-fin-doc-tax.sum-line-contr      * p-koef-cont
     1450               tt0-fin-doc-tax.sum-vat-line-contr = tt0-fin-doc-tax.sum-vat-line-contr  * p-koef-cont
     1451               tt0-fin-doc-tax.sum-slt-line-contr = tt0-fin-doc-tax.sum-slt-line-contr  * p-koef-cont
     1452             .
     1453           end.
     1454           run CheckCli no-error .
     1455           if error-status:error then do:
     1456             assign v-err = yes .
     1457             output stream LogStream to Value(v-message-text) append.
     1458             put stream Logstream unformatted
     1459             substitute("Несоответствие плательщика или получателя договору! Вн.№ договора &1  ФО №  &2  от &3", buf_contract.contract-code, buf_fin-ob.prn-doc-code, buf_fin-ob.doc-date) skip.
     1460             output stream LogStream close.
     1461           end.
     1462           run FindBank .
     1463           if buf_contract.pay-nal = no  then do:
     1464             if buf_fin-ob.sum-contr > 0 then assign tt-fin-doc.fin-doc-type = 'рпп':U .
     1465             else                             assign tt-fin-doc.fin-doc-type = 'ппп':U .
     1466             find first ub.currency no-lock where ub.currency.curr-code = b2_fin-schet.curr-code .
     1467             assign tt-fin-doc.curr-code = b2_fin-schet.curr-code .
     1468             case b2_fin-schet.curr-code :
     1469                 when 0 then do:
     1470                   assign tt-fin-doc.sum-doc = tt-fin-doc.sum-rubl .
     1471                   for each tt0-fin-doc-tax no-lock :
     1472                     assign
     1473                       tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-rubl
     1474                       tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-rubl
     1475                       tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-rubl
     1476                     .
     1477                   end.
     1478                 end.
     1479                 when v-curr-r-b then do:
     1480                   assign tt-fin-doc.sum-doc = tt-fin-doc.sum-base .
     1481                   for each tt0-fin-doc-tax no-lock :
     1482                     assign
     1483                       tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-base
     1484                       tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-base
     1485                       tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-base
     1486                     .
     1487                   end.
     1488                 end.
     1489                 when buf_contract.curr-code then do:
     1490                   assign tt-fin-doc.sum-doc = tt-fin-doc.sum-contr .
     1491                   for each tt0-fin-doc-tax no-lock :
     1492                     assign
     1493                       tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-contr
     1494                       tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-contr
     1495                       tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-contr
     1496                     .
     1497                   end.
     1498                 end.
     1499               otherwise do:
     1500   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1501   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1502     (input  b2_fin-schet.curr-code
     1503     ,input  today
     1504     ,output tt-fin-doc.exch-rate
     1505     ,output tt-fin-doc.exch-scale
     1506     ,output curr-rc
     1507     )  .
     1508                 assign tt-fin-doc.sum-doc = tt-fin-doc.sum-rubl * tt-fin-doc.exch-scale / tt-fin-doc.exch-rate .
     1509               end.
     1510             end.
     1511           end.
     1512           else do:
     1513             if buf_contract.pay-nal = yes then do:
     1514               if buf_fin-ob.sum-contr > 0 then assign tt-fin-doc.fin-doc-type = 'рко':U .
     1515               else                             assign tt-fin-doc.fin-doc-type = 'пко':U .
     1516             end.
     1517             else do:
     1518               if buf_fin-ob.sum-contr > 0 then assign tt-fin-doc.fin-doc-type = 'апр':U .
     1519               else                             assign tt-fin-doc.fin-doc-type = 'апп':U .
     1520             end.
     1521             assign
     1522               tt-fin-doc.receiver-code-schet = 0
     1523               tt-fin-doc.receiver-bank-name  = ""
     1524               tt-fin-doc.receiver-c-schet    = ""
     1525               tt-fin-doc.receiver-r-schet    = ""
     1526               tt-fin-doc.payer-code-schet = 0
     1527               tt-fin-doc.payer-bank-name  = ""
     1528               tt-fin-doc.payer-c-schet    = ""
     1529               tt-fin-doc.payer-r-schet    = ""
     1530             .
     1531           end.
     1532           assign tt-fin-doc.fin-ext-doc-type = tt-fin-doc.fin-doc-type .
     1533           if tt-fin-doc.sum-contr < 0 then do:
     1534             assign
     1535               tt-fin-doc.payer-sign1        = ub.firm.director
     1536               tt-fin-doc.payer-sign2        = ub.sysconf.snr-accnt
     1537               tt-fin-doc.payer-sign3        = ub.sysconf.cashier
     1538             .
     1539             run InvertCli .
     1540           end.
     1541           else
     1542             assign
     1543               tt-fin-doc.receiver-sign1        = ub.firm.director
     1544               tt-fin-doc.receiver-sign2        = ub.sysconf.snr-accnt
     1545               tt-fin-doc.receiver-sign3        = ub.sysconf.cashier
     1546             .
     1547           if buf_contract.pay-nal = no then do:
     1548             run StrTax (input-output sss) .
     1549             assign tt-fin-doc.naznach-plat = tt-fin-doc.naznach-plat + "@" + sss .
     1550           end.
     1551           else if buf_contract.pay-nal = yes then do:
     1552             run StrTax (input-output tt-fin-doc.including) .
     1553           end.
     1554           define variable p-doc-rec as recid no-undo.
     1555           run UchetCode .
     1556           if v-err = no then do:
     1557             tt-fin-doc.doc-author = "fin-ob".
     1558             run ref/findoc0.p (
     1559               input-output p-doc-rec
     1560              ,input 'ДОБАВЛЕНИЕ':U
     1561              ,input yes
     1562              ,input tt-fin-doc.host-code            ,input tt-fin-doc.fin-doc-code         ,input tt-fin-doc.an-uchet-code        ,input tt-fin-doc.an-uchet-value       ,input tt-fin-doc.base-rate            ,input tt-fin-doc.base-scale           ,input tt-fin-doc.cel-nazn-code        ,input tt-fin-doc.cel-nazn-value       ,input tt-fin-doc.contract-code        ,input tt-fin-doc.contract-curr        ,input tt-fin-doc.contract-rate        ,input tt-fin-doc.contract-scale       ,input tt-fin-doc.cor-acc              ,input tt-fin-doc.cor-acc-value        ,input tt-fin-doc.cor-acc1             ,input tt-fin-doc.cor-acc1-value       ,input tt-fin-doc.curr-code            ,input tt-fin-doc.doc-date             ,input tt-fin-doc.shift-date           ,input tt-fin-doc.shift-num            ,input tt-fin-doc.shift-name           ,input tt-fin-doc.enclosure            ,input tt-fin-doc.exch-rate            ,input tt-fin-doc.exch-scale           ,input tt-fin-doc.f104                 ,input tt-fin-doc.f105                 ,input tt-fin-doc.f106                 ,input tt-fin-doc.f107                 ,input tt-fin-doc.f108                 ,input tt-fin-doc.f109                 ,input tt-fin-doc.f110                 ,input tt-fin-doc.f22                  ,input tt-fin-doc.f23                  ,input tt-fin-doc.fact-date            ,input tt-fin-doc.fin-doc-type         ,input tt-fin-doc.fin-ext-doc-type     ,input tt-fin-doc.in-doc-code          ,input tt-fin-doc.in-host-code         ,input tt-fin-doc.including            ,input tt-fin-doc.nazn-pl              ,input tt-fin-doc.naznach-plat         ,input tt-fin-doc.ocher-pl             ,input tt-fin-doc.out-doc-code         ,input tt-fin-doc.out-host-code        ,input tt-fin-doc.pay-date             ,input tt-fin-doc.payer-bank-name      ,input tt-fin-doc.payer-bank-city      ,input tt-fin-doc.payer-bik            ,input tt-fin-doc.payer-c-schet        ,input tt-fin-doc.payer-code           ,input tt-fin-doc.payer-code-schet     ,input tt-fin-doc.payer-dop1           ,input tt-fin-doc.payer-dop2           ,input tt-fin-doc.payer-inn            ,input tt-fin-doc.payer-kpp            ,input tt-fin-doc.payer-name           ,input tt-fin-doc.payer-okpo           ,input tt-fin-doc.payer-passport      ,input tt-fin-doc.payer-r-schet        ,input tt-fin-doc.payer-type           ,input tt-fin-doc.perm-date            ,input tt-fin-doc.prn-doc-code         ,input tt-fin-doc.PS                   ,input tt-fin-doc.receiver-bank-name   ,input tt-fin-doc.receiver-bank-city   ,input tt-fin-doc.receiver-bik         ,input tt-fin-doc.receiver-c-schet     ,input tt-fin-doc.receiver-code        ,input tt-fin-doc.receiver-code-schet  ,input tt-fin-doc.receiver-dop1        ,input tt-fin-doc.receiver-dop2        ,input tt-fin-doc.receiver-inn         ,input tt-fin-doc.receiver-kpp         ,input tt-fin-doc.receiver-name        ,input tt-fin-doc.receiver-okpo        ,input tt-fin-doc.receiver-passport    ,input tt-fin-doc.receiver-r-schet     ,input tt-fin-doc.receiver-type        ,input tt-fin-doc.srok-pl              ,input tt-fin-doc.stat-pl              ,input tt-fin-doc.str-podr-code        ,input tt-fin-doc.str-podr-type        ,input tt-fin-doc.str-podr-name        ,input tt-fin-doc.sum-base             ,input tt-fin-doc.sum-doc              ,input tt-fin-doc.sum-rubl             ,input tt-fin-doc.sum-contr            ,input tt-fin-doc.trn-doc-code         ,input tt-fin-doc.vid-opl              ,input tt-fin-doc.vid-plat
     1563              ,input tt-fin-doc.con-sum-rubl         ,input tt-fin-doc.con-sum-base         ,input tt-fin-doc.con-sum-doc          ,input tt-fin-doc.con-sum-contr        ,input tt-fin-doc.con-stat             ,input tt-fin-doc.payer-sign1                ,input tt-fin-doc.payer-sign2                ,input tt-fin-doc.payer-sign3                ,input tt-fin-doc.payer-sign4                ,input tt-fin-doc.receiver-sign1                ,input tt-fin-doc.receiver-sign2                ,input tt-fin-doc.receiver-sign3                ,input tt-fin-doc.receiver-sign4                ,input tt-fin-doc.obj-type                   ,input tt-fin-doc.obj-code                   ,input tt-fin-doc.doc-author                 ,input tt-fin-doc.fact-author                ,input tt-fin-doc.CashBookId
     1564              ,input table tt0-fin-doc-tax
     1565              ,input table tt_fin-doc-attr
     1566              ,input no
     1567              ,input table tt0-payment
     1568              ) no-error .
     1569             if error-status:error then do:
     1570               assign v-err = yes .
     1571               output stream LogStream to Value(v-message-text) append.
     1572               put stream Logstream unformatted
     1573               substitute("Ошибка создания платежа! Вн.№ договора &1  ФО №  &2  от &3&4&5"
     1574                          , buf_contract.contract-code
     1575                          , buf_fin-ob.prn-doc-code
     1576                          , buf_fin-ob.doc-date
     1577                          ,chr(10)
     1578                          ,substitute( "&1&2&3", return-value, chr(10), error-status :get-message (1))
     1579                          ) skip.
     1580               output stream LogStream close.
     1581             end.
     1582           end.
     1583           if v-err = no then do:
     1584             create ub.fin-connect .
     1585             assign
     1586               ub.fin-connect.connect-code   = next-value( s-fin-connect, ub )
     1587               ub.fin-connect.host-code      = p-host-code
     1588               ub.fin-connect.fin-doc-code   = tt-fin-doc.fin-doc-code
     1589               ub.fin-connect.fin-ob-code    = buf_fin-ob.doc-code
     1590               ub.fin-connect.contract-code  = buf_fin-ob.contract-code
     1591               ub.fin-connect.curr-code      = buf_fin-ob.curr-code
     1592               ub.fin-connect.base-rate      = buf_fin-ob.base-rate
     1593               ub.fin-connect.base-scale     = buf_fin-ob.base-scale
     1594               ub.fin-connect.contract-curr  = buf_fin-ob.contract-curr
     1595               ub.fin-connect.contract-rate  = buf_fin-ob.contract-rate
     1596               ub.fin-connect.contract-scale = buf_fin-ob.contract-scale
     1597               ub.fin-connect.exch-rate      = buf_fin-ob.exch-rate
     1598               ub.fin-connect.exch-scale     = buf_fin-ob.exch-scale
     1599               ub.fin-connect.status_        = 'тек':U
     1600               ub.fin-connect.sum-rubl-ob    = buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-rubl
     1601               ub.fin-connect.sum-base-ob    = buf_fin-ob.sum-base     - buf_fin-ob.con-sum-base
     1602               ub.fin-connect.sum-contr-ob   = buf_fin-ob.sum-contract - buf_fin-ob.con-sum-contr
     1603               ub.fin-connect.sum-rubl       = buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-rubl
     1604               ub.fin-connect.sum-base       = buf_fin-ob.sum-base     - buf_fin-ob.con-sum-base
     1605               ub.fin-connect.sum-doc        = buf_fin-ob.sum-doc      - buf_fin-ob.con-sum-doc
     1606               ub.fin-connect.sum-contr      = buf_fin-ob.sum-contr    - buf_fin-ob.con-sum-contr
     1607             .
     1608   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1609   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     1610     (output ub.fin-connect.user-db-num
     1611     ,output ub.fin-connect.user-name
     1612     ,output ub.fin-connect.fact-date
     1613     ,output p-sys-time
     1614     ,output ub.fin-connect.fact-time
     1615     )  .
     1616             find first ub.fin-ob exclusive-lock where ub.fin-ob.host-code = p-host-code and ub.fin-ob.doc-code = buf_fin-ob.doc-code .
     1617             assign
     1618               ub.fin-ob.con-sum-doc   = ub.fin-ob.sum-doc
     1619               ub.fin-ob.con-sum-rubl  = ub.fin-ob.sum-rubl
     1620               ub.fin-ob.con-sum-base  = ub.fin-ob.sum-base
     1621               ub.fin-ob.con-sum-contr = ub.fin-ob.sum-contr
     1622               ub.fin-ob.con-stat      = 2
     1623             .
     1624             find first ub.fin-doc exclusive-lock where recid(ub.fin-doc) = p-doc-rec .
     1625             assign
     1626               ub.fin-doc.con-sum-rubl  = ub.fin-doc.sum-rubl
     1627               ub.fin-doc.con-sum-base  = ub.fin-doc.sum-base
     1628               ub.fin-doc.con-sum-doc   = ub.fin-doc.sum-doc
     1629               ub.fin-doc.con-sum-contr = ub.fin-doc.sum-contr
     1630               ub.fin-doc.con-stat      = 2
     1631             .
     1632             output stream LogStream to Value(v-message-text) append.
     1633             put stream Logstream unformatted
     1634             substitute("Успешно создан &1 № &2 ! Вн.№ договора &3  ФО №  &4  от &5", tt-fin-doc.fin-doc-type, tt-fin-doc.prn-doc-code, buf_contract.contract-code, buf_fin-ob.prn-doc-code, buf_fin-ob.doc-date) skip.
     1635             output stream LogStream close.
     1636           end.
     1637         end.
     1638       end.
     1639     end.
     1640   end procedure.
     1641   procedure pay-contract :
     1642   define variable v-fd-code as integer no-undo .
     1643     do on error undo, return error return-value :
     1644       for each temp-cli, each buf_contract no-lock where buf_contract.host-code = p-host-code and buf_contract.cli-type = temp-cli.obj-type and buf_contract.cli-code = temp-cli.obj-code :
     1645         for each buf_fin-ob no-lock
     1646           where buf_fin-ob.host-code     = p-host-code
     1647             and buf_fin-ob.contract-code = buf_contract.contract-code
     1648             and buf_fin-ob.doc-type      = 'рас':U
     1649             and buf_fin-ob.status_       =  'факт':U
     1650             and buf_fin-ob.con-stat      < 2
     1651           :
     1652           assign v-err = no .
     1653           if ub.sysconf.fin-calc = 1 then do:
     1654             find first tt-fin-doc
     1655               where tt-fin-doc.contract-code = buf_fin-ob.contract-code
     1656                 and tt-fin-doc.obj-type      = buf_fin-ob.obj-type
     1657                 and tt-fin-doc.obj-code      = buf_fin-ob.obj-code
     1658             no-error .
     1659           end.
     1660           else do:
     1661             find first tt-fin-doc where tt-fin-doc.contract-code = buf_contract.contract-code no-error .
     1662           end.
     1663           if not available tt-fin-doc then do:
     1664             run gen-b-code in this-procedure ( input 'fdgb':U
     1665                                             , output v-fd-code) no-error .
     1666             if error-status:error then do:
     1667               define variable v-mess as character no-undo .
     1668               v-mess = substitute("Ошибка при генерации внутреннего номера фин. док-та&1" +
     1669                                    "Вн.№ договора &1  ФО №  &2  от &3:&1&4&1&5"
     1670                                    , buf_contract.contract-code
     1671                                    , buf_fin-ob.prn-doc-code
     1672                                    , buf_fin-ob.doc-date
     1673                                     , chr(10)
     1674                                     , error-status:get-message(1)
     1675                                     , return-value ).
     1676               if error-status:error then do:
     1677                 output stream LogStream to Value(v-message-text) append.
     1678                 put stream Logstream unformatted
     1679                 v-mess skip.
     1680                 output stream LogStream close.
     1681               end.
     1682               undo, return error.
     1683             end.
     1684             create tt-fin-doc .
     1685             assign
     1686               tt-fin-doc.host-code       = p-host-code
     1687               tt-fin-doc.fin-doc-code    = v-fd-code
     1688               tt-fin-doc.prn-doc-code    = string(tt-fin-doc.fin-doc-code)
     1689               tt-fin-doc.contract-code   = buf_fin-ob.contract-code
     1690               tt-fin-doc.contract-curr   = buf_fin-ob.contract-curr
     1691               tt-fin-doc.curr-code       = buf_fin-ob.curr-code
     1692               tt-fin-doc.obj-code        = buf_fin-ob.obj-code
     1693               tt-fin-doc.obj-type        = buf_fin-ob.obj-type
     1694               tt-fin-doc.doc-date        = today
     1695               tt-fin-doc.PS              = ""
     1696               tt-fin-doc.ocher-pl        = "6"
     1697               tt-fin-doc.stat-pl         = ""
     1698               tt-fin-doc.naznach-plat    = "Оплата по договору № " + buf_contract.contract-prn-code + " от " + string( buf_contract.contract-date,"99/99/9999")
     1699               tt-fin-doc.payer-name      = buf_fin-ob.payer-name
     1700               tt-fin-doc.payer-code      = buf_fin-ob.payer-code
     1701               tt-fin-doc.payer-type      = buf_fin-ob.payer-type
     1702               tt-fin-doc.receiver-code   = buf_fin-ob.receiver-code
     1703               tt-fin-doc.receiver-name   = buf_fin-ob.receiver-name
     1704               tt-fin-doc.receiver-type   = buf_fin-ob.receiver-type
     1705               tt-fin-doc.sum-base        = buf_fin-ob.sum-base     - buf_fin-ob.con-sum-base
     1706               tt-fin-doc.sum-rubl        = buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-rubl
     1707               tt-fin-doc.sum-contr       = buf_fin-ob.sum-contract - buf_fin-ob.con-sum-contr
     1708               tt-fin-doc.sum-doc         = buf_fin-ob.sum-doc      - buf_fin-ob.con-sum-doc
     1709               tt-fin-doc.base-scale      = buf_fin-ob.base-scale
     1710               tt-fin-doc.contract-scale  = buf_fin-ob.contract-scale
     1711               tt-fin-doc.exch-scale      = buf_fin-ob.exch-scale
     1712               p-koef-rubl                = ( buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-rubl ) / buf_fin-ob.sum-rubl
     1713               p-koef-base                = ( buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-base ) / buf_fin-ob.sum-rubl
     1714               p-koef-cont                = ( buf_fin-ob.sum-contract - buf_fin-ob.con-sum-contr) / buf_fin-ob.sum-contract
     1715               p-koef-doc                 = ( buf_fin-ob.sum-doc      - buf_fin-ob.con-sum-doc  ) / buf_fin-ob.sum-doc
     1716             .
     1717             run CheckCli no-error .
     1718             if error-status:error then do:
     1719               output stream LogStream to Value(v-message-text) append.
     1720               put stream Logstream unformatted
     1721               substitute("Несоответствие плательщика или получателя договору! Вн.№ договора &1  ФО №  &2  от &3", buf_contract.contract-code, buf_fin-ob.prn-doc-code, buf_fin-ob.doc-date) skip.
     1722               output stream LogStream close.
     1723             end.
     1724           end.
     1725           else do:
     1726             assign
     1727               tt-fin-doc.sum-base  = tt-fin-doc.sum-base  + buf_fin-ob.sum-base     - buf_fin-ob.con-sum-base
     1728               tt-fin-doc.sum-rubl  = tt-fin-doc.sum-rubl  + buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-rubl
     1729               tt-fin-doc.sum-contr = tt-fin-doc.sum-contr + buf_fin-ob.sum-contract - buf_fin-ob.con-sum-contr
     1730               tt-fin-doc.sum-doc   = tt-fin-doc.sum-doc   + buf_fin-ob.sum-doc      - buf_fin-ob.con-sum-doc
     1731               p-koef-rubl          = ( buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-rubl ) / buf_fin-ob.sum-rubl
     1732               p-koef-base          = ( buf_fin-ob.sum-rubl     - buf_fin-ob.con-sum-base ) / buf_fin-ob.sum-rubl
     1733               p-koef-cont          = ( buf_fin-ob.sum-contract - buf_fin-ob.con-sum-contr) / buf_fin-ob.sum-contract
     1734               p-koef-doc           = ( buf_fin-ob.sum-doc      - buf_fin-ob.con-sum-doc  ) / buf_fin-ob.sum-doc
     1735             .
     1736             if tt-fin-doc.obj-code <> buf_fin-ob.obj-code or tt-fin-doc.obj-type <> buf_fin-ob.obj-type then assign tt-fin-doc.obj-type = "" tt-fin-doc.obj-code = 0 .
     1737           end.
     1738           if tt-fin-doc.str-fo <> "" then assign tt-fin-doc.str-fo = tt-fin-doc.str-fo + ", "  .
     1739           assign tt-fin-doc.str-fo = tt-fin-doc.str-fo + string(buf_fin-ob.doc-code) .
     1740           for each ub.fin-ob-tax no-lock where ub.fin-ob-tax.host-code = p-host-code and ub.fin-ob-tax.doc-code = buf_fin-ob.doc-code :
     1741             find first tt0-fin-doc-tax
     1742               where tt0-fin-doc-tax.vat-pc       = ub.fin-ob-tax.vat-pc
     1743                 and tt0-fin-doc-tax.slt-pc       = ub.fin-ob-tax.slt-pc
     1744                 and tt0-fin-doc-tax.with-vat     = ub.fin-ob-tax.with-vat
     1745                 and tt0-fin-doc-tax.with-slt     = ub.fin-ob-tax.with-slt
     1746                 and tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     1747             no-error .
     1748             if not available tt0-fin-doc-tax then do:
     1749               create tt0-fin-doc-tax .
     1750               BUFFER-COPY ub.fin-ob-tax TO tt0-fin-doc-tax .
     1751               assign
     1752                 tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     1753                 tt0-fin-doc-tax.host-code    = p-host-code
     1754                 tt0-fin-doc-tax.line-num     = line
     1755                 line = line + 1
     1756                 tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-doc       * p-koef-doc
     1757                 tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-doc   * p-koef-doc
     1758                 tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-doc   * p-koef-doc
     1759                 tt0-fin-doc-tax.sum-line-rubl      = tt0-fin-doc-tax.sum-line-rubl      * p-koef-rubl
     1760                 tt0-fin-doc-tax.sum-vat-line-rubl  = tt0-fin-doc-tax.sum-vat-line-rubl  * p-koef-rubl
     1761                 tt0-fin-doc-tax.sum-slt-line-rubl  = tt0-fin-doc-tax.sum-slt-line-rubl  * p-koef-rubl
     1762                 tt0-fin-doc-tax.sum-line-base      = tt0-fin-doc-tax.sum-line-base      * p-koef-base
     1763                 tt0-fin-doc-tax.sum-vat-line-base  = tt0-fin-doc-tax.sum-vat-line-base  * p-koef-base
     1764                 tt0-fin-doc-tax.sum-slt-line-base  = tt0-fin-doc-tax.sum-slt-line-base  * p-koef-base
     1765                 tt0-fin-doc-tax.sum-line-contr     = tt0-fin-doc-tax.sum-line-contr     * p-koef-cont
     1766                 tt0-fin-doc-tax.sum-vat-line-contr = tt0-fin-doc-tax.sum-vat-line-contr * p-koef-cont
     1767                 tt0-fin-doc-tax.sum-slt-line-contr = tt0-fin-doc-tax.sum-slt-line-contr * p-koef-cont
     1768               .
     1769             end.
     1770             else do:
     1771               assign
     1772                 tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-doc       + ub.fin-ob-tax.sum-line-doc       * p-koef-doc
     1773                 tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-doc   + ub.fin-ob-tax.sum-vat-line-doc   * p-koef-doc
     1774                 tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-doc   + ub.fin-ob-tax.sum-slt-line-doc   * p-koef-doc
     1775                 tt0-fin-doc-tax.sum-line-rubl      = tt0-fin-doc-tax.sum-line-rubl      + ub.fin-ob-tax.sum-line-rubl      * p-koef-rubl
     1776                 tt0-fin-doc-tax.sum-vat-line-rubl  = tt0-fin-doc-tax.sum-vat-line-rubl  + ub.fin-ob-tax.sum-vat-line-rubl  * p-koef-rubl
     1777                 tt0-fin-doc-tax.sum-slt-line-rubl  = tt0-fin-doc-tax.sum-slt-line-rubl  + ub.fin-ob-tax.sum-slt-line-rubl  * p-koef-rubl
     1778                 tt0-fin-doc-tax.sum-line-base      = tt0-fin-doc-tax.sum-line-base      + ub.fin-ob-tax.sum-line-base      * p-koef-base
     1779                 tt0-fin-doc-tax.sum-vat-line-base  = tt0-fin-doc-tax.sum-vat-line-base  + ub.fin-ob-tax.sum-vat-line-base  * p-koef-base
     1780                 tt0-fin-doc-tax.sum-slt-line-base  = tt0-fin-doc-tax.sum-slt-line-base  + ub.fin-ob-tax.sum-slt-line-base  * p-koef-base
     1781                 tt0-fin-doc-tax.sum-line-contr     = tt0-fin-doc-tax.sum-line-contr     + ub.fin-ob-tax.sum-line-contr     * p-koef-cont
     1782                 tt0-fin-doc-tax.sum-vat-line-contr = tt0-fin-doc-tax.sum-vat-line-contr + ub.fin-ob-tax.sum-vat-line-contr * p-koef-cont
     1783                 tt0-fin-doc-tax.sum-slt-line-contr = tt0-fin-doc-tax.sum-slt-line-contr + ub.fin-ob-tax.sum-slt-line-contr * p-koef-cont
     1784               .
     1785             end.
     1786           end.
     1787           create tt_fin-connect .
     1788           assign
     1789            tt_fin-connect.connect-code   = next-value( s-fin-connect, ub )
     1790            tt_fin-connect.host-code      = p-host-code
     1791            tt_fin-connect.fin-doc-code   = tt-fin-doc.fin-doc-code
     1792            tt_fin-connect.fin-ob-code    = buf_fin-ob.doc-code
     1793            tt_fin-connect.contract-code  = buf_fin-ob.contract-code
