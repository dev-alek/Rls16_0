        1   block-level on error undo, throw.
        2   define input param d-num like ub.price-doc.doc-num no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: pr-notls.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: str/pr-notls.p $":U .
        8   define variable vss-description as character no-undo init "проверка, что ни одна из старых цен в переоценке не потеряна".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       72   define variable par-type          as character no-undo.
       73   define variable v-value-character as character no-undo .
       74   define variable v-value-date      as date      no-undo .
       75   define variable v-value-decimal   as decimal   no-undo .
       76   define variable v-value-integer   as integer   no-undo .
       77   define variable v-value-logical   as logical   no-undo .
       78   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
       79   define variable gp-price-sale like ub.price-list.price-sale no-undo.
       80   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
       81   define variable gp-excise     like ub.price-list.excise     no-undo.
       82   define variable gp-b-code     like ub.price-list.b-code     no-undo.
       83   define buffer main-list      for ub.price-list.
       84   define buffer sub-list       for ub.price-list.
       85   define buffer old-list       for ub.price-list.
       86   define buffer temp-price-doc for ub.price-doc.
       87   define buffer buf_bar-code   for ub.bar-code  .
       88   define buffer buf_parts      for ub.parts  .
       89   define buffer buf_goods      for ub.goods  .
       90   define variable v-str1        as character  no-undo .
       91   define variable par-pr-notls  as character  no-undo .
       92   define variable par-pr-dscnt  as character  no-undo .
       93   define variable par-pr-equ-dq as integer    no-undo .
       94   define variable ok-dscnt      as logical    no-undo .
       95   find first temp-price-doc where temp-price-doc.doc-num =  d-num no-lock .
       96   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   empty temp-table thbjattr_thbj-attr.
       98   run adm/shattri.p (
       99      input "get":U
      100     ,input temp-price-doc.obj-type
      101     ,input temp-price-doc.obj-code
      102     ,input 'overval':U
      103     ,input  ""
      104     ,output v-value-character
      105     ,output v-value-date
      106     ,output v-value-decimal
      107     ,output v-value-integer
      108     ,output v-value-logical
      109     ,output par-type
      110     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      111     ) no-error .
      112   for each thbjattr_thbj-attr :
      113       if thbjattr_thbj-attr.prop-code = 'pr-dscnt':U  then par-pr-dscnt  =  string( thbjattr_thbj-attr.property-value-logical) .
      114       if thbjattr_thbj-attr.prop-code = 'pr-notls':U  then par-pr-notls  =  string( thbjattr_thbj-attr.property-value-logical) .
      115       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq =  thbjattr_thbj-attr.property-value-integer .
      116   end.
      117   if par-pr-notls <> "yes" then
      118     return.
      119   ok-dscnt = false  .
      120   for each main-list where
      121            main-list.doc-num    = d-num and
      122            main-list.main-price = yes:
      123   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      125     (input  main-list.obj-type
      126     ,input  main-list.obj-code
      127     ,input  main-list.b-code
      128     ,input  0
      129     ,input  0
      130     ,output gp-doc-num
      131     ,output gp-price-sale
      132     ,output gp-road-tax
      133     ,output gp-excise
      134     ) no-error .
      135       if error-status :error then do:
      136         message vss-workfile vss-revision vss-description skip
      137         error-status :get-message(1)
      138         "Ошибка поиска цены главного кода "
      139         .
      140         return.
      141       end.
      142     for each  old-list no-lock where
      143               old-list.doc-num    = gp-doc-num and
      144               old-list.artic      = main-list.artic and
      145               old-list.prod-type  = main-list.prod-type and
      146               old-list.prod-code  = main-list.prod-code and
      147               old-list.main-price = no:
      148       find sub-list where
      149            sub-list.doc-num = d-num and
      150            sub-list.b-code  = old-list.b-code and
      151            sub-list.price-type = "" no-error.
      152       if not available sub-list then do:
      153         if par-pr-equ-dq = 1  then do:
      154            find first buf_bar-code no-lock where
      155                       buf_bar-code.b-code = old-list.b-code and
      156                       buf_bar-code.in-code <> "" no-error .
      157            find first buf_parts no-lock where
      158                 buf_parts.out-code  = 'free-zone':U and
      159                 buf_parts.rsrv-free = true  and
      160                 buf_parts.status_   = false and
      161                 buf_parts.obj-type  = main-list.obj-type and
      162                 buf_parts.obj-code  = main-list.obj-code and
      163                 buf_parts.artic     = old-list.artic and
      164                 buf_parts.prod-type = old-list.prod-type and
      165                 buf_parts.prod-code = old-list.prod-code and
      166                 buf_parts.in-code   = buf_bar-code.in-code and
      167                 buf_parts.part-code = buf_bar-code.part-code
      168                 no-error .
      169         if available buf_bar-code then do:
      170            if buf_bar-code.in-code <> "" and not available buf_parts then next.
      171         end.
      172         message
      173           "Потеряна по крайней мере одна существующая цена," skip
      174           "что запрещено настройкой pr-notls." skip (2)
      175           "Код:" old-list.b-code skip
      176           "Номер предыдущей переоценки:" gp-doc-num
      177           view-as alert-box error.
      178         return error.
      179         end.
      180         else next.
      181       end.
      182       if par-pr-dscnt = "yes" then do:
      183             if not ok-dscnt and
      184               sub-list.d-pcnt <> old-list.d-pcnt then do:
      185                 find first buf_goods no-lock where
      186                             buf_goods.artic     = sub-list.artic     and
      187                             buf_goods.prod-type = sub-list.prod-type and
      188                             buf_goods.prod-code = sub-list.prod-code no-error .
      189                   v-str1 = substitute("Переоценка. Изменилась по крайней мере одна скидка&4 Товар &5 &6&4 Код: &1&4 Старая скидка: &2 % (переоценка &7)&4 Новая скидка: &3 %" ,
      190                                         old-list.b-code,
      191                                         old-list.d-pcnt,
      192                                         sub-list.d-pcnt,
      193                                         chr(10),
      194                                         buf_goods.artic,
      195                                         buf_goods.gds-name,
      196                                         old-list.doc-num
      197                                         ).
      198                   message
      199                      v-str1 skip (2)
      200                     "Продолжать?"
      201                     view-as alert-box question buttons OK-Cancel update ok-dscnt.
      202                 if not ok-dscnt then
      203                   return error v-str1.
      204             end.
      205       end.
      206     end.
      207   end.
