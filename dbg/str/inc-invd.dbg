      326   define buffer buf_chk-doc for ub.chk-doc.
      327   DEFINE BUTTON b-exit AUTO-GO
      328        LABEL "&Ввод "
      329        SIZE 10 BY 1
      330        BGCOLOR 8 .
      331   DEFINE BUTTON b-help
      332        LABEL "Помо&щь"
      333        SIZE 10 BY 1
      334        BGCOLOR 8 .
      335   DEFINE BUTTON b-quit AUTO-GO
      336        LABEL "&Отмена"
      337        SIZE 10 BY 1
      338        BGCOLOR 8 .
      339   DEFINE VARIABLE E-message AS CHARACTER
      340        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      341        SIZE 98 BY 2.13
      342        BGCOLOR 8  NO-UNDO.
      343   DEFINE VARIABLE chk-amount AS INTEGER FORMAT "->>>9":U INITIAL 0
      344        LABEL "ВСЕГО Чеков по инвентар."
      345        VIEW-AS FILL-IN
      346        SIZE 5 BY 1
      347        BGCOLOR 3 FGCOLOR 14  NO-UNDO.
      348   DEFINE VARIABLE f-processed AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
      349        LABEL "Просмотрено строк"
      350        VIEW-AS FILL-IN
      351        SIZE 11 BY 1
      352        BGCOLOR 3  NO-UNDO.
      353   DEFINE VARIABLE f-processed-ok AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
      354        LABEL "Обработано строк"
      355        VIEW-AS FILL-IN
      356        SIZE 11 BY 1
      357        BGCOLOR 3  NO-UNDO.
