        1   DEFINE NEW SHARED BUFFER X_chk-doc FOR ub.chk-doc.
        2   define input parameter parparentproc AS WIDGET-HANDLE no-undo.
        3   define input parameter p-mode as character no-undo .
        4   define input parameter p-rid-list as character no-undo .
        5   define input parameter p-chk-gds-rid-list  as character no-undo .
        6   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        7   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        8   define parameter buffer t-doc for ub.trn-doc.
        9   define variable vss-revision    as character no-undo init "$Revision$":u .
       10   define variable vss-author      as character no-undo init "$Author$":u .
       11   define variable vss-date        as character no-undo init "$Date$":u .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       13   define variable vss-archive     as character no-undo init "$Archive$":u .
       14   define variable vss-description as character no-undo init "Закачка чеков в документ инвентаризации и/или обсчет строк" .
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   procedure proc-alt-shift-f2:
       76     if not ibs.th.gbl.gbl-var:rcode
       77   then
       78     run gbl\inidebug.p .
       79   end.
       80   procedure proc-alt-shift-f3:
       81     run gbl/prvssinf.p
       82       ( input this-procedure
       83       ) .
       84   end.
       85   define variable v-inform-launched as logical no-undo initial false .
       86   procedure proc-alt-shift-f4:
       87     define variable v-action as character no-undo .
       88     if v-inform-launched = false then do:
       89       assign
       90         v-inform-launched = true
       91       .
       92       run gbl/d-inform.w
       93         (  input self
       94         ,  input this-procedure
       95         , output v-action
       96         ) no-error .
       97       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       98       assign
       99         v-inform-launched = false
      100       .
      101     end.
      102   end.
      103   procedure proc-alt-f1:
      104     run gbl/corrhelp.p
      105       (input this-procedure
      106       ) .
      107   end .
      108   on alt-shift-f2 anywhere do:
      109     run proc-alt-shift-f2.
      110   end.
      111   on alt-shift-f3 anywhere do:
      112     run proc-alt-shift-f3 in this-procedure .
      113   end.
      114   on alt-shift-f4 anywhere do:
      115     run proc-alt-shift-f4 in this-procedure.
      116   end.
      117   on alt-f1 anywhere do:
      118     run proc-alt-f1 in this-procedure .
      119   end.
      120   function diff-list returns character (
      121     input parfirst-list  as character,
      122     input parsecond-list as character,
      123     input pardelim       as character).
      124     if pardelim = ""
      125     or pardelim = ?
      126     then do:
      127       assign
      128         pardelim = ","
      129       .
      130     end.
      131     def var ind as integer no-undo .
      132     def var v-elem as character no-undo .
      133     def var v-result-list as character no-undo init "".
      134     def var v-num-parfirst-list as integer no-undo .
      135     assign
      136       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      137     .
      138     do ind = 1 to v-num-parfirst-list
      139     :
      140       assign
      141         v-elem = entry(ind, parfirst-list, pardelim)
      142       .
      143       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      144         assign
      145           v-result-list = v-result-list
      146                         + (if v-result-list > "" then pardelim else "")
      147                         + v-elem
      148         .
      149       end.
      150     end.
      151     return v-result-list .
      152   end function.
      153   function add-list returns character (
      154    input parfirst-list  as character,
      155    input parsecond-list as character,
      156    input pardelim       as character).
      157     if pardelim = ""
      158     or pardelim = ?
      159     then do:
      160       assign
      161         pardelim = ","
      162       .
      163     end.
      164     def var ind as integer no-undo .
      165     def var v-elem as character no-undo .
      166     def var v-result-list as character no-undo init "".
      167     def var v-num-parfirst-list as integer no-undo .
      168     assign
      169       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      170     .
      171     do ind = 1 to v-num-parfirst-list
      172     :
      173       assign
      174         v-elem = entry(ind, parfirst-list, pardelim)
      175       .
      176       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      177         assign
      178           v-result-list = v-result-list
      179                         + (if v-result-list > "" then pardelim else "")
      180                         + v-elem
      181         .
      182       end.
      183     end.
      184     def var v-num-parsecond-list as integer no-undo .
      185     assign
      186       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      187     .
      188     do ind = 1 to v-num-parsecond-list
      189     :
      190       assign
      191         v-elem = entry(ind, parsecond-list, pardelim)
      192       .
      193       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      194         assign
      195           v-result-list = v-result-list
      196                         + (if v-result-list > "" then pardelim else "")
      197                         + v-elem
      198         .
      199       end.
      200     end.
      201     return v-result-list .
      202   end function.
      203   function cross-list returns character (
      204    input parfirst-list  as character,
      205    input parsecond-list as character,
      206    input pardelim       as character).
      207     if pardelim = ""
      208     or pardelim = ?
      209     then do:
      210       assign
      211         pardelim = ","
      212       .
      213     end.
      214     def var ind as integer no-undo .
      215     def var v-elem as character no-undo .
      216     def var v-result-list as character no-undo init "".
      217     def var v-num-parfirst-list as integer no-undo .
      218     assign
      219       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      220     .
      221     do ind = 1 to v-num-parfirst-list
      222     :
      223       assign
      224         v-elem = entry(ind, parfirst-list, pardelim)
      225       .
      226       if lookup(v-elem, v-result-list, pardelim) = 0
      227       and lookup(v-elem, parsecond-list, pardelim) > 0
      228       then do:
      229         assign
      230           v-result-list = v-result-list
      231                         + (if v-result-list > "" then pardelim else "")
      232                         + v-elem
      233         .
      234       end.
      235     end.
      236     return v-result-list .
      237   end function.
      238   function radio-label returns character (
      239    input par-rs-value  as character,
      240    input par-rs-radio-buttons as character)
      241    .
      242    DEFINE variable v-result-label as character no-undo.
      243    assign
      244    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      245                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      246                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      247                             ), par-rs-radio-buttons
      248                           )
      249    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      250    .
      251   return v-result-label.
      252   end function.
      253   function m-radio-label returns character (
      254    input par-rs-value  as character,
      255    input par-rs-radio-buttons as character,
      256    input par-delim as character
      257    )
      258    .
      259    DEFINE variable v-result-label as character no-undo.
      260    assign
      261    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      262                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      263                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      264                             ), par-rs-radio-buttons, par-delim
      265                           )
      266    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      267    .
      268   return v-result-label.
      269   end function.
      270   FUNCTION mixlist returns character
      271   (
      272    input parfirst-list  as character
      273    ,input parsecond-list as character
      274    ,input pardelim       as character
      275    ,input pardelim-result as character ) :
      276     if pardelim = ""
      277     or pardelim = ?
      278     then do:
      279       assign
      280         pardelim = ","
      281       .
      282     end.
      283     def var ind as integer no-undo .
      284     def var v-elem1 as character no-undo .
      285     def var v-elem2 as character no-undo .
      286     def var v-result-list as character no-undo init "".
      287     do ind = 1 to num-entries(parfirst-list, pardelim)
      288     :
      289       assign
      290         v-elem1 = entry(ind, parfirst-list, pardelim)
      291         v-elem2 = entry(ind, parsecond-list, pardelim)
      292       .
      293         assign
      294           v-result-list = v-result-list
      295                         + (if v-result-list > "" then pardelim-result else "")
      296                         + v-elem1 + pardelim-result + v-elem2
      297         .
      298     end.
      299     return v-result-list .
      300   END FUNCTION.
      301   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
