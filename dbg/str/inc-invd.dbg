      364        LABEL "Пор. смены"
      365        VIEW-AS FILL-IN
      366        SIZE 5 BY 1
      367        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
      368   DEFINE VARIABLE time_ AS CHARACTER FORMAT "x(8)"
      369        LABEL "Время"
      370        VIEW-AS FILL-IN
      371        SIZE 10.3 BY 1
      372        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
      373   DEFINE VARIABLE RS-get-method AS CHARACTER
      374        VIEW-AS RADIO-SET VERTICAL
      375        RADIO-BUTTONS
      376             "Все свободные чеки по объекту с заданными условиями", "inc-invr",
      377   "Чеки выборочно", "chk-docs"
      378        SIZE 70.5 BY 1.77 NO-UNDO.
      379   DEFINE RECTANGLE RECT-1
      380        EDGE-PIXELS 2 GRAPHIC-EDGE
      381        SIZE 98 BY 1.87
      382        BGCOLOR 8 FGCOLOR 0 .
      383   DEFINE NEW SHARED QUERY QUERY-chk-doc FOR
      384         X_chk-doc SCROLLING.
      385   DEFINE FRAME d-chk
      386        b-exit AT ROW 1 COL 1
      387        b-quit AT ROW 1 COL 11
      388        b-help AT ROW 1 COL 81
      389        RS-get-method AT ROW 2.27 COL 7 NO-LABEL
      390        chk-amount AT ROW 4.97 COL 26 COLON-ALIGNED
      391        f-processed AT ROW 4.97 COL 51.5 COLON-ALIGNED
      392        f-processed-ok AT ROW 4.97 COL 83.5 COLON-ALIGNED
      393        E-message AT ROW 6.6 COL 1 NO-LABEL
      394        ub.chk-doc.shift-date AT ROW 9 COL 43.5 COLON-ALIGNED FORMAT "99/99/9999"
      395             VIEW-AS FILL-IN
      396             SIZE 11 BY 1
      397             BGCOLOR 8 FGCOLOR 4
      398        f-shift-name AT ROW 9 COL 65.5 COLON-ALIGNED
      399        f-shift-num AT ROW 9 COL 83 COLON-ALIGNED
      400        ub.chk-doc.chk-num AT ROW 10.2 COL 8.3 COLON-ALIGNED FORMAT "->>>>>>9"
      401             VIEW-AS FILL-IN
      402             SIZE 7.3 BY 1
      403             BGCOLOR 8 FGCOLOR 4
      404        time_ AT ROW 10.2 COL 40.5 COLON-ALIGNED
      405        ub.chk-doc.pay-desk AT ROW 11.43 COL 8.3 COLON-ALIGNED FORMAT ">>>9"
      406             VIEW-AS FILL-IN
      407             SIZE 6 BY 1
      408             BGCOLOR 8 FGCOLOR 4
      409        ub.chk-doc.cashier AT ROW 11.43 COL 22.3 COLON-ALIGNED FORMAT ">>>>9"
      410             VIEW-AS FILL-IN
      411             SIZE 6.3 BY 1
      412             BGCOLOR 8 FGCOLOR 4
      413        ub.chk-doc.doc-code AT ROW 11.43 COL 54.4 COLON-ALIGNED
      414             LABEL "Номер" FORMAT "X(20)"
      415             VIEW-AS FILL-IN
      416             SIZE 19.3 BY 1
      417             BGCOLOR 8 FGCOLOR 4
      418        RECT-1 AT ROW 4.47 COL 1
      419        SPACE(0.24) SKIP(6.57)
      420       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      421            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      422            TITLE "Заполнение и/или обсчет документа инвентаризации по чекам инвентаризации":L.
      423   ASSIGN
      424          FRAME d-chk:SCROLLABLE       = FALSE.
      425   ASSIGN
      426          E-message:READ-ONLY IN FRAME d-chk        = TRUE.
      427   ON END-ERROR OF FRAME d-chk
      428   DO:
      429       apply "choose" to b-quit .
      430   END.
      431   ON CHOOSE OF b-exit IN FRAME d-chk
      432   DO:
      433     run proc-b-run IN THIS-PROCEDURE NO-ERROR.
      434     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      435   END.
      436   ON CHOOSE OF b-quit IN FRAME d-chk
      437   DO:
      438     if p-mode = 'ДОБАВЛЕНИЕ':U
      439     then return "cancell":U .
      440     else return '':U.
      441   END.
      442   ON LEAVE OF f-shift-name IN FRAME d-chk
      443   DO:
      444     run proc-shift-name in this-procedure no-error .
      445     if error-status:error then do:
      446       return no-apply.
      447     end.
      448     display
      449     integer(f-shift-name) @ f-shift-num
      450     with frame d-chk .
      451   END.
      452   ON VALUE-CHANGED OF RS-get-method IN FRAME d-chk
      453   DO:
      454      run IncProcStart in this-procedure ( input no).
      455      ASSIGN
      456      rs-get-method.
      457      CASE rs-get-method:
      458        WHEN "chk-docs" THEN DO:
      459           ASSIGN
      460           v-rid-list = "":U.
      461           run str/chk-docs.w (
      462                            input parparentproc
      463                           ,INPUT ('b-sel,b-mark':U )
      464                           ,INPUT "to-inv"
      465                           ,INPUT ?
      466                           ,INPUT t-doc.obj-type
      467                           ,INPUT t-doc.obj-code
      468                           ,INPUT t-doc.doc-code
      469                           ,INPUT '':U
      470                           ,input 0
      471                           ,INPUT ?
      472                           ,INPUT ?
      473                           ,input 0
      474                           ,output v-rid-list) no-error.
      475            IF v-rid-list = "":U  THEN DO:
      476                ASSIGN
      477                rs-get-method = "inc-invr".
      478                DISPLAY rs-get-method
      479                with frame d-chk
      480                .
      481                RETURN NO-APPLY.
      482            END.
      483          END.
      484          WHEN "inc-invr":U THEN DO:
      485              v-rid-list = "":U.
      486         END.
      487      END CASE.
      488   END.
      489   ON RETURN OF ub.chk-doc.shift-date IN FRAME d-chk
      490   DO:
      491     apply "CHOOSE" to b-exit in frame d-chk.
      492     return no-apply.
      493   END.
      494   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-chk:PARENT eq ?
      495   THEN FRAME d-chk:PARENT = ACTIVE-WINDOW.
      496   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      497   on help of frame d-chk
      498   do:
      499     run gbl/app_help.p
      500       (input this-procedure :file-name
      501       ,input ''
      502       ,input ?
      503       ) no-error.
      504     if error-status :error then do:
      505       message
      506         "Ошибка при вызове помощи"
      507         error-status :get-message(1)
      508         view-as alert-box .
      509     end.
      510   end.
      511   run minbtn-set in this-procedure .
      512   on choose of b-help in frame d-chk
      513   do:
      514     apply "help":u to frame d-chk .
      515   end.
      516   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      517   procedure minbtn-set :
      518       do
      519           on error undo, return error return-value
      520           :
      521           define variable ii              as integer       no-undo .
      522           define variable fh              as widget-handle no-undo .
      523           define variable hh              as widget-handle no-undo .
      524           define variable v-h             as handle        extent 4 no-undo .
      525           define variable v-name-button   as character     no-undo .
      526           define variable v-help-old-x    as decimal       no-undo .
      527           define variable v-help-old-y    as decimal       no-undo .
      528           define variable v-help-old-size as decimal       no-undo .
      529           define variable v-frame-width   as decimal       no-undo .
      530           define variable jj              as integer       no-undo .
      531           do
      532               on error undo, return error
      533               :
      534               assign
      535                   v-frame-width = frame d-chk:width - 0.3
      536                   fh            = frame d-chk:first-child
      537                   hh            = fh:first-child
      538                   ii            = 1
      539                   .
      540               do while valid-handle(hh):
      541                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      542                   do:
      543                       case lc(hh:name) :
      544                           when "b-help" then
      545                               do:
      546                                   hh:load-image-up("cmp/b-help.bmp":u) .
      547                                   hh:load-image-down("cmp/b-help.bmp":u) .
      548                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      549                                   hh:TOOLTIP = "Помощь" .
      550                                   v-help-old-x = hh:column .
      551                                   v-help-old-y = hh:row    .
      552                                   v-help-old-size = hh:width .
      553                                   hh:width-chars = 2.5 .
      554                               end.
      555                           when "b-print" then
      556                               do:
      557                                   hh:load-image("cmp/b-print.bmp":u) .
      558                                   hh:TOOLTIP = "Печать" .
      559                                   v-h[ii] = hh:handle .
      560                                   ii = ii + 1 .
      561                                   hh:width-chars = 3 .
      562                               end.
      563                           when "b-history" or
      564                           when "b-hist" then
      565                               do:
      566                                   hh:load-image("cmp/b-hist.bmp":u) .
      567                                   hh:TOOLTIP = "История" .
      568                                   v-h[ii] = hh:handle .
      569                                   ii = ii + 1 .
      570                                   hh:width-chars = 3 .
      571                               end.
      572                           when "b-sch" then
      573                               do:
      574                                   hh:load-image("cmp/b-sch.bmp":u) .
      575                                   hh:TOOLTIP = "Установка Фильтра" .
      576                                   v-h[ii] = hh:handle .
      577                                   ii = ii + 1 .
      578                                   hh:width-chars = 3 .
      579                               end.
      580                           when "b-hist-user" then
      581                               do:
      582                                   hh:load-image("cmp/b-hist.bmp":u) .
      583                                   hh:TOOLTIP = "История пользователя" .
      584                                   ii = ii + 1 .
      585                               end.
      586                       end case.
      587                   end.
      588                   hh = hh:next-sibling.
      589               end.
      590               b-help:column = v-frame-width - b-help:width-chars.
      591               jj = 0.
      592               repeat ii = 4 to 1 by -1 :
      593                   if valid-handle (v-h[ii] ) then
      594                   do:
      595                       jj  = jj + 1 .
      596                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      597                       v-h[ii]:row    = v-help-old-y .
      598                   end.
      599               end.
      600           end.
      601       end.
      602   end procedure.
      603   ON WINDOW-CLOSE OF FRAME d-chk APPLY "END-ERROR":U TO SELF.
      604   MAIN-BLOCK:
      605   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      606         ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      607     if p-mode = 'ИЗМЕНЕНИЕ':U
      608     or p-mode = 'ДОБАВЛЕНИЕ':U
      609     then do:
      610   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      611   define variable v-param-type4 as character no-undo .
      612   define variable v-value-character4 as character no-undo .
      613   define variable v-value-date4 as date no-undo .
      614   define variable v-value-decimal4 as decimal no-undo .
      615   define variable v-value-integer4 as INTEGER no-undo .
      616   define variable v-tth4 as handle no-undo .
      617   run adm/shattri.p (
      618       input "get":U
      619       ,input  p-obj-type
      620       ,input  p-obj-code
      621       ,input  'get-chk':U
      622       ,input  'cas-shft':U
      623       ,output v-value-character4
      624       ,output v-value-date4
      625       ,output v-value-decimal4
      626       ,output v-value-integer4
      627       ,output cas-shft
      628       ,output v-param-type4
      629       ,INPUT-OUTPUT table-handle v-tth4
      630       )  .
      631   delete object v-tth4.
      632       .
      633   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      634   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      635     (input  p-obj-type
      636     ,input  p-obj-code
      637     ,input  'shift-on=request'
      638     ,output l-shift-on
      639     )  .
      640       if l-shift-on and not cas-shft then do:
      641         message
      642         "Внимание! На текущем объекте требуется использование смен" skip
      643         "а настройка СМЕНЫ НА КАССЕ ( cas-shft ) выключена - это недопустимо." skip (2)
      644         view-as alert-box ERROR.
      645         return ERROR.
      646       end.
      647     end.
      648     else do:
      649   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      651     (input  p-obj-type
      652     ,input  p-obj-code
      653     ,input  'shift-on=request'
      654     ,output l-shift-on
      655     )  .
      656     end.
      657     if p-mode = 'ИЗМЕНЕНИЕ':U
      658     or p-mode = 'ДОБАВЛЕНИЕ':U
      659     then do:
      660       FIND FIRST ub.shop WHERE ub.shop.obj-code = p-obj-code NO-LOCK .
      661       FIND FIRST ub.trn-doc WHERE ub.trn-doc.doc-code = t-doc.doc-code exclusive.
      662       for each buf_Chk-doc no-lock where
      663               buf_Chk-doc.out-code = t-doc.doc-code:
      664         assign
      665         chk-amount = chk-amount + 1
      666         .
      667       end.
      668     end.
      669     if p-mode = 'ПРОСМОТР':U then do:
      670       FIND FIRST shop WHERE shop.obj-code = p-obj-code NO-LOCK .
      671       FIND FIRST trn-doc no-lock WHERE trn-doc.doc-code = t-doc.doc-code.
      672     end.
      673     if l-shift-on then do:
      674       run gbl/factdate.p (
      675                          INPUT        t-doc.obj-type
      676                         ,INPUT        t-doc.obj-code
      677                         ,INPUT-OUTPUT v-chk-date
      678                         ,INPUT-OUTPUT v-chk-time
      679                         ,INPUT-OUTPUT v-shift-date
      680                         ,INPUT-OUTPUT v-shift-num
      681                         ,input-output v-shift-name
      682                         ,INPUT        YES
      683                           ) NO-ERROR.
      684       IF ERROR-STATUS:ERROR THEN DO:
      685          message
      686          error-status:get-message(1) SKIP
      687          return-value
      688          view-as alert-box error .
      689          UNDO MAIN-BLOCK, return error .
      690       END.
      691     end.
      692     else do:
      693       assign
      694       v-shift-date = t-doc.doc-date
      695       v-shift-num = 0
      696       .
      697     end.
      698     if can-find( FIRST ub.chk-doc WHERE ub.chk-doc.out-code = t-doc.doc-code ) then do:
      699       FIND FIRST ub.chk-doc WHERE ub.chk-doc.out-code = t-doc.doc-code use-index sale
      700       NO-LOCK .
      701       assign
      702       time_ = string( ub.chk-doc.chk-time, "HH:MM" )
      703       .
      704     end.
      705     run Myenable in this-procedure .
      706     if return-value = "cancell" then return "cancell".
      707     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      708       run proc-b-run in this-procedure no-error.
      709       if error-status:error then do:
      710         message
      711         substitute("Ошибка при подсчете количеств по строкам чеков инвентаризации&1&2&1&3"
      712                   , chr(10)
      713                   , error-status:error
      714                   , return-value )
      715         view-as alert-box error .
      716       end.
      717     end.
      718     else do:
      719       WAIT-FOR GO OF FRAME d-chk focus chk-doc.shift-date .
      720     end.
      721   END.
      722   run disable_UI.
      723   PROCEDURE disable_UI :
      724     HIDE FRAME d-chk.
      725   END PROCEDURE.
      726   PROCEDURE display-chk :
      727   DEFINE INPUT PARAMETER p-chk-amount AS INTEGER NO-UNDO.
      728   DISPLAY
      729   p-chk-amount @ chk-amount
      730   with frame d-chk.
      731   if available X_chk-doc then
      732   DISPLAY
      733   X_chk-doc.cashier @ ub.chk-doc.cashier
      734   X_chk-doc.shift-date @ ub.chk-doc.shift-date
      735   X_chk-doc.chk-num    @ ub.chk-doc.chk-num
      736   string( X_chk-doc.chk-time, "HH:MM" ) @ time_
      737   X_chk-doc.office  @ ub.chk-doc.office
      738   X_chk-doc.doc-code  @ ub.chk-doc.doc-code
      739   X_chk-doc.pay-desk  @ ub.chk-doc.pay-desk
      740   with frame d-chk.
      741   END PROCEDURE.
      742   PROCEDURE display-message :
      743   DEFINE INPUT PARAMETER p-message AS CHARACTER NO-UNDO.
      744   e-message:SCREEN-VALUE IN FRAME d-chk = p-message.
      745   END PROCEDURE.
      746   PROCEDURE display-processed :
      747   DEFINE INPUT PARAMETER p-processed AS INTEGER NO-UNDO.
      748   DISPLAY
      749   p-processed @ f-processed
      750   WITH FRAME d-chk.
      751   END PROCEDURE.
      752   PROCEDURE display-processed-ok :
      753   DEFINE INPUT PARAMETER p-processed-ok AS INTEGER NO-UNDO.
      754   DISPLAY
      755   p-processed-ok @ f-processed-ok
      756   WITH FRAME d-chk.
      757   END PROCEDURE.
      758   PROCEDURE Enable_UI :
      759     DISPLAY RS-get-method chk-amount f-processed f-processed-ok E-message
      760             f-shift-name f-shift-num time_
      761         WITH FRAME d-chk.
      762     IF AVAILABLE ub.chk-doc THEN
      763       DISPLAY ub.chk-doc.shift-date ub.chk-doc.chk-num ub.chk-doc.pay-desk
      764             ub.chk-doc.cashier ub.chk-doc.doc-code
      765         WITH FRAME d-chk.
      766     ENABLE b-exit RECT-1 b-quit b-help RS-get-method chk-amount f-processed
      767            f-processed-ok E-message ub.chk-doc.shift-date f-shift-name
      768            f-shift-num ub.chk-doc.chk-num time_ ub.chk-doc.pay-desk
      769            ub.chk-doc.cashier ub.chk-doc.doc-code
      770         WITH FRAME d-chk.
      771   END PROCEDURE.
      772   PROCEDURE IncProc :
      773   define input parameter p-is-all as logical no-undo .
      774   define variable v-ii     as integer no-undo .
      775   define variable v-ii-ok  as integer no-undo .
      776   define variable v-rc-ii as integer no-undo .
      777   define variable v-rc-max as integer no-undo .
      778   DEFINE VARIABLE v-query-prepare AS CHARACTER NO-UNDO.
      779   define variable v-error-status as logical no-undo .
      780   define variable v-error-status-message as character no-undo .
      781   if rs-get-method = "inc-invr":U
      782   then do:
      783     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      784       ASSIGN
      785       v-query-prepare = substitute("for each X_chk-doc no-lock where ":U +
      786                                 "X_chk-doc.obj-type = '&1'":U +
      787                                 " AND X_chk-doc.obj-code = &2":U +
      788                                 " AND X_chk-doc.out-code = ? and X_chk-doc.chk-type = &3", p-obj-type, p-obj-code, integer('11':U)).
      789       if l-shift-on then do:
      790         ASSIGN
      791         v-query-prepare = v-query-prepare +
      792                         substitute(" AND X_chk-doc.shift-date = &1 AND X_chk-doc.shift-num = &2"
      793                                   , string(v-shift-date, "99/99/9999")
      794                                   , v-shift-num).
      795       end.
      796       else do:
      797         if ub.shop.day-only then do:
      798             ASSIGN
      799             v-query-prepare = v-query-prepare +
      800                             substitute(" AND X_chk-doc.shift-date = &1", string(v-shift-date, "99/99/9999")).
      801                             .
      802         end.
      803         else do:
      804             ASSIGN
      805             v-query-prepare = v-query-prepare +
      806                             substitute(" AND X_chk-doc.shift-date <= &1", string(v-shift-date, "99/99/9999")).
      807         end.
      808       end.
      809     end.
      810     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      811       ASSIGN
      812       v-query-prepare = substitute("for each X_chk-doc no-lock where ":U +
      813                                 "X_chk-doc.out-code = '&1'":U, t-doc.doc-code  ).
      814     end.
      815     if rs-get-method = "chk-docs":U then do:
      816       assign
      817       v-query-prepare = v-query-prepare + substitute(" AND lookup(string(recid(X_chk-doc)), '&1') > 0 ", v-rid-list)
      818       .
      819     end.
      820     assign
      821     glog =
      822     QUERY query-chk-doc:QUERY-PREPARE(v-query-prepare) No-error.
      823     IF not glog
      824     THEN DO:
      825       MESSAGE
      826       error-status:get-message(1) skip
      827       VIEW-AS ALERT-BOX ERROR.
      828       UNDO, RETURN ERROR.
      829     END.
      830     assign
      831     glog = QUERY query-chk-doc:query-OPEN() NO-ERROR.
      832     IF not glog
      833     THEN DO:
      834         MESSAGE
      835         "Неверно выбран или построен ФИЛЬТР"
      836         VIEW-AS ALERT-BOX ERROR.
      837         UNDO, RETURN ERROR.
      838     END.
      839     ASSIGN
      840     glog = QUERY query-chk-doc:GET-FIRST(no-LOCK) NO-ERROR.
      841     IF not glog THEN DO:
      842       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      843         message
      844         "Нет чеков, удовлетворяющих условиям закачки в документ" skip
      845         view-as alert-box WARNING .
      846       end.
      847       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      848         message
      849         "Нет чеков, в документе" skip
      850         view-as alert-box WARNING .
      851       end.
      852       RETURN.
      853     END.
      854     ASSIGN
      855     glog = QUERY query-chk-doc:GET-FIRST(exclusive-LOCK, no-wait) NO-ERROR.
      856     do while locked (X_chk-doc ) and available X_chk-doc:
      857       glog = QUERY query-chk-doc:GET-NEXT(exclusive-LOCK, no-wait) NO-ERROR.
      858     end.
      859   end.
      860   else do:
      861     assign
      862     v-rc-max = num-entries(v-rid-list).
      863     _v-rc:
      864     do while v-rc-ii < v-rc-max:
      865       assign
      866       v-rc-ii = v-rc-ii + 1
      867       .
      868       find first X_chk-doc exclusive-lock where
      869                 recid(X_chk-doc) = integer(entry(v-rc-ii, v-rid-list))  no-wait no-error.
      870       if locked X_chk-doc or not available X_chk-doc then do:
      871         next _v-rc.
      872       end.
      873       else leave _v-rc.
      874     end.
      875     if not available X_chk-doc
      876     or locked(X_chk-doc) then do:
      877       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      878         message
      879         "Ни один из выбранных Вами чеков не может быть сейчас закачан в документ" skip
      880         "Возможно они заняты другим пользователем"
      881         view-as alert-box Warning.
      882       end.
      883       else do:
      884         message
      885         "Ни один из выбранных Вами чеков не может быть сейчас обсчитан" skip
      886         "Возможно они заняты другим пользователем"
      887         view-as alert-box Warning.
      888       end.
      889       return.
      890     end.
      891   end.
      892   run str/inc-invr.p (
      893                       input parparentproc
      894                     ,input this-procedure:handle
      895                     ,input p-is-all
      896                     ,input-output v-ii
      897                     ,input-output v-ii-ok
      898                     ,INPUT (IF rs-get-method = "chk-docs":U THEN v-rid-list ELSE "":U)
      899                     ,input p-chk-gds-rid-list
      900                     ,INPUT (IF p-mode = 'ДОБАВЛЕНИЕ':U THEN 0 ELSE 1)
      901                     ,input cas-shft
      902                     ,input chk-amount
      903                     ,input ub.shop.day-only
      904                     ,buffer t-doc
      905                     ) no-error.
      906   assign
      907   v-error-status = error-status:error
      908   v-error-status-message = error-status:get-message(1)
      909   .
      910   if v-ii-ok <> 0 then do:
      911   end.
      912   if v-ii = 0 AND p-mode = 'ДОБАВЛЕНИЕ':U then do:
      913     if v-error-status then
      914     message
      915     "Произошла ошибка при закачке чеков в инвентаризацию" skip
      916     v-error-status-message skip
      917     return-value
      918     view-as alert-box .
      919     else
      920     message
      921     "Нет чеков, удовлетворяющих условиям закачки в инвентаризацию" skip
      922     view-as alert-box WARNING .
      923   end.
      924   else do:
      925     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      926       message
      927       substitute("Просмотрено &1 чеков, успешно закачано в инвентаризацию &2", v-ii, v-ii-ok)
      928       view-as alert-box WARNING .
      929     end.
      930   end.
      931   END PROCEDURE.
      932   PROCEDURE IncProcStart :
      933   define input parameter p-run as logical no-undo .
      934   if p-mode <> 'ИЗМЕНЕНИЕ':U
      935   and p-mode <> 'ДОБАВЛЕНИЕ':U
      936   then return.
      937   define variable v-deleted as logical no-undo .
      938   define variable v-dopi as integer no-undo .
      939   define buffer buf_trn-doc for ub.trn-doc.
      940   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
      941     if ub.shop.day-only then do:
      942       if can-find( first ub.chk-doc where
      943                        ub.chk-doc.obj-type = p-obj-type
      944                    and ub.chk-doc.obj-code = p-obj-code
      945                    and ub.chk-doc.out-code = ?
      946                    and ub.chk-doc.shift-date < t-doc.doc-date
      947                    and ub.chk-doc.chk-type = integer('11':U)
      948                    ) then  do:
      949         glog = yes.
      950         message substitute("Имеются чеки инвентаризации за более раннюю дату,&1" +
      951                            "не включенные ни в один документ.&1" +
      952                            "Не забудьте создать документ инвентаризации&1" +
      953                            "и включить в него эти чеки.&1&1" +
      954                            "Продолжать ?"
      955                            ,chr(10))
      956         view-as alert-box question buttons YES-NO update glog.
      957         if NOT glog then return error .
      958       end.
      959     end.
      960     else do:
      961       if can-find( first ub.trn-doc where ub.trn-doc.obj-type = p-obj-type and
      962                                    ub.trn-doc.obj-code = p-obj-code and
      963                                    ub.trn-doc.status_ = 'факт':U and
      964                                    ub.trn-doc.doc-date > t-doc.doc-date ) then do:
      965         glog = yes.
      966         message substitute("Уже имеется инвентаризация, содержащая чеки,&1"  +
      967                            "дата которых БОЛЬШЕ указанной Вами.&1"  +
      968                            "Вы уверены, что в базе появились новые чеки инвентаризации?&1"
      969                           , chr(10))
      970           view-as alert-box question buttons YES-NO update glog.
      971         if NOT glog then  return error .
      972       end.
      973     end.
      974   END.
      975   if p-run then
      976   run IncProc in this-procedure ( input is-all).
      977   END PROCEDURE.
      978   PROCEDURE MyEnable :
      979   ASSIGN
      980   rs-get-method = "inc-invr".
      981   view frame d-chk .
      982   DISPLAY
      983   f-shift-num
      984   f-shift-name
      985   chk-amount
      986   time_
      987   rs-get-method
      988   WITH FRAME d-chk .
      989   IF AVAILABLE ub.chk-doc and p-mode <> 'ПРОСМОТР':U THEN
      990   DISPLAY
      991   ub.chk-doc.shift-date
      992   ub.chk-doc.pay-desk
      993   ub.chk-doc.cashier
      994   ub.chk-doc.chk-num
      995   ub.chk-doc.doc-code
      996   WITH FRAME d-chk.
      997   if p-mode <> 'ИЗМЕНЕНИЕ':U
      998   and p-mode <> 'ДОБАВЛЕНИЕ':U
      999   then do:
     1000     assign
     1001     b-quit:label = "&Выход"
     1002     b-quit:column = 1
     1003     .
     1004   end.
     1005   ENABLE
     1006   RECT-1
     1007   b-help
     1008   b-exit when (p-mode= 'ИЗМЕНЕНИЕ':U or p-mode = 'ДОБАВЛЕНИЕ':U)
     1009   b-quit
     1010   rs-get-method when p-mode = 'ДОБАВЛЕНИЕ':U
     1011   WITH FRAME d-chk .
     1012   if p-mode <> 'ИЗМЕНЕНИЕ':U
     1013   and p-mode <> 'ДОБАВЛЕНИЕ':U
     1014   then do:
     1015     hide
     1016     b-exit in frame d-chk .
     1017   end.
     1018   assign
     1019   f-shift-num = if cas-shft or p-mode = 'ПРОСМОТР':U then v-shift-num else 0
     1020   f-shift-name = if cas-shft or p-mode = 'ПРОСМОТР':U then v-shift-name else '':U
     1021   .
     1022   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1023   end.
     1024   DISPLAY
     1025   f-shift-num when (cas-shft or (p-mode = 'ПРОСМОТР':U and v-shift-num <> 0))
     1026   f-shift-name when (cas-shft or (p-mode = 'ПРОСМОТР':U and v-shift-name <> '':U))
     1027   v-shift-date @ chk-doc.shift-date
     1028   with frame d-chk.
     1029   DISABLE
     1030   chk-amount
     1031   WITH frame d-chk.
     1032   if p-mode = 'ИЗМЕНЕНИЕ':U
     1033   or p-mode = 'ДОБАВЛЕНИЕ':U
     1034   then do:
     1035     DISABLE
     1036     chk-doc.cashier
     1037     chk-doc.chk-num
     1038     chk-doc.doc-code
     1039     time_
     1040     chk-doc.pay-desk
     1041     WITH frame d-chk.
     1042     if not cas-shft then
     1043     HIDE
     1044     f-shift-num
     1045     f-shift-name
     1046     in frame d-chk.
     1047   end.
     1048   else do:
     1049     HIDE
     1050     rs-get-method
     1051     chk-doc.cashier
     1052     chk-doc.chk-num
     1053     chk-doc.doc-code
     1054     time_
     1055     chk-doc.pay-desk
     1056     in frame d-chk.
     1057   end.
     1058   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1059     if p-rid-list <> '':U then do:
     1060       v-rid-list = p-rid-list.
     1061       assign
     1062       rs-get-method = "chk-docs":U.
     1063     end.
     1064     else do:
     1065       assign
     1066       rs-get-method = "inc-invr":U.
     1067     end.
     1068     DISABLE
     1069     rs-get-method
     1070     b-exit b-quit
     1071     WITH FRAME d-chk.
     1072     HIDE
     1073     b-exit b-quit
     1074     rs-get-method
     1075     IN FRAME d-chk.
     1076   end.
     1077   END PROCEDURE.
     1078   PROCEDURE proc-b-run :
     1079   define variable v-num as integer no-undo .
     1080    if t-doc.status_ = 'разрешен':U then do:
     1081     DO  on ERROR
     1082     undo, return no-apply
     1083     on STOP undo, return no-apply  :
     1084         run gbl/d-askw.w (
     1085            input "Вопрос"
     1086           ,input "Выберите режим работы для обработки чеков." + chr(10)
     1087           ,input "|^"
     1088           ,input "Переписать|Прибавить|Спрашивать|Отмена"
     1089           ,input "Переписать количество из чеков для всех товаров|"
     1090               + "Прибавить количество из чеков для всех товаров|"
     1091               + "Cпрашивать для каждого товара|"
     1092               + "Отменить"
     1093           ,input 1
     1094           ,input 4
     1095         ,output v-num
     1096         ).
     1097         case v-num :
     1098           when 1 then do:
     1099             assign is-all = yes.
     1100           end.
     1101           when 2 then do:
     1102             assign is-all = no.
     1103           end.
     1104           when 3 then do:
     1105             assign is-all = ?.
     1106           end.
     1107           otherwise do:
     1108             if p-mode = 'ИЗМЕНЕНИЕ':U then return "cancell".
     1109             return.
     1110           end.
     1111         end case.
     1112       END.
     1113     end.
     1114     run IncProcStart IN THIS-PROCEDURE ( input yes) .
     1115   END PROCEDURE.
     1116   PROCEDURE proc-shift-name :
     1117   define variable v-dopi as integer no-undo .
     1118   assign
     1119   v-dopi = integer(f-shift-name:screen-value in frame d-chk )
     1120   no-error .
     1121   if error-status:error
     1122   or v-dopi <= 0
     1123   or v-dopi > 99 then do:
     1124     message "Неверный номер смены!" view-as alert-box ERROR.
     1125     return no-apply.
     1126   end.
     1127   END PROCEDURE.
