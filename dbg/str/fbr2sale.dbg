      769                       undo, return error substitute("Неправильные цены резервирования:&1&2&3&1БАЗ.ВАЛ.:&4&1Артикул:&5"
      770                                                     ,chr(10)
      771                                                     ,"РУБЛИ:   "
      772                                                     ,v-cost-rubl
      773                                                     ,v-cost-base
      774                                                     ,buf_doc-line.artic).
      775                       .
      776                   end.
      777                   assign
      778                       v-sum-parts-rsrv-qnty = v-sum-parts-rsrv-qnty + v-parts-rsrv-qnty
      779                       p-rsrv-qnty           = p-rsrv-qnty           - v-parts-rsrv-qnty
      780                   .
      781               end.
      782           end.
      783           if p-rsrv-qnty > 0
