      440   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      441   function octal-to-char return character
      442   ( p-string as character ) :
      443     def var v-asc     as integer no-undo .
      444     def var v-new-asc as integer no-undo .
      445     def var ind       as integer no-undo .
      446     if length(p-string) <> 3 then do:
      447       return ? .
      448     end.
      449     assign
      450       v-asc = 0
      451     .
      452     do ind = 1 to length(p-string)
      453     :
      454       assign
      455         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      456       .
      457       if v-new-asc < 0 or v-new-asc >= 8 then do:
      458         return ? .
      459       end.
      460       assign
      461         v-asc = v-asc * 8 + v-new-asc
      462       .
      463     end.
      464     return chr(v-asc) .
      465   end function .
      466   function char-to-octal return character
      467   ( p-chr as character ) :
      468     def var v-asc    as integer   no-undo .
      469     def var ind      as integer   no-undo .
      470     def var v-string as character no-undo .
      471     if length(p-chr) <> 1 then do:
      472       return ? .
      473     end.
      474     assign
      475       v-asc    = asc(p-chr)
      476       v-string = ""
      477     .
      478     do ind = 1 to 3
      479     :
      480       assign
      481         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      482       .
      483       assign
      484         v-asc = truncate(v-asc / 8, 0)
      485       .
      486     end.
      487     return v-string .
      488   end.
      489   function str-encode return character
      490   (   p-init-string       as character
      491     , p-encode-char       as character
      492     , p-special-char-list as character
      493   ) :
      494     def var p-encode-string as character no-undo .
      495     def var ind                as integer no-undo .
      496     def var v-num-special-char as integer no-undo .
      497     def var v-special-char     as character no-undo .
      498     if p-encode-char = ?
      499     or p-encode-char = "" then do:
      500       assign
      501         p-encode-char = "~~"
      502       .
      503     end.
      504     if p-init-string = ? then do:
      505       return "?" .
      506     end.
      507     if p-init-string = "?" then do:
      508       return p-encode-char + char-to-octal("?") .
      509     end.
      510     assign
      511       v-num-special-char = length(p-special-char-list)
      512       p-encode-string    = replace(p-init-string
      513                                   ,p-encode-char
      514                                   ,p-encode-char + char-to-octal(p-encode-char)
      515                                   )
      516     .
      517     do ind = 1 to v-num-special-char
      518     :
      519       assign
      520         v-special-char = substring(p-special-char-list, ind, 1)
      521       .
      522       if v-special-char <> p-encode-char then do:
      523         assign
      524           p-encode-string = replace (p-encode-string
      525                                     ,v-special-char
      526                                     ,p-encode-char + char-to-octal(v-special-char)
      527                                     )
      528         .
      529       end.
      530     end.
      531     return p-encode-string .
      532   end.
      533   function str-decode returns character
      534     (p-init-string   as character
      535     ,p-encode-char   as character
      536     ) :
      537     def var p-decode-string as character no-undo .
      538     def var ind                       as integer no-undo .
      539     def var v-num-entries-init-string as integer no-undo .
      540     def var v-sub-phrase              as character no-undo .
      541     def var v-special-char            as character no-undo .
      542     if p-encode-char = ?
      543     or p-encode-char = "" then do:
      544       assign
      545         p-encode-char = "~~"
      546       .
      547     end.
      548     if p-init-string = "?" then do:
      549       return ? .
      550     end.
      551     assign
      552       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      553     .
      554     if v-num-entries-init-string > 1 then do:
      555       assign
      556         p-decode-string = entry(1, p-init-string, p-encode-char)
      557       .
      558       do ind = 2 to v-num-entries-init-string
      559       :
      560         assign
      561           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      562         .
      563         assign
      564           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      565         .
      566         if v-special-char <> ? then do:
      567           assign
      568             p-decode-string = p-decode-string
      569                             + v-special-char
      570                             + substring(v-sub-phrase, 4)
      571           .
      572         end.
      573         else do:
      574           assign
      575             p-decode-string = p-decode-string
      576                             + p-encode-char
      577                             + v-sub-phrase
      578           .
      579         end.
      580       end.
      581     end.
      582     else do:
      583       assign
      584         p-decode-string = p-init-string
      585       .
      586     end.
      587     return p-decode-string .
      588   end.
