      805                                                 ,chr(10)
      806                                                 ,"РУБЛИ:   "
      807                                                 ,v-cost-rubl
      808                                                 ,v-cost-base
      809                                                 ,buf_doc-line.artic).
      810               end.
      811           end.
      812           assign
      813               p-rsrv-qnty = p-rsrv-qnty + v-sum-parts-rsrv-qnty
      814           .
      815       end.
      816       else do:
      817           run trg/rsrv-dtl.p (
      818                 input p-parent-proc
      819               , input 'reserv':U
      820                       + ",":U + 'no-message':U
      821                       + ",":U + 'negative-check':U + '=':U + '1':U
      822               , buffer buf_gds-dtl
