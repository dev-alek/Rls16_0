      718           buf_gds-dtl.ov  = yes
      719           v-cost-base     = buf_doc-line.price-base
      720           v-cost-rubl     = buf_doc-line.price-rubl
      721           p-rsrv-qnty     = round( p-required-qnty, 3 )
      722       .
      723       if p-rsrv-by-parts = yes
      724       then do:
      725           assign
      726               v-parts-found           = no
      727               v-sum-parts-rsrv-qnty   = 0
      728           .
      729           if p-income-trn-doc-code <> ""
      730           then do:
      731               for each buf_parts no-lock
      732                  where buf_parts.obj-type  = buf_doc-line.obj-type
      733                    and buf_parts.obj-code  = buf_doc-line.obj-code
      734                    and buf_parts.prod-type = buf_doc-line.prod-type
      735                    and buf_parts.prod-code = buf_doc-line.prod-code
      736                    and buf_parts.artic     = buf_doc-line.artic
      737                    and buf_parts.in-code   = p-income-trn-doc-code
      738                    and buf_parts.out-code  = p-income-trn-doc-code
      739               on error undo, return error return-value
