     1761   ,input no
     1762   ,input 'без':U
     1763   ,input 'накл':U
     1764   ,input 'в т. ч.':U
     1765   ,input 'ev':U
     1766   ,input 1
     1767   ) no-error
     1768   .
     1769       if error-status:error
