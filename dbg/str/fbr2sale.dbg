     1811                    trim(error-status :get-message(3))
     1812           view-as alert-box warning.
     1813       end.
     1814       define variable v-need-moving    as logical      no-undo.
     1815       assign
     1816           v-need-moving = no
     1817       .
     1818       create-lines:
     1819       for each buf_sale-doc where
     1820                buf_sale-doc.inkas-code = p-sale-doc-code
     1821            and buf_sale-doc.fbrsale = yes,
     1822           each buf_doc-fbr-gds no-lock
     1823          where buf_doc-fbr-gds.obj-type     = p-res-type
     1824            and buf_doc-fbr-gds.obj-code     = p-res-code
     1825            and buf_doc-fbr-gds.fbr-obj-type = p-kitchen-type
     1826            and buf_doc-fbr-gds.fbr-obj-code = p-kitchen-code
     1827            and buf_doc-fbr-gds.out-code     = buf_sale-doc.doc-code
     1828       on error undo, return error
     1829       :
     1830           if p-kitchen-rest = yes
     1831           then do:
     1832               run fbrrest-get-free-qnty in this-procedure (
     1833                     input p-res-type
     1834                   , input p-res-code
     1835                   , input buf_doc-fbr-gds.gds-code
     1836                   , input no
     1837                   , output v-restaurant-free-qnty
     1838               ).
     1839           end.
     1840           else do:
     1841               assign
     1842                   v-restaurant-free-qnty  = 0
     1843               .
     1844           end.
     1845           assign
     1846               v-need-qnty = buf_doc-fbr-gds.fact-qnty - v-restaurant-free-qnty
     1847           .
     1848           if v-need-qnty <= 0
     1849           then do:
     1850               undo create-lines, next create-lines.
     1851           end.
     1852           find first buf_goods no-lock
     1853                where buf_goods.gds-code = buf_doc-fbr-gds.gds-code
     1854           .
     1855   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1856   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1857     (input  buf_goods.artic
     1858     ,input  buf_goods.prod-type
     1859     ,input  buf_goods.prod-code
     1860     ,input  'gds-goods=request':u
     1861     ,output v-goods-is-not-office
     1862     )  .
     1863           if v-goods-is-not-office = yes
     1864           then do:
     1865               run create-doc-line in this-procedure (
     1866                     input buf_trn-doc.doc-code
     1867                   , input buf_doc-fbr-gds.gds-code
     1868                   , input v-need-qnty
     1869                   , output v-sum-base
     1870                   , output v-sum-rubl
     1871                   , output v-sum-vat-base
     1872                   , output v-sum-vat-rubl
     1873               ).
     1874               if v-sum-base       = ?
     1875               or v-sum-rubl       = ?
     1876               or v-sum-vat-base   = ?
     1877               or v-sum-vat-rubl   = ?
     1878               or v-sum-base       = 0
     1879               or v-sum-rubl       = 0
     1880               then do:
     1881                   message
     1882                       skip "Не удалось определить учетную цену"
     1883                       skip "товара на объекте."
     1884                       skip (1)
     1885                       skip "Товар: " buf_goods.artic buf_goods.gds-name
     1886                       skip "Объект (кухня): " buf_trn-doc.obj-type buf_trn-doc.obj-code
     1887                       skip "Сумма в руб"    v-sum-rubl
     1888                       skip "Сумма НДС"       v-sum-vat-rubl
     1889                   view-as alert-box error.
     1890                   undo, return error .
     1891               end.
     1892               assign
     1893                   v-need-moving = yes
     1894               .
     1895           end.
     1896       end.
     1897       if v-need-moving = no
     1898       then do:
     1899           delete buf_trn-doc.
     1900       end.
     1901       else do:
     1902           define variable v-was-gds-moving    as logical        no-undo.
     1903           run str/trn-stat.p  (
     1904                 input parparentproc
     1905               , input this-procedure
     1906               , input '<закрытие документа>':U
     1907               , input buf_trn-doc.doc-code
     1908               , input no
     1909               , input v-cntxt-db-num
     1910               , input no
     1911               , input 0
     1912               , input 0
     1913               , input ""
     1914               , input yes
     1915               , output v-was-gds-moving
     1916               , output table temp_gds-list
     1917           ) no-error.
     1918           if error-status :error
     1919           then do:
     1920               message
     1921                       vss-workfile vss-revision vss-description
     1922                   skip "Ошибка при закрытии документа внутреннего перемещения."
     1923                   skip(1)
     1924                   skip "Объект:" buf_trn-doc.obj-type buf_trn-doc.obj-code
     1925                   skip "Документ номер:" buf_trn-doc.doc-code
     1926                   skip return-value
     1927                   skip trim(error-status :get-message(1))
     1928                       trim(error-status :get-message(2))
     1929                       trim(error-status :get-message(3))
     1930               view-as alert-box error.
     1931               undo, return error .
     1932           end.
     1933           run str/trn-stat.p  (
     1934               input parparentproc
     1935               , input this-procedure
     1936               , input '<закрытие документа>':U
     1937               , input buf_trn-doc.doc-code
     1938               , input no
     1939               , input v-cntxt-db-num
     1940               , input no
     1941               , input 0
     1942               , input 0
     1943               , input ""
     1944               , input yes
     1945               , output v-was-gds-moving
     1946               , output table temp_gds-list
     1947           ) no-error.
     1948           if error-status :error
     1949           then do:
     1950               message
     1951                       vss-workfile vss-revision vss-description
     1952                   skip "Ошибка при закрытии документа внутреннего перемещения."
     1953                   skip(1)
     1954                   skip "Объект:" buf_trn-doc.obj-type buf_trn-doc.obj-code
     1955                   skip "Документ номер:" buf_trn-doc.doc-code
     1956                   skip return-value
     1957                   skip trim(error-status :get-message(1))
     1958                       trim(error-status :get-message(2))
     1959                       trim(error-status :get-message(3))
     1960               view-as alert-box error.
     1961               undo, return error .
     1962           end.
     1963           run str/trn-stat.p  (
     1964               input parparentproc
     1965               , input this-procedure
     1966               , input '<закрытие документа>':U
     1967               , input buf_trn-doc.doc-code
     1968               , input no
     1969               , input v-cntxt-db-num
     1970               , input no
     1971               , input 0
     1972               , input 0
     1973               , input ""
     1974               , input yes
     1975               , output v-was-gds-moving
     1976               , output table temp_gds-list
     1977           ) no-error.
     1978           if error-status :error
     1979           then do:
     1980               message
     1981                       vss-workfile vss-revision vss-description
     1982                   skip "Ошибка при закрытии документа внутреннего перемещения."
     1983                   skip(1)
     1984                   skip "Объект:" buf_trn-doc.obj-type buf_trn-doc.obj-code
     1985                   skip "Документ номер:" buf_trn-doc.doc-code
     1986                   skip return-value
     1987                   skip trim(error-status :get-message(1))
     1988                       trim(error-status :get-message(2))
     1989                       trim(error-status :get-message(3))
     1990               view-as alert-box error.
     1991               undo, return error .
     1992           end.
     1993           assign
     1994               v-trn-doc-code = buf_trn-doc.doc-code
     1995               v-trn-doc-boss = buf_trn-doc.boss
     1996               v-trn-doc-agnt = buf_trn-doc.agnt
     1997               v-trn-doc-wrkr = buf_trn-doc.wrkr
     1998           .
     1999           release buf_trn-doc.
     2000           find first buf_income_trn-doc no-lock
     2001               where buf_income_trn-doc.out-code = v-trn-doc-code
     2002           .
     2003           run str/trn-stat.p  (
     2004               input parparentproc
     2005               , input this-procedure
     2006               , input '<закрытие документа>':U
     2007               , input buf_income_trn-doc.doc-code
     2008               , input no
     2009               , input v-cntxt-db-num
     2010               , input no
     2011               , input 0
     2012               , input 0
     2013               , input ""
     2014               , input yes
     2015               , output v-was-gds-moving
     2016               , output table temp_gds-list
     2017           ) no-error.
     2018           if error-status :error
     2019           then do:
     2020               message
     2021                       vss-workfile vss-revision vss-description
     2022                   skip "Ошибка при закрытии документа внутреннего перемещения."
     2023                   skip(1)
     2024                   skip "Объект:" buf_income_trn-doc.obj-type buf_income_trn-doc.obj-code
     2025                   skip "Документ номер:" buf_income_trn-doc.doc-code
     2026                   skip return-value
     2027                   skip trim(error-status :get-message(1))
     2028                       trim(error-status :get-message(2))
     2029                       trim(error-status :get-message(3))
     2030               view-as alert-box error.
     2031               undo, return error .
     2032           end.
     2033           find first buf_income_trn-doc exclusive-lock
     2034                where buf_income_trn-doc.out-code = v-trn-doc-code
     2035           .
     2036           assign
     2037               buf_income_trn-doc.boss = v-trn-doc-boss
     2038               buf_income_trn-doc.agnt = v-trn-doc-agnt
     2039               buf_income_trn-doc.wrkr = v-trn-doc-wrkr
     2040           .
     2041       end.
     2042   end.
     2043   procedure create-doc-line :
     2044   do
     2045   on error undo, return error
     2046   :
     2047   define input parameter p-doc-code       as character    no-undo.
     2048   define input parameter p-gds-code       as integer      no-undo.
     2049   define input parameter p-qnty           as decimal      no-undo.
     2050   define output parameter p-sum-base      as decimal      no-undo .
     2051   define output parameter p-sum-rubl      as decimal      no-undo .
     2052   define output parameter p-sum-vat-base  as decimal      no-undo .
     2053   define output parameter p-sum-vat-rubl  as decimal      no-undo .
     2054       define variable v-required-qnty     as decimal        no-undo.
     2055       define variable v-reserved-qnty     as decimal        no-undo.
     2056       define variable v-today             as date           no-undo.
     2057       define variable v-time              as integer        no-undo.
     2058       define variable v-sum-base          as decimal        no-undo.
     2059       define variable v-sum-rubl          as decimal        no-undo.
     2060       define variable v-vat-base          as decimal        no-undo.
     2061       define variable v-vat-rubl          as decimal        no-undo.
     2062       define variable v-vat-pc            as decimal        no-undo.
     2063       define variable v-host-code         as integer        no-undo.
     2064       define buffer buf_trn-doc       for trn-doc.
     2065       define buffer buf_doc-line      for doc-line.
     2066       define buffer buf_goods         for goods.
     2067       define buffer buf_gds-dtl       for gds-dtl.
     2068       define buffer buf_gds-prt       for gds-prt.
     2069       find first buf_trn-doc no-lock
     2070            where buf_trn-doc.doc-code = p-doc-code
     2071       .
     2072       find first buf_goods no-lock
     2073            where buf_goods.gds-code = p-gds-code
     2074       .
     2075       create buf_doc-line.
     2076       assign
     2077           buf_doc-line.artic         = buf_goods.artic
     2078           buf_doc-line.prod-type     = buf_goods.prod-type
     2079           buf_doc-line.prod-code     = buf_goods.prod-code
     2080           buf_doc-line.obj-type      = buf_trn-doc.obj-type
     2081           buf_doc-line.obj-code      = buf_trn-doc.obj-code
     2082           buf_doc-line.doc-code      = buf_trn-doc.doc-code
     2083           buf_doc-line.prt-ok        = yes
     2084           buf_doc-line.prt-root      = buf_goods.prt-root
     2085           buf_doc-line.status_       = buf_trn-doc.status_
     2086           buf_doc-line.doc-qnty      = 0
     2087           buf_doc-line.cli-base-rate = 1
     2088           v-required-qnty            = round( p-qnty, 3 )
     2089           v-reserved-qnty            = 0
     2090       .
     2091       run fbrrsrv-rsrv-goods in this-procedure (
     2092             input parparentproc
     2093           , input recid( buf_goods )
     2094           , input recid( buf_doc-line )
     2095           , input v-required-qnty
     2096           , input no
     2097           , input 0
     2098           , input yes
     2099           , input p-income-trn-doc-code
     2100           , output v-reserved-qnty
     2101       ) no-error.
     2102       if error-status :error
     2103       then do:
     2104           if error-status :get-message(1) <> ""
     2105           or return-value <> "user-interrupt":U
     2106           then do:
     2107               message
     2108               vss-workfile vss-revision vss-description
     2109               skip "Ошибка резервирования товара."
     2110               skip return-value
     2111               skip trim(error-status :get-message(1))
     2112                   trim(error-status :get-message(2))
     2113                   trim(error-status :get-message(3))
     2114               view-as alert-box error.
     2115           end.
     2116           undo, return error return-value.
     2117       end.
     2118       if v-required-qnty <> v-reserved-qnty
     2119       then do:
     2120           message
     2121           "Невозможно зарезервировать товар."
     2122           skip(1)
     2123           skip "Товар:" buf_goods.artic buf_goods.gds-name
     2124           skip "Объект:" buf_trn-doc.obj-type buf_trn-doc.obj-code
     2125           skip "Количество:" v-required-qnty
     2126           skip "Доступно количество:" v-reserved-qnty
     2127           view-as alert-box error.
     2128           undo, return error .
     2129       end.
     2130       run str/fbrcost.p (
     2131             input recid( buf_doc-line )
     2132           , input -1
     2133           , input v-required-qnty
     2134           , output v-sum-base
     2135           , output v-sum-rubl
     2136           , output v-vat-base
     2137           , output v-vat-rubl
     2138           , output v-vat-pc
     2139         ) .
     2140       run cur-time in this-procedure (
     2141             output v-today
     2142           , output v-time
     2143       ).
     2144   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2145   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2146     (input  buf_trn-doc.obj-type
     2147     ,input  buf_trn-doc.obj-code
     2148     ,output v-host-code
     2149     )  .
     2150   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2151   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2152     (input  buf_goods.gds-code
     2153     ,input  '1':U
     2154     ,input  ?
     2155     ,input  v-host-code
     2156     ,input  buf_trn-doc.obj-type
     2157     ,input  buf_trn-doc.obj-code
     2158     ,output v-vat-pc
     2159     )  .
     2160       find first buf_gds-prt no-lock
     2161            where buf_gds-prt.upper-code = buf_goods.prt-root
     2162       .
     2163       find first buf_gds-dtl exclusive-lock
     2164            where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
     2165              and buf_gds-dtl.artic     = buf_goods.artic
     2166              and buf_gds-dtl.prod-type = buf_goods.prod-type
     2167              and buf_gds-dtl.prod-code = buf_goods.prod-code
     2168              and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
     2169       .
     2170       assign
     2171           buf_doc-line.doc-qnty   = v-reserved-qnty
     2172           buf_doc-line.fact-qnty  = v-reserved-qnty
     2173           buf_gds-dtl.doc-qnty    = v-reserved-qnty
     2174           buf_gds-dtl.fact-qnty   = v-reserved-qnty
     2175           p-sum-base              = v-sum-base - v-vat-base
     2176           p-sum-rubl              = v-sum-rubl - v-vat-rubl
     2177           p-sum-vat-base          = v-vat-base
     2178           p-sum-vat-rubl          = v-vat-rubl
     2179       .
     2180       assign
     2181           buf_doc-line.price-cli  = v-sum-rubl / v-reserved-qnty
     2182           buf_doc-line.price-base = v-sum-base / v-reserved-qnty
     2183           buf_doc-line.price-rubl = v-sum-rubl / v-reserved-qnty
     2184           buf_doc-line.VAT-pc     = v-vat-pc
     2185       .
     2186   end.
     2187   end procedure.
