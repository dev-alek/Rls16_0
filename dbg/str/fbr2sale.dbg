      845   end procedure.
      846   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      847   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      848   procedure partslib-clear-temp-parts :
      849     define buffer buf_temp-parts for temp-parts .
      850     do
      851     on error undo, return error
      852     :
      853       for each buf_temp-parts
      854       on error undo, return error
      855       :
      856         delete buf_temp-parts .
      857       end.
      858     end.
      859   end procedure.
      860   procedure partslib-create-temp-parts :
      861     define parameter buffer buf_parts       for ub.parts .
      862     define parameter buffer buf_temp-parts  for temp-parts .
      863     define input  parameter p-goods-twounit as logical   no-undo .
      864     define variable v-base-part-code as character no-undo .
      865     do
      866     on error undo, return error
      867     :
      868       if p-goods-twounit = true
      869       then do:
      870         assign
      871           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      872         .
      873       end.
      874       else do:
      875         assign
      876           v-base-part-code = buf_parts.part-code
      877         .
      878       end.
      879       find first buf_temp-parts exclusive-lock
      880         where buf_temp-parts.obj-type  = buf_parts.obj-type
      881           and buf_temp-parts.obj-code  = buf_parts.obj-code
      882           and buf_temp-parts.artic     = buf_parts.artic
      883           and buf_temp-parts.prod-type = buf_parts.prod-type
      884           and buf_temp-parts.prod-code = buf_parts.prod-code
      885           and buf_temp-parts.in-code   = buf_parts.in-code
      886           and buf_temp-parts.out-code  = 'free-zone':U
      887           and buf_temp-parts.part-code = v-base-part-code
      888         no-error.
      889       if not available buf_temp-parts
      890       then do:
      891         create buf_temp-parts .
      892         buffer-copy buf_parts to buf_temp-parts
      893         assign
      894           buf_temp-parts.out-code  = 'free-zone':U
      895           buf_temp-parts.part-code = v-base-part-code
      896           buf_temp-parts.rsrv-free = yes
      897           buf_temp-parts.status_   = no
      898           buf_temp-parts.qnty      = 0
      899           buf_temp-parts.fact-qnty = 0
      900           buf_temp-parts.real-qnty = 0
      901           buf_temp-parts.cli-qnty  = 0
      902         .
      903       end.
      904     end.
      905   end procedure.
      906   procedure partslib-init-temp-parts :
      907     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      908     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      909     define input parameter p-artic           like ub.parts.artic     no-undo .
      910     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      911     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      912     define buffer buf_parts      for ub.parts .
      913     define buffer buf_temp-parts for temp-parts .
      914     define variable v-goods-twounit    as logical   no-undo .
      915     do
      916     on error undo, return error
      917     :
      918   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      919   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      920     (input  p-artic
      921     ,input  p-prod-type
      922     ,input  p-prod-code
      923     ,input  'twounit=request':u
      924     ,output v-goods-twounit
      925     ) no-error .
      926       if error-status :error
      927       then do:
      928         message
      929           vss-workfile vss-revision vss-description skip
      930           vss-include-info8 skip
      931           "Ошибка при определении атрибута товара" skip
      932           "Артикул" p-artic p-prod-type p-prod-code skip
      933           "twounit=request" skip
      934           error-status :get-message(1) skip
      935           return-value skip
      936           view-as alert-box error .
      937         undo, return error return-value .
      938       end.
      939       run partslib-clear-temp-parts in this-procedure .
      940       for each buf_parts
      941         where buf_parts.obj-type  = p-obj-type
      942           and buf_parts.obj-code  = p-obj-code
      943           and buf_parts.artic     = p-artic
      944           and buf_parts.prod-type = p-prod-type
      945           and buf_parts.prod-code = p-prod-code
      946           and buf_parts.rsrv-free = yes
      947           and buf_parts.status_   = no
      948           and buf_parts.in-code   <> buf_parts.out-code
      949       on error undo, return error
      950       :
      951         run partslib-create-temp-parts in this-procedure
      952           (buffer buf_parts
      953           ,buffer buf_temp-parts
      954           ,input  v-goods-twounit
      955           ) .
      956         define variable v-parts-qnty          as decimal   no-undo .
      957         define variable v-parts-cli-qnty      as decimal   no-undo .
      958         define variable v-parts-free-qnty     as decimal   no-undo .
      959         define variable v-parts-free-cli-qnty as decimal   no-undo .
      960         if buf_parts.out-code = 'free-zone':U
      961         then do:
      962           assign
      963             v-parts-qnty          = buf_parts.qnty
      964             v-parts-cli-qnty      = buf_parts.cli-qnty
      965             v-parts-free-qnty     = buf_parts.qnty
      966             v-parts-free-cli-qnty = buf_parts.cli-qnty
      967           .
      968         end.
      969         else do:
      970           assign
      971             v-parts-qnty          = abs(buf_parts.qnty)
      972             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      973             v-parts-free-qnty     = 0
      974             v-parts-free-cli-qnty = 0
      975           .
      976         end.
      977         assign
      978           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      979           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      980           buf_temp-parts.real-qnty     = 0
      981           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      982           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      983           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      984         .
      985       end.
      986     end.
      987   end procedure.
      988   procedure partslib-init-temp-parts-by-factord :
      989     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      990     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      991     define input parameter p-artic              like ub.parts.artic     no-undo .
      992     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      993     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      994     define input parameter p-fact-order         as decimal   no-undo .
      995     define input parameter p-include-fact-order as logical   no-undo .
      996     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      997     define buffer buf_gds-obj  for ub.gds-obj .
      998     do
      999     on error undo, return error
     1000     :
     1001       do transaction
     1002       on error undo, return error
     1003       :
     1004   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1005   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1006     (input  p-obj-type
     1007     ,input  p-obj-code
     1008     ,input  p-artic
     1009     ,input  p-prod-type
     1010     ,input  p-prod-code
     1011     ,buffer buf_gds-obj
     1012     ) no-error .
     1013         if error-status :error
     1014         then do:
     1015           message
     1016             vss-workfile vss-revision vss-description skip
     1017             vss-include-info8 skip
     1018             "Невозможно найти товар на объекте" skip
     1019             "Объект" p-obj-type p-obj-code skip
     1020             "Артикул" p-artic p-prod-type p-prod-code skip
     1021             error-status :get-message(1) skip
     1022             return-value skip
     1023             view-as alert-box error .
     1024           undo, return error .
     1025         end.
     1026         find current buf_gds-obj exclusive-lock .
     1027       end.
     1028       run partslib-init-temp-parts in this-procedure
     1029         (input p-obj-type
     1030         ,input p-obj-code
     1031         ,input p-artic
     1032         ,input p-prod-type
     1033         ,input p-prod-code
     1034         ) no-error .
     1035       if error-status :error
     1036       then do:
     1037         message
     1038           vss-workfile vss-revision vss-description skip
     1039           vss-include-info8 skip
     1040           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1041           "Объект" p-obj-type p-obj-code skip
     1042           "Артикул" p-artic p-prod-type p-prod-code skip
     1043           "p-fact-order" p-fact-order skip
     1044           view-as alert-box error .
     1045         undo, return error .
     1046       end.
     1047       if p-include-fact-order = true
     1048       then do:
     1049         assign
     1050           p-fact-order = p-fact-order - 0.0000000001
     1051         .
     1052       end.
     1053       define variable v-max-fact-order as character no-undo .
     1054       run factord-max-fact-order in this-procedure
     1055         (output v-max-fact-order
     1056         ) no-error .
     1057       if error-status :error
     1058       then do:
     1059         message
     1060           vss-workfile vss-revision vss-description skip
     1061           vss-include-info8 skip
     1062           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1063           "Объект" p-obj-type p-obj-code skip
     1064           "Артикул" p-artic p-prod-type p-prod-code skip
     1065           "p-fact-order" p-fact-order skip
     1066           view-as alert-box error .
     1067         undo, return error .
     1068       end.
     1069       run partslib-update-by-factord in this-procedure
     1070         (input p-obj-type
     1071         ,input p-obj-code
     1072         ,input p-artic
     1073         ,input p-prod-type
     1074         ,input p-prod-code
     1075         ,input p-fact-order
     1076         ,input v-max-fact-order
     1077         ,input false
     1078         ) no-error .
     1079       if error-status :error
     1080       then do:
     1081         message
     1082           vss-workfile vss-revision vss-description skip
     1083           vss-include-info8 skip
     1084           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1085           "Объект" p-obj-type p-obj-code skip
     1086           "Артикул" p-artic p-prod-type p-prod-code skip
     1087           "p-fact-order" p-fact-order skip
     1088           "v-max-fact-order" v-max-fact-order skip
     1089           view-as alert-box error .
     1090         undo, return error .
     1091       end.
     1092     end.
     1093   end procedure.
     1094   procedure partslib-update-by-factord :
     1095     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1096     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1097     define input parameter p-artic              like ub.parts.artic     no-undo .
     1098     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1099     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1100     define input parameter p-start-fact-order   as decimal   no-undo .
     1101     define input parameter p-end-fact-order     as decimal   no-undo .
     1102     define input parameter p-lock-gds-obj       as logical   no-undo .
     1103     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1104     define buffer buf_gds-obj  for ub.gds-obj .
     1105     define buffer buf_doc-line for ub.doc-line .
     1106     define variable v-total-parts-qnty as decimal   no-undo .
     1107     define variable v-goods-gds-goods  as logical   no-undo .
     1108     define variable v-goods-twounit    as logical   no-undo .
     1109     do
     1110     on error undo, return error
     1111     :
     1112       if p-start-fact-order > p-end-fact-order
     1113       then do:
     1114         message
     1115           vss-workfile vss-revision vss-description skip
     1116           vss-include-info8 skip
     1117           "Ошибка задания входных параметров" skip
     1118           "Начало интервала превышает конец интервала" skip
     1119           "Объект" p-obj-type p-obj-code skip
     1120           "Артикул" p-artic p-prod-type p-prod-code skip
     1121           "p-start-fact-order" p-start-fact-order skip
     1122           "p-end-fact-order"   p-end-fact-order skip
     1123           view-as alert-box error .
     1124         undo, return error .
     1125       end.
     1126       if p-lock-gds-obj = true
     1127       then do:
     1128         do transaction
     1129         on error undo, return error
     1130         :
     1131   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1132   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1133     (input  p-obj-type
     1134     ,input  p-obj-code
     1135     ,input  p-artic
     1136     ,input  p-prod-type
     1137     ,input  p-prod-code
     1138     ,buffer buf_gds-obj
     1139     ) no-error .
     1140           if error-status :error
     1141           then do:
     1142             message
     1143               vss-workfile vss-revision vss-description skip
     1144               vss-include-info8 skip
     1145               "Невозможно найти gds-obj" skip
     1146               error-status :get-message(1) skip
     1147               return-value skip
     1148               view-as alert-box error .
     1149             undo, return error .
     1150           end.
     1151           find current buf_gds-obj exclusive-lock .
     1152         end.
     1153       end.
     1154   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1155   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1156     (input  p-artic
     1157     ,input  p-prod-type
     1158     ,input  p-prod-code
     1159     ,input  'gds-goods=request':u
     1160     ,output v-goods-gds-goods
     1161     ) no-error .
     1162       if error-status :error
     1163       then do:
     1164         message
     1165           vss-workfile vss-revision vss-description skip
     1166           vss-include-info8 skip
     1167           "Ошибка при определении атрибута товара" skip
     1168           "Артикул" p-artic p-prod-type p-prod-code skip
     1169           "gds-goods=request" skip
     1170           error-status :get-message(1) skip
     1171           return-value skip
     1172           view-as alert-box error .
     1173         undo, return error return-value .
     1174       end.
     1175   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1177     (input  p-artic
     1178     ,input  p-prod-type
     1179     ,input  p-prod-code
     1180     ,input  'twounit=request':u
     1181     ,output v-goods-twounit
     1182     ) no-error .
     1183       if error-status :error
     1184       then do:
     1185         message
     1186           vss-workfile vss-revision vss-description skip
     1187           vss-include-info8 skip
     1188           "Ошибка при определении атрибута товара" skip
     1189           "Артикул" p-artic p-prod-type p-prod-code skip
     1190           "twounit=request" skip
     1191           error-status :get-message(1) skip
     1192           return-value skip
     1193           view-as alert-box error .
     1194         undo, return error return-value .
     1195       end.
     1196       for each buf_doc-line no-lock
     1197         where buf_doc-line.obj-type   = p-obj-type
     1198           and buf_doc-line.obj-code   = p-obj-code
     1199           and buf_doc-line.artic      = p-artic
     1200           and buf_doc-line.prod-type  = p-prod-type
     1201           and buf_doc-line.prod-code  = p-prod-code
     1202           and buf_doc-line.status_    = 'факт':U
     1203           and buf_doc-line.fact-order > p-start-fact-order
     1204           and buf_doc-line.fact-order <= p-end-fact-order
     1205       on error undo, return error
     1206       :
     1207         run partslib-process-document in this-procedure
     1208           (input  buf_doc-line.doc-code
     1209           ,input  p-obj-type
     1210           ,input  p-obj-code
     1211           ,input  p-artic
     1212           ,input  p-prod-type
     1213           ,input  p-prod-code
     1214           ,input  v-goods-gds-goods
     1215           ,input  v-goods-twounit
     1216           ,output v-total-parts-qnty
     1217           ) no-error .
     1218         if error-status :error
     1219         then do:
     1220           message
     1221             vss-workfile vss-revision vss-description skip
     1222             vss-include-info8 skip
     1223             "Ошибка при вызове процедуры partslib-process-document" skip
     1224             "Документ" buf_doc-line.doc-code skip
     1225             "Объект" p-obj-type p-obj-code skip
     1226             "Артикул" p-artic p-prod-type p-prod-code skip
     1227             "p-start-fact-order" p-start-fact-order skip
     1228             "p-end-fact-order" p-end-fact-order skip
     1229             error-status :get-message(1) skip
     1230             return-value skip
     1231             view-as alert-box error .
     1232           undo, return error return-value .
     1233         end.
     1234       end.
     1235     end.
     1236   end procedure.
     1237   procedure partslib-process-document :
     1238     define input  parameter p-doc-code         as character no-undo .
     1239     define input  parameter p-obj-type         as character no-undo .
     1240     define input  parameter p-obj-code         as integer   no-undo .
     1241     define input  parameter p-artic            as character no-undo .
     1242     define input  parameter p-prod-type        as character no-undo .
     1243     define input  parameter p-prod-code        as integer   no-undo .
     1244     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1245     define input  parameter p-goods-twounit    as logical   no-undo .
     1246     define output parameter p-total-parts-qnty as decimal   no-undo .
     1247     define variable v-parts-sign as integer   no-undo .
     1248     define buffer buf_trn-doc    for ub.trn-doc .
     1249     define buffer buf_doc-line   for ub.doc-line .
     1250     define buffer buf_parts      for ub.parts .
     1251     define buffer buf_temp-parts for temp-parts .
     1252     do
     1253     on error undo, return error return-value
     1254     :
     1255       find first buf_trn-doc no-lock
     1256         where buf_trn-doc.doc-code = p-doc-code
     1257         no-error .
     1258       if not available buf_trn-doc
     1259       then do:
     1260         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1261                                      ,p-doc-code
     1262                                      ) .
     1263       end.
     1264       case buf_trn-doc.doc-type
     1265       :
     1266         when 'при':U or
     1267         when 'возврат':U or
     1268         when 'инв':U
     1269         then do:
     1270           assign
     1271             v-parts-sign = -1
     1272           .
     1273         end.
     1274         when 'рас':U or
     1275         when 'спи':U
     1276         then do:
     1277           assign
     1278             v-parts-sign = 1
     1279           .
     1280         end.
     1281         otherwise do:
     1282           undo, return error substitute("Неизвестный тип документа &1"
     1283                                       ,buf_trn-doc.doc-type
     1284                                       ) .
     1285         end.
     1286       end.
     1287       find first buf_doc-line no-lock
     1288         where buf_doc-line.doc-code  = p-doc-code
     1289           and buf_doc-line.artic     = p-artic
     1290           and buf_doc-line.prod-type = p-prod-type
     1291           and buf_doc-line.prod-code = p-prod-code
     1292         no-error .
     1293       if not available buf_doc-line
     1294       then do:
     1295         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1296                                      ,p-doc-code
     1297                                      ,artic
     1298                                      ,prod-type
     1299                                      ,prod-code
     1300                                      ) .
     1301       end.
     1302       assign
     1303         p-total-parts-qnty = 0
     1304       .
     1305       if p-goods-gds-goods = true
     1306       then do:
     1307         for each buf_parts no-lock
     1308           where buf_parts.out-code  = p-doc-code
     1309             and buf_parts.obj-type  = p-obj-type
     1310             and buf_parts.obj-code  = p-obj-code
     1311             and buf_parts.artic     = p-artic
     1312             and buf_parts.prod-type = p-prod-type
     1313             and buf_parts.prod-code = p-prod-code
     1314         on error undo, return error
     1315         :
     1316           run partslib-create-temp-parts in this-procedure
     1317             (buffer buf_parts
     1318             ,buffer buf_temp-parts
     1319             ,input  p-goods-twounit
     1320             ) .
     1321           assign
     1322             p-total-parts-qnty        = p-total-parts-qnty
     1323                                       + v-parts-sign * buf_parts.fact-qnty
     1324             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1325                                       + v-parts-sign * buf_parts.fact-qnty
     1326             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1327                                       + v-parts-sign * buf_parts.fact-qnty
     1328             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1329                                       + v-parts-sign * buf_parts.cli-qnty
     1330           .
     1331           if buf_temp-parts.qnty = 0
     1332           then do:
     1333             delete buf_temp-parts .
     1334           end.
     1335         end.
     1336       end.
     1337       else do:
     1338         assign
     1339           p-total-parts-qnty = p-total-parts-qnty
     1340                              + v-parts-sign * buf_doc-line.fact-qnty
     1341         .
     1342       end.
     1343     end.
     1344   end procedure.
     1345   procedure partslib-init-temp-parts-by-date :
     1346     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1347     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1348     define input parameter p-artic           like ub.parts.artic     no-undo .
     1349     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1350     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1351     define input parameter p-fact-date       as date      no-undo .
     1352     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1353     do
     1354     on error undo, return error
     1355     :
     1356       define variable v-fact-order                as decimal   no-undo .
     1357       define variable v-shift-end-fact-order      as decimal   no-undo .
     1358       define variable v-day-end-fact-order        as decimal   no-undo .
     1359       run factord in this-procedure
     1360         (input  p-fact-date
     1361         ,input  1
     1362         ,input  1
     1363         ,input  ?
     1364         ,input  0
     1365         ,input  false
     1366         ,output v-fact-order
     1367         ,output v-shift-end-fact-order
     1368         ,output v-day-end-fact-order
     1369         ) no-error .
     1370       if error-status :error
     1371       then do:
     1372         message
     1373           vss-workfile vss-revision vss-description skip
     1374           vss-include-info8 skip
     1375           "Ошибка при определении момента времени, на который требуется остаток" skip
     1376           "Объект" p-obj-type p-obj-code skip
     1377           "Артикул" p-artic p-prod-type p-prod-code skip
     1378           "Дата" p-fact-date skip
     1379           view-as alert-box error .
     1380         undo, return error .
     1381       end.
     1382       run partslib-init-temp-parts-by-factord in this-procedure
     1383         (input p-obj-type
     1384         ,input p-obj-code
     1385         ,input p-artic
     1386         ,input p-prod-type
     1387         ,input p-prod-code
     1388         ,input v-day-end-fact-order
     1389         ,input false
     1390         ) no-error .
     1391       if error-status :error
     1392       then do:
     1393         message
     1394           vss-workfile vss-revision vss-description skip
     1395           vss-include-info8 skip
     1396           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1397           "Объект" p-obj-type p-obj-code skip
     1398           "Артикул" p-artic p-prod-type p-prod-code skip
     1399           "Дата" p-fact-date skip
     1400           view-as alert-box error .
     1401         undo, return error .
     1402       end.
     1403     end.
     1404   end procedure.
     1405   procedure partslib-calc-cost :
     1406     define output parameter p-fact-qnty      as decimal   no-undo .
     1407     define output parameter p-vat-pc         as decimal   no-undo .
     1408     define output parameter p-slt-pc         as decimal   no-undo .
     1409     define output parameter p-sum-base       as decimal   no-undo .
     1410     define output parameter p-sum-rubl       as decimal   no-undo .
     1411     define output parameter p-vat-base       as decimal   no-undo .
     1412     define output parameter p-vat-rubl       as decimal   no-undo .
     1413     define output parameter p-slt-base       as decimal   no-undo .
     1414     define output parameter p-slt-rubl       as decimal   no-undo .
     1415     define output parameter p-road-tax-base  as decimal   no-undo .
     1416     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1417     define output parameter p-transport-base as decimal   no-undo .
     1418     define output parameter p-transport-rubl as decimal   no-undo .
     1419     define output parameter p-other-base     as decimal   no-undo .
     1420     define output parameter p-other-rubl     as decimal   no-undo .
     1421     define output parameter p-excise-base    as decimal   no-undo .
     1422     define output parameter p-excise-rubl    as decimal   no-undo .
     1423     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1424     do
     1425     on error undo, return error return-value
     1426     :
     1427       define buffer buf_temp-parts for temp-parts .
     1428       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1429       define buffer   in-vatp-parts    for ub.parts   .
     1430       define buffer   in-vatp-doc      for ub.trn-doc .
     1431       define buffer   in-vatp-goods    for ub.goods   .
     1432       define buffer   in-vatp-sysconf  for ub.sysconf .
     1433       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1434       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1435       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1436       define variable varinvprb                  as   character              no-undo.
     1437       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1438       define variable cli-base-rate              as   decimal                no-undo.
     1439       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1440       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1441       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1442       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1443       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1444       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1445       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1446       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1447       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1448       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1449       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1450       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1451       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1452       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1453       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1454       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1455       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1456       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1457       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1458       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1459       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1460       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1461       define variable varinvatp-envd             as   character              no-undo.
     1462       define variable varinvatp-type             as   character              no-undo.
     1463       for each buf_temp-parts
     1464       on error undo, return error
     1465       :
     1466   assign
     1467     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1468     price-base-with-tax-loc = buf_temp-parts.price-base
     1469   .
     1470   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1471   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1472     (output varinvprb
     1473     )  .
     1474     if buf_temp-parts.out-code = 'free-zone':U     or
     1475        buf_temp-parts.out-code = 'out-zone':U   or
     1476        buf_temp-parts.doc-type = 'акт':U then do:
     1477       assign
     1478         in-vatp-have-vat-slt = yes.
     1479     end.
     1480     else do:
     1481       find first in-vatp_doc-attr no-lock
     1482         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1483           and in-vatp_doc-attr.attr-code = 'envd':U
     1484         no-error .
     1485       if not available in-vatp_doc-attr then do:
     1486         assign
     1487           in-vatp-have-vat-slt = yes.
     1488       end.
     1489       else do:
     1490            in-vatp-have-vat-slt = no.
     1491       end.
     1492     end.
     1493     assign
     1494      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1495      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1496     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1497              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1498     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1499             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1500             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1501             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1502             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1503             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1504             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1505       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1506     assign
     1507       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1508     assign
     1509       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1510       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1511       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1512       transport-cli-loc  = 0
     1513       other-cli-loc      = 0
     1514     .
     1515   ASSIGN
     1516             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1517       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1518   .
     1519         assign
     1520           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1521           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1522           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1523           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1524           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1525           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1526           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1527           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1528           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1529           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1530           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1531           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1532           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1533           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1534           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1535           p-excise-base    = p-excise-base    + 0
     1536           p-excise-rubl    = p-excise-rubl    + 0
     1537         .
     1538       end.
     1539       if p-fact-qnty      = ?
     1540       or p-sum-base       = ?
     1541       or p-sum-rubl       = ?
     1542       or p-vat-base       = ?
     1543       or p-vat-rubl       = ?
     1544       or p-slt-base       = ?
     1545       or p-slt-rubl       = ?
     1546       or p-road-tax-base  = ?
     1547       or p-road-tax-rubl  = ?
     1548       or p-transport-base = ?
     1549       or p-transport-rubl = ?
     1550       or p-other-base     = ?
     1551       or p-other-rubl     = ?
     1552       or p-excise-base    = ?
     1553       or p-excise-rubl    = ?
     1554       then do:
     1555         message
     1556           vss-workfile vss-revision vss-description skip
     1557           vss-include-info8 skip
     1558           "Программа in-vatp.i вернула неопределенные значения" skip
     1559           "p-fact-qnty"      p-fact-qnty      skip
     1560           "p-sum-base"       p-sum-base       skip
     1561           "p-sum-rubl"       p-sum-rubl       skip
     1562           "p-vat-base"       p-vat-base       skip
     1563           "p-vat-rubl"       p-vat-rubl       skip
     1564           "p-slt-base"       p-slt-base       skip
     1565           "p-slt-rubl"       p-slt-rubl       skip
     1566           "p-road-tax-base"  p-road-tax-base  skip
     1567           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1568           "p-transport-base" p-transport-base skip
     1569           "p-transport-rubl" p-transport-rubl skip
     1570           "p-other-base"     p-other-base     skip
     1571           "p-other-rubl"     p-other-rubl     skip
     1572           "p-excise-base"    p-excise-base    skip
     1573           "p-excise-rubl"    p-excise-rubl    skip
     1574           view-as alert-box error .
     1575         undo, return error .
     1576       end.
     1577     end.
     1578   end procedure.
     1579   procedure fbrrest-get-free-qnty :
     1580   do
     1581   on error undo, return error
     1582   :
     1583   define input parameter p-obj-type       as character            no-undo.
     1584   define input parameter p-obj-code       as integer              no-undo.
     1585   define input parameter p-gds-code       as integer              no-undo.
     1586   define input parameter p-autofbr        as logical              no-undo.
     1587   define output parameter p-avail-qnty    as decimal              no-undo.
     1588       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
     1589       define variable v-free-qnty as decimal       no-undo.
     1590       define buffer buf_goods         for ub.goods.
     1591       define buffer buf_gds-obj       for ub.gds-obj.
     1592       define buffer buf_temp-parts    for temp-parts.
     1593       find first buf_goods no-lock
     1594            where buf_goods.gds-code = p-gds-code
     1595       .
     1596       assign
     1597           p-avail-qnty = 0
     1598       .
     1599       run partslib-init-temp-parts in this-procedure (
     1600             input p-obj-type
     1601           , input p-obj-code
     1602           , input buf_goods.artic
     1603           , input buf_goods.prod-type
     1604           , input buf_goods.prod-code
     1605       ).
     1606       assign
     1607           v-free-qnty = 0
     1608       .
     1609       for each buf_temp-parts
     1610       on error undo, return error
     1611       :
     1612           if buf_temp-parts.qnty > 0
     1613           then do:
     1614               assign
     1615                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
     1616               .
     1617           end.
     1618       end.
     1619       assign
     1620           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
     1621       .
     1622   end.
     1623   end procedure.
     1624   procedure fbrrest-get-catering-object :
     1625   do
     1626   on error undo, return error
     1627   :
     1628   define input parameter p-obj-code            as integer      no-undo.
     1629   define output parameter p-catering-obj-type  as character    no-undo.
     1630   define output parameter p-catering-obj-code  as integer      no-undo.
     1631       define buffer buf_shop              for ub.shop.
     1632       find first buf_shop no-lock
     1633            where buf_shop.obj-code = p-obj-code
     1634       .
     1635       assign
     1636           p-catering-obj-type = buf_shop.kitchen-store-type
     1637           p-catering-obj-code = buf_shop.kitchen-store-code
     1638       .
     1639   end.
     1640   end procedure.
