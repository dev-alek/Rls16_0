        1   block-level on error undo, throw.
        2   define input parameter parparentproc        as widget-handle    no-undo.
        3   define input parameter p-fbrhist-handle     as widget-handle    no-undo.
        4   define input parameter p-kitchen-type       as character        no-undo.
        5   define input parameter p-kitchen-code       as integer          no-undo.
        6   define input parameter p-res-type           as character        no-undo.
        7   define input parameter p-res-code           as integer          no-undo.
        8   define input parameter p-income-trn-doc-code as character       no-undo.
        9   define input parameter p-sale-doc-code      as character        no-undo.
       10   define input parameter p-kitchen-rest       as logical          no-undo.
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: fbr2sale.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: str/fbr2sale.p $":U .
       16   define variable vss-description as character no-undo init "Создание документа внутреннего перемещения для блюд с кухни в ресторан".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define new global shared variable g#lib-trn  as handle no-undo .
       78   define new global shared variable g#lib-trn2 as handle no-undo .
       79   define new global shared variable g#lib-trn3 as handle no-undo .
       80   define new global shared variable g#lib-trn4 as handle no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure doc-code:
       83   define input  parameter parmode          as   character           no-undo.
       84   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
       85   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
       86   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
       87   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
       88   define buffer buf_sys-ctrl for ub.sys-ctrl  .
       89   define variable vardb-remote     as   logical             no-undo.
       90   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
       91   define variable v-delimiter as character no-undo .
       92   do
       93   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       94   :
       95   find first buf_sys-ctrl no-lock .
       96   vardb-remote = buf_sys-ctrl.db-num <> 0 .
       97     CASE parmode:
       98       when "main":u then do:
       99         if vardb-remote then do:
      100           assign
      101             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      102         end.
      103         else do:
      104           assign
      105             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      106         end.
      107       end.
      108       when "trio" then do:
      109         assign
      110           pardoc-code = replace (parroot-doc-code, "=", "*").
      111       end.
      112       otherwise do:
      113         assign
      114         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      115         no-error
      116         .
      117         if error-status:error  then do:
      118           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      119                                         ,chr(10)
      120                                         ,parmode
      121                                         ).
      122         end.
      123         if num-entries(parmode) = 1
      124         and parmode <> "chip":U
      125         and parmode <> "chip_s":U
      126         then do:
      127           assign
      128           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      129         end.
      130         else if (lookup("chip":U, parmode) > 0
      131                  or
      132                  lookup("chip_s":U, parmode) > 0) then do:
      133           assign
      134             vartemp-doc-code = parroot-doc-code.
      135           do while true:
      136             if index (vartemp-doc-code , ".") = 0 then
      137               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      138             else
      139               vartemp-doc-code  =
      140               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      141               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      142               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      143             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      144           end.
      145           assign
      146             pardoc-code = vartemp-doc-code.
      147         end.
      148       end.
      149     end CASE.
      150     if pardoc-code = '':U
      151     or (parroot-doc-code <> '':U
      152     and pardoc-code = parroot-doc-code) then do:
      153       undo, return error substitute("Ошибка при генерации номера документа&1"
      154                                     ,chr(10)).
      155     end.
      156   end.
      157   end. // procedure/method
      158   function get-doc-code-int64 returns int64
      159     ( input p-doc-code as character ) :
      160     define variable v-ind              as integer   no-undo .
      161     define variable v-num-entries      as integer   no-undo .
      162     define variable v-doc-code-int64   as int64     no-undo .
      163     define variable v-canonic-doc-code as character no-undo .
      164     assign
      165       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      166       v-canonic-doc-code = p-doc-code
      167     .
      168     do v-ind = 1 to v-num-entries
      169     :
      170       assign
      171         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      172       .
      173     end.
      174     assign
      175       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      176     .
      177     return v-doc-code-int64 .
      178   end. // function/method
      179   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      180   procedure cur-time :
      181      define output parameter p-today as date      no-undo .
      182      define output parameter p-time  as integer   no-undo .
      183     do
      184     on error undo, return error
      185     :
      186       define variable v-date1 as date      no-undo .
      187       define variable v-date2 as date      no-undo .
      188       define variable v-time  as integer   no-undo .
      189       assign
      190         v-date1 = today
      191         v-time  = time
      192         v-date2 = today
      193       .
      194       if v-date1 <> v-date2
      195       then do:
      196         assign
      197           v-date1 = today
      198           v-time  = v-time
      199         .
      200       end.
      201       assign
      202         p-today = v-date1
      203         p-time  = v-time
      204       .
      205     end.
      206   end.
      207   function cur-time-date returns character
      208   :
      209     return string(today, '99/99/9999':U) .
      210   end.
      211   function cur-time-mjd returns decimal
      212   :
      213     define variable v-date as date      no-undo .
      214     define variable v-time as integer   no-undo .
      215     run cur-time in this-procedure
      216       (output v-date
      217       ,output v-time
      218       ) .
      219     return integer(v-date) - 2400002 + (v-time / 86400) .
      220   end.
      221   function cur-time-get-ending-index returns integer
      222   (input p-number as integer
      223   )
      224   :
      225     if p-number < 0
      226     or p-number = ?
      227     then do:
      228       return 1 .
      229     end.
      230     define variable v-rest as integer   no-undo .
      231     assign
      232       p-number = p-number modulo 100
      233     .
      234     if p-number < 20
      235     then do:
      236       assign
      237         v-rest = p-number
      238       .
      239     end.
      240     else do:
      241       assign
      242         v-rest = p-number modulo 10
      243       .
      244     end.
      245     case v-rest :
      246       when 1
      247       then do:
      248         return 2 .
      249       end.
      250       when 2 or
      251       when 3 or
      252       when 4
      253       then do:
      254         return 3 .
      255       end.
      256       otherwise do:
      257         return 1 .
      258       end.
      259     end case .
      260   end.
      261   procedure cur-time-mjd-to-date :
      262      define input  parameter i-mjd-diff as decimal no-undo.
      263      define output parameter o-Date     as date    no-undo.
      264      define output parameter o-Time     as integer no-undo.
      265      define variable v-day-number as integer   no-undo .
      266      if    i-mjd-diff < 0
      267         or i-mjd-diff = ?
      268      then do:
      269         return "?" .
      270      end.
      271      assign
      272         v-day-number = truncate(i-mjd-diff,0).
      273         o-Date = date(v-day-number + 2400002).
      274         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      275     .
      276   end.
      277   function cur-time-mjd-to-string returns character
      278   (input p-mjd-diff as decimal
      279   )
      280   :
      281     define variable v-day-number as integer   no-undo .
      282     define variable v-seconds    as integer   no-undo .
      283     define variable v-hour       as integer   no-undo .
      284     define variable v-min        as integer   no-undo .
      285     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      286     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      287     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      288     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      289     if p-mjd-diff < 0
      290     or p-mjd-diff = ?
      291     then do:
      292       return "?" .
      293     end.
      294     assign
      295       v-day-number = integer(truncate(p-mjd-diff,0))
      296       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      297     .
      298     if v-seconds > 86400
      299     then do:
      300       assign
      301         v-seconds = 86400 - 1
      302       .
      303     end.
      304     if v-seconds < 0
      305     then do:
      306       assign
      307         v-seconds = 0
      308       .
      309     end.
      310     assign
      311       v-hour = truncate(v-seconds / 3600, 0)
      312     .
      313     assign
      314       v-seconds = v-seconds modulo 3600
      315     .
      316     assign
      317       v-min = truncate(v-seconds / 60, 0)
      318     .
      319     assign
      320       v-seconds = v-seconds modulo 60
      321     .
      322     return
      323         (if v-day-number <> 0
      324           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      325           else ""
      326         )
      327       + (if v-day-number <> 0 or v-hour <> 0
      328           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      329           else ""
      330         )
      331       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      332           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      333           else ""
      334         )
      335       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      336       .
      337   end.
      338   function cur-time-string returns character
      339   :
      340     define variable v-date as date      no-undo .
      341     define variable v-time as integer   no-undo .
      342     run cur-time in this-procedure
      343       (output v-date
      344       ,output v-time
      345       ) .
      346     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      347   end.
      348   function cur-time-string-sec returns character
      349   :
      350     define variable v-date as date      no-undo .
      351     define variable v-time as integer   no-undo .
      352     run cur-time in this-procedure
      353       (output v-date
      354       ,output v-time
      355       ) .
      356     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      357   end.
      358   function cur-time-custom  returns character
      359   (input p-prefix as character
      360   ,input p-date-format as character
      361   ,input p-delimiter as character
      362   ,input p-time-format as character
      363   ,input p-suffix as character
      364   )
      365   :
      366     define variable v-date as date      no-undo .
      367     define variable v-time as integer   no-undo .
      368     run cur-time in this-procedure
      369       (output v-date
      370       ,output v-time
      371       ) .
      372     return
      373       p-prefix
      374       + string(v-date, p-date-format)
      375       + p-delimiter
      376       + string(v-time, p-time-format)
      377       + p-suffix
      378       .
      379   end.
      380   function cur-time-print  returns character
      381   :
      382     define variable v-date as date      no-undo .
      383     define variable v-time as integer   no-undo .
      384     run cur-time in this-procedure
      385       (output v-date
      386       ,output v-time
      387       ) .
      388     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      389   end.
      390   function cur-time-datetime returns datetime
      391   :
      392     define variable v-char as character no-undo .
      393     define variable v-datetime as datetime no-undo .
      394     v-char = cur-time-string().
      395     v-datetime = datetime(v-char).
      396     return  v-datetime.
      397   end.
      398   function cur-time-string-msec returns character
      399   :
      400     define variable v-date as datetime  no-undo .
      401     v-date = now.
      402     return string(v-date) .
      403   end.
