      360   if valid-handle (g#libofarh)
      361   and g#libofarh <> this-procedure :handle
      362   and g#libofarh :get-signature('libofarh_taskclco':u) <> ""
      363   then do:
      364     message
      365       vss-workfile vss-revision vss-description skip
      366       "Попытка повторной загрузки библиотеки для работы с финансовыми архивами по финансовым обязательствам" skip
      367       g#libofarh skip
      368       g#libofarh :type skip
      369       g#libofarh :file-name skip
      370       valid-handle(g#libofarh) skip
      371       this-procedure :handle skip
      372       this-procedure :type skip
      373       this-procedure :file-name skip
      374       valid-handle(this-procedure) skip
      375       view-as alert-box error .
      376     undo, return error .
      377   end.
      378   else do:
      379     assign
      380       g#libofarh = this-procedure :handle
      381     .
      382   end.
