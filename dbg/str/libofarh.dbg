      385       g#libofarh = ?
      386     .
      387   end.
      388   define stream str-err.
      389   procedure libofarh_taskclco:
      390   define input parameter parhost-code   like ub.fin-ob.host-code   no-undo.
      391   define input parameter pardoc-code    like ub.fin-ob.doc-code    no-undo.
      392   define input parameter paruser-name   as character no-undo .
      393   define input parameter parmode        as character no-undo .
      394   define input parameter parcheck-order as logical   no-undo .
      395   define output parameter p-recalc as logical   no-undo .
      396   define buffer bf_contract                for ub.contract.
      397   define buffer bf_fin-ob                  for ub.fin-ob.
      398   define buffer bf-trb_fin-ob              for ub.fin-ob.
      399   define buffer bf_fin-ob-tax              for ub.fin-ob-tax.
      400   define buffer bf_sysconf                 for ub.sysconf.
      401   define buffer bf_clients                 for ub.clients.
      402   define buffer bf_fin-gds-part            for ub.fin-gds-part.
      403   define buffer bf_parts                   for ub.parts.
      404   define variable varsum-vat-doc   as   decimal               no-undo.
      405   define variable varsum-vat-rubl  as   decimal               no-undo.
      406   define variable varsum-vat-base  as   decimal               no-undo.
      407   define variable varsum-vat-contr as   decimal               no-undo.
      408   define variable varsum-slt-doc   as   decimal               no-undo.
      409   define variable varsum-slt-rubl  as   decimal               no-undo.
      410   define variable varsum-slt-base  as   decimal               no-undo.
      411   define variable varsum-slt-contr as   decimal               no-undo.
      412   define variable varrel-dog-code  as   logical               no-undo.
      413   define variable varcurr-dog-code like ub.currency.curr-code no-undo.
      414   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      415     find first bf_fin-ob where bf_fin-ob.host-code = parhost-code and
      416                                bf_fin-ob.doc-code  = pardoc-code  exclusive-lock no-error.
      417     if not available bf_fin-ob then do:
      418       return error substitute ("Не найдено финансовое обязательство с внутренним номером &1 по фирме &2.", pardoc-code, parhost-code).
      419     end.
      420     p-recalc = false  .
      421     if parcheck-order then do:
      422       find first bf-trb_fin-ob where bf-trb_fin-ob.host-code  = bf_fin-ob.host-code  and
      423                                      bf-trb_fin-ob.status_    = 'факт':U               and
      424                                      bf-trb_fin-ob.fact-order > bf_fin-ob.fact-order no-lock no-error.
      425       if available bf-trb_fin-ob then do:
      426         p-recalc = true .
      427       end.
      428     end.
      429     find first bf_sysconf where bf_sysconf.host-code = bf_fin-ob.host-code no-lock no-error.
      430     if error-status:error then do:
      431       return error substitute ("Критическая ошибка. Не найдена запись sysconf по фирме &1.", bf_fin-ob.host-code).
      432     end.
      433     if bf_sysconf.fin-calc = 1 then do:
      434       if bf_fin-ob.obj-type = "":u and
      435          bf_fin-ob.obj-code = 0    then do:
      436         return error substitute ("По фирме &1 ведется раздельный учет по объектам с поставщиками. В финансовом обязательстве с внутренним номером &2.",
      437                                  bf_sysconf.host-code,
      438                                  bf_fin-ob.doc-code).
      439       end.
      440       find first bf_clients where bf_clients.obj-type = bf_fin-ob.obj-type and
      441                                   bf_clients.obj-code = bf_fin-ob.obj-code no-lock no-error.
      442       if not available bf_clients then do:
      443         return error substitute ("В финансовом обязательстве с внутренним номером &1, указан объект &2 &3 которого нет в справочнике.", bf_fin-ob.doc-code, bf_fin-ob.obj-type, bf_fin-ob.obj-code).
      444       end.
      445       for each bf_fin-gds-part where bf_fin-gds-part.host-code   = bf_fin-ob.host-code and
      446                                      bf_fin-gds-part.fin-ob-code = bf_fin-ob.doc-code  on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
      447         if bf_fin-gds-part.obj-type <> bf_clients.obj-type or
      448            bf_fin-gds-part.obj-code <> bf_clients.obj-code then do:
      449           return error substitute ("В финансовом обязательстве с внутренним номером &1 указан объект &2 &3, но данное фин. обязательство связано с партией из документа &4 по объекту &5 &6.",
      450                                    bf_fin-ob.doc-code,
      451                                    bf_fin-ob.obj-type,
      452                                    bf_fin-ob.obj-code,
      453                                    bf_fin-gds-part.out-code,
      454                                    bf_fin-gds-part.obj-type,
      455                                    bf_fin-gds-part.obj-code).
      456         end.
      457       end.
      458     end.
      459     if parmode <> "close":u  and
      460        parmode <> "delete":u then do:
      461       return error substitute ("Неверный параметр вызова расчета финансовых архивов &1. Должен быть close или delete.", parmode).
      462     end.
      463     assign
      464       varsum-vat-doc   = 0
      465       varsum-vat-rubl  = 0
      466       varsum-vat-base  = 0
      467       varsum-vat-contr = 0
      468       varsum-slt-doc   = 0
      469       varsum-slt-rubl  = 0
      470       varsum-slt-base  = 0
      471       varsum-slt-contr = 0 .
      472     for each bf_fin-ob-tax where bf_fin-ob-tax.host-code = bf_fin-ob.host-code and
      473                                  bf_fin-ob-tax.doc-code  = bf_fin-ob.doc-code  on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      474        assign
      475          varsum-vat-doc   = varsum-vat-doc   + bf_fin-ob-tax.sum-vat-line-doc
      476          varsum-vat-rubl  = varsum-vat-rubl  + bf_fin-ob-tax.sum-vat-line-rubl
      477          varsum-vat-base  = varsum-vat-base  + bf_fin-ob-tax.sum-vat-line-base
      478          varsum-vat-contr = varsum-vat-contr + bf_fin-ob-tax.sum-vat-line-contr
      479          varsum-slt-doc   = varsum-slt-doc   + bf_fin-ob-tax.sum-slt-line-doc
      480          varsum-slt-rubl  = varsum-slt-rubl  + bf_fin-ob-tax.sum-slt-line-rubl
      481          varsum-slt-base  = varsum-slt-base  + bf_fin-ob-tax.sum-slt-line-base
      482          varsum-slt-contr = varsum-slt-contr + bf_fin-ob-tax.sum-slt-line-contr
      483       .
      484     end.
      485     if bf_fin-ob.status_ <> 'факт':U then do:
      486       return error substitute ("Финансовое обязательство с номером &1 не находится в статусе &2.", bf_fin-ob.prn-doc-code, 'факт':U).
      487     end.
      488     if not (bf_fin-ob.doc-type = 'при':U   or
      489             bf_fin-ob.doc-type = 'рас':U) then do:
      490       return error substitute ("Неизвестный тип &1 финансового обязательства с номером &2 внутренний номер &3.", bf_fin-ob.doc-type, bf_fin-ob.prn-doc-code, bf_fin-ob.doc-code).
      491     end.
      492     if bf_fin-ob.contract-code <> 0 then do:
      493       find first bf_contract where bf_contract.host-code     = bf_fin-ob.host-code     and
      494                                    bf_contract.contract-code = bf_fin-ob.contract-code exclusive-lock no-error.
      495       if not available bf_contract then do:
      496         return error substitute ("По финансовому обязательству с внутренним номером &1 на фирме &2 указан договор с внутренним номером &3, которого нет в базе данных.", bf_fin-ob.doc-code, bf_fin-ob.host-code, bf_fin-ob.contract-code).
      497       end.
      498       assign
      499         varrel-dog-code = yes.
      500     end.
      501     else do:
      502       assign
      503         varrel-dog-code = no.
      504     end.
      505     run libofarh_calc-arh-fin-ob-contr in this-procedure (input bf_fin-ob.host-code,
      506                                                           input bf_fin-ob.payer-type,
      507                                                           input bf_fin-ob.payer-code,
      508                                                           input bf_fin-ob.receiver-type,
      509                                                           input bf_fin-ob.receiver-code,
      510                                                           input bf_fin-ob.doc-type,
      511                                                           input "":u,
      512                                                           input bf_fin-ob.fact-order,
      513                                                           input bf_fin-ob.doc-code,
      514                                                           input bf_fin-ob.fact-date,
      515                                                           input bf_sysconf.base-code,
      516                                                           input varcurr-dog-code,
      517                                                           input varrel-dog-code,
      518                                                           input (if available bf_contract then bf_contract.contract-code else 0),
      519                                                           input (if parmode = "close":u then bf_fin-ob.sum-doc      else - bf_fin-ob.sum-doc  ),
      520                                                           input (if parmode = "close":u then bf_fin-ob.sum-rubl     else - bf_fin-ob.sum-rubl ),
      521                                                           input (if parmode = "close":u then bf_fin-ob.sum-base     else - bf_fin-ob.sum-base ),
      522                                                           input (if parmode = "close":u then bf_fin-ob.sum-contract else - bf_fin-ob.sum-contract),
      523                                                           input (if parmode = "close":u then varsum-vat-doc         else - varsum-vat-doc     ),
      524                                                           input (if parmode = "close":u then varsum-vat-rubl        else - varsum-vat-rubl    ),
      525                                                           input (if parmode = "close":u then varsum-vat-base        else - varsum-vat-base    ),
      526                                                           input (if parmode = "close":u then varsum-vat-contr       else - varsum-vat-contr   ),
      527                                                           input (if parmode = "close":u then varsum-slt-doc         else - varsum-slt-doc     ),
      528                                                           input (if parmode = "close":u then varsum-slt-rubl        else - varsum-slt-rubl    ),
      529                                                           input (if parmode = "close":u then varsum-slt-base        else - varsum-slt-base    ),
      530                                                           input (if parmode = "close":u then varsum-slt-contr       else - varsum-slt-contr   )
      531                                                           ) no-error.
      532     if error-status:error then do:
      533       return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
      534     end.
      535     if bf_sysconf.fin-calc = 1 then do:
      536       run libofarh_calc-arh-fin-ob-contr-obj in this-procedure (input bf_fin-ob.host-code,
      537                                                                 input bf_fin-ob.obj-type,
      538                                                                 input bf_fin-ob.obj-code,
      539                                                                 input bf_fin-ob.payer-type,
      540                                                                 input bf_fin-ob.payer-code,
      541                                                                 input bf_fin-ob.receiver-type,
      542                                                                 input bf_fin-ob.receiver-code,
      543                                                                 input bf_fin-ob.doc-type,
      544                                                                 input "":u,
      545                                                                 input bf_fin-ob.fact-order,
      546                                                                 input bf_fin-ob.doc-code,
      547                                                                 input bf_fin-ob.fact-date,
      548                                                                 input bf_sysconf.base-code,
      549                                                                 input varcurr-dog-code,
      550                                                                 input varrel-dog-code,
      551                                                                 input (if available bf_contract then bf_contract.contract-code else 0),
      552                                                                 input (if parmode = "close":u then bf_fin-ob.sum-doc      else - bf_fin-ob.sum-doc  ),
      553                                                                 input (if parmode = "close":u then bf_fin-ob.sum-rubl     else - bf_fin-ob.sum-rubl ),
      554                                                                 input (if parmode = "close":u then bf_fin-ob.sum-base     else - bf_fin-ob.sum-base ),
      555                                                                 input (if parmode = "close":u then bf_fin-ob.sum-contract else - bf_fin-ob.sum-contract),
      556                                                                 input (if parmode = "close":u then varsum-vat-doc         else - varsum-vat-doc     ),
      557                                                                 input (if parmode = "close":u then varsum-vat-rubl        else - varsum-vat-rubl    ),
      558                                                                 input (if parmode = "close":u then varsum-vat-base        else - varsum-vat-base    ),
      559                                                                 input (if parmode = "close":u then varsum-vat-contr       else - varsum-vat-contr   ),
      560                                                                 input (if parmode = "close":u then varsum-slt-doc         else - varsum-slt-doc     ),
      561                                                                 input (if parmode = "close":u then varsum-slt-rubl        else - varsum-slt-rubl    ),
      562                                                                 input (if parmode = "close":u then varsum-slt-base        else - varsum-slt-base    ),
      563                                                                 input (if parmode = "close":u then varsum-slt-contr       else - varsum-slt-contr   )
      564                                                                 ) no-error.
      565       if error-status:error then do:
      566         return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
      567       end.
      568     end.
      569   end.
      570   end procedure.
      571   procedure libofarh_calc-arh-fin-ob-contr :
      572   define input parameter parhost-code           like ub.fin-ob.host-code        no-undo.
      573   define input parameter parpayer-type          like ub.fin-ob.payer-type       no-undo.
      574   define input parameter parpayer-code          like ub.fin-ob.payer-code       no-undo.
      575   define input parameter parreceiver-type       like ub.fin-ob.receiver-type    no-undo.
      576   define input parameter parreceiver-code       like ub.fin-ob.receiver-code    no-undo.
      577   define input parameter pardoc-type            like ub.fin-ob.doc-type         no-undo.
      578   define input parameter parsum-type            as   character                  no-undo.
      579   define input parameter parfact-order          like ub.fin-ob.fact-order       no-undo.
      580   define input parameter pardoc-code            like ub.fin-ob.doc-code         no-undo.
      581   define input parameter parfact-date           like ub.fin-ob.fact-date        no-undo.
      582   define input parameter parbase-code           like ub.sysconf.base-code       no-undo.
      583   define input parameter parcurr-dog-code       like ub.contract.curr-code      no-undo.
      584   define input parameter parrel-dog-code        as   logical                    no-undo.
      585   define input parameter parcontract-code       like ub.contract.contract-code  no-undo.
      586   define input parameter parsum-doc             as   decimal                    no-undo.
      587   define input parameter parsum-rubl            as   decimal                    no-undo.
      588   define input parameter parsum-base            as   decimal                    no-undo.
      589   define input parameter parsum-contr           as   decimal                    no-undo.
      590   define input parameter parsum-vat-doc         as   decimal                    no-undo.
      591   define input parameter parsum-vat-rubl        as   decimal                    no-undo.
      592   define input parameter parsum-vat-base        as   decimal                    no-undo.
      593   define input parameter parsum-vat-contr       as   decimal                    no-undo.
      594   define input parameter parsum-slt-doc         as   decimal                    no-undo.
      595   define input parameter parsum-slt-rubl        as   decimal                    no-undo.
      596   define input parameter parsum-slt-base        as   decimal                    no-undo.
      597   define input parameter parsum-slt-contr       as   decimal                    no-undo.
      598   define buffer bfps_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      599   define buffer bops_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      600   define buffer bfpr_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      601   define buffer bopr_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      602   define buffer bfpb_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      603   define buffer bopb_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      604   define buffer bfpc_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      605   define buffer bopc_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      606   define buffer bfrs_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      607   define buffer bors_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      608   define buffer bfrr_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      609   define buffer borr_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      610   define buffer bfrb_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      611   define buffer borb_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      612   define buffer bfrc_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      613   define buffer borc_arh-fin-ob-contr for ub.arh-fin-ob-contr.
      614   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      615   find last bopr_arh-fin-ob-contr where bopr_arh-fin-ob-contr.host-code        = parhost-code     and
      616                                         bopr_arh-fin-ob-contr.cli-type         = parpayer-type    and
      617                                         bopr_arh-fin-ob-contr.cli-code         = parpayer-code    and
      618                                         bopr_arh-fin-ob-contr.contract-code    = parcontract-code and
      619                                         bopr_arh-fin-ob-contr.fin-ext-doc-type = pardoc-type      and
      620                                         bopr_arh-fin-ob-contr.calc-curr-code   = 0                and
      621                                         bopr_arh-fin-ob-contr.sum-type         = parsum-type      and
      622                                         bopr_arh-fin-ob-contr.fact-order       < parfact-order
      623                                         no-error.
      624   find first bfpr_arh-fin-ob-contr exclusive-lock where
      625             bfpr_arh-fin-ob-contr.host-code        = parhost-code     and
      626             bfpr_arh-fin-ob-contr.cli-type         = parpayer-type    and
      627             bfpr_arh-fin-ob-contr.cli-code         = parpayer-code    and
      628             bfpr_arh-fin-ob-contr.contract-code    = parcontract-code and
      629             bfpr_arh-fin-ob-contr.fin-ext-doc-type = pardoc-type      and
      630             bfpr_arh-fin-ob-contr.calc-curr-code   = 0                and
      631             bfpr_arh-fin-ob-contr.sum-type         = parsum-type      and
      632             bfpr_arh-fin-ob-contr.fact-order       = parfact-order    and
      633             bfpr_arh-fin-ob-contr.fact-date        = parfact-date
      634             no-error .
      635   if not available bfpr_arh-fin-ob-contr then create bfpr_arh-fin-ob-contr.
      636   assign
      637     bfpr_arh-fin-ob-contr.host-code        = parhost-code
      638     bfpr_arh-fin-ob-contr.cli-type         = parpayer-type
      639     bfpr_arh-fin-ob-contr.cli-code         = parpayer-code
      640     bfpr_arh-fin-ob-contr.contract-code    = parcontract-code
      641     bfpr_arh-fin-ob-contr.fin-ext-doc-type = pardoc-type
      642     bfpr_arh-fin-ob-contr.calc-curr-code   = 0
      643     bfpr_arh-fin-ob-contr.sum-type         = parsum-type
      644     bfpr_arh-fin-ob-contr.cource-des       = "r":u
      645     bfpr_arh-fin-ob-contr.fact-order       = parfact-order
      646     bfpr_arh-fin-ob-contr.fin-ob-doc-code  = pardoc-code
      647     bfpr_arh-fin-ob-contr.fact-date        = parfact-date
      648     bfpr_arh-fin-ob-contr.income           = (if available bopr_arh-fin-ob-contr then bopr_arh-fin-ob-contr.income      else 0)
      649     bfpr_arh-fin-ob-contr.income-vat       = (if available bopr_arh-fin-ob-contr then bopr_arh-fin-ob-contr.income-vat  else 0)
      650     bfpr_arh-fin-ob-contr.income-slt       = (if available bopr_arh-fin-ob-contr then bopr_arh-fin-ob-contr.income-slt  else 0)
      651     bfpr_arh-fin-ob-contr.expense          = (if available bopr_arh-fin-ob-contr then bopr_arh-fin-ob-contr.expense     else 0) + parsum-rubl
      652     bfpr_arh-fin-ob-contr.expense-vat      = (if available bopr_arh-fin-ob-contr then bopr_arh-fin-ob-contr.expense-vat else 0) + parsum-vat-rubl
      653     bfpr_arh-fin-ob-contr.expense-slt      = (if available bopr_arh-fin-ob-contr then bopr_arh-fin-ob-contr.expense-slt else 0) + parsum-slt-rubl
      654   .
      655   if parbase-code <> 0 then do:
      656     find last bopb_arh-fin-ob-contr where bopb_arh-fin-ob-contr.host-code        = parhost-code     and
      657                                           bopb_arh-fin-ob-contr.cli-type         = parpayer-type    and
      658                                           bopb_arh-fin-ob-contr.cli-code         = parpayer-code    and
      659                                           bopb_arh-fin-ob-contr.contract-code    = parcontract-code and
      660                                           bopb_arh-fin-ob-contr.fin-ext-doc-type = pardoc-type      and
      661                                           bopb_arh-fin-ob-contr.calc-curr-code   = parbase-code     and
      662                                           bopb_arh-fin-ob-contr.sum-type         = parsum-type      and
      663                                           bopb_arh-fin-ob-contr.fact-order       < parfact-order
      664                                           no-error.
      665     find first bfpb_arh-fin-ob-contr exclusive-lock where
      666               bfpb_arh-fin-ob-contr.host-code        = parhost-code      and
      667               bfpb_arh-fin-ob-contr.cli-type         = parpayer-type     and
      668               bfpb_arh-fin-ob-contr.cli-code         = parpayer-code     and
      669               bfpb_arh-fin-ob-contr.contract-code    = parcontract-code  and
      670               bfpb_arh-fin-ob-contr.fin-ext-doc-type = pardoc-type       and
      671               bfpb_arh-fin-ob-contr.calc-curr-code   = parbase-code      and
      672               bfpb_arh-fin-ob-contr.sum-type         = parsum-type       and
      673               bfpb_arh-fin-ob-contr.fact-order       = parfact-order     and
      674               bfpb_arh-fin-ob-contr.fact-date        = parfact-date      no-error .
      675     if not available bfpb_arh-fin-ob-contr then create bfpb_arh-fin-ob-contr.
      676     assign
      677       bfpb_arh-fin-ob-contr.host-code        = parhost-code
      678       bfpb_arh-fin-ob-contr.cli-type         = parpayer-type
      679       bfpb_arh-fin-ob-contr.cli-code         = parpayer-code
      680       bfpb_arh-fin-ob-contr.contract-code    = parcontract-code
      681       bfpb_arh-fin-ob-contr.fin-ext-doc-type = pardoc-type
      682       bfpb_arh-fin-ob-contr.calc-curr-code   = parbase-code
      683       bfpb_arh-fin-ob-contr.sum-type         = parsum-type
      684       bfpb_arh-fin-ob-contr.cource-des       = "b":u
      685       bfpb_arh-fin-ob-contr.fact-order       = parfact-order
      686       bfpb_arh-fin-ob-contr.fin-ob-doc-code  = pardoc-code
      687       bfpb_arh-fin-ob-contr.fact-date        = parfact-date
      688       bfpb_arh-fin-ob-contr.income           = (if available bopb_arh-fin-ob-contr then bopb_arh-fin-ob-contr.income      else 0)
      689       bfpb_arh-fin-ob-contr.income-vat       = (if available bopb_arh-fin-ob-contr then bopb_arh-fin-ob-contr.income-vat  else 0)
      690       bfpb_arh-fin-ob-contr.income-slt       = (if available bopb_arh-fin-ob-contr then bopb_arh-fin-ob-contr.income-slt  else 0)
      691       bfpb_arh-fin-ob-contr.expense          = (if available bopb_arh-fin-ob-contr then bopb_arh-fin-ob-contr.expense     else 0) + parsum-base
      692       bfpb_arh-fin-ob-contr.expense-vat      = (if available bopb_arh-fin-ob-contr then bopb_arh-fin-ob-contr.expense-vat else 0) + parsum-vat-base
      693       bfpb_arh-fin-ob-contr.expense-slt      = (if available bopb_arh-fin-ob-contr then bopb_arh-fin-ob-contr.expense-slt else 0) + parsum-slt-base
      694     .
      695   end.
      696   if parrel-dog-code  =  yes          and
      697      parcurr-dog-code <> 0            and
      698      parcurr-dog-code <> parbase-code then do:
      699     find last bopc_arh-fin-ob-contr where bopc_arh-fin-ob-contr.host-code        = parhost-code     and
      700                                           bopc_arh-fin-ob-contr.cli-type         = parpayer-type    and
      701                                           bopc_arh-fin-ob-contr.cli-code         = parpayer-code    and
      702                                           bopc_arh-fin-ob-contr.contract-code    = parcontract-code and
      703                                           bopc_arh-fin-ob-contr.fin-ext-doc-type = pardoc-type      and
      704                                           bopc_arh-fin-ob-contr.calc-curr-code   = parcurr-dog-code and
      705                                           bopc_arh-fin-ob-contr.sum-type         = parsum-type      and
      706                                           bopc_arh-fin-ob-contr.fact-order       < parfact-order
      707                                           no-error.
      708     find first bfpc_arh-fin-ob-contr exclusive-lock where
      709       bfpc_arh-fin-ob-contr.host-code        = parhost-code    and
      710       bfpc_arh-fin-ob-contr.cli-type         = parpayer-type   and
      711       bfpc_arh-fin-ob-contr.cli-code         = parpayer-code   and
      712       bfpc_arh-fin-ob-contr.contract-code    = parcontract-code and
      713       bfpc_arh-fin-ob-contr.fin-ext-doc-type = pardoc-type      and
      714       bfpc_arh-fin-ob-contr.calc-curr-code   = parcurr-dog-code and
      715       bfpc_arh-fin-ob-contr.sum-type         = parsum-type      and
