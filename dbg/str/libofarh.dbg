     1214     do
     1215     on error undo, return error return-value
     1216     :
     1217     p-ask = true .
     1218     find first buf_fin-ob no-lock where
     1219                buf_fin-ob.host-code = p-host-code and
     1220                buf_fin-ob.doc-code  = p-doc-code no-error .
     1221                 if error-status :error then do:
     1222                     message
     1223                       vss-workfile vss-revision vss-description skip
     1224                       error-status :get-message(1) skip
     1225                       return-value skip
     1226                       ""
     1227                       view-as alert-box error
     1228                     .
     1229                     return error return-value .
     1230                 end.
     1231     v-obj-type = "".
     1232     v-obj-code = 0.
     1233     for each  buf_fin-gds-part no-lock where
     1234               buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code and
     1235               buf_fin-gds-part.host-code   = buf_fin-ob.host-code :
     1236         v-obj-type = buf_fin-gds-part.obj-type.
     1237         v-obj-code = buf_fin-gds-part.obj-code.
     1238         leave.
     1239     end.
     1240     if v-obj-type = "" and  v-obj-code = 0 then do :
     1241        p-ask = true .
     1242        return .
     1243     end.
     1244   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1245   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1246     (input  v-obj-type
     1247     ,input  v-obj-code
     1248     ,output v-db-num-obj
     1249     )  .
     1250     if v-db-num-obj <> p-db-num then do:
     1251        p-ask = false  .
     1252        return .
     1253     end.
     1254     end.
     1255   end procedure.
     1256   procedure libofarh_doc-fogn :
     1257   define input  parameter p-type-doc as character no-undo .
     1258   define input  parameter p-type-fo  as character no-undo .
     1259   define input  parameter p-doc-code as character no-undo .
     1260   define input  parameter p-db-num as integer     no-undo .
     1261   define output parameter p-may-be as logical   no-undo .
     1262   define variable v-value-character as character no-undo .
     1263   define variable v-value-date      as date   no-undo .
     1264   define variable v-value-decimal   as decimal   no-undo .
     1265   define variable v-fo-buyer-nws    as integer   no-undo .
     1266   define variable v-fo-supp-nws     as integer   no-undo .
     1267   define variable v-value-logical   as logical   no-undo .
     1268   define variable par-type          as character no-undo .
     1269   define variable v-activ-side as logical   no-undo .
     1270   define buffer buf_trn-doc     for ub.trn-doc  .
     1271   define buffer buf_c-trn-doc   for ub.c-trn-doc  .
     1272   define buffer buf_ord-doc     for ub.ord-doc  .
     1273   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
     1274     do
     1275     on error undo, return error return-value
     1276     :
     1277     p-may-be = false .
     1278   run adm/shattri.p (
     1279     input "get":U
     1280     ,input ""
     1281     ,input 0
     1282     ,input 'fin-global':U
     1283     ,input  ""
     1284     ,output v-value-character
     1285     ,output v-value-date
     1286     ,output v-value-decimal
     1287     ,output v-fo-buyer-nws
     1288     ,output v-value-logical
     1289     ,output par-type
     1290     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1291     ) no-error .
     1292     find first thbjattr_thbj-attr where
     1293               thbjattr_thbj-attr.obj-code  = 0  and
     1294               thbjattr_thbj-attr.obj-type  = ""  and
     1295               thbjattr_thbj-attr.prop-code = 'fo-buyer-nws':U and
     1296               thbjattr_thbj-attr.upper-prop-code = 'fin-global':U  no-error .
     1297     .
     1298     if error-status :error then do:
     1299       message
     1300         vss-workfile vss-revision vss-description skip
     1301         error-status :get-message(1) skip
     1302         return-value skip
     1303         ""
     1304         view-as alert-box error
     1305       .
     1306         return error return-value .
     1307     end.
     1308     v-fo-buyer-nws = thbjattr_thbj-attr.property-value-integer .
     1309     find first thbjattr_thbj-attr where
     1310               thbjattr_thbj-attr.obj-code  = 0  and
     1311               thbjattr_thbj-attr.obj-type  = ""  and
     1312               thbjattr_thbj-attr.prop-code = 'fo-supp-nws':U and
     1313               thbjattr_thbj-attr.upper-prop-code = 'fin-global':U  no-error .
     1314     .
     1315     if error-status :error then do:
     1316       message
     1317         vss-workfile vss-revision vss-description skip
     1318         error-status :get-message(1) skip
     1319         return-value skip
     1320         ""
     1321         view-as alert-box error
     1322       .
     1323         return error return-value .
     1324     end.
     1325     v-fo-supp-nws = thbjattr_thbj-attr.property-value-integer .
     1326   define variable v-obj-type as character no-undo .
     1327   define variable v-obj-code as integer   no-undo .
     1328       case p-type-doc :
     1329         when "trn" then do:
     1330             find first buf_trn-doc no-lock where
     1331                        buf_trn-doc.doc-code = p-doc-code  no-error .
     1332                         if error-status :error then do:
     1333                           message
     1334                             vss-workfile vss-revision vss-description skip
     1335                             error-status :get-message(1) skip
     1336                             return-value skip
     1337                             ""
     1338                             view-as alert-box error
     1339                           .
     1340                             return error return-value .
     1341                            end.
     1342             v-obj-type  = buf_trn-doc.obj-type .
     1343             v-obj-code  = buf_trn-doc.obj-code .
     1344         end.
     1345         when "ord" then do:
     1346             find first buf_ord-doc no-lock where
     1347                        buf_ord-doc.doc-code = p-doc-code  no-error .
     1348                         if error-status :error then do:
     1349                           message
     1350                             vss-workfile vss-revision vss-description skip
     1351                             error-status :get-message(1) skip
     1352                             return-value skip
     1353                             ""
     1354                             view-as alert-box error
     1355                           .
     1356                             return error return-value .
     1357                             end.
     1358             v-obj-type  = buf_ord-doc.obj-type .
     1359             v-obj-code  = buf_ord-doc.obj-code .
     1360         end.
     1361         when "rcv" then do:
     1362             find first buf_ord-doc-rcv no-lock where
     1363                        buf_ord-doc-rcv.rcv-code = p-doc-code  no-error .
     1364                         if error-status :error then do:
     1365                           message
     1366                             vss-workfile vss-revision vss-description skip
     1367                             error-status :get-message(1) skip
     1368                             return-value skip
     1369                             ""
     1370                             view-as alert-box error
     1371                           .
     1372                             return error return-value .
     1373                             end.
     1374             v-obj-type  = buf_ord-doc-rcv.obj-type .
     1375             v-obj-code  = buf_ord-doc-rcv.obj-code .
     1376         end.
     1377         when "del" then do:
     1378             find first buf_c-trn-doc no-lock where
     1379                        buf_c-trn-doc.is-del = true and
     1380                        buf_c-trn-doc.doc-code = p-doc-code  no-error .
     1381                         if error-status :error then do:
     1382                           message
     1383                             vss-workfile vss-revision vss-description skip
     1384                             error-status :get-message(1) skip
     1385                             return-value skip
     1386                             ""
     1387                             view-as alert-box error
     1388                           .
     1389                             return error return-value .
     1390                             end.
     1391             v-obj-type  = buf_c-trn-doc.obj-type .
     1392             v-obj-code  = buf_c-trn-doc.obj-code .
     1393         end.
     1394         otherwise do:
     1395           message "Ошибка типа документа " p-type-doc view-as alert-box error .
     1396           return error return-value .
     1397         end.
     1398       end case.
     1399       define variable v-db-num-obj as integer   no-undo .
     1400   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1401   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1402     (input  v-obj-type
     1403     ,input  v-obj-code
     1404     ,output v-db-num-obj
     1405     )  .
     1406   p-may-be = true  .
     1407       case p-type-fo :
     1408         when 'рас':U then do:
     1409             if p-db-num <> 0 then do:
     1410               p-may-be = false .
     1411               return .
     1412             end.
     1413         end.
     1414         when 'при':U then do:
     1415           if v-fo-buyer-nws = 0  then do:
     1416               if v-db-num-obj  <> p-db-num then do:
     1417                 p-may-be = false .
     1418                 return .
     1419               end.
     1420           end.
     1421           else do:
     1422               if p-db-num <> 0 then do:
     1423                 p-may-be = false .
     1424                 return .
     1425               end.
     1426           end.
     1427         end.
     1428         otherwise do:
     1429           message "Ошибка типа ФО" p-type-fo view-as alert-box error .
     1430           return error return-value .
     1431         end.
     1432       end case.
     1433     end.
     1434   end procedure.
