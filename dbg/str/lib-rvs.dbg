     6377           find last sug1_pl-level no-lock
     6378               where sug1_pl-level.pl-code  = bf_rvs-line.pl-code
     6379                 and sug1_pl-level.obj-code = bf_rvs-line.obj-code
     6380                 and sug1_pl-level.obj-type = bf_rvs-line.obj-type
     6381                 and sug1_pl-level.pl-level <= bf_rvs-line.state-level-total
     6382                 no-error .
