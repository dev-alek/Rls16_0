     2204     hCall:SET-PARAMETER(48, "LONG", "INPUT", Round_T).
     2205     hCall:SET-PARAMETER(49, "LONG", "INPUT", Round_R).
     2206     hCall:SET-PARAMETER(50, "LONG", "INPUT", 1024).
     2207     hCall:SET-PARAMETER(51, "LONG", "INPUT", 1024).
     2208     hCall:SET-PARAMETER(52, "DOUBLE", "OUTPUT", V_total1).
     2209     hCall:SET-PARAMETER(53, "DOUBLE", "OUTPUT", V_total2).
     2210     hCall:SET-PARAMETER(54, "DOUBLE", "OUTPUT", V_water1).
