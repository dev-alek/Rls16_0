     7264               "Rprov                  = " 0.0 skip
     7265               "Mpokr                  = " 0.0 skip
     7266               "Vdisp                  = " 0.0 skip
     7267               "CoverFloatingHeight    = " 0.0 skip
     7268             .
     7269           end.
     7270           output stream outstream close.
     7271           if trim(vErr) > "" then do :
     7272             error-string = substitute("~nРезервуар: &1.~n", if avail bf_place then bf_place.loc1 else "")
     7273                          + replace(vErr,";0x","~n0x") .
     7274             output stream outstream to value ("pomi.log")  append.
     7275             put stream outstream error-string format "X(1024)" skip.
     7276             output stream outstream close.
     7277             undo _trpomi, return error substitute('Ошибка работы библиотеки ПОкМИ &1',error-string) .
     7278           end.
     7279           else do :
     7280             v-mm-density = Rcy / 1000 .
     7281             find first rvs-line-attr exclusive-lock
     7282                   where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7283                     and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7284                     and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7285                     and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7286                     and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7287                     and rvs-line-attr.attr-code = "meas-calc-qnty" no-error.
     7288             if available rvs-line-attr then do :
     7289               rvs-line-attr.attr-value = string(Vcy * 1000) .
     7290             end.
     7291             else do :
