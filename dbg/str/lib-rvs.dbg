     6531                                                       and buf_pl-level-attr.obj-type = water2_pl-level.obj-type
     6532                                                       and buf_pl-level-attr.pl-level = water2_pl-level.pl-level
     6533                                                       and buf_pl-level-attr.attr-code = "deltaV"
     6534                                                       :
