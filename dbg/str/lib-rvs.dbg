     7241             'Tv                          = ' if temp-izm-vol <> ? then temp-izm-vol else bf_rvs-line.state-temperature  SKIP
     7242             'Tr                          = ' bf_rvs-line.state-temperature SKIP
     7243             'R                           = ' trim(string(if izmer-density <> ? then ( izmer-density * 1000 ) else ( bf_rvs-line.state-density * 1000 ), ">>>9.9<"))  SKIP
     7244             'Tcy                         = ' temp-for-pomi                       SKIP
     7245             'ToolType                    = ' ToolType                            SKIP
     7246             'DeadZone_Reservoir          = ' DeadZone_Reservoir                  SKIP
     7247             'DeltaOtn_K                  = ' DeltaOtn_K                          SKIP
     7248             'A_Reservoir                 = ' A_Reservoir                         SKIP
     7249             'A_LevelMeasurementTool      = ' A_LevelMeasurementTool              skip
     7250             'DeltaAbs_H                  = ' DeltaAbs_H                          SKIP
     7251             'DeltaAbs_H_Water            = ' DeltaAbs_H_Water                    SKIP
     7252             'DeltaAbs_R                  = ' DeltaAbs_R                          SKIP
     7253             'DeltaAbs_Tv                 = ' DeltaAbs_Tv                         SKIP
     7254             'DeltaAbs_Tr                 = ' DeltaAbs_Tr                         SKIP
     7255             'DeltaOtn_N                  = ' DeltaOtn_N                          SKIP
     7256             'Round_M                     = ' 1                                   SKIP
     7257             'Round_T                     = ' 2                                   SKIP
     7258             'Round_R                     = ' 2                                   SKIP
     7259           .
     7260           if place-type = 1
