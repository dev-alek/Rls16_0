     5717                                    and prev_rvs-line-attr.rvs-code  = prev_rvs-line.rvs-code
     5718                                    and prev_rvs-line-attr.attr-code = "temp-izm-vol" no-error.
     5719                             if available prev_rvs-line-attr
     5720                             then do :
     5721                               find first rvs-line-attr exclusive-lock
     5722                                  where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5723                                    and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
