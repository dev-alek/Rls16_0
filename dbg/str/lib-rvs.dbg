     7293               assign
     7294                 rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7295                 rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7296                 rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7297                 rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7298                 rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7299                 rvs-line-attr.attr-code = "meas-calc-qnty"
     7300                 rvs-line-attr.attr-value = string(Vcy * 1000)
     7301               .
     7302             end.
     7303             find first rvs-line-attr exclusive-lock
     7304                   where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7305                     and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7306                     and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7307                     and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7308                     and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7309                     and rvs-line-attr.attr-code = "meas-calc-dens" no-error.
     7310             if available rvs-line-attr then do :
     7311               rvs-line-attr.attr-value = string ( v-mm-density ) .
     7312             end.
     7313             else do :
     7314               create rvs-line-attr.
     7315               assign
     7316                 rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7317                 rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7318                 rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7319                 rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7320                 rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7321                 rvs-line-attr.attr-code = "meas-calc-dens"
     7322                 rvs-line-attr.attr-value = string ( v-mm-density )
     7323               .
     7324             end.
     7325             if izmer-density = ?
     7326             then do :
     7327               find first rvs-line-attr exclusive-lock
     7328                     where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7329                       and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7330                       and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7331                       and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7332                       and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7333                       and rvs-line-attr.attr-code = "izmer-density" no-error.
     7334               if available rvs-line-attr then do :
     7335                 rvs-line-attr.attr-value = string(bf_rvs-line.density) .
     7336               end.
     7337               else do :
     7338                 create rvs-line-attr.
     7339                 assign
     7340                   rvs-line-attr.obj-code   = bf_rvs-line.obj-code
     7341                   rvs-line-attr.obj-type   = bf_rvs-line.obj-type
     7342                   rvs-line-attr.gds-code   = bf_rvs-line.gds-code
     7343                   rvs-line-attr.pl-code    = bf_rvs-line.pl-code
     7344                   rvs-line-attr.rvs-code   = bf_rvs-line.rvs-code
     7345                   rvs-line-attr.attr-code  = "izmer-density"
     7346                   rvs-line-attr.attr-value = string(bf_rvs-line.density)
     7347                 .
     7348               END.
     7349             end .
     7350             if temp-izm-vol = ?
     7351             then do :
     7352               find first rvs-line-attr exclusive-lock
     7353                     where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7354                       and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7355                       and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7356                       and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7357                       and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7358                       and rvs-line-attr.attr-code = "temp-izm-vol" no-error.
     7359               if available rvs-line-attr then do :
     7360                 rvs-line-attr.attr-value = string(bf_rvs-line.temperature) .
     7361               end.
     7362               else do :
     7363                 create rvs-line-attr.
     7364                 assign
     7365                   rvs-line-attr.obj-code   = bf_rvs-line.obj-code
     7366                   rvs-line-attr.obj-type   = bf_rvs-line.obj-type
     7367                   rvs-line-attr.gds-code   = bf_rvs-line.gds-code
     7368                   rvs-line-attr.pl-code    = bf_rvs-line.pl-code
     7369                   rvs-line-attr.rvs-code   = bf_rvs-line.rvs-code
     7370                   rvs-line-attr.attr-code  = "temp-izm-vol"
     7371                   rvs-line-attr.attr-value = string(bf_rvs-line.temperature)
     7372                 .
     7373               END.
     7374             end .
     7375             if tt-meas-file.log-brutto = no
     7376             or pl-rvd-lvl
     7377             or pl-rvd-dens
     7378             or pl-rvd-temp
     7379             then do :
     7380               find first rvs-line-attr exclusive-lock
     7381                   where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7382                   and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7383                   and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7384                   and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7385                   and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7386                   and rvs-line-attr.attr-code = "delta-mass-qnty" no-error.
     7387               if available rvs-line-attr then
     7388               do :
     7389                 if M > 200000 then rvs-line-attr.attr-value = "0.5" . else rvs-line-attr.attr-value = "0.65".
     7390               end.
     7391               else
     7392               do :
     7393                 create rvs-line-attr.
     7394                 assign
     7395                   rvs-line-attr.obj-code   = bf_rvs-line.obj-code
     7396                   rvs-line-attr.obj-type   = bf_rvs-line.obj-type
     7397                   rvs-line-attr.gds-code   = bf_rvs-line.gds-code
     7398                   rvs-line-attr.pl-code    = bf_rvs-line.pl-code
     7399                   rvs-line-attr.rvs-code   = bf_rvs-line.rvs-code
     7400                   rvs-line-attr.attr-code  = "delta-mass-qnty"
     7401                 .
     7402                 if M > 200000 then rvs-line-attr.attr-value = "0.5" . else rvs-line-attr.attr-value = "0.65".
     7403               end.
     7404               assign
     7405                 tt-meas-file.water-qnty            = V_water * 1000
     7406                 bf_rvs-line.state-measure-qnty     = V * 1000
     7407                 bf_rvs-line.state-measure-cli-qnty = M
     7408                 bf_rvs-line.state-brutto-qnty      = bf_rvs-line.state-measure-qnty  + tt-meas-file.water-qnty
     7409                 bf_rvs-line.state-density          = Rv / 1000
     7410                 bf_rvs-line.state-brutto-cli-qnty  = bf_rvs-line.state-measure-cli-qnty + tt-meas-file.water-qnty
     7411               .
     7412             end .
     7413             find first rvs-line-attr exclusive-lock
     7414                   where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7415                     and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7416                     and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7417                     and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7418                     and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7419                     and rvs-line-attr.attr-code = "pokmi-water-qnty" no-error.
     7420             if available rvs-line-attr then do :
     7421               rvs-line-attr.attr-value = string(V_water * 1000) .
     7422             end.
     7423             else do :
     7424               create rvs-line-attr.
     7425               assign
     7426                 rvs-line-attr.obj-code   = bf_rvs-line.obj-code
     7427                 rvs-line-attr.obj-type   = bf_rvs-line.obj-type
     7428                 rvs-line-attr.gds-code   = bf_rvs-line.gds-code
     7429                 rvs-line-attr.pl-code    = bf_rvs-line.pl-code
     7430                 rvs-line-attr.rvs-code   = bf_rvs-line.rvs-code
     7431                 rvs-line-attr.attr-code  = "pokmi-water-qnty"
     7432                 rvs-line-attr.attr-value = string(V_water * 1000)
     7433               .
     7434             END.
     7435             assign
     7436               v-POkMI-result =
     7437                 "V_total             = " + string(V_total)       + chr(10) +
     7438                 "V_water             = " + string(V_water)       + chr(10) +
     7439                 "DeltaV              = " + string(DeltaV)         + chr(10) +
     7440                 "Vcy                 = " + string(Vcy)           + chr(10) +
     7441                 "Rcy                 = " + string(Rcy)            + chr(10) +
     7442                 "V_product           = " + string(V_product)      + chr(10) +
     7443                 "V                   = " + string(V)              + chr(10) +
     7444                 "Rv                  = " + string(Rv)               + chr(10) +
     7445                 "M                   = " + string(M)                 + chr(10) +
     7446                 "CTL_base_alt        = " + string(CTL_base_alt)  + chr(10) +
     7447                 "CPL_base_alt        = " + string(CPL_base_alt)  + chr(10) +
     7448                 "CTPL_base_alt       = " + string(CTPL_base_alt)  + chr(10) +
     7449                 "Fp_base_alt         = " + string(Fp_base_alt)   + chr(10) +
     7450                 "CTL_obs_base        = " + string(CTL_obs_base)  + chr(10) +
     7451                 "CPL_obs_base        = " + string(CPL_obs_base)  + chr(10) +
     7452                 "CTPL_obs_base       = " + string(CTPL_obs_base)  + chr(10) +
     7453                 "Fp_obs_base         = " + string(Fp_obs_base)   + chr(10) +
     7454                 "DeltaOtn_Vcy        = " + string(DeltaOtn_Vcy)  + chr(10) +
     7455                 "DeltaOtn_Vm         = " + string(DeltaOtn_Vm)   + chr(10) +
     7456                 "DeltaOtn_M          = " + string(DeltaOtn_M)       + chr(10) +
     7457                 "VolumetricExpansion = " + string(VolumetricExpansion) + chr(10) +
     7458                 "Warnings            = " + vWrn
     7459             .
     7460             OUTPUT stream outstream to value ("pomi.log")  append.
     7461             PUT STREAM outstream unformatted v-POkMI-result skip .
     7462             OUTPUT stream outstream close.
     7463             assign
     7464               v-POkMI-result-attr =
     7465                 "Масса НП, кг: " + string(M, "->>,>>>,>>9.9":U) + chr(10) +
     7466                 "Относительная погрешность измерения массы нефтепродукта, %: "  + string(DeltaOtn_M, "->>,>>9.99":U) + chr(10) +
     7467                 "Плотность, приведенная к стандартным условиям, г/см3: " + string((Rcy / 1000), "9.9999":U) + chr(10) +
     7468                 "Объем, приведенный к стандартным условиям, л: " + string((Vcy * 1000), "->>,>>>,>>9":U) + chr(10) +
     7469                 "Объем НП при температуре его измерения, л: " + string((V * 1000), "->>,>>>,>>9":U) + chr(10) +
     7470                 "Объем воды, л: " + string((V_water * 1000), "->>,>>>,>>9":U)
     7471               v-POkMI-warnings = vWrn
     7472             .
     7473             find first rvs-line-attr exclusive-lock
     7474                   where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7475                     and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7476                     and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7477                     and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7478                     and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7479                     and rvs-line-attr.attr-code = "POkMI-result" no-error.
     7480             if available rvs-line-attr then do :
     7481               rvs-line-attr.attr-value = v-POkMI-result-attr .
     7482             end.
     7483             else do :
     7484               create rvs-line-attr.
     7485               assign
     7486                 rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7487                 rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7488                 rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7489                 rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7490                 rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7491                 rvs-line-attr.attr-code = "POkMI-result"
     7492                 rvs-line-attr.attr-value = v-POkMI-result-attr
     7493               .
     7494             end.
     7495             find first rvs-line-attr exclusive-lock
     7496                   where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7497                     and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7498                     and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7499                     and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7500                     and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7501                     and rvs-line-attr.attr-code = "POkMI-warnings" no-error.
     7502             if available rvs-line-attr then do :
     7503               rvs-line-attr.attr-value = v-POkMI-warnings .
     7504             end.
     7505             else do :
     7506               create rvs-line-attr.
     7507               assign
     7508                 rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7509                 rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7510                 rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7511                 rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7512                 rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7513                 rvs-line-attr.attr-code = "POkMI-warnings"
     7514                 rvs-line-attr.attr-value = v-POkMI-warnings
     7515               .
     7516             end.
     7517           end .
     7518           release rvs-line-attr no-error .
     7519         END.
     7520       END.
     7521     END.
     7522   END.
     7523   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7524   run get-ptrl-prop in this-procedure
     7525     ( input p-obj-type
     7526     , input p-obj-code
     7527     ) .
     7528       define variable v-calc-free-vol as logical no-undo init no .
     7529       define variable v-sec-num as character no-undo init "" .
     7530       if (is-sug(bf_rvs-line.gds-code) and ptrlprop-calc-free-vol-sug)
     7531       or (not is-sug(bf_rvs-line.gds-code) and ptrlprop-calc-free-vol)
     7532       then do :
     7533         v-calc-free-vol = yes .
     7534       end .
     7535       find first buf_rvs-doc no-lock where buf_rvs-doc.rvs-code = bf_rvs-line.rvs-code .
     7536       if buf_rvs-doc.rvs-type = 'перед_док':U
     7537       then do :
     7538         if v-calc-free-vol then do:
     7539         define variable infoSectionsTotal as class ibs.th.str.InfoSectionsTotal no-undo.
     7540         define variable iisec as integer no-undo .
     7541         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_rvs-doc.out-code no-error .
     7542         if available buf_trn-doc
     7543         and buf_trn-doc.reason-code = 98
     7544         then do : end .
     7545         else do :
     7546           v-doc-volume = 0 .
     7547           find first buf_place no-lock where buf_place.obj-code = bf_rvs-line.obj-code
     7548                                          and buf_place.obj-type = bf_rvs-line.obj-type
     7549                                          and buf_place.pl-code  = bf_rvs-line.pl-code
     7550                                          no-error.
     7551           if is-sug(bf_rvs-line.gds-code)
     7552           then do :
     7553             is-main-tank = no .
     7554             run placelib_get-attr  ( input "place-com-tanks"
     7555                                     ,input buf_place.obj-code
     7556                                     ,input buf_place.obj-type
     7557                                     ,input buf_place.pl-code
     7558                                     ,output v-value
     7559                                     ,output v-ok      ) no-error.
     7560             if v-ok
     7561             and v-value > ""
     7562             then do :
     7563               run placelib_get-attr  ( input "place-is-main"
     7564                                       ,input buf_place.obj-code
     7565                                       ,input buf_place.obj-type
     7566                                       ,input buf_place.pl-code
     7567                                       ,output v-value
     7568                                       ,output v-ok      ) no-error.
     7569               if v-ok
     7570               and v-value > ""
     7571               and logical(v-value)
     7572               then do :
     7573                 is-main-tank = yes .
     7574               end .
     7575             end .
     7576             else do :
     7577               is-main-tank = yes .
     7578             end .
     7579             if is-main-tank
     7580             then do :
     7581               find first buf_doc-pl no-lock where buf_doc-pl.obj-type   = bf_rvs-line.obj-type
     7582                                               and buf_doc-pl.obj-code   = bf_rvs-line.obj-code
     7583                                               and buf_doc-pl.gds-code   = bf_rvs-line.gds-code
     7584                                               and buf_doc-pl.pl-code    = bf_rvs-line.pl-code
     7585                                               and buf_doc-pl.out-code   = buf_rvs-doc.out-code
     7586                                               no-error .
     7587               if not available buf_doc-pl
     7588               then do :
     7589                 message "В накладной для товара " string(bf_rvs-line.gds-code) " нет распределения по местам хранения! Невозможно произвести расчет свободной ёмкости в резервуаре." view-as alert-box .
     7590               end .
     7591               else do :
     7592                 v-doc-volume = buf_doc-pl.fact-qnty .
     7593               end .
     7594             end .
     7595           end .
     7596           else do :
     7597             infoSectionsTotal = new ibs.th.str.InfoSectionsTotal(buf_trn-doc.doc-code, bf_rvs-line.gds-code, 'ПРОСМОТР':U).
     7598             if num-entries(bf_rvs-line.rvs-code, "-") = 3
     7599             then do :
     7600               v-sec-num = entry(2, bf_rvs-line.rvs-code, "-") .
     7601             end .
     7602             sect_ :
     7603             do iisec = 1 to infoSectionsTotal:SectionNum :
     7604               infoSectionsTotal:GetInfoSectionProp (iisec).
     7605               if infoSectionsTotal:InfoSectionCurr:ListTank <> buf_place.loc1
     7606               then
     7607                 next sect_ .
     7608               if v-sec-num <> ""
     7609               and v-sec-num <> infoSectionsTotal:InfoSectionCurr:SectionName
     7610               then
     7611                 next sect_ .
     7612               if infoSectionsTotal:InfoSectionCurr:DocVolume > 0
     7613               then do :
     7614                 v-doc-volume = v-doc-volume + infoSectionsTotal:InfoSectionCurr:DocVolume .
     7615               end .
     7616               else do :
     7617                 v-doc-volume = v-doc-volume + infoSectionsTotal:InfoSectionCurr:DocQnty .
     7618               end .
     7619             end .
     7620           end .
     7621           if v-doc-volume > 0
     7622           then do :
     7623             if is-sug(bf_rvs-line.gds-code)
     7624             then do :
     7625               assign v-free-vol = 0.85 * buf_place.max-qnty - bf_rvs-line.state-measure-tc-qnty .
     7626             end .
     7627             else do :
     7628               assign v-free-vol = 0.95 * buf_place.max-qnty - bf_rvs-line.state-brutto-qnty .
     7629             end .
     7630             if v-free-vol >= v-doc-volume
     7631             then do :
     7632               find first buf_doc-pl-attr exclusive-lock
     7633                   where buf_doc-pl-attr.obj-code  = bf_rvs-line.obj-code
     7634                     and buf_doc-pl-attr.obj-type  = bf_rvs-line.obj-type
     7635                     and buf_doc-pl-attr.gds-code  = bf_rvs-line.gds-code
     7636                     and buf_doc-pl-attr.pl-code   = bf_rvs-line.pl-code
     7637                     and buf_doc-pl-attr.out-code  = buf_rvs-doc.out-code
     7638                     and buf_doc-pl-attr.attr-code = "free-vol-exceed" no-error.
     7639               if available buf_doc-pl-attr then
     7640               do :
     7641                 buf_doc-pl-attr.attr-value = string(no)  .
     7642               end.
     7643               else
     7644               do :
     7645                 create buf_doc-pl-attr.
     7646                 assign
     7647                   buf_doc-pl-attr.obj-code   = bf_rvs-line.obj-code
     7648                   buf_doc-pl-attr.obj-type   = bf_rvs-line.obj-type
     7649                   buf_doc-pl-attr.gds-code   = bf_rvs-line.gds-code
     7650                   buf_doc-pl-attr.pl-code    = bf_rvs-line.pl-code
     7651                   buf_doc-pl-attr.out-code   = buf_rvs-doc.out-code
     7652                   buf_doc-pl-attr.attr-code  = "free-vol-exceed"
     7653                   buf_doc-pl-attr.attr-value = string(no)
     7654                 .
     7655               end.
     7656             end .
     7657             else do :
     7658               run ref/message_volue.w(input string(round(v-doc-volume, 0)),
     7659               input buf_place.loc1,
     7660               input string(round(v-free-vol, 0)),
     7661               input true) no-error .
     7662               find first buf_doc-pl-attr exclusive-lock
     7663                   where buf_doc-pl-attr.obj-code  = bf_rvs-line.obj-code
     7664                     and buf_doc-pl-attr.obj-type  = bf_rvs-line.obj-type
     7665                     and buf_doc-pl-attr.gds-code  = bf_rvs-line.gds-code
     7666                     and buf_doc-pl-attr.pl-code   = bf_rvs-line.pl-code
     7667                     and buf_doc-pl-attr.out-code  = buf_rvs-doc.out-code
     7668                     and buf_doc-pl-attr.attr-code = "free-vol-exceed" no-error.
     7669               if available buf_doc-pl-attr then
     7670               do :
     7671                 buf_doc-pl-attr.attr-value = string(yes)  .
     7672               end.
     7673               else
     7674               do :
     7675                 create buf_doc-pl-attr.
     7676                 assign
     7677                   buf_doc-pl-attr.obj-code   = bf_rvs-line.obj-code
     7678                   buf_doc-pl-attr.obj-type   = bf_rvs-line.obj-type
     7679                   buf_doc-pl-attr.gds-code   = bf_rvs-line.gds-code
     7680                   buf_doc-pl-attr.pl-code    = bf_rvs-line.pl-code
     7681                   buf_doc-pl-attr.out-code   = buf_rvs-doc.out-code
     7682                   buf_doc-pl-attr.attr-code  = "free-vol-exceed"
     7683                   buf_doc-pl-attr.attr-value = string(yes)
     7684                 .
     7685               end.
     7686             end .
     7687           end .
     7688         end .
     7689       end .
     7690         end.
     7691         if buf_rvs-doc.rvs-type = 'после_док':U then
     7692         do:
     7693             find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_rvs-doc.out-code no-error .
     7694             if available buf_trn-doc
     7695               and buf_trn-doc.reason-code = 98
     7696               then
     7697             do :
     7698             end .
     7699             else
     7700             do :
     7701               v-doc-volume = 0 .
     7702               find first buf_place no-lock where buf_place.obj-code = bf_rvs-line.obj-code
     7703                 and buf_place.obj-type = bf_rvs-line.obj-type
     7704                 and buf_place.pl-code  = bf_rvs-line.pl-code
     7705                 no-error.
     7706               v-doc-volume = v-doc-volume + bf_rvs-line.state-brutto-qnty .
     7707               if v-doc-volume > 0
     7708                 then
     7709               do :
     7710                 if is-sug(bf_rvs-line.gds-code)
     7711                   then
     7712                 do :
     7713                   assign
     7714                     v-free-vol = 0.85 * buf_place.max-qnty .
     7715                 end .
     7716                 else
     7717                 do :
     7718                   assign
     7719                     v-free-vol = 0.95 * buf_place.max-qnty .
     7720                 end .
     7721               end.
     7722             end.
     7723           if v-free-vol < v-doc-volume then
     7724           do :
     7725                find first buf_doc-pl-attr exclusive-lock
     7726                   where buf_doc-pl-attr.obj-code  = bf_rvs-line.obj-code
     7727                   and buf_doc-pl-attr.obj-type  = bf_rvs-line.obj-type
     7728                   and buf_doc-pl-attr.gds-code  = bf_rvs-line.gds-code
     7729                   and buf_doc-pl-attr.pl-code   = bf_rvs-line.pl-code
     7730                   and buf_doc-pl-attr.out-code  = buf_rvs-doc.out-code
     7731                   and buf_doc-pl-attr.attr-code = "free-vol-exceed-after" no-error.
     7732                 if available (buf_doc-pl-attr) then
     7733                 buf_doc-pl-attr.attr-value = string(yes)  .
     7734                 else
     7735                 do :
     7736                   create buf_doc-pl-attr.
     7737                   assign
     7738                     buf_doc-pl-attr.obj-code   = bf_rvs-line.obj-code
     7739                     buf_doc-pl-attr.obj-type   = bf_rvs-line.obj-type
     7740                     buf_doc-pl-attr.gds-code   = bf_rvs-line.gds-code
     7741                     buf_doc-pl-attr.pl-code    = bf_rvs-line.pl-code
     7742                     buf_doc-pl-attr.out-code   = buf_rvs-doc.out-code
     7743                     buf_doc-pl-attr.attr-code  = "free-vol-exceed-after"
     7744                     buf_doc-pl-attr.attr-value = string(yes)
     7745                     .
     7746                 end.
     7747             end.
     7748       end.
     7749   define variable v-initiator  as character no-undo.
     7750   case true:
     7751     when g#auto then v-initiator = "Auto".
     7752     when g#news then v-initiator = "Nws".
     7753     when g#esys then v-initiator = "Esys".
     7754     otherwise v-initiator = "User".
     7755   end case.
     7756       define variable v-shift-date like ub.shift-obj.shift-date no-undo .
     7757       define variable v-shift-num  like ub.shift-obj.shift-num no-undo .
     7758       define variable v-shift-name like ub.shift-obj.shift-name no-undo.
     7759       define variable v-person     as character no-undo.
     7760   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7761   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     7762     (input  bf_rvs-line.obj-type
     7763     ,input  bf_rvs-line.obj-code
     7764     ,output v-shift-date
     7765     ,output v-shift-num
     7766     ,output v-shift-name
     7767     ) no-error .
     7768       for first  ub.rvs-doc no-lock
     7769           where ub.rvs-doc.rvs-code = bf_rvs-line.rvs-code :
     7770         v-vid-action = 56 .
     7771         v-vid-param =
     7772              "Initiator=" + v-initiator + chr(4) +
     7773             "SHOP_NUM=" + string(ub.rvs-doc.obj-code) + chr(4) +
     7774             "DocType=" + string(ub.rvs-doc.rvs-type) + chr(4) +
     7775             "DocNum=" + string(ub.rvs-doc.rvs-code) + chr(4) +
     7776              "SHIFT_NUM_DOC=" + (if string(ub.rvs-doc.shift-num) = ? then '' else string(ub.rvs-doc.shift-num)) + (if string(ub.rvs-doc.shift-date) = ? then '' else string(ub.rvs-doc.shift-date, "99999999")) + chr(4) +
     7777              "SHIFT_NUM=" + (if string(v-shift-num) = ? then '' else string(v-shift-num)) + (if string(v-shift-date) = ? then '' else string(v-shift-date, "99999999")) + chr(4) +
     7778             "PlCode=" + string(bf_rvs-line.pl-code) + chr(4) +
     7779             "Temperature=" + string(bf_rvs-line.state-temperature) + chr(4) +
     7780             "StateDensity=" + string( bf_rvs-line.state-density) + chr(4) +
     7781             "StateMeasureQnty=" + string(  bf_rvs-line.state-measure-qnty  ) + chr(4) +
     7782             "StateBruttoQnty=" +  string(bf_rvs-line.state-brutto-qnty ) + chr(4) +
     7783             "StateMeasureCliQnty=" + string(bf_rvs-line.state-measure-cli-qnty)  + chr(4) +
     7784             "StateBruttoCliQnty=" + string(bf_rvs-line.state-brutto-cli-qnty ) +  chr(4) +
     7785             "StateLevelTotal=" + string(  bf_rvs-line.state-level-total) +  chr(4) +
     7786             "StateLevelPetrol=" + string(  bf_rvs-line.state-level-petrol  ) +  chr(4) +
     7787             "StateLevelWater=" + string(  bf_rvs-line.state-level-water    ) +  chr(4) +
     7788             "StateMeasureTcQnty=" + string(  bf_rvs-line.state-measure-tc-qnty  ) +   chr(4) +
     7789             "StateBruttoTcQnty=" + string(   bf_rvs-line.state-brutto-tc-qnty ) +   chr(4) +
     7790             "RESULT=" + string( 0 ) + chr(4) +
     7791             "Description="  no-error.
     7792         run trg/userlog.p (
     7793             input 'create':U
     7794             , input 'rvs-doc':U
     7795             , input ( buffer ub.rvs-doc :handle )
     7796             , input v-vid-action
     7797             , input v-vid-param
     7798             ) no-error.
     7799         if error-status :error
     7800         then do:
     7801           return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     7802                 , chr(10)
     7803                 , vss-workfile
     7804                 , return-value
     7805                 , error-status :get-message ( 1 ) ).
     7806         end.
     7807       end.
     7808     RETURN .
     7809   END PROCEDURE.
     7810   procedure lib-rvs_fill2plc :
     7811     define input        parameter           p-obj-type  like ub.rvs-line.obj-type no-undo.
     7812     define input        parameter           p-obj-code  like ub.rvs-line.obj-code no-undo.
     7813     define input        parameter           p-pl-code   like ub.rvs-line.pl-code  no-undo.
     7814     define input        parameter           p-rec-line  as   recid                no-undo.
     7815     define input        parameter           p-prev-code like ub.rvs-doc.rvs-code  no-undo.
     7816     define input-output parameter table for tt-meas.
     7817   define variable p-prev-rvs-date as logical no-undo.
     7818     define variable olddensvalue as character no-undo initial ?.
     7819     define variable olddenstype  as character no-undo initial ?.
     7820     define variable varnum-rsrv  as integer   no-undo.
     7821     define buffer crl_prev_rvs-doc  for ub.rvs-doc.
     7822     define buffer prev_rvs-line     for ub.rvs-line.
     7823     define buffer bf_goods          for ub.goods.
     7824     define buffer bf_gds-obj        for ub.gds-obj.
     7825     define buffer bf-prev_doc-line  for ub.doc-line.
     7826     define buffer bf-prev_inv-line  for ub.inv-line.
     7827     define buffer bf-prp_goods      for ub.goods.
     7828     define buffer bf-prp_pl-gds     for ub.pl-gds.
     7829     define buffer bf_rvs-line       for ub.rvs-line.
     7830     define buffer buf_doc-line-attr for ub.doc-line-attr .
     7831     define variable v-qnty    as decimal      no-undo.
     7832     find first bf_rvs-line
     7833       where recid( bf_rvs-line ) = p-rec-line
     7834     .
     7835     find first buf_doc-line-attr
     7836       where buf_doc-line-attr.doc-code   = bf_rvs-line.rvs-code
     7837         and buf_doc-line-attr.gds-code   = bf_rvs-line.gds-code
     7838         and buf_doc-line-attr.attr-code  = substitute("rvs-&1",bf_rvs-line.pl-code)
     7839       no-error.
     7840     if not available buf_doc-line-attr then do:
     7841       return error substitute ( 'Ошибка. Данные по документам не заполнены по месту хранения &1.', p-pl-code ).
     7842     end.
     7843     else do:
     7844       assign
     7845         v-qnty = decimal(entry(1, buf_doc-line-attr.attr-value, chr(4)))
     7846       .
     7847     end.
     7848     assign
     7849       bf_rvs-line.state-measure-qnty     = v-qnty
     7850       bf_rvs-line.state-measure-tc-qnty  = v-qnty
     7851     .
     7852       find first crl_prev_rvs-doc no-lock
     7853         where crl_prev_rvs-doc.rvs-code = p-prev-code
     7854         no-error.
     7855       if available crl_prev_rvs-doc then do:
     7856         find first prev_rvs-line no-lock where
     7857                    prev_rvs-line.rvs-code = crl_prev_rvs-doc.rvs-code and
     7858                    prev_rvs-line.obj-type = bf_rvs-line.obj-type      and
     7859                    prev_rvs-line.obj-code = bf_rvs-line.obj-code      and
     7860                    prev_rvs-line.pl-code  = bf_rvs-line.pl-code       and
     7861                    prev_rvs-line.gds-code = bf_rvs-line.gds-code      no-error.
     7862         if available prev_rvs-line then do:
     7863           assign
     7864             bf_rvs-line.state-level-water      = prev_rvs-line.state-level-water
     7865             bf_rvs-line.state-density          = prev_rvs-line.state-density
     7866             bf_rvs-line.state-brutto-qnty      = bf_rvs-line.state-measure-qnty + ( prev_rvs-line.state-brutto-qnty - prev_rvs-line.state-measure-qnty )
     7867             bf_rvs-line.state-brutto-tc-qnty  = bf_rvs-line.state-brutto-qnty
     7868             bf_rvs-line.state-measure-cli-qnty = bf_rvs-line.state-measure-qnty * bf_rvs-line.state-density
     7869             bf_rvs-line.state-brutto-cli-qnty  = bf_rvs-line.state-brutto-qnty  * bf_rvs-line.state-density
     7870           .
     7871           find first bf_goods   no-lock where
     7872                      bf_goods.gds-code    = bf_rvs-line.gds-code.
     7873           find first bf_gds-obj no-lock where
     7874                      bf_gds-obj.obj-type  = bf_rvs-line.obj-type and
     7875                      bf_gds-obj.obj-code  = bf_rvs-line.obj-code and
     7876                      bf_gds-obj.artic     = bf_goods.artic       and
     7877                      bf_gds-obj.prod-code = bf_goods.prod-code   and
     7878                      bf_gds-obj.prod-code = bf_goods.prod-code   no-error.
     7879           if available bf_gds-obj then do:
     7880             if bf_gds-obj.fact-qnty <> 0 then do:
     7881               find last bf-prev_doc-line no-lock where
     7882                         bf-prev_doc-line.obj-type   = bf_rvs-line.obj-type and
     7883                         bf-prev_doc-line.obj-code   = bf_rvs-line.obj-code and
     7884                         bf-prev_doc-line.prod-type  = bf_goods.prod-type   and
     7885                         bf-prev_doc-line.prod-code  = bf_goods.prod-code   and
     7886                         bf-prev_doc-line.artic      = bf_goods.artic       and
     7887                         bf-prev_doc-line.status_    = 'факт':U              and
     7888                         bf-prev_doc-line.fact-order > 0                    use-index fact-order no-error.
     7889               if available bf-prev_doc-line then do:
     7890                 find first bf-prev_inv-line no-lock where
     7891                            bf-prev_inv-line.doc-code  = bf-prev_doc-line.doc-code  and
     7892                            bf-prev_inv-line.artic     = bf-prev_doc-line.artic     and
     7893                            bf-prev_inv-line.prod-code = bf-prev_doc-line.prod-code and
     7894                            bf-prev_inv-line.prod-type = bf-prev_doc-line.prod-type no-error.
     7895                 if available bf-prev_inv-line then do:
     7896                   assign
     7897                     bf_rvs-line.system-cli-qnty = bf_rvs-line.system-qnty * bf-prev_inv-line.after-cli-qnty
     7898                                                                           / bf_gds-obj.fact-qnty
     7899                   .
     7900                 end.
     7901               end.
     7902               else do:
     7903                 assign
     7904                   bf_rvs-line.system-cli-qnty = 0.00
     7905                 .
     7906               end.
     7907             end.
     7908             else do:
     7909               find last bf-prev_doc-line no-lock where
     7910                         bf-prev_doc-line.obj-type   = bf_rvs-line.obj-type and
     7911                         bf-prev_doc-line.obj-code   = bf_rvs-line.obj-code and
     7912                         bf-prev_doc-line.prod-type  = bf_goods.prod-type   and
     7913                         bf-prev_doc-line.prod-code  = bf_goods.prod-code   and
     7914                         bf-prev_doc-line.artic      = bf_goods.artic       and
     7915                         bf-prev_doc-line.status_    = 'факт':U              and
     7916                         bf-prev_doc-line.fact-order > 0                    use-index fact-order no-error.
     7917               if available bf-prev_doc-line then do:
     7918                 find first bf-prev_inv-line no-lock where
     7919                            bf-prev_inv-line.doc-code  = bf-prev_doc-line.doc-code  and
     7920                            bf-prev_inv-line.artic     = bf-prev_doc-line.artic     and
     7921                            bf-prev_inv-line.prod-code = bf-prev_doc-line.prod-code and
     7922                            bf-prev_inv-line.prod-type = bf-prev_doc-line.prod-type no-error.
     7923                 if available bf-prev_inv-line then do:
     7924                   find first bf-prp_goods no-lock where
     7925                              bf-prp_goods.artic     = bf-prev_inv-line.artic     and
     7926                              bf-prp_goods.prod-type = bf-prev_inv-line.prod-type and
     7927                              bf-prp_goods.prod-code = bf-prev_inv-line.prod-code .
     7928                   assign
     7929                     varnum-rsrv = 0
     7930                   .
     7931                   for each bf-prp_pl-gds no-lock where
     7932                            bf-prp_pl-gds.gds-code = bf-prp_goods.gds-code and
     7933                            bf-prp_pl-gds.obj-type = bf_rvs-line.obj-type  and
     7934                            bf-prp_pl-gds.obj-code = bf_rvs-line.obj-code
     7935                   on error undo, return error return-value
     7936                   :
     7937                     assign
     7938                       varnum-rsrv = varnum-rsrv + 1
     7939                     .
     7940                   end.
     7941                   assign
     7942                     bf_rvs-line.system-cli-qnty = bf-prev_inv-line.after-cli-qnty / varnum-rsrv
     7943                   .
     7944                 end.
     7945               end.
     7946               else do:
     7947                 assign
     7948                   bf_rvs-line.system-cli-qnty = 0.00
     7949                 .
     7950               end.
     7951             end.
     7952           end.
     7953           else do:
     7954             assign
     7955               bf_rvs-line.system-cli-qnty = 0.00
     7956             .
     7957           end.
     7958         end.
     7959       end.
     7960   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7961   run get-ptrl-prop in this-procedure
     7962     ( input p-obj-type
     7963     , input p-obj-code
     7964     ) .
     7965           IF ptrlprop-olddens = true
     7966           and not is-sug(bf_rvs-line.gds-code)
     7967           THEN
     7968           DO:
     7969               p-prev-rvs-date = NO.
     7970               FIND FIRST rvs-doc WHERE rvs-doc.rvs-code = bf_rvs-line.rvs-code NO-LOCK NO-ERROR.
     7971               prev: FOR EACH crl_prev_rvs-doc NO-LOCK
     7972                   WHERE crl_prev_rvs-doc.obj-type   = p-obj-type
     7973                   AND crl_prev_rvs-doc.obj-code   = p-obj-code
     7974                   AND crl_prev_rvs-doc.shift-date = rvs-doc.shift-date
     7975                   AND crl_prev_rvs-doc.shift-num  = rvs-doc.shift-num
     7976                   AND crl_prev_rvs-doc.status_    = 'факт':U
     7977                   AND crl_prev_rvs-doc.rvs-type  <> 'проверка':U
     7978                   BY crl_prev_rvs-doc.fact-order DESC
     7979                   ON ERROR UNDO, RETURN ERROR RETURN-VALUE
     7980                   :
     7981                   IF CAN-FIND( FIRST doc-attr
     7982                       WHERE doc-attr.doc-code  = crl_prev_rvs-doc.rvs-code
     7983                       AND doc-attr.attr-code = "rvs-auto":U
     7984                       AND doc-attr.attr-value = "Yes":U
     7985                       NO-LOCK)
     7986                       THEN next prev.
     7987                   FIND LAST prev_rvs-line NO-LOCK
     7988                       WHERE prev_rvs-line.rvs-code = crl_prev_rvs-doc.rvs-code
     7989                       AND prev_rvs-line.obj-type = p-obj-type
     7990                       AND prev_rvs-line.obj-code = p-obj-code
     7991                       AND prev_rvs-line.pl-code  =  bf_rvs-line.pl-code
     7992                       AND prev_rvs-line.gds-code = bf_rvs-line.gds-code
     7993                       NO-ERROR .
     7994                   IF AVAILABLE prev_rvs-line THEN
     7995                   DO:
     7996                       bf_rvs-line.state-density = prev_rvs-line.state-density.
     7997                       bf_rvs-line.state-temperature = prev_rvs-line.state-temperature.
     7998                       p-prev-rvs-date = YES.
     7999                       LEAVE prev .
     8000                   END.
     8001               END.
     8002               IF   p-prev-rvs-date = NO THEN
     8003               DO :
     8004                   FIND FIRST crl_prev_rvs-doc NO-LOCK WHERE
     8005                       crl_prev_rvs-doc.rvs-code = p-prev-code NO-ERROR .
     8006                   IF AVAILABLE crl_prev_rvs-doc THEN
     8007                   DO:
     8008                       FIND FIRST prev_rvs-line NO-LOCK WHERE
     8009                           prev_rvs-line.rvs-code = crl_prev_rvs-doc.rvs-code AND
     8010                           prev_rvs-line.obj-type = bf_rvs-line.obj-type      AND
     8011                           prev_rvs-line.obj-code = bf_rvs-line.obj-code      AND
     8012                           prev_rvs-line.pl-code  = bf_rvs-line.pl-code       AND
     8013                           prev_rvs-line.gds-code = bf_rvs-line.gds-code      NO-ERROR .
     8014                       IF AVAILABLE prev_rvs-line THEN
     8015                       DO:
     8016                           ASSIGN
     8017                               bf_rvs-line.state-temperature = prev_rvs-line.state-temperature
     8018                               bf_rvs-line.density                = prev_rvs-line.state-density
     8019                               bf_rvs-line.state-density          = prev_rvs-line.state-density
     8020                               bf_rvs-line.measure-cli-qnty       = bf_rvs-line.measure-qnty       * bf_rvs-line.density
     8021                               bf_rvs-line.brutto-cli-qnty        = bf_rvs-line.brutto-qnty        * bf_rvs-line.density
     8022                               bf_rvs-line.state-measure-cli-qnty = bf_rvs-line.state-measure-qnty * bf_rvs-line.density
     8023                               bf_rvs-line.state-brutto-cli-qnty  = bf_rvs-line.state-brutto-qnty  * bf_rvs-line.density
     8024                               .
     8025                       END.
     8026                   END.
     8027               END.
     8028           END.
     8029     return .
     8030   end procedure.
     8031   procedure lib-rvs_rvs-full :
     8032     define input parameter p-rvs-code like ub.rvs-doc.rvs-code no-undo.
     8033     define variable l_rvs-is-full as logical no-undo initial yes.
     8034     define variable v-attr-value  as character no-undo .
     8035     define variable v-attr-type   as character no-undo .
     8036     define buffer bf_place    for ub.place.
     8037     define buffer bf_pl-gds   for ub.pl-gds.
     8038     define buffer bf_rvs-doc  for ub.rvs-doc.
     8039     define buffer bf_rvs-line for ub.rvs-line.
     8040     tr:
     8041     do
     8042     on error undo tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     8043     on stop  undo tr, return error substitute( "&1 (stop).", vss-workfile )
     8044     on quit  undo tr, return error substitute( "&1 (quit).", vss-workfile )
     8045     :
     8046       find first bf_rvs-doc exclusive-lock
     8047         where bf_rvs-doc.rvs-code = p-rvs-code
     8048         no-error.
     8049       if not available bf_rvs-doc then do:
     8050         undo tr, return error substitute( 'lib-rvs_rvs-full: не найдена сверка "&1"', p-rvs-code ).
     8051       end.
     8052       for each bf_place  no-lock
     8053         where bf_place.obj-type = bf_rvs-doc.obj-type
     8054           and bf_place.obj-code = bf_rvs-doc.obj-code
     8055         ,each bf_pl-gds no-lock
     8056         where bf_pl-gds.obj-type = bf_place.obj-type
     8057           and bf_pl-gds.obj-code = bf_place.obj-code
     8058           and bf_pl-gds.pl-code  = bf_place.pl-code
     8059       on error undo tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     8060       :
     8061         run gds-attr-value in this-procedure
     8062           ( input  bf_pl-gds.gds-code
     8063            ,input  'ptrl-without-rvs':U
     8064            ,output v-attr-value
     8065            ,output v-attr-type
     8066           ) .
     8067         if lookup(v-attr-value, 'true,yes':u) = 0 then do:
     8068           find first bf_rvs-line no-lock
     8069             where bf_rvs-line.rvs-code = bf_rvs-doc.rvs-code
     8070               and bf_rvs-line.obj-type = bf_pl-gds.obj-type
     8071               and bf_rvs-line.obj-code = bf_pl-gds.obj-code
     8072               and bf_rvs-line.pl-code  = bf_pl-gds.pl-code
     8073               and bf_rvs-line.gds-code = bf_pl-gds.gds-code
     8074             no-error.
     8075           if not available bf_rvs-line then do:
     8076             assign
     8077               l_rvs-is-full = no
     8078             .
     8079             leave .
     8080           end.
     8081         end.
     8082       end.
     8083       if l_rvs-is-full = yes then do:
     8084         assign
     8085           bf_rvs-doc.is-full = yes
     8086         .
     8087       end.
     8088     end.
     8089     return .
     8090   end procedure.
     8091   procedure lib-rvs_rvsclose :
     8092     define input  parameter parparentproc as widget-handle no-undo.
     8093     define input  parameter p-rec-rvs-doc as recid   no-undo.
     8094     define input  parameter p-message-on  as logical no-undo.
     8095     define buffer rc_rvs-doc  for ub.rvs-doc.
     8096     define buffer bef-rvs-doc for ub.rvs-doc.
     8097     define buffer bf_trn-doc  for ub.trn-doc.
     8098     define variable varchk-prs  as character no-undo.
     8099     define variable v_data-type as character no-undo.
     8100     define variable g-log       as logical   no-undo.
     8101     define variable v-chk-act   as character no-undo .
     8102   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8103     define variable v-cntxt-db-num        as integer   no-undo .
     8104     define variable v-cntxt-userid        as character no-undo .
     8105     define variable v-cntxt-level         as character no-undo .
     8106     define variable v-cntxt-host-code-obj as integer   no-undo .
     8107     define variable v-cntxt-obj-type      as character no-undo .
     8108     define variable v-cntxt-obj-code      as integer   no-undo .
     8109     define variable v-cntxt-db-num-obj    as integer   no-undo .
     8110     define variable v-cntxt-is-admin      as logical   no-undo .
     8111     run get-userid in parparentproc ( output v-cntxt-userid).
     8112     run get-db-num in parparentproc ( output v-cntxt-db-num).
     8113     do
     8114     on error undo, return error substitute( "lib-rvs_rvsclose: &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     8115     :
     8116       find first rc_rvs-doc
     8117         where recid( rc_rvs-doc ) = p-rec-rvs-doc
     8118       .
     8119       if rc_rvs-doc.rvs-type <> 'перед_док':U
     8120         and rc_rvs-doc.rvs-type <> 'после_док':U
     8121       then do:
     8122   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8123   empty temp-table thbjattr_thbj-attr.
     8124   run adm/shattri.p (
     8125      input "get":U
     8126     ,input ''
     8127     ,input 0
     8128     ,input 'nakl-glob':U
     8129     ,input  ""
     8130     ,output v-value-character
     8131     ,output v-value-date
     8132     ,output v-value-decimal
     8133     ,output v-value-integer
     8134     ,output v-value-logical
     8135     ,output par-type
     8136     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     8137     ) no-error .
     8138         for each thbjattr_thbj-attr :
     8139           if thbjattr_thbj-attr.prop-code = 'chk-prs' then varchk-prs = string(thbjattr_thbj-attr.property-value-logical,"yes/no") .
     8140         end.
     8141         empty temp-table thbjattr_thbj-attr.
     8142         if varchk-prs <> 'no' then do:
     8143           if not can-find( ub.clients no-lock where
     8144                            ub.clients.obj-type = 'чел':U and
     8145                            ub.clients.obj-code = rc_rvs-doc.boss )
     8146           then do:
     8147             return error 'Не указан или неправильный менеджер.' .
     8148           end.
     8149           if not can-find( ub.clients no-lock where
     8150                            ub.clients.obj-type = 'чел':U and
     8151                            ub.clients.obj-code = rc_rvs-doc.agnt )
     8152           then do:
     8153             return error 'Не указан или неправильный исполнитель.' .
     8154           end.
     8155         end.
     8156       end.
     8157       case rc_rvs-doc.rvs-type :
     8158         when 'перед_док':U
     8159         or when 'после_док':U
     8160         then do:
     8161           assign
     8162             v-chk-act = 'actn_rvs-on-doc_fact':U
     8163           .
     8164         end.
     8165         when 'смена':U
     8166         then do:
     8167           assign
     8168             v-chk-act = 'actn_rvs-shift_fact':U
     8169           .
     8170         end.
     8171         when 'контроль':U
     8172         then do:
     8173           assign
     8174             v-chk-act = 'actn_rvs-control_fact':U
     8175           .
     8176         end.
     8177         when 'проверка':U
     8178         then do:
     8179           assign
     8180             v-chk-act = 'no-ckeck':U
     8181           .
     8182         end.
     8183         otherwise do:
     8184           message
     8185             vss-workfile vss-revision vss-description skip
     8186             "Неизвестный тип документа сверки" skip
     8187             "Тип документа сверки" rc_rvs-doc.rvs-type skip
     8188             "Код документа сверки" rc_rvs-doc.rvs-code skip
     8189             view-as alert-box error .
     8190           undo, return error return-value .
     8191         end.
     8192       end case .
     8193       if not g#auto
     8194       and v-chk-act <> 'no-ckeck':U
     8195       then do:
     8196   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8197   do:
     8198     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8199       (input  v-cntxt-db-num
     8200       ,input  v-cntxt-userid
     8201       ,input  0
     8202       ,input  v-chk-act
     8203       ,input  'object':U
     8204       ,input  rc_rvs-doc.host-code
     8205       ,input  rc_rvs-doc.obj-type
     8206       ,input  rc_rvs-doc.obj-code
     8207       ,input  0
     8208       ,input  0
     8209       ,input  0
     8210       ,input  p-message-on
     8211       ,output g-log
     8212       )  .
     8213   end.
     8214         if g-log <> yes then do:
     8215           return error substitute( 'У Вас недостаточно прав для выполнения данного действия:&5'
     8216                                  + '"закрытие сверки типа <<&1>> на факт" на объекте: &2 &3.&5'
     8217                                  + '&4&5'
     8218                                  + 'Обратитесь к администратору.'
     8219                                  , rc_rvs-doc.rvs-type
     8220                                  , rc_rvs-doc.obj-type
     8221                                  , rc_rvs-doc.obj-code
     8222                                  , return-value
     8223                                  , chr(10) ) .
     8224         end.
     8225       end.
     8226       tr:
     8227       do transaction
     8228       on error   undo tr, return error return-value
     8229       on end-key undo tr, return error return-value
     8230       :
     8231         run gbl/chk-date.p
     8232           ( input rc_rvs-doc.obj-type
     8233           , input rc_rvs-doc.obj-code
     8234           , input rc_rvs-doc.fact-date
     8235           , input rc_rvs-doc.fact-time
     8236           , input rc_rvs-doc.shift-date
     8237           , input rc_rvs-doc.shift-num
     8238           , input p-message-on
     8239           ) no-error .
     8240         if error-status :error then do:
     8241           undo tr, return error substitute( 'lib-rvs_rvsclose: Ошибка при установке даты в документе (rvs-doc)&1&2.', chr(10), return-value ) .
     8242         end.
     8243         if rc_rvs-doc.rvs-type = 'смена':U
     8244           and rc_rvs-doc.status_  = 'разрешен':U
     8245         then do:
     8246   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_rvschtrn in g#lib-trn3
     8247     (  input rc_rvs-doc.obj-type
     8248     ,  input rc_rvs-doc.obj-code
     8249     ,  input rc_rvs-doc.shift-date
     8250     ,  input rc_rvs-doc.shift-num
     8251     ,  input rc_rvs-doc.rvs-code
     8252     ,  input no
     8253     ,  input yes
     8254     , output g-log
     8255     )        no-error
     8256   .
     8257           if error-status :error then do:
     8258             undo tr, return error 'lib-rvs_rvsclose: Ошибка поиска незакрытых документов. '  + return-value .
     8259           end.
     8260           if g-log <> no then do:
     8261             undo tr, return error 'lib-rvs_rvsclose: Невозможно создать сверку. ' + return-value .
     8262           end.
     8263         end.
     8264         if rc_rvs-doc.rvs-type <> 'проверка':U
     8265         then do :
     8266           define variable v-ok    as logical      no-undo.
     8267           run str/rvs-attr.p
     8268             ( input rc_rvs-doc.rvs-code
     8269             , input rc_rvs-doc.obj-type
     8270             , input rc_rvs-doc.obj-code
     8271             , output v-ok
     8272             ) no-error.
     8273           if error-status :error
     8274             or v-ok = false
     8275           then do:
     8276           end.
     8277         end .
     8278         run str/rvs-stat.p
     8279           ( input parparentproc
     8280            ,input recid( rc_rvs-doc )
     8281            ,input 'close':U
     8282           )  .
     8283         if error-status :error then do:
     8284           undo tr, return error substitute( 'lib-rvs_rvsclose: Ошибка при изменении статуса&1&2.', chr(10), return-value ) .
     8285         end.
     8286         release rc_rvs-doc no-error.
     8287         if error-status:error then    undo tr, return error  return-value .
     8288         find first rc_rvs-doc where recid( rc_rvs-doc ) = p-rec-rvs-doc .
     8289         if rc_rvs-doc.rvs-type = 'смена':U
     8290           and rc_rvs-doc.status_  = 'факт':U
     8291         then do:
     8292           run gbl/sht-clos.p
     8293             ( input parparentproc
     8294              ,input rc_rvs-doc.obj-type
     8295              ,input rc_rvs-doc.obj-code
     8296              ,input false
     8297              ,input (if p-message-on = true then false else true )
     8298             ) no-error .
     8299             for each tt-susp-chk:
     8300             end.
     8301           if error-status :error then do:
     8302             undo tr, return error 'Ошибка при закрытии смены. ' + return-value .
     8303           end.
     8304         end.
     8305       end.
     8306     end.
     8307     return .
     8308   end procedure.
     8309   PROCEDURE get-userid :
     8310   do
     8311   on error undo, return error
     8312   :
     8313   define output parameter p-userid  as character    no-undo.
     8314       assign
     8315           p-userid = g#userid
     8316       .
     8317   end.
     8318   END PROCEDURE.
     8319   procedure get-db-num:
     8320     define output parameter pDbNum as integer no-undo.
     8321     pDbNum = g#db-num.
     8322   end.
     8323   procedure lib-rvs_crtt-rvs :
     8324     define input-output parameter table for tt-param.
     8325     define       output parameter           p-comstring   as character no-undo initial ?.
     8326     define       output parameter           p-comment     as character no-undo initial ?.
     8327     define       output parameter           p-StartString as character no-undo initial ?.
     8328     define variable rvsvalue       as character no-undo initial ?.
     8329     define variable rvstype        as character no-undo initial ?.
     8330     define variable StrFrFile-list as character no-undo initial '':U.
     8331     define variable StrFrAsi-list  as character no-undo initial '':U.
     8332     define variable FldDb-list     as character no-undo initial '':U.
     8333     define variable jj             as integer   no-undo.
     8334   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     8335     (input  'revision'
     8336     ,input  ''
     8337     ,input  ''
     8338     ,input  0
     8339     ,input  ''
     8340     ,input  ''
     8341     ,input  ''
     8342     ,input  no
     8343     ,output rvsvalue
     8344     ,output rvstype
     8345     ) no-error .
     8346     assign
     8347       rvsvalue       = trim( rvsvalue )
     8348       StrFrFile-list = "level_total" + ",level_water" + ",level_oil-"     + ",t1"          + ",t2"          + ",t3"          + ",temperature" + ",density" + ",volume_total" + ",volume_total_tc" + ",mass_total"      + ",volume_oil"   + ",volume_water" + ",vapor_density" + ",vapor_pressure"
     8349       StrFrASi-list  = "level-total" + ",level-water" + ",level-total-"    + ",t1"          + ",t2"          + ",t3"          + ",avrg-temp"   + ",density" + ",total-vol"    + ",volume_total_tc" + ",mass"            + ",volume_oil"   + ",volume_water" + ",vapor-density" + ",vapor-pressure"
     8350       FldDb-list     = "level-total" + ",level-water" + ",level-petrol"   + ",temp-layer1" + ",temp-layer2" + ",temp-layer3" + ",temperature" + ",density" + ",brutto-qnty"  + ",brutto-qnty-tc"  + ",brutto-cli-qnty" + ",measure-qnty" + ",water-qnty"   + ",vapor-density" + ",vapor-pressure"
     8351     .
     8352     if rvsvalue = ? then do:
     8353       assign
     8354         rvsvalue = 'struna'
     8355       .
     8356     end.
     8357     get-key-value section 'revision'
     8358                   key     'comstr'
     8359                   value   p-comstring.
     8360       case rvsvalue :
     8361         when 'struna'     or
     8362         when 'vedee-root'
     8363         then do:
     8364           for each tt-param :
     8365             delete tt-param .
     8366           end.
     8367           assign
     8368             p-comment     = '#'
     8369             p-StartString = 'tank'
     8370           .
     8371           do jj = 1 to min( num-entries( StrFrFile-list ), num-entries( FldDb-list ), num-entries(StrFrASi-list)) :
     8372             create tt-param.
     8373             assign
     8374                    tt-param.strfrfile = entry( jj, StrFrFile-list )
     8375                    tt-param.strasi    = entry( jj, StrFrASi-list )
     8376                    tt-param.flddb     = entry( jj, FldDb-list     )
     8377             .
     8378           end.
     8379         end.
     8380         otherwise do:
     8381           return error 'Неизвестный тип прибора в параметре revision.' .
     8382         end.
     8383       end case.
     8384     return .
     8385   end procedure.
     8386   procedure lib-rvs_crtt-pmp :
     8387     define input-output parameter table for tt-param-pump.
     8388     define variable StrFrFile-list as character no-undo initial 'PUMP,NZL,VOL,VAL,GRADE,CNT,STATUS':U.
     8389     define variable jj             as integer   no-undo.
     8390       for each tt-param-pump :
     8391         delete tt-param-pump .
     8392       end.
     8393       do jj = 1 to num-entries( StrFrFile-list ) :
     8394         create tt-param-pump.
     8395         assign
     8396                tt-param-pump.strfrfile = entry( jj, StrFrFile-list )
     8397         .
     8398       end.
     8399     return .
     8400   end procedure.
     8401   define temp-table tt-User no-undo
     8402          field usr as character
     8403          field pwd as character
     8404       index usr usr.
     8405   define variable vss-revision19    as character no-undo init "$Revision:$":U .
     8406   define variable vss-author19      as character no-undo init "$Author:$":U .
     8407   define variable vss-date19        as character no-undo init "$Date:$":U .
     8408   define variable vss-workfile19    as character no-undo init "$Workfile:$":U .
     8409   define variable vss-archive19     as character no-undo init "$Archive:$":U .
     8410   define variable vss-description19 as character no-undo init "Работа С сокетом".
     8411   procedure PutMesAsunc:
     8412       define input  parameter Itext as character no-undo.
     8413       define variable vflag as logical no-undo.
     8414       Publish "WriteLogAsunc" (Itext, yes)  .
