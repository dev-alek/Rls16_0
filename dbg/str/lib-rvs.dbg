     6583                                                  ,(if available bf_place then bf_place.loc1 else "?")
     6584                                                  ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     6585                                                  ,(if available bf_goods then bf_goods.gds-name else "?") ) .
     6586           end .
     6587           DeltaV2 = ? .
     6588           for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total2_pl-level.pl-code
     6589                                                 and buf_pl-level-attr.obj-code = total2_pl-level.obj-code
