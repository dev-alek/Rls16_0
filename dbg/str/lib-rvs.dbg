     6404                                                 and buf_pl-level-attr.obj-code = sug1_pl-level.obj-code
     6405                                                 and buf_pl-level-attr.obj-type = sug1_pl-level.obj-type
     6406                                                 and buf_pl-level-attr.pl-level = sug1_pl-level.pl-level
     6407                                                 and buf_pl-level-attr.attr-code = "deltaV"
     6408                                                 :
     6409             DeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     6410           end .
     6411           find first sug2_pl-level no-lock
     6412               where sug2_pl-level.pl-code  = bf_rvs-line.pl-code
     6413                 and sug2_pl-level.obj-code = bf_rvs-line.obj-code
     6414                 and sug2_pl-level.obj-type = bf_rvs-line.obj-type
     6415                 and sug2_pl-level.pl-level > bf_rvs-line.state-level-total
     6416                 no-error .
     6417           if not available sug2_pl-level
     6418           then do :
     6419             find first bf_goods no-lock where bf_goods.gds-code = bf_rvs-line.gds-code no-error .
     6420             find first bf_place no-lock where bf_place.pl-code = bf_rvs-line.pl-code no-error .
     6421             undo _trpomi, return error substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Создание сверки не возможно.'
     6422                                                  ,(if available bf_place then bf_place.loc1 else "?")
     6423                                                  ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     6424                                                  ,(if available bf_goods then bf_goods.gds-name else "?") ) .
     6425           end .
     6426           DeltaV2 = ? .
     6427           for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = sug2_pl-level.pl-code
     6428                                                 and buf_pl-level-attr.obj-code = sug2_pl-level.obj-code
     6429                                                 and buf_pl-level-attr.obj-type = sug2_pl-level.obj-type
     6430                                                 and buf_pl-level-attr.pl-level = sug2_pl-level.pl-level
     6431                                                 and buf_pl-level-attr.attr-code = "deltaV"
     6432                                                 :
     6433             DeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
     6434           end .
     6435           find last full_pl-level no-lock
     6436               where full_pl-level.pl-code  = bf_rvs-line.pl-code
     6437                 and full_pl-level.obj-code = bf_rvs-line.obj-code
     6438                 and full_pl-level.obj-type = bf_rvs-line.obj-type
     6439                 no-error .
     6440           if not available full_pl-level
     6441           then do :
     6442             find first bf_goods no-lock where bf_goods.gds-code = bf_rvs-line.gds-code no-error .
     6443             find first bf_place no-lock where bf_place.pl-code = bf_rvs-line.pl-code no-error .
     6444             undo _trpomi, return error substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Создание сверки не возможно.'
     6445                                                  ,(if available bf_place then bf_place.loc1 else "?")
     6446                                                  ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     6447                                                  ,(if available bf_goods then bf_goods.gds-name else "?") ) .
     6448           end .
     6449           DeltaOtn_K_Full = ? .
     6450           for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = full_pl-level.pl-code
     6451                                                 and buf_pl-level-attr.obj-code = full_pl-level.obj-code
     6452                                                 and buf_pl-level-attr.obj-type = full_pl-level.obj-type
