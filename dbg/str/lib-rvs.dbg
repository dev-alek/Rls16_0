     8436   end.
     8437   procedure PutFileLogAsunc:
     8438       define input  parameter IFile as character no-undo.
     8439       Publish "PutFileLogAsunc" (ifile)  .
     8440   end.
     8441   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8442   define variable v-waitfram-action01         as character   no-undo .
     8443   define variable v-waitfram-action02         as character   no-undo .
     8444   define variable v-waitfram-action03         as character   no-undo .
     8445   define variable mWaitFramTextBeg            as character   no-undo.
     8446   define variable mWaitFramTextEnd            as character   no-undo.
     8447   define variable mWaitFramView               as logical     no-undo.
     8448   define variable mWaitProcEvent              as logical     no-undo init yes.
     8449   define variable mWaitFramInterval           as integer     no-undo init 1 .
     8450   define variable mWaitFramStop               as logical     no-undo.
     8451   define variable mWaitFramStopUser           as logical     no-undo.
     8452   define variable mWaitFramStopTimeOut        as logical     no-undo.
     8453   define variable mWaitFramStartProc          as datetime-tz no-undo.
     8454   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     8455   define button B-WaitFramStop auto-end-key
     8456        label "Стоп"
     8457        size 10 by 1 tooltip "Остоновить процесс".
     8458   define button B-viewProcInfo
     8459        label "Информация"
     8460        size 15 by 1 tooltip "Информация о процесс".
     8461   define frame waitfram
     8462     v-waitfram-action01 format "x(72)" no-label skip
     8463     v-waitfram-action02 format "x(72)" no-label skip
     8464     v-waitfram-action03 format "x(72)" no-label skip
     8465     B-viewProcInfo
     8466     B-WaitFramStop at row 4 col 30
     8467     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     8468     .
     8469   define new global shared variable mBatchMode as logical no-undo init ?.
     8470   define variable mFramBachModHandle as handle no-undo.
     8471   mFramBachModHandle = frame waitfram:handle.
     8472   define variable mFameOldVis as logical no-undo.
     8473   define variable mVisCUrentVin as logical no-undo.
     8474   if session:batch-mode
     8475   then
     8476      mBatchMode = yes.
     8477   if mBatchMode = ? then do:
     8478     mVisCUrentVin = current-window:visible.
     8479     mFameOldVis = mFramBachModHandle:visible.
     8480     mFramBachModHandle:visible  = yes.
     8481     mBatchMode = mFramBachModHandle:visible ne yes.
     8482     mFramBachModHandle:visible = mFameOldVis.
     8483     current-window:visible = mVisCUrentVin.
     8484   end.
     8485    if  log-manager:logfile-name ne ?
     8486     then DO:
     8487         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     8488         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     8489         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     8490     end.
     8491   on choose of B-WaitFramStop in frame waitfram
     8492   do:
     8493     mWaitFramStop = yes.
     8494     mWaitFramStopUser = yes.
     8495   end.
     8496   function waitfram-check-timeout returns logical():
     8497      define variable vtime as int64 no-undo.
     8498      if mWaitFramStopTimeOut
     8499      then
     8500         return yes.
     8501      vtime = ( now - mWaitFramStartProc ) / 1000 .
     8502      if     mWaitFramTimeOut ne ?
     8503         and mWaitFramTimeOut ne 0
     8504         and mWaitFramTimeOut lt vtime
     8505      then do:
     8506         mWaitFramStopTimeOut = yes.
     8507      end.
     8508      return mWaitFramStopTimeOut.
     8509   end.
     8510   procedure waitfram-hide :
     8511     if not session:batch-mode
     8512     then do
     8513     on error undo, return error return-value
     8514     :
     8515       pause 0 before-hide .
     8516       if not mBatchMode then
     8517         hide frame waitfram .
     8518     if     not mWaitFramView
     8519        and mWaitProcEvent
     8520     then
     8521       process events .
     8522     end.
     8523   end procedure.
     8524   procedure waitfram-show :
     8525     define input  parameter p-message as character no-undo .
     8526     define variable v-left-margin as integer   no-undo .
     8527     if not session:batch-mode
     8528     then do
     8529     on error undo, return error return-value
     8530     :
     8531       if length(p-message) <= 70 then do:
     8532         assign
     8533           v-left-margin = integer((70 - length(p-message)) / 2)
     8534         .
     8535         assign
     8536           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     8537         .
     8538         assign
     8539           v-waitfram-action01 = " "
     8540           v-waitfram-action02 = " "
     8541                                    + fill(" ", v-left-margin)
     8542                                    + p-message
     8543           v-waitfram-action03 = " "
     8544         .
     8545       end.
     8546       else do:
     8547         define variable vRindex1 as integer no-undo.
     8548         define variable vRindex2 as integer no-undo.
     8549         vRindex1 = r-index(p-message," ",70).
     8550         if vRindex1 = 0
     8551         then
     8552            vRindex1 = 70.
     8553         if length(p-message)  <= vRindex1 + 70 then do:
     8554           assign
     8555             v-waitfram-action01 = " "
     8556             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     8557             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     8558           .
     8559         end.
     8560         else do:
     8561           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     8562           if vRindex2 <= vRindex1
     8563           then
     8564              vRindex2 = vRindex1 + 70.
     8565           assign
     8566             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     8567             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     8568             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     8569           .
     8570         end.
     8571       end.
     8572       B-viewProcInfo:visible   in frame waitfram = no.
     8573       B-viewProcInfo:sensitive in frame waitfram = no.
     8574       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     8575       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     8576       if  (   mWaitFramView
     8577          or  mWaitProcEvent)
     8578          and not mBatchMode
     8579       then
     8580          display
     8581             v-waitfram-action01 skip
     8582             v-waitfram-action02 skip
     8583             v-waitfram-action03 skip
     8584          with frame waitfram .
     8585       if     mWaitFramView
     8586          then do:
     8587             if     mWaitFramInterval ne ?
     8588                and not mBatchMode
     8589             then
     8590                wait-for go of frame waitfram pause mWaitFramInterval.
     8591          end.
     8592          else
     8593             if     mWaitProcEvent
     8594                and not mBatchMode
     8595             then
     8596                process events .
     8597     end.
     8598   end procedure.
     8599      procedure waitfram-show-this:
     8600         define input  parameter iInterval as int64 no-undo.
     8601         define variable vtime as int64 no-undo.
     8602         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     8603         mWaitFramInterval = iInterval.
     8604         run waitfram-show (substitute("&1&2 &3&4" ,
     8605                                       mWaitFramTextBeg ,
     8606                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     8607                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     8608                                       mWaitFramTextEnd
     8609                                      )
     8610                           ).
     8611      end.
     8612      procedure WaitFramRunPause:
     8613         define input  parameter iInterval as dec no-undo.
     8614         define variable vStart  as datetime-tz no-undo.
     8615         define variable vend    as datetime-tz no-undo.
     8616         define variable vint as int64 no-undo.
     8617         define variable vOk as logical no-undo.
     8618         vStart = now.
     8619         vend   = vStart.
     8620         publish "WaitFramPause" (iInterval,output vOk).
     8621         vend   =  now.
     8622         vint = vend - vStart.
     8623         vint = iInterval - vint / 1000.
     8624         if     not mWaitFramStop
     8625            and (   vint > 0
     8626                 or (    not vOk
     8627                     and iInterval eq ?
     8628                     )
     8629                 )
     8630         then
     8631            run waitfram-show-this (iInterval).
     8632         vend   =  now.
     8633         vint = vend - vStart.
     8634         vint = iInterval - vint / 1000.
     8635         if     not mWaitFramStop
     8636            and vint > 0
     8637         then do:
     8638            run gbl/pause.p (vint * 1000).
     8639         end.
     8640         if iInterval ne ?
     8641         then
     8642            publish "WaitFramStop".
     8643         waitfram-check-timeout().
     8644      end.
     8645      procedure WaitFramWaitFor:
     8646         define input  parameter iInterval as dec no-undo.
     8647         assign
     8648            mWaitFramStartProc   = now
     8649            mWaitFramStopUser    = no
     8650            mWaitFramStopTimeOut = no
     8651         .
     8652         block-wait:
     8653         do while not mWaitFramStop:
     8654            run WaitFramRunPause (iInterval).
     8655            if  waitfram-check-timeout()
     8656            then do:
     8657               leave block-wait.
     8658            end.
     8659         end.
     8660         run waitfram-hide.
     8661      end.
     8662   procedure waitfram-join :
     8663     define input  parameter p-line-1  as character no-undo .
     8664     define input  parameter p-line-2  as character no-undo .
     8665     define input  parameter p-line-3  as character no-undo .
     8666     define output parameter p-message as character no-undo .
     8667     do
     8668     on error undo, return error return-value
     8669     :
     8670       assign
     8671         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     8672                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     8673                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     8674       .
     8675     end.
     8676   end procedure.
     8677   function waitfram-join-function returns character
     8678     (input p-line-1 as character
     8679     ,input p-line-2 as character
     8680     ,input p-line-3 as character
     8681     ).
     8682     define variable v-message as character no-undo .
     8683     run waitfram-join in this-procedure
     8684       (input  p-line-1
     8685       ,input  p-line-2
     8686       ,input  p-line-3
     8687       ,output v-message
     8688       ) .
     8689     return v-message .
     8690   end function .
     8691   define variable mHSocket       as handle      no-undo.
     8692   define variable mWebRespHead   as longchar    no-undo.
     8693   define variable mWebResp       as longchar    no-undo.
     8694   define variable mWebRespMptr   as memptr      no-undo.
     8695   define variable OerrMsg        as character   no-undo.
     8696   define variable mFileLogSocet  as character   no-undo.
     8697   define variable mReturnHttp    as logical     no-undo.
     8698   define variable mAddTimeOut    as logical     no-undo init yes.
     8699   define variable mSocetBegTime  as datetime-tz no-undo.
     8700   define variable mSocetEndTime  as dec         no-undo.
     8701   define variable mWriteRespFile as character   no-undo.
     8702   define variable mTypeResponse  as character   no-undo init "POST".
     8703   publish "getSocetLog" (output mFileLogSocet).
     8704   if
     8705      (   mFileLogSocet eq ""
     8706       or mFileLogSocet eq ?)
     8707      and session:debug-alert
     8708   then
     8709      mFileLogSocet = "socet.log".
     8710   procedure ConectSocet:
     8711      define input  parameter iHost       as character no-undo.
     8712      define input  parameter iPort       as character no-undo.
     8713      define input  parameter iUrl        as character no-undo.
     8714      define input  parameter iPostData   as longchar  no-undo.
     8715      define input  parameter iReturnType as character no-undo.
     8716      define input  parameter iTimeOut    as decimal   no-undo.
     8717      define input  parameter iSilent     as logical   no-undo.
     8718      define input  parameter iTextWait   as character no-undo.
     8719      mWaitFramTextBeg = iTextWait.
     8720      run SendReqSocet (iHost, iPort, iUrl, iPostData, iReturnType, 'getResponse').
     8721      if OerrMsg eq ""
     8722      then
     8723         run waitrespsocet (iTimeOut, iSilent, iTextWait).
     8724      mSocetEndTime = (now - mSocetBegTime) / 1000.
     8725   end.
     8726   procedure SendReqSocet:
     8727      define input  parameter iHost            as character no-undo.
     8728      define input  parameter iPort            as character no-undo.
     8729      define input  parameter iUrl             as character no-undo.
     8730      define input  parameter iPostData        as longchar  no-undo.
     8731      define input  parameter iReturnType      as character no-undo.
     8732      define input  parameter iProcGetResponse as character no-undo.
     8733      mSocetBegTime = now.
     8734      run writeLogSocet in this-procedure (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     8735      assign
     8736         mWebResp         = ""
     8737         mWebResphead     = ""
     8738         OerrMsg          = ""
     8739         mReturnHttp      = iReturnType eq "xml" or iReturnType eq "http" or iReturnType eq "yes"
     8740         iProcGetResponse = "getResponse"  when iProcGetResponse eq ? or iProcGetResponse eq ""
     8741      .
     8742      define variable vPostData as longchar                       no-undo.
     8743      if    iHost eq ""
     8744         or iHost eq ?
     8745      then do:
     8746         oErrMsg = substitute("Не задан host &1 или port &2.", ihost ,iport).
     8747         run writeLogSocet in this-procedure (oErrMsg).
     8748         return oErrMsg.
     8749      end.
     8750      run waitfram-show (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     8751      create socket mHSocket.
     8752      mHSocket:connect('-H ' + iHost + ' -S ' + iPort) no-error.
     8753      if mHSocket:connected() = false
     8754      then do:
     8755         run waitfram-hide .
     8756         oErrMsg = substitute( "Не удалось установить соединение: &1" , error-status:get-message(1)).
     8757         run writeLogSocet in this-procedure (oErrMsg).
     8758         delete object mHSocket.
     8759         return oErrMsg.
     8760      end.
     8761      run waitfram-show ("Отправка данных").
     8762      mHSocket:set-read-response-procedure(iProcGetResponse).
     8763      run PostRequest (
     8764       input iUrl,
     8765       input iHost + ":" + iPort,
     8766       input iPostData
     8767       ).
     8768       run waitfram-hide .
     8769   end.
     8770   procedure WaitRespSocet:
     8771      define input  parameter iTimeOut   as decimal   no-undo.
     8772      define input  parameter iSilent    as logical   no-undo.
     8773      define input  parameter iTextWait  as character no-undo.
     8774      if    not valid-handle (mHSocket )
     8775      then do:
     8776         run writeLogSocet in this-procedure (substitute("Потерян объект соединения")).
     8777         return "End connected".
     8778      end.
     8779      if mHSocket:connected() = false
     8780      then do:
     8781         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespSocet")).
     8782         oErrMsg = "Not connected".
     8783         return oErrMsg.
     8784      end.
     8785      mWaitFramView = if iSilent ne yes then yes else no.
     8786      mWaitFramTextBeg = iTextWait.
     8787      mWaitFramTimeOut = iTimeOut.
     8788      mWaitFramTextEnd = "".
     8789      mWaitFramStop = no.
     8790      if mAddTimeOut
     8791      then do:
     8792         mWaitFramTimeOut = 300.
     8793         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при уcтановке соодинения",mWaitFramTimeOut)).
     8794      end.
     8795      run writeLogSocet in this-procedure (substitute("Ожидаем ответ TimeOut &1 сек.",iTimeOut )).
     8796      subscribe   to "WaitFramStop" anywhere run-procedure "WaitRespTestStop".
     8797      run WaitFramWaitFor(1).
     8798      unsubscribe "WaitFramStop".
     8799      if mWaitFramStopUser
     8800      then do:
     8801         OerrMsg = substitute("Операция прервана пользователем." ).
     8802         run writeLogSocet in this-procedure (OerrMsg).
     8803      end.
     8804      else if mWaitFramStopTimeOut
     8805      then do:
     8806         OerrMsg = substitute("Привышено время ожидания &1 сек. Ответ не получен.",iTimeOut ).
     8807         run writeLogSocet in this-procedure (OerrMsg).
     8808      end.
     8809      run waitfram-hide .
     8810      mHSocket:disconnect() no-error.
     8811      delete object mHSocket.
     8812   end.
     8813   procedure WaitRespTestStop:
     8814      if mWaitFramStopTimeOut
     8815      then
     8816         return.
     8817      if     (mWebResp ne ""
     8818          and mWebResp ne ?)
     8819      then do:
     8820         mWaitFramStop = yes.
     8821         return.
     8822      end.
     8823      else if mHSocket:connected() = false
     8824      then do:
     8825         mWaitFramStop = yes.
     8826         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespTestStop")).
     8827         oErrMsg = "Not connected".
     8828         return oErrMsg.
     8829      end.
     8830      wait-for read-response of mHSocket pause 0.001.
     8831   end.
     8832   procedure PostRequest:
     8833      define input parameter iPostUrl  as char.
     8834      define input parameter iPostHost as char.
     8835      define input parameter iPostData as longchar.
     8836      define variable vCRequest      as longchar.
     8837      define variable vMRequest       as memptr.
     8838      if iPostUrl ne ?
     8839      then do:
     8840         vCRequest =substitute(
     8841         '&5 /&2 HTTP/1.1&1'                                   +
     8842         'Host: &4&1'                                           +
     8843         'User-Agent: Apache-HttpClient/4.1.1 (java 1.5)&1'    +
     8844         'Accept: */*&1' +
     8845         'Content-Type: text/xml&1'               +
     8846         'Content-Length: &3&1'                                  +
     8847         '&1'
     8848         ,
     8849         chr(13) + chr(10),
     8850         iPostUrl,
     8851         length(iPostData),
     8852         iPostHost,
     8853         mTypeResponse) + iPostData.
     8854      end.
     8855      else
     8856         vCRequest = iPostData.
     8857      run writeLogSocet in this-procedure (substitute("Отправляем запрос &1.",chr(13) + chr(10) )).
     8858      run writeLogSocet in this-procedure (vCRequest).
     8859      SET-SIZE(vMRequest)            = 0.
     8860      SET-SIZE(vMRequest)            = length(vCRequest) + 1.
     8861      SET-BYTE-ORDER(vMRequest)      = big-endian.
     8862      PUT-STRING(vMRequest,1)        = vCRequest .
     8863      if mHSocket:connected() = false then
     8864      do:
     8865         run writeLogSocet in this-procedure ("Соединение было разорвано другой стороной getResponse").
     8866         oErrMsg = "Not connected".
     8867         delete object mHSocket no-error.
     8868         return oErrMsg.
     8869      end.
     8870      mHSocket:write(vMRequest, 1, length(vCRequest)).
     8871      run writeLogSocet in this-procedure ("Запрос отправлен.").
     8872   end procedure.
     8873   function hex-to-int returns integer (
     8874     input p-hex-code  as character  ).
     8875     define variable v-int-code as integer   no-undo .
     8876     define variable v-ind      as integer   no-undo .
     8877     define variable v-digit    as integer   no-undo .
     8878     define variable v-letter   as character no-undo .
     8879     do v-ind = 1 to length(p-hex-code)
     8880     :
     8881       assign
     8882         v-letter = caps(substring(p-hex-code, v-ind, 1))
     8883       .
     8884       assign
     8885         v-digit = index('123456789ABCDEF':u, v-letter)
     8886       .
     8887       assign
     8888         v-int-code = v-int-code * 16 + v-digit
     8889       .
     8890     end.
     8891     return v-int-code .
     8892   end function .
     8893   procedure getResponse:
     8894      define variable vFlagTag     as logical          no-undo init no.
     8895      define variable vResponse    as memptr           no-undo.
     8896      define variable vCnt         as int64            no-undo.
     8897      define variable vMessage     as longchar         no-undo.
     8898      define variable v-cont-length as int64 no-undo.
     8899      define variable vi           as integer no-undo.
     8900      define variable v-hd-line    as character no-undo.
     8901      define variable level        as integer no-undo initial 2.
     8902      repeat while program-name(level) <> ?:
     8903        if program-name(level) = program-name(1) then do:
     8904          run writeLogSocet in this-procedure (substitute("Повторный вызов getResponse.")).
     8905          return "".
     8906        end.
     8907        level = level + 1.
     8908      end.
     8909      if mHSocket:connected() = false then
     8910      do:
     8911         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной getResponse")).
     8912         oErrMsg = "Not connected".
     8913         return oErrMsg.
     8914      end.
     8915      if mAddTimeOut
     8916      then do:
     8917         mWaitFramTimeOut = 1000.
     8918         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при получении ответа",mWaitFramTimeOut)).
     8919      end.
     8920      run writeLogSocet in this-procedure (substitute("Получаем ответ")).
     8921      mWaitFramTextEnd = "Получаем ответ".
     8922      define variable vWaitProcEvent as logical no-undo.
     8923      vWaitProcEvent = mWaitProcEvent.
     8924      mWaitProcEvent = no.
     8925      run WaitFramRunPause (?).
     8926      define variable vByte as int64 no-undo.
     8927      define variable vNextMese as int64 no-undo init 100000.
     8928      define variable VFlag as logical no-undo init ? .
     8929      mWaitFramStop = no.
     8930      mWaitFramStopTimeOut = no.
     8931      block-wait:
     8932      do while mHSocket:get-bytes-available() > 0:
     8933         VFlag = no.
     8934         define variable vNumByte as integer no-undo.
     8935         vNumByte =   mHSocket:get-bytes-available().
     8936         if vNumByte > 30000 then vNumByte = 30000.
     8937         SET-SIZE(vResponse) = vNumByte + 1.
     8938         SET-BYTE-ORDER(vResponse) = big-endian.
     8939         mHSocket:read(vResponse,1,vNumByte).
     8940         vMessage = vMessage + GET-STRING(vResponse,1).
     8941         if  mReturnHTTp
     8942         then do:
     8943            vCnt = index(vMessage,chr(13) + chr(10) + chr(13) + chr(10)).
     8944            if vCnt > 0
     8945            then do:
     8946               mReturnHttp = no.
     8947               mWebResphead = substring (vMessage,1,vCnt).
     8948               vMessage     = substring (vMessage,vCnt + 4).
     8949               mWebResphead = replace (mWebResphead,";",chr(13) + chr(10)).
     8950               do vi = 1 to num-entries(mWebResphead,chr(13) + chr(10)):
     8951                  v-hd-line = trim(entry(vi,mWebResphead,chr(13) + chr(10))).
     8952                  if  v-hd-line  begins "Content-Length"  then  do:
     8953                     v-cont-length = INT(trim(substring(v-hd-line,16,length(v-hd-line)))).
     8954                  end.
     8955                  else if v-hd-line  begins "Transfer-Encoding"
     8956                  then do :
     8957                     define variable vChunked as logical no-undo.
     8958                     vchunked = index(v-hd-line,"chunked",19) > 0.
     8959                  end.
     8960               end.
     8961            end.
     8962         end.
     8963         vByte = vByte + vNumByte.
     8964         SET-SIZE(vResponse) = 0.
     8965         if v-cont-length > 0 and length (vMessage) >= v-cont-length
     8966         then
     8967            leave block-wait.
     8968         if not mHSocket:get-bytes-available() > 0
     8969         then do:
     8970            VFlag = yes.
     8971            run WaitFramRunPause (?).
     8972            run gbl/pause.p (1000) .
     8973         end.
     8974         else if vByte > vNextMese
     8975         then do:
     8976            vNextMese = vNextMese + 100000.
     8977            mWaitFramTextEnd = substitute ("Получаем ответ прочитано &1 байт ",vByte) .
     8978            run WaitFramRunPause (?).
     8979         end.
     8980         if mWaitFramStopTimeOut
     8981         then do:
     8982            mWebResp = "".
     8983            leave block-wait.
     8984         end.
     8985      end.
     8986      if VFlag ne false
     8987      then
     8988         run writeLogSocet in this-procedure (substitute ("Завершена обработка &1",If VFlag eq  yes then " 0 байт за последнию секунду" else " пустой ответ(((")).
     8989      mWaitFramStop = yes.
     8990      run writeLogSocet         in this-procedure ("Получен ответ").
     8991      run writeLogSocetOnlyText in this-procedure (mWebResphead).
     8992      run writeLogSocetOnlyText in this-procedure (substitute("&1&2&1&2",chr(13) , chr(10) )).
     8993      run writeLogSocetOnlyText in this-procedure (vMessage).
     8994      run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     8995      mHSocket:disconnect() no-error.
     8996      if v-cont-length > 0
     8997      then
     8998         mWebResp = substring (vMessage,1,v-cont-length).
     8999      else if vChunked
     9000      then do:
     9001         define variable vByteCopy as int64 no-undo init 1.
     9002         Block-Copy:
     9003         do while length(vMessage) > 0:
     9004            vByteCopy = 1.
     9005            vCnt = index (vMessage,chr(13) + chr(10)) - 1.
     9006            vByteCopy = vByteCopy +  vCnt + 2.
     9007            v-cont-length = hex-to-int(string(substring (vMessage,1,vCnt))).
     9008            if v-cont-length eq 0
     9009            then
     9010               leave Block-copy.
     9011            mWebResp = mWebResp + substring (vMessage,vByteCopy,  v-cont-length).
     9012            vByteCopy = vByteCopy + v-cont-length + 2.
     9013            vMessage = substring  (vMessage,vByteCopy).
     9014         end.
     9015         run writeLogSocet         in this-procedure ("Заголовок").
     9016         run writeLogSocetOnlyText in this-procedure (mWebResphead).
     9017         run writeLogSocet         in this-procedure ("Тело ответа").
     9018         run writeLogSocetOnlyText in this-procedure (mWebResp).
     9019        run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     9020      end.
     9021      else
     9022         mWebResp = vMessage.
     9023      mWaitProcEvent = vWaitProcEvent.
     9024      mSocetEndTime = (now - mSocetBegTime) / 1000.
     9025      copy-lob mWebResp to mWebRespMptr.
     9026      if     mWriteRespFile ne ""
     9027         and mWriteRespFile ne ?
     9028      then
     9029           run gbl/fileapnd.p
     9030                ( mWriteRespFile
     9031                , mWebResp + chr(13) + chr(10)
     9032                ,input 10
     9033                ) no-error .
     9034   end procedure.
     9035   procedure writeLogSocet:
     9036      define input  parameter itext as longchar no-undo.
     9037      if mFileLogSocet eq "Async"
     9038      then
     9039         run PutMesAsunc(itext).
     9040      else if     mFileLogSocet ne ?
     9041              and mFileLogSocet ne ""
     9042      then do:
     9043         run gbl/fileapnd.p
     9044             ( mFileLogSocet
     9045             , substitute("&1 &2 ", string(today), string(time, "HH:MM:SS"))
     9046             ,input 10
     9047             ) no-error .
     9048         run writeLogSocetOnlyText(itext).
     9049         run gbl/fileapnd.p
     9050             ( mFileLogSocet
     9051             , substitute(" &1&2", chr(13) , chr(10))
     9052             ,input 10
     9053             ) no-error .
     9054      end.
     9055   end.
     9056   procedure writeLogSocetOnlyText:
     9057      define input  parameter itext as longchar no-undo.
     9058      if mFileLogSocet eq "Async"
     9059      then
     9060         run PutMesAsunc(itext).
     9061      else if     mFileLogSocet ne ?
     9062              and mFileLogSocet ne ""
     9063      then do:
     9064         if length(itext) > 32000
     9065         then
     9066            copy-lob
     9067      from object itext
     9068      to file mFileLogSocet append
     9069      no-error
     9070      .
     9071         else
     9072         run gbl/fileapnd.p
     9073             ( mFileLogSocet
     9074             , string(itext)
     9075             ,input 10
     9076             ) no-error .
     9077      end.
     9078   end.
     9079   procedure Disconect:
     9080      mHSocket:disconnect() no-error.
     9081      delete object mHSocket no-error.
     9082   end.
     9083   procedure getpump:
     9084      define input  parameter ilogfile    as character no-undo.
     9085      define input  parameter iobjtype    as character no-undo.
     9086      define input  parameter iobjcode    as integer no-undo.
     9087      define input  parameter imessageon  as logical no-undo.
     9088      define input  parameter inowaitfram as logical no-undo.
     9089      define output parameter Opump       as longchar no-undo.
     9090      define variable vadr as character no-undo.
     9091      define variable vport as character no-undo.
     9092      define variable vtext as character no-undo.
     9093      define variable old-BM as logical no-undo .
     9094      old-BM = mBatchMode .
     9095         vport = "4000".
     9096      define variable vFlag   as logical no-undo.
     9097      define variable vFlagOk as logical no-undo.
     9098      mFileLogSocet = ilogfile.
     9099       define variable vuser as character no-undo.
     9100       define variable vuserobj as ibs.th.file.asyncparam no-undo.
     9101       define variable vPassobj as ibs.th.file.asyncparam no-undo.
     9102       define buffer buf_cash-desk for ub.cash-desk .
     9103       vuserobj =  new ibs.th.file.asyncparam("user").
     9104       vpassobj =  new ibs.th.file.asyncparam("pass").
     9105       run utl/getuserpwdauto.p(input vuserobj, input vpassobj) no-error.
     9106       if not error-status:error
     9107       then do:
     9108          vuser =  vuserobj:valueParam.
     9109       end.
     9110       else do:
     9111          run utl/getuserpwd.p(input vuserobj, input vpassobj) no-error.
     9112          if not error-status:error
     9113          then do:
     9114             vuser =  vuserobj:valueParam.
     9115          end.
     9116       end.
     9117       delete object vuserobj.
     9118       delete object vpassobj.
     9119      define variable vnoActivCash as logical no-undo.
     9120      block-cash:
     9121      for each buf_cash-desk  where buf_cash-desk.db-num   = g#db-num
     9122                                and buf_cash-desk.obj-code = iobjcode
     9123                                and buf_cash-desk.is-del = no
     9124      no-lock
     9125      by buf_cash-desk.db-num
     9126      by buf_cash-desk.is-del
     9127      by buf_cash-desk.cash-on descending
     9128      by buf_cash-desk.pos-type descending
     9129      by buf_cash-desk.cash-num
     9130         :
     9131         if     not vnoActivCash
     9132            and not buf_cash-desk.cash-on
     9133         then do:
     9134            vnoActivCash = yes.
     9135            run gbl/fileapnd.p
     9136             ( ilogfile
     9137             , substitute("&1 &2 Нет включенных касс переходим к выключенным пользователь &3 &4", string(today),string(time, "HH:MM:SS"),vuser,chr(13) + chr(10))
     9138             ,input 10
     9139             ) no-error .
     9140         end.
     9141         vadr = entry(1,
     9142                      (if num-entries(buf_cash-desk.addr-path, chr(4)) > 1
     9143                       then  entry(2, buf_cash-desk.addr-path, chr(4))
     9144                       else buf_cash-desk.addr-path
     9145                       )
     9146                     ,":").
     9147         if vadr eq ""
     9148         then
     9149            next block-cash.
     9150         vFlag = yes.
     9151         run gbl/fileapnd.p
     9152             ( ilogfile
     9153             , substitute("&1 &2 Отправка команды &3 на кассу № &4 (&5:&6) Пользователь &7 &8", string(today),string(time, "HH:MM:SS"),"pumpread",cash-desk.cash-num,vadr,vport ,vuser,chr(13) + chr(10))
     9154             ,input 10
     9155             ) no-error .
     9156         if inowaitfram
     9157         then do :
     9158           mBatchMode = yes .
     9159         end .
     9160         run ConectSocet (vadr,
     9161                          vport,
     9162                          ?,
     9163                          "pumpread" + chr(13) + chr(10),
     9164                          "text",
     9165                          30,
     9166                          yes ,
     9167                          "Получение данных по ТРК. ") no-error.
     9168         if     not error-status:error
     9169            and length(mWebResp) > 0
     9170            and index(mWebResp," PUMP=") > 0
     9171         then do:
     9172            run gbl/fileapnd.p
     9173             ( ilogfile
     9174             , substitute("&1 &2 Ответ:&4&3&4", string(today),string(time, "HH:MM:SS"),mWebResp ,chr(13) + chr(10))
     9175             ,input 10
     9176             ) no-error .
     9177            vFlagOk = yes.
     9178            leave block-cash.
     9179         end.
     9180         else
     9181            run gbl/fileapnd.p
     9182             ( ilogfile
     9183             , substitute('&1 &2 Результат: &3 "&4" &5', string(today),string(time, "HH:MM:SS"),OerrMsg,mWebResp ,chr(13) + chr(10))
     9184             ,input 10
     9185             ) no-error .
     9186      end.
     9187      mBatchMode = old-BM .
     9188      mFileLogSocet = "".
     9189      if not vFlag
     9190      then do:
     9191         vtext = substitute("Нет включеных касс по БД &1 Объект &2&3 &4 ", g#db-num, "маг", iobjcode ,chr(13) + chr(10)).
     9192         run gbl/fileapnd.p
     9193             ( ilogfile
     9194             , substitute("&1 &2 &3", string(today),string(time, "HH:MM:SS"),vtext)
     9195             ,input 10
     9196             ) no-error .
     9197         return error vtext.
     9198      end.
     9199      else if not vFlagOk
     9200      then
     9201         return error "На момент приема данных по счетчикам ТРК нет связи ни с одной из касс.".
     9202      else
     9203         Opump = mWebResp.
     9204   end.
     9205   procedure lib-rvs_anls-pmp :
     9206     define input        parameter           p-parent-proc       as   widget-handle       no-undo.
