     6304   FIND FIRST tt-meas-file WHERE tt-meas-file.pl-code =  tt-meas.pl-code NO-LOCK NO-ERROR.
     6305   IF available tt-meas-file
     6306   THEN DO:
     6307     RUN gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", NO, OUTPUT rdc-dnstvalue, OUTPUT rdc-dnsttype) NO-ERROR.
     6308     IF rdc-dnstvalue = "pomi-rn"
     6309     and bf_rvs-line.state-level-total > 0
     6310     then do :
     6311       _trpomi :
     6312       do on error undo, return error :
     6313         do ii = 1 to num-entries('place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u,','):
     6314           v-code = entry(ii,'place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u) .
     6315           run placelib_get-attr  ( input v-code
     6316                                   ,input p-obj-code
     6317                                   ,input p-obj-type
     6318                                   ,input p-pl-code
     6319                                   ,output v-value
     6320                                   ,output v-ok      ) no-error.
     6321           case v-code :
     6322             when "place-type" then do :
     6323               if v-ok then place-type = integer(v-value) .
     6324             end.
     6325             when "place-SI" then do :
     6326               if v-ok then place-si = integer(v-value) .
     6327             end.
     6328             when "place-diameter" then do :
     6329               if v-ok then place-diameter = decimal(v-value) .
     6330             end.
     6331             when "dens-prov" then do :
     6332               if v-ok then dens-prov = decimal(v-value) .
     6333             end.
     6334             when "place-dead-high" then do :
     6335               if v-ok then DeadZone_Reservoir = decimal(v-value) .
     6336             end.
     6337             when "place-rvd-dnsty" then do :
     6338               if v-ok then pl-rvd-dens = logical(v-value) .
     6339             end.
     6340             when "place-rvd-lvl" then do :
     6341               if v-ok then pl-rvd-lvl = logical(v-value) .
     6342             end.
     6343             when "place-rvd-tmp" then do :
     6344               if v-ok then pl-rvd-temp = logical(v-value) .
     6345             end.
     6346             when "place-SI-temp" then do :
     6347               if v-ok then pl-temp-sr-izm = integer(v-value) .
     6348             end.
     6349             when "place-SI-dens" then do :
     6350               if v-ok then pl-dens-sr-izm = integer(v-value) .
     6351             end.
     6352             when "place-SI-level" then do :
     6353               if v-ok then pl-level-sr-izm = integer(v-value) .
     6354             end.
     6355             when "place-ponton" then do :
     6356               if v-ok then place-ponton = logical(v-value) .
     6357             end.
     6358             when "place-ponton-mass" then do :
     6359               if v-ok then place-ponton-mass = decimal(v-value) .
     6360             end.
     6361             when "place-ponton-height" then do :
     6362               if v-ok then place-ponton-height = decimal(v-value) .
     6363             end.
     6364           end case.
     6365         end.
     6366         if bf_rvs-line.state-temperature = ?
     6367         then do :
     6368           find first bf_goods no-lock where bf_goods.gds-code = bf_rvs-line.gds-code no-error .
     6369           find first bf_place no-lock where bf_place.pl-code = bf_rvs-line.pl-code no-error .
     6370           undo _trpomi, return error substitute( 'Для резервуара &1 (&2 &3) не определено значение температуры для передачи в библиотеку ПОкМИ. Создание сверки не возможно.'
     6371                                                ,(if available bf_place then bf_place.loc1 else "?")
     6372                                                ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     6373                                                ,(if available bf_goods then bf_goods.gds-name else "?") ) .
     6374         end .
     6375         if is-sug(bf_rvs-line.gds-code)
