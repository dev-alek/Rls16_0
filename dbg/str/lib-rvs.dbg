     9208     define input        parameter           p-obj-code          like ub.rvs-doc.obj-code no-undo.
     9209     define input        parameter           p-check-goods       as   logical             no-undo.
     9210     define input-output parameter table for tt-pump-nozzle-file.
     9211     define input-output parameter table for tt-pump-nozzle.
