      936   procedure placelib_write-attr:
      937   define input  parameter p-code     like ub.place-attr.attr-code .
      938   define input  parameter p-obj-code like ub.place-attr.obj-code .
      939   define input  parameter p-obj-type like ub.place-attr.obj-type .
      940   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      941   define input  parameter p-value    like ub.place-attr.attr-value .
      942   define output parameter p-ok       as logical.
      943   define buffer buf_place-attr for ub.place-attr .
      944     do on error undo, return error return-value :
      945        p-ok = false.
      946        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      947                                                   and buf_place-attr.obj-code    = p-obj-code
      948                                                   and buf_place-attr.obj-type    = p-obj-type
      949                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      950        if not available buf_place-attr then do :
      951           create buf_place-attr.
      952           assign
      953             buf_place-attr.attr-code   = p-code
      954             buf_place-attr.attr-value  = p-value
      955             buf_place-attr.obj-code    = p-obj-code
      956             buf_place-attr.obj-type    = p-obj-type
      957             buf_place-attr.pl-code     = p-pl-code
      958           .
      959           p-ok = true.
      960        end.
      961        else do:
      962           buf_place-attr.attr-value  = p-value .
      963           p-ok = true.
      964        end.
      965     end.
      966   end.
      967   procedure placelib_get-attr:
      968   define input  parameter  p-code     like ub.place-attr.attr-code .
      969   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      970   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      971   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      972   define output parameter  p-value    like ub.place-attr.attr-value .
      973   define output parameter  p-ok       as logical.
      974   define buffer buf_place-attr for ub.place-attr .
      975     do on error undo, return error return-value :
      976        p-ok = false.
      977        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      978                                                   and buf_place-attr.obj-code    = p-obj-code
      979                                                   and buf_place-attr.obj-type    = p-obj-type
      980                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      981        if available buf_place-attr then do :
      982          p-value = buf_place-attr.attr-value.
      983          p-ok = true.
      984        end.
      985        else do :
      986          p-ok = false.
      987        end.
      988     end.
      989   end.
