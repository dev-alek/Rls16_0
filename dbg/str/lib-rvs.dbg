     5823                              where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5824                                and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5825                                and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5826                                and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5827                                and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5828                                and rvs-line-attr.attr-code = "dens-pf-sug" no-error.
     5829                           if not available rvs-line-attr then do :
     5830                             create rvs-line-attr.
     5831                             assign
     5832                               rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5833                               rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5834                               rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5835                               rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5836                               rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5837                               rvs-line-attr.attr-code = "dens-pf-sug"
     5838                             .
     5839                           end.
     5840                           rvs-line-attr.attr-value = prev_rvs-line-attr.attr-value .
     5841                         end .
     5842                       end .
     5843                       LEAVE prev .
     5844                   END.
     5845               END.
     5846               IF   p-prev-rvs-date = NO THEN
     5847               DO :
     5848                   FIND FIRST crl_prev_rvs-doc NO-LOCK WHERE
     5849                       crl_prev_rvs-doc.rvs-code = p-prev-code NO-ERROR .
     5850                   IF AVAILABLE crl_prev_rvs-doc THEN
