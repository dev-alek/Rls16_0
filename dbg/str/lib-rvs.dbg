     6469                                                     and buf_pl-level-attr.obj-type = full2_pl-level.obj-type
     6470                                                     and buf_pl-level-attr.pl-level = full2_pl-level.pl-level
     6471                                                     and buf_pl-level-attr.attr-code = "tarir-delta"
     6472                                                     :
     6473                 DeltaOtn_K_Full = decimal(buf_pl-level-attr.attr-value) .
     6474               end .
     6475               if DeltaOtn_K_Full > 0 then leave .
     6476             end .
     6477           end .
     6478           if DeltaOtn_K_Full = ?
     6479           or DeltaOtn_K_Full = 0
     6480           then do :
     6481             if place-type = 1
     6482             then DeltaOtn_K_Full = 0.2 .
     6483             else DeltaOtn_K_Full = 0.25 .
     6484           end .
     6485           DeltaVSugFull = ? .
     6486           for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = full_pl-level.pl-code
     6487                                                 and buf_pl-level-attr.obj-code = full_pl-level.obj-code
     6488                                                 and buf_pl-level-attr.obj-type = full_pl-level.obj-type
     6489                                                 and buf_pl-level-attr.pl-level = full_pl-level.pl-level
     6490                                                 and buf_pl-level-attr.attr-code = "deltaV"
     6491                                                 :
     6492             DeltaVSugFull = decimal(buf_pl-level-attr.attr-value) no-error .
     6493           end .
     6494           CalibTable = Substitute("&1=&2", sug1_pl-level.pl-level, (sug1_pl-level.pl-qnty / 1000)) + (if DeltaV1 > 0 then ("=" + trim(string(DeltaV1, ">>9.9999"))) else "") + chr(10) .
     6495           CalibTable = CalibTable + Substitute("&1=&2", sug2_pl-level.pl-level, (sug2_pl-level.pl-qnty / 1000)) + (if DeltaV2 > 0 then ("=" + trim(string(DeltaV2, ">>9.9999"))) else "") + chr(10) .
     6496           CalibTable = CalibTable + Substitute("&1=&2", full_pl-level.pl-level, (full_pl-level.pl-qnty / 1000)) + (if DeltaVSugFull > 0 then ("=" + trim(string(DeltaVSugFull, ">>9.9999"))) else "") .
     6497         end .
     6498         else do :
     6499           if bf_rvs-line.state-level-water > 0
     6500           then do :
