     9227     define variable v_Param       as character no-undo.
     9228     define variable v_String-Tail as character no-undo.
     9229     define variable j_Space       as integer   no-undo.
     9230     define variable j_b-code      like ub.bar-code.b-code        no-undo.
     9231     define variable d_rate        like ub.bar-code.cli-base-rate no-undo.
     9232     define variable conf-par      as   character                 no-undo.
     9233     define variable par-type      as   character                 no-undo.
     9234     define variable v_result      as   character                 no-undo.
     9235     define variable v_type-bc     as   character                 no-undo.
     9236     define variable d_weight      as   decimal                   no-undo.
     9237     define variable v_DirFilePump as   character                 no-undo.
     9238     define variable j_num         as   integer                   no-undo.
     9239     define variable l_log         as   logical                   no-undo.
     9240     define variable v_CommandPump as   character                 no-undo initial ?.
     9241     define variable vPump as longchar no-undo.
     9242     define buffer bf_goods      for ub.goods.
     9243     define buffer bf_goods-file for ub.goods.
     9244     define buffer bf_bar-code   for ub.bar-code.
     9245   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9246   define variable varscales-pref as character no-undo .
     9247   define variable varpgscales-pref as character no-undo .
     9248   define variable varscales-pref-type21 as character no-undo.
     9249   varscales-pref  = ?.
     9250   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     9251     (input  'sclspref':u
     9252     ,input  '':u
     9253     ,input  '':u
     9254     ,input  0
     9255     ,input  '':u
     9256     ,input  '':u
     9257     ,input  '':u
     9258     ,input  no
     9259     ,output varscales-pref
     9260     ,output varscales-pref-type21
     9261     ) no-error .
     9262   if varscales-pref = ? then do:
     9263     assign
     9264     varscales-pref = '21,23,25':U.
     9265   end.
     9266   define variable varpgscales-pref-type21 as character no-undo.
     9267   varpgscales-pref  = ?.
     9268   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     9269     (input  'scpgpref':u
     9270     ,input  '':u
     9271     ,input  '':u
