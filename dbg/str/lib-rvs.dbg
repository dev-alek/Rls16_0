     5788                                and prev_rvs-line-attr.attr-code = "state-dens-pf-sug" no-error .
     5789                         if available prev_rvs-line-attr
     5790                         then do :
     5791                           state-vapor-density = decimal(prev_rvs-line-attr.attr-value) no-error .
     5792                           find first rvs-line-attr exclusive-lock
     5793                              where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5794                                and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5795                                and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5796                                and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5797                                and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5798                                and rvs-line-attr.attr-code = "state-dens-pf-sug" no-error.
     5799                           if not available rvs-line-attr then do :
     5800                             create rvs-line-attr.
     5801                             assign
     5802                               rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5803                               rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5804                               rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5805                               rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5806                               rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5807                               rvs-line-attr.attr-code = "state-dens-pf-sug"
