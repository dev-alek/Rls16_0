     6276               rvs-line-attr.attr-code = "vol-pf-sug"
     6277               rvs-line-attr.attr-value = string(sug-pf-volume)
     6278             .
     6279           end.
     6280           find first rvs-line-attr exclusive-lock
     6281                 where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6282                   and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6283                   and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
