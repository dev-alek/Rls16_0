     1038     do
     1039     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1040     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     1041     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     1042     :
     1043       define variable par-type          as character no-undo.
     1044       define variable v-value-character as character no-undo .
