     1354       if error-status :error
     1355       then do:
     1356         undo, return error return-value .
     1357       end.
     1358     end.
     1359   end procedure.
     1360   procedure db-attr-delete :
     1361     define input  parameter p-db-num   like ub.db-attr.db-num     no-undo .
     1362     define input  parameter p-code     like ub.db-attr.attr-code  no-undo .
     1363     define output parameter p-deleted  as logical no-undo.
     1364     do
     1365     on error undo, return error
     1366     :
     1367           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-delete in g#attr-lib
     1368         (input  p-db-num
     1369         ,input  p-code
     1370         ,output p-deleted
     1371         ) no-error .
     1372       if error-status :error
     1373       then do:
     1374         undo, return error return-value .
     1375       end.
     1376     end.
