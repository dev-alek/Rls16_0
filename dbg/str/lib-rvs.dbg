     5751                                  where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5752                                    and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5753                                    and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5754                                    and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5755                                    and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5756                                    and rvs-line-attr.attr-code = "mi-tmp" no-error.
     5757                               if not available rvs-line-attr then do :
     5758                                 create rvs-line-attr.
     5759                                 assign
     5760                                   rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5761                                   rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5762                                   rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5763                                   rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5764                                   rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5765                                   rvs-line-attr.attr-code = "mi-tmp"
     5766                                 .
     5767                               end.
     5768                               rvs-line-attr.attr-value = prev_rvs-line-attr.attr-value .
     5769                             end .
     5770                           end .
     5771                       end.
     5772                       if bf_rvs-line.temperature = ? then
     5773                       do:
     5774                           bf_rvs-line.temperature  = prev_rvs-line.temperature.
     5775                       end.
     5776                       if bf_rvs-line.temperature = ? then
     5777                       do:
     5778                           bf_rvs-line.temperature  = bf_rvs-line.state-temperature.
     5779                       end.
     5780                       if vapor-density = ? or vapor-density = 0 or vapor-density > 1
     5781                       then do :
     5782                         find first prev_rvs-line-attr no-lock
     5783                              where prev_rvs-line-attr.obj-code  = prev_rvs-line.obj-code
     5784                                and prev_rvs-line-attr.obj-type  = prev_rvs-line.obj-type
     5785                                and prev_rvs-line-attr.gds-code  = prev_rvs-line.gds-code
