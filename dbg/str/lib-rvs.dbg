     6388                                                  ,(if available bf_place then bf_place.loc1 else "?")
     6389                                                  ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     6390                                                  ,(if available bf_goods then bf_goods.gds-name else "?") ) .
     6391           end .
     6392           DeltaOtn_K = ? .
     6393           for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = sug1_pl-level.pl-code
     6394                                                 and buf_pl-level-attr.obj-code = sug1_pl-level.obj-code
     6395                                                 and buf_pl-level-attr.obj-type = sug1_pl-level.obj-type
     6396                                                 and buf_pl-level-attr.pl-level = sug1_pl-level.pl-level
     6397                                                 and buf_pl-level-attr.attr-code = "tarir-delta"
     6398                                                 :
     6399             DeltaOtn_K = decimal(buf_pl-level-attr.attr-value) .
