     6510                                                     and buf_pl-level-attr.obj-code = water1_pl-level.obj-code
     6511                                                     and buf_pl-level-attr.obj-type = water1_pl-level.obj-type
     6512                                                     and buf_pl-level-attr.pl-level = water1_pl-level.pl-level
     6513                                                     and buf_pl-level-attr.attr-code = "deltaV"
     6514                                                     :
     6515                 WaterDeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     6516               end .
     6517             end .
     6518             if available water1_pl-level
     6519             and water1_pl-level.pl-level <> bf_rvs-line.state-level-water
     6520             then do :
