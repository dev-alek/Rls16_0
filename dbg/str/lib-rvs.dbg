     5425                         bf_rvs-line.density                = (((bf_rvs-line.brutto-qnty * bf_rvs-line.density) * bf_rvs-line.density) + ((buf_tt-meas.brutto-qnty * buf_tt-meas.density) * buf_tt-meas.density)) / ((bf_rvs-line.brutto-qnty * bf_rvs-line.density) + (buf_tt-meas.brutto-qnty * buf_tt-meas.density))
