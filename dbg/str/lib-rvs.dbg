      999        p-ok = false.
     1000        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1001                                                   and buf_place-attr.obj-code    = p-obj-code
     1002                                                   and buf_place-attr.obj-type    = p-obj-type
     1003                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1004        if available buf_place-attr then do :
