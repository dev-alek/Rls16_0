     6591                                                 and buf_pl-level-attr.pl-level = total2_pl-level.pl-level
     6592                                                 and buf_pl-level-attr.attr-code = "deltaV"
     6593                                                 :
     6594             DeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
