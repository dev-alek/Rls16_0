     5560     ( input p-obj-type
     5561     , input p-obj-code
     5562     ) .
     5563           IF ptrlprop-olddens = true
     5564           THEN
     5565           DO:
     5566               p-prev-rvs-date = NO.
     5567               FIND FIRST rvs-doc WHERE rvs-doc.rvs-code = bf_rvs-line.rvs-code NO-LOCK NO-ERROR.
     5568               prev: FOR EACH crl_prev_rvs-doc NO-LOCK
     5569                   WHERE crl_prev_rvs-doc.obj-type   = p-obj-type
     5570                   AND crl_prev_rvs-doc.obj-code   = p-obj-code
     5571                   AND crl_prev_rvs-doc.shift-date = rvs-doc.shift-date
     5572                   AND crl_prev_rvs-doc.shift-num  = rvs-doc.shift-num
     5573                   AND crl_prev_rvs-doc.status_    = 'факт':U
     5574                   AND crl_prev_rvs-doc.rvs-type  <> 'проверка':U
     5575                   BY crl_prev_rvs-doc.fact-order DESC
     5576                   ON ERROR UNDO, RETURN ERROR RETURN-VALUE
     5577                   :
     5578                   FIND LAST prev_rvs-line NO-LOCK
     5579                       WHERE prev_rvs-line.rvs-code = crl_prev_rvs-doc.rvs-code
     5580                       AND prev_rvs-line.obj-type = p-obj-type
     5581                       AND prev_rvs-line.obj-code = p-obj-code
     5582                       AND prev_rvs-line.pl-code  =  bf_rvs-line.pl-code
     5583                       AND prev_rvs-line.gds-code = bf_rvs-line.gds-code
     5584                       NO-ERROR .
     5585                   IF AVAILABLE prev_rvs-line THEN
     5586                   DO:
     5587                       v-prev-temp = no .
     5588                       if bf_rvs-line.state-density > 1 or bf_rvs-line.state-density = ? or bf_rvs-line.state-density = 0 then
     5589                       do:
     5590                           if bf_rvs-line.state-temperature <> ?
     5591                           then do :
     5592                             find first rvs-line-attr exclusive-lock
     5593                                where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5594                                  and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5595                                  and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5596                                  and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5597                                  and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5598                                  and rvs-line-attr.attr-code = "temp-izm-vol" no-error.
     5599                             if not available rvs-line-attr then do :
     5600                               create rvs-line-attr.
     5601                               assign
     5602                                 rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5603                                 rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5604                                 rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5605                                 rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5606                                 rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5607                                 rvs-line-attr.attr-code = "temp-izm-vol"
     5608                               .
     5609                             end.
     5610                             rvs-line-attr.attr-value = string(bf_rvs-line.state-temperature) .
     5611                           end .
     5612                           find first prev_rvs-line-attr no-lock
     5613                                where prev_rvs-line-attr.obj-code  = prev_rvs-line.obj-code
     5614                                  and prev_rvs-line-attr.obj-type  = prev_rvs-line.obj-type
     5615                                  and prev_rvs-line-attr.gds-code  = prev_rvs-line.gds-code
     5616                                  and prev_rvs-line-attr.pl-code   = prev_rvs-line.pl-code
     5617                                  and prev_rvs-line-attr.rvs-code  = prev_rvs-line.rvs-code
     5618                                  and prev_rvs-line-attr.attr-code = "mi-dnst" no-error.
     5619                           if available prev_rvs-line-attr
     5620                           then do :
     5621                             find first rvs-line-attr exclusive-lock
     5622                                where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5623                                  and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5624                                  and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5625                                  and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5626                                  and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5627                                  and rvs-line-attr.attr-code = "mi-dnst" no-error.
     5628                             if not available rvs-line-attr then do :
     5629                               create rvs-line-attr.
     5630                               assign
     5631                                 rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5632                                 rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5633                                 rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5634                                 rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5635                                 rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5636                                 rvs-line-attr.attr-code = "mi-dnst"
     5637                               .
     5638                             end.
     5639                             rvs-line-attr.attr-value = prev_rvs-line-attr.attr-value .
     5640                             for first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = integer(prev_rvs-line-attr.attr-value)
     5641                                                                  and buf_sr-izmerenia.sr-type-izm = 1
     5642                                                                  :
     5643                               bf_rvs-line.state-temperature = prev_rvs-line.state-temperature.
     5644                               bf_rvs-line.temperature  = prev_rvs-line.temperature.
     5645                               v-prev-temp = yes .
     5646                             end .
     5647                           end .
     5648                           bf_rvs-line.state-density = prev_rvs-line.state-density .
     5649                           bf_rvs-line.density = prev_rvs-line.density .
     5650                           p-prev-rvs-date = YES.
     5651                           find first prev_rvs-line-attr no-lock
     5652                                where prev_rvs-line-attr.obj-code  = prev_rvs-line.obj-code
     5653                                  and prev_rvs-line-attr.obj-type  = prev_rvs-line.obj-type
     5654                                  and prev_rvs-line-attr.gds-code  = prev_rvs-line.gds-code
     5655                                  and prev_rvs-line-attr.pl-code   = prev_rvs-line.pl-code
     5656                                  and prev_rvs-line-attr.rvs-code  = prev_rvs-line.rvs-code
     5657                                  and prev_rvs-line-attr.attr-code = "izmer-density" no-error.
     5658                           if available prev_rvs-line-attr
     5659                           then do :
     5660                             find first rvs-line-attr exclusive-lock
     5661                                where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5662                                  and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5663                                  and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5664                                  and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5665                                  and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5666                                  and rvs-line-attr.attr-code = "izmer-density" no-error.
     5667                             if not available rvs-line-attr then do :
     5668                               create rvs-line-attr.
     5669                               assign
     5670                                 rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5671                                 rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5672                                 rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5673                                 rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5674                                 rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5675                                 rvs-line-attr.attr-code = "izmer-density"
     5676                               .
     5677                             end.
     5678                             rvs-line-attr.attr-value = prev_rvs-line-attr.attr-value .
     5679                           end .
     5680                           find first rvs-line-attr exclusive-lock
     5681                                where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5682                                  and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5683                                  and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5684                                  and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5685                                  and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5686                                  and rvs-line-attr.attr-code = "is-olddens" no-error.
     5687                           if not available rvs-line-attr then do :
     5688                             create rvs-line-attr.
     5689                             assign
     5690                               rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5691                               rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5692                               rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5693                               rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5694                               rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5695                               rvs-line-attr.attr-code = "is-olddens"
     5696                             .
     5697                           end.
     5698                           rvs-line-attr.attr-value = 'yes' .
     5699                           v-is-olddens = yes .
     5700                       end.
     5701                       if tt-meas.temperature = ?
     5702                       or v-prev-temp
     5703                       then do:
     5704                           if not v-prev-temp
     5705                           then do :
     5706                             bf_rvs-line.state-temperature = prev_rvs-line.state-temperature.
     5707                             bf_rvs-line.temperature  = prev_rvs-line.temperature.
     5708                             p-prev-rvs-date = YES.
     5709                           end .
     5710                           if tt-meas.temperature = ?
     5711                           then do :
     5712                             find first prev_rvs-line-attr no-lock
     5713                                  where prev_rvs-line-attr.obj-code  = prev_rvs-line.obj-code
     5714                                    and prev_rvs-line-attr.obj-type  = prev_rvs-line.obj-type
     5715                                    and prev_rvs-line-attr.gds-code  = prev_rvs-line.gds-code
