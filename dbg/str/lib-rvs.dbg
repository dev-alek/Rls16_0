     2934   function getCalibrationBelt returns character
     2935     (
     2936     input iObjType as character,
     2937     input iObjCode as integer,
     2938     input iPlCode  as integer,
     2939     input iLevelNP as decimal,
     2940     input iLevelWater as decimal
     2941     )
     2942   :
     2943     define variable vCalibBelt      as  character         no-undo.
     2944     define buffer   buf_pl-level-mm for ub.pl-level-mm.
     2945     for each buf_pl-level-mm where
     2946              buf_pl-level-mm.obj-type = iObjType
     2947          and buf_pl-level-mm.obj-code = iObjCode
     2948          and buf_pl-level-mm.pl-code  = iPlCode
     2949          and ((buf_pl-level-mm.min-level <= iLevelNP and buf_pl-level-mm.max-level >= iLevelNP) or
     2950               (buf_pl-level-mm.min-level <= iLevelWater and buf_pl-level-mm.max-level >= iLevelWater))
     2951         no-lock
     2952         break by buf_pl-level-mm.zone by buf_pl-level-mm.level:
     2953       if first-of(buf_pl-level-mm.zone) then do:
     2954         vCalibBelt = substitute("&1&2;&3=",vCalibBelt, buf_pl-level-mm.min-level,buf_pl-level-mm.max-level).
     2955       end.
     2956       vCalibBelt = substitute("&1&2&3",vCalibBelt, if buf_pl-level-mm.level = 1 then "" else ";", trim(string(buf_pl-level-mm.capacity / 1000, ">>>>>9.999"))).
     2957       if last-of(buf_pl-level-mm.zone) and not last(buf_pl-level-mm.zone) then
     2958         vCalibBelt = substitute("&1&2",vCalibBelt, chr(10)).
     2959     end.
     2960     return vCalibBelt.
     2961   end.
     2962   define  shared temp-table tt-susp-chk no-undo like ub.susp-chk .
     2963   define stream str-err.
     2964   define stream str-log.
     2965   define stream outstream.
     2966   define stream sinp .
     2967   define VARIABLE ii as integer no-undo .
     2968       DEFINE VARIABLE rdc-value AS CHARACTER NO-UNDO INITIAL ?.
     2969       DEFINE VARIABLE rdc-type  AS CHARACTER NO-UNDO INITIAL ?.
     2970   if valid-handle( g#lib-rvs ) and
     2971      g#lib-rvs <> this-procedure :handle and
     2972      g#lib-rvs :get-signature( 'lib-rvs_place-sh':U ) <> ''
     2973   then do:
     2974     message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     2975             'Попытка повторной загрузки библиотеки для работы со сверками' skip( 0 )
     2976             g#lib-rvs                      skip( 0 )
     2977             g#lib-rvs      :type           skip( 0 )
     2978             g#lib-rvs      :file-name      skip( 0 )
     2979             valid-handle( g#lib-rvs      ) skip( 0 )
     2980             this-procedure :handle         skip( 0 )
     2981             this-procedure :type           skip( 0 )
     2982             this-procedure :file-name      skip( 0 )
     2983             valid-handle( this-procedure ) skip( 1 )
     2984     view-as alert-box error.
     2985     undo, return error.
     2986   end.
     2987   else do:
     2988     assign
     2989       g#lib-rvs = this-procedure :handle
     2990     .
     2991     def var gbl-hndllibObj as class gbl-hndllib no-undo.
     2992     gbl-hndllibObj = new gbl-hndllib ().
     2993     gbl-hndllibObj:InitHndl("g#lib-rvs", g#lib-rvs).
     2994     delete object gbl-hndllibObj.
     2995   end.
     2996   RUN gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", NO, OUTPUT rdc-value, OUTPUT rdc-type) NO-ERROR.
     2997   if this-procedure :persistent <> yes then do:
     2998     message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     2999             'Ошибка запуска библиотеки' program-name( 1 ) skip( 0 )
     3000             'Попытка запустить ее как обычную процедуру.' skip( 1 )
     3001     view-as alert-box error.
     3002   end.
     3003   on delete of this-procedure do:
     3004     assign
     3005       g#lib-rvs = ?
     3006     .
     3007     def var gbl-hndllibObj as class gbl-hndllib no-undo.
     3008     gbl-hndllibObj = new gbl-hndllib ().
     3009     gbl-hndllibObj:InitHndl("g#lib-rvs", g#lib-rvs).
     3010     delete object gbl-hndllibObj.
     3011   end.
     3012   procedure lib-rvs_place-sh :
     3013     define input parameter p-obj-type   like ub.place.obj-type     no-undo.
     3014     define input parameter p-obj-code   like ub.place.obj-code     no-undo.
     3015     define input parameter p-rvs-code   like ub.rvs-doc.rvs-code   no-undo.
     3016     define input parameter p-rvs-type   like ub.rvs-doc.rvs-type   no-undo.
     3017     define input parameter p-prev-code  like ub.rvs-doc.rvs-code   no-undo.
     3018     define input parameter p-shift-date like ub.rvs-doc.shift-date no-undo.
     3019     define input parameter p-shift-num  like ub.rvs-doc.shift-num  no-undo.
     3020     define input parameter p-rvs-full   like ub.rvs-doc.is-full       no-undo.
     3021     define buffer buf_place  for ub.place.
     3022     define buffer buf_pl-gds for ub.pl-gds.
     3023     define variable v-attr-value    as character no-undo .
     3024     define variable v-attr-type     as character no-undo .
     3025     tr:
     3026     do transaction
     3027     on error  undo tr, return error substitute( "&1 (place-sh). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3028     on stop   undo tr, return error substitute( "&1 (place-sh). stop", vss-workfile )
     3029     on endkey undo tr, return error substitute( "&1 (place-sh). endkey", vss-workfile )
     3030     :
     3031       for each buf_place  no-lock
     3032         where buf_place.obj-type = p-obj-type
     3033           and buf_place.obj-code = p-obj-code
     3034           and buf_place.status_  = ""
     3035         ,each buf_pl-gds no-lock
     3036         where buf_pl-gds.obj-type = buf_place.obj-type
     3037           and buf_pl-gds.obj-code = buf_place.obj-code
     3038           and buf_pl-gds.pl-code  = buf_place.pl-code
     3039       on error undo, return error return-value
     3040       :
     3041         IF CAN-FIND( FIRST doc-attr
     3042         WHERE doc-attr.doc-code  = p-rvs-code
     3043           AND doc-attr.attr-code = "rvs-auto":U
     3044           AND doc-attr.attr-value = "Yes":U and  p-rvs-full = yes and buf_place.is-meas = no
     3045         NO-LOCK)
     3046         THEN next.
     3047         run gds-attr-value in this-procedure
     3048           ( input  buf_pl-gds.gds-code
     3049            ,input  'ptrl-without-rvs':U
     3050            ,output v-attr-value
     3051            ,output v-attr-type
     3052           ) .
     3053         if lookup(v-attr-value, 'true,yes':u) = 0 then do:
     3054   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crrvslin in g#lib-rvs ( input p-obj-type ,
     3055                         input p-obj-code ,
     3056                         input p-rvs-code ,
     3057                         input p-rvs-type ,
     3058                         input buf_pl-gds.pl-code ,
     3059                         input buf_pl-gds.gds-code ,
     3060                         input p-prev-code ,
     3061                         input p-shift-date ,
     3062                         input p-shift-num ) no-error .
     3063           if error-status :error then do:
     3064             undo tr, return error substitute( 'Ошибка из процедуры lib-rvs_crrvslin.&1&2&1&3'
     3065                                             , chr(10)
     3066                                             , error-status :get-message( 1 )
     3067                                             , return-value ) .
     3068           end.
     3069         end.
     3070       end.
     3071     end.
     3072     return .
     3073   end procedure.
     3074   procedure lib-rvs_meas-plc :
     3075     define input        parameter           p-obj-type like ub.place.obj-type no-undo.
     3076     define input        parameter           p-obj-code like ub.place.obj-code no-undo.
     3077     define input-output parameter table for tt-meas.
     3078     define buffer bf_place     for ub.place.
     3079     define buffer bf_place-err for ub.place.
     3080     define buffer bf_goods     for ub.goods.
     3081     for each tt-meas :
     3082       delete tt-meas .
     3083     end.
     3084     for each bf_place no-lock where
     3085              bf_place.obj-type = p-obj-type and
     3086              bf_place.obj-code = p-obj-code and
     3087              bf_place.is-meas  = yes and
     3088              bf_place.status_ = ""
     3089     :
     3090       if trim( bf_place.loc1 ) = '':U or
     3091                bf_place.loc1   = ?
     3092       then do:
     3093         return error substitute( 'В измеряемом резервуаре &1 задан неверный локальный номер "&2".'
     3094                                , bf_place.pl-code
     3095                                , bf_place.loc1 ) .
     3096       end.
     3097       find first bf_place-err no-lock
     3098         where bf_place-err.obj-type =  bf_place.obj-type
     3099           and bf_place-err.obj-code =  bf_place.obj-code
     3100           and bf_place-err.is-meas  =  yes
     3101           and bf_place-err.loc1     =  bf_place.loc1
     3102           and recid( bf_place-err ) <> recid( bf_place )
     3103           and bf_place-err.status_ = ""
     3104         no-error.
     3105       if available bf_place-err then do:
     3106         return error substitute( 'В измеряемом резервуаре &1 задан локальный номер &2, установленный также в резервуаре &3.'
     3107                                , bf_place.pl-code
     3108                                , bf_place.loc1
     3109                                , bf_place-err.pl-code ) .
     3110       end.
     3111       create tt-meas.
     3112       assign
     3113              tt-meas.obj-type = p-obj-type
     3114              tt-meas.obj-code = p-obj-code
     3115              tt-meas.pl-code  = bf_place.pl-code
     3116              tt-meas.loc1 = bf_place.loc1
     3117       .
     3118     end.
     3119     return .
     3120   end procedure.
     3121   procedure lib-rvs_fall-plc :
     3122     define input parameter p-obj-type like ub.rvs-doc.obj-type no-undo.
     3123     define input parameter p-obj-code like ub.rvs-doc.obj-code no-undo.
     3124     define input parameter p-rvs-code like ub.rvs-doc.rvs-code no-undo.
     3125     define input parameter p-is-full  as   logical             no-undo.
     3126     define buffer bf_place  for ub.place.
     3127     define buffer bf_r-line for ub.rvs-line.
     3128     define buffer buf_doc-attr     for ub.doc-attr .
     3129     define variable v-auto    as logical      no-undo.
     3130     IF CAN-FIND( FIRST buf_doc-attr
     3131         WHERE buf_doc-attr.doc-code  = p-rvs-code
     3132           AND buf_doc-attr.attr-code = "rvs-auto":U
     3133           AND buf_doc-attr.attr-value = "Yes":U
     3134         NO-LOCK)
     3135     THEN DO:
     3136        assign
     3137            v-auto = true
     3138        .
     3139     END.
     3140     tr:
     3141     do transaction on error undo, return error
     3142                    on stop  undo, return error
     3143                    on quit  undo, return error :
     3144       for  each bf_r-line where
     3145                 bf_r-line.rvs-code = p-rvs-code and
     3146                 bf_r-line.obj-type = p-obj-type and
     3147                 bf_r-line.obj-code = p-obj-code
     3148         , first bf_place    where
     3149                 bf_place.obj-type = bf_r-line.obj-type and
     3150                 bf_place.obj-code = bf_r-line.obj-code and
     3151                 bf_place.pl-code  = bf_r-line.pl-code and
     3152                 bf_place.status_  = ""
     3153       :
     3154         IF bf_place.is-meas  = yes THEN DO:
     3155         if p-is-full <> yes then do:
     3156           find first tt-meas where
     3157                      tt-meas.obj-type = p-obj-type       and
     3158                      tt-meas.obj-code = p-obj-code       and
     3159                      tt-meas.pl-code  = bf_place.pl-code no-error .
     3160           if not available tt-meas then do:
     3161             next .
     3162           end.
     3163         end.
     3164   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_fill1plc in g#lib-rvs ( input              bf_r-line.obj-type ,
     3165                         input              bf_r-line.obj-code ,
     3166                         input              bf_r-line.pl-code ,
     3167                         input              recid( bf_r-line ) ,
     3168                         input              bf_r-line.rvs-prev-code ,
     3169                         input-output table tt-meas ) no-error .
     3170         if error-status :error then do:
     3171           undo tr, return error substitute( 'Ошибка при заполнении данных.&1&2&1&3'
     3172                                           , chr(10)
     3173                                           , error-status :get-message( 1 )
     3174                                           , return-value ) .
     3175         end.
     3176         END.
     3177         ELSE DO:
     3178            IF v-auto THEN DO:
     3179   define variable vss-include-info8 as character format "X(65)" no-undo
     3180   initial "@(#)$Workfile$ $Revision$".
     3181   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_fill2plc in g#lib-rvs ( input              bf_r-line.obj-type ,
     3182                         input              bf_r-line.obj-code ,
     3183                         input              bf_r-line.pl-code ,
     3184                         input              recid( bf_r-line ) ,
     3185                         input              bf_r-line.rvs-prev-code ,
     3186                         input-output table tt-meas ) no-error .
     3187               if error-status :error then do:
     3188               undo tr, return error substitute( 'Ошибка при заполнении данных из документов.&1&2&1&3'
     3189                                                , chr(10)
     3190                                                , error-status :get-message( 1 )
     3191                                                , return-value ).
     3192               end.
     3193            END.
     3194         END.
     3195       end.
     3196     end.
     3197     return .
     3198   end procedure.
     3199   procedure lib-rvs_pump-sh :
     3200     define input parameter p-obj-type         like ub.place.obj-type     no-undo.
     3201     define input parameter p-obj-code         like ub.place.obj-code     no-undo.
     3202     define input parameter p-rvs-code         like ub.rvs-doc.rvs-code   no-undo.
     3203     define input parameter p-rvs-type         like ub.rvs-doc.rvs-type   no-undo.
     3204     define input parameter p-prev-rvs-code    like ub.rvs-doc.rvs-code   no-undo.
     3205     define input parameter p-prev-icnt-code   like ub.icnt-doc.doc-code  no-undo.
     3206     define input parameter p-shift-date       like ub.rvs-doc.shift-date no-undo.
     3207     define input parameter p-shift-num        like ub.rvs-doc.shift-num  no-undo.
     3208     define input parameter p-qst_icnt-gds-all as   logical               no-undo.
     3209     define input parameter p-message-on       as   logical               no-undo.
     3210     define buffer buf_rvs-line for ub.rvs-line.
     3211     tr:
     3212     do transaction
     3213     on error undo tr, return error return-value
     3214     :
     3215       for each buf_rvs-line
     3216         where buf_rvs-line.rvs-code = p-rvs-code
     3217           and buf_rvs-line.obj-type = p-obj-type
     3218           and buf_rvs-line.obj-code = p-obj-code
     3219       on error undo tr, return error return-value
     3220       :
     3221   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crrvslnp in g#lib-rvs ( input  p-obj-type ,
     3222                         input  p-obj-code ,
     3223                         input  p-rvs-code ,
     3224                         input  p-rvs-type ,
     3225                         input  buf_rvs-line.pl-code ,
     3226                         input  buf_rvs-line.gds-code ,
     3227                         input  p-qst_icnt-gds-all ,
     3228                         input  p-prev-rvs-code ,
     3229                         input  p-shift-date ,
     3230                         input p-shift-num ,
     3231                         input p-prev-icnt-code ,
     3232                         input p-message-on ) no-error .
     3233         if error-status :error then do:
     3234           undo tr, return error substitute( 'Ошибка при создании строки данных по ТРК.&1&2&1&3'
     3235                                           , chr(10)
     3236                                           , error-status :get-message( 1 )
     3237                                           , return-value ) .
     3238         end.
     3239       end.
     3240     end.
     3241     return .
     3242   end procedure.
     3243   procedure lib-rvs_measpmnz :
     3244     define input        parameter           p-obj-type     like ub.pump-nozzle.obj-type no-undo.
     3245     define input        parameter           p-obj-code     like ub.pump-nozzle.obj-code no-undo.
     3246     define input-output parameter table for tt-pump-nozzle.
     3247     define buffer bf_pump-nozzle    for ub.pump-nozzle.
     3248     define buffer bf_pl-pump-nozzle for ub.pl-pump-nozzle.
     3249     define buffer bf_pl-gds         for ub.pl-gds.
     3250     for each tt-pump-nozzle :
     3251       delete tt-pump-nozzle .
     3252     end.
     3253     for each bf_pump-nozzle where
     3254              bf_pump-nozzle.obj-type = p-obj-type and
     3255              bf_pump-nozzle.obj-code = p-obj-code and
     3256              bf_pump-nozzle.is-meas  = yes
     3257     :
     3258       find first bf_pl-pump-nozzle no-lock where
     3259                  bf_pl-pump-nozzle.obj-type    = bf_pump-nozzle.obj-type    and
     3260                  bf_pl-pump-nozzle.obj-code    = bf_pump-nozzle.obj-code    and
     3261                  bf_pl-pump-nozzle.pump-code   = bf_pump-nozzle.pump-code   and
     3262                  bf_pl-pump-nozzle.nozzle-code = bf_pump-nozzle.nozzle-code no-error .
     3263       if available bf_pl-pump-nozzle then do:
     3264         find first bf_pl-gds no-lock where
     3265                    bf_pl-gds.obj-type = bf_pl-pump-nozzle.obj-type and
     3266                    bf_pl-gds.obj-code = bf_pl-pump-nozzle.obj-code and
     3267                    bf_pl-gds.pl-code  = bf_pl-pump-nozzle.pl-code  no-error .
     3268         if available bf_pl-gds then do:
     3269           create tt-pump-nozzle.
     3270           assign
     3271                  tt-pump-nozzle.obj-type    = bf_pl-pump-nozzle.obj-type
     3272                  tt-pump-nozzle.obj-code    = bf_pl-pump-nozzle.obj-code
     3273                  tt-pump-nozzle.pump-code   = bf_pl-pump-nozzle.pump-code
     3274                  tt-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
     3275                  tt-pump-nozzle.gds-code    = bf_pl-gds.gds-code
     3276           .
     3277         end.
     3278       end.
     3279     end.
     3280     return .
     3281   end procedure.
     3282   procedure lib-rvs_rvs-pump :
     3283     define input        parameter           p-parent-proc       as   widget-handle             no-undo.
     3284     define input        parameter           p-obj-type          like ub.rvs-line-pump.obj-type no-undo.
     3285     define input        parameter           p-obj-code          like ub.rvs-line-pump.obj-code no-undo.
     3286     define input        parameter           p-rvs-code          like ub.rvs-line-pump.rvs-code no-undo.
     3287     define input        parameter           p-cur-pump          as   logical                   no-undo.
     3288     define input-output parameter table for tt-pump-nozzle-file.
     3289     define input-output parameter table for tt-pump-nozzle.
     3290     define buffer bf_pump-nozzle   for ub.pump-nozzle.
     3291     define buffer bf_rvs-line-pump for ub.rvs-line-pump.
     3292     define variable v-msg as character no-undo initial "":U .
     3293   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_anls-pmp in g#lib-rvs ( input              p-parent-proc ,
     3294                         input              p-obj-type ,
     3295                         input              p-obj-code ,
     3296                         input              yes ,
     3297                         input-output table tt-pump-nozzle-file ,
     3298                         input-output table tt-pump-nozzle ,
     3299                         input              p-cur-pump ,
     3300                         input              no ,
     3301                         input              no) no-error .
     3302     if error-status :error then do:
     3303       return error return-value .
     3304     end.
     3305     assign
     3306       v-msg = return-value
     3307     .
     3308     tr:
     3309     do transaction
     3310     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3311     on stop  undo, return error substitute( "&1. stop", vss-workfile )
     3312     on quit  undo, return error substitute( "&1. quit", vss-workfile )
     3313     :
     3314       for each bf_rvs-line-pump
     3315         where bf_rvs-line-pump.rvs-code = p-rvs-code
     3316           and bf_rvs-line-pump.obj-type = p-obj-type
     3317           and bf_rvs-line-pump.obj-code = p-obj-code
     3318         ,first bf_pump-nozzle
     3319         where bf_pump-nozzle.obj-type    = bf_rvs-line-pump.obj-type
     3320           and bf_pump-nozzle.obj-code    = bf_rvs-line-pump.obj-code
     3321           and bf_pump-nozzle.pump-code   = bf_rvs-line-pump.pump-code
     3322           and bf_pump-nozzle.nozzle-code = bf_rvs-line-pump.nozzle-code
     3323           and bf_pump-nozzle.is-meas     = yes
     3324       on error undo tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3325       :
     3326   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_fill1pmp in g#lib-rvs ( input       recid( bf_rvs-line-pump ) ,
     3327                         input table tt-pump-nozzle ) no-error .
     3328         if error-status :error then do:
     3329           undo tr, return error 'Ошибка при сохранении данных в строку счетчиков ТРК ' + return-value + ' .' .
     3330         end.
     3331       end.
     3332     end.
     3333     return v-msg .
     3334   end procedure.
     3335   procedure lib-rvs_crttpmnz :
     3336     define input        parameter           p-obj-type     like ub.pump-nozzle.obj-type    no-undo.
     3337     define input        parameter           p-obj-code     like ub.pump-nozzle.obj-code    no-undo.
     3338     define input        parameter           p-pump-code    like ub.pump-nozzle.pump-code   no-undo.
     3339     define input        parameter           p-nozzle-code  like ub.pump-nozzle.nozzle-code no-undo.
     3340     define input-output parameter table for tt-pump-nozzle.
     3341     define buffer bf_pl-pump-nozzle for ub.pl-pump-nozzle.
     3342     define buffer bf_pl-gds         for ub.pl-gds.
     3343     find first bf_pl-pump-nozzle no-lock where
     3344                bf_pl-pump-nozzle.obj-type    = p-obj-type    and
     3345                bf_pl-pump-nozzle.obj-code    = p-obj-code    and
     3346                bf_pl-pump-nozzle.pump-code   = p-pump-code   and
     3347                bf_pl-pump-nozzle.nozzle-code = p-nozzle-code no-error .
     3348     if available bf_pl-pump-nozzle then do:
     3349       find first bf_pl-gds no-lock where
     3350                  bf_pl-gds.obj-type = bf_pl-pump-nozzle.obj-type and
     3351                  bf_pl-gds.obj-code = bf_pl-pump-nozzle.obj-code and
     3352                  bf_pl-gds.pl-code  = bf_pl-pump-nozzle.pl-code  no-error .
     3353       if available bf_pl-gds then do:
     3354         create tt-pump-nozzle.
     3355         assign
     3356                tt-pump-nozzle.obj-type    = bf_pl-pump-nozzle.obj-type
     3357                tt-pump-nozzle.obj-code    = bf_pl-pump-nozzle.obj-code
     3358                tt-pump-nozzle.pump-code   = bf_pl-pump-nozzle.pump-code
     3359                tt-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
     3360                tt-pump-nozzle.gds-code    = bf_pl-gds.gds-code
     3361         .
     3362       end.
     3363     end.
     3364     return .
     3365   end procedure.
     3366   procedure lib-rvs_fill1pmp :
     3367     define input parameter           p-rec_rvs-line-pump as recid no-undo.
     3368     define input parameter table for tt-pump-nozzle.
     3369     define buffer start_icnt-line     for ub.icnt-line.
     3370     define buffer start_rvs-line-pump for ub.rvs-line-pump.
     3371     define buffer fill_rvs-line       for ub.rvs-line.
     3372     define buffer fill_rvs-line-pump  for ub.rvs-line-pump.
     3373     define buffer bf_goods            for ub.goods.
     3374     find first fill_rvs-line-pump where
     3375         recid( fill_rvs-line-pump ) = p-rec_rvs-line-pump no-error .
     3376     if not available fill_rvs-line-pump then do:
     3377       return error substitute( 'Неверные параметры переданы процедуре lib-rvs_fill1pmp. '
     3378                              + 'Не найдена запись rvs-line-pump c recid: &1 .'
     3379                              , p-rec_rvs-line-pump ) .
     3380     end.
     3381     find first tt-pump-nozzle where
     3382                tt-pump-nozzle.obj-type    = fill_rvs-line-pump.obj-type    and
     3383                tt-pump-nozzle.obj-code    = fill_rvs-line-pump.obj-code    and
     3384                tt-pump-nozzle.pump-code   = fill_rvs-line-pump.pump-code   and
     3385                tt-pump-nozzle.nozzle-code = fill_rvs-line-pump.nozzle-code no-error .
     3386     find first fill_rvs-line no-lock where
     3387                fill_rvs-line.rvs-code = fill_rvs-line-pump.rvs-code and
     3388                fill_rvs-line.obj-type = fill_rvs-line-pump.obj-type and
     3389                fill_rvs-line.obj-code = fill_rvs-line-pump.obj-code and
     3390                fill_rvs-line.pl-code  = fill_rvs-line-pump.pl-code  .
     3391     find first bf_goods no-lock where
     3392                bf_goods.gds-code = fill_rvs-line.gds-code .
     3393     if not available tt-pump-nozzle then do:
     3394       return error substitute( 'Ошибка. Со счетчиков не получены данные по ТРК &1 пистолету &2 '
     3395                              + 'через который продается топливо &3 &4 &5 &6.'
     3396                              , fill_rvs-line-pump.pump-code
     3397                              , fill_rvs-line-pump.nozzle-code
     3398                              , bf_goods.artic
     3399                              , bf_goods.prod-type
     3400                              , bf_goods.prod-code
     3401                              , bf_goods.gds-name ) .
     3402     end.
     3403     assign
     3404       fill_rvs-line-pump.meas-el-cnt  = tt-pump-nozzle.meas-el-cnt
     3405       fill_rvs-line-pump.meas-am-cnt  = tt-pump-nozzle.meas-am-cnt
     3406       fill_rvs-line-pump.meas-cf-cnt  = tt-pump-nozzle.meas-cf-cnt
     3407       fill_rvs-line-pump.state-el-cnt = fill_rvs-line-pump.meas-el-cnt
     3408       fill_rvs-line-pump.state-am-cnt = fill_rvs-line-pump.meas-am-cnt
     3409       fill_rvs-line-pump.state-cf-cnt = fill_rvs-line-pump.meas-cf-cnt
     3410     .
     3411     if fill_rvs-line-pump.icnt-code <> ? then do:
     3412       find first start_icnt-line no-lock where
     3413                  start_icnt-line.doc-code    = fill_rvs-line-pump.icnt-code   and
     3414                  start_icnt-line.obj-type    = fill_rvs-line-pump.obj-type    and
     3415                  start_icnt-line.obj-code    = fill_rvs-line-pump.obj-code    and
     3416                  start_icnt-line.pump-code   = fill_rvs-line-pump.pump-code   and
     3417                  start_icnt-line.nozzle-code = fill_rvs-line-pump.nozzle-code .
     3418       assign
     3419         fill_rvs-line-pump.meas-mh-cnt  = fill_rvs-line-pump.meas-el-cnt - start_icnt-line.state-el-cnt
     3420                                                                          + start_icnt-line.state-mh-cnt
     3421         fill_rvs-line-pump.state-mh-cnt = fill_rvs-line-pump.meas-mh-cnt
     3422       .
     3423     end.
     3424     if fill_rvs-line-pump.rvs-prev-code <> ? then do:
     3425       find first start_rvs-line-pump no-lock where
     3426                  start_rvs-line-pump.rvs-code    = fill_rvs-line-pump.rvs-prev-code and
     3427                  start_rvs-line-pump.obj-type    = fill_rvs-line-pump.obj-type      and
     3428                  start_rvs-line-pump.obj-code    = fill_rvs-line-pump.obj-code      and
     3429                  start_rvs-line-pump.pl-code     = fill_rvs-line-pump.pl-code       and
     3430                  start_rvs-line-pump.gds-code    = fill_rvs-line-pump.gds-code      and
     3431                  start_rvs-line-pump.pump-code   = fill_rvs-line-pump.pump-code     and
     3432                  start_rvs-line-pump.nozzle-code = fill_rvs-line-pump.nozzle-code   .
     3433       assign
     3434         fill_rvs-line-pump.meas-mh-qnty  = fill_rvs-line-pump.meas-mh-cnt  - start_rvs-line-pump.meas-mh-cnt
     3435         fill_rvs-line-pump.meas-am-qnty  = fill_rvs-line-pump.meas-am-cnt  - start_rvs-line-pump.meas-am-cnt
     3436         fill_rvs-line-pump.meas-cf-qnty  = fill_rvs-line-pump.meas-cf-cnt  - start_rvs-line-pump.meas-cf-cnt
     3437         fill_rvs-line-pump.state-mh-qnty = fill_rvs-line-pump.state-mh-cnt - start_rvs-line-pump.state-mh-cnt
     3438         fill_rvs-line-pump.state-am-qnty = fill_rvs-line-pump.state-am-cnt - start_rvs-line-pump.state-am-cnt
     3439         fill_rvs-line-pump.state-cf-qnty = fill_rvs-line-pump.state-cf-cnt - start_rvs-line-pump.state-cf-cnt
     3440       .
     3441     end.
     3442     return .
     3443   end procedure.
     3444   procedure lib-rvs_crrvslin :
     3445     define input parameter p-obj-type                 like ub.rvs-doc.obj-type     no-undo.
     3446     define input parameter p-obj-code                 like ub.rvs-doc.obj-code     no-undo.
     3447     define input parameter p-rvs-code                 like ub.rvs-doc.rvs-code     no-undo.
     3448     define input parameter p-rvs-type                 like ub.rvs-doc.rvs-type     no-undo.
     3449     define input parameter p-pl-code                  like ub.pl-gds.pl-code       no-undo.
     3450     define input parameter p-gds-code                 like ub.pl-gds.gds-code      no-undo.
     3451     define input parameter p-prev_rvs-code            like ub.rvs-doc.rvs-code     no-undo.
     3452     define input parameter p-cur_shift-obj_shift-date like ub.shift-obj.shift-date no-undo.
     3453     define input parameter p-cur_shift-obj_shift-num  like ub.shift-obj.shift-num  no-undo.
     3454     define buffer bf_prev_rvs-line for ub.rvs-line.
     3455     define buffer prev_rvs-line    for ub.rvs-line.
     3456     define buffer buf_goods        for ub.goods .
     3457     define buffer buf_rvs-line     for ub.rvs-line.
     3458     define buffer buf_rvs-doc      for ub.rvs-doc.
     3459     define buffer contr_rvs-doc    for ub.rvs-doc.
     3460     define buffer crl_prev_rvs-doc for ub.rvs-doc.
     3461     define buffer buf_place        for ub.place.
     3462     define variable c-value as character no-undo.
     3463     define variable c-type as character no-undo.
     3464     define variable is-vir as logical no-undo.
     3465     define variable v-value as character no-undo.
     3466     define variable v-ok as logical no-undo.
     3467     do on error undo, return error return-value :
     3468       if p-prev_rvs-code <> ? then do:
     3469         find first crl_prev_rvs-doc no-lock
     3470           where crl_prev_rvs-doc.rvs-code = p-prev_rvs-code
     3471         .
     3472       end.
     3473       define variable varis-petrol   as logical no-undo.
     3474       define variable varis-pieces   as logical no-undo.
     3475       find first buf_goods no-lock
     3476         where buf_goods.gds-code = p-gds-code
     3477       .
     3478   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     3479     (
     3480        input buf_goods.artic
     3481     ,  input buf_goods.prod-type
     3482     ,  input buf_goods.prod-code
     3483     , output varis-petrol
     3484     , output varis-pieces
     3485     ) no-error.
     3486       if error-status :error then do:
     3487         return error 'Ошибка при вызове программы is-petrl.i ' + return-value .
     3488       end.
     3489       if varis-petrol <> yes
     3490         or varis-pieces =  yes
     3491       then do:
     3492         return 'Товар не является жидким топливом' .
     3493       end.
     3494       if p-rvs-type = 'проверка':U
     3495       then do :
     3496               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3497           (input  p-gds-code
     3498           ,input  'fuel-type':U
     3499           ,output c-value
     3500           ,output c-type)
     3501         no-error.
     3502         if c-value = 'lgas':U
     3503         or c-value = 'metan':U
     3504         or c-value = 'propan':U
     3505         then do :
     3506           return substitute('GAS! Проверка корректности работы АСИ в резервуаре НП возможна только по резервуарам с НП. Выбранный резервуар с типом топлива &1 не может быть добавлен в документ!', c-value).
     3507         end .
     3508         find first buf_place no-lock  where buf_place.obj-type = p-obj-type
     3509                                         and buf_place.obj-code = p-obj-code
     3510                                         and buf_place.pl-code  = p-pl-code
     3511                                         no-error .
     3512         if not available buf_place
     3513         then do :
     3514           return error return-value .
     3515         end .
     3516         if not buf_place.is-meas
     3517         then do :
     3518           return substitute('NMS! Проверка корректности работы АСИ в резервуаре НП возможна только по измеряемым резервуарам. Выбранный резервуар &1 неизмеряемый и не может быть добавлен в документ!', p-pl-code).
     3519         end .
     3520         run placelib_get-attr(input "place-virtual"
     3521                          ,input buf_place.obj-code
     3522                          ,input buf_place.obj-type
     3523                          ,input buf_place.pl-code
     3524                          ,output v-value
     3525                          ,output v-ok) no-error.
     3526         is-vir = if (v-ok and logical(v-value)) then true else false.
     3527         if is-vir
     3528         then do :
     3529           return substitute('VIR! Проверка корректности работы АСИ в резервуаре НП не возможна по виртуальным резервуарам. Выбранный резервуар &1 виртуальный и не может быть добавлен в документ!', p-pl-code).
     3530         end .
     3531         find first buf_rvs-line no-lock
     3532           where buf_rvs-line.rvs-code = p-rvs-code
     3533             and buf_rvs-line.obj-type = p-obj-type
     3534             and buf_rvs-line.obj-code = p-obj-code
     3535             and buf_rvs-line.pl-code  = p-pl-code
     3536             and buf_rvs-line.gds-code = p-gds-code
     3537         no-error .
     3538         if not available buf_rvs-line
     3539         then do :
     3540           create buf_rvs-line.
     3541           assign
     3542             buf_rvs-line.rvs-code      = p-rvs-code
     3543             buf_rvs-line.obj-type      = p-obj-type
     3544             buf_rvs-line.obj-code      = p-obj-code
     3545             buf_rvs-line.pl-code       = p-pl-code
     3546             buf_rvs-line.gds-code      = p-gds-code
     3547             buf_rvs-line.rvs-prev-code = ?
     3548             buf_rvs-line.measure-qnty = ?
     3549             buf_rvs-line.brutto-qnty = ?
     3550             buf_rvs-line.measure-cli-qnty = ?
     3551             buf_rvs-line.brutto-cli-qnty = ?
     3552             buf_rvs-line.density = ?
     3553             buf_rvs-line.temperature = ?
     3554             buf_rvs-line.level-total = ?
     3555             buf_rvs-line.level-petrol = ?
     3556             buf_rvs-line.level-water = ?
     3557             buf_rvs-line.temp-layer1 = ?
     3558             buf_rvs-line.temp-layer2 = ?
     3559             buf_rvs-line.temp-layer3 = ?
     3560             buf_rvs-line.measure-tc-qnty = ?
     3561             buf_rvs-line.brutto-tc-qnty = ?
     3562             buf_rvs-line.state-measure-qnty = ?
     3563             buf_rvs-line.state-brutto-qnty = ?
     3564             buf_rvs-line.state-measure-cli-qnty = ?
     3565             buf_rvs-line.state-brutto-cli-qnty = ?
     3566             buf_rvs-line.state-density = ?
     3567             buf_rvs-line.state-temperature = ?
     3568             buf_rvs-line.state-level-total = ?
     3569             buf_rvs-line.state-level-petrol = ?
     3570             buf_rvs-line.state-level-water = ?
     3571             buf_rvs-line.state-temp-layer1 = ?
     3572             buf_rvs-line.state-temp-layer2 = ?
     3573             buf_rvs-line.state-temp-layer3 = ?
     3574             buf_rvs-line.state-measure-tc-qnty = ?
     3575             buf_rvs-line.state-brutto-tc-qnty = ?
     3576             buf_rvs-line.add-qnty       = ?
     3577             buf_rvs-line.state-add-qnty = ?
     3578           .
     3579         end .
     3580         return .
     3581       end .
     3582   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3583   run get-ptrl-prop in this-procedure
     3584     ( input p-obj-type
     3585     , input p-obj-code
     3586     ) .
     3587       find first buf_rvs-line no-lock
     3588         where buf_rvs-line.rvs-code = p-rvs-code
     3589           and buf_rvs-line.obj-type = p-obj-type
     3590           and buf_rvs-line.obj-code = p-obj-code
     3591           and buf_rvs-line.pl-code  = p-pl-code
     3592           and buf_rvs-line.gds-code = p-gds-code
     3593         no-error .
     3594       if not available buf_rvs-line then do:
     3595         if available prev_rvs-line then do:
     3596           release prev_rvs-line .
     3597         end.
     3598         if available crl_prev_rvs-doc then do:
     3599           find first prev_rvs-line no-lock
     3600             where prev_rvs-line.rvs-code = crl_prev_rvs-doc.rvs-code
     3601               and prev_rvs-line.obj-type = p-obj-type
     3602               and prev_rvs-line.obj-code = p-obj-code
     3603               and prev_rvs-line.pl-code  = p-pl-code
     3604               and prev_rvs-line.gds-code = p-gds-code
     3605             no-error .
     3606         end.
     3607         if not available prev_rvs-line then do:
     3608           prev:
     3609           for each contr_rvs-doc no-lock
     3610             where contr_rvs-doc.obj-type   = p-obj-type
     3611               and contr_rvs-doc.obj-code   = p-obj-code
     3612               and contr_rvs-doc.shift-date = p-cur_shift-obj_shift-date
     3613               and contr_rvs-doc.shift-num  = p-cur_shift-obj_shift-num
     3614               and contr_rvs-doc.status_    = 'факт':U
     3615               and contr_rvs-doc.rvs-type  <> 'проверка':U
     3616             by contr_rvs-doc.fact-order
     3617           on error undo, return error return-value
     3618           :
     3619             find first prev_rvs-line no-lock
     3620               where prev_rvs-line.rvs-code = contr_rvs-doc.rvs-code
     3621                 and prev_rvs-line.obj-type = p-obj-type
     3622                 and prev_rvs-line.obj-code = p-obj-code
     3623                 and prev_rvs-line.pl-code  = p-pl-code
     3624                 and prev_rvs-line.gds-code = p-gds-code
     3625               no-error .
     3626             if available prev_rvs-line then do:
     3627               leave prev .
     3628             end.
     3629           end.
     3630           if not available prev_rvs-line
     3631             and p-rvs-type = 'смена':U
     3632           then do:
     3633             return error substitute( 'На объекте &1 &2 для резервуара &3 в котором находится топливо &4'
     3634                                      + 'нет сверки по смене за прошлую смену и нет ни одной контрольной сверки за текущую смену.'
     3635                                      ,p-obj-type
     3636                                      ,p-obj-code
     3637                                      ,p-pl-code
     3638                                      ,p-gds-code
     3639                                     ) .
     3640           end.
     3641         end.
     3642         create buf_rvs-line.
     3643         assign
     3644           buf_rvs-line.rvs-code      = p-rvs-code
     3645           buf_rvs-line.obj-type      = p-obj-type
     3646           buf_rvs-line.obj-code      = p-obj-code
     3647           buf_rvs-line.pl-code       = p-pl-code
     3648           buf_rvs-line.gds-code      = p-gds-code
     3649           buf_rvs-line.rvs-prev-code = ( if available prev_rvs-line then prev_rvs-line.rvs-code else ? )
     3650           buf_rvs-line.measure-qnty = ?
     3651           buf_rvs-line.brutto-qnty = ?
     3652           buf_rvs-line.measure-cli-qnty = ?
     3653           buf_rvs-line.brutto-cli-qnty = ?
     3654           buf_rvs-line.density = ?
     3655           buf_rvs-line.temperature = ?
     3656           buf_rvs-line.level-total = ?
     3657           buf_rvs-line.level-petrol = ?
     3658           buf_rvs-line.level-water = ?
     3659           buf_rvs-line.temp-layer1 = ?
     3660           buf_rvs-line.temp-layer2 = ?
     3661           buf_rvs-line.temp-layer3 = ?
     3662           buf_rvs-line.measure-tc-qnty = ?
     3663           buf_rvs-line.brutto-tc-qnty = ?
     3664           buf_rvs-line.state-measure-qnty = ?
     3665           buf_rvs-line.state-brutto-qnty = ?
     3666           buf_rvs-line.state-measure-cli-qnty = ?
     3667           buf_rvs-line.state-brutto-cli-qnty = ?
     3668           buf_rvs-line.state-density = ?
     3669           buf_rvs-line.state-temperature = ?
     3670           buf_rvs-line.state-level-total = ?
     3671           buf_rvs-line.state-level-petrol = ?
     3672           buf_rvs-line.state-level-water = ?
     3673           buf_rvs-line.state-temp-layer1 = ?
     3674           buf_rvs-line.state-temp-layer2 = ?
     3675           buf_rvs-line.state-temp-layer3 = ?
     3676           buf_rvs-line.state-measure-tc-qnty = ?
     3677           buf_rvs-line.state-brutto-tc-qnty = ?
     3678         .
     3679         find first buf_place no-lock  where buf_place.obj-type = p-obj-type
     3680                                       and buf_place.obj-code = p-obj-code
     3681                                       and buf_place.pl-code  = p-pl-code
     3682                                       no-error .
     3683         if available buf_place
     3684         then do :
     3685           assign
     3686             buf_rvs-line.add-qnty       = buf_place.add-qnty
     3687             buf_rvs-line.state-add-qnty = buf_place.add-qnty
     3688           .
     3689         end.
     3690         if buf_goods.unit-base = buf_goods.unit-cli then do:
     3691           assign
     3692             buf_rvs-line.state-density = 1.0
     3693           .
     3694         end.
     3695         assign
     3696           buf_rvs-line.system-qnty          = 0.00
     3697           buf_rvs-line.system-cli-qnty      = 0.00
     3698           buf_rvs-line.orig-system-cli-qnty = buf_rvs-line.system-cli-qnty
     3699           buf_rvs-line.orig-system-qnty     = buf_rvs-line.system-qnty
     3700         .
     3701         end.
     3702         find first rvs-line-attr exclusive-lock
     3703              where rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     3704                and rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     3705                and rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     3706                and rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     3707                and rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     3708                and rvs-line-attr.attr-code = "input-type-p" no-error.
     3709         if not available rvs-line-attr then do :
     3710           create rvs-line-attr.
     3711           assign
     3712             rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     3713             rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     3714             rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     3715             rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     3716             rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     3717             rvs-line-attr.attr-code = "input-type-p"
     3718             rvs-line-attr.attr-value = ''
     3719           .
     3720         end.
     3721         find first rvs-line-attr exclusive-lock
     3722              where rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     3723                and rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     3724                and rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     3725                and rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     3726                and rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     3727                and rvs-line-attr.attr-code = "input-type-t" no-error.
     3728         if not available rvs-line-attr then do :
     3729           create rvs-line-attr.
     3730           assign
     3731             rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     3732             rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     3733             rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     3734             rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     3735             rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     3736             rvs-line-attr.attr-code = "input-type-t"
     3737             rvs-line-attr.attr-value = ''
     3738           .
     3739         end.
     3740         find first rvs-line-attr exclusive-lock
     3741              where rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     3742                and rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     3743                and rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     3744                and rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     3745                and rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     3746                and rvs-line-attr.attr-code = "input-type-l" no-error.
     3747         if not available rvs-line-attr then do :
     3748           create rvs-line-attr.
     3749           assign
     3750             rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     3751             rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     3752             rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     3753             rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     3754             rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     3755             rvs-line-attr.attr-code = "input-type-l"
     3756             rvs-line-attr.attr-value = ''
     3757           .
     3758         end.
     3759         release rvs-line-attr .
     3760     end.
     3761     return .
     3762   end procedure.
     3763   procedure lib-rvs_crrvslnp :
     3764     define input parameter p-obj-type                 like ub.rvs-doc.obj-type     no-undo.
     3765     define input parameter p-obj-code                 like ub.rvs-doc.obj-code     no-undo.
     3766     define input parameter p-rvs-code                 like ub.rvs-line.rvs-code    no-undo.
     3767     define input parameter p-rvs-type                 like ub.rvs-doc.rvs-type     no-undo.
     3768     define input parameter p-pl-code                  like ub.rvs-line.pl-code     no-undo.
     3769     define input parameter p-gds-code                 like ub.rvs-line.gds-code    no-undo.
     3770     define input parameter p-quest_icnt-goods         as   logical                 no-undo.
     3771     define input parameter p-prev_rvs-code            like ub.rvs-doc.rvs-code     no-undo.
     3772     define input parameter p-cur_shift-obj_shift-date like ub.shift-obj.shift-date no-undo.
     3773     define input parameter p-cur_shift-obj_shift-num  like ub.shift-obj.shift-num  no-undo.
     3774     define input parameter p-prev_icnt-code           like ub.icnt-doc.doc-code    no-undo.
     3775     define input parameter p-message-on               as   logical                 no-undo.
     3776     define variable is-vir as logical no-undo.
     3777     define variable v-value as character no-undo.
     3778     define variable v-ok as logical no-undo.
     3779     do
     3780     on error  undo, return error substitute( "&1(lib-rvs_crrvslnp). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3781     on stop   undo, return error substitute( "&1(lib-rvs_crrvslnp). stop", vss-workfile )
     3782     on endkey undo, return error substitute( "&1(lib-rvs_crrvslnp). endkey", vss-workfile )
     3783     :
     3784       define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     3785       define buffer contr_rvs-doc      for ub.rvs-doc.
     3786       define buffer buf_rvs-line       for ub.rvs-line.
     3787       define buffer buf_rvs-line-pump  for ub.rvs-line-pump.
     3788       define buffer prev-contr_rvs-doc for ub.rvs-doc.
     3789       define buffer prev_rvs-line-pump for ub.rvs-line-pump.
     3790       define buffer other-line-pump    for ub.rvs-line-pump.
     3791       define buffer prev_icnt-line     for ub.icnt-line.
     3792       define buffer bf_pump-nozzle     for ub.pump-nozzle.
     3793       define buffer bf_goods           for ub.goods.
     3794       define buffer icnt-goods         for ub.goods.
     3795       define buffer crl_prev_rvs-doc   for ub.rvs-doc.
     3796       define buffer crl_prev_icnt-doc  for ub.icnt-doc.
     3797       define variable varnoeqgds as logical no-undo.
     3798       define variable g-log      as logical no-undo.
     3799       if p-prev_rvs-code <> ? then do:
     3800         find first crl_prev_rvs-doc no-lock
     3801           where crl_prev_rvs-doc.rvs-code = p-prev_rvs-code
     3802         .
     3803       end.
     3804       if p-prev_icnt-code <> ? then do:
     3805         find first crl_prev_icnt-doc no-lock
     3806           where crl_prev_icnt-doc.doc-code = p-prev_icnt-code
     3807         .
     3808       end.
     3809       tr:
     3810       do transaction
     3811       on error  undo tr, return error substitute( "&1 (crrvslnp). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3812       on stop   undo tr, return error substitute( "&1 (crrvslnp). stop", vss-workfile )
     3813       on endkey undo tr, return error substitute( "&1 (crrvslnp). endkey", vss-workfile )
     3814       :
     3815         for each buf_pl-pump-nozzle
     3816           where buf_pl-pump-nozzle.obj-type = p-obj-type
     3817             and buf_pl-pump-nozzle.obj-code = p-obj-code
     3818             and buf_pl-pump-nozzle.pl-code  = p-pl-code
     3819         on error undo, return error return-value
     3820         :
     3821           find first buf_rvs-line no-lock
     3822             where buf_rvs-line.rvs-code = p-rvs-code
     3823               and buf_rvs-line.obj-type = buf_pl-pump-nozzle.obj-type
     3824               and buf_rvs-line.obj-code = buf_pl-pump-nozzle.obj-code
     3825               and buf_rvs-line.pl-code  = buf_pl-pump-nozzle.pl-code
     3826               and buf_rvs-line.gds-code = p-gds-code
     3827             no-error .
     3828           if not available buf_rvs-line then do:
     3829             next.
     3830           end.
     3831           find first buf_rvs-line-pump
     3832             where buf_rvs-line-pump.rvs-code    = p-rvs-code
     3833               and buf_rvs-line-pump.obj-type    = p-obj-type
     3834               and buf_rvs-line-pump.obj-code    = p-obj-code
     3835               and buf_rvs-line-pump.pl-code     = p-pl-code
     3836               and buf_rvs-line-pump.gds-code    = p-gds-code
     3837               and buf_rvs-line-pump.pump-code   = buf_pl-pump-nozzle.pump-code
     3838               and buf_rvs-line-pump.nozzle-code = buf_pl-pump-nozzle.nozzle-code
     3839             no-error .
     3840           if not available buf_rvs-line-pump then do:
     3841             if available prev_rvs-line-pump then do:
     3842               release prev_rvs-line-pump .
     3843             end.
     3844             if available crl_prev_rvs-doc then do:
     3845               find first prev_rvs-line-pump no-lock
     3846                 where prev_rvs-line-pump.rvs-code    = crl_prev_rvs-doc.rvs-code
     3847                   and prev_rvs-line-pump.obj-type    = p-obj-type
     3848                   and prev_rvs-line-pump.obj-code    = p-obj-code
     3849                   and prev_rvs-line-pump.pl-code     = p-pl-code
     3850                   and prev_rvs-line-pump.gds-code    = p-gds-code
     3851                   and prev_rvs-line-pump.pump-code   = buf_pl-pump-nozzle.pump-code
     3852                   and prev_rvs-line-pump.nozzle-code = buf_pl-pump-nozzle.nozzle-code
     3853                 no-error .
     3854             end.
     3855             if not available prev_rvs-line-pump then do:
     3856               prev:
     3857               for each contr_rvs-doc no-lock where
     3858                        contr_rvs-doc.obj-type   = p-obj-type                 and
     3859                        contr_rvs-doc.obj-code   = p-obj-code                 and
     3860                        contr_rvs-doc.shift-date = p-cur_shift-obj_shift-date and
     3861                        contr_rvs-doc.shift-num  = p-cur_shift-obj_shift-num  and
     3862                        contr_rvs-doc.status_    = 'факт':U                    and
     3863                        contr_rvs-doc.rvs-type  <> 'проверка':U
     3864               :
     3865                 find first prev_rvs-line-pump no-lock
     3866                   where prev_rvs-line-pump.rvs-code    = contr_rvs-doc.rvs-code
     3867                     and prev_rvs-line-pump.obj-type    = p-obj-type
     3868                     and prev_rvs-line-pump.obj-code    = p-obj-code
     3869                     and prev_rvs-line-pump.pl-code     = p-pl-code
     3870                     and prev_rvs-line-pump.gds-code    = p-gds-code
     3871                     and prev_rvs-line-pump.pump-code   = buf_pl-pump-nozzle.pump-code
     3872                     and prev_rvs-line-pump.nozzle-code = buf_pl-pump-nozzle.nozzle-code
     3873                   no-error .
     3874                 if available prev_rvs-line-pump then do:
     3875                   leave prev .
     3876                 end.
     3877               end.
     3878               if not available prev_rvs-line-pump and
     3879                  p-rvs-type = 'смена':U
     3880               then do:
     3881                 find first bf_goods no-lock where
     3882                            bf_goods.gds-code = p-gds-code .
     3883                 undo tr, return error
     3884                 substitute( 'На объекте &1 &2 для резервуара &3 в котором находится топливо &4 &5 &6 &7 ТРК &8 '
     3885                           + 'пистолет &9 нет сверки по смене за прошлую смену и нет ни одной контрольной сверки '
     3886                           + 'за текущую смену.'
     3887                           , p-obj-type
     3888                           , p-obj-code
     3889                           , p-pl-code
     3890                           , bf_goods.artic
     3891                           , bf_goods.prod-type
     3892                           , bf_goods.prod-code
     3893                           , bf_goods.gds-name
     3894                           , buf_pl-pump-nozzle.pump-code
     3895                           , buf_pl-pump-nozzle.nozzle-code ) .
     3896               end.
     3897             end.
     3898             find first bf_pump-nozzle no-lock where
     3899                        bf_pump-nozzle.obj-type    = buf_pl-pump-nozzle.obj-type    and
     3900                        bf_pump-nozzle.obj-code    = buf_pl-pump-nozzle.obj-code    and
     3901                        bf_pump-nozzle.pump-code   = buf_pl-pump-nozzle.pump-code   and
     3902                        bf_pump-nozzle.nozzle-code = buf_pl-pump-nozzle.nozzle-code .
     3903             if bf_pump-nozzle.is-meas = yes then do:
     3904               find first bf_goods no-lock where
     3905                          bf_goods.gds-code = p-gds-code .
     3906               if available crl_prev_icnt-doc then do:
     3907                 find first prev_icnt-line no-lock where
     3908                            prev_icnt-line.doc-code    = crl_prev_icnt-doc.doc-code and
     3909                            prev_icnt-line.obj-type    = bf_pump-nozzle.obj-type    and
     3910                            prev_icnt-line.obj-code    = bf_pump-nozzle.obj-code    and
     3911                            prev_icnt-line.pump-code   = bf_pump-nozzle.pump-code   and
     3912                            prev_icnt-line.nozzle-code = bf_pump-nozzle.nozzle-code no-error .
     3913                 if not available prev_icnt-line then do:
     3914                    undo tr, return error substitute( 'Нет инвентаризации счетчика ТРК на ТРК &1 пистолет &2 через который '
     3915                                                    + 'сейчас наливается бензин &3 &4 &5 &6'
     3916                                                    , bf_pump-nozzle.pump-code
     3917                                                    , bf_pump-nozzle.nozzle-code
     3918                                                    , bf_goods.artic
     3919                                                    , bf_goods.prod-type
     3920                                                    , bf_goods.prod-code
     3921                                                    , bf_goods.gds-name ) .
     3922                 end.
     3923                 if prev_icnt-line.gds-code <> bf_goods.gds-code then do:
     3924                   assign
     3925                     varnoeqgds = yes
     3926                   .
     3927                   if available prev_rvs-line-pump then do:
     3928                      find first prev-contr_rvs-doc no-lock where
     3929                                 prev-contr_rvs-doc.rvs-code = prev_rvs-line-pump.rvs-code .
     3930                      if prev-contr_rvs-doc.fact-order > crl_prev_icnt-doc.fact-order then do:
     3931                        assign
     3932                          varnoeqgds = no
     3933                        .
     3934                      end.
     3935                   end.
     3936                   if varnoeqgds = yes then do:
     3937                     if prev_icnt-line.gds-code <> ? then do:
     3938                       find first icnt-goods no-lock where
     3939                                  icnt-goods.gds-code = prev_icnt-line.gds-code .
     3940                     end.
     3941                     else do:
     3942                       if p-quest_icnt-goods = no then do:
     3943                         assign
     3944                           varnoeqgds = no
     3945                         .
     3946                       end.
     3947                     end.
     3948                     if varnoeqgds = yes then do:
     3949                       if p-quest_icnt-goods = no then do:
     3950                         undo tr, return error
     3951                         substitute( 'Несоответствие по товару, продающемуся через пистолет ТРК. В данный момент '
     3952                                   + 'реализуется товар &1 &2 &3 &4 . Во время инвентаризации через пистолет &5 ТРК &6 '
     3953                                   + 'реализовывался товар &7 &8 &9 .'
     3954                                   , bf_goods.artic
     3955                                   , bf_goods.prod-type
     3956                                   , bf_goods.prod-code
     3957                                   , bf_goods.gds-name
     3958                                   , buf_pl-pump-nozzle.nozzle-code
     3959                                   , buf_pl-pump-nozzle.pump-code
     3960                                   , icnt-goods.artic
     3961                                   , icnt-goods.prod-type
     3962                                   , icnt-goods.prod-code ) .
     3963                       end.
     3964                       else do:
     3965                         if p-message-on = yes then do:
     3966                           assign
     3967                             g-log = no
     3968                           .
     3969                           message 'Несоответствие по товару, продающемуся через пистолет ТРК.' skip
     3970                                   'В данный момент реализуется товар '
     3971                                   bf_goods.artic ' ' bf_goods.prod-type ' ' bf_goods.prod-code ' .' skip
     3972                                   'Во время инвентаризации через пистолет ' buf_pl-pump-nozzle.nozzle-code ' ТРК ' buf_pl-pump-nozzle.pump-code
     3973                                   ( if prev_icnt-line.gds-code <> ? then 'реализовывался товар ' +
     3974                                                                          icnt-goods.artic               + ' ' +
     3975                                                                          icnt-goods.prod-type           + ' ' +
     3976                                                                          string( icnt-goods.prod-code ) + ' ' +
     3977                                                                          icnt-goods.gds-name            + ' .'
     3978                                                                    else 'товар не продавался.' )
     3979                                   'Будем делать сверку?'
     3980                           view-as alert-box question buttons yes-no update g-log.
     3981                           if g-log <> yes then do:
     3982                             undo tr, return error return-value .
     3983                           end.
     3984                         end.
     3985                       end.
     3986                     end.
     3987                   end.
     3988                 end.
     3989               end.
     3990               else do:
     3991                 undo tr, return error substitute( 'ТРК &1 &2 &3 &4 измеряется прибором. '
     3992                                                 + 'Должен быть документ инвентаризации счетчиков ТРК.'
     3993                                                 , bf_pump-nozzle.obj-type
     3994                                                 , bf_pump-nozzle.obj-code
     3995                                                 , bf_pump-nozzle.pump-code
     3996                                                 , bf_pump-nozzle.nozzle-code ) .
     3997               end.
     3998             end.
     3999             create buf_rvs-line-pump.
     4000             assign
     4001               buf_rvs-line-pump.rvs-code      = p-rvs-code
     4002               buf_rvs-line-pump.obj-type      = p-obj-type
     4003               buf_rvs-line-pump.obj-code      = p-obj-code
     4004               buf_rvs-line-pump.pl-code       = p-pl-code
     4005               buf_rvs-line-pump.gds-code      = p-gds-code
     4006               buf_rvs-line-pump.pump-code     = buf_pl-pump-nozzle.pump-code
     4007               buf_rvs-line-pump.nozzle-code   = buf_pl-pump-nozzle.nozzle-code
     4008               buf_rvs-line-pump.rvs-prev-code = ( if available prev_rvs-line-pump then prev_rvs-line-pump.rvs-code else ? )
     4009               buf_rvs-line-pump.icnt-code     = ( if available prev_icnt-line     then prev_icnt-line.doc-code     else ? )
     4010               buf_rvs-line-pump.meas-el-cnt   = ?
     4011               buf_rvs-line-pump.meas-am-cnt   = ?
     4012               buf_rvs-line-pump.meas-cf-cnt   = ?
     4013               buf_rvs-line-pump.meas-mh-cnt   = ?
     4014               buf_rvs-line-pump.meas-am-qnty  = ?
     4015               buf_rvs-line-pump.meas-cf-qnty  = ?
     4016               buf_rvs-line-pump.meas-mh-qnty  = ?
     4017               buf_rvs-line-pump.state-el-cnt  = ?
     4018               buf_rvs-line-pump.state-am-cnt  = ?
     4019               buf_rvs-line-pump.state-cf-cnt  = ?
     4020               buf_rvs-line-pump.state-mh-cnt  = ?
     4021               buf_rvs-line-pump.state-am-qnty = ?
     4022               buf_rvs-line-pump.state-cf-qnty = ?
     4023               buf_rvs-line-pump.state-mh-qnty = ?
     4024             .
     4025             find first other-line-pump no-lock
     4026               where other-line-pump.rvs-code    = buf_rvs-line-pump.rvs-code
     4027                 and other-line-pump.obj-type    = buf_rvs-line-pump.obj-type
     4028                 and other-line-pump.obj-code    = buf_rvs-line-pump.obj-code
     4029                 and other-line-pump.gds-code    = buf_rvs-line-pump.gds-code
     4030                 and other-line-pump.pump-code   = buf_rvs-line-pump.pump-code
     4031                 and other-line-pump.nozzle-code = buf_rvs-line-pump.nozzle-code
     4032             no-error .
     4033             if available other-line-pump then do:
     4034               assign
     4035                 buf_rvs-line-pump.state-am-cnt  = other-line-pump.state-am-cnt
     4036                 buf_rvs-line-pump.state-am-qnty = other-line-pump.state-am-qnty
     4037                 buf_rvs-line-pump.state-cf-cnt  = other-line-pump.state-cf-cnt
     4038                 buf_rvs-line-pump.state-cf-qnty = other-line-pump.state-cf-qnty
     4039                 buf_rvs-line-pump.state-el-cnt  = other-line-pump.state-el-cnt
     4040                 buf_rvs-line-pump.state-mh-cnt  = other-line-pump.state-mh-cnt
     4041                 buf_rvs-line-pump.state-mh-qnty = other-line-pump.state-mh-qnty
     4042               .
     4043             end.
     4044             run placelib_get-attr(input "place-virtual"
     4045                              ,input buf_rvs-line-pump.obj-code
     4046                              ,input buf_rvs-line-pump.obj-type
     4047                              ,input buf_rvs-line-pump.pl-code
     4048                              ,output v-value
     4049                              ,output v-ok) no-error.
     4050             is-vir = if (v-ok and logical(v-value)) then true else false.
     4051             if is-vir then
     4052               assign
     4053               buf_rvs-line-pump.meas-el-cnt   = 0
     4054               buf_rvs-line-pump.meas-am-cnt   = 0
     4055               buf_rvs-line-pump.meas-cf-cnt   = 0
     4056               buf_rvs-line-pump.meas-mh-cnt   = 0
     4057               buf_rvs-line-pump.meas-am-qnty  = 0
     4058               buf_rvs-line-pump.meas-cf-qnty  = 0
     4059               buf_rvs-line-pump.meas-mh-qnty  = 0
     4060               buf_rvs-line-pump.state-el-cnt  = 0
     4061               buf_rvs-line-pump.state-am-cnt  = 0
     4062               buf_rvs-line-pump.state-cf-cnt  = 0
     4063               buf_rvs-line-pump.state-mh-cnt  = 0
     4064               buf_rvs-line-pump.state-am-qnty = 0
     4065               buf_rvs-line-pump.state-cf-qnty = 0
     4066               buf_rvs-line-pump.state-mh-qnty = 0
     4067               .
     4068           end.
     4069         end.
     4070       end.
     4071     end.
     4072     return .
     4073   end procedure.
     4074   define variable is_FatalError as   logical       no-undo.
     4075   procedure lib-rvs_rvsplace :
     4076     define input        parameter           p-obj-type   like ub.rvs-doc.obj-type no-undo.
     4077     define input        parameter           p-obj-code   like ub.rvs-doc.obj-code no-undo.
     4078     define input        parameter           p-one-place  as   logical             no-undo.
     4079     define input        parameter           p-read-cur   as   integer             no-undo.
     4080     define input        parameter           p-message-on as   logical             no-undo.
     4081     define input        parameter           p-no-waitfram as   logical             no-undo.
     4082     define input-output parameter table for tt-meas-file.
     4083     define input-output parameter table for tt-meas.
     4084     define buffer bf_pl-level     for ub.pl-level.
     4085     define buffer bf-nxt_pl-level for ub.pl-level.
     4086     do
     4087     on error  undo, return error substitute( "&1(lib-rvs_rvsplace). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4088     on stop   undo, return error substitute( "&1(lib-rvs_rvsplace). stop", vss-workfile )
     4089     on endkey undo, return error substitute( "&1(lib-rvs_rvsplace). endkey", vss-workfile )
     4090     :
     4091       define variable v-value       as character no-undo.
     4092       define variable v-ok          as logical   no-undo.
     4093       define variable pl-twice-code as character no-undo.
     4094       is_FatalError = no.
     4095       define variable anl-loc       like ub.place.loc1 no-undo.
     4096       define variable v_string-tmp  as   character     no-undo.
     4097       define variable v_command     as   character     no-undo.
     4098       define variable v_File-Name   as   character     no-undo.
     4099       define variable v-err-file-name as character     no-undo .
     4100       define variable v-log-file-name as character     no-undo .
     4101       define variable j_num         as   integer       no-undo.
     4102       define variable v_DirFilervs  as   character     no-undo.
     4103       define variable l_log         as   logical       no-undo.
     4104       define variable vartarirvalue as   character     no-undo.
     4105       define variable vartarirtype  as   character     no-undo.
     4106       define variable varlevel-sm   as   integer       no-undo.
     4107       define variable Vrevis        as   longchar      no-undo.
     4108       define variable v-reviserr    as   character     no-undo.
     4109       define variable is-com-tanks  as   logical       no-undo init no .
     4110         define variable tt-level-water     as integer no-undo.
     4111         define variable tt-level-water-dec as decimal no-undo.
     4112         define variable v-water-qnty       as decimal no-undo .
     4113         define variable v-bh               as handle  no-undo .
     4114         define variable v-fh               as handle  no-undo .
     4115         define buffer bf-water-nxt_pl-level for pl-level.
     4116         define variable varlevel-sm-water as decimal no-undo.
     4117         define buffer bf_place for ub.place.
     4118         define buffer buf_place for ub.place .
     4119         define buffer buf_pl-gds for ub.pl-gds .
     4120       run gbl/conf-rd.p ("tarir", "", "", 0, "", "", "", no, output vartarirvalue, output vartarirtype) no-error.
     4121       define variable v_comstring   as   character     no-undo.
     4122       define variable v_comment     as   character     no-undo.
     4123       define variable v_StartString as   character     no-undo.
     4124   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crtt-rvs in g#lib-rvs ( input-output table tt-param ,
     4125                               output       v_comstring ,
     4126                               output       v_comment ,
     4127                               output       v_StartString ) no-error .
     4128       if error-status :error then do:
     4129         return error substitute( 'Ошибка при установке параметров для считывания данных с резервуаров.&1&2&1&3'
     4130                               , chr(10)
     4131                               , error-status :get-message( 1 )
     4132                               , return-value ) .
     4133       end.
     4134       for each tt-meas-file :
     4135         delete tt-meas-file .
     4136       end.
     4137       for each tt-place:
     4138         delete tt-place.
     4139       end.
     4140       if p-one-place = yes then do:
     4141         find first tt-meas no-error .
     4142         if not available tt-meas then do:
     4143           return error 'Ошибка. Данные по резервуару не найдены (возможно, не были считаны).' .
     4144         end.
     4145         find first bf_place no-lock
     4146           where bf_place.obj-type = tt-meas.obj-type
     4147             and bf_place.obj-code = tt-meas.obj-code
     4148             and bf_place.pl-code  = tt-meas.pl-code
     4149             and bf_place.status_ = ""
     4150           no-error.
     4151         assign
     4152           anl-loc = trim( bf_place.loc1 )
     4153         .
     4154         run placelib_get-attr  ( input "place-twice-code"
     4155                                 ,input bf_place.obj-code
     4156                                 ,input bf_place.obj-type
     4157                                 ,input bf_place.pl-code
     4158                                 ,output v-value
     4159                                 ,output v-ok      ) no-error.
     4160         if v-ok
     4161         and trim(v-value)  > ""
     4162         then do :
     4163           pl-twice-code = trim(v-value) .
     4164           anl-loc = anl-loc + "," + pl-twice-code .
     4165         end .
     4166         run placelib_get-attr  ( input "place-com-tanks"
     4167                                 ,input bf_place.obj-code
     4168                                 ,input bf_place.obj-type
     4169                                 ,input bf_place.pl-code
     4170                                 ,output v-value
     4171                                 ,output v-ok      ) no-error.
     4172         if v-ok
     4173         and v-value > ""
     4174         then do :
     4175           do ii = 1 to num-entries(v-value) :
     4176             find first bf_place no-lock
     4177             where bf_place.obj-type = tt-meas.obj-type
     4178               and bf_place.obj-code = tt-meas.obj-code
     4179               and bf_place.loc1     = entry(ii, v-value)
     4180               and bf_place.status_ = ""
     4181             no-error.
     4182             if available bf_place
     4183             and bf_place.is-meas
     4184             then do :
     4185               anl-loc = anl-loc + "," + bf_place.loc1 .
     4186             end .
     4187           end .
     4188           is-com-tanks = yes .
     4189         end .
     4190       end.
     4191       else do:
     4192         assign
     4193           anl-loc = '0':U
     4194         .
     4195       end.
     4196       v-log-file-name = substitute('&1rvs.log', ibs.th.gbl.gbl-inipar:logDir) .
     4197       v-err-file-name = './rvs-err.log' .
     4198       case p-read-cur :
     4199         when 0
     4200         then do :
     4201           get-key-value section 'revision'
     4202                         key     'dirflrvs'
     4203                         value   v_DirFilervs.
     4204           if v_DirFilervs = '':U
     4205             or v_DirFilervs = ?
     4206           then do:
     4207             assign
     4208               v_DirFilervs = '.':U
     4209             .
     4210           end.
     4211           system-dialog get-file v_File-Name
     4212             initial-dir v_DirFilervs
     4213             title 'Выберите файл с данными из резервуаров'
     4214             update l_log.
     4215           if l_log <> yes then do:
     4216             return error .
     4217           end.
     4218           run readfiletxt (v_File-Name, output Vrevis).
     4219           run readrevisetxt (Vrevis,v_StartString,v_comment).
     4220         end.
     4221         when 1
     4222         then do :
     4223           run get-from-struna (v-log-file-name,p-obj-code )no-error.
     4224           if error-status:error
     4225           then do :
     4226             return error return-value .
     4227           end.
     4228         end.
     4229         when 2
     4230         then do :
     4231           run str/getAsiDataAgent.p (input anl-loc, input p-no-waitfram, output table tt-place ) no-error.
     4232           if error-status:error
     4233           then do :
     4234             return error return-value + error-status:get-message (1).
     4235           end.
     4236         end.
     4237         when 3
     4238         then do :
     4239           run get-from-ifsf (v-log-file-name,?,? )no-error.
     4240           if error-status:error
     4241           then do :
     4242             return error return-value .
     4243           end.
     4244         end.
     4245       end case .
     4246       v-reviserr = "revis" + string(random(0,9)) + ".err" .
     4247       if searchfile(v-reviserr) ne ?
     4248       then do :
     4249         v-reviserr = "revis" + string(random(0,9)) + ".err" .
     4250         if searchfile(v-reviserr) ne ?
     4251         then do :
     4252           os-delete value(searchfile(v-reviserr)) no-error .
     4253         end .
     4254       end .
     4255       output stream str-err to value(v-reviserr) .
     4256       run creatett-meas-file(p-obj-type, p-obj-code).
     4257         _recalc:
     4258         for each tt-meas-file where not tt-meas-file.is-error
     4259             on error undo, return error return-value
     4260             :
     4261             if not tt-meas-file.meas-vol-water then tt-meas-file.water-qnty = ? .
     4262             if tt-meas-file.pl-code <> 0
     4263             then do :
     4264               find first buf_place no-lock where buf_place.obj-type = p-obj-type
     4265                                              and buf_place.obj-code = p-obj-code
     4266                                              and buf_place.pl-code  = tt-meas-file.pl-code
     4267                                              and buf_place.is-meas  = yes
     4268                                              no-error .
     4269             end.
     4270             else do :
     4271               twice-code:
     4272               for each  buf_place where buf_place.obj-code = p-obj-code
     4273                                     and buf_place.obj-type = p-obj-type
     4274                                     and buf_place.is-meas  = yes :
     4275                   run placelib_get-attr  ( input "place-twice-code"
     4276                       ,input p-obj-code
     4277                       ,input p-obj-type
     4278                       ,input buf_place.pl-code
     4279                       ,output v-value
     4280                       ,output v-ok      ) no-error.
     4281                   if v-ok then pl-twice-code = v-value .
     4282                   if num-entries(pl-twice-code) > 1
     4283                   then do :
     4284                     do ii = 1 to num-entries(pl-twice-code) :
     4285                       if trim( entry( ii, pl-twice-code ) ) = trim( tt-meas-file.loc1 )
     4286                       then do :
     4287                         leave twice-code.
     4288                       end.
     4289                     end.
     4290                   end.
     4291                   else do :
     4292                     if trim(pl-twice-code) =  trim( tt-meas-file.loc1 ) then leave twice-code.
     4293                   end.
     4294                   pl-twice-code = "" .
     4295               end.
     4296             end.
     4297             if available buf_place
     4298             then do :
     4299               find first buf_pl-gds no-lock where buf_pl-gds.obj-type     = buf_place.obj-type
     4300                                               and buf_pl-gds.obj-code     = buf_place.obj-code
     4301                                               and buf_pl-gds.pl-code      = buf_place.pl-code
     4302                                               and buf_pl-gds.status_      = 'тек':U
     4303                                               no-error .
     4304               if available buf_pl-gds
     4305               and is-sug(buf_pl-gds.gds-code)
     4306               then do :
     4307                 if tt-meas-file.level-petrol  = 0 and
     4308                    tt-meas-file.level-total  <> 0 then do:
     4309                   assign
     4310                     tt-meas-file.level-petrol = tt-meas-file.level-total - (if tt-meas-file.level-water <> ? then tt-meas-file.level-water else 0) .
     4311                 end.
     4312                 next _recalc.
     4313               end .
     4314             end.
     4315             define variable place-asi-sertif  as logical no-undo.
     4316             place-asi-sertif = no .
     4317             run placelib_get-attr  ( input "place-asi-sertif"
     4318                                   ,input p-obj-code
     4319                                   ,input p-obj-type
     4320                                   ,input tt-meas-file.pl-code
     4321                                   ,output v-value
     4322                                   ,output v-ok      ) no-error.
     4323             if v-ok then place-asi-sertif = logical(v-value) .
     4324             if tt-meas-file.meas-vol-oil   = no and
     4325                 vartarirvalue = "yes"
     4326                 and tt-meas-file.log-brutto = no
     4327                 then
     4328             do:
     4329                 if tt-meas-file.level-total = ? then
     4330                 do:
     4331                     assign
     4332                         is_FatalError = yes
     4333                         .
     4334                     put stream str-err unformatted
     4335                       substitute("&2 Вычисляем объем резервуаров через градуировочные таблицы. Для резервуара &1 не задан уровень в резервуаре."
     4336                         , tt-meas-file.loc1
     4337                         , cur-time-string-sec()
     4338                        ) skip.
     4339                 end.
     4340                 else
     4341                 do:
     4342                     assign
     4343                         varlevel-sm = trunc (tt-meas-file.level-total, 0).
     4344                     find first bf_pl-level where bf_pl-level.obj-type = tt-meas-file.obj-type and
     4345                         bf_pl-level.obj-code = tt-meas-file.obj-code and
     4346                         bf_pl-level.pl-code  = tt-meas-file.pl-code  and
     4347                         bf_pl-level.pl-level = varlevel-sm           no-error.
     4348                     if not available bf_pl-level then
     4349                     do:
     4350                         if tt-meas-file.pl-code <> 0 then
     4351                         do:
     4352                             assign
     4353                                 is_FatalError = yes
     4354                                 .
     4355                             put stream str-err unformatted
     4356                               substitute("&3 Вычисляем объем резервуаров через градуировочные таблицы. Для резервуара &1 не задан объем для уровня &2"
     4357                               , tt-meas-file.loc1
     4358                               , varlevel-sm
     4359                               , cur-time-string-sec()
     4360                               ) skip.
     4361                         end.
     4362                     end.
     4363                     else
     4364                     do:
     4365                         if varlevel-sm = tt-meas-file.level-total then
     4366                         do:
     4367                             assign
     4368                                 tt-meas-file.brutto-qnty      = bf_pl-level.pl-qnty
     4369                                 tt-meas-file.brutto-cli-qnty  = tt-meas-file.density * tt-meas-file.brutto-qnty
     4370                                 tt-meas-file.measure-qnty     = tt-meas-file.brutto-qnty
     4371                                 tt-meas-file.measure-cli-qnty = tt-meas-file.measure-qnty * tt-meas-file.density
     4372                                 .
     4373                         end.
     4374                         else
     4375                         do:
     4376                             assign
     4377                                 varlevel-sm = varlevel-sm + 1.
     4378                             find first bf-nxt_pl-level where bf-nxt_pl-level.obj-type = tt-meas-file.obj-type and
     4379                                 bf-nxt_pl-level.obj-code = tt-meas-file.obj-code and
     4380                                 bf-nxt_pl-level.pl-code  = tt-meas-file.pl-code  and
     4381                                 bf-nxt_pl-level.pl-level  = varlevel-sm           no-error.
     4382                             if not available bf-nxt_pl-level then
     4383                             do:
     4384                                 assign
     4385                                     is_FatalError = yes
     4386                                     .
     4387                                 put stream str-err unformatted
     4388                                   substitute("&4 Вычисляем объем резервуаров через градуировочные таблицы. Для резервуара &1 не задан объем для уровня &2 измерение &3"
     4389                                   , tt-meas-file.loc1
     4390                                   , varlevel-sm
     4391                                   , tt-meas-file.level-total
     4392                                   , cur-time-string-sec()
     4393                                   ) skip.
     4394                             end.
     4395                             else
     4396                             do:
     4397                                 assign
     4398                                     tt-meas-file.brutto-qnty      = bf_pl-level.pl-qnty + (bf-nxt_pl-level.pl-qnty - bf_pl-level.pl-qnty) * (tt-meas-file.level-total - trunc(tt-meas-file.level-total, 0))
     4399                                     tt-meas-file.brutto-cli-qnty  = tt-meas-file.density * tt-meas-file.brutto-qnty
     4400                                     tt-meas-file.measure-qnty     = tt-meas-file.brutto-qnty
     4401                                     tt-meas-file.measure-cli-qnty = tt-meas-file.measure-qnty * tt-meas-file.density.
     4402                             end.
     4403                         end.
     4404                         if  tt-meas-file.meas-vol-water = no  and tt-meas-file.level-water <> 0  then
     4405                         do:
     4406                             find first bf-nxt_pl-level where bf-nxt_pl-level.obj-type = tt-meas-file.obj-type and
     4407                                 bf-nxt_pl-level.obj-code = tt-meas-file.obj-code and
     4408                                 bf-nxt_pl-level.pl-code  = tt-meas-file.pl-code  and
     4409                                 bf-nxt_pl-level.pl-level  =    tt-meas-file.level-water    no-error.
     4410                             if  not available bf-nxt_pl-level then
     4411                             do:
     4412                                 assign
     4413                                     varlevel-sm-water = tt-meas-file.level-water + 1.
     4414                                 for each  bf-water-nxt_pl-level where bf-water-nxt_pl-level.obj-type = tt-meas-file.obj-type and
     4415                                     bf-water-nxt_pl-level.obj-code = tt-meas-file.obj-code and
     4416                                     bf-water-nxt_pl-level.pl-code  = tt-meas-file.pl-code  and
     4417                                     bf-water-nxt_pl-level.pl-level  <  varlevel-sm-water   and
     4418                                     bf-water-nxt_pl-level.pl-level > tt-meas-file.level-water - 1 no-lock  :
     4419                                     v-water-qnty = abs (  abs (v-water-qnty )  -  bf-water-nxt_pl-level.pl-qnty / 10 )  .
     4420                                     if  bf-water-nxt_pl-level.pl-level > tt-meas-file.level-water - 1 and bf-water-nxt_pl-level.pl-level < tt-meas-file.level-water then
     4421                                     do:
     4422                                         tt-level-water =  bf-water-nxt_pl-level.pl-qnty.
     4423                                         tt-level-water-dec = tt-meas-file.level-water - bf-water-nxt_pl-level.pl-level .
     4424                                     end.
     4425                                 end.
     4426                                 tt-meas-file.water-qnty =  tt-level-water +  tt-level-water-dec *  v-water-qnty * 10  .
     4427                             end.
     4428                             else
     4429                             do:
     4430                                 assign
     4431                                     tt-meas-file.water-qnty = bf-nxt_pl-level.pl-qnty  .
     4432                             end.
     4433                         end.
     4434                     end.
     4435                 end.
     4436             end.
     4437           if vartarirvalue = "no" or vartarirvalue = "" then
     4438           do:
     4439             if tt-meas-file.log-brutto = yes
     4440             and tt-meas-file.density > 0
     4441             and tt-meas-file.density < 1
     4442             then
     4443             do:
     4444                 if place-asi-sertif
     4445                 then do :
     4446                   assign
     4447                     tt-meas-file.measure-qnty = tt-meas-file.measure-cli-qnty / tt-meas-file.density
     4448                   .
     4449                 end.
     4450                 else
     4451                 if tt-meas-file.brutto-qnty <> 0 or tt-meas-file.brutto-qnty <> ? then
     4452                 do:
     4453                   assign
     4454                     tt-meas-file.density         = tt-meas-file.measure-cli-qnty / tt-meas-file.brutto-qnty
     4455                     tt-meas-file.measure-qnty    = tt-meas-file.brutto-qnty
     4456                     tt-meas-file.brutto-cli-qnty = tt-meas-file.density * tt-meas-file.brutto-qnty
     4457                     .
     4458                 end.
     4459                 else
     4460                 do:
     4461                   put stream str-err unformatted
     4462                     'Не заданы объем и плотность'  skip .
     4463                 end.
     4464             end.
     4465           end.
     4466           if tt-meas-file.level-petrol  = 0 and
     4467              tt-meas-file.level-total  <> 0 then do:
     4468             assign
     4469               tt-meas-file.level-petrol = tt-meas-file.level-total - (if tt-meas-file.level-water <> ? then tt-meas-file.level-water else 0) .
     4470           end.
     4471           if tt-meas-file.meas-vol-oil   = no
     4472               and tt-meas-file.meas-vol-water = no
     4473               then
     4474           do:
     4475               if tt-meas-file.density <> 0 and
     4476                   tt-meas-file.density <> ?
     4477                   then
     4478               do:
     4479                   if ( tt-meas-file.brutto-cli-qnty =  0   or
     4480                       tt-meas-file.brutto-cli-qnty =  ? ) and
     4481                       tt-meas-file.brutto-qnty     <> 0   and
     4482                       tt-meas-file.brutto-qnty     <> ?
     4483                       then
     4484                   do:
     4485                       assign
     4486                           tt-meas-file.brutto-cli-qnty = tt-meas-file.density * tt-meas-file.brutto-qnty
     4487                           .
     4488                   end.
     4489                   if ( tt-meas-file.brutto-qnty     =  0   or
     4490                       tt-meas-file.brutto-qnty     =  ? ) and
     4491                       tt-meas-file.brutto-cli-qnty <> 0   and
     4492                       tt-meas-file.brutto-cli-qnty <> ?
     4493                       then
     4494                   do:
     4495                       assign
     4496                           tt-meas-file.brutto-qnty = tt-meas-file.brutto-cli-qnty / tt-meas-file.density
     4497                           .
     4498                   end.
     4499               end.
     4500               else
     4501               do:
     4502               end.
     4503               if tt-meas-file.density > 0
     4504               and tt-meas-file.density < 1
     4505               and tt-meas-file.density <> ?
     4506               then do :
     4507                 if tt-meas-file.log-brutto
     4508                 then do :
     4509                   tt-meas-file.measure-qnty = tt-meas-file.measure-cli-qnty / tt-meas-file.density .
     4510                 end.
     4511                 else do :
     4512                   assign
     4513                     tt-meas-file.measure-qnty = tt-meas-file.brutto-qnty -  (if tt-meas-file.water-qnty <> ? then tt-meas-file.water-qnty else 0)
     4514                     tt-meas-file.measure-cli-qnty = tt-meas-file.measure-qnty * tt-meas-file.density
     4515                   .
     4516                 end.
     4517               end .
     4518           end.
     4519           else
     4520           do:
     4521               if tt-meas-file.meas-vol-oil = no then
     4522               do:
     4523                   assign
     4524                       tt-meas-file.measure-qnty = tt-meas-file.brutto-qnty - (if tt-meas-file.water-qnty <> ? then tt-meas-file.water-qnty else 0)
     4525                       .
     4526               end.
     4527               if tt-meas-file.density > 0
     4528               and tt-meas-file.density < 1
     4529               and tt-meas-file.density <> ?
     4530               then do :
     4531                 if tt-meas-file.log-brutto
     4532                 then do :
     4533                   tt-meas-file.measure-qnty = tt-meas-file.measure-cli-qnty / tt-meas-file.density .
     4534                 end.
     4535                 else do :
     4536                   assign
     4537                     tt-meas-file.measure-cli-qnty = tt-meas-file.measure-qnty * tt-meas-file.density
     4538                   .
     4539                 end.
     4540               end .
     4541           end.
     4542         if tt-meas-file.meas-vol-water and tt-meas-file.level-water  = 0 and abs(tt-meas-file.brutto-cli-qnty - tt-meas-file.measure-cli-qnty) <= 0.1 then tt-meas-file.brutto-cli-qnty = tt-meas-file.measure-cli-qnty.
     4543       end.
     4544       for each tt-meas
     4545       on error undo, return error return-value
     4546       :
     4547         find first tt-meas-file where
     4548                   tt-meas-file.obj-type = tt-meas.obj-type and
     4549                   tt-meas-file.obj-code = tt-meas.obj-code and
     4550                   tt-meas-file.pl-code  = tt-meas.pl-code  no-error .
     4551         if not available tt-meas-file then do:
     4552           if p-one-place = ? then do:
     4553             delete tt-meas.
     4554             next.
     4555           end.
     4556           else do:
     4557             if not is-com-tanks
     4558             then do :
     4559               assign
     4560                 is_FatalError = yes
     4561               .
     4562             end .
     4563             put stream str-err unformatted substitute( 'Не получены данные по резервуару &1 .'
     4564                                                        , tt-meas.pl-code ) skip .
     4565             if is-com-tanks
     4566             then do :
     4567               if p-message-on
     4568               then do :
     4569                 message substitute( 'Не получены данные по резервуару &1 .', tt-meas.pl-code ) view-as alert-box .
     4570               end .
     4571               delete tt-meas.
     4572               next.
     4573             end .
     4574           end.
     4575         end.
     4576       end.
     4577       for each tt-meas-file
     4578       on error undo, return error return-value
     4579       :
     4580         find first tt-meas where
     4581                   tt-meas.obj-type = tt-meas-file.obj-type and
     4582                   tt-meas.obj-code = tt-meas-file.obj-code and
     4583                   tt-meas.pl-code  = tt-meas-file.pl-code  and
     4584                   tt-meas.loc1     = tt-meas-file.loc1 no-error .
     4585         if not available tt-meas then do:
     4586             if tt-meas-file.loc1 <> "" and tt-meas-file.pl-code = 0  then
     4587             do:
     4588                 create tt-meas .
     4589                 assign
     4590                     tt-meas.obj-type = tt-meas-file.obj-type
     4591                     tt-meas.obj-code = tt-meas-file.obj-code
     4592                     tt-meas.loc1     = tt-meas-file.loc1 no-error.
     4593             end.
     4594             else
     4595             do:
     4596                 if p-one-place = ? then
     4597                 do:
     4598             assign
     4599               is_FatalError = yes
     4600             .
     4601           end.
     4602           put stream str-err unformatted
     4603             substitute( '&2 Получены данные по резервуару &1 по которому нет запроса.'
     4604                        , tt-meas-file.pl-code
     4605                        , cur-time-string-sec()
     4606                         ) skip .
     4607         end.
     4608         end.
     4609       end.
     4610       output stream str-err close.
     4611       output to value(v-err-file-name) append.
     4612       put unformatted string(today) ' ' string(time, "HH:MM:SS") skip .
     4613       output close .
     4614       OS-APPEND value(v-reviserr) value(v-err-file-name).
     4615       if is_FatalError = yes then do:
     4616         return error 'При считывании данных с резервуаров произошли ошибки НЕПОЗВОЛЯЮЩИЕ ЗАГРУЗИТЬ ДАННЫЕ.' .
     4617       end.
     4618       for  each tt-meas,
     4619         first tt-meas-file
     4620         where tt-meas-file.obj-type = tt-meas.obj-type
     4621           and tt-meas-file.obj-code = tt-meas.obj-code
     4622           and ((tt-meas-file.pl-code  = tt-meas.pl-code
     4623           and tt-meas.pl-code <> 0) or tt-meas-file.loc1 = tt-meas.loc1)
     4624       on error undo, return error return-value
     4625       :
     4626         if tt-meas-file.is-error
     4627         then do :
     4628           assign
     4629             tt-meas.measure-qnty     = ?
     4630             tt-meas.brutto-qnty      = ?
     4631             tt-meas.measure-cli-qnty = ?
     4632             tt-meas.brutto-cli-qnty  = ?
     4633             tt-meas.density          = ?
     4634             tt-meas.temperature      = ?
     4635             tt-meas.level-total      = ?
     4636             tt-meas.level-petrol     = ?
     4637             tt-meas.level-water      = ?
     4638             tt-meas.temp-layer1      = ?
     4639             tt-meas.temp-layer2      = ?
     4640             tt-meas.temp-layer3      = ?
     4641             tt-meas.measure-tc-qnty  = ?
     4642             tt-meas.brutto-tc-qnty   = ?
     4643             tt-meas.vapor-density    = ?
     4644             tt-meas.vapor-pressure   = ?
     4645             tt-meas.water-qnty       = ?
     4646             tt-meas.is-error         = yes
     4647           .
     4648         end .
     4649         else do :
     4650           assign
     4651             tt-meas.measure-qnty     = tt-meas-file.measure-qnty
     4652             tt-meas.brutto-qnty      = tt-meas-file.brutto-qnty
     4653             tt-meas.measure-cli-qnty = tt-meas-file.measure-cli-qnty
     4654             tt-meas.brutto-cli-qnty  = tt-meas-file.brutto-cli-qnty
     4655             tt-meas.density          = tt-meas-file.density
     4656             tt-meas.temperature      = (if tt-meas-file.temp-not-null then tt-meas-file.temperature else ?)
     4657             tt-meas.level-total      = tt-meas-file.level-total
     4658             tt-meas.level-petrol     = tt-meas-file.level-petrol
     4659             tt-meas.level-water      = tt-meas-file.level-water
     4660             tt-meas.temp-layer1      = (if tt-meas-file.t1-not-null then tt-meas-file.temp-layer1 else ?)
     4661             tt-meas.temp-layer2      = (if tt-meas-file.t2-not-null then tt-meas-file.temp-layer2 else ?)
     4662             tt-meas.temp-layer3      = (if tt-meas-file.t3-not-null then tt-meas-file.temp-layer3 else ?)
     4663             tt-meas.measure-tc-qnty  = tt-meas-file.measure-tc-qnty
     4664             tt-meas.brutto-tc-qnty   = tt-meas-file.brutto-tc-qnty
     4665             tt-meas.vapor-density    = tt-meas-file.vapor-density
     4666             tt-meas.vapor-pressure   = tt-meas-file.vapor-pressure
     4667             tt-meas.water-qnty       = tt-meas-file.water-qnty
     4668             tt-meas.is-error         = no
     4669           .
     4670         end .
     4671       end.
     4672   end.
     4673     return .
     4674     finally:
     4675       define variable v-save-file-name as character no-undo .
     4676       v-save-file-name = substitute("&1rvs-err.log", ibs.th.gbl.gbl-inipar:logDir) .
     4677       OS-APPEND value(v-err-file-name) value(v-save-file-name).
     4678     end finally .
     4679   end procedure.
