     1426   function objExists return character
     1427   (input  ifolder as character,
     1428    input  iType   as character  ):
     1429       define variable vFileType as character no-undo init "D,F".
     1430       define variable vi        as integer no-undo.
     1431       define variable vtype as character no-undo.
     1432       if iType ne ?
     1433       then
     1434          vFileType = iType.
     1435       do vi = 1 to num-entries(vFileType):
     1436          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
     1437          vtype = file-information:file-type.
     1438          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     1439             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     1440             index(vtype , entry(vi,vFileType )) > 0
     1441          then return file-information:full-pathname .
     1442          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
     1443          vtype = file-information:file-type.
     1444          if file-information:file-name <> "" and
     1445             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     1446             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     1447             index( vtype, entry(vi,vFileType )) > 0
     1448          then return file-information:full-pathname .
     1449       end.
     1450       return ? .
     1451   end.
     1452   function SearchFile return character
     1453   (input  ifile as character):
     1454      return objExists(ifile,?).
     1455   end.
     1456   function SearchPFile return character
     1457   (input inFile as char):
     1458        define variable oFile       as character no-undo.
     1459        define variable vFileSearch as character no-undo.
     1460        define variable vNumEntry   as integer no-undo.
     1461        if inFile = "" then return ?.
     1462        vNumEntry = num-entries(inFile,".").
     1463        vFileSearch = inFile.
     1464        if    vNumEntry > 0
     1465           and (   entry(vNumEntry,inFile,".") eq "p"
     1466                or entry(vNumEntry,inFile,".") eq "w")
     1467        then do:
     1468           entry(vNumEntry,vFileSearch, ".") = "r".
     1469           oFile = search(vFileSearch ).
     1470           if oFile eq ?
     1471           then
     1472              oFile = search(inFile).
     1473        end.
     1474        else
     1475           oFile = search(vFileSearch).
     1476        return oFile.
     1477     end.
     1478   define temp-table tt-place no-undo
     1479     field loc1          as character  label "№ резервуара"
     1480     field locint        as integer    label "№ резервуара"           init ?
     1481     field pl-code       as integer    label "Код резервуара"
     1482     field gds-code      as integer    label "Код продукта"
     1483     field gds-name      as character  label "НАИМЕНОВАНИЕ ПРОДУКТА"
     1484     field level-total   as decimal    label "Общий уровень (см)"
     1485     field level-water   as decimal    label "Уровень воды (см)"
     1486     field total-vol     as decimal    label "Общий объем (л)"
     1487     field avrg-temp     as decimal    label "Средняя Т"
     1488     field t1            as decimal    label "T1"
     1489     field t2            as decimal    label "T2"
     1490     field t3            as decimal    label "T3"
     1491     field density       as decimal    label "Плотность (кг/л)"
     1492     field mass          as decimal    label "Масса (кг)"
     1493     field vapor-density as decimal    label "Плотность СУГ (кг/л)"
     1494     field vapor-pressure as decimal   label "Давление СУГ (мПа)"
     1495     field volume_water  as decimal
     1496     field is-error      as logical
     1497     field error-message as character
     1498     index pi as unique
     1499       loc1
     1500     index locint as primary locint loc1
     1501   .
     1502   define stream str-file.
     1503   procedure readfiletxt:
     1504      define input  parameter i_File-Name   as character no-undo.
     1505      define output parameter Otext as longchar no-undo.
     1506      define variable v_string-tmp as character no-undo.
     1507      if searchfile(i_File-Name) eq ?
     1508      then
     1509         return.
     1510      input  stream str-file from  value (i_File-Name)   .
     1511      repeat :
     1512         import stream str-file unformatted v_string-tmp.
     1513         Otext = Otext + v_string-tmp + chr(10).
     1514      end.
     1515      input  stream str-file close.
     1516   end procedure.
     1517   procedure readrevisetxt:
     1518      define input  parameter i_Str         as Longchar no-undo.
     1519      define input  parameter i_StartString as character no-undo.
     1520      define input  parameter i_comment     as character no-undo.
     1521      define variable v_string-tmp          as character no-undo.
     1522      define variable v-bh                  as handle  no-undo .
     1523      define variable v-fh                  as handle  no-undo .
     1524      define variable vi                    as integer no-undo.
     1525      for each tt-place:
     1526         tt-place.is-error       = yes.
     1527      end.
     1528      rpt:
     1529      do vi = 1 to num-entries(i_Str,chr(10)) :
     1530         v_string-tmp = entry(vi, i_Str,chr(10)).
     1531         if index( v_string-tmp, i_comment ) > 0
     1532         then do:
     1533            v_string-tmp = substring( v_string-tmp, 1, index( v_string-tmp, i_comment ) - 1 ).
     1534         end.
     1535         if v_string-tmp = '':U
     1536         then
     1537            next rpt .
     1538         if index( v_string-tmp, i_StartString ) > 0
     1539         then do:
     1540            find first tt-place where tt-place.loc1 = trim( entry( 2, v_string-tmp, '=' ) ) no-error .
     1541            if not available tt-place
     1542            then do :
     1543              create tt-place .
     1544              assign tt-place.loc1 = trim( entry( 2, v_string-tmp, '=' ) )
     1545                     tt-place.locint   = int(tt-place.loc1)
     1546              no-error .
     1547            end.
     1548            assign
     1549                tt-place.t1             = ?
     1550                tt-place.t2             = ?
     1551                tt-place.t3             = ?
     1552                tt-place.level-total    = ?
     1553                tt-place.level-water    = ?
     1554                tt-place.total-vol      = ?
     1555                tt-place.avrg-temp      = ?
     1556                tt-place.density        = ?
     1557                tt-place.mass           = ?
     1558                tt-place.vapor-density  = ?
     1559                tt-place.vapor-pressure = ?
     1560                tt-place.volume_water   = ?
     1561                tt-place.is-error       = no
     1562                tt-place.error-message  = ?
     1563            .
     1564         end.
     1565         else do:
     1566            if not available tt-place
     1567            then
     1568               next rpt .
     1569            find first tt-param where tt-param.strfrfile = trim( entry( 1, v_string-tmp, '=' ) ) no-error.
     1570            if available tt-param
     1571            then do:
     1572               v-bh = buffer tt-place:handle.
     1573               assign
     1574                  v-fh                = v-bh:buffer-field( tt-param.strasi )
     1575                  v-fh:buffer-value() = decimal( trim( entry( 2, v_string-tmp, '=' ) ) )
     1576               no-error.
     1577               if (tt-param.flddb = "temperature"
     1578                or tt-param.flddb = "water-qnty")
     1579               and trim( entry( 2, v_string-tmp, '=' ) ) = "-"
     1580               then do :
     1581                 assign
     1582                    v-fh:buffer-value() = ?
     1583                 no-error.
     1584               end .
     1585            end.
     1586            else do:
     1587               run gbl/fileapnd.p
     1588                     ( 'revis.err'
     1589                     ,
     1590                  if trim( entry( 1, v_string-tmp, '=' ) ) = "ERROR"
     1591                  then
     1592                     substitute("&1 &2  Ошибка: &3 &4", string(today),string(time, "HH:MM:SS"),  trim( entry( 2, v_string-tmp, '=' ) ), chr(13) + chr(10))
     1593                  else
     1594                     substitute("&1 &2  Неизвестный параметр: &3 &4", string(today),string(time, "HH:MM:SS"), trim( entry( 1, v_string-tmp, '=' ) ), chr(13) + chr(10))
     1595                  ,input 10
     1596                ) no-error .
     1597            end.
     1598         end.
     1599      end.
     1600      for each tt-place:
     1601         tt-place.vapor-pressure = tt-place.vapor-pressure / 1000.
     1602      end.
     1603   end procedure.
     1604   procedure get-from-struna :
     1605     define input  parameter i-log-file-name as character no-undo.
     1606     define input  parameter i-obj-code as integer no-undo.
     1607     define variable v-comstring as character no-undo .
     1608     define variable v_File-Name as character no-undo .
     1609     define variable v_command as character no-undo .
     1610     define variable v-comment     as character no-undo.
     1611     define variable v-StartString as character no-undo.
     1612     define variable Vrevis        as longchar no-undo.
     1613     define variable vi as integer no-undo.
     1614   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crtt-rvs in g#lib-rvs ( input-output table tt-param ,
     1615                               output       v-comstring ,
     1616                               output       v-comment ,
     1617                               output       v-StartString ) no-error .
     1618       if error-status :error then do:
     1619         return error substitute( 'Ошибка при установке параметров для считывания данных с резервуаров.&1&2&1&3'
     1620                               , chr(10)
     1621                               , error-status :get-message( 1 )
     1622                               , return-value ) .
     1623       end.
     1624      v_File-Name = searchfile('revis.txt').
     1625      if v_File-Name ne ?
     1626      then do:
     1627         block-del-file:
     1628         do vi = 1 to 5:
     1629            os-delete value( v_File-Name ) .
     1630            v_File-Name = searchfile('revis.txt').
     1631            if v_File-Name eq ?
     1632            then
     1633               leave block-del-file.
     1634        end.
     1635      end.
     1636      if v_File-Name ne ?
     1637      then
     1638         return error 'Файл revis.txt заблокирован удалите файл и попробуйте еще раз. ' + v_File-Name .
     1639      if    v-comstring = '':U
     1640         or v-comstring = ?
     1641      then do:
     1642         return error 'Не задан парам. comstr в секции revision ini файла.' .
     1643      end.
     1644      v_File-Name = "wrevis" + string(random(1000000,9999999)) + ".tmp".
     1645      if searchfile(v_File-Name) ne ?
     1646      then do :
     1647         v_File-Name = "wrevis" + string(random(1000000,9999999)) + ".tmp".
     1648         if searchfile(v_File-Name) ne ?
     1649         then do :
     1650           os-delete value(searchfile(v_File-Name)) no-error .
     1651         end.
     1652         if searchfile(v_File-Name) ne ?
     1653         then
     1654           return error "Удалите все файлы wrevis*.tmp".
     1655      end.
     1656      assign
     1657         v_command = substitute( "&1 &2 &3 &4", v-comstring, string(0), v_File-Name, i-obj-code)
     1658      .
     1659      os-command silent value( v_command ) .
     1660      if searchfile(v_File-Name) ne ?
     1661      then
     1662         run readfiletxt (v_File-Name, output Vrevis).
     1663      run gbl/fileapnd.p
     1664             ( i-log-file-name
     1665             ,substitute("&1 &2  Запрос &3&4", string(today),string(time, "HH:MM:SS"), v_command, chr(13) + chr(10))
     1666             ,input 10
     1667             ) no-error .
     1668      if searchfile( v_File-Name ) = ? then do:
     1669         run gbl/fileapnd.p
     1670             ( i-log-file-name
     1671             ,substitute("Файл с прибора не получен. &1",  chr(13) + chr(10))
     1672             ,input 10
     1673             ) no-error .
     1674         return error 'Файл с прибора не получен.' .
     1675     end.
     1676     else do:
     1677         v_File-Name  = searchfile( v_File-Name ) .
     1678     end.
     1679     run gbl/fileapnd.p
     1680             ( i-log-file-name
     1681             ,substitute("&1 &2  Данные &3", string(today),string(time, "HH:MM:SS"), chr(13) + chr(10))
     1682             ,input 10
     1683             ) no-error .
     1684     os-append value(v_File-Name) value(i-log-file-name).
     1685     os-rename value( v_File-Name ) 'revis.txt'.
     1686     os-delete value( v_File-Name ) .
     1687     run gbl/fileapnd.p
     1688             ( i-log-file-name
     1689             , chr(13) + chr(10)
     1690             ,input 10
     1691             ) no-error .
     1692     run readrevisetxt (Vrevis,v-StartString,v-comment).
     1693   end procedure .
     1694   procedure get-from-ifsf :
     1695      define input  parameter i-log-file-name as character no-undo.
     1696      define input  parameter i-asi-ip        as character no-undo.
     1697      define input  parameter i-asi-port      as character no-undo.
     1698     define variable v_command     as   character     no-undo.
     1699     define variable v-log     as logical no-undo .
     1700     define variable v-bytes   as integer no-undo .
     1701     define variable v-out-data as character no-undo .
     1702     define variable v-line-str as character no-undo .
     1703     define variable ii        as integer no-undo .
     1704     define variable str       as character no-undo .
     1705     define variable str1      as character no-undo .
     1706     define variable str2      as character no-undo .
     1707     define variable hSocket   as handle no-undo .
     1708     define variable mDataIn   as memptr no-undo .
     1709     define variable mDataout  as memptr no-undo .
     1710     define variable cmd       as character no-undo .
     1711     define variable connStr   as character no-undo .
     1712     define variable v-attr-type   as character no-undo.
     1713     define variable v-comstring   as character no-undo.
     1714     define variable v-comment     as character no-undo.
     1715     define variable v-StartString as character no-undo.
     1716     define variable Vrevis        as longchar no-undo.
     1717     define variable vi as integer no-undo.
     1718   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crtt-rvs in g#lib-rvs ( input-output table tt-param ,
     1719                               output       v-comstring ,
     1720                               output       v-comment ,
     1721                               output       v-StartString ) no-error .
     1722       if error-status :error then do:
     1723         return error substitute( 'Ошибка при установке параметров для считывания данных с резервуаров.&1&2&1&3'
     1724                               , chr(10)
     1725                               , error-status :get-message( 1 )
     1726                               , return-value ) .
     1727       end.
     1728     cmd = 'KOI8-R 1 0 1' + chr(10) .
     1729     set-size(mDataIn) = 0 .
     1730     set-size(mDataIn) = length(cmd , "RAW":U) + 1 .
     1731     put-string(mDataIn,1) = cmd .
     1732     find first sys-ctrl no-lock.
     1733     if i-asi-ip eq ? or i-asi-ip eq ""
     1734     then
     1735        run db-attr-value(sys-ctrl.db,"AsiIp",output i-asi-ip,output v-attr-type).
     1736     if i-asi-port eq ? or i-asi-port eq ""
     1737     then
     1738        run db-attr-value(sys-ctrl.db,"AsiPort",output i-asi-port,output v-attr-type).
     1739     create socket hSocket .
     1740     connStr = '-H ' + i-asi-ip + ' -S ' + i-asi-port .
     1741     hSocket:connect(connStr) no-error.
     1742     run gbl/fileapnd.p
     1743             ( i-log-file-name
     1744             ,substitute("&1 &2  Запрос  connStr='-H &3  -S &4 '  cmd='KOI8-R 1 0 1'&5", string(today),string(time, "HH:MM:SS"),i-asi-ip,i-asi-port, chr(13) + chr(10))
     1745             ,input 10
     1746             ) no-error .
     1747     if hSocket:connected() = false
     1748     then do :
     1749       run gbl/fileapnd.p
     1750             ( i-log-file-name
     1751             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Не могу подключиться к IFSF серверу." , chr(13) + chr(10))
     1752             ,input 10
     1753             ) no-error .
     1754       return error "Не могу подключиться к IFSF серверу." .
     1755     end.
     1756     hSocket:set-socket-option('TCP-NODELAY', 'true').
     1757     hSocket:set-socket-option('SO-KEEPALIVE', 'true').
     1758     hSocket:set-socket-option('SO-REUSEADDR', 'true').
     1759     v-log = hSocket:write(mDataIn, 1, get-size(mDataIn)) no-error.
     1760     if v-log = false or error-status:get-message(1) <> ''
     1761     then do:
     1762       hSocket:disconnect() no-error.
     1763       run gbl/fileapnd.p
     1764             ( i-log-file-name
     1765             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Не могу отправить команду на IFSF сервер.", chr(13) + chr(10))
     1766             ,input 10
     1767             ) no-error .
     1768       return error "Не могу отправить команду на IFSF сервер." .
     1769     end.
     1770     run sleep (1000) .
     1771     set-size(mDataOut) = 0 .
     1772     v-bytes = hSocket:get-bytes-available() .
     1773     set-size(mDataOut) = v-bytes + 1 .
     1774     v-log = hSocket:read(mDataOut, 1, v-bytes, 2) no-error.
     1775     if v-log = false or error-status:get-message(1) <> ''
     1776     then do:
     1777       hSocket:disconnect() no-error.
     1778       run gbl/fileapnd.p
     1779             ( i-log-file-name
     1780             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Не могу прочитать ответ от IFSF сервера.", chr(13) + chr(10))
     1781             ,input 10
     1782             ) no-error .
     1783       return error "Не могу прочитать ответ от IFSF сервера." .
     1784     end.
     1785     v-out-data = get-string(mDataOut,1) .
     1786     if v-out-data = ""
     1787     then do :
     1788       hSocket:disconnect() no-error.
     1789       run gbl/fileapnd.p
     1790             ( i-log-file-name
     1791             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Не могу получить данные от IFSF сервера.", chr(13) + chr(10))
     1792             ,input 10
     1793             ) no-error .
     1794       return error "Не могу получить данные от IFSF сервера." .
     1795     end.
     1796     if index(v-out-data, "Bad Request") > 0
     1797     then do :
     1798       hSocket:disconnect() no-error.
     1799       run gbl/fileapnd.p
     1800             ( i-log-file-name
     1801             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Bad Request", chr(13) + chr(10))
     1802             ,input 10
     1803             ) no-error .
     1804       return error v-out-data .
     1805     end.
     1806     hSocket:disconnect() no-error.
     1807     delete object hSocket.
     1808     set-size(mDataIn) = 0.
     1809     set-size(mDataOut)   = 0.
     1810     run gbl/fileapnd.p
     1811             ( i-log-file-name
     1812             ,substitute("&1 &2  Данные &3", string(today),string(time, "HH:MM:SS"), chr(13) + chr(10))
     1813             ,input 10
     1814             ) no-error .
     1815      run gbl/fileapnd.p
     1816             ( i-log-file-name
     1817             , v-out-data
     1818             ,input 10
     1819             ) no-error .
     1820      run gbl/fileapnd.p
     1821             ( i-log-file-name
     1822             , chr(13) + chr(10)
     1823             ,input 10
     1824             ) no-error .
     1825     output to "revis.ifsf" .
     1826     do vi = 1 to num-entries(v-out-data, chr(10)) :
     1827       put unformatted entry(vi, v-out-data, chr(10)) skip .
     1828     end.
     1829     output close.
     1830     run readrevisetxt (v-out-data,v-StartString,v-comment).
     1831   end procedure .
     1832   procedure parse-xml :
     1833     define input parameter iStr as longchar .
     1834     define variable hDoc              as handle     no-undo .
     1835     define variable hRoot             as handle     no-undo .
     1836     for each tt-place:
     1837         tt-place.is-error       = yes.
     1838     end.
     1839     CREATE X-DOCUMENT hDoc.
     1840     CREATE X-NODEREF hRoot.
     1841     hDoc:LOAD("longchar",iStr,FALSE).
     1842     hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     1843     RUN GetChildren(hRoot, 1).
     1844     DELETE OBJECT hDoc.
     1845     DELETE OBJECT hRoot.
     1846   end procedure .
     1847   PROCEDURE GetChildren:
     1848   DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     1849   DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     1850   DEFINE VARIABLE i AS INTEGER NO-UNDO.
     1851   DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     1852   DEFINE VARIABLE hText    AS HANDLE NO-UNDO.
     1853   define variable client   as character no-undo.
     1854   define variable good                as logical   no-undo .
     1855   define variable v-asi-error-code    as integer   no-undo initial 0 .
     1856   define variable v-asi-error-message as character no-undo .
     1857   CREATE X-NODEREF hNoderef.
     1858   CREATE X-NODEREF hText .
     1859   REPEAT i = 1 TO hParent:NUM-CHILDREN:
     1860       good = hParent:GET-CHILD(hNoderef,i).
     1861       IF NOT good THEN
     1862           LEAVE.
     1863       IF hNoderef:SUBTYPE <> "element" THEN
     1864           NEXT.
     1865       hNoderef:GET-CHILD(hText, 1) no-error .
     1866       IF hNoderef:NAME = "ErrNum"
     1867       then do :
     1868         v-asi-error-code = integer(hText:node-value) no-error .
     1869       end .
     1870       IF hNoderef:NAME = "ErrMsg"
     1871       then do :
     1872         v-asi-error-message = hText:node-value no-error .
     1873         if     v-asi-error-code > 0
     1874            and v-asi-error-code ne 2
     1875         then do :
     1876           assign
     1877             tt-place.t1             = ?
     1878             tt-place.t2             = ?
     1879             tt-place.t3             = ?
     1880             tt-place.level-total    = ?
     1881             tt-place.level-water    = ?
     1882             tt-place.total-vol      = ?
     1883             tt-place.avrg-temp      = ?
     1884             tt-place.density        = ?
     1885             tt-place.mass           = ?
     1886             tt-place.vapor-density  = ?
     1887             tt-place.vapor-pressure = ?
     1888             tt-place.volume_water   = ?
     1889             tt-place.is-error       = true
     1890             tt-place.error-message  = v-asi-error-message
     1891           .
     1892         end .
     1893       end .
     1894       IF hNoderef:NAME = "Tank"
     1895       then do :
     1896         find first tt-place where tt-place.loc1 = hText:node-value no-error .
     1897         if not available tt-place
     1898         then do :
     1899           create tt-place .
     1900           assign tt-place.loc1     = hText:node-value
     1901                  tt-place.locint   = int(tt-place.loc1)
     1902           no-error .
     1903         end.
     1904         assign
     1905             v-asi-error-code        = 0
     1906             tt-place.t1             = ?
     1907             tt-place.t2             = ?
     1908             tt-place.t3             = ?
     1909             tt-place.level-total    = ?
     1910             tt-place.level-water    = ?
     1911             tt-place.total-vol      = ?
     1912             tt-place.avrg-temp      = ?
     1913             tt-place.density        = ?
     1914             tt-place.mass           = ?
     1915             tt-place.vapor-density  = ?
     1916             tt-place.vapor-pressure = ?
     1917             tt-place.volume_water   = ?
     1918             tt-place.is-error       = no
     1919             tt-place.error-message  = ?
     1920         .
     1921       end.
     1922       if    v-asi-error-code = 0
     1923          or v-asi-error-code = 2
     1924       then do :
     1925         IF hNoderef:NAME = "LevelTotal" then assign tt-place.level-total = decimal(hText:node-value) / 10 no-error .
     1926         IF hNoderef:NAME = "LevelWater" then assign tt-place.level-water = decimal(hText:node-value) / 10 no-error .
     1927         IF hNoderef:NAME = "Temperature" then assign tt-place.avrg-temp = decimal(hText:node-value) no-error .
     1928         IF hNoderef:NAME = "Density" then assign tt-place.density = decimal(hText:node-value) no-error .
     1929         IF hNoderef:NAME = "VolumeTotal" then assign tt-place.total-vol = decimal(hText:node-value) no-error .
     1930         IF hNoderef:NAME = "MassTotal" then assign tt-place.mass = decimal(hText:node-value) no-error .
     1931         IF hNoderef:NAME = "VaporDensity" then assign tt-place.vapor-density = decimal(hText:node-value) no-error .
     1932         IF hNoderef:NAME = "VaporPressure" then assign tt-place.vapor-pressure = decimal(hText:node-value) / 1000 no-error .
     1933         IF hNoderef:NAME = "Temperature1" then assign tt-place.t1 = decimal(hText:node-value) no-error .
     1934         IF hNoderef:NAME = "Temperature2" then assign tt-place.t2 = decimal(hText:node-value) no-error .
     1935         IF hNoderef:NAME = "Temperature3" then assign tt-place.t3 = decimal(hText:node-value) no-error .
     1936       end .
     1937       RUN GetChildren(hNoderef, (level + 1)).
     1938   END.
     1939   DELETE OBJECT hNoderef.
     1940   DELETE OBJECT hText.
     1941   END PROCEDURE.
     1942   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1943   run gbl/getobjsrvhndl.p (input-output ObjSrv).
