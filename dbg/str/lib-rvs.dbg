     6988                input (if izmer-density <> ? then izmer-density * 1000 else bf_rvs-line.state-density * 1000 ),
     6989                input temp-for-pomi,
     6990                input ToolType,
     6991                input DeltaOtn_K,
     6992                input DeadZone_Reservoir,
     6993                input A_Reservoir,
     6994                input A_LevelMeasurementTool,
     6995                input ToolAutomationLevel_H,
     6996                input ToolAutomationLevel_H_Water,
     6997                input ToolAutomationLevel_R,
     6998                input ToolAutomationLevel_Tv,
     6999                input ToolAutomationLevel_Tr,
     7000                input DeltaAbs_H_CalcType,
     7001                input DeltaAbs_H_Water_CalcType,
     7002                input DeltaAbs_H,
     7003                input DeltaAbs_H_Water,
     7004                input DeltaAbs_R,
     7005                input DeltaAbs_Tv,
     7006                input DeltaAbs_Tr,
     7007                input DeltaOtn_N,
     7008                input 1,
     7009                input 2,
     7010                input 2,
     7011                output V_total,
     7012                output V_water,
     7013                output DeltaV,
     7014                output V_product,
     7015                output Vcy,
     7016                output Rcy,
     7017                output V,
     7018                output CTL_base_alt,
     7019                output CPL_base_alt,
     7020                output CTPL_base_alt,
     7021                output Fp_base_alt,
     7022                output CTL_obs_base,
     7023                output CPL_obs_base,
     7024                output CTPL_obs_base,
     7025                output Fp_obs_base,
     7026                output Rv,
     7027                output DeltaOtn_Vcy,
     7028                output DeltaOtn_Vm,
     7029                output M,
     7030                output DeltaOtn_M,
     7031                output VolumetricExpansion,
     7032                output vErr,
     7033                output vWrn,
     7034                output vDllVersion)
     7035             no-error .
     7036           end.
     7037         end .
     7038         if is-sug(bf_rvs-line.gds-code)
     7039         then do :
     7040           OUTPUT stream outstream to value ("pomi.log") append.
     7041           PUT STREAM outstream  unformatted
     7042             "    " SKIP
     7043             "    " SKIP
     7044             cur-time-string()           FORMAT "x(16)"    SKIP
     7045             'Процедура   "'              v-proc       '"'           FORMAT "x(128)"        SKIP
     7046             'Версия dll: '              vDllVersion                                SKIP
     7047             'CODE_PL                = ' bf_rvs-line.pl-code                                SKIP
     7048             'H                      = ' bf_rvs-line.level-total * 10            SKIP
     7049             'CalibrationTable       = ' CalibTable                              SKIP
     7050             'T                      = ' bf_rvs-line.state-temperature           SKIP
     7051             'R_liquid               = ' trim(string(bf_rvs-line.state-density * 1000, ">>>9.9<"))  SKIP
     7052             'R_gas                  = ' trim(string((if state-vapor-density <> ? then (state-vapor-density * 1000) else (vapor-density * 1000)), ">>>9.9<"))  SKIP
     7053             'A_Reservoir            = ' A_Reservoir                                   SKIP
     7054             'DeltaOtn_K             = ' DeltaOtn_K                                    SKIP
     7055             'DeltaOtn_K_Full        = ' DeltaOtn_K_Full                               SKIP
     7056             'DeltaAbs_H             = ' DeltaAbs_H                                    SKIP
     7057             'DeltaAbs_R_liquid      = ' DeltaAbs_R_liquid                             SKIP
     7058             'DeltaAbs_R_gas         = ' DeltaAbs_R_gas                                SKIP
     7059             'DeltaOtn_N             = ' DeltaOtn_N                                    SKIP
     7060             'Use_DeltaOtn_R_liquid_IN = ' Use_DeltaOtn_R_liquid_IN                    SKIP
     7061             'DeltaOtn_R_liquid_IN     = ' DeltaOtn_R_liquid_IN                        SKIP
     7062             'Round_M                = ' 1                                             SKIP
     7063             'Round_T                = ' 2                                             SKIP
     7064             'Round_R                = ' 2                                             SKIP
     7065           .
     7066           output stream outstream close.
     7067           if C_HN = 0 then
     7068           do:
     7069             error-string = substitute("~nРезервуар: &1.~n", bf_place.loc1) + "Ошибка входного параметра CalibrationTable. Библеотека ПОкМИ вернула C_HN = 0." .
     7070             output stream outstream to value ("pomi.log")  append.
     7071             put stream outstream error-string skip.
     7072             output stream outstream close.
     7073             undo _trpomi, return error substitute('Ошибка входных параметров в библиотеку ПОкМИ.~n &1',error-string).
     7074           end.
     7075           if trim(vErr) > "" then do :
     7076             error-string = substitute("~nРезервуар: &1.~n", if avail bf_place then bf_place.loc1 else "")
     7077                          + replace(vErr,";0x","~n0x") .
     7078             output stream outstream to value ("pomi.log")  append.
     7079             put stream outstream error-string format "X(1024)" skip.
     7080             output stream outstream close.
     7081             undo _trpomi, return error substitute('Ошибка работы библиотеки ПОкМИ &1',error-string) .
     7082           end.
     7083           if tt-meas-file.log-brutto = no
     7084           or pl-rvd-lvl
     7085           or pl-rvd-dens
     7086           or pl-rvd-temp
     7087           then do :
     7088             find first rvs-line-attr exclusive-lock
     7089                 where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7090                 and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7091                 and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7092                 and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7093                 and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7094                 and rvs-line-attr.attr-code = "delta-mass-qnty" no-error.
     7095             if available rvs-line-attr then
     7096             do :
     7097               if M > 200000 then rvs-line-attr.attr-value = "0.5" . else rvs-line-attr.attr-value = "0.65".
     7098             end.
     7099             else
     7100             do :
     7101               create rvs-line-attr.
     7102               assign
     7103                 rvs-line-attr.obj-code   = bf_rvs-line.obj-code
     7104                 rvs-line-attr.obj-type   = bf_rvs-line.obj-type
     7105                 rvs-line-attr.gds-code   = bf_rvs-line.gds-code
     7106                 rvs-line-attr.pl-code    = bf_rvs-line.pl-code
     7107                 rvs-line-attr.rvs-code   = bf_rvs-line.rvs-code
     7108                 rvs-line-attr.attr-code  = "delta-mass-qnty"
     7109               .
     7110               if M > 200000 then rvs-line-attr.attr-value = "0.5". else rvs-line-attr.attr-value = "0.65"  .
     7111             end.
     7112             ASSIGN
     7113               bf_rvs-line.state-measure-tc-qnty  = V_liquid * 1000
     7114               bf_rvs-line.state-measure-qnty  = V_liquid * 1000
     7115               bf_rvs-line.state-measure-cli-qnty = M
     7116               bf_rvs-line.state-brutto-qnty = bf_rvs-line.state-measure-qnty + tt-meas-file.water-qnty
     7117               bf_rvs-line.state-brutto-cli-qnty = bf_rvs-line.state-measure-cli-qnty + tt-meas-file.water-qnty
     7118             .
     7119             if bf_rvs-line.state-brutto-qnty = ? then bf_rvs-line.state-brutto-qnty = bf_rvs-line.state-measure-qnty .
     7120             if bf_rvs-line.state-brutto-cli-qnty = ? then bf_rvs-line.state-brutto-cli-qnty = bf_rvs-line.state-measure-cli-qnty .
     7121             find first rvs-line-attr exclusive-lock
     7122                  where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7123                    and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7124                    and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7125                    and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7126                    and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7127                    and rvs-line-attr.attr-code = "state-vol-pf-sug" no-error.
     7128             if not available rvs-line-attr then do :
     7129               create rvs-line-attr.
     7130               assign
     7131                 rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7132                 rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7133                 rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7134                 rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7135                 rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7136                 rvs-line-attr.attr-code = "state-vol-pf-sug"
     7137                 rvs-line-attr.attr-value = string(V_Gas * 1000)
     7138               .
     7139             end.
     7140             else do :
     7141               rvs-line-attr.attr-value = string(V_Gas * 1000) .
     7142             end.
     7143           end .
     7144           output stream outstream to value ("pomi.log")  append.
     7145           put stream outstream unformatted
     7146             "C_HN              = " C_HN    skip
     7147             "C_HN_delta        = " C_HN_delta          skip
     7148             "C_full            = " C_full SKIP
     7149             "V_liquid          = " V_liquid  SKIP
     7150             "V_gas             = " V_gas   SKIP
     7151             "M_liquid          = " M_liquid  SKIP
     7152             "M_gas             = " M_gas  SKIP
     7153             "M                 = " M   SKIP
     7154             "Kf                = " Kf  SKIP
     7155             "DeltaOtn_H        = " DeltaOtn_H SKIP
     7156             "DeltaOtn_R_liquid = " DeltaOtn_R_liquid  SKIP
     7157             "DeltaOtn_R_gas    = " DeltaOtn_R_gas  SKIP
     7158             "DeltaOtn_M_liquid = " DeltaOtn_M_liquid SKIP
     7159             "DeltaOtn_M_gas    = " DeltaOtn_M_gas  SKIP
     7160             "DeltaOtn_M        = " DeltaOtn_M  SKIP
     7161             "H_min_liquid      = " H_min_liquid  SKIP
     7162             "H_min             = " H_min  SKIP
     7163             "A                 = " A  SKIP
     7164             "B                 = " B  SKIP
     7165             "Warnings          = " vWrn SKIP
     7166           .
     7167           output stream outstream close.
     7168           assign
     7169             v-POkMI-result-attr =
     7170               "Общая масса СУГ, кг: " + string(M, "->>,>>>,>>9.9":U) + chr(10) +
     7171               "Относительная погрешность измерения массы СУГ, %: "  + string(DeltaOtn_M, ">>>>>>>9.99") + chr(10) +
     7172               "Объем ЖФ СУГ, л: " + string((V_liquid * 1000), "->>,>>>,>>9":U) + chr(10) +
     7173               "Объем ПФ СУГ, л: " + string((V_gas * 1000), "->>,>>>,>>9":U) + chr(10)
     7174           .
     7175           find first rvs-line-attr exclusive-lock
     7176                 where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7177                   and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7178                   and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7179                   and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7180                   and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7181                   and rvs-line-attr.attr-code = "POkMI-result" no-error.
     7182           if available rvs-line-attr then do :
     7183             rvs-line-attr.attr-value = v-POkMI-result-attr .
     7184           end.
     7185           else do :
     7186             create rvs-line-attr.
     7187             assign
     7188               rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7189               rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7190               rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7191               rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7192               rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7193               rvs-line-attr.attr-code = "POkMI-result"
     7194               rvs-line-attr.attr-value = v-POkMI-result-attr
     7195             .
     7196           end.
     7197           find first rvs-line-attr exclusive-lock
     7198                 where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7199                   and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7200                   and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7201                   and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7202                   and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7203                   and rvs-line-attr.attr-code = "POkMI-warnings" no-error.
     7204           if available rvs-line-attr then do :
     7205             rvs-line-attr.attr-value = vWrn .
     7206           end.
     7207           else do :
     7208             create rvs-line-attr.
     7209             assign
     7210               rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     7211               rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     7212               rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     7213               rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     7214               rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     7215               rvs-line-attr.attr-code = "POkMI-warnings"
     7216               rvs-line-attr.attr-value = vWrn
     7217             .
     7218           end.
     7219           output stream outstream close.
     7220         end .
     7221         else do :
     7222           OUTPUT stream outstream to value ("pomi.log") append.
     7223           PUT STREAM outstream unformatted
     7224             "    " SKIP
     7225             "    " SKIP
     7226             cur-time-string()           FORMAT "x(16)"    SKIP
     7227             'Процедура   "'              v-proc       '"'           FORMAT "x(128)"   SKIP
     7228             'Версия dll: '              vDllVersion                           SKIP
     7229             'CODE_PL                     = ' bf_rvs-line.pl-code                      SKIP
     7230             'H                           = ' bf_rvs-line.state-level-total * 10 SKIP
     7231             'H_water                     = ' (if bf_rvs-line.state-level-water <> ? then bf_rvs-line.state-level-water * 10 else 0.0) SKIP
     7232             'CalibrationTable            = ' CalibTable                    SKIP
     7233             'CalibrationBelt             = ' CalibBelt                    SKIP
     7234             'ToolAutomationLevel_H       = ' ToolAutomationLevel_H     SKIP
     7235             'ToolAutomationLevel_H_Water = ' ToolAutomationLevel_H_Water    SKIP
     7236             'ToolAutomationLevel_R       = ' ToolAutomationLevel_R     SKIP
     7237             'ToolAutomationLevel_Tv      = ' ToolAutomationLevel_Tv    SKIP
     7238             'ToolAutomationLevel_Tr      = ' ToolAutomationLevel_Tr    SKIP
     7239             'DeltaAbs_H_CalcType         = ' DeltaAbs_H_CalcType       SKIP
