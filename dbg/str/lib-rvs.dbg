     6522                                                   and water2_pl-level.obj-code = bf_rvs-line.obj-code
     6523                                                   and water2_pl-level.obj-type = bf_rvs-line.obj-type
     6524                                                   and water2_pl-level.pl-level >= bf_rvs-line.state-level-water
     6525                                                   no-error .
