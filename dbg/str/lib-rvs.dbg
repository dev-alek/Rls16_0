     4972     end .
     4973     find first rvs-line-attr exclusive-lock
     4974          where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     4975            and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     4976            and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     4977            and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     4978            and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     4979            and rvs-line-attr.attr-code = "input-type-p" no-error.
     4980     if not available rvs-line-attr then do :
     4981       create rvs-line-attr.
     4982       assign
     4983         rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     4984         rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     4985         rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     4986         rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     4987         rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     4988         rvs-line-attr.attr-code = "input-type-p"
     4989       .
     4990     end.
     4991     rvs-line-attr.attr-value = 'а' .
     4992     find first rvs-line-attr exclusive-lock
     4993          where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     4994            and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     4995            and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     4996            and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     4997            and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     4998            and rvs-line-attr.attr-code = "input-type-t" no-error.
     4999     if not available rvs-line-attr then do :
     5000       create rvs-line-attr.
     5001       assign
     5002         rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5003         rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5004         rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5005         rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5006         rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5007         rvs-line-attr.attr-code = "input-type-t"
     5008       .
     5009     end.
     5010     rvs-line-attr.attr-value = 'а' .
     5011     find first rvs-line-attr exclusive-lock
     5012          where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5013            and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5014            and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5015            and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5016            and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5017            and rvs-line-attr.attr-code = "input-type-l" no-error.
     5018     if not available rvs-line-attr then do :
     5019       create rvs-line-attr.
     5020       assign
     5021         rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5022         rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5023         rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5024         rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5025         rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5026         rvs-line-attr.attr-code = "input-type-l"
     5027       .
     5028     end.
     5029     rvs-line-attr.attr-value = 'а' .
     5030   place-asi-sertif = no .
     5031   run placelib_get-attr  ( input "place-asi-sertif"
     5032                         ,input p-obj-code
     5033                         ,input p-obj-type
     5034                         ,input p-pl-code
     5035                         ,output v-value
     5036                         ,output v-ok      ) no-error.
     5037   if v-ok then place-asi-sertif = logical(v-value) .
     5038   if ptrlprop-olddens = true
     5039   then do:
     5040     if tt-meas.density = 0 then do:
     5041       assign
     5042         tt-meas.density                    = bf_rvs-line.state-density
     5043       .
     5044       find first rvs-line-attr exclusive-lock
     5045            where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5046              and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5047              and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5048              and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5049              and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5050              and rvs-line-attr.attr-code = "is-olddens" no-error.
     5051       if not available rvs-line-attr then do :
     5052         create rvs-line-attr.
     5053         assign
     5054           rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5055           rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5056           rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5057           rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5058           rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5059           rvs-line-attr.attr-code = "is-olddens"
     5060         .
     5061       end.
     5062       rvs-line-attr.attr-value = 'yes' .
     5063     end.
     5064     else do :
     5065       find first rvs-line-attr exclusive-lock
     5066            where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5067              and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5068              and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5069              and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5070              and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5071              and rvs-line-attr.attr-code = "is-olddens" no-error.
     5072       if not available rvs-line-attr then do :
     5073         create rvs-line-attr.
     5074         assign
     5075           rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5076           rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5077           rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5078           rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5079           rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5080           rvs-line-attr.attr-code = "is-olddens"
     5081         .
     5082       end.
     5083       rvs-line-attr.attr-value = 'no' .
     5084     end.
     5085    end.
     5086     assign
     5087       sug-density = tt-meas.density
     5088       vapor-density = tt-meas.vapor-density
     5089       state-vapor-density = tt-meas.vapor-density
     5090       vapor-pressure = tt-meas.vapor-pressure
     5091       state-vapor-pressure = tt-meas.vapor-pressure
     5092       sug-water-qnty = tt-meas.water-qnty
     5093     .
     5094     if is-sug(bf_rvs-line.gds-code)
     5095     then do :
     5096       assign
     5097         bf_rvs-line.temperature            = tt-meas.temperature
     5098         bf_rvs-line.state-temperature      = bf_rvs-line.temperature
     5099         bf_rvs-line.density                = tt-meas.density
     5100         bf_rvs-line.state-density          = if bf_rvs-line.density > 0 then bf_rvs-line.density else bf_rvs-line.state-density
     5101       .
     5102       if bf_rvs-line.level-petrol = 0
     5103       or bf_rvs-line.level-petrol = ?
     5104       then do :
     5105         bf_rvs-line.level-petrol = bf_rvs-line.level-total - (if bf_rvs-line.level-water <> ? then bf_rvs-line.level-water else 0) .
     5106       end .
     5107       assign
     5108         bf_rvs-line.measure-qnty           = tt-meas.brutto-qnty
     5109         bf_rvs-line.measure-tc-qnty        = bf_rvs-line.measure-qnty
     5110         bf_rvs-line.brutto-qnty            = tt-meas.brutto-qnty + bf_rvs-line.add-qnty
     5111         bf_rvs-line.measure-cli-qnty       = tt-meas.brutto-cli-qnty
     5112         bf_rvs-line.brutto-cli-qnty        = tt-meas.brutto-cli-qnty + (bf_rvs-line.add-qnty * bf_rvs-line.density)
     5113       .
     5114       assign
     5115         bf_rvs-line.state-level-petrol      = bf_rvs-line.level-petrol
     5116         bf_rvs-line.state-level-total       = bf_rvs-line.level-total
     5117         bf_rvs-line.state-brutto-cli-qnty   = bf_rvs-line.brutto-cli-qnty
     5118         bf_rvs-line.state-measure-cli-qnty  = bf_rvs-line.measure-cli-qnty
     5119         bf_rvs-line.state-measure-qnty      = bf_rvs-line.measure-qnty
     5120         bf_rvs-line.state-brutto-qnty       = bf_rvs-line.brutto-qnty
     5121         bf_rvs-line.state-measure-tc-qnty   = bf_rvs-line.measure-tc-qnty
     5122       .
     5123     end .
     5124     else do :
     5125       assign
     5126         bf_rvs-line.temperature            = tt-meas.temperature
     5127         bf_rvs-line.state-temperature      = bf_rvs-line.temperature
     5128         bf_rvs-line.density                = if tt-meas.density > 0 then tt-meas.density else  bf_rvs-line.state-density
     5129         bf_rvs-line.brutto-cli-qnty        = if bf_rvs-line.brutto-cli-qnty <> 0 then bf_rvs-line.brutto-cli-qnty else bf_rvs-line.brutto-qnty * bf_rvs-line.density
     5130         bf_rvs-line.measure-cli-qnty       = if bf_rvs-line.measure-cli-qnty <> 0 then bf_rvs-line.measure-cli-qnty else bf_rvs-line.measure-qnty * bf_rvs-line.density
     5131         bf_rvs-line.state-density          = if bf_rvs-line.density > 0 then bf_rvs-line.density else bf_rvs-line.state-density
     5132         bf_rvs-line.state-measure-cli-qnty = bf_rvs-line.state-measure-qnty * bf_rvs-line.state-density
     5133         bf_rvs-line.state-brutto-cli-qnty  = bf_rvs-line.state-brutto-qnty  * bf_rvs-line.state-density
     5134       .
     5135       find first rvs-line-attr exclusive-lock
     5136           where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5137             and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5138             and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5139             and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5140             and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5141             and rvs-line-attr.attr-code = "temp-izm-vol" no-error.
     5142       if available rvs-line-attr
     5143       then do :
     5144         rvs-line-attr.attr-value = string(?) .
     5145       end .
     5146     end .
     5147       run placelib_get-attr  ( input "place-twice-code"
     5148           ,input p-obj-code
     5149           ,input p-obj-type
     5150           ,input p-pl-code
     5151           ,output v-value
     5152           ,output v-ok      ) no-error.
     5153       if v-ok then pl-twice-code = v-value .
     5154       if pl-twice-code <> "" then
     5155       do:
     5156           if is-sug(bf_rvs-line.gds-code)
     5157           then do :
     5158             find first place no-lock where place.obj-type = p-obj-type
     5159                                        and place.obj-code = p-obj-code
     5160                                        and place.pl-code  = p-pl-code
     5161                                        no-error .
     5162             if tt-meas.measure-qnty = 0 then tt-meas.measure-qnty = tt-meas.brutto-qnty .
     5163             if tt-meas.measure-cli-qnty = 0 then tt-meas.measure-cli-qnty = tt-meas.brutto-cli-qnty .
     5164             twice-place-data = "Резервуар " + (if available place then place.loc1 else tt-meas.loc1) + chr(10) +
     5165                                "Объем СУГ:       " + string(tt-meas.measure-qnty) + chr(10) +
     5166                                "Общий объем:     " + string(tt-meas.brutto-qnty) + chr(10) +
     5167                                "Масса СУГ:       " + string(tt-meas.measure-cli-qnty) + chr(10) +
     5168                                "Общая масса:     " + string(tt-meas.brutto-cli-qnty) + chr(10) +
     5169                                "Плотность:       " + string(tt-meas.density, ">>>9.9<<<") + chr(10) +
     5170                                "Температура:     " + (if tt-meas.temperature = ? then "?" else string(tt-meas.temperature)) + chr(10) +
     5171                                "Общий уровень:   " + string(tt-meas.level-total) + chr(10) +
     5172                                "Уровень СУГ:     " + string(tt-meas.level-petrol) + chr(10) +
     5173                                "Уровень воды:    " + string(tt-meas.level-water) + chr(10) +
     5174                                "Вода:            " + (if tt-meas.water-qnty = ? then "?" else string(tt-meas.water-qnty)) + chr(10) +
     5175                                "Плотность ПФ:    " + string(tt-meas.vapor-density, ">>>9.9<<<") + chr(10) +
     5176                                "Давление:        " + string(tt-meas.vapor-pressure, ">>>9.9<<<")
     5177                                .
     5178             find first rvs-line-attr exclusive-lock
     5179                   where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5180                     and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5181                     and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5182                     and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5183                     and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5184                     and rvs-line-attr.attr-code = "twice-place-data" no-error.
     5185             if available rvs-line-attr then do :
     5186               rvs-line-attr.attr-value = twice-place-data .
     5187             end.
     5188             else do :
     5189               create rvs-line-attr.
     5190               assign
     5191                 rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5192                 rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5193                 rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5194                 rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5195                 rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5196                 rvs-line-attr.attr-code = "twice-place-data"
     5197                 rvs-line-attr.attr-value = twice-place-data
     5198               .
     5199             end.
     5200           end.
     5201           if num-entries(pl-twice-code) > 1
     5202           then do :
     5203             twice-num = 1 .
     5204             do ii = 1 to num-entries(pl-twice-code) :
     5205               find first buf_tt-meas
     5206                 where buf_tt-meas.obj-type = p-obj-type
     5207                 and buf_tt-meas.obj-code = p-obj-code
     5208                 and buf_tt-meas.loc1  = entry(ii, pl-twice-code)
     5209                 no-error.
     5210               if available buf_tt-meas
     5211               then do :
     5212                 twice-num = twice-num + 1 .
     5213                 if is-sug(bf_rvs-line.gds-code)
     5214                 then do :
     5215                   assign
     5216                    sug-density = sug-density + buf_tt-meas.density
     5217                      vapor-density = vapor-density + buf_tt-meas.vapor-density
     5218                      vapor-pressure = vapor-pressure + buf_tt-meas.vapor-pressure
     5219                      state-vapor-density = state-vapor-density + buf_tt-meas.vapor-density
     5220                    state-vapor-pressure = state-vapor-pressure + buf_tt-meas.vapor-pressure
     5221                      sug-water-qnty = sug-water-qnty + buf_tt-meas.water-qnty
     5222                     .
     5223                   if buf_tt-meas.measure-qnty = 0 then buf_tt-meas.measure-qnty = buf_tt-meas.brutto-qnty .
     5224                   if buf_tt-meas.measure-cli-qnty = 0 then buf_tt-meas.measure-cli-qnty = buf_tt-meas.brutto-cli-qnty .
     5225                   twice-place-data = "Резервуар " + buf_tt-meas.loc1 + chr(10) +
     5226                                      "Объем СУГ:       " + string(buf_tt-meas.measure-qnty) + chr(10) +
     5227                                      "Общий объем:     " + string(buf_tt-meas.brutto-qnty) + chr(10) +
     5228                                      "Масса СУГ:       " + string(buf_tt-meas.measure-cli-qnty) + chr(10) +
     5229                                      "Общая масса:     " + string(buf_tt-meas.brutto-cli-qnty) + chr(10) +
     5230                                      "Плотность:       " + string(buf_tt-meas.density, ">>>9.9<<<") + chr(10) +
     5231                                      "Температура:     " + (if buf_tt-meas.temperature = ? then "?" else string(buf_tt-meas.temperature)) + chr(10) +
     5232                                      "Общий уровень:   " + string(buf_tt-meas.level-total) + chr(10) +
     5233                                      "Уровень СУГ:     " + string(buf_tt-meas.level-petrol) + chr(10) +
     5234                                      "Уровень воды:    " + string(buf_tt-meas.level-water) + chr(10) +
     5235                                      "Вода:            " + (if tt-meas.water-qnty = ? then "?" else string(tt-meas.water-qnty)) + chr(10) +
     5236                                      "Плотность ПФ:    " + string(buf_tt-meas.vapor-density, ">>>9.9<<<") + chr(10) +
     5237                                      "Давление:        " + string(buf_tt-meas.vapor-pressure , ">>>9.9<<<")
     5238                                      .
     5239                   find first rvs-line-attr exclusive-lock
     5240                         where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5241                           and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5242                           and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5243                           and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5244                           and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5245                           and rvs-line-attr.attr-code = "twice-place-data" no-error.
     5246                   if available rvs-line-attr then do :
     5247                     rvs-line-attr.attr-value = rvs-line-attr.attr-value + chr(10) + chr(10) + twice-place-data .
     5248                   end.
     5249                   else do :
     5250                     create rvs-line-attr.
     5251                     assign
     5252                       rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5253                       rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5254                       rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5255                       rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5256                       rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5257                       rvs-line-attr.attr-code = "twice-place-data"
     5258                       rvs-line-attr.attr-value = twice-place-data
     5259                     .
     5260                   end.
     5261                 end.
     5262                     if not is-sug(bf_rvs-line.gds-code)
     5263                     then do :
     5264                     if place-asi-sertif then
     5265                     do:
     5266                     assign
     5267                         bf_rvs-line.measure-qnty           = bf_rvs-line.measure-qnty + buf_tt-meas.measure-qnty
     5268                         bf_rvs-line.brutto-qnty            = bf_rvs-line.brutto-qnty + buf_tt-meas.brutto-qnty
     5269                         bf_rvs-line.measure-cli-qnty       = bf_rvs-line.measure-cli-qnty + (if buf_tt-meas.measure-cli-qnty <> 0 then buf_tt-meas.measure-cli-qnty else buf_tt-meas.measure-qnty * buf_tt-meas.density)
     5270                         bf_rvs-line.brutto-cli-qnty        = bf_rvs-line.brutto-cli-qnty  + (if buf_tt-meas.brutto-cli-qnty <> 0 then buf_tt-meas.brutto-cli-qnty else buf_tt-meas.brutto-qnty * buf_tt-meas.density)
     5271                         bf_rvs-line.temperature            = (bf_rvs-line.temperature + buf_tt-meas.temperature)
     5272                         bf_rvs-line.level-total            = (bf_rvs-line.level-total + buf_tt-meas.level-total)
     5273                         bf_rvs-line.level-petrol           = (bf_rvs-line.level-petrol + buf_tt-meas.level-petrol)
     5274                         bf_rvs-line.level-water            = (bf_rvs-line.level-water + buf_tt-meas.level-water)
     5275                         bf_rvs-line.temp-layer1            = (bf_rvs-line.temp-layer1 + buf_tt-meas.temp-layer1)
     5276                         bf_rvs-line.temp-layer2            = (bf_rvs-line.temp-layer2  + buf_tt-meas.temp-layer2)
     5277                         bf_rvs-line.temp-layer3            = (bf_rvs-line.temp-layer3 +  buf_tt-meas.temp-layer3)
     5278                         bf_rvs-line.measure-tc-qnty        = bf_rvs-line.measure-tc-qnty  + buf_tt-meas.measure-tc-qnty
     5279                         bf_rvs-line.brutto-tc-qnty         = bf_rvs-line.brutto-tc-qnty +  buf_tt-meas.brutto-tc-qnty
     5280                     .
     5281                   end.
     5282                   else do :
     5283                     assign
     5284                         bf_rvs-line.measure-cli-qnty       = (bf_rvs-line.measure-qnty * bf_rvs-line.density) + (buf_tt-meas.measure-qnty * buf_tt-meas.density)
     5285                         bf_rvs-line.brutto-cli-qnty        = (bf_rvs-line.brutto-qnty * bf_rvs-line.density)  + (buf_tt-meas.brutto-qnty * buf_tt-meas.density)
     5286                         bf_rvs-line.measure-qnty           = bf_rvs-line.measure-qnty + buf_tt-meas.measure-qnty
     5287                         bf_rvs-line.brutto-qnty            = bf_rvs-line.brutto-qnty + buf_tt-meas.brutto-qnty
     5288                         bf_rvs-line.temperature            = (bf_rvs-line.temperature + buf_tt-meas.temperature)
     5289                         bf_rvs-line.level-total            = (bf_rvs-line.level-total + buf_tt-meas.level-total)
     5290                         bf_rvs-line.level-petrol           = (bf_rvs-line.level-petrol + buf_tt-meas.level-petrol)
     5291                         bf_rvs-line.level-water            = (bf_rvs-line.level-water + buf_tt-meas.level-water)
