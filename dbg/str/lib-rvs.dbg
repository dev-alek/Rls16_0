     5867                                      and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5868                                      and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5869                                      and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5870                                      and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5871                                      and rvs-line-attr.attr-code = "temp-izm-vol" no-error.
     5872                                 if not available rvs-line-attr then do :
     5873                                   create rvs-line-attr.
     5874                                   assign
     5875                                     rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5876                                     rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5877                                     rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5878                                     rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5879                                     rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5880                                     rvs-line-attr.attr-code = "temp-izm-vol"
     5881                                   .
     5882                                 end.
     5883                                 rvs-line-attr.attr-value = string(bf_rvs-line.state-temperature) .
     5884                               end .
     5885                               find first prev_rvs-line-attr no-lock
     5886                                    where prev_rvs-line-attr.obj-code  = prev_rvs-line.obj-code
     5887                                      and prev_rvs-line-attr.obj-type  = prev_rvs-line.obj-type
     5888                                      and prev_rvs-line-attr.gds-code  = prev_rvs-line.gds-code
     5889                                      and prev_rvs-line-attr.pl-code   = prev_rvs-line.pl-code
     5890                                      and prev_rvs-line-attr.rvs-code  = prev_rvs-line.rvs-code
     5891                                      and prev_rvs-line-attr.attr-code = "mi-dnst" no-error.
     5892                               if available prev_rvs-line-attr
     5893                               then do :
     5894                                 find first rvs-line-attr exclusive-lock
     5895                                    where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5896                                      and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5897                                      and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5898                                      and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5899                                      and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5900                                      and rvs-line-attr.attr-code = "mi-dnst" no-error.
     5901                                 if not available rvs-line-attr then do :
     5902                                   create rvs-line-attr.
     5903                                   assign
     5904                                     rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5905                                     rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5906                                     rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5907                                     rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5908                                     rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5909                                     rvs-line-attr.attr-code = "mi-dnst"
     5910                                   .
     5911                                 end.
     5912                                 rvs-line-attr.attr-value = prev_rvs-line-attr.attr-value .
     5913                                 for first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = integer(prev_rvs-line-attr.attr-value)
     5914                                                                      and buf_sr-izmerenia.sr-type-izm = 1
     5915                                                                      :
     5916                                   bf_rvs-line.state-temperature = prev_rvs-line.state-temperature.
     5917                                   bf_rvs-line.temperature  = prev_rvs-line.temperature.
     5918                                   v-prev-temp = yes .
     5919                                 end .
     5920                               end .
     5921                               ASSIGN
     5922                                   bf_rvs-line.density           = prev_rvs-line.density
     5923                                   bf_rvs-line.state-density     = prev_rvs-line.state-density
     5924                               .
     5925                               find first prev_rvs-line-attr no-lock
     5926                                    where prev_rvs-line-attr.obj-code  = prev_rvs-line.obj-code
     5927                                      and prev_rvs-line-attr.obj-type  = prev_rvs-line.obj-type
     5928                                      and prev_rvs-line-attr.gds-code  = prev_rvs-line.gds-code
     5929                                      and prev_rvs-line-attr.pl-code   = prev_rvs-line.pl-code
     5930                                      and prev_rvs-line-attr.rvs-code  = prev_rvs-line.rvs-code
     5931                                      and prev_rvs-line-attr.attr-code = "izmer-density" no-error.
     5932                               if available prev_rvs-line-attr
     5933                               then do :
     5934                                 find first rvs-line-attr exclusive-lock
     5935                                    where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5936                                      and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5937                                      and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5938                                      and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5939                                      and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5940                                      and rvs-line-attr.attr-code = "izmer-density" no-error.
     5941                                 if not available rvs-line-attr then do :
     5942                                   create rvs-line-attr.
     5943                                   assign
     5944                                     rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5945                                     rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5946                                     rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5947                                     rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5948                                     rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5949                                     rvs-line-attr.attr-code = "izmer-density"
     5950                                   .
     5951                                 end.
     5952                                 rvs-line-attr.attr-value = prev_rvs-line-attr.attr-value .
     5953                               end .
     5954                               find first rvs-line-attr exclusive-lock
     5955                                    where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5956                                      and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5957                                      and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5958                                      and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5959                                      and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5960                                      and rvs-line-attr.attr-code = "is-olddens" no-error.
     5961                               if not available rvs-line-attr then do :
     5962                                 create rvs-line-attr.
     5963                                 assign
     5964                                   rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5965                                   rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5966                                   rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5967                                   rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5968                                   rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     5969                                   rvs-line-attr.attr-code = "is-olddens"
     5970                                 .
     5971                               end.
     5972                               rvs-line-attr.attr-value = 'yes' .
     5973                               v-is-olddens = yes .
     5974                           END.
     5975                           if tt-meas.temperature = ?
     5976                           or v-prev-temp
     5977                           then do:
     5978                               if not v-prev-temp
     5979                               then do :
     5980                                 bf_rvs-line.temperature            = prev_rvs-line.temperature.
     5981                                 bf_rvs-line.state-temperature      = prev_rvs-line.state-temperature.
     5982                               end .
     5983                               if tt-meas.temperature = ?
     5984                               then do :
     5985                                 find first prev_rvs-line-attr no-lock
     5986                                      where prev_rvs-line-attr.obj-code  = prev_rvs-line.obj-code
     5987                                        and prev_rvs-line-attr.obj-type  = prev_rvs-line.obj-type
     5988                                        and prev_rvs-line-attr.gds-code  = prev_rvs-line.gds-code
     5989                                        and prev_rvs-line-attr.pl-code   = prev_rvs-line.pl-code
     5990                                        and prev_rvs-line-attr.rvs-code  = prev_rvs-line.rvs-code
     5991                                        and prev_rvs-line-attr.attr-code = "temp-izm-vol" no-error.
     5992                                 if available prev_rvs-line-attr
     5993                                 then do :
     5994                                   find first rvs-line-attr exclusive-lock
     5995                                      where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     5996                                        and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     5997                                        and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     5998                                        and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     5999                                        and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6000                                        and rvs-line-attr.attr-code = "temp-izm-vol" no-error.
     6001                                   if not available rvs-line-attr then do :
     6002                                     create rvs-line-attr.
     6003                                     assign
     6004                                       rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6005                                       rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6006                                       rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6007                                       rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6008                                       rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6009                                       rvs-line-attr.attr-code = "temp-izm-vol"
     6010                                     .
     6011                                   end.
     6012                                   rvs-line-attr.attr-value = prev_rvs-line-attr.attr-value .
     6013                                 end .
     6014                                 find first prev_rvs-line-attr no-lock
     6015                                      where prev_rvs-line-attr.obj-code  = prev_rvs-line.obj-code
     6016                                        and prev_rvs-line-attr.obj-type  = prev_rvs-line.obj-type
     6017                                        and prev_rvs-line-attr.gds-code  = prev_rvs-line.gds-code
     6018                                        and prev_rvs-line-attr.pl-code   = prev_rvs-line.pl-code
     6019                                        and prev_rvs-line-attr.rvs-code  = prev_rvs-line.rvs-code
     6020                                        and prev_rvs-line-attr.attr-code = "mi-tmp" no-error.
     6021                                 if available prev_rvs-line-attr
     6022                                 then do :
     6023                                   find first rvs-line-attr exclusive-lock
     6024                                      where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6025                                        and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6026                                        and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6027                                        and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6028                                        and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6029                                        and rvs-line-attr.attr-code = "mi-tmp" no-error.
     6030                                   if not available rvs-line-attr then do :
     6031                                     create rvs-line-attr.
     6032                                     assign
     6033                                       rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6034                                       rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6035                                       rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6036                                       rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6037                                       rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6038                                       rvs-line-attr.attr-code = "mi-tmp"
     6039                                     .
     6040                                   end.
     6041                                   rvs-line-attr.attr-value = prev_rvs-line-attr.attr-value .
     6042                                 end .
     6043                               end .
     6044                           END.
     6045                           if vapor-density = ? or vapor-density = 0 or vapor-density > 1
     6046                           then do :
     6047                             find first prev_rvs-line-attr no-lock
     6048                                  where prev_rvs-line-attr.obj-code  = prev_rvs-line.obj-code
     6049                                    and prev_rvs-line-attr.obj-type  = prev_rvs-line.obj-type
     6050                                    and prev_rvs-line-attr.gds-code  = prev_rvs-line.gds-code
     6051                                    and prev_rvs-line-attr.pl-code   = prev_rvs-line.pl-code
     6052                                    and prev_rvs-line-attr.rvs-code  = prev_rvs-line.rvs-code
     6053                                    and prev_rvs-line-attr.attr-code = "state-dens-pf-sug" no-error .
     6054                             if available prev_rvs-line-attr
     6055                             then do :
     6056                               state-vapor-density = decimal(prev_rvs-line-attr.attr-value) no-error .
     6057                               find first rvs-line-attr exclusive-lock
     6058                                  where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6059                                    and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6060                                    and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6061                                    and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6062                                    and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6063                                    and rvs-line-attr.attr-code = "state-dens-pf-sug" no-error.
     6064                               if not available rvs-line-attr then do :
     6065                                 create rvs-line-attr.
     6066                                 assign
     6067                                   rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6068                                   rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6069                                   rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6070                                   rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6071                                   rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6072                                   rvs-line-attr.attr-code = "state-dens-pf-sug"
     6073                                 .
     6074                               end.
     6075                               rvs-line-attr.attr-value = prev_rvs-line-attr.attr-value .
     6076                             end .
     6077                             find first prev_rvs-line-attr no-lock
     6078                                  where prev_rvs-line-attr.obj-code  = prev_rvs-line.obj-code
     6079                                    and prev_rvs-line-attr.obj-type  = prev_rvs-line.obj-type
     6080                                    and prev_rvs-line-attr.gds-code  = prev_rvs-line.gds-code
     6081                                    and prev_rvs-line-attr.pl-code   = prev_rvs-line.pl-code
     6082                                    and prev_rvs-line-attr.rvs-code  = prev_rvs-line.rvs-code
     6083                                    and prev_rvs-line-attr.attr-code = "dens-pf-sug" no-error.
     6084                             if available prev_rvs-line-attr
     6085                             then do :
     6086                               vapor-density = decimal(prev_rvs-line-attr.attr-value) no-error .
     6087                               find first rvs-line-attr exclusive-lock
     6088                                  where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6089                                    and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6090                                    and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6091                                    and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6092                                    and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6093                                    and rvs-line-attr.attr-code = "dens-pf-sug" no-error.
     6094                               if not available rvs-line-attr then do :
     6095                                 create rvs-line-attr.
     6096                                 assign
     6097                                   rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6098                                   rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6099                                   rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6100                                   rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6101                                   rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6102                                   rvs-line-attr.attr-code = "dens-pf-sug"
     6103                                 .
     6104                               end.
     6105                               rvs-line-attr.attr-value = prev_rvs-line-attr.attr-value .
     6106                             end .
     6107                           end .
     6108                           if not is-sug(bf_rvs-line.gds-code)
     6109                           then do :
     6110                             ASSIGN
     6111                               bf_rvs-line.measure-cli-qnty       = bf_rvs-line.measure-qnty       * bf_rvs-line.density
     6112                               bf_rvs-line.brutto-cli-qnty        = bf_rvs-line.brutto-qnty        * bf_rvs-line.density
     6113                               bf_rvs-line.state-measure-cli-qnty = bf_rvs-line.state-measure-qnty * bf_rvs-line.density
     6114                               bf_rvs-line.state-brutto-cli-qnty  = bf_rvs-line.state-brutto-qnty  * bf_rvs-line.density
     6115                             .
     6116                           end .
     6117                       END.
     6118                   END.
     6119               END.
     6120               if not is-sug(bf_rvs-line.gds-code)
     6121               then do :
     6122                 if bf_rvs-line.measure-qnty = 0 or bf_rvs-line.measure-qnty = ? then bf_rvs-line.measure-qnty = bf_rvs-line.measure-cli-qnty / bf_rvs-line.density .
     6123                 if bf_rvs-line.measure-qnty = 0 or bf_rvs-line.measure-qnty = ? then bf_rvs-line.measure-qnty = tt-meas.brutto-qnty .
     6124                 if bf_rvs-line.measure-qnty > tt-meas.brutto-qnty then bf_rvs-line.measure-qnty = tt-meas.brutto-qnty .
     6125               end .
     6126           END.
     6127       END.
     6128       if is-sug(bf_rvs-line.gds-code)
     6129       then do :
     6130         find first rvs-line-attr exclusive-lock
     6131               where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6132                 and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6133                 and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6134                 and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6135                 and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6136                 and rvs-line-attr.attr-code = "sug-water-qnty" no-error.
     6137         if available rvs-line-attr then do :
     6138           rvs-line-attr.attr-value = string(sug-water-qnty) .
     6139         end.
     6140         else do :
     6141           create rvs-line-attr.
     6142           assign
     6143             rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6144             rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6145             rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6146             rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6147             rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6148             rvs-line-attr.attr-code = "sug-water-qnty"
     6149             rvs-line-attr.attr-value = string(sug-water-qnty)
     6150           .
     6151         end.
     6152         find first rvs-line-attr exclusive-lock
     6153               where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6154                 and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6155                 and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6156                 and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6157                 and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6158                 and rvs-line-attr.attr-code = "dens-pf-sug" no-error.
     6159         if available rvs-line-attr then do :
     6160           rvs-line-attr.attr-value = string(vapor-density) .
     6161         end.
     6162         else do :
     6163           create rvs-line-attr.
     6164           assign
     6165             rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6166             rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6167             rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6168             rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6169             rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6170             rvs-line-attr.attr-code = "dens-pf-sug"
     6171             rvs-line-attr.attr-value = string(vapor-density)
     6172           .
     6173         end.
     6174         find first rvs-line-attr exclusive-lock
     6175               where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6176                 and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6177                 and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6178                 and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6179                 and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6180                 and rvs-line-attr.attr-code = "state-dens-pf-sug" no-error.
     6181         if available rvs-line-attr then do :
     6182           rvs-line-attr.attr-value = string(state-vapor-density) .
     6183         end.
     6184         else do :
     6185           create rvs-line-attr.
     6186           assign
     6187             rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6188             rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6189             rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6190             rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6191             rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6192             rvs-line-attr.attr-code = "state-dens-pf-sug"
     6193             rvs-line-attr.attr-value = string(state-vapor-density)
     6194           .
     6195         end.
     6196         find first rvs-line-attr exclusive-lock
     6197               where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6198                 and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6199                 and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6200                 and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6201                 and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6202                 and rvs-line-attr.attr-code = "pressure-sug" no-error.
     6203         if available rvs-line-attr then do :
     6204           rvs-line-attr.attr-value = string(vapor-pressure ) .
     6205         end.
     6206         else do :
     6207           create rvs-line-attr.
     6208           assign
     6209             rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6210             rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6211             rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6212             rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6213             rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6214             rvs-line-attr.attr-code = "pressure-sug"
     6215             rvs-line-attr.attr-value = string(vapor-pressure )
     6216           .
     6217         end.
     6218         find first rvs-line-attr exclusive-lock
     6219               where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6220                 and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6221                 and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6222                 and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6223                 and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6224                 and rvs-line-attr.attr-code = "state-pressure-sug" no-error.
     6225         if available rvs-line-attr then do :
     6226           rvs-line-attr.attr-value = string(state-vapor-pressure) .
     6227         end.
     6228         else do :
     6229           create rvs-line-attr.
     6230           assign
     6231             rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6232             rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6233             rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6234             rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     6235             rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     6236             rvs-line-attr.attr-code = "state-pressure-sug"
     6237             rvs-line-attr.attr-value = string(state-vapor-pressure)
     6238           .
     6239         end.
     6240         find last full_pl-level no-lock
     6241             where full_pl-level.pl-code  = bf_rvs-line.pl-code
     6242               and full_pl-level.obj-code = bf_rvs-line.obj-code
     6243               and full_pl-level.obj-type = bf_rvs-line.obj-type
     6244               no-error .
     6245         if available full_pl-level
     6246         and full_pl-level.pl-qnty >= bf_rvs-line.measure-qnty
     6247         then do :
     6248           if bf_rvs-line.measure-qnty > 0
     6249           then do :
     6250             sug-pf-volume = full_pl-level.pl-qnty - bf_rvs-line.measure-qnty .
     6251           end .
     6252           else do :
     6253             sug-volume = (bf_rvs-line.measure-cli-qnty - (full_pl-level.pl-qnty * vapor-density)) / (bf_rvs-line.density - vapor-density) .
     6254             bf_rvs-line.measure-qnty = sug-volume .
     6255             bf_rvs-line.state-measure-qnty = sug-volume .
     6256             sug-pf-volume = (bf_rvs-line.measure-cli-qnty - (full_pl-level.pl-qnty * bf_rvs-line.density)) / (bf_rvs-line.density - vapor-density) .
     6257           end .
     6258           find first rvs-line-attr exclusive-lock
     6259                 where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     6260                   and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     6261                   and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     6262                   and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
