     9273     ,input  '':u
     9274     ,input  '':u
     9275     ,input  '':u
     9276     ,input  no
     9277     ,output varpgscales-pref
     9278     ,output varpgscales-pref-type21
     9279     ) no-error .
     9280   if varpgscales-pref = ? then do:
     9281     assign
     9282     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     9283   end.
     9284   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crtt-pmp in g#lib-rvs ( input-output table tt-param-pump  ) no-error .
     9285     if error-status :error then do:
     9286       return error substitute( 'Ошибка при установке параметров для считывания данных с ТРК.&1&2&1&3'
     9287                              , chr(10)
     9288                              , error-status :get-message( 1 )
     9289                              , return-value ) .
     9290     end.
     9291     if p-read-cur = ? then do:
     9292       if p-message-on = no then do:
     9293         assign
     9294           p-read-cur = yes
     9295         .
     9296       end.
     9297       else do:
     9298         run gbl/d-askw.w
     9299           (  input 'Выбор источника данных с информацией по ТРК'
     9300           ,  input 'Будем читать текущие данные с ТРК или возьмем данные из файла?'
     9301           ,  input '|^'
     9302           ,  input 'Текущие данные|Из файлов|Отмена'
     9303           ,  input 'Запускается программа для обращения к датчикам ТРК|'
     9304           +        'Берутся уже сохраненные данные из файла|Ничего не делаем'
     9305           ,  input 1
     9306           ,  input 3
     9307           , output j_num
     9308           ) .
     9309         case j_num :
     9310           when 3 then do:
     9311             return error .
     9312           end.
     9313           when 2 then do:
     9314             assign
     9315               p-read-cur = no
     9316             .
     9317           end.
     9318           when 1 then do:
     9319             assign
     9320               p-read-cur = yes
     9321             .
     9322           end.
     9323         end case.
     9324       end.
     9325     end.
     9326     if     objSrv:SystemSetting:pumpfile ne ?
     9327        and objSrv:SystemSetting:pumpfile ne ""
     9328        and search(objSrv:SystemSetting:pumpfile) ne ?
     9329     then do:
     9330        assign
     9331           v_File-Name = search(objSrv:SystemSetting:pumpfile)
     9332           v_File-Err  = substitute('&1pump.err', ibs.th.gbl.gbl-inipar:logDir) .
     9333        .
     9334        run readfiletxt(v_File-Name,output vPump).
     9335     end.
     9336     else if p-read-cur = yes then do:
     9337       assign
     9338         v_File-Name = './pump.txt'
     9339         v_File-Err  = substitute('&1pump.err', ibs.th.gbl.gbl-inipar:logDir) .
     9340       .
     9341       output to value(v_File-Err) .
     9342       output close.
     9343       run getpump(v_File-Err, p-obj-type, p-obj-code, p-message-on, p-no-waitfram, output vPump) no-error.
     9344       if error-status:error
     9345       then
     9346          return error substitute ("&1 Повторите попытку или обратитесь в техническую поддержку.",return-value).
     9347     end.
     9348     else do:
     9349       v_DirFilePump = ibs.th.gbl.gbl-inipar:dirflpmp .
     9350       if v_DirFilePump = '':U or
     9351          v_DirFilePump = ?
     9352       then do:
     9353         assign
     9354           v_DirFilePump = ' .'
     9355         .
     9356       end.
     9357       system-dialog get-file v_File-Name
     9358         initial-dir v_DirFilePump
     9359         title       'Выберите файл с данными по ТРК'
     9360         update      l_log.
     9361       if l_log <> yes then do:
     9362         return error .
     9363       end.
     9364       v_File-Err  = substitute("&1.err":U,  entry(1, v_File-Name, '.':U)) .
     9365       output to value (v_File-Err).
     9366       output close.
     9367       run readfiletxt(v_File-Name,output vPump).
     9368     end.
     9369             define variable vErrortext as character no-undo.
     9370     define variable verrorlist as character no-undo.
     9371         for each tt-pump-nozzle-file :
     9372       delete tt-pump-nozzle-file .
     9373     end.
     9374     main-cycle:
     9375     do vi = 1 to num-entries(vPump,chr(10)) :
     9376        v_String-Temp = entry(vi,vPump,chr(10)).
     9377       if trim( v_String-Temp ) = '':U then do:
     9378         next main-cycle .
     9379       end.
     9380       if substring( v_String-Temp, 1, 3 ) <> '212' then do:
     9381         next main-cycle .
     9382       end.
     9383       assign
     9384         v_Prefix =       substring( v_String-Temp, 1, 4 )
     9385         v_String = trim( substring( v_String-Temp, 5    ) )
     9386       .
     9387       for each tt-param-pump :
     9388         assign
     9389                tt-param-pump.meaning = ? .
     9390       end.
     9391       assign
     9392         v_String-Tail = v_String
     9393       .
     9394       do while v_String-Tail <> '':U :
     9395         assign
     9396           j_Space = index( v_String-Tail, ' ':U )
     9397         .
     9398         if j_Space = 0 then do:
     9399           assign
     9400             v_Param       = trim( v_String-Tail )
     9401             v_String-Tail = '':U
     9402           .
     9403         end.
     9404         else do:
     9405           assign
     9406             v_Param       = trim( substring( v_String-Tail, 1, j_Space - 1 ) )
     9407             v_String-Tail = trim( substring( v_String-Tail,    j_Space     ) )
     9408           .
     9409         end.
     9410         find first tt-param-pump where
     9411                    tt-param-pump.strfrfile = trim( entry( 1, v_Param, '=' ) ) no-error .
     9412         if not available tt-param-pump then do:
     9413            vErrorText = 'Обнаружен неизвестный параметр'.
     9414           if lookup (vErrortext,vErrorList,chr(4)) eq 0 then vErrorList = vErrorList + chr(4) + vErrorText.
     9415           output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' ' vErrorText ': ' v_Param ' в строке: ' v_String-Temp                     skip .                     output stream str-err close.                    assign                       is_Error = yes                     .
     9416         end.
     9417         else do:
     9418           assign
     9419             tt-param-pump.meaning = trim( entry( 2, v_Param, '=' ) )
     9420           .
     9421         end.
     9422       end.
     9423       find first tt-param-pump where
     9424                  tt-param-pump.strfrfile = 'PUMP' .
     9425       if       tt-param-pump.meaning   = ?    or
     9426          trim( tt-param-pump.meaning ) = '':U
     9427       then do:
     9428         vErrorText = 'Неизвестный код ТРК'.
     9429         if lookup (vErrortext,vErrorList,chr(4)) eq 0 then vErrorList = vErrorList + chr(4) + vErrorText.
     9430         output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' ' vErrorText ': ' tt-param-pump.meaning ' в строке: ' v_String-Temp                     skip .                     output stream str-err close.                    assign                       is_Error = yes                     .                     next main-cycle.
     9431       end.
     9432       assign
     9433         j_pump-code = integer( tt-param-pump.meaning )
     9434       .
     9435       find first tt-param-pump where
     9436                  tt-param-pump.strfrfile = 'NZL' .
     9437       if       tt-param-pump.meaning   = ?    or
     9438          trim( tt-param-pump.meaning ) = '':U
     9439       then do:
     9440         vErrorText = 'Неизвестный код пистолета ТРК'.
     9441         if lookup (vErrortext,vErrorList,chr(4)) eq 0 then vErrorList = vErrorList + chr(4) + vErrorText.
     9442         output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' ' vErrorText ': ' tt-param-pump.meaning ' в строке: ' v_String-Temp                     skip .                     output stream str-err close.                    assign                       is_Error = yes                     .                     next main-cycle.
     9443       end.
     9444       assign
     9445         j_nozzle-code = integer( tt-param-pump.meaning )
     9446       .
     9447       find first tt-param-pump where
     9448                  tt-param-pump.strfrfile = 'STATUS' .
     9449       if integer( tt-param-pump.meaning ) <> 0 then do:
     9450        vErrorText = if integer(tt-param-pump.meaning) eq 10
     9451                      then "При получении данных со счетчиков ТРК возникла ошибка status 10 Не могу прочитать обьем"
     9452                      else if integer(tt-param-pump.meaning) eq 20
     9453                      then "При получении данных со счетчиков ТРК возникла ошибка status 20 Не могу прочитать колличество"
     9454                      else if integer(tt-param-pump.meaning) eq 40
     9455                      then "При получении данных со счетчиков ТРК возникла ошибка status 40 Не могу прочитать колличество транзакций"
     9456                      else if integer(tt-param-pump.meaning) eq 70
     9457                      then "При получении данных со счетчиков ТРК возникла ошибка несоответствия ТРК-ПИСТОЛЕТ-ТОПЛИВО либо отсутствует связь с одной или более ТРК."
     9458                      else if integer(tt-param-pump.meaning) eq 73
     9459                      then "Не удалось получить данные по счетчикам ТРК. Необходима проверка состояния/связи с ТРК."
     9460                      else if integer(tt-param-pump.meaning) eq 3
     9461                      then "При получении данных со счетчиков ТРК возникла ошибка несоответствия ТРК-ПИСТОЛЕТ-ТОПЛИВО. Возможна некорректная привязка топлива к пистолету на стороне кассы."
     9462                      else 'Ошибка при чтении данных с ТРК(статус из поля status) ' + string(tt-param-pump.meaning).
     9463         if lookup (vErrortext,vErrorList,chr(4)) eq 0 then vErrorList = vErrorList + chr(4) + vErrorText.
     9464         output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' ' vErrorText ' в строке: ' v_String-Temp                     skip .                     output stream str-err close.                    assign                       is_Error = yes                     .                     next main-cycle.
     9465       end.
     9466       find first tt-param-pump where
     9467                  tt-param-pump.strfrfile = 'GRADE' .
     9468       if       tt-param-pump.meaning   = ?    or
     9469          trim( tt-param-pump.meaning ) = '':U
     9470       then do:
     9471         if p-check-goods = yes then do:
     9472          vErrorText = 'Неизвестный топливный код товара '.
     9473         if lookup (vErrortext,vErrorList,chr(4)) eq 0 then vErrorList = vErrorList + chr(4) + vErrorText.
     9474         output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' ' vErrorText ': ' tt-param-pump.meaning ' в строке: ' v_String-Temp                     skip .                     output stream str-err close.                    assign                       is_Error = yes                     .                     next main-cycle.
     9475         end.
     9476         else do:
     9477           assign
     9478             j_gds-code = ?
     9479           .
     9480           vErrorText = 'Неизвестный топливный код товара'.
     9481           if lookup (vErrortext,vErrorList,chr(4)) eq 0 then vErrorList = vErrorList + chr(4) + vErrorText.
     9482           output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' ' vErrorText  ': ' tt-param-pump.meaning ' в строке: ' v_String-Temp                     skip .                     output stream str-err close.                    assign                       is_Error = yes                     .
     9483         end.
     9484       end.
     9485       else do:
     9486         if integer( tt-param-pump.meaning ) = 0 then do:
     9487           assign
     9488             j_gds-code = ?
     9489           .
     9490         end.
     9491         else do:
     9492           assign
     9493             j_b-code = ?
     9494             d_rate   = ?
     9495           .
     9496   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     9497   (
     9498    input  p-parent-proc
     9499   ,input  tt-param-pump.meaning
     9500   ,input  ?
     9501   ,input  p-obj-type
     9502   ,input  p-obj-code
     9503   ,input  yes
     9504   ,input  no
     9505   ,input  varscales-pref
     9506   ,input  varpgscales-pref
     9507   ,output v_result
     9508   ,output v_type-bc
     9509   ,output d_weight
     9510   ,buffer ub.bar-code
     9511   ,buffer ub.prod-bc
     9512   ,buffer ub.place
     9513   ) no-error.
     9514           if error-status :error then do:
     9515             if p-message-on = yes then do:
     9516               return error 'Ошибка при разборе бар-кода' .
     9517             end.
     9518             else do:
     9519               message 'Ошибка при разборе бар-кода' view-as alert-box.
     9520               return error .
     9521             end.
     9522           end.
     9523           if not available ub.bar-code then do:
     9524             assign
     9525               j_b-code = ?
     9526             .
     9527           end.
     9528           else do:
     9529             assign
     9530               j_b-code = ub.bar-code.b-code
     9531               d_rate   = ub.bar-code.cli-base-rate
     9532             .
     9533           end.
     9534           if j_b-code = ? then do:
     9535             if p-check-goods = yes then do:
     9536               vErrorText = 'Невозможно определить основной бар-код по топливному коду'.
     9537               if lookup (vErrortext,vErrorList,chr(4)) eq 0 then vErrorList = vErrorList + chr(4) + vErrorText.
     9538               output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' ' vErrorText  ': ' tt-param-pump.meaning
     9539               ' в строке: ' v_String-Temp                     skip .                     output stream str-err close.                    assign                       is_Error = yes                     .                     next main-cycle.
     9540             end.
     9541             else do:
     9542               assign
     9543                 j_gds-code = ?
     9544               .
     9545               vErrorText = 'Невозможно определить основной бар-код по топливному коду'.
     9546               if lookup (vErrortext,vErrorList,chr(4)) eq 0 then vErrorList = vErrorList + chr(4) + vErrorText.
     9547               output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' ' vErrorText ': ' tt-param-pump.meaning
     9548               ' в строке: ' v_String-Temp                     skip .                     output stream str-err close.                    assign                       is_Error = yes                     .
     9549             end.
     9550           end.
     9551           else do:
     9552             if d_rate <> 1.00 then do:
     9553               vErrorText = 'Некорректный курс основного бар-кода'.
     9554               if lookup (vErrortext,vErrorList,chr(4)) eq 0 then vErrorList = vErrorList + chr(4) + vErrorText.
     9555               output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' '
     9556                 'Замечание(cтрока обработана) . Некорректный курс: ' d_rate ' основного бар-кода: ' j_b-code
     9557               ' в строке: ' v_String-Temp                     skip .                     output stream str-err close.                    assign                       is_Error = yes                     .
     9558             end.
     9559             find first bf_bar-code no-lock
     9560               where bf_bar-code.b-code = j_b-code
     9561               .
     9562             find first bf_goods no-lock
     9563               where bf_goods.gds-code  = bf_bar-code.gds-code
     9564               .
     9565             assign
     9566               j_gds-code = bf_goods.gds-code
     9567             .
     9568           end.
     9569         end.
     9570       end.
     9571       create tt-pump-nozzle-file.
     9572       assign
     9573              tt-pump-nozzle-file.obj-type    = p-obj-type
     9574              tt-pump-nozzle-file.obj-code    = p-obj-code
     9575              tt-pump-nozzle-file.pump-code   = j_pump-code
     9576              tt-pump-nozzle-file.nozzle-code = j_nozzle-code
     9577              tt-pump-nozzle-file.gds-code    = j_gds-code
     9578       .
     9579       find first tt-param-pump where
     9580                  tt-param-pump.strfrfile = 'VOL' .
     9581       assign
     9582         tt-pump-nozzle-file.meas-el-cnt = decimal( tt-param-pump.meaning )
     9583       no-error .
     9584       if error-status:error
     9585       then do :
     9586         find first tt-pump-nozzle where
     9587                  tt-pump-nozzle.obj-type    = tt-pump-nozzle-file.obj-type    and
     9588                  tt-pump-nozzle.obj-code    = tt-pump-nozzle-file.obj-code    and
     9589                  tt-pump-nozzle.pump-code   = tt-pump-nozzle-file.pump-code   and
     9590                  tt-pump-nozzle.nozzle-code = tt-pump-nozzle-file.nozzle-code no-error .
     9591         if not available tt-pump-nozzle
     9592         then do:
     9593           delete tt-pump-nozzle-file .
     9594           next main-cycle .
     9595         end .
     9596         else do :
     9597           return error return-value .
     9598         end .
     9599       end .
     9600       find first tt-param-pump where
     9601                  tt-param-pump.strfrfile = 'VAL' .
     9602       assign
     9603         tt-pump-nozzle-file.meas-am-cnt = decimal( tt-param-pump.meaning )
     9604       no-error .
     9605       if error-status:error
     9606       then do :
     9607         find first tt-pump-nozzle where
     9608                  tt-pump-nozzle.obj-type    = tt-pump-nozzle-file.obj-type    and
     9609                  tt-pump-nozzle.obj-code    = tt-pump-nozzle-file.obj-code    and
     9610                  tt-pump-nozzle.pump-code   = tt-pump-nozzle-file.pump-code   and
     9611                  tt-pump-nozzle.nozzle-code = tt-pump-nozzle-file.nozzle-code no-error .
     9612         if not available tt-pump-nozzle
     9613         then do:
     9614           delete tt-pump-nozzle-file .
     9615           next main-cycle .
     9616         end .
     9617         else do :
     9618           return error return-value .
     9619         end .
     9620       end .
     9621       find first tt-param-pump where
     9622                  tt-param-pump.strfrfile = 'CNT' .
     9623       assign
     9624         tt-pump-nozzle-file.meas-cf-cnt = decimal( tt-param-pump.meaning )
     9625       no-error .
     9626       if error-status:error
     9627       then do :
     9628         find first tt-pump-nozzle where
     9629                  tt-pump-nozzle.obj-type    = tt-pump-nozzle-file.obj-type    and
     9630                  tt-pump-nozzle.obj-code    = tt-pump-nozzle-file.obj-code    and
     9631                  tt-pump-nozzle.pump-code   = tt-pump-nozzle-file.pump-code   and
     9632                  tt-pump-nozzle.nozzle-code = tt-pump-nozzle-file.nozzle-code no-error .
     9633         if not available tt-pump-nozzle
     9634         then do:
     9635           delete tt-pump-nozzle-file .
     9636           next main-cycle .
     9637         end .
     9638         else do :
     9639           return error return-value .
     9640         end .
     9641       end .
     9642     end.
     9643     for each tt-pump-nozzle-file :
     9644       find first tt-pump-nozzle where
     9645                  tt-pump-nozzle.obj-type    = tt-pump-nozzle-file.obj-type    and
     9646                  tt-pump-nozzle.obj-code    = tt-pump-nozzle-file.obj-code    and
     9647                  tt-pump-nozzle.pump-code   = tt-pump-nozzle-file.pump-code   and
     9648                  tt-pump-nozzle.nozzle-code = tt-pump-nozzle-file.nozzle-code no-error .
     9649       if not available tt-pump-nozzle then do:
     9650         vErrorText = 'Нет связки ТРК и пистолета в конфигурации объекта '.
     9651         if lookup (vErrortext,vErrorList,chr(4)) eq 0 then vErrorList = vErrorList + chr(4) + vErrorText.
     9652         output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' '
     9653                 'Замечание(cтрока обработана) . ' vErrorText
     9654           'Из файла получены данные по ТРК ' + string( tt-pump-nozzle-file.pump-code   ) +
     9655           ' и пистолету '                    + string( tt-pump-nozzle-file.nozzle-code ) +
     9656           ' на объекте '                     +         tt-pump-nozzle-file.obj-type      + ' ':U
     9657                                              + string( tt-pump-nozzle-file.obj-code    ) +
     9658           ' которого нет в конфигурации.'
     9659         skip .                     output stream str-err close.                    assign                       is_Error = yes                     .
     9660         delete tt-pump-nozzle-file.
     9661       end.
     9662       else do:
     9663         if tt-pump-nozzle-file.gds-code <> tt-pump-nozzle.gds-code then do:
     9664           if tt-pump-nozzle-file.gds-code <> ? then do:
     9665             find first bf_goods-file no-lock where
     9666                        bf_goods-file.gds-code = tt-pump-nozzle-file.gds-code .
     9667           end.
     9668           if tt-pump-nozzle.gds-code <> ? then do:
     9669             find first bf_goods no-lock where
     9670                        bf_goods.gds-code = tt-pump-nozzle.gds-code .
     9671           end.
     9672           vErrorText = 'Данные по ТРК и пистолету не правильная конфигурация' .
     9673           if lookup (vErrortext,vErrorList,chr(4)) eq 0 then vErrorList = vErrorList + chr(4) + vErrorText.
     9674           output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' '
     9675             'Из файла получены данные по ТРК ' + string( tt-pump-nozzle-file.pump-code   ) +
     9676             ' пистолету '                      + string( tt-pump-nozzle-file.nozzle-code ) +
     9677             ( if tt-pump-nozzle-file.gds-code = ? then ' c неопределенным кодом товара'
     9678                                                   else ' товар ' +
     9679                                                  string( bf_goods-file.artic             ) + ' ':U +
     9680                                                  string( bf_goods-file.prod-type         ) + ' ':U +
     9681                                                  string( bf_goods-file.prod-code         ) )       +
     9682             ' на объекте '                     + string( tt-pump-nozzle-file.obj-type    ) + ' ':U +
     9683                                                  string( tt-pump-nozzle-file.obj-code    ) +
     9684             ' для которых не совпадает конфигурация товара по системе: '                   +
     9685             ( if tt-pump-nozzle.gds-code = ? then ' по системе нет связи с товаром '
     9686                                              else ' товар ' +
     9687                                                  string( bf_goods.artic                  ) + ' ':U +
     9688                                                  string( bf_goods.prod-type              ) + ' ':U +
     9689                                                  string( bf_goods.prod-code              ) )
     9690           skip .                     output stream str-err close.                    assign                       is_Error = yes                     .
     9691           if p-check-goods = yes then do:
     9692             assign
     9693               is_FatalError = yes
     9694             .
     9695           end.
     9696         end.
     9697       end.
     9698     end.
     9699     for each tt-pump-nozzle :
     9700       find first tt-pump-nozzle-file where
     9701                  tt-pump-nozzle-file.obj-type    = tt-pump-nozzle.obj-type    and
     9702                  tt-pump-nozzle-file.obj-code    = tt-pump-nozzle.obj-code    and
     9703                  tt-pump-nozzle-file.pump-code   = tt-pump-nozzle.pump-code   and
     9704                  tt-pump-nozzle-file.nozzle-code = tt-pump-nozzle.nozzle-code no-error .
     9705       if not available tt-pump-nozzle-file then do:
     9706         assign
     9707           is_FatalError = yes
     9708         .
     9709         vErrorText = 'Не по всем ТРК и пистолетам получены данные' .
     9710         if lookup (vErrortext,vErrorList,chr(4)) eq 0 then vErrorList = vErrorList + chr(4) + vErrorText.
     9711         output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' '
     9712           'Не получены данные по ТРК ' + string( tt-pump-nozzle.pump-code   ) +
     9713           ' и пистолету '             + string( tt-pump-nozzle.nozzle-code ) +
     9714           ' на объекте '              +         tt-pump-nozzle.obj-type      +
     9715           ' ':U                       + string( tt-pump-nozzle.obj-code    ) +
     9716           ' по конфигурации.'
     9717         skip .                     output stream str-err close.                    assign                       is_Error = yes                     .
     9718       end.
     9719     end.
     9720     if is_FatalError = yes then do:
     9721       if session:debug-alert
     9722       then do:
     9723          output stream str-err to value( v_File-Err ) append.                    put stream str-err unformatted cur-time-string-sec() ' ' "Ошибки при данном запросе :" replace(vErrorList,chr(4),chr(13) + chr(10)) "<<<<"
     9724          skip .                     output stream str-err close.                    assign                       is_Error = yes                     .
     9725       end.
     9726       define variable Vtext as character no-undo.
     9727       Vtext =
     9728                    (if num-entries(vErrorList,chr(4)) > 3 then "" else replace(vErrorList,chr(4),chr(13) + chr(10)) + chr(13) + chr(10)) +
     9729                    (if session:debug-alert
     9730                     then 'Log-файл с описанием ошибок ' + v_File-Err + "."
     9731                     else '' )+ 'Повторите попытку или обратитесь в техническую поддержку.'
     9732                    .
     9733       if p-message-on = ?
     9734       then do :
     9735         return .
     9736       end .
     9737       else do :
     9738         return error vtext.
     9739       end .
     9740     end.
     9741     for each tt-pump-nozzle :
     9742       find first tt-pump-nozzle-file where
     9743                  tt-pump-nozzle-file.obj-type    = tt-pump-nozzle.obj-type    and
     9744                  tt-pump-nozzle-file.obj-code    = tt-pump-nozzle.obj-code    and
     9745                  tt-pump-nozzle-file.pump-code   = tt-pump-nozzle.pump-code   and
     9746                  tt-pump-nozzle-file.nozzle-code = tt-pump-nozzle.nozzle-code .
     9747       assign
     9748         tt-pump-nozzle.meas-el-cnt = tt-pump-nozzle-file.meas-el-cnt
     9749         tt-pump-nozzle.meas-am-cnt = tt-pump-nozzle-file.meas-am-cnt
     9750         tt-pump-nozzle.meas-cf-cnt = tt-pump-nozzle-file.meas-cf-cnt
     9751       .
     9752     end.
     9753     if is_Error = yes then do:
     9754       return 'Во время загрузки файла были ошибки. Log-файл с описанием ошибок ' + v_File-Err + ' .' +
     9755              'Сверка создана, но не содержит полной информации. Обратитесь в техподдержку для закрытия сверки или для включения измерения по связке, в случае исправности ТРК.' .
     9756     end.
     9757     return .
     9758   end procedure.
     9759   procedure lib-rvs_rvsclchd :
     9760     define input parameter p-rec-rvs-doc as recid   no-undo.
     9761     define input parameter p-recalc-line as logical no-undo.
     9762     define buffer bf_rvs-doc  for ub.rvs-doc.
     9763     define buffer bf_rvs-line for ub.rvs-line.
     9764     tr:
     9765     do transaction
     9766     on error undo tr, return error
     9767     on stop  undo tr, return error
     9768     on quit  undo tr, return error
     9769     :
     9770       find first bf_rvs-doc
     9771         where recid( bf_rvs-doc ) = p-rec-rvs-doc
     9772       .
     9773       for each bf_rvs-line
     9774         where bf_rvs-line.rvs-code = bf_rvs-doc.rvs-code
     9775           and bf_rvs-line.obj-type = bf_rvs-doc.obj-type
     9776           and bf_rvs-line.obj-code = bf_rvs-doc.obj-code
     9777       on error undo, return error return-value
     9778       :
     9779         if p-recalc-line = yes then do:
     9780   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclcln in g#lib-rvs ( input recid( bf_rvs-line ) ) no-error .
     9781            if error-status :error then do:
     9782              undo tr, return error substitute( 'Ошибка при расчете строки (место: &2, код товара: &3) сверки "&1".&4&5&4&6'
     9783                                              , bf_rvs-doc.rvs-code
     9784                                              , bf_rvs-line.pl-code
     9785                                              , bf_rvs-line.gds-code
     9786                                              , chr(10)
     9787                                              , error-status :get-message( 1 )
     9788                                              , return-value ) .
     9789            end.
     9790         end.
     9791         accumulate
     9792           bf_rvs-line.measure-qnty ( total )
     9793           bf_rvs-line.brutto-qnty ( total )
     9794           bf_rvs-line.measure-cli-qnty ( total )
     9795           bf_rvs-line.brutto-cli-qnty ( total )
     9796           bf_rvs-line.level-total ( total )
     9797           bf_rvs-line.level-petrol ( total )
     9798           bf_rvs-line.level-water ( total )
     9799           bf_rvs-line.state-measure-qnty ( total )
     9800           bf_rvs-line.state-brutto-qnty ( total )
     9801           bf_rvs-line.state-measure-cli-qnty ( total )
     9802           bf_rvs-line.state-brutto-cli-qnty ( total )
     9803           bf_rvs-line.state-level-total ( total )
     9804           bf_rvs-line.state-level-petrol ( total )
     9805           bf_rvs-line.state-level-water ( total )
     9806           bf_rvs-line.meas-am-qnty ( total )
     9807           bf_rvs-line.meas-mh-qnty ( total )
     9808           bf_rvs-line.meas-cf-qnty ( total )
     9809           bf_rvs-line.state-am-qnty ( total )
     9810           bf_rvs-line.state-cf-qnty ( total )
     9811           bf_rvs-line.state-mh-qnty ( total )
     9812           bf_rvs-line.system-qnty ( total )
     9813           bf_rvs-line.system-cli-qnty ( total )
     9814           bf_rvs-line.add-qnty ( total )
     9815           bf_rvs-line.state-add-qnty ( total )
     9816           bf_rvs-line.system-cli-avrg-qnty ( total )
     9817           bf_rvs-line.measure-tc-qnty ( total )
     9818           bf_rvs-line.brutto-tc-qnty ( total )
     9819         .
     9820       end.
     9821       assign
     9822          bf_rvs-doc.measure-qnty = ( accum total bf_rvs-line.measure-qnty )
     9823          bf_rvs-doc.brutto-qnty = ( accum total bf_rvs-line.brutto-qnty )
     9824          bf_rvs-doc.measure-cli-qnty = ( accum total bf_rvs-line.measure-cli-qnty )
     9825          bf_rvs-doc.brutto-cli-qnty = ( accum total bf_rvs-line.brutto-cli-qnty )
     9826          bf_rvs-doc.level-total = ( accum total bf_rvs-line.level-total )
     9827          bf_rvs-doc.level-petrol = ( accum total bf_rvs-line.level-petrol )
     9828          bf_rvs-doc.level-water = ( accum total bf_rvs-line.level-water )
     9829          bf_rvs-doc.state-measure-qnty = ( accum total bf_rvs-line.state-measure-qnty )
     9830          bf_rvs-doc.state-brutto-qnty = ( accum total bf_rvs-line.state-brutto-qnty )
     9831          bf_rvs-doc.state-measure-cli-qnty = ( accum total bf_rvs-line.state-measure-cli-qnty )
     9832          bf_rvs-doc.state-brutto-cli-qnty = ( accum total bf_rvs-line.state-brutto-cli-qnty )
     9833          bf_rvs-doc.state-level-total = ( accum total bf_rvs-line.state-level-total )
     9834          bf_rvs-doc.state-level-petrol = ( accum total bf_rvs-line.state-level-petrol )
     9835          bf_rvs-doc.state-level-water = ( accum total bf_rvs-line.state-level-water )
     9836          bf_rvs-doc.meas-am-qnty = ( accum total bf_rvs-line.meas-am-qnty )
     9837          bf_rvs-doc.meas-mh-qnty = ( accum total bf_rvs-line.meas-mh-qnty )
     9838          bf_rvs-doc.meas-cf-qnty = ( accum total bf_rvs-line.meas-cf-qnty )
     9839          bf_rvs-doc.state-am-qnty = ( accum total bf_rvs-line.state-am-qnty )
     9840          bf_rvs-doc.state-cf-qnty = ( accum total bf_rvs-line.state-cf-qnty )
     9841          bf_rvs-doc.state-mh-qnty = ( accum total bf_rvs-line.state-mh-qnty )
     9842          bf_rvs-doc.system-qnty = ( accum total bf_rvs-line.system-qnty )
     9843          bf_rvs-doc.system-cli-qnty = ( accum total bf_rvs-line.system-cli-qnty )
     9844          bf_rvs-doc.add-qnty = ( accum total bf_rvs-line.add-qnty )
     9845          bf_rvs-doc.state-add-qnty = ( accum total bf_rvs-line.state-add-qnty )
     9846          bf_rvs-doc.system-cli-avrg-qnty = ( accum total bf_rvs-line.system-cli-avrg-qnty )
     9847          bf_rvs-doc.measure-tc-qnty = ( accum total bf_rvs-line.measure-tc-qnty )
     9848          bf_rvs-doc.brutto-tc-qnty = ( accum total bf_rvs-line.brutto-tc-qnty )
     9849       .
     9850     end.
     9851     return .
     9852   end procedure.
     9853   procedure lib-rvs_rvsclcln :
     9854     define input parameter p-rec-id as recid no-undo.
     9855     define buffer bf_rvs-line      for ub.rvs-line.
     9856     define buffer bf_rvs-line-pump for ub.rvs-line-pump.
     9857     define buffer bf_goods for ub.goods.
     9858     find first bf_rvs-line
     9859       where recid( bf_rvs-line ) = p-rec-id
     9860     .
     9861     for each bf_rvs-line-pump
     9862       where bf_rvs-line-pump.rvs-code = bf_rvs-line.rvs-code
     9863         and bf_rvs-line-pump.obj-type = bf_rvs-line.obj-type
     9864         and bf_rvs-line-pump.obj-code = bf_rvs-line.obj-code
     9865         and bf_rvs-line-pump.pl-code  = bf_rvs-line.pl-code
     9866         and bf_rvs-line-pump.gds-code = bf_rvs-line.gds-code
     9867     on error undo, return error return-value
     9868     :
     9869       accumulate
     9870         bf_rvs-line-pump.meas-am-qnty ( total )
     9871         bf_rvs-line-pump.meas-cf-qnty ( total )
     9872         bf_rvs-line-pump.meas-mh-qnty ( total )
     9873         bf_rvs-line-pump.state-am-qnty ( total )
     9874         bf_rvs-line-pump.state-cf-qnty ( total )
     9875         bf_rvs-line-pump.state-mh-qnty ( total )
     9876       .
     9877     end.
     9878     assign
     9879       bf_rvs-line.meas-am-qnty = ( accum total bf_rvs-line-pump.meas-am-qnty )
     9880       bf_rvs-line.meas-cf-qnty = ( accum total bf_rvs-line-pump.meas-cf-qnty )
     9881       bf_rvs-line.meas-mh-qnty = ( accum total bf_rvs-line-pump.meas-mh-qnty )
     9882       bf_rvs-line.state-am-qnty = ( accum total bf_rvs-line-pump.state-am-qnty )
     9883       bf_rvs-line.state-cf-qnty = ( accum total bf_rvs-line-pump.state-cf-qnty )
     9884       bf_rvs-line.state-mh-qnty = ( accum total bf_rvs-line-pump.state-mh-qnty )
     9885     .
     9886     define variable is-vir as logical no-undo.
     9887     define variable v-value as character no-undo.
     9888     define variable v-ok as logical no-undo.
     9889     run placelib_get-attr(input "place-virtual"
     9890                          ,input bf_rvs-line.obj-code
     9891                          ,input bf_rvs-line.obj-type
     9892                          ,input bf_rvs-line.pl-code
     9893                          ,output v-value
     9894                          ,output v-ok) no-error.
     9895     is-vir = if (v-ok and logical(v-value)) then true else false.
     9896     if is-vir then do:
     9897       if bf_rvs-line.system-cli-qnty <> 0 and bf_rvs-line.system-qnty <> 0 then
     9898           bf_rvs-line.state-density = bf_rvs-line.system-cli-qnty / (bf_rvs-line.system-qnty).
     9899       else do:
     9900         find first bf_goods where bf_goods.gds-code = bf_rvs-line.gds-code no-lock.
     9901         bf_rvs-line.state-density = 1 / bf_goods.cli-base-rate.
     9902       end.
     9903     end.
     9904     return .
     9905   end procedure.
     9906   procedure lib-rvs_hstc-rvs :
     9907     define parameter buffer buf_rvs-doc for  ub.rvs-doc .
     9908     define input  parameter p-action    like ub.c-rvs-doc.action no-undo.
     9909     define input  parameter p-out-code  like ub.rvs-doc.out-code no-undo.
     9910     define input  parameter parchip-num as   integer             no-undo.
     9911     do
     9912     on error undo, return error substitute( "&1 (hstc-rvs). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9913     :
     9914       define buffer buf_doc-attr        for ub.doc-attr.
     9915       define buffer buf_c-doc-attr      for ub.c-doc-attr.
     9916       define buffer buf_rvs-line        for ub.rvs-line.
     9917       define buffer buf_rvs-line-pump   for ub.rvs-line-pump.
     9918       define buffer buf_c-rvs-doc       for ub.c-rvs-doc.
     9919       define buffer buf_c-rvs-line      for ub.c-rvs-line.
     9920       define buffer buf_c-rvs-line-pump for ub.c-rvs-line-pump.
     9921       define variable v-date        as   date                    no-undo .
     9922       define variable v-time        as   integer                 no-undo .
     9923       define variable v-shift-on    as   logical                 no-undo .
     9924       define variable v-shift-date  like ub.shift-obj.shift-date no-undo .
     9925       define variable v-shift-num   like ub.shift-obj.shift-num  no-undo .
     9926       define variable v-shift-name  like ub.shift-obj.shift-name no-undo.
     9927       if not available buf_rvs-doc then do:
     9928         undo, return error substitute( "&1 (hstc-rvs). Ошибка задания входных параметров. Отсутствует запись сверки по которой создается история", vss-workfile ) .
     9929       end.
     9930       if parchip-num = ?
     9931         or parchip-num = 0
     9932       then do:
     9933         undo, return error substitute( "&1 (hstc-rvs). Ошибка задания входных параметров. Не указан номер щепки (chip-num)", vss-workfile ) .
     9934       end.
     9935       find first buf_c-rvs-doc no-lock
     9936         where buf_c-rvs-doc.rvs-code = buf_rvs-doc.rvs-code
     9937           and buf_c-rvs-doc.chip-num = parchip-num
     9938         no-error .
     9939       if available buf_c-rvs-doc then do:
     9940         return.
     9941       end.
     9942       run cur-time in this-procedure
     9943         ( output v-date
     9944          ,output v-time
     9945         ).
     9946       assign
     9947         v-shift-date = ?
     9948         v-shift-num  = ?
     9949         v-shift-name = ?
     9950       .
     9951   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9952   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     9953     (input  buf_rvs-doc.obj-type
     9954     ,input  buf_rvs-doc.obj-code
     9955     ,input  'shift-on=request'
     9956     ,output v-shift-on
     9957     )  .
     9958       if v-shift-on = yes then do:
     9959   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9960   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     9961     (input  buf_rvs-doc.obj-type
     9962     ,input  buf_rvs-doc.obj-code
     9963     ,output v-shift-date
     9964     ,output v-shift-num
     9965     ,output v-shift-name
     9966     ) no-error .
     9967       end.
     9968       create buf_c-rvs-doc.
     9969       buffer-copy buf_rvs-doc to buf_c-rvs-doc
     9970         assign
     9971           buf_c-rvs-doc.action           = p-action
     9972           buf_c-rvs-doc.chip-num         = parchip-num
     9973           buf_c-rvs-doc.corr-doc-code    = p-out-code
     9974           buf_c-rvs-doc.corr-date        = v-date
     9975           buf_c-rvs-doc.corr-time        = v-time
     9976           buf_c-rvs-doc.corr-shift-date  = v-shift-date
     9977           buf_c-rvs-doc.corr-shift-num   = v-shift-num
     9978           buf_c-rvs-doc.corr-shift-name  = v-shift-name
     9979           buf_c-rvs-doc.corr-user-name   = g#userid
     9980           buf_c-rvs-doc.corr-user-db-num = g#db-num
     9981       .
     9982       for each buf_doc-attr
     9983         where buf_doc-attr.doc-code = buf_rvs-doc.rvs-code
     9984       on error undo, return error return-value
     9985       :
     9986         create buf_c-doc-attr.
     9987         buffer-copy buf_doc-attr to buf_c-doc-attr
     9988           assign
     9989             buf_c-doc-attr.chip-num         = buf_c-rvs-doc.chip-num
     9990             buf_c-doc-attr.corr-user-name   = buf_c-rvs-doc.corr-user-name
     9991             buf_c-doc-attr.corr-user-db-num = buf_c-rvs-doc.corr-user-db-num
     9992         .
     9993       end.
     9994       for each buf_rvs-line
     9995         where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     9996       on error undo, return error return-value
     9997       :
     9998         create buf_c-rvs-line.
     9999         buffer-copy buf_rvs-line to buf_c-rvs-line
    10000           assign
    10001             buf_c-rvs-line.chip-num         = buf_c-rvs-doc.chip-num
    10002             buf_c-rvs-line.corr-user-db-num = buf_c-rvs-doc.corr-user-db-num
    10003         .
    10004       end.
    10005       for each buf_rvs-line-pump where buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code :
    10006         create buf_c-rvs-line-pump.
    10007         buffer-copy buf_rvs-line-pump to buf_c-rvs-line-pump
    10008           assign
    10009             buf_c-rvs-line-pump.chip-num         = buf_c-rvs-doc.chip-num
    10010             buf_c-rvs-line-pump.corr-user-db-num = buf_c-rvs-doc.corr-user-db-num
    10011         .
    10012       end.
    10013     end.
    10014     return .
    10015   end procedure.
    10016   procedure creatett-meas-file:
    10017      define input  parameter i-obj-type as character no-undo.
    10018      define input  parameter i-obj-code as integer no-undo.
    10019      define variable v-bhasi               as handle  no-undo .
    10020      define variable v-fhasi               as handle  no-undo .
    10021      define variable v-bh                as handle  no-undo .
    10022      define variable v-fh                as handle  no-undo .
    10023      define variable pl-twice-code       as character no-undo.
    10024      define variable v-value             as character no-undo.
    10025      define variable v-ok                as logical   no-undo.
    10026      define variable vi                  as integer no-undo.
    10027      define buffer bf_place for ub.place.
    10028      block-Place:
    10029      for each tt-place where not tt-place.is-error :
    10030         pl-twice-code = "" .
    10031         find first bf_place no-lock
    10032            where bf_place.obj-type = i-obj-type
    10033              and bf_place.obj-code = i-obj-code
    10034              and bf_place.loc1     = tt-place.loc1
    10035              and bf_place.status_ <> 'удал':U
    10036         no-error.
    10037         if not available bf_place
    10038         then do:
    10039            twice-code:
    10040            for each  place where place.obj-code = i-obj-code
    10041                              and place.obj-type = i-obj-type
    10042                              and place.is-meas = yes
    10043            no-lock:
    10044               run placelib_get-attr  ( input "place-twice-code"
    10045                                       ,input i-obj-code
    10046                                       ,input i-obj-type
    10047                                       ,input place.pl-code
    10048                                       ,output v-value
    10049                                       ,output v-ok      ) no-error.
    10050               if v-ok
    10051               then
    10052                  pl-twice-code = v-value .
    10053               if num-entries(pl-twice-code) > 1
    10054               then do :
    10055                  do ii = 1 to num-entries(pl-twice-code) :
    10056                     if trim( entry( ii, pl-twice-code ) ) = tt-place.loc1
    10057                     then do :
    10058                        pl-twice-code = trim( entry( ii, pl-twice-code ) ) .
    10059                        leave twice-code.
    10060                     end.
    10061                  end.
    10062               end.
    10063               else do :
    10064                  if pl-twice-code =  tt-place.loc1
    10065                  then
    10066                     leave twice-code.
    10067               end.
    10068               pl-twice-code = "" .
    10069            end.
    10070            if pl-twice-code = ""
    10071            then do:
    10072               put stream str-err unformatted substitute( 'Не найден резервуар по системе с локальным кодом(коорд1) &1 .'
    10073                                                         , tt-place.loc1 ) skip .
    10074               next block-Place .
    10075            end.
    10076         end.
    10077         if     pl-twice-code = ""
    10078            and available bf_place
    10079         then do:
    10080            if bf_place.is-meas = no
    10081            then do:
    10082               put stream str-err unformatted substitute( 'Получены данные с приборов по резервуару &1 '
    10083                         + 'с локальным кодом(коорд1) &2, определенного в системе как '
    10084                         + 'неизмеряемый.'
    10085                         , bf_place.pl-code
    10086                         , tt-place.loc1 ) skip .
    10087               next block-Place .
    10088            end.
    10089         end.
    10090         if   pl-twice-code = ""
    10091         then do:
    10092            create tt-meas-file.
    10093            assign
    10094               tt-meas-file.obj-type = i-obj-type
    10095               tt-meas-file.obj-code = i-obj-code
    10096               tt-meas-file.pl-code  = bf_place.pl-code
    10097               tt-meas-file.loc1     = bf_place.loc1
    10098            .
    10099         end.
    10100         else do:
    10101            create tt-meas-file.
    10102            assign
    10103               tt-meas-file.obj-type = i-obj-type
    10104               tt-meas-file.obj-code = i-obj-code
    10105               tt-meas-file.loc1     = pl-twice-code
    10106            .
    10107         end.
    10108         v-bhasi = buffer tt-place:handle.
    10109         v-bh = buffer tt-meas-file:handle.
    10110         block-field:
    10111         do vi = 1 to v-bhasi:num-fields:
    10112            v-fhasi = v-bhasi:buffer-field(vi).
    10113            find first tt-param where tt-param.strasi = v-fhasi:name no-error.
    10114            if available tt-param
    10115            then do:
    10116               assign
    10117                  v-fh                = v-bh:buffer-field( tt-param.flddb )
    10118                  v-fh:buffer-value() = decimal( v-fhasi:buffer-value() )
    10119               no-error.
    10120               if error-status:error
    10121               then
    10122                  next block-field.
    10123               if v-fh:buffer-value() ne ?
    10124               then do:
    10125               if tt-param.strfrfile = 'temperature':U   then do:
    10126                 assign
    10127                   tt-meas-file.temp-not-null   = yes
    10128                 .
    10129               end.
    10130               if tt-param.strfrfile = 'temp-layer1':U   then do:
    10131                 assign
    10132                   tt-meas-file.t1-not-null   = yes
    10133                 .
    10134               end.
    10135               if tt-param.strfrfile = 'temp-layer2':U   then do:
    10136                 assign
    10137                   tt-meas-file.t2-not-null   = yes
    10138                 .
    10139               end.
    10140               if tt-param.strfrfile = 'temp-layer3':U   then do:
    10141                 assign
    10142                   tt-meas-file.t3-not-null   = yes
    10143                 .
    10144               end.
    10145               if tt-param.strfrfile = 'volume_oil':U   then do:
    10146                 assign
    10147                   tt-meas-file.meas-vol-oil   = yes
    10148                 .
    10149               end.
    10150               if tt-param.strfrfile = 'volume_water':U then do:
    10151                 assign
    10152                   tt-meas-file.meas-vol-water = yes
    10153                 .
    10154               end.
    10155               if tt-param.strfrfile = 'mass_total':U
    10156               then do:
    10157                  if tt-meas-file.pl-code <> 0
    10158                  then do:
    10159                     run placelib_get-attr  ( input "place-asi-sertif"
    10160                                             ,input i-obj-code
    10161                                             ,input i-obj-type
    10162                                             ,input tt-meas-file.pl-code
    10163                                             ,output v-value
    10164                                             ,output v-ok      ) no-error.
    10165                  end.
    10166                  else do:
    10167                     run placelib_get-attr  ( input "place-asi-sertif"
    10168                                             ,input i-obj-code
    10169                                             ,input i-obj-type
    10170                                             ,input place.pl-code
    10171                                             ,output v-value
    10172                                             ,output v-ok      ) no-error.
    10173                  end.
    10174                  if v-ok and v-value = "yes"
    10175                  then do:
    10176                     if     trim( v-fh:buffer-value() )  <> "-"
    10177                        and trim( v-fh:buffer-value() )  <> ""
    10178                     then do:
    10179                        assign
    10180                           tt-meas-file.log-brutto       = yes
    10181                           tt-meas-file.measure-cli-qnty = decimal( trim( v-fh:buffer-value() ) )
    10182                        .
    10183                     end.
    10184                  end.
    10185               end.
    10186               end.
    10187            end.
    10188            else do:
    10189            end .
    10190         end.
    10191      end.
    10192   end procedure.
    10193   PROCEDURE Sleep EXTERNAL "kernel32.DLL":
    10194     DEFINE INPUT PARAMETER intMilliseconds AS LONG.
    10195   END PROCEDURE.
