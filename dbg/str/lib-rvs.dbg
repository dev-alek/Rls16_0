     5744                                    and prev_rvs-line-attr.gds-code  = prev_rvs-line.gds-code
     5745                                    and prev_rvs-line-attr.pl-code   = prev_rvs-line.pl-code
     5746                                    and prev_rvs-line-attr.rvs-code  = prev_rvs-line.rvs-code
     5747                                    and prev_rvs-line-attr.attr-code = "mi-tmp" no-error.
