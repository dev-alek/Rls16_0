     1222   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     1223   if p-fact-order = ? then do:
     1224     run fact-order-mpl (
     1225         input   today       ,
     1226         input   p-obj-type  ,
     1227         input   p-obj-code  ,
     1228         output  p-fact-order ).
     1229   end.
     1230   if p-vid-pay <> "" then do:
     1231      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     1232      if available buf_pay-type
     1233         then v-trn-pay-code = buf_pay-type.obj-code.
     1234         else v-trn-pay-code =  0.
     1235   end.
     1236   else v-trn-pay-code = 0 .
     1237   if p-cash-pay-type <> "" then do:
     1238      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1239      if available buf_pay-type
     1240         then
     1241           assign
     1242             v-cash-pay-curr = buf_cash-pay.curr-code
     1243             v-cash-pay-code = buf_cash-pay.cdpay-code
     1244           .
     1245         else
     1246           assign
     1247             v-cash-pay-curr = 0
     1248             v-cash-pay-code = 0
     1249             .
     1250   end.
     1251   else
     1252     assign
     1253       v-cash-pay-curr = 0
     1254       v-cash-pay-code = 0
     1255       .
     1256   for each tt_price-all  : delete tt_price-all . end.
     1257   assign
     1258     p-plt-id             = ?
     1259     p-plt-db-num         = ?
     1260     p-pdf-id             = ?
     1261     p-pdf-db-num         = ?
     1262     p-sale-price-base    = ?
     1263     p-sale-price-rubl    = ?
     1264     v-cli-oborot         = 0
