     1202   define variable v-exch-scale0   as decimal   no-undo .
     1203   define variable v-base-rate     as decimal   no-undo .
     1204   define variable v-base-scale    as decimal   no-undo .
     1205   define variable v-exch-rate     as decimal   no-undo .
     1206   define variable v-exch-scale    as decimal   no-undo .
