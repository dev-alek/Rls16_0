     1211   define variable v-date-2        as date      no-undo .
     1212   define variable v-interv        as character no-undo .
     1213   define variable v-pay-name      as character no-undo .
     1214   define variable v-cli-oborot    as decimal   no-undo .
     1215   define variable v-trn-pay-code  as integer   no-undo .
     1216   define variable v-cash-pay-curr as integer   no-undo .
     1217   define variable v-cash-pay-code as integer   no-undo .
     1218   do
