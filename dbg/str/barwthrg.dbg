      373   procedure cur-time :
      374      define output parameter p-today as date      no-undo .
      375      define output parameter p-time  as integer   no-undo .
      376     do
      377     on error undo, return error
      378     :
      379       define variable v-date1 as date      no-undo .
      380       define variable v-date2 as date      no-undo .
      381       define variable v-time  as integer   no-undo .
      382       assign
      383         v-date1 = today
      384         v-time  = time
      385         v-date2 = today
      386       .
      387       if v-date1 <> v-date2
      388       then do:
      389         assign
      390           v-date1 = today
      391           v-time  = v-time
      392         .
      393       end.
      394       assign
      395         p-today = v-date1
      396         p-time  = v-time
      397       .
      398     end.
      399   end.
      400   function cur-time-date returns character
      401   :
      402     return string(today, '99/99/9999':U) .
      403   end.
      404   function cur-time-mjd returns decimal
      405   :
      406     define variable v-date as date      no-undo .
      407     define variable v-time as integer   no-undo .
      408     run cur-time in this-procedure
      409       (output v-date
      410       ,output v-time
      411       ) .
      412     return integer(v-date) - 2400002 + (v-time / 86400) .
      413   end.
      414   function cur-time-get-ending-index returns integer
      415   (input p-number as integer
      416   )
      417   :
      418     if p-number < 0
      419     or p-number = ?
      420     then do:
      421       return 1 .
      422     end.
      423     define variable v-rest as integer   no-undo .
      424     assign
      425       p-number = p-number modulo 100
      426     .
      427     if p-number < 20
      428     then do:
      429       assign
      430         v-rest = p-number
      431       .
      432     end.
      433     else do:
      434       assign
      435         v-rest = p-number modulo 10
      436       .
      437     end.
      438     case v-rest :
      439       when 1
      440       then do:
      441         return 2 .
      442       end.
      443       when 2 or
      444       when 3 or
      445       when 4
      446       then do:
      447         return 3 .
      448       end.
      449       otherwise do:
      450         return 1 .
      451       end.
      452     end case .
      453   end.
      454   procedure cur-time-mjd-to-date :
      455      define input  parameter i-mjd-diff as decimal no-undo.
      456      define output parameter o-Date     as date    no-undo.
      457      define output parameter o-Time     as integer no-undo.
      458      define variable v-day-number as integer   no-undo .
      459      if    i-mjd-diff < 0
      460         or i-mjd-diff = ?
      461      then do:
      462         return "?" .
      463      end.
      464      assign
      465         v-day-number = truncate(i-mjd-diff,0).
      466         o-Date = date(v-day-number + 2400002).
      467         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      468     .
      469   end.
      470   function cur-time-mjd-to-string returns character
      471   (input p-mjd-diff as decimal
      472   )
      473   :
      474     define variable v-day-number as integer   no-undo .
      475     define variable v-seconds    as integer   no-undo .
      476     define variable v-hour       as integer   no-undo .
      477     define variable v-min        as integer   no-undo .
      478     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      479     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      480     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      481     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      482     if p-mjd-diff < 0
      483     or p-mjd-diff = ?
      484     then do:
      485       return "?" .
      486     end.
      487     assign
      488       v-day-number = integer(truncate(p-mjd-diff,0))
      489       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      490     .
      491     if v-seconds > 86400
      492     then do:
      493       assign
      494         v-seconds = 86400 - 1
      495       .
      496     end.
      497     if v-seconds < 0
      498     then do:
      499       assign
      500         v-seconds = 0
      501       .
      502     end.
      503     assign
      504       v-hour = truncate(v-seconds / 3600, 0)
      505     .
      506     assign
      507       v-seconds = v-seconds modulo 3600
      508     .
      509     assign
      510       v-min = truncate(v-seconds / 60, 0)
      511     .
      512     assign
      513       v-seconds = v-seconds modulo 60
      514     .
      515     return
      516         (if v-day-number <> 0
      517           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      518           else ""
      519         )
      520       + (if v-day-number <> 0 or v-hour <> 0
      521           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      522           else ""
      523         )
      524       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      525           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      526           else ""
      527         )
      528       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      529       .
      530   end.
      531   function cur-time-string returns character
      532   :
      533     define variable v-date as date      no-undo .
      534     define variable v-time as integer   no-undo .
      535     run cur-time in this-procedure
      536       (output v-date
      537       ,output v-time
      538       ) .
      539     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      540   end.
      541   function cur-time-string-sec returns character
      542   :
      543     define variable v-date as date      no-undo .
      544     define variable v-time as integer   no-undo .
      545     run cur-time in this-procedure
      546       (output v-date
      547       ,output v-time
      548       ) .
      549     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      550   end.
      551   function cur-time-custom  returns character
      552   (input p-prefix as character
      553   ,input p-date-format as character
      554   ,input p-delimiter as character
      555   ,input p-time-format as character
      556   ,input p-suffix as character
      557   )
      558   :
      559     define variable v-date as date      no-undo .
      560     define variable v-time as integer   no-undo .
      561     run cur-time in this-procedure
      562       (output v-date
      563       ,output v-time
      564       ) .
      565     return
      566       p-prefix
      567       + string(v-date, p-date-format)
      568       + p-delimiter
      569       + string(v-time, p-time-format)
      570       + p-suffix
      571       .
      572   end.
      573   function cur-time-print  returns character
      574   :
      575     define variable v-date as date      no-undo .
      576     define variable v-time as integer   no-undo .
      577     run cur-time in this-procedure
      578       (output v-date
      579       ,output v-time
      580       ) .
      581     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      582   end.
      583   function cur-time-datetime returns datetime
      584   :
      585     define variable v-char as character no-undo .
      586     define variable v-datetime as datetime no-undo .
      587     v-char = cur-time-string().
      588     v-datetime = datetime(v-char).
      589     return  v-datetime.
      590   end.
      591   function cur-time-string-msec returns character
      592   :
      593     define variable v-date as datetime  no-undo .
      594     v-date = now.
      595     return string(v-date) .
      596   end.
      597   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      598   procedure factord :
      599     define input  parameter p-fact-date            as date    no-undo .
      600     define input  parameter p-fact-time            as integer no-undo .
      601     define input  parameter p-fact-num             as integer no-undo .
      602     define input  parameter p-shift-date           as date    no-undo .
      603     define input  parameter p-shift-num            as integer no-undo .
      604     define input  parameter p-shift-on             as logical no-undo .
      605     define output parameter p-fact-order           as decimal no-undo .
      606     define output parameter p-shift-end-fact-order as decimal no-undo .
      607     define output parameter p-day-end-fact-order   as decimal no-undo .
      608     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      609     if p-fact-date = ?
      610     then do:
      611       return error "Не указана фактическая дата" .
      612     end.
      613     define variable v-fact-date-num as integer no-undo .
      614     assign
      615       v-fact-date-num = integer(p-fact-date)
      616     .
      617     if p-fact-num = ?
      618     or p-fact-num = 0
      619     then do:
      620       return error "Не задан p-fact-num " + string(p-fact-num) .
      621     end.
      622     if p-fact-num < 0
      623     then do:
      624       return error "Отрицательный fact-num " + string(p-fact-num) .
      625     end.
      626     if p-fact-num >= 100000000
      627     then do:
      628       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      629     end.
      630     if p-shift-on = true
      631     then do:
      632       if p-shift-date = ?
      633       then do:
      634         return error "Не задана дата смены" .
      635       end.
      636       if p-shift-num = ?
      637       or p-shift-num = 0
      638       then do:
      639         return error "Не задан номер смены" .
      640       end.
      641     end.
      642     else do:
      643       assign
      644         p-shift-date = p-fact-date
      645         p-shift-num  = 24
      646       .
      647     end.
      648     define variable v-shift-offset as integer no-undo .
      649     if p-shift-date = p-fact-date
      650     then do:
      651       assign
      652         v-shift-offset = 1
      653       .
      654     end.
      655     if p-shift-date < p-fact-date
      656     then do:
      657       assign
      658         v-shift-offset = 0
      659       .
      660     end.
      661     if p-shift-date > p-fact-date
      662     then do:
      663       message
      664         vss-workfile vss-revision vss-description skip
      665         "Неправильная дата закрытия смены" skip
      666         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      667         view-as alert-box error .
      668       undo, return error
      669         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      670           ,string(p-fact-date, '99/99/9999':U)
      671           ,string(p-shift-date, '99/99/9999':U)
      672           )
      673       .
      674     end.
      675     if p-shift-num < 1
      676     or p-shift-num > 24
      677     then do:
      678       message
      679         vss-workfile vss-revision vss-description skip
      680         "Неправильный номер смены" skip
      681         "p-shift-num" p-shift-num skip
      682         view-as alert-box error .
      683       undo, return error return-value .
      684     end.
      685     assign
      686       p-fact-order           = v-fact-date-num
      687                              + v-shift-offset * 0.5
      688                              + p-shift-num    * 0.02 - 0.01
      689                              + p-fact-num     * 0.0000000001
      690       p-shift-end-fact-order = v-fact-date-num
      691                              + v-shift-offset * 0.5
      692                              + p-shift-num    * 0.02
      693       p-day-end-fact-order   = v-fact-date-num
      694                              + 0.99
      695     .
      696     if p-fact-order           <= v-fact-date-num
      697     or p-shift-end-fact-order <= v-fact-date-num
      698     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      699     or p-shift-end-fact-order >= p-day-end-fact-order
      700     then do:
      701       message
      702         vss-workfile vss-revision vss-description skip
      703         "Внутренняя ошибка при генерации фактического номера" skip
      704         "p-fact-date"            p-fact-date            skip
      705         "p-fact-time"            p-fact-time            skip
      706         "p-fact-num"             p-fact-num             skip
      707         "p-shift-date"           p-shift-date           skip
      708         "p-shift-num"            p-shift-num            skip
      709         "p-shift-on"             p-shift-on             skip
      710         "p-shift-end-fact-order" p-shift-end-fact-order skip
      711         "p-day-end-fact-order"   p-day-end-fact-order   skip
      712         "v-fact-date-num"        v-fact-date-num        skip
      713         view-as alert-box error .
      714       undo, return error return-value .
      715     end.
      716   end procedure.
      717   procedure day-begin-fact-order :
      718     define input  parameter p-fact-date            as date    no-undo .
      719     define output parameter p-day-begin-fact-order as decimal no-undo .
      720     do
      721     on error undo, return error return-value
      722     :
      723       if p-fact-date = ?
      724       then do:
      725         assign
      726           p-day-begin-fact-order = 0
      727         .
      728       end.
      729       else do:
      730         assign
      731           p-day-begin-fact-order = integer(p-fact-date)
      732         .
      733       end.
      734     end.
      735   end procedure.
      736   procedure factord-max-fact-order :
      737     define output parameter p-max-fact-order as decimal   no-undo .
      738     do
      739     on error undo, return error return-value
      740     :
      741       run day-begin-fact-order in this-procedure
      742         (input  date(1, 1, 5000)
      743         ,output p-max-fact-order
      744         ) .
      745     end.
      746   end procedure.
      747   procedure factord-cut-archive :
      748     define input  parameter p-obj-type             as character no-undo .
      749     define input  parameter p-obj-code             as integer   no-undo .
      750     define input  parameter p-fact-date            as date      no-undo .
      751     define output parameter p-shift-on             as logical   no-undo .
      752     define output parameter p-shift-date           as date      no-undo .
      753     define output parameter p-shift-num            as integer   no-undo .
      754     define output parameter p-day-end-fact-order   as decimal   no-undo .
      755     define output parameter p-shift-end-fact-order as decimal   no-undo .
      756     define variable v-fact-order as decimal   no-undo .
      757     define buffer buf_shift-obj for ub.shift-obj .
      758     do
      759     on error undo, return error return-value
      760     :
      761   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      762   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      763     (input  p-obj-type
      764     ,input  p-obj-code
      765     ,input  'shift-on=request'
      766     ,output p-shift-on
      767     ) no-error .
      768       if error-status :error
      769       then do:
      770         message
      771           vss-workfile vss-revision vss-description skip
      772           "Ошибка при определении атрибута объекта" skip
      773           "Объект" p-obj-type p-obj-code skip
      774           error-status :get-message(1) skip
      775           return-value skip
      776           view-as alert-box error .
      777         undo, return error return-value .
      778       end.
      779       if p-shift-on = false
      780       then do:
      781         assign
      782           p-shift-date               = ?
      783           p-shift-num                = 0
      784         .
      785       end.
      786       else do:
      787         find first buf_shift-obj share-lock
      788           where buf_shift-obj.obj-type   = p-obj-type
      789             and buf_shift-obj.obj-code   = p-obj-code
      790             and buf_shift-obj.shift-date > p-fact-date
      791           use-index pi
      792           no-error .
      793         if not available buf_shift-obj
      794         or buf_shift-obj.status_ <> 'зкр':U
      795         then do:
      796           message
      797             vss-workfile vss-revision vss-description skip
      798             "Невозможно вычислить последнюю смену" skip
      799             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      800             "Объект" p-obj-type p-obj-code skip
      801             "Дата" p-fact-date skip
      802             view-as alert-box error .
      803           undo, return error return-value .
      804         end.
      805         find last buf_shift-obj share-lock
      806           where buf_shift-obj.obj-type = p-obj-type
      807             and buf_shift-obj.obj-code = p-obj-code
      808             and buf_shift-obj.shift-date <= p-fact-date
      809           use-index pi
      810           no-error .
      811         if available buf_shift-obj
      812         then do:
      813           if  buf_shift-obj.status_ = 'зкр':U
      814           then do:
      815             assign
      816               p-shift-date = buf_shift-obj.shift-date
      817               p-shift-num  = buf_shift-obj.shift-num
      818             .
      819           end.
      820           else do:
      821             message
      822               vss-workfile vss-revision vss-description skip
      823               "Невозможно вычислить последнюю смену" skip
      824               "Статус смены отличен от статуса" 'зкр':U skip
      825               "Объект" p-obj-type p-obj-code skip
      826               "Дата" p-fact-date skip
      827               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      828               view-as alert-box error .
      829             undo, return error return-value .
      830           end.
      831         end.
      832         else do:
      833           assign
      834             p-shift-date = p-fact-date - 1
      835             p-shift-num  = 1
      836           .
      837         end.
      838       end.
      839       run factord in this-procedure
      840         (input  p-fact-date
      841         ,input  1
      842         ,input  1
      843         ,input  p-shift-date
      844         ,input  p-shift-num
      845         ,input  p-shift-on
      846         ,output v-fact-order
      847         ,output p-shift-end-fact-order
      848         ,output p-day-end-fact-order
      849         ) no-error .
      850       if error-status :error
      851       then do:
      852         message
      853           vss-workfile vss-revision vss-description skip
      854           "Ошибка при вызове процедуры factord"
      855           error-status :get-message(1) skip
      856           return-value skip
      857           view-as alert-box error .
      858         undo, return error return-value .
      859       end.
      860     end.
      861   end procedure.
      862   procedure factord-lock-shift :
      863     define input  parameter p-obj-type  as character no-undo .
      864     define input  parameter p-obj-code  as integer   no-undo .
      865     define input  parameter p-fact-date as date      no-undo .
      866     define parameter buffer buf_shift-obj for ub.shift-obj .
      867     define variable v-shift-on      as logical   no-undo .
      868     define variable v-extra-message as character no-undo .
      869     define variable v-error as character no-undo .
      870     do
      871     on error undo, return error return-value
      872     :
      873   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      874   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      875     (input  p-obj-type
      876     ,input  p-obj-code
      877     ,input  'shift-on=request'
      878     ,output v-shift-on
      879     ) no-error .
      880       if error-status :error
      881       then do:
      882         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      883         undo, return error v-error .
      884       end.
      885       if v-shift-on = true
      886       then do:
      887         find first buf_shift-obj share-lock
      888           where buf_shift-obj.obj-type   = p-obj-type
      889             and buf_shift-obj.obj-code   = p-obj-code
      890             and buf_shift-obj.shift-date > p-fact-date
      891           use-index pi
      892           no-error .
      893         if not available buf_shift-obj
      894         or buf_shift-obj.status_ <> 'зкр':U
      895         then do:
      896           find last buf_shift-obj
      897             where buf_shift-obj.obj-type = p-obj-type
      898               and buf_shift-obj.obj-code = p-obj-code
      899               and buf_shift-obj.status_  = 'зкр':U
      900             use-index stts
      901             no-error .
      902           if available buf_shift-obj
      903           then do:
      904             assign
      905               v-extra-message =
      906                     substitute("Дата начала последеней закрытой смены на объекте &1"
      907                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      908                               )
      909             .
      910           end.
      911           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      912           undo, return error v-error .
      913         end.
      914       end.
      915     end.
      916   end procedure.
      917   procedure factord-end-day :
      918     define input  parameter p-fact-date            as date    no-undo .
      919     define output parameter p-day-end-fact-order   as decimal no-undo .
      920     do
      921     on error undo, return error return-value
      922     :
      923       if p-fact-date = ?
      924       then do:
      925         return error "Не указана фактическая дата" .
      926       end.
      927       assign
      928         p-day-end-fact-order = integer(p-fact-date) + 0.99
      929       .
      930     end.
      931   end procedure.
      932   procedure factord-to-date :
      933     define input  parameter p-fact-order as decimal no-undo .
      934     define output parameter p-fact-date  as date    no-undo .
      935     define variable v-ref-date  as date      no-undo .
      936     define variable v-ref-delta as integer   no-undo .
      937     do
      938     on error undo, return error return-value
      939     :
      940       if p-fact-order = ?
      941       or p-fact-order = 0
      942       then do:
      943         return error "Не указан fact-order" .
      944       end.
      945       assign
      946         v-ref-date  = date(1, 1, 2000)
      947       .
      948       assign
      949         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      950       .
      951       assign
      952         p-fact-date = v-ref-date + v-ref-delta
      953       .
      954     end.
      955   end procedure.
      956   procedure factord-to-fact-num :
      957     define input  parameter p-fact-order as decimal no-undo .
      958     define output parameter p-fact-num   as integer no-undo .
      959     define variable v-fact-order-trunc as decimal no-undo .
      960     do
      961     on error undo, return error return-value
      962     :
      963       if p-fact-order = ?
      964       or p-fact-order = 0
      965       then do:
      966         return error "Не указан fact-order" .
      967       end.
      968       assign
      969        v-fact-order-trunc = truncate(p-fact-order, 2)
      970       .
      971       assign
      972         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      973       .
      974     end.
      975   end procedure.
      976   procedure factord-to-shift-num :
      977     define input  parameter p-fact-order as decimal no-undo .
      978     define output parameter p-shift-num   as integer no-undo .
      979     define variable  p-shift-numd  as decimal   no-undo .
      980     define variable v-fact-order-trunc as decimal no-undo .
      981     do
      982     on error undo, return error return-value
      983     :
      984       if p-fact-order = ?
      985       or p-fact-order = 0
      986       then do:
      987         return error "Не указан fact-order" .
      988       end.
      989       assign
      990        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      991       .
      992       if v-fact-order-trunc < 0.5 then do:
      993         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      994       end.
      995       assign
      996         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      997         .
      998        assign
      999         p-shift-num = truncate (p-shift-numd , 0)
     1000       .
     1001     end.
     1002   end procedure.
     1003   procedure fact-order-mpl :
     1004     do
     1005     on error undo, return error return-value
     1006     :
     1007   define input  parameter p-doc-date as date     no-undo .
     1008   define input  parameter p-obj-type as character no-undo .
     1009   define input  parameter p-obj-code as integer   no-undo .
     1010   define output parameter p-fact-order as decimal   no-undo .
     1011   define variable v-fact-date            as date    no-undo .
     1012   define variable v-fact-time            as integer no-undo .
     1013   define variable v-fact-order           as decimal no-undo .
     1014   define variable v-shift-end-fact-order as decimal no-undo .
