     1102            input-output shift-date      ,
     1103            input-output shift-num       ,
     1104            input-output shift-name      ,
     1105            input        yes
     1106            ) no-error .
     1107         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1108         v-fact-date = p-doc-date .
     1109         run factord in this-procedure
     1110           (input  v-fact-date
     1111           ,input  v-fact-time
