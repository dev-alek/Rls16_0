     1196   define buffer buf_pay-type               for ub.pay-type  .
     1197   define buffer buf_cash-pay               for ub.cash-pay  .
     1198   define variable to-day          as date      no-undo .
     1199   define variable v-base-rate0    as decimal   no-undo .
