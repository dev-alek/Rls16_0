     1293     v-cli-oborot-ALL  = 0 .
     1294     for each buf_turnover-buyer-main no-lock  where
     1295              buf_turnover-buyer-main.cli-type = p-cli-type  and
     1296              buf_turnover-buyer-main.cli-code = p-cli-code
     1297              :
     1298              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1299     end.
     1300   for each buf_price-all no-lock where
     1301            buf_price-all.obj-type = p-obj-type and
     1302            buf_price-all.obj-code = p-obj-code and
     1303            buf_price-all.gds-code = buf_goods.gds-code and
     1304            buf_price-all.status_  = 'акт':U  and
     1305          ( p-only-b-code = false   or
     1306          ( buf_price-all.b-code = p-main-b-code or
     1307            buf_price-all.b-code = p-b-code))    and
     1308           ( p-only-b-code = true  or
     1309             buf_price-all.b-code = p-b-code)
     1310             and
     1311             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1312           ( buf_price-all.fact-order-sys-to = ? or
     1313             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1314           :
     1315            v-interv   = "" .
     1316            v-grp-name = "" .
     1317            v-pay-name = "" .
     1318            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1319            if buf_price-all.bgr-id > 0 then do:
     1320               find first buf_buyer-group no-lock where
     1321                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1322                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1323               if available buf_buyer-group then do:
     1324                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1325                  find first buf_buyer-in-buyer-group no-lock where
     1326                             buf_buyer-in-buyer-group.stts         = 0 and
     1327                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1328                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1329                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1330                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1331                             no-error .
     1332                             if not available buf_buyer-in-buyer-group then do:
     1333                                v-grp-name = "".
     1334                                next.
     1335                             end.
     1336                             v-grp-name = buf_buyer-group.name .
     1337                  end.
     1338               end.
     1339               else do:
     1340                    v-grp-name = "".
     1341                    next.
     1342               end.
     1343            end.
     1344            if buf_price-all.tog-id > 0 then do:
     1345               find first buf_turnover-group no-lock where
     1346                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1347                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1348               if available buf_turnover-group then do:
     1349                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1350                     v-cli-oborot = v-cli-oborot-all  .
     1351                     find first buf1_tnv-in-turnover-group no-lock where
     1352                                buf1_tnv-in-turnover-group.stts       =  0     and
     1353                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1354                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1355                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1356                     find first buf2_tnv-in-turnover-group no-lock where
     1357                                buf2_tnv-in-turnover-group.stts       =  0     and
     1358                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1359                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1360                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1361                     if not (available buf1_tnv-in-turnover-group and
     1362                             available buf2_tnv-in-turnover-group ) then do:
     1363                             v-grp-name = "".
     1364                             next .
     1365                     end.
     1366                     v-grp-name = buf_turnover-group.name.
     1367                  end.
     1368               end.
     1369               else do:
     1370                    v-grp-name = "".
     1371                    next.
     1372               end.
     1373            end.
     1374            if buf_price-all.plt-fix-cource-crc-base = true then
     1375               assign
     1376                 v-base-rate  = buf_price-all.pdf-base-rate
     1377                 v-base-scale = buf_price-all.pdf-base-scale
     1378               .
     1379               else
     1380               assign
     1381                 v-base-rate  = v-base-rate0
     1382                 v-base-scale = v-base-scale0
     1383               .
     1384            if buf_price-all.plt-fix-cource-crc-doc = true then
     1385               assign
     1386                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1387                 v-exch-scale = buf_price-all.pdf-exch-scale
     1388               .
     1389               else do:
     1390   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1392     (input  buf_price-all.curr-code
     1393     ,input  to-day
     1394     ,output v-exch-rate0
     1395     ,output v-exch-scale0
     1396     ,output v-curr-abbr
     1397     )  .
     1398               assign
     1399                 v-exch-rate  = v-exch-rate0
     1400                 v-exch-scale = v-exch-scale0
     1401                 .
     1402              end.
     1403              v-date-1 = date ( "" )  .
     1404              if buf_price-all.fact-order-sys-from > 0 then do:
     1405                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1406                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1407                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1408              end.
     1409              v-date-2 =  date ( "" )  .
     1410              if buf_price-all.fact-order-sys-to > 0 then do:
     1411                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1412                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1413                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1414              end.
     1415              if buf_price-all.qnty-from <> ? then do :
     1416                 if not (
     1417                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1418                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1419                 ) then do:
     1420                        v-interv = "".
     1421                        next.
     1422                 end.
     1423                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1424              end.
     1425              if buf_price-all.sum-from <> ? then do :
     1426                 if not (
     1427                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1428                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1429                 ) then do:
     1430                    v-interv = "".
     1431                    next.
     1432                 end.
     1433                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1434              end.
     1435              if buf_price-all.turnover-from <> ? then do :
     1436                 if not (
     1437                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1438                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1439                 ) then do:
     1440                    v-interv = "".
     1441                    next.
     1442                 end.
     1443                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1444              end.
     1445              if buf_price-all.use-pay-type = 1 then do :
     1446                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     1447                    v-pay-name = "" .
     1448                    next.
     1449                  end.
     1450                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     1451              end.
     1452              if buf_price-all.use-cash-pay = 1 then do :
     1453                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     1454                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     1455                   v-pay-name = "" .
     1456                   next.
     1457                 end.
     1458                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     1459              end.
     1460             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     1461             create tt_price-all .
     1462             buffer-copy buf_price-all to tt_price-all
     1463             assign
     1464               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     1465               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     1466               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     1467               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     1468               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     1469               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     1470               tt_price-all.price-sale     = buf_price-all.price-sale
     1471               tt_price-all.road-tax       = buf_price-all.road-tax
     1472               tt_price-all.excise         = buf_price-all.excise
     1473               tt_price-all.pdf-exch-rate   = v-exch-rate
     1474               tt_price-all.pdf-exch-scale  = v-exch-scale
     1475               tt_price-all.pdf-base-rate   = v-base-rate
     1476               tt_price-all.pdf-base-scale  = v-base-scale
     1477               tt_price-all.grp-name        = v-grp-name
     1478               tt_price-all.date-1          = v-date-1
     1479               tt_price-all.shift-1         = buf_price-all.start-shift-num
     1480               tt_price-all.time-1          = buf_price-all.start-sys-time
     1481               tt_price-all.date-2          = v-date-2
     1482               tt_price-all.shift-2         = buf_price-all.end-shift-num
     1483               tt_price-all.time-2          = buf_price-all.end-sys-time
     1484               tt_price-all.interv-name     = v-interv
     1485               tt_price-all.pay-name        = v-pay-name
     1486               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     1487             .
     1488   end.
     1489   define variable vt-plt-id as integer   no-undo .
     1490   define variable vt-plt-db as integer   no-undo .
     1491   define variable vt-pdf-id as integer   no-undo .
     1492   define variable vt-pdf-db as integer   no-undo .
     1493   define buffer neos_price-all for tt_price-all  .
     1494   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     1495       if available tt_price-all then do:
     1496        assign
     1497          vt-plt-id = tt_price-all.plt-id
     1498          vt-plt-db = tt_price-all.plt-db-num
     1499          vt-pdf-id = tt_price-all.pdf-id
     1500          vt-pdf-db = tt_price-all.pdf-db
     1501        .
     1502        if tt_price-all.b-code = p-b-code then do:
     1503             assign
     1504               p-plt-id           = tt_price-all.plt-id
     1505               p-plt-db-num       = tt_price-all.plt-db-num
     1506               p-pdf-id           = tt_price-all.pdf-id
     1507               p-pdf-db-num       = tt_price-all.pdf-db
     1508               p-sale-price-base  = tt_price-all.price-sale-base
     1509               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1510               p-road-tax-base    = tt_price-all.road-tax-base
     1511               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1512               p-excise-base      = tt_price-all.excise-base
     1513               p-excise-rubl      = tt_price-all.excise-rubl
     1514               .
     1515        end.
     1516        else do:
     1517          find first neos_price-all where
     1518                     neos_price-all.b-code     = p-b-code  and
     1519                     neos_price-all.plt-id     = vt-plt-id and
     1520                     neos_price-all.plt-db-num = vt-plt-db and
     1521                     neos_price-all.pdf-id     = vt-pdf-id and
     1522                     neos_price-all.pdf-db     = vt-pdf-db
     1523                     use-index pi no-error .
     1524            if available neos_price-all then do:
     1525             assign
     1526               p-plt-id           = tt_price-all.plt-id
     1527               p-plt-db-num       = tt_price-all.plt-db-num
     1528               p-pdf-id           = tt_price-all.pdf-id
     1529               p-pdf-db-num       = tt_price-all.pdf-db
     1530               p-sale-price-base  = neos_price-all.price-sale-base
     1531               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1532               p-road-tax-base    = neos_price-all.road-tax-base
     1533               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1534               p-excise-base      = neos_price-all.excise-base
     1535               p-excise-rubl      = neos_price-all.excise-rubl
     1536               .
     1537            end.
     1538            else do:
     1539                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1540                 if error-status :error    then do:
     1541                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1542                   return error return-value .
     1543                 end.
     1544             assign
     1545               p-plt-id           = tt_price-all.plt-id
     1546               p-plt-db-num       = tt_price-all.plt-db-num
     1547               p-pdf-id           = tt_price-all.pdf-id
     1548               p-pdf-db-num       = tt_price-all.pdf-db
     1549               p-sale-price-base  = tt_price-all.price-sale-base
     1550               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1551               p-road-tax-base    = tt_price-all.road-tax-base
     1552               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1553               p-excise-base      = tt_price-all.excise-base
     1554               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     1555               .
     1556            end.
     1557        end.
     1558     end.
     1559   end.
     1560   end procedure.
     1561   procedure mpl-tpl-auto :
     1562   define input  parameter p-b-code     as integer   no-undo .
     1563   define input  parameter p-obj-type   as character no-undo .
     1564   define input  parameter p-obj-code   as integer   no-undo .
     1565   define input  parameter p-plt-id     as integer   no-undo .
     1566   define input  parameter p-plt-db-num as integer   no-undo .
     1567   define input  parameter p-fact-order as decimal   no-undo .
     1568   define output parameter p-sale-price as decimal   no-undo .
     1569   define output parameter p-pdf-id     as integer   no-undo .
     1570   define output parameter p-pdf-db-num as integer   no-undo .
     1571     do
     1572     on error undo, return error return-value
     1573     :
     1574   if p-fact-order = ? then do:
     1575     run fact-order-mpl (
     1576         input   today       ,
     1577         input   p-obj-type  ,
     1578         input   p-obj-code  ,
     1579         output  p-fact-order ) .
     1580   end.
     1581   assign
     1582     p-pdf-id      = ?
     1583     p-pdf-db-num  = ?
     1584     p-sale-price  = ?
     1585   .
     1586   define buffer buf_bar-code for ub.bar-code  .
     1587   define buffer buf_goods for ub.goods  .
     1588   find first buf_bar-code no-lock where
     1589              buf_bar-code.b-code = p-b-code
     1590              no-error .
     1591   if error-status :error then return error return-value .
     1592   find first buf_goods no-lock where
     1593              buf_goods.gds-code = buf_bar-code.gds-code
     1594              no-error .
     1595   if error-status :error then return error return-value .
     1596   define variable v-main-b-code as integer   no-undo .
     1597   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1598     (input  buf_goods.gds-code
     1599     ,input  ?
     1600     ,output v-main-b-code
     1601     )  .
     1602   define buffer buf_price-all for ub.price-all  .
     1603   for each tt_price-all : delete tt_price-all. end.
     1604       for each buf_price-all no-lock where
     1605               buf_price-all.plt-id     = p-plt-id                 and
     1606               buf_price-all.plt-db-num = p-plt-db-num             and
     1607               buf_price-all.obj-type   = p-obj-type               and
     1608               buf_price-all.obj-code   = p-obj-code               and
     1609               buf_price-all.gds-code   = buf_goods.gds-code       and
     1610             ( buf_price-all.b-code = v-main-b-code or
     1611               buf_price-all.b-code = p-b-code)    and
     1612               buf_price-all.status_    = 'акт':U         and
     1613               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1614             ( buf_price-all.fact-order-sys-to = ? or
     1615               buf_price-all.fact-order-sys-to >=  p-fact-order)
     1616               :
     1617                 create tt_price-all .
     1618                 buffer-copy buf_price-all to tt_price-all
     1619                 assign
     1620                   tt_price-all.price-sale  = buf_price-all.price-sale
     1621                 .
     1622       end.
     1623   define variable vt-plt-id as integer   no-undo .
     1624   define variable vt-plt-db as integer   no-undo .
     1625   define variable vt-pdf-id as integer   no-undo .
     1626   define variable vt-pdf-db as integer   no-undo .
     1627   define buffer neos_price-all for tt_price-all  .
     1628   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     1629       if available tt_price-all then do:
     1630        assign
     1631          vt-plt-id = tt_price-all.plt-id
     1632          vt-plt-db = tt_price-all.plt-db-num
     1633          vt-pdf-id = tt_price-all.pdf-id
     1634          vt-pdf-db = tt_price-all.pdf-db
     1635        .
     1636        if tt_price-all.b-code = p-b-code then do:
     1637             assign
     1638               p-plt-id           = tt_price-all.plt-id
     1639               p-plt-db-num       = tt_price-all.plt-db-num
     1640               p-pdf-id           = tt_price-all.pdf-id
     1641               p-pdf-db-num       = tt_price-all.pdf-db
     1642               p-sale-price       = tt_price-all.price-sale
     1643               .
     1644        end.
     1645        else do:
     1646          find first neos_price-all where
     1647                     neos_price-all.b-code     = p-b-code  and
     1648                     neos_price-all.plt-id     = vt-plt-id and
     1649                     neos_price-all.plt-db-num = vt-plt-db and
     1650                     neos_price-all.pdf-id     = vt-pdf-id and
     1651                     neos_price-all.pdf-db     = vt-pdf-db
     1652                     use-index pi no-error .
     1653            if available neos_price-all then do:
     1654             assign
     1655               p-plt-id           = tt_price-all.plt-id
     1656               p-plt-db-num       = tt_price-all.plt-db-num
     1657               p-pdf-id           = tt_price-all.pdf-id
     1658               p-pdf-db-num       = tt_price-all.pdf-db
     1659               p-sale-price       = neos_price-all.price-sale
     1660               .
     1661            end.
     1662            else do:
     1663           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1664           if error-status :error    then do:
     1665              message "Не найден бар-код" p-b-code view-as alert-box error .
     1666              return error return-value .
     1667           end.
     1668             assign
     1669               p-plt-id           = tt_price-all.plt-id
     1670               p-plt-db-num       = tt_price-all.plt-db-num
     1671               p-pdf-id           = tt_price-all.pdf-id
     1672               p-pdf-db-num       = tt_price-all.pdf-db
     1673               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     1674               .
     1675            end.
     1676        end.
     1677     end.
     1678     end.
     1679   end procedure.
     1680   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1681   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1682   procedure wthcattr-sprcli :
     1683   define input parameter parparentproc  as widget-handle no-undo.
     1684   define input parameter p-mode  as character no-undo.
     1685   define input-output parameter p-value as character no-undo .
     1686   define output parameter p-setted as logical no-undo .
     1687     DEFINE VARIABLE v-value as character no-undo .
     1688     define variable v-cli-type as character no-undo .
     1689     define variable v-cli-code as integer no-undo .
     1690     define buffer buf_clients   for ub.clients.
     1691     define variable v_rid as character no-undo.
     1692     define variable ref-rec as recid no-undo .
     1693     do
     1694     on error undo, return error
     1695     :
     1696         v-value = p-value.
     1697      if p-value <> '':U then do:
     1698       assign
     1699       v-cli-type = substring(p-value, 1, 3)
     1700       v-cli-code = integer(substring(p-value, 4))
     1701       no-error.
     1702       if error-status:error then do:
     1703         assign
     1704         v-cli-type = '':U
     1705         v-cli-code = 0
     1706         .
     1707       end.
     1708      end.
     1709      FIND FIRST buf_clients NO-LOCK WHERE
     1710               buf_clients.obj-type = v-cli-type AND
     1711               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1712      IF available(buf_clients) then do:
     1713       run ref/cli-all.w (
     1714                   input parparentproc
     1715                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1716                  ,input v-cli-type
     1717                  ,input 'все':U
     1718                  ,input 'все':U
     1719                  ,input RECID( buf_clients )
     1720                  ,input ",,,,,,NO"
     1721                  ,input ?
     1722                  ,OUTPUT v_rid ).
     1723     END.
     1724     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1725       run ref/cli-all.w (
     1726                    input parparentproc
     1727                   ,INPUT "b-sel":U
     1728                  ,input  v-cli-type
     1729                  ,input 'все':U
     1730                  ,input 'текущие':U
     1731                  ,input ?
     1732                  ,input ",,,,,,NO"
     1733                  ,input ?
     1734                  ,OUTPUT v_rid ).
     1735     END.
     1736     else do:
     1737       message
     1738       if p-value = "":U then 'Атрибут не задан!'
     1739       else substitute('Не найден клиент &1',p-value)
     1740       view-as alert-box warning.
     1741     end.
     1742     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1743       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1744       IF ERROR-STATUS:ERROR THEN DO:
     1745           RETURN NO-APPLY.
     1746       END.
     1747       FIND FIRST buf_clients NO-LOCK WHERE
     1748                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1749       IF AVAIL buf_clients THEN DO:
     1750         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1751       end.
     1752     end.
     1753     if v-value <> p-value then do:
     1754       p-value = v-value.
     1755       p-setted = yes.
     1756     end.
     1757     end.
     1758   end procedure.
     1759     define new global shared variable g#wthcalib as handle no-undo.
     1760   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     1761   define variable v-tth as handle no-undo .
     1762   assign
     1763   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1764   def temp-table tt-wthlib-parts no-undo like ub.wth-parts.
     1765   Procedure wth-doc-close:
     1766       define input parameter p-rec        as recid     no-undo .
     1767       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     1768     do
     1769     on error undo, return error return-value
     1770     :
     1771       find first cur-wth-parts where recid(cur-wth-parts) = p-rec exclusive-lock no-wait no-error.
     1772       if not available cur-wth-parts then return error substitute("Не найдена партия").
     1773       CASE cur-wth-parts.ext-doc-type:
     1774           WHEN 'ie':U or when 'rf':U or when 'ff':U
     1775           OR WHEN 'fj':U
     1776           THEN DO:
     1777              RUN wth-parts-close(BUFFER cur-wth-parts, 'free-zone':U ).
     1778           END.
     1779           WHEN 'ee':U THEN DO:
     1780               RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     1781           END.
     1782           WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'rp':U
     1783             OR WHEN 'ip':U OR WHEN 'pc':U
     1784             OR WHEN 'pj':U
     1785              THEN DO:
     1786               RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     1787           END.
     1788           WHEN 'df':U OR WHEN 'dp':U OR WHEN 'dc':U THEN DO:
     1789             RUN wth-parts-close(BUFFER cur-wth-parts, 'out-zone':U ).
     1790           end.
     1791           when 'ep':U or when 'ef':U
     1792           OR WHEN 'oj':U or when 'jj':U
     1793           then .
     1794           when 'xc':U then do:
     1795             if cur-wth-parts.type = 'при':U then
     1796                  RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     1797             else RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     1798           end.
     1799           OTHERWISE DO:
     1800               RETURN ERROR substitute("Неверный вызов процедуры закрытия: расш. тип = &1"
     1801                                    , cur-wth-parts.ext-doc-type
     1802                                       ).
     1803           END.
     1804       END CASE.
     1805       RELEASE cur-wth-parts.
     1806       END.
     1807   END.
     1808   PROCEDURE wth-parts-close:
     1809       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     1810       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     1811       define variable v-rec as recid.
     1812       if bfrom_wth-parts.stts  = 1 then return.
     1813          run str/wthpartp.p  ( INPUT     'ДОБАВЛЕНИЕ':U,
     1814                     INPUT     bfrom_wth-parts.obj-type,
     1815                     INPUT     bfrom_wth-parts.obj-code,
     1816                     INPUT     bfrom_wth-parts.w-p-code,
     1817                     INPUT     bfrom_wth-parts.wth-code,
     1818                     INPUT     bfrom_wth-parts.par-code,
     1819                     INPUT     bfrom_wth-parts.in-code ,
     1820                     INPUT     p-zone,
     1821                     INPUT     bfrom_wth-parts.ser-code,
     1822                     INPUT     bfrom_wth-parts.db-num  ,
     1823                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1824                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     1825                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1826                     INPUT     bfrom_wth-parts.fact-rangeTo ,
     1827                     INPUT     bfrom_wth-parts.host-code     ,
     1828                     INPUT     bfrom_wth-parts.contract-code               ,
     1829                     INPUT     bfrom_wth-parts.price-rubl    ,
     1830                     INPUT     bfrom_wth-parts.price-base    ,
     1831                     INPUT     bfrom_wth-parts.supp-type,
     1832                     INPUT     bfrom_wth-parts.supp-code,
     1833                     INPUT     bfrom_wth-parts.in-obj-type      ,
     1834                     INPUT     bfrom_wth-parts.in-obj-code      ,
     1835                     INPUT     bfrom_wth-parts.ext-doc-type,
     1836                     INPUT     bfrom_wth-parts.gds-code,
     1837                     INPUT     bfrom_wth-parts.stts               ,
     1838                     INPUT     bfrom_wth-parts.beg-dt        ,
     1839                     INPUT     bfrom_wth-parts.end-dt        ,
     1840                     INPUT     bfrom_wth-parts.vat-pc        ,
     1841                     INPUT     bfrom_wth-parts.cli-code,
     1842                     INPUT     bfrom_wth-parts.cli-type,
     1843                     INPUT     bfrom_wth-parts.out-obj-code,
     1844                     INPUT     bfrom_wth-parts.out-obj-type,
     1845                     INPUT     bfrom_wth-parts.sale-obj-code,
     1846                     INPUT     bfrom_wth-parts.sale-obj-type,
     1847                     INPUT     bfrom_wth-parts.out-code ,
     1848                     INPUT  yes,
     1849                     INPUT     '':U ,
     1850                     INPUT-OUTPUT v-rec
     1851                     ) no-error.
     1852       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     1853   END.
     1854   Procedure wth-doc-razrez:
     1855       define input parameter p-rec as recid NO-UNDO.
     1856       define input parameter p-doc-del AS log NO-UNDO.
     1857       define variable v-mess AS CHAR NO-UNDO.
     1858       define variable p-silent AS LOG INIT NO NO-UNDO.
     1859       DEFINE BUFFER b-wth-parts FOR ub.wth-parts.
     1860       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     1861       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     1862     do
     1863     on error undo, return error return-value
     1864     :
     1865       FIND FIRST cur-wth-parts WHERE recid(cur-wth-parts) = p-rec
     1866                                 EXCLUSIVE-LOCK .
     1867       IF AVAILABLE cur-wth-parts THEN DO:
     1868           CASE cur-wth-parts.ext-doc-type:
     1869               WHEN 'ie':U or when 'ip':U or when 'rp':U
     1870               or when 'ff':U or when 'rf':U
     1871               or when 'fj':U or when 'pj':U
     1872               THEN DO:
     1873                   RUN wth-parts-raz(BUFFER cur-wth-parts, "":U,p-doc-del) .
     1874               END.
     1875               WHEN 'ee':U or when 'ef':U or when 'jj':U
     1876               THEN DO:
     1877                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del) .
     1878               END.
     1879               WHEN 'ep':U or when 'oj':U THEN DO:
     1880                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del) .
     1881               END.
     1882               WHEN 'pc':U THEN DO:
     1883                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     1884               END.
     1885               WHEN 'dp':U THEN DO:
     1886                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del)  .
     1887               END.
     1888               WHEN 'df':U THEN DO:
     1889                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del)  .
     1890               END.
     1891               WHEN 'dc':U THEN DO:
     1892                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     1893               END.
     1894               WHEN 'ps':U OR WHEN 'pz':U THEN DO:
     1895                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del).
     1896               END.
     1897               when 'xc':U then do:
     1898                 if cur-wth-parts.type = 'при':U then
     1899                      RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del ).
     1900                 else RUN wth-parts-raz(BUFFER cur-wth-parts,  'free-zone':U ,p-doc-del).
     1901               end.
     1902               OTHERWISE DO:
     1903                   RETURN ERROR substitute("Неверный вызов процедуры разрезервирования: расш. тип =  :&1&2&3"
     1904                                        , cur-wth-parts.ext-doc-type
     1905                                        , error-status:get-message(1)
     1906                                        , return-value
     1907                                        ).
     1908               END.
     1909           END CASE.
     1910       END.
     1911     END.
     1912   END.
     1913   PROCEDURE wth-parts-raz:
     1914       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     1915       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     1916       DEFINE INPUT PARAMETER p-doc-del AS log NO-UNDO.
     1917       define variable v-mes as char no-undo.
     1918       define variable v-rec as recid no-undo.
     1919       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     1920     do
     1921     on error undo, return error return-value
     1922     :
     1923       v-mes = substitute('Код серии: &1-&2 Диапазон &3-&4'
     1924                                      ,bfrom_wth-parts.ser-code
     1925                                      ,bfrom_wth-parts.db-num
     1926                                      ,bfrom_wth-parts.doc-rangeFrom
     1927                                      ,bfrom_wth-parts.doc-rangeTo).
     1928       IF lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0 THEN DO:
     1929           RETURN ERROR substitute("Нельзя удалять партии МЦ из зоны :&1&2&3&4&5"
     1930                                , error-status:get-message(1)
     1931                                , bfrom_wth-parts.out-code
     1932                                , return-value
     1933                                ,chr(10)
     1934                                ,v-mes
     1935                                ).
     1936       END.
     1937       v-rec = recid(bfrom_wth-parts).
     1938       CASE bfrom_wth-parts.ext-doc-type:
     1939           WHEN 'ie':U  or when 'fj':U or when  'pj':U THEN DO:
     1940               delete bfrom_wth-parts NO-ERROR.
     1941               if error-status:error then do:
     1942                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1943                                      , error-status:get-message(1)
     1944                                      , chr(10)
     1945                                      , return-value
     1946                                      ,v-mes
     1947                                      ).
     1948               END.
     1949           END.
     1950           when 'rp':U or when 'rf':U then do:
     1951             if p-doc-del then do:
     1952               delete bfrom_wth-parts NO-ERROR.
     1953               if error-status:error then do:
     1954                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1955                                      , error-status:get-message(1)
     1956                                      , chr(10)
     1957                                      , return-value
     1958                                      ,v-mes
     1959                                      ).
     1960               END.
     1961             end.
     1962             else   RETURN ERROR 'Нельзя удалять партии документа внутреннего возврата.'  .
     1963           end.
     1964           when 'ip':U or when 'ff':U then do:
     1965             if p-doc-del then do:
     1966               delete bfrom_wth-parts NO-ERROR.
     1967               if error-status:error then do:
     1968                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1969                                      , error-status:get-message(1)
     1970                                      , chr(10)
     1971                                      , return-value
     1972                                      ,v-mes
     1973                                      ).
     1974               END.
     1975             end.
     1976             else do:
     1977               run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     1978                     INPUT     bfrom_wth-parts.obj-type,
     1979                     INPUT     bfrom_wth-parts.obj-code,
     1980                     INPUT     bfrom_wth-parts.w-p-code,
     1981                     INPUT     bfrom_wth-parts.wth-code,
     1982                     INPUT     bfrom_wth-parts.par-code,
     1983                     INPUT     bfrom_wth-parts.in-code ,
     1984                     INPUT     bfrom_wth-parts.out-code,
     1985                     INPUT     bfrom_wth-parts.ser-code,
     1986                     INPUT     bfrom_wth-parts.db-num  ,
     1987                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1988                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     1989                     INPUT     bfrom_wth-parts.doc-RangeFrom ,
     1990                     INPUT     bfrom_wth-parts.doc-rangeTo  ,
     1991                     INPUT     bfrom_wth-parts.host-code     ,
     1992                     INPUT     bfrom_wth-parts.contract-code ,
     1993                     INPUT     bfrom_wth-parts.price-rubl    ,
     1994                     INPUT     bfrom_wth-parts.price-base    ,
     1995                     INPUT     bfrom_wth-parts.supp-type,
     1996                     INPUT     bfrom_wth-parts.supp-code,
     1997                     INPUT     bfrom_wth-parts.in-obj-type      ,
     1998                     INPUT     bfrom_wth-parts.in-obj-code      ,
     1999                     INPUT     bfrom_wth-parts.ext-doc-type,
     2000                     INPUT     bfrom_wth-parts.gds-code,
     2001                     INPUT     1            ,
     2002                     INPUT     bfrom_wth-parts.beg-dt        ,
     2003                     INPUT     bfrom_wth-parts.end-dt        ,
     2004                     INPUT     bfrom_wth-parts.vat-pc        ,
     2005                     INPUT     bfrom_wth-parts.cli-code,
     2006                     INPUT     bfrom_wth-parts.cli-type,
     2007                     INPUT     bfrom_wth-parts.out-obj-code,
     2008                     INPUT     bfrom_wth-parts.out-obj-type,
     2009                     INPUT     bfrom_wth-parts.sale-obj-code,
     2010                     INPUT     bfrom_wth-parts.sale-obj-type,
     2011                     INPUT     bfrom_wth-parts.doc-code ,
     2012                     INPUT  yes,
     2013                     INPUT     bfrom_wth-parts.type ,
     2014                     INPUT-OUTPUT v-rec
     2015                     ) no-error.
     2016                if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2017             end.
     2018           end.
     2019           OTHERWISE DO:
     2020            run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2021                     INPUT     bfrom_wth-parts.obj-type,
     2022                     INPUT     bfrom_wth-parts.obj-code,
     2023                     INPUT     bfrom_wth-parts.w-p-code,
     2024                     INPUT     bfrom_wth-parts.wth-code,
     2025                     INPUT     bfrom_wth-parts.par-code,
     2026                     INPUT     bfrom_wth-parts.in-code ,
     2027                     INPUT     p-zone,
     2028                     INPUT     bfrom_wth-parts.ser-code,
     2029                     INPUT     bfrom_wth-parts.db-num  ,
     2030                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2031                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2032                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2033                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     2034                     INPUT     bfrom_wth-parts.host-code     ,
     2035                     INPUT     bfrom_wth-parts.contract-code ,
     2036                     INPUT     bfrom_wth-parts.price-rubl    ,
     2037                     INPUT     bfrom_wth-parts.price-base    ,
     2038                     INPUT     bfrom_wth-parts.supp-type,
     2039                     INPUT     bfrom_wth-parts.supp-code,
     2040                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2041                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2042                     INPUT     bfrom_wth-parts.ext-doc-type,
     2043                     INPUT     bfrom_wth-parts.gds-code,
     2044                     INPUT     bfrom_wth-parts.stts             ,
     2045                     INPUT     bfrom_wth-parts.beg-dt        ,
     2046                     INPUT     bfrom_wth-parts.end-dt        ,
     2047                     INPUT     bfrom_wth-parts.vat-pc        ,
     2048                     INPUT     bfrom_wth-parts.cli-code,
     2049                     INPUT     bfrom_wth-parts.cli-type,
     2050                     INPUT     bfrom_wth-parts.out-obj-code,
     2051                     INPUT     bfrom_wth-parts.out-obj-type,
     2052                     INPUT     bfrom_wth-parts.sale-obj-code,
     2053                     INPUT     bfrom_wth-parts.sale-obj-type,
     2054                     INPUT     bfrom_wth-parts.doc-code ,
     2055                     INPUT  yes,
     2056                     INPUT      "":U ,
     2057                     INPUT-OUTPUT v-rec
     2058                     ) no-error.
     2059       if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2060           END.
     2061       END CASE.
     2062     END.
     2063   END.
     2064   procedure wth-parts-rezerv:
     2065       define input parameter        p-param            as logical no-undo.
     2066       define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2067       define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2068       define input parameter        p-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2069       define input parameter        p-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2070       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2071       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2072       define input parameter        p-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2073       define input parameter        p-price-base       LIKE ub.wth-parts.price-base no-undo .
     2074       define input parameter        p-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2075       define input parameter        p-host-code        LIKE ub.wth-parts.host-code no-undo .
     2076       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2077       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2078       define input parameter        p-w-p-code         LIKE ub.wth-parts.w-p-code no-undo .
     2079       define input parameter        p-wth-code         LIKE ub.wth-parts.wth-code no-undo .
     2080       define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2081       define input parameter        p-in-code          LIKE ub.wth-parts.in-code no-undo .
     2082       define input parameter        p-doc-code         LIKE ub.wth-parts.out-code no-undo .
     2083       define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2084       define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2085       define input parameter        p-ext-doc-type     LIKE ub.wth-parts.ext-doc-type no-undo .
     2086       define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2087       define input parameter        p-type             LIKE ub.wth-parts.type no-undo .
     2088       define input-output parameter p-rec        as recid     no-undo .
     2089     define buffer bfrom_wth-parts   for ub.wth-parts.
     2090     define buffer bufr_wth-doc      for ub.wth-doc.
     2091     define variable v-rec    as recid        no-undo.
     2092     define variable v-recDop as recid        no-undo.
     2093     define variable v-zone   as character    no-undo.
     2094     DEFINE variable v-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2095     define VARIABLE v-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2096     define variable v-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2097     define variable v-price-base       LIKE ub.wth-parts.price-base no-undo .
     2098     define variable v-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2099     define variable v-mpl-date         as date      no-undo.
     2100     empty temp-table tt-wthlib-parts.
     2101   main-block:
     2102   do  transaction
     2103   on error  undo main-block, return error return-value + chr(32) + error-status:get-message(1)
     2104   on stop   undo main-block, return error
     2105   on endkey undo main-block, return error
     2106   :
     2107   FIND FIRST bufr_wth-doc WHERE bufr_wth-doc.doc-code = p-doc-code NO-LOCK NO-ERROR.
     2108   IF NOT AVAILABLE bufr_wth-doc THEN RETURN ERROR SUBSTITUTE('Не найден документ МЦ с номером &1',p-doc-code).
     2109     if lookup(p-ext-doc-type,'ie,ip,rp,fj,pj,ff,rf':U) > 0
     2110           then do:
     2111        run str/wthpartp.p  ( INPUT 'ДОБАВЛЕНИЕ':U,
     2112                     INPUT  p-obj-type,
     2113                     INPUT  p-obj-code,
     2114                     INPUT  p-w-p-code,
     2115                     INPUT  p-wth-code,
     2116                     INPUT  p-par-code,
     2117                     INPUT  p-in-code,
     2118                     INPUT  p-doc-code,
     2119                     INPUT  p-ser-code,
     2120                     INPUT  p-db-num  ,
     2121                     INPUT  p-Fact-RangeFrom ,
     2122                     INPUT  p-fact-rangeTo  ,
     2123                     INPUT  p-Fact-RangeFrom ,
     2124                     INPUT  p-fact-rangeTo ,
     2125                     INPUT  p-host-code     ,
     2126                     INPUT  0   ,
     2127                     INPUT  p-price-rubl    ,
     2128                     INPUT  p-price-base    ,
     2129                     INPUT  '':U,
     2130                     INPUT  0,
     2131                     INPUT  p-obj-type      ,
     2132                     INPUT  p-obj-code      ,
     2133                     INPUT  p-ext-doc-type,
     2134                     INPUT  p-gds-code,
     2135                     INPUT  0           ,
     2136                     INPUT  p-beg-dt        ,
     2137                     INPUT  p-end-dt        ,
     2138                     INPUT  p-vat-pc      ,
     2139                     INPUT  0,
     2140                     INPUT  '':U,
     2141                     INPUT  0,
     2142                     INPUT  '':U,
     2143                     INPUT  0,
     2144                     INPUT  '':U,
     2145                     INPUT  p-doc-code,
     2146                     INPUT  yes,
     2147                     INPUT p-type,
     2148                     INPUT-OUTPUT p-rec
     2149                     ) no-error.
     2150                   if error-status:error then undo main-block, return error return-value + error-status:get-message(1) .
     2151     end.
     2152     else do:
     2153       if p-rec <> ? then do:
     2154         find first bfrom_wth-parts exclusive-lock where
     2155                   recid(bfrom_wth-parts) = p-rec no-error.
     2156         if  available bfrom_wth-parts
     2157           and bfrom_wth-parts.wth-code = p-wth-code
     2158           and bfrom_wth-parts.par-code = p-par-code
     2159           and bfrom_wth-parts.ser-code = p-ser-code
     2160           and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0
     2161         then.
     2162         else if  available bfrom_wth-parts and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0
     2163         then return error substitute('Резервирование из партии (Код серии: &1-&2 Диапазон &3-&4) невозможно, т.к. партия уже входит в состав документа'
     2164                                      ,bfrom_wth-parts.ser-code
     2165                                      ,bfrom_wth-parts.db-num
     2166                                      ,bfrom_wth-parts.doc-rangeFrom
     2167                                      ,bfrom_wth-parts.doc-rangeTo).
     2168         else if  available bfrom_wth-parts then undo, return error 'Партия указанная для резервирования не соответсвует указанным параметрам!'.
     2169         if available bfrom_wth-parts
     2170            and bfrom_wth-parts.doc-rangeFrom > p-fact-rangeFrom
     2171            or bfrom_wth-parts.doc-rangeTo   < p-fact-rangeTo
     2172         then undo, return error substitute('Нельзя увеличивать границы диапазона.&1Диапазон партии &2-&3.&1Диапазон резервирования &4-&5'
     2173                                            ,chr(10)
     2174                                            ,bfrom_wth-parts.doc-rangeFrom
     2175                                            ,bfrom_wth-parts.doc-rangeTo
     2176                                            ,p-fact-rangeFrom
     2177                                            ,p-fact-rangeTo).
     2178       end.
     2179       else do:
     2180         if p-ext-doc-type = 'pz':U or (p-ext-doc-type = 'xc':U and p-type = 'при':U )then do:
     2181           for first bfrom_wth-parts no-lock where
     2182                                     bfrom_wth-parts.wth-code = p-wth-code
     2183                                 and bfrom_wth-parts.par-code = p-par-code
     2184                                 and bfrom_wth-parts.ser-code = p-ser-code
     2185                                 and bfrom_wth-parts.db-num = p-db-num
     2186                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2187                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2188                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2189                                 and bfrom_wth-parts.stts = 0
     2190                                 and bfrom_wth-parts.cli-code = p-cli-code
     2191                                 and bfrom_wth-parts.cli-type = p-cli-type
     2192                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2193                                 use-index  wth-idnt:
     2194                                 p-rec = recid(bfrom_wth-parts).
     2195            end.
     2196           If p-rec = ? and p-in-code > '' then do:
     2197              for first bfrom_wth-parts no-lock where
     2198                                     bfrom_wth-parts.wth-code = p-wth-code
     2199                                 and bfrom_wth-parts.par-code = p-par-code
     2200                                 and bfrom_wth-parts.ser-code = p-ser-code
     2201                                 and bfrom_wth-parts.db-num = p-db-num
     2202                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2203                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2204                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2205                                 and bfrom_wth-parts.stts = 0
     2206                                 and bfrom_wth-parts.cli-code = p-cli-code
     2207                                 and bfrom_wth-parts.cli-type = p-cli-type
     2208                                 use-index  wth-idnt:
     2209                                 p-rec = recid(bfrom_wth-parts).
     2210                 end.
     2211           end.
     2212                 if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2213                   recid(bfrom_wth-parts) = p-rec no-error.
     2214         end.
     2215         else if p-ext-doc-type = 'pc':U or p-ext-doc-type = 'ps':U or p-ext-doc-type = 'dc':U then do:
     2216           for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2217                                 and bfrom_wth-parts.par-code = p-par-code
     2218                                 and bfrom_wth-parts.ser-code = p-ser-code
     2219                                 and bfrom_wth-parts.db-num = p-db-num
     2220                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2221                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2222                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2223                                 and bfrom_wth-parts.stts = 0
     2224                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2225                                 use-index wth-idnt:
     2226                                 p-rec = recid(bfrom_wth-parts).
     2227            end.
     2228           If p-rec = ? and p-in-code > '' then do:
     2229            for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2230                                 and bfrom_wth-parts.par-code = p-par-code
     2231                                 and bfrom_wth-parts.ser-code = p-ser-code
     2232                                 and bfrom_wth-parts.db-num = p-db-num
     2233                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2234                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2235                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2236                                 and bfrom_wth-parts.stts = 0
     2237                                 :
     2238                                 p-rec = recid(bfrom_wth-parts).
     2239            end.
     2240           end.
     2241           if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2242                   recid(bfrom_wth-parts) = p-rec no-error.
     2243         end.
     2244         else do:
     2245           CASE p-ext-doc-type:
     2246                   WHEN 'ee':U or when 'xc':U or WHEN 'ef':U
     2247                   or when 'jj':U THEN DO:
     2248                       v-zone = 'free-zone':U.
     2249                   END.
     2250                   WHEN 'ep':U or when 'oj':U THEN DO:
     2251                       v-zone = 'put-zone':U.
     2252                   END.
     2253                   WHEN 'df':U THEN DO:
     2254                       v-zone = 'free-zone':U.
     2255                   END.
     2256                   WHEN 'dp':U  THEN DO:
     2257                       v-zone = 'put-zone':U.
     2258                   END.
     2259                   WHEN 'pc':U OR WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'dc':U THEN DO:
     2260                       v-zone = 'cli-zone':U.
     2261                   END.
     2262                   OTHERWISE DO:
     2263                       RETURN ERROR substitute("Неверный вызов процедуры резервирования: расш. тип = &1"
     2264                                            , p-ext-doc-type
     2265                                               ).
     2266                   END.
     2267           END CASE.
     2268           find first bfrom_wth-parts no-lock where
     2269                                     bfrom_wth-parts.wth-code = p-wth-code
     2270                                 and bfrom_wth-parts.obj-code = p-obj-code
     2271                                 and bfrom_wth-parts.obj-type = p-obj-type
     2272                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2273                                 and bfrom_wth-parts.par-code = p-par-code
     2274                                 and bfrom_wth-parts.ser-code = p-ser-code
     2275                                 and bfrom_wth-parts.db-num = p-db-num
     2276                                 and bfrom_wth-parts.out-code = v-zone
     2277                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2278                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2279                                 and bfrom_wth-parts.stts = 0
     2280                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2281                                 no-error.
     2282          If not available bfrom_wth-parts and p-in-code > '' then do:
     2283                  find first bfrom_wth-parts no-lock where
     2284                                     bfrom_wth-parts.wth-code = p-wth-code
     2285                                 and bfrom_wth-parts.obj-code = p-obj-code
     2286                                 and bfrom_wth-parts.obj-type = p-obj-type
     2287                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2288                                 and bfrom_wth-parts.par-code = p-par-code
     2289                                 and bfrom_wth-parts.ser-code = p-ser-code
     2290                                 and bfrom_wth-parts.db-num = p-db-num
     2291                                 and bfrom_wth-parts.out-code = v-zone
     2292                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2293                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2294                                 and bfrom_wth-parts.stts = 0
     2295                                 no-error.
     2296          end.
     2297         end.
     2298       end.
     2299       if not available bfrom_wth-parts then do:
     2300            if g#news then do:
     2301             return error 'forged':U.
     2302            end.
     2303            else
     2304             undo, return error substitute("Не найдена партия МЦ для резервирования &1Код МЦ &2&1Код номинала &3&1Код серии &4&1Диапазон с &5 по &6&1
     2305                                           ",chr(10),p-wth-code,p-par-code,p-ser-code,p-fact-rangeFrom,
     2306                                           p-fact-rangeTo).
     2307       end.
     2308       p-rec = recid(bfrom_wth-parts).
     2309       find current bfrom_wth-parts exclusive-lock.
     2310       create tt-wthlib-parts.
     2311       buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2312           ASSIGN v-beg-dt = if p-param then p-beg-dt else bfrom_wth-parts.beg-dt
     2313                  v-end-dt = if p-param then p-end-dt else bfrom_wth-parts.end-dt
     2314                  v-vat-pc = if p-param then p-vat-pc else bfrom_wth-parts.vat-pc
     2315                  v-price-rubl = if p-param then p-price-rubl else bfrom_wth-parts.price-rubl
     2316                  v-price-base = if p-param then p-price-base else bfrom_wth-parts.price-base  .
     2317       IF  not g#news and (p-ext-doc-type = 'ee':U or p-ext-doc-type = 'xc':U)  THEN DO:
     2318           IF v-beg-dt = ? AND v-end-dt = ? THEN DO:
     2319               RUN init_prtdate ( INPUT p-obj-type
     2320                                                 ,INPUT p-obj-code
     2321                                                 ,INPUT p-ser-code
     2322                                                 ,INPUT p-db-num
     2323                                                 ,INPUT bufr_wth-doc.doc-date
     2324                                                 ,OUTPUT v-beg-dt
     2325                                                 ,OUTPUT v-end-dt ) NO-ERROR.
     2326               if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2327           END.
     2328           IF v-price-rubl = 0 AND v-price-base = 0 THEN DO:
     2329             run set-wthmpl-date ( bufr_wth-doc.doc-code
     2330                                ,bufr_wth-doc.doc-date
     2331                                , v-beg-dt
     2332                                , output v-mpl-date) no-error.
     2333               RUN INIT_prtprice (
     2334                             p-host-code
     2335                           , p-obj-type
     2336                           , p-obj-code
     2337                           , p-cli-type
     2338                           , p-cli-code
     2339                           , p-wth-code
     2340                           , p-gds-code
     2341                           , p-par-code
     2342                           , v-mpl-date
     2343                           , OUTPUT  v-vat-pc
     2344                           , OUTPUT  v-price-rubl
     2345                           , OUTPUT  v-price-base
     2346                   ) NO-ERROR.
     2347             if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2348           END.
     2349       END.
     2350         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2351                     INPUT     p-obj-type,
     2352                     INPUT     p-obj-code,
     2353                     INPUT     p-w-p-code,
     2354                     INPUT     bfrom_wth-parts.wth-code,
     2355                     INPUT     bfrom_wth-parts.par-code,
     2356                     INPUT     bfrom_wth-parts.in-code ,
     2357                     INPUT     p-doc-code,
     2358                     INPUT     bfrom_wth-parts.ser-code,
     2359                     INPUT     bfrom_wth-parts.db-num  ,
     2360                     INPUT     p-Fact-RangeFrom ,
     2361                     INPUT     p-fact-rangeTo  ,
     2362                     INPUT     p-Fact-RangeFrom ,
     2363                     INPUT     p-fact-rangeTo ,
     2364                     INPUT     bfrom_wth-parts.host-code     ,
     2365                     INPUT     bfrom_wth-parts.contract-code               ,
     2366                     INPUT     v-price-rubl ,
     2367                     INPUT     v-price-base  ,
     2368                     INPUT     bfrom_wth-parts.supp-type,
     2369                     INPUT     bfrom_wth-parts.supp-code,
     2370                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2371                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2372                     INPUT     p-ext-doc-type,
     2373                     INPUT     bfrom_wth-parts.gds-code,
     2374                     INPUT     0              ,
     2375                     INPUT     v-beg-dt    ,
     2376                     INPUT     v-end-dt   ,
     2377                     INPUT     v-vat-pc    ,
     2378                     INPUT     bfrom_wth-parts.cli-code,
     2379                     INPUT     bfrom_wth-parts.cli-type,
     2380                     INPUT     bfrom_wth-parts.out-obj-code,
     2381                     INPUT     bfrom_wth-parts.out-obj-type,
     2382                     INPUT     bfrom_wth-parts.sale-obj-code,
     2383                     INPUT     bfrom_wth-parts.sale-obj-type,
     2384                     INPUT     bfrom_wth-parts.doc-code,
     2385                     INPUT     yes,
     2386                     INPUT     p-type,
     2387                     INPUT-OUTPUT p-rec
     2388                     ) no-error.
     2389       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2390       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2391       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2392                     INPUT     tt-wthlib-parts.obj-type,
     2393                     INPUT     tt-wthlib-parts.obj-code,
     2394                     INPUT     tt-wthlib-parts.w-p-code,
     2395                     INPUT     tt-wthlib-parts.wth-code,
     2396                     INPUT     tt-wthlib-parts.par-code,
     2397                     INPUT     tt-wthlib-parts.in-code ,
     2398                     INPUT     tt-wthlib-parts.out-code,
     2399                     INPUT     tt-wthlib-parts.ser-code,
     2400                     INPUT     tt-wthlib-parts.db-num  ,
     2401                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2402                     INPUT     p-fact-rangeFrom - 1  ,
     2403                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2404                     INPUT     p-fact-rangeFrom - 1,
     2405                     INPUT     tt-wthlib-parts.host-code     ,
     2406                     INPUT     tt-wthlib-parts.contract-code               ,
     2407                     INPUT     tt-wthlib-parts.price-rubl    ,
     2408                     INPUT     tt-wthlib-parts.price-base    ,
     2409                     INPUT     tt-wthlib-parts.supp-type,
     2410                     INPUT     tt-wthlib-parts.supp-code,
     2411                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2412                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2413                     INPUT     tt-wthlib-parts.ext-doc-type,
     2414                     INPUT     tt-wthlib-parts.gds-code,
     2415                     INPUT     tt-wthlib-parts.stts               ,
     2416                     INPUT     tt-wthlib-parts.beg-dt        ,
     2417                     INPUT     tt-wthlib-parts.end-dt        ,
     2418                     INPUT     tt-wthlib-parts.vat-pc        ,
     2419                     INPUT     tt-wthlib-parts.cli-code,
     2420                     INPUT     tt-wthlib-parts.cli-type,
     2421                     INPUT     tt-wthlib-parts.out-obj-code,
     2422                     INPUT     tt-wthlib-parts.out-obj-type,
     2423                     INPUT     tt-wthlib-parts.sale-obj-code,
     2424                     INPUT     tt-wthlib-parts.sale-obj-type,
     2425                     INPUT     tt-wthlib-parts.doc-code,
     2426                     INPUT  yes,
     2427                     INPUT    tt-wthlib-parts.type,
     2428                     INPUT-OUTPUT v-recDop
     2429                     ) no-error.
     2430       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2431       end.
     2432       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2433               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2434                     INPUT     tt-wthlib-parts.obj-type,
     2435                     INPUT     tt-wthlib-parts.obj-code,
     2436                     INPUT     tt-wthlib-parts.w-p-code,
     2437                     INPUT     tt-wthlib-parts.wth-code,
     2438                     INPUT     tt-wthlib-parts.par-code,
     2439                     INPUT     tt-wthlib-parts.in-code ,
     2440                     INPUT     tt-wthlib-parts.out-code,
     2441                     INPUT     tt-wthlib-parts.ser-code,
     2442                     INPUT     tt-wthlib-parts.db-num  ,
     2443                     INPUT     p-fact-rangeTo + 1 ,
     2444                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2445                     INPUT     p-fact-rangeTo + 1 ,
     2446                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2447                     INPUT     tt-wthlib-parts.host-code     ,
     2448                     INPUT     tt-wthlib-parts.contract-code               ,
     2449                     INPUT     tt-wthlib-parts.price-rubl    ,
     2450                     INPUT     tt-wthlib-parts.price-base    ,
     2451                     INPUT     tt-wthlib-parts.supp-type,
     2452                     INPUT     tt-wthlib-parts.supp-code,
     2453                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2454                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2455                     INPUT     tt-wthlib-parts.ext-doc-type,
     2456                     INPUT     tt-wthlib-parts.gds-code,
     2457                     INPUT     tt-wthlib-parts.stts               ,
     2458                     INPUT     tt-wthlib-parts.beg-dt        ,
     2459                     INPUT     tt-wthlib-parts.end-dt        ,
     2460                     INPUT     tt-wthlib-parts.vat-pc        ,
     2461                     INPUT     tt-wthlib-parts.cli-code,
     2462                     INPUT     tt-wthlib-parts.cli-type,
     2463                     INPUT     tt-wthlib-parts.out-obj-code,
     2464                     INPUT     tt-wthlib-parts.out-obj-type,
     2465                     INPUT     tt-wthlib-parts.sale-obj-code,
     2466                     INPUT     tt-wthlib-parts.sale-obj-type,
     2467                     INPUT     tt-wthlib-parts.doc-code,
     2468                     INPUT     yes,
     2469                     INPUT     tt-wthlib-parts.type,
     2470                     INPUT-OUTPUT v-recDop
     2471                     ) no-error.
     2472         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2473       end.
     2474     end.
     2475   end.
     2476   end procedure.
     2477   procedure wth-parts-inter-edit:
     2478     define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2479     define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2480     define input-output parameter p-rec        as recid     no-undo .
     2481     define buffer bfrom_wth-parts   for ub.wth-parts.
     2482     define variable v-recDop as recid        no-undo.
     2483     do on error undo, return error:
     2484         find first bfrom_wth-parts exclusive-lock where
     2485                   recid(bfrom_wth-parts) = p-rec no-error.
     2486         if not available bfrom_wth-parts then return error
     2487           substitute('Не найдена партия (recid &1)', p-rec).
     2488         if p-fact-rangeFrom < bfrom_wth-parts.doc-rangeFrom or
     2489            p-fact-rangeTo > bfrom_wth-parts.doc-rangeTo then do:
     2490            return error 'Нельзя увеличивать границы диапазона.'.
     2491         end.
     2492         empty temp-table tt-wthlib-parts.
     2493         create tt-wthlib-parts.
     2494         buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2495         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2496                     INPUT     bfrom_wth-parts.obj-type,
     2497                     INPUT     bfrom_wth-parts.obj-code,
     2498                     INPUT     bfrom_wth-parts.w-p-code,
     2499                     INPUT     bfrom_wth-parts.wth-code,
     2500                     INPUT     bfrom_wth-parts.par-code,
     2501                     INPUT     bfrom_wth-parts.in-code ,
     2502                     INPUT     bfrom_wth-parts.doc-code,
     2503                     INPUT     bfrom_wth-parts.ser-code,
     2504                     INPUT     bfrom_wth-parts.db-num  ,
     2505                     INPUT     p-Fact-RangeFrom ,
     2506                     INPUT     p-fact-rangeTo  ,
     2507                     INPUT     p-Fact-RangeFrom ,
     2508                     INPUT     p-fact-rangeTo ,
     2509                     INPUT     bfrom_wth-parts.host-code     ,
     2510                     INPUT     bfrom_wth-parts.contract-code               ,
     2511                     INPUT     bfrom_wth-parts.price-rubl  ,
     2512                     INPUT     bfrom_wth-parts.price-base    ,
     2513                     INPUT     bfrom_wth-parts.supp-type,
     2514                     INPUT     bfrom_wth-parts.supp-code,
     2515                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2516                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2517                     INPUT     bfrom_wth-parts.ext-doc-type,
     2518                     INPUT     bfrom_wth-parts.gds-code,
     2519                     INPUT     0              ,
     2520                     INPUT     bfrom_wth-parts.beg-dt      ,
     2521                     INPUT     bfrom_wth-parts.end-dt      ,
     2522                     INPUT     bfrom_wth-parts.vat-pc      ,
     2523                     INPUT     bfrom_wth-parts.cli-code,
     2524                     INPUT     bfrom_wth-parts.cli-type,
     2525                     INPUT     bfrom_wth-parts.out-obj-code,
     2526                     INPUT     bfrom_wth-parts.out-obj-type,
     2527                     INPUT     bfrom_wth-parts.sale-obj-code,
     2528                     INPUT     bfrom_wth-parts.sale-obj-type,
     2529                     INPUT     bfrom_wth-parts.doc-code,
     2530                     INPUT     yes,
     2531                     INPUT     bfrom_wth-parts.type,
     2532                     INPUT-OUTPUT p-rec
     2533                     ) no-error.
     2534       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2535       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2536       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2537                     INPUT     tt-wthlib-parts.obj-type,
     2538                     INPUT     tt-wthlib-parts.obj-code,
     2539                     INPUT     tt-wthlib-parts.w-p-code,
     2540                     INPUT     tt-wthlib-parts.wth-code,
     2541                     INPUT     tt-wthlib-parts.par-code,
     2542                     INPUT     tt-wthlib-parts.in-code ,
     2543                     INPUT     tt-wthlib-parts.out-code,
     2544                     INPUT     tt-wthlib-parts.ser-code,
     2545                     INPUT     tt-wthlib-parts.db-num  ,
     2546                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2547                     INPUT     p-fact-rangeFrom - 1  ,
     2548                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2549                     INPUT     p-fact-rangeFrom - 1,
     2550                     INPUT     tt-wthlib-parts.host-code     ,
     2551                     INPUT     tt-wthlib-parts.contract-code               ,
     2552                     INPUT     tt-wthlib-parts.price-rubl    ,
     2553                     INPUT     tt-wthlib-parts.price-base    ,
     2554                     INPUT     tt-wthlib-parts.supp-type,
     2555                     INPUT     tt-wthlib-parts.supp-code,
     2556                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2557                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2558                     INPUT     tt-wthlib-parts.ext-doc-type,
     2559                     INPUT     tt-wthlib-parts.gds-code,
     2560                     INPUT     1             ,
     2561                     INPUT     tt-wthlib-parts.beg-dt        ,
     2562                     INPUT     tt-wthlib-parts.end-dt        ,
     2563                     INPUT     tt-wthlib-parts.vat-pc        ,
     2564                     INPUT     tt-wthlib-parts.cli-code,
     2565                     INPUT     tt-wthlib-parts.cli-type,
     2566                     INPUT     tt-wthlib-parts.out-obj-code,
     2567                     INPUT     tt-wthlib-parts.out-obj-type,
     2568                     INPUT     tt-wthlib-parts.sale-obj-code,
     2569                     INPUT     tt-wthlib-parts.sale-obj-type,
     2570                     INPUT     tt-wthlib-parts.doc-code,
     2571                     INPUT  yes,
     2572                     INPUT    tt-wthlib-parts.type,
     2573                     INPUT-OUTPUT v-recDop
     2574                     ) no-error.
     2575       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2576       end.
     2577       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2578               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2579                     INPUT     tt-wthlib-parts.obj-type,
     2580                     INPUT     tt-wthlib-parts.obj-code,
     2581                     INPUT     tt-wthlib-parts.w-p-code,
     2582                     INPUT     tt-wthlib-parts.wth-code,
     2583                     INPUT     tt-wthlib-parts.par-code,
     2584                     INPUT     tt-wthlib-parts.in-code ,
     2585                     INPUT     tt-wthlib-parts.out-code,
     2586                     INPUT     tt-wthlib-parts.ser-code,
     2587                     INPUT     tt-wthlib-parts.db-num  ,
     2588                     INPUT     p-fact-rangeTo + 1 ,
     2589                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2590                     INPUT     p-fact-rangeTo + 1 ,
     2591                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2592                     INPUT     tt-wthlib-parts.host-code     ,
     2593                     INPUT     tt-wthlib-parts.contract-code               ,
     2594                     INPUT     tt-wthlib-parts.price-rubl    ,
     2595                     INPUT     tt-wthlib-parts.price-base    ,
     2596                     INPUT     tt-wthlib-parts.supp-type,
     2597                     INPUT     tt-wthlib-parts.supp-code,
     2598                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2599                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2600                     INPUT     tt-wthlib-parts.ext-doc-type,
     2601                     INPUT     tt-wthlib-parts.gds-code,
     2602                     INPUT     1             ,
     2603                     INPUT     tt-wthlib-parts.beg-dt        ,
     2604                     INPUT     tt-wthlib-parts.end-dt        ,
     2605                     INPUT     tt-wthlib-parts.vat-pc        ,
     2606                     INPUT     tt-wthlib-parts.cli-code,
     2607                     INPUT     tt-wthlib-parts.cli-type,
     2608                     INPUT     tt-wthlib-parts.out-obj-code,
     2609                     INPUT     tt-wthlib-parts.out-obj-type,
     2610                     INPUT     tt-wthlib-parts.sale-obj-code,
     2611                     INPUT     tt-wthlib-parts.sale-obj-type,
     2612                     INPUT     tt-wthlib-parts.doc-code,
     2613                     INPUT     yes,
     2614                     INPUT     tt-wthlib-parts.type,
     2615                     INPUT-OUTPUT v-recDop
     2616                     ) no-error.
     2617         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2618         end.
     2619     end.
     2620   end procedure.
     2621   PROCEDURE INIT_prtdate:
     2622       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2623       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2624       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2625       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2626       define input parameter        p-date                AS DATE no-undo .
     2627       DEFINE OUTPUT PARAMETER p-beg-dt AS DATE NO-UNDO.
     2628       DEFINE OUTPUT PARAMETER p-end-dt AS DATE NO-UNDO.
     2629       DEFINE BUFFER buf_wth-ser FOR ub.wth-ser.
     2630       DEFINE VARIABLE v-rangeRule AS INT NO-UNDO.
     2631       define variable v-value-character as character no-undo .
     2632       define variable v-value-date as date no-undo .
     2633       define variable v-value-decimal as decimal no-undo .
     2634       define variable v-value-integer as INTEGER no-undo .
     2635       define variable v-value-logical AS LOGICAL no-undo .
     2636       define variable v-param-type as character no-undo .
     2637       FIND FIRST buf_wth-ser NO-LOCK
     2638           WHERE buf_wth-ser.ser-code = p-ser-code
     2639           AND buf_wth-ser.db-num = p-db-num.
     2640       IF buf_wth-ser.chk-bdt = 2 THEN DO:
     2641           p-beg-dt = buf_wth-ser.beg-dt.
     2642       END.
     2643       IF buf_wth-ser.chk-edt = 2 THEN DO:
     2644           p-end-dt = buf_wth-ser.end-dt.
     2645       END.
     2646       IF buf_wth-ser.chk-bdt = 0 AND buf_wth-ser.chk-edt = 0 THEN DO:
     2647           run adm/shattri.p (
     2648               input "get":U
     2649               ,input  p-obj-type
     2650               ,input  p-obj-code
     2651               ,input  'wthdoc_obj':U
     2652               ,input  'rangerule':U
     2653               ,output v-value-character
     2654               ,output v-value-date
     2655               ,output v-value-decimal
     2656               ,output v-value-integer
     2657               ,output v-value-logical
     2658               ,output v-param-type
     2659               ,INPUT-OUTPUT table-handle v-tth
     2660               ) no-error .
     2661           IF not error-status:error  then do:
     2662               v-rangeRule =  v-value-integer.
     2663           END.
     2664           CASE v-rangeRule:
     2665           WHEN 1 THEN DO:
     2666               IF MONTH(p-date) < 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date)))
     2667                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 2,YEAR(p-date))) - 1.
     2668               ELSE IF MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/12/&1',YEAR(p-date)))
     2669                                                 p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date) + 1)).
     2670               ELSE IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('01/01/&1',YEAR(p-date) + 1))
     2671                                                 p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2672           END.
     2673           when 2 then do:
     2674             IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2675                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2676             else ASSIGN p-beg-dt = DATE(substitute('&3/&1/&2',MONTH(p-date),YEAR(p-date),day(p-date)))
     2677                         p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date))) - 1
     2678                        .
     2679           end.
     2680           WHEN 3 THEN DO:
     2681               IF MONTH(p-date) < 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/&2/&3',day(p-date),MONTH(p-date),YEAR(p-date)))
     2682                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 3,YEAR(p-date))) - 1.
     2683               else if MONTH(p-date) = 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/10/&2',day(p-date),YEAR(p-date)))
     2684                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2685               else if MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('&1/11/&2',day(p-date),YEAR(p-date)))
     2686                                               p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2687               else if MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2688                                               p-end-dt = DATE(substitute('01/03/&1',YEAR(p-date) + 1)) - 1.
     2689           END.
     2690           when 4 then do:
     2691                p-beg-dt = p-date.
     2692                p-end-dt = date(substitute('31/12/&1',YEAR(p-date))).
     2693           end.
     2694           END CASE.
     2695       END.
     2696   END.
     2697   PROCEDURE INIT_prtprice:
     2698   define input parameter        p-host-code        LIKE ub.wth-parts.obj-type no-undo .
     2699   define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2700   define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2701   define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2702   define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2703   define input parameter        p-wth-code         LIKE ub.wth-parts.ser-code no-undo.
     2704   define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2705   define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2706   define input parameter        p-date                AS DATE no-undo .
     2707   DEFINE OUTPUT PARAMETER p-vat-pc LIKE ub.wth-parts.vat-pc NO-UNDO.
     2708   DEFINE OUTPUT PARAMETER p-price-rubl LIKE ub.wth-parts.price-rubl NO-UNDO.
     2709   DEFINE OUTPUT PARAMETER p-price-base LIKE ub.wth-parts.price-base NO-UNDO.
     2710   DEFINE BUFFER b-cash-pay FOR ub.cash-pay.
     2711   DEFINE BUFFER b-wth-par FOR ub.wth-par.
     2712   DEF VAR v-cash-type-pay AS CHAR no-undo.
     2713   define variable p-plt-id AS INT no-undo.
     2714   define variable  p-plt-db-num   AS INT no-undo.
     2715   define variable  p-pdf-id  AS INT no-undo.
     2716   define variable  p-pdf-db-num AS INT no-undo.
     2717   define variable  p-sale-price-base AS DEC no-undo.
     2718   define variable  p-sale-price-rubl AS DEC no-undo.
     2719   define variable  p-road-tax-base AS DEC no-undo.
     2720   define variable  p-road-tax-rubl AS DEC no-undo.
     2721   define variable  p-excise-base AS DEC no-undo.
     2722   define variable  p-excise-rubl AS DEC no-undo.
     2723   define variable  p-fact-order  AS DEC no-undo.
     2724   do on error undo, return error return-value :
     2725     FIND FIRST b-wth-par NO-LOCK WHERE b-wth-par.par-code = p-par-code
     2726                                     AND b-wth-par.wth-code = p-wth-code NO-ERROR.
     2727     IF NOT AVAILABLE b-wth-par THEN RETURN ERROR SUBSTITUTE("Не наден номинал с кодом &1",p-par-code).
     2728     FIND FIRST b-cash-pay WHERE b-cash-pay.wth-code = p-wth-code NO-LOCK NO-ERROR.
     2729     IF AVAILABLE b-cash-pay THEN v-cash-type-pay = STRING(recid(b-cash-pay)).
     2730     ELSE v-cash-type-pay = ?.
     2731     run fact-order-mpl (
     2732         INPUT p-date ,
     2733         INPUT p-obj-type ,
     2734         INPUT p-obj-code ,
     2735         OUTPUT p-fact-order
     2736         ) no-error .
     2737     if error-status:error then do:
     2738       message   return-value skip error-status:get-message(1)
     2739       skip  'Получение цены из множественного прайс-листа отклонено.'
     2740       view-as alert-box.
     2741       return.
     2742     end.
     2743   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2744   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2745     (input  p-gds-code
     2746     ,input  '1':U
     2747     ,input  ?
     2748     ,input  p-host-code
     2749     ,input  p-obj-type
     2750     ,input  p-obj-code
     2751     ,output p-vat-pc
     2752     ) no-error .
     2753     run mpl-autoprice in this-procedure
     2754       ( input    false
     2755         ,input   p-cli-type
     2756         ,input   p-cli-code
     2757         ,input   p-gds-code
     2758         ,input   p-gds-code
     2759         ,input   p-obj-type
     2760         ,input   p-obj-code
     2761         ,input   0
     2762         ,input   0
     2763         ,input   ""
     2764         ,input   v-cash-type-pay
     2765         ,input   p-fact-order
     2766         ,output  p-plt-id
     2767         ,output  p-plt-db-num
     2768         ,output  p-pdf-id
     2769         ,output  p-pdf-db-num
     2770         ,output  p-sale-price-base
     2771         ,output  p-sale-price-rubl
     2772         ,output  p-road-tax-base
     2773         ,output  p-road-tax-rubl
     2774         ,output  p-excise-base
     2775         ,output  p-excise-rubl
     2776         ) no-error .
     2777     if error-status:error then do:
     2778       message   return-value skip error-status:get-message(1) view-as alert-box.
     2779       return.
     2780     end.
     2781     p-price-rubl = p-sale-price-rubl * b-wth-par.par-val.
     2782     p-price-base = p-sale-price-base * b-wth-par.par-val.
     2783   end.
     2784   END.
     2785   procedure  set-wthmpl-date:
     2786   define input parameter p-doc-code like ub.wth-doc.doc-code no-undo.
     2787   define input parameter p-doc-date like ub.wth-doc.doc-date no-undo.
     2788   define input parameter p-beg-dt   like ub.wth-parts.beg-dt no-undo.
     2789   define output parameter p-date    like ub.wth-doc.doc-date no-undo.
     2790   define variable v-atrValue      as character no-undo .
     2791   define variable v-atrDsf      as CHARACTER no-undo .
     2792   define variable v-atrType     as character no-undo .
     2793   do on error undo, return error return-value :
     2794   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     2795                           input 'wthdsf':U ,
     2796                          output v-atrValue ,
     2797                          output v-atrType )  .
     2798     p-date = date(v-atrValue) no-error.
     2799     if p-date = ? then p-date = p-beg-dt no-error.
     2800     if p-date = ? then p-date = p-doc-date.
     2801   end.
     2802   end procedure.
     2803    define buffer buf_wth-doc    for ub.wth-doc.
     2804    define buffer buf_wth-line   for ub.wth-line.
     2805    define buffer buf_wth-dtl    for ub.wth-dtl.
     2806    define buffer buf_wth-par    for ub.wth-par.
     2807    define buffer buf_wth-parts  for ub.wth-parts.
     2808    define temp-table tt-wth-line  no-undo like ub.wth-line .
     2809    DEFINE TEMP-TABLE tt-par-dtl NO-UNDO LIKE ub.wth-par
     2810   FIELD q-ty-doc     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во по!документу"
     2811   FIELD q-ty-fact    AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Количество!факт"
     2812   FIELD doc-sum      like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по!документу"
     2813   FIELD fact-sum     like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма!факт"
     2814   FIELD sum-gds-rubl like ub.wth-line.sum-gds-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (рубл)"
     2815   FIELD sum-gds-base like ub.wth-line.sum-gds-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (баз.вал.)"
     2816   FIELD price-rubl   like ub.wth-line.price-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(рубл)"
     2817   FIELD price-base   like ub.wth-line.price-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(баз.вал.)"
     2818   FIELD w-p-code     like ub.wth-dtl.w-p-code
     2819   FIELD doc-code     like ub.wth-dtl.doc-code
     2820   FIELD gds-code     like ub.wth-gds.gds-code
     2821   INDEX tt-pi    IS   PRIMARY UNIQUE par-code  w-p-code doc-code  wth-code
     2822   INDEX tt-i1                        par-feat par-unit par-val
     2823   INDEX tt-i2                        doc-sum  q-ty-doc
     2824    .
     2825   DEFINE BUTTON B-exit
     2826        LABEL "&Ввод"
     2827        SIZE 9.5 BY 1.13
     2828        BGCOLOR 8 .
     2829   DEFINE BUTTON b-help
     2830        LABEL "&Помощь"
     2831        SIZE 4.5 BY 1.13
     2832        BGCOLOR 8 .
     2833   DEFINE BUTTON B-quit AUTO-END-KEY
     2834        LABEL "&Выход"
     2835        SIZE 9 BY 1.13
     2836        BGCOLOR 8 .
     2837   DEFINE VARIABLE bar-strFrom AS CHARACTER FORMAT "X(256)":U
     2838        LABEL "Первый штрих-код партии"
     2839        VIEW-AS FILL-IN
     2840        SIZE 20 BY 1 NO-UNDO.
     2841   DEFINE VARIABLE bar-strTo AS CHARACTER FORMAT "X(256)":U
     2842        LABEL "Последний штрих-код партии"
     2843        VIEW-AS FILL-IN
     2844        SIZE 20 BY 1 NO-UNDO.
     2845   DEFINE FRAME Dialog-Frame
     2846        bar-strFrom AT ROW 1.5 COL 4.5 WIDGET-ID 2
     2847        bar-strTo AT ROW 2.75 COL 27.5 COLON-ALIGNED WIDGET-ID 4
     2848        B-exit AT ROW 4.5 COL 2
     2849        B-quit AT ROW 4.5 COL 11.5
     2850        b-help AT ROW 4.5 COL 28
     2851        SPACE(20.74) SKIP(0.24)
     2852       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2853            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2854            TITLE "Коды талонов партии"
     2855            CANCEL-BUTTON B-quit WIDGET-ID 100.
     2856   ASSIGN
     2857          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2858          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2859   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2860   DO:
     2861     APPLY "END-ERROR":U TO SELF.
     2862   END.
     2863   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     2864   DO:
     2865     assign frame  Dialog-Frame bar-strFrom bar-strTo.
     2866     output to "wthscan.txt" append.
     2867     put unformatted substitute("&1 &2 &3-&4 Документ:&5",string(today,"99/99/9999"),string(time,"HH:MM:SS"), bar-strFrom, bar-strTo , p-doc-code)  skip.
     2868     OUTPUT CLOSE.
     2869     run proc-save (input bar-strFrom
     2870                   ,INPUT bar-strTo) no-error.
     2871     if error-status:error then do:
     2872       message return-value error-status:get-message(1) view-as alert-box.
     2873     end.
     2874     else do:
     2875       bar-strFrom:screen-value = '':U.
     2876       bar-strTo:screen-value = '':U.
     2877     end.
     2878     apply 'entry':U to bar-strFrom.
     2879   END.
     2880   ON CHOOSE OF b-help IN FRAME Dialog-Frame
     2881   OR HELP OF FRAME Dialog-Frame
     2882   DO:
     2883     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\str\barwthrg.w" VIEW-AS ALERT-BOX INFORMATION.
     2884   END.
     2885   ON LEAVE OF bar-strFrom IN FRAME Dialog-Frame
     2886   DO:
     2887     bar-strFrom = SELF:SCREEN-VALUE.
     2888   END.
     2889   ON RETURN OF bar-strFrom IN FRAME Dialog-Frame
     2890   DO:
     2891     APPLY 'tab' TO SELF.
     2892     RETURN NO-APPLY.
     2893   END.
     2894   ON RETURN OF bar-strTo IN FRAME Dialog-Frame
     2895   DO:
     2896     APPLY 'choose':U TO b-exit.
     2897     RETURN NO-APPLY.
     2898   END.
     2899   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2900   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2901   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2902   on help of frame Dialog-Frame
     2903   do:
     2904     run gbl/app_help.p
     2905       (input this-procedure :file-name
     2906       ,input ''
     2907       ,input ?
     2908       ) no-error.
     2909     if error-status :error then do:
     2910       message
     2911         "Ошибка при вызове помощи"
     2912         error-status :get-message(1)
     2913         view-as alert-box .
     2914     end.
     2915   end.
     2916   run minbtn-set in this-procedure .
     2917   on choose of b-help in frame Dialog-Frame
     2918   do:
     2919     apply "help":u to frame Dialog-Frame .
     2920   end.
     2921   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2922   procedure minbtn-set :
     2923       do
     2924           on error undo, return error return-value
     2925           :
     2926           define variable ii              as integer       no-undo .
     2927           define variable fh              as widget-handle no-undo .
     2928           define variable hh              as widget-handle no-undo .
     2929           define variable v-h             as handle        extent 4 no-undo .
     2930           define variable v-name-button   as character     no-undo .
     2931           define variable v-help-old-x    as decimal       no-undo .
     2932           define variable v-help-old-y    as decimal       no-undo .
     2933           define variable v-help-old-size as decimal       no-undo .
     2934           define variable v-frame-width   as decimal       no-undo .
     2935           define variable jj              as integer       no-undo .
     2936           do
     2937               on error undo, return error
     2938               :
     2939               assign
     2940                   v-frame-width = frame Dialog-Frame:width - 0.3
     2941                   fh            = frame Dialog-Frame:first-child
     2942                   hh            = fh:first-child
     2943                   ii            = 1
     2944                   .
     2945               do while valid-handle(hh):
     2946                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2947                   do:
     2948                       case lc(hh:name) :
     2949                           when "b-help" then
     2950                               do:
     2951                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2952                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2953                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2954                                   hh:TOOLTIP = "Помощь" .
     2955                                   v-help-old-x = hh:column .
     2956                                   v-help-old-y = hh:row    .
     2957                                   v-help-old-size = hh:width .
     2958                                   hh:width-chars = 2.5 .
     2959                               end.
     2960                           when "b-print" then
     2961                               do:
     2962                                   hh:load-image("cmp/b-print.bmp":u) .
     2963                                   hh:TOOLTIP = "Печать" .
     2964                                   v-h[ii] = hh:handle .
     2965                                   ii = ii + 1 .
     2966                                   hh:width-chars = 3 .
     2967                               end.
     2968                           when "b-history" or
     2969                           when "b-hist" then
     2970                               do:
     2971                                   hh:load-image("cmp/b-hist.bmp":u) .
     2972                                   hh:TOOLTIP = "История" .
     2973                                   v-h[ii] = hh:handle .
     2974                                   ii = ii + 1 .
     2975                                   hh:width-chars = 3 .
     2976                               end.
     2977                           when "b-sch" then
     2978                               do:
     2979                                   hh:load-image("cmp/b-sch.bmp":u) .
     2980                                   hh:TOOLTIP = "Установка Фильтра" .
     2981                                   v-h[ii] = hh:handle .
     2982                                   ii = ii + 1 .
     2983                                   hh:width-chars = 3 .
     2984                               end.
     2985                           when "b-hist-user" then
     2986                               do:
     2987                                   hh:load-image("cmp/b-hist.bmp":u) .
     2988                                   hh:TOOLTIP = "История пользователя" .
     2989                                   ii = ii + 1 .
     2990                               end.
     2991                       end case.
     2992                   end.
     2993                   hh = hh:next-sibling.
     2994               end.
     2995               b-help:column = v-frame-width - b-help:width-chars.
     2996               jj = 0.
     2997               repeat ii = 4 to 1 by -1 :
     2998                   if valid-handle (v-h[ii] ) then
     2999                   do:
     3000                       jj  = jj + 1 .
     3001                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3002                       v-h[ii]:row    = v-help-old-y .
     3003                   end.
     3004               end.
     3005           end.
     3006       end.
     3007   end procedure.
     3008   MAIN-BLOCK:
     3009   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3010      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3011     RUN enable_UI.
     3012     find first buf_wth-doc no-lock where
     3013               buf_wth-doc.doc-code = p-doc-code no-error.
     3014     if not available buf_wth-doc then do:
     3015       message substitute('Не найден документ с номерм &1',p-doc-code) view-as alert-box error.
     3016       return.
     3017     end.
     3018     WAIT-FOR GO OF FRAME Dialog-Frame.
     3019   END.
     3020   RUN disable_UI.
     3021   PROCEDURE disable_UI :
     3022     HIDE FRAME Dialog-Frame.
     3023   END PROCEDURE.
     3024   PROCEDURE enable_UI :
     3025     DISPLAY bar-strFrom bar-strTo
     3026         WITH FRAME Dialog-Frame.
     3027     ENABLE bar-strFrom bar-strTo B-exit B-quit b-help
     3028         WITH FRAME Dialog-Frame.
     3029     VIEW FRAME Dialog-Frame.
     3030   END PROCEDURE.
     3031   PROCEDURE proc-save :
     3032   DEFINE INPUT PARAMETER p-barFrom AS CHAR NO-UNDO.
     3033   DEFINE INPUT PARAMETER p-barTo AS CHAR NO-UNDO.
     3034   define variable v-ser-code-from  as integer      no-undo.
     3035   define variable v-db-num-from    as integer      no-undo.
     3036   define variable v-stts-from      as integer      no-undo.
     3037   define variable v-wth-code-from  as integer      no-undo.
     3038   define variable v-gds-code-from  as integer      no-undo.
     3039   define variable v-par-code-from  as integer      no-undo.
     3040   define variable v-zone-from      as character    no-undo.
     3041   define variable v-fromDate-from  as date         no-undo.
     3042   define variable v-ToDate-from    as date         no-undo.
     3043   define variable v-rangeNum-from  as integer      no-undo.
     3044   define variable v-ser-code-to  as integer      no-undo.
     3045   define variable v-db-num-to    as integer      no-undo.
     3046   define variable v-stts-to      as integer      no-undo.
     3047   define variable v-wth-code-to  as integer      no-undo.
     3048   define variable v-gds-code-to  as integer      no-undo.
     3049   define variable v-par-code-to  as integer      no-undo.
     3050   define variable v-zone-to      as character    no-undo.
     3051   define variable v-fromDate-to  as date         no-undo.
     3052   define variable v-ToDate-to    as date         no-undo.
     3053   define variable v-rangeNum-to  as integer      no-undo.
     3054   define variable parline-rec      as recid        no-undo.
     3055   define variable parparts-rec    as recid        no-undo.
     3056   empty temp-table tt-par-dtl.
     3057   empty temp-table tt-wth-line.
     3058   parline-rec = ?.
     3059   parparts-rec = ?.
     3060   do transaction on error undo, return error return-value
     3061                  on stop  undo, return
     3062                  on quit  undo, return:
     3063   run str/wthidnt.p ( input bar-strFrom
     3064             ,output v-ser-code-from
     3065             ,output v-db-num-from
     3066             ,output v-stts-from
     3067             ,output v-wth-code-from
     3068             ,output v-gds-code-from
     3069             ,output v-par-code-from
     3070             ,output v-zone-from
     3071             ,output v-FromDate-from
     3072             ,output v-ToDate-from
     3073             ,output v-rangeNum-from
     3074             ) no-error.
     3075   if error-status:error then do:
     3076     output to "wthscan.txt" append.
     3077     put unformatted  string(today,"99/99/9999") ' ' string(time,"HH:MM:SS") error-status:get-message(1) + chr(32) + return-value skip.
     3078     OUTPUT CLOSE.
     3079      message error-status:get-message(1) + chr(32) + return-value.
     3080      undo, return .
     3081   end.
     3082   output to "wthscan.txt" append.
     3083   put unformatted substitute("&5 &6 Идентифицирован талон МЦ &1 код номинала &2 НОМЕР &3 Зона &4. Документ &7 ",v-wth-code-from,v-par-code-from,v-rangeNum-from, v-zone-from, string(today,"99/99/9999"), string(time,"HH:MM:SS"),buf_wth-doc.doc-code ) skip.
     3084   OUTPUT CLOSE.
     3085   run str/wthidnt.p ( input bar-strTo
     3086             ,output v-ser-code-To
     3087             ,output v-db-num-To
     3088             ,output v-stts-To
     3089             ,output v-wth-code-To
     3090             ,output v-gds-code-To
     3091             ,output v-par-code-To
     3092             ,output v-zone-To
     3093             ,output v-FromDate-To
     3094             ,output v-ToDate-To
     3095             ,output v-rangeNum-To
     3096             ) no-error.
     3097   if error-status:error then do:
     3098     output to "wthscan.txt" append.
     3099     put unformatted  string(today,"99/99/9999") ' ' string(time,"HH:MM:SS") error-status:get-message(1) + chr(32) + return-value skip.
     3100     OUTPUT CLOSE.
     3101      message error-status:get-message(1) + chr(32) + return-value.
     3102      undo, return .
     3103   end.
     3104   output to "wthscan.txt" append.
     3105   put unformatted substitute("&5 &6 Идентифицирован талон МЦ &1 код номинала &2 НОМЕР &3 Зона &4.  Документ &7 ",v-wth-code-to,v-par-code-to,v-rangeNum-to, v-zone-to, string(today,"99/99/9999"), string(time,"HH:MM:SS"),buf_wth-doc.doc-code) skip.
     3106   OUTPUT CLOSE.
     3107   run wth-parts-rezerv( no
     3108                       ,v-rangeNum-From
     3109                       ,v-rangeNum-To
     3110                       ,?
     3111                       ,?
     3112                       ,v-ser-code-to
     3113                       ,v-db-num-to
     3114                       ,0
     3115                       ,0
     3116                       ,0
     3117                       ,buf_wth-doc.host-code
     3118                       ,buf_wth-doc.obj-type
     3119                       ,buf_wth-doc.obj-code
     3120                       ,p-w-p-code
     3121                       ,v-wth-code-to
     3122                       ,v-par-code-to
     3123                       ,'':U
     3124                       ,buf_wth-doc.doc-code
     3125                       ,buf_wth-doc.cli-type
     3126                       ,buf_wth-doc.cli-code
     3127                       ,buf_wth-doc.ext-doc-type
     3128                       ,v-gds-code-to
     3129                       ,(if buf_wth-doc.ext-doc-type = 'xc':U then 'при':U else buf_wth-doc.doc-type)
     3130                       ,input-output parparts-rec
     3131                      ) no-error.
     3132     if error-status:error then do:
     3133      message 'Ошибка резервирования партии' + error-status:get-message(1) + chr(32) + return-value.
     3134      undo, return .
     3135     end.
     3136   create tt-wth-line.
     3137   assign tt-wth-line.wth-code = v-wth-code-To
     3138           tt-wth-line.doc-code = buf_wth-doc.doc-code
     3139           tt-wth-line.w-p-code = p-w-p-code
     3140       .
     3141   find first buf_wth-line no-lock where
     3142              buf_wth-line.doc-code = buf_wth-doc.doc-code
     3143          and buf_wth-line.wth-code = v-wth-code-To no-error.
     3144   if  available buf_wth-line then do:
     3145     buffer-copy buf_wth-line to tt-wth-line.
     3146     parline-rec = recid(buf_wth-line).
     3147   end.
     3148   for each buf_wth-dtl no-lock where
     3149            buf_wth-dtl.wth-code = v-wth-code-To
     3150        and buf_wth-dtl.doc-code = buf_wth-doc.doc-code
     3151        :
     3152        create tt-par-dtl.
     3153        buffer-copy buf_wth-dtl to tt-par-dtl.
     3154   end.
     3155       find first tt-par-dtl where tt-par-dtl.par-code = v-par-code-To no-error.
     3156       if not available tt-par-dtl
     3157       then do:
     3158         create tt-par-dtl.
     3159         assign
     3160         tt-par-dtl.par-code = v-par-code-to
     3161         tt-par-dtl.wth-code = v-wth-code-to
     3162         tt-par-dtl.w-p-code =  p-w-p-code
     3163         tt-par-dtl.doc-code = buf_wth-doc.doc-code
     3164         .
     3165       end.
     3166       find first buf_wth-par no-lock where
     3167                   buf_wth-par.par-code = tt-par-dtl.par-code
     3168               and buf_wth-par.wth-code = tt-par-dtl.wth-code.
     3169       assign
     3170         tt-par-dtl.par-val  = buf_wth-par.par-val
     3171         tt-par-dtl.par-unit = buf_wth-par.par-unit
     3172         tt-par-dtl.par-feat = buf_wth-par.par-feat
     3173         tt-par-dtl.par-rate = buf_wth-par.par-rate
     3174         .
     3175   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3176   assign
     3177   tt-par-dtl.q-ty-doc  = 0
     3178   tt-par-dtl.q-ty-fact = 0
     3179   tt-par-dtl.doc-sum   = 0
     3180   tt-par-dtl.fact-sum  = 0
     3181   tt-par-dtl.sum-gds-rubl = 0
     3182   tt-par-dtl.sum-gds-base = 0
     3183   .
     3184   for each buf_wth-parts no-lock where buf_wth-parts.w-p-code = tt-par-dtl.w-p-code
     3185                          and buf_wth-parts.wth-code = tt-par-dtl.wth-code
     3186                          and buf_wth-parts.par-code = tt-par-dtl.par-code
     3187                          and buf_wth-parts.out-code = tt-par-dtl.doc-code
     3188                          and buf_wth-parts.stts = 0 :
     3189      assign
     3190     tt-par-dtl.q-ty-doc     =  tt-par-dtl.q-ty-doc  + buf_wth-parts.qnty-doc
     3191     tt-par-dtl.q-ty-fact    =  tt-par-dtl.q-ty-fact + buf_wth-parts.fact-qnty
     3192     tt-par-dtl.sum-gds-rubl =  tt-par-dtl.sum-gds-rubl + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
     3193     tt-par-dtl.sum-gds-base =  tt-par-dtl.sum-gds-base + buf_wth-parts.price-base * buf_wth-parts.fact-qnty
     3194     no-error
     3195     .
     3196   end.
     3197   assign
     3198     tt-par-dtl.doc-sum     =  tt-par-dtl.q-ty-doc  * tt-par-dtl.par-rate
     3199     tt-par-dtl.fact-sum    =  tt-par-dtl.q-ty-fact * tt-par-dtl.par-rate
     3200     no-error
     3201     .
     3202   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3203   assign
     3204   tt-wth-line.doc-sum   = 0
     3205   tt-wth-line.fact-sum  = 0
     3206   tt-wth-line.sum-gds-rubl = 0
     3207   tt-wth-line.sum-gds-base = 0
     3208   tt-wth-line.price-rubl   = 0
     3209   tt-wth-line.price-base   = 0.
     3210   for each tt-par-dtl no-lock where tt-par-dtl.w-p-code = tt-wth-line.w-p-code
     3211                          and tt-par-dtl.wth-code = tt-wth-line.wth-code
     3212                          and tt-par-dtl.doc-code = tt-wth-line.doc-code
     3213                          :
     3214     assign
     3215     tt-wth-line.doc-sum      =  tt-wth-line.doc-sum  + tt-par-dtl.doc-sum
     3216     tt-wth-line.fact-sum     =  tt-wth-line.fact-sum + tt-par-dtl.fact-sum
     3217     tt-wth-line.sum-gds-rubl =  tt-wth-line.sum-gds-rubl + tt-par-dtl.sum-gds-rubl
     3218     tt-wth-line.sum-gds-base =  tt-wth-line.sum-gds-base + tt-par-dtl.sum-gds-base
     3219     .
     3220   end.
     3221   assign
     3222     tt-wth-line.price-rubl  =  tt-wth-line.sum-gds-rubl / tt-wth-line.fact-sum
     3223     tt-wth-line.price-base  =  tt-wth-line.sum-gds-base / tt-wth-line.fact-sum
     3224     .
     3225    run str/wth-lnc1.p (
     3226                         input-output parline-rec
     3227                         , (if parline-rec = ? then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     3228                         ,input no
     3229                         ,input buf_wth-doc.doc-code
     3230                         ,input tt-wth-line.wth-code
     3231                         ,input p-W-P-CODE
     3232                         ,input p-OUT-W-P-CODE
     3233                         ,input tt-wth-line.doc-sum
     3234                         ,input tt-wth-line.fact-sum
     3235                         ,input table tt-par-dtl
     3236                         ,input no
     3237                         ,input buf_wth-doc.ext-doc-type
     3238                         ,input tt-wth-line.sum-gds-rubl
     3239                         ,input tt-wth-line.sum-gds-base
     3240                         ) no-error.
     3241       IF ERROR-STATUS:ERROR THEN DO:
     3242         message return-value + error-status:get-message(1) view-as alert-box.
     3243         undo, return.
     3244       end.
     3245   end.
     3246   return no-apply.
     3247   END PROCEDURE.
