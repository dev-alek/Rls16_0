     4170         find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = p-host-code no-error .
     4171         assign
     4172           own-name = buf_clients.obj-name
     4173           own-code = p-host-code
     4174         .
     4175         find first buf_firm no-lock where buf_firm.firm-code = p-host-code no-error .
