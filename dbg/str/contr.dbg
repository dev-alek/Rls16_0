     3561   next-prev = yes.
     3562   n-p: do while next-prev :
     3563   RUN adm/shattri.p (
     3564         INPUT  "get":U,
     3565         INPUT  "",
     3566         INPUT  0,
     3567         INPUT  "fin-global",
     3568         INPUT  "fo-mc-mode",
     3569         OUTPUT v-Character,
     3570         OUTPUT v-Date,
     3571         OUTPUT v-Decimal,
     3572         OUTPUT v-iMcMode,
     3573         OUTPUT v-Logical,
     3574         OUTPUT v-Param-Type,
     3575         INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3576       ) NO-ERROR.
     3577   IF ERROR-STATUS:ERROR THEN DO:
     3578      MESSAGE
     3579         "Ошибка определения глобалоного параметра fin-global/fo-mc-mode" SKIP
     3580         PROGRAM-NAME(1) ERROR-STATUS:GET-MESSAGE(1) RETURN-VALUE
     3581         VIEW-AS ALERT-BOX.
     3582   END.
     3583   MAIN-BLOCK:
     3584   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3585      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3586     if p-doc-type begins "contract-type" then
     3587         assign
     3588           p-contr-type = entry(2,p-doc-type,"=")
     3589           p-doc-type   = 'при':U
     3590         .
     3591     run enable_ui in this-procedure .
     3592     run go-proc in this-procedure no-error.
     3593     if error-status:error then return no-apply.
     3594     WAIT-FOR GO OF FRAME Dialog-Frame.
     3595   END.
     3596   end.
     3597   RUN disable_UI.
     3598   PROCEDURE create-proc :
     3599     define variable  p-sys-date     as date      no-undo .
     3600     define variable  p-sys-time     as character no-undo .
     3601     define variable  p-sys-time-int as integer   no-undo .
     3602     define variable  f-code         as integer   no-undo .
     3603     define variable is-dup as logical no-undo .
     3604     DEFINE VARIABLE v-cError AS CHARACTER NO-UNDO INITIAL "".
     3605     DEFINE VARIABLE lChoice AS LOGICAL NO-UNDO INITIAL FALSE.
     3606     if contract-date-beg <> ? and contract-date-end <> ? then do:
     3607       if contract-date-beg > contract-date-end then do:
     3608         message "Дата начала действия позже даты окончания действия!" view-as alert-box ERROR.
     3609         return error.
     3610       end.
     3611     end.
     3612     if (COMBO-usl-opl = 'По реализации части приход. накладной':U or COMBO-usl-opl = 'Предоплата(%)':U ) and srok-opl = 0 then do:
     3613       message "Процент реализации не может быть 0 !" view-as alert-box ERROR.
     3614       return error.
     3615     end.
     3616     if (COMBO-usl-opl = 'По реализации части приход. накладной':U or COMBO-usl-opl = 'Предоплата(%)':U ) and srok-opl > 100 then do:
     3617       message "Процент реализации не может быть > 100 !" view-as alert-box ERROR.
     3618       return error.
     3619     end.
     3620     if ( COMBO-usl-opl = 'Отсрочка платежа (по реализации)':U
     3621       or COMBO-usl-opl = 'Отсрочка платежа (по поставке)':U
     3622       or COMBO-usl-opl = 'Отсрочка платежа по поставке заказа':U
     3623       or COMBO-usl-opl = 'Отсрочка платежа по поставке':U
     3624       or COMBO-usl-opl = 'Отсрочка платежа по заказу':U
     3625       or COMBO-usl-opl = 'Отсрочка платежа по спецификации':U )
     3626       and srok-opl = 0 then do:
     3627         message "Срок отсрочки не может быть 0 !" view-as alert-box ERROR.
     3628         return error.
     3629     end.
     3630     if COMBO-return-type > 0
     3631     then do :
     3632       find first trn-reason no-lock where trn-reason.reason-code = COMBO-return-type no-error .
     3633       if not available trn-reason
     3634       then do :
     3635         message "Указанная схема возврата в системе отсутствует. Для выбора данной схемы в договоре необходимо в справочник оснований добавить основание с кодом " string(COMBO-return-type) view-as alert-box ERROR.
     3636         return error .
     3637       end .
     3638     end .
     3639     if ref-mode = 'ДОБАВЛЕНИЕ':U then do:
     3640       if p-doc-type <>  'при':U and  p-doc-type <> 'рас':U then do:
     3641         message "Невозможно добавить договор неизвестного вида" view-as alert-box ERROR.
     3642         return error.
     3643       end.
     3644       if cli-code = 0 or cli-code = ? then do:
     3645         message "Не задан контрагент" view-as alert-box ERROR.
     3646         apply "CHOOSE" to cli-code in frame Dialog-Frame .
     3647         return error.
     3648       end.
     3649       if COMBO-type-contr = 'Ответственного хранения':U then do:
     3650         if    COMBO-usl-opl <> 'Не определено':U
     3651           and COMBO-usl-opl <> 'По факту реализации':U
     3652           and COMBO-usl-opl <> 'Отсрочка платежа (по реализации)':U then do:
     3653           message
     3654           "Условия генерации для договора ответственного хранения " skip
     3655           "допустимы только <По факту реализации>," skip
     3656           "<Отсрочка платежа (по реализации)> и <Не определено>"
     3657           view-as alert-box error .
     3658           apply "CHOOSE" to COMBO-usl-opl in frame Dialog-Frame .
     3659           return error .
     3660         end.
     3661       end.
     3662       if COMBO-type-contr = 'Продажи через ТПСИ':U then do:
     3663         if cli-type <> 'орг':U or not can-find(first ub.sysconf no-lock where ub.sysconf.host-code = cli-code) then do:
     3664           message
     3665           "Нельзя оформить договор типа <Продажа через ТПСИ>" skip
     3666           "на контрагента, не являющегося СВОЕЙ ФИРМОЙ"
     3667           view-as alert-box error .
     3668           apply "CHOOSE" to cli-code in frame Dialog-Frame .
     3669           return error .
     3670         end.
     3671         if can-find(first ub.contract no-lock where
     3672                          ub.contract.host-code = p-host-code
     3673                      AND ub.contract.cli-type = cli-type
     3674                      AND ub.contract.cli-code = cli-code
     3675                      and ub.contract.contract-type = 'Продажи через ТПСИ':U
     3676                      and ub.contract.status_       = 'тек':U
     3677                      ) then do:
     3678           message
     3679           "Нельзя оформить договор типа <Продажа через ТПСИ>," skip
     3680           "уже есть действующий договор этого типа с фирмой" cli-code
     3681           view-as alert-box error .
     3682           apply "CHOOSE" to cli-code in frame Dialog-Frame .
     3683           return error .
     3684         end.
     3685       end.
     3686       find first ub.contract no-lock
     3687         where ub.contract.contract-date     = contract-date
     3688           and ub.contract.contract-prn-code = contract-prn-code
     3689           and ub.contract.cli-type          = cli-type
     3690           and ub.contract.cli-code          = cli-code
     3691           and ub.contract.host-code         = p-host-code
     3692       no-error .
     3693       if available ub.contract then do:
     3694         message substitute ("Уже есть договор № &1 от &2 с контрагентом &3 ! Продолжать &4 договора?" ,
     3695                contract-prn-code ,
     3696                string(contract-date,"99/99/9999"),
     3697                cli-name ,
     3698                ref-mode )
     3699                view-as alert-box QUESTION BUTTONS YES-NO UPDATE is-dup .
     3700         if is-dup = no then return error.
     3701       end.
     3702       run gen-b-code in this-procedure ( input 'ctgb':U, output f-code) no-error .
     3703       if error-status:error then do:
     3704         message "Ошибка при генерации внутреннего № договора" view-as alert-box ERROR.
     3705         return error.
     3706       end.
     3707       create b_contract .
     3708       ri = recid(b_contract).
     3709   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3710   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     3711     (output b_contract.user-db-num
     3712     ,output b_contract.user-name
     3713     ,output p-sys-date
     3714     ,output p-sys-time
     3715     ,output p-sys-time-int
     3716     )  .
     3717       assign
     3718         b_contract.doc-type      = p-doc-type
     3719         b_contract.contract-code = f-code
     3720         b_contract.host-code     = p-host-code
     3721         b_contract.contract-type = COMBO-type-contr
     3722         b_contract.status_       = 'тек':U
     3723         b_contract.curr-code     = curr-code
     3724         b_contract.own-name      = own-name
     3725         b_contract.cli-type      = cli-type
     3726         b_contract.cli-code      = cli-code
     3727         b_contract.cli-name      = cli-name
     3728         b_contract.db-num        = b_contract.user-db-num
     3729       .
     3730     end.
     3731     else do:
     3732       find first b_contract exclusive-lock where recid(b_contract) = ri no-error .
     3733       if ref-mode = 'ИЗМЕНЕНИЕ':U then do:
     3734         find first ub.contract no-lock
     3735           where ub.contract.contract-date     = contract-date
     3736             and ub.contract.contract-prn-code = contract-prn-code
     3737             and ub.contract.cli-type          = cli-type
     3738             and ub.contract.cli-code          = cli-code
     3739             and ub.contract.host-code         = p-host-code
     3740             and ub.contract.contract-code     <> b_contract.contract-code
     3741         no-error .
     3742         if available ub.contract then do:
     3743            message substitute ("Уже есть договор № &1 от &2 с контрагентом &3 ! Продолжать &4 договора ?" ,
     3744                     contract-prn-code ,
     3745                     string(contract-date,"99/99/9999"),
     3746                     cli-name ,
     3747                     ref-mode )
     3748                   view-as alert-box QUESTION BUTTONS YES-NO UPDATE is-dup .
     3749           if is-dup = no then return error.
     3750         end.
     3751       end.
     3752     end.
     3753   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3754   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     3755     (output b_contract.user-db-num
     3756     ,output b_contract.user-name
     3757     ,output p-sys-date
     3758     ,output p-sys-time
     3759     ,output p-sys-time-int
     3760     )  .
     3761     if v-own-code-schet-2  = ? or v-own-code-schet-2  = 0 then assign v-own-code-schet-2  = v-own-code-schet  .
     3762     if v-cli-code-schet-2  = ? or v-cli-code-schet-2  = 0 then assign v-cli-code-schet-2  = v-cli-code-schet  .
     3763     if v-posr-code-schet-2 = ? or v-posr-code-schet-2 = 0 then assign v-posr-code-schet-2 = v-posr-code-schet .
     3764     if v-agnt-code-schet-2 = ? or v-agnt-code-schet-2 = 0 then assign v-agnt-code-schet-2 = v-agnt-code-schet .
     3765     assign fin-VAT-pc mngr-code .
     3766     define variable ii as integer   no-undo .
     3767     do ii = 1 to 6 :
     3768       if a-code-an-uchet  [ii] = ? then  a-code-an-uchet  [ii] = 0 .
     3769       if a-code-cel-nazn  [ii] = ? then  a-code-cel-nazn  [ii] = 0 .
     3770       if a-code-cor-acc   [ii] = ? then  a-code-cor-acc   [ii] = 0 .
     3771       if a-code-cor-acc-2 [ii] = ? then  a-code-cor-acc-2 [ii] = 0 .
     3772     end.
     3773     case b-nal :
     3774       when 1 then assign b_contract.pay-nal = no .
     3775       when 2 then assign b_contract.pay-nal = yes .
     3776       when 3 then assign b_contract.pay-nal = ? .
     3777     end.
     3778     case COMBO-usl-opl-2 :
     3779       when 'Не определено':U     then assign  b_contract.gen-factur = 0 .
     3780       when 'По приходной накладной':U        then assign  b_contract.gen-factur = 1 .
     3781       when 'По фин. обязательству':U        then assign  b_contract.gen-factur = 2 .
     3782       when 'По платежу':U       then assign  b_contract.gen-factur = 3 .
     3783       when 'По накл. смены типа преобр.':U       then assign  b_contract.gen-factur = 4 .
     3784       when 'По расходной накладной':U        then assign  b_contract.gen-factur = 5 .
     3785     end.
     3786     assign b_contract.gen-factur-srok = srok-opl-2 .
     3787     if COMBO-auto-pay-2:screen-value = "факт" and b_contract.gen-factur <> 0 then assign b_contract.gen-factur = b_contract.gen-factur + 100 .
     3788     assign kredit-sum .
     3789     assign
     3790       b_contract.cli-name          = cli-name
     3791       b_contract.str-uslov-oplat   = str-uslov-oplat
     3792       b_contract.usl-opl           = COMBO-usl-opl
     3793       b_contract.srok-opl          = srok-opl
     3794       b_contract.contract-date     = contract-date
     3795       b_contract.contract-name     = contract-name
     3796       b_contract.contract-prn-code = contract-prn-code
     3797       b_contract.contract-city     = contract-city
     3798       b_contract.contract-date-beg = contract-date-beg
     3799       b_contract.contract-date-end = contract-date-end
     3800       b_contract.transport-cli-type  = v-transport-cli-type
     3801       b_contract.transport-cli-code  = v-transport-cli-code
     3802       b_contract.transport-host      = v-transport-host
     3803       b_contract.transport-contract  = v-transport-contract
     3804       b_contract.transport-uslov     = v-transport-uslov
     3805       b_contract.transport-value     = v-transport-value
     3806       b_contract.transport-type      = v-transport-type
     3807       b_contract.kredit-sum        = kredit-sum
     3808       b_contract.kredit-limit      = kredit-limit
     3809       b_contract.posr-type         = posr-type
     3810       b_contract.posr-code         = posr-code
     3811       b_contract.posr-name         = posr-name
     3812       b_contract.agnt-type         = agnt-type
     3813       b_contract.agnt-code         = agnt-code
     3814       b_contract.agnt-name         = agnt-name
     3815       b_contract.mngr-code         = mngr-code
     3816       b_contract.own-name          = own-name
     3817       b_contract.own-sign-post     = sign-post-own
     3818       b_contract.own-sign          = sign-own
     3819       b_contract.own-addres        = addres-own
     3820       b_contract.own-inn           = inn-own
     3821       b_contract.own-kpp           = kpp-own
     3822       b_contract.cli-sign-post     = sign-post-cli
     3823       b_contract.cli-sign          = sign-cli
     3824       b_contract.cli-addres        = addres-cli
     3825       b_contract.cli-inn           = inn-cli
     3826       b_contract.cli-kpp           = kpp-cli
     3827       b_contract.posr-sign-post    = sign-post-posr
     3828       b_contract.posr-sign         = sign-posr
     3829       b_contract.posr-addres       = addres-posr
     3830       b_contract.posr-inn          = inn-posr
     3831       b_contract.posr-kpp          = kpp-posr
     3832       b_contract.agnt-sign-post    = sign-post-agnt
     3833       b_contract.agnt-sign         = sign-agnt
     3834       b_contract.agnt-addres       = addres-agnt
     3835       b_contract.agnt-inn          = inn-agnt
     3836       b_contract.agnt-kpp          = kpp-agnt
     3837       b_contract.own-code-schet        = v-own-code-schet-2
     3838       b_contract.cli-code-schet        = v-cli-code-schet-2
     3839       b_contract.posr-code-schet       = v-posr-code-schet-2
     3840       b_contract.agnt-code-schet       = v-agnt-code-schet-2
     3841       b_contract.own-code-schet-start  = v-own-code-schet
     3842       b_contract.cli-code-schet-start  = v-cli-code-schet
     3843       b_contract.posr-code-schet-start = v-posr-code-schet
     3844       b_contract.agnt-code-schet-start = v-agnt-code-schet
     3845       b_contract.own-point-code        = v-own-point-code
     3846       b_contract.own-point-db-num      = v-own-point-db-num
     3847       b_contract.agnt-point-code       = v-agnt-point-code
     3848       b_contract.agnt-point-db-num     = v-agnt-point-db-num
     3849       b_contract.cli-point-code        = v-cli-point-code
     3850       b_contract.cli-point-db-num      = v-cli-point-db-num
     3851       b_contract.posr-point-code       = v-posr-point-code
     3852       b_contract.posr-point-db-num     = v-posr-point-db-num
     3853       b_contract.spec-check      = COMBO-return-type
     3854       b_contract.fin-VAT-pc      = fin-VAT-pc
     3855       b_contract.own-bank-name  = ""
     3856       b_contract.own-bik        = ""
     3857       b_contract.own-r-schet    = ""
     3858       b_contract.own-c-schet    = ""
     3859       b_contract.cli-bank-name  = ""
     3860       b_contract.cli-bik        = ""
     3861       b_contract.cli-r-schet    = ""
     3862       b_contract.cli-c-schet    = ""
     3863       b_contract.posr-bank-name = ""
     3864       b_contract.posr-bik       = ""
     3865       b_contract.posr-r-schet   = ""
     3866       b_contract.posr-c-schet   = ""
     3867       b_contract.agnt-bank-name = ""
     3868       b_contract.agnt-bik       = ""
     3869       b_contract.agnt-r-schet   = ""
     3870       b_contract.agnt-c-schet   = ""
     3871       b_contract.an-uchet-code-out        = a-code-an-uchet  [1]
     3872       b_contract.cel-nazn-code-out        = a-code-cel-nazn  [1]
     3873       b_contract.cor-acc-out              = a-code-cor-acc   [1]
     3874       b_contract.cor-acc1-out             = a-code-cor-acc-2 [1]
     3875       b_contract.an-uchet-code-in         = a-code-an-uchet  [2]
     3876       b_contract.cel-nazn-code-in         = a-code-cel-nazn  [2]
     3877       b_contract.cor-acc-in               = a-code-cor-acc   [2]
     3878       b_contract.cor-acc1-in              = a-code-cor-acc-2 [2]
     3879       b_contract.an-uchet-code-out-cash   = a-code-an-uchet  [3]
     3880       b_contract.cel-nazn-code-out-cash   = a-code-cel-nazn  [3]
     3881       b_contract.cor-acc-out-cash         = a-code-cor-acc   [3]
     3882       b_contract.cor-acc1-out-cash        = a-code-cor-acc-2 [3]
     3883       b_contract.an-uchet-code-in-cash    = a-code-an-uchet  [4]
     3884       b_contract.cel-nazn-code-in-cash    = a-code-cel-nazn  [4]
     3885       b_contract.cor-acc-in-cash          = a-code-cor-acc   [4]
     3886       b_contract.cor-acc1-in-cash         = a-code-cor-acc-2 [4]
     3887       b_contract.an-uchet-code-out-payoff = a-code-an-uchet  [5]
     3888       b_contract.cel-nazn-code-out-payoff = a-code-cel-nazn  [5]
     3889       b_contract.cor-acc-out-payoff       = a-code-cor-acc   [5]
     3890       b_contract.cor-acc1-out-payoff      = a-code-cor-acc-2 [5]
     3891       b_contract.an-uchet-code-in-payoff  = a-code-an-uchet  [6]
     3892       b_contract.cel-nazn-code-in-payoff  = a-code-cel-nazn  [6]
     3893       b_contract.cor-acc-in-payoff        = a-code-cor-acc   [6]
     3894       b_contract.cor-acc1-in-payoff       = a-code-cor-acc-2 [6]
     3895     .
     3896     if b_contract.usl-opl = 'По спецификации':U or b_contract.usl-opl = 'Отсрочка платежа по спецификации':U  then do:
     3897       assign b_contract.need-fo = 1 .
     3898     end.
     3899     if v-own-code-schet <> ? then do:
     3900       find first ub.fin-schet no-lock where ub.fin-schet.host-code = p-host-code and ub.fin-schet.code-schet = v-own-code-schet no-error .
     3901       if available ub.fin-schet then do:
     3902         find first ub.fin-bank no-lock where ub.fin-bank.host-code = p-host-code and ub.fin-bank.code-bank = ub.fin-schet.code-bank no-error .
     3903         assign
     3904           b_contract.own-bank-name = ub.fin-bank.bank-name
     3905           b_contract.own-bik       = ub.fin-bank.bik
     3906           b_contract.own-r-schet   = ub.fin-schet.r-schet
     3907           b_contract.own-c-schet   = ub.fin-schet.c-schet
     3908         .
     3909       end.
     3910     end.
     3911     if v-cli-code-schet <> ? then do:
     3912       find first ub.fin-schet no-lock where ub.fin-schet.host-code = p-host-code and ub.fin-schet.code-schet = v-cli-code-schet no-error .
     3913       if available ub.fin-schet then do:
     3914         find first ub.fin-bank no-lock where ub.fin-bank.host-code = p-host-code and ub.fin-bank.code-bank = ub.fin-schet.code-bank no-error .
     3915         assign
     3916           b_contract.cli-bank-name = ub.fin-bank.bank-name
     3917           b_contract.cli-bik       = ub.fin-bank.bik
     3918           b_contract.cli-r-schet   = ub.fin-schet.r-schet
     3919           b_contract.cli-c-schet   = ub.fin-schet.c-schet
     3920         .
     3921       end.
     3922     end.
     3923     if v-posr-code-schet <> ? then do:
     3924       find first ub.fin-schet no-lock where ub.fin-schet.host-code = p-host-code and ub.fin-schet.code-schet = v-posr-code-schet no-error .
     3925       if available ub.fin-schet then do:
     3926         find first ub.fin-bank no-lock where ub.fin-bank.host-code = p-host-code and ub.fin-bank.code-bank = ub.fin-schet.code-bank no-error .
     3927         assign
     3928           b_contract.posr-bank-name = ub.fin-bank.bank-name
     3929           b_contract.posr-bik       = ub.fin-bank.bik
     3930           b_contract.posr-r-schet   = ub.fin-schet.r-schet
     3931           b_contract.posr-c-schet   = ub.fin-schet.c-schet
     3932         .
     3933       end.
     3934     end.
     3935     if v-agnt-code-schet <> ? then do:
     3936       find first ub.fin-schet no-lock where ub.fin-schet.host-code = p-host-code and ub.fin-schet.code-schet = v-agnt-code-schet no-error .
     3937       if available ub.fin-schet then do:
     3938         find first ub.fin-bank no-lock where ub.fin-bank.host-code = p-host-code and ub.fin-bank.code-bank = ub.fin-schet.code-bank no-error .
     3939         assign
     3940           b_contract.agnt-bank-name = ub.fin-bank.bank-name
     3941           b_contract.agnt-bik       = ub.fin-bank.bik
     3942           b_contract.agnt-r-schet   = ub.fin-schet.r-schet
     3943           b_contract.agnt-c-schet   = ub.fin-schet.c-schet
     3944         .
     3945       end.
     3946     end.
     3947     case COMBO-auto-pay:screen-value :
     3948       when "фин.об. авто" then b_contract.auto-pay = 0 .
     3949       when "фин.об. факт" then b_contract.auto-pay = 1 .
     3950       when "платеж новый" then b_contract.auto-pay = 2 .
     3951       when "платеж разр"  then b_contract.auto-pay = 3 .
     3952       when "платеж факт"  then b_contract.auto-pay = 4 .
     3953     end.
     3954     find first buf_contract-attr exclusive-lock where buf_contract-attr.contract-code = b_contract.contract-code
     3955     and buf_contract-attr.host-code = b_contract.host-code and buf_contract-attr.attr-code = "contract-edi" no-error .
     3956     if available (buf_contract-attr) then buf_contract-attr.attr-value = string(T-edi) .
     3957     else do:
     3958       create buf_contract-attr .
     3959       assign
     3960       buf_contract-attr.host-code = b_contract.host-code
     3961       buf_contract-attr.contract-code = b_contract.contract-code
     3962       buf_contract-attr.attr-code = "contract-edi"
     3963       buf_contract-attr.attr-value = string (T-edi)
     3964       .
     3965     end.
     3966     find first buf_contract-attr exclusive-lock where buf_contract-attr.contract-code = b_contract.contract-code
     3967     and buf_contract-attr.host-code = b_contract.host-code and buf_contract-attr.attr-code = "contract-diadoc" no-error .
     3968     if available (buf_contract-attr) then buf_contract-attr.attr-value = string(T-diadoc) .
     3969     else do:
     3970       create buf_contract-attr .
     3971       assign
     3972       buf_contract-attr.host-code = b_contract.host-code
     3973       buf_contract-attr.contract-code = b_contract.contract-code
     3974       buf_contract-attr.attr-code = "contract-diadoc"
     3975       buf_contract-attr.attr-value = string (T-diadoc)
     3976       .
     3977     end.
     3978     IF ref-mode = 'ИЗМЕНЕНИЕ':U AND Is-MS-Contract-Int (BUFFER b_Contract) = 1
     3979        THEN DO:
     3980        MESSAGE
     3981        "Распространить изменение шапки мастер договора на " SKIP
     3982        "подчиненные договора ?"
     3983        VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO
     3984        UPDATE lChoice.
     3985        IF lChoice = TRUE THEN DO:
     3986           RUN Modify-Slave-Contract in THIS-PROCEDURE(
     3987               BUFFER b_Contract,
     3988               OUTPUT v-cError
     3989               ).
     3990           IF v-cError <> "" THEN DO:
     3991              MESSAGE
     3992                 v-cError
     3993                 VIEW-AS ALERT-BOX INFO BUTTONS OK.
     3994              RETURN ERROR v-cError.
     3995           END.
     3996        END.
     3997     END.
     3998   END PROCEDURE.
     3999   PROCEDURE disable_UI :
     4000     HIDE FRAME Dialog-Frame.
     4001   END PROCEDURE.
     4002   PROCEDURE enable_UI :
     4003     OPEN QUERY Dialog-Frame FOR EACH contract SHARE-LOCK.
     4004     GET FIRST Dialog-Frame.
     4005     DISPLAY T-edi T-diadoc T-edi-order contract-prn-code contract-date
     4006             contract-city contract-name contract-date-beg contract-date-end
     4007             curr-code COMBO-return-type COMBO-type-contr cli-code cli-type
     4008             posr-code posr-type agnt-code agnt-type mngr-code COMBO-usl-opl
     4009             srok-opl COMBO-auto-pay COMBO-usl-opl-2 srok-opl-2 COMBO-auto-pay-2
     4010             kredit-limit kredit-sum balance-fo str-uslov-oplat fin-VAT-pc
     4011             RADIO-SET-1 b-nal cor-acc an-uchet cel-nazn cor-acc-2 contract-code
     4012             curr-name own-code own-name cli-name posr-name agnt-name mngr-name
     4013         WITH FRAME Dialog-Frame.
     4014     ENABLE b-OK b-exit b-spec B-transport b-hist B-Help RECT-8 RECT-9 T-edi
     4015            T-diadoc T-edi-order contract-prn-code contract-date contract-city
     4016            contract-name BUTTON-curr contract-date-beg contract-date-end
     4017            curr-code COMBO-return-type COMBO-type-contr b-bank-own b-bank-cli
     4018            cli-code cli-type BUTTON-cli b-bank-posr posr-code posr-type
     4019            BUTTON-posr b-bank-agnt agnt-code agnt-type BUTTON-agnt mngr-code
     4020            BUTTON-mngr COMBO-usl-opl srok-opl COMBO-auto-pay COMBO-usl-opl-2
     4021            srok-opl-2 COMBO-auto-pay-2 kredit-limit kredit-sum balance-fo
     4022            str-uslov-oplat fin-VAT-pc RADIO-SET-1 b-nal b-cor-acc b-an-uchet
     4023            b-cel-nazn b-cor-acc-2 contract-code own-code
     4024         WITH FRAME Dialog-Frame.
     4025     VIEW FRAME Dialog-Frame.
     4026   END PROCEDURE.
     4027   PROCEDURE find-cli :
     4028     define input  parameter p-type     as integer   no-undo .
     4029     define input  parameter p-obj-type as character no-undo .
     4030     define input  parameter p-obj-code as integer   no-undo .
     4031     define variable str  as character initial "" no-undo .
     4032     define variable str1 as character initial "" no-undo .
     4033     define variable str2 as character initial "" no-undo .
     4034     define variable str3 as character initial "" no-undo .
     4035     if p-obj-type <> 'орг':U and p-obj-type <> 'чел':U then do:
     4036       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = p-obj-code no-error.
     4037       if not available buf_clients then do:
     4038         find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = p-obj-code no-error.
     4039       end.
     4040     end.
     4041     else find first buf_clients no-lock where buf_clients.obj-type = p-obj-type and buf_clients.obj-code = p-obj-code no-error.
     4042     if not available buf_clients then do:
     4043       if p-obj-code = 0 then assign p-obj-code = ? .
     4044       if p-obj-code = ? then do:
     4045         case p-type :
     4046           when 1 then do:
     4047             assign cli-name = "" kpp-cli = "" inn-cli = ""  addres-cli = ""  cli-code = ?  cli-type  = ? .
     4048             display cli-name    cli-code     cli-type   with frame Dialog-Frame.
     4049           end.
     4050           when 2 then do:
     4051             assign posr-name = "" kpp-posr = ""  inn-posr = ""  addres-posr = ""  posr-code = ?  posr-type = ? .
     4052             display posr-name   posr-code    posr-type  with frame Dialog-Frame.
     4053           end.
     4054           when 3 then do:
     4055             assign agnt-name = "" kpp-agnt = ""  inn-agnt = ""  addres-agnt = ""  agnt-code = ?  agnt-type = ? .
     4056             display agnt-name   agnt-code    agnt-type  with frame Dialog-Frame.
     4057           end.
     4058         end case.
     4059       end.
     4060       else do:
     4061         case p-type :
     4062           when 1 then apply "CHOOSE" to BUTTON-cli IN FRAME Dialog-Frame .
     4063           when 2 then apply "CHOOSE" to BUTTON-posr IN FRAME Dialog-Frame .
     4064           when 3 then apply "CHOOSE" to BUTTON-agnt IN FRAME Dialog-Frame .
     4065         end case.
     4066       end.
     4067       return.
     4068     end.
     4069     if buf_clients.obj-type = 'орг':U then do:
     4070       find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code no-error.
     4071       if available buf_firm then assign str1 = buf_firm.inn   str2 = buf_firm.addres1  str3 = buf_firm.kpp .
     4072     end.
     4073     else do:
     4074       find first ub.person no-lock where ub.person.psn-code = buf_clients.obj-code no-error.
     4075       if available ub.person then assign  str2 = ub.person.address   str3 = ub.person.kpp .
     4076     end.
     4077     case p-type :
     4078       when 1 then do:
     4079         assign cli-name  = buf_clients.obj-name kpp-cli = str3   inn-cli  = str1  addres-cli  = str2  cli-code  = p-obj-code  cli-type  = buf_clients.obj-type.
     4080         display cli-name    cli-code     cli-type   with frame Dialog-Frame.
     4081       end.
     4082       when 2 then do:
     4083         assign posr-name = buf_clients.obj-name  kpp-posr = str3  inn-posr = str1  addres-posr = str2  posr-code = p-obj-code  posr-type = buf_clients.obj-type.
     4084         display posr-name   posr-code    posr-type  with frame Dialog-Frame.
     4085       end.
     4086       when 3 then do:
     4087         assign agnt-name = buf_clients.obj-name  kpp-agnt = str3 inn-agnt = str1  addres-agnt = str2  agnt-code = p-obj-code  agnt-type = buf_clients.obj-type.
     4088         display agnt-name   agnt-code    agnt-type  with frame Dialog-Frame.
     4089       end.
     4090     end case.
     4091   END PROCEDURE.
     4092   PROCEDURE go-proc :
     4093   do
     4094   on error undo, return error
     4095   on stop undo, return error
     4096   :
     4097   define variable par-type as character no-undo .
     4098   define variable v-is-add as character no-undo .
     4099   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4100     (input  'is-addch':u
     4101     ,input  '':u
     4102     ,input  '':u
     4103     ,input  0
     4104     ,input  '':u
     4105     ,input  '':u
     4106     ,input  '':u
     4107     ,input  no
     4108     ,output v-is-add
     4109     ,output par-type
     4110     ) no-error .
     4111     enable COMBO-type-contr with frame Dialog-Frame.
     4112     if v-is-add = 'yes' then COMBO-type-contr:list-items = 'Купли-продажи,Консигнации,Ответственного хранения,Агентский договор,Давальческого сырья,Продажи через ТПСИ,о Дополнительных расходах':U .
     4113                         else COMBO-type-contr:list-items = 'Купли-продажи,Консигнации,Ответственного хранения,Агентский договор,Давальческого сырья,Продажи через ТПСИ':U .
     4114     COMBO-auto-pay:list-items = "фин.об. авто" + "," + "фин.об. факт" + "," + "платеж новый"  .
     4115     COMBO-auto-pay-2:list-items = "новый" + "," + "факт" .
     4116     if p-doc-type = 'при':U then do:
     4117       COMBO-usl-opl:list-items = 'Не определено,По заказу,По поставке заказа,Отсрочка платежа по заказу,Отсрочка платежа по поставке заказа,По факту поставки,По факту реализации,Отсрочка платежа (по поставке),Отсрочка платежа (по реализации),По реализации части приход. накладной,По спецификации,Отсрочка платежа по спецификации':U.
     4118       COMBO-usl-opl-2:list-items   = 'Не определено':U + ","  + 'По приходной накладной':U + ","  + 'По фин. обязательству':U + ","  + 'По платежу':U + ","  + 'По накл. смены типа преобр.':U  .
     4119     end.
     4120     else do:
     4121       COMBO-usl-opl:list-items = 'Не определено,Предоплата,Предоплата(%),По факту поставки покупателю,Отсрочка платежа по поставке':U .
     4122       COMBO-usl-opl-2:list-items   = 'Не определено':U + ","  + 'По расходной накладной':U + ","  + 'По фин. обязательству':U + ","  + 'По платежу':U .
     4123     end.
     4124     if p-doc-type = 'при':U
     4125     then do :
     4126       enable COMBO-return-type WITH FRAME Dialog-Frame.
     4127     end .
     4128     else do :
     4129       hide COMBO-return-type in FRAME Dialog-Frame.
     4130     end .
     4131     case ref-mode :
     4132       when 'ДОБАВЛЕНИЕ':U then do:
     4133         define buffer buf_sysconf for ub.sysconf .
     4134         find first buf_sysconf no-lock where buf_sysconf.host-code = p-host-code .
     4135         disable srok-opl-2 with frame Dialog-Frame.
     4136         B-spec:visible = no .
     4137         assign
     4138           a-code-an-uchet  [1] = buf_sysconf.an-uchet-code-out
     4139           a-code-cel-nazn  [1] = buf_sysconf.cel-nazn-code-out
     4140           a-code-cor-acc   [1] = buf_sysconf.cor-acc-out
     4141           a-code-cor-acc-2 [1] = buf_sysconf.cor-acc1-out
     4142           a-code-an-uchet  [2] = buf_sysconf.an-uchet-code-in
     4143           a-code-cel-nazn  [2] = buf_sysconf.cel-nazn-code-in
     4144           a-code-cor-acc   [2] = buf_sysconf.cor-acc-in
     4145           a-code-cor-acc-2 [2] = buf_sysconf.cor-acc1-in
     4146           a-code-an-uchet  [3] = buf_sysconf.an-uchet-code-out-cash
     4147           a-code-cel-nazn  [3] = buf_sysconf.cel-nazn-code-out-cash
     4148           a-code-cor-acc   [3] = buf_sysconf.cor-acc-out-cash
     4149           a-code-cor-acc-2 [3] = buf_sysconf.cor-acc1-out-cash
     4150           a-code-an-uchet  [4] = buf_sysconf.an-uchet-code-in-cash
     4151           a-code-cel-nazn  [4] = buf_sysconf.cel-nazn-code-in-cash
     4152           a-code-cor-acc   [4] = buf_sysconf.cor-acc-in-cash
     4153           a-code-cor-acc-2 [4] = buf_sysconf.cor-acc1-in-cash
     4154           a-code-an-uchet  [5] = buf_sysconf.an-uchet-code-out-payoff
     4155           a-code-cel-nazn  [5] = buf_sysconf.cel-nazn-code-out-payoff
     4156           a-code-cor-acc   [5] = buf_sysconf.cor-acc-out-payoff
     4157           a-code-cor-acc-2 [5] = buf_sysconf.cor-acc1-out-payoff
     4158           a-code-an-uchet  [6] = buf_sysconf.an-uchet-code-in-payoff
     4159           a-code-cel-nazn  [6] = buf_sysconf.cel-nazn-code-in-payoff
     4160           a-code-cor-acc   [6] = buf_sysconf.cor-acc-in-payoff
     4161           a-code-cor-acc-2 [6] = buf_sysconf.cor-acc1-in-payoff
