     4371         end.
     4372         display t-edi with frame Dialog-Frame .
     4373         for first buf_contract-attr no-lock where buf_contract-attr.host-code = b_contract.host-code and
     4374         buf_contract-attr.contract-code = b_contract.contract-code and buf_contract-attr.attr-code = "contract-edi_orders":
     4375           T-edi-order = logical (buf_contract-attr.attr-value) .
     4376         end.
     4377         display t-edi-order with frame Dialog-Frame .
     4378         for first buf_contract-attr no-lock where buf_contract-attr.host-code = b_contract.host-code and
     4379         buf_contract-attr.contract-code = b_contract.contract-code and buf_contract-attr.attr-code = "contract-diadoc":
     4380           T-diadoc = logical (buf_contract-attr.attr-value) .
     4381         end.
     4382         display t-diadoc with frame Dialog-Frame .
     4383         if ref-mode = 'ПРОСМОТР':U then do:
     4384           disable contract-prn-code contract-date contract-city contract-name contract-date-beg contract-date-end  fin-VAT-pc b-nal
     4385             agnt-code agnt-type BUTTON-agnt BUTTON-mngr posr-code posr-type BUTTON-posr  mngr-code  b-cor-acc b-cor-acc-2 b-an-uchet
     4386             b-cel-nazn COMBO-usl-opl COMBO-usl-opl-2 str-uslov-oplat COMBO-auto-pay COMBO-auto-pay-2 RADIO-SET-1 kredit-sum contract-code kredit-limit
     4387             srok-opl T-edi COMBO-return-type
     4388           with frame Dialog-Frame.
     4389           b-OK:label in frame Dialog-Frame = "&Выход" .
     4390           b-exit:visible = no .
     4391         end.
     4392         if p-doc-type = 'рас':U THEN DO:
     4393            ASSIGN
     4394               b-Add-Inf:VISIBLE   = TRUE
     4395               b-Add-Inf:SENSITIVE = TRUE
     4396               .
     4397         END.
     4398       end.
     4399       when "history" then do:
     4400         find first buf_c-contract no-lock where recid(buf_c-contract) = ri .
     4401         COMBO-type-contr:screen-value = buf_c-contract.contract-type .
     4402         COMBO-usl-opl:list-items = 'Не определено,По заказу,По поставке заказа,Отсрочка платежа по заказу,Отсрочка платежа по поставке заказа,По факту поставки,По факту реализации,Отсрочка платежа (по поставке),Отсрочка платежа (по реализации),По реализации части приход. накладной,По спецификации,Отсрочка платежа по спецификации,Предоплата,Предоплата(%),По факту поставки покупателю,Отсрочка платежа по поставке':U .
     4403         COMBO-usl-opl:screen-value =  buf_c-contract.usl-opl .
     4404         B-spec:visible = no .
     4405         if   buf_c-contract.usl-opl = 'Отсрочка платежа (по реализации)':U
     4406           or buf_c-contract.usl-opl = 'Отсрочка платежа (по поставке)':U
     4407           or buf_c-contract.usl-opl = 'Предоплата(%)':U
     4408           or buf_c-contract.usl-opl = 'Отсрочка платежа по поставке':U
     4409           or buf_c-contract.usl-opl = 'По реализации части приход. накладной':U
     4410           or buf_c-contract.usl-opl = 'Отсрочка платежа по поставке заказа':U
     4411           or buf_c-contract.usl-opl = 'Отсрочка платежа по заказу':U
     4412           or buf_c-contract.usl-opl = 'Отсрочка платежа по спецификации':U
     4413           then do:
     4414           assign srok-opl = buf_c-contract.srok-opl .
     4415           if buf_c-contract.usl-opl = 'По реализации части приход. накладной':U or buf_c-contract.usl-opl = 'Предоплата(%)':U then assign srok-opl:label = "> %" .
     4416         end.
     4417         if buf_c-contract.gen-factur > 100 then assign COMBO-auto-pay-2:screen-value = "факт" .
     4418         else                                    assign COMBO-auto-pay-2:screen-value = "новый" .
     4419         case buf_c-contract.gen-factur :
     4420           when 0 then               assign COMBO-usl-opl-2:screen-value = 'Не определено':U .
     4421           when 1  or when 101 then  assign COMBO-usl-opl-2:screen-value = 'По приходной накладной':U .
     4422           when 2  or when 102 then  assign COMBO-usl-opl-2:screen-value = 'По фин. обязательству':U .
     4423           when 3  or when 103 then  assign COMBO-usl-opl-2:screen-value = 'По платежу':U .
     4424           when 4  or when 104 then  assign COMBO-usl-opl-2:screen-value = 'По накл. смены типа преобр.':U .
     4425           when 5  or when 105 then  assign COMBO-usl-opl-2:screen-value = 'По расходной накладной':U .
     4426         end.
     4427         assign srok-opl-2 = buf_c-contract.gen-factur-srok .
     4428         case buf_c-contract.pay-nal :
     4429           when no then  assign b-nal = 1 .
     4430           when yes then assign b-nal = 2 .
     4431           when ? then   assign b-nal = 3 .
     4432         end.
     4433         assign
     4434           contract-code     = buf_c-contract.contract-code
     4435           contract-prn-code = buf_c-contract.contract-prn-code
     4436           contract-date     = buf_c-contract.contract-date
     4437           contract-city     = buf_c-contract.contract-city
     4438           contract-name     = buf_c-contract.contract-name
     4439           contract-date-beg = buf_c-contract.contract-date-beg
     4440           contract-date-end = buf_c-contract.contract-date-end
     4441           curr-code         = buf_c-contract.curr-code
     4442           own-code          = buf_c-contract.host-code
     4443           cli-code          = buf_c-contract.cli-code
     4444           cli-type          = buf_c-contract.cli-type
     4445           agnt-code         = buf_c-contract.agnt-code
     4446           agnt-type         = buf_c-contract.agnt-type
     4447           posr-code         = buf_c-contract.posr-code
     4448           posr-type         = buf_c-contract.posr-type
     4449           kredit-sum        = buf_c-contract.kredit-sum
     4450           kredit-limit      = buf_c-contract.kredit-limit
     4451           balance-fo        = buf_c-contract.balance-fo-rubl - buf_c-contract.balance-plat-rubl
     4452           v-own-point-code      = buf_c-contract.own-point-code
     4453           v-own-point-db-num    = buf_c-contract.own-point-db-num
     4454           v-agnt-point-code     = buf_c-contract.agnt-point-code
     4455           v-agnt-point-db-num   = buf_c-contract.agnt-point-db-num
     4456           v-cli-point-code      = buf_c-contract.cli-point-code
     4457           v-cli-point-db-num    = buf_c-contract.cli-point-db-num
     4458           v-posr-point-code     = buf_c-contract.posr-point-code
     4459           v-posr-point-db-num   = buf_c-contract.posr-point-db-num
     4460           own-name      = buf_c-contract.own-name
     4461           inn-own       = buf_c-contract.own-inn
     4462           kpp-own       = buf_c-contract.own-kpp
     4463           addres-own    = buf_c-contract.own-addres
     4464           sign-own      = buf_c-contract.own-sign
     4465           sign-post-own = buf_c-contract.own-sign-post
     4466           v-own-code-schet    = buf_c-contract.own-code-schet-start
     4467           v-cli-code-schet    = buf_c-contract.cli-code-schet-start
     4468           v-posr-code-schet   = buf_c-contract.posr-code-schet-start
     4469           v-agnt-code-schet   = buf_c-contract.agnt-code-schet-start
     4470           v-own-code-schet-2  = buf_c-contract.own-code-schet
     4471           v-cli-code-schet-2  = buf_c-contract.cli-code-schet
     4472           v-posr-code-schet-2 = buf_c-contract.posr-code-schet
     4473           v-agnt-code-schet-2 = buf_c-contract.agnt-code-schet
     4474           cli-name      = buf_c-contract.cli-name
     4475           addres-cli    = buf_c-contract.cli-addres
     4476           inn-cli       = buf_c-contract.cli-inn
     4477           kpp-cli       = buf_c-contract.cli-kpp
     4478           sign-cli      = buf_c-contract.cli-sign
     4479           sign-post-cli = buf_c-contract.cli-sign-post
     4480           posr-name      = buf_c-contract.posr-name
     4481           addres-posr    = buf_c-contract.posr-addres
     4482           inn-posr       = buf_c-contract.posr-inn
     4483           kpp-posr       = buf_c-contract.posr-kpp
     4484           sign-posr      = buf_c-contract.posr-sign
     4485           sign-post-posr = buf_c-contract.posr-sign-post
     4486           agnt-name      = buf_c-contract.agnt-name
     4487           addres-agnt    = buf_c-contract.agnt-addres
     4488           inn-agnt       = buf_c-contract.agnt-inn
     4489           kpp-agnt       = buf_c-contract.agnt-kpp
     4490           sign-agnt      = buf_c-contract.agnt-sign
     4491           sign-post-agnt = buf_c-contract.agnt-sign-post
     4492           v-transport-cli-type = buf_c-contract.transport-cli-type
     4493           v-transport-cli-code = buf_c-contract.transport-cli-code
     4494           v-transport-host     = buf_c-contract.transport-host
     4495           v-transport-contract = buf_c-contract.transport-contract
     4496           v-transport-uslov    = buf_c-contract.transport-uslov
     4497           v-transport-value    = buf_c-contract.transport-value
     4498           v-transport-type     = buf_c-contract.transport-type
     4499           fin-VAT-pc     = buf_c-contract.fin-VAT-pc
     4500           mngr-code       = buf_c-contract.mngr-code
     4501           str-uslov-oplat = buf_c-contract.str-uslov-oplat
     4502           a-code-an-uchet  [1] = buf_c-contract.an-uchet-code-out
     4503           a-code-cel-nazn  [1] = buf_c-contract.cel-nazn-code-out
     4504           a-code-cor-acc   [1] = buf_c-contract.cor-acc-out
     4505           a-code-cor-acc-2 [1] = buf_c-contract.cor-acc1-out
     4506           a-code-an-uchet  [2] = buf_c-contract.an-uchet-code-in
     4507           a-code-cel-nazn  [2] = buf_c-contract.cel-nazn-code-in
     4508           a-code-cor-acc   [2] = buf_c-contract.cor-acc-in
     4509           a-code-cor-acc-2 [2] = buf_c-contract.cor-acc1-in
     4510           a-code-an-uchet  [3] = buf_c-contract.an-uchet-code-out-cash
     4511           a-code-cel-nazn  [3] = buf_c-contract.cel-nazn-code-out-cash
     4512           a-code-cor-acc   [3] = buf_c-contract.cor-acc-out-cash
     4513           a-code-cor-acc-2 [3] = buf_c-contract.cor-acc1-out-cash
     4514           a-code-an-uchet  [4] = buf_c-contract.an-uchet-code-in-cash
     4515           a-code-cel-nazn  [4] = buf_c-contract.cel-nazn-code-in-cash
     4516           a-code-cor-acc   [4] = buf_c-contract.cor-acc-in-cash
     4517           a-code-cor-acc-2 [4] = buf_c-contract.cor-acc1-in-cash
     4518           a-code-an-uchet  [5] = buf_c-contract.an-uchet-code-out-payoff
     4519           a-code-cel-nazn  [5] = buf_c-contract.cel-nazn-code-out-payoff
     4520           a-code-cor-acc   [5] = buf_c-contract.cor-acc-out-payoff
     4521           a-code-cor-acc-2 [5] = buf_c-contract.cor-acc1-out-payoff
     4522           a-code-an-uchet  [6] = buf_c-contract.an-uchet-code-in-payoff
     4523           a-code-cel-nazn  [6] = buf_c-contract.cel-nazn-code-in-payoff
     4524           a-code-cor-acc   [6] = buf_c-contract.cor-acc-in-payoff
     4525           a-code-cor-acc-2 [6] = buf_c-contract.cor-acc1-in-payoff
     4526         .
     4527         disable b-hist COMBO-type-contr curr-code BUTTON-curr cli-code cli-type srok-opl BUTTON-cli b-cor-acc-2  contract-prn-code
     4528           contract-date contract-city contract-name contract-date-beg contract-date-end  fin-VAT-pc b-nal srok-opl-2
     4529           agnt-code agnt-type BUTTON-agnt BUTTON-mngr posr-code posr-type BUTTON-posr  mngr-code  b-cor-acc b-cor-acc-2 b-an-uchet
     4530           b-cel-nazn COMBO-usl-opl COMBO-usl-opl-2 str-uslov-oplat COMBO-auto-pay RADIO-SET-1 COMBO-auto-pay-2 kredit-sum contract-code kredit-limit
     4531         with frame Dialog-Frame.
     4532         b-OK:label in frame Dialog-Frame = "&Выход" .
     4533         b-exit:visible = no .
     4534         case buf_c-contract.auto-pay :
     4535           when 0 then COMBO-auto-pay:screen-value = "фин.об. авто" .
     4536           when 1 then COMBO-auto-pay:screen-value = "фин.об. факт" .
     4537           when 2 then COMBO-auto-pay:screen-value = "платеж новый" .
     4538           when 3 then COMBO-auto-pay:screen-value = "платеж разр" .
     4539           when 4 then COMBO-auto-pay:screen-value = "платеж факт" .
     4540         end.
     4541       end.
     4542     end.
     4543     find first ub.fin-code-an-uchet no-lock where ub.fin-code-an-uchet.fin-code = a-code-an-uchet [1] and ub.fin-code-an-uchet.host-code = p-host-code no-error .
     4544     if available ub.fin-code-an-uchet then  assign an-uchet = ub.fin-code-an-uchet.code-value + "  " + ub.fin-code-an-uchet.descr .
     4545     find first ub.fin-code-cel-nazn no-lock where ub.fin-code-cel-nazn.fin-code  = a-code-cel-nazn [1] and ub.fin-code-cel-nazn.host-code = p-host-code no-error .
     4546     if available ub.fin-code-cel-nazn then assign cel-nazn = ub.fin-code-cel-nazn.code-value + "  " + ub.fin-code-cel-nazn.descr .
     4547     find first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.fin-code  = a-code-cor-acc [1] and ub.fin-code-cor-acc.host-code = p-host-code no-error .
     4548     if available ub.fin-code-cor-acc then assign cor-acc = ub.fin-code-cor-acc.code-value + "  " + ub.fin-code-cor-acc.descr  .
     4549     find first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.fin-code  = a-code-cor-acc-2 [1] and ub.fin-code-cor-acc.host-code = p-host-code no-error .
     4550     if available ub.fin-code-cor-acc then assign cor-acc-2 = ub.fin-code-cor-acc.code-value + "  " + ub.fin-code-cor-acc.descr  .
     4551     display T-edi T-diadoc T-edi-order contract-prn-code contract-date contract-city contract-name contract-date-beg contract-date-end curr-code COMBO-return-type COMBO-type-contr cli-code cli-type posr-code posr-type agnt-code agnt-type mngr-code COMBO-usl-opl srok-opl COMBO-auto-pay COMBO-usl-opl-2 srok-opl-2 COMBO-auto-pay-2 kredit-limit kredit-sum balance-fo str-uslov-oplat fin-VAT-pc RADIO-SET-1 b-nal cor-acc an-uchet cel-nazn cor-acc-2 contract-code curr-name own-code own-name cli-name posr-name agnt-name mngr-name with frame Dialog-Frame.
     4552     if mngr-code <> 0 and mngr-code <> ? then apply "LEAVE"  to mngr-code  IN FRAME Dialog-Frame .
     4553     apply "entry"  to contract-prn-code IN FRAME Dialog-Frame .
     4554     apply "LEAVE"  to curr-code  IN FRAME Dialog-Frame .
     4555     apply "VALUE-CHANGED"  to b-nal IN FRAME Dialog-Frame .
     4556   end.
     4557   END PROCEDURE.
     4558   PROCEDURE step-next :
     4559     do on error undo, return error return-value :
     4560       if valid-handle (br-handle) then do:
     4561         g-log = br-handle:select-next-row() no-error .
     4562         if error-status :error then do:
     4563           message "Это режим просмотра одного документа." .
     4564           g-log = false .
     4565         end.
     4566         if not g-log then message "Это последний документ списка.".
     4567       end.
     4568       ri = recid ( buf_contract ).
     4569       next-prev = yes.
     4570     end.
     4571   END PROCEDURE.
     4572   PROCEDURE step-prev :
     4573    do
     4574    on error undo, return error return-value
     4575    :
     4576   if valid-handle (br-handle) then do:
     4577     g-log = br-handle:select-prev-row() no-error .
     4578     if error-status :error then do:
     4579        message "Это режим просмотра одного документа." .
     4580        g-log = false .
     4581     end.
     4582     if not g-log then do: message "Это первый документ списка.".   end.
     4583   end.
     4584   ri = recid (buf_contract).
     4585   next-prev = yes .
     4586     end.
     4587   END PROCEDURE.
