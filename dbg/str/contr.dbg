     1122   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1123   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1124   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1125   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1126   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1127   ASSIGN
     1128      v-S_CONTRACT                = "Contract":U
     1129      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1130      v-DELIM_CHR_3               = ","
     1131      .
     1132   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1133   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1134   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1135   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1136      INPUT iHost-Code    AS INTEGER,
     1137      INPUT iContract-Num AS INTEGER,
     1138      INPUT iGds-Code     AS INTEGER ):
     1139      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1140      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1141      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1142      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1143      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1144      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1145          INPUT  iHost-Code,
     1146          INPUT  iContract-Num,
     1147          OUTPUT iTmp-Extent3
     1148          ).
     1149      IF iTmp-Extent3[1] = 2 THEN DO:
     1150         ASSIGN
     1151            iTmp-Host-Code      = iTmp-Extent3[2]
     1152            iTmp-Contract-Num   = iTmp-Extent3[3]
     1153            .
     1154      END. ELSE DO:
     1155         ASSIGN
     1156            iTmp-Host-Code      = iHost-Code
     1157            iTmp-Contract-Num   = iContract-Num
     1158            .
     1159      END.
     1160      IF iGds-Code = ? THEN DO:
     1161         ASSIGN
     1162            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1163                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1164                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1165                           ).
     1166      END. ELSE DO:
     1167            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1168                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1169                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1170                              AND buf_Spec.Gds-Code      = iGds-Code
     1171                            ).
     1172      END.
     1173      RETURN (lRet).
     1174   END FUNCTION.
     1175   PROCEDURE MS-Contract-EXTENT-3:
     1176      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1177      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1178      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1179      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1180      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1181      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1182      FIND FIRST buf_Cont-2 WHERE
     1183                 buf_Cont-2.Host-Code      = i-Host-Code
     1184             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1185           NO-LOCK NO-ERROR.
     1186      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1187         RETURN.
     1188      END.
     1189      FOR FIRST buf_Ext-Classif WHERE
     1190                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1191           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1192                                               STRING(i-Contract-code)
     1193           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1194          NO-LOCK,
     1195          EACH buf_Cont WHERE
     1196               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1197           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1198          NO-LOCK:
     1199          ASSIGN
     1200             i-Ret[1] = 1
     1201             i-Ret[2] = buf_Cont.Host-code
     1202             i-Ret[3] = buf_Cont.Contract-code
     1203             .
     1204          LEAVE.
     1205      END.
     1206      IF i-Ret[1] <> 1 THEN DO:
     1207         FOR FIRST buf_Ext-Classif WHERE
     1208                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1209              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1210                                                  STRING(i-Contract-code)
     1211              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1212             NO-LOCK,
     1213             EACH buf_Cont WHERE
     1214                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1215              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1216             NO-LOCK:
     1217             ASSIGN
     1218                i-Ret[1] = 2
     1219                i-Ret[2] = buf_Cont.Host-code
     1220                i-Ret[3] = buf_Cont.Contract-code
     1221                .
     1222             LEAVE.
     1223         END.
     1224      END.
     1225      RETURN.
     1226   END PROCEDURE.
     1227   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1228   DEFINE VARIABLE v-gl-UVEDOMLENIE as CHARACTER NO-UNDO INITIAL "Uvedomlenie":U.
     1229   FUNCTION Get-Contract-Attr RETURN CHARACTER(
     1230            INPUT iHost-Code AS INTEGER,
     1231            INPUT iContract-Code  AS INTEGER,
     1232            INPUT cAttr-code      AS CHARACTER):
     1233      DEFINE BUFFER buf_Contract-Attr FOR ub.Contract-Attr.
     1234      FIND FIRST buf_Contract-Attr WHERE
     1235                 buf_Contract-Attr.Host-code     = iHost-Code
     1236             AND buf_Contract-Attr.Contract-code = iContract-Code
     1237             AND buf_Contract-Attr.Attr-code     = cAttr-code
     1238           NO-LOCK NO-ERROR.
     1239      RETURN (IF AVAILABLE buf_Contract-Attr THEN buf_Contract-Attr.Attr-value ELSE ?).
     1240   END FUNCTION.
     1241   PROCEDURE Modify-Contract-Attr:
     1242      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     1243      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     1244      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     1245      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     1246      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     1247      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     1248      Tran:
     1249      DO TRANSACTION
     1250         ON ENDKEY UNDO Tran, RETRY Tran
     1251         ON ERROR  UNDO Tran, RETRY Tran
     1252         ON QUIT   UNDO Tran, RETRY Tran
     1253         ON STOP   UNDO Tran, RETRY Tran:
     1254         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1255         FIND FIRST buf_Contract-Attr WHERE
     1256                    buf_Contract-Attr.Host-Code      = iHost-Code
     1257                AND buf_Contract-Attr.Contract-Code  = iContract-Code
     1258                AND buf_Contract-Attr.Attr-code      = cAttr-code
     1259              NO-LOCK NO-ERROR.
     1260         IF NOT AVAILABLE buf_Contract-Attr THEN DO:
     1261            CREATE buf_Contract-Attr NO-ERROR.
     1262            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1263         END. ELSE DO:
     1264            FIND CURRENT buf_Contract-Attr EXCLUSIVE-LOCK NO-ERROR.
     1265            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1266         END.
     1267         ASSIGN
     1268            buf_Contract-Attr.Host-Code      = iHost-Code
     1269            buf_Contract-Attr.Contract-Code  = iContract-Code
     1270            buf_Contract-Attr.Attr-code      = cAttr-code
     1271            buf_Contract-Attr.Attr-value     = cAttr-value
     1272            NO-ERROR.
     1273         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1274         RELEASE buf_Contract-Attr NO-ERROR.
     1275         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1276      END.
     1277      RETURN.
     1278   END PROCEDURE.
     1279   PROCEDURE Create-Contract-Attr:
     1280      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     1281      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     1282      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     1283      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     1284      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     1285      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     1286      Tran:
     1287      DO TRANSACTION
     1288         ON ENDKEY UNDO Tran, RETRY Tran
     1289         ON ERROR  UNDO Tran, RETRY Tran
     1290         ON QUIT   UNDO Tran, RETRY Tran
     1291         ON STOP   UNDO Tran, RETRY Tran:
     1292         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1293         CREATE buf_Contract-Attr NO-ERROR.
     1294         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1295         ASSIGN
     1296            buf_Contract-Attr.Host-Code      = iHost-Code
     1297            buf_Contract-Attr.Contract-Code  = iContract-Code
     1298            buf_Contract-Attr.Attr-code      = cAttr-code
     1299            buf_Contract-Attr.Attr-value     = cAttr-value
     1300            NO-ERROR.
     1301         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1302         RELEASE buf_Contract-Attr NO-ERROR.
     1303         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1304      END.
     1305      RETURN.
     1306   END PROCEDURE.
     1307   FUNCTION Is-MS-Contract RETURN LOGICAL(BUFFER buf_Master FOR ub.Contract, BUFFER buf_Slave  FOR ub.Contract) FORWARD.
     1308   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract) FORWARD.
     1309   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract) FORWARD.
     1310   PROCEDURE Delete-Contract-Specif:
     1311      DEFINE PARAMETER BUFFER buf_Contract FOR ub.Contract.
     1312      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1313      DEFINE BUFFER buf_Specif      FOR ub.Contract-Specif.
     1314      DEFINE BUFFER buf_Specif-Attr FOR ub.Contract-Specif-Attr.
     1315      Tran:
     1316      DO TRANSACTION
     1317         ON ENDKEY UNDO Tran, RETRY Tran
     1318         ON ERROR  UNDO Tran, RETRY Tran
     1319         ON QUIT   UNDO Tran, RETRY Tran
     1320         ON STOP   UNDO Tran, RETRY Tran:
     1321         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1322         FOR EACH buf_Specif-Attr WHERE
     1323                  buf_Specif-Attr.Host-code     = buf_Contract.Host-code
     1324              AND buf_Specif-Attr.Contract-Num  = buf_Contract.Contract-code
     1325             EXCLUSIVE-LOCK:
     1326             DELETE buf_Specif-Attr NO-ERROR.
     1327             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1328         END.
     1329         FOR EACH buf_Specif WHERE
     1330                  buf_Specif.Host-code     = buf_Contract.Host-code
     1331              AND buf_Specif.Contract-Num  = buf_Contract.Contract-code
     1332             EXCLUSIVE-LOCK:
     1333             DELETE buf_Specif NO-ERROR.
     1334            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1335         END.
     1336      END.
     1337      RETURN.
     1338   END PROCEDURE.
     1339   PROCEDURE Modify-Slave-Contract:
     1340      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1341      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1342      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1343      DEFINE BUFFER buf_Slave FOR ub.Contract.
     1344      Tran:
     1345      DO TRANSACTION
     1346         ON ENDKEY UNDO Tran, RETRY Tran
     1347         ON ERROR  UNDO Tran, RETRY Tran
     1348         ON QUIT   UNDO Tran, RETRY Tran
     1349         ON STOP   UNDO Tran, RETRY Tran:
     1350         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1351         FOR EACH buf_Ext-Classif WHERE
     1352                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1353              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1354              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1355             NO-LOCK,
     1356             FIRST buf_Slave WHERE
     1357                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1358               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1359             EXCLUSIVE-LOCK:
     1360             BUFFER-COPY
     1361               buf_Master
     1362             EXCEPT
     1363               Host-code                               Contract-code                           Own-name                                an-uchet-code-out                       cel-nazn-code-out                       cor-acc-out                             cor-acc1-out                            an-uchet-code-in                        cel-nazn-code-in                        cor-acc-in                              cor-acc1-in                             an-uchet-code-out-cash                  cel-nazn-code-out-cash                  cor-acc-out-cash                        cor-acc1-out-cash                       an-uchet-code-in-cash                   cel-nazn-code-in-cash                   cor-acc-in-cash                         cor-acc1-in-cash                        an-uchet-code-out-payoff                cel-nazn-code-out-payoff                cor-acc-out-payoff                      cor-acc1-out-payoff                     an-uchet-code-in-payoff                 cel-nazn-code-in-payoff                 cor-acc-in-payoff                       cor-acc1-in-payoff                      transport-cli-type                      transport-cli-code                      transport-host                          transport-contract                      transport-uslov                         transport-value                         own-code-schet-start                    own-sign-post                           own-sign                                contract-city                           fin-VAT-pc                              srok-opl                                gen-factur-srok                         own-addres                              own-inn                                 own-kpp
     1364             TO buf_Slave
     1365             NO-ERROR.
     1366             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1367             RELEASE buf_Slave NO-ERROR.
     1368             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1369         END.
     1370      END.
     1371      RETURN.
     1372   END PROCEDURE.
     1373   PROCEDURE Change-Stat-Slave-Contract:
     1374      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1375      DEFINE INPUT PARAMETER cStatus  AS CHARACTER NO-UNDO.
     1376      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1377      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1378      DEFINE BUFFER buf_Slave FOR ub.Contract.
     1379      Tran:
     1380      DO TRANSACTION
     1381         ON ENDKEY UNDO Tran, RETRY Tran
     1382         ON ERROR  UNDO Tran, RETRY Tran
     1383         ON QUIT   UNDO Tran, RETRY Tran
     1384         ON STOP   UNDO Tran, RETRY Tran:
     1385         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1386         FOR EACH buf_Ext-Classif WHERE
     1387                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1388              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1389              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1390             NO-LOCK,
     1391             FIRST buf_Slave WHERE
     1392                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1393               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1394             EXCLUSIVE-LOCK:
     1395             ASSIGN
     1396                buf_Slave.Status_ = cStatus
     1397                NO-ERROR.
     1398             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1399             RELEASE buf_Slave NO-ERROR.
     1400             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1401         END.
     1402      END.
     1403      RETURN.
     1404   END PROCEDURE.
     1405   PROCEDURE Delete-Ref-Master-Slave:
     1406      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1407      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     1408      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1409      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1410      IF NOT Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     1411         cError = PROGRAM-NAME(1) + ":" + "Между договорами нет связи Master->Slave".
     1412         RETURN.
     1413      END.
     1414      Tran:
     1415      FOR FIRST buf_Ext-Classif WHERE
     1416                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1417            AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1418            AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1419            AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1420          EXCLUSIVE-LOCK
     1421          TRANSACTION
     1422          ON ENDKEY UNDO Tran, RETRY Tran
     1423          ON ERROR  UNDO Tran, RETRY Tran
     1424          ON QUIT   UNDO Tran, RETRY Tran
     1425          ON STOP   UNDO Tran, RETRY Tran:
     1426          IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1427          DELETE buf_Ext-Classif NO-ERROR.
     1428          IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1429      END.
     1430      RETURN.
     1431   END PROCEDURE.
     1432   PROCEDURE Create-Ref-Master-Slave:
     1433      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1434      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     1435      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1436      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1437      DEFINE VARIABLE cKeyRec AS CHARACTER NO-UNDO INITIAL "".
     1438      IF Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     1439         cError = PROGRAM-NAME(1) + ":" + "Между договорами  уже есть связь Master->Slave".
     1440         RETURN.
     1441      END.
     1442      RUN gen-key-rec IN THIS-PROCEDURE(
     1443          INPUT  v-S_CONTRACT,
     1444          INPUT  BUFFER buf_Master:HANDLE,
     1445          OUTPUT cKeyRec
     1446          ) NO-ERROR.
     1447      IF ERROR-STATUS:ERROR THEN DO:
     1448         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
     1449         RETURN.
     1450      END.
     1451      Tran:
     1452      DO TRANSACTION
     1453         ON ENDKEY UNDO Tran, RETRY Tran
     1454         ON ERROR  UNDO Tran, RETRY Tran
     1455         ON QUIT   UNDO Tran, RETRY Tran
     1456         ON STOP   UNDO Tran, RETRY Tran:
     1457         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1458         CREATE buf_Ext-Classif NO-ERROR.
     1459         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1460         ASSIGN
     1461            buf_Ext-Classif.Classif-name    = v-S_CONTRACT
     1462            buf_Ext-Classif.Classif-subject = v-S_CONTRACT
     1463            buf_Ext-Classif.CharKey_One     = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1464            buf_Ext-Classif.CharKey_Two     = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1465            buf_Ext-Classif.DB-num          = buf_Master.Db-num
     1466            buf_Ext-Classif.Uniq-key-rec    = cKeyRec
     1467            NO-ERROR.
     1468         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1469         RELEASE buf_Ext-Classif NO-ERROR.
     1470         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1471      END.
     1472      RETURN.
     1473   END PROCEDURE.
     1474   FUNCTION Is-MS-Contract-Int-2 RETURN INTEGER (
     1475                                 i-Host-Code AS INTEGER,
     1476                                 i-Contract-Code AS INTEGER):
     1477      DEFINE BUFFER buf_Contract FOR ub.Contract.
     1478      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     1479      FIND FIRST buf_Contract WHERE
     1480                 buf_Contract.Host-Code      = i-Host-Code
     1481             AND buf_Contract.Contract-code  = i-Contract-Code
     1482           NO-LOCK NO-ERROR.
     1483      IF AVAILABLE buf_Contract THEN DO:
     1484         ASSIGN
     1485            iRet = Is-MS-Contract-Int(BUFFER buf_Contract).
     1486      END.
     1487      RETURN (iRet).
     1488   END FUNCTION.
     1489   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract):
     1490      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1491      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1492      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     1493      FOR FIRST buf_Ext-Classif WHERE
     1494                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1495           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1496                                               STRING(buf_Contract.contract-code)
     1497           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1498          NO-LOCK,
     1499          EACH buf_Cont WHERE
     1500               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1501           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1502          NO-LOCK:
     1503          ASSIGN
     1504             iRet = 1.
     1505          LEAVE.
     1506      END.
     1507      IF iRet <> 1 THEN DO:
     1508         FOR FIRST buf_Ext-Classif WHERE
     1509                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1510              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1511                                                  STRING(buf_Contract.contract-code)
     1512              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1513             NO-LOCK,
     1514             EACH buf_Cont WHERE
     1515                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1516              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1517             NO-LOCK:
     1518             ASSIGN
     1519                iRet = 2.
     1520             LEAVE.
     1521         END.
     1522      END.
     1523      RETURN (iRet).
     1524   END FUNCTION.
     1525   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract):
     1526      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1527      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1528      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     1529      FOR FIRST buf_Ext-Classif WHERE
     1530                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1531           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1532                                               STRING(buf_Contract.contract-code)
     1533           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1534          NO-LOCK,
     1535          EACH buf_Cont WHERE
     1536               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1537           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1538          NO-LOCK:
     1539          ASSIGN
     1540             cRet = "+".
     1541          LEAVE.
     1542      END.
     1543      IF cRet = "" THEN DO:
     1544         FOR FIRST buf_Ext-Classif WHERE
     1545                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1546              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1547                                                  STRING(buf_Contract.contract-code)
     1548              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1549             NO-LOCK,
     1550             EACH buf_Cont WHERE
     1551                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1552              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1553             NO-LOCK:
     1554             ASSIGN
     1555                cRet = (IF buf_Cont.Contract-prn-code = "" THEN  STRING(buf_Cont.Contract-code) ELSE buf_Cont.Contract-prn-code).
     1556             LEAVE.
     1557         END.
     1558      END.
     1559      RETURN (cRet).
     1560   END FUNCTION.
     1561   FUNCTION Is-MS-Contract RETURN LOGICAL(
     1562            BUFFER buf_Master FOR ub.Contract,
     1563            BUFFER buf_Slave  FOR ub.Contract):
     1564      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1565      RETURN CAN-FIND ( FIRST buf_Ext-Classif WHERE
     1566                          buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1567                      AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1568                      AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1569                      AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1570                    NO-LOCK).
     1571   END FUNCTION.
     1572   FUNCTION Get-Num-Slave-Contract RETURN CHARACTER(
     1573            BUFFER buf_Master FOR ub.Contract,
     1574            INPUT iSlave-Host-Code AS INTEGER
     1575            ):
     1576      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1577      DEFINE BUFFER buf_Contract    FOR ub.Contract.
     1578      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     1579      FIND FIRST buf_Ext-Classif WHERE
     1580                 buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1581             AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1582             AND buf_Ext-Classif.CharKey_Two  BEGINS STRING(iSlave-Host-Code) + v-DELIM_CHR_3
     1583             AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1584           NO-LOCK NO-ERROR.
     1585      IF AVAILABLE buf_Ext-Classif THEN DO:
     1586         IF CAN-FIND (FIRST buf_Contract WHERE
     1587                            buf_Contract.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1588                        AND buf_Contract.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1589                       NO-LOCK) THEN DO:
     1590            ASSIGN
     1591               cRet = ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3).
     1592         END. ELSE DO:
     1593            ASSIGN
     1594               cRet = "ERROR:" + "Ошибка связи мастер договора " +
     1595                      STRING(buf_Master.Host-Code) + "," + STRING(buf_Master.Contract-code) + " " +
     1596                      "c Host-code=" + STRING(iSlave-Host-Code).
     1597         END.
     1598      END.
     1599      RETURN (cRet).
     1600   END FUNCTION.
