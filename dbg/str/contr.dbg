     4253           if b_contract.usl-opl = 'По реализации части приход. накладной':U or b_contract.usl-opl = 'Предоплата(%)':U then assign srok-opl:label = "> %" .
     4254         end.
     4255         case b_contract.pay-nal :
     4256           when no then  assign b-nal = 1 .
     4257           when yes then assign b-nal = 2 .
     4258           when ? then   assign b-nal = 3 .
     4259         end.
