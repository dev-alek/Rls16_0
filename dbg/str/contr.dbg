     4181           sign-post-own     = buf_sysconf.pay-sign-post
     4182           sign-own          = buf_sysconf.pay-sign
     4183           contract-date     = today
     4184           contract-date-beg = today
     4185           fin-VAT-pc        = buf_sysconf.fin-VAT-pc
     4186           srok-opl = buf_sysconf.srok-opl
     4187           srok-opl-2 = buf_sysconf.srok-opl-sf
     4188         .
     4189         if buf_sysconf.usl-opl-sf <> "" and   buf_sysconf.usl-opl-sf <> ? then do:
     4190           if lookup ( buf_sysconf.usl-opl-sf, COMBO-usl-opl-2:list-items) = 0 then COMBO-usl-opl-2:screen-value    = 'Не определено':U .
     4191           else COMBO-usl-opl-2:screen-value =  buf_sysconf.usl-opl-sf .
     4192         end.
     4193         else COMBO-usl-opl-2:screen-value    = 'Не определено':U .
     4194         case buf_sysconf.auto-pay-sf :
     4195           when 0 then COMBO-auto-pay-2:screen-value = "новый" .
     4196           when 1 then COMBO-auto-pay-2:screen-value = "факт" .
     4197         end.
     4198         if buf_sysconf.contract-type <> "" and buf_sysconf.contract-type <> ?  and buf_sysconf.contract-type <> "Не задан" then do:
     4199           COMBO-type-contr:screen-value = buf_sysconf.contract-type .
     4200         end.
     4201         else COMBO-type-contr:screen-value = 'Купли-продажи':U .
     4202         if buf_sysconf.usl-opl <> "" and   buf_sysconf.usl-opl <> ? then do:
     4203           if lookup ( buf_sysconf.usl-opl, COMBO-usl-opl:list-items) = 0 then COMBO-usl-opl:screen-value    = 'Не определено':U .
     4204           else COMBO-usl-opl:screen-value =  buf_sysconf.usl-opl .
     4205         end.
     4206         else COMBO-usl-opl:screen-value    = 'Не определено':U .
     4207         case buf_sysconf.auto-pay :
     4208           when 0 then COMBO-auto-pay:screen-value = "фин.об. авто" .
     4209           when 1 then COMBO-auto-pay:screen-value = "фин.об. факт" .
     4210           when 2 then COMBO-auto-pay:screen-value = "платеж новый" .
     4211           when 3 then COMBO-auto-pay:screen-value = "платеж разр" .
     4212           when 4 then COMBO-auto-pay:screen-value = "платеж факт" .
     4213         end.
     4214         if   COMBO-usl-opl:screen-value = 'Не определено':U
     4215           or COMBO-usl-opl:screen-value = 'Предоплата':U
     4216           or COMBO-usl-opl:screen-value = 'По факту поставки покупателю':U
     4217           or COMBO-usl-opl:screen-value = 'По факту поставки':U
     4218           or COMBO-usl-opl:screen-value = 'По факту реализации':U  then  disable srok-opl with frame Dialog-Frame.
     4219         disable b-hist b-cor-acc-2 with frame Dialog-Frame.
     4220         if p-contr-type <> "" then do:
     4221            COMBO-type-contr:screen-value = p-contr-type.
     4222            disable COMBO-type-contr with frame Dialog-Frame .
     4223         end.
     4224       end.
     4225       when 'ИЗМЕНЕНИЕ':U or when 'ПРОСМОТР':U then do:
     4226         find first b_contract no-lock where recid(b_contract) = ri .
     4227         COMBO-type-contr:screen-value = b_contract.contract-type .
     4228         COMBO-usl-opl:screen-value =  b_contract.usl-opl .
     4229         COMBO-return-type = b_contract.spec-check .
     4230         display COMBO-return-type WITH FRAME Dialog-Frame.
     4231         if b_contract.gen-factur > 100 then assign COMBO-auto-pay-2:screen-value = "факт" .
     4232         else                                assign COMBO-auto-pay-2:screen-value = "новый" .
     4233         case b_contract.gen-factur :
     4234           when 0 then               assign COMBO-usl-opl-2:screen-value = 'Не определено':U .
     4235           when 1  or when 101 then  assign COMBO-usl-opl-2:screen-value = 'По приходной накладной':U .
     4236           when 2  or when 102 then  assign COMBO-usl-opl-2:screen-value = 'По фин. обязательству':U .
     4237           when 3  or when 103 then  assign COMBO-usl-opl-2:screen-value = 'По платежу':U .
     4238           when 4  or when 104 then  assign COMBO-usl-opl-2:screen-value = 'По накл. смены типа преобр.':U .
     4239           when 5  or when 105 then  assign COMBO-usl-opl-2:screen-value = 'По расходной накладной':U .
     4240         end.
     4241         assign srok-opl-2 = b_contract.gen-factur-srok .
     4242         if b_contract.gen-factur < 10 or b_contract.gen-factur > 10 and b_contract.gen-factur < 110 then  disable srok-opl-2 with frame Dialog-Frame.
     4243         if   b_contract.usl-opl = 'Отсрочка платежа (по реализации)':U
     4244           or b_contract.usl-opl = 'Отсрочка платежа (по поставке)':U
     4245           or b_contract.usl-opl = 'Предоплата(%)':U
     4246           or b_contract.usl-opl = 'Отсрочка платежа по поставке':U
