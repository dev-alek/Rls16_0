     2786   on help of frame Dialog-Frame
     2787   do:
     2788     run gbl/app_help.p
     2789       (input this-procedure :file-name
     2790       ,input ''
     2791       ,input ?
     2792       ) no-error.
     2793     if error-status :error then do:
