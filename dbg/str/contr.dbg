     2624   ON VALUE-CHANGED OF COMBO-usl-opl IN FRAME Dialog-Frame
     2625   DO:
     2626     assign COMBO-usl-opl .
     2627     assign srok-opl = 0 .
     2628     if p-doc-type = 'при':U then do:
     2629       if COMBO-usl-opl = 'По реализации части приход. накладной':U then assign srok-opl:label = "> %" .
     2630          else assign srok-opl:label = "Срок" .
     2631       if   COMBO-usl-opl = 'Отсрочка платежа (по реализации)':U
     2632         or COMBO-usl-opl = 'Отсрочка платежа (по поставке)':U
     2633         or COMBO-usl-opl = 'По реализации части приход. накладной':U
     2634         or COMBO-usl-opl = 'Отсрочка платежа по поставке заказа':U
     2635         or COMBO-usl-opl = 'Отсрочка платежа по заказу':U
     2636         or COMBO-usl-opl = 'Отсрочка платежа по спецификации':U
     2637         then do:
     2638           display srok-opl with frame Dialog-Frame.
     2639           enable srok-opl with frame Dialog-Frame.
     2640         end.
     2641         else do:
     2642           disable srok-opl with frame Dialog-Frame.
     2643         end.
     2644     end.
     2645     else do:
     2646       if COMBO-usl-opl = 'Предоплата(%)':U then assign srok-opl:label = "> %" .
     2647          else assign srok-opl:label = "Срок" .
     2648       if COMBO-usl-opl = 'Предоплата(%)':U or COMBO-usl-opl:screen-value = 'Отсрочка платежа по поставке':U
     2649         then  do:
     2650            display srok-opl with frame Dialog-Frame.
     2651            enable srok-opl with frame Dialog-Frame.
     2652         end.
     2653         else do:
     2654            disable srok-opl with frame Dialog-Frame.
     2655         end.
     2656     end.
     2657     display srok-opl with frame Dialog-Frame.
     2658   END.
     2659   ON VALUE-CHANGED OF COMBO-usl-opl-2 IN FRAME Dialog-Frame
     2660   DO:
     2661     assign COMBO-usl-opl-2 .
     2662     assign srok-opl-2 = 0 .
     2663     disable srok-opl-2 with frame Dialog-Frame.
     2664     display srok-opl-2 with frame Dialog-Frame.
     2665   END.
     2666   ON LEAVE OF curr-code IN FRAME Dialog-Frame
     2667   DO:
     2668     assign curr-code .
     2669     find first ub.currency where ub.currency.curr-code = curr-code no-error.
     2670     if not available ub.currency then do:
     2671       assign
     2672       ref-rec = ?.
     2673       run ref/currency.w (input parparentproc, "b-sel", input-output ref-rec ).
     2674       if ref-rec = ? then return no-apply.
     2675       find ub.currency where recid ( ub.currency ) = ref-rec.
     2676     end.
     2677     assign curr-name = ub.currency.curr-abbr .
     2678     display curr-name with frame Dialog-Frame.
     2679   END.
     2680   ON RETURN OF curr-code IN FRAME Dialog-Frame
     2681   DO:
     2682     assign curr-code .
     2683     find first ub.currency where ub.currency.curr-code = curr-code no-error.
     2684     if not available ub.currency then do:
     2685       assign
     2686       ref-rec = ?.
     2687       run ref/currency.w (input parparentproc, "b-sel", input-output ref-rec ).
     2688       if ref-rec = ? then return no-apply.
     2689       find ub.currency where recid ( ub.currency ) = ref-rec.
     2690     end.
     2691     assign curr-name = ub.currency.curr-abbr .
     2692     display curr-name with frame Dialog-Frame.
     2693   END.
     2694   ON VALUE-CHANGED OF kredit-limit IN FRAME Dialog-Frame
     2695   DO:
     2696     assign kredit-limit .
     2697     if kredit-limit = no  then  disable kredit-sum with frame Dialog-Frame.
     2698     else                        enable  kredit-sum with frame Dialog-Frame.
     2699   END.
     2700   ON LEAVE OF mngr-code IN FRAME Dialog-Frame
     2701   DO:
     2702     assign mngr-code.
     2703     find first ub.clients no-lock where ub.clients.obj-type = 'чел':U and ub.clients.obj-code = mngr-code no-error.
     2704     if not available ub.clients then do:
     2705       if mngr-code = 0 then assign mngr-code = ? .
     2706       if mngr-code = ? then do:
     2707         assign  mngr-name = "" .
     2708         display mngr-name with frame Dialog-Frame.
     2709       end.
     2710       else apply "CHOOSE" to BUTTON-mngr IN FRAME Dialog-Frame .
     2711     end.
     2712     else do:
     2713       assign  mngr-name = ub.clients.obj-name .
     2714       display mngr-name with frame Dialog-Frame.
     2715     end.
     2716   END.
     2717   ON RETURN OF mngr-code IN FRAME Dialog-Frame
     2718   DO:
     2719     assign mngr-code.
     2720     find first ub.clients no-lock where ub.clients.obj-type = 'чел':U and ub.clients.obj-code = mngr-code no-error.
     2721     if not available ub.clients then do:
     2722       if mngr-code = 0 then assign mngr-code = ? .
     2723       if mngr-code = ? then do:
     2724         assign  mngr-name = "" .
     2725         display mngr-name with frame Dialog-Frame.
     2726       end.
     2727       else apply "CHOOSE" to BUTTON-mngr IN FRAME Dialog-Frame .
     2728     end.
     2729     else do:
     2730       assign  mngr-name = ub.clients.obj-name .
     2731       display mngr-name with frame Dialog-Frame.
     2732     end.
     2733   END.
     2734   ON LEAVE OF posr-code IN FRAME Dialog-Frame
     2735   DO:
     2736     if posr-code = int ( posr-code:screen-value ) then return.
