     1012   procedure thbjattr_write :
     1013   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
     1014   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
     1015   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
     1016   define input  parameter p-code     like ub.thbj-attr.prop-code  no-undo .
     1017   define input  parameter p-value-character like ub.thbj-attr.property-value-character no-undo .
     1018   define input  parameter p-value-date like ub.thbj-attr.property-value-date no-undo .
     1019   define input  parameter p-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
     1020   define input  parameter p-value-integer like ub.thbj-attr.property-value-integer no-undo .
     1021   define input  parameter p-value-logical like ub.thbj-attr.property-value-logical no-undo .
     1022   do
     1023   on error undo, return error return-value
     1024   :
     1025       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_write in g#attr-lib
     1026       (input  p-obj-type
     1027       ,input  p-obj-code
     1028       ,input  p-upper-code
     1029       ,input  p-code
     1030       ,input  p-value-character
     1031       ,input  p-value-date
     1032       ,input  p-value-decimal
     1033       ,input  p-value-integer
     1034       ,input  p-value-logical
     1035       ) no-error .
     1036     if error-status :error
     1037     then do:
     1038       undo, return error return-value .
