     1982        contract-date-end AT ROW 5.67 COL 27.63 COLON-ALIGNED
     1983        curr-code AT ROW 5.67 COL 83 COLON-ALIGNED
     1984        COMBO-return-type AT ROW 6.58 COL 70 COLON-ALIGNED
     1985        COMBO-type-contr AT ROW 6.67 COL 12 COLON-ALIGNED
     1986        b-bank-own AT ROW 7.58 COL 85.13
     1987        b-bank-cli AT ROW 8.58 COL 85.13
     1988        cli-code AT ROW 8.45 COL 12 COLON-ALIGNED NO-LABEL
     1989        cli-type AT ROW 8.45 COL 22.13 COLON-ALIGNED NO-LABEL
     1990        BUTTON-cli AT ROW 8.45 COL 28.75
     1991        b-bank-posr AT ROW 9.58 COL 85.13
     1992        posr-code AT ROW 9.23 COL 12 COLON-ALIGNED NO-LABEL
     1993        posr-type AT ROW 9.23 COL 22.13 COLON-ALIGNED NO-LABEL
     1994        BUTTON-posr AT ROW 9.23 COL 28.75
     1995        b-bank-agnt AT ROW 10.58 COL 85.13
     1996        agnt-code AT ROW 10.75 COL 12 COLON-ALIGNED NO-LABEL
     1997        agnt-type AT ROW 10.75 COL 22.13 COLON-ALIGNED NO-LABEL
     1998        BUTTON-agnt AT ROW 10.75 COL 28.75
     1999        mngr-code AT ROW 10.03 COL 12 COLON-ALIGNED NO-LABEL
     2000        BUTTON-mngr AT ROW 10.03 COL 28.75
     2001        COMBO-usl-opl AT ROW 13.46 COL 16 COLON-ALIGNED
     2002        srok-opl AT ROW 13.46 COL 65 COLON-ALIGNED
     2003        COMBO-auto-pay AT ROW 13.46 COL 79.5 COLON-ALIGNED
     2004        COMBO-usl-opl-2 AT ROW 14.54 COL 16 COLON-ALIGNED
     2005        srok-opl-2 AT ROW 14.54 COL 65 COLON-ALIGNED
     2006        COMBO-auto-pay-2 AT ROW 14.54 COL 79.5 COLON-ALIGNED
     2007        kredit-limit AT ROW 16.67 COL 2.5
     2008        kredit-sum AT ROW 16.67 COL 23 COLON-ALIGNED NO-LABEL
     2009        balance-fo AT ROW 16.67 COL 77.63 COLON-ALIGNED
     2010        str-uslov-oplat AT ROW 17.71 COL 23 COLON-ALIGNED
     2011        fin-VAT-pc AT ROW 17.71 COL 77.63 COLON-ALIGNED
     2012        RADIO-SET-1 AT ROW 19.33 COL 2.5 NO-LABEL
     2013        b-nal AT ROW 19.33 COL 14 NO-LABEL
     2014        cor-acc AT ROW 19.5 COL 53.5 COLON-ALIGNED
     2015        b-cor-acc AT ROW 19.5 COL 94.88
     2016        an-uchet AT ROW 20.5 COL 53.5 COLON-ALIGNED
     2017        b-an-uchet AT ROW 20.5 COL 94.88
     2018        cel-nazn AT ROW 21.5 COL 53.5 COLON-ALIGNED
     2019        b-cel-nazn AT ROW 21.5 COL 94.88
     2020        cor-acc-2 AT ROW 22.5 COL 53.5 COLON-ALIGNED
     2021        b-cor-acc-2 AT ROW 22.5 COL 94.88
     2022        contract-code AT ROW 3.58 COL 85.63 COLON-ALIGNED
     2023        curr-name AT ROW 5.58 COL 90.5 COLON-ALIGNED NO-LABEL
     2024        own-code AT ROW 7.67 COL 12.25 COLON-ALIGNED NO-LABEL
     2025        own-name AT ROW 7.83 COL 21.5 COLON-ALIGNED NO-LABEL
     2026        cli-name AT ROW 8.45 COL 31.75 NO-LABEL
     2027        posr-name AT ROW 9.23 COL 31.75 NO-LABEL
     2028        agnt-name AT ROW 10.75 COL 31.75 NO-LABEL
     2029        mngr-name AT ROW 10.03 COL 31.75 NO-LABEL
     2030        "ГЕНЕРАЦИЯ" VIEW-AS TEXT
     2031             SIZE 10.5 BY .83 AT ROW 12.0 COL 1.5 WIDGET-ID 2
     2032             FGCOLOR 4
     2033        "Фирма:" VIEW-AS TEXT
     2034             SIZE 6.13 BY .92 AT ROW 7.67 COL 7
     2035             FGCOLOR 4
     2036       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2037            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE .
     2038   DEFINE FRAME Dialog-Frame
     2039        "Контрагент:" VIEW-AS TEXT
     2040             SIZE 11.5 BY 1 AT ROW 8.45 COL 2
     2041             FGCOLOR 4
     2042        "Посредник:" VIEW-AS TEXT
     2043             SIZE 10.13 BY 1 AT ROW 9.23 COL 2.88
     2044             FGCOLOR 4
     2045        "Исполнитель:" VIEW-AS TEXT
     2046             SIZE 12 BY 1 AT ROW 9.95 COL 1.13
     2047             FGCOLOR 4
     2048        "Агент:" VIEW-AS TEXT
     2049             SIZE 6.13 BY 1 AT ROW 10.75 COL 6.88
     2050             FGCOLOR 4
     2051        "ОПЛАТА" VIEW-AS TEXT
     2052             SIZE 7 BY .83 AT ROW 14.58 COL 1.5
     2053             FGCOLOR 4
     2054        RECT-8 AT ROW 13.13 COL 1.25 WIDGET-ID 4
     2055        RECT-9 AT ROW 16.13 COL 1.25 WIDGET-ID 6
     2056        SPACE(0.61) SKIP(0.19)
     2057       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2058            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2059            TITLE "Договор".
     2060   ASSIGN
     2061          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2062          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2063   ASSIGN
     2064          an-uchet:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2065   ASSIGN
     2066          B-Add-Inf:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2067   ASSIGN
     2068          b-next:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2069   ASSIGN
     2070          b-prev:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2071   ASSIGN
     2072          balance-fo:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2073   ASSIGN
     2074          cel-nazn:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2075   ASSIGN
     2076          contract-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2077   ASSIGN
     2078          cor-acc:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2079   ASSIGN
     2080          cor-acc-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2081   ON END-ERROR OF FRAME Dialog-Frame
     2082   DO:
     2083     if ref-mode = 'ИЗМЕНЕНИЕ':U or ref-mode = 'ДОБАВЛЕНИЕ':U then do:
     2084       message "Отменить сделанные изменения?"  view-as alert-box QUESTION BUTTONS YES-NO update g-log .
     2085       if g-log = no then return no-apply.
     2086       next-prev = ?.
     2087     end.
     2088   END.
     2089   ON LEAVE OF agnt-code IN FRAME Dialog-Frame
     2090   DO:
     2091     if agnt-code = int ( agnt-code:screen-value ) then return.
     2092     assign agnt-code.
     2093     run find-cli in this-procedure (input 3, input agnt-type, input agnt-code) .
     2094   END.
     2095   ON RETURN OF agnt-code IN FRAME Dialog-Frame
     2096   DO:
     2097     if agnt-code = int ( agnt-code:screen-value ) then return.
     2098     assign agnt-code.
     2099     run find-cli in this-procedure (input 3, input agnt-type, input agnt-code) .
     2100   END.
     2101   ON LEAVE OF agnt-type IN FRAME Dialog-Frame
     2102   DO:
     2103     assign agnt-type.
     2104     run find-cli in this-procedure (input 3, input agnt-type, input agnt-code) .
     2105   END.
     2106   ON CHOOSE OF B-Add-Inf IN FRAME Dialog-Frame
     2107   DO:
     2108      DEF VAR cError AS CHARACTER NO-UNDO INITIAL "".
     2109      RUN str/contaddi.w(
     2110              INPUT parParentProc,
     2111              INPUT THIS-PROCEDURE:HANDLE,
     2112              INPUT ref-mode,
     2113              INPUT p-doc-type,
     2114              INPUT ri,
     2115              OUTPUT cError
     2116             ).
     2117      IF cError <> ""  THEN DO:
     2118         MESSAGE cError
     2119             VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2120      END.
     2121      RETURN NO-APPLY.
     2122   END.
     2123   ON CHOOSE OF b-an-uchet IN FRAME Dialog-Frame
     2124   DO:
     2125   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2126   if lookup(self :type
     2127            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2128            ) = 0
     2129   then do:
     2130     message
     2131       "$Workfile$"
     2132       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2133       "Интерфейсный элемент" self :name  skip
     2134       "Тип" self :type  skip
     2135       "Процедура" this-procedure :file-name skip
     2136       view-as alert-box .
     2137   end.
     2138   else do:
     2139     apply "entry":u to self  .
     2140     if focus :handle <> self :handle  then do:
     2141       return no-apply .
     2142     end.
     2143   end.
     2144     define variable rid-list as  char no-undo .
     2145     define variable p-rec    as recid no-undo.
     2146     assign p-rec = ? .
     2147     if a-code-an-uchet [RADIO-SET-1] <> ? then do:
     2148       find first ub.fin-code-an-uchet no-lock where ub.fin-code-an-uchet.fin-code = a-code-an-uchet [RADIO-SET-1] and ub.fin-code-an-uchet.host-code = p-host-code no-error .
     2149       if available ub.fin-code-an-uchet then assign p-rec = recid (ub.fin-code-an-uchet) .
     2150     end.
     2151     run ref/fwcode-3.w  ( input parParentProc, input "b-sel", input 'фирма':U, input p-rec, input p-host-code, output rid-list )  .
     2152     if rid-list <> "" then do:
     2153       find first ub.fin-code-an-uchet no-lock where RECID(ub.fin-code-an-uchet) = int (rid-list) no-error .
     2154       if available ub.fin-code-an-uchet then
     2155         assign
     2156           an-uchet = ub.fin-code-an-uchet.code-value + "  " + ub.fin-code-an-uchet.descr
     2157           a-code-an-uchet [RADIO-SET-1] = ub.fin-code-an-uchet.fin-code
     2158         .
     2159       else assign a-code-an-uchet [RADIO-SET-1] = ?  an-uchet = "" .
     2160     end.
     2161     else assign a-code-an-uchet [RADIO-SET-1] = ?  an-uchet = "" .
     2162     display an-uchet with frame Dialog-Frame.
     2163   END.
