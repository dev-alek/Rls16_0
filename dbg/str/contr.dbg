     4340           a-code-cel-nazn  [3] = b_contract.cel-nazn-code-out-cash
     4341           a-code-cor-acc   [3] = b_contract.cor-acc-out-cash
     4342           a-code-cor-acc-2 [3] = b_contract.cor-acc1-out-cash
     4343           a-code-an-uchet  [4] = b_contract.an-uchet-code-in-cash
