     2477   ON CHOOSE OF b-spec IN FRAME Dialog-Frame
     2478   DO:
     2479     define variable v-rid-list as char no-undo.
     2480     ASSIGN
     2481        iTmp-Host-Code       = p-host-code
     2482        iTmp-Contract-Code   = buf_contract.contract-code
     2483        cTmp-Mode-W          = ref-mode
     2484        .
     2485     IF v-iMcMode = 1 OR v-iMcMode = 2 THEN DO:
     2486        RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2487            INPUT  p-Host-Code,
     2488            INPUT  contract-code,
     2489            OUTPUT i-Cont-Ret
     2490            ).
     2491        IF i-Cont-Ret[1] = 2 THEN DO:
     2492           ASSIGN
     2493              iTmp-Host-Code       = i-Cont-Ret[2]
     2494              iTmp-Contract-Code   = i-Cont-Ret[3]
     2495              cTmp-Mode-W          = 'ПРОСМОТР':U
     2496              .
     2497        END.
     2498     END.
     2499     RUN str/contspec.w (
     2500         INPUT  parparentproc,
     2501         INPUT  "b-mark",
     2502         INPUT  cTmp-Mode-W,
     2503         INPUT  iTmp-Host-Code,
     2504         INPUT  iTmp-Contract-Code,
     2505         OUTPUT v-rid-list
     2506         ).
     2507   END.
     2508   ON CHOOSE OF B-transport IN FRAME Dialog-Frame
     2509   DO:
     2510     run adm/conftran.w ( input if ref-mode = 'ДОБАВЛЕНИЕ':U then 'ИЗМЕНЕНИЕ':U else ref-mode ,
     2511                          input "contract",
     2512                          input p-host-code,
     2513                          input parParentProc,
     2514                          input-output v-transport-cli-type ,
     2515                          input-output v-transport-cli-code ,
     2516                          input-output v-transport-host,
     2517                          input-output v-transport-contract,
     2518                          input-output v-transport-uslov,
     2519                          input-output v-transport-value,
     2520                          input-output v-transport-type
     2521                          ).
     2522   END.
     2523   ON CHOOSE OF BUTTON-agnt IN FRAME Dialog-Frame
     2524   DO:
     2525     run ref/cli-all.w ( parParentProc, "b-sel", 'все':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,":u, "without-obj":U, output agnt-list ) .
     2526     if agnt-list <> "" then do:
     2527       find first ub.clients no-lock where RECID(ub.clients) = int (agnt-list) no-error.
     2528       if ub.clients.obj-type <> 'чел':U and ub.clients.obj-type <> 'орг':U then do:
     2529         message
     2530           "Агент может быть только " 'орг':U " или " 'чел':U
     2531           view-as alert-box ERROR .
     2532         return no-apply.
     2533       end.
     2534       run find-cli in this-procedure (input 3, input ub.clients.obj-type, input ub.clients.obj-code) .
     2535     end.
     2536     else do:
     2537       assign agnt-name = ""  inn-agnt = ""  addres-agnt = ""  agnt-code = ?  agnt-type = ? .
     2538       display agnt-name   agnt-code    agnt-type  with frame Dialog-Frame.
     2539     end.
     2540   END.
     2541   ON CHOOSE OF BUTTON-cli IN FRAME Dialog-Frame
     2542   DO:
     2543     run ref/cli-all.w (parParentProc, "b-sel", 'все':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,":u, "without-obj":U, output agnt-list ) .
     2544     if agnt-list <> "" then do:
     2545       find first ub.clients no-lock where RECID(ub.clients) = int (agnt-list) no-error.
     2546       if ub.clients.obj-type <> 'чел':U and ub.clients.obj-type <> 'орг':U then do:
     2547         message
     2548           "Контрагент может быть только " 'орг':U " или " 'чел':U
