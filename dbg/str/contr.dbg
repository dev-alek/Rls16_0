     2553     end.
     2554     else do:
     2555       assign cli-name = ""  inn-cli = ""  addres-cli = ""  cli-code = ?  cli-type  = ? .
     2556       display cli-name    cli-code     cli-type   with frame Dialog-Frame.
     2557     end.
     2558   END.
     2559   ON CHOOSE OF BUTTON-curr IN FRAME Dialog-Frame
     2560   DO:
     2561     assign
     2562     ref-rec = ?.
     2563     run ref/currency.w (input parparentproc, "b-sel", input-output ref-rec ).
     2564     if ref-rec = ? then return no-apply.
