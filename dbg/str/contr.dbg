     4336           a-code-cel-nazn  [2] = b_contract.cel-nazn-code-in
     4337           a-code-cor-acc   [2] = b_contract.cor-acc-in
     4338           a-code-cor-acc-2 [2] = b_contract.cor-acc1-in
