      986   procedure thbjattr_get-section :
      987   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      988   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      989   define input  parameter p-upper-param-code  like ub.thbj-attr.upper-prop-code  no-undo .
      990   define input  parameter p-mode as character no-undo .
      991   define input-output parameter table-handle p-tth.
