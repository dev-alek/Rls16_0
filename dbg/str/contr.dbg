     2805   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2806   procedure minbtn-set :
     2807       do
     2808           on error undo, return error return-value
     2809           :
     2810           define variable ii              as integer       no-undo .
     2811           define variable fh              as widget-handle no-undo .
     2812           define variable hh              as widget-handle no-undo .
     2813           define variable v-h             as handle        extent 4 no-undo .
     2814           define variable v-name-button   as character     no-undo .
     2815           define variable v-help-old-x    as decimal       no-undo .
     2816           define variable v-help-old-y    as decimal       no-undo .
     2817           define variable v-help-old-size as decimal       no-undo .
     2818           define variable v-frame-width   as decimal       no-undo .
     2819           define variable jj              as integer       no-undo .
     2820           do
     2821               on error undo, return error
     2822               :
     2823               assign
     2824                   v-frame-width = frame Dialog-Frame:width - 0.3
     2825                   fh            = frame Dialog-Frame:first-child
     2826                   hh            = fh:first-child
     2827                   ii            = 1
     2828                   .
     2829               do while valid-handle(hh):
     2830                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2831                   do:
     2832                       case lc(hh:name) :
     2833                           when "b-help" then
     2834                               do:
     2835                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2836                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2837                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2838                                   hh:TOOLTIP = "Помощь" .
     2839                                   v-help-old-x = hh:column .
     2840                                   v-help-old-y = hh:row    .
     2841                                   v-help-old-size = hh:width .
     2842                                   hh:width-chars = 2.5 .
     2843                               end.
     2844                           when "b-print" then
     2845                               do:
     2846                                   hh:load-image("cmp/b-print.bmp":u) .
     2847                                   hh:TOOLTIP = "Печать" .
     2848                                   v-h[ii] = hh:handle .
     2849                                   ii = ii + 1 .
     2850                                   hh:width-chars = 3 .
     2851                               end.
     2852                           when "b-history" or
     2853                           when "b-hist" then
     2854                               do:
     2855                                   hh:load-image("cmp/b-hist.bmp":u) .
     2856                                   hh:TOOLTIP = "История" .
     2857                                   v-h[ii] = hh:handle .
     2858                                   ii = ii + 1 .
     2859                                   hh:width-chars = 3 .
     2860                               end.
     2861                           when "b-sch" then
     2862                               do:
     2863                                   hh:load-image("cmp/b-sch.bmp":u) .
     2864                                   hh:TOOLTIP = "Установка Фильтра" .
     2865                                   v-h[ii] = hh:handle .
     2866                                   ii = ii + 1 .
     2867                                   hh:width-chars = 3 .
     2868                               end.
     2869                           when "b-hist-user" then
     2870                               do:
     2871                                   hh:load-image("cmp/b-hist.bmp":u) .
     2872                                   hh:TOOLTIP = "История пользователя" .
     2873                                   ii = ii + 1 .
     2874                               end.
     2875                       end case.
     2876                   end.
     2877                   hh = hh:next-sibling.
     2878               end.
     2879               b-help:column = v-frame-width - b-help:width-chars.
     2880               jj = 0.
     2881               repeat ii = 4 to 1 by -1 :
     2882                   if valid-handle (v-h[ii] ) then
     2883                   do:
     2884                       jj  = jj + 1 .
     2885                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2886                       v-h[ii]:row    = v-help-old-y .
     2887                   end.
     2888               end.
     2889           end.
     2890       end.
     2891   end procedure.
