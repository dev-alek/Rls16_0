        1   def var vss-revision    as character no-undo init "$Revision$":u .
        2   def var vss-author      as character no-undo init "$Author$":u .
        3   def var vss-date        as character no-undo init "$Date$":u .
        4   def var vss-workfile    as character no-undo init "$Workfile$":u .
        5   def var vss-archive     as character no-undo init "$Archive$":u .
        6   def var vss-description as character no-undo init "Карточка договора" .
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define new global shared variable g#library  as handle no-undo .
      111   define new global shared variable g#library2 as handle no-undo .
      112   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   procedure gen-b-code :
      114     define input  parameter type-code like ub.code-range.range-type no-undo .
      115     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      116     do
      117     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      118     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      119     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      120     :
      121       define buffer buf_thbj-attr     for ub.thbj-attr .
      122       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      123       define buffer buf_code-range for ub.code-range .
      124       define variable l-code         as   integer              no-undo .
      125       define variable v-db-num       like ub.db.db-num         no-undo .
      126       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      127       if type-code = 'sslc':U
      128       or type-code = 'ssgb':U
      129       then do:
      130         message
      131           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      132           "Обратитесь к администратору системы."
      133           view-as alert-box error .
      134         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      135       end.
      136       run trg/getpcode.p ( input  type-code
      137                      ,output cfg-param-code
      138                     ).
      139       run get-next-seq( input  type-code,
      140                         output l-code
      141                       ).
      142       find first buf_sys-ctrl no-lock.
      143       if type-code = 'sclc':U
      144       or type-code = 'pglc':U
      145       then do:
      146         assign
      147           v-db-num = 0
      148         .
      149       end.
      150       else do:
      151         assign
      152           v-db-num = buf_sys-ctrl.db-num
      153         .
      154       end.
      155       find first buf_code-range no-lock
      156         where buf_code-range.db-num     = v-db-num
      157           and buf_code-range.range-type = type-code
      158           and buf_code-range.stts       = "a"
      159         use-index stts
      160         no-error .
      161       if available buf_code-range
      162          and l-code <= buf_code-range.last-code
      163          and l-code >= buf_code-range.first-code then do:
      164         assign
      165           p-b-code = l-code
      166         .
      167       end.
      168       else do:
      169         if available buf_code-range
      170            and l-code < buf_code-range.last-code then do:
      171           message
      172             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      173             "Обратитесь к администратору системы."
      174             view-as alert-box error .
      175           undo, return error "sequence":U .
      176         end.
      177         do transaction
      178         on error undo, return error
      179         :
      180           find first buf_thbj-attr exclusive-lock
      181             where buf_thbj-attr.upper-prop-code = 'code-range':U
      182               and buf_thbj-attr.prop-code = cfg-param-code
      183               and buf_thbj-attr.obj-type   = 'БД':U
      184               and buf_thbj-attr.obj-code   = v-db-num
      185             no-error .
      186           if not available buf_thbj-attr then do:
      187             find first buf_thbj-attr exclusive-lock
      188               where buf_thbj-attr.upper-prop-code = 'code-range':U
      189                 and buf_thbj-attr.prop-code = cfg-param-code
      190                 and buf_thbj-attr.obj-type   = ''
      191                 and buf_thbj-attr.obj-code   = 0
      192               no-error .
      193             if not available buf_thbj-attr then do:
      194               if not locked buf_thbj-attr then do:
      195                 message
      196                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      197                   "Обратитесь к администратору системы."
      198                   view-as alert-box error .
      199               end.
      200               undo, return error "config":U .
      201             end.
      202           end.
      203           run get-next-seq( input type-code,
      204                             output l-code
      205                           ).
      206           find first buf_code-range
      207             where buf_code-range.db-num     = v-db-num
      208               and buf_code-range.range-type = type-code
      209               and buf_code-range.stts       = "a"
      210             use-index stts
      211             no-error .
      212           if available buf_code-range
      213           and l-code <= buf_code-range.last-code
      214           and l-code >= buf_code-range.first-code
      215           then do:
      216             assign
      217               p-b-code = l-code
      218             .
      219           end.
      220           else do:
      221             if available buf_code-range then do:
      222               assign
      223                 buf_code-range.stts = "u"
      224               .
      225             end.
      226             find first buf_code-range
      227               where buf_code-range.db-num     = v-db-num
      228                 and buf_code-range.range-type = type-code
      229                 and buf_code-range.stts       = "f"
      230               use-index stts
      231               no-error .
      232             if not available buf_code-range then do:
      233               message
      234                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      235                 "Обратитесь к администратору системы"
      236                 view-as alert-box error .
      237               undo, return error "code-range":U .
      238             end.
      239             assign
      240               buf_code-range.stts           = "a"
      241             .
      242             if buf_code-range.first-code = 1 then do:
      243               run set-seq-cr( input type-code,
      244                               input buf_code-range.first-code
      245                             ).
      246               assign
      247                 p-b-code = 1
      248               .
      249             end.
      250             else do:
      251               run set-seq-cr( input type-code,
      252                               input ( buf_code-range.first-code - 1 )
      253                             ).
      254               run get-next-seq( input type-code,
      255                                 output p-b-code
      256                               ).
      257             end.
      258           end.
      259         end.
      260       end.
      261     end.
      262   end procedure.
      263   procedure get-next-seq :
      264     define input  parameter type-code like ub.code-range.range-type no-undo .
      265     define output parameter next-seq  as   integer                  no-undo .
      266     do
      267     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      268     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      269     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      270     :
      271       case type-code:
      272         when 'bcgb':U then do:
      273           assign
      274             next-seq = next-value(s-bcgb-code, ub)
      275           .
      276         end.
      277         when 'scgb':U then do:
      278           assign
      279             next-seq = next-value(s-scgb-code, ub)
      280           .
      281         end.
      282         when 'sclc':U then do:
      283           assign
      284             next-seq = next-value(s-sclc-code, ub)
      285           .
      286         end.
      287         when 'pglc':U then do:
      288           assign
      289             next-seq = next-value(s-pglc-code, ub)
      290           .
      291         end.
      292         when 'dcgb':U then do:
      293           assign
      294             next-seq = next-value(s-dcgb-code, ub)
      295           .
      296         end.
      297         when 'ctgb':U then do:
      298           assign
      299             next-seq = next-value(s-ctgb-code, ub)
      300           .
      301         end.
      302         when 'drgb':U then do:
      303           assign
      304             next-seq = next-value(s-drgb-code, ub)
      305           .
      306         end.
      307         when 'fmgb':U then do:
      308           assign
      309             next-seq = next-value(s-fmgb-code, ub)
      310           .
      311         end.
      312         when 'pngb':U then do:
      313           assign
      314             next-seq = next-value(s-pngb-code, ub)
      315           .
      316         end.
      317         when 'cagb':U then do:
      318           assign
      319             next-seq = next-value(s-cagb-code, ub)
      320           .
      321         end.
      322         when 'fdgb':U then do:
      323           assign
      324             next-seq = next-value(s-fin-doc, ub)
      325           .
      326         end.
      327       end case.
      328     end.
      329   end procedure.
      330   procedure set-seq-cr :
      331     define input parameter type-code like ub.code-range.range-type no-undo .
      332     define input parameter set-val   like ub.code-range.first-code no-undo .
      333     do
      334     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      335     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      336     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      337     :
      338       case type-code:
      339         when 'bcgb':U then do:
      340           assign
      341             current-value(s-bcgb-code, ub) = set-val
      342           .
      343         end.
      344         when 'scgb':U then do:
      345           assign
      346             current-value(s-scgb-code, ub) = set-val
      347           .
      348         end.
      349         when 'sclc':U then do:
      350           assign
      351             current-value(s-sclc-code, ub) = set-val
      352           .
      353         end.
      354         when 'pglc':U then do:
      355           assign
      356             current-value(s-pglc-code, ub) = set-val
      357           .
      358         end.
      359         when 'dcgb':U then do:
      360           assign
      361             current-value(s-dcgb-code, ub) = set-val
      362           .
      363         end.
      364         when 'ctgb':U then do:
      365           assign
      366             current-value(s-ctgb-code, ub) = set-val
      367           .
      368         end.
      369         when 'drgb':U then do:
      370           assign
      371             current-value(s-drgb-code, ub) = set-val
      372           .
      373         end.
      374         when 'fmgb':U then do:
      375           assign
      376             current-value(s-fmgb-code, ub) = set-val
      377           .
      378         end.
      379         when 'pngb':U then do:
      380           assign
      381             current-value(s-pngb-code, ub) = set-val
      382           .
      383         end.
      384         when 'cagb':U then do:
      385           assign
      386             current-value(s-cagb-code, ub) = set-val
      387           .
      388         end.
      389         when 'fdgb':U then do:
      390           assign
      391             current-value(s-fin-doc, ub) = set-val
      392           .
      393         end.
      394       end case.
      395     end.
      396   end procedure.
      397   procedure new-bcod-gen-code-range :
      398     do
      399     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      400     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      401     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      402     :
      403       define input parameter p-db-num  like ub.db.db-num             no-undo .
      404       define input parameter type-code like ub.code-range.range-type no-undo .
      405       define buffer buf_code-range      for ub.code-range .
      406       define buffer last_code-range     for ub.code-range .
      407       define buffer last-1_code-range   for ub.code-range .
      408       define buffer last-2_code-range   for ub.code-range .
      409       define buffer last-3_code-range   for ub.code-range .
      410       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      411       define variable conf-par       as character no-undo .
      412       define variable par-type       as character no-undo .
      413       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      414       define variable v-cre-cdrg as logical   no-undo .
      415       define variable v-cre-str  as character no-undo .
      416       define variable v-cr1      as integer no-undo .
      417       define variable v-cr2      as integer no-undo .
      418       define variable v-cr3      as integer no-undo .
      419       define variable v-cmax     as integer no-undo .
      420       find first buf_sys-ctrl no-lock .
      421       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      422         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      423                                       ,vss-workfile
      424                                       ,vss-revision
      425                                       ,vss-description
      426                                       ,chr(10)
      427                                       , p-db-num
      428                                      ).
      429       end.
      430       run trg/getpcode.p ( input  type-code
      431                      ,output cfg-param-code
      432                     ).
      433       for each buf_code-range
      434         where buf_code-range.db-num     = -1
      435           and buf_code-range.range-type = type-code
      436           and buf_code-range.stts       = "f"
      437       by buf_code-range.first-code
      438       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      439       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      440       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      441       :
      442         assign
      443           buf_code-range.db-num = p-db-num
      444         .
      445         return .
      446       end.
      447       assign
      448         v-cre-cdrg = TRUE
      449       .
      450       case type-code:
      451         when 'sclc':U
      452         or when 'scgb':U
      453         or when 'pglc':U
      454         then do:
      455           find last last-1_code-range no-lock
      456             where last-1_code-range.range-type = 'sclc':U
      457             no-error .
      458           if available last-1_code-range then do:
      459             v-cr1 = last-1_code-range.last-code.
      460           end.
      461           find last last-2_code-range no-lock
      462             where last-2_code-range.range-type = 'scgb':U
      463             no-error .
      464           if available last-2_code-range then do:
      465             v-cr2 = last-2_code-range.last-code.
      466             end.
      467           find last last-3_code-range no-lock
      468             where last-3_code-range.range-type = 'pglc':U
      469             no-error .
      470           if available last-3_code-range then do:
      471             v-cr3 = last-3_code-range.last-code.
      472           end.
      473           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      474           .
      475           if v-cmax = v-cr1  then do:
      476               find last last_code-range no-lock
      477                 where recid( last_code-range ) = recid( last-1_code-range )
      478                 .
      479             end.
      480           if v-cmax = v-cr2  then do:
      481               find last last_code-range no-lock
      482                 where recid( last_code-range ) = recid( last-2_code-range )
      483                 .
      484             end.
      485           if v-cmax = v-cr3  then do:
      486             find last last_code-range no-lock
      487               where recid( last_code-range ) = recid( last-3_code-range )
      488               .
      489           end.
      490           if last_code-range.last-code + 1 > 99999 then do:
      491             assign
      492               v-cre-cdrg = FALSE
      493             .
      494           end.
      495         end.
      496         when 'bcgb':U
      497         or when 'sslc':U
      498         or when 'ssgb':U
      499         then do:
      500           find last last-1_code-range no-lock
      501             where last-1_code-range.range-type = 'sslc':U
      502             no-error .
      503           if available last-1_code-range then do:
      504             v-cr1 = last-1_code-range.last-code.
      505           end.
      506           find last last-2_code-range no-lock
      507             where last-2_code-range.range-type = 'bcgb':U
      508             no-error .
      509           if available last-2_code-range then do:
      510             v-cr2 = last-2_code-range.last-code.
      511             end.
      512           find last last-3_code-range no-lock
      513             where last-3_code-range.range-type = 'ssgb':U
      514             no-error .
      515           if available last-3_code-range then do:
      516             v-cr3 = last-3_code-range.last-code.
      517           end.
      518           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      519           .
      520           if v-cmax = v-cr1  then do:
      521               find last last_code-range no-lock
      522                 where recid( last_code-range ) = recid( last-1_code-range )
      523                 .
      524             end.
      525           if v-cmax = v-cr2  then do:
      526               find last last_code-range no-lock
      527                 where recid( last_code-range ) = recid( last-2_code-range )
      528                 .
      529             end.
      530           if v-cmax = v-cr3  then do:
      531             find last last_code-range no-lock
      532               where recid( last_code-range ) = recid( last-3_code-range )
      533               .
      534           end.
      535         end.
      536         otherwise do:
      537           find last last_code-range no-lock
      538             where last_code-range.range-type = type-code
      539             no-error .
      540         end.
      541       end case.
      542       if not available last_code-range then do:
      543         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      544                                       ,vss-workfile
      545                                       ,vss-revision
      546                                       ,vss-description
      547                                       , chr(10)
      548                                       , type-code
      549                                      ) .
      550       end.
      551       define variable v-mes0 as character no-undo .
      552       define variable v-param-type0 as character no-undo .
      553       define variable v-value-character0 as INTEGER no-undo .
      554       define variable v-value-date0 as date no-undo .
      555       define variable v-value-decimal0 as decimal no-undo .
      556       define variable v-value-integer0 AS integer no-undo .
      557       define variable v-value-logical0 AS LOGICAL no-undo .
      558       define variable v-tth0 as handle no-undo .
      559       run adm/shattri.p (
      560           input "get":U
      561           ,input  'БД':U
      562           ,input  p-db-num
      563           ,input  'code-range':U
      564           ,input  cfg-param-code
      565           ,output v-value-character0
      566           ,output v-value-date0
      567           ,output v-value-decimal0
      568           ,output v-value-integer0
      569           ,output v-value-logical0
      570           ,output v-param-type0
      571           ,INPUT-OUTPUT table-handle v-tth0
      572           ) no-error .
      573       if error-status :error then do:
      574         delete object v-tth0.
      575         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      576                            , error-status:get-message(1)
      577                            , chr(10)
      578                            , return-value ).
      579         undo, return error v-mes0.
      580       end.
      581       delete object v-tth0.
      582       if v-cre-cdrg = TRUE then do:
      583         create buf_code-range .
      584         assign
      585           buf_code-range.db-num     = p-db-num
      586           buf_code-range.range-type = type-code
      587           buf_code-range.stts       = "f"
      588           buf_code-range.first-code = last_code-range.last-code + 1
      589           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      590           v-cre-str = "Свободный диапазон успешно создан"
      591         .
      592       end.
      593       else do:
      594         assign
      595           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      596                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      597         .
      598       end.
      599     end.
      600     return v-cre-str .
      601   end procedure.
      602   procedure gen-new-code-range-if-neces :
      603     define input parameter v-db-num           like ub.db.db-num             no-undo .
      604     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      605     define input parameter v-cur-code         as   integer                  no-undo .
      606     define input parameter v-g#news           as   logical                  no-undo .
      607     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      608     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      609     do
      610     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      611     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      612     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      613     :
      614       define variable l-code-range-exist as logical   no-undo init false .
      615       define variable v-db-for-send      as character no-undo .
      616       define buffer buf_code-range  for ub.code-range .
      617       define buffer buf1_code-range for ub.code-range .
      618       define buffer buf_db          for ub.db .
      619       find first buf_code-range
      620         where buf_code-range.range-type = v-range-type
      621           and buf_code-range.last-code >= v-cur-code
      622         use-index last-codei
      623         no-error .
      624       if
      625       (
      626          available buf_code-range
      627          and
      628         (buf_code-range.db-num = v-db-num
      629           and
      630         buf_code-range.first-code <= v-cur-code
      631         )
      632       or
      633         (
      634           v-range-type = 'drgb':U
      635           AND
      636           v-cur-code = 0
      637         )
      638      )
      639      then do:
      640         assign
      641           l-code-range-exist = true
      642         .
      643         if v-g#news
      644         and buf_code-range.stts = "f" then do:
      645           assign
      646             buf_code-range.stts = "u"
      647           .
      648         end.
      649       end.
      650       if not l-code-range-exist
      651          and v-g#news-source-db <> 0
      652       then do:
      653         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      654                                       ,vss-workfile
      655                                       ,vss-revision
      656                                       ,vss-description
      657                                       ,chr(10)
      658                                       ,v-db-num
      659                                       ,v-range-type
      660                                       ,v-cur-code
      661                                      ).
      662       end.
      663       if (not l-code-range-exist
      664           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      665          )
      666       and ( not can-find (first buf1_code-range no-lock
      667                           where buf1_code-range.db-num = v-db-num
      668                             and buf1_code-range.range-type = v-range-type
      669                             and buf1_code-range.stts = "f"
      670                          )
      671           )
      672       then do:
      673         if v-g#db-num = 0 then do:
      674           run new-bcod-gen-code-range in this-procedure
      675             (input v-db-num,
      676              input v-range-type
      677             ) no-error .
      678           if error-status :error then do:
      679             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      680                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      681                                           ,v-db-num
      682                                           ,v-range-type
      683                                           ,v-cur-code
      684                                           ,chr(10)
      685                                           ,error-status:get-message(1)
      686                                           ,return-value
      687                                          ).
      688           end.
      689         end.
      690         else do:
      691           if v-range-type = 'sclc':U
      692           or v-range-type = 'pglc':U
      693           then do:
      694             assign
      695               v-db-for-send = "":U
      696             .
      697             if v-g#db-num = 0 then do:
      698               for each buf_db no-lock
      699                 where buf_db.db-num > 0
      700                   and buf_db.db-num <> v-g#news-source-db
      701               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      702               :
      703                 assign
      704                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      705                 .
      706               end.
      707               assign
      708                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      709               .
      710             end.
      711             else do:
      712               if not v-g#news then do:
      713                 assign
      714                   v-db-for-send = "0":U
      715                 .
      716               end.
      717             end.
      718             run nws/cr-route.p ( input 'send-cmd':U
      719                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      720                                  "code-range":U + chr(1) +
      721                                  (if v-range-type = 'sclc':U
      722                                   then string( current-value(s-sclc-code, ub))
      723                                   else string( current-value(s-pglc-code, ub))
      724                                   ) + chr(1) +
      725                                   v-range-type)
      726                           ,input ?
      727                           ,input v-db-for-send
      728                           ) no-error .
      729             if error-status :error then do:
      730               undo, return error return-value.
      731             end.
      732           end.
      733         end.
      734       end.
      735     end.
      736   end procedure.
      737   procedure cre-loc-sc-code-range :
      738     define input parameter v-cur-code as integer no-undo .
      739   define input parameter p-cdrg-type as character no-undo .
      740     do
      741     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      742     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      743     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      744     :
      745       define buffer buf_code-range for ub.code-range .
      746       find first buf_code-range
      747            where buf_code-range.range-type = p-cdrg-type
      748              and buf_code-range.first-code >= v-cur-code
      749            no-error .
      750       if not available buf_code-range then do:
      751         run new-bcod-gen-code-range in this-procedure
      752           ( input 0,
      753             input p-cdrg-type
      754           ) no-error .
      755         if error-status :error then do:
      756           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      757                                          + "Код &2&1&3 &4"
      758                                         , chr(10)
      759                                         , v-cur-code
      760                                         , error-status:get-message(1)
      761                                         , return-value
      762                                        ) .
      763         end.
      764       end.
      765     end.
      766   end procedure.
      767   procedure mark-used-if-need :
      768   define input parameter p-cur-code as integer no-undo .
      769   define input parameter p-range-type like ub.code-range.range-type no-undo .
      770   define input parameter p-db-num like ub.code-range.db-num no-undo .
      771     do
      772     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      773     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      774     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      775     :
      776       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      777       define buffer buf_code-range for ub.code-range .
      778       assign
      779       v-db-num = if p-range-type = 'sclc':U
      780                  then 0
      781                  else p-db-num
      782       .
      783   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      784   define buffer locK-batchprocess1 for ub.batchprocess.
      785   run gbl/lock-prc.p
      786       (input 'lscc':U
      787       ,input 0
      788       ,input 0
      789       ,input 0
      790       ,input ""
      791       ,input ""
      792       ,input ""
      793       ,input (
      794               ",,,Вкл/выкл лок. вес. кодов"
      795              )
      796       ,input true
      797       ,buffer lock-batchprocess1
      798       ) no-error .
      799     if error-status :error then do:
      800       message
      801         vss-workfile vss-revision vss-description skip
      802         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      803         view-as alert-box error .
      804       undo, return error .
      805     end.
      806       find first buf_code-range
      807            where buf_code-range.range-type = p-range-type
      808              and buf_code-range.first-code >= p-cur-code
      809              and buf_code-range.last-code <= p-cur-code
      810              and buf_code-range.db-num = v-db-num
      811            no-error .
      812       if not available buf_code-range then do:
      813         message
      814           vss-workfile vss-revision vss-description skip
      815           "Ошибка при создании поиске диапазона" skip
      816           "База данных" p-db-num skip
      817           "Код" p-cur-code skip
      818           "Тип" p-range-type
      819           error-status :get-message(1) skip
      820           return-value skip
      821           view-as alert-box error .
      822         undo, return error .
      823       end.
      824       if buf_code-range.stts = "f":U then do:
      825         assign
      826         buf_code-range.stts = "u":U
      827         .
      828       end.
      829     end.
      830   end procedure.
      831   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   define new global shared variable g#attr-lib  as handle no-undo .
      833   define variable v-attr-lib-variable as handle no-undo .
      834   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      835   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      836   procedure thbjattr_code :
      837      define input  parameter p-upper-code     as character no-undo .
      838      define input  parameter p-code           as character no-undo .
      839      define output parameter p-label          as character no-undo .
      840      define output parameter p-user-can-edit  as logical   no-undo .
      841      define output parameter p-output-display as logical   no-undo .
      842      define output parameter p-other          as character no-undo .
      843      define output parameter p-prop-list      as character no-undo .
      844      define output parameter p-prop-type-list as character no-undo .
      845      define output parameter p-prop-label-list as character no-undo .
      846      define output parameter p-global          as logical no-undo .
      847      define output parameter p-host           as logical no-undo .
      848      define output parameter p-shop           as logical no-undo .
      849      define output parameter p-store          as logical no-undo .
      850      define output parameter p-db             as logical no-undo .
      851      define variable p-region as logical no-undo.
      852      run thbjattr_code_reg in this-procedure (
      853                                               p-upper-code,
      854                                               p-code,
      855                                               output p-label,
      856                                               output p-user-can-edit,
      857                                               output p-output-display,
      858                                               output p-other,
      859                                               output p-prop-list,
      860                                               output p-prop-type-list,
      861                                               output p-prop-label-list,
      862                                               output p-global,
      863                                               output p-host,
      864                                               output p-shop,
      865                                               output p-store,
      866                                               output p-db,
      867                                               output p-region
      868                                               ).
      869   end procedure.
      870   procedure thbjattr_code_reg :
      871   define input  parameter p-upper-code     as character no-undo .
      872   define input  parameter p-code           as character no-undo .
      873   define output parameter p-label          as character no-undo .
      874   define output parameter p-user-can-edit  as logical   no-undo .
      875   define output parameter p-output-display as logical   no-undo .
      876   define output parameter p-other          as character no-undo .
      877   define output parameter p-prop-list      as character no-undo .
      878   define output parameter p-prop-type-list as character no-undo .
      879   define output parameter p-prop-label-list as character no-undo .
      880   define output parameter p-global          as logical no-undo .
      881   define output parameter p-host           as logical no-undo .
      882   define output parameter p-shop           as logical no-undo .
      883   define output parameter p-store          as logical no-undo .
      884   define output parameter p-db             as logical no-undo .
      885   define output parameter p-region         as logical no-undo .
      886   do
      887   on error undo, return error return-value
      888   :
      889       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      890       (input  p-upper-code
      891       ,input  p-code
      892       ,output p-label
      893       ,output p-user-can-edit
      894       ,output p-output-display
      895       ,output p-other
      896       ,output p-prop-list
      897       ,output p-prop-type-list
      898       ,output p-prop-label-list
      899       ,output p-global
      900       ,output p-host
      901       ,output p-shop
      902       ,output p-store
      903       ,output p-db
      904       ,output p-region
      905       ) no-error .
      906     if error-status :error
      907     then do:
      908       undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1)).
      909     end.
      910   end.
      911   end procedure.
