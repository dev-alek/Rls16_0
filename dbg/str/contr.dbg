     2575     if agnt-list <> "" then do:
     2576       find first ub.clients no-lock where RECID(ub.clients) = int (agnt-list) no-error.
     2577       if ub.clients.obj-type <> 'чел':U  then do:
     2578         message
     2579           "Исполнитель может быть только " 'чел':U
