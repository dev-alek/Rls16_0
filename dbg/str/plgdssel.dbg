        1   block-level on error undo, throw.
        2   define  input parameter p-parent-proc as   widget-handle      no-undo .
        3   define  input parameter p-obj-type    like ub.pl-gds.obj-type no-undo .
        4   define  input parameter p-obj-code    like ub.pl-gds.obj-code no-undo .
        5   define  input parameter p-gds-code    like ub.pl-gds.gds-code no-undo .
        6   define output parameter p-pl-code     like ub.pl-gds.pl-code  no-undo .
        7   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile: plgdssel.p $":U .
       11   define variable vss-archive     as character no-undo initial "$Archive: str/plgdssel.p $":U .
       12   define variable vss-description as character no-undo initial "выбор складского места":U .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#lib-trn  as handle no-undo .
       72   define new global shared variable g#lib-trn2 as handle no-undo .
       73   define new global shared variable g#lib-trn3 as handle no-undo .
       74   define new global shared variable g#lib-trn4 as handle no-undo .
       75   define variable v_rid-list as character no-undo .
       76   define variable is-petrol  as logical   no-undo .
       77   define variable is-pieces  as logical   no-undo .
       78   define buffer bf_goods  for ub.goods .
       79   define buffer bf_pl-gds for ub.pl-gds .
       80   assign
       81     p-pl-code = 0
       82   .
       83   find first bf_goods no-lock where
       84              bf_goods.gds-code = p-gds-code no-error .
       85   if not available bf_goods
       86   then do:
       87     message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
       88             "Не найден товар" skip( 0 )
       89             "Первичный бар-код" p-gds-code "." skip( 1 )
       90     view-as alert-box error .
       91     undo, return error .
       92   end.
       93   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
       94     (
       95        input bf_goods.artic
       96     ,  input bf_goods.prod-type
       97     ,  input bf_goods.prod-code
       98     , output is-petrol
       99     , output is-pieces
      100     ) no-error.
      101   if error-status :error
      102   then do:
      103     message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      104             "Ошибка при вызове программы lib-trn_is-petrl" skip( 0 )
      105             error-status :get-message( 1 ) skip( 0 )
      106             return-value skip( 1 )
      107     view-as alert-box error .
      108     undo, return error .
      109   end.
      110   run ref/pl-gdss.w
      111     (  input p-parent-proc
      112     ,  input "b-sel"
      113     ,  input p-obj-type
      114     ,  input p-obj-code
      115     ,  input ( if is-petrol = yes and is-pieces = no then 'топ':U else 'ТОВАР':U )
      116     ,  input recid( bf_goods )
      117     ,  input ?
      118     , output v_rid-list
      119     ) no-error .
      120   if error-status :error
      121   then do:
      122     message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      123             "Ошибка при вызове программы pl-gdss.w" skip( 0 )
      124             error-status :get-message( 1 ) skip( 0 )
      125             return-value skip( 1 )
      126     view-as alert-box error .
      127     undo, return error .
      128   end.
      129   if v_rid-list <> ?    and
      130      v_rid-list <> "":U
      131   then do:
      132     find first bf_pl-gds no-lock where
      133         recid( bf_pl-gds ) = integer( entry( 1, v_rid-list ) ) no-error .
      134     if available bf_pl-gds
      135     then do:
      136       assign
      137         p-pl-code = bf_pl-gds.pl-code
      138       .
      139     end.
      140   end.
