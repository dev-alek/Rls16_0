        1   define input parameter parmode as character no-undo.
        2   define input parameter parnum-tank as CHARACTER no-undo.
        3   define input-output parameter parmeas-label as CHARACTER no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Измерение по резервуару".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   DEFINE BUTTON b-canel AUTO-END-KEY
      114        LABEL "&Отмена"
      115        SIZE 10 BY 1
      116        BGCOLOR 8 .
      117   DEFINE BUTTON b-help
      118        LABEL "Помо&щь"
      119        SIZE 10 BY 1
      120        BGCOLOR 8 .
      121   DEFINE BUTTON b-save AUTO-GO
      122        LABEL "&Ввод"
      123        SIZE 10 BY 1
      124        BGCOLOR 8 .
      125   DEFINE VARIABLE varps AS CHARACTER
      126        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL LARGE
      127        SIZE 42.75 BY 2.58 DROP-TARGET NO-UNDO.
      128   DEFINE VARIABLE varmeas-label AS CHARACTER FORMAT "X(30)"
      129        LABEL "Метка"
      130        VIEW-AS FILL-IN
      131        SIZE 42.88 BY 1 NO-UNDO.
      132   DEFINE VARIABLE varmeas-qnty AS DECIMAL FORMAT "->>>,>>>,>>9.999" INITIAL 0
      133        LABEL "Количество"
      134        VIEW-AS FILL-IN
      135        SIZE 14 BY 1 NO-UNDO.
      136   DEFINE FRAME Dialog-Frame
      137        b-save AT ROW 1 COL 1
      138        b-canel AT ROW 1 COL 11
      139        b-help AT ROW 1 COL 21
      140        varmeas-label AT ROW 2.33 COL 13.5 COLON-ALIGNED
      141        varmeas-qnty AT ROW 3.54 COL 13.63 COLON-ALIGNED
      142        varps AT ROW 4.79 COL 15.63 NO-LABEL
      143        "Примечание" VIEW-AS TEXT
      144             SIZE 11.13 BY .88 AT ROW 5.54 COL 3.88
      145        SPACE(43.73) SKIP(1.11)
      146       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      147            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      148            TITLE "Измерение по резервуару"
      149            DEFAULT-BUTTON b-save CANCEL-BUTTON b-canel.
      150   ASSIGN
      151          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      152          FRAME Dialog-Frame:HIDDEN           = TRUE.
      153   ASSIGN
      154          varps:RETURN-INSERTED IN FRAME Dialog-Frame  = TRUE
      155          varps:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      156   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      157   DO:
      158     APPLY "END-ERROR":U TO SELF.
      159   END.
      160   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      161   DO:
      162     if parmode = 'ДОБАВЛЕНИЕ':U then do:
      163       create auto-tank-meas.
      164       assign
      165          auto-tank-meas.auto-num = auto-tank.auto-num
      166       .
      167     end.
      168     if parmode = 'ДОБАВЛЕНИЕ':U or
      169        parmode = 'ИЗМЕНЕНИЕ':U then do:
      170        assign
      171          auto-tank-meas.meas-label = input frame Dialog-Frame varmeas-label
      172          auto-tank-meas.meas-qnty  = input frame Dialog-Frame varmeas-qnty
      173          auto-tank-meas.ps         = input frame Dialog-Frame varps
      174          parmeas-label = auto-tank-meas.meas-label
      175        .
      176     end.
      177   END.
      178   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      179   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      180   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      181   on help of frame Dialog-Frame
      182   do:
      183     run gbl/app_help.p
      184       (input this-procedure :file-name
      185       ,input ''
      186       ,input ?
      187       ) no-error.
      188     if error-status :error then do:
      189       message
      190         "Ошибка при вызове помощи"
      191         error-status :get-message(1)
      192         view-as alert-box .
      193     end.
      194   end.
      195   run minbtn-set in this-procedure .
      196   on choose of b-help in frame Dialog-Frame
      197   do:
      198     apply "help":u to frame Dialog-Frame .
      199   end.
      200   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   procedure minbtn-set :
      202       do
      203           on error undo, return error return-value
      204           :
      205           define variable ii              as integer       no-undo .
      206           define variable fh              as widget-handle no-undo .
      207           define variable hh              as widget-handle no-undo .
      208           define variable v-h             as handle        extent 4 no-undo .
      209           define variable v-name-button   as character     no-undo .
      210           define variable v-help-old-x    as decimal       no-undo .
      211           define variable v-help-old-y    as decimal       no-undo .
      212           define variable v-help-old-size as decimal       no-undo .
      213           define variable v-frame-width   as decimal       no-undo .
      214           define variable jj              as integer       no-undo .
      215           do
      216               on error undo, return error
      217               :
      218               assign
      219                   v-frame-width = frame Dialog-Frame:width - 0.3
      220                   fh            = frame Dialog-Frame:first-child
      221                   hh            = fh:first-child
      222                   ii            = 1
      223                   .
      224               do while valid-handle(hh):
      225                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      226                   do:
      227                       case lc(hh:name) :
      228                           when "b-help" then
      229                               do:
      230                                   hh:load-image-up("cmp/b-help.bmp":u) .
      231                                   hh:load-image-down("cmp/b-help.bmp":u) .
      232                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      233                                   hh:TOOLTIP = "Помощь" .
      234                                   v-help-old-x = hh:column .
      235                                   v-help-old-y = hh:row    .
      236                                   v-help-old-size = hh:width .
      237                                   hh:width-chars = 2.5 .
      238                               end.
      239                           when "b-print" then
      240                               do:
      241                                   hh:load-image("cmp/b-print.bmp":u) .
      242                                   hh:TOOLTIP = "Печать" .
      243                                   v-h[ii] = hh:handle .
      244                                   ii = ii + 1 .
      245                                   hh:width-chars = 3 .
      246                               end.
      247                           when "b-history" or
      248                           when "b-hist" then
      249                               do:
      250                                   hh:load-image("cmp/b-hist.bmp":u) .
      251                                   hh:TOOLTIP = "История" .
      252                                   v-h[ii] = hh:handle .
      253                                   ii = ii + 1 .
      254                                   hh:width-chars = 3 .
      255                               end.
      256                           when "b-sch" then
      257                               do:
      258                                   hh:load-image("cmp/b-sch.bmp":u) .
      259                                   hh:TOOLTIP = "Установка Фильтра" .
      260                                   v-h[ii] = hh:handle .
      261                                   ii = ii + 1 .
      262                                   hh:width-chars = 3 .
      263                               end.
      264                           when "b-hist-user" then
      265                               do:
      266                                   hh:load-image("cmp/b-hist.bmp":u) .
      267                                   hh:TOOLTIP = "История пользователя" .
      268                                   ii = ii + 1 .
      269                               end.
      270                       end case.
      271                   end.
      272                   hh = hh:next-sibling.
      273               end.
      274               b-help:column = v-frame-width - b-help:width-chars.
      275               jj = 0.
      276               repeat ii = 4 to 1 by -1 :
      277                   if valid-handle (v-h[ii] ) then
      278                   do:
      279                       jj  = jj + 1 .
      280                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      281                       v-h[ii]:row    = v-help-old-y .
      282                   end.
      283               end.
      284           end.
      285       end.
      286   end procedure.
      287   MAIN-BLOCK:
      288   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      289      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      290     if parmode = 'ПРОСМОТР':U then do:
      291       find first auto-tank      where auto-tank.auto-num = parnum-tank no-lock.
      292       find first auto-tank-meas where auto-tank-meas.auto-num = auto-tank.auto-num and auto-tank-meas.meas-label = parmeas-label no-lock.
      293     end.
      294     if parmode = 'ИЗМЕНЕНИЕ':U then do:
      295       do transaction:
      296         find first auto-tank      where auto-tank.auto-num = parnum-tank exclusive-lock.
      297         find first auto-tank-meas where auto-tank-meas.auto-num = auto-tank.auto-num and auto-tank-meas.meas-label = parmeas-label exclusive-lock.
      298       end.
      299     end.
      300     if parmode = 'ДОБАВЛЕНИЕ':U then do:
      301       do transaction:
      302         find first auto-tank      where auto-tank.auto-num = parnum-tank exclusive-lock.
      303       end.
      304     end.
      305     if parmode = 'ПРОСМОТР':U or
      306        parmode = 'ИЗМЕНЕНИЕ':U then do:
      307       assign
      308         varmeas-label  = auto-tank-meas.meas-label
      309         varmeas-qnty   = auto-tank-meas.meas-qnty
      310         varps          = auto-tank-meas.ps.
      311     end.
      312     RUN local-enable_UI.
      313     WAIT-FOR GO OF FRAME Dialog-Frame.
      314   END.
      315   RUN disable_UI.
      316   PROCEDURE disable_UI :
      317     HIDE FRAME Dialog-Frame.
      318   END PROCEDURE.
      319   PROCEDURE enable_UI :
      320     DISPLAY varmeas-label varmeas-qnty varps
      321         WITH FRAME Dialog-Frame.
      322     ENABLE b-canel b-help varps
      323         WITH FRAME Dialog-Frame.
      324     VIEW FRAME Dialog-Frame.
      325   END PROCEDURE.
      326   PROCEDURE local-enable_UI :
      327     RUN enable_ui.
      328     if parmode = 'ДОБАВЛЕНИЕ':U or
      329        parmode = 'ИЗМЕНЕНИЕ':U then do:
      330        enable varmeas-label varmeas-qnty b-save with frame Dialog-Frame.
      331        assign varps:read-only = no.
      332     end.
      333   END PROCEDURE.
