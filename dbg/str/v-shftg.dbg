        1   block-level on error undo, throw.
        2   DEFINE parameter buffer chk-doc for ub.chk-doc.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter par-mode as character no-undo .
        6   DEFINE input parameter shop-code like ub.clients.obj-code no-undo.
        7   DEFINE input parameter shop-type like ub.clients.obj-type no-undo.
        8   DEFINE input parameter v-shft as integer no-undo.
        9   DEFINE input parameter t-shft as integer no-undo.
       10   DEFINE input parameter shift-err as char no-undo.
       11   DEFINE input-output parameter for-chk-type as char no-undo.
       12   DEFINE input-output parameter p-view-log as logical no-undo.
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: v-shftg.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: str/v-shftg.p $":U .
       18   define variable vss-description as character no-undo init "".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   DEFINE buffer for_chk-doc for chk-doc.
       78   define variable choice as integer no-undo.
       79   define variable vrecid as recid no-undo.
       80   define var response as integer no-undo.
       81   define variable log-file-name as character no-undo init "get-chkf.log".
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   FIND FIRST ub.shift-cash NO-LOCK WHERE
       84             ub.shift-cash.obj-code = shop-code AND
       85             ub.shift-cash.obj-type = shop-type AND
       86             ub.shift-cash.cash-num = chk-doc.pay-desk AND
       87             ub.shift-cash.shift-num = chk-doc.shift-num AND
       88             ub.shift-cash.shift-date = chk-doc.shift-date NO-ERROR.
       89   IF AVAIL ub.shift-cash then do:
       90       if ub.shift-cash.sale-date <> chk-doc.shift-date then
       91       assign
       92       chk-doc.shift-date = ub.shift-cash.sale-date.
       93       return.
       94   end.
       95   else do:
       96       if v-shft = 2 then do:
       97           if t-shft <= 0 then v-shft = 1.
       98           else do:
       99               if chk-doc.chk-date = chk-doc.shift-date then do:
      100                 if (chk-doc.chk-time >= t-shft) AND NOT
      101                     can-find(first for_chk-doc No-LOCK WHERE
      102                                   for_chk-doc.obj-type = shop-type AND
      103                                   for_chk-doc.obj-code = shop-code AND
      104                                   for_chk-doc.pay-desk = chk-doc.pay-desk AND
      105                                   for_chk-doc.shift-date = chk-doc.shift-date AND
      106                                   for_chk-doc.shift-num = chk-doc.shift-num AND
      107                                   for_chk-doc.chk-time >= t-shft AND
      108                                   for_chk-doc.chk-date = chk-doc.chk-date AND
      109                                   recid(for_chk-doc) <> recid(chk-doc)) then do:
      110                   response = 1.
      111                 end.
      112                 if chk-doc.chk-time < t-shft then response = 0.
      113               end.
      114               else do:
      115                 if chk-doc.chk-time >= t-shft then do:
      116                   response = -1.
      117                 end.
      118                 else response = -1.
      119               end.
      120               if response >= 0 then do:
      121                   run str/shftccr.p ( input shop-type
      122                                 ,input shop-code
      123                                 ,input chk-doc.pay-desk
      124                                 ,input chk-doc.shift-date
      125                                 ,input chk-doc.shift-num
      126                                 ,input string(chk-doc.shift-num)
      127                                 ,input string(chk-doc.shift-num)
      128                                 ,input chk-doc.chk-time
      129                                 ,input 0
      130                                 ,input 'прием-чек':U
      131                                 ,output vrecid) no-error.
      132                 if response = 1 then do:
      133                   FIND FIRST shift-cash where recid(shift-cash) = vrecid.
      134                   assign
      135                   shift-cash.sale-date = chk-doc.shift-date + 1
      136                   chk-doc.shift-date = shift-cash.sale-date
      137                   .
      138                 end.
      139               end.
      140               else v-shft = 1.
      141           end.
      142       end.
      143       if v-shft = 1 then do:
      144           run gbl/d-askw.w (input "Запрос",
      145                               input ("В соответствии с настройками системы" + chr(10) +
      146                                          "необходимо ввести дату, за которую будут учитываться" + chr(10) +
      147                                          "чеки по кассе " + string(chk-doc.pay-desk) + chr(44) +
      148                                          "пробитые за смену " + string(chk-doc.shift-num) +
      149                                          " - дата " + string(chk-doc.shift-date, "99/99/9999") + chr(10) +
      150                                          "(пришел чек N " + string(chk-doc.chk-num) + " от " +
      151                                          string(chk-doc.chk-date, "99/99/9999") + chr(32) +
      152                                          string(chk-doc.chk-time, "HH:MM") + ")"
      153                                      ),
      154                                input "|",
      155                                input (string(chk-doc.shift-date, "99/99/9999") + "|" +
      156                                          string(chk-doc.shift-date + 1, "99/99/9999") + "|" +
      157                                          "Ошибка"
      158                                          ),
      159                                input "||",
      160                                input 1,
      161                                input 3,
      162                                output choice).
      163           case choice:
      164               when 1 then do:
      165                   run str/shftccr.p (
      166                                  input shop-type
      167                                 ,input shop-code
      168                                 ,input chk-doc.pay-desk
      169                                 ,input chk-doc.shift-date
      170                                 ,input chk-doc.shift-num
      171                                 ,input string(chk-doc.shift-num)
      172                                 ,input string(chk-doc.shift-num)
      173                                 ,input chk-doc.chk-time
      174                                 ,input 0
      175                                 ,input 'прием-чек':U
      176                                 ,output vrecid) no-error.
      177               end.
      178               when 2 then do:
      179                   run str/shftccr.p (
      180                                  input shop-type
      181                                 ,input shop-code
      182                                 ,input chk-doc.pay-desk
      183                                 ,input chk-doc.shift-date
      184                                 ,input chk-doc.shift-num
      185                                 ,input string(chk-doc.shift-num)
      186                                 ,input string(chk-doc.shift-num)
      187                                 ,input chk-doc.chk-time
      188                                 ,input 0
      189                                 ,input 'прием-чек':U
      190                                 ,output vrecid) no-error.
      191                 if error-status:error then do:
      192                   assign
      193                   p-view-log = yes.
      194                   run write-log-and-file in p-log-handle (
      195                         input 1
      196                       , input log-file-name
      197                       , input 1
      198                       , input substitute( "!!!Не определена дата смены(дата учета) для чеков для кассы &1: смена N&2 за &3"
      199                                           , chk-doc.pay-desk
      200                                           , chk-doc.shift-num
      201                                           , string(chk-doc.shift-date, "99/99/9999")
      202                                         )
      203                                                         ).
      204                   undo, return.
      205                 end.
      206                   FIND FIRST shift-cash where recid(shift-cash) = vrecid.
      207                   assign
      208                   shift-cash.sale-date = chk-doc.shift-date + 1
      209                   chk-doc.shift-date = shift-cash.sale-date
      210                   .
      211               end.
      212               when 3 then do:
      213                 assign
      214                 p-view-log = yes.
      215                 run write-log-and-file in p-log-handle (
      216                       input 1
      217                     , input log-file-name
      218                     , input 1
      219                     , input substitute( "!!!Произошла ошибка при попытке создания записи кассовой смены для кассы &1: смена N&2 за &3"
      220                                           , chk-doc.pay-desk
      221                                           , chk-doc.shift-num
      222                                           , string(chk-doc.shift-date, "99/99/9999")
      223                                       )
      224                                                       ).
      225                    assign
      226                     for-chk-type = for-chk-type + shift-err + chr(44)
      227                    chk-doc.shift-date = 01/01/1990.
      228                    return.
      229               end.
      230           END CASE.
      231       end.
      232   end.
