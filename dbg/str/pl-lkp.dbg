        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter v-parts-recid as recid         no-undo .
        3   define variable vss-revision    as character no-undo initial "$Revision$":U .
        4   define variable vss-author      as character no-undo initial "$Author$":U .
        5   define variable vss-date        as character no-undo initial "$Date$":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        7   define variable vss-archive     as character no-undo initial "$Archive$":U .
        8   define variable vss-description as character no-undo initial "редактирование складского места партии":U .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   define shared variable list-mode as character no-undo .
      124   DEFINE BUTTON b-help
      125        LABEL "Помо&щь"
      126        SIZE 10 BY 1.
      127   DEFINE BUTTON b-quit AUTO-GO
      128        LABEL "&Выход "
      129        SIZE 10 BY 1.
      130   DEFINE BUTTON b-spr
      131        IMAGE-UP FILE "btn-down-arrow":U
      132        IMAGE-DOWN FILE "btn-down-arrow":U
      133        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      134        LABEL "":L
      135        SIZE 3 BY .88.
      136   DEFINE VARIABLE pl_code AS INTEGER FORMAT "99999999999":U INITIAL 0
      137        LABEL "&Бар-код"
      138        VIEW-AS FILL-IN
      139        SIZE 17.5 BY 1 NO-UNDO.
      140   DEFINE FRAME d-pl-form
      141        b-quit AT ROW 1.25 COL 2.5
      142        b-help AT ROW 1.25 COL 12.5
      143        pl_code AT ROW 2.83 COL 11.5 COLON-ALIGNED
      144        b-spr AT ROW 2.83 COL 32.25
      145        ub.place.pl-name AT ROW 4.08 COL 11.5 COLON-ALIGNED
      146             VIEW-AS FILL-IN NATIVE
      147             SIZE 41 BY 1
      148        ub.place.loc1 AT ROW 5.33 COL 11.5 COLON-ALIGNED
      149             VIEW-AS FILL-IN NATIVE
      150             SIZE 11.63 BY 1
      151        ub.place.loc2 AT ROW 6.33 COL 11.5 COLON-ALIGNED
      152             VIEW-AS FILL-IN NATIVE
      153             SIZE 11.63 BY 1
      154        ub.place.loc3 AT ROW 7.33 COL 11.5 COLON-ALIGNED
      155             VIEW-AS FILL-IN NATIVE
      156             SIZE 11.63 BY 1
      157        ub.place.loc4 AT ROW 8.33 COL 11.5 COLON-ALIGNED
      158             VIEW-AS FILL-IN NATIVE
      159             SIZE 11.63 BY 1
      160        ub.place.PS AT ROW 9.58 COL 5.5 NO-LABEL
      161             VIEW-AS EDITOR
      162             SIZE 49.25 BY 2.58
      163        SPACE(0.24) SKIP(0.25)
      164       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      165            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      166            TITLE "Складское место".
      167   ASSIGN
      168          FRAME d-pl-form:SCROLLABLE       = FALSE.
      169   ON CHOOSE OF b-spr IN FRAME d-pl-form
      170   DO:
      171     define variable rid-list as character no-undo .
      172     run ref/pl-list.w
      173       ( input        parparentproc
      174       , input        "b-sel"
      175       , input        '':U
      176       , input        0
      177       , input        'все':U
      178       , input-output rid-list
      179       ) .
      180     if rid-list = "cancel"
      181     then do :
      182       return no-apply .
      183     end .
      184     if rid-list <> "":U
      185     then do:
      186       find first ub.place no-lock where
      187           recid( ub.place ) = integer( entry( 1, rid-list ) ) no-error .
      188       if available ub.place
      189       then do:
      190         assign
      191           pl_code = ub.place.pl-code
      192         .
      193         run enable_UI in this-procedure .
      194       end.
      195     end.
      196     apply "ENTRY":U to pl_code in frame d-pl-form.
      197   END.
      198   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-pl-form:PARENT eq ?
      199   THEN FRAME d-pl-form:PARENT = ACTIVE-WINDOW.
      200   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   on help of frame d-pl-form
      202   do:
      203     run gbl/app_help.p
      204       (input this-procedure :file-name
      205       ,input ''
      206       ,input ?
      207       ) no-error.
      208     if error-status :error then do:
      209       message
      210         "Ошибка при вызове помощи"
      211         error-status :get-message(1)
      212         view-as alert-box .
      213     end.
      214   end.
      215   run minbtn-set in this-procedure .
      216   on choose of b-help in frame d-pl-form
      217   do:
      218     apply "help":u to frame d-pl-form .
      219   end.
      220   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      221   procedure minbtn-set :
      222       do
      223           on error undo, return error return-value
      224           :
      225           define variable ii              as integer       no-undo .
      226           define variable fh              as widget-handle no-undo .
      227           define variable hh              as widget-handle no-undo .
      228           define variable v-h             as handle        extent 4 no-undo .
      229           define variable v-name-button   as character     no-undo .
      230           define variable v-help-old-x    as decimal       no-undo .
      231           define variable v-help-old-y    as decimal       no-undo .
      232           define variable v-help-old-size as decimal       no-undo .
      233           define variable v-frame-width   as decimal       no-undo .
      234           define variable jj              as integer       no-undo .
      235           do
      236               on error undo, return error
      237               :
      238               assign
      239                   v-frame-width = frame d-pl-form:width - 0.3
      240                   fh            = frame d-pl-form:first-child
      241                   hh            = fh:first-child
      242                   ii            = 1
      243                   .
      244               do while valid-handle(hh):
      245                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      246                   do:
      247                       case lc(hh:name) :
      248                           when "b-help" then
      249                               do:
      250                                   hh:load-image-up("cmp/b-help.bmp":u) .
      251                                   hh:load-image-down("cmp/b-help.bmp":u) .
      252                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      253                                   hh:TOOLTIP = "Помощь" .
      254                                   v-help-old-x = hh:column .
      255                                   v-help-old-y = hh:row    .
      256                                   v-help-old-size = hh:width .
      257                                   hh:width-chars = 2.5 .
      258                               end.
      259                           when "b-print" then
      260                               do:
      261                                   hh:load-image("cmp/b-print.bmp":u) .
      262                                   hh:TOOLTIP = "Печать" .
      263                                   v-h[ii] = hh:handle .
      264                                   ii = ii + 1 .
      265                                   hh:width-chars = 3 .
      266                               end.
      267                           when "b-history" or
      268                           when "b-hist" then
      269                               do:
      270                                   hh:load-image("cmp/b-hist.bmp":u) .
      271                                   hh:TOOLTIP = "История" .
      272                                   v-h[ii] = hh:handle .
      273                                   ii = ii + 1 .
      274                                   hh:width-chars = 3 .
      275                               end.
      276                           when "b-sch" then
      277                               do:
      278                                   hh:load-image("cmp/b-sch.bmp":u) .
      279                                   hh:TOOLTIP = "Установка Фильтра" .
      280                                   v-h[ii] = hh:handle .
      281                                   ii = ii + 1 .
      282                                   hh:width-chars = 3 .
      283                               end.
      284                           when "b-hist-user" then
      285                               do:
      286                                   hh:load-image("cmp/b-hist.bmp":u) .
      287                                   hh:TOOLTIP = "История пользователя" .
      288                                   ii = ii + 1 .
      289                               end.
      290                       end case.
      291                   end.
      292                   hh = hh:next-sibling.
      293               end.
      294               b-help:column = v-frame-width - b-help:width-chars.
      295               jj = 0.
      296               repeat ii = 4 to 1 by -1 :
      297                   if valid-handle (v-h[ii] ) then
      298                   do:
      299                       jj  = jj + 1 .
      300                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      301                       v-h[ii]:row    = v-help-old-y .
      302                   end.
      303               end.
      304           end.
      305       end.
      306   end procedure.
      307   ON WINDOW-CLOSE OF FRAME d-pl-form APPLY "END-ERROR":U TO SELF.
      308   ON GO OF FRAME d-pl-form
      309   DO:
      310     define variable v-ok as logical no-undo .
      311     define buffer buf_place for ub.place .
      312     if input frame d-pl-form pl_code <> 0
      313     then do:
      314       find first ub.place no-lock where
      315                  ub.place.obj-type = ub.parts.obj-type                 and
      316                  ub.place.obj-code = ub.parts.obj-code                 and
      317                  ub.place.pl-code  = input frame d-pl-form pl_code no-error .
      318       if not available ub.place
      319       then do:
      320         message "На объекте" parts.obj-type parts.obj-code skip( 0 )
      321                 "не существует складского места с кодом" input frame d-pl-form pl_code skip( 0 )
      322                 "Продолжить?" skip( 0 )
      323         view-as alert-box question buttons yes-no update v-ok .
      324         if v-ok <> yes
      325         then do:
      326           return no-apply .
      327         end.
      328       end.
      329     end.
      330     assign
      331       ub.parts.pl-code = input frame d-pl-form pl_code
      332     .
      333   END.
      334   ON RETURN OF pl_code IN FRAME d-pl-form
      335   DO:
      336     apply "CHOOSE":U to b-spr in frame d-pl-form .
      337     return no-apply.
      338   END.
      339   ON END-ERROR, STOP OF FRAME d-pl-form
      340   DO:
      341     apply "CHOOSE":U to b-quit in frame d-pl-form .
      342     return no-apply .
      343   END.
      344   MAIN-BLOCK:
      345   DO
      346   ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      347   ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      348   :
      349     assign
      350       ub.place.PS :read-only = yes
      351     .
      352     find first ub.parts where
      353         recid( ub.parts ) = v-parts-recid no-error .
      354     if not available ub.parts
      355     then do:
      356       message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      357               "Ошибка задания входных параметров" skip( 0 )
      358               "Не найдена партия" skip( 0 )
      359               "Код партии" v-parts-recid skip ( 0 )
      360       view-as alert-box error .
      361       undo, return error return-value .
      362     end.
      363     assign
      364       pl_code = ub.parts.pl-code
      365     .
      366     find first ub.place no-lock where
      367                ub.place.obj-type = parts.obj-type and
      368                ub.place.obj-code = parts.obj-code and
      369                ub.place.pl-code  = parts.pl-code  no-error .
      370     RUN enable_UI in this-procedure .
      371     find first ub.gds-obj no-lock where
      372                ub.gds-obj.obj-type  = ub.parts.obj-type  and
      373                ub.gds-obj.obj-code  = ub.parts.obj-code  and
      374                ub.gds-obj.artic     = ub.parts.artic     and
      375                ub.gds-obj.prod-type = ub.parts.prod-type and
      376                ub.gds-obj.prod-code = ub.parts.prod-code no-error .
      377     if available ub.gds-obj and
      378        ub.gds-obj.place-rsrv = yes
      379     then do:
      380       assign
      381         pl_code :sensitive in frame d-pl-form = no
      382         b-spr   :sensitive in frame d-pl-form = no
      383       .
      384     end.
      385     frame d-pl-form :title = substitute( 'Складское место на объекте : &1 &2 '
      386                                            , ub.parts.obj-type
      387                                            , ub.parts.obj-code
      388                                            ) .
      389     wait-for go of frame d-pl-form focus pl_code.
      390   END.
      391   run disable_UI in this-procedure .
      392   PROCEDURE disable_UI :
      393     HIDE FRAME d-pl-form.
      394   END PROCEDURE.
      395   PROCEDURE enable_UI :
      396     DISPLAY pl_code
      397         WITH FRAME d-pl-form.
      398     IF AVAILABLE ub.place THEN
      399       DISPLAY ub.place.pl-name ub.place.loc1 ub.place.loc2 ub.place.loc3
      400             ub.place.loc4 ub.place.PS
      401         WITH FRAME d-pl-form.
      402     ENABLE b-quit b-help pl_code b-spr
      403         WITH FRAME d-pl-form.
      404   END PROCEDURE.
