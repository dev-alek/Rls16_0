      624     assign
      625      price-cli-with-tax-lococl = out-vatp_partscl.price-cli
      626      cli-base-rateocl          = out-vatp_partscl.cli-base-rate.
      627     ASSIGN   road-tax-base-lococl  = (if out-vatp_partscl.road-tax-base  = ? then 0 else out-vatp_partscl.road-tax-base)
