     1753     (input  bf_trn-doc.obj-type
     1754     ,input  bf_trn-doc.obj-code
     1755     ,input  varb-code
     1756     ,input  0
     1757     ,input  bf_trn-doc.fact-order
     1758     ,output vardoc-num
     1759     ,output varprice-sale
     1760     ,output varroad-tax
     1761     ,output varexcise
     1762     )  .
     1763             if varprice-sale = ?
     1764             then do:
     1765               assign
     1766                 varprice-sale = 0
     1767                 varroad-tax   = 0
     1768                 varexcise     = 0
     1769               .
     1770             end.
     1771             assign
     1772               varlastcur-base     = varprice-sale
     1773               varlastcur-road-tax = varroad-tax
     1774               varlastcur-excise   = varexcise
     1775               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     1776               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     1777               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     1778               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     1779             .
     1780         end.
     1781       end.
     1782       if varcur-fact-qnty = 0 then do:
     1783         assign
     1784           varcur-base      = varlastcur-base
     1785           varcur-road-tax  = varlastcur-road-tax
     1786           varcur-excise    = varlastcur-excise
     1787         .
     1788       end.
     1789       else do:
     1790         assign
     1791           varcur-base      = varcur-base      / varcur-fact-qnty
     1792           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     1793           varcur-excise    = varcur-excise    / varcur-fact-qnty
     1794         .
     1795       end.
     1796       if varcur-vat-pc = ?
     1797       then do:
     1798         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1799       end.
     1800       if varcur-slt-pc = ?
