      424   do on error undo, return error return-value :
      425   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
      426   for each bf_tt-allsum on error undo, return error return-value :
      427     delete bf_tt-allsum.
