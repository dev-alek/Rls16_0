     1892   procedure clcprtsl_calc-ttable :
     1893   define input parameter paris-doc           as   logical                 no-undo.
     1894   define input parameter paris-cur           as   logical                 no-undo.
     1895   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     1896   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     1897   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     1898   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     1899   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     1900   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     1901   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     1902   define input parameter parr-b              as   character               no-undo.
     1903   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     1904   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     1905   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     1906   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     1907   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     1908   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     1909   define buffer bf_tt-allsum      for tt-allsum.
     1910   define buffer bf_tt-clcparts    for tt-clcparts.
     1911   define buffer bf_tt-allsum-line for tt-allsum-line.
     1912   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1913   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1914   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1915   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1916   define variable varexcise          like ub.price-list.excise     no-undo.
     1917   do on error undo, return error return-value :
     1918   for each bf_tt-allsum-line
     1919   on error undo, return error return-value
     1920    :
     1921     delete bf_tt-allsum-line.
     1922   end.
     1923   for each bf_tt-allsum
     1924   on error undo, return error return-value
     1925   :
     1926     delete bf_tt-allsum.
     1927   end.
     1928   for each bf_tt-clcparts
     1929   on error undo, return error return-value
     1930   :
     1931   if v-calcbypart then do:
     1932             assign
     1933             parcur-base =   bf_tt-clcparts.part-cur-base
     1934             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     1935             parcur-excise =   bf_tt-clcparts.part-cur-excise
     1936             .
     1937   end.
     1938      run clcprtsl_calc-parts in this-procedure (
     1939        input recid(bf_tt-clcparts),
     1940        input paris-doc,
     1941        input paris-cur,
     1942        input parroad-tax,
     1943        input parexcise,
     1944        input parvat-pc,
     1945        input parcons-vat-pc,
     1946        input parslt-pc,
     1947        input parbase-rate,
     1948        input parbase-scale,
     1949        input parr-b,
     1950        input parcur-base,
     1951        input parcur-road-tax,
     1952        input parcur-excise,
     1953        input parcur-vat-pc,
     1954        input parcurcons-vat-pc,
     1955        input parcurslt-pc
     1956        ) no-error.
     1957     if error-status:error then do:
     1958       message
     1959         vss-workfile vss-revision vss-description skip
     1960         vss-include-info0 skip
     1961         "Ошибка при обсчете партии" skip
     1962         "Документ партии " bf_tt-clcparts.out-code skip
     1963         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     1964         return-value skip
     1965         error-status:get-message(1) skip
     1966         error-status:get-message(2) skip
     1967         error-status:get-message(3) skip
     1968         view-as alert-box error .
     1969       undo, return error .
     1970     end.
     1971     for each bf_tt-allsum on error undo, return error return-value :
     1972       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     1973       if not available bf_tt-allsum-line then do:
     1974         create bf_tt-allsum-line.
     1975         assign
     1976           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     1977       end.
     1978       assign
     1979         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     1980         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     1981         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     1982         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     1983         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     1984         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     1985         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     1986         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     1987         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     1988         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     1989         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     1990         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     1991         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     1992         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     1993         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     1994         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     1995         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     1996         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     1997         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     1998         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     1999         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     2000         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     2001         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     2002         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     2003         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
