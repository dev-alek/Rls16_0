     1420       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     1421       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     1422       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     1423       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     1424       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     1425       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     1426       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     1427       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1428       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     1429       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     1430       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     1431       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     1432       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     1433       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     1434       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     1435       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     1436       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     1437       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     1438       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     1439       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     1440       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     1441       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     1442       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     1443       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     1444       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     1445       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     1446       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     1447       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     1448       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     1449       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     1450       .
     1451   end.
     1452   otherwise do:
     1453     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     1454                              cl_tt-clcparts.purch-code,
     1455                              cl_tt-clcparts.part-code,
     1456                              cl_tt-clcparts.out-code,
     1457                              cl_tt-clcparts.in-code,
     1458                              cl_tt-clcparts.artic,
     1459                              cl_tt-clcparts.prod-type,
     1460                              cl_tt-clcparts.prod-code).
     1461   end.
     1462   end case.
     1463   end.
     1464   end procedure.
     1465   procedure clcprtsl_calc-line :
     1466   define input  parameter parrec-line as recid no-undo.
     1467   define variable v-tax-date         as   date                     no-undo.
     1468   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1469   define variable varr-b             as   character                no-undo.
     1470   define variable varr-btype         as   character                no-undo.
     1471   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1472   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1473   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1474   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1475   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1476   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1477   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1478   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1479   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1480   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1481   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1482   define variable varexcise          like ub.price-list.excise     no-undo.
     1483   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1484   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1485   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1486   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1487   define variable v-varsum           as decimal                  no-undo.
     1488   define variable varprice-salef as decimal   no-undo .
     1489   define buffer bf_trn-doc             for ub.trn-doc.
     1490   define buffer bf_doc-line            for ub.doc-line.
     1491   define buffer bf_gds-dtl             for ub.gds-dtl.
     1492   define buffer bf_goods               for ub.goods.
     1493   define buffer bf_parts               for ub.parts.
     1494   define buffer bf_sysconf             for ub.sysconf.
     1495   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1496   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1497   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1498   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1499   define buffer buf_parts        for ub.parts.
     1500   v-calcbypart = no.
     1501   do on error undo, return error return-value :
     1502   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1503   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1504     (output varr-b
     1505     )  .
     1506     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1507     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1508     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1509                               bf_goods.prod-type = bf_doc-line.prod-type and
     1510                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1511     if bf_trn-doc.fact-date <> ?        then do:
     1512       assign v-tax-date = bf_trn-doc.fact-date.
     1513     end.
     1514     else do:
     1515       assign v-tax-date = ?.
     1516     end.
     1517   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1518   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1519     (input  bf_goods.gds-code
     1520     ,input  '1':U
     1521     ,input  v-tax-date
     1522     ,input  bf_trn-doc.host-code
     1523     ,input  bf_trn-doc.obj-type
     1524     ,input  bf_trn-doc.obj-code
     1525     ,output v-vat-pc
     1526     ) no-error .
     1527     if error-status :error
     1528     or v-vat-pc = ? then do:
     1529        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1530     end.
     1531     if bf_goods.gds-type = 'у':U or
     1532        bf_trn-doc.status_ = 'запрос':U then do:
     1533       for each bf_tt-allsum-line
     1534       on error undo, return error return-value
     1535        :
     1536         delete bf_tt-allsum-line.
     1537       end.
     1538       create bf_tt-allsum-line.
     1539       assign
     1540        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1541       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1542                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1543                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1544                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1545         assign
     1546           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1547           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1548           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1549           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1550           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1551           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1552           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1553           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1554           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1555           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1556           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1557           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1558           bf_tt-allsum-line.vat-cli-acc          =  ?
     1559           .
     1560       end.
     1561       assign
     1562         bf_tt-allsum-line.cli-qnty             =  ?
     1563         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1564         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1565         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1566         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1567         bf_tt-allsum-line.road-tax-base-doc    =  0
     1568         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1569         bf_tt-allsum-line.excise-base-doc      =  0
     1570         bf_tt-allsum-line.excise-rubl-doc      =  0
     1571         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     1572         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     1573         bf_tt-allsum-line.dsc-base-cur         =  0
     1574         bf_tt-allsum-line.dsc-rubl-cur         =  0
     1575         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1576         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1577         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1578         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1579         bf_tt-allsum-line.road-tax-base-cur    =  0
     1580         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     1581         bf_tt-allsum-line.excise-base-cur      =  0
     1582         bf_tt-allsum-line.excise-rubl-cur      =  0
     1583         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     1584         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     1585         bf_tt-allsum-line.dsc-base-acc         =  0
     1586         bf_tt-allsum-line.dsc-rubl-acc         =  0
     1587         bf_tt-allsum-line.dsc-cli-acc          =  0
     1588         bf_tt-allsum-line.slt-base-acc         =  0
     1589         bf_tt-allsum-line.slt-rubl-acc         =  0
     1590         bf_tt-allsum-line.slt-cli-acc          =  0
     1591         bf_tt-allsum-line.road-tax-base-acc    =  0
     1592         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     1593         bf_tt-allsum-line.road-tax-cli-acc     =  0
     1594         bf_tt-allsum-line.excise-base-acc      =  0
     1595         bf_tt-allsum-line.excise-rubl-acc      =  0
     1596         bf_tt-allsum-line.excise-cli-acc       =  0
     1597         bf_tt-allsum-line.transport-base-acc   =  0
     1598         bf_tt-allsum-line.transport-rubl-acc   =  0
     1599         bf_tt-allsum-line.transport-cli-acc    =  0
     1600         bf_tt-allsum-line.other-base-acc       =  0
     1601         bf_tt-allsum-line.other-rubl-acc       =  0
     1602         bf_tt-allsum-line.other-cli-acc        =  0
     1603         .
     1604       create bfs_tt-allsum-line.
     1605       assign
     1606       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     1607       if bf_trn-doc.doc-type = 'инв':U or
     1608          bf_trn-doc.doc-type = 'при':U    or
     1609          bf_trn-doc.doc-type = 'возврат':U    then do:
     1610          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     1611       end.
     1612       else do:
     1613         assign
     1614           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     1615           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     1616           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     1617           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     1618           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     1619           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     1620           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     1621           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     1622           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     1623           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     1624           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     1625           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     1626           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     1627           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     1628           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     1629           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     1630           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     1631           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     1632           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     1633           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     1634           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     1635           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     1636           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     1637           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     1638           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     1639           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     1640           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     1641           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     1642           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     1643           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     1644           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     1645           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     1646           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     1647           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     1648           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     1649           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     1650           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     1651           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     1652           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     1653           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     1654           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     1655           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     1656           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
