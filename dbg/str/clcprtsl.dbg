      429   assign
      430     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
      431     price-base-with-tax-loccl = cl_tt-clcparts.price-base
      432   .
      433   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      435     (output varinvprbcl
      436     )  .
      437     if cl_tt-clcparts.out-code = 'free-zone':U     or
      438        cl_tt-clcparts.out-code = 'out-zone':U   or
      439        cl_tt-clcparts.doc-type = 'акт':U then do:
      440       assign
      441         in-vatp-have-vat-sltcl = yes.
      442     end.
      443     else do:
      444       find first in-vatp_doc-attrcl no-lock
      445         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
      446           and in-vatp_doc-attrcl.attr-code = 'envd':U
      447         no-error .
      448       if not available in-vatp_doc-attrcl then do:
      449         assign
      450           in-vatp-have-vat-sltcl = yes.
      451       end.
      452       else do:
      453            in-vatp-have-vat-sltcl = no.
      454       end.
      455     end.
      456     assign
      457      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
      458      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
      459     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
      460              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
      461     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
      462             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
      463             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
      464             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
      465             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
      466             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
      467             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      468       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      469     assign
      470       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
      471     assign
      472       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
      473       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
      474       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
      475       transport-cli-loccl  = 0
      476       other-cli-loccl      = 0
      477     .
      478   ASSIGN
      479             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
      480       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
      481   .
      482   if paris-doc then do:
      483     assign
      484       parartic     = cl_tt-clcparts.artic
      485       parprod-type = cl_tt-clcparts.prod-type
