      580              out-vatp_doc-linecl.doc-code   = pardoc-code
      581          and out-vatp_doc-linecl.artic      = parartic
      582          and out-vatp_doc-linecl.prod-type  = parprod-type
      583          and out-vatp_doc-linecl.prod-code  = parprod-code no-lock no-error.
      584   if available out-vatp_doc-linecl           and
      585     (out-vatp_doc-linecl.status_ = 'запрос':U or out-vatp_goodscl.gds-type = 'у':U) then do:
      586     assign
