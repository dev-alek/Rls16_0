     2037   end procedure.
     2038   define output parameter proc-hndl  as handle no-undo .
     2039   do:
     2040     proc-hndl = this-procedure.
     2041   end.
     2042   procedure clcprtsl_calc-parts-inkaps:
     2043     define input-output parameter table for tt-clcparts.
     2044     define input-output parameter table for tt-allsum.
     2045     define input parameter paris-doc           as   logical                 no-undo.
     2046     define input parameter paris-cur           as   logical                 no-undo.
     2047     define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2048     define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2049     define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2050     define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2051     define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2052     define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2053     define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2054     define input parameter parr-b              as   character               no-undo.
     2055     define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2056     define input parameter parcurroad-tax      like ub.doc-line.road-tax    no-undo.
     2057     define input parameter parcurexcise        like ub.doc-line.excise      no-undo.
     2058     define input parameter parcurvat-pc        like ub.doc-line.vat-pc      no-undo.
     2059     define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2060     define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2061     DEFINE BUFFER bf-loc-plus_doc-line FOR ub.doc-line.
     2062     define variable parrec-parts as recid no-undo.
     2063     find first tt-clcparts.
     2064     parrec-parts = recid( tt-clcparts ).
     2065     run clcprtsl_calc-parts (
     2066                                             input parrec-parts
     2067                                           , input yes
     2068                                           , input no
     2069                                           , input parroad-tax
     2070                                           , input parexcise
     2071                                           , input parvat-pc
     2072                                           , input parcons-vat-pc
     2073                                           , input parslt-pc
     2074                                           , input parbase-rate
     2075                                           , input parbase-scale
     2076                                           , input parr-b
     2077                                           , input parcur-base
     2078                                           , input parcurroad-tax
     2079                                           , input parcurexcise
     2080                                           , input parcurvat-pc
     2081                                           , input parcurcons-vat-pc
     2082                                           , input parcurslt-pc
     2083                                       ).
     2084   end.
