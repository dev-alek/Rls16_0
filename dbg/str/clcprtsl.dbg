      495   end.
      496   else do:
      497     find first out-vatp_doc-attrcl no-lock
      498       where out-vatp_doc-attrcl.doc-code  = pardoc-code
      499         and out-vatp_doc-attrcl.attr-code = 'envd':U
      500         no-error .
      501     if not available out-vatp_doc-attrcl then do:
      502       assign
      503         out-vatp-have-vat-sltcl = yes.
      504     end.
      505     else do:
      506        out-vatp-have-vat-sltcl = no.
      507     end.
