      509   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
      510                                      out-vatp_goodscl.prod-type = parprod-type and
      511                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
      512   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      513   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      514     (input  parartic
      515     ,input  parprod-type
      516     ,input  parprod-code
      517     ,output varroot-nodecl
      518     ) no-error .
      519   if error-status :error then do:
      520     message
      521       vss-workfile vss-revision vss-description skip
