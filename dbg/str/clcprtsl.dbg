     1819           and bf_parts.obj-code  = bf_doc-line.obj-code
     1820           and bf_parts.artic     = bf_doc-line.artic
     1821           and bf_parts.prod-type = bf_doc-line.prod-type
     1822           and bf_parts.prod-code = bf_doc-line.prod-code
     1823       on error undo, return error return-value
     1824       :
