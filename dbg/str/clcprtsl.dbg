      591                                  and out-vatp_partscl.obj-type   = parobj-type
      592                                  and out-vatp_partscl.obj-code   = parobj-code
      593                                  and out-vatp_partscl.artic      = parartic
      594                                  and out-vatp_partscl.prod-type  = parprod-type
      595                                  and out-vatp_partscl.prod-code  = parprod-code no-lock :
