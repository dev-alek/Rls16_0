        1   DEFINE INPUT PARAMETER pardoc-code LIKE ub.trn-doc.doc-code NO-UNDO.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Экран просмотра платежей по складскому документу".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   DEFINE TEMP-TABLE tt-fo NO-UNDO LIKE ub.fin-ob
      112   FIELD sum-base-trn LIKE ub.fin-ob.sum-base
      113   FIELD sum-rubl-trn LIKE ub.fin-ob.sum-rubl.
      114   DEFINE TEMP-TABLE tt-fd NO-UNDO LIKE ub.fin-doc
      115   FIELD sum-base-fo LIKE ub.fin-doc.sum-base
      116   FIELD sum-rubl-fo LIKE ub.fin-doc.sum-rubl.
      117   DEFINE BUFFER bf_trn-doc      FOR ub.trn-doc.
      118   DEFINE BUFFER bf_fin-connect  FOR ub.fin-connect.
      119   DEFINE BUFFER bf_parts        FOR ub.parts.
      120   DEFINE BUFFER bf_fin-gds-part FOR ub.fin-gds-part.
      121   DEFINE BUFFER bf_goods        FOR ub.goods.
      122   DEFINE BUTTON b-exit AUTO-GO
      123        LABEL "&Выход"
      124        SIZE 10 BY 1
      125        BGCOLOR 8 .
      126   DEFINE BUTTON b-help
      127        LABEL "&Помощь"
      128        SIZE 10 BY 1
      129        BGCOLOR 8 .
      130   DEFINE QUERY b-fin-doc FOR
      131         tt-fd SCROLLING.
      132   DEFINE QUERY b-fin-ob FOR
      133         tt-fo,
      134         bf_fin-connect SCROLLING.
      135   DEFINE QUERY b-parts FOR
      136         bf_fin-gds-part,
      137         bf_goods,
      138         bf_parts SCROLLING.
      139   DEFINE BROWSE b-fin-doc
      140     QUERY b-fin-doc DISPLAY
      141         tt-fd.prn-doc-code COLUMN-LABEL "Платеж"
      142    tt-fd.contract-code COLUMN-LABEL "Договор"
      143    tt-fd.sum-base FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма платежа (вал)"
      144    tt-fd.sum-base-fo FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма связей c ФО (вал)"
      145    tt-fd.sum-rubl FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма платежа (abbr_rub)"
      146    tt-fd.sum-rubl-fo FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма связей С ФО (abbr_rub)"
      147    tt-fd.fin-doc-code COLUMN-LABEL "Вн. код платежа"
      148       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6
      149            TITLE "Платежи".
      150   DEFINE BROWSE b-fin-ob
      151     QUERY b-fin-ob DISPLAY
      152         tt-fo.prn-doc-code COLUMN-LABEL "Фин. обяз."
      153    tt-fo.sum-base FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Общая сумма (вал)"
      154    bf_fin-connect.sum-base FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма связи (вал)"
      155    tt-fo.sum-base-trn FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма по док. (вал)"
      156    tt-fo.sum-rubl FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Общая сумма (abbr_rub)"
      157    bf_fin-connect.sum-rubl FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма связи (abbr_rub)"
      158    tt-fo.sum-rubl-trn FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма по док. (abbr_rub)"
      159    tt-fo.doc-code COLUMN-LABEL "Вн. код. фин. обяз."
      160       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6
      161            TITLE "Финансовые обязательства, связанные с платежом".
      162   DEFINE BROWSE b-parts
      163     QUERY b-parts DISPLAY
      164         bf_parts.in-code COLUMN-LABEL "Прих. накл."
      165    bf_parts.part-code FORMAT "x(13)" COLUMN-LABEL "Код партии"
      166    bf_parts.fact-qnty  COLUMN-LABEL "Факт кол-во"
      167    bf_parts.price-base COLUMN-LABEL "Цена (вал)"
      168    bf_parts.price-rubl COLUMN-LABEL "Цена (abbr_rub)"
      169       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6
      170            TITLE "Партии по финансовому обязательству".
      171   DEFINE FRAME Dialog-Frame
      172        b-exit AT ROW 1 COL 1
      173        b-help AT ROW 1 COL 11
      174        b-fin-doc AT ROW 2.25 COL 1
      175        b-fin-ob AT ROW 8.54 COL 1
      176        b-parts AT ROW 14.83 COL 1
      177        SPACE(0.00) SKIP(0.16)
      178       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      179            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      180            TITLE "Платежи, связанные со складским документом"
      181            DEFAULT-BUTTON b-exit.
      182   ASSIGN
      183          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      184          FRAME Dialog-Frame:HIDDEN           = TRUE.
      185   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      186   DO:
      187     APPLY "END-ERROR":U TO SELF.
      188   END.
      189   ON VALUE-CHANGED OF b-fin-doc IN FRAME Dialog-Frame
      190   DO:
      191     RUN open-query-fo IN THIS-PROCEDURE.
      192     RUN open-parts-query IN THIS-PROCEDURE.
      193   END.
      194   ON VALUE-CHANGED OF b-fin-ob IN FRAME Dialog-Frame
      195   DO:
      196     RUN open-parts-query IN THIS-PROCEDURE.
      197   END.
      198   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      199   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      200   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   on help of frame Dialog-Frame
      202   do:
      203     run gbl/app_help.p
      204       (input this-procedure :file-name
      205       ,input ''
      206       ,input ?
      207       ) no-error.
      208     if error-status :error then do:
      209       message
      210         "Ошибка при вызове помощи"
      211         error-status :get-message(1)
      212         view-as alert-box .
      213     end.
      214   end.
      215   run minbtn-set in this-procedure .
      216   on choose of b-help in frame Dialog-Frame
      217   do:
      218     apply "help":u to frame Dialog-Frame .
      219   end.
      220   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      221   procedure minbtn-set :
      222       do
      223           on error undo, return error return-value
      224           :
      225           define variable ii              as integer       no-undo .
      226           define variable fh              as widget-handle no-undo .
      227           define variable hh              as widget-handle no-undo .
      228           define variable v-h             as handle        extent 4 no-undo .
      229           define variable v-name-button   as character     no-undo .
      230           define variable v-help-old-x    as decimal       no-undo .
      231           define variable v-help-old-y    as decimal       no-undo .
      232           define variable v-help-old-size as decimal       no-undo .
      233           define variable v-frame-width   as decimal       no-undo .
      234           define variable jj              as integer       no-undo .
      235           do
      236               on error undo, return error
      237               :
      238               assign
      239                   v-frame-width = frame Dialog-Frame:width - 0.3
      240                   fh            = frame Dialog-Frame:first-child
      241                   hh            = fh:first-child
      242                   ii            = 1
      243                   .
      244               do while valid-handle(hh):
      245                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      246                   do:
      247                       case lc(hh:name) :
      248                           when "b-help" then
      249                               do:
      250                                   hh:load-image-up("cmp/b-help.bmp":u) .
      251                                   hh:load-image-down("cmp/b-help.bmp":u) .
      252                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      253                                   hh:TOOLTIP = "Помощь" .
      254                                   v-help-old-x = hh:column .
      255                                   v-help-old-y = hh:row    .
      256                                   v-help-old-size = hh:width .
      257                                   hh:width-chars = 2.5 .
      258                               end.
      259                           when "b-print" then
      260                               do:
      261                                   hh:load-image("cmp/b-print.bmp":u) .
      262                                   hh:TOOLTIP = "Печать" .
      263                                   v-h[ii] = hh:handle .
      264                                   ii = ii + 1 .
      265                                   hh:width-chars = 3 .
      266                               end.
      267                           when "b-history" or
      268                           when "b-hist" then
      269                               do:
      270                                   hh:load-image("cmp/b-hist.bmp":u) .
      271                                   hh:TOOLTIP = "История" .
      272                                   v-h[ii] = hh:handle .
      273                                   ii = ii + 1 .
      274                                   hh:width-chars = 3 .
      275                               end.
      276                           when "b-sch" then
      277                               do:
      278                                   hh:load-image("cmp/b-sch.bmp":u) .
      279                                   hh:TOOLTIP = "Установка Фильтра" .
      280                                   v-h[ii] = hh:handle .
      281                                   ii = ii + 1 .
      282                                   hh:width-chars = 3 .
      283                               end.
      284                           when "b-hist-user" then
      285                               do:
      286                                   hh:load-image("cmp/b-hist.bmp":u) .
      287                                   hh:TOOLTIP = "История пользователя" .
      288                                   ii = ii + 1 .
      289                               end.
      290                       end case.
      291                   end.
      292                   hh = hh:next-sibling.
      293               end.
      294               b-help:column = v-frame-width - b-help:width-chars.
      295               jj = 0.
      296               repeat ii = 4 to 1 by -1 :
      297                   if valid-handle (v-h[ii] ) then
      298                   do:
      299                       jj  = jj + 1 .
      300                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      301                       v-h[ii]:row    = v-help-old-y .
      302                   end.
      303               end.
      304           end.
      305       end.
      306   end procedure.
      307   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      308   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      309   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      310   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      311   define variable v-diasize-current-frame-width  as decimal   no-undo .
      312   define variable v-diasize-current-frame-height as decimal   no-undo .
      313   define variable v-diasize-change-size          as logical   no-undo .
      314   define variable v-diasize-resize-button        as handle    no-undo .
      315   define variable v-diasize-wndmax               as logical   no-undo .
      316   define variable v-diasize-wndstore             as logical   no-undo .
      317   define variable v-diasize-proc-name            as character no-undo .
      318   define variable v-diasize-browse-handle        as handle    no-undo .
      319   define variable v-diasize-browse-number        as integer   no-undo .
      320   define variable v-diasize-need-full-display    as logical   no-undo init false .
      321   define temp-table temp-diasize-handle no-undo
      322     field handle-value  as handle
      323     field save-position as decimal
      324     index xpk is primary unique handle-value
      325     .
      326   define temp-table temp-browse-handle no-undo
      327     field browse-type   as character
      328     field browse-number as integer
      329     field browse-handle as handle
      330     field original-size as decimal
      331     index xpk is primary unique browse-type browse-number
      332     index xie browse-type browse-handle
      333   .
      334   procedure diasize_change-height :
      335     define input  parameter p-change-value  as decimal   no-undo .
      336     define input  parameter p-move-resize   as logical   no-undo .
      337     define variable v-field-group-handle    as handle    no-undo .
      338     define variable v-object-handle         as handle    no-undo .
      339     define variable v-frame-height          as decimal   no-undo .
      340     define variable v-frame-virtual-height  as decimal   no-undo .
      341     define variable v-browse-height         as decimal   no-undo .
      342     define variable v-window-height         as decimal   no-undo .
      343     define variable v-window-virtual-height as decimal   no-undo .
      344     define variable v-change-sign           as integer   no-undo .
      345     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      346     define buffer buf_temp-browse-handle  for temp-browse-handle .
      347     if p-change-value > 0
      348     then do:
      349       if frame Dialog-Frame :height + p-change-value
      350           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      351       then do:
      352         assign
      353           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      354                           - (frame Dialog-Frame :height-chars)
      355         .
      356         if p-change-value <= 0
      357         then do:
      358           run diasize_position-resize-button in this-procedure .
      359           return .
      360         end.
      361       end.
      362     end.
      363     if p-change-value < 0
      364     then do:
      365       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      366       then do:
      367         assign
      368           p-change-value = v-diasize-orig-frame-height
      369                          - (frame Dialog-Frame :height-chars)
      370         .
      371         if p-change-value >= 0
      372         then do:
      373           run diasize_position-resize-button in this-procedure .
      374           return .
      375         end.
      376       end.
      377     end.
      378     if p-change-value >= 0
      379     then do:
      380       assign
      381         v-change-sign = 1
      382       .
      383     end.
      384     else do:
      385       assign
      386         v-change-sign = -1
      387       .
      388     end.
      389     assign
      390       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      391     .
      392     if p-change-value = 0
      393     then do:
      394       run diasize_position-resize-button in this-procedure .
      395       return .
      396     end.
      397     move_block:
      398     do
      399     on error undo move_block, retry move_block
      400     :
      401       if retry
      402       then do:
      403         do
      404         on error undo move_block, leave move_block
      405         :
      406           if p-change-value > 0
      407           then do:
      408             for each buf_temp-diasize-handle
      409             on error undo, next
      410             :
      411               assign
      412                 v-object-handle = buf_temp-diasize-handle.handle-value
      413               .
      414               if v-object-handle <> v-diasize-resize-button
      415               then do:
      416                 assign
      417                   v-object-handle :row = buf_temp-diasize-handle.save-position
      418                 .
      419               end.
      420             end.
      421             assign
      422               v-diasize-browse-handle :height = v-browse-height
      423             .
      424             for each buf_temp-browse-handle
      425               where buf_temp-browse-handle.browse-type = 'height':u
      426             on error undo, next
      427             :
      428               assign
      429                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      430               .
      431             end.
      432             assign
      433               frame Dialog-Frame :height = v-frame-height
      434             .
      435             if frame Dialog-Frame :scrollable = true
      436             then do:
      437               assign
      438                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      439               .
      440             end.
      441             run diasize_position-resize-button in this-procedure .
      442           end.
      443           else do:
      444             if frame Dialog-Frame :scrollable = true
      445             then do:
      446               assign
      447                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      448               .
      449             end.
      450             assign
      451               frame Dialog-Frame :height = v-frame-height
      452             .
      453             assign
      454               v-diasize-browse-handle :height = v-browse-height
      455             .
      456             for each buf_temp-browse-handle
      457               where buf_temp-browse-handle.browse-type = 'height':u
      458             on error undo, next
      459             :
      460               assign
      461                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      462               .
      463             end.
      464             for each buf_temp-diasize-handle
      465             on error undo, next
      466             :
      467               assign
      468                 v-object-handle = buf_temp-diasize-handle.handle-value
      469               .
      470               if v-object-handle <> v-diasize-resize-button
      471               then do:
      472                 assign
      473                   v-object-handle :row = buf_temp-diasize-handle.save-position
      474                 .
      475               end.
      476             end.
      477             run diasize_position-resize-button in this-procedure .
      478           end.
      479           assign
      480             v-diasize-change-size = false
      481           .
      482           leave move_block .
      483         end.
      484       end.
      485       assign
      486         v-diasize-need-full-display = true
      487       .
      488       if v-diasize-change-size = false
      489       then do:
      490         assign
      491           v-diasize-change-size = true
      492         .
      493       end.
      494       else do:
      495         return .
      496       end.
      497       assign
      498         v-frame-height = frame Dialog-Frame :height
      499         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      500         v-browse-height = v-diasize-browse-handle :height
      501       .
      502       for each buf_temp-browse-handle
      503         where buf_temp-browse-handle.browse-type = 'height':u
      504       :
      505         assign
      506           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      507         .
      508       end.
      509       for each buf_temp-diasize-handle
      510       :
      511         delete buf_temp-diasize-handle .
      512       end.
      513       assign
      514         v-field-group-handle = frame Dialog-Frame :first-child
      515       .
      516       do while valid-handle(v-field-group-handle)
      517       :
      518         assign
      519           v-object-handle = v-field-group-handle :first-child
      520         .
      521         do while valid-handle(v-object-handle)
      522         :
      523           if  v-object-handle <> v-diasize-browse-handle :handle
      524           and can-query(v-object-handle, "row")
      525           and can-query(v-object-handle, "height")
      526           and ( v-object-handle :row > v-diasize-browse-handle :row )
      527           then do:
      528             find first buf_temp-browse-handle
      529               where buf_temp-browse-handle.browse-type   = 'height':u
      530                 and buf_temp-browse-handle.browse-handle = v-object-handle
      531               no-error .
      532             if available buf_temp-browse-handle
      533             then do:
      534             end.
      535             else do:
      536               create buf_temp-diasize-handle .
      537               assign
      538                 buf_temp-diasize-handle.handle-value  = v-object-handle
      539                 buf_temp-diasize-handle.save-position = v-object-handle :row
      540               .
      541             end.
      542           end.
      543           assign
      544             v-object-handle = v-object-handle :next-sibling
      545           .
      546         end.
      547         assign
      548           v-field-group-handle = v-field-group-handle :next-sibling
      549         .
      550       end.
      551       do with frame Dialog-Frame
      552       :
      553         hide v-diasize-resize-button .
      554         assign
      555           v-diasize-resize-button :row    = 1
      556           v-diasize-resize-button :column = 1
      557         .
      558       end.
      559       if p-change-value > 0
      560       then do:
      561         if frame Dialog-Frame :scrollable = true
      562         then do:
      563           assign
      564             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      565             no-error .
      566           if error-status :error
      567           or error-status :get-message(1) <> ""
      568           then do:
      569             undo move_block, retry move_block .
      570           end.
      571         end.
      572         assign
      573           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      574           no-error .
      575         if error-status :error
      576         or error-status :get-message(1) <> ""
      577         then do:
      578           undo move_block, retry move_block .
      579         end.
      580         assign
      581           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      582           no-error .
      583         if error-status :error
      584         or error-status :get-message(1) <> ""
      585         then do:
      586           undo move_block, retry move_block .
      587         end.
      588         for each buf_temp-browse-handle
      589           where buf_temp-browse-handle.browse-type = 'height':u
      590         on error undo move_block, retry move_block
      591         :
      592           assign
      593             buf_temp-browse-handle.browse-handle :height
      594               = buf_temp-browse-handle.browse-handle :height + p-change-value
      595             no-error .
      596           if error-status :error
      597           or error-status :get-message(1) <> ""
      598           then do:
      599             undo move_block, retry move_block .
      600           end.
      601         end.
      602         for each buf_temp-diasize-handle
      603         on error undo move_block, retry move_block
      604         :
      605           assign
      606             v-object-handle = buf_temp-diasize-handle.handle-value
      607           .
      608           if v-object-handle <> v-diasize-resize-button
      609           then do:
      610             assign
      611               v-object-handle :row = v-object-handle :row + p-change-value
      612               no-error .
      613             if error-status :error
      614             or error-status :get-message(1) <> ""
      615             then do:
      616               undo move_block, retry move_block .
      617             end.
      618           end.
      619         end.
      620       end.
      621       else do:
      622         for each buf_temp-diasize-handle
      623         on error undo move_block, retry move_block
      624         :
      625           assign
      626             v-object-handle = buf_temp-diasize-handle.handle-value
      627           .
      628           if v-object-handle <> v-diasize-resize-button
      629           then do:
      630             assign
      631               v-object-handle :row = v-object-handle :row + p-change-value
      632               no-error .
      633             if error-status :error
      634             or error-status :get-message(1) <> ""
      635             then do:
      636               undo move_block, retry move_block .
      637             end.
      638           end.
      639         end.
      640         assign
      641           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      642           no-error .
      643         if error-status :error
      644         or error-status :get-message(1) <> ""
      645         then do:
      646           undo move_block, retry move_block .
      647         end.
      648         for each buf_temp-browse-handle
      649           where buf_temp-browse-handle.browse-type = 'height':u
      650         on error undo move_block, retry move_block
      651         :
      652           assign
      653             buf_temp-browse-handle.browse-handle :height
      654               = buf_temp-browse-handle.browse-handle :height + p-change-value
      655             no-error .
      656           if error-status :error
      657           or error-status :get-message(1) <> ""
      658           then do:
      659             undo move_block, retry move_block .
      660           end.
      661         end.
      662         assign
      663           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      664           no-error .
      665         if error-status :error
      666         or error-status :get-message(1) <> ""
      667         then do:
      668           undo move_block, retry move_block .
      669         end.
      670         if frame Dialog-Frame :scrollable = true
      671         then do:
      672           assign
      673             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      674             no-error .
      675           if error-status :error
      676           or error-status :get-message(1) <> ""
      677           then do:
      678             undo move_block, retry move_block .
      679           end.
      680         end.
      681       end.
      682       if p-move-resize = true
      683       then do:
      684         run diasize_position-resize-button in this-procedure .
      685       end.
      686       if v-diasize-wndstore = true
      687       then do:
      688         if connected("ub") = true
      689         then do:
      690           define variable v-cntxt-db-num        as integer   no-undo .
      691           define variable v-cntxt-userid        as character no-undo .
      692           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      693                                             , OUTPUT v-cntxt-userid
      694                                             ) .
      695           run gbl/wndsizew.p
      696             (input  v-cntxt-db-num
      697             ,input  v-cntxt-userid
      698             ,input  v-diasize-proc-name
      699             ,input  'height':u
      700             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      701             ) .
      702         end.
      703       end.
      704     end.
      705     assign
      706       v-diasize-change-size = false
      707     .
      708   end procedure.
      709   procedure diasize_set-height :
      710     define input  parameter p-new-height  as decimal   no-undo .
      711     define input  parameter p-move-resize as logical   no-undo .
      712     do
      713     on error undo, return error return-value
      714     :
      715       run diasize_change-height in this-procedure
      716         (input  (p-new-height - frame Dialog-Frame :height)
      717         ,input  p-move-resize
      718         ) .
      719     end.
      720   end procedure.
      721   procedure diasize_change-width :
      722     define input  parameter p-change-value as decimal   no-undo .
      723     define input  parameter p-move-resize  as logical   no-undo .
      724     define variable v-field-group-handle   as handle    no-undo .
      725     define variable v-object-handle        as handle    no-undo .
      726     define variable v-frame-width          as decimal   no-undo .
      727     define variable v-frame-virtual-width  as decimal   no-undo .
      728     define variable v-browse-width         as decimal   no-undo .
      729     define variable v-window-width         as decimal   no-undo .
      730     define variable v-window-virtual-width as decimal   no-undo .
      731     define variable v-change-sign          as integer   no-undo .
      732     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      733     define buffer buf_temp-browse-handle  for temp-browse-handle .
      734     if p-change-value > 0
      735     then do:
      736       if frame Dialog-Frame :width + p-change-value >
      737           session :width-chars
      738       then do:
      739         assign
      740           p-change-value = session :width-chars - frame Dialog-Frame :width
      741         .
      742         if p-change-value <= 0
      743         then do:
      744           run diasize_position-resize-button in this-procedure .
      745           return .
      746         end.
      747       end.
      748     end.
      749     if p-change-value < 0
      750     then do:
      751       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      752       then do:
      753         assign
      754           p-change-value = v-diasize-orig-frame-width
      755                          - frame Dialog-Frame :width
      756         .
      757         if p-change-value >= 0
      758         then do:
      759           run diasize_position-resize-button in this-procedure .
      760           return .
      761         end.
      762       end.
      763     end.
      764     if p-change-value >= 0
      765     then do:
      766       assign
      767         v-change-sign = 1
      768       .
      769     end.
      770     else do:
      771       assign
      772         v-change-sign = -1
      773       .
      774     end.
      775     assign
      776       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      777     .
      778     if p-change-value = 0
      779     then do:
      780       run diasize_position-resize-button in this-procedure .
      781       return .
      782     end.
      783     move_block:
      784     do
      785     on error undo move_block, leave move_block
      786     :
      787       if retry
      788       then do:
      789         do
      790         on error undo move_block, leave move_block
      791         :
      792           if p-change-value > 0
      793           then do:
      794             for each buf_temp-diasize-handle
      795             on error undo, next
      796             :
      797               assign
      798                 v-object-handle = buf_temp-diasize-handle.handle-value
      799               .
      800               if v-object-handle <> v-diasize-resize-button
      801               then do:
      802                 assign
      803                   v-object-handle :col = buf_temp-diasize-handle.save-position
      804                 .
      805               end.
      806             end.
      807             assign
      808               v-diasize-browse-handle :width = v-browse-width
      809             .
      810             for each buf_temp-browse-handle
      811               where buf_temp-browse-handle.browse-type = 'width':u
      812             on error undo, next
      813             :
      814               assign
      815                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      816               .
      817             end.
      818             assign
      819               frame Dialog-Frame :width = v-frame-width
      820             .
      821             if frame Dialog-Frame :scrollable = true
      822             then do:
      823               assign
      824                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      825               .
      826             end.
      827             run diasize_position-resize-button in this-procedure .
      828           end.
      829           else do:
      830             if frame Dialog-Frame :scrollable = true
      831             then do:
      832               assign
      833                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      834               .
      835             end.
      836             assign
      837               frame Dialog-Frame :width = v-frame-width
      838             .
      839             for each buf_temp-browse-handle
      840               where buf_temp-browse-handle.browse-type = 'width':u
      841             on error undo, next
      842             :
      843               assign
      844                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      845               .
      846             end.
      847             assign
      848               v-diasize-browse-handle :width = v-browse-width
      849             .
      850             for each buf_temp-diasize-handle
      851             on error undo, next
      852             :
      853               assign
      854                 v-object-handle = buf_temp-diasize-handle.handle-value
      855               .
      856               if v-object-handle <> v-diasize-resize-button
      857               then do:
      858                 assign
      859                   v-object-handle :col = buf_temp-diasize-handle.save-position
      860                 .
      861               end.
      862             end.
      863             run diasize_position-resize-button in this-procedure .
      864           end.
      865           assign
      866             v-diasize-change-size = false
      867           .
      868           leave move_block .
      869         end.
      870       end.
      871       assign
      872         v-diasize-need-full-display = true
      873       .
      874       if v-diasize-change-size = false
      875       then do:
      876         assign
      877           v-diasize-change-size = true
      878         .
      879       end.
      880       else do:
      881         return .
      882       end.
      883       assign
      884         v-frame-width = frame Dialog-Frame :width
      885         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      886         v-browse-width = v-diasize-browse-handle :width
      887       .
      888       for each buf_temp-browse-handle
      889         where buf_temp-browse-handle.browse-type = 'width':u
      890       :
      891         assign
      892           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      893         .
      894       end.
      895       for each buf_temp-diasize-handle
      896       :
      897         delete buf_temp-diasize-handle .
      898       end.
      899       assign
      900         v-field-group-handle = frame Dialog-Frame :first-child
      901       .
      902       do while valid-handle(v-field-group-handle)
      903       :
      904         assign
      905           v-object-handle = v-field-group-handle :first-child
      906         .
      907         do while valid-handle(v-object-handle)
      908         :
      909           if  v-object-handle <> v-diasize-browse-handle :handle
      910           and v-object-handle <> v-diasize-resize-button
      911           and can-query(v-object-handle, "row")
      912           and can-query(v-object-handle, "height")
      913           and ( v-object-handle :col + v-object-handle :width
      914                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      915               )
      916           then do:
      917             find first buf_temp-browse-handle
      918               where buf_temp-browse-handle.browse-type   = 'width':u
      919                 and buf_temp-browse-handle.browse-handle = v-object-handle
      920               no-error .
      921             if available buf_temp-browse-handle
      922             then do:
      923             end.
      924             else do:
      925               create buf_temp-diasize-handle .
      926               assign
      927                 buf_temp-diasize-handle.handle-value  = v-object-handle
      928                 buf_temp-diasize-handle.save-position = v-object-handle :col
      929               .
      930             end.
      931           end.
      932           assign
      933             v-object-handle = v-object-handle :next-sibling
      934           .
      935         end.
      936         assign
      937           v-field-group-handle = v-field-group-handle :next-sibling
      938         .
      939       end.
      940       do with frame Dialog-Frame
      941       :
      942         hide v-diasize-resize-button .
      943         v-diasize-resize-button :row = 1.
      944         v-diasize-resize-button :column = 1.
      945       end.
      946       if p-change-value > 0
      947       then do:
      948         if frame Dialog-Frame :scrollable = true
      949         then do:
      950           assign
      951             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      952             no-error .
      953           if error-status :error
      954           or error-status :get-message(1) <> ""
      955           then do:
      956             undo move_block, retry move_block.
      957           end.
      958         end.
      959         assign
      960           frame Dialog-Frame :width = v-frame-width + p-change-value
      961           no-error .
      962         if error-status :error
      963         or error-status :get-message(1) <> ""
      964         then do:
      965           undo move_block, retry move_block.
      966         end.
      967         assign
      968           v-diasize-browse-handle :width = v-browse-width + p-change-value
      969         no-error .
      970         if error-status :error
      971         or error-status :get-message(1) <> ""
      972         then do:
      973           undo move_block, retry move_block.
      974         end.
      975         for each buf_temp-browse-handle
      976           where buf_temp-browse-handle.browse-type = 'width':u
      977         on error undo move_block, retry move_block
      978         :
      979           assign
      980             buf_temp-browse-handle.browse-handle :width
      981               = buf_temp-browse-handle.browse-handle :width + p-change-value
      982             no-error .
      983           if error-status :error
      984           or error-status :get-message(1) <> ""
      985           then do:
      986             undo move_block, retry move_block .
      987           end.
      988         end.
      989         for each buf_temp-diasize-handle
      990         on error undo move_block, retry move_block
      991         :
      992           assign
      993             v-object-handle = buf_temp-diasize-handle.handle-value
      994           .
      995           if v-object-handle <> v-diasize-resize-button
      996           then do:
      997             assign
      998               v-object-handle :col = v-object-handle :col + p-change-value
      999               no-error .
     1000             if error-status :error
     1001             or error-status :get-message(1) <> ""
     1002             then do:
     1003               undo move_block, retry move_block .
     1004             end.
     1005           end.
     1006         end.
     1007       end.
     1008       else do:
     1009         for each buf_temp-diasize-handle
     1010         on error undo move_block, retry move_block
     1011         :
     1012           assign
     1013             v-object-handle = buf_temp-diasize-handle.handle-value
     1014           .
     1015           if v-object-handle <> v-diasize-resize-button
     1016           then do:
     1017             assign
     1018               v-object-handle :col = v-object-handle :col + p-change-value
     1019               no-error .
     1020             if error-status :error
     1021             or error-status :get-message(1) <> ""
     1022             then do:
     1023               undo move_block, retry move_block .
     1024             end.
     1025           end.
     1026         end.
     1027         for each buf_temp-browse-handle
     1028           where buf_temp-browse-handle.browse-type = 'width':u
     1029         on error undo move_block, retry move_block
     1030         :
     1031           assign
     1032             buf_temp-browse-handle.browse-handle :width
     1033               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1034             no-error .
     1035           if error-status :error
     1036           or error-status :get-message(1) <> ""
     1037           then do:
     1038             undo move_block, retry move_block .
     1039           end.
     1040         end.
     1041         assign
     1042           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1043           no-error .
     1044         if error-status :error
     1045         or error-status :get-message(1) <> ""
     1046         then do:
     1047           undo move_block, retry move_block.
     1048         end.
     1049         assign
     1050           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1051         no-error .
     1052         if error-status :error
     1053         or error-status :get-message(1) <> ""
     1054         then do:
     1055           undo move_block, retry move_block.
     1056         end.
     1057         if frame Dialog-Frame :scrollable = true
     1058         then do:
     1059           assign
     1060             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1061           no-error .
     1062           if error-status :error
     1063           or error-status :get-message(1) <> ""
     1064           then do:
     1065             undo move_block, retry move_block.
     1066           end.
     1067         end.
     1068       end.
     1069       if p-move-resize
     1070       then do:
     1071         run diasize_position-resize-button in this-procedure .
     1072       end.
     1073       if v-diasize-wndstore = true
     1074       then do:
     1075         if connected("ub") = true
     1076         then do:
     1077           define variable v-cntxt-db-num        as integer   no-undo .
     1078           define variable v-cntxt-userid        as character no-undo .
     1079           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1080                                             , OUTPUT v-cntxt-userid
     1081                                             ) .
     1082           run gbl/wndsizew.p
     1083             (input  v-cntxt-db-num
     1084             ,input  v-cntxt-userid
     1085             ,input  v-diasize-proc-name
     1086             ,input  'width':u
     1087             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1088             ) .
     1089         end.
     1090       end.
     1091     end.
     1092     assign
     1093       v-diasize-change-size = false
     1094     .
     1095   end procedure.
     1096   procedure diasize_set-width :
     1097     define input  parameter p-new-width  as decimal   no-undo .
     1098     define input  parameter p-move-resize as logical   no-undo .
     1099     do
     1100     on error undo, return error return-value
     1101     :
     1102       run diasize_change-width in this-procedure
     1103         (input  (p-new-width - frame Dialog-Frame :width)
     1104         ,input  p-move-resize
     1105         ) .
     1106     end.
     1107   end procedure.
     1108   procedure diasize_position-resize-button :
     1109     do with frame Dialog-Frame
     1110     :
     1111       hide v-diasize-resize-button .
     1112       assign
     1113         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1114                     - 1
     1115                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1116         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1117                     - 1
     1118                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1119       .
     1120       view v-diasize-resize-button .
     1121     end.
     1122   end procedure.
     1123   on alt-right anywhere
     1124   do:
     1125     run diasize_change-width in this-procedure
     1126       (input 1
     1127       ,input true
     1128       ) .
     1129     return no-apply .
     1130   end.
     1131   on alt-left anywhere
     1132   do:
     1133     run diasize_change-width in this-procedure
     1134       (input -1
     1135       ,input true
     1136       ) .
     1137     return no-apply .
     1138   end.
     1139   on alt-down anywhere
     1140   do:
     1141     run diasize_change-height in this-procedure
     1142       (input 1
     1143       ,input true
     1144       ) .
     1145     return no-apply .
     1146   end.
     1147   on alt-up anywhere
     1148   do:
     1149     run diasize_change-height in this-procedure
     1150       (input -1
     1151       ,input true
     1152       ) .
     1153     return no-apply .
     1154   end.
     1155   on alt-enter of frame Dialog-Frame
     1156   do:
     1157     run diasize_maximize in this-procedure
     1158       (input  ?
     1159       ).
     1160     return no-apply .
     1161   end.
     1162   procedure diasize_end-move :
     1163     do
     1164     on error undo, return error return-value
     1165     :
     1166       define variable v-row-delta as decimal   no-undo .
     1167       define variable v-col-delta as decimal   no-undo .
     1168       define variable v-new-row as decimal   no-undo .
     1169       define variable v-new-col as decimal   no-undo .
     1170       assign
     1171         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1172         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1173       .
     1174       assign
     1175         v-row-delta = v-new-row - frame Dialog-Frame :height
     1176         v-col-delta = v-new-col - frame Dialog-Frame :width
     1177       .
     1178       run diasize_change-height in this-procedure
     1179         (input v-row-delta
     1180         ,input true
     1181         ) .
     1182       run diasize_change-width in this-procedure
     1183         (input v-col-delta
     1184         ,input true
     1185         ) .
     1186     end.
     1187   end procedure.
     1188   procedure diasize_maximize :
     1189     define input  parameter p-action as logical   no-undo .
     1190     do
     1191     on error undo, return error return-value
     1192     :
     1193       if p-action = ?
     1194       then do:
     1195         if v-diasize-need-maximize = true
     1196         then do:
     1197           assign
     1198             p-action = true
     1199           .
     1200         end.
     1201         else do:
     1202           assign
     1203             p-action = false
     1204           .
     1205         end.
     1206       end.
     1207       if p-action = true
     1208       then do:
     1209         run diasize_change-height in this-procedure
     1210           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1211               - frame Dialog-Frame :height-chars
     1212           ,input true
     1213           ) .
     1214         run diasize_change-width in this-procedure
     1215           (input session :width-chars
     1216               - frame Dialog-Frame :width-chars
     1217           ,input true
     1218           ) .
     1219         assign
     1220           v-diasize-need-maximize = false
     1221         .
     1222       end.
     1223       else do:
     1224         run diasize_change-width in this-procedure
     1225           (input v-diasize-orig-frame-width
     1226               - frame Dialog-Frame :width-chars
     1227           ,input true
     1228           ) .
     1229         run diasize_change-height in this-procedure
     1230           (input v-diasize-orig-frame-height
     1231               - frame Dialog-Frame :height-chars
     1232           ,input true
     1233           ) .
     1234         assign
     1235           v-diasize-need-maximize = true
     1236         .
     1237       end.
     1238     end.
     1239   end procedure.
     1240   procedure diasize_restore-orig-size :
     1241     do
     1242     on error undo, return error return-value
     1243     :
     1244       assign
     1245         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1246         v-diasize-current-frame-height = frame Dialog-Frame :height
     1247       .
     1248       run diasize_set-height in this-procedure
     1249         (input  v-diasize-orig-frame-height
     1250         ,input  true
     1251         ) .
     1252       run diasize_set-width in this-procedure
     1253         (input  v-diasize-orig-frame-width
     1254         ,input  true
     1255         ) .
     1256     end.
     1257   end procedure.
     1258   procedure diasize_restore-current-size :
     1259     do
     1260     on error undo, return error return-value
     1261     :
     1262       run diasize_set-height in this-procedure
     1263         (input  v-diasize-current-frame-height
     1264         ,input  true
     1265         ) .
     1266       run diasize_set-width in this-procedure
     1267         (input  v-diasize-current-frame-width
     1268         ,input  true
     1269         ) .
     1270     end.
     1271   end procedure.
     1272   procedure diasize_set-browse-handle :
     1273     define input  parameter p-browse-handle as handle   no-undo .
     1274     define buffer buf_temp-browse-handle for temp-browse-handle .
     1275     do
     1276     on error undo, return error return-value
     1277     :
     1278       assign
     1279         v-diasize-browse-handle = p-browse-handle
     1280       .
     1281       for each buf_temp-browse-handle
     1282       on error undo, return error return-value
     1283       :
     1284         delete buf_temp-browse-handle .
     1285       end.
     1286     end.
     1287   end procedure.
     1288   procedure diasize_add_browse :
     1289     define input  parameter p-browse-type   as character no-undo .
     1290     define input  parameter p-browse-handle as handle    no-undo .
     1291     define buffer buf_temp-browse-handle for temp-browse-handle .
     1292     do
     1293     on error undo, return error return-value
     1294     :
     1295       assign
     1296         v-diasize-browse-number = v-diasize-browse-number + 1
     1297       .
     1298       create buf_temp-browse-handle .
     1299       assign
     1300         buf_temp-browse-handle.browse-type   = p-browse-type
     1301         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1302         buf_temp-browse-handle.browse-handle = p-browse-handle
     1303       .
     1304     end.
     1305   end procedure.
     1306   procedure diasize_init :
     1307     define variable v-default-value    as logical   no-undo .
     1308     define variable v-restore-saved    as logical   no-undo .
     1309     define variable v-resize-value-str as character no-undo .
     1310     do
     1311     on error undo, return error return-value
     1312     :
     1313       do with frame Dialog-Frame
     1314       :
     1315         assign
     1316           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1317           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1318           v-diasize-browse-handle     = browse b-fin-doc :handle
     1319         .
     1320         create button v-diasize-resize-button
     1321         assign
     1322           parent        = frame Dialog-Frame :first-child
     1323           label         = "s"
     1324           height-pixels = 16
     1325           width-pixels  = 16
     1326           visible       = true
     1327           sensitive     = true
     1328           movable       = true
     1329           triggers:
     1330             on end-move persistent run diasize_end-move in this-procedure .
     1331           end triggers.
     1332         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1333         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1334         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1335         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1336         assign
     1337           v-diasize-wndmax = false
     1338         .
     1339         if connected("ub") = true
     1340         then do:
     1341           define variable v-cntxt-db-num        as integer   no-undo .
     1342           define variable v-cntxt-userid        as character no-undo .
     1343           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1344                                             , OUTPUT v-cntxt-userid
     1345                                             ) .
     1346           run gbl/wndpar_r.p
     1347             (input  v-cntxt-db-num
     1348             ,input  v-cntxt-userid
     1349             ,input  'wndmax':U
     1350             ,output v-diasize-wndmax
     1351             ,output v-default-value
     1352             ) .
     1353         end.
     1354         assign
     1355           v-diasize-wndstore = false
     1356         .
     1357         if connected("ub") = true
     1358         then do:
     1359           run gbl/wndpar_r.p
     1360             (input  v-cntxt-db-num
     1361             ,input  v-cntxt-userid
     1362             ,input  'wndstore':U
     1363             ,output v-diasize-wndstore
     1364             ,output v-default-value
     1365             ) .
     1366         end.
     1367         assign
     1368           v-diasize-proc-name = entry(1, program-name(2), '.')
     1369         .
     1370         if v-diasize-wndstore = true
     1371         then do:
     1372           assign
     1373             v-restore-saved = false
     1374           .
     1375           if connected("ub") = true
     1376           then do:
     1377             run gbl/wndsizer.p
     1378               (input  v-cntxt-db-num
     1379               ,input  v-cntxt-userid
     1380               ,input  v-diasize-proc-name
     1381               ,input  'height':u
     1382               ,output v-resize-value-str
     1383               ) .
     1384             if v-resize-value-str <> '':U
     1385             then do:
     1386               run diasize_change-height in this-procedure
     1387                 (input  integer(v-resize-value-str)
     1388                 ,input  true
     1389                 ) .
     1390               assign
     1391                 v-restore-saved = true
     1392               .
     1393             end.
     1394           end.
     1395           if connected("ub") = true
     1396           then do:
     1397             run gbl/wndsizer.p
     1398               (input  v-cntxt-db-num
     1399               ,input  v-cntxt-userid
     1400               ,input  v-diasize-proc-name
     1401               ,input  'width':u
     1402               ,output v-resize-value-str
     1403               ) .
     1404             if v-resize-value-str <> '':U
     1405             then do:
     1406               run diasize_change-width in this-procedure
     1407                 (input  integer(v-resize-value-str)
     1408                 ,input  true
     1409                 ) .
     1410               assign
     1411                 v-restore-saved = true
     1412               .
     1413             end.
     1414           end.
     1415           if v-restore-saved <> true
     1416           then do:
     1417             if v-diasize-wndmax = true
     1418             then do:
     1419               run diasize_maximize in this-procedure
     1420                 (input  true
     1421                 ) .
     1422             end.
     1423           end.
     1424         end.
     1425         else do:
     1426           if v-diasize-wndmax = true
     1427           then do:
     1428             run diasize_maximize in this-procedure
     1429               (input  true
     1430               ) .
     1431           end.
     1432         end.
     1433       end.
     1434     end.
     1435   end procedure.
     1436   procedure diasize_need-full-display :
     1437     define output parameter p-need-full-display as logical   no-undo .
     1438     do
     1439     on error undo, return error return-value
     1440     :
     1441       assign
     1442         p-need-full-display = v-diasize-need-full-display
     1443       .
     1444       assign
     1445         v-diasize-need-full-display = false
     1446       .
     1447     end.
     1448   end procedure.
     1449   procedure get-context :
     1450      define output parameter p-db-num as integer          no-undo.
     1451      define output parameter p-user-id as character        no-undo.
     1452      define variable v-login               as character    no-undo.
     1453      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1454      define buffer buf_user-login  for ub.user-login .
     1455      do
     1456      on error undo, return error
     1457      :
     1458            FIND FIRST buf_sys-ctrl no-lock.
     1459            ASSIGN
     1460               v-login = USERID("ub")
     1461               p-db-num = buf_sys-ctrl.db-num
     1462            .
     1463            FIND FIRST buf_user-login
     1464                 WHERE buf_user-login.db-num = p-db-num
     1465                   AND buf_user-login.user-login = v-login
     1466                 no-lock
     1467                 no-error
     1468                 .
     1469            IF AVAILABLE buf_user-login
     1470            THEN DO:
     1471               assign
     1472                  p-user-id = buf_user-login.user-id
     1473               .
     1474            END.
     1475      end.
     1476   end procedure.
     1477   run diasize_add_browse in this-procedure
     1478     (input  'width':u
     1479     ,input  browse b-fin-ob:handle
     1480     ) .
     1481   run diasize_add_browse in this-procedure
     1482     (input  'width':u
     1483     ,input  browse b-parts:handle
     1484     ) .
     1485   run diasize_init in this-procedure .
     1486   MAIN-BLOCK:
     1487   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1488      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1489     ASSIGN FRAME
     1490       Dialog-Frame:TITLE = "Платежи по складскому документу " + pardoc-code.
     1491     FIND FIRST bf_trn-doc WHERE bf_trn-doc.doc-code = pardoc-code NO-LOCK.
     1492     RUN cr-tt-fd IN THIS-PROCEDURE.
     1493     assign
     1494     tt-fd.sum-rubl:label in browse b-fin-doc         = "Сумма платежа (руб)"
     1495     tt-fd.sum-rubl-fo:label in browse b-fin-doc      = "Сумма связей С ФО (руб)"
     1496     tt-fo.sum-rubl:label in browse b-fin-ob          = "Общая сумма (руб)"
     1497     bf_fin-connect.sum-rubl:label in browse b-fin-ob = "Сумма связи (руб)"
     1498     tt-fo.sum-rubl-trn:label in browse b-fin-ob      = "Сумма по док. (руб)"
     1499     bf_parts.price-rubl:label in browse b-parts      = "Цена (руб)"
     1500     .
     1501     RUN enable_UI.
     1502     OPEN QUERY b-fin-doc FOR EACH tt-fd.
     1503     RUN open-query-fo IN THIS-PROCEDURE.
     1504     RUN open-parts-query IN THIS-PROCEDURE.
     1505     WAIT-FOR GO OF FRAME Dialog-Frame.
     1506   END.
     1507   RUN disable_UI.
     1508   PROCEDURE cr-tt-fd :
     1509   DEFINE BUFFER bf_fin-gds-part FOR ub.fin-gds-part.
     1510   DEFINE BUFFER bf_fin-ob       FOR ub.fin-ob.
     1511   DEFINE BUFFER bf_fin-connect  FOR ub.fin-connect.
     1512   DEFINE BUFFER bf_fin-doc      FOR ub.fin-doc.
     1513   do on error undo, return error return-value :
     1514   FOR EACH bf_fin-gds-part WHERE bf_fin-gds-part.obj-type = bf_trn-doc.obj-type AND
     1515                                  bf_fin-gds-part.obj-code = bf_trn-doc.obj-code AND
     1516                                  bf_fin-gds-part.out-code = bf_trn-doc.doc-code NO-LOCK ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1517     FIND FIRST bf_fin-ob WHERE bf_fin-ob.host-code = bf_fin-gds-part.host-code AND
     1518                                bf_fin-ob.doc-code  = bf_fin-gds-part.fin-ob-code NO-LOCK no-error.
     1519     if available bf_fin-ob then do:
     1520       FIND FIRST tt-fo WHERE tt-fo.host-code = bf_fin-ob.host-code AND
     1521                              tt-fo.doc-code  = bf_fin-ob.doc-code NO-ERROR.
     1522       IF NOT AVAILABLE tt-fo THEN DO:
     1523         CREATE tt-fo.
     1524         BUFFER-COPY bf_fin-ob TO tt-fo.
     1525       END.
     1526       ASSIGN
     1527         tt-fo.sum-base-trn = tt-fo.sum-base-trn + bf_fin-gds-part.sum-base
     1528         tt-fo.sum-rubl-trn = tt-fo.sum-rubl-trn + bf_fin-gds-part.sum-rubl.
     1529     end.
     1530   END.
     1531   FOR EACH tt-fo ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1532     FOR EACH bf_fin-connect WHERE bf_fin-connect.host-code   = tt-fo.host-code AND
     1533                                   bf_fin-connect.fin-ob-code = tt-fo.doc-code  NO-LOCK ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1534       FIND FIRST bf_fin-doc WHERE bf_fin-doc.host-code    = bf_fin-connect.host-code    AND
     1535                                   bf_fin-doc.fin-doc-code = bf_fin-connect.fin-doc-code NO-LOCK.
     1536       FIND FIRST tt-fd WHERE tt-fd.host-code    = bf_fin-connect.host-code     AND
     1537                              tt-fd.fin-doc-code = bf_fin-connect.fin-doc-code NO-ERROR.
     1538       IF NOT AVAILABLE tt-fd THEN DO:
     1539         CREATE tt-fd.
     1540         BUFFER-COPY bf_fin-doc TO tt-fd.
     1541       END.
     1542       ASSIGN
     1543         tt-fd.sum-base-fo = tt-fd.sum-base-fo + bf_fin-connect.sum-base
     1544         tt-fd.sum-rubl-fo = tt-fd.sum-rubl-fo + bf_fin-connect.sum-rubl .
     1545     END.
     1546   END.
     1547   END.
     1548   END PROCEDURE.
     1549   PROCEDURE disable_UI :
     1550     HIDE FRAME Dialog-Frame.
     1551   END PROCEDURE.
     1552   PROCEDURE enable_UI :
     1553     ENABLE b-exit b-help b-fin-doc b-fin-ob b-parts
     1554         WITH FRAME Dialog-Frame.
     1555     VIEW FRAME Dialog-Frame.
     1556   END PROCEDURE.
     1557   PROCEDURE open-parts-query :
     1558   IF AVAILABLE tt-fo THEN DO:
     1559       OPEN QUERY b-parts
     1560           FOR EACH bf_fin-gds-part WHERE bf_fin-gds-part.host-code = tt-fo.host-code AND
     1561                                          bf_fin-gds-part.fin-ob-code = tt-fo.doc-code AND
     1562                                           bf_fin-gds-part.out-code = pardoc-code NO-LOCK,
     1563           first bf_goods where bf_goods.gds-code = bf_fin-gds-part.gds-code no-lock,
     1564           FIRST bf_parts WHERE bf_parts.obj-type = bf_fin-gds-part.obj-type AND
     1565                                bf_parts.obj-code = bf_fin-gds-part.obj-code AND
     1566                                bf_parts.artic    = bf_goods.artic AND
     1567                                bf_parts.prod-type = bf_goods.prod-type AND
     1568                                bf_parts.prod-code = bf_goods.prod-code AND
     1569                                bf_parts.in-code   = bf_fin-gds-part.in-code AND
     1570                                bf_parts.out-code  = bf_fin-gds-part.out-code AND
     1571                                bf_parts.part-code = bf_fin-gds-part.part-code NO-LOCK.
     1572       DISPLAY b-parts WITH FRAME Dialog-Frame.
     1573   END.
     1574   END PROCEDURE.
     1575   PROCEDURE open-query-fo :
     1576   IF AVAILABLE tt-fd THEN DO:
     1577     OPEN QUERY b-fin-ob FOR EACH tt-fo,
     1578         FIRST bf_fin-connect WHERE bf_fin-connect.host-code    = tt-fo.host-code AND
     1579                                    bf_fin-connect.fin-ob-code = tt-fo.doc-code  AND
     1580                                    bf_fin-connect.fin-doc-code = tt-fd.fin-doc-code NO-LOCK.
     1581     DISPLAY b-fin-ob WITH FRAME Dialog-Frame.
     1582   END.
     1583   END PROCEDURE.
