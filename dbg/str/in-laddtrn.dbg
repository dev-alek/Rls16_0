      652     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
      653       define variable v-answ as logical no-undo .
      654       if ( p-unit-base-cli-eq = true
      655            and p-density = 1.0
      656          )
      657         or ( p-unit-base-cli-eq = false
      658              and p-density <> ?
      659              and p-density > 0.0
      660              and p-density < 1.0
      661            )
      662       then do:
      663         assign
      664           v-answ = true
      665         .
      666       end.
      667       else do:
      668         assign
      669           v-answ = false
      670         .
      671       end.
      672       return v-answ.
      673     end function.
