     1310   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1311   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1312   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313   on help of frame Dialog-Frame
     1314   do:
     1315     run gbl/app_help.p
     1316       (input this-procedure :file-name
     1317       ,input ''
     1318       ,input ?
     1319       ) no-error.
     1320     if error-status :error then do:
     1321       message
     1322         "Ошибка при вызове помощи"
     1323         error-status :get-message(1)
     1324         view-as alert-box .
     1325     end.
     1326   end.
     1327   run minbtn-set in this-procedure .
     1328   on choose of b-help in frame Dialog-Frame
     1329   do:
     1330     apply "help":u to frame Dialog-Frame .
     1331   end.
     1332   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1333   procedure minbtn-set :
     1334       do
     1335           on error undo, return error return-value
     1336           :
     1337           define variable ii              as integer       no-undo .
     1338           define variable fh              as widget-handle no-undo .
     1339           define variable hh              as widget-handle no-undo .
     1340           define variable v-h             as handle        extent 4 no-undo .
     1341           define variable v-name-button   as character     no-undo .
     1342           define variable v-help-old-x    as decimal       no-undo .
     1343           define variable v-help-old-y    as decimal       no-undo .
     1344           define variable v-help-old-size as decimal       no-undo .
     1345           define variable v-frame-width   as decimal       no-undo .
     1346           define variable jj              as integer       no-undo .
     1347           do
     1348               on error undo, return error
     1349               :
     1350               assign
     1351                   v-frame-width = frame Dialog-Frame:width - 0.3
     1352                   fh            = frame Dialog-Frame:first-child
     1353                   hh            = fh:first-child
     1354                   ii            = 1
     1355                   .
     1356               do while valid-handle(hh):
     1357                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1358                   do:
     1359                       case lc(hh:name) :
     1360                           when "b-help" then
     1361                               do:
     1362                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1363                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1364                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1365                                   hh:TOOLTIP = "Помощь" .
     1366                                   v-help-old-x = hh:column .
     1367                                   v-help-old-y = hh:row    .
     1368                                   v-help-old-size = hh:width .
     1369                                   hh:width-chars = 2.5 .
     1370                               end.
     1371                           when "b-print" then
     1372                               do:
     1373                                   hh:load-image("cmp/b-print.bmp":u) .
     1374                                   hh:TOOLTIP = "Печать" .
     1375                                   v-h[ii] = hh:handle .
     1376                                   ii = ii + 1 .
     1377                                   hh:width-chars = 3 .
     1378                               end.
     1379                           when "b-history" or
     1380                           when "b-hist" then
     1381                               do:
     1382                                   hh:load-image("cmp/b-hist.bmp":u) .
     1383                                   hh:TOOLTIP = "История" .
     1384                                   v-h[ii] = hh:handle .
     1385                                   ii = ii + 1 .
     1386                                   hh:width-chars = 3 .
     1387                               end.
     1388                           when "b-sch" then
     1389                               do:
     1390                                   hh:load-image("cmp/b-sch.bmp":u) .
     1391                                   hh:TOOLTIP = "Установка Фильтра" .
     1392                                   v-h[ii] = hh:handle .
     1393                                   ii = ii + 1 .
     1394                                   hh:width-chars = 3 .
     1395                               end.
     1396                           when "b-hist-user" then
     1397                               do:
     1398                                   hh:load-image("cmp/b-hist.bmp":u) .
     1399                                   hh:TOOLTIP = "История пользователя" .
     1400                                   ii = ii + 1 .
     1401                               end.
     1402                       end case.
     1403                   end.
     1404                   hh = hh:next-sibling.
     1405               end.
     1406               b-help:column = v-frame-width - b-help:width-chars.
     1407               jj = 0.
     1408               repeat ii = 4 to 1 by -1 :
     1409                   if valid-handle (v-h[ii] ) then
     1410                   do:
     1411                       jj  = jj + 1 .
     1412                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1413                       v-h[ii]:row    = v-help-old-y .
     1414                   end.
     1415               end.
     1416           end.
     1417       end.
     1418   end procedure.
     1419   MAIN-BLOCK:
     1420   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1421      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1422     define buffer buf_doc-attr for ub.doc-attr.
     1423   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     1424                           input 'trn-lgas-corr':U ,
     1425                          output varvalue ,
     1426                          output vartype ) no-error .
     1427     if not varvalue = ""
     1428       then frame Dialog-Frame:title = "Дополнительная информация по корр. накладной СУГ. Исх.накл. - " + varvalue.
     1429   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     1430                           input 'is-lgas':U ,
     1431                          output varvalue ,
     1432                          output vartype ) no-error .
     1433      if varvalue = "yes" then do:
     1434        assign
     1435          v-is-lgas = true.
     1436      end.
     1437   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     1438                           input 'is-lgas-corr':U ,
     1439                          output varvalue ,
     1440                          output vartype ) no-error .
     1441     if varvalue = "yes" then do:
     1442        assign
     1443          v-is-lgas = true.
     1444     end.
     1445     for each tt-upd-attr-fuel no-lock:
     1446       find first buf_doc-attr no-lock
     1447         where buf_doc-attr.doc-code  = p-doc-code
     1448           and buf_doc-attr.attr-code = tt-upd-attr-fuel.code
     1449         no-error .
     1450       if available buf_doc-attr then do:
     1451         case tt-upd-attr-fuel.code:
     1452           when 'ptbobj':U then do:
     1453               assign
     1454                 f-ptbotype = entry (1, buf_doc-attr.attr-value, ";")
     1455                 f-ptbocode = integer (entry (2, buf_doc-attr.attr-value, ";"))
     1456               no-error.
     1457               find first clients no-lock
     1458                 where clients.obj-type = f-ptbotype
     1459                   and clients.obj-code = f-ptbocode
     1460                 no-error.
     1461               if available clients
     1462                 then assign f-ptboname = clients.obj-name.
     1463                 else
     1464                   assign f-ptboname = ""
     1465                   f-ptbotype = ""
     1466                   f-ptbotype = ?.
     1467           end.
     1468           when 'ptb-item-pour':U then do:
     1469               assign
     1470                 f-item-pour = buf_doc-attr.attr-value
     1471               .
     1472           end.
     1473           when 'autoent':U then do:
     1474               assign
     1475                 f-autoent-obj-type = entry (1, buf_doc-attr.attr-value, ";")
     1476                 f-autoent-obj-code = integer (entry (2, buf_doc-attr.attr-value, ";"))
     1477               no-error.
     1478               assign
     1479                 v-autoent-obj-type = f-autoent-obj-type
     1480                 v-autoent-obj-code = f-autoent-obj-code
     1481               .
     1482               find first ub.clients no-lock
     1483                 where ub.clients.obj-type = f-autoent-obj-type
     1484                   and ub.clients.obj-code = f-autoent-obj-code
     1485                 no-error.
     1486               if available ub.clients then do:
     1487                 assign
     1488                   f-autoent-obj-name = ub.clients.obj-name
     1489                 .
     1490               end.
     1491               else do:
     1492                 assign
     1493                   f-autoent-obj-name = ?
     1494                   f-autoent-obj-code = ?
     1495                   f-autoent-obj-type = ""
     1496                 .
     1497               end.
     1498           end.
     1499           when 'car-num':U then do:
     1500               assign
     1501                 f-car-num = buf_doc-attr.attr-value
     1502               .
     1503           end.
     1504           when 'fio-driver':U then do:
     1505               assign
     1506                 f-fio = buf_doc-attr.attr-value
     1507               .
     1508           end.
     1509           when 'time-income':U then do:
     1510             assign f-hour-income = integer(substring(buf_doc-attr.attr-value, 1, 2)) no-error.
     1511             if error-status:error then do:
     1512               message "Неверное время прибытия " buf_doc-attr.attr-value
     1513               view-as alert-box.
     1514               assign f-hour-income = 0
     1515                       f-min-income  = 0.
     1516             end.
     1517             else do:
     1518               assign f-min-income = integer(substring(buf_doc-attr.attr-value, 4, 2)) no-error.
     1519               if error-status:error then do:
     1520                   message "Неверное время прибытия " buf_doc-attr.attr-value
     1521                   view-as alert-box.
     1522                   assign f-hour-income = 0
     1523                         f-min-income  = 0.
     1524               end.
     1525             end.
     1526           end.
     1527           when 'time-pour':U then do:
     1528               assign f-hour-pour = integer(substring(buf_doc-attr.attr-value, 1, 2)) no-error.
     1529             if error-status:error then do:
     1530               message "Неверное время налива " buf_doc-attr.attr-value
     1531               view-as alert-box.
     1532               assign f-hour-pour = 0
     1533                       f-min-pour  = 0.
     1534             end.
     1535             else do:
     1536               assign f-min-pour = integer(substring(buf_doc-attr.attr-value, 4, 2)) no-error.
     1537               if error-status:error then do:
     1538                   message "Неверное время налива " buf_doc-attr.attr-value
     1539                   view-as alert-box.
     1540                   assign f-hour-pour = 0
     1541                         f-min-pour  = 0.
     1542               end.
     1543             end.
     1544           end.
     1545           when 'time-start':U then do:
     1546               assign f-hour-start = integer(substring(buf_doc-attr.attr-value, 1, 2)) no-error.
     1547             if error-status:error then do:
     1548               message "Неверное время начала слива " buf_doc-attr.attr-value
     1549               view-as alert-box.
     1550               assign f-hour-start = 0
     1551                       f-min-start  = 0.
     1552             end.
     1553             else do:
     1554               assign f-min-start = integer(substring(buf_doc-attr.attr-value, 4, 2)) no-error.
     1555               if error-status:error then do:
     1556                   message "Неверное время начала слива " buf_doc-attr.attr-value
     1557                   view-as alert-box.
     1558                   assign f-hour-start = 0
     1559                         f-min-start  = 0.
     1560               end.
     1561             end.
     1562           end.
     1563           when 'time-end':U then do:
     1564               assign f-hour-end = integer(substring(buf_doc-attr.attr-value, 1, 2)) no-error.
     1565             if error-status:error then do:
     1566               message "Неверное время конца слива " buf_doc-attr.attr-value
     1567               view-as alert-box.
     1568               assign f-hour-end = 0
     1569                       f-min-end  = 0.
     1570             end.
     1571             else do:
     1572               assign f-min-end = integer(substring(buf_doc-attr.attr-value, 4, 2)) no-error.
     1573               if error-status:error then do:
     1574                   message "Неверное время конца слива " buf_doc-attr.attr-value
     1575                   view-as alert-box.
     1576                   assign f-hour-end = 0
     1577                         f-min-end = 0.
     1578               end.
     1579             end.
     1580           end.
     1581           when 'date-pour':U then do:
     1582               assign
     1583                 f-date-pour = date(buf_doc-attr.attr-value).
     1584           end.
     1585           when 'date-income':U then do:
     1586               assign
     1587                 f-date-income = date(buf_doc-attr.attr-value).
     1588           end.
     1589           when 'inspection-cert':U then do:
     1590               assign
     1591                 f-insp-cert = buf_doc-attr.attr-value.
     1592           end.
     1593           when 'date-cert':U then do:
     1594               assign
     1595                 f-date-cert = date(buf_doc-attr.attr-value).
     1596           end.
     1597           when 'date-pasport':U then do:
     1598               assign
     1599                 f-date-pasport = date(buf_doc-attr.attr-value).
     1600           end.
     1601           when 'num-pasport':U then do:
     1602               assign
     1603                 f-num-pasport = buf_doc-attr.attr-value.
     1604           end.
     1605           when 'condition':U then do:
     1606               assign
     1607                 f-condition = buf_doc-attr.attr-value.
     1608           end.
     1609           when 'seals-condition':U then do:
     1610               if num-entries (buf_doc-attr.attr-value, chr(4)) = 2
     1611               then do:
     1612                 assign
     1613                   f-seals-condition = entry (1, buf_doc-attr.attr-value, chr(4))
     1614                   f-seals-condition-2 = entry (2, buf_doc-attr.attr-value, chr(4))
     1615                 .
     1616               end.
     1617               else
     1618                 assign
     1619                   f-seals-condition = buf_doc-attr.attr-value.
     1620           end.
     1621           when 'doc-not':U then do:
     1622               assign
     1623                 b-doc =  logical(buf_doc-attr.attr-value) no-error.
     1624           end.
     1625           when 'clear-ac':U then do:
     1626               assign
     1627                 t-clear =  logical(buf_doc-attr.attr-value) no-error.
     1628           end.
     1629           when 'spisok-not-doc':U then do:
     1630               assign
     1631                 f-item-doc =  buf_doc-attr.attr-value no-error.
     1632           end.
     1633           when 'trdcattr-date-start':U then do:
     1634               assign
     1635                 f-date-start = date(buf_doc-attr.attr-value).
     1636           end.
     1637           when 'trdcattr-date-end':U then do:
     1638               assign
     1639                 f-date-end = date(buf_doc-attr.attr-value).
     1640           end.
     1641         end case.
     1642       end.
     1643     end.
     1644     if not v-avai-acc-ship
     1645       then f-acc-ship = 0.25.
     1646     RUN enable_UI.
     1647     run gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", no, output rdc-dnstvalue, output rdc-dnsttype) no-error.
     1648     display
     1649         f-autoent-obj-code
     1650         f-autoent-obj-name
     1651         f-autoent-obj-type
     1652         f-car-num
     1653         b-clients
     1654         b-ptb
     1655         b-auto-tank
     1656         f-condition
     1657         f-seals-condition
     1658         f-seals-condition-2
     1659         f-insp-cert
     1660         f-date-cert
     1661         f-num-pasport
     1662         f-date-pasport
     1663         f-fio
     1664         f-ptbocode
     1665         f-ptbotype
     1666         f-ptboname
     1667         f-hour-income
     1668         f-min-income
     1669         f-item-pour
     1670         f-hour-pour
     1671         f-min-pour
     1672         f-date-pour
     1673         f-date-income
     1674         f-hour-pour
     1675         f-min-pour
     1676         b-save
     1677         f-acc-ship
     1678         b-doc
     1679         f-date-start
     1680         f-date-end
     1681       with frame Dialog-Frame.
     1682       if b-doc = no then do:
     1683           hide
     1684               f-item-doc
     1685           in frame Dialog-Frame .
     1686       end.
     1687       hide
     1688           f-hour-start
     1689           f-hour-end
     1690           f-min-end
     1691           f-min-start
     1692           f-date-start
     1693           f-date-end
     1694           t-clear
     1695       in frame Dialog-Frame .
     1696       if v-is-lgas then do:
     1697         display
     1698           f-hour-start
     1699           f-hour-end
     1700           f-min-end
     1701           f-min-start
     1702           f-date-start
     1703           f-date-end
     1704           t-clear
     1705         with frame Dialog-Frame .
     1706       end.
     1707       hide
     1708       f-acc-ship-2 f-acc-ship
     1709       in frame Dialog-Frame .
     1710     find first ub.trn-doc no-lock where ub.trn-doc.doc-code = p-doc-code no-error.
     1711   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1712   run get-ptrl-prop in this-procedure
     1713     ( input ub.trn-doc.obj-type
     1714     , input ub.trn-doc.obj-code
     1715     ) .
     1716     if ptrlprop-mand-choice-autocar
     1717     then do:
     1718       disable f-car-num with frame Dialog-Frame.
     1719     end.
     1720     if p-mode <> 'ИЗМЕНЕНИЕ':U and  p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     1721       disable
     1722         f-autoent-obj-code
     1723         f-autoent-obj-name
     1724         f-autoent-obj-type
     1725         f-car-num
     1726         b-clients
     1727         b-ptb
     1728         b-auto-tank
     1729         f-condition
     1730         f-seals-condition
     1731         f-seals-condition-2
     1732         f-insp-cert
     1733         f-date-cert
     1734         f-num-pasport
     1735         f-date-pasport
     1736         f-fio
     1737         f-ptbocode
     1738         f-ptbotype
     1739         f-ptboname
     1740         f-hour-income
     1741         f-min-income
     1742         f-item-pour
     1743         f-date-pour
     1744         f-date-income
     1745         f-hour-pour
     1746         f-min-pour
     1747         b-save
     1748         f-acc-ship
     1749         b-doc
     1750         f-hour-start
     1751         f-hour-end
     1752         f-min-end
     1753         f-min-start
     1754         f-date-start
     1755         f-date-end
     1756         t-clear
     1757         with frame Dialog-Frame.
     1758     end.
     1759   find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code .
     1760     v-dop-info = "".
     1761   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1762   empty temp-table thbjattr_thbj-attr.
     1763   run adm/shattri.p (
     1764      input "get":U
     1765     ,input buf_trn-doc.obj-type
     1766     ,input buf_trn-doc.obj-code
     1767     ,input 'petrol':U
     1768     ,input  ""
     1769     ,output v-value-character
     1770     ,output v-value-date
     1771     ,output v-value-decimal
     1772     ,output v-value-integer
     1773     ,output v-value-logical
     1774     ,output par-type
     1775     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1776     ) no-error .
     1777           for each thbjattr_thbj-attr :
     1778               if thbjattr_thbj-attr.prop-code = 'dop-info' then v-dop-info =  thbjattr_thbj-attr.property-value-character .
     1779           end.
     1780         for each tt-upd-attr-fuel no-lock where lookup (tt-upd-attr-fuel.code, v-dop-info) > 0:
     1781         case tt-upd-attr-fuel.code:
     1782           when 'ptbobj':U then do:
     1783               assign
     1784                 f-ptbotype:fgcolor  = 12
     1785                 f-ptbocode:fgcolor  = 12
     1786                 f-ptboname:fgcolor  = 12
     1787                 f-ptbocode-1:fgcolor  = 12
     1788                 .
     1789           end.
     1790           when 'ptb-item-pour':U then do:
     1791               assign
     1792                 f-item-pour:fgcolor   = 12
     1793                 f-item-pour-2:fgcolor = 12
     1794                 .
     1795           end.
     1796           when 'autoent':U then do:
     1797               assign
     1798                 f-autoent-obj-type:fgcolor  = 12
     1799                 f-autoent-obj-code:fgcolor  = 12
     1800                 f-autoent-obj-name:fgcolor  = 12
     1801                 f-autoent:fgcolor           = 12
     1802                 .
     1803           end.
     1804           when 'car-num':U then do:
     1805               assign
     1806                 f-car-num:fgcolor = 12
     1807                 f-car:fgcolor     = 12
     1808                 .
     1809           end.
     1810           when 'fio-driver':U then do:
     1811               assign
     1812                 f-fio:fgcolor = 12
     1813                 f-fio-name:fgcolor  = 12
     1814                 .
     1815           end.
     1816           when 'time-income':U then do:
     1817               assign
     1818                 f-hour-income:fgcolor = 12
     1819                 f-min-income:fgcolor  = 12
     1820                 f-hour-income-2:fgcolor = 12
     1821                 .
     1822           end.
     1823           when 'time-pour':U then do:
     1824               assign
     1825                 f-hour-pour:fgcolor = 12
     1826                 f-min-pour:fgcolor  = 12
     1827                 f-hour-pour-2:fgcolor = 12
     1828                 .
     1829           end.
     1830           when 'date-pour':U then do:
     1831               assign
     1832                 f-date-pour:fgcolor = 12
     1833                 f-date-pour-1:fgcolor = 12
     1834                 .
     1835           end.
     1836           when 'date-income':U then do:
     1837               assign
     1838                 f-date-income:fgcolor = 12
     1839                 f-date-income-2:fgcolor = 12
     1840                 .
     1841           end.
     1842           when 'inspection-cert':U then do:
     1843               assign
     1844                 f-insp-cert:fgcolor = 12
     1845                 f-insp:fgcolor  = 12
     1846                 .
     1847           end.
     1848           when 'date-cert':U then do:
     1849               assign
     1850                 f-date-cert:fgcolor = 12
     1851                 f-insp-2:fgcolor  = 12
     1852                 .
     1853           end.
     1854           when 'date-pasport':U then do:
     1855               assign
     1856                 f-date-pasport:fgcolor = 12
     1857                 f-pasport-num:fgcolor  = 12
     1858                 .
     1859           end.
     1860           when 'num-pasport':U then do:
     1861               assign
     1862                 f-num-pasport:fgcolor = 12
     1863                 f-pasport:fgcolor  = 12
     1864                 .
     1865           end.
     1866           when 'condition':U then do:
     1867               assign
     1868                 f-condition:fgcolor = 12
     1869                 f-condition-name:fgcolor  = 12
     1870                 .
     1871           end.
     1872           when 'seals-condition':U then do:
     1873               assign
     1874                 f-seals-condition:fgcolor = 12
     1875                 f-seals-1:fgcolor = 12
     1876                 f-seals-2:fgcolor = 12
     1877                 f-seals-condition-2:fgcolor = 12
     1878                 .
     1879           end.
     1880           when 'doc-not':U then do:
     1881               assign
     1882                 b-doc:fgcolor = 12
     1883                 f-doc:fgcolor = 12
     1884                 .
     1885           end.
     1886           when 'spisok-not-doc':U then do:
     1887               assign
     1888                 f-item-doc:bgcolor  = 12
     1889                 .
     1890           end.
     1891         end case.
     1892         end.
     1893     WAIT-FOR GO OF FRAME Dialog-Frame.
     1894   END.
     1895   RUN disable_UI.
     1896   PROCEDURE disable_UI :
     1897     HIDE FRAME Dialog-Frame.
     1898   END PROCEDURE.
     1899   PROCEDURE disp-f-ptboname :
     1900     find ub.clients where ub.clients.obj-code = input frame Dialog-Frame f-ptbocode and
     1901                        ub.clients.obj-type = input frame Dialog-Frame f-ptbotype no-lock no-error.
     1902     if available ub.clients then
     1903     disp ub.clients.obj-name @ f-ptboname with frame Dialog-Frame.
     1904     else do:
     1905         display ? @ f-ptboname with frame Dialog-Frame.
     1906         apply "choose" to b-ptb in frame Dialog-Frame.
     1907     end.
     1908   END PROCEDURE.
     1909   PROCEDURE disp-obj-name :
     1910     find ub.clients where ub.clients.obj-code = input frame Dialog-Frame f-autoent-obj-code and
     1911                        ub.clients.obj-type = input frame Dialog-Frame f-autoent-obj-type no-lock no-error.
     1912     if available ub.clients
     1913     then do :
     1914       assign
     1915         v-autoent-obj-type = ub.clients.obj-type
     1916         v-autoent-obj-code = ub.clients.obj-code
     1917       .
     1918       disp ub.clients.obj-name @ f-autoent-obj-name with frame Dialog-Frame.
     1919     end .
     1920     else do:
     1921         display ? @ f-autoent-obj-name with frame Dialog-Frame.
     1922     end.
     1923   END PROCEDURE.
     1924   PROCEDURE enable_UI :
     1925     DISPLAY f-autoent f-autoent-obj-code f-autoent-obj-type f-autoent-obj-name
     1926             f-car f-car-num f-condition-name f-condition f-seals-1
     1927             f-seals-condition f-insp f-insp-cert f-seals-2 f-seals-condition-2
     1928             f-insp-2 f-date-cert f-pasport f-num-pasport f-pasport-num
     1929             f-date-pasport f-fio-name f-fio f-ptbocode-1 f-ptbocode f-ptbotype
     1930             f-ptboname f-date-pour-1 f-date-pour f-hour-pour-2 f-hour-pour
     1931             f-min-pour f-date-income-2 f-date-income f-hour-income-2 f-hour-income
     1932             f-min-income f-item-pour-2 f-item-pour f-acc-ship-2 f-acc-ship f-doc
     1933             b-doc t-clear f-item-doc f-date-start f-date-end f-hour-start
     1934             f-min-start f-hour-end f-min-end
     1935         WITH FRAME Dialog-Frame.
     1936     ENABLE b-save b-quit b-help f-autoent-obj-code f-autoent-obj-type b-clients
     1937            f-car-num b-auto-tank f-condition f-seals-condition f-insp-cert
     1938            f-seals-condition-2 f-date-cert f-num-pasport f-date-pasport f-fio
     1939            f-ptbocode f-ptbotype b-ptb f-date-pour f-hour-pour f-min-pour
     1940            f-date-income f-hour-income f-min-income f-item-pour f-acc-ship b-doc
     1941            t-clear f-date-start f-date-end f-hour-start f-min-start f-hour-end
     1942            f-min-end
     1943         WITH FRAME Dialog-Frame.
     1944     VIEW FRAME Dialog-Frame.
     1945   END PROCEDURE.
     1946   PROCEDURE save-attr :
     1947     define variable v-attr-value as character no-undo.
     1948     define buffer buf_doc-attr for ub.doc-attr.
     1949     do transaction:
     1950       _LABEL_FOR:
     1951       for each tt-upd-attr-fuel no-lock:
     1952         assign
     1953           v-attr-value = ? .
     1954         case tt-upd-attr-fuel.code:
     1955           when 'ptbobj':U then do:
     1956               assign
     1957                 v-attr-value = f-ptbotype + ";" + string (f-ptbocode) when f-ptbotype <> "" and f-ptbocode <> ?.
     1958           end.
     1959           when 'ptb-item-pour':U then do:
     1960               assign
     1961                 v-attr-value = f-item-pour when f-item-pour <> "".
     1962           end.
     1963           when 'autoent':U then do:
     1964               assign
     1965                 v-attr-value = f-autoent-obj-type + ";" + string (f-autoent-obj-code) when f-autoent-obj-code <> ? and f-autoent-obj-type <> "".
     1966           end.
     1967           when 'car-num':U then do:
     1968               assign
     1969                 v-attr-value = f-car-num when f-car-num <> "".
     1970           end.
     1971           when 'fio-driver':U then do:
     1972               assign
     1973                 v-attr-value = f-fio when f-fio <> "".
     1974           end.
     1975           when 'date-income':U then do:
     1976               assign
     1977                 v-attr-value = string(f-date-income) when string(f-date-income) <> "".
     1978           end.
     1979           when 'time-income':U then do:
     1980               assign
     1981                 v-attr-value = string( f-hour-income,   "99":U ) + ":" + string( f-min-income,   "99":U ) when f-hour-income <> ? and f-min-income <> ?.
     1982           end.
     1983           when 'time-pour':U then do:
     1984               assign
     1985                 v-attr-value = string( f-hour-pour,   "99":U ) + ":" + string( f-min-pour,   "99":U ) when f-hour-pour <> ? and f-min-pour <> ?.
     1986           end.
     1987           when 'time-start':U then do:
     1988               assign
     1989                 v-attr-value = string( f-hour-start,   "99":U ) + ":" + string( f-min-start,   "99":U ) when f-hour-start <> ? and f-min-start <> ?.
     1990           end.
     1991           when 'time-end':U then do:
     1992               assign
     1993                 v-attr-value = string( f-hour-end,   "99":U ) + ":" + string( f-min-end,   "99":U ) when f-hour-end <> ? and f-min-end <> ?.
     1994           end.
     1995           when 'date-pour':U then do:
     1996               assign
     1997                 v-attr-value = string(f-date-pour) when string(f-date-pour) <> "".
     1998           end.
     1999           when 'inspection-cert':U then do:
     2000               assign
     2001                 v-attr-value = f-insp-cert when f-insp-cert <> "".
     2002           end.
     2003           when 'date-cert':U then do:
     2004               assign
     2005                 v-attr-value = string(f-date-cert) when string(f-date-cert) <> "".
     2006           end.
     2007           when 'date-pasport':U then do:
     2008               assign
     2009                 v-attr-value = string(f-date-pasport) when string(f-date-pasport) <> "".
     2010           end.
     2011           when 'num-pasport':U then do:
     2012               assign
     2013                 v-attr-value = string(f-num-pasport) when string(f-num-pasport) <> "".
     2014           end.
     2015           when 'condition':U then do:
     2016               assign
     2017                 v-attr-value = f-condition when f-condition <> "".
     2018           end.
     2019           when 'seals-condition':U then do:
     2020               assign
     2021                 v-attr-value = f-seals-condition when f-seals-condition <> "".
     2022               assign
     2023                 v-attr-value = (if v-attr-value = ? then "" else v-attr-value) + chr(4) + f-seals-condition-2 when f-seals-condition-2 <> "".
     2024           end.
     2025           when 'doc-not':U then do:
     2026               assign
     2027                 v-attr-value = string (b-doc) when string (b-doc) <> "".
     2028           end.
     2029           when 'clear-ac':U then do:
     2030             if v-is-lgas
     2031             then
     2032               assign
     2033                 v-attr-value = string (t-clear) when string (t-clear) <> "".
     2034           end.
     2035           when 'spisok-not-doc':U then do:
     2036           if b-doc = yes then do:
     2037               assign
     2038                 v-attr-value = string (f-item-doc) when string (f-item-doc) <> "".
     2039           end.
     2040           else v-attr-value = "".
     2041           end.
     2042           when 'trdcattr-date-start':U then do:
     2043               assign
     2044                 v-attr-value = string(f-date-start) when string(f-date-start) <> "".
     2045           end.
     2046           when 'trdcattr-date-end':U then do:
     2047               assign
     2048                 v-attr-value = string(f-date-end) when string(f-date-end) <> "".
     2049           end.
     2050           otherwise
     2051             next _LABEL_FOR.
     2052         end case.
     2053         find first buf_doc-attr
     2054           where buf_doc-attr.doc-code  = p-doc-code
     2055             and buf_doc-attr.attr-code = tt-upd-attr-fuel.code
     2056           no-error .
     2057         if v-attr-value <> ?
     2058         then do:
     2059           if not available buf_doc-attr
     2060               then do:
     2061                 create buf_doc-attr.
     2062                 assign
     2063                   buf_doc-attr.doc-code   = p-doc-code
     2064                   buf_doc-attr.attr-code = tt-upd-attr-fuel.code.
     2065               end.
     2066   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input buf_doc-attr.doc-code ,
     2067                          input buf_doc-attr.attr-code ,
     2068                          input v-attr-value ) no-error .
     2069           if error-status :error then do:
     2070               message "Ошибка при сохранении атрибута." view-as alert-box.
     2071               undo, return no-apply.
     2072           end.
     2073         end.
     2074         else do:
     2075           if available buf_doc-attr then delete buf_doc-attr.
     2076         end.
     2077       end.
     2078     end.
     2079   END PROCEDURE.
