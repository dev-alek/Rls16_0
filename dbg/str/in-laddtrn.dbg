     1109   DO:
     1110   run disp-obj-name.
     1111   apply "entry" to f-autoent-obj-code in frame Dialog-Frame.
     1112   return no-apply.
     1113   END.
     1114   ON LEAVE OF f-autoent-obj-type IN FRAME Dialog-Frame
     1115   DO:
     1116       run disp-obj-name.
     1117   END.
     1118   ON return OF f-autoent-obj-type IN FRAME Dialog-Frame
     1119   DO:
     1120     run disp-obj-name.
     1121     apply "entry" to f-car-num in frame Dialog-Frame.
     1122   return no-apply.
     1123   END.
     1124   ON leave OF f-car-num IN FRAME Dialog-Frame
     1125   DO:
     1126     assign
     1127       f-car-num.
     1128     find first auto-tank where auto-tank.auto-num = f-car-num no-lock no-error.
     1129     if not available (auto-tank) and not (f-car-num = ? or f-car-num = "" or f-car-num = "?")
     1130     then do:
     1131      message "АЦ с таким гос. номером не найдена. Введите корректный номер АЦ или выберите из справочника." view-as alert-box information title "Сообщение".
     1132      apply "entry" to f-car-num in frame Dialog-Frame .
     1133      return no-apply .
     1134     end.
     1135      if available auto-tank
     1136         then
     1137      do :
     1138         if auto-tank.firm-type <> "" then
     1139         do:
     1140            assign
     1141               f-autoent-obj-type = auto-tank.firm-type
     1142               f-autoent-obj-code = integer (auto-tank.firm-code).
     1143         end.
     1144         else
     1145         do:
     1146            find first auto-tank-attr where auto-tank-attr.attr-code = "auto-firm" and auto-tank-attr.auto-num = auto-tank.auto-num no-error.
     1147            if available (auto-tank-attr)
     1148               then
     1149            do:
     1150               assign
     1151                  f-autoent-obj-type = substring (auto-tank-attr.attr-value, 1, 3)
     1152                  f-autoent-obj-code = integer (substring (auto-tank-attr.attr-value, 4)).
     1153            end.
     1154         end.
     1155         f-autoent-obj-type:screen-value = f-autoent-obj-type.
     1156         f-autoent-obj-code:screen-value = string (f-autoent-obj-code).
     1157         assign
     1158            v-autoent-obj-type = f-autoent-obj-type
     1159            v-autoent-obj-code = f-autoent-obj-code
     1160            .
     1161         run disp-obj-name.
     1162      end .
     1163   END.
