      919   DEFINE FRAME Dialog-Frame
      920        f-hour-end AT ROW 21.5 COL 59.5 COLON-ALIGNED WIDGET-ID 52
      921        f-min-end AT ROW 21.5 COL 64.13 COLON-ALIGNED NO-LABEL WIDGET-ID 56
      922        "Примечание к нефтебазе" VIEW-AS TEXT
      923             SIZE 25.5 BY 1 AT ROW 15.5 COL 1
      924        SPACE(57.12) SKIP(7.03)
      925       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      926            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      927            TITLE "Дополнительная информация по приемке топлива"
      928            DEFAULT-BUTTON b-save CANCEL-BUTTON b-quit.
      929   ASSIGN
      930          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      931          FRAME Dialog-Frame:HIDDEN           = TRUE.
      932   ON GO OF FRAME Dialog-Frame
      933   DO:
      934     define variable stfactplvalue as character no-undo initial ? .
      935     define variable stfactpltype  as character no-undo initial ? .
      936     define variable v-update      as logical   no-undo initial true .
      937     define variable v-revision    as logical   no-undo initial false .
      938     define variable v-percrev     as decimal   no-undo initial ? .
      939     define variable v-auto-tank   as logical   no-undo initial false .
      940     define variable v-percauto    as decimal   no-undo initial ? .
      941     define variable v-inv         as logical   no-undo initial false .
      942     define variable v-percinv     as decimal   no-undo initial ? .
      943     define variable v-inv-set     as logical   no-undo initial false .
      944     assign frame Dialog-Frame  f-autoent-obj-code
      945                                 f-autoent-obj-name
      946                                 f-autoent-obj-type
      947                                 f-car-num
      948                                 f-condition
      949                                 f-seals-condition
      950                                 f-seals-condition-2
      951                                 f-insp-cert
      952                                 f-date-cert
      953                                 f-pasport
      954                                 f-pasport-num
      955                                 f-date-pasport
      956                                 f-num-pasport
      957                                 f-fio
      958                                 f-ptbocode
      959                                 f-ptbotype
      960                                 f-ptboname
      961                                 f-hour-income
      962                                 f-min-income
      963                                 f-item-pour
      964                                 f-hour-pour
      965                                 f-min-pour
      966                                 f-date-pour
      967                                 f-date-income
      968                                 f-acc-ship
      969                                 b-doc
      970                                 f-item-doc
      971                                 f-hour-start
      972                                 f-min-start
      973                                 f-hour-end
      974                                 f-min-end
      975                                 f-date-start
      976                                 f-date-end
      977                                 t-clear
      978     .
      979     if input frame Dialog-Frame f-hour-income <> ?
      980       and input frame Dialog-Frame f-hour-income > 24
      981     then do:
      982        message "Неверно заведено поле <<час>>." view-as alert-box .
      983        apply "entry" to f-hour-income in frame Dialog-Frame .
      984        return no-apply .
      985     end.
      986     if input frame Dialog-Frame f-min-income > 60
      987     then do:
      988        message "Неверно заведено поле <<минуты>>." view-as alert-box .
      989        apply "entry" to f-min-income in frame Dialog-Frame .
      990        return no-apply .
      991     end.
      992     find ub.clients no-lock where
      993          ub.clients.obj-type = f-ptbotype and
      994          ub.clients.obj-code = f-ptbocode no-error .
      995     if not available ub.clients
      996     then do:
      997       assign
      998         f-ptbotype = ""
      999         f-ptbocode = ?
     1000       .
     1001     end.
     1002     run save-attr.
     1003   END.
     1004   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1005   DO:
     1006     APPLY "END-ERROR":U TO SELF.
     1007   END.
     1008   ON CHOOSE OF b-auto-tank IN FRAME Dialog-Frame
     1009   DO:
     1010     define variable v-rec-tank as recid     no-undo.
     1011     define variable v-rec-meas as recid     no-undo.
     1012     assign v-rec-tank = ?
     1013            v-rec-meas = ?.
     1014     run str/auto-tn.w (input parparentproc,
     1015                 input "b-sel",
     1016                 input v-autoent-obj-type,
     1017                 input v-autoent-obj-code,
     1018                 output v-rec-tank,
     1019                 output v-rec-meas) no-error.
     1020     if v-rec-tank <> ? then do:
     1021       find first auto-tank where recid (auto-tank) = v-rec-tank no-lock.
     1022       assign
     1023           f-car-num    = auto-tank.auto-num
     1024       .
     1025       assign
     1026         f-autoent-obj-type = auto-tank.firm-type
     1027         f-autoent-obj-code = integer (auto-tank.firm-code).
     1028         f-autoent-obj-type:screen-value = f-autoent-obj-type.
     1029         f-autoent-obj-code:screen-value = string (f-autoent-obj-code).
     1030       assign
     1031         v-autoent-obj-type = f-autoent-obj-type
     1032         v-autoent-obj-code =  f-autoent-obj-code
     1033       .
     1034       display f-car-num with frame Dialog-Frame.
     1035     end.
     1036     apply "leave" to f-car-num in frame Dialog-Frame.
     1037   END.
     1038   ON CHOOSE OF b-clients IN FRAME Dialog-Frame
     1039   DO:
     1040   define variable ref-list as character no-undo.
     1041   define variable ref-rec  as recid     no-undo.
     1042   find first ub.trn-doc no-lock where ub.trn-doc.doc-code = p-doc-code no-error.
     1043      run ref/cli-all.w (parparentproc
     1044                   , "b-sel"
     1045                   , 'орг':U
     1046                   , ?
     1047                   , ?
     1048                   , ?
     1049                   , ?
     1050                   , substitute("auto-tank-for-supp=&1&2",ub.trn-doc.cli-type,ub.trn-doc.cli-code)
     1051                   , output ref-list) .
     1052   if ref-list <> "" then do:
     1053     ref-rec = integer (ref-list).
     1054     find ub.clients where recid ( ub.clients ) = ref-rec no-lock.
     1055     disp ub.clients.obj-code @ f-autoent-obj-code
     1056          ub.clients.obj-type @ f-autoent-obj-type
     1057          ub.clients.obj-name @ f-autoent-obj-name with frame Dialog-Frame.
     1058     assign
     1059       v-autoent-obj-type = ub.clients.obj-type
     1060       v-autoent-obj-code = ub.clients.obj-code
     1061     .
     1062   end.
     1063   END.
     1064   ON VALUE-CHANGED OF b-doc IN FRAME Dialog-Frame
     1065   DO:
     1066     if b-doc:SCREEN-VALUE = "yes" then do:
     1067       enable
     1068       f-item-doc
     1069       with frame Dialog-Frame .
     1070     end.
     1071     else do:
     1072       HIDE
     1073       f-item-doc
     1074       in frame Dialog-Frame .
     1075     end.
     1076   END.
     1077   ON CHOOSE OF b-ptb IN FRAME Dialog-Frame
     1078   DO:
     1079   define variable ref-list as character no-undo.
     1080   define variable ref-rec  as recid     no-undo.
     1081     find first ub.trn-doc no-lock where ub.trn-doc.doc-code = p-doc-code no-error.
     1082        run ref/cli-all.w (parparentproc
     1083                     , "b-sel"
     1084                     , 'орг':U
     1085                     , ?
     1086                     , ?
     1087                     , ?
     1088                     , ?
     1089                     , substitute("tank-farm-for-supp=&1&2",ub.trn-doc.cli-type,ub.trn-doc.cli-code)
     1090                     , output ref-list) .
     1091     if ref-list <> "" then do:
     1092       ref-rec = integer (ref-list).
     1093       find ub.clients where recid ( ub.clients ) = ref-rec no-lock.
     1094       disp ub.clients.obj-code @ f-ptbocode
     1095            ub.clients.obj-type @ f-ptbotype
     1096            ub.clients.obj-name @ f-ptboname with frame Dialog-Frame.
     1097     end.
     1098   END.
     1099   ON return OF f-acc-ship IN FRAME Dialog-Frame
     1100   DO:
     1101       apply "entry" to f-hour-income in frame Dialog-Frame.
     1102   return no-apply.
