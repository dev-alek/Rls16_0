      155   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      156   procedure cur-time :
      157      define output parameter p-today as date      no-undo .
      158      define output parameter p-time  as integer   no-undo .
      159     do
      160     on error undo, return error
      161     :
      162       define variable v-date1 as date      no-undo .
      163       define variable v-date2 as date      no-undo .
      164       define variable v-time  as integer   no-undo .
      165       assign
      166         v-date1 = today
      167         v-time  = time
      168         v-date2 = today
      169       .
      170       if v-date1 <> v-date2
      171       then do:
      172         assign
      173           v-date1 = today
      174           v-time  = v-time
      175         .
      176       end.
      177       assign
      178         p-today = v-date1
      179         p-time  = v-time
      180       .
      181     end.
      182   end.
      183   function cur-time-date returns character
      184   :
      185     return string(today, '99/99/9999':U) .
      186   end.
      187   function cur-time-mjd returns decimal
      188   :
      189     define variable v-date as date      no-undo .
      190     define variable v-time as integer   no-undo .
      191     run cur-time in this-procedure
      192       (output v-date
      193       ,output v-time
      194       ) .
      195     return integer(v-date) - 2400002 + (v-time / 86400) .
      196   end.
      197   function cur-time-get-ending-index returns integer
      198   (input p-number as integer
      199   )
      200   :
      201     if p-number < 0
      202     or p-number = ?
      203     then do:
      204       return 1 .
      205     end.
      206     define variable v-rest as integer   no-undo .
      207     assign
      208       p-number = p-number modulo 100
      209     .
      210     if p-number < 20
      211     then do:
      212       assign
      213         v-rest = p-number
      214       .
      215     end.
      216     else do:
      217       assign
      218         v-rest = p-number modulo 10
      219       .
      220     end.
      221     case v-rest :
      222       when 1
      223       then do:
      224         return 2 .
      225       end.
      226       when 2 or
      227       when 3 or
      228       when 4
      229       then do:
      230         return 3 .
      231       end.
      232       otherwise do:
      233         return 1 .
      234       end.
      235     end case .
      236   end.
      237   procedure cur-time-mjd-to-date :
      238      define input  parameter i-mjd-diff as decimal no-undo.
      239      define output parameter o-Date     as date    no-undo.
      240      define output parameter o-Time     as integer no-undo.
      241      define variable v-day-number as integer   no-undo .
      242      if    i-mjd-diff < 0
      243         or i-mjd-diff = ?
      244      then do:
      245         return "?" .
      246      end.
      247      assign
      248         v-day-number = truncate(i-mjd-diff,0).
      249         o-Date = date(v-day-number + 2400002).
      250         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252   end.
      253   function cur-time-mjd-to-string returns character
      254   (input p-mjd-diff as decimal
      255   )
      256   :
      257     define variable v-day-number as integer   no-undo .
      258     define variable v-seconds    as integer   no-undo .
      259     define variable v-hour       as integer   no-undo .
      260     define variable v-min        as integer   no-undo .
      261     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      262     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      263     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      264     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      265     if p-mjd-diff < 0
      266     or p-mjd-diff = ?
      267     then do:
      268       return "?" .
      269     end.
      270     assign
      271       v-day-number = integer(truncate(p-mjd-diff,0))
      272       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      273     .
      274     if v-seconds > 86400
      275     then do:
      276       assign
      277         v-seconds = 86400 - 1
      278       .
      279     end.
      280     if v-seconds < 0
      281     then do:
      282       assign
      283         v-seconds = 0
      284       .
      285     end.
      286     assign
      287       v-hour = truncate(v-seconds / 3600, 0)
      288     .
      289     assign
      290       v-seconds = v-seconds modulo 3600
      291     .
      292     assign
      293       v-min = truncate(v-seconds / 60, 0)
      294     .
      295     assign
      296       v-seconds = v-seconds modulo 60
      297     .
      298     return
      299         (if v-day-number <> 0
      300           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      301           else ""
      302         )
      303       + (if v-day-number <> 0 or v-hour <> 0
      304           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      305           else ""
      306         )
      307       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      308           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      309           else ""
      310         )
      311       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      312       .
      313   end.
      314   function cur-time-string returns character
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      323   end.
      324   function cur-time-string-sec returns character
      325   :
      326     define variable v-date as date      no-undo .
      327     define variable v-time as integer   no-undo .
      328     run cur-time in this-procedure
      329       (output v-date
      330       ,output v-time
      331       ) .
      332     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      333   end.
      334   function cur-time-custom  returns character
      335   (input p-prefix as character
      336   ,input p-date-format as character
      337   ,input p-delimiter as character
      338   ,input p-time-format as character
      339   ,input p-suffix as character
      340   )
      341   :
      342     define variable v-date as date      no-undo .
      343     define variable v-time as integer   no-undo .
      344     run cur-time in this-procedure
      345       (output v-date
      346       ,output v-time
      347       ) .
      348     return
      349       p-prefix
      350       + string(v-date, p-date-format)
      351       + p-delimiter
      352       + string(v-time, p-time-format)
      353       + p-suffix
      354       .
      355   end.
      356   function cur-time-print  returns character
      357   :
      358     define variable v-date as date      no-undo .
      359     define variable v-time as integer   no-undo .
      360     run cur-time in this-procedure
      361       (output v-date
      362       ,output v-time
      363       ) .
      364     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      365   end.
      366   function cur-time-datetime returns datetime
      367   :
      368     define variable v-char as character no-undo .
      369     define variable v-datetime as datetime no-undo .
      370     v-char = cur-time-string().
      371     v-datetime = datetime(v-char).
      372     return  v-datetime.
      373   end.
      374   function cur-time-string-msec returns character
      375   :
      376     define variable v-date as datetime  no-undo .
      377     v-date = now.
      378     return string(v-date) .
      379   end.
      380   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      383   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
      384   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
      385   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
      386   define variable ptrlprop-autopump      as logical   no-undo initial false .
      387   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
      388   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
      389   define variable ptrlprop-olddens       as logical   no-undo initial false .
      390   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
      391   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
      392   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
      393   define variable ptrlprop-algoincome as integer no-undo init 0.
      394   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
      395   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
      396   define variable ptrlprop-Delta-mass-vert       as character no-undo .
      397   define variable ptrlprop-calc-free-vol as logical no-undo init false.
      398   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
      399   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
      400   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
      401   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
      402   define variable ptrlprop-block-nozzle as logical no-undo init false.
      403   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
      404   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
      405   procedure get-ptrl-prop :
      406     define input  parameter p-obj-type as character no-undo .
      407     define input  parameter p-obj-code as integer   no-undo .
      408     do
      409     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      410     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      411     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      412     :
      413       define variable par-type          as character no-undo.
      414       define variable v-value-character as character no-undo .
      415       define variable v-value-date      as date      no-undo .
      416       define variable v-value-decimal   as decimal   no-undo .
      417       define variable v-value-integer   as integer   no-undo .
      418       define variable v-value-logical   as logical   no-undo .
      419       for each thbjattr_thbj-attr
      420       :
      421         delete thbjattr_thbj-attr .
      422       end.
      423       run adm/shattri.p
      424         ( input "get":U
      425         , input p-obj-type
      426         , input p-obj-code
      427         , input 'petrol':U
      428         , input  ""
      429         , output v-value-character
      430         , output v-value-date
      431         , output v-value-decimal
      432         , output v-value-integer
      433         , output v-value-logical
      434         , output par-type
      435         , input-output table thbjattr_thbj-attr
      436         ) no-error .
      437       for each thbjattr_thbj-attr
      438       on error undo, return error return-value
      439       :
      440         case thbjattr_thbj-attr.prop-code :
      441           when 'denstclc':U then do:
      442             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      443               assign
      444                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      445               .
      446             end.
      447           end.
      448           when 'expptrl':U then do:
      449             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      450               and thbjattr_thbj-attr.prop-value-type = 'character':U
      451             then do:
      452               assign
      453                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      454               .
      455             end.
      456           end.
      457           when 'inpptrl':U then do:
      458             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      459               and thbjattr_thbj-attr.prop-value-type = 'character':U
      460             then do:
      461               assign
      462                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      463               .
      464             end.
      465           end.
      466           when 'autopump':U then do:
      467             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      468               assign
      469                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      470               .
      471             end.
      472           end.
      473           when 'rvsnmter':U then do:
      474             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      475               assign
      476                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      477               .
      478             end.
      479           end.
      480           when 'avtinvpm':U then do:
      481             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      482               assign
      483                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      484               .
      485             end.
      486           end.
      487           when 'invclipt':U then do:
      488             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      489               assign
      490                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      491               .
      492             end.
      493           end.
      494           when 'olddens':U then do:
      495             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      496               assign
      497                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      498               .
      499             end.
      500           end.
      501           when 'algrvspt':U then do:
      502             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      503               assign
      504                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      505               .
      506             end.
      507           end.
      508           when 'temp-for-pomi':U then do:
      509             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      510               assign
      511                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      512               .
      513             end.
      514           end.
      515           when 'algoincome':U then do:
      516             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      517               assign
      518                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      519               .
      520             end.
      521           end.
      522           when 'mand-choice-autocar':U then do:
      523             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      524               assign
      525                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      526               .
      527             end.
      528           end.
      529           when 'block-nozzle':U then do:
      530             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      531               assign
      532                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      533               .
      534             end.
      535           end.
      536           when 'timeout-block-nozzle':U then do:
      537             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      538               assign
      539                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      540               .
      541             end.
      542           end.
      543           when 'Delta-mass-horiz':U then do:
      544             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      545               assign
      546                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      547               .
      548             end.
      549           end.
      550           when 'Delta-mass-vert':U then do:
      551             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      552               assign
      553                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      554               .
      555             end.
      556           end.
      557           when 'calc-free-vol':U then do:
      558             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      559               assign
      560                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
      561               .
      562             end.
      563           end.
      564           when 'calc-free-vol-sug':U then do:
      565             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      566               assign
      567                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
      568               .
      569             end.
      570           end.
      571           when 'trn-reas-sug':U then do:
      572             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      573               assign
      574                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
      575               .
      576             end.
      577           end.
      578                 when 'rvd-own-nb':U then do:
      579             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      580               assign
      581                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
      582               .
      583             end.
      584           end.
      585           when 'qr-scan-time':U then do:
      586             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      587               assign
      588                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
      589               .
      590             end.
      591           end.
      592           when 'autopump-skip-time':U then do:
      593             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      594               assign
      595                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
      596               .
      597             end.
      598           end.
      599         end case.
      600         delete thbjattr_thbj-attr .
      601       end.
      602     end.
      603     return .
      604   end procedure.
