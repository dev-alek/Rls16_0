      612   function getDevice returns integer ():
      613      define variable v-device-kind as integer no-undo.
      614      define buffer buf_cash-desk for ub.cash-desk .
      615      find first buf_cash-desk no-lock where buf_cash-desk.db-num = mdb-num and
      616      buf_cash-desk.obj-code = mObjCode and
      617      buf_cash-desk.pos-type = mPostType and
      618      buf_cash-desk.cash-num = mCashNum no-error .
      619      if available (buf_cash-desk) then do:
      620          v-device-kind = buf_cash-desk.device-kind .
      621      end.
      622      if v-device-kind = ?
      623      then v-device-kind = 0.
      624      return v-device-kind.
      625   end.
      626   define variable mParent as character no-undo.
      627   define variable mDevice as integer   no-undo.
      628   procedure putc :
      629      define input parameter iSAXWriter as handle no-undo .
      630      define input parameter i-action   as character  no-undo .
      631      define input parameter p-value    as character  no-undo .
      632      define output parameter oSend      as logical    no-undo.
      633      define buffer code-group for ub.code.
      634      define buffer code-param for ub.code.
      635      mDevice = getDevice().
      636      mParent = substitute ("&2&1&3",chr(4),  "Cash-param",  mDevice ).
      637     for each code-group where code-group.parent     eq mParent no-lock:
      638         iSAXWriter:start-element("KeyMap").
      639         do:
      640            iSAXWriter:insert-attribute("ctrl",   "READ"              )   no-error.
      641            iSAXWriter:insert-attribute("map",    "R"            )   no-error.
      642            iSAXWriter:start-element("PosKey").
      643            do:
      644               iSAXWriter:insert-attribute("scan", "*"      )   no-error.
      645            end.
      646            iSAXWriter:end-element("PosKey" ).
      647         end.
      648         iSAXWriter:end-element("KeyMap" ).
      649         iSAXWriter:start-element("KeyMap").
      650         do:
      651            iSAXWriter:insert-attribute("ctrl",   "READ"              )   no-error.
      652            iSAXWriter:insert-attribute("map",    "F"            )   no-error.
      653            iSAXWriter:start-element("PosKey").
      654            do:
      655               iSAXWriter:insert-attribute("scan", "*"      )  .
      656            end.
      657            iSAXWriter:end-element("PosKey" ).
      658         end.
      659         iSAXWriter:end-element("KeyMap" ).
      660         oSend = yes.
      661         leave.
      662      end.
      663      mParent = substitute ("&2&1&3",chr(4),  mParent,  2 ).
      664   end procedure.
      665   procedure get-cash-types:
      666      define output parameter otypes as character no-undo init "Autotank,IBM-XML".
      667   end.
      668   procedure get-root-teg:
      669      define output parameter otypes as character no-undo init "config".
      670   end.
      671   define variable parparentproc as handle no-undo.
      672   define variable mLogHandle    as handle no-undo.
      673   define variable mLogFile      as character no-undo.
      674   procedure set-context:
      675      define input         parameter iparparentproc as handle      no-undo.
      676      define input         parameter i-log-handle   as handle      no-undo.
      677      define input         parameter iLogFile       as character   no-undo.
      678      define output        parameter oProcIndo      as character   no-undo init "Настроек клавиатуры".
      679      assign
      680         parparentproc = iparparentproc
      681         mLogHandle    = i-log-handle
      682         mLogFile      = iLogFile
      683      .
      684   end.
      685   procedure set-cash-info:
      686      define input         parameter iDB-num        as integer     no-undo.
      687      define input         parameter iObjType       as character   no-undo.
      688      define input         parameter iObjCode       as integer     no-undo.
      689      define input         parameter iPostType      as character   no-undo.
      690      define input         parameter iCashNum       as integer     no-undo.
      691      assign
      692         mDB-num       = iDB-num
      693         mObjType      = iObjType
      694         mObjCode      = iObjCode
      695         mPostType     = iPostType
      696         mCashNum      = iCashNum
      697         Mfirst        = true
      698      .
      699   end.
      700   define variable mOk      as logical   no-undo init ?.
      701   procedure parse-result:
      702      define input         parameter iWebRespMptr  as memptr      no-undo.
      703      define input-output  parameter pViewLog      as logical     no-undo.
      704      mOk = ?.
      705      define variable hParser as handle no-undo.
      706      create sax-reader hParser.
      707      hParser:set-input-source("memptr", iWebRespMptr).
      708      hParser:sax-parse () no-error.
      709      if error-status:error
      710      then do:
      711         if error-status:num-messages > 0 then
      712            return error error-status:get-message(1).
      713         else
      714            return error return-value.
      715      end.
      716      delete object hParser.
      717      if not mOk
      718      then
      719         pViewLog = yes.
      720   end.
      721   procedure StartDocument:
      722   end procedure.
      723   define temp-table tt-cash-param-hist no-undo like ub.cash-param-hist .
      724   define variable mElement as character no-undo.
      725   define variable mMode as character no-undo.
      726   define variable mtstamp as decimal no-undo.
      727   procedure StartElement:
      728     define input parameter namespaceURI as character.
      729     define input parameter localName as character.
      730     define input parameter qname as character.
      731     define input parameter attributes as handle.
      732     mElement = qname.
      733     if mElement = "PosKey" then do:
      734       empty temp-table tt-cash-param-hist.
      735       create tt-cash-param-hist.
      736       assign
      737         tt-cash-param-hist.obj-type    = mObjType
      738         tt-cash-param-hist.obj-code    = mObjCode
      739         tt-cash-param-hist.device      = mDevice
      740         tt-cash-param-hist.cash-num    = mCashNum
      741         tt-cash-param-hist.param_section      = "2"
      742         tt-cash-param-hist.param_value_dop    = mMode
      743         tt-cash-param-hist.tstamp      = mtstamp
      744       .
      745     end.
      746     else if mElement = "KeyMap" then do:
      747        mMode = attributes:get-value-by-qname("mode").
      748     end.
      749     else if mElement = "config"
      750     then do:
      751        mtstamp = dec(attributes:get-value-by-qname("tstamp"))  + timezone(now) * 60.
      752     end.
      753   end procedure.
      754   procedure Characters:
      755     define input parameter charData as memptr.
      756     define input parameter numChars as integer.
      757     define variable vCurrContent as longchar no-undo.
      758     define variable vLengthMemptr as int64 no-undo.
      759     define variable vReadByte as int64 no-undo.
      760     define variable vRead     as integer no-undo.
      761     vLengthMemptr = numChars.
      762     do while vLengthMemptr - vReadByte > 0 :
      763        vRead = min(vLengthMemptr - vReadByte,30000).
      764        vCurrContent = vCurrContent + GET-STRING(charData,vReadByte + 1,vRead).
      765        vReadByte = vReadByte + vRead.
      766     end.
      767     if trim(vCurrContent) = "" then return.
      768     case mElement:
      769       when "PKMgr" then
      770         tt-cash-param-hist.param_value = if int(vCurrContent) > 0 then "MGR" else "REG" .
      771       when "PKFun" then
      772         tt-cash-param-hist.param_group = vCurrContent .
      773       when "PKValue" then
      774         tt-cash-param-hist.param_name = vCurrContent .
      775       when "ErrorMessage" then
      776         run write-log-and-file in mLogHandle (
      777                                  input 1
      778                                , input mLogFile
      779                                , input 1
      780                                , input vCurrContent ).
      781     end case.
      782   end procedure.
      783   procedure EndElement:
      784      define input parameter name_ as character.
      785      define input parameter localName as character.
      786      define input parameter qName as character.
      787      if qname = "ErrorMessage" then do:
      788         mOk = false.
      789      end.
      790      else if qname = "PosKey" then do:
      791         if     tt-cash-param-hist.param_value ne ""
      792            and tt-cash-param-hist.param_value ne ?
      793         then do:
      794            define variable vParantNotCaseSens as character no-undo.
      795             define variable vCodeNotCaseSens as character no-undo.
      796             vParantNotCaseSens = mParent +  chr(4) + tt-cash-param-hist.param_group.
      797             vCodeNotCaseSens   = tt-cash-param-hist.param_name.
      798            find first code where code.parent eq vParantNotCaseSens
      799                              and code.code   eq vCodeNotCaseSens
      800            no-lock no-error.
      801            if not available code
      802            then do:
      803               create code.
      804               assign
      805                  code.parent    = mParent  + chr(4) + tt-cash-param-hist.param_group
      806                  code.code      = tt-cash-param-hist.param_name
      807                  code.codevalue = tt-cash-param-hist.param_value
      808                  code.status_   = 1
      809               .
      810            end.
      811         end.
      812      end.
      813   end procedure.
      814   procedure EndDocument:
      815     if mOk eq ?
      816     then
      817        mOk = true.
      818   end procedure.
      819   procedure Warning:
      820     define input parameter ErrMessage as character no-undo.
      821     message "The following WARNING was generated:~n" + ErrMessage
      822          view-as alert-box info buttons ok.
      823   end procedure.
      824   procedure Error:
      825     define input parameter ErrMessage as character no-undo.
      826     message "The following NONFATAL ERROR was generated:~n" + ErrMessage
      827          view-as alert-box info buttons ok.
      828   end procedure.
      829   procedure FatalError:
      830     define input parameter ErrMessage as character no-undo.
      831     return error "The following FATAL ERROR was generated:~n" + ErrMessage.
      832   end procedure.
