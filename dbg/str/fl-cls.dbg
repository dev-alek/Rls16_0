        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile: fl-cls.p $":U .
        6   define variable vss-archive     as character no-undo initial "$Archive: str/fl-cls.p $":U .
        7   define variable vss-description as character no-undo initial "Проверка при закрытии флористких заказов  с накл-":U .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define new global shared variable g#lib-trn  as handle no-undo .
       69   define new global shared variable g#lib-trn2 as handle no-undo .
       70   define new global shared variable g#lib-trn3 as handle no-undo .
       71   define new global shared variable g#lib-trn4 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define new global shared variable g#trdcalib as handle no-undo.
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120     define variable v-cntxt-db-num        as integer   no-undo .
      121     define variable v-cntxt-userid        as character no-undo .
      122     define variable v-cntxt-level         as character no-undo .
      123     define variable v-cntxt-host-code-obj as integer   no-undo .
      124     define variable v-cntxt-obj-type      as character no-undo .
      125     define variable v-cntxt-obj-code      as integer   no-undo .
      126     define variable v-cntxt-db-num-obj    as integer   no-undo .
      127     define variable v-cntxt-is-admin      as logical   no-undo .
      128   define input  parameter parParentProc  as widget-handle no-undo.
      129   define input  parameter p-doc-code as character no-undo .
      130   define output parameter v-ok as logical   no-undo .
      131   define buffer buf_trn-doc  for trn-doc .
      132   define buffer buf_doc-line for doc-line .
      133   define buffer buf_gds-dtl  for gds-dtl .
      134   v-ok = true .
      135   find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code no-error .
      136   if buf_trn-doc.status_ = 'запрос':U then do:
      137     define variable v-nabor as logical   no-undo .
      138     for each buf_doc-line  no-lock  where buf_doc-line.doc-code = p-doc-code ,
      139       first goods no-lock where goods.artic      = buf_doc-line.artic     and
      140                                 goods.prod-type  = buf_doc-line.prod-type and
      141                                 goods.prod-code  = buf_doc-line.prod-code  :
      142   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      143   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_grp-nabor in g#lib-trn3
      144   ( input  goods.gds-code ,
      145     output v-nabor
      146   )
      147   .
      148       if v-nabor = false then do:
      149           message "В статусе ЗАПР <заказ на исполнение> не должен содержать товары: " skip
      150                   goods.artic skip
      151                   goods.gds-name
      152           view-as alert-box error  .
      153           v-ok = false  .
      154           return.
      155       end.
      156     end.
      157     define variable v-d as character no-undo .
      158     define variable v-t as character no-undo .
      159   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      160                           input '0rsrv-date':U ,
      161                          output v-d ,
      162                          output v-t )  .
      163       if v-d = ""  then do:
      164       message "Не задана дата выполнения заказа !"  view-as alert-box error  .
      165       v-ok = false  .
      166       return.
      167       end.
      168   define variable v-exist as character no-undo .
      169   define variable v-exist2 as character no-undo .
      170   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      171                           input '4ord_dl':U ,
      172                          output v-exist ,
      173                          output v-t )  .
      174   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      175                           input '5deliv':U ,
      176                          output v-exist2 ,
      177                          output v-t )  .
      178     if v-exist = "yes"   and
      179        v-exist2 = ""  then    do:
      180      message "Не задана сумма доставки , но доставка указана !"  view-as alert-box error .
      181      v-ok = false  .
      182      return.
      183     end.
      184     if v-exist <> "yes"   and
      185        dec(v-exist2) > 0 then  do:
      186      message "Не указана доставка !" view-as alert-box error  .
      187      v-ok = false  .
      188      return.
      189     end.
      190   end.
      191   else do:
      192     if not can-find ( first buf_gds-dtl no-lock where buf_gds-dtl.doc-code = p-doc-code ) then do:
      193       message "Нет товаров в накладной! " skip
      194       view-as alert-box error  .
      195       v-ok = false  .
      196       return.
      197     end.
      198     define variable v-tov as logical   no-undo .
      199     for each buf_doc-line  no-lock  where buf_doc-line.doc-code = p-doc-code ,
      200       first goods no-lock where goods.artic      = buf_doc-line.artic     and
      201                                 goods.prod-type  = buf_doc-line.prod-type and
      202                                 goods.prod-code  = buf_doc-line.prod-code  :
      203   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      204   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_grp-nabor in g#lib-trn3
      205   ( input  goods.gds-code ,
      206     output v-tov
      207   )
      208   .
      209       if v-tov = false then leave.
      210     end.
      211     if v-tov = true  then do:
      212           message "Нет товаров в накладной! " skip
      213           view-as alert-box error  .
      214           v-ok = false  .
      215           return.
      216      end.
      217   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_delnabor in g#lib-trn3
      218   ( input parParentProc ,
      219     input p-doc-code
      220   ) no-error
      221   .
      222         if error-status :error then message return-value error-status :get-message(1)  "***".
      223   end.
