      427   procedure create_obj-list :
      428      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      429      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      430      do
      431      on error undo, return error return-value
      432      :
      433         define buffer cli-obj for ub.clients .
      434         define variable p-var as integer no-undo .
      435         define buffer buf_obj-list for obj-list .
      436         find last buf_obj-list  use-index pi no-error .
      437         if available buf_obj-list
      438         then
      439            p-var = buf_obj-list.obj-id + 1.
      440         else
      441            p-var = 1.
      442         find first cli-obj where
      443                   cli-obj.obj-type = p-obj-type
      444               and cli-obj.obj-code = p-obj-code
      445         no-lock no-error.
      446         if available cli-obj
      447         then do:
      448            create buf_obj-list.
      449            assign
      450               buf_obj-list.obj-id   = p-var
      451               buf_obj-list.obj-code = cli-obj.obj-code
      452               buf_obj-list.obj-type = cli-obj.obj-type
      453               buf_obj-list.obj-name = cli-obj.obj-name
      454               buf_obj-list.db-num   = cli-obj.db-num
      455            .
      456         end.
      457      end.
      458   end.
