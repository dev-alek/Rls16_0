      876   function breakstr returns character ( input        for-name    as character,
      877                                         input        line-length as integer,
      878                                         input-output line1       as character,
      879                                         input-output line2       as character ) :
      880     define variable ii as integer no-undo.
      881     if length( for-name ) > line-length then do:
      882       assign ii    = 1
      883              line1 = "":u
      884              line2 = "":u.
      885       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      886         assign line1 =       substring( for-name, 1, line-length     )
      887                line2 = trim( substring( for-name,    line-length + 1 ) ).
      888       end.                                                     else do:
      889         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      890           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      891                  ii    = ii    + 1.
      892           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      893             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      894           end.
      895         end.
      896         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      897       end.
      898     end.                                else do:
      899       assign line1 = for-name
      900              line2 = "":u.
      901     end.
      902     return ( line1 ).
      903   end function.
      904   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      905   procedure fltfield-clear :
      906     define output parameter loc-fld as character no-undo.
      907     define output parameter loc-lab as character no-undo .
      908     define output parameter loc-spr as character no-undo .
      909     define output parameter loc-dim as character no-undo .
      910     assign
      911       loc-fld = ""
      912       loc-lab = ""
      913       loc-spr = ""
      914       loc-dim = "0"
      915     .
      916   end procedure .
      917   procedure fltfield-add :
      918     define input        parameter par-fld as character no-undo.
      919     define input        parameter par-lab as character no-undo .
      920     define input        parameter par-spr as character no-undo .
      921     define input-output parameter loc-fld as character no-undo.
      922     define input-output parameter loc-lab as character no-undo .
      923     define input-output parameter loc-spr as character no-undo .
      924     define input-output parameter loc-dim as character no-undo .
      925     do
      926     on error undo, return error
      927     :
      928       assign
      929       loc-fld = if loc-dim = '0'
      930                 then par-fld
      931                 else (loc-fld + chr(44) + par-fld)
      932       loc-lab = if loc-dim = '0'
      933                 then par-lab
      934                 else (loc-lab + chr(44) + par-lab)
      935       loc-spr = if loc-dim = '0'
      936                 then par-spr
      937                 else (loc-spr + chr(44) + par-spr)
      938       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      939                 string(integer(if num-entries(loc-dim) > 1
      940                               then entry(2, loc-dim)
      941                               else entry(1, loc-dim)
      942                               ) + 1)
      943       no-error
      944       .
      945     end.
      946   end procedure.
      947   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   define variable v-waitfram-action01         as character   no-undo .
      949   define variable v-waitfram-action02         as character   no-undo .
      950   define variable v-waitfram-action03         as character   no-undo .
      951   define variable mWaitFramTextBeg            as character   no-undo.
      952   define variable mWaitFramTextEnd            as character   no-undo.
      953   define variable mWaitFramView               as logical     no-undo.
      954   define variable mWaitProcEvent              as logical     no-undo init yes.
      955   define variable mWaitFramInterval           as integer     no-undo init 1 .
      956   define variable mWaitFramStop               as logical     no-undo.
      957   define variable mWaitFramStopUser           as logical     no-undo.
      958   define variable mWaitFramStopTimeOut        as logical     no-undo.
      959   define variable mWaitFramStartProc          as datetime-tz no-undo.
      960   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      961   define button B-WaitFramStop auto-end-key
      962        label "Стоп"
      963        size 10 by 1 tooltip "Остоновить процесс".
      964   define button B-viewProcInfo
      965        label "Информация"
      966        size 15 by 1 tooltip "Информация о процесс".
      967   define frame waitfram
      968     v-waitfram-action01 format "x(72)" no-label skip
      969     v-waitfram-action02 format "x(72)" no-label skip
      970     v-waitfram-action03 format "x(72)" no-label skip
      971     B-viewProcInfo
      972     B-WaitFramStop at row 4 col 30
      973     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      974     .
      975   define new global shared variable mBatchMode as logical no-undo init ?.
      976   define variable mFramBachModHandle as handle no-undo.
      977   mFramBachModHandle = frame waitfram:handle.
      978   define variable mFameOldVis as logical no-undo.
      979   define variable mVisCUrentVin as logical no-undo.
      980   if session:batch-mode
      981   then
      982      mBatchMode = yes.
      983   if mBatchMode = ? then do:
      984     mVisCUrentVin = current-window:visible.
      985     mFameOldVis = mFramBachModHandle:visible.
      986     mFramBachModHandle:visible  = yes.
      987     mBatchMode = mFramBachModHandle:visible ne yes.
      988     mFramBachModHandle:visible = mFameOldVis.
      989     current-window:visible = mVisCUrentVin.
      990   end.
      991    if  log-manager:logfile-name ne ?
      992     then DO:
      993         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      994         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      995         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      996     end.
      997   on choose of B-WaitFramStop in frame waitfram
      998   do:
      999     mWaitFramStop = yes.
     1000     mWaitFramStopUser = yes.
     1001   end.
     1002   function waitfram-check-timeout returns logical():
     1003      define variable vtime as int64 no-undo.
     1004      if mWaitFramStopTimeOut
     1005      then
     1006         return yes.
     1007      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1008      if     mWaitFramTimeOut ne ?
     1009         and mWaitFramTimeOut ne 0
     1010         and mWaitFramTimeOut lt vtime
     1011      then do:
     1012         mWaitFramStopTimeOut = yes.
     1013      end.
     1014      return mWaitFramStopTimeOut.
     1015   end.
     1016   procedure waitfram-hide :
     1017     if not session:batch-mode
     1018     then do
     1019     on error undo, return error return-value
     1020     :
     1021       pause 0 before-hide .
     1022       if not mBatchMode then
     1023         hide frame waitfram .
     1024     if     not mWaitFramView
     1025        and mWaitProcEvent
     1026     then
     1027       process events .
     1028     end.
     1029   end procedure.
     1030   procedure waitfram-show :
     1031     define input  parameter p-message as character no-undo .
     1032     define variable v-left-margin as integer   no-undo .
     1033     if not session:batch-mode
     1034     then do
     1035     on error undo, return error return-value
     1036     :
     1037       if length(p-message) <= 70 then do:
     1038         assign
     1039           v-left-margin = integer((70 - length(p-message)) / 2)
     1040         .
     1041         assign
     1042           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1043         .
     1044         assign
     1045           v-waitfram-action01 = " "
     1046           v-waitfram-action02 = " "
     1047                                    + fill(" ", v-left-margin)
     1048                                    + p-message
     1049           v-waitfram-action03 = " "
     1050         .
     1051       end.
     1052       else do:
     1053         define variable vRindex1 as integer no-undo.
     1054         define variable vRindex2 as integer no-undo.
     1055         vRindex1 = r-index(p-message," ",70).
     1056         if vRindex1 = 0
     1057         then
     1058            vRindex1 = 70.
     1059         if length(p-message)  <= vRindex1 + 70 then do:
     1060           assign
     1061             v-waitfram-action01 = " "
     1062             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1063             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1064           .
     1065         end.
     1066         else do:
     1067           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1068           if vRindex2 <= vRindex1
     1069           then
     1070              vRindex2 = vRindex1 + 70.
     1071           assign
     1072             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1073             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1074             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1075           .
     1076         end.
     1077       end.
     1078       B-viewProcInfo:visible   in frame waitfram = no.
     1079       B-viewProcInfo:sensitive in frame waitfram = no.
     1080       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1081       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1082       if  (   mWaitFramView
     1083          or  mWaitProcEvent)
     1084          and not mBatchMode
     1085       then
     1086          display
     1087             v-waitfram-action01 skip
     1088             v-waitfram-action02 skip
     1089             v-waitfram-action03 skip
     1090          with frame waitfram .
     1091       if     mWaitFramView
     1092          then do:
     1093             if     mWaitFramInterval ne ?
     1094                and not mBatchMode
     1095             then
     1096                wait-for go of frame waitfram pause mWaitFramInterval.
     1097          end.
     1098          else
     1099             if     mWaitProcEvent
     1100                and not mBatchMode
     1101             then
     1102                process events .
     1103     end.
     1104   end procedure.
     1105      procedure waitfram-show-this:
     1106         define input  parameter iInterval as int64 no-undo.
     1107         define variable vtime as int64 no-undo.
     1108         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1109         mWaitFramInterval = iInterval.
     1110         run waitfram-show (substitute("&1&2 &3&4" ,
     1111                                       mWaitFramTextBeg ,
     1112                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1113                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1114                                       mWaitFramTextEnd
     1115                                      )
     1116                           ).
     1117      end.
     1118      procedure WaitFramRunPause:
     1119         define input  parameter iInterval as dec no-undo.
     1120         define variable vStart  as datetime-tz no-undo.
     1121         define variable vend    as datetime-tz no-undo.
     1122         define variable vint as int64 no-undo.
     1123         define variable vOk as logical no-undo.
     1124         vStart = now.
     1125         vend   = vStart.
     1126         publish "WaitFramPause" (iInterval,output vOk).
     1127         vend   =  now.
     1128         vint = vend - vStart.
     1129         vint = iInterval - vint / 1000.
     1130         if     not mWaitFramStop
     1131            and (   vint > 0
     1132                 or (    not vOk
     1133                     and iInterval eq ?
     1134                     )
     1135                 )
     1136         then
     1137            run waitfram-show-this (iInterval).
     1138         vend   =  now.
     1139         vint = vend - vStart.
     1140         vint = iInterval - vint / 1000.
     1141         if     not mWaitFramStop
     1142            and vint > 0
     1143         then do:
     1144            run gbl/pause.p (vint * 1000).
     1145         end.
     1146         if iInterval ne ?
     1147         then
     1148            publish "WaitFramStop".
     1149         waitfram-check-timeout().
     1150      end.
     1151      procedure WaitFramWaitFor:
     1152         define input  parameter iInterval as dec no-undo.
     1153         assign
     1154            mWaitFramStartProc   = now
     1155            mWaitFramStopUser    = no
     1156            mWaitFramStopTimeOut = no
     1157         .
     1158         block-wait:
     1159         do while not mWaitFramStop:
     1160            run WaitFramRunPause (iInterval).
     1161            if  waitfram-check-timeout()
     1162            then do:
     1163               leave block-wait.
     1164            end.
     1165         end.
     1166         run waitfram-hide.
     1167      end.
     1168   procedure waitfram-join :
     1169     define input  parameter p-line-1  as character no-undo .
     1170     define input  parameter p-line-2  as character no-undo .
     1171     define input  parameter p-line-3  as character no-undo .
     1172     define output parameter p-message as character no-undo .
     1173     do
     1174     on error undo, return error return-value
     1175     :
     1176       assign
     1177         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1178                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1179                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1180       .
     1181     end.
     1182   end procedure.
     1183   function waitfram-join-function returns character
     1184     (input p-line-1 as character
     1185     ,input p-line-2 as character
     1186     ,input p-line-3 as character
     1187     ).
     1188     define variable v-message as character no-undo .
     1189     run waitfram-join in this-procedure
     1190       (input  p-line-1
     1191       ,input  p-line-2
     1192       ,input  p-line-3
     1193       ,output v-message
     1194       ) .
     1195     return v-message .
     1196   end function .
