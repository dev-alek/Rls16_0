     2621         or error-status :get-message(1) <> ""
     2622         then do:
     2623           undo move_block, retry move_block .
     2624         end.
     2625         for each buf_temp-browse-handle
     2626           where buf_temp-browse-handle.browse-type = 'height':u
     2627         on error undo move_block, retry move_block
     2628         :
     2629           assign
     2630             buf_temp-browse-handle.browse-handle :height
     2631               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2632             no-error .
