     2521       end.
     2522       assign
     2523         v-diasize-need-full-display = true
     2524       .
     2525       if v-diasize-change-size = false
     2526       then do:
     2527         assign
     2528           v-diasize-change-size = true
     2529         .
     2530       end.
     2531       else do:
     2532         return .
     2533       end.
     2534       assign
     2535         v-frame-height = frame Dialog-Frame :height
     2536         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2537         v-browse-height = v-diasize-browse-handle :height
     2538       .
     2539       for each buf_temp-browse-handle
     2540         where buf_temp-browse-handle.browse-type = 'height':u
     2541       :
