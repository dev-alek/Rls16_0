     2559         :
     2560           if  v-object-handle <> v-diasize-browse-handle :handle
     2561           and can-query(v-object-handle, "row")
     2562           and can-query(v-object-handle, "height")
     2563           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2564           then do:
     2565             find first buf_temp-browse-handle
     2566               where buf_temp-browse-handle.browse-type   = 'height':u
     2567                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2568               no-error .
     2569             if available buf_temp-browse-handle
     2570             then do:
     2571             end.
     2572             else do:
     2573               create buf_temp-diasize-handle .
     2574               assign
     2575                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2576                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2577               .
     2578             end.
     2579           end.
     2580           assign
     2581             v-object-handle = v-object-handle :next-sibling
     2582           .
     2583         end.
     2584         assign
     2585           v-field-group-handle = v-field-group-handle :next-sibling
     2586         .
     2587       end.
