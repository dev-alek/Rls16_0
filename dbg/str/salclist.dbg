     1244   procedure prn-lib-open-stream :
     1245     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1246     define input parameter p-page-size    as integer no-undo .
     1247     define input parameter p-is-stream    as logical no-undo .
     1248     define input parameter p-append       as logical no-undo .
     1249     define variable v-report-name as character no-undo .
     1250     do
     1251       on error undo, return error
     1252       :
     1253       run prn-lib-get-report-name  in this-procedure (
     1254         input parParentProc
     1255         ,output v-report-name
     1256         ).
     1257       if p-is-stream then
     1258       do:
     1259         if p-append then
     1260         do:
     1261           output stream PrnLibStream to value( v-report-name )
     1262             page-size value(p-page-size) append .
     1263         end.
     1264         if not p-append then
     1265         do:
     1266           output stream PrnLibStream to value( v-report-name )
     1267             page-size value(p-page-size) .
     1268         end.
     1269       end.
     1270       if not p-is-stream then
     1271       do:
     1272         if p-append then
     1273         do:
     1274           output to value( v-report-name )
     1275             page-size value(p-page-size) append .
     1276         end.
     1277         if not p-append then
     1278         do:
     1279           output to value( v-report-name )
     1280             page-size value(p-page-size) .
     1281         end.
     1282       end.
     1283     end.
     1284   end procedure.
     1285   procedure prn-lib-open-exp :
     1286     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1287     define input parameter p-is-stream    as logical no-undo .
     1288     define input parameter p-is-append    as logical no-undo .
     1289     define output parameter p-ReportFileName as char init "report" no-undo.
     1290     define output parameter p-process as logical no-undo .
     1291     define variable glog as logical no-undo .
     1292     do
     1293       on error undo, return error
     1294       :
     1295       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1296         TITLE      "Укажите путь"
     1297         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1298         ASK-OVERWRITE
     1299         CREATE-TEST-FILE
     1300         SAVE-AS
     1301         USE-FILENAME
     1302         DEFAULT-EXTENSION "txt"
     1303         UPDATE glog
     1304         .
     1305       if not glog then  return.
     1306       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1307       if p-is-stream then
     1308       do:
     1309         if p-is-append then
     1310         do:
     1311           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1312         end.
     1313         else
     1314         do:
     1315           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1316         end.
     1317       end.
     1318       else
     1319       do:
     1320         if p-is-append then
     1321         do:
     1322           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1323         end.
     1324         else
     1325         do:
     1326           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1327         end.
     1328       end.
     1329       p-process = yes.
     1330     end.
     1331   end procedure.
