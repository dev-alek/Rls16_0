     4588   END CASE.
     4589   if not p-open-query and v-doc-rec <> ? then
     4590   REPOSITION br-docs to recid v-doc-rec No-ERROR.
     4591   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4592   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4593   run waitfram-hide in this-procedure .
     4594   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     4595   APPLY "ENTRY" TO br-docs.
     4596   END PROCEDURE.
     4597   PROCEDURE proc-b-print :
     4598   DEFINE VARIABLE v-frame-width as integer no-undo .
     4599   define variable accum-count as integer.
     4600   define variable date_string     as      char    no-undo.
     4601   define variable Line            as      char    no-undo.
     4602   DEFINE VARIABLE v-for-time AS CHARACTER NO-UNDO.
     4603   DEFINE VARIABLE v-discnt-pcnt AS decimal NO-UNDO.
     4604   define variable v-shift-name-num as character no-undo .
     4605   define variable v-for-user-name as character no-undo .
     4606   DEFINE FRAME c-inkas-list
     4607   X_c-inkas.office COLUMN-LABEL "У" FORMAT "+/-":U
     4608   X_c-inkas.inkas-code FORMAT "X(14)":U
     4609   X_c-inkas.doc-date FORMAT "99/99/9999":U
     4610   X_c-inkas.fact-date FORMAT "99/99/9999":U
     4611   X_c-inkas.shift-date COLUMN-LABEL "Дата смены!(учета)" FORMAT "99/99/9999":U
     4612   v-shift-name-num COLUMN-LABEL "№ см." FORMAT "X(6)":U
     4613   X_c-inkas.real-corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999"
     4614   v-for-time  COLUMN-LABEL "Время корр" FORMAT "X(8)"
     4615   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(12)"
     4616   X_c-inkas.corr-date COLUMN-LABEL "Дата корр!(на объ.)" FORMAT "99/99/9999"
     4617   X_c-inkas.corr-shift-date COLUMN-LABEL "Дата смены!корр." FORMAT "99/99/9999"
     4618   X_c-inkas.corr-shift-num COLUMN-LABEL "№ смены!корр." FORMAT ">9"
     4619   X_c-inkas.netto COLUMN-LABEL "Нетто" FORMAT "->>>,>>>,>>>,>>9.99":U
     4620   X_c-inkas.tot-doc COLUMN-LABEL "Сумма товарная" FORMAT "->>>,>>>,>>>,>>9.99":U
     4621   X_c-inkas.discnt FORMAT "->,>>>,>>>,>>9.99":U
     4622   X_c-inkas.sub-discnt COLUMN-LABEL "Списания" FORMAT "->>>,>>>,>>9.99":U
     4623   X_c-inkas.qnty COLUMN-LABEL "Кол-во товаров" FORMAT "->>,>>>,>>9.<<<":U
     4624    v-discnt-pcnt COLUMN-LABEL "%" FORMAT "->>>>>9.9":U
     4625   X_c-inkas.num-chk FORMAT ">>>,>>9":U column-label "Чеков"
     4626   X_c-inkas.num-chk-nf FORMAT ">>>,>>9":U column-label "Чеков!нд"
     4627   X_c-inkas.status_ FORMAT "X(8)":U
     4628   X_c-inkas.flag_ COLUMN-LABEL "ОК" FORMAT "+/":U
     4629   X_c-inkas.is-auto-born COLUMN-LABEL "Авто!созд" FORMAT "+/":U
     4630   X_c-inkas.is-auto-get COLUMN-LABEL "Авто!чеки" FORMAT "+/":U
     4631   X_c-inkas.is-auto-rsrv COLUMN-LABEL "Авто!резерв" FORMAT "+/":U
     4632   X_c-inkas.is-auto-close COLUMN-LABEL "Авто!закр" FORMAT "+/":U
     4633   X_c-inkas.auto-comp COLUMN-LABEL "Ком!пенс" FORMAT "+/":U
     4634   X_c-inkas.AUTO-fbr  COLUMN-LABEL "Авто!пр-во" FORMAT "+/":U
     4635   X_c-inkas.rest-dish COLUMN-LABEL "Ост-ки!блюд" FORMAT "+/":U
     4636   X_c-inkas.rest-ingr COLUMN-LABEL "Ост-ки!ингр" FORMAT "+/":U
     4637   X_c-inkas.auto-tpsi COLUMN-LABEL "ТПСИ" FORMAT "+/":U
     4638   X_c-inkas.rest-tpsi COLUMN-LABEL "Ост-ки!ТПСИ" FORMAT "+/":U
     4639   HEADER  date_string AT 5 format "X(35)"
     4640   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4641   Line format "X(198)" AT 1
     4642   with width 232 down stream-io use-text    .
     4643   Line = fill("-", 198).
     4644   date_string = cur-time-print() .
     4645   run prn-lib-open-stream  in this-procedure (
     4646                                                input parParentProc
     4647                                               ,input 43
     4648                                               ,input yes
     4649                                               ,input no
     4650                                               ).
     4651   PUT  STREAM PrnLibStream
     4652   SPACE(25) ( frame Dialog-Frame:title )
     4653   format "x(90)" SKIP(1) .
     4654   FORM HEADER
     4655   Line format "X(198)" AT 1 SKIP
     4656   "Продолжение - на следующей странице" AT 30 SKIP
     4657   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4658   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4659   FORM with FRAME c-inkas-list  .
     4660   run waitfram-show in this-procedure ( input "Ждите...").
     4661   v-doc-rec = recid( X_c-inkas ).
     4662   DO WHILE available X_c-inkas :
     4663       GET prev br-docs.
     4664   END.
     4665   GET next br-docs.
     4666   DO WHILE available X_c-inkas :
     4667     Display STREAM PrnLibStream
     4668     X_c-inkas.office
     4669     X_c-inkas.inkas-code
     4670     X_c-inkas.doc-date
     4671     X_c-inkas.fact-date
     4672     X_c-inkas.shift-date
     4673     shift-name-no-err(buffer X_c-inkas) @ v-shift-name-num
     4674     X_c-inkas.real-corr-date
     4675     string(X_c-inkas.corr-time, "HH:MM:SS") @ v-for-time
     4676     usrfulnf(X_c-inkas.corr-user-name) @ v-for-user-name
     4677     X_c-inkas.corr-date
     4678     X_c-inkas.corr-shift-date
     4679     X_c-inkas.corr-shift-num
     4680     X_c-inkas.netto
     4681     X_c-inkas.tot-doc
     4682     X_c-inkas.discnt
     4683     X_c-inkas.sub-discnt
     4684     X_c-inkas.qnty
     4685     (X_c-inkas.discnt / X_c-inkas.tot-doc * 100) @ v-discnt-pcnt
     4686     X_c-inkas.num-chk
     4687     X_c-inkas.num-chk-nf
     4688     X_c-inkas.status_
     4689     X_c-inkas.flag_
     4690     X_c-inkas.is-auto-born
     4691     X_c-inkas.is-auto-get
     4692     X_c-inkas.is-auto-rsrv
     4693     X_c-inkas.is-auto-close
     4694     X_c-inkas.auto-comp
     4695     X_c-inkas.AUTO-fbr
     4696     X_c-inkas.rest-dish
     4697     X_c-inkas.rest-ingr
     4698     X_c-inkas.auto-tpsi
     4699     X_c-inkas.rest-tpsi
     4700     with FRAME c-inkas .
     4701     DOWN STREAM PrnLibStream 1
     4702     with FRAME c-inkas  .
     4703     assign
     4704     accum-count = accum-count + 1
     4705     .
     4706     GET next br-docs.
     4707   END.
     4708   UNDERLINE  STREAM PrnLibStream
     4709   X_c-inkas.office
     4710   X_c-inkas.inkas-code
     4711   X_c-inkas.doc-date
     4712   X_c-inkas.fact-date
     4713   X_c-inkas.shift-date
     4714   v-shift-name-num
     4715   X_c-inkas.real-corr-date
     4716   v-for-time
     4717   v-for-user-name
     4718   X_c-inkas.corr-date
     4719   X_c-inkas.corr-shift-date
     4720   X_c-inkas.corr-shift-num
     4721   X_c-inkas.netto
     4722   X_c-inkas.tot-doc
     4723   X_c-inkas.discnt
     4724   X_c-inkas.sub-discnt
     4725   X_c-inkas.qnty
     4726   v-discnt-pcnt
     4727   X_c-inkas.num-chk
     4728   X_c-inkas.num-chk-nf
     4729   X_c-inkas.status_
     4730   X_c-inkas.flag_
     4731   X_c-inkas.is-auto-born
     4732   X_c-inkas.is-auto-get
     4733   X_c-inkas.is-auto-rsrv
     4734   X_c-inkas.is-auto-close
     4735   X_c-inkas.auto-comp
     4736   X_c-inkas.AUTO-fbr
     4737   X_c-inkas.rest-dish
     4738   X_c-inkas.rest-ingr
     4739   X_c-inkas.auto-tpsi
     4740   X_c-inkas.rest-tpsi
     4741   with FRAME c-inkas  .
     4742   DISPLAY STREAM PrnLibStream
     4743   "ИТОГО" @ X_c-inkas.inkas-code
     4744   accum-count @ v-for-user-name
     4745   with frame c-inkas-list.
     4746   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4747   HIDE  STREAM PrnLibStream FRAME c-inkas-List.
     4748   output  STREAM PrnLibStream CLOSE.
     4749   reposition br-docs to recid v-doc-rec no-error.
     4750   run waitfram-hide in this-procedure .
     4751   apply "entry" to br-docs in frame Dialog-Frame.
     4752   END PROCEDURE.
     4753   PROCEDURE proc-b-sch :
     4754   assign
     4755   tbl = 'c-inkas'
     4756   join-tbl = 'X_c-inkas'
     4757   fld = ""
     4758   lab = ""
     4759   spr = ""
     4760   dim = '0'
     4761   .
     4762   run fltfield-add in this-procedure('inkas-code', '', '',
     4763   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4764   run fltfield-add in this-procedure('doc-date', '', '',
     4765   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4766   run fltfield-add in this-procedure('tot-doc', '', '',
     4767   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4768   run fltfield-add in this-procedure('discnt', '', '',
     4769   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4770   run fltfield-add in this-procedure('sub-discnt', 'Списания', '',
     4771   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4772   run fltfield-add in this-procedure('acc-date', '', '',
     4773   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4774   run fltfield-add in this-procedure('num-chk', '', '',
     4775   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4776   run fltfield-add in this-procedure('num-chk-nf', '', '',
     4777   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4778   run fltfield-add in this-procedure('qnty', 'Кол-во', '',
     4779   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4780   run fltfield-add in this-procedure('status_', '', '',
     4781   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4782   run fltfield-add in this-procedure('fact-date', '', '',
     4783   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4784   run fltfield-add in this-procedure('office', 'Услуги(для <старых> продаж)', '',
     4785   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4786   run fltfield-add in this-procedure('shift-date', 'Дата смены', '',
     4787   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4788   run fltfield-add in this-procedure('shift-num', 'Порядок Смен', '',
     4789   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4790   run fltfield-add in this-procedure('shift-name', '№ смены', '',
     4791   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4792   run fltfield-add in this-procedure('host-code', '', '',
     4793   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4794   run fltfield-add in this-procedure('netto', '', '',
     4795   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4796   run fltfield-add in this-procedure('corr-date', '', '',
     4797   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4798   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4799   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4800   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     4801   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4802   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4803   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4804   Filter-Block:
     4805   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4806     ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4807     ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4808   run gbl/filter.w ( INPUT parparentproc,
     4809                     INPUT (filter-point + chr(4) +
     4810                             filter-label + chr(4) +
     4811                             string(yes))
     4812                   , INPUT tbl
     4813                   , INPUT join-tbl
     4814                   , INPUT fld
     4815                   , INPUT lab
     4816                   , INPUT spr
     4817                   , INPUT dim ).
     4818   RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4819   END.
     4820   END PROCEDURE.
     4821   PROCEDURE Proc-find-code :
     4822   define input parameter par-next as logical no-undo.
     4823   define input parameter pardoc-code like ub.inkas.inkas-code no-undo.
     4824   assign
     4825   sch-date = ?
     4826   sch-fact = ? .
     4827   display
     4828   sch-date
     4829   sch-fact
     4830   with frame Dialog-Frame.
     4831   assign
     4832   pardoc-code = chr(34) + pardoc-code + chr(34).
     4833   run OpenBr in this-procedure
     4834     (input false
     4835     ,input par-next
     4836     ,input substitute("and X_c-inkas.inkas-code   begins &1 "
     4837       , pardoc-code)
     4838     ).
     4839   apply "entry":u to sch-code in frame Dialog-Frame .
     4840   END PROCEDURE.
     4841   PROCEDURE proc-find-date :
     4842   define input parameter par-next as logical no-undo.
     4843   define input parameter par-date like ub.inkas.doc-date no-undo.
     4844   define input parameter parwhat-date as character no-undo.
     4845   define variable var-datechr as character no-undo.
     4846   display
     4847   '':U @ sch-code
     4848   with frame Dialog-Frame.
     4849   assign
     4850   var-datechr = string(day(par-date)) + chr(47) +
     4851                 string(month(par-date)) + chr(47) +
     4852                 string(year(par-date)).
     4853   case parwhat-date:
     4854     when "doc-date":U then do:
     4855       assign
     4856       sch-fact = ?.
     4857       display
     4858       sch-fact
     4859       with frame Dialog-Frame.
     4860       run OpenBr in this-procedure
     4861       (input false
     4862       ,input par-next
     4863       ,input substitute("and X_c-inkas.doc-date = &1 "
     4864         , var-datechr)
     4865       ).
     4866       apply "entry":u to sch-date in frame Dialog-Frame.
     4867     end.
     4868     when "fact-date":U then do:
     4869       assign
     4870       sch-date = ?.
     4871       display
     4872       sch-date
     4873       with frame Dialog-Frame.
     4874       run OpenBr in this-procedure
     4875         (input false
     4876         ,input par-next
     4877         ,input substitute("and X_c-inkas.fact-date = &1 "
     4878         , var-datechr)
     4879         ).
     4880       apply "entry":u to sch-fact in frame Dialog-Frame.
     4881     end.
     4882   END.
     4883   END PROCEDURE.
     4884   PROCEDURE proc-view-changes :
     4885   for each temp-changes:
     4886       delete temp-changes.
     4887   END.
     4888   if not available X_c-inkas then do:
     4889     Open QUery br-changes for each temp-changes.
     4890     return.
     4891   end.
     4892   define variable v-label-param as character no-undo .
     4893   v-label-param =
     4894     "doc-date" + chr(4) + "Дата док-та" + chr(4) + "" + chr(8)
     4895    + "host-code" + chr(4) + "Код фирмы" + chr(4) + "" + chr(8)
     4896    + "inkas-code" + chr(4) + "Номер" + chr(4) + "" + chr(8)
     4897    + "is-back-date" + chr(4) + "Продажа закрыта <задним числом>" + chr(4) + "" + chr(8)
     4898    + "is-corr" + chr(4) + "Продажа корректировалась в стат. <факт>" + chr(4) + "" + chr(8)
     4899    + "is-del" + chr(4) + "Продажа удалена в статусе <факт>" + chr(4) + "" + chr(8)
     4900    + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     4901    + "user-db-num" + chr(4) + "БД продажи" + chr(4) + "" + chr(8)
     4902    + "user-name" + chr(4) + "Оператор" + chr(4) + "" + chr(8)
     4903    + "acc-date" + chr(4) + "Дата проводки" + chr(4) + "" + chr(8)
     4904    + "auto-comp" + chr(4) + "Автокомпенсация" + chr(4) + "" + chr(8)
     4905    + "auto-fbr" + chr(4) + "Автом. пр-во" + chr(4) + "" + chr(8)
     4906    + "auto-tpsi" + chr(4) + "?" + chr(4) + "" + chr(8)
     4907    + "discnt" + chr(4) + "Скидка общая" + chr(4) + "" + chr(8)
     4908    + "fact-date" + chr(4) + "Дата Факт" + chr(4) + "" + chr(8)
     4909    + "flag_" + chr(4) + "Закр для редакт." + chr(4) + "" + chr(8)
     4910    + "is-auto-born" + chr(4) + "Автосоздание" + chr(4) + "" + chr(8)
     4911    + "is-auto-close" + chr(4) + "Автозакрытие" + chr(4) + "" + chr(8)
     4912    + "is-auto-get" + chr(4) + "Аавтозакачка чеков" + chr(4) + "" + chr(8)
     4913    + "is-auto-rsrv" + chr(4) + "Авторезервирование" + chr(4) + "" + chr(8)
     4914    + "is-mand-sale-filter" + chr(4) + "Обязательно применение фильтра по чекам" + chr(4) + "" + chr(8)
     4915    + "netto" + chr(4) + "Сумма оплат" + chr(4) + "" + chr(8)
     4916    + "num-chk" + chr(4) + "Число чеков" + chr(4) + "" + chr(8)
     4917    + "num-chk-nf" + chr(4) + "Число чеков нд" + chr(4) + "" + chr(8)
     4918    + "obj-code" + chr(4) + "Магазин" + chr(4) + "" + chr(8)
     4919    + "office" + chr(4) + "Услуги" + chr(4) + "" + chr(8)
     4920    + "qnty" + chr(4) + "Кол-во товара" + chr(4) + "" + chr(8)
     4921    + "rest-dish" + chr(4) + "Учесть остатки блюд в автопр-ве" + chr(4) + "" + chr(8)
     4922    + "rest-ingr" + chr(4) + "Учесть остатки ингр. в автопр-ве" + chr(4) + "" + chr(8)
     4923    + "rest-tpsi" + chr(4) + "Учесть остатки ТПСИ" + chr(4) + "" + chr(8)
     4924    + "sale-filter-name" + chr(4) + "Имя фильтра по чекам" + chr(4) + "" + chr(8)
     4925    + "sale-filter-rus" + chr(4) + "Фильтр по чекам" + chr(4) + "" + chr(8)
     4926    + "shift-date" + chr(4) + "Дата смены" + chr(4) + "" + chr(8)
     4927    + "shift-num" + chr(4) + "Порядок Смен" + chr(4) + "" + chr(8)
     4928    + "shift-name" + chr(4) + "№ Смены" + chr(4) + "" + chr(8)
     4929    + "status_" + chr(4) + "Статус" + chr(4) + "" + chr(8)
     4930    + "sub-discnt" + chr(4) + "Сумма списания" + chr(4) + "" + chr(8)
     4931    + "tot-doc" + chr(4) + "Сумма брутто в ценах продажи" + chr(4) + ""  .
     4932    run proc-full-temp-changes in this-procedure (
     4933                                                input  buffer X_c-inkas:handle
     4934                                               ,input  'inkas':U
     4935                                               ,input  "doc-date,host-code,inkas-code,is-back-date,is-corr,is-del,PS," +  "user-db-num,user-name,acc-date,auto-comp,auto-fbr,auto-tpsi,discnt,fact-date,flag_,is-auto-born,is-auto-close,is-auto-get," +  "is-auto-rsrv,is-mand-sale-filter,netto,num-chk,num-chk-nf,obj-code,office,qnty,rest-dish,rest-ingr," +  "rest-tpsi,sale-filter-name,sale-filter-rus,shift-date,shift-num,shift-name,status_,sub-discnt,tot-doc"
     4936                                               ,input  v-label-param).
     4937   Open QUery br-changes for each temp-changes.
     4938   END PROCEDURE.
     4939   PROCEDURE reopen-query :
     4940   if available X_c-inkas then v-doc-rec = recid(X_c-inkas).
     4941   run OpenBr in this-procedure( input yes, input no, input '':U).
     4942   reposition br-docs to recid v-doc-rec no-error.
     4943   apply 'value-changed' to  br-docs in frame Dialog-Frame .
     4944   END PROCEDURE.
