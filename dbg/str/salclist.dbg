     1425   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1426   procedure fltopend_fltopend :
     1427   define input parameter p-parent-handle as handle no-undo .
     1428   define input parameter p-qh as handle no-undo .
     1429   define input parameter p-flt-open-open-query  as character no-undo .
     1430   define input parameter p-where-cond as character no-undo .
     1431   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1432   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1433   define input parameter p-indexed-reposition as character no-undo .
     1434     do
     1435     on error undo, return error
     1436     :
     1437   define variable v-prepare-string as character no-undo .
     1438   define variable glog as logical no-undo .
     1439   assign
     1440   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1441                      p-where-cond + chr(32)  +
     1442                      p-use-indFIRST-query-tail + chr(32) +
     1443                      p-use-ind-sort-clmn-by + chr(32) +
     1444                      p-indexed-reposition
     1445   .
     1446   assign
     1447   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1448   if not glog
     1449   or error-status:error then do:
     1450     message error-status:get-message(1) view-as alert-box .
     1451     undo, return error .
     1452   end.
     1453   assign
     1454   glog = p-qh:query-open no-error .
     1455   if not glog
     1456   or error-status:error then do:
     1457     message error-status:get-message(1) view-as alert-box .
     1458     undo, return error .
     1459   end.
     1460     end.
     1461   end procedure.
     1462   procedure fltopend_fltfindd :
     1463   define input parameter p-parent-handle as handle no-undo .
     1464   define input parameter p-qh as handle no-undo .
     1465   define input parameter p-rowid as rowid no-undo .
     1466   define input parameter p-next as logical no-undo .
     1467   define input parameter p-lock as integer no-undo .
     1468   define input parameter p-bh as handle no-undo .
     1469   define input parameter p-where-cond as character no-undo .
     1470   define input parameter p-use-index-phrase as character no-undo .
     1471   define variable glog as logical no-undo .
     1472   define variable v-qh as handle no-undo .
     1473   define variable v-bh as handle no-undo .
     1474   define variable v-recid as recid no-undo .
     1475   define variable v-prepare-string as character no-undo .
     1476   do
     1477   on error undo, return error
     1478   on stop undo, return error
     1479   :
     1480     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1481     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1482     create query v-qh.
     1483     v-qh:set-buffers(v-bh).
     1484     v-prepare-string = substitute("for each &1 &2 &3"
     1485                                     ,v-bh:name
     1486                                     ,p-where-cond
     1487                                     ,p-use-index-phrase).
     1488     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1489     if not glog then do:
     1490       delete object v-qh.
     1491       delete object v-bh.
     1492       undo, return error .
     1493     end.
     1494     glog = v-qh:query-open no-error .
     1495     if not glog then do:
     1496       delete object v-qh.
     1497       delete object v-bh.
     1498       undo, return error .
     1499     end.
     1500     if p-next then do:
     1501       v-qh:reposition-to-rowid(p-rowid) no-error .
     1502       glog = v-qh:get-next( p-lock) no-error .
     1503       glog = v-qh:get-next( p-lock) no-error .
     1504       if not glog or v-qh:query-off-end = yes then do:
     1505         glog = v-qh:get-first( p-lock) no-error .
     1506       end.
     1507     end.
     1508     else do:
     1509       glog = v-qh:get-first( p-lock) no-error .
     1510     end.
     1511     v-recid = v-bh:recid no-error .
     1512     delete object v-qh.
     1513     delete object v-bh.
     1514     return string(v-recid) .
     1515   end.
     1516   end procedure.
     1517   procedure fltopend_fltfindq :
     1518   define input parameter p-parent-handle as handle no-undo .
     1519   define input parameter p-qh as handle no-undo .
     1520   define input parameter p-next as logical no-undo .
     1521   define input parameter p-lock as integer no-undo .
     1522   define input parameter p-flt-open-open-query  as character no-undo .
     1523   define input parameter p-where-cond as character no-undo .
     1524   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1525   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1526   define input parameter p-indexed-reposition as character no-undo .
     1527   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1528   define variable glog as logical no-undo .
     1529   define variable v-qh as handle no-undo .
     1530   define variable v-bh as handle no-undo extent 18.
     1531   define variable v-rowid as rowid no-undo extent 18.
     1532   define variable v-ii as integer no-undo .
     1533   define variable v-prepare-string as character no-undo .
     1534   do
     1535   on error undo, return error
     1536   on stop undo, return error
     1537   :
     1538     create query v-qh.
     1539     do v-ii = 1 to p-qh:num-buffers:
     1540       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1541       assign
     1542       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1543       no-error.
     1544       v-qh:add-buffer(v-bh[v-ii]).
     1545     end.
     1546     assign
     1547     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1548                       p-where-cond + chr(32)  +
     1549                       p-use-indFIRST-query-tail + chr(32) +
     1550                       p-use-ind-sort-clmn-by + chr(32) +
     1551                       p-indexed-reposition
     1552     .
     1553     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1554     if not glog then do:
     1555       delete object v-qh.
     1556       do v-ii = 1 to p-qh:num-buffers:
     1557         delete object v-bh[v-ii].
     1558       end.
     1559       undo, return error .
     1560     end.
     1561     glog = v-qh:query-open no-error .
     1562     if not glog then do:
     1563       delete object v-qh.
     1564       do v-ii = 1 to p-qh:num-buffers:
     1565         delete object v-bh[v-ii].
     1566       end.
     1567       undo, return error .
     1568     end.
     1569     if p-next then do:
     1570       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1571       glog = v-qh:get-next( p-lock) no-error .
     1572       glog = v-qh:get-next( p-lock) no-error .
     1573       if not glog or v-qh:query-off-end = yes then do:
     1574         glog = v-qh:get-first( p-lock) no-error .
     1575       end.
     1576     end.
     1577     else do:
     1578       glog = v-qh:get-first( p-lock) no-error .
     1579     end.
     1580     do v-ii = 1 to p-qh:num-buffers:
     1581       assign
     1582       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1583       no-error.
     1584     end.
     1585     delete object v-qh.
     1586     do v-ii = 1 to p-qh:num-buffers:
     1587       delete object v-bh[v-ii].
     1588     end.
     1589   end.
     1590   end procedure.
     1591   define variable filter-label as character no-undo init "История продаж " .
     1592   define variable filter-label0 as character no-undo init "История продаж " .
     1593   define variable filter-point0 as character no-undo init "salclist" .
     1594   define variable filter-point as character no-undo init "salclist" .
     1595   define variable sort-column-name as character no-undo .
     1596   DEFINE VARIABLE varhost-code like ub.sysconf.host-code no-undo .
     1597   DEFINE VARIABLE varhost-name like ub.clients.obj-name no-undo .
     1598   define variable cas-shft as logical no-undo init no.
     1599   define variable ptwounit as logical no-undo init yes .
     1600   define variable v-doc-rec as recid no-undo .
     1601   define variable v-rid-list as character no-undo .
     1602   DEFINE NEW SHARED VARIABLE br-handle as handle no-undo.
     1603   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
     1604   DEFINE VARIABLE v-curr-r-b AS CHARACTER NO-UNDO.
     1605   DEFINE VARIABLE v-is-fbr-obj AS LOGICAL NO-UNDO INIT ?.
     1606   DEFINE VARIABLE v-is-tpsi-obj AS LOGICAL NO-UNDO INIT ?.
     1607   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1608   define  temp-table temp-changes no-undo
     1609   field f_name as character
     1610   field l_name as character
     1611   field v_old as character
     1612   field v_new as character
     1613   field t_name as character
     1614   field num_ as integer
     1615   field uniq-key-rec as character
     1616   field action as integer
     1617   field fNotChange as logical
     1618   index pi is unique primary
     1619   num_
     1620   t_name
     1621   f_name
     1622   index
     1623   Chan
     1624   fnotChange
     1625   t_name
     1626   f_name
     1627   index imain uniq-key-rec
     1628   .
     1629   FUNCTION get-all-fields returns character (p-file-name as character ):
     1630   define variable v-dop as character no-undo .
     1631     find first _file no-lock where _file._file-name = p-file-name no-error .
     1632     if not available _file then return "":U.
     1633     for each _field no-lock where
     1634              _field._file-recid = recid(_file) :
     1635       assign
     1636       v-dop = v-dop + _field._field-name + chr(44)
     1637       .
     1638     end.
     1639     return trim(v-dop).
     1640   END FUNCTION.
     1641   PROCEDURE proc-full-temp-changes :
     1642     define input  parameter p-hst-handle as handle    no-undo .
     1643     define input  parameter p-main-table as character no-undo .
     1644     define input  parameter p-field-list as character no-undo .
     1645     define input  parameter p-label-form as character no-undo .
     1646     define variable h-new-buf         as handle    no-undo .
     1647     define variable h-main-buf        as handle    no-undo .
     1648     define variable h-for-comp        as handle    no-undo .
     1649     define variable v-inform          as character no-undo .
     1650     define variable v-ind             as integer   no-undo .
     1651     define variable v-idx-field-qnty  as integer   no-undo .
     1652     define variable v-num-entries     as integer   no-undo .
     1653     define variable fh                as handle    no-undo .
     1654     define variable fh-main           as handle    no-undo .
     1655     define variable fh-old            as handle    no-undo .
     1656     define variable fh-new            as handle    no-undo .
     1657     define variable v-field-name      as character no-undo .
     1658     define variable v-field-lvl       as character no-undo .
     1659     define variable v-field-form      as character no-undo .
     1660     define variable v-search-exp      as character no-undo .
     1661     define variable v-srch-main       as character no-undo .
     1662     define variable v-word-link       as character no-undo .
     1663     define variable v-av-chip-num     as logical   no-undo .
     1664     define variable v-main-pi-fld-lst as character no-undo .
     1665     define variable v-main-fld-lst    as character no-undo .
     1666     define variable v-delim-list      as character no-undo .
     1667     define variable v-label           as character no-undo .
     1668     define variable v-old-value       as character no-undo case-sensitive.
     1669     define variable v-new-value       as character no-undo case-sensitive.
     1670     define variable v-chg-fields as character no-undo.
     1671     for each temp-changes:
     1672       delete temp-changes.
     1673     end.
     1674     if not p-hst-handle:available then do:
     1675       return .
     1676     end.
     1677     create buffer h-new-buf  for table p-hst-handle .
     1678     create buffer h-main-buf for table p-main-table .
     1679     assign
     1680       v-inform = h-main-buf:index-information(1)
     1681       v-ind    = 2
     1682     .
     1683     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1684     on error undo, return error
     1685     :
     1686       assign
     1687         v-inform = h-main-buf:index-information( v-ind )
     1688         v-ind    = v-ind + 1
     1689       .
     1690     end.
     1691     if v-inform = ?
     1692       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1693       or entry( 3, v-inform, ",":U ) <> "1":U
     1694     then do:
     1695       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1696     end.
     1697     assign
     1698       v-idx-field-qnty = num-entries( v-inform ) - 4
     1699     .
     1700     if v-idx-field-qnty < 2 then do:
     1701       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1702     end.
     1703     assign
     1704       v-srch-main   = "where":U
     1705       v-word-link   = "":U
     1706       v-av-chip-num = false
     1707       v-delim-list  = "":U
     1708     .
     1709     do v-ind = 1 to v-idx-field-qnty by 2
     1710     on error undo, return error
     1711     :
     1712       assign
     1713         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1714         fh                = p-hst-handle:buffer-field( v-field-name )
     1715         fh-main           = h-main-buf:buffer-field( v-field-name )
     1716         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1717         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1718       .
     1719       if fh:data-type ="character":U then do:
     1720         assign
     1721           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1722         .
     1723       end.
     1724       else do:
     1725         assign
     1726           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1727         .
     1728       end.
     1729       if v-delim-list = "":U then do:
     1730         assign
     1731           v-delim-list = ",":U
     1732         .
     1733       end.
     1734       if v-word-link = "":U then do:
     1735         assign
     1736           v-word-link = "and":U
     1737         .
     1738       end.
     1739     end.
     1740     assign
     1741       v-delim-list  = "":U
     1742     .
     1743     do v-ind = 1 to h-main-buf:num-fields
     1744     on error undo, return error
     1745     :
     1746       assign
     1747         fh-main      = h-main-buf:buffer-field( v-ind )
     1748         v-field-name = fh-main:name
     1749       .
     1750         assign
     1751           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1752         .
     1753         if v-delim-list = "":U then do:
     1754           assign
     1755             v-delim-list = ",":U
     1756           .
     1757         end.
     1758     end.
     1759     assign
     1760       v-inform = p-hst-handle:index-information(1)
     1761       v-ind    = 2
     1762     .
     1763     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1764     on error undo, return error
     1765     :
     1766       assign
     1767         v-inform = p-hst-handle:index-information( v-ind )
     1768         v-ind    = v-ind + 1
     1769       .
     1770     end.
     1771     if v-inform = ?
     1772       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1773       or entry( 3, v-inform, ",":U ) <> "1":U
     1774     then do:
     1775       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1776     end.
     1777     assign
     1778       v-idx-field-qnty = num-entries( v-inform ) - 4
     1779     .
     1780     if v-idx-field-qnty < 2 then do:
     1781       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1782     end.
     1783     assign
     1784       v-search-exp  = "where":U
     1785       v-word-link   = "":U
     1786       v-av-chip-num = false
     1787     .
     1788     do v-ind = 1 to v-idx-field-qnty by 2
     1789     on error undo, return error
     1790     :
     1791       assign
     1792         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1793         fh           = p-hst-handle:buffer-field( v-field-name )
     1794         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1795       .
     1796       if v-field-name = "chip-num":U then do:
     1797         assign
     1798           v-search-exp  = substitute( "&1 >", v-search-exp )
     1799           v-av-chip-num = true
     1800         .
     1801       end.
     1802       else do:
     1803         assign
     1804           v-search-exp = substitute( "&1 =", v-search-exp )
     1805         .
     1806       end.
     1807       if fh:data-type ="character":U then do:
     1808         assign
     1809           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1810         .
     1811       end.
     1812       else do:
     1813         assign
     1814           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1815         .
     1816       end.
     1817       if v-word-link = "":U then do:
     1818         assign
     1819           v-word-link = "and":U
     1820         .
     1821       end.
     1822     end.
     1823     if v-av-chip-num = false then do:
     1824       message
     1825         vss-workfile vss-revision vss-description skip
     1826         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1827         "Использование данной процедуры невозможно!" skip
     1828         view-as alert-box error .
     1829       return error .
     1830     end.
     1831     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1832     if not h-new-buf:available then do:
     1833       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1834       if not h-main-buf:available then do:
     1835         assign
     1836           h-for-comp = ?
     1837         .
     1838       end.
     1839       else do:
     1840         assign
     1841           h-for-comp = h-main-buf
     1842         .
     1843       end.
     1844     end.
     1845     else do:
     1846       assign
     1847         h-for-comp = h-new-buf
     1848       .
     1849     end.
     1850     assign
     1851       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1852     .
     1853     do v-ind = 1 to v-num-entries
     1854     on error undo, return error return-value
     1855     :
     1856       assign
     1857         v-field-name = entry( v-ind, v-main-fld-lst )
     1858         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1859         v-old-value  = fh-old:buffer-value()
     1860         v-label      = trim( fh-old:label )
     1861       .
     1862       if ( trim( p-field-list ) <> "":U
     1863            and lookup( v-field-name, p-field-list ) > 0
     1864          )
     1865          or trim( p-field-list ) = "":U
     1866       then do:
     1867         if h-for-comp <> ? then do:
     1868           assign
     1869             fh-new      = h-for-comp:buffer-field( v-field-name )
     1870             v-new-value = fh-new:buffer-value()
     1871           .
     1872         end.
     1873         else do:
     1874           assign
     1875             v-new-value = "":U
     1876           .
     1877         end.
     1878         if v-old-value <> v-new-value
     1879         then do:
     1880           create temp-changes.
     1881           assign
     1882             temp-changes.t_name = p-main-table
     1883             temp-changes.f_name = v-field-name
     1884             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1885             temp-changes.v_old  = trim( v-old-value )
     1886             temp-changes.v_new  = trim( v-new-value )
     1887             temp-changes.num_   = 0
     1888             temp-changes.fNotChange = v-old-value eq v-new-value
     1889           .
     1890         end.
     1891       end.
     1892     end.
     1893     assign
     1894       v-num-entries = num-entries( p-label-form, chr(8) )
     1895     .
     1896     do v-ind = 1 to v-num-entries
     1897     on error undo, return error return-value
     1898     :
     1899       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1900         assign
     1901           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1902           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1903           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1904         .
     1905         find first temp-changes
     1906           where temp-changes.f_name = v-field-name
     1907           no-error .
     1908         if available temp-changes then do:
     1909           if trim( v-field-lvl ) <> "":U then do:
     1910             assign
     1911               temp-changes.l_name = v-field-lvl
     1912             .
     1913           end.
     1914           if trim( v-field-form ) <> "":U then do:
     1915             assign
     1916               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1917             .
     1918             if h-for-comp <> ? then do:
     1919               assign
     1920                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1921               .
     1922             end.
     1923           end.
     1924         end.
     1925       end.
     1926       else do:
     1927         message
     1928           vss-workfile vss-revision vss-description skip
     1929           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1930           substitute( "список для поля '&1': '&2'"
     1931                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1932                       ,entry( v-ind, p-label-form, chr(8) )
     1933                     ) skip
     1934           substitute( "полный список: &2", p-label-form ) skip
     1935           view-as alert-box error .
     1936       end.
     1937     end.
     1938     delete object h-new-buf .
     1939     delete object h-main-buf .
     1940   END PROCEDURE.
     1941   DEFINE BUTTON B-Help
     1942        LABEL "Помо&щь"
     1943        SIZE 3 BY 1
     1944        BGCOLOR 8 .
     1945   DEFINE BUTTON B-mark
     1946        LABEL "&*"
     1947        SIZE 3 BY 1.
     1948   DEFINE BUTTON B-print
     1949        LABEL "Пе&чать"
     1950        SIZE 3 BY 1.
     1951   DEFINE BUTTON b-quit AUTO-END-KEY
     1952        LABEL "&Выход"
     1953        SIZE 10 BY 1
     1954        BGCOLOR 8 .
     1955   DEFINE BUTTON B-sch
     1956        LABEL "&Фильтр"
     1957        SIZE 3 BY 1.
     1958   DEFINE BUTTON B-sel AUTO-GO
     1959        LABEL "Вы&бор"
     1960        SIZE 10 BY 1.
     1961   DEFINE VARIABLE ED-notes AS CHARACTER
     1962        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1963        SIZE 98 BY 2
     1964        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1965   DEFINE VARIABLE f-search-label AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск по:"
     1966         VIEW-AS TEXT
     1967        SIZE 10.5 BY .67
     1968        FGCOLOR 4  NO-UNDO.
     1969   DEFINE VARIABLE l-num-chk AS CHARACTER FORMAT "X(256)":U INITIAL "Число чеков"
     1970         VIEW-AS TEXT
     1971        SIZE 12.5 BY .67 NO-UNDO.
     1972   DEFINE VARIABLE l-qnty AS CHARACTER FORMAT "X(256)":U INITIAL "Кол-во товара"
     1973         VIEW-AS TEXT
     1974        SIZE 13.5 BY .67 NO-UNDO.
     1975   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1976         VIEW-AS TEXT
     1977        SIZE 6 BY 1
     1978        FGCOLOR 4  NO-UNDO.
     1979   DEFINE VARIABLE num-chk AS INTEGER FORMAT "->>>,>>9":U INITIAL 0
     1980         VIEW-AS TEXT
     1981        SIZE 16.13 BY .67 NO-UNDO.
     1982   DEFINE VARIABLE qnty AS DECIMAL FORMAT "->>,>>>,>>9.<<<":U INITIAL 0
     1983         VIEW-AS TEXT
     1984        SIZE 16.13 BY .67 NO-UNDO.
     1985   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(14)":U
     1986        LABEL "номеру"
     1987        VIEW-AS FILL-IN
     1988        SIZE 12.5 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1989   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999":U
     1990        LABEL "дате"
     1991        VIEW-AS FILL-IN
     1992        SIZE 11.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1993   DEFINE VARIABLE sch-fact AS DATE FORMAT "99/99/9999":U
     1994        LABEL "дате факт"
     1995        VIEW-AS FILL-IN
     1996        SIZE 11.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1997   DEFINE VARIABLE shop-name AS CHARACTER FORMAT "X(25)":U
     1998         VIEW-AS TEXT
     1999        SIZE 27 BY .67 NO-UNDO.
     2000   DEFINE QUERY BR-changes FOR
     2001         temp-changes SCROLLING.
     2002   DEFINE qUERY BR-docs FOR X_c-inkas scrolling.
     2003   DEFINE BROWSE BR-changes
     2004     QUERY BR-changes DISPLAY
     2005         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     2006   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     2007   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     2008       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.
     2009   DEFINE BROWSE BR-docs
     2010     QUERY BR-docs NO-LOCK DISPLAY
     2011         mark-string( recid(X_c-inkas), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     2012     X_c-inkas.inkas-code FORMAT "X(14)":U
     2013     X_c-inkas.doc-date FORMAT "99/99/9999":U
     2014     X_c-inkas.fact-date FORMAT "99/99/9999":U
     2015     X_c-inkas.shift-date COLUMN-LABEL "Дата смены!(учета)" FORMAT "99/99/9999":U
     2016     shift-name-no-err(BUFFER X_c-inkas) COLUMN-LABEL "№ см." FORMAT "x(6)":U
     2017     X_c-inkas.real-corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999"
     2018     string(X_c-inkas.corr-time, "HH:MM:SS") COLUMN-LABEL "Время корр" FORMAT "X(8)"
     2019     usrfulnf(X_c-inkas.corr-user-name) column-label 'Изменил' FORMAT "X(12)"
     2020     X_c-inkas.corr-date COLUMN-LABEL "Дата корр!(на объ.)" FORMAT "99/99/9999"
     2021     X_c-inkas.corr-shift-date COLUMN-LABEL "Дата смены!корр." FORMAT "99/99/9999"
     2022     X_c-inkas.corr-shift-num COLUMN-LABEL "№ смены!корр." FORMAT ">9"
     2023     X_c-inkas.netto COLUMN-LABEL "Нетто" FORMAT "->>>,>>>,>>>,>>9.99":U
     2024     X_c-inkas.tot-doc COLUMN-LABEL "Сумма товарная" FORMAT "->>>,>>>,>>>,>>9.99":U
     2025     X_c-inkas.discnt FORMAT "->,>>>,>>>,>>9.99":U
     2026     X_c-inkas.sub-discnt COLUMN-LABEL "Списания" FORMAT "->>>,>>>,>>9.99":U
     2027     X_c-inkas.qnty COLUMN-LABEL "Кол-во товаров" FORMAT "->>,>>>,>>9.<<<":U
     2028     (X_c-inkas.discnt / X_c-inkas.tot-doc * 100) COLUMN-LABEL "%" FORMAT "->>>>>9.9":U
     2029     X_c-inkas.num-chk FORMAT ">>>,>>9":U COLUMN-LABEL "Чеков"
     2030     X_c-inkas.num-chk-nf FORMAT ">>>,>>9":U COLUMN-LABEL "Чеков!нд"
     2031     X_c-inkas.status_ FORMAT "X(8)":U
     2032     X_c-inkas.flag_ COLUMN-LABEL "ОК" FORMAT "+/":U
     2033     X_c-inkas.is-auto-born COLUMN-LABEL "Авто!созд" FORMAT "+/":U
     2034     X_c-inkas.is-auto-get COLUMN-LABEL "Авто!чеки" FORMAT "+/":U
     2035     X_c-inkas.is-auto-rsrv COLUMN-LABEL "Авто!резерв" FORMAT "+/":U
     2036     X_c-inkas.is-auto-close COLUMN-LABEL "Авто!закр" FORMAT "+/":U
     2037     X_c-inkas.auto-comp COLUMN-LABEL "Ком!пенс" FORMAT "+/":U
     2038     X_c-inkas.AUTO-fbr  COLUMN-LABEL "Авто!пр-во" FORMAT "+/":U
     2039     X_c-inkas.rest-dish COLUMN-LABEL "Ост-ки!блюд" FORMAT "+/":U
     2040     X_c-inkas.rest-ingr COLUMN-LABEL "Ост-ки!ингр" FORMAT "+/":U
     2041     X_c-inkas.auto-tpsi COLUMN-LABEL "ТПСИ" FORMAT "+/":U
     2042     X_c-inkas.rest-tpsi COLUMN-LABEL "Ост-ки!ТПСИ" FORMAT "+/":U
     2043       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.63 BY 7.38.
     2044   DEFINE FRAME Dialog-Frame
     2045        b-quit AT ROW 1 COL 1
     2046        B-mark AT ROW 1 COL 11
     2047        B-sel AT ROW 1 COL 21
     2048        B-print AT ROW 1 COL 89
     2049        B-sch AT ROW 1 COL 92
     2050        B-Help AT ROW 1 COL 95
     2051        BR-docs AT ROW 2 COL 1
     2052        ED-notes AT ROW 9.5 COL 1 NO-LABEL
     2053        sch-code AT ROW 12.58 COL 18.25 COLON-ALIGNED
     2054        sch-date AT ROW 12.58 COL 41.38 COLON-ALIGNED
     2055        sch-fact AT ROW 12.63 COL 66.25 COLON-ALIGNED
     2056        BR-changes AT ROW 14.25 COL 1
     2057        mark-num AT ROW 1 COL 14 NO-LABEL
     2058        l-qnty AT ROW 11.5 COL 40.5 NO-LABEL WIDGET-ID 6
     2059        qnty AT ROW 11.54 COL 53.25 COLON-ALIGNED NO-LABEL
     2060        l-num-chk AT ROW 11.58 COL 5 NO-LABEL WIDGET-ID 4
     2061        num-chk AT ROW 11.58 COL 16.25 COLON-ALIGNED NO-LABEL
     2062        shop-name AT ROW 11.75 COL 70 COLON-ALIGNED NO-LABEL
     2063        f-search-label AT ROW 12.75 COL 1.5 NO-LABEL
     2064        SPACE(87.12) SKIP(6.85)
     2065       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2066            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2067            TITLE "Продажи"
     2068            CANCEL-BUTTON b-quit.
     2069   ASSIGN
     2070          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2071          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2072   ASSIGN
     2073          BR-docs:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     2074   ASSIGN
     2075          f-search-label:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2076   ON END-ERROR OF FRAME Dialog-Frame
     2077   OR ENDKEY OF FRAME Dialog-Frame DO:
     2078     run gbl/markqwa.p (
     2079                   input b-mark:sensitive
     2080                  ,input v-rid-list
     2081                   ) no-error.
     2082       if error-status:error then return no-apply.
     2083   END.
     2084   ON GO OF FRAME Dialog-Frame
     2085   DO:
     2086     p-rid-list = v-rid-list.
     2087   END.
     2088   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2089   DO:
     2090     APPLY "END-ERROR":U TO SELF.
     2091   END.
     2092   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2093   DO:
     2094   define variable glog as logical no-undo .
     2095     if available X_c-inkas then do:
     2096   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2097   define variable v-str-recid24 as character no-undo .
     2098   define variable v-num-entry24 as integer   no-undo .
     2099   assign
     2100     v-str-recid24 = trim( string( recid( X_c-inkas ) , "->>>>>>>>>>>9":U ) )
     2101     v-num-entry24 = lookup( v-str-recid24 , v-rid-list )
     2102   .
     2103   if v-num-entry24 > 0 then do:
     2104     assign
     2105       entry( v-num-entry24, v-rid-list ) = "":U
     2106       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2107     .
     2108   end.
     2109   else do:
     2110     assign
     2111       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid24
     2112     .
     2113   end.
     2114       glog = br-docs:refresh() .
     2115       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2116           glog = br-docs:select-next-row ().
     2117           apply "iteration-changed" to br-docs in frame Dialog-Frame.
     2118       end.
     2119       if num-entries( v-rid-list ) = 0
     2120       then
     2121           hide mark-num in frame Dialog-Frame.
     2122       else
     2123           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     2124     end.
     2125     apply "entry" to br-docs in frame Dialog-Frame.
     2126   END.
     2127   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2128   DO:
     2129     if not avail X_c-inkas then return no-apply.
     2130     run proc-b-print in this-procedure no-error.
     2131     if error-status:error then do:
     2132       return no-apply.
     2133     end.
     2134     APPLY "ENTRY" to br-docs.
     2135   END.
     2136   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     2137   DO:
     2138     run proc-b-sch no-error.
     2139     if error-status:error then return no-apply.
     2140   END.
     2141   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     2142   DO:
     2143      if ( available X_c-inkas ) AND ( v-rid-list = ""
     2144      or
     2145      b-mark:sensitive = no
     2146      ) then
     2147       v-rid-list = string( recid( X_c-inkas ) ) .
     2148   END.
     2149   ON ANY-PRINTABLE OF BR-docs IN FRAME Dialog-Frame
     2150   DO:
     2151     sch-code:screen-value = sch-code:screen-value + last-event:label.
     2152       apply "entry" to sch-code in frame Dialog-Frame.
     2153   apply "end" to sch-code in frame Dialog-Frame.
     2154   END.
     2155   ON DELETE-CHARACTER OF BR-docs IN FRAME Dialog-Frame
     2156   DO:
     2157     if b-mark:sensitive in frame Dialog-Frame then
     2158     APPLY "CHOOSE" to b-mark.
     2159   END.
     2160   ON INSERT-MODE OF BR-docs IN FRAME Dialog-Frame
     2161   DO:
     2162     if b-mark:sensitive in frame Dialog-Frame then
     2163     APPLY "CHOOSE" to b-mark.
     2164       else do:
     2165         if b-sel:sensitive in frame Dialog-Frame then
     2166         APPLY "CHOOSE" to b-sel.
     2167       end.
     2168   END.
     2169   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     2170   DO:
     2171   define buffer buf_clients for ub.clients.
     2172     if available X_c-inkas then do:
     2173       assign
     2174       num-chk = X_c-inkas.num-chk
     2175       qnty = X_c-inkas.qnty
     2176       ed-notes = replace(X_c-inkas.PS, chr(4), chr(32)).
     2177       FIND FIRST buf_clients where
     2178                             buf_clients.obj-type = X_c-inkas.obj-type AND
     2179                    buf_clients.obj-code = X_c-inkas.obj-code NO-LOCK NO-ERROR.
     2180       IF avail buf_clients then assign
     2181       shop-name = buf_clients.obj-name.
     2182       else shop-name = string(X_c-inkas.obj-code).
     2183       display
     2184       ed-notes
     2185       num-chk
     2186       qnty
     2187       shop-name when (par-mode <> 'объект':U and par-mode <> 'новый':U)
     2188       with frame Dialog-Frame .
     2189      end.
     2190      else do:
     2191          ASSIGN
     2192          ed-notes:SCREEN-VALUE = '':U.
     2193           display
     2194           '':U @ num-chk
     2195           '':U @ qnty
     2196           '':U shop-name
     2197            with frame Dialog-Frame .
     2198      end.
     2199     DEFINE VARIABLE dops as character no-undo .
     2200     run proc-view-changes in this-procedure no-error.
     2201   END.
     2202   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     2203   DO:
     2204   END.
     2205   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     2206   DO:
     2207      run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     2208     if error-status:error then return no-apply.
     2209   END.
     2210   ON RETURN OF sch-code IN FRAME Dialog-Frame
     2211   DO:
     2212      run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     2213     if error-status:error then return no-apply.
     2214   END.
     2215   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     2216   DO:
     2217      run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-date, "doc-date") no-error.
     2218     if error-status:error then return no-apply.
     2219   END.
     2220   ON RETURN OF sch-date IN FRAME Dialog-Frame
     2221   DO:
     2222       run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-date, "doc-date":U) no-error.
     2223     if error-status:error then return no-apply.
     2224   END.
     2225   ON CTRL-J OF sch-fact IN FRAME Dialog-Frame
     2226   DO:
     2227      run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-fact, "fact-date":U) no-error.
     2228     if error-status:error then return no-apply.
     2229   END.
     2230   ON RETURN OF sch-fact IN FRAME Dialog-Frame
     2231   DO:
     2232     run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-fact, "fact-date":U) no-error.
     2233     if error-status:error then return no-apply.
     2234   END.
     2235   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2236   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2237   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2238   on help of frame Dialog-Frame
     2239   do:
     2240     run gbl/app_help.p
     2241       (input this-procedure :file-name
     2242       ,input ''
     2243       ,input ?
     2244       ) no-error.
     2245     if error-status :error then do:
     2246       message
     2247         "Ошибка при вызове помощи"
     2248         error-status :get-message(1)
     2249         view-as alert-box .
     2250     end.
     2251   end.
     2252   run minbtn-set in this-procedure .
     2253   on choose of b-help in frame Dialog-Frame
     2254   do:
     2255     apply "help":u to frame Dialog-Frame .
     2256   end.
     2257   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2258   procedure minbtn-set :
     2259       do
     2260           on error undo, return error return-value
     2261           :
     2262           define variable ii              as integer       no-undo .
     2263           define variable fh              as widget-handle no-undo .
     2264           define variable hh              as widget-handle no-undo .
     2265           define variable v-h             as handle        extent 4 no-undo .
     2266           define variable v-name-button   as character     no-undo .
     2267           define variable v-help-old-x    as decimal       no-undo .
     2268           define variable v-help-old-y    as decimal       no-undo .
     2269           define variable v-help-old-size as decimal       no-undo .
     2270           define variable v-frame-width   as decimal       no-undo .
     2271           define variable jj              as integer       no-undo .
     2272           do
     2273               on error undo, return error
     2274               :
     2275               assign
     2276                   v-frame-width = frame Dialog-Frame:width - 0.3
     2277                   fh            = frame Dialog-Frame:first-child
     2278                   hh            = fh:first-child
     2279                   ii            = 1
     2280                   .
     2281               do while valid-handle(hh):
     2282                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2283                   do:
     2284                       case lc(hh:name) :
     2285                           when "b-help" then
     2286                               do:
     2287                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2288                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2289                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2290                                   hh:TOOLTIP = "Помощь" .
     2291                                   v-help-old-x = hh:column .
     2292                                   v-help-old-y = hh:row    .
     2293                                   v-help-old-size = hh:width .
     2294                                   hh:width-chars = 2.5 .
     2295                               end.
     2296                           when "b-print" then
     2297                               do:
     2298                                   hh:load-image("cmp/b-print.bmp":u) .
     2299                                   hh:TOOLTIP = "Печать" .
     2300                                   v-h[ii] = hh:handle .
     2301                                   ii = ii + 1 .
     2302                                   hh:width-chars = 3 .
     2303                               end.
     2304                           when "b-history" or
     2305                           when "b-hist" then
     2306                               do:
     2307                                   hh:load-image("cmp/b-hist.bmp":u) .
     2308                                   hh:TOOLTIP = "История" .
     2309                                   v-h[ii] = hh:handle .
     2310                                   ii = ii + 1 .
     2311                                   hh:width-chars = 3 .
     2312                               end.
     2313                           when "b-sch" then
     2314                               do:
     2315                                   hh:load-image("cmp/b-sch.bmp":u) .
     2316                                   hh:TOOLTIP = "Установка Фильтра" .
     2317                                   v-h[ii] = hh:handle .
     2318                                   ii = ii + 1 .
     2319                                   hh:width-chars = 3 .
     2320                               end.
     2321                           when "b-hist-user" then
     2322                               do:
     2323                                   hh:load-image("cmp/b-hist.bmp":u) .
     2324                                   hh:TOOLTIP = "История пользователя" .
     2325                                   ii = ii + 1 .
     2326                               end.
     2327                       end case.
     2328                   end.
     2329                   hh = hh:next-sibling.
     2330               end.
     2331               b-help:column = v-frame-width - b-help:width-chars.
     2332               jj = 0.
     2333               repeat ii = 4 to 1 by -1 :
     2334                   if valid-handle (v-h[ii] ) then
     2335                   do:
     2336                       jj  = jj + 1 .
     2337                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2338                       v-h[ii]:row    = v-help-old-y .
     2339                   end.
     2340               end.
     2341           end.
     2342       end.
     2343   end procedure.
     2344   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2345   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2346   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2347   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2348   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2349   define variable v-diasize-current-frame-height as decimal   no-undo .
     2350   define variable v-diasize-change-size          as logical   no-undo .
     2351   define variable v-diasize-resize-button        as handle    no-undo .
     2352   define variable v-diasize-wndmax               as logical   no-undo .
     2353   define variable v-diasize-wndstore             as logical   no-undo .
     2354   define variable v-diasize-proc-name            as character no-undo .
     2355   define variable v-diasize-browse-handle        as handle    no-undo .
     2356   define variable v-diasize-browse-number        as integer   no-undo .
     2357   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2358   define temp-table temp-diasize-handle no-undo
     2359     field handle-value  as handle
     2360     field save-position as decimal
     2361     index xpk is primary unique handle-value
     2362     .
     2363   define temp-table temp-browse-handle no-undo
     2364     field browse-type   as character
     2365     field browse-number as integer
     2366     field browse-handle as handle
     2367     field original-size as decimal
     2368     index xpk is primary unique browse-type browse-number
     2369     index xie browse-type browse-handle
     2370   .
     2371   procedure diasize_change-height :
     2372     define input  parameter p-change-value  as decimal   no-undo .
     2373     define input  parameter p-move-resize   as logical   no-undo .
     2374     define variable v-field-group-handle    as handle    no-undo .
     2375     define variable v-object-handle         as handle    no-undo .
     2376     define variable v-frame-height          as decimal   no-undo .
     2377     define variable v-frame-virtual-height  as decimal   no-undo .
     2378     define variable v-browse-height         as decimal   no-undo .
     2379     define variable v-window-height         as decimal   no-undo .
     2380     define variable v-window-virtual-height as decimal   no-undo .
     2381     define variable v-change-sign           as integer   no-undo .
     2382     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2383     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2384     if p-change-value > 0
     2385     then do:
     2386       if frame Dialog-Frame :height + p-change-value
     2387           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2388       then do:
     2389         assign
     2390           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2391                           - (frame Dialog-Frame :height-chars)
     2392         .
     2393         if p-change-value <= 0
     2394         then do:
     2395           run diasize_position-resize-button in this-procedure .
     2396           return .
     2397         end.
     2398       end.
     2399     end.
     2400     if p-change-value < 0
     2401     then do:
     2402       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2403       then do:
     2404         assign
     2405           p-change-value = v-diasize-orig-frame-height
     2406                          - (frame Dialog-Frame :height-chars)
     2407         .
     2408         if p-change-value >= 0
     2409         then do:
     2410           run diasize_position-resize-button in this-procedure .
     2411           return .
     2412         end.
     2413       end.
     2414     end.
     2415     if p-change-value >= 0
     2416     then do:
     2417       assign
     2418         v-change-sign = 1
     2419       .
     2420     end.
     2421     else do:
     2422       assign
     2423         v-change-sign = -1
     2424       .
     2425     end.
     2426     assign
     2427       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2428     .
     2429     if p-change-value = 0
     2430     then do:
     2431       run diasize_position-resize-button in this-procedure .
     2432       return .
     2433     end.
     2434     move_block:
     2435     do
     2436     on error undo move_block, retry move_block
     2437     :
     2438       if retry
     2439       then do:
     2440         do
     2441         on error undo move_block, leave move_block
     2442         :
     2443           if p-change-value > 0
     2444           then do:
     2445             for each buf_temp-diasize-handle
     2446             on error undo, next
     2447             :
     2448               assign
     2449                 v-object-handle = buf_temp-diasize-handle.handle-value
     2450               .
     2451               if v-object-handle <> v-diasize-resize-button
     2452               then do:
     2453                 assign
     2454                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2455                 .
     2456               end.
     2457             end.
     2458             assign
     2459               v-diasize-browse-handle :height = v-browse-height
     2460             .
     2461             for each buf_temp-browse-handle
     2462               where buf_temp-browse-handle.browse-type = 'height':u
     2463             on error undo, next
     2464             :
     2465               assign
     2466                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2467               .
     2468             end.
     2469             assign
     2470               frame Dialog-Frame :height = v-frame-height
     2471             .
     2472             if frame Dialog-Frame :scrollable = true
     2473             then do:
     2474               assign
     2475                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2476               .
     2477             end.
     2478             run diasize_position-resize-button in this-procedure .
     2479           end.
     2480           else do:
     2481             if frame Dialog-Frame :scrollable = true
     2482             then do:
     2483               assign
     2484                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2485               .
     2486             end.
     2487             assign
     2488               frame Dialog-Frame :height = v-frame-height
     2489             .
     2490             assign
     2491               v-diasize-browse-handle :height = v-browse-height
     2492             .
     2493             for each buf_temp-browse-handle
     2494               where buf_temp-browse-handle.browse-type = 'height':u
     2495             on error undo, next
     2496             :
     2497               assign
     2498                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2499               .
     2500             end.
     2501             for each buf_temp-diasize-handle
     2502             on error undo, next
     2503             :
     2504               assign
     2505                 v-object-handle = buf_temp-diasize-handle.handle-value
     2506               .
     2507               if v-object-handle <> v-diasize-resize-button
     2508               then do:
