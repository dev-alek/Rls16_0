     2592           v-diasize-resize-button :row    = 1
     2593           v-diasize-resize-button :column = 1
     2594         .
     2595       end.
     2596       if p-change-value > 0
     2597       then do:
     2598         if frame Dialog-Frame :scrollable = true
     2599         then do:
     2600           assign
     2601             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2602             no-error .
     2603           if error-status :error
     2604           or error-status :get-message(1) <> ""
     2605           then do:
     2606             undo move_block, retry move_block .
     2607           end.
     2608         end.
     2609         assign
     2610           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2611           no-error .
     2612         if error-status :error
     2613         or error-status :get-message(1) <> ""
     2614         then do:
     2615           undo move_block, retry move_block .
     2616         end.
     2617         assign
     2618           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2619           no-error .
