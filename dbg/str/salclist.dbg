     1342   procedure prn-lib-reportviewer :
     1343     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1344     define input parameter p-report-name-html as character no-undo .
     1345     define input parameter p-param        as character no-undo .
     1346     define variable v-excel           as character no-undo init 'TRUE' .
     1347     define variable v-value-character as character no-undo .
     1348     define variable v-value-integer   as character no-undo .
     1349     define variable v-value-date      as date      no-undo .
     1350     define variable v-value-decimal   as decimal   no-undo .
     1351     define variable rep-excel         as logical   no-undo .
     1352     define variable excel-string      as character no-undo .
     1353     define variable v-param-type      as character no-undo .
     1354     define variable v-tth             as handle    no-undo .
     1355     run adm/shattri.p (
     1356       input "get":U
     1357       ,input  ""
     1358       ,input  0
     1359       ,input  'report-glob':U
     1360       ,input  'rep-excel':U
     1361       ,output v-value-character
     1362       ,output v-value-date
     1363       ,output v-value-decimal
     1364       ,output v-value-integer
     1365       ,output rep-excel
     1366       ,output v-param-type
     1367       ,INPUT-OUTPUT table-handle v-tth
     1368       )  .
     1369     if rep-excel then v-excel = "TRUE" .
     1370     else v-excel = "FALSE" .
     1371     if p-param eq ""
     1372     then
     1373        p-param = "EXCEL:" + v-excel.
     1374     else
     1375        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1376     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1377   end procedure.
