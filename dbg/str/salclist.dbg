     2745   end procedure.
     2746   procedure diasize_set-height :
     2747     define input  parameter p-new-height  as decimal   no-undo .
     2748     define input  parameter p-move-resize as logical   no-undo .
     2749     do
     2750     on error undo, return error return-value
     2751     :
     2752       run diasize_change-height in this-procedure
     2753         (input  (p-new-height - frame Dialog-Frame :height)
     2754         ,input  p-move-resize
     2755         ) .
     2756     end.
     2757   end procedure.
     2758   procedure diasize_change-width :
     2759     define input  parameter p-change-value as decimal   no-undo .
     2760     define input  parameter p-move-resize  as logical   no-undo .
     2761     define variable v-field-group-handle   as handle    no-undo .
     2762     define variable v-object-handle        as handle    no-undo .
     2763     define variable v-frame-width          as decimal   no-undo .
     2764     define variable v-frame-virtual-width  as decimal   no-undo .
     2765     define variable v-browse-width         as decimal   no-undo .
     2766     define variable v-window-width         as decimal   no-undo .
     2767     define variable v-window-virtual-width as decimal   no-undo .
     2768     define variable v-change-sign          as integer   no-undo .
     2769     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2770     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2771     if p-change-value > 0
     2772     then do:
     2773       if frame Dialog-Frame :width + p-change-value >
     2774           session :width-chars
     2775       then do:
     2776         assign
     2777           p-change-value = session :width-chars - frame Dialog-Frame :width
     2778         .
     2779         if p-change-value <= 0
     2780         then do:
     2781           run diasize_position-resize-button in this-procedure .
     2782           return .
     2783         end.
     2784       end.
     2785     end.
     2786     if p-change-value < 0
     2787     then do:
     2788       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2789       then do:
     2790         assign
     2791           p-change-value = v-diasize-orig-frame-width
     2792                          - frame Dialog-Frame :width
     2793         .
     2794         if p-change-value >= 0
     2795         then do:
     2796           run diasize_position-resize-button in this-procedure .
     2797           return .
     2798         end.
     2799       end.
     2800     end.
     2801     if p-change-value >= 0
     2802     then do:
     2803       assign
     2804         v-change-sign = 1
     2805       .
     2806     end.
     2807     else do:
     2808       assign
     2809         v-change-sign = -1
     2810       .
     2811     end.
     2812     assign
     2813       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2814     .
     2815     if p-change-value = 0
     2816     then do:
     2817       run diasize_position-resize-button in this-procedure .
     2818       return .
     2819     end.
     2820     move_block:
