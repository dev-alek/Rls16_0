     3114           define variable v-cntxt-db-num        as integer   no-undo .
     3115           define variable v-cntxt-userid        as character no-undo .
     3116           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3117                                             , OUTPUT v-cntxt-userid
     3118                                             ) .
     3119           run gbl/wndsizew.p
     3120             (input  v-cntxt-db-num
     3121             ,input  v-cntxt-userid
     3122             ,input  v-diasize-proc-name
     3123             ,input  'width':u
     3124             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3125             ) .
     3126         end.
     3127       end.
     3128     end.
     3129     assign
     3130       v-diasize-change-size = false
     3131     .
     3132   end procedure.
     3133   procedure diasize_set-width :
     3134     define input  parameter p-new-width  as decimal   no-undo .
     3135     define input  parameter p-move-resize as logical   no-undo .
     3136     do
     3137     on error undo, return error return-value
     3138     :
     3139       run diasize_change-width in this-procedure
     3140         (input  (p-new-width - frame Dialog-Frame :width)
     3141         ,input  p-move-resize
     3142         ) .
     3143     end.
     3144   end procedure.
     3145   procedure diasize_position-resize-button :
     3146     do with frame Dialog-Frame
     3147     :
     3148       hide v-diasize-resize-button .
     3149       assign
     3150         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3151                     - 1
     3152                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3153         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3154                     - 1
     3155                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3156       .
     3157       view v-diasize-resize-button .
     3158     end.
     3159   end procedure.
     3160   on alt-right anywhere
     3161   do:
     3162     run diasize_change-width in this-procedure
     3163       (input 1
     3164       ,input true
     3165       ) .
     3166     return no-apply .
     3167   end.
     3168   on alt-left anywhere
     3169   do:
     3170     run diasize_change-width in this-procedure
     3171       (input -1
     3172       ,input true
     3173       ) .
     3174     return no-apply .
     3175   end.
     3176   on alt-down anywhere
     3177   do:
     3178     run diasize_change-height in this-procedure
     3179       (input 1
     3180       ,input true
     3181       ) .
     3182     return no-apply .
     3183   end.
     3184   on alt-up anywhere
     3185   do:
     3186     run diasize_change-height in this-procedure
     3187       (input -1
     3188       ,input true
     3189       ) .
     3190     return no-apply .
     3191   end.
     3192   on alt-enter of frame Dialog-Frame
     3193   do:
     3194     run diasize_maximize in this-procedure
     3195       (input  ?
     3196       ).
     3197     return no-apply .
     3198   end.
     3199   procedure diasize_end-move :
     3200     do
     3201     on error undo, return error return-value
     3202     :
     3203       define variable v-row-delta as decimal   no-undo .
     3204       define variable v-col-delta as decimal   no-undo .
     3205       define variable v-new-row as decimal   no-undo .
     3206       define variable v-new-col as decimal   no-undo .
     3207       assign
     3208         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3209         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3210       .
     3211       assign
     3212         v-row-delta = v-new-row - frame Dialog-Frame :height
     3213         v-col-delta = v-new-col - frame Dialog-Frame :width
     3214       .
     3215       run diasize_change-height in this-procedure
     3216         (input v-row-delta
     3217         ,input true
     3218         ) .
     3219       run diasize_change-width in this-procedure
     3220         (input v-col-delta
     3221         ,input true
     3222         ) .
     3223     end.
     3224   end procedure.
     3225   procedure diasize_maximize :
     3226     define input  parameter p-action as logical   no-undo .
     3227     do
     3228     on error undo, return error return-value
     3229     :
     3230       if p-action = ?
     3231       then do:
     3232         if v-diasize-need-maximize = true
     3233         then do:
     3234           assign
     3235             p-action = true
     3236           .
     3237         end.
     3238         else do:
     3239           assign
     3240             p-action = false
     3241           .
     3242         end.
     3243       end.
     3244       if p-action = true
     3245       then do:
     3246         run diasize_change-height in this-procedure
     3247           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3248               - frame Dialog-Frame :height-chars
     3249           ,input true
     3250           ) .
     3251         run diasize_change-width in this-procedure
     3252           (input session :width-chars
     3253               - frame Dialog-Frame :width-chars
     3254           ,input true
     3255           ) .
     3256         assign
     3257           v-diasize-need-maximize = false
     3258         .
     3259       end.
     3260       else do:
     3261         run diasize_change-width in this-procedure
     3262           (input v-diasize-orig-frame-width
     3263               - frame Dialog-Frame :width-chars
     3264           ,input true
     3265           ) .
     3266         run diasize_change-height in this-procedure
     3267           (input v-diasize-orig-frame-height
     3268               - frame Dialog-Frame :height-chars
     3269           ,input true
     3270           ) .
     3271         assign
     3272           v-diasize-need-maximize = true
     3273         .
     3274       end.
     3275     end.
     3276   end procedure.
     3277   procedure diasize_restore-orig-size :
     3278     do
     3279     on error undo, return error return-value
     3280     :
     3281       assign
     3282         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3283         v-diasize-current-frame-height = frame Dialog-Frame :height
     3284       .
     3285       run diasize_set-height in this-procedure
     3286         (input  v-diasize-orig-frame-height
     3287         ,input  true
     3288         ) .
     3289       run diasize_set-width in this-procedure
     3290         (input  v-diasize-orig-frame-width
     3291         ,input  true
     3292         ) .
     3293     end.
     3294   end procedure.
     3295   procedure diasize_restore-current-size :
     3296     do
     3297     on error undo, return error return-value
     3298     :
     3299       run diasize_set-height in this-procedure
     3300         (input  v-diasize-current-frame-height
     3301         ,input  true
     3302         ) .
     3303       run diasize_set-width in this-procedure
     3304         (input  v-diasize-current-frame-width
     3305         ,input  true
     3306         ) .
     3307     end.
     3308   end procedure.
     3309   procedure diasize_set-browse-handle :
     3310     define input  parameter p-browse-handle as handle   no-undo .
     3311     define buffer buf_temp-browse-handle for temp-browse-handle .
     3312     do
     3313     on error undo, return error return-value
     3314     :
     3315       assign
     3316         v-diasize-browse-handle = p-browse-handle
     3317       .
     3318       for each buf_temp-browse-handle
     3319       on error undo, return error return-value
     3320       :
     3321         delete buf_temp-browse-handle .
     3322       end.
     3323     end.
     3324   end procedure.
     3325   procedure diasize_add_browse :
     3326     define input  parameter p-browse-type   as character no-undo .
     3327     define input  parameter p-browse-handle as handle    no-undo .
     3328     define buffer buf_temp-browse-handle for temp-browse-handle .
     3329     do
     3330     on error undo, return error return-value
     3331     :
     3332       assign
     3333         v-diasize-browse-number = v-diasize-browse-number + 1
     3334       .
     3335       create buf_temp-browse-handle .
     3336       assign
     3337         buf_temp-browse-handle.browse-type   = p-browse-type
     3338         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3339         buf_temp-browse-handle.browse-handle = p-browse-handle
     3340       .
     3341     end.
     3342   end procedure.
     3343   procedure diasize_init :
     3344     define variable v-default-value    as logical   no-undo .
     3345     define variable v-restore-saved    as logical   no-undo .
     3346     define variable v-resize-value-str as character no-undo .
     3347     do
     3348     on error undo, return error return-value
     3349     :
     3350       do with frame Dialog-Frame
     3351       :
     3352         assign
     3353           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3354           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3355           v-diasize-browse-handle     = browse BR-changes :handle
     3356         .
     3357         create button v-diasize-resize-button
     3358         assign
     3359           parent        = frame Dialog-Frame :first-child
     3360           label         = "s"
     3361           height-pixels = 16
     3362           width-pixels  = 16
     3363           visible       = true
     3364           sensitive     = true
     3365           movable       = true
     3366           triggers:
     3367             on end-move persistent run diasize_end-move in this-procedure .
     3368           end triggers.
     3369         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3370         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3371         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3372         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3373         assign
     3374           v-diasize-wndmax = false
     3375         .
     3376         if connected("ub") = true
     3377         then do:
     3378           define variable v-cntxt-db-num        as integer   no-undo .
     3379           define variable v-cntxt-userid        as character no-undo .
     3380           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3381                                             , OUTPUT v-cntxt-userid
     3382                                             ) .
     3383           run gbl/wndpar_r.p
     3384             (input  v-cntxt-db-num
     3385             ,input  v-cntxt-userid
     3386             ,input  'wndmax':U
     3387             ,output v-diasize-wndmax
     3388             ,output v-default-value
     3389             ) .
     3390         end.
     3391         assign
     3392           v-diasize-wndstore = false
     3393         .
     3394         if connected("ub") = true
     3395         then do:
     3396           run gbl/wndpar_r.p
     3397             (input  v-cntxt-db-num
     3398             ,input  v-cntxt-userid
     3399             ,input  'wndstore':U
     3400             ,output v-diasize-wndstore
     3401             ,output v-default-value
     3402             ) .
     3403         end.
     3404         assign
     3405           v-diasize-proc-name = entry(1, program-name(2), '.')
     3406         .
     3407         if v-diasize-wndstore = true
     3408         then do:
     3409           assign
     3410             v-restore-saved = false
     3411           .
     3412           if connected("ub") = true
     3413           then do:
     3414             run gbl/wndsizer.p
     3415               (input  v-cntxt-db-num
     3416               ,input  v-cntxt-userid
     3417               ,input  v-diasize-proc-name
     3418               ,input  'height':u
     3419               ,output v-resize-value-str
     3420               ) .
     3421             if v-resize-value-str <> '':U
     3422             then do:
     3423               run diasize_change-height in this-procedure
     3424                 (input  integer(v-resize-value-str)
     3425                 ,input  true
     3426                 ) .
     3427               assign
     3428                 v-restore-saved = true
     3429               .
     3430             end.
     3431           end.
     3432           if connected("ub") = true
     3433           then do:
     3434             run gbl/wndsizer.p
     3435               (input  v-cntxt-db-num
     3436               ,input  v-cntxt-userid
     3437               ,input  v-diasize-proc-name
     3438               ,input  'width':u
     3439               ,output v-resize-value-str
     3440               ) .
     3441             if v-resize-value-str <> '':U
     3442             then do:
     3443               run diasize_change-width in this-procedure
     3444                 (input  integer(v-resize-value-str)
     3445                 ,input  true
     3446                 ) .
     3447               assign
     3448                 v-restore-saved = true
     3449               .
     3450             end.
     3451           end.
     3452           if v-restore-saved <> true
     3453           then do:
     3454             if v-diasize-wndmax = true
     3455             then do:
     3456               run diasize_maximize in this-procedure
     3457                 (input  true
     3458                 ) .
     3459             end.
     3460           end.
     3461         end.
     3462         else do:
     3463           if v-diasize-wndmax = true
     3464           then do:
     3465             run diasize_maximize in this-procedure
     3466               (input  true
     3467               ) .
     3468           end.
     3469         end.
     3470       end.
     3471     end.
     3472   end procedure.
     3473   procedure diasize_need-full-display :
     3474     define output parameter p-need-full-display as logical   no-undo .
     3475     do
     3476     on error undo, return error return-value
     3477     :
     3478       assign
     3479         p-need-full-display = v-diasize-need-full-display
     3480       .
     3481       assign
     3482         v-diasize-need-full-display = false
     3483       .
     3484     end.
     3485   end procedure.
     3486   procedure get-context :
     3487      define output parameter p-db-num as integer          no-undo.
     3488      define output parameter p-user-id as character        no-undo.
     3489      define variable v-login               as character    no-undo.
     3490      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3491      define buffer buf_user-login  for ub.user-login .
     3492      do
     3493      on error undo, return error
     3494      :
     3495            FIND FIRST buf_sys-ctrl no-lock.
     3496            ASSIGN
     3497               v-login = USERID("ub")
     3498               p-db-num = buf_sys-ctrl.db-num
     3499            .
     3500            FIND FIRST buf_user-login
     3501                 WHERE buf_user-login.db-num = p-db-num
     3502                   AND buf_user-login.user-login = v-login
     3503                 no-lock
     3504                 no-error
     3505                 .
     3506            IF AVAILABLE buf_user-login
     3507            THEN DO:
     3508               assign
     3509                  p-user-id = buf_user-login.user-id
     3510               .
     3511            END.
     3512      end.
     3513   end procedure.
     3514       run diasize_init in this-procedure .
     3515   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3516   do:
     3517     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3518   end.
     3519   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3520   procedure set-filter-name :
     3521   define input parameter p-filter-name as character no-undo .
     3522     do with frame Dialog-Frame:
     3523       if p-filter-name > "" then do:
     3524         assign
     3525           frame Dialog-Frame:title
     3526             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3527         .
     3528         assign
     3529           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3530         .
     3531       end.
     3532       else do:
     3533         assign
     3534           b-sch :tooltip = ""
     3535         .
     3536       end.
     3537     end.
     3538   end procedure.
     3539   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3540   on f5 of frame Dialog-Frame anywhere
     3541   do:
     3542     OPEN QUERY BR-changes FOR EACH temp-changes.
     3543       apply "VALUE-CHANGED" to BR-changes.
     3544   end.
     3545   define variable vss-include-info31 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3546   on INS of frame Dialog-Frame anywhere do:
     3547     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     3548     return no-apply.
     3549   end.
     3550   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3551   on F2 of frame Dialog-Frame anywhere do:
     3552     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     3553     return no-apply.
     3554   end.
     3555   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3556   on F2 of frame Dialog-Frame anywhere do:
     3557     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     3558     return no-apply.
     3559   end.
     3560   define variable vss-include-info34 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3561   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     3562     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     3563     return no-apply.
     3564   end.
     3565   MAIN-BLOCK:
     3566   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3567      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3568   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3570     (output v-curr-r-b
     3571     )  .
     3572     v-rid-list = p-rid-list.
     3573     FIND FIRST ub.sys-ctrl NO-LOCK.
     3574     if avail ub.sys-ctrl then do:
     3575       FIND FIRST ub.db no-LOCK where
     3576                 ub.db.db-num = ub.sys-ctrl.db-num NO-ERROR.
     3577       if not avail ub.db then do:
     3578         message "Отсутствует запись о БД (db)"
     3579         view-as alert-box ERROR.
     3580         return error.
     3581       end.
     3582     END.
     3583     CASE par-mode:
     3584       WHEN 'удаленные':U + chr(44) + 'объект':U
     3585       or when 'удаленные':U + chr(44) + 'фирма':U
     3586       then do:
     3587         FIND FIRST buf_obj No-LOCK WHERE
     3588                         buf_obj.obj-type = p-obj-type and
     3589                         buf_obj.obj-code = p-obj-code No-ERROR.
     3590         if not avail buf_obj then do:
     3591           message vss-workfile vss-revision vss-description skip
     3592           "Неверное значение параметров вызова p-obj-type и/или p-obj-code"
     3593           p-obj-type p-obj-code
     3594           view-as alert-box ERROR.
     3595           return.
     3596         end.
     3597       end.
     3598       when 'one':U
     3599       then do:
     3600         FIND FIRST X_inkas No-LOCK WHERE
     3601                         X_inkas.inkas-code = p-inkas-code No-ERROR.
     3602         if not avail X_inkas then do:
     3603           message vss-workfile vss-revision vss-description skip
     3604           view-as alert-box ERROR.
     3605           return.
     3606         end.
     3607       end.
     3608       otherwise do:
     3609           message vss-workfile vss-revision vss-description skip
     3610           "Неверный вызов - par-mode=" par-mode
     3611           view-as alert-box ERROR.
     3612           return.
     3613       end.
     3614     end CASE.
     3615     if par-mode = 'удаленные':U + chr(44) + 'объект':U then do:
     3616        run get-params in this-procedure ( input p-obj-type, input p-obj-code) .
     3617      end.
     3618     if v-rid-list <> "":U then do:
     3619       assign
     3620       v-doc-rec = integer(entry(1, v-rid-list))
     3621       .
     3622     end.
     3623     RUN MyEnable in this-procedure .
     3624     RUn openbr in this-procedure ( input yes, input no, input '':U).
     3625     Hide mark-num in frame Dialog-Frame .
     3626     WAIT-FOR GO OF FRAME Dialog-Frame.
     3627   END.
     3628   RUN disable_UI.
     3629   PROCEDURE disable_UI :
     3630     HIDE FRAME Dialog-Frame.
     3631   END PROCEDURE.
     3632   PROCEDURE enable_UI :
     3633     DISPLAY ED-notes sch-code sch-date sch-fact mark-num l-qnty qnty l-num-chk
     3634             num-chk shop-name f-search-label
     3635         WITH FRAME Dialog-Frame.
     3636     ENABLE b-quit B-mark B-sel B-print B-sch B-Help BR-docs ED-notes sch-code
     3637            sch-date sch-fact BR-changes mark-num l-qnty qnty l-num-chk num-chk
     3638            shop-name f-search-label
     3639         WITH FRAME Dialog-Frame.
     3640     VIEW FRAME Dialog-Frame.
     3641   END PROCEDURE.
     3642   PROCEDURE Get-params :
     3643   define input parameter locp-obj-type like ub.clients.obj-type no-undo.
     3644   define input parameter locp-obj-code like ub.clients.obj-code no-undo.
     3645   define variable conf-attr as char no-undo.
     3646   define variable conf-par as char no-undo.
     3647   define variable par-type as char no-undo.
     3648   find first ub.shop No-LOCK WHERE
     3649   ub.shop.obj-code = locp-obj-code No-ERROR.
     3650   if not available ub.shop then return.
     3651   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3652   define variable v-param-type36 as character no-undo .
     3653   define variable v-value-character36 as character no-undo .
     3654   define variable v-value-date36 as date no-undo .
     3655   define variable v-value-decimal36 as decimal no-undo .
     3656   define variable v-value-integer36 as INTEGER no-undo .
     3657   define variable v-tth36 as handle no-undo .
     3658   run adm/shattri.p (
     3659       input "get":U
     3660       ,input  locp-obj-type
     3661       ,input  locp-obj-code
     3662       ,input  'get-chk':U
     3663       ,input  'cas-shft':U
     3664       ,output v-value-character36
     3665       ,output v-value-date36
     3666       ,output v-value-decimal36
     3667       ,output v-value-integer36
     3668       ,output cas-shft
     3669       ,output v-param-type36
     3670       ,INPUT-OUTPUT table-handle v-tth36
     3671       )  .
     3672   delete object v-tth36.
     3673     ASSIGN
     3674     v-is-fbr-obj = ub.shop.is-catering.
     3675     run gbl/tpsi-obj.p ( input locp-obj-type
     3676                         ,input locp-obj-code
     3677                         ,output v-is-tpsi-obj) no-error .
     3678   END PROCEDURE.
     3679   PROCEDURE MyEnable :
     3680   define variable v-shift as integer no-undo .
     3681   define variable fh as widget-handle no-undo .
     3682   define variable hh as widget-handle no-undo .
     3683   define variable lh as widget-handle no-undo .
     3684   define variable v-updated as character no-undo .
     3685   br-docs:num-locked-columns in frame Dialog-Frame = 7.
     3686   ASSIGN
     3687   v-tab-order = "b-quit,b-mark,b-sel,b-sch,b-print,b-help," +
     3688                 "br-docs,sch-code,sch-date,sch-fact"
     3689   temp-changes.l_name:resizable in browse br-changes = true
     3690   temp-changes.v_old:resizable in browse br-changes = true
     3691   temp-changes.v_new:resizable in browse br-changes = true
     3692   temp-changes.l_name:width in browse br-changes = 30
     3693   temp-changes.v_old:width in browse br-changes = 40
     3694   temp-changes.v_new:width in browse br-changes = 40
     3695   .
     3696   DISPLAY
     3697   ED-notes
     3698   sch-code
     3699   sch-date
     3700   sch-fact
     3701   qnty
     3702   shop-name when (par-mode <>  'удаленные':U + chr(44) + 'объект':U )
     3703   num-chk
     3704   f-search-label
     3705   l-num-chk
     3706   l-qnty
     3707   WITH FRAME Dialog-Frame.
     3708   ENABLE
     3709   b-quit
     3710   B-mark when lookup("b-mark":U, bttns) > 0
     3711   B-sel when lookup("b-sel":U, bttns) > 0
     3712   B-sch
     3713   B-print
     3714   B-Help
     3715   BR-docs
     3716   ED-notes
     3717   sch-code
     3718   sch-date
     3719   sch-fact
     3720   mark-num
     3721   br-changes when not par-mode begins 'удаленные':U
     3722   WITH FRAME Dialog-Frame.
     3723   VIEW FRAME Dialog-Frame.
     3724   if par-mode begins 'удаленные':U then do:
     3725    assign
     3726    v-shift = br-changes:height
     3727   fh = frame Dialog-Frame:first-child
     3728   hh = fh:first-child
     3729   .
     3730     do while valid-handle(hh):
     3731       IF lookup(hh:type, "button,fill-in,literal,text,rectangle,Radio-set,editor") > 0
     3732         AND hh:ROW >= br-docs:ROW + br-docs:height
     3733         and hh:row <= 21
     3734         and lookup(v-updated, hh:name) = 0 THEN DO:
     3735             hh:ROW = hh:ROW + v-shift.
     3736            assign
     3737             v-updated = v-updated + chr(44) + hh:name.
     3738             IF hh:TYPE = "fill-in"
     3739             AND valid-handle(hh:side-label-handle) THEN dO:
     3740               lh = hh:SIDE-LABEL-HANDLE.
     3741               lh:ROW = lh:ROW + v-shift.
     3742           END.
     3743         END.
     3744         hh = hh:next-sibling.
     3745     END.
     3746     assign
     3747     br-changes:visible = no
     3748     br-docs:height = br-docs:height + v-shift.
     3749   end.
     3750   IF par-mode = 'one'
     3751   THEN DO:
     3752     HIDE
     3753     f-search-label
     3754     sch-code
     3755     sch-date
     3756     sch-fact
     3757     IN FRAME Dialog-Frame.
     3758   END.
     3759   IF NOT v-is-fbr-obj = YES THEN DO:
     3760     ASSIGN
     3761     X_c-inkas.AUTO-fbr:VISIBLE IN BROWSE br-docs = NO
     3762     X_c-inkas.rest-dish:VISIBLE IN BROWSE br-docs = NO
     3763     X_c-inkas.rest-ingr:VISIBLE IN BROWSE br-docs = NO
     3764     .
     3765   END.
     3766   IF NOT v-is-tpsi-obj = YES THEN DO:
     3767     ASSIGN
     3768     X_c-inkas.AUTO-tpsi:VISIBLE IN BROWSE br-docs = NO
     3769     X_c-inkas.rest-tpsi:VISIBLE IN BROWSE br-docs = NO
     3770     .
     3771   END.
     3772   case par-mode:
     3773     when 'удаленные':U + chr(44) + 'объект':U then do:
     3774       assign
     3775       frame Dialog-Frame :title = substitute("Удаленные продажи по &1&2", p-obj-type, p-obj-code).
     3776     end.
     3777     when 'удаленные':U + chr(44) + 'фирма':U then do:
     3778       assign
     3779       frame Dialog-Frame :title = substitute("Удаленные продажи по фирме &1", p-host-code).
     3780     end.
     3781     when 'удаленные':U then do:
     3782       assign
     3783       frame Dialog-Frame :title = substitute("Удаленные продажи").
     3784     end.
     3785     when 'one' then do:
     3786       assign
     3787       frame Dialog-Frame :title = substitute("История продажи &1", X_inkas.inkas-code).
     3788     end.
     3789   end case.
     3790   END PROCEDURE.
     3791   PROCEDURE OpenBr :
     3792   define input  parameter p-open-query     as logical   no-undo .
     3793   define input  parameter p-find-next      as logical   no-undo .
     3794   define input  parameter p-find-condition as character no-undo .
     3795   define variable l-query-was-opened as logical no-undo .
     3796   define variable title0 as character no-undo.
     3797   title0 = "Продажи".
     3798   run waitfram-show in this-procedure ( input "Ждите...").
     3799   define variable sort-column-phrase as character no-undo .
     3800   case sort-column-name :
     3801   when "" then do:
     3802   assign
     3803     sort-column-phrase = ""
     3804   .
     3805   end.
     3806   otherwise do:
     3807   assign
     3808     sort-column-phrase = "by " + sort-column-name
     3809   .
     3810   end.
     3811   end case.
     3812   define variable l-open-query as logical   no-undo .
     3813   filter-point = filter-point0 + par-mode.
     3814   CASE par-mode :
     3815   WHEN 'удаленные':U + chr(44) + 'объект':U       THEN DO:
     3816      assign
     3817      filter-label = substitute("&1 Один объект, удаленные на факт", filter-label0).
     3818     if p-open-query then do:
     3819       assign
     3820       frame Dialog-Frame:title = substitute("&1 &2&3 удаленные на факт",  title0, p-obj-type, p-obj-code).
     3821     end.
     3822   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3823   define variable  l-disable-where-38  as logical   no-undo .
     3824   define variable  l-filter-open-38    as logical   .
     3825   define variable  flt-rec-38       as recid     no-undo .
     3826   define variable  filter-name-38      as character no-undo .
     3827   define variable  where-phrase-38     as character no-undo .
     3828   define variable  sort-phrase-38      as character no-undo .
     3829   define variable  where-phrase-rus-38 as character no-undo .
     3830   define variable  sort-phrase-rus-38  as character no-undo .
     3831     run waitfram-show in this-procedure
     3832       (input "ЖДИТЕ ..."
     3833       ).
     3834   run gbl/flt-get.p
     3835     (input filter-point
     3836     ,output flt-rec-38
     3837     ,output filter-name-38
     3838     ,output where-phrase-38
     3839     ,output sort-phrase-38
     3840     ,output where-phrase-rus-38
     3841     ,output sort-phrase-rus-38
     3842     ).
     3843   if p-open-query then do:
     3844       run set-filter-name in this-procedure
     3845         (INPUT filter-name-38
     3846         ) no-error .
     3847     assign
     3848       l-filter-open-38 = false
     3849     .
     3850     if flt-rec-38 <> ?
     3851       or sort-column-phrase > ""
     3852     then do:
     3853       define variable  parameter-2-38 as character no-undo .
     3854       define variable  parameter-3-38 as character no-undo .
     3855       define variable  parameter-4-38 as character no-undo .
     3856       define variable  parameter-5-38 as character no-undo .
     3857       define variable  parameter-6-38 as character no-undo .
     3858       define variable  parameter-7-38 as character no-undo .
     3859         assign
     3860         parameter-3-38 =
     3861                                 "FOR EACH X_c-inkas"
     3862         parameter-4-38 =
     3863           (
     3864             if (" X_c-inkas.obj-type = p-obj-type                 and X_c-inkas.obj-code = p-obj-code                 and X_c-inkas.is-del = yes " + " " + where-phrase-38) <> ""
     3865             then  substitute('X_c-inkas.obj-type = &1&2&1                 and X_c-inkas.obj-code = &3                 and X_c-inkas.is-del = yes ', chr(34), p-obj-type, p-obj-code) + " " + where-phrase-38
     3866             else "true"
     3867           )
     3868         parameter-5-38 = (" " + "" + " " + "")
     3869         parameter-6-38 = if sort-phrase-38 = ''
     3870                              then
     3871           (
     3872           " " + "  " +
     3873             " " + sort-column-phrase +
     3874           " " + "  "
     3875           )
     3876                              else
     3877           (
     3878           " " + "  " +
     3879             " " + sort-column-phrase +
     3880           " " + sort-phrase-38
     3881           )
     3882         parameter-7-38 =
     3883           " indexed-reposition  "
     3884       .
     3885       do
     3886       on stop undo, leave
     3887       on error undo, leave
     3888       :
     3889         assign
     3890           l-disable-where-38 =
     3891             (" X_c-inkas.obj-type = p-obj-type                 and X_c-inkas.obj-code = p-obj-code                 and X_c-inkas.is-del = yes " + " " + where-phrase-38 = "")
     3892         .
     3893         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3894                             ,input QUERY br-docs:handle
     3895                             ,input parameter-3-38
     3896                             ,input parameter-4-38
     3897                             ,input parameter-5-38
     3898                             ,input parameter-6-38
     3899                             ,input parameter-7-38
     3900                             )
     3901         .
     3902         assign
     3903           l-filter-open-38 = true
     3904         .
     3905       end.
     3906       if l-filter-open-38 = false then do:
     3907         message
     3908           "Ошибка при фильтрации / сортировке" skip
     3909           "Будут показаны записи без учета фильтра" skip
     3910           view-as alert-box .
     3911       end.
     3912       else do:
     3913           assign
     3914             l-query-was-opened = true
     3915           .
     3916       end.
     3917     end.
     3918     if l-filter-open-38 = false then do:
     3919       OPEN QUERY br-docs FOR EACH X_c-inkas
     3920         where  X_c-inkas.obj-type = p-obj-type                 and X_c-inkas.obj-code = p-obj-code                 and X_c-inkas.is-del = yes
     3921         indexed-reposition
     3922     .
     3923         assign
     3924           l-query-was-opened = true
     3925         .
     3926     end.
     3927   end.
     3928   else do:
     3929     assign
     3930       v-doc-rec = recid( X_c-inkas )
     3931     .
     3932     do
     3933     on stop undo, leave
     3934     on error undo, leave
     3935     :
     3936       if QUERY br-docs:handle:get-buffer-handle(1) = (buffer X_c-inkas:handle) then do:
     3937         assign
     3938         parameter-2-38 = (if p-find-next then "true":u else "false":u )
     3939         parameter-4-38 =
     3940           "where ":u +  substitute('X_c-inkas.obj-type = &1&2&1                 and X_c-inkas.obj-code = &3                 and X_c-inkas.is-del = yes ', chr(34), p-obj-type, p-obj-code) + " ":u + where-phrase-38 + " ":u + p-find-condition + " " + ""
     3941         parameter-5-38 = "  "
     3942       .
     3943         run fltopend_fltfindd in this-procedure  (
     3944                             input this-procedure:handle
     3945                             ,input QUERY br-docs:handle
     3946                             ,input rowid(X_c-inkas)
     3947                             ,input logical(parameter-2-38)
     3948                             ,input no-lock
     3949                             ,input (buffer X_c-inkas:handle)
     3950                             ,input parameter-4-38
     3951                             ,input parameter-5-38
     3952                             ) no-error.
     3953         .
     3954         assign
     3955           v-doc-rec = integer(return-value)
     3956           v-fltopend-rowid[1] = ?
     3957         .
     3958       end.
     3959       else do:
     3960         assign
     3961         parameter-2-38 = (if p-find-next then "true":u else "false":u )
     3962         parameter-3-38 =  "FOR EACH X_c-inkas"
     3963         parameter-4-38 =
     3964           (
     3965             if (" X_c-inkas.obj-type = p-obj-type                 and X_c-inkas.obj-code = p-obj-code                 and X_c-inkas.is-del = yes " + " " + where-phrase-38) <> ""
     3966             then  substitute('X_c-inkas.obj-type = &1&2&1                 and X_c-inkas.obj-code = &3                 and X_c-inkas.is-del = yes ', chr(34), p-obj-type, p-obj-code) + " " + where-phrase-38
     3967             else "true"
     3968           )
     3969         parameter-5-38 = (" " + "" + " " + "" + " " + p-find-condition)
     3970         parameter-6-38 = if sort-phrase-38 = ''
     3971                              then
     3972           (
     3973           " " + "  " +
     3974             " " + sort-column-phrase +
     3975           " " + "  "
     3976           )
     3977                              else
     3978           (
     3979           " " + "  " +
     3980             " " + sort-column-phrase +
     3981           " " + sort-phrase-38
     3982           )
     3983         parameter-7-38 =
     3984           " indexed-reposition  "
     3985       .
     3986         run fltopend_fltfindq in this-procedure  (
     3987                             input this-procedure:handle
     3988                             ,input QUERY br-docs:handle
     3989                             ,input logical(parameter-2-38)
     3990                             ,input no-lock
     3991                             ,input parameter-3-38
     3992                             ,input parameter-4-38
     3993                             ,input parameter-5-38
     3994                             ,input parameter-6-38
     3995                             ,input parameter-7-38
     3996                             ,output v-fltopend-rowid
     3997                             ) no-error.
     3998         .
     3999         v-doc-rec = ?.
     4000       end.
     4001       assign
     4002         l-query-was-opened = true
     4003       .
     4004     end.
     4005   end.
     4006     run waitfram-hide in this-procedure .
     4007   END.
     4008   WHEN 'удаленные':U + chr(44) + 'фирма':U       THEN DO:
     4009     assign
     4010     filter-label = substitute("&1 Один фирма, удаленные на факт", filter-label0).
     4011     if p-open-query then do:
