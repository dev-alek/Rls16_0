      415   def
      416   new shared
      417   temp-table  obj-list no-undo
      418     field obj-type like ub.clients.obj-type
      419     field obj-code like ub.clients.obj-code
      420     field obj-name like ub.clients.obj-name
      421     field obj-id   as integer
