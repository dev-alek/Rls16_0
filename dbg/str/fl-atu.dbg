        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Редактирование атрибутов заказов флористов".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   define new global shared variable g#trdcalib as handle no-undo.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   define temp-table tt-upd-attr no-undo
      114     field code           as character
      115     field type-attr      as character
      116     field format-attr    as character
      117     field fillin_width   as integer
      118     field fillin_height  as integer
      119     field label-attr     as character
      120     field user-can-edit  as logical
      121     field output-display as logical
      122     field hot-key        as character
      123     field can-select     as logical
      124     field other          as character
      125     field proc-attr      as character
      126     field proc-win       as character
      127     field proc-func      as character
      128     field full-screen-val as character
      129     field sort_       as integer
      130     index code is primary unique code
      131     index output-display output-display code
      132     index by-sort sort_
      133     .
      134   define temp-table tt-upd-attr-fuel no-undo
      135     field code           as character
      136     field type-attr      as character
      137     field format-attr    as character
      138     field fillin_width   as integer
      139     field fillin_height  as integer
      140     field label-attr     as character
      141     field user-can-edit  as logical
      142     field output-display as logical
      143     field hot-key        as character
      144     field can-select     as logical
      145     field other          as character
      146     field proc-attr      as character
      147     field proc-win       as character
      148     field proc-func      as character
      149     field full-screen-val as character
      150     field sort_       as integer
      151     index code is primary unique code
      152     index output-display output-display code
      153     index by-sort sort_
      154     .
      155   define input parameter p-mode as character no-undo.
      156   define input parameter p-doc-code like ub.trn-doc.doc-code no-undo.
      157   DEFINE BUTTON b-exit AUTO-GO
      158        LABEL "&Ввод"
      159        SIZE 10 BY 1.
      160   DEFINE BUTTON B-help DEFAULT
      161        LABEL "Помо&щь"
      162        SIZE 10 BY 1
      163        BGCOLOR 8 .
      164   DEFINE BUTTON b-quit AUTO-END-KEY
      165        LABEL "&Отмена"
      166        SIZE 10 BY 1.
      167   DEFINE VARIABLE v-kuda AS CHARACTER
      168        VIEW-AS EDITOR MAX-CHARS 220 SCROLLBAR-VERTICAL
      169        SIZE 62 BY 2 NO-UNDO.
      170   DEFINE VARIABLE l-loc-hour AS INTEGER FORMAT "99":U INITIAL 0
      171        LABEL "Время выполнения заказа"
      172        VIEW-AS FILL-IN
      173        SIZE 3 BY 1 TOOLTIP "Стрелка вверх, вниз изменение часа" NO-UNDO.
      174   DEFINE VARIABLE l-loc-min AS INTEGER FORMAT "99":U INITIAL 0
      175        VIEW-AS FILL-IN
      176        SIZE 3 BY 1 TOOLTIP "Стрелка вверх, вниз изменение минут" NO-UNDO.
      177   DEFINE VARIABLE v-date-chk AS DATE FORMAT "99/99/9999":U
      178        LABEL "Дата чека предоплаты"
      179        VIEW-AS FILL-IN
      180        SIZE 14 BY 1 NO-UNDO.
      181   DEFINE VARIABLE v-date-cr AS DATE FORMAT "99/99/9999":U
      182        LABEL "Дата выполнения заказа"
      183        VIEW-AS FILL-IN
      184        SIZE 14 BY 1 NO-UNDO.
      185   DEFINE VARIABLE v-deliv-date AS DATE FORMAT "99/99/9999":U
      186        LABEL "Дата доставки"
      187        VIEW-AS FILL-IN
      188        SIZE 14 BY 1 NO-UNDO.
      189   DEFINE VARIABLE v-end-hour AS INTEGER FORMAT "99":U INITIAL 23
      190        VIEW-AS FILL-IN
      191        SIZE 4 BY 1 NO-UNDO.
      192   DEFINE VARIABLE v-end-min AS INTEGER FORMAT "99":U INITIAL 59
      193        LABEL ""
      194        VIEW-AS FILL-IN
      195        SIZE 4 BY 1 NO-UNDO.
      196   DEFINE VARIABLE v-face AS CHARACTER FORMAT "X(256)":U
      197        LABEL "Контактное лицо"
      198        VIEW-AS FILL-IN
      199        SIZE 38 BY 1 NO-UNDO.
      200   DEFINE VARIABLE v-komu AS CHARACTER FORMAT "X(256)":U
      201        LABEL "Кому"
      202        VIEW-AS FILL-IN
      203        SIZE 62 BY 1 NO-UNDO.
      204   DEFINE VARIABLE v-nac AS DECIMAL FORMAT "->>,>>9.9<<<<":U INITIAL 0
      205        LABEL "Наценка за работу,%"
      206        VIEW-AS FILL-IN
      207        SIZE 14.6 BY 1 NO-UNDO.
      208   DEFINE VARIABLE v-Nchk-bef AS CHARACTER FORMAT "X(256)":U
      209        LABEL "№ чека предоплаты"
      210        VIEW-AS FILL-IN
      211        SIZE 23 BY 1 NO-UNDO.
      212   DEFINE VARIABLE v-start-hour AS INTEGER FORMAT "99":U INITIAL 0
      213        LABEL "Время доставки"
      214        VIEW-AS FILL-IN
      215        SIZE 4 BY 1 NO-UNDO.
      216   DEFINE VARIABLE v-start-min AS INTEGER FORMAT "99":U INITIAL 0
      217        LABEL ""
      218        VIEW-AS FILL-IN
      219        SIZE 4 BY 1 NO-UNDO.
      220   DEFINE VARIABLE v-summa-bef AS DECIMAL FORMAT "->>>>,>>9.99":U INITIAL 0
      221        LABEL "Сумма предоплаты"
      222        VIEW-AS FILL-IN
      223        SIZE 14.6 BY 1 NO-UNDO.
      224   DEFINE VARIABLE v-summa-dos AS DECIMAL FORMAT "->>,>>9.99":U INITIAL 0
      225        LABEL "Сумма доставки,(баз.вал.)"
      226        VIEW-AS FILL-IN
      227        SIZE 14.6 BY 1 NO-UNDO.
      228   DEFINE VARIABLE v-tel AS CHARACTER FORMAT "X(256)":U
      229        LABEL "Контактный телефон"
      230        VIEW-AS FILL-IN
      231        SIZE 38 BY 1 NO-UNDO.
      232   DEFINE VARIABLE T-dost AS LOGICAL INITIAL no
      233        LABEL "Доставка"
      234        VIEW-AS TOGGLE-BOX
      235        SIZE 11.2 BY .81 NO-UNDO.
      236   DEFINE FRAME Dialog-Frame
      237        b-exit AT ROW 1 COL 1
      238        b-quit AT ROW 1 COL 11
      239        B-help AT ROW 1 COL 81
      240        v-date-cr AT ROW 3.1 COL 26.2 COLON-ALIGNED
      241        l-loc-hour AT ROW 4.19 COL 27.6 COLON-ALIGNED
      242        l-loc-min AT ROW 4.19 COL 32 COLON-ALIGNED NO-LABEL
      243        v-tel AT ROW 5.24 COL 26 COLON-ALIGNED
      244        v-face AT ROW 6.24 COL 26 COLON-ALIGNED
      245        v-deliv-date AT ROW 7.24 COL 26 COLON-ALIGNED WIDGET-ID 2
      246        v-start-hour AT ROW 8.24 COL 26 COLON-ALIGNED WIDGET-ID 4
      247        v-start-min AT ROW 8.24 COL 31.8 COLON-ALIGNED WIDGET-ID 6
      248        v-end-hour AT ROW 8.24 COL 38.6 COLON-ALIGNED NO-LABEL WIDGET-ID 8
      249        v-end-min AT ROW 8.24 COL 44.4 COLON-ALIGNED WIDGET-ID 10
      250        v-summa-bef AT ROW 9.24 COL 26 COLON-ALIGNED
      251        v-Nchk-bef AT ROW 10.24 COL 26 COLON-ALIGNED
      252        v-date-chk AT ROW 11.24 COL 26 COLON-ALIGNED
      253        T-dost AT ROW 12.24 COL 28
      254        v-summa-dos AT ROW 13.24 COL 27.2 COLON-ALIGNED
      255        v-nac AT ROW 14.24 COL 26 COLON-ALIGNED
      256        v-kuda AT ROW 15.24 COL 28 NO-LABEL
      257        v-komu AT ROW 17.52 COL 26 COLON-ALIGNED
      258        "Адрес доставки:" VIEW-AS TEXT
      259             SIZE 16.6 BY .67 AT ROW 15.43 COL 10.8
      260        "-" VIEW-AS TEXT
      261             SIZE 1 BY .62 AT ROW 8.43 COL 38.8 WIDGET-ID 12
      262        ":" VIEW-AS TEXT
      263             SIZE 1.2 BY 1 AT ROW 4.19 COL 32.8
      264             FGCOLOR 1
      265        SPACE(57.37) SKIP(15.32)
      266       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      267            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      268            TITLE "Информация о заказе".
      269   ASSIGN
      270          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      271          FRAME Dialog-Frame:HIDDEN           = TRUE.
      272   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      273   DO:
      274     APPLY "END-ERROR":U TO SELF.
      275   END.
      276   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      277   DO:
      278    RUN save-proc no-error .
      279    if error-status :error then return no-apply .
      280   END.
      281   ON CURSOR-DOWN OF l-loc-hour IN FRAME Dialog-Frame
      282   DO:
      283     assign  frame Dialog-Frame l-loc-hour .
      284     l-loc-hour = l-loc-hour -  1.
      285     if l-loc-hour < 0 then return no-apply.
      286     display l-loc-hour with frame Dialog-Frame.
      287   END.
      288   ON CURSOR-UP OF l-loc-hour IN FRAME Dialog-Frame
      289   DO:
      290     assign  frame Dialog-Frame l-loc-hour .
      291     l-loc-hour = l-loc-hour +  1.
      292     if l-loc-hour > 24 then return no-apply.
      293     display l-loc-hour with frame Dialog-Frame.
      294   END.
      295   ON LEAVE OF l-loc-hour IN FRAME Dialog-Frame
      296   DO:
      297       assign frame Dialog-Frame l-loc-hour .
      298      if l-loc-hour > 24 then do:
      299      message "Часы должны быть   до 24 ! " .
      300      return no-apply.
      301      end.
      302       if l-loc-hour < 0 then do:
      303      message "Часы должны быть  от 0 до 24 ! " .
      304      return no-apply.
      305      end.
      306   END.
      307   ON return OF l-loc-hour IN FRAME Dialog-Frame
      308   DO:
      309       run next-focus in this-procedure  (input  l-loc-hour:handle ) .
      310     return no-apply .
      311   END.
      312   ON CURSOR-DOWN OF l-loc-min IN FRAME Dialog-Frame
      313   DO:
      314     assign  frame Dialog-Frame l-loc-min .
      315     l-loc-min = l-loc-min -  1.
      316     if l-loc-min < 0 then return no-apply.
      317     display l-loc-min with frame Dialog-Frame.
      318   END.
      319   ON CURSOR-UP OF l-loc-min IN FRAME Dialog-Frame
      320   DO:
      321      assign  frame Dialog-Frame l-loc-min .
      322     l-loc-min = l-loc-min +  1.
      323     if l-loc-min > 59 then return no-apply.
      324     display l-loc-min with frame Dialog-Frame.
      325   END.
      326   ON LEAVE OF l-loc-min IN FRAME Dialog-Frame
      327   DO:
      328      assign frame Dialog-Frame l-loc-min .
      329      if l-loc-min > 59 then do:
      330      message "Минуты должны быть  от 0 до 59 ! " .
      331      return no-apply.
      332      end.
      333   END.
      334   ON return OF l-loc-min IN FRAME Dialog-Frame
      335   DO:
      336       run next-focus in this-procedure  (input  l-loc-min:handle ) .
      337     return no-apply .
      338   END.
      339   ON return OF T-dost IN FRAME Dialog-Frame
      340   DO:
      341       run next-focus in this-procedure  (input  T-dost:handle ) .
      342     return no-apply .
      343   END.
      344   ON return OF v-date-chk IN FRAME Dialog-Frame
      345   DO:
      346       run next-focus in this-procedure  (input  v-date-chk:handle ) .
      347     return no-apply .
      348   END.
      349   ON return OF v-date-cr IN FRAME Dialog-Frame
      350   DO:
      351     run next-focus in this-procedure  (input  v-date-cr:handle ) .
      352     return no-apply .
      353   END.
      354   ON LEAVE OF v-end-hour IN FRAME Dialog-Frame
      355   DO:
      356     assign frame Dialog-Frame
      357     v-start-hour
      358     v-start-min
      359     v-end-hour
      360     v-end-min
      361     .
      362     if v-start-min + (v-start-hour * 60) > v-end-min + (v-end-hour * 60) then do:
      363        message "Конечное время периода доставки не может быть меньше начального" view-as alert-box.
      364        v-end-min:screen-value = v-start-min:screen-value.
      365        v-end-min = v-start-min.
      366        v-end-hour:screen-value = v-start-hour:screen-value.
      367        v-end-hour = v-start-hour.
      368     end.
      369   END.
      370   ON VALUE-CHANGED OF v-end-hour IN FRAME Dialog-Frame
      371   DO:
      372     assign v-end-hour.
      373     if v-end-hour > 23 then do:
      374       v-end-hour = 23.
      375       v-end-hour:screen-value = "23".
      376     end.
      377   END.
      378   ON LEAVE OF v-end-min IN FRAME Dialog-Frame
      379   DO:
      380     assign frame Dialog-Frame
      381     v-start-hour
      382     v-start-min
      383     v-end-hour
      384     v-end-min
      385     .
      386     if v-start-min + (v-start-hour * 60) > v-end-min + (v-end-hour * 60) then do:
      387        message "Конечное время периода доставки не может быть меньше начального" view-as alert-box.
      388        v-end-min:screen-value = v-start-min:screen-value.
      389        v-end-min = v-start-min.
      390        v-end-hour:screen-value = v-start-hour:screen-value.
      391        v-end-hour = v-start-hour.
      392     end.
      393   END.
      394   ON VALUE-CHANGED OF v-end-min IN FRAME Dialog-Frame
      395   DO:
      396     assign v-end-min.
      397     if v-end-min > 59 then do:
      398       v-end-min = 59.
      399       v-end-min:screen-value = "59".
      400     end.
      401   END.
      402   ON return OF v-face IN FRAME Dialog-Frame
      403   DO:
      404       run next-focus in this-procedure  (input  v-face:handle ) .
      405     return no-apply .
      406   END.
      407   ON return OF v-komu IN FRAME Dialog-Frame
      408   DO:
      409       run next-focus in this-procedure  (input  v-komu:handle ) .
      410     return no-apply .
      411   END.
      412   ON return OF v-kuda IN FRAME Dialog-Frame
      413   DO:
      414       run next-focus in this-procedure  (input  v-kuda:handle ) .
      415     return no-apply .
      416   END.
      417   ON return OF v-nac IN FRAME Dialog-Frame
      418   DO:
      419       run next-focus in this-procedure  (input  v-nac:handle ) .
      420     return no-apply .
      421   END.
      422   ON return OF v-Nchk-bef IN FRAME Dialog-Frame
      423   DO:
      424       run next-focus in this-procedure  (input  v-Nchk-bef:handle ) .
      425     return no-apply .
      426   END.
      427   ON LEAVE OF v-start-hour IN FRAME Dialog-Frame
      428   DO:
      429     assign frame Dialog-Frame
      430     v-start-hour
      431     v-start-min
      432     v-end-hour
      433     v-end-min
      434     .
      435   END.
      436   ON VALUE-CHANGED OF v-start-hour IN FRAME Dialog-Frame
      437   DO:
      438     assign v-start-hour.
      439     if v-start-hour > 23 then do:
      440       v-start-hour = 23.
      441       v-start-hour:screen-value = "23".
      442     end.
      443   END.
      444   ON LEAVE OF v-start-min IN FRAME Dialog-Frame
      445   DO:
      446     assign frame Dialog-Frame
      447     v-start-hour
      448     v-start-min
      449     v-end-hour
      450     v-end-min
      451     .
      452   END.
      453   ON VALUE-CHANGED OF v-start-min IN FRAME Dialog-Frame
      454   DO:
      455     assign v-start-min.
      456     if v-start-min > 59 then do:
      457       v-start-min = 59.
      458       v-start-min:screen-value = "59".
      459     end.
      460   END.
      461   ON return OF v-summa-bef IN FRAME Dialog-Frame
      462   DO:
      463       run next-focus in this-procedure  (input  v-summa-bef:handle ) .
      464     return no-apply .
      465   END.
      466   ON return OF v-summa-dos IN FRAME Dialog-Frame
      467   DO:
      468       run next-focus in this-procedure  (input  v-summa-dos:handle ) .
      469     return no-apply .
      470   END.
      471   ON return OF v-tel IN FRAME Dialog-Frame
      472   DO:
      473       run next-focus in this-procedure  (input  v-tel:handle ) .
      474     return no-apply .
      475   END.
      476   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      477   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      478   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   on help of frame Dialog-Frame
      480   do:
      481     run gbl/app_help.p
      482       (input this-procedure :file-name
      483       ,input ''
      484       ,input ?
      485       ) no-error.
      486     if error-status :error then do:
      487       message
      488         "Ошибка при вызове помощи"
      489         error-status :get-message(1)
      490         view-as alert-box .
      491     end.
      492   end.
      493   run minbtn-set in this-procedure .
      494   on choose of b-help in frame Dialog-Frame
      495   do:
      496     apply "help":u to frame Dialog-Frame .
      497   end.
      498   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      499   procedure minbtn-set :
      500       do
      501           on error undo, return error return-value
      502           :
      503           define variable ii              as integer       no-undo .
      504           define variable fh              as widget-handle no-undo .
      505           define variable hh              as widget-handle no-undo .
      506           define variable v-h             as handle        extent 4 no-undo .
      507           define variable v-name-button   as character     no-undo .
      508           define variable v-help-old-x    as decimal       no-undo .
      509           define variable v-help-old-y    as decimal       no-undo .
      510           define variable v-help-old-size as decimal       no-undo .
      511           define variable v-frame-width   as decimal       no-undo .
      512           define variable jj              as integer       no-undo .
      513           do
      514               on error undo, return error
      515               :
      516               assign
      517                   v-frame-width = frame Dialog-Frame:width - 0.3
      518                   fh            = frame Dialog-Frame:first-child
      519                   hh            = fh:first-child
      520                   ii            = 1
      521                   .
      522               do while valid-handle(hh):
      523                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      524                   do:
      525                       case lc(hh:name) :
      526                           when "b-help" then
      527                               do:
      528                                   hh:load-image-up("cmp/b-help.bmp":u) .
      529                                   hh:load-image-down("cmp/b-help.bmp":u) .
      530                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      531                                   hh:TOOLTIP = "Помощь" .
      532                                   v-help-old-x = hh:column .
      533                                   v-help-old-y = hh:row    .
      534                                   v-help-old-size = hh:width .
      535                                   hh:width-chars = 2.5 .
      536                               end.
      537                           when "b-print" then
      538                               do:
      539                                   hh:load-image("cmp/b-print.bmp":u) .
      540                                   hh:TOOLTIP = "Печать" .
      541                                   v-h[ii] = hh:handle .
      542                                   ii = ii + 1 .
      543                                   hh:width-chars = 3 .
      544                               end.
      545                           when "b-history" or
      546                           when "b-hist" then
      547                               do:
      548                                   hh:load-image("cmp/b-hist.bmp":u) .
      549                                   hh:TOOLTIP = "История" .
      550                                   v-h[ii] = hh:handle .
      551                                   ii = ii + 1 .
      552                                   hh:width-chars = 3 .
      553                               end.
      554                           when "b-sch" then
      555                               do:
      556                                   hh:load-image("cmp/b-sch.bmp":u) .
      557                                   hh:TOOLTIP = "Установка Фильтра" .
      558                                   v-h[ii] = hh:handle .
      559                                   ii = ii + 1 .
      560                                   hh:width-chars = 3 .
      561                               end.
      562                           when "b-hist-user" then
      563                               do:
      564                                   hh:load-image("cmp/b-hist.bmp":u) .
      565                                   hh:TOOLTIP = "История пользователя" .
      566                                   ii = ii + 1 .
      567                               end.
      568                       end case.
      569                   end.
      570                   hh = hh:next-sibling.
      571               end.
      572               b-help:column = v-frame-width - b-help:width-chars.
      573               jj = 0.
      574               repeat ii = 4 to 1 by -1 :
      575                   if valid-handle (v-h[ii] ) then
      576                   do:
      577                       jj  = jj + 1 .
      578                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      579                       v-h[ii]:row    = v-help-old-y .
      580                   end.
      581               end.
      582           end.
      583       end.
      584   end procedure.
      585   MAIN-BLOCK:
      586   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      587      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK :
      588      define buffer buf_trn-doc for ub.trn-doc  .
      589      find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code no-error .
      590      if not available buf_trn-doc then do:
      591        return error return-value .
      592      end.
      593     RUN init_proc.
      594     if p-mode = 'ПРОСМОТР':U then do:
      595        RUN sel_UI.
      596        WAIT-FOR GO OF FRAME Dialog-Frame .
      597     end.
      598     else do:
      599         if buf_trn-doc.status_ = 'запрос':U and buf_trn-doc.flag_ = false  then do:
      600           RUN enable_UI.
      601           WAIT-FOR GO OF FRAME Dialog-Frame focus v-date-cr.
      602         end.
      603         else do:
      604             if buf_trn-doc.status_ = 'накл':U and buf_trn-doc.flag_ = false  then do:
      605               RUN nakl_UI.
      606               WAIT-FOR GO OF FRAME Dialog-Frame focus v-date-cr.
      607             end.
      608             else do:
      609               RUN sel_UI.
      610               WAIT-FOR GO OF FRAME Dialog-Frame .
      611             end.
      612         end.
      613     end.
      614   END.
      615   RUN disable_UI.
      616   PROCEDURE disable_UI :
      617     HIDE FRAME Dialog-Frame.
      618   END PROCEDURE.
      619   PROCEDURE enable_UI :
      620     DISPLAY v-date-cr l-loc-hour l-loc-min v-tel v-face v-deliv-date v-start-hour
      621             v-start-min v-end-hour v-end-min v-summa-bef v-Nchk-bef v-date-chk
      622             T-dost v-summa-dos v-nac v-kuda v-komu
      623         WITH FRAME Dialog-Frame.
      624     ENABLE b-exit b-quit B-help v-date-cr l-loc-hour l-loc-min v-tel v-face
      625            v-deliv-date v-start-hour v-start-min v-end-hour v-end-min v-summa-bef
      626            v-Nchk-bef v-date-chk T-dost v-summa-dos v-nac v-kuda v-komu
      627         WITH FRAME Dialog-Frame.
      628     VIEW FRAME Dialog-Frame.
      629   END PROCEDURE.
      630   PROCEDURE init_proc :
      631   define variable p-type   as character no-undo .
      632   define variable p-value  as character no-undo .
      633   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      634                           input '0rsrv-date':U ,
      635                          output p-value ,
      636                          output p-type )  .
      637       v-date-cr = DATE( p-value ) .
      638   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      639                           input '1ord_time':U ,
      640                          output p-value ,
      641                          output p-type )  .
      642       if num-entries(p-value, ":") > 1 then l-loc-hour  = INT(ENTRY ( 1 , p-value , ":" )) no-error .
      643       if num-entries(p-value, ":") > 1 then  l-loc-min   = INT(ENTRY ( 2 , p-value , ":" )) no-error .
      644   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      645                           input '2befpay':U ,
      646                          output p-value ,
      647                          output p-type )  .
      648       v-summa-bef =  DECIMAL(p-value).
      649   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      650                           input '3ord_Nchek':U ,
      651                          output p-value ,
      652                          output p-type )  .
      653       v-Nchk-bef  = p-value.
      654   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      655                           input '5deliv':U ,
      656                          output p-value ,
      657                          output p-type )  .
      658       v-summa-dos = DECIMAL(p-value) .
      659   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      660                           input '6sumwrk':U ,
      661                          output p-value ,
      662                          output p-type )  .
      663       v-nac       = DECIMAL(p-value) .
      664   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      665                           input '22ord_contact':U ,
      666                          output p-value ,
      667                          output p-type )  .
      668       v-face      =  p-value      .
      669   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      670                           input '21ord_phone':U ,
      671                          output p-value ,
      672                          output p-type )  .
      673       v-tel       =  p-value      .
      674   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      675                           input '4ord_dl':U ,
      676                          output p-value ,
      677                          output p-type )  .
      678       T-dost      =  if p-value = "yes" then true else false  .
      679   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      680                           input '4dchek':U ,
      681                          output p-value ,
      682                          output p-type )  .
      683       v-date-chk  = DATE(p-value)  .
      684   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      685                           input '8ord_adr':U ,
      686                          output p-value ,
      687                          output p-type )  .
      688       v-kuda      =     p-value   .
      689   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      690                           input '9ord_hwo':U ,
      691                          output p-value ,
      692                          output p-type )  .
      693       v-komu      =     p-value   .
      694   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      695                           input 'delivery-date':U ,
      696                          output p-value ,
      697                          output p-type )  .
      698       v-deliv-date      =     date(p-value)   .
      699   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      700                           input 'delivery-time':U ,
      701                          output p-value ,
      702                          output p-type )  .
      703    if num-entries(p-value, ":") > 1 then
      704       do:
      705           v-start-hour      =     int(replace(entry(1, entry(1, p-value, "-"), ":")," ",""))   .
      706           v-start-min       =     int(replace(entry(2, entry(1, p-value, "-"), ":")," ",""))   .
      707           v-end-hour        =     int(replace(entry(1, entry(2, p-value, "-"), ":")," ",""))  .
      708           v-end-min         =     int(replace(entry(2, entry(2, p-value, "-"), ":")," ",""))   .
      709       end.
      710   END PROCEDURE.
      711   PROCEDURE nakl_UI :
      712     DISPLAY v-date-cr l-loc-hour l-loc-min v-tel v-face v-summa-bef v-Nchk-bef
      713             v-date-chk T-dost v-summa-dos v-nac v-kuda v-komu
      714         WITH FRAME Dialog-Frame.
      715     ENABLE b-exit b-quit B-help v-date-cr l-loc-hour l-loc-min v-tel v-face
      716            v-nac v-kuda
      717            v-komu
      718         WITH FRAME Dialog-Frame.
      719     VIEW FRAME Dialog-Frame.
      720   END PROCEDURE.
      721   PROCEDURE next-focus :
      722     define input parameter p-widget-handle as handle no-undo .
      723     do with frame Dialog-Frame :
      724       if  v-date-cr   :handle = p-widget-handle then do:  if l-loc-hour    :sensitive then do: apply "entry":u to l-loc-hour . return . end. end.
      725       if  l-loc-hour  :handle = p-widget-handle then do:  if l-loc-min     :sensitive then do: apply "entry":u to l-loc-min  . return . end. end.
      726       if  l-loc-min   :handle = p-widget-handle then do:  if v-tel         :sensitive then do: apply "entry":u to v-tel      . return . end. end.
      727       if  v-tel       :handle = p-widget-handle then do:  if v-face        :sensitive then do: apply "entry":u to v-face     . return . end. end.
      728       if  v-face      :handle = p-widget-handle then do:  if v-deliv-date   :sensitive then do: apply "entry":u to v-deliv-date. return . end.
      729                                                                                       else do: apply "entry":u to v-nac      . return . end.
      730                                                                                       end.
      731   if  v-deliv-date :handle = p-widget-handle then do:  if v-start-hour        :sensitive then do: apply "entry":u to v-start-hour     . return . end. end.
      732   if  v-start-hour :handle = p-widget-handle then do:  if v-start-min        :sensitive then do: apply "entry":u to v-start-min     . return . end. end.
      733   if  v-start-min :handle = p-widget-handle then do:  if v-end-hour        :sensitive then do: apply "entry":u to v-end-hour     . return . end. end.
      734   if  v-end-hour :handle = p-widget-handle then do:  if v-end-min        :sensitive then do: apply "entry":u to v-end-min     . return . end. end.
      735   if  v-end-min :handle = p-widget-handle then do:  if v-summa-bef        :sensitive then do: apply "entry":u to v-summa-bef     . return . end. end.
      736       if  v-summa-bef :handle = p-widget-handle then do:  if v-Nchk-bef    :sensitive then do: apply "entry":u to v-Nchk-bef . return . end. end.
      737       if  v-Nchk-bef  :handle = p-widget-handle then do:  if v-date-chk    :sensitive then do: apply "entry":u to v-date-chk . return . end. end.
      738       if  v-date-chk  :handle = p-widget-handle then do:  if T-dost        :sensitive then do: apply "entry":u to T-dost     . return . end. end.
      739       if  T-dost      :handle = p-widget-handle then do:  if v-summa-dos   :sensitive then do: apply "entry":u to v-summa-dos. return . end. end.
      740       if  v-summa-dos :handle = p-widget-handle then do:  if v-nac         :sensitive then do: apply "entry":u to v-nac      . return . end. end.
      741       if  v-nac       :handle = p-widget-handle then do:  if v-kuda        :sensitive then do: apply "entry":u to v-kuda     . return . end. end.
      742       if  v-kuda      :handle = p-widget-handle then do:  if v-komu        :sensitive then do: apply "entry":u to v-komu     . return . end. end.
      743       if  v-komu      :handle = p-widget-handle then do:  if b-exit        :sensitive then do: apply "entry":u to b-exit     . return . end. end.
      744     end.
      745   END PROCEDURE.
      746   PROCEDURE save-proc :
      747   define variable p-value  as character no-undo .
      748   assign frame Dialog-Frame
      749     v-date-cr
      750     l-loc-hour
      751     l-loc-min
      752     v-tel
      753     v-face
      754     v-summa-bef
      755     v-Nchk-bef
      756     v-date-chk
      757     T-dost
      758     v-summa-dos
      759     v-nac
      760     v-kuda
      761     v-komu
      762     v-deliv-date
      763     v-start-hour
      764     v-start-min
      765     v-end-hour
      766     v-end-min
      767   .
      768       p-value = string( v-date-cr, "99/99/9999" ) .
      769   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
      770                          input '0rsrv-date':U ,
      771                          input p-value )  .
      772   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-oth in g#trdcalib ( input p-doc-code ,
      773                          input '0rsrv-date':U ,
      774                          input p-value )  .
      775       p-value = string(l-loc-hour, "99") + ":" + string(l-loc-min ,"99") .
      776   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
      777                          input '1ord_time':U ,
      778                          input p-value )  .
      779       p-value = string(v-summa-bef) .
      780   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
      781                          input '2befpay':U ,
      782                          input p-value )  .
      783       p-value = v-Nchk-bef.
      784   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
      785                          input '3ord_Nchek':U ,
      786                          input p-value )  .
