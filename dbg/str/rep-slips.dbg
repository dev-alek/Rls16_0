     3291                                   and chk-slip-head.is-report = 1
     3292                                   and chk-slip-head.kind = v-kind
     3293                                   and chk-slip-head.CashShiftDate = dateShift
     3294                                   and chk-slip-head.src_ = v-src
     3295                                   and chk-slip-head.cash-num = v-cash-num
     3296                                   .
     3297                           end.
     3298                           else
     3299                           do:
     3300                               open query br-chk-slip-head
     3301                                   for each chk-slip-head no-lock where chk-slip-head.obj-code = v-cntxt-obj-code
     3302                                   and chk-slip-head.is-report = 1
     3303                                   and chk-slip-head.kind = v-kind
     3304                                   and chk-slip-head.CashShiftDate = dateShift
     3305                                   and chk-slip-head.CashShiftNum = numShift
     3306                                   and chk-slip-head.src_ = v-src
     3307                                   and chk-slip-head.cash-num = v-cash-num
     3308                                   .
     3309                           end.
     3310                       end.
     3311                   end .
     3312               end .
     3313           end .
     3314       end.
     3315   end procedure .
     3316   procedure print-rep :
     3317     define buffer chk-slip-string for ub.chk-slip-string .
     3318     define variable v-file-name as character no-undo.
     3319     define variable vok as logical no-undo.
     3320     define variable ii as integer no-undo .
     3321     define variable v-slip-txt as character no-undo .
     3322     define variable v-slip-txt-list as character no-undo .
     3323     define variable cmd as character no-undo .
     3324     SYSTEM-DIALOG GET-FILE v-file-name
     3325         TITLE "Сохранить как"
     3326         FILTERS
     3327           " Файл PDF(*.pdf) " "*.pdf",
     3328           " Все файлы (*.*) " "*.*"
     3329         ask-overwrite
     3330         save-as
     3331         use-filename
     3332         update vok
     3333         default-extension "pdf"
     3334         .
     3335     if not vok THEN do:
     3336       return .
     3337     end.
     3338     v-slip-txt-list = "" .
     3339     get first br-chk-slip-head .
     3340     v-slip-txt = "slip_" + string(time) .
     3341     output stream out-slip to value(v-slip-txt)  .
     3342     repeat while available chk-slip-head:
     3343         for each chk-slip-string no-lock where chk-slip-string.db-num = chk-slip-head.db-num
     3344                                            and chk-slip-string.ID = chk-slip-head.ID
     3345                                            and chk-slip-string.CheckID = chk-slip-head.CheckId
     3346                                            and chk-slip-string.RRN = chk-slip-head.RRN
     3347                                            and chk-slip-string.str-num < 10000
     3348                                            by chk-slip-string.str-num
     3349                                            :
     3350           put stream out-slip unformatted chk-slip-string.str-value skip .
     3351         end .
     3352       get next br-chk-slip-head .
     3353     end .
     3354     output stream out-slip close .
     3355     define variable v-extprog-retval as character no-undo .
     3356         run gbl/extprog.p
     3357           (input  'exec':U
     3358           ,input  'txt2pdf':U
     3359           ,input  v-slip-txt
     3360           ,input  v-file-name
     3361           ,input  ""
     3362           ,output v-extprog-retval
     3363           ) .
     3364       do ii = 1 to num-entries(v-slip-txt-list) :
     3365           v-slip-txt = entry(ii, v-slip-txt-list) .
     3366           os-delete value(v-slip-txt) no-error .
     3367       end .
     3368   end procedure .
     3369   PROCEDURE disable_UI :
     3370       HIDE FRAME Dialog-Frame.
     3371   END PROCEDURE.
     3372   PROCEDURE enable_UI :
     3373       DISPLAY v-cash-num v-src v-kind numShift v-date dateShift
     3374           WITH FRAME Dialog-Frame.
     3375       ENABLE b-exit b-print1 v-cash-num b-cd v-src v-kind numShift v-date
     3376           b-choose-date dateShift b-choose-shift br-chk-slip-head
     3377           WITH FRAME Dialog-Frame.
     3378       VIEW FRAME Dialog-Frame.
     3379   END PROCEDURE.
