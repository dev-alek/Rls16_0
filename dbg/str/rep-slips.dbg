      123     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
      124     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
      125     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
      126     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
      127     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
      128     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
      129     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
      130     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
      131     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
      132     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
      133     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
      134     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
      135     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
      136     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
      137     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
      138     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
      139     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
      140     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
      141     define variable v-cntxp-conf-par        as   character                no-undo.
      142     define variable v-cntxp-par-type        as   character                no-undo.
      143     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
      144     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
      145     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
      146     define variable v-cntxp-db-num          as integer   no-undo .
      147     define variable v-cntxp-userid          as character no-undo .
      148     define variable v-cntxp-level           as character no-undo .
      149     define variable v-cntxp-db-num-obj      as integer   no-undo .
      150     define variable v-cntxp-is-admin        as logical   no-undo .
      151     define buffer bf-cntxp_store for ub.store.
      152     define buffer bf-cntxp_shop  for ub.shop.
      153     define buffer bf-cntxp_sysconf for ub.sysconf.
      154   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155     define variable v-cntxt-db-num        as integer   no-undo .
      156     define variable v-cntxt-userid        as character no-undo .
      157     define variable v-cntxt-level         as character no-undo .
      158     define variable v-cntxt-host-code-obj as integer   no-undo .
      159     define variable v-cntxt-obj-type      as character no-undo .
      160     define variable v-cntxt-obj-code      as integer   no-undo .
      161     define variable v-cntxt-db-num-obj    as integer   no-undo .
      162     define variable v-cntxt-is-admin      as logical   no-undo .
      163   define variable print-type as character no-undo.
      164   define buffer chk-slip-head for ub.chk-slip-head .
      165   define buffer buf_cash-desk for ub.cash-desk.
      166   define stream out-slip .
      167   function func-src returns character
      168       (input v-int-type as integer):
      169       case v-int-type :
      170           when 1 then
      171               return "ФН ККТ" .
      172           when 2 then
      173               return "ТУ" .
      174           when 3 then
      175               return "Касса" .
      176           when 4 then
      177               return "АСУ Заправщик" .
      178           otherwise
      179           return " - " .
      180       end case .
      181   end function .
      182   function func-kind returns character
      183       (input v-int-type as integer):
      184       case v-int-type :
      185           when 1 then
      186               return "Z-отчет" .
      187           when 2 then
      188               return "Отчет ТУ" .
      189           when 3 then
      190               return "Кассовый отчет о незавершенных возвратах" .
      191           when 4 then
      192               return "Финансовый отчет" .
      193           when 5 then
      194               return "Отчет по топливу и платежам" .
      195           when 6 then
      196               return "Отчет по услугам" .
      197           when 7 then
      198               return "Отчет по аннуляциям" .
      199           when 8 then
      200               return "Отчет по сбросам и переливам" .
      201           when 9 then
      202               return "Отчет по товарам" .
      203           when 10 then
      204               return "Сменный отчет АСУ Заправщик" .
      205           otherwise
      206           return " - " .
      207       end case .
      208   end function .
      209   DEFINE BUTTON b-cd
      210       IMAGE-UP FILE "btn-down-arrow":U
      211       IMAGE-DOWN FILE "btn-down-arrow":U
      212       IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      213       LABEL "Btn 1"
      214       SIZE 3 BY 1.
      215   DEFINE BUTTON b-choose-date
      216       IMAGE-UP FILE "btn-down-arrow":U
      217       IMAGE-DOWN FILE "btn-down-arrow":U
      218       IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      219       LABEL "b-choose-date"
      220       SIZE 3 BY .88.
      221   DEFINE BUTTON b-choose-shift
      222       IMAGE-UP FILE "btn-down-arrow":U
      223       IMAGE-DOWN FILE "btn-down-arrow":U
      224       IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      225       LABEL "b-choose-date"
      226       SIZE 3 BY .88.
      227   DEFINE BUTTON b-exit AUTO-END-KEY
      228       LABEL "Выход"
      229       SIZE 15 BY 1.13
      230       BGCOLOR 8 .
      231   DEFINE BUTTON b-print1
      232       LABEL "Сохранить в файл"
      233       SIZE 17 BY 1.13
      234       BGCOLOR 8 .
      235   DEFINE VARIABLE v-kind     AS INTEGER FORMAT ">>9":U INITIAL 0
      236       LABEL "Тип"
      237       VIEW-AS COMBO-BOX INNER-LINES 6
      238       LIST-ITEM-PAIRS "Все",0,
      239       "Z-отчет",1,
      240       "Отчет ТУ",2,
      241       "Кассовый отчет о незавершенных возвратах",3,
      242       "Финансовый отчет",4,
      243       "Отчет по топливу и платежам",5,
      244       "Отчет по услугам",6,
      245       "Отчет по аннуляциям",7,
      246       "Отчет по сбросам и переливам",8,
      247       "Отчет по товарам",9,
      248       "Сменный отчет АСУ Заправщик",10
      249       DROP-DOWN-LIST
      250       SIZE 50 BY 1 NO-UNDO.
      251   DEFINE VARIABLE v-src      AS INTEGER FORMAT "->>9":U INITIAL 0
      252       LABEL "Источник"
      253       VIEW-AS COMBO-BOX INNER-LINES 4
      254       LIST-ITEM-PAIRS "Все",0,
      255       "ФН ККТ",1,
      256       "ТУ",2,
      257       "Касса",3,
      258       "АСУ Заправщик",4
      259       DROP-DOWN-LIST
      260       SIZE 50 BY 1 NO-UNDO.
      261   DEFINE VARIABLE dateShift  AS DATE    FORMAT "99/99/9999":U
      262       LABEL "Смена"
      263       VIEW-AS FILL-IN
      264       SIZE 12 BY 1 NO-UNDO.
      265   DEFINE VARIABLE numShift   AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      266       LABEL "№"
      267       VIEW-AS FILL-IN
      268       SIZE 3.5 BY 1 NO-UNDO.
      269   DEFINE VARIABLE v-cash-num AS INTEGER FORMAT ">>>9":U INITIAL 0
      270       LABEL "Касса"
      271       VIEW-AS FILL-IN
      272       SIZE 7 BY 1 NO-UNDO.
      273   DEFINE VARIABLE v-date     AS DATE    FORMAT "99/99/9999":U INITIAL today
      274       LABEL "Сформирован"
      275       VIEW-AS FILL-IN
      276       SIZE 12 BY 1 NO-UNDO.
      277   DEFINE MENU MENU-b-print1
      278       MENU-ITEM m_one         LABEL "Текущий"
      279       MENU-ITEM m_all         LABEL "Все"  .
      280   DEFINE BUTTON b-help
      281       LABEL "Помощь":L
      282       SIZE 7 BY 1.
      283   define query br-chk-slip-head for chk-slip-head scrolling .
      284   define browse br-chk-slip-head
      285       query br-chk-slip-head display
      286       chk-slip-head.CashShiftDate format "99/99/9999" COLUMN-LABEL "Дата смены" width 10
      287       chk-slip-head.CashShiftNum COLUMN-LABEL "№ смены" width 10
      288       chk-slip-head.slip-dt format "99/99/9999 HH:MM:SS" COLUMN-LABEL "Сформирован" width 20
      289       chk-slip-head.cash-num COLUMN-LABEL "Касса" width 10
      290       func-src(chk-slip-head.src_) COLUMN-LABEL "Источник" width 15 format "X(100)"
      291       func-kind(chk-slip-head.kind) COLUMN-LABEL "Тип" width 35 format "X(100)"
      292       chk-slip-head.ID COLUMN-LABEL "ID" format "X(100)"
      293   WITH SEPARATORS SIZE 121.5 BY 12 .
      294   DEFINE FRAME Dialog-Frame
      295       b-exit AT ROW 1.08 COL 2
      296       b-print1 AT ROW 1.08 COL 18.75 WIDGET-ID 2
      297       v-cash-num AT ROW 1.08 COL 48.5 COLON-ALIGNED WIDGET-ID 6
      298       b-cd AT ROW 1.08 COL 57.75 WIDGET-ID 14
      299       v-src AT ROW 1.08 COL 71.9 COLON-ALIGNED WIDGET-ID 8
      300       v-kind AT ROW 2.21 COL 71.9 COLON-ALIGNED WIDGET-ID 12
      301       b-help AT ROW 1 COL 92.5
      302       numShift AT ROW 2.25 COL 27.63 COLON-ALIGNED WIDGET-ID 22
      303       v-date AT ROW 2.25 COL 48.5 COLON-ALIGNED WIDGET-ID 4
      304       b-choose-date AT ROW 2.25 COL 62.63 WIDGET-ID 16
      305       dateShift AT ROW 2.29 COL 7.5 COLON-ALIGNED WIDGET-ID 20
      306       b-choose-shift AT ROW 2.29 COL 22.63 WIDGET-ID 18
      307       br-chk-slip-head AT ROW 3.46 COL 2
      308       SPACE(0.75) SKIP(0.41)
      309       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      310       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      311       TITLE "Отчеты кассового оборудования, ККТ, ТУ"
      312       CANCEL-BUTTON b-exit WIDGET-ID 100.
      313   ASSIGN
      314       FRAME Dialog-Frame:SCROLLABLE = FALSE
      315       FRAME Dialog-Frame:HIDDEN     = TRUE.
      316   ASSIGN
      317       br-chk-slip-head:COLUMN-RESIZABLE IN FRAME Dialog-Frame = TRUE.
      318   ASSIGN
      319       b-print1:POPUP-MENU IN FRAME Dialog-Frame = MENU MENU-b-print1:HANDLE.
      320   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      321       DO:
      322           APPLY "END-ERROR":U TO SELF.
      323       END.
      324   ON CHOOSE OF b-cd IN FRAME Dialog-Frame
      325       DO:
      326           define variable ri-list as character no-undo .
      327           run ref/cashlist.w
      328               (input  parparentproc
      329               ,input  'b-sel':U
      330               ,input  'объект':U
      331               ,v-cntxt-db-num
      332               ,v-cntxt-host-code-obj
      333               ,v-cntxt-obj-type
      334               ,v-cntxt-obj-code
      335               ,input  ?
      336               ,output ri-list
      337               ) no-error.
      338           if ri-list = '' then
      339           do:
      340               return no-apply .
      341           end.
      342           FIND FIRST buf_cash-desk No-LOCK WHERE
      343               recid(buf_cash-desk) = integer(ri-list) no-error.
      344           if not available buf_cash-desk then
      345           do:
      346               return no-apply .
      347           end.
      348           v-cash-num = buf_cash-desk.cash-num .
      349           display v-cash-num WITH FRAME Dialog-Frame.
      350           run reopen-query .
      351       END.
      352   ON value-changed OF v-cash-num IN FRAME Dialog-Frame
      353       DO:
      354           assign v-cash-num .
      355           if v-cash-num > 0
      356               then
      357           do :
      358               FIND FIRST buf_cash-desk No-LOCK where buf_cash-desk.db-num = v-cntxt-db-num
      359                   and buf_cash-desk.obj-code = v-cntxt-obj-code
      360                   and buf_cash-desk.cash-num = v-cash-num
      361                   no-error .
      362               if not available buf_cash-desk
      363                   then
      364               do :
      365                   message "Не найдена касса с кодом " v-cash-num view-as alert-box .
      366                   return no-apply .
      367               end .
      368           end .
      369           run reopen-query .
      370       END.
      371   on del of v-cash-num in frame Dialog-Frame
      372       do :
      373           v-cash-num = ? .
      374           v-cash-num:screen-value = "?" .
      375           run reopen-query .
      376       end .
      377   on delete-character of dateShift in frame Dialog-Frame
      378       do:
      379           dateShift = ? .
      380           dateShift:screen-value = string(dateShift,"99/99/9999")  .
      381           run reopen-query .
      382       end.
      383   on del of dateShift in frame Dialog-Frame
      384       do :
      385           dateShift = ? .
      386           dateShift:screen-value = string(dateShift,"99/99/9999")  .
      387           run reopen-query .
      388       end .
      389   on ctrl-d of dateShift in frame Dialog-Frame
      390       do:
      391           define variable v-curr-sv-date as date no-undo .
      392           if (can-query (self, "sensitive")
      393               and
      394               self :sensitive = true
      395               )
      396               or (can-query (self, "read-only")
      397               and
      398               self :read-only = false
      399               )
      400               then
      401           do:
      402               if self :handle <> focus :handle
      403                   then
      404               do:
      405                   apply "entry":u to self .
      406               end.
      407               run gbl/getcurdt.p
      408                   (output v-curr-sv-date
      409                   ) .
      410               assign
      411                   self :screen-value = string(v-curr-sv-date) .
      412               .
      413           end.
      414           return no-apply.
      415       end.
      416   on del of numShift in frame Dialog-Frame
      417       do :
      418           numShift = 0 .
      419           numShift:screen-value = "0" .
      420           run reopen-query .
      421       end .
      422   ON leave OF v-date IN FRAME Dialog-Frame
      423       DO:
      424           assign v-date .
      425           run reopen-query .
      426       END.
      427   ON CHOOSE OF b-choose-date IN FRAME Dialog-Frame
      428       DO:
      429           run sel-date in this-procedure
      430               (input v-date :handle
      431               ,input ""
      432               ) .
      433           apply "leave" to v-date IN FRAME Dialog-Frame .
      434       END.
      435   ON value-changed OF v-src IN FRAME Dialog-Frame
      436       DO:
      437           define variable Kind_ as character no-undo .
      438           assign v-src .
      439           case v-src:
      440               when 0 then
      441                   do:
      442                       Kind_ = "Все" + chr(44) + '0':U + chr(44) +
      443                           "Z-отчет" + chr(44) + '1':U + chr(44) +
      444                           "Отчет ТУ" + chr(44) + '2':U + chr(44) +
      445                           "Финансовый отчет" + chr(44) + '4':U + chr(44) +
      446                           "Отчет по топливу и платежам" + chr(44) + '5':U + chr(44) +
      447                           "Отчет по услугам" + chr(44) + '6':U + chr(44) +
      448                           "Отчет по аннуляциям" + chr(44) + '7':U + chr(44) +
      449                           "Отчет по сбросам и переливам" + chr(44) + '8':U + chr(44) +
      450                           "Отчет по товароам" + chr(44) + '9':U + chr(44) +
      451                           "Сменный отчет АСУ Заправщик" + chr(44) + '10':U .
      452                   end.
      453               when 1 then
      454                   do:
      455                       Kind_ = "Z-отчет" + chr(44) + '1':U .
      456                   end.
      457               when 2 then
      458                   do:
      459                       Kind_ = "Отчет ТУ" + chr(44) + '2':U .
      460                   end.
      461               when 3 then
      462                   do:
      463                       Kind_ = "Финансовый отчет" + chr(44) + '4':U + chr(44) +
      464                           "Отчет по топливу и платежам" + chr(44) + '5':U + chr(44) +
      465                           "Отчет по услугам" + chr(44) + '6':U + chr(44) +
      466                           "Отчет по аннуляциям" + chr(44) + '7':U + chr(44) +
      467                           "Отчет по сбросам и переливам" + chr(44) + '8':U + chr(44) +
      468                           "Отчет по товароам" + chr(44) + '9':U .
      469                   end.
      470               when 4 then
      471                   do:
      472                       Kind_ = "Сменный отчет АСУ Заправщик" + chr(44) + '10':U .
      473                   end.
      474           end case .
      475           ASSIGN
      476               v-kind:LIST-ITEM-PAIRS  in frame Dialog-Frame = Kind_ .
      477           run reopen-query .
      478       END.
      479   ON value-changed OF v-kind IN FRAME Dialog-Frame
      480       DO:
      481           assign v-kind .
      482           run reopen-query .
      483       END.
      484   ON CHOOSE OF b-print1 IN FRAME Dialog-Frame
      485       DO:
      486           if not available chk-slip-head
      487               then
      488           do :
      489               return no-apply .
      490           end .
      491           if print-type = "" then
      492           do:
      493               run gbl/pop-up.p ( input b-print1:handle, input no) no-error.
      494               if error-status:error then return no-apply.
      495           end.
      496           if print-type = "" then return no-apply.
      497           if print-type = "one"
      498               then
      499           do :
      500               run str/chk-slip-print.p (input chk-slip-head.db-num,
      501                   input chk-slip-head.ID,
      502                   input chk-slip-head.CheckID,
      503                   input chk-slip-head.RRN,
      504                   input print-type)
      505                   .
      506           end .
      507           else
      508           do :
      509               run print-rep .
      510           end .
      511       END.
      512   ON RETURN OF br-chk-slip-head IN FRAME Dialog-Frame
      513       OR mouse-select-dblclick of br-chk-slip-head in frame Dialog-Frame
      514       do:
      515           if not available chk-slip-head
      516               then
      517           do :
      518               return no-apply .
      519           end .
      520           run str/chk-slip.w (input chk-slip-head.db-num,
      521               input chk-slip-head.ID,
      522               input chk-slip-head.CheckID,
      523               input chk-slip-head.RRN)
      524               .
      525       end.
      526   ON leave OF dateShift IN FRAME Dialog-Frame
      527       DO:
      528           assign dateShift .
      529           run reopen-query .
      530       END.
      531   ON CHOOSE OF MENU-ITEM m_all
      532       DO:
      533           print-type = "reports":U.
      534           apply "choose" to b-print1 in frame Dialog-Frame.
      535       END.
      536   ON CHOOSE OF MENU-ITEM m_one
      537       DO:
      538           print-type = "one":U.
      539           apply "choose" to b-print1 in frame Dialog-Frame.
      540       END.
      541   ON CHOOSE OF b-choose-shift IN FRAME Dialog-Frame
      542       DO:
      543           run sel-date in this-procedure
      544               (input dateShift :handle
      545               ,input ""
      546               ) .
      547           apply "leave" to dateShift IN FRAME Dialog-Frame .
      548       END.
      549   ON leave OF numShift IN FRAME Dialog-Frame
      550       DO:
      551           assign numShift .
      552           run reopen-query .
      553       END.
      554   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      555       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      556   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557   on help of frame Dialog-Frame
      558   do:
      559     run gbl/app_help.p
      560       (input this-procedure :file-name
      561       ,input ''
      562       ,input ?
      563       ) no-error.
      564     if error-status :error then do:
      565       message
      566         "Ошибка при вызове помощи"
      567         error-status :get-message(1)
      568         view-as alert-box .
      569     end.
      570   end.
      571   run minbtn-set in this-procedure .
      572   on choose of b-help in frame Dialog-Frame
      573   do:
      574     apply "help":u to frame Dialog-Frame .
      575   end.
      576   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   procedure minbtn-set :
      578       do
      579           on error undo, return error return-value
      580           :
      581           define variable ii              as integer       no-undo .
      582           define variable fh              as widget-handle no-undo .
      583           define variable hh              as widget-handle no-undo .
      584           define variable v-h             as handle        extent 4 no-undo .
      585           define variable v-name-button   as character     no-undo .
      586           define variable v-help-old-x    as decimal       no-undo .
      587           define variable v-help-old-y    as decimal       no-undo .
      588           define variable v-help-old-size as decimal       no-undo .
      589           define variable v-frame-width   as decimal       no-undo .
      590           define variable jj              as integer       no-undo .
      591           do
      592               on error undo, return error
      593               :
      594               assign
      595                   v-frame-width = frame Dialog-Frame:width - 0.3
      596                   fh            = frame Dialog-Frame:first-child
      597                   hh            = fh:first-child
      598                   ii            = 1
      599                   .
      600               do while valid-handle(hh):
      601                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      602                   do:
      603                       case lc(hh:name) :
      604                           when "b-help" then
      605                               do:
      606                                   hh:load-image-up("cmp/b-help.bmp":u) .
      607                                   hh:load-image-down("cmp/b-help.bmp":u) .
      608                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      609                                   hh:TOOLTIP = "Помощь" .
      610                                   v-help-old-x = hh:column .
      611                                   v-help-old-y = hh:row    .
      612                                   v-help-old-size = hh:width .
      613                                   hh:width-chars = 2.5 .
      614                               end.
      615                           when "b-print" then
      616                               do:
      617                                   hh:load-image("cmp/b-print.bmp":u) .
      618                                   hh:TOOLTIP = "Печать" .
      619                                   v-h[ii] = hh:handle .
      620                                   ii = ii + 1 .
      621                                   hh:width-chars = 3 .
      622                               end.
      623                           when "b-history" or
      624                           when "b-hist" then
      625                               do:
      626                                   hh:load-image("cmp/b-hist.bmp":u) .
      627                                   hh:TOOLTIP = "История" .
      628                                   v-h[ii] = hh:handle .
      629                                   ii = ii + 1 .
      630                                   hh:width-chars = 3 .
      631                               end.
      632                           when "b-sch" then
      633                               do:
      634                                   hh:load-image("cmp/b-sch.bmp":u) .
      635                                   hh:TOOLTIP = "Установка Фильтра" .
      636                                   v-h[ii] = hh:handle .
      637                                   ii = ii + 1 .
      638                                   hh:width-chars = 3 .
      639                               end.
      640                           when "b-hist-user" then
      641                               do:
      642                                   hh:load-image("cmp/b-hist.bmp":u) .
      643                                   hh:TOOLTIP = "История пользователя" .
      644                                   ii = ii + 1 .
      645                               end.
      646                       end case.
      647                   end.
      648                   hh = hh:next-sibling.
      649               end.
      650               b-help:column = v-frame-width - b-help:width-chars.
      651               jj = 0.
      652               repeat ii = 4 to 1 by -1 :
      653                   if valid-handle (v-h[ii] ) then
      654                   do:
      655                       jj  = jj + 1 .
      656                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      657                       v-h[ii]:row    = v-help-old-y .
      658                   end.
      659               end.
      660           end.
      661       end.
      662   end procedure.
      663   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      664   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      665   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      666   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      667   define variable v-diasize-current-frame-width  as decimal   no-undo .
      668   define variable v-diasize-current-frame-height as decimal   no-undo .
      669   define variable v-diasize-change-size          as logical   no-undo .
      670   define variable v-diasize-resize-button        as handle    no-undo .
      671   define variable v-diasize-wndmax               as logical   no-undo .
      672   define variable v-diasize-wndstore             as logical   no-undo .
      673   define variable v-diasize-proc-name            as character no-undo .
      674   define variable v-diasize-browse-handle        as handle    no-undo .
      675   define variable v-diasize-browse-number        as integer   no-undo .
      676   define variable v-diasize-need-full-display    as logical   no-undo init false .
      677   define temp-table temp-diasize-handle no-undo
      678     field handle-value  as handle
      679     field save-position as decimal
      680     index xpk is primary unique handle-value
      681     .
      682   define temp-table temp-browse-handle no-undo
      683     field browse-type   as character
      684     field browse-number as integer
      685     field browse-handle as handle
      686     field original-size as decimal
      687     index xpk is primary unique browse-type browse-number
      688     index xie browse-type browse-handle
      689   .
      690   procedure diasize_change-height :
      691     define input  parameter p-change-value  as decimal   no-undo .
      692     define input  parameter p-move-resize   as logical   no-undo .
      693     define variable v-field-group-handle    as handle    no-undo .
      694     define variable v-object-handle         as handle    no-undo .
      695     define variable v-frame-height          as decimal   no-undo .
      696     define variable v-frame-virtual-height  as decimal   no-undo .
      697     define variable v-browse-height         as decimal   no-undo .
      698     define variable v-window-height         as decimal   no-undo .
      699     define variable v-window-virtual-height as decimal   no-undo .
      700     define variable v-change-sign           as integer   no-undo .
      701     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      702     define buffer buf_temp-browse-handle  for temp-browse-handle .
      703     if p-change-value > 0
      704     then do:
      705       if frame Dialog-Frame :height + p-change-value
      706           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      707       then do:
      708         assign
      709           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      710                           - (frame Dialog-Frame :height-chars)
      711         .
      712         if p-change-value <= 0
      713         then do:
      714           run diasize_position-resize-button in this-procedure .
      715           return .
      716         end.
      717       end.
      718     end.
      719     if p-change-value < 0
      720     then do:
      721       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      722       then do:
      723         assign
      724           p-change-value = v-diasize-orig-frame-height
      725                          - (frame Dialog-Frame :height-chars)
      726         .
      727         if p-change-value >= 0
      728         then do:
      729           run diasize_position-resize-button in this-procedure .
      730           return .
      731         end.
      732       end.
      733     end.
      734     if p-change-value >= 0
      735     then do:
      736       assign
      737         v-change-sign = 1
      738       .
      739     end.
      740     else do:
      741       assign
      742         v-change-sign = -1
      743       .
      744     end.
      745     assign
      746       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      747     .
      748     if p-change-value = 0
      749     then do:
      750       run diasize_position-resize-button in this-procedure .
      751       return .
      752     end.
      753     move_block:
      754     do
      755     on error undo move_block, retry move_block
      756     :
      757       if retry
      758       then do:
      759         do
      760         on error undo move_block, leave move_block
      761         :
      762           if p-change-value > 0
      763           then do:
      764             for each buf_temp-diasize-handle
      765             on error undo, next
      766             :
      767               assign
      768                 v-object-handle = buf_temp-diasize-handle.handle-value
      769               .
      770               if v-object-handle <> v-diasize-resize-button
      771               then do:
      772                 assign
      773                   v-object-handle :row = buf_temp-diasize-handle.save-position
      774                 .
      775               end.
      776             end.
      777             assign
      778               v-diasize-browse-handle :height = v-browse-height
      779             .
      780             for each buf_temp-browse-handle
      781               where buf_temp-browse-handle.browse-type = 'height':u
      782             on error undo, next
      783             :
      784               assign
      785                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      786               .
      787             end.
      788             assign
      789               frame Dialog-Frame :height = v-frame-height
      790             .
      791             if frame Dialog-Frame :scrollable = true
      792             then do:
      793               assign
      794                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      795               .
      796             end.
      797             run diasize_position-resize-button in this-procedure .
      798           end.
      799           else do:
      800             if frame Dialog-Frame :scrollable = true
      801             then do:
      802               assign
      803                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      804               .
      805             end.
      806             assign
      807               frame Dialog-Frame :height = v-frame-height
      808             .
      809             assign
      810               v-diasize-browse-handle :height = v-browse-height
      811             .
      812             for each buf_temp-browse-handle
      813               where buf_temp-browse-handle.browse-type = 'height':u
      814             on error undo, next
      815             :
      816               assign
      817                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      818               .
      819             end.
      820             for each buf_temp-diasize-handle
      821             on error undo, next
      822             :
      823               assign
      824                 v-object-handle = buf_temp-diasize-handle.handle-value
      825               .
      826               if v-object-handle <> v-diasize-resize-button
      827               then do:
      828                 assign
      829                   v-object-handle :row = buf_temp-diasize-handle.save-position
      830                 .
      831               end.
      832             end.
      833             run diasize_position-resize-button in this-procedure .
      834           end.
      835           assign
      836             v-diasize-change-size = false
      837           .
      838           leave move_block .
      839         end.
      840       end.
      841       assign
      842         v-diasize-need-full-display = true
      843       .
      844       if v-diasize-change-size = false
      845       then do:
      846         assign
      847           v-diasize-change-size = true
      848         .
      849       end.
      850       else do:
      851         return .
      852       end.
      853       assign
      854         v-frame-height = frame Dialog-Frame :height
      855         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      856         v-browse-height = v-diasize-browse-handle :height
      857       .
      858       for each buf_temp-browse-handle
      859         where buf_temp-browse-handle.browse-type = 'height':u
      860       :
      861         assign
      862           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      863         .
      864       end.
      865       for each buf_temp-diasize-handle
      866       :
      867         delete buf_temp-diasize-handle .
      868       end.
      869       assign
      870         v-field-group-handle = frame Dialog-Frame :first-child
      871       .
      872       do while valid-handle(v-field-group-handle)
      873       :
      874         assign
      875           v-object-handle = v-field-group-handle :first-child
      876         .
      877         do while valid-handle(v-object-handle)
      878         :
      879           if  v-object-handle <> v-diasize-browse-handle :handle
      880           and can-query(v-object-handle, "row")
      881           and can-query(v-object-handle, "height")
      882           and ( v-object-handle :row > v-diasize-browse-handle :row )
      883           then do:
      884             find first buf_temp-browse-handle
      885               where buf_temp-browse-handle.browse-type   = 'height':u
      886                 and buf_temp-browse-handle.browse-handle = v-object-handle
      887               no-error .
      888             if available buf_temp-browse-handle
      889             then do:
      890             end.
      891             else do:
      892               create buf_temp-diasize-handle .
      893               assign
      894                 buf_temp-diasize-handle.handle-value  = v-object-handle
      895                 buf_temp-diasize-handle.save-position = v-object-handle :row
      896               .
      897             end.
      898           end.
      899           assign
      900             v-object-handle = v-object-handle :next-sibling
      901           .
      902         end.
      903         assign
      904           v-field-group-handle = v-field-group-handle :next-sibling
      905         .
      906       end.
      907       do with frame Dialog-Frame
      908       :
      909         hide v-diasize-resize-button .
      910         assign
      911           v-diasize-resize-button :row    = 1
      912           v-diasize-resize-button :column = 1
      913         .
      914       end.
      915       if p-change-value > 0
      916       then do:
      917         if frame Dialog-Frame :scrollable = true
      918         then do:
      919           assign
      920             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      921             no-error .
      922           if error-status :error
      923           or error-status :get-message(1) <> ""
      924           then do:
      925             undo move_block, retry move_block .
      926           end.
      927         end.
      928         assign
      929           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      930           no-error .
      931         if error-status :error
      932         or error-status :get-message(1) <> ""
      933         then do:
      934           undo move_block, retry move_block .
      935         end.
      936         assign
      937           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      938           no-error .
      939         if error-status :error
      940         or error-status :get-message(1) <> ""
      941         then do:
      942           undo move_block, retry move_block .
      943         end.
      944         for each buf_temp-browse-handle
      945           where buf_temp-browse-handle.browse-type = 'height':u
      946         on error undo move_block, retry move_block
      947         :
      948           assign
      949             buf_temp-browse-handle.browse-handle :height
      950               = buf_temp-browse-handle.browse-handle :height + p-change-value
      951             no-error .
      952           if error-status :error
      953           or error-status :get-message(1) <> ""
      954           then do:
      955             undo move_block, retry move_block .
      956           end.
      957         end.
      958         for each buf_temp-diasize-handle
      959         on error undo move_block, retry move_block
      960         :
      961           assign
      962             v-object-handle = buf_temp-diasize-handle.handle-value
      963           .
      964           if v-object-handle <> v-diasize-resize-button
      965           then do:
      966             assign
      967               v-object-handle :row = v-object-handle :row + p-change-value
      968               no-error .
      969             if error-status :error
      970             or error-status :get-message(1) <> ""
      971             then do:
      972               undo move_block, retry move_block .
      973             end.
      974           end.
      975         end.
      976       end.
      977       else do:
      978         for each buf_temp-diasize-handle
      979         on error undo move_block, retry move_block
      980         :
      981           assign
      982             v-object-handle = buf_temp-diasize-handle.handle-value
      983           .
      984           if v-object-handle <> v-diasize-resize-button
      985           then do:
      986             assign
      987               v-object-handle :row = v-object-handle :row + p-change-value
      988               no-error .
      989             if error-status :error
      990             or error-status :get-message(1) <> ""
      991             then do:
      992               undo move_block, retry move_block .
      993             end.
      994           end.
      995         end.
      996         assign
      997           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      998           no-error .
      999         if error-status :error
     1000         or error-status :get-message(1) <> ""
     1001         then do:
     1002           undo move_block, retry move_block .
     1003         end.
     1004         for each buf_temp-browse-handle
     1005           where buf_temp-browse-handle.browse-type = 'height':u
     1006         on error undo move_block, retry move_block
     1007         :
     1008           assign
     1009             buf_temp-browse-handle.browse-handle :height
     1010               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1011             no-error .
     1012           if error-status :error
     1013           or error-status :get-message(1) <> ""
     1014           then do:
     1015             undo move_block, retry move_block .
     1016           end.
     1017         end.
     1018         assign
     1019           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1020           no-error .
     1021         if error-status :error
     1022         or error-status :get-message(1) <> ""
     1023         then do:
     1024           undo move_block, retry move_block .
     1025         end.
     1026         if frame Dialog-Frame :scrollable = true
     1027         then do:
     1028           assign
     1029             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1030             no-error .
     1031           if error-status :error
     1032           or error-status :get-message(1) <> ""
     1033           then do:
     1034             undo move_block, retry move_block .
     1035           end.
     1036         end.
     1037       end.
     1038       if p-move-resize = true
     1039       then do:
     1040         run diasize_position-resize-button in this-procedure .
     1041       end.
     1042       if v-diasize-wndstore = true
     1043       then do:
     1044         if connected("ub") = true
     1045         then do:
     1046           define variable v-cntxt-db-num        as integer   no-undo .
     1047           define variable v-cntxt-userid        as character no-undo .
     1048           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1049                                             , OUTPUT v-cntxt-userid
     1050                                             ) .
     1051           run gbl/wndsizew.p
     1052             (input  v-cntxt-db-num
     1053             ,input  v-cntxt-userid
     1054             ,input  v-diasize-proc-name
     1055             ,input  'height':u
     1056             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1057             ) .
     1058         end.
     1059       end.
     1060     end.
     1061     assign
     1062       v-diasize-change-size = false
     1063     .
     1064   end procedure.
     1065   procedure diasize_set-height :
     1066     define input  parameter p-new-height  as decimal   no-undo .
     1067     define input  parameter p-move-resize as logical   no-undo .
     1068     do
     1069     on error undo, return error return-value
     1070     :
     1071       run diasize_change-height in this-procedure
     1072         (input  (p-new-height - frame Dialog-Frame :height)
     1073         ,input  p-move-resize
     1074         ) .
     1075     end.
     1076   end procedure.
     1077   procedure diasize_change-width :
     1078     define input  parameter p-change-value as decimal   no-undo .
     1079     define input  parameter p-move-resize  as logical   no-undo .
     1080     define variable v-field-group-handle   as handle    no-undo .
     1081     define variable v-object-handle        as handle    no-undo .
     1082     define variable v-frame-width          as decimal   no-undo .
     1083     define variable v-frame-virtual-width  as decimal   no-undo .
     1084     define variable v-browse-width         as decimal   no-undo .
     1085     define variable v-window-width         as decimal   no-undo .
     1086     define variable v-window-virtual-width as decimal   no-undo .
     1087     define variable v-change-sign          as integer   no-undo .
     1088     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1089     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1090     if p-change-value > 0
     1091     then do:
     1092       if frame Dialog-Frame :width + p-change-value >
     1093           session :width-chars
     1094       then do:
     1095         assign
     1096           p-change-value = session :width-chars - frame Dialog-Frame :width
     1097         .
     1098         if p-change-value <= 0
     1099         then do:
     1100           run diasize_position-resize-button in this-procedure .
     1101           return .
     1102         end.
     1103       end.
     1104     end.
     1105     if p-change-value < 0
     1106     then do:
     1107       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1108       then do:
     1109         assign
     1110           p-change-value = v-diasize-orig-frame-width
     1111                          - frame Dialog-Frame :width
     1112         .
     1113         if p-change-value >= 0
     1114         then do:
     1115           run diasize_position-resize-button in this-procedure .
     1116           return .
     1117         end.
     1118       end.
     1119     end.
     1120     if p-change-value >= 0
     1121     then do:
     1122       assign
     1123         v-change-sign = 1
     1124       .
     1125     end.
     1126     else do:
     1127       assign
     1128         v-change-sign = -1
     1129       .
     1130     end.
     1131     assign
     1132       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1133     .
     1134     if p-change-value = 0
     1135     then do:
     1136       run diasize_position-resize-button in this-procedure .
     1137       return .
     1138     end.
     1139     move_block:
     1140     do
     1141     on error undo move_block, leave move_block
     1142     :
     1143       if retry
     1144       then do:
     1145         do
     1146         on error undo move_block, leave move_block
     1147         :
     1148           if p-change-value > 0
     1149           then do:
     1150             for each buf_temp-diasize-handle
     1151             on error undo, next
     1152             :
     1153               assign
     1154                 v-object-handle = buf_temp-diasize-handle.handle-value
     1155               .
     1156               if v-object-handle <> v-diasize-resize-button
     1157               then do:
     1158                 assign
     1159                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1160                 .
     1161               end.
     1162             end.
     1163             assign
     1164               v-diasize-browse-handle :width = v-browse-width
     1165             .
     1166             for each buf_temp-browse-handle
     1167               where buf_temp-browse-handle.browse-type = 'width':u
     1168             on error undo, next
     1169             :
     1170               assign
     1171                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1172               .
     1173             end.
     1174             assign
     1175               frame Dialog-Frame :width = v-frame-width
     1176             .
     1177             if frame Dialog-Frame :scrollable = true
     1178             then do:
     1179               assign
     1180                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1181               .
     1182             end.
     1183             run diasize_position-resize-button in this-procedure .
     1184           end.
     1185           else do:
     1186             if frame Dialog-Frame :scrollable = true
     1187             then do:
     1188               assign
     1189                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1190               .
     1191             end.
     1192             assign
     1193               frame Dialog-Frame :width = v-frame-width
     1194             .
     1195             for each buf_temp-browse-handle
     1196               where buf_temp-browse-handle.browse-type = 'width':u
     1197             on error undo, next
     1198             :
     1199               assign
     1200                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1201               .
     1202             end.
     1203             assign
     1204               v-diasize-browse-handle :width = v-browse-width
     1205             .
     1206             for each buf_temp-diasize-handle
     1207             on error undo, next
     1208             :
     1209               assign
     1210                 v-object-handle = buf_temp-diasize-handle.handle-value
     1211               .
     1212               if v-object-handle <> v-diasize-resize-button
     1213               then do:
     1214                 assign
     1215                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1216                 .
     1217               end.
     1218             end.
     1219             run diasize_position-resize-button in this-procedure .
     1220           end.
     1221           assign
     1222             v-diasize-change-size = false
     1223           .
     1224           leave move_block .
     1225         end.
     1226       end.
     1227       assign
     1228         v-diasize-need-full-display = true
     1229       .
     1230       if v-diasize-change-size = false
     1231       then do:
     1232         assign
     1233           v-diasize-change-size = true
     1234         .
     1235       end.
     1236       else do:
     1237         return .
     1238       end.
     1239       assign
     1240         v-frame-width = frame Dialog-Frame :width
     1241         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1242         v-browse-width = v-diasize-browse-handle :width
     1243       .
     1244       for each buf_temp-browse-handle
     1245         where buf_temp-browse-handle.browse-type = 'width':u
     1246       :
     1247         assign
     1248           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1249         .
     1250       end.
     1251       for each buf_temp-diasize-handle
     1252       :
     1253         delete buf_temp-diasize-handle .
     1254       end.
     1255       assign
     1256         v-field-group-handle = frame Dialog-Frame :first-child
     1257       .
     1258       do while valid-handle(v-field-group-handle)
     1259       :
     1260         assign
     1261           v-object-handle = v-field-group-handle :first-child
     1262         .
     1263         do while valid-handle(v-object-handle)
     1264         :
     1265           if  v-object-handle <> v-diasize-browse-handle :handle
     1266           and v-object-handle <> v-diasize-resize-button
     1267           and can-query(v-object-handle, "row")
     1268           and can-query(v-object-handle, "height")
     1269           and ( v-object-handle :col + v-object-handle :width
     1270                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1271               )
     1272           then do:
     1273             find first buf_temp-browse-handle
     1274               where buf_temp-browse-handle.browse-type   = 'width':u
     1275                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1276               no-error .
     1277             if available buf_temp-browse-handle
     1278             then do:
     1279             end.
     1280             else do:
     1281               create buf_temp-diasize-handle .
     1282               assign
     1283                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1284                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1285               .
     1286             end.
     1287           end.
     1288           assign
     1289             v-object-handle = v-object-handle :next-sibling
     1290           .
     1291         end.
     1292         assign
     1293           v-field-group-handle = v-field-group-handle :next-sibling
     1294         .
     1295       end.
     1296       do with frame Dialog-Frame
     1297       :
     1298         hide v-diasize-resize-button .
     1299         v-diasize-resize-button :row = 1.
     1300         v-diasize-resize-button :column = 1.
     1301       end.
     1302       if p-change-value > 0
     1303       then do:
     1304         if frame Dialog-Frame :scrollable = true
     1305         then do:
     1306           assign
     1307             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1308             no-error .
     1309           if error-status :error
     1310           or error-status :get-message(1) <> ""
     1311           then do:
     1312             undo move_block, retry move_block.
     1313           end.
     1314         end.
     1315         assign
     1316           frame Dialog-Frame :width = v-frame-width + p-change-value
     1317           no-error .
     1318         if error-status :error
     1319         or error-status :get-message(1) <> ""
     1320         then do:
     1321           undo move_block, retry move_block.
     1322         end.
     1323         assign
     1324           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1325         no-error .
     1326         if error-status :error
     1327         or error-status :get-message(1) <> ""
     1328         then do:
     1329           undo move_block, retry move_block.
     1330         end.
     1331         for each buf_temp-browse-handle
     1332           where buf_temp-browse-handle.browse-type = 'width':u
     1333         on error undo move_block, retry move_block
     1334         :
     1335           assign
     1336             buf_temp-browse-handle.browse-handle :width
     1337               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1338             no-error .
     1339           if error-status :error
     1340           or error-status :get-message(1) <> ""
     1341           then do:
     1342             undo move_block, retry move_block .
     1343           end.
     1344         end.
     1345         for each buf_temp-diasize-handle
     1346         on error undo move_block, retry move_block
     1347         :
     1348           assign
     1349             v-object-handle = buf_temp-diasize-handle.handle-value
     1350           .
     1351           if v-object-handle <> v-diasize-resize-button
     1352           then do:
     1353             assign
     1354               v-object-handle :col = v-object-handle :col + p-change-value
     1355               no-error .
     1356             if error-status :error
     1357             or error-status :get-message(1) <> ""
     1358             then do:
     1359               undo move_block, retry move_block .
     1360             end.
     1361           end.
     1362         end.
     1363       end.
     1364       else do:
     1365         for each buf_temp-diasize-handle
     1366         on error undo move_block, retry move_block
     1367         :
     1368           assign
     1369             v-object-handle = buf_temp-diasize-handle.handle-value
     1370           .
     1371           if v-object-handle <> v-diasize-resize-button
     1372           then do:
     1373             assign
     1374               v-object-handle :col = v-object-handle :col + p-change-value
     1375               no-error .
     1376             if error-status :error
     1377             or error-status :get-message(1) <> ""
     1378             then do:
     1379               undo move_block, retry move_block .
     1380             end.
     1381           end.
     1382         end.
     1383         for each buf_temp-browse-handle
     1384           where buf_temp-browse-handle.browse-type = 'width':u
     1385         on error undo move_block, retry move_block
     1386         :
     1387           assign
     1388             buf_temp-browse-handle.browse-handle :width
     1389               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1390             no-error .
     1391           if error-status :error
     1392           or error-status :get-message(1) <> ""
     1393           then do:
     1394             undo move_block, retry move_block .
     1395           end.
     1396         end.
     1397         assign
     1398           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1399           no-error .
     1400         if error-status :error
     1401         or error-status :get-message(1) <> ""
     1402         then do:
     1403           undo move_block, retry move_block.
     1404         end.
     1405         assign
     1406           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1407         no-error .
     1408         if error-status :error
     1409         or error-status :get-message(1) <> ""
     1410         then do:
     1411           undo move_block, retry move_block.
     1412         end.
     1413         if frame Dialog-Frame :scrollable = true
     1414         then do:
     1415           assign
     1416             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1417           no-error .
     1418           if error-status :error
     1419           or error-status :get-message(1) <> ""
     1420           then do:
     1421             undo move_block, retry move_block.
     1422           end.
     1423         end.
     1424       end.
     1425       if p-move-resize
     1426       then do:
     1427         run diasize_position-resize-button in this-procedure .
     1428       end.
     1429       if v-diasize-wndstore = true
     1430       then do:
     1431         if connected("ub") = true
     1432         then do:
     1433           define variable v-cntxt-db-num        as integer   no-undo .
     1434           define variable v-cntxt-userid        as character no-undo .
     1435           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1436                                             , OUTPUT v-cntxt-userid
     1437                                             ) .
     1438           run gbl/wndsizew.p
     1439             (input  v-cntxt-db-num
     1440             ,input  v-cntxt-userid
     1441             ,input  v-diasize-proc-name
     1442             ,input  'width':u
     1443             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1444             ) .
     1445         end.
     1446       end.
     1447     end.
     1448     assign
     1449       v-diasize-change-size = false
     1450     .
     1451   end procedure.
     1452   procedure diasize_set-width :
     1453     define input  parameter p-new-width  as decimal   no-undo .
     1454     define input  parameter p-move-resize as logical   no-undo .
     1455     do
     1456     on error undo, return error return-value
     1457     :
     1458       run diasize_change-width in this-procedure
     1459         (input  (p-new-width - frame Dialog-Frame :width)
     1460         ,input  p-move-resize
     1461         ) .
     1462     end.
     1463   end procedure.
     1464   procedure diasize_position-resize-button :
     1465     do with frame Dialog-Frame
     1466     :
     1467       hide v-diasize-resize-button .
     1468       assign
     1469         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1470                     - 1
     1471                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1472         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1473                     - 1
     1474                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1475       .
     1476       view v-diasize-resize-button .
     1477     end.
     1478   end procedure.
     1479   on alt-right anywhere
     1480   do:
     1481     run diasize_change-width in this-procedure
     1482       (input 1
     1483       ,input true
     1484       ) .
     1485     return no-apply .
     1486   end.
     1487   on alt-left anywhere
     1488   do:
     1489     run diasize_change-width in this-procedure
     1490       (input -1
     1491       ,input true
     1492       ) .
     1493     return no-apply .
     1494   end.
     1495   on alt-down anywhere
     1496   do:
     1497     run diasize_change-height in this-procedure
     1498       (input 1
     1499       ,input true
     1500       ) .
     1501     return no-apply .
     1502   end.
     1503   on alt-up anywhere
     1504   do:
     1505     run diasize_change-height in this-procedure
     1506       (input -1
     1507       ,input true
     1508       ) .
     1509     return no-apply .
     1510   end.
     1511   on alt-enter of frame Dialog-Frame
     1512   do:
     1513     run diasize_maximize in this-procedure
     1514       (input  ?
     1515       ).
     1516     return no-apply .
     1517   end.
     1518   procedure diasize_end-move :
     1519     do
     1520     on error undo, return error return-value
     1521     :
     1522       define variable v-row-delta as decimal   no-undo .
     1523       define variable v-col-delta as decimal   no-undo .
     1524       define variable v-new-row as decimal   no-undo .
     1525       define variable v-new-col as decimal   no-undo .
     1526       assign
     1527         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1528         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1529       .
     1530       assign
     1531         v-row-delta = v-new-row - frame Dialog-Frame :height
     1532         v-col-delta = v-new-col - frame Dialog-Frame :width
     1533       .
     1534       run diasize_change-height in this-procedure
     1535         (input v-row-delta
     1536         ,input true
     1537         ) .
     1538       run diasize_change-width in this-procedure
     1539         (input v-col-delta
     1540         ,input true
     1541         ) .
     1542     end.
     1543   end procedure.
     1544   procedure diasize_maximize :
     1545     define input  parameter p-action as logical   no-undo .
     1546     do
     1547     on error undo, return error return-value
     1548     :
     1549       if p-action = ?
     1550       then do:
     1551         if v-diasize-need-maximize = true
     1552         then do:
     1553           assign
     1554             p-action = true
     1555           .
     1556         end.
     1557         else do:
     1558           assign
     1559             p-action = false
     1560           .
     1561         end.
     1562       end.
     1563       if p-action = true
     1564       then do:
     1565         run diasize_change-height in this-procedure
     1566           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1567               - frame Dialog-Frame :height-chars
     1568           ,input true
     1569           ) .
     1570         run diasize_change-width in this-procedure
     1571           (input session :width-chars
     1572               - frame Dialog-Frame :width-chars
     1573           ,input true
     1574           ) .
     1575         assign
     1576           v-diasize-need-maximize = false
     1577         .
     1578       end.
     1579       else do:
     1580         run diasize_change-width in this-procedure
     1581           (input v-diasize-orig-frame-width
     1582               - frame Dialog-Frame :width-chars
     1583           ,input true
     1584           ) .
     1585         run diasize_change-height in this-procedure
     1586           (input v-diasize-orig-frame-height
     1587               - frame Dialog-Frame :height-chars
     1588           ,input true
     1589           ) .
     1590         assign
     1591           v-diasize-need-maximize = true
     1592         .
     1593       end.
     1594     end.
     1595   end procedure.
     1596   procedure diasize_restore-orig-size :
     1597     do
     1598     on error undo, return error return-value
     1599     :
     1600       assign
     1601         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1602         v-diasize-current-frame-height = frame Dialog-Frame :height
     1603       .
     1604       run diasize_set-height in this-procedure
     1605         (input  v-diasize-orig-frame-height
     1606         ,input  true
     1607         ) .
     1608       run diasize_set-width in this-procedure
     1609         (input  v-diasize-orig-frame-width
     1610         ,input  true
     1611         ) .
     1612     end.
     1613   end procedure.
     1614   procedure diasize_restore-current-size :
     1615     do
     1616     on error undo, return error return-value
     1617     :
     1618       run diasize_set-height in this-procedure
     1619         (input  v-diasize-current-frame-height
     1620         ,input  true
     1621         ) .
     1622       run diasize_set-width in this-procedure
     1623         (input  v-diasize-current-frame-width
     1624         ,input  true
     1625         ) .
     1626     end.
     1627   end procedure.
     1628   procedure diasize_set-browse-handle :
     1629     define input  parameter p-browse-handle as handle   no-undo .
     1630     define buffer buf_temp-browse-handle for temp-browse-handle .
     1631     do
     1632     on error undo, return error return-value
     1633     :
     1634       assign
     1635         v-diasize-browse-handle = p-browse-handle
     1636       .
     1637       for each buf_temp-browse-handle
     1638       on error undo, return error return-value
     1639       :
     1640         delete buf_temp-browse-handle .
     1641       end.
     1642     end.
     1643   end procedure.
     1644   procedure diasize_add_browse :
     1645     define input  parameter p-browse-type   as character no-undo .
     1646     define input  parameter p-browse-handle as handle    no-undo .
     1647     define buffer buf_temp-browse-handle for temp-browse-handle .
     1648     do
     1649     on error undo, return error return-value
     1650     :
     1651       assign
     1652         v-diasize-browse-number = v-diasize-browse-number + 1
     1653       .
     1654       create buf_temp-browse-handle .
     1655       assign
     1656         buf_temp-browse-handle.browse-type   = p-browse-type
     1657         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1658         buf_temp-browse-handle.browse-handle = p-browse-handle
     1659       .
     1660     end.
     1661   end procedure.
     1662   procedure diasize_init :
     1663     define variable v-default-value    as logical   no-undo .
     1664     define variable v-restore-saved    as logical   no-undo .
     1665     define variable v-resize-value-str as character no-undo .
     1666     do
     1667     on error undo, return error return-value
     1668     :
     1669       do with frame Dialog-Frame
     1670       :
     1671         assign
     1672           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1673           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1674           v-diasize-browse-handle     = browse br-chk-slip-head :handle
     1675         .
     1676         create button v-diasize-resize-button
     1677         assign
     1678           parent        = frame Dialog-Frame :first-child
     1679           label         = "s"
     1680           height-pixels = 16
     1681           width-pixels  = 16
     1682           visible       = true
     1683           sensitive     = true
     1684           movable       = true
     1685           triggers:
     1686             on end-move persistent run diasize_end-move in this-procedure .
     1687           end triggers.
     1688         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1689         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1690         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1691         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1692         assign
     1693           v-diasize-wndmax = false
     1694         .
     1695         if connected("ub") = true
     1696         then do:
     1697           define variable v-cntxt-db-num        as integer   no-undo .
     1698           define variable v-cntxt-userid        as character no-undo .
     1699           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1700                                             , OUTPUT v-cntxt-userid
     1701                                             ) .
     1702           run gbl/wndpar_r.p
     1703             (input  v-cntxt-db-num
     1704             ,input  v-cntxt-userid
     1705             ,input  'wndmax':U
     1706             ,output v-diasize-wndmax
     1707             ,output v-default-value
     1708             ) .
     1709         end.
     1710         assign
     1711           v-diasize-wndstore = false
     1712         .
     1713         if connected("ub") = true
     1714         then do:
     1715           run gbl/wndpar_r.p
     1716             (input  v-cntxt-db-num
     1717             ,input  v-cntxt-userid
     1718             ,input  'wndstore':U
     1719             ,output v-diasize-wndstore
     1720             ,output v-default-value
     1721             ) .
     1722         end.
     1723         assign
     1724           v-diasize-proc-name = entry(1, program-name(2), '.')
     1725         .
     1726         if v-diasize-wndstore = true
     1727         then do:
     1728           assign
     1729             v-restore-saved = false
     1730           .
     1731           if connected("ub") = true
     1732           then do:
     1733             run gbl/wndsizer.p
     1734               (input  v-cntxt-db-num
     1735               ,input  v-cntxt-userid
     1736               ,input  v-diasize-proc-name
     1737               ,input  'height':u
     1738               ,output v-resize-value-str
     1739               ) .
     1740             if v-resize-value-str <> '':U
     1741             then do:
     1742               run diasize_change-height in this-procedure
     1743                 (input  integer(v-resize-value-str)
     1744                 ,input  true
     1745                 ) .
     1746               assign
     1747                 v-restore-saved = true
     1748               .
     1749             end.
     1750           end.
     1751           if connected("ub") = true
     1752           then do:
     1753             run gbl/wndsizer.p
     1754               (input  v-cntxt-db-num
     1755               ,input  v-cntxt-userid
     1756               ,input  v-diasize-proc-name
     1757               ,input  'width':u
     1758               ,output v-resize-value-str
     1759               ) .
     1760             if v-resize-value-str <> '':U
     1761             then do:
     1762               run diasize_change-width in this-procedure
     1763                 (input  integer(v-resize-value-str)
     1764                 ,input  true
     1765                 ) .
     1766               assign
     1767                 v-restore-saved = true
     1768               .
     1769             end.
     1770           end.
     1771           if v-restore-saved <> true
     1772           then do:
     1773             if v-diasize-wndmax = true
     1774             then do:
     1775               run diasize_maximize in this-procedure
     1776                 (input  true
     1777                 ) .
     1778             end.
     1779           end.
     1780         end.
     1781         else do:
     1782           if v-diasize-wndmax = true
     1783           then do:
     1784             run diasize_maximize in this-procedure
     1785               (input  true
     1786               ) .
     1787           end.
     1788         end.
     1789       end.
     1790     end.
     1791   end procedure.
     1792   procedure diasize_need-full-display :
     1793     define output parameter p-need-full-display as logical   no-undo .
     1794     do
     1795     on error undo, return error return-value
     1796     :
     1797       assign
     1798         p-need-full-display = v-diasize-need-full-display
     1799       .
     1800       assign
     1801         v-diasize-need-full-display = false
     1802       .
     1803     end.
     1804   end procedure.
     1805   procedure get-context :
     1806      define output parameter p-db-num as integer          no-undo.
     1807      define output parameter p-user-id as character        no-undo.
     1808      define variable v-login               as character    no-undo.
     1809      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1810      define buffer buf_user-login  for ub.user-login .
     1811      do
     1812      on error undo, return error
     1813      :
     1814            FIND FIRST buf_sys-ctrl no-lock.
     1815            ASSIGN
     1816               v-login = USERID("ub")
     1817               p-db-num = buf_sys-ctrl.db-num
     1818            .
     1819            FIND FIRST buf_user-login
     1820                 WHERE buf_user-login.db-num = p-db-num
     1821                   AND buf_user-login.user-login = v-login
     1822                 no-lock
     1823                 no-error
     1824                 .
     1825            IF AVAILABLE buf_user-login
     1826            THEN DO:
     1827               assign
     1828                  p-user-id = buf_user-login.user-id
     1829               .
     1830            END.
     1831      end.
     1832   end procedure.
     1833       run diasize_init in this-procedure .
