        1   block-level on error undo, throw.
        2   define input parameter p-rec as recid no-undo .
        3   define input parameter p-silent as logical no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: icntdoc2.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/icntdoc2.p $":U .
        9   define variable vss-description as character no-undo init "Закрытие документа счетчиков ТРК".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define variable v-waitfram-action01         as character   no-undo .
       81   define variable v-waitfram-action02         as character   no-undo .
       82   define variable v-waitfram-action03         as character   no-undo .
       83   define variable mWaitFramTextBeg            as character   no-undo.
       84   define variable mWaitFramTextEnd            as character   no-undo.
       85   define variable mWaitFramView               as logical     no-undo.
       86   define variable mWaitProcEvent              as logical     no-undo init yes.
       87   define variable mWaitFramInterval           as integer     no-undo init 1 .
       88   define variable mWaitFramStop               as logical     no-undo.
       89   define variable mWaitFramStopUser           as logical     no-undo.
       90   define variable mWaitFramStopTimeOut        as logical     no-undo.
       91   define variable mWaitFramStartProc          as datetime-tz no-undo.
       92   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       93   define button B-WaitFramStop auto-end-key
       94        label "Стоп"
       95        size 10 by 1 tooltip "Остоновить процесс".
       96   define button B-viewProcInfo
       97        label "Информация"
       98        size 15 by 1 tooltip "Информация о процесс".
       99   define frame waitfram
      100     v-waitfram-action01 format "x(72)" no-label skip
      101     v-waitfram-action02 format "x(72)" no-label skip
      102     v-waitfram-action03 format "x(72)" no-label skip
      103     B-viewProcInfo
      104     B-WaitFramStop at row 4 col 30
      105     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      106     .
      107   define new global shared variable mBatchMode as logical no-undo init ?.
      108   define variable mFramBachModHandle as handle no-undo.
      109   mFramBachModHandle = frame waitfram:handle.
      110   define variable mFameOldVis as logical no-undo.
      111   define variable mVisCUrentVin as logical no-undo.
      112   if session:batch-mode
      113   then
      114      mBatchMode = yes.
      115   if mBatchMode = ? then do:
      116     mVisCUrentVin = current-window:visible.
      117     mFameOldVis = mFramBachModHandle:visible.
      118     mFramBachModHandle:visible  = yes.
      119     mBatchMode = mFramBachModHandle:visible ne yes.
      120     mFramBachModHandle:visible = mFameOldVis.
      121     current-window:visible = mVisCUrentVin.
      122   end.
      123    if  log-manager:logfile-name ne ?
      124     then DO:
      125         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      126         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      127         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      128     end.
      129   on choose of B-WaitFramStop in frame waitfram
      130   do:
      131     mWaitFramStop = yes.
      132     mWaitFramStopUser = yes.
      133   end.
      134   function waitfram-check-timeout returns logical():
      135      define variable vtime as int64 no-undo.
      136      if mWaitFramStopTimeOut
      137      then
      138         return yes.
      139      vtime = ( now - mWaitFramStartProc ) / 1000 .
      140      if     mWaitFramTimeOut ne ?
      141         and mWaitFramTimeOut ne 0
      142         and mWaitFramTimeOut lt vtime
      143      then do:
      144         mWaitFramStopTimeOut = yes.
      145      end.
      146      return mWaitFramStopTimeOut.
      147   end.
      148   procedure waitfram-hide :
      149     if not session:batch-mode
      150     then do
      151     on error undo, return error return-value
      152     :
      153       pause 0 before-hide .
      154       if not mBatchMode then
      155         hide frame waitfram .
      156     if     not mWaitFramView
      157        and mWaitProcEvent
      158     then
      159       process events .
      160     end.
      161   end procedure.
      162   procedure waitfram-show :
      163     define input  parameter p-message as character no-undo .
      164     define variable v-left-margin as integer   no-undo .
      165     if not session:batch-mode
      166     then do
      167     on error undo, return error return-value
      168     :
      169       if length(p-message) <= 70 then do:
      170         assign
      171           v-left-margin = integer((70 - length(p-message)) / 2)
      172         .
      173         assign
      174           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      175         .
      176         assign
      177           v-waitfram-action01 = " "
      178           v-waitfram-action02 = " "
      179                                    + fill(" ", v-left-margin)
      180                                    + p-message
      181           v-waitfram-action03 = " "
      182         .
      183       end.
      184       else do:
      185         define variable vRindex1 as integer no-undo.
      186         define variable vRindex2 as integer no-undo.
      187         vRindex1 = r-index(p-message," ",70).
      188         if vRindex1 = 0
      189         then
      190            vRindex1 = 70.
      191         if length(p-message)  <= vRindex1 + 70 then do:
      192           assign
      193             v-waitfram-action01 = " "
      194             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      196           .
      197         end.
      198         else do:
      199           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      200           if vRindex2 <= vRindex1
      201           then
      202              vRindex2 = vRindex1 + 70.
      203           assign
      204             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      205             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      206             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      207           .
      208         end.
      209       end.
      210       B-viewProcInfo:visible   in frame waitfram = no.
      211       B-viewProcInfo:sensitive in frame waitfram = no.
      212       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      213       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      214       if  (   mWaitFramView
      215          or  mWaitProcEvent)
      216          and not mBatchMode
      217       then
      218          display
      219             v-waitfram-action01 skip
      220             v-waitfram-action02 skip
      221             v-waitfram-action03 skip
      222          with frame waitfram .
      223       if     mWaitFramView
      224          then do:
      225             if     mWaitFramInterval ne ?
      226                and not mBatchMode
      227             then
      228                wait-for go of frame waitfram pause mWaitFramInterval.
      229          end.
      230          else
      231             if     mWaitProcEvent
      232                and not mBatchMode
      233             then
      234                process events .
      235     end.
      236   end procedure.
      237      procedure waitfram-show-this:
      238         define input  parameter iInterval as int64 no-undo.
      239         define variable vtime as int64 no-undo.
      240         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      241         mWaitFramInterval = iInterval.
      242         run waitfram-show (substitute("&1&2 &3&4" ,
      243                                       mWaitFramTextBeg ,
      244                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      245                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      246                                       mWaitFramTextEnd
      247                                      )
      248                           ).
      249      end.
      250      procedure WaitFramRunPause:
      251         define input  parameter iInterval as dec no-undo.
      252         define variable vStart  as datetime-tz no-undo.
      253         define variable vend    as datetime-tz no-undo.
      254         define variable vint as int64 no-undo.
      255         define variable vOk as logical no-undo.
      256         vStart = now.
      257         vend   = vStart.
      258         publish "WaitFramPause" (iInterval,output vOk).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and (   vint > 0
      264                 or (    not vOk
      265                     and iInterval eq ?
      266                     )
      267                 )
      268         then
      269            run waitfram-show-this (iInterval).
      270         vend   =  now.
      271         vint = vend - vStart.
      272         vint = iInterval - vint / 1000.
      273         if     not mWaitFramStop
      274            and vint > 0
      275         then do:
      276            run gbl/pause.p (vint * 1000).
      277         end.
      278         if iInterval ne ?
      279         then
      280            publish "WaitFramStop".
      281         waitfram-check-timeout().
      282      end.
      283      procedure WaitFramWaitFor:
      284         define input  parameter iInterval as dec no-undo.
      285         assign
      286            mWaitFramStartProc   = now
      287            mWaitFramStopUser    = no
      288            mWaitFramStopTimeOut = no
      289         .
      290         block-wait:
      291         do while not mWaitFramStop:
      292            run WaitFramRunPause (iInterval).
      293            if  waitfram-check-timeout()
      294            then do:
      295               leave block-wait.
      296            end.
      297         end.
      298         run waitfram-hide.
      299      end.
      300   procedure waitfram-join :
      301     define input  parameter p-line-1  as character no-undo .
      302     define input  parameter p-line-2  as character no-undo .
      303     define input  parameter p-line-3  as character no-undo .
      304     define output parameter p-message as character no-undo .
      305     do
      306     on error undo, return error return-value
      307     :
      308       assign
      309         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      310                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      311                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      312       .
      313     end.
      314   end procedure.
      315   function waitfram-join-function returns character
      316     (input p-line-1 as character
      317     ,input p-line-2 as character
      318     ,input p-line-3 as character
      319     ).
      320     define variable v-message as character no-undo .
      321     run waitfram-join in this-procedure
      322       (input  p-line-1
      323       ,input  p-line-2
      324       ,input  p-line-3
      325       ,output v-message
      326       ) .
      327     return v-message .
      328   end function .
      329   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      330   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      332   define variable par-type          as character no-undo.
      333   define variable v-value-character as character no-undo .
      334   define variable v-value-date      as date      no-undo .
      335   define variable v-value-decimal   as decimal   no-undo .
      336   define variable v-value-integer   as integer   no-undo .
      337   define variable v-value-logical   as logical   no-undo .
      338   define variable v-mess as character no-undo .
      339   define variable conf-par    as character no-undo.
      340   define variable varshift-name   as character no-undo.
      341   define buffer buf_icnt-doc for ub.icnt-doc.
      342   define buffer buf_icnt-line for ub.icnt-line.
      343   define buffer buf_pump-nozzle for ub.pump-nozzle.
      344   main-block:
      345   do
      346   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      347   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      348   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      349   :
      350     find first buf_icnt-doc exclusive-lock where
      351             recid(buf_icnt-doc) = p-rec .
      352   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   empty temp-table thbjattr_thbj-attr.
      354   run adm/shattri.p (
      355      input "get":U
      356     ,input ''
      357     ,input 0
      358     ,input 'nakl-glob':U
      359     ,input  ""
      360     ,output v-value-character
      361     ,output v-value-date
      362     ,output v-value-decimal
      363     ,output v-value-integer
      364     ,output v-value-logical
      365     ,output par-type
      366     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      367     ) no-error .
      368   for each thbjattr_thbj-attr :
      369       if thbjattr_thbj-attr.prop-code = 'chk-prs' then conf-par = string(thbjattr_thbj-attr.property-value-logical,"yes/no") .
      370   end.
      371     if conf-par <> "no" then do:
      372       if not can-find (ub.clients where ub.clients.obj-type = 'чел':U
      373                      and ub.clients.obj-code = buf_icnt-doc.boss no-lock) then do:
      374         v-mess =  "Не указан или неправильный менеджер.".
      375         run err-mess in this-procedure ( input-output v-mess) .
      376         undo main-block, return error (if p-silent = yes then v-mess else '':U).
      377       end.
      378       if not can-find (ub.clients where ub.clients.obj-type = 'чел':U
      379                    and ub.clients.obj-code = buf_icnt-doc.agnt no-lock)  then do:
      380         v-mess =  "Не указан или неправильный исполнитель.".
      381         run err-mess in this-procedure ( input-output v-mess) .
      382         undo main-block, return error (if p-silent = yes then v-mess else '':U).
      383       end.
      384     end.
      385     if buf_icnt-doc.doc-type = 'инв-сч-трк':U then do:
      386       for each buf_pump-nozzle where
      387                 buf_pump-nozzle.obj-type = buf_icnt-doc.obj-type
      388             and  buf_pump-nozzle.obj-code = buf_icnt-doc.obj-code
      389             and  buf_pump-nozzle.is-meas  = yes
      390       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      391       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      392       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      393       :
      394         if not can-find (first buf_icnt-line where
      395                             buf_icnt-line.doc-code    = buf_icnt-doc.doc-code
      396                       and  buf_icnt-line.obj-type    = buf_pump-nozzle.obj-type
      397                       and  buf_icnt-line.obj-code    = buf_pump-nozzle.obj-code
      398                       and  buf_icnt-line.pump-code   = buf_pump-nozzle.pump-code
      399                       and  buf_icnt-line.nozzle-code = buf_pump-nozzle.nozzle-code) then do:
      400          v-mess =  substitute("Структура документа инвентаризации счетчиков ТРК не соответствует конфигурации бензоколонки.&1" +
      401                    "Нет строки инвентаризации по ТРК № &2 пистолету № &3&1"
      402                    , chr(10)
      403                    , buf_pump-nozzle.pump-code
      404                    , buf_pump-nozzle.nozzle-code).
      405          run err-mess in this-procedure ( input-output v-mess) .
      406          undo main-block, return error (if p-silent = yes then v-mess else '':U).
      407         end.
      408       end.
      409       for each buf_icnt-line where
      410               buf_icnt-line.doc-code    = buf_icnt-doc.doc-code
      411       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      412       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      413       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      414       :
      415         if not can-find (first buf_pump-nozzle where
      416                              buf_pump-nozzle.obj-type    = buf_icnt-line.obj-type
      417                          and buf_pump-nozzle.obj-code    = buf_icnt-line.obj-code
      418                          and buf_pump-nozzle.pump-code   = buf_icnt-line.pump-code
      419                          and buf_pump-nozzle.nozzle-code = buf_icnt-line.nozzle-code ) then do:
      420          v-mess =  substitute("Структура документа инвентаризации счетчиков ТРК не соответствует конфигурации бензоколонки.&1" +
      421                    "Есть строка инвентаризации по ТРК № &2 пистолету № &3 не соответствующая конфигурации ТРК."
      422                    , chr(10)
      423                    , buf_icnt-line.pump-code
      424                    , buf_icnt-line.nozzle-code).
      425         run err-mess in this-procedure ( input-output v-mess) .
      426          undo main-block, return error (if p-silent = yes then v-mess else '':U).
      427         end.
      428       end.
      429     end.
      430     for each buf_icnt-line where buf_icnt-line.doc-code = buf_icnt-doc.doc-code
      431     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      432     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      433     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      434     :
      435       if buf_icnt-line.state-el-cnt = ? then do:
      436         v-mess =  substitute("Не определено показание электронного счетчика по ТРК № &1 и пистолету № &2"
      437                    ,buf_icnt-line.pump-code
      438                    ,buf_icnt-line.nozzle-code).
      439         undo main-block, return error (if p-silent = yes then v-mess else '':U).
      440       end.
      441       if buf_icnt-line.state-mh-cnt = ? then do:
      442         v-mess =  substitute("Не определено показание механического счетчика по ТРК № &1 и пистолету № &2"
      443                    ,buf_icnt-line.pump-code
      444                    ,buf_icnt-line.nozzle-code).
      445         run err-mess in this-procedure ( input-output v-mess) .
      446         undo main-block, return error (if p-silent = yes then v-mess else '':U).
      447       end.
      448     end.
      449     run gbl/factdate.p
      450       ( input        buf_icnt-doc.obj-type
      451       , input        buf_icnt-doc.obj-code
      452       , input-output buf_icnt-doc.fact-date
      453       , input-output buf_icnt-doc.fact-time
      454       , input-output buf_icnt-doc.shift-date
      455       , input-output buf_icnt-doc.shift-num
      456       , input-output buf_icnt-doc.shift-name
      457       ,input         not p-silent
      458       ) no-error.
      459     if error-status:error then do:
      460       v-mess = substitute("Ошибка при установке даты в документе инвентаризации счетчиков ТРК:&1&2&1&3"
      461                          , chr(10)
      462                          , error-status:get-message(1)
      463                          , return-value ).
      464       run err-mess in this-procedure ( input-output v-mess) .
      465       undo main-block, return error (if p-silent = yes then v-mess else '':U).
      466     end.
      467     assign
      468       buf_icnt-doc.status_ = 'факт':U
      469     .
      470   end.
      471   PROCEDURE err-mess:
      472     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      473     CASE p-silent:
      474       when yes then do:
      475         assign
      476         p-mess = substitute("Документ по счетчикам ТРК &1 &2&3&4&5"
      477                            , buf_icnt-doc.doc-code
      478                            , buf_icnt-doc.obj-type
      479                            , buf_icnt-doc.obj-code
      480                            , chr(10)
      481                            , p-mess)
      482         .
      483       end.
      484       when no then do:
      485         message
      486         p-mess
      487         view-as alert-box error .
      488       end.
      489     end.
      490   END PROCEDURE.
