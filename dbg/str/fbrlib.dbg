        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: dbfe23dd76e1, 1141, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        4   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:54 2017 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: fbrlib.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/fbrlib.p $":U .
        7   define variable vss-description as character no-undo init "Создание рецептов, действия с рецептами".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define new global shared variable g#library  as handle no-undo .
       13   define new global shared variable g#library2 as handle no-undo .
       14   define variable vss-include-info0 as character format "X(65)" no-undo
       15   initial "@(#)$Workfile$ $Revision$".
       16   define temp-table temp_fbrcode-doc-code no-undo
       17       field rec-type      as character
       18       field doc-code      as character
       19       field obj-type      as character
       20       field obj-code      as integer
       21       field cli-type      as character
       22       field cli-code      as integer
       23       field ext-doc-type  as character
       24       field doc-type      as character
       25       field order         as integer
       26       index pi is primary unique rec-type doc-code
       27       index od order
       28   .
       29   procedure fbrcode-gen-recipe-code :
       30   do
       31   on error undo, return error
       32   :
       33   define input parameter p-obj-type           as character    no-undo.
       34   define input parameter p-obj-code           as integer      no-undo.
       35   define output parameter p-recipe-code       as character    no-undo.
       36       assign
       37           p-recipe-code   = string( next-value( s-recipe, ub ) )
       38                               + "-"
       39                               + trim( string( p-obj-code, ">>>>9" ) )
       40                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
       41       .
       42   end.
       43   end procedure.
       44   procedure fbrcode-is-from-object :
       45   do
       46   on error undo, return error
       47   :
       48   define input parameter p-doc-code           as character    no-undo.
       49   define input parameter p-obj-type           as character    no-undo.
       50   define input parameter p-obj-code           as integer      no-undo.
       51   define output parameter p-is-from-object    as logical      no-undo.
       52       if num-entries( p-doc-code, "-" ) < 2
       53       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
       54                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
       55       then do:
       56           assign
       57               p-is-from-object = no
       58           .
       59       end.
       60       else do:
       61           assign
       62               p-is-from-object = yes
       63           .
       64       end.
       65   end.
       66   end procedure.
       67   procedure fbrcode-trn-doc :
       68   do
       69   on error undo, return error
       70   :
       71       define input parameter p-out-doc-type       as character    no-undo.
       72       define input parameter p-out-code           as character    no-undo.
       73       define input parameter p-trn-doc-out-type   as character    no-undo.
       74       define output parameter p-trn-doc-doc-code  as character   no-undo.
       75       case p-out-doc-type:
       76           when 'производство':U
       77           then do:
       78               case p-trn-doc-out-type :
       79                   when 'рас':U
       80                   then do:
       81                       assign
       82                           p-trn-doc-doc-code = p-out-code
       83                       .
       84                   end.
       85                   when 'при':U
       86                   then do:
       87                       assign
       88                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
       89                       .
       90                   end.
       91                   when 'спи':U
       92                   then do:
       93                       assign
       94                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
       95                       .
       96                   end.
       97                   otherwise do:
       98                       assign
       99                           p-trn-doc-doc-code = ""
      100                       .
      101                       undo, return error "Не может быть обработан тип складского документа '"
      102                                           + p-trn-doc-out-type + "' во входных параметрах".
      103                   end.
      104               end case.
      105           end.
      106           otherwise do:
      107               assign
      108                   p-trn-doc-doc-code = ""
      109               .
      110               undo, return error "Не может быть обработан тип внешнего документа '"
      111                                   + p-out-doc-type + "' во входных параметрах".
      112           end.
      113       end case.
      114   end.
      115   end procedure.
      116   procedure fbrcode-fill-fbr-by-sale-or-pln :
      117   define input parameter p-main-doc-code      as character        no-undo.
      118       define variable v-order    as integer      no-undo.
      119       define buffer buf_fbr-doc               for ub.fbr-doc.
      120       define buffer buf_trn-doc               for ub.trn-doc.
      121       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      122   do
      123   for buf_fbr-doc
      124     , buf_trn-doc
      125     , buf_temp_fbrcode-doc-code
      126   on error undo, return error
      127   :
      128       for each buf_temp_fbrcode-doc-code
      129       on error undo, return error
      130       :
      131           delete buf_temp_fbrcode-doc-code.
      132       end.
      133       assign
      134           v-order = 0
      135       .
      136       for each buf_fbr-doc no-lock
      137          where buf_fbr-doc.out-code = p-main-doc-code
      138       on error undo, return error
      139       :
      140           create buf_temp_fbrcode-doc-code.
      141           assign
      142               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
      143               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
      144               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
      145               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
      146               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
      147               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
      148               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
      149               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
      150           .
      151           for each buf_trn-doc no-lock
      152              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
      153           by buf_trn-doc.fact-order
      154           on error undo, return error
      155           :
      156               if buf_trn-doc.ext-doc-type = 'em':U
      157               or buf_trn-doc.ext-doc-type = 'im':U
      158               or buf_trn-doc.ext-doc-type = 'wm':U
      159               or buf_trn-doc.ext-doc-type = 'ev':U
      160               then do:
      161                   assign
      162                       v-order = v-order + 1
      163                   .
      164                   create buf_temp_fbrcode-doc-code.
      165                   assign
      166                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      167                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
      168                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      169                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      170                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      171                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      172                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      173                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      174                       buf_temp_fbrcode-doc-code.order         = v-order
      175                   .
      176               end.
      177           end.
      178           assign
      179               v-order  = v-order + 1
      180           .
      181           find first buf_temp_fbrcode-doc-code
      182                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
      183                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
      184           .
      185           assign
      186               buf_temp_fbrcode-doc-code.order = v-order
      187           .
      188       end.
      189       for each buf_trn-doc no-lock
      190          where buf_trn-doc.out-code = p-main-doc-code
      191       by buf_trn-doc.fact-order
      192       on error undo, return error
      193       :
      194           assign
      195               v-order = v-order + 1
      196           .
      197           create buf_temp_fbrcode-doc-code.
      198           assign
      199               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      200               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
      201               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      202               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      203               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      204               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      205               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      206               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      207               buf_temp_fbrcode-doc-code.order         = v-order
      208           .
      209       end.
      210   end.
      211   end procedure.
      212   procedure fbrcode-get-final-doc :
      213   define input parameter p-main-doc-code      as character        no-undo.
      214   define output parameter p-income-doc-code   as character        no-undo.
      215       define variable v-main-obj-type    as character    no-undo.
      216       define variable v-main-obj-code    as integer      no-undo.
      217       define buffer buf_trn-doc               for ub.trn-doc.
      218       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      219   do
      220   for buf_trn-doc
      221   on error undo, return error
      222   :
      223       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
      224           input p-main-doc-code
      225       ).
      226       find first buf_trn-doc no-lock
      227            where buf_trn-doc.doc-code = p-main-doc-code
      228       .
      229       assign
      230           v-main-obj-type = buf_trn-doc.obj-type
      231           v-main-obj-code = buf_trn-doc.obj-code
      232       .
      233       find first buf_temp_fbrcode-doc-code
      234            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
      235              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
      236              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
      237       no-error.
      238       if available buf_temp_fbrcode-doc-code
      239       then do:
      240           find first buf_trn-doc no-lock
      241                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
      242                  and buf_trn-doc.ext-doc-type = 'iv':U
      243           .
      244           assign
      245               p-income-doc-code = buf_trn-doc.doc-code
      246           .
      247       end.
      248       else do:
      249           find first buf_temp_fbrcode-doc-code
      250                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
      251                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
      252                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
      253           no-error.
      254           if available buf_temp_fbrcode-doc-code
      255           then do:
      256               assign
      257                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
      258               .
      259           end.
      260           else do:
      261               assign
      262                   p-income-doc-code = "":U
      263               .
      264           end.
      265       end.
      266   end.
      267   end procedure.
      268   define variable vss-include-info1 as character format "X(65)" no-undo
      269   initial "@(#)$Workfile$ $Revision$".
      270   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      271   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      272   define temp-table temp_fbrlib_recipe no-undo
      273       field recipe-code                   as character
      274       field fbr-doc-code                  as character
      275       field income-goods-doc-code         as character
      276       field count-income                  as integer
