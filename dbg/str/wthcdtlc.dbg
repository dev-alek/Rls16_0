        1   DEFINE BUFFER buf_c-wth-line FOR ub.c-wth-line.
        2   DEFINE BUFFER buf_wealth FOR ub.wealth.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   DEFINE TEMP-TABLE tt-par-dtl NO-UNDO LIKE ub.wth-par
        5   FIELD q-ty-doc     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во по!документу"
        6   FIELD q-ty-fact    AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Количество!факт"
        7   FIELD doc-sum      like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по!документу"
        8   FIELD fact-sum     like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма!факт"
        9   FIELD sum-gds-rubl like ub.wth-line.sum-gds-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам ()"
       10   FIELD sum-gds-base like ub.wth-line.sum-gds-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (баз.вал.)"
       11   FIELD price-rubl   like ub.wth-line.price-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!()"
       12   FIELD price-base   like ub.wth-line.price-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(баз.вал.)"
       13   FIELD w-p-code     like ub.wth-dtl.w-p-code
       14   FIELD doc-code     like ub.wth-dtl.doc-code
       15   FIELD gds-code     like ub.wth-gds.gds-code
       16   INDEX tt-pi    IS   PRIMARY UNIQUE par-code  w-p-code doc-code  wth-code
       17   INDEX tt-i1                        par-feat par-unit par-val
       18   INDEX tt-i2                        doc-sum  q-ty-doc
       19    .
       20   DEFINE INPUT PARAMETER par-mode as character no-undo .
       21   define input parameter parline-rec as recid no-undo.
       22   define input parameter pardoc-code like ub.c-wth-line.doc-code no-undo .
       23   define input parameter parwth-code like ub.c-wth-line.wth-code no-undo .
       24   define input parameter parw-p-code like ub.c-wth-line.w-p-code no-undo .
       25   define input parameter parcorr-user-db-num like ub.c-wth-line.corr-user-db-num no-undo .
       26   define input parameter parchip-num like ub.c-wth-line.chip-num no-undo .
       27   define input parameter pardoc-sum like ub.c-wth-line.doc-sum no-undo .
       28   define input parameter parfact-sum like ub.c-wth-line.fact-sum no-undo .
       29   define input parameter parbef-sum like ub.c-wth-line.bef-sum no-undo .
       30   define input parameter paraft-sum like ub.c-wth-line.aft-sum no-undo .
       31   DEFINE INPUT PARAMETER pardoc-type like ub.c-wth-doc.doc-type no-undo .
       32   define input-output parameter table for tt-par-dtl.
       33   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       34   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       35   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       36   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       37   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       38   define variable vss-description AS CHAR NO-UNDO INIT "Добавление, изменение, просмотр истории детализации строки документа МЦ (не инвентаризация)":U.
       39   procedure vss-get-info :
       40     define output parameter p-vss-revision    like vss-revision    no-undo .
       41     define output parameter p-vss-author      like vss-author      no-undo .
       42     define output parameter p-vss-date        like vss-date        no-undo .
       43     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       44     define output parameter p-vss-archive     like vss-archive     no-undo .
       45     define output parameter p-vss-description like vss-description no-undo .
       46     assign
       47       p-vss-revision    = vss-revision
       48       p-vss-author      = vss-author
       49       p-vss-date        = vss-date
       50       p-vss-workfile    = vss-workfile
       51       p-vss-archive     = vss-archive
       52       p-vss-description = vss-description
       53     .
       54   end procedure.
       55   procedure vss-get-parameters :
       56     define output parameter p-vss-parameters as character no-undo .
       57   end procedure.
       58   define new global shared variable g#vssrevis-logger as handle    no-undo .
       59   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       60   define variable v-vssrevis-logger                   as handle    no-undo .
       61   procedure vss-logevent :
       62     define input  parameter p-extra-paramters as character no-undo .
       63     define variable v-vssrevis-parameters as character no-undo .
       64     do
       65     on error undo, return error return-value
       66     :
       67       if  valid-handle(v-vssrevis-logger)
       68       and v-vssrevis-logger :get-signature("logevent") <> ""
       69       then do:
       70         run vss-get-parameters in this-procedure
       71           (output v-vssrevis-parameters
       72           ).
       73         run logevent in v-vssrevis-logger
       74           (input vss-workfile
       75           ,input vss-revision
       76           ,input v-vssrevis-parameters
       77           ,input p-extra-paramters
       78           ).
       79       end.
       80     end.
       81   end procedure.
       82   assign
       83     v-vssrevis-logger = g#vssrevis-logger
       84   .
       85   if  valid-handle(v-vssrevis-logger)
       86   and v-vssrevis-logger :get-signature("logevent") <> ""
       87   then do:
       88     assign
       89       v-vssrevis-logevent = true
       90     .
       91     run vss-logevent in this-procedure (input vss-description) .
       92   end.
       93   define new global shared variable g#language as character no-undo .
       94   if g#language <> '' and g#language <> 'rus':U then do:
       95     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       96   end.
       97   procedure proc-alt-shift-f2:
       98     if not ibs.th.gbl.gbl-var:rcode
       99   then
      100     run gbl\inidebug.p .
      101   end.
      102   procedure proc-alt-shift-f3:
      103     run gbl/prvssinf.p
      104       ( input this-procedure
      105       ) .
      106   end.
      107   define variable v-inform-launched as logical no-undo initial false .
      108   procedure proc-alt-shift-f4:
      109     define variable v-action as character no-undo .
      110     if v-inform-launched = false then do:
      111       assign
      112         v-inform-launched = true
      113       .
      114       run gbl/d-inform.w
      115         (  input self
      116         ,  input this-procedure
      117         , output v-action
      118         ) no-error .
      119       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      120       assign
      121         v-inform-launched = false
      122       .
      123     end.
      124   end.
      125   procedure proc-alt-f1:
      126     run gbl/corrhelp.p
      127       (input this-procedure
      128       ) .
      129   end .
      130   on alt-shift-f2 anywhere do:
      131     run proc-alt-shift-f2.
      132   end.
      133   on alt-shift-f3 anywhere do:
      134     run proc-alt-shift-f3 in this-procedure .
      135   end.
      136   on alt-shift-f4 anywhere do:
      137     run proc-alt-shift-f4 in this-procedure.
      138   end.
      139   on alt-f1 anywhere do:
      140     run proc-alt-f1 in this-procedure .
      141   end.
      142   define new global shared variable g#library  as handle no-undo .
      143   define new global shared variable g#library2 as handle no-undo .
      144   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145     define variable v-cntxt-db-num        as integer   no-undo .
      146     define variable v-cntxt-userid        as character no-undo .
      147     define variable v-cntxt-level         as character no-undo .
      148     define variable v-cntxt-host-code-obj as integer   no-undo .
      149     define variable v-cntxt-obj-type      as character no-undo .
      150     define variable v-cntxt-obj-code      as integer   no-undo .
      151     define variable v-cntxt-db-num-obj    as integer   no-undo .
      152     define variable v-cntxt-is-admin      as logical   no-undo .
      153   DEFine VARiable d_doc-sum LIKE ub.c-wth-doc.doc-sum NO-UNDO.
      154   DEFine VARiable d_fact-sum LIKE ub.c-wth-doc.doc-sum NO-UNDO.
      155   DEFINE VARIABLE vardoc-status_ like ub.c-wth-doc.status_ no-undo .
      156   define buffer buf_wth-par for ub.wth-par.
      157   define buffer buf_c-wth-doc for ub.c-wth-doc.
      158   DEFINE BUTTON B-Help
      159        LABEL "Помо&щь"
      160        SIZE 3 BY 1
      161        BGCOLOR 8 .
      162   DEFINE BUTTON B-par
      163        LABEL "&Инфо"
      164        SIZE 10 BY 1.
      165   DEFINE BUTTON B-parts
      166        LABEL "&Партии"
      167        SIZE 10 BY 1.
      168   DEFINE BUTTON b-quit AUTO-END-KEY
      169        LABEL "&Выход"
      170        SIZE 10 BY 1
      171        BGCOLOR 8 .
      172   DEFINE VARIABLE for-d_doc-sum AS CHARACTER FORMAT "X(15)":U
      173        LABEL "ИТОГО по документу"
      174         VIEW-AS TEXT
      175        SIZE 21.5 BY .67
      176        FGCOLOR 4  NO-UNDO.
      177   DEFINE VARIABLE for-d_fact-sum AS CHARACTER FORMAT "X(15)":U
      178        LABEL "ИТОГО факт"
      179         VIEW-AS TEXT
      180        SIZE 21.5 BY .67
      181        FGCOLOR 4  NO-UNDO.
      182   DEFINE QUERY BR-dtl FOR
      183         tt-par-dtl SCROLLING.
      184   DEFINE QUERY Dialog-Frame FOR
      185         buf_c-wth-line SCROLLING.
      186   DEFINE BROWSE BR-dtl
      187     QUERY BR-dtl DISPLAY
      188         tt-par-dtl.par-feat
      189         tt-par-dtl.par-val
      190         tt-par-dtl.par-unit
      191         tt-par-dtl.q-ty-doc
      192         tt-par-dtl.doc-sum
      193         tt-par-dtl.q-ty-fact
      194         tt-par-dtl.fact-sum
      195         tt-par-dtl.sum-gds-rubl
      196         tt-par-dtl.sum-gds-base
      197         tt-par-dtl.price-rubl
      198         tt-par-dtl.price-base
      199         tt-par-dtl.gds-code
      200   ENABLE
      201         tt-par-dtl.q-ty-doc
      202         tt-par-dtl.q-ty-fact
      203       WITH NO-ROW-MARKERS SEPARATORS SIZE 101.8 BY 13.67.
      204   DEFINE FRAME Dialog-Frame
      205        b-quit AT ROW 1 COL 11.1
      206        B-par AT ROW 1 COL 21
      207        B-parts AT ROW 1 COL 31 WIDGET-ID 4
      208        B-Help AT ROW 1 COL 95
      209        BR-dtl AT ROW 4.5 COL 1.4
      210        ub.c-wth-line.doc-sum AT ROW 3 COL 23.5 COLON-ALIGNED
      211              VIEW-AS TEXT
      212             SIZE 21.5 BY .67
      213             FGCOLOR 4
      214        ub.c-wth-line.fact-sum AT ROW 3 COL 59.5 COLON-ALIGNED
      215              VIEW-AS TEXT
      216             SIZE 21.5 BY .67
      217             FGCOLOR 4
      218        for-d_doc-sum AT ROW 18.63 COL 24.3 COLON-ALIGNED
      219        for-d_fact-sum AT ROW 18.67 COL 60.3 COLON-ALIGNED
      220        SPACE(19.44) SKIP(0.53)
      221       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      222            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      223            TITLE "<insert dialog title>"
      224            CANCEL-BUTTON b-quit.
      225   ASSIGN
      226          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      227          FRAME Dialog-Frame:HIDDEN           = TRUE.
      228   ASSIGN
      229          B-parts:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      230   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      231   DO:
      232     APPLY "END-ERROR":U TO SELF.
      233   END.
      234   ON CHOOSE OF B-par IN FRAME Dialog-Frame
      235   DO:
      236   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   if lookup(self :type
      238            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      239            ) = 0
      240   then do:
      241     message
      242       "$Workfile$"
      243       "Указанному интерфейсному элементу фокус не может быть передан" skip
      244       "Интерфейсный элемент" self :name  skip
      245       "Тип" self :type  skip
      246       "Процедура" this-procedure :file-name skip
      247       view-as alert-box .
      248   end.
      249   else do:
      250     apply "entry":u to self  .
      251     if focus :handle <> self :handle  then do:
      252       return no-apply .
      253     end.
      254   end.
      255     DEF BUFFER buf-par FOR ub.wth-par.
      256     define variable glog as logical no-undo .
      257     define variable v-rep-rec as recid no-undo .
      258     if not avail tt-par-dtl then return no-apply.
      259   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      260   do:
      261     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      262       (input  v-cntxt-db-num
      263       ,input  v-cntxt-userid
      264       ,input  0
      265       ,input  'actn_wealth_work':U
      266       ,input  'global':U
      267       ,input  0
      268       ,input  '':U
      269       ,input  0
      270       ,input  0
      271       ,input  0
      272       ,input  0
      273       ,input  true
      274       ,output glog
      275       )  .
      276   end.
      277     IF NOT glog THEN DO:
      278       RETURN NO-APPLY.
      279     END.
      280     FIND FIRST buf_wth-par NO-LOCK WHERE
      281                buf_wth-par.wth-code = buf_wealth.wth-code  AND
      282                buf_wth-par.par-code = tt-par-dtl.par-code NO-ERROR.
      283     IF NOT AVAIL buf_wth-par THEN DO:
      284       MESSAGE "Номинал не найден! " VIEW-AS ALERT-BOX ERROR.
      285       RETURN NO-APPLY.
      286     END.
      287     run ref/wthpform.w (
      288                       input parparentproc
      289                       ,input  buf_c-wth-doc.host-code
      290                       ,input buf_c-wth-doc.obj-code
      291                       ,input buf_c-wth-doc.obj-code
      292                      ,INPUT buf_wth-par.wth-code
      293                      ,INPUT buf_wth-par.par-code
      294                      ,INPUT 'ПРОСМОТР':U
      295                      ,OUTPUT v-rep-rec
      296                    ).
      297   END.
      298   ON CHOOSE OF B-parts IN FRAME Dialog-Frame
      299   DO:
      300   if not available tt-par-dtl then return.
      301   run str/wthcpart.w (
      302                    input parparentproc
      303                   ,input 'document':U
      304                   ,input 'ПРОСМОТР':U
      305                   ,input parwth-code
      306                   ,input tt-par-dtl.par-code
      307                   ,INPUT 0
      308                   ,input 0
      309                   ,INPUT buf_c-wth-doc.doc-code
      310                   ,INPUT parw-p-code
      311                   ,INPUT buf_c-wth-doc.cli-type
      312                   ,INPUT buf_c-wth-doc.cli-code
      313                   ,INPUT buf_c-wth-doc.doc-type ) no-error.
      314   if error-status:error then do:
      315     message return-value error-status:get-message(1) view-as alert-box error title 'Ошибка при запуске wthparts.w'.
      316     return no-apply.
      317   end.
      318   END.
      319   ON ROW-LEAVE OF BR-dtl IN FRAME Dialog-Frame
      320   DO:
      321   CASE vardoc-status_:
      322     when 'накл':U then do:
      323       ASSIGN
      324       tt-par-dtl.q-ty-doc = INPUT BROWSE BR-dtl tt-par-dtl.q-ty-doc.
      325       ASSIGN
      326       d_doc-sum = d_doc-sum - tt-par-dtl.doc-sum.
      327       ASSIGN
      328       tt-par-dtl.doc-sum = tt-par-dtl.q-ty-doc * tt-par-dtl.par-val * tt-par-dtl.par-rate.
      329       ASSIGN
      330       d_doc-sum = d_doc-sum + tt-par-dtl.doc-sum.
      331       DISPLAY
      332       tt-par-dtl.q-ty-doc
      333       tt-par-dtl.doc-sum
      334       WITH BROWSE BR-dtl.
      335       DISPLAY
      336       d_doc-sum @ for-d_doc-sum
      337       WITH FRAME Dialog-Frame.
      338     end.
      339     when 'разрешен':U then do:
      340       ASSIGN
      341       tt-par-dtl.q-ty-fact = INPUT BROWSE BR-dtl tt-par-dtl.q-ty-fact.
      342       ASSIGN
      343       d_fact-sum = d_fact-sum - tt-par-dtl.fact-sum.
      344       ASSIGN
      345       tt-par-dtl.fact-sum = tt-par-dtl.q-ty-fact * tt-par-dtl.par-val * tt-par-dtl.par-rate.
      346       ASSIGN
      347       d_fact-sum = d_fact-sum + tt-par-dtl.fact-sum.
      348       DISPLAY
      349       tt-par-dtl.q-ty-fact
      350       tt-par-dtl.fact-sum
      351       WITH BROWSE BR-dtl.
      352       DISPLAY
      353       d_fact-sum @ for-d_fact-sum
      354       WITH FRAME Dialog-Frame.
      355     end.
      356   END CASE.
      357   END.
      358   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      359   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      360   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   on help of frame Dialog-Frame
      362   do:
      363     run gbl/app_help.p
      364       (input this-procedure :file-name
      365       ,input ''
      366       ,input ?
      367       ) no-error.
      368     if error-status :error then do:
      369       message
      370         "Ошибка при вызове помощи"
      371         error-status :get-message(1)
      372         view-as alert-box .
      373     end.
      374   end.
      375   run minbtn-set in this-procedure .
      376   on choose of b-help in frame Dialog-Frame
      377   do:
      378     apply "help":u to frame Dialog-Frame .
      379   end.
      380   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   procedure minbtn-set :
      382       do
      383           on error undo, return error return-value
      384           :
      385           define variable ii              as integer       no-undo .
      386           define variable fh              as widget-handle no-undo .
      387           define variable hh              as widget-handle no-undo .
      388           define variable v-h             as handle        extent 4 no-undo .
      389           define variable v-name-button   as character     no-undo .
      390           define variable v-help-old-x    as decimal       no-undo .
      391           define variable v-help-old-y    as decimal       no-undo .
      392           define variable v-help-old-size as decimal       no-undo .
      393           define variable v-frame-width   as decimal       no-undo .
      394           define variable jj              as integer       no-undo .
      395           do
      396               on error undo, return error
      397               :
      398               assign
      399                   v-frame-width = frame Dialog-Frame:width - 0.3
      400                   fh            = frame Dialog-Frame:first-child
      401                   hh            = fh:first-child
      402                   ii            = 1
      403                   .
      404               do while valid-handle(hh):
      405                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      406                   do:
      407                       case lc(hh:name) :
      408                           when "b-help" then
      409                               do:
      410                                   hh:load-image-up("cmp/b-help.bmp":u) .
      411                                   hh:load-image-down("cmp/b-help.bmp":u) .
      412                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      413                                   hh:TOOLTIP = "Помощь" .
      414                                   v-help-old-x = hh:column .
      415                                   v-help-old-y = hh:row    .
      416                                   v-help-old-size = hh:width .
      417                                   hh:width-chars = 2.5 .
      418                               end.
      419                           when "b-print" then
      420                               do:
      421                                   hh:load-image("cmp/b-print.bmp":u) .
      422                                   hh:TOOLTIP = "Печать" .
      423                                   v-h[ii] = hh:handle .
      424                                   ii = ii + 1 .
      425                                   hh:width-chars = 3 .
      426                               end.
      427                           when "b-history" or
      428                           when "b-hist" then
      429                               do:
      430                                   hh:load-image("cmp/b-hist.bmp":u) .
      431                                   hh:TOOLTIP = "История" .
      432                                   v-h[ii] = hh:handle .
      433                                   ii = ii + 1 .
      434                                   hh:width-chars = 3 .
      435                               end.
      436                           when "b-sch" then
      437                               do:
      438                                   hh:load-image("cmp/b-sch.bmp":u) .
      439                                   hh:TOOLTIP = "Установка Фильтра" .
      440                                   v-h[ii] = hh:handle .
      441                                   ii = ii + 1 .
      442                                   hh:width-chars = 3 .
      443                               end.
      444                           when "b-hist-user" then
      445                               do:
      446                                   hh:load-image("cmp/b-hist.bmp":u) .
      447                                   hh:TOOLTIP = "История пользователя" .
      448                                   ii = ii + 1 .
      449                               end.
      450                       end case.
      451                   end.
      452                   hh = hh:next-sibling.
      453               end.
      454               b-help:column = v-frame-width - b-help:width-chars.
      455               jj = 0.
      456               repeat ii = 4 to 1 by -1 :
      457                   if valid-handle (v-h[ii] ) then
      458                   do:
      459                       jj  = jj + 1 .
      460                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      461                       v-h[ii]:row    = v-help-old-y .
      462                   end.
      463               end.
      464           end.
      465       end.
      466   end procedure.
      467   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      468   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      469   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      470   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      471   define variable v-diasize-current-frame-width  as decimal   no-undo .
      472   define variable v-diasize-current-frame-height as decimal   no-undo .
      473   define variable v-diasize-change-size          as logical   no-undo .
      474   define variable v-diasize-resize-button        as handle    no-undo .
      475   define variable v-diasize-wndmax               as logical   no-undo .
      476   define variable v-diasize-wndstore             as logical   no-undo .
      477   define variable v-diasize-proc-name            as character no-undo .
      478   define variable v-diasize-browse-handle        as handle    no-undo .
      479   define variable v-diasize-browse-number        as integer   no-undo .
      480   define variable v-diasize-need-full-display    as logical   no-undo init false .
      481   define temp-table temp-diasize-handle no-undo
      482     field handle-value  as handle
      483     field save-position as decimal
      484     index xpk is primary unique handle-value
      485     .
      486   define temp-table temp-browse-handle no-undo
      487     field browse-type   as character
      488     field browse-number as integer
      489     field browse-handle as handle
      490     field original-size as decimal
      491     index xpk is primary unique browse-type browse-number
      492     index xie browse-type browse-handle
      493   .
      494   procedure diasize_change-height :
      495     define input  parameter p-change-value  as decimal   no-undo .
      496     define input  parameter p-move-resize   as logical   no-undo .
      497     define variable v-field-group-handle    as handle    no-undo .
      498     define variable v-object-handle         as handle    no-undo .
      499     define variable v-frame-height          as decimal   no-undo .
      500     define variable v-frame-virtual-height  as decimal   no-undo .
      501     define variable v-browse-height         as decimal   no-undo .
      502     define variable v-window-height         as decimal   no-undo .
      503     define variable v-window-virtual-height as decimal   no-undo .
      504     define variable v-change-sign           as integer   no-undo .
      505     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      506     define buffer buf_temp-browse-handle  for temp-browse-handle .
      507     if p-change-value > 0
      508     then do:
      509       if frame Dialog-Frame :height + p-change-value
      510           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      511       then do:
      512         assign
      513           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      514                           - (frame Dialog-Frame :height-chars)
      515         .
      516         if p-change-value <= 0
      517         then do:
      518           run diasize_position-resize-button in this-procedure .
      519           return .
      520         end.
      521       end.
      522     end.
      523     if p-change-value < 0
      524     then do:
      525       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      526       then do:
      527         assign
      528           p-change-value = v-diasize-orig-frame-height
      529                          - (frame Dialog-Frame :height-chars)
      530         .
      531         if p-change-value >= 0
      532         then do:
      533           run diasize_position-resize-button in this-procedure .
      534           return .
      535         end.
      536       end.
      537     end.
      538     if p-change-value >= 0
      539     then do:
      540       assign
      541         v-change-sign = 1
      542       .
      543     end.
      544     else do:
      545       assign
      546         v-change-sign = -1
      547       .
      548     end.
      549     assign
      550       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      551     .
      552     if p-change-value = 0
      553     then do:
      554       run diasize_position-resize-button in this-procedure .
      555       return .
      556     end.
      557     move_block:
      558     do
      559     on error undo move_block, retry move_block
      560     :
      561       if retry
      562       then do:
      563         do
      564         on error undo move_block, leave move_block
      565         :
      566           if p-change-value > 0
      567           then do:
      568             for each buf_temp-diasize-handle
      569             on error undo, next
      570             :
      571               assign
      572                 v-object-handle = buf_temp-diasize-handle.handle-value
      573               .
      574               if v-object-handle <> v-diasize-resize-button
      575               then do:
      576                 assign
      577                   v-object-handle :row = buf_temp-diasize-handle.save-position
      578                 .
      579               end.
      580             end.
      581             assign
      582               v-diasize-browse-handle :height = v-browse-height
      583             .
      584             for each buf_temp-browse-handle
      585               where buf_temp-browse-handle.browse-type = 'height':u
      586             on error undo, next
      587             :
      588               assign
      589                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      590               .
      591             end.
      592             assign
      593               frame Dialog-Frame :height = v-frame-height
      594             .
      595             if frame Dialog-Frame :scrollable = true
      596             then do:
      597               assign
      598                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      599               .
      600             end.
      601             run diasize_position-resize-button in this-procedure .
      602           end.
      603           else do:
      604             if frame Dialog-Frame :scrollable = true
      605             then do:
      606               assign
      607                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      608               .
      609             end.
      610             assign
      611               frame Dialog-Frame :height = v-frame-height
      612             .
      613             assign
      614               v-diasize-browse-handle :height = v-browse-height
      615             .
      616             for each buf_temp-browse-handle
      617               where buf_temp-browse-handle.browse-type = 'height':u
      618             on error undo, next
      619             :
      620               assign
      621                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      622               .
      623             end.
      624             for each buf_temp-diasize-handle
      625             on error undo, next
      626             :
      627               assign
      628                 v-object-handle = buf_temp-diasize-handle.handle-value
      629               .
      630               if v-object-handle <> v-diasize-resize-button
      631               then do:
      632                 assign
      633                   v-object-handle :row = buf_temp-diasize-handle.save-position
      634                 .
      635               end.
      636             end.
      637             run diasize_position-resize-button in this-procedure .
      638           end.
      639           assign
      640             v-diasize-change-size = false
      641           .
      642           leave move_block .
      643         end.
      644       end.
      645       assign
      646         v-diasize-need-full-display = true
      647       .
      648       if v-diasize-change-size = false
      649       then do:
      650         assign
      651           v-diasize-change-size = true
      652         .
      653       end.
      654       else do:
      655         return .
      656       end.
      657       assign
      658         v-frame-height = frame Dialog-Frame :height
      659         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      660         v-browse-height = v-diasize-browse-handle :height
      661       .
      662       for each buf_temp-browse-handle
      663         where buf_temp-browse-handle.browse-type = 'height':u
      664       :
      665         assign
      666           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      667         .
      668       end.
      669       for each buf_temp-diasize-handle
      670       :
      671         delete buf_temp-diasize-handle .
      672       end.
      673       assign
      674         v-field-group-handle = frame Dialog-Frame :first-child
      675       .
      676       do while valid-handle(v-field-group-handle)
      677       :
      678         assign
      679           v-object-handle = v-field-group-handle :first-child
      680         .
      681         do while valid-handle(v-object-handle)
      682         :
      683           if  v-object-handle <> v-diasize-browse-handle :handle
      684           and can-query(v-object-handle, "row")
      685           and can-query(v-object-handle, "height")
      686           and ( v-object-handle :row > v-diasize-browse-handle :row )
      687           then do:
      688             find first buf_temp-browse-handle
      689               where buf_temp-browse-handle.browse-type   = 'height':u
      690                 and buf_temp-browse-handle.browse-handle = v-object-handle
      691               no-error .
      692             if available buf_temp-browse-handle
      693             then do:
      694             end.
      695             else do:
      696               create buf_temp-diasize-handle .
      697               assign
      698                 buf_temp-diasize-handle.handle-value  = v-object-handle
      699                 buf_temp-diasize-handle.save-position = v-object-handle :row
      700               .
      701             end.
      702           end.
      703           assign
      704             v-object-handle = v-object-handle :next-sibling
      705           .
      706         end.
      707         assign
      708           v-field-group-handle = v-field-group-handle :next-sibling
      709         .
      710       end.
      711       do with frame Dialog-Frame
      712       :
      713         hide v-diasize-resize-button .
      714         assign
      715           v-diasize-resize-button :row    = 1
      716           v-diasize-resize-button :column = 1
      717         .
      718       end.
      719       if p-change-value > 0
      720       then do:
      721         if frame Dialog-Frame :scrollable = true
      722         then do:
      723           assign
      724             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      725             no-error .
      726           if error-status :error
      727           or error-status :get-message(1) <> ""
      728           then do:
      729             undo move_block, retry move_block .
      730           end.
      731         end.
      732         assign
      733           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      734           no-error .
      735         if error-status :error
      736         or error-status :get-message(1) <> ""
      737         then do:
      738           undo move_block, retry move_block .
      739         end.
      740         assign
      741           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      742           no-error .
      743         if error-status :error
      744         or error-status :get-message(1) <> ""
      745         then do:
      746           undo move_block, retry move_block .
      747         end.
      748         for each buf_temp-browse-handle
      749           where buf_temp-browse-handle.browse-type = 'height':u
      750         on error undo move_block, retry move_block
      751         :
      752           assign
      753             buf_temp-browse-handle.browse-handle :height
      754               = buf_temp-browse-handle.browse-handle :height + p-change-value
      755             no-error .
      756           if error-status :error
      757           or error-status :get-message(1) <> ""
      758           then do:
      759             undo move_block, retry move_block .
      760           end.
      761         end.
      762         for each buf_temp-diasize-handle
      763         on error undo move_block, retry move_block
      764         :
      765           assign
      766             v-object-handle = buf_temp-diasize-handle.handle-value
      767           .
      768           if v-object-handle <> v-diasize-resize-button
      769           then do:
      770             assign
      771               v-object-handle :row = v-object-handle :row + p-change-value
      772               no-error .
      773             if error-status :error
      774             or error-status :get-message(1) <> ""
      775             then do:
      776               undo move_block, retry move_block .
      777             end.
      778           end.
      779         end.
      780       end.
      781       else do:
      782         for each buf_temp-diasize-handle
      783         on error undo move_block, retry move_block
      784         :
      785           assign
      786             v-object-handle = buf_temp-diasize-handle.handle-value
      787           .
      788           if v-object-handle <> v-diasize-resize-button
      789           then do:
      790             assign
      791               v-object-handle :row = v-object-handle :row + p-change-value
      792               no-error .
      793             if error-status :error
      794             or error-status :get-message(1) <> ""
      795             then do:
      796               undo move_block, retry move_block .
      797             end.
      798           end.
      799         end.
      800         assign
      801           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      802           no-error .
      803         if error-status :error
      804         or error-status :get-message(1) <> ""
      805         then do:
      806           undo move_block, retry move_block .
      807         end.
      808         for each buf_temp-browse-handle
      809           where buf_temp-browse-handle.browse-type = 'height':u
      810         on error undo move_block, retry move_block
      811         :
      812           assign
      813             buf_temp-browse-handle.browse-handle :height
      814               = buf_temp-browse-handle.browse-handle :height + p-change-value
      815             no-error .
      816           if error-status :error
      817           or error-status :get-message(1) <> ""
      818           then do:
      819             undo move_block, retry move_block .
      820           end.
      821         end.
      822         assign
      823           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      824           no-error .
      825         if error-status :error
      826         or error-status :get-message(1) <> ""
      827         then do:
      828           undo move_block, retry move_block .
      829         end.
      830         if frame Dialog-Frame :scrollable = true
      831         then do:
      832           assign
      833             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      834             no-error .
      835           if error-status :error
      836           or error-status :get-message(1) <> ""
      837           then do:
      838             undo move_block, retry move_block .
      839           end.
      840         end.
      841       end.
      842       if p-move-resize = true
      843       then do:
      844         run diasize_position-resize-button in this-procedure .
      845       end.
      846       if v-diasize-wndstore = true
      847       then do:
      848         if connected("ub") = true
      849         then do:
      850           define variable v-cntxt-db-num        as integer   no-undo .
      851           define variable v-cntxt-userid        as character no-undo .
      852           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      853                                             , OUTPUT v-cntxt-userid
      854                                             ) .
      855           run gbl/wndsizew.p
      856             (input  v-cntxt-db-num
      857             ,input  v-cntxt-userid
      858             ,input  v-diasize-proc-name
      859             ,input  'height':u
      860             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      861             ) .
      862         end.
      863       end.
      864     end.
      865     assign
      866       v-diasize-change-size = false
      867     .
      868   end procedure.
      869   procedure diasize_set-height :
      870     define input  parameter p-new-height  as decimal   no-undo .
      871     define input  parameter p-move-resize as logical   no-undo .
      872     do
      873     on error undo, return error return-value
      874     :
      875       run diasize_change-height in this-procedure
      876         (input  (p-new-height - frame Dialog-Frame :height)
      877         ,input  p-move-resize
      878         ) .
      879     end.
      880   end procedure.
      881   procedure diasize_change-width :
      882     define input  parameter p-change-value as decimal   no-undo .
      883     define input  parameter p-move-resize  as logical   no-undo .
      884     define variable v-field-group-handle   as handle    no-undo .
      885     define variable v-object-handle        as handle    no-undo .
      886     define variable v-frame-width          as decimal   no-undo .
      887     define variable v-frame-virtual-width  as decimal   no-undo .
      888     define variable v-browse-width         as decimal   no-undo .
      889     define variable v-window-width         as decimal   no-undo .
      890     define variable v-window-virtual-width as decimal   no-undo .
      891     define variable v-change-sign          as integer   no-undo .
      892     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      893     define buffer buf_temp-browse-handle  for temp-browse-handle .
      894     if p-change-value > 0
      895     then do:
      896       if frame Dialog-Frame :width + p-change-value >
      897           session :width-chars
      898       then do:
      899         assign
      900           p-change-value = session :width-chars - frame Dialog-Frame :width
      901         .
      902         if p-change-value <= 0
      903         then do:
      904           run diasize_position-resize-button in this-procedure .
      905           return .
      906         end.
      907       end.
      908     end.
      909     if p-change-value < 0
      910     then do:
      911       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      912       then do:
      913         assign
      914           p-change-value = v-diasize-orig-frame-width
      915                          - frame Dialog-Frame :width
      916         .
      917         if p-change-value >= 0
      918         then do:
      919           run diasize_position-resize-button in this-procedure .
      920           return .
      921         end.
      922       end.
      923     end.
      924     if p-change-value >= 0
      925     then do:
      926       assign
      927         v-change-sign = 1
      928       .
      929     end.
      930     else do:
      931       assign
      932         v-change-sign = -1
      933       .
      934     end.
      935     assign
      936       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      937     .
      938     if p-change-value = 0
      939     then do:
      940       run diasize_position-resize-button in this-procedure .
      941       return .
      942     end.
      943     move_block:
      944     do
      945     on error undo move_block, leave move_block
      946     :
      947       if retry
      948       then do:
      949         do
      950         on error undo move_block, leave move_block
      951         :
      952           if p-change-value > 0
      953           then do:
      954             for each buf_temp-diasize-handle
      955             on error undo, next
      956             :
      957               assign
      958                 v-object-handle = buf_temp-diasize-handle.handle-value
      959               .
      960               if v-object-handle <> v-diasize-resize-button
      961               then do:
      962                 assign
      963                   v-object-handle :col = buf_temp-diasize-handle.save-position
      964                 .
      965               end.
      966             end.
      967             assign
      968               v-diasize-browse-handle :width = v-browse-width
      969             .
      970             for each buf_temp-browse-handle
      971               where buf_temp-browse-handle.browse-type = 'width':u
      972             on error undo, next
      973             :
      974               assign
      975                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      976               .
      977             end.
      978             assign
      979               frame Dialog-Frame :width = v-frame-width
      980             .
      981             if frame Dialog-Frame :scrollable = true
      982             then do:
      983               assign
      984                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      985               .
      986             end.
      987             run diasize_position-resize-button in this-procedure .
      988           end.
      989           else do:
      990             if frame Dialog-Frame :scrollable = true
      991             then do:
      992               assign
      993                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      994               .
      995             end.
      996             assign
      997               frame Dialog-Frame :width = v-frame-width
      998             .
      999             for each buf_temp-browse-handle
     1000               where buf_temp-browse-handle.browse-type = 'width':u
     1001             on error undo, next
     1002             :
     1003               assign
     1004                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1005               .
     1006             end.
     1007             assign
     1008               v-diasize-browse-handle :width = v-browse-width
     1009             .
     1010             for each buf_temp-diasize-handle
     1011             on error undo, next
     1012             :
     1013               assign
     1014                 v-object-handle = buf_temp-diasize-handle.handle-value
     1015               .
     1016               if v-object-handle <> v-diasize-resize-button
     1017               then do:
     1018                 assign
     1019                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1020                 .
     1021               end.
     1022             end.
     1023             run diasize_position-resize-button in this-procedure .
     1024           end.
     1025           assign
     1026             v-diasize-change-size = false
     1027           .
     1028           leave move_block .
     1029         end.
     1030       end.
     1031       assign
     1032         v-diasize-need-full-display = true
     1033       .
     1034       if v-diasize-change-size = false
     1035       then do:
     1036         assign
     1037           v-diasize-change-size = true
     1038         .
     1039       end.
     1040       else do:
     1041         return .
     1042       end.
     1043       assign
     1044         v-frame-width = frame Dialog-Frame :width
     1045         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1046         v-browse-width = v-diasize-browse-handle :width
     1047       .
     1048       for each buf_temp-browse-handle
     1049         where buf_temp-browse-handle.browse-type = 'width':u
     1050       :
     1051         assign
     1052           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1053         .
     1054       end.
     1055       for each buf_temp-diasize-handle
     1056       :
     1057         delete buf_temp-diasize-handle .
     1058       end.
     1059       assign
     1060         v-field-group-handle = frame Dialog-Frame :first-child
     1061       .
     1062       do while valid-handle(v-field-group-handle)
     1063       :
     1064         assign
     1065           v-object-handle = v-field-group-handle :first-child
     1066         .
     1067         do while valid-handle(v-object-handle)
     1068         :
     1069           if  v-object-handle <> v-diasize-browse-handle :handle
     1070           and v-object-handle <> v-diasize-resize-button
     1071           and can-query(v-object-handle, "row")
     1072           and can-query(v-object-handle, "height")
     1073           and ( v-object-handle :col + v-object-handle :width
     1074                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1075               )
     1076           then do:
     1077             find first buf_temp-browse-handle
     1078               where buf_temp-browse-handle.browse-type   = 'width':u
     1079                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1080               no-error .
     1081             if available buf_temp-browse-handle
     1082             then do:
     1083             end.
     1084             else do:
     1085               create buf_temp-diasize-handle .
     1086               assign
     1087                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1088                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1089               .
     1090             end.
     1091           end.
     1092           assign
     1093             v-object-handle = v-object-handle :next-sibling
     1094           .
     1095         end.
     1096         assign
     1097           v-field-group-handle = v-field-group-handle :next-sibling
     1098         .
     1099       end.
     1100       do with frame Dialog-Frame
     1101       :
     1102         hide v-diasize-resize-button .
     1103         v-diasize-resize-button :row = 1.
     1104         v-diasize-resize-button :column = 1.
     1105       end.
     1106       if p-change-value > 0
     1107       then do:
     1108         if frame Dialog-Frame :scrollable = true
     1109         then do:
     1110           assign
     1111             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1112             no-error .
     1113           if error-status :error
     1114           or error-status :get-message(1) <> ""
     1115           then do:
     1116             undo move_block, retry move_block.
     1117           end.
     1118         end.
     1119         assign
     1120           frame Dialog-Frame :width = v-frame-width + p-change-value
     1121           no-error .
     1122         if error-status :error
     1123         or error-status :get-message(1) <> ""
     1124         then do:
     1125           undo move_block, retry move_block.
     1126         end.
     1127         assign
     1128           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1129         no-error .
     1130         if error-status :error
     1131         or error-status :get-message(1) <> ""
     1132         then do:
     1133           undo move_block, retry move_block.
     1134         end.
     1135         for each buf_temp-browse-handle
     1136           where buf_temp-browse-handle.browse-type = 'width':u
     1137         on error undo move_block, retry move_block
     1138         :
     1139           assign
     1140             buf_temp-browse-handle.browse-handle :width
     1141               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1142             no-error .
     1143           if error-status :error
     1144           or error-status :get-message(1) <> ""
     1145           then do:
     1146             undo move_block, retry move_block .
     1147           end.
     1148         end.
     1149         for each buf_temp-diasize-handle
     1150         on error undo move_block, retry move_block
     1151         :
     1152           assign
     1153             v-object-handle = buf_temp-diasize-handle.handle-value
     1154           .
     1155           if v-object-handle <> v-diasize-resize-button
     1156           then do:
     1157             assign
     1158               v-object-handle :col = v-object-handle :col + p-change-value
     1159               no-error .
     1160             if error-status :error
     1161             or error-status :get-message(1) <> ""
     1162             then do:
     1163               undo move_block, retry move_block .
     1164             end.
     1165           end.
     1166         end.
     1167       end.
     1168       else do:
     1169         for each buf_temp-diasize-handle
     1170         on error undo move_block, retry move_block
     1171         :
     1172           assign
     1173             v-object-handle = buf_temp-diasize-handle.handle-value
     1174           .
     1175           if v-object-handle <> v-diasize-resize-button
     1176           then do:
     1177             assign
     1178               v-object-handle :col = v-object-handle :col + p-change-value
     1179               no-error .
     1180             if error-status :error
     1181             or error-status :get-message(1) <> ""
     1182             then do:
     1183               undo move_block, retry move_block .
     1184             end.
     1185           end.
     1186         end.
     1187         for each buf_temp-browse-handle
     1188           where buf_temp-browse-handle.browse-type = 'width':u
     1189         on error undo move_block, retry move_block
     1190         :
     1191           assign
     1192             buf_temp-browse-handle.browse-handle :width
     1193               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1194             no-error .
     1195           if error-status :error
     1196           or error-status :get-message(1) <> ""
     1197           then do:
     1198             undo move_block, retry move_block .
     1199           end.
     1200         end.
     1201         assign
     1202           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1203           no-error .
     1204         if error-status :error
     1205         or error-status :get-message(1) <> ""
     1206         then do:
     1207           undo move_block, retry move_block.
     1208         end.
     1209         assign
     1210           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1211         no-error .
     1212         if error-status :error
     1213         or error-status :get-message(1) <> ""
     1214         then do:
     1215           undo move_block, retry move_block.
     1216         end.
     1217         if frame Dialog-Frame :scrollable = true
     1218         then do:
     1219           assign
     1220             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1221           no-error .
     1222           if error-status :error
     1223           or error-status :get-message(1) <> ""
     1224           then do:
     1225             undo move_block, retry move_block.
     1226           end.
     1227         end.
     1228       end.
     1229       if p-move-resize
     1230       then do:
     1231         run diasize_position-resize-button in this-procedure .
     1232       end.
     1233       if v-diasize-wndstore = true
     1234       then do:
     1235         if connected("ub") = true
     1236         then do:
     1237           define variable v-cntxt-db-num        as integer   no-undo .
     1238           define variable v-cntxt-userid        as character no-undo .
     1239           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1240                                             , OUTPUT v-cntxt-userid
     1241                                             ) .
     1242           run gbl/wndsizew.p
     1243             (input  v-cntxt-db-num
     1244             ,input  v-cntxt-userid
     1245             ,input  v-diasize-proc-name
     1246             ,input  'width':u
     1247             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1248             ) .
     1249         end.
     1250       end.
     1251     end.
     1252     assign
     1253       v-diasize-change-size = false
     1254     .
     1255   end procedure.
     1256   procedure diasize_set-width :
     1257     define input  parameter p-new-width  as decimal   no-undo .
     1258     define input  parameter p-move-resize as logical   no-undo .
     1259     do
     1260     on error undo, return error return-value
     1261     :
     1262       run diasize_change-width in this-procedure
     1263         (input  (p-new-width - frame Dialog-Frame :width)
     1264         ,input  p-move-resize
     1265         ) .
     1266     end.
     1267   end procedure.
     1268   procedure diasize_position-resize-button :
     1269     do with frame Dialog-Frame
     1270     :
     1271       hide v-diasize-resize-button .
     1272       assign
     1273         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1274                     - 1
     1275                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1276         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1277                     - 1
     1278                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1279       .
     1280       view v-diasize-resize-button .
     1281     end.
     1282   end procedure.
     1283   on alt-right anywhere
     1284   do:
     1285     run diasize_change-width in this-procedure
     1286       (input 1
     1287       ,input true
     1288       ) .
     1289     return no-apply .
     1290   end.
     1291   on alt-left anywhere
     1292   do:
     1293     run diasize_change-width in this-procedure
     1294       (input -1
     1295       ,input true
     1296       ) .
     1297     return no-apply .
     1298   end.
     1299   on alt-down anywhere
     1300   do:
     1301     run diasize_change-height in this-procedure
     1302       (input 1
     1303       ,input true
     1304       ) .
     1305     return no-apply .
     1306   end.
     1307   on alt-up anywhere
     1308   do:
     1309     run diasize_change-height in this-procedure
     1310       (input -1
     1311       ,input true
     1312       ) .
     1313     return no-apply .
     1314   end.
     1315   on alt-enter of frame Dialog-Frame
     1316   do:
     1317     run diasize_maximize in this-procedure
     1318       (input  ?
     1319       ).
     1320     return no-apply .
     1321   end.
     1322   procedure diasize_end-move :
     1323     do
     1324     on error undo, return error return-value
     1325     :
     1326       define variable v-row-delta as decimal   no-undo .
     1327       define variable v-col-delta as decimal   no-undo .
     1328       define variable v-new-row as decimal   no-undo .
     1329       define variable v-new-col as decimal   no-undo .
     1330       assign
     1331         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1332         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1333       .
     1334       assign
     1335         v-row-delta = v-new-row - frame Dialog-Frame :height
     1336         v-col-delta = v-new-col - frame Dialog-Frame :width
     1337       .
     1338       run diasize_change-height in this-procedure
     1339         (input v-row-delta
     1340         ,input true
     1341         ) .
     1342       run diasize_change-width in this-procedure
     1343         (input v-col-delta
     1344         ,input true
     1345         ) .
     1346     end.
     1347   end procedure.
     1348   procedure diasize_maximize :
     1349     define input  parameter p-action as logical   no-undo .
     1350     do
     1351     on error undo, return error return-value
     1352     :
     1353       if p-action = ?
     1354       then do:
     1355         if v-diasize-need-maximize = true
     1356         then do:
     1357           assign
     1358             p-action = true
     1359           .
     1360         end.
     1361         else do:
     1362           assign
     1363             p-action = false
     1364           .
     1365         end.
     1366       end.
     1367       if p-action = true
     1368       then do:
     1369         run diasize_change-height in this-procedure
     1370           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1371               - frame Dialog-Frame :height-chars
     1372           ,input true
     1373           ) .
     1374         run diasize_change-width in this-procedure
     1375           (input session :width-chars
     1376               - frame Dialog-Frame :width-chars
     1377           ,input true
     1378           ) .
     1379         assign
     1380           v-diasize-need-maximize = false
     1381         .
     1382       end.
     1383       else do:
     1384         run diasize_change-width in this-procedure
     1385           (input v-diasize-orig-frame-width
     1386               - frame Dialog-Frame :width-chars
     1387           ,input true
     1388           ) .
     1389         run diasize_change-height in this-procedure
     1390           (input v-diasize-orig-frame-height
     1391               - frame Dialog-Frame :height-chars
     1392           ,input true
     1393           ) .
     1394         assign
     1395           v-diasize-need-maximize = true
     1396         .
     1397       end.
     1398     end.
     1399   end procedure.
     1400   procedure diasize_restore-orig-size :
     1401     do
     1402     on error undo, return error return-value
     1403     :
     1404       assign
     1405         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1406         v-diasize-current-frame-height = frame Dialog-Frame :height
     1407       .
     1408       run diasize_set-height in this-procedure
     1409         (input  v-diasize-orig-frame-height
     1410         ,input  true
     1411         ) .
     1412       run diasize_set-width in this-procedure
     1413         (input  v-diasize-orig-frame-width
     1414         ,input  true
     1415         ) .
     1416     end.
     1417   end procedure.
     1418   procedure diasize_restore-current-size :
     1419     do
     1420     on error undo, return error return-value
     1421     :
     1422       run diasize_set-height in this-procedure
     1423         (input  v-diasize-current-frame-height
     1424         ,input  true
     1425         ) .
     1426       run diasize_set-width in this-procedure
     1427         (input  v-diasize-current-frame-width
     1428         ,input  true
     1429         ) .
     1430     end.
     1431   end procedure.
     1432   procedure diasize_set-browse-handle :
     1433     define input  parameter p-browse-handle as handle   no-undo .
     1434     define buffer buf_temp-browse-handle for temp-browse-handle .
     1435     do
     1436     on error undo, return error return-value
     1437     :
     1438       assign
     1439         v-diasize-browse-handle = p-browse-handle
     1440       .
     1441       for each buf_temp-browse-handle
     1442       on error undo, return error return-value
     1443       :
     1444         delete buf_temp-browse-handle .
     1445       end.
     1446     end.
     1447   end procedure.
     1448   procedure diasize_add_browse :
     1449     define input  parameter p-browse-type   as character no-undo .
     1450     define input  parameter p-browse-handle as handle    no-undo .
     1451     define buffer buf_temp-browse-handle for temp-browse-handle .
     1452     do
     1453     on error undo, return error return-value
     1454     :
     1455       assign
     1456         v-diasize-browse-number = v-diasize-browse-number + 1
     1457       .
     1458       create buf_temp-browse-handle .
     1459       assign
     1460         buf_temp-browse-handle.browse-type   = p-browse-type
     1461         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1462         buf_temp-browse-handle.browse-handle = p-browse-handle
     1463       .
     1464     end.
     1465   end procedure.
     1466   procedure diasize_init :
     1467     define variable v-default-value    as logical   no-undo .
     1468     define variable v-restore-saved    as logical   no-undo .
     1469     define variable v-resize-value-str as character no-undo .
     1470     do
     1471     on error undo, return error return-value
     1472     :
     1473       do with frame Dialog-Frame
     1474       :
     1475         assign
     1476           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1477           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1478           v-diasize-browse-handle     = browse BR-dtl :handle
     1479         .
     1480         create button v-diasize-resize-button
     1481         assign
     1482           parent        = frame Dialog-Frame :first-child
     1483           label         = "s"
     1484           height-pixels = 16
     1485           width-pixels  = 16
     1486           visible       = true
     1487           sensitive     = true
     1488           movable       = true
     1489           triggers:
     1490             on end-move persistent run diasize_end-move in this-procedure .
     1491           end triggers.
     1492         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1493         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1494         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1495         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1496         assign
     1497           v-diasize-wndmax = false
     1498         .
     1499         if connected("ub") = true
     1500         then do:
     1501           define variable v-cntxt-db-num        as integer   no-undo .
     1502           define variable v-cntxt-userid        as character no-undo .
     1503           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1504                                             , OUTPUT v-cntxt-userid
     1505                                             ) .
     1506           run gbl/wndpar_r.p
     1507             (input  v-cntxt-db-num
     1508             ,input  v-cntxt-userid
     1509             ,input  'wndmax':U
     1510             ,output v-diasize-wndmax
     1511             ,output v-default-value
     1512             ) .
     1513         end.
     1514         assign
     1515           v-diasize-wndstore = false
     1516         .
     1517         if connected("ub") = true
     1518         then do:
     1519           run gbl/wndpar_r.p
     1520             (input  v-cntxt-db-num
     1521             ,input  v-cntxt-userid
     1522             ,input  'wndstore':U
     1523             ,output v-diasize-wndstore
     1524             ,output v-default-value
     1525             ) .
     1526         end.
     1527         assign
     1528           v-diasize-proc-name = entry(1, program-name(2), '.')
     1529         .
     1530         if v-diasize-wndstore = true
     1531         then do:
     1532           assign
     1533             v-restore-saved = false
     1534           .
     1535           if connected("ub") = true
     1536           then do:
     1537             run gbl/wndsizer.p
     1538               (input  v-cntxt-db-num
     1539               ,input  v-cntxt-userid
     1540               ,input  v-diasize-proc-name
     1541               ,input  'height':u
     1542               ,output v-resize-value-str
     1543               ) .
     1544             if v-resize-value-str <> '':U
     1545             then do:
     1546               run diasize_change-height in this-procedure
     1547                 (input  integer(v-resize-value-str)
     1548                 ,input  true
     1549                 ) .
     1550               assign
     1551                 v-restore-saved = true
     1552               .
     1553             end.
     1554           end.
     1555           if connected("ub") = true
     1556           then do:
     1557             run gbl/wndsizer.p
     1558               (input  v-cntxt-db-num
     1559               ,input  v-cntxt-userid
     1560               ,input  v-diasize-proc-name
     1561               ,input  'width':u
     1562               ,output v-resize-value-str
     1563               ) .
     1564             if v-resize-value-str <> '':U
     1565             then do:
     1566               run diasize_change-width in this-procedure
     1567                 (input  integer(v-resize-value-str)
     1568                 ,input  true
     1569                 ) .
     1570               assign
     1571                 v-restore-saved = true
     1572               .
     1573             end.
     1574           end.
     1575           if v-restore-saved <> true
     1576           then do:
     1577             if v-diasize-wndmax = true
     1578             then do:
     1579               run diasize_maximize in this-procedure
     1580                 (input  true
     1581                 ) .
     1582             end.
     1583           end.
     1584         end.
     1585         else do:
     1586           if v-diasize-wndmax = true
     1587           then do:
     1588             run diasize_maximize in this-procedure
     1589               (input  true
     1590               ) .
     1591           end.
     1592         end.
     1593       end.
     1594     end.
     1595   end procedure.
     1596   procedure diasize_need-full-display :
     1597     define output parameter p-need-full-display as logical   no-undo .
     1598     do
     1599     on error undo, return error return-value
     1600     :
     1601       assign
     1602         p-need-full-display = v-diasize-need-full-display
     1603       .
     1604       assign
     1605         v-diasize-need-full-display = false
     1606       .
     1607     end.
     1608   end procedure.
     1609   procedure get-context :
     1610      define output parameter p-db-num as integer          no-undo.
     1611      define output parameter p-user-id as character        no-undo.
     1612      define variable v-login               as character    no-undo.
     1613      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1614      define buffer buf_user-login  for ub.user-login .
     1615      do
     1616      on error undo, return error
     1617      :
     1618            FIND FIRST buf_sys-ctrl no-lock.
     1619            ASSIGN
     1620               v-login = USERID("ub")
     1621               p-db-num = buf_sys-ctrl.db-num
     1622            .
     1623            FIND FIRST buf_user-login
     1624                 WHERE buf_user-login.db-num = p-db-num
     1625                   AND buf_user-login.user-login = v-login
     1626                 no-lock
     1627                 no-error
     1628                 .
     1629            IF AVAILABLE buf_user-login
     1630            THEN DO:
     1631               assign
     1632                  p-user-id = buf_user-login.user-id
     1633               .
     1634            END.
     1635      end.
     1636   end procedure.
     1637       run diasize_init in this-procedure .
     1638   MAIN-BLOCK:
     1639   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1640      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1641   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1642     run mainmenu_getcntxt in parparentproc
     1643       (output v-cntxt-db-num
     1644       ,output v-cntxt-userid
     1645       ,output v-cntxt-level
     1646       ,output v-cntxt-host-code-obj
     1647       ,output v-cntxt-obj-type
     1648       ,output v-cntxt-obj-code
     1649       ,output v-cntxt-db-num-obj
     1650       ,output v-cntxt-is-admin
     1651       ) .
     1652     if par-mode <> 'ПРОСМОТР':U then do:
     1653         message vss-workfile vss-revision vss-description skip
     1654                     "Неверный параметр вызова par-mode"
     1655         view-as alert-box ERROR.
     1656         return error.
     1657     end.
     1658     if par-mode = 'ПРОСМОТР':U then do:
     1659           FIND FIRST buf_c-wth-line No-LOCK WHERE
     1660                      recid(buf_c-wth-line) = parline-rec No-ERROR.
     1661     end.
     1662     FIND FIRST buf_c-wth-doc No-LOCK WHERE
     1663                buf_c-wth-doc.doc-code = pardoc-code No-ERROR.
     1664     IF NOT AVAIL buf_c-wth-doc THEN DO:
     1665       MESSAGE  "Не найден документ движения МЦ"
     1666       VIEW-AS ALERT-BOX ERROR.
     1667       RETURN error.
     1668     END.
     1669     if LOOKUP(buf_c-wth-doc.doc-type, "при,рас,спи") = 0 then do:
     1670       MESSAGE
     1671       vss-workfile vss-revision vss-description skip
     1672       "Неверный вызов - документ МЦ имеет тип" buf_c-wth-doc.doc-type
     1673       VIEW-AS ALERT-BOX ERROR.
     1674       RETURN error.
     1675     end.
     1676     vardoc-status_ = buf_c-wth-doc.status_.
     1677     FIND FIRST buf_wealth No-LOCK WHERE
     1678                 buf_wealth.wth-code = parwth-code NO-ERROR.
     1679     IF NOT AVAIL buf_wealth THEN DO:
     1680         MESSAGE
     1681           "Не найдена материальная ценность в справочнике!"
     1682         VIEW-AS ALERT-BOX ERROR.
     1683         RETURN error.
     1684     END.
     1685     run fill-tables in this-Procedure no-error.
     1686     if error-status:error then return error.
     1687     RUN Myenable.
     1688     WAIT-FOR GO OF FRAME Dialog-Frame.
     1689   END.
     1690   RUN disable_UI.
     1691   PROCEDURE disable_UI :
     1692     HIDE FRAME Dialog-Frame.
     1693   END PROCEDURE.
     1694   PROCEDURE enable_UI :
     1695     OPEN QUERY Dialog-Frame FOR EACH buf_c-wth-line SHARE-LOCK.
     1696     GET FIRST Dialog-Frame.
     1697     DISPLAY for-d_doc-sum for-d_fact-sum
     1698         WITH FRAME Dialog-Frame.
     1699     IF AVAILABLE ub.c-wth-line THEN
     1700       DISPLAY ub.c-wth-line.doc-sum ub.c-wth-line.fact-sum
     1701         WITH FRAME Dialog-Frame.
     1702     ENABLE b-quit B-par B-Help BR-dtl ub.c-wth-line.doc-sum
     1703            ub.c-wth-line.fact-sum for-d_doc-sum for-d_fact-sum
     1704         WITH FRAME Dialog-Frame.
     1705     VIEW FRAME Dialog-Frame.
     1706   END PROCEDURE.
     1707   PROCEDURE fill-tables :
     1708   if not can-find(first tt-par-dtl) then do:
     1709       FOR EACH ub.wth-par NO-LOCK WHERE
     1710                ub.wth-par.wth-code = buf_wealth.wth-code :
     1711         FIND FIRST tt-par-dtl WHERE
     1712                    tt-par-dtl.par-code = ub.wth-par.par-code NO-ERROR.
     1713         IF NOT AVAIL tt-par-dtl THEN DO:
     1714           CREATE tt-par-dtl.
     1715           ASSIGN
     1716             tt-par-dtl.par-code = ub.wth-par.par-code
     1717             tt-par-dtl.par-val  = ub.wth-par.par-val
     1718             tt-par-dtl.par-unit = ub.wth-par.par-unit
     1719             tt-par-dtl.par-feat = ub.wth-par.par-feat
     1720             tt-par-dtl.par-rate = ub.wth-par.par-rate / ub.wth-par.par-val
     1721             tt-par-dtl.q-ty-doc = 0
     1722             tt-par-dtl.doc-sum  = 0
     1723             tt-par-dtl.q-ty-fact = 0
     1724             tt-par-dtl.fact-sum  = 0
     1725           .
     1726         END.
     1727       END.
     1728       FOR EACH ub.c-wth-dtl NO-LOCK WHERE
     1729               ub.c-wth-dtl.doc-code = pardoc-code
     1730           AND ub.c-wth-dtl.wth-code = parwth-code
     1731           AND ub.c-wth-dtl.w-p-code = parw-p-code
     1732           AND ub.c-wth-dtl.corr-user-db-num = parCorr-user-db-num
     1733           AND ub.c-wth-dtl.chip-num = parCHip-num
     1734       BY
     1735       ub.c-wth-dtl.par-code :
     1736         FIND FIRST tt-par-dtl WHERE
     1737                    tt-par-dtl.par-code = ub.c-wth-dtl.par-code NO-ERROR.
     1738         IF NOT AVAIL tt-par-dtl THEN DO:
     1739           NEXT.
     1740         END.
     1741         IF buf_c-wth-doc.doc-type = 'инв':U THEN DO:
     1742           ASSIGN
     1743           tt-par-dtl.doc-sum = ub.c-wth-dtl.bef-sum
     1744           tt-par-dtl.fact-sum = ub.c-wth-dtl.aft-sum
     1745           .
     1746         END.
     1747         ELSE DO:
     1748           ASSIGN
     1749           tt-par-dtl.doc-sum = ub.c-wth-dtl.doc-sum
     1750           tt-par-dtl.fact-sum = ub.c-wth-dtl.fact-sum.
     1751         END.
     1752         ASSIGN
     1753         tt-par-dtl.q-ty-doc = tt-par-dtl.doc-sum / (tt-par-dtl.par-val * tt-par-dtl.par-rate)
     1754         tt-par-dtl.q-ty-fact = tt-par-dtl.fact-sum / (tt-par-dtl.par-val * tt-par-dtl.par-rate)
     1755         d_doc-sum   = d_doc-sum      + tt-par-dtl.doc-sum
     1756         d_fact-sum   = d_fact-sum      + tt-par-dtl.fact-sum
     1757         .
     1758       END.
     1759   end.
     1760   else do:
     1761   FOR EACH ub.c-wth-dtl NO-LOCK WHERE
     1762               ub.c-wth-dtl.doc-code = pardoc-code
     1763           AND ub.c-wth-dtl.wth-code = parwth-code
     1764           AND ub.c-wth-dtl.w-p-code = parw-p-code
     1765           AND ub.c-wth-dtl.corr-user-db-num = parcorr-user-db-num
     1766           AND ub.c-wth-dtl.chip-num = parCHip-num
     1767       BY
     1768       ub.c-wth-dtl.par-code :
     1769         FIND FIRST tt-par-dtl WHERE
     1770                    tt-par-dtl.par-code = ub.c-wth-dtl.par-code NO-ERROR.
     1771         IF NOT AVAIL tt-par-dtl THEN DO:
     1772           NEXT.
     1773         END.
     1774          ASSIGN
     1775         d_doc-sum   = d_doc-sum      + tt-par-dtl.doc-sum
     1776         d_fact-sum   = d_fact-sum      + tt-par-dtl.fact-sum
     1777         .
     1778   END.
     1779   end.
     1780   END PROCEDURE.
     1781   PROCEDURE MyEnable :
     1782   IF par-mode = 'ПРОСМОТР':U THEN DO:
     1783     ASSIGN
     1784     tt-par-dtl.q-ty-doc:READ-ONLY IN BROWSE BR-dtl = YES
     1785     tt-par-dtl.q-ty-fact:READ-ONLY IN BROWSE BR-dtl = YES
     1786     .
     1787   END.
     1788     ASSIGN FRAME Dialog-Frame:TITLE = CAPS( buf_wealth.wth-name ) + " (номиналы)".
     1789     DISPLAY
     1790     d_doc-sum @ for-d_doc-sum
     1791     d_fact-sum @ for-d_fact-sum
     1792     WITH FRAME Dialog-Frame.
     1793     DISPLAY
     1794     pardoc-sum @ ub.c-wth-line.doc-sum
     1795     parfact-sum @ ub.c-wth-line.fact-sum
     1796     WITH FRAME Dialog-Frame.
     1797     ENABLE
     1798     b-quit
     1799     b-help
     1800     B-Par
     1801     BR-dtl
     1802     WITH FRAME Dialog-Frame.
     1803     CASE  buf_c-wth-doc.status_:
     1804           when 'накл':U then dO:
     1805               tt-par-dtl.q-ty-fact:READ-ONLY IN BROWSE BR-dtl = YES.
     1806               HIDE
     1807               c-wth-line.fact-sum
     1808               for-d_fact-sum
     1809               in frame Dialog-Frame .
     1810           end.
     1811           when 'разрешен':U then do:
     1812                tt-par-dtl.q-ty-doc:READ-ONLY IN BROWSE BR-dtl = YES.
     1813           end.
     1814       end CASE.
     1815     if buf_wealth.is-ser = 1 then do:
     1816       enable b-parts
     1817       with frame Dialog-Frame.
     1818     end.
     1819     VIEW FRAME Dialog-Frame.
     1820     OPEN QUERY BR-dtl FOR EACH tt-par-dtl USE-INDEX tt-i1.
     1821   END PROCEDURE.
