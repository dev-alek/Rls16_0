        1   block-level on error undo, throw.
        2   define parameter buffer doc-line for ub.doc-line.
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   define new global shared variable g#lib-trn  as handle no-undo .
        8   define new global shared variable g#lib-trn2 as handle no-undo .
        9   define new global shared variable g#lib-trn3 as handle no-undo .
       10   define new global shared variable g#lib-trn4 as handle no-undo .
       11   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       12   define new global shared variable g#trdcalib as handle no-undo.
       13   define variable varinvclcspvalue                    as   character no-undo.
       14   define variable varinvclcsptype                     as   character no-undo.
       15   define variable varinvclcwtol                       as   logical   no-undo.
       16   define variable prtvalue   as character no-undo.
       17   define variable partsvalue as character initial ?   no-undo.
       18   define variable varr-b     as character no-undo.
       19   define variable is-cdinv   as character no-undo .
       20   define variable p-value as character no-undo.
       21   define variable p-type  as character no-undo.
       22   find first trn-doc where trn-doc.doc-code = doc-line.doc-code.
       23   assign
       24     varinvclcspvalue = "no".
       25   run str/invdcfrd.p (input  trn-doc.doc-code,
       26                   output varinvclcspvalue,
       27                   output prtvalue,
       28                   output varr-b,
       29                   output is-cdinv ).
       30   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trn-doc.doc-code ,
       31                           input 'clcaswt':U ,
       32                          output p-value ,
       33                          output p-type )  .
       34   assign
       35     varinvclcwtol = (if p-value = "yes" then yes else no).
       36   run trg/rsrv-del.p
       37     (input doc-line.doc-code
       38     ,input doc-line.artic
       39     ,input doc-line.prod-type
       40     ,input doc-line.prod-code
       41     ) .
       42   for each gds-dtl where gds-dtl.doc-code  = doc-line.doc-code  and
       43                          gds-dtl.artic     = doc-line.artic     and
       44                          gds-dtl.prod-type = doc-line.prod-type and
       45                          gds-dtl.prod-code = doc-line.prod-code on error undo, return error return-value :
       46     delete gds-dtl.
       47   end.
       48   delete doc-line.
       49   if trn-doc.status_ = 'разрешен':U and
       50      trn-doc.flag_   = no           then do:
       51   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:   run str/lib-trn2.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:     message       "Error starting lib-trn2.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn2_reclctsl in g#lib-trn2
       52   (input trn-doc.doc-code,
       53    input 'bd':U
       54   )
       55   .
       56     if varinvclcwtol then do:
       57   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:   run str/lib-trn2.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:     message       "Error starting lib-trn2.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn2_reclctsl in g#lib-trn2
       58   (input trn-doc.doc-code,
       59    input 'wst':U
       60   )
       61   .
       62     end.
       63     if varinvclcspvalue = "yes" then do:
       64   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:   run str/lib-trn2.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:     message       "Error starting lib-trn2.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn2_reclctsl in g#lib-trn2
       65   (input trn-doc.doc-code,
       66    input 'bcd':U
       67   )
       68   .
       69       if varinvclcwtol then do:
       70   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:   run str/lib-trn2.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:     message       "Error starting lib-trn2.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn2_reclctsl in g#lib-trn2
       71   (input trn-doc.doc-code,
       72    input 'wstc':U
       73   )
       74   .
       75       end.
       76     end.
       77   end.
