     1586   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1587   define variable v-is-closed-shift-journal as integer no-undo .
     1588   assign
     1589   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1590                               +
     1591                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1592                               +
     1593                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1594   .
     1595   return v-is-closed-shift-journal.
     1596   END FUNCTION.
     1597   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1598   define variable v-is-first-journal as logical no-undo .
     1599   assign
     1600   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1601                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1602                     or (p-journal-num =  integer(entry(1, '17':U)))
     1603                     or (p-journal-num = integer(entry(1, '16':U)))
     1604   .
     1605   return v-is-first-journal.
     1606   END FUNCTION.
     1607   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1608   define variable v-is-petrol-journal as logical no-undo .
     1609   assign
     1610   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1611   return v-is-petrol-journal.
     1612   END FUNCTION.
     1613   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1614   define variable v-max-record-num as integer no-undo .
     1615   assign
     1616   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1617                       then 1489
     1618                       else 2340).
     1619   return v-max-record-num.
     1620   END FUNCTION.
     1621   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1622   define variable v-max-record-num as integer no-undo .
     1623   assign
     1624   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1625                       then 1489 * num-entries('30,31,32,33':U)
     1626                       else 2340 * num-entries('17':U)).
     1627   return v-max-record-num.
     1628   END FUNCTION.
     1629   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1630                                           ,input p-rec-no as integer):
     1631   define variable v-num-recs as integer no-undo .
     1632   if tekka-is-petrol-journal (p-journal-num) then do:
     1633     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1634       assign
     1635       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1636       .
     1637     end.
     1638     else do:
     1639       assign
     1640       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1641       .
     1642     end.
     1643   end.
     1644   else do:
     1645     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1646       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1647         assign
     1648         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1649         .
     1650       end.
     1651       else do:
     1652         assign
     1653         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1654         .
     1655       end.
     1656     end.
     1657     else do:
     1658       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1659         assign
     1660         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1661         .
     1662       end.
     1663       else do:
     1664         assign
     1665         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1666         .
     1667       end.
     1668     end.
     1669   end.
     1670   return v-num-recs.
     1671   END FUNCTION.
     1672   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1673                                              ,input p-is-petrol as logical
     1674                                              ,input p-is-current as logical
     1675                                              ,output p-rec-no as decimal
     1676                                              ):
     1677   define variable v-obj-num0 as integer no-undo .
     1678   define variable v-obj-num as integer no-undo .
     1679   define variable v-obj-num2 as integer no-undo .
     1680   define variable p-num-recs2 as integer no-undo .
     1681   define variable p-rec-no2 as integer no-undo .
     1682   if p-is-petrol then do:
     1683     assign
     1684     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1685     .
     1686     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1687     then
     1688     assign
     1689     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1690     p-rec-no = p-num-recs modulo 1489
     1691     .
     1692     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1693     then
     1694     assign
     1695     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1696     p-rec-no = p-num-recs modulo 1489
     1697     .
     1698   end.
     1699   else do:
     1700     assign
     1701     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1702     p-num-recs = trunc(p-num-recs, 0)
     1703     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1704     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1705     .
     1706     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1707     then
     1708     assign
     1709     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1710     p-rec-no = p-num-recs modulo 2340
     1711     .
     1712     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1713     then
     1714     assign
     1715     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1716     p-rec-no = p-num-recs modulo 2340
     1717     .
     1718     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1719     then
     1720     assign
     1721     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1722     p-rec-no2 = p-num-recs2 modulo 2978
     1723     .
     1724     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1725     then
     1726     assign
     1727     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1728     p-rec-no2 = p-num-recs2 modulo 2978
     1729     .
     1730     assign
     1731     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1732     .
     1733   end.
     1734   if v-obj-num = 0 then v-obj-num = 100.
     1735   return v-obj-num.
     1736   END FUNCTION.
     1737   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1738   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1739   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1740      if p-is-ptrl then
     1741      return integer(entry(1, '26,27,28,29':U)).
     1742      if not p-is-ptrl then
     1743      return integer(entry(1, '16':U)).
     1744   end.
     1745   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1746   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1747   return 0.
     1748   END FUNCTION.
     1749   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1750   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1751   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1752     if p-is-ptrl then
     1753     return integer(entry(1, '26,27,28,29':U)).
     1754     if not p-is-ptrl then
     1755     return integer(entry(1, '16':U)).
     1756   end.
     1757   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1758   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1759   return 0.
     1760   END FUNCTION.
     1761   PROCEDURE maria-put:
     1762   define parameter buffer buf_cash-desk for ub.cash-desk.
     1763   define input parameter p-out    as character no-undo .
     1764   define input parameter p-fname as character no-undo .
     1765   define input parameter p-by-record as logical no-undo .
     1766   define input parameter p-shift-fields as integer no-undo .
     1767   define input parameter p-binary as logical no-undo .
     1768   define input parameter p-obj-num as integer no-undo .
     1769   define input parameter p-max-records as integer no-undo .
     1770   define input parameter p-plu as integer no-undo .
     1771   define input parameter p-value as character no-undo .
     1772   define variable v-file-name as character no-undo .
     1773   define variable v-create as logical no-undo .
     1774   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1775   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     1776   output stream IBMSTREAM
     1777   to value(v-file-name) append .
     1778   Put  stream IBMSTREAM unformatted
     1779   p-plu
     1780   chr(3)
     1781   p-value
     1782   skip.
     1783   output stream IBMSTREAM
     1784   close.
     1785   if not p-by-record then do:
     1786     find first buf_temp-tekka-tsk where
     1787               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1788     if not available buf_temp-tekka-tsk then do:
     1789       v-create = yes.
     1790     end.
     1791   end.
     1792   else do:
     1793     find first buf_temp-tekka-tsk where
     1794               buf_temp-tekka-tsk.filename  = v-file-name
     1795           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     1796     if not available buf_temp-tekka-tsk
     1797     then do:
     1798       find first buf_temp-tekka-tsk where
     1799                 buf_temp-tekka-tsk.filename  = v-file-name
     1800             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     1801       if not available buf_temp-tekka-tsk
     1802       then do:
     1803         v-create = yes.
     1804       end.
     1805     end.
     1806   end.
     1807   if v-create then do:
     1808     create buf_temp-tekka-tsk.
     1809     assign
     1810     buf_temp-tekka-tsk.filename = v-file-name
     1811     buf_temp-tekka-tsk.range    = p-plu
     1812     buf_temp-tekka-tsk.obj-num = p-obj-num
     1813     buf_temp-tekka-tsk.obj-name = '':U
     1814     buf_temp-tekka-tsk.num-records = 0
     1815     buf_temp-tekka-tsk.max-records = p-max-records
     1816     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     1817     buf_temp-tekka-tsk.task-num = p-fname
     1818     buf_temp-tekka-tsk.by-record = p-by-record
     1819     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     1820     buf_temp-tekka-tsk.binary = p-binary
     1821     buf_temp-tekka-tsk.send-get = 'send'
     1822     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1823     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1824     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1825     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1826                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1827                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1828                                 then 'local'
     1829                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1830     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1831     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1832     buf_temp-tekka-tsk.waiting-sek = 30
     1833     buf_temp-tekka-tsk.min-plu     = p-plu
     1834     buf_temp-tekka-tsk.max-plu     = p-plu
     1835     .
     1836   end.
     1837   assign
     1838   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     1839   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     1840   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     1841   .
     1842   END PROCEDURE.
     1843   PROCEDURE maria-get:
     1844   define parameter buffer buf_cash-desk for ub.cash-desk.
     1845   define input parameter p-out    as character no-undo .
     1846   define input parameter p-fname as character no-undo .
     1847   define input parameter p-by-record as logical no-undo .
     1848   define input parameter p-obj-num as integer no-undo .
     1849   define input parameter p-num-fields as integer no-undo .
     1850   define input parameter p-max-records as integer no-undo .
     1851   define input parameter p-min-plu as integer no-undo .
     1852   define input parameter p-max-plu as integer no-undo .
     1853   define input parameter p-other as character no-undo .
     1854   define input parameter p-order-num as integer no-undo .
     1855   define variable v-file-name as character no-undo .
     1856   define variable v-secondary-obj-num as character no-undo .
     1857   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1858   if p-by-record then do:
     1859     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     1860   end.
     1861   else do:
     1862     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     1863   end.
     1864   find first buf_temp-tekka-tsk where
     1865             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1866   if not available buf_temp-tekka-tsk then do:
     1867     create buf_temp-tekka-tsk.
     1868     assign
     1869     buf_temp-tekka-tsk.filename = v-file-name
     1870     buf_temp-tekka-tsk.obj-num = p-obj-num
     1871     buf_temp-tekka-tsk.obj-name = '':U
     1872     buf_temp-tekka-tsk.max-records = p-max-records
     1873     buf_temp-tekka-tsk.num-fields = p-num-fields
     1874     buf_temp-tekka-tsk.task-num = p-fname
     1875     buf_temp-tekka-tsk.by-record = p-by-record
     1876     buf_temp-tekka-tsk.send-get = 'get'
     1877     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1878     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1879     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1880     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1881                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1882                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1883                                   then 'local'
     1884                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1885     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1886     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1887     buf_temp-tekka-tsk.waiting-sek = 30
     1888     buf_temp-tekka-tsk.min-plu     = p-min-plu
     1889     buf_temp-tekka-tsk.max-plu     = p-max-plu
     1890     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     1891                                       and p-max-plu <> ?
     1892                                       then p-max-plu - p-min-plu + 1
     1893                                       else 0)
     1894     buf_temp-tekka-tsk.other-info = p-other
     1895     buf_temp-tekka-tsk.order-num = p-order-num
     1896     .
     1897     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     1898       assign
     1899       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     1900       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     1901       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     1902       no-error
     1903       .
     1904       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     1905     end.
     1906   end.
     1907   END PROCEDURE.
     1908   PROCEDURE maria-task:
     1909   define parameter buffer buf_cash-desk for ub.cash-desk.
     1910   define input parameter p-fname as character no-undo .
     1911   define input parameter p-obj-num-list as character no-undo .
     1912   define input parameter p-parameters as character no-undo .
     1913   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1914   find first buf_temp-tekka-tsk where
     1915             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     1916   if not available buf_temp-tekka-tsk then do:
     1917     create buf_temp-tekka-tsk.
     1918     assign
     1919     buf_temp-tekka-tsk.filename = ''
     1920     buf_temp-tekka-tsk.range = 1
     1921     buf_temp-tekka-tsk.obj-num = 0
     1922     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     1923     buf_temp-tekka-tsk.task-num = p-fname
     1924     buf_temp-tekka-tsk.by-record = no
     1925     buf_temp-tekka-tsk.send-get = 'task'
     1926     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1927     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1928     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1929     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1930                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1931                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1932                                   then 'local'
     1933                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1934     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1935     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1936     buf_temp-tekka-tsk.waiting-sek = 30
     1937     buf_temp-tekka-tsk.other-info = p-parameters
     1938     buf_temp-tekka-tsk.order-num = 0
     1939     .
     1940   end.
     1941   END PROCEDURE.
     1942   procedure tekkatsk-verify-schema :
     1943   define input parameter p-obj-list as character no-undo .
     1944   define input parameter p-dir-path as character no-undo .
     1945   define variable v-obj-num as integer no-undo .
     1946   define variable v-obj-name as character no-undo .
     1947   define variable v-num-records as integer no-undo .
     1948   define variable v-size_ as integer no-undo .
     1949   define variable v-value as character no-undo .
     1950   define variable ii as integer no-undo .
     1951   define variable jj as integer no-undo .
     1952   define variable ii-ibs as integer no-undo .
     1953   define variable ii-tekka as integer no-undo .
     1954   define variable v-result as character no-undo .
     1955   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1956   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1957     do
     1958     on error undo, return error
     1959     :
     1960        for each buf_temp-tekka-schema:
     1961          delete buf_temp-tekka-schema.
     1962        end.
     1963        input from value('tekkasch.d').
     1964        repeat :
     1965          create buf_temp-tekka-schema.
     1966          import buf_temp-tekka-schema.
     1967          assign
     1968          buf_temp-tekka-schema.host = 'IBS'
     1969          ii = ii + 1.
     1970          .
     1971        end.
     1972        input close.
     1973        ii-ibs = ii.
     1974         _ii:
     1975         do ii = 1 to 256:
     1976           if p-obj-list = "ALL"
     1977           or lookup(string(ii), p-obj-list) > 0 then do:
     1978             assign
     1979             v-obj-num = 0
     1980             v-obj-name = ''
     1981             v-num-records = 0
     1982             v-size_ = 0
     1983             .
     1984             run alienini-getkey in this-procedure (
     1985                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1986                                                     ,input ('obj' + string(ii, '999'))
     1987                                                     ,input 'oname'
     1988                                                     ,output v-value) no-error .
     1989             if v-value = ? then next _ii.
     1990             assign
     1991             v-obj-num = ii
     1992             v-obj-name = v-value
     1993             .
     1994             run alienini-getkey in this-procedure (
     1995                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1996                                                     ,input ('obj' + string(ii, '999'))
     1997                                                     ,input 'size'
     1998                                                     ,output v-value) no-error .
     1999             assign
     2000             v-num-records = integer(v-value) no-error  .
     2001             if error-status:error
     2002             or v-num-records = 0 then next _ii.
     2003             run alienini-getkey in this-procedure (
     2004                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2005                                                     ,input 'obj' + string(ii, '999')
     2006                                                     ,input 'f000'
     2007                                                     ,output v-value) no-error .
     2008             assign
     2009             v-size_ = integer(v-value) no-error  .
     2010             if error-status:error
     2011             or v-size_ = 0 then next _ii.
     2012             _jj:
     2013             do jj = 1 to 256:
     2014               run alienini-getkey in this-procedure (
     2015                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2016                                                       ,input 'obj' + string(ii, '999')
     2017                                                       ,input 'f' + string(jj, '999')
     2018                                                       ,output v-value) no-error .
     2019               if v-value = ? then next _ii.
     2020               create buf_temp-tekka-schema.
     2021               assign
     2022               buf_temp-tekka-schema.host = 'tekka'
     2023               buf_temp-tekka-schema.obj-num = v-obj-num
     2024               buf_temp-tekka-schema.obj-name = v-obj-name
     2025               buf_temp-tekka-schema.num-records = v-num-records
     2026               buf_temp-tekka-schema.size_ = v-size_
     2027               buf_temp-tekka-schema.field-num = jj
     2028               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2029               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2030                                                  then entry(2, entry(2, v-value, '#'), ':')
     2031                                                  else '':U)
     2032               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2033               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2034               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2035                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2036               no-error
     2037               .
     2038               if error-status:error then do:
     2039                 delete buf_temp-tekka-schema.
     2040                 next _jj.
     2041               end.
     2042               run alienini-getkey in this-procedure (
     2043                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2044                                                       ,input 'obj' + string(ii, '999') + 'name'
     2045                                                       ,input 'n' + string(jj, '999')
     2046                                                       ,output v-value) no-error .
     2047               if v-value <> ? then
     2048               buf_temp-tekka-schema.field-name = v-value.
     2049             end.
     2050           end.
     2051         end.
     2052         ii-tekka = ii - 1.
     2053        if p-obj-list <> 'ALL' then do:
     2054         if ii-tekka <> ii-ibs then do:
     2055           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2056                                   , ii-ibs
     2057                                   , ii-tekka).
     2058         end.
     2059        end.
     2060        for each buf_temp-tekka-schema where
     2061               buf_temp-tekka-schema.host = 'tekka':
     2062          find first buf2_temp-tekka-schema where
     2063                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2064                AND buf2_temp-tekka-schema.host = 'ibs'
     2065                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2066          if not available buf2_temp-tekka-schema then do:
     2067           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2068                                   , buf_temp-tekka-schema.field-num
     2069                                   , buf_temp-tekka-schema.obj-num).
     2070          end.
     2071          buffer-compare buf_temp-tekka-schema
     2072          to buf2_temp-tekka-schema
     2073          save result in v-result.
     2074          if v-result <> '':U then do:
     2075           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2076                                   , buf_temp-tekka-schema.field-num
     2077                                   , buf_temp-tekka-schema.obj-num).
     2078          end.
     2079        end.
     2080     end.
     2081   end procedure.
     2082   FUNCTION set-Sx returns character (input p-string as character):
     2083   return p-string.
     2084   END FUNCTION.
     2085   FUNCTION get-Sx returns character (input p-string  as character):
     2086   return p-string.
     2087   END FUNCTION.
     2088   FUNCTION set-B returns character (input p-string  as character):
     2089   return chr(integer(p-string)).
     2090   END FUNCTION.
     2091   FUNCTION get-B returns character (input p-string  as character):
     2092   return string(asc(p-string)).
     2093   END FUNCTION.
     2094   FUNCTION set-BF returns character (input p-string  as character):
     2095   define variable v-dopi as integer no-undo .
     2096   define variable ii as integer no-undo .
     2097   do ii = 1 to 8:
     2098     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2099   end.
     2100   return chr(v-dopi).
     2101   END FUNCTION.
     2102   FUNCTION get-BF returns character (input p-string  as character):
     2103   define variable v-dopi as integer no-undo .
     2104   define variable v-dops as character no-undo .
     2105   define variable ii as integer no-undo .
     2106   v-dopi = asc(p-string).
     2107   do ii = 8 to 1 BY -1:
     2108     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2109   end.
     2110   return v-dops.
     2111   END FUNCTION.
     2112   FUNCTION set-BN returns character (input p-string  as character
     2113                                     ,input p-bin-group as character):
     2114   define variable v-dopi as integer no-undo .
     2115   define variable ii as integer no-undo .
     2116   define variable jj as integer no-undo .
     2117   define variable v-grp-nums as integer no-undo .
     2118   define variable v-dopi2 as integer no-undo .
     2119   v-grp-nums = num-entries(p-bin-group).
     2120   do jj = 0 to v-grp-nums - 1:
     2121     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     2122     do ii = 1 to 8:
     2123       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2124     end.
     2125   end.
     2126   return chr(v-dopi).
     2127   END FUNCTION.
     2128   FUNCTION get-BN returns character (input p-string  as character
     2129                                     ,input p-bin-group as character):
     2130   define variable v-dopi as integer no-undo .
     2131   define variable v-dops as character no-undo .
     2132   define variable v-grp-nums as integer no-undo .
     2133   define variable ii as integer no-undo .
     2134   define variable jj as integer no-undo .
     2135   v-dopi = asc(p-string).
     2136   v-grp-nums = num-entries(p-bin-group).
     2137   do jj = 1 to v-grp-nums:
     2138   do ii = 8 to 1 BY -1:
     2139     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2140   end.
     2141   end.
     2142   return v-dops.
     2143   END FUNCTION.
     2144   procedure fill-temp-cd :
     2145   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     2146   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2147   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2148   define input parameter p-clear-table as logical no-undo .
     2149   define buffer buf_temp-cd for temp-cd.
     2150   define buffer buf_cash-desk for ub.cash-desk.
     2151     do
     2152     on error undo, return error
     2153     :
     2154        if p-clear-table  then do:
     2155          for each buf_temp-cd:
     2156            delete buf_temp-cd.
     2157          end.
     2158        end.
     2159        for each buf_cash-desk no-lock where
     2160               buf_cash-desk.db-num = p-db-num
     2161           AND buf_cash-desk.obj-code = p-obj-code
     2162           and buf_cash-desk.cash-on  = yes
     2163        BREAK by buf_cash-desk.pos-type:
     2164          if first-of(buf_cash-desk.pos-type) then do:
     2165            create buf_temp-cd.
     2166            buffer-copy buf_cash-desk to buf_temp-cd.
     2167          end.
     2168        end.
     2169     end.
     2170   end procedure.
     2171   def var dops as character no-undo format "X(250)".
     2172   def var dopst as character no-undo format "X(1)".
     2173   define variable v-host-code as integer no-undo .
     2174   if not g#news
     2175   and not g#auto
     2176   then do:
     2177   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2178   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2179     (input  p-obj-type
     2180     ,input  p-obj-code
     2181     ,output v-host-code
     2182     )  .
     2183   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2184   do:
     2185     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2186       (input  v-cntxt-db-num
     2187       ,input  v-cntxt-userid
     2188       ,input  0
     2189       ,input  'actn_cashdesk-restaurant_work':U
     2190       ,input  'firm':U
     2191       ,input  v-host-code
     2192       ,input  '':U
     2193       ,input  0
     2194       ,input  0
     2195       ,input  0
     2196       ,input  0
     2197       ,input  true
     2198       ,output glog
     2199       )  .
     2200   end.
     2201     if NOT glog then return .
     2202   end.
     2203   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2204   PROCEDURE putc-dept.
     2205   define input parameter pos-type as char no-undo.
     2206   define variable v-upper-out-code like ub.fbr-gds-grp.out-code no-undo .
     2207   define variable v-r-b-curr-magia like ub.currency.curr-code no-undo .
     2208   define variable v-first-cycle as integer no-undo .
     2209   define buffer buf_shop for ub.shop.
     2210   define buffer buf_clients for ub.clients.
     2211   define buffer buf_cash-desk for ub.cash-desk.
     2212   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
     2213   define buffer upper_fbr-gds-grp for ub.fbr-gds-grp.
     2214   define buffer buf_currency for ub.currency.
     2215   CASE pos-type:
     2216     when 'MAGIA-XML':U then do:
     2217       _for:
     2218       for each buf_fbr-gds-grp no-lock where
     2219               buf_fbr-gds-grp.obj-type = "":U
     2220            AND buf_fbr-gds-grp.obj-code = 0
     2221         by buf_fbr-gds-grp.obj-type
     2222         by buf_fbr-gds-grp.obj-code
     2223         by buf_fbr-gds-grp.lvl-num:
     2224         if buf_fbr-gds-grp.node-code = 1 then NEXT _for.
     2225         find first upper_fbr-gds-grp no-lock where
     2226                   upper_fbr-gds-grp.obj-type = "":U
     2227               AND upper_fbr-gds-grp.obj-code = 0
     2228               AND upper_fbr-gds-grp.node-code = buf_fbr-gds-grp.upper-code no-error .
     2229         if avail upper_fbr-gds-grp
     2230         and upper_fbr-gds-grp.out-code <> 0
     2231         then do:
     2232           assign
     2233           v-upper-out-code = upper_fbr-gds-grp.out-code
     2234           .
     2235         end.
     2236         else do:
     2237           assign
     2238           v-upper-out-code = 1
     2239           .
     2240         end.
     2241         run bgelib-tag-open in this-procedure ( input 2, input "Group"
     2242                                               , input substitute("ctrl='&1' tms='&2' code='&3'", 'ADD':U, OS2-time, buf_fbr-gds-grp.out-code)).
     2243         run bgelib-tag-put in this-procedure ( input 3, input "GroupName"
     2244                                             , input trim(buf_fbr-gds-grp.node-name, chr(32)), input 1 ).
     2245         run bgelib-tag-put in this-procedure ( input 3, input "GroupParent":U
     2246                                             , input (string(v-upper-out-code)), input 1 ).
     2247         run bgelib-tag-put in this-procedure ( input 3, input "GroupLock"
     2248                                             , input string(if action = "U":U then 0 else 1), input 1 ).
     2249         run bgelib-tag-close in this-procedure ( input 2, input "Group").
     2250       end.
     2251       _for:
     2252       for each buf_clients no-lock where
     2253                buf_clients.db-num = g#db-num
     2254             AND buf_clients.obj-type = 'маг':U:
     2255         find first buf_shop no-lock where
     2256                    buf_shop.obj-code = buf_clients.obj-code no-error .
     2257         if not available buf_shop then next _for.
     2258         if buf_shop.is-catering = no
     2259         AND buf_shop.is-kitchen = no
     2260         AND buf_shop.is-kitchen-store = no  then next _for.
     2261         v-first-cycle = 0.
     2262         run bgelib-tag-open in this-procedure ( input 2, input "Depart"
     2263                                               , input substitute("ctrl='&1' tms='&2' code='&3'", (if action = "U"
     2264                                                                                                   then "ADD":U
     2265                                                                                                   else "DEL":U),
     2266                                                                   OS2-time, buf_shop.obj-code)).
     2267         run bgelib-tag-put in this-procedure ( input 3, input "DepartName"
     2268                                              , input trim(buf_clients.obj-name, chr(32)), input 1 ).
     2269         run bgelib-tag-put in this-procedure ( input 3, input "DepartShortName":U
     2270                                              , input ('маг':U + string(buf_shop.obj-code)), input 1 ).
     2271         run bgelib-tag-close in this-procedure ( input 2, input "Depart").
     2272   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2273   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     2274     (input  buf_shop.host-code
     2275     ,output v-r-b-curr-magia
     2276     )  .
     2277         find first buf_currency no-lock where
     2278                   buf_currency.curr-code = v-r-b-curr-magia no-error .
     2279         if v-r-b-curr-magia = 0 then do:
     2280           assign
     2281           v-r-b-curr-magia = 1
     2282           .
     2283         end.
     2284         else do:
     2285           if not available buf_currency or
     2286           buf_currency.okv-code = 0 then do:
     2287             return error
     2288             substitute("Маг &1:не удалось определить код валюты продажи"
     2289                       ,  buf_shop.obj-code
     2290                       ).
     2291           end.
     2292           assign
     2293           v-r-b-curr-magia = buf_Currency.okv-code
     2294           .
     2295         end.
     2296         for each buf_cash-desk no-lock where
     2297                    buf_cash-desk.db-num = g#db-num
     2298                AND buf_cash-desk.obj-code = buf_shop.obj-code
     2299                AND buf_cash-desk.pos-type = 'MAGIA-XML':U
     2300                AND buf_cash-desk.autonomy <> integer('2':U)
     2301                :
     2302           if v-first-cycle = 0 then do:
     2303             run bgelib-tag-open in this-procedure ( input 2, input "PriceList"
     2304                                                   , input substitute("ctrl='&1' tms='&2' code='&3'", (if action = "U"
     2305                                                                                                       then "ADD":U
     2306                                                                                                       else "DEL":U),
     2307                                                   OS2-time, buf_shop.obj-code)).
     2308             run bgelib-tag-put in this-procedure ( input 3, input "PriceListName"
     2309                                                 , input trim(buf_clients.obj-name, chr(32)), input 1 ).
     2310             run bgelib-tag-close in this-procedure ( input 2, input "PriceList").
     2311             _fbr-gds-grp:
     2312             for each buf_fbr-gds-grp no-lock where
     2313                     buf_fbr-gds-grp.obj-type = 'маг':U
     2314                 AND buf_fbr-gds-grp.obj-code = buf_shop.obj-code
     2315             by buf_fbr-gds-grp.obj-type
     2316             by buf_fbr-gds-grp.obj-code
     2317             by buf_fbr-gds-grp.lvl-num:
     2318               if buf_fbr-gds-grp.out-code = 0 then NEXT  _fbr-gds-grp.
     2319               find first upper_fbr-gds-grp no-lock where
     2320                         upper_fbr-gds-grp.obj-type = 'маг':U
     2321                     AND upper_fbr-gds-grp.obj-code = buf_fbr-gds-grp.obj-code
     2322                     AND upper_fbr-gds-grp.node-code = buf_fbr-gds-grp.upper-code no-error .
     2323               if avail upper_fbr-gds-grp then do:
     2324                 assign
     2325                 v-upper-out-code = upper_fbr-gds-grp.out-code
     2326                 .
     2327               end.
     2328               else do:
     2329                 assign
     2330                 v-upper-out-code = 1
     2331                 .
     2332               end.
     2333               run bgelib-tag-open in this-procedure ( input 2, input "PriceGroup"
     2334                                                     , input substitute("ctrl='&1' tms='&2' code='&3'", 'ADD':U, OS2-time, buf_fbr-gds-grp.out-code)).
     2335               run bgelib-tag-put in this-procedure ( input 3, input "PriceGroupName"
     2336                                                   , input trim(buf_fbr-gds-grp.node-name, chr(32)), input 1 ).
     2337               run bgelib-tag-put in this-procedure ( input 3, input "PriceParentGroupID":U
     2338                                                   , input (string(v-upper-out-code)), input 1 ).
     2339               run bgelib-tag-put in this-procedure ( input 3, input "PriceListID":U
     2340                                                   , input (string(buf_shop.obj-code)), input 1 ).
     2341               run bgelib-tag-put in this-procedure ( input 3, input "ImageIndex":U
     2342                                                   , input (string(0)), input 1 ).
     2343               run bgelib-tag-put in this-procedure ( input 3, input "PriceGroupLock"
     2344                                                   , input string(if action = "U":U then 0 else 1), input 1 ).
     2345               run bgelib-tag-close in this-procedure ( input 2, input "PriceGroup").
     2346             end.
     2347             v-first-cycle = v-first-cycle + 1.
     2348           end.
     2349           run bgelib-tag-open in this-procedure ( input 2, input "Station"
     2350                                                 , input substitute("ctrl='&1' tms='&2' code='&3'", (if action = "U"
     2351                                                                                                     then "ADD":U
     2352                                                                                                     else "DEL":U),
     2353                                                 OS2-time, buf_cash-desk.cash-num)).
     2354           run bgelib-tag-put in this-procedure ( input 3, input "StationName"
     2355                                               , input trim(buf_cash-desk.addr-path, chr(32)), input 1 ).
     2356           run bgelib-tag-put in this-procedure ( input 3, input "StationType"
     2357                                               , input string(0), input 1 ).
     2358           run bgelib-tag-put in this-procedure ( input 3, input "StationPrLId"
     2359                                               , input string(buf_shop.obj-code), input 1 ).
     2360           run bgelib-tag-put in this-procedure ( input 3, input "StationCurrency"
     2361                                               , input string(v-r-b-curr-magia), input 1 ).
     2362           run bgelib-tag-put in this-procedure ( input 3, input "StationAccuracy"
     2363                                               , input string(3), input 1 ).
     2364           run bgelib-tag-close in this-procedure ( input 2, input "Station").
     2365         end.
     2366       end.
     2367     end.
     2368   END CASE .
     2369   END PROCEDURE .
     2370   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2371   PROCEDURE   for-cash-cycle:
     2372   define buffer for-cash-desk for ub.cash-desk.
     2373   define variable v-first as logical no-undo .
     2374     FOR EACH for-cash-desk NO-LOCK WHERE
     2375             for-cash-desk.db-num = g#db-num AND
     2376             for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     2377             for-cash-desk.cash-on  = yes
     2378       BREAK
     2379       BY for-cash-desk.db-num
     2380       BY for-cash-desk.pos-type
     2381       BY for-cash-desk.cash-on
     2382       :
     2383       if ub.cash-desk.pos-type <> 'MAGIA-XML':U or
     2384       (LOOKUP(ub.cash-desk.pos-type,
     2385                 ('NCR-GM':U + chr(44) +
     2386                  'IBM-XML':U + chr(44) +
     2387                  'MAGIA-XML':U + chr(44) +
     2388                  'NCR-AS@R':U + 'Autotank':U
     2389                  )) > 0
     2390        and for-cash-desk.autonomy = integer('1':U))
     2391        or v-first then next.
     2392       assign
     2393       v-first = yes
     2394       .
     2395       run write-log-and-file in p-log-handle (
     2396             input 1
     2397           , input log-file-name
     2398           , input 1
     2399           , input substitute("Пересылка - касса &1", for-cash-desk.cash-num)
     2400                                                         ).
     2401   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2402   case for-cash-desk.pos-type:
     2403     when 'MAGIA-XML':U then do:
     2404   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2405   run xml-cd-filename in this-procedure (
     2406         input out
     2407       , output v-xml-file-name
     2408       , output v-xml-file-name-path
     2409       , output v-log-file-name
     2410       , output v-locked
     2411   ).
     2412   run write-log-and-file in p-log-handle (
     2413         input 1
     2414       , input log-file-name
     2415       , input 1
     2416       , input substitute( ("'Пересылка данных по подразделениям'" + " &1")
     2417                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2418                         )
     2419                                         ).
     2420   run write-log-and-file in p-log-handle (
     2421         input 1
     2422       , input log-file-name
     2423       , input 1
     2424       , input substitute( "................с параметрами: ... БД: &1", g#db-num )
     2425                                         ).
     2426   assign
     2427   v-obj-list = "БД" + string(g#db-num)
     2428   .
     2429   run xml-cd-write-header in this-procedure (
     2430         input v-xml-file-name
     2431       , input v-xml-file-name-path
     2432       , input "data"
     2433       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2434       , input v-obj-list
     2435       , input (
     2436                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2437                   then (if for-cash-desk.autonomy = integer('0':U)
     2438                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2439                         else ("КМ"    )
     2440                         )
     2441                   else ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2442                   )
     2443               )
     2444       , input yes
     2445   ).
     2446   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2447   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2448     end.
     2449   END CASE.
     2450       RUN putc-dept( for-cash-desk.pos-type ).
     2451   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2452   case for-cash-desk.pos-type:
     2453     when 'MAGIA-XML':U then do:
     2454   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2455   output stream stmxmlout close.
     2456   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     2457       , input 'data'
     2458   ).
     2459   run write-log-and-file in p-log-handle (
     2460         input 1
     2461       , input log-file-name
     2462       , input 1
     2463       , input substitute( "Данные выгружены в файл &1"
     2464                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     2465                         )
     2466                                          ).
     2467   if (
     2468   not (g#news or g#auto or g#esys )
     2469   or
     2470   (
     2471   for-cash-desk.pos-type = 'MAGIA-XML':U
     2472   or
     2473     (for-cash-desk.pos-type = 'IBM-XML':U
     2474   or (for-cash-desk.pos-type = 'Autotank':U
     2475     and
     2476     for-cash-desk.autonomy = integer('2':U))
     2477     )))
     2478   then do:
     2479     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     2480       run str/waitpxml.w ( replace( v-xml-file-name-path, "/", "\" ) + "xml",
     2481                   (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml"),
     2482                   ( if action = 'U'
     2483                     then ('Ждите - ' + 'добавление данных по подразделениям')
     2484                     else ('Ждите - ' + 'удаление данных по подразделениям') ) +
     2485                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num),
     2486                     ' Подождите 15 сек ',
     2487                     'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!',
     2488                     'Подождите: касса обрабатывает запрос',
     2489                     15 ) no-error.
     2490       if error-status:error then do:
     2491         os-delete value( replace( v-xml-file-name-path, "/", "\" ) + "xml" ) .
     2492         run write-log-and-file in p-log-handle (
     2493               input 1
     2494             , input log-file-name
     2495             , input 1
     2496             , input substitute( "!!!Прерван обмен информацией с кассой &1, на кассе осталась устаревшая информация",
     2497                                   for-cash-desk.cash-num
     2498                               )
     2499                                               ).
     2500         assign
     2501         v-view-log = yes
     2502         .
     2503         return "error":U.
     2504       end.
     2505     end.
     2506     if (for-cash-desk.pos-type = 'IBM-XML':U
     2507     and for-cash-desk.autonomy = integer('0':U))
     2508     or (for-cash-desk.pos-type = 'Autotank':U
     2509     and for-cash-desk.autonomy = integer('2':U))
     2510     then do:
     2511       run str/post-xml.p
     2512         (
     2513          input parparentproc
     2514         ,input p-parent-handle
     2515         ,input p-log-handle
     2516         ,input g#news or g#esys
     2517         ,input g#auto
     2518         ,input 'send'
     2519         ,input log-file-name
     2520         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     2521         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     2522         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     2523         ,input 30
     2524         ,input   ( if action = 'U'
     2525                     then ('Ждите - ' + 'добавление данных по подразделениям')
     2526                     else ('Ждите - ' + 'удаление данных по подразделениям') ) +
     2527                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     2528         ) no-error .
     2529       if error-status:error
     2530       or return-value = "error" then do:
     2531         run write-log-and-file in p-log-handle (
     2532               input 1
     2533             , input log-file-name
     2534             , input 1
     2535             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     2536                                   ,for-cash-desk.obj-code
     2537                                   ,for-cash-desk.cash-num
     2538                                   , chr(10)
     2539                                   , error-status:get-message(1)
     2540                                   , return-value
     2541                               )
     2542                                               ).
     2543         assign
     2544         v-view-log = yes
     2545         .
     2546       end.
     2547     end.
     2548     if not available ub.shop then do:
     2549       find first ub.shop no-lock where
     2550                 ub.shop.obj-code = for-cash-desk.obj-code.
     2551     end.
     2552     if
     2553     not (g#news or g#esys)
     2554     then do:
     2555       run str/getxibmf.p (
     2556                       input parparentproc
     2557                     ,input p-log-handle
     2558                     ,input 'маг':U
     2559                     ,input for-cash-desk.obj-code
     2560                     ,input ub.shop.host-code
     2561                     ,input in_
     2562                     ,input spl
     2563                     ,input (in_ + sav)
     2564                     ,input for-cash-desk.pos-type
     2565                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     2566                             and for-cash-desk.autonomy = integer('0':U))
     2567                             or (for-cash-desk.pos-type = 'Autotank':U
     2568                             and for-cash-desk.autonomy = integer('2':U))
     2569                             then "utf-8":U
     2570                             else "windows-1251")
     2571                     ,input log-file-name
     2572                     ,input "data":U
     2573                     ,input v-xml-file-name
     2574                     ,input-output v-view-log
     2575                     ) no-error .
     2576       if error-status:error then do:
     2577         run write-log-and-file in p-log-handle (
     2578               input 1
     2579             , input log-file-name
     2580             , input 1
     2581             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     2582                                   ,for-cash-desk.obj-code
     2583                                   ,for-cash-desk.cash-num
     2584                               )
     2585                                               ).
     2586         assign
     2587         v-view-log = yes
     2588         .
     2589       end.
     2590     end.
     2591   end.
     2592   if g#news
     2593   or g#auto
     2594   or g#esys
     2595   and for-cash-desk.pos-type = 'MAGIA-XML':U
     2596   then do:
     2597   end.
     2598     end.
     2599   END CASE.
     2600     END .
     2601   END PROCEDURE.
     2602   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2603   PROCEDURE SENDING:
     2604   DEFINE VARIABLE fq as integer no-undo .
     2605   FOR EACH ub.cash-desk NO-LOCK WHERE
     2606           ub.cash-desk.db-num = g#db-num AND
     2607           ub.cash-desk.cash-on
     2608   BREAK
     2609   By ub.cash-desk.pos-type :
     2610     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     2611   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2612   define variable dflt-cd20 as character no-undo .
     2613   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2614   define variable v-param-type21 as character no-undo .
     2615   define variable v-value-date21 as date no-undo .
     2616   define variable v-value-decimal21 as decimal no-undo .
     2617   define variable v-value-integer21 as INTEGER no-undo .
     2618   define variable v-value-logical21 AS LOGICAL no-undo .
     2619   define variable v-tth21 as handle no-undo .
     2620   run adm/shattri.p (
     2621       input "get":U
     2622       ,input  'маг':U
     2623       ,input  ub.cash-desk.obj-code
     2624       ,input  'cd-sending':U
     2625       ,input  'dflt-cd':U
     2626       ,output dflt-cd20
     2627       ,output v-value-date21
     2628       ,output v-value-decimal21
     2629       ,output v-value-integer21
     2630       ,output v-value-logical21
     2631       ,output v-param-type21
     2632       ,INPUT-OUTPUT table-handle v-tth21
     2633       ) no-error .
     2634   delete object v-tth21 no-error.
     2635   case ub.cash-desk.pos-type:
     2636       when 'MAGIA-XML':U
     2637     then do:
     2638   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2639   run str/get-inis.p (
     2640                   input 'маг':U
     2641                 , input ub.cash-desk.obj-code
     2642                 , input ub.cash-desk.pos-type
     2643                 , input cash-desk.remote
     2644                 , input "send":U
     2645                 , output out
     2646                 , output out2
     2647                 , output in_
     2648                 , output spl
     2649                 , output sav
     2650                 , output v-remote
     2651                 )  no-error .
     2652   if error-status:error then do:
     2653     run write-log-and-file in p-log-handle (
     2654           input 1
     2655         , input log-file-name
     2656         , input 1
     2657         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     2658                             , ub.cash-desk.pos-type
     2659                             , ub.cash-desk.obj-code
     2660                             , chr(10)
     2661                             , error-status:get-message(1)
     2662                             , return-value )).
     2663     assign
     2664     v-view-log = yes.
     2665     return error.
     2666   end.
     2667   if ub.cash-desk.pos-type = 'IBM-XML':U
     2668   or ub.cash-desk.pos-type = 'Autotank':U
     2669   then do:
     2670     file-info:file-name = (out  + "undelivered").
     2671     if file-info:FULL-PATHNAME <> ? then do:
     2672       run str/rsndxibm.p ( input parparentproc
     2673                           ,input p-parent-handle
     2674                           ,input p-log-handle
     2675                           ,input out  + "undelivered" ) no-error.
     2676     end.
     2677   end.
     2678     end.
     2679   END CASE.
     2680       RUN for-cash-cycle no-error.
     2681     END.
     2682     IF LAST-OF(ub.cash-desk.pos-type) then do:
     2683   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2684   case ub.cash-desk.pos-type:
     2685   END CASE.
     2686     END.
     2687   END.
     2688   END PROCEDURE.
     2689   run write-log-and-file in p-log-handle (
     2690         input 1
     2691       , input log-file-name
     2692       , input 1
     2693       , input substitute("Пересылка на кассы &1 БД &2 информации о подразделениях и группах товаров", 'MAGIA-XML':U, p-db-num)
     2694                                             ).
     2695   RUN SENDING no-error.
     2696   if error-status:error then do:
     2697     run write-log-and-file in p-log-handle (
     2698           input 1
     2699         , input log-file-name
     2700         , input 1
     2701         , input substitute( "!!!Ошибки при отсылке информации о подразделениях и группах товаров на кассы  БД &1"
     2702                            , p-db-num
     2703                           )
     2704                                           ).
     2705     assign
     2706     v-view-log = yes
     2707     .
     2708   end.
     2709   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2710   if v-view-log
     2711   and not g#news
     2712   and not g#auto
     2713   then do:
     2714     message
     2715     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
     2716     "!!!Внимательно прочитайте Log-file!!"
     2717     view-as alert-box error .
     2718        define variable v-user-action25   as character no-undo .
     2719     define variable v-printed25       as logical   no-undo .
     2720     run gbl/prnfilen.w
     2721       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
     2722       ,input  0
     2723       ,input  (string("./":U) + 'send-cd.txt')
     2724       ,input  7
     2725       ,output v-user-action25
     2726       ,output v-printed25
     2727       ) .
     2728   end.
     2729   if v-view-log = true
     2730   and (g#news
     2731   or g#auto)
     2732   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     2733   then do:
     2734      run cb_set-view-log in p-parent-handle ( input yes).
     2735   end.
     2736   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     2737     OS-DELETE value(string("./":U) + 'send-cd.txt').
     2738   end.
