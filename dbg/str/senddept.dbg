      112   if error-status:error then return error.
      113   define variable vss-include-info2 as character format "X(65)" no-undo
      114   initial "@(#)$Workfile$ $Revision$".
      115   define variable v-bgelib-bgefmt        as character         no-undo.
      116   define variable v-bgelib-bgeflold      as character         no-undo.
      117   define stream stmXMLOut.
      118   define stream stmXMLLog.
      119   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   procedure cur-time :
      121      define output parameter p-today as date      no-undo .
      122      define output parameter p-time  as integer   no-undo .
      123     do
      124     on error undo, return error
      125     :
      126       define variable v-date1 as date      no-undo .
      127       define variable v-date2 as date      no-undo .
      128       define variable v-time  as integer   no-undo .
      129       assign
      130         v-date1 = today
      131         v-time  = time
      132         v-date2 = today
      133       .
      134       if v-date1 <> v-date2
      135       then do:
      136         assign
      137           v-date1 = today
      138           v-time  = v-time
      139         .
      140       end.
      141       assign
      142         p-today = v-date1
      143         p-time  = v-time
      144       .
      145     end.
      146   end.
      147   function cur-time-date returns character
      148   :
      149     return string(today, '99/99/9999':U) .
      150   end.
      151   function cur-time-mjd returns decimal
      152   :
      153     define variable v-date as date      no-undo .
      154     define variable v-time as integer   no-undo .
      155     run cur-time in this-procedure
      156       (output v-date
      157       ,output v-time
      158       ) .
      159     return integer(v-date) - 2400002 + (v-time / 86400) .
      160   end.
      161   function cur-time-get-ending-index returns integer
      162   (input p-number as integer
      163   )
      164   :
      165     if p-number < 0
      166     or p-number = ?
      167     then do:
      168       return 1 .
      169     end.
      170     define variable v-rest as integer   no-undo .
      171     assign
      172       p-number = p-number modulo 100
      173     .
      174     if p-number < 20
      175     then do:
      176       assign
      177         v-rest = p-number
      178       .
      179     end.
      180     else do:
      181       assign
      182         v-rest = p-number modulo 10
      183       .
      184     end.
      185     case v-rest :
      186       when 1
      187       then do:
      188         return 2 .
      189       end.
      190       when 2 or
      191       when 3 or
      192       when 4
      193       then do:
      194         return 3 .
      195       end.
      196       otherwise do:
      197         return 1 .
      198       end.
      199     end case .
      200   end.
      201   procedure cur-time-mjd-to-date :
      202      define input  parameter i-mjd-diff as decimal no-undo.
      203      define output parameter o-Date     as date    no-undo.
      204      define output parameter o-Time     as integer no-undo.
      205      define variable v-day-number as integer   no-undo .
      206      if    i-mjd-diff < 0
      207         or i-mjd-diff = ?
      208      then do:
      209         return "?" .
      210      end.
      211      assign
      212         v-day-number = truncate(i-mjd-diff,0).
      213         o-Date = date(v-day-number + 2400002).
      214         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      215     .
      216   end.
      217   function cur-time-mjd-to-string returns character
      218   (input p-mjd-diff as decimal
      219   )
      220   :
      221     define variable v-day-number as integer   no-undo .
      222     define variable v-seconds    as integer   no-undo .
      223     define variable v-hour       as integer   no-undo .
      224     define variable v-min        as integer   no-undo .
      225     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      226     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      227     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      228     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      229     if p-mjd-diff < 0
      230     or p-mjd-diff = ?
      231     then do:
      232       return "?" .
      233     end.
      234     assign
      235       v-day-number = integer(truncate(p-mjd-diff,0))
      236       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      237     .
      238     if v-seconds > 86400
      239     then do:
      240       assign
      241         v-seconds = 86400 - 1
      242       .
      243     end.
      244     if v-seconds < 0
      245     then do:
      246       assign
      247         v-seconds = 0
      248       .
      249     end.
      250     assign
      251       v-hour = truncate(v-seconds / 3600, 0)
      252     .
      253     assign
      254       v-seconds = v-seconds modulo 3600
      255     .
      256     assign
      257       v-min = truncate(v-seconds / 60, 0)
      258     .
      259     assign
      260       v-seconds = v-seconds modulo 60
      261     .
      262     return
      263         (if v-day-number <> 0
      264           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      265           else ""
      266         )
      267       + (if v-day-number <> 0 or v-hour <> 0
      268           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      269           else ""
      270         )
      271       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      272           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      273           else ""
      274         )
      275       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      276       .
      277   end.
      278   function cur-time-string returns character
      279   :
      280     define variable v-date as date      no-undo .
      281     define variable v-time as integer   no-undo .
      282     run cur-time in this-procedure
      283       (output v-date
      284       ,output v-time
      285       ) .
      286     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      287   end.
      288   function cur-time-string-sec returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      297   end.
      298   function cur-time-custom  returns character
      299   (input p-prefix as character
      300   ,input p-date-format as character
      301   ,input p-delimiter as character
      302   ,input p-time-format as character
      303   ,input p-suffix as character
      304   )
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return
      313       p-prefix
      314       + string(v-date, p-date-format)
      315       + p-delimiter
      316       + string(v-time, p-time-format)
      317       + p-suffix
      318       .
      319   end.
      320   function cur-time-print  returns character
      321   :
      322     define variable v-date as date      no-undo .
      323     define variable v-time as integer   no-undo .
      324     run cur-time in this-procedure
      325       (output v-date
      326       ,output v-time
      327       ) .
      328     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      329   end.
      330   function cur-time-datetime returns datetime
      331   :
      332     define variable v-char as character no-undo .
      333     define variable v-datetime as datetime no-undo .
      334     v-char = cur-time-string().
      335     v-datetime = datetime(v-char).
      336     return  v-datetime.
      337   end.
      338   function cur-time-string-msec returns character
      339   :
      340     define variable v-date as datetime  no-undo .
      341     v-date = now.
      342     return string(v-date) .
      343   end.
      344   define variable vss-include-info4 as character format "X(65)" no-undo
      345   initial "@(#)$Workfile$ $Revision$".
      346   procedure xmlchar-test :
      347   define input parameter p-in-string          as character        no-undo.
      348   define output parameter p-out-string-enc    as character        no-undo.
      349   define output parameter p-out-string-dec    as character        no-undo.
      350   do
      351   on error undo, return error
      352   :
      353          run xmlchar-encode in this-procedure
      354       (
      355             input p-in-string
      356           , output p-out-string-enc
      357       ).
      358          run xmlchar-decode in this-procedure
      359       (
      360             input p-out-string-enc
      361           , output p-out-string-dec
      362       ).
      363   end.
      364   end .
      365   procedure xmlchar-encode :
      366   define input parameter p-in-string      as character        no-undo.
      367   define output parameter p-out-string    as character        no-undo.
      368       define variable v-position      as integer      no-undo.
      369       define variable v-current-char  as character    no-undo.
      370   do
      371   on error undo, return error
      372   :
      373       assign
      374           p-out-string = "":U
      375       .
      376       case p-in-string
      377       :
      378           when ?
      379           then do:
      380               assign
      381                   p-out-string = "?":U
      382               .
      383           end.
      384           when "?":U
      385           then do:
      386               assign
      387                   p-out-string = "&#63;":U
      388               .
      389           end.
      390           otherwise do:
      391               do v-position = 1 to length( p-in-string )
      392               :
      393                   assign
      394                       v-current-char = substring( p-in-string, v-position, 1 )
      395                   .
      396                   case v-current-char
      397                   :
      398                       when "&":U
      399                       then do:
      400                           assign
      401                               p-out-string = p-out-string + "&amp;":U
      402                           .
      403                       end.
      404                       when ">":U
      405                       then do:
      406                           assign
      407                               p-out-string = p-out-string + "&gt;":U
      408                           .
      409                       end.
      410                       when "<":U
      411                       then do:
      412                           assign
      413                               p-out-string = p-out-string + "&lt;":U
      414                           .
      415                       end.
      416                       when "'":U
      417                       then do:
      418                           assign
      419                               p-out-string = p-out-string + "&apos;":U
      420                           .
      421                       end.
      422                       when '"':U
      423                       then do:
      424                           assign
      425                               p-out-string = p-out-string + "&quot;":U
      426                           .
      427                       end.
      428                       when chr(1)
      429                       then do:
      430                           assign
      431                               p-out-string = p-out-string + "":U
      432                           .
      433                       end.
      434                       when chr(2)
      435                       then do:
      436                           assign
      437                               p-out-string = p-out-string + "":U
      438                           .
      439                       end.
      440                       when chr(3)
      441                       then do:
      442                           assign
      443                               p-out-string = p-out-string + "":U
      444                           .
      445                       end.
      446                       when chr(4)
      447                       then do:
      448                           assign
      449                               p-out-string = p-out-string + "":U
      450                           .
      451                       end.
      452                       when chr(5)
      453                       then do:
      454                           assign
      455                               p-out-string = p-out-string + "":U
      456                           .
      457                       end.
      458                       when chr(6)
      459                       then do:
      460                           assign
      461                               p-out-string = p-out-string + "":U
      462                           .
      463                       end.
      464                       when chr(7)
      465                       then do:
      466                           assign
      467                               p-out-string = p-out-string + "":U
      468                           .
      469                       end.
      470                       when chr(8)
      471                       then do:
      472                           assign
      473                               p-out-string = p-out-string + "":U
      474                           .
      475                       end.
      476                       when chr(9)
      477                       then do:
      478                           assign
      479                               p-out-string = p-out-string + "":U
      480                           .
      481                       end.
      482                       when chr(29)
      483                       then do:
      484                           assign
      485                               p-out-string = p-out-string + "":U
      486                           .
      487                       end.
      488                       when chr(10)
      489                       then do:
      490                           assign
      491                               p-out-string = p-out-string + "&#10;":U
      492                           .
      493                       end.
      494                       when chr(13)
      495                       then do:
      496                           assign
      497                               p-out-string = p-out-string + "&#13;":U
      498                           .
      499                       end.
      500                       otherwise do:
      501                           assign
      502                               p-out-string = p-out-string + v-current-char
      503                           .
      504                       end.
      505                   end case.
      506               end.
      507           end.
      508       end case.
      509   end.
      510   end .
      511   procedure xmlchar-encode-1c :
      512   define input parameter p-in-string      as character        no-undo.
      513   define output parameter p-out-string    as character        no-undo.
      514       define variable v-position      as integer      no-undo.
      515       define variable v-current-char  as character    no-undo.
