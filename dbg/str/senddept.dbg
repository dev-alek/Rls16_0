      621   procedure xmlchar-decode :
      622   define input parameter p-in-string      as character        no-undo.
      623   define output parameter p-out-string    as character        no-undo.
      624       define variable v-position      as integer      no-undo.
      625       define variable v-last-position as integer      no-undo.
      626       define variable v-temp-integer  as integer      no-undo.
      627       define variable v-current-char  as character    no-undo.
      628       define variable v-next-char     as character    no-undo.
      629       define variable v-success       as logical      no-undo.
      630   do
      631   on error undo, return error
      632   :
      633       assign
      634           p-out-string = "":U
      635           v-position   = 0
      636       .
      637       replace-cycle:
      638       do while yes
      639       on error undo, return error
      640       :
      641           assign
      642               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      643           .
      644           if v-last-position <= v-position
      645           then do:
      646               if v-position = 0
      647               then do:
      648                   assign
      649                       p-out-string = p-in-string
      650                   .
      651               end.
      652               else do:
      653                   assign
      654                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      655                   .
      656               end.
      657               leave replace-cycle.
      658           end.
      659           else do:
      660               assign
      661                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      662                   v-position      = v-last-position
      663                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      664               .
      665               if v-current-char = "#":U
      666               then do:
      667                   assign
      668                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      669                   .
      670                   if v-last-position > 0
      671                   then do:
      672                       run xmlchar-read-integer in this-procedure
      673                        (
      674                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      675                           , output v-temp-integer
      676                           , output v-success
      677                       ).
      678                       if v-success = yes
      679                       and v-temp-integer >= 1
      680                       and v-temp-integer <= 255
      681                       then do:
      682                           assign
      683                               p-out-string = p-out-string + chr( v-temp-integer )
      684                               v-position   = v-last-position + 1
      685                           .
      686                       end.
      687                       else do:
      688                           assign
      689                               p-out-string = p-out-string + "&":U
      690                               v-position   = v-position   + 1
      691                           .
      692                       end.
      693                   end.
      694                   else do:
      695                       assign
      696                           p-out-string = p-out-string + "&":U
      697                           v-position   = v-position   + 1
      698                       .
      699                   end.
      700               end.
      701               else do:
      702                   case substring( p-in-string, v-position + 1, 3 )
      703                   :
      704                       when "lt;":U
      705                       then do:
      706                           assign
      707                               p-out-string = p-out-string + "<":U
      708                               v-position   = v-position   + 3
      709                           .
      710                       end.
      711                       when "gt;":U
      712                       then do:
      713                           assign
      714                               p-out-string = p-out-string + ">":U
      715                               v-position   = v-position   + 3
      716                           .
      717                       end.
      718                       otherwise do:
      719                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      720                           then do:
      721                               assign
      722                                   p-out-string = p-out-string + "&":U
      723                                   v-position   = v-position   + 4
      724                               .
      725                           end.
      726                           else do:
      727                               case substring( p-in-string, v-position + 1, 5 )
      728                               :
      729                                   when "quot;":U
      730                                   then do:
      731                                       assign
      732                                           p-out-string = p-out-string + '"':U
      733                                           v-position   = v-position   + 5
      734                                       .
      735                                   end.
      736                                   when "apos;":U
      737                                   then do:
      738                                       assign
      739                                           p-out-string = p-out-string + "'":U
      740                                           v-position   = v-position   + 5
      741                                       .
      742                                   end.
      743                                   otherwise do:
      744                                       assign
      745                                           p-out-string = p-out-string + "&":U
      746                                       .
      747                                   end.
      748                               end case.
      749                           end.
      750                       end.
      751                   end case.
      752               end.
      753           end.
      754       end.
      755   end.
      756   end .
      757   procedure xmlchar-read-integer :
      758   define input parameter p-input-string      as character        no-undo.
      759   define output parameter p-output-integer   as integer          no-undo.
      760   define output parameter p-success       as logical          no-undo.
      761   do
      762   on error undo, return error
      763   :
      764       assign
      765           p-output-integer = integer( p-input-string )
      766       no-error.
      767       if error-status :error
      768       then do:
      769           assign
      770               p-success           = no
      771               p-output-integer    = 0
      772           .
      773       end.
      774       else do:
      775           assign
      776               p-success           = yes
      777           .
      778       end.
      779   end.
      780   end.
      781   define variable v-bgelib-bgeclall           as logical      no-undo.
      782   define variable v-bgelib-bgedict            as logical      no-undo.
      783   define temp-table temp_ext-doc-type no-undo
      784       field edt-key               as integer
      785       field ext-doc-type          as character
      786       field ext-doc-type-label    as character
      787       index pi is primary unique
      788           edt-key
      789   .
      790   define temp-table temp_bgelib_goods no-undo
      791       field gds-code as integer
      792       index pi is primary unique
      793           gds-code
      794   .
      795   define temp-table temp_bgelib_clients no-undo
      796       field obj-type as character
      797       field obj-code as integer
      798       index pi is primary unique
      799           obj-type
      800           obj-code
      801   .
      802   define temp-table temp_bgelib_dis-card no-undo
      803       field d-card as character
      804       index pi is primary unique
      805           d-card
      806   .
      807   define temp-table temp_bgelib_trn-doc no-undo
      808       field doc-code as integer
      809   .
      810   procedure bgelib-tag-open:
      811   do
      812   on error undo, return error
      813   :
      814   define input parameter v-tag-level  as integer      no-undo.
      815   define input parameter v-tag-name   as character    no-undo.
      816   define input parameter v-tag-value  as character    no-undo.
      817       put stream stmXMLOut unformatted
      818           chr(10)
      819           + fill(" ", 4 * v-tag-level)
      820           + "<" + v-tag-name
      821           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      822           + v-tag-value + ">"
      823       .
      824   end.
      825   end procedure.
      826   procedure bgelib-tag-put:
      827   do
      828   on error undo, return error
      829   :
      830   define input parameter v-tag-level      as integer      no-undo.
      831   define input parameter v-tag-name       as character    no-undo.
      832   define input parameter v-tag-value      as character    no-undo.
      833   define input parameter v-empty-mode     as integer      no-undo.
      834       v-tag-name = trim(v-tag-name).
      835       if  v-empty-mode = 1
      836       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      837       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      838       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      839       then do:
      840           run xmlchar-encode in this-procedure (
      841                 input v-tag-value
      842               , output v-tag-value
      843           ).
      844           put stream stmXMLOut unformatted
      845               chr(10) + fill(" ", 4 * v-tag-level)
      846                           + '<' + v-tag-name + '>'
      847                           + v-tag-value
      848                           + '</' + v-tag-name + '>'
      849           .
      850       end.
      851   end.
      852   end procedure.
      853   procedure bgelib-tag-close:
      854   do
      855   on error undo, return error
      856   :
      857   define input parameter v-tag-level as integer      no-undo.
      858   define input parameter v-tag-name  as character    no-undo.
      859       put stream stmXMLOut unformatted
      860           chr(10)
      861           + fill( " ", 4 * v-tag-level)
      862           + '</' + v-tag-name + '>'
      863       .
      864   end.
      865   end procedure.
      866   procedure bgelib-write-log:
      867   do
      868   on error undo, return error
      869   :
      870   define input parameter v-filename   as character    no-undo.
      871   define input parameter v-log-level  as integer      no-undo.
      872   define input parameter v-out-string as character    no-undo.
      873       output stream stmXMLLog to value( v-filename ) append.
      874       put stream stmXMLLog unformatted
      875           chr(10)
      876       .
      877       put stream stmXMLLog unformatted
      878           ( if v-log-level = 0
      879             or v-out-string = "&DLine"
      880             or v-out-string = "&Line"
      881             then ""
      882             else cur-time-string-sec() + " " )
      883       .
      884       put stream stmXMLLog unformatted
      885           ( if v-out-string = "&Line"
      886             then fill( "-", 80 )
      887             else if v-out-string = "&DLine"
      888                  then fill( "=", 80 )
      889                  else v-out-string )
      890       .
      891       output stream stmXMLLog close.
      892   end.
      893   end procedure.
      894   procedure bgelib-write-edt:
      895   do
      896   on error undo, return error
      897   :
      898   define input parameter v-editor-handle    as handle       no-undo.
      899   define input parameter v-log-level        as integer      no-undo.
      900   define input parameter v-out-string       as character    no-undo.
      901       if valid-handle ( v-editor-handle )
      902       then do:
      903           v-editor-handle :move-to-eof().
      904           v-editor-handle :insert-string( ( if v-log-level = 0
      905                                             or v-out-string = "&DLine"
      906                                             or v-out-string = "&Line"
      907                                             then ""
      908                                             else cur-time-string-sec() + " "
      909                                         ) ).
      910           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      911                                             then fill( "-", 80 )
      912                                             else if v-out-string = "&DLine" then fill("=", 80)
      913                                             else fill( " ", v-log-level) + v-out-string
      914                                         ) ).
      915           v-editor-handle :insert-string( chr(10) ).
      916       end.
      917       process events.
      918       output to 'bgescn.txt' append.
      919           put unformatted
      920               chr(10)
      921               string( ( if v-log-level = 0
      922                         or v-out-string = "&DLine"
      923                         or v-out-string = "&Line"
      924                         then ""
      925                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      926                     ) )
      927               string( ( if v-out-string = "&Line"
      928                         then fill( "-", 80 )
      929                         else if v-out-string = "&DLine"
      930                              then fill( "=", 80 )
      931                              else fill( " ", v-log-level ) + v-out-string
      932                     ) )
      933           .
      934       output close.
      935   end.
      936   end procedure.
      937   procedure bgelib-show-cnt:
      938   do
      939   on error undo, return error
      940   :
      941   define input parameter v-fillin-handle     as handle   no-undo.
      942       if valid-handle( v-fillin-handle )
      943       then do:
      944           assign
      945               v-fillin-handle :visible = true
      946           .
      947       end.
      948   end.
      949   end procedure.
      950   procedure bgelib-hide-cnt:
      951   do
      952   on error undo, return error
      953   :
      954   define input parameter v-fillin-handle     as handle   no-undo.
      955       if valid-handle( v-fillin-handle )
      956       then do:
      957           assign v-fillin-handle :visible = false.
      958       end.
      959   end.
      960   end procedure.
      961   procedure bgelib-write-cnt:
      962   do
      963   on error undo, return error
      964   :
      965   define input parameter v-fillin-handle    as handle       no-undo.
      966   define input parameter v-fillin-string    as character    no-undo.
      967       if valid-handle( v-fillin-handle )
      968       then do:
      969           assign
      970               v-fillin-handle :SCREEN-value = v-fillin-string
      971           .
      972       end.
      973   end.
      974   end procedure.
      975   procedure bgelib-write-header:
      976   do
      977   on error undo, return error
      978   :
      979   define input parameter p-first-file     as logical      no-undo.
      980   define input parameter p-xml-file-name  as character    no-undo.
      981   define input parameter p-list-file-name as character    no-undo.
      982   define input parameter p-file-number    as integer      no-undo.
      983   define input parameter p-have-prev      as logical      no-undo.
      984   define input parameter p-prev-filename  as character    no-undo.
      985   define input parameter p-obj-list       as character    no-undo.
      986   define input parameter p-doc-type-list  as character    no-undo.
      987   define input parameter p-parameter-list as character    no-undo.
      988       define variable v-counter    as integer        no-undo.
      989       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      990       put stream stmXMLOut unformatted
      991           "<?xml version='1.0' encoding='windows-1251'?>"
      992       .
      993       run bgelib-tag-open( input 0, input "root"  , input "" ).
      994       run bgelib-tag-open( input 0, input "header", input "" ).
      995       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      996       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      997       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      998       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      999       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1000       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1001       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1002       :
     1003           run bgelib-tag-put(
     1004                 input 1
     1005               , input entry( 2 * v-counter, p-parameter-list )
     1006               , input entry( 2 * v-counter + 1, p-parameter-list )
     1007               , input 0
     1008           ).
     1009       end.
     1010       run bgelib-tag-close( input 0, input "header" ).
     1011       output stream stmXMLOut close.
     1012       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1013       if p-first-file = yes
     1014       then do:
     1015           put stream stmXMLOut unformatted
     1016               "<?xml version='1.0' encoding='windows-1251'?>"
     1017           .
     1018           run bgelib-tag-open( input 0, input "export", input "" ).
     1019       end.
     1020       run bgelib-tag-open( input 1, input "file", input "" ).
     1021       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1022       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1023       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1024       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1025       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1026       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1027       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1028       :
     1029           run bgelib-tag-put(
     1030                 input 2
     1031               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1032               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1033               , input 0
     1034           ).
     1035       end.
     1036       run bgelib-tag-close( input 1, input "file" ).
     1037       output stream stmXMLOut close.
     1038   end.
     1039   end procedure.
     1040   procedure bgelib-write-footer:
     1041   do
     1042   on error undo, return error
     1043   :
     1044   define input parameter p-last-file      as logical      no-undo.
     1045   define input parameter p-xml-file-name  as character    no-undo.
     1046   define input parameter p-list-file-name as character    no-undo.
     1047   define input parameter p-have-next      as logical      no-undo.
     1048   define input parameter p-next-file-name as character    no-undo.
     1049       define variable v-error-num     as integer           no-undo.
     1050       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1051       if p-have-next = yes
     1052       then do:
     1053           run bgelib-tag-open( input 0, input "footer", "" ).
     1054           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1055           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1056           run bgelib-tag-close( input 0, input "footer" ).
     1057       end.
     1058       run bgelib-tag-close( input 0, input "root" ).
     1059       output stream stmXMLOut close.
     1060       run bge/os_copy.p (
     1061             input "M"
     1062           , input p-xml-file-name + "tmp"
     1063           , input p-xml-file-name + "xml"
     1064           , output v-error-num
     1065       ).
     1066       if p-last-file = yes
     1067       then do:
     1068           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1069               run bgelib-tag-close( input 0, input "export" ).
     1070           output stream stmXMLOut close.
     1071           run bge/os_copy.p (
     1072                 input "M"
     1073               , input p-list-file-name + "tmp"
     1074               , input p-list-file-name + "xml"
     1075               , output v-error-num
     1076           ).
     1077       end.
     1078   end.
     1079   end procedure.
     1080   procedure bgelib-filename :
     1081   do
     1082   on error undo, return error
     1083   :
     1084   define input parameter p-prefix             as character    no-undo.
     1085   define output parameter p-xml-file-name     as character    no-undo.
     1086   define output parameter p-log-file-name     as character    no-undo.
     1087   define output parameter p-list-file-name    as character    no-undo.
     1088       define variable v-home-dir  as character    no-undo.
     1089       define variable v-error-num as integer      no-undo.
     1090       get-key-value section "BGE" key "outdir" value v-home-dir.
     1091       if v-home-dir = ?
     1092       then do:
     1093           message
     1094             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1095             skip(1)
     1096             skip "Обратитесь к администратору."
     1097           view-as alert-box error.
     1098           undo, return error .
     1099       end.
     1100       run gbl/dir-cre.p (
     1101           input v-home-dir
     1102       ) no-error.
     1103       if error-status :error
     1104       then do:
     1105           message
     1106             skip "Неверно задан каталог экспорта."
     1107             skip(1)
     1108             skip "Обратитесь к администратору."
     1109           view-as alert-box error.
     1110           undo, return error .
     1111       end.
     1112       run bge/genfname.p (
     1113             input v-home-dir
     1114           , input p-prefix
     1115           , input ""
     1116           , input "xml"
     1117           , input "tmp"
     1118           , output p-xml-file-name
     1119       ).
     1120       assign
     1121           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1122           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1123           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1124       .
     1125   end.
     1126   end procedure.
     1127   procedure bgelib-read-config :
     1128   do
     1129   on error undo, return error
     1130   :
     1131   define variable v-par-type as character     no-undo.
     1132     define variable v-param-type      as character  no-undo .
     1133     define variable v-value-character as character  no-undo .
     1134     define variable v-value-date      as date       no-undo .
     1135     define variable v-value-decimal   as decimal    no-undo .
     1136     define variable v-value-integer   as integer    no-undo .
     1137     define variable v-value-logical   as logical    no-undo .
     1138     define variable v-tth             as handle     no-undo .
     1139       assign
     1140           v-bgelib-bgeclall = no
     1141           v-bgelib-bgedict  = no
     1142       .
     1143       run adm/shattri.p ( input "get":U
     1144                         , input  '':u
     1145                         , input  0
     1146                         , input  'bge-export':U
     1147                         , input  'bgeclall':U
     1148                         , output v-value-character
     1149                         , output v-value-date
     1150                         , output v-value-decimal
     1151                         , output v-value-integer
     1152                         , output v-value-logical
     1153                         , output v-param-type
     1154                         , input-output table-handle v-tth
     1155                         ) no-error .
     1156       if error-status :error
     1157       then do:
     1158         assign
     1159           v-bgelib-bgeclall = no
     1160         .
     1161       end.
     1162       else do:
     1163         assign
     1164           v-bgelib-bgeclall = v-value-logical
     1165         .
     1166       end.
     1167       delete object v-tth.
     1168       run adm/shattri.p ( input "get":U
     1169                         , input  '':u
     1170                         , input  0
     1171                         , input  'bge-export':U
     1172                         , input  'bgedict':U
     1173                         , output v-value-character
     1174                         , output v-value-date
     1175                         , output v-value-decimal
     1176                         , output v-value-integer
     1177                         , output v-value-logical
     1178                         , output v-param-type
     1179                         , input-output table-handle v-tth
     1180                         ) no-error .
     1181       if error-status :error
     1182       then do:
     1183         assign
     1184           v-bgelib-bgedict = no
     1185         .
     1186       end.
     1187       else do:
     1188         assign
     1189           v-bgelib-bgedict = v-value-logical
     1190         .
     1191       end.
     1192       delete object v-tth.
     1193       run adm/shattri.p ( input "get":U
     1194                         , input  '':u
     1195                         , input  0
     1196                         , input  'bge-export':U
     1197                         , input  'bgefmt':U
     1198                         , output v-value-character
     1199                         , output v-value-date
     1200                         , output v-value-decimal
     1201                         , output v-value-integer
     1202                         , output v-value-logical
     1203                         , output v-param-type
     1204                         , input-output table-handle v-tth
     1205                         ) no-error .
     1206       if error-status :error
     1207       then do:
     1208         assign
     1209           v-bgelib-bgefmt  = "xml":U
     1210         .
     1211       end.
     1212       else do:
     1213         assign
     1214           v-bgelib-bgefmt  = v-value-character
     1215         .
     1216       end.
     1217       delete object v-tth.
     1218       run adm/shattri.p ( input "get":U
     1219                         , input  '':u
     1220                         , input  0
     1221                         , input  'bge-export':U
     1222                         , input  'bgeflold':U
     1223                         , output v-value-character
     1224                         , output v-value-date
     1225                         , output v-value-decimal
     1226                         , output v-value-integer
     1227                         , output v-value-logical
     1228                         , output v-param-type
     1229                         , input-output table-handle v-tth
     1230                         ) no-error .
     1231       if error-status :error
     1232       then do:
     1233         assign
     1234           v-bgelib-bgeflold  = "old":U
     1235         .
     1236       end.
     1237       else do:
     1238         assign
     1239           v-bgelib-bgeflold  = v-value-character
     1240         .
     1241       end.
     1242       delete object v-tth.
     1243   end.
     1244   end procedure.
     1245   procedure bgelib-check-file-size :
     1246   do
     1247   on error undo, return error
     1248   :
     1249   define input parameter p-out-filename   as character    no-undo.
     1250   define output parameter p-is-big        as logical      no-undo.
     1251       define variable v-current-position    as integer        no-undo.
     1252       assign
     1253           v-current-position = seek( stmXMLOut )
     1254       .
     1255       if v-current-position / 1024 / 1024  >= 100
     1256       then do:
     1257           assign
     1258               p-is-big = yes
     1259           .
     1260       end.
     1261   end.
     1262   end procedure.
     1263   procedure bgelib-init-ext-doc-type :
     1264       define variable v-counter    as integer      no-undo.
     1265       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1266   do
     1267   for buf_temp_ext-doc-type
     1268   on error undo, return error
     1269   :
     1270       empty temp-table buf_temp_ext-doc-type.
     1271       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1272       :
     1273           create buf_temp_ext-doc-type.
     1274           assign
     1275               buf_temp_ext-doc-type.edt-key               = v-counter
     1276               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1277               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1278           .
     1279       end.
     1280   end.
     1281   end procedure.
