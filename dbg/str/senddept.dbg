     1459   procedure alienini-getkey :
     1460   define input parameter i-filename as char.
     1461   define input parameter i-section as char.
     1462   define input parameter i-key as char.
     1463   define output parameter o-value as char.
     1464   define variable EntryPointer as integer no-undo.
     1465   define variable mem1 as memptr no-undo.
     1466   define variable mem2 as memptr no-undo.
     1467   define variable mem1size as integer no-undo.
     1468   define variable mem2size as integer no-undo.
     1469   define variable ii       as integer    no-undo.
     1470   define variable cbReturnSize  as integer    no-undo.
     1471   assign
     1472   set-size(mem1)  = 4000
     1473   mem1size = 4000.
     1474   if i-key = "" then EntryPointer = 0.
     1475   else do:
     1476     assign
     1477     set-size(mem2) = 128
     1478     mem2size = 128
     1479     EntryPointer = get-pointer-value(mem2)
     1480     put-string(mem2, 1) = i-key.
     1481   end.
     1482   run getprivateprofilestringA
     1483                                 (i-section,
     1484                                  EntryPointer,
     1485                                  "",
     1486                                  get-pointer-value(mem1),
     1487                                  input mem1size,
     1488                                  i-filename,
     1489                                  output cbReturnSize).
     1490   do ii = 1 to cbReturnSize:
     1491     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1492                  then o-value + ","
     1493                  else o-value + chr(get-byte(mem1, ii)).
     1494   end.
     1495     set-size(mem1) = 0.
     1496     set-size(mem2) = 0.
     1497   end procedure.
     1498   procedure alienini-putkey :
     1499   define input parameter i-filename as char.
     1500   define input parameter i-section as char.
     1501   define input parameter i-key as char.
     1502   define input parameter i-value as char.
     1503   define variable cbReturnSize as integer.
     1504   run writeprivateprofilestringA
     1505                                  (i-section,
     1506                                   i-key,
     1507                                   i-value,
     1508                                   i-filename,
     1509                                   output cbReturnSize ).
     1510   end procedure.
     1511   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1512     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1513     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1514     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1515     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1516     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1517     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1518     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1519   END PROCEDURE.
     1520   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1521     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1522     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1523     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1524     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1525     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1526   END PROCEDURE.
