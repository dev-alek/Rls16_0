     1294   procedure xml-cd-write-header:
     1295   do
     1296   on error undo, return error
     1297   :
     1298   define input parameter p-xml-file-name       as character    no-undo.
     1299   define input parameter p-xml-file-name-path  as character    no-undo.
     1300   define input parameter p-doc-name            as character    no-undo.
     1301   define input parameter p-version             as character    no-undo.
     1302   define input parameter p-obj-list            as character    no-undo.
     1303   define input parameter p-correspondent       as character    no-undo .
     1304   define input parameter p-write-header        as logical      no-undo .
     1305   define variable OS-time as character no-undo .
     1306   define variable id as character no-undo .
     1307   define buffer buf_db for ub.db.
     1308   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1309   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1310   assign
     1311   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1312   .
     1313   run bgelib-tag-open in this-procedure (
     1314                                        1
     1315                                       ,p-doc-name
     1316                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1317                                         ).
     1318   if p-write-header then do:
     1319     run bgelib-tag-open(2, "Header","").
     1320     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1321     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1322     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1323     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1324     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1325     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1326     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1327     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1328     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1329     run bgelib-tag-close( 2, "Header" ).
     1330   end.
     1331   output stream stmXMLOut close.
     1332   end.
     1333   end procedure.
     1334   procedure xml-cd-write-footer:
     1335   do
     1336   on error undo, return error
     1337   :
     1338   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1339   define input parameter p-xml-file-name as character    no-undo.
     1340   define input parameter p-doc-name      as character    no-undo .
     1341   define variable v-error-num     as integer           no-undo.
     1342   define variable v-md5-signature as character no-undo .
     1343   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1344   run bgelib-tag-close( 0, p-doc-name ).
     1345   put stream stmXMLOut unformatted skip.
     1346   output stream stmXMLOut close.
     1347   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1348   if v-error-num > 0
     1349   then do:
     1350      return error.
     1351   end.
     1352   if opsys = "unix"
     1353   then do:
     1354       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1355   end.
     1356   end.
     1357   end procedure.
     1358   procedure xml-cd-filename :
     1359   do
     1360   on error undo, return error
     1361   :
     1362   define input parameter  p-out               as character no-undo .
     1363   define output parameter p-xml-file-name     as character    no-undo.
     1364   define output parameter p-xml-file-name-path   as character    no-undo.
     1365   define output parameter p-log-file-name     as character    no-undo.
     1366   define output parameter p-locked            as logical      no-undo.
     1367   define variable v-out as character     no-undo.
     1368   define variable loc#log as logical no-undo .
     1369   define variable BadFlag as logical no-undo .
     1370   define variable fq as integer no-undo .
     1371   define variable v-remote as character no-undo .
     1372   assign
     1373   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1374   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1375   p-log-file-name = p-out + "actions.log"
     1376   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1377   .
     1378   end.
     1379   end procedure.
     1380   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1381   define variable v-date-str as character no-undo .
     1382   assign
     1383   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1384                string(Month(p-date), "99":U) + "-":U +
     1385                string(DAY(p-date), "99":U).
     1386   return v-date-str.
     1387   END FUNCTION.
     1388   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1389   define variable v-date-str as character no-undo .
     1390   assign
     1391   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1392                string(Month(p-date), "99":U) + "-":U +
     1393                string(DAY(p-date), "99":U) + chr(32) +
     1394                string(p-time, "HH:MM:SS").
     1395   return v-date-str.
     1396   END FUNCTION.
     1397   function string-to-date returns date ( input p-string  as character):
     1398     define variable v-date as date no-undo .
     1399     assign
     1400     v-date = date(integer(substring(p-string, 4, 2))
     1401                   ,integer(substring(p-string, 1, 2))
     1402                   ,integer(substring(p-string, 7, 4))
     1403                  ) no-error .
     1404     if error-status:error then return ?.
     1405     return v-date.
     1406   END FUNCTION.
     1407   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1408   define variable v-time as integer no-undo init ?.
     1409   define variable v-dop1 as character no-undo .
     1410   define variable v-dop2 as character no-undo .
     1411   assign
     1412   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1413   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1414   no-error .
     1415   if error-status:error then return ?.
     1416   assign
     1417   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1418             integer(entry(2, v-dop2, ";":U)) * 60 +
     1419             integer(entry(3, v-dop2, ";":U)) no-error .
     1420   return v-time.
     1421   END FUNCTION.
