        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Параметры расчета ретро-бонусов".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define input  parameter parParentProc  as widget-handle no-undo.
       62   define input  parameter p-host-code    as integer   no-undo .
       63   define input  parameter p-doc-num      as integer   no-undo .
       64   define input  parameter p-gds-code     as integer   no-undo .
       65   define input-output parameter p-retro-bonus   as character no-undo .
       66   define temp-table tt-bonus no-undo
       67     field date-from   as  date
       68     field date-to     as  date
       69     field pct         as  decimal
       70     field sum         as  decimal
       71     field method      as  character
       72     field vozvrat     as  logical
       73     index pi is unique primary date-from date-to
       74   .
       75   define variable v-date-from as date      no-undo.
       76   define variable v-date-to   as date      no-undo.
       77   define variable v-pct       as decimal   no-undo.
       78   define variable v-sum       as decimal   no-undo.
       79   define variable v-method    as character no-undo.
       80   define variable v-vozvrat   as logical   no-undo.
       81   define variable tt-create   as logical   no-undo.
       82   define variable v-rowid     as rowid     no-undo.
       83   DEFINE BUTTON b-add
       84        LABEL "&Добавить"
       85        SIZE 15 BY 1.14.
       86   DEFINE BUTTON b-chg
       87        LABEL "&Изменить"
       88        SIZE 15 BY 1.14.
       89   DEFINE BUTTON b-del
       90        LABEL "&Удалить"
       91        SIZE 15 BY 1.14.
       92   DEFINE BUTTON b-exit AUTO-GO
       93        LABEL "&Ввод"
       94        SIZE 15 BY 1.14
       95        BGCOLOR 8 .
       96   DEFINE BUTTON b-quit AUTO-END-KEY
       97        LABEL "&Отмена"
       98        SIZE 15 BY 1.14
       99        BGCOLOR 8 .
      100   DEFINE QUERY BROWSE-bonus FOR
      101         tt-bonus SCROLLING.
      102   DEFINE BROWSE BROWSE-bonus
      103     QUERY BROWSE-bonus NO-LOCK DISPLAY
      104         tt-bonus.date-from column-label "С":C10 format "99/99/9999"
      105         tt-bonus.date-to   column-label "По":C10 format "99/99/9999"
      106         tt-bonus.pct       column-label "%":C5 format ">>9.99<<"
      107         tt-bonus.sum       column-label "Сумма":C18 format ">>>>>>>>9.99<<"
      108         if tt-bonus.method = "vat-yes" then "Приход с НДС" else "Приход без НДС"    column-label "Метод":C23 format "X(15)"
      109         tt-bonus.vozvrat   column-label "Запрет! возвратов":C   format "yes/no"
      110       WITH NO-ROW-MARKERS SEPARATORS SIZE 83 BY 7.45 FIT-LAST-COLUMN.
      111   DEFINE FRAME Dialog-Frame
      112        b-exit AT ROW 1 COL 1
      113        b-quit AT ROW 1 COL 16
      114        BROWSE-bonus AT ROW 2.5 COL 3 WIDGET-ID 200
      115        b-add AT ROW 10.52 COL 3 WIDGET-ID 4
      116        b-chg AT ROW 10.52 COL 18 WIDGET-ID 6
      117        b-del AT ROW 10.52 COL 33 WIDGET-ID 8
      118        SPACE(40.59) SKIP(0.62)
      119       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      120            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      121            TITLE "Параметры расчета ретро-бонусов"
      122            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      123   ASSIGN
      124          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      125          FRAME Dialog-Frame:HIDDEN           = TRUE.
      126   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      127   DO:
      128     APPLY "END-ERROR":U TO SELF.
      129   END.
      130   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      131   DO:
      132     p-retro-bonus = "".
      133     for each tt-bonus no-lock :
      134         p-retro-bonus = p-retro-bonus + string(tt-bonus.date-from) + ","
      135                                       + string(tt-bonus.date-to)   + ","
      136                                       + string(tt-bonus.pct)       + ","
      137                                       + string(tt-bonus.sum)       + ","
      138                                       + tt-bonus.method            + ","
      139                                       + string(tt-bonus.vozvrat)   + ";"
      140         .
      141     end.
      142   END.
      143   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      144   DO:
      145      run str\cont-bn1.w
      146         ( input parParentProc,
      147           input no,
      148           input table tt-bonus,
      149           input-output v-date-from,
      150           input-output v-date-to,
      151           input-output v-pct,
      152           input-output v-sum,
      153           input-output v-method,
      154           input-output v-vozvrat,
      155           input-output tt-create  ).
      156      if tt-create then do :
      157         create tt-bonus.
      158         assign
      159           tt-bonus.date-from = v-date-from
      160           tt-bonus.date-to   = v-date-to
      161           tt-bonus.pct       = v-pct
      162           tt-bonus.sum       = v-sum
      163           tt-bonus.method    = v-method
      164           tt-bonus.vozvrat   = v-vozvrat
      165         .
      166         v-rowid = rowid(tt-bonus).
      167         open query BROWSE-bonus for each tt-bonus.
      168         view BROWSE-bonus.
      169         reposition BROWSE-bonus to rowid v-rowid.
      170      end.
      171   END.
      172   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      173   DO:
      174      Get current BROWSE-bonus exclusive-lock.
      175      if not available tt-bonus then return no-apply.
      176      assign
      177        v-date-from = tt-bonus.date-from
      178        v-date-to   = tt-bonus.date-to
      179        v-pct       = tt-bonus.pct
      180        v-sum       = tt-bonus.sum
      181        v-method    = tt-bonus.method
      182        v-vozvrat   = tt-bonus.vozvrat
      183      .
      184      delete tt-bonus.
      185      run str\cont-bn1.w
      186         ( input parParentProc,
      187           input yes,
      188           input table tt-bonus,
      189           input-output v-date-from,
      190           input-output v-date-to,
      191           input-output v-pct,
      192           input-output v-sum,
      193           input-output v-method,
      194           input-output v-vozvrat,
      195           input-output tt-create  ).
      196      if tt-create then do :
      197         create tt-bonus.
      198         assign
      199           tt-bonus.date-from = v-date-from
      200           tt-bonus.date-to   = v-date-to
      201           tt-bonus.pct       = v-pct
      202           tt-bonus.sum       = v-sum
      203           tt-bonus.method    = v-method
      204           tt-bonus.vozvrat   = v-vozvrat
      205         .
      206         v-rowid = rowid(tt-bonus).
      207         open query BROWSE-bonus for each tt-bonus.
      208         view BROWSE-bonus.
      209         reposition BROWSE-bonus to rowid v-rowid.
      210      end.
      211   END.
      212   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      213   DO:
      214      if not available tt-bonus then return no-apply.
      215      MESSAGE "Вы уверены?"
      216      VIEW-AS ALERT-BOX QUESTION
      217      BUTTONS yes-no UPDATE continue-ok AS LOGICAL.
      218      IF continue-ok
      219        THEN DO:
      220         GET CURRENT browse-bonus exclusive-lock.
      221         DELETE tt-bonus.
      222         browse-bonus:DELETE-SELECTED-ROWS().
      223      END.
      224   END.
      225   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      226   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      227   MAIN-BLOCK:
      228   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      229      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      230     for each tt-bonus :
      231       delete tt-bonus.
      232     end.
      233     define variable i as integer no-undo .
      234     do i = 1 to num-entries(p-retro-bonus, ';') - 1 :
      235        create tt-bonus.
      236        assign
      237           tt-bonus.date-from = date    (entry(1, entry(i, p-retro-bonus, ';')))
      238           tt-bonus.date-to   = date    (entry(2, entry(i, p-retro-bonus, ';')))
      239           tt-bonus.pct       = decimal (entry(3, entry(i, p-retro-bonus, ';')))
      240           tt-bonus.sum       = decimal (entry(4, entry(i, p-retro-bonus, ';')))
      241           tt-bonus.method    =         (entry(5, entry(i, p-retro-bonus, ';')))
      242           tt-bonus.vozvrat   = logical (entry(6, entry(i, p-retro-bonus, ';')))
      243        .
      244     end.
      245     RUN enable_UI.
      246     WAIT-FOR GO OF FRAME Dialog-Frame.
      247   END.
      248   RUN disable_UI.
      249   PROCEDURE disable_UI :
      250     HIDE FRAME Dialog-Frame.
      251   END PROCEDURE.
      252   PROCEDURE enable_UI :
      253     ENABLE b-exit b-quit BROWSE-bonus b-add b-chg b-del
      254         WITH FRAME Dialog-Frame.
      255     VIEW FRAME Dialog-Frame.
      256     open query BROWSE-bonus for each tt-bonus.
      257     view BROWSE-bonus.
      258   END PROCEDURE.
