      698   procedure prn-lib-open-stream :
      699     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      700     define input parameter p-page-size    as integer no-undo .
      701     define input parameter p-is-stream    as logical no-undo .
      702     define input parameter p-append       as logical no-undo .
      703     define variable v-report-name as character no-undo .
      704     do
      705       on error undo, return error
      706       :
      707       run prn-lib-get-report-name  in this-procedure (
      708         input parParentProc
      709         ,output v-report-name
      710         ).
      711       if p-is-stream then
      712       do:
      713         if p-append then
      714         do:
      715           output stream PrnLibStream to value( v-report-name )
      716             page-size value(p-page-size) append .
      717         end.
      718         if not p-append then
      719         do:
      720           output stream PrnLibStream to value( v-report-name )
      721             page-size value(p-page-size) .
      722         end.
      723       end.
      724       if not p-is-stream then
      725       do:
      726         if p-append then
      727         do:
      728           output to value( v-report-name )
      729             page-size value(p-page-size) append .
      730         end.
      731         if not p-append then
      732         do:
      733           output to value( v-report-name )
      734             page-size value(p-page-size) .
      735         end.
      736       end.
      737     end.
      738   end procedure.
      739   procedure prn-lib-open-exp :
      740     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      741     define input parameter p-is-stream    as logical no-undo .
      742     define input parameter p-is-append    as logical no-undo .
      743     define output parameter p-ReportFileName as char init "report" no-undo.
      744     define output parameter p-process as logical no-undo .
      745     define variable glog as logical no-undo .
      746     do
      747       on error undo, return error
      748       :
      749       SYSTEM-DIALOG GET-FILE p-ReportFileName
      750         TITLE      "Укажите путь"
      751         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      752         ASK-OVERWRITE
      753         CREATE-TEST-FILE
      754         SAVE-AS
      755         USE-FILENAME
      756         DEFAULT-EXTENSION "txt"
      757         UPDATE glog
      758         .
      759       if not glog then  return.
      760       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      761       if p-is-stream then
      762       do:
      763         if p-is-append then
      764         do:
      765           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      766         end.
      767         else
      768         do:
      769           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      770         end.
      771       end.
      772       else
      773       do:
      774         if p-is-append then
      775         do:
      776           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      777         end.
      778         else
      779         do:
      780           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      781         end.
      782       end.
      783       p-process = yes.
      784     end.
      785   end procedure.
