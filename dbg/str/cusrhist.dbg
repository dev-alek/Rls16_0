      796   procedure prn-lib-reportviewer :
      797     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      798     define input parameter p-report-name-html as character no-undo .
      799     define input parameter p-param        as character no-undo .
      800     define variable v-excel           as character no-undo init 'TRUE' .
      801     define variable v-value-character as character no-undo .
      802     define variable v-value-integer   as character no-undo .
      803     define variable v-value-date      as date      no-undo .
      804     define variable v-value-decimal   as decimal   no-undo .
      805     define variable rep-excel         as logical   no-undo .
      806     define variable excel-string      as character no-undo .
      807     define variable v-param-type      as character no-undo .
      808     define variable v-tth             as handle    no-undo .
      809     run adm/shattri.p (
      810       input "get":U
      811       ,input  ""
      812       ,input  0
      813       ,input  'report-glob':U
      814       ,input  'rep-excel':U
      815       ,output v-value-character
      816       ,output v-value-date
      817       ,output v-value-decimal
      818       ,output v-value-integer
      819       ,output rep-excel
      820       ,output v-param-type
      821       ,INPUT-OUTPUT table-handle v-tth
      822       )  .
      823     if rep-excel then v-excel = "TRUE" .
      824     else v-excel = "FALSE" .
      825     if p-param eq ""
      826     then
      827        p-param = "EXCEL:" + v-excel.
      828     else
      829        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      830     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      831   end procedure.
