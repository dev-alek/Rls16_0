     1079   FUNCTION get-all-fields returns character (p-file-name as character ):
     1080   define variable v-dop as character no-undo .
     1081     find first _file no-lock where _file._file-name = p-file-name no-error .
     1082     if not available _file then return "":U.
     1083     for each _field no-lock where
     1084              _field._file-recid = recid(_file) :
     1085       assign
     1086       v-dop = v-dop + _field._field-name + chr(44)
     1087       .
     1088     end.
     1089     return trim(v-dop).
     1090   END FUNCTION.
     1091   PROCEDURE proc-full-temp-changes :
     1092     define input  parameter p-hst-handle as handle    no-undo .
     1093     define input  parameter p-main-table as character no-undo .
     1094     define input  parameter p-field-list as character no-undo .
     1095     define input  parameter p-label-form as character no-undo .
     1096     define variable h-new-buf         as handle    no-undo .
     1097     define variable h-main-buf        as handle    no-undo .
     1098     define variable h-for-comp        as handle    no-undo .
     1099     define variable v-inform          as character no-undo .
     1100     define variable v-ind             as integer   no-undo .
     1101     define variable v-idx-field-qnty  as integer   no-undo .
     1102     define variable v-num-entries     as integer   no-undo .
     1103     define variable fh                as handle    no-undo .
     1104     define variable fh-main           as handle    no-undo .
     1105     define variable fh-old            as handle    no-undo .
     1106     define variable fh-new            as handle    no-undo .
     1107     define variable v-field-name      as character no-undo .
     1108     define variable v-field-lvl       as character no-undo .
     1109     define variable v-field-form      as character no-undo .
     1110     define variable v-search-exp      as character no-undo .
     1111     define variable v-srch-main       as character no-undo .
     1112     define variable v-word-link       as character no-undo .
     1113     define variable v-av-chip-num     as logical   no-undo .
     1114     define variable v-main-pi-fld-lst as character no-undo .
     1115     define variable v-main-fld-lst    as character no-undo .
     1116     define variable v-delim-list      as character no-undo .
     1117     define variable v-label           as character no-undo .
     1118     define variable v-old-value       as character no-undo case-sensitive.
     1119     define variable v-new-value       as character no-undo case-sensitive.
     1120     define variable v-chg-fields as character no-undo.
     1121     for each temp-changes:
     1122       delete temp-changes.
     1123     end.
     1124     if not p-hst-handle:available then do:
     1125       return .
     1126     end.
     1127     create buffer h-new-buf  for table p-hst-handle .
     1128     create buffer h-main-buf for table p-main-table .
     1129     assign
     1130       v-inform = h-main-buf:index-information(1)
     1131       v-ind    = 2
     1132     .
     1133     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1134     on error undo, return error
     1135     :
     1136       assign
     1137         v-inform = h-main-buf:index-information( v-ind )
     1138         v-ind    = v-ind + 1
     1139       .
     1140     end.
     1141     if v-inform = ?
     1142       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1143       or entry( 3, v-inform, ",":U ) <> "1":U
     1144     then do:
     1145       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1146     end.
     1147     assign
     1148       v-idx-field-qnty = num-entries( v-inform ) - 4
     1149     .
     1150     if v-idx-field-qnty < 2 then do:
     1151       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1152     end.
     1153     assign
     1154       v-srch-main   = "where":U
     1155       v-word-link   = "":U
     1156       v-av-chip-num = false
     1157       v-delim-list  = "":U
     1158     .
     1159     do v-ind = 1 to v-idx-field-qnty by 2
     1160     on error undo, return error
     1161     :
     1162       assign
     1163         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1164         fh                = p-hst-handle:buffer-field( v-field-name )
     1165         fh-main           = h-main-buf:buffer-field( v-field-name )
     1166         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1167         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1168       .
     1169       if fh:data-type ="character":U then do:
     1170         assign
     1171           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1172         .
     1173       end.
     1174       else do:
     1175         assign
     1176           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1177         .
     1178       end.
     1179       if v-delim-list = "":U then do:
     1180         assign
     1181           v-delim-list = ",":U
     1182         .
     1183       end.
     1184       if v-word-link = "":U then do:
     1185         assign
     1186           v-word-link = "and":U
     1187         .
     1188       end.
     1189     end.
     1190     assign
     1191       v-delim-list  = "":U
     1192     .
     1193     do v-ind = 1 to h-main-buf:num-fields
     1194     on error undo, return error
     1195     :
     1196       assign
     1197         fh-main      = h-main-buf:buffer-field( v-ind )
     1198         v-field-name = fh-main:name
     1199       .
     1200         assign
     1201           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1202         .
     1203         if v-delim-list = "":U then do:
     1204           assign
     1205             v-delim-list = ",":U
     1206           .
     1207         end.
     1208     end.
     1209     assign
     1210       v-inform = p-hst-handle:index-information(1)
     1211       v-ind    = 2
     1212     .
     1213     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1214     on error undo, return error
     1215     :
     1216       assign
     1217         v-inform = p-hst-handle:index-information( v-ind )
     1218         v-ind    = v-ind + 1
     1219       .
     1220     end.
     1221     if v-inform = ?
     1222       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1223       or entry( 3, v-inform, ",":U ) <> "1":U
     1224     then do:
     1225       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1226     end.
     1227     assign
     1228       v-idx-field-qnty = num-entries( v-inform ) - 4
     1229     .
     1230     if v-idx-field-qnty < 2 then do:
     1231       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1232     end.
     1233     assign
     1234       v-search-exp  = "where":U
     1235       v-word-link   = "":U
     1236       v-av-chip-num = false
     1237     .
     1238     do v-ind = 1 to v-idx-field-qnty by 2
     1239     on error undo, return error
     1240     :
     1241       assign
     1242         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1243         fh           = p-hst-handle:buffer-field( v-field-name )
     1244         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1245       .
     1246       if v-field-name = "chip-num":U then do:
     1247         assign
     1248           v-search-exp  = substitute( "&1 >", v-search-exp )
     1249           v-av-chip-num = true
     1250         .
     1251       end.
     1252       else do:
     1253         assign
     1254           v-search-exp = substitute( "&1 =", v-search-exp )
     1255         .
     1256       end.
     1257       if fh:data-type ="character":U then do:
     1258         assign
     1259           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1260         .
     1261       end.
     1262       else do:
     1263         assign
     1264           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1265         .
     1266       end.
     1267       if v-word-link = "":U then do:
     1268         assign
     1269           v-word-link = "and":U
     1270         .
     1271       end.
     1272     end.
     1273     if v-av-chip-num = false then do:
     1274       message
     1275         vss-workfile vss-revision vss-description skip
     1276         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1277         "Использование данной процедуры невозможно!" skip
     1278         view-as alert-box error .
     1279       return error .
     1280     end.
     1281     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1282     if not h-new-buf:available then do:
     1283       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1284       if not h-main-buf:available then do:
     1285         assign
     1286           h-for-comp = ?
     1287         .
     1288       end.
     1289       else do:
     1290         assign
     1291           h-for-comp = h-main-buf
     1292         .
     1293       end.
     1294     end.
     1295     else do:
     1296       assign
     1297         h-for-comp = h-new-buf
     1298       .
     1299     end.
     1300     assign
     1301       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1302     .
     1303     do v-ind = 1 to v-num-entries
     1304     on error undo, return error return-value
     1305     :
     1306       assign
     1307         v-field-name = entry( v-ind, v-main-fld-lst )
     1308         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1309         v-old-value  = fh-old:buffer-value()
     1310         v-label      = trim( fh-old:label )
     1311       .
     1312       if ( trim( p-field-list ) <> "":U
     1313            and lookup( v-field-name, p-field-list ) > 0
     1314          )
     1315          or trim( p-field-list ) = "":U
     1316       then do:
     1317         if h-for-comp <> ? then do:
     1318           assign
     1319             fh-new      = h-for-comp:buffer-field( v-field-name )
     1320             v-new-value = fh-new:buffer-value()
     1321           .
     1322         end.
     1323         else do:
     1324           assign
     1325             v-new-value = "":U
     1326           .
     1327         end.
     1328         if v-old-value <> v-new-value
     1329         then do:
     1330           create temp-changes.
     1331           assign
     1332             temp-changes.t_name = p-main-table
     1333             temp-changes.f_name = v-field-name
     1334             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1335             temp-changes.v_old  = trim( v-old-value )
     1336             temp-changes.v_new  = trim( v-new-value )
     1337             temp-changes.num_   = 0
     1338             temp-changes.fNotChange = v-old-value eq v-new-value
     1339           .
     1340         end.
     1341       end.
     1342     end.
     1343     assign
     1344       v-num-entries = num-entries( p-label-form, chr(8) )
     1345     .
     1346     do v-ind = 1 to v-num-entries
     1347     on error undo, return error return-value
     1348     :
     1349       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1350         assign
     1351           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1352           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1353           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1354         .
     1355         find first temp-changes
     1356           where temp-changes.f_name = v-field-name
     1357           no-error .
     1358         if available temp-changes then do:
     1359           if trim( v-field-lvl ) <> "":U then do:
     1360             assign
     1361               temp-changes.l_name = v-field-lvl
     1362             .
     1363           end.
     1364           if trim( v-field-form ) <> "":U then do:
     1365             assign
     1366               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1367             .
     1368             if h-for-comp <> ? then do:
     1369               assign
     1370                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1371               .
     1372             end.
     1373           end.
     1374         end.
     1375       end.
     1376       else do:
     1377         message
     1378           vss-workfile vss-revision vss-description skip
     1379           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1380           substitute( "список для поля '&1': '&2'"
     1381                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1382                       ,entry( v-ind, p-label-form, chr(8) )
     1383                     ) skip
     1384           substitute( "полный список: &2", p-label-form ) skip
     1385           view-as alert-box error .
     1386       end.
     1387     end.
     1388     delete object h-new-buf .
     1389     delete object h-main-buf .
     1390   END PROCEDURE.
     1391   FUNCTION get-action RETURNS CHARACTER
     1392     ( p-action as integer )  FORWARD.
     1393   FUNCTION get-place RETURNS CHARACTER
     1394     ( p-obj-type as character, p-obj-code as integer, p-pl-code as integer )  FORWARD.
     1395   FUNCTION get-subject RETURNS CHARACTER
     1396     ( p-subject as character )  FORWARD.
     1397   DEFINE BUTTON B-Help
     1398     LABEL "Помо&щь"
     1399     SIZE 3 BY 1
     1400     BGCOLOR 8 .
     1401   DEFINE BUTTON B-lookup
     1402     LABEL "&Просмотр"
     1403     SIZE 10 BY 1.
     1404   DEFINE BUTTON B-mark
     1405     LABEL "&*"
     1406     SIZE 3 BY 1.
     1407   DEFINE BUTTON B-print
     1408     LABEL "Пе&чать"
     1409     SIZE 3 BY 1.
     1410   DEFINE BUTTON b-quit AUTO-END-KEY
     1411     LABEL "&Выход"
     1412     SIZE 10 BY 1
     1413     BGCOLOR 8 .
     1414   DEFINE BUTTON B-sch
     1415     LABEL "&Фильтр"
     1416     SIZE 3 BY 1.
     1417   DEFINE BUTTON b-sel AUTO-GO
     1418     LABEL "Вы&бор"
     1419     SIZE 10 BY 1
     1420     BGCOLOR 8 .
     1421   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1422     VIEW-AS TEXT
     1423     SIZE 6 BY 1
     1424     FGCOLOR 4 NO-UNDO.
     1425   DEFINE QUERY BR-changes FOR
     1426     temp-changes SCROLLING.
     1427   DEFINE QUERY br-usr-hist FOR
     1428     X_c-usr-hist SCROLLING.
     1429   DEFINE BROWSE BR-changes
     1430     QUERY BR-changes DISPLAY
     1431     temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1432     temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1433     temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1434       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.29.
     1435   DEFINE BROWSE br-usr-hist
     1436     QUERY br-usr-hist NO-LOCK DISPLAY
     1437     mark-string(recid(X_c-usr-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1438     X_c-usr-hist.corr-date FORMAT "99/99/9999":U
     1439     string(X_c-usr-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1440     usrfulnf(X_c-usr-hist.corr-user-name) FORMAT "X(18)":U
     1441     get-action(X_c-usr-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1442     X_c-usr-hist.corr-user-db-num FORMAT ">>>>9":U
     1443     X_c-usr-hist.subject COLUMN-LABEL "Предмет изменений" FORMAT "X(15)":U
     1444     ENABLE
     1445         X_c-usr-hist.corr-DATE
     1446       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1447   DEFINE FRAME Dialog-Frame
     1448     b-quit AT ROW 1 COL 1
     1449     B-mark AT ROW 1 COL 11
     1450     b-sel AT ROW 1 COL 21
     1451     B-print AT ROW 1 COL 89
     1452     B-sch AT ROW 1 COL 92
     1453     B-Help AT ROW 1 COL 95
     1454     B-lookup AT ROW 1.04 COL 45
     1455     br-usr-hist AT ROW 2 COL 1
     1456     BR-changes AT ROW 13.75 COL 1
     1457     mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1458     SPACE(78.74) SKIP(20.07)
     1459     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1460     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1461     TITLE "Полная история по пользователю"
     1462     CANCEL-BUTTON b-quit.
     1463   ASSIGN
     1464     FRAME Dialog-Frame:SCROLLABLE = FALSE
     1465     FRAME Dialog-Frame:HIDDEN     = TRUE.
     1466   ON GO OF FRAME Dialog-Frame
     1467     DO:
     1468       p-rid-list = v-rid-list.
     1469     END.
     1470   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1471     DO:
     1472       APPLY "END-ERROR":U TO SELF.
     1473     END.
     1474   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1475     DO:
     1476       define variable loc#log as logical no-undo .
     1477       if available X_c-usr-hist then
     1478       do:
     1479   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1480   define variable v-str-recid15 as character no-undo .
     1481   define variable v-num-entry15 as integer   no-undo .
     1482   assign
     1483     v-str-recid15 = trim( string( recid( X_c-usr-hist ) , "->>>>>>>>>>>9":U ) )
     1484     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1485   .
     1486   if v-num-entry15 > 0 then do:
     1487     assign
     1488       entry( v-num-entry15, v-rid-list ) = "":U
     1489       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1490     .
     1491   end.
     1492   else do:
     1493     assign
     1494       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1495     .
     1496   end.
     1497         loc#log = br-usr-hist:refresh() .
     1498         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
     1499         do:
     1500           loc#log = br-usr-hist:select-next-row ().
     1501           apply "VALUE-CHANGED" to br-usr-hist in frame Dialog-Frame.
     1502         end.
     1503         if num-entries( v-rid-list ) = 0
     1504           then
     1505           hide mark-num in frame Dialog-Frame.
     1506         else
     1507           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1508       end.
     1509       apply "entry" to br-usr-hist in frame Dialog-Frame.
     1510     END.
     1511   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1512     DO:
     1513       run proc-b-sch in this-procedure no-error.
     1514       if error-status:error then return no-apply.
     1515     END.
     1516   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1517     DO:
     1518       if ( available X_c-usr-hist ) then
     1519       do:
     1520         if ( v-rid-list = "" ) or b-mark:sensitive = no
     1521           then
     1522           v-rid-list = string( recid( X_c-usr-hist ) ) .
     1523       end.
     1524     END.
     1525   ON ROW-DISPLAY OF BR-changes IN FRAME Dialog-Frame
     1526   DO:
     1527      if temp-changes.fNotChange
     1528      then do:
     1529         temp-changes.l_name:fGCOLOR in browse BR-changes = GRAY_COLOR.
     1530         temp-changes.v_old:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1531         temp-changes.v_new:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1532      end.
     1533      else do:
     1534         temp-changes.l_name:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1535         temp-changes.v_old:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1536         temp-changes.v_new:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1537      end.
     1538   END.
     1539   ON MOUSE-SELECT-DBLCLICK OF br-usr-hist IN FRAME Dialog-Frame
     1540     DO:
     1541       run proc-br-usr-hist in this-procedure no-error.
     1542       if error-status:error then return no-apply.
     1543     END.
     1544   ON RETURN OF br-usr-hist IN FRAME Dialog-Frame
     1545     DO:
     1546       run proc-br-usr-hist in this-procedure no-error.
     1547       if error-status:error then return no-apply.
     1548     END.
     1549   ON VALUE-CHANGED OF br-usr-hist IN FRAME Dialog-Frame
     1550     DO:
     1551       run proc-view-changes in this-procedure no-error.
     1552     END.
     1553   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1554     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1555   MAIN-BLOCK:
     1556   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1557     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1558     define variable v-date-start as date no-undo .
     1559     define variable v-date-end   as date no-undo .
     1560     v-date-end = today .
     1561     v-date-start = v-date-end - 30 .
     1562     for each X_c-usr-hist:
     1563       delete X_c-usr-hist .
     1564     end.
     1565     for each c-usr-hist where c-usr-hist.user-id = p-userid and c-usr-hist.corr-date > v-date-start
     1566       and (c-usr-hist.corr-date < v-date-end or c-usr-hist.corr-date = v-date-end) by c-usr-hist.corr-date desc:
     1567       create X_c-usr-hist .
     1568       buffer-copy c-usr-hist to X_c-usr-hist .
     1569     end.
     1570     OPEN QUERY br-usr-hist FOR EACH X_c-usr-hist NO-LOCK by X_c-usr-hist.corr-date desc INDEXED-REPOSITION .
     1571     RUN MyEnable in this-procedure .
     1572     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1573     HIDE mark-num in frame Dialog-Frame .
     1574     if v-rid-list <> "":U then
     1575       REPOSITION br-usr-hist to recid integer(entry(1, v-rid-list)) No-ERROR.
     1576     WAIT-FOR GO OF FRAME Dialog-Frame.
     1577   END.
     1578   RUN disable_UI.
     1579   PROCEDURE disable_UI :
     1580     HIDE FRAME Dialog-Frame.
     1581   END PROCEDURE.
     1582   PROCEDURE enable_UI :
     1583     DISPLAY mark-num b-sel B-print B-sch B-Help B-lookup
     1584       BR-changes
     1585       WITH FRAME Dialog-Frame.
     1586     ENABLE b-quit B-mark  br-usr-hist
     1587       WITH FRAME Dialog-Frame.
     1588     VIEW FRAME Dialog-Frame.
     1589   END PROCEDURE.
     1590   PROCEDURE MyEnable :
     1591     assign
     1592       br-usr-hist:num-locked-columns in frame Dialog-Frame  = 1
     1593       X_c-usr-hist.corr-DATE:read-only in browse br-usr-hist = yes
     1594       br-changes:title                                       = "":U
     1595       temp-changes.l_name:resizable in browse br-changes     = true
     1596       temp-changes.v_old:resizable in browse br-changes      = true
     1597       temp-changes.v_new:resizable in browse br-changes      = true
     1598       temp-changes.l_name:width in browse br-changes         = 30
     1599       temp-changes.v_old:width in browse br-changes          = 40
     1600       temp-changes.v_new:width in browse br-changes          = 40
     1601       .
     1602     VIEW frame Dialog-Frame .
     1603     DISPLAY
     1604       mark-num
     1605       B-mark
     1606       when lookup("b-mark":U, bttns) > 0
     1607       b-sel
     1608       when lookup("b-sel":U, bttns) > 0
     1609       B-lookup
     1610       B-sch
     1611       B-Print
     1612       B-Help
     1613       WITH FRAME Dialog-Frame .
     1614     ENABLE
     1615       b-quit
     1616       br-usr-hist
     1617       BR-changes mark-num
     1618       WITH FRAME Dialog-Frame .
     1619     VIEW FRAME Dialog-Frame .
     1620     hide b-lookup
     1621       in frame Dialog-Frame .
     1622   END PROCEDURE.
     1623   PROCEDURE OpenBr :
     1624     define input  parameter p-open-query     as logical   no-undo .
     1625     define input  parameter p-find-next      as logical   no-undo .
     1626     define input  parameter p-find-condition as character no-undo .
     1627     define variable l-query-was-opened as logical   no-undo .
     1628     define variable v-title            as character no-undo .
     1629     define variable title0             as character no-undo.
     1630     title0 = "История складского места" + chr(32).
     1631     run waitfram-show in this-procedure ( input "Ждите...").
     1632     define variable sort-column-phrase as character no-undo .
     1633     case sort-column-name :
     1634       when "" then
     1635         do:
     1636           assign
     1637             sort-column-phrase = ""
     1638             .
     1639         end.
     1640       otherwise
     1641       do:
     1642         assign
     1643           sort-column-phrase = "by " + sort-column-name
     1644           .
     1645       end.
     1646     end case.
     1647     define variable l-open-query as logical no-undo .
     1648     CASE p-mode :
     1649       WHEN 'все':U        THEN
     1650         DO:
     1651           assign
     1652             filter-point = filter-point0 + p-mode
     1653             filter-label = substitute("&1", filter-label0)
     1654             .
     1655   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1656   define variable  l-disable-where-17  as logical   no-undo .
     1657   define variable  l-filter-open-17    as logical   .
     1658   define variable  flt-rec-17       as recid     no-undo .
     1659   define variable  filter-name-17      as character no-undo .
     1660   define variable  where-phrase-17     as character no-undo .
     1661   define variable  sort-phrase-17      as character no-undo .
     1662   define variable  where-phrase-rus-17 as character no-undo .
     1663   define variable  sort-phrase-rus-17  as character no-undo .
     1664     run waitfram-show in this-procedure
     1665       (input "ЖДИТЕ ..."
     1666       ).
     1667   run gbl/flt-get.p
     1668     (input filter-point
     1669     ,output flt-rec-17
     1670     ,output filter-name-17
     1671     ,output where-phrase-17
     1672     ,output sort-phrase-17
     1673     ,output where-phrase-rus-17
     1674     ,output sort-phrase-rus-17
     1675     ).
     1676   if p-open-query then do:
     1677       run set-filter-name in this-procedure
     1678         (INPUT filter-name-17
     1679         ) no-error .
     1680     assign
     1681       l-filter-open-17 = false
     1682     .
     1683     if flt-rec-17 <> ?
     1684       or sort-column-phrase > ""
     1685     then do:
     1686       define variable  parameter-2-17 as character no-undo .
     1687       define variable  parameter-3-17 as character no-undo .
     1688       define variable  parameter-4-17 as character no-undo .
     1689       define variable  parameter-5-17 as character no-undo .
     1690       define variable  parameter-6-17 as character no-undo .
     1691       define variable  parameter-7-17 as character no-undo .
     1692         assign
     1693         parameter-3-17 =
     1694                                 "FOR EACH X_c-usr-hist"
     1695         parameter-4-17 =
     1696           (
     1697             if (" TRUE " + " " + where-phrase-17) <> ""
     1698             then " TRUE " + " " + where-phrase-17
     1699             else "true"
     1700           )
     1701         parameter-5-17 = (" " + "" + " " + "")
     1702         parameter-6-17 = if sort-phrase-17 = ''
     1703                              then
     1704           (
     1705           " " + " use-index  ie02 " +
     1706             " " + sort-column-phrase +
     1707           " " + "  "
     1708           )
     1709                              else
     1710           (
     1711           " " + " use-index  ie02 " +
     1712             " " + sort-column-phrase +
     1713           " " + sort-phrase-17
     1714           )
     1715         parameter-7-17 =
     1716           " indexed-reposition  "
     1717       .
     1718       do
     1719       on stop undo, leave
     1720       on error undo, leave
     1721       :
     1722         assign
     1723           l-disable-where-17 =
     1724             (" TRUE " + " " + where-phrase-17 = "")
     1725         .
     1726         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     1727                             ,input query br-usr-hist:handle
     1728                             ,input parameter-3-17
     1729                             ,input parameter-4-17
     1730                             ,input parameter-5-17
     1731                             ,input parameter-6-17
     1732                             ,input parameter-7-17
     1733                             )
     1734         .
     1735         assign
     1736           l-filter-open-17 = true
     1737         .
     1738       end.
     1739       if l-filter-open-17 = false then do:
     1740         message
     1741           "Ошибка при фильтрации / сортировке" skip
     1742           "Будут показаны записи без учета фильтра" skip
     1743           view-as alert-box .
     1744       end.
     1745       else do:
     1746           assign
     1747             l-query-was-opened = true
     1748           .
     1749       end.
     1750     end.
     1751     if l-filter-open-17 = false then do:
     1752       OPEN QUERY br-usr-hist FOR EACH X_c-usr-hist
     1753         where  TRUE
     1754          use-index  ie02
     1755         indexed-reposition
     1756     .
     1757         assign
     1758           l-query-was-opened = true
     1759         .
     1760     end.
     1761   end.
     1762   else do:
     1763     assign
     1764       v-doc-rec = recid( X_c-usr-hist )
     1765     .
     1766     do
     1767     on stop undo, leave
     1768     on error undo, leave
     1769     :
     1770       if query br-usr-hist:handle:get-buffer-handle(1) = (buffer X_c-usr-hist:handle) then do:
     1771         assign
     1772         parameter-2-17 = (if p-find-next then "true":u else "false":u )
     1773         parameter-4-17 =
     1774           "where ":u + " TRUE " + " ":u + where-phrase-17 + " ":u + p-find-condition + " " + ""
     1775         parameter-5-17 = " use-index  ie02 "
     1776       .
     1777         run fltopend_fltfindd in this-procedure  (
     1778                             input this-procedure:handle
     1779                             ,input query br-usr-hist:handle
     1780                             ,input rowid(X_c-usr-hist)
     1781                             ,input logical(parameter-2-17)
     1782                             ,input no-lock
     1783                             ,input (buffer X_c-usr-hist:handle)
     1784                             ,input parameter-4-17
     1785                             ,input parameter-5-17
     1786                             ) no-error.
     1787         .
     1788         assign
     1789           v-doc-rec = integer(return-value)
     1790           v-fltopend-rowid[1] = ?
     1791         .
     1792       end.
     1793       else do:
     1794         assign
     1795         parameter-2-17 = (if p-find-next then "true":u else "false":u )
     1796         parameter-3-17 =  "FOR EACH X_c-usr-hist"
     1797         parameter-4-17 =
     1798           (
     1799             if (" TRUE " + " " + where-phrase-17) <> ""
     1800             then " TRUE " + " " + where-phrase-17
     1801             else "true"
     1802           )
     1803         parameter-5-17 = (" " + "" + " " + "" + " " + p-find-condition)
     1804         parameter-6-17 = if sort-phrase-17 = ''
     1805                              then
     1806           (
     1807           " " + " use-index  ie02 " +
     1808             " " + sort-column-phrase +
     1809           " " + "  "
     1810           )
     1811                              else
     1812           (
     1813           " " + " use-index  ie02 " +
     1814             " " + sort-column-phrase +
     1815           " " + sort-phrase-17
     1816           )
     1817         parameter-7-17 =
     1818           " indexed-reposition  "
     1819       .
     1820         run fltopend_fltfindq in this-procedure  (
     1821                             input this-procedure:handle
     1822                             ,input query br-usr-hist:handle
     1823                             ,input logical(parameter-2-17)
     1824                             ,input no-lock
     1825                             ,input parameter-3-17
     1826                             ,input parameter-4-17
     1827                             ,input parameter-5-17
     1828                             ,input parameter-6-17
     1829                             ,input parameter-7-17
     1830                             ,output v-fltopend-rowid
     1831                             ) no-error.
     1832         .
     1833         v-doc-rec = ?.
     1834       end.
     1835       assign
     1836         l-query-was-opened = true
     1837       .
     1838     end.
     1839   end.
     1840     run waitfram-hide in this-procedure .
     1841         END.
     1842     END CASE.
     1843     if not p-open-query  and v-doc-rec <> ? then
     1844       REPOSITION br-usr-hist to recid v-doc-rec No-ERROR.
     1845     if not p-open-query and v-fltopend-rowid[1] <> ? then
     1846       query br-usr-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     1847     run waitfram-hide in this-procedure .
     1848     APPLY "VALUE-CHANGED" TO br-usr-hist in frame Dialog-Frame.
     1849     APPLY "ENTRY" TO br-usr-hist.
     1850   END PROCEDURE.
     1851   PROCEDURE proc-br-plc-hist :
     1852   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1853   if b-sel:sensitive in frame Dialog-Frame then dO:
     1854       if b-mark:sensitive then do:
     1855           apply "choose" to b-mark in frame Dialog-Frame.
     1856       end.
     1857       else do:
     1858           apply "choose" to b-sel in frame Dialog-Frame.
     1859       end.
     1860   end.
     1861   else do:
     1862       if b-lookup:sensitive then
     1863       apply "choose" to b-lookup in frame Dialog-Frame.
     1864   end.
     1865   END PROCEDURE.
     1866   PROCEDURE proc-view-changes :
     1867     define variable v-description as character no-undo .
     1868     for each temp-changes:
     1869       delete temp-changes.
     1870     END.
     1871     if not available X_c-usr-hist then
     1872     do:
     1873       Open QUery br-changes for each temp-changes.
     1874       return.
     1875     end.
     1876     run str/cuserhistv.p (
     1877       input X_c-usr-hist.user-id
     1878       ,input X_c-usr-hist.chip-num
     1879       ,input X_c-usr-hist.corr-user-db-num
     1880       ,input X_c-usr-hist.subject
     1881       ,input X_c-usr-hist.action
     1882       ,input no
     1883       ,output v-description
     1884       ) no-error .
     1885     Open QUery br-changes for each temp-changes.
     1886     assign
     1887       br-changes:title in frame Dialog-Frame = v-description
     1888       .
     1889   END PROCEDURE.
     1890   FUNCTION get-action RETURNS CHARACTER
     1891     ( p-action as integer ) :
     1892       define variable dops as character no-undo.
     1893     assign
     1894       dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     1895     RETURN dops.
     1896   END FUNCTION.
     1897   FUNCTION get-place RETURNS CHARACTER
     1898     ( p-obj-type as character, p-obj-code as integer, p-pl-code as integer ) :
     1899     define buffer buf_place for ub.place.
     1900     find first buf_place no-lock where
     1901       buf_place.obj-type = p-obj-type
     1902       AND  buf_place.obj-code = p-obj-code
     1903       AND  buf_place.pl-code = p-pl-code no-error.
     1904     if not available buf_place then
     1905     do:
     1906       return "!!! Неизвестное складское место!!!".
     1907     end.
     1908     RETURN buf_place.pl-name.
     1909   END FUNCTION.
     1910   FUNCTION get-subject RETURNS CHARACTER
     1911     ( p-subject as character ) :
     1912     RETURN entry (lookup (p-subject, 'place,pl-gds,pl-gds-pump,pl-pump,pl-pump-nozzle,place-attr':U), 'Складское место,Товар на складском месте,Товар на ТРК,Резервуар/ТРК,Резервуар/ТРК/Пистолет,Атрибут Скл. места':U).
     1913   END FUNCTION.
