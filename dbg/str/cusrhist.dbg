      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define variable c-point  as character no-undo .
      123   define variable tbl      as character no-undo .
      124   define variable join-tbl as character no-undo .
      125   define variable fld      as character no-undo .
      126   define variable lab      as character no-undo .
      127   define variable spr      as character no-undo .
      128   define variable dim      as character no-undo .
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   procedure cur-time :
      131      define output parameter p-today as date      no-undo .
      132      define output parameter p-time  as integer   no-undo .
      133     do
      134     on error undo, return error
      135     :
      136       define variable v-date1 as date      no-undo .
      137       define variable v-date2 as date      no-undo .
      138       define variable v-time  as integer   no-undo .
      139       assign
      140         v-date1 = today
      141         v-time  = time
      142         v-date2 = today
      143       .
      144       if v-date1 <> v-date2
      145       then do:
      146         assign
      147           v-date1 = today
      148           v-time  = v-time
      149         .
      150       end.
      151       assign
      152         p-today = v-date1
      153         p-time  = v-time
      154       .
      155     end.
      156   end.
      157   function cur-time-date returns character
      158   :
      159     return string(today, '99/99/9999':U) .
      160   end.
      161   function cur-time-mjd returns decimal
      162   :
      163     define variable v-date as date      no-undo .
      164     define variable v-time as integer   no-undo .
      165     run cur-time in this-procedure
      166       (output v-date
      167       ,output v-time
      168       ) .
      169     return integer(v-date) - 2400002 + (v-time / 86400) .
      170   end.
      171   function cur-time-get-ending-index returns integer
      172   (input p-number as integer
      173   )
      174   :
      175     if p-number < 0
      176     or p-number = ?
      177     then do:
      178       return 1 .
      179     end.
      180     define variable v-rest as integer   no-undo .
      181     assign
      182       p-number = p-number modulo 100
      183     .
      184     if p-number < 20
      185     then do:
      186       assign
      187         v-rest = p-number
      188       .
      189     end.
      190     else do:
      191       assign
      192         v-rest = p-number modulo 10
      193       .
      194     end.
      195     case v-rest :
      196       when 1
      197       then do:
      198         return 2 .
      199       end.
      200       when 2 or
      201       when 3 or
      202       when 4
      203       then do:
      204         return 3 .
      205       end.
      206       otherwise do:
      207         return 1 .
      208       end.
      209     end case .
      210   end.
      211   procedure cur-time-mjd-to-date :
      212      define input  parameter i-mjd-diff as decimal no-undo.
      213      define output parameter o-Date     as date    no-undo.
      214      define output parameter o-Time     as integer no-undo.
      215      define variable v-day-number as integer   no-undo .
      216      if    i-mjd-diff < 0
      217         or i-mjd-diff = ?
      218      then do:
      219         return "?" .
      220      end.
      221      assign
      222         v-day-number = truncate(i-mjd-diff,0).
      223         o-Date = date(v-day-number + 2400002).
      224         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      225     .
      226   end.
      227   function cur-time-mjd-to-string returns character
      228   (input p-mjd-diff as decimal
      229   )
      230   :
      231     define variable v-day-number as integer   no-undo .
      232     define variable v-seconds    as integer   no-undo .
      233     define variable v-hour       as integer   no-undo .
      234     define variable v-min        as integer   no-undo .
      235     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      236     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      237     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      238     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      239     if p-mjd-diff < 0
      240     or p-mjd-diff = ?
      241     then do:
      242       return "?" .
      243     end.
      244     assign
      245       v-day-number = integer(truncate(p-mjd-diff,0))
      246       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      247     .
      248     if v-seconds > 86400
      249     then do:
      250       assign
      251         v-seconds = 86400 - 1
      252       .
      253     end.
      254     if v-seconds < 0
      255     then do:
      256       assign
      257         v-seconds = 0
      258       .
      259     end.
      260     assign
      261       v-hour = truncate(v-seconds / 3600, 0)
      262     .
      263     assign
      264       v-seconds = v-seconds modulo 3600
      265     .
      266     assign
      267       v-min = truncate(v-seconds / 60, 0)
      268     .
      269     assign
      270       v-seconds = v-seconds modulo 60
      271     .
      272     return
      273         (if v-day-number <> 0
      274           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      275           else ""
      276         )
      277       + (if v-day-number <> 0 or v-hour <> 0
      278           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      282           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      283           else ""
      284         )
      285       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      286       .
      287   end.
      288   function cur-time-string returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-string-sec returns character
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      307   end.
      308   function cur-time-custom  returns character
      309   (input p-prefix as character
      310   ,input p-date-format as character
      311   ,input p-delimiter as character
      312   ,input p-time-format as character
      313   ,input p-suffix as character
      314   )
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return
      323       p-prefix
      324       + string(v-date, p-date-format)
      325       + p-delimiter
      326       + string(v-time, p-time-format)
      327       + p-suffix
      328       .
      329   end.
      330   function cur-time-print  returns character
      331   :
      332     define variable v-date as date      no-undo .
      333     define variable v-time as integer   no-undo .
      334     run cur-time in this-procedure
      335       (output v-date
      336       ,output v-time
      337       ) .
      338     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      339   end.
      340   function cur-time-datetime returns datetime
      341   :
      342     define variable v-char as character no-undo .
      343     define variable v-datetime as datetime no-undo .
      344     v-char = cur-time-string().
      345     v-datetime = datetime(v-char).
      346     return  v-datetime.
      347   end.
      348   function cur-time-string-msec returns character
      349   :
      350     define variable v-date as datetime  no-undo .
      351     v-date = now.
      352     return string(v-date) .
      353   end.
      354   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      355   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      356   define new shared variable RepPathName        as character no-undo .
      357   define new shared variable PrintRubl          as logical   no-undo .
      358   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   define variable v-waitfram-action01         as character   no-undo .
      360   define variable v-waitfram-action02         as character   no-undo .
      361   define variable v-waitfram-action03         as character   no-undo .
      362   define variable mWaitFramTextBeg            as character   no-undo.
      363   define variable mWaitFramTextEnd            as character   no-undo.
      364   define variable mWaitFramView               as logical     no-undo.
      365   define variable mWaitProcEvent              as logical     no-undo init yes.
      366   define variable mWaitFramInterval           as integer     no-undo init 1 .
      367   define variable mWaitFramStop               as logical     no-undo.
      368   define variable mWaitFramStopUser           as logical     no-undo.
      369   define variable mWaitFramStopTimeOut        as logical     no-undo.
      370   define variable mWaitFramStartProc          as datetime-tz no-undo.
      371   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      372   define button B-WaitFramStop auto-end-key
      373        label "Стоп"
      374        size 10 by 1 tooltip "Остоновить процесс".
      375   define button B-viewProcInfo
      376        label "Информация"
      377        size 15 by 1 tooltip "Информация о процесс".
      378   define frame waitfram
      379     v-waitfram-action01 format "x(72)" no-label skip
      380     v-waitfram-action02 format "x(72)" no-label skip
      381     v-waitfram-action03 format "x(72)" no-label skip
      382     B-viewProcInfo
      383     B-WaitFramStop at row 4 col 30
      384     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      385     .
      386   define new global shared variable mBatchMode as logical no-undo init ?.
      387   define variable mFramBachModHandle as handle no-undo.
      388   mFramBachModHandle = frame waitfram:handle.
      389   define variable mFameOldVis as logical no-undo.
      390   define variable mVisCUrentVin as logical no-undo.
      391   if session:batch-mode
      392   then
      393      mBatchMode = yes.
      394   if mBatchMode = ? then do:
      395     mVisCUrentVin = current-window:visible.
      396     mFameOldVis = mFramBachModHandle:visible.
      397     mFramBachModHandle:visible  = yes.
      398     mBatchMode = mFramBachModHandle:visible ne yes.
      399     mFramBachModHandle:visible = mFameOldVis.
      400     current-window:visible = mVisCUrentVin.
      401   end.
      402    if  log-manager:logfile-name ne ?
      403     then DO:
      404         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      405         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      406         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      407     end.
      408   on choose of B-WaitFramStop in frame waitfram
      409   do:
      410     mWaitFramStop = yes.
      411     mWaitFramStopUser = yes.
      412   end.
      413   function waitfram-check-timeout returns logical():
      414      define variable vtime as int64 no-undo.
      415      if mWaitFramStopTimeOut
      416      then
      417         return yes.
      418      vtime = ( now - mWaitFramStartProc ) / 1000 .
      419      if     mWaitFramTimeOut ne ?
      420         and mWaitFramTimeOut ne 0
      421         and mWaitFramTimeOut lt vtime
      422      then do:
      423         mWaitFramStopTimeOut = yes.
      424      end.
      425      return mWaitFramStopTimeOut.
      426   end.
      427   procedure waitfram-hide :
      428     if not session:batch-mode
      429     then do
      430     on error undo, return error return-value
      431     :
      432       pause 0 before-hide .
      433       if not mBatchMode then
      434         hide frame waitfram .
      435     if     not mWaitFramView
      436        and mWaitProcEvent
      437     then
      438       process events .
      439     end.
      440   end procedure.
      441   procedure waitfram-show :
      442     define input  parameter p-message as character no-undo .
      443     define variable v-left-margin as integer   no-undo .
      444     if not session:batch-mode
      445     then do
      446     on error undo, return error return-value
      447     :
      448       if length(p-message) <= 70 then do:
      449         assign
      450           v-left-margin = integer((70 - length(p-message)) / 2)
      451         .
      452         assign
      453           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      454         .
      455         assign
      456           v-waitfram-action01 = " "
      457           v-waitfram-action02 = " "
      458                                    + fill(" ", v-left-margin)
      459                                    + p-message
      460           v-waitfram-action03 = " "
      461         .
      462       end.
      463       else do:
      464         define variable vRindex1 as integer no-undo.
      465         define variable vRindex2 as integer no-undo.
      466         vRindex1 = r-index(p-message," ",70).
      467         if vRindex1 = 0
      468         then
      469            vRindex1 = 70.
      470         if length(p-message)  <= vRindex1 + 70 then do:
      471           assign
      472             v-waitfram-action01 = " "
      473             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      474             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      475           .
      476         end.
      477         else do:
      478           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      479           if vRindex2 <= vRindex1
      480           then
      481              vRindex2 = vRindex1 + 70.
      482           assign
      483             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      484             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      485             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      486           .
      487         end.
      488       end.
      489       B-viewProcInfo:visible   in frame waitfram = no.
      490       B-viewProcInfo:sensitive in frame waitfram = no.
      491       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      492       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      493       if  (   mWaitFramView
      494          or  mWaitProcEvent)
      495          and not mBatchMode
      496       then
      497          display
      498             v-waitfram-action01 skip
      499             v-waitfram-action02 skip
      500             v-waitfram-action03 skip
      501          with frame waitfram .
      502       if     mWaitFramView
      503          then do:
      504             if     mWaitFramInterval ne ?
      505                and not mBatchMode
      506             then
      507                wait-for go of frame waitfram pause mWaitFramInterval.
      508          end.
      509          else
      510             if     mWaitProcEvent
      511                and not mBatchMode
      512             then
      513                process events .
      514     end.
      515   end procedure.
      516      procedure waitfram-show-this:
      517         define input  parameter iInterval as int64 no-undo.
      518         define variable vtime as int64 no-undo.
      519         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      520         mWaitFramInterval = iInterval.
      521         run waitfram-show (substitute("&1&2 &3&4" ,
      522                                       mWaitFramTextBeg ,
      523                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      524                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      525                                       mWaitFramTextEnd
      526                                      )
      527                           ).
      528      end.
      529      procedure WaitFramRunPause:
      530         define input  parameter iInterval as dec no-undo.
      531         define variable vStart  as datetime-tz no-undo.
      532         define variable vend    as datetime-tz no-undo.
      533         define variable vint as int64 no-undo.
      534         define variable vOk as logical no-undo.
      535         vStart = now.
      536         vend   = vStart.
      537         publish "WaitFramPause" (iInterval,output vOk).
      538         vend   =  now.
      539         vint = vend - vStart.
      540         vint = iInterval - vint / 1000.
      541         if     not mWaitFramStop
      542            and (   vint > 0
      543                 or (    not vOk
      544                     and iInterval eq ?
      545                     )
      546                 )
      547         then
      548            run waitfram-show-this (iInterval).
      549         vend   =  now.
      550         vint = vend - vStart.
      551         vint = iInterval - vint / 1000.
      552         if     not mWaitFramStop
      553            and vint > 0
      554         then do:
      555            run gbl/pause.p (vint * 1000).
      556         end.
      557         if iInterval ne ?
      558         then
      559            publish "WaitFramStop".
      560         waitfram-check-timeout().
      561      end.
      562      procedure WaitFramWaitFor:
      563         define input  parameter iInterval as dec no-undo.
      564         assign
      565            mWaitFramStartProc   = now
      566            mWaitFramStopUser    = no
      567            mWaitFramStopTimeOut = no
      568         .
      569         block-wait:
      570         do while not mWaitFramStop:
      571            run WaitFramRunPause (iInterval).
      572            if  waitfram-check-timeout()
      573            then do:
      574               leave block-wait.
      575            end.
      576         end.
      577         run waitfram-hide.
      578      end.
      579   procedure waitfram-join :
      580     define input  parameter p-line-1  as character no-undo .
      581     define input  parameter p-line-2  as character no-undo .
      582     define input  parameter p-line-3  as character no-undo .
      583     define output parameter p-message as character no-undo .
      584     do
      585     on error undo, return error return-value
      586     :
      587       assign
      588         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      589                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      590                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      591       .
      592     end.
      593   end procedure.
      594   function waitfram-join-function returns character
      595     (input p-line-1 as character
      596     ,input p-line-2 as character
      597     ,input p-line-3 as character
      598     ).
      599     define variable v-message as character no-undo .
      600     run waitfram-join in this-procedure
      601       (input  p-line-1
      602       ,input  p-line-2
      603       ,input  p-line-3
      604       ,output v-message
      605       ) .
      606     return v-message .
      607   end function .
      608   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   procedure fltfield-clear :
      610     define output parameter loc-fld as character no-undo.
      611     define output parameter loc-lab as character no-undo .
      612     define output parameter loc-spr as character no-undo .
      613     define output parameter loc-dim as character no-undo .
      614     assign
      615       loc-fld = ""
      616       loc-lab = ""
      617       loc-spr = ""
      618       loc-dim = "0"
      619     .
      620   end procedure .
      621   procedure fltfield-add :
      622     define input        parameter par-fld as character no-undo.
      623     define input        parameter par-lab as character no-undo .
      624     define input        parameter par-spr as character no-undo .
      625     define input-output parameter loc-fld as character no-undo.
      626     define input-output parameter loc-lab as character no-undo .
      627     define input-output parameter loc-spr as character no-undo .
      628     define input-output parameter loc-dim as character no-undo .
      629     do
      630     on error undo, return error
      631     :
      632       assign
      633       loc-fld = if loc-dim = '0'
      634                 then par-fld
      635                 else (loc-fld + chr(44) + par-fld)
      636       loc-lab = if loc-dim = '0'
      637                 then par-lab
      638                 else (loc-lab + chr(44) + par-lab)
      639       loc-spr = if loc-dim = '0'
      640                 then par-spr
      641                 else (loc-spr + chr(44) + par-spr)
      642       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      643                 string(integer(if num-entries(loc-dim) > 1
      644                               then entry(2, loc-dim)
      645                               else entry(1, loc-dim)
      646                               ) + 1)
      647       no-error
      648       .
      649     end.
      650   end procedure.
      651   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      652   define  stream PrnLibStream.
      653   procedure prn-lib-prn-file :
      654     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      655     define input parameter p-DIsabledoptions as integer no-undo .
      656     define variable v-report-name as character no-undo .
      657     define variable v-user-action as character no-undo .
      658     define variable v-printed     as logical   no-undo .
      659     define variable v-exist       as logical   no-undo .
