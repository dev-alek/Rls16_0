     3292     (input  v-host-code
     3293     ,output v-base-code
     3294     )  .
     3295   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3296   define variable v-param-type38 as character no-undo .
     3297   define variable v-value-date38 as date no-undo .
     3298   define variable v-value-decimal38 as decimal no-undo .
     3299   define variable v-value-integer38 as INTEGER no-undo .
     3300   define variable v-value-logical38 AS LOGICAL no-undo .
     3301   define variable v-tth38 as handle no-undo .
     3302   run adm/shattri.p (
     3303       input "get":U
     3304       ,input  p-obj-type
     3305       ,input  i-obj-code
     3306       ,input  'cd-sending':U
     3307       ,input  'dflt-cd':U
     3308       ,output dflt-cd
     3309       ,output v-value-date38
     3310       ,output v-value-decimal38
     3311       ,output v-value-integer38
     3312       ,output v-value-logical38
     3313       ,output v-param-type38
     3314       ,INPUT-OUTPUT table-handle v-tth38
     3315       )  .
