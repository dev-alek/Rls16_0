     3317   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3318   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3319     (output v-curr-r-b
     3320     )  .
     3321     if v-curr-r-b = 'base':U then do:
     3322       curr-list = "" .
     3323       FOR EACH currency NO-LOCK :
     3324           FIND LAST ub.curr-shop WHERE ub.curr-shop.obj-code = i-obj-code
     3325                               and ub.curr-shop.obj-type = p-obj-type
     3326                               and ub.curr-shop.curr-code = ub.currency.curr-code NO-ERROR .
     3327                     if available ub.curr-shop then
     3328                     curr-list = curr-list + string( ub.curr-shop.curr-code ) + chr(44) .
     3329       END.
     3330       curr-list = right-trim( curr-list, chr(44) ) .
     3331       FIND LAST ub.curr-shop WHERE
     3332                         ub.curr-shop.obj-code = i-obj-code and
     3333                         ub.curr-shop.obj-type = p-obj-type and
     3334                       ub.curr-shop.curr-code = v-base-code NO-ERROR.
     3335       if available ub.curr-shop then
     3336       one-rubl = ub.curr-shop.exch-rate / ub.curr-shop.exch-scale.
     3337       else  do:
     3338         run write-log-and-file in p-log-handle (
     3339               input 1
     3340             , input log-file-name
     3341             , input 1
     3342             , input substitute( "!!!В БД отсутствует магазинный курс для базовой валюты &1 &2&3"
     3343                               , v-base-code
     3344                               , p-obj-type
     3345                               , i-obj-code
     3346                               )
     3347                                               ).
     3348         assign
     3349         v-view-log = yes
     3350         .
     3351         return.
     3352       end.
     3353     end.
     3354     FOR EACH ub.currency NO-LOCK :
     3355       if dflt-cd = 'Emulator-NKT-IBM':U
     3356       and ub.currency.curr-code <> v-base-code
     3357       and ub.currency.curr-code <> 0 then next.
     3358       FIND LAST ub.curr-shop WHERE
     3359               ub.curr-shop.obj-code = i-obj-code
     3360           and ub.curr-shop.obj-type = p-obj-type
     3361           and ub.curr-shop.curr-code = ub.currency.curr-code
     3362           AND
     3363                     (YEAR(ub.curr-shop.exch-date) = 9999) NO-ERROR .
     3364       if not avail ub.curr-shop then
     3365       FIND LAST ub.curr-shop WHERE
     3366               ub.curr-shop.obj-code = i-obj-code
     3367           and ub.curr-shop.obj-type = p-obj-type
     3368           and ub.curr-shop.curr-code = ub.currency.curr-code No-ERROR.
     3369        if not avail curr-shop then do:
     3370           run write-log-and-file in p-log-handle (
     3371                 input 1
     3372               , input log-file-name
     3373               , input 1
     3374               , input substitute( "!!!В БД отсутствует магазинный курс для валюты &1 &2&3"
     3375                                 ,  ub.currency.curr-code
     3376                                 , p-obj-type
     3377                                 , i-obj-code
     3378                                 )
     3379                                                 ).
     3380           assign
     3381           v-view-log = yes
     3382           .
     3383       end.
     3384       if available ub.curr-shop then do:
     3385         FIND LAST ub.curr-bank WHERE
     3386                           ub.curr-bank.curr-code = ub.currency.curr-code AND
     3387                           ub.curr-bank.exch-date <= today NO-ERROR.
     3388         if NOT available ub.curr-bank and not ub.currency.curr-code = 0 then do:
     3389           run write-log-and-file in p-log-handle (
     3390                 input 1
     3391               , input log-file-name
     3392               , input 1
     3393               , input substitute( "!!!В БД отсутствует текущий курс ЦБ РФ для валюты &1 &2&3"
     3394                                 ,  ub.currency.curr-code
     3395                                 , p-obj-type
     3396                                 , i-obj-code
     3397                                 )
     3398                                                 ).
     3399           assign
     3400           v-view-log = yes
     3401           .
     3402         end.
     3403         else do:
     3404           create t-cs.
     3405           buffer-copy ub.curr-shop except exch-date exch-time to t-cs
     3406           assign
     3407           t-cs.exch-date = today
     3408           t-cs.exch-time = time
     3409           t-cs.bexch-rate = if ub.currency.curr-code = 0 then 1 else ub.curr-bank.exch-rate
     3410           t-cs.bexch-scale = if ub.currency.curr-code = 0 then 1 else ub.curr-bank.exch-scale.
     3411           if NOT YEAR(ub.curr-shop.exch-date) = 9999 then do:
     3412               create b-curr-shop.
     3413               buffer-copy ub.curr-shop except exch-date exch-time to b-curr-shop
     3414               assign
     3415               b-curr-shop.exch-date = today
     3416               b-curr-shop.exch-time = time
     3417               b-curr-shop.exch-date = DATE(1, 1, 9999).
     3418           end.
     3419         end.
     3420       end.
     3421     END .
     3422     run write-log-and-file in p-log-handle (
     3423           input 1
     3424         , input log-file-name
     3425         , input 1
     3426         , input substitute("Пересылка на кассы &1&2 курсов валют", p-obj-type, i-obj-code)
     3427                                               ).
     3428     RUN SENDING no-error.
     3429     if error-status:error then do:
     3430       run write-log-and-file in p-log-handle (
     3431             input 1
     3432           , input log-file-name
     3433           , input 1
     3434           , input substitute( "!!!Ошибки при отсылке на кассы &1&2 курсов валют"
     3435                             , p-obj-type
     3436                             , i-obj-code
     3437                             )
     3438                                             ).
     3439       assign
     3440       v-view-log = yes
     3441       .
     3442     end.
     3443     FOR EACH ub.currency No-LOCK,
     3444       FIRST t-cs WHERE
     3445             t-cs.curr-code = ub.currency.curr-code,
     3446       FIRST ub.curr-shop WHERE
     3447             ub.curr-shop.curr-code = ub.currency.curr-code AND
     3448             ub.curr-shop.obj-type =  p-obj-type AND
     3449             ub.curr-shop.obj-code = i-obj-code AND
     3450             YEAR(ub.curr-shop.exch-date) = 9999:
     3451       DO TRANSACTION:
     3452         ASSIGN
     3453         ub.curr-shop.exch-date = t-cs.exch-date
     3454         ub.curr-shop.exch-time = t-cs.exch-time.
     3455         DELETE t-cs.
     3456       END.
     3457     END.
     3458     finally :
     3459   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3460   if v-view-log
     3461   and not g#news
     3462   and not g#auto
     3463   then do:
     3464     message
     3465     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
     3466     "!!!Внимательно прочитайте Log-file!!"
     3467     view-as alert-box error .
     3468        define variable v-user-action41   as character no-undo .
     3469     define variable v-printed41       as logical   no-undo .
     3470     run gbl/prnfilen.w
     3471       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
     3472       ,input  0
     3473       ,input  (string("./":U) + log-file-name)
     3474       ,input  7
     3475       ,output v-user-action41
     3476       ,output v-printed41
     3477       ) .
     3478   end.
     3479   if v-view-log = true
     3480   and (g#news
     3481   or g#auto)
     3482   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     3483   then do:
     3484      run cb_set-view-log in p-parent-handle ( input yes).
     3485   end.
     3486       run write-log-and-file in p-log-handle (
     3487           input 1
     3488         , input log-file-name
     3489         , input 1
     3490         , input substitute("&1", chr(10))
     3491       ).
     3492       define variable v-save-file-name as character no-undo .
     3493       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     3494       OS-APPEND value(log-file-name) value(v-save-file-name).
     3495       OS-DELETE value(log-file-name).
     3496     end finally .
     3497   end .
     3498   PROCEDURE out-back-curs :
     3499   FIND last ub.curr-shop WHERE
     3500             ub.curr-shop.obj-code = i-obj-code AND
     3501             ub.curr-shop.obj-type = p-obj-type AND
     3502             ub.curr-shop.curr-code = v-base-code NO-ERROR.
     3503   if available ub.curr-shop then do:
     3504     one-rubl = ub.curr-shop.exch-scale / ub.curr-shop.exch-rate.
     3505     do ii = 1 to (if num-entries(curr-list) > 10 then 10 else num-entries(curr-list)):
     3506       FIND FIRST ub.currency WHERE
     3507               ub.currency.curr-code = int(entry(ii, curr-list)) NO-ERROR.
     3508       if not available currency then do:
     3509         run write-log-and-file in p-log-handle (
     3510               input 1
     3511             , input log-file-name
     3512             , input 1
     3513             , input substitute( "!!!В БД отсутствует валюта с кодом &1"
     3514                               ,  int(entry(ii, curr-list))
     3515                               )
     3516                                               ).
     3517         assign
     3518         v-view-log = yes
     3519         .
     3520         output close.
     3521         os-command silent value('del '+ out + fname + '.dat').
     3522         undo,return error .
     3523       end.
     3524       FIND last t-cs WHERE t-cs.obj-code = i-obj-code AND
     3525                            t-cs.obj-type = p-obj-type AND
     3526                            t-cs.curr-code = int(entry(ii, curr-list)) use-index pi NO-ERROR.
     3527         if available t-cs then do:
     3528           if t-cs.curr-code <> 0 then do:
     3529             one-usd = 1 / ( ( ( t-cs.exch-rate / t-cs.exch-scale ) ) * one-rubl ) .
     3530             type = 4.
     3531             if one-usd < 1000 then
     3532             type = 3.
     3533             if one-usd < 100 then
     3534             type = 2.
     3535             if one-usd < 10 then
     3536             type = 1.
     3537             if one-usd < 1 then
     3538             type = 0.
     3539             one-val = exp( 10, type ) / one-usd.
     3540           end.
     3541           else
     3542           assign
     3543           type = 1
     3544           one-val = 1 .
     3545         end.
     3546         else do:
     3547          type = 0.
     3548          one-val = 0.
     3549         end.
     3550         name_ = name_ + caps(string(curr-name,'x(12)')).
     3551         abbr_ = abbr_ + string(curr-abbr,'x(3)').
     3552         scal_ = scal_ + string(type).
     3553         kurs_ = kurs_ + string(one-val,'>>9.9999').
     3554       end.
     3555       do jj = ii + 1 to 10:
     3556         scal_ = scal_ + '0'.
     3557         kurs_ = kurs_ + '00000000'.
     3558       end.
     3559       name_ = string(name_,'x(120)').
     3560       abbr_ = string(abbr_,'x(30)').
     3561       put unformatted name_ abbr_ scal_ kurs_.
     3562     end.
     3563   end.
     3564   PROCEDURE out-right-curs:
     3565   define variable hh as integer no-undo.
     3566   define variable CurCode like ub.currency.curr-code no-undo.
     3567   hh = ( if num-entries( curr-list ) > 10 then 10 else num-entries( curr-list ) ) .
     3568   DO ii = 1 TO hh :
     3569     CurCode = int( entry( ii, curr-list ) ) .
     3570     FIND FIRST ub.currency WHERE ub.currency.curr-code = CurCode NO-ERROR.
     3571     if not available ub.currency then do:
     3572       run write-log-and-file in p-log-handle (
     3573             input 1
     3574           , input log-file-name
     3575           , input 1
     3576           , input substitute( "!!!В БД отсутствует валюта с кодом &1"
     3577                             ,  CurCode
     3578                             )
     3579                                             ).
     3580       assign
     3581       v-view-log = yes
     3582       .
     3583       output close.
     3584       os-command silent value('del '+ out + fname + '.dat').
     3585       undo,return error .
     3586     end.
     3587     FIND last t-cs WHERE t-cs.obj-code = i-obj-code AND
     3588                          t-cs.obj-type = p-obj-type AND
     3589                          t-cs.curr-code = CurCode NO-ERROR.
     3590     if not available t-cs then do:
     3591       run write-log-and-file in p-log-handle (
     3592             input 1
     3593           , input log-file-name
     3594           , input 1
     3595           , input substitute( "!!!В БД отсутствует валюта с кодом &1"
     3596                             ,  CurCode
     3597                             )
     3598                                             ).
     3599       assign
     3600       v-view-log = yes
     3601       .
     3602       output close.
     3603       os-command silent value('del '+ out + fname + '.dat').
     3604       undo,return error .
     3605     end.
     3606     assign
     3607     name_ = name_ + caps( string( curr-name, 'x(12)' ) )
     3608     abbr_ = abbr_ + string( curr-abbr, 'x(3)' )
     3609     scal_ = scal_ + "0" .
     3610     if currency.curr-code = 0 then
     3611     kurs_ = kurs_ + string( 1, '>>>>9.99' ).
     3612     else
     3613     kurs_ = kurs_ + string(t-cs.exch-rate / t-cs.exch-scale ,'>>>>9.99').
     3614   END .
     3615   DO jj = ii + 1 TO 10:
     3616     assign
     3617     scal_ = scal_ + '0'
     3618     kurs_ = kurs_ + '00000000' .
     3619   END .
     3620   name_ = string(name_,'x(120)').
     3621   abbr_ = string(abbr_,'x(30)').
     3622   put unformatted name_ abbr_ scal_ kurs_.
     3623   end.
     3624   PROCEDURE out-back-curs-new-format :
     3625   FIND last ub.curr-shop WHERE
     3626             ub.curr-shop.obj-code = i-obj-code AND
     3627             ub.curr-shop.obj-type = p-obj-type AND
     3628             ub.curr-shop.curr-code = v-base-code NO-ERROR.
     3629   if available ub.curr-shop then do:
     3630     one-rubl = ub.curr-shop.exch-scale / ub.curr-shop.exch-rate.
     3631     do ii = 1 to (if num-entries(curr-list) > 10 then 10 else num-entries(curr-list)):
     3632       FIND FIRST ub.currency WHERE ub.currency.curr-code = int(entry(ii, curr-list)) NO-ERROR.
     3633       if not available ub.currency then do:
     3634         run write-log-and-file in p-log-handle (
     3635               input 1
     3636             , input log-file-name
     3637             , input 1
     3638             , input substitute( "!!!В БД отсутствует валюта с кодом &1"
     3639                               ,  int(entry(ii, curr-list))
     3640                               )
     3641                                               ).
     3642         assign
     3643         v-view-log = yes
     3644         .
     3645         output close.
     3646         os-command silent value('del '+ out + fname + '.dat').
     3647         undo, return error.
     3648       end.
     3649       FIND last t-cs WHERE t-cs.obj-code = i-obj-code AND
     3650                            t-cs.obj-type = p-obj-type AND
     3651                            t-cs.curr-code = int(entry(ii, curr-list)) use-index pi NO-ERROR.
     3652       if available t-cs then do:
     3653         if t-cs.curr-code <> 0 then do:
     3654           one-usd = 1 / ( ( ( t-cs.exch-rate / t-cs.exch-scale ) ) * one-rubl ) .
     3655           type = 4.
     3656           if one-usd < 1000 then
     3657           type = 3.
     3658           if one-usd < 100 then
     3659           type = 2.
     3660           if one-usd < 10 then
     3661           type = 1.
     3662           if one-usd < 1 then
     3663           type = 0.
     3664           one-val = exp( 10, type ) / one-usd.
     3665         end.
     3666         else
     3667         assign
     3668         type = 1
     3669         one-val = 1 .
     3670       end.
     3671       else do:
     3672         type = 0.
     3673         one-val = 0.
     3674       end.
     3675       assign
     3676       name_ =  caps(string(curr-name,'x(12)'))
     3677       abbr_ =  string(curr-abbr,'x(3)')
     3678       scal_ =  string(type)
     3679       kurs_ =  string(one-val,'999.9999')
     3680       .
     3681       put unformatted
     3682       string(currency.curr-code, "99":U)
     3683       name_
     3684       abbr_
     3685       string(v-base-code, "999":U)
     3686       scal_
     3687       kurs_
     3688       fill('0':U, 71)
     3689       skip.
     3690     end.
     3691   end.
     3692   end PROCEDURE.
     3693   PROCEDURE out-right-curs-new-format:
     3694   define variable hh as integer no-undo.
     3695   define variable CurCode like ub.currency.curr-code no-undo.
     3696   hh = ( if num-entries( curr-list ) > 10 then 10 else num-entries( curr-list ) ) .
     3697   DO ii = 1 TO hh :
     3698     CurCode = int( entry( ii, curr-list ) ) .
     3699     FIND FIRST ub.currency WHERE ub.currency.curr-code = CurCode NO-ERROR.
     3700     if not available ub.currency then do:
     3701       output close.
     3702       os-command silent value('del '+ out + fname + '.dat').
     3703       message "В базе отсутствует валюта с кодом " string(int(entry(ii, curr-list)))
     3704       view-as alert-box WARNING .
     3705       undo,return.
     3706     end.
     3707     FIND last t-cs WHERE t-cs.obj-code = i-obj-code AND
     3708                          t-cs.obj-type = p-obj-type AND
     3709                          t-cs.curr-code = CurCode NO-ERROR.
     3710     if not available t-cs then do:
     3711       run write-log-and-file in p-log-handle (
     3712             input 1
     3713           , input log-file-name
     3714           , input 1
     3715           , input substitute( "!!!В БД отсутствует валюта с кодом &1"
     3716                             ,  CurCode
     3717                             )
     3718                                             ).
     3719       assign
     3720       v-view-log = yes
     3721       .
     3722       output close.
     3723       os-command silent value('del '+ out + fname + '.dat').
     3724       undo, return error.
     3725     end.
     3726     assign
     3727     name_ = caps( string( curr-name, 'x(12)' ) )
     3728     abbr_ = string( curr-abbr, 'x(3)' )
     3729     scal_ =  "0" .
     3730     if currency.curr-code = 0 then
     3731     kurs_ = string( 1, '999.99' ).
     3732     else
     3733     kurs_ = string(t-cs.exch-rate / t-cs.exch-scale ,'999.99').
     3734     put unformatted
     3735     string(currency.curr-code, "99":U)
     3736     name_
     3737     abbr_
     3738     string(0, "999":U)
     3739     scal_
     3740     kurs_
     3741     fill('0', 71)
     3742     skip.
     3743   END .
     3744   end PROCEDURE.
