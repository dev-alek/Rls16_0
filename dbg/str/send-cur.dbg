       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable p-obj-type like ub.clients.obj-type no-undo .
       82   define variable i-obj-code like ub.clients.obj-code no-undo .
       83   define variable action as character no-undo .
       84   define variable vss-include-info0 as character format "X(65)" no-undo
       85   initial "@(#)$Workfile$ $Revision$".
       86   define variable v-bgelib-bgefmt        as character         no-undo.
