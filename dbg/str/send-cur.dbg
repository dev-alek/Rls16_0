     1265   procedure xml-cd-write-header:
     1266   do
     1267   on error undo, return error
     1268   :
     1269   define input parameter p-xml-file-name       as character    no-undo.
     1270   define input parameter p-xml-file-name-path  as character    no-undo.
     1271   define input parameter p-doc-name            as character    no-undo.
     1272   define input parameter p-version             as character    no-undo.
     1273   define input parameter p-obj-list            as character    no-undo.
     1274   define input parameter p-correspondent       as character    no-undo .
     1275   define input parameter p-write-header        as logical      no-undo .
     1276   define variable OS-time as character no-undo .
     1277   define variable id as character no-undo .
     1278   define buffer buf_db for ub.db.
     1279   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1280   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1281   assign
     1282   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1283   .
     1284   run bgelib-tag-open in this-procedure (
     1285                                        1
     1286                                       ,p-doc-name
     1287                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1288                                         ).
     1289   if p-write-header then do:
     1290     run bgelib-tag-open(2, "Header","").
     1291     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1292     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1293     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1294     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1295     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1296     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1297     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1298     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1299     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1300     run bgelib-tag-close( 2, "Header" ).
     1301   end.
     1302   output stream stmXMLOut close.
     1303   end.
     1304   end procedure.
     1305   procedure xml-cd-write-footer:
     1306   do
     1307   on error undo, return error
     1308   :
     1309   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1310   define input parameter p-xml-file-name as character    no-undo.
     1311   define input parameter p-doc-name      as character    no-undo .
     1312   define variable v-error-num     as integer           no-undo.
     1313   define variable v-md5-signature as character no-undo .
     1314   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1315   run bgelib-tag-close( 0, p-doc-name ).
     1316   put stream stmXMLOut unformatted skip.
     1317   output stream stmXMLOut close.
     1318   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1319   if v-error-num > 0
     1320   then do:
     1321      return error.
     1322   end.
     1323   if opsys = "unix"
     1324   then do:
     1325       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1326   end.
     1327   end.
     1328   end procedure.
     1329   procedure xml-cd-filename :
     1330   do
     1331   on error undo, return error
     1332   :
     1333   define input parameter  p-out               as character no-undo .
     1334   define output parameter p-xml-file-name     as character    no-undo.
     1335   define output parameter p-xml-file-name-path   as character    no-undo.
     1336   define output parameter p-log-file-name     as character    no-undo.
     1337   define output parameter p-locked            as logical      no-undo.
     1338   define variable v-out as character     no-undo.
     1339   define variable loc#log as logical no-undo .
     1340   define variable BadFlag as logical no-undo .
     1341   define variable fq as integer no-undo .
     1342   define variable v-remote as character no-undo .
     1343   assign
     1344   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1345   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1346   p-log-file-name = p-out + "actions.log"
     1347   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1348   .
     1349   end.
     1350   end procedure.
     1351   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1352   define variable v-date-str as character no-undo .
     1353   assign
     1354   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1355                string(Month(p-date), "99":U) + "-":U +
     1356                string(DAY(p-date), "99":U).
     1357   return v-date-str.
     1358   END FUNCTION.
     1359   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1360   define variable v-date-str as character no-undo .
     1361   assign
     1362   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1363                string(Month(p-date), "99":U) + "-":U +
     1364                string(DAY(p-date), "99":U) + chr(32) +
     1365                string(p-time, "HH:MM:SS").
     1366   return v-date-str.
     1367   END FUNCTION.
     1368   function string-to-date returns date ( input p-string  as character):
     1369     define variable v-date as date no-undo .
     1370     assign
     1371     v-date = date(integer(substring(p-string, 4, 2))
     1372                   ,integer(substring(p-string, 1, 2))
     1373                   ,integer(substring(p-string, 7, 4))
     1374                  ) no-error .
     1375     if error-status:error then return ?.
     1376     return v-date.
     1377   END FUNCTION.
     1378   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1379   define variable v-time as integer no-undo init ?.
     1380   define variable v-dop1 as character no-undo .
     1381   define variable v-dop2 as character no-undo .
     1382   assign
     1383   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1384   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1385   no-error .
     1386   if error-status:error then return ?.
     1387   assign
     1388   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1389             integer(entry(2, v-dop2, ";":U)) * 60 +
     1390             integer(entry(3, v-dop2, ";":U)) no-error .
     1391   return v-time.
     1392   END FUNCTION.
