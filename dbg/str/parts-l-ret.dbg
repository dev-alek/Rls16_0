     1779   FUNCTION mark-string RETURNS CHARACTER
     1780     ( input p-recid as recid, input mark-list as character  ) :
     1781     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1782   END FUNCTION.
