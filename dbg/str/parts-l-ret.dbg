     5909   procedure get-context :
     5910      define output parameter p-db-num as integer          no-undo.
     5911      define output parameter p-user-id as character        no-undo.
     5912      define variable v-login               as character    no-undo.
     5913      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5914      define buffer buf_user-login  for ub.user-login .
     5915      do
     5916      on error undo, return error
     5917      :
     5918            FIND FIRST buf_sys-ctrl no-lock.
     5919            ASSIGN
     5920               v-login = USERID("ub")
     5921               p-db-num = buf_sys-ctrl.db-num
     5922            .
     5923            FIND FIRST buf_user-login
     5924                 WHERE buf_user-login.db-num = p-db-num
     5925                   AND buf_user-login.user-login = v-login
     5926                 no-lock
     5927                 no-error
     5928                 .
     5929            IF AVAILABLE buf_user-login
     5930            THEN DO:
     5931               assign
     5932                  p-user-id = buf_user-login.user-id
     5933               .
     5934            END.
     5935      end.
     5936   end procedure.
