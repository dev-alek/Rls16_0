     1613   procedure fltopend_fltopend :
     1614   define input parameter p-parent-handle as handle no-undo .
     1615   define input parameter p-qh as handle no-undo .
     1616   define input parameter p-flt-open-open-query  as character no-undo .
     1617   define input parameter p-where-cond as character no-undo .
     1618   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1619   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1620   define input parameter p-indexed-reposition as character no-undo .
     1621     do
     1622     on error undo, return error
     1623     :
     1624   define variable v-prepare-string as character no-undo .
     1625   define variable glog as logical no-undo .
     1626   assign
     1627   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1628                      p-where-cond + chr(32)  +
     1629                      p-use-indFIRST-query-tail + chr(32) +
     1630                      p-use-ind-sort-clmn-by + chr(32) +
     1631                      p-indexed-reposition
     1632   .
     1633   assign
     1634   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1635   if not glog
     1636   or error-status:error then do:
     1637     message error-status:get-message(1) view-as alert-box .
     1638     undo, return error .
     1639   end.
     1640   assign
     1641   glog = p-qh:query-open no-error .
     1642   if not glog
     1643   or error-status:error then do:
     1644     message error-status:get-message(1) view-as alert-box .
     1645     undo, return error .
     1646   end.
     1647     end.
     1648   end procedure.
     1649   procedure fltopend_fltfindd :
     1650   define input parameter p-parent-handle as handle no-undo .
     1651   define input parameter p-qh as handle no-undo .
     1652   define input parameter p-rowid as rowid no-undo .
     1653   define input parameter p-next as logical no-undo .
     1654   define input parameter p-lock as integer no-undo .
     1655   define input parameter p-bh as handle no-undo .
     1656   define input parameter p-where-cond as character no-undo .
     1657   define input parameter p-use-index-phrase as character no-undo .
     1658   define variable glog as logical no-undo .
     1659   define variable v-qh as handle no-undo .
     1660   define variable v-bh as handle no-undo .
     1661   define variable v-recid as recid no-undo .
     1662   define variable v-prepare-string as character no-undo .
     1663   do
     1664   on error undo, return error
     1665   on stop undo, return error
     1666   :
     1667     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1668     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1669     create query v-qh.
     1670     v-qh:set-buffers(v-bh).
     1671     v-prepare-string = substitute("for each &1 &2 &3"
     1672                                     ,v-bh:name
     1673                                     ,p-where-cond
     1674                                     ,p-use-index-phrase).
     1675     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1676     if not glog then do:
     1677       delete object v-qh.
     1678       delete object v-bh.
     1679       undo, return error .
     1680     end.
     1681     glog = v-qh:query-open no-error .
     1682     if not glog then do:
     1683       delete object v-qh.
     1684       delete object v-bh.
     1685       undo, return error .
     1686     end.
     1687     if p-next then do:
     1688       v-qh:reposition-to-rowid(p-rowid) no-error .
     1689       glog = v-qh:get-next( p-lock) no-error .
     1690       glog = v-qh:get-next( p-lock) no-error .
     1691       if not glog or v-qh:query-off-end = yes then do:
     1692         glog = v-qh:get-first( p-lock) no-error .
     1693       end.
     1694     end.
     1695     else do:
     1696       glog = v-qh:get-first( p-lock) no-error .
     1697     end.
     1698     v-recid = v-bh:recid no-error .
     1699     delete object v-qh.
     1700     delete object v-bh.
     1701     return string(v-recid) .
     1702   end.
     1703   end procedure.
     1704   procedure fltopend_fltfindq :
     1705   define input parameter p-parent-handle as handle no-undo .
     1706   define input parameter p-qh as handle no-undo .
     1707   define input parameter p-next as logical no-undo .
     1708   define input parameter p-lock as integer no-undo .
     1709   define input parameter p-flt-open-open-query  as character no-undo .
     1710   define input parameter p-where-cond as character no-undo .
     1711   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1712   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1713   define input parameter p-indexed-reposition as character no-undo .
     1714   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1715   define variable glog as logical no-undo .
     1716   define variable v-qh as handle no-undo .
     1717   define variable v-bh as handle no-undo extent 18.
     1718   define variable v-rowid as rowid no-undo extent 18.
     1719   define variable v-ii as integer no-undo .
     1720   define variable v-prepare-string as character no-undo .
     1721   do
     1722   on error undo, return error
     1723   on stop undo, return error
     1724   :
     1725     create query v-qh.
     1726     do v-ii = 1 to p-qh:num-buffers:
     1727       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1728       assign
     1729       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1730       no-error.
     1731       v-qh:add-buffer(v-bh[v-ii]).
     1732     end.
     1733     assign
     1734     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1735                       p-where-cond + chr(32)  +
     1736                       p-use-indFIRST-query-tail + chr(32) +
     1737                       p-use-ind-sort-clmn-by + chr(32) +
     1738                       p-indexed-reposition
     1739     .
     1740     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1741     if not glog then do:
     1742       delete object v-qh.
     1743       do v-ii = 1 to p-qh:num-buffers:
     1744         delete object v-bh[v-ii].
     1745       end.
     1746       undo, return error .
     1747     end.
     1748     glog = v-qh:query-open no-error .
     1749     if not glog then do:
     1750       delete object v-qh.
     1751       do v-ii = 1 to p-qh:num-buffers:
     1752         delete object v-bh[v-ii].
     1753       end.
     1754       undo, return error .
     1755     end.
     1756     if p-next then do:
     1757       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1758       glog = v-qh:get-next( p-lock) no-error .
     1759       glog = v-qh:get-next( p-lock) no-error .
     1760       if not glog or v-qh:query-off-end = yes then do:
     1761         glog = v-qh:get-first( p-lock) no-error .
     1762       end.
     1763     end.
     1764     else do:
     1765       glog = v-qh:get-first( p-lock) no-error .
     1766     end.
     1767     do v-ii = 1 to p-qh:num-buffers:
     1768       assign
     1769       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1770       no-error.
     1771     end.
     1772     delete object v-qh.
     1773     do v-ii = 1 to p-qh:num-buffers:
     1774       delete object v-bh[v-ii].
     1775     end.
     1776   end.
     1777   end procedure.
