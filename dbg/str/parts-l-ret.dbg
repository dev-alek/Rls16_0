     4081               ).
     4082           end.
     4083           else do:
     4084             message
     4085               "Можно просматривать только архивные партии и" skip
     4086               "партии, зарезервированные за документами" skip
     4087               view-as alert-box information .
     4088           end.
     4089         end.
     4090       end.
     4091     end.
     4092   END.
     4093   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     4094   DO:
     4095   define variable vss-include-info35 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4096   if lookup(self :type
