     6349             "Ошибка при определении атрибута товара" skip
     6350             "Код товара" p-gds-code skip
     6351             'alcohol-prod=request':u skip
     6352             error-status :get-message(1) skip
     6353             return-value skip
     6354             view-as alert-box error .
