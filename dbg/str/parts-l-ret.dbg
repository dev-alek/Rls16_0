     9774     ,output flt-rec-80
     9775     ,output filter-name-80
     9776     ,output where-phrase-80
     9777     ,output sort-phrase-80
     9778     ,output where-phrase-rus-80
     9779     ,output sort-phrase-rus-80
     9780     ).
     9781   if p-open-query then do:
     9782       run set-filter-name in this-procedure
     9783         (INPUT filter-name-80
     9784         ) no-error .
     9785     assign
     9786       l-filter-open-80 = false
     9787     .
     9788     if flt-rec-80 <> ?
     9789       or sort-column-phrase > ""
     9790     then do:
     9791       define variable  parameter-2-80 as character no-undo .
     9792       define variable  parameter-3-80 as character no-undo .
     9793       define variable  parameter-4-80 as character no-undo .
     9794       define variable  parameter-5-80 as character no-undo .
     9795       define variable  parameter-6-80 as character no-undo .
     9796       define variable  parameter-7-80 as character no-undo .
     9797         assign
     9798         parameter-3-80 =
     9799                                 "FOR EACH parts"
     9800         parameter-4-80 =
     9801           (
     9802             if ("parts.artic = buf_goods.artic           and parts.prod-type = buf_goods.prod-type           and parts.prod-code = buf_goods.prod-code           and parts.obj-type = v-obj-type           and parts.obj-code = v-obj-code           and parts.in-code  = parts.out-code           and parts.doc-type = v-doc-type           and (( parts.supp-type = buf_trn-doc.cli-type and parts.supp-code = buf_trn-doc.cli-code) or parts.is-supp = no)           and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )           and parts.contract-code = buf_trn-doc.contract-code           and parts.fact-date >= f-date-from and parts.fact-date <= f-date-to           " + " " + where-phrase-80) <> ""
     9803             then        substitute (       ' parts.artic = &1&2&1        and parts.prod-type = &1&3&1       and parts.prod-code = &4       and parts.obj-type  = &1&7&1       and parts.obj-code  = &8       and parts.in-code   = parts.out-code       and parts.doc-type  = &1&9&1
     9804         and ( &5 <> true or ( &5 = true and parts.pl-code = &6 ) )     ', chr(34) , buf_goods.artic , buf_goods.prod-type , buf_goods.prod-code , v-reserv-pl-code , v-pl-code , v-obj-type , v-obj-code, v-doc-type ) +       substitute ( '           and (( parts.supp-type = &1&2&1 and parts.supp-code = &3 ) or parts.is-supp = no )           and parts.contract-code = &4           and parts.fact-date >= &5 and parts.fact-date <= &6
     9805                 ', chr(34) , buf_trn-doc.cli-type , buf_trn-doc.cli-code , buf_trn-doc.contract-code, f-date-from , f-date-to )        + " " + where-phrase-80
