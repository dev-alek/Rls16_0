     3726             view-as alert-box .
     3727           return no-apply .
     3728         end.
     3729         assign
     3730           v-prt-rec = recid(parts)
     3731         .
     3732         run str/parts-f.w
     3733           (input        parparentproc
     3734           ,input        this-procedure
     3735           ,input        'ИЗМЕНЕНИЕ':U
     3736           ,input        p-doc-code
     3737           ,input        p-gds-code
     3738           ,input        v-pl-code
     3739           ,input-output v-prt-rec
     3740           ).
     3741       end.
     3742       else do:
     3743         message
     3744           "Неправильно выбрана строка"
     3745           view-as alert-box .
     3746         return no-apply.
     3747       end.
     3748     end.
     3749     run reopen-query .
     3750   END.
