     1012                   + substitute( "&1", buf_gds-obj.obj-type ) + chr(1)
     1013                   + substitute( "&1", buf_gds-obj.obj-code ) + chr(1)
     1014                   + substitute( "&1", buf_gds-obj.artic ) + chr(1)
     1015                   + substitute( "&1", buf_gds-obj.prod-type ) + chr(1)
     1016                   + substitute( "&1", buf_gds-obj.prod-code ) + chr(1)
     1017                   + substitute( "&1", buf_gds-obj.free-qnty ) + chr(1)
     1018         .
     1019         run nws/cr-route.p
     1020           ( input 'send-cmd':U
     1021             ,input v-cmd
     1022             ,input ?
