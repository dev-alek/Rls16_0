     3774   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     3775   DO:
     3776   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3777   if lookup(self :type
     3778            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3779            ) = 0
     3780   then do:
     3781     message
     3782       "$Workfile$"
     3783       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3784       "Интерфейсный элемент" self :name  skip
     3785       "Тип" self :type  skip
     3786       "Процедура" this-procedure :file-name skip
     3787       view-as alert-box .
     3788   end.
     3789   else do:
     3790     apply "entry":u to self  .
     3791     if focus :handle <> self :handle  then do:
     3792       return no-apply .
     3793     end.
     3794   end.
     3795     define variable lok as logical no-undo .
     3796     do
     3797     on stop undo, return no-apply
     3798     :
     3799       if del-list = ""
     3800       then do:
     3801         if not available parts
     3802         then do:
     3803           message
     3804             "Неправильный выбор партии."
     3805             view-as alert-box .
     3806           return no-apply.
     3807         end.
     3808         if parts.in-code = parts.out-code
     3809           and v-is-petrol = yes
     3810           and v-is-pieces = no
     3811         then do:
     3812           message
     3813             "Во внешнем приходе топливо нельзя редактировать через партии" skip
     3814           view-as alert-box information .
     3815           return no-apply .
     3816         end.
     3817         lok = no.
     3818         message
     3819           "Удалить партию?" SKIP
     3820           "Вы уверены?"
     3821           view-as alert-box question
     3822           buttons OK-Cancel
     3823           update lok.
     3824         if lok <> true
     3825         then do:
     3826           return no-apply.
     3827         end.
     3828         assign
     3829           v-prt-rec = recid(parts)
     3830           del-list  = string(recid(parts))
     3831         .
     3832         get next br-parts.
     3833         if available parts
     3834         then do:
     3835           assign
     3836             v-prt-rec = recid (parts)
     3837           .
     3838         end.
     3839         else do:
     3840           reposition br-parts to recid v-prt-rec no-error.
     3841           get prev br-parts.
     3842           assign
     3843             v-prt-rec = recid(parts)
     3844           .
     3845         end.
     3846       end.
     3847       else do:
     3848         lok = no.
     3849         message
     3850           "УДАЛИТЬ ВСЕ ОТМЕЧЕННЫЕ партии?" skip
     3851           "Вы уверены?"
     3852           view-as alert-box question
     3853           buttons OK-Cancel
     3854           update lok.
     3855         if lok <> true
     3856         then do:
     3857           return no-apply.
     3858         end.
     3859         assign
     3860           v-prt-rec = ?
     3861         .
     3862       end.
     3863       define variable lns-cnt as integer no-undo .
     3864       do lns-cnt = 1 to num-entries (del-list):
     3865         run delete-parts in this-procedure
     3866           (input integer (entry (lns-cnt, del-list))
     3867           ) no-error .
     3868       end.
     3869       run reopen-query .
     3870       if b-add:sensitive
     3871       then do:
     3872         apply "entry":u to b-add.
     3873       end.
     3874       else do:
     3875         apply "entry":u to br-parts.
     3876       end.
     3877     end.
     3878   END.
     3879   ON CHOOSE OF b-doc IN FRAME Dialog-Frame
     3880   DO:
     3881   define variable vss-include-info31 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3882   if lookup(self :type
     3883            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3884            ) = 0
     3885   then do:
     3886     message
     3887       "$Workfile$"
     3888       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3889       "Интерфейсный элемент" self :name  skip
     3890       "Тип" self :type  skip
     3891       "Процедура" this-procedure :file-name skip
     3892       view-as alert-box .
     3893   end.
     3894   else do:
     3895     apply "entry":u to self  .
     3896     if focus :handle <> self :handle  then do:
     3897       return no-apply .
     3898     end.
     3899   end.
     3900     if p-call-point = 'документ':U
     3901     then do:
     3902       message
     3903         "Для просмотра документа, к которому относится партия, нажмите Выход."
     3904         view-as alert-box .
     3905     end.
     3906     else do:
     3907       if available parts
     3908       then do:
     3909         if parts.out-code = 'free-zone':U
     3910         then do:
     3911           message
     3912             "Партии свободной зоны не привязаны к документам"
     3913             view-as alert-box .
     3914           return .
     3915         end.
     3916         if parts.out-code = 'out-zone':U
     3917         then do:
     3918           message
     3919             "Партии расходной зоны не привязаны к документам"
     3920             view-as alert-box .
     3921           return .
     3922         end.
     3923         run str/showdoc.p
     3924           (input parparentproc
     3925           ,input ub.parts.out-code
     3926           ,input ub.parts.artic
     3927           ,input ub.parts.prod-type
     3928           ,input ub.parts.prod-code
     3929           ,input ?
     3930           ).
     3931       end.
     3932     end.
     3933     apply "entry":u to br-parts in frame Dialog-Frame.
     3934   END.
     3935   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     3936   DO:
     3937   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3938   if lookup(self :type
     3939            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3940            ) = 0
     3941   then do:
     3942     message
     3943       "$Workfile$"
     3944       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3945       "Интерфейсный элемент" self :name  skip
     3946       "Тип" self :type  skip
     3947       "Процедура" this-procedure :file-name skip
     3948       view-as alert-box .
     3949   end.
     3950   else do:
     3951     apply "entry":u to self  .
     3952     if focus :handle <> self :handle  then do:
     3953       return no-apply .
     3954     end.
     3955   end.
     3956     if v-ext-mode = "vsd_corr-parts"
     3957     or v-ext-mode = "corr-parts"
     3958     then do :
     3959       define buffer buf_doc-line for ub.doc-line .
     3960       define buffer buf_trn-doc for ub.trn-doc .
     3961       define buffer buf_goods for ub.goods .
     3962       define buffer doc_parts for ub.parts .
     3963       find first buf_goods no-lock where buf_goods.gds-code = p-gds-code .
     3964       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code .
     3965       find first buf_doc-line no-lock
     3966         where buf_doc-line.doc-code  = p-doc-code
     3967           and buf_doc-line.artic     = buf_goods.artic
     3968           and buf_doc-line.prod-type = buf_goods.prod-type
     3969           and buf_doc-line.prod-code = buf_goods.prod-code
     3970       .
     3971       v-sum-parts-qnty = 0 .
     3972       for each doc_parts no-lock where doc_parts.out-code = buf_trn-doc.doc-code
     3973                                    and doc_parts.obj-type = v-cntxt-obj-type
     3974                                    and doc_parts.obj-code = v-cntxt-obj-code
     3975                                    and doc_parts.artic = buf_goods.artic
     3976                                    and doc_parts.prod-type = buf_goods.prod-type
     3977                                    and doc_parts.prod-code = buf_goods.prod-code
     3978       :
     3979         v-sum-parts-qnty = v-sum-parts-qnty + doc_parts.fact-qnty .
     3980       end .
     3981       if buf_doc-line.fact-qnty <> v-sum-parts-qnty
     3982       then do :
     3983         message substitute("Сумма количеств по партиям документа &1 не равна фактическому количеству по строке &2 .", v-sum-parts-qnty, buf_doc-line.fact-qnty) skip
     3984                 "Скорректируйте количество по партиям."
     3985         view-as alert-box .
     3986         return no-apply .
     3987       end .
     3988     end .
     3989   END.
