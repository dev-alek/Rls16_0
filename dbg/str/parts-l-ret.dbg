     9950     run waitfram-hide in this-procedure .
     9951         run gbl/getobjsrvhndl.p (input-output ObjSrv).
     9952         EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code).
     9953         RUN gds-attr-value (
     9954                             INPUT buf_goods.gds-code,
     9955                             INPUT 'mark-type':U,
     9956                             OUTPUT varvalue,
     9957                             OUTPUT vartype
     9958                             ).
     9959         if varvalue > ""
