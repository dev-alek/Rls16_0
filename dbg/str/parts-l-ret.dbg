     2849   FUNCTION get-b-code RETURNS integer
     2850     ( BUFFER buf_parts FOR parts ) :
     2851     define variable v-b-code like ub.bar-code.b-code no-undo .
     2852   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     2853     (buffer parts
     2854     ,output v-b-code
     2855     ) no-error .
     2856     if error-status :error
     2857     then do:
     2858       return 0 .
     2859     end.
     2860     else do:
     2861       return v-b-code .
     2862     end.
     2863   END FUNCTION.
     2864   FUNCTION get-price-sale RETURNS DECIMAL
     2865     ( input p-recid as recid ) :
     2866   define buffer buf_parts for ub.parts  .
     2867   define variable v-price as decimal   no-undo .
     2868   define variable v-cur-dn as character no-undo .
     2869   define variable v-cur-rt as decimal   no-undo .
     2870   define variable v-cur-ex as decimal   no-undo .
     2871   define variable v-b-code as integer   no-undo .
     2872   v-price = 0.
     2873   find first  buf_parts no-lock where recid(buf_parts) = p-recid no-error .
     2874   v-b-code = get-b-code(buffer buf_parts) .
     2875   if v-b-code = 0 then return .0 .
     2876   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2877   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2878     (input  buf_parts.obj-type
     2879     ,input  buf_parts.obj-code
     2880     ,input  v-b-code
     2881     ,input  0
     2882     ,input  0
     2883     ,output v-cur-dn
     2884     ,output v-price
     2885     ,output v-cur-rt
     2886     ,output v-cur-ex
     2887     ) no-error .
     2888      if error-status :error then do:
     2889        v-price = ? .
     2890      end.
     2891      return  v-price .
     2892   END FUNCTION.
     2893   FUNCTION get-price-doc RETURNS character
     2894     ( input p-recid as recid ) :
     2895   define buffer buf_parts for ub.parts  .
     2896   define variable v-price as decimal   no-undo .
     2897   define variable v-cur-dn as character no-undo .
     2898   define variable v-cur-rt as decimal   no-undo .
     2899   define variable v-cur-ex as decimal   no-undo .
     2900   define variable v-b-code as integer   no-undo .
     2901   v-cur-dn = "".
     2902   find first  buf_parts no-lock where recid(buf_parts) = p-recid no-error .
     2903   v-b-code = get-b-code(buffer buf_parts) .
     2904   if v-b-code = 0 then return "".
     2905   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2906   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2907     (input  buf_parts.obj-type
     2908     ,input  buf_parts.obj-code
     2909     ,input  v-b-code
     2910     ,input  0
     2911     ,input  0
     2912     ,output v-cur-dn
     2913     ,output v-price
     2914     ,output v-cur-rt
     2915     ,output v-cur-ex
     2916     ) no-error .
     2917      if error-status :error then do:
     2918        v-cur-dn = ? .
     2919      end.
     2920      return substitute("&1 №&2" , v-price ,v-cur-dn) .
     2921   END FUNCTION.
     2922   FUNCTION get-in-code-dateS RETURNS date
     2923     ( input p-recid as recid ) :
     2924   define buffer buf_parts for ub.parts  .
     2925   define buffer buf_parts-attr for ub.parts-attr  .
     2926   define buffer buf_goods      for ub.goods       .
     2927   find first  buf_parts no-lock where recid(buf_parts) = p-recid no-error .
     2928   find first buf_goods no-lock where
     2929               buf_goods.artic =  buf_parts.artic and
     2930               buf_goods.prod-code =  buf_parts.prod-code and
     2931               buf_goods.prod-type =  buf_parts.prod-type no-error .
     2932   find first buf_parts-attr no-lock
     2933        where buf_parts-attr.part-code = buf_parts.part-code and
     2934              buf_parts-attr.in-code   = buf_parts.in-code   and
     2935              buf_parts-attr.gds-code  = buf_goods.gds-code  no-error .
     2936              if available buf_parts-attr then return  buf_parts-attr.fact-date .
     2937              else return date("") .
     2938   END FUNCTION.
