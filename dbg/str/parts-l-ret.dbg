     9728     define parameter buffer buf_trn-doc for ub.trn-doc .
     9729     define buffer buf_clients for ub.clients .
     9730     define variable v-doc-type as character .
     9731     v-doc-type = "при" .
     9732     enable
     9733       b-sel
     9734       f-date-to
     9735       f-date-from
     9736     with frame Dialog-Frame.
