     3272   DEFINE QUERY br-parts FOR
     3273         parts SCROLLING.
     3274   DEFINE BROWSE br-parts
     3275     QUERY br-parts DISPLAY
     3276         get-mark(buffer parts) @ mark
     3277         get-parts-part-code(buffer parts, v-goods-alcohol-prod) @ parts-part-code
     3278         get-parts-out-code(buffer parts) @ parts-out-code
