     4142   ON CHOOSE OF b-marking IN FRAME Dialog-Frame
     4143   DO:
     4144   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4145   if lookup(self :type
     4146            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4147            ) = 0
     4148   then do:
     4149     message
     4150       "$Workfile$"
     4151       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4152       "Интерфейсный элемент" self :name  skip
     4153       "Тип" self :type  skip
     4154       "Процедура" this-procedure :file-name skip
     4155       view-as alert-box .
     4156   end.
     4157   else do:
     4158     apply "entry":u to self  .
     4159     if focus :handle <> self :handle  then do:
     4160       return no-apply .
     4161     end.
     4162   end.
     4163   define variable p-mode as char no-undo.
     4164   p-mode = 'ПРОСМОТР':U.
     4165   if not available parts then do:
     4166       message
     4167       "Нет партий по товару"
     4168       view-as alert-box.
     4169       return no-apply.
     4170   end.
     4171   define buffer buf_goods for ub.goods .
     4172   define buffer buf_marking-lines for ub.marking-lines .
     4173   define buffer buf_marking-lines-parent for ub.marking-lines .
     4174   define buffer buf_marking for ub.marking .
     4175   find first buf_goods no-lock where buf_goods.artic = parts.artic and buf_goods.prod-code = parts.prod-code and buf_goods.prod-type = parts.prod-type no-error .
     4176   if available (buf_goods) then do:
     4177     empty temp-table tt-marking-lines .
     4178       for each buf_marking-lines no-lock where buf_marking-lines.gds-code = buf_goods.gds-code and buf_marking-lines.in-code = parts.in-code and buf_marking-lines.out-code = parts.out-code
     4179         and buf_marking-lines.part-code = parts.part-code and buf_marking-lines.obj-code = parts.obj-code and buf_marking-lines.obj-type = parts.obj-type:
     4180         for each buf_marking no-lock where buf_marking.mark = buf_marking-lines.mark :
     4181           create tt-marking-lines .
     4182           assign
     4183             tt-marking-lines.stts        = StatusTHName(buf_marking.sts)
     4184             tt-marking-lines.gds-name    = buf_goods.gds-name
     4185             tt-marking-lines.mark        = buf_marking.mark
     4186             tt-marking-lines.mark-parent = buf_marking.mark-parent
     4187             tt-marking-lines.gds-code    = buf_marking-lines.gds-code
     4188             tt-marking-lines.sts         = buf_marking.sts
     4189             tt-marking-lines.unit        = buf_marking.unit
     4190             tt-marking-lines.unit-ext    = buf_marking.unit-ext
     4191             tt-marking-lines.box-qnty    = buf_marking.box-qnty
     4192             tt-marking-lines.doc-level   = buf_marking-lines.doc-level
     4193             tt-marking-lines.in-code     = parts.in-code
     4194             tt-marking-lines.out-code    = parts.out-code
     4195             tt-marking-lines.obj-code    = parts.obj-code
     4196             tt-marking-lines.obj-type    = parts.obj-type
     4197             .
     4198             if buf_marking.sts = 10
     4199             then do:
     4200               if buf_marking.mark-parent <> ""
     4201               then do :
     4202                 find first buf_marking-lines-parent no-lock where buf_marking-lines-parent.mark = buf_marking.mark-parent
     4203                                                               and buf_marking-lines-parent.gds-code = buf_marking-lines.gds-code
     4204                                                               and buf_marking-lines-parent.obj-type = buf_marking-lines.obj-type
     4205                                                               and buf_marking-lines-parent.obj-code = buf_marking-lines.obj-code
     4206                                                               and buf_marking-lines-parent.in-code  = buf_marking-lines.in-code
     4207                                                               and buf_marking-lines-parent.out-code = buf_marking-lines.out-code
     4208                                                               and buf_marking-lines-parent.part-code = buf_marking-lines.part-code
     4209                                                               and buf_marking-lines-parent.doc-level > 0
     4210                                                               no-error .
     4211                 if available buf_marking-lines-parent
     4212                 then do :
     4213                   tt-marking-lines.doc-level = 2 .
     4214                 end .
     4215                 else do :
     4216                   tt-marking-lines.doc-level = 1 .
     4217                 end .
     4218               end .
     4219               else tt-marking-lines.doc-level = 1 .
     4220             end.
     4221         end.
     4222       end.
     4223   end.
     4224         run str/mark_browse.w (input parparentproc,
     4225           input-output table tt-marking-lines,
     4226           input "",
     4227           input "Марки по: " + "По партии №" + string (parts.part-code) + " по товару - " + string(buf_goods.gds-code) + " " + string (buf_goods.gds-name),
     4228           input 0,
     4229           input ""
     4230           ) no-error .
     4231   END.
