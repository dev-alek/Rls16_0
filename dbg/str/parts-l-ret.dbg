     3295         parts.hold-date format '99/99/9999':u column-label "Дата МФ"
     3296         parts.pl-code column-label "Место"
     3297         get-b-code(buffer parts) @ parts-b-code
     3298         get-purch-code(buffer parts) @ parts-purch-code
     3299         get-contract-prn-code(recid(parts)) @ parts-contract-prn-code column-label "Договор" format "x(20)"
     3300         parts.part-code column-label "Код партии в БД" format "x(20)"
     3301         parts.in-code column-label "Источник" format "x(20)"
     3302         (get-in-code-date(recid(parts))) column-label "Дата ист."  format "x(10)"
     3303         (get-price-sale(recid(parts)))  column-label "Тек.прод.цена"  format ">>>>>>>>>9.99"
     3304         (get-price-prod1(recid(parts)))  @  vprice-prod1 column-label "Цена Произв."  format ">>>>>>>>>9.99"
     3305         (get-price-prod2(recid(parts)))  @  vprice-prod2 column-label "Цена Прзв_с_НДС"  format ">>>>>>>>>>>9.99"
     3306       if parts.defect = logical('yes':U) then "+"  else "" column-label "Ф" format "x(1)"
     3307     ENABLE
     3308         parts.qnty
     3309         parts.fact-qnty
     3310       WITH NO-ROW-MARKERS SEPARATORS SIZE 96 BY 8.42
