     6361         .
     6362       end.
     6363       define variable v-mercury-value as character no-undo .
     6364       define variable v-mercury-type  as character no-undo .
     6365       define variable v-mercury-prod as logical init false.
     6366       define buffer buf_trn-doc for ub.trn-doc .
     6367       find first buf_trn-doc no-lock
     6368         where buf_trn-doc.doc-code = p-doc-code no-error
     6369         .
     6370       v-vozvr-perem-no-fact = false.
     6371       if p-doc-code = ? or p-doc-code = "" or (buf_trn-doc.ext-doc-type = 'ie':U or  buf_trn-doc.ext-doc-type = 'iv':U  or  buf_trn-doc.ext-doc-type = 'rv':U)
     6372       then do:
     6373   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6374     (input  'mercuri':u
     6375     ,input  '':u
     6376     ,input  '':u
     6377     ,input  0
     6378     ,input  '':u
     6379     ,input  '':u
     6380     ,input  '':u
     6381     ,input  no
     6382     ,output v-mercury-value
     6383     ,output v-mercury-type
     6384     ) no-error .
     6385         if  not error-status :error
     6386         and lookup(v-mercury-value, 'no':u) = 0
     6387         then do:
     6388   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     6389     (input  p-gds-code
     6390     ,input  'mercur_FGIS=request':u
     6391     ,output v-mercury-prod
     6392     ) no-error .
     6393           if error-status :error
     6394           then do:
     6395             message
     6396               vss-workfile vss-revision vss-description skip
     6397               "Ошибка при определении атрибута товара" skip
     6398               "Код товара" p-gds-code skip
     6399               'mercur_FGIS=request':u skip
     6400               error-status :get-message(1) skip
     6401               return-value skip
     6402               view-as alert-box error .
     6403             undo, return error .
     6404           end.
     6405           if available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'rv':U and buf_trn-doc.status_ <> 'факт':U
     6406           then
     6407             v-vozvr-perem-no-fact = true.
     6408         end.
     6409         else do:
     6410           assign
     6411             v-mercury-prod = false
     6412           .
     6413         end.
     6414       end.
     6415   if  p-call-point = 'документ':U
     6416   and (p-edit-mode = 'ИЗМЕНЕНИЕ':U
     6417        or p-edit-mode = 'ДОБАВЛЕНИЕ':U
     6418        or v-ext-mode = "vsd_corr-parts"
     6419        or v-ext-mode = "corr-parts"
     6420       )
     6421   then do:
     6422     assign
     6423       v-edit-parts = true
     6424     .
     6425     define variable v-rsrv-type as character no-undo .
     6426   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rsrvtype in g#library
     6427     (input  p-doc-code
     6428     ,output v-rsrv-type
     6429     ) no-error .
     6430     if error-status :error
     6431     then do:
     6432       message
     6433         vss-workfile vss-revision vss-description skip
     6434         "Ошибка при определении типа резервирования документа" skip
     6435         "Документ" p-doc-code skip
     6436         "Режим интерфейса" p-edit-mode skip
     6437         error-status :get-message(1) skip
     6438         return-value skip
     6439         view-as alert-box error .
     6440       undo, return error return-value .
     6441     end.
     6442     assign
     6443       v-add-parts = false
     6444     .
     6445     case v-rsrv-type :
     6446       when 'rsrv-pri-doc':U or
     6447       when 'rsrv-pri-fact':U
     6448       then do:
     6449         assign
     6450           v-add-parts = true
     6451         .
     6452       end.
     6453       when 'rsrv-doc':U
     6454       then do:
     6455         assign
     6456           v-add-parts = true
     6457         .
     6458         if v-goods-twounit = true
     6459         then do:
     6460           assign
     6461             v-add-parts = false
     6462           .
     6463         end.
     6464       end.
     6465     end.
     6466     if buf_trn-doc.ext-doc-type = 'ap':U
     6467     then do:
     6468       assign
     6469         v-add-parts = false
     6470       .
     6471     end.
     6472   end.
     6473   else do:
     6474     assign
     6475       v-edit-parts = false
     6476     .
     6477   end.
     6478   if v-edit-parts = true
     6479   then do:
     6480     TRANSACTION-MAIN-BLOCK:
     6481     DO TRANSACTION
     6482     ON ERROR   UNDO TRANSACTION-MAIN-BLOCK, LEAVE TRANSACTION-MAIN-BLOCK
     6483     ON END-KEY UNDO TRANSACTION-MAIN-BLOCK, LEAVE TRANSACTION-MAIN-BLOCK
     6484     :
     6485       run main-block-procedure no-error .
     6486       if error-status :error
     6487       then do:
     6488         if v-need-rsrv-gds
     6489         then do:
     6490           undo transaction-main-block, leave transaction-main-block .
     6491         end.
     6492              else do:
     6493           undo, return error .
     6494         end.
     6495       end.
     6496     END.
     6497   end.
     6498   else do:
     6499     MAIN-BLOCK:
     6500     DO
     6501     ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6502     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6503     :
     6504       run main-block-procedure no-error .
     6505       if error-status :error
     6506       then do:
     6507         undo MAIN-BLOCK, LEAVE MAIN-BLOCK .
     6508       end.
     6509     END.
     6510   end.
     6511   RUN disable_UI.
     6512   PROCEDURE check-input-parameters :
     6513     define buffer buf_clients for ub.clients .
     6514     define buffer buf_trn-doc for ub.trn-doc .
     6515     define buffer buf_goods for ub.goods .
     6516     do
     6517     on error undo, return error
     6518     :
     6519       find first buf_clients no-lock
     6520         where buf_clients.obj-type = v-obj-type
     6521           and buf_clients.obj-code = v-obj-code
     6522         no-error .
     6523       if (not available buf_clients)
     6524       or (lookup(v-obj-type, 'скл':U + chr(44) + 'маг':U) = 0)
     6525       then do:
     6526         message
     6527           vss-workfile vss-revision vss-description skip
     6528           "Ошибка задания входных параметров" skip
     6529           "Ошибка задания объекта" skip
     6530           "Объект" v-obj-type v-obj-code skip
     6531           "Документ" p-doc-code skip
     6532           "Код товара" p-gds-code skip
     6533           view-as alert-box error .
     6534         undo, return error return-value .
     6535       end.
     6536       if p-doc-code <> ""
     6537       then do:
     6538         find first buf_trn-doc no-lock
     6539           where buf_trn-doc.doc-code = p-doc-code
     6540           no-error .
     6541         if not available buf_trn-doc
     6542         then do:
     6543           message
     6544             vss-workfile vss-revision vss-description skip
     6545             "Ошибка задания входных параметров" skip
     6546             "Не найден документ" skip
     6547             "Объект" v-obj-type v-obj-code skip
     6548             "Документ" p-doc-code skip
     6549             "Код товара" p-gds-code skip
     6550             view-as alert-box error .
     6551           undo, return error return-value .
     6552         end.
     6553       end.
     6554       find first buf_goods no-lock
     6555         where buf_goods.gds-code = p-gds-code
     6556         no-error .
     6557       if not available buf_goods
     6558       then do:
     6559         message
     6560           vss-workfile vss-revision vss-description skip
     6561           "Ошибка задания входных параметров" skip
     6562           "Не найден товар" skip
     6563           "Объект" v-obj-type v-obj-code skip
     6564           "Документ" p-doc-code skip
     6565           "Код товара" p-gds-code skip
     6566           view-as alert-box error .
     6567         undo, return error return-value .
     6568       end.
     6569       define variable ind                     as integer no-undo .
     6570       define variable v-num-entries-p-r-parts as integer no-undo .
     6571       if p-r-parts = ""
     6572       or p-r-parts = ?
     6573       then do:
     6574         message
     6575           vss-workfile vss-revision vss-description skip
     6576           "Ошибка при задании параметров вызова резервирования" skip
     6577           "Не задан параметр вызова p-r-parts." skip
     6578           view-as alert-box error .
     6579         undo, return error .
     6580       end.
     6581       assign
     6582         v-need-reserv          = true
     6583         v-need-check-diff-qnty = true
     6584         v-chg-qnty             = 0
     6585       .
     6586       assign
     6587         v-num-entries-p-r-parts = num-entries(p-r-parts)
     6588       .
     6589       do ind = 2 to v-num-entries-p-r-parts
     6590       :
     6591         define variable v-option       as character no-undo .
     6592         define variable v-option-key   as character no-undo .
     6593         define variable v-option-value as character no-undo .
     6594         assign
     6595           v-option = entry(ind, p-r-parts)
     6596         .
     6597         if v-option = ""
     6598         or v-option = ?
     6599         then do:
     6600           message
     6601             vss-workfile vss-revision vss-description skip
     6602             "Ошибка при задании параметров вызова" skip
     6603             "В качестве параметров резервирования задана пустая или неопределенная опция" skip
     6604             "v-option" v-option skip
     6605             "p-r-parts" p-r-parts skip
     6606             view-as alert-box error .
     6607           undo, return error .
     6608         end.
     6609         assign
     6610           v-option-key = entry(1, v-option, "=" )
     6611         .
     6612         case v-option-key :
     6613           when 'без-резервирования':U
     6614           then do:
     6615             assign
     6616               v-need-reserv = false
     6617             .
     6618           end.
     6619           when 'no-diff-check':U
     6620           then do:
     6621             assign
     6622               v-need-check-diff-qnty = false
     6623             .
     6624           end.
     6625           when 'chg-qnty':U
     6626           then do:
     6627             if num-entries(v-option, "=") <> 2
     6628             then do:
     6629               message
     6630                 vss-workfile vss-revision vss-description skip
     6631                 "Ошибка при задании параметров вызова резервирования" skip
     6632                 "Для указания количества по резервированию необходимо указать строку" skip
     6633                 "" 'chg-qnty':U + "=<plcode>" skip
     6634                 "v-option" v-option skip
     6635                 "p-r-parts" p-r-parts skip
     6636                 view-as alert-box error .
     6637               undo, return error .
     6638             end.
     6639             assign
     6640               v-chg-qnty = decimal(entry(2, v-option, "=" ))
     6641             .
     6642           end.
     6643           otherwise do:
     6644             message
     6645               vss-workfile vss-revision vss-description skip
     6646               "Ошибка при задании параметров вызова резервирования" skip
     6647               "Неизвестная опция." v-option skip
     6648               "p-r-parts" p-r-parts skip
     6649               view-as alert-box error .
     6650             undo, return error .
     6651           end.
     6652         end.
     6653       end.
     6654       assign
     6655         p-r-parts = entry(1, p-r-parts)
     6656       .
     6657       if lookup(p-r-parts
     6658                 , 'все':U
     6659                 + chr(44) + 'остатки':U
     6660                 + chr(44) + 'свободно':U
     6661                 + chr(44) + 'документ':U
     6662                ) = 0
     6663       then do:
     6664         message
     6665           vss-workfile vss-revision vss-description skip
     6666           "Ошибка при задании параметров вызова" skip
     6667           "Недопустимый параметр вызова p-r-parts" skip
     6668           "Значение p-r-parts:"  p-r-parts skip
     6669           "Допустимые значения параметра"
     6670                 'все':U + chr(44) + 'остатки':U
     6671                 + chr(44) + 'свободно':U
     6672                 + chr(44) + 'документ':U skip
     6673           view-as alert-box error .
     6674         undo, return error .
     6675       end.
     6676     end.
     6677   END PROCEDURE.
     6678   PROCEDURE contract-code-to-str :
     6679     define input  parameter p-contract-code     as integer   no-undo .
     6680     define input  parameter p-obj-type          as character no-undo .
     6681     define input  parameter p-obj-code          as integer   no-undo .
     6682     define output parameter p-contract-code-str as character no-undo .
     6683     define buffer buf_contract for ub.contract .
     6684     define variable v-host-code as integer   no-undo .
     6685   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6686   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6687     (input  p-obj-type
     6688     ,input  p-obj-code
     6689     ,output v-host-code
     6690     )  .
     6691     find first buf_contract no-lock
     6692       where buf_contract.host-code     = v-host-code
     6693         and buf_contract.contract-code = p-contract-code
     6694       no-error .
     6695     if available buf_contract
     6696     then do:
     6697       assign
     6698         p-contract-code-str = substitute('&1 &2 Вн.н. &3':u
     6699                                 ,buf_contract.contract-prn-code
     6700                                 ,string(buf_contract.contract-date, '99/99/9999':u)
     6701                                 ,buf_contract.contract-code
     6702                                 )
     6703       .
     6704     end.
     6705     else do:
     6706       if p-contract-code = 0
     6707       then do:
     6708         assign
     6709           p-contract-code-str = ""
     6710         .
     6711       end.
     6712       else do:
     6713         assign
     6714           p-contract-code-str = "?"
     6715         .
     6716       end.
     6717     end.
     6718   END PROCEDURE.
     6719   PROCEDURE create-bar-code-parts :
     6720   define input  parameter   p-gds-code   as integer   no-undo .
     6721   define input  parameter   p-part-code  as character no-undo .
     6722   define input  parameter   p-in-code    as character no-undo .
     6723   define input  parameter   p-unit-base  as character no-undo .
     6724   define variable v-bar-code-is-new as logical   no-undo .
     6725   define variable v-root-node as integer   no-undo .
     6726   define buffer buf_bar-code for ub.bar-code  .
     6727   define buffer buf_goods for ub.goods  .
     6728   find first buf_goods no-lock where  buf_goods.gds-code = p-gds-code no-error .
     6729   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6730   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     6731     (input  buf_goods.artic
     6732     ,input  buf_goods.prod-type
     6733     ,input  buf_goods.prod-code
     6734     ,output v-root-node
     6735     ) no-error .
     6736   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6737   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     6738     (input  p-gds-code
     6739     ,input  v-root-node
     6740     ,input  p-part-code
     6741     ,input  p-in-code
     6742     ,input  p-unit-base
     6743     ,input  ?
     6744     ,output v-bar-code-is-new
     6745     ,buffer buf_bar-code
     6746     ) no-error .
     6747   END PROCEDURE.
     6748   PROCEDURE data-changed :
     6749     assign
     6750       v-data-changed = true
     6751     .
     6752   END PROCEDURE.
     6753   PROCEDURE delete-parts :
     6754     define input parameter p-parts-recid as recid no-undo .
     6755     run trg/partdel.p
     6756       (input p-doc-code
     6757       ,input p-parts-recid
     6758       ) .
     6759     run data-changed in this-procedure .
