     9849           "Будут показаны записи без учета фильтра" skip
     9850           view-as alert-box .
     9851       end.
     9852       else do:
     9853           assign
     9854             v-query-was-opened = true
     9855           .
     9856       end.
     9857     end.
     9858     if l-filter-open-80 = false then do:
     9859       open query br-parts for each parts no-lock
     9860         where parts.artic = buf_goods.artic           and parts.prod-type = buf_goods.prod-type           and parts.prod-code = buf_goods.prod-code           and parts.obj-type = v-obj-type           and parts.obj-code = v-obj-code           and parts.in-code  = parts.out-code           and parts.doc-type = v-doc-type           and (( parts.supp-type = buf_trn-doc.cli-type and parts.supp-code = buf_trn-doc.cli-code) or parts.is-supp = no)           and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )           and parts.contract-code = buf_trn-doc.contract-code           and parts.fact-date >= f-date-from and parts.fact-date <= f-date-to
     9861         indexed-reposition
     9862     .
     9863         assign
     9864           v-query-was-opened = true
     9865         .
     9866     end.
     9867   end.
     9868   else do:
     9869     assign
     9870       v-prt-rec = recid( parts )
     9871     .
     9872     do
     9873     on stop undo, leave
     9874     on error undo, leave
     9875     :
     9876       if query br-parts:handle:get-buffer-handle(1) = (buffer parts:handle) then do:
     9877         assign
     9878         parameter-2-80 = (if p-find-next then "true":u else "false":u )
     9879         parameter-4-80 =
     9880           "where ":u +        substitute (       ' parts.artic = &1&2&1        and parts.prod-type = &1&3&1       and parts.prod-code = &4       and parts.obj-type  = &1&7&1       and parts.obj-code  = &8       and parts.in-code   = parts.out-code       and parts.doc-type  = &1&9&1
     9881         and ( &5 <> true or ( &5 = true and parts.pl-code = &6 ) )     ', chr(34) , buf_goods.artic , buf_goods.prod-type , buf_goods.prod-code , v-reserv-pl-code , v-pl-code , v-obj-type , v-obj-code, v-doc-type ) +       substitute ( '           and (( parts.supp-type = &1&2&1 and parts.supp-code = &3 ) or parts.is-supp = no )           and parts.contract-code = &4           and parts.fact-date >= &5 and parts.fact-date <= &6
     9882                 ', chr(34) , buf_trn-doc.cli-type , buf_trn-doc.cli-code , buf_trn-doc.contract-code, f-date-from , f-date-to )        + " ":u + where-phrase-80 + " ":u + p-find-condition + " " + ""
     9883         parameter-5-80 = " "
