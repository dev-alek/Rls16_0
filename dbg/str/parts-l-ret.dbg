     8628         where parts.artic = buf_goods.artic             and parts.prod-type = buf_goods.prod-type             and parts.prod-code = buf_goods.prod-code             and parts.rsrv-free = yes             and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )
     8629         indexed-reposition
     8630     .
     8631         assign
     8632           v-query-was-opened = true
     8633         .
     8634     end.
     8635   end.
     8636   else do:
     8637     assign
     8638       v-prt-rec = recid( parts )
     8639     .
     8640     do
     8641     on stop undo, leave
     8642     on error undo, leave
     8643     :
     8644       if query br-parts:handle:get-buffer-handle(1) = (buffer parts:handle) then do:
     8645         assign
     8646         parameter-2-68 = (if p-find-next then "true":u else "false":u )
     8647         parameter-4-68 =
     8648           "where ":u +                substitute (               ' parts.artic = &1&2&1                and parts.prod-type = &1&3&1               and parts.prod-code = &4               and parts.rsrv-free = yes               and ( &5 <> true or ( &5 = true and parts.pl-code = &6 ) )              ', chr(34) , buf_goods.artic , buf_goods.prod-type , buf_goods.prod-code , v-reserv-pl-code , v-pl-code )                + " ":u + where-phrase-68 + " ":u + p-find-condition + " " + ""
