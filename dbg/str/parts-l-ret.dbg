     6761   PROCEDURE disable_UI :
     6762     HIDE FRAME Dialog-Frame.
     6763   END PROCEDURE.
     6764   PROCEDURE display-doc-line-info :
     6765     define buffer buf_trn-doc for ub.trn-doc .
     6766     define buffer buf_goods   for ub.goods .
     6767     define buffer buf_doc-line for ub.doc-line .
     6768     find first buf_goods no-lock
     6769       where buf_goods.gds-code = p-gds-code
     6770       .
     6771     find first buf_trn-doc no-lock
     6772       where buf_trn-doc.doc-code = p-doc-code
     6773       no-error .
     6774     find first buf_doc-line no-lock
     6775       where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     6776         and buf_doc-line.artic     = buf_goods.artic
     6777         and buf_doc-line.prod-type = buf_goods.prod-type
     6778         and buf_doc-line.prod-code = buf_goods.prod-code
     6779       no-error .
     6780     if  available buf_trn-doc
     6781     and available buf_doc-line
     6782     then do:
     6783       if buf_trn-doc.status_ = 'накл':U
     6784       and buf_trn-doc.flag_ = no
     6785       then do:
     6786         display
     6787           (buf_doc-line.doc-qnty + v-chg-qnty) @ FI_doc-line_doc-qnty
     6788           with frame Dialog-Frame.
     6789       end.
     6790       else do:
     6791         display
     6792           buf_doc-line.doc-qnty  @ FI_doc-line_doc-qnty
     6793           buf_doc-line.fact-qnty @ FI_doc-line_fact-qnty
     6794           with frame Dialog-Frame.
     6795       end.
     6796     end.
     6797   END PROCEDURE.
     6798   PROCEDURE display-parts-info :
     6799     define buffer buf_goods    for ub.goods .
     6800     define buffer buf_clients  for ub.clients .
     6801     define buffer buf_pay-type for ub.pay-type .
     6802     define buffer buf_currency for ub.currency .
     6803     define buffer buf_parts    for ub.parts .
     6804     do with frame Dialog-Frame:
     6805       if available parts
     6806       then do:
     6807         find first buf_goods no-lock
     6808           where buf_goods.artic     = parts.artic
     6809             and buf_goods.prod-type = parts.prod-type
     6810             and buf_goods.prod-code = parts.prod-code
     6811           .
     6812         find buf_clients no-lock
     6813           where buf_clients.obj-type = parts.supp-type
     6814             and buf_clients.obj-code = parts.supp-code
     6815           no-error.
     6816         if available buf_clients
     6817         then do:
     6818           display
     6819             buf_clients.obj-name @ FI_obj-name
     6820             buf_clients.obj-type @ FI_obj-type
     6821             buf_clients.obj-code @ FI_obj-code
     6822             with frame Dialog-Frame.
     6823         end.
     6824         else do:
     6825           display
     6826             "?" @ FI_obj-name
     6827             ""  @ FI_obj-type
     6828             ""  @ FI_obj-code
     6829             with frame Dialog-Frame.
     6830         end.
     6831         display
     6832           get-b-code(buffer parts) @ fi-b-code
     6833           with frame Dialog-Frame .
     6834         find buf_pay-type no-lock
     6835           where buf_pay-type.obj-code = parts.pay-code
     6836           no-error.
     6837         if available buf_pay-type
     6838         then do:
     6839           assign
     6840             FI_pay-name :screen-value = buf_pay-type.obj-name
     6841           .
     6842         end.
     6843         else do:
     6844           assign
     6845             FI_pay-name :screen-value = ""
     6846           .
     6847         end.
     6848         find buf_currency no-lock
     6849           where buf_currency.curr-code = parts.exch-code
     6850           no-error.
     6851         if available buf_currency
     6852         then do:
     6853           assign
     6854             FI_currency_curr-abbr :screen-value = buf_currency.curr-abbr
     6855           .
     6856         end.
     6857         else do:
     6858           assign
     6859             FI_currency_curr-abbr :screen-value = ""
     6860           .
     6861         end.
     6862         define variable v-free-qnty      as decimal no-undo .
     6863         define variable v-free-rsrv-qnty as decimal no-undo .
     6864         define variable v-out-qnty       as decimal no-undo .
     6865         define variable v-out-rsrv-qnty  as decimal no-undo .
     6866         define variable v-income-qnty    as decimal no-undo .
     6867         define variable v-income-qnty-fact    as decimal no-undo .
     6868         assign
     6869           v-free-qnty      = 0
     6870           v-free-rsrv-qnty = 0
     6871           v-out-qnty       = 0
     6872           v-out-rsrv-qnty  = 0
     6873           v-income-qnty    = 0
     6874           v-income-qnty-fact    = 0
     6875         .
     6876         for each buf_parts no-lock
     6877           where buf_parts.obj-type  = parts.obj-type
     6878             and buf_parts.obj-code  = parts.obj-code
     6879             and buf_parts.artic     = parts.artic
     6880             and buf_parts.prod-type = parts.prod-type
     6881             and buf_parts.prod-code = parts.prod-code
     6882             and buf_parts.in-code   = parts.in-code
     6883             and buf_parts.part-code = parts.part-code
     6884             and buf_parts.status_   = no
     6885             and buf_parts.rsrv-free = yes
     6886         :
     6887           if buf_parts.out-code = 'free-zone':U
     6888           then do:
     6889             assign
     6890               v-free-qnty      = v-free-qnty + buf_parts.qnty
     6891             .
     6892           end.
     6893           else do:
     6894             assign
     6895               v-free-rsrv-qnty = v-free-rsrv-qnty  + abs(buf_parts.qnty)
     6896             .
     6897           end.
     6898         end.
     6899         for each buf_parts no-lock
     6900           where buf_parts.obj-type  = parts.obj-type
     6901             and buf_parts.obj-code  = parts.obj-code
     6902             and buf_parts.artic     = parts.artic
     6903             and buf_parts.prod-type = parts.prod-type
     6904             and buf_parts.prod-code = parts.prod-code
     6905             and buf_parts.in-code   = parts.in-code
     6906             and buf_parts.part-code = parts.part-code
     6907             and buf_parts.status_   = no
     6908             and buf_parts.rsrv-free = no
     6909         :
     6910           if buf_parts.out-code = 'out-zone':U
     6911           then do:
     6912             assign
     6913               v-out-qnty      = v-out-qnty + buf_parts.qnty
     6914             .
     6915           end.
     6916           else do:
     6917             assign
     6918               v-out-rsrv-qnty = v-out-rsrv-qnty + buf_parts.qnty
     6919             .
     6920           end.
     6921         end.
     6922         for each buf_parts no-lock
     6923           where buf_parts.obj-type  = parts.obj-type
     6924             and buf_parts.obj-code  = parts.obj-code
     6925             and buf_parts.artic     = parts.artic
     6926             and buf_parts.prod-type = parts.prod-type
     6927             and buf_parts.prod-code = parts.prod-code
     6928             and buf_parts.in-code   = parts.in-code
     6929             and buf_parts.part-code = parts.part-code
     6930             and buf_parts.out-code  = parts.in-code
     6931             and buf_parts.doc-type  = 'при':U
     6932         :
     6933           assign
     6934             v-income-qnty    = v-income-qnty + buf_parts.qnty
     6935             v-income-qnty-fact    = v-income-qnty-fact + buf_parts.fact-qnty
     6936           .
     6937         end.
     6938         assign
     6939           ed-notes          = parts.PS
     6940           fi-free-qnty      = v-free-qnty
     6941           fi-free-rsrv-qnty = v-free-rsrv-qnty
     6942           fi-out-qnty       = v-out-qnty
     6943           fi-out-rsrv-qnty  = v-out-rsrv-qnty
     6944           fi-income-qnty    = v-income-qnty
     6945           fi-income-qnty-fact = v-income-qnty-fact
     6946         .
     6947         define variable v-in-code-fact-date as date      no-undo .
     6948         define buffer buf_trn-doc for ub.trn-doc .
     6949         find first buf_trn-doc no-lock
     6950           where buf_trn-doc.doc-code = ub.parts.in-code
     6951           no-error .
     6952         if available buf_trn-doc
     6953         then do:
     6954           assign
     6955             v-in-code-fact-date = buf_trn-doc.fact-date
     6956           .
     6957         end.
     6958         else do:
     6959           assign
     6960             v-in-code-fact-date = ub.parts.fact-date
     6961           .
     6962         end.
     6963         define variable v-last-fact-date as character no-undo .
     6964         if parts.last-date <> ?
     6965         then do:
     6966           assign
     6967             v-last-fact-date = string(parts.last-date, '99/99/9999':u)
     6968           .
     6969         end.
     6970         else do:
     6971           assign
     6972             v-last-fact-date = ""
     6973           .
     6974         end.
     6975         assign
     6976           FI_parts_orig-in-code   = ""
     6977           FI_parts_orig-fact-date = ?
     6978           FI_orig-purch-code      = ""
     6979         .
     6980         define variable v-gds-code       as integer   no-undo .
     6981   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pargocod in g#library
     6982     (input  recid(parts)
     6983     ,output v-gds-code
     6984     )  .
     6985         define buffer buf_parts-attr for ub.parts-attr .
     6986         find first buf_parts-attr no-lock
     6987           where buf_parts-attr.in-code   = parts.in-code
     6988             and buf_parts-attr.gds-code  = v-gds-code
     6989             and buf_parts-attr.part-code = parts.part-code
     6990           no-error .
     6991         if available buf_parts-attr
     6992         then do:
     6993           assign
     6994             FI_parts_orig-in-code   = buf_parts-attr.income-in-code
     6995           .
     6996           define buffer buf_income_parts-attr for ub.parts-attr .
     6997           find first buf_income_parts-attr no-lock
     6998             where buf_income_parts-attr.in-code   = buf_parts-attr.income-in-code
     6999               and buf_income_parts-attr.gds-code  = buf_parts-attr.income-gds-code
     7000               and buf_income_parts-attr.part-code = buf_parts-attr.income-part-code
     7001             no-error .
     7002           if available buf_income_parts-attr
     7003           then do:
     7004             assign
     7005               FI_parts_orig-fact-date = buf_income_parts-attr.fact-date
     7006             .
     7007             run purch-code-to-str in this-procedure
     7008               (input  buf_income_parts-attr.purch-code
     7009               ,output FI_orig-purch-code
     7010               ) .
     7011           end.
     7012           assign
     7013             fi_unit_cli-abbr = buf_parts-attr.unit-cli
     7014           .
     7015         end.
     7016         else do:
     7017           assign
     7018             FI_parts_orig-in-code   = '':u
     7019             FI_parts_orig-fact-date = ?
     7020             FI_orig-purch-code      = '':u
     7021             fi_unit_cli-abbr        = buf_goods.unit-cli
     7022           .
     7023           if parts.in-code = parts.out-code
     7024           then do:
     7025             define buffer buf_doc-line for ub.doc-line .
     7026             find first buf_doc-line no-lock
     7027               where buf_doc-line.doc-code  = parts.out-code
     7028                 and buf_doc-line.artic     = parts.artic
     7029                 and buf_doc-line.prod-type = parts.prod-type
     7030                 and buf_doc-line.prod-code = parts.prod-code
     7031               no-error .
     7032             if available buf_doc-line
     7033             then do:
     7034               assign
     7035                 fi_unit_cli-abbr = buf_doc-line.unit-cli
     7036               .
     7037             end.
     7038           end.
     7039         end.
     7040         display
     7041           FI_parts_orig-in-code
     7042           FI_parts_orig-fact-date
     7043           FI_orig-purch-code
     7044           fi_unit_cli-abbr
     7045           parts.VAT-pc    @ FI_parts_VAT-pc
     7046           parts.VAT-type  @ FI_parts_VAT-type
     7047           parts.SLT-pc    @ FI_parts_SLT-pc
     7048           parts.SLT-type  @ FI_parts_SLT-type
     7049           parts.price-cli @ FI_parts_price-cli
     7050           parts.cli-qnty  @ FI_parts_cli-qnty
     7051           parts.cli-base-rate @ FI_parts_cli-base-rate
     7052           get-purch-code(buffer parts) @ FI_purch-code
     7053           get-contract-prn-code(recid(parts)) @ FI_contract-prn-code
     7054           get-country-name(buffer parts) @ FI_country-name
     7055           parts.in-code   @ FI_parts_in-code
     7056           v-in-code-fact-date @ FI_parts_fact-date
     7057           v-last-fact-date @ fi_last-date
     7058           ed-notes
     7059           fi-free-qnty
     7060           fi-free-rsrv-qnty
     7061           fi-out-qnty
     7062           fi-out-rsrv-qnty
     7063           fi-income-qnty
     7064           fi-income-qnty-fact
     7065           get-price-doc (recid(parts)) @ FI_price-doc
     7066           with frame Dialog-Frame.
     7067       end.
     7068     end.
     7069   END PROCEDURE.
     7070   PROCEDURE enable_UI :
     7071     DISPLAY rs-parts rs-one-all R-find s-code FI_doc-line_doc-qnty
     7072             fi-label-filter-status FI_doc-line_fact-qnty FI_unit-base
     7073             fi-label-filter-object fi-free-qnty fi-free-rsrv-qnty
     7074             FI_orig-purch-code fi-income-qnty fi-income-qnty-fact fi-out-qnty
     7075             fi-out-rsrv-qnty FI_last-date FI_price-doc FI_parts_cli-qnty
     7076             FI_parts_cli-base-rate FI_parts_SLT-type FI_parts_SLT-pc
     7077             FI_country-name FI_purch-code FI_contract-prn-code
     7078         WITH FRAME Dialog-Frame.
     7079     ENABLE b-exit b-quit b-mark b-sel b-lkp b-add b-chg b-del b-vsd b-sch b-print
     7080            b-help RECT-4 RECT-7 b-doc b-b-alt b-pl rs-parts rs-one-all R-find
     7081            s-code br-parts b-income-in-code b-in b-contract FI_price-doc
     7082         WITH FRAME Dialog-Frame.
     7083     run reopen-query in this-procedure .
     7084   END PROCEDURE.
     7085   PROCEDURE get-attr-chg-qnty :
     7086     define output parameter p-chg-qnty as decimal   no-undo .
     7087     assign
     7088       p-chg-qnty = v-chg-qnty
     7089     .
     7090   END PROCEDURE.
     7091   PROCEDURE get-sort-column-phrase :
     7092     define input  parameter p-sort-column-name   as character no-undo .
     7093     define output parameter p-sort-column-phrase as character no-undo .
     7094     case p-sort-column-name :
     7095       when ""
     7096       then do:
     7097         assign
     7098           p-sort-column-phrase = ""
     7099         .
     7100       end.
     7101       when "parts-out-code"
     7102       then do:
     7103         assign
     7104           p-sort-column-phrase = "by parts.out-code"
     7105         .
     7106       end.
     7107       when "parts-object"
     7108       then do:
     7109         assign
     7110           p-sort-column-phrase = "by parts.obj-type by parts.obj-code"
     7111         .
     7112       end.
     7113       when "parts-part-code"
     7114       then do:
     7115         assign
     7116           p-sort-column-phrase = "by parts.part-code"
     7117         .
     7118       end.
     7119       otherwise do:
     7120         assign
     7121           p-sort-column-phrase = "by " + p-sort-column-name
     7122         .
     7123       end.
     7124     end case.
     7125   END PROCEDURE.
     7126   PROCEDURE init-flt :
     7127     assign
     7128       tbl = "parts"
     7129       join-tbl = ""
     7130     .
     7131     run fltfield-clear in this-procedure(
     7132     output fld, output lab, output spr, output dim)  no-error.
     7133     run fltfield-add in this-procedure('in-code', 'Номер ПН', '',
     7134     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7135     run fltfield-add in this-procedure('out-code', 'Статус', '',
     7136     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7137     run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     7138     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7139     run fltfield-add in this-procedure('supp-type*supp-code', 'Поставщик', 'cli',
     7140     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7141     run fltfield-add in this-procedure('part-code', '', '',
     7142     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7143     run fltfield-add in this-procedure('status_', 'Закр', '',
     7144     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7145     run fltfield-add in this-procedure('qnty', 'Кол.док.', '',
     7146     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7147     run fltfield-add in this-procedure('fact-qnty', 'Факт.кол.', '',
     7148     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7149     run fltfield-add in this-procedure('fact-date', 'Дата', '',
     7150     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7151     run fltfield-add in this-procedure('pay-code', 'Код Оплаты', 'pay',
     7152     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7153     run fltfield-add in this-procedure('doc-type', 'Тип Докум.', 'trn-type',
     7154     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7155     run fltfield-add in this-procedure('price-base', 'Цена (вал)', '',
     7156     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7157     run fltfield-add in this-procedure('price-rubl', 'Цена (руб)', '',
     7158     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7159     run fltfield-add in this-procedure('price-cli', 'Цена пост. (вал)', '',
     7160     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7161     run fltfield-add in this-procedure('exch-code', 'Валюта пост.', 'curr',
     7162     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7163     run fltfield-add in this-procedure('is-supp', 'Поставка', '',
     7164     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7165     run fltfield-add in this-procedure('cst-code', 'ГТД', '',
     7166     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7167     run fltfield-add in this-procedure('pl-code', 'Место', '',
     7168     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7169   END PROCEDURE.
     7170   PROCEDURE is-button-enabled :
     7171     define input parameter  p-button-name as character no-undo .
     7172     define output parameter p-enable      as logical no-undo .
     7173     do with frame Dialog-Frame:
     7174       case p-button-name :
     7175         when "b-add":U
     7176         then do:
     7177           assign
     7178             p-enable = b-add :sensitive
     7179           .
     7180         end.
     7181         when "b-del":U
     7182         then do:
     7183           assign
     7184             p-enable = b-del :sensitive
     7185           .
     7186         end.
     7187       end case .
     7188     end.
     7189   END PROCEDURE.
     7190   PROCEDURE main-block-procedure :
     7191     do
     7192     on error   undo , return error
     7193     on end-key undo , return error
     7194     :
     7195       f-date-to = today .
     7196       f-date-from = today - 92 .
     7197       define variable v-road-tax-name as character no-undo .
     7198       run tax-name in this-procedure
     7199         (input  'rdt':U
     7200         ,output v-road-tax-name
     7201         ) .
     7202       assign
     7203         parts.road-tax-base :label in browse br-parts = v-road-tax-name + " (вал)"
     7204         parts.road-tax-rubl :label in browse br-parts = v-road-tax-name + " (руб)"
     7205         parts.price-rubl :label in browse br-parts = "Цена (руб)"
     7206       .
     7207       define buffer buf_goods for ub.goods .
     7208       find buf_goods no-lock
     7209         where buf_goods.gds-code = p-gds-code
     7210         no-error .
     7211       if not available buf_goods
     7212       then do:
     7213         message
     7214           vss-workfile vss-revision vss-description skip
     7215           "Ошибка задания входных параметров" skip
     7216           "Не найден товар" skip
     7217           "Код товара" p-gds-code skip
     7218           view-as alert-box error .
     7219         undo, return error .
     7220       end.
     7221       if buf_goods.gds-type <> 'т':U
     7222       then do:
     7223         message
     7224           "Просмотр партий возможен только для товаров"
     7225           view-as alert-box information .
     7226         undo, return error .
     7227       end.
