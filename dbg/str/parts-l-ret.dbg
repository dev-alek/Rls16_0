     4060             ,input        p-doc-code
     4061             ,input        p-gds-code
     4062             ,input        v-pl-code
     4063             ,input-output v-prt-rec
     4064             ).
     4065         end.
     4066         else do:
     4067           define buffer buf_trn-doc for ub.trn-doc .
     4068           find first buf_trn-doc no-lock
     4069             where buf_trn-doc.doc-code = parts.out-code
     4070             no-error .
     4071           if available buf_trn-doc
     4072           then do:
