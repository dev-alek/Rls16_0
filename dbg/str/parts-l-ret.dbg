     6093   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6094   DEF VAR cur-clmn-numbr-parts as INT EXTENT 22 no-undo.
     6095   DEF VAR varmvibr-parts       as INT no-undo.
     6096   DEF VAR varmvjbr-parts       as INT no-undo.
     6097   DEF VAR varmvkbr-parts       as INT no-undo.
     6098   DEF VAR varmvlbr-parts       as INT no-undo.
     6099   DEF VAR move-elementbr-parts as INT no-undo.
     6100   def var jjbr-parts           as int no-undo.
     6101   do varmvibr-parts = 1 to EXTENT(cur-clmn-numbr-parts):
     6102     ASSIGN cur-clmn-numbr-parts[varmvibr-parts] = varmvibr-parts.
     6103   END.
     6104   RUN start-mv-clmnbr-parts.
     6105   PROCEDURE start-mv-clmnbr-parts:
     6106   def var old-session as logical no-undo.
     6107      old-session = SESSION:IMMEDIATE-DISPLAY.
     6108      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     6109      SESSION:IMMEDIATE-DISPLAY = old-session.
     6110   END.
     6111   ON ctrl-cursor-right OF BROWSE br-parts do:
     6112     RUN re-move-clmnbr-parts ( 4, 22).
     6113   END.
     6114   ON ctrl-cursor-left OF BROWSE br-parts do:
     6115     RUN re-move-clmnbr-parts (22, 4).
     6116   END.
     6117   PROCEDURE re-move-clmnbr-parts:
     6118     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     6119     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     6120     DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     6121       if cur-clmn-numbr-parts[varmvibr-parts] = source-column THEN cur-clmn-numbr-parts[varmvibr-parts] = -1.
     6122     END.
     6123     if br-parts:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     6124     if source-column > target-column THEN
     6125     DO varmvjbr-parts = source-column - 1 to target-column BY -1:
     6126       DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     6127           if cur-clmn-numbr-parts[varmvibr-parts] = varmvjbr-parts THEN DO:
     6128             cur-clmn-numbr-parts[varmvibr-parts] = cur-clmn-numbr-parts[varmvibr-parts] + 1.
     6129           END.
     6130       END.
     6131     END.
     6132     ELSE
     6133     DO varmvjbr-parts = source-column + 1 to target-column:
     6134       DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     6135         if cur-clmn-numbr-parts[varmvibr-parts] = varmvjbr-parts THEN DO:
     6136           cur-clmn-numbr-parts[varmvibr-parts] = cur-clmn-numbr-parts[varmvibr-parts] - 1.
     6137         END.
     6138       END.
     6139     END.
     6140     DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     6141       if cur-clmn-numbr-parts[varmvibr-parts] = -1 THEN cur-clmn-numbr-parts[varmvibr-parts] = target-column.
     6142     END.
     6143   END PROCEDURE.
     6144   PROCEDURE ch-clmnbr-parts:
     6145     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     6146     if cur-clmn-loc <= 4 then do:
     6147       return .
     6148     end.
     6149     DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     6150       if cur-clmn-numbr-parts[varmvibr-parts] = cur-clmn-loc THEN move-elementbr-parts = varmvibr-parts.
     6151     END.
     6152     RUN re-move-clmnbr-parts (cur-clmn-loc, 4).
     6153   END PROCEDURE.
     6154   PROCEDURE mv-brw-defaultbr-parts:
     6155   def var old-session as logical no-undo.
     6156     old-session = SESSION:IMMEDIATE-DISPLAY.
     6157     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     6158     do varmvlbr-parts = 4 to EXTENT(cur-clmn-numbr-parts):
     6159       RUN re-move-clmnbr-parts (cur-clmn-numbr-parts[varmvlbr-parts], varmvlbr-parts).
     6160     END.
     6161     RUN start-mv-clmnbr-parts.
     6162     SESSION:IMMEDIATE-DISPLAY = old-session.
     6163   END PROCEDURE.
     6164   .
     6165   def var sort-labelbr-parts   as character no-undo .
     6166   def var sort-clmnbr-parts    as handle    no-undo .
     6167   def var cur-clmnbr-parts     as handle    no-undo .
     6168   def var cur-clmn-locbr-parts as integer   no-undo .
     6169   def var re-querybr-parts     as logical   initial no no-undo .
     6170   on start-search, ctrl-o of br-parts in frame Dialog-Frame do:
     6171      run sort-brbr-parts
     6172        (input (if available parts
     6173                then recid(parts)
     6174                else ?
     6175               )
     6176        ).
     6177   end.
     6178   PROCEDURE sort-brbr-parts :
     6179     define input parameter p-recid as recid no-undo .
     6180     if re-querybr-parts = no then do:
     6181       assign
     6182          cur-clmnbr-parts = br-parts:current-column in frame Dialog-Frame
     6183       .
     6184       if sort-clmnbr-parts <> ? then sort-clmnbr-parts:column-fgcolor = 0.
     6185       if cur-clmnbr-parts = sort-clmnbr-parts then do:
     6186         assign
     6187            sort-labelbr-parts = ""
     6188            sort-clmnbr-parts = ?
     6189         .
     6190        end.
     6191        else do:
     6192          assign
     6193            sort-labelbr-parts = cur-clmnbr-parts:label
     6194            sort-clmnbr-parts  = cur-clmnbr-parts
     6195            sort-clmnbr-parts:column-fgcolor = 4
     6196          .
     6197        end.
     6198      end.
     6199     assign
     6200       cur-clmn-locbr-parts = 1
     6201     .
     6202     def var column-handle as handle no-undo .
     6203     column-handle = br-parts:first-column.
     6204     do while valid-handle(column-handle) :
     6205       if column-handle = cur-clmnbr-parts then do:
     6206         leave .
     6207       end.
     6208       column-handle = column-handle:NEXT-COLUMN.
     6209       assign
     6210         cur-clmn-locbr-parts = cur-clmn-locbr-parts + 1
     6211       .
     6212     end.
     6213     case sort-labelbr-parts:
     6214           when parts-out-code:label in browse br-parts then DO:    assign       sort-column-name = "parts-out-code"     .     run reopen-query.   . END.
     6215           when parts.qnty:label in browse br-parts then DO:    assign       sort-column-name = "parts.qnty"     .     run reopen-query.   . END.
     6216           when parts.fact-qnty:label in browse br-parts then DO:    assign       sort-column-name = "parts.fact-qnty"     .     run reopen-query.   . END.
     6217           when parts.price-base:label in browse br-parts then DO:    assign       sort-column-name = "parts.price-base"     .     run reopen-query.   . END.
     6218           when parts.price-rubl:label in browse br-parts then DO:    assign       sort-column-name = "parts.price-rubl"     .     run reopen-query.   . END.
     6219           when parts.transport-base:label in browse br-parts then DO:    assign       sort-column-name = "parts.transport-base"     .     run reopen-query.   . END.
     6220           when parts.transport-rubl:label in browse br-parts then DO:    assign       sort-column-name = "parts.transport-rubl"     .     run reopen-query.   . END.
     6221           when parts.road-tax-base:label in browse br-parts then DO:    assign       sort-column-name = "parts.road-tax-base"     .     run reopen-query.   . END.
     6222           when parts.road-tax-rubl:label in browse br-parts then DO:    assign       sort-column-name = "parts.road-tax-rubl"     .     run reopen-query.   . END.
     6223           when parts.other-base:label in browse br-parts then DO:    assign       sort-column-name = "parts.other-base"     .     run reopen-query.   . END.
     6224           when parts.other-rubl:label in browse br-parts then DO:    assign       sort-column-name = "parts.other-rubl"     .     run reopen-query.   . END.
     6225           when parts.cst-code:label in browse br-parts then DO:    assign       sort-column-name = "parts.cst-code"     .     run reopen-query.   . END.
     6226           when parts.pl-code:label in browse br-parts then DO:    assign       sort-column-name = "parts.pl-code"     .     run reopen-query.   . END.
     6227           when parts-object:label in browse br-parts then DO:    assign       sort-column-name = "parts-object"     .     run reopen-query.   . END.
     6228           when parts-part-code:label in browse br-parts then DO:    assign       sort-column-name = "parts-part-code"     .     run reopen-query.   . END.
     6229           when parts.in-code:label in browse br-parts then DO:    assign       sort-column-name = "parts.in-code"     .     run reopen-query.   . END.
     6230           when 'Дата ист.'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-in-code-dates&1,(recid(parts)))',chr(34))     .     run reopen-query.   . END.
     6231           when 'Договор'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-contract-prn-code&1,(recid(parts)))',chr(34))     .     run reopen-query.   . END.
     6232           when 'Тек.прод.цена'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-price-sale&1,(recid(parts)))',chr(34))     .     run reopen-query.   . END.
     6233           when 'Цена Произв.'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-price-prod1&1,(recid(parts)))',chr(34))     .     run reopen-query.   . END.
     6234           when 'Цена Прзв_с_НДС'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-price-prod2&1,(recid(parts)))',chr(34))     .     run reopen-query.   . END.
     6235       otherwise do:
     6236         assign
     6237           sort-column-name = ""
     6238         .
     6239         run reopen-query.
     6240         if sort-labelbr-parts <> "" then do:
     6241           assign
     6242             cur-clmnbr-parts:column-fgcolor = 0
     6243           .
     6244         end.
     6245         assign
     6246           cur-clmn-locbr-parts = ?
     6247         .
     6248       end.
     6249     end case.
     6250       if cur-clmn-locbr-parts <> ? then do:
     6251         if can-do( this-procedure:internal-entries, 'ch-clmnbr-parts') then do:
     6252           run ch-clmnbr-parts in this-procedure (cur-clmn-locbr-parts).
     6253         end.
     6254       end.
     6255     if p-recid <> ? then do:
     6256       reposition br-parts to recid p-recid no-error.
     6257       apply "value-changed" to br-parts in frame Dialog-Frame.
     6258     end.
     6259     apply "entry" to br-parts in frame Dialog-Frame.
     6260   END PROCEDURE.
     6261   procedure re-open-query-srt-clmnbr-parts:
     6262   if cur-clmnbr-parts = ? then do:
     6263      run reopen-query.
     6264   end.
     6265   else do:
     6266      assign re-querybr-parts = yes.
     6267      run sort-brbr-parts
     6268        (input (if available parts
     6269                then recid(parts)
     6270                else ?
     6271               )
     6272        ).
     6273      assign re-querybr-parts = no.
     6274   end.
     6275   end.
     6276   if p-edit-mode = "vsd_corr-parts"
     6277   or p-edit-mode = "vsd"
     6278   or p-edit-mode = "corr-parts"
     6279   then do :
     6280     v-ext-mode = p-edit-mode .
     6281     p-edit-mode = 'ПРОСМОТР':U .
     6282   end .
     6283   assign
     6284     v-mode-name = (if p-edit-mode = 'update-alc-attr':u
     6285                    then "Корректировка алкогольных атрибутов"
     6286                    else p-edit-mode
     6287                   )
     6288   .
     6289   if retry then do:
     6290     message
     6291       "Возникла ошибка при работе программы" skip
     6292       error-status :get-message(1) skip
     6293       return-value skip
     6294       view-as alert-box error .
     6295     undo, return error return-value .
     6296   end.
     6297   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     6298     (input  p-gds-code
     6299     ,input  'twounit=request':u
     6300     ,output v-goods-twounit
     6301     ) no-error .
     6302   if error-status :error
     6303   then do:
     6304     message
     6305       vss-workfile vss-revision vss-description skip
     6306       "Ошибка при определении атрибута товара gdscdat.i" skip
     6307       "Атрибут товара" 'twounit=request':u skip
     6308       "Код товара" p-gds-code skip
     6309       error-status :get-message(1) skip
     6310       return-value skip
     6311       view-as alert-box error .
     6312     undo, return error return-value .
     6313   end.
     6314     RUN gds-attr-value (
