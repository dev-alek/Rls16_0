     4380       then do :
     4381         if not can-find(first buf_utd no-lock where buf_utd.doc-code = parts.in-code)
     4382         then do :
     4383           message 'Для схемы возврата "Корректировка поступления" выбрать можно только партии, принятые по УПД!' view-as alert-box .
     4384           return no-apply .
