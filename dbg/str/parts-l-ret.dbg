     3379        SPACE(38.36) SKIP(7.87)
     3380       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3381            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3382            TITLE "Партии"
     3383            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
     3384   ASSIGN
     3385          FRAME Dialog-Frame:SCROLLABLE       = FALSE.
     3386   ASSIGN
     3387          b-alc-attr:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3388   ASSIGN
     3389          b-marking:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3390   ASSIGN
     3391          b-vsd:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3392   ASSIGN
     3393          br-parts:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
     3394   ON GO OF FRAME Dialog-Frame
     3395   DO:
     3396     run save-changes in this-procedure no-error .
     3397     if error-status :error
     3398     then do:
     3399       undo, return no-apply .
     3400     end.
     3401   END.
     3402   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3403   DO:
     3404     APPLY "END-ERROR":U TO SELF.
     3405   END.
     3406   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     3407   DO:
     3408   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3409   if lookup(self :type
     3410            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3411            ) = 0
     3412   then do:
     3413     message
     3414       "$Workfile$"
     3415       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3416       "Интерфейсный элемент" self :name  skip
     3417       "Тип" self :type  skip
     3418       "Процедура" this-procedure :file-name skip
     3419       view-as alert-box .
     3420   end.
     3421   else do:
     3422     apply "entry":u to self  .
     3423     if focus :handle <> self :handle  then do:
     3424       return no-apply .
     3425     end.
     3426   end.
     3427     do
     3428     on error undo, return no-apply
     3429     on stop  undo, return no-apply
     3430     :
     3431       if p-doc-code = ""
     3432       then do:
     3433         message
     3434           "Добавление партий возможно только в интерфейсе документа"
     3435           view-as alert-box .
     3436         return no-apply .
     3437       end.
     3438       if v-reserv-pl-code = ?
     3439       then do:
     3440         message
     3441           "Неизвестно место складирования товара. Добавление партий невозможно."
     3442           view-as alert-box .
     3443         return no-apply .
     3444       end.
     3445       assign
     3446         v-prt-rec = ?
     3447       .
     3448       run str/parts-f.w
     3449         (input        parparentproc
     3450         ,input        this-procedure
     3451         ,input        'ДОБАВЛЕНИЕ':U
     3452         ,input        p-doc-code
     3453         ,input        p-gds-code
     3454         ,input        v-pl-code
     3455         ,input-output v-prt-rec
     3456         ).
     3457       run reopen-query .
     3458     end.
     3459   END.
     3460   ON leave OF F-date-from IN FRAME Dialog-Frame
     3461   DO:
     3462     define variable is-changed as logical no-undo .
     3463     is-changed = no .
     3464     if string(F-date-from, "99/99/9999") <> F-date-from:screen-value then
     3465     do:
     3466         is-changed = yes .
     3467         assign F-date-from .
     3468     end.
     3469     if F-date-from > F-date-to then
     3470     do:
     3471         message "Дата начала не может быть больше конечной даты"
     3472             view-as alert-box.
     3473         return no-apply .
     3474     end.
     3475     if is-changed
     3476     then do :
     3477       run reopen-query .
     3478     end .
     3479   END.
     3480   ON leave OF F-date-to IN FRAME Dialog-Frame
     3481   DO:
     3482     define variable is-changed as logical no-undo .
     3483     is-changed = no .
     3484     if string(F-date-to, "99/99/9999") <> F-date-to:screen-value then
     3485     do:
     3486         is-changed = yes .
     3487         assign F-date-to .
     3488     end.
     3489     if F-date-from > F-date-to then
     3490     do:
     3491         message "Дата начала не может быть больше конечной даты"
     3492             view-as alert-box.
     3493         return no-apply .
     3494     end.
     3495     if is-changed
     3496     then do :
     3497       run reopen-query .
     3498     end .
     3499   END.
     3500   ON CHOOSE OF b-alc-attr IN FRAME Dialog-Frame
     3501   DO:
     3502   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3503   if lookup(self :type
     3504            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3505            ) = 0
     3506   then do:
     3507     message
     3508       "$Workfile$"
     3509       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3510       "Интерфейсный элемент" self :name  skip
     3511       "Тип" self :type  skip
     3512       "Процедура" this-procedure :file-name skip
     3513       view-as alert-box .
     3514   end.
     3515   else do:
     3516     apply "entry":u to self  .
     3517     if focus :handle <> self :handle  then do:
     3518       return no-apply .
     3519     end.
     3520   end.
     3521     define variable v-parts-ps  as character no-undo .
     3522     define variable v-gds-code  as integer   no-undo .
     3523     define variable v-save-flag as logical   no-undo .
     3524   define variable p-mode as char no-undo.
     3525   p-mode = 'ПРОСМОТР':U.
     3526   if not available parts then do:
     3527       message
     3528       "Нет партий по товару"
     3529       view-as alert-box.
     3530       return no-apply.
     3531       end.
     3532   if p-edit-mode = 'update-alc-attr' then do:
     3533       p-mode = 'ИЗМЕНЕНИЕ':U.
     3534     if v-goods-alcohol-prod <> true then do:
     3535       return no-apply.
     3536     end.
     3537     if p-doc-code = "" then do:
     3538       message
     3539         "Редактирование атрибутов партий возможно только в интерфейсе документа"
     3540         view-as alert-box .
     3541       return no-apply .
     3542     end.
     3543     if p-doc-code <> parts.out-code  then do:
     3544       message
     3545         "Редактирование атрибутов возможно только для партий, " +
     3546         "относящихся к данному документу"
     3547         view-as alert-box .
     3548       return no-apply .
     3549     end.
     3550   end.
     3551   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3552   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     3553     (input  parts.artic
     3554     ,input  parts.prod-type
     3555     ,input  parts.prod-code
     3556     ,output v-gds-code
     3557     ) no-error .
     3558     do
     3559     on error undo, return no-apply
     3560     :
     3561       define variable v-alc-mark-db-num          as integer   no-undo .
     3562       define variable v-alc-mark-code            as integer   no-undo .
     3563       define variable v-alc-bottling-date        as date      no-undo .
     3564       define variable v-alc-ref-ab-path          as character no-undo .
     3565       define variable v-alc-quality-certif-path  as character no-undo .
     3566       define variable v-alc-certif-path          as character no-undo .
     3567       define variable v-alc-imp-type             as character no-undo .
     3568       define variable v-alc-imp-code             as integer   no-undo .
     3569       define variable v-mode-alc                 as character no-undo .
     3570       assign
     3571         v-alc-mark-db-num         = parts.mark-db-num
     3572         v-alc-mark-code           = parts.mark-code
     3573         v-alc-bottling-date       = parts.alc-bottling-date
     3574         v-alc-ref-ab-path         = parts.alc-ref-ab-path
     3575         v-alc-quality-certif-path = parts.alc-quality-certif-path
     3576         v-alc-certif-path         = parts.alc-certif-path
     3577         v-alc-imp-type            = parts.alc-imp-type
     3578         v-alc-imp-code            = parts.alc-imp-code
     3579       .
     3580       if p-mode = 'ПРОСМОТР':U and ub.parts.out-code = 'free-zone':U
     3581       then do:
     3582         v-mode-alc = 'ИЗМЕНЕНИЕ':U.
     3583       end.
     3584       else do:
     3585         v-mode-alc = p-mode.
     3586       end.
     3587       run str/in-alc.w
     3588         (input        parparentproc
     3589         ,input       p-mode
     3590         ,input p-gds-code
     3591         ,input p-doc-code
     3592         ,buffer ub.parts
     3593         ,input-output v-alc-mark-db-num
     3594         ,input-output v-alc-mark-code
     3595         ,input-output v-alc-bottling-date
     3596         ,input-output v-alc-ref-ab-path
     3597         ,input-output v-alc-quality-certif-path
     3598         ,input-output v-alc-certif-path
     3599         ,input-output v-alc-imp-type
     3600         ,input-output v-alc-imp-code
     3601         ,output       v-save-flag
     3602         ) no-error
     3603         .
     3604       if error-status :error
     3605       then do:
     3606         if error-status :get-message(1) <> '':u
     3607         then do:
     3608           message
     3609             vss-workfile vss-revision vss-description skip
     3610             "Ошибка при вызове процедуры in-alc.w" skip
     3611             error-status :get-message(1) skip
     3612             return-value skip
     3613             view-as alert-box error .
     3614         end.
     3615         undo, return no-apply .
     3616       end.
     3617       if v-save-flag then do:
     3618         run waitfram-show ("Сохранение новых значений и отправка их по новостям ...").
     3619         run trg/partps.p ( input v-gds-code
     3620                          , input parts.in-code
     3621                          , input if ub.parts.doc-type = 'рас':U or ub.parts.out-code = 'free-zone':U then ub.parts.out-code else ?
     3622                          , input parts.part-code
     3623                          , input v-alc-mark-db-num
     3624                          , input v-alc-mark-code
     3625                          , input v-alc-bottling-date
     3626                          , input v-alc-ref-ab-path
     3627                          , input v-alc-quality-certif-path
     3628                          , input v-alc-certif-path
     3629                          , input v-alc-imp-type
     3630                          , input v-alc-imp-code
     3631                          ) no-error .
     3632         if error-status :error
     3633         then do:
     3634           message
     3635             vss-workfile vss-revision vss-description skip
     3636             "Ошибка при вызове процедуры partps.p" skip
     3637             error-status :get-message(1) skip
     3638             return-value skip
     3639             view-as alert-box error .
     3640           run waitfram-hide.
     3641           undo, return no-apply .
     3642         end.
     3643         run waitfram-hide.
     3644         find current parts no-lock.
     3645         br-parts:refresh() in frame Dialog-Frame.
     3646         run display-parts-info in this-procedure .
     3647         apply "entry":u to br-parts.
     3648       end.
     3649     end.
     3650   END.
     3651   ON CHOOSE OF b-b-alt IN FRAME Dialog-Frame
     3652   DO:
     3653   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3654   if lookup(self :type
     3655            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3656            ) = 0
     3657   then do:
     3658     message
     3659       "$Workfile$"
     3660       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3661       "Интерфейсный элемент" self :name  skip
     3662       "Тип" self :type  skip
     3663       "Процедура" this-procedure :file-name skip
     3664       view-as alert-box .
     3665   end.
     3666   else do:
     3667     apply "entry":u to self  .
     3668     if focus :handle <> self :handle  then do:
     3669       return no-apply .
