     2795   FUNCTION get-in-code-date RETURNS CHARACTER
     2796     ( input p-recid as recid ) :
     2797   define buffer buf_parts for ub.parts  .
     2798   define buffer buf_parts-attr for ub.parts-attr  .
     2799   define buffer buf_goods      for ub.goods       .
     2800   find first  buf_parts no-lock where recid(buf_parts) = p-recid no-error .
     2801   find first buf_goods no-lock where
     2802               buf_goods.artic =  buf_parts.artic and
     2803               buf_goods.prod-code =  buf_parts.prod-code and
     2804               buf_goods.prod-type =  buf_parts.prod-type no-error .
     2805   find first buf_parts-attr no-lock
     2806        where buf_parts-attr.part-code = buf_parts.part-code and
     2807              buf_parts-attr.in-code   = buf_parts.in-code   and
     2808              buf_parts-attr.gds-code  = buf_goods.gds-code  no-error .
     2809              if available buf_parts-attr then return string ( buf_parts-attr.fact-date, "99/99/9999" ) .
     2810              else return "" .
     2811   END FUNCTION.
     2812   FUNCTION get-price-prod1 RETURNS DECIMAL
     2813     ( input p-recid as recid ) :
     2814   define buffer buf_parts for ub.parts  .
     2815   define variable       p-price as decimal   no-undo .
     2816   define variable       p-priceWithVat as decimal   no-undo .
     2817   define variable       p-vat-pc as decimal   no-undo .
     2818   find first  buf_parts no-lock where recid(buf_parts) = p-recid no-error .
     2819   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2820   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partppric in g#library
     2821   (  buffer buf_parts
     2822    , output p-price
     2823    , output p-priceWithVat
     2824    , output p-vat-pc
     2825           ) no-error .
     2826   return p-price .
     2827   END FUNCTION.
