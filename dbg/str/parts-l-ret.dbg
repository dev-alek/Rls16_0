      573   procedure trndocrs-pl-gds-clear :
      574     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      575     do
      576     on error undo, return error return-value
      577     :
      578       for each buf_temp-trndocrs-pl-gds-rsrv
      579       on error undo, return error return-value
      580       :
      581         delete buf_temp-trndocrs-pl-gds-rsrv .
      582       end.
      583     end.
      584   end procedure.
      585   procedure trndocrs-clear :
      586     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      587     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      588     do
      589     on error undo, return error return-value
      590     :
      591       for each buf_temp-trndocrs-gds-dtl-rsrv
      592       on error undo, return error return-value
