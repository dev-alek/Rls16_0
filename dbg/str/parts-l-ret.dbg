     9752         find first buf_clients no-lock where buf_clients.obj-type = buf_trn-doc.cli-type
     9753                                          and buf_clients.obj-code = buf_trn-doc.cli-code
     9754                                          .
     9755         assign
     9756           frame Dialog-Frame:title
     9757             = "Артикул : " + buf_goods.artic + "   " + buf_goods.gds-name
     9758             + "  и  Поставщик : " + buf_clients.obj-name + "   -  " + v-mode-name
     9759         .
     9760   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9761   define variable  l-disable-where-80  as logical   no-undo .
     9762   define variable  l-filter-open-80    as logical   .
