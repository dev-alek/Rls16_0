     4398   ON CHOOSE OF b-vsd IN FRAME Dialog-Frame
     4399   DO:
     4400   define variable vss-include-info41 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4401   if lookup(self :type
     4402            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4403            ) = 0
     4404   then do:
     4405     message
     4406       "$Workfile$"
     4407       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4408       "Интерфейсный элемент" self :name  skip
     4409       "Тип" self :type  skip
     4410       "Процедура" this-procedure :file-name skip
     4411       view-as alert-box .
     4412   end.
     4413   else do:
     4414     apply "entry":u to self  .
     4415     if focus :handle <> self :handle  then do:
     4416       return no-apply .
     4417     end.
     4418   end.
     4419       define variable ii as integer no-undo.
     4420       define variable isSave as logical no-undo.
     4421       define variable keyrecObj as class keyrec no-undo.
     4422       define variable keypart as character no-undo.
     4423       if not available parts then
     4424       do:
     4425         message
     4426           "Нет партий по товару"
     4427           view-as alert-box.
     4428         return no-apply.
     4429       end.
     4430       vsdStorageObj = new vsdtostorage ().
     4431       vsdSts = new vsdstatustype ().
     4432       keyrecObj = new keyrec ().
     4433       keyrecObj:GenKeyRec('parts':U, buffer parts:handle, output keypart).
     4434       vsdsubsObj = vsdStorageObj:getVSDsubs(input "part-key", input keypart).
     4435       if vsdsubsObj:iCounter = 0
     4436       then do:
     4437         if p-edit-mode = 'ПРОСМОТР':U
     4438         and not (v-vozvr-perem-no-fact and p-doc-code = ub.parts.out-code)
     4439         and not (v-ext-mode = "vsd_corr-parts" or v-ext-mode = "vsd")
     4440         then do:
     4441           message "К партии отсутсвуют ВСД" view-as alert-box.
     4442           return.
     4443         end.
     4444         vsdsubObj = new vsdsub ().
     4445         vsdsubsObj:AddItem(vsdsubObj).
     4446         vsdsubObj = vsdsubsObj:VsdObjCurr.
     4447         vsdsubObj:VSDType = vsdSts:VSDIn.
     4448         vsdsubObj:PartKey = keypart.
     4449         vsdsubObj:GdsCode = p-gds-code.
     4450         vsdsubObj:ObjType = v-obj-type.
     4451         vsdsubObj:ObjCode = v-obj-code.
     4452         find first buf_trn no-lock where buf_trn.doc-code = p-doc-code.
     4453         if available (buf_trn)
     4454         then do:
     4455           vsdsubObj:CliCode = buf_trn.cli-code.
     4456           vsdsubObj:CliType = buf_trn.cli-type.
     4457         end.
     4458       end.
     4459       run str/vsd.w (input parparentproc, input 'ИЗМЕНЕНИЕ':U, input vsdsubsObj, output isSave).
     4460       if isSave then do:
     4461         do ii = 1 to vsdsubsObj:GetItem(ii):
     4462           vsdsubObj = vsdsubsObj:VsdObjCurr.
     4463           if vsdsubObj:Changed
     4464           then do:
     4465             case true:
     4466               when vsdsubObj:ID > 0 then do:
     4467                 vsdStorageObj:updateDB(vsdsubObj).
     4468               end.
     4469               otherwise do:
     4470                 vsdStorageObj:insertDB(vsdsubObj).
     4471               end.
     4472             end.
     4473           end.
     4474         end.
     4475       end.
     4476       delete object keyrecObj no-error.
     4477       delete object vsdsubsObj no-error.
     4478       find current parts no-lock.
     4479       br-parts:refresh() in frame Dialog-Frame.
     4480       run display-parts-info in this-procedure .
     4481       apply "entry":u to br-parts.
     4482   END.
     4483   ON MOUSE-SELECT-DBLCLICK OF br-parts IN FRAME Dialog-Frame
     4484   DO:
     4485     if b-chg:sensitive then apply "choose" to b-chg in frame Dialog-Frame.
     4486   END.
     4487   ON RETURN OF br-parts IN FRAME Dialog-Frame
     4488   DO:
     4489     if b-chg:sensitive then apply "choose" to b-chg in frame Dialog-Frame.
     4490   END.
     4491   ON ROW-DISPLAY OF br-parts IN FRAME Dialog-Frame
     4492   DO:
     4493     define buffer buf_utd for ub.utd .
     4494     define buffer buf_trn-doc for ub.trn-doc .
     4495     define variable ic      as integer   no-undo.
     4496     if parts.defect = logical('yes':U) then do:
     4497        parts-part-code:bgcolor in browse br-parts = 12.
     4498     end.
     4499     else do:
     4500        parts-part-code:bgcolor in browse br-parts = ? .
     4501     end.
     4502     find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code no-error .
     4503     if available buf_trn-doc
     4504     and buf_trn-doc.reason-code = 25
     4505     then do :
     4506       if not can-find(first buf_utd no-lock where buf_utd.doc-code = parts.in-code)
     4507       then do :
     4508         do ic = 1 to extent (bcol) :
     4509           if valid-handle (bcol[ic])
     4510           then
     4511             bcol[ic]:bgcolor = 7
     4512           .
     4513         end.
     4514       end .
     4515     end .
     4516   END.
     4517   ON VALUE-CHANGED OF br-parts IN FRAME Dialog-Frame
     4518   DO:
     4519     run display-parts-info .
     4520   END.
     4521   ON ENTRY OF ed-notes IN FRAME Dialog-Frame
     4522   DO:
     4523     if not available parts
     4524     then do:
     4525       message
     4526         "Неправильный выбор партии."
     4527         view-as alert-box .
     4528       return no-apply.
     4529     end.
     4530     assign
     4531       v-prt-rec = recid (parts)
     4532     .
     4533   END.
     4534   ON LEAVE OF ed-notes IN FRAME Dialog-Frame
     4535   DO:
     4536     define buffer buf_parts for ub.parts .
     4537     do on stop undo, return no-apply:
     4538       find buf_parts where recid (buf_parts) = v-prt-rec exclusive-lock.
     4539       buf_parts.PS = input frame Dialog-Frame ed-notes.
     4540     end.
     4541   END.
     4542   ON MOUSE-SELECT-DBLCLICK OF ed-notes IN FRAME Dialog-Frame
     4543   DO:
     4544     apply "entry":u to br-parts in frame Dialog-Frame.
     4545     return no-apply.
     4546   END.
     4547   ON RETURN OF ed-notes IN FRAME Dialog-Frame
     4548   DO:
     4549     apply "entry":u to br-parts in frame Dialog-Frame.
     4550     return no-apply.
     4551   END.
     4552   ON VALUE-CHANGED OF R-find IN FRAME Dialog-Frame
     4553   DO:
     4554     ASSIGN r-find .
     4555   END.
     4556   ON VALUE-CHANGED OF rs-one-all IN FRAME Dialog-Frame
     4557   DO:
     4558     if available parts
     4559     then do:
     4560       assign
     4561         v-prt-rec = recid(parts)
     4562       .
     4563     end.
     4564     assign rs-one-all .
     4565     run reopen-query .
     4566   END.
     4567   ON VALUE-CHANGED OF rs-parts IN FRAME Dialog-Frame
     4568   DO:
     4569     if available parts
     4570     then do:
     4571       assign
     4572         v-prt-rec = recid(parts)
     4573       .
     4574     end.
     4575     if input frame Dialog-Frame rs-parts = 'документ':U
     4576     and p-call-point = 'справочник':U
     4577     then do:
     4578       message
     4579         "Нет документа"
     4580         view-as alert-box .
     4581       display
     4582         rs-parts
     4583         with frame Dialog-Frame.
     4584       return no-apply.
     4585     end.
     4586     assign
     4587       rs-parts
     4588     .
     4589     run reopen-query .
     4590   END.
     4591   ON RETURN OF s-code IN FRAME Dialog-Frame
     4592   DO:
     4593     define variable v-find-next as logical   no-undo .
     4594     if s-code <> input frame Dialog-Frame s-code
     4595     then do:
     4596       assign
     4597         v-find-next = false
     4598       .
     4599     end.
     4600     else do:
     4601       assign
     4602         v-find-next = true
     4603       .
     4604     end.
     4605     do with frame Dialog-Frame:
     4606       assign
     4607         s-code
     4608       .
     4609     end.
     4610     define buffer buf_bar-code for ub.bar-code .
     4611     define buffer buf_goods    for ub.goods    .
     4612     define buffer buf_parts    for ub.parts    .
     4613     if  r-find = 2 then do:
     4614         find first buf_bar-code no-lock
     4615           where buf_bar-code.b-code = int( s-code)
     4616           no-error .
     4617         if available buf_bar-code
     4618         then do:
     4619           find first buf_goods no-lock
     4620             where buf_goods.gds-code = buf_bar-code.gds-code
     4621             .
     4622           if buf_bar-code.gds-code <> p-gds-code
     4623           then do:
     4624             message
     4625               "Бар-код" buf_bar-code.b-code skip
     4626               "Вы задали бар-код партии для другого товара" skip
     4627               "Вы просматриваете партии товара с кодом" p-gds-code skip
     4628               "Вы задали бар-код товара с кодом" buf_bar-code.gds-code skip
     4629               "и артикулом" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     4630               view-as alert-box .
     4631             return no-apply .
     4632           end.
     4633           run UI-on in this-procedure
     4634             (input false
     4635             ,input v-find-next
     4636             ,input substitute("and parts.in-code = '&1' and parts.part-code = '&2'"
     4637             , buf_bar-code.in-code
     4638             , buf_bar-code.part-code)
     4639             ).
     4640           apply "entry":u to self .
     4641           return no-apply .
     4642         end.
     4643         message
     4644           "Бар-код не найден !"
     4645           view-as alert-box .
     4646      end.
     4647      else do:
     4648              run UI-on in this-procedure
     4649             (input false
     4650             ,input v-find-next
     4651             ,input substitute("and parts.part-code = '&1'"
     4652             , s-code )
     4653             ).
     4654           apply "entry":u to self .
     4655      end.
     4656      return no-apply .
     4657   END.
     4658   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     4659   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     4660   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4661   on help of frame Dialog-Frame
     4662   do:
     4663     run gbl/app_help.p
     4664       (input this-procedure :file-name
     4665       ,input ''
     4666       ,input ?
     4667       ) no-error.
     4668     if error-status :error then do:
     4669       message
     4670         "Ошибка при вызове помощи"
     4671         error-status :get-message(1)
     4672         view-as alert-box .
     4673     end.
     4674   end.
     4675   run minbtn-set in this-procedure .
     4676   on choose of b-help in frame Dialog-Frame
     4677   do:
     4678     apply "help":u to frame Dialog-Frame .
     4679   end.
     4680   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4681   procedure minbtn-set :
     4682       do
     4683           on error undo, return error return-value
     4684           :
     4685           define variable ii              as integer       no-undo .
     4686           define variable fh              as widget-handle no-undo .
     4687           define variable hh              as widget-handle no-undo .
     4688           define variable v-h             as handle        extent 4 no-undo .
     4689           define variable v-name-button   as character     no-undo .
     4690           define variable v-help-old-x    as decimal       no-undo .
     4691           define variable v-help-old-y    as decimal       no-undo .
     4692           define variable v-help-old-size as decimal       no-undo .
     4693           define variable v-frame-width   as decimal       no-undo .
     4694           define variable jj              as integer       no-undo .
     4695           do
     4696               on error undo, return error
     4697               :
     4698               assign
     4699                   v-frame-width = frame Dialog-Frame:width - 0.3
     4700                   fh            = frame Dialog-Frame:first-child
     4701                   hh            = fh:first-child
     4702                   ii            = 1
     4703                   .
     4704               do while valid-handle(hh):
     4705                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4706                   do:
     4707                       case lc(hh:name) :
     4708                           when "b-help" then
     4709                               do:
     4710                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4711                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4712                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4713                                   hh:TOOLTIP = "Помощь" .
     4714                                   v-help-old-x = hh:column .
     4715                                   v-help-old-y = hh:row    .
     4716                                   v-help-old-size = hh:width .
     4717                                   hh:width-chars = 2.5 .
     4718                               end.
     4719                           when "b-print" then
     4720                               do:
     4721                                   hh:load-image("cmp/b-print.bmp":u) .
     4722                                   hh:TOOLTIP = "Печать" .
     4723                                   v-h[ii] = hh:handle .
     4724                                   ii = ii + 1 .
     4725                                   hh:width-chars = 3 .
     4726                               end.
     4727                           when "b-history" or
     4728                           when "b-hist" then
     4729                               do:
     4730                                   hh:load-image("cmp/b-hist.bmp":u) .
     4731                                   hh:TOOLTIP = "История" .
     4732                                   v-h[ii] = hh:handle .
     4733                                   ii = ii + 1 .
     4734                                   hh:width-chars = 3 .
     4735                               end.
     4736                           when "b-sch" then
     4737                               do:
     4738                                   hh:load-image("cmp/b-sch.bmp":u) .
     4739                                   hh:TOOLTIP = "Установка Фильтра" .
     4740                                   v-h[ii] = hh:handle .
     4741                                   ii = ii + 1 .
     4742                                   hh:width-chars = 3 .
     4743                               end.
     4744                           when "b-hist-user" then
     4745                               do:
     4746                                   hh:load-image("cmp/b-hist.bmp":u) .
     4747                                   hh:TOOLTIP = "История пользователя" .
     4748                                   ii = ii + 1 .
     4749                               end.
     4750                       end case.
     4751                   end.
     4752                   hh = hh:next-sibling.
     4753               end.
     4754               b-help:column = v-frame-width - b-help:width-chars.
     4755               jj = 0.
     4756               repeat ii = 4 to 1 by -1 :
     4757                   if valid-handle (v-h[ii] ) then
     4758                   do:
     4759                       jj  = jj + 1 .
     4760                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4761                       v-h[ii]:row    = v-help-old-y .
     4762                   end.
     4763               end.
     4764           end.
     4765       end.
     4766   end procedure.
     4767   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4768   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4769   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4770   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4771   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4772   define variable v-diasize-current-frame-height as decimal   no-undo .
     4773   define variable v-diasize-change-size          as logical   no-undo .
     4774   define variable v-diasize-resize-button        as handle    no-undo .
     4775   define variable v-diasize-wndmax               as logical   no-undo .
     4776   define variable v-diasize-wndstore             as logical   no-undo .
     4777   define variable v-diasize-proc-name            as character no-undo .
     4778   define variable v-diasize-browse-handle        as handle    no-undo .
     4779   define variable v-diasize-browse-number        as integer   no-undo .
     4780   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4781   define temp-table temp-diasize-handle no-undo
     4782     field handle-value  as handle
     4783     field save-position as decimal
     4784     index xpk is primary unique handle-value
     4785     .
     4786   define temp-table temp-browse-handle no-undo
     4787     field browse-type   as character
     4788     field browse-number as integer
     4789     field browse-handle as handle
     4790     field original-size as decimal
     4791     index xpk is primary unique browse-type browse-number
     4792     index xie browse-type browse-handle
     4793   .
     4794   procedure diasize_change-height :
     4795     define input  parameter p-change-value  as decimal   no-undo .
     4796     define input  parameter p-move-resize   as logical   no-undo .
     4797     define variable v-field-group-handle    as handle    no-undo .
     4798     define variable v-object-handle         as handle    no-undo .
     4799     define variable v-frame-height          as decimal   no-undo .
     4800     define variable v-frame-virtual-height  as decimal   no-undo .
     4801     define variable v-browse-height         as decimal   no-undo .
     4802     define variable v-window-height         as decimal   no-undo .
     4803     define variable v-window-virtual-height as decimal   no-undo .
     4804     define variable v-change-sign           as integer   no-undo .
     4805     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4806     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4807     if p-change-value > 0
     4808     then do:
     4809       if frame Dialog-Frame :height + p-change-value
     4810           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4811       then do:
     4812         assign
     4813           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4814                           - (frame Dialog-Frame :height-chars)
     4815         .
     4816         if p-change-value <= 0
     4817         then do:
     4818           run diasize_position-resize-button in this-procedure .
     4819           return .
     4820         end.
     4821       end.
     4822     end.
     4823     if p-change-value < 0
     4824     then do:
     4825       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4826       then do:
     4827         assign
     4828           p-change-value = v-diasize-orig-frame-height
     4829                          - (frame Dialog-Frame :height-chars)
     4830         .
     4831         if p-change-value >= 0
     4832         then do:
     4833           run diasize_position-resize-button in this-procedure .
     4834           return .
     4835         end.
     4836       end.
     4837     end.
     4838     if p-change-value >= 0
     4839     then do:
     4840       assign
     4841         v-change-sign = 1
     4842       .
     4843     end.
     4844     else do:
     4845       assign
     4846         v-change-sign = -1
     4847       .
     4848     end.
     4849     assign
     4850       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4851     .
     4852     if p-change-value = 0
     4853     then do:
     4854       run diasize_position-resize-button in this-procedure .
     4855       return .
     4856     end.
     4857     move_block:
     4858     do
     4859     on error undo move_block, retry move_block
     4860     :
     4861       if retry
     4862       then do:
     4863         do
     4864         on error undo move_block, leave move_block
     4865         :
     4866           if p-change-value > 0
     4867           then do:
     4868             for each buf_temp-diasize-handle
     4869             on error undo, next
     4870             :
     4871               assign
     4872                 v-object-handle = buf_temp-diasize-handle.handle-value
     4873               .
     4874               if v-object-handle <> v-diasize-resize-button
     4875               then do:
     4876                 assign
     4877                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4878                 .
     4879               end.
     4880             end.
     4881             assign
     4882               v-diasize-browse-handle :height = v-browse-height
     4883             .
     4884             for each buf_temp-browse-handle
     4885               where buf_temp-browse-handle.browse-type = 'height':u
     4886             on error undo, next
     4887             :
     4888               assign
     4889                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4890               .
     4891             end.
     4892             assign
     4893               frame Dialog-Frame :height = v-frame-height
     4894             .
     4895             if frame Dialog-Frame :scrollable = true
     4896             then do:
     4897               assign
     4898                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4899               .
     4900             end.
     4901             run diasize_position-resize-button in this-procedure .
     4902           end.
     4903           else do:
     4904             if frame Dialog-Frame :scrollable = true
     4905             then do:
     4906               assign
     4907                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4908               .
     4909             end.
     4910             assign
     4911               frame Dialog-Frame :height = v-frame-height
     4912             .
     4913             assign
     4914               v-diasize-browse-handle :height = v-browse-height
     4915             .
     4916             for each buf_temp-browse-handle
     4917               where buf_temp-browse-handle.browse-type = 'height':u
     4918             on error undo, next
     4919             :
     4920               assign
     4921                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4922               .
     4923             end.
     4924             for each buf_temp-diasize-handle
     4925             on error undo, next
     4926             :
     4927               assign
     4928                 v-object-handle = buf_temp-diasize-handle.handle-value
     4929               .
     4930               if v-object-handle <> v-diasize-resize-button
     4931               then do:
     4932                 assign
     4933                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4934                 .
     4935               end.
     4936             end.
     4937             run diasize_position-resize-button in this-procedure .
     4938           end.
     4939           assign
     4940             v-diasize-change-size = false
     4941           .
     4942           leave move_block .
     4943         end.
     4944       end.
     4945       assign
     4946         v-diasize-need-full-display = true
     4947       .
     4948       if v-diasize-change-size = false
     4949       then do:
     4950         assign
     4951           v-diasize-change-size = true
     4952         .
     4953       end.
     4954       else do:
     4955         return .
     4956       end.
     4957       assign
     4958         v-frame-height = frame Dialog-Frame :height
     4959         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     4960         v-browse-height = v-diasize-browse-handle :height
     4961       .
     4962       for each buf_temp-browse-handle
     4963         where buf_temp-browse-handle.browse-type = 'height':u
     4964       :
     4965         assign
     4966           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     4967         .
     4968       end.
     4969       for each buf_temp-diasize-handle
     4970       :
     4971         delete buf_temp-diasize-handle .
     4972       end.
     4973       assign
     4974         v-field-group-handle = frame Dialog-Frame :first-child
     4975       .
     4976       do while valid-handle(v-field-group-handle)
     4977       :
     4978         assign
     4979           v-object-handle = v-field-group-handle :first-child
     4980         .
     4981         do while valid-handle(v-object-handle)
     4982         :
     4983           if  v-object-handle <> v-diasize-browse-handle :handle
     4984           and can-query(v-object-handle, "row")
     4985           and can-query(v-object-handle, "height")
     4986           and ( v-object-handle :row > v-diasize-browse-handle :row )
     4987           then do:
     4988             find first buf_temp-browse-handle
     4989               where buf_temp-browse-handle.browse-type   = 'height':u
     4990                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4991               no-error .
     4992             if available buf_temp-browse-handle
     4993             then do:
     4994             end.
     4995             else do:
     4996               create buf_temp-diasize-handle .
     4997               assign
     4998                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4999                 buf_temp-diasize-handle.save-position = v-object-handle :row
     5000               .
     5001             end.
     5002           end.
     5003           assign
     5004             v-object-handle = v-object-handle :next-sibling
     5005           .
     5006         end.
     5007         assign
     5008           v-field-group-handle = v-field-group-handle :next-sibling
     5009         .
     5010       end.
     5011       do with frame Dialog-Frame
     5012       :
     5013         hide v-diasize-resize-button .
     5014         assign
     5015           v-diasize-resize-button :row    = 1
     5016           v-diasize-resize-button :column = 1
     5017         .
     5018       end.
     5019       if p-change-value > 0
     5020       then do:
     5021         if frame Dialog-Frame :scrollable = true
     5022         then do:
     5023           assign
     5024             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     5025             no-error .
     5026           if error-status :error
     5027           or error-status :get-message(1) <> ""
     5028           then do:
     5029             undo move_block, retry move_block .
     5030           end.
     5031         end.
     5032         assign
     5033           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     5034           no-error .
     5035         if error-status :error
     5036         or error-status :get-message(1) <> ""
     5037         then do:
     5038           undo move_block, retry move_block .
     5039         end.
     5040         assign
     5041           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     5042           no-error .
     5043         if error-status :error
     5044         or error-status :get-message(1) <> ""
     5045         then do:
     5046           undo move_block, retry move_block .
     5047         end.
     5048         for each buf_temp-browse-handle
     5049           where buf_temp-browse-handle.browse-type = 'height':u
     5050         on error undo move_block, retry move_block
     5051         :
     5052           assign
     5053             buf_temp-browse-handle.browse-handle :height
     5054               = buf_temp-browse-handle.browse-handle :height + p-change-value
     5055             no-error .
     5056           if error-status :error
     5057           or error-status :get-message(1) <> ""
     5058           then do:
     5059             undo move_block, retry move_block .
     5060           end.
     5061         end.
     5062         for each buf_temp-diasize-handle
     5063         on error undo move_block, retry move_block
     5064         :
     5065           assign
     5066             v-object-handle = buf_temp-diasize-handle.handle-value
     5067           .
     5068           if v-object-handle <> v-diasize-resize-button
     5069           then do:
     5070             assign
     5071               v-object-handle :row = v-object-handle :row + p-change-value
     5072               no-error .
     5073             if error-status :error
     5074             or error-status :get-message(1) <> ""
     5075             then do:
     5076               undo move_block, retry move_block .
     5077             end.
     5078           end.
     5079         end.
     5080       end.
     5081       else do:
     5082         for each buf_temp-diasize-handle
     5083         on error undo move_block, retry move_block
     5084         :
     5085           assign
     5086             v-object-handle = buf_temp-diasize-handle.handle-value
     5087           .
     5088           if v-object-handle <> v-diasize-resize-button
     5089           then do:
     5090             assign
     5091               v-object-handle :row = v-object-handle :row + p-change-value
     5092               no-error .
     5093             if error-status :error
     5094             or error-status :get-message(1) <> ""
     5095             then do:
     5096               undo move_block, retry move_block .
     5097             end.
     5098           end.
     5099         end.
     5100         assign
     5101           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     5102           no-error .
     5103         if error-status :error
     5104         or error-status :get-message(1) <> ""
     5105         then do:
     5106           undo move_block, retry move_block .
     5107         end.
     5108         for each buf_temp-browse-handle
     5109           where buf_temp-browse-handle.browse-type = 'height':u
     5110         on error undo move_block, retry move_block
     5111         :
     5112           assign
     5113             buf_temp-browse-handle.browse-handle :height
     5114               = buf_temp-browse-handle.browse-handle :height + p-change-value
     5115             no-error .
     5116           if error-status :error
     5117           or error-status :get-message(1) <> ""
     5118           then do:
     5119             undo move_block, retry move_block .
     5120           end.
     5121         end.
     5122         assign
     5123           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     5124           no-error .
     5125         if error-status :error
     5126         or error-status :get-message(1) <> ""
     5127         then do:
     5128           undo move_block, retry move_block .
     5129         end.
     5130         if frame Dialog-Frame :scrollable = true
     5131         then do:
     5132           assign
     5133             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     5134             no-error .
     5135           if error-status :error
     5136           or error-status :get-message(1) <> ""
     5137           then do:
     5138             undo move_block, retry move_block .
     5139           end.
     5140         end.
     5141       end.
     5142       if p-move-resize = true
     5143       then do:
     5144         run diasize_position-resize-button in this-procedure .
     5145       end.
     5146       if v-diasize-wndstore = true
     5147       then do:
     5148         if connected("ub") = true
     5149         then do:
     5150           define variable v-cntxt-db-num        as integer   no-undo .
     5151           define variable v-cntxt-userid        as character no-undo .
     5152           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5153                                             , OUTPUT v-cntxt-userid
     5154                                             ) .
     5155           run gbl/wndsizew.p
     5156             (input  v-cntxt-db-num
     5157             ,input  v-cntxt-userid
     5158             ,input  v-diasize-proc-name
     5159             ,input  'height':u
     5160             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     5161             ) .
     5162         end.
     5163       end.
     5164     end.
     5165     assign
     5166       v-diasize-change-size = false
     5167     .
     5168   end procedure.
     5169   procedure diasize_set-height :
     5170     define input  parameter p-new-height  as decimal   no-undo .
     5171     define input  parameter p-move-resize as logical   no-undo .
     5172     do
     5173     on error undo, return error return-value
     5174     :
     5175       run diasize_change-height in this-procedure
     5176         (input  (p-new-height - frame Dialog-Frame :height)
     5177         ,input  p-move-resize
     5178         ) .
     5179     end.
     5180   end procedure.
     5181   procedure diasize_change-width :
     5182     define input  parameter p-change-value as decimal   no-undo .
     5183     define input  parameter p-move-resize  as logical   no-undo .
     5184     define variable v-field-group-handle   as handle    no-undo .
     5185     define variable v-object-handle        as handle    no-undo .
     5186     define variable v-frame-width          as decimal   no-undo .
     5187     define variable v-frame-virtual-width  as decimal   no-undo .
     5188     define variable v-browse-width         as decimal   no-undo .
     5189     define variable v-window-width         as decimal   no-undo .
     5190     define variable v-window-virtual-width as decimal   no-undo .
     5191     define variable v-change-sign          as integer   no-undo .
     5192     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5193     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5194     if p-change-value > 0
     5195     then do:
     5196       if frame Dialog-Frame :width + p-change-value >
     5197           session :width-chars
     5198       then do:
     5199         assign
     5200           p-change-value = session :width-chars - frame Dialog-Frame :width
     5201         .
     5202         if p-change-value <= 0
     5203         then do:
     5204           run diasize_position-resize-button in this-procedure .
     5205           return .
     5206         end.
     5207       end.
     5208     end.
     5209     if p-change-value < 0
     5210     then do:
     5211       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     5212       then do:
     5213         assign
     5214           p-change-value = v-diasize-orig-frame-width
     5215                          - frame Dialog-Frame :width
     5216         .
     5217         if p-change-value >= 0
     5218         then do:
     5219           run diasize_position-resize-button in this-procedure .
     5220           return .
     5221         end.
     5222       end.
     5223     end.
     5224     if p-change-value >= 0
     5225     then do:
     5226       assign
     5227         v-change-sign = 1
     5228       .
     5229     end.
     5230     else do:
     5231       assign
     5232         v-change-sign = -1
     5233       .
     5234     end.
     5235     assign
     5236       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5237     .
     5238     if p-change-value = 0
     5239     then do:
     5240       run diasize_position-resize-button in this-procedure .
     5241       return .
     5242     end.
     5243     move_block:
     5244     do
     5245     on error undo move_block, leave move_block
     5246     :
     5247       if retry
     5248       then do:
     5249         do
     5250         on error undo move_block, leave move_block
     5251         :
     5252           if p-change-value > 0
     5253           then do:
     5254             for each buf_temp-diasize-handle
     5255             on error undo, next
     5256             :
     5257               assign
     5258                 v-object-handle = buf_temp-diasize-handle.handle-value
     5259               .
     5260               if v-object-handle <> v-diasize-resize-button
     5261               then do:
     5262                 assign
     5263                   v-object-handle :col = buf_temp-diasize-handle.save-position
     5264                 .
     5265               end.
     5266             end.
     5267             assign
     5268               v-diasize-browse-handle :width = v-browse-width
     5269             .
     5270             for each buf_temp-browse-handle
     5271               where buf_temp-browse-handle.browse-type = 'width':u
     5272             on error undo, next
     5273             :
     5274               assign
     5275                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     5276               .
     5277             end.
     5278             assign
     5279               frame Dialog-Frame :width = v-frame-width
     5280             .
     5281             if frame Dialog-Frame :scrollable = true
     5282             then do:
     5283               assign
     5284                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     5285               .
     5286             end.
     5287             run diasize_position-resize-button in this-procedure .
     5288           end.
     5289           else do:
     5290             if frame Dialog-Frame :scrollable = true
     5291             then do:
     5292               assign
     5293                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     5294               .
     5295             end.
     5296             assign
     5297               frame Dialog-Frame :width = v-frame-width
     5298             .
     5299             for each buf_temp-browse-handle
     5300               where buf_temp-browse-handle.browse-type = 'width':u
     5301             on error undo, next
     5302             :
     5303               assign
     5304                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     5305               .
     5306             end.
     5307             assign
     5308               v-diasize-browse-handle :width = v-browse-width
     5309             .
     5310             for each buf_temp-diasize-handle
     5311             on error undo, next
     5312             :
     5313               assign
     5314                 v-object-handle = buf_temp-diasize-handle.handle-value
     5315               .
     5316               if v-object-handle <> v-diasize-resize-button
     5317               then do:
     5318                 assign
     5319                   v-object-handle :col = buf_temp-diasize-handle.save-position
     5320                 .
     5321               end.
     5322             end.
     5323             run diasize_position-resize-button in this-procedure .
     5324           end.
     5325           assign
     5326             v-diasize-change-size = false
     5327           .
     5328           leave move_block .
     5329         end.
     5330       end.
     5331       assign
     5332         v-diasize-need-full-display = true
     5333       .
     5334       if v-diasize-change-size = false
     5335       then do:
     5336         assign
     5337           v-diasize-change-size = true
     5338         .
     5339       end.
     5340       else do:
     5341         return .
     5342       end.
     5343       assign
     5344         v-frame-width = frame Dialog-Frame :width
     5345         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     5346         v-browse-width = v-diasize-browse-handle :width
     5347       .
     5348       for each buf_temp-browse-handle
     5349         where buf_temp-browse-handle.browse-type = 'width':u
     5350       :
     5351         assign
     5352           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     5353         .
     5354       end.
     5355       for each buf_temp-diasize-handle
     5356       :
     5357         delete buf_temp-diasize-handle .
     5358       end.
     5359       assign
     5360         v-field-group-handle = frame Dialog-Frame :first-child
     5361       .
     5362       do while valid-handle(v-field-group-handle)
     5363       :
     5364         assign
     5365           v-object-handle = v-field-group-handle :first-child
     5366         .
     5367         do while valid-handle(v-object-handle)
     5368         :
     5369           if  v-object-handle <> v-diasize-browse-handle :handle
     5370           and v-object-handle <> v-diasize-resize-button
     5371           and can-query(v-object-handle, "row")
     5372           and can-query(v-object-handle, "height")
     5373           and ( v-object-handle :col + v-object-handle :width
     5374                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     5375               )
     5376           then do:
     5377             find first buf_temp-browse-handle
     5378               where buf_temp-browse-handle.browse-type   = 'width':u
     5379                 and buf_temp-browse-handle.browse-handle = v-object-handle
     5380               no-error .
     5381             if available buf_temp-browse-handle
     5382             then do:
     5383             end.
     5384             else do:
     5385               create buf_temp-diasize-handle .
     5386               assign
     5387                 buf_temp-diasize-handle.handle-value  = v-object-handle
     5388                 buf_temp-diasize-handle.save-position = v-object-handle :col
     5389               .
     5390             end.
     5391           end.
     5392           assign
     5393             v-object-handle = v-object-handle :next-sibling
     5394           .
     5395         end.
     5396         assign
     5397           v-field-group-handle = v-field-group-handle :next-sibling
     5398         .
     5399       end.
     5400       do with frame Dialog-Frame
     5401       :
     5402         hide v-diasize-resize-button .
     5403         v-diasize-resize-button :row = 1.
     5404         v-diasize-resize-button :column = 1.
     5405       end.
     5406       if p-change-value > 0
     5407       then do:
     5408         if frame Dialog-Frame :scrollable = true
     5409         then do:
     5410           assign
     5411             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5412             no-error .
     5413           if error-status :error
     5414           or error-status :get-message(1) <> ""
     5415           then do:
     5416             undo move_block, retry move_block.
     5417           end.
     5418         end.
     5419         assign
     5420           frame Dialog-Frame :width = v-frame-width + p-change-value
     5421           no-error .
     5422         if error-status :error
     5423         or error-status :get-message(1) <> ""
     5424         then do:
     5425           undo move_block, retry move_block.
     5426         end.
     5427         assign
     5428           v-diasize-browse-handle :width = v-browse-width + p-change-value
     5429         no-error .
     5430         if error-status :error
     5431         or error-status :get-message(1) <> ""
     5432         then do:
     5433           undo move_block, retry move_block.
     5434         end.
     5435         for each buf_temp-browse-handle
     5436           where buf_temp-browse-handle.browse-type = 'width':u
     5437         on error undo move_block, retry move_block
     5438         :
     5439           assign
     5440             buf_temp-browse-handle.browse-handle :width
     5441               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5442             no-error .
     5443           if error-status :error
     5444           or error-status :get-message(1) <> ""
     5445           then do:
     5446             undo move_block, retry move_block .
     5447           end.
     5448         end.
     5449         for each buf_temp-diasize-handle
     5450         on error undo move_block, retry move_block
     5451         :
     5452           assign
     5453             v-object-handle = buf_temp-diasize-handle.handle-value
     5454           .
     5455           if v-object-handle <> v-diasize-resize-button
     5456           then do:
     5457             assign
     5458               v-object-handle :col = v-object-handle :col + p-change-value
     5459               no-error .
     5460             if error-status :error
     5461             or error-status :get-message(1) <> ""
     5462             then do:
     5463               undo move_block, retry move_block .
     5464             end.
     5465           end.
     5466         end.
     5467       end.
     5468       else do:
     5469         for each buf_temp-diasize-handle
     5470         on error undo move_block, retry move_block
     5471         :
     5472           assign
     5473             v-object-handle = buf_temp-diasize-handle.handle-value
     5474           .
     5475           if v-object-handle <> v-diasize-resize-button
     5476           then do:
     5477             assign
     5478               v-object-handle :col = v-object-handle :col + p-change-value
     5479               no-error .
     5480             if error-status :error
     5481             or error-status :get-message(1) <> ""
     5482             then do:
     5483               undo move_block, retry move_block .
     5484             end.
     5485           end.
     5486         end.
     5487         for each buf_temp-browse-handle
     5488           where buf_temp-browse-handle.browse-type = 'width':u
     5489         on error undo move_block, retry move_block
     5490         :
     5491           assign
     5492             buf_temp-browse-handle.browse-handle :width
     5493               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5494             no-error .
     5495           if error-status :error
     5496           or error-status :get-message(1) <> ""
     5497           then do:
     5498             undo move_block, retry move_block .
     5499           end.
     5500         end.
     5501         assign
     5502           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     5503           no-error .
     5504         if error-status :error
     5505         or error-status :get-message(1) <> ""
     5506         then do:
     5507           undo move_block, retry move_block.
     5508         end.
     5509         assign
     5510           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     5511         no-error .
     5512         if error-status :error
     5513         or error-status :get-message(1) <> ""
     5514         then do:
     5515           undo move_block, retry move_block.
     5516         end.
     5517         if frame Dialog-Frame :scrollable = true
     5518         then do:
     5519           assign
     5520             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5521           no-error .
     5522           if error-status :error
     5523           or error-status :get-message(1) <> ""
     5524           then do:
     5525             undo move_block, retry move_block.
     5526           end.
     5527         end.
     5528       end.
     5529       if p-move-resize
     5530       then do:
     5531         run diasize_position-resize-button in this-procedure .
     5532       end.
     5533       if v-diasize-wndstore = true
     5534       then do:
     5535         if connected("ub") = true
     5536         then do:
     5537           define variable v-cntxt-db-num        as integer   no-undo .
     5538           define variable v-cntxt-userid        as character no-undo .
     5539           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5540                                             , OUTPUT v-cntxt-userid
     5541                                             ) .
     5542           run gbl/wndsizew.p
     5543             (input  v-cntxt-db-num
     5544             ,input  v-cntxt-userid
     5545             ,input  v-diasize-proc-name
     5546             ,input  'width':u
     5547             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     5548             ) .
     5549         end.
     5550       end.
     5551     end.
     5552     assign
     5553       v-diasize-change-size = false
     5554     .
     5555   end procedure.
     5556   procedure diasize_set-width :
     5557     define input  parameter p-new-width  as decimal   no-undo .
     5558     define input  parameter p-move-resize as logical   no-undo .
     5559     do
     5560     on error undo, return error return-value
     5561     :
     5562       run diasize_change-width in this-procedure
     5563         (input  (p-new-width - frame Dialog-Frame :width)
     5564         ,input  p-move-resize
     5565         ) .
     5566     end.
     5567   end procedure.
     5568   procedure diasize_position-resize-button :
     5569     do with frame Dialog-Frame
     5570     :
     5571       hide v-diasize-resize-button .
     5572       assign
     5573         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5574                     - 1
     5575                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5576         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5577                     - 1
     5578                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5579       .
     5580       view v-diasize-resize-button .
     5581     end.
     5582   end procedure.
     5583   on alt-right anywhere
     5584   do:
     5585     run diasize_change-width in this-procedure
     5586       (input 1
     5587       ,input true
     5588       ) .
     5589     return no-apply .
     5590   end.
     5591   on alt-left anywhere
     5592   do:
     5593     run diasize_change-width in this-procedure
     5594       (input -1
     5595       ,input true
     5596       ) .
     5597     return no-apply .
     5598   end.
     5599   on alt-down anywhere
     5600   do:
     5601     run diasize_change-height in this-procedure
     5602       (input 1
     5603       ,input true
     5604       ) .
     5605     return no-apply .
     5606   end.
     5607   on alt-up anywhere
     5608   do:
     5609     run diasize_change-height in this-procedure
     5610       (input -1
     5611       ,input true
     5612       ) .
     5613     return no-apply .
     5614   end.
     5615   on alt-enter of frame Dialog-Frame
     5616   do:
     5617     run diasize_maximize in this-procedure
     5618       (input  ?
     5619       ).
     5620     return no-apply .
     5621   end.
     5622   procedure diasize_end-move :
     5623     do
     5624     on error undo, return error return-value
     5625     :
     5626       define variable v-row-delta as decimal   no-undo .
     5627       define variable v-col-delta as decimal   no-undo .
     5628       define variable v-new-row as decimal   no-undo .
     5629       define variable v-new-col as decimal   no-undo .
     5630       assign
     5631         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5632         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5633       .
     5634       assign
     5635         v-row-delta = v-new-row - frame Dialog-Frame :height
     5636         v-col-delta = v-new-col - frame Dialog-Frame :width
     5637       .
     5638       run diasize_change-height in this-procedure
     5639         (input v-row-delta
     5640         ,input true
     5641         ) .
     5642       run diasize_change-width in this-procedure
     5643         (input v-col-delta
     5644         ,input true
     5645         ) .
     5646     end.
     5647   end procedure.
     5648   procedure diasize_maximize :
     5649     define input  parameter p-action as logical   no-undo .
     5650     do
     5651     on error undo, return error return-value
     5652     :
     5653       if p-action = ?
     5654       then do:
     5655         if v-diasize-need-maximize = true
     5656         then do:
     5657           assign
     5658             p-action = true
     5659           .
     5660         end.
     5661         else do:
     5662           assign
     5663             p-action = false
     5664           .
     5665         end.
     5666       end.
     5667       if p-action = true
     5668       then do:
     5669         run diasize_change-height in this-procedure
     5670           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5671               - frame Dialog-Frame :height-chars
     5672           ,input true
     5673           ) .
     5674         run diasize_change-width in this-procedure
     5675           (input session :width-chars
     5676               - frame Dialog-Frame :width-chars
     5677           ,input true
     5678           ) .
     5679         assign
     5680           v-diasize-need-maximize = false
     5681         .
     5682       end.
     5683       else do:
     5684         run diasize_change-width in this-procedure
     5685           (input v-diasize-orig-frame-width
     5686               - frame Dialog-Frame :width-chars
     5687           ,input true
     5688           ) .
     5689         run diasize_change-height in this-procedure
     5690           (input v-diasize-orig-frame-height
     5691               - frame Dialog-Frame :height-chars
     5692           ,input true
     5693           ) .
     5694         assign
     5695           v-diasize-need-maximize = true
     5696         .
     5697       end.
     5698     end.
     5699   end procedure.
     5700   procedure diasize_restore-orig-size :
     5701     do
     5702     on error undo, return error return-value
     5703     :
     5704       assign
     5705         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5706         v-diasize-current-frame-height = frame Dialog-Frame :height
     5707       .
     5708       run diasize_set-height in this-procedure
     5709         (input  v-diasize-orig-frame-height
     5710         ,input  true
     5711         ) .
     5712       run diasize_set-width in this-procedure
     5713         (input  v-diasize-orig-frame-width
     5714         ,input  true
     5715         ) .
     5716     end.
     5717   end procedure.
     5718   procedure diasize_restore-current-size :
     5719     do
     5720     on error undo, return error return-value
     5721     :
     5722       run diasize_set-height in this-procedure
     5723         (input  v-diasize-current-frame-height
     5724         ,input  true
     5725         ) .
     5726       run diasize_set-width in this-procedure
     5727         (input  v-diasize-current-frame-width
     5728         ,input  true
     5729         ) .
     5730     end.
     5731   end procedure.
     5732   procedure diasize_set-browse-handle :
     5733     define input  parameter p-browse-handle as handle   no-undo .
     5734     define buffer buf_temp-browse-handle for temp-browse-handle .
     5735     do
     5736     on error undo, return error return-value
     5737     :
     5738       assign
     5739         v-diasize-browse-handle = p-browse-handle
     5740       .
     5741       for each buf_temp-browse-handle
     5742       on error undo, return error return-value
     5743       :
     5744         delete buf_temp-browse-handle .
     5745       end.
     5746     end.
     5747   end procedure.
     5748   procedure diasize_add_browse :
     5749     define input  parameter p-browse-type   as character no-undo .
     5750     define input  parameter p-browse-handle as handle    no-undo .
     5751     define buffer buf_temp-browse-handle for temp-browse-handle .
     5752     do
     5753     on error undo, return error return-value
     5754     :
     5755       assign
     5756         v-diasize-browse-number = v-diasize-browse-number + 1
     5757       .
     5758       create buf_temp-browse-handle .
     5759       assign
     5760         buf_temp-browse-handle.browse-type   = p-browse-type
     5761         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5762         buf_temp-browse-handle.browse-handle = p-browse-handle
     5763       .
     5764     end.
     5765   end procedure.
     5766   procedure diasize_init :
     5767     define variable v-default-value    as logical   no-undo .
     5768     define variable v-restore-saved    as logical   no-undo .
     5769     define variable v-resize-value-str as character no-undo .
     5770     do
     5771     on error undo, return error return-value
     5772     :
     5773       do with frame Dialog-Frame
     5774       :
     5775         assign
     5776           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5777           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5778           v-diasize-browse-handle     = browse br-parts :handle
     5779         .
     5780         create button v-diasize-resize-button
     5781         assign
     5782           parent        = frame Dialog-Frame :first-child
     5783           label         = "s"
     5784           height-pixels = 16
     5785           width-pixels  = 16
     5786           visible       = true
     5787           sensitive     = true
     5788           movable       = true
     5789           triggers:
     5790             on end-move persistent run diasize_end-move in this-procedure .
     5791           end triggers.
