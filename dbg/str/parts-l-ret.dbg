      284   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      285   function diff-list returns character (
      286     input parfirst-list  as character,
      287     input parsecond-list as character,
      288     input pardelim       as character).
      289     if pardelim = ""
      290     or pardelim = ?
      291     then do:
      292       assign
      293         pardelim = ","
      294       .
      295     end.
      296     def var ind as integer no-undo .
      297     def var v-elem as character no-undo .
      298     def var v-result-list as character no-undo init "".
      299     def var v-num-parfirst-list as integer no-undo .
      300     assign
      301       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      302     .
      303     do ind = 1 to v-num-parfirst-list
      304     :
      305       assign
      306         v-elem = entry(ind, parfirst-list, pardelim)
      307       .
      308       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      309         assign
      310           v-result-list = v-result-list
      311                         + (if v-result-list > "" then pardelim else "")
      312                         + v-elem
      313         .
      314       end.
      315     end.
      316     return v-result-list .
      317   end function.
      318   function add-list returns character (
      319    input parfirst-list  as character,
      320    input parsecond-list as character,
      321    input pardelim       as character).
      322     if pardelim = ""
      323     or pardelim = ?
      324     then do:
      325       assign
      326         pardelim = ","
      327       .
      328     end.
      329     def var ind as integer no-undo .
      330     def var v-elem as character no-undo .
      331     def var v-result-list as character no-undo init "".
      332     def var v-num-parfirst-list as integer no-undo .
      333     assign
      334       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      335     .
      336     do ind = 1 to v-num-parfirst-list
      337     :
      338       assign
      339         v-elem = entry(ind, parfirst-list, pardelim)
      340       .
      341       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      342         assign
      343           v-result-list = v-result-list
      344                         + (if v-result-list > "" then pardelim else "")
      345                         + v-elem
      346         .
      347       end.
      348     end.
      349     def var v-num-parsecond-list as integer no-undo .
      350     assign
      351       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      352     .
      353     do ind = 1 to v-num-parsecond-list
      354     :
      355       assign
      356         v-elem = entry(ind, parsecond-list, pardelim)
      357       .
      358       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      359         assign
      360           v-result-list = v-result-list
      361                         + (if v-result-list > "" then pardelim else "")
      362                         + v-elem
      363         .
      364       end.
      365     end.
      366     return v-result-list .
      367   end function.
      368   function cross-list returns character (
      369    input parfirst-list  as character,
      370    input parsecond-list as character,
      371    input pardelim       as character).
      372     if pardelim = ""
      373     or pardelim = ?
      374     then do:
      375       assign
      376         pardelim = ","
      377       .
      378     end.
      379     def var ind as integer no-undo .
      380     def var v-elem as character no-undo .
      381     def var v-result-list as character no-undo init "".
      382     def var v-num-parfirst-list as integer no-undo .
      383     assign
      384       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      385     .
      386     do ind = 1 to v-num-parfirst-list
      387     :
      388       assign
      389         v-elem = entry(ind, parfirst-list, pardelim)
      390       .
      391       if lookup(v-elem, v-result-list, pardelim) = 0
      392       and lookup(v-elem, parsecond-list, pardelim) > 0
      393       then do:
      394         assign
      395           v-result-list = v-result-list
      396                         + (if v-result-list > "" then pardelim else "")
      397                         + v-elem
      398         .
      399       end.
      400     end.
      401     return v-result-list .
      402   end function.
      403   function radio-label returns character (
      404    input par-rs-value  as character,
      405    input par-rs-radio-buttons as character)
      406    .
      407    DEFINE variable v-result-label as character no-undo.
      408    assign
      409    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      410                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      411                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      412                             ), par-rs-radio-buttons
      413                           )
      414    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      415    .
      416   return v-result-label.
      417   end function.
      418   function m-radio-label returns character (
      419    input par-rs-value  as character,
      420    input par-rs-radio-buttons as character,
      421    input par-delim as character
      422    )
      423    .
      424    DEFINE variable v-result-label as character no-undo.
      425    assign
      426    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      427                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      428                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      429                             ), par-rs-radio-buttons, par-delim
      430                           )
      431    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      432    .
      433   return v-result-label.
      434   end function.
      435   FUNCTION mixlist returns character
      436   (
      437    input parfirst-list  as character
      438    ,input parsecond-list as character
      439    ,input pardelim       as character
      440    ,input pardelim-result as character ) :
      441     if pardelim = ""
      442     or pardelim = ?
      443     then do:
      444       assign
      445         pardelim = ","
      446       .
      447     end.
      448     def var ind as integer no-undo .
      449     def var v-elem1 as character no-undo .
      450     def var v-elem2 as character no-undo .
      451     def var v-result-list as character no-undo init "".
      452     do ind = 1 to num-entries(parfirst-list, pardelim)
      453     :
      454       assign
      455         v-elem1 = entry(ind, parfirst-list, pardelim)
      456         v-elem2 = entry(ind, parsecond-list, pardelim)
      457       .
      458         assign
      459           v-result-list = v-result-list
      460                         + (if v-result-list > "" then pardelim-result else "")
      461                         + v-elem1 + pardelim-result + v-elem2
      462         .
      463     end.
      464     return v-result-list .
      465   END FUNCTION.
      466   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      467   procedure rsrgdsck :
      468     define input  parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
      469     define input  parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
      470     define input  parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
      471     define input  parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
      472     define input  parameter p-artic                  like ub.doc-line.artic     no-undo .
      473     define input  parameter p-prod-type              like ub.doc-line.prod-type no-undo .
      474     define input  parameter p-prod-code              like ub.doc-line.prod-code no-undo .
      475     define output parameter p-free-parts-qnty        like ub.parts.qnty         no-undo .
      476     define output parameter p-free-parts-fact-qnty   like ub.parts.fact-qnty    no-undo .
      477     define output parameter p-free-parts-cli-qnty    like ub.parts.cli-qnty     no-undo .
      478     define output parameter p-free-parts-price-base  as decimal                 no-undo .
      479     define output parameter p-free-parts-price-rubl  as decimal                 no-undo .
      480     define output parameter p-out-parts-qnty         like ub.parts.qnty         no-undo .
      481     define output parameter p-out-parts-fact-qnty    like ub.parts.fact-qnty    no-undo .
      482     define output parameter p-out-parts-cli-qnty     like ub.parts.cli-qnty     no-undo .
      483     define output parameter p-out-parts-price-base   as decimal                 no-undo .
      484     define output parameter p-out-parts-price-rubl   as decimal                 no-undo .
      485     define buffer buf_parts    for ub.parts.
      486     assign
      487       p-free-parts-qnty       = 0
      488       p-free-parts-fact-qnty  = 0
      489       p-free-parts-cli-qnty   = 0
      490       p-free-parts-price-base = 0
      491       p-free-parts-price-rubl = 0
      492       p-out-parts-qnty        = 0
      493       p-out-parts-fact-qnty   = 0
      494       p-out-parts-cli-qnty    = 0
      495       p-out-parts-price-base  = 0
      496       p-out-parts-price-rubl  = 0
      497     .
      498     for each buf_parts no-lock
      499       where buf_parts.out-code  = p-doc-code
      500         and buf_parts.obj-type  = p-obj-type
      501         and buf_parts.obj-code  = p-obj-code
      502         and buf_parts.artic     = p-artic
      503         and buf_parts.prod-type = p-prod-type
      504         and buf_parts.prod-code = p-prod-code
      505     on error undo, return error
      506     :
      507       if can-do('при,рас,спи':U, p-doc-type)
      508       or (p-doc-type = 'инв':U
      509           and buf_parts.fact-qnty < 0)
      510       then do:
      511         assign
      512           p-free-parts-qnty       = p-free-parts-qnty
      513                                   + abs(buf_parts.qnty)
      514           p-free-parts-fact-qnty  = p-free-parts-fact-qnty
      515                                   + abs(buf_parts.fact-qnty)
      516           p-free-parts-cli-qnty   = p-free-parts-cli-qnty
      517                                   + abs(buf_parts.cli-qnty)
      518           p-free-parts-price-base = p-free-parts-price-base
      519                                   + abs(buf_parts.fact-qnty) * buf_parts.price-base
      520           p-free-parts-price-rubl = p-free-parts-price-rubl
      521                                   + abs(buf_parts.fact-qnty) * buf_parts.price-rubl
      522         .
      523       end.
      524       else do:
      525         assign
      526           p-out-parts-qnty        = p-out-parts-qnty
      527                                   + buf_parts.qnty
      528           p-out-parts-fact-qnty   = p-out-parts-fact-qnty
      529                                   + buf_parts.fact-qnty
      530           p-out-parts-cli-qnty    = p-out-parts-cli-qnty
      531                                   + buf_parts.cli-qnty
      532           p-out-parts-price-base  = p-out-parts-price-base
      533                                   + buf_parts.fact-qnty * buf_parts.price-base
      534           p-out-parts-price-rubl  = p-out-parts-price-rubl
      535                                   + buf_parts.fact-qnty * buf_parts.price-rubl
      536         .
      537       end.
      538     end.
      539   end procedure.
      540   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      541   define temp-table temp-trndocrs-gds-dtl-rsrv no-undo
      542     field prt-code         like ub.gds-dtl.prt-code
      543     field rsrv-qnty        like ub.gds-dtl.fact-qnty
      544     field rsrv-out-qnty    like ub.gds-dtl.fact-qnty
      545     index xpk is primary unique prt-code
      546   .
      547   define temp-table temp-trndocrs-pl-gds-rsrv no-undo
      548     field pl-code          like ub.pl-gds.pl-code
      549     field rsrv-qnty        like ub.pl-gds.free-qnty
      550     field cli-rsrv-qnty    like ub.pl-gds.cli-free-qnty
      551     field rsrv-out-qnty    like ub.pl-gds.fact-qnty
      552     field before-free-qnty like ub.pl-gds.fact-qnty
      553     field before-out-qnty  like ub.pl-gds.fact-qnty
      554     field after-free-qnty  like ub.pl-gds.fact-qnty
      555     field after-out-qnty   like ub.pl-gds.fact-qnty
      556     field fact-qnty        like ub.pl-gds.fact-qnty
      557     field cli-qnty         like ub.pl-gds.cli-qnty
      558     field cli-fact-qnty    like ub.pl-gds.cli-fact-qnty
      559     index xpk is primary unique pl-code
      560   .
      561   procedure trndocrs-gds-dtl-clear :
      562     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      563     do
