     4294     define variable v-ok as logical no-undo .
     4295     assign
     4296       v-ok = false
     4297     .
     4298     if v-data-changed = true
     4299     then do:
     4300       message
     4301         "Данные были изменены" skip
     4302         "Вы действительно хотите отказаться от ВСЕХ изменений" skip
     4303         "с момента последнего открытия окна партий?" skip
     4304         view-as alert-box question buttons yes-no update v-ok .
     4305       if v-ok <> true
     4306       then do:
     4307         return no-apply .
     4308       end.
     4309     end.
     4310     if  v-need-check-diff-qnty = true
     4311     and v-chg-qnty <> 0
     4312     then do:
     4313       message
     4314         "Необходимо создать партии с общим количеством" v-chg-qnty skip
     4315         "Отказ от редактирования партий приведет к тому," skip
     4316         "что не будет зарезервировано необходимое количество товара" skip
     4317         "Вы действительно хотите отказаться от редактирования партий?"
     4318         view-as alert-box question buttons yes-no update v-ok .
     4319       if v-ok <> true
     4320       then do:
     4321         return no-apply .
     4322       end.
     4323     end.
     4324   END.
