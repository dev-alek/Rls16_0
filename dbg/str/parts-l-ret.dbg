     7592   PROCEDURE parts-show-income-in-code :
     7593     define input  parameter p-parts-recid as recid     no-undo .
     7594     define buffer buf_parts for ub.parts .
     7595     define buffer buf_goods for ub.goods .
     7596     define variable v-gds-code as integer   no-undo .
     7597     define variable v-income-in-code   as character no-undo .
     7598     define variable v-income-gds-code  as integer   no-undo .
     7599     define variable v-income-part-code as character no-undo .
     7600     define variable v-income-artic     as character no-undo .
     7601     define variable v-income-prod-type as character no-undo .
     7602     define variable v-income-prod-code as integer   no-undo .
     7603     do
     7604     on error undo, return error return-value
     7605     :
     7606       find first buf_parts no-lock
     7607         where recid(buf_parts) = p-parts-recid
     7608         no-error .
     7609       if not available buf_parts
     7610       then do:
     7611         message
     7612           vss-workfile vss-revision vss-description skip
     7613           "Неправильное задание входных параметров" skip
     7614           "Не найдена партия" skip
     7615           "Код партии" p-parts-recid skip
     7616           view-as alert-box error .
     7617         undo, return error return-value .
     7618       end.
     7619   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pargocod in g#library
     7620     (input  p-parts-recid
     7621     ,output v-gds-code
     7622     )  .
     7623       define buffer buf_parts-attr for ub.parts-attr .
     7624       find first buf_parts-attr no-lock
     7625         where buf_parts-attr.in-code   = buf_parts.in-code
     7626           and buf_parts-attr.gds-code  = v-gds-code
     7627           and buf_parts-attr.part-code = buf_parts.part-code
     7628         no-error .
     7629       if available buf_parts-attr
     7630       then do:
     7631         assign
     7632           v-income-in-code   = buf_parts-attr.income-in-code
     7633           v-income-gds-code  = buf_parts-attr.income-gds-code
     7634           v-income-part-code = buf_parts-attr.income-part-code
     7635         .
     7636         find first buf_goods no-lock
     7637           where buf_goods.gds-code = v-income-gds-code
     7638           no-error .
     7639         if available buf_goods
     7640         then do:
     7641           assign
     7642             v-income-artic     = buf_goods.artic
     7643             v-income-prod-type = buf_goods.prod-type
     7644             v-income-prod-code = buf_goods.prod-code
     7645           .
     7646         end.
     7647         else do:
     7648           assign
     7649             v-income-artic     = ""
     7650             v-income-prod-type = ""
     7651             v-income-prod-code = 0
     7652           .
     7653         end.
     7654         run str/showdoc.p
     7655           (input parparentproc
     7656           ,input v-income-in-code
     7657           ,input v-income-artic
     7658           ,input v-income-prod-type
     7659           ,input v-income-prod-code
     7660           ,input true
     7661           ) .
     7662       end.
     7663       else do:
     7664         message
     7665           "Информация о внешней приходной накладной, создавшей данную партию, недоступна" skip
     7666           view-as alert-box information .
     7667       end.
     7668     end.
     7669   END PROCEDURE.
     7670   PROCEDURE proc-get-country-name :
     7671     define parameter buffer buf_parts      for ub.parts .
     7672     define output parameter p-country-name as character no-undo .
     7673     define buffer buf_parts-attr for ub.parts-attr .
     7674     define buffer buf_country    for ub.country .
     7675     do
     7676     on error undo, return error return-value
     7677     :
     7678       if available buf_parts
     7679       then do:
     7680         find first buf_parts-attr no-lock
     7681           where buf_parts-attr.in-code   = buf_parts.in-code
     7682             and buf_parts-attr.gds-code  = p-gds-code
     7683             and buf_parts-attr.part-code = buf_parts.part-code
     7684           no-error .
     7685         if available buf_parts-attr
     7686         then do:
     7687           find first buf_country no-lock
     7688             where buf_country.num-code = buf_parts-attr.country-code
     7689             no-error .
     7690           if not available buf_country
     7691           then do:
     7692             assign
     7693               p-country-name = "XX Неизвестна"
     7694             .
     7695           end.
     7696           else do:
     7697             assign
     7698               p-country-name = buf_country.alpha1 + " " + buf_country.short-name
     7699             .
     7700           end.
     7701         end.
     7702       end.
     7703     end.
     7704   END PROCEDURE.
     7705   PROCEDURE purch-code-to-str :
     7706     define input  parameter p-purch-code     as integer   no-undo .
     7707     define output parameter p-purch-code-str as character no-undo .
     7708   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run purchnam in g#library
     7709     (input  p-purch-code
     7710     ,output p-purch-code-str
     7711     )  .
     7712   END PROCEDURE.
     7713   PROCEDURE reopen-query :
     7714     run UI-on in this-procedure
     7715       (input true
     7716       ,input true
     7717       ,input ""
     7718       ).
     7719   END PROCEDURE.
     7720   PROCEDURE reposition-parts :
     7721     define input  parameter p-direction   as character no-undo .
     7722     define output parameter p-parts-recid as recid no-undo .
     7723     if p-doc-code = ""
     7724     then do:
     7725       message
     7726         "Перемещение по партиям доступно только из интерфейса документа"
     7727         view-as alert-box information .
     7728       return .
     7729     end.
     7730     case p-direction :
     7731       when "first":U
     7732       then do:
     7733         get first br-parts.
     7734       end.
     7735       when "last":U
     7736       then do:
     7737         get last br-parts.
     7738       end.
     7739       when "prev":U
     7740       then do:
     7741         get prev br-parts.
     7742       end.
     7743       when "next":U
     7744       then do:
     7745         get next br-parts.
     7746       end.
     7747       otherwise do:
     7748         reposition br-parts to recid integer(p-direction) no-error .
     7749       end.
     7750     end case .
     7751     assign
     7752       p-parts-recid = recid(parts)
     7753     .
     7754     run reposition-query in this-procedure
     7755       (input p-parts-recid
     7756       ).
     7757   END PROCEDURE.
     7758   PROCEDURE reposition-query :
     7759     define input parameter p-recid as recid no-undo .
     7760     if p-recid <> ?
     7761     then do:
     7762       reposition br-parts to recid p-recid no-error.
     7763     end.
     7764     do with frame Dialog-Frame:
     7765       apply "entry":u to browse br-parts .
     7766     end.
     7767     run display-parts-info .
     7768   END PROCEDURE.
     7769   PROCEDURE save-changes :
     7770     define variable v-need-rsrv      as logical   no-undo .
     7771     define variable v-doc-qnty-cli   as decimal   no-undo .
     7772     define variable v-doc-qnty-base  as decimal   no-undo .
     7773     define variable v-fact-qnty-cli  as decimal   no-undo .
     7774     define variable v-fact-qnty-base as decimal   no-undo .
     7775     define variable v-doc-density    as decimal   no-undo .
     7776     define variable v-fact-density   as decimal   no-undo .
     7777     define variable v-inv-rec        as recid     no-undo .
     7778     define buffer buf_trn-doc  for ub.trn-doc .
     7779     define buffer buf_goods    for ub.goods .
     7780     define buffer buf_doc-line for ub.doc-line .
     7781     define buffer buf_parts    for ub.parts .
     7782     define buffer buf_doc-pl   for ub.doc-pl .
     7783     if v-edit-parts = true
     7784     then do:
     7785       do transaction
     7786       on error undo, return error
     7787       :
     7788         find first buf_trn-doc no-lock
     7789           where buf_trn-doc.doc-code = p-doc-code
     7790           no-error .
     7791         if not available buf_trn-doc
     7792         then do:
     7793           message
     7794             vss-workfile vss-revision vss-description skip
     7795             "Ошибка задания входных параметров" skip
     7796             "Не найден документ" skip
     7797             "Документ" p-doc-code skip
     7798             "Код товара" p-gds-code skip
     7799             view-as alert-box error .
     7800           undo, return error .
     7801         end.
     7802         find first buf_goods no-lock
     7803           where buf_goods.gds-code = p-gds-code
     7804           no-error .
     7805         if not available buf_trn-doc
     7806         then do:
     7807           message
     7808             vss-workfile vss-revision vss-description skip
     7809             "Ошибка задания входных параметров" skip
     7810             "Не найден товар" skip
     7811             "Документ" p-doc-code skip
     7812             "Код товара" p-gds-code skip
     7813             view-as alert-box error .
     7814           undo, return error .
     7815         end.
     7816         find first buf_doc-line no-lock
     7817           where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     7818             and buf_doc-line.artic     = buf_goods.artic
     7819             and buf_doc-line.prod-type = buf_goods.prod-type
     7820             and buf_doc-line.prod-code = buf_goods.prod-code
     7821           no-error .
     7822         if not available buf_doc-line
     7823         then do:
     7824           message
     7825             vss-workfile vss-revision vss-description skip
     7826             "Не найдена строка документа" skip
     7827             "Документ" p-doc-code skip
     7828             "Код товара" p-gds-code skip
     7829             "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     7830             view-as alert-box error .
     7831           undo, return error .
     7832         end.
     7833           for each buf_parts no-lock
     7834             where buf_parts.out-code  = buf_trn-doc.doc-code
     7835               and buf_parts.obj-type  = buf_doc-line.obj-type
     7836               and buf_parts.obj-code  = buf_doc-line.obj-code
     7837               and buf_parts.artic     = buf_doc-line.artic
     7838               and buf_parts.prod-type = buf_doc-line.prod-type
     7839               and buf_parts.prod-code = buf_doc-line.prod-code
     7840           on error undo, return error return-value
     7841           :
     7842             if buf_parts.in-code = buf_parts.out-code then do:
     7843                run create-bar-code-parts (
     7844                     buf_goods.gds-code  ,
     7845                     buf_parts.part-code ,
     7846                     buf_parts.in-code   ,
     7847                     buf_goods.unit-base ) no-error .
     7848             end.
     7849         end.
     7850         if v-reserv-pl-code = true then do:
     7851           run trndocrs-pl-gds-request in this-procedure
     7852             (input  buf_doc-line.doc-code
     7853             ,input  buf_trn-doc.doc-type
     7854             ,input  buf_doc-line.obj-type
     7855             ,input  buf_doc-line.obj-code
     7856             ,input  buf_doc-line.artic
     7857             ,input  buf_doc-line.prod-type
     7858             ,input  buf_doc-line.prod-code
     7859             ,input  "after":u
     7860             ) .
     7861           run trndocrs-pl-gds-calc-rsrv in this-procedure .
     7862           assign
     7863             v-doc-density  = buf_doc-line.doc-density
     7864             v-fact-density = buf_doc-line.fact-density
     7865           .
     7866           for each buf_doc-pl exclusive-lock
     7867             where buf_doc-pl.out-code = buf_trn-doc.doc-code
     7868               and buf_doc-pl.gds-code = buf_goods.gds-code
     7869               and buf_doc-pl.obj-type = buf_doc-line.obj-type
     7870               and buf_doc-pl.obj-code = buf_doc-line.obj-code
     7871           on error undo, return error return-value
     7872           :
     7873             run trndocrs-pl-gds-accum in this-procedure
     7874               (input buf_doc-pl.pl-code
     7875               ,input 0.0
     7876               ,input ( if v-need-rsrv-gds = true then - buf_doc-pl.cli-doc-qnty else 0.0 )
     7877               ,input 0.0
     7878               ,input - buf_doc-pl.cli-fact-qnty
     7879               ) no-error .
     7880             if error-status :error
     7881             then do:
     7882               message
     7883                 vss-workfile vss-revision vss-description skip
     7884                 "Ошибка при изменении разрезервированных количеств trndocrs-pl-gds-accum" skip
     7885                 error-status :get-message(1) skip
     7886                 return-value skip
     7887                 view-as alert-box error .
     7888               undo, return error return-value .
     7889             end.
     7890             delete buf_doc-pl .
     7891           end.
     7892           for each buf_parts no-lock
     7893             where buf_parts.out-code  = buf_trn-doc.doc-code
     7894               and buf_parts.obj-type  = buf_doc-line.obj-type
     7895               and buf_parts.obj-code  = buf_doc-line.obj-code
     7896               and buf_parts.artic     = buf_doc-line.artic
     7897               and buf_parts.prod-type = buf_doc-line.prod-type
     7898               and buf_parts.prod-code = buf_doc-line.prod-code
     7899           on error undo, return error return-value
     7900           :
     7901             if buf_trn-doc.ext-doc-type = 'ep':U
     7902               and buf_trn-doc.status_ <> 'запрос':U
     7903             then do:
     7904               assign
     7905                 v-doc-density  = 1.0 / buf_parts.cli-base-rate
     7906                 v-fact-density = v-doc-density
     7907               .
     7908             end.
     7909             find first buf_doc-pl exclusive-lock
     7910               where buf_doc-pl.obj-type = buf_doc-line.obj-type
     7911                 and buf_doc-pl.obj-code = buf_doc-line.obj-code
     7912                 and buf_doc-pl.pl-code  = buf_parts.pl-code
     7913                 and buf_doc-pl.out-code = buf_trn-doc.doc-code
     7914                 and buf_doc-pl.gds-code = buf_goods.gds-code
     7915               no-error .
     7916             if not available buf_doc-pl then do:
     7917               create buf_doc-pl.
     7918               assign
     7919                 buf_doc-pl.obj-type     = buf_doc-line.obj-type
     7920                 buf_doc-pl.obj-code     = buf_doc-line.obj-code
     7921                 buf_doc-pl.pl-code      = buf_parts.pl-code
     7922                 buf_doc-pl.out-code     = buf_trn-doc.doc-code
     7923                 buf_doc-pl.gds-code     = buf_goods.gds-code
     7924                 buf_doc-pl.cli-qnty      = 0.0
     7925                 buf_doc-pl.doc-qnty      = 0.0
     7926                 buf_doc-pl.cli-doc-qnty  = 0.0
     7927                 buf_doc-pl.fact-qnty     = 0.0
     7928                 buf_doc-pl.cli-fact-qnty = 0.0
     7929               .
     7930             end.
     7931             assign
     7932               buf_doc-pl.cli-qnty      = buf_doc-pl.cli-qnty      + buf_parts.qnty / buf_parts.cli-base-rate
     7933               buf_doc-pl.doc-qnty      = buf_doc-pl.doc-qnty      + buf_parts.qnty
     7934               buf_doc-pl.cli-doc-qnty  = buf_doc-pl.cli-doc-qnty  + buf_parts.qnty * v-doc-density
     7935               buf_doc-pl.fact-qnty     = buf_doc-pl.fact-qnty     + buf_parts.fact-qnty
     7936               buf_doc-pl.cli-fact-qnty = buf_doc-pl.cli-fact-qnty + buf_parts.fact-qnty * v-fact-density
     7937             .
     7938           end.
     7939           assign
     7940             v-doc-qnty-cli   = 0.0
     7941             v-doc-qnty-base  = 0.0
     7942             v-fact-qnty-cli  = 0.0
     7943             v-fact-qnty-base = 0.0
     7944           .
     7945           for each buf_doc-pl share-lock
     7946             where buf_doc-pl.obj-type = buf_doc-line.obj-type
     7947               and buf_doc-pl.obj-code = buf_doc-line.obj-code
     7948               and buf_doc-pl.out-code = buf_trn-doc.doc-code
     7949               and buf_doc-pl.gds-code = buf_goods.gds-code
     7950           on error undo, return error return-value
     7951           :
     7952             assign
     7953               v-doc-qnty-base  = v-doc-qnty-base  + buf_doc-pl.doc-qnty
     7954               v-doc-qnty-cli   = v-doc-qnty-cli   + buf_doc-pl.cli-doc-qnty
     7955               v-fact-qnty-base = v-fact-qnty-base + buf_doc-pl.fact-qnty
     7956               v-fact-qnty-cli  = v-fact-qnty-cli  + buf_doc-pl.cli-fact-qnty
     7957             .
     7958             run trndocrs-pl-gds-accum in this-procedure
     7959               (input buf_doc-pl.pl-code
     7960               ,input 0.0
     7961               ,input ( if v-need-rsrv-gds = true then buf_doc-pl.cli-doc-qnty else 0.0 )
     7962               ,input 0.0
     7963               ,input buf_doc-pl.cli-fact-qnty
     7964               ) no-error .
     7965             if error-status :error then do:
     7966               message
     7967                 vss-workfile vss-revision vss-description skip
     7968                 "Ошибка при изменении зарезервированных количеств trndocrs-pl-gds-accum" skip
     7969                 error-status :get-message(1) skip
     7970                 return-value skip
     7971                 view-as alert-box error .
     7972               undo, return error return-value .
     7973             end.
     7974           end.
     7975           if v-is-petrol = true
     7976             and v-is-pieces = false
     7977           then do:
     7978             assign
     7979               buf_doc-line.cli-qnty     = v-doc-qnty-cli
     7980               buf_doc-line.doc-density  = v-doc-qnty-cli  / v-doc-qnty-base
     7981               buf_doc-line.fact-density = v-fact-qnty-cli / v-fact-qnty-base
     7982             .
     7983           end.
     7984         end.
     7985         run rsrgdsck in this-procedure
     7986           (input  buf_doc-line.doc-code
     7987           ,input  buf_trn-doc.doc-type
     7988           ,input  buf_doc-line.obj-type
     7989           ,input  buf_doc-line.obj-code
     7990           ,input  buf_doc-line.artic
     7991           ,input  buf_doc-line.prod-type
     7992           ,input  buf_doc-line.prod-code
     7993           ,output v-new-free-parts-qnty
     7994           ,output v-new-free-parts-fact-qnty
     7995           ,output v-new-free-parts-cli-qnty
     7996           ,output v-new-free-parts-price-base
     7997           ,output v-new-free-parts-price-rubl
     7998           ,output v-new-out-parts-qnty
     7999           ,output v-new-out-parts-fact-qnty
     8000           ,output v-new-out-parts-cli-qnty
     8001           ,output v-new-out-parts-price-base
     8002           ,output v-new-out-parts-price-rubl
     8003           ) no-error .
     8004         if error-status :error
     8005         then do:
     8006           message
     8007             vss-workfile vss-revision vss-description skip
     8008             "Ошибка при просмотре зарезервированных партий" skip
     8009             "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     8010             "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     8011             error-status :get-message(1)
     8012             return-value skip
     8013             view-as alert-box .
     8014           undo, return error .
     8015         end.
     8016         define variable v-chg-free-qnty as decimal no-undo .
     8017         define variable v-chg-out-qnty  as decimal no-undo .
     8018         assign
     8019           v-chg-free-qnty = v-new-free-parts-fact-qnty - v-free-parts-fact-qnty
     8020           v-chg-out-qnty  = v-new-out-parts-fact-qnty  - v-out-parts-fact-qnty
     8021         .
     8022         if v-need-rsrv-gds
     8023         then do:
     8024           run trg/rsrv-gds.p
     8025             (input parparentproc
     8026             ,buffer buf_doc-line
     8027             ,input  v-chg-free-qnty
     8028             ,input  v-chg-out-qnty
     8029             ,input table temp-trndocrs-gds-dtl-rsrv
     8030             ,input table temp-trndocrs-pl-gds-rsrv
     8031             ) no-error.
     8032           if error-status :error
     8033           then do:
     8034             if error-status :get-message(1) <> ""
     8035             then do:
     8036               message
     8037                 vss-workfile vss-revision vss-description skip
     8038                 "Невозможно зарезервировать товар по признакам" skip
     8039                 "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     8040                 "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     8041                 error-status :get-message(1) skip
     8042                 return-value skip
     8043                 view-as alert-box .
     8044             end.
     8045             undo, return error .
     8046           end.
     8047   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8048   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscheck in g#library
     8049     (input buf_doc-line.obj-type
     8050     ,input buf_doc-line.obj-code
     8051     ,input buf_doc-line.artic
     8052     ,input buf_doc-line.prod-type
     8053     ,input buf_doc-line.prod-code
     8054     ,input ?
     8055     ,input ''
     8056     ) no-error .
     8057           if error-status :error
     8058           then do:
     8059             message
     8060               vss-workfile vss-revision vss-description skip
     8061               "Ошибка при проверке целостности товара" skip
     8062               "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     8063               "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     8064               error-status :get-message(1) skip
     8065               return-value skip
     8066               view-as alert-box error .
     8067             undo, return error .
     8068           end.
     8069           define variable v-check-cli-qnty as logical no-undo .
     8070           assign
     8071             v-check-cli-qnty = (buf_trn-doc.doc-type = 'при':U
     8072                                 and buf_trn-doc.internal = no
     8073                                 )
     8074           .
     8075           run trg/doclnchk.p
     8076             (input buf_doc-line.doc-code
     8077             ,input buf_doc-line.artic
     8078             ,input buf_doc-line.prod-type
     8079             ,input buf_doc-line.prod-code
     8080             ,input v-check-cli-qnty
     8081             ) no-error .
     8082           if error-status :error
     8083           then do:
     8084             message
     8085               "Проверка строки документа" skip
     8086               "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     8087               "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     8088               error-status :get-message(1) skip
     8089               return-value skip
     8090               view-as alert-box .
     8091             undo, return error .
     8092           end.
     8093         end.
     8094         else do:
     8095           if v-need-check-diff-qnty = true
     8096           then do:
     8097             define variable v-diff-qnty as decimal   no-undo .
     8098             assign
     8099               v-diff-qnty = v-chg-qnty - (v-chg-free-qnty + v-chg-out-qnty)
     8100             .
     8101             if v-diff-qnty <> 0
     8102             then do:
     8103               message
     8104                 "Нужно создать партии с общим количеством" v-chg-qnty skip
     8105                 "Недостающее количество" v-diff-qnty skip
     8106                 view-as alert-box information .
     8107               undo, return error .
     8108             end.
     8109           end.
     8110         end.
     8111         if v-reserv-pl-code = true
     8112           and v-is-petrol = true
     8113           and v-is-pieces = false
     8114         then do:
     8115   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_corinvln in g#lib-trn3
     8116   ( input  buf_doc-line.doc-code
     8117    ,input  buf_doc-line.artic
     8118    ,input  buf_doc-line.prod-type
     8119    ,input  buf_doc-line.prod-code
     8120    ,input  0
     8121    ,input  0
     8122    ,input  buf_doc-line.price-rubl / buf_doc-line.fact-density
     8123    ,input  buf_doc-line.price-base / buf_doc-line.fact-density
     8124    ,input  v-fact-qnty-cli
     8125    ,input  buf_doc-line.fact-density
     8126    ,output v-inv-rec
     8127    ) no-error.
     8128           if error-status :error
     8129             or v-inv-rec = ?
     8130           then do:
     8131             undo, return error return-value .
     8132           end.
     8133        end.
     8134        end.
     8135     end.
     8136   END PROCEDURE.
     8137   PROCEDURE show-contract-code :
     8138     define buffer buf_contract for ub.contract .
     8139     define variable v-host-code as integer   no-undo .
     8140     if available parts
     8141     then do:
     8142       if parts.contract-code = 0
     8143       then do:
     8144         message
     8145           "У партии не задан договор" skip
     8146           view-as alert-box information .
     8147       end.
     8148       else do:
     8149         define variable v-recid as recid no-undo .
     8150   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8151   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     8152     (input  parts.obj-type
     8153     ,input  parts.obj-code
     8154     ,output v-host-code
     8155     )  .
     8156         find first buf_contract no-lock
     8157           where buf_contract.host-code     = v-host-code
     8158             and buf_contract.contract-code = parts.contract-code
     8159           no-error .
     8160         if available buf_contract
     8161         then do:
     8162           assign
     8163             v-recid = recid( buf_contract )
     8164           .
     8165           run str/sh-contr.p
     8166             (input  parParentProc
     8167             ,input v-recid
     8168             ) .
     8169         end.
     8170         else do:
     8171           message
     8172             "Договор не найден" skip
     8173             "Код фирмы" v-host-code skip
     8174             "Код договора" parts.contract-code skip
     8175             "Объект" parts.obj-type parts.obj-code skip
     8176             "Артикул" parts.artic parts.prod-type parts.prod-code skip
     8177             "Партия" parts.in-code parts.part-code skip
     8178             "Резерв" parts.out-code skip
     8179             view-as alert-box error .
     8180         end.
     8181       end.
     8182     end.
     8183     apply "entry":u to br-parts in frame Dialog-Frame.
     8184   END PROCEDURE.
     8185   PROCEDURE show-in-code :
     8186     if available parts
     8187     then do:
     8188       run str/showdoc.p
     8189         (input parparentproc
     8190         ,input ub.parts.in-code
     8191         ,input ub.parts.artic
     8192         ,input ub.parts.prod-type
     8193         ,input ub.parts.prod-code
     8194         ,input true
     8195         ).
     8196     end.
     8197     apply "entry":u to br-parts in frame Dialog-Frame.
     8198   END PROCEDURE.
     8199   PROCEDURE show-income-in-code :
     8200     if available parts
     8201     then do:
     8202       run parts-show-income-in-code in this-procedure
     8203         (input recid(parts)
     8204         ) .
     8205       apply "entry":u to br-parts in frame Dialog-Frame.
     8206     end.
     8207   END PROCEDURE.
     8208   PROCEDURE UI-on :
     8209   define input  parameter p-open-query     as logical   no-undo .
     8210   define input  parameter p-find-next      as logical   no-undo .
     8211   define input  parameter p-find-condition as character no-undo .
     8212   define buffer buf_trn-doc for ub.trn-doc .
     8213   find first buf_trn-doc no-lock
     8214     where buf_trn-doc.doc-code = p-doc-code
     8215     no-error .
     8216    define buffer buf_goods for ub.goods .
     8217    find first buf_goods no-lock
     8218      where buf_goods.gds-code = p-gds-code
     8219      .
     8220   define variable v-query-was-opened as logical no-undo .
     8221   assign
     8222     v-query-was-opened = false
     8223   .
     8224   define variable sort-column-phrase as character no-undo .
     8225   run get-sort-column-phrase in this-procedure
     8226     (input  sort-column-name
     8227     ,output sort-column-phrase
     8228     ) .
     8229   assign
     8230     del-list = ""
     8231   .
     8232   disable b-add b-chg b-del b-mark with frame Dialog-Frame.
     8233   define variable v-open-query as logical   no-undo .
     8234   if rs-one-all = 'все':U
     8235   then do:
     8236     define variable lok as logical no-undo .
     8237     define variable v-host-code as integer   no-undo .
     8238   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8239   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     8240     (input  v-obj-type
     8241     ,input  v-obj-code
     8242     ,output v-host-code
     8243     )  .
     8244   define variable vss-include-info64 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8245   do:
     8246     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8247       (input  v-cntxt-db-num
     8248       ,input  v-cntxt-userid
     8249       ,input  0
     8250       ,input  'actn_parts_all':U
     8251       ,input  'firm':U
     8252       ,input  v-host-code
     8253       ,input  '':U
     8254       ,input  0
     8255       ,input  0
     8256       ,input  0
     8257       ,input  0
     8258       ,input  true
     8259       ,output lok
     8260       )  .
     8261   end.
     8262     if not lok
     8263     then do:
     8264       assign
     8265         rs-one-all = 'текущий':U
     8266         rs-one-all :screen-value = rs-one-all
     8267       .
     8268       MESSAGE "Нет права просмотра партий для всех объектов"
     8269       VIEW-AS ALERT-BOX.
     8270     end.
     8271   end.
     8272   case rs-one-all :
     8273     when 'все':U
     8274     then do:
     8275       run ui-on-01 in this-procedure
     8276         (input  p-open-query
     8277         ,input  p-find-next
     8278         ,input  p-find-condition
     8279         ,input  sort-column-phrase
     8280         ,input-output v-query-was-opened
     8281         ,buffer buf_goods
     8282         ,buffer buf_trn-doc
     8283         ) .
     8284     end.
     8285     when 'текущий':U
     8286     then do:
     8287       run ui-on-02 in this-procedure
     8288         (input  p-open-query
     8289         ,input  p-find-next
     8290         ,input  p-find-condition
     8291         ,input  sort-column-phrase
     8292         ,input-output v-query-was-opened
     8293         ,buffer buf_goods
     8294         ,buffer buf_trn-doc
     8295         ) .
     8296     end.
     8297   end.
     8298   if v-query-was-opened = false
     8299   then do:
     8300     assign
     8301       frame Dialog-Frame:title
     8302         = "Артикул : " + buf_goods.artic + "   " + buf_goods.gds-name
     8303         + "   НЕДОПУСТИМОЕ СОЧЕТАНИЕ ПАРАМЕТОВ ОТБОРА ПАРТИЙ "
     8304     .
     8305     run UI-on-empty in this-procedure
     8306       (input  p-open-query
     8307       ,input  p-find-next
     8308       ,input  p-find-condition
     8309       ) .
     8310   end.
     8311   run display-doc-line-info .
     8312   run reposition-query in this-procedure
     8313     (input v-prt-rec
     8314     ).
     8315   END PROCEDURE.
     8316   PROCEDURE ui-on-01 :
     8317     define input  parameter p-open-query     as logical   no-undo .
     8318     define input  parameter p-find-next      as logical   no-undo .
     8319     define input  parameter p-find-condition as character no-undo .
     8320     define input  parameter sort-column-phrase as character no-undo .
     8321     define input-output parameter v-query-was-opened as logical no-undo .
     8322     define parameter buffer buf_goods for ub.goods .
     8323     define parameter buffer buf_trn-doc for ub.trn-doc .
     8324     do
     8325     on error undo, return error return-value
     8326     :
     8327       case rs-parts :
     8328         when 'все':U
     8329         then do:
     8330           assign
     8331             frame Dialog-Frame:title
     8332               = "Артикул : " + buf_goods.artic + "   " + buf_goods.gds-name
     8333               + "   ВСЕ ПАРТИИ"
     8334           .
     8335   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8336   define variable  l-disable-where-66  as logical   no-undo .
     8337   define variable  l-filter-open-66    as logical   .
     8338   define variable  flt-rec-66       as recid     no-undo .
     8339   define variable  filter-name-66      as character no-undo .
     8340   define variable  where-phrase-66     as character no-undo .
     8341   define variable  sort-phrase-66      as character no-undo .
     8342   define variable  where-phrase-rus-66 as character no-undo .
     8343   define variable  sort-phrase-rus-66  as character no-undo .
     8344     run waitfram-show in this-procedure
     8345       (input "ЖДИТЕ ..."
     8346       ).
     8347   run gbl/flt-get.p
     8348     (input filter-point
     8349     ,output flt-rec-66
     8350     ,output filter-name-66
     8351     ,output where-phrase-66
     8352     ,output sort-phrase-66
     8353     ,output where-phrase-rus-66
     8354     ,output sort-phrase-rus-66
     8355     ).
     8356   if p-open-query then do:
     8357       run set-filter-name in this-procedure
     8358         (INPUT filter-name-66
     8359         ) no-error .
     8360     assign
     8361       l-filter-open-66 = false
     8362     .
     8363     if flt-rec-66 <> ?
     8364       or sort-column-phrase > ""
     8365     then do:
     8366       define variable  parameter-2-66 as character no-undo .
     8367       define variable  parameter-3-66 as character no-undo .
     8368       define variable  parameter-4-66 as character no-undo .
     8369       define variable  parameter-5-66 as character no-undo .
     8370       define variable  parameter-6-66 as character no-undo .
     8371       define variable  parameter-7-66 as character no-undo .
     8372         assign
     8373         parameter-3-66 =
     8374                                 "FOR EACH parts"
     8375         parameter-4-66 =
     8376           (
     8377             if ("parts.artic = buf_goods.artic               and parts.prod-type = buf_goods.prod-type               and parts.prod-code = buf_goods.prod-code               and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )              " + " " + where-phrase-66) <> ""
     8378             then                substitute (               ' parts.artic = &1&2&1                and parts.prod-type = &1&3&1               and parts.prod-code = &4               and ( &5 <> true or ( &5 = true and parts.pl-code = &6 ) )              ', chr(34) , buf_goods.artic , buf_goods.prod-type , buf_goods.prod-code , v-reserv-pl-code , v-pl-code )                + " " + where-phrase-66
     8379             else "true"
     8380           )
     8381         parameter-5-66 = (" " + "" + " " + "")
     8382         parameter-6-66 = if sort-phrase-66 = ''
     8383                              then
     8384           (
     8385           " " + "use-index artic" +
     8386             " " + sort-column-phrase +
     8387           " " + "by parts.status_ by parts.rsrv-free desc"
     8388           )
     8389                              else
     8390           (
     8391           " " + "use-index artic" +
     8392             " " + sort-column-phrase +
     8393           " " + sort-phrase-66
     8394           )
     8395         parameter-7-66 =
     8396           " indexed-reposition  "
     8397       .
     8398       do
     8399       on stop undo, leave
     8400       on error undo, leave
     8401       :
     8402         assign
     8403           l-disable-where-66 =
     8404             ("parts.artic = buf_goods.artic               and parts.prod-type = buf_goods.prod-type               and parts.prod-code = buf_goods.prod-code               and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )              " + " " + where-phrase-66 = "")
     8405         .
     8406         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     8407                             ,input query br-parts:handle
     8408                             ,input parameter-3-66
     8409                             ,input parameter-4-66
     8410                             ,input parameter-5-66
     8411                             ,input parameter-6-66
     8412                             ,input parameter-7-66
     8413                             )
     8414         .
     8415         assign
     8416           l-filter-open-66 = true
     8417         .
     8418       end.
     8419       if l-filter-open-66 = false then do:
     8420         message
     8421           "Ошибка при фильтрации / сортировке" skip
     8422           "Будут показаны записи без учета фильтра" skip
     8423           view-as alert-box .
     8424       end.
     8425       else do:
     8426           assign
     8427             v-query-was-opened = true
     8428           .
     8429       end.
     8430     end.
     8431     if l-filter-open-66 = false then do:
     8432       open query br-parts for each parts no-lock
     8433         where parts.artic = buf_goods.artic               and parts.prod-type = buf_goods.prod-type               and parts.prod-code = buf_goods.prod-code               and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )
     8434         use-index artic
     8435         by parts.status_ by parts.rsrv-free desc
     8436         indexed-reposition
     8437     .
     8438         assign
     8439           v-query-was-opened = true
     8440         .
     8441     end.
     8442   end.
     8443   else do:
     8444     assign
     8445       v-prt-rec = recid( parts )
     8446     .
     8447     do
     8448     on stop undo, leave
     8449     on error undo, leave
     8450     :
     8451       if query br-parts:handle:get-buffer-handle(1) = (buffer parts:handle) then do:
     8452         assign
     8453         parameter-2-66 = (if p-find-next then "true":u else "false":u )
     8454         parameter-4-66 =
     8455           "where ":u +                substitute (               ' parts.artic = &1&2&1                and parts.prod-type = &1&3&1               and parts.prod-code = &4               and ( &5 <> true or ( &5 = true and parts.pl-code = &6 ) )              ', chr(34) , buf_goods.artic , buf_goods.prod-type , buf_goods.prod-code , v-reserv-pl-code , v-pl-code )                + " ":u + where-phrase-66 + " ":u + p-find-condition + " " + ""
     8456         parameter-5-66 = "use-index artic"
     8457       .
     8458         run fltopend_fltfindd in this-procedure  (
     8459                             input this-procedure:handle
     8460                             ,input query br-parts:handle
     8461                             ,input rowid(parts)
     8462                             ,input logical(parameter-2-66)
     8463                             ,input no-lock
     8464                             ,input (buffer parts:handle)
     8465                             ,input parameter-4-66
     8466                             ,input parameter-5-66
     8467                             ) no-error.
     8468         .
     8469         assign
     8470           v-prt-rec = integer(return-value)
     8471           v-fltopend-rowid[1] = ?
     8472         .
     8473       end.
     8474       else do:
     8475         assign
     8476         parameter-2-66 = (if p-find-next then "true":u else "false":u )
     8477         parameter-3-66 =  "FOR EACH parts"
     8478         parameter-4-66 =
     8479           (
     8480             if ("parts.artic = buf_goods.artic               and parts.prod-type = buf_goods.prod-type               and parts.prod-code = buf_goods.prod-code               and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )              " + " " + where-phrase-66) <> ""
     8481             then                substitute (               ' parts.artic = &1&2&1                and parts.prod-type = &1&3&1               and parts.prod-code = &4               and ( &5 <> true or ( &5 = true and parts.pl-code = &6 ) )              ', chr(34) , buf_goods.artic , buf_goods.prod-type , buf_goods.prod-code , v-reserv-pl-code , v-pl-code )                + " " + where-phrase-66
     8482             else "true"
     8483           )
     8484         parameter-5-66 = (" " + "" + " " + "" + " " + p-find-condition)
     8485         parameter-6-66 = if sort-phrase-66 = ''
     8486                              then
     8487           (
     8488           " " + "use-index artic" +
     8489             " " + sort-column-phrase +
     8490           " " + "by parts.status_ by parts.rsrv-free desc"
     8491           )
     8492                              else
     8493           (
     8494           " " + "use-index artic" +
     8495             " " + sort-column-phrase +
     8496           " " + sort-phrase-66
     8497           )
     8498         parameter-7-66 =
     8499           " indexed-reposition  "
     8500       .
     8501         run fltopend_fltfindq in this-procedure  (
     8502                             input this-procedure:handle
     8503                             ,input query br-parts:handle
     8504                             ,input logical(parameter-2-66)
     8505                             ,input no-lock
     8506                             ,input parameter-3-66
     8507                             ,input parameter-4-66
     8508                             ,input parameter-5-66
     8509                             ,input parameter-6-66
     8510                             ,input parameter-7-66
     8511                             ,output v-fltopend-rowid
     8512                             ) no-error.
     8513         .
     8514         v-prt-rec = ?.
     8515       end.
     8516       assign
     8517         v-query-was-opened = true
     8518       .
     8519     end.
     8520   end.
     8521     run waitfram-hide in this-procedure .
     8522         end.
     8523         when 'остатки':U
     8524         then do:
     8525           assign
     8526             frame Dialog-Frame:title
     8527               = "Артикул : " + buf_goods.artic + "   " + buf_goods.gds-name
     8528               + "   ФАКТ ОСТАТКИ"
     8529           .
     8530   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8531   define variable  l-disable-where-68  as logical   no-undo .
     8532   define variable  l-filter-open-68    as logical   .
     8533   define variable  flt-rec-68       as recid     no-undo .
     8534   define variable  filter-name-68      as character no-undo .
     8535   define variable  where-phrase-68     as character no-undo .
     8536   define variable  sort-phrase-68      as character no-undo .
     8537   define variable  where-phrase-rus-68 as character no-undo .
     8538   define variable  sort-phrase-rus-68  as character no-undo .
     8539     run waitfram-show in this-procedure
     8540       (input "ЖДИТЕ ..."
     8541       ).
     8542   run gbl/flt-get.p
     8543     (input filter-point
     8544     ,output flt-rec-68
     8545     ,output filter-name-68
     8546     ,output where-phrase-68
     8547     ,output sort-phrase-68
     8548     ,output where-phrase-rus-68
     8549     ,output sort-phrase-rus-68
     8550     ).
     8551   if p-open-query then do:
     8552       run set-filter-name in this-procedure
     8553         (INPUT filter-name-68
     8554         ) no-error .
     8555     assign
     8556       l-filter-open-68 = false
     8557     .
     8558     if flt-rec-68 <> ?
     8559       or sort-column-phrase > ""
     8560     then do:
     8561       define variable  parameter-2-68 as character no-undo .
     8562       define variable  parameter-3-68 as character no-undo .
     8563       define variable  parameter-4-68 as character no-undo .
     8564       define variable  parameter-5-68 as character no-undo .
     8565       define variable  parameter-6-68 as character no-undo .
     8566       define variable  parameter-7-68 as character no-undo .
     8567         assign
     8568         parameter-3-68 =
     8569                                 "FOR EACH parts"
     8570         parameter-4-68 =
     8571           (
     8572             if ("parts.artic = buf_goods.artic             and parts.prod-type = buf_goods.prod-type             and parts.prod-code = buf_goods.prod-code             and parts.rsrv-free = yes             and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )             " + " " + where-phrase-68) <> ""
     8573             then                substitute (               ' parts.artic = &1&2&1                and parts.prod-type = &1&3&1               and parts.prod-code = &4               and parts.rsrv-free = yes               and ( &5 <> true or ( &5 = true and parts.pl-code = &6 ) )              ', chr(34) , buf_goods.artic , buf_goods.prod-type , buf_goods.prod-code , v-reserv-pl-code , v-pl-code )                + " " + where-phrase-68
     8574             else "true"
     8575           )
     8576         parameter-5-68 = (" " + "" + " " + "")
     8577         parameter-6-68 = if sort-phrase-68 = ''
     8578                              then
     8579           (
     8580           " " + " " +
     8581             " " + sort-column-phrase +
     8582           " " + " "
     8583           )
     8584                              else
     8585           (
     8586           " " + " " +
     8587             " " + sort-column-phrase +
     8588           " " + sort-phrase-68
     8589           )
     8590         parameter-7-68 =
     8591           " indexed-reposition  "
     8592       .
     8593       do
     8594       on stop undo, leave
     8595       on error undo, leave
     8596       :
     8597         assign
     8598           l-disable-where-68 =
     8599             ("parts.artic = buf_goods.artic             and parts.prod-type = buf_goods.prod-type             and parts.prod-code = buf_goods.prod-code             and parts.rsrv-free = yes             and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )             " + " " + where-phrase-68 = "")
     8600         .
     8601         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     8602                             ,input query br-parts:handle
     8603                             ,input parameter-3-68
     8604                             ,input parameter-4-68
     8605                             ,input parameter-5-68
     8606                             ,input parameter-6-68
     8607                             ,input parameter-7-68
     8608                             )
     8609         .
     8610         assign
     8611           l-filter-open-68 = true
     8612         .
     8613       end.
     8614       if l-filter-open-68 = false then do:
     8615         message
     8616           "Ошибка при фильтрации / сортировке" skip
     8617           "Будут показаны записи без учета фильтра" skip
