     9967           "Документ не доступен"
     9968           view-as alert-box error .
     9969         undo, return error .
     9970       end.
     9971     end.
     9972   END PROCEDURE.
     9973   procedure partsxls:
     9974   DEFINE VARIABLE chExcelApplication      AS COM-HANDLE no-undo .
     9975   DEFINE VARIABLE chWorkbook              AS COM-HANDLE no-undo .
     9976   DEFINE VARIABLE chWorksheet             AS COM-HANDLE no-undo .
     9977   def var v-ind   as integer   no-undo .
     9978   def var cRow as character no-undo .
     9979   def var cRange  as character no-undo .
     9980   CREATE "Excel.Application" chExcelApplication no-error.
     9981       if error-status :error then do:
     9982           message
     9983           "Ошибка при запуске Excel" skip
     9984           error-status :get-message(1) skip
     9985           view-as alert-box error .
     9986           undo, return error .
     9987       end.
     9988   assign
     9989     chExcelApplication:Visible = false
     9990     chWorkbook = chExcelApplication:Workbooks:Add ()
     9991   .
     9992   assign
     9993     chWorkSheet = chExcelApplication:Sheets:Item (1)
     9994     chExcelApplication:Interactive = false
     9995     chExcelApplication:ScreenUpdating = false
     9996     chWorkSheet:Name = "Партии"
     9997     chWorkSheet:Range ("A1"):Value           = "№ п/п"
     9998     chWorkSheet:Columns ("A":U):ColumnWidth  = 7
     9999     chWorkSheet:Columns ("A":U):NumberFormat = fill ("#", 5) + "0"
    10000     chWorkSheet:Range ("B1"):Value           = "Тип объекта"
    10001     chWorkSheet:Columns ("B":U):ColumnWidth  = 5
    10002     chWorkSheet:Columns ("B":U):NumberFormat = "@"
    10003     chWorkSheet:Range ("C1"):Value           = "Код объекта"
    10004     chWorkSheet:Columns ("C":U):ColumnWidth  = 10
    10005     chWorkSheet:Columns ("C":U):NumberFormat = fill ("0", 9)
    10006     chWorkSheet:Range ("D1"):Value           = "Артикул"
    10007     chWorkSheet:Columns ("D":U):ColumnWidth  = 20
    10008     chWorkSheet:Columns ("D":U):NumberFormat = "@"
    10009     chWorkSheet:Range ("E1"):Value           = "Тип производителя"
    10010     chWorkSheet:Columns ("E":U):ColumnWidth  = 5
    10011     chWorkSheet:Columns ("E":U):NumberFormat = "@"
    10012     chWorkSheet:Range ("F1"):Value           = "Код производителя"
    10013     chWorkSheet:Columns ("F":U):ColumnWidth  = 10
    10014     chWorkSheet:Columns ("F":U):NumberFormat = fill ("0", 9)
    10015     chWorkSheet:Range ("G1"):Value           = "Номер ПН"
    10016     chWorkSheet:Columns ("G":U):ColumnWidth  = 10
    10017     chWorkSheet:Columns ("G":U):NumberFormat = "@"
    10018     chWorkSheet:Range ("H1"):Value           = "Документ"
    10019     chWorkSheet:Columns ("H":U):ColumnWidth  = 10
    10020     chWorkSheet:Columns ("H":U):NumberFormat = "@"
    10021     chWorkSheet:Range ("I1"):Value           = "Код партии"
    10022     chWorkSheet:Columns ("I":U):ColumnWidth  = 5
    10023     chWorkSheet:Columns ("I":U):NumberFormat = "@"
    10024     chWorkSheet:Range ("J1"):Value           = "По док."
    10025     chWorkSheet:Columns ("J":U):ColumnWidth  = 10
    10026     chWorkSheet:Range ("K1"):Value           = "Факт"
    10027     chWorkSheet:Columns ("K":U):ColumnWidth  = 10
    10028     chWorkSheet:Range ("L1"):Value           = "Цена (Б.В.)"
    10029     chWorkSheet:Columns ("L":U):ColumnWidth  = 12
    10030     chWorkSheet:Range ("M1"):Value           = "Цена (руб.)"
    10031     chWorkSheet:Columns ("M":U):ColumnWidth  = 12
    10032     chWorkSheet:Range ("N1"):Value           = "Поставка"
    10033     chWorkSheet:Columns ("N":U):ColumnWidth  = 5
    10034     chWorkSheet:Columns ("N":U):NumberFormat = "@"
    10035     chWorkSheet:Range ("O1"):Value           = "Тип поставщика"
    10036     chWorkSheet:Columns ("O":U):ColumnWidth  = 5
    10037     chWorkSheet:Columns ("O":U):NumberFormat = "@"
    10038     chWorkSheet:Range ("P1"):Value           = "Код поставщика"
    10039     chWorkSheet:Columns ("P":U):ColumnWidth  = 10
    10040     chWorkSheet:Columns ("P":U):NumberFormat = fill ("0", 9)
    10041     chWorkSheet:Range ("Q1"):Value           = "ГТД"
    10042     chWorkSheet:Columns ("Q":U):ColumnWidth  = 10
    10043     chWorkSheet:Columns ("Q":U):NumberFormat = "@"
    10044     chWorkSheet:Range ("R1"):Value           = "Тип приобретения"
    10045     chWorkSheet:Columns ("R":U):ColumnWidth  = 20
    10046     chWorkSheet:Columns ("R":U):NumberFormat = "@"
    10047     chWorkSheet:Range ("S1"):Value           = "Договор"
    10048     chWorkSheet:Columns ("S":U):ColumnWidth  = 20
    10049     chWorkSheet:Columns ("S":U):NumberFormat = "@"
    10050     chWorkSheet:Range ("T1"):Value           = "Годен до"
    10051     chWorkSheet:Columns ("T":U):ColumnWidth  = 20
    10052     chWorkSheet:Columns ("T":U):NumberFormat = "@"
    10053     chWorkSheet:Range ("U1"):Value           = "Складское место"
    10054     chWorkSheet:Columns ("U":U):ColumnWidth  = 20
    10055     chWorkSheet:Columns ("U":U):NumberFormat = "@"
    10056     chWorkSheet:Range ("V1"):Value           = "НДС"
    10057     chWorkSheet:Columns ("V":U):ColumnWidth  = 10
    10058     chWorkSheet:Columns ("V":U):NumberFormat = "@"
    10059     chWorkSheet:Range ("A1:V1"):Font:Bold = TRUE
    10060     chWorkSheet:Range ("A1:V1"):Interior:ColorIndex = 35
    10061     .
    10062   run waitfram-show
    10063     (input "Экспорт в EXCEL. Ждите ..."
    10064     ).
    10065   def var v-rid as recid no-undo .
    10066   assign
    10067     v-rid = recid(parts)
    10068     v-ind = 0
    10069   .
    10070   reposition br-parts to row 1.
    10071   do while available parts
    10072   :
    10073     assign
    10074       v-ind = v-ind + 1
    10075     .
    10076     if (v-ind modulo 10) = 0 then do:
    10077       run waitfram-show
    10078         (input "Экспортировано в EXCEL строк : " + string (v-ind)
    10079         ).
    10080     end.
    10081     assign
    10082       cRow = string (v-ind + 1)
    10083       cRange = "A":U + cRow
    10084       chWorkSheet:Range (cRange):Value = v-ind
    10085       cRange = "B":U + cRow
    10086       chWorkSheet:Range (cRange):Value = parts.obj-type
    10087       cRange = "C":U + cRow
    10088       chWorkSheet:Range (cRange):Value = parts.obj-code
    10089       cRange = "D":U + cRow
    10090       chWorkSheet:Range (cRange):Value = parts.artic
    10091       cRange = "E":U + cRow
    10092       chWorkSheet:Range (cRange):Value = parts.prod-type
    10093       cRange = "F":U + cRow
    10094       chWorkSheet:Range (cRange):Value = parts.prod-code
    10095       cRange = "G":U + cRow
    10096       chWorkSheet:Range (cRange):Value = parts.in-code
    10097       cRange = "H":U + cRow
    10098       chWorkSheet:Range (cRange):Value = parts.out-code
    10099       cRange = "I":U + cRow
    10100       chWorkSheet:Range (cRange):Value = parts.part-code
    10101       cRange = "J":U + cRow
    10102       chWorkSheet:Range (cRange):Value = parts.qnty
    10103       cRange = "K":U + cRow
    10104       chWorkSheet:Range (cRange):Value = parts.fact-qnty
    10105       cRange = "L":U + cRow
    10106       chWorkSheet:Range (cRange):Value = parts.price-base
    10107       cRange = "M":U + cRow
    10108       chWorkSheet:Range (cRange):Value = parts.price-rubl
    10109       cRange = "N":U + cRow
    10110       chWorkSheet:Range (cRange):Value = string(parts.is-supp, "да/нет")
    10111       cRange = "O":U + cRow
    10112       chWorkSheet:Range (cRange):Value = parts.supp-type
    10113       cRange = "P":U + cRow
    10114       chWorkSheet:Range (cRange):Value = parts.supp-code
    10115       cRange = "Q":U + cRow
    10116       chWorkSheet:Range (cRange):Value = parts.cst-code
    10117       cRange = "U":U + cRow
    10118       chWorkSheet:Range (cRange):Value = parts.pl-code
    10119       cRange = "V":U + cRow
    10120       chWorkSheet:Range (cRange):Value = parts.vat-pc
    10121     .
    10122     define variable v-purch-str as character no-undo .
    10123     if parts.last-date <> ?
    10124     then do:
    10125       assign
    10126         cRange = "T":U + cRow
    10127         chWorkSheet:Range (cRange):Value = string(parts.last-date, '99/99/9999':U)
    10128       .
    10129     end.
    10130     get next br-parts .
    10131   end.
    10132   run waitfram-hide in this-procedure .
    10133   assign
    10134     chExcelApplication:Interactive = true
    10135     chExcelApplication:ScreenUpdating = true
    10136     chExcelApplication:Visible = true
    10137   .
    10138   RELEASE OBJECT chWorksheet NO-ERROR.
    10139   RELEASE OBJECT chWorkbook NO-ERROR.
    10140   chExcelApplication :QUIT().
    10141   RELEASE OBJECT  chExcelApplication  NO-ERROR.
    10142   if v-rid <> ? then do:
    10143     reposition br-parts to recid v-rid .
    10144   end.
    10145   end procedure .
    10146   PROCEDURE UI-on-empty :
    10147     define input  parameter p-open-query     as logical   no-undo .
    10148     define input  parameter p-find-next      as logical   no-undo .
    10149     define input  parameter p-find-condition as character no-undo .
    10150     define variable sort-column-phrase as character no-undo .
    10151     define variable v-query-was-opened as logical no-undo .
    10152     define buffer buf_goods for ub.goods .
    10153   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10154   define variable  l-disable-where-82  as logical   no-undo .
    10155   define variable  l-filter-open-82    as logical   .
    10156   define variable  flt-rec-82       as recid     no-undo .
    10157   define variable  filter-name-82      as character no-undo .
    10158   define variable  where-phrase-82     as character no-undo .
    10159   define variable  sort-phrase-82      as character no-undo .
    10160   define variable  where-phrase-rus-82 as character no-undo .
    10161   define variable  sort-phrase-rus-82  as character no-undo .
    10162     run waitfram-show in this-procedure
    10163       (input "ЖДИТЕ ..."
    10164       ).
    10165   run gbl/flt-get.p
    10166     (input filter-point
    10167     ,output flt-rec-82
    10168     ,output filter-name-82
    10169     ,output where-phrase-82
    10170     ,output sort-phrase-82
    10171     ,output where-phrase-rus-82
    10172     ,output sort-phrase-rus-82
    10173     ).
    10174   if p-open-query then do:
    10175       run set-filter-name in this-procedure
    10176         (INPUT filter-name-82
    10177         ) no-error .
    10178     assign
    10179       l-filter-open-82 = false
    10180     .
    10181     if flt-rec-82 <> ?
    10182       or sort-column-phrase > ""
    10183     then do:
    10184       define variable  parameter-2-82 as character no-undo .
    10185       define variable  parameter-3-82 as character no-undo .
    10186       define variable  parameter-4-82 as character no-undo .
    10187       define variable  parameter-5-82 as character no-undo .
    10188       define variable  parameter-6-82 as character no-undo .
    10189       define variable  parameter-7-82 as character no-undo .
    10190         assign
    10191         parameter-3-82 =
    10192                                 "FOR EACH parts"
    10193         parameter-4-82 =
    10194           (
    10195             if ("parts.artic = ''                     and parts.prod-type = ''                     and parts.prod-code = 0                     and parts.obj-type = ''                     and parts.obj-code = 0" + " " + where-phrase-82) <> ""
    10196             then                substitute (               ' parts.artic = &1&&1                and parts.prod-type = &1&&1               and parts.prod-code = 0               and parts.obj-type  = &1&&1               and parts.obj-code  = 0              ', chr(34)  )                 + " " + where-phrase-82
    10197             else "true"
    10198           )
    10199         parameter-5-82 = (" " + "" + " " + "")
    10200         parameter-6-82 = if sort-phrase-82 = ''
    10201                              then
    10202           (
    10203           " " + " " +
    10204             " " + sort-column-phrase +
    10205           " " + " "
    10206           )
    10207                              else
    10208           (
    10209           " " + " " +
    10210             " " + sort-column-phrase +
    10211           " " + sort-phrase-82
    10212           )
    10213         parameter-7-82 =
    10214           " indexed-reposition  "
    10215       .
    10216       do
    10217       on stop undo, leave
    10218       on error undo, leave
    10219       :
    10220         assign
    10221           l-disable-where-82 =
    10222             ("parts.artic = ''                     and parts.prod-type = ''                     and parts.prod-code = 0                     and parts.obj-type = ''                     and parts.obj-code = 0" + " " + where-phrase-82 = "")
    10223         .
    10224         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
    10225                             ,input query br-parts:handle
    10226                             ,input parameter-3-82
    10227                             ,input parameter-4-82
    10228                             ,input parameter-5-82
    10229                             ,input parameter-6-82
    10230                             ,input parameter-7-82
    10231                             )
    10232         .
    10233         assign
    10234           l-filter-open-82 = true
    10235         .
    10236       end.
    10237       if l-filter-open-82 = false then do:
    10238         message
    10239           "Ошибка при фильтрации / сортировке" skip
    10240           "Будут показаны записи без учета фильтра" skip
    10241           view-as alert-box .
    10242       end.
    10243       else do:
    10244           assign
    10245             v-query-was-opened = true
    10246           .
    10247       end.
    10248     end.
    10249     if l-filter-open-82 = false then do:
    10250       open query br-parts for each parts no-lock
    10251         where parts.artic = ''                     and parts.prod-type = ''                     and parts.prod-code = 0                     and parts.obj-type = ''                     and parts.obj-code = 0
    10252         indexed-reposition
    10253     .
    10254         assign
    10255           v-query-was-opened = true
    10256         .
    10257     end.
    10258   end.
    10259   else do:
    10260     assign
    10261       v-prt-rec = recid( parts )
    10262     .
    10263     do
    10264     on stop undo, leave
    10265     on error undo, leave
    10266     :
    10267       if query br-parts:handle:get-buffer-handle(1) = (buffer parts:handle) then do:
    10268         assign
    10269         parameter-2-82 = (if p-find-next then "true":u else "false":u )
    10270         parameter-4-82 =
    10271           "where ":u +                substitute (               ' parts.artic = &1&&1                and parts.prod-type = &1&&1               and parts.prod-code = 0               and parts.obj-type  = &1&&1               and parts.obj-code  = 0              ', chr(34)  )                 + " ":u + where-phrase-82 + " ":u + p-find-condition + " " + ""
    10272         parameter-5-82 = " "
    10273       .
    10274         run fltopend_fltfindd in this-procedure  (
    10275                             input this-procedure:handle
    10276                             ,input query br-parts:handle
    10277                             ,input rowid(parts)
    10278                             ,input logical(parameter-2-82)
    10279                             ,input no-lock
    10280                             ,input (buffer parts:handle)
    10281                             ,input parameter-4-82
    10282                             ,input parameter-5-82
    10283                             ) no-error.
    10284         .
    10285         assign
    10286           v-prt-rec = integer(return-value)
    10287           v-fltopend-rowid[1] = ?
    10288         .
    10289       end.
    10290       else do:
    10291         assign
    10292         parameter-2-82 = (if p-find-next then "true":u else "false":u )
    10293         parameter-3-82 =  "FOR EACH parts"
    10294         parameter-4-82 =
    10295           (
    10296             if ("parts.artic = ''                     and parts.prod-type = ''                     and parts.prod-code = 0                     and parts.obj-type = ''                     and parts.obj-code = 0" + " " + where-phrase-82) <> ""
    10297             then                substitute (               ' parts.artic = &1&&1                and parts.prod-type = &1&&1               and parts.prod-code = 0               and parts.obj-type  = &1&&1               and parts.obj-code  = 0              ', chr(34)  )                 + " " + where-phrase-82
    10298             else "true"
    10299           )
    10300         parameter-5-82 = (" " + "" + " " + "" + " " + p-find-condition)
    10301         parameter-6-82 = if sort-phrase-82 = ''
    10302                              then
    10303           (
    10304           " " + " " +
    10305             " " + sort-column-phrase +
    10306           " " + " "
    10307           )
    10308                              else
    10309           (
    10310           " " + " " +
    10311             " " + sort-column-phrase +
    10312           " " + sort-phrase-82
    10313           )
    10314         parameter-7-82 =
    10315           " indexed-reposition  "
    10316       .
    10317         run fltopend_fltfindq in this-procedure  (
    10318                             input this-procedure:handle
    10319                             ,input query br-parts:handle
    10320                             ,input logical(parameter-2-82)
    10321                             ,input no-lock
    10322                             ,input parameter-3-82
    10323                             ,input parameter-4-82
    10324                             ,input parameter-5-82
    10325                             ,input parameter-6-82
    10326                             ,input parameter-7-82
    10327                             ,output v-fltopend-rowid
    10328                             ) no-error.
    10329         .
    10330         v-prt-rec = ?.
    10331       end.
    10332       assign
    10333         v-query-was-opened = true
    10334       .
    10335     end.
    10336   end.
    10337     run waitfram-hide in this-procedure .
    10338   END PROCEDURE.
    10339   FUNCTION get-contract-prn-code RETURNS CHARACTER
    10340     ( input p-recid as recid  ) :
    10341     define buffer buf_parts for ub.parts  .
    10342     find first buf_parts no-lock where recid(buf_parts) = p-recid no-error .
    10343     if error-status :error then return "".
    10344     define variable v-contract-prn-code-str as character no-undo .
    10345     run contract-code-to-str in this-procedure
    10346       (input  buf_parts.contract-code
    10347       ,input  buf_parts.obj-type
    10348       ,input  buf_parts.obj-code
    10349       ,output v-contract-prn-code-str
    10350       ) .
    10351     return v-contract-prn-code-str .
    10352   END FUNCTION.
    10353   FUNCTION get-country-name RETURNS CHARACTER
    10354     ( BUFFER buf_parts FOR parts ) :
    10355     define variable v-country-name as character no-undo .
    10356     run proc-get-country-name in this-procedure
    10357       (buffer buf_parts
    10358       ,output v-country-name
    10359       ) .
    10360     return v-country-name .
    10361   END FUNCTION.
    10362   FUNCTION get-mark RETURNS CHARACTER
    10363     ( BUFFER buf_parts FOR parts ) :
    10364     if lookup(string (recid (buf_parts)), del-list) > 0
    10365     then do:
    10366       return "*".
    10367     end.
    10368     return "".
    10369   END FUNCTION.
    10370   FUNCTION get-purch-code RETURNS CHARACTER
    10371     ( BUFFER buf_parts FOR parts ) :
    10372     define variable v-purch-code-str as character no-undo .
    10373     run purch-code-to-str in this-procedure
    10374       (input  buf_parts.purch-code
    10375       ,output v-purch-code-str
    10376       ) .
    10377     return v-purch-code-str .
    10378   END FUNCTION.
