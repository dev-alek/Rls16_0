     6316                           INPUT 'mark-type':U,
     6317                           OUTPUT v-marking-value,
     6318                           OUTPUT v-marking-type
     6319                           ).
     6320   if not error-status:error and v-marking-value <> "" then
     6321     v-marking = true .
     6322       define variable v-alcohol-value as character no-undo .
