        1   DEFINE TEMP-TABLE tt-temp NO-UNDO LIKE ub.tmp-sale
        2          field artic         as character
        3          field prod-code     as integer
        4          field prod-type     as character
        5          field gds-name      as character
        6          field gds-code      as integer
        7          field trn-doc-code  as char
        8          field trn-doc-type  as character
        9          field trn-fact-date as date
       10          field contract-code as integer
       11          field uslov         as character
       12          field cli-type      as character
       13          field cli-code      as integer
       14          field cli-name      as character
       15          field str           as character
       16          index pi trn-doc-code.
       17   DEFINE TEMP-TABLE tt-trn NO-UNDO LIKE ub.tmp-sale
       18          field trn-doc-code  as char
       19          field trn-doc-type  as character
       20          field trn-fact-date as date
       21          field cli-type      as character
       22          field cli-code      as integer
       23          field cli-name      as character
       24          index pi trn-doc-code.
       25   define input parameter parparentproc as handle no-undo .
       26   define variable vss-revision    as character no-undo init "$Revision$":U .
       27   define variable vss-author      as character no-undo init "$Author$":U .
       28   define variable vss-date        as character no-undo init "$Date$":U .
       29   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       30   define variable vss-archive     as character no-undo init "$Archive$":U .
       31   define variable vss-description as character no-undo init "Проверка корректности БД по ФО и НАКЛ на основе партий".
       32   procedure vss-get-info :
       33     define output parameter p-vss-revision    like vss-revision    no-undo .
       34     define output parameter p-vss-author      like vss-author      no-undo .
       35     define output parameter p-vss-date        like vss-date        no-undo .
       36     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       37     define output parameter p-vss-archive     like vss-archive     no-undo .
       38     define output parameter p-vss-description like vss-description no-undo .
       39     assign
       40       p-vss-revision    = vss-revision
       41       p-vss-author      = vss-author
       42       p-vss-date        = vss-date
       43       p-vss-workfile    = vss-workfile
       44       p-vss-archive     = vss-archive
       45       p-vss-description = vss-description
       46     .
       47   end procedure.
       48   procedure vss-get-parameters :
       49     define output parameter p-vss-parameters as character no-undo .
       50   end procedure.
       51   define new global shared variable g#vssrevis-logger as handle    no-undo .
       52   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       53   define variable v-vssrevis-logger                   as handle    no-undo .
       54   procedure vss-logevent :
       55     define input  parameter p-extra-paramters as character no-undo .
       56     define variable v-vssrevis-parameters as character no-undo .
       57     do
       58     on error undo, return error return-value
       59     :
       60       if  valid-handle(v-vssrevis-logger)
       61       and v-vssrevis-logger :get-signature("logevent") <> ""
       62       then do:
       63         run vss-get-parameters in this-procedure
       64           (output v-vssrevis-parameters
       65           ).
       66         run logevent in v-vssrevis-logger
       67           (input vss-workfile
       68           ,input vss-revision
       69           ,input v-vssrevis-parameters
       70           ,input p-extra-paramters
       71           ).
       72       end.
       73     end.
       74   end procedure.
       75   assign
       76     v-vssrevis-logger = g#vssrevis-logger
       77   .
       78   if  valid-handle(v-vssrevis-logger)
       79   and v-vssrevis-logger :get-signature("logevent") <> ""
       80   then do:
       81     assign
       82       v-vssrevis-logevent = true
       83     .
       84     run vss-logevent in this-procedure (input vss-description) .
       85   end.
       86   define new global shared variable g#language as character no-undo .
       87   if g#language <> '' and g#language <> 'rus':U then do:
       88     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       89   end.
       90   procedure proc-alt-shift-f2:
       91     if not ibs.th.gbl.gbl-var:rcode
       92   then
       93     run gbl\inidebug.p .
       94   end.
       95   procedure proc-alt-shift-f3:
       96     run gbl/prvssinf.p
       97       ( input this-procedure
       98       ) .
       99   end.
      100   define variable v-inform-launched as logical no-undo initial false .
      101   procedure proc-alt-shift-f4:
      102     define variable v-action as character no-undo .
      103     if v-inform-launched = false then do:
      104       assign
      105         v-inform-launched = true
      106       .
      107       run gbl/d-inform.w
      108         (  input self
      109         ,  input this-procedure
      110         , output v-action
      111         ) no-error .
      112       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      113       assign
      114         v-inform-launched = false
      115       .
      116     end.
      117   end.
      118   procedure proc-alt-f1:
      119     run gbl/corrhelp.p
      120       (input this-procedure
      121       ) .
      122   end .
      123   on alt-shift-f2 anywhere do:
      124     run proc-alt-shift-f2.
      125   end.
      126   on alt-shift-f3 anywhere do:
      127     run proc-alt-shift-f3 in this-procedure .
      128   end.
      129   on alt-shift-f4 anywhere do:
      130     run proc-alt-shift-f4 in this-procedure.
      131   end.
      132   on alt-f1 anywhere do:
      133     run proc-alt-f1 in this-procedure .
      134   end.
      135   define new global shared variable g#library  as handle no-undo .
      136   define new global shared variable g#library2 as handle no-undo .
      137   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138     define variable v-cntxt-db-num        as integer   no-undo .
      139     define variable v-cntxt-userid        as character no-undo .
      140     define variable v-cntxt-level         as character no-undo .
      141     define variable v-cntxt-host-code-obj as integer   no-undo .
      142     define variable v-cntxt-obj-type      as character no-undo .
      143     define variable v-cntxt-obj-code      as integer   no-undo .
      144     define variable v-cntxt-db-num-obj    as integer   no-undo .
      145     define variable v-cntxt-is-admin      as logical   no-undo .
      146   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      147     run mainmenu_getcntxt in parparentproc
      148       (output v-cntxt-db-num
      149       ,output v-cntxt-userid
      150       ,output v-cntxt-level
      151       ,output v-cntxt-host-code-obj
      152       ,output v-cntxt-obj-type
      153       ,output v-cntxt-obj-code
      154       ,output v-cntxt-db-num-obj
      155       ,output v-cntxt-is-admin
      156       ) .
      157   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      158   define variable v-waitfram-action01         as character   no-undo .
      159   define variable v-waitfram-action02         as character   no-undo .
      160   define variable v-waitfram-action03         as character   no-undo .
      161   define variable mWaitFramTextBeg            as character   no-undo.
      162   define variable mWaitFramTextEnd            as character   no-undo.
      163   define variable mWaitFramView               as logical     no-undo.
      164   define variable mWaitProcEvent              as logical     no-undo init yes.
      165   define variable mWaitFramInterval           as integer     no-undo init 1 .
      166   define variable mWaitFramStop               as logical     no-undo.
      167   define variable mWaitFramStopUser           as logical     no-undo.
      168   define variable mWaitFramStopTimeOut        as logical     no-undo.
      169   define variable mWaitFramStartProc          as datetime-tz no-undo.
      170   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      171   define button B-WaitFramStop auto-end-key
      172        label "Стоп"
      173        size 10 by 1 tooltip "Остоновить процесс".
      174   define button B-viewProcInfo
      175        label "Информация"
      176        size 15 by 1 tooltip "Информация о процесс".
      177   define frame waitfram
      178     v-waitfram-action01 format "x(72)" no-label skip
      179     v-waitfram-action02 format "x(72)" no-label skip
      180     v-waitfram-action03 format "x(72)" no-label skip
      181     B-viewProcInfo
      182     B-WaitFramStop at row 4 col 30
      183     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      184     .
      185   define new global shared variable mBatchMode as logical no-undo init ?.
      186   define variable mFramBachModHandle as handle no-undo.
      187   mFramBachModHandle = frame waitfram:handle.
      188   define variable mFameOldVis as logical no-undo.
      189   define variable mVisCUrentVin as logical no-undo.
      190   if session:batch-mode
      191   then
      192      mBatchMode = yes.
      193   if mBatchMode = ? then do:
      194     mVisCUrentVin = current-window:visible.
      195     mFameOldVis = mFramBachModHandle:visible.
      196     mFramBachModHandle:visible  = yes.
      197     mBatchMode = mFramBachModHandle:visible ne yes.
      198     mFramBachModHandle:visible = mFameOldVis.
      199     current-window:visible = mVisCUrentVin.
      200   end.
      201    if  log-manager:logfile-name ne ?
      202     then DO:
      203         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      204         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      205         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      206     end.
      207   on choose of B-WaitFramStop in frame waitfram
      208   do:
      209     mWaitFramStop = yes.
      210     mWaitFramStopUser = yes.
      211   end.
      212   function waitfram-check-timeout returns logical():
      213      define variable vtime as int64 no-undo.
      214      if mWaitFramStopTimeOut
      215      then
      216         return yes.
      217      vtime = ( now - mWaitFramStartProc ) / 1000 .
      218      if     mWaitFramTimeOut ne ?
      219         and mWaitFramTimeOut ne 0
      220         and mWaitFramTimeOut lt vtime
      221      then do:
      222         mWaitFramStopTimeOut = yes.
      223      end.
      224      return mWaitFramStopTimeOut.
      225   end.
      226   procedure waitfram-hide :
      227     if not session:batch-mode
      228     then do
      229     on error undo, return error return-value
      230     :
      231       pause 0 before-hide .
      232       if not mBatchMode then
      233         hide frame waitfram .
      234     if     not mWaitFramView
      235        and mWaitProcEvent
      236     then
      237       process events .
      238     end.
      239   end procedure.
      240   procedure waitfram-show :
      241     define input  parameter p-message as character no-undo .
      242     define variable v-left-margin as integer   no-undo .
      243     if not session:batch-mode
      244     then do
      245     on error undo, return error return-value
      246     :
      247       if length(p-message) <= 70 then do:
      248         assign
      249           v-left-margin = integer((70 - length(p-message)) / 2)
      250         .
      251         assign
      252           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      253         .
      254         assign
      255           v-waitfram-action01 = " "
      256           v-waitfram-action02 = " "
      257                                    + fill(" ", v-left-margin)
      258                                    + p-message
      259           v-waitfram-action03 = " "
      260         .
      261       end.
      262       else do:
      263         define variable vRindex1 as integer no-undo.
      264         define variable vRindex2 as integer no-undo.
      265         vRindex1 = r-index(p-message," ",70).
      266         if vRindex1 = 0
      267         then
      268            vRindex1 = 70.
      269         if length(p-message)  <= vRindex1 + 70 then do:
      270           assign
      271             v-waitfram-action01 = " "
      272             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      273             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      274           .
      275         end.
      276         else do:
      277           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      278           if vRindex2 <= vRindex1
      279           then
      280              vRindex2 = vRindex1 + 70.
      281           assign
      282             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      283             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      284             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      285           .
      286         end.
      287       end.
      288       B-viewProcInfo:visible   in frame waitfram = no.
      289       B-viewProcInfo:sensitive in frame waitfram = no.
      290       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      291       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      292       if  (   mWaitFramView
      293          or  mWaitProcEvent)
      294          and not mBatchMode
      295       then
      296          display
      297             v-waitfram-action01 skip
      298             v-waitfram-action02 skip
      299             v-waitfram-action03 skip
      300          with frame waitfram .
      301       if     mWaitFramView
      302          then do:
      303             if     mWaitFramInterval ne ?
      304                and not mBatchMode
      305             then
      306                wait-for go of frame waitfram pause mWaitFramInterval.
      307          end.
      308          else
      309             if     mWaitProcEvent
      310                and not mBatchMode
      311             then
      312                process events .
      313     end.
      314   end procedure.
      315      procedure waitfram-show-this:
      316         define input  parameter iInterval as int64 no-undo.
      317         define variable vtime as int64 no-undo.
      318         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      319         mWaitFramInterval = iInterval.
      320         run waitfram-show (substitute("&1&2 &3&4" ,
      321                                       mWaitFramTextBeg ,
      322                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      323                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      324                                       mWaitFramTextEnd
      325                                      )
      326                           ).
      327      end.
      328      procedure WaitFramRunPause:
      329         define input  parameter iInterval as dec no-undo.
      330         define variable vStart  as datetime-tz no-undo.
      331         define variable vend    as datetime-tz no-undo.
      332         define variable vint as int64 no-undo.
      333         define variable vOk as logical no-undo.
      334         vStart = now.
      335         vend   = vStart.
      336         publish "WaitFramPause" (iInterval,output vOk).
      337         vend   =  now.
      338         vint = vend - vStart.
      339         vint = iInterval - vint / 1000.
      340         if     not mWaitFramStop
      341            and (   vint > 0
      342                 or (    not vOk
      343                     and iInterval eq ?
      344                     )
      345                 )
      346         then
      347            run waitfram-show-this (iInterval).
      348         vend   =  now.
      349         vint = vend - vStart.
      350         vint = iInterval - vint / 1000.
      351         if     not mWaitFramStop
      352            and vint > 0
      353         then do:
      354            run gbl/pause.p (vint * 1000).
      355         end.
      356         if iInterval ne ?
      357         then
      358            publish "WaitFramStop".
      359         waitfram-check-timeout().
      360      end.
      361      procedure WaitFramWaitFor:
      362         define input  parameter iInterval as dec no-undo.
      363         assign
      364            mWaitFramStartProc   = now
      365            mWaitFramStopUser    = no
      366            mWaitFramStopTimeOut = no
      367         .
      368         block-wait:
      369         do while not mWaitFramStop:
      370            run WaitFramRunPause (iInterval).
      371            if  waitfram-check-timeout()
      372            then do:
      373               leave block-wait.
      374            end.
      375         end.
      376         run waitfram-hide.
      377      end.
      378   procedure waitfram-join :
      379     define input  parameter p-line-1  as character no-undo .
      380     define input  parameter p-line-2  as character no-undo .
      381     define input  parameter p-line-3  as character no-undo .
      382     define output parameter p-message as character no-undo .
      383     do
      384     on error undo, return error return-value
      385     :
      386       assign
      387         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      388                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      389                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      390       .
      391     end.
      392   end procedure.
      393   function waitfram-join-function returns character
      394     (input p-line-1 as character
      395     ,input p-line-2 as character
      396     ,input p-line-3 as character
      397     ).
      398     define variable v-message as character no-undo .
      399     run waitfram-join in this-procedure
      400       (input  p-line-1
      401       ,input  p-line-2
      402       ,input  p-line-3
      403       ,output v-message
      404       ) .
      405     return v-message .
      406   end function .
      407   define variable v-date     as date   no-undo .
      408   define variable v-date2    as date   no-undo .
      409   define variable v-time     as integer no-undo .
      410   define variable v-time2    as integer no-undo .
      411   define variable v-ok as logical no-undo .
      412   DEFINE BUTTON B-Cancel AUTO-END-KEY
      413        LABEL "Выход"
      414        SIZE 15 BY 1.13
      415        BGCOLOR 8 .
      416   DEFINE BUTTON B-fo
      417        LABEL "ФО"
      418        SIZE 15 BY 1.13.
      419   DEFINE BUTTON B-Help
      420        LABEL "&Помощь"
      421        SIZE 15 BY 1.13
      422        BGCOLOR 8 .
      423   DEFINE QUERY BROWSE-3 FOR
      424         tt-temp SCROLLING.
      425   DEFINE QUERY BROWSE-4 FOR
      426         tt-trn SCROLLING.
      427   DEFINE BROWSE BROWSE-3
      428     QUERY BROWSE-3 NO-LOCK DISPLAY
      429         tt-temp.artic           FORMAT "X(16)":U        column-label "артикул"
      430         tt-temp.gds-name        FORMAT "X(20)":U        column-label "Наименование!товара"
      431         tt-temp.trn-doc-type    FORMAT "X(3)":U         column-label "тип!накл"
