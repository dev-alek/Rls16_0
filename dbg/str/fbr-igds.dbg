      855       if frame d-fbr-gds :width + p-change-value >
      856           session :width-chars
      857       then do:
      858         assign
      859           p-change-value = session :width-chars - frame d-fbr-gds :width
      860         .
      861         if p-change-value <= 0
      862         then do:
      863           run diasize_position-resize-button in this-procedure .
      864           return .
      865         end.
      866       end.
      867     end.
