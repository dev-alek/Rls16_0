     1110         :
     1111           assign
     1112             v-object-handle = buf_temp-diasize-handle.handle-value
     1113           .
     1114           if v-object-handle <> v-diasize-resize-button
     1115           then do:
     1116             assign
     1117               v-object-handle :col = v-object-handle :col + p-change-value
     1118               no-error .
     1119             if error-status :error
     1120             or error-status :get-message(1) <> ""
     1121             then do:
     1122               undo move_block, retry move_block .
     1123             end.
     1124           end.
     1125         end.
     1126       end.
     1127       else do:
     1128         for each buf_temp-diasize-handle
     1129         on error undo move_block, retry move_block
     1130         :
     1131           assign
     1132             v-object-handle = buf_temp-diasize-handle.handle-value
     1133           .
     1134           if v-object-handle <> v-diasize-resize-button
     1135           then do:
     1136             assign
     1137               v-object-handle :col = v-object-handle :col + p-change-value
     1138               no-error .
     1139             if error-status :error
     1140             or error-status :get-message(1) <> ""
     1141             then do:
     1142               undo move_block, retry move_block .
     1143             end.
     1144           end.
     1145         end.
     1146         for each buf_temp-browse-handle
     1147           where buf_temp-browse-handle.browse-type = 'width':u
     1148         on error undo move_block, retry move_block
     1149         :
     1150           assign
     1151             buf_temp-browse-handle.browse-handle :width
     1152               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1153             no-error .
     1154           if error-status :error
     1155           or error-status :get-message(1) <> ""
     1156           then do:
     1157             undo move_block, retry move_block .
     1158           end.
     1159         end.
     1160         assign
     1161           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1162           no-error .
     1163         if error-status :error
     1164         or error-status :get-message(1) <> ""
     1165         then do:
     1166           undo move_block, retry move_block.
     1167         end.
     1168         assign
     1169           frame d-fbr-gds :width = frame d-fbr-gds :width + p-change-value
     1170         no-error .
     1171         if error-status :error
     1172         or error-status :get-message(1) <> ""
     1173         then do:
     1174           undo move_block, retry move_block.
     1175         end.
     1176         if frame d-fbr-gds :scrollable = true
     1177         then do:
     1178           assign
     1179             frame d-fbr-gds :virtual-width = frame d-fbr-gds :virtual-width + p-change-value
     1180           no-error .
     1181           if error-status :error
     1182           or error-status :get-message(1) <> ""
     1183           then do:
     1184             undo move_block, retry move_block.
     1185           end.
     1186         end.
     1187       end.
     1188       if p-move-resize
     1189       then do:
     1190         run diasize_position-resize-button in this-procedure .
     1191       end.
     1192       if v-diasize-wndstore = true
     1193       then do:
     1194         if connected("ub") = true
     1195         then do:
     1196           define variable v-cntxt-db-num        as integer   no-undo .
     1197           define variable v-cntxt-userid        as character no-undo .
     1198           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1199                                             , OUTPUT v-cntxt-userid
     1200                                             ) .
     1201           run gbl/wndsizew.p
     1202             (input  v-cntxt-db-num
     1203             ,input  v-cntxt-userid
     1204             ,input  v-diasize-proc-name
     1205             ,input  'width':u
     1206             ,input  string(frame d-fbr-gds :width - v-diasize-orig-frame-width)
     1207             ) .
     1208         end.
     1209       end.
     1210     end.
     1211     assign
     1212       v-diasize-change-size = false
     1213     .
     1214   end procedure.
     1215   procedure diasize_set-width :
     1216     define input  parameter p-new-width  as decimal   no-undo .
     1217     define input  parameter p-move-resize as logical   no-undo .
     1218     do
     1219     on error undo, return error return-value
     1220     :
     1221       run diasize_change-width in this-procedure
     1222         (input  (p-new-width - frame d-fbr-gds :width)
     1223         ,input  p-move-resize
     1224         ) .
     1225     end.
     1226   end procedure.
     1227   procedure diasize_position-resize-button :
     1228     do with frame d-fbr-gds
     1229     :
     1230       hide v-diasize-resize-button .
     1231       assign
     1232         v-diasize-resize-button :row = frame d-fbr-gds :height - v-diasize-resize-button :height
     1233                     - 1
     1234                     - (frame d-fbr-gds :border-bottom-pixels / session :pixels-per-row)
     1235         v-diasize-resize-button :col = frame d-fbr-gds :width - v-diasize-resize-button :width
     1236                     - 1
     1237                     - (frame d-fbr-gds :border-right-pixels / session :pixels-per-column)
     1238       .
     1239       view v-diasize-resize-button .
     1240     end.
     1241   end procedure.
     1242   on alt-right anywhere
     1243   do:
     1244     run diasize_change-width in this-procedure
     1245       (input 1
     1246       ,input true
     1247       ) .
     1248     return no-apply .
     1249   end.
     1250   on alt-left anywhere
     1251   do:
     1252     run diasize_change-width in this-procedure
     1253       (input -1
     1254       ,input true
     1255       ) .
     1256     return no-apply .
     1257   end.
     1258   on alt-down anywhere
     1259   do:
     1260     run diasize_change-height in this-procedure
     1261       (input 1
     1262       ,input true
     1263       ) .
     1264     return no-apply .
     1265   end.
     1266   on alt-up anywhere
     1267   do:
     1268     run diasize_change-height in this-procedure
     1269       (input -1
     1270       ,input true
     1271       ) .
     1272     return no-apply .
     1273   end.
     1274   on alt-enter of frame d-fbr-gds
     1275   do:
     1276     run diasize_maximize in this-procedure
     1277       (input  ?
     1278       ).
     1279     return no-apply .
     1280   end.
     1281   procedure diasize_end-move :
     1282     do
     1283     on error undo, return error return-value
     1284     :
     1285       define variable v-row-delta as decimal   no-undo .
     1286       define variable v-col-delta as decimal   no-undo .
     1287       define variable v-new-row as decimal   no-undo .
     1288       define variable v-new-col as decimal   no-undo .
     1289       assign
     1290         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1291         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1292       .
     1293       assign
     1294         v-row-delta = v-new-row - frame d-fbr-gds :height
     1295         v-col-delta = v-new-col - frame d-fbr-gds :width
     1296       .
     1297       run diasize_change-height in this-procedure
     1298         (input v-row-delta
     1299         ,input true
     1300         ) .
     1301       run diasize_change-width in this-procedure
     1302         (input v-col-delta
     1303         ,input true
     1304         ) .
     1305     end.
     1306   end procedure.
     1307   procedure diasize_maximize :
     1308     define input  parameter p-action as logical   no-undo .
     1309     do
     1310     on error undo, return error return-value
     1311     :
     1312       if p-action = ?
     1313       then do:
     1314         if v-diasize-need-maximize = true
     1315         then do:
     1316           assign
     1317             p-action = true
     1318           .
     1319         end.
     1320         else do:
     1321           assign
     1322             p-action = false
     1323           .
     1324         end.
     1325       end.
     1326       if p-action = true
     1327       then do:
     1328         run diasize_change-height in this-procedure
     1329           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1330               - frame d-fbr-gds :height-chars
     1331           ,input true
     1332           ) .
     1333         run diasize_change-width in this-procedure
     1334           (input session :width-chars
     1335               - frame d-fbr-gds :width-chars
     1336           ,input true
     1337           ) .
     1338         assign
     1339           v-diasize-need-maximize = false
     1340         .
     1341       end.
     1342       else do:
     1343         run diasize_change-width in this-procedure
     1344           (input v-diasize-orig-frame-width
     1345               - frame d-fbr-gds :width-chars
     1346           ,input true
     1347           ) .
     1348         run diasize_change-height in this-procedure
     1349           (input v-diasize-orig-frame-height
     1350               - frame d-fbr-gds :height-chars
     1351           ,input true
     1352           ) .
     1353         assign
     1354           v-diasize-need-maximize = true
     1355         .
     1356       end.
     1357     end.
     1358   end procedure.
     1359   procedure diasize_restore-orig-size :
     1360     do
     1361     on error undo, return error return-value
     1362     :
     1363       assign
     1364         v-diasize-current-frame-width  = frame d-fbr-gds :width
     1365         v-diasize-current-frame-height = frame d-fbr-gds :height
     1366       .
     1367       run diasize_set-height in this-procedure
     1368         (input  v-diasize-orig-frame-height
     1369         ,input  true
     1370         ) .
     1371       run diasize_set-width in this-procedure
     1372         (input  v-diasize-orig-frame-width
     1373         ,input  true
     1374         ) .
     1375     end.
     1376   end procedure.
     1377   procedure diasize_restore-current-size :
     1378     do
     1379     on error undo, return error return-value
     1380     :
     1381       run diasize_set-height in this-procedure
     1382         (input  v-diasize-current-frame-height
     1383         ,input  true
     1384         ) .
     1385       run diasize_set-width in this-procedure
     1386         (input  v-diasize-current-frame-width
     1387         ,input  true
     1388         ) .
     1389     end.
     1390   end procedure.
     1391   procedure diasize_set-browse-handle :
     1392     define input  parameter p-browse-handle as handle   no-undo .
     1393     define buffer buf_temp-browse-handle for temp-browse-handle .
     1394     do
     1395     on error undo, return error return-value
     1396     :
     1397       assign
     1398         v-diasize-browse-handle = p-browse-handle
     1399       .
     1400       for each buf_temp-browse-handle
     1401       on error undo, return error return-value
     1402       :
     1403         delete buf_temp-browse-handle .
     1404       end.
     1405     end.
     1406   end procedure.
     1407   procedure diasize_add_browse :
     1408     define input  parameter p-browse-type   as character no-undo .
     1409     define input  parameter p-browse-handle as handle    no-undo .
     1410     define buffer buf_temp-browse-handle for temp-browse-handle .
     1411     do
     1412     on error undo, return error return-value
     1413     :
     1414       assign
     1415         v-diasize-browse-number = v-diasize-browse-number + 1
     1416       .
     1417       create buf_temp-browse-handle .
     1418       assign
     1419         buf_temp-browse-handle.browse-type   = p-browse-type
     1420         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1421         buf_temp-browse-handle.browse-handle = p-browse-handle
     1422       .
     1423     end.
     1424   end procedure.
     1425   procedure diasize_init :
     1426     define variable v-default-value    as logical   no-undo .
     1427     define variable v-restore-saved    as logical   no-undo .
     1428     define variable v-resize-value-str as character no-undo .
     1429     do
     1430     on error undo, return error return-value
     1431     :
     1432       do with frame d-fbr-gds
     1433       :
     1434         assign
     1435           v-diasize-orig-frame-height = frame d-fbr-gds :height
     1436           v-diasize-orig-frame-width  = frame d-fbr-gds :width
     1437           v-diasize-browse-handle     = browse br-fbr-gds :handle
     1438         .
     1439         create button v-diasize-resize-button
     1440         assign
     1441           parent        = frame d-fbr-gds :first-child
     1442           label         = "s"
     1443           height-pixels = 16
     1444           width-pixels  = 16
     1445           visible       = true
     1446           sensitive     = true
     1447           movable       = true
     1448           triggers:
     1449             on end-move persistent run diasize_end-move in this-procedure .
     1450           end triggers.
     1451         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1452         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1453         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1454         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1455         assign
     1456           v-diasize-wndmax = false
     1457         .
     1458         if connected("ub") = true
     1459         then do:
     1460           define variable v-cntxt-db-num        as integer   no-undo .
     1461           define variable v-cntxt-userid        as character no-undo .
     1462           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1463                                             , OUTPUT v-cntxt-userid
     1464                                             ) .
     1465           run gbl/wndpar_r.p
     1466             (input  v-cntxt-db-num
     1467             ,input  v-cntxt-userid
     1468             ,input  'wndmax':U
     1469             ,output v-diasize-wndmax
     1470             ,output v-default-value
     1471             ) .
     1472         end.
     1473         assign
     1474           v-diasize-wndstore = false
     1475         .
     1476         if connected("ub") = true
     1477         then do:
     1478           run gbl/wndpar_r.p
     1479             (input  v-cntxt-db-num
     1480             ,input  v-cntxt-userid
     1481             ,input  'wndstore':U
     1482             ,output v-diasize-wndstore
     1483             ,output v-default-value
     1484             ) .
     1485         end.
     1486         assign
     1487           v-diasize-proc-name = entry(1, program-name(2), '.')
     1488         .
     1489         if v-diasize-wndstore = true
     1490         then do:
     1491           assign
     1492             v-restore-saved = false
     1493           .
     1494           if connected("ub") = true
     1495           then do:
     1496             run gbl/wndsizer.p
     1497               (input  v-cntxt-db-num
     1498               ,input  v-cntxt-userid
     1499               ,input  v-diasize-proc-name
     1500               ,input  'height':u
     1501               ,output v-resize-value-str
     1502               ) .
     1503             if v-resize-value-str <> '':U
     1504             then do:
     1505               run diasize_change-height in this-procedure
     1506                 (input  integer(v-resize-value-str)
     1507                 ,input  true
     1508                 ) .
     1509               assign
     1510                 v-restore-saved = true
     1511               .
     1512             end.
     1513           end.
     1514           if connected("ub") = true
     1515           then do:
     1516             run gbl/wndsizer.p
     1517               (input  v-cntxt-db-num
     1518               ,input  v-cntxt-userid
     1519               ,input  v-diasize-proc-name
     1520               ,input  'width':u
     1521               ,output v-resize-value-str
     1522               ) .
     1523             if v-resize-value-str <> '':U
     1524             then do:
     1525               run diasize_change-width in this-procedure
     1526                 (input  integer(v-resize-value-str)
     1527                 ,input  true
     1528                 ) .
     1529               assign
     1530                 v-restore-saved = true
     1531               .
     1532             end.
     1533           end.
     1534           if v-restore-saved <> true
     1535           then do:
     1536             if v-diasize-wndmax = true
     1537             then do:
     1538               run diasize_maximize in this-procedure
     1539                 (input  true
     1540                 ) .
     1541             end.
     1542           end.
     1543         end.
     1544         else do:
     1545           if v-diasize-wndmax = true
     1546           then do:
     1547             run diasize_maximize in this-procedure
     1548               (input  true
     1549               ) .
     1550           end.
     1551         end.
     1552       end.
     1553     end.
     1554   end procedure.
     1555   procedure diasize_need-full-display :
     1556     define output parameter p-need-full-display as logical   no-undo .
     1557     do
     1558     on error undo, return error return-value
     1559     :
     1560       assign
     1561         p-need-full-display = v-diasize-need-full-display
     1562       .
     1563       assign
     1564         v-diasize-need-full-display = false
     1565       .
     1566     end.
     1567   end procedure.
     1568   procedure get-context :
     1569      define output parameter p-db-num as integer          no-undo.
     1570      define output parameter p-user-id as character        no-undo.
     1571      define variable v-login               as character    no-undo.
     1572      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1573      define buffer buf_user-login  for ub.user-login .
     1574      do
     1575      on error undo, return error
     1576      :
     1577            FIND FIRST buf_sys-ctrl no-lock.
     1578            ASSIGN
     1579               v-login = USERID("ub")
     1580               p-db-num = buf_sys-ctrl.db-num
     1581            .
     1582            FIND FIRST buf_user-login
     1583                 WHERE buf_user-login.db-num = p-db-num
     1584                   AND buf_user-login.user-login = v-login
     1585                 no-lock
     1586                 no-error
     1587                 .
     1588            IF AVAILABLE buf_user-login
     1589            THEN DO:
     1590               assign
     1591                  p-user-id = buf_user-login.user-id
     1592               .
     1593            END.
     1594      end.
     1595   end procedure.
     1596       run diasize_init in this-procedure .
     1597   MAIN-BLOCK:
     1598   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1599      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1600   if session :set-wait-state( "compiler" ) then.
     1601   run fbr-igds-fill-fbr-gds in this-procedure (
     1602         input p-fbr-doc-recid
     1603       , output v-doc-code
     1604   ) no-error.
     1605   if error-status :error
     1606   then do:
     1607       message
     1608            vss-workfile vss-revision vss-description
     1609       skip "Ошибка заполнения списка товаров"
     1610       skip return-value
     1611       skip trim(error-status :get-message(1))
     1612               trim(error-status :get-message(2))
     1613               trim(error-status :get-message(3))
     1614       view-as alert-box error.
     1615       undo, return error .
     1616   end.
     1617   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1618     run mainmenu_getcntxt in p-mainmenu-handle
     1619       (output v-cntxt-db-num
     1620       ,output v-cntxt-userid
     1621       ,output v-cntxt-level
     1622       ,output v-cntxt-host-code-obj
     1623       ,output v-cntxt-obj-type
     1624       ,output v-cntxt-obj-code
     1625       ,output v-cntxt-db-num-obj
     1626       ,output v-cntxt-is-admin
     1627       ) .
     1628   if session :set-wait-state( "" ) then.
     1629   RUN enable_UI.
     1630   frame d-fbr-gds:title = "Информация по товарам. Документ № " + v-doc-code.
     1631   find flt-gds where recid (flt-gds) = p-goods-recid no-lock no-error.
     1632   if available flt-gds then do:
     1633       find first temp_fbr-gds no-lock
     1634            where temp_fbr-gds.artic     = flt-gds.artic
     1635              and temp_fbr-gds.prod-type = flt-gds.prod-type
     1636              and temp_fbr-gds.prod-code = flt-gds.prod-code
     1637       no-error.
     1638     if available temp_fbr-gds then
     1639       reposition br-fbr-gds to recid recid (temp_fbr-gds) no-error.
     1640   end.
     1641   p-goods-recid = ?.
     1642   apply "entry" to br-fbr-gds.
     1643   WAIT-FOR GO OF FRAME d-fbr-gds.
     1644   END.
     1645   RUN disable_UI.
     1646   PROCEDURE disable_UI :
     1647     HIDE FRAME d-fbr-gds.
     1648   END PROCEDURE.
     1649   PROCEDURE enable_UI :
     1650     ENABLE b-exit b-sel b-help br-fbr-gds
     1651         WITH FRAME d-fbr-gds.
     1652     VIEW FRAME d-fbr-gds.
     1653     OPEN QUERY br-fbr-gds FOR EACH temp_fbr-gds no-lock,                                    each goods of temp_fbr-gds no-lock                             by temp_fbr-gds.order-num by temp_fbr-gds.artic.
     1654   END PROCEDURE.
     1655   PROCEDURE fbr-igds-fill-fbr-gds :
     1656   define input  parameter p-fbr-doc-recid as recid        no-undo .
     1657   define output parameter p-doc-code      as character    no-undo .
     1658       define variable serv-code like trn-doc.doc-code no-undo .
     1659       define variable in-code   like trn-doc.doc-code no-undo .
     1660       define variable out-code  like trn-doc.doc-code no-undo .
     1661       define variable par-fbr-ooff as char no-undo .
     1662       define variable par-type     as char no-undo .
     1663       define variable list-marks   as char init ">>,<<,.,=,>,<" no-undo .
     1664       define variable list-orders  as char init "5,4,6,3,2,1"   no-undo .
     1665       define buffer buf_fbr-doc      for fbr-doc .
     1666       define buffer buf_fbr-line     for fbr-line .
     1667       define buffer buf_goods        for goods .
     1668       define buffer buf_doc-line     for doc-line .
     1669       define buffer buf_temp_fbr-gds for temp_fbr-gds .
     1670   do
     1671   for buf_fbr-doc
     1672     , buf_fbr-line
     1673     , buf_goods
     1674     , buf_doc-line
     1675     , buf_temp_fbr-gds
     1676   on error undo, return error
     1677   :
     1678       find first buf_fbr-doc no-lock
     1679            where recid (buf_fbr-doc) = p-fbr-doc-recid
     1680       .
     1681       assign
     1682           p-doc-code = buf_fbr-doc.doc-code
     1683       .
     1684       run gbl/conf-rd.p (
     1685             input "fbr-ooff"
     1686           , input 0
     1687           , input ""
     1688           , input 0
     1689           , input ""
     1690           , input ""
     1691           , input ""
     1692           , input no
     1693           , output par-fbr-ooff
     1694           , output par-type
     1695       ) no-error.
     1696       for each buf_fbr-line no-lock
     1697          where buf_fbr-line.doc-code = buf_fbr-doc.doc-code
     1698       on error undo, return error return-value
     1699       :
     1700           find first buf_temp_fbr-gds
     1701                where buf_temp_fbr-gds.artic     = buf_fbr-line.artic
     1702                  and buf_temp_fbr-gds.prod-type = buf_fbr-line.prod-type
     1703                  and buf_temp_fbr-gds.prod-code = buf_fbr-line.prod-code
     1704           no-error.
     1705           if not available buf_temp_fbr-gds
     1706           then do:
     1707               create buf_temp_fbr-gds.
     1708               assign
     1709                   buf_temp_fbr-gds.artic        = buf_fbr-line.artic
     1710                   buf_temp_fbr-gds.prod-type    = buf_fbr-line.prod-type
     1711                   buf_temp_fbr-gds.prod-code    = buf_fbr-line.prod-code
     1712                   buf_temp_fbr-gds.price-rubl   = buf_fbr-line.price-rubl
     1713                   buf_temp_fbr-gds.sum-rubl     = buf_fbr-line.price-sum-rubl
     1714                   buf_temp_fbr-gds.sum-vat-rubl = buf_fbr-line.price-sum-vat-rubl
     1715               .
     1716           end.
     1717           if buf_fbr-line.trn-type = 'при':U
     1718           then do:
     1719               assign
     1720                   buf_temp_fbr-gds.in-qnty = buf_temp_fbr-gds.in-qnty + buf_fbr-line.fact-qnty
     1721               .
     1722               if not buf_fbr-line.rsrv-qnty = ?
     1723               then do:
     1724                   assign
     1725                       buf_temp_fbr-gds.in-exp = buf_temp_fbr-gds.in-exp + buf_fbr-line.fact-qnty
     1726                   .
     1727               end.
     1728           end.
     1729           else do:
     1730               assign
     1731                   buf_temp_fbr-gds.out-qnty = buf_temp_fbr-gds.out-qnty + buf_fbr-line.fact-qnty
     1732               .
     1733               if buf_fbr-line.rsrv-qnty <> ?
     1734               then do:
     1735                   assign
     1736                       buf_temp_fbr-gds.out-exp = buf_temp_fbr-gds.out-exp + buf_fbr-line.fact-qnty
     1737                   .
     1738               end.
     1739           end.
     1740           assign
     1741               buf_temp_fbr-gds.qnty-mark =
     1742               (if buf_temp_fbr-gds.in-qnty  > 0 and buf_temp_fbr-gds.out-qnty = 0 then ">>" else
     1743               if buf_temp_fbr-gds.out-qnty > 0 and buf_temp_fbr-gds.in-qnty = 0  then "<<" else
     1744               if buf_temp_fbr-gds.in-qnty  = 0 and buf_temp_fbr-gds.out-qnty = 0 then "." else
     1745               if buf_temp_fbr-gds.in-qnty  = buf_temp_fbr-gds.out-qnty           then "=" else
     1746               if buf_temp_fbr-gds.in-qnty  > buf_temp_fbr-gds.out-qnty           then ">" else "<")
     1747               list-marks = ">>,<<,.,=,>,<"
     1748               buf_temp_fbr-gds.order-num = integer (entry (lookup (buf_temp_fbr-gds.qnty-mark, list-marks), list-orders))
     1749           .
     1750           if par-fbr-ooff <> "yes"
     1751           then do:
     1752               if buf_temp_fbr-gds.in-exp > buf_temp_fbr-gds.out-exp
     1753               then do:
     1754                   assign
     1755                       buf_temp_fbr-gds.in-exp = buf_temp_fbr-gds.in-exp - buf_temp_fbr-gds.out-exp
     1756                       buf_temp_fbr-gds.out-exp = 0
     1757                   .
     1758               end.
     1759               else do:
     1760                   assign
     1761                       buf_temp_fbr-gds.out-exp = buf_temp_fbr-gds.out-exp - buf_temp_fbr-gds.in-exp
     1762                       buf_temp_fbr-gds.in-exp = 0
     1763                   .
     1764               end.
     1765           end.
     1766       end.
     1767       assign
     1768           out-code = buf_fbr-doc.doc-code
     1769       .
     1770       run doc-code in this-procedure (
     1771             input "pair":U
     1772           , input v-cntxt-obj-type
     1773           , input v-cntxt-obj-code
     1774           , input out-code
     1775           , output in-code
     1776       ) no-error.
     1777       if error-status:error
     1778       then do:
     1779           message
     1780                    vss-workfile vss-revision vss-description
     1781               skip "Ошибка при генерации номера приходной накладной."
     1782               skip return-value
     1783               skip trim(error-status :get-message(1))
     1784                    trim(error-status :get-message(2))
     1785                    trim(error-status :get-message(3))
     1786           view-as alert-box error.
     1787           undo, return error .
     1788       end.
     1789       run doc-code in this-procedure (
     1790             input "trio":U
     1791           , input v-cntxt-obj-type
     1792           , input v-cntxt-obj-code
     1793           , input in-code
     1794           , output serv-code
     1795       ) no-error.
     1796       if error-status:error
     1797       then do:
     1798           message
     1799                    vss-workfile vss-revision vss-description
     1800               skip "Ошибка при генерации номера накладной расхода."
     1801               skip return-value
     1802               skip trim(error-status :get-message(1))
     1803                    trim(error-status :get-message(2))
     1804                    trim(error-status :get-message(3))
     1805           view-as alert-box error.
     1806           undo, return error .
     1807       end.
     1808       for each buf_temp_fbr-gds no-lock
     1809       on error undo, return error return-value
     1810       :
     1811           find first buf_goods no-lock
     1812                where buf_goods.artic     = buf_temp_fbr-gds.artic
     1813                  and buf_goods.prod-type = buf_temp_fbr-gds.prod-type
     1814                  and buf_goods.prod-code = buf_temp_fbr-gds.prod-code
     1815           .
     1816           if buf_temp_fbr-gds.in-qnty > buf_temp_fbr-gds.out-qnty
     1817           then do:
     1818               find first buf_doc-line no-lock
     1819                    where buf_doc-line.doc-code  = in-code
     1820                      and buf_doc-line.artic     = buf_temp_fbr-gds.artic
     1821                      and buf_doc-line.prod-type = buf_temp_fbr-gds.prod-type
     1822                      and buf_doc-line.prod-code = buf_temp_fbr-gds.prod-code
     1823               no-error.
     1824               if available buf_doc-line
     1825               then do:
     1826                   assign
     1827                       buf_temp_fbr-gds.in-trn      = buf_doc-line.doc-qnty
     1828                       buf_temp_fbr-gds.delta_value = buf_temp_fbr-gds.in-qnty - buf_doc-line.doc-qnty
     1829                       buf_temp_fbr-gds.delta_sum   = buf_temp_fbr-gds.sum-rubl + buf_temp_fbr-gds.sum-vat-rubl - ( buf_doc-line.price-rubl * buf_doc-line.doc-qnty )
     1830                   .
     1831               end.
     1832           end.
     1833           else do:
     1834               if buf_goods.gds-type = 'у':U
     1835               then do:
     1836                   find first buf_doc-line no-lock
     1837                        where buf_doc-line.doc-code  = serv-code
     1838                          and buf_doc-line.artic     = buf_temp_fbr-gds.artic
     1839                          and buf_doc-line.prod-type = buf_temp_fbr-gds.prod-type
     1840                          and buf_doc-line.prod-code = buf_temp_fbr-gds.prod-code
     1841                   no-error.
     1842               end.
     1843               else do:
     1844                   find first buf_doc-line no-lock
     1845                        where buf_doc-line.doc-code  = out-code
     1846                          and buf_doc-line.artic     = buf_temp_fbr-gds.artic
     1847                          and buf_doc-line.prod-type = buf_temp_fbr-gds.prod-type
     1848                          and buf_doc-line.prod-code = buf_temp_fbr-gds.prod-code
     1849                   no-error.
     1850               end.
     1851               if available buf_doc-line
     1852               then do:
     1853                   assign
     1854                       buf_temp_fbr-gds.delta_value = buf_temp_fbr-gds.out-qnty - buf_doc-line.doc-qnty
     1855                       buf_temp_fbr-gds.delta_sum   = buf_temp_fbr-gds.sum-rubl + buf_temp_fbr-gds.sum-vat-rubl - ( buf_doc-line.price-rubl * buf_doc-line.doc-qnty )
     1856                       buf_temp_fbr-gds.out-trn     = buf_doc-line.doc-qnty
     1857                   .
     1858               end.
     1859           end.
     1860       end.
     1861   end.
     1862   END PROCEDURE.
     1863   PROCEDURE get-current-goods-recid :
     1864   do
     1865   on error undo, return error
     1866   :
     1867       if available goods
     1868       then do:
     1869           assign
     1870               gds-rec = recid( goods )
     1871           .
     1872       end.
     1873       else do:
     1874           assign
     1875               gds-rec = ?
     1876           .
     1877       end.
     1878   end.
     1879   END PROCEDURE.
