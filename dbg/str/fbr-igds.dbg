      646           then do:
      647             find first buf_temp-browse-handle
      648               where buf_temp-browse-handle.browse-type   = 'height':u
      649                 and buf_temp-browse-handle.browse-handle = v-object-handle
      650               no-error .
      651             if available buf_temp-browse-handle
