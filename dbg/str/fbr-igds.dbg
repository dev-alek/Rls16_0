      552               frame d-fbr-gds :height = v-frame-height
      553             .
      554             if frame d-fbr-gds :scrollable = true
      555             then do:
      556               assign
      557                 frame d-fbr-gds :virtual-height = v-frame-virtual-height
      558               .
      559             end.
