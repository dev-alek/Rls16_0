      221     define variable v-cntxt-is-admin      as logical   no-undo .
      222   define temp-table temp_fbr-gds no-undo
      223     field artic           like fbr-line.artic
      224     field prod-type       like fbr-line.prod-type
      225     field prod-code       like fbr-line.prod-code
      226     field price-rubl      like fbr-line.price-rubl
      227     field sum-rubl        like fbr-line.price-rubl
      228     field sum-vat-rubl    like fbr-line.price-rubl
      229     field in-qnty         like fbr-line.fact-qnty
      230     field out-qnty        like fbr-line.fact-qnty
      231     field in-exp          like doc-line.fact-qnty
      232     field out-exp         like doc-line.fact-qnty
      233     field in-trn          like doc-line.fact-qnty
      234     field out-trn         like doc-line.fact-qnty
      235     field qnty-mark       as char format "xx"
      236     field order-num       as integer
      237     field delta_value     as decimal
      238     field delta_sum       as decimal
      239     field delta_sum_vat   as decimal
      240     index pi is unique primary artic prod-type prod-code
      241   .
      242   define variable v-doc-code      as character    no-undo.
      243   define variable gds-rec         as recid        no-undo.
      244   def buffer flt-gds for goods.
      245   DEFINE BUTTON b-exit AUTO-END-KEY
      246        LABEL "&Выход "
      247        SIZE 15 BY 1.13 TOOLTIP "Выход из просмотра документа производства по товарам"
      248        BGCOLOR 8 .
      249   DEFINE BUTTON b-help
      250        LABEL "Помо&щь"
      251        SIZE 15 BY 1.13 TOOLTIP "Помощь"
      252        BGCOLOR 8 .
      253   DEFINE BUTTON b-sel AUTO-GO
      254        LABEL "Вы&бор "
      255        SIZE 15 BY 1.13 TOOLTIP "Выбор товара для просмотра документа в режиме ТОВАР"
      256        BGCOLOR 8 .
      257   DEFINE QUERY br-fbr-gds FOR
      258         temp_fbr-gds,
      259         goods SCROLLING.
      260   DEFINE BROWSE br-fbr-gds
      261     QUERY br-fbr-gds DISPLAY
      262   temp_fbr-gds.qnty-mark column-label "<>"
      263   goods.artic
      264   goods.gds-name   format "x(30)"
      265   temp_fbr-gds.in-qnty      format ">>>,>>9.999999"   column-label "Произведено"
      266   temp_fbr-gds.out-qnty     format ">>>,>>9.999999"   column-label "Использовано"
      267   temp_fbr-gds.in-exp       format ">,>>>,>>>.<<<"    column-label "Ожидается!Приход"
      268   temp_fbr-gds.out-exp      format ">,>>>,>>>.<<<"    column-label "Требуется!списать"
      269   temp_fbr-gds.in-trn       format ">,>>>,>>>.<<<"    column-label "Приход!по ПН"
      270   temp_fbr-gds.out-trn      format ">,>>>,>>>.<<<"    column-label "Списано!по НС"
      271   temp_fbr-gds.delta_value  format "->>>,>>9.999999"  column-label "Разница!кол-во"
      272   temp_fbr-gds.delta_sum    format "->,>>9.99999999"  column-label "Разница учет.!цен c НДС"
      273       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.63 BY 19.25.
      274   DEFINE FRAME d-fbr-gds
      275        b-exit AT ROW 1.5 COL 2
      276        b-sel AT ROW 1.5 COL 20
      277        b-help AT ROW 1.5 COL 81
      278        br-fbr-gds AT ROW 2.88 COL 2
      279        SPACE(1.24) SKIP(0.28)
      280       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      281            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      282            TITLE "<insert dialog title>"
      283            DEFAULT-BUTTON b-exit.
      284   ASSIGN
      285          FRAME d-fbr-gds:SCROLLABLE       = FALSE
      286          FRAME d-fbr-gds:HIDDEN           = TRUE.
      287   ON WINDOW-CLOSE OF FRAME d-fbr-gds
      288   DO:
      289     APPLY "END-ERROR":U TO SELF.
      290   END.
      291   ON CHOOSE OF b-sel IN FRAME d-fbr-gds
      292   DO:
      293   p-goods-recid = recid (goods).
      294   END.
      295   ON MOUSE-SELECT-DBLCLICK OF br-fbr-gds IN FRAME d-fbr-gds
      296   DO:
      297   apply "choose" to b-sel in frame d-fbr-gds.
      298   END.
      299   ON RETURN OF br-fbr-gds IN FRAME d-fbr-gds
      300   DO:
      301   apply "choose" to b-sel in frame d-fbr-gds.
      302   END.
      303   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   on F9 of frame d-fbr-gds anywhere do:
      305     run get-current-goods-recid.
      306     if gds-rec = ? then
      307       return no-apply.
      308     run ref/gds-form.w ( input p-mainmenu-handle
      309                         ,input 'ПРОСМОТР':U
      310                         ,input ?
      311                         ,input ?
      312                         ,input ?
      313                         ,input-output gds-rec).
      314     apply "entry" to br-fbr-gds in frame d-fbr-gds.
      315     return no-apply.
      316   end.
      317   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-fbr-gds:PARENT eq ?
      318   THEN FRAME d-fbr-gds:PARENT = ACTIVE-WINDOW.
      319   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   on help of frame d-fbr-gds
      321   do:
      322     run gbl/app_help.p
      323       (input this-procedure :file-name
      324       ,input ''
      325       ,input ?
      326       ) no-error.
      327     if error-status :error then do:
      328       message
      329         "Ошибка при вызове помощи"
      330         error-status :get-message(1)
      331         view-as alert-box .
      332     end.
      333   end.
      334   run minbtn-set in this-procedure .
      335   on choose of b-help in frame d-fbr-gds
      336   do:
      337     apply "help":u to frame d-fbr-gds .
      338   end.
      339   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340   procedure minbtn-set :
      341       do
      342           on error undo, return error return-value
      343           :
      344           define variable ii              as integer       no-undo .
      345           define variable fh              as widget-handle no-undo .
      346           define variable hh              as widget-handle no-undo .
      347           define variable v-h             as handle        extent 4 no-undo .
      348           define variable v-name-button   as character     no-undo .
      349           define variable v-help-old-x    as decimal       no-undo .
      350           define variable v-help-old-y    as decimal       no-undo .
      351           define variable v-help-old-size as decimal       no-undo .
      352           define variable v-frame-width   as decimal       no-undo .
      353           define variable jj              as integer       no-undo .
      354           do
      355               on error undo, return error
      356               :
      357               assign
      358                   v-frame-width = frame d-fbr-gds:width - 0.3
      359                   fh            = frame d-fbr-gds:first-child
      360                   hh            = fh:first-child
      361                   ii            = 1
      362                   .
      363               do while valid-handle(hh):
      364                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      365                   do:
      366                       case lc(hh:name) :
      367                           when "b-help" then
      368                               do:
      369                                   hh:load-image-up("cmp/b-help.bmp":u) .
      370                                   hh:load-image-down("cmp/b-help.bmp":u) .
      371                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      372                                   hh:TOOLTIP = "Помощь" .
      373                                   v-help-old-x = hh:column .
      374                                   v-help-old-y = hh:row    .
      375                                   v-help-old-size = hh:width .
      376                                   hh:width-chars = 2.5 .
      377                               end.
      378                           when "b-print" then
      379                               do:
      380                                   hh:load-image("cmp/b-print.bmp":u) .
      381                                   hh:TOOLTIP = "Печать" .
      382                                   v-h[ii] = hh:handle .
      383                                   ii = ii + 1 .
      384                                   hh:width-chars = 3 .
      385                               end.
      386                           when "b-history" or
      387                           when "b-hist" then
      388                               do:
      389                                   hh:load-image("cmp/b-hist.bmp":u) .
      390                                   hh:TOOLTIP = "История" .
      391                                   v-h[ii] = hh:handle .
      392                                   ii = ii + 1 .
      393                                   hh:width-chars = 3 .
      394                               end.
      395                           when "b-sch" then
      396                               do:
      397                                   hh:load-image("cmp/b-sch.bmp":u) .
      398                                   hh:TOOLTIP = "Установка Фильтра" .
      399                                   v-h[ii] = hh:handle .
      400                                   ii = ii + 1 .
      401                                   hh:width-chars = 3 .
      402                               end.
      403                           when "b-hist-user" then
      404                               do:
      405                                   hh:load-image("cmp/b-hist.bmp":u) .
      406                                   hh:TOOLTIP = "История пользователя" .
      407                                   ii = ii + 1 .
      408                               end.
      409                       end case.
      410                   end.
      411                   hh = hh:next-sibling.
      412               end.
      413               b-help:column = v-frame-width - b-help:width-chars.
      414               jj = 0.
      415               repeat ii = 4 to 1 by -1 :
      416                   if valid-handle (v-h[ii] ) then
      417                   do:
      418                       jj  = jj + 1 .
      419                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      420                       v-h[ii]:row    = v-help-old-y .
      421                   end.
      422               end.
      423           end.
      424       end.
      425   end procedure.
      426   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      427   define variable v-diasize-need-maximize        as logical   no-undo init true  .
