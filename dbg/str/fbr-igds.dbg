      816             ,input  v-cntxt-userid
      817             ,input  v-diasize-proc-name
      818             ,input  'height':u
      819             ,input  string(frame d-fbr-gds :height - v-diasize-orig-frame-height)
      820             ) .
      821         end.
      822       end.
      823     end.
      824     assign
      825       v-diasize-change-size = false
      826     .
      827   end procedure.
      828   procedure diasize_set-height :
      829     define input  parameter p-new-height  as decimal   no-undo .
      830     define input  parameter p-move-resize as logical   no-undo .
      831     do
      832     on error undo, return error return-value
      833     :
      834       run diasize_change-height in this-procedure
      835         (input  (p-new-height - frame d-fbr-gds :height)
      836         ,input  p-move-resize
      837         ) .
      838     end.
      839   end procedure.
      840   procedure diasize_change-width :
      841     define input  parameter p-change-value as decimal   no-undo .
      842     define input  parameter p-move-resize  as logical   no-undo .
      843     define variable v-field-group-handle   as handle    no-undo .
      844     define variable v-object-handle        as handle    no-undo .
