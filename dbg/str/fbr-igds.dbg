      452   .
      453   procedure diasize_change-height :
      454     define input  parameter p-change-value  as decimal   no-undo .
      455     define input  parameter p-move-resize   as logical   no-undo .
      456     define variable v-field-group-handle    as handle    no-undo .
      457     define variable v-object-handle         as handle    no-undo .
      458     define variable v-frame-height          as decimal   no-undo .
      459     define variable v-frame-virtual-height  as decimal   no-undo .
      460     define variable v-browse-height         as decimal   no-undo .
      461     define variable v-window-height         as decimal   no-undo .
      462     define variable v-window-virtual-height as decimal   no-undo .
      463     define variable v-change-sign           as integer   no-undo .
      464     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      465     define buffer buf_temp-browse-handle  for temp-browse-handle .
      466     if p-change-value > 0
      467     then do:
      468       if frame d-fbr-gds :height + p-change-value
      469           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      470       then do:
      471         assign
      472           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      473                           - (frame d-fbr-gds :height-chars)
      474         .
      475         if p-change-value <= 0
      476         then do:
      477           run diasize_position-resize-button in this-procedure .
      478           return .
      479         end.
      480       end.
      481     end.
      482     if p-change-value < 0
      483     then do:
      484       if frame d-fbr-gds :height + p-change-value < v-diasize-orig-frame-height
      485       then do:
      486         assign
      487           p-change-value = v-diasize-orig-frame-height
      488                          - (frame d-fbr-gds :height-chars)
      489         .
      490         if p-change-value >= 0
      491         then do:
      492           run diasize_position-resize-button in this-procedure .
      493           return .
      494         end.
      495       end.
      496     end.
      497     if p-change-value >= 0
      498     then do:
      499       assign
      500         v-change-sign = 1
      501       .
      502     end.
      503     else do:
      504       assign
      505         v-change-sign = -1
      506       .
      507     end.
      508     assign
      509       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      510     .
      511     if p-change-value = 0
      512     then do:
      513       run diasize_position-resize-button in this-procedure .
      514       return .
      515     end.
      516     move_block:
      517     do
      518     on error undo move_block, retry move_block
      519     :
      520       if retry
      521       then do:
      522         do
      523         on error undo move_block, leave move_block
      524         :
      525           if p-change-value > 0
      526           then do:
      527             for each buf_temp-diasize-handle
      528             on error undo, next
      529             :
      530               assign
      531                 v-object-handle = buf_temp-diasize-handle.handle-value
      532               .
      533               if v-object-handle <> v-diasize-resize-button
      534               then do:
      535                 assign
      536                   v-object-handle :row = buf_temp-diasize-handle.save-position
      537                 .
      538               end.
      539             end.
      540             assign
      541               v-diasize-browse-handle :height = v-browse-height
      542             .
      543             for each buf_temp-browse-handle
      544               where buf_temp-browse-handle.browse-type = 'height':u
      545             on error undo, next
      546             :
      547               assign
      548                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      549               .
      550             end.
