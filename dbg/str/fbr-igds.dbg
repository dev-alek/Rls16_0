      871       then do:
      872         assign
      873           p-change-value = v-diasize-orig-frame-width
      874                          - frame d-fbr-gds :width
      875         .
      876         if p-change-value >= 0
      877         then do:
      878           run diasize_position-resize-button in this-procedure .
      879           return .
      880         end.
      881       end.
      882     end.
      883     if p-change-value >= 0
      884     then do:
