        1   define input parameter p-mainmenu-handle    as handle           no-undo.
        2   define input parameter p-fbr-doc-recid      as recid            no-undo.
        3   define input-output parameter p-goods-recid as recid            no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Просмотр документа производства по товарам".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure doc-code:
       72   define input  parameter parmode          as   character           no-undo.
       73   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
       74   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
       75   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
       76   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
       77   define buffer buf_sys-ctrl for ub.sys-ctrl  .
       78   define variable vardb-remote     as   logical             no-undo.
       79   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
       80   define variable v-delimiter as character no-undo .
       81   do
       82   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       83   :
       84   find first buf_sys-ctrl no-lock .
       85   vardb-remote = buf_sys-ctrl.db-num <> 0 .
       86     CASE parmode:
       87       when "main":u then do:
       88         if vardb-remote then do:
       89           assign
       90             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
       91         end.
       92         else do:
       93           assign
       94             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
       95         end.
       96       end.
       97       when "trio" then do:
       98         assign
       99           pardoc-code = replace (parroot-doc-code, "=", "*").
      100       end.
      101       otherwise do:
      102         assign
      103         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      104         no-error
      105         .
      106         if error-status:error  then do:
      107           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      108                                         ,chr(10)
      109                                         ,parmode
      110                                         ).
      111         end.
      112         if num-entries(parmode) = 1
      113         and parmode <> "chip":U
      114         and parmode <> "chip_s":U
      115         then do:
      116           assign
      117           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      118         end.
      119         else if (lookup("chip":U, parmode) > 0
      120                  or
      121                  lookup("chip_s":U, parmode) > 0) then do:
      122           assign
      123             vartemp-doc-code = parroot-doc-code.
      124           do while true:
      125             if index (vartemp-doc-code , ".") = 0 then
      126               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      127             else
      128               vartemp-doc-code  =
      129               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      130               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      131               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      132             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      133           end.
      134           assign
      135             pardoc-code = vartemp-doc-code.
      136         end.
      137       end.
      138     end CASE.
      139     if pardoc-code = '':U
      140     or (parroot-doc-code <> '':U
      141     and pardoc-code = parroot-doc-code) then do:
      142       undo, return error substitute("Ошибка при генерации номера документа&1"
      143                                     ,chr(10)).
      144     end.
      145   end.
      146   end. // procedure/method
      147   function get-doc-code-int64 returns int64
      148     ( input p-doc-code as character ) :
      149     define variable v-ind              as integer   no-undo .
      150     define variable v-num-entries      as integer   no-undo .
      151     define variable v-doc-code-int64   as int64     no-undo .
      152     define variable v-canonic-doc-code as character no-undo .
      153     assign
      154       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      155       v-canonic-doc-code = p-doc-code
      156     .
      157     do v-ind = 1 to v-num-entries
      158     :
      159       assign
      160         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      161       .
      162     end.
      163     assign
      164       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      165     .
      166     return v-doc-code-int64 .
      167   end. // function/method
      168   procedure proc-alt-shift-f2:
