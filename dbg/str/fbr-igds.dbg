      886         v-change-sign = 1
      887       .
      888     end.
      889     else do:
      890       assign
      891         v-change-sign = -1
      892       .
      893     end.
      894     assign
      895       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      896     .
      897     if p-change-value = 0
      898     then do:
      899       run diasize_position-resize-button in this-procedure .
      900       return .
      901     end.
