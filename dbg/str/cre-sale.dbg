        1   block-level on error undo, throw.
        2   define input parameter parparentproc   as widget-handle no-undo .
        3   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        4   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        5   define input parameter p-mode          as character no-undo .
        6   define input parameter v-silent        as character no-undo .
        7   define input parameter p-shift-mode    as character no-undo .
        8   define input-output parameter p-inkas-code    like ub.inkas.inkas-code no-undo .
        9   define input parameter p-create-status like ub.trn-doc.status_ no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: cre-sale.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: str/cre-sale.p $":U .
       15   define variable vss-description as character no-undo init "Создание продажи".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define new global shared variable g#lib-trn  as handle no-undo .
       86   define new global shared variable g#lib-trn2 as handle no-undo .
       87   define new global shared variable g#lib-trn3 as handle no-undo .
       88   define new global shared variable g#lib-trn4 as handle no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure doc-code:
       91   define input  parameter parmode          as   character           no-undo.
       92   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
       93   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
       94   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
       95   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
       96   define buffer buf_sys-ctrl for ub.sys-ctrl  .
       97   define variable vardb-remote     as   logical             no-undo.
       98   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
       99   define variable v-delimiter as character no-undo .
      100   do
      101   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      102   :
      103   find first buf_sys-ctrl no-lock .
      104   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      105     CASE parmode:
      106       when "main":u then do:
      107         if vardb-remote then do:
      108           assign
      109             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      110         end.
      111         else do:
      112           assign
      113             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      114         end.
      115       end.
      116       when "trio" then do:
      117         assign
      118           pardoc-code = replace (parroot-doc-code, "=", "*").
      119       end.
      120       otherwise do:
      121         assign
      122         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      123         no-error
      124         .
      125         if error-status:error  then do:
      126           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      127                                         ,chr(10)
      128                                         ,parmode
      129                                         ).
      130         end.
      131         if num-entries(parmode) = 1
      132         and parmode <> "chip":U
      133         and parmode <> "chip_s":U
      134         then do:
      135           assign
      136           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      137         end.
      138         else if (lookup("chip":U, parmode) > 0
      139                  or
      140                  lookup("chip_s":U, parmode) > 0) then do:
      141           assign
      142             vartemp-doc-code = parroot-doc-code.
      143           do while true:
      144             if index (vartemp-doc-code , ".") = 0 then
      145               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      146             else
      147               vartemp-doc-code  =
      148               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      149               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      150               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      151             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      152           end.
      153           assign
      154             pardoc-code = vartemp-doc-code.
      155         end.
      156       end.
      157     end CASE.
      158     if pardoc-code = '':U
      159     or (parroot-doc-code <> '':U
      160     and pardoc-code = parroot-doc-code) then do:
      161       undo, return error substitute("Ошибка при генерации номера документа&1"
      162                                     ,chr(10)).
      163     end.
      164   end.
      165   end. // procedure/method
      166   function get-doc-code-int64 returns int64
      167     ( input p-doc-code as character ) :
      168     define variable v-ind              as integer   no-undo .
      169     define variable v-num-entries      as integer   no-undo .
      170     define variable v-doc-code-int64   as int64     no-undo .
      171     define variable v-canonic-doc-code as character no-undo .
      172     assign
      173       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      174       v-canonic-doc-code = p-doc-code
      175     .
      176     do v-ind = 1 to v-num-entries
      177     :
      178       assign
      179         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      180       .
      181     end.
      182     assign
      183       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      184     .
      185     return v-doc-code-int64 .
      186   end. // function/method
      187   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      188   define variable v-waitfram-action01         as character   no-undo .
      189   define variable v-waitfram-action02         as character   no-undo .
      190   define variable v-waitfram-action03         as character   no-undo .
      191   define variable mWaitFramTextBeg            as character   no-undo.
      192   define variable mWaitFramTextEnd            as character   no-undo.
      193   define variable mWaitFramView               as logical     no-undo.
      194   define variable mWaitProcEvent              as logical     no-undo init yes.
      195   define variable mWaitFramInterval           as integer     no-undo init 1 .
      196   define variable mWaitFramStop               as logical     no-undo.
      197   define variable mWaitFramStopUser           as logical     no-undo.
      198   define variable mWaitFramStopTimeOut        as logical     no-undo.
      199   define variable mWaitFramStartProc          as datetime-tz no-undo.
      200   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      201   define button B-WaitFramStop auto-end-key
      202        label "Стоп"
      203        size 10 by 1 tooltip "Остоновить процесс".
      204   define button B-viewProcInfo
      205        label "Информация"
      206        size 15 by 1 tooltip "Информация о процесс".
      207   define frame waitfram
      208     v-waitfram-action01 format "x(72)" no-label skip
      209     v-waitfram-action02 format "x(72)" no-label skip
      210     v-waitfram-action03 format "x(72)" no-label skip
      211     B-viewProcInfo
      212     B-WaitFramStop at row 4 col 30
      213     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      214     .
      215   define new global shared variable mBatchMode as logical no-undo init ?.
      216   define variable mFramBachModHandle as handle no-undo.
      217   mFramBachModHandle = frame waitfram:handle.
      218   define variable mFameOldVis as logical no-undo.
      219   define variable mVisCUrentVin as logical no-undo.
      220   if session:batch-mode
      221   then
      222      mBatchMode = yes.
      223   if mBatchMode = ? then do:
      224     mVisCUrentVin = current-window:visible.
      225     mFameOldVis = mFramBachModHandle:visible.
      226     mFramBachModHandle:visible  = yes.
      227     mBatchMode = mFramBachModHandle:visible ne yes.
      228     mFramBachModHandle:visible = mFameOldVis.
      229     current-window:visible = mVisCUrentVin.
      230   end.
      231    if  log-manager:logfile-name ne ?
      232     then DO:
      233         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      234         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      235         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      236     end.
      237   on choose of B-WaitFramStop in frame waitfram
      238   do:
      239     mWaitFramStop = yes.
      240     mWaitFramStopUser = yes.
      241   end.
      242   function waitfram-check-timeout returns logical():
      243      define variable vtime as int64 no-undo.
      244      if mWaitFramStopTimeOut
      245      then
      246         return yes.
      247      vtime = ( now - mWaitFramStartProc ) / 1000 .
      248      if     mWaitFramTimeOut ne ?
      249         and mWaitFramTimeOut ne 0
      250         and mWaitFramTimeOut lt vtime
      251      then do:
      252         mWaitFramStopTimeOut = yes.
      253      end.
      254      return mWaitFramStopTimeOut.
      255   end.
      256   procedure waitfram-hide :
      257     if not session:batch-mode
      258     then do
      259     on error undo, return error return-value
      260     :
      261       pause 0 before-hide .
      262       if not mBatchMode then
      263         hide frame waitfram .
      264     if     not mWaitFramView
      265        and mWaitProcEvent
      266     then
      267       process events .
      268     end.
      269   end procedure.
      270   procedure waitfram-show :
      271     define input  parameter p-message as character no-undo .
      272     define variable v-left-margin as integer   no-undo .
      273     if not session:batch-mode
      274     then do
      275     on error undo, return error return-value
      276     :
      277       if length(p-message) <= 70 then do:
      278         assign
      279           v-left-margin = integer((70 - length(p-message)) / 2)
      280         .
      281         assign
      282           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      283         .
      284         assign
      285           v-waitfram-action01 = " "
      286           v-waitfram-action02 = " "
      287                                    + fill(" ", v-left-margin)
      288                                    + p-message
      289           v-waitfram-action03 = " "
      290         .
      291       end.
      292       else do:
      293         define variable vRindex1 as integer no-undo.
      294         define variable vRindex2 as integer no-undo.
      295         vRindex1 = r-index(p-message," ",70).
      296         if vRindex1 = 0
      297         then
      298            vRindex1 = 70.
      299         if length(p-message)  <= vRindex1 + 70 then do:
      300           assign
      301             v-waitfram-action01 = " "
      302             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      303             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      304           .
      305         end.
      306         else do:
      307           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      308           if vRindex2 <= vRindex1
      309           then
      310              vRindex2 = vRindex1 + 70.
      311           assign
      312             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      313             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      314             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      315           .
      316         end.
      317       end.
      318       B-viewProcInfo:visible   in frame waitfram = no.
      319       B-viewProcInfo:sensitive in frame waitfram = no.
      320       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      321       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      322       if  (   mWaitFramView
      323          or  mWaitProcEvent)
      324          and not mBatchMode
      325       then
      326          display
      327             v-waitfram-action01 skip
      328             v-waitfram-action02 skip
      329             v-waitfram-action03 skip
      330          with frame waitfram .
      331       if     mWaitFramView
      332          then do:
      333             if     mWaitFramInterval ne ?
      334                and not mBatchMode
      335             then
      336                wait-for go of frame waitfram pause mWaitFramInterval.
      337          end.
      338          else
      339             if     mWaitProcEvent
      340                and not mBatchMode
      341             then
      342                process events .
      343     end.
      344   end procedure.
      345      procedure waitfram-show-this:
      346         define input  parameter iInterval as int64 no-undo.
      347         define variable vtime as int64 no-undo.
      348         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      349         mWaitFramInterval = iInterval.
      350         run waitfram-show (substitute("&1&2 &3&4" ,
      351                                       mWaitFramTextBeg ,
      352                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      353                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      354                                       mWaitFramTextEnd
      355                                      )
      356                           ).
      357      end.
      358      procedure WaitFramRunPause:
      359         define input  parameter iInterval as dec no-undo.
      360         define variable vStart  as datetime-tz no-undo.
      361         define variable vend    as datetime-tz no-undo.
      362         define variable vint as int64 no-undo.
      363         define variable vOk as logical no-undo.
      364         vStart = now.
      365         vend   = vStart.
      366         publish "WaitFramPause" (iInterval,output vOk).
      367         vend   =  now.
      368         vint = vend - vStart.
      369         vint = iInterval - vint / 1000.
      370         if     not mWaitFramStop
      371            and (   vint > 0
      372                 or (    not vOk
      373                     and iInterval eq ?
      374                     )
      375                 )
      376         then
      377            run waitfram-show-this (iInterval).
      378         vend   =  now.
      379         vint = vend - vStart.
      380         vint = iInterval - vint / 1000.
      381         if     not mWaitFramStop
      382            and vint > 0
      383         then do:
      384            run gbl/pause.p (vint * 1000).
      385         end.
      386         if iInterval ne ?
      387         then
      388            publish "WaitFramStop".
      389         waitfram-check-timeout().
      390      end.
      391      procedure WaitFramWaitFor:
      392         define input  parameter iInterval as dec no-undo.
      393         assign
      394            mWaitFramStartProc   = now
      395            mWaitFramStopUser    = no
      396            mWaitFramStopTimeOut = no
      397         .
      398         block-wait:
      399         do while not mWaitFramStop:
      400            run WaitFramRunPause (iInterval).
      401            if  waitfram-check-timeout()
      402            then do:
      403               leave block-wait.
      404            end.
      405         end.
      406         run waitfram-hide.
      407      end.
      408   procedure waitfram-join :
      409     define input  parameter p-line-1  as character no-undo .
      410     define input  parameter p-line-2  as character no-undo .
      411     define input  parameter p-line-3  as character no-undo .
      412     define output parameter p-message as character no-undo .
      413     do
      414     on error undo, return error return-value
      415     :
      416       assign
      417         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      418                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      419                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      420       .
      421     end.
      422   end procedure.
      423   function waitfram-join-function returns character
      424     (input p-line-1 as character
      425     ,input p-line-2 as character
      426     ,input p-line-3 as character
      427     ).
      428     define variable v-message as character no-undo .
      429     run waitfram-join in this-procedure
      430       (input  p-line-1
      431       ,input  p-line-2
      432       ,input  p-line-3
      433       ,output v-message
      434       ) .
      435     return v-message .
      436   end function .
      437   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   define new global shared variable g#trdcalib as handle no-undo.
      439   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      440   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      441   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
      442   define variable v-ps as character no-undo .
      443   if available buf_sale-doc then
      444   assign
      445   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
      446                       , chr(4)
      447                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
      448                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      449                       , buf_sale-doc.chk-amount
      450                       , buf_sale-doc.gds-amount
      451                       , buf_sale-doc.tot-lines
      452                       , buf_sale-doc.tot-dtl
      453                       ).
      454   else  do:
      455   assign
      456   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
      457                       , chr(4)
      458                       , '':U
      459                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      460                       , 0
      461                       , 0
      462                       , 0
      463                       , 0
      464                       ).
      465   end.
      466   return v-ps.
      467   END FUNCTION.
      468   FUNCTION get-sale-doc-kind returns character (
      469                                                input p-doc-kind as character
      470                                              , input p-ext-doc-type as character
      471                                              , output p-order as integer
      472                                              , output p-msign as integer
      473                                              , output p-main as logical
      474                                              , output p-in-inkas as logical
      475                                              , output p-dir_ as integer
      476                                              ):
      477   define variable v-doc-kind as character no-undo.
      478   define variable v-type as character no-undo .
      479   define variable v-value as character no-undo .
      480   CASE p-doc-kind:
      481     when 'es':U then do:
      482       assign
      483       p-order = 100
      484       p-msign = 1
      485       p-main = yes
      486       p-in-inkas = yes
      487       p-dir_ = 1
      488       .
      489       return p-ext-doc-type.
      490     end.
      491     when  'rs':U then do:
      492       assign
      493       p-order = 200
      494       p-msign = - 1
      495       p-main = no
      496       p-in-inkas = yes
      497       p-dir_ = - 1
      498       .
      499       return p-ext-doc-type.
      500     end.
      501     when 'rwo':U then do:
      502       assign
      503       p-msign = - 1
      504       p-main = no
      505       p-in-inkas = no
      506       p-order = 300
      507       p-dir_ = 1
      508       .
      509       return 'rwo':U.
      510     end.
      511     when 'trf':U then do:
      512       assign
      513       p-msign = 1
      514       p-main = no
      515       p-in-inkas = no
      516       p-order = 400
      517       p-dir_ = 1
      518       .
      519       return 'trf':U.
      520     end.
      521     when 'swo':U then do:
      522      assign
      523      p-msign = 1
      524      p-main = no
      525      p-in-inkas = no
      526      p-order =  500
      527      p-dir_ = 1
      528      .
      529      return 'swo':U.
      530    end.
      531    when 'vir':U then do:
      532      assign
      533      p-msign = 1
      534      p-main = no
      535      p-in-inkas = no
      536      p-order = 600
      537      p-dir_ = 1
      538      .
      539      return 'vir':U.
      540    end.
      541    when 'itr':U then do:
      542      assign
      543      p-msign = 1
      544      p-main = no
      545      p-in-inkas = no
      546      p-order = -1
      547      p-dir_ = -1
      548      .
      549     return 'itr':U.
      550    end.
      551    when 'ngs':U then do:
      552      assign
      553      p-msign = 1
      554      p-main = no
      555      p-in-inkas = no
      556      p-order = 700
      557      p-dir_ = 1
      558      .
      559      return 'ngs':U.
      560    end.
      561    when 'rgs':U then do:
      562      assign
      563      p-msign = -1
      564      p-main = no
      565      p-in-inkas = no
      566      p-order = 701
      567      p-dir_ = -1
      568      .
      569      return 'rgs':U.
      570    end.
      571    otherwise do:
      572       assign
      573       p-msign = 1
      574       p-main = no
      575       p-in-inkas = no
      576       p-order = -1.
      577       return p-ext-doc-type.
      578     end.
      579   END CASE.
      580   END FUNCTION.
      581   procedure saledoc-create :
      582   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
      583   define input parameter p-host-code like ub.sysconf.host-code no-undo .
      584   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
      585   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
      586   define input parameter p-doc-kind as character no-undo .
      587   define input parameter p-office as character no-undo .
      588   define input parameter p-tpsidoc as logical no-undo .
      589   define input parameter p-alias-type-price as character no-undo .
      590   define input parameter p-price-obj-type as character no-undo .
      591   define input parameter p-price-obj-code as integer no-undo .
      592   define parameter buffer buf_trn-doc for ub.trn-doc.
      593   define variable v-order as integer no-undo.
      594   define variable v-main as logical no-undo .
      595   define variable v-in-inkas as logical no-undo .
      596   define variable v-msign as integer no-undo .
      597   define variable v-dir_ as integer no-undo .
      598   define variable v-trn-doc-code as character no-undo .
      599   define buffer buf_sale-doc for ub.sale-doc.
      600   main-block:
      601   do
      602   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      603   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      604   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      605   :
      606      if available buf_trn-doc then do:
      607        v-trn-doc-code = buf_trn-doc.doc-code.
      608      end.
      609      find first buf_sale-doc where
      610               buf_sale-doc.inkas-code = p-inkas-code
      611           and buf_sale-doc.doc-kind = p-doc-kind
      612           and buf_sale-doc.chr-office = p-office
      613           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
      614           no-error .
      615      if not available buf_sale-doc  then do:
      616         create buf_sale-doc.
      617         assign
      618         buf_sale-doc.inkas-code = p-inkas-code
      619         buf_sale-doc.storage =  'trn-doc':U
      620         buf_sale-doc.host-code = p-host-code
      621         buf_sale-doc.obj-type = p-obj-type
      622         buf_sale-doc.obj-code = p-obj-code
      623         buf_sale-doc.doc-kind  = p-doc-kind
      624         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
      625         buf_sale-doc.chr-office = p-office
      626         buf_sale-doc.doc-code = v-trn-doc-code
      627         .
      628      end.
      629      if available buf_trn-doc then
      630      buffer-copy buf_trn-doc
      631      to buf_sale-doc
      632      .
      633     assign
      634     buf_sale-doc.doc-kind = get-sale-doc-kind (
      635                                                input p-doc-kind
      636                                               ,input buf_sale-doc.ext-doc-type
      637                                               ,output v-order
      638                                               ,output v-msign
      639                                               ,output v-main
      640                                               ,output v-in-inkas
      641                                               ,output v-dir_).
      642     assign
      643     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
      644     buf_sale-doc.main-doc = v-main
      645     buf_sale-doc.in-inkas = v-in-inkas
      646     buf_sale-doc.msign = v-msign
      647     buf_sale-doc.dir = v-dir_
      648     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
      649     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
      650     buf_sale-doc.poss-wro-codes = '':U
      651     buf_sale-doc.chr-office = p-office
      652     buf_sale-doc.tpsidoc = p-tpsidoc
      653     buf_sale-doc.alias-type-price = p-alias-type-price
      654     buf_sale-doc.price-obj-type = (if p-tpsidoc
      655                                    then p-price-obj-type
      656                                    else '':U)
      657     buf_sale-doc.price-obj-code = (if p-tpsidoc
      658                                    then p-price-obj-code
      659                                    else 0)
      660     .
      661     assign
      662     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
      663     no-error.
      664   end.
      665   END.
      666   procedure fbr-saledoc-create :
      667   define input parameter p-inkas-code as character no-undo .
      668   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
      669   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
      670   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
      671   define buffer buf_fbr-doc for ub.fbr-doc.
      672   define buffer buf_trn-doc for ub.trn-doc.
      673   define buffer buf_sale-doc for ub.sale-doc.
      674   define buffer buf2_sale-doc for ub.sale-doc.
      675   define buffer buf2_trn-doc for ub.trn-doc.
      676   define buffer buf_doc-line for ub.doc-line.
      677   define buffer buf_gds-dtl for ub.gds-dtl.
      678   define buffer buf_chk-gds for ub.chk-gds.
      679   define buffer buf_chk-doc for ub.chk-doc.
      680   do
      681   on error undo, return error
      682   :
      683     for each buf_fbr-doc no-lock where
      684           buf_fbr-doc.out-code = p-inkas-code:
      685       for each buf_trn-doc no-lock where
      686             buf_trn-doc.out-code = buf_fbr-doc.doc-code
      687       by buf_trn-doc.fact-order
      688       on error undo, return error:
      689         if buf_trn-doc.ext-doc-type = 'em':U
      690         or buf_trn-doc.ext-doc-type = 'im':U
      691         or buf_trn-doc.ext-doc-type = 'wm':U
      692         or buf_trn-doc.ext-doc-type = 'ev':U
      693         or buf_trn-doc.ext-doc-type = 'iv':U
      694         then do:
      695           find first buf_sale-doc where
      696                   buf_sale-doc.inkas-code = p-inkas-code
      697               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
      698               AND buf_sale-doc.storage  = 'trn-doc':U
      699                   no-error .
      700           if not available buf_sale-doc then do:
      701           create buf_sale-doc.                                                                                             buffer-copy buf_trn-doc                                                                                             to buf_sale-doc.                                                                                                assign                                                                                                                  buf_sale-doc.storage  =  'trn-doc':U                                                                          buf_sale-doc.doc-kind = buf_trn-doc.ext-doc-type                                                                buf_sale-doc.order =  - 1                                                                                          buf_sale-doc.main-doc = no                                                                                             buf_sale-doc.in-inkas = no                                                                                         buf_sale-doc.fbrsale = yes                                                                                         buf_sale-doc.msign = 1                                                                                             buf_sale-doc.filled   = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0                       buf_sale-doc.doc-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf_sale-doc.doc-qnty)                                                          buf_sale-doc.fact-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf_sale-doc.fact-qnty)                                                        buf_sale-doc.inkas-code = p-inkas-code.
      702           end.
      703           if buf_trn-doc.ext-doc-type = 'im':U then do:
      704             assign
      705             v-pri-prvo-doc-qnty = buf_trn-doc.doc-qnty
      706             v-pri-prvo-fact-qnty = buf_trn-doc.fact-qnty
      707             v-pri-prvo-tot-lines = buf_trn-doc.tot-lines
      708             .
      709           end.
      710           for each buf2_trn-doc no-lock where
      711                   buf2_trn-doc.out-code = buf_sale-doc.doc-code:
      712             find first buf2_sale-doc where
      713                     buf2_sale-doc.inkas-code = p-inkas-code
      714                 and buf2_sale-doc.doc-code = buf2_trn-doc.doc-code
      715                 AND buf2_sale-doc.storage = 'trn-doc':U no-error .
      716             if not available buf2_sale-doc then do:
      717               create buf2_sale-doc.                                                                                             buffer-copy buf2_trn-doc                                                                                             to buf2_sale-doc.                                                                                                assign                                                                                                                  buf2_sale-doc.storage  =  'trn-doc':U                                                                          buf2_sale-doc.doc-kind = buf2_trn-doc.ext-doc-type                                                                buf2_sale-doc.order =  - 1                                                                                          buf2_sale-doc.main-doc = no                                                                                             buf2_sale-doc.in-inkas = no                                                                                         buf2_sale-doc.fbrsale = yes                                                                                         buf2_sale-doc.msign = 1                                                                                             buf2_sale-doc.filled   = buf2_sale-doc.fact-qnty <> 0 or buf2_sale-doc.tot-lines <> 0                       buf2_sale-doc.doc-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf2_sale-doc.doc-qnty)                                                          buf2_sale-doc.fact-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf2_sale-doc.fact-qnty)                                                        buf2_sale-doc.inkas-code = p-inkas-code.
      718             end.
      719           end.
      720         end.
      721       end.
      722       find first buf_sale-doc where
      723                 buf_sale-doc.inkas-code = p-inkas-code
      724             AND buf_sale-doc.storage = 'fbr-doc':U
      725             AND buf_sale-doc.doc-code = buf_fbr-doc.doc-code no-error .
      726       if not available buf_sale-doc then do:
      727         create buf_sale-doc.
      728         assign
      729         buf_sale-doc.storage       =  'fbr-doc':U
      730         buf_sale-doc.doc-type      = 'производство':U
      731         buf_sale-doc.doc-code      = buf_fbr-doc.doc-code
      732         buf_sale-doc.ext-doc-type  = 'производство':U
      733         buf_sale-doc.doc-kind      = 'производство':U
      734         buf_sale-doc.obj-type      = buf_fbr-doc.obj-type
      735         buf_sale-doc.obj-code      = buf_fbr-doc.obj-code
      736         buf_sale-doc.cli-type      = buf_fbr-doc.obj-type
      737         buf_sale-doc.cli-code      = buf_fbr-doc.obj-code
      738         buf_sale-doc.doc-qnty      = v-pri-prvo-doc-qnty
      739         buf_sale-doc.fact-qnty     = v-pri-prvo-fact-qnty
      740         buf_sale-doc.tot-lines     = v-pri-prvo-tot-lines
      741         buf_sale-doc.tot-dtl       = v-pri-prvo-tot-lines
      742         buf_sale-doc.fbrsale       = yes
      743         buf_sale-doc.inkas-code    = p-inkas-code
      744         .
      745       end.
      746     end.
      747   end.
      748   end procedure.
      749   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      750   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      751   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      752   procedure cur-time :
      753      define output parameter p-today as date      no-undo .
      754      define output parameter p-time  as integer   no-undo .
      755     do
      756     on error undo, return error
      757     :
      758       define variable v-date1 as date      no-undo .
      759       define variable v-date2 as date      no-undo .
      760       define variable v-time  as integer   no-undo .
      761       assign
      762         v-date1 = today
      763         v-time  = time
      764         v-date2 = today
      765       .
      766       if v-date1 <> v-date2
      767       then do:
      768         assign
      769           v-date1 = today
      770           v-time  = v-time
      771         .
      772       end.
      773       assign
      774         p-today = v-date1
      775         p-time  = v-time
      776       .
      777     end.
      778   end.
      779   function cur-time-date returns character
      780   :
      781     return string(today, '99/99/9999':U) .
      782   end.
      783   function cur-time-mjd returns decimal
      784   :
      785     define variable v-date as date      no-undo .
      786     define variable v-time as integer   no-undo .
      787     run cur-time in this-procedure
      788       (output v-date
      789       ,output v-time
      790       ) .
      791     return integer(v-date) - 2400002 + (v-time / 86400) .
      792   end.
      793   function cur-time-get-ending-index returns integer
      794   (input p-number as integer
      795   )
      796   :
      797     if p-number < 0
      798     or p-number = ?
      799     then do:
      800       return 1 .
      801     end.
      802     define variable v-rest as integer   no-undo .
      803     assign
      804       p-number = p-number modulo 100
      805     .
      806     if p-number < 20
      807     then do:
      808       assign
      809         v-rest = p-number
      810       .
      811     end.
      812     else do:
      813       assign
      814         v-rest = p-number modulo 10
      815       .
      816     end.
      817     case v-rest :
      818       when 1
      819       then do:
      820         return 2 .
      821       end.
      822       when 2 or
      823       when 3 or
      824       when 4
      825       then do:
      826         return 3 .
      827       end.
      828       otherwise do:
      829         return 1 .
      830       end.
      831     end case .
      832   end.
      833   procedure cur-time-mjd-to-date :
      834      define input  parameter i-mjd-diff as decimal no-undo.
      835      define output parameter o-Date     as date    no-undo.
      836      define output parameter o-Time     as integer no-undo.
      837      define variable v-day-number as integer   no-undo .
      838      if    i-mjd-diff < 0
      839         or i-mjd-diff = ?
      840      then do:
      841         return "?" .
      842      end.
      843      assign
      844         v-day-number = truncate(i-mjd-diff,0).
      845         o-Date = date(v-day-number + 2400002).
      846         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      847     .
      848   end.
      849   function cur-time-mjd-to-string returns character
      850   (input p-mjd-diff as decimal
      851   )
      852   :
      853     define variable v-day-number as integer   no-undo .
      854     define variable v-seconds    as integer   no-undo .
      855     define variable v-hour       as integer   no-undo .
      856     define variable v-min        as integer   no-undo .
      857     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      858     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      859     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      860     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      861     if p-mjd-diff < 0
      862     or p-mjd-diff = ?
      863     then do:
      864       return "?" .
      865     end.
      866     assign
      867       v-day-number = integer(truncate(p-mjd-diff,0))
      868       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      869     .
      870     if v-seconds > 86400
      871     then do:
      872       assign
      873         v-seconds = 86400 - 1
      874       .
      875     end.
      876     if v-seconds < 0
      877     then do:
      878       assign
      879         v-seconds = 0
      880       .
      881     end.
      882     assign
      883       v-hour = truncate(v-seconds / 3600, 0)
      884     .
      885     assign
      886       v-seconds = v-seconds modulo 3600
      887     .
      888     assign
      889       v-min = truncate(v-seconds / 60, 0)
      890     .
      891     assign
      892       v-seconds = v-seconds modulo 60
      893     .
      894     return
      895         (if v-day-number <> 0
      896           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      897           else ""
      898         )
      899       + (if v-day-number <> 0 or v-hour <> 0
      900           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      901           else ""
      902         )
      903       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      904           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      905           else ""
      906         )
      907       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      908       .
      909   end.
      910   function cur-time-string returns character
      911   :
      912     define variable v-date as date      no-undo .
      913     define variable v-time as integer   no-undo .
      914     run cur-time in this-procedure
      915       (output v-date
      916       ,output v-time
      917       ) .
      918     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      919   end.
      920   function cur-time-string-sec returns character
      921   :
      922     define variable v-date as date      no-undo .
      923     define variable v-time as integer   no-undo .
      924     run cur-time in this-procedure
      925       (output v-date
      926       ,output v-time
      927       ) .
      928     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      929   end.
      930   function cur-time-custom  returns character
      931   (input p-prefix as character
      932   ,input p-date-format as character
      933   ,input p-delimiter as character
      934   ,input p-time-format as character
      935   ,input p-suffix as character
      936   )
      937   :
      938     define variable v-date as date      no-undo .
      939     define variable v-time as integer   no-undo .
      940     run cur-time in this-procedure
      941       (output v-date
      942       ,output v-time
      943       ) .
      944     return
      945       p-prefix
      946       + string(v-date, p-date-format)
      947       + p-delimiter
      948       + string(v-time, p-time-format)
      949       + p-suffix
      950       .
      951   end.
      952   function cur-time-print  returns character
      953   :
      954     define variable v-date as date      no-undo .
      955     define variable v-time as integer   no-undo .
      956     run cur-time in this-procedure
      957       (output v-date
      958       ,output v-time
      959       ) .
      960     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      961   end.
      962   function cur-time-datetime returns datetime
      963   :
      964     define variable v-char as character no-undo .
      965     define variable v-datetime as datetime no-undo .
      966     v-char = cur-time-string().
      967     v-datetime = datetime(v-char).
      968     return  v-datetime.
      969   end.
      970   function cur-time-string-msec returns character
      971   :
      972     define variable v-date as datetime  no-undo .
      973     v-date = now.
      974     return string(v-date) .
      975   end.
      976   procedure cre-docs.
      977   define input parameter p-auto          as integer no-undo .
      978   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
      979   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
      980   define input parameter p-shift-date    like ub.inkas.shift-date no-undo .
      981   define input parameter p-shift-num     like ub.inkas.shift-num  no-undo .
      982   define input parameter p-filter-name   as character             no-undo .
      983   define input parameter p-filter-str    as character             no-undo .
      984   define input parameter p-filter-str-rus as character            no-undo .
      985   define input parameter p-doc-mode      as character no-undo .
      986   define output parameter p-doc-rec      as recid no-undo.
      987   DEFINE VARIABLE sys-today as date no-undo .
      988   define variable vardoc-code like ub.trn-doc.doc-code no-undo.
