     1415       buf_inkas.fact-date = if l-shift-on then v-shift-date else sys-today
     1416       buf_inkas.office = no
     1417       buf_inkas.shift-num = if l-shift-on
     1418                                 then v-shift-num
     1419                                 else (IF cas-shft
     1420                                       then (if p-auto > 0
     1421                                             then v-shift-num
     1422                                             else 1)
     1423                                       else 0)
     1424       buf_inkas.shift-name = if l-shift-on then v-shift-name else (IF cas-shft then string(1) else '')
     1425       buf_inkas.is-mand-sale-filter = sale-filter
     1426       buf_Inkas.is-auto-born = (p-auto>= 2)
     1427       p-doc-rec         = recid(buf_inkas)
     1428       .
     1429       if v-curr-r-b = 'rubl':U then do:
     1430         assign
     1431         buf_trn-doc.exch-code = 0
     1432         buf_trn-doc.exch-rate = 1
     1433         buf_trn-doc.exch-scale = 1
     1434         buf_trn-doc.print-rubl = yes
     1435         .
     1436       end.
     1437       else do:
     1438         assign
     1439         buf_trn-doc.exch-code = base-code
     1440         buf_trn-doc.exch-rate = buf_trn-doc.base-rate
     1441         buf_trn-doc.exch-scale = buf_trn-doc.base-scale
     1442         buf_trn-doc.print-rubl = no
     1443         .
     1444      end.
     1445       if p-filter-str <> "":U then do:
     1446         assign
     1447         buf_Inkas.sale-filter = p-filter-str
     1448         buf_Inkas.sale-filter-name = p-filter-name
     1449         buf_Inkas.sale-filter-rus = p-filter-str-rus
     1450         .
     1451       end.
     1452       run saledoc-create  in this-procedure (
     1453                                               input buf_trn-doc.doc-code
     1454                                               ,input buf_trn-doc.host-code
     1455                                               ,input buf_trn-doc.obj-type
     1456                                               ,input buf_trn-doc.obj-code
     1457                                               ,input 'es':U
     1458                                               ,input 'т':U
     1459                                               ,input no
     1460                                               ,input '':U
     1461                                               ,input '':U
     1462                                               ,input 0
     1463                                               ,buffer buf_trn-doc
     1464                                               ) no-error .
     1465       if error-status:error then do:
     1466         v-mes = substitute("Ошибка при генерации записи связанного документа для расходной накладной по продаже &4:&1&2 &3"
     1467                           , chr(10)
     1468                           , error-status:get-message(1)
     1469                           , return-value
     1470                           , vardoc-code
     1471                           ).
     1472         undo, return error v-mes.
     1473       end.
     1474   end.
     1475   end procedure.
     1476   DEFINE new SHARED BUFFER    ink-doc FOR ub.inkas.
     1477   DEFINE new SHARED BUFFER    X_trn-doc FOR ub.trn-doc.
     1478   DEFINE new SHARED QUERY     br-docs FOR ink-doc SCROLLING.
     1479   define variable v-doc-rec  as recid no-undo .
     1480   define variable v-host-code   like ub.sysconf.host-code no-undo .
     1481   define variable glog as logical no-undo .
     1482   define variable v-mes as character no-undo .
     1483   DEFINE VARiable v-handle as handle no-undo.
     1484   define variable next-prev as character no-undo .
     1485   define variable v-rid-list as character no-undo .
     1486   define buffer buf_shift-obj for ub.shift-obj.
     1487   do
     1488   on error undo, return error return-value
     1489   :
     1490     if p-mode = 'ПРОСМОТР':U then do:
     1491       FIND FIRST ink-doc WHERE ink-doc.inkas-code = p-inkas-code  NO-LOCK NO-ERROR.
     1492       if not available ink-doc then do:
     1493         v-mes = substitute("Для &1&2 НЕТ незакрытого отчета о продаже &3"
     1494                            ,p-curr-obj-type
     1495                            ,p-curr-obj-code
     1496                            ,p-inkas-code).
     1497         return v-mes.
     1498       end.
     1499       v-doc-rec = recid (ink-doc).
     1500     end.
     1501     else
     1502         do on stop undo, return error
     1503             on end-key undo, return error :
     1504           if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1505             FIND FIRST ink-doc WHERE
     1506                         ink-doc.status_ = 'новый':U
     1507                     and ink-doc.obj-type = p-curr-obj-type
     1508                     and ink-doc.obj-code = p-curr-obj-code no-lock NO-ERROR.
     1509             if available ink-doc then do:
     1510               if v-silent <> "silent":U then do:
     1511                 glog = no.
     1512                 message
     1513                 substitute("Уже есть один незакрытый отчет на объекте &1&2&3" +
     1514                           "дата &4 дата факт.(ожидается)&5,&3Вы уверены что хотите создать еще один?"
     1515                           , p-curr-obj-type
     1516                           , p-curr-obj-code
     1517                           , chr(10)
     1518                           , string(ink-doc.doc-date, "99/99/9999")
     1519                           , string(ink-doc.fact-date, "99/99/9999")
     1520                           )
     1521                 view-as alert-box QUESTION buttons yes-no update glog.
     1522                 if not glog then undo, return error "cancell".
     1523               end.
     1524             end.
     1525             if p-shift-mode = 'ВЫБОР':U
     1526             and v-silent = '':U
     1527             and p-mode = 'ДОБАВЛЕНИЕ':U
     1528             then do:
     1529   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1530   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1531     (input  p-curr-obj-type
     1532     ,input  p-curr-obj-code
     1533     ,output v-host-code
     1534     )  .
     1535   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1536   do:
     1537     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1538       (input  g#db-num
     1539       ,input  g#userid
     1540       ,input  0
     1541       ,input  'actn_sale_create-back-shift':U
     1542       ,input  'object':U
     1543       ,input  v-host-code
     1544       ,input  p-curr-obj-type
     1545       ,input  p-curr-obj-code
     1546       ,input  0
     1547       ,input  0
     1548       ,input  0
     1549       ,input  true
     1550       ,output glog
     1551       )  .
     1552   end.
     1553               if not glog then do:
     1554                 return error "cancell".
     1555               end.
     1556               run str/sht-all.w (
     1557                             input parparentproc
     1558                           , INPUT p-curr-obj-type
     1559                           , input p-curr-obj-code
     1560                           , input 'b-sel'
     1561                           , input 'obj'
     1562                           , INPUT p-curr-obj-type
     1563                           , input p-curr-obj-code
     1564                           , input '':u
     1565                           , input-output v-rid-list) no-error.
     1566                if v-rid-list = '':U then do:
     1567                   return error "cancell".
     1568                end.
     1569                find first buf_shift-obj no-lock where
     1570                         recid(buf_shift-obj) = integer(v-rid-list) .
     1571                if not (buf_shift-obj.obj-type = p-curr-obj-type
     1572                        and
     1573                        buf_shift-obj.obj-code = p-curr-obj-code
     1574                        )
     1575                or not (buf_shift-obj.status_ = 'зкр':U) then do:
     1576                  message
     1577                  substitute("Вы должны Выбрать ЗАКРЫТУЮ смену по &1&2"
     1578                             , p-curr-obj-type
     1579                             , p-curr-obj-code)
     1580                  view-as alert-box error .
     1581                  return error "cancell".
     1582                end.
     1583             end.
     1584             run waitfram-show in this-procedure ("Создание нового отчета о продаже ...").
     1585             RUN cre-docs in this-procedure  (
     1586                                             input (if v-silent = "silent" then 4 else 0)
     1587                                           , input p-curr-obj-type
     1588                                           , input p-curr-obj-code
     1589                                           , input (if available buf_shift-obj
     1590                                                    then buf_shift-obj.shift-date
     1591                                                    else ?)
     1592                                           , input (if available buf_shift-obj
     1593                                                    then buf_shift-obj.shift-num
     1594                                                    else ?)
     1595                                           , input "":U
     1596                                           , input "":U
     1597                                           , input "":U
     1598                                           , input p-create-status
     1599                                           , output v-doc-rec
     1600                                           ) NO-ERROR.
     1601             if error-status:error then do:
     1602               run waitfram-hide in this-procedure .
     1603               undo, return error return-value .
     1604             end.
     1605             run waitfram-hide in this-procedure .
     1606           end.
     1607           else do:
     1608             if p-inkas-code = "":U then do:
     1609               find ink-doc where
     1610                   ink-doc.obj-type = p-curr-obj-type
     1611               AND ink-doc.obj-code = p-curr-obj-code
     1612               AND ink-doc.status_ = 'новый':U no-error .
     1613               if AMBIGUOUS ink-doc then do:
     1614                 if v-silent <> "silent":U then do:
     1615                   message
     1616                   substitute("На объекте &1&2 несколько открытых продаж&3" +
     1617                             "воспользуйтесь меню ПРОДАЖА-Список незакрытых продаж"
     1618                             , p-curr-obj-type
     1619                             , p-curr-obj-code
     1620                             , chr(10))
     1621                   view-as alert-box .
     1622                   return.
     1623                 end.
     1624               end.
     1625               if available ink-doc then do:
     1626                 p-inkas-code = ink-doc.inkas-code.
     1627               end.
     1628             end.
     1629             FIND FIRST ink-doc WHERE
     1630                         ink-doc.inkas-code = p-inkas-code NO-ERROR.
     1631             if not available ink-doc then do:
     1632               v-mes = substitute("Не найден незакрытый отчет на объекте &1&2 с номером &3"
     1633                          , p-curr-obj-type
     1634                          , p-curr-obj-code
     1635                          , p-inkas-code).
     1636               return error v-mes.
     1637             end.
     1638             v-doc-rec = recid (ink-doc).
     1639           end.
     1640           DO TRANSACTION:
     1641             FIND FIRST ink-doc WHERE
     1642                         recid(ink-doc) = v-doc-rec EXCLUSIVE-LOCK.
     1643             if p-inkas-code = ?
     1644             or p-inkas-code = '' then do:
     1645               p-inkas-code = ink-doc.inkas-code.
     1646             end.
     1647             if ink-doc.status_ = 'факт':U then do:
     1648               v-mes = substitute("Продажа с номером &1 закрыта -изменения невозможны"
     1649                          , p-inkas-code).
     1650               undo, return error v-mes.
     1651             end.
     1652             if ink-doc.status_ = 'запрос':U
     1653             then do:
     1654               v-mes = substitute("Продажа-запрос с номером &1 закрыта -изменения невозможны"
     1655                          , p-inkas-code).
     1656               undo, return error v-mes.
     1657             end.
     1658           END.
     1659         end.
     1660     if v-silent = "silent" then return ''.
     1661     if p-mode = 'ПРОСМОТР':U then do:
     1662       p-mode = 'ПРОСМОТР':U.
     1663     end.
     1664     else do:
     1665       p-mode = 'ИЗМЕНЕНИЕ':U.
     1666     end.
     1667     assign
     1668     v-handle = ?
     1669     next-prev = ?.
     1670     run str/sale.w (
     1671                   input parparentproc
     1672                 , input p-mode
     1673                 , input-output v-doc-rec
     1674                 , input-output v-handle
     1675                 , input-output next-prev
     1676                 , buffer ink-doc
     1677                 )  NO-ERROR .
     1678   end.
