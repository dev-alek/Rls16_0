      402   procedure alienini-getkey :
      403   define input parameter i-filename as char.
      404   define input parameter i-section as char.
      405   define input parameter i-key as char.
      406   define output parameter o-value as char.
      407   define variable EntryPointer as integer no-undo.
      408   define variable mem1 as memptr no-undo.
      409   define variable mem2 as memptr no-undo.
      410   define variable mem1size as integer no-undo.
      411   define variable mem2size as integer no-undo.
      412   define variable ii       as integer    no-undo.
      413   define variable cbReturnSize  as integer    no-undo.
      414   assign
      415   set-size(mem1)  = 4000
      416   mem1size = 4000.
      417   if i-key = "" then EntryPointer = 0.
      418   else do:
      419     assign
      420     set-size(mem2) = 128
      421     mem2size = 128
      422     EntryPointer = get-pointer-value(mem2)
      423     put-string(mem2, 1) = i-key.
      424   end.
      425   run getprivateprofilestringA
      426                                 (i-section,
      427                                  EntryPointer,
      428                                  "",
      429                                  get-pointer-value(mem1),
      430                                  input mem1size,
      431                                  i-filename,
      432                                  output cbReturnSize).
      433   do ii = 1 to cbReturnSize:
      434     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
      435                  then o-value + ","
      436                  else o-value + chr(get-byte(mem1, ii)).
      437   end.
      438     set-size(mem1) = 0.
      439     set-size(mem2) = 0.
      440   end procedure.
      441   procedure alienini-putkey :
      442   define input parameter i-filename as char.
      443   define input parameter i-section as char.
      444   define input parameter i-key as char.
      445   define input parameter i-value as char.
      446   define variable cbReturnSize as integer.
      447   run writeprivateprofilestringA
      448                                  (i-section,
      449                                   i-key,
      450                                   i-value,
      451                                   i-filename,
      452                                   output cbReturnSize ).
      453   end procedure.
      454   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
      455     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
      456     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
      457     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
      458     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
      459     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
      460     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
      461     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
      462   END PROCEDURE.
      463   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
      464     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
      465     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
      466     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
      467     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
      468     DEFINE RETURN PARAMETER lpszValue    AS LONG.
      469   END PROCEDURE.
