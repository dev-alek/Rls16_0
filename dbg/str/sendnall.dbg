      511   field field-name as character
      512   field num-records as integer
      513   field size_ as integer
      514   field host as character
      515   field progress-type as character
      516   field custom-type as character
      517   field start-pos as integer
      518   field end-pos as integer
      519   field bin-group as character
      520   index pi is unique primary
      521   host obj-num field-num
      522   .
      523   define temp-table temp-tekka-record no-undo
      524   field obj-num as integer
      525   field plu as integer
      526   field body as character
      527   field shift as integer
      528   index pi is unique primary obj-num plu.
      529   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
      530   define variable v-is-closed-shift-journal as integer no-undo .
      531   assign
      532   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
      533                               +
      534                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
      535                               +
      536                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
      537   .
      538   return v-is-closed-shift-journal.
      539   END FUNCTION.
      540   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
      541   define variable v-is-first-journal as logical no-undo .
      542   assign
      543   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
      544                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
      545                     or (p-journal-num =  integer(entry(1, '17':U)))
      546                     or (p-journal-num = integer(entry(1, '16':U)))
      547   .
      548   return v-is-first-journal.
      549   END FUNCTION.
      550   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
      551   define variable v-is-petrol-journal as logical no-undo .
      552   assign
      553   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
      554   return v-is-petrol-journal.
      555   END FUNCTION.
      556   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
      557   define variable v-max-record-num as integer no-undo .
      558   assign
      559   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      560                       then 1489
      561                       else 2340).
      562   return v-max-record-num.
      563   END FUNCTION.
      564   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
      565   define variable v-max-record-num as integer no-undo .
      566   assign
      567   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      568                       then 1489 * num-entries('30,31,32,33':U)
      569                       else 2340 * num-entries('17':U)).
      570   return v-max-record-num.
      571   END FUNCTION.
      572   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
      573                                           ,input p-rec-no as integer):
      574   define variable v-num-recs as integer no-undo .
      575   if tekka-is-petrol-journal (p-journal-num) then do:
      576     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
      577       assign
      578       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
      579       .
      580     end.
      581     else do:
      582       assign
      583       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
      584       .
      585     end.
      586   end.
      587   else do:
      588     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
      589       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      590         assign
      591         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
      592         .
      593       end.
      594       else do:
      595         assign
      596         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
      597         .
      598       end.
      599     end.
      600     else do:
      601       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      602         assign
      603         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
      604         .
      605       end.
      606       else do:
      607         assign
      608         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
      609         .
      610       end.
      611     end.
      612   end.
      613   return v-num-recs.
      614   END FUNCTION.
      615   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
      616                                              ,input p-is-petrol as logical
      617                                              ,input p-is-current as logical
      618                                              ,output p-rec-no as decimal
      619                                              ):
      620   define variable v-obj-num0 as integer no-undo .
      621   define variable v-obj-num as integer no-undo .
      622   define variable v-obj-num2 as integer no-undo .
      623   define variable p-num-recs2 as integer no-undo .
      624   define variable p-rec-no2 as integer no-undo .
      625   if p-is-petrol then do:
      626     assign
      627     v-obj-num0 = trunc(p-num-recs / 1489, 0)
      628     .
      629     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
      630     then
      631     assign
      632     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
      633     p-rec-no = p-num-recs modulo 1489
      634     .
      635     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
      636     then
      637     assign
      638     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
      639     p-rec-no = p-num-recs modulo 1489
      640     .
      641   end.
      642   else do:
      643     assign
      644     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
      645     p-num-recs = trunc(p-num-recs, 0)
      646     v-obj-num0 = trunc(p-num-recs / 2340, 0)
      647     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
      648     .
      649     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
      650     then
      651     assign
      652     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
      653     p-rec-no = p-num-recs modulo 2340
      654     .
      655     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
      656     then
      657     assign
      658     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
      659     p-rec-no = p-num-recs modulo 2340
      660     .
      661     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
      662     then
      663     assign
      664     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
      665     p-rec-no2 = p-num-recs2 modulo 2978
      666     .
      667     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
      668     then
      669     assign
      670     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
      671     p-rec-no2 = p-num-recs2 modulo 2978
      672     .
      673     assign
      674     p-rec-no = p-rec-no + p-rec-no2 / 10000
      675     .
      676   end.
      677   if v-obj-num = 0 then v-obj-num = 100.
      678   return v-obj-num.
      679   END FUNCTION.
      680   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
      681   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
      682   if lookup (string(p-obj-num), '17':U) > 0 then do:
      683      if p-is-ptrl then
      684      return integer(entry(1, '26,27,28,29':U)).
      685      if not p-is-ptrl then
      686      return integer(entry(1, '16':U)).
      687   end.
      688   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      689   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      690   return 0.
      691   END FUNCTION.
      692   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
      693   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
      694   if lookup (string(p-obj-num), '17':U) > 0 then do:
      695     if p-is-ptrl then
      696     return integer(entry(1, '26,27,28,29':U)).
      697     if not p-is-ptrl then
      698     return integer(entry(1, '16':U)).
      699   end.
      700   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      701   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      702   return 0.
      703   END FUNCTION.
      704   PROCEDURE maria-put:
      705   define parameter buffer buf_cash-desk for ub.cash-desk.
      706   define input parameter p-out    as character no-undo .
      707   define input parameter p-fname as character no-undo .
      708   define input parameter p-by-record as logical no-undo .
      709   define input parameter p-shift-fields as integer no-undo .
      710   define input parameter p-binary as logical no-undo .
      711   define input parameter p-obj-num as integer no-undo .
      712   define input parameter p-max-records as integer no-undo .
      713   define input parameter p-plu as integer no-undo .
      714   define input parameter p-value as character no-undo .
      715   define variable v-file-name as character no-undo .
      716   define variable v-create as logical no-undo .
      717   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      718   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
      719   output stream IBMSTREAM
      720   to value(v-file-name) append .
      721   Put  stream IBMSTREAM unformatted
      722   p-plu
      723   chr(3)
      724   p-value
      725   skip.
      726   output stream IBMSTREAM
      727   close.
      728   if not p-by-record then do:
      729     find first buf_temp-tekka-tsk where
      730               buf_temp-tekka-tsk.filename  = v-file-name no-error .
      731     if not available buf_temp-tekka-tsk then do:
      732       v-create = yes.
      733     end.
      734   end.
      735   else do:
      736     find first buf_temp-tekka-tsk where
      737               buf_temp-tekka-tsk.filename  = v-file-name
      738           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
      739     if not available buf_temp-tekka-tsk
      740     then do:
      741       find first buf_temp-tekka-tsk where
      742                 buf_temp-tekka-tsk.filename  = v-file-name
      743             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
      744       if not available buf_temp-tekka-tsk
      745       then do:
      746         v-create = yes.
      747       end.
      748     end.
      749   end.
      750   if v-create then do:
      751     create buf_temp-tekka-tsk.
      752     assign
      753     buf_temp-tekka-tsk.filename = v-file-name
      754     buf_temp-tekka-tsk.range    = p-plu
      755     buf_temp-tekka-tsk.obj-num = p-obj-num
      756     buf_temp-tekka-tsk.obj-name = '':U
      757     buf_temp-tekka-tsk.num-records = 0
      758     buf_temp-tekka-tsk.max-records = p-max-records
      759     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
      760     buf_temp-tekka-tsk.task-num = p-fname
      761     buf_temp-tekka-tsk.by-record = p-by-record
      762     buf_temp-tekka-tsk.shift-fields = p-shift-fields
      763     buf_temp-tekka-tsk.binary = p-binary
      764     buf_temp-tekka-tsk.send-get = 'send'
      765     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      766     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      767     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      768     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      769                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      770                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      771                                 then 'local'
      772                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      773     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      774     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      775     buf_temp-tekka-tsk.waiting-sek = 30
      776     buf_temp-tekka-tsk.min-plu     = p-plu
      777     buf_temp-tekka-tsk.max-plu     = p-plu
      778     .
      779   end.
      780   assign
      781   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
      782   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
      783   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
      784   .
      785   END PROCEDURE.
      786   PROCEDURE maria-get:
      787   define parameter buffer buf_cash-desk for ub.cash-desk.
      788   define input parameter p-out    as character no-undo .
      789   define input parameter p-fname as character no-undo .
      790   define input parameter p-by-record as logical no-undo .
      791   define input parameter p-obj-num as integer no-undo .
      792   define input parameter p-num-fields as integer no-undo .
      793   define input parameter p-max-records as integer no-undo .
      794   define input parameter p-min-plu as integer no-undo .
      795   define input parameter p-max-plu as integer no-undo .
      796   define input parameter p-other as character no-undo .
      797   define input parameter p-order-num as integer no-undo .
      798   define variable v-file-name as character no-undo .
      799   define variable v-secondary-obj-num as character no-undo .
      800   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      801   if p-by-record then do:
      802     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
      803   end.
      804   else do:
      805     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
      806   end.
      807   find first buf_temp-tekka-tsk where
      808             buf_temp-tekka-tsk.filename  = v-file-name no-error .
      809   if not available buf_temp-tekka-tsk then do:
      810     create buf_temp-tekka-tsk.
      811     assign
      812     buf_temp-tekka-tsk.filename = v-file-name
      813     buf_temp-tekka-tsk.obj-num = p-obj-num
      814     buf_temp-tekka-tsk.obj-name = '':U
      815     buf_temp-tekka-tsk.max-records = p-max-records
      816     buf_temp-tekka-tsk.num-fields = p-num-fields
      817     buf_temp-tekka-tsk.task-num = p-fname
      818     buf_temp-tekka-tsk.by-record = p-by-record
      819     buf_temp-tekka-tsk.send-get = 'get'
      820     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      821     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      822     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      823     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      824                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      825                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      826                                   then 'local'
      827                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      828     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      829     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      830     buf_temp-tekka-tsk.waiting-sek = 30
      831     buf_temp-tekka-tsk.min-plu     = p-min-plu
      832     buf_temp-tekka-tsk.max-plu     = p-max-plu
      833     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
      834                                       and p-max-plu <> ?
      835                                       then p-max-plu - p-min-plu + 1
      836                                       else 0)
      837     buf_temp-tekka-tsk.other-info = p-other
      838     buf_temp-tekka-tsk.order-num = p-order-num
      839     .
      840     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
      841       assign
      842       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
      843       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
      844       v-secondary-obj-num = entry(1, v-secondary-obj-num)
      845       no-error
      846       .
      847       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
      848     end.
      849   end.
      850   END PROCEDURE.
      851   PROCEDURE maria-task:
      852   define parameter buffer buf_cash-desk for ub.cash-desk.
      853   define input parameter p-fname as character no-undo .
      854   define input parameter p-obj-num-list as character no-undo .
      855   define input parameter p-parameters as character no-undo .
      856   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      857   find first buf_temp-tekka-tsk where
      858             buf_temp-tekka-tsk.task-num  = p-fname no-error .
      859   if not available buf_temp-tekka-tsk then do:
      860     create buf_temp-tekka-tsk.
      861     assign
      862     buf_temp-tekka-tsk.filename = ''
      863     buf_temp-tekka-tsk.range = 1
      864     buf_temp-tekka-tsk.obj-num = 0
      865     buf_temp-tekka-tsk.obj-name = p-obj-num-list
      866     buf_temp-tekka-tsk.task-num = p-fname
      867     buf_temp-tekka-tsk.by-record = no
      868     buf_temp-tekka-tsk.send-get = 'task'
      869     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      870     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      871     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      872     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      873                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      874                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      875                                   then 'local'
      876                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      877     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      878     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      879     buf_temp-tekka-tsk.waiting-sek = 30
      880     buf_temp-tekka-tsk.other-info = p-parameters
      881     buf_temp-tekka-tsk.order-num = 0
      882     .
      883   end.
      884   END PROCEDURE.
      885   procedure tekkatsk-verify-schema :
      886   define input parameter p-obj-list as character no-undo .
      887   define input parameter p-dir-path as character no-undo .
      888   define variable v-obj-num as integer no-undo .
      889   define variable v-obj-name as character no-undo .
      890   define variable v-num-records as integer no-undo .
      891   define variable v-size_ as integer no-undo .
      892   define variable v-value as character no-undo .
      893   define variable ii as integer no-undo .
      894   define variable jj as integer no-undo .
      895   define variable ii-ibs as integer no-undo .
      896   define variable ii-tekka as integer no-undo .
      897   define variable v-result as character no-undo .
      898   define buffer buf_temp-tekka-schema for temp-tekka-schema.
      899   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
      900     do
      901     on error undo, return error
      902     :
      903        for each buf_temp-tekka-schema:
      904          delete buf_temp-tekka-schema.
      905        end.
      906        input from value('tekkasch.d').
      907        repeat :
      908          create buf_temp-tekka-schema.
      909          import buf_temp-tekka-schema.
      910          assign
      911          buf_temp-tekka-schema.host = 'IBS'
      912          ii = ii + 1.
      913          .
      914        end.
      915        input close.
      916        ii-ibs = ii.
      917         _ii:
      918         do ii = 1 to 256:
      919           if p-obj-list = "ALL"
      920           or lookup(string(ii), p-obj-list) > 0 then do:
      921             assign
      922             v-obj-num = 0
      923             v-obj-name = ''
      924             v-num-records = 0
      925             v-size_ = 0
      926             .
      927             run alienini-getkey in this-procedure (
      928                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      929                                                     ,input ('obj' + string(ii, '999'))
      930                                                     ,input 'oname'
      931                                                     ,output v-value) no-error .
      932             if v-value = ? then next _ii.
      933             assign
      934             v-obj-num = ii
      935             v-obj-name = v-value
      936             .
      937             run alienini-getkey in this-procedure (
      938                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      939                                                     ,input ('obj' + string(ii, '999'))
      940                                                     ,input 'size'
      941                                                     ,output v-value) no-error .
      942             assign
      943             v-num-records = integer(v-value) no-error  .
      944             if error-status:error
      945             or v-num-records = 0 then next _ii.
      946             run alienini-getkey in this-procedure (
      947                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      948                                                     ,input 'obj' + string(ii, '999')
      949                                                     ,input 'f000'
      950                                                     ,output v-value) no-error .
      951             assign
      952             v-size_ = integer(v-value) no-error  .
      953             if error-status:error
      954             or v-size_ = 0 then next _ii.
      955             _jj:
      956             do jj = 1 to 256:
      957               run alienini-getkey in this-procedure (
      958                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      959                                                       ,input 'obj' + string(ii, '999')
      960                                                       ,input 'f' + string(jj, '999')
      961                                                       ,output v-value) no-error .
      962               if v-value = ? then next _ii.
      963               create buf_temp-tekka-schema.
      964               assign
      965               buf_temp-tekka-schema.host = 'tekka'
      966               buf_temp-tekka-schema.obj-num = v-obj-num
      967               buf_temp-tekka-schema.obj-name = v-obj-name
      968               buf_temp-tekka-schema.num-records = v-num-records
      969               buf_temp-tekka-schema.size_ = v-size_
      970               buf_temp-tekka-schema.field-num = jj
      971               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
      972               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
      973                                                  then entry(2, entry(2, v-value, '#'), ':')
      974                                                  else '':U)
      975               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
      976               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
      977               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
      978                                                           , 'C,I,I,I,D,D,D,D,D':U)
      979               no-error
      980               .
      981               if error-status:error then do:
      982                 delete buf_temp-tekka-schema.
      983                 next _jj.
      984               end.
      985               run alienini-getkey in this-procedure (
      986                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      987                                                       ,input 'obj' + string(ii, '999') + 'name'
      988                                                       ,input 'n' + string(jj, '999')
      989                                                       ,output v-value) no-error .
      990               if v-value <> ? then
      991               buf_temp-tekka-schema.field-name = v-value.
      992             end.
      993           end.
      994         end.
      995         ii-tekka = ii - 1.
      996        if p-obj-list <> 'ALL' then do:
      997         if ii-tekka <> ii-ibs then do:
      998           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
      999                                   , ii-ibs
     1000                                   , ii-tekka).
     1001         end.
     1002        end.
     1003        for each buf_temp-tekka-schema where
     1004               buf_temp-tekka-schema.host = 'tekka':
     1005          find first buf2_temp-tekka-schema where
     1006                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     1007                AND buf2_temp-tekka-schema.host = 'ibs'
     1008                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     1009          if not available buf2_temp-tekka-schema then do:
     1010           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     1011                                   , buf_temp-tekka-schema.field-num
     1012                                   , buf_temp-tekka-schema.obj-num).
     1013          end.
     1014          buffer-compare buf_temp-tekka-schema
     1015          to buf2_temp-tekka-schema
     1016          save result in v-result.
     1017          if v-result <> '':U then do:
     1018           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     1019                                   , buf_temp-tekka-schema.field-num
     1020                                   , buf_temp-tekka-schema.obj-num).
     1021          end.
     1022        end.
     1023     end.
     1024   end procedure.
     1025   FUNCTION set-Sx returns character (input p-string as character):
     1026   return p-string.
     1027   END FUNCTION.
     1028   FUNCTION get-Sx returns character (input p-string  as character):
     1029   return p-string.
     1030   END FUNCTION.
     1031   FUNCTION set-B returns character (input p-string  as character):
     1032   return chr(integer(p-string)).
     1033   END FUNCTION.
     1034   FUNCTION get-B returns character (input p-string  as character):
     1035   return string(asc(p-string)).
     1036   END FUNCTION.
     1037   FUNCTION set-BF returns character (input p-string  as character):
     1038   define variable v-dopi as integer no-undo .
     1039   define variable ii as integer no-undo .
     1040   do ii = 1 to 8:
     1041     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     1042   end.
     1043   return chr(v-dopi).
     1044   END FUNCTION.
     1045   FUNCTION get-BF returns character (input p-string  as character):
     1046   define variable v-dopi as integer no-undo .
     1047   define variable v-dops as character no-undo .
     1048   define variable ii as integer no-undo .
     1049   v-dopi = asc(p-string).
     1050   do ii = 8 to 1 BY -1:
     1051     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     1052   end.
     1053   return v-dops.
     1054   END FUNCTION.
     1055   FUNCTION set-BN returns character (input p-string  as character
     1056                                     ,input p-bin-group as character):
     1057   define variable v-dopi as integer no-undo .
     1058   define variable ii as integer no-undo .
     1059   define variable jj as integer no-undo .
     1060   define variable v-grp-nums as integer no-undo .
     1061   define variable v-dopi2 as integer no-undo .
     1062   v-grp-nums = num-entries(p-bin-group).
     1063   do jj = 0 to v-grp-nums - 1:
     1064     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     1065     do ii = 1 to 8:
     1066       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     1067     end.
     1068   end.
     1069   return chr(v-dopi).
     1070   END FUNCTION.
     1071   FUNCTION get-BN returns character (input p-string  as character
     1072                                     ,input p-bin-group as character):
     1073   define variable v-dopi as integer no-undo .
     1074   define variable v-dops as character no-undo .
     1075   define variable v-grp-nums as integer no-undo .
     1076   define variable ii as integer no-undo .
     1077   define variable jj as integer no-undo .
     1078   v-dopi = asc(p-string).
     1079   v-grp-nums = num-entries(p-bin-group).
     1080   do jj = 1 to v-grp-nums:
     1081   do ii = 8 to 1 BY -1:
     1082     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     1083   end.
     1084   end.
     1085   return v-dops.
     1086   END FUNCTION.
     1087   procedure fill-temp-cd :
     1088   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     1089   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1090   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1091   define input parameter p-clear-table as logical no-undo .
     1092   define buffer buf_temp-cd for temp-cd.
     1093   define buffer buf_cash-desk for ub.cash-desk.
     1094     do
     1095     on error undo, return error
     1096     :
     1097        if p-clear-table  then do:
     1098          for each buf_temp-cd:
     1099            delete buf_temp-cd.
     1100          end.
     1101        end.
     1102        for each buf_cash-desk no-lock where
     1103               buf_cash-desk.db-num = p-db-num
     1104           AND buf_cash-desk.obj-code = p-obj-code
     1105           and buf_cash-desk.cash-on  = yes
     1106        BREAK by buf_cash-desk.pos-type:
     1107          if first-of(buf_cash-desk.pos-type) then do:
     1108            create buf_temp-cd.
     1109            buffer-copy buf_cash-desk to buf_temp-cd.
     1110          end.
     1111        end.
     1112     end.
     1113   end procedure.
     1114   define buffer buf_clients for ub.clients.
     1115   define buffer buf_shop for ub.shop.
     1116   define buffer buf_cash-desk for ub.cash-desk.
     1117   assign
     1118   p-db-num = integer(entry(1, p-parameter, chr(4)))
     1119   no-error
     1120   .
     1121   if error-status:error then return error.
     1122   define variable vrec-cur      as character no-undo.
     1123   define variable vrec-del      as character no-undo.
     1124   for each cash-pay-list no-lock:
     1125      find first cash-pay where cash-pay.cdpay-code eq cash-pay-list.cdpay-code
     1126                            and cash-pay.curr-code  eq cash-pay-list.curr-code
     1127      no-lock no-error.
     1128      if available cash-pay
     1129      then do:
     1130         if      cash-pay.status_ eq 'тек':U
     1131         then
     1132            vrec-cur = vrec-cur + "," + string(recid(cash-pay)).
     1133         else if cash-pay.status_ eq 'удал':U
     1134         then
     1135            vrec-del = vrec-del + "," + string(recid(cash-pay)).
     1136      end.
     1137   end.
     1138   vrec-cur = trim(vrec-cur,",").
     1139   vrec-del = trim(vrec-del,",").
     1140   for each buf_clients no-lock
     1141         where buf_clients.obj-type = 'маг':U
     1142           and buf_clients.db-num   = g#db-num,
     1143         first buf_cash-desk no-lock where
     1144              buf_cash-desk.db-num = p-db-num
     1145          AND buf_cash-desk.obj-code = buf_clients.obj-code
     1146          AND buf_cash-desk.cash-on = yes
     1147     on error undo, return error
     1148     :
     1149      if  vrec-cur ne ""
     1150      then
     1151         run str/send-pay.p (
     1152                          input parparentproc
     1153                         ,input p-parent-handle
     1154                         ,input p-log-handle
     1155                         ,input buf_clients.obj-code
     1156                         ,input "U"
     1157                         ,input 1
     1158                        , input vrec-cur
     1159                        , input log-file-name
     1160                        , input-output v-view-log
     1161                        ) no-error .
     1162      if  vrec-del ne ""
     1163      then
     1164         run str/send-pay.p (
     1165                          input parparentproc
     1166                         ,input p-parent-handle
     1167                         ,input p-log-handle
     1168                         ,input buf_clients.obj-code
     1169                         ,input "U"
     1170                         ,input 1
     1171                        , input vrec-del
     1172                        , input log-file-name
     1173                        , input-output v-view-log
     1174                        ) no-error .
     1175   end.
     1176   define variable v-promo-actions-upd as class ibs.th.ref.promo.promoactionsubs no-undo .
     1177   define variable v-promo-actions-del as class ibs.th.ref.promo.promoactionsubs no-undo .
     1178   define variable v-promo-stor as class ibs.th.gbl.storage.promoactionstorage no-undo .
     1179   v-promo-stor = new ibs.th.gbl.storage.promoactionstorage().
     1180   for each PromoAction-list no-lock:
     1181      find first ub.PromoAction where ub.PromoAction.id = PromoAction-list.id
     1182                            and ub.PromoAction.db-num = PromoAction-list.db-num
     1183      no-lock no-error.
     1184      if available ub.PromoAction
     1185      then do:
     1186        if ub.PromoAction.Status_ = 2 or ub.PromoAction.changeDate < today then
     1187         v-promo-stor:getpromoactionsubs(input-output v-promo-actions-del,PromoAction-list.db-num,PromoAction-list.id).
     1188        else  v-promo-stor:getpromoactionsubs(input-output v-promo-actions-upd,PromoAction-list.db-num,PromoAction-list.id).
     1189      end.
     1190   end.
     1191   delete object v-promo-stor.
     1192   if valid-Object(v-promo-actions-upd)
     1193   then do:
     1194      for each buf_clients no-lock
     1195            where buf_clients.obj-type = 'маг':U
     1196              and buf_clients.db-num   = g#db-num,
     1197            first buf_cash-desk no-lock where
     1198                 buf_cash-desk.db-num = p-db-num
     1199             AND buf_cash-desk.obj-code = buf_clients.obj-code
     1200             AND buf_cash-desk.cash-on = yes
     1201        on error undo, return error
     1202        :
     1203         run str/send-promo.p (
     1204                          input parparentproc
     1205                         ,input p-parent-handle
     1206                         ,input p-log-handle
     1207                         ,input buf_cash-desk.obj-code
     1208                         ,input "U"
     1209                         ,input (if not valid-object (v-promo-actions-upd)
     1210                                 then 0
     1211                                 else 1)
     1212                        , input v-promo-actions-upd
     1213                        , input log-file-name
     1214                        , input-output v-view-log
     1215                        ) no-error .
     1216      end.
     1217   end.
     1218   if valid-Object(v-promo-actions-del)
     1219   then do:
     1220      for each buf_clients no-lock
     1221            where buf_clients.obj-type = 'маг':U
     1222              and buf_clients.db-num   = g#db-num,
     1223            first buf_cash-desk no-lock where
     1224                 buf_cash-desk.db-num = p-db-num
     1225             AND buf_cash-desk.obj-code = buf_clients.obj-code
     1226             AND buf_cash-desk.cash-on = yes
     1227        on error undo, return error
     1228        :
     1229         run str/send-promo.p (
     1230                          input parparentproc
     1231                         ,input p-parent-handle
     1232                         ,input p-log-handle
     1233                         ,input buf_cash-desk.obj-code
     1234                         ,input "D"
     1235                         ,input (if not valid-object (v-promo-actions-del)
     1236                                 then 0
     1237                                 else 1)
     1238                        , input v-promo-actions-del
     1239                        , input log-file-name
     1240                        , input-output v-view-log
     1241                        ) no-error .
     1242      end.
     1243   end.
     1244   assign
     1245      vrec-cur = ""
     1246      vrec-del = ""
     1247      .
     1248   for each buf_clients no-lock
     1249         where buf_clients.obj-type = 'маг':U
     1250           and buf_clients.db-num   = g#db-num,
     1251         first buf_cash-desk no-lock where
     1252              buf_cash-desk.db-num = p-db-num
     1253          AND buf_cash-desk.obj-code = buf_clients.obj-code
     1254          AND buf_cash-desk.cash-on = yes
     1255     on error undo, return error
     1256     :
     1257   for each c-ext-classif-list no-lock:
     1258      find first c-ext-classif where c-ext-classif.db-num = c-ext-classif-list.db-num and
     1259                                   c-ext-classif.Key#_One = c-ext-classif-list.Key#One and
     1260                                   c-ext-classif.Key#_Two = c-ext-classif-list.Key#Two and
     1261                                   c-ext-classif.CharKey_One = c-ext-classif-list.CharKey_One and
     1262                                   c-ext-classif.chip-num = c-ext-classif-list.chip-num and
     1263                                   c-ext-classif.classif-subject = 'goods':U and
     1264                                   c-ext-classif.classif-name = 'exp-esys-gds-code':U
     1265      no-lock no-error.
     1266      if available c-ext-classif
     1267      then do:
     1268         find first ext-classif where ext-classif.db-num = c-ext-classif-list.db-num and
     1269                                   ext-classif.Key#_One = c-ext-classif-list.Key#One and
     1270                                   ext-classif.Key#_Two = c-ext-classif-list.Key#Two and
     1271                                   ext-classif.CharKey_One = c-ext-classif-list.CharKey_One and
     1272                                   ext-classif.classif-subject = 'goods':U and
     1273                                   ext-classif.classif-name = 'exp-esys-gds-code':U no-error .
     1274                   if not available ext-classif then
     1275      vrec-del = vrec-del + "," + string(recid(c-ext-classif)).
     1276      end.
     1277   end.
     1278      if  vrec-del ne ""
     1279      then
     1280          run str/send-petrol.p (
     1281                       input parparentproc
     1282                      ,input p-parent-handle
     1283                      ,input p-log-handle
     1284                      ,input buf_clients.obj-code
     1285                      ,input buf_clients.obj-type
     1286                      ,input "D"
     1287                      ,input 0
     1288                     , input vrec-del
     1289                     , input log-file-name
     1290                     , input-output v-view-log
     1291                     ) no-error .
     1292   for each ext-classif-list no-lock:
     1293      find first ext-classif where ext-classif.db-num = ext-classif-list.db-num and
     1294                                   ext-classif.Key#_One = ext-classif-list.Key#One and
     1295                                   ext-classif.Key#_Two = ext-classif-list.Key#Two and
     1296                                   ext-classif.CharKey_One = ext-classif-list.CharKey_One and
     1297                                   ext-classif.classif-subject = 'goods':U and
     1298                                   ext-classif.classif-name = 'exp-esys-gds-code':U
     1299      no-lock no-error.
     1300      if available ext-classif
     1301      then vrec-cur = vrec-cur + "," + string(recid(ext-classif)).
     1302   end.
     1303   vrec-cur = trim(vrec-cur,",").
     1304      if  vrec-cur ne ""
     1305      then
     1306       run str/send-petrol.p (
     1307                       input parparentproc
     1308                      ,input p-parent-handle
     1309                      ,input p-log-handle
     1310                      ,input buf_clients.obj-code
     1311                      ,input buf_clients.obj-type
     1312                      ,input "U"
     1313                      ,input 0
     1314                     , input vrec-cur
     1315                     , input log-file-name
     1316                     , input-output v-view-log
     1317                     ) no-error .
     1318   end.
     1319   if can-find(first gds-list no-lock)
     1320   or can-find(first gdsolist no-lock) then do:
     1321     for each buf_clients no-lock
     1322         where buf_clients.obj-type = 'маг':U
     1323           and buf_clients.db-num   = p-db-num,
     1324         first buf_cash-desk no-lock where
     1325              buf_cash-desk.db-num = p-db-num
     1326          AND buf_cash-desk.obj-code = buf_clients.obj-code
     1327          AND buf_cash-desk.cash-on = yes
     1328     on error undo, return error
     1329     :
     1330       for each gdsolist no-lock where
     1331               gdsolist.obj-type = buf_clients.obj-type
     1332           and gdsolist.obj-code = buf_clients.obj-code:
     1333           find first gds-list where
     1334                     gds-list.gds-code = gdsolist.gds-code no-error .
     1335           if avail gds-list then NEXT.
     1336           if not avail gds-list then do:
     1337             find first goods no-lock where
     1338                       goods.gds-code = gdsolist.gds-code no-error .
     1339             create gds-list.
     1340             buffer-copy goods to gds-list.
     1341           end.
     1342           if avail gds-list then
     1343           assign
     1344           gds-list.qnty = -1
     1345           .
     1346       END.
     1347       run set-title in p-log-handle (
     1348             input "Отправка товаров на кассу"
     1349                                      ).
     1350        run str/send-gds.p (
     1351           input parparentproc
     1352           ,input p-parent-handle
     1353           ,input p-log-handle
     1354           ,input (string(buf_clients.obj-code) + chr(4) + "no":U)
     1355           ) no-error .
     1356       if error-status:error then
     1357       return error substitute( "ошибка при отправке товаров на кассу по магазину &1&2&3&2&4"
     1358                               , buf_clients.obj-code
     1359                               , chr(10)
     1360                               , error-status:get-message(1)
     1361                               , return-value
     1362                               ).
     1363     end.
     1364   end.
     1365   if can-find(first bc-list no-lock) then do:
     1366     for each buf_clients no-lock
     1367         where buf_clients.obj-type = 'маг':U
     1368           and buf_clients.db-num   = g#db-num,
     1369         first buf_cash-desk no-lock where
     1370              buf_cash-desk.db-num = p-db-num
     1371          AND buf_cash-desk.obj-code = buf_clients.obj-code
     1372          AND buf_cash-desk.cash-on = yes
     1373     on error undo, return error
     1374     :
     1375       run set-title in p-log-handle (
     1376            input 'Удаление бар-кодов с кассы'
     1377                                      ).
     1378       run str/send-bcn.p (
     1379                       input parparentproc
     1380                      ,input p-parent-handle
     1381                     ,input p-log-handle
     1382                     ,input (string(buf_clients.obj-code) + chr(4) + "D":U)
     1383                       ) no-error .
     1384       if error-status:error then do:
     1385         return error substitute( "ошибка при удалении бар-кодов с кассы магазина &1&2&3&2&4"
     1386                               , buf_clients.obj-code
     1387                               , chr(10)
     1388                               , error-status:get-message(1)
     1389                               , return-value
     1390         ).
     1391       end.
     1392       run set-title in p-log-handle (
     1393            input 'Отправка бар-кодов на кассу'
     1394                                      ).
     1395       run str/send-bcn.p (
     1396                       input parparentproc
     1397                     ,input p-parent-handle
     1398                     ,input p-log-handle
     1399                     ,input (string(buf_clients.obj-code) + chr(4) + "U":U)
     1400                       ) no-error .
     1401       if error-status:error then do:
     1402         return error substitute( "ошибка при отправке бар-кодов на кассы магазина &1&2&3&2&4"
     1403                               , buf_clients.obj-code
     1404                               , chr(10)
     1405                               , error-status:get-message(1)
     1406                               , return-value
     1407           ).
     1408       end.
     1409     end.
     1410   end.
     1411   if can-find(first pbc-list no-lock) then do:
     1412       for each buf_clients no-lock
     1413         where buf_clients.obj-type = 'маг':U
     1414           and buf_clients.db-num   = p-db-num,
     1415         first buf_cash-desk no-lock where
     1416              buf_cash-desk.db-num = p-db-num
     1417          AND buf_cash-desk.obj-code = buf_clients.obj-code
     1418          AND buf_cash-desk.cash-on = yes
     1419     on error undo, return error
     1420     :
     1421       run set-title in p-log-handle (
     1422             input 'Удаление ДопБК с кассы'
     1423                                       ).
     1424       run str/s-prdbcn.p (
     1425                       input parparentproc
     1426                     ,input p-parent-handle
     1427                     ,input p-log-handle
     1428                     ,input (string(buf_clients.obj-code) + chr(4) + "D":U)
     1429                       ) no-error .
     1430       if error-status:error then do:
     1431         return error substitute( "ошибка при удалении ДопБК с кассы магазина &1&2&3&2&4"
     1432                               , buf_clients.obj-code
     1433                               , chr(10)
     1434                               , error-status:get-message(1)
     1435                               , return-value
     1436            ).
     1437       end.
     1438       run str/s-prdbcn.p (
     1439                       input parparentproc
     1440                     ,input p-parent-handle
     1441                     ,input p-log-handle
     1442                     ,input (string(buf_clients.obj-code) + chr(4) + "U":U)
     1443                       ) no-error .
     1444       if error-status:error then do:
     1445         return error substitute( "ошибка при отправке ДопБК на кассы магазина &1&2&3&2&4"
     1446                               , buf_clients.obj-code
     1447                               , chr(10)
     1448                               , error-status:get-message(1)
     1449                               , return-value
     1450            ).
     1451       end.
     1452     end.
     1453   end.
     1454   if can-find(first cash-txn no-lock)
     1455     or can-find(first cash-txr no-lock)
     1456   then do:
     1457       run set-title in p-log-handle (
     1458             input 'Отправка налогов на кассу'
     1459                                       ).
     1460     for each buf_clients no-lock
     1461         where buf_clients.obj-type = 'маг':U
     1462           and buf_clients.db-num   = p-db-num,
     1463         first buf_cash-desk no-lock where
     1464              buf_cash-desk.db-num = p-db-num
     1465          AND buf_cash-desk.obj-code = buf_clients.obj-code
     1466          AND buf_cash-desk.cash-on = yes
     1467     on error undo, return error
     1468     :
     1469       run str/sendtaxn.p (
     1470                       input parparentproc
     1471                     ,input p-parent-handle
     1472                     ,input p-log-handle
     1473                     ,input (string(buf_clients.obj-code) + chr(4) + "U":U)
     1474                     ) no-error.
     1475       if error-status:error then do:
     1476         return error substitute( "ошибка при отправке налогов на кассы магазина &1&2&3&2&4"
     1477                               , buf_clients.obj-code
     1478                               , chr(10)
     1479                               , error-status:get-message(1)
     1480                               , return-value
     1481            ).
     1482       end.
     1483     end.
     1484   end.
     1485   if    can-find(first dc-list no-lock)
     1486      or can-find(first dc-dis-card-mask no-lock)
     1487      then do:
     1488       run set-title in p-log-handle (
     1489             input 'Отправка информации по клиентским картам на кассу'
     1490                                       ).
     1491       for each buf_clients no-lock
     1492         where buf_clients.obj-type = 'маг':U
     1493           and buf_clients.db-num = p-db-num
     1494     ,each buf_shop no-lock
     1495         where buf_shop.obj-code = buf_clients.obj-code
     1496       break by buf_shop.host-code
     1497     on error undo, return error
     1498     :
     1499       if first-of(buf_shop.host-code) then do:
     1500         run str/send-cli-news.p (
     1501                       input parparentproc
     1502                      ,input p-parent-handle
     1503                      ,input p-log-handle
     1504                      ,input (string(buf_clients.obj-code) + chr(4) + "U":U +
     1505                              chr(4) + "no":U + chr(4) + "no":U )
     1506                        ) no-error .
     1507         if error-status:error then do:
     1508           return error substitute( "ошибка при отправке информации по клиентским картам на кассы магазина &1&2&3&2&4"
     1509                               , buf_clients.obj-code
     1510                               , chr(10)
     1511                               , error-status:get-message(1)
     1512                               , return-value
     1513              ).
     1514         end.
     1515       end.
     1516     end.
     1517   end.
     1518   if can-find(first stpl-list no-lock where stpl-list.classif-type = 'dis-card':U) then do:
     1519     for each stpl-list no-lock where
     1520             stpl-list.classif-type = 'dis-card':U:
     1521       run str/snd-stpl.p (
     1522                         input parparentproc
     1523                         ,input p-parent-handle
     1524                         ,input p-log-handle
     1525                         ,input stpl-list.stop-list-code
     1526                         ) no-error .
     1527       if error-status:error then do:
     1528         return error substitute( "ошибка при отправке информации по стоплистам на кассы &1&2&1&3"
     1529                             , chr(10)
     1530                             , error-status:get-message(1)
     1531                             , return-value
     1532             ).
     1533       end.
     1534     end.
     1535   end.
     1536   if can-find (first  pdf-list ) then do:
     1537     run str/sendpdfr.p (
     1538                          input parparentproc
     1539                         ,input this-procedure:handle
     1540                         ,input p-log-handle
     1541                         ,input "N"
     1542                         ) no-error.
     1543   end.
     1544   if sendEMRC or sendMarkType or sendGisMt then do:
     1545   for each buf_clients no-lock
     1546         where buf_clients.obj-type = 'маг':U
     1547           and buf_clients.db-num   = p-db-num,
     1548         first buf_cash-desk no-lock where
     1549              buf_cash-desk.db-num = p-db-num
     1550          AND buf_cash-desk.obj-code = buf_clients.obj-code
     1551          AND buf_cash-desk.cash-on = yes
     1552     on error undo, return error
     1553     :
     1554      if sendEMRC then
     1555      do:
     1556          run str/send-all.p (
     1557                              input parparentproc
     1558                             ,input this-procedure:handle
     1559                             ,input p-log-handle
     1560                             ,input buf_clients.obj-type + chr(4) + string(buf_clients.obj-code) + chr(4) + 'D':U + chr(4) + 'emrc':U + chr(4) + 'Передача справочника ЕМЦ':U
     1561                             ) no-error.
     1562          run str/send-all.p (
     1563                              input parparentproc
     1564                             ,input this-procedure:handle
     1565                             ,input p-log-handle
     1566                             ,input buf_clients.obj-type + chr(4) + string(buf_clients.obj-code) + chr(4) + 'U':U + chr(4) + 'emrc':U + chr(4) + 'Передача справочника ЕМЦ':U
     1567                             ) no-error.
     1568      end.
     1569      if sendMarkType then
     1570      do:
     1571          run str/send-all.p (
     1572                              input parparentproc
     1573                             ,input this-procedure:handle
     1574                             ,input p-log-handle
     1575                             ,input buf_clients.obj-type + chr(4) + string(buf_clients.obj-code) + chr(4) + 'U':U + chr(4) + 'MarkType':U + chr(4) + 'Передача типов маркировки':U
     1576                             ) no-error.
     1577      end.
     1578      if sendGisMt then
     1579      do:
     1580          run str/send-all.p (
     1581                              input parparentproc
     1582                             ,input this-procedure:handle
     1583                             ,input p-log-handle
     1584                             ,input buf_clients.obj-type + chr(4) + string(buf_clients.obj-code) + chr(4) + 'U':U + chr(4) + 'gismt':U + chr(4) + 'Передача параметров работы с ТСПИоТ':U
     1585                             ) no-error.
     1586      end.
     1587   end.
     1588   end.
     1589   if settingUpd then do:
     1590      find first sys-ctrl exclusive-lock.
     1591      if     available sys-ctrl
     1592      then do:
     1593         sys-ctrl.whole-send-news = sys-ctrl.whole-send-news + 1.
     1594         if sys-ctrl.whole-send-news > 1000
     1595         then
     1596            sys-ctrl.whole-send-news = 1.
     1597      end.
     1598      release sys-ctrl.
     1599   end.
     1600   procedure sendnall_get-pdf :
     1601   define input-output parameter p-ii as integer no-undo .
     1602   define output parameter p-plt-id as integer no-undo .
     1603   define output parameter p-plt-db-num as integer no-undo .
     1604   define output parameter p-pdf-id as integer no-undo .
     1605   define output parameter p-pdf-db-num as integer no-undo .
     1606   define output parameter p-del as logical no-undo .
     1607   find first pdf-list where
     1608             pdf-list.order-num > p-ii no-error.
     1609   if available pdf-list then do:
     1610      assign
     1611      p-plt-id = pdf-list.plt-id
     1612      p-plt-db-num = pdf-list.plt-db-num
     1613      p-pdf-id = pdf-list.pdf-id
     1614      p-pdf-db-num = pdf-list.pdf-db
     1615      p-ii = pdf-list.order-num
     1616      p-del = pdf-list.to-del
     1617      .
     1618   end.
     1619   end procedure.
