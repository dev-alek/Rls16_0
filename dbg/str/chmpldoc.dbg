        1   DEFINE BUFFER buf_currency FOR currency.
        2   define input  parameter parparentproc as handle no-undo .
        3   define input  parameter p-cli-type    as character no-undo .
        4   define input  parameter p-cli-code    as integer   no-undo .
        5   define input  parameter p-main-b-code as integer   no-undo .
        6   define input  parameter p-b-code      as integer   no-undo .
        7   define input  parameter p-obj-type    as character no-undo .
        8   define input  parameter p-obj-code    as integer   no-undo .
        9   define input  parameter p-qnty-doc    as decimal   no-undo .
