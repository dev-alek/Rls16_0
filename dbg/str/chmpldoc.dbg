      127   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      128   procedure proc-alt-shift-f2:
      129     if not ibs.th.gbl.gbl-var:rcode
      130   then
      131     run gbl\inidebug.p .
      132   end.
      133   procedure proc-alt-shift-f3:
      134     run gbl/prvssinf.p
      135       ( input this-procedure
      136       ) .
      137   end.
      138   define variable v-inform-launched as logical no-undo initial false .
      139   procedure proc-alt-shift-f4:
      140     define variable v-action as character no-undo .
      141     if v-inform-launched = false then do:
      142       assign
      143         v-inform-launched = true
      144       .
      145       run gbl/d-inform.w
      146         (  input self
      147         ,  input this-procedure
      148         , output v-action
      149         ) no-error .
      150       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      151       assign
      152         v-inform-launched = false
      153       .
      154     end.
      155   end.
      156   procedure proc-alt-f1:
      157     run gbl/corrhelp.p
      158       (input this-procedure
      159       ) .
      160   end .
      161   on alt-shift-f2 anywhere do:
      162     run proc-alt-shift-f2.
      163   end.
      164   on alt-shift-f3 anywhere do:
      165     run proc-alt-shift-f3 in this-procedure .
      166   end.
      167   on alt-shift-f4 anywhere do:
      168     run proc-alt-shift-f4 in this-procedure.
      169   end.
      170   on alt-f1 anywhere do:
      171     run proc-alt-f1 in this-procedure .
      172   end.
      173   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      175   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      176   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
