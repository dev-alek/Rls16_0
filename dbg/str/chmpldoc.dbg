      262               when 'wthobr-wth':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val =       p-label = "Оборотная ведомость серийных МЦ по контрагентам"     p-tooltip = "Оборотная ведомость серийных МЦ по контрагентам"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      263               when 'e-ptlbal':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Оперативный балансовый отчет движения нефтепродуктов"     p-tooltip = "Оперативный балансовый отчет движения нефтепродуктов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      264               when 'ctrasm':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val =       p-label = "Контроль ассортиментной матрицы"     p-tooltip = "Контроль ассортиментной матрицы"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      265               when 'e-eslg-e':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Оперативный балансовый отчет движения нефтепродуктов"     p-tooltip = "Оперативный балансовый отчет движения нефтепродуктов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      266               when 'prphoto':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(2256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(2256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Прайс-лист с фото товаров"     p-tooltip = "Прайс-лист с фото товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      267               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      268               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      269               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      270                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      271               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      272         otherwise do:
      273           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      274         end.
      275       end CASE.
      276     end.
      277   end procedure.
      278   procedure uf-get :
      279     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      280     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      281     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      282     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      283     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      284     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      285     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      286     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      287     do
      288     on error undo, return error
      289     :
      290       define buffer buf_usr-flt for ubflt.usr-flt .
      291       define variable v-use-List_     as logical   no-undo .
      292       define variable v-type-List_     as character no-undo .
      293       define variable v-format-List_   as character no-undo .
      294       define variable v-use-Naim      as logical   no-undo .
      295       define variable v-type-Naim      as character no-undo .
      296       define variable v-format-Naim    as character no-undo .
      297       define variable v-use-print-graft as logical   no-undo .
      298       define variable v-use-sort-gr     as logical   no-undo .
      299       define variable v-use-type-price  as logical   no-undo .
      300       define variable v-use-type-val    as logical   no-undo .
      301       define variable v-label          as character no-undo .
      302       define variable v-tooltip        as character no-undo .
      303       define variable v-user-can-edit  as logical   no-undo .
      304       define variable v-output-display as logical   no-undo .
      305       define variable v-other          as character no-undo .
      306       run uf-name in this-procedure
      307          (input  entry(1, p-code, chr(4))
      308         ,output v-use-List_
      309         ,output v-type-List_
      310         ,output v-format-List_
      311         ,output v-use-Naim
      312         ,output v-type-Naim
      313         ,output v-format-Naim
      314         ,output v-use-print-graft
      315         ,output v-use-sort-gr
      316         ,output v-use-type-price
      317         ,output v-use-type-val
      318         ,output v-label
      319         ,output v-tooltip
      320         ,output v-user-can-edit
      321         ,output v-output-display
      322         ,output v-other
      323         ) no-error .
      324       if error-status :error then do:
      325         undo, return error return-value .
      326       end.
      327       find first buf_usr-flt no-lock where
      328                  buf_usr-flt.Call-point     = p-code AND
      329                  buf_usr-flt.user-name       = p-user-name
      330         no-error .
      331       if avail buf_usr-flt then do:
      332         assign
      333         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      334         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      335         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      336         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      337         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      338         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      339         .
      340       end.
      341       else do:
      342         assign
      343         p-List_        = (if v-use-List_       then "":U                    else ?)
      344         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      345         p-print-graft  = (if v-use-print-graft then no                      else ?)
      346         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      347         p-type-price   = (if v-use-type-price  then no                      else ?)
      348         p-type-val     = (if v-use-List_       then no                      else ?)
      349         .
      350       end.
      351     end.
      352   end procedure.
      353   procedure uf-set :
      354     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      355     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      356     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      357     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      358     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      359     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      360     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      361     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      362     do
      363     on error undo, return error
      364     :
      365       define buffer buf_usr-flt for ubflt.usr-flt .
      366       define variable v-use-List_     as logical   no-undo .
      367       define variable v-type-List_     as character no-undo .
      368       define variable v-format-List_   as character no-undo .
      369       define variable v-use-Naim      as logical   no-undo .
      370       define variable v-type-Naim      as character no-undo .
      371       define variable v-format-Naim    as character no-undo .
      372       define variable v-use-print-graft as logical   no-undo .
      373       define variable v-use-sort-gr   as logical   no-undo .
      374       define variable v-use-type-price as logical   no-undo .
      375       define variable v-use-type-val  as logical   no-undo .
      376       define variable v-tooltip        as character no-undo .
      377       define variable v-label          as character no-undo .
      378       define variable v-user-can-edit  as logical   no-undo .
      379       define variable v-output-display as logical   no-undo .
      380       define variable v-other          as character no-undo .
      381       run uf-name in this-procedure
      382         (input  entry(1, p-code, chr(4))
      383         ,output v-use-List_
      384         ,output v-type-List_
      385         ,output v-format-List_
      386         ,output v-use-Naim
      387         ,output v-type-Naim
      388         ,output v-format-Naim
      389         ,output v-use-print-graft
      390         ,output v-use-sort-gr
      391         ,output v-use-type-price
      392         ,output v-use-type-val
      393         ,output v-label
      394         ,output v-tooltip
      395         ,output v-user-can-edit
      396         ,output v-output-display
      397         ,output v-other
      398         ) no-error .
      399       if error-status :error then do:
      400         undo, return error return-value .
      401       end.
      402       find first buf_usr-flt where
      403                  buf_usr-flt.Call-point     = p-code AND
      404                  buf_usr-flt.user-name       = p-user-name
      405         no-error .
      406       if not avail buf_usr-flt then do:
      407           create buf_usr-flt .
      408           assign
      409           buf_usr-flt.call-point = p-code
      410           buf_usr-flt.user-name  = p-user-name
      411           .
      412       end.
      413       if avail buf_usr-flt then do:
      414        assign
      415        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      416        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      417        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      418        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      419        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      420        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      421       .
      422       release buf_usr-flt.
      423       end.
      424       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      425     end.
      426   end procedure.
      427   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      428   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      429   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      430   procedure cur-time :
      431      define output parameter p-today as date      no-undo .
      432      define output parameter p-time  as integer   no-undo .
      433     do
      434     on error undo, return error
      435     :
      436       define variable v-date1 as date      no-undo .
      437       define variable v-date2 as date      no-undo .
      438       define variable v-time  as integer   no-undo .
      439       assign
      440         v-date1 = today
      441         v-time  = time
      442         v-date2 = today
      443       .
      444       if v-date1 <> v-date2
      445       then do:
      446         assign
      447           v-date1 = today
      448           v-time  = v-time
      449         .
      450       end.
      451       assign
      452         p-today = v-date1
      453         p-time  = v-time
      454       .
      455     end.
      456   end.
      457   function cur-time-date returns character
      458   :
      459     return string(today, '99/99/9999':U) .
      460   end.
      461   function cur-time-mjd returns decimal
      462   :
      463     define variable v-date as date      no-undo .
      464     define variable v-time as integer   no-undo .
      465     run cur-time in this-procedure
      466       (output v-date
      467       ,output v-time
      468       ) .
      469     return integer(v-date) - 2400002 + (v-time / 86400) .
      470   end.
      471   function cur-time-get-ending-index returns integer
      472   (input p-number as integer
      473   )
      474   :
      475     if p-number < 0
      476     or p-number = ?
      477     then do:
      478       return 1 .
      479     end.
      480     define variable v-rest as integer   no-undo .
      481     assign
      482       p-number = p-number modulo 100
      483     .
      484     if p-number < 20
      485     then do:
      486       assign
      487         v-rest = p-number
      488       .
      489     end.
      490     else do:
      491       assign
      492         v-rest = p-number modulo 10
      493       .
      494     end.
      495     case v-rest :
      496       when 1
      497       then do:
      498         return 2 .
      499       end.
      500       when 2 or
      501       when 3 or
      502       when 4
      503       then do:
      504         return 3 .
      505       end.
      506       otherwise do:
      507         return 1 .
      508       end.
      509     end case .
      510   end.
      511   procedure cur-time-mjd-to-date :
      512      define input  parameter i-mjd-diff as decimal no-undo.
      513      define output parameter o-Date     as date    no-undo.
      514      define output parameter o-Time     as integer no-undo.
      515      define variable v-day-number as integer   no-undo .
      516      if    i-mjd-diff < 0
      517         or i-mjd-diff = ?
      518      then do:
      519         return "?" .
      520      end.
      521      assign
      522         v-day-number = truncate(i-mjd-diff,0).
      523         o-Date = date(v-day-number + 2400002).
      524         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      525     .
      526   end.
      527   function cur-time-mjd-to-string returns character
      528   (input p-mjd-diff as decimal
      529   )
      530   :
      531     define variable v-day-number as integer   no-undo .
      532     define variable v-seconds    as integer   no-undo .
      533     define variable v-hour       as integer   no-undo .
      534     define variable v-min        as integer   no-undo .
      535     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      536     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      537     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      538     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      539     if p-mjd-diff < 0
      540     or p-mjd-diff = ?
      541     then do:
      542       return "?" .
      543     end.
      544     assign
      545       v-day-number = integer(truncate(p-mjd-diff,0))
      546       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      547     .
      548     if v-seconds > 86400
      549     then do:
      550       assign
      551         v-seconds = 86400 - 1
      552       .
      553     end.
      554     if v-seconds < 0
      555     then do:
      556       assign
      557         v-seconds = 0
      558       .
      559     end.
      560     assign
      561       v-hour = truncate(v-seconds / 3600, 0)
      562     .
      563     assign
      564       v-seconds = v-seconds modulo 3600
      565     .
      566     assign
      567       v-min = truncate(v-seconds / 60, 0)
      568     .
      569     assign
      570       v-seconds = v-seconds modulo 60
      571     .
      572     return
      573         (if v-day-number <> 0
      574           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      575           else ""
      576         )
      577       + (if v-day-number <> 0 or v-hour <> 0
      578           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      579           else ""
      580         )
      581       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      582           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      583           else ""
      584         )
      585       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      586       .
      587   end.
      588   function cur-time-string returns character
      589   :
      590     define variable v-date as date      no-undo .
      591     define variable v-time as integer   no-undo .
      592     run cur-time in this-procedure
      593       (output v-date
      594       ,output v-time
      595       ) .
      596     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      597   end.
      598   function cur-time-string-sec returns character
      599   :
      600     define variable v-date as date      no-undo .
      601     define variable v-time as integer   no-undo .
      602     run cur-time in this-procedure
      603       (output v-date
      604       ,output v-time
      605       ) .
      606     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      607   end.
      608   function cur-time-custom  returns character
      609   (input p-prefix as character
      610   ,input p-date-format as character
      611   ,input p-delimiter as character
      612   ,input p-time-format as character
      613   ,input p-suffix as character
      614   )
      615   :
      616     define variable v-date as date      no-undo .
      617     define variable v-time as integer   no-undo .
      618     run cur-time in this-procedure
      619       (output v-date
      620       ,output v-time
      621       ) .
      622     return
      623       p-prefix
      624       + string(v-date, p-date-format)
      625       + p-delimiter
      626       + string(v-time, p-time-format)
      627       + p-suffix
      628       .
      629   end.
      630   function cur-time-print  returns character
      631   :
      632     define variable v-date as date      no-undo .
      633     define variable v-time as integer   no-undo .
      634     run cur-time in this-procedure
      635       (output v-date
      636       ,output v-time
      637       ) .
      638     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      639   end.
      640   function cur-time-datetime returns datetime
      641   :
      642     define variable v-char as character no-undo .
      643     define variable v-datetime as datetime no-undo .
      644     v-char = cur-time-string().
      645     v-datetime = datetime(v-char).
      646     return  v-datetime.
      647   end.
      648   function cur-time-string-msec returns character
      649   :
      650     define variable v-date as datetime  no-undo .
      651     v-date = now.
      652     return string(v-date) .
      653   end.
      654   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      655   procedure factord :
      656     define input  parameter p-fact-date            as date    no-undo .
      657     define input  parameter p-fact-time            as integer no-undo .
      658     define input  parameter p-fact-num             as integer no-undo .
      659     define input  parameter p-shift-date           as date    no-undo .
      660     define input  parameter p-shift-num            as integer no-undo .
      661     define input  parameter p-shift-on             as logical no-undo .
      662     define output parameter p-fact-order           as decimal no-undo .
      663     define output parameter p-shift-end-fact-order as decimal no-undo .
      664     define output parameter p-day-end-fact-order   as decimal no-undo .
      665     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      666     if p-fact-date = ?
      667     then do:
      668       return error "Не указана фактическая дата" .
      669     end.
      670     define variable v-fact-date-num as integer no-undo .
      671     assign
      672       v-fact-date-num = integer(p-fact-date)
      673     .
      674     if p-fact-num = ?
      675     or p-fact-num = 0
      676     then do:
      677       return error "Не задан p-fact-num " + string(p-fact-num) .
      678     end.
      679     if p-fact-num < 0
      680     then do:
      681       return error "Отрицательный fact-num " + string(p-fact-num) .
      682     end.
      683     if p-fact-num >= 100000000
      684     then do:
      685       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      686     end.
      687     if p-shift-on = true
      688     then do:
      689       if p-shift-date = ?
      690       then do:
      691         return error "Не задана дата смены" .
      692       end.
      693       if p-shift-num = ?
      694       or p-shift-num = 0
      695       then do:
      696         return error "Не задан номер смены" .
      697       end.
      698     end.
      699     else do:
      700       assign
      701         p-shift-date = p-fact-date
      702         p-shift-num  = 24
      703       .
      704     end.
      705     define variable v-shift-offset as integer no-undo .
      706     if p-shift-date = p-fact-date
      707     then do:
      708       assign
      709         v-shift-offset = 1
      710       .
      711     end.
      712     if p-shift-date < p-fact-date
      713     then do:
      714       assign
      715         v-shift-offset = 0
      716       .
      717     end.
      718     if p-shift-date > p-fact-date
      719     then do:
      720       message
      721         vss-workfile vss-revision vss-description skip
      722         "Неправильная дата закрытия смены" skip
      723         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      724         view-as alert-box error .
      725       undo, return error
      726         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      727           ,string(p-fact-date, '99/99/9999':U)
      728           ,string(p-shift-date, '99/99/9999':U)
      729           )
      730       .
      731     end.
      732     if p-shift-num < 1
      733     or p-shift-num > 24
      734     then do:
      735       message
      736         vss-workfile vss-revision vss-description skip
      737         "Неправильный номер смены" skip
      738         "p-shift-num" p-shift-num skip
      739         view-as alert-box error .
      740       undo, return error return-value .
      741     end.
      742     assign
      743       p-fact-order           = v-fact-date-num
      744                              + v-shift-offset * 0.5
      745                              + p-shift-num    * 0.02 - 0.01
      746                              + p-fact-num     * 0.0000000001
      747       p-shift-end-fact-order = v-fact-date-num
      748                              + v-shift-offset * 0.5
      749                              + p-shift-num    * 0.02
      750       p-day-end-fact-order   = v-fact-date-num
      751                              + 0.99
      752     .
      753     if p-fact-order           <= v-fact-date-num
      754     or p-shift-end-fact-order <= v-fact-date-num
      755     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      756     or p-shift-end-fact-order >= p-day-end-fact-order
      757     then do:
      758       message
      759         vss-workfile vss-revision vss-description skip
      760         "Внутренняя ошибка при генерации фактического номера" skip
      761         "p-fact-date"            p-fact-date            skip
      762         "p-fact-time"            p-fact-time            skip
      763         "p-fact-num"             p-fact-num             skip
      764         "p-shift-date"           p-shift-date           skip
      765         "p-shift-num"            p-shift-num            skip
      766         "p-shift-on"             p-shift-on             skip
      767         "p-shift-end-fact-order" p-shift-end-fact-order skip
      768         "p-day-end-fact-order"   p-day-end-fact-order   skip
      769         "v-fact-date-num"        v-fact-date-num        skip
      770         view-as alert-box error .
      771       undo, return error return-value .
      772     end.
      773   end procedure.
      774   procedure day-begin-fact-order :
      775     define input  parameter p-fact-date            as date    no-undo .
      776     define output parameter p-day-begin-fact-order as decimal no-undo .
      777     do
      778     on error undo, return error return-value
      779     :
      780       if p-fact-date = ?
      781       then do:
      782         assign
      783           p-day-begin-fact-order = 0
      784         .
      785       end.
      786       else do:
      787         assign
      788           p-day-begin-fact-order = integer(p-fact-date)
      789         .
      790       end.
      791     end.
      792   end procedure.
      793   procedure factord-max-fact-order :
      794     define output parameter p-max-fact-order as decimal   no-undo .
      795     do
      796     on error undo, return error return-value
      797     :
      798       run day-begin-fact-order in this-procedure
      799         (input  date(1, 1, 5000)
      800         ,output p-max-fact-order
      801         ) .
      802     end.
      803   end procedure.
      804   procedure factord-cut-archive :
      805     define input  parameter p-obj-type             as character no-undo .
      806     define input  parameter p-obj-code             as integer   no-undo .
      807     define input  parameter p-fact-date            as date      no-undo .
      808     define output parameter p-shift-on             as logical   no-undo .
      809     define output parameter p-shift-date           as date      no-undo .
      810     define output parameter p-shift-num            as integer   no-undo .
      811     define output parameter p-day-end-fact-order   as decimal   no-undo .
      812     define output parameter p-shift-end-fact-order as decimal   no-undo .
      813     define variable v-fact-order as decimal   no-undo .
      814     define buffer buf_shift-obj for ub.shift-obj .
      815     do
      816     on error undo, return error return-value
      817     :
      818   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      819   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      820     (input  p-obj-type
      821     ,input  p-obj-code
      822     ,input  'shift-on=request'
      823     ,output p-shift-on
      824     ) no-error .
      825       if error-status :error
      826       then do:
      827         message
      828           vss-workfile vss-revision vss-description skip
      829           "Ошибка при определении атрибута объекта" skip
      830           "Объект" p-obj-type p-obj-code skip
      831           error-status :get-message(1) skip
      832           return-value skip
      833           view-as alert-box error .
      834         undo, return error return-value .
      835       end.
      836       if p-shift-on = false
      837       then do:
      838         assign
      839           p-shift-date               = ?
      840           p-shift-num                = 0
      841         .
      842       end.
      843       else do:
      844         find first buf_shift-obj share-lock
      845           where buf_shift-obj.obj-type   = p-obj-type
      846             and buf_shift-obj.obj-code   = p-obj-code
      847             and buf_shift-obj.shift-date > p-fact-date
      848           use-index pi
      849           no-error .
      850         if not available buf_shift-obj
      851         or buf_shift-obj.status_ <> 'зкр':U
      852         then do:
      853           message
      854             vss-workfile vss-revision vss-description skip
      855             "Невозможно вычислить последнюю смену" skip
      856             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      857             "Объект" p-obj-type p-obj-code skip
      858             "Дата" p-fact-date skip
      859             view-as alert-box error .
      860           undo, return error return-value .
      861         end.
      862         find last buf_shift-obj share-lock
      863           where buf_shift-obj.obj-type = p-obj-type
      864             and buf_shift-obj.obj-code = p-obj-code
      865             and buf_shift-obj.shift-date <= p-fact-date
      866           use-index pi
      867           no-error .
      868         if available buf_shift-obj
      869         then do:
      870           if  buf_shift-obj.status_ = 'зкр':U
      871           then do:
      872             assign
      873               p-shift-date = buf_shift-obj.shift-date
      874               p-shift-num  = buf_shift-obj.shift-num
      875             .
      876           end.
      877           else do:
      878             message
      879               vss-workfile vss-revision vss-description skip
      880               "Невозможно вычислить последнюю смену" skip
      881               "Статус смены отличен от статуса" 'зкр':U skip
      882               "Объект" p-obj-type p-obj-code skip
      883               "Дата" p-fact-date skip
      884               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      885               view-as alert-box error .
      886             undo, return error return-value .
      887           end.
      888         end.
      889         else do:
      890           assign
      891             p-shift-date = p-fact-date - 1
      892             p-shift-num  = 1
      893           .
      894         end.
      895       end.
      896       run factord in this-procedure
      897         (input  p-fact-date
      898         ,input  1
      899         ,input  1
      900         ,input  p-shift-date
      901         ,input  p-shift-num
      902         ,input  p-shift-on
      903         ,output v-fact-order
      904         ,output p-shift-end-fact-order
      905         ,output p-day-end-fact-order
      906         ) no-error .
      907       if error-status :error
      908       then do:
      909         message
      910           vss-workfile vss-revision vss-description skip
      911           "Ошибка при вызове процедуры factord"
      912           error-status :get-message(1) skip
      913           return-value skip
      914           view-as alert-box error .
      915         undo, return error return-value .
      916       end.
      917     end.
      918   end procedure.
      919   procedure factord-lock-shift :
      920     define input  parameter p-obj-type  as character no-undo .
      921     define input  parameter p-obj-code  as integer   no-undo .
      922     define input  parameter p-fact-date as date      no-undo .
      923     define parameter buffer buf_shift-obj for ub.shift-obj .
      924     define variable v-shift-on      as logical   no-undo .
      925     define variable v-extra-message as character no-undo .
      926     define variable v-error as character no-undo .
      927     do
      928     on error undo, return error return-value
      929     :
      930   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      931   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      932     (input  p-obj-type
      933     ,input  p-obj-code
      934     ,input  'shift-on=request'
      935     ,output v-shift-on
      936     ) no-error .
      937       if error-status :error
      938       then do:
      939         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      940         undo, return error v-error .
      941       end.
      942       if v-shift-on = true
      943       then do:
      944         find first buf_shift-obj share-lock
      945           where buf_shift-obj.obj-type   = p-obj-type
      946             and buf_shift-obj.obj-code   = p-obj-code
      947             and buf_shift-obj.shift-date > p-fact-date
      948           use-index pi
      949           no-error .
      950         if not available buf_shift-obj
      951         or buf_shift-obj.status_ <> 'зкр':U
      952         then do:
      953           find last buf_shift-obj
      954             where buf_shift-obj.obj-type = p-obj-type
      955               and buf_shift-obj.obj-code = p-obj-code
      956               and buf_shift-obj.status_  = 'зкр':U
      957             use-index stts
      958             no-error .
      959           if available buf_shift-obj
      960           then do:
      961             assign
      962               v-extra-message =
      963                     substitute("Дата начала последеней закрытой смены на объекте &1"
      964                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      965                               )
      966             .
      967           end.
      968           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      969           undo, return error v-error .
      970         end.
      971       end.
      972     end.
      973   end procedure.
      974   procedure factord-end-day :
      975     define input  parameter p-fact-date            as date    no-undo .
      976     define output parameter p-day-end-fact-order   as decimal no-undo .
      977     do
      978     on error undo, return error return-value
      979     :
      980       if p-fact-date = ?
      981       then do:
      982         return error "Не указана фактическая дата" .
      983       end.
      984       assign
      985         p-day-end-fact-order = integer(p-fact-date) + 0.99
      986       .
      987     end.
      988   end procedure.
      989   procedure factord-to-date :
      990     define input  parameter p-fact-order as decimal no-undo .
      991     define output parameter p-fact-date  as date    no-undo .
      992     define variable v-ref-date  as date      no-undo .
      993     define variable v-ref-delta as integer   no-undo .
      994     do
      995     on error undo, return error return-value
      996     :
      997       if p-fact-order = ?
      998       or p-fact-order = 0
      999       then do:
     1000         return error "Не указан fact-order" .
     1001       end.
     1002       assign
     1003         v-ref-date  = date(1, 1, 2000)
     1004       .
     1005       assign
     1006         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1007       .
     1008       assign
     1009         p-fact-date = v-ref-date + v-ref-delta
     1010       .
     1011     end.
     1012   end procedure.
     1013   procedure factord-to-fact-num :
     1014     define input  parameter p-fact-order as decimal no-undo .
     1015     define output parameter p-fact-num   as integer no-undo .
     1016     define variable v-fact-order-trunc as decimal no-undo .
     1017     do
     1018     on error undo, return error return-value
     1019     :
     1020       if p-fact-order = ?
     1021       or p-fact-order = 0
     1022       then do:
     1023         return error "Не указан fact-order" .
     1024       end.
     1025       assign
     1026        v-fact-order-trunc = truncate(p-fact-order, 2)
     1027       .
     1028       assign
     1029         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1030       .
     1031     end.
     1032   end procedure.
     1033   procedure factord-to-shift-num :
     1034     define input  parameter p-fact-order as decimal no-undo .
     1035     define output parameter p-shift-num   as integer no-undo .
     1036     define variable  p-shift-numd  as decimal   no-undo .
     1037     define variable v-fact-order-trunc as decimal no-undo .
     1038     do
     1039     on error undo, return error return-value
     1040     :
     1041       if p-fact-order = ?
     1042       or p-fact-order = 0
     1043       then do:
     1044         return error "Не указан fact-order" .
     1045       end.
     1046       assign
     1047        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1048       .
     1049       if v-fact-order-trunc < 0.5 then do:
     1050         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1051       end.
     1052       assign
     1053         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1054         .
     1055        assign
     1056         p-shift-num = truncate (p-shift-numd , 0)
     1057       .
     1058     end.
     1059   end procedure.
     1060   procedure fact-order-mpl :
     1061     do
     1062     on error undo, return error return-value
     1063     :
     1064   define input  parameter p-doc-date as date     no-undo .
     1065   define input  parameter p-obj-type as character no-undo .
     1066   define input  parameter p-obj-code as integer   no-undo .
     1067   define output parameter p-fact-order as decimal   no-undo .
     1068   define variable v-fact-date            as date    no-undo .
     1069   define variable v-fact-time            as integer no-undo .
     1070   define variable v-fact-order           as decimal no-undo .
     1071   define variable v-shift-end-fact-order as decimal no-undo .
     1072   define variable v-day-end-fact-order   as decimal no-undo .
     1073   define variable l-shift-on as logical no-undo .
     1074   define variable l-date as date      no-undo .
     1075   define variable l-time as integer   no-undo .
     1076   define variable shift-date as date      no-undo .
     1077   define variable shift-num  as integer   no-undo .
     1078   define variable shift-name as character no-undo .
     1079   define variable max-fact-order as decimal   no-undo .
     1080   define buffer buf_global-state for ub.global-state  .
     1081   find first buf_global-state no-lock no-error .
     1082   if not available buf_global-state then do:
     1083      message
     1084        "Не заданы параметры ценообразования!"
     1085        view-as alert-box error
     1086      .
     1087      return error return-value .
     1088   end.
     1089     run cur-time in this-procedure
     1090     ( output v-fact-date ,
     1091       output v-fact-time  ).
     1092   if p-doc-date = ? then do:
     1093   if buf_global-state.pl-use-sys-date-time  = true then do:
     1094         run factord in this-procedure
     1095           (input  v-fact-date
     1096           ,input  v-fact-time
     1097           ,input  v-fact-time
     1098           ,input  ?
     1099           ,input  ?
     1100           ,input  false
     1101           ,output v-fact-order
     1102           ,output v-shift-end-fact-order
     1103           ,output v-day-end-fact-order
     1104           ) no-error .
     1105         if error-status :error
     1106         or v-fact-order = ?
     1107         or v-fact-order = 0 then do:
     1108           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1109         end.
     1110         p-fact-order = v-fact-order .
     1111   end.
     1112   else do:
     1113   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1114   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1115     (input  p-obj-type
     1116     ,input  p-obj-code
     1117     ,input  'shift-on=request'
     1118     ,output l-shift-on
     1119     ) no-error .
     1120         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     1121         if p-doc-date <> ? then do:
     1122         end.
     1123          run gbl/factdate.p
     1124          ( input        p-obj-type  ,
     1125            input        p-obj-code  ,
     1126            input-output v-fact-date ,
     1127            input-output v-fact-time ,
     1128            input-output shift-date      ,
     1129            input-output shift-num       ,
     1130            input-output shift-name      ,
     1131            input        yes
     1132            ) no-error .
     1133         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     1134         run factord in this-procedure
     1135           (input  v-fact-date
     1136           ,input  v-fact-time
     1137           ,input  v-fact-time
     1138           ,input  shift-date
     1139           ,input  shift-num
     1140           ,input  l-shift-on
     1141           ,output v-fact-order
     1142           ,output v-shift-end-fact-order
     1143           ,output v-day-end-fact-order
     1144           ) no-error .
     1145         if error-status :error
     1146         or v-fact-order = ?
     1147         or v-fact-order = 0 then do:
     1148           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1149         end.
     1150         p-fact-order = v-fact-order .
     1151   end.
     1152   end.
     1153   else do:
     1154          run gbl/factdate.p
     1155          ( input        p-obj-type  ,
     1156            input        p-obj-code  ,
     1157            input-output v-fact-date ,
     1158            input-output v-fact-time ,
     1159            input-output shift-date      ,
     1160            input-output shift-num       ,
     1161            input-output shift-name      ,
     1162            input        yes
     1163            ) no-error .
     1164         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1165         v-fact-date = p-doc-date .
     1166         run factord in this-procedure
     1167           (input  v-fact-date
     1168           ,input  v-fact-time
     1169           ,input  v-fact-time
     1170           ,input  shift-date
     1171           ,input  shift-num
     1172           ,input  l-shift-on
     1173           ,output v-fact-order
     1174           ,output v-shift-end-fact-order
     1175           ,output v-day-end-fact-order
     1176           ) no-error .
     1177         if error-status :error
     1178         or v-fact-order = ?
     1179         or v-fact-order = 0 then do:
     1180           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1181         end.
     1182         p-fact-order = v-fact-order .
     1183   end.
     1184     end.
     1185   end procedure.
     1186   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
     1187   field sale-qnty as decimal
     1188   field sale-sum  as decimal
     1189   field sale-tnv  as decimal
     1190   field price-sale-base as decimal
     1191   field price-sale-rubl as decimal
     1192   field road-tax-base   as decimal
     1193   field road-tax-rubl   as decimal
     1194   field excise-base as decimal
     1195   field excise-rubl as decimal
     1196   field date-1 as date
     1197   field date-2 as date
     1198   field shift-1 as int
     1199   field shift-2 as int
     1200   field time-1 as int
     1201   field time-2 as int
     1202   field grp-name as char
     1203   field interv-name as char
     1204   field pay-name as char
     1205   field unit-cli as char
     1206   index pi
     1207   plt-priority DESCENDING
     1208   fact-order DESCENDING
     1209   qnty-from asc
     1210   sum-from asc
     1211   turnover-from asc
     1212   date-1 DESCENDING
     1213   time-1 DESCENDING
     1214   date-2 DESCENDING
     1215   time-2 DESCENDING
     1216   type-price DESCENDING
     1217   .
     1218   procedure mpl-autoprice :
     1219   define input  parameter p-only-b-code as logical   no-undo .
     1220   define input  parameter p-cli-type    as character no-undo .
     1221   define input  parameter p-cli-code    as integer   no-undo .
     1222   define input  parameter p-main-b-code as integer   no-undo .
     1223   define input  parameter p-b-code      as integer   no-undo .
     1224   define input  parameter p-obj-type    as character no-undo .
     1225   define input  parameter p-obj-code    as integer   no-undo .
     1226   define input  parameter p-qnty-doc    as decimal   no-undo .
     1227   define input  parameter p-sum-doc     as decimal   no-undo .
     1228   define input  parameter p-vid-pay        as character no-undo .
     1229   define input  parameter p-cash-pay-type  as character no-undo .
     1230   define input  parameter p-fact-order  as decimal   no-undo .
     1231   define output parameter p-plt-id          as integer   no-undo .
     1232   define output parameter p-plt-db-num      as integer   no-undo .
     1233   define output parameter p-pdf-id          as integer   no-undo .
     1234   define output parameter p-pdf-db-num      as integer   no-undo .
     1235   define output parameter p-sale-price-base as decimal   no-undo .
     1236   define output parameter p-sale-price-rubl as decimal   no-undo .
     1237   define output parameter p-road-tax-base as decimal   no-undo .
     1238   define output parameter p-road-tax-rubl as decimal   no-undo .
     1239   define output parameter p-excise-base   as decimal   no-undo .
     1240   define output parameter p-excise-rubl   as decimal   no-undo .
     1241   define variable v-cli-oborot-ALL as decimal   no-undo .
     1242   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     1243   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     1244   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1245   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1246   define buffer buf_price-all              for ub.price-all  .
     1247   define buffer buf_goods                  for ub.goods      .
     1248   define buffer buf_global-state           for ub.global-state  .
     1249   define buffer buf_buyer-group            for ub.buyer-group  .
     1250   define buffer buf_turnover-group         for ub.turnover-group  .
     1251   define buffer buf_main-code              for ub.bar-code  .
     1252   define buffer buf_bar-code               for ub.bar-code  .
     1253   define buffer buf_pay-type               for ub.pay-type  .
     1254   define buffer buf_cash-pay               for ub.cash-pay  .
     1255   define variable to-day          as date      no-undo .
     1256   define variable v-base-rate0    as decimal   no-undo .
     1257   define variable v-base-scale0   as decimal   no-undo .
     1258   define variable v-exch-rate0    as decimal   no-undo .
     1259   define variable v-exch-scale0   as decimal   no-undo .
     1260   define variable v-base-rate     as decimal   no-undo .
     1261   define variable v-base-scale    as decimal   no-undo .
     1262   define variable v-exch-rate     as decimal   no-undo .
     1263   define variable v-exch-scale    as decimal   no-undo .
     1264   define variable v-host-code     as integer   no-undo .
     1265   define variable v-curr-abbr     as character no-undo .
     1266   define variable v-grp-name      as character no-undo .
     1267   define variable v-date-1        as date      no-undo .
     1268   define variable v-date-2        as date      no-undo .
     1269   define variable v-interv        as character no-undo .
     1270   define variable v-pay-name      as character no-undo .
     1271   define variable v-cli-oborot    as decimal   no-undo .
     1272   define variable v-trn-pay-code  as integer   no-undo .
     1273   define variable v-cash-pay-curr as integer   no-undo .
     1274   define variable v-cash-pay-code as integer   no-undo .
     1275   do
     1276   on error undo, return error return-value
     1277   :
     1278   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     1279   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     1280   if p-fact-order = ? then do:
     1281     run fact-order-mpl (
     1282         input   today       ,
     1283         input   p-obj-type  ,
     1284         input   p-obj-code  ,
     1285         output  p-fact-order ).
     1286   end.
     1287   if p-vid-pay <> "" then do:
     1288      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     1289      if available buf_pay-type
     1290         then v-trn-pay-code = buf_pay-type.obj-code.
     1291         else v-trn-pay-code =  0.
     1292   end.
     1293   else v-trn-pay-code = 0 .
     1294   if p-cash-pay-type <> "" then do:
     1295      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1296      if available buf_pay-type
     1297         then
     1298           assign
     1299             v-cash-pay-curr = buf_cash-pay.curr-code
     1300             v-cash-pay-code = buf_cash-pay.cdpay-code
     1301           .
     1302         else
     1303           assign
     1304             v-cash-pay-curr = 0
     1305             v-cash-pay-code = 0
     1306             .
     1307   end.
     1308   else
     1309     assign
     1310       v-cash-pay-curr = 0
     1311       v-cash-pay-code = 0
     1312       .
     1313   for each tt_price-all  : delete tt_price-all . end.
     1314   assign
     1315     p-plt-id             = ?
     1316     p-plt-db-num         = ?
     1317     p-pdf-id             = ?
     1318     p-pdf-db-num         = ?
     1319     p-sale-price-base    = ?
     1320     p-sale-price-rubl    = ?
     1321     v-cli-oborot         = 0
     1322   .
     1323   find first buf_global-state no-lock no-error .
     1324   if not available buf_global-state then do:
     1325      message
     1326        "Не заданы параметры ценообразования!"
     1327        view-as alert-box error
     1328      .
     1329      return error return-value .
     1330   end.
     1331   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1332   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1333     (input  p-obj-type
     1334     ,input  p-obj-code
     1335     ,output to-day
     1336     )  .
     1337   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1339     (input  p-obj-type
     1340     ,input  p-obj-code
     1341     ,output v-host-code
     1342     )  .
     1343   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1344   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1345     (input  v-host-code
     1346     ,input  to-day
     1347     ,output v-base-rate0
     1348     ,output v-base-scale0
     1349     )  .
     1350     v-cli-oborot-ALL  = 0 .
     1351     for each buf_turnover-buyer-main no-lock  where
     1352              buf_turnover-buyer-main.cli-type = p-cli-type  and
     1353              buf_turnover-buyer-main.cli-code = p-cli-code
     1354              :
     1355              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1356     end.
     1357   for each buf_price-all no-lock where
     1358            buf_price-all.obj-type = p-obj-type and
     1359            buf_price-all.obj-code = p-obj-code and
     1360            buf_price-all.gds-code = buf_goods.gds-code and
     1361            buf_price-all.status_  = 'акт':U  and
     1362          ( p-only-b-code = false   or
     1363          ( buf_price-all.b-code = p-main-b-code or
     1364            buf_price-all.b-code = p-b-code))    and
     1365           ( p-only-b-code = true  or
     1366             buf_price-all.b-code = p-b-code)
     1367             and
     1368             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1369           ( buf_price-all.fact-order-sys-to = ? or
     1370             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1371           :
     1372            v-interv   = "" .
     1373            v-grp-name = "" .
     1374            v-pay-name = "" .
     1375            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1376            if buf_price-all.bgr-id > 0 then do:
     1377               find first buf_buyer-group no-lock where
     1378                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1379                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1380               if available buf_buyer-group then do:
     1381                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1382                  find first buf_buyer-in-buyer-group no-lock where
     1383                             buf_buyer-in-buyer-group.stts         = 0 and
     1384                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1385                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1386                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1387                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1388                             no-error .
     1389                             if not available buf_buyer-in-buyer-group then do:
     1390                                v-grp-name = "".
     1391                                next.
     1392                             end.
     1393                             v-grp-name = buf_buyer-group.name .
     1394                  end.
     1395               end.
     1396               else do:
     1397                    v-grp-name = "".
     1398                    next.
     1399               end.
     1400            end.
     1401            if buf_price-all.tog-id > 0 then do:
     1402               find first buf_turnover-group no-lock where
     1403                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1404                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1405               if available buf_turnover-group then do:
     1406                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1407                     v-cli-oborot = v-cli-oborot-all  .
     1408                     find first buf1_tnv-in-turnover-group no-lock where
     1409                                buf1_tnv-in-turnover-group.stts       =  0     and
     1410                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1411                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1412                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1413                     find first buf2_tnv-in-turnover-group no-lock where
     1414                                buf2_tnv-in-turnover-group.stts       =  0     and
     1415                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1416                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1417                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1418                     if not (available buf1_tnv-in-turnover-group and
     1419                             available buf2_tnv-in-turnover-group ) then do:
     1420                             v-grp-name = "".
     1421                             next .
     1422                     end.
     1423                     v-grp-name = buf_turnover-group.name.
     1424                  end.
     1425               end.
     1426               else do:
     1427                    v-grp-name = "".
     1428                    next.
     1429               end.
     1430            end.
     1431            if buf_price-all.plt-fix-cource-crc-base = true then
     1432               assign
     1433                 v-base-rate  = buf_price-all.pdf-base-rate
     1434                 v-base-scale = buf_price-all.pdf-base-scale
     1435               .
     1436               else
     1437               assign
     1438                 v-base-rate  = v-base-rate0
     1439                 v-base-scale = v-base-scale0
     1440               .
     1441            if buf_price-all.plt-fix-cource-crc-doc = true then
     1442               assign
     1443                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1444                 v-exch-scale = buf_price-all.pdf-exch-scale
     1445               .
     1446               else do:
     1447   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1448   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1449     (input  buf_price-all.curr-code
     1450     ,input  to-day
     1451     ,output v-exch-rate0
     1452     ,output v-exch-scale0
     1453     ,output v-curr-abbr
     1454     )  .
     1455               assign
     1456                 v-exch-rate  = v-exch-rate0
     1457                 v-exch-scale = v-exch-scale0
     1458                 .
     1459              end.
     1460              v-date-1 = date ( "" )  .
     1461              if buf_price-all.fact-order-sys-from > 0 then do:
     1462                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1463                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1464                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1465              end.
     1466              v-date-2 =  date ( "" )  .
     1467              if buf_price-all.fact-order-sys-to > 0 then do:
     1468                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1469                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1470                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1471              end.
     1472              if buf_price-all.qnty-from <> ? then do :
     1473                 if not (
     1474                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1475                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1476                 ) then do:
     1477                        v-interv = "".
     1478                        next.
     1479                 end.
     1480                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1481              end.
     1482              if buf_price-all.sum-from <> ? then do :
     1483                 if not (
     1484                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1485                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1486                 ) then do:
     1487                    v-interv = "".
     1488                    next.
     1489                 end.
     1490                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1491              end.
     1492              if buf_price-all.turnover-from <> ? then do :
     1493                 if not (
     1494                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1495                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1496                 ) then do:
     1497                    v-interv = "".
     1498                    next.
     1499                 end.
     1500                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1501              end.
     1502              if buf_price-all.use-pay-type = 1 then do :
     1503                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     1504                    v-pay-name = "" .
     1505                    next.
     1506                  end.
     1507                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     1508              end.
     1509              if buf_price-all.use-cash-pay = 1 then do :
     1510                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     1511                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     1512                   v-pay-name = "" .
     1513                   next.
     1514                 end.
     1515                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     1516              end.
     1517             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     1518             create tt_price-all .
     1519             buffer-copy buf_price-all to tt_price-all
     1520             assign
     1521               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     1522               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     1523               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     1524               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     1525               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     1526               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     1527               tt_price-all.price-sale     = buf_price-all.price-sale
     1528               tt_price-all.road-tax       = buf_price-all.road-tax
     1529               tt_price-all.excise         = buf_price-all.excise
     1530               tt_price-all.pdf-exch-rate   = v-exch-rate
     1531               tt_price-all.pdf-exch-scale  = v-exch-scale
     1532               tt_price-all.pdf-base-rate   = v-base-rate
     1533               tt_price-all.pdf-base-scale  = v-base-scale
     1534               tt_price-all.grp-name        = v-grp-name
     1535               tt_price-all.date-1          = v-date-1
     1536               tt_price-all.shift-1         = buf_price-all.start-shift-num
     1537               tt_price-all.time-1          = buf_price-all.start-sys-time
     1538               tt_price-all.date-2          = v-date-2
     1539               tt_price-all.shift-2         = buf_price-all.end-shift-num
     1540               tt_price-all.time-2          = buf_price-all.end-sys-time
     1541               tt_price-all.interv-name     = v-interv
     1542               tt_price-all.pay-name        = v-pay-name
     1543               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     1544             .
     1545   end.
     1546   define variable vt-plt-id as integer   no-undo .
     1547   define variable vt-plt-db as integer   no-undo .
     1548   define variable vt-pdf-id as integer   no-undo .
     1549   define variable vt-pdf-db as integer   no-undo .
     1550   define buffer neos_price-all for tt_price-all  .
     1551   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     1552       if available tt_price-all then do:
     1553        assign
     1554          vt-plt-id = tt_price-all.plt-id
     1555          vt-plt-db = tt_price-all.plt-db-num
     1556          vt-pdf-id = tt_price-all.pdf-id
     1557          vt-pdf-db = tt_price-all.pdf-db
     1558        .
     1559        if tt_price-all.b-code = p-b-code then do:
     1560             assign
     1561               p-plt-id           = tt_price-all.plt-id
     1562               p-plt-db-num       = tt_price-all.plt-db-num
     1563               p-pdf-id           = tt_price-all.pdf-id
     1564               p-pdf-db-num       = tt_price-all.pdf-db
     1565               p-sale-price-base  = tt_price-all.price-sale-base
     1566               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1567               p-road-tax-base    = tt_price-all.road-tax-base
     1568               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1569               p-excise-base      = tt_price-all.excise-base
     1570               p-excise-rubl      = tt_price-all.excise-rubl
     1571               .
     1572        end.
     1573        else do:
     1574          find first neos_price-all where
     1575                     neos_price-all.b-code     = p-b-code  and
     1576                     neos_price-all.plt-id     = vt-plt-id and
     1577                     neos_price-all.plt-db-num = vt-plt-db and
     1578                     neos_price-all.pdf-id     = vt-pdf-id and
     1579                     neos_price-all.pdf-db     = vt-pdf-db
     1580                     use-index pi no-error .
     1581            if available neos_price-all then do:
     1582             assign
     1583               p-plt-id           = tt_price-all.plt-id
     1584               p-plt-db-num       = tt_price-all.plt-db-num
     1585               p-pdf-id           = tt_price-all.pdf-id
     1586               p-pdf-db-num       = tt_price-all.pdf-db
     1587               p-sale-price-base  = neos_price-all.price-sale-base
     1588               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1589               p-road-tax-base    = neos_price-all.road-tax-base
     1590               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1591               p-excise-base      = neos_price-all.excise-base
     1592               p-excise-rubl      = neos_price-all.excise-rubl
     1593               .
     1594            end.
     1595            else do:
     1596                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1597                 if error-status :error    then do:
     1598                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1599                   return error return-value .
     1600                 end.
     1601             assign
     1602               p-plt-id           = tt_price-all.plt-id
     1603               p-plt-db-num       = tt_price-all.plt-db-num
     1604               p-pdf-id           = tt_price-all.pdf-id
     1605               p-pdf-db-num       = tt_price-all.pdf-db
     1606               p-sale-price-base  = tt_price-all.price-sale-base
     1607               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1608               p-road-tax-base    = tt_price-all.road-tax-base
     1609               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1610               p-excise-base      = tt_price-all.excise-base
     1611               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     1612               .
     1613            end.
     1614        end.
     1615     end.
     1616   end.
     1617   end procedure.
     1618   procedure mpl-tpl-auto :
     1619   define input  parameter p-b-code     as integer   no-undo .
     1620   define input  parameter p-obj-type   as character no-undo .
     1621   define input  parameter p-obj-code   as integer   no-undo .
     1622   define input  parameter p-plt-id     as integer   no-undo .
     1623   define input  parameter p-plt-db-num as integer   no-undo .
     1624   define input  parameter p-fact-order as decimal   no-undo .
     1625   define output parameter p-sale-price as decimal   no-undo .
     1626   define output parameter p-pdf-id     as integer   no-undo .
     1627   define output parameter p-pdf-db-num as integer   no-undo .
     1628     do
     1629     on error undo, return error return-value
     1630     :
     1631   if p-fact-order = ? then do:
     1632     run fact-order-mpl (
     1633         input   today       ,
     1634         input   p-obj-type  ,
     1635         input   p-obj-code  ,
     1636         output  p-fact-order ) .
     1637   end.
     1638   assign
     1639     p-pdf-id      = ?
     1640     p-pdf-db-num  = ?
     1641     p-sale-price  = ?
     1642   .
     1643   define buffer buf_bar-code for ub.bar-code  .
     1644   define buffer buf_goods for ub.goods  .
     1645   find first buf_bar-code no-lock where
     1646              buf_bar-code.b-code = p-b-code
     1647              no-error .
     1648   if error-status :error then return error return-value .
     1649   find first buf_goods no-lock where
     1650              buf_goods.gds-code = buf_bar-code.gds-code
     1651              no-error .
     1652   if error-status :error then return error return-value .
     1653   define variable v-main-b-code as integer   no-undo .
     1654   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1655     (input  buf_goods.gds-code
     1656     ,input  ?
     1657     ,output v-main-b-code
     1658     )  .
     1659   define buffer buf_price-all for ub.price-all  .
     1660   for each tt_price-all : delete tt_price-all. end.
     1661       for each buf_price-all no-lock where
     1662               buf_price-all.plt-id     = p-plt-id                 and
     1663               buf_price-all.plt-db-num = p-plt-db-num             and
     1664               buf_price-all.obj-type   = p-obj-type               and
     1665               buf_price-all.obj-code   = p-obj-code               and
     1666               buf_price-all.gds-code   = buf_goods.gds-code       and
     1667             ( buf_price-all.b-code = v-main-b-code or
     1668               buf_price-all.b-code = p-b-code)    and
     1669               buf_price-all.status_    = 'акт':U         and
     1670               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1671             ( buf_price-all.fact-order-sys-to = ? or
     1672               buf_price-all.fact-order-sys-to >=  p-fact-order)
     1673               :
     1674                 create tt_price-all .
     1675                 buffer-copy buf_price-all to tt_price-all
     1676                 assign
     1677                   tt_price-all.price-sale  = buf_price-all.price-sale
     1678                 .
     1679       end.
     1680   define variable vt-plt-id as integer   no-undo .
     1681   define variable vt-plt-db as integer   no-undo .
     1682   define variable vt-pdf-id as integer   no-undo .
     1683   define variable vt-pdf-db as integer   no-undo .
     1684   define buffer neos_price-all for tt_price-all  .
     1685   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     1686       if available tt_price-all then do:
     1687        assign
     1688          vt-plt-id = tt_price-all.plt-id
     1689          vt-plt-db = tt_price-all.plt-db-num
     1690          vt-pdf-id = tt_price-all.pdf-id
     1691          vt-pdf-db = tt_price-all.pdf-db
     1692        .
     1693        if tt_price-all.b-code = p-b-code then do:
     1694             assign
     1695               p-plt-id           = tt_price-all.plt-id
     1696               p-plt-db-num       = tt_price-all.plt-db-num
     1697               p-pdf-id           = tt_price-all.pdf-id
     1698               p-pdf-db-num       = tt_price-all.pdf-db
     1699               p-sale-price       = tt_price-all.price-sale
     1700               .
     1701        end.
     1702        else do:
     1703          find first neos_price-all where
     1704                     neos_price-all.b-code     = p-b-code  and
     1705                     neos_price-all.plt-id     = vt-plt-id and
     1706                     neos_price-all.plt-db-num = vt-plt-db and
     1707                     neos_price-all.pdf-id     = vt-pdf-id and
     1708                     neos_price-all.pdf-db     = vt-pdf-db
     1709                     use-index pi no-error .
     1710            if available neos_price-all then do:
     1711             assign
     1712               p-plt-id           = tt_price-all.plt-id
     1713               p-plt-db-num       = tt_price-all.plt-db-num
     1714               p-pdf-id           = tt_price-all.pdf-id
     1715               p-pdf-db-num       = tt_price-all.pdf-db
     1716               p-sale-price       = neos_price-all.price-sale
     1717               .
     1718            end.
     1719            else do:
     1720           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1721           if error-status :error    then do:
     1722              message "Не найден бар-код" p-b-code view-as alert-box error .
     1723              return error return-value .
     1724           end.
     1725             assign
     1726               p-plt-id           = tt_price-all.plt-id
     1727               p-plt-db-num       = tt_price-all.plt-db-num
     1728               p-pdf-id           = tt_price-all.pdf-id
     1729               p-pdf-db-num       = tt_price-all.pdf-db
     1730               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     1731               .
     1732            end.
     1733        end.
     1734     end.
     1735     end.
     1736   end procedure.
     1737   define variable stime-1 as character no-undo .
     1738   define variable stime-2 as character no-undo .
     1739   define variable v-t-doc as decimal   no-undo .
     1740   define variable is-color as logical   no-undo .
     1741   define buffer buf_global-state       for ub.global-state  .
     1742   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1743   DEFINE BUTTON B-color
     1744        IMAGE-UP FILE "cmp/color.bmp":U
     1745        IMAGE-DOWN FILE "cmp/color.bmp":U
     1746        IMAGE-INSENSITIVE FILE "cmp/color.bmp":U
     1747        LABEL ""
     1748        SIZE 3 BY 1 TOOLTIP "Цветовое выделение на экране".
     1749   DEFINE BUTTON B-Help
     1750        LABEL "Помощ&ь"
     1751        SIZE 10 BY 1
     1752        BGCOLOR 8 .
     1753   DEFINE BUTTON B-pdf
     1754        LABEL "&ДНЦ"
     1755        SIZE 11 BY 1.
     1756   DEFINE BUTTON B-price-doc
     1757        LABEL "Пе&реоценка"
     1758        SIZE 11 BY 1.
     1759   DEFINE BUTTON B-quit AUTO-END-KEY
     1760        LABEL "Отмена"
     1761        SIZE 10 BY 1
     1762        BGCOLOR 8 .
     1763   DEFINE BUTTON B-save AUTO-GO
     1764        LABEL "Выбор"
     1765        SIZE 10 BY 1
     1766        BGCOLOR 8 .
     1767   DEFINE VARIABLE date-f AS DATE FORMAT "99/99/9999":U
     1768        LABEL "Список цен на"
     1769         VIEW-AS TEXT
     1770        SIZE 14 BY .67
     1771        FGCOLOR 4  NO-UNDO.
     1772   DEFINE VARIABLE time-f AS CHARACTER FORMAT "X(256)":U
     1773         VIEW-AS TEXT
     1774        SIZE 14.38 BY .67
     1775        FGCOLOR 4  NO-UNDO.
     1776   DEFINE QUERY BROWSE-3 FOR
     1777         tt_price-all,
     1778         buf_currency SCROLLING.
     1779   DEFINE BROWSE BROWSE-3
     1780     QUERY BROWSE-3 NO-LOCK DISPLAY
     1781         tt_price-all.plt-priority COLUMN-LABEL "Приор!итет" FORMAT ">>>>9":U
     1782         tt_price-all.b-code FORMAT "999999999":U
     1783         tt_price-all.unit-cli COLUMN-LABEL "Ед!изм" FORMAT "X(3)":U
     1784         buf_currency.curr-abbr COLUMN-LABEL "Вал" FORMAT "X(3)":U
     1785         tt_price-all.plt-fix-cource-crc-doc COLUMN-LABEL "Ф!к" FORMAT "+/-":U
     1786         tt_price-all.pdf-exch-rate COLUMN-LABEL "Курс!док-та" FORMAT ">>>>9.9999":U
     1787         tt_price-all.price-sale COLUMN-LABEL "Цена в вал!прайс-листа" FORMAT "->>,>>>,>>>,>>>,>>9.99":U
     1788         tt_price-all.plt-fix-cource-crc-base COLUMN-LABEL "Ф!б" FORMAT "+/-":U
     1789         tt_price-all.pdf-base-rate COLUMN-LABEL "Курс!баз.вал" FORMAT ">>>>9.9999":U
     1790         tt_price-all.price-sale-base COLUMN-LABEL "Цена в !баз.вал" FORMAT "->>,>>>,>>>,>>>,>>9.99":U
     1791         tt_price-all.price-sale-rubl COLUMN-LABEL "Цена в !РУБ" FORMAT "->>,>>>,>>>,>>>,>>9.99":U
     1792         tt_price-all.date-1 COLUMN-LABEL "Действие!с " FORMAT "99/99/9999":U
     1793         tt_price-all.shift-1 COLUMN-LABEL "См!с" FORMAT ">9":U
     1794         (if tt_price-all.time-1 = 0 then "" else string(tt_price-all.time-1,"hh:mm")) @ stime-1 COLUMN-LABEL "Время!c" FORMAT "x(5)":U
     1795         tt_price-all.date-2 COLUMN-LABEL "Действие!по " FORMAT "99/99/9999":U
     1796         tt_price-all.shift-2  COLUMN-LABEL "См!по" FORMAT ">9":U
     1797         (if tt_price-all.time-2 = 0 then "" else string(tt_price-all.time-2,"hh:mm")) @ stime-2 COLUMN-LABEL "Время!по" FORMAT "x(5)":U
     1798         tt_price-all.grp-name COLUMN-LABEL "Покупатели! " FORMAT "x(20)":U
     1799         tt_price-all.interv-name COLUMN-LABEL "Интервал!группы" FORMAT "x(25)":U
     1800         tt_price-all.plt-id COLUMN-LABEL "ТПЛ! "
     1801         tt_price-all.pdf-id COLUMN-LABEL "ДНЦ! "
     1802         tt_price-all.pay-name COLUMN-LABEL "Тип платежа! " FORMAT "x(25)":U
     1803       WITH NO-ROW-MARKERS SEPARATORS SIZE 99 BY 10.75 FIT-LAST-COLUMN.
     1804   DEFINE FRAME Dialog-Frame
     1805        B-quit AT ROW 1 COL 1
     1806        B-save AT ROW 1 COL 11
     1807        B-pdf AT ROW 1 COL 21 WIDGET-ID 2
     1808        B-price-doc AT ROW 1 COL 32 WIDGET-ID 4
     1809        B-color AT ROW 1 COL 86.88
     1810        B-Help AT ROW 1 COL 90
     1811        BROWSE-3 AT ROW 2.25 COL 1
     1812        date-f AT ROW 1.21 COL 56.25 COLON-ALIGNED WIDGET-ID 6
     1813        time-f AT ROW 1.21 COL 70.63 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1814        SPACE(13.23) SKIP(11.53)
     1815       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1816            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1817            TITLE "Ручной выбор цены"
     1818            DEFAULT-BUTTON B-save CANCEL-BUTTON B-quit.
     1819   ASSIGN
     1820          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1821          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1822   ON GO OF FRAME Dialog-Frame
     1823   DO:
     1824   run uf-set in this-procedure(
     1825       input  'color-p':U
     1826       ,input v-cntxt-userid
     1827       ,input string(is-color)
     1828       ,input v-uf-Naim
     1829       ,input v-uf-print-graft
     1830       ,input v-uf-sort-gr
     1831       ,input v-uf-type-price
     1832       ,input v-uf-type-val
     1833   ) no-error    .
     1834   if available tt_price-all then do:
     1835     assign
     1836         p-plt-id             = tt_price-all.plt-id
     1837         p-plt-db-num         = tt_price-all.plt-db-num
     1838         p-pdf-id             = tt_price-all.pdf-id
     1839         p-pdf-db-num         = tt_price-all.pdf-db
     1840         p-sale-price-base    = tt_price-all.price-sale-base
     1841         p-sale-price-rubl    = tt_price-all.price-sale-rubl
     1842     .
     1843     end.
     1844   END.
     1845   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1846   DO:
     1847   run uf-set in this-procedure(
     1848       input  'color-p':U
     1849       ,input v-cntxt-userid
     1850       ,input string(is-color)
     1851       ,input v-uf-Naim
     1852       ,input v-uf-print-graft
     1853       ,input v-uf-sort-gr
     1854       ,input v-uf-type-price
     1855       ,input v-uf-type-val
     1856   ) no-error    .
     1857     APPLY "END-ERROR":U TO SELF.
     1858   END.
     1859   ON CHOOSE OF B-color IN FRAME Dialog-Frame
     1860   DO:
     1861     if B-color:IMAGE  = "cmp/nocol.bmp" then
     1862     do:
     1863       B-color:LOAD-IMAGE-UP("cmp/color.bmp") in frame Dialog-Frame  .
     1864       is-color = true .
     1865       OPEN QUERY BROWSE-3 FOR EACH tt_price-all NO-LOCK,              EACH buf_currency OF tt_price-all  NO-LOCK INDEXED-REPOSITION.
     1866     end.
     1867     else do:
     1868        B-color:LOAD-IMAGE-UP("cmp/nocol.bmp") in frame Dialog-Frame  .
     1869        is-color = false  .
     1870        OPEN QUERY BROWSE-3 FOR EACH tt_price-all NO-LOCK,              EACH buf_currency OF tt_price-all  NO-LOCK INDEXED-REPOSITION.
     1871     end.
     1872   END.
     1873   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
     1874   OR HELP OF FRAME Dialog-Frame
     1875   DO:
     1876   END.
     1877   ON CHOOSE OF B-pdf IN FRAME Dialog-Frame
     1878   DO:
     1879   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     1880   define variable v-rec-id as recid no-undo .
     1881   define variable v-recid as character no-undo .
     1882   define variable v-rec-list as character no-undo .
     1883   define variable br-handle      as handle no-undo.
     1884   define variable buffer-handle  as handle no-undo.
     1885   define variable next-prev      as logical no-undo .
     1886   define variable v-tt-recid as recid no-undo .
     1887   if not available tt_price-all then return .
     1888   find first buf_price-doc-forming no-lock where
     1889              buf_price-doc-forming.plt-id =      tt_price-all.plt-id and
     1890              buf_price-doc-forming.pdf-id =      tt_price-all.pdf-id and
     1891              buf_price-doc-forming.plt-db-num =  tt_price-all.plt-db-num and
     1892              buf_price-doc-forming.pdf-db     =  tt_price-all.pdf-db no-error .
     1893   if not available buf_price-doc-forming then return .
     1894   find first buf_price-doc-forming-gds where
     1895         buf_price-doc-forming-gds.pdf-db     =  tt_price-all.pdf-db  and
     1896         buf_price-doc-forming-gds.pdf-id     =  tt_price-all.pdf-id  and
     1897         buf_price-doc-forming-gds.plt-db-num =  tt_price-all.plt-db-num and
     1898         buf_price-doc-forming-gds.plt-id     =  tt_price-all.plt-id  and
     1899         buf_price-doc-forming-gds.b-code     =  tt_price-all.b-code
     1900         no-error .
     1901   if not available buf_price-doc-forming-gds then return .
     1902   v-rec-id = recid (buf_price-doc-forming) .
     1903     assign
     1904       v-rec-id      = recid (buf_price-doc-forming)
     1905       next-prev     = no
     1906       br-handle     = BROWSE-3:handle
     1907       buffer-handle = buffer buf_price-doc-forming :handle .
     1908       .
     1909         run str/df-price.w
     1910           ( input parparentproc,
     1911             input 'ПРОСМОТР':U ,
     1912             input buf_price-doc-forming.plt-id ,
     1913             input buf_price-doc-forming.plt-db-num ,
     1914             input recid(buf_price-doc-forming-gds) ,
     1915             output v-rec-list  ,
     1916             input-output v-rec-id  ,
     1917             input-output br-handle ,
     1918             input-output buffer-handle ,
     1919             input-output next-prev
     1920             ) .
     1921             v-tt-recid = recid(tt_price-all) .
     1922     reposition BROWSE-3 to recid v-tt-recid no-error .
     1923   END.
     1924   ON CHOOSE OF B-price-doc IN FRAME Dialog-Frame
     1925   DO:
     1926   if not available tt_price-all then return .
     1927   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1928   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     1929   define variable v-rec-id as recid no-undo .
     1930   define variable v-recid as character no-undo .
     1931   if not available tt_price-all then return .
     1932   if tt_price-all.out-code = "" then return .
     1933   define variable doc-rec as recid no-undo .
     1934   define variable next-prev as logical   no-undo .
     1935   define buffer buf_price-doc for ub.price-doc  .
     1936   define buffer buf_price-list for ub.price-list  .
     1937   for each  buf_price-doc no-lock where
     1938             buf_price-doc.doc-num     =  tt_price-all.out-code
     1939              :
     1940       find first buf_price-list no-lock where
     1941                 buf_price-list.doc-num = buf_price-doc.doc-num and
     1942                 buf_price-list.price-type = "" and
     1943                 buf_price-list.b-code  = tt_price-all.b-code no-error .
     1944       if available buf_price-list then  do:
     1945         doc-rec = recid(buf_price-doc).
     1946       end.
     1947     run str/pr-lkp.p
     1948     ( input parParentProc   ,
     1949       input doc-rec ) .
     1950      return .
     1951   end.
     1952   END.
     1953   ON CHOOSE OF B-quit IN FRAME Dialog-Frame
     1954   DO:
     1955     assign
     1956       p-plt-id             = ?
     1957       p-plt-db-num         = ?
     1958       p-pdf-id             = ?
     1959       p-pdf-db-num         = ?
     1960       p-sale-price-base    = ?
     1961       p-sale-price-rubl    = ?
     1962   .
     1963   END.
     1964   ON ROW-DISPLAY OF BROWSE-3 IN FRAME Dialog-Frame
     1965   DO:
     1966   if is-color = false then return .
     1967   define variable v-color  as integer   no-undo .
     1968   define variable v-color2 as integer   no-undo .
     1969      case tt_price-all.type-price :
     1970           when  integer('0':U) then do:
     1971               v-color = ?.
     1972           end.
     1973           when  integer('2':U) then do:
     1974               v-color = dark_green_color.
     1975           end.
     1976           when  integer('1':U) then do:
     1977               v-color = DARK_GREY_COLOR.
     1978           end.
     1979           when  integer('3':U) then do:
     1980               v-color =  blue_color .
     1981           end.
     1982      end case.
     1983      case tt_price-all.main-indication :
     1984           when  integer('0':U) then do:
     1985               if tt_price-all.plt-priority = 0 then v-color2 = ?.
     1986                                                else v-color2 = 8.
     1987           end.
     1988           when  integer('2':U) then do:
     1989               v-color2 = 11.
     1990           end.
     1991           when  integer('3':U) then do:
     1992               v-color2 = 10.
     1993           end.
     1994           when  integer('4':U) then do:
     1995               v-color2 =  14 .
     1996           end.
     1997      end case.
     1998       tt_price-all.plt-priority :fgcolor in browse BROWSE-3 = v-color.
     1999       tt_price-all.b-code :fgcolor in browse BROWSE-3 = v-color.
     2000       buf_currency.curr-abbr :fgcolor in browse BROWSE-3 = v-color.
     2001       tt_price-all.price-sale:bgcolor in browse BROWSE-3 = v-color2.
     2002   END.
     2003   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2004   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2005   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2006   on help of frame Dialog-Frame
     2007   do:
     2008     run gbl/app_help.p
     2009       (input this-procedure :file-name
     2010       ,input ''
     2011       ,input ?
     2012       ) no-error.
     2013     if error-status :error then do:
     2014       message
     2015         "Ошибка при вызове помощи"
     2016         error-status :get-message(1)
     2017         view-as alert-box .
     2018     end.
     2019   end.
     2020   run minbtn-set in this-procedure .
     2021   on choose of b-help in frame Dialog-Frame
     2022   do:
     2023     apply "help":u to frame Dialog-Frame .
     2024   end.
     2025   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2026   procedure minbtn-set :
     2027       do
     2028           on error undo, return error return-value
     2029           :
     2030           define variable ii              as integer       no-undo .
     2031           define variable fh              as widget-handle no-undo .
     2032           define variable hh              as widget-handle no-undo .
     2033           define variable v-h             as handle        extent 4 no-undo .
     2034           define variable v-name-button   as character     no-undo .
     2035           define variable v-help-old-x    as decimal       no-undo .
     2036           define variable v-help-old-y    as decimal       no-undo .
     2037           define variable v-help-old-size as decimal       no-undo .
     2038           define variable v-frame-width   as decimal       no-undo .
     2039           define variable jj              as integer       no-undo .
     2040           do
     2041               on error undo, return error
     2042               :
     2043               assign
     2044                   v-frame-width = frame Dialog-Frame:width - 0.3
     2045                   fh            = frame Dialog-Frame:first-child
     2046                   hh            = fh:first-child
     2047                   ii            = 1
     2048                   .
     2049               do while valid-handle(hh):
     2050                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2051                   do:
     2052                       case lc(hh:name) :
     2053                           when "b-help" then
     2054                               do:
     2055                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2056                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2057                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2058                                   hh:TOOLTIP = "Помощь" .
     2059                                   v-help-old-x = hh:column .
     2060                                   v-help-old-y = hh:row    .
     2061                                   v-help-old-size = hh:width .
     2062                                   hh:width-chars = 2.5 .
     2063                               end.
     2064                           when "b-print" then
     2065                               do:
     2066                                   hh:load-image("cmp/b-print.bmp":u) .
     2067                                   hh:TOOLTIP = "Печать" .
     2068                                   v-h[ii] = hh:handle .
     2069                                   ii = ii + 1 .
     2070                                   hh:width-chars = 3 .
     2071                               end.
     2072                           when "b-history" or
     2073                           when "b-hist" then
     2074                               do:
     2075                                   hh:load-image("cmp/b-hist.bmp":u) .
     2076                                   hh:TOOLTIP = "История" .
     2077                                   v-h[ii] = hh:handle .
     2078                                   ii = ii + 1 .
     2079                                   hh:width-chars = 3 .
     2080                               end.
     2081                           when "b-sch" then
     2082                               do:
     2083                                   hh:load-image("cmp/b-sch.bmp":u) .
     2084                                   hh:TOOLTIP = "Установка Фильтра" .
     2085                                   v-h[ii] = hh:handle .
     2086                                   ii = ii + 1 .
     2087                                   hh:width-chars = 3 .
     2088                               end.
     2089                           when "b-hist-user" then
     2090                               do:
     2091                                   hh:load-image("cmp/b-hist.bmp":u) .
     2092                                   hh:TOOLTIP = "История пользователя" .
     2093                                   ii = ii + 1 .
     2094                               end.
     2095                       end case.
     2096                   end.
     2097                   hh = hh:next-sibling.
     2098               end.
     2099               b-help:column = v-frame-width - b-help:width-chars.
     2100               jj = 0.
     2101               repeat ii = 4 to 1 by -1 :
     2102                   if valid-handle (v-h[ii] ) then
     2103                   do:
     2104                       jj  = jj + 1 .
     2105                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2106                       v-h[ii]:row    = v-help-old-y .
     2107                   end.
     2108               end.
     2109           end.
     2110       end.
     2111   end procedure.
     2112   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2113   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2114   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2115   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2116   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2117   define variable v-diasize-current-frame-height as decimal   no-undo .
     2118   define variable v-diasize-change-size          as logical   no-undo .
     2119   define variable v-diasize-resize-button        as handle    no-undo .
     2120   define variable v-diasize-wndmax               as logical   no-undo .
     2121   define variable v-diasize-wndstore             as logical   no-undo .
     2122   define variable v-diasize-proc-name            as character no-undo .
     2123   define variable v-diasize-browse-handle        as handle    no-undo .
     2124   define variable v-diasize-browse-number        as integer   no-undo .
     2125   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2126   define temp-table temp-diasize-handle no-undo
     2127     field handle-value  as handle
     2128     field save-position as decimal
     2129     index xpk is primary unique handle-value
     2130     .
     2131   define temp-table temp-browse-handle no-undo
     2132     field browse-type   as character
     2133     field browse-number as integer
     2134     field browse-handle as handle
     2135     field original-size as decimal
     2136     index xpk is primary unique browse-type browse-number
     2137     index xie browse-type browse-handle
     2138   .
     2139   procedure diasize_change-height :
     2140     define input  parameter p-change-value  as decimal   no-undo .
     2141     define input  parameter p-move-resize   as logical   no-undo .
     2142     define variable v-field-group-handle    as handle    no-undo .
     2143     define variable v-object-handle         as handle    no-undo .
     2144     define variable v-frame-height          as decimal   no-undo .
     2145     define variable v-frame-virtual-height  as decimal   no-undo .
     2146     define variable v-browse-height         as decimal   no-undo .
     2147     define variable v-window-height         as decimal   no-undo .
     2148     define variable v-window-virtual-height as decimal   no-undo .
     2149     define variable v-change-sign           as integer   no-undo .
     2150     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2151     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2152     if p-change-value > 0
     2153     then do:
     2154       if frame Dialog-Frame :height + p-change-value
     2155           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2156       then do:
     2157         assign
     2158           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2159                           - (frame Dialog-Frame :height-chars)
     2160         .
     2161         if p-change-value <= 0
     2162         then do:
     2163           run diasize_position-resize-button in this-procedure .
     2164           return .
     2165         end.
     2166       end.
     2167     end.
     2168     if p-change-value < 0
     2169     then do:
     2170       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2171       then do:
     2172         assign
     2173           p-change-value = v-diasize-orig-frame-height
     2174                          - (frame Dialog-Frame :height-chars)
     2175         .
     2176         if p-change-value >= 0
     2177         then do:
     2178           run diasize_position-resize-button in this-procedure .
     2179           return .
     2180         end.
     2181       end.
     2182     end.
     2183     if p-change-value >= 0
     2184     then do:
     2185       assign
     2186         v-change-sign = 1
     2187       .
     2188     end.
     2189     else do:
     2190       assign
     2191         v-change-sign = -1
     2192       .
     2193     end.
     2194     assign
     2195       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2196     .
     2197     if p-change-value = 0
     2198     then do:
     2199       run diasize_position-resize-button in this-procedure .
     2200       return .
     2201     end.
     2202     move_block:
     2203     do
     2204     on error undo move_block, retry move_block
     2205     :
     2206       if retry
     2207       then do:
     2208         do
     2209         on error undo move_block, leave move_block
     2210         :
     2211           if p-change-value > 0
     2212           then do:
     2213             for each buf_temp-diasize-handle
     2214             on error undo, next
     2215             :
     2216               assign
     2217                 v-object-handle = buf_temp-diasize-handle.handle-value
     2218               .
     2219               if v-object-handle <> v-diasize-resize-button
     2220               then do:
     2221                 assign
     2222                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2223                 .
     2224               end.
     2225             end.
     2226             assign
     2227               v-diasize-browse-handle :height = v-browse-height
     2228             .
     2229             for each buf_temp-browse-handle
     2230               where buf_temp-browse-handle.browse-type = 'height':u
     2231             on error undo, next
     2232             :
     2233               assign
     2234                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2235               .
     2236             end.
     2237             assign
     2238               frame Dialog-Frame :height = v-frame-height
     2239             .
     2240             if frame Dialog-Frame :scrollable = true
     2241             then do:
     2242               assign
     2243                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2244               .
     2245             end.
     2246             run diasize_position-resize-button in this-procedure .
     2247           end.
     2248           else do:
     2249             if frame Dialog-Frame :scrollable = true
     2250             then do:
     2251               assign
     2252                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2253               .
     2254             end.
     2255             assign
     2256               frame Dialog-Frame :height = v-frame-height
     2257             .
     2258             assign
     2259               v-diasize-browse-handle :height = v-browse-height
     2260             .
     2261             for each buf_temp-browse-handle
     2262               where buf_temp-browse-handle.browse-type = 'height':u
     2263             on error undo, next
     2264             :
     2265               assign
     2266                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2267               .
     2268             end.
     2269             for each buf_temp-diasize-handle
     2270             on error undo, next
     2271             :
     2272               assign
     2273                 v-object-handle = buf_temp-diasize-handle.handle-value
     2274               .
     2275               if v-object-handle <> v-diasize-resize-button
     2276               then do:
     2277                 assign
     2278                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2279                 .
     2280               end.
     2281             end.
     2282             run diasize_position-resize-button in this-procedure .
     2283           end.
     2284           assign
     2285             v-diasize-change-size = false
     2286           .
     2287           leave move_block .
     2288         end.
     2289       end.
     2290       assign
     2291         v-diasize-need-full-display = true
     2292       .
     2293       if v-diasize-change-size = false
     2294       then do:
     2295         assign
     2296           v-diasize-change-size = true
     2297         .
     2298       end.
     2299       else do:
     2300         return .
     2301       end.
     2302       assign
     2303         v-frame-height = frame Dialog-Frame :height
     2304         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2305         v-browse-height = v-diasize-browse-handle :height
     2306       .
     2307       for each buf_temp-browse-handle
     2308         where buf_temp-browse-handle.browse-type = 'height':u
     2309       :
     2310         assign
     2311           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2312         .
     2313       end.
     2314       for each buf_temp-diasize-handle
     2315       :
     2316         delete buf_temp-diasize-handle .
     2317       end.
     2318       assign
     2319         v-field-group-handle = frame Dialog-Frame :first-child
     2320       .
     2321       do while valid-handle(v-field-group-handle)
     2322       :
     2323         assign
     2324           v-object-handle = v-field-group-handle :first-child
     2325         .
     2326         do while valid-handle(v-object-handle)
     2327         :
     2328           if  v-object-handle <> v-diasize-browse-handle :handle
     2329           and can-query(v-object-handle, "row")
     2330           and can-query(v-object-handle, "height")
     2331           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2332           then do:
     2333             find first buf_temp-browse-handle
     2334               where buf_temp-browse-handle.browse-type   = 'height':u
     2335                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2336               no-error .
     2337             if available buf_temp-browse-handle
     2338             then do:
     2339             end.
     2340             else do:
     2341               create buf_temp-diasize-handle .
     2342               assign
     2343                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2344                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2345               .
     2346             end.
     2347           end.
     2348           assign
     2349             v-object-handle = v-object-handle :next-sibling
     2350           .
     2351         end.
     2352         assign
     2353           v-field-group-handle = v-field-group-handle :next-sibling
     2354         .
     2355       end.
     2356       do with frame Dialog-Frame
     2357       :
     2358         hide v-diasize-resize-button .
     2359         assign
     2360           v-diasize-resize-button :row    = 1
     2361           v-diasize-resize-button :column = 1
     2362         .
     2363       end.
     2364       if p-change-value > 0
     2365       then do:
     2366         if frame Dialog-Frame :scrollable = true
     2367         then do:
     2368           assign
     2369             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2370             no-error .
     2371           if error-status :error
     2372           or error-status :get-message(1) <> ""
     2373           then do:
     2374             undo move_block, retry move_block .
     2375           end.
     2376         end.
     2377         assign
     2378           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2379           no-error .
     2380         if error-status :error
     2381         or error-status :get-message(1) <> ""
     2382         then do:
     2383           undo move_block, retry move_block .
     2384         end.
     2385         assign
     2386           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2387           no-error .
     2388         if error-status :error
     2389         or error-status :get-message(1) <> ""
     2390         then do:
     2391           undo move_block, retry move_block .
     2392         end.
     2393         for each buf_temp-browse-handle
     2394           where buf_temp-browse-handle.browse-type = 'height':u
     2395         on error undo move_block, retry move_block
     2396         :
     2397           assign
     2398             buf_temp-browse-handle.browse-handle :height
     2399               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2400             no-error .
     2401           if error-status :error
     2402           or error-status :get-message(1) <> ""
     2403           then do:
     2404             undo move_block, retry move_block .
     2405           end.
     2406         end.
     2407         for each buf_temp-diasize-handle
     2408         on error undo move_block, retry move_block
     2409         :
     2410           assign
     2411             v-object-handle = buf_temp-diasize-handle.handle-value
     2412           .
     2413           if v-object-handle <> v-diasize-resize-button
     2414           then do:
     2415             assign
     2416               v-object-handle :row = v-object-handle :row + p-change-value
     2417               no-error .
     2418             if error-status :error
     2419             or error-status :get-message(1) <> ""
     2420             then do:
     2421               undo move_block, retry move_block .
     2422             end.
     2423           end.
     2424         end.
     2425       end.
     2426       else do:
     2427         for each buf_temp-diasize-handle
     2428         on error undo move_block, retry move_block
     2429         :
     2430           assign
     2431             v-object-handle = buf_temp-diasize-handle.handle-value
     2432           .
     2433           if v-object-handle <> v-diasize-resize-button
     2434           then do:
     2435             assign
     2436               v-object-handle :row = v-object-handle :row + p-change-value
     2437               no-error .
     2438             if error-status :error
     2439             or error-status :get-message(1) <> ""
     2440             then do:
     2441               undo move_block, retry move_block .
     2442             end.
     2443           end.
     2444         end.
     2445         assign
     2446           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2447           no-error .
     2448         if error-status :error
     2449         or error-status :get-message(1) <> ""
     2450         then do:
     2451           undo move_block, retry move_block .
     2452         end.
     2453         for each buf_temp-browse-handle
     2454           where buf_temp-browse-handle.browse-type = 'height':u
     2455         on error undo move_block, retry move_block
     2456         :
     2457           assign
     2458             buf_temp-browse-handle.browse-handle :height
     2459               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2460             no-error .
     2461           if error-status :error
     2462           or error-status :get-message(1) <> ""
     2463           then do:
     2464             undo move_block, retry move_block .
     2465           end.
     2466         end.
     2467         assign
     2468           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2469           no-error .
     2470         if error-status :error
     2471         or error-status :get-message(1) <> ""
     2472         then do:
     2473           undo move_block, retry move_block .
     2474         end.
     2475         if frame Dialog-Frame :scrollable = true
     2476         then do:
     2477           assign
     2478             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2479             no-error .
     2480           if error-status :error
     2481           or error-status :get-message(1) <> ""
     2482           then do:
     2483             undo move_block, retry move_block .
     2484           end.
     2485         end.
     2486       end.
     2487       if p-move-resize = true
     2488       then do:
     2489         run diasize_position-resize-button in this-procedure .
     2490       end.
     2491       if v-diasize-wndstore = true
     2492       then do:
     2493         if connected("ub") = true
     2494         then do:
     2495           define variable v-cntxt-db-num        as integer   no-undo .
     2496           define variable v-cntxt-userid        as character no-undo .
     2497           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2498                                             , OUTPUT v-cntxt-userid
     2499                                             ) .
     2500           run gbl/wndsizew.p
     2501             (input  v-cntxt-db-num
     2502             ,input  v-cntxt-userid
     2503             ,input  v-diasize-proc-name
     2504             ,input  'height':u
     2505             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2506             ) .
     2507         end.
     2508       end.
     2509     end.
     2510     assign
     2511       v-diasize-change-size = false
     2512     .
     2513   end procedure.
     2514   procedure diasize_set-height :
     2515     define input  parameter p-new-height  as decimal   no-undo .
     2516     define input  parameter p-move-resize as logical   no-undo .
     2517     do
     2518     on error undo, return error return-value
     2519     :
     2520       run diasize_change-height in this-procedure
     2521         (input  (p-new-height - frame Dialog-Frame :height)
     2522         ,input  p-move-resize
     2523         ) .
     2524     end.
     2525   end procedure.
     2526   procedure diasize_change-width :
     2527     define input  parameter p-change-value as decimal   no-undo .
     2528     define input  parameter p-move-resize  as logical   no-undo .
     2529     define variable v-field-group-handle   as handle    no-undo .
     2530     define variable v-object-handle        as handle    no-undo .
     2531     define variable v-frame-width          as decimal   no-undo .
     2532     define variable v-frame-virtual-width  as decimal   no-undo .
     2533     define variable v-browse-width         as decimal   no-undo .
     2534     define variable v-window-width         as decimal   no-undo .
     2535     define variable v-window-virtual-width as decimal   no-undo .
     2536     define variable v-change-sign          as integer   no-undo .
     2537     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2538     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2539     if p-change-value > 0
     2540     then do:
     2541       if frame Dialog-Frame :width + p-change-value >
     2542           session :width-chars
     2543       then do:
     2544         assign
     2545           p-change-value = session :width-chars - frame Dialog-Frame :width
     2546         .
     2547         if p-change-value <= 0
     2548         then do:
     2549           run diasize_position-resize-button in this-procedure .
     2550           return .
     2551         end.
     2552       end.
     2553     end.
     2554     if p-change-value < 0
     2555     then do:
     2556       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2557       then do:
     2558         assign
     2559           p-change-value = v-diasize-orig-frame-width
     2560                          - frame Dialog-Frame :width
     2561         .
     2562         if p-change-value >= 0
     2563         then do:
     2564           run diasize_position-resize-button in this-procedure .
     2565           return .
     2566         end.
     2567       end.
     2568     end.
     2569     if p-change-value >= 0
     2570     then do:
     2571       assign
     2572         v-change-sign = 1
     2573       .
     2574     end.
     2575     else do:
     2576       assign
     2577         v-change-sign = -1
     2578       .
     2579     end.
     2580     assign
     2581       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2582     .
     2583     if p-change-value = 0
     2584     then do:
     2585       run diasize_position-resize-button in this-procedure .
     2586       return .
     2587     end.
     2588     move_block:
     2589     do
     2590     on error undo move_block, leave move_block
     2591     :
     2592       if retry
     2593       then do:
     2594         do
     2595         on error undo move_block, leave move_block
     2596         :
     2597           if p-change-value > 0
     2598           then do:
     2599             for each buf_temp-diasize-handle
     2600             on error undo, next
     2601             :
     2602               assign
     2603                 v-object-handle = buf_temp-diasize-handle.handle-value
     2604               .
     2605               if v-object-handle <> v-diasize-resize-button
     2606               then do:
     2607                 assign
     2608                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2609                 .
     2610               end.
     2611             end.
     2612             assign
     2613               v-diasize-browse-handle :width = v-browse-width
     2614             .
     2615             for each buf_temp-browse-handle
     2616               where buf_temp-browse-handle.browse-type = 'width':u
     2617             on error undo, next
     2618             :
     2619               assign
     2620                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2621               .
     2622             end.
     2623             assign
     2624               frame Dialog-Frame :width = v-frame-width
     2625             .
     2626             if frame Dialog-Frame :scrollable = true
     2627             then do:
     2628               assign
     2629                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2630               .
     2631             end.
     2632             run diasize_position-resize-button in this-procedure .
     2633           end.
     2634           else do:
     2635             if frame Dialog-Frame :scrollable = true
     2636             then do:
     2637               assign
     2638                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2639               .
     2640             end.
     2641             assign
     2642               frame Dialog-Frame :width = v-frame-width
     2643             .
     2644             for each buf_temp-browse-handle
     2645               where buf_temp-browse-handle.browse-type = 'width':u
     2646             on error undo, next
     2647             :
     2648               assign
     2649                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2650               .
     2651             end.
     2652             assign
     2653               v-diasize-browse-handle :width = v-browse-width
     2654             .
     2655             for each buf_temp-diasize-handle
     2656             on error undo, next
     2657             :
     2658               assign
     2659                 v-object-handle = buf_temp-diasize-handle.handle-value
     2660               .
     2661               if v-object-handle <> v-diasize-resize-button
     2662               then do:
     2663                 assign
     2664                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2665                 .
     2666               end.
     2667             end.
     2668             run diasize_position-resize-button in this-procedure .
     2669           end.
     2670           assign
     2671             v-diasize-change-size = false
     2672           .
     2673           leave move_block .
     2674         end.
     2675       end.
     2676       assign
     2677         v-diasize-need-full-display = true
     2678       .
     2679       if v-diasize-change-size = false
     2680       then do:
     2681         assign
     2682           v-diasize-change-size = true
     2683         .
     2684       end.
     2685       else do:
     2686         return .
     2687       end.
     2688       assign
     2689         v-frame-width = frame Dialog-Frame :width
     2690         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2691         v-browse-width = v-diasize-browse-handle :width
     2692       .
     2693       for each buf_temp-browse-handle
     2694         where buf_temp-browse-handle.browse-type = 'width':u
     2695       :
     2696         assign
     2697           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2698         .
     2699       end.
     2700       for each buf_temp-diasize-handle
     2701       :
     2702         delete buf_temp-diasize-handle .
     2703       end.
     2704       assign
     2705         v-field-group-handle = frame Dialog-Frame :first-child
     2706       .
     2707       do while valid-handle(v-field-group-handle)
     2708       :
     2709         assign
     2710           v-object-handle = v-field-group-handle :first-child
     2711         .
     2712         do while valid-handle(v-object-handle)
     2713         :
     2714           if  v-object-handle <> v-diasize-browse-handle :handle
     2715           and v-object-handle <> v-diasize-resize-button
     2716           and can-query(v-object-handle, "row")
     2717           and can-query(v-object-handle, "height")
     2718           and ( v-object-handle :col + v-object-handle :width
     2719                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2720               )
     2721           then do:
     2722             find first buf_temp-browse-handle
     2723               where buf_temp-browse-handle.browse-type   = 'width':u
     2724                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2725               no-error .
     2726             if available buf_temp-browse-handle
     2727             then do:
     2728             end.
     2729             else do:
     2730               create buf_temp-diasize-handle .
     2731               assign
     2732                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2733                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2734               .
     2735             end.
     2736           end.
     2737           assign
     2738             v-object-handle = v-object-handle :next-sibling
     2739           .
     2740         end.
     2741         assign
     2742           v-field-group-handle = v-field-group-handle :next-sibling
     2743         .
     2744       end.
     2745       do with frame Dialog-Frame
     2746       :
     2747         hide v-diasize-resize-button .
     2748         v-diasize-resize-button :row = 1.
     2749         v-diasize-resize-button :column = 1.
     2750       end.
     2751       if p-change-value > 0
     2752       then do:
     2753         if frame Dialog-Frame :scrollable = true
     2754         then do:
     2755           assign
     2756             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2757             no-error .
     2758           if error-status :error
     2759           or error-status :get-message(1) <> ""
     2760           then do:
     2761             undo move_block, retry move_block.
     2762           end.
     2763         end.
     2764         assign
     2765           frame Dialog-Frame :width = v-frame-width + p-change-value
     2766           no-error .
     2767         if error-status :error
     2768         or error-status :get-message(1) <> ""
     2769         then do:
     2770           undo move_block, retry move_block.
     2771         end.
     2772         assign
     2773           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2774         no-error .
     2775         if error-status :error
     2776         or error-status :get-message(1) <> ""
     2777         then do:
     2778           undo move_block, retry move_block.
     2779         end.
     2780         for each buf_temp-browse-handle
     2781           where buf_temp-browse-handle.browse-type = 'width':u
     2782         on error undo move_block, retry move_block
     2783         :
     2784           assign
     2785             buf_temp-browse-handle.browse-handle :width
     2786               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2787             no-error .
     2788           if error-status :error
     2789           or error-status :get-message(1) <> ""
     2790           then do:
     2791             undo move_block, retry move_block .
     2792           end.
     2793         end.
     2794         for each buf_temp-diasize-handle
     2795         on error undo move_block, retry move_block
     2796         :
     2797           assign
     2798             v-object-handle = buf_temp-diasize-handle.handle-value
     2799           .
     2800           if v-object-handle <> v-diasize-resize-button
     2801           then do:
     2802             assign
     2803               v-object-handle :col = v-object-handle :col + p-change-value
     2804               no-error .
     2805             if error-status :error
     2806             or error-status :get-message(1) <> ""
     2807             then do:
     2808               undo move_block, retry move_block .
     2809             end.
     2810           end.
     2811         end.
     2812       end.
     2813       else do:
     2814         for each buf_temp-diasize-handle
     2815         on error undo move_block, retry move_block
     2816         :
     2817           assign
     2818             v-object-handle = buf_temp-diasize-handle.handle-value
     2819           .
     2820           if v-object-handle <> v-diasize-resize-button
     2821           then do:
     2822             assign
     2823               v-object-handle :col = v-object-handle :col + p-change-value
     2824               no-error .
     2825             if error-status :error
     2826             or error-status :get-message(1) <> ""
     2827             then do:
     2828               undo move_block, retry move_block .
     2829             end.
     2830           end.
     2831         end.
     2832         for each buf_temp-browse-handle
     2833           where buf_temp-browse-handle.browse-type = 'width':u
     2834         on error undo move_block, retry move_block
     2835         :
     2836           assign
     2837             buf_temp-browse-handle.browse-handle :width
     2838               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2839             no-error .
     2840           if error-status :error
     2841           or error-status :get-message(1) <> ""
     2842           then do:
     2843             undo move_block, retry move_block .
     2844           end.
     2845         end.
     2846         assign
     2847           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2848           no-error .
     2849         if error-status :error
     2850         or error-status :get-message(1) <> ""
     2851         then do:
     2852           undo move_block, retry move_block.
     2853         end.
     2854         assign
     2855           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2856         no-error .
     2857         if error-status :error
     2858         or error-status :get-message(1) <> ""
     2859         then do:
     2860           undo move_block, retry move_block.
     2861         end.
     2862         if frame Dialog-Frame :scrollable = true
     2863         then do:
     2864           assign
     2865             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2866           no-error .
     2867           if error-status :error
     2868           or error-status :get-message(1) <> ""
     2869           then do:
     2870             undo move_block, retry move_block.
     2871           end.
     2872         end.
     2873       end.
     2874       if p-move-resize
     2875       then do:
     2876         run diasize_position-resize-button in this-procedure .
     2877       end.
     2878       if v-diasize-wndstore = true
     2879       then do:
     2880         if connected("ub") = true
     2881         then do:
     2882           define variable v-cntxt-db-num        as integer   no-undo .
     2883           define variable v-cntxt-userid        as character no-undo .
     2884           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2885                                             , OUTPUT v-cntxt-userid
     2886                                             ) .
     2887           run gbl/wndsizew.p
     2888             (input  v-cntxt-db-num
     2889             ,input  v-cntxt-userid
     2890             ,input  v-diasize-proc-name
     2891             ,input  'width':u
     2892             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2893             ) .
     2894         end.
     2895       end.
     2896     end.
     2897     assign
     2898       v-diasize-change-size = false
     2899     .
     2900   end procedure.
     2901   procedure diasize_set-width :
     2902     define input  parameter p-new-width  as decimal   no-undo .
     2903     define input  parameter p-move-resize as logical   no-undo .
     2904     do
     2905     on error undo, return error return-value
     2906     :
     2907       run diasize_change-width in this-procedure
     2908         (input  (p-new-width - frame Dialog-Frame :width)
     2909         ,input  p-move-resize
     2910         ) .
     2911     end.
     2912   end procedure.
     2913   procedure diasize_position-resize-button :
     2914     do with frame Dialog-Frame
     2915     :
     2916       hide v-diasize-resize-button .
     2917       assign
     2918         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2919                     - 1
     2920                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2921         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2922                     - 1
     2923                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2924       .
     2925       view v-diasize-resize-button .
     2926     end.
     2927   end procedure.
     2928   on alt-right anywhere
     2929   do:
     2930     run diasize_change-width in this-procedure
     2931       (input 1
     2932       ,input true
     2933       ) .
     2934     return no-apply .
     2935   end.
     2936   on alt-left anywhere
     2937   do:
     2938     run diasize_change-width in this-procedure
     2939       (input -1
     2940       ,input true
     2941       ) .
     2942     return no-apply .
     2943   end.
     2944   on alt-down anywhere
     2945   do:
     2946     run diasize_change-height in this-procedure
     2947       (input 1
     2948       ,input true
     2949       ) .
     2950     return no-apply .
     2951   end.
     2952   on alt-up anywhere
     2953   do:
     2954     run diasize_change-height in this-procedure
     2955       (input -1
     2956       ,input true
     2957       ) .
     2958     return no-apply .
     2959   end.
     2960   on alt-enter of frame Dialog-Frame
     2961   do:
     2962     run diasize_maximize in this-procedure
     2963       (input  ?
     2964       ).
     2965     return no-apply .
     2966   end.
     2967   procedure diasize_end-move :
     2968     do
     2969     on error undo, return error return-value
     2970     :
     2971       define variable v-row-delta as decimal   no-undo .
     2972       define variable v-col-delta as decimal   no-undo .
     2973       define variable v-new-row as decimal   no-undo .
     2974       define variable v-new-col as decimal   no-undo .
     2975       assign
     2976         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2977         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2978       .
     2979       assign
     2980         v-row-delta = v-new-row - frame Dialog-Frame :height
     2981         v-col-delta = v-new-col - frame Dialog-Frame :width
     2982       .
     2983       run diasize_change-height in this-procedure
     2984         (input v-row-delta
     2985         ,input true
     2986         ) .
     2987       run diasize_change-width in this-procedure
     2988         (input v-col-delta
     2989         ,input true
     2990         ) .
     2991     end.
     2992   end procedure.
     2993   procedure diasize_maximize :
     2994     define input  parameter p-action as logical   no-undo .
     2995     do
     2996     on error undo, return error return-value
     2997     :
     2998       if p-action = ?
     2999       then do:
     3000         if v-diasize-need-maximize = true
     3001         then do:
     3002           assign
     3003             p-action = true
     3004           .
     3005         end.
     3006         else do:
     3007           assign
     3008             p-action = false
     3009           .
     3010         end.
     3011       end.
     3012       if p-action = true
     3013       then do:
     3014         run diasize_change-height in this-procedure
     3015           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3016               - frame Dialog-Frame :height-chars
     3017           ,input true
     3018           ) .
     3019         run diasize_change-width in this-procedure
     3020           (input session :width-chars
     3021               - frame Dialog-Frame :width-chars
     3022           ,input true
     3023           ) .
     3024         assign
     3025           v-diasize-need-maximize = false
     3026         .
     3027       end.
     3028       else do:
     3029         run diasize_change-width in this-procedure
     3030           (input v-diasize-orig-frame-width
     3031               - frame Dialog-Frame :width-chars
     3032           ,input true
     3033           ) .
     3034         run diasize_change-height in this-procedure
     3035           (input v-diasize-orig-frame-height
     3036               - frame Dialog-Frame :height-chars
     3037           ,input true
     3038           ) .
     3039         assign
     3040           v-diasize-need-maximize = true
     3041         .
     3042       end.
     3043     end.
     3044   end procedure.
     3045   procedure diasize_restore-orig-size :
     3046     do
     3047     on error undo, return error return-value
     3048     :
     3049       assign
     3050         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3051         v-diasize-current-frame-height = frame Dialog-Frame :height
     3052       .
     3053       run diasize_set-height in this-procedure
     3054         (input  v-diasize-orig-frame-height
     3055         ,input  true
     3056         ) .
     3057       run diasize_set-width in this-procedure
     3058         (input  v-diasize-orig-frame-width
     3059         ,input  true
     3060         ) .
     3061     end.
     3062   end procedure.
     3063   procedure diasize_restore-current-size :
     3064     do
     3065     on error undo, return error return-value
     3066     :
     3067       run diasize_set-height in this-procedure
     3068         (input  v-diasize-current-frame-height
     3069         ,input  true
     3070         ) .
     3071       run diasize_set-width in this-procedure
     3072         (input  v-diasize-current-frame-width
     3073         ,input  true
     3074         ) .
     3075     end.
     3076   end procedure.
     3077   procedure diasize_set-browse-handle :
     3078     define input  parameter p-browse-handle as handle   no-undo .
     3079     define buffer buf_temp-browse-handle for temp-browse-handle .
     3080     do
     3081     on error undo, return error return-value
     3082     :
     3083       assign
     3084         v-diasize-browse-handle = p-browse-handle
     3085       .
     3086       for each buf_temp-browse-handle
     3087       on error undo, return error return-value
     3088       :
     3089         delete buf_temp-browse-handle .
     3090       end.
     3091     end.
     3092   end procedure.
     3093   procedure diasize_add_browse :
     3094     define input  parameter p-browse-type   as character no-undo .
     3095     define input  parameter p-browse-handle as handle    no-undo .
     3096     define buffer buf_temp-browse-handle for temp-browse-handle .
     3097     do
     3098     on error undo, return error return-value
     3099     :
     3100       assign
     3101         v-diasize-browse-number = v-diasize-browse-number + 1
     3102       .
     3103       create buf_temp-browse-handle .
     3104       assign
     3105         buf_temp-browse-handle.browse-type   = p-browse-type
     3106         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3107         buf_temp-browse-handle.browse-handle = p-browse-handle
     3108       .
     3109     end.
     3110   end procedure.
     3111   procedure diasize_init :
     3112     define variable v-default-value    as logical   no-undo .
     3113     define variable v-restore-saved    as logical   no-undo .
     3114     define variable v-resize-value-str as character no-undo .
     3115     do
     3116     on error undo, return error return-value
     3117     :
     3118       do with frame Dialog-Frame
     3119       :
     3120         assign
     3121           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3122           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3123           v-diasize-browse-handle     = browse BROWSE-3 :handle
     3124         .
     3125         create button v-diasize-resize-button
     3126         assign
     3127           parent        = frame Dialog-Frame :first-child
     3128           label         = "s"
     3129           height-pixels = 16
     3130           width-pixels  = 16
     3131           visible       = true
     3132           sensitive     = true
     3133           movable       = true
     3134           triggers:
     3135             on end-move persistent run diasize_end-move in this-procedure .
     3136           end triggers.
     3137         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3138         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3139         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3140         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3141         assign
     3142           v-diasize-wndmax = false
     3143         .
     3144         if connected("ub") = true
     3145         then do:
     3146           define variable v-cntxt-db-num        as integer   no-undo .
     3147           define variable v-cntxt-userid        as character no-undo .
     3148           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3149                                             , OUTPUT v-cntxt-userid
     3150                                             ) .
     3151           run gbl/wndpar_r.p
     3152             (input  v-cntxt-db-num
     3153             ,input  v-cntxt-userid
     3154             ,input  'wndmax':U
     3155             ,output v-diasize-wndmax
     3156             ,output v-default-value
     3157             ) .
     3158         end.
     3159         assign
     3160           v-diasize-wndstore = false
     3161         .
     3162         if connected("ub") = true
     3163         then do:
     3164           run gbl/wndpar_r.p
     3165             (input  v-cntxt-db-num
     3166             ,input  v-cntxt-userid
     3167             ,input  'wndstore':U
     3168             ,output v-diasize-wndstore
     3169             ,output v-default-value
     3170             ) .
     3171         end.
     3172         assign
     3173           v-diasize-proc-name = entry(1, program-name(2), '.')
     3174         .
     3175         if v-diasize-wndstore = true
     3176         then do:
     3177           assign
     3178             v-restore-saved = false
     3179           .
     3180           if connected("ub") = true
     3181           then do:
     3182             run gbl/wndsizer.p
     3183               (input  v-cntxt-db-num
     3184               ,input  v-cntxt-userid
     3185               ,input  v-diasize-proc-name
     3186               ,input  'height':u
     3187               ,output v-resize-value-str
     3188               ) .
     3189             if v-resize-value-str <> '':U
     3190             then do:
     3191               run diasize_change-height in this-procedure
     3192                 (input  integer(v-resize-value-str)
     3193                 ,input  true
     3194                 ) .
     3195               assign
     3196                 v-restore-saved = true
     3197               .
     3198             end.
     3199           end.
     3200           if connected("ub") = true
     3201           then do:
     3202             run gbl/wndsizer.p
     3203               (input  v-cntxt-db-num
     3204               ,input  v-cntxt-userid
     3205               ,input  v-diasize-proc-name
     3206               ,input  'width':u
     3207               ,output v-resize-value-str
     3208               ) .
     3209             if v-resize-value-str <> '':U
     3210             then do:
     3211               run diasize_change-width in this-procedure
     3212                 (input  integer(v-resize-value-str)
     3213                 ,input  true
     3214                 ) .
     3215               assign
     3216                 v-restore-saved = true
     3217               .
     3218             end.
     3219           end.
     3220           if v-restore-saved <> true
     3221           then do:
     3222             if v-diasize-wndmax = true
     3223             then do:
     3224               run diasize_maximize in this-procedure
     3225                 (input  true
     3226                 ) .
     3227             end.
     3228           end.
     3229         end.
     3230         else do:
     3231           if v-diasize-wndmax = true
     3232           then do:
     3233             run diasize_maximize in this-procedure
     3234               (input  true
     3235               ) .
     3236           end.
     3237         end.
     3238       end.
     3239     end.
     3240   end procedure.
     3241   procedure diasize_need-full-display :
     3242     define output parameter p-need-full-display as logical   no-undo .
     3243     do
     3244     on error undo, return error return-value
     3245     :
     3246       assign
     3247         p-need-full-display = v-diasize-need-full-display
     3248       .
     3249       assign
     3250         v-diasize-need-full-display = false
     3251       .
     3252     end.
     3253   end procedure.
     3254   procedure get-context :
     3255      define output parameter p-db-num as integer          no-undo.
     3256      define output parameter p-user-id as character        no-undo.
     3257      define variable v-login               as character    no-undo.
     3258      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3259      define buffer buf_user-login  for ub.user-login .
     3260      do
     3261      on error undo, return error
     3262      :
     3263            FIND FIRST buf_sys-ctrl no-lock.
     3264            ASSIGN
     3265               v-login = USERID("ub")
     3266               p-db-num = buf_sys-ctrl.db-num
     3267            .
     3268            FIND FIRST buf_user-login
     3269                 WHERE buf_user-login.db-num = p-db-num
     3270                   AND buf_user-login.user-login = v-login
     3271                 no-lock
     3272                 no-error
     3273                 .
     3274            IF AVAILABLE buf_user-login
     3275            THEN DO:
     3276               assign
     3277                  p-user-id = buf_user-login.user-id
     3278               .
     3279            END.
     3280      end.
     3281   end procedure.
     3282       run diasize_init in this-procedure .
     3283   MAIN-BLOCK:
     3284   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3285      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3286     run init-proc in this-procedure .
     3287     run enable_ui in this-procedure .
     3288         tt_price-all.price-sale:RESIZABLE  in browse BROWSE-3 = true .
     3289         tt_price-all.price-sale-rubl:RESIZABLE  in browse BROWSE-3 = true .
     3290         tt_price-all.price-sale-base:RESIZABLE  in browse BROWSE-3 = true .
     3291     wait-for go of frame Dialog-Frame.
     3292   end.
     3293   run disable_ui in this-procedure .
     3294   PROCEDURE disable_UI :
     3295     HIDE FRAME Dialog-Frame.
     3296   END PROCEDURE.
     3297   PROCEDURE enable_UI :
     3298     DISPLAY date-f time-f
     3299         WITH FRAME Dialog-Frame.
     3300     ENABLE B-quit B-save B-pdf B-price-doc B-color B-Help BROWSE-3 date-f time-f
     3301         WITH FRAME Dialog-Frame.
     3302     VIEW FRAME Dialog-Frame.
     3303     OPEN QUERY BROWSE-3 FOR EACH tt_price-all NO-LOCK,              EACH buf_currency OF tt_price-all  NO-LOCK INDEXED-REPOSITION.
     3304   END PROCEDURE.
     3305   PROCEDURE init-proc :
     3306   define buffer buf_goods              for ub.goods      .
     3307   define buffer buf_main-code          for ub.bar-code  .
     3308   define buffer buf_bar-code           for ub.bar-code  .
     3309   run uf-get in this-procedure(
     3310        input  'color-p':U
     3311       ,input  v-cntxt-userid
     3312       ,output v-uf-List_
     3313       ,output v-uf-Naim
     3314       ,output v-uf-print-graft
     3315       ,output v-uf-sort-gr
     3316       ,output v-uf-type-price
     3317       ,output v-uf-type-val
     3318   )  no-error.
     3319   if v-uf-List_ = "yes"  then is-color = true .
     3320   if is-color = true then B-color:LOAD-IMAGE-UP("cmp/color.bmp") in frame Dialog-Frame  .
     3321   if is-color = false then B-color:LOAD-IMAGE-UP("cmp/nocol.bmp") in frame Dialog-Frame  .
     3322   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     3323   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     3324   find first buf_global-state no-lock no-error .
     3325   if not available buf_global-state then do:
     3326      message
     3327        "Не заданы параметры ценообразования!"
     3328        view-as alert-box error
     3329      .
     3330      return error return-value .
     3331   end.
     3332   define variable v-fact-num-fo as integer   no-undo .
     3333   define variable v-fact-date-fo as date     no-undo .
     3334   define variable v-shift-num-fo as integer   no-undo .
     3335   run  factord-to-date ( input p-fact-order , output v-fact-date-fo ).
     3336   run  factord-to-shift-num  ( input p-fact-order , output v-shift-num-fo  ).
     3337   run  factord-to-fact-num  ( input p-fact-order , output v-fact-num-fo  ).
     3338   date-f = v-fact-date-fo .
     3339   time-f =  "" .
     3340   if buf_global-state.pl-use-shift-date-num = false then do:
     3341      tt_price-all.shift-1:visible in browse BROWSE-3 = false .
     3342      tt_price-all.shift-2:visible in browse BROWSE-3 = false .
     3343   end.
     3344   else do:
     3345      time-f = string( v-shift-num-fo ) .
     3346      if v-fact-num-fo = 24 then time-f =  "" .
     3347   end.
     3348   if buf_global-state.pl-use-sys-date-time  = false then do:
     3349      stime-1 :visible in browse BROWSE-3 = false .
     3350      stime-2 :visible in browse BROWSE-3 = false .
     3351   end.
     3352   else do:
     3353      time-f = string(v-fact-num-fo , "hh:mm" ) .
     3354   end.
     3355   display date-f time-f  with frame Dialog-Frame .
     3356   frame Dialog-Frame:TITLE = SUBSTITUTE( "Цены товара : &1 &2 " , buf_goods.artic , buf_goods.gds-name) .
     3357   run mpl-autoprice in this-procedure
     3358    ( input   true
     3359     ,input   p-cli-type
     3360     ,input   p-cli-code
     3361     ,input   p-main-b-code
     3362     ,input   p-b-code
     3363     ,input   p-obj-type
     3364     ,input   p-obj-code
     3365     ,input   p-qnty-doc
     3366     ,input   p-sum-doc
     3367     ,input   p-vid-pay
     3368     ,input   p-cash-type-pay
     3369     ,input   p-fact-order
     3370     ,output  p-plt-id
     3371     ,output  p-plt-db-num
     3372     ,output  p-pdf-id
     3373     ,output  p-pdf-db-num
     3374     ,output  p-sale-price-base
     3375     ,output  p-sale-price-rubl
     3376     ,output  p-road-tax-base
     3377     ,output  p-road-tax-rubl
     3378     ,output  p-excise-base
     3379     ,output  p-excise-rubl
     3380     ) no-error .
     3381     if error-status :error then message
     3382       vss-workfile vss-revision vss-description skip
     3383       error-status :get-message(1) skip
     3384       return-value skip
     3385       "mpl-autoprice"
     3386       view-as alert-box error
     3387     .
     3388   END PROCEDURE.
