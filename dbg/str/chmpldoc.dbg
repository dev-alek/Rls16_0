      180   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      181   procedure uf-name :
      182     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      183     define output parameter p-use-List_     as logical   no-undo .
      184     define output parameter p-type-List_     as character no-undo .
      185     define output parameter p-format-List_   as character no-undo .
      186     define output parameter p-use-Naim      as logical   no-undo .
      187     define output parameter p-type-Naim      as character no-undo .
      188     define output parameter p-format-Naim    as character no-undo .
      189     define output parameter p-use-print-graft as logical   no-undo .
      190     define output parameter p-use-sort-gr   as logical   no-undo .
      191     define output parameter p-use-type-price as logical   no-undo .
      192     define output parameter p-use-type-val  as logical   no-undo .
