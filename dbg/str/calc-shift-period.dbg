     1954   function getCalibrationBelt returns character
     1955     (
     1956     input iObjType as character,
     1957     input iObjCode as integer,
     1958     input iPlCode  as integer,
     1959     input iLevelNP as decimal,
     1960     input iLevelWater as decimal
     1961     )
     1962   :
     1963     define variable vCalibBelt      as  character         no-undo.
     1964     define buffer   buf_pl-level-mm for ub.pl-level-mm.
     1965     for each buf_pl-level-mm where
     1966              buf_pl-level-mm.obj-type = iObjType
     1967          and buf_pl-level-mm.obj-code = iObjCode
     1968          and buf_pl-level-mm.pl-code  = iPlCode
     1969          and ((buf_pl-level-mm.min-level <= iLevelNP and buf_pl-level-mm.max-level >= iLevelNP) or
     1970               (buf_pl-level-mm.min-level <= iLevelWater and buf_pl-level-mm.max-level >= iLevelWater))
     1971         no-lock
     1972         break by buf_pl-level-mm.zone by buf_pl-level-mm.level:
     1973       if first-of(buf_pl-level-mm.zone) then do:
     1974         vCalibBelt = substitute("&1&2;&3=",vCalibBelt, buf_pl-level-mm.min-level,buf_pl-level-mm.max-level).
     1975       end.
     1976       vCalibBelt = substitute("&1&2&3",vCalibBelt, if buf_pl-level-mm.level = 1 then "" else ";", trim(string(buf_pl-level-mm.capacity / 1000, ">>>>>9.999"))).
     1977       if last-of(buf_pl-level-mm.zone) and not last(buf_pl-level-mm.zone) then
     1978         vCalibBelt = substitute("&1&2",vCalibBelt, chr(10)).
     1979     end.
     1980     return vCalibBelt.
     1981   end.
     1982   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1983   procedure cur-time :
     1984      define output parameter p-today as date      no-undo .
     1985      define output parameter p-time  as integer   no-undo .
     1986     do
     1987     on error undo, return error
     1988     :
     1989       define variable v-date1 as date      no-undo .
     1990       define variable v-date2 as date      no-undo .
     1991       define variable v-time  as integer   no-undo .
     1992       assign
     1993         v-date1 = today
     1994         v-time  = time
     1995         v-date2 = today
     1996       .
     1997       if v-date1 <> v-date2
     1998       then do:
     1999         assign
     2000           v-date1 = today
     2001           v-time  = v-time
     2002         .
     2003       end.
     2004       assign
     2005         p-today = v-date1
     2006         p-time  = v-time
     2007       .
     2008     end.
     2009   end.
     2010   function cur-time-date returns character
     2011   :
     2012     return string(today, '99/99/9999':U) .
     2013   end.
     2014   function cur-time-mjd returns decimal
     2015   :
     2016     define variable v-date as date      no-undo .
     2017     define variable v-time as integer   no-undo .
     2018     run cur-time in this-procedure
     2019       (output v-date
     2020       ,output v-time
     2021       ) .
     2022     return integer(v-date) - 2400002 + (v-time / 86400) .
     2023   end.
     2024   function cur-time-get-ending-index returns integer
     2025   (input p-number as integer
     2026   )
     2027   :
     2028     if p-number < 0
     2029     or p-number = ?
     2030     then do:
     2031       return 1 .
     2032     end.
     2033     define variable v-rest as integer   no-undo .
     2034     assign
     2035       p-number = p-number modulo 100
     2036     .
     2037     if p-number < 20
     2038     then do:
     2039       assign
     2040         v-rest = p-number
     2041       .
     2042     end.
     2043     else do:
     2044       assign
     2045         v-rest = p-number modulo 10
     2046       .
     2047     end.
     2048     case v-rest :
     2049       when 1
     2050       then do:
     2051         return 2 .
     2052       end.
     2053       when 2 or
     2054       when 3 or
     2055       when 4
     2056       then do:
     2057         return 3 .
     2058       end.
     2059       otherwise do:
     2060         return 1 .
     2061       end.
     2062     end case .
     2063   end.
     2064   procedure cur-time-mjd-to-date :
     2065      define input  parameter i-mjd-diff as decimal no-undo.
     2066      define output parameter o-Date     as date    no-undo.
     2067      define output parameter o-Time     as integer no-undo.
     2068      define variable v-day-number as integer   no-undo .
     2069      if    i-mjd-diff < 0
     2070         or i-mjd-diff = ?
     2071      then do:
     2072         return "?" .
     2073      end.
     2074      assign
     2075         v-day-number = truncate(i-mjd-diff,0).
     2076         o-Date = date(v-day-number + 2400002).
     2077         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2078     .
     2079   end.
     2080   function cur-time-mjd-to-string returns character
     2081   (input p-mjd-diff as decimal
     2082   )
     2083   :
     2084     define variable v-day-number as integer   no-undo .
     2085     define variable v-seconds    as integer   no-undo .
     2086     define variable v-hour       as integer   no-undo .
     2087     define variable v-min        as integer   no-undo .
     2088     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2089     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2090     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2091     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2092     if p-mjd-diff < 0
     2093     or p-mjd-diff = ?
     2094     then do:
     2095       return "?" .
     2096     end.
     2097     assign
     2098       v-day-number = integer(truncate(p-mjd-diff,0))
     2099       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2100     .
     2101     if v-seconds > 86400
     2102     then do:
     2103       assign
     2104         v-seconds = 86400 - 1
     2105       .
     2106     end.
     2107     if v-seconds < 0
     2108     then do:
     2109       assign
     2110         v-seconds = 0
     2111       .
     2112     end.
     2113     assign
     2114       v-hour = truncate(v-seconds / 3600, 0)
     2115     .
     2116     assign
     2117       v-seconds = v-seconds modulo 3600
     2118     .
     2119     assign
     2120       v-min = truncate(v-seconds / 60, 0)
     2121     .
     2122     assign
     2123       v-seconds = v-seconds modulo 60
     2124     .
     2125     return
     2126         (if v-day-number <> 0
     2127           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2128           else ""
     2129         )
     2130       + (if v-day-number <> 0 or v-hour <> 0
     2131           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2132           else ""
     2133         )
     2134       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2135           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2136           else ""
     2137         )
     2138       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2139       .
     2140   end.
     2141   function cur-time-string returns character
     2142   :
     2143     define variable v-date as date      no-undo .
     2144     define variable v-time as integer   no-undo .
     2145     run cur-time in this-procedure
     2146       (output v-date
     2147       ,output v-time
     2148       ) .
     2149     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2150   end.
     2151   function cur-time-string-sec returns character
     2152   :
     2153     define variable v-date as date      no-undo .
     2154     define variable v-time as integer   no-undo .
     2155     run cur-time in this-procedure
     2156       (output v-date
     2157       ,output v-time
     2158       ) .
     2159     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2160   end.
     2161   function cur-time-custom  returns character
     2162   (input p-prefix as character
     2163   ,input p-date-format as character
     2164   ,input p-delimiter as character
     2165   ,input p-time-format as character
     2166   ,input p-suffix as character
     2167   )
     2168   :
     2169     define variable v-date as date      no-undo .
     2170     define variable v-time as integer   no-undo .
     2171     run cur-time in this-procedure
     2172       (output v-date
     2173       ,output v-time
     2174       ) .
     2175     return
     2176       p-prefix
     2177       + string(v-date, p-date-format)
     2178       + p-delimiter
     2179       + string(v-time, p-time-format)
     2180       + p-suffix
     2181       .
     2182   end.
     2183   function cur-time-print  returns character
     2184   :
     2185     define variable v-date as date      no-undo .
     2186     define variable v-time as integer   no-undo .
     2187     run cur-time in this-procedure
     2188       (output v-date
     2189       ,output v-time
     2190       ) .
     2191     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2192   end.
     2193   function cur-time-datetime returns datetime
     2194   :
     2195     define variable v-char as character no-undo .
     2196     define variable v-datetime as datetime no-undo .
     2197     v-char = cur-time-string().
     2198     v-datetime = datetime(v-char).
     2199     return  v-datetime.
     2200   end.
     2201   function cur-time-string-msec returns character
     2202   :
     2203     define variable v-date as datetime  no-undo .
     2204     v-date = now.
     2205     return string(v-date) .
     2206   end.
     2207   define temp-table tt-pl-gds no-undo like ub.pl-gds
     2208     field loc1 like ub.place.loc1
     2209     field num-pri-doc as integer
     2210     field period-num as integer
     2211     field is-init as logical
     2212     field num-pri-periods as integer
     2213   .
     2214   define temp-table tt-fringing-rvs no-undo
     2215     field rvs-code as character
     2216     index pi as primary unique
     2217       rvs-code
     2218   .
     2219   define temp-table ttDump no-undo
     2220     field doc-code as character
     2221     field BegTime as datetime
     2222     field EndTime as datetime
     2223     index dc
     2224       doc-code
     2225     index bt
     2226       BegTime
     2227     index et
     2228       EndTime
     2229   .
     2230   define buffer cur_shift-obj for ub.shift-obj .
     2231   define buffer cur_rvs-doc for ub.rvs-doc .
     2232   define buffer cur_rvs-line for ub.rvs-line .
     2233   define buffer cur_rvs-line-attr for ub.rvs-line-attr .
     2234   define buffer prev_shift-obj for ub.shift-obj .
     2235   define buffer prev_rvs-doc for ub.rvs-doc .
     2236   define buffer prev_rvs-line for ub.rvs-line .
     2237   define buffer prev_rvs-line-attr for ub.rvs-line-attr .
     2238   define buffer before_rvs-doc for ub.rvs-doc .
     2239   define buffer before_rvs-line for ub.rvs-line .
     2240   define buffer buf_goods for ub.goods .
     2241   define buffer buf_bar-code for ub.bar-code .
     2242   define buffer buf_place for ub.place .
     2243   define buffer buf_place-attr for ub.place-attr .
     2244   define buffer buf_pl-gds for ub.pl-gds .
     2245   define buffer buf_trn-doc for ub.trn-doc .
     2246   define buffer buf_doc-line for ub.doc-line .
     2247   define buffer buf_doc-pl for ub.doc-pl .
     2248   define buffer buf_chk-doc for ub.chk-doc .
     2249   define buffer buf_chk-gds for ub.chk-gds .
     2250   define buffer buf_chk-gds-attr for ub.chk-gds-attr .
     2251   define buffer prev_shift-period for ub.shift-period .
     2252   define buffer prev2_shift-period for ub.shift-period .
     2253   define buffer new_shift-period for ub.shift-period .
     2254   define buffer buf_clients-attr for ub.clients-attr .
     2255   define variable v-value as character no-undo .
     2256   define variable v-type as character no-undo .
     2257   define variable v-ok as logical no-undo .
     2258   define variable v-InfoSectionsTotal   as class     InfoSectionsTotal no-undo .
     2259   define variable v-InfoSection         as class     InfoSection no-undo .
     2260   define variable iNum                  as integer   no-undo .
     2261   define variable v-prev-doc-code as character no-undo .
     2262   define variable v-prev-control-density as decimal no-undo .
     2263   define variable v-num-fringing-rvs as integer no-undo .
     2264   define variable v-del-shift-period as logical no-undo .
     2265   define stream s-log .
     2266   define stream s-pomi .
     2267   run main-proc no-error .
     2268   if error-status:error
     2269   then do :
     2270     return error ("Ошибка при расчете контроля плотности НП!" + chr(10) + return-value + chr(10) + error-status:get-message(1)) .
     2271   end .
     2272   procedure main-proc :
     2273   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2274   run get-ptrl-prop in this-procedure
     2275     ( input p-obj-type
     2276     , input p-obj-code
     2277     ) .
     2278     find last cur_shift-obj
     2279       where cur_shift-obj.obj-type = p-obj-type
     2280         and cur_shift-obj.obj-code = p-obj-code
     2281         and cur_shift-obj.shift-date = p-shift-date
     2282         and cur_shift-obj.shift-num  = p-shift-num
     2283         use-index stts no-lock no-error .
     2284     if not available cur_shift-obj
     2285     then do:
     2286       return error "Не найдена закрывающаяся смена на объекте".
     2287     end.
     2288     find first cur_rvs-doc no-lock
     2289       where cur_rvs-doc.obj-type   = cur_shift-obj.obj-type
     2290         and cur_rvs-doc.obj-code   = cur_shift-obj.obj-code
     2291         and cur_rvs-doc.shift-date = cur_shift-obj.shift-date
     2292         and cur_rvs-doc.shift-num  = cur_shift-obj.shift-num
     2293         and cur_rvs-doc.status_    = 'факт':U
     2294         and cur_rvs-doc.rvs-type   = 'смена':U
     2295     no-error.
     2296     if not available cur_rvs-doc
     2297     then do:
     2298       return error "Не найдена закрытая сменная сверка на объекте".
     2299     end .
     2300     find last prev_shift-obj no-lock
     2301       where prev_shift-obj.obj-type = cur_shift-obj.obj-type
     2302         and prev_shift-obj.obj-code = cur_shift-obj.obj-code
     2303         and prev_shift-obj.status_  = 'зкр':U
     2304         and ( prev_shift-obj.shift-date < cur_shift-obj.shift-date
     2305               or prev_shift-obj.shift-date = cur_shift-obj.shift-date
     2306                 and prev_shift-obj.shift-num  < cur_shift-obj.shift-num
     2307             )
     2308     use-index stts
     2309     no-error.
     2310     if not available prev_shift-obj
     2311     then do:
     2312       return error "Нет предыдущей закрытой смены на объекте".
     2313     end.
     2314     find first prev_rvs-doc no-lock
     2315       where prev_rvs-doc.obj-type   = prev_shift-obj.obj-type
     2316         and prev_rvs-doc.obj-code   = prev_shift-obj.obj-code
     2317         and prev_rvs-doc.shift-date = prev_shift-obj.shift-date
     2318         and prev_rvs-doc.shift-num  = prev_shift-obj.shift-num
     2319         and prev_rvs-doc.status_    = 'факт':U
     2320         and prev_rvs-doc.rvs-type   = 'смена':U
     2321     no-error.
     2322     if not available prev_rvs-doc
     2323     then do:
     2324       return error "Нет предыдущей закрытой сменной сверки на объекте".
     2325     end .
     2326     for each buf_place no-lock where buf_place.obj-type = p-obj-type
     2327                                  and buf_place.obj-code = p-obj-code
     2328     :
     2329       find first buf_pl-gds no-lock where buf_pl-gds.pl-code = buf_place.pl-code no-error .
     2330       if not available buf_pl-gds then next .
     2331           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2332         (input  buf_pl-gds.gds-code
     2333         ,input  'fuel-type':U
     2334         ,output v-value
     2335         ,output v-type) no-error.
     2336       if v-value = "lgas"
     2337       or v-value = "metan"
     2338       or v-value = "propan"
     2339       then next .
     2340       run placelib_get-attr  ( input "place-com-tanks"
     2341                               ,input buf_place.obj-code
     2342                               ,input buf_place.obj-type
     2343                               ,input buf_place.pl-code
     2344                               ,output v-value
     2345                               ,output v-ok      ) no-error.
     2346       if v-ok
     2347       and v-value > ""
     2348       then do :
     2349         run placelib_get-attr  ( input "place-is-main"
     2350                                 ,input buf_place.obj-code
     2351                                 ,input buf_place.obj-type
     2352                                 ,input buf_place.pl-code
     2353                                 ,output v-value
     2354                                 ,output v-ok      ) no-error.
     2355         if v-ok
     2356         and v-value > ""
     2357         and logical(v-value)
     2358         then do :
     2359         end .
     2360         else do :
     2361           next .
     2362         end .
     2363       end .
     2364       create tt-pl-gds .
     2365       buffer-copy buf_pl-gds to tt-pl-gds
     2366       assign
     2367         tt-pl-gds.loc1 = buf_place.loc1
     2368         tt-pl-gds.num-pri-doc = 0
     2369         tt-pl-gds.period-num = 1
     2370         tt-pl-gds.num-pri-periods = 0
     2371       .
     2372     end .
     2373     pl-gds_ :
     2374     for each tt-pl-gds :
     2375       find first prev_rvs-line no-lock where prev_rvs-line.rvs-code = prev_rvs-doc.rvs-code
     2376                                         and prev_rvs-line.obj-type = prev_rvs-doc.obj-type
     2377                                         and prev_rvs-line.obj-code = prev_rvs-doc.obj-code
     2378                                         and prev_rvs-line.pl-code  = tt-pl-gds.pl-code
     2379                                         and prev_rvs-line.gds-code = tt-pl-gds.gds-code
     2380                                         no-error .
     2381       if not available prev_rvs-line
     2382       then do :
     2383         delete tt-pl-gds .
     2384         next pl-gds_ .
     2385       end .
     2386       empty temp-table ttDump .
     2387       run CrTempDump (cur_shift-obj.obj-type,
     2388                       cur_shift-obj.obj-code,
     2389                       cur_shift-obj.shift-date,
     2390                       cur_shift-obj.shift-num,
     2391                       tt-pl-gds.pl-code,
     2392                       tt-pl-gds.gds-code).
     2393       find last prev_shift-period no-lock where prev_shift-period.obj-type = prev_rvs-doc.obj-type
     2394                                             and prev_shift-period.obj-code = prev_rvs-doc.obj-code
     2395                                             and prev_shift-period.gds-code = tt-pl-gds.gds-code
     2396                                             and prev_shift-period.pl-code  = tt-pl-gds.pl-code
     2397                                             use-index pi
     2398                                             no-error .
     2399       if not available prev_shift-period
     2400       then do :
     2401         find first buf_place-attr exclusive-lock where buf_place-attr.obj-type = prev_rvs-doc.obj-type
     2402                                                    and buf_place-attr.obj-code = prev_rvs-doc.obj-code
     2403                                                    and buf_place-attr.pl-code  = tt-pl-gds.pl-code
     2404                                                    and buf_place-attr.attr-code = "init-shift-period-rvs"
     2405                                                    no-error .
     2406         if not available buf_place-attr
     2407         then do :
     2408           delete tt-pl-gds .
     2409           next pl-gds_ .
     2410         end .
     2411         assign tt-pl-gds.is-init = yes .
     2412         if buf_place-attr.attr-value <> prev_rvs-doc.rvs-code
     2413         then do :
     2414           find first prev_rvs-line no-lock where prev_rvs-line.rvs-code = buf_place-attr.attr-value
     2415                                             and prev_rvs-line.obj-type = prev_rvs-doc.obj-type
     2416                                             and prev_rvs-line.obj-code = prev_rvs-doc.obj-code
     2417                                             and prev_rvs-line.pl-code  = tt-pl-gds.pl-code
     2418                                             and prev_rvs-line.gds-code = tt-pl-gds.gds-code
     2419                                             no-error .
     2420           if not available prev_rvs-line
     2421           then do :
     2422             delete tt-pl-gds .
     2423             next pl-gds_ .
     2424           end .
     2425           assign tt-pl-gds.is-init = no .
     2426         end .
     2427         trn-doc_ :
     2428         for each buf_trn-doc no-lock where buf_trn-doc.obj-type   = cur_shift-obj.obj-type
     2429                                        and buf_trn-doc.obj-code   = cur_shift-obj.obj-code
     2430                                        and buf_trn-doc.shift-date = cur_shift-obj.shift-date
     2431                                        and buf_trn-doc.shift-num  = cur_shift-obj.shift-num
     2432                                        and buf_trn-doc.status_    = 'факт':U
     2433                                        and buf_trn-doc.ext-doc-type = 'ie':U
     2434         :
     2435           for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     2436                                                and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     2437                                                and buf_clients-attr.attr-code = 'shftrep2':U
     2438                                                :
     2439             if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next trn-doc_ .
     2440           end .
     2441           find first buf_doc-pl no-lock where buf_doc-pl.obj-type = buf_trn-doc.obj-type
     2442                                           and buf_doc-pl.obj-code = buf_trn-doc.obj-code
     2443                                           and buf_doc-pl.pl-code  = tt-pl-gds.pl-code
     2444                                           and buf_doc-pl.out-code = buf_trn-doc.doc-code
     2445                                           and buf_doc-pl.gds-code = tt-pl-gds.gds-code
     2446                                           no-error .
     2447           if available buf_doc-pl
     2448           then do :
     2449             assign tt-pl-gds.num-pri-doc = tt-pl-gds.num-pri-doc + 1 .
     2450           end .
     2451         end .
     2452         if tt-pl-gds.num-pri-doc = 0
     2453         then do :
     2454           create new_shift-period .
     2455           assign
     2456             new_shift-period.obj-type    = cur_shift-obj.obj-type
     2457             new_shift-period.obj-code    = cur_shift-obj.obj-code
     2458             new_shift-period.shift-num   = cur_shift-obj.shift-num
     2459             new_shift-period.shift-date  = cur_shift-obj.shift-date
     2460             new_shift-period.period-num  = tt-pl-gds.period-num
     2461             new_shift-period.pl-code     = tt-pl-gds.pl-code
     2462             new_shift-period.gds-code    = tt-pl-gds.gds-code
     2463             new_shift-period.period-type = 0
     2464             new_shift-period.period-name = "Инициализация - Конец смены"
     2465             new_shift-period.ost-density = prev_rvs-line.state-density
     2466             new_shift-period.ost-mass    = prev_rvs-line.state-measure-cli-qnty
     2467             new_shift-period.ost-temperature = prev_rvs-line.state-temperature
     2468           .
     2469           run calc_control-density .
     2470           if not tt-pl-gds.is-init
     2471           then do :
     2472             assign
     2473               new_shift-period.period-type = 2
     2474               new_shift-period.period-name = "Начало смены - Конец смены"
     2475             .
     2476           end .
     2477           run calc_sales-density15 (output v-del-shift-period) .
     2478           if v-del-shift-period
     2479           then do :
     2480             delete new_shift-period .
     2481             next pl-gds_ .
     2482           end .
     2483           assign new_shift-period.delta-density = new_shift-period.sales-density15 - new_shift-period.control-density .
     2484           run put_log .
     2485         end .
     2486         else do :
     2487           trn-doc_ :
     2488           for each buf_trn-doc no-lock where buf_trn-doc.obj-type   = cur_shift-obj.obj-type
     2489                                          and buf_trn-doc.obj-code   = cur_shift-obj.obj-code
     2490                                          and buf_trn-doc.shift-date = cur_shift-obj.shift-date
     2491                                          and buf_trn-doc.shift-num  = cur_shift-obj.shift-num
     2492                                          and buf_trn-doc.status_    = 'факт':U
     2493                                          and buf_trn-doc.ext-doc-type = 'ie':U
     2494                                          by buf_trn-doc.fact-order
     2495           :
     2496             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     2497                                                  and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     2498                                                  and buf_clients-attr.attr-code = 'shftrep2':U
     2499                                                  :
     2500               if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next trn-doc_ .
     2501             end .
     2502             find first buf_doc-pl no-lock where buf_doc-pl.obj-type = buf_trn-doc.obj-type
     2503                                             and buf_doc-pl.obj-code = buf_trn-doc.obj-code
     2504                                             and buf_doc-pl.pl-code  = tt-pl-gds.pl-code
     2505                                             and buf_doc-pl.out-code = buf_trn-doc.doc-code
     2506                                             and buf_doc-pl.gds-code = tt-pl-gds.gds-code
     2507                                             no-error .
     2508             if available buf_doc-pl
     2509             then do :
     2510               create new_shift-period .
     2511               assign
     2512                 new_shift-period.obj-type    = cur_shift-obj.obj-type
     2513                 new_shift-period.obj-code    = cur_shift-obj.obj-code
     2514                 new_shift-period.shift-num   = cur_shift-obj.shift-num
     2515                 new_shift-period.shift-date  = cur_shift-obj.shift-date
     2516                 new_shift-period.period-num  = tt-pl-gds.period-num
     2517                 new_shift-period.pl-code     = tt-pl-gds.pl-code
     2518                 new_shift-period.gds-code    = tt-pl-gds.gds-code
     2519               .
     2520               if new_shift-period.period-num = 1
     2521               then do :
     2522                 assign
     2523                   new_shift-period.period-type = 1
     2524                   new_shift-period.period-name = "Инициализация - Прием НП (№" + buf_trn-doc.doc-code + ")"
     2525                   new_shift-period.ost-density = prev_rvs-line.state-density
     2526                   new_shift-period.ost-mass    = prev_rvs-line.state-measure-cli-qnty
     2527                   new_shift-period.ost-temperature = prev_rvs-line.state-temperature
     2528                 .
     2529                 run calc_control-density .
     2530                 if not tt-pl-gds.is-init
     2531                 then do :
     2532                   assign
     2533                     new_shift-period.period-type = 3
     2534                     new_shift-period.period-name = "Начало смены - Прием НП (№" + buf_trn-doc.doc-code + ")"
     2535                   .
     2536                 end .
     2537                 run calc_sales-density15 (output v-del-shift-period) .
     2538                 if v-del-shift-period
     2539                 then do :
     2540                   assign
     2541                     tt-pl-gds.period-num = tt-pl-gds.period-num + 1
     2542                     v-prev-doc-code = buf_trn-doc.doc-code
     2543                     v-prev-control-density = new_shift-period.control-density
     2544                   .
     2545                   delete new_shift-period .
     2546                   next trn-doc_ .
     2547                 end .
     2548                 assign new_shift-period.delta-density = new_shift-period.sales-density15 - new_shift-period.control-density .
     2549                 run put_log .
     2550                 assign
     2551                   tt-pl-gds.period-num = tt-pl-gds.period-num + 1
     2552                   v-prev-doc-code = buf_trn-doc.doc-code
     2553                   v-prev-control-density = new_shift-period.control-density
     2554                 .
     2555               end .
     2556               else do :
     2557                 assign
     2558                   new_shift-period.period-type = 4
     2559                   new_shift-period.period-name = "Прием НП (№" + v-prev-doc-code + ") - Прием НП (№" + buf_trn-doc.doc-code + ")"
     2560                   new_shift-period.ost-mass = 0
     2561                 .
     2562                 run calc_control-density .
     2563                 if new_shift-period.control-density = 0
     2564                 or new_shift-period.control-density = ?
     2565                 then do :
     2566                   assign
     2567                     tt-pl-gds.period-num = tt-pl-gds.period-num + 1
     2568                     v-prev-doc-code = buf_trn-doc.doc-code
     2569                   .
     2570                   delete new_shift-period .
     2571                   next trn-doc_ .
     2572                 end .
     2573                 run calc_sales-density15 (output v-del-shift-period) .
     2574                 if v-del-shift-period
     2575                 then do :
     2576                   assign
     2577                     tt-pl-gds.period-num = tt-pl-gds.period-num + 1
     2578                     v-prev-doc-code = buf_trn-doc.doc-code
     2579                     v-prev-control-density = new_shift-period.control-density
     2580                   .
     2581                   delete new_shift-period .
     2582                   next trn-doc_ .
     2583                 end .
     2584                 assign new_shift-period.delta-density = new_shift-period.sales-density15 - new_shift-period.control-density .
     2585                 if tt-pl-gds.num-pri-doc > 2
     2586                 then do :
     2587                   assign tt-pl-gds.num-pri-periods = tt-pl-gds.num-pri-periods + 1 .
     2588                 end .
     2589                 run put_log .
     2590                 assign
     2591                   tt-pl-gds.period-num = tt-pl-gds.period-num + 1
     2592                   v-prev-doc-code = buf_trn-doc.doc-code
     2593                   v-prev-control-density = new_shift-period.control-density
     2594                 .
     2595               end .
     2596             end .
     2597           end .
     2598           create new_shift-period .
     2599           assign
     2600             new_shift-period.obj-type    = cur_shift-obj.obj-type
     2601             new_shift-period.obj-code    = cur_shift-obj.obj-code
     2602             new_shift-period.shift-num   = cur_shift-obj.shift-num
     2603             new_shift-period.shift-date  = cur_shift-obj.shift-date
     2604             new_shift-period.period-num  = tt-pl-gds.period-num
     2605             new_shift-period.pl-code     = tt-pl-gds.pl-code
     2606             new_shift-period.gds-code    = tt-pl-gds.gds-code
     2607           .
     2608           assign
     2609             new_shift-period.period-type = 5
     2610             new_shift-period.period-name = "Прием НП (№" + v-prev-doc-code + ") - Конец смены"
     2611             new_shift-period.ost-mass = 0
     2612           .
     2613           run calc_control-density .
     2614           if new_shift-period.control-density = 0
     2615           or new_shift-period.control-density = ?
     2616           then do :
     2617             delete new_shift-period .
     2618             next pl-gds_ .
     2619           end .
     2620           run calc_sales-density15 (output v-del-shift-period) .
     2621           if v-del-shift-period
     2622           then do :
     2623             delete new_shift-period .
     2624             next pl-gds_ .
     2625           end .
     2626           assign new_shift-period.delta-density = new_shift-period.sales-density15 - new_shift-period.control-density .
     2627           run put_log .
     2628         end .
     2629       end .
     2630       else do :
     2631         find first buf_place-attr exclusive-lock where buf_place-attr.obj-type = prev_rvs-doc.obj-type
     2632                                                    and buf_place-attr.obj-code = prev_rvs-doc.obj-code
     2633                                                    and buf_place-attr.pl-code  = tt-pl-gds.pl-code
     2634                                                    and buf_place-attr.attr-code = "init-shift-period-rvs"
     2635                                                    no-error .
     2636         if available buf_place-attr
     2637         and buf_place-attr.attr-value = prev_rvs-doc.rvs-code
     2638         then do :
     2639           assign tt-pl-gds.is-init = yes .
     2640         end .
     2641         trn-doc_ :
     2642         for each buf_trn-doc no-lock where buf_trn-doc.obj-type   = cur_shift-obj.obj-type
     2643                                        and buf_trn-doc.obj-code   = cur_shift-obj.obj-code
     2644                                        and buf_trn-doc.shift-date = cur_shift-obj.shift-date
     2645                                        and buf_trn-doc.shift-num  = cur_shift-obj.shift-num
     2646                                        and buf_trn-doc.status_    = 'факт':U
     2647                                        and buf_trn-doc.ext-doc-type = 'ie':U
     2648         :
     2649           for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     2650                                                and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     2651                                                and buf_clients-attr.attr-code = 'shftrep2':U
     2652                                                :
     2653             if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next trn-doc_ .
     2654           end .
     2655           find first buf_doc-pl no-lock where buf_doc-pl.obj-type = buf_trn-doc.obj-type
     2656                                           and buf_doc-pl.obj-code = buf_trn-doc.obj-code
     2657                                           and buf_doc-pl.pl-code  = tt-pl-gds.pl-code
     2658                                           and buf_doc-pl.out-code = buf_trn-doc.doc-code
     2659                                           and buf_doc-pl.gds-code = tt-pl-gds.gds-code
     2660                                           no-error .
     2661           if available buf_doc-pl
     2662           then do :
     2663             assign tt-pl-gds.num-pri-doc = tt-pl-gds.num-pri-doc + 1 .
     2664           end .
     2665         end .
     2666         if tt-pl-gds.num-pri-doc = 0
     2667         then do :
     2668           create new_shift-period .
     2669           assign
     2670             new_shift-period.obj-type    = cur_shift-obj.obj-type
     2671             new_shift-period.obj-code    = cur_shift-obj.obj-code
     2672             new_shift-period.shift-num   = cur_shift-obj.shift-num
     2673             new_shift-period.shift-date  = cur_shift-obj.shift-date
     2674             new_shift-period.period-num  = tt-pl-gds.period-num
     2675             new_shift-period.pl-code     = tt-pl-gds.pl-code
     2676             new_shift-period.gds-code    = tt-pl-gds.gds-code
     2677             new_shift-period.period-type = if tt-pl-gds.is-init then 0 else 2
     2678             new_shift-period.period-name = if tt-pl-gds.is-init then "Инициализация - Конец смены" else "Начало смены - Конец смены"
     2679             new_shift-period.ost-density = prev_rvs-line.state-density
     2680             new_shift-period.ost-mass    = prev_rvs-line.state-measure-cli-qnty
     2681             new_shift-period.ost-temperature = prev_rvs-line.state-temperature
     2682           .
     2683           run calc_control-density .
     2684           run calc_sales-density15 (output v-del-shift-period) .
     2685           if v-del-shift-period
     2686           then do :
     2687             delete new_shift-period .
     2688             next pl-gds_ .
     2689           end .
     2690           assign new_shift-period.delta-density = new_shift-period.sales-density15 - new_shift-period.control-density .
     2691           run put_log .
     2692         end .
     2693         else do :
     2694           trn-doc_ :
     2695           for each buf_trn-doc no-lock where buf_trn-doc.obj-type   = cur_shift-obj.obj-type
     2696                                          and buf_trn-doc.obj-code   = cur_shift-obj.obj-code
     2697                                          and buf_trn-doc.shift-date = cur_shift-obj.shift-date
     2698                                          and buf_trn-doc.shift-num  = cur_shift-obj.shift-num
     2699                                          and buf_trn-doc.status_    = 'факт':U
     2700                                          and buf_trn-doc.ext-doc-type = 'ie':U
     2701                                          by buf_trn-doc.fact-order
     2702           :
     2703             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     2704                                                  and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     2705                                                  and buf_clients-attr.attr-code = 'shftrep2':U
     2706                                                  :
     2707               if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next trn-doc_ .
     2708             end .
     2709             find first buf_doc-pl no-lock where buf_doc-pl.obj-type = buf_trn-doc.obj-type
     2710                                             and buf_doc-pl.obj-code = buf_trn-doc.obj-code
     2711                                             and buf_doc-pl.pl-code  = tt-pl-gds.pl-code
     2712                                             and buf_doc-pl.out-code = buf_trn-doc.doc-code
     2713                                             and buf_doc-pl.gds-code = tt-pl-gds.gds-code
     2714                                             no-error .
     2715             if available buf_doc-pl
     2716             then do :
     2717               create new_shift-period .
     2718               assign
     2719                 new_shift-period.obj-type    = cur_shift-obj.obj-type
     2720                 new_shift-period.obj-code    = cur_shift-obj.obj-code
     2721                 new_shift-period.shift-num   = cur_shift-obj.shift-num
     2722                 new_shift-period.shift-date  = cur_shift-obj.shift-date
     2723                 new_shift-period.period-num  = tt-pl-gds.period-num
     2724                 new_shift-period.pl-code     = tt-pl-gds.pl-code
     2725                 new_shift-period.gds-code    = tt-pl-gds.gds-code
     2726               .
     2727               if new_shift-period.period-num = 1
     2728               then do :
     2729                 assign
     2730                   new_shift-period.period-type = if tt-pl-gds.is-init then 1 else 3
     2731                   new_shift-period.period-name = if tt-pl-gds.is-init then ("Инициализация - Прием НП (№" + buf_trn-doc.doc-code + ")") else ("Начало смены - Прием НП (№" + buf_trn-doc.doc-code + ")")
     2732                   new_shift-period.ost-density = prev_rvs-line.state-density
     2733                   new_shift-period.ost-mass    = prev_rvs-line.state-measure-cli-qnty
     2734                   new_shift-period.ost-temperature = prev_rvs-line.state-temperature
     2735                 .
     2736                 run calc_control-density .
     2737                 run calc_sales-density15 (output v-del-shift-period) .
     2738                 if v-del-shift-period
     2739                 then do :
     2740                   assign
     2741                     tt-pl-gds.period-num = tt-pl-gds.period-num + 1
     2742                     v-prev-doc-code = buf_trn-doc.doc-code
     2743                     v-prev-control-density = new_shift-period.control-density
     2744                   .
     2745                   delete new_shift-period .
     2746                   next trn-doc_ .
     2747                 end .
     2748                 assign new_shift-period.delta-density = new_shift-period.sales-density15 - new_shift-period.control-density .
     2749                 run put_log .
     2750                 assign
     2751                   tt-pl-gds.period-num = tt-pl-gds.period-num + 1
     2752                   v-prev-doc-code = buf_trn-doc.doc-code
     2753                   v-prev-control-density = new_shift-period.control-density
     2754                 .
     2755               end .
     2756               else do :
     2757                 assign
     2758                   new_shift-period.period-type = 4
     2759                   new_shift-period.period-name = "Прием НП (№" + v-prev-doc-code + ") - Прием НП (№" + buf_trn-doc.doc-code + ")"
     2760                   new_shift-period.ost-mass = 0
     2761                 .
     2762                 run calc_control-density .
     2763                 if new_shift-period.control-density = 0
     2764                 or new_shift-period.control-density = ?
     2765                 then do :
     2766                   assign
     2767                     tt-pl-gds.period-num = tt-pl-gds.period-num + 1
     2768                     v-prev-doc-code = buf_trn-doc.doc-code
     2769                   .
     2770                   delete new_shift-period .
     2771                   next trn-doc_ .
     2772                 end .
     2773                 run calc_sales-density15 (output v-del-shift-period) .
     2774                 if v-del-shift-period
     2775                 then do :
     2776                   assign
     2777                     tt-pl-gds.period-num = tt-pl-gds.period-num + 1
     2778                     v-prev-doc-code = buf_trn-doc.doc-code
     2779                     v-prev-control-density = new_shift-period.control-density
     2780                   .
     2781                   delete new_shift-period .
     2782                   next trn-doc_ .
     2783                 end .
     2784                 assign new_shift-period.delta-density = new_shift-period.sales-density15 - new_shift-period.control-density .
     2785                 if tt-pl-gds.num-pri-doc > 2
     2786                 then do :
     2787                   assign tt-pl-gds.num-pri-periods = tt-pl-gds.num-pri-periods + 1 .
     2788                 end .
     2789                 run put_log .
     2790                 assign
     2791                   tt-pl-gds.period-num = tt-pl-gds.period-num + 1
     2792                   v-prev-doc-code = buf_trn-doc.doc-code
     2793                   v-prev-control-density = new_shift-period.control-density
     2794                 .
     2795               end .
     2796             end .
     2797           end .
     2798           create new_shift-period .
     2799           assign
     2800             new_shift-period.obj-type    = cur_shift-obj.obj-type
     2801             new_shift-period.obj-code    = cur_shift-obj.obj-code
     2802             new_shift-period.shift-num   = cur_shift-obj.shift-num
     2803             new_shift-period.shift-date  = cur_shift-obj.shift-date
     2804             new_shift-period.period-num  = tt-pl-gds.period-num
     2805             new_shift-period.pl-code     = tt-pl-gds.pl-code
     2806             new_shift-period.gds-code    = tt-pl-gds.gds-code
     2807           .
     2808           assign
     2809             new_shift-period.period-type = 5
     2810             new_shift-period.period-name = "Прием НП (№" + v-prev-doc-code + ") - Конец смены"
     2811             new_shift-period.ost-mass = 0
     2812           .
     2813           run calc_control-density .
     2814           if new_shift-period.control-density = 0
     2815           or new_shift-period.control-density = ?
     2816           then do :
     2817             delete new_shift-period .
     2818             next pl-gds_ .
     2819           end .
     2820           run calc_sales-density15 (output v-del-shift-period) .
     2821           if v-del-shift-period
     2822           then do :
     2823             delete new_shift-period .
     2824             next pl-gds_ .
     2825           end .
     2826           assign new_shift-period.delta-density = new_shift-period.sales-density15 - new_shift-period.control-density .
     2827           run put_log .
     2828         end .
     2829       end .
     2830     end .
     2831   end procedure.
     2832   procedure put_log :
     2833     define variable v-gds-name as character no-undo .
     2834     define variable v-period-type as character no-undo .
     2835     for first buf_goods no-lock where buf_goods.gds-code = tt-pl-gds.gds-code :
     2836       assign v-gds-name = buf_goods.gds-name .
     2837     end .
     2838     assign v-period-type = string(new_shift-period.period-type) .
     2839     if new_shift-period.period-type = 4
     2840     and tt-pl-gds.num-pri-periods > 0
     2841     then do :
     2842       assign v-period-type = string(new_shift-period.period-type) + "." + string(tt-pl-gds.num-pri-periods) .
     2843     end .
     2844     output stream s-log to value ("shift-period.log") append.
     2845     put stream s-log unformatted
     2846       "    " skip
     2847       "----------------------------------------------------------" skip
     2848       cur-time-string()           format "x(16)"    skip
     2849       "Дата смены: " new_shift-period.shift-date skip
     2850       "Порядок и номер смены: " new_shift-period.shift-num " (" cur_shift-obj.shift-name ")" skip
     2851       "Период в смене: " v-period-type skip
     2852       "Резервуар: " tt-pl-gds.loc1 skip
     2853       "Наименование топлива: " v-gds-name skip
     2854       "    " skip
     2855       "p_КОНТР = " new_shift-period.control-density skip
     2856       "M_ОСТ = " new_shift-period.ost-mass skip
     2857       "p_ОСТ = " new_shift-period.ost-density skip
     2858       "t_ОСТ = " new_shift-period.ost-temperature skip
     2859       "p_ОСТ15 = " new_shift-period.ost-density15 skip
     2860       "V_ОСТ15 = " new_shift-period.ost-volume15 skip
     2861       "p_(ПОС.КОНТР) = " new_shift-period.last-density skip
     2862     .
     2863     if new_shift-period.period-type = 4
     2864     or new_shift-period.period-type = 5
     2865     then do :
     2866       put stream s-log unformatted
     2867         "M_АЦ = " new_shift-period.income-mass skip
     2868         "p_АЦ15 = " new_shift-period.income-density15 skip
     2869         "V_АЦ15 = " new_shift-period.income-volume15 skip
     2870       .
     2871     end .
     2872     put stream s-log unformatted
     2873       "сумма_M_Реализ = " new_shift-period.sales-mass skip
     2874       "сумма_V_Реализ = " new_shift-period.sales-volume skip
     2875       "p_Реализ = " new_shift-period.sales-density skip
     2876       "сумма_t_ОкаймляющейСверки = " (v-num-fringing-rvs * new_shift-period.sales-temperature) skip
     2877       "n = " v-num-fringing-rvs skip
     2878       "t_Реализ = " new_shift-period.sales-temperature skip
     2879       "p_Реализ15 = " new_shift-period.sales-density15 skip
     2880       "дельта_p_ПЕРИОД = " new_shift-period.delta-density skip
     2881     .
     2882     output stream s-log close .
     2883   end procedure .
     2884   procedure calc_control-density :
     2885     define variable v-tmp-rvs-code as character no-undo .
     2886     define variable v-last-calc-control-density as decimal no-undo .
     2887     define buffer tmp_rvs-doc for ub.rvs-doc .
     2888     case new_shift-period.period-type :
     2889       when 0 or when 1
     2890       then do :
     2891         find first prev_rvs-line-attr no-lock where prev_rvs-line-attr.obj-type = prev_rvs-line.obj-type
     2892                                                 and prev_rvs-line-attr.obj-code = prev_rvs-line.obj-code
     2893                                                 and prev_rvs-line-attr.rvs-code = prev_rvs-line.rvs-code
     2894                                                 and prev_rvs-line-attr.pl-code  = prev_rvs-line.pl-code
     2895                                                 and prev_rvs-line-attr.gds-code = prev_rvs-line.gds-code
     2896                                                 and prev_rvs-line-attr.attr-code = "POkMI-result"
     2897                                                 no-error .
     2898         if not available prev_rvs-line-attr
     2899         then do :
     2900           if prev_rvs-doc.ps begins "Создана на основе"
     2901           then do :
     2902             assign
     2903               v-tmp-rvs-code = entry(2, prev_rvs-doc.ps, "№")
     2904               v-tmp-rvs-code = trim(v-tmp-rvs-code, ".")
     2905               v-tmp-rvs-code = trim(v-tmp-rvs-code)
     2906             .
     2907             find first prev_rvs-line-attr no-lock where prev_rvs-line-attr.obj-type = prev_rvs-line.obj-type
     2908                                                     and prev_rvs-line-attr.obj-code = prev_rvs-line.obj-code
     2909                                                     and prev_rvs-line-attr.rvs-code = v-tmp-rvs-code
     2910                                                     and prev_rvs-line-attr.pl-code  = prev_rvs-line.pl-code
     2911                                                     and prev_rvs-line-attr.gds-code = prev_rvs-line.gds-code
     2912                                                     and prev_rvs-line-attr.attr-code = "POkMI-result"
     2913                                                     no-error .
     2914             if not available prev_rvs-line-attr
     2915             then do :
     2916               find first tmp_rvs-doc no-lock where tmp_rvs-doc.rvs-code = v-tmp-rvs-code no-error .
     2917               if available tmp_rvs-doc
     2918               and tmp_rvs-doc.ps begins "Создана на основе"
     2919               then do :
     2920                 assign
     2921                   v-tmp-rvs-code = entry(2, tmp_rvs-doc.ps, "№")
     2922                   v-tmp-rvs-code = trim(v-tmp-rvs-code, ".")
     2923                   v-tmp-rvs-code = trim(v-tmp-rvs-code)
     2924                 .
     2925                 find first prev_rvs-line-attr no-lock where prev_rvs-line-attr.obj-type = prev_rvs-line.obj-type
     2926                                                         and prev_rvs-line-attr.obj-code = prev_rvs-line.obj-code
     2927                                                         and prev_rvs-line-attr.rvs-code = v-tmp-rvs-code
     2928                                                         and prev_rvs-line-attr.pl-code  = prev_rvs-line.pl-code
     2929                                                         and prev_rvs-line-attr.gds-code = prev_rvs-line.gds-code
     2930                                                         and prev_rvs-line-attr.attr-code = "POkMI-result"
     2931                                                         no-error .
     2932               end .
     2933             end .
     2934           end .
     2935         end .
     2936         if available prev_rvs-line-attr
     2937         then do :
     2938           assign new_shift-period.ost-density15 = decimal(entry(2, entry(3, prev_rvs-line-attr.attr-value, chr(10)), ":")) no-error .
     2939         end .
     2940         else do :
     2941           assign new_shift-period.ost-density15 = prev_rvs-line.state-density .
     2942         end .
     2943         assign
     2944           new_shift-period.control-density = new_shift-period.ost-density15
     2945           new_shift-period.last-density = new_shift-period.control-density
     2946         .
     2947       end .
     2948       when 2 or when 3
     2949       then do :
     2950         if prev_shift-period.control-density > 0
     2951         then do :
     2952           assign
     2953             new_shift-period.last-density = prev_shift-period.control-density
     2954             new_shift-period.control-density = new_shift-period.last-density
     2955           .
     2956         end .
     2957         else do :
     2958           find last prev2_shift-period no-lock where prev2_shift-period.obj-type = prev_rvs-doc.obj-type
     2959                                                  and prev2_shift-period.obj-code = prev_rvs-doc.obj-code
     2960                                                  and prev2_shift-period.gds-code = tt-pl-gds.gds-code
     2961                                                  and prev2_shift-period.pl-code  = tt-pl-gds.pl-code
     2962                                                  and prev2_shift-period.control-density > 0
     2963                                                  use-index pi
     2964                                                  no-error .
     2965           if available prev2_shift-period
     2966           then do :
     2967             assign
     2968               new_shift-period.last-density = prev2_shift-period.control-density
     2969               new_shift-period.control-density = new_shift-period.last-density
     2970             .
     2971           end .
     2972           else do :
     2973             find first prev_rvs-line-attr no-lock where prev_rvs-line-attr.obj-type = prev_rvs-line.obj-type
     2974                                                     and prev_rvs-line-attr.obj-code = prev_rvs-line.obj-code
     2975                                                     and prev_rvs-line-attr.rvs-code = prev_rvs-line.rvs-code
     2976                                                     and prev_rvs-line-attr.pl-code  = prev_rvs-line.pl-code
     2977                                                     and prev_rvs-line-attr.gds-code = prev_rvs-line.gds-code
     2978                                                     and prev_rvs-line-attr.attr-code = "POkMI-result"
     2979                                                     no-error .
     2980             if not available prev_rvs-line-attr
     2981             then do :
     2982               if prev_rvs-doc.ps begins "Создана на основе"
     2983               then do :
     2984                 assign
     2985                   v-tmp-rvs-code = entry(2, prev_rvs-doc.ps, "№")
     2986                   v-tmp-rvs-code = trim(v-tmp-rvs-code, ".")
     2987                   v-tmp-rvs-code = trim(v-tmp-rvs-code)
     2988                 .
     2989                 find first prev_rvs-line-attr no-lock where prev_rvs-line-attr.obj-type = prev_rvs-line.obj-type
     2990                                                         and prev_rvs-line-attr.obj-code = prev_rvs-line.obj-code
     2991                                                         and prev_rvs-line-attr.rvs-code = v-tmp-rvs-code
     2992                                                         and prev_rvs-line-attr.pl-code  = prev_rvs-line.pl-code
     2993                                                         and prev_rvs-line-attr.gds-code = prev_rvs-line.gds-code
     2994                                                         and prev_rvs-line-attr.attr-code = "POkMI-result"
     2995                                                         no-error .
     2996                 if not available prev_rvs-line-attr
     2997                 then do :
     2998                   find first tmp_rvs-doc no-lock where tmp_rvs-doc.rvs-code = v-tmp-rvs-code no-error .
     2999                   if available tmp_rvs-doc
     3000                   and tmp_rvs-doc.ps begins "Создана на основе"
     3001                   then do :
     3002                     assign
     3003                       v-tmp-rvs-code = entry(2, tmp_rvs-doc.ps, "№")
     3004                       v-tmp-rvs-code = trim(v-tmp-rvs-code, ".")
     3005                       v-tmp-rvs-code = trim(v-tmp-rvs-code)
     3006                     .
     3007                     find first prev_rvs-line-attr no-lock where prev_rvs-line-attr.obj-type = prev_rvs-line.obj-type
     3008                                                             and prev_rvs-line-attr.obj-code = prev_rvs-line.obj-code
     3009                                                             and prev_rvs-line-attr.rvs-code = v-tmp-rvs-code
     3010                                                             and prev_rvs-line-attr.pl-code  = prev_rvs-line.pl-code
     3011                                                             and prev_rvs-line-attr.gds-code = prev_rvs-line.gds-code
     3012                                                             and prev_rvs-line-attr.attr-code = "POkMI-result"
     3013                                                             no-error .
     3014                   end .
     3015                 end .
     3016               end .
     3017             end .
     3018             if available prev_rvs-line-attr
     3019             then do :
     3020               assign
     3021                 new_shift-period.control-density = decimal(entry(2, entry(3, prev_rvs-line-attr.attr-value, chr(10)), ":"))
     3022                 new_shift-period.last-density = new_shift-period.control-density
     3023               no-error .
     3024             end .
     3025             else do :
     3026               assign
     3027                 new_shift-period.control-density = prev_rvs-line.state-density
     3028                 new_shift-period.last-density = new_shift-period.control-density
     3029               .
     3030             end .
     3031           end .
     3032         end .
     3033       end .
     3034       when 4 or when 5
     3035       then do :
     3036         if v-prev-control-density > 0
     3037         then do :
     3038           assign v-last-calc-control-density = v-prev-control-density .
     3039         end .
     3040         else do :
     3041           find last prev2_shift-period no-lock where prev2_shift-period.obj-type = prev_rvs-doc.obj-type
     3042                                                  and prev2_shift-period.obj-code = prev_rvs-doc.obj-code
     3043                                                  and prev2_shift-period.gds-code = tt-pl-gds.gds-code
     3044                                                  and prev2_shift-period.pl-code  = tt-pl-gds.pl-code
     3045                                                  and prev2_shift-period.control-density > 0
     3046                                                  use-index pi
     3047                                                  no-error .
     3048           if available prev2_shift-period
     3049           then do :
     3050             assign v-last-calc-control-density = prev2_shift-period.control-density .
     3051           end .
     3052           else do :
     3053             find first prev_rvs-line-attr no-lock where prev_rvs-line-attr.obj-type = prev_rvs-line.obj-type
     3054                                                     and prev_rvs-line-attr.obj-code = prev_rvs-line.obj-code
     3055                                                     and prev_rvs-line-attr.rvs-code = prev_rvs-line.rvs-code
     3056                                                     and prev_rvs-line-attr.pl-code  = prev_rvs-line.pl-code
     3057                                                     and prev_rvs-line-attr.gds-code = prev_rvs-line.gds-code
     3058                                                     and prev_rvs-line-attr.attr-code = "POkMI-result"
     3059                                                     no-error .
     3060             if not available prev_rvs-line-attr
     3061             then do :
     3062               if prev_rvs-doc.ps begins "Создана на основе"
     3063               then do :
     3064                 assign
     3065                   v-tmp-rvs-code = entry(2, prev_rvs-doc.ps, "№")
     3066                   v-tmp-rvs-code = trim(v-tmp-rvs-code, ".")
     3067                   v-tmp-rvs-code = trim(v-tmp-rvs-code)
     3068                 .
     3069                 find first prev_rvs-line-attr no-lock where prev_rvs-line-attr.obj-type = prev_rvs-line.obj-type
     3070                                                         and prev_rvs-line-attr.obj-code = prev_rvs-line.obj-code
     3071                                                         and prev_rvs-line-attr.rvs-code = v-tmp-rvs-code
     3072                                                         and prev_rvs-line-attr.pl-code  = prev_rvs-line.pl-code
     3073                                                         and prev_rvs-line-attr.gds-code = prev_rvs-line.gds-code
     3074                                                         and prev_rvs-line-attr.attr-code = "POkMI-result"
     3075                                                         no-error .
     3076                 if not available prev_rvs-line-attr
     3077                 then do :
     3078                   find first tmp_rvs-doc no-lock where tmp_rvs-doc.rvs-code = v-tmp-rvs-code no-error .
     3079                   if available tmp_rvs-doc
     3080                   and tmp_rvs-doc.ps begins "Создана на основе"
     3081                   then do :
     3082                     assign
     3083                       v-tmp-rvs-code = entry(2, tmp_rvs-doc.ps, "№")
     3084                       v-tmp-rvs-code = trim(v-tmp-rvs-code, ".")
     3085                       v-tmp-rvs-code = trim(v-tmp-rvs-code)
     3086                     .
     3087                     find first prev_rvs-line-attr no-lock where prev_rvs-line-attr.obj-type = prev_rvs-line.obj-type
     3088                                                             and prev_rvs-line-attr.obj-code = prev_rvs-line.obj-code
     3089                                                             and prev_rvs-line-attr.rvs-code = v-tmp-rvs-code
     3090                                                             and prev_rvs-line-attr.pl-code  = prev_rvs-line.pl-code
     3091                                                             and prev_rvs-line-attr.gds-code = prev_rvs-line.gds-code
     3092                                                             and prev_rvs-line-attr.attr-code = "POkMI-result"
     3093                                                             no-error .
     3094                   end .
     3095                 end .
     3096               end .
     3097             end .
     3098             if available prev_rvs-line-attr
     3099             then do :
     3100               assign v-last-calc-control-density = decimal(entry(2, entry(3, prev_rvs-line-attr.attr-value, chr(10)), ":")) no-error .
     3101             end .
     3102             else do :
     3103               assign v-last-calc-control-density = prev_rvs-line.state-density .
     3104             end .
     3105           end .
     3106         end .
     3107         for each before_rvs-doc no-lock where before_rvs-doc.rvs-type = 'перед_док':U
     3108                                           and before_rvs-doc.out-code = v-prev-doc-code
     3109         :
     3110           for first before_rvs-line no-lock where before_rvs-line.rvs-code = before_rvs-doc.rvs-code
     3111                                               and before_rvs-line.obj-type = before_rvs-doc.obj-type
     3112                                               and before_rvs-line.obj-code = before_rvs-doc.obj-code
     3113                                               and before_rvs-line.pl-code  = tt-pl-gds.pl-code
     3114                                               and before_rvs-line.gds-code = tt-pl-gds.gds-code
     3115           :
     3116             if new_shift-period.ost-mass = 0
     3117             or new_shift-period.ost-mass > before_rvs-line.state-measure-cli-qnty
     3118             then do :
     3119               assign
     3120                 new_shift-period.ost-mass = before_rvs-line.state-measure-cli-qnty
     3121                 new_shift-period.ost-volume15 = new_shift-period.ost-mass / v-last-calc-control-density
     3122               .
     3123             end .
     3124           end .
     3125         end .
     3126         v-InfoSectionsTotal = new InfoSectionsTotal(v-prev-doc-code, tt-pl-gds.gds-code, "").
     3127         do iNum = 1 to v-InfoSectionsTotal:SectionNum :
     3128           v-InfoSection = v-InfoSectionsTotal:GetInfoSectionProp(iNum) .
     3129           if v-InfoSection:ListTank = tt-pl-gds.loc1
     3130           then do :
     3131             assign
     3132               new_shift-period.income-mass = new_shift-period.income-mass + v-InfoSection:CliQnty
     3133               new_shift-period.income-volume15 = new_shift-period.income-volume15 + (v-InfoSection:CliQnty / v-InfoSection:PaspDens)
     3134             .
     3135           end .
     3136         end .
     3137         delete object v-InfoSection .
     3138         delete object v-InfoSectionsTotal .
     3139         assign
     3140           new_shift-period.last-density = v-last-calc-control-density
     3141           new_shift-period.income-density15 = new_shift-period.income-mass / new_shift-period.income-volume15
     3142           new_shift-period.control-density = (new_shift-period.ost-mass + new_shift-period.income-mass) / (new_shift-period.ost-volume15 + new_shift-period.income-volume15)
     3143         .
     3144       end .
     3145     end case .
     3146   end procedure .
     3147   procedure calc_sales-density15 :
     3148     define output parameter p-del as logical no-undo init no .
     3149     define buffer last-before_rvs-doc for ub.rvs-doc .
     3150     define buffer last-before_rvs-line for ub.rvs-line .
     3151     define buffer first-after_rvs-doc for ub.rvs-doc .
     3152     define buffer first-after_rvs-line for ub.rvs-line .
     3153     define buffer buf_doc-attr      for ub.doc-attr.
     3154     define buffer buf_rvs-line-attr for ub.rvs-line-attr.
     3155     case new_shift-period.period-type :
     3156       when 0 or when 2
     3157       then do :
     3158         run calc_sales-density
     3159           (input cur_shift-obj.open-date,
     3160            input cur_shift-obj.open-time,
     3161            input cur_shift-obj.close-date,
     3162            input cur_shift-obj.close-time,
     3163            output p-del)
     3164         .
     3165         if p-del
     3166         then do :
     3167           return .
     3168         end .
     3169       end .
     3170       when 1 or when 3
     3171       then do :
     3172         find first ttDump where ttDump.doc-code = buf_trn-doc.doc-code no-error .
     3173         if available ttDump
     3174         then do :
     3175           for each last-before_rvs-doc no-lock where last-before_rvs-doc.obj-type   = cur_shift-obj.obj-type
     3176                                                  and last-before_rvs-doc.obj-code   = cur_shift-obj.obj-code
     3177                                                  and last-before_rvs-doc.shift-date = cur_shift-obj.shift-date
     3178                                                  and last-before_rvs-doc.shift-num  = cur_shift-obj.shift-num
     3179                                                  and last-before_rvs-doc.status_    = 'факт':U
     3180                                                  by last-before_rvs-doc.fact-order desc
     3181           :
     3182             if last-before_rvs-doc.rvs-type  = 'перед_док':U
     3183             or last-before_rvs-doc.rvs-type  = 'после_док':U
     3184             or last-before_rvs-doc.rvs-type  = 'проверка':U
     3185             then next .
     3186             find first last-before_rvs-line no-lock where last-before_rvs-line.rvs-code = last-before_rvs-doc.rvs-code
     3187                                                       and last-before_rvs-line.obj-type = last-before_rvs-doc.obj-type
     3188                                                       and last-before_rvs-line.obj-code = last-before_rvs-doc.obj-code
     3189                                                       and last-before_rvs-line.pl-code  = tt-pl-gds.pl-code
     3190                                                       and last-before_rvs-line.gds-code = tt-pl-gds.gds-code
     3191                                                       no-error .
     3192             if not available last-before_rvs-line
     3193             then next .
     3194             if can-find(first buf_doc-attr no-lock where buf_doc-attr.doc-code = last-before_rvs-doc.rvs-code
     3195                                                      and buf_doc-attr.attr-code = "rvs-auto"
     3196                                                      and buf_doc-attr.attr-value = "Yes")
     3197             and can-find(first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = last-before_rvs-line.obj-code
     3198                                                            and buf_rvs-line-attr.obj-type  = last-before_rvs-line.obj-type
     3199                                                            and buf_rvs-line-attr.gds-code  = last-before_rvs-line.gds-code
     3200                                                            and buf_rvs-line-attr.pl-code   = last-before_rvs-line.pl-code
     3201                                                            and buf_rvs-line-attr.rvs-code  = last-before_rvs-line.rvs-code
     3202                                                            and buf_rvs-line-attr.attr-code = "rvd-on"
     3203                                                            and buf_rvs-line-attr.attr-value > "")
     3204             then next .
     3205             if datetime(last-before_rvs-doc.sys-date, (last-before_rvs-doc.sys-time-int * 1000)) <= ttDump.BegTime
     3206             then leave .
     3207           end .
     3208         end .
     3209         if available last-before_rvs-doc
     3210         then do :
     3211           run calc_sales-density
     3212             (input cur_shift-obj.open-date,
     3213              input cur_shift-obj.open-time,
     3214              input last-before_rvs-doc.sys-date,
     3215              input last-before_rvs-doc.sys-time-int,
     3216              output p-del)
     3217           .
     3218           if p-del
     3219           then do :
     3220             return .
     3221           end .
     3222         end .
     3223         else do :
     3224           p-del = yes .
     3225           return .
     3226         end .
     3227       end .
     3228       when 4
     3229       then do :
     3230         find first ttDump where ttDump.doc-code = v-prev-doc-code no-error .
     3231         if available ttDump
     3232         then do :
     3233           for each first-after_rvs-doc no-lock where first-after_rvs-doc.obj-type   = cur_shift-obj.obj-type
     3234                                                  and first-after_rvs-doc.obj-code   = cur_shift-obj.obj-code
     3235                                                  and first-after_rvs-doc.shift-date = cur_shift-obj.shift-date
     3236                                                  and first-after_rvs-doc.shift-num  = cur_shift-obj.shift-num
     3237                                                  and first-after_rvs-doc.status_    = 'факт':U
