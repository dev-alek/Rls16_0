     3857           if not available temp_sr-izmerenia then do :
     3858             undo _trpomi, return error substitute( 'Не найдено средство измерения с кодом &1', pl-temp-sr-izm ) .
     3859           end.
     3860           else do :
     3861             assign
     3862               DeltaAbs_Tv            = temp_sr-izmerenia.sr-abs-err-temp-vol
     3863               DeltaAbs_Tr            = temp_sr-izmerenia.sr-abs-err-temp-dens
     3864               ToolAutomationLevel_Tv = vAutomationDegree[temp_sr-izmerenia.sr-type-izm + 1]
     3865               ToolAutomationLevel_Tr = vAutomationDegree[temp_sr-izmerenia.sr-type-izm + 1]
     3866             .
     3867           end.
     3868         end .
     3869       end .
     3870       find first cur_rvs-line-attr no-lock
     3871         where cur_rvs-line-attr.obj-code  = cur_rvs-line.obj-code
     3872           and cur_rvs-line-attr.obj-type  = cur_rvs-line.obj-type
     3873           and cur_rvs-line-attr.gds-code  = cur_rvs-line.gds-code
     3874           and cur_rvs-line-attr.pl-code   = cur_rvs-line.pl-code
     3875           and cur_rvs-line-attr.rvs-code  = cur_rvs-line.rvs-code
     3876           and cur_rvs-line-attr.attr-code = "mi-tmp-dnst" no-error.
     3877       if available cur_rvs-line-attr
     3878       then do :
     3879         pl-temp-dens-sr-izm = integer(cur_rvs-line-attr.attr-value) .
