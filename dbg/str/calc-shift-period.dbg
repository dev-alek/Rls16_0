     3823           if not available level_sr-izmerenia then do :
     3824             undo _trpomi, return error substitute( 'Не найдено средство измерения с кодом &1', pl-level-sr-izm ) .
     3825           end.
     3826           else do :
     3827             assign
     3828               A_LevelMeasurementTool = level_sr-izmerenia.sr-temp-line
