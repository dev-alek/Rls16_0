     3279             or last-before_rvs-doc.rvs-type  = 'проверка':U
     3280             then next .
     3281             find first last-before_rvs-line no-lock where last-before_rvs-line.rvs-code = last-before_rvs-doc.rvs-code
     3282                                                       and last-before_rvs-line.obj-type = last-before_rvs-doc.obj-type
     3283                                                       and last-before_rvs-line.obj-code = last-before_rvs-doc.obj-code
     3284                                                       and last-before_rvs-line.pl-code  = tt-pl-gds.pl-code
     3285                                                       and last-before_rvs-line.gds-code = tt-pl-gds.gds-code
     3286                                                       no-error .
     3287             if not available last-before_rvs-line
     3288             then next .
     3289             if can-find(first buf_doc-attr no-lock where buf_doc-attr.doc-code = last-before_rvs-doc.rvs-code
     3290                                                      and buf_doc-attr.attr-code = "rvs-auto"
     3291                                                      and buf_doc-attr.attr-value = "Yes")
     3292             and can-find(first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = last-before_rvs-line.obj-code
     3293                                                            and buf_rvs-line-attr.obj-type  = last-before_rvs-line.obj-type
     3294                                                            and buf_rvs-line-attr.gds-code  = last-before_rvs-line.gds-code
     3295                                                            and buf_rvs-line-attr.pl-code   = last-before_rvs-line.pl-code
     3296                                                            and buf_rvs-line-attr.rvs-code  = last-before_rvs-line.rvs-code
     3297                                                            and buf_rvs-line-attr.attr-code = "rvd-on"
     3298                                                            and buf_rvs-line-attr.attr-value > "")
     3299             then next .
     3300             if datetime(last-before_rvs-doc.sys-date, (last-before_rvs-doc.sys-time-int * 1000)) <= ttDump.BegTime
     3301             then leave .
     3302           end .
     3303         end .
     3304         if available first-after_rvs-doc
     3305         and available last-before_rvs-doc
     3306         then do :
     3307           run calc_sales-density
     3308             (input first-after_rvs-doc.sys-date,
     3309              input first-after_rvs-doc.sys-time-int,
     3310              input last-before_rvs-doc.sys-date,
     3311              input last-before_rvs-doc.sys-time-int,
     3312              output p-del)
     3313           .
     3314           if p-del
     3315           then do :
