     3985               "DeltaAbs_H = " DeltaAbs_H  SKIP
     3986           .
     3987           OUTPUT stream s-pomi close.
     3988         end .
     3989       end .
     3990       assign temp-for-pomi = 15 .
     3991       find first cur_rvs-line-attr no-lock
     3992           where cur_rvs-line-attr.obj-code  = cur_rvs-line.obj-code
     3993             and cur_rvs-line-attr.obj-type  = cur_rvs-line.obj-type
     3994             and cur_rvs-line-attr.gds-code  = cur_rvs-line.gds-code
     3995             and cur_rvs-line-attr.pl-code   = cur_rvs-line.pl-code
     3996             and cur_rvs-line-attr.rvs-code  = cur_rvs-line.rvs-code
     3997             and cur_rvs-line-attr.attr-code = "temp-izm-vol" no-error.
     3998       if available cur_rvs-line-attr then do :
     3999         temp-izm-vol = decimal(cur_rvs-line-attr.attr-value) .
     4000       end.
     4001       else do :
     4002         temp-izm-vol = ? .
     4003       end.
     4004       if place-type = 1
     4005       then do :
     4006         v-proc = "CMethodOfMetering13" .
     4007         MM13
     4008           (input 0.0,
     4009            input 0.0,
     4010            input 0.0,
     4011            input 0.0,
     4012            input cur_rvs-line.state-level-total * 10,
     4013            input (if cur_rvs-line.state-level-water <> ? then cur_rvs-line.state-level-water * 10 else 0.0),
     4014            input CalibTable,
     4015            input CalibBelt,
     4016            input 0.0,
     4017            input 0.0,
     4018            input (if temp-izm-vol <> ? then temp-izm-vol else new_shift-period.sales-temperature),
     4019            input new_shift-period.sales-temperature,
     4020            input new_shift-period.sales-density * 1000,
     4021            input temp-for-pomi,
     4022            input ToolType,
     4023            input DeltaOtn_K,
     4024            input DeadZone_Reservoir,
     4025            input A_Reservoir,
     4026            input A_LevelMeasurementTool,
     4027            input ToolAutomationLevel_H,
     4028            input ToolAutomationLevel_H_Water,
     4029            input ToolAutomationLevel_R,
     4030            input ToolAutomationLevel_Tv,
     4031            input ToolAutomationLevel_Tr,
     4032            input DeltaAbs_H_CalcType,
     4033            input DeltaAbs_H_Water_CalcType,
     4034            input DeltaAbs_H,
     4035            input DeltaAbs_H_Water,
     4036            input DeltaAbs_R,
     4037            input DeltaAbs_Tv,
     4038            input DeltaAbs_Tr,
     4039            input DeltaOtn_N,
     4040            input 1,
     4041            input 2,
     4042            input 2,
     4043            output V_total,
     4044            output V_water,
     4045            output DeltaV,
     4046            output V_product,
     4047            output Vcy,
     4048            output Rcy,
     4049            output V,
     4050            output CTL_base_alt,
     4051            output CPL_base_alt,
     4052            output CTPL_base_alt,
     4053            output Fp_base_alt,
     4054            output CTL_obs_base,
     4055            output CPL_obs_base,
     4056            output CTPL_obs_base,
     4057            output Fp_obs_base,
     4058            output Rv,
     4059            output DeltaOtn_Vcy,
     4060            output DeltaOtn_Vm,
     4061            output M,
     4062            output DeltaOtn_M,
     4063            output VolumetricExpansion,
     4064            output vErr,
     4065            output vWrn,
     4066            output vDllVersion)
     4067         no-error .
     4068       end.
     4069       else do :
     4070         v-proc = "CMethodOfMetering6" .
     4071         MM6
     4072           (input cur_rvs-line.state-level-total * 10,
     4073            input (if cur_rvs-line.state-level-water <> ? then cur_rvs-line.state-level-water * 10 else 0.0),
     4074            input CalibTable,
     4075            input CalibBelt,
     4076            input 0.0,
     4077            input (if temp-izm-vol <> ? then temp-izm-vol else new_shift-period.sales-temperature),
     4078            input new_shift-period.sales-temperature,
     4079            input new_shift-period.sales-density * 1000,
     4080            input temp-for-pomi,
     4081            input ToolType,
     4082            input DeltaOtn_K,
     4083            input DeadZone_Reservoir,
     4084            input A_Reservoir,
