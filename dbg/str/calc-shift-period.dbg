      665   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      668   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
      669   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
      670   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
      671   define variable ptrlprop-autopump      as logical   no-undo initial false .
      672   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
      673   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
      674   define variable ptrlprop-olddens       as logical   no-undo initial false .
      675   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
      676   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
      677   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
      678   define variable ptrlprop-algoincome as integer no-undo init 0.
      679   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
      680   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
      681   define variable ptrlprop-Delta-mass-vert       as character no-undo .
      682   define variable ptrlprop-calc-free-vol as logical no-undo init false.
      683   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
      684   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
      685   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
      686   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
      687   define variable ptrlprop-block-nozzle as logical no-undo init false.
      688   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
      689   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
      690   procedure get-ptrl-prop :
      691     define input  parameter p-obj-type as character no-undo .
      692     define input  parameter p-obj-code as integer   no-undo .
      693     do
      694     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      695     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      696     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      697     :
      698       define variable par-type          as character no-undo.
      699       define variable v-value-character as character no-undo .
      700       define variable v-value-date      as date      no-undo .
      701       define variable v-value-decimal   as decimal   no-undo .
      702       define variable v-value-integer   as integer   no-undo .
      703       define variable v-value-logical   as logical   no-undo .
      704       for each thbjattr_thbj-attr
      705       :
      706         delete thbjattr_thbj-attr .
      707       end.
      708       run adm/shattri.p
      709         ( input "get":U
      710         , input p-obj-type
      711         , input p-obj-code
      712         , input 'petrol':U
      713         , input  ""
      714         , output v-value-character
      715         , output v-value-date
      716         , output v-value-decimal
      717         , output v-value-integer
      718         , output v-value-logical
      719         , output par-type
      720         , input-output table thbjattr_thbj-attr
      721         ) no-error .
      722       for each thbjattr_thbj-attr
      723       on error undo, return error return-value
      724       :
      725         case thbjattr_thbj-attr.prop-code :
      726           when 'denstclc':U then do:
      727             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      728               assign
      729                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      730               .
      731             end.
      732           end.
      733           when 'expptrl':U then do:
      734             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      735               and thbjattr_thbj-attr.prop-value-type = 'character':U
      736             then do:
      737               assign
      738                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      739               .
      740             end.
      741           end.
      742           when 'inpptrl':U then do:
      743             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      744               and thbjattr_thbj-attr.prop-value-type = 'character':U
      745             then do:
      746               assign
      747                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      748               .
      749             end.
      750           end.
      751           when 'autopump':U then do:
      752             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      753               assign
      754                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      755               .
      756             end.
      757           end.
      758           when 'rvsnmter':U then do:
      759             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      760               assign
      761                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      762               .
      763             end.
      764           end.
      765           when 'avtinvpm':U then do:
      766             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      767               assign
      768                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      769               .
      770             end.
      771           end.
      772           when 'invclipt':U then do:
      773             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      774               assign
      775                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      776               .
      777             end.
      778           end.
      779           when 'olddens':U then do:
      780             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      781               assign
      782                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      783               .
      784             end.
      785           end.
      786           when 'algrvspt':U then do:
      787             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      788               assign
      789                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      790               .
      791             end.
      792           end.
      793           when 'temp-for-pomi':U then do:
      794             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      795               assign
      796                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      797               .
      798             end.
      799           end.
      800           when 'algoincome':U then do:
      801             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      802               assign
      803                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      804               .
      805             end.
      806           end.
      807           when 'mand-choice-autocar':U then do:
      808             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      809               assign
      810                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      811               .
      812             end.
      813           end.
      814           when 'block-nozzle':U then do:
      815             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      816               assign
      817                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      818               .
      819             end.
      820           end.
      821           when 'timeout-block-nozzle':U then do:
      822             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      823               assign
      824                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      825               .
      826             end.
      827           end.
      828           when 'Delta-mass-horiz':U then do:
      829             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      830               assign
      831                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      832               .
      833             end.
      834           end.
      835           when 'Delta-mass-vert':U then do:
      836             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      837               assign
      838                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      839               .
      840             end.
      841           end.
      842           when 'calc-free-vol':U then do:
      843             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      844               assign
      845                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
      846               .
      847             end.
      848           end.
      849           when 'calc-free-vol-sug':U then do:
      850             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      851               assign
      852                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
      853               .
      854             end.
      855           end.
      856           when 'trn-reas-sug':U then do:
      857             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      858               assign
      859                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
      860               .
      861             end.
      862           end.
      863                 when 'rvd-own-nb':U then do:
      864             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      865               assign
      866                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
      867               .
      868             end.
      869           end.
      870           when 'qr-scan-time':U then do:
      871             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      872               assign
      873                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
      874               .
      875             end.
      876           end.
      877           when 'autopump-skip-time':U then do:
      878             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      879               assign
      880                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
      881               .
      882             end.
      883           end.
      884         end case.
      885         delete thbjattr_thbj-attr .
      886       end.
      887     end.
      888     return .
      889   end procedure.
      890   procedure placelib_write-attr:
      891   define input  parameter p-code     like ub.place-attr.attr-code .
      892   define input  parameter p-obj-code like ub.place-attr.obj-code .
      893   define input  parameter p-obj-type like ub.place-attr.obj-type .
      894   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      895   define input  parameter p-value    like ub.place-attr.attr-value .
      896   define output parameter p-ok       as logical.
      897   define buffer buf_place-attr for ub.place-attr .
      898     do on error undo, return error return-value :
      899        p-ok = false.
      900        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      901                                                   and buf_place-attr.obj-code    = p-obj-code
      902                                                   and buf_place-attr.obj-type    = p-obj-type
      903                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      904        if not available buf_place-attr then do :
      905           create buf_place-attr.
      906           assign
      907             buf_place-attr.attr-code   = p-code
      908             buf_place-attr.attr-value  = p-value
      909             buf_place-attr.obj-code    = p-obj-code
      910             buf_place-attr.obj-type    = p-obj-type
      911             buf_place-attr.pl-code     = p-pl-code
      912           .
      913           p-ok = true.
      914        end.
      915        else do:
      916           buf_place-attr.attr-value  = p-value .
      917           p-ok = true.
      918        end.
      919     end.
      920   end.
      921   procedure placelib_get-attr:
      922   define input  parameter  p-code     like ub.place-attr.attr-code .
      923   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      924   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      925   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      926   define output parameter  p-value    like ub.place-attr.attr-value .
      927   define output parameter  p-ok       as logical.
      928   define buffer buf_place-attr for ub.place-attr .
      929     do on error undo, return error return-value :
      930        p-ok = false.
      931        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      932                                                   and buf_place-attr.obj-code    = p-obj-code
      933                                                   and buf_place-attr.obj-type    = p-obj-type
      934                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      935        if available buf_place-attr then do :
      936          p-value = buf_place-attr.attr-value.
      937          p-ok = true.
      938        end.
      939        else do :
      940          p-ok = false.
      941        end.
      942     end.
      943   end.
      944   procedure placelib_del-attr:
      945   define input parameter  p-code     like ub.place-attr.attr-code .
      946   define input parameter  p-obj-code like ub.place-attr.obj-code .
      947   define input parameter  p-obj-type like ub.place-attr.obj-type .
      948   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      949   define input parameter  p-value    like ub.place-attr.attr-value .
      950   define output parameter p-ok       as logical.
      951   define buffer buf_place-attr for ub.place-attr .
      952     do on error undo, return error return-value :
      953        p-ok = false.
      954        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      955                                                   and buf_place-attr.obj-code    = p-obj-code
      956                                                   and buf_place-attr.obj-type    = p-obj-type
      957                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      958        if available buf_place-attr then do :
      959           delete buf_place-attr.
      960           p-ok = true.
      961        end.
      962     end.
      963   end.
