     3245                                                       and first-after_rvs-line.obj-type = first-after_rvs-doc.obj-type
     3246                                                       and first-after_rvs-line.obj-code = first-after_rvs-doc.obj-code
     3247                                                       and first-after_rvs-line.pl-code  = tt-pl-gds.pl-code
     3248                                                       and first-after_rvs-line.gds-code = tt-pl-gds.gds-code
     3249                                                       no-error .
     3250             if not available first-after_rvs-line
     3251             then next .
