     3830               DeltaAbs_H_Water       = level_sr-izmerenia.sr-abs-err-water
     3831               DeltaOtn_H             = level_sr-izmerenia.sr-relative-err-neft-water
     3832               DeltaOtn_H_Water       = level_sr-izmerenia.sr-relative-err-water
     3833             .
     3834           end.
     3835         end .
     3836       end .
     3837       if pl-rvd-temp
     3838       then do :
     3839         find first cur_rvs-line-attr no-lock
     3840           where cur_rvs-line-attr.obj-code  = cur_rvs-line.obj-code
     3841             and cur_rvs-line-attr.obj-type  = cur_rvs-line.obj-type
     3842             and cur_rvs-line-attr.gds-code  = cur_rvs-line.gds-code
     3843             and cur_rvs-line-attr.pl-code   = cur_rvs-line.pl-code
     3844             and cur_rvs-line-attr.rvs-code  = cur_rvs-line.rvs-code
     3845             and cur_rvs-line-attr.attr-code = "mi-tmp" no-error.
