     3264             then leave .
     3265           end .
     3266         end .
     3267         find first ttDump where ttDump.doc-code = buf_trn-doc.doc-code no-error .
     3268         if available ttDump
     3269         then do :
     3270           for each last-before_rvs-doc no-lock where last-before_rvs-doc.obj-type   = cur_shift-obj.obj-type
     3271                                                  and last-before_rvs-doc.obj-code   = cur_shift-obj.obj-code
     3272                                                  and last-before_rvs-doc.shift-date = cur_shift-obj.shift-date
     3273                                                  and last-before_rvs-doc.shift-num  = cur_shift-obj.shift-num
     3274                                                  and last-before_rvs-doc.status_    = 'факт':U
     3275                                                  by last-before_rvs-doc.fact-order desc
     3276           :
     3277             if last-before_rvs-doc.rvs-type  = 'перед_док':U
