     3326         find first ttDump where ttDump.doc-code = v-prev-doc-code no-error .
     3327         if available ttDump
     3328         then do :
     3329           for each first-after_rvs-doc no-lock where first-after_rvs-doc.obj-type   = cur_shift-obj.obj-type
     3330                                                  and first-after_rvs-doc.obj-code   = cur_shift-obj.obj-code
     3331                                                  and first-after_rvs-doc.shift-date = cur_shift-obj.shift-date
     3332                                                  and first-after_rvs-doc.shift-num  = cur_shift-obj.shift-num
     3333                                                  and first-after_rvs-doc.status_    = 'факт':U
     3334                                                  by first-after_rvs-doc.fact-order
     3335           :
     3336             if first-after_rvs-doc.rvs-type  = 'перед_док':U
     3337             or first-after_rvs-doc.rvs-type  = 'после_док':U
     3338             or first-after_rvs-doc.rvs-type  = 'проверка':U
     3339             then next .
     3340             find first first-after_rvs-line no-lock where first-after_rvs-line.rvs-code = first-after_rvs-doc.rvs-code
     3341                                                       and first-after_rvs-line.obj-type = first-after_rvs-doc.obj-type
     3342                                                       and first-after_rvs-line.obj-code = first-after_rvs-doc.obj-code
     3343                                                       and first-after_rvs-line.pl-code  = tt-pl-gds.pl-code
     3344                                                       and first-after_rvs-line.gds-code = tt-pl-gds.gds-code
     3345                                                       no-error .
     3346             if not available first-after_rvs-line
     3347             then next .
     3348             if can-find(first buf_doc-attr no-lock where buf_doc-attr.doc-code = first-after_rvs-doc.rvs-code
     3349                                                      and buf_doc-attr.attr-code = "rvs-auto"
     3350                                                      and buf_doc-attr.attr-value = "Yes")
     3351             and can-find(first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = first-after_rvs-line.obj-code
     3352                                                            and buf_rvs-line-attr.obj-type  = first-after_rvs-line.obj-type
     3353                                                            and buf_rvs-line-attr.gds-code  = first-after_rvs-line.gds-code
     3354                                                            and buf_rvs-line-attr.pl-code   = first-after_rvs-line.pl-code
     3355                                                            and buf_rvs-line-attr.rvs-code  = first-after_rvs-line.rvs-code
     3356                                                            and buf_rvs-line-attr.attr-code = "rvd-on"
     3357                                                            and buf_rvs-line-attr.attr-value > "")
     3358             then next .
     3359             if datetime(first-after_rvs-doc.sys-date, (first-after_rvs-doc.sys-time-int * 1000)) >= ttDump.EndTime
     3360             then leave .
     3361           end .
     3362         end .
     3363         if available first-after_rvs-doc
     3364         then do :
     3365           run calc_sales-density
     3366             (input first-after_rvs-doc.sys-date,
     3367              input first-after_rvs-doc.sys-time-int,
     3368              input cur_shift-obj.close-date,
     3369              input cur_shift-obj.close-time,
     3370              output p-del)
     3371           .
     3372           if p-del
     3373           then do :
     3374             return .
     3375           end .
     3376         end .
     3377         else do :
     3378           p-del = yes .
     3379           return .
     3380         end .
     3381       end .
     3382     end case .
     3383     run calc_sales-temperature .
     3384     run pomi-calc no-error .
     3385     if error-status:error
     3386     then do :
     3387       return return-value .
     3388     end .
     3389   end procedure .
     3390   procedure calc_sales-density :
     3391     define input parameter p-start-date as date no-undo .
     3392     define input parameter p-start-time as integer no-undo .
     3393     define input parameter p-end-date as date no-undo .
     3394     define input parameter p-end-time as integer no-undo .
     3395     define output parameter p-del as logical no-undo init no .
     3396     empty temp-table tt-fringing-rvs .
     3397     chk-doc_ :
     3398     for each buf_chk-doc no-lock where buf_chk-doc.obj-type = cur_shift-obj.obj-type
     3399                                    and buf_chk-doc.obj-code = cur_shift-obj.obj-code
     3400                                    and buf_chk-doc.shift-date = cur_shift-obj.shift-date
     3401                                    and buf_chk-doc.shift-num = cur_shift-obj.shift-num
     3402                                    and buf_chk-doc.chk-date >= p-start-date
     3403                                    and buf_chk-doc.chk-date <= p-end-date
     3404     :
     3405       if buf_chk-doc.out-code = ?
     3406       then next chk-doc_ .
     3407       if buf_chk-doc.chk-date = p-start-date
     3408       and buf_chk-doc.chk-time < p-start-time
     3409       then next chk-doc_ .
     3410       if buf_chk-doc.chk-date = p-end-date
     3411       and buf_chk-doc.chk-time > p-end-time
     3412       then next chk-doc_ .
     3413       if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next chk-doc_ .
     3414       for each buf_bar-code no-lock where buf_bar-code.gds-code = tt-pl-gds.gds-code,
     3415         each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     3416                                    and buf_chk-gds.b-code = buf_bar-code.b-code
     3417                                    and buf_chk-gds.pl-code = tt-pl-gds.pl-code
     3418       :
     3419         assign
     3420           new_shift-period.sales-volume = new_shift-period.sales-volume + buf_chk-gds.doc-qnty
     3421           new_shift-period.sales-mass = new_shift-period.sales-mass + (buf_chk-gds.doc-qnty * buf_chk-gds.density)
     3422         .
     3423         for first buf_chk-gds-attr exclusive-lock where buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3424                                                     and buf_chk-gds-attr.line-num = buf_chk-gds.line-num
     3425                                                     and buf_chk-gds-attr.attr-code = "Reconc-tank"
     3426         :
     3427           find first tt-fringing-rvs where tt-fringing-rvs.rvs-code = entry(1, buf_chk-gds-attr.attr-value) no-error .
     3428           if not available tt-fringing-rvs
     3429           and trim(entry(1, buf_chk-gds-attr.attr-value)) > ""
     3430           then do :
     3431             create tt-fringing-rvs .
     3432             assign tt-fringing-rvs.rvs-code = entry(1, buf_chk-gds-attr.attr-value) .
     3433           end .
     3434           find first tt-fringing-rvs where tt-fringing-rvs.rvs-code = entry(2, buf_chk-gds-attr.attr-value) no-error .
     3435           if not available tt-fringing-rvs
     3436           and trim(entry(2, buf_chk-gds-attr.attr-value)) > ""
     3437           then do :
     3438             create tt-fringing-rvs .
     3439             assign tt-fringing-rvs.rvs-code = entry(2, buf_chk-gds-attr.attr-value) .
     3440           end .
     3441         end .
     3442       end .
     3443     end .
     3444     if new_shift-period.sales-mass = 0
     3445     or new_shift-period.sales-volume = 0
     3446     then do :
     3447       p-del = yes .
     3448       return .
     3449     end .
     3450     assign new_shift-period.sales-density = new_shift-period.sales-mass / new_shift-period.sales-volume .
     3451   end procedure .
     3452   procedure calc_sales-temperature :
     3453     define buffer fringing_rvs-doc for ub.rvs-doc .
     3454     define buffer fringing_rvs-line for ub.rvs-line .
     3455     assign v-num-fringing-rvs = 0 .
     3456     for each tt-fringing-rvs :
     3457       for first fringing_rvs-doc no-lock where fringing_rvs-doc.rvs-code = tt-fringing-rvs.rvs-code,
     3458         each fringing_rvs-line no-lock where fringing_rvs-line.rvs-code = fringing_rvs-doc.rvs-code
     3459                                          and fringing_rvs-line.obj-type = fringing_rvs-doc.obj-type
     3460                                          and fringing_rvs-line.obj-code = fringing_rvs-doc.obj-code
     3461                                          and fringing_rvs-line.pl-code  = tt-pl-gds.pl-code
     3462                                          and fringing_rvs-line.gds-code = tt-pl-gds.gds-code
     3463       :
     3464         assign
     3465           new_shift-period.sales-temperature = new_shift-period.sales-temperature + fringing_rvs-line.state-temperature
     3466           v-num-fringing-rvs = v-num-fringing-rvs + 1
     3467         .
     3468       end .
     3469     end .
     3470     assign new_shift-period.sales-temperature = new_shift-period.sales-temperature / v-num-fringing-rvs .
     3471   end procedure .
     3472   procedure pomi-calc :
     3473     define buffer buf_sr-izmerenia for sr-izmerenia .
     3474     define buffer dens_sr-izmerenia for sr-izmerenia .
     3475     define buffer temp_sr-izmerenia for sr-izmerenia .
     3476     define buffer level_sr-izmerenia for sr-izmerenia .
     3477     define buffer temp-dens_sr-izmerenia for sr-izmerenia .
     3478     define buffer water1_pl-level  for ub.pl-level .
     3479     define buffer water2_pl-level  for ub.pl-level .
     3480     define buffer total1_pl-level  for ub.pl-level .
     3481     define buffer total2_pl-level  for ub.pl-level .
     3482     define buffer buf_pl-level-attr for ub.pl-level-attr .
     3483     define buffer bf_goods for ub.goods .
     3484     define buffer bf_place for ub.place .
     3485     define variable v-mm as com-handle.
     3486     define variable v-proc as character no-undo.
     3487     define variable v-mm57 as com-handle.
     3488     define variable v-pokmi-dll-version as character no-undo .
     3489     define variable v-code            as character no-undo.
     3490     define variable ii                as integer   no-undo.
     3491     define variable place-ratio-error as decimal no-undo.
     3492     define variable dens-prov         as decimal no-undo format "9.9999999999":U.
     3493     define variable CalibTable        as character no-undo initial "".
     3494     define variable CalibBelt         as character no-undo initial "".
     3495     define variable ToolType          as integer no-undo.
     3496     define variable LevelToolType          as integer no-undo.
     3497     define variable A_LevelMeasurementTool  as decimal no-undo.
     3498     define variable DeltaAbs_H              as decimal no-undo.
     3499     define variable DeltaAbs_H_Water        as decimal no-undo.
     3500     define variable DeltaAbs_R              as decimal no-undo.
     3501     define variable DeltaAbs_Tv             as decimal no-undo.
     3502     define variable DeltaAbs_Tr             as decimal no-undo.
     3503     define variable DeltaOtn_N              as decimal no-undo.
     3504     define variable DeltaOtn_K              as decimal no-undo.
     3505     define variable A_Reservoir             as decimal no-undo init 0.0000125 .
     3506     define variable DeadZone_Reservoir      as decimal no-undo.
     3507     define variable DeltaOtn_H              as decimal no-undo.
     3508     define variable DeltaOtn_H_Water        as decimal no-undo.
     3509     define variable DeltaOtn_R              as decimal no-undo.
     3510     define variable ToolAutomationLevel_H   as integer no-undo.
     3511     define variable ToolAutomationLevel_H_Water as integer no-undo.
     3512     define variable ToolAutomationLevel_R   as integer no-undo.
     3513     define variable ToolAutomationLevel_Tv  as integer no-undo.
     3514     define variable ToolAutomationLevel_Tr  as integer no-undo.
     3515     define variable DeltaAbs_H_CalcType     as integer no-undo.
     3516     define variable DeltaAbs_H_Water_CalcType   as integer no-undo.
     3517     define variable temp-for-pomi           as integer no-undo.
     3518     define variable temp-izm-vol            as decimal no-undo init ? .
     3519     define variable error-string            as character no-undo.
     3520     define variable v-is-meas               as logical no-undo.
     3521     define variable v-mm-density            as decimal no-undo.
     3522     define variable place-ponton            as logical no-undo.
     3523     define variable place-ponton-mass       as decimal no-undo.
     3524     define variable place-ponton-height     as decimal no-undo.
     3525     define variable place-type              as integer no-undo.
     3526     define variable place-SI                as integer no-undo.
     3527     define variable place-diameter          as decimal no-undo.
     3528     define variable DeltaV1                 as decimal no-undo .
     3529     define variable DeltaV2                 as decimal no-undo .
     3530     define variable WaterDeltaV1            as decimal no-undo .
     3531     define variable WaterDeltaV2            as decimal no-undo .
     3532     define variable pl-rvd-dens as logical no-undo .
     3533     define variable pl-rvd-lvl as logical no-undo .
     3534     define variable pl-rvd-temp as logical no-undo .
     3535     define variable pl-dens-sr-izm    as integer no-undo .
     3536     define variable pl-level-sr-izm   as integer no-undo .
     3537     define variable pl-temp-sr-izm    as integer no-undo .
     3538     define variable pl-temp-dens-sr-izm as integer no-undo .
     3539     define variable vAutomationDegree as integer no-undo extent 3 init [2,1,3].
     3540     define variable v-POkMI-result          as character no-undo.
     3541     define variable vErr as character no-undo .
     3542     define variable vWrn as character no-undo .
     3543     define variable vDllVersion as character no-undo .
     3544     define variable V_total      as decimal no-undo .
     3545     define variable V_water      as decimal no-undo .
     3546     define variable DeltaV       as decimal no-undo .
     3547     define variable Vcy          as decimal no-undo .
     3548     define variable Rcy          as decimal no-undo .
     3549     define variable V_product    as decimal no-undo .
     3550     define variable V            as decimal no-undo .
     3551     define variable Rv           as decimal no-undo .
     3552     define variable M            as decimal no-undo .
     3553     define variable CTL_base_alt as decimal no-undo .
     3554     define variable CPL_base_alt as decimal no-undo .
     3555     define variable CTPL_base_alt as decimal no-undo .
     3556     define variable Fp_base_alt  as decimal no-undo .
     3557     define variable CTL_obs_base as decimal no-undo .
     3558     define variable CPL_obs_base as decimal no-undo .
     3559     define variable CTPL_obs_base as decimal no-undo .
     3560     define variable Fp_obs_base  as decimal no-undo .
     3561     define variable DeltaOtn_Vcy as decimal no-undo .
     3562     define variable DeltaOtn_Vm  as decimal no-undo .
     3563     define variable DeltaOtn_M   as decimal no-undo .
     3564     define variable VolumetricExpansion as decimal no-undo .
     3565     find first cur_rvs-line no-lock where cur_rvs-line.rvs-code = cur_rvs-doc.rvs-code
     3566                                       and cur_rvs-line.obj-type = cur_rvs-doc.obj-type
     3567                                       and cur_rvs-line.obj-code = cur_rvs-doc.obj-code
     3568                                       and cur_rvs-line.pl-code  = tt-pl-gds.pl-code
     3569                                       and cur_rvs-line.gds-code = tt-pl-gds.gds-code
     3570                                       no-error .
     3571     if not available cur_rvs-line
     3572     then do :
     3573       return error "no_rvs-line" .
     3574     end .
     3575     _trpomi :
     3576     do on error undo, return :
     3577       find first bf_place no-lock where bf_place.pl-code = cur_rvs-line.pl-code no-error .
     3578       do ii = 1 to num-entries('place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u,','):
     3579         v-code = entry(ii,'place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u) .
     3580         run placelib_get-attr  ( input v-code
     3581                                 ,input cur_rvs-line.obj-code
     3582                                 ,input cur_rvs-line.obj-type
     3583                                 ,input cur_rvs-line.pl-code
     3584                                 ,output v-value
     3585                                 ,output v-ok      ) no-error.
     3586         case v-code :
     3587           when "place-type" then do :
     3588             if v-ok then place-type = integer(v-value) .
     3589           end.
     3590           when "place-SI" then do :
     3591             if v-ok then place-si = integer(v-value) .
     3592           end.
     3593           when "place-diameter" then do :
     3594             if v-ok then place-diameter = decimal(v-value) .
     3595           end.
     3596           when "dens-prov" then do :
     3597             if v-ok then dens-prov = decimal(v-value) .
     3598           end.
     3599           when "place-dead-high" then do :
     3600             if v-ok then DeadZone_Reservoir = decimal(v-value) .
     3601           end.
     3602           when "place-ponton" then do :
     3603             if v-ok then place-ponton = logical(v-value) .
     3604           end.
     3605           when "place-ponton-mass" then do :
     3606             if v-ok then place-ponton-mass = decimal(v-value) .
     3607           end.
     3608           when "place-ponton-height" then do :
     3609             if v-ok then place-ponton-height = decimal(v-value) .
     3610           end.
     3611           when "place-rvd-dnsty" then do :
     3612             if v-ok then pl-rvd-dens = logical(v-value) .
     3613           end.
     3614           when "place-rvd-lvl" then do :
     3615             if v-ok then pl-rvd-lvl = logical(v-value) .
     3616           end.
     3617           when "place-rvd-tmp" then do :
     3618             if v-ok then pl-rvd-temp = logical(v-value) .
     3619           end.
     3620         end case.
     3621       end.
     3622       if cur_rvs-line.state-level-water > 0
     3623       then do :
     3624         find last water1_pl-level no-lock where water1_pl-level.pl-code  = cur_rvs-line.pl-code
     3625                                             and water1_pl-level.obj-code = cur_rvs-line.obj-code
     3626                                             and water1_pl-level.obj-type = cur_rvs-line.obj-type
     3627                                             and water1_pl-level.pl-level <= cur_rvs-line.state-level-water
     3628                                             no-error .
     3629         if available water1_pl-level
     3630         then do :
     3631           WaterDeltaV1 = ? .
     3632           for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = water1_pl-level.pl-code
     3633                                                 and buf_pl-level-attr.obj-code = water1_pl-level.obj-code
     3634                                                 and buf_pl-level-attr.obj-type = water1_pl-level.obj-type
     3635                                                 and buf_pl-level-attr.pl-level = water1_pl-level.pl-level
     3636                                                 and buf_pl-level-attr.attr-code = "deltaV"
     3637                                                 :
     3638             WaterDeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     3639           end .
     3640         end .
     3641         if available water1_pl-level
     3642         and water1_pl-level.pl-level <> cur_rvs-line.state-level-water
     3643         then do :
     3644           find first water2_pl-level no-lock where water2_pl-level.pl-code  = cur_rvs-line.pl-code
     3645                                               and water2_pl-level.obj-code = cur_rvs-line.obj-code
     3646                                               and water2_pl-level.obj-type = cur_rvs-line.obj-type
     3647                                               and water2_pl-level.pl-level >= cur_rvs-line.state-level-water
     3648                                               no-error .
     3649           if available water2_pl-level
     3650           then do :
     3651             WaterDeltaV2 = ? .
     3652             for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = water2_pl-level.pl-code
     3653                                                   and buf_pl-level-attr.obj-code = water2_pl-level.obj-code
     3654                                                   and buf_pl-level-attr.obj-type = water2_pl-level.obj-type
     3655                                                   and buf_pl-level-attr.pl-level = water2_pl-level.pl-level
     3656                                                   and buf_pl-level-attr.attr-code = "deltaV"
     3657                                                   :
     3658               WaterDeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
     3659             end .
     3660           end .
     3661         end .
     3662       end .
     3663       find last total1_pl-level no-lock where total1_pl-level.pl-code  = cur_rvs-line.pl-code
     3664                                           and total1_pl-level.obj-code = cur_rvs-line.obj-code
     3665                                           and total1_pl-level.obj-type = cur_rvs-line.obj-type
     3666                                           and total1_pl-level.pl-level <= cur_rvs-line.state-level-total
     3667                                           no-error .
     3668       if not available total1_pl-level
     3669       then do :
     3670         find first bf_goods no-lock where bf_goods.gds-code = cur_rvs-line.gds-code no-error .
     3671         message
     3672           substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     3673                      ,(if available bf_place then bf_place.loc1 else "?")
     3674                      ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     3675                      ,(if available bf_goods then bf_goods.gds-name else "?") )
     3676         view-as alert-box .
     3677         undo _trpomi, return "need-data" .
     3678       end .
     3679       DeltaOtn_K = ? .
     3680       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total1_pl-level.pl-code
     3681                                             and buf_pl-level-attr.obj-code = total1_pl-level.obj-code
     3682                                             and buf_pl-level-attr.obj-type = total1_pl-level.obj-type
     3683                                             and buf_pl-level-attr.pl-level = total1_pl-level.pl-level
     3684                                             and buf_pl-level-attr.attr-code = "tarir-delta"
     3685                                             :
     3686         DeltaOtn_K = decimal(buf_pl-level-attr.attr-value) .
     3687       end .
     3688       if DeltaOtn_K = ? then DeltaOtn_K = 0.25 .
     3689       DeltaV1 = ? .
     3690       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total1_pl-level.pl-code
     3691                                             and buf_pl-level-attr.obj-code = total1_pl-level.obj-code
     3692                                             and buf_pl-level-attr.obj-type = total1_pl-level.obj-type
     3693                                             and buf_pl-level-attr.pl-level = total1_pl-level.pl-level
     3694                                             and buf_pl-level-attr.attr-code = "deltaV"
     3695                                             :
     3696         DeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     3697       end .
     3698       find first total2_pl-level no-lock where total2_pl-level.pl-code  = cur_rvs-line.pl-code
     3699                                           and total2_pl-level.obj-code = cur_rvs-line.obj-code
     3700                                           and total2_pl-level.obj-type = cur_rvs-line.obj-type
     3701                                           and total2_pl-level.pl-level > cur_rvs-line.state-level-total
     3702                                           no-error .
     3703       if not available total2_pl-level
     3704       then do :
     3705         find first bf_goods no-lock where bf_goods.gds-code = cur_rvs-line.gds-code no-error .
     3706         message
     3707           substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     3708                      ,(if available bf_place then bf_place.loc1 else "?")
     3709                      ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     3710                      ,(if available bf_goods then bf_goods.gds-name else "?") )
     3711         view-as alert-box .
     3712         undo _trpomi, return "need-data" .
     3713       end .
     3714       DeltaV2 = ? .
     3715       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total2_pl-level.pl-code
     3716                                             and buf_pl-level-attr.obj-code = total2_pl-level.obj-code
     3717                                             and buf_pl-level-attr.obj-type = total2_pl-level.obj-type
     3718                                             and buf_pl-level-attr.pl-level = total2_pl-level.pl-level
     3719                                             and buf_pl-level-attr.attr-code = "deltaV"
     3720                                             :
     3721         DeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
     3722       end .
     3723       if available water1_pl-level
     3724       then do :
     3725         CalibTable = Substitute("&1=&2", water1_pl-level.pl-level, (water1_pl-level.pl-qnty / 1000)) + (if WaterDeltaV1 > 0 then ("=" + trim(string(WaterDeltaV1, ">>9.9999"))) else "") + chr(10) .
     3726       end .
     3727       if available water2_pl-level
     3728       then do :
     3729         CalibTable = CalibTable + Substitute("&1=&2", water2_pl-level.pl-level, (water2_pl-level.pl-qnty / 1000)) + (if WaterDeltaV2 > 0 then ("=" + trim(string(WaterDeltaV2, ">>9.9999"))) else "") + chr(10) .
     3730       end .
     3731       CalibTable = CalibTable + Substitute("&1=&2", total1_pl-level.pl-level, (total1_pl-level.pl-qnty / 1000)) + (if DeltaV1 > 0 then ("=" + trim(string(DeltaV1, ">>9.9999"))) else "") + chr(10) .
     3732       CalibTable = CalibTable + Substitute("&1=&2", total2_pl-level.pl-level, (total2_pl-level.pl-qnty / 1000)) + (if DeltaV2 > 0 then ("=" + trim(string(DeltaV2, ">>9.9999"))) else "") .
     3733       CalibBelt = getCalibrationBelt(
     3734           cur_rvs-line.obj-type,
     3735           cur_rvs-line.obj-code,
     3736           cur_rvs-line.pl-code,
     3737           cur_rvs-line.state-level-total,
     3738           if cur_rvs-line.state-level-water <> ? then cur_rvs-line.state-level-water else 0
     3739       ).
     3740       find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = place-si no-error.
     3741       if error-status :error or not available buf_sr-izmerenia then do :
     3742         find first bf_goods no-lock where bf_goods.gds-code = cur_rvs-line.gds-code no-error .
     3743         undo _trpomi, return error substitute( 'Для резервуара &1 (&2) не указано основное средство измерения. Создание сверки не возможно.'
     3744                                              ,(if available bf_place then bf_place.loc1 else "?")
     3745                                              ,(if available bf_goods then bf_goods.gds-name else "?") ) .
     3746       end.
     3747       else do :
     3748         assign
     3749           ToolType               = buf_sr-izmerenia.sr-type-id
     3750           LevelToolType          = buf_sr-izmerenia.sr-type-level-measuring
     3751           A_LevelMeasurementTool = buf_sr-izmerenia.sr-temp-line
     3752           ToolAutomationLevel_H  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3753           ToolAutomationLevel_H_Water = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3754           DeltaAbs_H             = buf_sr-izmerenia.sr-abs-err-neft-water
     3755           DeltaAbs_H_Water       = buf_sr-izmerenia.sr-abs-err-water
     3756           ToolAutomationLevel_R  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3757           DeltaAbs_R             = buf_sr-izmerenia.sr-abs-err-dens
     3758           ToolAutomationLevel_Tv = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3759           DeltaAbs_Tv            = buf_sr-izmerenia.sr-abs-err-temp-vol
     3760           ToolAutomationLevel_Tr = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3761           DeltaAbs_Tr            = buf_sr-izmerenia.sr-abs-err-temp-dens
     3762           DeltaOtn_N             = 0.05
     3763           DeltaOtn_H             = buf_sr-izmerenia.sr-relative-err-neft-water
     3764           DeltaOtn_H_Water       = buf_sr-izmerenia.sr-relative-err-water
     3765           DeltaOtn_R             = buf_sr-izmerenia.sr-relative-err-dens
     3766           DeltaAbs_H_CalcType    = buf_sr-izmerenia.sr-type-level-measuring + 1
     3767           DeltaAbs_H_Water_CalcType = buf_sr-izmerenia.sr-type-level-measuring + 1
     3768         .
     3769       end.
     3770       if pl-rvd-dens
     3771       then do :
     3772         find first cur_rvs-line-attr no-lock
     3773               where cur_rvs-line-attr.obj-code  = cur_rvs-line.obj-code
     3774                 and cur_rvs-line-attr.obj-type  = cur_rvs-line.obj-type
     3775                 and cur_rvs-line-attr.gds-code  = cur_rvs-line.gds-code
     3776                 and cur_rvs-line-attr.pl-code   = cur_rvs-line.pl-code
     3777                 and cur_rvs-line-attr.rvs-code  = cur_rvs-line.rvs-code
     3778                 and cur_rvs-line-attr.attr-code = "mi-dnst" no-error.
     3779         if available cur_rvs-line-attr
     3780         then do :
     3781           pl-dens-sr-izm = integer(cur_rvs-line-attr.attr-value) .
     3782         end .
     3783         else do :
     3784           pl-dens-sr-izm = 0 .
     3785         end .
     3786         if pl-dens-sr-izm > 0
     3787         and pl-dens-sr-izm <> place-si
     3788         then do :
     3789           find first dens_sr-izmerenia no-lock where dens_sr-izmerenia.node-code = pl-dens-sr-izm no-error.
     3790           if not available dens_sr-izmerenia then do :
     3791             undo _trpomi, return error substitute( 'Не найдено средство измерения с кодом &1', pl-dens-sr-izm )  .
     3792           end.
     3793           else do :
     3794             assign
     3795               ToolType               = dens_sr-izmerenia.sr-type-id
     3796               DeltaAbs_R             = dens_sr-izmerenia.sr-abs-err-dens
     3797               DeltaOtn_R             = dens_sr-izmerenia.sr-relative-err-dens
     3798               ToolAutomationLevel_R  = vAutomationDegree[dens_sr-izmerenia.sr-type-izm + 1].
     3799             .
     3800           end.
     3801         end .
     3802       end .
     3803       if pl-rvd-lvl
     3804       then do :
     3805         find first cur_rvs-line-attr no-lock
     3806               where cur_rvs-line-attr.obj-code  = cur_rvs-line.obj-code
     3807                 and cur_rvs-line-attr.obj-type  = cur_rvs-line.obj-type
     3808                 and cur_rvs-line-attr.gds-code  = cur_rvs-line.gds-code
     3809                 and cur_rvs-line-attr.pl-code   = cur_rvs-line.pl-code
     3810                 and cur_rvs-line-attr.rvs-code  = cur_rvs-line.rvs-code
     3811                 and cur_rvs-line-attr.attr-code = "mi-lvl" no-error.
     3812         if available cur_rvs-line-attr
     3813         then do :
     3814           pl-level-sr-izm = integer(cur_rvs-line-attr.attr-value) .
