     4087            input ToolAutomationLevel_H_Water,
     4088            input ToolAutomationLevel_R,
     4089            input ToolAutomationLevel_Tv,
     4090            input ToolAutomationLevel_Tr,
     4091            input DeltaAbs_H_CalcType,
     4092            input DeltaAbs_H_Water_CalcType,
     4093            input DeltaAbs_H,
     4094            input DeltaAbs_H_Water,
     4095            input DeltaAbs_R,
     4096            input DeltaAbs_Tv,
     4097            input DeltaAbs_Tr,
     4098            input DeltaOtn_N,
     4099            input 1,
     4100            input 2,
     4101            input 2,
     4102            output V_total,
     4103            output V_water,
     4104            output DeltaV,
     4105            output V_product,
     4106            output Vcy,
     4107            output Rcy,
     4108            output V,
     4109            output CTL_base_alt,
     4110            output CPL_base_alt,
     4111            output CTPL_base_alt,
     4112            output Fp_base_alt,
     4113            output CTL_obs_base,
     4114            output CPL_obs_base,
     4115            output CTPL_obs_base,
     4116            output Fp_obs_base,
     4117            output Rv,
     4118            output DeltaOtn_Vcy,
     4119            output DeltaOtn_Vm,
     4120            output M,
     4121            output DeltaOtn_M,
     4122            output VolumetricExpansion,
     4123            output vErr,
     4124            output vWrn,
     4125            output vDllVersion)
     4126         no-error .
