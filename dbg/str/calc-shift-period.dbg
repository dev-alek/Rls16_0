       90     define output parameter p-label          as character no-undo .
       91     define output parameter p-user-can-edit  as logical   no-undo .
       92     define output parameter p-output-display as logical   no-undo .
       93     define output parameter p-other          as character no-undo .
       94     do
       95     on error undo, return error
       96     :
       97           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
       98         (input  p-code
       99         ,output p-type
      100         ,output p-format
      101         ,output p-label
      102         ,output p-user-can-edit
      103         ,output p-output-display
      104         ,output p-other
      105         ) no-error .
      106       if error-status :error
      107       then do:
      108         undo, return error return-value .
      109       end.
      110     end.
      111   end procedure.
