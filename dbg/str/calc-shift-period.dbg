     4128       OUTPUT stream s-pomi to value ("pomi.log") append.
     4129       PUT STREAM s-pomi unformatted
     4130         "    " SKIP
     4131         "    " SKIP
     4132         cur-time-string()           FORMAT "x(16)"    SKIP
     4133         'Процедура'                 v-proc                      FORMAT "x(128)"   SKIP
     4134         'Версия dll: '              vDllVersion                           SKIP
     4135         'CODE_PL                     = ' cur_rvs-line.pl-code                      SKIP
     4136         'H                           = ' cur_rvs-line.state-level-total * 10 SKIP
     4137         'H_water                     = ' (if cur_rvs-line.state-level-water <> ? then cur_rvs-line.state-level-water * 10 else 0.0) SKIP
     4138         'CalibrationTable            = ' CalibTable                    SKIP
     4139         'CalibrationBelt             = ' CalibBelt                    SKIP
     4140         'ToolAutomationLevel_H       = ' ToolAutomationLevel_H     SKIP
     4141         'ToolAutomationLevel_H_Water = ' ToolAutomationLevel_H_Water    SKIP
     4142         'ToolAutomationLevel_R       = ' ToolAutomationLevel_R     SKIP
     4143         'ToolAutomationLevel_Tv      = ' ToolAutomationLevel_Tv    SKIP
     4144         'ToolAutomationLevel_Tr      = ' ToolAutomationLevel_Tr    SKIP
     4145         'DeltaAbs_H_CalcType         = ' DeltaAbs_H_CalcType       SKIP
     4146         'DeltaAbs_H_Water_CalcType   = ' DeltaAbs_H_Water_CalcType SKIP
     4147         'Tr                          = ' (if temp-izm-vol <> ? then temp-izm-vol else new_shift-period.sales-temperature) SKIP
     4148         'Tv                          = ' new_shift-period.sales-temperature  SKIP
     4149         'R                           = ' trim(string(new_shift-period.sales-density * 1000, ">>>9.9<"))  SKIP
     4150         'Tcy                         = ' temp-for-pomi                       SKIP
     4151         'ToolType                    = ' ToolType                            SKIP
     4152         'DeadZone_Reservoir          = ' DeadZone_Reservoir                  SKIP
     4153         'DeltaOtn_K                  = ' DeltaOtn_K                          SKIP
     4154         'A_Reservoir                 = ' A_Reservoir                         SKIP
     4155         'A_LevelMeasurementTool      = ' A_LevelMeasurementTool              skip
     4156         'DeltaAbs_H                  = ' DeltaAbs_H                          SKIP
     4157         'DeltaAbs_H_Water            = ' DeltaAbs_H_Water                    SKIP
     4158         'DeltaAbs_R                  = ' DeltaAbs_R                          SKIP
     4159         'DeltaAbs_Tv                 = ' DeltaAbs_Tv                         SKIP
     4160         'DeltaAbs_Tr                 = ' DeltaAbs_Tr                         SKIP
     4161         'DeltaOtn_N                  = ' DeltaOtn_N                          SKIP
     4162         'Round_M                     = ' 1                                   SKIP
     4163         'Round_T                     = ' 2                                   SKIP
     4164         'Round_R                     = ' 2                                   SKIP
     4165       .
     4166       if place-type = 1
     4167       and place-ponton
     4168       then do :
     4169         put stream s-pomi unformatted
     4170           "Rprov                  = " 0.0 skip
     4171           "Mpokr                  = " 0.0 skip
     4172           "Vdisp                  = " 0.0 skip
     4173           "CoverFloatingHeight    = " 0.0 skip
     4174         .
     4175       end.
     4176       output stream s-pomi close.
     4177       if trim(vErr) > "" then do :
     4178         error-string = substitute("~nРезервуар: &1.~n", if avail buf_place then buf_place.loc1 else "")
     4179                      + replace(vErr,";0x","~n0x") .
     4180         output stream s-pomi to value ("pomi.log")  append.
     4181         put stream s-pomi error-string format "X(1024)" skip.
     4182         message
     4183         substitute('Ошибка работы библиотеки ПОкМИ. &1',error-string)
     4184         view-as alert-box error.
     4185         output stream s-pomi close.
     4186         undo _trpomi, return "pomi-error" .
     4187       end.
     4188       else do :
     4189         assign new_shift-period.sales-density15 = (Rcy / 1000) .
     4190         assign
     4191           v-POkMI-result =
     4192             "V_total             = " + string(V_total)       + chr(10) +
     4193             "V_water             = " + string(V_water)       + chr(10) +
     4194             "DeltaV              = " + string(DeltaV)         + chr(10) +
     4195             "Vcy                 = " + string(Vcy)           + chr(10) +
     4196             "Rcy                 = " + string(Rcy)            + chr(10) +
     4197             "V_product           = " + string(V_product)      + chr(10) +
     4198             "V                   = " + string(V)              + chr(10) +
     4199             "Rv                  = " + string(Rv)               + chr(10) +
     4200             "M                   = " + string(M)                 + chr(10) +
     4201             "CTL_base_alt        = " + string(CTL_base_alt)  + chr(10) +
     4202             "CPL_base_alt        = " + string(CPL_base_alt)  + chr(10) +
     4203             "CTPL_base_alt       = " + string(CTPL_base_alt)  + chr(10) +
     4204             "Fp_base_alt         = " + string(Fp_base_alt)   + chr(10) +
     4205             "CTL_obs_base        = " + string(CTL_obs_base)  + chr(10) +
     4206             "CPL_obs_base        = " + string(CPL_obs_base)  + chr(10) +
     4207             "CTPL_obs_base       = " + string(CTPL_obs_base)  + chr(10) +
     4208             "Fp_obs_base         = " + string(Fp_obs_base)   + chr(10) +
     4209             "DeltaOtn_Vcy        = " + string(DeltaOtn_Vcy)  + chr(10) +
     4210             "DeltaOtn_Vm         = " + string(DeltaOtn_Vm)   + chr(10) +
     4211             "DeltaOtn_M          = " + string(DeltaOtn_M)       + chr(10) +
     4212             "VolumetricExpansion = " + string(VolumetricExpansion)  + chr(10) +
     4213             "Warnings            = " + string(vWrn)
     4214         .
     4215         OUTPUT stream s-pomi to value ("pomi.log")  append.
     4216         PUT STREAM s-pomi unformatted v-POkMI-result skip .
     4217         OUTPUT stream s-pomi close.
     4218       end .
     4219     end .
     4220   end procedure .
     4221   procedure CrTempDump:
     4222     define input parameter p-obj-type as character no-undo.
     4223     define input parameter p-obj-code as integer no-undo.
     4224     define input parameter p-shift-date as date no-undo.
     4225     define input parameter p-shift-num as integer no-undo.
     4226     define input parameter p-pl-code as integer no-undo.
     4227     define input parameter p-gds-code as integer no-undo.
     4228     define buffer trn_rvs-doc for ub.rvs-doc.
     4229     define buffer trn_rvs-line for ub.rvs-line.
     4230     define buffer trn_rvs-doc_end for ub.rvs-doc.
     4231     define buffer trn_doc-line-attr  for ub.doc-line-attr.
     4232     define buffer trn_doc-line-attr1 for ub.doc-line-attr.
     4233     define variable vBegTime as datetime no-undo.
     4234     define variable vEndTime as datetime no-undo.
     4235     define variable vTimeAutoSkip as integer no-undo.
     4236     vTimeAutoSkip = if ptrlprop-autopump-skip-time <> ? then ptrlprop-autopump-skip-time else 0.
     4237     rvsdoc:
     4238     for each trn_rvs-doc no-lock
     4239          where trn_rvs-doc.obj-type   = p-obj-type
     4240            and trn_rvs-doc.obj-code   = p-obj-code
     4241            and trn_rvs-doc.shift-date = p-shift-date
     4242            and trn_rvs-doc.shift-num  = p-shift-num
     4243            and trn_rvs-doc.status_    = 'факт':U
     4244            and trn_rvs-doc.rvs-type  = 'перед_док':U
     4245          ,first trn_rvs-line no-lock
     4246          where trn_rvs-line.rvs-code   = trn_rvs-doc.rvs-code
     4247            and trn_rvs-line.obj-type   = trn_rvs-doc.obj-type
     4248            and trn_rvs-line.obj-code   = trn_rvs-doc.obj-code
     4249            and trn_rvs-line.pl-code    = p-pl-code
     4250            and trn_rvs-line.gds-code   = p-gds-code
     4251     :
     4252       find first  trn_rvs-doc_end no-lock
     4253           where trn_rvs-doc_end.rvs-type = 'после_док':U
     4254             and trn_rvs-doc_end.out-code =  trn_rvs-doc.out-code
     4255       no-error.
     4256       if not avail trn_rvs-doc_end then next  rvsdoc.
     4257       find first trn_doc-line-attr no-lock where
     4258                  trn_doc-line-attr.doc-code = trn_rvs-doc.out-code
     4259              and trn_doc-line-attr.gds-code = trn_rvs-line.gds-code
     4260              and trn_doc-line-attr.attr-code begins "date-start"
     4261          no-error.
     4262       find first trn_doc-line-attr1 no-lock where
     4263                  trn_doc-line-attr1.doc-code = trn_rvs-doc.out-code
     4264              and trn_doc-line-attr1.gds-code = trn_rvs-line.gds-code
     4265              and trn_doc-line-attr1.attr-code begins "time-start"
     4266          no-error.
     4267       if available trn_doc-line-attr and
     4268          available trn_doc-line-attr1
     4269       then  vBegTime = datetime(date(trn_doc-line-attr.attr-value), (int(trn_doc-line-attr1.attr-value) * 1000 )).
     4270       else  vBegTime = datetime(trn_rvs-doc.sys-date, (trn_rvs-doc.sys-time-int * 1000 )).
     4271       find first trn_doc-line-attr no-lock where
     4272                  trn_doc-line-attr.doc-code = trn_rvs-doc.out-code
     4273              and trn_doc-line-attr.gds-code = trn_rvs-line.gds-code
     4274              and trn_doc-line-attr.attr-code begins "date-end"
     4275          no-error.
     4276       find first trn_doc-line-attr1 no-lock where
     4277                  trn_doc-line-attr1.doc-code = trn_rvs-doc.out-code
     4278              and trn_doc-line-attr1.gds-code = trn_rvs-line.gds-code
     4279              and trn_doc-line-attr1.attr-code begins "time-end"
     4280          no-error.
     4281       if available trn_doc-line-attr and
     4282          available trn_doc-line-attr1
     4283       then  vEndTime = datetime(date(trn_doc-line-attr.attr-value), ((int(trn_doc-line-attr1.attr-value) + vTimeAutoSkip * 60) * 1000 )).
     4284       else  vEndTime = datetime(trn_rvs-doc_end.sys-date, ((trn_rvs-doc_end.sys-time-int + vTimeAutoSkip * 60) * 1000 )).
     4285       create ttDump.
     4286       assign
     4287         ttDump.doc-code = trn_rvs-doc.out-code
     4288         ttDump.BegTime = vBegTime
     4289         ttDump.EndTime = vEndTime
     4290       .
     4291     end.
     4292   end procedure.
