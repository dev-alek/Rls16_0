     3894       if available level_sr-izmerenia
     3895       then
     3896       assign
     3897         LevelToolType = level_sr-izmerenia.sr-type-level-measuring
     3898         ToolAutomationLevel_H  = vAutomationDegree[level_sr-izmerenia.sr-type-izm + 1]
     3899         ToolAutomationLevel_H_Water = vAutomationDegree[level_sr-izmerenia.sr-type-izm + 1]
     3900         DeltaAbs_H_CalcType = level_sr-izmerenia.sr-type-level-measuring + 1
     3901         DeltaAbs_H_Water_CalcType = level_sr-izmerenia.sr-type-level-measuring + 1
     3902       .
     3903       else
     3904       assign
     3905         LevelToolType = buf_sr-izmerenia.sr-type-level-measuring
     3906         ToolAutomationLevel_H  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3907         ToolAutomationLevel_H_Water = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3908         DeltaAbs_H_CalcType = buf_sr-izmerenia.sr-type-level-measuring + 1
     3909         DeltaAbs_H_Water_CalcType = buf_sr-izmerenia.sr-type-level-measuring + 1
     3910       .
     3911       if avail temp_sr-izmerenia then
     3912         ToolAutomationLevel_Tv = vAutomationDegree[temp_sr-izmerenia.sr-type-izm + 1].
     3913       else
     3914         ToolAutomationLevel_Tv = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1].
     3915       if avail dens_sr-izmerenia then
     3916         ToolAutomationLevel_R  = vAutomationDegree[dens_sr-izmerenia.sr-type-izm + 1].
     3917       else
     3918         ToolAutomationLevel_R = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1].
     3919       if available dens_sr-izmerenia
     3920       and dens_sr-izmerenia.sr-type-izm = 3
     3921       and dens_sr-izmerenia.sr-temperature
     3922       then do :
     3923         DeltaAbs_Tr = dens_sr-izmerenia.sr-abs-err-temp-dens .
     3924         ToolAutomationLevel_Tr = vAutomationDegree[dens_sr-izmerenia.sr-type-izm + 1].
     3925       end .
     3926       if DeltaAbs_H       = ? then DeltaAbs_H = 0 .
     3927       if DeltaAbs_H_Water = ? then DeltaAbs_H_Water = 0 .
     3928       if DeltaAbs_R       = ? then DeltaAbs_R = 0 .
     3929       if DeltaAbs_Tv      = ? then DeltaAbs_Tv = 0 .
     3930       if DeltaAbs_Tr      = ? then DeltaAbs_Tr = 0 .
     3931       if DeltaOtn_N       = ? then DeltaOtn_N = 0 .
     3932       if DeltaOtn_H       = ? then DeltaOtn_H = 0 .
     3933       if DeltaOtn_H_Water = ? then DeltaOtn_H_Water = 0 .
     3934       if DeltaOtn_R       = ? then DeltaOtn_R = 0 .
     3935       if LevelToolType    = ? then LevelToolType = 0 .
     3936       if ToolType         = ? then ToolType = 0 .
     3937       if A_LevelMeasurementTool      = ? then A_LevelMeasurementTool = 0 .
     3938       if ToolAutomationLevel_Tr      = ? then ToolAutomationLevel_Tr =0.
     3939       if ToolAutomationLevel_H       = ? then ToolAutomationLevel_H = 0.
     3940       if ToolAutomationLevel_H_Water = ? then ToolAutomationLevel_H_Water = 0.
     3941       if ToolAutomationLevel_Tv      = ? then ToolAutomationLevel_Tv = 0.
     3942       if ToolAutomationLevel_R       = ? then ToolAutomationLevel_R = 0.
     3943       if DeltaAbs_H_CalcType         = ? then DeltaAbs_H_CalcType = 0.
     3944       if DeltaAbs_H_Water_CalcType   = ? then DeltaAbs_H_Water_CalcType = 0.
     3945       if cur_rvs-line.state-level-water = 0
     3946       then do :
     3947         ToolAutomationLevel_H_Water = 3 .
     3948         DeltaAbs_H_Water_CalcType = 1 .
     3949         DeltaAbs_H_Water = 0 .
     3950         DeltaOtn_H_Water = 0 .
     3951       end .
     3952       if LevelToolType > 0
     3953       then do :
     3954         MM57
     3955           (input cur_rvs-line.state-level-total * 10,
     3956            input LevelToolType,
     3957            output DeltaAbs_H,
     3958            output vErr,
     3959            output vWrn,
     3960            output vDllVersion)
     3961         .
     3962         OUTPUT stream s-pomi to value ("pomi.log") append.
     3963         PUT STREAM s-pomi unformatted
     3964                     "    " SKIP
     3965                     "    " SKIP
     3966                     cur-time-string()           FORMAT "x(16)"    SKIP
     3967                     'Процедура             "CMethodOfMetering57"'       SKIP
     3968                     'Версия dll: '            vDllVersion   skip
     3969                     'CODE_PL                = ' cur_rvs-line.pl-code                           SKIP
     3970                     'H                      = ' cur_rvs-line.state-level-total * 10                  SKIP
     3971                     'ToolType               = ' LevelToolType                                      SKIP
     3972                         SKIP SKIP
     3973         .
     3974         output stream s-pomi close.
     3975         if trim(vErr) > "" then do :
     3976           output stream s-pomi to value ("pomi.log")  append.
