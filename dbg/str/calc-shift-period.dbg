     3253                                                      and buf_doc-attr.attr-code = "rvs-auto"
     3254                                                      and buf_doc-attr.attr-value = "Yes")
     3255             and can-find(first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = first-after_rvs-line.obj-code
     3256                                                            and buf_rvs-line-attr.obj-type  = first-after_rvs-line.obj-type
     3257                                                            and buf_rvs-line-attr.gds-code  = first-after_rvs-line.gds-code
     3258                                                            and buf_rvs-line-attr.pl-code   = first-after_rvs-line.pl-code
     3259                                                            and buf_rvs-line-attr.rvs-code  = first-after_rvs-line.rvs-code
