        1   DEFINE TEMP-TABLE tt-org NO-UNDO LIKE Code
        2          field orgName as char
        3          field orgFNS as Char
        4          field orgINN as char
        5          field orgkpp as char
        6          field orgguid as char.
        7   define input  parameter iOrgList as component-handle no-undo.
        8   define output parameter oGuid as character no-undo.
        9   define output parameter oFNS as character no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Форма выбора guid diadok".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable mPublishHand as handle no-undo.
      116   define variable mDiadocApi as component-handle no-undo.
      117   define stream File-stream.
      118   define variable mdebug as logical no-undo.
      119   mdebug= session:debug-alert.
      120   define new global shared variable g#language as character no-undo .
      121   if g#language <> '' and g#language <> 'rus':U then do:
      122     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   function PutMes returns character
      126   (idext as character ):
      127      if valid-handle(mPublishHand)
      128      then
      129         publish "WriteLogAsunc" from mPublishHand (idext,yes).
      130      else do:
      131         if idext begins "error"
      132         then do:
      133            message substring (idext,6)
      134               view-as alert-box.
      135            if mDiadocApi ne ?
      136            then
      137               idext = substitute ("&1 (&2)",idext , mDiadocApi:GetFullVersion())no-error.
      138         end.
      139         output stream File-stream to "diadoc_user.log" append.
      140         put stream File-stream unformatted now " " idext skip.
      141         output stream File-stream close.
      142      end.
      143   end.
      144   function PutErr returns character
      145   (idext as character ):
      146      define variable vi as integer no-undo.
      147      define variable vnumerr as integer no-undo.
      148      define variable vtext as character extent 25 no-undo .
      149      if error-status:num-messages > 0 then do:
      150         vnumerr = error-status:num-messages.
      151         vnumerr = min(vnumerr,extent(vtext)).
      152         do vi = 1 to vnumerr:
      153            vtext[vi] = error-status:get-message(vi).
      154         end.
      155         idext = idext + chr(10) + "Ошибка: [":U.
      156         do vi = 1 to vnumerr:
      157            idext = idext + chr(10) + vtext[vi] no-error.
      158         end.
      159         idext = idext +  chr(10) +  " ]" no-error.
      160         if not  idext begins "Error"
      161         then
      162            idext = "Error " + idext.
      163         PutMes(idext).
      164      end.
      165   end.
      166   function PutStat returns character
      167   (itext as character,
      168    iflag as logical):
      169      if valid-handle(mPublishHand)
      170      then
      171         publish "PutStatAsunc" from mPublishHand (itext,iflag).
      172      PutMes(itext).
      173   end.
      174   function chekStop returns logical
      175   ( ):
      176      define variable oStop as logical no-undo.
      177      if valid-handle(mPublishHand)
      178      then
      179         publish "StopProc" from mPublishHand (output oStop).
      180      return oStop.
      181   end.
      182   function  putloggetdesc returns logical
      183   (is1 as character ,is2 as character ,
      184   is3 as character ):
      185   end.
      186   function  getdesc returns logical
      187   (input iObj as component-handle):
      188      if iObj eq ? then return false.
      189      if mdebug
      190      then do:
      191      output stream File-stream to "diadoc_load.txt" append.
      192      define variable vReflector as component-handle no-undo.
      193      define variable vDescobj  as component-handle no-undo.
      194      define variable vPropertyNames  as component-handle no-undo.
      195      define variable vMethodsNames as component-handle no-undo.
      196      define variable vMethodDesc as component-handle no-undo.
      197      define variable vMethodsName as character  no-undo.
      198      define variable vPropertyValue as char no-undo.
      199      create "Diadoc.Reflector" vReflector.
      200      vDescobj = vReflector:Describe(iObj).
      201     put   stream File-stream  unformatted skip (1)
      202      "------------------------------------------" skip
      203      vDescobj:GetInterfaceName() skip.
      204      define variable vPropertyName as character no-undo.
      205      define variable vPropertyType as character no-undo.
      206      .
      207      putloggetdesc(vDescobj:GetInterfaceName(),"","").
      208      putloggetdesc("property","","").
      209      define variable vi as integer no-undo.
      210      define variable vii as integer no-undo.
      211     put stream File-stream  unformatted skip "property" skip.
      212     vPropertyNames = vDescobj:GetPropertiesNames().
      213      vi= vPropertyNames:count.
      214      do vi= 1 to vPropertyNames:count :
      215         vPropertyName = "".
      216         vPropertyType = "".
      217         vPropertyValue = "".
      218         vPropertyName  = vPropertyNames:GetItem(vi - 1) no-error.
      219         vPropertyType  = vDescobj:GetPropertyType(vPropertyName) no-error .
      220         vPropertyValue = substring((vDescobj:GetProperty(vPropertyName)),1,4000) no-error.
      221         putloggetdesc(vPropertyName,vPropertyType,vPropertyValue).
      222        put stream File-stream  unformatted vPropertyName " " vPropertyType  " " vPropertyValue skip.
      223      end.
      224      release object vPropertyNames.
      225      put stream File-stream  unformatted skip "method" skip.
      226      vMethodsNames = vDescobj:GetMethodsNames().
      227      vi = vMethodsNames:count.
      228      do vi = 1 to vMethodsNames:count :
      229         vMethodsName = "".
      230         vMethodsName = vMethodsNames:GetItem(vi - 1)no-error.
      231         vMethodDesc  = vDescobj:GetMethodDesc(vMethodsName)no-error.
      232         putloggetdesc("method",vMethodsName, vMethodDesc:RetVal).
      233         put stream File-stream  unformatted vMethodsName  " retval " vMethodDesc:RetVal skip.
      234         do vii  = 1 to vMethodDesc:args:count:
      235            define variable varg as character no-undo.
      236            varg = "".
      237            varg = vMethodDesc:args:GetItem(vii - 1) no-error.
      238            put stream File-stream  unformatted " args " varg  skip .
      239            putloggetdesc(" args ",varg, "").
      240         end.
      241         release object vMethodDesc.
      242      end.
      243      release object vMethodsNames.
      244      put stream File-stream  unformatted "end---------------------------------------" skip.
      245      output stream File-stream close.
      246      release object vDescobj.
      247      release object vReflector.
      248      end.
      249      return true.
      250   end.
      251   function getxsddocum returns logical
      252   (iOrganization as component-handle):
      253      if iOrganization eq ? then return false.
      254      define variable vDocumentTypes as component-handle no-undo.
      255      define variable vDocumentType as component-handle no-undo.
      256      define variable vFunctions as component-handle no-undo.
      257      define variable vFunction as component-handle no-undo.
      258      define variable vVersions as component-handle no-undo.
      259      define variable vVersion as component-handle no-undo.
      260      define variable vTitles as component-handle no-undo.
      261      define variable vTitle as component-handle no-undo.
      262      define variable vi as integer no-undo.
      263      define variable vii as integer no-undo.
      264      define variable viii as integer no-undo.
      265      define variable viiii as integer no-undo.
      266      if mdebug
      267      then do:
      268      output stream File-stream to "diadoc_doc.txt" append.
      269      vDocumentTypes = iOrganization:GetDocumentTypes().
      270      do vi =1 to vDocumentTypes:count:
      271         vDocumentType = vDocumentTypes:GetItem(vi - 1).
      272         put stream File-stream  unformatted "DocumentType -> NAme " vDocumentType:name skip.
      273         put stream File-stream  unformatted "DocumentType -> Title " vDocumentType:Title skip.
      274         vFunctions = vDocumentType:Functions.
      275         do vii =1 to vFunctions:count:
      276            vFunction = vFunctions:GetItem(vii - 1 ).
      277            put stream File-stream  unformatted "DocumentType -> Function -> NAme " vFunction:name skip.
      278            vVersions = vFunction:Versions.
      279            do viii =1 to vVersions:count:
      280               vVersion = vVersions:GetItem(viii - 1 ).
      281               put stream File-stream  unformatted "DocumentType -> Function -> Version -> version " vVersion:version skip.
      282               put stream File-stream  unformatted "DocumentType -> Function -> Version -> IsActual " vVersion:IsActual skip.
      283               vTitles  = vVersion:Titles.
      284               do viiii =1 to vTitles:count:
      285                  vTitle = vTitles:GetItem(viiii - 1 ).
      286                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> IsFormal " vTitle:IsFormal skip.
      287                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> XsdUrl " vTitle:XsdUrl skip.
      288                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> HaveUserDataXSD " vTitle:HaveUserDataXSD skip.
      289                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> type " vTitle:type skip.
      290                  release object vTitle.
      291               end.
      292              release object vTitles.
      293               release object vVersion.
      294            end.
      295            release object vVersions.
      296            release object vFunction.
      297         end.
      298         release object vFunctions.
      299         release object vDocumentType.
      300      end.
      301      release object vDocumentTypes.
      302      put stream File-stream  unformatted "--------------------------------------------------- " skip.
      303     output stream File-stream close.
      304     end.
      305      return true.
      306   end.
      307   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      308        LABEL "&Отмена"
      309        SIZE 15 BY 1.14
      310        BGCOLOR 8 .
      311   DEFINE BUTTON Btn_OK AUTO-GO
      312        LABEL "&Ввод"
      313        SIZE 15 BY 1.14
      314        BGCOLOR 8 .
      315   DEFINE QUERY BR-Org FOR
      316         tt-org SCROLLING.
      317   DEFINE BROWSE BR-Org
      318     QUERY BR-Org NO-LOCK DISPLAY
      319         tt-org.CodeValue COLUMN-LABEL "" FORMAT "x(8)":U
      320         tt-org.orgName COLUMN-LABEL "Наименование" FORMAT "x(60)":U
      321         tt-org.orgFNS COLUMN-LABEL "ID эдо" FORMAT "x(60)":U
      322         tt-org.orgINN COLUMN-LABEL "ИНН" FORMAT "x(12)":U
      323         tt-org.orgkpp COLUMN-LABEL "КПП" FORMAT "x(12)":U
      324       WITH NO-ROW-MARKERS SEPARATORS SIZE 136 BY 15.71 FIT-LAST-COLUMN.
      325   DEFINE FRAME Dialog-Frame
      326        Btn_OK AT ROW 1.24 COL 3
      327        Btn_Cancel AT ROW 1.24 COL 19
      328        BR-Org AT ROW 2.91 COL 2 WIDGET-ID 200
      329       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      330            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      331            TITLE "Организации"
      332            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      333   ASSIGN
      334          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      335          FRAME Dialog-Frame:HIDDEN           = TRUE.
      336   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      337   DO:
      338     APPLY "END-ERROR":U TO SELF.
      339   END.
      340   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      341   DO:
      342      if available tt-org
      343      then assign
      344         ofns  = tt-org.orgFNS
      345         oguid = tt-org.orgguid.
      346   END.
      347   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      348   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      349   MAIN-BLOCK:
      350   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      351      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      352     run init.
      353     RUN enable_UI.
      354     WAIT-FOR GO OF FRAME Dialog-Frame.
      355   END.
      356   RUN disable_UI.
      357   PROCEDURE disable_UI :
      358     HIDE FRAME Dialog-Frame.
      359   END PROCEDURE.
      360   PROCEDURE enable_UI :
      361     ENABLE Btn_OK Btn_Cancel BR-Org
      362         WITH FRAME Dialog-Frame.
      363     VIEW FRAME Dialog-Frame.
      364     OPEN QUERY BR-Org FOR EACH tt-org NO-LOCK INDEXED-REPOSITION.
      365   END PROCEDURE.
      366   PROCEDURE init :
      367      define variable vi as integer no-undo.
      368      define variable vOrganization as component-handle no-undo.
      369      do vi = 1 to iOrgList:count:
      370         create tt-org.
      371         vOrganization = iOrgList:getitem(vi - 1).
      372         getdesc(vOrganization).
      373         tt-org.code = vOrganization:guid.
      374         tt-org.orgFNS = vOrganization:FnsParticipantId .
      375         tt-org.orgName = vOrganization:Name .
      376         tt-org.orgINN = vOrganization:INN .
      377         tt-org.orgkpp = vOrganization:kpp .
      378         tt-org.orgguid = vOrganization:guid .
      379         find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
      380                                  and ext-classif.charkey_three eq tt-org.orgFNS
      381         no-lock no-error.
      382         if available ext-classif
      383         then do:
      384            tt-org.CodeValue = ext-classif.CharKey_One + string(ext-classif.Key#_One).
      385         end.
      386         release object vOrganization.
      387      end.
      388      release object iOrgList.
      389   END PROCEDURE.
