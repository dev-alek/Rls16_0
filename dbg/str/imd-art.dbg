       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   function is-numeral return logical
       81     (input p-string   as character ,
       82      input char-avail as character) :
       83     define variable p-replace-string as character no-undo .
       84     define variable log-result       as logical  no-undo .
       85     if p-string = ? then
       86       return false .
       87     p-replace-string = p-string.
       88     if lookup ("*", char-avail) > 0 then
       89         p-replace-string = replace (p-replace-string, '*', '9').
       90     if lookup ("digit", char-avail) > 0 then
       91       assign
       92         p-replace-string = replace (p-replace-string, '0', '9')
       93         p-replace-string = replace (p-replace-string, '1', '9')
       94         p-replace-string = replace (p-replace-string, '2', '9')
       95         p-replace-string = replace (p-replace-string, '3', '9')
       96         p-replace-string = replace (p-replace-string, '4', '9')
       97         p-replace-string = replace (p-replace-string, '5', '9')
       98         p-replace-string = replace (p-replace-string, '6', '9')
       99         p-replace-string = replace (p-replace-string, '7', '9')
      100         p-replace-string = replace (p-replace-string, '8', '9')
      101         .
      102     else
      103        p-replace-string = replace (p-replace-string, '9', chr(15))
      104         .
      105     if lookup ("letter", char-avail) > 0 then
      106       assign
      107         p-replace-string = replace (p-replace-string, 'A', '9')
      108         p-replace-string = replace (p-replace-string, 'B', '9')
      109         p-replace-string = replace (p-replace-string, 'C', '9')
      110         p-replace-string = replace (p-replace-string, 'D', '9')
      111         p-replace-string = replace (p-replace-string, 'E', '9')
      112         p-replace-string = replace (p-replace-string, 'F', '9')
      113         p-replace-string = replace (p-replace-string, 'G', '9')
      114         p-replace-string = replace (p-replace-string, 'H', '9')
      115         p-replace-string = replace (p-replace-string, 'I', '9')
      116         p-replace-string = replace (p-replace-string, 'J', '9')
      117         p-replace-string = replace (p-replace-string, 'K', '9')
      118         p-replace-string = replace (p-replace-string, 'L', '9')
      119         p-replace-string = replace (p-replace-string, 'M', '9')
      120         p-replace-string = replace (p-replace-string, 'N', '9')
      121         p-replace-string = replace (p-replace-string, 'O', '9')
      122         p-replace-string = replace (p-replace-string, 'P', '9')
      123         p-replace-string = replace (p-replace-string, 'Q', '9')
      124         p-replace-string = replace (p-replace-string, 'R', '9')
      125         p-replace-string = replace (p-replace-string, 'S', '9')
      126         p-replace-string = replace (p-replace-string, 'T', '9')
      127         p-replace-string = replace (p-replace-string, 'U', '9')
      128         p-replace-string = replace (p-replace-string, 'V', '9')
      129         p-replace-string = replace (p-replace-string, 'W', '9')
      130         p-replace-string = replace (p-replace-string, 'X', '9')
      131         p-replace-string = replace (p-replace-string, 'Y', '9')
      132         p-replace-string = replace (p-replace-string, 'Z', '9')
      133         p-replace-string = replace (p-replace-string, '_', '9')
      134         .
      135     return p-replace-string = fill ('9', length (p-string)).
      136   end.
