     1264       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Для штучного товара коэффициент должен быть целым числом. Пропускаем." chr(10).
