     1279        goods.gds-type = 'т':U then do:
     1280       if not lookup (string-type, "ITEM") > 0 then do:
     1281         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Товар топливный : Тип строки должен быть ITEM, либо CODE для товара. Пропускаем." chr(10).
     1282         return error .
     1283       end.
     1284       if i-unit-cli <> goods.unit-base then do:
     1285         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Товар топливный : Единица измерения должна совпадать с основной. Пропускаем." chr(10).
     1286         return error .
     1287       end.
     1288     end.
     1289     find units where units.unit-name = i-unit-cli no-lock no-error.
     1290     if not available units then do:
     1291       if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Единица измерения =  '" i-unit-cli "' отсутствует в справочнике."   chr(10).
     1292        find units where units.unit-name = goods.unit-base no-lock no-error.
     1293        if not available units then do:
     1294           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Единица измерения отсутствует в справочнике. Пропускаем." chr(10).
     1295           return error .
     1296        end.
     1297        else
     1298        if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Единица измерения  взята базовая. " units.unit-name  chr(10).
     1299     end.
     1300     if i-cli-base-rate <= 0 then do:
     1301       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Коэффициент должен быть больше 0. Пропускаем." chr(10).
     1302       return error .
     1303     end.
     1304     if i-cli-base-rate = ? then do:
     1305       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Коэффициент не должен иметь неопределенное значение. Пропускаем." chr(10).
     1306       return error .
     1307     end.
     1308     if i-unit-cli <> goods.unit-base and
     1309        i-cli-base-rate = 1 then do:
     1310       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Единица измерения не совпадает с основной - а коэффициент 1! Пропускаем. " chr(10).
     1311       return error .
     1312     end.
     1313     if i-unit-cli = goods.unit-base and
     1314        i-cli-base-rate <> 1 then do:
     1315       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Единица измерения совпадает с основной. Коэффициент должен быть равен 1. Пропускаем." chr(10).
     1316       return error .
     1317     end.
     1318     if  i-cli-base-rate = 1 and
     1319         i-d-pcnt <> 0 then do:
     1320       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Коэффициент равен 1. Скидка должна быть равна 0. Пропускаем." chr(10).
     1321       return error .
     1322     end.
     1323     if i-cli-base-rate > 1 and
     1324         i-d-pcnt < 0 then do:
     1325       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Коэффициент больше 1. Скидка должна быть больше или равна 0. Пропускаем." chr(10).
     1326       return error .
     1327     end.
     1328     if i-cli-base-rate < 1 and
     1329         i-d-pcnt > 0 then do:
     1330       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Коэффициент меньше 1. Скидка должна быть меньше или равна 0. Пропускаем." chr(10).
     1331       return error .
     1332     end.
     1333     if  i-price < 0 then do:
     1334       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Цена неправильная. Пропускаем." chr(10).
     1335       return error .
     1336     end.
     1337     if i-price = ? or
     1338         i-price = 0 then do:
     1339       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Цена неправильная. Пропускаем." chr(10).
     1340       return error .
     1341     end.
     1342     end.
     1343   end procedure.
     1344   procedure analiz-b-code :
     1345     do
     1346     on error undo, return error return-value
     1347     :
     1348    define input  parameter p-artic-supp as character no-undo .
     1349    define input  parameter p-artic as character no-undo .
     1350    define input  parameter p-gds-code as integer   no-undo .
     1351    define input  parameter p-b-code as character no-undo .
     1352    define buffer buf_goods for goods .
     1353    define buffer buf2_goods for goods .
     1354    find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     1355    if p-b-code = "" or p-b-code = ? then do:
     1356       run make-doc-line-base in this-procedure (p-gds-code) .
     1357       return .
     1358     end.
     1359   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1360   (
     1361    input  parParentProc
     1362   ,input  p-b-code
     1363   ,input  ?
     1364   ,input  store-type
     1365   ,input  store-code
     1366   ,input  yes
     1367   ,input  no
     1368   ,input  varscales-pref
     1369   ,input  varpgscales-pref
     1370   ,output varresult
     1371   ,output vartype-bc
     1372   ,output varweight
     1373   ,buffer bar-code
     1374   ,buffer prod-bc
     1375   ,buffer place
     1376   ) no-error.
     1377       if not available bar-code then do:
     1378         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Код " + p-b-code + " для поиска в БД отсутствует. "  chr(10).
     1379         run get-bar-code in this-procedure no-error.
     1380         if error-status:error then return error return-value .
     1381         run make-new-bar-code in this-procedure no-error .
     1382         if error-status :error then return error return-value .
     1383       return .
     1384       end.
     1385       if buf_goods.gds-code = bar-code.gds-code then do:
     1386           run make-doc-line-bar-code in this-procedure  no-error .
     1387           if error-status :error then return error return-value .
     1388           return .
     1389       end.
     1390       if buf_goods.gds-code <> bar-code.gds-code then do:
     1391          find first buf2_goods no-lock where buf2_goods.gds-code = bar-code.gds-code no-error .
     1392           if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Бар-Код " +  p-b-code + " принадлежит другому товару , с артиклом " +
     1393                          buf2_goods.artic + " " + buf2_goods.prod-type + string(buf2_goods.prod-code) +
     1394                          "." + chr(10).
     1395           run make-doc-line-base in this-procedure (p-gds-code) no-error .
     1396           if error-status :error then return error return-value .
     1397           return .
     1398       end.
     1399     end.
     1400   end procedure.
     1401   procedure make-doc-line-bar-code :
     1402     do
     1403     on error undo, return error return-value
     1404     :
     1405       if i-cli-base-rate <> 0  then i-cli-base-rate = bar-code.cli-base-rate .
     1406       if i-unit-cli      <> "" then  i-unit-cli      = bar-code.unit-cli     .
     1407     end.
     1408   end procedure.
     1409   procedure make-doc-line-base :
     1410     do
     1411     on error undo, return error return-value
     1412     :
     1413   define input  parameter p-gds-code as integer   no-undo .
     1414   find first goods no-lock where goods.gds-code = p-gds-code no-error .
     1415     if i-unit-cli = ""     then  i-unit-cli      = goods.unit-cli      .
     1416     if i-cli-base-rate = 0 then i-cli-base-rate = goods.cli-base-rate .
     1417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1418     (input  goods.gds-code
     1419     ,input  ?
     1420     ,output v-b-code
     1421     )  .
     1422   find first bar-code where bar-code.b-code = v-b-code no-error .
     1423     end.
     1424   end procedure.
     1425   procedure make-new-bar-code :
     1426     do
     1427     on error undo, return error return-value
     1428     :
     1429   run imp-prod-bc in this-procedure .
     1430     end.
     1431   end procedure.
     1432   procedure find-goods :
     1433   do
     1434   on error undo, return error return-value
     1435   :
     1436   define output parameter p-gds-code as integer   no-undo .
     1437   define buffer bb_bar-code  for bar-code .
     1438   define buffer bb_prod-bc   for prod-bc  .
     1439   define buffer bb_place     for place    .
     1440   p-gds-code = ? .
     1441   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1442   (
     1443    input  parParentProc
     1444   ,input  i-code
     1445   ,input  ?
     1446   ,input  store-type
     1447   ,input  store-code
     1448   ,input  yes
     1449   ,input  no
     1450   ,input  varscales-pref
     1451   ,input  varpgscales-pref
     1452   ,output varresult
     1453   ,output vartype-bc
     1454   ,output varweight
     1455   ,buffer bb_bar-code
     1456   ,buffer bb_prod-bc
     1457   ,buffer bb_place
     1458   ) no-error.
     1459       if available bb_bar-code then do:
     1460          p-gds-code = bb_bar-code.gds-code.
     1461       end.
     1462   end.
     1463   end procedure.
     1464   procedure new-art-supp :
     1465     do
     1466     on error undo, return error return-value
     1467     :
     1468   define input  parameter v-mode as integer   no-undo .
     1469   define variable var-gds-code as integer   no-undo .
     1470   define variable v-stat as character no-undo init ?.
     1471   define variable v-list as character no-undo init ?.
     1472   define variable v-prod-type like ub.clients.obj-type no-undo .
     1473   define variable v-prod-code like ub.clients.obj-code no-undo .
     1474   define variable new-ref-list as character no-undo init "" .
     1475   define variable i as integer   no-undo .
     1476   if v-mode = 1 then do:
     1477       run ref/gds-ref.p
     1478       (   parParentProc
     1479         , "b-sel,b-add"
     1480         , 'текущие':U
     1481         , 'все':U
     1482         , 'все':U
     1483         , ?
     1484         , ?
     1485         , ?
     1486         , ?
     1487         , store-type
     1488         , store-code
     1489         , ?
     1490         , output new-ref-list).
     1491         find first goods no-lock where recid(goods) = integer (new-ref-list) no-error .
     1492         if error-status :error then return error return-value .
     1493         run add-cli-gds in this-procedure  no-error .
     1494         if error-status :error then return error return-value .
     1495   end.
     1496   if v-mode = 2 then do:
     1497   define variable v-ret as character no-undo .
     1498   define variable vattr-codes as character no-undo .
     1499   define variable vattr-labels as character no-undo .
     1500   define buffer bb_cli-gds for cli-gds.
     1501   define buffer bb_goods for goods.
     1502   for each bb_cli-gds no-lock where
     1503         bb_cli-gds.cli-type  = parcli-type  and
     1504         bb_cli-gds.cli-code  = parcli-code  and
     1505         bb_cli-gds.host-code = parhost-code and
     1506         bb_cli-gds.cli-art   = i-artic-supp ,
     1507      first bb_goods no-lock where
     1508         bb_goods.artic      = bb_cli-gds.artic and
     1509         bb_goods.prod-type  = bb_cli-gds.prod-type and
     1510         bb_goods.prod-code  = bb_cli-gds.prod-code :
     1511         vattr-codes  = vattr-codes  + chr(1) + string (bb_goods.gds-code) .
     1512         vattr-labels = vattr-labels + chr(1) +  string(bb_goods.artic,"x(16)") + " " + bb_goods.gds-name.
     1513   end.
     1514   run gbl/d-list.w
     1515   (    INPUT "b-sel":U
     1516       ,INPUT "К артиклу поставщика <" + i-artic-supp +  "> прикреплены"
     1517       ,INPUT vattr-codes
     1518       ,INPUT vattr-labels
     1519       ,INPUT chr(1)
     1520       ,INPUT "":U
     1521       ,output v-ret ) .
     1522         find first goods no-lock where goods.gds-code = integer (v-ret) no-error .
     1523         if error-status :error then return error return-value .
     1524         i-artic     = goods.artic .
     1525         i-prod-code = goods.prod-code.
     1526         if i-unit-cli = ""    then  i-unit-cli  = goods.unit-base .
     1527         if i-cli-base-rate = 0 then i-cli-base-rate = goods.cli-base-rate .
     1528   end.
     1529     end.
     1530   end procedure.
     1531   procedure add-cli-gds :
     1532     do
     1533     on error undo, return error return-value
     1534     :
     1535     i-artic     = goods.artic .
     1536     i-prod-code = goods.prod-code.
     1537     if i-unit-cli = ""    then  i-unit-cli  = goods.unit-base .
     1538     if i-cli-base-rate = 0 then i-cli-base-rate = goods.cli-base-rate .
     1539     find first bf_cli-gds where bf_cli-gds.cli-type  = parcli-type  and
     1540                bf_cli-gds.cli-code  = parcli-code  and
     1541                bf_cli-gds.host-code = parhost-code and
     1542                bf_cli-gds.artic     = goods.artic and
     1543                bf_cli-gds.prod-code = goods.prod-code and
     1544                bf_cli-gds.prod-type = goods.prod-type
     1545                exclusive-lock no-error.
     1546       if not available bf_cli-gds then do:
     1547           create cli-gds.
     1548           assign
     1549           cli-gds.cli-type  = parcli-type
     1550           cli-gds.cli-code  = parcli-code
     1551           cli-gds.host-code = parhost-code
     1552           cli-gds.cli-art   = i-artic-supp
     1553           cli-gds.artic     = goods.artic
     1554           cli-gds.prod-code = goods.prod-code
     1555           cli-gds.prod-type = goods.prod-type
     1556           .
     1557          if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted substitute ("артикул поставщика &1 по фирме &2 для поставщика &3 &4. Добавлен по товару &5 &6.", i-artic-supp, parhost-code, parcli-type, parcli-code, goods.artic ,goods.gds-name) chr(10).
     1558       end.
     1559       else do:
     1560         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "У товара найденого по бар-коду артикул поставщика = < " + bf_cli-gds.cli-art + " >" chr(10).
     1561             if  bf_cli-gds.cli-art   = "" then bf_cli-gds.cli-art   = i-artic-supp .
     1562             else do:
     1563                 if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "У товара найденого по бар-коду уже есть артикул , не равный артикул поставщика "  bf_cli-gds.cli-art  ". Пропускаем." chr(10) skip.
     1564                 return error return-value .
     1565             end.
     1566       end.
     1567     end.
     1568   end procedure.
     1569   procedure get-bar-code:
     1570   define variable s-in-code   like parts.in-code   no-undo.
     1571   define variable s-part-code like parts.part-code no-undo.
     1572   define variable new-bar-code as log              no-undo.
     1573   define variable n-c like gds-prt.node-code no-undo.
     1574     assign
     1575       s-in-code   = ""
     1576       s-part-code = ""
     1577       .
     1578   find-create-bc:
     1579   do transaction
     1580   on error undo find-create-bc, return error
     1581   on stop  undo find-create-bc, return error :
     1582     find first gds-prt where gds-prt.upper-code = goods.prt-root
     1583          use-index level no-lock no-error.
     1584     do while true:
     1585       n-c = gds-prt.node-code.
     1586       find first gds-prt where gds-prt.upper-code = n-c
     1587            use-index level no-lock no-error.
     1588       if not available gds-prt then  leave.
     1589     end.
     1590    if not available gds-prt then do:
     1591       find first  gds-prt where
     1592             gds-prt.prt-root = goods.prt-root and
     1593             gds-prt.is-term  = yes
     1594             no-lock no-error.
     1595     end.
     1596   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1597   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1598     (input  goods.gds-code
     1599     ,input  gds-prt.node-code
     1600     ,input  s-part-code
     1601     ,input  s-in-code
     1602     ,input  i-unit-cli
     1603     ,input  i-cli-base-rate
     1604     ,output new-bar-code
     1605     ,buffer bar-code
     1606     ) no-error .
     1607     if error-status:error then do:
     1608       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Ошибка при поиске / создании собственного кода " + error-status :get-message(1) + ". Пропускаем." chr(10).
     1609       undo find-create-bc, return error.
     1610     end.
     1611     if new-bar-code then do:
     1612       if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   " Бар-код : "                    bar-code.b-code   " Единица измерения Бар-кода : " bar-code.unit-cli   " коэффициент Бар-кода : "        bar-code.cli-base-rate   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Создан собственный код с единицей измерения из входного файла." chr(10).
     1613     end.
     1614     if bar-code.cli-base-rate <> i-cli-base-rate then do:
     1615       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   " Бар-код : "                     bar-code.b-code   " Единица измерения Бар-кода : " bar-code.unit-cli   " коэффициент Бар-кода : "        bar-code.cli-base-rate   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Коэффициент в собственном коде не совпадает с указанным в файле. Пропускаем." chr(10).
     1616       undo find-create-bc, return error.
     1617     end.
     1618   end.
     1619   end procedure.
