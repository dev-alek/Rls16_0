      478       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Пустое поле цена. Пропускаем." chr(10).
      479       if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.
      480       next file-line.
