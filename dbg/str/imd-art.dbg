      549               + "Предлагается список товаров, в нем надо выбрать товар , который будет закачен в ПН"
      550           ,input 2
      551           ,input 1
      552           ,output v-num
      553           ).
      554         if v-num = 1 then do:
      555           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Не удалось определить товар. Пропускаем." chr(10).
      556           if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.
      557           next file-line.
      558         end.
      559         else do:
      560         run new-art-supp in this-procedure (2) no-error .
      561             if error-status :error then do:
      562                 if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Не удалось определить товар. Пропускаем." chr(10).
      563                 if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.
      564                 next file-line.
      565             end.
      566         end.
      567     end.
      568    if i-prod-code = 0  then do:
      569       run find-goods in this-procedure (output v-gds-code) .
      570       find first goods no-lock where goods.gds-code = v-gds-code no-error .
      571       if not error-status :error then do:
      572         i-artic     = goods.artic .
      573         i-prod-code = goods.prod-code.
      574         if i-unit-cli = ""    then  i-unit-cli  = goods.unit-base .
      575         if i-cli-base-rate = 0 then i-cli-base-rate = goods.cli-base-rate .
      576       end.
      577       else do:
      578           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "По бар-коду не удалось определить товар. Пропускаем." chr(10).
      579           if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.
      580           next file-line.
      581       end.
      582    end.
      583       find first goods no-lock where goods.artic     =   i-artic       and
      584                                      goods.prod-code =   i-prod-code no-error  .
      585         if error-status :error then do:
      586             if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) error-status :get-message(1) + i-artic + " " + string(i-prod-code) + " . Пропускаем." chr(10).
      587             if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.
      588             next file-line.
      589         end.
      590   define buffer bb_goods for goods.
      591     if decimal(i-code) <> 0 then do:
      592       find first bar-code no-lock where bar-code.b-code = int(i-code) no-error .
      593           run find-goods in this-procedure (output v-gds-code) .
      594           find first bb_goods no-lock where BB_goods.gds-code = v-gds-code no-error .
      595           if available bb_goods then do:
      596             if bb_goods.gds-code <> goods.gds-code then do:
      597                 if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Бар-Код " + i-code + " принадлежит другому товару , с артиклом " +
      598                 bb_goods.artic + " " + bb_goods.prod-type + string(bb_goods.prod-code) +
      599                 ". Закачиваем товар " + goods.artic + " " + goods.prod-type + string(goods.prod-code) +
      600                 " по базовым ед.изм." + chr(10).
      601   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      602     (input  goods.gds-code
      603     ,input  ?
      604     ,output v-b-code
      605     )  .
      606                 find first bar-code where bar-code.b-code = v-b-code no-error .
      607             end.
      608           end.
      609           else do:
      610                 if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Бар-Код " + i-code + " не найден в БД " + chr(10).
      611   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      612     (input  goods.gds-code
      613     ,input  ?
      614     ,output v-b-code
      615     )  .
      616                 find first bar-code where bar-code.b-code = v-b-code no-error .
      617           end.
      618     end.
      619      run body-proc in this-procedure (input goods.gds-code ) no-error .
      620      if error-status :error then   next file-line.
      621      run analiz-b-code in this-procedure (  i-artic-supp ,
      622                           goods.artic  ,
      623                           goods.gds-code ,
      624                           i-code       )
      625                           no-error .
      626      if error-status :error then
      627      do:
      628      message 124 .
      629      if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted  error-status :get-message(1) + return-value  + chr(10).
      630      next file-line.
      631      end.
      632      run body-proc in this-procedure (input goods.gds-code ) no-error .
      633      if error-status :error then next file-line.
      634     run imp-input-way-bill in this-procedure  no-error.
      635     if error-status:error then do:
      636         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted SUBSTITUTE("Ошибка при вызове внутренней процедуры imp-input-way-bill &1 &2 &3",
      637                                                     return-value,
      638                                                     error-status:get-message(1),
      639                                                     error-status:get-message(2))  + chr(10).
      640         next file-line.
      641       end.
      642   END.
      643   hide frame a .
      644   procedure imp-prod-bc:
      645   def buffer same-prod-bc  for prod-bc.
      646   def buffer same-bar-code for bar-code.
      647   def buffer same-goods    for goods.
      648   if not available bar-code then do:
      649   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      650     (input  goods.gds-code
      651     ,input  ?
      652     ,output v-b-code
      653     )  .
      654     find first bar-code where bar-code.b-code = v-b-code no-error .
      655   end.
      656   if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted ">> Импорт доп.бар-код " + i-prod-bc  chr(10).
      657   tr:
      658   do on error undo tr, return error SUBSTITUTE("Ошибка при импорте доп. бар-кода &1 &2 &3 ", i-prod-bc, error-status:get-message(1), error-status:get-message(2)):
      659   if  length (i-prod-bc) > 13  and
      660       not is-numeral (i-prod-bc,
      661                       "letter,digit") or
      662       length (i-prod-bc) <= 13  and
      663       not is-numeral (i-prod-bc,
      664                       "digit") then do:
      665     if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Доп. БК содержит пробелы или недопустимые символы. Пропускаем доп.бар-код." chr(10).
      666     return.
      667   end.
      668   if  i-prod-bc begins par-bc-pfx and
      669       (length (i-prod-bc) = 13 and
      670       par-bc-frmt = "EAN13" or
      671       length (i-prod-bc) = 8 and
      672       par-bc-frmt = "EAN8") or
      673       (i-prod-bc begins par-pl-pfx and
      674       par-pl-pfx <> ? and
      675       par-pl-frmt <> ?) and
      676       (length (i-prod-bc) = 13 and
      677       par-pl-frmt = "EAN13" or
      678       length (i-prod-bc) = 8 and
      679       par-pl-frmt = "EAN8") then do:
      680     if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Доп. БК имеет префикс, зарезервированный для собственных товарных (складских мест) бар-кодов. Пропускаем доп.бар-код." chr(10).
      681     return.
      682   end.
      683   if length (i-prod-bc) < 6 then do:
      684     if (lookup ('топ':U, goods-units.type) > 0 and
      685         lookup ('дро':U, goods-units.type) > 0 or
      686         lookup ('вес':U, goods-units.type) > 0) and
      687         goods.gds-type = 'т':U then do:
      688       if  lookup ('топ':U, goods-units.type) > 0 and
      689           lookup ('дро':U, goods-units.type) > 0 then do:
      690         if  lookup ('топ':U, units.type) > 0 and
      691             lookup ('дро':U, units.type) > 0 then do:
      692           if length (i-prod-bc) > 2 then do:
      693             if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Топливный код: " + i-prod-bc + " не должен быть длиннее 2 разрядов. Пропускаем доп.бар-код." chr(10).
      694             return.
      695           end.
      696           find first  prod-bc where
      697                       prod-bc.b-code = bar-code.b-code and
      698                       prod-bc.b-str <> i-prod-bc no-lock no-error.
      699           if available prod-bc then do:
      700             if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Товар топливный. Уже есть топливный код у этого товара: " prod-bc.b-str
      701                        " Он должен быть только один. Пропускаем доп.бар-код." chr(10).
      702             return.
      703           end.
      704         end.
      705         else do:
      706           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Товар топливный. Можно импортировать только топливный код (с дробно-топливной единицей измерения). Пропускаем доп.бар-код." chr(10).
      707           return.
      708         end.
      709       end.
      710       if lookup ('вес':U, goods-units.type) > 0 then do:
      711         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Код  " + i-prod-bc + " - весовой. Весовые коды не импортируются. Пропускаем доп.бар-код." chr(10).
      712         return.
      713       end.
      714     end.
      715     else do:
      716       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Код короче 6 разрядов  " + i-prod-bc + " может соответствовать только весовому или дробному топливному товару. Пропускаем доп.бар-код." chr(10).
      717       return.
      718     end.
      719   end.
      720   else do:
      721     if  lookup ('топ':U, units.type) > 0 and
      722         lookup ('дро':U, units.type) > 0 or
      723         lookup ('вес':U, units.type) > 0 then do:
      724       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Весовой или топливный код  " + i-prod-bc + " не может быть длиннее 5 разрядов. Пропускаем доп.бар-код." chr(10).
      725       return .
      726     end.
      727   end.
      728   find first  same-prod-bc where
      729               same-prod-bc.b-str  = i-prod-bc and
      730               same-prod-bc.b-code = bar-code.b-code no-lock no-error.
      731   if available same-prod-bc then do:
      732     if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "Доп. БК: " + i-prod-bc + " уже есть в БД. Пропускаем доп.бар-код." chr(10).
      733     return.
      734   end.
      735   find first same-prod-bc where
      736              same-prod-bc.b-str = i-prod-bc and
      737              same-prod-bc.bc-on = yes       no-lock no-error.
      738   if available same-prod-bc then do:
      739     find same-bar-code where
      740          same-bar-code.b-code = same-prod-bc.b-code no-lock.
      741     find same-goods where
      742          same-goods.gds-code = same-bar-code.gds-code no-lock.
      743     if  same-goods.prod-type = goods.prod-type AND
      744         same-goods.prod-code = goods.prod-code AND
      745         par-dif-pdbc = yes  then do:
      746       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "В БД уже есть такой доп. БК для товара: арт. : " same-goods.artic
      747                  ", он включен и соответствует тому же производителю. Пропускаем в соответствии с настройкой." chr(10).
      748       return.
      749     end.
      750     if par-dpl-off = yes then do:
      751       if i-bc-on = no then do:
      752         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "В БД уже есть такой доп. БК для товара: арт. : " same-goods.artic ", пр-ль : " same-goods.prod-code
      753                    ", он включен. Добавляемый код вЫключен. Таким его и добавляем." chr(10).
      754       end.
      755       else do:
      756         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "В БД уже есть такой доп. БК для товара: арт. : " same-goods.artic ", пр-ль : " same-goods.prod-code
      757                    ", он включен. Добавляемый код тоже включен. Добавляем его вЫключеным в соответствии с настройкой." chr(10).
      758         assign
      759           i-bc-on = no.
      760         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Имевшийся в БД доп. БК (см. предыдущее сообщение) для товара: арт. : " same-goods.artic ", пр-ль : " same-goods.prod-code
      761                    ", который был включен, вЫключаем в соответствии с настройкой" chr(10).
      762         do transaction on error undo, return error return-value:
      763           find current same-prod-bc exclusive-lock.
      764           assign
      765             same-prod-bc.bc-on = no.
      766         end.
      767      end.
      768     end.
      769     else do:
      770       if i-bc-on = yes then do:
      771         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "В БД уже есть такой доп. БК для товара: арт. : " same-goods.artic ", пр-ль : " same-goods.prod-code
      772                    ", он включен. Добавляемый код тоже включен. ВЫключаем уже имеющийся в базе код. Добавляемый оставляем включенным." chr(10).
      773         do transaction on error undo, return error return-value :
      774           find current same-prod-bc exclusive-lock.
      775           assign
      776             same-prod-bc.bc-on = no.
      777         end.
      778         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "В БД уже есть такой доп. БК для товара: арт. : " same-goods.artic ", пр-ль : " same-goods.prod-code
      779                    ", он включен. Добавляемый код вЫключен. Добавляем код без изменений." chr(10).
      780       end.
      781     end.
      782   end.
      783   else do:
      784     find first same-prod-bc where
      785                same-prod-bc.b-str = i-prod-bc and
      786                recid (same-prod-bc) <> recid (prod-bc) no-lock no-error.
      787     if available same-prod-bc then do:
      788       find  same-bar-code where
      789             same-bar-code.b-code = same-prod-bc.b-code no-lock.
      790       find same-goods where
      791            same-goods.gds-code = same-bar-code.gds-code no-lock.
      792       if  same-goods.prod-type = goods.prod-type AND
      793           same-goods.prod-code = goods.prod-code AND
      794           par-dif-pdbc = yes  then do:
      795         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted "В БД уже есть такой доп. БК для товара: арт. : " same-goods.artic
      796                    ", он вЫключен и соответствует тому же производителю. Пропускаем  доп.бар-код в соответствии с настройкой dif-pdbc." chr(10).
      797         return.
      798       end.
      799       if i-bc-on = yes then do:
      800         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "В БД уже есть такой доп. БК для товара: арт. : " same-goods.artic ", пр-ль : " same-goods.prod-code
      801                    ", он выключен. Добавляемый код включен. Добавляем код без изменений." chr(10).
      802       end.
      803       else do:
      804         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "В БД уже есть такой доп. БК для товара: арт. : " same-goods.artic ", пр-ль : " same-goods.prod-code
      805                    ", он выключен. Добавляемый код вЫключен. Добавляем код без изменений." chr(10).
      806       end.
      807     end.
      808   end.
      809   do transaction on error undo, return error return-value :
      810     define variable rid as recid no-undo .
      811     rid = ?.
      812     run trg/prod-bc1.p (
      813                         input  parparentproc
      814                         ,input yes
      815                         ,input par-dif-pdbc
      816                         ,input ?
      817                         ,input no
      818                         ,input ''
      819                         ,input ""
      820                         ,buffer goods
      821                         ,input bar-code.b-code
      822                         ,input-output i-prod-bc
      823                         ,output rid
      824                         ) no-error.
      825     if error-status :error
      826     then do:
      827         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Ошибка при импорте доп. БК для товара: арт. : " goods.artic ", пр-ль : " goods.prod-code chr(10)
      828                    error-status:get-message(1) chr(10) return-value  chr(10).
      829     end.
      830     else if rid = ? then do:
      831         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Невозможно импортировать доп. БК для товара: арт. : " goods.artic ", пр-ль : " goods.prod-code chr(10)
      832                    error-status:get-message(1) chr(10) return-value  chr(10).
      833     end.
      834   end.
      835   assign
      836     counter = counter + 1.
      837   end.
      838   end procedure.
      839   procedure imp-input-way-bill:
      840   define variable n-c like gds-prt.node-code no-undo.
      841   define buffer bf_doc-line-attr for doc-line-attr.
      842   find doc-line where
      843        doc-line.doc-code  = trn-doc.doc-code and
      844        doc-line.artic     = goods.artic and
      845        doc-line.prod-code = goods.prod-code and
      846        doc-line.prod-type = goods.prod-type no-error.
      847   if available doc-line then do:
      848     if doc-line.unit-cli      = i-unit-cli and
      849        doc-line.cli-base-rate = i-cli-base-rate then
      850       assign
      851         doc-line.cli-qnty      = doc-line.cli-qnty + i-qnty
      852         doc-line.price-cli     = i-price
      853         doc-line.unit-cli      = i-unit-cli
      854         doc-line.cli-base-rate = i-cli-base-rate
      855         .
      856     else do:
      857       if doc-line.cli-base-rate = i-cli-base-rate then do:
      858         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Единица измерения поставщика в строке ПН: " doc-line.unit-cli
      859                    " Не совпадает с импортируемой. Заменяем на: " i-unit-cli chr(10).
      860         doc-line.unit-cli = i-unit-cli.
      861       end.
      862       else do:
      863         if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Коэффициент в строке ПН: " doc-line.cli-base-rate
      864                    " Не совпадает с импортируемым. Заменяем единицу измерения поставщика на основную: " goods.unit-base
      865                    " и пересчитываем количества поставщика." chr(10).
      866         assign
      867           doc-line.unit-cli      = goods.unit-base
      868           doc-line.cli-qnty      = doc-line.cli-qnty * doc-line.cli-base-rate +
      869                                    i-qnty * i-cli-base-rate
      870           doc-line.cli-base-rate = 1
      871           doc-line.price-cli     = i-price / i-cli-base-rate
      872           .
      873       end.
      874     end.
      875   end.
      876   else do:
      877   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclin in g#lib-trn
      878   (input trn-doc.doc-code
      879   ,input goods.artic
      880   ,input goods.prod-type
      881   ,input goods.prod-code
      882   ,input ''
      883   ,input 0
      884   ,input ''
      885   ,input ''
      886   ,input goods.prt-root
      887   ,input 0
      888   ,input 0
      889   ,input 0
      890   ) no-error
      891   .
      892     if error-status:error then do:
      893         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.   put stream err unformatted SUBSTITUTE("Ошибка при вызове процедуры crdoclin &1 &2 &3",
      894                               return-value,
      895                               error-status:get-message(1),
      896                               error-status:get-message(2))  + chr(10).
      897         return error.
      898     end.
      899     find first doc-line where doc-line.doc-code  = trn-doc.doc-code and
      900                               doc-line.artic     = goods.artic      and
      901                               doc-line.prod-type = goods.prod-type  and
      902                               doc-line.prod-code = goods.prod-code .
      903     assign
      904       doc-line.cli-qnty      = 0
      905       doc-line.doc-qnty      = 0
      906       doc-line.fact-qnty     = 0
      907       doc-line.price-cli     = i-price
      908       doc-line.unit-cli      = i-unit-cli
      909       doc-line.cli-base-rate = i-cli-base-rate
      910       doc-line.cli-qnty      = i-qnty
      911       doc-line.wt-brutto     = i-wt-brutto
      912       doc-line.num-place     = i-num-place
      913       .
      914   end.
      915   assign
      916     doc-line.VAT-pc        = v-VAT-pc
      917     doc-line.SLT-pc        = v-SLT-pc
      918     .
      919   find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = doc-line.doc-code and
      920                                     bf_doc-line-attr.gds-code  = goods.gds-code    and
      921                                     bf_doc-line-attr.attr-code = "cst-code"        no-error.
      922   if not available bf_doc-line-attr then do:
      923      create bf_doc-line-attr.
      924      assign
      925      bf_doc-line-attr.doc-code   = doc-line.doc-code
      926      bf_doc-line-attr.gds-code   = goods.gds-code
      927      bf_doc-line-attr.attr-code  = "cst-code"
      928      bf_doc-line-attr.attr-value = i-cst-code.
      929   end.
      930   if string-type = "SCALE" OR
      931      string-type = "CODE"  then
      932     n-c = gds-prt.node-code.
      933   if string-type = "ITEM" then do:
      934     find first gds-prt where gds-prt.upper-code = goods.prt-root
      935          use-index level no-lock no-error.
      936     do while true:
      937       n-c = gds-prt.node-code.
      938       find first gds-prt where gds-prt.upper-code = n-c
      939            use-index level no-lock no-error.
      940       if not available gds-prt then
      941         leave.
      942     end.
      943   end.
      944   find gds-dtl where
      945        gds-dtl.doc-code  = trn-doc.doc-code and
      946        gds-dtl.artic     = goods.artic and
      947        gds-dtl.prod-code = goods.prod-code and
      948        gds-dtl.prod-type = goods.prod-type and
      949        gds-dtl.prt-code  = n-c no-error.
      950   if not available gds-dtl then do:
      951     assign counter = counter + 1.
      952     create gds-dtl .
      953     assign
      954       gds-dtl.doc-code      = trn-doc.doc-code
      955       gds-dtl.artic         = goods.artic
      956       gds-dtl.prod-code     = goods.prod-code
      957       gds-dtl.prod-type     = goods.prod-type
      958       gds-dtl.prt-code      = n-c
      959     .
      960   end.
      961   assign
      962     doc-line.doc-qnty      = doc-line.doc-qnty + (i-qnty * i-cli-base-rate)
      963     doc-line.fact-qnty     = doc-line.doc-qnty
      964     doc-line.cli-base-rate = doc-line.doc-qnty / doc-line.cli-qnty
      965     gds-dtl.doc-qnty       = gds-dtl.doc-qnty + (i-qnty * i-cli-base-rate)
      966     gds-dtl.fact-qnty      = gds-dtl.doc-qnty
      967     count-upd              = count-upd + 1
      968     .
      969   end procedure.
      970   procedure delete-trn-doc :
      971     do
      972     on error undo, return error
      973     :
      974       for each doc-line
      975         where doc-line.doc-code = trn-doc.doc-code
      976       on error undo, return error
      977       :
      978         delete doc-line .
      979       end.
      980       for each gds-dtl
      981         where gds-dtl.doc-code = trn-doc.doc-code
      982       on error undo, return error
      983       :
      984         delete gds-dtl .
      985       end.
      986       delete trn-doc .
      987     end.
      988   end procedure.
      989   procedure body-proc :
      990     do
      991     on error undo, return error return-value
      992     :
      993   define input  parameter p-gds-code as integer   no-undo .
      994         FIND first goods WHERE
      995                    goods.gds-code = p-gds-code no-lock no-error.
      996         if available goods then do:
      997         end.
      998         else do:
      999           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Товар с данными артикулом и кодом производителя (подразумевается организация) в БД отсутствует. Пропускаем." chr(10).
     1000           if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.
     1001           return error .
     1002         end.
     1003       if i-prod-code <> 0 then do:
     1004           if goods.artic <> i-artic then do:
     1005             if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Несоответствие доп.бар-кода и артикула поставщика. Взят по доб.бар-коду." + goods.artic chr(10).
     1006           end.
     1007       end.
     1008       assign
     1009        i-artic     = goods.artic
     1010        i-prod-code = goods.prod-code
     1011       .
     1012         if i-unit-cli = ""    then  i-unit-cli  = goods.unit-base .
     1013         if i-cli-base-rate = 0 then i-cli-base-rate = goods.cli-base-rate .
     1014       if i-unit-cli = "" then do:
     1015         if available bar-code then do:
     1016             assign
     1017               i-cli-base-rate = bar-code.cli-base-rate
     1018               i-unit-cli      = bar-code.unit-cli
     1019               .
     1020             if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   " Бар-код : "                    bar-code.b-code   " Единица измерения Бар-кода : " bar-code.unit-cli   " коэффициент Бар-кода : "        bar-code.cli-base-rate   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Не указаны единица измерения и коэффициент. Берем из собственного кода." chr(10).
     1021          end.
     1022          else do:
     1023             assign
     1024               i-cli-base-rate = 1
     1025               i-unit-cli      = goods.unit-base
     1026               .
     1027             if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Не указаны единица измерения и коэффициент. Берем из товара базовые ед.изм." chr(10).
     1028          end.
     1029       end.
     1030       if available bar-code and decimal(i-code) > 0 then do:
     1031         find first gds-prt where gds-prt.node-code = bar-code.node-code no-lock.
     1032         if gds-prt.is-term <> yes       then do:
     1033           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Код " i-code " не является кодом терминального признака. Пропускаем." chr(10).
     1034           if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.
     1035           return error .
