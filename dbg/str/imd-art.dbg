      357   def frame a
      358   counter   label "Закачано"
      359   count-upd label "Изменено"
      360   count-all label "Просмотрено"
      361   with side-labels view-as dialog-box.
      362   view frame a.
      363       on write of trn-doc override do: end.
      364       clear-imp:
      365       do transaction
      366         on error undo clear-imp, return error
      367         on stop  undo clear-imp, return error :
      368         find trn-doc where trn-doc.doc-code = pardoc-code no-error.
      369         if available trn-doc then do:
      370           run delete-trn-doc in this-procedure .
      371         end.
      372         create trn-doc .
      373         assign
      374           trn-doc.doc-code  = pardoc-code
      375           trn-doc.cr-db-num = v-cntxt-db-num
      376           trn-doc.doc-type  = 'при':U
      377           trn-doc.internal  = no
      378           trn-doc.exch-code = e-code
      379         .
      380         assign
      381             v-obj-type = store-type
      382             v-obj-code = store-code
      383         .
      384       end.
      385   frame a :title = frame-title.
      386   put stream err unformatted fill (chr(10), 2) frame a :title fill (chr(10), 3).
      387   assign varfile-scan = ?
      388          vararticle-supplier = no.
      389   file-line:
      390   repeat on endkey undo, leave :
      391     disp count-upd counter count-all with frame a.
      392     do on endkey undo, leave:
      393       import stream  inp unformatted source-string no-error.
      394     end.
      395     if error-status:error then undo, leave.
      396     if source-string = "" then
      397       next file-line.
      398     count-all = count-all + 1.
      399       assign
      400         vararticle-supplier = yes.
      401       if parcli-type = ? and
      402          parcli-code = ? then do:
      403         message "Нет данных по поставщику."
      404         view-as alert-box error.
      405         return error.
      406       end.
      407       else do:
      408         find first bf_clients where bf_clients.obj-type = parcli-type and
      409                                     bf_clients.obj-code = parcli-code no-lock no-error.
      410         if not available bf_clients then do:
      411           message "Ведем импорт по артикулу поставщика." skip
      412                   "Не найден поставщик " parcli-type parcli-code " ."
      413           view-as alert-box error.
      414           return error.
      415         end.
      416       end.
      417     assign
      418       string-type     = "ITEM"
      419       text-string     = source-string
      420       i-artic-supp    = ""
      421       i-artic         = ""
      422       i-code          = ""
      423       i-prod-code     = 0
      424       i-scale         = ""
      425       i-prod-bc       = ""
      426       i-price         = 0
      427       i-qnty          = 0
      428       i-unit-cli      = ""
      429       i-cli-base-rate = 1
      430       i-d-pcnt        = 0
      431       i-VAT           = 0
      432       i-SLT           = 0
      433       size            = 1
      434       i-bc-on         = ?
      435       i-cst-code      = ""
      436       i-wt-brutto     = 0
      437       i-num-place     = 0
      438       .
      439     if num-entries (text-string, ";") <> 8 then do:
      440       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Неправильное число параметров: " string (num-entries (text-string, ";"))
      441                     " (должно быть 8 ) . Пропускаем." chr(10).
      442       if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.
      443       next file-line.
      444     end.
      445     assign
      446       i-artic-supp    = trim    (entry (1, text-string, ";"))
      447       i-prod-bc       = trim    (entry (2, text-string, ";"))
      448       i-code          = trim    (entry (2, text-string, ";"))
      449       i-qnty          = decimal (entry (3, text-string, ";"))
      450       i-price         = decimal (entry (4, text-string, ";"))
      451       i-cst-code      =          entry (5, text-string, ";")
      452       i-unit-cli      =          entry (6, text-string, ";")
      453       i-cli-base-rate = decimal (entry (7, text-string, ";"))
      454       i-VAT           = decimal (entry (8, text-string, ";"))
      455       .
      456       if i-unit-cli <> "" then do:
      457          find first units  where units.unit-name  = i-unit-cli no-lock no-error .
      458          if error-status :error then do:
      459            if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)        substitute ("Не верная единица измерения поставщика &1 . ",i-unit-cli ) chr(10).
      460            wrn-line = count-all.
