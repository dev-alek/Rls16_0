      482   if decimal(i-code) <> 0 then do:
      483      find first bar-code no-lock where bar-code.b-code = int(i-code) no-error .
      484   end.
      485   define variable v-gds-code as integer   no-undo .
      486         find first bf_cli-gds where bf_cli-gds.cli-type  = parcli-type  and
      487                                     bf_cli-gds.cli-code  = parcli-code  and
      488                                     bf_cli-gds.host-code = parhost-code and
      489                                     bf_cli-gds.cli-art   = i-artic-supp no-lock no-error.
      490         if not available bf_cli-gds then do:
      491            if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)        substitute ("Не найден артикул поставщика &1 по фирме &2 для поставщика &3 &4. ", i-artic-supp, parhost-code, parcli-type, parcli-code) chr(10).
      492            wrn-line = count-all.
      493            run find-goods (output v-gds-code) .
      494            find first goods no-lock where goods.gds-code = v-gds-code no-error .
      495            if not error-status :error then do:
      496               if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      goods.artic   " Производитель : "                goods.prod-type   " "                                goods.prod-code   " Код товара : "                   goods.gds-code   " Основная единица измерения : "   goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted substitute ("Прошла идентификация товара по бар-коду &1 . ", i-code) chr(10).
      497               run add-cli-gds no-error .
      498               if error-status :error then
      499                  next file-line.
      500            end.
      501            else do:
      502                   run gbl/d-askw.w
      503                   (input "Вопрос"
      504                   ,input "По артиклу поставшика <" + i-artic-supp + ">, по фирме " + string (parHost-code) + " не найдено товара." + chr(10)
      505                     + "Ваши действия:" + chr(10)
      506                   ,input "|^"
      507                   ,input "Пропустить|Выбор"
      508                   ,input "Артикул <" + i-artic-supp + "> не будет закачен|"
      509                       + "Предлагается справочник товаров, в нем надо выбрать товар , к которому припишется артикул поставщика <"  + i-artic-supp + ">"
      510                   ,input 2
      511                   ,input 1
      512                   ,output v-num
      513                   ).
      514                 if v-num = 1 then do:
      515                   if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Не удалось определить товар. Пропускаем." chr(10).
      516                   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.
      517                   next file-line.
      518                 end.
      519                 else do:
      520                 run new-art-supp in this-procedure  (1) no-error .
      521                     if error-status :error then do:
      522                         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Не удалось определить товар. Пропускаем." chr(10).
      523                         if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).        end.
      524                         next file-line.
      525                     end.
      526                 end.
      527            end.
      528         end.
      529     find  bf_cli-gds where bf_cli-gds.cli-type  = parcli-type  and
      530                            bf_cli-gds.cli-code  = parcli-code  and
      531                            bf_cli-gds.host-code = parhost-code and
      532                            bf_cli-gds.cli-art   = i-artic-supp no-lock no-error.
      533     if available bf_cli-gds then do:
      534         assign
      535           i-artic     = bf_cli-gds.artic
      536           i-prod-code = bf_cli-gds.prod-code
      537           .
      538     end.
      539     else do:
      540           if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) substitute ("По артикулу поставщика &1 по фирме &2 для поставщика &3 &4 связан с несколькими товарами .", i-artic-supp, parhost-code, parcli-type, parcli-code) chr(10).
      541           wrn-line = count-all.
      542           run gbl/d-askw.w
