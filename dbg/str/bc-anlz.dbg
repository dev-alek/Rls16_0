       98   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   define variable v-waitfram-action01         as character   no-undo .
      100   define variable v-waitfram-action02         as character   no-undo .
      101   define variable v-waitfram-action03         as character   no-undo .
      102   define variable mWaitFramTextBeg            as character   no-undo.
      103   define variable mWaitFramTextEnd            as character   no-undo.
      104   define variable mWaitFramView               as logical     no-undo.
      105   define variable mWaitProcEvent              as logical     no-undo init yes.
      106   define variable mWaitFramInterval           as integer     no-undo init 1 .
      107   define variable mWaitFramStop               as logical     no-undo.
      108   define variable mWaitFramStopUser           as logical     no-undo.
      109   define variable mWaitFramStopTimeOut        as logical     no-undo.
      110   define variable mWaitFramStartProc          as datetime-tz no-undo.
      111   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      112   define button B-WaitFramStop auto-end-key
      113        label "Стоп"
      114        size 10 by 1 tooltip "Остоновить процесс".
      115   define button B-viewProcInfo
      116        label "Информация"
      117        size 15 by 1 tooltip "Информация о процесс".
      118   define frame waitfram
      119     v-waitfram-action01 format "x(72)" no-label skip
      120     v-waitfram-action02 format "x(72)" no-label skip
      121     v-waitfram-action03 format "x(72)" no-label skip
      122     B-viewProcInfo
      123     B-WaitFramStop at row 4 col 30
      124     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      125     .
      126   define new global shared variable mBatchMode as logical no-undo init ?.
      127   define variable mFramBachModHandle as handle no-undo.
      128   mFramBachModHandle = frame waitfram:handle.
      129   define variable mFameOldVis as logical no-undo.
      130   define variable mVisCUrentVin as logical no-undo.
      131   if session:batch-mode
      132   then
      133      mBatchMode = yes.
      134   if mBatchMode = ? then do:
      135     mVisCUrentVin = current-window:visible.
      136     mFameOldVis = mFramBachModHandle:visible.
      137     mFramBachModHandle:visible  = yes.
      138     mBatchMode = mFramBachModHandle:visible ne yes.
      139     mFramBachModHandle:visible = mFameOldVis.
      140     current-window:visible = mVisCUrentVin.
      141   end.
      142    if  log-manager:logfile-name ne ?
      143     then DO:
      144         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      145         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      146         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      147     end.
      148   on choose of B-WaitFramStop in frame waitfram
      149   do:
      150     mWaitFramStop = yes.
      151     mWaitFramStopUser = yes.
      152   end.
      153   function waitfram-check-timeout returns logical():
      154      define variable vtime as int64 no-undo.
      155      if mWaitFramStopTimeOut
      156      then
      157         return yes.
      158      vtime = ( now - mWaitFramStartProc ) / 1000 .
      159      if     mWaitFramTimeOut ne ?
      160         and mWaitFramTimeOut ne 0
      161         and mWaitFramTimeOut lt vtime
      162      then do:
      163         mWaitFramStopTimeOut = yes.
      164      end.
      165      return mWaitFramStopTimeOut.
      166   end.
      167   procedure waitfram-hide :
      168     if not session:batch-mode
      169     then do
      170     on error undo, return error return-value
      171     :
      172       pause 0 before-hide .
      173       if not mBatchMode then
      174         hide frame waitfram .
      175     end.
      176   end procedure.
      177   procedure waitfram-show :
      178     define input  parameter p-message as character no-undo .
      179     define variable v-left-margin as integer   no-undo .
      180     if not session:batch-mode
      181     then do
      182     on error undo, return error return-value
      183     :
      184       if length(p-message) <= 70 then do:
      185         assign
      186           v-left-margin = integer((70 - length(p-message)) / 2)
      187         .
      188         assign
      189           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      190         .
      191         assign
      192           v-waitfram-action01 = " "
      193           v-waitfram-action02 = " "
      194                                    + fill(" ", v-left-margin)
      195                                    + p-message
      196           v-waitfram-action03 = " "
      197         .
      198       end.
      199       else do:
      200         define variable vRindex1 as integer no-undo.
      201         define variable vRindex2 as integer no-undo.
      202         vRindex1 = r-index(p-message," ",70).
      203         if vRindex1 = 0
      204         then
      205            vRindex1 = 70.
      206         if length(p-message)  <= vRindex1 + 70 then do:
      207           assign
      208             v-waitfram-action01 = " "
      209             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      210             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      211           .
      212         end.
      213         else do:
      214           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      215           if vRindex2 <= vRindex1
      216           then
      217              vRindex2 = vRindex1 + 70.
      218           assign
      219             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      220             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      221             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      222           .
      223         end.
      224       end.
      225       B-viewProcInfo:visible   in frame waitfram = no.
      226       B-viewProcInfo:sensitive in frame waitfram = no.
      227       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      228       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      229       if  (   mWaitFramView
      230          or  mWaitProcEvent)
      231          and not mBatchMode
      232       then
      233          display
      234             v-waitfram-action01 skip
      235             v-waitfram-action02 skip
      236             v-waitfram-action03 skip
      237          with frame waitfram .
      238     end.
      239   end procedure.
      240      procedure waitfram-show-this:
      241         define input  parameter iInterval as int64 no-undo.
      242         define variable vtime as int64 no-undo.
      243         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      244         mWaitFramInterval = iInterval.
      245         run waitfram-show (substitute("&1&2 &3&4" ,
      246                                       mWaitFramTextBeg ,
      247                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      248                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      249                                       mWaitFramTextEnd
      250                                      )
      251                           ).
      252      end.
      253      procedure WaitFramRunPause:
      254         define input  parameter iInterval as dec no-undo.
      255         define variable vStart  as datetime-tz no-undo.
      256         define variable vend    as datetime-tz no-undo.
      257         define variable vint as int64 no-undo.
      258         define variable vOk as logical no-undo.
      259         vStart = now.
      260         vend   = vStart.
      261         publish "WaitFramPause" (iInterval,output vOk).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and (   vint > 0
      267                 or (    not vOk
      268                     and iInterval eq ?
      269                     )
      270                 )
      271         then
      272            run waitfram-show-this (iInterval).
      273         vend   =  now.
      274         vint = vend - vStart.
      275         vint = iInterval - vint / 1000.
      276         if     not mWaitFramStop
      277            and vint > 0
      278         then do:
      279            run gbl/pause.p (vint * 1000).
      280         end.
      281         if iInterval ne ?
      282         then
      283            publish "WaitFramStop".
      284         waitfram-check-timeout().
      285      end.
      286      procedure WaitFramWaitFor:
      287         define input  parameter iInterval as dec no-undo.
      288         assign
      289            mWaitFramStartProc   = now
      290            mWaitFramStopUser    = no
      291            mWaitFramStopTimeOut = no
      292         .
      293         block-wait:
      294         do while not mWaitFramStop:
      295            run WaitFramRunPause (iInterval).
      296            if  waitfram-check-timeout()
      297            then do:
      298               leave block-wait.
      299            end.
      300         end.
      301         run waitfram-hide.
      302      end.
      303   procedure waitfram-join :
      304     define input  parameter p-line-1  as character no-undo .
      305     define input  parameter p-line-2  as character no-undo .
      306     define input  parameter p-line-3  as character no-undo .
      307     define output parameter p-message as character no-undo .
      308     do
      309     on error undo, return error return-value
      310     :
      311       assign
      312         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      313                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      314                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      315       .
      316     end.
      317   end procedure.
      318   function waitfram-join-function returns character
      319     (input p-line-1 as character
      320     ,input p-line-2 as character
      321     ,input p-line-3 as character
      322     ).
      323     define variable v-message as character no-undo .
      324     run waitfram-join in this-procedure
      325       (input  p-line-1
      326       ,input  p-line-2
      327       ,input  p-line-3
      328       ,output v-message
      329       ) .
      330     return v-message .
      331   end function .
