      387   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      388     run mainmenu_getcntxt in parparentproc
      389       (output v-cntxp-db-num
      390       ,output v-cntxp-userid
      391       ,output v-cntxp-level
      392       ,output v-cntxp-curr-host-code
      393       ,output v-cntxp-obj-type
      394       ,output v-cntxp-obj-code
      395       ,output v-cntxp-db-num-obj
      396       ,output v-cntxp-is-admin
      397       ) .
      398     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      399        v-cntxp-obj-code <> 0 then do:
      400   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      401     (input  'is-prt'
      402     ,input  0
      403     ,input  ''
      404     ,input  0
      405     ,input  ''
      406     ,input  ''
      407     ,input  ''
      408     ,input  yes
      409     ,output v-cntxp-conf-par
      410     ,output v-cntxp-par-type
      411     ) no-error .
      412       case v-cntxp-obj-type :
      413         when 'скл':U then do:
      414           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      415           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      416           assign
      417             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      418             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      419             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      420             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      421             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      422             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      423             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      424             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      425             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      426             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      427             v-cntxp-load-time       = bf-cntxp_store.load-time
      428             v-cntxp-holidays        = bf-cntxp_store.holidays
      429             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      430             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      431             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      432             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      433             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      434             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      435             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      436             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      437             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      438             .
      439         end.
      440         when 'маг':U then do:
      441           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      442           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      443           assign
      444             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      445             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
      446             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
      447             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
      448             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      449             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      450             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      451             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      452             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      453             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      454             v-cntxp-load-time       = bf-cntxp_shop.load-time
      455             v-cntxp-holidays        = bf-cntxp_shop.holidays
      456             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
      457             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      458             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
      459             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
      460             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
      461             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
      462             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
      463             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      464             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      465             .
      466         end.
      467       end case.
      468     end.
      469   define buffer gds-bar-code   for ub.bar-code.
      470   define buffer prt-bar-code   for ub.bar-code.
      471   define buffer main-bar-code  for ub.bar-code.
      472   define buffer gds-anlz-bc    for anlz-bc.
      473   define buffer prt-anlz-bc    for anlz-bc.
      474   define buffer parts-bc       for ub.parts.
      475   define buffer gds-prt-parent for ub.gds-prt.
      476   define buffer last-un-bc     for un-bc.
      477   define buffer last-anlz-bc   for anlz-bc.
      478   define buffer units-base     for ub.units.
      479   define buffer bar-code-base  for ub.bar-code.
      480   define buffer gds-prt-base   for ub.gds-prt.
      481   define buffer buf_chk-doc    for ub.chk-doc.
      482   define buffer bar-code for ub.bar-code.
      483   define buffer goods    for ub.goods   .
      484   define buffer units    for ub.units   .
      485   define variable bar-str     as character no-undo.
      486   define variable pl-str      as character no-undo.
      487   define variable qnty-str    as character no-undo.
      488   define variable part-list   as character no-undo init "".
      489   define variable b-c         as integer   no-undo.
      490   define variable rate        as decimal   no-undo.
      491   define variable discnt      as decimal   no-undo.
      492   define variable flagplace   as logical   no-undo.
      493   define variable conf-par    as character no-undo.
      494   define variable par-type    as character no-undo.
      495   define variable i-num       as integer   no-undo.
      496   define variable u-num       as integer   no-undo.
      497   define variable a-num       as integer   no-undo.
      498   define variable varentity   as character no-undo.
      499   define variable varzero-string as logical no-undo.
      500   define stream scan-file.
      501   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      502   define variable varscales-pref as character no-undo .
      503   define variable varpgscales-pref as character no-undo .
      504   define variable varscales-pref-type6 as character no-undo.
      505   varscales-pref  = ?.
      506   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      507     (input  'sclspref':u
      508     ,input  '':u
      509     ,input  '':u
      510     ,input  0
      511     ,input  '':u
      512     ,input  '':u
      513     ,input  '':u
      514     ,input  no
      515     ,output varscales-pref
      516     ,output varscales-pref-type6
      517     ) no-error .
      518   if varscales-pref = ? then do:
      519     assign
      520     varscales-pref = '21,23,25':U.
      521   end.
      522   define variable varpgscales-pref-type6 as character no-undo.
      523   varpgscales-pref  = ?.
      524   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      525     (input  'scpgpref':u
      526     ,input  '':u
      527     ,input  '':u
      528     ,input  0
      529     ,input  '':u
      530     ,input  '':u
      531     ,input  '':u
      532     ,input  no
      533     ,output varpgscales-pref
      534     ,output varpgscales-pref-type6
      535     ) no-error .
      536   if varpgscales-pref = ? then do:
      537     assign
      538     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
      539   end.
      540   def var mess as char no-undo.
      541   procedure check-code:
      542   define input parameter parbar-str AS char no-undo.
      543   define input parameter parprice   like ub.gds-dtl.price-base no-undo.
      544   define input parameter parqnty    as dec no-undo.
      545   define input  parameter parg#doc-prt as logical no-undo.
      546   define input  parameter parscales-pref as character no-undo.
      547   define input  parameter parpgscales-pref as character no-undo.
      548   define output parameter parplace   as log initial no no-undo.
      549   define output parameter parb-c     as int no-undo.
      550   define output parameter parrate    as dec no-undo.
      551   define variable varresult   as character       no-undo.
      552   define variable vartype-bc  as character       no-undo.
      553   define variable varweight   as decimal         no-undo.
      554   def buffer b-bar-code for ub.bar-code.
      555   ASSIGN mess = " Код: " + parbar-str + " количество: " + string (parqnty) + " ".
      556   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      557   (
      558    input  parparentproc
      559   ,input  parbar-str
      560   ,input  parprice
      561   ,input  v-cntxt-obj-type
      562   ,input  v-cntxt-obj-code
      563   ,input  yes
      564   ,input  no
      565   ,input  parscales-pref
      566   ,input  parpgscales-pref
      567   ,output varresult
      568   ,output vartype-bc
      569   ,output varweight
      570   ,buffer ub.bar-code
      571   ,buffer ub.prod-bc
      572   ,buffer ub.place
      573   ) no-error.
      574   if error-status:error then do:
      575     return error "Ошибка при разборе бар-кода: " + parbar-str.
      576   end.
      577     assign
      578       un-bc.type-bc = vartype-bc.
      579     if varresult = "place" then do:
      580       assign
      581         un-bc.pl-name = place.pl-name
      582         un-bc.loc1    = place.loc1
      583         un-bc.loc2    = place.loc2
      584         un-bc.loc3    = place.loc3
      585         un-bc.loc4    = place.loc4 .
      586     end.
      587   if not available bar-code THEN DO:
      588      if add-sens = ? and available place
      589      then DO: parPlace = YES. RETURN. END.
      590      ELSE RETURN ERROR "Товар отсутствует в базе данных.".
      591   END.
      592   else do:
      593       assign  parb-c  = bar-code.b-code
      594               parrate = bar-code.cli-base-rate.
      595       find ub.goods where ub.goods.gds-code  = ub.bar-code.gds-code no-lock.
      596          FIND FIRST ub.units WHERE ub.units.unit-name = ub.goods.unit-base NO-LOCK.
      597          FIND FIRST ub.clients WHERE ub.clients.obj-type = ub.goods.prod-type AND
      598                                   ub.clients.obj-code = ub.goods.prod-code  NO-LOCK.
      599          ASSIGN un-bc.artic      = ub.goods.artic
      600                 un-bc.prod-type  = ub.goods.prod-type
      601                 un-bc.prod-code  = ub.goods.prod-code
      602                 un-bc.prod-name  = ub.clients.obj-name
      603                 un-bc.gds-name   = ub.goods.gds-name
      604                 un-bc.unit-base  = ub.goods.unit-base
      605                 un-bc.units-type = ub.units.type.
      606       find ub.gds-prt where ub.gds-prt.upper-code = ub.goods.prt-root no-lock.
      607       ASSIGN mess = mess + "Артикул: " + ub.goods.artic + " производитель: " + ub.goods.prod-type + " " + string (ub.goods.prod-code) + " " + ub.goods.gds-name + chr(10) .
      608       if parg#doc-prt and gds-prt.node-name <> '_Пустая шкала':U and
      609          can-find (first gds-prt where gds-prt.upper-code = bar-code.node-code) then
      610          RETURN ERROR "Ссылка не на подробный признак.".
      611       if not parg#doc-prt and gds-prt.node-name <> '_Пустая шкала':U and
      612            bar-code.node-code <> gds-prt.node-code then do:
      613         find b-bar-code where recid (b-bar-code) = recid (bar-code) no-lock.
      614         find bar-code where bar-code.gds-code  = b-bar-code.gds-code
      615                         and bar-code.node-code = gds-prt.node-code
      616                         and bar-code.in-code   = b-bar-code.in-code
      617                         and bar-code.part-code = b-bar-code.part-code
      618                         and bar-code.unit-cli  = ub.goods.unit-base
      619                           no-lock.
      620         parb-c = bar-code.b-code.
      621         RETURN "Ссылка на подробный или узловой признак. Заменяем на код: " + STRING(bar-code.b-code).
      622       end.
      623   end.
      624   RETURN.
      625   END PROCEDURE.
      626   run delete-in-bc.
      627   if parworkmode = "code-add" or
      628      parworkmode = "code-update"
      629      then do:
      630      create   in-bc.
      631      assign   in-bc.bar-str = parinformation
      632               in-bc.nm      = 1.
      633      validate in-bc.
      634   end.
      635   if parworkmode = "chk-doc"
      636   then do:
      637      run waitfram-show in this-procedure ("Разбор строк чека.").
      638   end.
      639   else do:
      640     run waitfram-show in this-procedure ("Разбор сканерного файла.").
      641   end.
      642   if parworkmode = "table" then do:
      643      run loadTempTable in this-procedure no-error.
      644      if error-status:error then
      645      do:
      646         message return-value view-as alert-box error buttons ok.
      647           run waitfram-hide in this-procedure.
      648         return error.
      649      end.
      650   end.
      651   if parworkmode = "file" then do:
      652      if search(parinformation) = ? then do:
      653         message "Не найден файл: " parinformation " с бар-кодами для анализа."
      654         view-as alert-box error buttons ok.
      655         run waitfram-hide in this-procedure.
      656         return error.
      657      end.
      658      run gbl/filnline.p (input parinformation, output varzero-string).
      659      if varzero-string <> true then do:
      660        message return-value skip
      661                "Файл " search(parinformation) view-as alert-box.
      662        return error.
      663      end.
      664      run loadnewfile in this-procedure.
      665   end.
      666   if parworkmode = "chk-doc"
      667   then do:
      668     find first buf_chk-doc exclusive-lock where
      669               buf_chk-doc.doc-code = entry(1, parinformation) no-error.
      670     if not available buf_chk-doc then do:
      671         message "Не найден чек: " parinformation " с бар-кодами для анализа."
      672         view-as alert-box error buttons ok.
      673         run waitfram-hide in this-procedure.
      674         return error.
      675      end.
      676      for each un-bc:
      677        assign un-bc.file-qnty = 0.
      678      end.
      679      run loadnewcheck in this-procedure.
      680   end.
      681   i-num = 0.
      682   if parworkmode <> "undo" then do:
      683      if parworkmode = "chk-doc"then do:
      684      end.
      685      else do:
      686        for each un-bc:
      687           assign un-bc.file-qnty = 0.
      688        end.
      689      end.
      690      for each in-bc where in-bc.bar-str <> "":U
      691      :
      692         run unitedcode.
      693      end.
      694      if parworkmode = "code-update" then do:
      695         find last in-bc.
      696         find first un-bc where un-bc.bar-code = in-bc.bar-code no-error.
      697         if available un-bc then run add-un-bc.
      698      end.
      699      else
      700      for each un-bc where un-bc.file-qnty > 0 use-index file-qnty by un-bc.nm:
      701          run add-un-bc.
      702      end.
      703      for each anlz-bc:
      704       find first bar-code     where bar-code.b-code         = anlz-bc.b-c       no-lock.
      705       find first goods        where goods.gds-code          = bar-code.gds-code no-lock.
      706       find first units        where units.unit-name         = bar-code.unit-cli no-lock.
      707       find first units-base   where units-base.unit-name    = goods.unit-base   no-lock.
      708       find first gds-prt-base where gds-prt-base.upper-code = goods.prt-root    no-lock.
      709       find first bar-code-base where bar-code-base.gds-code  = goods.gds-code         and
      710                                      bar-code-base.node-code = gds-prt-base.node-code and
      711                                      bar-code-base.part-code = ""                     and
      712                                      bar-code-base.in-code   = ""                     and
      713                                      bar-code-base.unit-cli  = goods.unit-base        no-lock.
      714       find first main-bar-code where main-bar-code.gds-code  = bar-code.gds-code  and
      715                                      main-bar-code.node-code = bar-code.node-code and
      716                                      main-bar-code.part-code = ""                 and
      717                                      main-bar-code.in-code   = ""                 and
      718                                      main-bar-code.unit-cli  = goods.unit-base    no-lock.
      719       find gds-prt where gds-prt.node-code = bar-code.node-code no-lock.
      720       if not can-find(first gds-prt-parent where gds-prt-parent.node-code = gds-prt.upper-code no-lock) then
      721          assign varentity = 'ТОВАР':U.
      722       else assign varentity = 'ПРИЗНАК':U.
      723       if bar-code.in-code <> "" then do:
      724          find first parts-bc where parts-bc.artic     = goods.artic
      725                                and parts-bc.prod-type = goods.prod-type
      726                                and parts-bc.prod-code = goods.prod-code
      727                                and parts-bc.in-code   = bar-code.in-code
      728                                and parts-bc.part-code = bar-code.part-code no-lock no-error.
      729       end.
      730       if available parts-bc then assign varentity = 'ПАРТИЯ':U.
      731       for each un-bc where un-bc.b-c = anlz-bc.b-c:
      732           if un-bc.entity <> 'СКЛАДСКОЕ МЕСТО':U then un-bc.entity = varentity.
      733            assign un-bc.f-name         = gds-prt.f-name
      734                   un-bc.in-code        = if available parts-bc then parts-bc.in-code   else ?
      735                   un-bc.fact-date      = if available parts-bc then parts-bc.fact-date else ?
      736                   un-bc.part-code      = if available parts-bc then parts-bc.part-code else ?
      737                   un-bc.unit-name      = units.unit-name
      738                   un-bc.long-name      = units.long-name
      739                   un-bc.b-c-base       = bar-code-base.b-code
      740                   un-bc.unit-name-base = units-base.unit-name
      741                   un-bc.long-name-base = units-base.long-name.
      742       end.
      743       find first main-bc where main-bc.b-c = main-bar-code.b-code no-error.
      744       if not available main-bc then do:
      745          create main-bc.
      746          assign main-bc.nm     = anlz-bc.nm
      747                 main-bc.b-c    = main-bar-code.b-code
      748                 main-bc.scn-pl = anlz-bc.scn-pl
      749                 main-bc.rez    = anlz-bc.rez.
      750       end.
      751       assign main-bc.scn-qnty = main-bc.scn-qnty + anlz-bc.scn-qnty
      752              main-bc.des      = main-bc.des + " | " + anlz-bc.des.
      753      end.
      754   end.
      755   else run undo-qnty.
      756   run waitfram-hide in this-procedure.
      757   procedure read-str.
      758     bar-str = trim (bar-str).
      759     if bar-str = "" then return error.
      760     if substr (bar-str, 1, 1) < "0" or substr (bar-str, 1, 1) > "9" then
      761       if substr (bar-str, 1, 4) = "data" then bar-str = entry (2, bar-str, ":").
      762       else return error "Cтрока начинается не с цифры и не со слова date.".
      763     if num-entries (bar-str) > 1 then qnty-str = trim (entry (2, bar-str)).
      764     else qnty-str = "1".
      765     if num-entries (bar-str) > 2 then pl-str = trim (entry (3, bar-str)).
      766     else pl-str = "".
      767     bar-str = trim (entry (1, bar-str)).
      768   end procedure.
      769   procedure loadTempTable:
      770     define variable vTime   as integer   no-undo.
      771     define variable vWhere  as character no-undo.
      772     define variable hTable  as handle  no-undo.
      773     define variable hBuffer as handle  no-undo.
      774     define variable hQuery  as handle  no-undo.
      775     assign
      776       vTime = TIME
      777       hTable = handle(parinformation)
      778       vWhere = substitute("FOR EACH &1", hTable:name)
      779     no-error.
      780     if error-status:error or not valid-handle(hTable) then
      781       return error "Ошибка при чтении таблицы строк документа".
      782     create buffer hBuffer for table hTable.
      783     create query  hQuery.
      784     hQuery:set-buffers(hBuffer).
      785     hQuery:query-prepare(vWhere).
      786     hQuery:query-open().
      787     hQuery:get-first().
      788     repeat while not hQuery:query-off-end:
      789       assign
      790         bar-str = ""
      791         i-num = i-num + 1
      792       .
      793       run waitfram-show in this-procedure (substitute("Разбор записей с бар-кодами. Всего считано &1. Время &2.", i-num, string (time - vTime, "hh:mm:ss"))).
      794       create in-bc.
      795       assign
      796         in-bc.nm       = i-num
      797         in-bc.bar-str  = substitute(
      798                            "&1,&2",
      799                            hBuffer:buffer-field("b-code"):buffer-value,
      800                            hBuffer:buffer-field("fact-qnty"):buffer-value)
      801       .
      802       hQuery:GET-NEXT().
      803     end.
      804     hQuery:query-close().
      805     delete object hQuery.
      806   end procedure.
      807   procedure loadnewfile:
      808   define variable vartime as integer no-undo.
      809   input stream scan-file from value (parinformation).
      810   assign
      811     vartime = TIME.
      812   repeat:
      813     assign
      814       bar-str = "".
      815     import stream scan-file unformatted bar-str.
      816     i-num = i-num + 1.
      817     run waitfram-show in this-procedure (substitute("Разбор сканерного файла. Всего считано &1. Время &2.", i-num, string (time - vartime, "hh:mm:ss"))).
      818     create in-bc.
      819     assign in-bc.nm       = i-num.
      820            in-bc.bar-str  = bar-str.
      821   end.
      822   end procedure.
      823   procedure loadnewcheck:
      824   define variable vartime as integer no-undo.
      825   define buffer buf_chk-gds for ub.chk-gds.
      826   define variable v-doc-code as character no-undo .
      827   define variable v-line-num as integer no-undo .
      828   define variable qnty-dec as decimal no-undo .
      829   define variable v-chk-gds-type-bc as character no-undo .
      830   assign
      831   vartime = TIME
      832   v-doc-code = entry(1, parinformation)
      833   v-line-num = (if num-entries(parinformation) > 1
      834                 then integer(entry(2, parinformation))
      835                 else 0)
      836   .
      837   for each buf_chk-gds where
      838           buf_chk-gds.doc-code = v-doc-code
      839   by buf_chk-gds.doc-code
      840   by buf_chk-gds.line-num :
      841     run waitfram-show in this-procedure ( substitute("Разбор чека. Всего считано &1. Время &2.", i-num, string (time - vartime, "hh:mm:ss"))).
      842     if buf_chk-gds.is-err = yes then do:
      843       if v-line-num > 0 and buf_chk-gds.line-num <> v-line-num then next.
      844       assign
      845       v-chk-gds-type-bc = if buf_chk-gds.b-code > 0
      846                           then 'b-code':U
      847                           else 'src-code':U
      848       bar-str = (if v-chk-gds-type-bc = 'b-code':U
      849                   then string(buf_chk-gds.b-code)
      850                   else buf_chk-gds.src-code )
      851       qnty-dec = (if v-chk-gds-type-bc = 'b-code':U
      852                   then buf_chk-gds.src-qnty
      853                   else buf_chk-gds.doc-qnty )
      854       pl-str    = '':U
      855       .
      856       find first un-bc where
      857                un-bc.bar-code = bar-str no-error.
      858       if not available un-bc
      859       or add-sens = ?
      860       or (parworkmode = "chk-doc"
      861           and
      862           un-bc.type-bc <> v-chk-gds-type-bc)
      863       then do:
      864         find last last-un-bc no-error.
      865         create un-bc.
      866         assign
      867         un-bc.nm       = if available last-un-bc
      868                          then (last-un-bc.nm + 1)
      869                          else 1
      870         un-bc.bar-code = bar-str
      871         un-bc.type-bc = v-chk-gds-type-bc
      872         .
      873       end.
      874       assign
      875       un-bc.file-qnty = un-bc.file-qnty + qnty-dec
      876       un-bc.scn-qnty  = un-bc.scn-qnty  + qnty-dec
      877       un-bc.scn-pl    = if un-bc.scn-pl <> ""
      878                         and un-bc.scn-pl <> ?
      879                         then un-bc.scn-pl
      880                         else pl-str
      881       .
      882       if buf_chk-gds.b-code > 0 then do:
      883         buf_chk-gds.is-err = no.
      884       end.
      885     end.
      886   end.
      887   end procedure.
      888   procedure unitedcode:
      889   bar-str = in-bc.bar-str.
      890   run read-str no-error.
      891   if error-status:error then do:
      892      assign in-bc.bar-code = ?
      893             in-bc.rez      = "err"
      894             in-bc.err-msg  = return-value.
      895         assign is-err = yes.
      896         next.
      897   end.
      898   find first un-bc where un-bc.bar-code = bar-str no-error.
      899   if not available un-bc or add-sens = ? then do:
      900      find last last-un-bc no-error.
      901      create un-bc.
      902      assign un-bc.nm       = if available last-un-bc then last-un-bc.nm + 1 else 1
      903             un-bc.bar-code = bar-str.
      904             in-bc.des      = in-bc.des + "Код: " + bar-str + " помещен в таблицу с количеством: " + qnty-str + chr(10) .
      905   end.
      906   else assign in-bc.des = in-bc.des + "Код: " + bar-str + " найден в таблице. Количество: " + string(un-bc.scn-qnty) + " увеличено на: " + qnty-str + chr(10) .
      907   assign
      908    un-bc.file-qnty = if parworkmode = "code-update" then un-bc.file-qnty else un-bc.file-qnty + decimal(qnty-str)
      909    un-bc.scn-qnty  = if parworkmode = "code-update" then un-bc.scn-qnty  else un-bc.scn-qnty  + decimal(qnty-str)
      910    un-bc.scn-pl    = if un-bc.scn-pl <> "" and un-bc.scn-pl <> ? then un-bc.scn-pl else pl-str
      911    in-bc.bar-code  = un-bc.bar-code.
      912   return.
      913   end procedure.
      914   procedure delete-in-bc:
      915    for each in-bc:
      916       delete in-bc.
      917    end.
      918   end.
      919   procedure undo-qnty:
      920     for each un-bc:
      921        find first anlz-bc where anlz-bc.b-c = un-bc.b-c no-error.
      922        if available anlz-bc then do:
      923           assign anlz-bc.scn-qnty = anlz-bc.scn-qnty - un-bc.rate * un-bc.file-qnty
      924                  anlz-bc.des      = anlz-bc.des + " Откат кол-во:" + string(un-bc.rate * un-bc.file-qnty) + ".".
      925           if anlz-bc.scn-qnty = 0 then delete anlz-bc.
      926        end.
      927        assign un-bc.scn-qnty = un-bc.scn-qnty - un-bc.file-qnty
      928               un-bc.file-qnty = 0.
      929        if un-bc.scn-qnty = 0 then delete un-bc.
      930     end.
      931   end.
      932   procedure add-un-bc:
      933   define variable v-chk-gds-type-bc as character no-undo .
      934   define buffer buf_chk-gds for ub.chk-gds.
      935     if parworkmode = "chk-doc" then do:
      936       assign
      937       v-chk-gds-type-bc = un-bc.type-bc
      938       un-bc.type-bc = '':U
      939       .
      940     end.
      941     run check-code in this-procedure (
      942                     input un-bc.bar-code
      943                     ,input 0
      944                     ,input un-bc.scn-qnty
      945                     ,input ?
      946                     ,input varscales-pref
      947                     ,input varpgscales-pref
      948                     ,output flagplace
      949                     ,output b-c
      950                     ,output rate
      951                     ) no-error.
      952    if error-status:error then do:
      953        assign un-bc.b-c     = ?
      954               un-bc.rez     = "err"
      955               un-bc.err-msg = mess + " " + if return-value <> "" then return-value else "Ошибка из процедуры проверки бар-кода."
      956               un-bc.type-bc = un-bc.type-bc + un-bc.err-msg.
      957           assign is-err = yes.
      958      if parworkmode = "chk-doc"
      959       and v-chk-gds-type-bc = 'b-code' then do:
      960         for each buf_chk-gds where
      961                 buf_chk-gds.doc-code = entry(1, parinformation)
      962             and buf_chk-gds.b-code = integer(un-bc.bar-code)
      963         on error undo, return error:
      964           assign
      965           buf_chk-gds.is-error = yes
      966           .
      967         end.
      968       end.
      969       next.
      970    end.
      971    if parworkmode = "chk-doc"
      972      and v-chk-gds-type-bc = 'src-code' then do:
      973        for each buf_chk-gds where
      974               buf_chk-gds.doc-code = entry(1, parinformation)
      975           and buf_chk-gds.b-code = 0
      976           and buf_chk-gds.src-code = un-bc.bar-code
      977       on error undo, return error:
      978         assign
      979         buf_chk-gds.is-error = no
      980         .
      981        end.
      982      end.
      983    find first anlz-bc where anlz-bc.b-c = b-c no-error.
      984    if not available anlz-bc or add-sens = ? then do:
      985       find last last-anlz-bc no-error.
      986       create anlz-bc.
      987       assign anlz-bc.nm  = if available last-anlz-bc then last-anlz-bc.nm + 1 else 1
      988              anlz-bc.b-c = b-c
      989              anlz-bc.rez = if flagplace = yes then "place" else "" .
      990    end.
      991    assign anlz-bc.scn-qnty = anlz-bc.scn-qnty + rate * un-bc.file-qnty
      992           anlz-bc.scn-pl   = if anlz-bc.scn-pl = "" or anlz-bc.scn-pl = ? then un-bc.scn-pl else anlz-bc.scn-pl
      993           anlz-bc.des      = anlz-bc.des + mess
      994           un-bc.des        = mess
      995           un-bc.b-c        = b-c
      996           un-bc.rate       = rate.
      997    find first bar-code where bar-code.b-code = b-c no-lock.
      998    if bar-code.in-code <> "" then do:
      999       for each gds-bar-code where gds-bar-code.gds-code  = bar-code.gds-code  and
     1000                                   gds-bar-code.in-code   = "" no-lock,
     1001           first gds-anlz-bc where gds-anlz-bc.b-c = gds-bar-code.b-code
     1002           :
     1003           assign gds-anlz-bc.rez = "wrn"
     1004                  gds-anlz-bc.err-msg = gds-anlz-bc.err-msg +
     1005                  "По данному бар-коду партии есть товар в данном файле. При инвентаризации с заменой возможны проблемы.".
     1006           leave.
     1007       end.
     1008    end.
     1009    else do:
     1010       for each prt-bar-code where prt-bar-code.gds-code  =  bar-code.gds-code  and
     1011                                   prt-bar-code.in-code  <>  ""                 use-index prt-parts
     1012                                   no-lock,
     1013          first prt-anlz-bc where prt-anlz-bc.b-c = prt-bar-code.b-code
     1014          :
     1015          assign anlz-bc.rez = "wrn"
     1016                 anlz-bc.err-msg = anlz-bc.err-msg +
     1017                 "По данному товару есть бар-код партии в данном файле. При инвентаризации с заменой возможны проблемы.".
     1018          leave.
     1019       end.
     1020    end.
     1021   end procedure.
