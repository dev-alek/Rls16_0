        1   define input parameter ParParentProc  as widget-handle no-undo.
        2   define input parameter par-host-code  like ub.clients.obj-code no-undo.
        3   define input parameter par-list-trn   as character no-undo .
        4   define input parameter p-mode         as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Генерация финансовых обязательств и платежей".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define new global shared variable g#language as character no-undo .
      111   if g#language <> '' and g#language <> 'rus':U then do:
      112     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      113   end.
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   procedure cur-time :
      116      define output parameter p-today as date      no-undo .
      117      define output parameter p-time  as integer   no-undo .
      118     do
      119     on error undo, return error
      120     :
      121       define variable v-date1 as date      no-undo .
      122       define variable v-date2 as date      no-undo .
      123       define variable v-time  as integer   no-undo .
      124       assign
      125         v-date1 = today
      126         v-time  = time
      127         v-date2 = today
      128       .
      129       if v-date1 <> v-date2
      130       then do:
      131         assign
      132           v-date1 = today
      133           v-time  = v-time
      134         .
      135       end.
      136       assign
      137         p-today = v-date1
      138         p-time  = v-time
      139       .
      140     end.
      141   end.
      142   function cur-time-date returns character
      143   :
      144     return string(today, '99/99/9999':U) .
      145   end.
      146   function cur-time-mjd returns decimal
      147   :
      148     define variable v-date as date      no-undo .
      149     define variable v-time as integer   no-undo .
      150     run cur-time in this-procedure
      151       (output v-date
      152       ,output v-time
      153       ) .
      154     return integer(v-date) - 2400002 + (v-time / 86400) .
      155   end.
      156   function cur-time-get-ending-index returns integer
      157   (input p-number as integer
      158   )
      159   :
      160     if p-number < 0
      161     or p-number = ?
      162     then do:
      163       return 1 .
      164     end.
      165     define variable v-rest as integer   no-undo .
      166     assign
      167       p-number = p-number modulo 100
      168     .
      169     if p-number < 20
      170     then do:
      171       assign
      172         v-rest = p-number
      173       .
      174     end.
      175     else do:
      176       assign
      177         v-rest = p-number modulo 10
      178       .
      179     end.
      180     case v-rest :
      181       when 1
      182       then do:
      183         return 2 .
      184       end.
      185       when 2 or
      186       when 3 or
      187       when 4
      188       then do:
      189         return 3 .
      190       end.
      191       otherwise do:
      192         return 1 .
      193       end.
      194     end case .
      195   end.
      196   procedure cur-time-mjd-to-date :
      197      define input  parameter i-mjd-diff as decimal no-undo.
      198      define output parameter o-Date     as date    no-undo.
      199      define output parameter o-Time     as integer no-undo.
      200      define variable v-day-number as integer   no-undo .
      201      if    i-mjd-diff < 0
      202         or i-mjd-diff = ?
      203      then do:
      204         return "?" .
      205      end.
      206      assign
      207         v-day-number = truncate(i-mjd-diff,0).
      208         o-Date = date(v-day-number + 2400002).
      209         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      210     .
      211   end.
      212   function cur-time-mjd-to-string returns character
      213   (input p-mjd-diff as decimal
      214   )
      215   :
      216     define variable v-day-number as integer   no-undo .
      217     define variable v-seconds    as integer   no-undo .
      218     define variable v-hour       as integer   no-undo .
      219     define variable v-min        as integer   no-undo .
      220     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      221     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      222     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      223     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      224     if p-mjd-diff < 0
      225     or p-mjd-diff = ?
      226     then do:
      227       return "?" .
      228     end.
      229     assign
      230       v-day-number = integer(truncate(p-mjd-diff,0))
      231       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      232     .
      233     if v-seconds > 86400
      234     then do:
      235       assign
      236         v-seconds = 86400 - 1
      237       .
      238     end.
      239     if v-seconds < 0
      240     then do:
      241       assign
      242         v-seconds = 0
      243       .
      244     end.
      245     assign
      246       v-hour = truncate(v-seconds / 3600, 0)
      247     .
      248     assign
      249       v-seconds = v-seconds modulo 3600
      250     .
      251     assign
      252       v-min = truncate(v-seconds / 60, 0)
      253     .
      254     assign
      255       v-seconds = v-seconds modulo 60
      256     .
      257     return
      258         (if v-day-number <> 0
      259           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      260           else ""
      261         )
      262       + (if v-day-number <> 0 or v-hour <> 0
      263           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      264           else ""
      265         )
      266       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      267           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      268           else ""
      269         )
      270       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      271       .
      272   end.
      273   function cur-time-string returns character
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      282   end.
      283   function cur-time-string-sec returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      292   end.
      293   function cur-time-custom  returns character
      294   (input p-prefix as character
      295   ,input p-date-format as character
      296   ,input p-delimiter as character
      297   ,input p-time-format as character
      298   ,input p-suffix as character
      299   )
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return
      308       p-prefix
      309       + string(v-date, p-date-format)
      310       + p-delimiter
      311       + string(v-time, p-time-format)
      312       + p-suffix
      313       .
      314   end.
      315   function cur-time-print  returns character
      316   :
      317     define variable v-date as date      no-undo .
      318     define variable v-time as integer   no-undo .
      319     run cur-time in this-procedure
      320       (output v-date
      321       ,output v-time
      322       ) .
      323     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      324   end.
      325   function cur-time-datetime returns datetime
      326   :
      327     define variable v-char as character no-undo .
      328     define variable v-datetime as datetime no-undo .
      329     v-char = cur-time-string().
      330     v-datetime = datetime(v-char).
      331     return  v-datetime.
      332   end.
      333   function cur-time-string-msec returns character
      334   :
      335     define variable v-date as datetime  no-undo .
      336     v-date = now.
      337     return string(v-date) .
      338   end.
      339   function diff-list returns character (
      340     input parfirst-list  as character,
      341     input parsecond-list as character,
      342     input pardelim       as character).
      343     if pardelim = ""
      344     or pardelim = ?
      345     then do:
      346       assign
      347         pardelim = ","
      348       .
      349     end.
      350     def var ind as integer no-undo .
      351     def var v-elem as character no-undo .
      352     def var v-result-list as character no-undo init "".
      353     def var v-num-parfirst-list as integer no-undo .
      354     assign
      355       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      356     .
      357     do ind = 1 to v-num-parfirst-list
      358     :
      359       assign
      360         v-elem = entry(ind, parfirst-list, pardelim)
      361       .
      362       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      363         assign
      364           v-result-list = v-result-list
      365                         + (if v-result-list > "" then pardelim else "")
      366                         + v-elem
      367         .
      368       end.
      369     end.
      370     return v-result-list .
      371   end function.
      372   function add-list returns character (
      373    input parfirst-list  as character,
      374    input parsecond-list as character,
      375    input pardelim       as character).
      376     if pardelim = ""
      377     or pardelim = ?
      378     then do:
      379       assign
      380         pardelim = ","
      381       .
      382     end.
      383     def var ind as integer no-undo .
      384     def var v-elem as character no-undo .
      385     def var v-result-list as character no-undo init "".
      386     def var v-num-parfirst-list as integer no-undo .
      387     assign
      388       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      389     .
      390     do ind = 1 to v-num-parfirst-list
      391     :
      392       assign
      393         v-elem = entry(ind, parfirst-list, pardelim)
      394       .
      395       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      396         assign
      397           v-result-list = v-result-list
      398                         + (if v-result-list > "" then pardelim else "")
      399                         + v-elem
      400         .
      401       end.
      402     end.
      403     def var v-num-parsecond-list as integer no-undo .
      404     assign
      405       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      406     .
      407     do ind = 1 to v-num-parsecond-list
      408     :
      409       assign
      410         v-elem = entry(ind, parsecond-list, pardelim)
      411       .
      412       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      413         assign
      414           v-result-list = v-result-list
      415                         + (if v-result-list > "" then pardelim else "")
      416                         + v-elem
      417         .
      418       end.
      419     end.
      420     return v-result-list .
      421   end function.
      422   function cross-list returns character (
      423    input parfirst-list  as character,
      424    input parsecond-list as character,
      425    input pardelim       as character).
      426     if pardelim = ""
      427     or pardelim = ?
      428     then do:
      429       assign
      430         pardelim = ","
      431       .
      432     end.
      433     def var ind as integer no-undo .
      434     def var v-elem as character no-undo .
      435     def var v-result-list as character no-undo init "".
      436     def var v-num-parfirst-list as integer no-undo .
      437     assign
      438       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      439     .
      440     do ind = 1 to v-num-parfirst-list
      441     :
      442       assign
      443         v-elem = entry(ind, parfirst-list, pardelim)
      444       .
      445       if lookup(v-elem, v-result-list, pardelim) = 0
      446       and lookup(v-elem, parsecond-list, pardelim) > 0
      447       then do:
      448         assign
      449           v-result-list = v-result-list
      450                         + (if v-result-list > "" then pardelim else "")
      451                         + v-elem
      452         .
      453       end.
      454     end.
      455     return v-result-list .
      456   end function.
      457   function radio-label returns character (
      458    input par-rs-value  as character,
      459    input par-rs-radio-buttons as character)
      460    .
      461    DEFINE variable v-result-label as character no-undo.
      462    assign
      463    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      464                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      465                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      466                             ), par-rs-radio-buttons
      467                           )
      468    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      469    .
      470   return v-result-label.
      471   end function.
      472   function m-radio-label returns character (
      473    input par-rs-value  as character,
      474    input par-rs-radio-buttons as character,
      475    input par-delim as character
      476    )
      477    .
      478    DEFINE variable v-result-label as character no-undo.
      479    assign
      480    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      481                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      482                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      483                             ), par-rs-radio-buttons, par-delim
      484                           )
      485    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      486    .
      487   return v-result-label.
      488   end function.
      489   FUNCTION mixlist returns character
      490   (
      491    input parfirst-list  as character
      492    ,input parsecond-list as character
      493    ,input pardelim       as character
      494    ,input pardelim-result as character ) :
      495     if pardelim = ""
      496     or pardelim = ?
      497     then do:
      498       assign
      499         pardelim = ","
      500       .
      501     end.
      502     def var ind as integer no-undo .
      503     def var v-elem1 as character no-undo .
      504     def var v-elem2 as character no-undo .
      505     def var v-result-list as character no-undo init "".
      506     do ind = 1 to num-entries(parfirst-list, pardelim)
      507     :
      508       assign
      509         v-elem1 = entry(ind, parfirst-list, pardelim)
      510         v-elem2 = entry(ind, parsecond-list, pardelim)
      511       .
      512         assign
      513           v-result-list = v-result-list
      514                         + (if v-result-list > "" then pardelim-result else "")
      515                         + v-elem1 + pardelim-result + v-elem2
      516         .
      517     end.
      518     return v-result-list .
      519   END FUNCTION.
