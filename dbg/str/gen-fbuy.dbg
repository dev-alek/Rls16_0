      548   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      549   function func-get-name-from-ext-type   returns char
      550     ( p-ext-type as character   ,
      551       p-caps     as logical ).
      552   define variable v-ext-name as character no-undo .
      553   run get-name-from-ext-type in this-procedure (
      554       input p-ext-type  ,
      555       input p-caps  ,
      556       output v-ext-name )
      557       no-error .
      558       if error-status :error then do:
      559          assign
      560            v-ext-name = p-ext-type
      561          .
      562       end.
      563    return (v-ext-name) .
      564   end.
      565   procedure get-name-from-ext-type :
      566    do
      567    on error undo, return error return-value
      568    :
      569   define input  parameter p-ext-type as character no-undo .
      570   define input  parameter p-caps     as logical no-undo   .
      571   define output parameter p-ext-name as character no-undo .
      572   define variable v-num as integer no-undo .
      573     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      574       message
      575         vss-include-info3 skip
      576         "Неправильно задано значение входящего параметра! "
      577         "Нет такого типа документов " p-ext-type
      578         view-as alert-box error .
      579         undo, return error .
      580     end.
      581     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      582     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      583     if p-caps  = true then do :
      584        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      585     end .
      586     end.
      587   end procedure.
      588   define new global shared variable g#library  as handle no-undo .
      589   define new global shared variable g#library2 as handle no-undo .
      590   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591     define variable v-cntxt-db-num        as integer   no-undo .
      592     define variable v-cntxt-userid        as character no-undo .
      593     define variable v-cntxt-level         as character no-undo .
      594     define variable v-cntxt-host-code-obj as integer   no-undo .
      595     define variable v-cntxt-obj-type      as character no-undo .
      596     define variable v-cntxt-obj-code      as integer   no-undo .
      597     define variable v-cntxt-db-num-obj    as integer   no-undo .
      598     define variable v-cntxt-is-admin      as logical   no-undo .
      599   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      600     run mainmenu_getcntxt in parparentproc
      601       (output v-cntxt-db-num
      602       ,output v-cntxt-userid
      603       ,output v-cntxt-level
      604       ,output v-cntxt-host-code-obj
      605       ,output v-cntxt-obj-type
      606       ,output v-cntxt-obj-code
      607       ,output v-cntxt-db-num-obj
      608       ,output v-cntxt-is-admin
      609       ) .
      610   define temp-table tt-trn no-undo like ub.trn-doc.
      611   define temp-table tt-ord no-undo like ub.ord-doc.
      612   define temp-table tt-rcv no-undo like ub.ord-doc-rcv.
      613   define temp-table c-tt-trn no-undo like ub.c-trn-doc.
      614   define variable v-type-trn-doc as character no-undo .
      615   DEFINE BUTTON b-exec
      616        LABEL "В&ыполнить"
      617        SIZE 12 BY 1.
      618   DEFINE BUTTON b-exit AUTO-END-KEY
      619        LABEL "&Выход"
      620        SIZE 12 BY 1.
      621   DEFINE BUTTON B-help DEFAULT
      622        LABEL "Помо&щь"
      623        SIZE 12 BY 1
      624        BGCOLOR 8 .
      625   DEFINE VARIABLE res AS CHARACTER
      626        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      627        SIZE 80.38 BY 7.46 NO-UNDO.
      628   DEFINE VARIABLE date-end AS DATE FORMAT "99/99/9999":U
      629        VIEW-AS FILL-IN
      630        SIZE 11.38 BY 1 NO-UNDO.
      631   DEFINE VARIABLE FILL-IN-10 AS CHARACTER FORMAT "X(256)":U INITIAL "Обработать документы по :"
      632         VIEW-AS TEXT
      633        SIZE 26 BY 1 NO-UNDO.
      634   DEFINE VARIABLE FILL-IN-11 AS CHARACTER FORMAT "X(256)":U INITIAL "Формировать:"
      635         VIEW-AS TEXT
      636        SIZE 12.5 BY 1 NO-UNDO.
      637   DEFINE VARIABLE FILL-IN-12 AS CHARACTER FORMAT "X(256)":U INITIAL "Обсчитывать документы:"
      638         VIEW-AS TEXT
      639        SIZE 29.63 BY 1 NO-UNDO.
      640   DEFINE VARIABLE FILL-IN-13 AS CHARACTER FORMAT "X(256)":U INITIAL "Дата ФО:"
      641         VIEW-AS TEXT
      642        SIZE 8.5 BY 1 TOOLTIP "Дата док. для ФО" NO-UNDO.
      643   DEFINE VARIABLE FILL-IN-14 AS CHARACTER FORMAT "X(256)":U INITIAL "Расчет налогов по ставкам:"
      644         VIEW-AS TEXT
      645        SIZE 26 BY 1 NO-UNDO.
      646   DEFINE VARIABLE v-info AS CHARACTER FORMAT "X(256)":U
      647         VIEW-AS TEXT
      648        SIZE 80 BY 1
      649        FGCOLOR 4  NO-UNDO.
      650   DEFINE VARIABLE R-cons AS INTEGER
      651        VIEW-AS RADIO-SET HORIZONTAL EXPAND
      652        RADIO-BUTTONS
      653             "Совокупно", 1,
      654   "Раздельно", 2
      655        SIZE 32 BY 1 TOOLTIP "раздельно - по каждой накладной отдельное ФО" NO-UNDO.
      656   DEFINE VARIABLE R-nalog AS INTEGER
      657        VIEW-AS RADIO-SET HORIZONTAL EXPAND
      658        RADIO-BUTTONS
      659             "Совокупно", 1,
      660   "Раздельно", 2
      661        SIZE 32 BY 1 TOOLTIP "раздельно - по каждой ставке налога отдельное ФО" NO-UNDO.
      662   DEFINE VARIABLE R-trn AS INTEGER
      663        VIEW-AS RADIO-SET VERTICAL
      664        RADIO-BUTTONS
      665             "Предоплата", 1,
      666   "По факту поставки", 2,
      667   "По всем", 3
      668        SIZE 25.5 BY 3.5 TOOLTIP "Генерация по типу" NO-UNDO.
      669   DEFINE VARIABLE RADIO-SET-1 AS INTEGER
      670        VIEW-AS RADIO-SET HORIZONTAL EXPAND
      671        RADIO-BUTTONS
      672             "Сегодня", 1,
      673   "Дата по", 2
      674        SIZE 32 BY 1 TOOLTIP "Дата док. для ФО" NO-UNDO.
      675   DEFINE VARIABLE T-adm AS LOGICAL INITIAL no
      676        LABEL "Не учитывать флаги генерации"
      677        VIEW-AS TOGGLE-BOX
      678        SIZE 38 BY .83 NO-UNDO.
      679   DEFINE FRAME Dialog-Frame
      680        b-exit AT ROW 1 COL 1
      681        b-exec AT ROW 1 COL 13
      682        B-help AT ROW 1 COL 69.5
      683        date-end AT ROW 2.25 COL 26 COLON-ALIGNED NO-LABEL
      684        T-adm AT ROW 2.25 COL 41
      685        R-trn AT ROW 3.5 COL 14 NO-LABEL
      686        R-cons AT ROW 8.96 COL 31 NO-LABEL
      687        R-nalog AT ROW 9.96 COL 31 NO-LABEL
      688        RADIO-SET-1 AT ROW 11 COL 31 NO-LABEL
      689        res AT ROW 13.21 COL 1 NO-LABEL
      690        FILL-IN-10 AT ROW 2.21 COL 1 NO-LABEL
      691        FILL-IN-11 AT ROW 3.25 COL 1 NO-LABEL
      692        FILL-IN-12 AT ROW 8.96 COL 1 NO-LABEL
      693        FILL-IN-14 AT ROW 9.96 COL 1 NO-LABEL
      694        FILL-IN-13 AT ROW 11 COL 1 NO-LABEL
      695        v-info AT ROW 12.21 COL 1 NO-LABEL
      696        SPACE(0.50) SKIP(7.53)
      697       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      698            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      699            TITLE "Генерация финансовых обязательств по покупателям"
      700            CANCEL-BUTTON b-exit.
      701   ASSIGN
      702          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      703          FRAME Dialog-Frame:HIDDEN           = TRUE.
      704   ASSIGN
      705          T-adm:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      706   ON ALT-CTRL-A OF FRAME Dialog-Frame
      707   ANYWHERE DO:
      708     if t-adm :visible = false then do:
      709         view t-adm in frame Dialog-Frame.
      710         t-adm = yes.
      711         enable t-adm with frame Dialog-Frame.
      712         display t-adm with frame Dialog-Frame.
      713     end.
      714     else do:
      715         t-adm = no.
      716         display t-adm with frame Dialog-Frame.
      717         hide t-adm in frame Dialog-Frame.
      718     end.
      719   END.
      720   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      721   DO:
      722     APPLY "END-ERROR":U TO SELF.
      723   END.
      724   ON CHOOSE OF b-exec IN FRAME Dialog-Frame
      725   DO:
      726     assign
      727       date-end R-cons  radio-set-1 r-nalog  t-adm
      728       no-error.
      729     define variable v-calc as integer no-undo .
      730     define buffer buf_trn-doc     for ub.trn-doc.
      731     define buffer buf_ord-doc     for ub.ord-doc.
      732     define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
      733     define buffer buf_c-trn-doc   for ub.c-trn-doc.
      734     define buffer buf_contract    for ub.contract.
      735     for each tt-rcv : delete tt-rcv. end.
      736     for each tt-ord : delete tt-ord. end.
      737     for each tt-trn : delete tt-trn. end.
      738     for each c-tt-trn : delete c-tt-trn. end.
      739   define variable v-1 as integer   no-undo .
      740   v-1 = num-entries(par-list-trn) .
      741     if par-list-trn <> ? then do:
      742        r-trn = ? .
      743       repeat v-calc = 1 to v-1 :
      744             if p-mode = "" then do:
      745               find first buf_trn-doc no-lock where recid(buf_trn-doc) = integer (entry(v-calc,par-list-trn)) no-error .
      746               if available buf_trn-doc then do:
      747                 create tt-trn.
      748                 BUFFER-COPY buf_trn-doc to tt-trn.
      749               end.
      750             end.
      751             if p-mode = "del" then do:
      752               find first buf_c-trn-doc no-lock where recid(buf_c-trn-doc) = integer (entry(v-calc,par-list-trn)) no-error .
      753               if available buf_c-trn-doc then do:
      754                 create c-tt-trn.
      755                 BUFFER-COPY buf_c-trn-doc to c-tt-trn.
      756               end.
      757             end.
      758             if p-mode = "order" then do:
      759               find first buf_ord-doc no-lock where recid(buf_ord-doc) = integer(entry(v-calc,par-list-trn)) no-error .
      760               if available buf_ord-doc then do:
      761                 create tt-ord.
      762                 BUFFER-COPY buf_ord-doc to tt-ord.
      763               end.
      764             end.
      765             if p-mode = "rcv" then do:
      766               find first buf_ord-doc-rcv no-lock where recid(buf_ord-doc-rcv) = integer(entry(v-calc,par-list-trn)) no-error .
      767               if available buf_ord-doc-rcv then do:
      768                 create tt-rcv.
      769                 BUFFER-COPY buf_ord-doc-rcv to tt-rcv.
      770               end.
      771             end.
      772       end.
      773     end.
      774     run update-res no-error .
      775     if error-status :error then
      776     message
      777       vss-workfile vss-revision vss-description skip
      778       error-status :get-message(1) skip
      779       return-value skip
      780       "123"
      781       view-as alert-box error
      782     .
      783   if p-mode = "order" then do:
      784     run str/gen-flo.p (
      785       INPUT parParentProc ,
      786       input par-host-code ,
      787       input date-end   ,
      788       input ?  ,
      789       input R-cons     ,
      790       INPUT r-nalog ,
      791       input table tt-ord ,
      792       input-output res,
      793       input radio-set-1,
      794       INPUT  t-adm ,
      795       INPUT  'при':U
      796       ) no-error .
      797   end.
      798   if p-mode = "" then do:
      799     IF r-trn = 3 or r-trn = 0 or r-trn = ?  THEN DO:
      800         run str/genbfotr.p (
      801             input parParentProc ,
      802             input par-host-code ,
      803             input date-end   ,
      804             input r-trn ,
      805             input r-cons     ,
      806             input r-nalog ,
      807             input table tt-trn ,
      808             input-output res ,
      809             input radio-set-1,
      810             input t-adm
      811             ) no-error .
      812     run str/gen-flo.p (
      813       input parParentProc ,
      814       input par-host-code ,
      815       input date-end   ,
      816       input 1  ,
      817       input R-cons     ,
      818       input r-nalog ,
      819       input table tt-ord ,
      820       input-output res,
      821       input radio-set-1,
      822       input t-adm ,
      823       input 'при':U
      824       ) no-error .
      825     END.
      826     IF r-trn = 1 THEN DO:
      827         run str/genbfotr.p (
      828             input parParentProc ,
      829             input par-host-code ,
      830             input date-end   ,
      831             input r-trn ,
      832             input r-cons     ,
      833             input r-nalog ,
      834             input table tt-trn ,
      835             input-output res ,
      836             input radio-set-1,
      837             input t-adm
      838             ) no-error .
      839         run str/gen-flo.p (
      840           INPUT parParentProc ,
      841           input par-host-code ,
      842           input date-end   ,
      843           input r-trn         ,
      844           input R-cons     ,
      845           INPUT r-nalog ,
      846           input table tt-ord ,
      847           input-output res,
      848           input radio-set-1,
      849           INPUT  t-adm ,
      850           INPUT  'при':U
      851           ) no-error .
      852     END.
      853     IF r-trn = 2 THEN DO:
      854         run str/genbfotr.p (
      855             INPUT parParentProc ,
      856             input par-host-code ,
      857             input date-end   ,
      858             input r-trn  ,
      859             input R-cons     ,
      860             INPUT r-nalog ,
      861             input table tt-trn ,
      862             input-output res ,
      863             input radio-set-1,
      864             INPUT  t-adm
      865             ) no-error .
      866     END.
      867     if error-status :error then res = res + chr(10) + error-status :get-message(1) .
      868   end.
      869   display res with frame Dialog-Frame .
      870   END.
      871   ON ENTRY OF date-end IN FRAME Dialog-Frame
      872   DO:
      873     RADIO-SET-1:RADIO-BUTTONS = "Сегодня,1," +( INPUT date-end ) + ",2 ".
      874   DISPLAY RADIO-SET-1 WITH FRAME Dialog-Frame .
      875   END.
      876   ON LEAVE OF date-end IN FRAME Dialog-Frame
      877   DO:
      878     ASSIGN date-end.
      879     RADIO-SET-1:RADIO-BUTTONS = "Сегодня,1," + STRING(date-end,"99/99/9999") + ",2 ".
      880     DISPLAY RADIO-SET-1 WITH FRAME Dialog-Frame .
      881   END.
      882   ON return OF date-end IN FRAME Dialog-Frame
      883   DO:
      884       run next-focus in this-procedure  (input  date-end:handle ) .
      885     return no-apply .
      886   END.
      887   ON return OF R-cons IN FRAME Dialog-Frame
      888   DO:
      889        run next-focus in this-procedure  (input  R-cons:handle ) .
      890     return no-apply .
      891   END.
      892   ON return OF R-nalog IN FRAME Dialog-Frame
      893   DO:
      894        run next-focus in this-procedure  (input  R-nalog:handle ) .
      895     return no-apply .
      896   END.
      897   ON return OF R-trn IN FRAME Dialog-Frame
      898   DO:
      899     run next-focus in this-procedure  (input  R-trn:handle ) .
      900     return no-apply .
      901   END.
      902   ON return OF RADIO-SET-1 IN FRAME Dialog-Frame
      903   DO:
      904       run next-focus in this-procedure  (input  RADIO-SET-1:handle ) .
      905    return no-apply .
      906   END.
      907   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      908   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      909   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      910   on help of frame Dialog-Frame
      911   do:
      912     run gbl/app_help.p
      913       (input this-procedure :file-name
      914       ,input ''
      915       ,input ?
      916       ) no-error.
      917     if error-status :error then do:
      918       message
      919         "Ошибка при вызове помощи"
      920         error-status :get-message(1)
      921         view-as alert-box .
      922     end.
      923   end.
      924   run minbtn-set in this-procedure .
      925   on choose of b-help in frame Dialog-Frame
      926   do:
      927     apply "help":u to frame Dialog-Frame .
      928   end.
      929   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      930   procedure minbtn-set :
      931       do
      932           on error undo, return error return-value
      933           :
      934           define variable ii              as integer       no-undo .
      935           define variable fh              as widget-handle no-undo .
      936           define variable hh              as widget-handle no-undo .
      937           define variable v-h             as handle        extent 4 no-undo .
      938           define variable v-name-button   as character     no-undo .
      939           define variable v-help-old-x    as decimal       no-undo .
      940           define variable v-help-old-y    as decimal       no-undo .
      941           define variable v-help-old-size as decimal       no-undo .
      942           define variable v-frame-width   as decimal       no-undo .
      943           define variable jj              as integer       no-undo .
      944           do
      945               on error undo, return error
      946               :
      947               assign
      948                   v-frame-width = frame Dialog-Frame:width - 0.3
      949                   fh            = frame Dialog-Frame:first-child
      950                   hh            = fh:first-child
      951                   ii            = 1
      952                   .
      953               do while valid-handle(hh):
      954                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      955                   do:
      956                       case lc(hh:name) :
      957                           when "b-help" then
      958                               do:
      959                                   hh:load-image-up("cmp/b-help.bmp":u) .
      960                                   hh:load-image-down("cmp/b-help.bmp":u) .
      961                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      962                                   hh:TOOLTIP = "Помощь" .
      963                                   v-help-old-x = hh:column .
      964                                   v-help-old-y = hh:row    .
      965                                   v-help-old-size = hh:width .
      966                                   hh:width-chars = 2.5 .
      967                               end.
      968                           when "b-print" then
      969                               do:
      970                                   hh:load-image("cmp/b-print.bmp":u) .
      971                                   hh:TOOLTIP = "Печать" .
      972                                   v-h[ii] = hh:handle .
      973                                   ii = ii + 1 .
      974                                   hh:width-chars = 3 .
      975                               end.
      976                           when "b-history" or
      977                           when "b-hist" then
      978                               do:
      979                                   hh:load-image("cmp/b-hist.bmp":u) .
      980                                   hh:TOOLTIP = "История" .
      981                                   v-h[ii] = hh:handle .
      982                                   ii = ii + 1 .
      983                                   hh:width-chars = 3 .
      984                               end.
      985                           when "b-sch" then
      986                               do:
      987                                   hh:load-image("cmp/b-sch.bmp":u) .
      988                                   hh:TOOLTIP = "Установка Фильтра" .
      989                                   v-h[ii] = hh:handle .
      990                                   ii = ii + 1 .
      991                                   hh:width-chars = 3 .
      992                               end.
      993                           when "b-hist-user" then
      994                               do:
      995                                   hh:load-image("cmp/b-hist.bmp":u) .
      996                                   hh:TOOLTIP = "История пользователя" .
      997                                   ii = ii + 1 .
      998                               end.
      999                       end case.
     1000                   end.
     1001                   hh = hh:next-sibling.
     1002               end.
     1003               b-help:column = v-frame-width - b-help:width-chars.
     1004               jj = 0.
     1005               repeat ii = 4 to 1 by -1 :
     1006                   if valid-handle (v-h[ii] ) then
     1007                   do:
     1008                       jj  = jj + 1 .
     1009                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1010                       v-h[ii]:row    = v-help-old-y .
     1011                   end.
     1012               end.
     1013           end.
     1014       end.
     1015   end procedure.
     1016   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1017   on ' ' of date-end in frame Dialog-Frame
     1018   do:
     1019     if (can-query (self, "sensitive")
     1020        and
     1021        self :sensitive = true
     1022        )
     1023     or (can-query (self, "read-only")
     1024        and
     1025        self :read-only = false
     1026        )
     1027     then do:
     1028       assign
     1029         self :screen-value = ?
     1030       .
     1031     end.
     1032     return no-apply.
     1033   end.
     1034   on delete-character of date-end in frame Dialog-Frame
     1035   do:
     1036     if (can-query (self, "sensitive")
     1037        and
     1038        self :sensitive = true
     1039        )
     1040     or (can-query (self, "read-only")
     1041        and
     1042        self :read-only = false
     1043        )
     1044     then do:
     1045       assign
     1046         self :screen-value = ?
     1047       .
     1048     end.
     1049     return no-apply.
     1050   end.
     1051   on ctrl-d of date-end in frame Dialog-Frame
     1052   do:
     1053     define variable v-curr-sv-date as date no-undo .
     1054     if (can-query (self, "sensitive")
     1055        and
     1056        self :sensitive = true
     1057        )
     1058     or (can-query (self, "read-only")
     1059        and
     1060        self :read-only = false
     1061        )
     1062     then do:
     1063       if self :handle <> focus :handle
     1064       then do:
     1065         apply "entry":u to self .
     1066       end.
     1067       run gbl/getcurdt.p
     1068         (output v-curr-sv-date
     1069         ) .
     1070       assign
     1071         self :screen-value = string(v-curr-sv-date) .
     1072       .
     1073     end.
     1074     return no-apply.
     1075   end.
     1076   on ctrl-b of date-end in frame Dialog-Frame
     1077   do:
     1078     if (can-query (self, "sensitive")
     1079        and
     1080        self :sensitive = true
     1081        )
     1082     or (can-query (self, "read-only")
     1083        and
     1084        self :read-only = false
     1085        )
     1086     then do:
     1087       if self :handle <> focus :handle
     1088       then do:
     1089         apply "entry":u to self .
     1090       end.
     1091       define variable v-curr-sv-date as date no-undo .
     1092       define variable v-new-sv-date  as date no-undo .
     1093       assign
     1094         v-curr-sv-date = date(self :screen-value) no-error
     1095       .
     1096       if v-curr-sv-date = ?
     1097       then do:
     1098         run gbl/getcurdt.p
     1099           (output v-curr-sv-date
     1100           ) .
     1101       end.
     1102       if v-curr-sv-date <> ?
     1103       then do:
     1104         assign
     1105           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1106         .
     1107         assign
     1108           self :screen-value = string(v-new-sv-date) .
     1109         .
     1110       end.
     1111     end.
     1112     return no-apply .
     1113   end.
     1114   on ctrl-e of date-end in frame Dialog-Frame
     1115   do:
     1116     if (can-query (self, "sensitive")
     1117        and
     1118        self :sensitive = true
     1119        )
     1120     or (can-query (self, "read-only")
     1121        and
     1122        self :read-only = false
     1123        )
     1124     then do:
     1125       if self :handle <> focus :handle
     1126       then do:
     1127         apply "entry":u to self .
     1128       end.
     1129       define variable v-curr-sv-date as date no-undo .
     1130       define variable v-new-sv-date  as date no-undo .
     1131       assign
     1132         v-curr-sv-date = date(self :screen-value) no-error
     1133       .
     1134       if v-curr-sv-date = ?
     1135       then do:
     1136         run gbl/getcurdt.p
     1137           (output v-curr-sv-date
     1138           ) .
     1139       end.
     1140       if v-curr-sv-date <> ?
     1141       then do:
     1142         run gbl/lastdate.p
     1143           (input  v-curr-sv-date
     1144           ,output v-new-sv-date
     1145           ).
     1146         assign
     1147           self :screen-value = string(v-new-sv-date) .
     1148         .
     1149       end.
     1150     end.
     1151     return no-apply .
     1152   end.
     1153   on ctrl-f of date-end in frame Dialog-Frame
     1154   do:
     1155     if (can-query (self, "sensitive")
     1156        and
     1157        self :sensitive = true
     1158        )
     1159     or (can-query (self, "read-only")
     1160        and
     1161        self :read-only = false
     1162        )
     1163     then do:
     1164       if self :handle <> focus :handle
     1165       then do:
     1166         apply "entry":u to self .
     1167       end.
     1168       define variable v-ok            as logical   no-undo .
     1169       define variable v-curr-sv-date  as date      no-undo .
     1170       define variable v-description   as character no-undo .
     1171       assign
     1172         v-curr-sv-date = date(self :screen-value) no-error
     1173       .
     1174       if v-curr-sv-date = ?
     1175       then do:
     1176         run gbl/getcurdt.p
     1177           (output v-curr-sv-date
     1178           ) .
     1179       end.
     1180       if v-curr-sv-date <> ?
     1181       then do:
     1182         run gbl/d-inpday.w
     1183           (input ?
     1184           ,input "Выбор даты"
     1185           ,input v-description
     1186           ,input ""
     1187           ,input-output v-curr-sv-date
     1188           ,output v-ok
     1189           ).
     1190         if v-ok = true
     1191         then do:
     1192           assign
     1193             self :screen-value = string(v-curr-sv-date) .
     1194           .
     1195         end.
     1196       end.
     1197     end.
     1198     return no-apply .
     1199   end.
     1200     define MENU m-ed-date9
     1201       MENU-ITEM m-ed-date9-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1202       MENU-ITEM m-ed-date9-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1203       MENU-ITEM m-ed-date9-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1204       MENU-ITEM m-ed-date9-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1205       .
     1206     if date-end :POPUP-MENU in frame Dialog-Frame = ?
     1207     then do:
     1208       ASSIGN
     1209         date-end :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date9 :HANDLE
     1210         date-end :MENU-MOUSE in frame Dialog-Frame = 3
     1211       .
     1212     end.
     1213     define variable v-label-handle9 as handle no-undo .
     1214     assign
     1215       v-label-handle9 = date-end :side-label-handle in frame Dialog-Frame
     1216     .
     1217     if valid-handle (v-label-handle9)
     1218     then do:
     1219       if v-label-handle9 :tooltip = ""
     1220       or v-label-handle9 :tooltip = ?
     1221       then do:
     1222         assign
     1223           v-label-handle9 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1224         .
     1225       end.
     1226     end.
     1227     ON CHOOSE OF MENU-ITEM m-ed-date9-1 in menu m-ed-date9 DO:
     1228       apply "ctrl-b":U to date-end in frame Dialog-Frame .
     1229     END.
     1230     ON CHOOSE OF MENU-ITEM m-ed-date9-2 in menu m-ed-date9 DO:
     1231       apply "ctrl-d":U to date-end in frame Dialog-Frame .
     1232     END.
     1233     ON CHOOSE OF MENU-ITEM m-ed-date9-3 in menu m-ed-date9 DO:
     1234       apply "ctrl-e":U to date-end in frame Dialog-Frame .
     1235     END.
     1236     ON CHOOSE OF MENU-ITEM m-ed-date9-4 in menu m-ed-date9 DO:
     1237       apply "ctrl-f":U to date-end in frame Dialog-Frame .
     1238     END.
     1239   MAIN-BLOCK:
     1240   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1241      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1242   define variable v-right-buyer as logical no-undo .
     1243     v-right-buyer = true .
     1244   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1245   do:
     1246     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1247       (input  v-cntxt-db-num
     1248       ,input  v-cntxt-userid
     1249       ,input  0
     1250       ,input  'actn_fin-buyer':U
     1251       ,input  'firm':U
     1252       ,input  par-host-code
     1253       ,input  ''
     1254       ,input  0
     1255       ,input  0
     1256       ,input  0
     1257       ,input  0
     1258       ,input  true
     1259       ,output v-right-buyer
     1260       )  .
     1261   end.
     1262   if v-right-buyer = false then return .
     1263     date-end = date(cur-time-date()) .
     1264     v-type-trn-doc  =  "ee,es,re,rs".
     1265     if par-list-trn = ? then
     1266        run enable_ui in this-procedure .
     1267     else
     1268        run enable_my in this-procedure .
     1269     WAIT-FOR GO OF FRAME Dialog-Frame focus date-end .
     1270   END.
     1271   RUN disable_UI in this-procedure .
     1272   PROCEDURE disable_UI :
     1273     HIDE FRAME Dialog-Frame.
     1274   END PROCEDURE.
     1275   PROCEDURE enable_my :
     1276    do
     1277    on error undo, return error return-value
     1278    :
     1279     v-info = "Выбрано " + string( num-entries( par-list-trn)  ) + " документов " .
     1280     DISPLAY r-nalog  R-cons res FILL-IN-10 FILL-IN-11 FILL-IN-12 FILL-IN-14 v-info
     1281         WITH FRAME Dialog-Frame.
     1282     ENABLE b-exit b-exec B-help R-cons res r-nalog
     1283         WITH FRAME Dialog-Frame.
     1284     VIEW FRAME Dialog-Frame.
     1285     end.
     1286   END PROCEDURE.
     1287   PROCEDURE enable_UI :
     1288     DISPLAY date-end R-trn R-cons R-nalog RADIO-SET-1 res FILL-IN-10 FILL-IN-11
     1289             FILL-IN-12 FILL-IN-14 FILL-IN-13 v-info
     1290         WITH FRAME Dialog-Frame.
     1291     ENABLE b-exit b-exec B-help date-end R-trn R-cons R-nalog RADIO-SET-1 res
     1292            FILL-IN-13
     1293         WITH FRAME Dialog-Frame.
     1294     VIEW FRAME Dialog-Frame.
     1295   END PROCEDURE.
     1296   PROCEDURE next-focus :
     1297    do
     1298    on error undo, return error return-value
     1299    :
     1300     define input parameter p-widget-handle as handle no-undo .
     1301     define variable l-apply-entry as logical no-undo .
     1302     assign
     1303       l-apply-entry =   true
     1304     .
     1305     do with frame Dialog-Frame :
     1306       if  date-end:handle   = p-widget-handle then do:  if r-trn:sensitive then do:  apply "entry":u to r-trn .   return . end. end.
     1307       if  r-trn:handle  = p-widget-handle then do:              if r-cons:sensitive then do:     apply "entry":u to r-cons .      return . end. end.
     1308       if  r-cons:handle     = p-widget-handle then do:  if r-nalog:sensitive then do:     apply "entry":u to r-nalog .     return . end. end.
     1309       if  r-nalog:handle     = p-widget-handle then do:  if radio-set-1:sensitive then do:     apply "entry":u to radio-set-1 .     return . end. end.
     1310       if  radio-set-1:handle     = p-widget-handle then do:  if b-exec:sensitive then do:     apply "entry":u to b-exec .      return . end. end.
     1311     end.
     1312    end.
     1313   END PROCEDURE.
     1314   PROCEDURE update-res :
     1315    do
     1316    on error undo, return error return-value
     1317    :
     1318    define variable v-count as integer no-undo .
     1319    define variable v-rad as character no-undo .
     1320    assign frame Dialog-Frame
     1321     date-end
     1322     R-cons
     1323     r-nalog
     1324      no-error .
     1325   if not  error-status :error  then do:
     1326     if r-trn:visible = true then do:
     1327        assign frame Dialog-Frame r-trn
     1328        no-error .
     1329     end.
     1330   v-rad = radio-label( string(r-trn) , r-trn:radio-buttons) no-error .
     1331    if v-rad = ? then v-rad = "Указан в договоре заказа".
     1332       res =  "" .
     1333       res = "ВЫБРАНО : " + chr(10) .
     1334       res = res +  substitute("Условие оплаты по договору :   &1 &2" , chr(10) , v-rad ) .
     1335   end.
     1336   else message
     1337     vss-workfile vss-revision vss-description skip
     1338     error-status :get-message(1) skip
     1339     return-value skip
     1340     "Ошибка присвоения"
     1341     view-as alert-box error
     1342   .
     1343   for each tt-trn :
     1344      if lookup( tt-trn.ext-doc-type , v-type-trn-doc) = 0 then do:
     1345         res = res + "неверный тип " + func-get-name-from-ext-type(tt-trn.ext-doc-type,no) + " -   накладную " + tt-trn.doc-code + " пропускаем "  + chr(10) .
     1346      end.
     1347   end.
     1348       display res with frame Dialog-Frame .
     1349     end.
     1350   END PROCEDURE.
