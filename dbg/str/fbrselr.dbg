      501   buf_fbr-doc.creid     = p-userid
      502   buf_fbr-doc.doc-date  = v-today
      503   buf_fbr-doc.doc-type  = 'производство':U
      504   buf_fbr-doc.host-code = v-host-code
      505   buf_fbr-doc.obj-code  = p-obj-code
      506   buf_fbr-doc.obj-type  = p-obj-type
      507   buf_fbr-doc.PS        = "@"
      508   buf_fbr-doc.status_   = 'новый':U
      509   buf_fbr-doc.user-db-num = v-obj-db-num
      510   buf_fbr-doc.user-name   = p-userid
      511   .
      512   run fbrlib_get-default-pay-code in this-procedure (
      513         input buf_fbr-doc.obj-type
      514       , input buf_fbr-doc.obj-code
      515       , output fi-pay-code
      516   ).
      517   buf_fbr-doc.pay-code = fi-pay-code.
      518   p-recid = recid(buf_fbr-doc).
      519   p-fbr-doc-code = buf_fbr-doc.doc-code.
      520   end.
      521   end procedure.
      522   procedure fbrlib_get-default-pay-code :
      523   define input parameter p-obj-type   as character        no-undo.
      524   define input parameter p-obj-code   as integer          no-undo.
      525   define output parameter p-pay-code  as integer          no-undo.
      526   define variable v-host-code as integer no-undo .
      527   define buffer buf_shop          for ub.shop.
      528   define buffer buf_store         for ub.store.
      529   define buffer buf_sysconf       for ub.sysconf.
      530   do
      531   for buf_shop
      532     , buf_store
      533     , buf_sysconf
      534   on error undo, return error
      535   :
      536     case p-obj-type  :
      537       when 'маг':U then do:
      538           find first buf_shop no-lock
      539                 where buf_shop.obj-code = p-obj-code
      540           no-error.
      541           if available buf_shop
      542           then do:
      543               assign
      544                   p-pay-code = buf_shop.fbr-pay
      545               .
      546           end.
      547       end.
      548       when 'скл':U then do:
      549           find first buf_store no-lock
      550                 where buf_store.obj-code = p-obj-code
      551           no-error.
      552           if available buf_store
      553           then do:
      554               assign
      555                   p-pay-code = buf_store.fbr-pay
      556               .
      557           end.
      558       end.
      559     end case.
      560     if p-pay-code = ?
      561     or p-pay-code = 0
      562     then do:
      563   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      564   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      565     (input  p-obj-type
      566     ,input  p-obj-code
      567     ,output v-host-code
      568     )  .
      569         find first buf_sysconf no-lock
      570               where buf_sysconf.host-code = v-host-code
      571         no-error.
      572         if available buf_sysconf
      573         then do:
      574             assign
      575                 p-pay-code = buf_sysconf.fbr-pay
      576             .
      577         end.
      578     end.
      579     if p-pay-code = ?
      580     or p-pay-code = 0
      581     then do:
      582   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
      584     (input  p-obj-type
      585     ,input  p-obj-code
      586     ,output p-pay-code
      587     )  .
      588     end.
      589   end.
      590   end procedure.
      591   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
      592   do
      593   on error undo, return error
      594   :
      595   define input parameter p-fbr-doc-code as character    no-undo.
      596       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
      597       define variable v-gds-name      as character    no-undo.
      598       define buffer buf_fbr-doc               for ub.fbr-doc.
      599       define buffer buf_fbr-line              for ub.fbr-line.
      600       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
      601       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
      602       find first buf_fbr-doc no-lock
      603            where buf_fbr-doc.doc-code = p-fbr-doc-code
      604       .
      605       for each buf_temp_fbrlib_recipe
      606       :
      607           delete buf_temp_fbrlib_recipe.
      608       end.
      609       for each buf_fbr-line no-lock
      610          where buf_fbr-line.doc-code = p-fbr-doc-code
      611       :
      612           find first buf_temp_fbrlib_recipe
      613                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
      614           no-error.
      615           if not available buf_temp_fbrlib_recipe
      616           then do:
      617               create buf_temp_fbrlib_recipe.
      618               assign
      619                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
      620                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
      621               .
      622           end.
      623       end.
      624       for each buf_temp_fbrlib_recipe
      625       :
      626           assign
      627               buf_temp_fbrlib_recipe.count-income                = 0
      628               buf_temp_fbrlib_recipe.qnty-income                 = 0
      629               buf_temp_fbrlib_recipe.sum-income-sale             = 0
      630               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
      631               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
      632               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
      633               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
      634               buf_temp_fbrlib_recipe.count-write-off             = 0
      635               buf_temp_fbrlib_recipe.qnty-write-off              = 0
      636               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
      637               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
      638               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
      639               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
      640               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
      641           .
      642           for each buf_fbr-line no-lock
      643              where buf_fbr-line.doc-code     = p-fbr-doc-code
      644                and buf_fbr-line.trn-type     = 'при':U
      645                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
      646           :
      647               if ( buf_fbr-line.price-base   = ?
      648                   or buf_fbr-line.price-rubl = ?
      649                   or buf_fbr-line.price-base <= 0
      650                   or buf_fbr-line.price-rubl <= 0 )
      651               and buf_fbr-line.fact-qnty <> 0
      652               and buf_fbr-line.rsrv-qnty <> ?
      653               and buf_fbr-doc.is-free    = no
      654               then do:
      655   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      656   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
      657     (input  buf_fbr-line.artic
      658     ,input  buf_fbr-line.prod-type
      659     ,input  buf_fbr-line.prod-code
      660     ,output v-gds-name
      661     ) no-error .
      662                   if error-status :error
      663                   then do:
      664                       assign
      665                           v-gds-name = ""
      666                       .
      667                   end.
      668                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
      669                                                 ,vss-description
      670                                                 ,buf_fbr-doc.doc-code
      671                                                 ,chr(10)
      672                                                 ,buf_fbr-line.recipe-code
      673                                                 ,buf_fbr-line.artic
      674                                                 ,v-gds-name).
      675               end.
      676               assign
      677                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
      678                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
      679                                                                   + buf_fbr-line.fact-qnty
      680                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
      681                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
      682               .
      683               if buf_fbr-line.is-waste = no
      684               then do:
      685                   assign
      686                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
      687                                                                       + buf_fbr-line.price-sum-base
      688                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
      689                                                                       + buf_fbr-line.price-sum-rubl
      690                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
      691                                                                       + buf_fbr-line.price-sum-vat-base
      692                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
      693                                                                       + buf_fbr-line.price-sum-vat-rubl
      694                   .
      695               end.
      696           end.
      697           for each buf_fbr-line no-lock
      698              where buf_fbr-line.doc-code     = p-fbr-doc-code
      699                and buf_fbr-line.trn-type     = 'спи':U
      700                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
      701           :
      702               if ( buf_fbr-line.price-base   = ?
      703                   or buf_fbr-line.price-rubl = ?
      704                   or buf_fbr-line.price-base <= 0
      705                   or buf_fbr-line.price-rubl <= 0 )
      706               and buf_fbr-line.fact-qnty <> 0
      707               and buf_fbr-line.rsrv-qnty <> ?
      708               and buf_fbr-doc.is-free    = no
      709               and buf_fbr-doc.status_    = 'разрешен':U
      710               then do:
      711   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      712   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
      713     (input  buf_fbr-line.artic
      714     ,input  buf_fbr-line.prod-type
      715     ,input  buf_fbr-line.prod-code
      716     ,output v-gds-name
      717     ) no-error .
      718                   if error-status :error
      719                   then do:
      720                       assign
      721                           v-gds-name = ""
      722                       .
      723                   end.
      724                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
      725                                                 ,vss-description
      726                                                 ,buf_fbr-doc.doc-code
      727                                                 ,chr(10)
      728                                                 ,buf_fbr-line.recipe-code
      729                                                 ,buf_fbr-line.artic
      730                                                 ,v-gds-name).
      731               end.
      732               assign
      733                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
      734                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
      735                                                                   + buf_fbr-line.fact-qnty
      736                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
      737                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
      738               .
      739               if buf_fbr-line.is-waste = no
      740               then do:
      741                   assign
      742                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
      743                                                                       + buf_fbr-line.price-sum-base
      744                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
      745                                                                       + buf_fbr-line.price-sum-rubl
      746                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
      747                                                                       + buf_fbr-line.price-sum-vat-base
      748                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
      749                                                                       + buf_fbr-line.price-sum-vat-rubl
      750                   .
      751               end.
      752           end.
      753           if buf_fbr-doc.status_    = 'разрешен':U
      754           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
      755           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
      756           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
      757           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
      758               )
      759           then do:
      760            undo, return error
      761               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
      762                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
      763                           "Сумма в баз.вал.&4&5&4&4&6&2" +
      764                           "Сумма в &9.&4&7&4&4&8&2"
      765                          , buf_fbr-doc.doc-code
      766                          , chr(10)
      767                          , buf_temp_fbrlib_recipe.recipe-code
      768                          , chr(9)
      769                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
      770                          , buf_temp_fbrlib_recipe.sum-income-cost-base
      771                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
      772                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
      773                          , "руб"
      774                          )
      775              +
      776              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
      777                         "НДС в &7.&1&5&1&1&6&4"
      778                        ,  chr(9)
      779                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
      780                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
      781                        ,chr(10)
      782                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
      783                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
      784                        ,"руб"
      785                        )       .
      786           end.
      787       end.
      788   end.
      789   end procedure.
      790   procedure fbrlib-fill-sum-fbr-doc :
      791   do
      792   on error undo, return error
      793   :
      794   define input parameter p-fbr-doc-recid  as recid        no-undo.
      795   define input parameter p-mode           as character    no-undo.
      796       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
      797       define buffer buf_fbr-doc           for ub.fbr-doc.
      798       define buffer buf_fbr-line          for ub.fbr-line.
      799       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
      800       define variable v-in-count          as integer       no-undo.
      801       define variable v-out-count         as integer       no-undo.
      802       find first buf_fbr-doc exclusive-lock
      803            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
      804       .
      805       find first buf_temp_fbrlib_recipe no-error.
      806       if not available buf_temp_fbrlib_recipe
      807       then do:
      808           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
      809               input buf_fbr-doc.doc-code
      810           ) no-error.
      811           if error-status :error
      812           then do:
      813               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
      814                                              , vss-description
      815                                              , chr(10)
      816                                              , error-status:get-message(1)
      817                                              , return-value ).
      818           end.
      819       end.
      820       assign
      821           v-in-count                  = 0
      822           buf_fbr-doc.in-qnty         = 0
      823           buf_fbr-doc.in-sale         = 0
      824           buf_fbr-doc.in-base         = 0
      825           buf_fbr-doc.in-rubl         = 0
      826           buf_fbr-doc.in-vat-base     = 0
      827           buf_fbr-doc.in-vat-rubl     = 0
      828           v-out-count                 = 0
      829           buf_fbr-doc.out-qnty        = 0
      830           buf_fbr-doc.out-sale        = 0
      831           buf_fbr-doc.out-base        = 0
      832           buf_fbr-doc.out-rubl        = 0
      833           buf_fbr-doc.out-vat-base    = 0
      834           buf_fbr-doc.out-vat-rubl    = 0
      835       .
      836       for each buf_temp_fbrlib_recipe
      837       :
      838           assign
      839               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
      840               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
      841               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
      842               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
      843               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
      844               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
      845               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
      846               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
      847               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
      848               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
      849               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
      850               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
      851               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
      852               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
      853           .
      854       end.
      855       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
      856       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
      857       or p-mode <> 'факт':U
      858       then do:
      859           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
      860           then do:
      861               assign
      862                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
      863                                   + string( v-out-count, ">>>,>>9" )
      864                                   + chr(10) + "Строк исходных товаров : "
      865                                   + string( v-in-count, ">>>,>>9" )
      866               .
      867           end.
      868       end.
      869       else do:
      870         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
      871                                       "Сумма списанных товаров в &3 - &4&2" +
      872                                       "Сумма оприходованных товаров в &3 - &5&2" +
      873                                       "Сумма оприходованных товаров в &3 - &6&2" +
      874                                       "Сумма списанных товаров в баз.вал. - &7&2" +
      875                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
      876                                       , buf_fbr-doc.doc-code
      877                                       , chr(10)
      878                                       , "рублях"
      879                                       , round( buf_fbr-doc.out-rubl, 2 )
      880                                       , round( buf_fbr-doc.in-rubl,  2 )
      881                                       , round( buf_fbr-doc.in-rubl,  2 )
      882                                       , round( buf_fbr-doc.out-base, 2 )
      883                                       , round( buf_fbr-doc.in-base,  2 )).
      884       end.
      885   end.
      886   end procedure.
      887   procedure fbrlib-calc-prices :
      888   do
      889   on error undo, return error
      890   :
      891   define input parameter p-fbr-line-recid as recid        no-undo.
      892   define input parameter p-price-obj-type as character    no-undo.
      893   define input parameter p-price-obj-code as integer      no-undo.
      894   define output parameter p-current-price as decimal      no-undo.
      895       define variable v-void          as decimal       no-undo.
      896       define variable v-void-char     as character     no-undo.
      897       define variable v-gds-code      as integer       no-undo.
      898       define variable v-b-code        as integer       no-undo.
      899       define buffer buf_fbr-doc   for ub.fbr-doc.
      900       define buffer buf_fbr-line  for ub.fbr-line.
      901       define buffer buf_gds-prt   for ub.gds-prt.
      902       define buffer buf_bar-code  for ub.bar-code.
      903       find first buf_fbr-line no-lock
      904           where recid( buf_fbr-line ) = p-fbr-line-recid
      905       .
      906   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      907   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      908     (input  buf_fbr-line.artic
      909     ,input  buf_fbr-line.prod-type
      910     ,input  buf_fbr-line.prod-code
      911     ,output v-gds-code
      912     ) no-error .
      913       if error-status :error
      914       then do:
      915         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
      916                                         ,vss-workfile
      917                                         ,vss-revision
      918                                         ,vss-description
      919                                         ,chr(10)
      920                                         , error-status:get-message(1)
      921                                         , return-value
      922                                         , buf_fbr-line.artic
      923                                         ).
      924       end.
      925   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      926     (input  v-gds-code
      927     ,input  ?
      928     ,output v-b-code
      929     ) no-error .
      930       if error-status :error
      931       then do:
      932         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
      933                                         ,vss-workfile
      934                                         ,vss-revision
      935                                         ,vss-description
      936                                         ,chr(10)
      937                                         , error-status:get-message(1)
      938                                         , return-value
      939                                         , v-gds-code
      940                                         ).
      941       end.
      942       if buf_fbr-line.is-calc = no
      943       then do:
      944   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      945   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      946     (input  p-price-obj-type
      947     ,input  p-price-obj-code
      948     ,input  v-b-code
      949     ,input  0
      950     ,input  0
      951     ,output v-void-char
      952     ,output p-current-price
      953     ,output v-void
      954     ,output v-void
      955     ) no-error .
      956           if error-status :error
      957           then do:
      958             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
      959                                             ,vss-workfile
      960                                             ,vss-revision
      961                                             ,vss-description
      962                                             ,chr(10)
      963                                             , error-status:get-message(1)
      964                                             , return-value
      965                                             , v-gds-code
      966                                             ).
      967           end.
      968       end.
      969       else do:
      970           assign
      971               p-current-price = buf_fbr-line.price-sale
      972           .
      973       end.
      974   end.
      975   end procedure.
      976   procedure fbrlib-put-in-order-recipe :
      977   do
      978   on error undo, return error
      979   :
      980   define input parameter p-fbr-doc-doc-code   as character    no-undo.
      981       define variable v-recipe-counter    as integer          no-undo.
      982       define variable v-recipe-amount     as integer init 0   no-undo.
      983       define variable v-child-counter     as integer          no-undo.
      984       define variable v-is-call-cycle     as logical          no-undo.
      985       define variable v-str as character     no-undo.
      986       define buffer buf_in_fbr-line       for ub.fbr-line.
      987       define buffer buf_dress_fbr-line    for ub.fbr-line.
      988       define buffer buf_fbr-line          for ub.fbr-line.
      989       define buffer buf_recipe-gds        for ub.recipe-gds.
      990       define buffer buf_recipe            for ub.recipe.
      991       for each temp_recipe-childs-qnty
      992       :
      993           delete temp_recipe-childs-qnty.
      994       end.
      995       for each temp_recipe-childs
      996       :
      997           delete temp_recipe-childs.
      998       end.
      999       for each temp_recipe-order
     1000       :
     1001           delete temp_recipe-order.
     1002       end.
     1003       for each buf_fbr-line no-lock
     1004          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1005       on error undo, return error
     1006       :
     1007           find first temp_recipe-childs-qnty
     1008                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1009           no-error.
     1010           if not available temp_recipe-childs-qnty
     1011           then do:
     1012               create temp_recipe-childs-qnty.
     1013               assign
     1014                   v-recipe-amount                     = v-recipe-amount + 1
     1015                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1016                   temp_recipe-childs-qnty.order       = v-recipe-amount
     1017                   temp_recipe-childs-qnty.childs-qnty = 0
     1018                   v-child-counter                     = 0
     1019               .
     1020           end.
     1021       end.
     1022       for each buf_in_fbr-line no-lock
     1023          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1024            and buf_in_fbr-line.trn-type = 'спи':U
     1025       on error undo, return error
     1026       :
     1027           for each buf_dress_fbr-line no-lock
     1028              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     1029                and buf_dress_fbr-line.trn-type    = 'при':U
     1030                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     1031                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     1032                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     1033           on error undo, return error
     1034           :
     1035               find first buf_recipe no-lock
     1036                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     1037               .
     1038               if buf_in_fbr-line.is-comp = yes
     1039               then do:
     1040                   find last temp_recipe-childs-qnty
     1041                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1042                   .
     1043                   assign
     1044                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1045                   .
     1046                   create temp_recipe-childs.
     1047                   assign
     1048                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1049                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1050                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     1051                   .
     1052               end.
     1053               else do:
     1054               end.
     1055           end.
     1056       end.
     1057       for each buf_in_fbr-line no-lock
     1058          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1059            and buf_in_fbr-line.trn-type = 'при':U
     1060       on error undo, return error
     1061       :
     1062           find first buf_recipe no-lock
     1063                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     1064           no-error.
     1065           if buf_in_fbr-line.is-comp = no
     1066           then do:
     1067           end.
     1068           else do:
     1069               for each buf_recipe-gds no-lock
     1070               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     1071               :
     1072                   for each buf_fbr-line no-lock
     1073                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1074                       and buf_fbr-line.trn-type    = 'при':U
     1075                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     1076                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     1077                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     1078                   on error undo, return error
     1079                   :
     1080                       find first buf_recipe no-lock
     1081                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     1082                       .
     1083                       if buf_recipe.recipe-type = 'разделка':U
     1084                       then do:
     1085                       end.
     1086                       else do:
     1087                           find last temp_recipe-childs-qnty
     1088                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1089                           .
     1090                           assign
     1091                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1092                           .
     1093                           create temp_recipe-childs.
     1094                           assign
     1095                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1096                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1097                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     1098                           .
     1099                       end.
     1100                   end.
     1101               end.
     1102           end.
     1103       end.
     1104       for each temp_recipe-order
     1105       on error undo, return error
     1106       :
     1107           delete temp_recipe-order.
     1108       end.
     1109       assign
     1110           v-fbrlib-recipe-order = 0
     1111       .
     1112       do v-recipe-counter = 1 to v-recipe-amount
     1113       on error undo, return error
     1114       :
     1115           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1116                 input v-recipe-counter
     1117               , input 0
     1118               , output v-is-call-cycle
     1119           ).
     1120           if v-is-call-cycle = yes
     1121           then do:
     1122               message
     1123                       "Достигнут максимальный уровень вложенности рецептов."
     1124                   skip(1)
     1125                   skip "Невозможно упорядочить рецепты."
     1126                   skip(1)
     1127                   skip "Необходимо изменить структуру рецептов,"
     1128                   skip "используемых при формировании"
     1129                   skip "данного документа производства."
     1130               view-as alert-box error
     1131               title "Невозможно рассчитать документ производства".
     1132               for each temp_recipe-childs-qnty
     1133               :
     1134                   delete temp_recipe-childs-qnty.
     1135               end.
     1136               for each temp_recipe-childs
     1137               :
     1138                   delete temp_recipe-childs.
     1139               end.
     1140               for each temp_recipe-order
     1141               :
     1142                   delete temp_recipe-order.
     1143               end.
     1144               for each temp_recipe-order
     1145               on error undo, return error
     1146               :
     1147                   delete temp_recipe-order.
     1148               end.
     1149               for each temp_fbrlib_recipe
     1150               on error undo, return error
     1151               :
     1152                   delete temp_recipe-order.
     1153               end.
     1154               undo, return error.
     1155           end.
     1156       end.
     1157   end.
     1158   end procedure.
     1159   procedure fbrlib-add-recipe-in-tmp-order :
     1160   do
     1161   on error undo, return error
     1162   :
     1163   define input parameter p-order              as integer      no-undo.
     1164   define input parameter p-call-counter       as integer      no-undo.
     1165   define output parameter p-is-call-cycle     as logical      no-undo.
     1166       define variable v-nodes-counter     as integer       no-undo.
     1167       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     1168       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     1169       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     1170       define buffer buf_temp_recipe-order         for temp_recipe-order.
     1171       assign
     1172           p-call-counter = p-call-counter + 1
     1173       .
     1174       if p-call-counter > 50
     1175       then do:
     1176           assign
     1177               p-is-call-cycle = yes
     1178           .
     1179       end.
     1180       else do:
     1181           find first buf_temp_recipe-childs-qnty
     1182                where buf_temp_recipe-childs-qnty.order = p-order
     1183           .
     1184           find first buf_temp_recipe-order
     1185                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1186           no-error.
     1187           if not available buf_temp_recipe-order
     1188           then do:
     1189               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     1190               :
     1191                   find first buf_temp_recipe-childs
     1192                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1193                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     1194                   .
     1195                   find first buf_c_temp_recipe-childs-qnty
     1196                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     1197                   .
     1198                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1199                         input buf_c_temp_recipe-childs-qnty.order
     1200                       , input p-call-counter
     1201                       , output p-is-call-cycle
     1202                   ).
     1203                   if p-is-call-cycle = yes
     1204                   then do:
     1205                       return.
     1206                   end.
     1207               end.
     1208               assign
     1209                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     1210               .
     1211               create buf_temp_recipe-order.
     1212               assign
     1213                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     1214                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     1215               .
     1216           end.
     1217       end.
     1218   end.
     1219   end procedure.
     1220   procedure fbrlib-get-trn-type :
     1221   define input parameter p-recipe-code    as character    no-undo.
     1222   define input parameter p-goods-recid    as recid        no-undo.
     1223   define input parameter p-is-integration as logical      no-undo.
     1224   define output parameter p-is-comp       as logical      no-undo.
     1225   define output parameter p-trn-type      as character    no-undo.
     1226   define buffer buf_recipe    for ub.recipe.
     1227   define buffer buf_goods     for ub.goods.
     1228   do
     1229   for buf_recipe
     1230     , buf_goods
     1231   on error undo, return error
     1232   :
     1233       find first buf_goods no-lock
     1234            where recid( buf_goods ) = p-goods-recid
     1235       .
     1236       find first buf_recipe no-lock
     1237            where buf_recipe.recipe-code = p-recipe-code
     1238       no-error.
     1239       if not available buf_recipe
     1240       then do:
     1241           assign
     1242               p-is-comp = no
     1243               p-trn-type = "":U
     1244           .
     1245           undo, return.
     1246       end.
     1247       if  buf_recipe.artic        = buf_goods.artic
     1248       and buf_recipe.prod-type    = buf_goods.prod-type
     1249       and buf_recipe.prod-code    = buf_goods.prod-code
     1250       then do:
     1251           assign
     1252               p-is-comp = yes
     1253           .
     1254       end.
     1255       else do:
     1256           assign
     1257               p-is-comp = no
     1258           .
     1259       end.
     1260       case buf_recipe.recipe-type
     1261       :
     1262           when 'производство':U
     1263           then do:
     1264               if p-is-comp = yes
     1265               then do:
     1266                   assign
     1267                       p-trn-type = 'при':U
     1268                   .
     1269               end.
     1270               else do:
     1271                   assign
     1272                       p-trn-type = 'спи':U
     1273                   .
     1274               end.
     1275           end.
     1276           when 'альтернатива':U
     1277           then do:
     1278               if p-is-comp = yes
     1279               then do:
     1280                   assign
     1281                       p-trn-type = 'при':U
     1282                   .
     1283               end.
     1284               else do:
     1285                   assign
     1286                       p-trn-type = 'спи':U
     1287                   .
     1288               end.
     1289           end.
     1290           when 'разделка':U
     1291           then do:
     1292               if p-is-comp = no
     1293               then do:
     1294                   assign
     1295                       p-trn-type = 'при':U
     1296                   .
     1297               end.
     1298               else do:
     1299                   assign
     1300                       p-trn-type = 'спи':U
     1301                   .
     1302               end.
     1303           end.
     1304           when 'комплектация':U
     1305           then do:
     1306               if p-is-integration = ?
     1307               then do:
     1308                   message
     1309                       "Выберите тип операции по рецепту комплектации:"
     1310                       skip (2) "YES - комплектация"
     1311                       skip     "NO - разукомплектация"
     1312                   view-as alert-box question
     1313                   buttons YES-NO
     1314                   update p-is-integration.
     1315               end.
     1316               if p-is-integration = yes
     1317               then do:
     1318                   if p-is-comp = yes
     1319                   then do:
     1320                       assign
     1321                           p-trn-type = 'при':U
     1322                       .
     1323                   end.
     1324                   else do:
     1325                       assign
     1326                           p-trn-type = 'спи':U
     1327                       .
     1328                   end.
     1329               end.
     1330               else do:
     1331                   if p-is-comp = yes
     1332                   then do:
     1333                       assign
     1334                           p-trn-type = 'спи':U
     1335                       .
     1336                   end.
     1337                   else do:
     1338                       assign
     1339                           p-trn-type = 'при':U
     1340                       .
     1341                   end.
     1342               end.
     1343           end.
     1344       end case.
     1345   end.
     1346   end procedure.
     1347   procedure fbrlib-get-mark :
     1348   define input parameter p-recipe-code    as character    no-undo.
     1349   define output parameter p-mark          as logical    no-undo.
     1350   define buffer buf_goods-attr     for ub.goods-attr.
     1351   define buffer buf_recipe-gds for ub.recipe-gds .
     1352       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     1353            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     1354                                               buf_goods-attr.attr-code = 'mark-type':U:
     1355            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     1356               p-mark = true .
     1357               return .
     1358            end.
     1359       end.
     1360   end procedure.
     1361   procedure fbrlib-check-temp-tables :
     1362   do
     1363   on error undo, return error
     1364   :
     1365   define input parameter p-title  as character    no-undo.
     1366       define variable v-str               as character        no-undo.
     1367       assign
     1368           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     1369       .
     1370       for each temp_recipe-childs-qnty
     1371       on error undo, return error
     1372       :
     1373           assign
     1374               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     1375                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     1376                       + "   " + string( temp_recipe-childs-qnty.order )
     1377                       + chr(10)
     1378           .
     1379       end.
     1380       assign
     1381           v-str = v-str + "temp_recipe-childs:" + chr(10)
     1382       .
     1383       for each temp_recipe-childs
     1384       on error undo, return error
     1385       :
     1386           assign
     1387               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     1388                       + "   " + string( temp_recipe-childs.child-code )
     1389                       + "   " + string( temp_recipe-childs.child-recipe-code )
     1390                       + chr(10)
     1391           .
     1392       end.
     1393       assign
     1394           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     1395       .
     1396       for each temp_recipe-order
     1397       on error undo, return error
     1398       :
     1399           assign
     1400               v-str   = v-str + string( temp_recipe-order.recipe-code )
     1401                       + "   " + string( temp_recipe-order.order )
     1402                       + chr(10)
     1403           .
     1404       end.
     1405       assign
     1406           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     1407       .
     1408       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     1409       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     1410       for each temp_fbrlib_recipe
     1411       on error undo, return error
     1412       :
     1413           assign
     1414               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     1415                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     1416                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     1417                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     1418                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     1419                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     1420                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     1421                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     1422                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     1423                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     1424                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     1425                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     1426                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     1427                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     1428                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     1429                       + chr(10)
     1430           .
     1431           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     1432       end.
     1433   end.
     1434   end procedure.
     1435   procedure fbrlib-s-coeff-value :
     1436   define input  parameter p-gds-code    as integer        no-undo.
     1437   define input  parameter p-date        as date           no-undo.
     1438   define input  parameter p-obj-type    as character      no-undo.
     1439   define input  parameter p-obj-code    as integer        no-undo.
     1440   define output parameter p-coeff-value as decimal        no-undo.
     1441   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     1442       define variable v-date          as date         no-undo.
     1443       define variable v-host-code     as integer      no-undo.
     1444       define buffer buf_goods       for ub.goods.
     1445       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     1446       define buffer buf_clients     for ub.clients.
     1447       define buffer buf_s-coeff     for ub.s-coeff.
     1448   do
     1449   for buf_goods
     1450     , buf_fbr-gds-obj
     1451     , buf_clients
     1452     , buf_s-coeff
     1453   on error undo, return error return-value
     1454   :
     1455       find first buf_goods no-lock
     1456            where buf_goods.gds-code = p-gds-code
     1457       no-error .
     1458       if not available buf_goods
     1459       then do:
     1460          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     1461       end.
     1462       find first buf_clients no-lock
     1463            where buf_clients.obj-type = p-obj-type
     1464              and buf_clients.obj-code = p-obj-code
     1465       no-error.
     1466       if not available buf_clients
     1467       then do:
     1468          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     1469       end.
     1470       assign
     1471           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     1472       .
     1473       find first buf_fbr-gds-obj no-lock
     1474            where buf_fbr-gds-obj.gds-code = p-gds-code
     1475              and buf_fbr-gds-obj.obj-type = p-obj-type
     1476              and buf_fbr-gds-obj.obj-code = p-obj-code
     1477       no-error.
     1478       if not available buf_fbr-gds-obj
     1479       or buf_fbr-gds-obj.is-season = no
     1480       then do:
     1481           assign
     1482               p-coeff-value = 0
     1483           .
     1484           return.
     1485       end.
     1486   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1487   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1488     (input  p-obj-type
     1489     ,input  p-obj-code
     1490     ,output v-host-code
     1491     )  .
     1492       find last buf_s-coeff no-lock
     1493           where buf_s-coeff.gds-code = p-gds-code
     1494             and buf_s-coeff.host-code = v-host-code
     1495             and buf_s-coeff.obj-type = p-obj-type
     1496             and buf_s-coeff.obj-code = p-obj-code
     1497             and buf_s-coeff.s-date <= v-date
     1498       no-error.
     1499       if available buf_s-coeff
     1500       then do:
     1501           assign
     1502               p-coeff-value = buf_s-coeff.coeff-value
     1503           .
     1504           return.
     1505       end.
     1506       find last buf_s-coeff no-lock
     1507           where buf_s-coeff.gds-code = p-gds-code
     1508             and buf_s-coeff.host-code = v-host-code
     1509             and buf_s-coeff.obj-type = "":U
     1510             and buf_s-coeff.obj-code = 0
     1511             and buf_s-coeff.s-date <= v-date
     1512       no-error.
     1513       if available buf_s-coeff
     1514       then do:
     1515           assign
     1516               p-coeff-value = buf_s-coeff.coeff-value
     1517           .
     1518           return.
     1519       end.
     1520       find last buf_s-coeff no-lock
     1521           where buf_s-coeff.gds-code = p-gds-code
     1522             and buf_s-coeff.host-code = 0
     1523             and buf_s-coeff.obj-type = "":U
     1524             and buf_s-coeff.obj-code = 0
     1525             and buf_s-coeff.s-date <= v-date
     1526       no-error.
     1527       if available buf_s-coeff
     1528       then do:
     1529           assign
     1530               p-coeff-value = buf_s-coeff.coeff-value
     1531           .
     1532       end.
     1533       else do:
     1534           assign
     1535               p-coeff-value = 0
     1536           .
     1537       end.
     1538   end.
     1539   end procedure.
     1540   procedure fbrlib_create-fbr-recipe-gds :
     1541   define input parameter p-doc-code         as character      no-undo.
     1542   define input parameter p-recipe-code      as character      no-undo.
     1543   define input parameter p-prod-type        as character      no-undo.
     1544   define input parameter p-prod-code        as integer        no-undo.
     1545   define input parameter p-artic            as character      no-undo.
     1546   define input parameter p-gds-code         as integer        no-undo.
     1547   define input parameter p-is-waste         as logical        no-undo.
     1548   define input parameter p-proc-number      as integer        no-undo.
     1549   define input parameter p-obj-date         as date           no-undo.
     1550   define input parameter p-obj-type         as character      no-undo.
     1551   define input parameter p-obj-code         as integer        no-undo.
     1552   define input parameter p-calc-method      as decimal        no-undo.
     1553   define input parameter p-coeff-waste      as decimal        no-undo.
     1554   define input parameter p-orig-qnty        as decimal        no-undo.
     1555   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     1556       define variable v-coeff-season  as decimal      no-undo.
     1557       define variable v-void-decimal  as decimal      no-undo.
     1558       define variable v-void-integer  as integer      no-undo.
     1559       define variable v-recipe-type   as character    no-undo.
     1560       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     1561       define buffer buf_goods             for ub.goods.
     1562       define buffer buf_recipe            for ub.recipe.
     1563   do
     1564   for buf_fbr-recipe-gds
     1565     , buf_recipe
     1566     , buf_goods
     1567   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1568   :
     1569       find first buf_fbr-recipe-gds exclusive-lock
     1570            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     1571              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     1572              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     1573              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     1574              and buf_fbr-recipe-gds.artic       = p-artic
     1575       no-error.
     1576       if not available buf_fbr-recipe-gds
     1577       then do:
     1578           create buf_fbr-recipe-gds.
     1579           assign
     1580               buf_fbr-recipe-gds.doc-code           = p-doc-code
     1581               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     1582               buf_fbr-recipe-gds.prod-type          = p-prod-type
     1583               buf_fbr-recipe-gds.prod-code          = p-prod-code
     1584               buf_fbr-recipe-gds.artic              = p-artic
     1585               buf_fbr-recipe-gds.gds-code           = p-gds-code
     1586               buf_fbr-recipe-gds.is-waste           = p-is-waste
     1587               buf_fbr-recipe-gds.proc-number        = p-proc-number
     1588               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     1589               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     1590           .
     1591           find first buf_goods no-lock
     1592                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     1593                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     1594                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     1595           .
     1596           run fbrlib-s-coeff-value in this-procedure (
     1597                 input buf_goods.gds-code
     1598               , input p-obj-date
     1599               , input p-obj-type
     1600               , input p-obj-code
     1601               , output v-coeff-season
     1602           ) no-error.
     1603           if error-status:error
     1604           then do:
     1605               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     1606           end.
     1607           assign
     1608               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     1609               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     1610               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     1611           .
     1612           run fbrlib-get-recipe-type in this-procedure (
     1613                 input buf_fbr-recipe-gds.doc-code
     1614               , input buf_fbr-recipe-gds.recipe-code
     1615               , output v-recipe-type
     1616           ).
     1617           if v-recipe-type <> 'производство':U
     1618           then do:
     1619               assign
     1620                   buf_fbr-recipe-gds.coeff-value  = 0
     1621                   buf_fbr-recipe-gds.coeff-waste  = 0
     1622                   buf_fbr-recipe-gds.calc-method  = 1
     1623                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     1624               .
     1625           end.
     1626           else do:
     1627               run fbrlib-calc-brutto in this-procedure (
     1628                     input v-recipe-type
     1629                   , input buf_fbr-recipe-gds.qnty
     1630                   , input buf_fbr-recipe-gds.coeff-value
     1631                   , input buf_fbr-recipe-gds.coeff-waste
     1632                   , input 0
     1633                   , input 3
     1634                   , output v-void-decimal
     1635                   , output v-void-decimal
     1636                   , output buf_fbr-recipe-gds.brutto-qnty
     1637                   , output v-void-integer
     1638               ).
     1639               assign
     1640                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     1641               .
     1642               run fbrlib-calc-brutto in this-procedure (
     1643                     input v-recipe-type
     1644                   , input buf_fbr-recipe-gds.qnty
     1645                   , input buf_fbr-recipe-gds.coeff-value
     1646                   , input buf_fbr-recipe-gds.coeff-waste
     1647                   , input buf_fbr-recipe-gds.brutto-qnty
     1648                   , input buf_fbr-recipe-gds.calc-method
     1649                   , output buf_fbr-recipe-gds.qnty
     1650                   , output v-void-decimal
     1651                   , output v-void-decimal
     1652                   , output v-void-integer
     1653               ).
     1654           end.
     1655       end.
     1656   end.
     1657   end procedure.
     1658   procedure fbrlib-set-default-recipe :
     1659   define input parameter p-obj-type   as character    no-undo.
     1660   define input parameter p-obj-code   as integer      no-undo.
     1661   define input parameter p-gds-code   as integer      no-undo.
     1662       define variable v-artic             as character    no-undo.
     1663       define variable v-prod-type         as character    no-undo.
     1664       define variable v-prod-code         as character    no-undo.
     1665       define variable v-recipe-code       as character    no-undo.
     1666       define variable v-fbr-gds-obj-recid as recid        no-undo.
     1667       define variable v-recipe-found      as logical      no-undo.
     1668       define buffer buf_recipe        for ub.recipe.
     1669       define buffer buf_other_recipe  for ub.recipe.
     1670       define buffer buf_goods         for ub.goods.
     1671       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     1672   do
     1673   for buf_recipe
     1674     , buf_goods
     1675     , buf_fbr-gds-obj
     1676   on error undo, return error
     1677   :
     1678       find first buf_goods no-lock
     1679            where buf_goods.gds-code = p-gds-code
     1680       .
     1681       run fbrlib-get-obj-recipe in this-procedure (
     1682             input p-obj-type
     1683           , input p-obj-code
     1684           , input p-gds-code
     1685           , output v-recipe-code
     1686       ).
     1687       if v-recipe-code <> ""
     1688       then do:
     1689           find first buf_recipe no-lock
     1690               where buf_recipe.recipe-code = v-recipe-code
     1691           no-error.
     1692           if not available buf_recipe
     1693           then do:
     1694               assign
     1695                   v-recipe-code = ""
     1696               .
     1697           end.
     1698       end.
     1699       if v-recipe-code = ""
     1700       then do:
     1701           find first buf_fbr-gds-obj exclusive-lock
     1702                where buf_fbr-gds-obj.obj-type = p-obj-type
     1703                  and buf_fbr-gds-obj.obj-code = p-obj-code
     1704                  and buf_fbr-gds-obj.gds-code = p-gds-code
     1705           no-error.
     1706           if not available buf_fbr-gds-obj
     1707           then do:
     1708               run ref/fgdsobj1.p (
     1709                     input-output v-fbr-gds-obj-recid
     1710                   , input 'ДОБАВЛЕНИЕ':U
     1711                   , input no
     1712                   , input p-gds-code
     1713                   , input p-obj-type
     1714                   , input p-obj-code
     1715                   , input 0
     1716                   , input ""
     1717                   , input 0
     1718                   , input no
     1719                   , input no
     1720                   , input no
     1721                   , input no
     1722                   , input no
     1723                   , input no
     1724               ) no-error.
     1725               if error-status:error
     1726               then do:
     1727                   message
     1728                           vss-workfile vss-revision vss-description
     1729                       skip "Ошибка изменения атрибутов товара на объекте"
     1730                       skip return-value
     1731                       skip trim(error-status :get-message(1))
     1732                               trim(error-status :get-message(2))
     1733                               trim(error-status :get-message(3))
     1734                   view-as alert-box error.
     1735                   undo, return error .
     1736               end.
     1737               find first buf_fbr-gds-obj exclusive-lock
     1738                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     1739               .
     1740           end.
     1741           assign
     1742               v-recipe-found = no
     1743           .
     1744           for first buf_recipe no-lock
     1745               where buf_recipe.obj-type    = p-obj-type
     1746                 and buf_recipe.obj-code    = p-obj-code
     1747                 and buf_recipe.artic       = buf_goods.artic
     1748                 and buf_recipe.prod-type   = buf_goods.prod-type
     1749                 and buf_recipe.prod-code   = buf_goods.prod-code
     1750                 and buf_recipe.recipe-type = 'производство':U
     1751                 or (
     1752                     buf_recipe.obj-type    = ""
     1753                 and buf_recipe.obj-code    = 0
     1754                 and buf_recipe.artic       = buf_goods.artic
     1755                 and buf_recipe.prod-type   = buf_goods.prod-type
     1756                 and buf_recipe.prod-code   = buf_goods.prod-code
     1757                 and buf_recipe.recipe-type = 'производство':U
     1758                     )
     1759           :
     1760               assign
     1761                   v-recipe-found = yes
     1762                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     1763               .
     1764           end.
     1765           if v-recipe-found = no
     1766           then do:
     1767               for first buf_recipe no-lock
     1768                   where buf_recipe.obj-type    = p-obj-type
     1769                     and buf_recipe.obj-code    = p-obj-code
     1770                     and buf_recipe.artic       = buf_goods.artic
     1771                     and buf_recipe.prod-type   = buf_goods.prod-type
     1772                     and buf_recipe.prod-code   = buf_goods.prod-code
     1773                     and buf_recipe.recipe-type <> 'альтернатива':U
     1774                     or (
     1775                         buf_recipe.obj-type    = ""
     1776                     and buf_recipe.obj-code    = 0
     1777                     and buf_recipe.artic       = buf_goods.artic
     1778                     and buf_recipe.prod-type   = buf_goods.prod-type
     1779                     and buf_recipe.prod-code   = buf_goods.prod-code
     1780                     and buf_recipe.recipe-type <> 'альтернатива':U
     1781                         )
     1782               :
     1783                   assign
     1784                       v-recipe-found = yes
     1785                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     1786                   .
     1787               end.
     1788               if v-recipe-found = no
     1789               then do:
     1790                   for first buf_recipe no-lock
     1791                       where buf_recipe.obj-type    = p-obj-type
     1792                         and buf_recipe.obj-code    = p-obj-code
     1793                         and buf_recipe.artic       = buf_goods.artic
     1794                         and buf_recipe.prod-type   = buf_goods.prod-type
     1795                         and buf_recipe.prod-code   = buf_goods.prod-code
     1796                         or (
     1797                             buf_recipe.obj-type    = ""
     1798                         and buf_recipe.obj-code    = 0
     1799                         and buf_recipe.artic       = buf_goods.artic
     1800                         and buf_recipe.prod-type   = buf_goods.prod-type
     1801                         and buf_recipe.prod-code   = buf_goods.prod-code
     1802                             )
     1803                   :
     1804                       assign
     1805                           v-recipe-found = yes
     1806                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     1807                       .
     1808                   end.
     1809                   if v-recipe-found = no
     1810                   then do:
     1811                       assign
     1812                           buf_fbr-gds-obj.default-recipe-code = ""
     1813                       .
     1814                   end.
     1815               end.
     1816           end.
     1817       end.
     1818   end.
     1819   end procedure.
     1820   procedure fbrlib-get-obj-recipe :
     1821   define input parameter p-obj-type       as character    no-undo.
     1822   define input parameter p-obj-code       as integer      no-undo.
     1823   define input parameter p-gds-code       as integer      no-undo.
     1824   define output parameter p-recipe-code   as character    no-undo.
     1825       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     1826   do
     1827   for buf_fbr-gds-obj
     1828   on error undo, return error
     1829   :
     1830       find first buf_fbr-gds-obj no-lock
     1831            where buf_fbr-gds-obj.obj-type = p-obj-type
     1832              and buf_fbr-gds-obj.obj-code = p-obj-code
     1833              and buf_fbr-gds-obj.gds-code = p-gds-code
     1834       no-error.
     1835       if available buf_fbr-gds-obj
     1836       then do:
     1837           assign
     1838               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     1839           .
     1840       end.
     1841       else do:
     1842           assign
     1843               p-recipe-code = ""
     1844           .
     1845       end.
     1846   end.
     1847   end procedure.
     1848   procedure fbrlib-create-or-update-recipe-gds :
     1849   define input parameter p-recipe-code    as character        no-undo.
     1850   define input parameter p-gds-code       as integer          no-undo.
     1851   define input parameter p-is-waste       as logical          no-undo.
     1852   define input parameter p-qnty           as decimal          no-undo.
     1853   define input parameter p-proc-number    as integer          no-undo.
     1854   define input parameter p-nws-self       as logical          no-undo.
     1855       define variable v-max-proc-num  as integer      no-undo.
     1856       define variable v-recipe-type   as character    no-undo.
     1857       define buffer buf_goods             for ub.goods.
     1858       define buffer buf_recipe-gds        for ub.recipe-gds.
     1859       define buffer buf_recipe            for ub.recipe.
     1860       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     1861   do
     1862   for buf_goods
     1863     , buf_recipe-gds
     1864     , buf_recipe
     1865     , buf_proc_recipe-gds
     1866   on error undo, return error
     1867   :
     1868       find first buf_recipe no-lock
     1869            where buf_recipe.recipe-code = p-recipe-code
     1870       .
     1871       find first buf_goods no-lock
     1872            where buf_goods.gds-code = p-gds-code
     1873       .
     1874       find first buf_recipe-gds
     1875            where buf_recipe-gds.recipe-code = p-recipe-code
     1876              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     1877              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     1878              and buf_recipe-gds.artic       = buf_goods.artic
     1879       no-error.
     1880       if not available buf_recipe-gds
     1881       then do:
     1882           create buf_recipe-gds.
     1883           assign
     1884               buf_recipe-gds.recipe-code = p-recipe-code
     1885               buf_recipe-gds.gds-code    = p-gds-code
     1886               buf_recipe-gds.prod-type   = buf_goods.prod-type
     1887               buf_recipe-gds.prod-code   = buf_goods.prod-code
     1888               buf_recipe-gds.artic       = buf_goods.artic
     1889           .
     1890           assign
     1891               buf_recipe-gds.is-waste    = no
     1892               buf_recipe-gds.qnty        = 0
     1893               buf_recipe-gds.coeff-waste = 0
     1894               buf_recipe-gds.brutto-qnty = 0
     1895               buf_recipe-gds.proc-number = 0
     1896               buf_recipe-gds.nws-self    = no
     1897           .
     1898       end.
     1899       assign
     1900           buf_recipe-gds.is-waste    = p-is-waste
     1901       .
     1902       run fbrlib-get-recipe-type in this-procedure (
     1903             input "":U
     1904           , input buf_recipe-gds.recipe-code
     1905           , output v-recipe-type
     1906       ).
     1907       if v-recipe-type <> 'производство':U
     1908       then do:
     1909           assign
     1910               buf_recipe-gds.calc-method = 1
     1911               buf_recipe-gds.qnty        = p-qnty
     1912               buf_recipe-gds.brutto-qnty = p-qnty
     1913               buf_recipe-gds.coeff-waste = 0
     1914           .
     1915       end.
     1916       else do:
     1917           assign
     1918               buf_recipe-gds.calc-method = 1
     1919               buf_recipe-gds.brutto-qnty = p-qnty
     1920           .
     1921           run fbrlib-calc-brutto in this-procedure (
     1922                 input v-recipe-type
     1923               , input 0
     1924               , input 0
     1925               , input buf_recipe-gds.coeff-waste
     1926               , input buf_recipe-gds.brutto-qnty
     1927               , input 1
     1928               , output buf_recipe-gds.qnty
     1929               , output buf_recipe-gds.coeff-waste
     1930               , output buf_recipe-gds.brutto-qnty
     1931               , output buf_recipe-gds.calc-method
     1932           ).
     1933       end.
     1934       assign
     1935           buf_recipe-gds.nws-self    = p-nws-self
     1936       .
     1937       if buf_recipe.recipe-type = 'альтернатива':U
     1938       and buf_recipe-gds.proc-number <> 0
     1939       then do:
     1940       end.
     1941       else do:
     1942           if p-proc-number <> 0
     1943           then do:
     1944               assign
     1945                   buf_recipe-gds.proc-number = p-proc-number
     1946               .
     1947           end.
     1948           else do:
     1949               assign
     1950                   v-max-proc-num = 0
     1951               .
     1952               for each buf_proc_recipe-gds no-lock
     1953                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     1954               :
     1955                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     1956                   then do:
     1957                       assign
     1958                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     1959                       .
     1960                   end.
     1961               end.
     1962               assign
     1963                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     1964               .
     1965           end.
     1966       end.
     1967   end.
     1968   end procedure.
     1969   PROCEDURE fbrlib-create-or-update-recipe :
     1970   define input parameter p-mode               as character    no-undo.
     1971   define input parameter p-obj-type           as character    no-undo.
     1972   define input parameter p-obj-code           as integer      no-undo.
     1973   define input parameter p-recipe-code        as character    no-undo.
     1974   define input parameter p-recipe-type        as character    no-undo.
     1975   define input parameter p-gds-code           as integer      no-undo.
     1976   define input parameter p-name               as character    no-undo.
     1977   define input parameter p-design             as character    no-undo.
     1978   define input parameter p-order              as integer      no-undo.
     1979   define input parameter p-quality            as character    no-undo.
     1980   define input parameter p-ref-num            as character    no-undo.
     1981   define input parameter p-technique          as character    no-undo.
     1982   define input parameter p-template           as character    no-undo.
     1983   define input parameter p-qnty               as decimal      no-undo.
     1984   define input parameter p-portion-qnty       as integer      no-undo.
     1985   define input parameter p-portion-weight     as decimal      no-undo.
     1986   define output parameter p-new-recipe-code   as character    no-undo.
     1987       define variable v-host-code         as integer      no-undo.
     1988       define variable v-fbr-gds-obj-recid as recid        no-undo.
     1989       define buffer buf_recipe    for ub.recipe.
     1990       define buffer buf_goods     for ub.goods.
     1991   do
     1992   for buf_recipe
     1993     , buf_goods
     1994   on error undo, return error
     1995   :
     1996       if p-mode <> 'ДОБАВЛЕНИЕ':U
     1997       and p-mode <> 'ИЗМЕНЕНИЕ':U
     1998       then do:
     1999           message
     2000               skip "Ошибка задания типа операции для создания или измения рецепта."
     2001               skip (1)
     2002               skip "Задан тип операции:" p-mode
     2003           view-as alert-box error.
     2004           undo, return error .
     2005       end.
     2006       if p-recipe-code = ""
     2007       then do:
     2008   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2009   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2010     (input  p-obj-type
     2011     ,input  p-obj-code
     2012     ,output v-host-code
     2013     )  .
     2014           find first buf_goods no-lock
     2015                where buf_goods.gds-code = p-gds-code
     2016           .
     2017           create buf_recipe .
     2018           run fbrcode-gen-recipe-code in this-procedure (
     2019                 input p-obj-type
     2020               , input p-obj-code
     2021               , output buf_recipe.recipe-code
     2022           ).
     2023           assign
     2024               buf_recipe.artic               = buf_goods.artic
     2025               buf_recipe.prod-type           = buf_goods.prod-type
     2026               buf_recipe.prod-code           = buf_goods.prod-code
     2027               buf_recipe.recipe-type         = p-recipe-type
     2028               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     2029               buf_recipe.gds-code            = p-gds-code
     2030               buf_recipe.host-code           = v-host-code
     2031               buf_recipe.obj-type            = p-obj-type
     2032               buf_recipe.obj-code            = p-obj-code
     2033               buf_recipe.recipe-design       = ""
     2034               buf_recipe.recipe-order        = 0
     2035               buf_recipe.recipe-quality      = ""
     2036               buf_recipe.recipe-ref-num      = ""
     2037               buf_recipe.recipe-technique    = ""
     2038               buf_recipe.recipe-template     = ""
     2039               buf_recipe.qnty                = 1.0
     2040               buf_recipe.portion-qnty        = 1
     2041               buf_recipe.portion-weight      = 0
     2042           .
     2043       end.
     2044       if p-name <> ""
     2045       then do:
     2046           assign
     2047               buf_recipe.recipe-name = p-name
     2048           .
     2049       end.
     2050       assign
     2051           buf_recipe.recipe-design       = p-design
     2052           buf_recipe.recipe-order        = p-order
     2053           buf_recipe.recipe-quality      = p-quality
     2054           buf_recipe.recipe-ref-num      = p-ref-num
     2055           buf_recipe.recipe-technique    = p-technique
     2056           buf_recipe.recipe-template     = p-template
     2057           buf_recipe.qnty                = p-qnty
     2058           buf_recipe.portion-qnty        = p-portion-qnty
     2059           buf_recipe.portion-weight      = p-portion-weight
     2060       .
     2061       assign
     2062           p-new-recipe-code = buf_recipe.recipe-code
     2063       .
     2064       run fbrlib-set-default-recipe in this-procedure (
     2065             input p-obj-type
     2066           , input p-obj-code
     2067           , input buf_goods.gds-code
     2068       ).
     2069   end.
     2070   END PROCEDURE.
     2071   PROCEDURE fbrlib-delete-fact-fbr-doc :
     2072   define input parameter parparentproc-handle as widget-handle no-undo .
     2073   define input parameter p-doc-code   as character no-undo.
     2074   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     2075       define variable v-shift-on      as logical      no-undo.
     2076       define variable v-shift-date    as date         no-undo.
     2077       define variable v-shift-num     as integer      no-undo.
     2078       define variable v-shift-name    as character    no-undo.
     2079       define variable v-obj-date      as date         no-undo.
     2080       define variable v-chip-num      as integer      no-undo.
     2081       define buffer buf_fbr-doc       for ub.fbr-doc.
     2082       define buffer buf_fbr-line      for ub.fbr-line.
     2083       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     2084       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     2085       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     2086       define buffer buf_marking-lines for ub.marking-lines .
     2087       define buffer buf_marking       for ub.marking .
     2088       define buffer buf_goods         for ub.goods .
     2089   do
     2090   for buf_fbr-doc
     2091     , buf_fbr-line
     2092     , buf_c-fbr-doc
     2093     , buf_fbr-recipe
     2094     , buf_fbr-recipe-gds
     2095     , buf_goods
     2096     , buf_marking
     2097     , buf_marking-lines
     2098   on error undo, return error
     2099   :
     2100   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2101     define variable v-cntxt-db-num        as integer   no-undo .
     2102     define variable v-cntxt-userid        as character no-undo .
     2103     define variable v-cntxt-level         as character no-undo .
     2104     define variable v-cntxt-host-code-obj as integer   no-undo .
     2105     define variable v-cntxt-obj-type      as character no-undo .
     2106     define variable v-cntxt-obj-code      as integer   no-undo .
     2107     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2108     define variable v-cntxt-is-admin      as logical   no-undo .
     2109   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2110     run mainmenu_getcntxt in parparentproc-handle
     2111       (output v-cntxt-db-num
     2112       ,output v-cntxt-userid
     2113       ,output v-cntxt-level
     2114       ,output v-cntxt-host-code-obj
     2115       ,output v-cntxt-obj-type
     2116       ,output v-cntxt-obj-code
     2117       ,output v-cntxt-db-num-obj
     2118       ,output v-cntxt-is-admin
     2119       ) .
     2120       if search ("delfbr.err") <> ?
     2121       then do:
     2122           os-delete "delfbr.err".
     2123       end.
     2124     _del-block:
     2125       do transaction
     2126     on error undo _del-block, return error return-value
     2127     on endkey undo _del-block , return error return-value
     2128     on stop undo _del-block , return error return-value
     2129       :
     2130           find first buf_fbr-doc exclusive-lock
     2131                where buf_fbr-doc.doc-code = p-doc-code
     2132           no-error.
     2133           if not available buf_fbr-doc
     2134           then do:
     2135         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     2136                                           ,vss-workfile
     2137                                           ,vss-revision
     2138                                           ,vss-description
     2139                                           ,chr(10)
     2140                                           , p-doc-code).
     2141           end.
     2142           run fbrlib-delete-fact-trn-doc in this-procedure (
     2143               input parparentproc-handle
     2144              ,input p-doc-code
     2145              ,input 'при':U
     2146              ,input p-chip-num
     2147              ,output v-chip-num
     2148           ) no-error.
     2149           if error-status :error
     2150           then do:
     2151               run fbrlib-print-del-error-message in this-procedure .
     2152         undo _del-block, return error.
     2153           end.
     2154           assign
     2155           p-chip-num = (if p-chip-num = ?
     2156                         then v-chip-num
     2157                         else p-chip-num).
     2158           run fbrlib-delete-fact-trn-doc in this-procedure (
     2159               input parparentproc-handle
     2160              ,input p-doc-code
     2161              ,input 'рас':U
     2162              ,input p-chip-num
     2163              ,output v-chip-num
     2164           ) no-error.
     2165           if error-status :error
     2166           then do:
     2167               run fbrlib-print-del-error-message in this-procedure .
     2168         undo _del-block, return error.
     2169           end.
     2170           run fbrlib-delete-fact-trn-doc in this-procedure (
     2171               input parparentproc-handle
     2172              ,input p-doc-code
     2173              ,input 'спи':U
     2174              ,input p-chip-num
     2175              ,output v-chip-num
     2176           ) no-error.
     2177           if error-status :error
     2178           then do:
     2179               run fbrlib-print-del-error-message in this-procedure .
     2180         undo _del-block, return error.
     2181           end.
     2182           create buf_c-fbr-doc.
     2183           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     2184   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2185   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2186     (input  buf_fbr-doc.obj-type
     2187     ,input  buf_fbr-doc.obj-code
     2188     ,output v-obj-date
     2189     ) no-error .
     2190           if error-status :error
     2191           or v-obj-date = ?
     2192           then do:
     2193         undo _del-block, return error "Нет текущей даты на объекте документа.".
     2194           end.
     2195   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2196   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2197     (input  buf_fbr-doc.obj-type
     2198     ,input  buf_fbr-doc.obj-code
     2199     ,input  'shift-on=request'
     2200     ,output v-shift-on
     2201     )  .
     2202           if v-shift-on
     2203           then do:
     2204   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2205   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     2206     (input  buf_fbr-doc.obj-type
     2207     ,input  buf_fbr-doc.obj-code
     2208     ,output v-shift-date
     2209     ,output v-shift-num
     2210     ,output v-shift-name
     2211     ) no-error .
     2212               if error-status :error
     2213               then do:
     2214           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     2215               end.
     2216           end.
     2217           else do:
     2218               assign
     2219                   v-shift-date = ?
     2220                   v-shift-num  = ?
     2221                   v-shift-name = ?
     2222               .
     2223           end.
     2224           define variable v-today       as date         no-undo.
     2225           define variable v-time        as integer      no-undo.
     2226           run cur-time in this-procedure (
     2227                 output v-today
     2228               , output v-time
     2229           ).
     2230           assign
     2231               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     2232               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     2233               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     2234               buf_c-fbr-doc.corr-date        = v-today
     2235               buf_c-fbr-doc.corr-time        = v-time
     2236               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     2237               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     2238               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     2239               buf_c-fbr-doc.is-del           = yes
     2240           .
     2241           assign
     2242               buf_fbr-doc.is-del = yes
     2243           .
     2244           for each buf_fbr-line exclusive-lock
     2245              where buf_fbr-line.doc-code = p-doc-code
     2246       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2247       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2248       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2249           :
     2250               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     2251                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     2252                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     2253               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     2254                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     2255                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     2256                                                       and buf_marking-lines.in-code  = "manufacturing"
     2257                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     2258                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     2259                                                       and buf_marking-lines.prt-code = 0
     2260               :
     2261                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     2262                   assign
     2263                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     2264                   .
     2265                 end .
     2266                 delete buf_marking-lines.
     2267               end .
     2268               delete buf_fbr-line.
     2269           end.
     2270           for each buf_fbr-recipe exclusive-lock
     2271              where buf_fbr-recipe.doc-code = p-doc-code
     2272       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2273       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2274       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2275           :
     2276               delete buf_fbr-recipe.
     2277           end.
     2278           for each buf_fbr-recipe-gds exclusive-lock
     2279              where buf_fbr-recipe-gds.doc-code = p-doc-code
     2280       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2281       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2282       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2283           :
     2284               delete buf_fbr-recipe-gds.
     2285           end.
     2286           delete buf_fbr-doc.
     2287       end.
     2288   end.
     2289   END PROCEDURE.
     2290   PROCEDURE fbrlib-del-trn-doc :
     2291   do
     2292   on error undo, return error
     2293   :
     2294   define input parameter parparentproc        as widget-handle no-undo .
     2295   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2296   define input parameter p-trn-doc-type       as character    no-undo.
     2297   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     2298   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     2299       define variable v-trn-doc-doc-code  as character     no-undo.
     2300       define buffer buf_trn-doc       for ub.trn-doc.
     2301   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2302     define variable v-cntxt-db-num        as integer   no-undo .
     2303     define variable v-cntxt-userid        as character no-undo .
     2304     define variable v-cntxt-level         as character no-undo .
     2305     define variable v-cntxt-host-code-obj as integer   no-undo .
     2306     define variable v-cntxt-obj-type      as character no-undo .
     2307     define variable v-cntxt-obj-code      as integer   no-undo .
     2308     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2309     define variable v-cntxt-is-admin      as logical   no-undo .
     2310   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2311     run mainmenu_getcntxt in parparentproc
     2312       (output v-cntxt-db-num
     2313       ,output v-cntxt-userid
     2314       ,output v-cntxt-level
     2315       ,output v-cntxt-host-code-obj
     2316       ,output v-cntxt-obj-type
     2317       ,output v-cntxt-obj-code
     2318       ,output v-cntxt-db-num-obj
     2319       ,output v-cntxt-is-admin
     2320       ) .
     2321       run fbrcode-trn-doc in this-procedure (
     2322             input 'производство':U
     2323           , input p-fbr-doc-doc-code
     2324           , input p-trn-doc-type
     2325           , output v-trn-doc-doc-code
     2326       ).
     2327       find first buf_trn-doc no-lock
     2328            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     2329       no-error.
     2330       if available buf_trn-doc
     2331       then do:
     2332           run str/del-doc.p (
     2333                 input parparentproc
     2334               , input buf_trn-doc.doc-code
     2335               , input v-cntxt-db-num
     2336               , input "del-doc.err"
     2337               , input ?
     2338               , input p-fbr-doc-doc-code
     2339               , input v-cntxt-userid
     2340               , input 0
     2341               , input p-phchip-num
     2342               , output p-chip-num
     2343           ) no-error.
     2344           if error-status :error
     2345           then do:
     2346             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     2347                                           ,v-trn-doc-doc-code
     2348                                           ,p-fbr-doc-doc-code
     2349                                           , chr(10)
     2350                                           , error-status:get-message(1)
     2351                                           , return-value ).
     2352           end.
     2353       end.
     2354   end.
     2355   END PROCEDURE.
     2356   PROCEDURE fbrlib-delete-fact-trn-doc :
     2357   define input parameter parparentproc    as widget-handle    no-undo.
     2358   define input parameter p-fbr-doc-code   as character        no-undo.
     2359   define input parameter p-doc-type       as character    no-undo.
     2360   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     2361   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     2362       define variable v-doc-code          as character        no-undo.
     2363       define variable v-ext-doc-type      as character        no-undo.
     2364       define variable v-trn-doc-recid     as recid            no-undo.
     2365       define variable varchip-code        as integer          no-undo.
     2366       define variable varchip-code2       as integer          no-undo.
     2367       define variable v-chip-counter      as integer          no-undo.
     2368       define buffer buf_trn-doc       for ub.trn-doc.
     2369       define buffer buf_pri_trn-doc   for ub.trn-doc.
     2370       define buffer buf_cons_trn-doc  for ub.trn-doc.
     2371   do
     2372   for buf_trn-doc
     2373     , buf_pri_trn-doc
     2374     , buf_cons_trn-doc
     2375   on error undo, return error
     2376   :
     2377   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2378     define variable v-cntxt-db-num        as integer   no-undo .
     2379     define variable v-cntxt-userid        as character no-undo .
     2380     define variable v-cntxt-level         as character no-undo .
     2381     define variable v-cntxt-host-code-obj as integer   no-undo .
     2382     define variable v-cntxt-obj-type      as character no-undo .
     2383     define variable v-cntxt-obj-code      as integer   no-undo .
     2384     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2385     define variable v-cntxt-is-admin      as logical   no-undo .
     2386   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2387     run mainmenu_getcntxt in parparentproc
     2388       (output v-cntxt-db-num
     2389       ,output v-cntxt-userid
     2390       ,output v-cntxt-level
     2391       ,output v-cntxt-host-code-obj
     2392       ,output v-cntxt-obj-type
     2393       ,output v-cntxt-obj-code
     2394       ,output v-cntxt-db-num-obj
     2395       ,output v-cntxt-is-admin
     2396       ) .
     2397       run fbrcode-trn-doc in this-procedure (
     2398             input 'производство':U
     2399           , input p-fbr-doc-code
     2400           , input p-doc-type
     2401           , output v-doc-code
     2402       ).
     2403       find first buf_trn-doc no-lock
     2404            where buf_trn-doc.doc-code = v-doc-code
     2405       no-error.
     2406       if not available buf_trn-doc
     2407       then do:
     2408           if p-doc-type <> 'спи':U
     2409           then do:
     2410               message
     2411                   "Не найден документ '" p-doc-type "'"
     2412                   "по документу производства " p-fbr-doc-code
     2413               view-as alert-box.
     2414               undo, return error.
     2415           end.
     2416           else do:
     2417           end.
     2418       end.
     2419       else do:
     2420           assign
     2421               v-trn-doc-recid = recid( buf_trn-doc )
     2422               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     2423           .
     2424           if v-ext-doc-type = 'ev':U
     2425           then do:
     2426               find first buf_pri_trn-doc no-lock
     2427                    where buf_pri_trn-doc.out-code     = v-doc-code
     2428                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     2429               no-error.
     2430               if available buf_pri_trn-doc
     2431               then do:
     2432                   run str/del-doc.p (
     2433                         input parparentproc
     2434                       , input buf_pri_trn-doc.doc-code
     2435                       , input v-cntxt-db-num
     2436                       , input "delfbr.err"
     2437                       , input ?
     2438                       , input p-fbr-doc-code
     2439                       , input v-cntxt-userid
     2440                       , input 0
     2441                       , input (if p-ph-chip-num <> ?
     2442                               then p-ph-chip-num
     2443                               else (if varchip-code <> 0
     2444                                   then varchip-code
     2445                                   else ?)
     2446                               )
     2447                       , output varchip-code2
     2448                   ) no-error.
     2449                   if error-status :error
     2450                   then do:
     2451                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     2452                                                   ,buf_pri_trn-doc.doc-code
     2453                                                   ,p-fbr-doc-code
     2454                                                   , chr(10)
     2455                                                   , error-status:get-message(1)
     2456                                                   , return-value ).
     2457                   end.
     2458               end.
     2459           end.
     2460           define buffer buf_out_trn-doc       for ub.trn-doc.
     2461           if p-doc-type = 'при':U
     2462           then do:
     2463               assign
     2464                   v-chip-counter = 0
     2465               .
     2466               for each buf_out_trn-doc exclusive-lock
     2467                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     2468               on error undo, return error
     2469               :
     2470                   assign
     2471                       v-chip-counter = v-chip-counter + 1
     2472                   .
     2473                   if v-chip-counter > 1
     2474                   then do:
     2475                       assign
     2476                           varchip-code = varchip-code2
     2477                       .
     2478                   end.
     2479                   run str/del-doc.p (
     2480                         input parparentproc
     2481                       , input buf_out_trn-doc.doc-code
     2482                       , input v-cntxt-db-num
     2483                       , input "delfbr.err"
     2484                       , input ?
     2485                       , input p-fbr-doc-code
     2486                       , input v-cntxt-userid
     2487                       , input 0
     2488                       , input (if p-ph-chip-num <> ?
     2489                               then p-ph-chip-num
     2490                               else (if varchip-code <> 0
     2491                                   then varchip-code
     2492                                   else ?)
     2493                               )
     2494                       , output varchip-code2
     2495                   ) no-error.
     2496                   if error-status :error
     2497                   then do:
     2498                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     2499                                                   ,buf_out_trn-doc.doc-code
     2500                                                   ,buf_trn-doc.doc-code
     2501                                                   ,p-fbr-doc-code
     2502                                                   , chr(10)
     2503                                                   , error-status:get-message(1)
     2504                                                   , return-value ).
     2505                   end.
     2506               end.
     2507           end.
     2508           run str/del-doc.p (
     2509                 input parparentproc
     2510               , input buf_trn-doc.doc-code
     2511               , input v-cntxt-db-num
     2512               , input "delfbr.err"
     2513               , input ?
     2514               , input p-fbr-doc-code
     2515               , input v-cntxt-userid
     2516               , input 0
     2517               , input (if p-ph-chip-num <> ?
     2518                        then p-ph-chip-num
     2519                        else (if varchip-code <> 0
     2520                              then varchip-code
     2521                              else ?)
     2522                        )
     2523               , output varchip-code2
     2524           ) no-error.
     2525           if error-status :error
     2526           then do:
     2527               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     2528                                             ,buf_trn-doc.doc-code
     2529                                             ,p-fbr-doc-code
     2530                                             , chr(10)
     2531                                             , error-status:get-message(1)
     2532                                             , return-value ).
     2533           end.
     2534           if p-doc-type = 'рас':U
     2535           or p-doc-type = 'спи':U
     2536           then do:
     2537               assign
     2538                   v-chip-counter = 0
     2539               .
     2540               for each buf_cons_trn-doc no-lock
     2541                  where buf_cons_trn-doc.out-code      = v-doc-code
     2542                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     2543               :
     2544                   assign
     2545                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     2546                       v-chip-counter = v-chip-counter + 1
     2547                   .
     2548                   assign
     2549                   varchip-code = if v-chip-counter = 2
     2550                                  then varchip-code2
     2551                                  else varchip-code.
     2552                   run str/del-doc.p (
     2553                         input parparentproc
     2554                       , input buf_cons_trn-doc.doc-code
     2555                       , input v-cntxt-db-num
     2556                       , input "delfbr.err"
     2557                       , input ?
     2558                       , input ?
     2559                       , input v-cntxt-userid
     2560                       , input 0
     2561                       , input (if p-ph-chip-num <> ?
     2562                                then p-ph-chip-num
     2563                                else ( if v-chip-counter = 1
     2564                                       then ?
     2565                                       else varchip-code )
     2566                                )
     2567                       , output varchip-code2
     2568                   ) no-error.
     2569                   if error-status :error
     2570                   then do:
     2571                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     2572                                                     ,buf_cons_trn-doc.doc-code
     2573                                                     ,p-fbr-doc-code
     2574                                                     , chr(10)
     2575                                                     , error-status:get-message(1)
     2576                                                     , return-value ).
     2577                   end.
     2578                   assign
     2579                       p-chip-num = varchip-code2
     2580                   .
     2581               end.
     2582           end.
     2583           assign
     2584               p-chip-num = varchip-code2
     2585           .
     2586       end.
     2587   end.
     2588   END PROCEDURE.
     2589   PROCEDURE fbrlib-print-del-error-message :
     2590   do
     2591   on error undo, return error
     2592   :
     2593       define variable v-user-action   as character    no-undo.
     2594       define variable v-printed       as logical      no-undo.
     2595       message
     2596           vss-workfile vss-revision vss-description
     2597           skip "Ошибка при удалении документа."
     2598           skip return-value
     2599           skip trim(error-status :get-message(1))
     2600           skip trim(error-status :get-message(2))
     2601           skip trim(error-status :get-message(3))
     2602       view-as alert-box error.
     2603       if search ("delfbr.err") <> ?
     2604       then do:
     2605         run gbl/prnfilen.w
     2606           (input  "Ошибки при удалении документа производства"
     2607           ,input  0
     2608           ,input  "delfbr.err"
     2609           ,input  7
     2610           ,output v-user-action
     2611           ,output v-printed
     2612           ).
     2613       end.
     2614   end.
     2615   END PROCEDURE.
     2616   procedure fbrlib-calc-brutto :
     2617   define input parameter p-recipe-type        as character        no-undo.
     2618   define input parameter p-netto              as decimal          no-undo.
     2619   define input parameter p-coeff-value        as decimal          no-undo.
     2620   define input parameter p-coeff-waste        as decimal          no-undo.
     2621   define input parameter p-brutto             as decimal          no-undo.
     2622   define input parameter p-calc-method        as integer          no-undo.
     2623   define output parameter p-new-netto         as decimal          no-undo.
     2624   define output parameter p-new-coeff-waste   as decimal          no-undo.
     2625   define output parameter p-new-brutto        as decimal          no-undo.
     2626   define output parameter p-new-calc-method   as integer          no-undo.
     2627   do
     2628   on error undo, return error
     2629   :
     2630       if p-recipe-type <> 'производство':U
     2631       then do:
     2632           assign
     2633               p-new-coeff-waste = 0
     2634               p-new-calc-method = 1
     2635               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     2636               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     2637           .
     2638       end.
     2639       else do:
     2640           assign
     2641               p-new-calc-method = p-calc-method
     2642           .
     2643           if p-coeff-waste = 0
     2644           then do:
     2645               assign
     2646                   p-coeff-value = 0
     2647               .
     2648           end.
     2649           case p-calc-method
     2650           :
     2651               when 1
     2652               then do:
     2653                   assign
     2654                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     2655                       p-new-coeff-waste   = p-coeff-waste
     2656                       p-new-brutto        = p-brutto
     2657                   .
     2658               end.
     2659               when 2
     2660               then do:
     2661                   assign
     2662                       p-new-netto         = p-netto
     2663                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     2664                       p-new-brutto        = p-brutto
     2665                   .
     2666               end.
     2667               when 3
     2668               then do:
     2669                   assign
     2670                       p-new-netto         = p-netto
     2671                       p-new-coeff-waste   = p-coeff-waste
     2672                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     2673                   .
     2674               end.
     2675               otherwise do:
     2676                   define variable v-yesno    as logical      no-undo.
     2677                   assign
     2678                       v-yesno = yes
     2679                   .
     2680                   message
     2681                       "Неверный метод для расчета брутто, нетто и процента потерь."
     2682                       skip "Значение метода должно быть 1, 2 или 3."
     2683                       skip(1)
     2684                       skip "Заданное значение:" p-calc-method
     2685                       skip(1)
     2686                       skip "Установить значение метода расчета 1"
     2687                       skip "(расчет нетто по брутто и проценту потерь)?"
     2688                   view-as alert-box warning
     2689                   buttons yes-no
     2690                   title "Неверное значение метода пересчета в строках документа-производства"
     2691                   update v-yesno
     2692                   .
     2693                   if v-yesno = yes
     2694                   then do:
     2695                       assign
     2696                           p-new-calc-method   = 1
     2697                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     2698                           p-new-coeff-waste   = p-coeff-waste
     2699                           p-new-brutto        = p-brutto
     2700                       .
     2701                   end.
     2702                   else do:
     2703                       message
     2704                               vss-workfile vss-revision vss-description
     2705                           skip(1)
     2706                           skip "Ошибка расчета брутто, нетто и процента потерь."
     2707                           skip return-value
     2708                           skip trim(error-status :get-message(1))
     2709                               trim(error-status :get-message(2))
     2710                               trim(error-status :get-message(3))
     2711                       view-as alert-box error
     2712                       title "Неверное значение метода расчета"
     2713                       .
     2714                       undo, return error .
     2715                   end.
     2716               end.
     2717           end case.
     2718       end.
     2719   end.
     2720   end procedure.
     2721   procedure fbrlib-check-brutto :
     2722   define input parameter p-recipe-type        as character        no-undo.
     2723   define input parameter p-netto              as decimal          no-undo.
     2724   define input parameter p-coeff-value        as decimal          no-undo.
     2725   define input parameter p-coeff-waste        as decimal          no-undo.
     2726   define input parameter p-brutto             as decimal          no-undo.
     2727   define input parameter p-calc-method        as integer          no-undo.
     2728   define output parameter p-error-message     as character        no-undo.
     2729   define output parameter p-not-good          as logical          no-undo.
     2730   do
     2731   on error undo, return error
     2732   :
     2733       if p-recipe-type <> 'производство':U
     2734       then do:
     2735           if p-netto <> p-brutto
     2736           or p-coeff-waste <> 0
     2737           then do:
     2738               assign
     2739                   p-not-good      = yes
     2740                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     2741                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     2742               .
     2743           end.
     2744       end.
     2745       else do:
     2746           if p-coeff-waste = 0
     2747           then do:
     2748               assign
     2749                   p-coeff-value = 0
     2750               .
     2751           end.
     2752           case p-calc-method
     2753           :
     2754               when 1
     2755               then do:
     2756                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     2757                   then do:
     2758                       assign
     2759                           p-not-good      = yes
     2760                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     2761                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     2762                       .
     2763                   end.
     2764               end.
     2765               when 2
     2766               then do:
     2767                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     2768                   then do:
     2769                       assign
     2770                           p-not-good      = yes
     2771                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     2772                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     2773                       .
     2774                   end.
     2775               end.
     2776               when 3
     2777               then do:
     2778                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     2779                   then do:
     2780                       assign
     2781                           p-not-good      = yes
     2782                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     2783                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     2784                       .
     2785                   end.
     2786               end.
     2787               otherwise do:
     2788                   assign
     2789                       p-not-good      = yes
     2790                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     2791                   .
     2792               end.
     2793           end case.
     2794       end.
     2795   end.
     2796   end procedure.
     2797   procedure fbrlib-check-fbr-recipe :
     2798   define input parameter p-doc-code       as character        no-undo.
     2799   define input parameter p-recipe-code    as character        no-undo.
     2800   define output parameter p-is-correct    as logical          no-undo.
     2801       define variable v-comp-factor    as decimal      no-undo.
     2802       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     2803       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2804       define buffer buf_fbr-line          for ub.fbr-line.
     2805   do
     2806   for buf_fbr-recipe
     2807     , buf_fbr-recipe-gds
     2808     , buf_fbr-line
     2809   on error undo, return error
     2810   :
     2811       assign
     2812           p-is-correct = yes
     2813       .
     2814       find first buf_fbr-recipe no-lock
     2815            where buf_fbr-recipe.doc-code    = p-doc-code
     2816              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     2817       .
     2818       if not available buf_fbr-recipe then do:
     2819         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     2820       end.
     2821       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     2822       then do:
     2823       end.
     2824       else do:
     2825           find first buf_fbr-line no-lock
     2826                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     2827                  and buf_fbr-line.is-comp     = yes
     2828                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     2829                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     2830                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     2831                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     2832           .
     2833           assign
     2834               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     2835           .
     2836           recipe-line-cycle:
     2837           for each buf_fbr-recipe-gds no-lock
     2838              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2839                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2840           on error undo, return error
     2841           :
     2842               find first buf_fbr-line no-lock
     2843                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     2844                      and buf_fbr-line.is-comp     = no
     2845                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     2846                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     2847                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     2848                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     2849               .
     2850               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     2851               then do:
     2852                   assign
     2853                       p-is-correct = no
     2854                   .
     2855                   leave recipe-line-cycle.
     2856               end.
     2857           end.
     2858       end.
     2859   end.
     2860   end procedure.
     2861   procedure fbrlib-get-recipe-type :
     2862   define input parameter p-fbr-doc-code   as character        no-undo.
     2863   define input parameter p-recipe-code    as character        no-undo.
     2864   define output parameter p-recipe-type   as character        no-undo.
     2865       define buffer buf_recipe        for ub.recipe.
     2866       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     2867   do
     2868   for buf_recipe
     2869     , buf_fbr-recipe
     2870   on error undo, return error
     2871   :
     2872       if p-fbr-doc-code = ""
     2873       then do:
     2874           find first buf_recipe no-lock
     2875                where buf_recipe.recipe-code = p-recipe-code
     2876           no-error.
     2877           if available buf_recipe
     2878           then do:
     2879               assign
     2880                   p-recipe-type = buf_recipe.recipe-type
     2881               .
     2882           end.
     2883           else do:
     2884               assign
     2885                   p-recipe-type = "":U
     2886               .
     2887           end.
     2888       end.
     2889       else do:
     2890           find first buf_fbr-recipe no-lock
     2891                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     2892                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     2893           no-error.
     2894           if available buf_fbr-recipe
     2895           then do:
     2896               assign
     2897                   p-recipe-type = buf_fbr-recipe.recipe-type
     2898               .
     2899           end.
     2900           else do:
     2901               assign
     2902                   p-recipe-type = "":U
     2903               .
     2904           end.
     2905       end.
     2906   end.
     2907   end procedure.
     2908   PROCEDURE calc-comp-from-ingr :
     2909   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     2910   define input parameter p-fact-qnty                          as decimal      no-undo.
     2911   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     2912   define output parameter p-comp-qnty                         as decimal      no-undo.
     2913       define variable v-ingr-qnty     as decimal       no-undo.
     2914       define buffer buf_i_fbr-line    for ub.fbr-line.
     2915       define buffer buf_fbr-line      for ub.fbr-line.
     2916       define buffer buf_recipe        for ub.fbr-recipe.
     2917       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     2918   do
     2919   for buf_i_fbr-line
     2920     , buf_fbr-line
     2921     , buf_recipe
     2922     , buf_recipe-gds
     2923   on error undo, return error
     2924   :
     2925       find first buf_i_fbr-line no-lock
     2926            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     2927       .
     2928       find first buf_recipe no-lock
     2929            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     2930              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     2931       no-error.
     2932       if not available buf_recipe
     2933       then do:
     2934           message
     2935                   vss-workfile vss-revision vss-description
     2936               skip "В строке производства не указан рецепт."
     2937               skip "Невозможно рассчитать количество составного товара."
     2938               skip return-value
     2939               skip trim(error-status :get-message(1))
     2940                   trim(error-status :get-message(2))
     2941                   trim(error-status :get-message(3))
     2942           view-as alert-box error.
     2943           undo, return error .
     2944       end.
     2945       if buf_recipe.recipe-type = 'альтернатива':U
     2946       then do:
     2947           for each buf_fbr-line no-lock
     2948              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     2949                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     2950                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     2951           on error undo, return error
     2952           :
     2953               find first buf_recipe-gds no-lock
     2954                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     2955                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     2956                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     2957                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     2958                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     2959               .
     2960               assign
     2961                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     2962               .
     2963           end.
     2964           assign
     2965               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     2966           .
     2967       end.
     2968       else do:
     2969           find first buf_recipe-gds no-lock
     2970                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     2971                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     2972                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     2973                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     2974                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     2975           .
     2976           assign
     2977               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     2978           .
     2979       end.
     2980       find first buf_fbr-line no-lock
     2981            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     2982              and buf_fbr-line.is-comp     = yes
     2983              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     2984       .
     2985       assign
     2986           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     2987       .
     2988   end.
     2989   END PROCEDURE.
     2990   PROCEDURE get-temp_dressing-ingr-used-qnty :
     2991   define input parameter p-recipe-code    as character    no-undo.
     2992   define input parameter p-gds-code       as integer      no-undo.
     2993   define output parameter p-line-qnty     as decimal      no-undo.
     2994   define output parameter p-used-qnty     as decimal      no-undo.
     2995   define output parameter p-recipe-qnty   as decimal      no-undo.
     2996       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     2997   do
     2998   for buf_temp_dressing-ingr
     2999   on error undo, return error
     3000   :
     3001       find first buf_temp_dressing-ingr no-lock
     3002            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     3003              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     3004       no-error.
     3005       if available buf_temp_dressing-ingr
     3006       then do:
     3007           assign
     3008               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     3009               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     3010               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     3011           .
     3012       end.
     3013       else do:
     3014           assign
     3015               p-line-qnty     = 0
     3016               p-used-qnty     = 0
     3017               p-recipe-qnty   = 0
     3018           .
     3019       end.
     3020   end.
     3021   END PROCEDURE.
     3022   PROCEDURE fbrlib_adjust-recipe :
     3023   do
     3024   on error undo, return error
     3025   :
     3026   define input parameter parparentproc as widget-handle no-undo .
     3027   define input parameter p-fbrhist-handle as handle no-undo .
     3028   define input parameter p-doc-code       as character    no-undo.
     3029   define input parameter p-recipe-code    as character    no-undo.
     3030   define input parameter p-price-sale-obj-type as character no-undo .
     3031   define input parameter p-price-sale-obj-code as integer no-undo .
     3032       define variable v-recipe-qnty       as decimal      no-undo.
     3033       define variable v-comp-qnty         as decimal      no-undo.
     3034       define variable v-recipe-gds-qnty   as decimal      no-undo.
     3035       define variable v-ingr-qnty         as decimal      no-undo.
     3036       define variable v-qnty              as decimal      no-undo.
     3037       define variable v-coeff-waste       as decimal      no-undo.
     3038       define variable v-brutto-qnty       as decimal      no-undo.
     3039       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3040       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3041       define buffer buf_fbr-line          for ub.fbr-line.
     3042       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     3043       find first buf_fbr-recipe no-lock
     3044            where buf_fbr-recipe.doc-code      = p-doc-code
     3045              and buf_fbr-recipe.recipe-code   = p-recipe-code
     3046       .
     3047       assign
     3048           v-recipe-qnty = buf_fbr-recipe.qnty
     3049       .
     3050       find first buf_fbr-line no-lock
     3051            where buf_fbr-line.doc-code    = p-doc-code
     3052              and buf_fbr-line.is-comp     = yes
     3053              and buf_fbr-line.recipe-code = p-recipe-code
     3054       .
     3055       assign
     3056           v-comp-qnty = buf_fbr-line.fact-qnty
     3057       .
     3058       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3059       then do:
     3060       end.
     3061       else do:
     3062           for each buf_fbr-recipe-gds no-lock
     3063              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3064                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3065           on error undo, return error
     3066           :
     3067               find first buf_fbr-line no-lock
     3068                    where buf_fbr-line.doc-code    = p-doc-code
     3069                      and buf_fbr-line.is-comp     = no
     3070                      and buf_fbr-line.recipe-code = p-recipe-code
     3071                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3072                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3073                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3074               .
     3075               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     3076               then do:
     3077                   do transaction
     3078                   on error undo, return error
     3079                   :
     3080                       find first buf_el_fbr-recipe-gds exclusive-lock
     3081                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     3082                       .
     3083                       assign
     3084                           buf_el_fbr-recipe-gds.calc-method   = 1
     3085                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     3086                       .
     3087                       run fbrlib-calc-brutto in this-procedure (
     3088                             input buf_fbr-recipe.recipe-type
     3089                           , input 0
     3090                           , input buf_el_fbr-recipe-gds.coeff-value
     3091                           , input buf_el_fbr-recipe-gds.coeff-waste
     3092                           , input buf_el_fbr-recipe-gds.brutto-qnty
     3093                           , input 1
     3094                           , output buf_el_fbr-recipe-gds.qnty
     3095                           , output buf_el_fbr-recipe-gds.coeff-waste
     3096                           , output buf_el_fbr-recipe-gds.brutto-qnty
     3097                           , output buf_el_fbr-recipe-gds.calc-method
     3098                       ).
     3099                   end.
     3100               end.
     3101           end.
     3102           run fbrlib_adjust-doc-lines in this-procedure (
     3103                 input parparentproc
     3104               , input p-fbrhist-handle
     3105               , input p-doc-code
     3106               , input p-recipe-code
     3107               , input p-price-sale-obj-type
     3108               , input p-price-sale-obj-code
     3109           ).
     3110       end.
     3111   end.
     3112   END PROCEDURE.
     3113   PROCEDURE fbrlib_adjust-doc-lines :
     3114   define input parameter parparentproc as widget-handle no-undo .
     3115   define input parameter p-fbrhist-handle as handle no-undo .
     3116   define input parameter p-doc-code       as character    no-undo.
     3117   define input parameter p-recipe-code    as character    no-undo.
     3118   define input parameter p-price-sale-obj-type as character no-undo .
     3119   define input parameter p-price-sale-obj-code as integer no-undo .
     3120   define variable v-comp-qnty         as decimal      no-undo.
     3121   define variable v-trn-type          as character    no-undo.
     3122   define variable v-ingr-qnty         as decimal      no-undo.
     3123   define variable v-recipe-qnty       as decimal      no-undo.
     3124   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     3125   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3126   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3127   define buffer buf_fbr-line          for ub.fbr-line.
     3128   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     3129   define buffer buf_goods             for ub.goods.
     3130   define buffer buf_fbr-doc           for ub.fbr-doc.
     3131   do
     3132   for buf_fbr-recipe
     3133     , buf_fbr-recipe-gds
     3134     , buf_fbr-line
     3135     , buf_coeff_fbr-line
     3136     , buf_goods
     3137     , buf_fbr-doc
     3138   on error undo, return error
     3139   :
     3140       find first buf_fbr-line no-lock
     3141            where buf_fbr-line.doc-code      = p-doc-code
     3142              and buf_fbr-line.is-comp       = yes
     3143              and buf_fbr-line.recipe-code   = p-recipe-code
     3144       .
     3145       find first buf_fbr-doc no-lock
     3146            where buf_fbr-doc.doc-code      = p-doc-code
     3147       .
     3148       assign
     3149           v-comp-qnty = buf_fbr-line.fact-qnty
     3150           v-trn-type  = buf_fbr-line.trn-type
     3151       .
     3152       find first buf_fbr-recipe no-lock
     3153            where buf_fbr-recipe.doc-code    = p-doc-code
     3154              and buf_fbr-recipe.recipe-code = p-recipe-code
     3155       .
     3156       assign
     3157       v-recipe-qnty = buf_fbr-recipe.qnty
     3158       .
     3159       do transaction
     3160       on error undo, return error
     3161       :
     3162           for each buf_fbr-recipe-gds no-lock
     3163              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     3164                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     3165           on error undo, return error
     3166           :
     3167               find first buf_fbr-line no-lock
     3168                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3169                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3170                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3171                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3172                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3173               no-error.
     3174               if not available buf_fbr-line
     3175               then do:
     3176                   find first buf_goods no-lock
     3177                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     3178                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     3179                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     3180                   .
     3181                   run str/fbr-crln.p (
     3182                         input parparentproc
     3183                       , input recid( buf_fbr-doc )
     3184                       , input recid( buf_goods )
     3185                       , input buf_fbr-recipe-gds.recipe-code
     3186                       , input v-trn-type
     3187                       , input no
     3188                       , input no
     3189                       , input buf_fbr-doc.obj-type
     3190                       , input buf_fbr-doc.obj-code
     3191                       , output v-fbr-v-fbr-doc-line-recid
     3192                   ).
     3193                   find first buf_fbr-line no-lock
     3194                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3195                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3196                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3197                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3198                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3199                   no-error.
     3200                   if not available buf_fbr-line
     3201                   then do:
     3202                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     3203                                                      , p-doc-code
     3204                                                      , buf_fbr-recipe-gds.artic
     3205                                                      , buf_fbr-recipe-gds.prod-type
     3206                                                      , buf_fbr-recipe-gds.prod-code).
     3207                   end.
     3208               end.
     3209               find first buf_coeff_fbr-line exclusive-lock
     3210                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     3211               .
     3212               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     3213               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     3214               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     3215               then do:
     3216                   assign
     3217                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     3218                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     3219                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     3220                   .
     3221               end.
     3222           end.
     3223       end.
     3224       define variable v-need-goods    as logical       no-undo.
     3225       define variable v-need-goods-list       as character     no-undo.
     3226       define variable v-need-goods-qnty-list  as character     no-undo.
     3227       find first buf_fbr-line no-lock
     3228            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     3229              and buf_fbr-line.is-comp     = yes
     3230              and buf_fbr-line.recipe-code = p-recipe-code
     3231       .
     3232       run str/fbr-qnty.p (
     3233             input parparentproc
     3234           , input p-fbrhist-handle
     3235           , input recid( buf_fbr-doc )
     3236           , input recid( buf_fbr-line )
     3237           , input no
     3238           , input "ingr"
     3239           , input no
     3240           , input p-price-sale-obj-type
     3241           , input p-price-sale-obj-code
     3242           , input no
     3243           , input no
     3244           , input no
     3245           , output v-need-goods
     3246           , output v-need-goods-list
     3247           , output v-need-goods-qnty-list
     3248       ).
     3249   end.
     3250   END PROCEDURE.
     3251   procedure fbrlib_check-before-close :
     3252   define input parameter p-doc-code as character no-undo .
     3253   define variable same-sale as decimal no-undo .
     3254   define variable is-waste as logical no-undo .
     3255   define variable fix-price as logical no-undo .
     3256   define buffer buf_fbr-doc for ub.fbr-doc.
     3257   define buffer buf_fbr-line for ub.fbr-line.
     3258   define buffer buf_goods for ub.goods.
     3259   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3260   do
     3261   on error undo, return error
     3262   :
     3263     for each buf_fbr-line no-lock
     3264         where buf_fbr-line.doc-code = p-doc-code
     3265       , each buf_goods no-lock
     3266         where buf_goods.artic     = buf_fbr-line.artic
     3267           and buf_goods.prod-type = buf_fbr-line.prod-type
     3268           and buf_goods.prod-code = buf_fbr-line.prod-code
     3269     break by buf_fbr-line.prod-type
     3270           by buf_fbr-line.prod-code
     3271           by buf_fbr-line.artic
     3272     :
     3273       if first-of (buf_fbr-line.artic)
     3274       then do:
     3275         assign
     3276         same-sale = buf_fbr-line.price-sale
     3277         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     3278         fix-price = buf_fbr-line.is-calc
     3279         .
     3280       end.
     3281       if same-sale <> buf_fbr-line.price-sale
     3282       then do:
     3283           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     3284                                         ,p-doc-code
     3285                                         ,buf_goods.artic
     3286                                         ,buf_goods.gds-name
     3287                                         ,chr(10)).
     3288       end.
     3289       if fix-price <> buf_fbr-line.is-calc then do:
     3290           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     3291                                         ,p-doc-code
     3292                                         ,buf_goods.artic
     3293                                         ,buf_goods.gds-name
     3294                                         ,chr(10)).
     3295       end.
     3296       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     3297       then do:
     3298         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     3299                                         ,p-doc-code
     3300                                         ,buf_goods.artic
     3301                                         ,buf_goods.gds-name
     3302                                         ,chr(10)).
     3303       end.
     3304       if buf_fbr-line.rsrv-qnty <> ?
     3305       and buf_goods.gds-type <> 'у':U
     3306       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     3307       and buf_fbr-line.fact-qnty <> 0
     3308       then do:
     3309         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     3310           if  can-find(first buf_fbr-gds-obj no-lock where
     3311                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     3312               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     3313               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     3314               and buf_fbr-gds-obj.is-null-price  )  then .
     3315                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     3316                                         ,p-doc-code
     3317                                         ,buf_goods.artic
     3318                                         ,buf_goods.gds-name
     3319                                         ,chr(10)
     3320                                         ,buf_fbr-line.recipe-code
     3321                                         ).
     3322         end.
     3323         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     3324                                         ,p-doc-code
     3325                                         ,buf_goods.artic
     3326                                         ,buf_goods.gds-name
     3327                                         ,chr(10)
     3328                                         ,buf_fbr-line.recipe-code
     3329                                         ).
     3330       end.
     3331     end.
     3332   end.
     3333   end procedure.
     3334   define variable v-host-code             as integer      no-undo.
     3335   define variable v-fbr-frcp              as logical    no-undo.
     3336   define variable v-type                  as character    no-undo.
     3337   define variable v-recipe-type           as character    no-undo.
     3338   define variable v-recipe-list           as character    no-undo.
     3339   define variable v-is-comp               as logical      no-undo.
     3340   define variable v-is-integration        as logical      no-undo.
     3341   define variable v-cancel                as logical      no-undo.
     3342   define variable v-yesno                 as logical      no-undo.
     3343   define variable v-default-recipe-code   as character    no-undo.
     3344   define variable v-value-character as character  no-undo .
     3345   define variable v-value-date      as date       no-undo .
     3346   define variable v-value-decimal   as decimal    no-undo .
     3347   define variable v-value-integer   as integer    no-undo .
     3348   define variable v-tth             as handle     no-undo .
     3349   define variable v-param-type            as character no-undo .
     3350   define buffer buf_recipe            for recipe.
     3351   define buffer buf_goods             for goods.
     3352   define buffer buf_selected_recipe   for recipe.
     3353   define buffer buf_recipe-gds        for recipe-gds.
     3354   do
     3355   for buf_recipe
     3356     , buf_goods
     3357     , buf_selected_recipe
     3358     , buf_recipe-gds
     3359   on error undo, return error
     3360   :
     3361       run writelog in this-procedure (
     3362             input log-file-name
     3363           , input 0
     3364           , input "******** select-recipe ***************************************"
     3365       ).
     3366       find first buf_goods no-lock
     3367            where buf_goods.gds-code = p-gds-code
     3368       .
     3369       if p-trn-type = ?
     3370       then do:
     3371           run writelog in this-procedure ( log-file-name, 0, "Не определен тип строки. Добавление невозможно" ).
     3372           undo, return error.
     3373       end.
     3374   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3376     (input  p-obj-type
     3377     ,input  p-obj-code
     3378     ,output v-host-code
     3379     )  .
     3380      run adm/shattri.p ( input "get":U
     3381                        , input  '':u
     3382                        , input  0
     3383                        , input  'fbrattr':U
     3384                        , input  'fbr-frcp':U
     3385                        , output v-value-character
     3386                        , output v-value-date
     3387                        , output v-value-decimal
     3388                        , output v-value-integer
     3389                        , output v-fbr-frcp
     3390                        , output v-param-type
     3391                        , input-output table-handle v-tth
     3392                        ) no-error .
     3393      if error-status :error then do:
     3394         assign
     3395            v-fbr-frcp = FALSE
     3396         .
     3397      end.
     3398       run writelog in this-procedure (
     3399             input log-file-name
     3400           , input 1
     3401           , input substitute( "v-fbr-frcp = '&1'", v-fbr-frcp )
     3402       ).
     3403       assign
     3404           p-out-recipe-type = ?
     3405           p-out-recipe-code = ?
     3406           v-recipe-type = ?
     3407       .
     3408       run fbrlib-get-obj-recipe in this-procedure (
     3409             input p-obj-type
     3410           , input p-obj-code
     3411           , input p-gds-code
     3412           , output v-default-recipe-code
     3413       ).
     3414       comp-recipe:
     3415       for each buf_recipe no-lock
     3416          where ( buf_recipe.obj-type = p-obj-type
     3417              and buf_recipe.obj-code = p-obj-code
     3418              and buf_recipe.artic     = buf_goods.artic
     3419              and buf_recipe.prod-type = buf_goods.prod-type
     3420              and buf_recipe.prod-code = buf_goods.prod-code
     3421             )
     3422             or ( buf_recipe.obj-type = ""
     3423              and buf_recipe.obj-code = 0
     3424              and buf_recipe.artic     = buf_goods.artic
     3425              and buf_recipe.prod-type = buf_goods.prod-type
     3426              and buf_recipe.prod-code = buf_goods.prod-code
     3427             )
     3428       :
     3429           if ( p-autofbr = yes or v-fbr-frcp = yes )
     3430           and buf_recipe.recipe-code <> v-default-recipe-code
     3431           then do:
     3432               undo comp-recipe, next comp-recipe.
     3433           end.
     3434           run writelog in this-procedure (
     3435                 input log-file-name
     3436               , input 3
     3437               , input substitute( "Рецепт: &1. Тип: &2 " , buf_recipe.recipe-code, buf_recipe.recipe-type )
     3438           ).
     3439           if p-autofbr = yes
     3440           and buf_recipe.recipe-type <> 'производство':U
     3441           and buf_recipe.recipe-type <> 'альтернатива':U
     3442           then do:
     3443               next comp-recipe.
     3444           end.
     3445           if p-trn-type = 'при':U
     3446           and buf_recipe.recipe-type = 'разделка':U
     3447           then do:
     3448               run writelog in this-procedure (
     3449                     input log-file-name
     3450                   , input 4
     3451                   , input "Разделка для составного не может дать прихода. Ищем следующий рецепт"
     3452               ).
     3453               next comp-recipe.
     3454           end.
     3455           if p-trn-type = 'спи':U
     3456           and buf_recipe.recipe-type <> 'разделка':U
     3457           and buf_recipe.recipe-type <> 'комплектация':U
     3458           then do:
     3459               run writelog in this-procedure (
     3460                     input log-file-name
     3461                   , input 4
     3462                   , input "Только разделка или разукомплектация для составного может дать списание. Ищем следующий рецепт"
     3463               ).
     3464               next comp-recipe.
     3465           end.
     3466           if v-recipe-type = ?
     3467           then do:
     3468               assign
     3469                   p-out-recipe-type = buf_recipe.recipe-type
     3470                   p-out-recipe-code = buf_recipe.recipe-code
     3471                   v-recipe-type = "recipe"
     3472                   v-is-integration = yes
     3473               .
     3474               run writelog in this-procedure (
     3475                     input log-file-name
     3476                   , input 4
     3477                   , input "Найден первый подходящий рецепт для составного"
     3478               ).
     3479               if v-fbr-frcp = yes
     3480               then do:
     3481                   run writelog in this-procedure (
     3482                       input log-file-name
     3483                       , input 4
     3484                       , input "Включен параметр v-fbr-frcp. Больше рецепт не ищем"
     3485                   ).
     3486                   leave comp-recipe.
     3487               end.
     3488               if p-autofbr = yes
     3489               then do:
     3490                   run writelog in this-procedure (
     3491                         input log-file-name
     3492                       , input 4
     3493                       , input "Раскрутка для ресторана. Больше рецепт не ищем"
     3494                   ).
     3495                   leave comp-recipe.
     3496               end.
     3497           end.
     3498           else do:
     3499               run writelog in this-procedure (
     3500                     input log-file-name
     3501                   , input 4
     3502                   , input "Найден еще один подходящий рецепт"
     3503               ).
     3504               assign
     3505                   v-yesno = ?
     3506                   p-no-need-good = yes
     3507               .
     3508               do while v-yesno = ?
     3509               and p-no-need-good = yes
     3510               :
     3511                   run ref/rcp-all.w (
     3512                         input parparentproc
     3513                       , input "b-sel"
     3514                       , input 'все':U
     3515                       , input recid( buf_goods )
     3516                       , input p-obj-type
     3517                       , input p-obj-code
     3518                       , output v-recipe-list
     3519                   ) no-error.
     3520                   if error-status :error
     3521                   or v-recipe-list = ""
     3522                   then do:
     3523                       message
     3524                           "Отменить добавление товара?"
     3525                           skip(1)
     3526                           skip "Товар:" buf_goods.artic buf_goods.gds-name
     3527                           skip(1)
     3528                           skip "Yes - отменить добавление текущего товара"
     3529                           skip "No  - отменить добавление товаров"
     3530                           skip "Cancel - вернуться к выбору рецептов"
     3531                       view-as alert-box question
     3532                       buttons yes-no-cancel
     3533                       title "Отмена"
     3534                       update v-yesno
     3535                       .
     3536                   end.
     3537                   else do:
     3538                       assign
     3539                           p-no-need-good = no
     3540                       .
     3541                   end.
     3542               end.
     3543               if p-no-need-good = yes
     3544               then do:
     3545                   if v-yesno = no
     3546                   then do:
     3547                       undo, return error .
     3548                   end.
     3549                   else do:
     3550                       return.
     3551                   end.
     3552               end.
     3553               find first buf_selected_recipe no-lock
     3554                    where recid( buf_selected_recipe ) = integer( entry( 1, v-recipe-list ) )
     3555               no-error.
     3556               if not available buf_selected_recipe
     3557               then do:
     3558                   assign
     3559                       p-out-recipe-type = ?
     3560                       p-out-recipe-code = ?
     3561                       v-is-integration  = ?
     3562                   .
     3563               end.
     3564               else do:
     3565                   assign
     3566                       p-out-recipe-type   = buf_selected_recipe.recipe-type
     3567                       p-out-recipe-code   = buf_selected_recipe.recipe-code
     3568                       v-recipe-type       = "recipe"
     3569                       v-is-integration    = yes
     3570                   .
     3571                   leave comp-recipe.
     3572               end.
     3573           end.
     3574       end.
     3575       if v-recipe-type = ?
     3576       and p-autofbr = no
     3577       then do:
     3578           run writelog in this-procedure (
     3579                 input log-file-name
     3580               , input 3
     3581               , input "Поиск товара среди ингредиентов рецептов."
     3582           ).
     3583           search-recipe-gds:
     3584           for each buf_recipe-gds
     3585              where buf_recipe-gds.artic       = buf_goods.artic
     3586                and buf_recipe-gds.prod-type   = buf_goods.prod-type
     3587                and buf_recipe-gds.prod-code   = buf_goods.prod-code
     3588           :
     3589               find first buf_recipe no-lock
     3590                    where buf_recipe.recipe-code = buf_recipe-gds.recipe-code
     3591               .
     3592               if AVAILABLE buf_recipe then do:
     3593               run writelog in this-procedure (
     3594                     input log-file-name
     3595                   , input 3
     3596                   , input substitute( "Рецепт: &1. Тип: &2 " , buf_recipe.recipe-code, buf_recipe.recipe-type )
     3597               ).
     3598               if p-trn-type = 'при':U
     3599               and buf_recipe.recipe-type <> 'разделка':U
     3600               and buf_recipe.recipe-type <> 'комплектация':U
     3601               then do:
     3602                   run writelog in this-procedure (
     3603                         input log-file-name
     3604                       , input 3
     3605                       , input "Тип не подходит. Только разделка или разукомплектация для ингредиента может дать приход"
     3606                   ).
     3607                   next search-recipe-gds.
     3608               end.
     3609               if p-trn-type = 'спи':U
     3610               and buf_recipe.recipe-type = 'разделка':U
     3611               then do:
     3612                   run writelog in this-procedure (
     3613                         input log-file-name
     3614                       , input 3
     3615                       , input "Тип не подходит. Разделка для ингредиента не может дать списания"
     3616                   ).
     3617                   next search-recipe-gds.
     3618               end.
     3619               if v-recipe-type = ?
     3620               then do:
     3621                   assign
     3622                       p-out-recipe-type   = buf_recipe.recipe-type
     3623                       p-out-recipe-code   = buf_recipe.recipe-code
     3624                       v-recipe-type       = "recipe-gds"
     3625                       v-is-integration    = no
     3626                   .
     3627                   if v-fbr-frcp = yes
     3628                   then do:
     3629                       leave search-recipe-gds.
     3630                   end.
     3631               end.
     3632               else do:
     3633                   assign
     3634                       p-out-recipe-type = ?
     3635                       p-out-recipe-code = p-out-recipe-code + chr(44) + buf_recipe.recipe-code
     3636                       v-is-integration  = ?
     3637                   .
     3638               end.
     3639             end.
     3640       end.
     3641       end.
     3642       if p-out-recipe-type = ?
     3643       and p-out-recipe-code = ?
     3644       then do:
     3645           assign
     3646               p-recipe-found = no
     3647           .
     3648       end.
     3649       else do:
     3650           if p-out-recipe-type = ?
     3651           then do:
     3652               define variable v-recipe-recid-list as character     no-undo.
     3653               run str/rcp-sel.w (
     3654                     input parparentproc
     3655                   , input buf_goods.gds-code
     3656                   , input 'при':U
     3657                   , output p-out-recipe-code
     3658                   , output v-is-integration
     3659                   , output v-cancel
     3660               ) .
     3661               if v-cancel = yes
     3662               then do:
     3663                   assign
     3664                       p-recipe-found = no
     3665                       p-no-need-good = yes
     3666                   .
     3667                   return.
     3668               end.
     3669           end.
     3670           assign
     3671               p-recipe-found = yes
     3672           .
     3673           find first buf_recipe no-lock
     3674                where buf_recipe.recipe-code = p-out-recipe-code
     3675           .
     3676           find first buf_goods no-lock
     3677                where buf_goods.artic      = buf_recipe.artic
     3678                  and buf_goods.prod-type  = buf_recipe.prod-type
     3679                  and buf_goods.prod-code  = buf_recipe.prod-code
     3680           .
     3681           assign
     3682               p-out-recipe-type   = buf_recipe.recipe-type
     3683               p-out-gds-code      = buf_goods.gds-code
     3684           .
     3685           run fbrlib-get-trn-type in this-procedure (
     3686                 input buf_recipe.recipe-code
     3687               , input recid( buf_goods )
     3688               , input v-is-integration
     3689               , output v-is-comp
     3690               , output p-out-trn-type
     3691           ).
     3692           run writelog in this-procedure (
     3693                 input log-file-name
     3694               , input 1
     3695               , input substitute( "Найден рецепт '&1' с is-comp = &2, товаром '&3 &4', типом &5"
     3696                                   , p-out-recipe-code
     3697                                   , v-is-comp
     3698                                   , buf_goods.artic
     3699                                   , buf_goods.gds-name
     3700                                   , p-out-trn-type )
     3701           ).
     3702           if p-out-gds-code <> p-gds-code
     3703           then do:
     3704               run writelog in this-procedure (
     3705                     input log-file-name
     3706                   , input 1
     3707                   , input "Необходимый товар является ингредиентом"
     3708               ).
     3709               find first buf_goods no-lock
     3710                    where buf_goods.gds-code = p-gds-code
     3711               .
     3712               find first buf_recipe-gds no-lock
     3713                    where buf_recipe-gds.recipe-code = buf_recipe.recipe-code
     3714                      and buf_recipe-gds.artic       = buf_goods.artic
     3715                      and buf_recipe-gds.prod-type   = buf_goods.prod-type
     3716                      and buf_recipe-gds.prod-code   = buf_goods.prod-code
     3717               .
     3718               if buf_recipe-gds.brutto-qnty = ?
     3719               or buf_recipe-gds.brutto-qnty = 0
     3720               then do:
     3721                   message
     3722                       "При раскрутке рецепта обнаружен ингредиент с количеством " buf_recipe-gds.brutto-qnty
     3723                       skip "Продолжение расчета документа невозможно."
     3724                       skip(1) "Код рецепта:      " buf_recipe.recipe-code
     3725                       skip    "Товар ингредиента:" buf_recipe-gds.artic buf_goods.gds-name
     3726                   view-as alert-box error.
     3727                   undo, return error .
     3728               end.
     3729               assign
     3730                   p-out-gds-qnty = p-gds-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     3731                   p-out-trn-type = ( if p-trn-type = 'спи':U then 'при':U else 'спи':U )
     3732               .
     3733               run writelog in this-procedure (
     3734                   input log-file-name
     3735                   , input 1
     3736                   , input substitute( "Количество товара: &1. Для его производства необходимо: &2 по рецепту: &3. Тип строки составного: &4."
     3737                                       , p-gds-qnty
     3738                                       , p-out-gds-qnty
     3739                                       , p-out-recipe-code
     3740                                       , p-out-trn-type )
     3741               ).
     3742           end.
     3743           else do:
     3744               assign
     3745                   p-out-gds-qnty = p-gds-qnty
     3746                   p-out-trn-type = p-trn-type
     3747               .
     3748               run writelog in this-procedure (
     3749                     input log-file-name
     3750                   , input 1
     3751                   , input substitute( "Для производства товара необходимо: &1 по рецепту: &2. Тип строки: &3."
     3752                                       , p-out-gds-qnty
     3753                                       , p-out-recipe-code
     3754                                       , p-out-trn-type )
     3755               ).
     3756           end.
     3757       end.
     3758   end.
