       16   define output parameter p-no-need-good      as logical      no-undo.
       17   define variable vss-revision    as character no-undo init "$Revision: 54c02665e029, 526, rls $":U .
       18   define variable vss-author      as character no-undo init "$Author: SShalanin $":U .
