        1   block-level on error undo, throw.
        2   define input parameter p-user-id like ub.c-usr-hist.user-id no-undo .
        3   define input parameter p-chip-num like ub.c-usr-hist.chip-num no-undo .
        4   define input parameter p-corr-user-db-num like ub.c-usr-hist.corr-user-db-num no-undo .
        5   define input parameter p-subject like ub.c-usr-hist.subject no-undo .
        6   define input parameter p-action   like ub.c-usr-hist.action no-undo .
        7   define input parameter p-silent  as logical no-undo .
        8   define output parameter p-description as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: 4886e87b5a2b, 3169, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
       11   define variable vss-date        as character no-undo init "$Date: 2022/12/27 12:54:23 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: cuserhistv.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: str/cuserhistv.p $":U .
       14   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории пользователя".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   procedure placattr-name :
       75   do
       76     on error undo, return error
       77     :
       78     define input  parameter p-code           as character no-undo .
       79     define output parameter p-type           as character no-undo .
       80     define output parameter p-format         as character no-undo .
       81     define output parameter p-label          as character no-undo .
       82     define output parameter p-user-can-edit  as logical   no-undo .
       83     define output parameter p-output-display as logical   no-undo .
       84     define output parameter p-other          as character no-undo .
       85       case p-code :
       86         otherwise do:
       87           undo, return error "неизвестный атрибут складского места" + " " + p-code .
       88         end.
       89       end.
       90     end.
       91   end procedure.
       92   procedure placattr-tooltip :
       93   do
       94     on error undo, return error
       95     :
       96       define input  parameter p-code    as character no-undo .
       97       define output parameter p-tooltip as character no-undo .
       98       define output parameter p-label   as character no-undo .
       99       case p-code :
      100         otherwise do:
      101           undo, return error "Неизвестный атрибут складского места" + " " + p-code .
      102         end.
      103       end.
      104     end.
      105   end procedure.
      106   procedure placattr-value :
      107    do
      108     on error undo, return error
      109     :
      110       define input  parameter p-code     like ub.place-attr.attr-code  no-undo .
      111       define input  parameter p-obj-type like ub.place-attr.obj-type   no-undo .
      112       define input  parameter p-obj-code like ub.place-attr.obj-code   no-undo .
      113       define input  parameter p-pl-code like ub.place-attr.pl-code   no-undo .
      114       define output parameter p-value    like ub.place-attr.attr-value no-undo .
      115       define output parameter p-type     as character no-undo .
      116       define buffer buf_place-attr for ub.place-attr .
      117       def var v-format         as character no-undo .
      118       def var v-label          as character no-undo .
      119       def var v-user-can-edit  as logical   no-undo .
      120       def var v-output-display as logical   no-undo .
      121       def var v-other          as character no-undo .
      122       run placattr-name in this-procedure
      123         (input  p-code
      124         ,output p-type
      125         ,output v-format
      126         ,output v-label
      127         ,output v-user-can-edit
      128         ,output v-output-display
      129         ,output v-other
      130         ) no-error .
      131       if error-status :error then do:
      132         undo, return error return-value .
      133       end.
      134       find first buf_place-attr no-lock where
      135                  buf_place-attr.obj-type  = p-obj-type
      136              AND buf_place-attr.obj-code  = p-obj-code
      137              AND buf_place-attr.pl-code  = p-pl-code
      138              AND buf_place-attr.attr-code = p-code
      139         no-error .
      140       if avail buf_place-attr then do:
      141         assign
      142           p-value =  buf_place-attr.attr-value
      143         .
      144       end.
      145       else do:
      146         assign
      147           p-value = if p-type = 'L':U then "no":U else ""
      148         .
      149       end.
      150     end.
      151   end procedure.
      152   procedure placattr-write :
      153     do
      154     on error undo, return error
      155     :
      156       define input parameter p-obj-type like ub.place-attr.obj-type   no-undo .
      157       define input parameter p-obj-code like ub.place-attr.obj-code   no-undo .
      158       define input parameter p-pl-code  like ub.place-attr.pl-code   no-undo .
      159       define input parameter p-code     like ub.place-attr.attr-code  no-undo .
      160       define input parameter p-value    like ub.place-attr.attr-value no-undo .
      161       define buffer buf_place-attr for ub.place-attr .
      162       define buffer lock_place-attr for ub.place-attr .
      163       def var v-type           as character no-undo .
      164       def var v-format         as character no-undo .
      165       def var v-label          as character no-undo .
      166       def var v-user-can-edit  as logical   no-undo .
      167       def var v-output-display as logical   no-undo .
      168       def var v-other          as character no-undo .
      169       run placattr-name in this-procedure
      170         (input  p-code
      171         ,output v-type
      172         ,output v-format
      173         ,output v-label
      174         ,output v-user-can-edit
      175         ,output v-output-display
      176         ,output v-other
      177         ) no-error .
      178       if error-status :error then do:
      179         undo, return error return-value .
      180       end.
      181       find first buf_place-attr exclusive-lock where
      182                  buf_place-attr.obj-type  = p-obj-type
      183              AND buf_place-attr.obj-code  = p-obj-code
      184              AND buf_place-attr.pl-code  = p-pl-code
      185              AND buf_place-attr.attr-code = p-code no-error .
      186       if not available buf_place-attr then do:
      187         create buf_place-attr .
      188         assign
      189           buf_place-attr.pl-code  = p-pl-code
      190           buf_place-attr.obj-type  = p-obj-type
      191           buf_place-attr.obj-code  = p-obj-code
      192           buf_place-attr.attr-code = p-code
      193           buf_place-attr.attr-value = p-value no-error
      194         .
      195       end.
      196       ELSE
      197       ASSIGN
      198       buf_place-attr.attr-value = p-value no-error.
      199     end.
      200   end procedure.
