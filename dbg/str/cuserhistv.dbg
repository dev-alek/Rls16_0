      218         (input  p-code
      219         ,output v-type
      220         ,output v-format
      221         ,output v-label
      222         ,output v-user-can-edit
      223         ,output v-output-display
      224         ,output v-other
      225         ) no-error .
      226       if error-status :error then do:
      227         undo, return error return-value .
      228       end.
      229       find first buf_place-attr no-lock where
