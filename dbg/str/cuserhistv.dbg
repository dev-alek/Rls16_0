      505   define SHARED temp-table temp-changes no-undo
      506   field f_name as character
      507   field l_name as character
      508   field v_old as character
      509   field v_new as character
      510   field t_name as character
      511   field num_ as integer
      512   field uniq-key-rec as character
      513   field action as integer
      514   field fNotChange as logical
      515   index pi is unique primary
      516   num_
      517   t_name
      518   f_name
      519   index
      520   Chan
      521   fnotChange
      522   t_name
      523   f_name
      524   index imain uniq-key-rec
      525   .
      526   FUNCTION get-all-fields returns character (p-file-name as character ):
      527   define variable v-dop as character no-undo .
      528     find first _file no-lock where _file._file-name = p-file-name no-error .
      529     if not available _file then return "":U.
      530     for each _field no-lock where
      531              _field._file-recid = recid(_file) :
      532       assign
      533       v-dop = v-dop + _field._field-name + chr(44)
      534       .
      535     end.
      536     return trim(v-dop).
      537   END FUNCTION.
      538   PROCEDURE proc-full-temp-changes :
      539     define input  parameter p-act-create as logical   no-undo .
      540     define input  parameter p-act-delete as logical   no-undo .
      541     define input  parameter p-hst-handle as handle    no-undo .
      542     define input  parameter p-main-table as character no-undo .
      543     define input  parameter p-field-list as character no-undo .
      544     define input  parameter p-label-form as character no-undo .
      545     define variable h-new-buf         as handle    no-undo .
      546     define variable h-main-buf        as handle    no-undo .
      547     define variable h-for-comp        as handle    no-undo .
      548     define variable v-inform          as character no-undo .
      549     define variable v-ind             as integer   no-undo .
      550     define variable v-idx-field-qnty  as integer   no-undo .
      551     define variable v-num-entries     as integer   no-undo .
      552     define variable fh                as handle    no-undo .
      553     define variable fh-main           as handle    no-undo .
      554     define variable fh-old            as handle    no-undo .
      555     define variable fh-new            as handle    no-undo .
      556     define variable v-field-name      as character no-undo .
      557     define variable v-field-lvl       as character no-undo .
      558     define variable v-field-form      as character no-undo .
      559     define variable v-search-exp      as character no-undo .
      560     define variable v-srch-main       as character no-undo .
      561     define variable v-word-link       as character no-undo .
      562     define variable v-av-chip-num     as logical   no-undo .
      563     define variable v-main-pi-fld-lst as character no-undo .
      564     define variable v-main-fld-lst    as character no-undo .
      565     define variable v-delim-list      as character no-undo .
      566     define variable v-label           as character no-undo .
      567     define variable v-old-value       as character no-undo case-sensitive.
      568     define variable v-new-value       as character no-undo case-sensitive.
      569     define variable v-chg-fields as character no-undo.
      570     for each temp-changes:
      571       delete temp-changes.
      572     end.
      573     if not p-hst-handle:available then do:
      574       return .
      575     end.
      576     create buffer h-new-buf  for table p-hst-handle .
      577     create buffer h-main-buf for table p-main-table .
      578     assign
      579       v-inform = h-main-buf:index-information(1)
      580       v-ind    = 2
      581     .
      582     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      583     on error undo, return error
      584     :
      585       assign
      586         v-inform = h-main-buf:index-information( v-ind )
      587         v-ind    = v-ind + 1
      588       .
      589     end.
      590     if v-inform = ?
      591       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      592       or entry( 3, v-inform, ",":U ) <> "1":U
      593     then do:
      594       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      595     end.
      596     assign
      597       v-idx-field-qnty = num-entries( v-inform ) - 4
      598     .
      599     if v-idx-field-qnty < 2 then do:
      600       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      601     end.
      602     assign
      603       v-srch-main   = "where":U
      604       v-word-link   = "":U
      605       v-av-chip-num = false
      606       v-delim-list  = "":U
      607     .
      608     do v-ind = 1 to v-idx-field-qnty by 2
      609     on error undo, return error
      610     :
      611       assign
      612         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      613         fh                = p-hst-handle:buffer-field( v-field-name )
      614         fh-main           = h-main-buf:buffer-field( v-field-name )
      615         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      616         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      617       .
      618       if fh:data-type ="character":U then do:
      619         assign
      620           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      621         .
      622       end.
      623       else do:
      624         assign
      625           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      626         .
      627       end.
      628       if v-delim-list = "":U then do:
      629         assign
      630           v-delim-list = ",":U
      631         .
      632       end.
      633       if v-word-link = "":U then do:
      634         assign
      635           v-word-link = "and":U
      636         .
      637       end.
      638     end.
      639     assign
      640       v-delim-list  = "":U
      641     .
      642     do v-ind = 1 to h-main-buf:num-fields
      643     on error undo, return error
      644     :
      645       assign
      646         fh-main      = h-main-buf:buffer-field( v-ind )
      647         v-field-name = fh-main:name
      648       .
      649         assign
      650           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      651         .
      652         if v-delim-list = "":U then do:
      653           assign
      654             v-delim-list = ",":U
      655           .
      656         end.
      657     end.
      658     assign
      659       v-inform = p-hst-handle:index-information(1)
      660       v-ind    = 2
      661     .
      662     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      663     on error undo, return error
      664     :
      665       assign
      666         v-inform = p-hst-handle:index-information( v-ind )
      667         v-ind    = v-ind + 1
      668       .
      669     end.
      670     if v-inform = ?
      671       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      672       or entry( 3, v-inform, ",":U ) <> "1":U
      673     then do:
      674       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      675     end.
      676     assign
      677       v-idx-field-qnty = num-entries( v-inform ) - 4
      678     .
      679     if v-idx-field-qnty < 2 then do:
      680       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      681     end.
      682     assign
      683       v-search-exp  = "where":U
      684       v-word-link   = "":U
      685       v-av-chip-num = false
      686     .
      687     do v-ind = 1 to v-idx-field-qnty by 2
      688     on error undo, return error
      689     :
      690       assign
      691         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      692         fh           = p-hst-handle:buffer-field( v-field-name )
      693         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      694       .
      695       if v-field-name = "chip-num":U then do:
      696         assign
      697           v-search-exp  = substitute( "&1 >", v-search-exp )
      698           v-av-chip-num = true
      699         .
      700       end.
      701       else do:
      702         assign
      703           v-search-exp = substitute( "&1 =", v-search-exp )
      704         .
      705       end.
      706       if fh:data-type ="character":U then do:
      707         assign
      708           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      709         .
      710       end.
      711       else do:
      712         assign
      713           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      714         .
      715       end.
      716       if v-word-link = "":U then do:
      717         assign
      718           v-word-link = "and":U
      719         .
      720       end.
      721     end.
      722     if v-av-chip-num = false then do:
      723       message
      724         vss-workfile vss-revision vss-description skip
      725         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      726         "Использование данной процедуры невозможно!" skip
      727         view-as alert-box error .
      728       return error .
      729     end.
      730     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      731     if not h-new-buf:available then do:
      732       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      733       if not h-main-buf:available then do:
      734         assign
      735           h-for-comp = ?
      736         .
      737       end.
      738       else do:
      739         assign
      740           h-for-comp = h-main-buf
      741         .
      742       end.
      743     end.
      744     else do:
      745       assign
      746         h-for-comp = h-new-buf
      747       .
      748     end.
      749     assign
      750       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      751     .
      752     do v-ind = 1 to v-num-entries
      753     on error undo, return error return-value
      754     :
      755       assign
      756         v-field-name = entry( v-ind, v-main-fld-lst )
      757         fh-old       = p-hst-handle:buffer-field( v-field-name )
      758         v-old-value  = fh-old:buffer-value()
      759         v-label      = trim( fh-old:label )
      760       .
      761       if ( trim( p-field-list ) <> "":U
      762            and lookup( v-field-name, p-field-list ) > 0
      763          )
      764          or trim( p-field-list ) = "":U
      765       then do:
      766         if h-for-comp <> ? then do:
      767           assign
      768             fh-new      = h-for-comp:buffer-field( v-field-name )
      769             v-new-value = fh-new:buffer-value()
      770           .
      771         end.
      772         else do:
      773           assign
      774             v-new-value = "":U
      775           .
      776         end.
      777           if p-act-create = true then do:
      778             assign
      779               v-old-value = "":U
      780             .
      781           end.
      782           if p-act-delete = true then do:
      783             assign
      784               v-new-value = "":U
      785             .
      786           end.
      787         if v-old-value <> v-new-value
      788           or lookup(v-field-name,v-main-pi-fld-lst) ne 0
      789         then do:
      790           create temp-changes.
      791           assign
      792             temp-changes.t_name = p-main-table
      793             temp-changes.f_name = v-field-name
      794             temp-changes.l_name = replace( v-label, "&":U, "":U )
      795             temp-changes.v_old  = trim( v-old-value )
      796             temp-changes.v_new  = trim( v-new-value )
      797             temp-changes.num_   = 0
      798             temp-changes.fNotChange = v-old-value eq v-new-value
      799           .
      800         end.
      801       end.
      802     end.
      803     assign
      804       v-num-entries = num-entries( p-label-form, chr(8) )
      805     .
      806     do v-ind = 1 to v-num-entries
      807     on error undo, return error return-value
      808     :
      809       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      810         assign
      811           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      812           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      813           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      814         .
      815         find first temp-changes
      816           where temp-changes.f_name = v-field-name
      817           no-error .
      818         if available temp-changes then do:
      819           if trim( v-field-lvl ) <> "":U then do:
      820             assign
      821               temp-changes.l_name = v-field-lvl
      822             .
      823           end.
      824           if trim( v-field-form ) <> "":U then do:
      825             assign
      826               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      827             .
      828             if h-for-comp <> ? then do:
      829               assign
      830                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      831               .
      832             end.
      833           end.
      834         end.
      835       end.
      836       else do:
      837         message
      838           vss-workfile vss-revision vss-description skip
      839           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      840           substitute( "список для поля '&1': '&2'"
      841                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      842                       ,entry( v-ind, p-label-form, chr(8) )
      843                     ) skip
      844           substitute( "полный список: &2", p-label-form ) skip
      845           view-as alert-box error .
      846       end.
      847     end.
      848     delete object h-new-buf .
      849     delete object h-main-buf .
      850   END PROCEDURE.
      851   find first buf_c-usr-hist no-lock where
      852     buf_c-usr-hist.user-id = p-user-id
      853     AND buf_c-usr-hist.chip-num = p-chip-num
      854     AND buf_c-usr-hist.corr-user-db-num = p-corr-user-db-num
      855     AND buf_c-usr-hist.subject  = p-subject no-error .
      856   if not available buf_c-usr-hist then
      857   do:
      858     return error .
      859   end.
      860   if p-subject begins 'user-account-attr':U + "."
      861   then
      862      run user-obj-proc in this-procedure(output p-description) no-error  .
      863   else CASE p-subject:
      864     when 'user-login':U then
      865       do:
      866         run user-login-proc in this-procedure(output p-description) no-error  .
      867       end.
      868     when 'user-account':U then
      869       do:
      870         run user-account-proc in this-procedure(output p-description) no-error  .
      871       end.
      872     when 'user-obj':U then
      873       do:
      874         run user-obj-proc in this-procedure(output p-description) no-error  .
      875       end.
      876     when 'user-host':U then
      877       do:
      878         run user-obj-proc in this-procedure(output p-description) no-error  .
      879       end.
      880     when 'user-login-action-role':U then
      881       do:
      882         run user-obj-proc in this-procedure(output p-description) no-error  .
      883       end.
      884   END CASE.
      885   if error-status:error then
      886   do:
      887     return error substitute("&1 &2", error-status:get-message(1), return-value ) .
      888   end.
      889   procedure user-login-proc :
      890     define output parameter p-description as character no-undo .
      891     define buffer curr_c-user-login for ub.c-user-login  .
      892     do
      893       on error undo, return error
      894       :
      895       find first curr_c-user-login no-lock where
      896         curr_c-user-login.user-id = p-user-id
      897         AND curr_c-user-login.chip-num = p-chip-num
      898         AND curr_c-user-login.corr-user-db-num = p-corr-user-db-num
      899         no-error .
      900       if not avail curr_c-user-login then
      901       do:
      902         v-mess = "Неверная ссылка на c-user-login в таблице c-usr-hist".
      903         run err-mess in this-procedure ( input-output v-mess).
      904         return error v-mess.
      905       end.
      906       define variable v-label-param as character no-undo .
      907       v-label-param =
      908         "user-login" + chr(4) + "Логин" + chr(4) + "" + chr(8)
      909         + "user-password-encoded" + chr(4) + "Пароль" + chr(4) + "" + chr(8)
      910         + "user-administrator" + chr(4) + "Администратор" + chr(4) + "" + chr(8)
      911         + "max-discnt" + chr(4) + "Максимальная скидка" + chr(4) + "" + chr(8)
      912         + "last-login-mjd" + chr(4) + "Дата и время последнего входа в систему" + chr(4) + "" + chr(8)
      913         + "status_" + chr(4) + "Статус" + chr(4) + "" + chr(8)
      914         + "user-password-set-mjd" + chr(4) + "Дата и время задания пароля" + chr(4) + "" + chr(8)
      915         + "cntxt-menu-code" + chr(4) + "Код меню" + chr(4) + "" + chr(8)
      916         + "cntxt-menu-group-id" + chr(4) + "Идентификатор группы пунктов меню" + chr(4) + "" + chr(8)
      917         + "last-login-computer-name" + chr(4) + "Компьютер" + chr(4) + "" + chr(8)
      918         + "last-login-computer-userid" + chr(4) + "Имя пользователя в компьютере" + chr(4) + "" + chr(8)
      919         + "last-login-process-id" + chr(4) + "Идентификатор процесса" + chr(4) + "" + chr(8)
      920         + "login-error-count" + chr(4) + "Попыток доступа" + chr(4) + "" + chr(8)
      921         + "show-goods-fields" + chr(4) + "Список полей" + chr(4) + "" + chr(8)
      922         + "action-check-parent" + chr(4) + "Проверять права в соответствии с родительским ид" + chr(4) + "" + chr(8)
      923         + "db-num" + chr(4) + "БД" + chr(4) + "" + chr(8)
      924         + "quest-print" + chr(4) + "Задавать вопрос: куда выводить документ?" + chr(4) + "".
      925       run proc-full-temp-changes in this-procedure (
      926         input buf_c-usr-hist.action = integer('1':U)
      927         ,input buf_c-usr-hist.action = integer('99':U)
      928         ,input  buffer curr_c-user-login:handle
      929         ,input  'user-login':U
      930         ,input  "db-num,user-login,user-password-encoded,user-administrator,max-discnt,last-login-mjd,status_,user-password-set-mjd,cntxt-menu-code,cntxt-menu-group-id,last-login-computer-name,last-login-computer-userid,last-login-process-id,login-error-count,show-goods-fields,action-check-parent,quest-print"
      931         ,input  v-label-param).
      932     end.
      933   end procedure.
      934   procedure user-account-proc :
      935     define output parameter p-description as character no-undo .
      936     define buffer curr_c-user-account for ub.c-user-account  .
      937     do
      938       on error undo, return error
      939       :
      940       find first curr_c-user-account no-lock where
      941         curr_c-user-account.user-id = buf_c-usr-hist.user-id
      942         AND curr_c-user-account.chip-num = p-chip-num
      943         AND curr_c-user-account.corr-user-db-num = p-corr-user-db-num   no-error .
      944       if not avail curr_c-user-account then
      945       do:
      946         v-mess = "Неверная ссылка на c-user-account в таблице c-usr-hist".
      947         run err-mess in this-procedure ( input-output v-mess).
      948         return error v-mess.
      949       end.
      950       define variable v-label-param as character no-undo .
      951       v-label-param =
      952         "nik" + chr(4) + "Псевдоним" + chr(4) + "" + chr(8)
      953         + "status_" + chr(4) + "Статус" + chr(4) + "" + chr(8)
      954         + "last-name" + chr(4) + "Фамилия" + chr(4) + "" + chr(8)
      955         + "first-name" + chr(4) + "Имя" + chr(4) + "" + chr(8)
      956         + "second-name" + chr(4) + "Отчество" + chr(4) + "" + chr(8)
      957         + "phone-number" + chr(4) + "Городской телефон" + chr(4) + "" + chr(8)
      958         + "internal-phone-number" + chr(4) + "Внутренний телефон" + chr(4) + "" + chr(8)
      959         + "mobile-phone-number" + chr(4) + "Мобильный телефон" + chr(4) + "" + chr(8)
      960         + "e-mail" + chr(4) + "Эл.почта" + chr(4) + "" + chr(8)
      961         + "company" + chr(4) + "Компания" + chr(4) + "" + chr(8)
      962         + "department" + chr(4) + "Отдел" + chr(4) + "" + chr(8)
      963         + "position" + chr(4) + "Должность" + chr(4) + "" + chr(8)
      964         + "room" + chr(4) + "Комната" + chr(4) + "" + chr(8)
      965         + "PS" + chr(4) + "Примечание" + chr(4) + ""  .
      966       run proc-full-temp-changes in this-procedure (
      967         input buf_c-usr-hist.action = integer('1':U)
      968         ,input buf_c-usr-hist.action = integer('99':U)
      969         ,input  buffer curr_c-user-account:handle
      970         ,input  'user-account':U
      971         ,input  "nik,status_,last-name,first-name,second-name,phone-number,internal-phone-number,mobile-phone-number,e-mail,company,department,position,room,PS"
      972         ,input  v-label-param).
      973     end.
      974   end procedure.
      975   procedure user-obj-proc :
      976     define output parameter p-description as character no-undo .
      977     define buffer curr_c-usr-hist for ub.c-usr-hist  .
      978     do
      979       on error undo, return error
      980       :
      981       find first curr_c-usr-hist no-lock where
      982         curr_c-usr-hist.user-id = buf_c-usr-hist.user-id
      983         AND curr_c-usr-hist.chip-num = p-chip-num
      984         AND curr_c-usr-hist.corr-user-db-num = p-corr-user-db-num   no-error .
      985       if not avail curr_c-usr-hist then
      986       do:
      987         v-mess = "Неверная ссылка на c-usr-hist".
      988         run err-mess in this-procedure ( input-output v-mess).
      989         return error v-mess.
      990       end.
      991       define variable vobj as character no-undo.
      992       define variable vDB as character no-undo.
      993       assign
      994          vobj = entry(1,curr_c-usr-hist.source-ref,chr(4))
      995          vDB  = entry(2,curr_c-usr-hist.source-ref,chr(4))
      996       no-error.
      997       create  temp-changes.
      998       assign
      999         temp-changes.l_name       = curr_c-usr-hist.subject
     1000         temp-changes.uniq-key-rec = STRING (curr_c-usr-hist.chip-num)
     1001         .
     1002       if curr_c-usr-hist.action = integer('1':U) then temp-changes.v_new = vobj .
     1003       else temp-changes.v_old = vobj .
     1004       if vDB ne ""
     1005       then do:
     1006          create  temp-changes.
     1007          assign
     1008            temp-changes.f_name       = "db-num"
     1009            temp-changes.l_name       = "БД"
     1010            temp-changes.uniq-key-rec = STRING (curr_c-usr-hist.chip-num)
     1011            .
     1012          if curr_c-usr-hist.action = integer('1':U) then temp-changes.v_new = vDB .
     1013          else temp-changes.v_old = vDB .
     1014       end.
     1015     end.
     1016   end procedure.
     1017   PROCEDURE err-mess:
     1018     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     1019     CASE p-silent:
     1020       when yes then
     1021         do:
     1022           p-mess =
     1023             substitute("История пользователя &1: щепка &2 БД:&3  Предмет изменений &4&5&6"
     1024             ,p-user-id
     1025             , p-chip-num
     1026             , p-corr-user-db-num
     1027             , p-subject
     1028             , chr(10)
     1029             , p-mess
     1030             ).
     1031         end.
     1032       otherwise
     1033       do:
     1034         message
     1035           p-mess
     1036           view-as alert-box error .
     1037       end.
     1038     end.
     1039   END PROCEDURE.
