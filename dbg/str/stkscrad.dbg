        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   define temp-table tt-usrstko no-undo
        6   field user-name     as   character
        7   field obj-type      like ub.clients.obj-type
        8   field obj-code      like ub.clients.obj-code
        9   field obj-name      like ub.clients.obj-name
       10   field main-obj-type like ub.clients.obj-type
       11   field main-obj-code like ub.clients.obj-code
       12   field main-obj-name like ub.clients.obj-name
       13   field level         as   integer
       14   field host-code     like ub.clients.obj-code
       15   field host-name     like ub.clients.obj-name
       16   field db-num        like ub.db.db-num
       17   index pi is unique primary user-name obj-type obj-code
       18   index level is unique user-name level.
       19   PROCEDURE loadusr-tt :
       20   define input parameter paruser-name as character no-undo.
       21   define buffer bf_clients      for ub.clients.
       22   define buffer bf_main-clients for ub.clients.
       23   define buffer bf_usr-flt      for ubflt.usr-flt.
       24   define buffer bf_shop         for ub.shop.
       25   define buffer bf_store        for ub.store.
       26   define buffer bf_host-clients for ub.clients.
       27   define buffer bf_db           for ub.db.
       28   for each tt-usrstko:
       29     delete tt-usrstko.
       30   end.
       31   for each bf_usr-flt where bf_usr-flt.user-name  = paruser-name     and
       32                             bf_usr-flt.call-point begins "stockscr"   :
       33     create tt-usrstko.
       34     assign
       35       tt-usrstko.user-name    = paruser-name
       36       tt-usrstko.obj-type      = substring(bf_usr-flt.call-point, 9, 3)
       37       tt-usrstko.obj-code      = integer(substring(bf_usr-flt.call-point, 12))
       38       tt-usrstko.level         = integer(entry(1, bf_usr-flt.naim))
       39       tt-usrstko.main-obj-type = substring(bf_usr-flt.list_, 1, 3)
       40       tt-usrstko.main-obj-code = integer(substring(bf_usr-flt.list_, 4)).
       41     if tt-usrstko.main-obj-code <> ? then do:
       42       find first bf_main-clients where bf_main-clients.obj-type = tt-usrstko.main-obj-type and
       43                                        bf_main-clients.obj-code = tt-usrstko.main-obj-code no-lock.
       44       assign
       45         tt-usrstko.main-obj-name = bf_main-clients.obj-name.
       46     end.
       47     if tt-usrstko.obj-type = 'маг':U then do:
       48       find first bf_shop where bf_shop.obj-code = tt-usrstko.obj-code no-lock.
       49       find first bf_host-clients where bf_host-clients.obj-type = 'орг':U and
       50                                        bf_host-clients.obj-code =  bf_shop.host-code no-lock.
       51     end.
       52     else do:
       53       find first bf_store where bf_store.obj-code = tt-usrstko.obj-code no-lock.
       54       find first bf_host-clients where bf_host-clients.obj-type = 'орг':U             and
       55                                        bf_host-clients.obj-code = bf_store.host-code no-lock.
       56     end.
       57     assign
       58       tt-usrstko.host-code = bf_host-clients.obj-code
       59       tt-usrstko.host-name = bf_host-clients.obj-name.
       60     find first bf_clients where bf_clients.obj-type = tt-usrstko.obj-type and
       61                                 bf_clients.obj-code = tt-usrstko.obj-code no-lock.
       62     find first bf_db where bf_db.db-num = bf_clients.db-num no-lock.
       63     assign
       64       tt-usrstko.obj-name = bf_clients.obj-name
       65       tt-usrstko.db-num   = bf_db.db-num.
       66   end.
       67   END PROCEDURE.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define input parameter paruser-name as character no-undo.
      114   define output parameter par-chg as logical no-undo.
      115   DEFINE BUTTON b-add
      116        LABEL "&Добавить"
      117        SIZE 10 BY 1
      118        BGCOLOR 8 .
      119   DEFINE BUTTON b-chg
      120        LABEL "&Изменить"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON b-del
      124        LABEL "&Удалить"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE BUTTON b-down
      128        IMAGE-UP FILE "adeicon\vcrfwd":U
      129        IMAGE-DOWN FILE "adeicon\vcrfwd":U
      130        IMAGE-INSENSITIVE FILE "adeicon\vcrfwd":U
      131        LABEL ""
      132        SIZE 3.75 BY 1.58.
      133   DEFINE BUTTON b-exit AUTO-GO
      134        LABEL "Выход"
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON b-help
      138        LABEL "&Помощь"
      139        SIZE 10 BY 1
      140        BGCOLOR 8 .
      141   DEFINE BUTTON b-up
      142        IMAGE-UP FILE "adeicon\vcrrew":U
      143        IMAGE-DOWN FILE "adeicon\vcrrew":U
      144        IMAGE-INSENSITIVE FILE "adeicon\vcrrew":U
      145        LABEL ""
      146        SIZE 3.75 BY 1.58.
      147   DEFINE QUERY BROWSE-1 FOR
      148         tt-usrstko SCROLLING.
      149   DEFINE BROWSE BROWSE-1
      150     QUERY BROWSE-1 DISPLAY
      151         tt-usrstko.obj-type column-label "Тип"
      152   tt-usrstko.obj-code column-label "Код объекта"
      153   tt-usrstko.obj-name format "x(10)" column-label "Название"
      154   tt-usrstko.main-obj-type column-label "Тип"
      155   tt-usrstko.main-obj-code column-label "Код гл. объекта"
      156       WITH NO-ROW-MARKERS SEPARATORS SIZE 48.25 BY 9.92.
      157   DEFINE FRAME Dialog-Frame
      158        b-exit AT ROW 1.08 COL 1.5
      159        b-add AT ROW 1.08 COL 12
      160        b-del AT ROW 1.08 COL 22.5
      161        b-chg AT ROW 1.08 COL 33
      162        b-help AT ROW 1.08 COL 43.5
      163        BROWSE-1 AT ROW 2.33 COL 1
      164        b-up AT ROW 2.42 COL 49.75
      165        b-down AT ROW 4.04 COL 49.75
      166        SPACE(0.00) SKIP(6.66)
      167       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      168            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      169            TITLE "Настройка объектов для пользователя"
      170            DEFAULT-BUTTON b-exit.
      171   ASSIGN
      172          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      173          FRAME Dialog-Frame:HIDDEN           = TRUE.
      174   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      175   DO:
      176     APPLY "END-ERROR":U TO SELF.
      177   END.
      178   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      179   DO:
      180     define variable varadd as logical no-undo.
      181     define variable varobj-type like ub.clients.obj-type no-undo.
      182     define variable varobj-code like ub.clients.obj-code no-undo.
      183     run str/stkscrao.w (input  paruser-name,
      184                     input  'ДОБАВЛЕНИЕ':U,
      185                     output varadd,
      186                     input-output varobj-type,
      187                     input-output varobj-code,
      188                     input-output table tt-usrstko) no-error.
      189     if error-status:error then do:
      190       message "Ошибка при добавлении объекта." view-as alert-box.
      191       return no-apply.
      192     end.
      193     if varadd = yes then do:
      194       oPEN QUERY BROWSE-1 FOR EACH tt-usrstko use-index level indexed-reposition.
      195       find first tt-usrstko where tt-usrstko.user-name = paruser-name and
      196                                                tt-usrstko.obj-type = varobj-type and
      197                                                tt-usrstko.obj-code = varobj-code .
      198       reposition BROWSE-1 to recid recid(tt-usrstko).
      199     end.
      200     assign par-chg = yes.
      201   END.
      202   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      203   DO:
      204     define variable varrec-id as recid no-undo.
      205     define variable varobj-type like ub.clients.obj-type no-undo.
      206     define variable varobj-code like ub.clients.obj-code no-undo.
      207     define variable varchg      as   logical no-undo.
      208     define buffer bf_tt-usrstko for tt-usrstko.
      209     if available tt-usrstko then do:
      210       assign
      211         varobj-type = tt-usrstko.obj-type
      212         varobj-code = tt-usrstko.obj-code.
      213       find first bf_tt-usrstko where recid(bf_tt-usrstko) = recid(tt-usrstko).
      214       run str/stkscrao.w (input paruser-name,
      215                       input 'ИЗМЕНЕНИЕ':U,
      216                       output varchg,
      217                       input-output bf_tt-usrstko.obj-type,
      218                       input-output bf_tt-usrstko.obj-code,
      219                       input-output table tt-usrstko) no-error.
      220       oPEN QUERY BROWSE-1 FOR EACH tt-usrstko use-index level indexed-reposition.
      221       find first bf_tt-usrstko where bf_tt-usrstko.obj-type = varobj-type and
      222                                      bf_tt-usrstko.obj-code = varobj-code .
      223       reposition BROWSE-1 to recid recid(bf_tt-usrstko).
      224       assign par-chg = yes.
      225     end.
      226   END.
      227   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      228   DO:
      229     define buffer bf_tt-usrstko for tt-usrstko.
      230     define buffer bf_usr-flt    for ubflt.usr-flt.
      231     define buffer bfu_usr-flt   for ubflt.usr-flt.
      232     define variable varrec-id as recid no-undo.
      233     if available tt-usrstko then do:
      234       find first bf_tt-usrstko where bf_tt-usrstko.main-obj-type  = tt-usrstko.obj-type and
      235                                                 bf_tt-usrstko.main-obj-code = tt-usrstko.obj-code no-error.
      236       if available bf_tt-usrstko then do:
      237         message "Данный объект является главным для объекта " bf_tt-usrstko.obj-type " " bf_tt-usrstko.obj-code " ."
      238         view-as alert-box error.
      239         return no-apply.
      240        end.
      241        for each bf_usr-flt where bf_usr-flt.user-name  = paruser-name and
      242                                  bf_usr-flt.call-point begins  "stockscr" no-lock :
      243           if tt-usrstko.obj-type  = substring(bf_usr-flt.call-point, 9, 3) and
      244              tt-usrstko.obj-code  = integer(substring(bf_usr-flt.call-point, 12)) then do:
      245              find first bfu_usr-flt where recid(bfu_usr-flt) = recid(bf_usr-flt) exclusive-lock.
      246              delete bfu_usr-flt.
      247              leave.
      248           end.
      249        end.
      250        delete tt-usrstko.
      251        if BROWSE-1:delete-current-row() then.
      252        assign par-chg = yes.
      253     end.
      254   END.
      255   ON CHOOSE OF b-down IN FRAME Dialog-Frame
      256   DO:
      257   define buffer bf_tt-usrstko for tt-usrstko.
      258   define variable varlevel like tt-usrstko.level no-undo.
      259   define buffer bf_usr-flt for ubflt.usr-flt.
      260   define buffer bfu_usr-flt for ubflt.usr-flt.
      261   define variable varrec-id as recid no-undo.
      262   if available tt-usrstko then do:
      263     find first bf_tt-usrstko where recid(bf_tt-usrstko) = recid(tt-usrstko) no-error.
      264     find next bf_tt-usrstko where bf_tt-usrstko.user-name = tt-usrstko.user-name use-index level  no-error.
      265     if not available bf_tt-usrstko then do:
      266       message "Данный объект имеет самый низкий уровень." view-as alert-box.
      267       return no-apply.
      268     end.
      269     assign
      270       varlevel = bf_tt-usrstko.level
      271       bf_tt-usrstko.level = tt-usrstko.level
      272       tt-usrstko.level = varlevel.
      273     for each bf_usr-flt where bf_usr-flt.user-name  = paruser-name and
      274                               bf_usr-flt.call-point begins  "stockscr"  no-lock :
      275       if tt-usrstko.obj-type  = substring(bf_usr-flt.call-point, 9, 3) and
      276          tt-usrstko.obj-code  = integer(substring(bf_usr-flt.call-point, 12)) then do:
      277         find first bfu_usr-flt where recid(bfu_usr-flt) = recid(bf_usr-flt) exclusive-lock.
      278         assign bfu_usr-flt.naim = string(tt-usrstko.level).
      279       end.
      280       if bf_tt-usrstko.obj-type  = substring(bf_usr-flt.call-point, 9, 3) and
      281          bf_tt-usrstko.obj-code  = integer(substring(bf_usr-flt.call-point, 12)) then do:
      282         find first bfu_usr-flt where recid(bfu_usr-flt) = recid(bf_usr-flt) exclusive-lock.
      283         assign bfu_usr-flt.naim = string (bf_tt-usrstko.level).
      284       end.
      285     end.
      286     assign varrec-id = recid(tt-usrstko).
      287     oPEN QUERY BROWSE-1 FOR EACH tt-usrstko use-index level indexed-reposition.
      288     reposition BROWSE-1 to recid varrec-id.
      289   end.
      290   END.
      291   ON CHOOSE OF b-up IN FRAME Dialog-Frame
      292   DO:
      293     define buffer bf_tt-usrstko for tt-usrstko.
      294     define variable varlevel like tt-usrstko.level no-undo.
      295     define buffer bf_usr-flt  for ubflt.usr-flt.
      296     define buffer bfu_usr-flt for ubflt.usr-flt.
      297     define variable varrec-id as recid no-undo.
      298     if available tt-usrstko then do:
      299       find first bf_tt-usrstko where recid(bf_tt-usrstko) = recid(tt-usrstko) no-error.
      300       find prev bf_tt-usrstko where bf_tt-usrstko.user-name = tt-usrstko.user-name use-index level no-error.
      301       if not available bf_tt-usrstko then do:
      302         message "Данный объект имеет самый высокий уровень." view-as alert-box.
      303         return no-apply.
      304       end.
      305       assign
      306         varlevel = bf_tt-usrstko.level
      307         bf_tt-usrstko.level = tt-usrstko.level
      308         tt-usrstko.level = varlevel.
      309       for each bf_usr-flt where bf_usr-flt.user-name  = paruser-name and
      310                                 bf_usr-flt.call-point begins "stockscr"   no-lock :
      311         if tt-usrstko.obj-type  = substring(bf_usr-flt.call-point, 9, 3) and
      312            tt-usrstko.obj-code  = integer(substring(bf_usr-flt.call-point, 12)) then do:
      313           find first bfu_usr-flt where recid(bfu_usr-flt) = recid(bf_usr-flt) exclusive-lock.
      314           assign bfu_usr-flt.naim = string (tt-usrstko.level).
      315         end.
      316         if bf_tt-usrstko.obj-type  = substring(bf_usr-flt.call-point, 9, 3) and
      317            bf_tt-usrstko.obj-code  = integer(substring(bf_usr-flt.call-point, 12)) then do:
      318           find first bfu_usr-flt where recid(bfu_usr-flt) = recid(bf_usr-flt) exclusive-lock.
      319           assign bfu_usr-flt.naim = string (bf_tt-usrstko.level).
      320        end.
      321       end.
      322       assign varrec-id = recid(tt-usrstko).
      323       oPEN QUERY BROWSE-1 FOR EACH tt-usrstko use-index level indexed-reposition.
      324       reposition BROWSE-1 to recid varrec-id.
      325     end.
      326   END.
      327   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      328   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      329   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      330   on help of frame Dialog-Frame
      331   do:
      332     run gbl/app_help.p
      333       (input this-procedure :file-name
      334       ,input ''
      335       ,input ?
      336       ) no-error.
      337     if error-status :error then do:
      338       message
      339         "Ошибка при вызове помощи"
      340         error-status :get-message(1)
      341         view-as alert-box .
      342     end.
      343   end.
      344   run minbtn-set in this-procedure .
      345   on choose of b-help in frame Dialog-Frame
      346   do:
      347     apply "help":u to frame Dialog-Frame .
      348   end.
      349   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   procedure minbtn-set :
      351       do
      352           on error undo, return error return-value
      353           :
      354           define variable ii              as integer       no-undo .
      355           define variable fh              as widget-handle no-undo .
      356           define variable hh              as widget-handle no-undo .
      357           define variable v-h             as handle        extent 4 no-undo .
      358           define variable v-name-button   as character     no-undo .
      359           define variable v-help-old-x    as decimal       no-undo .
      360           define variable v-help-old-y    as decimal       no-undo .
      361           define variable v-help-old-size as decimal       no-undo .
      362           define variable v-frame-width   as decimal       no-undo .
      363           define variable jj              as integer       no-undo .
      364           do
      365               on error undo, return error
      366               :
      367               assign
      368                   v-frame-width = frame Dialog-Frame:width - 0.3
      369                   fh            = frame Dialog-Frame:first-child
      370                   hh            = fh:first-child
      371                   ii            = 1
      372                   .
      373               do while valid-handle(hh):
      374                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      375                   do:
      376                       case lc(hh:name) :
      377                           when "b-help" then
      378                               do:
      379                                   hh:load-image-up("cmp/b-help.bmp":u) .
      380                                   hh:load-image-down("cmp/b-help.bmp":u) .
      381                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      382                                   hh:TOOLTIP = "Помощь" .
      383                                   v-help-old-x = hh:column .
      384                                   v-help-old-y = hh:row    .
      385                                   v-help-old-size = hh:width .
      386                                   hh:width-chars = 2.5 .
      387                               end.
      388                           when "b-print" then
      389                               do:
      390                                   hh:load-image("cmp/b-print.bmp":u) .
      391                                   hh:TOOLTIP = "Печать" .
      392                                   v-h[ii] = hh:handle .
      393                                   ii = ii + 1 .
      394                                   hh:width-chars = 3 .
      395                               end.
      396                           when "b-history" or
      397                           when "b-hist" then
      398                               do:
      399                                   hh:load-image("cmp/b-hist.bmp":u) .
      400                                   hh:TOOLTIP = "История" .
      401                                   v-h[ii] = hh:handle .
      402                                   ii = ii + 1 .
      403                                   hh:width-chars = 3 .
      404                               end.
      405                           when "b-sch" then
      406                               do:
      407                                   hh:load-image("cmp/b-sch.bmp":u) .
      408                                   hh:TOOLTIP = "Установка Фильтра" .
      409                                   v-h[ii] = hh:handle .
      410                                   ii = ii + 1 .
      411                                   hh:width-chars = 3 .
      412                               end.
      413                           when "b-hist-user" then
      414                               do:
      415                                   hh:load-image("cmp/b-hist.bmp":u) .
      416                                   hh:TOOLTIP = "История пользователя" .
      417                                   ii = ii + 1 .
      418                               end.
      419                       end case.
      420                   end.
      421                   hh = hh:next-sibling.
      422               end.
      423               b-help:column = v-frame-width - b-help:width-chars.
      424               jj = 0.
      425               repeat ii = 4 to 1 by -1 :
      426                   if valid-handle (v-h[ii] ) then
      427                   do:
      428                       jj  = jj + 1 .
      429                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      430                       v-h[ii]:row    = v-help-old-y .
      431                   end.
      432               end.
      433           end.
      434       end.
      435   end procedure.
      436   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      437   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      438   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      439   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      440   define variable v-diasize-current-frame-width  as decimal   no-undo .
      441   define variable v-diasize-current-frame-height as decimal   no-undo .
      442   define variable v-diasize-change-size          as logical   no-undo .
      443   define variable v-diasize-resize-button        as handle    no-undo .
      444   define variable v-diasize-wndmax               as logical   no-undo .
      445   define variable v-diasize-wndstore             as logical   no-undo .
      446   define variable v-diasize-proc-name            as character no-undo .
      447   define variable v-diasize-browse-handle        as handle    no-undo .
      448   define variable v-diasize-browse-number        as integer   no-undo .
      449   define variable v-diasize-need-full-display    as logical   no-undo init false .
      450   define temp-table temp-diasize-handle no-undo
      451     field handle-value  as handle
      452     field save-position as decimal
      453     index xpk is primary unique handle-value
      454     .
      455   define temp-table temp-browse-handle no-undo
      456     field browse-type   as character
      457     field browse-number as integer
      458     field browse-handle as handle
      459     field original-size as decimal
      460     index xpk is primary unique browse-type browse-number
      461     index xie browse-type browse-handle
      462   .
      463   procedure diasize_change-height :
      464     define input  parameter p-change-value  as decimal   no-undo .
      465     define input  parameter p-move-resize   as logical   no-undo .
      466     define variable v-field-group-handle    as handle    no-undo .
      467     define variable v-object-handle         as handle    no-undo .
      468     define variable v-frame-height          as decimal   no-undo .
      469     define variable v-frame-virtual-height  as decimal   no-undo .
      470     define variable v-browse-height         as decimal   no-undo .
      471     define variable v-window-height         as decimal   no-undo .
      472     define variable v-window-virtual-height as decimal   no-undo .
      473     define variable v-change-sign           as integer   no-undo .
      474     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      475     define buffer buf_temp-browse-handle  for temp-browse-handle .
      476     if p-change-value > 0
      477     then do:
      478       if frame Dialog-Frame :height + p-change-value
      479           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      480       then do:
      481         assign
      482           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      483                           - (frame Dialog-Frame :height-chars)
      484         .
      485         if p-change-value <= 0
      486         then do:
      487           run diasize_position-resize-button in this-procedure .
      488           return .
      489         end.
      490       end.
      491     end.
      492     if p-change-value < 0
      493     then do:
      494       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      495       then do:
      496         assign
      497           p-change-value = v-diasize-orig-frame-height
      498                          - (frame Dialog-Frame :height-chars)
      499         .
      500         if p-change-value >= 0
      501         then do:
      502           run diasize_position-resize-button in this-procedure .
      503           return .
      504         end.
      505       end.
      506     end.
      507     if p-change-value >= 0
      508     then do:
      509       assign
      510         v-change-sign = 1
      511       .
      512     end.
      513     else do:
      514       assign
      515         v-change-sign = -1
      516       .
      517     end.
      518     assign
      519       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      520     .
      521     if p-change-value = 0
      522     then do:
      523       run diasize_position-resize-button in this-procedure .
      524       return .
      525     end.
      526     move_block:
      527     do
      528     on error undo move_block, retry move_block
      529     :
      530       if retry
      531       then do:
      532         do
      533         on error undo move_block, leave move_block
      534         :
      535           if p-change-value > 0
      536           then do:
      537             for each buf_temp-diasize-handle
      538             on error undo, next
      539             :
      540               assign
      541                 v-object-handle = buf_temp-diasize-handle.handle-value
      542               .
      543               if v-object-handle <> v-diasize-resize-button
      544               then do:
      545                 assign
      546                   v-object-handle :row = buf_temp-diasize-handle.save-position
      547                 .
      548               end.
      549             end.
      550             assign
      551               v-diasize-browse-handle :height = v-browse-height
      552             .
      553             for each buf_temp-browse-handle
      554               where buf_temp-browse-handle.browse-type = 'height':u
      555             on error undo, next
      556             :
      557               assign
      558                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      559               .
      560             end.
      561             assign
      562               frame Dialog-Frame :height = v-frame-height
      563             .
      564             if frame Dialog-Frame :scrollable = true
      565             then do:
      566               assign
      567                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      568               .
      569             end.
      570             run diasize_position-resize-button in this-procedure .
      571           end.
      572           else do:
      573             if frame Dialog-Frame :scrollable = true
      574             then do:
      575               assign
      576                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      577               .
      578             end.
      579             assign
      580               frame Dialog-Frame :height = v-frame-height
      581             .
      582             assign
      583               v-diasize-browse-handle :height = v-browse-height
      584             .
      585             for each buf_temp-browse-handle
      586               where buf_temp-browse-handle.browse-type = 'height':u
      587             on error undo, next
      588             :
      589               assign
      590                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      591               .
      592             end.
      593             for each buf_temp-diasize-handle
      594             on error undo, next
      595             :
      596               assign
      597                 v-object-handle = buf_temp-diasize-handle.handle-value
      598               .
      599               if v-object-handle <> v-diasize-resize-button
      600               then do:
      601                 assign
      602                   v-object-handle :row = buf_temp-diasize-handle.save-position
      603                 .
      604               end.
      605             end.
      606             run diasize_position-resize-button in this-procedure .
      607           end.
      608           assign
      609             v-diasize-change-size = false
      610           .
      611           leave move_block .
      612         end.
      613       end.
      614       assign
      615         v-diasize-need-full-display = true
      616       .
      617       if v-diasize-change-size = false
      618       then do:
      619         assign
      620           v-diasize-change-size = true
      621         .
      622       end.
      623       else do:
      624         return .
      625       end.
      626       assign
      627         v-frame-height = frame Dialog-Frame :height
      628         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      629         v-browse-height = v-diasize-browse-handle :height
      630       .
      631       for each buf_temp-browse-handle
      632         where buf_temp-browse-handle.browse-type = 'height':u
      633       :
      634         assign
      635           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      636         .
      637       end.
      638       for each buf_temp-diasize-handle
      639       :
      640         delete buf_temp-diasize-handle .
      641       end.
      642       assign
      643         v-field-group-handle = frame Dialog-Frame :first-child
      644       .
      645       do while valid-handle(v-field-group-handle)
      646       :
      647         assign
      648           v-object-handle = v-field-group-handle :first-child
      649         .
      650         do while valid-handle(v-object-handle)
      651         :
      652           if  v-object-handle <> v-diasize-browse-handle :handle
      653           and can-query(v-object-handle, "row")
      654           and can-query(v-object-handle, "height")
      655           and ( v-object-handle :row > v-diasize-browse-handle :row )
      656           then do:
      657             find first buf_temp-browse-handle
      658               where buf_temp-browse-handle.browse-type   = 'height':u
      659                 and buf_temp-browse-handle.browse-handle = v-object-handle
      660               no-error .
      661             if available buf_temp-browse-handle
      662             then do:
      663             end.
      664             else do:
      665               create buf_temp-diasize-handle .
      666               assign
      667                 buf_temp-diasize-handle.handle-value  = v-object-handle
      668                 buf_temp-diasize-handle.save-position = v-object-handle :row
      669               .
      670             end.
      671           end.
      672           assign
      673             v-object-handle = v-object-handle :next-sibling
      674           .
      675         end.
      676         assign
      677           v-field-group-handle = v-field-group-handle :next-sibling
      678         .
      679       end.
      680       do with frame Dialog-Frame
      681       :
      682         hide v-diasize-resize-button .
      683         assign
      684           v-diasize-resize-button :row    = 1
      685           v-diasize-resize-button :column = 1
      686         .
      687       end.
      688       if p-change-value > 0
      689       then do:
      690         if frame Dialog-Frame :scrollable = true
      691         then do:
      692           assign
      693             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      694             no-error .
      695           if error-status :error
      696           or error-status :get-message(1) <> ""
      697           then do:
      698             undo move_block, retry move_block .
      699           end.
      700         end.
      701         assign
      702           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      703           no-error .
      704         if error-status :error
      705         or error-status :get-message(1) <> ""
      706         then do:
      707           undo move_block, retry move_block .
      708         end.
      709         assign
      710           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      711           no-error .
      712         if error-status :error
      713         or error-status :get-message(1) <> ""
      714         then do:
      715           undo move_block, retry move_block .
      716         end.
      717         for each buf_temp-browse-handle
      718           where buf_temp-browse-handle.browse-type = 'height':u
      719         on error undo move_block, retry move_block
      720         :
      721           assign
      722             buf_temp-browse-handle.browse-handle :height
      723               = buf_temp-browse-handle.browse-handle :height + p-change-value
      724             no-error .
      725           if error-status :error
      726           or error-status :get-message(1) <> ""
      727           then do:
      728             undo move_block, retry move_block .
      729           end.
      730         end.
      731         for each buf_temp-diasize-handle
      732         on error undo move_block, retry move_block
      733         :
      734           assign
      735             v-object-handle = buf_temp-diasize-handle.handle-value
      736           .
      737           if v-object-handle <> v-diasize-resize-button
      738           then do:
      739             assign
      740               v-object-handle :row = v-object-handle :row + p-change-value
      741               no-error .
      742             if error-status :error
      743             or error-status :get-message(1) <> ""
      744             then do:
      745               undo move_block, retry move_block .
      746             end.
      747           end.
      748         end.
      749       end.
      750       else do:
      751         for each buf_temp-diasize-handle
      752         on error undo move_block, retry move_block
      753         :
      754           assign
      755             v-object-handle = buf_temp-diasize-handle.handle-value
      756           .
      757           if v-object-handle <> v-diasize-resize-button
      758           then do:
      759             assign
      760               v-object-handle :row = v-object-handle :row + p-change-value
      761               no-error .
      762             if error-status :error
      763             or error-status :get-message(1) <> ""
      764             then do:
      765               undo move_block, retry move_block .
      766             end.
      767           end.
      768         end.
      769         assign
      770           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      771           no-error .
      772         if error-status :error
      773         or error-status :get-message(1) <> ""
      774         then do:
      775           undo move_block, retry move_block .
      776         end.
      777         for each buf_temp-browse-handle
      778           where buf_temp-browse-handle.browse-type = 'height':u
      779         on error undo move_block, retry move_block
      780         :
      781           assign
      782             buf_temp-browse-handle.browse-handle :height
      783               = buf_temp-browse-handle.browse-handle :height + p-change-value
      784             no-error .
      785           if error-status :error
      786           or error-status :get-message(1) <> ""
      787           then do:
      788             undo move_block, retry move_block .
      789           end.
      790         end.
      791         assign
      792           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      793           no-error .
      794         if error-status :error
      795         or error-status :get-message(1) <> ""
      796         then do:
      797           undo move_block, retry move_block .
      798         end.
      799         if frame Dialog-Frame :scrollable = true
      800         then do:
      801           assign
      802             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      803             no-error .
      804           if error-status :error
      805           or error-status :get-message(1) <> ""
      806           then do:
      807             undo move_block, retry move_block .
      808           end.
      809         end.
      810       end.
      811       if p-move-resize = true
      812       then do:
      813         run diasize_position-resize-button in this-procedure .
      814       end.
      815       if v-diasize-wndstore = true
      816       then do:
      817         if connected("ub") = true
      818         then do:
      819           define variable v-cntxt-db-num        as integer   no-undo .
      820           define variable v-cntxt-userid        as character no-undo .
      821           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      822                                             , OUTPUT v-cntxt-userid
      823                                             ) .
      824           run gbl/wndsizew.p
      825             (input  v-cntxt-db-num
      826             ,input  v-cntxt-userid
      827             ,input  v-diasize-proc-name
      828             ,input  'height':u
      829             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      830             ) .
      831         end.
      832       end.
      833     end.
      834     assign
      835       v-diasize-change-size = false
      836     .
      837   end procedure.
      838   procedure diasize_set-height :
      839     define input  parameter p-new-height  as decimal   no-undo .
      840     define input  parameter p-move-resize as logical   no-undo .
      841     do
      842     on error undo, return error return-value
      843     :
      844       run diasize_change-height in this-procedure
      845         (input  (p-new-height - frame Dialog-Frame :height)
      846         ,input  p-move-resize
      847         ) .
      848     end.
      849   end procedure.
      850   procedure diasize_change-width :
      851     define input  parameter p-change-value as decimal   no-undo .
      852     define input  parameter p-move-resize  as logical   no-undo .
      853     define variable v-field-group-handle   as handle    no-undo .
      854     define variable v-object-handle        as handle    no-undo .
      855     define variable v-frame-width          as decimal   no-undo .
      856     define variable v-frame-virtual-width  as decimal   no-undo .
      857     define variable v-browse-width         as decimal   no-undo .
      858     define variable v-window-width         as decimal   no-undo .
      859     define variable v-window-virtual-width as decimal   no-undo .
      860     define variable v-change-sign          as integer   no-undo .
      861     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      862     define buffer buf_temp-browse-handle  for temp-browse-handle .
      863     if p-change-value > 0
      864     then do:
      865       if frame Dialog-Frame :width + p-change-value >
      866           session :width-chars
      867       then do:
      868         assign
      869           p-change-value = session :width-chars - frame Dialog-Frame :width
      870         .
      871         if p-change-value <= 0
      872         then do:
      873           run diasize_position-resize-button in this-procedure .
      874           return .
      875         end.
      876       end.
      877     end.
      878     if p-change-value < 0
      879     then do:
      880       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      881       then do:
      882         assign
      883           p-change-value = v-diasize-orig-frame-width
      884                          - frame Dialog-Frame :width
      885         .
      886         if p-change-value >= 0
      887         then do:
      888           run diasize_position-resize-button in this-procedure .
      889           return .
      890         end.
      891       end.
      892     end.
      893     if p-change-value >= 0
      894     then do:
      895       assign
      896         v-change-sign = 1
      897       .
      898     end.
      899     else do:
      900       assign
      901         v-change-sign = -1
      902       .
      903     end.
      904     assign
      905       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      906     .
      907     if p-change-value = 0
      908     then do:
      909       run diasize_position-resize-button in this-procedure .
      910       return .
      911     end.
      912     move_block:
      913     do
      914     on error undo move_block, leave move_block
      915     :
      916       if retry
      917       then do:
      918         do
      919         on error undo move_block, leave move_block
      920         :
      921           if p-change-value > 0
      922           then do:
      923             for each buf_temp-diasize-handle
      924             on error undo, next
      925             :
      926               assign
      927                 v-object-handle = buf_temp-diasize-handle.handle-value
      928               .
      929               if v-object-handle <> v-diasize-resize-button
      930               then do:
      931                 assign
      932                   v-object-handle :col = buf_temp-diasize-handle.save-position
      933                 .
      934               end.
      935             end.
      936             assign
      937               v-diasize-browse-handle :width = v-browse-width
      938             .
      939             for each buf_temp-browse-handle
      940               where buf_temp-browse-handle.browse-type = 'width':u
      941             on error undo, next
      942             :
      943               assign
      944                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      945               .
      946             end.
      947             assign
      948               frame Dialog-Frame :width = v-frame-width
      949             .
      950             if frame Dialog-Frame :scrollable = true
      951             then do:
      952               assign
      953                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      954               .
      955             end.
      956             run diasize_position-resize-button in this-procedure .
      957           end.
      958           else do:
      959             if frame Dialog-Frame :scrollable = true
      960             then do:
      961               assign
      962                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      963               .
      964             end.
      965             assign
      966               frame Dialog-Frame :width = v-frame-width
      967             .
      968             for each buf_temp-browse-handle
      969               where buf_temp-browse-handle.browse-type = 'width':u
      970             on error undo, next
      971             :
      972               assign
      973                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      974               .
      975             end.
      976             assign
      977               v-diasize-browse-handle :width = v-browse-width
      978             .
      979             for each buf_temp-diasize-handle
      980             on error undo, next
      981             :
      982               assign
      983                 v-object-handle = buf_temp-diasize-handle.handle-value
      984               .
      985               if v-object-handle <> v-diasize-resize-button
      986               then do:
      987                 assign
      988                   v-object-handle :col = buf_temp-diasize-handle.save-position
      989                 .
      990               end.
      991             end.
      992             run diasize_position-resize-button in this-procedure .
      993           end.
      994           assign
      995             v-diasize-change-size = false
      996           .
      997           leave move_block .
      998         end.
      999       end.
     1000       assign
     1001         v-diasize-need-full-display = true
     1002       .
     1003       if v-diasize-change-size = false
     1004       then do:
     1005         assign
     1006           v-diasize-change-size = true
     1007         .
     1008       end.
     1009       else do:
     1010         return .
     1011       end.
     1012       assign
     1013         v-frame-width = frame Dialog-Frame :width
     1014         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1015         v-browse-width = v-diasize-browse-handle :width
     1016       .
     1017       for each buf_temp-browse-handle
     1018         where buf_temp-browse-handle.browse-type = 'width':u
     1019       :
     1020         assign
     1021           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1022         .
     1023       end.
     1024       for each buf_temp-diasize-handle
     1025       :
     1026         delete buf_temp-diasize-handle .
     1027       end.
     1028       assign
     1029         v-field-group-handle = frame Dialog-Frame :first-child
     1030       .
     1031       do while valid-handle(v-field-group-handle)
     1032       :
     1033         assign
     1034           v-object-handle = v-field-group-handle :first-child
     1035         .
     1036         do while valid-handle(v-object-handle)
     1037         :
     1038           if  v-object-handle <> v-diasize-browse-handle :handle
     1039           and v-object-handle <> v-diasize-resize-button
     1040           and can-query(v-object-handle, "row")
     1041           and can-query(v-object-handle, "height")
     1042           and ( v-object-handle :col + v-object-handle :width
     1043                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1044               )
     1045           then do:
     1046             find first buf_temp-browse-handle
     1047               where buf_temp-browse-handle.browse-type   = 'width':u
     1048                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1049               no-error .
     1050             if available buf_temp-browse-handle
     1051             then do:
     1052             end.
     1053             else do:
     1054               create buf_temp-diasize-handle .
     1055               assign
     1056                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1057                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1058               .
     1059             end.
     1060           end.
     1061           assign
     1062             v-object-handle = v-object-handle :next-sibling
     1063           .
     1064         end.
     1065         assign
     1066           v-field-group-handle = v-field-group-handle :next-sibling
     1067         .
     1068       end.
     1069       do with frame Dialog-Frame
     1070       :
     1071         hide v-diasize-resize-button .
     1072         v-diasize-resize-button :row = 1.
     1073         v-diasize-resize-button :column = 1.
     1074       end.
     1075       if p-change-value > 0
     1076       then do:
     1077         if frame Dialog-Frame :scrollable = true
     1078         then do:
     1079           assign
     1080             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1081             no-error .
     1082           if error-status :error
     1083           or error-status :get-message(1) <> ""
     1084           then do:
     1085             undo move_block, retry move_block.
     1086           end.
     1087         end.
     1088         assign
     1089           frame Dialog-Frame :width = v-frame-width + p-change-value
     1090           no-error .
     1091         if error-status :error
     1092         or error-status :get-message(1) <> ""
     1093         then do:
     1094           undo move_block, retry move_block.
     1095         end.
     1096         assign
     1097           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1098         no-error .
     1099         if error-status :error
     1100         or error-status :get-message(1) <> ""
     1101         then do:
     1102           undo move_block, retry move_block.
     1103         end.
     1104         for each buf_temp-browse-handle
     1105           where buf_temp-browse-handle.browse-type = 'width':u
     1106         on error undo move_block, retry move_block
     1107         :
     1108           assign
     1109             buf_temp-browse-handle.browse-handle :width
     1110               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1111             no-error .
     1112           if error-status :error
     1113           or error-status :get-message(1) <> ""
     1114           then do:
     1115             undo move_block, retry move_block .
     1116           end.
     1117         end.
     1118         for each buf_temp-diasize-handle
     1119         on error undo move_block, retry move_block
     1120         :
     1121           assign
     1122             v-object-handle = buf_temp-diasize-handle.handle-value
     1123           .
     1124           if v-object-handle <> v-diasize-resize-button
     1125           then do:
     1126             assign
     1127               v-object-handle :col = v-object-handle :col + p-change-value
     1128               no-error .
     1129             if error-status :error
     1130             or error-status :get-message(1) <> ""
     1131             then do:
     1132               undo move_block, retry move_block .
     1133             end.
     1134           end.
     1135         end.
     1136       end.
     1137       else do:
     1138         for each buf_temp-diasize-handle
     1139         on error undo move_block, retry move_block
     1140         :
     1141           assign
     1142             v-object-handle = buf_temp-diasize-handle.handle-value
     1143           .
     1144           if v-object-handle <> v-diasize-resize-button
     1145           then do:
     1146             assign
     1147               v-object-handle :col = v-object-handle :col + p-change-value
     1148               no-error .
     1149             if error-status :error
     1150             or error-status :get-message(1) <> ""
     1151             then do:
     1152               undo move_block, retry move_block .
     1153             end.
     1154           end.
     1155         end.
     1156         for each buf_temp-browse-handle
     1157           where buf_temp-browse-handle.browse-type = 'width':u
     1158         on error undo move_block, retry move_block
     1159         :
     1160           assign
     1161             buf_temp-browse-handle.browse-handle :width
     1162               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1163             no-error .
     1164           if error-status :error
     1165           or error-status :get-message(1) <> ""
     1166           then do:
     1167             undo move_block, retry move_block .
     1168           end.
     1169         end.
     1170         assign
     1171           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1172           no-error .
     1173         if error-status :error
     1174         or error-status :get-message(1) <> ""
     1175         then do:
     1176           undo move_block, retry move_block.
     1177         end.
     1178         assign
     1179           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1180         no-error .
     1181         if error-status :error
     1182         or error-status :get-message(1) <> ""
     1183         then do:
     1184           undo move_block, retry move_block.
     1185         end.
     1186         if frame Dialog-Frame :scrollable = true
     1187         then do:
     1188           assign
     1189             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1190           no-error .
     1191           if error-status :error
     1192           or error-status :get-message(1) <> ""
     1193           then do:
     1194             undo move_block, retry move_block.
     1195           end.
     1196         end.
     1197       end.
     1198       if p-move-resize
     1199       then do:
     1200         run diasize_position-resize-button in this-procedure .
     1201       end.
     1202       if v-diasize-wndstore = true
     1203       then do:
     1204         if connected("ub") = true
     1205         then do:
     1206           define variable v-cntxt-db-num        as integer   no-undo .
     1207           define variable v-cntxt-userid        as character no-undo .
     1208           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1209                                             , OUTPUT v-cntxt-userid
     1210                                             ) .
     1211           run gbl/wndsizew.p
     1212             (input  v-cntxt-db-num
     1213             ,input  v-cntxt-userid
     1214             ,input  v-diasize-proc-name
     1215             ,input  'width':u
     1216             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1217             ) .
     1218         end.
     1219       end.
     1220     end.
     1221     assign
     1222       v-diasize-change-size = false
     1223     .
     1224   end procedure.
     1225   procedure diasize_set-width :
     1226     define input  parameter p-new-width  as decimal   no-undo .
     1227     define input  parameter p-move-resize as logical   no-undo .
     1228     do
     1229     on error undo, return error return-value
     1230     :
     1231       run diasize_change-width in this-procedure
     1232         (input  (p-new-width - frame Dialog-Frame :width)
     1233         ,input  p-move-resize
     1234         ) .
     1235     end.
     1236   end procedure.
     1237   procedure diasize_position-resize-button :
     1238     do with frame Dialog-Frame
     1239     :
     1240       hide v-diasize-resize-button .
     1241       assign
     1242         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1243                     - 1
     1244                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1245         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1246                     - 1
     1247                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1248       .
     1249       view v-diasize-resize-button .
     1250     end.
     1251   end procedure.
     1252   on alt-right anywhere
     1253   do:
     1254     run diasize_change-width in this-procedure
     1255       (input 1
     1256       ,input true
     1257       ) .
     1258     return no-apply .
     1259   end.
     1260   on alt-left anywhere
     1261   do:
     1262     run diasize_change-width in this-procedure
     1263       (input -1
     1264       ,input true
     1265       ) .
     1266     return no-apply .
     1267   end.
     1268   on alt-down anywhere
     1269   do:
     1270     run diasize_change-height in this-procedure
     1271       (input 1
     1272       ,input true
     1273       ) .
     1274     return no-apply .
     1275   end.
     1276   on alt-up anywhere
     1277   do:
     1278     run diasize_change-height in this-procedure
     1279       (input -1
     1280       ,input true
     1281       ) .
     1282     return no-apply .
     1283   end.
     1284   on alt-enter of frame Dialog-Frame
     1285   do:
     1286     run diasize_maximize in this-procedure
     1287       (input  ?
     1288       ).
     1289     return no-apply .
     1290   end.
     1291   procedure diasize_end-move :
     1292     do
     1293     on error undo, return error return-value
     1294     :
     1295       define variable v-row-delta as decimal   no-undo .
     1296       define variable v-col-delta as decimal   no-undo .
     1297       define variable v-new-row as decimal   no-undo .
     1298       define variable v-new-col as decimal   no-undo .
     1299       assign
     1300         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1301         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1302       .
     1303       assign
     1304         v-row-delta = v-new-row - frame Dialog-Frame :height
     1305         v-col-delta = v-new-col - frame Dialog-Frame :width
     1306       .
     1307       run diasize_change-height in this-procedure
     1308         (input v-row-delta
     1309         ,input true
     1310         ) .
     1311       run diasize_change-width in this-procedure
     1312         (input v-col-delta
     1313         ,input true
     1314         ) .
     1315     end.
     1316   end procedure.
     1317   procedure diasize_maximize :
     1318     define input  parameter p-action as logical   no-undo .
     1319     do
     1320     on error undo, return error return-value
     1321     :
     1322       if p-action = ?
     1323       then do:
     1324         if v-diasize-need-maximize = true
     1325         then do:
     1326           assign
     1327             p-action = true
     1328           .
     1329         end.
     1330         else do:
     1331           assign
     1332             p-action = false
     1333           .
     1334         end.
     1335       end.
     1336       if p-action = true
     1337       then do:
     1338         run diasize_change-height in this-procedure
     1339           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1340               - frame Dialog-Frame :height-chars
     1341           ,input true
     1342           ) .
     1343         run diasize_change-width in this-procedure
     1344           (input session :width-chars
     1345               - frame Dialog-Frame :width-chars
     1346           ,input true
     1347           ) .
     1348         assign
     1349           v-diasize-need-maximize = false
     1350         .
     1351       end.
     1352       else do:
     1353         run diasize_change-width in this-procedure
     1354           (input v-diasize-orig-frame-width
     1355               - frame Dialog-Frame :width-chars
     1356           ,input true
     1357           ) .
     1358         run diasize_change-height in this-procedure
     1359           (input v-diasize-orig-frame-height
     1360               - frame Dialog-Frame :height-chars
     1361           ,input true
     1362           ) .
     1363         assign
     1364           v-diasize-need-maximize = true
     1365         .
     1366       end.
     1367     end.
     1368   end procedure.
     1369   procedure diasize_restore-orig-size :
     1370     do
     1371     on error undo, return error return-value
     1372     :
     1373       assign
     1374         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1375         v-diasize-current-frame-height = frame Dialog-Frame :height
     1376       .
     1377       run diasize_set-height in this-procedure
     1378         (input  v-diasize-orig-frame-height
     1379         ,input  true
     1380         ) .
     1381       run diasize_set-width in this-procedure
     1382         (input  v-diasize-orig-frame-width
     1383         ,input  true
     1384         ) .
     1385     end.
     1386   end procedure.
     1387   procedure diasize_restore-current-size :
     1388     do
     1389     on error undo, return error return-value
     1390     :
     1391       run diasize_set-height in this-procedure
     1392         (input  v-diasize-current-frame-height
     1393         ,input  true
     1394         ) .
     1395       run diasize_set-width in this-procedure
     1396         (input  v-diasize-current-frame-width
     1397         ,input  true
     1398         ) .
     1399     end.
     1400   end procedure.
     1401   procedure diasize_set-browse-handle :
     1402     define input  parameter p-browse-handle as handle   no-undo .
     1403     define buffer buf_temp-browse-handle for temp-browse-handle .
     1404     do
     1405     on error undo, return error return-value
     1406     :
     1407       assign
     1408         v-diasize-browse-handle = p-browse-handle
     1409       .
     1410       for each buf_temp-browse-handle
     1411       on error undo, return error return-value
     1412       :
     1413         delete buf_temp-browse-handle .
     1414       end.
     1415     end.
     1416   end procedure.
     1417   procedure diasize_add_browse :
     1418     define input  parameter p-browse-type   as character no-undo .
     1419     define input  parameter p-browse-handle as handle    no-undo .
     1420     define buffer buf_temp-browse-handle for temp-browse-handle .
     1421     do
     1422     on error undo, return error return-value
     1423     :
     1424       assign
     1425         v-diasize-browse-number = v-diasize-browse-number + 1
     1426       .
     1427       create buf_temp-browse-handle .
     1428       assign
     1429         buf_temp-browse-handle.browse-type   = p-browse-type
     1430         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1431         buf_temp-browse-handle.browse-handle = p-browse-handle
     1432       .
     1433     end.
     1434   end procedure.
     1435   procedure diasize_init :
     1436     define variable v-default-value    as logical   no-undo .
     1437     define variable v-restore-saved    as logical   no-undo .
     1438     define variable v-resize-value-str as character no-undo .
     1439     do
     1440     on error undo, return error return-value
     1441     :
     1442       do with frame Dialog-Frame
     1443       :
     1444         assign
     1445           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1446           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1447           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1448         .
     1449         create button v-diasize-resize-button
     1450         assign
     1451           parent        = frame Dialog-Frame :first-child
     1452           label         = "s"
     1453           height-pixels = 16
     1454           width-pixels  = 16
     1455           visible       = true
     1456           sensitive     = true
     1457           movable       = true
     1458           triggers:
     1459             on end-move persistent run diasize_end-move in this-procedure .
     1460           end triggers.
     1461         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1462         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1463         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1464         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1465         assign
     1466           v-diasize-wndmax = false
     1467         .
     1468         if connected("ub") = true
     1469         then do:
     1470           define variable v-cntxt-db-num        as integer   no-undo .
     1471           define variable v-cntxt-userid        as character no-undo .
     1472           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1473                                             , OUTPUT v-cntxt-userid
     1474                                             ) .
     1475           run gbl/wndpar_r.p
     1476             (input  v-cntxt-db-num
     1477             ,input  v-cntxt-userid
     1478             ,input  'wndmax':U
     1479             ,output v-diasize-wndmax
     1480             ,output v-default-value
     1481             ) .
     1482         end.
     1483         assign
     1484           v-diasize-wndstore = false
     1485         .
     1486         if connected("ub") = true
     1487         then do:
     1488           run gbl/wndpar_r.p
     1489             (input  v-cntxt-db-num
     1490             ,input  v-cntxt-userid
     1491             ,input  'wndstore':U
     1492             ,output v-diasize-wndstore
     1493             ,output v-default-value
     1494             ) .
     1495         end.
     1496         assign
     1497           v-diasize-proc-name = entry(1, program-name(2), '.')
     1498         .
     1499         if v-diasize-wndstore = true
     1500         then do:
     1501           assign
     1502             v-restore-saved = false
     1503           .
     1504           if connected("ub") = true
     1505           then do:
     1506             run gbl/wndsizer.p
     1507               (input  v-cntxt-db-num
     1508               ,input  v-cntxt-userid
     1509               ,input  v-diasize-proc-name
     1510               ,input  'height':u
     1511               ,output v-resize-value-str
     1512               ) .
     1513             if v-resize-value-str <> '':U
     1514             then do:
     1515               run diasize_change-height in this-procedure
     1516                 (input  integer(v-resize-value-str)
     1517                 ,input  true
     1518                 ) .
     1519               assign
     1520                 v-restore-saved = true
     1521               .
     1522             end.
     1523           end.
     1524           if connected("ub") = true
     1525           then do:
     1526             run gbl/wndsizer.p
     1527               (input  v-cntxt-db-num
     1528               ,input  v-cntxt-userid
     1529               ,input  v-diasize-proc-name
     1530               ,input  'width':u
     1531               ,output v-resize-value-str
     1532               ) .
     1533             if v-resize-value-str <> '':U
     1534             then do:
     1535               run diasize_change-width in this-procedure
     1536                 (input  integer(v-resize-value-str)
     1537                 ,input  true
     1538                 ) .
     1539               assign
     1540                 v-restore-saved = true
     1541               .
     1542             end.
     1543           end.
     1544           if v-restore-saved <> true
     1545           then do:
     1546             if v-diasize-wndmax = true
     1547             then do:
     1548               run diasize_maximize in this-procedure
     1549                 (input  true
     1550                 ) .
     1551             end.
     1552           end.
     1553         end.
     1554         else do:
     1555           if v-diasize-wndmax = true
     1556           then do:
     1557             run diasize_maximize in this-procedure
     1558               (input  true
     1559               ) .
     1560           end.
     1561         end.
     1562       end.
     1563     end.
     1564   end procedure.
     1565   procedure diasize_need-full-display :
     1566     define output parameter p-need-full-display as logical   no-undo .
     1567     do
     1568     on error undo, return error return-value
     1569     :
     1570       assign
     1571         p-need-full-display = v-diasize-need-full-display
     1572       .
     1573       assign
     1574         v-diasize-need-full-display = false
     1575       .
     1576     end.
     1577   end procedure.
     1578   procedure get-context :
     1579      define output parameter p-db-num as integer          no-undo.
     1580      define output parameter p-user-id as character        no-undo.
     1581      define variable v-login               as character    no-undo.
     1582      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1583      define buffer buf_user-login  for ub.user-login .
     1584      do
     1585      on error undo, return error
     1586      :
     1587            FIND FIRST buf_sys-ctrl no-lock.
     1588            ASSIGN
     1589               v-login = USERID("ub")
     1590               p-db-num = buf_sys-ctrl.db-num
     1591            .
     1592            FIND FIRST buf_user-login
     1593                 WHERE buf_user-login.db-num = p-db-num
     1594                   AND buf_user-login.user-login = v-login
     1595                 no-lock
     1596                 no-error
     1597                 .
     1598            IF AVAILABLE buf_user-login
     1599            THEN DO:
     1600               assign
     1601                  p-user-id = buf_user-login.user-id
     1602               .
     1603            END.
     1604      end.
     1605   end procedure.
     1606       run diasize_init in this-procedure .
     1607   MAIN-BLOCK:
     1608   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1609      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1610     run loadusr-tt (input paruser-name) no-error.
     1611       if error-status:error then do:
     1612         message "Ошибка при загрузке настроек клиента." skip
     1613                 return-value skip
     1614                 error-status:get-message(1) view-as alert-box.
     1615         return error.
     1616       end.
     1617     RUN enable_UI.
     1618     WAIT-FOR GO OF FRAME Dialog-Frame.
     1619   END.
     1620   RUN disable_UI.
     1621   PROCEDURE disable_UI :
     1622     HIDE FRAME Dialog-Frame.
     1623   END PROCEDURE.
     1624   PROCEDURE enable_UI :
     1625     ENABLE b-exit b-add b-del b-chg b-help BROWSE-1 b-up b-down
     1626         WITH FRAME Dialog-Frame.
     1627     VIEW FRAME Dialog-Frame.
     1628     oPEN QUERY BROWSE-1 FOR EACH tt-usrstko use-index level indexed-reposition.
     1629   END PROCEDURE.
