     1404   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1405   PROCEDURE cd-mrkt_plu-marketer :
     1406   define input parameter p-silence as logical no-undo .
     1407   define parameter buffer buf_cash-desk for ub.cash-desk.
     1408   define input parameter p-id as character no-undo .
     1409   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     1410   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     1411   define input parameter p-loc-ean as logical no-undo .
     1412   define input parameter p-is-petrolium as logical no-undo .
     1413   define input parameter p-extra as character no-undo .
     1414   define variable v-tot-gds as integer no-undo .
     1415   define variable v-max-gds as integer no-undo .
     1416   define variable v-petrol-start as integer no-undo .
     1417   define variable v-petrol-range as integer no-undo .
     1418   DEFINE VARIABLE v-today as date no-undo .
     1419   DEFINE VARIABLE v-time as integer no-undo .
     1420   define variable v-plu-type as character no-undo .
     1421   define variable v-int as integer no-undo .
     1422   define buffer  buf_cd-plu for ub.cd-plu.
     1423   define buffer  loc_cd-plu for ub.cd-plu.
     1424   define variable  ii as integer no-undo.
     1425   define variable v-mes as character no-undo .
     1426   _main:
     1427   DO ON ERROR undo, leave on stop undo, leave:
     1428     if buf_cash-desk.pos-type <> 'MARIA':U
     1429     or buf_cash-desk.cash-num <> 0 then do:
     1430       assign
     1431       v-mes =
     1432       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     1433                 , buf_cash-desk.pos-type).
     1434       if not p-silence then
     1435       message
     1436       v-mes
     1437       view-as alert-box error .
     1438       return error v-mes.
     1439     end.
     1440     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     1441                                     ,input 'MARIA_operative':U
     1442                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     1443                                           and p-is-petrolium
     1444                                           then 'tot-petrol':U
     1445                                           else 'tot-gds':U)
     1446                                     , output v-mes).
     1447     if v-tot-gds = ? then undo _main, return error v-mes.
     1448     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     1449                                     ,input 'MARIA_general':U
     1450                                     ,input 'max-gds':U
     1451                                     ,output v-mes).
     1452     if v-max-gds = ? then undo _main, return error v-mes.
     1453     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     1454                                          ,input 'petrolium-range':U
     1455                                          ,input 'petrolium-range':U
     1456                                          ,output v-mes).
     1457     if v-petrol-range = ? then undo _main, return error v-mes.
     1458     if buf_cash-desk.pos-type = 'MARIA':U then do:
     1459       assign
     1460       v-petrol-start = 1
     1461       v-max-gds = (if p-is-petrolium
     1462                    then v-petrol-range
     1463                    else v-max-gds)
     1464       v-plu-type = (if p-is-petrolium
     1465                  then 'топ':U
     1466                  else '':U)
     1467       .
     1468       if p-is-petrolium then do:
     1469         if p-id = '':U then do:
     1470           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     1471                               "Невозможно привязать к кассе типа &3"
     1472                               , p-b-str
     1473                               , chr(10)
     1474                               , 'MARIA':U).
     1475           if not p-silence then
     1476           message
     1477           v-mes
     1478           view-as alert-box error .
     1479           return error v-mes.
     1480         end.
     1481         assign
     1482         v-int = integer(p-id)
     1483         no-error
     1484         .
     1485         if error-status:error
     1486         or v-int > v-petrol-range then do:
     1487           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     1488                               "в диапазоны номеров резервуаров для кассы типа &4"
     1489                               , p-id
     1490                               , p-b-str
     1491                               , chr(10)
     1492                               , 'MARIA':U).
     1493           if not p-silence then
     1494           message
     1495           v-mes
     1496           view-as alert-box error .
     1497           return error v-mes.
     1498         end.
     1499       end.
     1500     end.
     1501     if buf_cash-desk.pos-type = 'MARIA':U
     1502     and p-is-petrolium then do:
     1503       find first loc_cd-plu where
     1504                loc_cd-plu.obj-type = 'маг':U
     1505            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     1506            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     1507            and loc_cd-plu.plu-type = 'топ':U
     1508      no-error .
     1509      if available loc_cd-plu then do:
     1510        if loc_cd-plu.b-code = p-b-code
     1511        and loc_cd-plu.b-str = p-b-str then do:
     1512           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     1513                               , p-id
     1514                               , p-b-str
     1515                               , chr(10)
     1516                               ).
     1517           if not p-silence then
     1518           message
     1519           v-mes
     1520           view-as alert-box WARNING .
     1521           return v-mes.
     1522        end.
     1523        else do:
     1524           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     1525                               "нельзя его привязать к топливу &2&3"
     1526                               , p-id
     1527                               , loc_cd-plu.b-str
     1528                               , chr(10)
     1529                               , p-b-str).
     1530           if not p-silence then
     1531           message
     1532           v-mes
     1533           view-as alert-box error .
     1534           return error v-mes.
     1535        end.
     1536      end.
     1537      ii = v-int.
     1538     end.
     1539     else do:
     1540       DO ii = (if p-is-petrolium
     1541               then v-petrol-start
     1542               else (if buf_cash-desk.pos-type = 'MARIA':U
     1543                    then 1
     1544                    else (if v-petrol-start = 1
     1545                           then (v-petrol-range + 1)
     1546                           else 1)
     1547                   )
     1548               )
     1549         to v-max-gds :
     1550         if not can-find (loc_cd-plu where
     1551                         loc_cd-plu.obj-type = 'маг':U
     1552                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     1553                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     1554                      and loc_cd-plu.plu-type = v-plu-type
     1555                      and loc_cd-plu.plu-code = ii
     1556                       )
     1557         then LEAVE .
     1558       END .
     1559     end.
     1560     if ii > v-max-gds then do:
     1561         if not p-silence then
     1562         message
     1563         substitute("Превышено максимально допустимое количество &5 &1" +
     1564                   "для касс &2 &3&4"
     1565                   , chr(10)
     1566                   , v-max-gds
     1567                   , 'маг':U
     1568                   , buf_cash-desk.obj-code
     1569                   , (if p-is-petrolium then "топлив" else "товаров")
     1570                   )
     1571         view-as alert-box ERROR .
     1572         undo, return error "max-gds":U.
     1573     end.
     1574     DO ii = (if p-is-petrolium
     1575              then v-petrol-start
     1576              else (if v-petrol-start = 1
     1577                    then (v-petrol-range + 1)
     1578                    else 1)
     1579              )
     1580        to v-max-gds :
     1581       if not can-find (loc_cd-plu where
     1582                         loc_cd-plu.obj-type = 'маг':U
     1583                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     1584                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     1585                      and loc_cd-plu.plu-type = v-plu-type
     1586                      and loc_cd-plu.plu-code = ii
     1587                      )
     1588       then LEAVE .
     1589     END .
     1590     if ii > v-max-gds then do:
     1591         if not p-silence then
     1592         message
     1593         substitute("Превышено максимально допустимое количество &5 &1" +
     1594                   "для касс &2 &3&4"
     1595                   , chr(10)
     1596                   , v-max-gds
     1597                   , 'маг':U
     1598                   , buf_cash-desk.obj-code
     1599                   , (if p-is-petrolium then "топлив" else "товаров")
     1600                   )
     1601         view-as alert-box ERROR .
     1602         undo, return error "max-gds":U.
     1603     end.
     1604     run cur-time in this-procedure ( output v-today, output v-time).
     1605     create buf_cd-plu.
     1606     assign
     1607     buf_cd-plu.b-code = p-b-code
     1608     buf_cd-plu.b-str = p-b-str
     1609     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     1610                                         then buf_cash-desk.addr-path
     1611                                         else "U":U)
     1612     buf_cd-plu.to-send = yes
     1613     buf_cd-plu.charkey_one = "":U
     1614     buf_cd-plu.to-del = no
     1615     buf_cd-plu.plu-code = ii
     1616     buf_cd-plu.obj-type = 'маг':U
     1617     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     1618     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     1619     buf_cd-plu.plu-type = v-plu-type
     1620     buf_cd-plu.logkey_one = p-loc-ean
     1621     buf_cd-plu.key#_one = integer(p-extra)
     1622     .
     1623     run cd-attr-write  in this-procedure (
     1624                                           input   buf_cash-desk.db-num
     1625                                           ,input  buf_cash-desk.obj-code
     1626                                           ,input  buf_cash-desk.pos-type
     1627                                           ,input  buf_cash-desk.cash-num
     1628                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     1629                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     1630                                                 and p-is-petrolium
     1631                                                 then 'tot-petrol':U
     1632                                                 else 'tot-gds':U)
     1633                                           ,input ''
     1634                                           ,input ?
     1635                                           ,input 0.0
     1636                                           ,input  (v-tot-gds + 1)
     1637                                           ,input no
     1638                                          ) no-error .
     1639     if error-status:error then do:
     1640       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     1641                          ,buf_cash-desk.cash-num
     1642                          , 'маг':U
     1643                          ,buf_cash-desk.obj-code
     1644                          , chr(10)
     1645                          , error-status:get-message(1)
     1646                          , return-value
     1647                          ).
     1648       if not p-silence then
     1649       message
     1650       v-mes
     1651       view-as alert-box error .
     1652       undo _main, return error v-mes.
     1653     end.
     1654     run cd-attr-write  in this-procedure (
     1655                                           input   buf_cash-desk.db-num
     1656                                           ,input  buf_cash-desk.obj-code
     1657                                           ,input  buf_cash-desk.pos-type
     1658                                           ,input  buf_cash-desk.cash-num
     1659                                           ,input  'MARIA_operative':U
     1660                                           ,input  'to-send':U
     1661                                           ,input ''
     1662                                           ,input ?
     1663                                           ,input 0.0
     1664                                           ,input 0
     1665                                           ,input yes
     1666                                          ) no-error .
     1667     if error-status:error then do:
     1668       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     1669                          ,buf_cash-desk.cash-num
     1670                          , 'маг':U
     1671                          ,buf_cash-desk.obj-code
     1672                          , chr(10)
     1673                          , error-status:get-message(1)
     1674                          , return-value
     1675                          ).
     1676       if not p-silence then
     1677       message
     1678       v-mes
     1679       view-as alert-box error .
     1680       undo _main, return error v-mes.
     1681     end.
     1682     return "":U.
     1683   end.
     1684   END PROCEDURE.
     1685   procedure cd-mrkt_update-marketer :
     1686   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     1687   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     1688   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     1689   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     1690   define input parameter p-is-petrolium as logical no-undo .
     1691   define variable v-to-send as logical no-undo .
     1692   define variable v-tot-gds as integer no-undo .
     1693   define variable v-max-plu as integer no-undo .
     1694   define buffer buf_cd-plu for ub.cd-plu.
     1695   define variable v-plu-type as character no-undo .
     1696     do
     1697     on error undo, return error
     1698     :
     1699       v-to-send = no.
     1700       v-tot-gds = 0.
     1701       assign
     1702       v-plu-type = (if p-is-petrolium
     1703                     then  'топ':U
     1704                     else '':U
     1705                 )
     1706       .
     1707       FOR EACH buf_cd-plu WHERE
     1708              buf_cd-plu.obj-type = 'маг':U
     1709         and  buf_cd-plu.obj-code = p-obj-code
     1710         and  buf_cd-plu.pos-type = p-pos-type
     1711         and  buf_cd-plu.plu-type = v-plu-type
     1712             :
     1713         if  buf_cd-plu.to-del
     1714         or  buf_cd-plu.to-send then do:
     1715           assign
     1716           v-to-send = yes.
     1717         end.
     1718         assign
     1719         v-tot-gds = v-tot-gds + 1.
     1720       end.
     1721       run cd-attr-write  in this-procedure (
     1722                                               input   p-db-num
     1723                                               ,input  p-obj-code
     1724                                               ,input  p-pos-type
     1725                                               ,input  p-cash-num
     1726                                               ,input  'MARIA_operative':U
     1727                                               ,input  (if p-pos-type = 'MARIA':U
     1728                                                        and p-is-petrolium
     1729                                                        then  'tot-petrol':U
     1730                                                        else 'tot-gds':U)
     1731                                               ,input ''
     1732                                               ,input ?
     1733                                               ,input 0.0
     1734                                               ,input v-tot-gds
     1735                                               ,input no
     1736                                                                                           ) no-error .
     1737       if error-status:error then do:
     1738           UNDO, RETURN ERROR RETURN-VALUE.
     1739       END.
     1740       run cd-attr-write  in this-procedure (
     1741                                               input   p-db-num
     1742                                               ,input  p-obj-code
     1743                                               ,input  p-pos-type
     1744                                               ,input  p-cash-num
     1745                                               ,input  'MARIA_operative':U
     1746                                               ,input  (if p-pos-type = 'MARIA':U
     1747                                                        and p-is-petrolium
     1748                                                        then  'petrol-to-send':U
     1749                                                        else 'to-send':U)
     1750                                               ,input ''
     1751                                               ,input ?
     1752                                               ,input 0.0
     1753                                               ,input 0
     1754                                               ,input v-to-send
     1755                                               ) no-error .
     1756       if error-status:error then do:
     1757           UNDO, RETURN ERROR RETURN-VALUE.
     1758       END.
     1759       FIND LAST buf_cd-plu NO-LOCK  WHERE
     1760                buf_cd-plu.obj-type = 'маг':U
     1761            and buf_cd-plu.obj-code = p-obj-code
     1762            and buf_cd-plu.pos-type = p-pos-type
     1763            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     1764       if available buf_cd-plu then do:
     1765         if v-max-plu < buf_cd-plu.plu-code
     1766         then
     1767         v-max-plu = buf_cd-plu.plu-code .
     1768       end.
     1769       else do:
     1770         v-max-plu = 0.
     1771       end.
     1772       run cd-attr-write  in this-procedure (
     1773                                             input   p-db-num
     1774                                             ,input  p-obj-code
     1775                                             ,input  p-pos-type
     1776                                             ,input  p-cash-num
     1777                                             ,input  'MARIA_operative':U
     1778                                             ,input  (if p-pos-type = 'MARIA':U
     1779                                                     and p-is-petrolium
     1780                                                     then 'max-petrol-plu':U
     1781                                                     else 'max-plu':U)
     1782                                               ,input ''
     1783                                               ,input ?
     1784                                               ,input 0.0
     1785                                               ,input v-max-plu
     1786                                               ,input no
     1787                                             ) no-error .
     1788       if error-status:error then do:
     1789           UNDO, RETURN ERROR RETURN-VALUE.
     1790       END.
     1791     end.
     1792   end procedure.
     1793   PROCEDURE cd-mrkt_clu-marketer :
     1794   define input parameter p-silence as logical no-undo .
     1795   define parameter buffer buf_cash-desk for ub.cash-desk.
     1796   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1797   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1798   define variable v-tot-cli as integer no-undo .
     1799   define variable v-max-cli as integer no-undo .
     1800   DEFINE VARIABLE v-today as date no-undo .
     1801   DEFINE VARIABLE v-time as integer no-undo .
     1802   define buffer  buf_cd-clu for ub.cd-clu.
     1803   define buffer  loc_cd-clu for ub.cd-clu.
     1804   define variable  ii as integer no-undo.
     1805   define variable v-mes as character no-undo .
     1806   _main:
     1807   DO ON ERROR undo, leave on stop undo, leave:
     1808     if buf_cash-desk.pos-type <> 'MARIA':U
     1809     or buf_cash-desk.cash-num <> 0 then do:
     1810       assign
     1811       v-mes =
     1812       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     1813                 , buf_cash-desk.pos-type).
     1814       if not p-silence then
     1815       message
     1816       v-mes
     1817       view-as alert-box error .
     1818       return error v-mes.
     1819     end.
     1820     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     1821                                     ,input 'MARIA_operative':U
     1822                                     ,input 'tot-cli':U
     1823                                     ,output v-mes).
     1824     if v-tot-cli = ? then undo _main, return error v-mes.
     1825     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     1826                                     ,input 'MARIA_general':U
     1827                                     ,input 'max-cli':U
     1828                                     , output v-mes).
     1829     if v-max-cli = ? then undo _main, return error v-mes.
     1830     DO ii = 1
     1831        to v-max-cli :
     1832       if not can-find (loc_cd-clu where
     1833                       loc_cd-clu.obj-type = 'маг':U
     1834                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     1835                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     1836                   and loc_cd-clu.clu-type = '':U
     1837                   and loc_cd-clu.clu-code = ii
     1838                      )
     1839       then LEAVE .
     1840     END .
     1841     if ii > v-max-cli then do:
     1842         if not p-silence then
     1843         message
     1844         substitute("Превышено максимально допустимое количество клиентов &1" +
     1845                   "для касс &2 &3&4"
     1846                   , chr(10)
     1847                   , v-max-cli
     1848                   , 'маг':U
     1849                   , buf_cash-desk.obj-code
     1850                   )
     1851         view-as alert-box ERROR .
     1852         undo, return error "max-cli":U.
     1853     end.
     1854     run cur-time in this-procedure ( output v-today, output v-time).
     1855     create buf_cd-clu.
     1856     assign
     1857     buf_cd-clu.cli-code = p-obj-code
     1858     buf_cd-clu.cli-type = p-obj-type
     1859     buf_cd-clu.obj-type = 'маг':U
     1860     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     1861     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     1862     buf_cd-clu.clu-type = '':U
     1863     buf_cd-clu.to-send = yes
     1864     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     1865                               then buf_cash-desk.addr-path
     1866                               else "U":U)
     1867     buf_cd-clu.clu-code = ii
     1868     .
     1869     run cd-attr-write  in this-procedure (
     1870                                           input   buf_cash-desk.db-num
     1871                                           ,input  buf_cash-desk.obj-code
     1872                                           ,input  buf_cash-desk.pos-type
     1873                                           ,input  buf_cash-desk.cash-num
     1874                                           ,input  'MARIA_operative':U
     1875                                           ,input  'tot-cli':U
     1876                                           ,input ''
     1877                                           ,input ?
     1878                                           ,input 0.0
     1879                                           ,input  (v-tot-cli + 1)
     1880                                           ,input no
     1881                                          ) no-error .
     1882     if error-status:error then do:
     1883       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     1884                          ,buf_cash-desk.cash-num
     1885                          , 'маг':U
     1886                          ,buf_cash-desk.obj-code
     1887                          , chr(10)
     1888                          , error-status:get-message(1)
     1889                          , return-value
     1890                          ).
     1891       if not p-silence then
     1892       message
     1893       v-mes
     1894       view-as alert-box error .
     1895       undo _main, return error v-mes.
     1896     end.
     1897     run cd-attr-write  in this-procedure (
     1898                                           input   buf_cash-desk.db-num
     1899                                           ,input  buf_cash-desk.obj-code
     1900                                           ,input  buf_cash-desk.pos-type
     1901                                           ,input  buf_cash-desk.cash-num
     1902                                           ,input  'MARIA_operative':U
     1903                                           ,input  'cli-to-send':U
     1904                                           ,input ''
     1905                                           ,input ?
     1906                                           ,input 0.0
     1907                                           ,input 0
     1908                                           ,input yes
     1909                                          ) no-error .
     1910     if error-status:error then do:
     1911       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     1912                          ,buf_cash-desk.cash-num
     1913                          , 'маг':U
     1914                          ,buf_cash-desk.obj-code
     1915                          , chr(10)
     1916                          , error-status:get-message(1)
     1917                          , return-value
     1918                          ).
     1919       if not p-silence then
     1920       message
     1921       v-mes
     1922       view-as alert-box error .
     1923       undo _main, return error v-mes.
     1924     end.
     1925     return "":U.
     1926   end.
     1927   END PROCEDURE.
     1928   procedure cd-mrkt_update-marketer-cli :
     1929   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     1930   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     1931   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     1932   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     1933   define variable v-cli-to-send as logical no-undo .
     1934   define variable v-tot-cli as integer no-undo .
     1935   define variable v-max-clu as integer no-undo .
     1936   define buffer buf_cd-clu for ub.cd-clu.
     1937   do
     1938   on error undo, return error return-value
     1939   :
     1940     v-cli-to-send = no.
     1941     v-tot-cli = 0.
     1942     FOR EACH buf_cd-clu WHERE
     1943           buf_cd-clu.obj-type = 'маг':U
     1944       and buf_cd-clu.obj-code =  p-obj-code
     1945       and buf_cd-clu.pos-type =  p-pos-type
     1946       and buf_cd-clu.clu-type =  '':U
     1947       :
     1948       if buf_cd-clu.to-del = yes then do:
     1949         assign
     1950         v-cli-to-send = yes.
     1951       end.
     1952       assign
     1953       v-tot-cli = v-tot-cli + 1.
     1954     end.
     1955     run cd-attr-write  in this-procedure (
     1956                                             input   p-db-num
     1957                                             ,input  p-obj-code
     1958                                             ,input  p-pos-type
     1959                                             ,input  p-cash-num
     1960                                             ,input  'MARIA_operative':U
     1961                                             ,input  'tot-cli':U
     1962                                             ,input ''
     1963                                             ,input ?
     1964                                             ,input 0.0
     1965                                             ,input v-tot-cli
     1966                                             ,input no
     1967                                             ) no-error .
     1968     if error-status:error then do:
     1969         UNDO, RETURN ERROR RETURN-VALUE.
     1970     END.
     1971     run cd-attr-write  in this-procedure (
     1972                                             input   p-db-num
     1973                                             ,input  p-obj-code
     1974                                             ,input  p-pos-type
     1975                                             ,input  p-cash-num
     1976                                             ,input  'MARIA_operative':U
     1977                                             ,input  'cli-to-send':U
     1978                                             ,input ''
     1979                                             ,input ?
     1980                                             ,input 0.0
     1981                                             ,input 0
     1982                                             ,input v-cli-to-send
     1983                                             ) no-error .
     1984     if error-status:error then do:
     1985         UNDO, RETURN ERROR RETURN-VALUE.
     1986     END.
     1987     FIND LAST buf_cd-clu WHERE
     1988             buf_cd-clu.obj-type = 'маг':U
     1989         and buf_cd-clu.obj-code = p-obj-code
     1990         and buf_cd-clu.pos-type = p-pos-type
     1991         and buf_cd-clu.clu-type = '':U
     1992         NO-LOCK use-index pi no-error .
     1993     if available buf_cd-clu then do:
     1994       if v-max-clu < buf_cd-clu.clu-code
     1995       then
     1996       v-max-clu = buf_cd-clu.clu-code.
     1997     end.
     1998     else do:
     1999       v-max-clu = 0.
     2000     end.
     2001     run cd-attr-write  in this-procedure (
     2002                                           input   p-db-num
     2003                                           ,input  p-obj-code
     2004                                           ,input  p-pos-type
     2005                                           ,input  p-cash-num
     2006                                           ,input  'MARIA_operative':U
     2007                                           ,input  'max-clu':U
     2008                                           ,input ''
     2009                                           ,input ?
     2010                                           ,input 0.0
     2011                                           ,input v-max-clu
     2012                                           ,input no
     2013                                           ) no-error .
     2014     if error-status:error then do:
     2015         UNDO, RETURN ERROR RETURN-VALUE.
     2016     END.
     2017   end.
     2018   end procedure.
