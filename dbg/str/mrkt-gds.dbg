     5057           .
     5058       end.
     5059     end.
     5060     if l-filter-open-41 = false then do:
     5061       OPEN QUERY br-mgds FOR EACH X_cd-plu
     5062         where          X_cd-plu.obj-type = p-curr-obj-type and X_cd-plu.obj-code = p-curr-obj-code         and X_cd-plu.plu-type = p-plu-type  and X_cd-plu.pos-type = p-pos-type
     5063       , first X_bar-code NO-LOCK WHERE X_bar-code.b-code = X_cd-plu.b-code OUTER-JOIN ,                                 FIRST X_goods NO-LOCK WHERE X_goods.gds-code = X_bar-code.gds-code OUTER-JOIN
     5064         indexed-reposition
     5065     .
