     5007             then  substitute(' X_cd-plu.obj-type = &1&2&1 and X_cd-plu.obj-code = &3         and X_cd-plu.plu-type = &1&4&1  and X_cd-plu.pos-type = &1&5&1 ', chr(34), p-curr-obj-type, p-curr-obj-code, p-plu-type, p-pos-type) + " " + where-phrase-41
     5008             else "true"
     5009           )
     5010         parameter-5-41 = (" " + "" + " " + ", first X_bar-code NO-LOCK WHERE X_bar-code.b-code = X_cd-plu.b-code OUTER-JOIN ,                                 FIRST X_goods NO-LOCK WHERE X_goods.gds-code = X_bar-code.gds-code OUTER-JOIN")
     5011         parameter-6-41 = if sort-phrase-41 = ''
     5012                              then
     5013           (
     5014           " " + "  " +
     5015             " " + sort-column-phrase +
     5016           " " + "  "
     5017           )
     5018                              else
     5019           (
     5020           " " + "  " +
     5021             " " + sort-column-phrase +
     5022           " " + sort-phrase-41
     5023           )
     5024         parameter-7-41 =
     5025           " indexed-reposition  "
     5026       .
     5027       do
     5028       on stop undo, leave
     5029       on error undo, leave
     5030       :
     5031         assign
     5032           l-disable-where-41 =
     5033             ("         X_cd-plu.obj-type = p-curr-obj-type and X_cd-plu.obj-code = p-curr-obj-code         and X_cd-plu.plu-type = p-plu-type  and X_cd-plu.pos-type = p-pos-type                     " + " " + where-phrase-41 = "")
     5034         .
     5035         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     5036                             ,input QUERY br-mgds:handle
     5037                             ,input parameter-3-41
     5038                             ,input parameter-4-41
     5039                             ,input parameter-5-41
     5040                             ,input parameter-6-41
