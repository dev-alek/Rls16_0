     2029   FUNCTION mark-string RETURNS CHARACTER
     2030     ( input p-recid as recid, input mark-list as character  ) :
     2031     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     2032   END FUNCTION.
     2033   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2034   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     2035   procedure fltopend_fltopend :
     2036   define input parameter p-parent-handle as handle no-undo .
     2037   define input parameter p-qh as handle no-undo .
     2038   define input parameter p-flt-open-open-query  as character no-undo .
     2039   define input parameter p-where-cond as character no-undo .
     2040   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2041   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2042   define input parameter p-indexed-reposition as character no-undo .
     2043     do
     2044     on error undo, return error
     2045     :
     2046   define variable v-prepare-string as character no-undo .
     2047   define variable glog as logical no-undo .
     2048   assign
     2049   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2050                      p-where-cond + chr(32)  +
     2051                      p-use-indFIRST-query-tail + chr(32) +
     2052                      p-use-ind-sort-clmn-by + chr(32) +
     2053                      p-indexed-reposition
     2054   .
     2055   assign
     2056   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2057   if not glog
     2058   or error-status:error then do:
     2059     message error-status:get-message(1) view-as alert-box .
     2060     undo, return error .
     2061   end.
     2062   assign
     2063   glog = p-qh:query-open no-error .
     2064   if not glog
     2065   or error-status:error then do:
     2066     message error-status:get-message(1) view-as alert-box .
     2067     undo, return error .
     2068   end.
     2069     end.
     2070   end procedure.
     2071   procedure fltopend_fltfindd :
     2072   define input parameter p-parent-handle as handle no-undo .
     2073   define input parameter p-qh as handle no-undo .
     2074   define input parameter p-rowid as rowid no-undo .
     2075   define input parameter p-next as logical no-undo .
     2076   define input parameter p-lock as integer no-undo .
     2077   define input parameter p-bh as handle no-undo .
     2078   define input parameter p-where-cond as character no-undo .
     2079   define input parameter p-use-index-phrase as character no-undo .
     2080   define variable glog as logical no-undo .
     2081   define variable v-qh as handle no-undo .
     2082   define variable v-bh as handle no-undo .
     2083   define variable v-recid as recid no-undo .
     2084   define variable v-prepare-string as character no-undo .
     2085   do
     2086   on error undo, return error
     2087   on stop undo, return error
     2088   :
     2089     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2090     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2091     create query v-qh.
     2092     v-qh:set-buffers(v-bh).
     2093     v-prepare-string = substitute("for each &1 &2 &3"
     2094                                     ,v-bh:name
     2095                                     ,p-where-cond
     2096                                     ,p-use-index-phrase).
     2097     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2098     if not glog then do:
     2099       delete object v-qh.
     2100       delete object v-bh.
     2101       undo, return error .
     2102     end.
     2103     glog = v-qh:query-open no-error .
     2104     if not glog then do:
     2105       delete object v-qh.
     2106       delete object v-bh.
     2107       undo, return error .
     2108     end.
     2109     if p-next then do:
     2110       v-qh:reposition-to-rowid(p-rowid) no-error .
     2111       glog = v-qh:get-next( p-lock) no-error .
     2112       glog = v-qh:get-next( p-lock) no-error .
     2113       if not glog or v-qh:query-off-end = yes then do:
     2114         glog = v-qh:get-first( p-lock) no-error .
     2115       end.
     2116     end.
     2117     else do:
     2118       glog = v-qh:get-first( p-lock) no-error .
     2119     end.
     2120     v-recid = v-bh:recid no-error .
     2121     delete object v-qh.
     2122     delete object v-bh.
     2123     return string(v-recid) .
     2124   end.
     2125   end procedure.
     2126   procedure fltopend_fltfindq :
     2127   define input parameter p-parent-handle as handle no-undo .
     2128   define input parameter p-qh as handle no-undo .
     2129   define input parameter p-next as logical no-undo .
     2130   define input parameter p-lock as integer no-undo .
     2131   define input parameter p-flt-open-open-query  as character no-undo .
     2132   define input parameter p-where-cond as character no-undo .
     2133   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2134   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2135   define input parameter p-indexed-reposition as character no-undo .
     2136   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2137   define variable glog as logical no-undo .
     2138   define variable v-qh as handle no-undo .
     2139   define variable v-bh as handle no-undo extent 18.
     2140   define variable v-rowid as rowid no-undo extent 18.
     2141   define variable v-ii as integer no-undo .
     2142   define variable v-prepare-string as character no-undo .
     2143   do
     2144   on error undo, return error
     2145   on stop undo, return error
     2146   :
     2147     create query v-qh.
     2148     do v-ii = 1 to p-qh:num-buffers:
     2149       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2150       assign
     2151       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2152       no-error.
     2153       v-qh:add-buffer(v-bh[v-ii]).
     2154     end.
     2155     assign
     2156     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2157                       p-where-cond + chr(32)  +
     2158                       p-use-indFIRST-query-tail + chr(32) +
     2159                       p-use-ind-sort-clmn-by + chr(32) +
     2160                       p-indexed-reposition
     2161     .
     2162     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2163     if not glog then do:
     2164       delete object v-qh.
     2165       do v-ii = 1 to p-qh:num-buffers:
     2166         delete object v-bh[v-ii].
     2167       end.
     2168       undo, return error .
     2169     end.
     2170     glog = v-qh:query-open no-error .
     2171     if not glog then do:
     2172       delete object v-qh.
     2173       do v-ii = 1 to p-qh:num-buffers:
     2174         delete object v-bh[v-ii].
     2175       end.
     2176       undo, return error .
     2177     end.
     2178     if p-next then do:
     2179       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2180       glog = v-qh:get-next( p-lock) no-error .
     2181       glog = v-qh:get-next( p-lock) no-error .
     2182       if not glog or v-qh:query-off-end = yes then do:
     2183         glog = v-qh:get-first( p-lock) no-error .
     2184       end.
     2185     end.
     2186     else do:
     2187       glog = v-qh:get-first( p-lock) no-error .
     2188     end.
     2189     do v-ii = 1 to p-qh:num-buffers:
     2190       assign
     2191       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2192       no-error.
     2193     end.
     2194     delete object v-qh.
     2195     do v-ii = 1 to p-qh:num-buffers:
     2196       delete object v-bh[v-ii].
     2197     end.
     2198   end.
     2199   end procedure.
