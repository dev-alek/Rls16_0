     5069     end.
     5070   end.
     5071   else do:
     5072     assign
     5073       v-doc-rec = recid( X_cd-plu )
     5074     .
     5075     do
     5076     on stop undo, leave
     5077     on error undo, leave
     5078     :
     5079       if QUERY br-mgds:handle:get-buffer-handle(1) = (buffer X_cd-plu:handle) then do:
     5080         assign
     5081         parameter-2-41 = (if p-find-next then "true":u else "false":u )
     5082         parameter-4-41 =
     5083           "where ":u +  substitute(' X_cd-plu.obj-type = &1&2&1 and X_cd-plu.obj-code = &3         and X_cd-plu.plu-type = &1&4&1  and X_cd-plu.pos-type = &1&5&1 ', chr(34), p-curr-obj-type, p-curr-obj-code, p-plu-type, p-pos-type) + " ":u + where-phrase-41 + " ":u + p-find-condition + " " + ""
     5084         parameter-5-41 = "  "
     5085       .
     5086         run fltopend_fltfindd in this-procedure  (
     5087                             input this-procedure:handle
     5088                             ,input QUERY br-mgds:handle
     5089                             ,input rowid(X_cd-plu)
     5090                             ,input logical(parameter-2-41)
     5091                             ,input no-lock
     5092                             ,input (buffer X_cd-plu:handle)
     5093                             ,input parameter-4-41
     5094                             ,input parameter-5-41
     5095                             ) no-error.
     5096         .
     5097         assign
     5098           v-doc-rec = integer(return-value)
     5099           v-fltopend-rowid[1] = ?
     5100         .
     5101       end.
     5102       else do:
     5103         assign
     5104         parameter-2-41 = (if p-find-next then "true":u else "false":u )
     5105         parameter-3-41 =  "FOR EACH X_cd-plu"
     5106         parameter-4-41 =
     5107           (
     5108             if ("         X_cd-plu.obj-type = p-curr-obj-type and X_cd-plu.obj-code = p-curr-obj-code         and X_cd-plu.plu-type = p-plu-type  and X_cd-plu.pos-type = p-pos-type                     " + " " + where-phrase-41) <> ""
     5109             then  substitute(' X_cd-plu.obj-type = &1&2&1 and X_cd-plu.obj-code = &3         and X_cd-plu.plu-type = &1&4&1  and X_cd-plu.pos-type = &1&5&1 ', chr(34), p-curr-obj-type, p-curr-obj-code, p-plu-type, p-pos-type) + " " + where-phrase-41
     5110             else "true"
     5111           )
     5112         parameter-5-41 = (" " + "" + " " + ", first X_bar-code NO-LOCK WHERE X_bar-code.b-code = X_cd-plu.b-code OUTER-JOIN ,                                 FIRST X_goods NO-LOCK WHERE X_goods.gds-code = X_bar-code.gds-code OUTER-JOIN" + " " + p-find-condition)
     5113         parameter-6-41 = if sort-phrase-41 = ''
     5114                              then
     5115           (
     5116           " " + "  " +
     5117             " " + sort-column-phrase +
     5118           " " + "  "
     5119           )
     5120                              else
     5121           (
     5122           " " + "  " +
     5123             " " + sort-column-phrase +
     5124           " " + sort-phrase-41
     5125           )
     5126         parameter-7-41 =
     5127           " indexed-reposition  "
     5128       .
     5129         run fltopend_fltfindq in this-procedure  (
     5130                             input this-procedure:handle
     5131                             ,input QUERY br-mgds:handle
     5132                             ,input logical(parameter-2-41)
     5133                             ,input no-lock
     5134                             ,input parameter-3-41
     5135                             ,input parameter-4-41
     5136                             ,input parameter-5-41
     5137                             ,input parameter-6-41
     5138                             ,input parameter-7-41
     5139                             ,output v-fltopend-rowid
     5140                             ) no-error.
     5141         .
     5142         v-doc-rec = ?.
     5143       end.
     5144       assign
     5145         l-query-was-opened = true
     5146       .
     5147     end.
     5148   end.
     5149     run waitfram-hide in this-procedure .
     5150     END.
     5151   END CASE.
     5152   if not p-open-query and v-doc-rec <> ? then
     5153   REPOSITION br-mgds to recid v-doc-rec No-ERROR.
     5154   if not p-open-query and v-fltopend-rowid[1] <> ? then
     5155   query br-mgds:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     5156   run waitfram-hide in this-procedure .
     5157   APPLY "VALUE-CHANGED" TO br-mgds in frame Dialog-Frame.
     5158   APPLY "ENTRY" TO br-mgds.
     5159   END PROCEDURE.
     5160   PROCEDURE proc-b-chg :
     5161   define variable old-mode as char no-undo.
     5162   define variable old-handle as handle no-undo.
     5163   define variable old-type as char no-undo.
     5164   define variable old-stat as char no-undo.
     5165   define variable old-flag as logical no-undo.
     5166   define variable old-internal as logical no-undo.
     5167   DEFINE VARIABLE v-skip-next as logical no-undo .
     5168   DEFINE VARIABLE v-update as logical no-undo .
     5169   define variable v-f-name as character no-undo .
     5170   define variable l-empty-scale as logical no-undo .
     5171   define variable ves-err as integer no-undo .
     5172   define variable v-to-send as logical no-undo .
     5173   define variable v-mes as character no-undo .
     5174   define variable v-is-petrol as logical no-undo .
     5175   define variable bar_code as character no-undo .
     5176   define variable v-restore as logical   no-undo .
     5177   define variable v-pl-code as integer no-undo .
     5178   define variable v-found as logical no-undo .
     5179   define variable v-is-prt as logical no-undo .
     5180   define variable v-empty-code as integer no-undo .
     5181   define buffer buf_bar-code for ub.bar-code.
     5182   define buffer buf_prod-bc for ub.prod-bc.
     5183   define buffer buf_gds-prt for ub.gds-prt.
     5184   DEFINE BUFFER buf_cd-plu FOR ub.cd-plu.
     5185   define buffer check_cd-plu for ub.cd-plu.
     5186   define buffer buf_pl-gds for ub.pl-gds.
     5187   define buffer buf_place for ub.place.
     5188   FOR EACH bb-list :
     5189       delete bb-list.
     5190   END.
     5191   FOR EACH save-list:
     5192     delete save-list.
     5193   end.
     5194   run waitfram-show in this-procedure ( input "ЖДИТЕ.  Заполняется список...").
     5195   _block:
     5196   DO ON error UNDO _block, return error
     5197   on stop undo _block, return error:
     5198   _cd-plu:
     5199     FOR EACH buf_cd-plu  WHERE
     5200            buf_cd-plu.obj-type = p-curr-obj-type
     5201        and buf_cd-plu.obj-code = p-curr-obj-code
     5202        and buf_cd-plu.pos-type = p-pos-type
     5203        and buf_cd-plu.plu-type = p-plu-type
     5204     by buf_cd-plu.plu-code:
     5205        IF buf_cd-plu.charkey_one = v-cd-list-delete THEN NEXT.
     5206        buf_cd-plu.charkey_one = v-cd-list-delete.
     5207       FIND FIRST buf_bar-code WHERE
     5208               buf_bar-code.b-code = buf_cd-plu.b-code NO-LOCK no-error .
     5209       if not available buf_bar-code then do:
     5210         assign
     5211         buf_cd-plu.charkey_one = v-cd-list-delete
     5212         buf_cd-plu.to-del = yes
     5213         .
     5214         next _cd-plu.
     5215       end.
     5216       FIND FIRST ub.goods WHERE
     5217               ub.goods.gds-code = buf_bar-code.gds-code NO-LOCK.
     5218       FIND FIRST buf_gds-prt where
     5219                   buf_gds-prt.upper-code = ub.goods.prt-root NO-LOCK .
     5220       assign
     5221       l-empty-scale =  (buf_gds-prt.node-name <> '_Пустая шкала':U)
     5222       .
     5223       if l-empty-scale then  do:
     5224       end.
     5225       else do:
     5226         find first buf_gds-prt no-lock where
     5227                   buf_gds-prt.node-code = buf_bar-code.node-code no-error.
     5228         if not available buf_gds-prt
     5229         then v-f-name = "!!!Неизвестный признак шкалы".
     5230         else v-f-name = buf_gds-prt.f-name.
     5231       end.
     5232   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5233   find first bb-list
     5234     where bb-list.gds-code = buf_bar-code.gds-code
     5235       and bb-list.b-code   = buf_bar-code.b-code
     5236       and bb-list.b-str    = buf_cd-plu.b-str
     5237     no-error .
     5238   if available bb-list then do:
     5239     assign
     5240       bb-list.to-del = no
     5241     .
     5242   end.
     5243   else do:
     5244     define variable v-last42 as integer no-undo .
     5245     find last bb-list use-index oi no-error.
     5246     if available bb-list then do:
     5247       v-last42 = bb-list.order-num .
     5248     end.
     5249     else do:
     5250       v-last42 = 0 .
     5251     end.
     5252     create bb-list .
     5253     buffer-copy goods to bb-list
     5254     assign
     5255       bb-list.to-del = no
     5256       bb-list.order-num = v-last42 + 1
     5257       bb-list.b-code = buf_bar-code.b-code
     5258       bb-list.bc-cli-base-rate = buf_bar-code.cli-base-rate
     5259       bb-list.bc-cr-db-num     = buf_bar-code.cr-db-num
     5260       bb-list.in-code       = buf_bar-code.in-code
     5261       bb-list.node-code     = buf_bar-code.node-code
     5262       bb-list.part-code     = buf_bar-code.part-code
     5263       bb-list.stts_         = buf_bar-code.stts_
     5264       bb-list.bc-unit-cli   = buf_bar-code.unit-cli
     5265       bb-list.b-str         = buf_cd-plu.b-str
     5266       bb-list.f-name        = v-f-name
     5267       bb-list.loc-ean       = buf_cd-plu.logkey_one
     5268       .
     5269       if available buf_prod-bc
     5270       then
     5271       assign
     5272       bb-list.bc-on-type    = buf_prod-bc.bc-on-type
     5273       bb-list.bc-on         = buf_prod-bc.bc-on
     5274       bb-list.pbc-cr-db-num = buf_prod-bc.cr-db-num
     5275       .
     5276     assign
     5277       lns-cnt = lns-cnt + 1
     5278       line-rec = recid (bb-list)
     5279     .
     5280   end.
     5281   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5282   find first save-list
     5283     where save-list.gds-code = buf_bar-code.gds-code
     5284       and save-list.b-code   = buf_bar-code.b-code
     5285       and save-list.b-str    = buf_cd-plu.b-str
     5286     no-error .
     5287   if available save-list then do:
     5288     assign
     5289       save-list.to-del = no
     5290     .
     5291   end.
     5292   else do:
     5293     define variable v-last43 as integer no-undo .
     5294     find last save-list use-index oi no-error.
     5295     if available save-list then do:
     5296       v-last43 = save-list.order-num .
     5297     end.
     5298     else do:
     5299       v-last43 = 0 .
     5300     end.
     5301     create save-list .
     5302     buffer-copy goods to save-list
     5303     assign
     5304       save-list.to-del = no
     5305       save-list.order-num = v-last43 + 1
     5306       save-list.b-code = buf_bar-code.b-code
     5307       save-list.bc-cli-base-rate = buf_bar-code.cli-base-rate
     5308       save-list.bc-cr-db-num     = buf_bar-code.cr-db-num
     5309       save-list.in-code       = buf_bar-code.in-code
     5310       save-list.node-code     = buf_bar-code.node-code
     5311       save-list.part-code     = buf_bar-code.part-code
     5312       save-list.stts_         = buf_bar-code.stts_
     5313       save-list.bc-unit-cli   = buf_bar-code.unit-cli
     5314       save-list.b-str         = buf_cd-plu.b-str
     5315       save-list.f-name        = v-f-name
     5316       save-list.loc-ean       = buf_cd-plu.logkey_one
     5317       .
     5318       if available buf_prod-bc
     5319       then
     5320       assign
     5321       save-list.bc-on-type    = buf_prod-bc.bc-on-type
     5322       save-list.bc-on         = buf_prod-bc.bc-on
     5323       save-list.pbc-cr-db-num = buf_prod-bc.cr-db-num
     5324       .
     5325     assign
     5326       lns-cnt = lns-cnt + 1
     5327       line-rec = recid (save-list)
     5328     .
     5329   end.
     5330       assign
     5331       buf_cd-plu.charkey_one = v-cd-list-delete
     5332       buf_cd-plu.to-del = yes
     5333       .
     5334     end.
     5335   run waitfram-hide in this-procedure .
     5336   END.
     5337   run run-bb-list in this-procedure no-error .
     5338   if error-status:error then do:
     5339     assign
     5340     v-restore = yes.
     5341   end.
     5342   if not v-restore then do:
     5343     message
     5344     substitute("Вы действительно хотите изменить список товаров на кассах &4 на &1&2&3" +
     5345               "в соответствии с данным списком кодов?"
     5346               , p-curr-obj-type
     5347               , p-curr-obj-code
     5348               , chr(10)
     5349               , p-pos-type
     5350               )
     5351     view-as alert-box QUESTION buttons YES-NO update v-update.
     5352   end.
     5353   if not v-update then do:
     5354     FOR EACH bb-list:
     5355       delete bb-list.
     5356     END.
     5357     FOR EACH buf_cd-plu where
     5358            buf_cd-plu.obj-type = p-curr-obj-type
     5359        and buf_cd-plu.obj-code = p-curr-obj-code
     5360        and buf_cd-plu.pos-type = p-pos-type
     5361        and buf_cd-plu.plu-type = p-plu-type,
     5362         FIRST save-list WHERE
     5363               save-list.b-code = buf_cd-plu.b-code
     5364            AND save-list.b-str = buf_cd-plu.b-str NO-LOCK:
     5365       assign
     5366       buf_cd-plu.charkey_one = "":U
     5367       buf_cd-plu.to-del = no
     5368       .
     5369       delete save-list.
     5370     end.
     5371       return .
     5372   end.
     5373   run waitfram-show in this-procedure ( input "ЖДИТЕ.  Началось изменение справочника.").
     5374   ves-err = 0.
     5375   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5376   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5377     (input  p-curr-obj-type
     5378     ,input  p-curr-obj-code
     5379     ,input  'doc-prt=request'
     5380     ,output v-is-prt
     5381     )  .
     5382   v-empty-code = ?.
     5383   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run emptyscl in g#library
     5385     (output v-empty-code
     5386     )  .
     5387   DO ON error UNDO, return error :
     5388   _TO-GDS:
     5389   FOR EACH bb-list:
     5390     ACCUMULATE bb-list.b-str ( count ).
     5391     if ( accum count bb-list.b-str ) modulo 100 = 0 then do:
     5392       run waitfram-show in this-procedure ( input ("ЖДИТЕ.  Обработано строк списка : " +
     5393                                      string ( accum count bb-list.b-str ) ) ).
     5394     end.
     5395     if v-is-prt = no
     5396     and bb-list.node-code <> v-empty-code  then do:
     5397        ves-err = ves-err + 1.
     5398        next _to-gds.
     5399     end.
     5400     if p-plu-type = 'топ':U then do:
     5401       if bb-list.b-str <> '':U
     5402       and bb-list.loc-ean = no then do:
     5403         find first buf_prod-bc no-lock where
     5404                   buf_prod-bc.b-str = bb-list.b-str
     5405               AND buf_prod-bc.b-code = bb-list.b-code no-error .
     5406         if available buf_prod-bc then do:
     5407   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5408   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     5409     (buffer buf_prod-bc
     5410     ,input  'petrolium=request':U
     5411     ,output v-is-petrol
     5412     ) no-error .
     5413           if error-status:error
     5414           or not v-is-petrol then next _to-gds.
     5415           v-found = no.
     5416           _pl-gds:
     5417           for each buf_pl-gds no-lock where
     5418                 buf_pl-gds.obj-type = p-curr-obj-type
     5419             AND buf_pl-gds.obj-code = p-curr-obj-code
     5420             AND buf_pl-gds.gds-code = bb-list.gds-code
     5421             AND buf_pl-gds.status_ = 'тек':U,
     5422               first buf_place no-lock where
     5423                     buf_Place.obj-type = buf_pl-gds.obj-type
     5424                 and buf_Place.obj-code = buf_pl-gds.obj-code
     5425                 and buf_Place.pl-code = buf_pl-gds.pl-code:
     5426             assign
     5427             v-pl-code = integer(buf_place.loc1) no-error
     5428             .
     5429             if error-status:error then do:
     5430               next _pl-gds.
     5431             end.
     5432             v-found = yes.
     5433             FIND FIRST buf_cd-plu WHERE
     5434                       buf_cd-plu.obj-type = p-curr-obj-type
     5435                   and buf_cd-plu.obj-code = p-curr-obj-code
     5436                   and buf_cd-plu.pos-type = p-pos-type
     5437                   and buf_cd-plu.plu-type = p-plu-type
     5438                   and buf_cd-plu.plu-code = v-pl-code
     5439                   AND buf_cd-plu.b-code = bb-list.b-code
     5440                   AND buf_cd-plu.b-str = bb-list.b-str
     5441                   AND buf_cd-plu.key#_one = buf_pl-gds.pl-code NO-ERROR.
     5442             if available buf_cd-plu then do:
     5443               assign
     5444               buf_cd-plu.charkey_one = "":U
     5445               buf_cd-plu.to-del = no
     5446               .
     5447             end.
     5448             else do:
     5449               if v-skip-next then do:
     5450                 delete bb-list.
     5451               end.
     5452               else do:
     5453                 find first check_cd-plu WHERE
     5454                       check_cd-plu.obj-type = p-curr-obj-type
     5455                   and check_cd-plu.obj-code = p-curr-obj-code
     5456                   and check_cd-plu.pos-type = p-pos-type
     5457                   and check_cd-plu.plu-type = p-plu-type
     5458                   and check_cd-plu.plu-code = buf_cd-plu.plu-code no-error .
     5459                 if available check_cd-plu then do:
     5460                   ves-err = ves-err + 1.
     5461                   next _pl-gds.
     5462                 end.
     5463                 run cd-mrkt_plu-marketer in this-procedure (
     5464                                                               input no
     5465                                                               ,buffer locked_cash-desk
     5466                                                               ,input buf_place.loc1
     5467                                                               ,input bb-list.b-code
     5468                                                               ,input bb-list.b-str
     5469                                                               ,input bb-list.loc-ean
     5470                                                               ,input v-is-petrol
     5471                                                               ,input string(buf_place.pl-code)
     5472                                                               ) no-error.
     5473                 if error-status:error then do:
     5474                   if return-value = "max-gds":U then dO:
     5475                     assign
     5476                     v-skip-next = yes
     5477                     ves-err = ves-err + 1.
     5478                     NEXT _pl-gds.
     5479                   end.
     5480                   else do:
     5481                     ves-err = ves-err + 1.
     5482                     next _pl-GDS.
     5483                   end.
     5484                 end.
     5485                 else do:
     5486                   delete bb-list.
     5487                 end.
     5488               end.
     5489             end.
     5490           end.
     5491           if not v-found then do:
     5492             ves-err = ves-err + 1.
     5493           end.
     5494         end.
     5495       end.
     5496     end.
     5497     else do:
     5498       FIND FIRST buf_cd-plu WHERE
     5499                 buf_cd-plu.obj-type = p-curr-obj-type
     5500             and buf_cd-plu.obj-code = p-curr-obj-code
     5501             and buf_cd-plu.pos-type = p-pos-type
     5502             and buf_cd-plu.plu-type = p-plu-type
     5503             AND buf_cd-plu.b-code = bb-list.b-code
     5504            AND buf_cd-plu.b-str = bb-list.b-str NO-ERROR.
     5505       if available buf_cd-plu then do:
     5506         assign
     5507         buf_cd-plu.charkey_one = "":U
     5508         buf_cd-plu.to-del = no
     5509         .
     5510       end.
     5511       else do:
     5512         if v-skip-next then do:
     5513           delete bb-list.
     5514         end.
     5515         else do:
     5516           v-is-petrol = no.
     5517           CASE p-pos-type:
     5518             when 'MARIA':U then do:
     5519               find first check_cd-plu WHERE
     5520                       check_cd-plu.obj-type = p-curr-obj-type
     5521                   and check_cd-plu.obj-code = p-curr-obj-code
     5522                   and check_cd-plu.pos-type = p-pos-type
     5523                   and check_cd-plu.plu-type = p-plu-type
     5524                   AND check_cd-plu.b-code = bb-list.b-code NO-ERROR.
     5525               if available check_cd-plu then do:
     5526                 ves-err = ves-err + 1.
     5527                 next _to-gds.
     5528               end.
     5529               if  bb-list.b-str <> "":U
     5530               and bb-list.loc-ean = no
     5531               then do:
     5532                 find first buf_prod-bc no-lock where
     5533                           buf_prod-bc.b-str = bb-list.b-str
     5534                       AND buf_prod-bc.b-code = bb-list.b-code no-error .
     5535                 if available buf_prod-bc then do:
     5536   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5537   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     5538     (buffer buf_prod-bc
     5539     ,input  'petrolium=request':U
     5540     ,output v-is-petrol
     5541     ) no-error .
     5542                 end.
     5543               end.
     5544               if v-is-petrol then next _to-gds.
     5545               run cd-mrkt_plu-marketer in this-procedure (
     5546                                                             input no
     5547                                                             ,buffer locked_cash-desk
     5548                                                             ,input '':U
     5549                                                             ,input bb-list.b-code
     5550                                                             ,input bb-list.b-str
     5551                                                             ,input bb-list.loc-ean
     5552                                                             ,input v-is-petrol
     5553                                                             ,input '':U
     5554                                                             ) no-error.
     5555               if error-status:error then do:
     5556                 if return-value = "max-gds":U then dO:
     5557                   assign
     5558                   v-skip-next = yes
     5559                   ves-err = ves-err + 1.
     5560                   NEXT _to-gds.
     5561                 end.
     5562                 else do:
     5563                   ves-err = ves-err + 1.
     5564                   next _TO-GDS.
     5565                 end.
     5566               end.
     5567               else do:
     5568                 delete bb-list.
     5569                end.
     5570             end.
     5571           end CASE.
     5572         end.
     5573       end.
     5574     end.
     5575   END .
     5576   run waitfram-hide in this-procedure .
     5577   _mrktr-GDS:
     5578   FOR EACH buf_cd-plu WHERE
     5579           buf_cd-plu.obj-type = p-curr-obj-type
     5580      and buf_cd-plu.obj-code = p-curr-obj-code
     5581      and buf_cd-plu.pos-type = p-pos-type
     5582      and buf_cd-plu.plu-type = p-plu-type :
     5583     IF buf_cd-plu.to-del = no THEN NEXT _mrktr-gds.
     5584       assign
     5585       buf_cd-plu.to-send = yes
     5586       buf_cd-plu.charkey_two = v-cd-list-update.
     5587   END .
     5588   run cd-mrkt_update-marketer in this-procedure (
     5589                                                   input locked_cash-desk.db-num
     5590                                                   ,input locked_cash-desk.obj-code
     5591                                                   ,input locked_cash-desk.pos-type
     5592                                                   ,input locked_cash-desk.cash-num
     5593                                                   ,input (p-pos-type = 'MARIA':U
     5594                                                          AND p-plu-type = 'топ':U)
     5595                                                 )  .
     5596   END.
     5597   run waitfram-hide in this-procedure .
     5598   RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     5599   run fill-vars in this-procedure .
     5600   run disp-cd in this-procedure .
     5601   if ves-err > 0 then
     5602   message
     5603   SUBSTITUTE("При добавления товаров на кассу встретилось &1 кодов,&2" +
     5604               "для которых не удалось создать запись товара на кассе&2&2" +
     5605               "Эти товары на кассы НЕ ДОБАВЛЕНЫ !!!!"
     5606               , ves-err
     5607               ,chr(10))
     5608   view-as alert-box warning.
     5609   END PROCEDURE.
     5610   PROCEDURE proc-b-print :
     5611   define variable v-doc-rec as recid no-undo .
     5612   define variable accum-count as integer.
     5613   define variable date_string     as      CHARACTER    no-undo.
     5614   define variable Line            as      CHARACTER    no-undo.
     5615   define variable for-time        as      CHARACTER    no-undo.
     5616   define variable v-prod-name     as      character    no-undo .
     5617   define variable v-prod-type-code as      character    no-undo .
     5618   define variable v-imp-date as date no-undo .
     5619   define variable v-imp-user as character no-undo .
     5620   define buffer buf_c-cd-plu for ub.c-cd-plu.
     5621   DEFINE FRAME cd-plu-list
     5622   X_cd-plu.plu-code COLUMN-LABEL "PLU" FORMAT "9999":U
     5623   X_cd-plu.b-str COLUMN-LABEL "ДопБК/лок.ЕАН" FORMAT "X(18)":U
     5624   X_cd-plu.b-code COLUMN-LABEL "Бар-код!IBS TH" FORMAT "999999999":U
     5625   X_cd-plu.to-del COLUMN-LABEL "У" FORMAT "У/":U
     5626   X_cd-plu.to-send COLUMN-LABEL "И" FORMAT "И/":U
     5627   X_goods.gds-name FORMAT "X(30)":U
     5628   X_goods.artic FORMAT "X(16)":U
     5629   v-prod-name  COLUMN-LABEL "Назв. произв-ля" FORMAT "X(25)":U
     5630   v-prod-type-code  COLUMN-LABEL "Пр-ль" FORMAT "X(12)":U
     5631   v-imp-date COLUMn-LABEL "В списке с" format "99/99/9999"
     5632   for-time no-label format "X(5)"
     5633   v-imp-user COLUMn-LABEL "Оператор" format "X(20)"
     5634   HEADER  date_string AT 5 format "X(35)"
     5635    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5636   Line format "X(195)" AT 1
     5637   with width 232 down stream-io use-text    .
     5638   Line = fill("-", 195).
     5639   date_string = cur-time-print() .
     5640   run prn-lib-open-stream  in this-procedure (
     5641                                                input parParentProc
     5642                                               ,input 43
     5643                                               ,input yes
     5644                                               ,input no
     5645                                               ).
     5646   PUT  STREAM PrnLibStream
     5647   SPACE(25) ( frame Dialog-Frame:title )
     5648   format "x(90)" SKIP(1) .
     5649   FORM HEADER
     5650   Line format "X(195)" AT 1 SKIP
     5651   "Продолжение - на следующей странице" AT 30 SKIP
     5652   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5653   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5654   FORM with FRAME cd-plu-list  .
     5655   run waitfram-show in this-procedure ( input "Ждите...").
     5656   v-doc-rec = recid(X_cd-plu).
     5657   DO WHILE available X_cd-plu :
     5658     GET prev br-mgds.
     5659   END.
     5660   GET next br-mgds.
     5661   DO WHILE available X_cd-plu :
     5662     ASSIGN
     5663     v-prod-name = get-prod-name(buffer X_goods)
     5664     v-prod-type-code = X_goods.prod-type + string(X_goods.prod-code)
     5665     .
     5666     find last buf_c-cd-plu no-lock where
     5667             buf_c-cd-plu.obj-type = X_cd-plu.obj-type
     5668         and buf_c-cd-plu.obj-code = X_cd-plu.obj-code
     5669         and buf_c-cd-plu.pos-type = X_cd-plu.pos-type
     5670         and buf_c-cd-plu.plu-type = X_cd-plu.plu-type
     5671         and buf_c-cd-plu.plu-code = X_cd-plu.plu-code
     5672         and buf_c-cd-plu.corr-user-db-num = v-obj-db-num
     5673         and buf_c-cd-plu.action = integer('1':U) no-error.
     5674     if available buf_c-cd-plu then do:
     5675       assign
     5676       v-imp-date = buf_c-cd-plu.corr-date
     5677       for-time = string(buf_c-cd-plu.corr-time, "hh:mm:ss")
     5678       v-imp-user = buf_c-cd-plu.corr-user-name
     5679       .
     5680     end.
     5681     else do:
     5682       assign
     5683       v-imp-date = ?
     5684       for-time = chr(63)
     5685       v-imp-user = chr(63)
     5686       .
     5687     end.
     5688     Display STREAM PrnLibStream
     5689     X_cd-plu.plu-code
     5690     X_cd-plu.b-str
     5691     X_cd-plu.b-code
     5692     X_cd-plu.to-del
     5693     X_cd-plu.to-send
     5694     X_goods.gds-name
     5695     X_goods.artic
     5696     get-prod-name(buffer X_goods) @ v-prod-name
     5697     v-prod-type-code
     5698     v-imp-date
     5699     for-time
     5700     v-imp-user
     5701     with FRAME cd-plu-list .
     5702     DOWN STREAM PrnLibStream 1
     5703     with FRAME cd-plu-list  .
     5704     assign
     5705     accum-count = accum-count + 1
     5706     .
     5707     GET next br-mgds.
     5708   END.
     5709   UNDERLINE  STREAM PrnLibStream
     5710   X_cd-plu.plu-code
     5711   X_cd-plu.b-str
     5712   X_cd-plu.b-code
     5713   X_cd-plu.to-del
     5714   X_cd-plu.to-send
     5715   X_goods.gds-name
     5716   X_goods.artic
     5717   v-prod-name
     5718   v-prod-type-code
     5719   v-imp-date
     5720   for-time
     5721   v-imp-user
     5722   with FRAME cd-plu-list .
     5723   DISPLAY STREAM PrnLibStream
     5724   "ИТОГО" @ X_cd-plu.plu-code
     5725   accum-count @ X_cd-plu.b-str
     5726   with frame cd-plu-list.
     5727   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5728   HIDE  STREAM PrnLibStream FRAME cd-plu-List.
     5729   output  STREAM PrnLibStream CLOSE.
     5730   REPOSITION br-mgds to recid v-doc-rec no-error.
     5731   APPLY "entry" to br-mgds.
     5732   run waitfram-hide in this-procedure .
     5733   run prn-lib-prn-file in this-procedure (
     5734                                             input parParentProc
     5735                                             ,input 8
     5736                                             ).
     5737   END PROCEDURE.
     5738   PROCEDURE proc-b-sch :
     5739   assign
     5740     tbl = 'cd-plu'
     5741     join-tbl = 'X_cd-plu'
     5742     fld = ""
     5743     lab = ""
     5744     spr = ""
     5745     dim = '0'
     5746     .
     5747   run fltfield-add in this-procedure('plu-code', 'PLU', '',
     5748   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5749   run fltfield-add in this-procedure('b-code', 'Бар-код TH IBS', '',
     5750   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5751   run fltfield-add in this-procedure('b-str', 'ДопБК или лок.EAN', '',
     5752   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5753   run fltfield-add in this-procedure('to-del', 'Статус удаления', '',
     5754   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5755   run fltfield-add in this-procedure('to-send', 'Статус изменения', '',
     5756   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5757   Filter-Block:
     5758   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5759       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5760       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5761     run gbl/filter.w ( INPUT parparentproc
     5762                       , INPUT (filter-point + chr(4) +
     5763                           filter-label  + chr(4) +
     5764                           string(yes))
     5765                       , INPUT tbl
     5766                       , INPUT join-tbl
     5767                       , INPUT fld
     5768                       , INPUT lab
     5769                       , INPUT spr
     5770                       , INPUT dim ).
     5771     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5772   END.
     5773   END PROCEDURE.
     5774   PROCEDURE proc-find-b-str :
     5775   define input parameter p-a-n-c as character no-undo.
     5776   define input parameter p-next as logical no-undo.
     5777   define input parameter p-b-str AS character no-undo.
     5778   assign
     5779   p-b-str = replace(p-b-str, chr(34), "":U)
     5780   p-b-str = replace(p-b-str, chr(39), chr(39) + chr(39))
     5781   p-b-str = chr(34) + p-b-str + chr(34)
     5782   .
     5783   run OpenBr in this-procedure
     5784   (input false
     5785   ,input p-next
     5786   ,input substitute("and X_cd-plu.b-str = &1 "
     5787     , p-b-str)
     5788   ).
     5789   apply "entry":u to loc-code in frame Dialog-Frame .
     5790   END PROCEDURE.
     5791   PROCEDURE proc-find-code :
     5792   define input parameter p-a-n-c as character no-undo.
     5793   define input parameter p-next as logical no-undo.
     5794   define input parameter p-code AS integer no-undo.
     5795   IF input frame Dialog-Frame a-n-c = "b-code":U THEN DO:
     5796       run OpenBr in this-procedure
     5797           (input false
     5798           ,input p-next
     5799           ,input substitute("and X_cd-plu.b-code = &1 "
     5800             , p-code)
     5801           ).
     5802   END.
     5803   IF input frame Dialog-Frame a-n-c = "plu":U THEN DO:
     5804       run OpenBr in this-procedure
     5805       (input false
     5806       ,input p-next
     5807       ,input substitute("and X_cd-plu.plu-code = &1 "
     5808         , p-code)
     5809       ).
     5810   END.
     5811   apply "entry":u to loc-code in frame Dialog-Frame .
     5812   END PROCEDURE.
     5813   PROCEDURE RUN-BB-LIST :
     5814   DO
     5815   ON ERROR UNDO, RETURN ERROR
     5816   ON STOP UNDO, RETURN ERROR:
     5817     run str/bb-list.w (
     5818                   INPUT parparentproc
     5819                   ,INPUT p-curr-obj-type
     5820                   ,INPUT p-curr-obj-code
     5821                   ,input 'MARIA':U
     5822                   ).
     5823   END.
     5824   END PROCEDURE.
     5825   FUNCTION get-prod-name RETURNS CHARACTER
     5826     ( BUFFER buf_goods FOR goods ) :
     5827   DEFINE BUFFER buf_clients FOR ub.clients.
     5828   FIND FIRST buf_clients NO-LOCK WHERE
     5829             buf_Clients.obj-type = buf_goods.prod-type
     5830        AND  buf_Clients.obj-code = buf_goods.prod-code NO-ERROR.
     5831     IF NOT AVAILABLE buf_Clients  THEN RETURN "!!!Неизвестный произ-ль".
     5832     RETURN buf_clients.obj-name.
     5833   END FUNCTION.
