      828   procedure prn-lib-reportviewer :
      829     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      830     define input parameter p-report-name-html as character no-undo .
      831     define input parameter p-param        as character no-undo .
      832     define variable v-excel           as character no-undo init 'TRUE' .
      833     define variable v-value-character as character no-undo .
      834     define variable v-value-integer   as character no-undo .
      835     define variable v-value-date      as date      no-undo .
      836     define variable v-value-decimal   as decimal   no-undo .
      837     define variable rep-excel         as logical   no-undo .
      838     define variable excel-string      as character no-undo .
      839     define variable v-param-type      as character no-undo .
      840     define variable v-tth             as handle    no-undo .
      841     run adm/shattri.p (
      842       input "get":U
      843       ,input  ""
      844       ,input  0
      845       ,input  'report-glob':U
      846       ,input  'rep-excel':U
      847       ,output v-value-character
      848       ,output v-value-date
      849       ,output v-value-decimal
      850       ,output v-value-integer
      851       ,output rep-excel
      852       ,output v-param-type
      853       ,INPUT-OUTPUT table-handle v-tth
      854       )  .
      855     if rep-excel then v-excel = "TRUE" .
      856     else v-excel = "FALSE" .
      857     if p-param eq ""
      858     then
      859        p-param = "EXCEL:" + v-excel.
      860     else
      861        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      862     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      863   end procedure.
