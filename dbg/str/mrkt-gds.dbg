      403   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      404   define variable c-point  as character no-undo .
      405   define variable tbl      as character no-undo .
      406   define variable join-tbl as character no-undo .
      407   define variable fld      as character no-undo .
      408   define variable lab      as character no-undo .
      409   define variable spr      as character no-undo .
