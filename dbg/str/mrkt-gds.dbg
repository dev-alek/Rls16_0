      641   procedure fltfield-clear :
      642     define output parameter loc-fld as character no-undo.
      643     define output parameter loc-lab as character no-undo .
      644     define output parameter loc-spr as character no-undo .
      645     define output parameter loc-dim as character no-undo .
      646     assign
      647       loc-fld = ""
      648       loc-lab = ""
      649       loc-spr = ""
      650       loc-dim = "0"
      651     .
      652   end procedure .
      653   procedure fltfield-add :
      654     define input        parameter par-fld as character no-undo.
      655     define input        parameter par-lab as character no-undo .
      656     define input        parameter par-spr as character no-undo .
      657     define input-output parameter loc-fld as character no-undo.
      658     define input-output parameter loc-lab as character no-undo .
      659     define input-output parameter loc-spr as character no-undo .
      660     define input-output parameter loc-dim as character no-undo .
      661     do
      662     on error undo, return error
      663     :
      664       assign
      665       loc-fld = if loc-dim = '0'
      666                 then par-fld
      667                 else (loc-fld + chr(44) + par-fld)
      668       loc-lab = if loc-dim = '0'
      669                 then par-lab
      670                 else (loc-lab + chr(44) + par-lab)
      671       loc-spr = if loc-dim = '0'
      672                 then par-spr
      673                 else (loc-spr + chr(44) + par-spr)
      674       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      675                 string(integer(if num-entries(loc-dim) > 1
      676                               then entry(2, loc-dim)
      677                               else entry(1, loc-dim)
      678                               ) + 1)
      679       no-error
      680       .
      681     end.
      682   end procedure.
      683   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      684   define  stream PrnLibStream.
      685   procedure prn-lib-prn-file :
      686     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      687     define input parameter p-DIsabledoptions as integer no-undo .
      688     define variable v-report-name as character no-undo .
      689     define variable v-user-action as character no-undo .
      690     define variable v-printed     as logical   no-undo .
      691     define variable v-exist       as logical   no-undo .
      692     do
      693       on error undo, return error
      694       :
      695       run prn-lib-get-report-name  in this-procedure (
      696         input parParentProc
      697         ,output v-report-name
      698         ).
      699   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      700   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      701     (input  v-report-name
      702     ,input  2
      703     ,output v-exist
      704     )  .
      705       if NOT v-exist then
      706       DO:
      707         Message
      708           "Нет заданий на печать ! "
      709           view-as alert-box .
      710         Return  .
      711       End.
      712       run gbl/prnfilen.w
      713         (input  ""
      714         ,input  p-DisabledOptions
      715         ,input  string(v-report-name )
      716         ,input  7
      717         ,output v-user-action
      718         ,output v-printed
      719         ) .
      720       if v-printed then
      721       do:
      722         return "YES" .
      723       end.
      724       else
      725       do:
      726         return "NO" .
      727       end.
      728     end.
      729   end procedure.
      730   procedure prn-lib-open-stream :
      731     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      732     define input parameter p-page-size    as integer no-undo .
      733     define input parameter p-is-stream    as logical no-undo .
      734     define input parameter p-append       as logical no-undo .
      735     define variable v-report-name as character no-undo .
      736     do
      737       on error undo, return error
      738       :
      739       run prn-lib-get-report-name  in this-procedure (
      740         input parParentProc
      741         ,output v-report-name
      742         ).
      743       if p-is-stream then
      744       do:
      745         if p-append then
      746         do:
      747           output stream PrnLibStream to value( v-report-name )
      748             page-size value(p-page-size) append .
      749         end.
      750         if not p-append then
      751         do:
      752           output stream PrnLibStream to value( v-report-name )
      753             page-size value(p-page-size) .
      754         end.
      755       end.
      756       if not p-is-stream then
      757       do:
      758         if p-append then
      759         do:
      760           output to value( v-report-name )
      761             page-size value(p-page-size) append .
      762         end.
      763         if not p-append then
      764         do:
      765           output to value( v-report-name )
      766             page-size value(p-page-size) .
      767         end.
      768       end.
      769     end.
      770   end procedure.
      771   procedure prn-lib-open-exp :
      772     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      773     define input parameter p-is-stream    as logical no-undo .
      774     define input parameter p-is-append    as logical no-undo .
      775     define output parameter p-ReportFileName as char init "report" no-undo.
      776     define output parameter p-process as logical no-undo .
      777     define variable glog as logical no-undo .
      778     do
      779       on error undo, return error
      780       :
      781       SYSTEM-DIALOG GET-FILE p-ReportFileName
      782         TITLE      "Укажите путь"
      783         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      784         ASK-OVERWRITE
      785         CREATE-TEST-FILE
      786         SAVE-AS
      787         USE-FILENAME
      788         DEFAULT-EXTENSION "txt"
      789         UPDATE glog
      790         .
      791       if not glog then  return.
      792       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      793       if p-is-stream then
      794       do:
      795         if p-is-append then
      796         do:
      797           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      798         end.
      799         else
      800         do:
      801           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      802         end.
      803       end.
      804       else
      805       do:
      806         if p-is-append then
      807         do:
      808           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      809         end.
      810         else
      811         do:
      812           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      813         end.
      814       end.
      815       p-process = yes.
      816     end.
      817   end procedure.
      818   procedure prn-lib-get-report-name :
      819     define input parameter parParentProc  as widget-handle no-undo.
      820     define output parameter p-report-name as character no-undo .
      821     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      822   end procedure.
      823   procedure prn-lib-reportviewer-report-name :
      824     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      825     define input parameter p-report-name-html as character no-undo .
