      411   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      412   procedure cur-time :
      413      define output parameter p-today as date      no-undo .
      414      define output parameter p-time  as integer   no-undo .
      415     do
      416     on error undo, return error
      417     :
      418       define variable v-date1 as date      no-undo .
      419       define variable v-date2 as date      no-undo .
      420       define variable v-time  as integer   no-undo .
      421       assign
      422         v-date1 = today
      423         v-time  = time
      424         v-date2 = today
      425       .
      426       if v-date1 <> v-date2
      427       then do:
      428         assign
      429           v-date1 = today
      430           v-time  = v-time
      431         .
      432       end.
      433       assign
      434         p-today = v-date1
      435         p-time  = v-time
      436       .
      437     end.
      438   end.
      439   function cur-time-date returns character
      440   :
      441     return string(today, '99/99/9999':U) .
      442   end.
      443   function cur-time-mjd returns decimal
      444   :
      445     define variable v-date as date      no-undo .
      446     define variable v-time as integer   no-undo .
      447     run cur-time in this-procedure
      448       (output v-date
      449       ,output v-time
      450       ) .
      451     return integer(v-date) - 2400002 + (v-time / 86400) .
      452   end.
      453   function cur-time-get-ending-index returns integer
      454   (input p-number as integer
      455   )
      456   :
      457     if p-number < 0
      458     or p-number = ?
      459     then do:
      460       return 1 .
      461     end.
      462     define variable v-rest as integer   no-undo .
      463     assign
      464       p-number = p-number modulo 100
      465     .
      466     if p-number < 20
      467     then do:
      468       assign
      469         v-rest = p-number
      470       .
      471     end.
      472     else do:
      473       assign
      474         v-rest = p-number modulo 10
      475       .
      476     end.
      477     case v-rest :
      478       when 1
      479       then do:
      480         return 2 .
      481       end.
      482       when 2 or
      483       when 3 or
      484       when 4
      485       then do:
      486         return 3 .
      487       end.
      488       otherwise do:
      489         return 1 .
      490       end.
      491     end case .
      492   end.
      493   procedure cur-time-mjd-to-date :
      494      define input  parameter i-mjd-diff as decimal no-undo.
      495      define output parameter o-Date     as date    no-undo.
      496      define output parameter o-Time     as integer no-undo.
      497      define variable v-day-number as integer   no-undo .
      498      if    i-mjd-diff < 0
      499         or i-mjd-diff = ?
      500      then do:
      501         return "?" .
      502      end.
      503      assign
      504         v-day-number = truncate(i-mjd-diff,0).
      505         o-Date = date(v-day-number + 2400002).
      506         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      507     .
      508   end.
      509   function cur-time-mjd-to-string returns character
      510   (input p-mjd-diff as decimal
      511   )
      512   :
      513     define variable v-day-number as integer   no-undo .
      514     define variable v-seconds    as integer   no-undo .
      515     define variable v-hour       as integer   no-undo .
      516     define variable v-min        as integer   no-undo .
      517     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      518     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      519     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      520     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      521     if p-mjd-diff < 0
      522     or p-mjd-diff = ?
      523     then do:
      524       return "?" .
      525     end.
      526     assign
      527       v-day-number = integer(truncate(p-mjd-diff,0))
      528       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      529     .
      530     if v-seconds > 86400
      531     then do:
      532       assign
      533         v-seconds = 86400 - 1
      534       .
      535     end.
      536     if v-seconds < 0
      537     then do:
      538       assign
      539         v-seconds = 0
      540       .
      541     end.
      542     assign
      543       v-hour = truncate(v-seconds / 3600, 0)
      544     .
      545     assign
      546       v-seconds = v-seconds modulo 3600
      547     .
      548     assign
      549       v-min = truncate(v-seconds / 60, 0)
      550     .
      551     assign
      552       v-seconds = v-seconds modulo 60
      553     .
      554     return
      555         (if v-day-number <> 0
      556           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      557           else ""
      558         )
      559       + (if v-day-number <> 0 or v-hour <> 0
      560           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      561           else ""
      562         )
      563       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      564           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      565           else ""
      566         )
      567       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      568       .
      569   end.
      570   function cur-time-string returns character
      571   :
      572     define variable v-date as date      no-undo .
      573     define variable v-time as integer   no-undo .
      574     run cur-time in this-procedure
      575       (output v-date
      576       ,output v-time
      577       ) .
      578     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      579   end.
      580   function cur-time-string-sec returns character
      581   :
      582     define variable v-date as date      no-undo .
      583     define variable v-time as integer   no-undo .
      584     run cur-time in this-procedure
      585       (output v-date
      586       ,output v-time
      587       ) .
      588     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      589   end.
      590   function cur-time-custom  returns character
      591   (input p-prefix as character
      592   ,input p-date-format as character
      593   ,input p-delimiter as character
      594   ,input p-time-format as character
      595   ,input p-suffix as character
      596   )
      597   :
      598     define variable v-date as date      no-undo .
      599     define variable v-time as integer   no-undo .
      600     run cur-time in this-procedure
      601       (output v-date
      602       ,output v-time
      603       ) .
      604     return
      605       p-prefix
      606       + string(v-date, p-date-format)
      607       + p-delimiter
      608       + string(v-time, p-time-format)
      609       + p-suffix
      610       .
      611   end.
      612   function cur-time-print  returns character
      613   :
      614     define variable v-date as date      no-undo .
      615     define variable v-time as integer   no-undo .
      616     run cur-time in this-procedure
      617       (output v-date
      618       ,output v-time
      619       ) .
      620     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      621   end.
      622   function cur-time-datetime returns datetime
      623   :
      624     define variable v-char as character no-undo .
      625     define variable v-datetime as datetime no-undo .
      626     v-char = cur-time-string().
      627     v-datetime = datetime(v-char).
      628     return  v-datetime.
      629   end.
      630   function cur-time-string-msec returns character
      631   :
      632     define variable v-date as datetime  no-undo .
      633     v-date = now.
      634     return string(v-date) .
      635   end.
