        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo.
        3   define input parameter p-rowid       as rowid         no-undo .
        4   define input parameter p-silent      as logical       no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: chkelcnt.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: str/chkelcnt.p $":U .
       10   define variable vss-description as character no-undo init "Проверка показаний электронного и механических счетчиков сверки".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       74   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
       75   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
       76   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
       77   define variable ptrlprop-autopump      as logical   no-undo initial false .
       78   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
       79   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
       80   define variable ptrlprop-olddens       as logical   no-undo initial false .
       81   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
       82   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
       83   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
       84   define variable ptrlprop-algoincome as integer no-undo init 0.
       85   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
       86   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
       87   define variable ptrlprop-Delta-mass-vert       as character no-undo .
       88   define variable ptrlprop-calc-free-vol as logical no-undo init false.
       89   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
       90   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
       91   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
       92   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
       93   define variable ptrlprop-block-nozzle as logical no-undo init false.
       94   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
       95   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
       96   procedure get-ptrl-prop :
       97     define input  parameter p-obj-type as character no-undo .
       98     define input  parameter p-obj-code as integer   no-undo .
       99     do
      100     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      101     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      102     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      103     :
      104       define variable par-type          as character no-undo.
      105       define variable v-value-character as character no-undo .
      106       define variable v-value-date      as date      no-undo .
      107       define variable v-value-decimal   as decimal   no-undo .
      108       define variable v-value-integer   as integer   no-undo .
      109       define variable v-value-logical   as logical   no-undo .
      110       for each thbjattr_thbj-attr
      111       :
      112         delete thbjattr_thbj-attr .
      113       end.
      114       run adm/shattri.p
      115         ( input "get":U
      116         , input p-obj-type
      117         , input p-obj-code
      118         , input 'petrol':U
      119         , input  ""
      120         , output v-value-character
      121         , output v-value-date
      122         , output v-value-decimal
      123         , output v-value-integer
      124         , output v-value-logical
      125         , output par-type
      126         , input-output table thbjattr_thbj-attr
      127         ) no-error .
      128       for each thbjattr_thbj-attr
      129       on error undo, return error return-value
      130       :
      131         case thbjattr_thbj-attr.prop-code :
      132           when 'denstclc':U then do:
      133             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      134               assign
      135                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      136               .
      137             end.
      138           end.
      139           when 'expptrl':U then do:
      140             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      141               and thbjattr_thbj-attr.prop-value-type = 'character':U
      142             then do:
      143               assign
      144                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      145               .
      146             end.
      147           end.
      148           when 'inpptrl':U then do:
      149             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      150               and thbjattr_thbj-attr.prop-value-type = 'character':U
      151             then do:
      152               assign
      153                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      154               .
      155             end.
      156           end.
      157           when 'autopump':U then do:
      158             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      159               assign
      160                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      161               .
      162             end.
      163           end.
      164           when 'rvsnmter':U then do:
      165             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      166               assign
      167                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      168               .
      169             end.
      170           end.
      171           when 'avtinvpm':U then do:
      172             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      173               assign
      174                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      175               .
      176             end.
      177           end.
      178           when 'invclipt':U then do:
      179             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      180               assign
      181                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      182               .
      183             end.
      184           end.
      185           when 'olddens':U then do:
      186             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      187               assign
      188                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      189               .
      190             end.
      191           end.
      192           when 'algrvspt':U then do:
      193             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      194               assign
      195                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      196               .
      197             end.
      198           end.
      199           when 'temp-for-pomi':U then do:
      200             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      201               assign
      202                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      203               .
      204             end.
      205           end.
      206           when 'algoincome':U then do:
      207             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      208               assign
      209                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      210               .
      211             end.
      212           end.
      213           when 'mand-choice-autocar':U then do:
      214             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      215               assign
      216                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      217               .
      218             end.
      219           end.
      220           when 'block-nozzle':U then do:
      221             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      222               assign
      223                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      224               .
      225             end.
      226           end.
      227           when 'timeout-block-nozzle':U then do:
      228             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      229               assign
      230                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      231               .
      232             end.
      233           end.
      234           when 'Delta-mass-horiz':U then do:
      235             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      236               assign
      237                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      238               .
      239             end.
      240           end.
      241           when 'Delta-mass-vert':U then do:
      242             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      243               assign
      244                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      245               .
      246             end.
      247           end.
      248           when 'calc-free-vol':U then do:
      249             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      250               assign
      251                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
      252               .
      253             end.
      254           end.
      255           when 'calc-free-vol-sug':U then do:
      256             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      257               assign
      258                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
      259               .
      260             end.
      261           end.
      262           when 'trn-reas-sug':U then do:
      263             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      264               assign
      265                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
      266               .
      267             end.
      268           end.
      269                 when 'rvd-own-nb':U then do:
      270             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      271               assign
      272                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
      273               .
      274             end.
      275           end.
      276           when 'qr-scan-time':U then do:
      277             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      278               assign
      279                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
      280               .
      281             end.
      282           end.
      283           when 'autopump-skip-time':U then do:
      284             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      285               assign
      286                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
      287               .
      288             end.
      289           end.
      290         end case.
      291         delete thbjattr_thbj-attr .
      292       end.
      293     end.
      294     return .
      295   end procedure.
      296   _main-block:
      297   do
      298   on error  undo _main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      299   on stop   undo _main-block, return error substitute( "&1. stop", vss-workfile )
      300   on endkey undo _main-block, return error substitute( "&1. endkey", vss-workfile )
      301   :
      302     define buffer buf_rvs-doc         for ub.rvs-doc.
      303     define buffer prev_rvs-doc        for ub.rvs-doc.
      304     define buffer buf_rvs-line-pump   for ub.rvs-line-pump.
      305     define buffer prev_rvs-line-pump  for ub.rvs-line-pump.
      306     define variable v-is-overflow   as logical    no-undo .
      307     define variable v-log           as logical    no-undo .
      308     find first buf_rvs-doc no-lock
      309       where rowid(buf_rvs-doc) = p-rowid
      310       no-error .
      311     if not available buf_rvs-doc then do:
      312       undo _main-block, return error "Не найдена сверка для проверки показаний счетчиков.":U.
      313     end.
      314     if buf_rvs-doc.rvs-type <> 'смена':U then do:
      315       return.
      316     end.
      317   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      318   run get-ptrl-prop in this-procedure
      319     ( input buf_rvs-doc.obj-type
      320     , input buf_rvs-doc.obj-code
      321     ) .
      322     if ptrlprop-avtinvpm <> true then do:
      323       return .
      324     end.
      325     find first prev_rvs-doc no-lock
      326       where prev_rvs-doc.obj-type = buf_rvs-doc.obj-type
      327         and prev_rvs-doc.obj-code = buf_rvs-doc.obj-code
      328         and prev_rvs-doc.status_  = 'факт':U
      329         and prev_rvs-doc.rvs-type = 'смена':U
      330     no-error .
      331     if not available prev_rvs-doc then do:
      332       return.
      333     end.
      334     _rvs-line-pump :
      335     for each buf_rvs-line-pump no-lock
      336       where buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
      337     on error  undo _main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      338     on stop   undo _main-block, return error substitute( "&1. stop", vss-workfile )
      339     on endkey undo _main-block, return error substitute( "&1. endkey", vss-workfile )
      340     :
      341       find first prev_rvs-line-pump no-lock
      342         where prev_rvs-line-pump.rvs-code     = prev_rvs-doc.rvs-code
      343           and prev_rvs-line-pump.obj-type     = prev_rvs-doc.obj-type
      344           and prev_rvs-line-pump.obj-code     = prev_rvs-doc.obj-code
      345           and prev_rvs-line-pump.pl-code      = buf_rvs-line-pump.pl-code
      346           and prev_rvs-line-pump.gds-code     = buf_rvs-line-pump.gds-code
      347           and prev_rvs-line-pump.pump-code    = buf_rvs-line-pump.pump-code
      348           and prev_rvs-line-pump.nozzle-code  = buf_rvs-line-pump.nozzle-code
      349       no-error .
      350       if available prev_rvs-line-pump then do:
      351         if buf_rvs-line-pump.state-el-cnt < prev_rvs-line-pump.state-el-cnt then do:
      352           assign
      353             v-is-overflow  = yes
      354           .
      355           leave _rvs-line-pump.
      356         end.
      357       end.
      358     end.
      359     if v-is-overflow = yes then do:
      360       if p-silent = no then do:
      361         message
      362           "ВНИМАНИЕ!" skip
      363           "Показания механического счетчика по сверке на конец смены МЕНЬШЕ, чем показания на начало смены." skip
      364           "Необходимо провести инвентаризацию счетчиков ТРК." skip
      365           "Сделать это автоматически?":U
      366         view-as alert-box question buttons yes-no update v-log.
      367         if v-log <> yes then do:
      368           undo _main-block, return error "Необходимо создать автоматический документ инвентаризации счетчиков ТРК":U .
      369         end.
      370       end.
      371       run str/icntauto.p
      372         ( input parparentproc
      373          ,input p-rowid
      374         ) no-error .
      375       if error-status :error then do:
      376         undo _main-block, return error return-value .
      377       end.
      378       for each buf_rvs-line-pump no-lock
      379         where buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
      380       on error  undo _main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      381       on stop   undo _main-block, return error substitute( "&1. stop", vss-workfile )
      382       on endkey undo _main-block, return error substitute( "&1. endkey", vss-workfile )
      383       :
      384         find first prev_rvs-line-pump no-lock
      385           where prev_rvs-line-pump.rvs-code     = prev_rvs-doc.rvs-code
      386             and prev_rvs-line-pump.obj-type     = prev_rvs-doc.obj-type
      387             and prev_rvs-line-pump.obj-code     = prev_rvs-doc.obj-code
      388             and prev_rvs-line-pump.pl-code      = buf_rvs-line-pump.pl-code
      389             and prev_rvs-line-pump.gds-code     = buf_rvs-line-pump.gds-code
      390             and prev_rvs-line-pump.pump-code    = buf_rvs-line-pump.pump-code
      391             and prev_rvs-line-pump.nozzle-code  = buf_rvs-line-pump.nozzle-code
      392           no-error .
      393         if available prev_rvs-line-pump then do:
      394           if buf_rvs-line-pump.state-mh-cnt < prev_rvs-line-pump.state-mh-cnt then do:
      395             undo _main-block, return error substitute( "Показания механического счетчика ТРК &1 пистолет &2 на конец смены меньше чем на начало.&3"
      396                                                        + "Невозможно закрыть сверку"
      397                                                       , prev_rvs-line-pump.pump-code
      398                                                       , prev_rvs-line-pump.nozzle-code
      399                                                       , chr(10)
      400                                                       ).
      401           end.
      402         end.
      403       end.
      404     end.
      405   end.
