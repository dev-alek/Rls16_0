     1277   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1278   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
     1279   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
     1280   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
