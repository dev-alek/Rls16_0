     2905   procedure add-msg :
     2906     define input parameter p-err as logical   no-undo .
     2907     define input parameter p-msg as character no-undo .
     2908     do
     2909     on error  undo, return error substitute( "&1 (add-msg). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2910     on stop   undo, return error substitute( "&1 (add-msg). stop", vss-workfile )
     2911     on endkey undo, return error substitute( "&1 (add-msg). endkey", vss-workfile )
     2912     :
     2913       if v-ret-msg <> "":U then do:
     2914         assign
     2915           v-ret-msg = v-ret-msg + chr(10)
     2916         .
     2917       end.
     2918       if p-err = true then do:
     2919         assign
     2920           v-ret-msg = v-ret-msg + substitute( "ОШИБКА! &2", p-msg )
     2921         .
     2922       end.
     2923       assign
     2924         v-ret-msg = v-ret-msg + p-msg
     2925       .
     2926     end.
     2927   end procedure.
