     1459           when 'calc-free-vol-sug':U then do:
     1460             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1461               assign
     1462                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
     1463               .
     1464             end.
     1465           end.
     1466           when 'trn-reas-sug':U then do:
     1467             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1468               assign
     1469                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
     1470               .
     1471             end.
     1472           end.
     1473                 when 'rvd-own-nb':U then do:
     1474             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1475               assign
     1476                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
     1477               .
     1478             end.
     1479           end.
     1480           when 'qr-scan-time':U then do:
     1481             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1482               assign
