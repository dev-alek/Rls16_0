     1259   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1260   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1261   define input parameter  p-value    like ub.place-attr.attr-value .
     1262   define output parameter p-ok       as logical.
     1263   define buffer buf_place-attr for ub.place-attr .
     1264     do on error undo, return error return-value :
     1265        p-ok = false.
     1266        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1267                                                   and buf_place-attr.obj-code    = p-obj-code
     1268                                                   and buf_place-attr.obj-type    = p-obj-type
     1269                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1270        if available buf_place-attr then do :
