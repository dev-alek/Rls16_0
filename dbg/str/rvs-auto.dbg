     1300   procedure get-ptrl-prop :
     1301     define input  parameter p-obj-type as character no-undo .
     1302     define input  parameter p-obj-code as integer   no-undo .
     1303     do
     1304     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1305     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     1306     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     1307     :
     1308       define variable par-type          as character no-undo.
     1309       define variable v-value-character as character no-undo .
     1310       define variable v-value-date      as date      no-undo .
     1311       define variable v-value-decimal   as decimal   no-undo .
     1312       define variable v-value-integer   as integer   no-undo .
     1313       define variable v-value-logical   as logical   no-undo .
     1314       for each thbjattr_thbj-attr
     1315       :
     1316         delete thbjattr_thbj-attr .
     1317       end.
     1318       run adm/shattri.p
     1319         ( input "get":U
     1320         , input p-obj-type
     1321         , input p-obj-code
     1322         , input 'petrol':U
     1323         , input  ""
     1324         , output v-value-character
     1325         , output v-value-date
     1326         , output v-value-decimal
     1327         , output v-value-integer
     1328         , output v-value-logical
     1329         , output par-type
     1330         , input-output table thbjattr_thbj-attr
     1331         ) no-error .
     1332       for each thbjattr_thbj-attr
     1333       on error undo, return error return-value
     1334       :
     1335         case thbjattr_thbj-attr.prop-code :
     1336           when 'denstclc':U then do:
     1337             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1338               assign
     1339                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
     1340               .
     1341             end.
     1342           end.
     1343           when 'expptrl':U then do:
     1344             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1345               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1346             then do:
     1347               assign
     1348                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
     1349               .
     1350             end.
     1351           end.
     1352           when 'inpptrl':U then do:
     1353             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1354               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1355             then do:
     1356               assign
     1357                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
     1358               .
     1359             end.
     1360           end.
     1361           when 'autopump':U then do:
     1362             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1363               assign
     1364                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
     1365               .
     1366             end.
     1367           end.
     1368           when 'rvsnmter':U then do:
     1369             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1370               assign
     1371                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
     1372               .
     1373             end.
     1374           end.
     1375           when 'avtinvpm':U then do:
     1376             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1377               assign
     1378                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
     1379               .
     1380             end.
     1381           end.
     1382           when 'invclipt':U then do:
     1383             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1384               assign
     1385                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
     1386               .
     1387             end.
     1388           end.
     1389           when 'olddens':U then do:
     1390             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1391               assign
     1392                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
     1393               .
     1394             end.
     1395           end.
     1396           when 'algrvspt':U then do:
     1397             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1398               assign
     1399                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
     1400               .
     1401             end.
     1402           end.
     1403           when 'temp-for-pomi':U then do:
     1404             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1405               assign
     1406                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
     1407               .
     1408             end.
     1409           end.
     1410           when 'algoincome':U then do:
     1411             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1412               assign
     1413                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
     1414               .
     1415             end.
     1416           end.
     1417           when 'mand-choice-autocar':U then do:
     1418             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1419               assign
     1420                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
     1421               .
     1422             end.
     1423           end.
     1424           when 'block-nozzle':U then do:
     1425             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1426               assign
     1427                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
     1428               .
     1429             end.
     1430           end.
     1431           when 'timeout-block-nozzle':U then do:
     1432             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1433               assign
