     1202   procedure placelib_write-attr:
     1203   define input  parameter p-code     like ub.place-attr.attr-code .
     1204   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1205   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1206   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1207   define input  parameter p-value    like ub.place-attr.attr-value .
     1208   define output parameter p-ok       as logical.
     1209   define buffer buf_place-attr for ub.place-attr .
     1210     do on error undo, return error return-value :
     1211        p-ok = false.
     1212        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1213                                                   and buf_place-attr.obj-code    = p-obj-code
     1214                                                   and buf_place-attr.obj-type    = p-obj-type
     1215                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1216        if not available buf_place-attr then do :
     1217           create buf_place-attr.
     1218           assign
     1219             buf_place-attr.attr-code   = p-code
     1220             buf_place-attr.attr-value  = p-value
     1221             buf_place-attr.obj-code    = p-obj-code
     1222             buf_place-attr.obj-type    = p-obj-type
     1223             buf_place-attr.pl-code     = p-pl-code
     1224           .
     1225           p-ok = true.
     1226        end.
     1227        else do:
     1228           buf_place-attr.attr-value  = p-value .
     1229           p-ok = true.
     1230        end.
     1231     end.
     1232   end.
     1233   procedure placelib_get-attr:
     1234   define input  parameter  p-code     like ub.place-attr.attr-code .
     1235   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1236   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1237   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1238   define output parameter  p-value    like ub.place-attr.attr-value .
     1239   define output parameter  p-ok       as logical.
     1240   define buffer buf_place-attr for ub.place-attr .
     1241     do on error undo, return error return-value :
     1242        p-ok = false.
     1243        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1244                                                   and buf_place-attr.obj-code    = p-obj-code
     1245                                                   and buf_place-attr.obj-type    = p-obj-type
     1246                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1247        if available buf_place-attr then do :
     1248          p-value = buf_place-attr.attr-value.
     1249          p-ok = true.
     1250        end.
     1251        else do :
     1252          p-ok = false.
     1253        end.
     1254     end.
     1255   end.
     1256   procedure placelib_del-attr:
     1257   define input parameter  p-code     like ub.place-attr.attr-code .
