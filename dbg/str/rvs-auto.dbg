        1   block-level on error undo, throw.
        2   define input parameter parparentproc   as widget-handle no-undo.
        3   define input parameter p-parent-handle as widget-handle no-undo.
        4   define input parameter p-log-handle    as handle        no-undo.
        5   define input parameter p-cre-db-num    as integer      no-undo .
        6   define input parameter p-task-type     as character    no-undo.
        7   define input parameter p-task-num      as integer      no-undo.
        8   define input parameter p-db-num        as integer       no-undo.
        9   define variable vss-revision    as character no-undo initial "$Revision$":U.
       10   define variable vss-author      as character no-undo initial "$Author$":U.
       11   define variable vss-date        as character no-undo initial "$Date$":U.
       12   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       13   define variable vss-archive     as character no-undo initial "$Archive$":U.
       14   define variable vss-description as character no-undo initial "Автоматическое создание контрольной сверки":U.
       15   DEFINE VARIABLE mParam AS CHARACTER NO-UNDO.
       16   DEFINE VARIABLE mRVSNull AS LOGICAL no-undo init no.
       17   publish "RVSParam" (output mParam).
       18   mRVSNull = logical (entry(1,mParam)) no-error.
       19   if mRVSNull eq ? then mRVSNull = no.
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define new global shared variable g#lib-trn  as handle no-undo .
       90   define new global shared variable g#lib-trn2 as handle no-undo .
       91   define new global shared variable g#lib-trn3 as handle no-undo .
       92   define new global shared variable g#lib-trn4 as handle no-undo .
       93   define new global shared variable g#libbcrcn as handle no-undo .
       94     define new global shared variable g#lib-rvs as handle no-undo.
       95   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   define  shared variable g#auto-pid           as integer   no-undo .
       97   define  shared variable conn-par             as character no-undo .
       98   define  shared variable g#auto-user-id       as character no-undo .
       99   define  shared variable g#auto-user-login    as character no-undo .
      100   define  shared variable g#auto-user-password as character no-undo .
      101   define  shared variable v-socket             as logical   no-undo .
      102   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   define  shared variable auto-window-h     as handle    no-undo .
      104   define  shared variable auto-log-msg-h    as handle    no-undo .
      105   define  shared variable hand-log-msg-h    as handle    no-undo .
      106   define  shared variable log-file-name     as character no-undo initial ? .
      107   define  shared variable add-log-file-name as character no-undo initial ? .
      108   define  shared variable writelogvalue     as character no-undo initial ? .
      109   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      110   procedure cur-time :
      111      define output parameter p-today as date      no-undo .
      112      define output parameter p-time  as integer   no-undo .
      113     do
      114     on error undo, return error
      115     :
      116       define variable v-date1 as date      no-undo .
      117       define variable v-date2 as date      no-undo .
      118       define variable v-time  as integer   no-undo .
      119       assign
      120         v-date1 = today
      121         v-time  = time
      122         v-date2 = today
      123       .
      124       if v-date1 <> v-date2
      125       then do:
      126         assign
      127           v-date1 = today
      128           v-time  = v-time
      129         .
      130       end.
      131       assign
      132         p-today = v-date1
      133         p-time  = v-time
      134       .
      135     end.
      136   end.
      137   function cur-time-date returns character
      138   :
      139     return string(today, '99/99/9999':U) .
      140   end.
      141   function cur-time-mjd returns decimal
      142   :
      143     define variable v-date as date      no-undo .
      144     define variable v-time as integer   no-undo .
      145     run cur-time in this-procedure
      146       (output v-date
      147       ,output v-time
      148       ) .
      149     return integer(v-date) - 2400002 + (v-time / 86400) .
      150   end.
      151   function cur-time-get-ending-index returns integer
      152   (input p-number as integer
      153   )
      154   :
      155     if p-number < 0
      156     or p-number = ?
      157     then do:
      158       return 1 .
      159     end.
      160     define variable v-rest as integer   no-undo .
      161     assign
      162       p-number = p-number modulo 100
      163     .
      164     if p-number < 20
      165     then do:
      166       assign
      167         v-rest = p-number
      168       .
      169     end.
      170     else do:
      171       assign
      172         v-rest = p-number modulo 10
      173       .
      174     end.
      175     case v-rest :
      176       when 1
      177       then do:
      178         return 2 .
      179       end.
      180       when 2 or
      181       when 3 or
      182       when 4
      183       then do:
      184         return 3 .
      185       end.
      186       otherwise do:
      187         return 1 .
      188       end.
      189     end case .
      190   end.
      191   procedure cur-time-mjd-to-date :
      192      define input  parameter i-mjd-diff as decimal no-undo.
      193      define output parameter o-Date     as date    no-undo.
      194      define output parameter o-Time     as integer no-undo.
      195      define variable v-day-number as integer   no-undo .
      196      if    i-mjd-diff < 0
      197         or i-mjd-diff = ?
      198      then do:
      199         return "?" .
      200      end.
      201      assign
      202         v-day-number = truncate(i-mjd-diff,0).
      203         o-Date = date(v-day-number + 2400002).
      204         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      205     .
      206   end.
      207   function cur-time-mjd-to-string returns character
      208   (input p-mjd-diff as decimal
      209   )
      210   :
      211     define variable v-day-number as integer   no-undo .
      212     define variable v-seconds    as integer   no-undo .
      213     define variable v-hour       as integer   no-undo .
      214     define variable v-min        as integer   no-undo .
      215     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      216     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      217     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      218     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      219     if p-mjd-diff < 0
      220     or p-mjd-diff = ?
      221     then do:
      222       return "?" .
      223     end.
      224     assign
      225       v-day-number = integer(truncate(p-mjd-diff,0))
      226       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      227     .
      228     if v-seconds > 86400
      229     then do:
      230       assign
      231         v-seconds = 86400 - 1
      232       .
      233     end.
      234     if v-seconds < 0
      235     then do:
      236       assign
      237         v-seconds = 0
      238       .
      239     end.
      240     assign
      241       v-hour = truncate(v-seconds / 3600, 0)
      242     .
      243     assign
      244       v-seconds = v-seconds modulo 3600
      245     .
      246     assign
      247       v-min = truncate(v-seconds / 60, 0)
      248     .
      249     assign
      250       v-seconds = v-seconds modulo 60
      251     .
      252     return
      253         (if v-day-number <> 0
      254           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      255           else ""
      256         )
      257       + (if v-day-number <> 0 or v-hour <> 0
      258           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      259           else ""
      260         )
      261       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      262           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      263           else ""
      264         )
      265       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      266       .
      267   end.
      268   function cur-time-string returns character
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      277   end.
      278   function cur-time-string-sec returns character
      279   :
      280     define variable v-date as date      no-undo .
      281     define variable v-time as integer   no-undo .
      282     run cur-time in this-procedure
      283       (output v-date
      284       ,output v-time
      285       ) .
      286     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      287   end.
      288   function cur-time-custom  returns character
      289   (input p-prefix as character
      290   ,input p-date-format as character
      291   ,input p-delimiter as character
      292   ,input p-time-format as character
      293   ,input p-suffix as character
      294   )
      295   :
      296     define variable v-date as date      no-undo .
      297     define variable v-time as integer   no-undo .
      298     run cur-time in this-procedure
      299       (output v-date
      300       ,output v-time
      301       ) .
      302     return
      303       p-prefix
      304       + string(v-date, p-date-format)
      305       + p-delimiter
      306       + string(v-time, p-time-format)
      307       + p-suffix
      308       .
      309   end.
      310   function cur-time-print  returns character
      311   :
      312     define variable v-date as date      no-undo .
      313     define variable v-time as integer   no-undo .
      314     run cur-time in this-procedure
      315       (output v-date
      316       ,output v-time
      317       ) .
      318     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      319   end.
      320   function cur-time-datetime returns datetime
      321   :
      322     define variable v-char as character no-undo .
      323     define variable v-datetime as datetime no-undo .
      324     v-char = cur-time-string().
      325     v-datetime = datetime(v-char).
      326     return  v-datetime.
      327   end.
      328   function cur-time-string-msec returns character
      329   :
      330     define variable v-date as datetime  no-undo .
      331     v-date = now.
      332     return string(v-date) .
      333   end.
      334   define stream LogStream .
      335   define variable mNoTime as logical no-undo.
      336   procedure write-to-log-notime :
      337     define input param i-str as character no-undo .
      338     mNoTime = yes.
      339     run write-to-log (i-str).
      340     mNoTime = no.
      341   end.
      342   procedure write-to-log :
      343     define input param p-str as character no-undo .
      344     do
      345     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      346     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      347     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      348     :
      349       define variable log-res        as logical   no-undo .
      350       define variable v-jj           as integer   no-undo .
      351       if    mNoTime
      352          or writelogvalue eq "AsyncProc"
      353       then
      354          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      355       else
      356          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      357       if auto-log-msg-h <> ? then do:
      358         log-res = auto-log-msg-h:move-to-eof( ) .
      359         log-res = auto-log-msg-h:insert-string( p-str ).
      360       end.
      361       if hand-log-msg-h <> ? then do:
      362         log-res = hand-log-msg-h:move-to-eof( ) .
      363         log-res = hand-log-msg-h:insert-string( p-str ).
      364       end.
      365       assign
      366         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      367         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      368         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      369       .
      370       if add-log-file-name <> ? then do:
      371         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      372           run gbl/fileapnd.p
      373             ( input entry(v-jj, add-log-file-name, chr(1) )
      374             ,input p-str
      375             ,input 20
      376             ) no-error .
      377           if error-status:error then do:
      378             return error return-value .
      379           end.
      380         end.
      381       end.
      382       if writelogvalue eq "AsyncProc"
      383       then do:
      384          p-str = trim(p-str, (chr(13) + chr(10)) )
      385       .
      386          Publish "WriteLogAsunc" (p-str,yes).
      387       end.
      388       else if writelogvalue <> "yes" then do:
      389         run gbl/fileapnd.p
      390           ( input log-file-name
      391           ,input p-str
      392           ,input 20
      393           ) no-error .
      394         if error-status:error then do:
      395           return error return-value .
      396         end.
      397       end.
      398     end.
      399   end procedure.
      400   procedure write-to-screen :
      401     define input param p-str as character no-undo .
      402     do
      403     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      404     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      405     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      406     :
      407       define variable log-res as logical no-undo.
      408       assign
      409         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      410       .
      411       if auto-log-msg-h <> ?
      412       then do:
      413         log-res = auto-log-msg-h:move-to-eof( ) .
      414         log-res = auto-log-msg-h:insert-string( p-str ).
      415       end.
      416       if hand-log-msg-h <> ?
      417       then do:
      418         log-res = hand-log-msg-h:move-to-eof( ) .
      419         log-res = hand-log-msg-h:insert-string( p-str ).
      420       end.
      421     end.
      422   end procedure.
      423   procedure send-msg-to-email :
      424     define input  parameter p-subject      as character no-undo .
      425     define input  parameter p-text-err     as character no-undo .
      426     define input  parameter p-attach-files as character no-undo .
      427     do
      428     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      429     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      430     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      431     :
      432       define variable v-tth             as handle    no-undo .
      433       define variable v-value-character as character no-undo .
      434       define variable v-value-date      as date      no-undo .
      435       define variable v-value-decimal   as decimal   no-undo .
      436       define variable v-value-integer   as integer   no-undo .
      437       define variable v-value-logical   as logical   no-undo .
      438       define variable v-param-type      as character no-undo .
      439       define variable v-email       as character no-undo .
      440       define variable v-tmp-str     as character no-undo .
      441       define variable v-tmp1-str    as character no-undo .
      442       define variable v-ind         as integer   no-undo .
      443       define variable v-num-entries as integer   no-undo .
      444       delete object v-tth no-error.
      445       run adm/shattri.p
      446         ( input "get":U
      447          ,input  "":U
      448          ,input  0
      449          ,input  'auto-task':U
      450          ,input  'send-msg-to-email':U
      451          ,output v-value-character
      452          ,output v-value-date
      453          ,output v-value-decimal
      454          ,output v-value-integer
      455          ,output v-value-logical
      456          ,output v-param-type
      457          ,input-output table-handle v-tth
      458         ) no-error .
      459       if not error-status :error  then do:
      460         assign
      461           v-tmp-str = v-value-character
      462         .
      463       end.
      464       delete object v-tth no-error.
      465       assign
      466         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      467         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      468         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      469         v-num-entries = num-entries( v-tmp-str, chr(44) )
      470         v-email       = "":U
      471       .
      472       do v-ind = 1 to v-num-entries
      473       :
      474         assign
      475           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      476         .
      477         if trim( v-tmp1-str ) <> "":U then do:
      478           if v-email = "":U then do:
      479             assign
      480               v-email = v-tmp1-str
      481             .
      482           end.
      483           else do:
      484             assign
      485               v-email = v-email + chr(44) + v-tmp1-str
      486             .
      487           end.
      488         end.
      489       end.
      490       if v-email <> "":U then do:
      491         run gbl/sendmail.p
      492           ( input v-email
      493           , input p-subject
      494           , input p-text-err
      495           , input p-attach-files
      496           ) no-error .
      497         if error-status :error
      498           or return-value <> "":U
      499         then do:
      500           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      501         end.
      502       end.
      503     end.
      504   end procedure.
      505   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      506   define temp-table temp-schedule-free no-undo
      507   field free-id as character
      508   field free-task-name as character
      509   field proc-run-name as character
      510   field proc-param-edit-name as character
      511   field conf-param as character
      512   field is-gbd as logical
      513   field is-ubd as logical
      514   field enable-concurrent-0 as logical
      515   field enable-concurrent-db as logical
      516   field other-info as character
      517   field enc-key as character
      518   field is-rum as logical
      519   index pi is unique primary
      520   free-id.
      521   procedure schedule-attr-name :
      522   do
      523     on error undo, return error
      524     :
      525     define input  parameter p-code           as character no-undo .
      526     define output parameter p-type           as character no-undo .
      527     define output parameter p-format         as character no-undo .
      528     define output parameter p-label          as character no-undo .
      529     define output parameter p-user-can-edit  as logical   no-undo .
      530     define output parameter p-output-display as logical   no-undo .
      531     define output parameter p-other          as character no-undo .
      532       if index(p-code, chr(4)) > 0 then do:
      533         p-code = entry(1, p-code, chr(4)).
      534       end.
      535       case p-code :
      536               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      537               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      538               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      539               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      540               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      541               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      542               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      543               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      544               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      545         otherwise do:
      546           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      547         end.
      548       end.
      549     end.
      550   end procedure.
      551   procedure schedule-attr-tooltip :
      552   do
      553     on error undo, return error
      554     :
      555       define input  parameter p-code    as character no-undo .
      556       define output parameter p-tooltip as character no-undo .
      557       define output parameter p-label   as character no-undo .
      558       if index(p-code, chr(4)) > 0 then do:
      559         p-code = entry(1, p-code, chr(4)).
      560       end.
      561       case p-code :
      562               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      563               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      564               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      565               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      566               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      567               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      568               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      569               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      570               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      571         otherwise do:
      572               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      573         end.
      574       end.
      575     end.
      576   end procedure.
      577   procedure schedule-attr-value :
      578   do
      579   on error undo, return error return-value
      580   :
      581   define input parameter  p-cre-db-num as integer    no-undo.
      582   define input parameter  p-task-type  as character  no-undo.
      583   define input parameter  p-task-num   as integer    no-undo.
      584   define input parameter  p-code       as character  no-undo.
      585   define output parameter p-value      as character  no-undo.
      586   define output parameter p-type       as character  no-undo.
      587       define variable v-format         as character no-undo .
      588       define variable v-label          as character no-undo .
      589       define variable v-user-can-edit  as logical   no-undo .
      590       define variable v-output-display as logical   no-undo .
      591       define variable v-other          as character no-undo .
      592       define buffer buf_schedule-attr for ub.schedule-attr.
      593       run schedule-attr-name in this-procedure (
      594             input  p-code
      595           , output p-type
      596           , output v-format
      597           , output v-label
      598           , output v-user-can-edit
      599           , output v-output-display
      600           , output v-other
      601       ) no-error .
      602       if error-status :error
      603       then do:
      604           undo, return error return-value .
      605       end.
      606       if p-code begins ('schd-free-id':U + chr(4))
      607       and entry(2, p-code, chr(4)) = '':U then do:
      608         find first buf_schedule-attr no-lock
      609             where buf_schedule-attr.cre-db-num = p-cre-db-num
      610               and buf_schedule-attr.task-type  = p-task-type
      611               and buf_schedule-attr.task-num   = p-task-num
      612               and buf_schedule-attr.attr-code  begins p-code
      613         no-error .
      614       end.
      615       else do:
      616         find first buf_schedule-attr no-lock
      617             where buf_schedule-attr.cre-db-num = p-cre-db-num
      618               and buf_schedule-attr.task-type  = p-task-type
      619               and buf_schedule-attr.task-num   = p-task-num
      620               and buf_schedule-attr.attr-code  = p-code
      621         no-error .
      622       end.
      623       if available buf_schedule-attr
      624       then do:
      625           assign
      626               p-value = buf_schedule-attr.attr-value
      627           .
      628       end.
      629       else do:
      630         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      631            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      632         end.
      633         else do:
      634           assign
      635               p-value = if p-type = 'L':U then "no":U else ""
      636           .
      637         end.
      638       end.
      639   end.
      640   end procedure.
      641   procedure schedule-attr-write :
      642   do
      643   on error undo, return error
      644   :
      645   define input parameter p-cre-db-num  as integer   no-undo.
      646   define input parameter p-task-type   as character no-undo.
      647   define input parameter p-task-num    as integer   no-undo.
      648   define input parameter p-code        as character no-undo.
      649   define input parameter p-value       as character no-undo.
      650       define variable v-type              as character                no-undo.
      651       define variable v-format            as character                no-undo.
      652       define variable v-label             as character                no-undo.
      653       define variable v-user-can-edit     as logical                  no-undo.
      654       define variable v-output-display    as logical                  no-undo.
      655       define variable v-other             as character                no-undo.
      656       define buffer buf_schedule-attr for ub.schedule-attr .
      657       run schedule-attr-name in this-procedure (
      658             input  p-code
      659           , output v-type
      660           , output v-format
      661           , output v-label
      662           , output v-user-can-edit
      663           , output v-output-display
      664           , output v-other
      665       ) no-error.
      666       if error-status :error
      667       then do:
      668           undo, return error return-value.
      669       end.
      670       find first buf_schedule-attr exclusive-lock
      671            where buf_schedule-attr.cre-db-num = p-cre-db-num
      672              and buf_schedule-attr.task-type  = p-task-type
      673              and buf_schedule-attr.task-num   = p-task-num
      674              and buf_schedule-attr.attr-code  = p-code
      675       no-error.
      676       if not available buf_schedule-attr
      677       then do:
      678           create buf_schedule-attr.
      679           assign
      680             buf_schedule-attr.cre-db-num = p-cre-db-num
      681             buf_schedule-attr.task-type  = p-task-type
      682             buf_schedule-attr.task-num   = p-task-num
      683             buf_schedule-attr.attr-code  = p-code
      684             buf_schedule-attr.attr-value = p-value
      685           .
      686       end.
      687       else do:
      688           assign
      689               buf_schedule-attr.attr-value = p-value
      690           .
      691       end.
      692   end.
      693   end procedure.
      694   procedure schedule-attr-delete :
      695   do
      696   on error undo, return error
      697   :
      698   define input  parameter p-cre-db-num  as integer   no-undo.
      699   define input  parameter p-task-type   as character no-undo.
      700   define input  parameter p-task-num    as integer   no-undo.
      701   define input  parameter p-code        as character no-undo.
      702   define output parameter p-deleted     as logical   no-undo.
      703       define buffer buf_schedule-attr for ub.schedule-attr .
      704       define variable v-type              as character                no-undo.
      705       define variable v-format            as character                no-undo.
      706       define variable v-label             as character                no-undo.
      707       define variable v-user-can-edit     as logical                  no-undo.
      708       define variable v-output-display    as logical                  no-undo.
      709       define variable v-other             as character                no-undo.
      710       run schedule-attr-name in this-procedure (
      711             input p-code
      712           , output v-type
      713           , output v-format
      714           , output v-label
      715           , output v-user-can-edit
      716           , output v-output-display
      717           , output v-other
      718       ) no-error .
      719       if error-status :error
      720       then do:
      721           undo, return error return-value .
      722       end.
      723       find first buf_schedule-attr exclusive-lock
      724            where buf_schedule-attr.cre-db-num = p-cre-db-num
      725              and buf_schedule-attr.task-type  = p-task-type
      726              and buf_schedule-attr.task-num   = p-task-num
      727              and buf_schedule-attr.attr-code  = p-code
      728       no-error.
      729       if not available buf_schedule-attr
      730       then do:
      731           assign
      732               p-deleted = no
      733           .
      734       end.
      735       else do:
      736           delete buf_schedule-attr.
      737           assign
      738               p-deleted = yes
      739           .
      740       end.
      741   end.
      742   end procedure.
      743   procedure schedule-attr-news :
      744   do
      745   on error undo, return error
      746   :
      747       define input  parameter p-code           as character no-undo .
      748       define output parameter p-news           as logical   no-undo .
      749       if index(p-code, chr(4)) > 0 then do:
      750         p-code = entry(1, p-code, chr(4)).
      751       end.
      752       case p-code :
      753               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      754               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      755               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      756               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      757               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      758               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      759               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      760               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      761               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      762         otherwise do:
      763           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      764         end.
      765       end.
      766   end.
      767   end procedure.
      768   procedure schedule-attr-extract-logical :
      769   do
      770   on error undo, return error
      771   :
      772   define input  parameter p-parameter-number   as integer      no-undo.
      773   define input  parameter p-parameter-list     as character    no-undo.
      774   define output parameter p-parameter-value   as logical      no-undo.
      775       if num-entries( p-parameter-list ) > p-parameter-number - 1
      776       then do:
      777           assign
      778               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      779           .
      780       end.
      781       else do:
      782           assign
      783               p-parameter-value   = no
      784           .
      785       end.
      786   end.
      787   end procedure.
      788   procedure schedule-attr-get-free-id :
      789   do
      790   on error undo, return error return-value
      791   :
      792     define input  parameter p-cre-db-num  as integer   no-undo.
      793     define input  parameter p-task-type   as character no-undo.
      794     define input  parameter p-task-num    as integer   no-undo.
      795     define output parameter p-free-id     as character no-undo.
      796     define buffer buf_schedule-attr for ub.schedule-attr.
      797     find first buf_schedule-attr no-lock
      798         where buf_schedule-attr.cre-db-num = p-cre-db-num
      799           and buf_schedule-attr.task-type  = p-task-type
      800           and buf_schedule-attr.task-num   = p-task-num
      801           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      802     no-error .
      803     if available buf_schedule-attr then
      804     assign
      805     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      806     no-error
      807     .
      808   end.
      809   end procedure.
      810   procedure schedule-attr-get-free-props :
      811     define input parameter p-free-id as character no-undo .
      812     define output parameter p-value as character no-undo .
      813     define buffer buf_temp-schedule-free for temp-schedule-free.
      814     do
      815     on error undo, return error return-value
      816     :
      817       find first buf_temp-schedule-free no-lock no-error .
      818       if not available buf_temp-schedule-free then do:
      819         run schedule-attr-fill-free-props in this-procedure .
      820       end.
      821       find first buf_temp-schedule-free where
      822               buf_temp-schedule-free.free-id = p-free-id no-error.
      823       if available buf_temp-schedule-free then do:
      824         assign
      825         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      826                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      827                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      828                   buf_temp-schedule-free.conf-param           + chr(4) +
      829                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      830                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      831                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      832                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      833                   buf_temp-schedule-free.other-info
      834         .
      835       end.
      836       else do:
      837        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      838                              "id произвольной задачи - &5"
      839                              ,vss-workfile
      840                              ,vss-revision
      841                              ,vss-description
      842                              ,chr(10)
      843                              ,p-free-id).
      844       end.
      845     end.
      846   end procedure.
      847   procedure schedule-attr-is-rum-free-id :
      848   define input parameter p-free-id as character no-undo .
      849   define output parameter p-is-rum as logical no-undo .
      850   define buffer buf_temp-schedule-free for temp-schedule-free.
      851   do
      852   on error undo, return error
      853   :
      854       find first buf_temp-schedule-free no-lock no-error .
      855       if not available buf_temp-schedule-free then do:
      856         run schedule-attr-fill-free-props in this-procedure .
      857       end.
      858       find first buf_temp-schedule-free where
      859               buf_temp-schedule-free.free-id = p-free-id no-error.
      860       if available buf_temp-schedule-free
      861       and buf_temp-schedule-free.is-rum
      862       then do:
      863         p-is-rum = yes.
      864       end.
      865   end.
      866   end procedure.
      867   procedure schedule-attr-fill-free-props :
      868   define variable v-path                    as character                no-undo .
      869   DEFINE VARIABLE v-full-path               as character                no-undo .
      870   DEFINE VARIABLE v-file-name               as character                no-undo .
      871   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      872   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      873   define buffer buf_temp-schedule-free for temp-schedule-free.
      874   define variable v-answer as logical no-undo .
      875     do
      876     on error undo, return error substitute("&1 &2 &3&4&5&4"
      877                                           ,vss-workfile
      878                                           ,vss-revision
      879                                           ,vss-description
      880                                           ,chr(10)
      881                                           ,error-status:get-message(1) )
      882     :
      883       run gbl/filename.p (
      884                       input 'cmp/shd-free.d'
      885                     ,output v-full-path
      886                     ,output v-path
      887                     ,output v-file-name
      888                     ,output v-file-name-no-ext
      889                     ,output v-file-name-ext
      890                     ) .
      891       input from value(v-full-path).
      892       repeat :
      893         create buf_temp-schedule-free.
      894         import buf_temp-schedule-free.
      895       END.
      896       input close.
      897       _ff:
      898       for each buf_temp-schedule-free :
      899         if buf_temp-schedule-free.free-id = '':U then do:
      900            delete buf_temp-schedule-free.
      901            next _ff.
      902          end.
      903          run schedule-attr-check-enc in this-procedure (
      904                                                       input  buf_temp-schedule-free.free-id
      905                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      906                                                               buf_temp-schedule-free.proc-param-edit-name +
      907                                                               buf_temp-schedule-free.conf-param +
      908                                                               string(buf_temp-schedule-free.is-gbd) +
      909                                                               string(buf_temp-schedule-free.is-ubd) +
      910                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      911                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      912                                                               string(buf_temp-schedule-free.other-info)
      913                                                               )
      914                                                       ,input  buf_temp-schedule-free.enc-key
      915                                                       ,output v-answer    ) no-error .
      916          if error-status:error
      917          or not v-answer then delete buf_temp-schedule-free.
      918        end.
      919     end.
      920   end procedure.
      921   Function schedule-attr-reverse returns character (str as character).
      922      define variable rev_incl_s as character init "" no-undo .
      923      define variable rev_incl_i as integer no-undo .
      924      define variable rev_incl_l as integer no-undo .
      925      rev_incl_l = length(str).
      926      do rev_incl_i = 1 to rev_incl_l:
      927         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      928      end.
      929      return rev_incl_s.
      930   end.
      931   procedure schedule-attr-check-enc.
      932     define input  parameter p-free-id   as character no-undo .
      933     define input  parameter p-value     as character no-undo .
      934     define input  parameter p-enc-value as character no-undo .
      935     define output parameter p-answer    as logical   no-undo .
      936     define variable tmp         as character no-undo .
      937     define variable v-enc-value as character no-undo .
      938     assign
      939     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      940     .
      941     run schedule-attr-pswd-enc in this-procedure
      942       ( input tmp
      943        ,output v-enc-value
      944       ) no-error .
      945     if error-status:error then do:
      946       message
      947         vss-workfile vss-revision vss-description skip
      948         "Ошибка при вызове процедуры pswd-enc" skip
      949         return-value skip
      950         error-status :get-message(1) skip
      951         view-as alert-box error .
      952       undo, return error .
      953     end.
      954     if v-enc-value = p-enc-value then do:
      955       assign
      956         p-answer = true
      957       .
      958     end.
      959     else do:
      960       assign
      961         p-answer = false
      962       .
      963     end.
      964   end.
      965   procedure schedule-attr-conf-enc.
      966     define input  parameter p-free-id   as character no-undo .
      967     define input  parameter p-value     as character no-undo .
      968     define output parameter p-enc-value as character no-undo .
      969     define variable tmp         as character no-undo .
      970     assign
      971       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      972     .
      973     run schedule-attr-pswd-enc in this-procedure
      974       ( input tmp
      975        ,output p-enc-value
      976       ) no-error .
      977     if error-status:error then do:
      978       message
      979         vss-workfile vss-revision vss-description skip
      980         "Ошибка при вызове процедуры pswd-enc" skip
      981         return-value skip
      982         error-status :get-message(1) skip
      983         view-as alert-box error .
      984       undo, return error .
      985     end.
      986   end procedure.
      987   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      988   procedure schedule-attr-pswd-enc :
      989     define input parameter  pswd     as character no-undo .
      990     define output parameter enc-pswd as character no-undo .
      991     do
      992     on error undo, return error return-value
      993     :
      994       assign
      995         enc-pswd = encode(pswd + string(index(pswd, "k")))
      996       .
      997     end.
      998   end procedure.
      999   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1000   PROCEDURE verify-ini-entry:
     1001   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     1002   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     1003   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     1004   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     1005   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     1006   define variable v-mess as character no-undo .
     1007   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     1008   if ini-entry-value = ? and ini-key-name begins "spl"
     1009   then
     1010   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1011   if ini-entry-value = ? and ini-key-name begins "sav"
     1012   then
     1013   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1014   if ini-entry-value = ? then do:
     1015     assign
     1016     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1017                       , chr(10)
     1018                       , ini-section-name
     1019                       , ini-key-name
     1020                       , error-msg-text).
     1021       if not silence then do:
     1022         message
     1023         v-mess
     1024         view-as alert-box ERROR  .
     1025         return error.
     1026       end.
     1027       else do:
     1028         return error v-mess.
     1029       end.
     1030   end.
     1031   END PROCEDURE.
     1032   PROCEDURE verify-file:
     1033   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1034   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1035   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1036   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1037   file-info:file-name = filename.
     1038   found = NOT (file-info:full-pathname = ?).
     1039   if NOT found  then do:
     1040     if not silence then do:
     1041       message error-msg-text
     1042       view-as alert-box ERROR.
     1043       return error.
     1044     end.
     1045     else return error error-msg-text.
     1046   end.
     1047   END PROCEDURE.
     1048   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1049   procedure doc-code:
     1050   define input  parameter parmode          as   character           no-undo.
     1051   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     1052   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     1053   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     1054   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     1055   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     1056   define variable vardb-remote     as   logical             no-undo.
     1057   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     1058   define variable v-delimiter as character no-undo .
     1059   do
     1060   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1061   :
     1062   find first buf_sys-ctrl no-lock .
     1063   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     1064     CASE parmode:
     1065       when "main":u then do:
     1066         if vardb-remote then do:
     1067           assign
     1068             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     1069         end.
     1070         else do:
     1071           assign
     1072             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     1073         end.
     1074       end.
     1075       when "trio" then do:
     1076         assign
     1077           pardoc-code = replace (parroot-doc-code, "=", "*").
     1078       end.
     1079       otherwise do:
     1080         assign
     1081         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     1082         no-error
     1083         .
     1084         if error-status:error  then do:
     1085           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     1086                                         ,chr(10)
     1087                                         ,parmode
     1088                                         ).
     1089         end.
     1090         if num-entries(parmode) = 1
     1091         and parmode <> "chip":U
     1092         and parmode <> "chip_s":U
     1093         then do:
     1094           assign
     1095           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     1096         end.
     1097         else if (lookup("chip":U, parmode) > 0
     1098                  or
     1099                  lookup("chip_s":U, parmode) > 0) then do:
     1100           assign
     1101             vartemp-doc-code = parroot-doc-code.
     1102           do while true:
     1103             if index (vartemp-doc-code , ".") = 0 then
     1104               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     1105             else
     1106               vartemp-doc-code  =
     1107               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     1108               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     1109               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     1110             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     1111           end.
     1112           assign
     1113             pardoc-code = vartemp-doc-code.
     1114         end.
     1115       end.
     1116     end CASE.
     1117     if pardoc-code = '':U
     1118     or (parroot-doc-code <> '':U
     1119     and pardoc-code = parroot-doc-code) then do:
     1120       undo, return error substitute("Ошибка при генерации номера документа&1"
     1121                                     ,chr(10)).
     1122     end.
     1123   end.
     1124   end. // procedure/method
     1125   function get-doc-code-int64 returns int64
     1126     ( input p-doc-code as character ) :
     1127     define variable v-ind              as integer   no-undo .
     1128     define variable v-num-entries      as integer   no-undo .
     1129     define variable v-doc-code-int64   as int64     no-undo .
     1130     define variable v-canonic-doc-code as character no-undo .
     1131     assign
     1132       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1133       v-canonic-doc-code = p-doc-code
     1134     .
     1135     do v-ind = 1 to v-num-entries
     1136     :
     1137       assign
     1138         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1139       .
     1140     end.
     1141     assign
     1142       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1143     .
     1144     return v-doc-code-int64 .
     1145   end. // function/method
