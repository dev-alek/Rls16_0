      701   procedure prnfield-clear :
      702     define output parameter loc-fld as character no-undo.
      703     define output parameter loc-lab as character no-undo .
      704     define output parameter loc-spr as character no-undo .
      705     define output parameter loc-dim as character no-undo .
      706     define output parameter loc-size as character no-undo .
      707     define output parameter loc-format as character no-undo .
      708     define output parameter loc-type as character no-undo .
      709     assign
      710       loc-fld = ""
      711       loc-lab = ""
      712       loc-spr = ""
      713       loc-dim = "0"
      714       loc-size = "":U
      715       loc-format = "":U
      716       loc-type = "":U
      717     .
      718   end procedure .
      719   procedure prnfield-add :
      720     define input        parameter par-fld as character no-undo.
      721     define input        parameter par-lab as character no-undo .
      722     define input        parameter par-spr as character no-undo .
      723     define input        parameter par-size as integer no-undo .
      724     define input        parameter par-format as character no-undo .
      725     define input-output parameter loc-fld as character no-undo.
      726     define input-output parameter loc-lab as character no-undo .
      727     define input-output parameter loc-spr as character no-undo .
      728     define input-output parameter loc-size as character no-undo .
      729     define input-output parameter loc-format as character no-undo .
      730     define input-output parameter loc-dim as character no-undo .
      731     do
      732     on error undo, return error
      733     :
      734       assign
      735       loc-fld = if loc-dim = '0'
      736                 then par-fld
      737                 else (loc-fld + chr(44) + par-fld)
      738       loc-lab = if loc-dim = '0'
      739                 then par-lab
      740                 else (loc-lab + chr(44) + par-lab)
      741       loc-spr = if loc-dim = '0'
      742                 then par-spr
      743                 else (loc-spr + chr(44) + par-spr)
      744       loc-size = if loc-dim = '0'
      745                 then string(par-size)
      746                 else (loc-size + chr(44) + string(par-size))
      747       loc-format = if loc-dim = '0'
      748                 then par-format
      749                 else (loc-format + chr(4) + string(par-format))
      750       no-error
      751       .
      752       assign
      753       entry(num-entries(loc-dim), loc-dim) = string(integer(entry(num-entries(loc-dim), loc-dim)) + 1)
      754       no-error
      755       .
      756     end.
      757   end procedure.
      758   FUNCTION prnfield_get-fsize returns integer(
      759   input p-type as character,
      760   input p-format as character,
      761   input p-label as character
      762   ):
      763   define variable ii as integer no-undo .
      764   define variable v-max as integer no-undo .
      765     do
      766     on error undo, return error
      767     :
      768       do ii = 1 to num-entries(p-label, chr(32)):
      769         assign
      770         v-max = maximum(v-max, length(entry(ii, p-label, chr(32))))
      771         .
      772       end.
      773       if p-format = "99:99" then return MAXIMUM(v-max,8).
      774       CASE p-type:
      775          when 'C':U or when 'character':U then do:
      776           if p-format = "99:99" or p-format = "99:99-99:99" then return maximum(v-max, 8).
      777           else
      778           return maximum(v-max, integer(left-trim(right-trim(left-trim(left-trim(p-format, "X":U), "(":U), ")":U),">") )).
      779         end.
      780         when 'I':U or when 'D':U or when 'T':U or
      781         when 'integer':U or when 'decimal':U or when 'date':U
      782         then do:
      783           return maximum(v-max,length(p-format)).
      784         end.
      785         when 'L':U or when 'logical':U then do:
      786           return MAXIMUM(v-max, length(entry(1, p-format, chr(47))), length(entry(2, p-format, chr(47)))).
      787         end.
      788       END CASE.
      789     end.
      790   end FUNCTION.
      791   function prnfield_get-fformat returns character ( input p-data-type as character
      792                                           ,input p-format as character ):
      793   define variable v-excel-format as character no-undo .
      794   case p-data-type:
      795     when 'character':U then do:
      796       v-excel-format = "@".
      797     end.
      798     when 'integer':U then do:
      799       v-excel-format = "0".
      800     end.
      801     when 'decimal':U then do:
      802       v-excel-format = substitute("0.&1", fill("0", length(entry(2, p-format, ".")))) no-error.
      803     end.
      804     when 'date':U then do:
      805       v-excel-format = "d/m/yyyy".
      806     end.
      807     otherwise do:
      808       v-excel-format = "@".
      809     end.
      810   end.
      811   if v-excel-format = '' then
      812   v-excel-format = "@".
      813   return v-excel-format .
      814   end function.
      815   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      816   define variable v-waitfram-action01         as character   no-undo .
      817   define variable v-waitfram-action02         as character   no-undo .
      818   define variable v-waitfram-action03         as character   no-undo .
      819   define variable mWaitFramTextBeg            as character   no-undo.
      820   define variable mWaitFramTextEnd            as character   no-undo.
      821   define variable mWaitFramView               as logical     no-undo.
      822   define variable mWaitProcEvent              as logical     no-undo init yes.
      823   define variable mWaitFramInterval           as integer     no-undo init 1 .
      824   define variable mWaitFramStop               as logical     no-undo.
      825   define variable mWaitFramStopUser           as logical     no-undo.
      826   define variable mWaitFramStopTimeOut        as logical     no-undo.
      827   define variable mWaitFramStartProc          as datetime-tz no-undo.
      828   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      829   define button B-WaitFramStop auto-end-key
      830        label "Стоп"
      831        size 10 by 1 tooltip "Остоновить процесс".
      832   define button B-viewProcInfo
      833        label "Информация"
      834        size 15 by 1 tooltip "Информация о процесс".
      835   define frame waitfram
      836     v-waitfram-action01 format "x(72)" no-label skip
      837     v-waitfram-action02 format "x(72)" no-label skip
      838     v-waitfram-action03 format "x(72)" no-label skip
      839     B-viewProcInfo
      840     B-WaitFramStop at row 4 col 30
      841     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      842     .
      843   define new global shared variable mBatchMode as logical no-undo init ?.
      844   define variable mFramBachModHandle as handle no-undo.
      845   mFramBachModHandle = frame waitfram:handle.
      846   define variable mFameOldVis as logical no-undo.
      847   define variable mVisCUrentVin as logical no-undo.
      848   if session:batch-mode
      849   then
      850      mBatchMode = yes.
      851   if mBatchMode = ? then do:
      852     mVisCUrentVin = current-window:visible.
      853     mFameOldVis = mFramBachModHandle:visible.
      854     mFramBachModHandle:visible  = yes.
      855     mBatchMode = mFramBachModHandle:visible ne yes.
      856     mFramBachModHandle:visible = mFameOldVis.
      857     current-window:visible = mVisCUrentVin.
      858   end.
      859    if  log-manager:logfile-name ne ?
      860     then DO:
      861         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      862         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      863         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      864     end.
      865   on choose of B-WaitFramStop in frame waitfram
      866   do:
      867     mWaitFramStop = yes.
      868     mWaitFramStopUser = yes.
      869   end.
      870   function waitfram-check-timeout returns logical():
      871      define variable vtime as int64 no-undo.
      872      if mWaitFramStopTimeOut
      873      then
      874         return yes.
      875      vtime = ( now - mWaitFramStartProc ) / 1000 .
      876      if     mWaitFramTimeOut ne ?
      877         and mWaitFramTimeOut ne 0
      878         and mWaitFramTimeOut lt vtime
      879      then do:
      880         mWaitFramStopTimeOut = yes.
      881      end.
      882      return mWaitFramStopTimeOut.
      883   end.
      884   procedure waitfram-hide :
      885     if not session:batch-mode
      886     then do
      887     on error undo, return error return-value
      888     :
      889       pause 0 before-hide .
      890       if not mBatchMode then
      891         hide frame waitfram .
      892     if     not mWaitFramView
      893        and mWaitProcEvent
      894     then
      895       process events .
      896     end.
      897   end procedure.
      898   procedure waitfram-show :
      899     define input  parameter p-message as character no-undo .
      900     define variable v-left-margin as integer   no-undo .
      901     if not session:batch-mode
      902     then do
      903     on error undo, return error return-value
      904     :
      905       if length(p-message) <= 70 then do:
      906         assign
      907           v-left-margin = integer((70 - length(p-message)) / 2)
      908         .
      909         assign
      910           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      911         .
      912         assign
      913           v-waitfram-action01 = " "
      914           v-waitfram-action02 = " "
      915                                    + fill(" ", v-left-margin)
      916                                    + p-message
      917           v-waitfram-action03 = " "
      918         .
      919       end.
      920       else do:
      921         define variable vRindex1 as integer no-undo.
      922         define variable vRindex2 as integer no-undo.
      923         vRindex1 = r-index(p-message," ",70).
      924         if vRindex1 = 0
      925         then
      926            vRindex1 = 70.
      927         if length(p-message)  <= vRindex1 + 70 then do:
      928           assign
      929             v-waitfram-action01 = " "
      930             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      931             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      932           .
      933         end.
      934         else do:
      935           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      936           if vRindex2 <= vRindex1
      937           then
      938              vRindex2 = vRindex1 + 70.
      939           assign
      940             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      941             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      942             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      943           .
      944         end.
      945       end.
      946       B-viewProcInfo:visible   in frame waitfram = no.
      947       B-viewProcInfo:sensitive in frame waitfram = no.
      948       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      949       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      950       if  (   mWaitFramView
      951          or  mWaitProcEvent)
      952          and not mBatchMode
      953       then
      954          display
      955             v-waitfram-action01 skip
      956             v-waitfram-action02 skip
      957             v-waitfram-action03 skip
      958          with frame waitfram .
      959       if     mWaitFramView
      960          then do:
      961             if     mWaitFramInterval ne ?
      962                and not mBatchMode
      963             then
      964                wait-for go of frame waitfram pause mWaitFramInterval.
      965          end.
      966          else
      967             if     mWaitProcEvent
      968                and not mBatchMode
      969             then
      970                process events .
      971     end.
      972   end procedure.
      973      procedure waitfram-show-this:
      974         define input  parameter iInterval as int64 no-undo.
      975         define variable vtime as int64 no-undo.
      976         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      977         mWaitFramInterval = iInterval.
      978         run waitfram-show (substitute("&1&2 &3&4" ,
      979                                       mWaitFramTextBeg ,
      980                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      981                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      982                                       mWaitFramTextEnd
      983                                      )
      984                           ).
      985      end.
      986      procedure WaitFramRunPause:
      987         define input  parameter iInterval as dec no-undo.
      988         define variable vStart  as datetime-tz no-undo.
      989         define variable vend    as datetime-tz no-undo.
      990         define variable vint as int64 no-undo.
      991         define variable vOk as logical no-undo.
      992         vStart = now.
      993         vend   = vStart.
      994         publish "WaitFramPause" (iInterval,output vOk).
      995         vend   =  now.
      996         vint = vend - vStart.
      997         vint = iInterval - vint / 1000.
      998         if     not mWaitFramStop
      999            and (   vint > 0
     1000                 or (    not vOk
     1001                     and iInterval eq ?
     1002                     )
     1003                 )
     1004         then
     1005            run waitfram-show-this (iInterval).
     1006         vend   =  now.
     1007         vint = vend - vStart.
     1008         vint = iInterval - vint / 1000.
     1009         if     not mWaitFramStop
     1010            and vint > 0
     1011         then do:
     1012            run gbl/pause.p (vint * 1000).
     1013         end.
     1014         if iInterval ne ?
     1015         then
     1016            publish "WaitFramStop".
     1017         waitfram-check-timeout().
     1018      end.
     1019      procedure WaitFramWaitFor:
     1020         define input  parameter iInterval as dec no-undo.
     1021         assign
     1022            mWaitFramStartProc   = now
     1023            mWaitFramStopUser    = no
     1024            mWaitFramStopTimeOut = no
     1025         .
     1026         block-wait:
     1027         do while not mWaitFramStop:
     1028            run WaitFramRunPause (iInterval).
     1029            if  waitfram-check-timeout()
     1030            then do:
     1031               leave block-wait.
     1032            end.
     1033         end.
     1034         run waitfram-hide.
     1035      end.
     1036   procedure waitfram-join :
     1037     define input  parameter p-line-1  as character no-undo .
     1038     define input  parameter p-line-2  as character no-undo .
     1039     define input  parameter p-line-3  as character no-undo .
     1040     define output parameter p-message as character no-undo .
     1041     do
     1042     on error undo, return error return-value
     1043     :
     1044       assign
     1045         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1046                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1047                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1048       .
     1049     end.
     1050   end procedure.
     1051   function waitfram-join-function returns character
     1052     (input p-line-1 as character
     1053     ,input p-line-2 as character
     1054     ,input p-line-3 as character
     1055     ).
     1056     define variable v-message as character no-undo .
     1057     run waitfram-join in this-procedure
     1058       (input  p-line-1
     1059       ,input  p-line-2
     1060       ,input  p-line-3
     1061       ,output v-message
     1062       ) .
     1063     return v-message .
     1064   end function .
     1065   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
