     1517   PROCEDURE chkdocfi:
     1518   DEFINE PARAMETER BUFFER fi-chk-doc for ub.chk-doc.
     1519   DEFINE INPUT PARAMETER v-chkdocfi as char no-undo.
     1520   define input parameter p-excel as logical no-undo .
     1521   DEFINE INPUT-OUTPUT PARAMETER fi-1 as char no-undo.
     1522   DEFINE VARiable II AS INTEGER NO-UNDO.
     1523   DEFINE variable myfi as char no-undo extent 1.
     1524   DEFINE VARiable jj as integer no-undo init 1.
     1525   DEFINE variable Myformat as character no-undo.
     1526   DEFINE VARiable vNum-entries as integer no-undo.
     1527   DEFINE VARiable entry-ii as character no-undo.
     1528   DEFINE VARiable vvalue as character no-undo.
     1529   DEFINE VARiable vtype as character no-undo.
     1530   DEFINE VARiable vlabel as character no-undo.
     1531   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     1532     IF v-chkdocfi = "" then
     1533     v-chkdocfi = 'chk-doc.doc-code,chk-doc.obj-code,chk-doc.#chk-type-name,chk-doc.tot-doc,chk-doc.netto,chk-doc.chk-date,chk-doc.#chk-time-chr':U.
     1534    if avail fi-chk-doc then do:
     1535   vNum-entries = NUm-ENTRIES(v-chkdocfi).
     1536     DO ii = 1 to vNum-entries:
     1537       entry-ii = ENTRY(ii, v-chkdocfi).
     1538       find first buf_usr-flt_custom-labels where
     1539                 buf_usr-flt_custom-labels.tbl-name = entry(1, entry-ii, ".")
     1540            and  buf_usr-flt_custom-labels.fld-name = entry(2, entry-ii, ".")
     1541            and  buf_usr-flt_custom-labels.call-point = 'chkdocfi':U
     1542            and  buf_usr-flt_custom-labels.call-type = 'add-fields':U no-error.
     1543       if  available buf_usr-flt_custom-labels then do:
     1544         case buf_usr-flt_custom-labels.tbl-name:
     1545           when 'chk-doc':U then do:
     1546             if entry(2, entry-ii, ".") begins "#" then do:
     1547               assign
     1548               myfi[jj] = string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func, buffer fi-chk-doc)
     1549                                 , buf_usr-flt_custom-labels.custom-format) no-error .
     1550             end.
     1551             else do:
     1552               myfi[jj] =  string(buffer fi-chk-doc:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     1553             end.
     1554           end.
     1555         end case.
     1556         if p-excel then do:
     1557           if buf_usr-flt_custom-labels.fld-data-type = 'decimal':U
     1558           or buf_usr-flt_custom-labels.fld-data-type = 'integer':U
     1559           then do:
     1560             myfi[jj] = replace(myfi[jj], chr(44), "").
     1561           end.
     1562         end.
     1563       end.
     1564     END.
     1565     end.
     1566     assign
     1567     fi-1 = myfi[1]
     1568     .
     1569   END PROCEDURE.
     1570   FUNCTION get-function returns character(
     1571                                           input p-f-name as character
     1572                                          ,input p-format as character
     1573                                          ,input p-excel as logical
     1574   ):
     1575     do
     1576     on error undo, return error
     1577     :
     1578       CASE p-f-name:
     1579         when "iColumn":U then do:
     1580           if p-excel then do:
     1581              return replace(string(iColumn, p-format), chr(44), '').
     1582           end.
     1583           else do:
     1584              return string(iColumn, p-format).
     1585           end.
     1586         end.
     1587       END CASE.
     1588     end.
     1589   end FUNCTION.
     1590   if not valid-handle(my-handle) then do:
     1591     assign
     1592     my-handle = parparentproc.
     1593   end.
     1594   for each buf_usr-flt_custom-labels:
     1595     delete buf_usr-flt_custom-labels.
     1596   end.
     1597   for each  buf_custom-labels no-lock where
     1598             buf_custom-labels.call-type = 'add-fields':U
     1599         and buf_custom-labels.call-point = 'chkdocfi':U
     1600        :
     1601     create buf_usr-flt_custom-labels.
     1602     buffer-copy buf_custom-labels to buf_usr-flt_custom-labels.
     1603   end.
     1604   run init-prn-template in this-procedure .
     1605   run gbl/prntput.p (c-point, output v-rec).
     1606   run gbl/prntmpl.w (
     1607                   input parparentproc
     1608                 , input "":U
     1609                 , input c-point
     1610                 , input Tbl
     1611                 , input join-tbl
     1612                 , input Fld
     1613                 , input Lab
     1614                 , input Spr
     1615                 , input v-size
     1616                 , input v-format
     1617                 , input Dim
     1618                 , input-output v-rec
     1619                 , OUTPUT V-LENGTH
     1620                 , OUTPUT V-NUM-CLMN
     1621               ).
     1622   if v-rec = ? then return.
     1623   find first ubflt.filter no-lock where
     1624              recid(ubflt.filter) = v-rec no-error .
     1625   if not avail ubflt.filter then return.
     1626   do jj = 1 to num-entries(ubflt.filter.Fields-sort):
     1627     assign
     1628     f-name-1 = "":U
     1629     v-frm-set = no
     1630     .
     1631     do jj-1 = 1 to num-entries(entry(jj, ubflt.filter.Fields-sort), "*":U):
     1632       case entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), "."):
     1633         when "function":U then do:
     1634           assign
     1635           t-name = ''
     1636           f-n = entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U)
     1637           .
     1638         end.
     1639         otherwise do:
     1640           assign
     1641           f-n = entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".")
     1642           t-name = entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".")
     1643           .
     1644         end.
     1645       END CASE.
     1646       assign
     1647       f-name-1 = f-name-1 + (if f-name-1 = "":U then "":U else "*":U) + (if t-name <> '':U then (t-name + ".") else '') + f-n
     1648       .
     1649       if v-frm-set = no then do:
     1650         assign
     1651         v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=" +
     1652                     prnfield_get-fformat(entry(jj, ubflt.filter.lst-cend)
     1653                                ,entry(jj, ubflt.filter.where-ysl-rus, chr(4)))
     1654         .
     1655       end.
     1656     end.
     1657     assign
     1658     f-name = f-name + (if f-name = "":U then "":U else chr(44)) + f-name-1
     1659     .
     1660   end.
     1661   assign
     1662   sheetf.colformat = v-osn-frm + chr(4) + v-eng-frm
     1663   .
     1664   assign
     1665   j-n = num-entries(f-name)
     1666   .
     1667   Sheetf.Bas-Params = string(5) + chr(4) + Sheetf.Bas-Params.
     1668   Make-excel = yes.
     1669   run get-report-num  in parParentProc(output g#report-num).
     1670   find first buf1_sheetf no-lock where
     1671             buf1_sheetf.sheet-num = 1 or buf1_sheetf.sheet-num = 0.
     1672   if Make-Excel then
     1673   RUN OpenForExcel in this-procedure .
     1674   FOR EACH sheetf where sheetf.sheet-num > 1:
     1675     delete sheetf.
     1676   end.
     1677   FIND FIRST sheetf where
     1678              sheetf.sheet-num = 1 No-ERROR.
     1679   assign
     1680   ReportName = "Список товарных чеков"
     1681   str1 = ''
     1682   sheetf.Excel-Column-Lable = ubflt.filter.Fields-sort-rus
     1683   sheetf.sizes = ubflt.filter.Where-ysl
     1684   .
     1685   run waitfram-show in this-procedure ("Экспорт в EXCEL. Ждите ...").
     1686   run rep/extitle.p (1).
     1687   run adm/shattri.p (
     1688         input "get":U
     1689       ,input  p-curr-obj-type
     1690       ,input  p-curr-obj-code
     1691       ,input  'dc-ref':U
     1692       ,input  'l-mask':U
     1693       ,output v-value-character
     1694       ,output v-value-date
     1695       ,output v-value-decimal
     1696       ,output v-value-integer
     1697       ,output par-l-mask
     1698       ,output v-param-type
     1699       ,INPUT-OUTPUT table-handle v-tth
     1700       ) no-error .
     1701   for each thbjattr_thbj-attr where
     1702          thbjattr_thbj-attr.obj-type = p-curr-obj-type
     1703      and thbjattr_thbj-attr.obj-code = p-curr-obj-code
     1704      and thbjattr_thbj-attr.upper-prop-code = 'dc-ref':U
     1705   on error undo, return error return-value :
     1706     case thbjattr_thbj-attr.prop-code:
     1707       when 'l-mask':U then do:
     1708         assign
     1709         par-l-mask = thbjattr_thbj-attr.property-value-logical.
     1710       end.
     1711     end case.
     1712   end.
     1713   iColumn = 0.
     1714   FOR EACH buf_chk-list No-LOCK
     1715   BREAK
     1716   BY buf_chk-list.doc-code :
     1717     if first-of(buf_chk-list.doc-code) then do:
     1718       if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end.
     1719     end.
     1720     if available buf_chk-doc then do:
     1721       release buf_chk-doc.
     1722     end.
     1723     find first buf_chk-doc no-lock where
     1724               buf_chk-doc.doc-code = buf_chk-list.doc-code no-error.
     1725     if (iColumn modulo 10) = 0 then
     1726       run waitfram-show in this-procedure ("Экспортировано в EXCEL строк : " + string (iColumn)).
     1727     assign
     1728     iColumn = iColumn + 1
     1729     v-osn-frm = "":U
     1730     v-eng-frm = "":U
     1731    .
     1732     define variable v-dop0 as character no-undo .
     1733     define variable v-dop1 as character no-undo .
     1734     define variable v-dop2 as character no-undo .
     1735     do jj = 1 to j-n:
     1736       assign
     1737       f-value = "":U
     1738       v-dop0 = entry(jj, f-name)
     1739       v-dop1 = entry(1, v-dop0, ".")
     1740       v-dop2 = entry(2, v-dop0, ".")
     1741       .
     1742       ii-excel = ii-excel + 1.
     1743       CASE  v-dop1:
     1744         when "function":U then do:
     1745           if Make-Excel then  put   stream ForExcel unformatted
     1746           get-function( input substr(v-dop0 ,10 )
     1747                        ,input entry(jj, ubflt.filter.Where-ysl-rus, chr(4))
     1748                        ,input yes
     1749                        )
     1750           (if jj < j-n
     1751           then
     1752           CHR(9)
     1753           else chr(10))
     1754           .
     1755         end.
     1756         when 'chk-doc':U then do:
     1757           if index(v-dop0, "*":U) > 0 then do:
     1758             do jj-1 = 1 to num-entries(v-dop0, "*":U):
     1759               assign
     1760               f-value-1 = "":U.
     1761               run chkdocfi in this-procedure (
     1762                               buffer buf_chk-doc
     1763                               ,INPUT entry(jj-1, v-dop0, "*":U)
     1764                               ,input yes
     1765                               ,INPUT-OUTPUT f-value-1
     1766                               )  NO-ERROR .
     1767               assign
     1768               f-value = f-value + (if f-value = "":U then "":U else chr(32)) + f-value-1
     1769               .
     1770             end.
     1771           end.
     1772           else do:
     1773             run chkdocfi in this-procedure (
     1774                             buffer buf_chk-doc
     1775                             ,INPUT entry(jj, f-name)
     1776                             ,input yes
     1777                             ,INPUT-OUTPUT f-value
     1778                             )  NO-ERROR .
     1779           end.
     1780           if par-l-mask and entry(jj, f-name) = "chk-doc.src-d-card" then
     1781           f-value = substring(f-value,1,6) + "XXXXXX" + substring (f-value,13,4).
     1782           if Make-Excel then  put   stream ForExcel unformatted
     1783           string(f-value, substitute("X(&1)", entry(jj, ubflt.filter.Where-ysl)))
     1784           (if jj < j-n
     1785           then
     1786           CHR(9)
     1787           else chr(10))
     1788           .
     1789         end.
     1790       END CASE.
     1791     end.
     1792   END.
     1793   if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1794   find first buf_sheetf where
     1795             buf_sheetf.sheet-num = ii-page + 1 no-error.
     1796   if not available buf_sheetf then do:
     1797     create buf_sheetf.
     1798     assign
     1799     buf_sheetf.sheet-num = ii-page + 1
     1800     buf_sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1801     buf_sheetf.sizes = "9,9,9,12,155"
     1802     .
     1803     release buf_sheetf.                                     ~
     1804   end.
     1805   assign
     1806   ii-page = ii-page + 1
     1807   ii-excel = 0
     1808   .
     1809   run rep/extitle.p ( input ii-page) .
     1810   run waitfram-show in this-procedure ("Экспорт в EXCEL истории").
     1811   for each buf-chk-list-hist:
     1812     if Make-Excel then  put   stream ForExcel unformatted
     1813     (if buf-chk-list-hist.line = 0
     1814      then string(buf-chk-list-hist.id, ">>>>>>>>9")
     1815      else '':U)
     1816     CHR(9)
     1817     (if buf-chk-list-hist.item_ <> '':U
     1818      then buf-chk-list-hist.hist-mode
     1819      else '':U)  CHR(9)
     1820      (if buf-chk-list-hist.item_ <> '':U
     1821      then string(buf-chk-list-hist.num-add, "->>>>>>>>9")
     1822      else '':U)  CHR(9)
     1823     (if buf-chk-list-hist.item_ <> '':U
     1824     then string(buf-chk-list-hist.num-recs, ">>>>>>>>9")
     1825     else '':U)  CHR(9)
     1826     buf-chk-list-hist.des
     1827     skip.
     1828   end.
     1829   run waitfram-hide in this-procedure .
     1830   if Make-Excel then output stream ForExcel close.
     1831   run waitfram-hide in this-procedure .
     1832   if Make-Excel then do:
     1833      run rep/runexcel.p (
     1834                      string( session:temp-directory +
     1835                            "rpt" +
     1836                            string( g#report-num ) + ".txt":U )
     1837                    ) .
     1838   end.
     1839   if Make-Excel then
     1840   RUN CLoseForExcel in this-procedure .
     1841   procedure init-prn-template :
     1842   define variable na                   as integer            no-undo .
     1843   DEFINE VARIABLE vtooltip             as character           no-undo.
     1844   DEFINE VARIABLE vlabel               as character           no-undo .
     1845   DEFINE VARIABLE vtype                as character           no-undo .
     1846   DEFINE VARIABLE vformat              as character           no-undo .
     1847   DEFINE VARIABLE vuser-can-edit       as character           no-undo .
     1848   DEFINE VARIABLE voutput-display      as character           no-undo .
     1849   DEFINE VARIABLE vother               as character           no-undo .
     1850     do
     1851     on error undo, return error
     1852     :
     1853       assign
     1854       join-tbl = 'Чек,Другое'
     1855       tbl =  'chk-doc':U + chr(44) + "function"
     1856       c-point =  "chkl-prx" + chr(4) +  "PRNT":u  + chr(4) + "Список чеков"
     1857       fld = ""
     1858       lab = ""
     1859       spr = ""
     1860       dim = '0'
     1861       v-size = "":U
     1862       v-format = "":U
     1863       .
     1864      for each buf_usr-flt_custom-labels where
     1865              buf_usr-flt_custom-labels.call-type = 'add-fields':U
     1866          and buf_usr-flt_custom-labels.call-point = 'chkdocfi':U
     1867          and buf_usr-flt_custom-labels.tbl-name = 'chk-doc':U
     1868      by buf_usr-flt_custom-labels.custom-label
     1869          :
     1870         run prnfield-add in this-procedure(input buf_usr-flt_custom-labels.fld-name
     1871                                           ,input buf_usr-flt_custom-labels.custom-label
     1872                                           ,input (if buf_usr-flt_custom-labels.custom-view-func <> ''
     1873                                                   then substitute("attr.&1", buf_usr-flt_custom-labels.fld-data-type)
     1874                                                   else '')
     1875                                           ,input integer(buf_usr-flt_custom-labels.widget-width)
     1876                                           ,input buf_usr-flt_custom-labels.custom-format
     1877                                           ,input-output fld
     1878                                           ,input-output lab
     1879                                           ,input-output spr
     1880                                           ,input-output v-size
     1881                                           ,input-output v-format
     1882                                           ,input-output dim)  no-error.
     1883       end.
     1884       assign
     1885       fld = fld
     1886       lab = lab
     1887       dim = dim + chr(44)
     1888       .
     1889       run prnfield-add in this-procedure('iColumn', '№', 'function.integer', 7, ">>>>>>9":U,
     1890       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     1891     end.
     1892   end procedure.
