      589   procedure OpenForExcel :
      590      define variable v-ch#ExcelApplication as com-handle no-undo .
      591      define variable v-ch#Workbook         as com-handle no-undo .
      592      define variable v-ch#Worksheet        as com-handle no-undo .
      593      os-delete value( string( session:temp-directory ) +
      594                                 "rpt" + string( g#report-num ) + ".txt":U ) .
      595      os-delete value( string( session:temp-directory ) +
      596                                 "rpt" + string( g#report-num ) + ".frm":U ) .
      597      os-delete value( string( session:temp-directory ) +
      598                                 "rpt" + string( g#report-num ) + ".txl":U ) .
      599      if Make-Excel
      600      then do:
      601         output stream ForExcel to value( string( session:temp-directory +
      602                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
      603         assign
      604            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
      605            number-list = 1
      606         .
      607         if make-excel-com
      608         then do:
      609   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      610   if valid-handle(ch#WorkSheet) then
      611   RELEASE OBJECT ch#WorkSheet no-error.
      612   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      613   if valid-handle(ch#Workbook) then
      614   RELEASE OBJECT ch#Workbook no-error.
      615   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616   if valid-handle(ch#ExcelApplication) then
      617   RELEASE OBJECT ch#ExcelApplication no-error.
      618            create "Excel.Application" ch#excelApplication connect no-error.
      619            if error-status:error
      620            then do :
      621           create "Excel.Application" ch#excelApplication no-error.
      622       if error-status :error then do:
      623           message
      624           "Ошибка при запуске Excel" skip
      625           error-status :get-message(1) skip
      626           view-as alert-box error .
      627           undo, return error .
      628       end.
      629            end.
      630            assign
      631               num#str#  = 0.
      632               v-ch#excelApplication  = ch#excelApplication.
      633               v-ch#excelApplication:Interactive = false.
      634               v-ch#excelApplication:ScreenUpdating = false.
      635               v-ch#excelApplication:Visible = false.
      636               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
      637               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
      638               v-ch#Worksheet = ch#WorkSheet.
      639               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
      640               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
      641               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
      642               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
      643            no-error .
      644            if error-status:error
      645            then do:
      646               Make-Excel-com = false .
      647               Make-Excel = false .
      648               output Stream  ForExcel close.
      649               os-delete value( string( session:temp-directory ) +
      650                              "rpt" + string( g#report-num ) + ".txt":U ) .
      651               os-delete value( string( session:temp-directory ) +
      652                              "rpt" + string( g#report-num ) + ".frm":U ) .
      653               return.
      654            end.
      655         end.
      656      end.
      657   end.
      658   procedure CloseForExcel :
      659      define variable ii as integer no-undo .
      660      define variable vsheet-num as integer no-undo.
      661      if Make-Excel
      662      then  do:
      663         output Stream  ForExcel close.
      664         os-delete value( string( session:temp-directory ) +
      665                                "rpt" + string( g#report-num ) + ".txt":U ) .
      666         os-delete value( string( session:temp-directory ) +
      667                                "rpt" + string( g#report-num ) + ".frm":U ) .
      668         define buffer buf_sheetf for sheetf.
      669         find last buf_sheetf no-error .
      670         if available buf_sheetf
      671         then
      672            vsheet-num = buf_sheetf.sheet-num.
      673         if vsheet-num > 1
      674         then do:
      675            do ii = 2 to vsheet-num:
      676               os-delete value( string( session:temp-directory ) +
      677                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
      678            end.
      679         end.
