      692   define variable c-point  as character no-undo .
      693   define variable tbl      as character no-undo .
      694   define variable join-tbl as character no-undo .
      695   define variable fld      as character no-undo .
      696   define variable lab      as character no-undo .
      697   define variable spr      as character no-undo .
      698   define variable v-size   as character no-undo .
      699   define variable v-format as character no-undo .
