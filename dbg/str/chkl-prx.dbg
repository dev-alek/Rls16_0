      144   procedure create_obj-list :
      145      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      146      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      147      do
      148      on error undo, return error return-value
      149      :
      150         define buffer cli-obj for ub.clients .
      151         define variable p-var as integer no-undo .
      152         define buffer buf_obj-list for obj-list .
      153         find last buf_obj-list  use-index pi no-error .
      154         if available buf_obj-list
      155         then
      156            p-var = buf_obj-list.obj-id + 1.
      157         else
      158            p-var = 1.
      159         find first cli-obj where
      160                   cli-obj.obj-type = p-obj-type
      161               and cli-obj.obj-code = p-obj-code
      162         no-lock no-error.
      163         if available cli-obj
      164         then do:
      165            create buf_obj-list.
      166            assign
      167               buf_obj-list.obj-id   = p-var
      168               buf_obj-list.obj-code = cli-obj.obj-code
      169               buf_obj-list.obj-type = cli-obj.obj-type
      170               buf_obj-list.obj-name = cli-obj.obj-name
      171               buf_obj-list.db-num   = cli-obj.db-num
      172            .
      173         end.
      174      end.
      175   end.
