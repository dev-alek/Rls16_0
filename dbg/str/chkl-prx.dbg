     1471   FUNCTION chkdocfi_cashier-psn-code-name returns character ( buffer buf_chk-doc for ub.chk-doc):
     1472   find first buf_clients no-lock where
     1473             buf_clients.obj-type = 'чел':U
     1474         and buf_clients.obj-code = buf_chk-doc.cashier-psn-code no-error.
     1475   if available buf_clients then do:
     1476     return buf_clients.obj-name.
     1477   end.
     1478   else do:
     1479     return substitute("!Не найдено ФЛ (код &1)", buf_chk-doc.cashier-psn-code).
     1480   end.
     1481   end function.
     1482   FUNCTION chkdocfi_cli-name returns character ( buffer buf_chk-doc for ub.chk-doc):
     1483   if lookup(string(buf_chk-doc.chk-type), '2,3,4,5,7':U) > 0 then return ''.
     1484   if not (buf_chk-doc.cli-code = 0
     1485   or buf_chk-doc.cli-code = ?) then do:
     1486     find first buf_clients no-lock where
     1487               buf_clients.obj-type = buf_chk-doc.cli-type
     1488           and buf_clients.obj-code = buf_chk-doc.cli-code no-error.
     1489     if available buf_clients then do:
     1490       return buf_clients.obj-name.
     1491     end.
     1492     else do:
     1493       return substitute("!!!Не найден клиент &1&2", buf_chk-doc.cli-type, buf_chk-doc.cli-code).
     1494     end.
     1495   end.
     1496   return ''.
     1497   end function.
     1498   FUNCTION chkdocfi_salesman-psn-code-name returns character ( buffer buf_chk-doc for ub.chk-doc):
     1499   if lookup(string(buf_chk-doc.chk-type), '2,3,4,5,7':U) > 0 then return ''.
     1500   if not (buf_chk-doc.salesman-psn-code = 0
     1501           or
