     6622               end.
     6623             end.
     6624             else do:
     6625               if available buf_curr-shop then release buf_curr-shop.
     6626               run libchkval_get-curr-shop in this-procedure (
     6627                                                             input buf_chk-doc.obj-type
     6628                                                             ,input buf_chk-doc.obj-code
     6629                                                             ,input v-base-code
     6630                                                             ,input buf_chk-doc.chk-date
     6631                                                             ,input buf_chk-doc.chk-time
     6632                                                             ,buffer buf_curr-shop) no-error.
     6633               if available buf_curr-shop then do:
     6634                 assign
     6635                 buf_chk-pay.tot-rubl = buf_chk-pay.tot-sum * buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     6636                 buf_chk-pay.exch-date = buf_curr-shop.exch-date
     6637                 buf_chk-pay.exch-time = buf_curr-shop.exch-time
     6638                 buf_chk-pay.exch-rate = buf_curr-shop.exch-rate
     6639                 buf_chk-pay.exch-scale = buf_curr-shop.exch-scale
     6640                 buf_chk-pay.calc-rate = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     6641                 .
