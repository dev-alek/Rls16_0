     5809                               then buf_chk-pay.tot-sum * buf_chk-doc.cash-rate
     5810                               else buf_chk-pay.tot-sum / buf_chk-pay.cash-rate
     5811           buf_chk-pay.calc-rate = buf_chk-pay.tot-rubl /  buf_chk-pay.tot-sum
     5812           .
