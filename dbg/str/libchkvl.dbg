     5052                   AND t-gds.is-modificator)
     5053                   or
     5054                   (t-gds.is-null-price and t-gds.b-code <> ?)
     5055                 )
     5056                 or (t-gds.doc-qnty <> 0
     5057                   and
     5058                   (v-is-100-discnt AND ACCUM-PAY-COUNT > 0)
     5059                   )
     5060                   )
     5061                 )
     5062                 or (abs(abs(t-gds.price-sum) - abs(t-gds.discnt-sum)) < 0.01
     5063                     and
     5064                     v-is-100-discnt)
     5065                 then do:
     5066                 end.
     5067                 else do:
     5068                   assign
     5069                   for-chk-type = for-chk-type + 'сум-ош':U + chr(44)
     5070                   buf_chk-doc.correct = no
     5071                   .
     5072                   if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                             "!!!Чек &1 - ошибочный&2" +                              "По товару с бар-кодом &3, проданном &4 строками чека, имеются несоответствия количества и суммы" +                             "&5 либо имеются несоответствия типа чека (продажа/возврат) знаку товарной суммы"                             , buf_chk-doc.doc-code                             , chr(10)                             , t-gds.b-code                             , t-gds.num-lines                             , chr(10)                           ) ).
     5073                 end.
     5074               END.
     5075             END.
     5076           END.
     5077           FOR EACH t-pay No-LOCK WHERE
     5078                     t-pay.drc = recid(buf_chk-doc):
     5079             if t-pay.tot-rubl <> 0
     5080             or t-pay.tot-base <> 0
     5081             then do:
     5082               IF ((v-r-b = 'rubl':U
     5083                   and
     5084                   t-pay.tot-rubl < 0)
     5085                 AND (buf_chk-doc.netto > 0)
     5086                 )
     5087             OR
     5088             ((v-r-b = 'base':U
     5089                 and
     5090                 t-pay.tot-base < 0)
     5091                 AND (buf_chk-doc.netto > 0)
     5092               )
     5093               or
     5094             ((v-r-b = 'rubl':U
     5095                 and
     5096                 t-pay.tot-rubl > 0)
     5097                 AND (buf_chk-doc.netto < 0)
     5098               )
     5099               or
     5100             ((v-r-b = 'base':U
     5101                 and
     5102                 t-pay.tot-base > 0)
     5103                 AND (buf_chk-doc.netto < 0)
     5104               )
     5105               or
     5106               ((t-pay.tot-rubl >= 0) <> (t-pay.tot-base >= 0))
     5107             then do:
     5108                 assign
     5109                 for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5110                 buf_chk-doc.correct = no
     5111                 .
     5112                 if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                             "!!!Чек &1 - ошибочный&2" +                             "По платежу с кодом &3, с &4 строками оплат чека, имеются несоответствия количества и суммы" +                             "&5 либо имеются несоответствия типа чека (продажа/возврат) знаку суммы платежа"                             , buf_chk-doc.doc-code                             , chr(10)                             , t-pay.pay-code                             , t-pay.num-lines                             , chr(10)                           ) ).
     5113               END.
     5114             END.
     5115           END.
     5116         end.
     5117       end.
     5118     end.
     5119     if ChkGdsPromo(buf_chk-doc.doc-code) then
     5120        v-promo-sum = GetPromoSum(buf_chk-doc.doc-code).
     5121     else v-promo-sum = 0.
     5122     assign
     5123     buf_chk-doc.tot-doc = buf_chk-doc.tot-doc + v-promo-sum
     5124     buf_chk-doc.discnt = buf_chk-doc.discnt + v-promo-sum
     5125     buf_chk-doc.d-pcnt = if buf_chk-doc.tot-doc = 0
     5126                       then 0
     5127                       else ( buf_chk-doc.discnt / buf_chk-doc.tot-doc * 100 )
     5128     .
     5129     if buf_chk-doc.chk-type = integer('8':U)
     5130     or buf_chk-doc.chk-type = integer('301':U)
     5131     or buf_chk-doc.chk-type = integer('306':U)
     5132     or buf_chk-doc.chk-type = integer('306':U)
     5133     then do:
     5134       assign
     5135       buf_chk-doc.tot-doc = 0
     5136       buf_chk-doc.netto = 0
     5137       buf_chk-doc.discnt = 0
     5138       buf_chk-doc.sub-discnt = 0
     5139       buf_chk-doc.doc-qnty = 0
     5140       .
     5141     end.
     5142     assign
     5143     buf_chk-doc.office = RIGHT-TRIM(for-chk-type, chr(44)) +
     5144                          (if not p-close-check
     5145                           then (chr(44) + 'готов':U)
     5146                           else '')
     5147     buf_chk-doc.whole-send-news = v-pos-type-int
     5148     buf_chk-doc.correct =  (if
     5149                         replace(replace(replace(replace(buf_chk-doc.office
     5150                                                       , 'т':U
     5151                                                       , '':U)
     5152                                               , 'у':U
     5153                                               , '':U)
     5154                                         , 'готов':U
     5155                                         , '':U)
     5156                                 , chr(44)
     5157                                 , '':U) = '':U
     5158                         then (if buf_chk-doc.correct = ?
     5159                               or buf_chk-doc.correct = yes
     5160                               then yes
     5161                               else no)
     5162                         else no)
     5163     .
     5164     find first ub.chk-gds no-lock where ub.chk-gds.doc-code = buf_chk-doc.doc-code no-error.
     5165     if trim(buf_chk-doc.office) = "" and not available ub.chk-gds then
     5166         buf_chk-doc.office = 'т':U.
     5167     if v-pos-type-int <> integer('7':U)  then p-prev-code = "" .
     5168   end.
     5169   error-status:error = no.
     5170   end procedure.
     5171   procedure libchkvl_set-corr-discnt private:
     5172   define input parameter p-context-bh as handle no-undo .
     5173   define parameter buffer buf_chk-doc for ub.chk-doc.
     5174   define input parameter p-corr-value as decimal no-undo .
     5175   define input parameter p-fix-discnt as logical no-undo .
     5176   define input parameter p-fix-netto  as logical no-undo .
     5177   define input parameter p-corr-sign as integer no-undo .
     5178   define input-output parameter p-write-off-sum as decimal no-undo .
     5179   define input-output parameter for-chk-type as character no-undo .
     5180   define input-output parameter p-discnt-id as integer no-undo .
     5181   DEFINE VARIABLE nd                         as   logical             no-undo .
     5182   DEFINE VARIABLE var-gds-for-discnt         as decimal               no-undo .
     5183   define variable v-old-discnt               as decimal               no-undo .
     5184   define variable v-log-handle as handle no-undo .
     5185   define variable v-old-corr-discnt-rank as decimal no-undo.
     5186   define variable v-fttwd as logical no-undo .
     5187   define buffer buf_chk-gds for ub.chk-gds.
     5188   define buffer buf0_chk-discnt for ub.chk-discnt.
     5189   do
     5190   on error undo, return error
     5191   :
     5192     if p-context-bh::p-log-file-name <> ""
     5193     and p-context-bh::p-log-file-name <> ? then do:
     5194       log-file-name = p-context-bh::p-log-file-name.
     5195     end.
     5196     else do:
     5197       log-file-name = log-file-name0.
     5198     end.
     5199     v-log-handle = p-context-bh::p-log-handle.
     5200     assign
     5201     nd = yes
     5202     .
     5203     if  LOOKUP('сумма':U, for-chk-type ) > 0 then do:
     5204       FOR EACH buf_chk-gds WHERE
     5205               buf_chk-gds.doc-code = buf_chk-doc.doc-code
     5206       by buf_chk-gds.line-num:
     5207         nd = no.
     5208         leave.
     5209       end.
     5210     end.
     5211     else do:
     5212       _repeat:
     5213         FOR EACH buf_chk-gds WHERE
     5214                   buf_chk-gds.doc-code = buf_chk-doc.doc-code,
     5215             FIRST t-gds where
     5216                   t-gds.b-code = buf_chk-gds.b-code AND
     5217                   t-gds.drc = recid(buf_chk-doc)
     5218                   :
     5219           v-old-corr-discnt-rank = t-gds.corr-discnt-rank.
     5220           if t-gds.first-line-num = 0
     5221           or t-gds.first-line-num > buf_chk-gds.line-num
     5222           then do:
     5223             t-gds.first-line-num = buf_chk-gds.line-num.
     5224           end.
     5225           if t-gds.was-return and t-gds.doc-qnty <> 0 then do:
     5226           t-gds.corr-discnt-rank = t-gds.corr-discnt-rank + 2.
     5227           end.
     5228           v-fttwd = no.
     5229           assign
     5230           v-fttwd = p-context-bh::tt-wd-bh:find-first( substitute(' where doc-code = "&1" and record-type = 0 and line-type = &2 and line-num = &3 '
     5231                                                                , buf_chk-gds.doc-code
     5232                                                                , integer('7':U)
     5233                                                                , buf_chk-gds.line-num
     5234                                                                ))
     5235           no-error
     5236           .
     5237           if v-fttwd then do:
     5238             t-gds.corr-discnt-rank = t-gds.corr-discnt-rank + 3.
     5239           end.
     5240           if t-gds.was-return and t-gds.doc-qnty = 0 then do:
     5241             t-gds.corr-discnt-rank = t-gds.corr-discnt-rank + 4.
     5242           end.
     5243           if buf_chk-gds.price-base < abs(p-corr-value / buf_chk-gds.doc-qnty)
     5244           and not( p-fix-netto = yes and p-corr-value > 0) then do:
     5245             t-gds.corr-discnt-rank = t-gds.corr-discnt-rank + 5.
     5246           end.
     5247           if t-gds.was-write-off  then do:
     5248             t-gds.corr-discnt-rank = t-gds.corr-discnt-rank + 6.
     5249           end.
     5250           if (buf_chk-gds.price-base <= buf_chk-gds.discnt - 0.2) then do:
     5251             t-gds.corr-discnt-rank = t-gds.corr-discnt-rank + 7.
     5252           end.
     5253           if buf_chk-doc.chk-type = integer('96':U)
     5254           or buf_chk-doc.chk-type = integer('69':U) then do:
     5255             t-gds.corr-discnt-rank = t-gds.corr-discnt-rank + 8.
     5256           end.
     5257           if p-context-bh::is-100-discnt
     5258           and buf_chk-doc.d-pcnt = 100
     5259           then do:
     5260             t-gds.corr-discnt-rank = t-gds.corr-discnt-rank + 9.
     5261           end.
     5262           if t-gds.corr-discnt-rank = v-old-corr-discnt-rank then do:
     5263             assign
     5264               t-gds.corr-discnt-rank = 0
     5265               t-gds.first-line-num = buf_chk-gds.line-num
     5266             .
     5267           end.
     5268           if t-gds.price-sum = t-gds.discnt-sum then t-gds.corr-discnt-rank = t-gds.corr-discnt-rank + 10.
     5269           if buf_chk-gds.discnt <> 0 then do:
     5270           t-gds.corr-discnt-rank = t-gds.corr-discnt-rank - 0.1.
     5271           end.
     5272           if buf_chk-gds.doc-qnty = 1 then do:
     5273             t-gds.corr-discnt-rank = t-gds.corr-discnt-rank - 0.1.
     5274           end.
     5275         if t-gds.corr-discnt-rank <= 0
     5276           then do:
     5277             nd = no.
     5278             leave _repeat.
     5279           end.
     5280         END.
     5281       if not available t-gds
     5282       or t-gds.corr-discnt-rank > 0
     5283       then do:
     5284         find first  t-gds where
     5285                 t-gds.drc = recid(buf_chk-doc) use-index icorr-discnt no-error .
     5286       end.
     5287     end.
     5288     if nd = yes
     5289     and (not available t-gds
     5290     or (available t-gds and t-gds.first-line-num = 0)
     5291     )
     5292     then do:
     5293       assign
     5294       for-chk-type = for-chk-type + 'сум-ош':U + chr(44)
     5295       nd = yes
     5296       buf_chk-doc.correct = no
     5297       .
     5298       if valid-handle(v-log-handle) then run write-log-and-file in v-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                             "!!!Чек &1 - ошибочный. &2  - не найдена строка чека, на которую можно уложить погрешность по суммам!"                             , buf_chk-doc.doc-code                             , chr(10)                           ) ).
     5299       p-context-bh::view-log = yes.
     5300     end.
     5301     if available t-gds
     5302     and t-gds.first-line-num > 0
     5303     and t-gds.corr-discnt-rank <= 0
     5304     then do:
     5305       find first buf_chk-gds where
     5306               buf_chk-gds.doc-code = buf_chk-doc.doc-code
     5307           and buf_chk-gds.line-num = t-gds.first-line-num.
     5308       nd = no.
     5309     end.
     5310     if available t-gds
     5311     and t-gds.first-line-num > 0
     5312     and t-gds.corr-discnt-rank > 0
     5313     then do:
     5314     if t-gds.last-included-in-sale > 0 then  do:
     5315         find first buf_chk-gds where
     5316                 buf_chk-gds.doc-code = buf_chk-doc.doc-code
     5317             and buf_chk-gds.line-num = t-gds.last-included-in-sale  use-index ln.
     5318         nd = no.
     5319       end.
     5320       else do:
     5321         assign
     5322         for-chk-type = for-chk-type + 'сум-ош':U + chr(44)
     5323         nd = yes
     5324         buf_chk-doc.correct = no
     5325         .
     5326           if valid-handle(v-log-handle) then run write-log-and-file in v-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                               "!!!Чек &1 - ошибочный. &2  - не найдена строка чека, на которую можно уложить погрешность по суммам!"                               , buf_chk-doc.doc-code                               , chr(10)                             ) ).
     5327         p-context-bh::view-log = yes.
     5328       end.
     5329     end.
     5330     if not nd then do:
     5331       assign
     5332       var-gds-for-discnt = buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt)
     5333       v-old-discnt = buf_chk-gds.discnt
     5334       buf_chk-gds.discnt = ( buf_chk-gds.discnt * abs( buf_chk-gds.doc-qnty ) - p-corr-value * p-corr-sign ) /  abs( buf_chk-gds.doc-qnty )
     5335       buf_chk-doc.discnt = if p-fix-discnt
     5336                         then (buf_chk-doc.discnt - (IF buf_chk-doc.chk-type = integer('1':U)
     5337                                                 then p-corr-value
     5338                                                 else ( - p-corr-value)) * p-corr-sign)
     5339                         else buf_chk-doc.discnt
     5340       buf_chk-doc.netto = if p-fix-netto
     5341                       then (buf_chk-doc.netto +  (IF buf_chk-doc.chk-type = integer('1':U)
     5342                                               then p-corr-value
     5343                                               else ( - p-corr-value)) * p-corr-sign )
     5344                       else buf_chk-doc.netto
     5345       .
     5346       create buf0_chk-discnt.
     5347       assign
     5348       buf0_chk-discnt.doc-code = buf_chk-doc.doc-code
     5349       buf0_chk-discnt.line-num = 0
     5350       buf0_chk-discnt.time-oper = buf_chk-doc.chk-time
     5351       buf0_chk-discnt.line-type = integer('4':U)
     5352       buf0_chk-discnt.pass-discnt = integer('0':U)
     5353       buf0_chk-discnt.record-type = 2
     5354       buf0_chk-discnt.discnt-id = p-discnt-id + 1
     5355       buf0_chk-discnt.line-sign =  ?
     5356       buf0_chk-discnt.value-type = integer('2':U)
     5357       buf0_chk-discnt.discnt-type = integer('999':U)
     5358       buf0_chk-discnt.discnt-value-abs = - p-corr-value * p-corr-sign
     5359       buf0_chk-discnt.object-qnty = buf_chk-gds.doc-qnty
     5360       buf0_chk-discnt.object-sum = var-gds-for-discnt
     5361       buf0_chk-discnt.discnt-value-pcnt = if var-gds-for-discnt <> 0
     5362                                       then (buf0_chk-discnt.discnt-value-abs / buf0_chk-discnt.object-sum) * 100
     5363                                       else 0
     5364       buf0_chk-discnt.object-line-num = buf_chk-gds.line-num
     5365       buf0_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     5366       buf0_chk-discnt.obj-code = buf_chk-doc.obj-code
     5367       buf0_chk-discnt.obj-type = buf_chk-doc.obj-type
     5368       buf0_chk-discnt.chk-date = buf_chk-doc.chk-date
     5369       buf0_chk-discnt.chk-time = buf_chk-doc.chk-time
     5370       p-discnt-id = p-discnt-id + 1
     5371       .
     5372       if abs(buf0_chk-discnt.discnt-value-abs) > 0.01
     5373       and search("getcheck.dbg") <> ? then do:
     5374         assign
     5375         for-chk-type = for-chk-type + 'сум-ош':U + chr(44)
     5376         buf_chk-doc.correct = no
     5377         p-context-bh::view-log = yes
     5378         .
     5379         if valid-handle(v-log-handle) then run write-log-and-file in v-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                             "!!!Значение скидки погрешности превышает пороговое (0.01)&1" +                             "   № чека в БД&2"                             , chr(10)                             , buf_chk-doc.doc-code                           ) ).
     5380       end.
     5381     end.
     5382   end.
     5383   end procedure.
     5384   procedure libchkvl_process-chk-pay private:
     5385   define input parameter p-context-bh as handle no-undo .
     5386   define parameter buffer buf_chk-doc for ub.chk-doc.
     5387   define parameter buffer buf_chk-pay for ub.chk-pay.
     5388   define input-output parameter p-noexchrate as logical no-undo .
     5389   define input-output parameter for-chk-type as character no-undo .
     5390   DEFINE VARIABLE v-pay_code                   like ub.cash-pay.cdpay-code   no-undo .
     5391   DEFINE VARIABLE v-curr_code                  like ub.cash-pay.curr-code    no-undo .
     5392   DEFINE VARIABLE curr-rate                    like ub.curr-shop.exch-rate   no-undo .
     5393   DEFINE VARIABLE curr-scale                   like ub.curr-shop.exch-scale  no-undo .
     5394   define variable v-get-qnty-method            as character   no-undo .
     5395   define variable v-get-qnty-method1           as character   no-undo .
     5396   define buffer buf_curr-shop for ub.curr-shop.
     5397   define buffer buf_cash-pay for ub.cash-pay.
     5398   define buffer buf_wealth for ub.wealth.
     5399   define buffer buf_wth-par for ub.wth-par.
     5400   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5401   define variable v-parparentproc       as widget-handle           no-undo .
     5402   define variable v-p-log-handle        as handle                  no-undo .
     5403   define variable v-p-log-file-name     as character               no-undo .
     5404   define variable v-view-log            as logical                 no-undo .
     5405   define variable v-ll                  as integer                 no-undo .
     5406   define variable v-tt-wd-bh            as handle                  no-undo .
     5407   define variable v-pos-type            as character               no-undo .
     5408   define variable v-cash-num            as integer                 no-undo .
     5409   define variable v-obj-type            as character init 'маг':U  no-undo .
     5410   define variable v-obj-code            as integer                 no-undo .
     5411   define variable v-db-num              as integer                 no-undo .
     5412   define variable v-r-b                 as character               no-undo .
     5413   define variable v-host-code           as integer                 no-undo .
     5414   define variable v-base-code           as integer                 no-undo .
     5415   define variable v-cre-pay             as integer                 no-undo .
     5416   define variable v-is-catering         as logical                 no-undo .
     5417   define variable v-is-cdinv            as logical                 no-undo .
     5418   define variable v-is-ptrl             as logical                 no-undo .
     5419   define variable v-is-wth              as logical                 no-undo .
     5420   define variable v-process-sale        as logical                 no-undo .
     5421   define variable v-dc-mask             as logical                 no-undo .
     5422   define variable v-card-by-mask        as logical                 no-undo .
     5423   define variable v-sclspref            as character               no-undo .
     5424   define variable v-scpgpref            as character               no-undo .
     5425   define variable v-scpgpref-pre        as character               no-undo .
     5426   define variable v-doc-prt             as logical                 no-undo .
     5427   define variable v-shift-on            as logical                 no-undo .
     5428   define variable v-cas-shft            as logical                 no-undo .
     5429   define variable v-t-shft              as integer                 no-undo .
     5430   define variable v-v-shft              as integer                 no-undo .
     5431   define variable v-ptrl-check          as logical                 no-undo .
     5432   define variable v-annu-check          as logical                 no-undo .
     5433   define variable v-z-check             as logical                 no-undo .
     5434   define variable v-hnum                as logical                 no-undo .
     5435   define variable v-is-100-discnt       as logical                 no-undo .
     5436   define variable v-zero-cashier        as integer                 no-undo .
     5437   define variable v-rnd-znak            as integer                 no-undo .
     5438   define variable v-cas-curs            as logical                 no-undo .
     5439   define variable v-nam-2str            as logical                 no-undo .
     5440   define variable v-nam-artc            as logical                 no-undo .
     5441   define variable v-cod-pcod            as logical                 no-undo .
     5442   define variable v-name-2cd            as character               no-undo .
     5443   define variable v-how-temp-disc       as character               no-undo .
     5444   define variable v-nalc                as integer                 no-undo .
     5445   define variable v-rmethod-type        as character               no-undo .
     5446   define variable v-rmethod-coeff       as decimal                 no-undo .
     5447   define variable v-serial-code         as character               no-undo .
     5448   define variable v-salesman-mandatory  as integer                 no-undo .
     5449   define variable v-sales-man           as integer                 no-undo .
