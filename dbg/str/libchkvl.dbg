     5536   .
     5537     if v-p-log-file-name <> ""
     5538     and v-p-log-file-name <> ? then do:
     5539       log-file-name = v-p-log-file-name.
     5540     end.
     5541     else do:
     5542       log-file-name = log-file-name0.
     5543     end.
     5544     if buf_chk-doc.chk-type = integer('43':U) or buf_chk-doc.chk-type = integer('44':U)
     5545     then do :
     5546       assign
     5547         buf_chk-pay.tot-rubl = buf_chk-pay.tot-sum
     5548         buf_chk-pay.exch-date = buf_chk-doc.chk-date
     5549         buf_chk-pay.exch-time = buf_chk-doc.chk-time
     5550         buf_chk-pay.exch-rate = 1
     5551         buf_chk-pay.exch-scale = 1
     5552         buf_chk-pay.calc-rate = 1
     5553       .
     5554       return .
     5555     end .
     5556     assign
     5557     buf_chk-pay.is-error = ?
     5558     v-pay_code = buf_chk-pay.pay-code
     5559     v-curr_code = buf_chk-pay.curr-code
     5560     .
     5561     if buf_chk-doc.chk-type = integer('12':U) then do:
     5562       if buf_chk-pay.pay-code <> 0 then do:
     5563         if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           "!!!Чек &1 - ошибочный&2" +                           "В чеке типа &3 не может быть строк оплат"                           , buf_chk-doc.doc-code                           , chr(10)                           , entry (lookup (string(buf_chk-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)                         ) ).
     5564         assign
     5565         buf_chk-pay.is-error = yes
     5566         for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5567         buf_chk-doc.correct = no
     5568         v-view-log = yes
     5569         .
     5570       end.
     5571       if buf_chk-pay.curr-code <> 0 then do:
     5572         if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           "!!!Чек &1 - ошибочный&2" +                           "Показания фискальных счетчиков в чеке типа &3&2должны быть в нац. валюте"                           , buf_chk-doc.doc-code                           ,chr(10)                           ,entry (lookup (string(buf_chk-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)                         ) ).
     5573         assign
     5574         buf_chk-pay.is-error = yes
     5575         for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5576         buf_chk-doc.correct = no
     5577         v-view-log = yes
     5578         .
     5579       end.
     5580     end.
     5581     else do:
     5582       FIND FIRST buf_cash-pay WHERE
     5583                 buf_cash-pay.cdpay-code = buf_chk-pay.pay-code AND
     5584                 buf_cash-pay.curr-code = buf_chk-pay.curr-code NO-LOCK NO-ERROR.
     5585       if NOT available buf_cash-pay then do:
     5586         if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           "!!!Чек &1 - ошибочный&2" +                            "В базе отсутствует тип кассового платежа c кодом &3 и кодом валюты &4"                           , buf_chk-doc.doc-code                           , chr(10)                           , buf_chk-pay.pay-code                           , buf_chk-pay.curr-code                          ) ).
     5587         assign
     5588         buf_chk-pay.is-error = yes
     5589         for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5590         buf_chk-doc.correct = no
     5591         v-view-log = yes
     5592         .
     5593       end.
     5594       else do:
     5595         if buf_cash-pay.cdpay-code = v-cre-pay and
     5596             buf_chk-pay.pay-card <> "":U then do:
     5597           if buf_chk-doc.d-card = "" then do:
     5598             assign
     5599             buf_chk-doc.d-card = buf_chk-pay.pay-card
     5600             .
     5601           end.
     5602           else do:
     5603             if buf_chk-doc.d-card <> buf_chk-pay.pay-card then do:
     5604               if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           "!!!Чек &1 - ошибочный&2" +                           "Номер дисконтной карты в шапке чека: &3 не равен номеру дисконтной карты &4: по платежу В КРЕДИТ"                           , buf_chk-doc.doc-code                           , chr(10)                           , buf_chk-doc.d-card                           , buf_chk-pay.pay-card                         ) ).
     5605               assign
     5606               buf_chk-pay.is-error = yes
     5607               for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5608               buf_chk-doc.correct = no
     5609               v-view-log = yes
     5610               .
     5611             end.
     5612           end.
     5613         end.
     5614         if buf_cash-pay.is-credit = yes
     5615         and buf_cash-pay.cdpay-code <> v-cre-pay then do:
     5616           if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           ("!!!Чек &1 - ошибочный&2" +                           "Нельзя использовать тип кассового платежа c кодом &3 и кодом валюты &4&2" +                           "Данный тип кассового платежа определен как ПЛАТЕЖ В КРЕДИТ, &5")                           , buf_chk-doc.doc-code                           , chr(10)                           , buf_chk-pay.pay-code                           , buf_chk-pay.curr-code                            , (if v-cre-pay = 0                             then substitute("а такие платежи для фирмы &1 запрещены - настроечный параметр iscredit", v-host-code)                             else substitute("а  для фирмы &1 используется платеж &2 как платеж В КРЕДИТ - см настройки фирмы в АРМ Администратор", v-host-code, v-cre-pay)                             )                         ) ).
     5617           assign
     5618           buf_chk-pay.is-error = yes
     5619           for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5620           buf_chk-doc.correct = no
     5621           v-view-log = yes
     5622           .
     5623         end.
     5624         if buf_cash-pay.is-credit = yes
     5625         and buf_chk-doc.d-card = "":U then do:
     5626           if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           ("!!!Чек &1 - ошибочный&2" +                           "Нельзя использовать тип кассового платежа c кодом &3 и кодом валюты &4&2" +                           "Данный тип кассового платежа определен как ПЛАТЕЖ В КРЕДИТ,&2 но в чеке не указана карта клиента")                           , buf_chk-doc.doc-code                           , chr(10)                           , buf_chk-pay.pay-code                           , buf_chk-pay.curr-code                         ) ).
     5627           assign
     5628           buf_chk-pay.is-error = yes
     5629           for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5630           buf_chk-doc.correct = no
     5631           v-view-log = yes
     5632           .
     5633         end.
     5634         if buf_cash-pay.register > 0
     5635         and buf_chk-doc.d-card = '':U then do:
     5636           if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           ("!!!Чек &1 - ошибочный&2" +                           "Нельзя использовать тип кассового платежа c кодом &3 и кодом валюты &4&2" +                           "Данный тип кассового платежа определен как ВЕДОМОСТЬ,&2 но в чеке не указана карта клиента")                           , buf_chk-doc.doc-code                           , chr(10)                           , buf_chk-pay.pay-code                           , buf_chk-pay.curr-code                         ) ).
     5637           assign
     5638           buf_chk-pay.is-error = yes
     5639           for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5640           buf_chk-doc.correct = no
     5641           v-view-log = yes
     5642           .
     5643         end.
     5644         if available buf_wealth then release buf_wealth.
     5645         if available buf_wth-par then release buf_wth-par.
     5646         v-get-qnty-method = ''.
     5647         if buf_cash-pay.wth-code > 0 then do:
     5648           find first buf_wealth no-lock where
     5649                     buf_wealth.wth-code = buf_cash-pay.wth-code no-error.
     5650           if not available buf_wealth then do:
     5651             if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           ("!!!Чек &1 - ошибочный&2" +                           "Тип кассового платежа c кодом &3 и кодом валюты &4&2 ссылается на несуществующую МЦ с кодом &5")                            , buf_chk-doc.doc-code                           , chr(10)                           , buf_chk-pay.pay-code                           , buf_chk-pay.curr-code                           , buf_cash-pay.wth-code ) ).
     5652             assign
     5653             buf_chk-pay.is-error = yes
     5654             for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5655             buf_chk-doc.correct = no
     5656             v-view-log = yes
     5657             v-get-qnty-method = ''
     5658             .
     5659           end.
     5660         end.
     5661         if available buf_wealth then do:
     5662           if buf_chk-pay.src-val <> 0 then do:
     5663             find first buf_wth-par no-lock where
     5664                       buf_wth-par.wth-code = buf_cash-pay.wth-code
     5665                   and ((buf_wth-par.par-val = integer(buf_chk-pay.src-val)
     5666                        and buf_wth-par.par-rate > 1)
     5667                   or ( buf_wth-par.par-rate < 1
     5668                       and buf_wth-par.par-val = integer(buf_chk-pay.src-val * 100)
     5669                       )
     5670                        )
     5671                   and (
     5672                        buf_chk-pay.par-code = 0
     5673                        or buf_wth-par.par-code  = buf_chk-pay.par-code)
     5674                   no-error.
     5675             if not available buf_wth-par then do:
     5676               if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           ("!!!Чек &1 - ошибочный&2" +                           "Тип кассового платежа c кодом &3 и кодом валюты &4&2 ссылается&2на несуществующий номинал &5 для МЦ &6")                            , buf_chk-doc.doc-code                           , chr(10)                           , buf_chk-pay.pay-code                           , buf_chk-pay.curr-code                           , buf_chk-pay.src-val                           , buf_wealth.wth-name ) ).
     5677               assign
     5678               buf_chk-pay.is-error = yes
     5679               for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5680               buf_chk-doc.correct = no
     5681               v-view-log = yes
     5682               v-get-qnty-method = ''
     5683               .
     5684             end.
     5685           end.
     5686           assign
     5687           v-get-qnty-method1 = (if buf_chk-pay.src-val <> 0
     5688                                then '=val-qnty':U
     5689                                else buf_wealth.get-qnty-method)
     5690           v-get-qnty-method = v-get-qnty-method1
     5691           .
     5692           case v-get-qnty-method1:
     5693             when '' then do:
     5694               assign
     5695               buf_chk-pay.wth-code = 0
     5696               buf_chk-pay.doc-qnty = 0
     5697               buf_chk-pay.par-val = 0
     5698               .
     5699             end.
     5700             when '=sum':U then do:
     5701               assign
     5702               buf_chk-pay.doc-qnty = buf_chk-pay.tot-sum
     5703               buf_chk-pay.par-val = 0
     5704               buf_chk-pay.wth-code = (if available buf_wealth
     5705                                      then buf_wealth.wth-code
     5706                                      else 0)
     5707               buf_chk-pay.par-code = (if available buf_wth-par
     5708                                      then buf_wth-par.par-code
     5709                                      else 0)
     5710               .
     5711             end.
     5712             when '=1':U  then do:
     5713               assign
     5714               buf_chk-pay.doc-qnty = 1
     5715               buf_chk-pay.par-val = 0
     5716               buf_chk-pay.wth-code = (if available buf_wealth
     5717                                      then buf_wealth.wth-code
     5718                                      else 0)
     5719               buf_chk-pay.par-code = (if available buf_wth-par
     5720                                      then buf_wth-par.par-code
     5721                                      else 0)
     5722               .
     5723             end.
     5724             when '=val-qnty':U then do:
     5725               define variable v-qnty as decimal no-undo .
     5726               define variable v-val as integer   no-undo .
     5727               if available buf_wth-par then do:
     5728                 assign
     5729                 v-qnty = buf_chk-pay.tot-sum / buf_chk-pay.src-val / (if buf_wth-par.par-rate < 1 then buf_wth-par.par-rate / buf_chk-pay.src-val else 1)
     5730                 v-val = buf_chk-pay.tot-sum / buf_chk-pay.src-qnty * (if buf_wth-par.par-rate < 1 then buf_wth-par.par-rate / buf_chk-pay.src-val else 1)
     5731                 buf_chk-pay.doc-qnty = (if v-qnty = buf_chk-pay.src-qnty
     5732                                        then v-qnty
     5733                                        else 0)
     5734                 buf_chk-pay.par-val = (if v-val = buf_chk-pay.src-val
     5735                                        then v-val
     5736                                        else 0)
     5737                 buf_chk-pay.par-code = (if buf_chk-pay.par-code = 0
     5738                                         then buf_wth-par.par-code
     5739                                         else buf_chk-pay.par-code)
     5740                 .
     5741               end.
     5742               else do:
     5743                 assign
     5744                 buf_chk-pay.doc-qnty = 0
     5745                 buf_chk-pay.par-val = 0
     5746                 buf_chk-pay.wth-code = 0
     5747                 .
     5748                 if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           ("!!!Чек &1 - ошибочный&2" +                           "Для типа кассового платежа c кодом &3 и кодом валюты &4&2 должен быть задан номинал соответствущей МЦ &5")                            , buf_chk-doc.doc-code                           , chr(10)                           , buf_chk-pay.pay-code                           , buf_chk-pay.curr-code                           , buf_wealth.wth-name                         ) ).
     5749                 assign
