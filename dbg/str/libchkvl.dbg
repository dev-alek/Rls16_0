     6669                   assign
     6670                   buf_chk-pay.tot-base = buf_chk-pay.tot-sum * buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     6671                   .
     6672                 end.
     6673                 else do:
     6674                         if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                               "!!!Чек &1 - ошибочный. &2 Нет магазинного курса валюты &3 для &4&5 на дату &6"                               , buf_chk-doc.doc-code                               , chr(10)                               , V-base-code                                  , buf_chk-doc.obj-type                               , buf_chk-doc.obj-code                               , buf_chk-doc.chk-date                             ) ).
     6675                 end.
     6676                 if available buf_curr-shop then release buf_curr-shop.
     6677                 run libchkval_get-curr-shop in this-procedure (
