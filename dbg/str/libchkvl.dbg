     5877           assign
     5878           buf_chk-pay.tot-base = if v-r-b = 'base':U
     5879                               then buf_chk-pay.tot-sum / buf_chk-pay.cash-rate
     5880                               else buf_chk-pay.tot-sum
     5881           buf_chk-pay.tot-rubl = if v-r-b = 'base':U
     5882                               then buf_chk-pay.tot-sum / buf_chk-pay.cash-rate * buf_chk-doc.cash-rate
     5883                               else buf_chk-pay.tot-sum / buf_chk-pay.cash-rate
     5884           buf_chk-pay.calc-rate = buf_chk-pay.tot-rubl /  buf_chk-pay.tot-sum
     5885           .
     5886           if not v-r-b = 'base':U then do:
     5887             if available buf_curr-shop then release buf_curr-shop.
     5888             run libchkval_get-curr-shop in this-procedure (
     5889                                                            input v-obj-type
     5890                                                           ,input v-obj-code
     5891                                                           ,input v-base-code
     5892                                                           ,input buf_chk-doc.chk-date
     5893                                                           ,input buf_chk-doc.chk-time
     5894                                                           ,buffer buf_curr-shop) no-error.
     5895             if available buf_curr-shop then do:
     5896               assign
