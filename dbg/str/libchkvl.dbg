     4451           , (if v-write-off-sum <> 0 then "(с учетом суммы списания)" else '')
     4452           , chr(10)
     4453           , abs(v-netto-virtual - accum-pay)
     4454           , v-netto-virtual
     4455           , accum-pay)
     4456           view-as alert-box  question buttons YES-NO update loc#log.
     4457           if not loc#log then return error.
     4458         end.
     4459       end.
     4460     end.
