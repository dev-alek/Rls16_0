     6270   .
     6271     if v-p-log-file-name <> ""
     6272     and v-p-log-file-name <> ? then do:
     6273       log-file-name = v-p-log-file-name.
     6274     end.
     6275     else do:
     6276       log-file-name = log-file-name0.
     6277     end.
     6278       v-pos-type-int = integer(entry(lookup(v-pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,r-keeper,Emulator-NKT-IBM,MARIA,IBS-TH,IBS-TH-MOB':U), '2,13,1,3,4,5,6,7,8,9,11,12,14,15':U)).
     6279     if buf_chk-doc.pay-desk <> 0 then do:
     6280       find first buf_cash-desk no-lock where
     6281                 buf_cash-desk.cash-num = buf_chk-doc.pay-desk
     6282           AND buf_cash-desk.obj-code = buf_chk-doc.obj-code
     6283           AND buf_cash-desk.pos-type = v-pos-type no-error .
     6284     end.
     6285     if buf_chk-doc.pay-desk = 0
     6286     or not available buf_cash-desk
     6287     or buf_cash-desk.is-del then do:
     6288       if can-find(first ub.cash-desk where
     6289                           ub.cash-desk.cash-num = 0
     6290                       and ub.cash-desk.obj-code = buf_chk-doc.obj-code
     6291                       and ub.cash-desk.pos-type = 'Autotank':U
     6292                       )
     6293             and can-find(first ub.cash-desk where
     6294                           ub.cash-desk.cash-num = buf_chk-doc.pay-desk
     6295                       and ub.cash-desk.obj-code = buf_chk-doc.obj-code
     6296                       and ub.cash-desk.pos-type = 'Autotank':U
     6297                       and buf_chk-doc.pay-desk > 0 )
     6298       then do:
     6299         v-pos-type-int = integer('13':U).
     6300       end.
     6301       else do:
     6302         find first buf_cash-desk no-lock where
     6303                 buf_cash-desk.cash-num = buf_chk-doc.pay-desk
     6304             AND buf_cash-desk.obj-code = buf_chk-doc.obj-code no-error.
     6305         if available buf_cash-desk then do:
     6306                   v-pos-type-int = integer(entry(lookup(buf_cash-desk.pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,r-keeper,Emulator-NKT-IBM,MARIA,IBS-TH,IBS-TH-MOB':U), '2,13,1,3,4,5,6,7,8,9,11,12,14,15':U)).
     6307         end.
     6308         else do:
     6309           v-pos-type-int = integer('0':U).
     6310         end.
     6311         assign
     6312         for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     6313         v-view-log = yes
     6314         buf_chk-doc.correct = no
     6315         .
     6316         if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                             "!!!Чек &1 - ошибочный. &2 Нет сведений о кассе &3 с типом &4"                             , buf_chk-doc.doc-code                             , chr(10)                             , buf_chk-doc.pay-desk                             , v-pos-type) ).
     6317       end.
     6318     end.
     6319     if p-edit-mode <> "shift-change" then do:
     6320       assign
     6321       buf_chk-doc.shift-date = if v-t-shft < 0
     6322                                  AND buf_chk-doc.chk-time < abs(v-t-shft)
     6323                                  then (buf_chk-doc.chk-date - 1)
     6324                                  else (if buf_chk-doc.src-shift-date = ?
     6325                                       then buf_chk-doc.chk-date
     6326                                       else (if p-wmode = 'ИЗМЕНЕНИЕ':U
     6327                                             then
     6328                                                   (if index(buf_chk-doc.ps, "shift!") = 0
     6329                                                   then buf_chk-doc.src-shift-date
     6330                                                   else buf_chk-doc.shift-date)
     6331                                             else  buf_chk-doc.src-shift-date)
     6332                                        )
     6333       .
     6334     end.
     6335     if v-cas-shft then do:
     6336       if buf_chk-doc.shift-name = '':U
     6337       or trim(buf_chk-doc.shift-name, '0') = '':U
     6338         then  do:
     6339         assign
     6340         for-chk-type = for-chk-type + 'смн-ош':U + chr(44)
     6341         buf_chk-doc.shift-date = 01/01/1990
     6342         buf_chk-doc.correct = no
     6343         .
     6344       end.
     6345       else do:
     6346         if v-v-shft > 0 then do:
     6347           run str/v-shftg.p (
     6348                               buffer buf_chk-doc
     6349                             ,input v-parparentproc
     6350                             ,input v-p-log-handle
     6351                             ,input p-wmode
     6352                             ,input v-obj-type
     6353                             ,input v-obj-code
     6354                             ,input v-v-shft
     6355                             ,input v-t-shft
     6356                             ,input 'смн-ош':U
     6357                             ,input-output for-chk-type
     6358                             ,input-output v-view-log
     6359                               ).
     6360         end.
     6361         if v-shift-on then do:
     6362           if (p-wmode = 'ИЗМЕНЕНИЕ':U and  index(buf_chk-doc.ps, "shift!") = 0)
     6363           or (p-wmode <> 'ИЗМЕНЕНИЕ':U)  then do:
     6364             run libchkvl_get-shift-num in this-procedure (
     6365                                                  input buf_chk-doc.obj-type
     6366                                                 ,input buf_chk-doc.obj-code
     6367                                                 ,input buf_chk-doc.shift-date
     6368                                                 ,input buf_chk-doc.shift-name
     6369                                                 ,output buf_chk-doc.shift-num) no-error .
     6370             if error-status:error
     6371             or buf_chk-doc.shift-num = ?
     6372             or buf_chk-doc.shift-num = 0 then do:
     6373             assign
     6374             for-chk-type = for-chk-type + 'смн-ош':U + chr(44)
     6375             buf_chk-doc.shift-num = 0
     6376             buf_chk-doc.correct = no
     6377             .
     6378             end.
     6379           end.
     6380         end.
     6381         if (p-wmode = 'ИЗМЕНЕНИЕ':U and index(buf_chk-doc.ps, "shift!") = 0)
     6382         or p-wmode <> 'ИЗМЕНЕНИЕ':U
     6383         then do:
     6384           assign
     6385           shift-name_ = (if p-wmode = 'ИЗМЕНЕНИЕ':U
     6386                         then  (if p-edit-mode = 'ДОБАВЛЕНИЕ':U
     6387                                 then buf_chk-doc.shift-name
     6388                                 else buf_chk-doc.src-shift-name)
     6389                         else buf_chk-doc.src-shift-name
     6390                         )
     6391           .
     6392           if v-cas-shft then do:
     6393             if p-get-cash-shift then do:
     6394   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6395   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_get-cash-shift in g#libchkvl
     6396     (input  p-context-bh:handle
     6397     ,buffer buf_shift-cash
     6398     ,input  buf_chk-doc.pay-desk
     6399     ,input  buf_chk-doc.src-shift-date
     6400     ,input  shift-name_
     6401     ,input ?
     6402     ,input buf_chk-doc.chk-date
     6403     ,input buf_chk-doc.chk-time
     6404     ,input 0
     6405       ) no-error .
     6406             end.
     6407           end.
     6408         end.
     6409       end.
     6410     end.
     6411     assign
     6412     v-cashier-psn-code = gbclcode-is-this-db-role ( input 'C':U, input v-db-num, input buf_chk-doc.cashier, input buf_chk-doc.chk-date)
     6413     no-error
     6414     .
     6415     if v-cashier-psn-code = 0 then do:
     6416       assign
     6417       for-chk-type = for-chk-type + 'перс-ош':U + chr(44)
     6418       buf_chk-doc.correct = no
     6419       v-view-log = yes
     6420       .
     6421       if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                             "!!!Чек МЦ &1 - ошибочный. &2 Нет сведений о кассире &3"                             , buf_chk-doc.doc-code                             , chr(10)                             , buf_chk-doc.cashier                           ) ).
     6422     end.
     6423     else do:
     6424       assign
     6425       buf_chk-doc.cashier-psn-code = v-cashier-psn-code
     6426       .
     6427     end.
     6428     for each buf_chk-pay where
     6429               buf_chk-pay.doc-code = buf_chk-doc.doc-code:
     6430       assign
     6431       buf_chk-pay.is-error = no
     6432       accum-pay = accum-pay +  buf_chk-pay.tot-sum / buf_chk-pay.cash-rate
     6433       .
     6434       if available buf_wealth then release buf_wealth.
     6435       if available buf_wth-par then release buf_wth-par.
     6436       FIND FIRST buf_cash-pay WHERE
     6437                 buf_cash-pay.cdpay-code = buf_chk-pay.pay-code AND
     6438                 buf_cash-pay.curr-code = buf_chk-pay.curr-code NO-LOCK NO-ERROR.
     6439       if NOT available buf_cash-pay
     6440       or buf_cash-pay.wth-code = 0
     6441       then do:
     6442         if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                               "!!!Чек МЦ &1 - ошибочный&2" +                               (if not available buf_cash-pay                                 then "В базе отсутствует тип кассового платежа c кодом &3 и кодом валюты &4"                               else "Типу кассового платежа с кодом &3 и кодом валюты &4 не соответствует МЦ")                               , buf_chk-doc.doc-code                               , chr(10)                               , buf_chk-pay.pay-code                               , buf_chk-pay.curr-code                             ) ).
     6443         assign
     6444         for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     6445         buf_chk-doc.correct = no
     6446         v-view-log = yes
     6447         .
     6448       end.
     6449       else do:
     6450         assign
     6451         buf_chk-pay.wth-code = buf_cash-pay.wth-code
     6452         .
     6453         v-get-qnty-method = ''.
     6454         find first buf_wealth no-lock where
     6455                   buf_wealth.wth-code = buf_cash-pay.wth-code no-error.
     6456         if not available buf_wealth then do:
     6457           if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                         ("!!!Чек &1 - ошибочный&2" +                         "Тип кассового платежа c кодом &3 и кодом валюты &4&2 ссылается на несуществующую МЦ с кодом &5")                          , buf_chk-doc.doc-code                         , chr(10)                         , buf_chk-pay.pay-code                         , buf_chk-pay.curr-code                         , buf_cash-pay.wth-code ) ).
     6458           assign
     6459           buf_chk-pay.is-error = yes
     6460           for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     6461           buf_chk-doc.correct = no
     6462           v-view-log = yes
     6463           v-get-qnty-method = ''
     6464           .
     6465         end.
     6466         if available buf_wealth then do:
     6467           if buf_chk-pay.src-val <> 0 then do:
     6468             find first buf_wth-par no-lock where
     6469                       buf_wth-par.wth-code = buf_cash-pay.wth-code
     6470                   and ((buf_wth-par.par-rate >= 1 and buf_wth-par.par-val = integer(buf_chk-pay.src-val))
     6471                        or
     6472                        (buf_wth-par.par-rate < 1 and buf_wth-par.par-val = integer(buf_chk-pay.src-val) * 100))
     6473                   and (buf_chk-pay.par-code = 0
     6474                        or
     6475                        buf_wth-par.par-code  = buf_chk-pay.par-code)
     6476                   no-error.
     6477             if not available buf_wth-par then do:
     6478               if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           ("!!!Чек &1 - ошибочный&2" +                           "Тип кассового платежа c кодом &3 и кодом валюты &4&2 ссылается&2на несуществующий номинал &5 для МЦ &6")                            , buf_chk-doc.doc-code                           , chr(10)                           , buf_chk-pay.pay-code                           , buf_chk-pay.curr-code                           , buf_chk-pay.src-val                           , buf_wealth.wth-name ) ).
     6479               assign
     6480               buf_chk-pay.is-error = yes
