     5898               .
     5899             end.
     5900             else do:
     5901               if NOT p-NoExchRate then do:
     5902                 if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           "!!!Чек &1 - ошибочный. &2 Нет магазинного курса валюты &3 для &4&5 на дату &6"                           , buf_chk-doc.doc-code                           , chr(10)                           , v-base-code                              , buf_chk-doc.obj-type                           , buf_chk-doc.obj-code                           , buf_chk-doc.chk-date                         ) ).
     5903                 p-NoExchRate = TRUE .
