     2454   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2455   empty temp-table thbjattr_thbj-attr.
     2456   run adm/shattri.p (
     2457      input "get":U
     2458     ,input ''
     2459     ,input 0
