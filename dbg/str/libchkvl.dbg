     6694                 end.
     6695               end.
     6696             end.
     6697             else do:
     6698               if available buf_curr-shop then release buf_curr-shop.
     6699               run libchkval_get-curr-shop in this-procedure (
     6700                                                             input buf_chk-doc.obj-type
     6701                                                             ,input buf_chk-doc.obj-code
     6702                                                             ,input buf_chk-pay.curr-code
     6703                                                             ,input buf_chk-doc.chk-date
     6704                                                             ,input buf_chk-doc.chk-time
     6705                                                             ,buffer buf_curr-shop) no-error.
     6706               if available buf_curr-shop then do:
     6707                 assign
     6708                 buf_chk-pay.tot-rubl = buf_chk-pay.tot-sum * buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     6709                 curr-rate = buf_curr-shop.exch-rate
     6710                 curr-scale = buf_curr-shop.exch-scale
     6711                 buf_chk-pay.exch-date = buf_curr-shop.exch-date
     6712                 buf_chk-pay.exch-time = buf_curr-shop.exch-time
     6713                 buf_chk-pay.exch-rate = buf_curr-shop.exch-rate
     6714                 buf_chk-pay.exch-scale = buf_curr-shop.exch-scale
     6715                 buf_chk-pay.calc-rate = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     6716                 .
