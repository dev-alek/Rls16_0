     6490                                 then '=val-qnty':U
     6491                                 else buf_wealth.get-qnty-method)
     6492           v-get-qnty-method = v-get-qnty-method1
     6493           .
     6494           case v-get-qnty-method1:
     6495             when '' then do:
     6496               assign
     6497               buf_chk-pay.wth-code = 0
     6498               buf_chk-pay.doc-qnty = 0
     6499               buf_chk-pay.par-val = 0
     6500               .
     6501             end.
     6502             when '=sum':U then do:
     6503               assign
     6504               buf_chk-pay.doc-qnty = buf_chk-pay.tot-sum
     6505               buf_chk-pay.par-val = 0
     6506               buf_chk-pay.wth-code = (if available buf_wealth
     6507                                      then buf_wealth.wth-code
     6508                                      else 0)
     6509               buf_chk-pay.par-code = (if available buf_wth-par
     6510                                      then buf_wth-par.par-code
     6511                                      else 0)
     6512               .
     6513             end.
     6514             when '=1':U  then do:
     6515               assign
     6516               buf_chk-pay.doc-qnty = 1
     6517               buf_chk-pay.par-val = 0
     6518               buf_chk-pay.wth-code = (if available buf_wealth
     6519                                      then buf_wealth.wth-code
     6520                                      else 0)
     6521               buf_chk-pay.par-code = (if available buf_wth-par
     6522                                      then buf_wth-par.par-code
     6523                                      else 0)
     6524               .
     6525             end.
     6526             when '=val-qnty':U then do:
     6527               define variable v-qnty as decimal no-undo .
     6528               define variable v-val as integer   no-undo .
     6529               if available buf_wth-par then do:
     6530                 assign
     6531                 v-qnty = buf_chk-pay.tot-sum / buf_chk-pay.src-val / (if buf_wth-par.par-rate < 1 then buf_wth-par.par-rate / buf_chk-pay.src-val else 1)
     6532                 v-val = buf_chk-pay.tot-sum / buf_chk-pay.src-qnty * (if buf_wth-par.par-rate < 1 then buf_wth-par.par-rate / buf_chk-pay.src-val else 1)
     6533                 buf_chk-pay.doc-qnty = (if v-qnty = buf_chk-pay.src-qnty
     6534                                        then v-qnty
     6535                                        else 0)
     6536                 buf_chk-pay.par-val = (if v-val = buf_chk-pay.src-val
     6537                                        then v-val
     6538                                        else 0)
     6539                 buf_chk-pay.par-code = (if buf_chk-pay.par-code = 0
     6540                                         then buf_wth-par.par-code
     6541                                         else buf_chk-pay.par-code)
     6542                 .
     6543               end.
     6544               else do:
