     5824             buf_chk-pay.exch-time = buf_curr-shop.exch-time
     5825             buf_chk-pay.exch-rate = buf_curr-shop.exch-rate
     5826             buf_chk-pay.exch-scale = buf_curr-shop.exch-scale
     5827             .
     5828           end.
     5829           else do:
     5830             if NOT p-NoExchRate then do:
     5831               if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                           "!!!Чек &1 - ошибочный. &2 Нет магазинного курса базовой валюты для &3&4 на дату &5"                           , buf_chk-doc.doc-code                           , chr(10)                           , buf_chk-doc.obj-type                           , buf_chk-doc.obj-code                           , buf_chk-doc.chk-date                         ) ).
     5832               p-NoExchRate = TRUE .
     5833             end.
     5834             assign
     5835             for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5836             buf_chk-doc.correct = no
     5837             buf_chk-pay.is-error = yes
     5838             v-view-log = yes
     5839             .
     5840           end.
     5841         end.
     5842         else do:
     5843           if available buf_curr-shop then release buf_curr-shop.
     5844           run libchkval_get-curr-shop in this-procedure (
     5845                                                          input v-obj-type
     5846                                                         ,input v-obj-code
     5847                                                         ,input v-base-code
     5848                                                         ,input buf_chk-doc.chk-date
     5849                                                         ,input buf_chk-doc.chk-time
     5850                                                         ,buffer buf_curr-shop) no-error.
     5851           if available buf_curr-shop then do:
     5852             assign
     5853             buf_chk-pay.tot-rubl = buf_chk-pay.tot-sum * buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     5854             buf_chk-pay.exch-date = buf_curr-shop.exch-date
     5855             buf_chk-pay.exch-time = buf_curr-shop.exch-time
     5856             buf_chk-pay.exch-rate = buf_curr-shop.exch-rate
     5857             buf_chk-pay.exch-scale = buf_curr-shop.exch-scale
     5858             buf_chk-pay.calc-rate = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     5859             .
     5860           end.
     5861           else do:
     5862             if NOT p-NoExchRate then do:
     5863               if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                         "!!!Чек &1 - ошибочный. &2 Нет магазинного курса базовой валюты для &3&4 на дату &5"                         , buf_chk-doc.doc-code                         , chr(10)                         , buf_chk-doc.obj-type                         , buf_chk-doc.obj-code                         , buf_chk-doc.chk-date                       ) ).
     5864               p-NoExchRate = TRUE .
     5865             end.
     5866             assign
     5867             for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5868             buf_chk-doc.correct = no
     5869             buf_chk-pay.is-error = yes
     5870             v-view-log = yes
     5871             .
     5872           end.
     5873         end.
     5874       end.
     5875       otherwise do:
