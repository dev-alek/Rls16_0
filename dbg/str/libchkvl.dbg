     6729                   .
     6730                 end.
     6731                 else do:
     6732                         if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                                 "!!!Чек &1 - ошибочный. &2 Нет магазинного курса базовой валюты для &3&4 на дату &5"                                 , buf_chk-doc.doc-code                                 , chr(10)                                 , buf_chk-doc.obj-type                                 , buf_chk-doc.obj-code                                 , buf_chk-doc.chk-date                               ) ).
     6733                 end.
