     6559             end.
     6560           end case.
     6561         end.
     6562         CASE ABS(buf_chk-pay.curr-code):
     6563           when 0 then do:
     6564             assign
     6565             buf_chk-pay.tot-rubl = buf_chk-pay.tot-sum
     6566             buf_chk-pay.exch-date = buf_chk-doc.chk-date
     6567             buf_chk-pay.exch-time = buf_chk-doc.chk-time
     6568             buf_chk-pay.exch-rate = 1
     6569             buf_chk-pay.exch-scale = 1
     6570             buf_chk-pay.calc-rate = 1
     6571             .
     6572             if v-cas-curs and v-r-b = 'base':U then do:
     6573               assign
     6574               buf_chk-pay.tot-base = buf_chk-pay.tot-sum / buf_chk-pay.cash-rate .
     6575             end.
     6576             else do:
     6577               if available buf_curr-shop then release buf_curr-shop.
     6578               run libchkval_get-curr-shop in this-procedure (
     6579                                                             input buf_chk-doc.obj-type
     6580                                                           , input buf_chk-doc.obj-code
     6581                                                             ,input v-base-code
     6582                                                             ,input buf_chk-doc.chk-date
     6583                                                             ,input buf_chk-doc.chk-time
     6584                                                             ,buffer buf_curr-shop) no-error.
     6585               if available buf_curr-shop
     6586               then
     6587               buf_chk-pay.tot-base = buf_chk-pay.tot-sum / buf_curr-shop.exch-rate * buf_curr-shop.exch-scale.
     6588               else do:
     6589                                  if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                               "!!!Чек &1 - ошибочный. &2 Нет магазинного курса базовой валюты для &3&4 на дату &5"                               , buf_chk-doc.doc-code                               , chr(10)                               , buf_chk-doc.obj-type                               , buf_chk-doc.obj-code                               , buf_chk-doc.chk-date                              ) ).
     6590               end.
     6591             end.
     6592           end.
     6593           when v-base-code then do:
