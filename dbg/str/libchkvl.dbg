     2507     run adm/shattri.p (
     2508         input "get":U
     2509         ,input  p-obj-type
     2510         ,input  p-obj-code
     2511         ,input  'get-chk':U
     2512         ,input  ''
     2513         ,output v-value-character
     2514         ,output v-value-date
     2515         ,output v-value-decimal
     2516         ,output v-value-integer
     2517         ,output v-value-logical
     2518         ,output v-param-type
     2519         ,INPUT-OUTPUT table-handle v-tth
     2520         ) no-error .
     2521     IF error-status:error then do:
     2522       delete object v-tth.
     2523       undo, return error  substitute("Ошибка при получении опций закачки чеков НА ОБЪЕКТЕ &1&2:&3&4 &5"
     2524                 , p-obj-type
     2525                 , p-obj-code
