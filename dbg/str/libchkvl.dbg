     2551         end.
     2552         when 'dc-mask':U then do:
     2553           v-dc-mask = thbjattr_thbj-attr.property-value-logical.
     2554         end.
     2555         when 'card-by-mask':U then do:
     2556           v-card-by-mask = thbjattr_thbj-attr.property-value-logical.
     2557         end.
     2558         when 'ptrl-check':U then do:
