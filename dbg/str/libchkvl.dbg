     2793   define buffer buf_chk-discnt for ub.chk-discnt.
     2794   define buffer for-gds for ub.chk-gds.
     2795   define buffer for-goods for ub.goods.
     2796   define buffer for-bar for ub.bar-code.
     2797   define buffer b1-gds-prt for ub.gds-prt .
     2798   define buffer buf_shop for ub.clients.
     2799   define buffer buf_cash-desk for ub.cash-desk.
     2800   define buffer buf_libchkvl_dis-card-mask for libchkvl_dis-card-mask.
     2801   define buffer buf_chk-gds for ub.chk-gds.
     2802   define buffer buf_chk-pay for ub.chk-pay.
     2803   define buffer buf_chk-doc for ub.chk-doc.
     2804   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
     2805   define buffer buf_curr-shop for ub.curr-shop.
     2806   define buffer buf_shift-cash for ub.shift-cash.
     2807   define buffer buf_dis-card for ub.dis-card.
     2808   define buffer buf_dis-card-type for ub.dis-card-type.
     2809   define buffer buf0_chk-discnt for ub.chk-discnt.
     2810   define buffer buf_bar-code for ub.bar-code.
     2811   define buffer buf_prod-bc for ub.prod-bc.
     2812   define buffer buf_place for ub.place.
     2813   define buffer buf_goods for ub.goods.
     2814   define buffer buf_gds-prt for ub.gds-prt.
     2815   define buffer buf_units for ub.units.
     2816   define buffer buf_marking-chk for ub.marking-chk .
     2817   define buffer buf_chk-gds-attr for ub.chk-gds-attr .
     2818   main-block:
     2819   do
     2820   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2821   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2822   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2823   :
     2824     if p-prev-code = "":U then return.
     2825     FIND buf_chk-doc share-lock WHERE
     2826           buf_chk-doc.doc-code = p-prev-code NO-ERROR.
     2827     if not avail buf_chk-doc then do:
     2828       return.
     2829     end.
     2830   run adm/shattri.p (
     2831       input "get":U
     2832       ,input  chk-doc.obj-type
     2833       ,input  chk-doc.obj-code
     2834       ,input  'cd-sending':U
     2835       ,input  'mask_s-c':U
     2836       ,output v-value-character
     2837       ,output v-value-date
     2838       ,output v-value-decimal
     2839       ,output v-value-integer
     2840       ,output v-value-logical
     2841       ,output v-param-type
     2842       ,INPUT-OUTPUT table-handle v-tth
     2843       ) no-error .
     2844   IF not error-status:error
     2845   then mask_s-c = v-value-character.
     2846   else mask_s-c = "".
     2847   delete object v-tth no-error.
     2848     define buffer buf66_chk-discnt for ub.chk-discnt.
     2849     find first buf66_chk-discnt no-lock where
     2850               buf66_chk-discnt.doc-code = p-prev-code
     2851           and buf66_chk-discnt.record-type = 2 no-error.
     2852     if available buf66_chk-discnt then do:
     2853       message
     2854       "Попытка повторного вызова процедуры getcheck зовите программистов"
     2855       view-as alert-box error .
     2856       run gbl/inidebug.p .
     2857     end.
     2858     if buf_chk-doc.prev-chk-type = ? then do:
     2859       buf_chk-doc.prev-chk-type = 0.
     2860     end.
     2861     var-discnt-id = p-discnt-id.
     2862   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2863   assign
     2864   v-parparentproc                      =  p-context-bh::parparentproc
     2865   v-p-log-handle                       =  p-context-bh::p-log-handle
     2866   v-p-log-file-name                    =  p-context-bh::p-log-file-name
     2867   v-view-log                           =  p-context-bh::view-log
     2868   v-ll                                 =  p-context-bh::ll
     2869   v-tt-wd-bh                           =  p-context-bh::tt-wd-bh
     2870   v-pos-type                           =  p-context-bh::pos-type
     2871   v-cash-num                           =  p-context-bh::cash-num
     2872   v-obj-type                           =  p-context-bh::obj-type
     2873   v-db-num                             =  p-context-bh::db-num
     2874   v-obj-code                           =  p-context-bh::obj-code
     2875   v-r-b                                =  p-context-bh::r-b
     2876   v-host-code                          =  p-context-bh::host-code
     2877   v-base-code                          =  p-context-bh::base-code
     2878   v-cre-pay                            =  p-context-bh::cre-pay
     2879   v-is-catering                        =  p-context-bh::is-catering
     2880   v-is-cdinv                           =  p-context-bh::is-cdinv
     2881   v-is-ptrl                            =  p-context-bh::is-ptrl
     2882   v-is-wth                             =  p-context-bh::is-wth
     2883   v-dc-mask                            =  p-context-bh::dc-mask
     2884   v-card-by-mask                       =  p-context-bh::card-by-mask
     2885   v-sclspref                           =  p-context-bh::sclspref
     2886   v-scpgpref                           =  p-context-bh::scpgpref
     2887   v-scpgpref-pre                       =  p-context-bh::scpgpref-pre
     2888   v-doc-prt                            =  p-context-bh::doc-prt
     2889   v-shift-on                           =  p-context-bh::shift-on
     2890   v-cas-shft                           =  p-context-bh::cas-shft
     2891   v-t-shft                             =  p-context-bh::t-shft
     2892   v-v-shft                             =  p-context-bh::v-shft
     2893   v-ptrl-check                         =  p-context-bh::ptrl-check
     2894   v-annu-check                         =  p-context-bh::annu-check
     2895   v-z-check                            =  p-context-bh::z-check
     2896   v-hnum                               =  p-context-bh::hnum
     2897   v-is-100-discnt                      =  p-context-bh::is-100-discnt
     2898   v-zero-cashier                       =  p-context-bh::zero-cashier
     2899   v-rnd-znak                           =  p-context-bh::rnd-znak
     2900   v-cas-curs                           =  p-context-bh::cas-curs
     2901   v-nam-2str                           =  p-context-bh::nam-2str
     2902   v-nam-artc                           =  p-context-bh::nam-artc
     2903   v-cod-pcod                           =  p-context-bh::cod-pcod
     2904   v-name-2cd                           =  p-context-bh::name-2cd
     2905   v-how-temp-disc                      =  p-context-bh::how-temp-disc
     2906   v-nalc                               =  p-context-bh::nalc
     2907   v-serial-code                        =  p-context-bh::serial-code
     2908   v-salesman-mandatory                 =  p-context-bh::salesman-mandatory
     2909   v-sales-man                          =  p-context-bh::sales-man
     2910   v-salesman-psn-code                  =  p-context-bh::salesman-psn-code
     2911   v-pos-type-for-discnt                =  p-context-bh::pos-type-for-discnt
     2912   v-manual-discnt                      =  p-context-bh::manual-discnt
     2913   v-is-grp-totals                      =  p-context-bh::is-grp-totals
     2914   v-is-gds-totals                      =  p-context-bh::is-gds-totals
     2915   v-chk-discnt-table                   =  p-context-bh::chk-discnt-table
     2916   v-chk-gds-table                      =  p-context-bh::chk-gds-table
     2917   v-chk-pay-table                      =  p-context-bh::chk-pay-table
     2918   v-z-number                           =  p-context-bh::z-number
     2919   v-shift-num                          =  p-context-bh::shift-num
     2920   v-shift-date                         =  p-context-bh::shift-date
     2921   v-shift-name                         =  p-context-bh::shift-name
     2922   v-emulator-mode                      =  p-context-bh::emulator-mode
     2923   v-ibmgroup                           =  p-context-bh::ibmgroup
     2924   .
     2925     if v-p-log-file-name <> ""
     2926     and v-p-log-file-name <> ? then do:
     2927        log-file-name = v-p-log-file-name.
     2928     end.
     2929     else do:
     2930       log-file-name = log-file-name0.
     2931     end.
     2932       v-pos-type-int = integer(entry(lookup(v-pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,r-keeper,Emulator-NKT-IBM,MARIA,IBS-TH,IBS-TH-MOB':U), '2,13,1,3,4,5,6,7,8,9,11,12,14,15':U)).
     2933     for each t-gds :
     2934       delete t-gds.
     2935     end.
     2936     for each t-pay :
     2937       delete t-pay.
     2938     end.
     2939     if not v-ibmgroup AND
     2940       (
     2941       LOOKUP('сумма':U, for-chk-type ) > 0 and
     2942       LOOKUP('т':U, for-chk-type ) = 0 AND
     2943       LOOKUP('у':U, for-chk-type ) = 0 AND
     2944       LOOKUP('тов-ош':U, for-chk-type ) = 0 AND
     2945       LOOKUP("0":U, for-chk-type ) = 0
     2946       )  then do:
     2947       _sum-chk:
     2948       do
     2949       on error undo, return error
     2950       :
     2951         for each buf_chk-gds where
     2952                 buf_chk-gds.doc-code = buf_chk-doc.doc-code
     2953         on error undo _sum-chk, return error :
     2954           delete buf_chk-gds.
     2955         end.
     2956         for each buf_chk-pay where
     2957                 buf_chk-pay.doc-code = buf_chk-doc.doc-code
     2958         on error undo _sum-chk, return error :
     2959           delete buf_chk-pay.
     2960         end.
     2961         for each buf_chk-discnt where
     2962                 buf_chk-discnt.doc-code = buf_chk-doc.doc-code
     2963         on error undo _sum-chk, return error :
     2964           delete buf_chk-discnt.
     2965         end.
     2966         for each buf_chk-gds-pay where
     2967                 buf_chk-gds-pay.doc-code = buf_chk-doc.doc-code
     2968         on error undo _sum-chk, return error :
     2969           delete buf_chk-gds-pay.
     2970         end.
     2971         delete buf_chk-doc.
     2972         p-prev-code = "":U.
     2973         v-ll = v-ll - 1.
     2974         return.
     2975       end.
     2976     end.
     2977     if lookup(string(buf_chk-doc.chk-type) , '14,15,16,17,36':U) > 0 then do:
     2978       v-is-petrol-check = yes.
     2979     end.
     2980     if lookup(string(buf_chk-doc.chk-type), '8,108,208':U) > 0 then do:
     2981       assign
     2982       v-is-annu-check = yes.
     2983     end.
     2984     if lookup(string(buf_chk-doc.chk-type), '201,206,208,301,306':U) > 0 then do:
     2985       assign
     2986       v-is-ord-check = yes.
     2987     end.
     2988     if buf_chk-doc.chk-type = integer('11':U) then do:
     2989       assign
     2990       v-is-inventory = yes.
     2991     end.
     2992     if buf_chk-doc.chk-type = integer('12':U) then do:
     2993       assign
     2994       v-is-z-rep = yes.
     2995       if buf_chk-doc.z-number = 0 then do:
     2996         if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                               "!!!Чек &1 - ошибочный. &2 Нет сведений о № z-отчета&2"                               , buf_chk-doc.doc-code                               , chr(10)                             ) ).
     2997       end.
     2998     end.
