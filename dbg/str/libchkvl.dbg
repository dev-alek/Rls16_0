     6718                           buf_curr-shop.obj-type = buf_chk-doc.obj-type
     6719                       AND  buf_curr-shop.obj-code = buf_chk-doc.obj-code
     6720                       AND  buf_curr-shop.curr-code = v-base-code
     6721                       AND ( ( buf_curr-shop.exch-date = buf_chk-doc.chk-date
     6722                             AND
     6723                             buf_curr-shop.exch-time <= buf_chk-doc.chk-time )
     6724                           OR  buf_curr-shop.exch-date < buf_chk-doc.chk-date ) NO-ERROR .
     6725                 if available buf_curr-shop  then do:
     6726                   assign
