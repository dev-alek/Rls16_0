     5905               assign
     5906               for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5907               buf_chk-doc.correct = no
     5908               buf_chk-pay.is-error = yes
     5909               v-view-log = yes
     5910               .
     5911             end.
     5912             if available buf_curr-shop then release buf_curr-shop.
     5913             run libchkval_get-curr-shop in this-procedure (
     5914                                                            input v-obj-type
     5915                                                           ,input v-obj-code
     5916                                                           ,input buf_chk-pay.curr-code
     5917                                                           ,input buf_chk-doc.chk-date
     5918                                                           ,input buf_chk-doc.chk-time
     5919                                                           ,buffer buf_curr-shop) no-error.
     5920             if available buf_curr-shop then do:
     5921               assign
     5922               buf_chk-pay.exch-date = buf_curr-shop.exch-date
     5923               buf_chk-pay.exch-time = buf_curr-shop.exch-time
     5924               buf_chk-pay.exch-rate = buf_curr-shop.exch-rate
     5925               buf_chk-pay.exch-scale = buf_curr-shop.exch-scale
     5926               .
     5927             end.
     5928             else do:
     5929               if NOT p-NoExchRate then do:
     5930               if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                             "!!!Чек &1 - ошибочный. &2 Нет магазинного курса валюты &6 для &3&4 на дату &5"                             , buf_chk-doc.doc-code                             , chr(10)                             , buf_chk-doc.obj-type                             , buf_chk-doc.obj-code                             , buf_chk-doc.chk-date                             , buf_chk-pay.curr-code                           ) ).
     5931               end.
     5932               assign
     5933               for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5934               buf_chk-doc.correct = no
     5935               buf_chk-pay.is-error = yes
     5936               v-view-log = yes
     5937               .
     5938             end.
     5939           end.
     5940         end.
     5941         else do:
     5942           if available buf_curr-shop then release buf_curr-shop.
     5943           run libchkval_get-curr-shop in this-procedure (
     5944                                                          input v-obj-type
     5945                                                         ,input v-obj-code
     5946                                                         ,input buf_chk-pay.curr-code
     5947                                                         ,input buf_chk-doc.chk-date
     5948                                                         ,input buf_chk-doc.chk-time
     5949                                                         ,buffer buf_curr-shop) no-error.
     5950           if available buf_curr-shop then do:
     5951             assign
     5952             buf_chk-pay.tot-rubl = buf_chk-pay.tot-sum * buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     5953             curr-rate = buf_curr-shop.exch-rate
     5954             curr-scale = buf_curr-shop.exch-scale
     5955             buf_chk-pay.exch-date = buf_curr-shop.exch-date
     5956             buf_chk-pay.exch-time = buf_curr-shop.exch-time
     5957             buf_chk-pay.exch-rate = buf_curr-shop.exch-rate
     5958             buf_chk-pay.exch-scale = buf_curr-shop.exch-scale
     5959             buf_chk-pay.calc-rate = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     5960             .
     5961             FIND LAST buf_curr-shop WHERE
     5962                       buf_curr-shop.obj-type = v-obj-type
     5963                   AND  buf_curr-shop.obj-code = v-obj-code
     5964                   AND  buf_curr-shop.curr-code = v-base-code
     5965                   AND ( ( buf_curr-shop.exch-date = buf_chk-doc.chk-date
     5966                         AND
     5967                         buf_curr-shop.exch-time <= buf_chk-doc.chk-time )
     5968                       OR  buf_curr-shop.exch-date < buf_chk-doc.chk-date ) NO-ERROR .
     5969             if available buf_curr-shop  then do:
     5970               assign
     5971               buf_chk-pay.tot-base = buf_chk-pay.tot-sum * (curr-rate / curr-scale)  /
     5972                                   buf_curr-shop.exch-rate * buf_curr-shop.exch-scale
     5973               .
     5974             end.
     5975             else do:
     5976               if NOT p-NoExchRate then do:
     5977                 if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                             "!!!Чек &1 - ошибочный. &2 Нет магазинного курса базовой валюты для &3&4 на дату &5"                             , buf_chk-doc.doc-code                             , chr(10)                             , buf_chk-doc.obj-type                             , buf_chk-doc.obj-code                             , buf_chk-doc.chk-date                           ) ).
     5978               end.
     5979               assign
     5980               for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5981               buf_chk-doc.correct = no
     5982               buf_chk-pay.is-error = yes
     5983               v-view-log = yes
     5984               .
     5985             end.
     5986           end.
     5987           else do:
     5988             if NOT p-NoExchRate then do:
     5989               if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                             "!!!Чек &1 - ошибочный. &2 Нет магазинного курса валюты &3 для &4&5 на дату &6"                             , buf_chk-doc.doc-code                             , chr(10)                             , buf_chk-pay.curr-code                             , buf_chk-doc.obj-type                             , buf_chk-doc.obj-code                             , buf_chk-doc.chk-date                           ) ).
     5990               p-NoExchRate = TRUE .
     5991             end.
     5992             assign
     5993             for-chk-type = for-chk-type + 'опл-ош':U + chr(44)
     5994             buf_chk-doc.correct = no
     5995             buf_chk-pay.is-error = yes
     5996             v-view-log = yes
     5997             .
     5998           end.
     5999         end.
     6000       end.
     6001     END CASE.
     6002   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6003     if crp > 0 then
     6004     find first t-pay WHERE
     6005                 t-pay.pay-code = buf_chk-pay.pay-code
     6006            and (t-pay.curr-code = (if buf_chk-pay.pay-code = 1
     6007                                   then -1
     6008                                   else buf_chk-pay.curr-code)
     6009                 or buf_chk-pay.pay-code <> 1)
     6010           and t-pay.pay-card = (if buf_chk-pay.pay-card = "0"
     6011                                 then "":U
     6012                                 else buf_chk-pay.pay-card)
     6013                 NO-ERROR.
     6014     if not avail t-pay
     6015     or crp = 0
     6016     then  do:
     6017       FIND FIRST t-pay where t-pay.crf = crp + 1 use-index crfi No-ERROR.
     6018       if not avail t-pay then
     6019       create t-pay.
     6020       assign
     6021       t-pay.crf = crp + 1
     6022       crp = crp + 1
     6023       t-pay.pay-code = buf_chk-pay.pay-code
     6024       t-pay.curr-code = (if buf_chk-pay.pay-code = 1
     6025                          then -1
     6026                          else buf_chk-pay.curr-code)
     6027       t-pay.is-cash = (if (available buf_cash-pay)
     6028                       then buf_cash-pay.is-cash
     6029                       else no)
     6030       t-pay.pay-card = (if (available buf_cash-pay)
     6031                   then (if buf_chk-pay.pay-card <> '':U
     6032                        and buf_chk-pay.pay-card <> '0'
     6033                        then buf_chk-pay.pay-card
     6034                        else "")
     6035                   else "")
     6036       t-pay.drc = recid(buf_chk-doc)
     6037       t-pay.tot-rubl = 0
     6038       t-pay.tot-base = 0
     6039       t-pay.num-lines = 0
     6040       t-pay.was-return = no
     6041       t-pay.byval = ''
     6042       .
     6043     end.
     6044     assign
     6045     t-pay.tot-base = t-pay.tot-base + buf_chk-pay.tot-base
     6046     t-pay.tot-rubl = t-pay.tot-rubl + buf_chk-pay.tot-rubl
     6047     t-pay.num-lines = t-pay.num-lines + 1
     6048     t-pay.was-return = if t-pay.was-return
     6049                         then t-pay.was-return
     6050                         else (buf_chk-pay.line-sign = no)
     6051     t-pay.byval = (if t-pay.byval = ''
     6052                   then (if buf_chk-pay.src-val = 0
     6053                         then 'nbyval'
     6054                         else 'byval'
     6055                         )
     6056                   else (if (t-pay.byval = 'byval'
     6057                         and buf_chk-pay.src-val = 0)
     6058                         or (t-pay.byval = 'nbyval'
     6059                         and buf_chk-pay.src-val <> 0)
     6060                         then 'error'
     6061                         else t-pay.byval)
     6062                   )
     6063     .
     6064       if t-pay.byval  = 'error' then do:
     6065           if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                               "!!!Чек &1 - ошибочный (Номер по кассе: &2 Касса: &3)&4" +                               "Для типа кассового платеже с кодом &1 и кодом валюты &2 СМЕШАНЫ строки с пустыми и непустыми номиналами"                               , buf_chk-doc.doc-code                               , buf_chk-doc.chk-num                                , buf_chk-doc.pay-desk                                , chr(10)                               , t-pay.pay-code                               , t-pay.curr-code                             ) ).
     6066         assign
     6067         for-chk-type = for-chk-type + 'сум-ош':U + chr(44)
     6068         buf_chk-doc.correct = no
     6069         v-view-log = yes
     6070         .
     6071       end.
     6072       if buf_chk-pay.is-error = ? then
     6073     buf_chk-pay.is-error = no.
     6074   end.
     6075   end procedure.
     6076   procedure libchkval_get-curr-shop :
     6077   define input parameter p-obj-type as character no-undo .
     6078   define input parameter p-obj-code as integer no-undo .
     6079   define input parameter p-curr-code as integer no-undo .
     6080   define input parameter p-date as date no-undo .
     6081   define input parameter p-time as integer no-undo .
     6082   define parameter buffer buf_curr-shop for ub.curr-shop.
     6083   find last  buf_curr-shop where
     6084              buf_curr-shop.obj-type = p-obj-type
     6085         AND  buf_curr-shop.obj-code = p-obj-code
     6086         AND  buf_curr-shop.curr-code = p-curr-code
     6087         AND ( ( buf_curr-shop.exch-date = p-date
     6088               AND
     6089               buf_curr-shop.exch-time <= p-time )
     6090             OR  buf_curr-shop.exch-date < p-date ) NO-ERROR .
     6091   end procedure.
