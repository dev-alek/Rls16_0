     6737               end.
     6738             end.
     6739           end.
     6740         END CASE.
     6741   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6742   if crwth > 0 then
     6743   find first t-wth WHERE
     6744               t-wth.pay-code = buf_chk-pay.pay-code and
     6745               t-wth.curr-code = buf_chk-pay.curr-code and
     6746               t-wth.drc = recid(buf_chk-doc)
     6747               NO-ERROR.
     6748   if not avail t-wth or crwth = 0 then  do:
     6749     FIND FIRST t-wth where t-wth.crf = crwth + 1 use-index crfi No-ERROR.
     6750     if not avail t-wth then
     6751     create t-wth.
     6752     assign
     6753     t-wth.crf = crwth + 1
     6754     crwth = crwth + 1
     6755     t-wth.pay-code = buf_chk-pay.pay-code
     6756     t-wth.curr-code = buf_chk-pay.curr-code
     6757     t-wth.drc = recid(buf_chk-doc)
     6758     t-wth.tot-sum = 0
     6759     t-wth.num-lines = 0
     6760     t-wth.byval = ''
     6761     .
     6762   end.
     6763   assign
     6764   t-wth.tot-sum = t-wth.tot-sum + buf_chk-pay.tot-sum
     6765   t-wth.num-lines = t-wth.num-lines + 1
     6766   t-wth.sum-r-b = t-wth.sum-r-b + buf_chk-pay.tot-sum / buf_chk-pay.cash-rate
     6767   t-wth.byval = (if t-wth.byval = ''
     6768                  then (if buf_chk-pay.src-val = 0
     6769                        then 'nbyval'
     6770                        else 'byval'
     6771                        )
     6772                  else (if (t-wth.byval = 'byval'
     6773                        and buf_chk-pay.src-val = 0)
     6774                        or (t-wth.byval = 'nbyval'
     6775                        and buf_chk-pay.src-val <> 0)
     6776                        then 'error'
     6777                        else t-wth.byval)
     6778                  )
     6779   .
     6780       end.
     6781     end.
     6782     if p-netto <> ? then do:
     6783       if  ((p-netto = 0 and accum-pay <> 0)
     6784       or (p-netto <> 0 and  ABS(ABS(p-netto - ACCUM-pay) / p-netto ) > 0.01))
     6785       then do:
     6786           if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                               "!!!Чек &1 - ошибочный (Номер по кассе: &2 Касса: &3)&4" +                               "Сумма транзакции не совпадает с суммой оплат по чеку&4" +                               "Сумма транзакции = &5, сумма оплат по чеку = &6&4" +                                "Обратитесь к администратору Вашей системы"                               , buf_chk-doc.doc-code                               , buf_chk-doc.chk-num                                , buf_chk-doc.pay-desk                                , chr(10)                               , p-netto                               , accum-pay                             ) ).
     6787         assign
     6788         for-chk-type = for-chk-type + 'сум-ош':U + chr(44)
     6789         buf_chk-doc.correct = no
     6790         v-view-log = yes
     6791         .
     6792       end.
     6793     end.
     6794     var-sum-r-b = 0.
     6795     for each t-wth No-LOCK where
     6796             t-wth.drc = recid(buf_chk-doc):
     6797       if t-wth.byval  = 'error' then do:
     6798           if valid-handle(v-p-log-handle) then run write-log-and-file in v-p-log-handle (               input 1             , input log-file-name             , input 1             , input substitute(                               "!!!Чек &1 - ошибочный (Номер по кассе: &2 Касса: &3)&4" +                               "Для типа кассового платеже с кодом &1 и кодом валюты &2 СМЕШАНЫ строки с пустыми и непустыми номиналами"                               , buf_chk-doc.doc-code                               , buf_chk-doc.chk-num                                , buf_chk-doc.pay-desk                                , chr(10)                               , t-wth.pay-code                               , t-wth.curr-code                             ) ).
     6799         assign
